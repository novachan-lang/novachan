// KAT for std/encoding/ascii85 — btoa variant, no <~ ~> delimiters.
// Tests: round-trip of binary payload with 0x00 and 0xFF bytes,
//        all-zero group compresses to 'z', partial group, empty bytes.
import std/encoding/ascii85

fn _push(b: any, v: int) -> any
    return bytes_append(b, v)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got '" + got + "' want '" + want + "'")
        exit(1)

fn main()
    // ── KAT 1: empty bytes round-trip ─────────────────────────────────────────
    let empty = bytes(0)
    let enc_empty = a85_encode(empty)
    cks("empty_encode", enc_empty, "")
    let dec_empty = a85_decode(enc_empty)
    cki("empty_decode_len", bytes_len(dec_empty), 0)

    // ── KAT 2: all-zero 4 bytes -> 'z' shorthand ──────────────────────────────
    let zeros = bytes(0)
    zeros = _push(zeros, 0)
    zeros = _push(zeros, 0)
    zeros = _push(zeros, 0)
    zeros = _push(zeros, 0)
    let enc_z = a85_encode(zeros)
    cks("zeros_encode", enc_z, "z")
    let dec_z = a85_decode(enc_z)
    cki("zeros_decode_len", bytes_len(dec_z), 4)
    cki("zeros_decode_0", bytes_get(dec_z, 0), 0)
    cki("zeros_decode_1", bytes_get(dec_z, 1), 0)
    cki("zeros_decode_2", bytes_get(dec_z, 2), 0)
    cki("zeros_decode_3", bytes_get(dec_z, 3), 0)

    // ── KAT 3: round-trip binary payload [72,0,255,105,65,0,200,48] ──────────
    // Contains 0x00 twice and 0xFF — tests binary-safety of the codec.
    let payload = bytes(0)
    payload = _push(payload, 72)
    payload = _push(payload, 0)
    payload = _push(payload, 255)
    payload = _push(payload, 105)
    payload = _push(payload, 65)
    payload = _push(payload, 0)
    payload = _push(payload, 200)
    payload = _push(payload, 48)
    let enc_p = a85_encode(payload)
    // Encoded must be 10 chars (2 full groups × 5 chars each; neither group is all-zero).
    cki("payload_enc_len", len(enc_p), 10)
    // Verify all encoded chars are in Ascii85 alphabet '!'..'u' (33..117).
    let ci = 0
    while ci < len(enc_p)
        let cv = ord(enc_p[ci])
        if cv < 33 or cv > 117
            print("FAIL payload_enc_char: char " + str(ci) + " ordinal " + str(cv) + " out of range")
            exit(1)
        ci = ci + 1
    // Round-trip decode.
    let dec_p = a85_decode(enc_p)
    cki("payload_rt_len", bytes_len(dec_p), 8)
    cki("payload_rt_0", bytes_get(dec_p, 0), 72)
    cki("payload_rt_1", bytes_get(dec_p, 1), 0)
    cki("payload_rt_2", bytes_get(dec_p, 2), 255)
    cki("payload_rt_3", bytes_get(dec_p, 3), 105)
    cki("payload_rt_4", bytes_get(dec_p, 4), 65)
    cki("payload_rt_5", bytes_get(dec_p, 5), 0)
    cki("payload_rt_6", bytes_get(dec_p, 6), 200)
    cki("payload_rt_7", bytes_get(dec_p, 7), 48)

    // ── KAT 4: partial group (1 byte) ────────────────────────────────────────
    // 1 byte -> encoded as 2 chars; decode recovers exactly 1 byte.
    let one = bytes(0)
    one = _push(one, 72)
    let enc_one = a85_encode(one)
    cki("partial1_enc_len", len(enc_one), 2)
    let dec_one = a85_decode(enc_one)
    cki("partial1_rt_len", bytes_len(dec_one), 1)
    cki("partial1_rt_0", bytes_get(dec_one, 0), 72)

    // ── KAT 5: partial group (2 bytes) ───────────────────────────────────────
    // 2 bytes -> encoded as 3 chars; decode recovers exactly 2 bytes.
    let two = bytes(0)
    two = _push(two, 65)
    two = _push(two, 200)
    let enc_two = a85_encode(two)
    cki("partial2_enc_len", len(enc_two), 3)
    let dec_two = a85_decode(enc_two)
    cki("partial2_rt_len", bytes_len(dec_two), 2)
    cki("partial2_rt_0", bytes_get(dec_two, 0), 65)
    cki("partial2_rt_1", bytes_get(dec_two, 1), 200)

    // ── KAT 6: all-0xFF group (max value 0xFFFFFFFF) ─────────────────────────
    // 0xFFFFFFFF in base 85: 85^4*54+... = 0xFFFFFFFF = 4294967295
    // Not the 'z' special case (only 0 maps to 'z'). Should round-trip cleanly.
    let maxb = bytes(0)
    maxb = _push(maxb, 255)
    maxb = _push(maxb, 255)
    maxb = _push(maxb, 255)
    maxb = _push(maxb, 255)
    let enc_max = a85_encode(maxb)
    // 0xFFFFFFFF = 4294967295; must NOT be 'z' (only 0 is 'z').
    if enc_max == "z"
        print("FAIL maxval_not_z: 0xFFFFFFFF encoded as 'z'")
        exit(1)
    cki("maxval_enc_len", len(enc_max), 5)
    let dec_max = a85_decode(enc_max)
    cki("maxval_rt_len", bytes_len(dec_max), 4)
    cki("maxval_rt_0", bytes_get(dec_max, 0), 255)
    cki("maxval_rt_1", bytes_get(dec_max, 1), 255)
    cki("maxval_rt_2", bytes_get(dec_max, 2), 255)
    cki("maxval_rt_3", bytes_get(dec_max, 3), 255)

    // ── KAT 7: 'z' inside a multi-group stream ────────────────────────────────
    // [1,2,3,4, 0,0,0,0, 5,6,7,8] -> group1 normal + 'z' + group3 normal
    let mixed = bytes(0)
    mixed = _push(mixed, 1)
    mixed = _push(mixed, 2)
    mixed = _push(mixed, 3)
    mixed = _push(mixed, 4)
    mixed = _push(mixed, 0)
    mixed = _push(mixed, 0)
    mixed = _push(mixed, 0)
    mixed = _push(mixed, 0)
    mixed = _push(mixed, 5)
    mixed = _push(mixed, 6)
    mixed = _push(mixed, 7)
    mixed = _push(mixed, 8)
    let enc_mix = a85_encode(mixed)
    // Middle group is zeros -> 'z'; total encoded = 5 + 1 + 5 = 11 chars.
    cki("mixed_enc_len", len(enc_mix), 11)
    // Encoded must contain 'z' somewhere (the zero group).
    let found_z = 0
    let mi = 0
    while mi < len(enc_mix)
        if enc_mix[mi] == "z"
            found_z = 1
        mi = mi + 1
    cki("mixed_has_z", found_z, 1)
    let dec_mix = a85_decode(enc_mix)
    cki("mixed_rt_len", bytes_len(dec_mix), 12)
    cki("mixed_rt_0", bytes_get(dec_mix, 0), 1)
    cki("mixed_rt_4", bytes_get(dec_mix, 4), 0)
    cki("mixed_rt_7", bytes_get(dec_mix, 7), 0)
    cki("mixed_rt_8", bytes_get(dec_mix, 8), 5)
    cki("mixed_rt_11", bytes_get(dec_mix, 11), 8)

    print("_ascii85_test passed")
