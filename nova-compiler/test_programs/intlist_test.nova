// Large integers in a homogeneous int list must print as integers, not float
// garbage. Previously print/str of [9007199254740993] yielded [4.45e-308] because
// the list formatter guessed int-vs-float from bit patterns and misfired on ints
// >= 2^53. The compiler now routes print/str of a statically-inferred int list to
// a typed formatter (nova_rt_intlist_to_str) that formats every element as %lld.

fn main()
    let big = 9007199254740993            // 2^53 + 1
    // direct list literals
    assert_eq(str([big]), "[9007199254740993]")
    assert_eq(str([1, big, 3]), "[1, 9007199254740993, 3]")
    assert_eq(str([1000000000000000000, 2]), "[1000000000000000000, 2]")
    // small ints unaffected
    assert_eq(str([1, 2, 3]), "[1, 2, 3]")
    assert_eq(str([0]), "[0]")
    // negatives
    assert_eq(str([-9007199254740993, -1]), "[-9007199254740993, -1]")
    // through a variable (exercises intlist type tracking across a let binding)
    let xs = [big, big]
    assert_eq(str(xs), "[9007199254740993, 9007199254740993]")
    // single-element large
    let ys = [4611686018427387904]
    assert_eq(str(ys), "[4611686018427387904]")
    print("intlist_test passed")
