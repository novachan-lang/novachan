// KAT test for std/media/tga
// Covers:
//   (a) Exact magic/header bytes for a 1x1 encode
//   (b) Byte-exact encode of a tiny known input (1x1 pixel RGB=10,20,30)
//   (c) Full encode->decode round-trip equality check
//   (d) 2x2 pixel round-trip
//   (e) Malformed input decode returns empty/zero
import std/media/tga

// ── Helper: check int equality ────────────────────────────────────────────────
fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── KAT 1: 1x1 encode — total length ────────────────────────────────────
    // Header = 18 bytes + 1 pixel * 3 bytes (BGR) = 21 bytes.
    let px1 = [10, 20, 30]
    let enc1 = tga_encode(1, 1, px1)
    cki("encode_1x1_len", bytes_len(enc1), 21)

    // ── KAT 2: header byte[0] — ID length = 0 ───────────────────────────────
    cki("header_idlen", bytes_get(enc1, 0), 0)

    // ── KAT 3: header byte[1] — color map type = 0 ──────────────────────────
    cki("header_cmaptype", bytes_get(enc1, 1), 0)

    // ── KAT 4: header byte[2] — image type = 2 ──────────────────────────────
    cki("header_imgtype", bytes_get(enc1, 2), 2)

    // ── KAT 5: color map spec bytes[3..7] all zero ───────────────────────────
    cki("header_cmap0", bytes_get(enc1, 3), 0)
    cki("header_cmap1", bytes_get(enc1, 4), 0)
    cki("header_cmap2", bytes_get(enc1, 5), 0)
    cki("header_cmap3", bytes_get(enc1, 6), 0)
    cki("header_cmap4", bytes_get(enc1, 7), 0)

    // ── KAT 6: X origin bytes[8..9] LE = 0 ──────────────────────────────────
    cki("header_xorg_lo", bytes_get(enc1, 8), 0)
    cki("header_xorg_hi", bytes_get(enc1, 9), 0)

    // ── KAT 7: Y origin bytes[10..11] LE = 0 ────────────────────────────────
    cki("header_yorg_lo", bytes_get(enc1, 10), 0)
    cki("header_yorg_hi", bytes_get(enc1, 11), 0)

    // ── KAT 8: width bytes[12..13] LE u16 = 1 ───────────────────────────────
    let w_lo = bytes_get(enc1, 12)
    let w_hi = bytes_get(enc1, 13)
    let w_val = w_lo | (w_hi << 8)
    cki("header_width", w_val, 1)

    // ── KAT 9: height bytes[14..15] LE u16 = 1 ──────────────────────────────
    let h_lo = bytes_get(enc1, 14)
    let h_hi = bytes_get(enc1, 15)
    let h_val = h_lo | (h_hi << 8)
    cki("header_height", h_val, 1)

    // ── KAT 10: bits per pixel byte[16] = 24 ────────────────────────────────
    cki("header_bpp", bytes_get(enc1, 16), 24)

    // ── KAT 11: descriptor byte[17] = 0x20 (bit5=top-down) ─────────────────
    cki("header_descriptor", bytes_get(enc1, 17), 0x20)

    // ── KAT 12: pixel bytes @18,19,20 = 30,20,10 (BGR from RGB 10,20,30) ───
    cki("pixel_B", bytes_get(enc1, 18), 30)
    cki("pixel_G", bytes_get(enc1, 19), 20)
    cki("pixel_R", bytes_get(enc1, 20), 10)

    // ── KAT 13: round-trip 1x1 ──────────────────────────────────────────────
    let dec1 = tga_decode(enc1)
    cki("rt1_w", dec1["w"], 1)
    cki("rt1_h", dec1["h"], 1)
    let rt1_px = dec1["px"]
    cki("rt1_px_len", len(rt1_px), 3)
    cki("rt1_px_R", rt1_px[0], 10)
    cki("rt1_px_G", rt1_px[1], 20)
    cki("rt1_px_B", rt1_px[2], 30)

    // ── KAT 14: 2x2 encode round-trip ───────────────────────────────────────
    // 4 pixels: (255,0,0), (0,255,0), (0,0,255), (128,128,128)
    // Encoded length = 18 + 4*3 = 30 bytes
    let px2 = [255, 0, 0, 0, 255, 0, 0, 0, 255, 128, 128, 128]
    let enc2 = tga_encode(2, 2, px2)
    cki("encode_2x2_len", bytes_len(enc2), 30)

    // Header checks for 2x2
    cki("2x2_imgtype", bytes_get(enc2, 2), 2)
    let w2_val = bytes_get(enc2, 12) | (bytes_get(enc2, 13) << 8)
    let h2_val = bytes_get(enc2, 14) | (bytes_get(enc2, 15) << 8)
    cki("2x2_width", w2_val, 2)
    cki("2x2_height", h2_val, 2)
    cki("2x2_bpp", bytes_get(enc2, 16), 24)
    cki("2x2_desc", bytes_get(enc2, 17), 32)

    // Pixel 0 (R=255,G=0,B=0) stored as BGR: 0,0,255
    cki("2x2_p0_B", bytes_get(enc2, 18), 0)
    cki("2x2_p0_G", bytes_get(enc2, 19), 0)
    cki("2x2_p0_R", bytes_get(enc2, 20), 255)

    // Pixel 1 (R=0,G=255,B=0) stored as BGR: 0,255,0
    cki("2x2_p1_B", bytes_get(enc2, 21), 0)
    cki("2x2_p1_G", bytes_get(enc2, 22), 255)
    cki("2x2_p1_R", bytes_get(enc2, 23), 0)

    // Round-trip 2x2
    let dec2 = tga_decode(enc2)
    cki("rt2_w", dec2["w"], 2)
    cki("rt2_h", dec2["h"], 2)
    let rt2_px = dec2["px"]
    cki("rt2_px_len", len(rt2_px), 12)
    cki("rt2_p0_R", rt2_px[0], 255)
    cki("rt2_p0_G", rt2_px[1], 0)
    cki("rt2_p0_B", rt2_px[2], 0)
    cki("rt2_p1_R", rt2_px[3], 0)
    cki("rt2_p1_G", rt2_px[4], 255)
    cki("rt2_p1_B", rt2_px[5], 0)
    cki("rt2_p2_R", rt2_px[6], 0)
    cki("rt2_p2_G", rt2_px[7], 0)
    cki("rt2_p2_B", rt2_px[8], 255)
    cki("rt2_p3_R", rt2_px[9], 128)
    cki("rt2_p3_G", rt2_px[10], 128)
    cki("rt2_p3_B", rt2_px[11], 128)

    // ── KAT 15: malformed decode — too short ─────────────────────────────────
    let bad1 = bytes(5)
    let dec_bad1 = tga_decode(bad1)
    cki("bad_short_w", dec_bad1["w"], 0)
    cki("bad_short_h", dec_bad1["h"], 0)

    // ── KAT 16: malformed decode — wrong image type ──────────────────────────
    // Build a valid-looking header but set imgtype=1 (color-mapped, not supported)
    let bad2 = bytes(0)
    bad2 = bytes_append(bad2, 0)
    bad2 = bytes_append(bad2, 0)
    bad2 = bytes_append(bad2, 1)
    bad2 = bytes_append(bad2, 0)
    bad2 = bytes_append(bad2, 0)
    bad2 = bytes_append(bad2, 0)
    bad2 = bytes_append(bad2, 0)
    bad2 = bytes_append(bad2, 0)
    bad2 = bytes_append(bad2, 0)
    bad2 = bytes_append(bad2, 0)
    bad2 = bytes_append(bad2, 0)
    bad2 = bytes_append(bad2, 0)
    bad2 = bytes_append(bad2, 1)
    bad2 = bytes_append(bad2, 0)
    bad2 = bytes_append(bad2, 1)
    bad2 = bytes_append(bad2, 0)
    bad2 = bytes_append(bad2, 24)
    bad2 = bytes_append(bad2, 0x20)
    bad2 = bytes_append(bad2, 0)
    bad2 = bytes_append(bad2, 0)
    bad2 = bytes_append(bad2, 0)
    let dec_bad2 = tga_decode(bad2)
    cki("bad_imgtype_w", dec_bad2["w"], 0)

    // ── KAT 17: channel clamping — values > 255 clamped via & 0xFF ──────────
    // RGB value 256 & 0xFF = 0; 257 & 0xFF = 1; 511 & 0xFF = 255
    let px_clamp = [256, 257, 511]
    let enc_clamp = tga_encode(1, 1, px_clamp)
    // Stored as BGR: B=(511&0xFF)=255, G=(257&0xFF)=1, R=(256&0xFF)=0
    cki("clamp_B", bytes_get(enc_clamp, 18), 255)
    cki("clamp_G", bytes_get(enc_clamp, 19), 1)
    cki("clamp_R", bytes_get(enc_clamp, 20), 0)

    print("PASS _tga_test")
