import std/units/speed

// approx — float equality within tolerance.
fn approx(a, b, tol)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < tol

fn ckf(label, got, want, tol)
    if not approx(got, want, tol)
        print("FAIL speed " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // KAT 1: 1 km/h -> m/s = 0.2777778
    let r1 = speed_convert(1.0, "kmh", "mps")
    ckf("kmh->mps", r1, 0.2777778, 0.001)

    // KAT 2: 1 mph -> m/s = 0.44704
    let r2 = speed_convert(1.0, "mph", "mps")
    ckf("mph->mps", r2, 0.44704, 0.001)

    // KAT 3: 1 knot -> m/s = 0.5144444
    let r3 = speed_convert(1.0, "kn", "mps")
    ckf("kn->mps", r3, 0.5144444, 0.001)

    // KAT 4: 100 km/h -> mph ≈ 62.1371
    let r4 = speed_convert(100.0, "kmh", "mph")
    ckf("100kmh->mph", r4, 62.1371, 0.01)

    // KAT 5: round-trip mps->kmh->mps
    let v5 = 30.0
    let rt5 = speed_convert(speed_convert(v5, "mps", "kmh"), "kmh", "mps")
    ckf("roundtrip-mps-kmh", rt5, v5, 0.001)

    // KAT 6: round-trip mph->fps->mph
    let v6 = 60.0
    let rt6 = speed_convert(speed_convert(v6, "mph", "fps"), "fps", "mph")
    ckf("roundtrip-mph-fps", rt6, v6, 0.001)

    // KAT 7: mach -> m/s (1 mach = 343 m/s)
    let r7 = speed_convert(1.0, "mach", "mps")
    ckf("1mach->mps", r7, 343.0, 0.001)

    // KAT 8: mps_to_kmh convenience (1 m/s = 3.6 km/h)
    let r8 = mps_to_kmh(1.0)
    ckf("mps_to_kmh(1)", r8, 3.6, 0.001)

    // KAT 9: kmh_to_mph convenience (100 km/h ≈ 62.1371 mph)
    let r9 = kmh_to_mph(100.0)
    ckf("kmh_to_mph(100)", r9, 62.1371, 0.01)

    // KAT 10: speed_is_supported
    let s1 = speed_is_supported("mps")
    if s1 != 1
        print("FAIL speed is_supported mps")
        exit(1)
    let s2 = speed_is_supported("xyz")
    if s2 != 0
        print("FAIL speed is_supported xyz")
        exit(1)

    // KAT 11: fps round-trip
    let v11 = 100.0
    let rt11 = speed_convert(speed_convert(v11, "fps", "mps"), "mps", "fps")
    ckf("roundtrip-fps", rt11, v11, 0.001)

    print("PASS _speed_test")
