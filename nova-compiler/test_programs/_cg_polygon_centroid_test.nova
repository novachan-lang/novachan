// KAT for std/geometry/cg_polygon_centroid
// Verifies: cgc_centroid, cgc_centroid_x, cgc_centroid_y
import std/geometry/cg_polygon_centroid

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckl3 — check a 3-element integer list [a,b,c]
fn ckl3(label: string, got: list, wa: int, wb: int, wc: int)
    let ga = got[0]
    let gb = got[1]
    let gc = got[2]
    if ga != wa or gb != wb or gc != wc
        print("FAIL " + label + ": got=[" + str(ga) + "," + str(gb) + "," + str(gc) + "] want=[" + str(wa) + "," + str(wb) + "," + str(wc) + "]")
        exit(1)

// ckl2 — check a 2-element integer list [a,b]
fn ckl2(label: string, got: list, wa: int, wb: int)
    let ga = got[0]
    let gb = got[1]
    if ga != wa or gb != wb
        print("FAIL " + label + ": got=[" + str(ga) + "," + str(gb) + "] want=[" + str(wa) + "," + str(wb) + "]")
        exit(1)

fn main()
    // CCW 2x2 square: centroid = (1,1)
    let sq2 = [[0,0],[2,0],[2,2],[0,2]]
    ckl3("centroid sq2x2", cgc_centroid(sq2), 1, 1, 1)

    // Right triangle (0,0),(3,0),(0,3): centroid = (1,1)
    let tri = [[0,0],[3,0],[0,3]]
    ckl3("centroid tri", cgc_centroid(tri), 1, 1, 1)

    // Rectangle (0,0),(6,0),(6,3),(0,3): centroid_x = 3/1
    let rect = [[0,0],[6,0],[6,3],[0,3]]
    ckl2("centroid_x rect", cgc_centroid_x(rect), 3, 1)

    // CCW 4x4 square: centroid = (2,2)
    let sq4 = [[0,0],[4,0],[4,4],[0,4]]
    ckl3("centroid sq4x4", cgc_centroid(sq4), 2, 2, 1)

    // CW winding should give same centroid position (den gets normalised to positive)
    let sq2_cw = [[0,0],[0,2],[2,2],[2,0]]
    ckl3("centroid sq2 CW", cgc_centroid(sq2_cw), 1, 1, 1)

    // Degenerate: collinear — area=0, returns [0,0,0]
    let coll = [[0,0],[1,1],[2,2]]
    ckl3("centroid collinear", cgc_centroid(coll), 0, 0, 0)

    // Rectangle centroid_y = 3/2 for (0,0),(6,0),(6,3),(0,3)
    ckl2("centroid_y rect", cgc_centroid_y(rect), 3, 2)

    // centroid_x of 4x4 square = [2,1]
    ckl2("centroid_x sq4", cgc_centroid_x(sq4), 2, 1)
    // centroid_y of 4x4 square = [2,1]
    ckl2("centroid_y sq4", cgc_centroid_y(sq4), 2, 1)

    print("PASS _cg_polygon_centroid_test")
