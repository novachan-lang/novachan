import forge_queue_router

fn main()
    let r = qr_new()
    r = qr_create_queue(r, "orders")
    r = qr_create_queue(r, "emails")
    r = qr_create_queue(r, "logs")

    let queues = qr_list_queues(r)
    assert(len(queues) == 3, "3 queues")

    r = qr_bind(r, "order.new", "orders")
    r = qr_bind(r, "order.new", "logs")
    r = qr_bind(r, "email.send", "emails")

    r = qr_publish(r, "order.new", "order-001")
    assert(qr_queue_depth(r, "orders") == 1, "orders has 1")
    assert(qr_queue_depth(r, "logs") == 1, "logs has 1 (fan-out)")
    assert(qr_queue_depth(r, "emails") == 0, "emails empty")

    r = qr_publish(r, "email.send", "welcome-email")
    assert(qr_queue_depth(r, "emails") == 1, "emails has 1")

    r = qr_publish(r, "unknown.event", "lost-msg")
    assert(qr_dead_letter_count(r) == 1, "1 dead letter")

    let msg = qr_consume(r, "orders")
    assert(msg == "order-001", "consumed order")
    assert(qr_queue_depth(r, "orders") == 0, "orders empty after consume")

    let empty = qr_consume(r, "orders")
    assert(empty == "", "empty queue returns empty")

    print("QUEUE-ROUTER KAT PASS")
