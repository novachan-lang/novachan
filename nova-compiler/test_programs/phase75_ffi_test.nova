// Phase 7.5: FFI helpers test
// Tests cstr_of, null_ptr, is_null, ptr_read/write, alloc_raw/free_raw
// (#4) raw-memory primitives (alloc_raw/free_raw/ptr_*/memset_unsafe) are now gated behind `unsafe`.

fn test_null_pointer()
    unsafe
        let p = null_ptr()
        assert_eq(is_null(p), true)
        let p2 = alloc_raw(16)
        assert_eq(is_null(p2), false)
        free_raw(p2)
        print("Null pointer test passed")

fn test_ptr_operations()
    unsafe
        // Allocate 64 bytes, write, read back
        let p = alloc_raw(64)
        assert_eq(is_null(p), false)
        ptr_write(p, 12345)
        let v = ptr_read(p)
        assert_eq(v, 12345)
        // Pointer arithmetic
        let p2 = ptr_add(p, 8)
        ptr_write(p2, 67890)
        let v2 = ptr_read(p2)
        assert_eq(v2, 67890)
        // Original unchanged
        assert_eq(ptr_read(p), 12345)
        free_raw(p)
        print("Pointer operations test passed")

fn test_sizeof_ptr()
    let sz = sizeof_ptr()
    assert_eq(sz == 4 or sz == 8, true)
    print("sizeof_ptr=" + str(sz) + " test passed")

fn test_memset()
    unsafe
        let p = alloc_raw(64)
        let zeroed = memset_unsafe(p, 0, 64)
        let v = ptr_read(zeroed)
        assert_eq(v, 0)
        free_raw(p)
        print("memset test passed")

fn test_str_from_cstr()
    // Basic string handling (cstr_of returns char* pointer)
    let s = "Hello, World!"
    let cs = cstr_of(s)
    assert_eq(is_null(cs), false)
    // str_from_cstr round-trips through C string
    let s2 = str_from_cstr(cs)
    assert_eq(s2, "Hello, World!")
    print("str/cstr conversion test passed")

fn main()
    test_null_pointer()
    test_ptr_operations()
    test_sizeof_ptr()
    test_memset()
    test_str_from_cstr()
    print("All Phase 7.5 FFI tests passed!")
