import std/proof/proof_axioms

// cki — integer known-answer check.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _proof_axioms_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb — boolean known-answer check.
fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL _proof_axioms_test " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

// cks — string known-answer check.
fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL _proof_axioms_test " + label + ": got=" + got + " want=" + want)
        exit(1)

// ── Inline structural equality helper ─────────────────────────────────────────
fn _eq(f: list, g: list) -> int
    let ft = f[0]
    let gt = g[0]
    if ft != gt
        return 0
    if ft == "bot"
        return 1
    if ft == "top"
        return 1
    if ft == "var"
        if f[1] == g[1]
            return 1
        return 0
    if ft == "not"
        return _eq(f[1], g[1])
    if ft == "and"
        if _eq(f[1], g[1]) == 0
            return 0
        return _eq(f[2], g[2])
    if ft == "or"
        if _eq(f[1], g[1]) == 0
            return 0
        return _eq(f[2], g[2])
    if ft == "imp"
        if _eq(f[1], g[1]) == 0
            return 0
        return _eq(f[2], g[2])
    0

fn main()
    // === pax_matches (spec KAT) ===

    // A1 schema: imp(var A, imp(var B, var A))
    // Instance: imp(var p, imp(var q, var p)) => A=p, B=q => MATCH
    let schema_a1 = pax_imp(pax_var("A"), pax_imp(pax_var("B"), pax_var("A")))
    let inst_pqp = pax_imp(pax_var("p"), pax_imp(pax_var("q"), pax_var("p")))
    ckb("matches_a1_pqp", pax_matches(schema_a1, inst_pqp), true)

    // Spec KAT: same schema vs imp(var p, imp(var q, var r)) => FAIL
    // A would need to be p (from imp(A,...)) and r (from inner imp(B,A)) — inconsistent
    let inst_pqr = pax_imp(pax_var("p"), pax_imp(pax_var("q"), pax_var("r")))
    ckb("matches_a1_pqr_false", pax_matches(schema_a1, inst_pqr), false)

    // Spec KAT: compound instance A := (x&y) => true
    let xy = pax_and(pax_var("x"), pax_var("y"))
    let r_v = pax_var("r")
    let inst_cmpd = pax_imp(xy, pax_imp(r_v, xy))
    ckb("matches_a1_compound", pax_matches(schema_a1, inst_cmpd), true)

    // A2 schema matches
    let schema_a2 = pax_imp(pax_imp(pax_var("A"), pax_imp(pax_var("B"), pax_var("C"))), pax_imp(pax_imp(pax_var("A"), pax_var("B")), pax_imp(pax_var("A"), pax_var("C"))))
    let p = pax_var("p")
    let q = pax_var("q")
    let rv = pax_var("r")
    let a2_inst = pax_imp(pax_imp(p, pax_imp(q, rv)), pax_imp(pax_imp(p, q), pax_imp(p, rv)))
    ckb("matches_a2_pqr", pax_matches(schema_a2, a2_inst), true)

    // A3 schema matches
    let schema_a3 = pax_imp(pax_imp(pax_not(pax_var("A")), pax_not(pax_var("B"))), pax_imp(pax_var("B"), pax_var("A")))
    let a3_inst = pax_imp(pax_imp(pax_not(p), pax_not(q)), pax_imp(q, p))
    ckb("matches_a3_pq", pax_matches(schema_a3, a3_inst), true)

    // Non-matching: bot doesn't match A1
    ckb("matches_a1_bot_false", pax_matches(schema_a1, pax_bot()), false)

    // Metavar appears twice consistently: A matches same subformula both times
    // schema: imp(var A, var A) -- A must be bound consistently
    let schema_aa = pax_imp(pax_var("A"), pax_var("A"))
    let pp = pax_imp(p, p)
    ckb("matches_aa_imp_pp", pax_matches(schema_aa, pp), true)
    // imp(p,q) doesn't match imp(A,A) since A can't be both p and q
    ckb("matches_aa_imp_pq_false", pax_matches(schema_aa, pax_imp(p, q)), false)

    // === pax_bindings (spec KAT: round-trip) ===
    // A1 instance: p->(q->p) => bindings: A->p, B->q
    let b1 = pax_bindings(schema_a1, inst_pqp)
    // Check not FAIL
    ckb("bindings_a1_ok", not contains(b1, "FAIL"), true)
    let bound_A = b1["A"]
    cks("bindings_a1_A_tag", bound_A[0], "var")
    cks("bindings_a1_A_name", bound_A[1], "p")
    let bound_B = b1["B"]
    cks("bindings_a1_B_tag", bound_B[0], "var")
    cks("bindings_a1_B_name", bound_B[1], "q")

    // Mismatch => FAIL sentinel
    let b_fail = pax_bindings(schema_a1, inst_pqr)
    ckb("bindings_mismatch_fail", contains(b_fail, "FAIL"), true)

    // Compound: A := (x&y), B := r
    let b_cmpd = pax_bindings(schema_a1, inst_cmpd)
    ckb("bindings_cmpd_ok", not contains(b_cmpd, "FAIL"), true)
    let bound_A2 = b_cmpd["A"]
    cks("bindings_cmpd_A_tag", bound_A2[0], "and")

    // === pax_instantiate round-trip (spec KAT) ===
    // Instantiate A1 schema with A->p, B->q; result should equal p->(q->p)
    let b_rt = {}
    b_rt["A"] = p
    b_rt["B"] = q
    let inst_rt = pax_instantiate(schema_a1, b_rt)
    cki("instantiate_roundtrip_eq", _eq(inst_rt, inst_pqp), 1)

    // Instantiate A1 with compound: A->(x&y), B->r => (x&y)->(r->(x&y))
    let b_cmpd2 = {}
    b_cmpd2["A"] = xy
    b_cmpd2["B"] = r_v
    let inst_cmpd2 = pax_instantiate(schema_a1, b_cmpd2)
    cki("instantiate_compound_eq", _eq(inst_cmpd2, inst_cmpd), 1)

    // === pax_system ===
    let classical = pax_system("classical")
    cki("classical_len", len(classical), 3)

    // Verify each schema in classical matches a known instance
    let s0 = classical[0]
    ckb("classical_0_matches_a1", pax_matches(s0, inst_pqp), true)
    let s1 = classical[1]
    ckb("classical_1_matches_a2", pax_matches(s1, a2_inst), true)
    let s2 = classical[2]
    ckb("classical_2_matches_a3", pax_matches(s2, a3_inst), true)

    let implicational = pax_system("implicational")
    cki("implicational_len", len(implicational), 2)

    // Unknown system returns empty
    let unknown = pax_system("foo")
    cki("unknown_system_len", len(unknown), 0)

    // === Additional match/non-match edge cases ===
    // top matches a schema that expects a formula (metavar A matches top)
    let schema_imp_top = pax_imp(pax_var("A"), pax_var("B"))
    let top_q = pax_imp(pax_top(), q)
    let b_top = pax_bindings(schema_imp_top, top_q)
    ckb("bindings_top_ok", not contains(b_top, "FAIL"), true)
    let bound_A_top = b_top["A"]
    cks("bindings_top_A_tag", bound_A_top[0], "top")

    // bot in formula
    let bot_q = pax_imp(pax_bot(), q)
    let b_bot = pax_bindings(schema_imp_top, bot_q)
    ckb("bindings_bot_ok", not contains(b_bot, "FAIL"), true)
    let bound_A_bot = b_bot["A"]
    cks("bindings_bot_A_tag", bound_A_bot[0], "bot")

    // Nested schema: not(A) -> not(B) matches not(p) -> not(q)
    let schema_notab = pax_imp(pax_not(pax_var("A")), pax_not(pax_var("B")))
    let inst_notpq = pax_imp(pax_not(p), pax_not(q))
    ckb("matches_notab_notpq", pax_matches(schema_notab, inst_notpq), true)

    // not(A) -> not(B) does NOT match p -> q (missing not wrapping)
    ckb("matches_notab_pq_false", pax_matches(schema_notab, pax_imp(p, q)), false)

    // Instantiate A3 schema: A->p, B->q => (~p->~q)->(q->p)
    let b_a3 = {}
    b_a3["A"] = p
    b_a3["B"] = q
    let schema_a3b = pax_system("classical")[2]
    let inst_a3_2 = pax_instantiate(schema_a3b, b_a3)
    cki("instantiate_a3_eq", _eq(inst_a3_2, a3_inst), 1)

    print("PASS _proof_axioms_test")
