// KAT test for std/numeric/dist_lognormal — Log-normal distribution.
//
// Known answers:
//   lognorm_pdf(x, ...) = 0.0 for x <= 0
//   lognorm_cdf(1.0, 0.0, 1.0) = 0.5 (median at exp(mu)=exp(0)=1)
//   lognorm_mean(0.0, 1.0) = exp(0 + 1/2) = exp(0.5) ~= 1.6487
//   lognorm_pdf(1.0, 0.0, 1.0) = (1/(1*1*sqrt(2pi)))*exp(0) = 1/sqrt(2pi) ~= 0.3989
import std/numeric/dist_lognormal

fn approx(a, b, tol) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < tol
        return 1
    return 0

fn ck(label: string, got: float, want: float, tol: float)
    let ok = approx(got, want, tol)
    if ok == 0
        print("FAIL dist_lognormal " + label + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("ok " + label)

fn main()
    // lognorm_pdf(x,...) = 0.0 for x <= 0
    let p0 = lognorm_pdf(0.0, 0.0, 1.0)
    ck("lognorm_pdf(0.0,...)==0", p0, 0.0, 0.0001)

    let pneg = lognorm_pdf(0.0 - 1.0, 0.0, 1.0)
    ck("lognorm_pdf(-1.0,...)==0", pneg, 0.0, 0.0001)

    // lognorm_cdf(1.0, 0.0, 1.0) = 0.5 (median is exp(mu)=1 for mu=0)
    let c = lognorm_cdf(1.0, 0.0, 1.0)
    ck("lognorm_cdf(1.0,0.0,1.0)=0.5", c, 0.5, 0.001)

    // lognorm_mean(0.0, 1.0) = exp(0.5) ~= 1.6487
    let m = lognorm_mean(0.0, 1.0)
    ck("lognorm_mean(0,1)=1.6487", m, 1.6487, 0.001)

    // lognorm_pdf(1.0, 0.0, 1.0) = 1/sqrt(2*pi) ~= 0.3989
    // ln(1)=0, diff=0, z=0, exp(0)=1, denom=1*1*sqrt(2pi)
    let p1 = lognorm_pdf(1.0, 0.0, 1.0)
    ck("lognorm_pdf(1.0,0.0,1.0)=0.3989", p1, 0.3989, 0.001)

    // lognorm_cdf(x,...) = 0.0 for x <= 0
    let cn = lognorm_cdf(0.0, 0.0, 1.0)
    ck("lognorm_cdf(0.0,...)==0", cn, 0.0, 0.0001)

    // lognorm_mean(1.0, 0.5) = exp(1 + 0.5^2/2) = exp(1.125) ~= 3.0802
    let m2 = lognorm_mean(1.0, 0.5)
    ck("lognorm_mean(1.0,0.5)=3.0802", m2, 3.0802, 0.001)

    print("PASS _dist_lognormal_test")
