import std/game/round_robin

fn chk_int(name: string, got: int, want: int)
    if got != want
        print("FAIL round_robin " + name + ": got " + str(got) + " want " + str(want))
        exit(1)

fn test_total_rounds()
    chk_int("total_rounds(4)", total_rounds(4), 3)
    chk_int("total_rounds(2)", total_rounds(2), 1)
    chk_int("total_rounds(6)", total_rounds(6), 5)
    chk_int("total_rounds(3)", total_rounds(3), 3)
    chk_int("total_rounds(5)", total_rounds(5), 5)

fn test_schedule_4()
    // 4 players: 3 rounds of 2 pairs each; all 6 pairs appear exactly once.
    let sched = round_robin_schedule(4)
    chk_int("n4 rounds", len(sched), 3)
    let r = 0
    while r < 3
        let round = sched[r]
        chk_int("n4 round " + str(r) + " pairs", len(round), 2)
        r = r + 1
    // Verify all 6 unique pairs appear exactly once.
    // Pairs among {1,2,3,4}: (1,2)(1,3)(1,4)(2,3)(2,4)(3,4).
    // Encode each pair as a*10+b (a<b).
    let seen = {}
    let ri = 0
    while ri < 3
        let round = sched[ri]
        let pi = 0
        while pi < 2
            let pair = round[pi]
            let a = pair[0]
            let b = pair[1]
            // Normalize so a < b
            if a > b
                let tmp = a
                a = b
                b = tmp
            let key = str(a) + "_" + str(b)
            if contains(seen, key)
                print("FAIL round_robin n4 duplicate pair " + key)
                exit(1)
            seen[key] = 1
            pi = pi + 1
        ri = ri + 1
    chk_int("n4 unique pairs", len(seen), 6)

fn test_schedule_2()
    // 2 players: 1 round of 1 pair.
    let sched = round_robin_schedule(2)
    chk_int("n2 rounds", len(sched), 1)
    let r0 = sched[0]
    chk_int("n2 r0 pairs", len(r0), 1)
    let p0 = r0[0]
    chk_int("n2 pair a", p0[0], 1)
    chk_int("n2 pair b", p0[1], 2)

fn test_schedule_3()
    // 3 players: 3 rounds; each player gets one bye, all 3 real pairs appear.
    let sched = round_robin_schedule(3)
    chk_int("n3 rounds", len(sched), 3)
    let seen = {}
    let bye_count = 0
    let ri = 0
    while ri < 3
        let round = sched[ri]
        let pi = 0
        while pi < len(round)
            let pair = round[pi]
            let a = pair[0]
            let b = pair[1]
            if b == -1
                bye_count = bye_count + 1
            else
                if a > b
                    let tmp = a
                    a = b
                    b = tmp
                let key = str(a) + "_" + str(b)
                if contains(seen, key)
                    print("FAIL round_robin n3 duplicate pair " + key)
                    exit(1)
                seen[key] = 1
            pi = pi + 1
        ri = ri + 1
    chk_int("n3 real pairs", len(seen), 3)
    chk_int("n3 byes", bye_count, 3)

fn main()
    test_total_rounds()
    test_schedule_4()
    test_schedule_2()
    test_schedule_3()
    print("PASS _round_robin_test")
