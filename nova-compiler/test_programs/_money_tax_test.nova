import std/money/tax
fn _i(l, g, w)
    if g != w
        print("FAIL tax " + l + " got=" + str(g) + " want=" + str(w))
        exit(1)
fn main()
    _i("amt", tax_amount(10000, 800), 800)
    _i("add", tax_add(10000, 800), 10800)
    _i("net", tax_extract_net(10800, 800), 10000)
    _i("tx", tax_extract_tax(10800, 800), 800)
    // Negative cases: half-up must round away from zero for negatives
    _i("neg_amt", tax_amount(-10000, 800), -800)
    _i("neg_add", tax_add(-10000, 800), -10800)
    _i("neg_net", tax_extract_net(tax_add(-10000, 800), 800), -10000)
    print("PASS _money_tax_test")
