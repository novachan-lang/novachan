// KAT for std/automata/lexer
import std/automata/lexer

// cks: check string equality
fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

// cki: check int equality
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// Serialize a list of [name,lexeme] token pairs to a compact string for comparison.
// Format: "name:lexeme|name:lexeme|..."
fn tok_str(toks: list) -> string
    let out = ""
    let i = 0
    while i < len(toks)
        let t = toks[i]
        if i > 0
            out = out + "|"
        out = out + t[0] + ":" + t[1]
        i = i + 1
    out

fn main()
    // KAT 1: basic default tokenize -- ident, number, op, spaces stripped
    let t1 = lex_tokenize_default("ab 12 +")
    cki("t1_count", len(t1), 3)
    cks("t1_tok0", tok_str(t1), "IDENT:ab|NUMBER:12|OP:+")

    // KAT 2: adjacent ident + number (no space) -- longest-run per rule, first match wins
    // "x1": 'x' is letter -> IDENT gets "x"; then '1' is digit -> NUMBER gets "1"
    let t2 = lex_tokenize_default("x1")
    cki("t2_count", len(t2), 2)
    cks("t2_toks", tok_str(t2), "IDENT:x|NUMBER:1")

    // KAT 3: empty string returns empty list
    let t3 = lex_tokenize_default("")
    cki("t3_empty", len(t3), 0)

    // KAT 4: only spaces get stripped -- "  42  " -> just NUMBER:42
    let t4 = lex_tokenize_default("  42  ")
    cki("t4_count", len(t4), 1)
    cks("t4_toks", tok_str(t4), "NUMBER:42")

    // KAT 5: custom rule set -- letters rule only, "aaa" -> one IDENT token
    let rules5 = []
    push(rules5, ["IDENT", "letters", ""])
    let t5 = lex_tokenize("aaa", rules5)
    cki("t5_count", len(t5), 1)
    cks("t5_tok0", t5[0][0], "IDENT")
    cks("t5_lex0", t5[0][1], "aaa")

    // KAT 6: count tokens of "1 2 3" using default == 3 (three NUMBER tokens)
    let t6 = lex_tokenize_default("1 2 3")
    cki("t6_count", len(t6), 3)
    cks("t6_toks", tok_str(t6), "NUMBER:1|NUMBER:2|NUMBER:3")

    // KAT 7: exact kind -- match literal keyword "fn"
    let rules7 = []
    push(rules7, ["KW_FN",  "exact",   "fn"])
    push(rules7, ["IDENT",  "letters", ""])
    push(rules7, ["SKIP",   "space",   ""])
    let t7 = lex_tokenize("fn foo", rules7)
    cki("t7_count", len(t7), 2)
    cks("t7_toks", tok_str(t7), "KW_FN:fn|IDENT:foo")

    // KAT 8: lex_new / lex_add_rule / lex_rules round-trip
    let acc = lex_new()
    lex_add_rule(acc, "NUM",  "digits",  "")
    lex_add_rule(acc, "SKIP", "space",   "")
    let r8 = lex_rules(acc)
    cki("t8_rules_count", len(r8), 2)
    cks("t8_rule0_name", r8[0][0], "NUM")
    cks("t8_rule1_name", r8[1][0], "SKIP")

    // KAT 9: SKIP name suppresses tokens -- "  hello  " with space rule SKIP -> just IDENT
    let rules9 = []
    push(rules9, ["SKIP",  "space",   ""])
    push(rules9, ["WORD",  "letters", ""])
    let t9 = lex_tokenize("  hello  ", rules9)
    cki("t9_count", len(t9), 1)
    cks("t9_tok0", t9[0][1], "hello")

    // KAT 10: punct kind -- single non-alnum non-space char per token
    let t10 = lex_tokenize_default("+-*/")
    cki("t10_count", len(t10), 4)
    cks("t10_toks", tok_str(t10), "OP:+|OP:-|OP:*|OP:/")

    print("_lexer_test passed")
