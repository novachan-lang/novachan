import corex

// Validation test for the corex module's public functions.
// Each asserted result is computed by hand from corex.nova's source.
fn main()
    // sorted ascending int list, distinct elements
    let a = [1, 3, 5, 7, 9]

    // binary_search: exact index of target, else -1
    assert(corex.binary_search(a, 5) == 2, "binary_search hit middle")
    assert(corex.binary_search(a, 1) == 0, "binary_search first")
    assert(corex.binary_search(a, 9) == 4, "binary_search last")
    assert(corex.binary_search(a, 4) == -1, "binary_search absent")

    // lower_bound: first index i with a[i] >= target
    assert(corex.lower_bound(a, 5) == 2, "lower_bound of present value")
    assert(corex.lower_bound(a, 6) == 3, "lower_bound of gap value")
    assert(corex.lower_bound(a, 0) == 0, "lower_bound before all")

    // upper_bound: first index i with a[i] > target
    assert(corex.upper_bound(a, 5) == 3, "upper_bound past present value")
    assert(corex.upper_bound(a, 9) == 5, "upper_bound after all == len")

    // sign
    assert(corex.sign(42) == 1, "sign positive")
    assert(corex.sign(-9) == -1, "sign negative")
    assert(corex.sign(0) == 0, "sign zero")

    // clamp_int(x, lo, hi)
    assert(corex.clamp_int(5, 0, 10) == 5, "clamp in range")
    assert(corex.clamp_int(-3, 0, 10) == 0, "clamp below low")
    assert(corex.clamp_int(15, 0, 10) == 10, "clamp above high")

    // isqrt: floor(sqrt(n)), exact integer Newton; negative -> -1
    assert(corex.isqrt(0) == 0, "isqrt 0")
    assert(corex.isqrt(16) == 4, "isqrt perfect square")
    assert(corex.isqrt(15) == 3, "isqrt below perfect square")
    assert(corex.isqrt(-5) == -1, "isqrt negative")

    // next_pow2: smallest power of two >= n, min 1
    assert(corex.next_pow2(0) == 1, "next_pow2 0")
    assert(corex.next_pow2(3) == 4, "next_pow2 3")
    assert(corex.next_pow2(8) == 8, "next_pow2 exact power")
    assert(corex.next_pow2(9) == 16, "next_pow2 just over power")

    print("corex_lib_test passed")
