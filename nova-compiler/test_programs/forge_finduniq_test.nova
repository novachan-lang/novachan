import forge_finduniq

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // single number
    fails = fails + expect("sn1", str(single_number([2, 2, 1])), "1")
    fails = fails + expect("sn2", str(single_number([4, 1, 2, 1, 2])), "4")
    fails = fails + expect("sn_single", str(single_number([7])), "7")
    fails = fails + expect("sn3", str(single_number([1, 2, 3, 2, 1])), "3")

    // missing number
    fails = fails + expect("mn1", str(missing_number([3, 0, 1])), "2")
    fails = fails + expect("mn2", str(missing_number([0, 1])), "2")
    fails = fails + expect("mn3", str(missing_number([0])), "1")
    fails = fails + expect("mn4", str(missing_number([9, 6, 4, 2, 3, 5, 7, 0, 1])), "8")
    fails = fails + expect("mn_first", str(missing_number([1, 2, 3])), "0")

    // find duplicate (Floyd)
    fails = fails + expect("fd1", str(find_duplicate([1, 3, 4, 2, 2])), "2")
    fails = fails + expect("fd2", str(find_duplicate([3, 1, 3, 4, 2])), "3")
    fails = fails + expect("fd3", str(find_duplicate([1, 1])), "1")
    fails = fails + expect("fd4", str(find_duplicate([2, 5, 9, 6, 9, 3, 8, 9, 7, 1])), "9")

    if fails == 0
        print("forge_finduniq: all passed")
    else
        print("forge_finduniq: " + str(fails) + " FAILED")
