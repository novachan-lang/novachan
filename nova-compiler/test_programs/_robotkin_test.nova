// KAT for std/control/robotkin — 2-link planar robot arm kinematics.
import std/control/robotkin

fn _pi() -> float
    let r = 3.141592653589793
    r

fn _fabs(x: float) -> float
    let r = x
    if r < 0.0
        r = 0.0 - r
    r

fn approx(a: float, b: float) -> bool
    let d = _fabs(a - b)
    return d < 0.0001

fn ckf(label: string, got: float, want: float)
    if not approx(got, want)
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckv(label: string, got: any, want: any)
    if len(got) != len(want)
        print("FAIL " + label + ": len " + str(len(got)) + " != " + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        let gv = got[i] * 1.0
        let wv = want[i] * 1.0
        if not approx(gv, wv)
            print("FAIL " + label + "[" + str(i) + "]: got=" + str(gv) + " want=" + str(wv))
            exit(1)
        i = i + 1

fn main()
    let pi = _pi()

    // KAT 1: rk_fk(1,1,0,0) = [2,0] (arm straight along x)
    let fk1 = rk_fk(1.0, 1.0, 0.0, 0.0)
    let want1 = []
    push(want1, 2.0)
    push(want1, 0.0)
    ckv("fk_straight", fk1, want1)

    // KAT 2: rk_fk(1,1,pi/2,0) = [0,2]
    let fk2 = rk_fk(1.0, 1.0, pi * 0.5, 0.0)
    let want2 = []
    push(want2, 0.0)
    push(want2, 2.0)
    ckv("fk_up", fk2, want2)

    // KAT 3: rk_reachable(1,1,2,0) == true
    let ra = rk_reachable(1.0, 1.0, 2.0, 0.0)
    if not ra
        print("FAIL reachable_max: expected true")
        exit(1)

    // KAT 4: rk_reachable(1,1,5,0) == false
    let rb = rk_reachable(1.0, 1.0, 5.0, 0.0)
    if rb
        print("FAIL reachable_5: expected false")
        exit(1)

    // KAT 5: rk_workspace_max(1,1.5) == 2.5
    let wmax = rk_workspace_max(1.0, 1.5)
    ckf("workspace_max", wmax, 2.5)

    // KAT 6: round-trip FK(IK(1,1,1,1)) ~ [1,1]
    let ik_sol = rk_ik(1.0, 1.0, 1.0, 1.0)
    if len(ik_sol) != 2
        print("FAIL ik_rt_len: IK returned empty for (1,1)")
        exit(1)
    let ta = ik_sol[0] * 1.0
    let tb = ik_sol[1] * 1.0
    let fk_check = rk_fk(1.0, 1.0, ta, tb)
    let want_rt = []
    push(want_rt, 1.0)
    push(want_rt, 1.0)
    ckv("fk_ik_roundtrip", fk_check, want_rt)

    // KAT 7: rk_is_singular(1,1,0.5,0.0) == true (t2=0 => straight arm)
    let sing = rk_is_singular(1.0, 1.0, 0.5, 0.0)
    if not sing
        print("FAIL singular_t2_0: expected true")
        exit(1)

    // KAT 8: rk_is_singular(1,1,0.5,1.0) == false (non-degenerate config)
    let sing2 = rk_is_singular(1.0, 1.0, 0.5, 1.0)
    if sing2
        print("FAIL singular_t2_1: expected false")
        exit(1)

    // KAT 9: workspace_min(1,1) == 0 (same-length links)
    let wmin = rk_workspace_min(1.0, 1.0)
    ckf("workspace_min_equal", wmin, 0.0)

    // KAT 10: rk_reach_distance(3,4) == 5
    let dist = rk_reach_distance(3.0, 4.0)
    ckf("reach_distance_3_4", dist, 5.0)

    // KAT 11: rk_end_x(1,1,0,0) == 2
    let endx = rk_end_x(1.0, 1.0, 0.0, 0.0)
    ckf("end_x_straight", endx, 2.0)

    // KAT 12: rk_ik returns empty for unreachable target
    let ik_far = rk_ik(1.0, 1.0, 10.0, 0.0)
    if len(ik_far) != 0
        print("FAIL ik_unreachable: expected empty list")
        exit(1)

    print("PASS _robotkin_test")
