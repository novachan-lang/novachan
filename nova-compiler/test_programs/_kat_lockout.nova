// KAT: forge_lockout -- brute-force / account-lockout guard.
import forge_lockout

fn main()
    let s = lockout_new()

    let c1 = lockout_fail(s, "alice")
    assert(c1 == 1, "first fail returns count 1")
    let c2 = lockout_fail(s, "alice")
    assert(c2 == 2, "second fail returns count 2")
    assert(not lockout_locked(s, "alice", 3), "2 failures < max 3 -> not locked")

    let c3 = lockout_fail(s, "alice")
    assert(c3 == 3, "third fail returns count 3")
    assert(lockout_locked(s, "alice", 3), "3 failures >= max 3 -> locked")
    assert(lockout_remaining(s, "alice", 5) == 2, "5 - 3 = 2 remaining")

    lockout_reset(s, "alice")
    assert(not lockout_locked(s, "alice", 3), "reset clears the counter -> not locked")
    assert(lockout_remaining(s, "alice", 3) == 3, "reset counter -> full attempts remaining")

    assert(not lockout_locked(s, "nobody", 5), "unknown key is never locked")
    assert(lockout_remaining(s, "nobody", 5) == 5, "unknown key has full remaining count")

    print("LOCKOUT KAT PASS")
