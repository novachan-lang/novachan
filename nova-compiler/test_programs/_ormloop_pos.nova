// Positive test: ORM call NOT inside a loop -- must compile with ZERO warnings.
fn orm_all(db, sql: string, params) -> list
    []

type Row
    id: int
    val: string

fn main()
    let xs: list<Row> = orm_all(0, "SELECT id, val FROM Row", [])
    print("count: {len(xs)}")
    for x in xs
        print(x.val)
