// Minimal tokenizer test - exercises string indexing and char comparison
fn mini_tokenize(source: string) -> list
    let tokens = []
    let i = 0
    let n = len(source)
    while i < n
        let ch = source[i]
        if ch == " " or ch == "\n"
            i = i + 1
        else if ch == "+"
            push(tokens, "+")
            i = i + 1
        else if ch == "="
            push(tokens, "=")
            i = i + 1
        else
            // Read identifier or number
            let start = i
            let word = ""
            while i < n and source[i] != " " and source[i] != "\n" and source[i] != "+" and source[i] != "="
                word = word + source[i]
                i = i + 1
            push(tokens, word)
    return tokens

let result = mini_tokenize("let x = 42 + 3")
print("Token count: " + str(len(result)))
for t in result
    print("  " + t)

if len(result) == 6
    print("PASS")
else
    print("FAIL: expected 6 tokens")
