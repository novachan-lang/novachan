import std/bits/binary_fmt

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL binary_fmt " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL binary_fmt " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // bfm_to_binary
    cks("to_bin(5,8)", bfm_to_binary(5, 8), "00000101")
    cks("to_bin(0,8)", bfm_to_binary(0, 8), "00000000")
    cks("to_bin(255,8)", bfm_to_binary(255, 8), "11111111")
    cks("to_bin(1,1)", bfm_to_binary(1, 1), "1")
    cks("to_bin(0,1)", bfm_to_binary(0, 1), "0")
    cks("to_bin(200,8)", bfm_to_binary(200, 8), "11001000")

    // bfm_to_binary_min
    cks("to_min(5)", bfm_to_binary_min(5), "101")
    cks("to_min(0)", bfm_to_binary_min(0), "0")
    cks("to_min(1)", bfm_to_binary_min(1), "1")
    cks("to_min(255)", bfm_to_binary_min(255), "11111111")
    cks("to_min(128)", bfm_to_binary_min(128), "10000000")

    // bfm_from_binary
    cki("from_bin(101)", bfm_from_binary("101"), 5)
    cki("from_bin(11111111)", bfm_from_binary("11111111"), 255)
    cki("from_bin(0)", bfm_from_binary("0"), 0)
    cki("from_bin(1)", bfm_from_binary("1"), 1)
    cki("from_bin(00000101)", bfm_from_binary("00000101"), 5)

    // ROUND-TRIP: bfm_from_binary(bfm_to_binary(n, 8)) == n
    cki("rt(200)", bfm_from_binary(bfm_to_binary(200, 8)), 200)
    cki("rt(0)", bfm_from_binary(bfm_to_binary(0, 8)), 0)
    cki("rt(255)", bfm_from_binary(bfm_to_binary(255, 8)), 255)
    cki("rt(5)", bfm_from_binary(bfm_to_binary(5, 8)), 5)
    // ROUND-TRIP via _min: bfm_from_binary(bfm_to_binary_min(n)) == n
    cki("rt_min(5)", bfm_from_binary(bfm_to_binary_min(5)), 5)
    cki("rt_min(0)", bfm_from_binary(bfm_to_binary_min(0)), 0)
    cki("rt_min(128)", bfm_from_binary(bfm_to_binary_min(128)), 128)

    // bfm_group
    cks("group(11110000,4,' ')", bfm_group("11110000", 4, " "), "1111 0000")
    cks("group(1011,2,_)", bfm_group("1011", 2, "_"), "10_11")
    cks("group(101,4,' ')", bfm_group("101", 4, " "), "101")
    cks("group(00000101,4,' ')", bfm_group("00000101", 4, " "), "0000 0101")

    // bfm_count_ones_str
    cki("ones(1011)", bfm_count_ones_str("1011"), 3)
    cki("ones(00000000)", bfm_count_ones_str("00000000"), 0)
    cki("ones(11111111)", bfm_count_ones_str("11111111"), 8)
    cki("ones(0)", bfm_count_ones_str("0"), 0)
    cki("ones(1)", bfm_count_ones_str("1"), 1)

    print("PASS _binary_fmt_test")
