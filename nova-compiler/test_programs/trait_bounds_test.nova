// Test trait bounds on generic type parameters

trait Printable
    fn show(self) -> string

type Point : Printable
    x: int
    y: int

fn Point__show(self: Point) -> string
    return "(" + str(self.x) + ", " + str(self.y) + ")"

type Color
    r: int
    g: int
    b: int

// This function requires T to implement Printable
fn<T: Printable> display(item: T) -> string
    return item.show()

fn main()
    let p = Point(3, 4)
    let s = display(p)
    assert(s == "(3, 4)", "display point")
    print("trait_bounds: all passed")
