import forge_hamiltonian as ham

fn check(cond: bool, label: string)
    if cond == false
        print("FAIL: " + label)

fn main()
    // ---- complete graph K4: has both a Hamiltonian path and cycle ----
    let k4 = ham.build_adj(4, [0, 1, 0, 2, 0, 3, 1, 2, 1, 3, 2, 3])
    let p4 = ham.hamiltonian_path(k4, 4)
    check(len(p4) == 4, "K4 has a Ham path")
    check(ham.is_hamiltonian(k4, p4, 4, false), "K4 path valid")
    let c4 = ham.hamiltonian_cycle(k4, 4)
    check(len(c4) == 4, "K4 has a Ham cycle")
    check(ham.is_hamiltonian(k4, c4, 4, true), "K4 cycle valid")

    // ---- path graph 0-1-2-3: has a Ham path but NO Ham cycle ----
    let pg = ham.build_adj(4, [0, 1, 1, 2, 2, 3])
    let pp = ham.hamiltonian_path(pg, 4)
    check(len(pp) == 4, "path graph has Ham path")
    check(ham.is_hamiltonian(pg, pp, 4, false), "path graph path valid")
    check(len(ham.hamiltonian_cycle(pg, 4)) == 0, "path graph has NO Ham cycle")

    // ---- cycle graph 0-1-2-3-0: has a Ham cycle ----
    let cg = ham.build_adj(4, [0, 1, 1, 2, 2, 3, 3, 0])
    let cc = ham.hamiltonian_cycle(cg, 4)
    check(len(cc) == 4, "cycle graph has Ham cycle")
    check(ham.is_hamiltonian(cg, cc, 4, true), "cycle graph cycle valid")

    // ---- disconnected graph: two components -> no Ham path ----
    let dg = ham.build_adj(4, [0, 1, 2, 3])
    check(len(ham.hamiltonian_path(dg, 4)) == 0, "disconnected has no Ham path")

    // ---- a "star" K1,3 (center 0 joined to 1,2,3): no Ham path (can't traverse 3 leaves) ----
    let star = ham.build_adj(4, [0, 1, 0, 2, 0, 3])
    check(len(ham.hamiltonian_path(star, 4)) == 0, "star K1,3 has no Ham path")

    // ---- Petersen graph (10 vertices): famously has a Hamiltonian PATH but NO Hamiltonian CYCLE ----
    // outer pentagon 0-1-2-3-4-0, inner pentagram 5-7-9-6-8-5, spokes i - (i+5)
    let pet = ham.build_adj(10, [0, 1, 1, 2, 2, 3, 3, 4, 4, 0, 5, 7, 7, 9, 9, 6, 6, 8, 8, 5, 0, 5, 1, 6, 2, 7, 3, 8, 4, 9])
    let petp = ham.hamiltonian_path(pet, 10)
    check(len(petp) == 10, "Petersen has a Ham path")
    check(ham.is_hamiltonian(pet, petp, 10, false), "Petersen path valid")
    check(len(ham.hamiltonian_cycle(pet, 10)) == 0, "Petersen has NO Ham cycle")

    // ---- larger complete graph K7 for a bigger valid construction ----
    let e7 = []
    let a = 0
    while a < 7
        let b = a + 1
        while b < 7
            push(e7, a)
            push(e7, b)
            b = b + 1
        a = a + 1
    let k7 = ham.build_adj(7, e7)
    let c7 = ham.hamiltonian_cycle(k7, 7)
    check(ham.is_hamiltonian(k7, c7, 7, true), "K7 cycle valid")

    print("forge_hamiltonian: all passed")
