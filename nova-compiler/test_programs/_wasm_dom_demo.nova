// WASM Stage 0/1 proof: a NOVA function reaches the browser DOM via a host import.
// `dom_set_text` is declared extern -> in a wasm32 module an undefined declare lowers to
// `import "env" "dom_set_text"`, which the host (browser / Node) supplies. Extern calls
// require `unsafe` (C is outside NOVA's safety envelope).
extern fn dom_set_text(id: string, txt: string)

fn main()
    unsafe dom_set_text("app", "Hello from NOVA")
