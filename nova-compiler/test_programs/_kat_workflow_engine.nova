import forge_workflow_engine

fn main()
    let wf = wf_new("deploy-pipeline")
    assert(wf_status(wf) == "pending", "starts pending")
    assert(wf_step_count(wf) == 0, "no steps")

    wf = wf_add_step(wf, "build", "action")
    wf = wf_add_step(wf, "test", "action")
    wf = wf_add_step(wf, "deploy", "action")
    assert(wf_step_count(wf) == 3, "3 steps")
    assert(wf_progress(wf) == 0, "0% progress")

    wf = wf_start(wf)
    assert(wf_status(wf) == "running", "running")
    assert(wf_current_step(wf) == "build", "current = build")

    wf = wf_complete_step(wf, "binary-v1.0")
    assert(wf_current_step(wf) == "test", "current = test")
    assert(wf_progress(wf) == 33, "33% progress")
    assert(wf_result(wf, "build") == "binary-v1.0", "build result")

    wf = wf_complete_step(wf, "all-pass")
    assert(wf_current_step(wf) == "deploy", "current = deploy")
    assert(wf_progress(wf) == 66, "66%")

    wf = wf_complete_step(wf, "deployed-prod")
    assert(wf_status(wf) == "completed", "completed")
    assert(wf_result(wf, "deploy") == "deployed-prod", "deploy result")

    let wf2 = wf_new("risky")
    wf2 = wf_add_step(wf2, "check", "action")
    wf2 = wf_add_step(wf2, "apply", "action")
    wf2 = wf_start(wf2)
    wf2 = wf_fail_step(wf2, "check failed")
    assert(wf_status(wf2) == "failed", "failed workflow")
    assert(wf_result(wf2, "missing") == "", "no result for missing step")

    let wf3 = wf_new("empty")
    wf3 = wf_start(wf3)
    assert(wf_status(wf3) == "completed", "empty = completed")

    print("WORKFLOW-ENGINE KAT PASS")
