import "std/collections/skewheap"

// cki: check integer equality; exit(1) on mismatch.
fn cki(got, want, label)
    if got != want
        print("FAIL skewheap " + label + ": got " + str(got) + " want " + str(want))
        exit(1)
    return 0

// cks: check string equality; exit(1) on mismatch.
fn cks(got, want, label)
    if got != want
        print("FAIL skewheap " + label + ": got " + got + " want " + want)
        exit(1)
    return 0

// ---- KAT 1: empty heap safety ----
let empty = sk_empty()
let min_empty = sk_find_min(empty)
cki(min_empty == null, 1, "find_min on null == null")
let del_empty = sk_delete_min(empty)
cki(del_empty == null, 1, "delete_min on null == null")

// ---- KAT 2: single element ----
let s1 = sk_empty()
s1 = sk_insert(s1, 42)
cki(sk_find_min(s1), 42, "single elem find_min == 42")
s1 = sk_delete_min(s1)
let after_del = sk_find_min(s1)
cki(after_del == null, 1, "single elem empty after delete")

// ---- KAT 3: six inserts -> find_min -> to_sorted ----
// Insert 5,3,8,1,9,2  ->  min==1  ->  sorted==[1,2,3,5,8,9]
let h = sk_empty()
h = sk_insert(h, 5)
h = sk_insert(h, 3)
h = sk_insert(h, 8)
h = sk_insert(h, 1)
h = sk_insert(h, 9)
h = sk_insert(h, 2)
cki(sk_find_min(h), 1, "six inserts find_min == 1")

let sorted = sk_to_sorted(h)
cki(len(sorted), 6, "to_sorted length == 6")
cki(sorted[0], 1, "sorted[0] == 1")
cki(sorted[1], 2, "sorted[1] == 2")
cki(sorted[2], 3, "sorted[2] == 3")
cki(sorted[3], 5, "sorted[3] == 5")
cki(sorted[4], 8, "sorted[4] == 8")
cki(sorted[5], 9, "sorted[5] == 9")

// ---- KAT 4: sk_merge of two heaps ----
// Heap A: [3, 7]   Heap B: [1, 5]
// Merged to_sorted == [1, 3, 5, 7]
let ha = sk_empty()
ha = sk_insert(ha, 3)
ha = sk_insert(ha, 7)
let hb = sk_empty()
hb = sk_insert(hb, 1)
hb = sk_insert(hb, 5)
let hm = sk_merge(ha, hb)
cki(sk_find_min(hm), 1, "merged find_min == 1")
let msorted = sk_to_sorted(hm)
cki(len(msorted), 4, "merged to_sorted length == 4")
cki(msorted[0], 1, "msorted[0] == 1")
cki(msorted[1], 3, "msorted[1] == 3")
cki(msorted[2], 5, "msorted[2] == 5")
cki(msorted[3], 7, "msorted[3] == 7")

// ---- KAT 5: merge with null ----
let hn = sk_empty()
hn = sk_insert(hn, 10)
let hmerge_null = sk_merge(hn, null)
cki(sk_find_min(hmerge_null), 10, "merge with null right preserves heap")
let hmerge_null2 = sk_merge(null, hn)
cki(sk_find_min(hmerge_null2), 10, "merge with null left preserves heap")

// ---- KAT 6: duplicates ----
let hd = sk_empty()
hd = sk_insert(hd, 5)
hd = sk_insert(hd, 5)
hd = sk_insert(hd, 3)
hd = sk_insert(hd, 3)
cki(sk_find_min(hd), 3, "dup find_min == 3")
let dsorted = sk_to_sorted(hd)
cki(len(dsorted), 4, "dup to_sorted length == 4")
cki(dsorted[0], 3, "dup sorted[0] == 3")
cki(dsorted[1], 3, "dup sorted[1] == 3")
cki(dsorted[2], 5, "dup sorted[2] == 5")
cki(dsorted[3], 5, "dup sorted[3] == 5")

// ---- KAT 7: sequential delete_min extracts in order ----
let hseq = sk_empty()
hseq = sk_insert(hseq, 7)
hseq = sk_insert(hseq, 2)
hseq = sk_insert(hseq, 5)
hseq = sk_insert(hseq, 1)
hseq = sk_insert(hseq, 4)
let seq1 = sk_find_min(hseq)
cki(seq1, 1, "seq del min1 == 1")
hseq = sk_delete_min(hseq)
let seq2 = sk_find_min(hseq)
cki(seq2, 2, "seq del min2 == 2")
hseq = sk_delete_min(hseq)
let seq3 = sk_find_min(hseq)
cki(seq3, 4, "seq del min3 == 4")
hseq = sk_delete_min(hseq)
let seq4 = sk_find_min(hseq)
cki(seq4, 5, "seq del min4 == 5")
hseq = sk_delete_min(hseq)
let seq5 = sk_find_min(hseq)
cki(seq5, 7, "seq del min5 == 7")
hseq = sk_delete_min(hseq)
let seq_end = sk_find_min(hseq)
cki(seq_end == null, 1, "seq exhausted -> null")

print("PASS _skewheap_test")
