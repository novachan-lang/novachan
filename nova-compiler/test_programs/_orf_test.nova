// _orf_test.nova — KAT for std/bio/orf (open reading frame finding).
import std/bio/orf

fn check_int(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn check_bool(label, got, want)
    let g = 0
    if got
        g = 1
    let w = 0
    if want
        w = 1
    if g != w
        print("FAIL " + label + ": got=" + str(g) + " want=" + str(w))
        exit(1)

fn check_str(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn approx(a, b, tol) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < tol

fn main()
    // --- KAT 1: orf_find on 'ATGAAATAA' (ATG start at 0, stop TAA at 6) ---
    // ORF: start=0, end=8, length=9
    let dna1 = "ATGAAATAA"
    let orfs1 = orf_find(dna1)
    check_int("orf_find count", len(orfs1), 1)
    let o1 = orfs1[0]
    check_int("orf_find start", o1["start"], 0)
    check_int("orf_find end", o1["end"], 8)
    check_int("orf_find length", o1["length"], 9)

    // --- KAT 2: orf_count ---
    check_int("orf_count ATGAAATAA", orf_count("ATGAAATAA"), 1)
    check_int("orf_count no orf", orf_count("AAACCCGGG"), 0)
    check_int("orf_count empty", orf_count(""), 0)

    // --- KAT 3: orf_has_orf ---
    check_bool("orf_has_orf true", orf_has_orf("ATGAAATAA"), true)
    check_bool("orf_has_orf false", orf_has_orf("AAACCCGGG"), false)

    // --- KAT 4: orf_translate includes M but stops before stop codon ---
    // ATGAAATAA: ATG->M, AAA->K, TAA->* (stop, excluded)
    let prot1 = orf_translate("ATGAAATAA", 0, 8)
    let has_m = false
    if len(prot1) > 0
        let first = slice(prot1, 0, 1)
        if first == "M"
            has_m = true
    check_bool("orf_translate starts with M", has_m, true)
    // should be "MK" (2 AAs before stop)
    check_str("orf_translate MK", prot1, "MK")

    // --- KAT 5: orf_longest_protein ---
    let lp = orf_longest_protein("ATGAAATAA")
    let has_m2 = false
    if len(lp) > 0
        let ch = slice(lp, 0, 1)
        if ch == "M"
            has_m2 = true
    check_bool("orf_longest_protein starts M", has_m2, true)

    // --- KAT 6: two ORFs in frame 0, longest is selected ---
    // ATGAAATAGATGCCCTAA: frame0 ORF1=ATGAAATAG(0..8), ORF2=ATGCCCTAA(9..17)
    let dna2 = "ATGAAATAGATGCCCTAA"
    let orfs2 = orf_find(dna2)
    check_int("two orfs count", len(orfs2), 2)
    let best = orf_longest(dna2)
    check_int("longest start", best["start"], 0)

    // --- KAT 7: orf_gc ---
    // ATGAAATAA: A,T,G,A,A,A,T,A,A  GC=1 out of 9 => 1/9
    let gc1 = orf_gc("ATGAAATAA", 0, 8)
    check_bool("orf_gc approx", approx(gc1, 0.1111, 0.002), true)

    // ATGCCC: G+C+C+C = 4 out of 6 => 0.666
    let gc2 = orf_gc("ATGCCC", 0, 5)
    check_bool("orf_gc ATGCCC", approx(gc2, 0.6666, 0.002), true)

    // --- KAT 8: orf_upstream ---
    // upstream of pos 3 with n=3 in "GGGAAATGAAATAA" = "AAA" (indices 0..2)... wait
    // Let's use: dna="TTTAAATGCCC", ATG starts at 6. upstream(6,3) = "AAA"
    let u1 = orf_upstream("TTTAAATGCCC", 6, 3)
    check_str("orf_upstream 3", u1, "AAA")
    let u0 = orf_upstream("ATGAAA", 0, 3)
    check_str("orf_upstream start=0", u0, "")

    // --- KAT 9: orf_between ---
    let sub1 = orf_between("ATGAAATAA", 0, 8)
    check_str("orf_between", sub1, "ATGAAATAA")

    // --- KAT 10: orf_min_length_filter ---
    let all_orfs = orf_find_all_frames("ATGAAATAGATGCCCTAA")
    let filtered = orf_min_length_filter(all_orfs, 10)
    // Each ORF in frame 0 is 9 bases, none >= 10
    check_int("min_length_filter 10", len(filtered), 0)
    let filtered2 = orf_min_length_filter(all_orfs, 9)
    check_int("min_length_filter 9", len(filtered2), 2)

    // --- KAT 11: orf_find_frame different frames ---
    // "XXXATGAAATAA" frame 0 has no ATG at pos 0 (XXX are invalid codons)
    // But in frame 0: XXX, ATG (pos3), AAA, TAA -> 1 ORF
    let dna3 = "CCCATGAAATAA"
    let f0 = orf_find_frame(dna3, 0)
    check_int("find_frame 0 count", len(f0), 1)
    check_int("find_frame 0 start", f0[0]["start"], 3)
    // In frame 1: CC, CAT, GAA, ATA, A — no ATG -> 0 ORFs
    let f1 = orf_find_frame(dna3, 1)
    check_int("find_frame 1 count", len(f1), 0)

    // --- KAT 12: empty/short DNA ---
    check_int("orf_count empty2", orf_count(""), 0)
    check_int("orf_count short", orf_count("AT"), 0)

    print("PASS _orf_test")
