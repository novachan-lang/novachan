// KAT: LOCK-5 cooperative safepoint kill.
fn worker()
    let i = 0
    while i < 1000000
        i = i + 1
        reschedule()      // safepoint: a pending kill unwinds here
    print("worker FINISHED (should not print if killed)")

fn main()
    let p = spawn worker()
    reschedule()
    let r = kill(p)
    print("kill(live pid)  -> " + str(r))
    let r2 = kill(999999)
    print("kill(bad pid)   -> " + str(r2))
    print("kill_pending()  -> " + str(kill_pending()))
    let i = 0
    while i < 50
        reschedule()
        i = i + 1
    print("main survived after killing worker")
