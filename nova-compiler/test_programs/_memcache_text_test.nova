// KAT for std/net/memcache_text — Memcached ASCII protocol codec.
import std/net/memcache_text

// ── Assertion helpers ─────────────────────────────────────────────────────────

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL memcache_text " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL memcache_text " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    let crlf = chr(13) + chr(10)

    // ── KAT 1: mc_set basic ─────────────────────────────────────────────────
    let set1 = mc_set("foo", 0, 0, "bar")
    let want_set1 = "set foo 0 0 3" + crlf + "bar" + crlf
    cks("set-basic", set1, want_set1)

    // ── KAT 2: mc_set with flags and exptime ────────────────────────────────
    let set2 = mc_set("mykey", 7, 3600, "hello")
    let want_set2 = "set mykey 7 3600 5" + crlf + "hello" + crlf
    cks("set-flags-exptime", set2, want_set2)

    // ── KAT 3: mc_set empty data ────────────────────────────────────────────
    let set3 = mc_set("empty", 0, 0, "")
    let want_set3 = "set empty 0 0 0" + crlf + "" + crlf
    cks("set-empty-data", set3, want_set3)

    // ── KAT 4: mc_get single key ─────────────────────────────────────────────
    let gkeys1 = []
    push(gkeys1, "foo")
    let get1 = mc_get(gkeys1)
    let want_get1 = "get foo" + crlf
    cks("get-single", get1, want_get1)

    // ── KAT 5: mc_get multiple keys ──────────────────────────────────────────
    let gkeys2 = []
    push(gkeys2, "foo")
    push(gkeys2, "baz")
    let get2 = mc_get(gkeys2)
    let want_get2 = "get foo baz" + crlf
    cks("get-multi", get2, want_get2)

    // ── KAT 6: mc_get empty list ─────────────────────────────────────────────
    let gkeys3 = []
    let get3 = mc_get(gkeys3)
    cks("get-empty-keys", get3, "")

    // ── KAT 7: mc_get three keys ─────────────────────────────────────────────
    let gkeys4 = []
    push(gkeys4, "a")
    push(gkeys4, "b")
    push(gkeys4, "c")
    let get4 = mc_get(gkeys4)
    let want_get4 = "get a b c" + crlf
    cks("get-three", get4, want_get4)

    // ── KAT 8: mc_delete ─────────────────────────────────────────────────────
    let del1 = mc_delete("foo")
    let want_del1 = "delete foo" + crlf
    cks("delete-basic", del1, want_del1)

    // ── KAT 9: mc_delete another key ─────────────────────────────────────────
    let del2 = mc_delete("session:abc123")
    let want_del2 = "delete session:abc123" + crlf
    cks("delete-colon-key", del2, want_del2)

    // ── KAT 10: mc_incr ──────────────────────────────────────────────────────
    let incr1 = mc_incr("n", 5)
    let want_incr1 = "incr n 5" + crlf
    cks("incr-basic", incr1, want_incr1)

    // ── KAT 11: mc_incr by 1 ─────────────────────────────────────────────────
    let incr2 = mc_incr("counter", 1)
    let want_incr2 = "incr counter 1" + crlf
    cks("incr-by-one", incr2, want_incr2)

    // ── KAT 12: mc_decr ──────────────────────────────────────────────────────
    let decr1 = mc_decr("n", 3)
    let want_decr1 = "decr n 3" + crlf
    cks("decr-basic", decr1, want_decr1)

    // ── KAT 13: mc_parse_value basic ─────────────────────────────────────────
    let val_text1 = "VALUE foo 0 3" + crlf + "bar" + crlf + "END" + crlf
    let v1 = mc_parse_value(val_text1)
    cks("parse-value-key",   v1["key"],  "foo")
    cki("parse-value-flags", v1["flags"], 0)
    cks("parse-value-data",  v1["data"], "bar")

    // ── KAT 14: mc_parse_value with flags ────────────────────────────────────
    let val_text2 = "VALUE mykey 7 5" + crlf + "hello" + crlf + "END" + crlf
    let v2 = mc_parse_value(val_text2)
    cks("parse-value2-key",   v2["key"],  "mykey")
    cki("parse-value2-flags", v2["flags"], 7)
    cks("parse-value2-data",  v2["data"], "hello")

    // ── KAT 15: mc_parse_value longer data ───────────────────────────────────
    let val_text3 = "VALUE session 32 11" + crlf + "hello world" + crlf + "END" + crlf
    let v3 = mc_parse_value(val_text3)
    cks("parse-value3-key",   v3["key"],  "session")
    cki("parse-value3-flags", v3["flags"], 32)
    cks("parse-value3-data",  v3["data"], "hello world")

    // ── KAT 16: mc_parse_value empty/malformed ───────────────────────────────
    let vbad = mc_parse_value("")
    cks("parse-value-empty-key",  vbad["key"],  "")
    cki("parse-value-empty-flags", vbad["flags"], 0)
    cks("parse-value-empty-data",  vbad["data"], "")

    // ── KAT 17: mc_parse_value wrong prefix ──────────────────────────────────
    let val_bad2 = mc_parse_value("ERROR" + crlf)
    cks("parse-value-bad-prefix-key", val_bad2["key"], "")

    // ── KAT 18: mc_parse_reply STORED ────────────────────────────────────────
    let rep1 = mc_parse_reply("STORED" + crlf)
    cks("parse-reply-stored", rep1, "STORED")

    // ── KAT 19: mc_parse_reply NOT_FOUND ─────────────────────────────────────
    let rep2 = mc_parse_reply("NOT_FOUND" + crlf)
    cks("parse-reply-not-found", rep2, "NOT_FOUND")

    // ── KAT 20: mc_parse_reply DELETED ───────────────────────────────────────
    let rep3 = mc_parse_reply("DELETED" + crlf)
    cks("parse-reply-deleted", rep3, "DELETED")

    // ── KAT 21: mc_parse_reply END ───────────────────────────────────────────
    let rep4 = mc_parse_reply("END" + crlf)
    cks("parse-reply-end", rep4, "END")

    // ── KAT 22: mc_parse_reply ERROR ─────────────────────────────────────────
    let rep5 = mc_parse_reply("ERROR" + crlf)
    cks("parse-reply-error", rep5, "ERROR")

    // ── KAT 23: mc_parse_reply empty ─────────────────────────────────────────
    let rep6 = mc_parse_reply("")
    cks("parse-reply-empty", rep6, "")

    // ── KAT 24: mc_parse_reply numeric (incr result) ─────────────────────────
    let rep7 = mc_parse_reply("42" + crlf)
    cks("parse-reply-numeric", rep7, "42")

    // ── KAT 25: mc_parse_reply NOT_STORED ────────────────────────────────────
    let rep8 = mc_parse_reply("NOT_STORED" + crlf)
    cks("parse-reply-not-stored", rep8, "NOT_STORED")

    // ── KAT 26: round-trip set/parse_value data integrity ────────────────────
    // Build a set command, then manually construct what the server would
    // send back as a VALUE response, then parse and verify data matches.
    let rt_key = "testkey"
    let rt_data = "roundtrip"
    let rt_set = mc_set(rt_key, 0, 0, rt_data)
    // Verify the set command has the right byte count
    let want_rt_set = "set testkey 0 0 9" + crlf + "roundtrip" + crlf
    cks("roundtrip-set-cmd", rt_set, want_rt_set)
    // Now parse the equivalent VALUE response
    let rt_response = "VALUE testkey 0 9" + crlf + "roundtrip" + crlf + "END" + crlf
    let rt_parsed = mc_parse_value(rt_response)
    cks("roundtrip-key",  rt_parsed["key"],  rt_key)
    cks("roundtrip-data", rt_parsed["data"], rt_data)

    // ── KAT 27: mc_parse_value bytes field limits data extraction ────────────
    // bytes=3 with extra data after — only first 3 bytes captured
    let trunc_text = "VALUE foo 0 3" + crlf + "barbaz" + crlf + "END" + crlf
    let vt = mc_parse_value(trunc_text)
    cks("parse-value-trunc-data", vt["data"], "bar")

    // ── KAT 28: mc_incr large value ──────────────────────────────────────────
    let incr3 = mc_incr("hits", 1000000)
    let want_incr3 = "incr hits 1000000" + crlf
    cks("incr-large", incr3, want_incr3)

    print("PASS _memcache_text_test")
