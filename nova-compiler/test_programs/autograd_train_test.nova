import autograd

// End-to-end proof that the autograd spine TRAINS, not just differentiates:
// fit y = w*x + b to data generated from y = 2x + 1 by minimizing mean-squared
// error with plain gradient descent. Each epoch rebuilds the loss graph with the
// current params as leaves, runs one backward pass for dL/dw and dL/db, and steps
// the params. Asserts the learned params converge to the true (2, 1).

fn _near(a: float, b: float) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < 0.05
        return 1
    0

fn main()
    // training data: y = 2x + 1, exact
    let xs = [0.0, 1.0, 2.0, 3.0, 4.0]
    let ys = [1.0, 3.0, 5.0, 7.0, 9.0]
    let n = len(xs)

    let w = 0.0
    let b = 0.0
    let lr = 0.01

    let last_loss = 0.0
    let epoch = 0
    while epoch < 4000
        let t = autograd.ad_tape()
        let wn = autograd.ad_leaf(t, w)
        let bn = autograd.ad_leaf(t, b)
        // loss = sum_i (w*xi + b - yi)^2
        let loss = autograd.ad_leaf(t, 0.0)
        let i = 0
        while i < n
            let xi = autograd.ad_leaf(t, xs[i])
            let yi = autograd.ad_leaf(t, ys[i])
            let pred = autograd.ad_add(t, autograd.ad_mul(t, wn, xi), bn)
            let diff = autograd.ad_sub(t, pred, yi)
            let sq = autograd.ad_mul(t, diff, diff)
            loss = autograd.ad_add(t, loss, sq)
            i = i + 1
        autograd.ad_backward(t, loss)
        let gw = autograd.ad_grad(t, wn)
        let gb = autograd.ad_grad(t, bn)
        w = w - lr * gw
        b = b - lr * gb
        last_loss = autograd.ad_value(t, loss)
        epoch = epoch + 1

    print("trained w=" + str(w) + " b=" + str(b) + " final_loss=" + str(last_loss))
    assert(_near(w, 2.0), "learned slope -> 2")
    assert(_near(b, 1.0), "learned intercept -> 1")
    assert(last_loss < 0.01, "loss converged near 0")

    // the trained model predicts a held-out point: x=10 -> ~21
    let pred10 = w * 10.0 + b
    assert(_near(pred10, 21.0), "predicts unseen x=10 -> 21")

    print("autograd_train_test: all passed")
