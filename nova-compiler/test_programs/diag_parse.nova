// Diagnostic: test parse_program pattern from self-test

type Token
    kind: string
    value: string
    line: int
    col: int

type Expr
    tag: string
    value: string
    num: int
    children: list
    fields: list

type Stmt
    tag: string
    name: string
    expr: Expr
    body: list
    params: list
    else_body: list
    annotations: list

type Param
    name: string
    type_ann: string
    default_val: Expr

type ParseResult
    expr: Expr
    pos: int

type StmtParseResult
    stmt: Stmt
    pos: int

fn is_alpha(ch: string) -> bool
    let c = ord(ch)
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or ch == "_"

fn is_digit(ch: string) -> bool
    let c = ord(ch)
    c >= 48 and c <= 57

fn is_alnum(ch: string) -> bool
    is_alpha(ch) or is_digit(ch)

fn is_ws(ch: string) -> bool
    ch == " " or ch == "\t" or ch == "\r"

fn is_keyword(word: string) -> bool
    (word == "fn" or word == "return" or word == "if" or word == "else" or word == "for" or word == "while" or word == "let" or word == "in")

fn tokenize(source: string) -> list
    let tokens = []
    let pos = 0
    let line = 1
    let col = 1
    let length = len(source)
    while pos < length
        let ch = source[pos]
        if ch == "\n"
            push(tokens, Token("NEWLINE", "\\n", line, col))
            line = line + 1
            col = 1
            pos = pos + 1
        else if is_ws(ch)
            while pos < length and is_ws(source[pos])
                pos = pos + 1
                col = col + 1
        else if is_alpha(ch)
            let start_col = col
            let word = ""
            while pos < length and is_alnum(source[pos])
                word = word + source[pos]
                pos = pos + 1
                col = col + 1
            if is_keyword(word)
                push(tokens, Token("KW", word, line, start_col))
            else
                push(tokens, Token("IDENT", word, line, start_col))
        else if is_digit(ch)
            let start_col = col
            let num = ""
            while pos < length and is_digit(source[pos])
                num = num + source[pos]
                pos = pos + 1
                col = col + 1
            push(tokens, Token("INT", num, line, start_col))
        else if ch == "="
            push(tokens, Token("ASSIGN", "=", line, col))
            pos = pos + 1
            col = col + 1
        else if ch == "+"
            push(tokens, Token("OP", "+", line, col))
            pos = pos + 1
            col = col + 1
        else if ch == "("
            push(tokens, Token("LPAREN", "(", line, col))
            pos = pos + 1
            col = col + 1
        else if ch == ")"
            push(tokens, Token("RPAREN", ")", line, col))
            pos = pos + 1
            col = col + 1
        else
            pos = pos + 1
            col = col + 1
    push(tokens, Token("EOF", "", line, col))
    tokens

fn tok_kind(tokens: list, pos: int) -> string
    let t = tokens[pos]
    match t
        Token(k, v, l, c) => k

fn tok_value(tokens: list, pos: int) -> string
    let t = tokens[pos]
    match t
        Token(k, v, l, c) => v

fn skip_newlines(tokens: list, pos: int) -> int
    let p = pos
    while p < len(tokens) and tok_kind(tokens, p) == "NEWLINE"
        p = p + 1
    p

fn parse_expr(tokens: list, pos: int, min_bp: int) -> ParseResult
    let p = pos
    let kind = tok_kind(tokens, p)
    let val = tok_value(tokens, p)
    let left = Expr("null", "", 0, [], [])

    if kind == "INT"
        left = Expr("int", val, 0, [], [])
        p = p + 1
    else if kind == "IDENT"
        left = Expr("ident", val, 0, [], [])
        p = p + 1
    else
        left = Expr("error", "unexpected " + kind, 0, [], [])
        p = p + 1

    // Infix loop
    while p < len(tokens)
        let op_kind = tok_kind(tokens, p)
        let op_val = tok_value(tokens, p)
        if op_kind == "OP" and op_val == "+"
            if min_bp >= 10
                break
            p = p + 1
            let rhs_result = parse_expr(tokens, p, 10)
            match rhs_result
                ParseResult(rhs_expr, rhs_pos) =>
                    left = Expr("binop", "+", 0, [left, rhs_expr], [])
                    p = rhs_pos
        else
            break

    ParseResult(left, p)

fn parse_stmt(tokens: list, pos: int) -> StmtParseResult
    let p = skip_newlines(tokens, pos)
    let kind = tok_kind(tokens, p)
    let val = tok_value(tokens, p)

    if kind == "KW" and val == "let"
        p = p + 1
        let name = tok_value(tokens, p)
        p = p + 1
        p = p + 1  // skip =
        let expr_result = parse_expr(tokens, p, 0)
        match expr_result
            ParseResult(e, ep) =>
                let stmt = Stmt("let", name, e, [], [], [], [])
                return StmtParseResult(stmt, ep)
    else if kind == "IDENT"
        let name = val
        p = p + 1
        if p < len(tokens) and tok_kind(tokens, p) == "ASSIGN"
            p = p + 1
            let expr_result = parse_expr(tokens, p, 0)
            match expr_result
                ParseResult(e, ep) =>
                    let stmt = Stmt("assign", name, e, [], [], [], [])
                    return StmtParseResult(stmt, ep)
        else
            let expr = Expr("ident", name, 0, [], [])
            let stmt = Stmt("expr", "", expr, [], [], [], [])
            return StmtParseResult(stmt, p)

    let null_expr = Expr("null", "", 0, [], [])
    StmtParseResult(Stmt("error", "unexpected", null_expr, [], [], [], []), p + 1)

fn parse_program(tokens: list) -> list
    let stmts = []
    let pos = 0
    while pos < len(tokens) and tok_kind(tokens, pos) != "EOF"
        if tok_kind(tokens, pos) == "NEWLINE"
            pos = pos + 1
        else
            let result = parse_stmt(tokens, pos)
            match result
                StmtParseResult(s, new_pos) =>
                    push(stmts, s)
                    pos = new_pos
    stmts

// Test
let tokens = tokenize("x = 10\ny = x + 5")
print(len(tokens))
let stmts = parse_program(tokens)
print(len(stmts))

for s in stmts
    match s
        Stmt(tag, name, expr, body, params, else_body, ann) =>
            print(tag + ": " + name)

print("PARSE TEST DONE")
