// _asn1_parse_test — KAT for std/data/asn1_parse
//
// Verifies:
//   KAT1:  asn1_read_tlv of SEQUENCE{INT 1, INT 2} header
//          -> tag=48(0x30), class=0, constructed=1, length=6, content_start=2, next_pos=8
//   KAT2:  asn1_parse of that SEQUENCE -> constructed node, 2 INTEGER children
//          child[0].value == [0x01], child[1].value == [0x02]
//   KAT3:  asn1_parse([0x05,0x00]) -> primitive NULL, tag=5, value=empty
//   KAT4:  asn1_parse([0x02]) -> error node (truncated)
//   KAT5:  asn1_read_tlv on empty bytes -> next_pos=-1
//   KAT6:  asn1_read_tlv at out-of-bounds pos -> next_pos=-1
//   KAT7:  asn1_parse([0x02,0x01,0x7F]) -> primitive INTEGER, value=[0x7F]
//   KAT8:  asn1_hexdump correctness
//   KAT9:  round-trip parse SEQUENCE{INT 1, INT 2}
//   KAT10: nested SEQUENCE -> SEQUENCE -> {INT 1, INT 2}
//   KAT11: asn1_read_tlv at embedded offset within a stream
//   KAT12: long-form length (200-byte OCTET STRING)
//   KAT13: BOOLEAN true -> value byte 255
//   KAT14: truncated length field -> error
//   KAT15: OCTET STRING with 3 bytes

import std/data/asn1_parse

// Helper: build bytes from a list of decimal byte values
fn make_bytes(vals: list) -> any
    let out = bytes(0)
    let n = len(vals)
    let i = 0
    while i < n
        out = bytes_append(out, vals[i])
        i = i + 1
    out

// ── KAT1: asn1_read_tlv SEQUENCE header ──────────────────────────────────────
// Bytes: 48 6 2 1 1 2 1 2  (0x30 0x06 0x02 0x01 0x01 0x02 0x01 0x02)
// Tag=48(SEQUENCE=0x30), length=6, content_start=2, next_pos=8
let seq_raw = make_bytes([48, 6, 2, 1, 1, 2, 1, 2])
let tlv1 = asn1_read_tlv(seq_raw, 0)
let tlv1_info = tlv1[0]
let tlv1_next = tlv1[1]

if tlv1_next != 8
    print("FAIL asn1_parse KAT1: next_pos expected 8, got " + str(tlv1_next))
    exit(1)
if tlv1_info["tag"] != 48
    print("FAIL asn1_parse KAT1: tag expected 48 (0x30), got " + str(tlv1_info["tag"]))
    exit(1)
if tlv1_info["constructed"] != 1
    print("FAIL asn1_parse KAT1: constructed expected 1, got " + str(tlv1_info["constructed"]))
    exit(1)
if tlv1_info["class"] != 0
    print("FAIL asn1_parse KAT1: class expected 0, got " + str(tlv1_info["class"]))
    exit(1)
if tlv1_info["length"] != 6
    print("FAIL asn1_parse KAT1: length expected 6, got " + str(tlv1_info["length"]))
    exit(1)
if tlv1_info["content_start"] != 2
    print("FAIL asn1_parse KAT1: content_start expected 2, got " + str(tlv1_info["content_start"]))
    exit(1)
if tlv1_info["content_len"] != 6
    print("FAIL asn1_parse KAT1: content_len expected 6, got " + str(tlv1_info["content_len"]))
    exit(1)
print("PASS KAT1: asn1_read_tlv SEQUENCE header")

// ── KAT2: asn1_parse of SEQUENCE{INT 1, INT 2} ───────────────────────────────
let tree2 = asn1_parse(seq_raw)
if tree2["tag"] != 48
    print("FAIL asn1_parse KAT2: root tag expected 48, got " + str(tree2["tag"]))
    exit(1)
if tree2["constructed"] != 1
    print("FAIL asn1_parse KAT2: root constructed expected 1, got " + str(tree2["constructed"]))
    exit(1)
let kids2 = tree2["children"]
if len(kids2) != 2
    print("FAIL asn1_parse KAT2: expected 2 children, got " + str(len(kids2)))
    exit(1)
let child0 = kids2[0]
let child1 = kids2[1]
if child0["tag"] != 2
    print("FAIL asn1_parse KAT2: child0 tag expected 2, got " + str(child0["tag"]))
    exit(1)
if child0["constructed"] != 0
    print("FAIL asn1_parse KAT2: child0 must be primitive, got " + str(child0["constructed"]))
    exit(1)
let v0 = child0["value"]
if bytes_len(v0) != 1
    print("FAIL asn1_parse KAT2: child0 value length expected 1, got " + str(bytes_len(v0)))
    exit(1)
if bytes_get(v0, 0) != 1
    print("FAIL asn1_parse KAT2: child0 value byte expected 1, got " + str(bytes_get(v0, 0)))
    exit(1)
if child1["tag"] != 2
    print("FAIL asn1_parse KAT2: child1 tag expected 2, got " + str(child1["tag"]))
    exit(1)
let v1 = child1["value"]
if bytes_len(v1) != 1
    print("FAIL asn1_parse KAT2: child1 value length expected 1, got " + str(bytes_len(v1)))
    exit(1)
if bytes_get(v1, 0) != 2
    print("FAIL asn1_parse KAT2: child1 value byte expected 2, got " + str(bytes_get(v1, 0)))
    exit(1)
print("PASS KAT2: asn1_parse SEQUENCE INT 1 INT 2")

// ── KAT3: asn1_parse NULL [0x05, 0x00] = [5, 0] ─────────────────────────────
let null_raw = make_bytes([5, 0])
let tree3 = asn1_parse(null_raw)
if tree3["tag"] != 5
    print("FAIL asn1_parse KAT3: NULL tag expected 5, got " + str(tree3["tag"]))
    exit(1)
if tree3["constructed"] != 0
    print("FAIL asn1_parse KAT3: NULL must be primitive, got " + str(tree3["constructed"]))
    exit(1)
let v3 = tree3["value"]
if bytes_len(v3) != 0
    print("FAIL asn1_parse KAT3: NULL value should be empty, got len=" + str(bytes_len(v3)))
    exit(1)
print("PASS KAT3: asn1_parse NULL -> empty value")

// ── KAT4: asn1_parse truncated (only tag byte, no length) ────────────────────
let trunc_raw = make_bytes([2])
let tree4 = asn1_parse(trunc_raw)
if tree4["error"] != 1
    print("FAIL asn1_parse KAT4: truncated input should produce error node, error=" + str(tree4["error"]))
    exit(1)
print("PASS KAT4: asn1_parse truncated -> error node")

// ── KAT5: asn1_read_tlv on empty bytes -> next_pos=-1 ────────────────────────
let empty_b = bytes(0)
let tlv5 = asn1_read_tlv(empty_b, 0)
if tlv5[1] != -1
    print("FAIL asn1_parse KAT5: empty bytes should give next_pos=-1, got " + str(tlv5[1]))
    exit(1)
print("PASS KAT5: asn1_read_tlv empty bytes -> -1")

// ── KAT6: asn1_read_tlv at out-of-bounds pos -> next_pos=-1 ──────────────────
let oob_b = make_bytes([2, 1, 66])
let tlv6 = asn1_read_tlv(oob_b, 100)
if tlv6[1] != -1
    print("FAIL asn1_parse KAT6: out-of-bounds pos should give next_pos=-1, got " + str(tlv6[1]))
    exit(1)
print("PASS KAT6: asn1_read_tlv out-of-bounds -> -1")

// ── KAT7: asn1_parse primitive INTEGER with value 127 (0x7F) ─────────────────
// DER: 02 01 7F  = [2, 1, 127]
let int_raw = make_bytes([2, 1, 127])
let tree7 = asn1_parse(int_raw)
if tree7["tag"] != 2
    print("FAIL asn1_parse KAT7: INTEGER tag expected 2, got " + str(tree7["tag"]))
    exit(1)
if tree7["constructed"] != 0
    print("FAIL asn1_parse KAT7: INTEGER must be primitive")
    exit(1)
let v7 = tree7["value"]
if bytes_len(v7) != 1
    print("FAIL asn1_parse KAT7: INTEGER value length expected 1, got " + str(bytes_len(v7)))
    exit(1)
if bytes_get(v7, 0) != 127
    print("FAIL asn1_parse KAT7: INTEGER value expected 127, got " + str(bytes_get(v7, 0)))
    exit(1)
print("PASS KAT7: asn1_parse INTEGER [127]")

// ── KAT8: asn1_hexdump ────────────────────────────────────────────────────────
// [48, 6, 2, 1, 1] -> "30 06 02 01 01"
let hd_b = make_bytes([48, 6, 2, 1, 1])
let hd8 = asn1_hexdump(hd_b)
if hd8 != "30 06 02 01 01"
    print("FAIL asn1_parse KAT8: hexdump expected '30 06 02 01 01', got '" + hd8 + "'")
    exit(1)
// Empty hexdump
let hd_empty = asn1_hexdump(bytes(0))
if hd_empty != ""
    print("FAIL asn1_parse KAT8: empty hexdump expected '', got '" + hd_empty + "'")
    exit(1)
// Single byte 255 (0xFF)
let hd_ff = make_bytes([255])
let hd8b = asn1_hexdump(hd_ff)
if hd8b != "ff"
    print("FAIL asn1_parse KAT8: hexdump [255] expected 'ff', got '" + hd8b + "'")
    exit(1)
print("PASS KAT8: asn1_hexdump")

// ── KAT9: round-trip parse SEQUENCE{INT 1, INT 2} ────────────────────────────
// Same as seq_raw: 48 6 2 1 1 2 1 2
let rt9 = make_bytes([48, 6, 2, 1, 1, 2, 1, 2])
let tree9 = asn1_parse(rt9)
if tree9["tag"] != 48
    print("FAIL asn1_parse KAT9: round-trip tag expected 48, got " + str(tree9["tag"]))
    exit(1)
if tree9["constructed"] != 1
    print("FAIL asn1_parse KAT9: round-trip constructed expected 1")
    exit(1)
let kids9 = tree9["children"]
if len(kids9) != 2
    print("FAIL asn1_parse KAT9: round-trip expected 2 children, got " + str(len(kids9)))
    exit(1)
let k9c0 = kids9[0]
let k9c1 = kids9[1]
let k9v0 = k9c0["value"]
let k9v1 = k9c1["value"]
if bytes_get(k9v0, 0) != 1
    print("FAIL asn1_parse KAT9: round-trip child0 value expected 1, got " + str(bytes_get(k9v0, 0)))
    exit(1)
if bytes_get(k9v1, 0) != 2
    print("FAIL asn1_parse KAT9: round-trip child1 value expected 2, got " + str(bytes_get(k9v1, 0)))
    exit(1)
print("PASS KAT9: encode->parse round-trip SEQUENCE INT 1 INT 2")

// ── KAT10: nested SEQUENCE -> SEQUENCE -> {INT 1, INT 2} ─────────────────────
// Outer SEQUENCE: 48 8  (0x30 0x08)
//   Inner SEQUENCE: 48 6  (0x30 0x06)
//     INT 1: 2 1 1
//     INT 2: 2 1 2
// Total: 48 8 48 6 2 1 1 2 1 2  (10 bytes)
let nested = make_bytes([48, 8, 48, 6, 2, 1, 1, 2, 1, 2])
let tree10 = asn1_parse(nested)
if tree10["tag"] != 48
    print("FAIL asn1_parse KAT10: outer tag expected 48, got " + str(tree10["tag"]))
    exit(1)
if tree10["constructed"] != 1
    print("FAIL asn1_parse KAT10: outer must be constructed")
    exit(1)
let kids10 = tree10["children"]
if len(kids10) != 1
    print("FAIL asn1_parse KAT10: outer expected 1 child, got " + str(len(kids10)))
    exit(1)
let inner10 = kids10[0]
if inner10["tag"] != 48
    print("FAIL asn1_parse KAT10: inner tag expected 48, got " + str(inner10["tag"]))
    exit(1)
if inner10["constructed"] != 1
    print("FAIL asn1_parse KAT10: inner must be constructed")
    exit(1)
let ikids10 = inner10["children"]
if len(ikids10) != 2
    print("FAIL asn1_parse KAT10: inner expected 2 children, got " + str(len(ikids10)))
    exit(1)
let leaf10_0 = ikids10[0]
let leaf10_1 = ikids10[1]
if leaf10_0["tag"] != 2
    print("FAIL asn1_parse KAT10: leaf0 tag expected 2, got " + str(leaf10_0["tag"]))
    exit(1)
if leaf10_1["tag"] != 2
    print("FAIL asn1_parse KAT10: leaf1 tag expected 2, got " + str(leaf10_1["tag"]))
    exit(1)
let lv10_0 = leaf10_0["value"]
let lv10_1 = leaf10_1["value"]
if bytes_get(lv10_0, 0) != 1
    print("FAIL asn1_parse KAT10: leaf0 value expected 1, got " + str(bytes_get(lv10_0, 0)))
    exit(1)
if bytes_get(lv10_1, 0) != 2
    print("FAIL asn1_parse KAT10: leaf1 value expected 2, got " + str(bytes_get(lv10_1, 0)))
    exit(1)
print("PASS KAT10: nested SEQUENCE -> SEQUENCE -> INT 1 INT 2")

// ── KAT11: asn1_read_tlv on INTEGER at offset within a stream ────────────────
// Stream: 48 6 2 1 1 2 1 2
// Read TLV at pos=2 -> tag=2, length=1, content_start=4, next_pos=5
let tlv11 = asn1_read_tlv(seq_raw, 2)
let tlv11_info = tlv11[0]
let tlv11_next = tlv11[1]
if tlv11_next != 5
    print("FAIL asn1_parse KAT11: next_pos expected 5, got " + str(tlv11_next))
    exit(1)
if tlv11_info["tag"] != 2
    print("FAIL asn1_parse KAT11: tag expected 2, got " + str(tlv11_info["tag"]))
    exit(1)
if tlv11_info["length"] != 1
    print("FAIL asn1_parse KAT11: length expected 1, got " + str(tlv11_info["length"]))
    exit(1)
if tlv11_info["content_start"] != 4
    print("FAIL asn1_parse KAT11: content_start expected 4, got " + str(tlv11_info["content_start"]))
    exit(1)
print("PASS KAT11: asn1_read_tlv at embedded offset")

// ── KAT12: long-form length — OCTET STRING with 200 content bytes ─────────────
// Tag: 4, Length: 129 200 (0x81 0xC8 = 200), then 200 bytes
// Total: 1 + 2 + 200 = 203 bytes
let long_b = bytes(203)
bytes_set(long_b, 0, 4)
bytes_set(long_b, 1, 129)
bytes_set(long_b, 2, 200)
bytes_set(long_b, 103, 66)
let tlv12 = asn1_read_tlv(long_b, 0)
let tlv12_info = tlv12[0]
let tlv12_next = tlv12[1]
if tlv12_next != 203
    print("FAIL asn1_parse KAT12: next_pos expected 203, got " + str(tlv12_next))
    exit(1)
if tlv12_info["tag"] != 4
    print("FAIL asn1_parse KAT12: tag expected 4, got " + str(tlv12_info["tag"]))
    exit(1)
if tlv12_info["length"] != 200
    print("FAIL asn1_parse KAT12: length expected 200, got " + str(tlv12_info["length"]))
    exit(1)
if tlv12_info["content_start"] != 3
    print("FAIL asn1_parse KAT12: content_start expected 3, got " + str(tlv12_info["content_start"]))
    exit(1)
let tree12 = asn1_parse(long_b)
if tree12["tag"] != 4
    print("FAIL asn1_parse KAT12: parse tag expected 4, got " + str(tree12["tag"]))
    exit(1)
let v12 = tree12["value"]
if bytes_len(v12) != 200
    print("FAIL asn1_parse KAT12: parse value length expected 200, got " + str(bytes_len(v12)))
    exit(1)
if bytes_get(v12, 100) != 66
    print("FAIL asn1_parse KAT12: marker byte expected 66, got " + str(bytes_get(v12, 100)))
    exit(1)
print("PASS KAT12: long-form length 200-byte OCTET STRING")

// ── KAT13: BOOLEAN true [1, 1, 255]  (tag=1, len=1, value=0xFF=255) ──────────
let bool_raw = make_bytes([1, 1, 255])
let tree13 = asn1_parse(bool_raw)
if tree13["tag"] != 1
    print("FAIL asn1_parse KAT13: BOOLEAN tag expected 1, got " + str(tree13["tag"]))
    exit(1)
let v13 = tree13["value"]
if bytes_len(v13) != 1
    print("FAIL asn1_parse KAT13: BOOLEAN value length expected 1, got " + str(bytes_len(v13)))
    exit(1)
if bytes_get(v13, 0) != 255
    print("FAIL asn1_parse KAT13: BOOLEAN true expected 255, got " + str(bytes_get(v13, 0)))
    exit(1)
print("PASS KAT13: BOOLEAN true -> value [255]")

// ── KAT14: truncated length field ─────────────────────────────────────────────
// Tag 2 (INTEGER), then 129 (0x81) but no second byte -> malformed
let trunc_len = make_bytes([2, 129])
let tlv14 = asn1_read_tlv(trunc_len, 0)
if tlv14[1] != -1
    print("FAIL asn1_parse KAT14: truncated length should give -1, got " + str(tlv14[1]))
    exit(1)
let tree14 = asn1_parse(trunc_len)
if tree14["error"] != 1
    print("FAIL asn1_parse KAT14: truncated length should give error node")
    exit(1)
print("PASS KAT14: truncated length field -> error")

// ── KAT15: OCTET STRING [4, 3, 1, 2, 3] ─────────────────────────────────────
let os_raw = make_bytes([4, 3, 1, 2, 3])
let tree15 = asn1_parse(os_raw)
if tree15["tag"] != 4
    print("FAIL asn1_parse KAT15: OCTET STRING tag expected 4, got " + str(tree15["tag"]))
    exit(1)
let v15 = tree15["value"]
if bytes_len(v15) != 3
    print("FAIL asn1_parse KAT15: OCTET STRING value length expected 3, got " + str(bytes_len(v15)))
    exit(1)
if bytes_get(v15, 0) != 1
    print("FAIL asn1_parse KAT15: byte[0] expected 1, got " + str(bytes_get(v15, 0)))
    exit(1)
if bytes_get(v15, 1) != 2
    print("FAIL asn1_parse KAT15: byte[1] expected 2, got " + str(bytes_get(v15, 1)))
    exit(1)
if bytes_get(v15, 2) != 3
    print("FAIL asn1_parse KAT15: byte[2] expected 3, got " + str(bytes_get(v15, 2)))
    exit(1)
print("PASS KAT15: OCTET STRING [1, 2, 3] -> value bytes")

print("PASS _asn1_parse_test")
