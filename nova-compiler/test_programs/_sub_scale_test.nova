// KAT for std/data/sub_scale
// Tests sub_scale, sub_fps_convert, sub_stretch
import std/data/sub_scale

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got [" + got + "] expected [" + expected + "]")
        exit(1)

fn _make_cue(idx, start_ms, end_ms, txt)
    let c = {}
    c["index"] = idx
    c["start"] = start_ms
    c["end"] = end_ms
    c["text"] = txt
    return c

fn main()
    // Single cue: start=1000, end=2000
    let c0 = _make_cue(1, 1000, 2000, "Test")
    let cues = []
    push(cues, c0)

    // ── sub_scale ────────────────────────────────────────────────────────────
    // KAT 1: sub_scale(cues, 2, 1) -> start=2000, end=4000
    let scaled2 = sub_scale(cues, 2, 1)
    cki("scale_2_1_start", scaled2[0]["start"], 2000)
    cki("scale_2_1_end", scaled2[0]["end"], 4000)

    // KAT 2: sub_scale(cues, 1, 2) -> start=500, end=1000
    let scaled_half = sub_scale(cues, 1, 2)
    cki("scale_1_2_start", scaled_half[0]["start"], 500)
    cki("scale_1_2_end", scaled_half[0]["end"], 1000)

    // KAT 3: sub_scale(cues, 1, 1) -> identity
    let scaled_id = sub_scale(cues, 1, 1)
    cki("scale_identity_start", scaled_id[0]["start"], 1000)
    cki("scale_identity_end", scaled_id[0]["end"], 2000)

    // KAT 4: sub_scale(cues, 3, 2) -> start=1500, end=3000
    let scaled_3_2 = sub_scale(cues, 3, 2)
    cki("scale_3_2_start", scaled_3_2[0]["start"], 1500)
    cki("scale_3_2_end", scaled_3_2[0]["end"], 3000)

    // KAT 5: input unchanged after scale
    cki("scale_input_unchanged_start", cues[0]["start"], 1000)
    cki("scale_input_unchanged_end", cues[0]["end"], 2000)

    // KAT 6: text field preserved
    cks("scale_text_preserved", scaled2[0]["text"], "Test")

    // KAT 7: index field preserved
    cki("scale_index_preserved", scaled2[0]["index"], 1)

    // KAT 8: multiple cues scaled correctly
    let mc0 = _make_cue(1, 0, 1000, "A")
    let mc1 = _make_cue(2, 2000, 3000, "B")
    let mcues = []
    push(mcues, mc0)
    push(mcues, mc1)
    let mscaled = sub_scale(mcues, 2, 1)
    cki("multi_scale_0_start", mscaled[0]["start"], 0)
    cki("multi_scale_0_end", mscaled[0]["end"], 2000)
    cki("multi_scale_1_start", mscaled[1]["start"], 4000)
    cki("multi_scale_1_end", mscaled[1]["end"], 6000)

    // ── sub_fps_convert ──────────────────────────────────────────────────────
    // KAT 9: 24fps -> 25fps: start=1000 -> 1000*24/25 = 960
    let fps_cue = _make_cue(1, 1000, 2000, "fps")
    let fps_cues = []
    push(fps_cues, fps_cue)
    let converted = sub_fps_convert(fps_cues, 24, 25)
    cki("fps_24_25_start", converted[0]["start"], 960)

    // KAT 10: 24fps -> 25fps: end=2000 -> 2000*24/25 = 1920
    cki("fps_24_25_end", converted[0]["end"], 1920)

    // KAT 11: input unchanged after fps convert
    cki("fps_input_unchanged", fps_cues[0]["start"], 1000)

    // KAT 12: 25fps -> 24fps: start=960 -> 960*25/24 = 1000
    let fps_back_cue = _make_cue(1, 960, 1920, "back")
    let fps_back_cues = []
    push(fps_back_cues, fps_back_cue)
    let back = sub_fps_convert(fps_back_cues, 25, 24)
    cki("fps_25_24_start", back[0]["start"], 1000)
    cki("fps_25_24_end", back[0]["end"], 2000)

    // KAT 13: same fps -> identity
    let same_fps = sub_fps_convert(fps_cues, 24, 24)
    cki("fps_same_identity", same_fps[0]["start"], 1000)

    // ── sub_stretch ──────────────────────────────────────────────────────────
    // KAT 14: anchor=0, num=2, den=1: start=1000 -> 0 + 1000*2/1 = 2000
    let st_cue = _make_cue(1, 1000, 2000, "stretch")
    let st_cues = []
    push(st_cues, st_cue)
    let stretched = sub_stretch(st_cues, 0, 2, 1)
    cki("stretch_anchor0_2x_start", stretched[0]["start"], 2000)
    cki("stretch_anchor0_2x_end", stretched[0]["end"], 4000)

    // KAT 15: anchor=0, num=1, den=2: start=1000 -> 500, end=2000 -> 1000
    let compressed = sub_stretch(st_cues, 0, 1, 2)
    cki("stretch_anchor0_half_start", compressed[0]["start"], 500)
    cki("stretch_anchor0_half_end", compressed[0]["end"], 1000)

    // KAT 16: cue exactly at anchor stays fixed
    let anchor_cue = _make_cue(1, 5000, 6000, "anchor")
    let anchor_cues = []
    push(anchor_cues, anchor_cue)
    let stretched_anchor = sub_stretch(anchor_cues, 5000, 3, 1)
    cki("stretch_at_anchor_start", stretched_anchor[0]["start"], 5000)

    // KAT 17: anchor=2000, num=2, den=1: start=3000 -> 2000+(3000-2000)*2/1=4000
    let off_cue = _make_cue(1, 3000, 4000, "off")
    let off_cues = []
    push(off_cues, off_cue)
    let off_stretched = sub_stretch(off_cues, 2000, 2, 1)
    cki("stretch_anchor2000_start", off_stretched[0]["start"], 4000)
    cki("stretch_anchor2000_end", off_stretched[0]["end"], 6000)

    // KAT 18: input unchanged after stretch
    cki("stretch_input_unchanged", st_cues[0]["start"], 1000)

    // KAT 19: empty cues list scales to empty
    let empty = []
    let empty_scaled = sub_scale(empty, 2, 1)
    cki("scale_empty_len", len(empty_scaled), 0)

    // KAT 20: empty cues list stretches to empty
    let empty_stretched = sub_stretch(empty, 0, 2, 1)
    cki("stretch_empty_len", len(empty_stretched), 0)

    print("PASS _sub_scale_test")

main()
