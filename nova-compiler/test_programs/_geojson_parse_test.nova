// KAT test for std/data/geojson_parse
import std/data/geojson_parse

// ── Helpers ───────────────────────────────────────────────────────────────────

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + got + " expected=" + expected)
        exit(1)

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

fn approx(a, b, tol) -> int
    let diff = a - b
    let adiff = diff
    if diff < 0.0
        adiff = 0.0 - diff
    let ok = 1
    if adiff > tol
        ok = 0
    ok

fn ckf(label, got, expected, tol)
    let ok = approx(got, expected, tol)
    if ok == 0
        print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

// chr(34)='"'  chr(123)='{'  chr(125)='}'
// Build helpers to keep expressions short

fn wrap(inner)
    chr(123) + inner + chr(125)

fn kv_str(k, v)
    let q = chr(34)
    q + k + q + ":" + q + v + q

fn kv_raw(k, v)
    let q = chr(34)
    q + k + q + ":" + v

// ── Test 1: Point ─────────────────────────────────────────────────────────────

let body1 = kv_str("type", "Point") + "," + kv_raw("coordinates", "[1.0,2.0]")
let pt_json = wrap(body1)
let pt = geojson_parse(pt_json)
cks("point_type", pt["type"], "Point")
let pt_coords = pt["coordinates"]
cki("point_coords_len", len(pt_coords), 2)
let pt_lon = pt_coords[0]
let pt_lat = pt_coords[1]
ckf("point_lon", pt_lon, 1.0, 0.0001)
ckf("point_lat", pt_lat, 2.0, 0.0001)

// ── Test 2: LineString ────────────────────────────────────────────────────────

let body2 = kv_str("type", "LineString") + "," + kv_raw("coordinates", "[[0.0,0.0],[1.0,1.0]]")
let ls_json = wrap(body2)
let ls = geojson_parse(ls_json)
cks("ls_type", ls["type"], "LineString")
let ls_coords = ls["coordinates"]
cki("ls_coords_len", len(ls_coords), 2)
let ls_p0 = ls_coords[0]
let ls_p1 = ls_coords[1]
cki("ls_p0_len", len(ls_p0), 2)
cki("ls_p1_len", len(ls_p1), 2)
let ls_p0_lon = ls_p0[0]
let ls_p0_lat = ls_p0[1]
ckf("ls_p0_lon", ls_p0_lon, 0.0, 0.0001)
ckf("ls_p0_lat", ls_p0_lat, 0.0, 0.0001)
let ls_p1_lon = ls_p1[0]
let ls_p1_lat = ls_p1[1]
ckf("ls_p1_lon", ls_p1_lon, 1.0, 0.0001)
ckf("ls_p1_lat", ls_p1_lat, 1.0, 0.0001)

// ── Test 3: Polygon ───────────────────────────────────────────────────────────

let ring3 = "[[[0.0,0.0],[1.0,0.0],[1.0,1.0],[0.0,0.0]]]"
let body3 = kv_str("type", "Polygon") + "," + kv_raw("coordinates", ring3)
let poly_json = wrap(body3)
let poly = geojson_parse(poly_json)
cks("poly_type", poly["type"], "Polygon")
let poly_coords = poly["coordinates"]
cki("poly_rings", len(poly_coords), 1)
let ring0 = poly_coords[0]
cki("poly_ring0_len", len(ring0), 4)
let ring0_p0 = ring0[0]
let r0p0_lon = ring0_p0[0]
let r0p0_lat = ring0_p0[1]
ckf("poly_ring0_p0_lon", r0p0_lon, 0.0, 0.0001)
ckf("poly_ring0_p0_lat", r0p0_lat, 0.0, 0.0001)

// ── Test 4: negative and decimal coordinates ──────────────────────────────────

let body4 = kv_str("type", "Point") + "," + kv_raw("coordinates", "[-122.4194,37.7749]")
let neg_json = wrap(body4)
let neg_pt = geojson_parse(neg_json)
let neg_coords = neg_pt["coordinates"]
let neg_lon = neg_coords[0]
let neg_lat = neg_coords[1]
ckf("neg_lon", neg_lon, -122.4194, 0.001)
ckf("neg_lat", neg_lat, 37.7749, 0.001)

print("PASS _geojson_parse_test")
