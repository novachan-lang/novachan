// showcase_graph -- breadth-first shortest paths on a graph in pure NOVA. An EIGHTH angle: LISTS OF
// LISTS (adjacency as adj[i] = list of neighbor ids), a queue (list + head index), and integer node
// ids (avoids the 0.10 string-key aliasing). Exercises nested-container reads + BFS frontier logic.
// Self-verifying against hand-computed shortest-hop distances.

fn bfs(adj: list, start: int, n: int) -> list
    let dist = []
    let i = 0
    while i < n
        push(dist, -1)
        i = i + 1
    dist[start] = 0
    let queue = [start]
    let head = 0
    while head < len(queue)
        let u = queue[head]
        head = head + 1
        let nbrs = adj[u]
        let j = 0
        while j < len(nbrs)
            let v = nbrs[j]
            if dist[v] == -1
                dist[v] = dist[u] + 1
                push(queue, v)
            j = j + 1
    return dist

// add an undirected edge a<->b into adjacency (adj[a],adj[b] are lists).
fn add_edge(adj: list, a: int, b: int)
    push(adj[a], b)
    push(adj[b], a)

fn main()
    let n = 6
    // adjacency: n empty lists
    let adj = []
    let i = 0
    while i < n
        push(adj, [])
        i = i + 1
    // edges: 0-1, 0-2, 1-3, 2-3, 3-4 ; node 5 isolated
    add_edge(adj, 0, 1)
    add_edge(adj, 0, 2)
    add_edge(adj, 1, 3)
    add_edge(adj, 2, 3)
    add_edge(adj, 3, 4)

    let dist = bfs(adj, 0, n)
    let line = "dist from 0: "
    let k = 0
    while k < n
        line = line + str(dist[k])
        if k < n - 1
            line = line + " "
        k = k + 1
    print(line)

    // hand-computed shortest hops from node 0
    assert(dist[0] == 0, "dist to self is 0")
    assert(dist[1] == 1, "0->1 = 1")
    assert(dist[2] == 1, "0->2 = 1")
    assert(dist[3] == 2, "0->3 = 2 (via 1 or 2)")
    assert(dist[4] == 3, "0->4 = 3")
    assert(dist[5] == -1, "node 5 unreachable")

    // BFS from the isolated node reaches only itself
    let d5 = bfs(adj, 5, n)
    let reach = 0
    let m = 0
    while m < n
        if d5[m] >= 0
            reach = reach + 1
        m = m + 1
    assert(reach == 1, "isolated node reaches only itself")

    print("showcase_graph_test passed -- BFS shortest paths over lists-of-lists, pure NOVA")
