fn main()
  print("step 1")
  let server = tcp_listen(19878)
  print("step 2: server=" + str(server))
  io_set_nonblocking(server)
  print("step 3: nonblocking set")
  let p = io_poll_create()
  print("step 4: poll=" + str(p))
  io_poll_add(p, server, 1)
  print("step 5: added to poll")
  print("step 6: about to poll_wait with 500ms timeout")
  let events = io_poll_wait(p, 500)
  print("step 7: events=" + str(len(events)))
  io_poll_close(p)
  tcp_close(server)
  print("step 8: done")
