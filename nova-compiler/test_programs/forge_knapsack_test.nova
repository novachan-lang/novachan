import forge_knapsack

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // coin_change_min
    fails = fails + expect("min_11", str(coin_change_min([1, 2, 5], 11)), "3")
    fails = fails + expect("min_30", str(coin_change_min([1, 5, 10, 25], 30)), "2")
    fails = fails + expect("min_impossible", str(coin_change_min([2], 3)), "-1")
    fails = fails + expect("min_0", str(coin_change_min([1, 2, 5], 0)), "0")
    fails = fails + expect("min_exact", str(coin_change_min([3, 7], 12)), "4")

    // coin_change_ways
    fails = fails + expect("ways_5", str(coin_change_ways([1, 2, 5], 5)), "4")
    fails = fails + expect("ways_0", str(coin_change_ways([1, 2, 5], 0)), "1")
    fails = fails + expect("ways_impossible", str(coin_change_ways([2], 3)), "0")
    // classic: coins [2,3,5,6] amount 10 -> 5 ways
    fails = fails + expect("ways_10", str(coin_change_ways([2, 3, 5, 6], 10)), "5")

    // 0/1 knapsack: weights [1,3,4,5], values [1,4,5,7], capacity 7 -> 9 (items weight 3+4, value 4+5)
    fails = fails + expect("knap_9", str(knapsack_01([1, 3, 4, 5], [1, 4, 5, 7], 7)), "9")
    // capacity 0 -> 0
    fails = fails + expect("knap_0cap", str(knapsack_01([1, 2], [10, 20], 0)), "0")
    // single item fits
    fails = fails + expect("knap_single", str(knapsack_01([3], [50], 5)), "50")
    // single item too heavy
    fails = fails + expect("knap_toobig", str(knapsack_01([10], [50], 5)), "0")
    // classic: weights [2,3,4,5], values [3,4,5,6], capacity 5 -> 7 (items 2+3 = value 3+4)
    fails = fails + expect("knap_7", str(knapsack_01([2, 3, 4, 5], [3, 4, 5, 6], 5)), "7")

    // unbounded knapsack: weights [1,3,4], values [15,50,60], capacity 8 -> 130 (four 1s? no)
    // best: two 4s = 120, or 4+3+1 = 60+50+15=125, or 3+3+1+1=50+50+15+15=130
    fails = fails + expect("unbounded_130", str(knapsack_unbounded([1, 3, 4], [15, 50, 60], 8)), "130")
    // unbounded coin-like: weights [2], values [3], capacity 7 -> 3 copies of weight2 = 9
    fails = fails + expect("unbounded_reuse", str(knapsack_unbounded([2], [3], 7)), "9")

    if fails == 0
        print("forge_knapsack: all passed")
    else
        print("forge_knapsack: " + str(fails) + " FAILED")
