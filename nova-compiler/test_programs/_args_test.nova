// KAT for std/cli/args — minimal argparse-style parser
import std/cli/args

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// Serialize a string-list to "a,b,c" for easy comparison
fn _sjoin(xs) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + ","
        out = out + xs[i]
        i = i + 1
    return out

fn main()
    // ── KAT 1: spec example ──────────────────────────────────────────────────
    // ["--verbose","--name=bob","pos1","--out","f.txt","pos2"]
    // flags=["verbose"] opts=["name","out"]
    // expect: verbose="1", name="bob", out="f.txt", _pos=["pos1","pos2"]
    let argv1 = ["--verbose", "--name=bob", "pos1", "--out", "f.txt", "pos2"]
    let flags1 = ["verbose"]
    let opts1 = ["name", "out"]
    let r1 = ap_parse(argv1, flags1, opts1)
    cks("spec_verbose", r1["verbose"], "1")
    cks("spec_name", r1["name"], "bob")
    cks("spec_out", r1["out"], "f.txt")
    cki("spec_pos_len", len(r1["_pos"]), 2)
    cks("spec_pos0", r1["_pos"][0], "pos1")
    cks("spec_pos1", r1["_pos"][1], "pos2")

    // ── KAT 2: "--" stops option parsing ────────────────────────────────────
    // ["--verbose","--","--name=bob","pos1"]
    // Everything after "--" is positional, even if it looks like an option
    let argv2 = ["--verbose", "--", "--name=bob", "pos1"]
    let r2 = ap_parse(argv2, ["verbose"], ["name"])
    cks("dashdash_verbose", r2["verbose"], "1")
    cki("dashdash_pos_len", len(r2["_pos"]), 2)
    cks("dashdash_pos0", r2["_pos"][0], "--name=bob")
    cks("dashdash_pos1", r2["_pos"][1], "pos1")

    // ── KAT 3: all positionals, no options registered ────────────────────────
    let r3 = ap_parse(["a", "b", "c"], [], [])
    cki("allpos_len", len(r3["_pos"]), 3)
    cks("allpos_join", _sjoin(r3["_pos"]), "a,b,c")

    // ── KAT 4: unknown long opt → positional (lenient) ───────────────────────
    let r4 = ap_parse(["--unknown", "val"], [], [])
    cki("unknown_pos_len", len(r4["_pos"]), 2)
    cks("unknown_pos0", r4["_pos"][0], "--unknown")
    cks("unknown_pos1", r4["_pos"][1], "val")

    // ── KAT 5: opt at end of argv (no value) → empty string ─────────────────
    let r5 = ap_parse(["--out"], [], ["out"])
    cks("opt_eof_val", r5["out"], "")
    cki("opt_eof_pos", len(r5["_pos"]), 0)

    // ── KAT 6: empty argv ────────────────────────────────────────────────────
    let r6 = ap_parse([], ["verbose"], ["name"])
    cki("empty_pos", len(r6["_pos"]), 0)
    cki("empty_no_verbose", contains(r6, "verbose"), 0)

    // ── KAT 7: --opt val followed by -- and extra positional ─────────────────
    // ["--name","alice","--","extra"]  opts=["name"]
    // expect: name="alice", _pos=["extra"]
    let r7 = ap_parse(["--name", "alice", "--", "extra"], [], ["name"])
    cks("opt_then_dash_name", r7["name"], "alice")
    cki("opt_then_dash_pos_len", len(r7["_pos"]), 1)
    cks("opt_then_dash_pos0", r7["_pos"][0], "extra")

    // ── KAT 8: mixed flags, opts, and bare positionals interleaved ────────────
    // ["file.txt","--debug","--jobs","4","output.txt"]
    // flags=["debug","verbose"] opts=["jobs","out"]
    // expect: debug="1", jobs="4", _pos=["file.txt","output.txt"]
    let argv8 = ["file.txt", "--debug", "--jobs", "4", "output.txt"]
    let r8 = ap_parse(argv8, ["debug", "verbose"], ["jobs", "out"])
    cks("mixed_debug", r8["debug"], "1")
    cks("mixed_jobs", r8["jobs"], "4")
    cki("mixed_no_verbose", contains(r8, "verbose"), 0)
    cki("mixed_pos_len", len(r8["_pos"]), 2)
    cks("mixed_pos0", r8["_pos"][0], "file.txt")
    cks("mixed_pos1", r8["_pos"][1], "output.txt")

    print("_args_test passed")
