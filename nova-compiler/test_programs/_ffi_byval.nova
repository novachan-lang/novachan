@repr("C")
type Vec2
    x: float
    y: float

@repr("C")
type Pair
    a: int
    b: int

extern fn vec2_sum(v: Vec2) -> float
extern fn pair_diff(p: Pair) -> int

fn main()
    let v = Vec2(1.5, 2.25)
    let s = unsafe vec2_sum(v)
    print("vec2_sum(1.5, 2.25) = " + str(s) + "  (expect 3.75)")
    let p = Pair(10, 3)
    let d = unsafe pair_diff(p)
    print("pair_diff(10, 3) = " + str(d) + "  (expect 7)")
