// Move-elision: when the value sent on a channel is never used after
// the send, the compiler emits send_move (no deep copy).

// 1. Simple move: data created locally, sent, never reused.
ch1 = channel()
spawn fn()
    data = [10, 20, 30]
    send(ch1, data)

r1 = receive(ch1)
print(len(r1))
print(r1[0])
print(r1[2])

// 2. Non-move: data reused after send (deep copy required).
ch2 = channel()
data2 = [100, 200]
send(ch2, data2)
push(data2, 300)
r2 = receive(ch2)
print(len(data2))
print(len(r2))

// 3. Move with struct: single-use struct sent.
type Pt
    x: int
    y: int

ch3 = channel()
spawn fn()
    p = Pt(7, 42)
    send(ch3, p)

r3 = receive(ch3)
print(r3.x)
print(r3.y)

// 4. Non-move: variable used in two sends.
ch4 = channel()
ch5 = channel()
val = [1, 2]
send(ch4, val)
send(ch5, val)
r4 = receive(ch4)
r5 = receive(ch5)
print(len(r4))
print(len(r5))

// Expected output:
// 3
// 10
// 30
// 3
// 2
// 7
// 42
// 2
// 2
