// Heap-OOM probe: double a string 25x (-> 2^25 = 32MB), far past the wasm bump heap (8MB NOVA_FS_HEAP_SIZE).
// In wasm the allocator returns NULL on exhaustion; the value-model's nova_str_safe guard should turn a NULL
// handle into "" (len 0), so this must return GRACEFULLY (a bounded int), never corrupt/hang.
fn bigalloc() -> int
    let s = "x"
    let i = 0
    while i < 25
        s = s + s
        i = i + 1
    len(s)
fn main()
    print(bigalloc())
