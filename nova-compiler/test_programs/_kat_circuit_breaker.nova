import forge_circuit_breaker

fn main()
    let cb = cb_new("api", 3, 60)
    assert(cb_state(cb) == "closed", "starts closed")
    assert(cb_allow(cb, 0) == true, "allows in closed")

    cb = cb_record_success(cb)
    cb = cb_record_success(cb)
    assert(cb_state(cb) == "closed", "still closed")

    cb = cb_record_failure(cb, 10)
    cb = cb_record_failure(cb, 11)
    assert(cb_state(cb) == "closed", "closed at 2 failures")

    cb = cb_record_failure(cb, 12)
    assert(cb_state(cb) == "open", "open at 3 failures")
    assert(cb_allow(cb, 20) == false, "rejects in open")

    assert(cb_allow(cb, 72) == true, "allows after timeout")

    cb = cb_try_half_open(cb, 72)
    assert(cb_state(cb) == "half-open", "half-open after timeout")

    cb = cb_record_success(cb)
    assert(cb_state(cb) == "closed", "closed after success in half-open")

    let stats = cb_stats(cb)
    assert(stats["name"] == "api", "stats name")
    assert(stats["total_calls"] == 6, "6 total calls")
    assert(stats["total_failures"] == 3, "3 total failures")
    assert(stats["failure_rate"] == 50, "50% failure rate")

    cb = cb_reset(cb)
    assert(cb_state(cb) == "closed", "reset to closed")
    assert(cb["failure_count"] == 0, "reset failure count")

    print("CIRCUIT-BREAKER KAT PASS")
