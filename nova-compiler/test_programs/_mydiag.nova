import forge_orm
type MRow
    id: int
    name: string
    age: int
    active: bool
fn main()
    let db = unwrap(orm_open_with_pool("mysql://root:root@127.0.0.1:3306/nova_test", 2))
    _ = orm_exec(db, "DROP TABLE IF EXISTS mydiag", [])
    _ = orm_exec(db, "CREATE TABLE mydiag (id int, name text, age int, active int)", [])
    _ = orm_exec(db, "INSERT INTO mydiag (id,name,age,active) VALUES (?,?,?,?)", [1,"Ada",36,1])
    _ = orm_exec(db, "INSERT INTO mydiag (id,name,age,active) VALUES (?,?,?,?)", [2,"Linus",54,0])
    _ = orm_exec(db, "INSERT INTO mydiag (id,name,age,active) VALUES (?,?,?,?)", [3,"Grace",85,1])
    print("orm_count = {orm_count(db, "mydiag", "", [])}")
    let untyped = orm_all(db, "SELECT id,name,age,active FROM mydiag ORDER BY id", [])
    print("untyped rows = {len(untyped)}")
    for r in untyped
        print("  id={str(r["id"])}|type={type_name(r["id"])}  name={str(r["name"])}  active={str(r["active"])}|type={type_name(r["active"])}")
    let typed: list<MRow> = orm_all(db, "SELECT id,name,age,active FROM mydiag ORDER BY id", [])
    print("TYPED rows = {len(typed)}   <-- 3 expected")
    for t in typed
        print("  id={t.id} name={t.name} active={t.active}")
    _ = orm_exec(db, "DROP TABLE IF EXISTS mydiag", [])
    orm_close(db)
    print("DONE")
