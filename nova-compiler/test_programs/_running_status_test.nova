// KAT test for std/midi/running_status
// Known-answer vectors hand-verified against the MIDI 1.0 running-status spec.
import std/midi/running_status

// ── Helpers ───────────────────────────────────────────────────────────────────

// _rst_list_eq: compare two flat int lists; return 1 if equal, 0 otherwise.
fn _rst_list_eq(a, b) -> int
    let la = len(a)
    let lb = len(b)
    if la != lb
        return 0
    let i = 0
    while i < la
        if a[i] != b[i]
            return 0
        i = i + 1
    1

// _rst_lst_str: format a flat int list as "[a,b,c]".
fn _rst_lst_str(lst) -> str
    let s = "["
    let i = 0
    let n = len(lst)
    while i < n
        s = s + str(lst[i])
        if i < n - 1
            s = s + ","
        i = i + 1
    s = s + "]"
    s

// _rst_msgs_eq: compare two lists of messages (list of int-lists).
fn _rst_msgs_eq(a, b) -> int
    let la = len(a)
    let lb = len(b)
    if la != lb
        return 0
    let i = 0
    while i < la
        if _rst_list_eq(a[i], b[i]) == 0
            return 0
        i = i + 1
    1

// _rst_msgs_str: format a list of messages as "[[a,b],[c,d]]".
fn _rst_msgs_str(msgs) -> str
    let s = "["
    let i = 0
    let n = len(msgs)
    while i < n
        s = s + _rst_lst_str(msgs[i])
        if i < n - 1
            s = s + ","
        i = i + 1
    s = s + "]"
    s

// ckl: assert two flat int lists are equal; FAIL + exit(1) on mismatch.
fn ckl(label, got, want) -> int
    if _rst_list_eq(got, want) == 0
        print("FAIL running_status " + label + ": got=" + _rst_lst_str(got) + " want=" + _rst_lst_str(want))
        exit(1)
    0

// ckm: assert two message lists are equal; FAIL + exit(1) on mismatch.
fn ckm(label, got, want) -> int
    if _rst_msgs_eq(got, want) == 0
        print("FAIL running_status " + label + ": got=" + _rst_msgs_str(got) + " want=" + _rst_msgs_str(want))
        exit(1)
    0

// ── KAT 1: rs_encode with repeated status omits duplicate ────────────────────
// rs_encode([[0x90,60,100],[0x90,62,100]]) == [0x90,60,100,62,100]
// Second NoteOn (0x90) shares status with first → status byte omitted.
fn test_encode_repeated_status() -> int
    let m1 = [144, 60, 100]
    let m2 = [144, 62, 100]
    let msgs = []
    push(msgs, m1)
    push(msgs, m2)
    let got = rs_encode(msgs)
    let want = [144, 60, 100, 62, 100]
    ckl("encode_repeated_status", got, want)

// ── KAT 2: rs_decode restores implied status bytes ───────────────────────────
// rs_decode([0x90,60,100,62,100]) == [[0x90,60,100],[0x90,62,100]]
// The data-only pair (62,100) gets status 0x90 restored.
fn test_decode_implied_status() -> int
    let stream = [144, 60, 100, 62, 100]
    let got = rs_decode(stream)
    let want1 = [144, 60, 100]
    let want2 = [144, 62, 100]
    let want = []
    push(want, want1)
    push(want, want2)
    ckm("decode_implied_status", got, want)

// ── KAT 3: rs_encode keeps both status bytes when they differ ─────────────────
// rs_encode([[0x90,60,100],[0x80,60,0]]) == [0x90,60,100,0x80,60,0]
// NoteOn (0x90) followed by NoteOff (0x80): different statuses, both emitted.
fn test_encode_different_statuses() -> int
    let m1 = [144, 60, 100]
    let m2 = [128, 60, 0]
    let msgs = []
    push(msgs, m1)
    push(msgs, m2)
    let got = rs_encode(msgs)
    let want = [144, 60, 100, 128, 60, 0]
    ckl("encode_different_statuses", got, want)

// ── KAT 4: round-trip on a 4-message stream ──────────────────────────────────
// Stream: NoteOn ch0 C4, NoteOn ch0 D4, NoteOn ch0 E4, NoteOff ch0 C4
// Expected compressed: [0x90,60,100, 62,100, 64,100, 0x80,60,0]
// (three NoteOns share status; NoteOff resets it)
fn test_roundtrip_4msg() -> int
    let m1 = [144, 60, 100]
    let m2 = [144, 62, 100]
    let m3 = [144, 64, 100]
    let m4 = [128, 60, 0]
    let msgs_in = []
    push(msgs_in, m1)
    push(msgs_in, m2)
    push(msgs_in, m3)
    push(msgs_in, m4)
    // Verify encode produces the expected compressed stream.
    let encoded = rs_encode(msgs_in)
    let want_enc = [144, 60, 100, 62, 100, 64, 100, 128, 60, 0]
    ckl("roundtrip_4msg_encode", encoded, want_enc)
    // Verify decode restores all four messages exactly.
    let decoded = rs_decode(encoded)
    ckm("roundtrip_4msg_decode", decoded, msgs_in)

// ── KAT 5: single-data-byte messages (ProgramChange) ─────────────────────────
// ProgramChange 0xC0 has only 1 data byte.
// rs_encode([[0xC0,5],[0xC0,7]]) == [0xC0,5,7]
fn test_encode_program_change() -> int
    let m1 = [192, 5]
    let m2 = [192, 7]
    let msgs = []
    push(msgs, m1)
    push(msgs, m2)
    let got = rs_encode(msgs)
    let want = [192, 5, 7]
    ckl("encode_program_change", got, want)

// ── KAT 6: rs_decode on ProgramChange stream ─────────────────────────────────
// rs_decode([0xC0,5,7]) == [[0xC0,5],[0xC0,7]]
fn test_decode_program_change() -> int
    let stream = [192, 5, 7]
    let got = rs_decode(stream)
    let w1 = [192, 5]
    let w2 = [192, 7]
    let want = []
    push(want, w1)
    push(want, w2)
    ckm("decode_program_change", got, want)

// ── KAT 7: no compression across different channels ──────────────────────────
// NoteOn ch0 (0x90) vs NoteOn ch1 (0x91): different status bytes, both emitted.
fn test_encode_different_channels() -> int
    let m1 = [144, 60, 100]
    let m2 = [145, 60, 100]
    let msgs = []
    push(msgs, m1)
    push(msgs, m2)
    let got = rs_encode(msgs)
    let want = [144, 60, 100, 145, 60, 100]
    ckl("encode_different_channels", got, want)

// ── KAT 8: empty input ────────────────────────────────────────────────────────
fn test_encode_empty() -> int
    let msgs = []
    let got = rs_encode(msgs)
    let want = []
    ckl("encode_empty", got, want)

fn test_decode_empty() -> int
    let stream = []
    let got = rs_decode(stream)
    if len(got) != 0
        print("FAIL running_status decode_empty: expected 0 messages got " + str(len(got)))
        exit(1)
    0

// ── KAT 9: single message encode/decode (no running status possible) ──────────
fn test_encode_single() -> int
    let m1 = [144, 69, 127]
    let msgs = []
    push(msgs, m1)
    let got = rs_encode(msgs)
    let want = [144, 69, 127]
    ckl("encode_single", got, want)

// ── KAT 10: rs_decode of a plain (uncompressed) stream round-trips correctly ──
// If no running status was used, decode should still yield the same messages.
fn test_decode_no_compression() -> int
    let stream = [144, 60, 100, 128, 60, 0]
    let got = rs_decode(stream)
    let w1 = [144, 60, 100]
    let w2 = [128, 60, 0]
    let want = []
    push(want, w1)
    push(want, w2)
    ckm("decode_no_compression", got, want)

// ── Entry point ───────────────────────────────────────────────────────────────
fn main() -> int
    test_encode_repeated_status()
    test_decode_implied_status()
    test_encode_different_statuses()
    test_roundtrip_4msg()
    test_encode_program_change()
    test_decode_program_change()
    test_encode_different_channels()
    test_encode_empty()
    test_decode_empty()
    test_encode_single()
    test_decode_no_compression()
    print("PASS _running_status_test")
    0
