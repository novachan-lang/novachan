fn _base64url_encode(data)
  let b64 = base64_encode(data)
  let out = ""
  let i = 0
  while i < len(b64)
    let ch = slice(b64, i, i + 1)
    if ch == "+"
      out = out + "-"
    else if ch == "/"
      out = out + "_"
    else if ch == "="
      i = i + 1
      continue
    else
      out = out + ch
    i = i + 1
  out

fn _base64url_decode(data)
  let padded = data
  let i = 0
  let out = ""
  while i < len(padded)
    let ch = slice(padded, i, i + 1)
    if ch == "-"
      out = out + "+"
    else if ch == "_"
      out = out + "/"
    else
      out = out + ch
    i = i + 1
  let rem = len(out) % 4
  if rem == 2
    out = out + "=="
  else if rem == 3
    out = out + "="
  base64_decode(out)

fn jwt_create(payload_dict, secret)
  let header = json_stringify({"alg": "HS256", "typ": "JWT"})
  let payload = json_stringify(payload_dict)
  let h_enc = _base64url_encode(header)
  let p_enc = _base64url_encode(payload)
  let signing_input = h_enc + "." + p_enc
  // #11: real HMAC-SHA256. The old sha256(signing_input + secret) is a naive concatenation MAC that is
  // length-extension FORGEABLE (an attacker with one valid token can append claims and compute a valid
  // signature without the secret). hmac_sha256 (proper ipad/opad keying) is the correct construction.
  let sig = hmac_sha256(signing_input, secret)
  let sig_enc = _base64url_encode(sig)
  signing_input + "." + sig_enc

fn jwt_decode(token)
  let parts = split(token, ".")
  if len(parts) != 3
    return {}
  let payload_json = _base64url_decode(parts[1])
  json_decode(payload_json)

fn jwt_verify(token, secret)
  let parts = split(token, ".")
  if len(parts) != 3
    return 0
  let signing_input = parts[0] + "." + parts[1]
  // #11: recompute with the SAME real HMAC-SHA256 used in jwt_create (see note there)
  let expected_sig = _base64url_encode(hmac_sha256(signing_input, secret))
  expected_sig == parts[2]

fn main()
  let payload = {"sub": "user123", "role": "admin", "exp": 1700000000}
  let secret = "my-secret-key"

  let token = jwt_create(payload, secret)
  assert(len(split(token, ".")) == 3, "jwt has 3 parts")

  let decoded = jwt_decode(token)
  assert(decoded["sub"] == "user123", "decoded sub")
  assert(decoded["role"] == "admin", "decoded role")

  assert(jwt_verify(token, secret) == 1, "valid signature")
  assert(jwt_verify(token, "wrong-key") == 0, "invalid signature")
  assert(jwt_verify("bad.token", secret) == 0, "malformed token")

  let token2 = jwt_create({"user": "bob"}, "key2")
  let d2 = jwt_decode(token2)
  assert(d2["user"] == "bob", "second token")
  assert(jwt_verify(token2, "key2") == 1, "second verify")

  print("jwtx: all passed")
