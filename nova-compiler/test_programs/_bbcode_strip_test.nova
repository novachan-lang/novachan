import std/text/bbcode_lex
import std/text/bbcode_parse
import std/text/bbcode_strip

fn main()
    // KAT 1: plain text, no tags at all -> unchanged
    let s1 = bstr_strip("hello world")
    if s1 != "hello world"
        print("FAIL bbcode_strip KAT1: got [" + s1 + "]")
        exit(1)

    // KAT 2: simple matched pair -- brackets vanish, content remains
    let s2 = bstr_strip("[b]bold[/b]")
    if s2 != "bold"
        print("FAIL bbcode_strip KAT2: got [" + s2 + "]")
        exit(1)

    // KAT 3: nested tags -- all levels of markup vanish
    let s3 = bstr_strip("[b][i]hi[/i][/b]")
    if s3 != "hi"
        print("FAIL bbcode_strip KAT3: got [" + s3 + "]")
        exit(1)

    // KAT 4: attribute tag -- the attribute value itself is dropped, only
    // the tag's text content survives
    let s4 = bstr_strip("[url=http://x]link[/url]")
    if s4 != "link"
        print("FAIL bbcode_strip KAT4: got [" + s4 + "]")
        exit(1)

    // KAT 5: text surrounding a tag
    let s5 = bstr_strip("Hello [b]World[/b]!")
    if s5 != "Hello World!"
        print("FAIL bbcode_strip KAT5: got [" + s5 + "]")
        exit(1)

    // KAT 6: an unclosed tag is not real markup -- its bracket text is
    // PRESERVED in the stripped output (see bbcode_strip.nova header)
    let s6 = bstr_strip("[b]oops")
    if s6 != "[b]oops"
        print("FAIL bbcode_strip KAT6: got [" + s6 + "]")
        exit(1)

    // KAT 7: a stray close tag with no opener is likewise preserved
    let s7 = bstr_strip("hello[/b]world")
    if s7 != "hello[/b]world"
        print("FAIL bbcode_strip KAT7: got [" + s7 + "]")
        exit(1)

    // KAT 8: multiple sibling tags
    let s8 = bstr_strip("[b]A[/b] and [i]B[/i]")
    if s8 != "A and B"
        print("FAIL bbcode_strip KAT8: got [" + s8 + "]")
        exit(1)

    // KAT 9: empty input
    let s9 = bstr_strip("")
    if s9 != ""
        print("FAIL bbcode_strip KAT9: got [" + s9 + "]")
        exit(1)

    // KAT 10: bstr_strip_ast used directly on an already-parsed AST (the
    // path a caller takes when it built the AST itself, e.g. for reuse
    // across multiple extractions without re-lexing/re-parsing)
    let ast10 = bpar_parse(blex_tokenize("[quote]nested [b]text[/b][/quote]"))
    let s10 = bstr_strip_ast(ast10)
    if s10 != "nested text"
        print("FAIL bbcode_strip KAT10: got [" + s10 + "]")
        exit(1)

    print("PASS _bbcode_strip_test")
