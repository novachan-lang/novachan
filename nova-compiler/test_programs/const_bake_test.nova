// const aggregate baking: a const list literal is built ONCE at init and shared,
// not rebuilt at every use (Zig/C-comptime-class lookup table).
const TABLE = [1, 4, 9, 16, 25]
const NAMES = ["alpha", "beta", "gamma"]

fn use1()
    return TABLE[2]

fn use2()
    return TABLE[4]

fn main()
    assert_eq(use1() + use2(), 9 + 25)
    assert_eq(NAMES[1], "beta")
    // hot loop: TABLE must NOT be rebuilt per iteration
    let s = 0
    let i = 0
    while i < 5
        s = s + TABLE[i]
        i = i + 1
    assert_eq(s, 55)
    print("const_bake_test passed")
