import forge_token_refresh

fn main()
    let t = tr_new()
    t = tr_issue(t, "tok1", 100)
    t = tr_issue(t, "tok2", 50)
    assert(tr_token_count(t) == 2, "2 tokens")
    assert(tr_is_valid(t, "tok1") == 1, "tok1 valid")

    let r1 = tr_tick(t, "tok1", 30)
    assert(is_ok(r1), "tick ok")
    t = unwrap(r1)
    let rem = tr_remaining(t, "tok1")
    assert(unwrap(rem) == 70, "70 remaining")

    let ref1 = tr_refresh(t, "tok1")
    assert(is_ok(ref1), "refresh ok")
    t = unwrap(ref1)
    let rem2 = tr_remaining(t, "tok1")
    assert(unwrap(rem2) == 100, "refreshed to 100")
    assert(tr_refresh_count(t) == 1, "1 refresh")

    let r2 = tr_tick(t, "tok2", 60)
    t = unwrap(r2)
    assert(tr_is_valid(t, "tok2") == 0, "tok2 expired")
    assert(tr_expiration_count(t) == 1, "1 expiration")

    let bad = tr_refresh(t, "tok2")
    assert(is_err(bad), "expired token")

    print("TOKEN-REFRESH KAT PASS")
