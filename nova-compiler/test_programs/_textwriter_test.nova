// KAT for std/io/textwriter
import std/io/textwriter

// ── helpers ──────────────────────────────────────────────────────────────────

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got=[" + got + "] want=[" + want + "]")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ── KAT 1: basic writeln with indent/dedent ──────────────────────────────────
// tw_writeln("fn f()") -> "fn f()\n"
// tw_indent; tw_writeln("body") -> "  body\n"
// tw_dedent; tw_writeln("end") -> "end\n"
// full result: "fn f()\n  body\nend\n"

fn test_basic()
    let tw = tw_new()
    tw_writeln(tw, "fn f()")
    tw_indent(tw)
    tw_writeln(tw, "body")
    tw_dedent(tw)
    tw_writeln(tw, "end")
    let want = "fn f()" + chr(10) + "  body" + chr(10) + "end" + chr(10)
    cks("basic_writeln", tw_str(tw), want)

// ── KAT 2: tw_write (no newline, no indent) ──────────────────────────────────
// tw_write("hello"); tw_write(" world") -> "hello world" (no newline)

fn test_write_concat()
    let tw = tw_new()
    tw_write(tw, "hello")
    tw_write(tw, " world")
    cks("write_concat", tw_str(tw), "hello world")

// ── KAT 3: tw_line emits a bare newline ──────────────────────────────────────

fn test_line()
    let tw = tw_new()
    tw_writeln(tw, "a")
    tw_line(tw)
    tw_writeln(tw, "b")
    let want = "a" + chr(10) + chr(10) + "b" + chr(10)
    cks("blank_line", tw_str(tw), want)

// ── KAT 4: tw_dedent cannot go below zero ────────────────────────────────────

fn test_dedent_floor()
    let tw = tw_new()
    tw_dedent(tw)
    tw_dedent(tw)
    tw_writeln(tw, "x")
    cks("dedent_floor", tw_str(tw), "x" + chr(10))
    cki("level_floor_zero", tw["level"], 0)

// ── KAT 5: tw_new_unit with a custom indent unit (tab) ───────────────────────

fn test_custom_unit()
    let tw = tw_new_unit(chr(9))
    tw_writeln(tw, "outer")
    tw_indent(tw)
    tw_writeln(tw, "inner")
    tw_dedent(tw)
    tw_writeln(tw, "end")
    let want = "outer" + chr(10) + chr(9) + "inner" + chr(10) + "end" + chr(10)
    cks("custom_unit_tab", tw_str(tw), want)

// ── KAT 6: multiple indent levels ────────────────────────────────────────────
// level 0: "a\n"; level 1: "  b\n"; level 2: "    c\n"; level 1: "  d\n"; level 0: "e\n"

fn test_multi_level()
    let tw = tw_new()
    tw_writeln(tw, "a")
    tw_indent(tw)
    tw_writeln(tw, "b")
    tw_indent(tw)
    tw_writeln(tw, "c")
    tw_dedent(tw)
    tw_writeln(tw, "d")
    tw_dedent(tw)
    tw_writeln(tw, "e")
    let nl = chr(10)
    let want = "a" + nl + "  b" + nl + "    c" + nl + "  d" + nl + "e" + nl
    cks("multi_level", tw_str(tw), want)

// ── KAT 7: tw_str on empty writer returns empty string ───────────────────────

fn test_empty()
    let tw = tw_new()
    cks("empty_writer", tw_str(tw), "")

// ── KAT 8: tw_write then tw_writeln on same line ─────────────────────────────
// tw_write("// "); tw_writeln adds indent+s+nl SEPARATELY, not on same logical line

fn test_write_then_writeln()
    let tw = tw_new()
    tw_write(tw, "// header")
    tw_writeln(tw, "first")
    let want = "// header" + "first" + chr(10)
    cks("write_then_writeln", tw_str(tw), want)

// ── run all ──────────────────────────────────────────────────────────────────

fn main()
    test_basic()
    test_write_concat()
    test_line()
    test_dedent_floor()
    test_custom_unit()
    test_multi_level()
    test_empty()
    test_write_then_writeln()
    print("_textwriter_test passed")
