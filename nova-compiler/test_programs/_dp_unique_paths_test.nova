import std/dp/dp_unique_paths

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn ckl(label, got, want)
    let lg = len(got)
    let lw = len(want)
    if lg != lw
        print("FAIL " + label + " len: got=" + str(lg) + " want=" + str(lw))
        exit(1)
    let k = 0
    while k < lw
        if got[k] != want[k]
            print("FAIL " + label + "[" + str(k) + "]: got=" + str(got[k]) + " want=" + str(want[k]))
            exit(1)
        k = k + 1

fn main()
    // KAT 1: up_count(3,7) == 28  (C(8,2)=28)
    cki("up_count(3,7)", up_count(3, 7), 28)

    // KAT 2: up_count(3,2) == 3  (C(3,1)=3)
    cki("up_count(3,2)", up_count(3, 2), 3)

    // KAT 3: up_count(1,1) == 1
    cki("up_count(1,1)", up_count(1, 1), 1)

    // KAT 4: up_with_obstacles([[0,0,0],[0,1,0],[0,0,0]]) == 2
    // Blocked center: two paths go around (top-right or bottom-left of obstacle)
    let g1 = []
    let r1a = []
    push(r1a, 0)
    push(r1a, 0)
    push(r1a, 0)
    push(g1, r1a)
    let r1b = []
    push(r1b, 0)
    push(r1b, 1)
    push(r1b, 0)
    push(g1, r1b)
    let r1c = []
    push(r1c, 0)
    push(r1c, 0)
    push(r1c, 0)
    push(g1, r1c)
    cki("up_with_obstacles center blocked", up_with_obstacles(g1), 2)

    // KAT 5: up_with_obstacles([[0,1],[0,0]]) == 1
    // Top-right blocked: only path is down then right
    let g2 = []
    let r2a = []
    push(r2a, 0)
    push(r2a, 1)
    push(g2, r2a)
    let r2b = []
    push(r2b, 0)
    push(r2b, 0)
    push(g2, r2b)
    cki("up_with_obstacles top-right blocked", up_with_obstacles(g2), 1)

    // KAT 6: up_count_diag(3,3) == 13
    // DP: f[0][0]=1; f[0][1]=1; f[0][2]=1; f[1][0]=1; f[1][1]=3; f[1][2]=5;
    //     f[2][0]=1; f[2][1]=5; f[2][2]=13
    cki("up_count_diag(3,3)", up_count_diag(3, 3), 13)

    // KAT 7: up_count(3,3) == 6  (C(4,2)=6)
    cki("up_count(3,3)", up_count(3, 3), 6)

    // KAT 8: up_count_diag(1,1) == 1
    cki("up_count_diag(1,1)", up_count_diag(1, 1), 1)

    // KAT 9: up_count_diag(2,2) == 3
    // f[0][0]=1; f[0][1]=1; f[1][0]=1; f[1][1]=1+1+1=3
    cki("up_count_diag(2,2)", up_count_diag(2, 2), 3)

    // KAT 10: up_with_obstacles with all free cells == up_count
    let g3 = []
    let r3a = []
    push(r3a, 0)
    push(r3a, 0)
    push(r3a, 0)
    push(g3, r3a)
    let r3b = []
    push(r3b, 0)
    push(r3b, 0)
    push(r3b, 0)
    push(g3, r3b)
    cki("up_with_obstacles all-free 2x3", up_with_obstacles(g3), 3)

    // KAT 11: up_with_obstacles blocked start -> 0
    let g4 = []
    let r4a = []
    push(r4a, 1)
    push(r4a, 0)
    push(g4, r4a)
    let r4b = []
    push(r4b, 0)
    push(r4b, 0)
    push(g4, r4b)
    cki("up_with_obstacles blocked start", up_with_obstacles(g4), 0)

    // KAT 12: up_count(7,3) == 28  (symmetric to up_count(3,7))
    cki("up_count(7,3)", up_count(7, 3), 28)

    print("PASS _dp_unique_paths_test")
