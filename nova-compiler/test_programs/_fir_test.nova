import std/dsp/fir

// ckf: check a single float value within eps 0.001
fn ckf(label: string, got: float, want: float)
    let diff = got - want
    let adiff = diff
    if adiff < 0.0
        adiff = 0.0 - adiff
    if adiff > 0.001
        print("FAIL " + label + " got=" + str(got) + " want=" + str(want))
        exit(1)

// ckfl: check two float lists element-wise within eps 0.001
fn ckfl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + " len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        let g = got[i] * 1.0
        let w = want[i] * 1.0
        let diff = g - w
        let adiff = diff
        if adiff < 0.0
            adiff = 0.0 - adiff
        if adiff > 0.001
            print("FAIL " + label + "[" + str(i) + "] got=" + str(g) + " want=" + str(w))
            exit(1)
        i = i + 1

fn main()
    // KAT 1: identity filter (single coefficient 1.0) — output equals input
    let sig1 = [1.0, 2.0, 3.0, 4.0]
    let coeff_id = [1.0]
    let out1 = fir_apply(sig1, coeff_id)
    ckfl("identity", out1, [1.0, 2.0, 3.0, 4.0])

    // KAT 2: two-tap averaging [0.5, 0.5]
    // output[i] = 0.5*signal[i] + 0.5*signal[i-1], signal[-1]=0
    // i=0: 0.5*1.0 + 0.5*0.0 = 0.5
    // i=1: 0.5*2.0 + 0.5*1.0 = 1.5
    // i=2: 0.5*3.0 + 0.5*2.0 = 2.5
    let sig2 = [1.0, 2.0, 3.0]
    let coeff2 = [0.5, 0.5]
    let out2 = fir_apply(sig2, coeff2)
    ckfl("two_tap", out2, [0.5, 1.5, 2.5])

    // KAT 3: moving average coefficients, n=4
    let ma4 = fir_moving_average_coeffs(4)
    ckfl("ma_coeffs_4", ma4, [0.25, 0.25, 0.25, 0.25])

    // KAT 4: DC gain of moving_average_coeffs(4) == 1.0
    let gain4 = fir_gain(ma4)
    ckf("ma_gain_4", gain4, 1.0)

    // KAT 5: applying 4-tap moving average to constant [2.0,2.0,2.0]
    // at index 2 (3rd element): 0.25*2+0.25*2+0.25*2+0.25*0 = 1.5
    let sig3 = [2.0, 2.0, 2.0]
    let out3 = fir_apply(sig3, ma4)
    ckf("ma4_apply_idx2", out3[2] * 1.0, 1.5)

    // KAT 6: lowpass_coeffs returns correct length
    let lp5 = fir_lowpass_coeffs(5, 0.25)
    if len(lp5) != 5
        print("FAIL lowpass_len got=" + str(len(lp5)) + " want=5")
        exit(1)

    // KAT 7: DC gain of lowpass_coeffs is 1.0 (normalised)
    let lp_gain = fir_gain(lp5)
    ckf("lowpass_dc_gain", lp_gain, 1.0)

    // KAT 8: single-tap moving average coefficients
    let ma1 = fir_moving_average_coeffs(1)
    ckfl("ma_coeffs_1", ma1, [1.0])

    // KAT 9: fir_gain of identity coeff is 1.0
    let g_id = fir_gain([1.0])
    ckf("gain_identity", g_id, 1.0)

    // KAT 10: empty signal produces empty output
    let out_empty = fir_apply([], [1.0])
    if len(out_empty) != 0
        print("FAIL empty_signal len=" + str(len(out_empty)))
        exit(1)

    print("_fir_test passed")
