// Soundness regression for nova_rt_index_get / slice_any / len_any / len: normal string/list/dict ops must
// be intact, AND indexing / measuring / iterating a NON-container any-value (json_decode of a scalar) must
// be SAFE (return null / 0 / no iterations) instead of dereferencing it as a char* (wild read / segfault).
fn main()
    let s = "hello"
    assert_eq(s[1], "e")                 // string index intact
    assert_eq(len(s), 5)                 // string len intact
    let l = [10, 20, 30]
    assert_eq(l[1], 20)                  // list index intact
    assert_eq(len(l), 3)                 // list len intact
    let d = {}
    d["a"] = 7
    assert_eq(d["a"], 7)                 // dict index intact
    assert_eq(len(d), 1)                 // dict len intact
    let m = json_decode("5")             // an int, not a container
    assert_eq(m["type"], 0)              // index: was a wild read -> now safe null
    assert_eq(len(m), 0)                 // len: was a wild strlen -> now 0
    let cnt = 0
    for x in m                           // for-in (len + index_get): was a segfault -> now 0 iterations
        cnt = cnt + 1
    assert_eq(cnt, 0)
    let b = json_decode("true")          // a bool, not a container
    assert_eq(b["x"], 0)                 // safe null
    print("PASS index_soundness (index/len/for-in safe on non-containers; containers intact)")
