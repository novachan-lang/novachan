// Soundness regression for the any-op wild-read class: collection ops (index_get/slice/len/for-in/contains/
// index_of) AND string ops (upper/lower/trim/split/find/starts_with/ends_with/replace/join/...) must keep
// working on real containers/strings, AND be SAFE (empty/null/0/-1) on a NON-container any-value (json_decode
// of a scalar) instead of dereferencing the scalar as a char* (wild read / ACCESS_VIOLATION).
fn main()
    // --- normal ops intact ---
    let s = "hello"
    assert_eq(s[1], "e")
    assert_eq(len(s), 5)
    assert_eq(contains(s, "ell"), 1)
    assert_eq(upper(s), "HELLO")
    assert_eq(find(s, "ll"), 2)
    assert_eq(starts_with(s, "he"), 1)
    let l = [10, 20, 30]
    assert_eq(l[1], 20)
    assert_eq(len(l), 3)
    assert_eq(contains(l, 20), 1)
    let d = {}
    d["a"] = 7
    assert_eq(d["a"], 7)
    assert_eq(len(d), 1)
    assert_eq(replace("a,b,c", ",", "-"), "a-b-c")
    assert_eq(join(["a", "b", "c"], "-"), "a-b-c")
    // --- non-container any-values: every op safe (was a wild read / segfault) ---
    let m = json_decode("5")
    assert_eq(m["type"], 0)
    assert_eq(len(m), 0)
    assert_eq(contains(m, 1), 0)
    assert_eq(upper(m), "")
    assert_eq(lower(m), "")
    assert_eq(trim(m), "")
    assert_eq(find(m, "x"), -1)
    assert_eq(starts_with(m, "x"), 0)
    assert_eq(join(m, "-"), "")
    let cnt = 0
    for x in m
        cnt = cnt + 1
    assert_eq(cnt, 0)
    print("PASS index_soundness (collection + string ops safe on non-containers; containers/strings intact)")
