// Soundness regression for the any-op wild-read class: collection ops (index_get/slice/len/for-in/contains/
// index_of), string ops (upper/lower/trim/split/find/starts_with/replace/join/ord/lstrip/...), and dict-key
// hashing must keep working on real containers/strings, AND be SAFE (empty/null/0/-1) on a NON-container
// any-value (json_decode of a scalar) instead of dereferencing the scalar as a char* (ACCESS_VIOLATION).
fn main()
    // --- normal ops intact ---
    let s = "hello"
    assert_eq(s[1], "e")
    assert_eq(len(s), 5)
    assert_eq(contains(s, "ell"), 1)
    assert_eq(upper(s), "HELLO")
    assert_eq(find(s, "ll"), 2)
    assert_eq(starts_with(s, "he"), 1)
    assert_eq(ord("A"), 65)
    assert_eq(lstrip("  x"), "x")
    let l = [10, 20, 30]
    assert_eq(l[1], 20)
    assert_eq(len(l), 3)
    assert_eq(contains(l, 20), 1)
    let d = {}
    d["a"] = 7
    assert_eq(d["a"], 7)
    assert_eq(len(d), 1)
    assert_eq(len(keys(d)), 1)
    assert_eq(get(d, "a", 99), 7)         // get_default on a real dict
    assert_eq(replace("a,b,c", ",", "-"), "a-b-c")
    assert_eq(join(["a", "b", "c"], "-"), "a-b-c")
    // --- non-container any-values: every op safe (was a wild read / segfault) ---
    let m = json_decode("5")
    assert_eq(m["type"], 0)
    assert_eq(len(m), 0)
    assert_eq(contains(m, 1), 0)
    assert_eq(upper(m), "")
    assert_eq(lower(m), "")
    assert_eq(trim(m), "")
    assert_eq(find(m, "x"), -1)
    assert_eq(starts_with(m, "x"), 0)
    assert_eq(join(m, "-"), "")
    assert_eq(ord(m), 0)
    assert_eq(lstrip(m), "")
    assert_eq(d[m], 0)                    // non-string dict key -> safe (was hash/strcmp wild read)
    assert_eq(len(keys(m)), 0)            // keys() on a non-dict -> empty (was d->size wild read)
    assert_eq(len(values(m)), 0)          // values() on a non-dict
    assert_eq(get(m, "k", 99), 99)        // get_default on a non-dict -> deflt (was dict_has handle wild read) -> empty
    let cnt = 0
    for x in m
        cnt = cnt + 1
    assert_eq(cnt, 0)
    print("PASS index_soundness (collection + string + dict-key ops safe on non-containers; containers/strings intact)")
