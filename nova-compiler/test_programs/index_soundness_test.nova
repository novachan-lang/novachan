// Soundness regression for nova_rt_index_get / slice_any: normal string/list/dict indexing must be intact,
// AND indexing a NON-container any-value (json_decode of a scalar) must return a safe null instead of
// dereferencing it as a char* (wild read / segfault). Guards the CVE-class fix.
fn main()
    let s = "hello"
    assert_eq(s[1], "e")                 // string index intact
    let l = [10, 20, 30]
    assert_eq(l[1], 20)                  // list index intact
    let d = {}
    d["a"] = 7
    assert_eq(d["a"], 7)                 // dict index intact
    let m = json_decode("5")             // an int, not a container
    assert_eq(m["type"], 0)              // was a wild read -> now safe null
    let b = json_decode("true")          // a bool, not a container
    assert_eq(b["x"], 0)                 // safe null
    print("PASS index_soundness (string/list/dict index intact; non-container index -> safe null, no wild read)")
