// Soundness regression for the any-op wild-read class (index_get / slice_any / len_any / len / contains /
// index_of): normal string/list/dict ops intact, AND any op on a NON-container any-value (json_decode of a
// scalar) is SAFE (null / 0 / -1 / no iterations) instead of dereferencing the scalar as a char* (segfault).
fn main()
    let s = "hello"
    assert_eq(s[1], "e")                 // string index intact
    assert_eq(len(s), 5)                 // string len intact
    assert_eq(contains(s, "ell"), 1)     // string contains intact
    let l = [10, 20, 30]
    assert_eq(l[1], 20)                  // list index intact
    assert_eq(len(l), 3)                 // list len intact
    assert_eq(contains(l, 20), 1)        // list contains intact
    let d = {}
    d["a"] = 7
    assert_eq(d["a"], 7)                 // dict index intact
    assert_eq(len(d), 1)                 // dict len intact
    let m = json_decode("5")             // an int, not a container
    assert_eq(m["type"], 0)              // index: was a wild read -> safe null
    assert_eq(len(m), 0)                 // len: was a wild strlen -> 0
    assert_eq(contains(m, 1), 0)         // contains: was a wild strstr -> 0
    let cnt = 0
    for x in m                           // for-in (len + index_get): was a segfault -> 0 iterations
        cnt = cnt + 1
    assert_eq(cnt, 0)
    let b = json_decode("true")          // a bool, not a container
    assert_eq(b["x"], 0)                 // safe null
    print("PASS index_soundness (index/len/for-in/contains safe on non-containers; containers intact)")
