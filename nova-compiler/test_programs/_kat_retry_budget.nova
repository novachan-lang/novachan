import forge_retry_budget

fn main()
    let r = rb_new(20)
    let i = 0
    while i < 10
        r = rb_record_request(r, "api")
        i = i + 1
    assert(rb_total_requests(r) == 10, "10 requests")

    assert(rb_can_retry(r, "api") == 1, "can retry: 0/10")
    r = rb_record_retry(r, "api")
    assert(rb_can_retry(r, "api") == 1, "can retry: 1/10=10%")
    r = rb_record_retry(r, "api")
    assert(rb_can_retry(r, "api") == 0, "cannot retry: 2/10=20%")

    assert(rb_retry_rate(r, "api") == 20, "20% retry rate")
    assert(rb_total_retries(r) == 2, "2 retries")
    assert(rb_global_retry_rate(r) == 20, "20% global")

    assert(rb_can_retry(r, "unknown") == 0, "unknown service")

    print("RETRY-BUDGET KAT PASS")
