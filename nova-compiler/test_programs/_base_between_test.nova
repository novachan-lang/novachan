import std/numeral/base_between

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL base_between " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL base_between " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // bb_to_int KAT
    cki("to_int(FF,16)",   bb_to_int("FF",16),   255)
    cki("to_int(1010,2)",  bb_to_int("1010",2),  10)
    cki("to_int(0,10)",    bb_to_int("0",10),    0)
    cki("to_int(-FF,16)",  bb_to_int("-FF",16),  -255)
    cki("to_int(Z,36)",    bb_to_int("Z",36),    35)

    // bb_from_int KAT
    cks("from_int(255,16)",  bb_from_int(255,16),  "FF")
    cks("from_int(10,2)",    bb_from_int(10,2),    "1010")
    cks("from_int(0,2)",     bb_from_int(0,2),     "0")
    cks("from_int(-255,16)", bb_from_int(-255,16), "-FF")
    cks("from_int(35,36)",   bb_from_int(35,36),   "Z")

    // bb_convert KAT
    cks("convert(FF,16,2)",   bb_convert("FF",16,2),   "11111111")
    cks("convert(255,10,16)", bb_convert("255",10,16), "FF")
    cks("convert(1010,2,10)", bb_convert("1010",2,10), "10")
    cks("convert(Z,36,10)",   bb_convert("Z",36,10),   "35")
    cks("convert(0,10,2)",    bb_convert("0",10,2),    "0")
    cks("convert(-FF,16,10)", bb_convert("-FF",16,10), "-255")
    cks("convert(11111111,2,16)", bb_convert("11111111",2,16), "FF")
    cks("convert(10,8,16)",   bb_convert("10",8,16),   "8")

    // Round-trip via bb_convert
    cks("roundtrip(12345,10,7,10)", bb_convert(bb_convert("12345",10,7),7,10), "12345")
    cks("roundtrip(FF,16,2,16)",    bb_convert(bb_convert("FF",16,2),2,16),    "FF")
    cks("roundtrip(-255,10,16,10)", bb_convert(bb_convert("-255",10,16),16,10),"-255")
    cks("roundtrip(0,10,36,10)",    bb_convert(bb_convert("0",10,36),36,10),   "0")

    print("PASS _base_between_test")
