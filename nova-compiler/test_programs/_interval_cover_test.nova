import std/interval/interval_cover

// _ic_iv_eq: compare two intervals [lo,hi] by value
fn _ic_iv_eq(a: list, b: list) -> bool
    if len(a) != len(b)
        return false
    if a[0] != b[0]
        return false
    if a[1] != b[1]
        return false
    return true

// _ic_flat_eq: compare two flat lists element-by-element
fn _ic_flat_eq(a: list, b: list) -> bool
    if len(a) != len(b)
        return false
    let i = 0
    while i < len(a)
        if a[i] != b[i]
            return false
        i = i + 1
    return true

// _ic_stabs_point: true if interval iv contains point x
fn _ic_stabs_point(iv: list, x) -> bool
    if x < iv[0]
        return false
    if x > iv[1]
        return false
    return true

// _ic_all_stabbed: true if every interval in ivs is stabbed by some point in pts
fn _ic_all_stabbed(ivs: list, pts: list) -> bool
    let ni = len(ivs)
    let np = len(pts)
    let i = 0
    while i < ni
        let iv = ivs[i]
        let found = false
        let j = 0
        while j < np
            if _ic_stabs_point(iv, pts[j])
                found = true
            j = j + 1
        if not found
            return false
        i = i + 1
    return true

// _ic_covers_target: true if union of ivs covers [tlo,thi]
fn _ic_covers_target(tlo, thi, ivs: list) -> bool
    let n = len(ivs)
    if n == 0
        return false
    // build sorted copy by lo
    let sorted = []
    let i = 0
    while i < n
        push(sorted, ivs[i])
        i = i + 1
    // insertion sort by lo asc
    let j = 1
    while j < n
        let key = sorted[j]
        let klo = key[0]
        let pos = j
        let k = j - 1
        let done = false
        while k >= 0 and done == false
            if sorted[k][0] > klo
                sorted[k + 1] = sorted[k]
                pos = k
                k = k - 1
            else
                done = true
        sorted[pos] = key
        j = j + 1
    let reach = tlo
    i = 0
    while i < n
        let iv = sorted[i]
        if iv[0] > reach
            return false
        if iv[1] > reach
            reach = iv[1]
        i = i + 1
    if reach >= thi
        return true
    return false

fn _fail(label: string, msg: string)
    print("FAIL ic_" + label + ": " + msg)
    exit(1)

fn main()
    // KAT 1: ic_min_points_to_stab([[1,3],[2,4],[5,7]]) has len==2
    let ivs1 = []
    let iv1a = []
    push(iv1a, 1)
    push(iv1a, 3)
    push(ivs1, iv1a)
    let iv1b = []
    push(iv1b, 2)
    push(iv1b, 4)
    push(ivs1, iv1b)
    let iv1c = []
    push(iv1c, 5)
    push(iv1c, 7)
    push(ivs1, iv1c)
    let pts1 = ic_min_points_to_stab(ivs1)
    if len(pts1) != 2
        _fail("stab1_len", "got=" + str(len(pts1)) + " want=2")
    // verify all intervals are stabbed
    if not _ic_all_stabbed(ivs1, pts1)
        _fail("stab1_coverage", "not all intervals stabbed by " + str(pts1))

    // KAT 2: ic_stab_count([[1,3],[2,4],[5,7]]) == 2
    let sc2 = ic_stab_count(ivs1)
    if sc2 != 2
        _fail("stab_count2", "got=" + str(sc2) + " want=2")

    // KAT 3: ic_min_points_to_stab([[1,2],[2,3],[3,4]]) has len==2
    // greedy by earliest end: pick 2 (stabs [1,2] and [2,3]), then pick 4 (stabs [3,4])
    let ivs3 = []
    let iv3a = []
    push(iv3a, 1)
    push(iv3a, 2)
    push(ivs3, iv3a)
    let iv3b = []
    push(iv3b, 2)
    push(iv3b, 3)
    push(ivs3, iv3b)
    let iv3c = []
    push(iv3c, 3)
    push(iv3c, 4)
    push(ivs3, iv3c)
    let pts3 = ic_min_points_to_stab(ivs3)
    if len(pts3) != 2
        _fail("stab3_len", "got=" + str(len(pts3)) + " want=2")
    if not _ic_all_stabbed(ivs3, pts3)
        _fail("stab3_coverage", "not all intervals stabbed by " + str(pts3))

    // KAT 4: ic_is_covered([0,10], [[0,5],[4,10]]) == true
    let target4 = []
    push(target4, 0)
    push(target4, 10)
    let ivs4 = []
    let iv4a = []
    push(iv4a, 0)
    push(iv4a, 5)
    push(ivs4, iv4a)
    let iv4b = []
    push(iv4b, 4)
    push(iv4b, 10)
    push(ivs4, iv4b)
    let cov4 = ic_is_covered(target4, ivs4)
    if cov4 != true
        _fail("is_covered4", "got=false want=true")

    // KAT 5: ic_is_covered([0,10], [[0,4],[6,10]]) == false (gap 4..6)
    let ivs5 = []
    let iv5a = []
    push(iv5a, 0)
    push(iv5a, 4)
    push(ivs5, iv5a)
    let iv5b = []
    push(iv5b, 6)
    push(iv5b, 10)
    push(ivs5, iv5b)
    let cov5 = ic_is_covered(target4, ivs5)
    if cov5 != false
        _fail("is_covered5_gap", "got=true want=false")

    // KAT 6: ic_min_intervals_to_cover([0,10], [[0,5],[3,8],[6,10]])
    // [0,5]+[3,8] = [0,8], still missing [8,10]; [0,5]+[6,10] has gap [5,6]; need all 3
    // Greedy gives 3 which is the true minimum for this input.
    let target6 = []
    push(target6, 0)
    push(target6, 10)
    let ivs6 = []
    let iv6a = []
    push(iv6a, 0)
    push(iv6a, 5)
    push(ivs6, iv6a)
    let iv6b = []
    push(iv6b, 3)
    push(iv6b, 8)
    push(ivs6, iv6b)
    let iv6c = []
    push(iv6c, 6)
    push(iv6c, 10)
    push(ivs6, iv6c)
    let cover6 = ic_min_intervals_to_cover(target6, ivs6)
    if len(cover6) != 3
        _fail("min_cover6_len", "got=" + str(len(cover6)) + " want=3")
    // verify the cover actually covers [0,10]
    if not _ic_covers_target(0, 10, cover6)
        _fail("min_cover6_valid", "returned intervals don't cover [0,10]: " + str(cover6))

    // KAT 6b: ic_min_intervals_to_cover([0,10], [[0,6],[4,10],[2,3]]) => len==2
    // [0,6]+[4,10] covers [0,10]. [2,3] is subsumed.
    let ivs6b = []
    let iv6ba = []
    push(iv6ba, 0)
    push(iv6ba, 6)
    push(ivs6b, iv6ba)
    let iv6bb = []
    push(iv6bb, 4)
    push(iv6bb, 10)
    push(ivs6b, iv6bb)
    let iv6bc = []
    push(iv6bc, 2)
    push(iv6bc, 3)
    push(ivs6b, iv6bc)
    let cover6b = ic_min_intervals_to_cover(target6, ivs6b)
    if len(cover6b) != 2
        _fail("min_cover6b_len", "got=" + str(len(cover6b)) + " want=2")
    if not _ic_covers_target(0, 10, cover6b)
        _fail("min_cover6b_valid", "returned intervals don't cover [0,10]: " + str(cover6b))

    // KAT 7: ic_min_intervals_to_cover([0,10], [[0,4],[6,10]]) => [] (impossible)
    let cover7 = ic_min_intervals_to_cover(target4, ivs5)
    if len(cover7) != 0
        _fail("min_cover7_impossible", "got len=" + str(len(cover7)) + " want=0")

    // KAT 8: ic_is_covered single exact match
    let ivs8 = []
    let iv8a = []
    push(iv8a, 0)
    push(iv8a, 10)
    push(ivs8, iv8a)
    let cov8 = ic_is_covered(target4, ivs8)
    if cov8 != true
        _fail("is_covered8_exact", "got=false want=true")

    // KAT 9: ic_min_points_to_stab([]) == []
    let pts9 = ic_min_points_to_stab([])
    if len(pts9) != 0
        _fail("stab9_empty", "got len=" + str(len(pts9)))

    // KAT 10: ic_is_covered with empty intervals => false
    let cov10 = ic_is_covered(target4, [])
    if cov10 != false
        _fail("is_covered10_empty", "got=true want=false")

    // KAT 11: ic_greedy_cover alias works (using ivs6b which admits a 2-cover)
    let gc11 = ic_greedy_cover(target6, ivs6b)
    if len(gc11) != 2
        _fail("greedy_cover11_len", "got=" + str(len(gc11)) + " want=2")

    // KAT 12: ic_point_cover_size alias works
    let pcs12 = ic_point_cover_size(ivs1)
    if pcs12 != 2
        _fail("point_cover_size12", "got=" + str(pcs12) + " want=2")

    // KAT 13: single interval needs 1 stab point
    let ivs13 = []
    let iv13 = []
    push(iv13, 3)
    push(iv13, 7)
    push(ivs13, iv13)
    let pts13 = ic_min_points_to_stab(ivs13)
    if len(pts13) != 1
        _fail("stab13_single", "got len=" + str(len(pts13)) + " want=1")
    if not _ic_all_stabbed(ivs13, pts13)
        _fail("stab13_valid", "not all stabbed")

    // KAT 14: ic_min_intervals_to_cover touching intervals [0,5],[5,10] covers [0,10]
    let ivs14 = []
    let iv14a = []
    push(iv14a, 0)
    push(iv14a, 5)
    push(ivs14, iv14a)
    let iv14b = []
    push(iv14b, 5)
    push(iv14b, 10)
    push(ivs14, iv14b)
    let target14 = []
    push(target14, 0)
    push(target14, 10)
    let cover14 = ic_min_intervals_to_cover(target14, ivs14)
    if len(cover14) != 2
        _fail("min_cover14_touching", "got len=" + str(len(cover14)) + " want=2")
    if not _ic_covers_target(0, 10, cover14)
        _fail("min_cover14_valid", "does not cover [0,10]")

    print("PASS _interval_cover_test")
