import std/functional/faccumulate
import std/functional/fchain
import std/functional/fcombinator
import std/functional/ffilter
import std/functional/fgroupby
import std/functional/fiterate
import std/functional/fmap
import std/functional/fpredicate
import std/functional/freduce
import std/functional/fsortby
import std/functional/ftakewhile
import std/functional/func
import std/functional/fzipwith

fn assert_eq(label: string, got: any, want: any)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
    else
        print("ok " + label)

fn is_even(x) -> bool
    x % 2 == 0

fn is_pos(x) -> bool
    x > 0

fn dbl(x)
    x * 2

fn inc(x)
    x + 1

fn add2(a, b)
    a + b

fn add3(a, b, c)
    a + b + c

fn key_mod3(x)
    x % 3

fn list_eq(a: list, b: list) -> bool
    if len(a) != len(b)
        return false
    for i in 0..len(a)
        if a[i] != b[i]
            return false
    true

fn main()
    // faccumulate
    assert_eq("fa_sum_by", fa_sum_by(dbl, [1, 2, 3]), 12)
    assert_eq("fa_count_where", fa_count_where(is_even, [1, 2, 3, 4]), 2)

    // fchain
    assert_eq("fch_pipe2", fch_pipe2(3, dbl, inc), 7)
    assert_eq("fch_apply_all", list_eq(fch_apply_all(3, dbl, inc, dbl), [6, 4, 6]), true)

    // fcombinator
    assert_eq("fc_flip", fc_flip(add2, 1, 2), 3)

    // ffilter
    assert_eq("ff_filter", list_eq(ff_filter(is_even, [1, 2, 3, 4]), [2, 4]), true)
    assert_eq("ff_reject", list_eq(ff_reject(is_even, [1, 2, 3, 4]), [1, 3]), true)
    let part = ff_partition(is_even, [1, 2, 3, 4])
    assert_eq("ff_partition kept", list_eq(part[0], [2, 4]), true)
    assert_eq("ff_partition rejected", list_eq(part[1], [1, 3]), true)

    // fgroupby
    let grouped = fg_group_by(key_mod3, [1, 2, 3, 4, 5, 6])
    assert_eq("fg_group_by groups", len(grouped), 3)
    assert_eq("fg_group_by key0", grouped[0][0], 0)
    assert_eq("fg_group_by key0 members", list_eq(grouped[0][1], [3, 6]), true)
    let parts = fg_partition_by(is_pos, [1, 2, -1, -2, 3])
    assert_eq("fg_partition_by count", len(parts), 3)
    assert_eq("fg_partition_by run0", list_eq(parts[0], [1, 2]), true)
    assert_eq("fg_partition_by run1", list_eq(parts[1], [-1, -2]), true)
    assert_eq("fg_partition_by run2", list_eq(parts[2], [3]), true)
    let counted = fg_count_by(key_mod3, [1, 2, 3, 4, 5, 6])
    assert_eq("fg_count_by count0", counted[0][1], 2)

    // fiterate
    assert_eq("fi_apply_n", fi_apply_n(dbl, 3, 1), 8)
    assert_eq("fi_iterate", list_eq(fi_iterate(dbl, 1, 4), [1, 2, 4, 8]), true)

    // fmap
    assert_eq("fm_map", list_eq(fm_map(dbl, [1, 2, 3]), [2, 4, 6]), true)
    assert_eq("fm_map_indexed", list_eq(fm_map_indexed(add2, [10, 20, 30]), [10, 21, 32]), true)

    // fpredicate
    assert_eq("fpr_all true", fpr_all(is_pos, [1, 2, 3]), true)
    assert_eq("fpr_all false", fpr_all(is_pos, [1, -2, 3]), false)
    assert_eq("fpr_any", fpr_any(is_even, [1, 3, 4]), true)
    assert_eq("fpr_none", fpr_none(is_even, [1, 3, 5]), true)
    assert_eq("fpr_count", fpr_count(is_even, [1, 2, 3, 4]), 2)
    assert_eq("fpr_find_index", fpr_find_index(is_even, [1, 3, 4, 5]), 2)
    assert_eq("fpr_find_index none", fpr_find_index(is_even, [1, 3, 5]), -1)

    // freduce
    assert_eq("fr_foldl", fr_foldl(add2, 0, [1, 2, 3, 4]), 10)

    // fsortby
    let sorted = fs_sort_by(key_mod3, [5, 3, 4, 1, 6])
    assert_eq("fs_sort_by", list_eq(sorted, [3, 6, 4, 1, 5]), true)

    // ftakewhile
    assert_eq("ftw_take_while", list_eq(ftw_take_while(is_pos, [1, 2, -1, 3]), [1, 2]), true)
    assert_eq("ftw_drop_while", list_eq(ftw_drop_while(is_pos, [1, 2, -1, 3]), [-1, 3]), true)
    let sp = ftw_span(is_pos, [1, 2, -1, 3])
    assert_eq("ftw_span taken", list_eq(sp[0], [1, 2]), true)
    assert_eq("ftw_span dropped", list_eq(sp[1], [-1, 3]), true)

    // func
    assert_eq("f_identity", f_identity(5), 5)
    let composed = f_compose(inc, dbl)
    assert_eq("f_compose", composed(3), 7)

    // fzipwith
    assert_eq("fz_zip_with", list_eq(fz_zip_with(add2, [1, 2, 3], [10, 20]), [11, 22]), true)
    assert_eq("fz_zip_with3", list_eq(fz_zip_with3(add3, [1, 2, 3], [10, 20, 30], [100, 200]), [111, 222]), true)
    assert_eq("fz_zip_with_index", list_eq(fz_zip_with_index(add2, [10, 20, 30]), [10, 21, 32]), true)

    print("_functional_kat_test passed")
