// TRANSPARENCY: plain spawn + channel code — NO async keyword, NO sched_spawn/
// sched_run. Under NOVA_GREEN=1 this runs as green tasks multiplexed on ONE OS
// thread (main runs as a green task; spawn makes green tasks; receive() parks).
// With NOVA_GREEN unset it runs the classic way (OS-pool thread + blocking recv).
// The SAME source, both modes — that is the no-function-coloring promise.

let ch = channel()

fn producer(c)
  let i = 0
  while i < 5
    send(c, i * 10)
    i = i + 1

spawn producer(ch)

// main consumes; on an empty channel it blocks (OS) / parks (green) until the
// producer sends — works identically either way.
let sum = 0
let i = 0
while i < 5
  sum = sum + receive(ch)
  i = i + 1

assert(sum == 100, "spawn + channel coordinated (0+10+20+30+40)")
print("TRANSPARENT_OK sum=" + str(sum))
