import forge_inversions

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn joinl(xs: list) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + ","
        out = out + str(xs[i])
        i = i + 1
    out

fn main()
    let fails = 0

    // inversion counts
    fails = fails + expect("inv_sorted", str(count_inversions([1, 2, 3, 4])), "0")
    fails = fails + expect("inv_rev", str(count_inversions([4, 3, 2, 1])), "6")
    fails = fails + expect("inv_rev5", str(count_inversions([5, 4, 3, 2, 1])), "10")
    fails = fails + expect("inv_mix", str(count_inversions([2, 4, 1, 3, 5])), "3")
    fails = fails + expect("inv_dups", str(count_inversions([3, 1, 2, 1])), "4")
    fails = fails + expect("inv_single", str(count_inversions([7])), "0")
    fails = fails + expect("inv_empty", str(count_inversions([])), "0")
    fails = fails + expect("inv_two", str(count_inversions([2, 1])), "1")

    // merge sort (incl negatives + dups)
    fails = fails + expect("ms_basic", joinl(merge_sort([3, 1, 2])), "1,2,3")
    fails = fails + expect("ms_neg", joinl(merge_sort([5, 0 - 1, 3, 0 - 10, 0])), "-10,-1,0,3,5")
    fails = fails + expect("ms_dups", joinl(merge_sort([3, 1, 2, 1])), "1,1,2,3")
    fails = fails + expect("ms_rev", joinl(merge_sort([9, 7, 5, 3, 1])), "1,3,5,7,9")
    fails = fails + expect("ms_single", joinl(merge_sort([42])), "42")
    fails = fails + expect("ms_empty", joinl(merge_sort([])), "")

    // brute-force cross-check inversions on a fixed list
    let data = [5, 2, 8, 1, 9, 3, 7, 4, 6, 0]
    let bf = 0
    let a = 0
    while a < len(data)
        let b = a + 1
        while b < len(data)
            if data[a] > data[b]
                bf = bf + 1
            b = b + 1
        a = a + 1
    fails = fails + expect("inv_bruteforce", str(count_inversions(data)), str(bf))

    // kendall tau distance
    // identical order -> 0
    fails = fails + expect("kt_same", str(kendall_tau_distance([1, 2, 3, 4], [1, 2, 3, 4])), "0")
    // fully reversed -> n*(n-1)/2 = 6
    fails = fails + expect("kt_rev", str(kendall_tau_distance([4, 3, 2, 1], [1, 2, 3, 4])), "6")
    // one swap -> 1
    fails = fails + expect("kt_swap", str(kendall_tau_distance([1, 3, 2, 4], [1, 2, 3, 4])), "1")

    if fails == 0
        print("forge_inversions: all passed")
    else
        print("forge_inversions: " + str(fails) + " FAILED")
