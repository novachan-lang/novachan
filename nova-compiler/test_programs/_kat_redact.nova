// KAT LOCK-7 Phase 2: @redact -- a secret field must never leak into a LOG or a
// SERIALIZED payload. The threat is accidental disclosure: someone prints a whole
// struct for debugging, or returns it as JSON, and a password/token rides along.
//
// Scope, deliberately: str()/print() and to_json() are redacted. field_get() is NOT --
// that is a deliberate, named access to one field, not accidental bulk disclosure.
// Redacting it would break legitimate reflection while adding no protection (the
// attacker in this threat model is a careless log line, not the program itself).
type Creds
    user: string
    @redact token: string
    @redact api_key: string
    retries: int

fn main()
    let c = Creds("alice", "s3cr3t-token", "ak_live_9911", 3)
    let ok = 0
    let fail = 0

    // (1) str()/print() must not contain the secret
    let shown = str(c)
    print("shown: " + shown)
    if contains(shown, "s3cr3t-token") == false and contains(shown, "ak_live_9911") == false
        ok = ok + 1
        print("ok: str() hides both secrets")
    else
        fail = fail + 1
        print("FAIL: str() leaked a secret")

    // (2) the NON-secret fields must still render normally
    if contains(shown, "alice") and contains(shown, "3")
        ok = ok + 1
        print("ok: non-secret fields still render")
    else
        fail = fail + 1
        print("FAIL: redaction ate a non-secret field")

    // (3) to_json must not contain the secret either -- this is the one that ships
    //     over the wire, so a leak here is worse than a log leak
    let j = to_json(c)
    print("json: " + j)
    if contains(j, "s3cr3t-token") == false and contains(j, "ak_live_9911") == false
        ok = ok + 1
        print("ok: to_json hides both secrets")
    else
        fail = fail + 1
        print("FAIL: to_json leaked a secret")

    // (4) the KEY must survive, so the payload shape is unchanged for consumers
    if contains(j, "token") and contains(j, "api_key")
        ok = ok + 1
        print("ok: json keys preserved, only values masked")
    else
        fail = fail + 1
        print("FAIL: redaction removed the key, changing the payload shape")

    // (5) a deliberate named read still works -- redaction is about accidental
    //     bulk disclosure, not about making the field unreachable
    if field_get(c, "token") == "s3cr3t-token"
        ok = ok + 1
        print("ok: field_get still reaches the value deliberately")
    else
        fail = fail + 1
        print("FAIL: field_get was broken by redaction")

    print("ok=" + str(ok) + " fail=" + str(fail))
    if fail == 0
        print("KAT redact PASS")
    else
        print("KAT redact FAIL")
