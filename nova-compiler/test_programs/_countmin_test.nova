import std/sketch/countmin

// Check that got >= floor (never-underestimate invariant).
fn ge(label: string, got: int, floor: int)
    if got < floor
        print("FAIL " + label + ": got=" + str(got) + " want>=" + str(floor))
        exit(1)

// Check exact equality.
fn eq(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // --- KAT 1: basic structure ---
    let state = cm_new(64, 4)
    eq("width", cm_width(state), 64)
    eq("depth", cm_depth(state), 4)
    eq("total_init", cm_total(state), 0)

    // --- KAT 2: add apple 5 times then once more (6 total), banana 3 times ---
    cm_add_n(state, "apple", 5)
    cm_add_n(state, "banana", 3)
    cm_add(state, "apple")
    // apple total = 6, banana total = 3
    eq("total_after", cm_total(state), 9)

    // INVARIANT: never underestimates
    ge("apple_ge6", cm_estimate(state, "apple"), 6)
    ge("banana_ge3", cm_estimate(state, "banana"), 3)
    ge("unseen_ge0", cm_estimate(state, "unseen"), 0)

    // --- KAT 3: wide sketch gives exact results for small input ---
    let big = cm_new(1024, 4)
    cm_add_n(big, "alpha", 10)
    cm_add_n(big, "beta", 7)
    cm_add_n(big, "gamma", 3)
    ge("alpha_ge10", cm_estimate(big, "alpha"), 10)
    ge("beta_ge7", cm_estimate(big, "beta"), 7)
    ge("gamma_ge3", cm_estimate(big, "gamma"), 3)
    ge("delta_ge0", cm_estimate(big, "delta"), 0)
    eq("big_total", cm_total(big), 20)

    // --- KAT 4: determinism — two identical sketches give identical estimates ---
    let s1 = cm_new(64, 4)
    let s2 = cm_new(64, 4)
    cm_add_n(s1, "apple", 5)
    cm_add_n(s2, "apple", 5)
    cm_add_n(s1, "banana", 3)
    cm_add_n(s2, "banana", 3)
    cm_add(s1, "apple")
    cm_add(s2, "apple")
    let e1a = cm_estimate(s1, "apple")
    let e2a = cm_estimate(s2, "apple")
    eq("determinism_apple", e1a, e2a)
    let e1b = cm_estimate(s1, "banana")
    let e2b = cm_estimate(s2, "banana")
    eq("determinism_banana", e1b, e2b)

    // --- KAT 5: cm_add_n bulk ---
    let s3 = cm_new(128, 4)
    cm_add_n(s3, "hot", 100)
    let i = 0
    while i < 50
        cm_add(s3, "cold" + str(i))
        i = i + 1
    ge("hot_heavy", cm_estimate(s3, "hot"), 100)
    eq("s3_total", cm_total(s3), 150)

    // --- KAT 6: merge two sketches ---
    let ma = cm_new(64, 4)
    let mb = cm_new(64, 4)
    cm_add_n(ma, "foo", 4)
    cm_add_n(mb, "foo", 6)
    cm_merge(ma, mb)
    ge("merge_foo_ge10", cm_estimate(ma, "foo"), 10)
    eq("merge_total", cm_total(ma), 10)

    print("PASS _countmin_test")

main()
