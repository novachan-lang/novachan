import forge_prefixsum

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn joinl(xs: list) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + ","
        out = out + str(xs[i])
        i = i + 1
    out

fn main()
    let fails = 0

    // 1-D prefix
    let p = prefix_1d([2, 4, 6, 8])
    fails = fails + expect("prefix", joinl(p), "0,2,6,12,20")
    fails = fails + expect("rs_1_2", str(range_sum_1d(p, 1, 2)), "10")
    fails = fails + expect("rs_all", str(range_sum_1d(p, 0, 3)), "20")
    fails = fails + expect("rs_single", str(range_sum_1d(p, 2, 2)), "6")
    fails = fails + expect("rs_first", str(range_sum_1d(p, 0, 0)), "2")

    // 2-D prefix (3x3)
    let mat = []
    push(mat, [1, 2, 3])
    push(mat, [4, 5, 6])
    push(mat, [7, 8, 9])
    let pk = prefix_2d(mat)
    fails = fails + expect("sum_full", str(range_sum_2d(pk, 0, 0, 2, 2)), "45")
    fails = fails + expect("sum_br", str(range_sum_2d(pk, 1, 1, 2, 2)), "28")
    fails = fails + expect("sum_cell", str(range_sum_2d(pk, 0, 0, 0, 0)), "1")
    fails = fails + expect("sum_block", str(range_sum_2d(pk, 0, 1, 1, 2)), "16")
    fails = fails + expect("sum_row", str(range_sum_2d(pk, 1, 0, 1, 2)), "15")
    fails = fails + expect("sum_col", str(range_sum_2d(pk, 0, 2, 2, 2)), "18")

    // difference array: add 2 to [1,3], add 3 to [2,4], over n=5
    let d = diff_build(5)
    diff_add(d, 1, 3, 2)
    diff_add(d, 2, 4, 3)
    fails = fails + expect("diff", joinl(diff_apply(d, 5)), "0,2,5,5,3")

    // difference array: overlapping increments (interval coverage count)
    let d2 = diff_build(6)
    diff_add(d2, 0, 2, 1)
    diff_add(d2, 1, 4, 1)
    diff_add(d2, 3, 5, 1)
    fails = fails + expect("coverage", joinl(diff_apply(d2, 6)), "1,2,2,2,2,1")

    if fails == 0
        print("forge_prefixsum: all passed")
    else
        print("forge_prefixsum: " + str(fails) + " FAILED")
