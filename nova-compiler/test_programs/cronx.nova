fn _parse_field(s, min_val, max_val)
  if s == "*"
    let result = []
    let v = min_val
    while v <= max_val
      push(result, v)
      v = v + 1
    return result
  if contains(s, "/")
    let parts = split(s, "/")
    let step_r = parse_int_safe(parts[1])
    if not is_ok(step_r)
      return []
    let step = unwrap(step_r)
    let start = min_val
    if parts[0] != "*"
      let sr = parse_int_safe(parts[0])
      if is_ok(sr)
        start = unwrap(sr)
    let result = []
    let v = start
    while v <= max_val
      push(result, v)
      v = v + step
    return result
  if contains(s, "-")
    let parts = split(s, "-")
    let lo_r = parse_int_safe(parts[0])
    let hi_r = parse_int_safe(parts[1])
    if not is_ok(lo_r) or not is_ok(hi_r)
      return []
    let lo = unwrap(lo_r)
    let hi = unwrap(hi_r)
    let result = []
    let v = lo
    while v <= hi
      push(result, v)
      v = v + 1
    return result
  if contains(s, ",")
    let parts = split(s, ",")
    let result = []
    for p in parts
      let r = parse_int_safe(trim(p))
      if is_ok(r)
        push(result, unwrap(r))
    return result
  let r = parse_int_safe(s)
  if is_ok(r)
    return [unwrap(r)]
  []

fn cron_parse(expr)
  let fields = split(expr, " ")
  if len(fields) != 5
    return {}
  let result = {}
  result["minute"] = _parse_field(fields[0], 0, 59)
  result["hour"] = _parse_field(fields[1], 0, 23)
  result["day"] = _parse_field(fields[2], 1, 31)
  result["month"] = _parse_field(fields[3], 1, 12)
  result["weekday"] = _parse_field(fields[4], 0, 6)
  result

fn cron_matches(parsed, minute, hour, day, month, weekday)
  let mins = parsed["minute"]
  let hrs = parsed["hour"]
  let days = parsed["day"]
  let months = parsed["month"]
  let wdays = parsed["weekday"]
  contains(mins, minute) and contains(hrs, hour) and contains(days, day) and contains(months, month) and contains(wdays, weekday)

fn cron_describe(expr)
  let fields = split(expr, " ")
  if len(fields) != 5
    return "invalid cron expression"
  let desc = ""
  if fields[0] == "*" and fields[1] == "*"
    desc = "every minute"
  else if fields[0] == "0" and fields[1] == "*"
    desc = "every hour"
  else if fields[0] == "0" and fields[1] != "*"
    desc = "daily at " + fields[1] + ":00"
  else
    desc = "at " + fields[1] + ":" + fields[0]
  desc

fn main()
  let every_min = cron_parse("* * * * *")
  assert(len(every_min["minute"]) == 60, "every minute = 60")
  assert(len(every_min["hour"]) == 24, "every hour = 24")
  assert(cron_matches(every_min, 30, 14, 5, 6, 3) == 1, "matches any")

  let noon = cron_parse("0 12 * * *")
  assert(len(noon["minute"]) == 1, "noon minute=1")
  assert(noon["minute"][0] == 0, "noon minute=0")
  assert(noon["hour"][0] == 12, "noon hour=12")
  assert(cron_matches(noon, 0, 12, 1, 1, 0) == 1, "matches noon")
  assert(cron_matches(noon, 30, 12, 1, 1, 0) == 0, "not 12:30")

  let step = cron_parse("*/15 * * * *")
  assert(len(step["minute"]) == 4, "every 15m = 4 slots")
  assert(step["minute"][0] == 0, "first 0")
  assert(step["minute"][1] == 15, "second 15")
  assert(step["minute"][3] == 45, "fourth 45")

  let range_c = cron_parse("0 9-17 * * 1-5")
  assert(len(range_c["hour"]) == 9, "9-17 = 9 hours")
  assert(len(range_c["weekday"]) == 5, "mon-fri = 5 days")
  assert(cron_matches(range_c, 0, 10, 15, 6, 2) == 1, "tuesday 10am")
  assert(cron_matches(range_c, 0, 10, 15, 6, 0) == 0, "sunday 10am")

  let csv = cron_parse("0,30 * * * *")
  assert(len(csv["minute"]) == 2, "0,30 = 2")
  assert(csv["minute"][0] == 0, "first 0")
  assert(csv["minute"][1] == 30, "second 30")

  let d1 = cron_describe("* * * * *")
  assert(d1 == "every minute", "describe every min")
  let d2 = cron_describe("0 12 * * *")
  assert(d2 == "daily at 12:00", "describe noon")

  print("cronx: all passed")
