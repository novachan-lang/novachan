import forge_consensus_raft

fn main()
    let r = raft_new("node-1", 5)
    assert(raft_state(r) == "follower", "starts follower")
    assert(raft_term(r) == 0, "term 0")
    assert(raft_is_leader(r) == 0, "not leader")

    r = raft_start_election(r)
    assert(raft_state(r) == "candidate", "candidate")
    assert(raft_term(r) == 1, "term 1")

    r = raft_receive_vote(r)
    assert(raft_state(r) == "candidate", "still candidate at 2 votes")
    r = raft_receive_vote(r)
    assert(raft_state(r) == "leader", "leader at 3 votes (majority)")
    assert(raft_is_leader(r) == 1, "is leader")
    assert(raft_leader(r) == "node-1", "leader is node-1")

    r = raft_append_entry(r, "SET x=1")
    r = raft_append_entry(r, "SET y=2")
    assert(raft_log_length(r) == 2, "2 log entries")

    r = raft_commit(r, 2)
    assert(raft_commit_index(r) == 2, "committed to 2")

    r = raft_step_down(r, 2, "node-3")
    assert(raft_state(r) == "follower", "stepped down")
    assert(raft_term(r) == 2, "term 2")
    assert(raft_leader(r) == "node-3", "new leader")

    r = raft_append_entry(r, "should not add")
    assert(raft_log_length(r) == 2, "follower cant append")

    print("CONSENSUS-RAFT KAT PASS")
