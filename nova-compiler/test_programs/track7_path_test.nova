import path

fn main()
    // Join paths
    let p = path.path_join(["usr", "local", "bin"])
    if find(p, "usr") < 0 or find(p, "bin") < 0
        print("FAIL: path_join missing components")
        exit(1)

    // Dirname / basename
    let dir = path.path_dirname("foo/bar/baz.txt")
    assert_eq(dir, "foo/bar")
    let base = path.path_basename("foo/bar/baz.txt")
    assert_eq(base, "baz.txt")

    // Extension
    let ext = path.path_extension("file.tar.gz")
    assert_eq(ext, ".gz")
    let no_ext = path.path_extension("Makefile")
    assert_eq(no_ext, "")

    // Stem
    let stem = path.path_stem("archive.tar.gz")
    assert_eq(stem, "archive.tar")

    // Normalize
    let norm = path.path_normalize("a/b/../c/./d")
    assert_eq(norm, "a/c/d")

    // Is absolute
    assert_eq(path.path_is_absolute("/usr/bin"), true)
    assert_eq(path.path_is_relative("src/main.nova"), true)

    // Split
    let parts = path.path_split("a/b/c")
    assert_eq(len(parts), 3)
    assert_eq(parts[0], "a")
    assert_eq(parts[2], "c")

    // With extension
    let changed = path.path_with_extension("file.txt", ".md")
    assert_eq(changed, "file.md")

    print("TRACK 7 PATH TEST PASSED")
