// Benchmark: Type inference impact
// This exercises integer arithmetic in tight loops — the exact case
// where type inference turns nova_rt_add into add i64

fn fib(n: int) -> int
    if n <= 1
        return n
    return fib(n - 1) + fib(n - 2)

fn sum_loop(n: int) -> int
    let total = 0
    let i = 0
    while i < n
        total = total + i
        i = i + 1
    return total

fn main_bench()
    let t0 = clock_ns()
    let r1 = fib(30)
    let t1 = clock_ns()
    let r2 = sum_loop(10000000)
    let t2 = clock_ns()

    let fib_ms = (t1 - t0) / 1000000
    let sum_ms = (t2 - t1) / 1000000

    print("fib(35)       = " + str(r1) + " in " + str(fib_ms) + " ms")
    print("sum(100M)     = " + str(r2) + " in " + str(sum_ms) + " ms")

main_bench()
