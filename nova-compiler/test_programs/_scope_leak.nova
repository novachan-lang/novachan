// _scope_leak.nova -- ORACLE for the scope-exit RC campaign (NOVA_DESIGN/SCOPE_EXIT_RC_DESIGN.md).
// work() allocates non-arena, non-reassigned function-LOCAL temporaries: a concat string `s`,
// a fresh-element list `parts` (split), and a borrowed element `tag` (parts[0]). None escape;
// all should be reclaimed at scope exit. Today they LEAK (no scope-exit drop).
//   BASELINE (2026-06-15, HEAD ~01597c1): scope_exit_leak delta=8000 over 2000 calls (~4 obj/call:
//   string + list + 2 substrings), IDENTICAL flag-off and flag-on NOVA_T8_FULLRC (FULLRC only does
//   the reassignment-drop, which does not fire here -- nothing is reassigned).
// SUCCESS for the scope-exit RC (NOVA_T8_SCOPE): this delta must drop toward ~0, while remaining
// ASAN-clean (the borrowed `tag` aliases a `parts` element, so dropping must be alias-counted --
// this is exactly the iter-88 UAF class the design must handle soundly).
fn work(n)
    let s = "item-" + str(n)
    let parts = split(s, "-")
    let tag = parts[0]
    let m = len(parts) + len(tag)
    return m
fn main()
    let b = live_count()
    let acc = 0
    let i = 0
    while i < 2000
        acc = acc + work(i)
        i = i + 1
    print("scope_exit_leak delta=" + str(live_count() - b) + " acc=" + str(acc))
