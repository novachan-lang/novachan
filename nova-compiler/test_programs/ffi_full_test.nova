// Extended FFI: float return, string args, void return, int32 return

extern fn my_c_add(a: int, b: int) -> int
extern fn my_c_sqrt(x: float) -> float
extern fn my_c_strlen(s: string) -> int
extern fn my_c_strchr_idx(s: string, ch: int) -> int
extern fn my_c_log_msg(s: string) -> void
extern fn my_c_count_calls() -> int

fn main()
    let a = unsafe my_c_add(40, 2)
    print("add(40, 2) =")
    print(a)

    let s = unsafe my_c_sqrt(int_to_float(16))
    print("sqrt(16.0) bits =")
    print(s)
    print("as float =")
    print(s)

    let l = unsafe my_c_strlen("hello world")
    print("strlen(\"hello world\") =")
    print(l)

    let idx = unsafe my_c_strchr_idx("hello", ord("l"))
    print("strchr(\"hello\", 'l') idx =")
    print(idx)

    unsafe my_c_log_msg("logging from NOVA via FFI void return")
    let n = unsafe my_c_count_calls()
    print("count_calls after one log =")
    print(n)

    unsafe my_c_log_msg("another log")
    let n2 = unsafe my_c_count_calls()
    print("count_calls after two logs =")
    print(n2)
