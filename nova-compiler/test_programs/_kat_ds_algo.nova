// _kat_ds_algo — combined KAT for 6 new pure-NOVA stdlib modules:
//   std/collections/binary_trie.nova      (bxt_)
//   std/collections/fibonacci_heap.nova   (fh_)
//   std/collections/rose_tree.nova        (rst_)
//   std/algo/traveling_salesman.nova      (tsp_)
//   std/algo/longest_increasing_path.nova (lip_)
//   std/data/vcard.nova                   (vcd_)

import std/collections/binary_trie
import std/collections/fibonacci_heap
import std/collections/rose_tree
import std/algo/traveling_salesman
import std/algo/longest_increasing_path
import std/data/vcard

fn ck(name, got, want)
    if str(got) != str(want)
        print("FAIL " + name + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("ok " + name)

// ---------------------------------------------------------------------
// binary_trie
// ---------------------------------------------------------------------
fn test_binary_trie()
    let t = bxt_new()
    ck("bxt_size_empty", bxt_size(t), 0)
    ck("bxt_max_xor_empty", bxt_max_xor(t, 5), -1)
    ck("bxt_contains_empty", bxt_contains(t, 5), false)

    bxt_insert(t, 3)
    bxt_insert(t, 10)
    bxt_insert(t, 5)
    bxt_insert(t, 25)
    bxt_insert(t, 2)
    bxt_insert(t, 8)
    ck("bxt_size_6", bxt_size(t), 6)

    ck("bxt_contains_3", bxt_contains(t, 3), true)
    ck("bxt_contains_10", bxt_contains(t, 10), true)
    ck("bxt_contains_absent", bxt_contains(t, 99), false)

    // classic max-xor-pair example: set {3,10,5,25,2,8} -> best pair (5,25) = 28
    ck("bxt_max_xor_5", bxt_max_xor(t, 5), 28)
    ck("bxt_max_xor_25", bxt_max_xor(t, 25), 28)

    // duplicates: insert 3 again, contains still true, size increments
    bxt_insert(t, 3)
    ck("bxt_size_dup", bxt_size(t), 7)

    // remove one occurrence of 3: still 1 left (dup), still contains
    bxt_remove(t, 3)
    ck("bxt_size_after_remove_dup", bxt_size(t), 6)
    ck("bxt_contains_after_remove_dup", bxt_contains(t, 3), true)

    // remove remaining occurrence of 3: now gone
    bxt_remove(t, 3)
    ck("bxt_size_after_remove_all", bxt_size(t), 5)
    ck("bxt_contains_after_remove_all", bxt_contains(t, 3), false)

    // remove absent value: no-op
    bxt_remove(t, 999)
    ck("bxt_size_noop_remove", bxt_size(t), 5)

    // fresh trie: single element, max_xor with itself pattern
    let t2 = bxt_new()
    bxt_insert(t2, 0)
    ck("bxt_max_xor_self0", bxt_max_xor(t2, 0), 0)
    bxt_insert(t2, 15)
    ck("bxt_max_xor_0_15", bxt_max_xor(t2, 0), 15)
    ck("bxt_max_xor_15_0", bxt_max_xor(t2, 15), 15)

// ---------------------------------------------------------------------
// fibonacci_heap
// ---------------------------------------------------------------------
fn test_fibonacci_heap()
    let h = fh_new()
    ck("fh_is_empty_new", fh_is_empty(h), true)
    ck("fh_size_new", fh_size(h), 0)

    let _id5 = fh_insert(h, 5, "5")
    let _id3 = fh_insert(h, 3, "3")
    let _id8 = fh_insert(h, 8, "8")
    let _id1 = fh_insert(h, 1, "1")
    let _id9 = fh_insert(h, 9, "9")
    let _id2 = fh_insert(h, 2, "2")
    let _id7 = fh_insert(h, 7, "7")
    ck("fh_size_7", fh_size(h), 7)
    ck("fh_min_key_1", fh_min_key(h), 1)
    ck("fh_min_val_1", fh_min_val(h), "1")

    // extract in ascending order: 1,2,3,5,7,8,9
    ck("fh_extract_1", fh_extract_min(h), "1")
    ck("fh_extract_2", fh_extract_min(h), "2")
    ck("fh_extract_3", fh_extract_min(h), "3")
    ck("fh_size_after_3extracts", fh_size(h), 4)
    ck("fh_extract_5", fh_extract_min(h), "5")
    ck("fh_extract_7", fh_extract_min(h), "7")
    ck("fh_extract_8", fh_extract_min(h), "8")
    ck("fh_extract_9", fh_extract_min(h), "9")
    ck("fh_is_empty_after_drain", fh_is_empty(h), true)

    // decrease-key test
    let h2 = fh_new()
    let _a = fh_insert(h2, 10, "ten")
    let _b = fh_insert(h2, 20, "twenty")
    let c = fh_insert(h2, 30, "thirty")
    ck("fh_min_before_decrease", fh_min_val(h2), "ten")
    fh_decrease_key(h2, c, 5)
    ck("fh_min_after_decrease", fh_min_val(h2), "thirty")
    ck("fh_min_key_after_decrease", fh_min_key(h2), 5)
    ck("fh_extract_after_decrease", fh_extract_min(h2), "thirty")
    ck("fh_extract_ten_next", fh_extract_min(h2), "ten")
    ck("fh_extract_twenty_last", fh_extract_min(h2), "twenty")

    // decrease-key no-op when newkey > current key
    let h3 = fh_new()
    let x = fh_insert(h3, 5, "x")
    fh_decrease_key(h3, x, 50)
    ck("fh_decrease_noop_keeps_key", fh_min_key(h3), 5)

    // fh_delete test
    let h4 = fh_new()
    let _p = fh_insert(h4, 1, "p")
    let q = fh_insert(h4, 2, "q")
    let _r = fh_insert(h4, 3, "r")
    fh_delete(h4, q)
    ck("fh_size_after_delete", fh_size(h4), 2)
    ck("fh_extract_after_delete_1", fh_extract_min(h4), "p")
    ck("fh_extract_after_delete_2", fh_extract_min(h4), "r")

    // larger randomized-ish sequence: sorted-extraction invariant, with
    // interleaved decrease-key calls to force consolidate + cascading cut.
    let h5 = fh_new()
    let keys = [55, 3, 41, 17, 9, 62, 28, 4, 71, 13, 36, 8, 50, 21, 1]
    let ids = []
    let ki = 0
    while ki < len(keys)
        let kid = fh_insert(h5, keys[ki], keys[ki])
        push(ids, kid)
        ki = ki + 1
    // pop a few to force consolidate
    let popped1 = fh_extract_min(h5)
    ck("fh_big_pop1", popped1, 1)
    let popped2 = fh_extract_min(h5)
    ck("fh_big_pop2", popped2, 3)
    // decrease key of the node holding 71 down to 0 (still in heap; forces cut).
    // Only the priority key changes -- the stored val stays 71 -- so the next
    // extract must yield val 71 (now at the front of the order).
    fh_decrease_key(h5, ids[8], 0)
    ck("fh_big_min_after_decrease", fh_min_key(h5), 0)
    let popped3 = fh_extract_min(h5)
    ck("fh_big_pop3_is_decreased", popped3, 71)
    // drain the rest, verifying non-decreasing order
    let prev = -1
    let ok = true
    let cnt = 0
    while fh_is_empty(h5) == false
        let v = fh_extract_min(h5)
        if v < prev
            ok = false
        prev = v
        cnt = cnt + 1
    ck("fh_big_drain_sorted", ok, true)
    ck("fh_big_drain_count", cnt, 12)

// ---------------------------------------------------------------------
// rose_tree
// ---------------------------------------------------------------------
fn test_rose_tree()
    let root = rst_new("root")
    ck("rst_val_root", rst_val(root), "root")
    ck("rst_is_leaf_new", rst_is_leaf(root), true)
    ck("rst_count_single", rst_count(root), 1)
    ck("rst_height_single", rst_height(root), 0)

    let a = rst_add_child(root, "a")
    let b = rst_add_child(root, "b")
    let _c = rst_add_child(root, "c")
    ck("rst_child_count_root", rst_child_count(root), 3)
    ck("rst_is_leaf_root_after", rst_is_leaf(root), false)

    let a1 = rst_add_child(a, "a1")
    let _a2 = rst_add_child(a, "a2")
    let a1x = rst_add_child(a1, "a1x")

    ck("rst_count_total", rst_count(root), 7)
    ck("rst_height_total", rst_height(root), 3)
    ck("rst_child_count_a", rst_child_count(a), 2)
    ck("rst_is_leaf_a1x", rst_is_leaf(a1x), true)
    ck("rst_is_leaf_b", rst_is_leaf(b), true)

    let dfsOrder = rst_dfs(root)
    ck("rst_dfs_len", len(dfsOrder), 7)
    ck("rst_dfs_first", dfsOrder[0], "root")
    ck("rst_dfs_second", dfsOrder[1], "a")
    ck("rst_dfs_third", dfsOrder[2], "a1")
    ck("rst_dfs_fourth", dfsOrder[3], "a1x")
    ck("rst_dfs_last", dfsOrder[6], "c")

    let bfsOrder = rst_bfs(root)
    ck("rst_bfs_len", len(bfsOrder), 7)
    ck("rst_bfs_first", bfsOrder[0], "root")
    ck("rst_bfs_second", bfsOrder[1], "a")
    ck("rst_bfs_third", bfsOrder[2], "b")
    ck("rst_bfs_fourth", bfsOrder[3], "c")
    ck("rst_bfs_fifth", bfsOrder[4], "a1")

    let found = rst_find(root, "a1x")
    ck("rst_find_found", rst_found(found), true)
    ck("rst_find_val", rst_val(found), "a1x")

    let notFound = rst_find(root, "zzz")
    ck("rst_find_not_found", rst_found(notFound), false)

// ---------------------------------------------------------------------
// traveling_salesman
// ---------------------------------------------------------------------
fn test_traveling_salesman()
    // 4-city square perimeter: 0=(0,0) 1=(10,0) 2=(10,10) 3=(0,10)
    let dist = [
        [0, 10, 20, 10],
        [10, 0, 10, 20],
        [20, 10, 0, 10],
        [10, 20, 10, 0]
    ]
    let sol = tsp_solve(dist)
    ck("tsp_solve_cost", sol["tsp_cost"], 40)
    ck("tsp_solve_path_len", len(sol["tsp_path"]), 5)
    ck("tsp_solve_path_start", sol["tsp_path"][0], 0)
    ck("tsp_solve_path_end", sol["tsp_path"][4], 0)

    let nn = tsp_nn(dist)
    ck("tsp_nn_cost", nn["tsp_cost"], 40)
    ck("tsp_nn_path_len", len(nn["tsp_path"]), 5)

    // single city: trivial
    let dist1 = [[0]]
    let sol1 = tsp_solve(dist1)
    ck("tsp_solve_single_cost", sol1["tsp_cost"], 0)
    ck("tsp_solve_single_path", sol1["tsp_path"][0], 0)

    // asymmetric 3-city triangle where optimal must be found by DP
    let dist3 = [
        [0, 1, 100],
        [1, 0, 1],
        [100, 1, 0]
    ]
    let sol3 = tsp_solve(dist3)
    // best cycle 0->1->2->0 = 1+1+100=102, or 0->2->1->0=100+1+1=102 (symmetric here)
    ck("tsp_solve_tri_cost", sol3["tsp_cost"], 102)

    // exact optimum must never exceed the nn heuristic on same input
    ck("tsp_exact_le_nn", sol["tsp_cost"] <= nn["tsp_cost"], true)

// ---------------------------------------------------------------------
// longest_increasing_path
// ---------------------------------------------------------------------
fn test_longest_increasing_path()
    // classic LC329 example 1: answer 4  (path 1->2->6->9)
    let g1 = [
        [9, 9, 4],
        [6, 6, 8],
        [2, 1, 1]
    ]
    ck("lip_solve_ex1", lip_solve(g1), 4)
    let p1 = lip_path(g1)
    ck("lip_path_ex1_len", len(p1), 4)

    // classic LC329 example 2: answer 4 (path 3->4->5->6)
    let g2 = [
        [3, 4, 5],
        [3, 2, 6],
        [2, 2, 1]
    ]
    ck("lip_solve_ex2", lip_solve(g2), 4)

    // single cell
    let g3 = [[7]]
    ck("lip_solve_single", lip_solve(g3), 1)
    let p3 = lip_path(g3)
    ck("lip_path_single_len", len(p3), 1)

    // strictly increasing row: 1x5
    let g4 = [[1, 2, 3, 4, 5]]
    ck("lip_solve_row", lip_solve(g4), 5)

    // all equal values: no strict increase possible anywhere -> 1
    let g5 = [
        [5, 5],
        [5, 5]
    ]
    ck("lip_solve_flat", lip_solve(g5), 1)

    // verify a returned path is actually strictly increasing and adjacent
    let path1 = lip_path(g1)
    let validPath = true
    let vi = 1
    while vi < len(path1)
        let prevCell = path1[vi - 1]
        let curCell = path1[vi]
        let pr = prevCell[0]
        let pc = prevCell[1]
        let cr = curCell[0]
        let cc = curCell[1]
        let manhattan = (cr - pr) * (cr - pr) + (cc - pc) * (cc - pc)
        if manhattan != 1
            validPath = false
        let g1pr = g1[pr]
        let g1cr = g1[cr]
        if g1cr[cc] <= g1pr[pc]
            validPath = false
        vi = vi + 1
    ck("lip_path_ex1_valid_adjacency_and_increasing", validPath, true)

// ---------------------------------------------------------------------
// vcard
// ---------------------------------------------------------------------
fn test_vcard()
    let text = "BEGIN:VCARD\nVERSION:3.0\nFN:John Doe\nN:Doe;John;;;\nTEL:+1-555-1234\nEMAIL:john@example.com\nORG:Acme Inc\nEND:VCARD\nBEGIN:VCARD\nVERSION:3.0\nFN:Jane Smith\nTEL;TYPE=CELL:+1-555-9999\nEMAIL:jane@example.com\nEND:VCARD"
    let contacts = vcd_parse(text)
    ck("vcd_count", vcd_count(contacts), 2)

    let c0 = contacts[0]
    ck("vcd_get_fn0", vcd_get(c0, "FN"), "John Doe")
    ck("vcd_get_n0", vcd_get(c0, "N"), "Doe;John;;;")
    ck("vcd_get_tel0", vcd_get(c0, "TEL"), "+1-555-1234")
    ck("vcd_get_email0", vcd_get(c0, "EMAIL"), "john@example.com")
    ck("vcd_get_org0", vcd_get(c0, "ORG"), "Acme Inc")
    ck("vcd_get_missing0", vcd_get(c0, "NICKNAME"), "")

    let c1 = contacts[1]
    ck("vcd_get_fn1", vcd_get(c1, "FN"), "Jane Smith")
    // TEL;TYPE=CELL:... -> base property "TEL" parsed out, param dropped
    ck("vcd_get_tel1_stripped_param", vcd_get(c1, "TEL"), "+1-555-9999")
    ck("vcd_get_org1_absent", vcd_get(c1, "ORG"), "")

    let built = vcd_build(c0)
    let reparsed = vcd_parse(built)
    ck("vcd_roundtrip_count", vcd_count(reparsed), 1)
    let rc = reparsed[0]
    ck("vcd_roundtrip_fn", vcd_get(rc, "FN"), "John Doe")
    ck("vcd_roundtrip_tel", vcd_get(rc, "TEL"), "+1-555-1234")
    ck("vcd_roundtrip_email", vcd_get(rc, "EMAIL"), "john@example.com")
    ck("vcd_roundtrip_org", vcd_get(rc, "ORG"), "Acme Inc")

    // empty input -> no contacts
    let empty = vcd_parse("")
    ck("vcd_parse_empty", vcd_count(empty), 0)

    // contact missing every optional field still builds valid BEGIN/END shell
    let bare = {}
    let bareText = vcd_build(bare)
    let bareParsed = vcd_parse(bareText)
    ck("vcd_bare_roundtrip_count", vcd_count(bareParsed), 1)
    ck("vcd_bare_fn_absent", vcd_get(bareParsed[0], "FN"), "")

fn main()
    test_binary_trie()
    test_fibonacci_heap()
    test_rose_tree()
    test_traveling_salesman()
    test_longest_increasing_path()
    test_vcard()
    print("ALL PASS")

main()
