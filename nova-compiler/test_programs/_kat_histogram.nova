import forge_histogram

fn main()
    let h = hist_new(10)
    h = hist_record(h, 5)
    h = hist_record(h, 12)
    h = hist_record(h, 15)
    h = hist_record(h, 25)
    assert(hist_count(h) == 4, "4 records")
    assert(hist_mean(h) == 14, "mean 14")

    let mn = hist_min(h)
    assert(is_ok(mn), "min ok")
    assert(unwrap(mn) == 5, "min=5")

    let mx = hist_max(h)
    assert(is_ok(mx), "max ok")
    assert(unwrap(mx) == 25, "max=25")

    assert(hist_bucket_count(h, 0) == 1, "bucket 0 has 1")
    assert(hist_bucket_count(h, 1) == 2, "bucket 1 has 2")
    assert(hist_bucket_count(h, 2) == 1, "bucket 2 has 1")

    let empty = hist_new(10)
    let bad = hist_min(empty)
    assert(is_err(bad), "empty min err")

    print("HISTOGRAM KAT PASS")
