import std/vector/vec_lattice

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // KAT 1: vl_det([[1,0],[0,1]]) = 1
    cki("det_identity_2", vl_det([[1, 0], [0, 1]]), 1)

    // KAT 2: vl_det([[2,1],[1,1]]) = 2*1 - 1*1 = 1
    cki("det_2x2_unimod", vl_det([[2, 1], [1, 1]]), 1)

    // KAT 3: vl_det([[2,0],[0,2]]) = 4
    cki("det_2x2_scale", vl_det([[2, 0], [0, 2]]), 4)

    // KAT 4: vl_is_unimodular([[2,1],[1,1]]) = true (det=1)
    ckb("unimod_true", vl_is_unimodular([[2, 1], [1, 1]]), true)

    // KAT 5: vl_is_unimodular([[2,0],[0,2]]) = false (det=4)
    ckb("unimod_false", vl_is_unimodular([[2, 0], [0, 2]]), false)

    // KAT 6: vl_det([[1,2,3],[0,1,4],[5,6,0]]) = 1
    // det = 1*(1*0-4*6) - 2*(0*0-4*5) + 3*(0*6-1*5)
    //     = 1*(-24) - 2*(-20) + 3*(-5)
    //     = -24 + 40 - 15 = 1
    cki("det_3x3", vl_det([[1, 2, 3], [0, 1, 4], [5, 6, 0]]), 1)

    // KAT 7: vl_abs_det([[0,1],[1,0]]) = 1 (det = 0*0-1*1 = -1, |det|=1)
    cki("abs_det_swap", vl_abs_det([[0, 1], [1, 0]]), 1)

    // KAT 8: vl_det([[0,1],[1,0]]) = -1 (odd permutation)
    cki("det_swap_signed", vl_det([[0, 1], [1, 0]]), -1)

    // KAT 9: singular matrix — det = 0
    cki("det_singular", vl_det([[1, 2], [2, 4]]), 0)

    // KAT 10: 1x1 matrix
    cki("det_1x1", vl_det([[7]]), 7)

    // KAT 11: negative entries
    // det([[-2,1],[3,-1]]) = (-2)*(-1) - 1*3 = 2 - 3 = -1
    cki("det_negative", vl_det([[-2, 1], [3, -1]]), -1)

    // KAT 12: unimodular with det=-1 is still unimodular
    ckb("unimod_neg1", vl_is_unimodular([[0, 1], [1, 0]]), true)

    print("PASS _vec_lattice_test")
