import forge_ip_reputation

fn main()
    let r = ipr_new(10)
    r = ipr_report(r, "192.168.1.1", 3)
    r = ipr_report(r, "192.168.1.1", 4)
    r = ipr_report(r, "10.0.0.1", 2)
    assert(ipr_ip_count(r) == 2, "2 IPs")

    let s = ipr_score(r, "192.168.1.1")
    assert(is_ok(s), "score ok")
    assert(unwrap(s) == 7, "score=7")

    let c1 = ipr_check(r, "192.168.1.1")
    assert(is_ok(c1), "allowed")
    assert(ipr_is_blocked(r, "192.168.1.1") == 0, "not blocked")

    r = ipr_report(r, "192.168.1.1", 5)
    let c2 = ipr_check(r, "192.168.1.1")
    assert(is_err(c2), "blocked")
    assert(ipr_is_blocked(r, "192.168.1.1") == 1, "blocked now")
    assert(ipr_block_count(r) == 1, "1 block")

    let c3 = ipr_check(r, "unknown.ip")
    assert(is_ok(c3), "unknown=allowed")

    assert(ipr_total_checks(r) == 3, "3 checks")

    print("IP-REPUTATION KAT PASS")
