fn sumTo(n)
    total = 0
    i = 1
    while i <= n
        total += i
        i += 1
    total

fn countdown(n)
    while n > 0
        print(n)
        n -= 1
    print(0)

fn collatzSteps(n)
    steps = 0
    while n != 1
        if n % 2 == 0
            n = n / 2
        else
            n = n * 3 + 1
        steps += 1
    steps

print(sumTo(100))
countdown(5)
print(collatzSteps(27))
