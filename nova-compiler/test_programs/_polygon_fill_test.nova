import std/raster/polygon_fill

fn _ck_i(label: string, got: int, want: int)
    if got != want
        print("FAIL polygon_fill " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn _ck_b(label: string, got: bool, want: bool)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL polygon_fill " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

// _pts_has — check whether point [x,y] appears in a list of points.
fn _pts_has(pts: list, x: int, y: int) -> bool
    let n = len(pts)
    let i = 0
    let found = false
    while i < n
        let px = pts[i][0]
        let py = pts[i][1]
        if px == x and py == y
            found = true
        i = i + 1
    found

fn main()
    // --- KAT 1: pf_bbox ---
    let tri_verts = [[1,2],[5,3],[3,7]]
    let bb = pf_bbox(tri_verts)
    _ck_i("bbox_xmin", bb[0], 1)
    _ck_i("bbox_ymin", bb[1], 2)
    _ck_i("bbox_xmax", bb[2], 5)
    _ck_i("bbox_ymax", bb[3], 7)

    // --- KAT 2: pf_bbox square ---
    let sq44 = [[0,0],[4,0],[4,4],[0,4]]
    let bb2 = pf_bbox(sq44)
    _ck_i("bbox_sq_xmin", bb2[0], 0)
    _ck_i("bbox_sq_ymin", bb2[1], 0)
    _ck_i("bbox_sq_xmax", bb2[2], 4)
    _ck_i("bbox_sq_ymax", bb2[3], 4)

    // --- KAT 3: pf_contains — 4x4 square (0..4 exclusive) ---
    // interior point
    _ck_b("contains_22", pf_contains(sq44, 2, 2), true)
    // outside to the right
    _ck_b("contains_55", pf_contains(sq44, 5, 5), false)
    // outside above
    _ck_b("contains_out_above", pf_contains(sq44, 2, 5), false)
    // outside to the left
    _ck_b("contains_out_left", pf_contains(sq44, -1, 2), false)

    // --- KAT 4: pf_contains on a small 0..3 square ---
    let sq33 = [[0,0],[3,0],[3,3],[0,3]]
    _ck_b("contains_sq33_11", pf_contains(sq33, 1, 1), true)
    _ck_b("contains_sq33_out", pf_contains(sq33, 4, 4), false)

    // --- KAT 5: pf_area_pixels on 3x3 square [[0,0],[3,0],[3,3],[0,3]] ---
    // scanline fill: y in [0,3), x in [0,3) = 9 pixels
    let area3 = pf_area_pixels(sq33)
    _ck_i("area_sq33", area3, 9)

    // --- KAT 6: pf_area_pixels on 4x4 square [[0,0],[4,0],[4,4],[0,4]] ---
    // y in [0,4), x in [0,4) = 16 pixels
    let area4 = pf_area_pixels(sq44)
    _ck_i("area_sq44", area4, 16)

    // --- KAT 7: pf_fill on sq33 — check specific points are filled ---
    let pts33 = pf_fill(sq33)
    _ck_b("fill_sq33_has_00", _pts_has(pts33, 0, 0), true)
    _ck_b("fill_sq33_has_11", _pts_has(pts33, 1, 1), true)
    _ck_b("fill_sq33_has_22", _pts_has(pts33, 2, 2), true)
    // (3,3) is outside scanline fill (y<3 excluded y=3)
    _ck_b("fill_sq33_no_33", _pts_has(pts33, 3, 3), false)

    // --- KAT 8: triangle [[0,0],[4,0],[0,4]] ---
    // interior [1,1] should be filled; [3,3] outside hypotenuse should not
    let tri = [[0,0],[4,0],[0,4]]
    let tri_pts = pf_fill(tri)
    _ck_b("fill_tri_has_11", _pts_has(tri_pts, 1, 1), true)
    _ck_b("fill_tri_no_33", _pts_has(tri_pts, 3, 3), false)
    // total pixels: y=0→4, y=1→3, y=2→2, y=3→1 = 10
    _ck_i("fill_tri_count", len(tri_pts), 10)

    // --- KAT 9: pf_edges count ---
    let edges = pf_edges(sq33)
    _ck_i("edges_count", len(edges), 4)

    // --- KAT 10: pf_fill_to_surface ---
    // make a 5x5 surface filled with 0, fill a 3x3 square with value 7
    let surf = {}
    let spx = []
    let si = 0
    while si < 25
        push(spx, 0)
        si = si + 1
    surf["w"] = 5
    surf["h"] = 5
    surf["px"] = spx
    pf_fill_to_surface(surf, sq33, 7)
    // interior pixel at (1,1) should be 7
    let surf_px = surf["px"]
    let idx11 = 1 * 5 + 1
    let idx44 = 4 * 5 + 4
    _ck_i("surf_fill_11", surf_px[idx11], 7)
    // pixel (4,4) untouched
    _ck_i("surf_fill_44_untouched", surf_px[idx44], 0)

    // --- KAT 11: pf_scanline_spans on 3x3 square at y=1 ---
    // two crossings at x=0 and x=3 → span [0,3] → pixels 0,1,2
    let spans1 = pf_scanline_spans(sq33, 1)
    _ck_i("spans_sq33_y1_count", len(spans1), 1)
    _ck_i("spans_sq33_y1_lo", spans1[0][0], 0)
    _ck_i("spans_sq33_y1_hi", spans1[0][1], 3)

    // --- KAT 12: pf_contains on triangle ---
    _ck_b("tri_contains_10", pf_contains(tri, 1, 0), true)
    _ck_b("tri_contains_33_out", pf_contains(tri, 3, 3), false)
    _ck_b("tri_contains_00", pf_contains(tri, 0, 0), true)

    print("PASS _polygon_fill_test")
