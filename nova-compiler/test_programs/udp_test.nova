// Oracle for UDP sockets (was defined in the runtime but UNREACHABLE from NOVA
// until wired 2026-05-29). Loopback self-send: a bound socket sends a datagram to
// itself on 127.0.0.1 and receives it back. Byte count + payload are the authority.
fn main()
    let s = udp_bind(18961)
    assert_eq(s >= 0, true)
    let sent = udp_send(s, "127.0.0.1", 18961, "ping-udp")
    assert_eq(sent, 8)
    let msg = udp_recv(s)
    assert_eq(msg, "ping-udp")
    print("udp test passed")
