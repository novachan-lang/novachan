// #25: a C-callable NOVA library. @export marks the public API; with @export present the
// compiler skips the i32 main entry so a C host links these functions directly.
@export
fn novalib_add(a: int, b: int) -> int
    a + b

@export
fn novalib_mul(a: int, b: int) -> int
    a * b

@export
fn novalib_fib(n: int) -> int
    if n < 2
        return n
    novalib_fib(n - 1) + novalib_fib(n - 2)
