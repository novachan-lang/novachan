type Point
    x: int
    y: int

fn Point.magnitude(self)
    let sx = self.x * self.x
    let sy = self.y * self.y
    sx + sy

fn Point.translate(self, dx, dy)
    Point{x: self.x + dx, y: self.y + dy}

fn Point.to_str(self)
    "(" + str(self.x) + ", " + str(self.y) + ")"

p = Point{x: 3, y: 4}
print(p.magnitude())
p2 = p.translate(10, 20)
print(p2.to_str())
print(p2.magnitude())

type Counter
    count: int

fn Counter.inc(self)
    Counter{count: self.count + 1}

fn Counter.value(self)
    self.count

c = Counter{count: 0}
c = c.inc()
c = c.inc()
c = c.inc()
print(c.value())
