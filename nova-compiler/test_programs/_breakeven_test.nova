// _breakeven_test.nova — KAT for std/finance/breakeven
//
// All expected values hand-computed:
//   bev_units(10000, 50, 30)              = 10000 / (50-30)      = 10000/20  = 500.0
//   bev_revenue(10000, 50, 30)            = 500 * 50             = 25000.0
//   bev_margin(50, 30)                    = 50 - 30              = 20.0
//   bev_margin_ratio(50, 30)              = (50-30)/50           = 20/50     = 0.4
//   bev_target_profit_units(10000,50,30,5000) = (10000+5000)/20 = 15000/20  = 750.0
//   bev_units(6000, 10, 4)               = 6000 / (10-4)        = 6000/6    = 1000.0

import std/finance/breakeven

// Float known-answer check within epsilon.
fn ckf(label: str, got: float, want: float, eps: float)
    let diff = got - want
    let adiff = diff
    if diff < 0.0
        adiff = 0.0 - diff
    if adiff > eps
        print("FAIL " + label + ": got " + str(got) + " expected " + str(want))
        exit(1)

fn main()
    // KAT 1: bev_units — 10000/(50-30) = 500.0
    let v1 = bev_units(10000.0, 50.0, 30.0)
    ckf("bev_units_basic", v1, 500.0, 0.01)

    // KAT 2: bev_revenue — 500 * 50 = 25000.0
    let v2 = bev_revenue(10000.0, 50.0, 30.0)
    ckf("bev_revenue", v2, 25000.0, 0.01)

    // KAT 3: bev_margin — 50 - 30 = 20.0
    let v3 = bev_margin(50.0, 30.0)
    ckf("bev_margin", v3, 20.0, 0.01)

    // KAT 4: bev_margin_ratio — (50-30)/50 = 0.4
    let v4 = bev_margin_ratio(50.0, 30.0)
    ckf("bev_margin_ratio", v4, 0.4, 0.0001)

    // KAT 5: bev_target_profit_units — (10000+5000)/20 = 750.0
    let v5 = bev_target_profit_units(10000.0, 50.0, 30.0, 5000.0)
    ckf("bev_target_profit_units", v5, 750.0, 0.01)

    // KAT 6: bev_units second vector — 6000/(10-4) = 1000.0
    let v6 = bev_units(6000.0, 10.0, 4.0)
    ckf("bev_units_second", v6, 1000.0, 0.01)

    // KAT 7: breakeven_units — 1000/(10-5) = 200.0
    let v7 = breakeven_units(1000.0, 10.0, 5.0)
    ckf("breakeven_units", v7, 200.0, 0.01)

    // KAT 8: contribution_margin — 10 - 5 = 5.0
    let v8 = contribution_margin(10.0, 5.0)
    ckf("contribution_margin", v8, 5.0, 0.01)

    // KAT 9: target_profit_units — (1000+500)/(10-5) = 1500/5 = 300.0
    let v9 = target_profit_units(1000.0, 500.0, 10.0, 5.0)
    ckf("target_profit_units", v9, 300.0, 0.01)

    // KAT 10: margin_of_safety — 250 - 200 = 50.0
    let v10 = margin_of_safety(250.0, 200.0)
    ckf("margin_of_safety", v10, 50.0, 0.01)

    print("PASS _breakeven_test")
