import forge_articulation

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn joinl(xs: list) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + ","
        out = out + str(xs[i])
        i = i + 1
    out

fn sortkeys(bridges: list) -> string
    // encode each [u,v] as u*100+v, sort ascending, join
    let keys = []
    let i = 0
    while i < len(bridges)
        push(keys, bridges[i][0] * 100 + bridges[i][1])
        i = i + 1
    // insertion sort (int array)
    let a = 1
    while a < len(keys)
        let key = keys[a]
        let b = a - 1
        while b >= 0 and keys[b] > key
            keys[b + 1] = keys[b]
            b = b - 1
        keys[b + 1] = key
        a = a + 1
    joinl(keys)

fn main()
    let fails = 0

    // classic 5-node graph: triangle 0-1-2, plus 0-3, 3-4
    let g1 = []
    push(g1, [1, 2, 3])
    push(g1, [0, 2])
    push(g1, [0, 1])
    push(g1, [0, 4])
    push(g1, [3])
    fails = fails + expect("g1_aps", joinl(articulation_points(5, g1)), "0,3")
    fails = fails + expect("g1_bridges", sortkeys(find_bridges(5, g1)), "3,304")

    // triangle (cycle) -- no cut vertices, no bridges
    let g2 = []
    push(g2, [1, 2])
    push(g2, [0, 2])
    push(g2, [0, 1])
    fails = fails + expect("tri_aps", joinl(articulation_points(3, g2)), "")
    fails = fails + expect("tri_bridges", joinl(find_bridges(3, g2)), "")

    // path 0-1-2-3 -- internal nodes are cut vertices, every edge a bridge
    let g3 = []
    push(g3, [1])
    push(g3, [0, 2])
    push(g3, [1, 3])
    push(g3, [2])
    fails = fails + expect("path_aps", joinl(articulation_points(4, g3)), "1,2")
    fails = fails + expect("path_bridges", sortkeys(find_bridges(4, g3)), "1,102,203")

    // star: center 0 connected to 1,2,3 -- center is the only cut vertex, all edges bridges
    let g4 = []
    push(g4, [1, 2, 3])
    push(g4, [0])
    push(g4, [0])
    push(g4, [0])
    fails = fails + expect("star_aps", joinl(articulation_points(4, g4)), "0")
    fails = fails + expect("star_bridges", sortkeys(find_bridges(4, g4)), "1,2,3")

    if fails == 0
        print("forge_articulation: all passed")
    else
        print("forge_articulation: " + str(fails) + " FAILED")
