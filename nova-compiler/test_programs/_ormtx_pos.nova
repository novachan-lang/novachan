// Positive test: orm_with_tx using the CORRECT tx parameter -- must compile with ZERO warnings.
fn orm_all(db, sql: string, params) -> list
    []

fn orm_with_tx(db, body) -> int
    body(db)

fn orm_exec(db, sql: string, params) -> int
    0

type User
    id: int
    name: string

fn main()
    let db = 0
    let r = orm_with_tx(db, fn(tx) orm_exec(tx, "UPDATE User SET name = 'x'", []))
    print("done: {r}")
