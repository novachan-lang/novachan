// rtti_show_test -- Phase 0a S3. A struct erased to `any` must str()/print as
// "Name { field: value }" with bool/float/string/int/nested ALL correct (type-aware via
// the RTTI field metadata), matching the compile-time __show -- not "<struct>" or 1/garbage.
// Forces the runtime path via `fn erase(x) -> any`.

type Rec
    id: int
    active: bool
    ratio: float
    name: string

type Outer
    tag: int
    inner: Rec

fn erase(x) -> any
    x

fn main()
    let lb = chr(123)
    let rb = chr(125)

    let r = Rec(7, true, 2.5, "ada")
    // expected: "Rec { id: 7, active: true, ratio: 2.5, name: ada }" (string unquoted in show)
    let exp = "Rec " + lb + " id: 7, active: true, ratio: 2.5, name: ada " + rb

    // static path (compile-time __show) -- guard + reference
    assert_eq(str(r), exp)

    // ERASED -> runtime nova_struct_to_str; must equal the static form
    let re = erase(r)
    assert_eq(str(re), exp)

    // ERASED nested -> the inner struct recurses to a nested "Name { ... }"
    let o = Outer(1, Rec(7, true, 2.5, "ada"))
    let oe = erase(o)
    assert_eq(str(oe), "Outer " + lb + " tag: 1, inner: " + exp + " " + rb)

    print("rtti_show_test passed")
