// rtti_show_test -- Phase 0a S3. A struct erased to `any` must str()/print as
// "Name { field: value }" (matching the compile-time __show), not "<struct>". Forces the
// runtime path via `fn erase(x) -> any`; covers the static guard, erased flat, and
// erased nested (recursion through elem_to_str).

type Inner
    a: int
    b: int

type Outer
    id: int
    pt: Inner

fn erase(x) -> any
    x

fn main()
    let lb = chr(123)
    let rb = chr(125)

    let p = Inner(3, 4)
    // static path (compile-time __show) -- regression guard + format reference
    assert_eq(str(p), "Inner " + lb + " a: 3, b: 4 " + rb)

    // ERASED -> runtime nova_struct_to_str (the S3 fix); must equal the static form
    let pe = erase(p)
    assert_eq(str(pe), "Inner " + lb + " a: 3, b: 4 " + rb)

    // ERASED nested -> the inner struct recurses to a nested "Name { ... }"
    let o = Outer(7, Inner(1, 2))
    let oe = erase(o)
    let inner = "Inner " + lb + " a: 1, b: 2 " + rb
    assert_eq(str(oe), "Outer " + lb + " id: 7, pt: " + inner + " " + rb)

    print("rtti_show_test passed")
