import forge_dutchflag

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn joinl(xs: list) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + ","
        out = out + str(xs[i])
        i = i + 1
    out

fn main()
    let fails = 0

    // dutch flag (sort colors)
    fails = fails + expect("df1", joinl(dutch_flag([2, 0, 2, 1, 1, 0])), "0,0,1,1,2,2")
    fails = fails + expect("df2", joinl(dutch_flag([1, 0, 2])), "0,1,2")
    fails = fails + expect("df_all0", joinl(dutch_flag([0, 0, 0])), "0,0,0")
    fails = fails + expect("df_all2", joinl(dutch_flag([2, 2])), "2,2")
    fails = fails + expect("df_sorted", joinl(dutch_flag([0, 1, 2, 0, 1, 2])), "0,0,1,1,2,2")
    fails = fails + expect("df_single", joinl(dutch_flag([1])), "1")

    // partition3 around a pivot
    let p = partition3([3, 1, 4, 1, 5, 9, 2, 6], 4)
    // p[0] = partitioned, p[1] = lt count, p[2] = eq count
    fails = fails + expect("p3_lt", str(p[1]), "4")
    fails = fails + expect("p3_eq", str(p[2]), "1")
    // verify partition property: first lt are <4, then ==4, then >4
    let arr = p[0]
    let lt = p[1]
    let eq = p[2]
    let ok = 1
    let i = 0
    while i < len(arr)
        if i < lt and arr[i] >= 4
            ok = 0
        if i >= lt and i < lt + eq and arr[i] != 4
            ok = 0
        if i >= lt + eq and arr[i] <= 4
            ok = 0
        i = i + 1
    fails = fails + expect("p3_property", str(ok), "1")

    // partition where pivot absent
    let p2 = partition3([5, 3, 8, 1, 9], 4)
    fails = fails + expect("p3_absent_lt", str(p2[1]), "2")
    fails = fails + expect("p3_absent_eq", str(p2[2]), "0")

    // partition with many duplicates of the pivot
    let p3 = partition3([4, 4, 2, 4, 6, 4, 1], 4)
    fails = fails + expect("p3_dups_eq", str(p3[2]), "4")
    fails = fails + expect("p3_dups_lt", str(p3[1]), "2")

    if fails == 0
        print("forge_dutchflag: all passed")
    else
        print("forge_dutchflag: " + str(fails) + " FAILED")
