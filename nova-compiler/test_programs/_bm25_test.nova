// KAT test for std/text/bm25
import std/text/bm25

// Float approx helper
fn approx(a, b, tol) -> bool
    let diff = a - b
    if diff < 0.0
        diff = 0.0 - diff
    diff < tol

fn ckb(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn main()
    // corpus: d0=['the','cat','sat'], d1=['the','dog','ran','fast'], d2=['cat','cat','cat','mouse']
    let d0 = ["the", "cat", "sat"]
    let d1 = ["the", "dog", "ran", "fast"]
    let d2 = ["cat", "cat", "cat", "mouse"]
    let corpus = [d0, d1, d2]

    // 1. bm25_doc_count == 3
    cki("doc_count", bm25_doc_count(corpus), 3)

    // 2. bm25_df(corpus, 'cat') == 2 (d0 and d2 contain 'cat')
    cki("df_cat", bm25_df(corpus, "cat"), 2)

    // 3. bm25_df(corpus, 'mouse') == 1
    cki("df_mouse", bm25_df(corpus, "mouse"), 1)

    // 4. bm25_idf: 'mouse' (df=1) should have HIGHER idf than 'cat' (df=2)
    //    because it's rarer
    let idf_cat = bm25_idf(corpus, "cat")
    let idf_mouse = bm25_idf(corpus, "mouse")
    if idf_mouse <= idf_cat
        print("FAIL idf_rarity: mouse idf=" + str(idf_mouse) + " cat idf=" + str(idf_cat) + " — rarer term must have higher idf")
        exit(1)

    // 5. bm25_idf values are non-negative
    if idf_cat < 0.0
        print("FAIL idf_nonneg_cat: got " + str(idf_cat))
        exit(1)
    if idf_mouse < 0.0
        print("FAIL idf_nonneg_mouse: got " + str(idf_mouse))
        exit(1)

    // 6. bm25_best(corpus, ['cat']) == 2 (d2 has 3 occurrences of 'cat')
    let best = bm25_best(corpus, ["cat"])
    cki("best_cat", best, 2)

    // 7. score of d2 for query ['cat'] > score of d0 (d2 has 3 cats, d0 has 1)
    let s2 = bm25_score(corpus, 2, ["cat"], 1.5, 0.75)
    let s0 = bm25_score(corpus, 0, ["cat"], 1.5, 0.75)
    if s2 <= s0
        print("FAIL score_d2_gt_d0: d2=" + str(s2) + " d0=" + str(s0))
        exit(1)

    // 8. A doc NOT containing the query term scores 0.0
    //    d1 does not contain 'cat' — its contribution for 'cat' must be 0
    let s1 = bm25_score(corpus, 1, ["cat"], 1.5, 0.75)
    if approx(s1, 0.0, 0.0001) == false
        print("FAIL score_no_term: d1 score for 'cat'=" + str(s1) + " expected 0.0")
        exit(1)

    // 9. bm25_tf(d2, 'cat') == 3
    cki("tf_cat_d2", bm25_tf(d2, "cat"), 3)

    // 10. bm25_tf(d1, 'cat') == 0
    cki("tf_cat_d1", bm25_tf(d1, "cat"), 0)

    // 11. bm25_contains(d2, 'cat') == true
    ckb("contains_d2_cat", bm25_contains(d2, "cat"), true)

    // 12. bm25_contains(d1, 'cat') == false
    ckb("contains_d1_cat", bm25_contains(d1, "cat"), false)

    // 13. bm25_vocab_size — the 3 docs use tokens: the,cat,sat,dog,ran,fast,mouse = 7 distinct
    cki("vocab_size", bm25_vocab_size(corpus), 7)

    // 14. bm25_rank: first result should be doc 2 for query ['cat']
    let ranked = bm25_rank(corpus, ["cat"])
    let top = ranked[0]
    cki("rank_top_doc", top["doc"], 2)

    // 15. bm25_search(corpus, ['cat'], 2) returns 2 entries; first is doc 2
    let top2 = bm25_search(corpus, ["cat"], 2)
    cki("search_len", len(top2), 2)
    cki("search_first", top2[0], 2)

    // 16. bm25_avgdl: (3+4+4)/3 = 11/3 ~ 3.667
    let avg = bm25_avgdl(corpus)
    if approx(avg, 3.667, 0.01) == false
        print("FAIL avgdl: got " + str(avg) + " expected ~3.667")
        exit(1)

    // 17. empty corpus safety
    let empty_corpus = []
    if approx(bm25_avgdl(empty_corpus), 0.0, 0.001) == false
        print("FAIL empty_avgdl")
        exit(1)
    cki("empty_df", bm25_df(empty_corpus, "x"), 0)
    cki("empty_best", bm25_best(empty_corpus, ["x"]), 0)

    // 18. bm25_score_default == bm25_score with k1=1.5, b=0.75
    let sd = bm25_score_default(corpus, 2, ["cat"])
    let se = bm25_score(corpus, 2, ["cat"], 1.5, 0.75)
    if approx(sd, se, 0.0001) == false
        print("FAIL score_default_eq: default=" + str(sd) + " explicit=" + str(se))
        exit(1)

    print("PASS _bm25_test")
