// PROBE: pattern guards (WEAPON_PARITY_PLAN 2.2).
// The plan listed this as TODO, but the parser already accepts `if <expr>` after a
// pattern (parse_match_stmt ~3688) and IR lowers it at three sites (mexpr ~13103,
// match-stmt ~14144, result-match ~14434). This probe establishes whether it is
// actually CORRECT, including first-arm, middle-arm and fall-through-to-wildcard.

enum Shape
    Circle(c_r: int)
    Square(s_side: int)

fn classify(n: int) -> string
    match n
        v if v < 0 => "negative"
        0 => "zero"
        v if v > 100 => "huge"
        v => "small"

// A guard on a CONSTRUCTOR pattern: the binder must be in scope inside the guard.
fn describe(s: Shape) -> string
    match s
        Circle(r) if r > 10 => "big circle"
        Circle(r) => "small circle"
        Square(side) if side > 10 => "big square"
        Square(side) => "small square"

fn main()
    print("g1=" + classify(0 - 5))
    print("g2=" + classify(0))
    print("g3=" + classify(500))
    print("g4=" + classify(7))
    print("g5=" + describe(Circle(50)))
    print("g6=" + describe(Circle(2)))
    print("g7=" + describe(Square(50)))
    print("g8=" + describe(Square(2)))
