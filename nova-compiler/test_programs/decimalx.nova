// decimalx — exact base-10 fixed-point decimals for money/financial values, where
// binary float rounding is unacceptable (0.1 + 0.2 != 0.3 in float). A Decimal is a
// scaled integer: value = m * 10^-s. Pure NOVA (no runtime/compiler changes), built
// on the int + struct primitives. v1 uses an i64 mantissa (range ~9.2e18 units).

type Decimal
    m: int
    s: int

fn dec(mantissa: int, scale: int) -> Decimal
    return Decimal(mantissa, scale)

fn dec_from_int(n: int) -> Decimal
    return Decimal(n, 0)

fn _pow10(n: int) -> int
    let r = 1
    let i = 0
    while i < n
        r = r * 10
        i = i + 1
    return r

// Align two decimals to a common (max) scale -> [m1, m2, scale].
fn _dec_align(a: Decimal, b: Decimal) -> list
    let scale = a.s
    if b.s > scale
        scale = b.s
    let m1 = a.m * _pow10(scale - a.s)
    let m2 = b.m * _pow10(scale - b.s)
    return [m1, m2, scale]

fn dec_add(a: Decimal, b: Decimal) -> Decimal
    let al = _dec_align(a, b)
    return Decimal(al[0] + al[1], al[2])

fn dec_sub(a: Decimal, b: Decimal) -> Decimal
    let al = _dec_align(a, b)
    return Decimal(al[0] - al[1], al[2])

fn dec_mul(a: Decimal, b: Decimal) -> Decimal
    return Decimal(a.m * b.m, a.s + b.s)

fn dec_neg(a: Decimal) -> Decimal
    return Decimal(0 - a.m, a.s)

fn dec_eq(a: Decimal, b: Decimal) -> bool
    let al = _dec_align(a, b)
    return al[0] == al[1]

fn dec_lt(a: Decimal, b: Decimal) -> bool
    let al = _dec_align(a, b)
    return al[0] < al[1]

// Render as a base-10 string with the point `s` digits from the right.
fn dec_str(d: Decimal) -> string
    if d.s <= 0
        return str(d.m)
    let neg = d.m < 0
    let mag = d.m
    if neg
        mag = 0 - mag
    let digits = str(mag)
    while len(digits) <= d.s
        digits = "0" + digits
    let cut = len(digits) - d.s
    let result = slice(digits, 0, cut) + "." + slice(digits, cut, len(digits))
    if neg
        result = "-" + result
    return result

fn main()
    // construction + render
    assert_eq(dec_str(dec(1250, 2)), "12.50")
    assert_eq(dec_str(dec(5, 2)), "0.05")
    assert_eq(dec_str(dec(-1250, 2)), "-12.50")
    assert_eq(dec_str(dec_from_int(100)), "100")

    // addition (same scale) — the classic 0.1 + 0.2 == 0.3, exactly
    assert_eq(dec_str(dec_add(dec(1, 1), dec(2, 1))), "0.3")
    assert_eq(dec_eq(dec_add(dec(1, 1), dec(2, 1)), dec(3, 1)), true)

    // addition across scales
    assert_eq(dec_str(dec_add(dec(100, 0), dec(50, 2))), "100.50")

    // subtraction
    assert_eq(dec_str(dec_sub(dec(1000, 2), dec(250, 2))), "7.50")

    // multiplication (scales add): 1.50 * 2.00 = 3.0000
    assert_eq(dec_str(dec_mul(dec(150, 2), dec(200, 2))), "3.0000")

    // equality across differing scales: 1.50 == 1.5
    assert_eq(dec_eq(dec(150, 2), dec(15, 1)), true)

    // ordering
    assert_eq(dec_lt(dec(125, 2), dec(13, 1)), true)   // 1.25 < 1.3
    assert_eq(dec_lt(dec(13, 1), dec(125, 2)), false)

    print("decimalx passed")
