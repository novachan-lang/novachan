// Nested selective-receive soundness. An outer receive's MATCHED-arm body itself runs a receive.
// The per-task recv_* cursor state is non-re-entrant, but this is sound: __recv_commit() runs BEFORE
// the arm body and every matched arm ends with `break`, so all of the outer receive's reads of the
// recv_* state happen before the body; the nested receive clobbers that state, but the outer loop
// immediately breaks and never reads it again. Also checks the save-queue survives the nested/outer
// boundary (3 is deferred by the 1st receive and still pulled by the 2nd top-level receive).
fn nworker(parent)
    receive
        1 =>
            receive
                2 => send_msg(parent, 99)
            send_msg(parent, 1)
    receive
        3 => send_msg(parent, 3)

fn main()
    let me = self_pid()
    let w = spawn nworker(me)
    let wb = mailbox_of(w)
    send_msg(wb, 3)            // no outer arm -> deferred; pulled by the 2nd top-level receive
    send_msg(wb, 2)            // no outer arm -> deferred; matched by the NESTED receive
    send_msg(wb, 1)            // matched by the 1st (outer) receive
    let a = recv_msg()
    let b = recv_msg()
    let c = recv_msg()
    assert(a == 99, "nested receive matched 2 -> 99 first")
    assert(b == 1, "outer arm body sent 1 after the nested receive completed")
    assert(c == 3, "2nd top-level receive pulled 3 from the save-queue")
    print("RECV_NESTED_OK")
