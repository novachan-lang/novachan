// KAT for std/core/testing — exercises all 10 assertion helpers with both
// a passing and a failing case (failing cases print FAIL lines by design).
import std/core/testing

fn div(a: int, b: int) -> Result
    if b == 0
        return err("div by zero")
    return ok(a / b)

fn run() -> int
    let checks = []

    // assert_eq
    checks = checks + [assert_eq(2 + 2, 4, "eq-pass")]
    print("--- expect a FAIL line below ---")
    checks = checks + [1 if assert_eq(2 + 2, 5, "eq-fail-case") == 0 else 0]

    // assert_neq
    checks = checks + [assert_neq(2 + 2, 5, "neq-pass")]
    print("--- expect a FAIL line below ---")
    checks = checks + [1 if assert_neq(2 + 2, 4, "neq-fail-case") == 0 else 0]

    // assert_true / assert_false
    checks = checks + [assert_true(1, "true-pass")]
    print("--- expect a FAIL line below ---")
    checks = checks + [1 if assert_true(0, "true-fail-case") == 0 else 0]

    checks = checks + [assert_false(0, "false-pass")]
    print("--- expect a FAIL line below ---")
    checks = checks + [1 if assert_false(1, "false-fail-case") == 0 else 0]

    // assert_contains
    checks = checks + [assert_contains("the quick fox", "fox", "contains-pass")]
    print("--- expect a FAIL line below ---")
    checks = checks + [1 if assert_contains("the quick fox", "dog", "contains-fail-case") == 0 else 0]

    // assert_gt / assert_lt
    checks = checks + [assert_gt(5, 3, "gt-pass")]
    print("--- expect a FAIL line below ---")
    checks = checks + [1 if assert_gt(3, 5, "gt-fail-case") == 0 else 0]

    checks = checks + [assert_lt(3, 5, "lt-pass")]
    print("--- expect a FAIL line below ---")
    checks = checks + [1 if assert_lt(5, 3, "lt-fail-case") == 0 else 0]

    // assert_ok / assert_err
    let good = div(10, 2)
    let bad = div(10, 0)
    checks = checks + [assert_ok(good, "ok-pass")]
    print("--- expect a FAIL line below ---")
    checks = checks + [1 if assert_ok(bad, "ok-fail-case") == 0 else 0]

    checks = checks + [assert_err(bad, "err-pass")]
    print("--- expect a FAIL line below ---")
    checks = checks + [1 if assert_err(good, "err-fail-case") == 0 else 0]

    // test_suite: an all-pass suite must return 1
    let all_pass = test_suite("all-pass-suite", [1, 1, 1])
    checks = checks + [1 if all_pass == 1 else 0]

    // test_suite: a mixed suite must return 0 (still prints a normal summary,
    // not a FAIL line, since test_suite itself is a summary, not an assertion)
    let mixed = test_suite("mixed-suite", [1, 0, 1])
    checks = checks + [1 if mixed == 0 else 0]

    let total = len(checks)
    let passed = checks.reduce(fn(acc, r) acc + r, 0)
    if passed != total
        print("KAT INTERNAL FAILURE: {passed}/{total} checks passed")
        return 1

    print("TESTING KAT PASS")
    return 0

fn main() -> int
    return run()
