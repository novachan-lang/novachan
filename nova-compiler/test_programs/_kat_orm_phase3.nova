// Phase 3 KAT: orm_load_related, orm_prefetch, orm_loader, orm_coalesce,
// orm_find_or_create, orm_paginate_keyset, orm_stream, orm_upsert_many, orm_tx_batch.
// Uses sqlite (embedded, no server needed).
import forge_orm
import forge_db

type Project
    id: int
    name: string

type Task
    id: int
    project_id: int
    title: string

let _stream_count = 0

fn _count_batch(batch)
    _stream_count = _stream_count + len(batch)

fn setup_db(db)
    orm_ensure(db, Project { id: 0, name: "" })
    orm_ensure(db, Task { id: 0, project_id: 0, title: "" })
    _ = orm_exec(db, "DELETE FROM Task", [])
    _ = orm_exec(db, "DELETE FROM Project", [])
    orm_save(db, Project { id: 1, name: "Alpha" })
    orm_save(db, Project { id: 2, name: "Beta" })
    orm_save(db, Task { id: 10, project_id: 1, title: "Design" })
    orm_save(db, Task { id: 11, project_id: 1, title: "Build" })
    orm_save(db, Task { id: 12, project_id: 1, title: "Test" })
    orm_save(db, Task { id: 20, project_id: 2, title: "Plan" })

fn main()
    let db = orm_open("sqlite://test_phase3.db")
    setup_db(db)
    let pass = 0
    let fail = 0

    // ---- orm_load_related ----
    let ps: list<Project> = orm_all(db, "SELECT * FROM Project", [])
    let by_pid = orm_load_related(db, ps, "Task", "project_id")
    let alpha_tasks = get(by_pid, "1", [])
    let beta_tasks = get(by_pid, "2", [])
    if len(alpha_tasks) == 3
        pass += 1
        print("PASS load_related alpha=3")
    else
        fail += 1
        print("FAIL load_related alpha expected 3 got {len(alpha_tasks)}")
    if len(beta_tasks) == 1
        pass += 1
        print("PASS load_related beta=1")
    else
        fail += 1
        print("FAIL load_related beta expected 1 got {len(beta_tasks)}")

    // ---- orm_prefetch ----
    let pf_results = orm_prefetch(db, ps, [["Task", "project_id"], ["Task", "project_id"]])
    let tasks_by_p = pf_results[0]
    let pf1 = get(tasks_by_p, "1", [])
    if len(pf1) == 3
        pass += 1
        print("PASS prefetch alpha=3")
    else
        fail += 1
        print("FAIL prefetch alpha expected 3 got {len(pf1)}")

    // ---- orm_loader ----
    let loader = orm_loader_new(db, "Task", "id")
    let loaded = orm_loader_load_all(loader, [10, 20])
    let t10 = loaded["10"]
    let t20 = loaded["20"]
    if t10 != null and field_get(t10, "title") == "Design"
        pass += 1
        print("PASS loader t10=Design")
    else
        fail += 1
        print("FAIL loader t10")
    if t20 != null and field_get(t20, "title") == "Plan"
        pass += 1
        print("PASS loader t20=Plan")
    else
        fail += 1
        print("FAIL loader t20")

    // ---- orm_paginate_keyset ----
    let page1 = orm_paginate_keyset(db, "Task", "id", "", 2, true)
    if len(page1) == 2
        pass += 1
        print("PASS keyset page1 len=2")
    else
        fail += 1
        print("FAIL keyset page1 expected 2 got {len(page1)}")
    let last_id = str(field_get(page1[len(page1) - 1], "id"))
    let page2 = orm_paginate_keyset(db, "Task", "id", last_id, 2, true)
    if len(page2) == 2
        pass += 1
        print("PASS keyset page2 len=2")
    else
        fail += 1
        print("FAIL keyset page2 expected 2 got {len(page2)}")

    // ---- orm_find_or_create ----
    let fc1 = orm_find_or_create(db, "Project", "name", Project { id: 0, name: "Alpha" })
    if is_ok(fc1)
        pass += 1
        print("PASS find_or_create existing")
    else
        fail += 1
        print("FAIL find_or_create existing: {fc1}")
    let fc2 = orm_find_or_create(db, "Project", "name", Project { id: 3, name: "Gamma" })
    if is_ok(fc2)
        pass += 1
        print("PASS find_or_create new")
    else
        fail += 1
        print("FAIL find_or_create new: {fc2}")

    // ---- orm_upsert_many ----
    let ures = orm_upsert_many(db, "Project", [Project { id: 1, name: "Alpha-v2" }, Project { id: 2, name: "Beta-v2" }])
    if is_ok(ures)
        pass += 1
        print("PASS upsert_many")
    else
        fail += 1
        print("FAIL upsert_many: {ures}")

    // ---- orm_stream ----
    _stream_count = 0
    let sr = orm_stream(db, "Task", "id", 2, _count_batch)
    if is_ok(sr)
        pass += 1
        print("PASS stream ok")
    else
        fail += 1
        print("FAIL stream: {sr}")

    // ---- summary ----
    print("")
    print("Phase 3 KAT: {pass} passed, {fail} failed")
    if fail > 0
        print("FAIL")
    else
        print("ALL PASS")
