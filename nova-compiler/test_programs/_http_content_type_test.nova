import std/httphdr/http_content_type

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got=[" + got + "] want=[" + want + "]")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn ckl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)

fn main()
    // KAT — specified vectors
    cks("kat-mime", hct_mime("text/html; charset=utf-8"), "text/html")
    cks("kat-charset", hct_charset("text/html; charset=utf-8"), "utf-8")
    cks("kat-type", hct_type("application/json"), "application")
    cks("kat-subtype", hct_subtype("application/json"), "json")
    cks("kat-boundary", hct_boundary("multipart/form-data; boundary=xyz"), "xyz")
    cks("kat-charset-absent", hct_charset("text/plain"), "")

    // Additional robustness tests

    // Case-insensitive MIME type
    cks("mime-case", hct_mime("TEXT/HTML"), "text/html")

    // No parameters
    cks("mime-noparam", hct_mime("application/json"), "application/json")

    // Quoted charset
    cks("charset-quoted", hct_charset("text/html; charset=\"UTF-8\""), "utf-8")

    // hct_param generic lookup
    cks("param-charset", hct_param("text/html; charset=utf-8", "charset"), "utf-8")
    cks("param-boundary", hct_param("multipart/form-data; boundary=XYZ123", "boundary"), "XYZ123")

    // Case-insensitive param key
    cks("param-ci-key", hct_param("text/html; Charset=utf-8", "charset"), "utf-8")

    // Empty input
    cks("empty-mime", hct_mime(""), "")
    cks("empty-type", hct_type(""), "")
    cks("empty-subtype", hct_subtype(""), "")
    cks("empty-charset", hct_charset(""), "")
    cks("empty-boundary", hct_boundary(""), "")

    // Multiple parameters
    cks("multi-charset", hct_charset("text/html; boundary=abc; charset=iso-8859-1"), "iso-8859-1")
    cks("multi-boundary", hct_boundary("multipart/mixed; charset=utf-8; boundary=frontier"), "frontier")

    // Whitespace trimming around semicolons
    cks("ws-mime", hct_mime("  text/plain  ; charset=us-ascii"), "text/plain")
    cks("ws-charset", hct_charset("  text/plain  ; charset=us-ascii"), "us-ascii")

    // Absent param returns ""
    cks("param-absent", hct_param("application/json", "charset"), "")

    // No slash in media type
    cks("noslash-type", hct_type("multipart"), "multipart")
    cks("noslash-subtype", hct_subtype("multipart"), "")

    print("PASS _http_content_type_test")
