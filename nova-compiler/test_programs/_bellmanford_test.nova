import std/graph/bellmanford

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // =========================================================================
    // SPEC graph: A->[[B,4],[C,5]], B->[[C,-3]], C->[[D,4]], D->[]
    // Hand-computed: A=0 B=4 C=4-3=1 D=1+4=5
    // =========================================================================
    let g = {}
    g["A"] = [["B", 4], ["C", 5]]
    g["B"] = [["C", -3]]
    g["C"] = [["D", 4]]
    g["D"] = []
    let nodes = ["A", "B", "C", "D"]

    // KAT 1: A->C via A->B->C = 4 + (-3) = 1
    cki("dist_A_to_C", bellmanford.bf_distance(g, nodes, "A", "C"), 1)

    // KAT 2: A->D via A->B->C->D = 4 + (-3) + 4 = 5
    cki("dist_A_to_D", bellmanford.bf_distance(g, nodes, "A", "D"), 5)

    // KAT 3: A->B direct = 4
    cki("dist_A_to_B", bellmanford.bf_distance(g, nodes, "A", "B"), 4)

    // KAT 4: source to itself = 0
    cki("dist_A_to_A", bellmanford.bf_distance(g, nodes, "A", "A"), 0)

    // KAT 5: no negative cycle in this graph
    cki("no_neg_cycle", bellmanford.bf_has_negative_cycle(g, nodes, "A"), 0)

    // KAT 6: bf_shortest returns correct full dist dict
    let dist = bellmanford.bf_shortest(g, nodes, "A")
    cki("shortest_B", dist["B"], 4)
    cki("shortest_C", dist["C"], 1)
    cki("shortest_D", dist["D"], 5)

    // =========================================================================
    // UNREACHABLE: D cannot reach A (directed graph)
    // =========================================================================

    // KAT 7: D cannot reach A (unreachable -> -1)
    cki("dist_D_to_A_unreachable", bellmanford.bf_distance(g, nodes, "D", "A"), -1)

    // KAT 8: D cannot reach B (unreachable -> -1)
    cki("dist_D_to_B_unreachable", bellmanford.bf_distance(g, nodes, "D", "B"), -1)

    // =========================================================================
    // NEGATIVE CYCLE: A->[[B,1]], B->[[A,-2]]
    // cycle A->B->A has total weight 1 + (-2) = -1 < 0 => negative cycle
    // =========================================================================
    let ng = {}
    ng["A"] = [["B", 1]]
    ng["B"] = [["A", -2]]
    let nnodes = ["A", "B"]

    // KAT 9: negative cycle detected
    cki("neg_cycle_detected", bellmanford.bf_has_negative_cycle(ng, nnodes, "A"), 1)

    // KAT 10: clean graph with no negative edges has no negative cycle
    let pg = {}
    pg["X"] = [["Y", 3], ["Z", 7]]
    pg["Y"] = [["Z", 2]]
    pg["Z"] = []
    let pnodes = ["X", "Y", "Z"]
    cki("pos_graph_no_neg_cycle", bellmanford.bf_has_negative_cycle(pg, pnodes, "X"), 0)
    cki("pos_graph_dist_X_Z", bellmanford.bf_distance(pg, pnodes, "X", "Z"), 5)

    print("_bellmanford_test passed")

main()
