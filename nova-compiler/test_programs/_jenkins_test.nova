// _jenkins_test.nova — KAT for std/hash/jenkins
//
// Known-answer vectors computed via authoritative PowerShell trace (int64, mask=4294967295).
// All values independently verified by step-tracing the algorithm.
//
// Trace for "a" (byte=97):
//   h=0
//   step1: (0+97) & mask = 97
//   step2: (97 + (97<<10)) & mask = (97 + 99328) & mask = 99425
//   step3: 99425 ^ (99425>>6) = 99425 ^ 1553 = 98928
//   final-mix:
//   step4: (98928 + (98928<<3)) & mask = (98928 + 791424) & mask = 890352
//   step5: 890352 ^ (890352>>11) = 890352 ^ 434 = 889922
//   step6: (889922 + (889922<<15)) & mask
//          889922 << 15 = 29172572160; sum = 29173462082; & mask = 3392050242
//   => 3392050242  (0xCA2E9442)

import std/hash/jenkins

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // KAT 1: empty string must return 0 (no bytes processed, final mix of 0 = 0)
    cki("empty", h_jenkins(""), 0)

    // KAT 2: single character "a" — hand-traced above => 3392050242
    cki("a", h_jenkins("a"), 3392050242)

    // KAT 3: "hello" — step-traced in header comment of jenkins.nova => 3372029979
    cki("hello", h_jenkins("hello"), 3372029979)

    // KAT 4: "abc" — independently computed => 3977453403
    cki("abc", h_jenkins("abc"), 3977453403)

    // KAT 5: determinism — same input produces same output on repeated calls
    let r1 = h_jenkins("determinism_check")
    let r2 = h_jenkins("determinism_check")
    cki("determinism", r1, r2)

    // KAT 6: different inputs produce different outputs (collision check for these specific values)
    let ha = h_jenkins("hello")
    let hb = h_jenkins("world")
    if ha == hb
        print("FAIL collision: hello and world hash to same value")
        exit(1)

    // KAT 7: "z" — independently computed => 3059772574
    cki("z", h_jenkins("z"), 3059772574)

    // KAT 8: result is bounded to 32 bits (max 4294967295)
    let hfoo = h_jenkins("foo")
    if hfoo < 0
        print("FAIL bounds: h_jenkins(foo) is negative: " + str(hfoo))
        exit(1)
    if hfoo > 4294967295
        print("FAIL bounds: h_jenkins(foo) exceeds 32-bit range: " + str(hfoo))
        exit(1)

    print("_jenkins_test passed")

main()
