// KAT test for std/audio/adsr.nova
import std/audio/adsr

fn approx(a: float, b: float, tol: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    let result = d < tol
    result

fn main()
    // ADSR params: attack=1.0, decay=1.0, sustain=0.5, release=1.0, gate_time=10.0

    // KAT 1: t=0.0 -> start of attack -> 0.0
    let v0 = adsr_value(0.0, 1.0, 1.0, 0.5, 1.0, 10.0)
    if approx(v0, 0.0, 0.0001) != true
        print("FAIL adsr t=0.0: got=" + str(v0) + " want~0.0")
        exit(1)

    // KAT 2: t=1.0 -> end of attack -> 1.0 (peak)
    let v1 = adsr_value(1.0, 1.0, 1.0, 0.5, 1.0, 10.0)
    if approx(v1, 1.0, 0.0001) != true
        print("FAIL adsr t=1.0 (attack peak): got=" + str(v1) + " want~1.0")
        exit(1)

    // KAT 3: t=2.0 -> end of decay -> sustain level 0.5
    let v2 = adsr_value(2.0, 1.0, 1.0, 0.5, 1.0, 10.0)
    if approx(v2, 0.5, 0.0001) != true
        print("FAIL adsr t=2.0 (decay end): got=" + str(v2) + " want~0.5")
        exit(1)

    // KAT 4: t=5.0 -> mid-sustain -> 0.5
    let v5 = adsr_value(5.0, 1.0, 1.0, 0.5, 1.0, 10.0)
    if approx(v5, 0.5, 0.0001) != true
        print("FAIL adsr t=5.0 (sustain): got=" + str(v5) + " want~0.5")
        exit(1)

    // KAT 5: t=10.0 -> start of release -> sustain (0.5), frac=0
    let v10 = adsr_value(10.0, 1.0, 1.0, 0.5, 1.0, 10.0)
    if approx(v10, 0.5, 0.0001) != true
        print("FAIL adsr t=10.0 (release start): got=" + str(v10) + " want~0.5")
        exit(1)

    // KAT 6: t=10.5 -> mid-release -> 0.25 (halfway from sustain=0.5 to 0)
    let v10h = adsr_value(10.5, 1.0, 1.0, 0.5, 1.0, 10.0)
    if approx(v10h, 0.25, 0.0001) != true
        print("FAIL adsr t=10.5 (mid-release): got=" + str(v10h) + " want~0.25")
        exit(1)

    // KAT 7: t=11.0 -> end of release -> 0.0
    let v11 = adsr_value(11.0, 1.0, 1.0, 0.5, 1.0, 10.0)
    if approx(v11, 0.0, 0.0001) != true
        print("FAIL adsr t=11.0 (release end): got=" + str(v11) + " want~0.0")
        exit(1)

    // KAT 8: t=15.0 -> after release -> 0.0
    let v15 = adsr_value(15.0, 1.0, 1.0, 0.5, 1.0, 10.0)
    if approx(v15, 0.0, 0.0001) != true
        print("FAIL adsr t=15.0 (after release): got=" + str(v15) + " want~0.0")
        exit(1)

    // KAT 9: mid-attack check: t=0.5 -> 0.5
    let v0h = adsr_value(0.5, 1.0, 1.0, 0.5, 1.0, 10.0)
    if approx(v0h, 0.5, 0.0001) != true
        print("FAIL adsr t=0.5 (mid-attack): got=" + str(v0h) + " want~0.5")
        exit(1)

    // KAT 10: mid-decay check: t=1.5, attack=1, decay=1, sustain=0.5
    // decay from 1.0 to 0.5 over 1 sec; at 0.5 sec into decay -> 0.75
    let v1h = adsr_value(1.5, 1.0, 1.0, 0.5, 1.0, 10.0)
    if approx(v1h, 0.75, 0.0001) != true
        print("FAIL adsr t=1.5 (mid-decay): got=" + str(v1h) + " want~0.75")
        exit(1)

    print("PASS _adsr_test")
