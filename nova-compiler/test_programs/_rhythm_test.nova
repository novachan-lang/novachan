import std/music/rhythm

fn main()
    // ── duration_ticks ────────────────────────────────────────────────────────
    let ppq = 480

    let got_q = duration_ticks("quarter", ppq)
    if got_q != 480
        print("FAIL rhythm duration_ticks quarter: got " + str(got_q) + " want 480")
        exit(1)

    let got_e = duration_ticks("eighth", ppq)
    if got_e != 240
        print("FAIL rhythm duration_ticks eighth: got " + str(got_e) + " want 240")
        exit(1)

    let got_w = duration_ticks("whole", ppq)
    if got_w != 1920
        print("FAIL rhythm duration_ticks whole: got " + str(got_w) + " want 1920")
        exit(1)

    let got_h = duration_ticks("half", ppq)
    if got_h != 960
        print("FAIL rhythm duration_ticks half: got " + str(got_h) + " want 960")
        exit(1)

    let got_s = duration_ticks("sixteenth", ppq)
    if got_s != 120
        print("FAIL rhythm duration_ticks sixteenth: got " + str(got_s) + " want 120")
        exit(1)

    let got_ts = duration_ticks("thirty_second", ppq)
    if got_ts != 60
        print("FAIL rhythm duration_ticks thirty_second: got " + str(got_ts) + " want 60")
        exit(1)

    let got_unk = duration_ticks("unknown", ppq)
    if got_unk != 0
        print("FAIL rhythm duration_ticks unknown: got " + str(got_unk) + " want 0")
        exit(1)

    // ── dotted ────────────────────────────────────────────────────────────────
    let got_dot = dotted(480)
    if got_dot != 720
        print("FAIL rhythm dotted(480): got " + str(got_dot) + " want 720")
        exit(1)

    let got_dot_h = dotted(960)
    if got_dot_h != 1440
        print("FAIL rhythm dotted(960): got " + str(got_dot_h) + " want 1440")
        exit(1)

    // ── double_dotted ─────────────────────────────────────────────────────────
    let got_dd = double_dotted(480)
    if got_dd != 840
        print("FAIL rhythm double_dotted(480): got " + str(got_dd) + " want 840")
        exit(1)

    let got_dd2 = double_dotted(960)
    if got_dd2 != 1680
        print("FAIL rhythm double_dotted(960): got " + str(got_dd2) + " want 1680")
        exit(1)

    // ── tuplet ────────────────────────────────────────────────────────────────
    // triplet: 3 notes in space of 2 quarter notes => 480*2/3 = 320
    let got_tri = tuplet(480, 3)
    if got_tri != 320
        print("FAIL rhythm tuplet(480,3): got " + str(got_tri) + " want 320")
        exit(1)

    // quintuplet: 5 notes in space of 2 quarters => 480*2/5 = 192
    let got_quin = tuplet(480, 5)
    if got_quin != 192
        print("FAIL rhythm tuplet(480,5): got " + str(got_quin) + " want 192")
        exit(1)

    // division by zero guard
    let got_zero = tuplet(480, 0)
    if got_zero != 0
        print("FAIL rhythm tuplet(480,0): got " + str(got_zero) + " want 0")
        exit(1)

    // ── note_value_name ───────────────────────────────────────────────────────
    let got_name_q = note_value_name(480, ppq)
    if got_name_q != "quarter"
        print("FAIL rhythm note_value_name(480,480): got " + got_name_q + " want quarter")
        exit(1)

    let got_name_w = note_value_name(1920, ppq)
    if got_name_w != "whole"
        print("FAIL rhythm note_value_name(1920,480): got " + got_name_w + " want whole")
        exit(1)

    let got_name_h = note_value_name(960, ppq)
    if got_name_h != "half"
        print("FAIL rhythm note_value_name(960,480): got " + got_name_h + " want half")
        exit(1)

    let got_name_e = note_value_name(240, ppq)
    if got_name_e != "eighth"
        print("FAIL rhythm note_value_name(240,480): got " + got_name_e + " want eighth")
        exit(1)

    let got_name_s = note_value_name(120, ppq)
    if got_name_s != "sixteenth"
        print("FAIL rhythm note_value_name(120,480): got " + got_name_s + " want sixteenth")
        exit(1)

    let got_name_ts = note_value_name(60, ppq)
    if got_name_ts != "thirty_second"
        print("FAIL rhythm note_value_name(60,480): got " + got_name_ts + " want thirty_second")
        exit(1)

    let got_name_unk = note_value_name(333, ppq)
    if got_name_unk != "?"
        print("FAIL rhythm note_value_name(333,480): got " + got_name_unk + " want ?")
        exit(1)

    // ── beats_in_bar ─────────────────────────────────────────────────────────
    // 4/4 time: 4 quarter notes = 4 * 480 = 1920
    let got_bar44 = beats_in_bar(4, 4, ppq)
    if got_bar44 != 1920
        print("FAIL rhythm beats_in_bar(4,4,480): got " + str(got_bar44) + " want 1920")
        exit(1)

    // 3/4 time: 3 quarter notes = 3 * 480 = 1440
    let got_bar34 = beats_in_bar(3, 4, ppq)
    if got_bar34 != 1440
        print("FAIL rhythm beats_in_bar(3,4,480): got " + str(got_bar34) + " want 1440")
        exit(1)

    // 6/8 time: 6 eighth notes = 6 * 240 = 1440
    let got_bar68 = beats_in_bar(6, 8, ppq)
    if got_bar68 != 1440
        print("FAIL rhythm beats_in_bar(6,8,480): got " + str(got_bar68) + " want 1440")
        exit(1)

    // 2/2 (cut time): 2 half notes = 2 * 960 = 1920
    let got_bar22 = beats_in_bar(2, 2, ppq)
    if got_bar22 != 1920
        print("FAIL rhythm beats_in_bar(2,2,480): got " + str(got_bar22) + " want 1920")
        exit(1)

    // unknown denominator returns 0
    let got_bar_bad = beats_in_bar(4, 7, ppq)
    if got_bar_bad != 0
        print("FAIL rhythm beats_in_bar(4,7,480): got " + str(got_bar_bad) + " want 0")
        exit(1)

    print("PASS _rhythm_test")
