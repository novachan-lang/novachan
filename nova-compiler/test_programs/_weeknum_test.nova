// KAT for std/time/weeknum — week numbering variants.
import std/time/weeknum

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL weeknum " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // ── day_of_year ──────────────────────────────────────────────────────────
    // 2024-01-01: first day of leap year
    cki("doy 2024-01-01", day_of_year(2024, 1, 1), 1)
    // 2024-03-01: Jan(31)+Feb(29)+1 = 61, leap year 2024
    cki("doy 2024-03-01", day_of_year(2024, 3, 1), 61)
    // 2024-12-31: last day of leap year = 366
    cki("doy 2024-12-31", day_of_year(2024, 12, 31), 366)
    // 2023-12-31: last day of non-leap year = 365
    cki("doy 2023-12-31", day_of_year(2023, 12, 31), 365)
    // Extra anchors
    cki("doy 2024-02-29", day_of_year(2024, 2, 29), 60)
    cki("doy 2023-02-28", day_of_year(2023, 2, 28), 59)
    cki("doy 1970-01-01", day_of_year(1970, 1, 1), 1)
    cki("doy 1970-12-31", day_of_year(1970, 12, 31), 365)

    // ── week_of_year_us ──────────────────────────────────────────────────────
    // 2024-01-01 is Monday (dow=1). dow_jan1=1. week=(0+1)/7+1=1.
    cki("us 2024-01-01", week_of_year_us(2024, 1, 1), 1)
    // 2024-01-07 is Sunday. doy=7. week=(6+1)/7+1=2.
    cki("us 2024-01-07", week_of_year_us(2024, 1, 7), 2)
    // 2023-01-01 is Sunday (dow=0). dow_jan1=0. week=(0+0)/7+1=1.
    cki("us 2023-01-01", week_of_year_us(2023, 1, 1), 1)
    // 2023-01-07 is Saturday. doy=7. week=(6+0)/7+1=1.
    cki("us 2023-01-07", week_of_year_us(2023, 1, 7), 1)
    // 2023-01-08 is Sunday. doy=8. week=(7+0)/7+1=2.
    cki("us 2023-01-08", week_of_year_us(2023, 1, 8), 2)
    // 1970-01-01 is Thursday (dow=4). week=(0+4)/7+1=1.
    cki("us 1970-01-01", week_of_year_us(1970, 1, 1), 1)
    // 1970-01-04 is Sunday (doy=4). week=(3+4)/7+1=2.
    cki("us 1970-01-04", week_of_year_us(1970, 1, 4), 2)
    // 2022-01-01 is Saturday (dow=6). week=(0+6)/7+1=1.
    cki("us 2022-01-01", week_of_year_us(2022, 1, 1), 1)
    // 2022-01-02 is Sunday. doy=2. week=(1+6)/7+1=2.
    cki("us 2022-01-02", week_of_year_us(2022, 1, 2), 2)
    // 2022-12-31 is Saturday. doy=365. week=(364+6)/7+1=53.
    cki("us 2022-12-31", week_of_year_us(2022, 12, 31), 53)

    // ── week_of_year_iso ─────────────────────────────────────────────────────
    // 2021-01-01 (Friday) → ISO week year=2020, week 53
    cki("iso 2021-01-01", week_of_year_iso(2021, 1, 1), 53)
    // 2021-01-04 (Monday) → ISO 2021-W01
    cki("iso 2021-01-04", week_of_year_iso(2021, 1, 4), 1)
    // 2026-01-01 (Thursday) → ISO 2026-W01
    cki("iso 2026-01-01", week_of_year_iso(2026, 1, 1), 1)
    // 2020-12-31 → ISO 2020-W53
    cki("iso 2020-12-31", week_of_year_iso(2020, 12, 31), 53)
    // 2019-12-30 (Monday) → ISO 2020-W01
    cki("iso 2019-12-30", week_of_year_iso(2019, 12, 30), 1)
    // 1970-01-01 (Thursday) → ISO 1970-W01
    cki("iso 1970-01-01", week_of_year_iso(1970, 1, 1), 1)

    // ── week_of_month ────────────────────────────────────────────────────────
    // 2024-03-01 is Friday. dow1=_dow(2024,3,1)=5. mon_offset=(5+6)%7=4. week=(0+4)/7+1=1.
    cki("wom 2024-03-01 Fri", week_of_month(2024, 3, 1), 1)
    // 2024-03-04 is Monday. week=(3+4)/7+1=2.
    cki("wom 2024-03-04 Mon", week_of_month(2024, 3, 4), 2)
    // 2024-03-11 is Monday. week=(10+4)/7+1=3.
    cki("wom 2024-03-11 Mon", week_of_month(2024, 3, 11), 3)
    // 2024-03-31 is Sunday. week=(30+4)/7+1=5+1=6.  Wait: (30+4)=34 /7=4+1=5.
    cki("wom 2024-03-31 Sun", week_of_month(2024, 3, 31), 5)
    // 2023-01-01 is Sunday. dow1=0. mon_offset=(0+6)%7=6. week=(0+6)/7+1=1.
    cki("wom 2023-01-01 Sun", week_of_month(2023, 1, 1), 1)
    // 2023-01-02 is Monday. week=(1+6)/7+1=2.
    cki("wom 2023-01-02 Mon", week_of_month(2023, 1, 2), 2)
    // 2023-01-09 is Monday. week=(8+6)/7+1=3.
    cki("wom 2023-01-09 Mon", week_of_month(2023, 1, 9), 3)
    // Month starting on Monday: 2024-01-01 is Monday. dow1=1. mon_offset=(1+6)%7=0. week=(0+0)/7+1=1.
    cki("wom 2024-01-01 Mon", week_of_month(2024, 1, 1), 1)
    // 2024-01-07 is Sunday. week=(6+0)/7+1=1.
    cki("wom 2024-01-07 Sun", week_of_month(2024, 1, 7), 1)
    // 2024-01-08 is Monday. week=(7+0)/7+1=2.
    cki("wom 2024-01-08 Mon", week_of_month(2024, 1, 8), 2)

    // ── Round-trip: day_of_year reverse check ────────────────────────────────
    // Build doy=61 manually for 2024 and verify
    cki("doy round-trip 2024 Feb 29", day_of_year(2024, 2, 29), 60)
    // Verify doy(2024,3,1)=61 matches 31+29+1
    cki("doy round-trip 2024 Mar 1", day_of_year(2024, 3, 1), 61)

    print("PASS _weeknum_test")
