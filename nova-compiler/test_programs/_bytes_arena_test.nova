// _bytes_arena_test -- arena-safe bytes (S2.5). bytes_create's data now uses nova_back_calloc, so a bytes
// created inside a per-request arena has BOTH its struct and data bump-allocated into the arena and reclaimed
// wholesale at arena_exit (no per-request leak -- the Forge flat-memory path). Exercises create/get/set/
// slice/copy INSIDE the arena across many enter/exit cycles, verifying correctness + no crash/UAF.
fn main()
    let acc = 0
    let i = 0
    while i < 500
        let prev = arena_enter()
        let b = bytes(8)
        bytes_set(b, 0, 65)
        bytes_set(b, 7, 90)
        acc = acc + bytes_get(b, 0) + bytes_get(b, 7) + bytes_len(b)
        let c = copy(b)
        bytes_set(c, 0, 33)
        acc = acc + bytes_get(c, 0) + bytes_get(b, 0)   // copy independence holds inside the arena too
        let e = bytes_slice(b, 0, 4)
        acc = acc + bytes_len(e)
        arena_exit(prev)
        i = i + 1
    // per cycle: 65 + 90 + 8 (b) + 33 + 65 (c indep, b still 65) + 4 (slice len) = 265
    assert(acc == 500 * 265, "arena bytes correct across 500 enter/exit cycles (got " + str(acc) + ")")
    print("PASS: arena-scoped bytes correct + reclaimed wholesale (500 cycles, copy-independent)")
    print("_bytes_arena_test passed")
