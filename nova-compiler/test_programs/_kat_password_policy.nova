import forge_password_policy

fn main()
    let p = pp_new(8)
    p = pp_require_upper(p)
    p = pp_require_digit(p)

    let r1 = pp_check(p, "short")
    assert(is_err(r1), "too short")

    let r2 = pp_check(p, "alllowercase1")
    assert(is_err(r2), "no upper")

    let r3 = pp_check(p, "AllUpperNoDigit")
    assert(is_err(r3), "no digit")

    let r4 = pp_check(p, "GoodPass1")
    assert(is_ok(r4), "strong")
    assert(unwrap(r4) == "strong", "strong msg")

    assert(pp_total_checks(p) == 4, "4 checks")
    assert(pp_pass_count(p) == 1, "1 pass")
    assert(pp_fail_count(p) == 3, "3 fails")

    print("PASSWORD-POLICY KAT PASS")
