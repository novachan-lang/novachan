// Diagnostic: simulate lexer string-building pattern

type Token
    kind: string
    value: string
    line: int
    col: int

fn is_alpha(ch: string) -> bool
    let c = ord(ch)
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or ch == "_"

fn is_digit(ch: string) -> bool
    let c = ord(ch)
    c >= 48 and c <= 57

fn is_alnum(ch: string) -> bool
    is_alpha(ch) or is_digit(ch)

fn tokenize(source: string) -> list
    let tokens = []
    let pos = 0
    let line = 1
    let col = 1
    let length = len(source)

    while pos < length
        let ch = source[pos]
        if ch == " " or ch == "\t" or ch == "\r"
            pos = pos + 1
            col = col + 1
        else if ch == "\n"
            push(tokens, Token("NEWLINE", "\\n", line, col))
            line = line + 1
            col = 1
            pos = pos + 1
        else if is_alpha(ch)
            let start_col = col
            let word = ""
            while pos < length and is_alnum(source[pos])
                word = word + source[pos]
                pos = pos + 1
                col = col + 1
            push(tokens, Token("IDENT", word, line, start_col))
        else if is_digit(ch)
            let start_col = col
            let num = ""
            while pos < length and is_digit(source[pos])
                num = num + source[pos]
                pos = pos + 1
                col = col + 1
            push(tokens, Token("INT", num, line, start_col))
        else if ch == "="
            push(tokens, Token("ASSIGN", "=", line, col))
            pos = pos + 1
            col = col + 1
        else if ch == "+"
            push(tokens, Token("OP", "+", line, col))
            pos = pos + 1
            col = col + 1
        else if ch == "("
            push(tokens, Token("LPAREN", "(", line, col))
            pos = pos + 1
            col = col + 1
        else if ch == ")"
            push(tokens, Token("RPAREN", ")", line, col))
            pos = pos + 1
            col = col + 1
        else
            pos = pos + 1
            col = col + 1
    push(tokens, Token("EOF", "", line, col))
    tokens

let tokens = tokenize("let x = 42 + 3")
print(len(tokens))

// Check token values via match
let i = 0
for t in tokens
    match t
        Token(k, v, l, c) =>
            if k != "NEWLINE" and k != "EOF"
                print(k + ":" + v)
    i = i + 1

print("DONE")
