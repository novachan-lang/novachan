// _perfectpower_test.nova — KAT for std/math/perfectpower
import std/math/perfectpower

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got " + got + " want " + want)
        exit(1)

fn main()
    // --- pp_is ---
    // pp_is(8)  = true  (2^3)
    cki("pp_is(8)", pp_is(8), 1)
    // pp_is(9)  = true  (3^2)
    cki("pp_is(9)", pp_is(9), 1)
    // pp_is(16) = true  (2^4)
    cki("pp_is(16)", pp_is(16), 1)
    // pp_is(10) = false
    cki("pp_is(10)", pp_is(10), 0)
    // pp_is(1)  = false (n<4 convention)
    cki("pp_is(1)", pp_is(1), 0)
    // pp_is(4)  = true  (2^2)
    cki("pp_is(4)", pp_is(4), 1)

    // --- pp_decompose ---
    // pp_decompose(8)  = [2,3]
    let d8 = pp_decompose(8)
    cki("pp_decompose(8)[0]", d8[0], 2)
    cki("pp_decompose(8)[1]", d8[1], 3)
    // pp_decompose(16) = [2,4]
    let d16 = pp_decompose(16)
    cki("pp_decompose(16)[0]", d16[0], 2)
    cki("pp_decompose(16)[1]", d16[1], 4)
    // pp_decompose(10) = [10,1] (not a perfect power)
    let d10 = pp_decompose(10)
    cki("pp_decompose(10)[0]", d10[0], 10)
    cki("pp_decompose(10)[1]", d10[1], 1)

    // --- pp_is_square ---
    // pp_is_square(16) = true (4^2)
    cki("pp_is_square(16)", pp_is_square(16), 1)
    // pp_is_square(9)  = true (3^2)
    cki("pp_is_square(9)", pp_is_square(9), 1)
    // pp_is_square(10) = false
    cki("pp_is_square(10)", pp_is_square(10), 0)

    // --- pp_is_cube ---
    // pp_is_cube(27) = true (3^3)
    cki("pp_is_cube(27)", pp_is_cube(27), 1)
    // pp_is_cube(8)  = true (2^3)
    cki("pp_is_cube(8)", pp_is_cube(8), 1)
    // pp_is_cube(9)  = false
    cki("pp_is_cube(9)", pp_is_cube(9), 0)

    // --- pp_is_power_of ---
    // pp_is_power_of(81, 3) = true  (3^4=81)
    cki("pp_is_power_of(81,3)", pp_is_power_of(81, 3), 1)
    // pp_is_power_of(8, 2)  = true  (2^3=8)
    cki("pp_is_power_of(8,2)", pp_is_power_of(8, 2), 1)
    // pp_is_power_of(10, 2) = false (not a power of 2)
    cki("pp_is_power_of(10,2)", pp_is_power_of(10, 2), 0)
    // pp_is_power_of(27, 3) = true  (3^3=27)
    cki("pp_is_power_of(27,3)", pp_is_power_of(27, 3), 1)

    print("_perfectpower_test passed")
