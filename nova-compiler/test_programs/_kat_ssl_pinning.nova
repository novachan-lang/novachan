import forge_ssl_pinning

fn main()
    let s = sp_new()
    s = sp_add_pin(s, "api.example.com", "sha256_abc123")
    s = sp_add_pin(s, "auth.example.com", "sha256_def456")
    assert(sp_pin_count(s) == 2, "2 pins")

    let r1 = sp_validate(s, "api.example.com", "sha256_abc123")
    assert(is_ok(r1), "valid pin")
    assert(unwrap(r1) == "pin valid", "pin valid msg")

    let r2 = sp_validate(s, "api.example.com", "sha256_wrong")
    assert(is_err(r2), "pin mismatch")
    assert(sp_rejection_count(s) == 1, "1 rejection")

    let r3 = sp_validate(s, "unknown.com", "sha256_any")
    assert(is_ok(r3), "no pin = ok")

    assert(sp_has_pin(s, "auth.example.com") == 1, "has pin")
    assert(sp_has_pin(s, "nope.com") == 0, "no pin")

    let gp = sp_get_pin(s, "auth.example.com")
    assert(unwrap(gp) == "sha256_def456", "pin hash")

    assert(sp_validation_count(s) == 3, "3 validations")

    print("SSL-PINNING KAT PASS")
