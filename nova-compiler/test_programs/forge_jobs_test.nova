// Forge T4.16: a background job queue drained by a worker pool. 10 jobs, 3 workers, each job processed
// exactly once (a shared atomic counts completions). Socketless (channel/spawn/atomic), kill-on-timeout.
import forge_otp

fn handle_job(kind, payload)
    atomic_add(payload, 1)

fn main()
    let jq = jobs(100)
    let counter = atomic_new(0)
    let i = 0
    while i < 10
        enqueue(jq, "work", counter)
        i = i + 1
    jobs_run(jq, 3, handle_job)
    sleep(200)
    if atomic_get(counter) != 10
        print("FAIL: expected 10 jobs processed, got " + str(atomic_get(counter)))
        exit(1)
    print("PASS forge_jobs (10 jobs drained by 3 workers, each processed once)")
