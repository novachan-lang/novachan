fn make_list(n: int) -> list
    let result = []
    let i = 0
    while i < n
        push(result, i * 2)
        i = i + 1
    return result

fn sum_list(lst: list) -> int
    let total = 0
    let i = 0
    while i < len(lst)
        total = total + lst[i]
        i = i + 1
    return total

fn main()
    set_arena_mode(1)
    assert(is_arena_mode() == true, "arena mode enabled")

    let data = make_list(1000)
    assert(len(data) == 1000, "list created in arena mode")
    let s = sum_list(data)
    assert(s == 999000, "sum correct in arena mode")

    let greeting = "hello" + " " + "arena"
    assert(greeting == "hello arena", "string concat in arena")

    let d = {}
    d["key"] = 42
    assert(d["key"] == 42, "dict in arena mode")

    set_arena_mode(0)
    assert(is_arena_mode() == false, "arena mode disabled")

    let post = make_list(10)
    assert(len(post) == 10, "normal mode works after arena")

    print("All arena tests passed")
