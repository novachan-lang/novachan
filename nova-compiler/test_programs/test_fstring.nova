// Test: f-string with quotes inside interpolation
fn main()
    let config = {}
    config["host"] = "localhost"
    config["port"] = "8080"

    // Test 1: simple f-string
    let name = "NOVA"
    print(f"Hello {name}!")

    // Test 2: expression in f-string
    print(f"2 + 3 = {2 + 3}")

    // Test 3: dict access with string key inside interpolation
    let k = "host"
    print(f"host = {config[k]}")

    // Test 4: direct string key inside interpolation (the bug)
    print(f"host = {config["host"]}")

    print("done")

main()
