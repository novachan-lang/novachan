// _luhn2_test.nova — KAT suite for std/validation/luhn2
import std/validation/luhn2

fn main()
    // --- KAT 1: vln_luhn_valid known-valid number ---
    let r1 = vln_luhn_valid("79927398713")
    if r1 == false
        print("FAIL KAT1: vln_luhn_valid(79927398713) expected true")
        exit(1)

    // --- KAT 2: vln_luhn_valid known-invalid number ---
    let r2 = vln_luhn_valid("79927398714")
    if r2 == true
        print("FAIL KAT2: vln_luhn_valid(79927398714) expected false")
        exit(1)

    // --- KAT 3: vln_luhn_check returns correct check digit ---
    let r3 = vln_luhn_check("7992739871")
    if r3 != 3
        print("FAIL KAT3: vln_luhn_check(7992739871) expected 3 got " + str(r3))
        exit(1)

    // --- KAT 4: vln_luhn_valid Visa test card number ---
    let r4 = vln_luhn_valid("4532015112830366")
    if r4 == false
        print("FAIL KAT4: vln_luhn_valid(4532015112830366) expected true")
        exit(1)

    // --- KAT 5: vln_damm_valid known-valid sequence ---
    let r5 = vln_damm_valid("5724")
    if r5 == false
        print("FAIL KAT5: vln_damm_valid(5724) expected true")
        exit(1)

    // --- KAT 6: vln_damm_valid known-invalid sequence ---
    let r6 = vln_damm_valid("5720")
    if r6 == true
        print("FAIL KAT6: vln_damm_valid(5720) expected false")
        exit(1)

    // --- KAT 7: vln_verhoeff_valid known-valid number (2363) ---
    let r7 = vln_verhoeff_valid("2363")
    if r7 == false
        print("FAIL KAT7: vln_verhoeff_valid(2363) expected true")
        exit(1)

    // --- KAT 8: vln_verhoeff_valid known-invalid number (2364) ---
    let r8 = vln_verhoeff_valid("2364")
    if r8 == true
        print("FAIL KAT8: vln_verhoeff_valid(2364) expected false")
        exit(1)

    // --- KAT 9: vln_mod11_valid — Dutch BSN-style: "123456782" weight_start=2 ---
    // Dutch BSN: multiply digits by 9,8,7,6,5,4,3,2,-1 and sum must be 0 mod 11
    // Our mod11 uses weights cycling 2..7 right-to-left; test with a known sum=0 mod 11
    // Construct a simple case: "11" with weight_start=2 => 1*3 + 1*2 = 5, not 0
    // Use "209" with weight_start=2 (right-to-left: 9*2 + 0*3 + 2*4 = 18+0+8=26, not 0)
    // Let's find one: digits "121" ws=2 => right-left: 1*2+2*3+1*4=2+6+4=12, not 0 mod 11
    // "11" ws=2 => 1*2+1*3=5 no. "22" ws=2 => 2*2+2*3=10 no. "33" ws=2 => 3*2+3*3=15=4 mod11 no
    // "44" ws=2: 4*2+4*3=8+12=20=9 no. "242" ws=2: 2*2+4*3+2*4=4+12+8=24=2 no.
    // "033" ws=2: 3*2+3*3+0*4=6+9+0=15=4 no.
    // Simple: single digit "0" ws=2: 0*2=0 mod11=0 YES.
    let r9 = vln_mod11_valid("0", 2)
    if r9 == false
        print("FAIL KAT9: vln_mod11_valid(0, 2) expected true")
        exit(1)

    // --- KAT 10: vln_mod11_valid — non-zero check ---
    // "1" ws=2: 1*2=2, not 0 mod 11
    let r10 = vln_mod11_valid("1", 2)
    if r10 == true
        print("FAIL KAT10: vln_mod11_valid(1, 2) expected false")
        exit(1)

    // --- KAT 11: vln_luhn_check for all-zeros gives 0 ---
    let r11 = vln_luhn_check("0")
    if r11 != 0
        print("FAIL KAT11: vln_luhn_check(0) expected 0 got " + str(r11))
        exit(1)

    // --- KAT 12: vln_verhoeff_valid longer known-valid number ---
    let r12 = vln_verhoeff_valid("1428570")
    if r12 == false
        print("FAIL KAT12: vln_verhoeff_valid(1428570) expected true")
        exit(1)

    print("_luhn2_test passed")
