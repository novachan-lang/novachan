import forge_quorum

fn main()
    let q = q_new(5)
    q = q_propose(q, "prop-1")
    assert(q_status(q, "prop-1") == "pending", "starts pending")
    assert(q_proposal_count(q) == 1, "1 proposal")

    q = q_vote(q, "prop-1", "node-1", 1)
    q = q_vote(q, "prop-1", "node-2", 1)
    assert(q_votes_for(q, "prop-1") == 2, "2 for")
    assert(q_status(q, "prop-1") == "pending", "still pending")
    assert(q_has_quorum(q, "prop-1") == 0, "no quorum yet")

    q = q_vote(q, "prop-1", "node-3", 1)
    assert(q_status(q, "prop-1") == "accepted", "accepted at 3/5")
    assert(q_has_quorum(q, "prop-1") == 1, "has quorum")

    q = q_propose(q, "prop-2")
    q = q_vote(q, "prop-2", "node-1", 0)
    q = q_vote(q, "prop-2", "node-2", 0)
    q = q_vote(q, "prop-2", "node-3", 0)
    assert(q_status(q, "prop-2") == "rejected", "rejected at 3 against")
    assert(q_votes_against(q, "prop-2") == 3, "3 against")

    assert(q_status(q, "nonexistent") == "", "missing = empty")
    assert(q_votes_for(q, "nonexistent") == 0, "no votes")

    print("QUORUM KAT PASS")
