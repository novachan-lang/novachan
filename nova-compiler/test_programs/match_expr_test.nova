type Token
    kind: string
    value: string

fn test()
    let tokens = [Token("num", "42"), Token("op", "+"), Token("num", "5")]

    let val0 = match tokens[0]
        Token(kind, value) => int(value)

    print("val0: " + str(val0))

    let op = match tokens[1]
        Token(kind, value) => value

    print("op: " + op)

    let val2 = match tokens[2]
        Token(kind, value) => int(value)

    print("val2: " + str(val2))

test()
