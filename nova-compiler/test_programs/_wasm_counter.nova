// WASM frontend: a stateful COUNTER -- EVENT + LOGIC + RENDER in NOVA, state in a persistent wasm cell.
// JS invokes bump() on a "click"; NOVA reads the cell, increments it, and re-renders via dom_set_text.
extern fn dom_get_by_id(id: string) -> int
extern fn dom_set_text(node: int, txt: string)
extern fn nova_state_get() -> int
extern fn nova_state_set(v: int)
fn render()
    let node = unsafe dom_get_by_id("count")
    let c = unsafe nova_state_get()
    unsafe dom_set_text(node, "count: " + str(c))
fn init()
    unsafe nova_state_set(0)
    render()
fn bump()
    let c = unsafe nova_state_get()
    unsafe nova_state_set(c + 1)
    render()
fn main()
    init()
