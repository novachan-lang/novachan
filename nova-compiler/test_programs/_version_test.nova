import std/core/version

fn main()
    // version constants
    assert(len(nova_version()) > 0, "nova_version non-empty")
    assert(len(stdlib_version()) > 0, "stdlib_version non-empty")
    assert(len(forge_version()) > 0, "forge_version non-empty")

    // version_triple
    let t = version_triple("1.2.3")
    assert(t[0] == 1, "major")
    assert(t[1] == 2, "minor")
    assert(t[2] == 3, "patch")

    let t2 = version_triple("0.1.0-alpha")
    assert(t2[0] == 0, "pre major")
    assert(t2[1] == 1, "pre minor")
    assert(t2[2] == 0, "pre patch")

    // version_gte
    assert(version_gte("1.0.0", "0.9.0"), "1.0.0 >= 0.9.0")
    assert(version_gte("0.1.0", "0.1.0"), "equal")
    assert(version_gte("0.2.0", "0.1.0"), "minor bump")
    assert(not version_gte("0.0.9", "0.1.0"), "0.0.9 < 0.1.0")

    // version_compatible (same major)
    assert(version_compatible("0.1.5", "0.1.0"), "0.1.5 compat 0.1.0")
    assert(not version_compatible("1.0.0", "0.1.0"), "major mismatch")

    // version_info dict
    let info = version_info()
    assert("nova" in info, "info has nova")
    assert("stdlib" in info, "info has stdlib")
    assert("forge" in info, "info has forge")
    assert("abi" in info, "info has abi")

    print("PASS: version_test")
