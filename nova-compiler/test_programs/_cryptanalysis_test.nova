// KAT test for std/crypto/cryptanalysis -- classical-cipher cryptanalysis toolkit.
// Covers: ic_score, best_caesar_shift (round-trip), vigenere cracking, autocorrelation.
import std/crypto/cryptanalysis

// --- helpers ---

fn ckf(label: string, got: float, want: float, tol: float)
    let diff = got - want
    if diff < 0.0
        diff = 0.0 - diff
    if diff < tol
        return
    print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
    exit(1)

fn cki(label: string, got: int, want: int)
    if got == want
        return
    print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
    exit(1)

fn cks(label: string, got: string, want: string)
    if got == want
        return
    print("FAIL " + label + ": got=" + got + " want=" + want)
    exit(1)

fn ckb(label: string, got: bool)
    if got
        return
    print("FAIL " + label + ": expected true")
    exit(1)

// PRIVATE local encrypt helper (forward Caesar, for KAT setup — NOT from the module).
fn _test_caesar_encrypt(text: string, shift: int) -> string
    let sh = ((shift % 26) + 26) % 26
    let out = ""
    let i = 0
    while i < len(text)
        let c = char_at(text, i)
        let o = ord(c)
        if o >= 65 and o <= 90
            out = out + chr(65 + (o - 65 + sh) % 26)
        else
            if o >= 97 and o <= 122
                out = out + chr(97 + (o - 97 + sh) % 26)
            else
                out = out + c
        i = i + 1
    out

// --- IC score KATs ---

// 'ABCDEFGHIJKLMNOPQRSTUVWXYZ': each letter once, n_i=1 so n_i*(n_i-1)=0 for all, IC=0.0
let ic1 = ic_score("ABCDEFGHIJKLMNOPQRSTUVWXYZ")
ckf("ic_26distinct", ic1, 0.0, 0.001)

// '10 A's: only one distinct letter, N=10, numerator=10*9=90, denom=10*9=90, IC=1.0
let ic2 = ic_score("AAAAAAAAAA")
ckf("ic_10As", ic2, 1.0, 0.001)

// Empty string: should return 0.0 (no letters)
let ic3 = ic_score("")
ckf("ic_empty", ic3, 0.0, 0.001)

// ic_expected values
ckf("ic_english", ic_expected_english(), 0.0667, 0.001)
ckf("ic_random",  ic_expected_random(),  0.0385, 0.001)

// --- english_freq KATs ---
ckf("freq_E", english_freq("E"), 12.70, 0.01)
ckf("freq_Z", english_freq("Z"), 0.07, 0.01)
ckf("freq_T", english_freq("T"), 9.06, 0.01)
ckf("freq_A", english_freq("A"), 8.17, 0.01)

// --- best_caesar_shift round-trip KAT ---
// Plaintext: a well-known pangram
let plaintext = "the quick brown fox jumps over the lazy dog the end"
// Encrypt forward by 3 using our local helper
let ciphertext = _test_caesar_encrypt(plaintext, 3)
// The best shift should recover shift=3
let found_shift = best_caesar_shift(ciphertext)
cki("best_caesar_shift_3", found_shift, 3)
// Round-trip: decrypting with that shift recovers plaintext (letters only, but case preserved)
let recovered = caesar_decrypt(ciphertext, found_shift)
cks("caesar_roundtrip", recovered, plaintext)

// Caesar decrypt basic sanity
cks("caesar_dec_abc", caesar_decrypt("DEF", 3), "ABC")
cks("caesar_dec_wrap", caesar_decrypt("ABC", 3), "XYZ")

// --- autocorrelation KAT ---
// 'ABCAB' vs shift 3: A==A yes, B==B yes => 2
let ac1 = autocorrelation("ABCAB", 3)
cki("autocorr_ABCAB_3", ac1, 2)
// All same letters: 'AAAAA' shift 1 => 4 matches (5-1)
let ac2 = autocorrelation("AAAAA", 1)
cki("autocorr_AAAAA_1", ac2, 4)
// Empty: 0
let ac3 = autocorrelation("", 1)
cki("autocorr_empty", ac3, 0)

// --- chi_square_english KAT ---
// English text should have lower chi-square than random-looking text
let chi_english = chi_square_english("the quick brown fox jumps over the lazy dog")
let chi_random  = chi_square_english("XQZJKVWPFMBGCYDHLRUNETIOAS")
// chi_english should be meaningfully lower (English IC ~ 0.067 vs random alphabet)
ckb("chi_english_lt_random", chi_english < chi_random * 3.0)

// --- vigenere crack KAT (round-trip property) ---
// Use a longer Vigenere ciphertext encrypted with key "E" (shift=4, 1-letter key).
// For a 1-letter key, crack_vigenere(cipher, 1) == best_caesar_shift applied to the whole ciphertext.
// Use the same long pangram text, already encrypted by best_caesar_shift=3 round-trip above,
// but create a new 1-letter key scenario for the crack test.
// Encrypt a long English text with shift 7 (key="H"), then crack with keylen=1.
let long_plain = "THEQUICKBROWNFOXJUMPSOVERTHELAZYDOG"
let long_cipher = _test_caesar_encrypt(long_plain, 7)
let cracked_key = crack_vigenere(long_cipher, 1)
cks("crack_vigenere_H", cracked_key, "H")

// Verify column 0 with keylen=1 gives shift=7 (key letter 'H'=7)
let col0 = vigenere_key_column(long_cipher, 1, 0)
cki("vigenere_key_col0_H", col0, 7)

// kasiski_spacings: 'ABCABC' seqlen=3 -> one repeated 'ABC' at 0 and 3, spacing=3
let sps = kasiski_spacings("ABCABC", 3)
cki("kasiski_spacings_len", len(sps), 1)
cki("kasiski_spacings_0", sps[0], 3)

print("PASS _cryptanalysis_test")
