import std/statistics/stat_moving

fn ckf(label: str, got: float, want: float)
    let diff = got - want
    let adiff = diff
    if adiff < 0.0
        adiff = 0.0 - adiff
    if adiff > 0.001
        print("FAIL " + label + " got=" + str(got) + " want=" + str(want))
        exit(1)

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL " + label + " got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckfl(label: str, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + " len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        let gv = got[i] * 1.0
        let wv = want[i] * 1.0
        let diff = gv - wv
        let adiff = diff
        if adiff < 0.0
            adiff = 0.0 - adiff
        if adiff > 0.001
            print("FAIL " + label + "[" + str(i) + "] got=" + str(gv) + " want=" + str(wv))
            exit(1)
        i = i + 1

fn ckil(label: str, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + " len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL " + label + "[" + str(i) + "] got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // KAT 1: smv_sma([1,2,3,4], 2) = [1.5, 2.5, 3.5]
    let sma1 = [1, 2, 3, 4]
    let smar1 = smv_sma(sma1, 2)
    let smaw1 = [1.5, 2.5, 3.5]
    ckfl("smv_sma([1,2,3,4],2)", smar1, smaw1)

    // KAT 2: smv_sma([2,4,6,8], 3) = [4.0, 6.0]
    let sma2 = [2, 4, 6, 8]
    let smar2 = smv_sma(sma2, 3)
    let smaw2 = [4.0, 6.0]
    ckfl("smv_sma([2,4,6,8],3)", smar2, smaw2)

    // KAT 3: smv_cumulative([1,2,3]) = [1,3,6]
    let cum1 = [1, 2, 3]
    let cumr1 = smv_cumulative(cum1)
    let cumw1 = [1, 3, 6]
    ckil("smv_cumulative([1,2,3])", cumr1, cumw1)

    // KAT 4: smv_wma([1,2,3], 2)
    // w=2: wsum = 1+2 = 3
    // i=0: (1*1 + 2*2)/3 = 5/3 = 1.6667
    // i=1: (2*1 + 3*2)/3 = 8/3 = 2.6667
    let wma1 = [1, 2, 3]
    let wmar1 = smv_wma(wma1, 2)
    let wmaw1 = [1.6667, 2.6667]
    ckfl("smv_wma([1,2,3],2)", wmar1, wmaw1)

    // KAT 5: smv_ema([1,2,3], 1, 2) — alpha = 1/2 = 0.5
    // ema[0] = 1.0
    // ema[1] = 0.5*2 + 0.5*1 = 1.0 + 0.5 = 1.5
    // ema[2] = 0.5*3 + 0.5*1.5 = 1.5 + 0.75 = 2.25
    let ema1 = [1, 2, 3]
    let emar1 = smv_ema(ema1, 1, 2)
    let emaw1 = [1.0, 1.5, 2.25]
    ckfl("smv_ema([1,2,3],1,2)", emar1, emaw1)

    // Edge: empty list returns []
    let empty = []
    let esma = smv_sma(empty, 2)
    if len(esma) != 0
        print("FAIL smv_sma([],2) expected empty")
        exit(1)
    let ecum = smv_cumulative(empty)
    if len(ecum) != 0
        print("FAIL smv_cumulative([]) expected empty")
        exit(1)

    // Edge: window > len returns []
    let xs3 = [1, 2]
    let bigw = smv_sma(xs3, 5)
    if len(bigw) != 0
        print("FAIL smv_sma w>n expected empty")
        exit(1)

    print("PASS _stat_moving_test")
