// Proves crash isolation on the concurrent HTTPS path: a route handler that PANICS must NOT hang the accept
// loop's drain or leak the connection -- the monitored sub-process contains the crash, the parent always
// sends the done-signal + closes the conn, and OTHER clients are still served + the server returns cleanly.
import forge
import forge_https

fn app_crash(req)
    panic("intentional handler crash")

fn app_ok(req)
    text(200, "OK-AFTER-CRASH")

fn main()
    let a = app()
    get(a, "/crash", app_crash)
    get(a, "/ok", app_ok)
    forge_serve_tls_app_n(a, 44337, 2)
    print("PANIC-SERVED-DONE")
