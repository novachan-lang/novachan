// KAT: LOCK-4 inc3c -- f32 is a REAL width, not a label.
//
// The bar this has to clear: an earlier attempt made the f32 annotation parse while still
// storing f64, and it was reverted as WORSE than an unsupported width, because a width that
// silently lies is worse than one that errors. So every case below checks an OBSERVABLE
// difference from f64, not merely that f32 compiles.
//
// 16777217 is the first integer not representable in binary32 (it rounds to 16777216), and
// 0.1+0.2 / 1÷3 differ visibly between the two precisions.

fn src() -> float
    16777217.0

fn main()
    let ok = 0
    let fail = 0

    // ── literal suffix ───────────────────────────────────────────────────
    if str(16777217.0f32) == "16777216.0" and str(16777217.0) == "16777217.0"
        ok = ok + 1
        print("ok: literal 16777217.0f32 rounds; the f64 literal does not")
    else
        fail = fail + 1
        print("FAIL literal: " + str(16777217.0f32))

    // ── arithmetic really is 32-bit, not f64 wearing a label ────────────
    if str(0.1f32 + 0.2f32) == "0.300000011920929" and str(0.1 + 0.2) == "0.3"
        ok = ok + 1
        print("ok: f32 addition rounds every step (0.1+0.2 differs from f64)")
    else
        fail = fail + 1
        print("FAIL add: " + str(0.1f32 + 0.2f32))

    if str(1.0f32 / 3.0f32) == "0.333333343267441" and str(1.0 / 3.0) == "0.333333333333333"
        ok = ok + 1
        print("ok: f32 division rounds (1/3 differs from f64)")
    else
        fail = fail + 1
        print("FAIL div: " + str(1.0f32 / 3.0f32))

    // ── through a variable: the slot round-trip must not lose the width ──
    let v = 16777217.0f32
    let w = v + 0.0f32
    if str(v) == "16777216.0" and str(w) == "16777216.0"
        ok = ok + 1
        print("ok: width survives a slot store/load")
    else
        fail = fail + 1
        print("FAIL slot: " + str(v) + " " + str(w))

    // ── negation ────────────────────────────────────────────────────────
    if str(-16777217.0f32) == "-16777216.0"
        ok = ok + 1
        print("ok: unary negation rounds at width")
    else
        fail = fail + 1
        print("FAIL neg: " + str(-16777217.0f32))

    // ── the ANNOTATION, which is what a developer writes first ──────────
    let a: f32 = 16777217.0
    let b: f32 = src()
    let c: f32 = 0.1
    let d: f32 = 0.2
    if str(a) == "16777216.0" and str(b) == "16777216.0" and str(c + d) == "0.300000011920929"
        ok = ok + 1
        print("ok: `let x: f32 = ...` narrows const AND runtime initialisers")
    else
        fail = fail + 1
        print("FAIL annotation: " + str(a) + " " + str(b) + " " + str(c + d))

    // ── explicit conversions ────────────────────────────────────────────
    let y = f32(0.1)
    let z = f32(0.2)
    if str(f32(16777217.0)) == "16777216.0" and str(y + z) == "0.300000011920929"
        ok = ok + 1
        print("ok: f32() narrows and its RESULT keeps the width")
    else
        fail = fail + 1
        print("FAIL f32(): " + str(f32(16777217.0)) + " " + str(y + z))

    // f64() is the legal way to cross the width boundary
    if str(f64(a) + 2.5) == "16777218.5"
        ok = ok + 1
        print("ok: f64() widens, crossing the width boundary explicitly")
    else
        fail = fail + 1
        print("FAIL f64(): " + str(f64(a) + 2.5))

    // ── ordinary float code must be completely unaffected ───────────────
    let p = 1.0
    let q = 3.0
    if str(p / q) == "0.333333333333333" and str(2.5 * 4.0) == "10.0" and str(-1.5) == "-1.5"
        ok = ok + 1
        print("ok: default f64 arithmetic unchanged")
    else
        fail = fail + 1
        print("FAIL default float regressed")

    print("ok=" + str(ok) + " fail=" + str(fail))
    assert(fail == 0, "f32: all checks pass")
    assert(ok == 9, "f32: all 9 checks ran")
    print("KAT f32 PASS")
