// KAT test for std/text/sentiment
import std/text/sentiment

fn ckf(label, got, expected, eps)
    let diff = got - expected
    if diff < 0.0
        diff = 0.0 - diff
    if diff > eps
        print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + got + " expected=" + expected)
        exit(1)

fn ck_true(label, got)
    if not got
        print("FAIL " + label + ": expected true got false")
        exit(1)

fn ck_false(label, got)
    if got
        print("FAIL " + label + ": expected false got true")
        exit(1)

fn main()
    // KAT 1: positive text gives positive score
    let s1 = sen_score("this is great and wonderful")
    if s1 <= 0.0
        print("FAIL score_positive: got=" + str(s1))
        exit(1)

    // KAT 2: negative text gives negative score
    let s2 = sen_score("this is terrible and awful")
    if s2 >= 0.0
        print("FAIL score_negative: got=" + str(s2))
        exit(1)

    // KAT 3: polarity of clearly positive text
    let p3 = sen_polarity("i love this amazing product")
    cks("polarity_positive", p3, "positive")

    // KAT 4: polarity of clearly negative text
    let p4 = sen_polarity("the worst horrible experience")
    cks("polarity_negative", p4, "negative")

    // KAT 5: sen_is_positive
    ck_true("is_positive", sen_is_positive("good nice happy"))

    // KAT 6: sen_is_negative
    ck_true("is_negative", sen_is_negative("bad terrible awful"))

    // KAT 7: negation — "not good" should score less than "good"
    let s_good = sen_score("good")
    let s_not_good = sen_score("not good")
    if s_not_good >= s_good
        print("FAIL negation: not_good=" + str(s_not_good) + " good=" + str(s_good))
        exit(1)

    // KAT 8: intensifier — "very good" should score more than "good"
    let s_very_good = sen_score("very good")
    if s_very_good <= s_good
        print("FAIL intensifier: very_good=" + str(s_very_good) + " good=" + str(s_good))
        exit(1)

    // KAT 9: sen_compound of positive text in (0,1]
    let comp9 = sen_compound("i love this amazing product")
    if comp9 <= 0.0
        print("FAIL compound_positive_lower: got=" + str(comp9))
        exit(1)
    if comp9 > 1.0
        print("FAIL compound_positive_upper: got=" + str(comp9))
        exit(1)

    // KAT 10: sen_compound of negative text in [-1,0)
    let comp10 = sen_compound("terrible awful horrible")
    if comp10 >= 0.0
        print("FAIL compound_negative_upper: got=" + str(comp10))
        exit(1)
    let neg_one = 0.0 - 1.0
    if comp10 < neg_one
        print("FAIL compound_negative_lower: got=" + str(comp10))
        exit(1)

    // KAT 11: sen_count_positive counts only positive-polarity words
    let cp11 = sen_count_positive("good nice bad")
    cki("count_positive", cp11, 2)

    // KAT 12: sen_count_negative counts only negative-polarity words
    let cn12 = sen_count_negative("good terrible awful")
    cki("count_negative", cn12, 2)

    // KAT 13: sen_word_score for known positive word
    let ws13 = sen_word_score("great")
    if ws13 <= 0.0
        print("FAIL word_score_great: got=" + str(ws13))
        exit(1)

    // KAT 14: sen_word_score for unknown word returns 0.0
    let ws14 = sen_word_score("elephant")
    ckf("word_score_unknown", ws14, 0.0, 0.001)

    // KAT 15: sen_normalize for empty text returns 0.0
    let nm15 = sen_normalize("")
    ckf("normalize_empty", nm15, 0.0, 0.001)

    // KAT 16: sen_intensifiers has 'very'
    let ints = sen_intensifiers()
    if not contains(ints, "very")
        print("FAIL intensifiers_very: missing key 'very'")
        exit(1)

    // KAT 17: sen_negators has 'not'
    let negs = sen_negators()
    let has_not = 0
    let ni = 0
    while ni < len(negs)
        if negs[ni] == "not"
            has_not = 1
        ni = ni + 1
    cki("negators_not", has_not, 1)

    // KAT 18: neutral text scores as neutral
    let p18 = sen_polarity("the cat sat on the mat")
    cks("polarity_neutral", p18, "neutral")

    // KAT 19: negator within 2 positions still negates
    // "not very good" — negator at i-2 relative to "good"
    let s19 = sen_score("not very good")
    if s19 >= s_good
        print("FAIL negator_at_2: not_very_good=" + str(s19) + " good=" + str(s_good))
        exit(1)

    print("PASS _sentiment_test")
