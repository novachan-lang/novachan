// forge_redis binary-safety (Wave-C #11): bulk values with embedded 0x00 survive encode+parse intact.
import forge_redis

fn _crlf() -> string
    chr(13) + chr(10)

fn main()
    // A binary value "A\0B" = bytes [65, 0, 66]
    let val = bytes(0)
    val = bytes_append(val, 65)
    val = bytes_append(val, 0)
    val = bytes_append(val, 66)

    // 1) Parse a hand-built $-bulk reply carrying the 0x00: "$3\r\nA\0B\r\n"
    let wire = bytes(0)
    wire = bytes_append_str(wire, "$3" + _crlf())
    wire = bytes_concat(wire, val)
    wire = bytes_append_str(wire, _crlf())
    let p = resp_parse(wire, 0)
    if p[0] != "bulk"
        print("FAIL bulk-kind: " + p[0])
        exit(1)
    let got = p[1]
    if bytes_len(got) != 3
        print("FAIL bulk-len: " + str(bytes_len(got)) + " want 3")
        exit(1)
    if bytes_get(got, 0) != 65 or bytes_get(got, 1) != 0 or bytes_get(got, 2) != 66
        print("FAIL bulk-bytes (0x00 lost)")
        exit(1)

    // 2) resp_encode round-trip: [SET, "k", val] -> wire -> parse array; 3rd elem must be the 0x00 value
    let cmd = resp_encode([str_to_bytes("SET"), str_to_bytes("k"), val])
    let arr = resp_parse(cmd, 0)
    if arr[0] != "array"
        print("FAIL arr-kind: " + arr[0])
        exit(1)
    let items = arr[1]
    if len(items) != 3
        print("FAIL arr-len: " + str(len(items)))
        exit(1)
    let third = items[2]
    if bytes_len(third) != 3 or bytes_get(third, 1) != 0 or bytes_get(third, 2) != 66
        print("FAIL roundtrip-value (0x00 truncated on encode/parse)")
        exit(1)

    // 3) simple-string + integer replies still parse (text path intact)
    let ok = resp_parse(bytes_append_str(bytes(0), "+OK" + _crlf()), 0)
    if ok[0] != "str" or ok[1] != "OK"
        print("FAIL simple-string")
        exit(1)
    let num = resp_parse(bytes_append_str(bytes(0), ":42" + _crlf()), 0)
    if num[0] != "int" or num[1] != 42
        print("FAIL integer")
        exit(1)

    // 4) an error reply is tagged "err" (NOT "bulk") and a missing-key is "nil" -- the precondition the
    //    redis_get/redis_get_bytes guards rely on (found=true ONLY when kind=="bulk", so an error reply
    //    can never be mislabeled as a found value with the error text as the payload).
    let er = resp_parse(bytes_append_str(bytes(0), "-WRONGTYPE Operation against a key" + _crlf()), 0)
    if er[0] != "err"
        print("FAIL error-reply-kind: '" + er[0] + "'")
        exit(1)
    let niln = resp_parse(bytes_append_str(bytes(0), "$-1" + _crlf()), 0)
    if niln[0] != "nil"
        print("FAIL nil-reply-kind: '" + niln[0] + "'")
        exit(1)
    // a genuine bulk value IS "bulk" (the only shape redis_get treats as found)
    let blk = resp_parse(bytes_append_str(bytes_append_str(bytes(0), "$2" + _crlf() + "hi" + _crlf()), ""), 0)
    if blk[0] != "bulk"
        print("FAIL bulk-reply-kind: '" + blk[0] + "'")
        exit(1)

    print("PASS _redis_binsafe_test")
