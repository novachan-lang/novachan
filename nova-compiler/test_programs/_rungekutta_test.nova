// KAT test for std/numeric/rungekutta — RK4 ODE solver dy/dt = f(t, y).
//
// ODE test cases:
//   fconst: dy/dt = 2  =>  exact solution y(t) = y0 + 2t
//           RK4 is EXACT for polynomials <= degree 3 (constant slope is degree 0).
//   fexp:   dy/dt = y  =>  exact solution y(t) = y0 * e^t
//           RK4 approximates e very closely (O(h^4) error).
//
// KAT assertions:
//   1. rk_final(fconst,0.0,0.0,0.1,10)  == 2.0         [y(1)=2.0, exact for const slope]
//   2. rk_final(fconst,0.0,5.0,0.5,4)   == 9.0         [y(2)=9.0, y0=5 + 2*2]
//   3. rk_final(fexp,  0.0,1.0,0.1,10)  ~= 2.71828     [e^1, eps 0.001]
//   4. rk_final(fexp,  0.0,1.0,0.01,100)~= 2.71828     [e^1 finer steps, eps 0.001]
//   5. len(rk_solve(fconst,0.0,0.0,0.1,10)) == 11      [steps+1 entries]
//   6. rk_solve first pair t-value == t0
//   7. rk_solve last  pair y-value matches rk_final     [trajectory consistent]
//   8. rk_final(fconst,0.0,0.0,0.01,1000) == 20.0      [stress: y(10)=20, exact]
import std/numeric/rungekutta

// Named top-level ODEs — no closures.

// dy/dt = 2  (constant slope — RK4 exact)
fn fconst(t, y) -> float
    return 2.0

// dy/dt = y  (exponential growth — y(t) = e^t when y0=1)
fn fexp(t, y) -> float
    return y

// Float-close check helper
fn ckf(label: string, got: float, want: float, eps: float)
    let d = got - want
    if d < 0.0
        d = 0.0 - d
    if d > eps
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("ok " + label)

fn main()
    // KAT 1: dy/dt=2, y(0)=0, h=0.1, 10 steps => y(1)=2.0 (exact for const)
    let r1 = rk_final(fconst, 0.0, 0.0, 0.1, 10)
    ckf("fconst y(1)=2.0", r1, 2.0, 0.0001)

    // KAT 2: dy/dt=2, y(0)=5, h=0.5, 4 steps => y(2)=9.0 (5+2*2, exact)
    let r2 = rk_final(fconst, 0.0, 5.0, 0.5, 4)
    ckf("fconst y0=5 y(2)=9.0", r2, 9.0, 0.0001)

    // KAT 3: dy/dt=y, y(0)=1, h=0.1, 10 steps => approx e^1 = 2.71828 (eps=0.001)
    let r3 = rk_final(fexp, 0.0, 1.0, 0.1, 10)
    ckf("fexp y(1)~e h=0.1", r3, 2.71828, 0.001)

    // KAT 4: dy/dt=y, y(0)=1, h=0.01, 100 steps => approx e^1 (finer, eps=0.001)
    let r4 = rk_final(fexp, 0.0, 1.0, 0.01, 100)
    ckf("fexp y(1)~e h=0.01", r4, 2.71828, 0.001)

    // KAT 5: rk_solve returns steps+1 entries
    let traj = rk_solve(fconst, 0.0, 0.0, 0.1, 10)
    let n = len(traj)
    if n != 11
        print("FAIL traj length: got " + str(n) + " want 11")
        exit(1)
    print("ok traj length==11")

    // KAT 6: first pair t-value == t0 (should be 0.0)
    let first_pair = traj[0]
    let t0_got = first_pair[0]
    ckf("traj[0].t==0.0", t0_got, 0.0, 0.0001)

    // KAT 7: last pair y-value matches rk_final result (trajectory consistent)
    let last_pair = traj[10]
    let y_last = last_pair[1]
    ckf("traj[10].y==rk_final", y_last, r1, 0.0001)

    // KAT 8: stress — 1000 steps, y(10)=20.0 (exact for const slope)
    let r8 = rk_final(fconst, 0.0, 0.0, 0.01, 1000)
    ckf("fconst y(10)=20.0 stress", r8, 20.0, 0.0001)

    print("_rungekutta_test passed")
