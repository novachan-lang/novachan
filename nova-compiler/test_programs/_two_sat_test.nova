// KAT test for std/graph/two_sat.
import std/graph/two_sat

fn cki(name, got, want)
    if got != want
        print("FAIL " + name + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("ok " + name)

fn ckb(name, got, want)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + name + ": got " + str(gi) + " want " + str(wi))
        exit(1)
    print("ok " + name)

fn ckl(name, got, want)
    if len(got) != len(want)
        print("FAIL " + name + ": len got " + str(len(got)) + " want " + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL " + name + ": got[" + str(i) + "]=" + str(got[i]) + " want " + str(want[i]))
            exit(1)
        i = i + 1
    print("ok " + name)

// verify_clauses: check that a given assignment satisfies all clauses.
// Returns 1 if all satisfied, 0 otherwise.
fn verify_clauses(asgn, clauses)
    let ok = 1
    let ci = 0
    while ci < len(clauses)
        let cl = clauses[ci]
        let av = cl[0]
        let an = cl[1]
        let bv = cl[2]
        let bn = cl[3]
        let la = asgn[av]
        if an == 1
            if la == 1
                la = 0
            else
                la = 1
        let lb = asgn[bv]
        if bn == 1
            if lb == 1
                lb = 0
            else
                lb = 1
        if la == 0 and lb == 0
            ok = 0
        ci = ci + 1
    return ok

fn main()
    // -- KAT 1: (x0 OR x1) AND (NOT x0 OR x1) -> SAT, x1 must be 1
    // clauses: [0,0,1,0] = (x0 OR x1), [0,1,1,0] = (NOT x0 OR x1)
    let cl1 = []
    let c1a = []
    c1a.push(0)
    c1a.push(0)
    c1a.push(1)
    c1a.push(0)
    cl1.push(c1a)
    let c1b = []
    c1b.push(0)
    c1b.push(1)
    c1b.push(1)
    c1b.push(0)
    cl1.push(c1b)

    ckb("sat1 solvable", ts_solvable(2, cl1), true)
    let a1 = ts_assignment(2, cl1)
    cki("sat1 asgn len", len(a1), 2)
    cki("sat1 verify", verify_clauses(a1, cl1), 1)

    // -- KAT 2: (x0 OR x0) AND (NOT x0 OR NOT x0) -> UNSAT (x0 must be both T and F)
    let cl2 = []
    let c2a = []
    c2a.push(0)
    c2a.push(0)
    c2a.push(0)
    c2a.push(0)
    cl2.push(c2a)
    let c2b = []
    c2b.push(0)
    c2b.push(1)
    c2b.push(0)
    c2b.push(1)
    cl2.push(c2b)

    ckb("unsat1 solvable", ts_solvable(1, cl2), false)
    ckl("unsat1 asgn", ts_assignment(1, cl2), [])

    // -- KAT 3: 3-var SAT: (x0 OR x1) AND (NOT x1 OR x2) AND (NOT x0 OR NOT x2)
    // [0,0,1,0],[1,1,2,0],[0,1,2,1]
    let cl3 = []
    let c3a = []
    c3a.push(0)
    c3a.push(0)
    c3a.push(1)
    c3a.push(0)
    cl3.push(c3a)
    let c3b = []
    c3b.push(1)
    c3b.push(1)
    c3b.push(2)
    c3b.push(0)
    cl3.push(c3b)
    let c3c = []
    c3c.push(0)
    c3c.push(1)
    c3c.push(2)
    c3c.push(1)
    cl3.push(c3c)

    ckb("sat3 solvable", ts_solvable(3, cl3), true)
    let a3 = ts_assignment(3, cl3)
    cki("sat3 asgn len", len(a3), 3)
    cki("sat3 verify", verify_clauses(a3, cl3), 1)

    // -- KAT 4: 2-var UNSAT: (x0 OR x0) AND (NOT x0 OR NOT x0) (same as KAT2, different order)
    let cl4 = []
    let c4a = []
    c4a.push(0)
    c4a.push(0)
    c4a.push(0)
    c4a.push(0)
    cl4.push(c4a)
    let c4b = []
    c4b.push(0)
    c4b.push(1)
    c4b.push(0)
    c4b.push(1)
    cl4.push(c4b)

    ckb("unsat2 solvable", ts_solvable(2, cl4), false)

    // -- KAT 5: len(ts_assignment(2, sat clauses)) == 2
    cki("sat1 asgn len direct", len(ts_assignment(2, cl1)), 2)

    // -- KAT 6: empty clause list (any assignment works)
    ckb("empty clauses solvable", ts_solvable(2, []), true)
    let ae = ts_assignment(2, [])
    cki("empty clauses asgn len", len(ae), 2)

    // -- KAT 7: single-variable single clause (x0 OR x0) -> x0=1
    let cl7 = []
    let c7a = []
    c7a.push(0)
    c7a.push(0)
    c7a.push(0)
    c7a.push(0)
    cl7.push(c7a)
    ckb("single clause sat", ts_solvable(1, cl7), true)
    let a7 = ts_assignment(1, cl7)
    cki("single clause asgn[0]", a7[0], 1)

    print("PASS _two_sat_test")
