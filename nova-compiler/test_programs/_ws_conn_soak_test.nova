// _ws_conn_soak_test -- CONNECTION-CHURN soak for WebSocket. Opens hundreds of FRESH WS connections,
// each doing handshake + one masked echo round-trip + close. This probes per-CONNECTION lifecycle
// TEARDOWN (distinct from _ws_soak_test, which drives many MESSAGES over ONE connection): the server
// must reclaim each closed connection's state (Ws struct, recv buffer, fd registration) so live memory
// stays BOUNDED as the connection count grows. Catches a connection-teardown leak or an accept/close
// race that the single-connection soak and the 32-run _ws_mn_ci gate cannot. Self-contained: server +
// client are in-process green tasks, so run under NOVA_CARRIERS=4/8 to stress accept+teardown across
// carriers. The hard gates are SOUNDNESS (every echo byte-correct, no hang/crash over hundreds of
// connections) + BOUNDED server memory (not ~linear runaway in the connection count).
import forge

fn _b(s: string)
    let n = len(s)
    let out = bytes(0)
    let i = 0
    while i < n
        out = bytes_append(out, ord(char_at(s, i)))
        i = i + 1
    out

// serve_req_n serves EXACTLY n connections then shuts the listener down (deterministic/testable),
// so n MUST equal the client's connection count -- this is a finite, clean-exiting churn soak.
fn _server(port: int, n: int)
    let a = forge.app()
    forge.ws(a, "/echo", fn(c, m) forge.ws_emit_bin(c, m))
    forge.serve_req_n(a, port, n)

fn _ws_connect(port: int)
    let sock = tcp_connect("127.0.0.1", port)
    tcp_send(sock, "GET /echo HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n")
    let resp = tcp_recv(sock)
    while find(resp, "\r\n\r\n") < 0
        let more = tcp_recv(sock)
        if len(more) == 0
            return sock
        resp = resp + more
    sock

fn _read_frame(sock)
    let buf = bytes(0)
    let guard = 0
    while guard < 1000
        guard = guard + 1
        let fr = forge.ws_try_decode(buf, 0)
        if fr.status == 1
            return fr.payload
        let chunk = tcp_recv_bytes(sock)
        if bytes_len(chunk) == 0
            return bytes(0)
        buf = bytes_concat(buf, chunk)
    bytes(0)

fn main()
    let port = 19391
    let total = 400
    spawn fn()
        _server(port, total)
    sleep(300)

    let mask = [42, 99, 7, 200]
    let payload = _b("churn")
    let ok = 0
    let base = 0
    let i = 0
    while i < total
        // each connect/echo/close cycle in its own arena so the CLIENT side stays flat -> the global
        // live_count delta reflects the SERVER's per-connection residue, not client churn.
        let prev = arena_enter()
        let sock = _ws_connect(port)
        tcp_send_bytes(sock, forge.ws_encode_frame(1, 1, payload, mask))
        let got = bytes_to_str(_read_frame(sock))
        if got == "churn"
            ok = ok + 1
        // polite close: client Close frame, then drop the socket -> server tears the connection down
        tcp_send_bytes(sock, forge.ws_encode_frame(1, 8, bytes(0), mask))
        tcp_close(sock)
        arena_exit(prev)
        if i == 50
            sleep(150)        // let the server drain the first 50 closes before sampling the baseline
            base = live_count()
        i = i + 1

    sleep(250)                // let the server finish tearing down the last connections
    let delta = live_count() - base
    let per_conn = delta / 350
    print("conn-churn server live-object delta over ~350 closed connections = " + str(delta) + " (~" + str(per_conn) + "/conn)")
    // PRIMARY GATE = SOUNDNESS: every one of `total` churned connections completes a byte-correct echo
    // round-trip at whatever NOVA_CARRIERS is set -- no hang, no crash, no corruption across the full
    // connect -> 101 handshake -> echo -> Close handshake -> teardown cycle, repeated `total` times.
    assert(ok == total, "ALL " + str(total) + " connection echoes byte-correct (got " + str(ok) + ")")
    // MEMORY: WS connection setup+teardown is now FLAT. The old ~90/conn leak (transient strings in the
    // handshake -- char_at()/SHA-1/base64 -- created without a store, so neither FULLRC-dropped nor
    // arena-reclaimed because fat strings bypassed the arena) is FIXED: nova_fat_str_create now bumps into
    // the active arena, so per-connection transient strings are freed wholesale at arena_exit (plus the
    // connection-scoped arena in _ws_run reclaims Ws/buf/_ws_finish). Measured: ~1/conn at N=1 (the single
    // baseline FULLRC loop residue) and ~0/conn at N>1 -- identical to HTTP-connection churn. The bound is
    // now TIGHT: a per-connection STRUCTURAL leak (unfreed Ws/buffers/strings) would be many thousands.
    assert(delta < 4000, "WS connection teardown FLAT -- delta=" + str(delta) + " (~" + str(per_conn) + "/conn) over ~350 connections (no per-connection structural leak)")
    print("PASS: " + str(total) + " WS connection-churn cycles, all byte-correct + memory FLAT (~" + str(per_conn) + "/conn) at N>1")
    print("_ws_conn_soak_test passed")
