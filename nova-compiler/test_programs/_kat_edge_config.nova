import forge_edge_config

fn main()
    let ec = ec_new()
    ec = ec_add_device(ec, "sensor-01")
    ec = ec_add_device(ec, "gateway-01")
    assert(ec_device_count(ec) == 2, "2 devices")
    assert(ec_has_device(ec, "sensor-01") == 1, "has sensor")

    let c1 = ec_set_config(ec, "sensor-01", "interval", "30")
    ec = unwrap(c1)
    let c2 = ec_set_config(ec, "sensor-01", "threshold", "100")
    ec = unwrap(c2)
    let c3 = ec_set_config(ec, "gateway-01", "mode", "bridge")
    ec = unwrap(c3)
    assert(ec_config_count(ec) == 3, "3 configs")
    assert(ec_pending_count(ec) == 3, "3 pending")

    let gv = ec_get_config(ec, "sensor-01", "interval")
    assert(unwrap(gv) == "30", "interval 30")

    let a1 = ec_apply(ec, "sensor-01", "interval")
    ec = unwrap(a1)
    assert(ec_applied_count(ec) == 1, "1 applied")
    assert(ec_pending_count(ec) == 2, "2 pending")

    let st = ec_config_status(ec, "sensor-01", "interval")
    assert(unwrap(st) == "applied", "applied status")
    let st2 = ec_config_status(ec, "sensor-01", "threshold")
    assert(unwrap(st2) == "pending", "pending status")

    let dup = ec_apply(ec, "sensor-01", "interval")
    assert(is_err(dup), "already applied")

    let bad = ec_set_config(ec, "nope", "key", "val")
    assert(is_err(bad), "unknown device")

    print("EDGE-CONFIG KAT PASS")
