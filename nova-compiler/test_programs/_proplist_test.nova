import std/data/proplist

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + got + " expected " + expected)
        exit(1)

fn main()
    // Build: a->1, b->2, a->3
    let pl = pl_new()
    pl_add(pl, "a", 1)
    pl_add(pl, "b", 2)
    pl_add(pl, "a", 3)

    // KAT 1: pl_get("a") = 1  (first value for "a")
    cki("get_a_first", pl_get(pl, "a"), 1)

    // KAT 2: pl_get("b") = 2
    cki("get_b", pl_get(pl, "b"), 2)

    // KAT 3: pl_get("z") = null  (absent key)
    let gz = pl_get(pl, "z")
    cki("get_z_null", gz == null, 1)

    // KAT 4: pl_get_all("a") = [1, 3]
    let all_a = pl_get_all(pl, "a")
    cki("get_all_a_len", len(all_a), 2)
    cki("get_all_a_0", all_a[0], 1)
    cki("get_all_a_1", all_a[1], 3)

    // KAT 5: pl_get_all("z") = []
    let all_z = pl_get_all(pl, "z")
    cki("get_all_z_len", len(all_z), 0)

    // KAT 6: pl_keys() = ["a", "b", "a"]  (duplicates preserved, order preserved)
    let ks = pl_keys(pl)
    cki("keys_len", len(ks), 3)
    cks("keys_0", ks[0], "a")
    cks("keys_1", ks[1], "b")
    cks("keys_2", ks[2], "a")

    // KAT 7: pl_has("b") = 1
    cki("has_b", pl_has(pl, "b"), 1)

    // KAT 8: pl_has("z") = 0
    cki("has_z", pl_has(pl, "z"), 0)

    // KAT 9: pl_len = 3
    cki("len_3", pl_len(pl), 3)

    // KAT 10: pl_remove_first("a") -> pl_get("a")=3, pl_len=2
    pl_remove_first(pl, "a")
    cki("after_remove_get_a", pl_get(pl, "a"), 3)
    cki("after_remove_len", pl_len(pl), 2)

    // KAT 11: after removal, "b" still accessible
    cki("after_remove_get_b", pl_get(pl, "b"), 2)

    // KAT 12: pl_remove_first on absent key is no-op
    pl_remove_first(pl, "z")
    cki("remove_missing_len", pl_len(pl), 2)

    // KAT 13: pl_has("a") still true (second "a" pair remains)
    cki("has_a_after_remove_first", pl_has(pl, "a"), 1)

    // KAT 14: remove final "a" -> pl_has("a")=0
    pl_remove_first(pl, "a")
    cki("has_a_gone", pl_has(pl, "a"), 0)
    cki("final_len", pl_len(pl), 1)

    // KAT 15: only "b" remains
    let ks2 = pl_keys(pl)
    cki("final_keys_len", len(ks2), 1)
    cks("final_keys_0", ks2[0], "b")

    print("_proplist_test passed")

main()
