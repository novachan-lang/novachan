import std/tree/tree_prufer

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn ckl(label, got, want)
    if len(got) != len(want)
        print("FAIL " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL " + label + ": at " + str(i) + " got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

// Build tree5: 0 has children 1,2; 1 has children 3,4
// adj: [[1,2],[0,3,4],[0],[1],[1]]
fn make_tree5() -> list
    let a0 = [1, 2]
    let a1 = [0, 3, 4]
    let a2 = [0]
    let a3 = [1]
    let a4 = [1]
    let adj = []
    push(adj, a0)
    push(adj, a1)
    push(adj, a2)
    push(adj, a3)
    push(adj, a4)
    return adj

// Build star4: center 0, leaves 1,2,3
fn make_star4() -> list
    let a0 = [1, 2, 3]
    let a1 = [0]
    let a2 = [0]
    let a3 = [0]
    let adj = []
    push(adj, a0)
    push(adj, a1)
    push(adj, a2)
    push(adj, a3)
    return adj

// Build edge2: 0-1
fn make_edge2() -> list
    let a0 = [1]
    let a1 = [0]
    let adj = []
    push(adj, a0)
    push(adj, a1)
    return adj

// Count how many times v appears as a neighbor of u in adj (checks edge exists)
fn has_edge(adj, u, v) -> int
    let nbrs = adj[u]
    let i = 0
    while i < len(nbrs)
        if nbrs[i] == v
            return 1
        i = i + 1
    return 0

fn main()
    // KAT 1: encode tree5 -> [0,1,1]
    let seq1 = tp_encode(make_tree5(), 5)
    let want1 = [0, 1, 1]
    ckl("encode_tree5", seq1, want1)

    // KAT 2: encode star4 -> [0,0]
    let seq2 = tp_encode(make_star4(), 4)
    let want2 = [0, 0]
    ckl("encode_star4", seq2, want2)

    // KAT 3: encode edge2 -> [] (n=2 yields empty sequence)
    let seq3 = tp_encode(make_edge2(), 2)
    cki("encode_edge2_len", len(seq3), 0)

    // KAT 4: decode [0,0] n=4 -> star with 0 adjacent to 1,2,3
    let d4 = tp_decode(want2, 4)
    // node 0 should be adjacent to 1, 2, 3
    cki("decode_star_0adj1", has_edge(d4, 0, 1), 1)
    cki("decode_star_0adj2", has_edge(d4, 0, 2), 1)
    cki("decode_star_0adj3", has_edge(d4, 0, 3), 1)
    // leaves should only connect to 0
    cki("decode_star_deg1", len(d4[1]), 1)
    cki("decode_star_deg2", len(d4[2]), 1)
    cki("decode_star_deg3", len(d4[3]), 1)
    cki("decode_star_deg0", len(d4[0]), 3)

    // KAT 5: round-trip encode(decode([0,1,1],5),5) = [0,1,1]
    let d5 = tp_decode(want1, 5)
    let rt5 = tp_encode(d5, 5)
    ckl("roundtrip_0_1_1", rt5, want1)

    // KAT 6: decode n=2 with empty sequence -> edge 0-1
    let empty = []
    let d6 = tp_decode(empty, 2)
    cki("decode_n2_0adj1", has_edge(d6, 0, 1), 1)
    cki("decode_n2_1adj0", has_edge(d6, 1, 0), 1)

    // KAT 7: round-trip star4
    let rt7 = tp_encode(tp_decode(want2, 4), 4)
    ckl("roundtrip_star4", rt7, want2)

    // KAT 8: single node n=1, encode -> []
    let single_adj = [[]]
    let seq8 = tp_encode(single_adj, 1)
    cki("encode_single_len", len(seq8), 0)

    print("PASS _tree_prufer_test")
