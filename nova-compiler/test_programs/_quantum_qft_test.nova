import std/quantum/quantum_state
import std/quantum/quantum_qft

// cki — integer known-answer check.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _quantum_qft_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // qft_omega(4,0) == 1+0i ; qft_omega(4,1) == 0+1i (4th root of unity)
    let o40 = qft_omega(4, 0)
    cki("omega(4,0) re", float_to_int(o40[0] * 1000.0 + 0.5), 1000)
    cki("omega(4,0) im", float_to_int(o40[1] * 1000.0 + 0.5), 0)
    let o41 = qft_omega(4, 1)
    cki("omega(4,1) im", float_to_int(o41[1] * 1000.0 + 0.5), 1000)

    // qft_apply(|0>) on a single qubit -> uniform (|0>+|1>)/sqrt(2)
    let q0 = qst_basis(1, 0)
    let qf0 = qft_apply(q0)
    cki("qft(|0>) prob0", qst_prob_x1000(qf0, 0), 500)
    cki("qft(|0>) prob1", qst_prob_x1000(qf0, 1), 500)

    // qft_apply(|0...0>) (n=2) -> uniform superposition over all 4 basis states
    let z2 = qst_zero(2)
    let qfz2 = qft_apply(z2)
    cki("qft(zero2) prob0", qst_prob_x1000(qfz2, 0), 250)
    cki("qft(zero2) prob1", qst_prob_x1000(qfz2, 1), 250)
    cki("qft(zero2) prob2", qst_prob_x1000(qfz2, 2), 250)
    cki("qft(zero2) prob3", qst_prob_x1000(qfz2, 3), 250)

    // qft_apply(|0...0>) (n=3) -> uniform over all 8 basis states, each prob=1/8=125
    let z3 = qst_zero(3)
    let qfz3 = qft_apply(z3)
    cki("qft(zero3) prob0", qst_prob_x1000(qfz3, 0), 125)
    cki("qft(zero3) prob5", qst_prob_x1000(qfz3, 5), 125)
    cki("qft(zero3) prob7", qst_prob_x1000(qfz3, 7), 125)

    // round-trip: qft_inverse(qft_apply(x)) == x for several basis states
    let b21 = qst_basis(2, 1)
    let rt1 = qft_inverse(qft_apply(b21))
    cki("roundtrip basis(2,1)", qst_equal_x1000(rt1, b21), 1)

    let b23 = qst_basis(2, 3)
    let rt2 = qft_inverse(qft_apply(b23))
    cki("roundtrip basis(2,3)", qst_equal_x1000(rt2, b23), 1)

    let b30 = qst_basis(3, 5)
    let rt3 = qft_inverse(qft_apply(b30))
    cki("roundtrip basis(3,5)", qst_equal_x1000(rt3, b30), 1)

    // round-trip the other direction: qft_apply(qft_inverse(x)) == x
    let rt4 = qft_apply(qft_inverse(b23))
    cki("roundtrip inv-then-fwd basis(2,3)", qst_equal_x1000(rt4, b23), 1)

    // qft_matrix_entry_x1000_re: row 0 / col 0 of any QFT matrix is always 1/sqrt(N)
    // for N=4: 1/2 = 500
    cki("matrix_entry(4,0,0)", qft_matrix_entry_x1000_re(4, 0, 0), 500)
    // row 0 (or col 0) entries are all omega^0=1 -> Re=1/sqrt(N) for any r or c == 0
    cki("matrix_entry(4,0,3)", qft_matrix_entry_x1000_re(4, 0, 3), 500)
    cki("matrix_entry(4,3,0)", qft_matrix_entry_x1000_re(4, 3, 0), 500)
    // N=4, r=1,c=2 -> omega^2 = e^{i*pi} = -1 -> Re = -1/2 = -500
    cki("matrix_entry(4,1,2)", qft_matrix_entry_x1000_re(4, 1, 2), 0 - 500)
    // N=4, r=1,c=1 -> omega^1 = e^{i*pi/2} = i -> Re = 0
    cki("matrix_entry(4,1,1)", qft_matrix_entry_x1000_re(4, 1, 1), 0)

    print("PASS _quantum_qft_test")
