import forge_hamming

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // classic examples
    fails = fails + expect("karolin", str(hamming_distance("karolin", "kathrin")), "3")
    fails = fails + expect("binary", str(hamming_distance("1011101", "1001001")), "2")
    fails = fails + expect("2173_2233", str(hamming_distance("2173896", "2233796")), "3")
    // identical -> 0
    fails = fails + expect("identical", str(hamming_distance("abc", "abc")), "0")
    // all different
    fails = fails + expect("all_diff", str(hamming_distance("aaa", "bbb")), "3")
    // length mismatch -> -1
    fails = fails + expect("mismatch", str(hamming_distance("abc", "ab")), "-1")
    // empty
    fails = fails + expect("empty", str(hamming_distance("", "")), "0")

    // integer Hamming (bit differences)
    fails = fails + expect("int_5_6", str(hamming_int(5, 6)), "2")
    fails = fails + expect("int_0_255", str(hamming_int(0, 255)), "8")
    fails = fails + expect("int_same", str(hamming_int(42, 42)), "0")
    fails = fails + expect("int_1_2", str(hamming_int(1, 2)), "2")

    // minimum distance of a code
    // parity code {000,011,101,110} -> min distance 2
    fails = fails + expect("parity_mindist", str(min_distance(["000", "011", "101", "110"])), "2")
    // repetition code {000,111} -> min distance 3
    fails = fails + expect("rep_mindist", str(min_distance(["000", "111"])), "3")
    // two identical codewords -> min distance 0
    fails = fails + expect("dup_mindist", str(min_distance(["aa", "aa", "bb"])), "0")
    // single codeword -> -1
    fails = fails + expect("single_mindist", str(min_distance(["000"])), "-1")

    if fails == 0
        print("forge_hamming: all passed")
    else
        print("forge_hamming: " + str(fails) + " FAILED")
