// ==========================================================================
// NOVA Language Showcase -- Demonstrating the Power of Simplicity
// ==========================================================================
//
// NOVA: Python-level simplicity. C-level performance.
// Zero type annotations. Process-based concurrency.
// One language for every domain.

// -- Quicksort ---------------------------------------------------------------

fn quicksort(items: list) -> list
    if len(items) <= 1
        return items
    let pivot = items[0]
    let less = []
    let greater = []
    let i = 1
    while i < len(items)
        if items[i] < pivot
            push(less, items[i])
        else
            push(greater, items[i])
        i = i + 1
    let sorted_less = quicksort(less)
    let sorted_greater = quicksort(greater)
    let result = []
    for x in sorted_less
        push(result, x)
    push(result, pivot)
    for x in sorted_greater
        push(result, x)
    result

fn list_str(items: list) -> string
    let s = "["
    let i = 0
    while i < len(items)
        if i > 0
            s = s + ", "
        s = s + str(items[i])
        i = i + 1
    s + "]"

// -- Fibonacci with Memoization ----------------------------------------------

fn fib_memo(n: int, cache: dict) -> int
    if contains(cache, str(n))
        return cache[str(n)]
    if n <= 1
        return n
    let result = fib_memo(n - 1, cache) + fib_memo(n - 2, cache)
    cache[str(n)] = result
    result

// -- Error Handling ----------------------------------------------------------

fn safe_divide(a: int, b: int) -> int
    if b == 0
        error("division by zero")
        return 0
    a / b

fn parse_number(s: string) -> int
    let result = parse_int(s)
    if result == 0 and s != "0"
        error(f"not a number: {s}")
        return 0
    result

// -- Higher-Order Functions & Closures ---------------------------------------

fn apply_twice(f: any, x: int) -> int
    f(f(x))

fn make_adder(n: int) -> any
    x => x + n

fn make_multiplier(n: int) -> any
    x => x * n

// -- String Processing -------------------------------------------------------

fn word_count(text: string) -> dict
    let words = split(text, " ")
    let counts = {}
    for w in words
        let key = lower(w)
        if contains(counts, key)
            counts[key] = counts[key] + 1
        else
            counts[key] = 1
    counts

fn most_frequent(counts: dict) -> string
    let keys = dict_keys(counts)
    let best = ""
    let best_count = 0
    for k in keys
        if counts[k] > best_count
            best_count = counts[k]
            best = k
    best

// -- Matrix Operations -------------------------------------------------------

fn matrix_create(rows: int, cols: int) -> list
    let m = []
    let r = 0
    while r < rows
        let row = []
        let c = 0
        while c < cols
            push(row, 0)
            c = c + 1
        push(m, row)
        r = r + 1
    m

fn matrix_multiply(a: list, b: list, n: int) -> list
    let result = matrix_create(n, n)
    let i = 0
    while i < n
        let j = 0
        while j < n
            let sum = 0
            let k = 0
            while k < n
                sum = sum + a[i][k] * b[k][j]
                k = k + 1
            result[i][j] = sum
            j = j + 1
        i = i + 1
    result

// -- Sieve of Eratosthenes --------------------------------------------------

fn sieve(limit: int) -> list
    let is_prime = []
    let i = 0
    while i <= limit
        push(is_prime, 1)
        i = i + 1
    is_prime[0] = 0
    is_prime[1] = 0
    let p = 2
    while p * p <= limit
        if is_prime[p] == 1
            let m = p * p
            while m <= limit
                is_prime[m] = 0
                m = m + p
        p = p + 1
    let primes = []
    let j = 2
    while j <= limit
        if is_prime[j] == 1
            push(primes, j)
        j = j + 1
    primes

// -- Main Program ------------------------------------------------------------

fn main()
    print("=== NOVA Language Showcase ===")
    print(" ")

    // 1. Quicksort
    print("[1] Quicksort")
    let nums = [38, 27, 43, 3, 9, 82, 10]
    let sorted = quicksort(nums)
    print(f"    Input:  {list_str(nums)}")
    print(f"    Sorted: {list_str(sorted)}")
    print(" ")

    // 2. Fibonacci with memoization
    print("[2] Fibonacci (memoized)")
    let cache = {}
    let fib35 = fib_memo(35, cache)
    print(f"    fib(35) = {fib35}")
    print(f"    Cache entries: {len(cache)}")
    print(" ")

    // 3. Error Handling with try/catch
    print("[3] Error Handling")
    let r1 = safe_divide(42, 7) catch e
        -1
    let r2 = safe_divide(10, 0) catch e
        -1
    let r3 = parse_number("256") catch e
        0
    let r4 = parse_number("xyz") catch e
        0
    print(f"    42 / 7      = {r1}")
    print(f"    10 / 0      = {r2} (caught division by zero)")
    print(f"    parse(256)  = {r3}")
    print(f"    parse(xyz)  = {r4} (caught parse error)")
    print(" ")

    // 4. Closures & Higher-Order Functions
    print("[4] Closures & Higher-Order Functions")
    let add5 = make_adder(5)
    let triple = make_multiplier(3)
    let double = x => x * 2
    print(f"    add5(10)             = {add5(10)}")
    print(f"    triple(7)            = {triple(7)}")
    print(f"    double(8)            = {double(8)}")
    print(f"    apply_twice(add5, 3) = {apply_twice(add5, 3)}")
    print(" ")

    // 5. String Processing
    print("[5] Text Analysis")
    let text = "the quick brown fox jumps over the lazy dog the fox"
    let counts = word_count(text)
    let top = most_frequent(counts)
    print(f"    Text: \"{text}\"")
    print(f"    Most frequent: \"{top}\" (appears {counts[top]}x)")
    print(" ")

    // 6. Prime Sieve
    print("[6] Sieve of Eratosthenes")
    let primes = sieve(100)
    print(f"    Primes up to 100: {list_str(primes)}")
    print(f"    Count: {len(primes)}")
    print(" ")

    // 7. Matrix Multiplication
    print("[7] Matrix Multiplication (3x3)")
    let a = matrix_create(3, 3)
    a[0][0] = 1
    a[0][1] = 2
    a[0][2] = 3
    a[1][0] = 4
    a[1][1] = 5
    a[1][2] = 6
    a[2][0] = 7
    a[2][1] = 8
    a[2][2] = 9
    let b = matrix_create(3, 3)
    b[0][0] = 9
    b[0][1] = 8
    b[0][2] = 7
    b[1][0] = 6
    b[1][1] = 5
    b[1][2] = 4
    b[2][0] = 3
    b[2][1] = 2
    b[2][2] = 1
    let c = matrix_multiply(a, b, 3)
    print(f"    A[0] = {list_str(a[0])}")
    print(f"    B[0] = {list_str(b[0])}")
    print(f"    (A*B)[0] = {list_str(c[0])}")
    print(f"    (A*B)[1] = {list_str(c[1])}")
    print(f"    (A*B)[2] = {list_str(c[2])}")
    print(" ")

    // 8. List Operations
    print("[8] List Operations")
    let squares = []
    let i = 1
    while i <= 10
        push(squares, i * i)
        i = i + 1
    print(f"    Squares 1-10: {list_str(squares)}")
    let evens = []
    for s in squares
        if s % 2 == 0
            push(evens, s)
    print(f"    Even squares: {list_str(evens)}")
    let sum = 0
    for s in squares
        sum = sum + s
    print(f"    Sum of squares: {sum}")
    print(" ")

    // 9. Dictionary Operations
    print("[9] Dictionary Operations")
    let config = {}
    config["host"] = "localhost"
    config["port"] = "8080"
    config["debug"] = "true"
    config["name"] = "nova-app"
    let k1 = "host"
    let k2 = "port"
    let k3 = "debug"
    let k4 = "name"
    print(f"    host  = {config[k1]}")
    print(f"    port  = {config[k2]}")
    print(f"    debug = {config[k3]}")
    print(f"    name  = {config[k4]}")
    print(f"    Keys: {len(config)}")
    print(" ")

    // 10. The 'in' operator
    print("[10] Membership Testing")
    let fruits = ["apple", "banana", "cherry"]
    let b1 = "banana" in fruits
    let b2 = "grape" in fruits
    let hello = "hello"
    let b3 = "o" in hello
    print(f"    banana in fruits: {b1}")
    print(f"    grape in fruits:  {b2}")
    print(f"    o in hello:       {b3}")
    print(" ")

    print("=== All demos passed! ===")
    print("NOVA: One language. Every domain. Zero compromises.")

main()
