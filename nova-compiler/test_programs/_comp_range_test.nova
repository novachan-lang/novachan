fn main()
    let a = [x for x in 1..5]
    assert(len(a) == 4, "range 1..5 should give 4 elements")
    assert(a[0] == 1, "first element")
    assert(a[3] == 4, "last element")
    let b = [x * x for x in 0..6]
    assert(len(b) == 6, "range 0..6 should give 6 elements")
    assert(b[0] == 0, "0*0")
    assert(b[5] == 25, "5*5")
    let c = [x for x in 1..10 if x % 2 == 0]
    assert(len(c) == 4, "evens in 1..10")
    assert(c[0] == 2, "first even")
    assert(c[3] == 8, "last even")
    let d = [x + 1 for x in range(5)]
    assert(len(d) == 5, "range(5) gives 5 elements")
    assert(d[0] == 1, "0+1")
    assert(d[4] == 5, "4+1")
    let e = map(1..4, fn(x) x * 10)
    assert(len(e) == 3, "direct map on range")
    assert(e[0] == 10, "1*10")
    assert(e[2] == 30, "3*10")
    let f = filter(1..10, fn(x) x > 5)
    assert(len(f) == 4, "filter on range")
    assert(f[0] == 6, "first >5")
    assert(f[3] == 9, "last >5")
    print("ALL PASS")
