// Real WASM linear-memory oracle. mem.wasm declares 1 page of memory and:
//   store 10 @ mem[0]; store 20 @ mem[4]; load mem[0] + load mem[4]  => 30
// Oracle: wasm_run must return 30 — only possible with a real linear memory that
// persists stores and returns them on load.
fn main()
    let m = wasm_compile("mem.wasm")
    assert_eq(m >= 0, true)
    let r = wasm_run(m)
    print("wasm mem[0]+mem[4] = {r}")
    assert_eq(r, 30)
    wasm_free(m)
    print("WASM linear-memory test passed: store/load round-trip = 30")
