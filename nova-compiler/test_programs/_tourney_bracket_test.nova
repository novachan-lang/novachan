import std/game/tourney_bracket

fn chk_int(label, got, want)
    if got != want
        print("FAIL tourney_bracket " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // KAT 1: single_elim_rounds(8) == 3
    chk_int("rounds(8)", single_elim_rounds(8), 3)

    // KAT 2: single_elim_rounds(5) == 3
    chk_int("rounds(5)", single_elim_rounds(5), 3)

    // KAT 3: single_elim_rounds(1) == 0
    chk_int("rounds(1)", single_elim_rounds(1), 0)

    // KAT 4: single_elim_rounds(2) == 1
    chk_int("rounds(2)", single_elim_rounds(2), 1)

    // KAT 5: single_elim_rounds(4) == 2
    chk_int("rounds(4)", single_elim_rounds(4), 2)

    // KAT 6: bracket_size(5) == 8
    chk_int("bracket_size(5)", bracket_size(5), 8)

    // KAT 7: bracket_size(8) == 8
    chk_int("bracket_size(8)", bracket_size(8), 8)

    // KAT 8: bracket_size(1) == 1
    chk_int("bracket_size(1)", bracket_size(1), 1)

    // KAT 9: bracket_size(9) == 16
    chk_int("bracket_size(9)", bracket_size(9), 16)

    // KAT 10: advance_bracket([1,2,3,4]) == [[1,2],[3,4]]
    let w4 = []
    push(w4, 1)
    push(w4, 2)
    push(w4, 3)
    push(w4, 4)
    let ab4 = advance_bracket(w4)
    chk_int("ab4 len", len(ab4), 2)
    chk_int("ab4[0][0]", ab4[0][0], 1)
    chk_int("ab4[0][1]", ab4[0][1], 2)
    chk_int("ab4[1][0]", ab4[1][0], 3)
    chk_int("ab4[1][1]", ab4[1][1], 4)

    // KAT 11: advance_bracket with odd count — last gets a bye
    let w3 = []
    push(w3, 10)
    push(w3, 20)
    push(w3, 30)
    let ab3 = advance_bracket(w3)
    chk_int("ab3 len", len(ab3), 2)
    chk_int("ab3[0][0]", ab3[0][0], 10)
    chk_int("ab3[0][1]", ab3[0][1], 20)
    chk_int("ab3[1] len (bye)", len(ab3[1]), 1)
    chk_int("ab3[1][0] (bye player)", ab3[1][0], 30)

    // KAT 12: advance_bracket empty list
    let we = []
    let abe = advance_bracket(we)
    chk_int("ab empty len", len(abe), 0)

    // KAT 13: advance_bracket single player -> bye
    let w1 = []
    push(w1, 99)
    let ab1 = advance_bracket(w1)
    chk_int("ab single len", len(ab1), 1)
    chk_int("ab single bye len", len(ab1[0]), 1)
    chk_int("ab single bye player", ab1[0][0], 99)

    print("PASS _tourney_bracket_test")
