// showcase_physics_test.nova
// A tiny 2-D particle simulation built on std/math/vector and std/math/interp.
// 4 particles, each with a position [x,y] and velocity [x,y] as 2-element float lists.
// We step them N=50 times with dt=0.1 (two modes: undamped + smoothstep-damped).
//
// BUG-HUNT focus:
//   • float arrays in tight loops (vec_add / vec_scale called 50 * 4 times each)
//   • float-return paths: vec_length -> sqrt binding inside vec.nova
//   • smoothstep / clamp01 / map_range / inv_lerp float return paths
//
// Closed-form check (undamped, dt=0.1, N=50 → total_t = 5.0):
//   pos_final[i] = pos0[i] + vel[i] * 5.0  (exact for IEEE fp at these magnitudes)
//   Particle A: pos0=[1.0,0.0] vel=[0.5,0.2]  → final=[3.5, 1.0]
//   Particle B: pos0=[0.0,1.0] vel=[-0.3,0.1] → final=[-1.5, 1.5]
//   Particle C: pos0=[2.0,2.0] vel=[0.0,-0.4] → final=[2.0, 0.0]
//   Particle D: pos0=[-1.0,0.5] vel=[0.2,0.3] → final=[0.0, 2.0]
//
// Self-checks:
//   1. undamped final positions (closed-form exact)
//   2. vec_length([3.0,4.0]) == 5.0
//   3. interp primitives: smoothstep, clamp01, map_range, inv_lerp
//   4. damped simulation: velocity shrinks → particles land nearer to start

import std/math/vector
import std/math/interp

// Tolerance for float equality checks (ULP rounding in tight loops)
fn near(a: float, b: float) -> int
    let diff = a - b
    if diff < 0.0
        diff = 0.0 - diff
    if diff < 0.00001
        return 1
    return 0

fn assert_near(label: string, got: float, want: float)
    if near(got, want) == 0
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// Build a 2-element float list.
fn vec2(x: float, y: float) -> list
    let v = []
    push(v, x)
    push(v, y)
    v

fn main()
    let dt = 0.1
    let n_steps = 50

    // ---- UNDAMPED simulation ----
    let p0 = vec2(1.0, 0.0)
    let v0 = vec2(0.5, 0.2)
    let p1 = vec2(0.0, 1.0)
    let v1 = vec2(-0.3, 0.1)
    let p2 = vec2(2.0, 2.0)
    let v2 = vec2(0.0, -0.4)
    let p3 = vec2(-1.0, 0.5)
    let v3 = vec2(0.2, 0.3)

    let step = 0
    while step < n_steps
        let dp0 = vec_scale(v0, dt)
        p0 = vec_add(p0, dp0)
        let dp1 = vec_scale(v1, dt)
        p1 = vec_add(p1, dp1)
        let dp2 = vec_scale(v2, dt)
        p2 = vec_add(p2, dp2)
        let dp3 = vec_scale(v3, dt)
        p3 = vec_add(p3, dp3)
        step = step + 1

    // Check closed-form: pos_final = pos0 + vel*5.0
    // Particle A: [3.5, 1.0]
    assert_near("A.x", p0[0] * 1.0, 3.5)
    assert_near("A.y", p0[1] * 1.0, 1.0)
    // Particle B: [-1.5, 1.5]
    assert_near("B.x", p1[0] * 1.0, -1.5)
    assert_near("B.y", p1[1] * 1.0, 1.5)
    // Particle C: [2.0, 0.0]
    assert_near("C.x", p2[0] * 1.0, 2.0)
    assert_near("C.y", p2[1] * 1.0, 0.0)
    // Particle D: [0.0, 2.0]
    assert_near("D.x", p3[0] * 1.0, 0.0)
    assert_near("D.y", p3[1] * 1.0, 2.0)

    print("undamped simulation: PASS (all 4 particles at closed-form positions)")

    // ---- vec_length check ----
    let ref_vec = vec2(3.0, 4.0)
    let ref_len = vec_length(ref_vec)
    assert_near("vec_length([3,4])", ref_len, 5.0)
    print("vec_length([3,4]) = " + str(ref_len) + " : PASS")

    // ---- vec_normalize check ----
    // normalize([3,4]) should give [0.6, 0.8]
    let n34 = vec_normalize(ref_vec)
    assert_near("norm34.x", n34[0] * 1.0, 0.6)
    assert_near("norm34.y", n34[1] * 1.0, 0.8)
    print("vec_normalize([3,4]) = [" + str(n34[0]) + ", " + str(n34[1]) + "] : PASS")

    // ---- vec_dot check ----
    // dot([1,2],[3,4]) = 3 + 8 = 11
    let u = vec2(1.0, 2.0)
    let w = vec2(3.0, 4.0)
    let d = vec_dot(u, w)
    assert_near("vec_dot([1,2],[3,4])", d, 11.0)
    print("vec_dot([1,2],[3,4]) = " + str(d) + " : PASS")

    // ---- interp primitives ----
    // smoothstep: 0 at t=0, 0.5 at t=0.5, 1 at t=1
    let ss0 = smoothstep(0.0)
    let ss_half = smoothstep(0.5)
    let ss1 = smoothstep(1.0)
    assert_near("smoothstep(0.0)", ss0, 0.0)
    assert_near("smoothstep(0.5)", ss_half, 0.5)
    assert_near("smoothstep(1.0)", ss1, 1.0)
    print("smoothstep: PASS")

    // clamp01
    let c_neg = clamp01(-1.0)
    let c_mid = clamp01(0.3)
    let c_over = clamp01(2.0)
    assert_near("clamp01(-1.0)", c_neg, 0.0)
    assert_near("clamp01(0.3)", c_mid, 0.3)
    assert_near("clamp01(2.0)", c_over, 1.0)
    print("clamp01: PASS")

    // map_range: 5.0 in [0,10] -> [0,1] should be 0.5
    let mr = map_range(5.0, 0.0, 10.0, 0.0, 1.0)
    assert_near("map_range(5,[0,10],[0,1])", mr, 0.5)
    // map_range: 3.0 in [0,10] -> [20,30] should be 23.0
    let mr2 = map_range(3.0, 0.0, 10.0, 20.0, 30.0)
    assert_near("map_range(3,[0,10],[20,30])", mr2, 23.0)
    print("map_range: PASS")

    // inv_lerp(0.0, 10.0, 5.0) = 0.5
    let il = inv_lerp(0.0, 10.0, 5.0)
    assert_near("inv_lerp(0,10,5)", il, 0.5)
    // inv_lerp(2.0, 6.0, 4.0) = 0.5
    let il2 = inv_lerp(2.0, 6.0, 4.0)
    assert_near("inv_lerp(2,6,4)", il2, 0.5)
    print("inv_lerp: PASS")

    // ---- DAMPED simulation (velocity *= smoothstep factor each step) ----
    // Each step: vel_scale = smoothstep(0.9) = 0.9*0.9*(3-2*0.9) = 0.81*1.2 = 0.972
    // This is a constant factor so total distance < undamped.
    let dp = vec2(1.0, 0.0)
    let dv = vec2(0.5, 0.2)
    let damp_factor = smoothstep(0.9)

    let step2 = 0
    while step2 < n_steps
        let displacement = vec_scale(dv, dt)
        dp = vec_add(dp, displacement)
        dv = vec_scale(dv, damp_factor)
        step2 = step2 + 1

    // After 50 steps with 0.972 damping: velocity decays to 0.5 * 0.972^50
    // 0.972^50 ≈ 0.239 so damped particle travels less than undamped (3.5 - 1.0 = 2.5 displacement)
    // Final x should be in (1.0, 3.5) — less than undamped 3.5
    let damped_x = dp[0] * 1.0
    let damped_y = dp[1] * 1.0
    if damped_x >= 3.5
        print("FAIL damped.x: expected < 3.5 (undamped), got " + str(damped_x))
        exit(1)
    if damped_x <= 1.0
        print("FAIL damped.x: expected > 1.0 (start), got " + str(damped_x))
        exit(1)
    print("damped simulation: PASS (x=" + str(damped_x) + " y=" + str(damped_y) + " in expected range)")

    // ---- vec_sub check ----
    let sub_a = vec2(5.0, 3.0)
    let sub_b = vec2(2.0, 1.0)
    let sub_r = vec_sub(sub_a, sub_b)
    assert_near("vec_sub.x", sub_r[0] * 1.0, 3.0)
    assert_near("vec_sub.y", sub_r[1] * 1.0, 2.0)
    print("vec_sub: PASS")

    // ---- length of final positions from undamped simulation ----
    // p2 should be at [2.0, 0.0], length = 2.0
    let len_p2 = vec_length(p2)
    assert_near("vec_length(p2=[2,0])", len_p2, 2.0)
    print("vec_length of simulated particle C: PASS")

    // ---- particle energy (kinetic proxy: |vel|^2 = dot(vel, vel)) ----
    // vel of A = [0.5, 0.2], |v|^2 = 0.25 + 0.04 = 0.29
    let vel_a = vec2(0.5, 0.2)
    let ke = vec_dot(vel_a, vel_a)
    assert_near("KE proxy p0", ke, 0.29)
    print("kinetic energy proxy: PASS")

    print("showcase_physics_test passed")
