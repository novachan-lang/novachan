import forge_runbook

fn main()
    let rb = rb_new()
    rb = rb_add(rb, "restart_db", "Database restart procedure")
    rb = rb_add(rb, "scale_up", "Scale up application")
    assert(rb_book_count(rb) == 2, "2 books")
    assert(rb_has_book(rb, "restart_db") == 1, "has restart_db")

    let d1 = rb_description(rb, "restart_db")
    assert(unwrap(d1) == "Database restart procedure", "desc ok")

    let s1 = rb_add_step(rb, "restart_db", "Stop connections")
    rb = unwrap(s1)
    let s2 = rb_add_step(rb, "restart_db", "Backup WAL")
    rb = unwrap(s2)
    let s3 = rb_add_step(rb, "restart_db", "Restart service")
    rb = unwrap(s3)

    let sc = rb_step_count(rb, "restart_db")
    assert(unwrap(sc) == 3, "3 steps")

    let gs = rb_get_step(rb, "restart_db", 1)
    assert(unwrap(gs) == "Backup WAL", "step 1")

    let e1 = rb_execute(rb, "restart_db")
    rb = unwrap(e1)
    let e2 = rb_execute(rb, "restart_db")
    rb = unwrap(e2)
    let rc = rb_run_count(rb, "restart_db")
    assert(unwrap(rc) == 2, "ran 2")
    assert(rb_total_runs(rb) == 2, "total 2")

    let bad = rb_add_step(rb, "nope", "x")
    assert(is_err(bad), "unknown book")

    let oor = rb_get_step(rb, "restart_db", 99)
    assert(is_err(oor), "out of range")

    print("RUNBOOK KAT PASS")
