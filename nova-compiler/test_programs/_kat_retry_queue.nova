import forge_retry_queue

fn main()
    let rq = rq_new(3, 10)
    rq = rq_add(rq, "job-1", "process-order")
    rq = rq_add(rq, "job-2", "send-email")
    assert(rq_queue_size(rq) == 2, "2 queued")
    assert(rq_ready_count(rq, 0) == 2, "2 ready initially")

    rq = rq_attempt(rq, "job-1", 100)
    assert(rq_get_attempts(rq, "job-1") == 1, "1 attempt")
    assert(rq_ready_count(rq, 100) == 1, "job-1 waiting, job-2 ready")
    assert(rq_ready_count(rq, 110) == 2, "both ready at 110")

    rq = rq_attempt(rq, "job-1", 110)
    assert(rq_get_attempts(rq, "job-1") == 2, "2 attempts")

    rq = rq_attempt(rq, "job-1", 130)
    assert(rq_get_attempts(rq, "job-1") == 3, "3 attempts = exhausted")
    assert(rq_total_exhausted(rq) == 1, "1 exhausted")

    rq = rq_mark_success(rq, "job-2")
    assert(rq_queue_size(rq) == 1, "1 left after success")
    assert(rq_total_succeeded(rq) == 1, "1 succeeded")

    assert(rq_get_attempts(rq, "nonexistent") == 0, "no attempts for missing")

    print("RETRY-QUEUE KAT PASS")
