// Forge TLS 1.3 key schedule, gated against RFC 8448 Section 3 (Simple 1-RTT Handshake,
// TLS_AES_128_GCM_SHA256). The disputed standalone handshake_secret is gated transitively via its
// RFC-published children (c/s hs traffic). Socketless.
import forge_tls
import forge_crypto

fn main()
    let ecdhe = hex_to_blist("8bd4054fb55b9d63fdfbacf9f04b9f0d35e6d63f537563efd46272900f89492d")
    let th_ch_sh = hex_to_blist("860c06edc07858ee8e78f0e7428c58edd6b43f2ca3e6e95f02ed063cf0e1cad8")
    let th_sf = hex_to_blist("9608102a0f1ccc6db6250b7b7e417b1a000eaada3daae4777a7686c9ff83df13")
    let th_cf = hex_to_blist("edb7725fa7a3473b031ec8ef65a2485493900138a2b91291407d7951a06110ed")

    if hex_of(tls13_early_secret()) != "33ad0a1c607ec03b09e6cd9893680ce210adf300aa1f2660e1b22e10f170f92a"
        print("FAIL: early_secret -> " + hex_of(tls13_early_secret()))
        exit(1)

    let hs = tls13_handshake_secret(ecdhe)
    let c_hs = tls13_derive_secret(hs, "c hs traffic", th_ch_sh)
    let s_hs = tls13_derive_secret(hs, "s hs traffic", th_ch_sh)
    if hex_of(c_hs) != "b3eddb126e067f35a780b3abf45e2d8f3b1a950738f52e9600746a0e27a55a21"
        print("FAIL: c_hs_traffic -> " + hex_of(c_hs))
        exit(1)
    if hex_of(s_hs) != "b67b7d690cc16c4e75e54213cb2d37b4e9c912bcded9105d42befd59d391ad38"
        print("FAIL: s_hs_traffic -> " + hex_of(s_hs))
        exit(1)

    if hex_of(tls13_traffic_key(s_hs)) != "3fce516009c21727d0f2e4e86ee403bc"
        print("FAIL: s_hs_key")
        exit(1)
    if hex_of(tls13_traffic_iv(s_hs)) != "5d313eb2671276ee13000b30"
        print("FAIL: s_hs_iv")
        exit(1)
    if hex_of(tls13_traffic_key(c_hs)) != "dbfaa693d1762c5b666af5d950258d01"
        print("FAIL: c_hs_key")
        exit(1)
    if hex_of(tls13_traffic_iv(c_hs)) != "5bd3c71b836e0b76bb73265f"
        print("FAIL: c_hs_iv")
        exit(1)

    let ms = tls13_master_secret(hs)
    let c_ap = tls13_derive_secret(ms, "c ap traffic", th_sf)
    let s_ap = tls13_derive_secret(ms, "s ap traffic", th_sf)
    if hex_of(c_ap) != "9e40646ce79a7f9dc05af8889bce6552875afa0b06df0087f792ebb7c17504a5"
        print("FAIL: c_ap_traffic -> " + hex_of(c_ap))
        exit(1)
    if hex_of(s_ap) != "a11af9f05531f856ad47116b45a950328204b4f44bfb6b3a4b4f1f3fcb631643"
        print("FAIL: s_ap_traffic -> " + hex_of(s_ap))
        exit(1)
    if hex_of(tls13_traffic_key(s_ap)) != "9f02283b6c9c07efc26bb9f2ac92e356"
        print("FAIL: s_ap_key")
        exit(1)
    if hex_of(tls13_traffic_iv(s_ap)) != "cf782b88dd83549aadf1e984"
        print("FAIL: s_ap_iv")
        exit(1)
    if hex_of(tls13_traffic_key(c_ap)) != "17422dda596ed5d9acd890e3c63f5051"
        print("FAIL: c_ap_key")
        exit(1)
    if hex_of(tls13_traffic_iv(c_ap)) != "5b78923dee08579033e523d9"
        print("FAIL: c_ap_iv")
        exit(1)

    if hex_of(tls13_finished_key(s_hs)) != "008d3b66f816ea559f96b537e885c31fc068bf492c652f01f288a1d8cdc19fc8"
        print("FAIL: server_finished_key")
        exit(1)
    if hex_of(tls13_finished_verify(s_hs, th_cf)) != "9b9b141d906337fbd2cbdce71df4deda4ab42c309572cb7fffee5454b78f0718"
        print("FAIL: server_verify_data -> " + hex_of(tls13_finished_verify(s_hs, th_cf)))
        exit(1)

    print("PASS forge_tls_ks (RFC 8448 key schedule: secrets + traffic keys/ivs + server Finished)")
