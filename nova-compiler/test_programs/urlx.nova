// ============================================================================
// NOVA Standard Library — URL / web encoding
// ============================================================================
// Pure NOVA (no new builtins). Closes audit-flagged gaps:
//   url_encode / url_decode          (HTTP & WebSockets cat-14: URI encoding)
//   parse_query / build_query        (cat-14: query strings)
//   html_escape                      (security: anti-XSS output encoding)
//
// All operate at the BYTE level: s[i] is byte-indexed and ord(s[i]) is the byte
// value (verified: é -> 195,169), and chr() of a byte 0..255 reconstructs that
// byte, so UTF-8 round-trips exactly (RFC 3986 percent-encoding is byte-wise).

// ── helpers ─────────────────────────────────────────────────────────────────

// RFC 3986 "unreserved": A-Z a-z 0-9 - _ . ~  (never percent-encoded)
fn _is_unreserved(b) -> int
    if b >= 65 and b <= 90
        return 1
    if b >= 97 and b <= 122
        return 1
    if b >= 48 and b <= 57
        return 1
    if b == 45 or b == 95 or b == 46 or b == 126
        return 1
    return 0

// uppercase hex digit (0..15 -> "0".."F")
fn _hexd(n) -> string
    let HEX = "0123456789ABCDEF"
    return HEX[n]

// value of a hex-digit byte, or -1 if not a hex digit
fn _hexval(c) -> int
    if c >= 48 and c <= 57
        return c - 48
    if c >= 65 and c <= 70
        return c - 55
    if c >= 97 and c <= 102
        return c - 87
    return -1

// ── percent-encoding ────────────────────────────────────────────────────────

// RFC 3986 percent-encoding. Space -> %20 (not '+'; that's form-encoding only).
fn url_encode(s) -> string
    let out = ""
    let i = 0
    let n = len(s)
    while i < n
        let b = ord(s[i])
        if _is_unreserved(b) == 1
            out = out + chr(b)
        else
            out = out + "%" + _hexd(b / 16) + _hexd(b % 16)
        i = i + 1
    return out

// Decode %XX (any case) back to bytes; '+' -> space (form-encoding); a lone or
// malformed '%' is passed through literally.
fn url_decode(s) -> string
    let out = ""
    let i = 0
    let n = len(s)
    while i < n
        let b = ord(s[i])
        if b == 37 and i + 2 < n
            let hi = _hexval(ord(s[i + 1]))
            let lo = _hexval(ord(s[i + 2]))
            if hi >= 0 and lo >= 0
                out = out + chr(hi * 16 + lo)
                i = i + 3
            else
                out = out + chr(b)
                i = i + 1
        else if b == 43
            out = out + " "
            i = i + 1
        else
            out = out + chr(b)
            i = i + 1
    return out

// ── query strings ───────────────────────────────────────────────────────────

// "a=1&b=hello%20world&c" -> dict {a:"1", b:"hello world", c:""}.
// Keys and values are url_decoded; a key with no '=' maps to "".
fn parse_query(qs)
    let d = {}
    let pairs = split(qs, "&")
    let i = 0
    while i < len(pairs)
        let p = pairs[i]
        if len(p) > 0
            let eq = find(p, "=")
            if eq >= 0
                let k = url_decode(slice(p, 0, eq))
                let v = url_decode(slice(p, eq + 1, len(p)))
                d[k] = v
            else
                d[url_decode(p)] = ""
        i = i + 1
    return d

// pairs is a list of [key, value] lists -> "k1=v1&k2=v2" (each piece encoded).
fn build_query(pairs) -> string
    let out = ""
    let i = 0
    while i < len(pairs)
        let kv = pairs[i]
        if i > 0
            out = out + "&"
        out = out + url_encode(kv[0]) + "=" + url_encode(kv[1])
        i = i + 1
    return out

// ── HTML escaping (anti-XSS output encoding) ────────────────────────────────
fn html_escape(s) -> string
    let out = ""
    let i = 0
    let n = len(s)
    while i < n
        let b = ord(s[i])
        if b == 38
            out = out + "&amp;"
        else if b == 60
            out = out + "&lt;"
        else if b == 62
            out = out + "&gt;"
        else if b == 34
            out = out + "&quot;"
        else if b == 39
            out = out + "&#39;"
        else
            out = out + chr(b)
        i = i + 1
    return out

// ── URI parse / build (RFC 3986) ─────────────────────────────────────────────
// uri_parse(s) -> dict {scheme,userinfo,host,port,path,query,fragment} (each "" if
// absent). uri_build(dict) is the inverse. Pure string splitting on ://,@,:,?,#.
// (IPv6 literal hosts [::1] are out of scope for this v1; host:port uses the colon.)
fn uri_parse(s) -> dict
    let out = {}
    out["scheme"] = ""
    out["userinfo"] = ""
    out["host"] = ""
    out["port"] = ""
    out["path"] = ""
    out["query"] = ""
    out["fragment"] = ""
    let work = s
    let hi = find(work, "#")
    if hi >= 0
        out["fragment"] = slice(work, hi + 1, len(work))
        work = slice(work, 0, hi)
    let qi = find(work, "?")
    if qi >= 0
        out["query"] = slice(work, qi + 1, len(work))
        work = slice(work, 0, qi)
    let si = find(work, "://")
    let rest = work
    if si >= 0
        out["scheme"] = slice(work, 0, si)
        rest = slice(work, si + 3, len(work))
    let authority = ""
    if si >= 0
        let sli = find(rest, "/")
        if sli >= 0
            authority = slice(rest, 0, sli)
            out["path"] = slice(rest, sli, len(rest))
        else
            authority = rest
    else
        out["path"] = rest
    if len(authority) > 0
        let ai = find(authority, "@")
        let hostport = authority
        if ai >= 0
            out["userinfo"] = slice(authority, 0, ai)
            hostport = slice(authority, ai + 1, len(authority))
        let ci = find(hostport, ":")
        if ci >= 0
            out["host"] = slice(hostport, 0, ci)
            out["port"] = slice(hostport, ci + 1, len(hostport))
        else
            out["host"] = hostport
    return out

fn _uri_get(d, k) -> string
    if d.has(k)
        return d[k]
    return ""

fn uri_build(d) -> string
    let out = ""
    if len(_uri_get(d, "scheme")) > 0
        out = out + d["scheme"] + "://"
    if len(_uri_get(d, "userinfo")) > 0
        out = out + d["userinfo"] + "@"
    out = out + _uri_get(d, "host")
    if len(_uri_get(d, "port")) > 0
        out = out + ":" + d["port"]
    out = out + _uri_get(d, "path")
    if len(_uri_get(d, "query")) > 0
        out = out + "?" + d["query"]
    if len(_uri_get(d, "fragment")) > 0
        out = out + "#" + d["fragment"]
    return out

// ============================================================================
fn main()
    // ── url_encode ──
    assert_eq(url_encode("hello world"), "hello%20world")
    assert_eq(url_encode("aA0-_.~"), "aA0-_.~")          // all unreserved
    assert_eq(url_encode("a+b=c"), "a%2Bb%3Dc")          // + is %2B, = is %3D
    assert_eq(url_encode("100%"), "100%25")
    assert_eq(url_encode("caf" + from_codepoint(233)), "caf%C3%A9")  // UTF-8 é

    // ── url_decode ──
    assert_eq(url_decode("hello%20world"), "hello world")
    assert_eq(url_decode("a%2Bb"), "a+b")
    assert_eq(url_decode("a+b"), "a b")                  // + -> space
    assert_eq(url_decode("100%25"), "100%")
    assert_eq(url_decode("caf%C3%A9"), "caf" + from_codepoint(233))
    assert_eq(url_decode("%zz"), "%zz")                  // malformed passes through
    assert_eq(url_decode("%2"), "%2")                    // truncated passes through

    // ── round-trips ──
    assert_eq(url_decode(url_encode("a b/c?d=e&f")), "a b/c?d=e&f")
    assert_eq(url_decode(url_encode(from_codepoint(233) + "!")), from_codepoint(233) + "!")

    // ── parse_query ──
    let q = parse_query("a=1&b=hello%20world&c=")
    assert_eq(q["a"], "1")
    assert_eq(q["b"], "hello world")
    assert_eq(q["c"], "")
    let q2 = parse_query("name=John+Doe&city=New%20York")
    assert_eq(q2["name"], "John Doe")
    assert_eq(q2["city"], "New York")

    // ── build_query ──
    assert_eq(build_query([["a", "1"], ["b", "x y"]]), "a=1&b=x%20y")
    assert_eq(build_query([["q", "a&b"]]), "q=a%26b")
    // build then parse round-trips a value
    let bq = build_query([["msg", "hi there!"]])
    let pq = parse_query(bq)
    assert_eq(pq["msg"], "hi there!")

    // ── html_escape ──
    assert_eq(html_escape("&"), "&amp;")
    assert_eq(html_escape("<"), "&lt;")
    assert_eq(html_escape(">"), "&gt;")
    assert_eq(html_escape(chr(34)), "&quot;")
    assert_eq(html_escape(chr(39)), "&#39;")
    assert_eq(html_escape("a&b<c>d"), "a&amp;b&lt;c&gt;d")
    assert_eq(html_escape("safe text 123"), "safe text 123")
    // a classic XSS payload becomes inert text
    assert_eq(html_escape("<script>alert(1)</script>"), "&lt;script&gt;alert(1)&lt;/script&gt;")

    // ── uri_parse / uri_build (RFC 3986) ──
    let u = uri_parse("https://user@example.com:8080/p/q?a=1&b=2#frag")
    assert_eq(u["scheme"], "https")
    assert_eq(u["userinfo"], "user")
    assert_eq(u["host"], "example.com")
    assert_eq(u["port"], "8080")
    assert_eq(u["path"], "/p/q")
    assert_eq(u["query"], "a=1&b=2")
    assert_eq(u["fragment"], "frag")
    assert_eq(uri_build(u), "https://user@example.com:8080/p/q?a=1&b=2#frag")
    let u2 = uri_parse("http://host/path")
    assert_eq(u2["scheme"], "http")
    assert_eq(u2["host"], "host")
    assert_eq(u2["port"], "")
    assert_eq(u2["path"], "/path")
    assert_eq(u2["query"], "")
    assert_eq(uri_build(u2), "http://host/path")
    let u3 = uri_parse("https://example.com")
    assert_eq(u3["host"], "example.com")
    assert_eq(u3["path"], "")
    assert_eq(uri_build(u3), "https://example.com")

    print("urlx_test passed")
