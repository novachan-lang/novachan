// KAT for std/encoding/messagepack — MessagePack encode/decode against
// msgpack.org spec vectors. Every check helper exits(1) IMMEDIATELY on
// failure (the proven idiom used by bsonkat.nova / _cbor_rfc8949_kat.nova) —
// NOVA `fn` closures do not reliably share mutation of an outer scalar/dict
// counter, so a deferred failure-count pattern silently under-reports.
// Fail-fast-with-location is the only reliable KAT gate.
import std/encoding/messagepack

fn ckb(label: string, b: any, expected: list)
    let blen = bytes_len(b)
    let elen = len(expected)
    if blen != elen
        print("FAIL " + label + "_len: got " + str(blen) + " want " + str(elen))
        exit(1)
    let i = 0
    while i < elen
        let got = bytes_get(b, i)
        let want = expected[i]
        if got != want
            print("FAIL " + label + "_b" + str(i) + ": got " + str(got) + " want " + str(want))
            exit(1)
        i = i + 1
    print("PASS " + label + "_bytes")

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("PASS " + label)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got '" + got + "' want '" + want + "'")
        exit(1)
    print("PASS " + label)

fn ckf(label: string, got: float, want: float)
    if got != want
        print("FAIL " + label)
        exit(1)
    print("PASS " + label)

fn ckerr(label: string, got: any)
    if msgpack_is_error(got) != 1
        print("FAIL " + label + ": expected an msgpack_error() sentinel")
        exit(1)
    print("PASS " + label)

fn mkbytes3(a: int, bb: int, c: int) -> any
    let bv = bytes_create(3)
    bytes_set(bv, 0, a)
    bytes_set(bv, 1, bb)
    bytes_set(bv, 2, c)
    bv

fn main()
    // ── spec-exact scalar vectors ───────────────────────────────────────
    cki("zero_byte0", bytes_get(msgpack_encode(0), 0), 0x00)
    cki("zero_len", bytes_len(msgpack_encode(0)), 1)
    cki("max_fixint_byte0", bytes_get(msgpack_encode(127), 0), 0x7f)
    cki("neg1_byte0", bytes_get(msgpack_encode(0 - 1), 0), 0xff)
    cki("neg32_byte0", bytes_get(msgpack_encode(0 - 32), 0), 0xe0)

    let e128 = msgpack_encode(128)
    ckb("uint8_128", e128, [0xcc, 0x80])

    let e256 = msgpack_encode(256)
    ckb("uint16_256", e256, [0xcd, 0x01, 0x00])

    let enil = msgpack_encode(msgpack_nil())
    ckb("nil_encode", enil, [0xc0])

    let efalse = msgpack_encode(msgpack_bool(0))
    ckb("false_encode", efalse, [0xc2])
    let etrue = msgpack_encode(msgpack_bool(1))
    ckb("true_encode", etrue, [0xc3])

    let ea = msgpack_encode("a")
    ckb("str_a", ea, [0xa1, 0x61])

    let earr = msgpack_encode([1, 2])
    ckb("arr_1_2", earr, [0x92, 0x01, 0x02])

    let dmap = {}
    dmap["a"] = 1
    let emap = msgpack_encode(dmap)
    ckb("map_a_1", emap, [0x81, 0xa1, 0x61, 0x01])

    // ── bin8 with an embedded 0x00 byte ─────────────────────────────────
    let binv = mkbytes3(0x41, 0x00, 0x42)
    let ebin = msgpack_encode(binv)
    ckb("bin8_embedded_nul", ebin, [0xc4, 0x03, 0x41, 0x00, 0x42])
    let decbin = msgpack_decode(ebin)
    cki("bin8_rt_len", bytes_len(decbin), 3)
    cki("bin8_rt_0", bytes_get(decbin, 0), 0x41)
    cki("bin8_rt_1", bytes_get(decbin, 1), 0x00)
    cki("bin8_rt_2", bytes_get(decbin, 2), 0x42)

    // ── decode: nil / false / true from raw wire bytes ──────────────────
    let bnil = bytes_create(1)
    bytes_set(bnil, 0, 0xc0)
    let decnil = msgpack_decode(bnil)
    if decnil != null
        print("FAIL decode_nil: expected null")
        exit(1)
    print("PASS decode_nil")

    let bfalse = bytes_create(1)
    bytes_set(bfalse, 0, 0xc2)
    cki("decode_false", msgpack_decode(bfalse), 0)

    let btrue = bytes_create(1)
    bytes_set(btrue, 0, 0xc3)
    cki("decode_true", msgpack_decode(btrue), 1)

    // ── round trip: int width boundaries (both signs) ───────────────────
    cki("rt_0", msgpack_decode(msgpack_encode(0)), 0)
    cki("rt_127", msgpack_decode(msgpack_encode(127)), 127)
    cki("rt_128", msgpack_decode(msgpack_encode(128)), 128)
    cki("rt_255", msgpack_decode(msgpack_encode(255)), 255)
    cki("rt_256", msgpack_decode(msgpack_encode(256)), 256)
    cki("rt_65535", msgpack_decode(msgpack_encode(65535)), 65535)
    cki("rt_65536", msgpack_decode(msgpack_encode(65536)), 65536)
    cki("rt_4294967295", msgpack_decode(msgpack_encode(4294967295)), 4294967295)
    cki("rt_4294967296", msgpack_decode(msgpack_encode(4294967296)), 4294967296)
    cki("rt_neg1", msgpack_decode(msgpack_encode(0 - 1)), 0 - 1)
    cki("rt_neg32", msgpack_decode(msgpack_encode(0 - 32)), 0 - 32)
    cki("rt_neg33", msgpack_decode(msgpack_encode(0 - 33)), 0 - 33)
    cki("rt_neg128", msgpack_decode(msgpack_encode(0 - 128)), 0 - 128)
    cki("rt_neg129", msgpack_decode(msgpack_encode(0 - 129)), 0 - 129)
    cki("rt_neg32768", msgpack_decode(msgpack_encode(0 - 32768)), 0 - 32768)
    cki("rt_neg32769", msgpack_decode(msgpack_encode(0 - 32769)), 0 - 32769)
    cki("rt_neg2147483648", msgpack_decode(msgpack_encode(0 - 2147483648)), 0 - 2147483648)
    cki("rt_neg2147483649", msgpack_decode(msgpack_encode(0 - 2147483649)), 0 - 2147483649)

    // i64 extremes
    cki("rt_i64_max", msgpack_decode(msgpack_encode(9223372036854775807)), 9223372036854775807)
    cki("rt_i64_min", msgpack_decode(msgpack_encode(0 - 9223372036854775807 - 1)), 0 - 9223372036854775807 - 1)

    // explicit format-byte checks at width boundaries
    cki("fmt_128_is_uint8", bytes_get(msgpack_encode(128), 0), 0xcc)
    cki("fmt_65536_is_uint32", bytes_get(msgpack_encode(65536), 0), 0xce)
    cki("fmt_neg33_is_int8", bytes_get(msgpack_encode(0 - 33), 0), 0xd0)
    cki("fmt_neg32769_is_int32", bytes_get(msgpack_encode(0 - 32769), 0), 0xd2)
    cki("fmt_i64min_is_int64", bytes_get(msgpack_encode(0 - 9223372036854775807 - 1), 0), 0xd3)
    cki("fmt_i64max_is_uint64", bytes_get(msgpack_encode(9223372036854775807), 0), 0xcf)

    // ── round trip: float64 (including negative + zero) ─────────────────
    ckf("rt_float_pi", msgpack_decode(msgpack_encode(3.14159)), 3.14159)
    ckf("rt_float_neg", msgpack_decode(msgpack_encode(0.0 - 2.5)), 0.0 - 2.5)
    ckf("rt_float_zero", msgpack_decode(msgpack_encode(0.0)), 0.0)
    cki("fmt_float_is_f64", bytes_get(msgpack_encode(3.14159), 0), 0xcb)

    // decode a real float32 (0xca) wire value from another producer: 1.5 is
    // exactly representable in both f32 and f64, so this is byte-exact.
    let bf32 = bytes_create(5)
    bytes_set(bf32, 0, 0xca)
    bytes_set(bf32, 1, 0x3f)
    bytes_set(bf32, 2, 0xc0)
    bytes_set(bf32, 3, 0x00)
    bytes_set(bf32, 4, 0x00)
    ckf("decode_float32", msgpack_decode(bf32), 1.5)

    // ── round trip: strings (empty, fixstr/str8/str16 boundaries) ───────
    cks("rt_str_empty", msgpack_decode(msgpack_encode("")), "")
    cks("rt_str_a", msgpack_decode(msgpack_encode("a")), "a")
    let s31 = "1234567890123456789012345678901"     // 31 chars: fixstr max
    cki("s31_len_check", len(s31), 31)
    cks("rt_str_31", msgpack_decode(msgpack_encode(s31)), s31)
    cki("fmt_str31_is_fixstr", bytes_get(msgpack_encode(s31), 0), 0xbf)
    let s32 = s31 + "x"                              // 32 chars: str8
    cks("rt_str_32", msgpack_decode(msgpack_encode(s32)), s32)
    cki("fmt_str32_is_str8", bytes_get(msgpack_encode(s32), 0), 0xd9)

    // ── round trip: bin (empty, boundary at 255/256) ─────────────────────
    let bempty = bytes_create(0)
    let decempty = msgpack_decode(msgpack_encode(bempty))
    cki("rt_bin_empty_len", bytes_len(decempty), 0)
    cki("fmt_bin_empty_is_bin8", bytes_get(msgpack_encode(bempty), 0), 0xc4)

    let b256 = bytes_create(256)
    let bi = 0
    while bi < 256
        bytes_set(b256, bi, bi & 0xFF)
        bi = bi + 1
    let e256b = msgpack_encode(b256)
    cki("fmt_bin256_is_bin16", bytes_get(e256b, 0), 0xc5)
    let dec256 = msgpack_decode(e256b)
    cki("rt_bin256_len", bytes_len(dec256), 256)
    cki("rt_bin256_last", bytes_get(dec256, 255), 255)

    // ── round trip: array (empty, fixarray/array16 boundary at 15/16) ───
    let aempty = []
    cki("rt_arr_empty_len", len(msgpack_decode(msgpack_encode(aempty))), 0)
    let a15 = []
    let ai = 0
    while ai < 15
        push(a15, ai)
        ai = ai + 1
    cki("fmt_arr15_is_fixarray", bytes_get(msgpack_encode(a15), 0), 0x9f)
    let a16 = []
    ai = 0
    while ai < 16
        push(a16, ai)
        ai = ai + 1
    cki("fmt_arr16_is_array16", bytes_get(msgpack_encode(a16), 0), 0xdc)
    let deca16 = msgpack_decode(msgpack_encode(a16))
    cki("rt_arr16_len", len(deca16), 16)
    cki("rt_arr16_last", deca16[15], 15)

    // ── round trip: map (empty, fixmap/map16 boundary at 15/16) ─────────
    let mempty = {}
    cki("rt_map_empty_nkeys", len(keys(msgpack_decode(msgpack_encode(mempty)))), 0)
    let m16 = {}
    let mi = 0
    while mi < 16
        m16["k" + str(mi)] = mi
        mi = mi + 1
    cki("fmt_map16_is_map16", bytes_get(msgpack_encode(m16), 0), 0xde)
    let decm16 = msgpack_decode(msgpack_encode(m16))
    cki("rt_map16_nkeys", len(keys(decm16)), 16)
    cki("rt_map16_k0", decm16["k0"], 0)
    cki("rt_map16_k15", decm16["k15"], 15)

    // ── nested structure round trip (array of maps of arrays) ───────────
    let inner = {}
    inner["x"] = 1
    inner["y"] = 2.5
    inner["s"] = "nova"
    inner["nested_arr"] = [1, 2, 3]
    inner["flag"] = msgpack_bool(1)
    inner["gone"] = msgpack_nil()
    let outer = [inner, inner]
    let decouter = msgpack_decode(msgpack_encode(outer))
    cki("nested_len", len(decouter), 2)
    cki("nested_x", decouter[0]["x"], 1)
    ckf("nested_y", decouter[0]["y"], 2.5)
    cks("nested_s", decouter[0]["s"], "nova")
    cki("nested_arr_len", len(decouter[0]["nested_arr"]), 3)
    cki("nested_arr_2", decouter[0]["nested_arr"][2], 3)
    cki("nested_flag", decouter[0]["flag"], 1)

    // ── ADVERSARIAL: malformed / truncated input rejected in-band ───────
    // (a) empty buffer -> in-band error, no crash.
    ckerr("empty_buffer", msgpack_decode(bytes_create(0)))

    // (b) str8 whose declared length overruns the buffer: header says 10
    // bytes follow but only 2 are present.
    let bad_str8 = bytes_create(3)
    bytes_set(bad_str8, 0, 0xd9)
    bytes_set(bad_str8, 1, 10)
    bytes_set(bad_str8, 2, 0x61)
    ckerr("str8_length_overrun", msgpack_decode(bad_str8))

    // (c) bin32 with a huge declared length far beyond the buffer.
    let bad_bin32 = bytes_create(5)
    bytes_set(bad_bin32, 0, 0xc6)
    bytes_set(bad_bin32, 1, 0x7f)
    bytes_set(bad_bin32, 2, 0xff)
    bytes_set(bad_bin32, 3, 0xff)
    bytes_set(bad_bin32, 4, 0xff)
    ckerr("bin32_huge_length", msgpack_decode(bad_bin32))

    // (d) truncated length prefix itself (uint16 header with only 1 byte
    // of the 2-byte length present).
    let bad_len = bytes_create(2)
    bytes_set(bad_len, 0, 0xda)
    bytes_set(bad_len, 1, 0x00)
    ckerr("str16_truncated_length_prefix", msgpack_decode(bad_len))

    // (e) array16 declaring far more elements than the buffer can hold:
    // must terminate promptly (no hang) and report an in-band error.
    let bad_arr = bytes_create(3)
    bytes_set(bad_arr, 0, 0xdc)
    bytes_set(bad_arr, 1, 0xff)
    bytes_set(bad_arr, 2, 0xff)
    ckerr("array16_count_overrun", msgpack_decode(bad_arr))

    // (f) error nested inside an otherwise-valid array must propagate to
    // the whole decode, not silently continue.
    let nested_bad = bytes_create(5)
    bytes_set(nested_bad, 0, 0x92)          // fixarray len=2
    bytes_set(nested_bad, 1, 0x01)          // element 0: fixint 1 (valid)
    bytes_set(nested_bad, 2, 0xd9)          // element 1: str8...
    bytes_set(nested_bad, 3, 0x05)          // ...declares len=5
    bytes_set(nested_bad, 4, 0x61)          // ...but only 1 byte present
    ckerr("nested_error_propagates", msgpack_decode(nested_bad))

    // (g) reserved/unassigned format byte (0xc1) -> in-band error, not a
    // misdecode.
    let bres = bytes_create(1)
    bytes_set(bres, 0, 0xc1)
    ckerr("reserved_byte_0xc1", msgpack_decode(bres))

    // ── sentinel collision safety: an ordinary user dict using the magic
    // key NAME but lacking the magic VALUE must never be mistaken for nil.
    let collide = {}
    collide["$mpNil"] = 1
    let ecollide = msgpack_encode(collide)
    cki("nil_collision_is_map", bytes_get(ecollide, 0), 0x81)
    let deccollide = msgpack_decode(ecollide)
    cki("nil_collision_rt_field", deccollide["$mpNil"], 1)

    print("messagepack KAT: ALL PASS")
