import std/data/edn

// Helper: check int equality
fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// Helper: check string equality
fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got [" + got + "] want [" + want + "]")
        exit(1)

// Helper: check null (v == null)
fn ckn(label, got)
    if got != null
        print("FAIL " + label + ": expected null, got " + str(got))
        exit(1)

// Helper: check list length
fn cklen(label, lst, want)
    let n = len(lst)
    if n != want
        print("FAIL " + label + " len: got " + str(n) + " want " + str(want))
        exit(1)

// ── KAT 1: integer ──────────────────────────────────────────────────────────
let v1 = ed_parse("42")
cki("parse-int", v1, 42)

// ── KAT 2: nil -> null ───────────────────────────────────────────────────────
let v2 = ed_parse("nil")
ckn("parse-nil", v2)

// ── KAT 3: double-quoted string ──────────────────────────────────────────────
let v3 = ed_parse(chr(34) + "hi" + chr(34))
cks("parse-string", v3, "hi")

// ── KAT 4: keyword :name -> "name" ───────────────────────────────────────────
let v4 = ed_parse(":name")
cks("parse-keyword", v4, "name")

// ── KAT 5: flat vector [1 2 3] -> list of 3 ints ────────────────────────────
let v5 = ed_parse("[1 2 3]")
cklen("parse-vec-len", v5, 3)
cki("parse-vec-0", v5[0], 1)
cki("parse-vec-1", v5[1], 2)
cki("parse-vec-2", v5[2], 3)

// ── KAT 6: nested vector [1 [2 3]] ───────────────────────────────────────────
let v6 = ed_parse("[1 [2 3]]")
cklen("parse-nested-outer", v6, 2)
cki("parse-nested-0", v6[0], 1)
let inner6 = v6[1]
cklen("parse-nested-inner", inner6, 2)
cki("parse-nested-1-0", inner6[0], 2)
cki("parse-nested-1-1", inner6[1], 3)

// ── KAT 7: empty vector [] -> empty list ─────────────────────────────────────
let v7 = ed_parse("[]")
cklen("parse-empty-vec", v7, 0)

// ── KAT 8: ed_write list -> "[1 2 3]" ────────────────────────────────────────
let lst8 = [1, 2, 3]
let w8 = ed_write(lst8)
cks("write-list", w8, "[1 2 3]")

// ── KAT 9: ed_write int -> "42" ──────────────────────────────────────────────
let w9 = ed_write(42)
cks("write-int", w9, "42")

// ── KAT 10: ed_write null -> "nil" ───────────────────────────────────────────
let w10 = ed_write(null)
cks("write-null", w10, "nil")

// ── KAT 11: ed_write string with quotes ──────────────────────────────────────
let w11 = ed_write("hello")
let want11 = chr(34) + "hello" + chr(34)
cks("write-string", w11, want11)

// ── KAT 12: ed_write empty list -> "[]" ──────────────────────────────────────
let w12 = ed_write([])
cks("write-empty-list", w12, "[]")

// ── KAT 13: negative integer ─────────────────────────────────────────────────
let v13 = ed_parse("-7")
cki("parse-neg-int", v13, -7)

// ── KAT 14: comma-separated vector (commas = whitespace in EDN) ──────────────
let v14 = ed_parse("[1,2,3]")
cklen("parse-comma-vec-len", v14, 3)
cki("parse-comma-0", v14[0], 1)
cki("parse-comma-1", v14[1], 2)
cki("parse-comma-2", v14[2], 3)

// ── KAT 15: symbol -> string ──────────────────────────────────────────────────
let v15 = ed_parse("hello")
cks("parse-symbol", v15, "hello")

// ── KAT 16: map with keyword keys ────────────────────────────────────────────
// Use chr(123)/chr(125) for braces to avoid NOVA string interpolation.
let map_src = chr(123) + ":a 1 :b 2" + chr(125)
let v16 = ed_parse(map_src)
// Keys are written as ed_write of the keyword-string, i.e. "\"a\"" and "\"b\""
let ka = chr(34) + "a" + chr(34)
let kb = chr(34) + "b" + chr(34)
cki("parse-map-a", v16[ka], 1)
cki("parse-map-b", v16[kb], 2)

print("_edn_test passed")
