import std/encoding/basex

// Validation test for the basex module (base conversion + int-string validation).
fn main()
    // to_base: 255 -> "ff" base 16 ; 10 -> "1010" base 2 ; 0 -> "0"
    assert(basex.to_base(255, 16) == "ff", "to_base 255 base16 == ff")
    assert(basex.to_base(10, 2) == "1010", "to_base 10 base2 == 1010")
    assert(basex.to_base(0, 16) == "0", "to_base 0 == 0")

    // from_base: inverse, case-insensitive
    assert(basex.from_base("ff", 16) == 255, "from_base ff base16 == 255")
    assert(basex.from_base("FF", 16) == 255, "from_base FF uppercase == 255")
    assert(basex.from_base("1010", 2) == 10, "from_base 1010 base2 == 10")

    // round-trip
    assert(basex.from_base(basex.to_base(12345, 36), 36) == 12345, "round-trip base36 12345")

    // is_digit_str: non-empty all-digits -> 1, else 0
    assert(basex.is_digit_str("007") == 1, "is_digit_str 007 == 1")
    assert(basex.is_digit_str("12a") == 0, "is_digit_str 12a == 0")
    assert(basex.is_digit_str("") == 0, "is_digit_str empty == 0")

    // is_int_str: optional sign then >=1 digit
    assert(basex.is_int_str("-42") == 1, "is_int_str -42 == 1")
    assert(basex.is_int_str("+42") == 1, "is_int_str +42 == 1")
    assert(basex.is_int_str("-") == 0, "is_int_str bare sign == 0")
    assert(basex.is_int_str("12a") == 0, "is_int_str 12a == 0")

    print("basex_lib_test passed")
