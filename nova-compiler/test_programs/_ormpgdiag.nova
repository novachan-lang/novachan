// _ormpgdiag -- get the ACTUAL PostgreSQL error for the failing orm_insert path, instead of
// theorising. The gated test ignores orm_insert's Result, so the real message was never printed.

import forge_orm
import forge_pg

type DUser
    id: int
    name: string
    age: int
    active: bool

fn show(tag: string, r)
    if is_err(r)
        print("  {tag} -> Err: {unwrap_err(r)}")
    else
        print("  {tag} -> Ok: {str(unwrap(r))}")

fn main()
    let url = "postgres://postgres:root@127.0.0.1:5432/postgres"
    let dr = orm_open(url)
    if is_err(dr)
        print("open failed: {unwrap_err(dr)}")
        return
    let db = unwrap(dr)

    show("drop", orm_exec(db, "DROP TABLE IF EXISTS diag_users", []))
    show("create", orm_exec(db, "CREATE TABLE diag_users (id int, name text, age int, active int)", []))

    print("A. plain orm_exec insert with an explicit int for active")
    show("insert int", orm_exec(db, "INSERT INTO diag_users (id, name, age, active) VALUES (?, ?, ?, ?)", [1, "Plain", 30, 1]))

    print("B. orm_exec insert binding a NOVA bool directly")
    show("insert bool", orm_exec(db, "INSERT INTO diag_users (id, name, age, active) VALUES (?, ?, ?, ?)", [2, "BoolLit", 31, true]))

    print("C. orm_insert with a STRUCT carrying a bool field (the failing case)")
    show("orm_insert struct", orm_insert(db, "diag_users", DUser(3, "Margaret", 60, true)))

    print("D. what is actually in the table?")
    let rows = orm_all(db, "SELECT id, name, age, active FROM diag_users ORDER BY id", [])
    print("  row count = {len(rows)}")
    for r in rows
        print("  row: id={str(r["id"])} name={str(r["name"])} age={str(r["age"])} active={str(r["active"])}")

    print("E. (skipped: private fn)")

    print("F. typed read back")
    let us: list<DUser> = orm_all(db, "SELECT id, name, age, active FROM diag_users ORDER BY id", [])
    print("  typed count = {len(us)}")
    for u in us
        print("  typed: id={u.id} name={u.name} age={u.age} active={u.active}")

    _ = orm_exec(db, "DROP TABLE IF EXISTS diag_users", [])
    orm_close(db)
    print("DONE")
