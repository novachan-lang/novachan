// KAT test for std/numeric/hyp_chisq — chi-squared statistics.
import std/numeric/hyp_chisq

// approx: check |a-b| < tol; returns 1 if pass
fn approx(a, b, tol) -> float
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < tol

fn ckf(label: string, got: float, want: float, tol: float)
    let ok = approx(got, want, tol)
    if ok == 0
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("ok " + label)

fn main()
    // KAT 1: observed == expected -> chi2 == 0.0
    let obs1 = [10.0, 10.0, 10.0]
    let exp1 = [10.0, 10.0, 10.0]
    let r1 = chisq_statistic(obs1, exp1)
    ckf("perfect_fit -> 0", r1, 0.0, 0.0001)

    // KAT 2: known value — (12-10)^2/10 + (8-10)^2/10 = 4/10 + 4/10 = 0.8
    let obs2 = [12.0, 8.0]
    let exp2 = [10.0, 10.0]
    let r2 = chisq_statistic(obs2, exp2)
    ckf("known_value 0.8", r2, 0.8, 0.0001)

    // KAT 3: chi-squared is always >= 0
    let obs3 = [5.0, 15.0, 10.0]
    let exp3 = [10.0, 10.0, 10.0]
    let r3 = chisq_statistic(obs3, exp3)
    if r3 < 0.0
        print("FAIL chisq_non_negative: got " + str(r3))
        exit(1)
    print("ok chisq_non_negative (" + str(r3) + ")")

    // KAT 4: chisq_gof on uniform observed -> 0.0
    // [10,10,10]: total=30, expected=10 each -> chi2=0
    let obs4 = [10.0, 10.0, 10.0]
    let r4 = chisq_gof(obs4)
    ckf("gof_uniform -> 0", r4, 0.0, 0.0001)

    // KAT 5: chisq_gof on skewed observed -> > 0
    // [15,5]: total=20, expected=10 each -> (5^2/10)*2 = 5.0
    let obs5 = [15.0, 5.0]
    let r5 = chisq_gof(obs5)
    ckf("gof_skewed known 5.0", r5, 5.0, 0.001)

    // KAT 6: chisq_gof on 4 categories -> known
    // [20,10,10,10]: total=50, expected=12.5 each
    // (20-12.5)^2/12.5 + 3*(10-12.5)^2/12.5 = 56.25/12.5 + 3*6.25/12.5 = 4.5 + 1.5 = 6.0
    let obs6 = [20.0, 10.0, 10.0, 10.0]
    let r6 = chisq_gof(obs6)
    ckf("gof_4cat known 6.0", r6, 6.0, 0.001)

    // KAT 7: empty list returns 0.0
    let obs7 = []
    let exp7 = []
    let r7 = chisq_statistic(obs7, exp7)
    ckf("empty -> 0", r7, 0.0, 0.0001)

    print("PASS _hyp_chisq_test")
