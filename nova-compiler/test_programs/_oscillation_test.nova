// KAT for std/physics/oscillation
// Tests: PI, shm_period, shm_frequency, pendulum_period
import std/physics/oscillation

fn approx(a, b)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    let result = d < 0.001
    result

fn main()
    // KAT 1: PI() ~ 3.14159
    let p = PI()
    let ok1 = approx(p, 3.14159)
    if ok1 != true
        print("FAIL oscillation PI(): got=" + str(p) + " want~3.14159")
        exit(1)

    // KAT 2: shm_period(1.0, 1.0) == 2*pi ~ 6.28318
    // T = 2*pi*sqrt(1/1) = 2*pi
    let t11 = shm_period(1.0, 1.0)
    let ok2 = approx(t11, 6.28318)
    if ok2 != true
        print("FAIL oscillation shm_period(1,1): got=" + str(t11) + " want~6.28318")
        exit(1)

    // KAT 3: shm_period(4.0, 1.0) == 4*pi ~ 12.56637
    // T = 2*pi*sqrt(4/1) = 2*pi*2 = 4*pi
    let t41 = shm_period(4.0, 1.0)
    let ok3 = approx(t41, 12.56637)
    if ok3 != true
        print("FAIL oscillation shm_period(4,1): got=" + str(t41) + " want~12.56637")
        exit(1)

    // KAT 4: shm_frequency(1.0, 1.0) == 1/(2*pi) ~ 0.15915
    let f11 = shm_frequency(1.0, 1.0)
    let ok4 = approx(f11, 0.15915)
    if ok4 != true
        print("FAIL oscillation shm_frequency(1,1): got=" + str(f11) + " want~0.15915")
        exit(1)

    // KAT 5: shm_frequency(1.0, 4.0) == 2/(2*pi) = 1/pi ~ 0.31831
    // T = 2*pi*sqrt(1/4) = 2*pi*0.5 = pi; f = 1/pi
    let f14 = shm_frequency(1.0, 4.0)
    let ok5 = approx(f14, 0.31831)
    if ok5 != true
        print("FAIL oscillation shm_frequency(1,4): got=" + str(f14) + " want~0.31831")
        exit(1)

    // KAT 6: pendulum_period(1.0) ~ 2.0061 (standard result for 1m pendulum)
    // T = 2*pi*sqrt(1/9.81)
    let pp1 = pendulum_period(1.0)
    let lo6 = 2.006 - 0.01
    let hi6 = 2.006 + 0.01
    if pp1 < lo6
        print("FAIL oscillation pendulum_period(1): got=" + str(pp1) + " want~2.006")
        exit(1)
    if pp1 > hi6
        print("FAIL oscillation pendulum_period(1): got=" + str(pp1) + " want~2.006")
        exit(1)

    // KAT 7: pendulum_period(4.0) == 2*pendulum_period(1.0)  (T scales as sqrt(L))
    let pp4 = pendulum_period(4.0)
    let pp1x2 = pp1 * 2.0
    let ok7 = approx(pp4, pp1x2)
    if ok7 != true
        print("FAIL oscillation pendulum scaling: pp4=" + str(pp4) + " 2*pp1=" + str(pp1x2))
        exit(1)

    // KAT 8: shm_period increases with more mass (k fixed)
    let tp1 = shm_period(1.0, 10.0)
    let tp4 = shm_period(4.0, 10.0)
    if tp4 < tp1
        print("FAIL oscillation period must grow with mass: tp1=" + str(tp1) + " tp4=" + str(tp4))
        exit(1)

    print("PASS _oscillation_test")
