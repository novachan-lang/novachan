import std/time/stopwatch

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + got + " expected=" + expected)
        exit(1)

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

fn main()
    // ── KAT: sw_format known-answer tests ──────────────────────────────────
    cks("format_1.5s",   sw_format(1500000000), "1.500s")
    cks("format_2ms",    sw_format(2000000),    "2ms")
    cks("format_500us",  sw_format(500000),     "500us")
    cks("format_750ns",  sw_format(750),        "750ns")
    cks("format_1.000s", sw_format(1000000000), "1.000s")

    // ── KAT: _pad3 edge cases exercised through sw_format ──────────────────
    // frac = 7 -> "007"
    cks("format_1.007s", sw_format(1007000000), "1.007s")
    // frac = 42 -> "042"
    cks("format_1.042s", sw_format(1042000000), "1.042s")
    // frac = 999 -> "999"
    cks("format_1.999s", sw_format(1999000000), "1.999s")

    // ── KAT: boundary exactly at threshold ─────────────────────────────────
    cks("format_1us",   sw_format(1000),    "1us")
    cks("format_1ms",   sw_format(1000000), "1ms")
    cks("format_0ns",   sw_format(0),       "0ns")
    cks("format_999ns", sw_format(999),     "999ns")

    // ── Live stopwatch: elapsed must be non-negative ────────────────────────
    let sw = sw_new()
    let e = sw_elapsed_ns(sw)
    if e < 0
        print("FAIL elapsed_ns negative: " + str(e))
        exit(1)

    // ── sw_elapsed_ms must also be non-negative ─────────────────────────────
    let ms = sw_elapsed_ms(sw)
    if ms < 0
        print("FAIL elapsed_ms negative: " + str(ms))
        exit(1)

    // ── sw_reset must return a dict with a fresh start ──────────────────────
    let sw2 = sw_new()
    sw_reset(sw2)
    let e2 = sw_elapsed_ns(sw2)
    if e2 < 0
        print("FAIL reset elapsed_ns negative: " + str(e2))
        exit(1)

    print("_stopwatch_test passed")
