import forge_base58check

fn ck(label: string, got: string, want: string)
    let ok = "FAIL"
    if got == want
        ok = "ok"
    print(label + "=" + ok + " (" + got + ")")

fn main()
    // Canonical: pubkey hash 62e907b15cbf27d5425399ebf6f0fb50ebb88f18, version 0x00 (P2PKH mainnet)
    // -> Base58Check address "1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa" (the Satoshi genesis address)
    let hash160 = [98, 233, 7, 177, 92, 191, 39, 213, 66, 83, 153, 235, 246, 240, 251, 80, 235, 184, 143, 24]
    ck("genesis", base58check_encode(0, hash160), "1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa")
    // leading-zero handling: raw bytes [0,0,1] -> base58 "112" (two '1' for two zero bytes, then 1)
    ck("leadzero", base58_encode_bytes([0, 0, 1]), "112")
    // simple byte value: [57] = 57 -> base58 "z" (57 -> alphabet index 56 = 'z')
    ck("single", base58_encode_bytes([57]), "z")
