// KAT for std/physics/thermodynamics.
import std/physics/thermodynamics

fn approx(a, b)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < 0.001

fn ckf(label, got, want)
    if not approx(got, want)
        print("FAIL thermodynamics " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // carnot_efficiency(300,600) = 1 - 300/600 = 0.5
    ckf("carnot_efficiency(300,600)", carnot_efficiency(300.0, 600.0), 0.5)
    // carnot_efficiency(200,400) = 1 - 0.5 = 0.5
    ckf("carnot_efficiency(200,400)", carnot_efficiency(200.0, 400.0), 0.5)
    // carnot_efficiency(0,300) = 1.0 (ideal)
    ckf("carnot_efficiency(0,300)", carnot_efficiency(0.0, 300.0), 1.0)

    // heat_engine_efficiency(1000,400) = 1 - 400/1000 = 0.6
    ckf("heat_engine_efficiency(1000,400)", heat_engine_efficiency(1000.0, 400.0), 0.6)
    // heat_engine_efficiency(500,250) = 0.5
    ckf("heat_engine_efficiency(500,250)", heat_engine_efficiency(500.0, 250.0), 0.5)

    // entropy_change(100,50) = 100/50 = 2.0
    ckf("entropy_change(100,50)", entropy_change(100.0, 50.0), 2.0)
    // entropy_change(200,100) = 2.0
    ckf("entropy_change(200,100)", entropy_change(200.0, 100.0), 2.0)
    // entropy_change(300,150) = 2.0
    ckf("entropy_change(300,150)", entropy_change(300.0, 150.0), 2.0)

    // work_isothermal(1,300,2,1) = 1*8.314*300*ln(2) ~ 1728.848
    let w1 = work_isothermal(1.0, 300.0, 2.0, 1.0)
    ckf("work_isothermal(1,300,2,1)", w1, 1728.848)

    print("PASS _thermodynamics_test")
