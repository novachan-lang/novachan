import forge_mysql
import forge_crypto

fn _hex(blist) -> string
    let h = "0123456789abcdef"
    let out = ""
    let i = 0
    while i < len(blist)
        let b = blist[i]
        out = out + char_at(h, (b >> 4) & 15) + char_at(h, b & 15)
        i = i + 1
    out

fn _envor(name: string, dflt: string) -> string
    let v = env(name)
    if len(v) > 0
        return v
    dflt

fn main()
    let kat = _hex(sha1_bytes(str_to_blist("abc")))
    if kat != "a9993e364706816aba3e25717850c26c9cd0d89d"
        print("FAIL sha1 KAT: " + kat)
        exit(1)
    print("sha1 KAT ok")
    let pw = env("MYSQLPASSWORD")
    if len(pw) == 0
        print("forge_mysql_test: live MySQL skipped (set MYSQLPASSWORD to run)")
        print("forge_mysql_test passed")
        return
    let host = _envor("MYSQLHOST", "127.0.0.1")
    let port = parse_int(_envor("MYSQLPORT", "3306"))
    let user = _envor("MYSQLUSER", "root")
    let cr = mysql_connect(host, port, user, "", pw)
    match cr
        Ok(conn) =>
            print("CONNECT OK")
            mysql_query(conn, "CREATE DATABASE IF NOT EXISTS nova_test")
            mysql_query(conn, "DROP TABLE IF EXISTS nova_test.t")
            mysql_query(conn, "CREATE TABLE nova_test.t (id int, name varchar(64), age int)")
            mysql_query(conn, "INSERT INTO nova_test.t (id, name, age) VALUES (1, 'Ada', 36)")
            mysql_query(conn, "INSERT INTO nova_test.t (id, name, age) VALUES (2, 'Linus', 54)")
            let qr = mysql_query(conn, "SELECT id, name, age FROM nova_test.t ORDER BY id")
            match qr
                Ok(rows) =>
                    assert_eq(len(rows), 2)
                    assert_eq(rows[0]["name"], "Ada")
                    assert_eq(rows[0]["age"], "36")
                    assert_eq(rows[1]["name"], "Linus")
                    print("LIVE MYSQL QUERY OK: " + rows[0]["name"] + " / " + rows[1]["name"])
                Err(e) =>
                    print("FAIL query: " + e)
                    exit(1)
            let pr = mysql_query_params(conn, "SELECT id, name, age FROM nova_test.t WHERE age > ? ORDER BY id", [40])
            match pr
                Ok(prows) =>
                    assert_eq(len(prows), 1)
                    assert_eq(prows[0]["name"], "Linus")
                    assert_eq(prows[0]["age"], "54")
                    print("PREPARED PARAM QUERY OK (numeric bind)")
                Err(e) =>
                    print("FAIL param query: " + e)
                    exit(1)
            let ir = mysql_query_params(conn, "SELECT ? AS x", ["x'; DROP TABLE nova_test.t; --"])
            match ir
                Ok(irows) =>
                    assert_eq(irows[0]["x"], "x'; DROP TABLE nova_test.t; --")
                    print("INJECTION-SAFE OK (param returned as inert data)")
                Err(e) =>
                    print("FAIL injection test: " + e)
                    exit(1)
            mysql_query(conn, "DROP TABLE IF EXISTS nova_test.t")
            mysql_close(conn)
            print("forge_mysql_test passed")
        Err(e) =>
            print("CONNECT FAIL: " + e)
            exit(1)
