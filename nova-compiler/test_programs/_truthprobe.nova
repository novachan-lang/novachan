// Probe: boxed float 0.0 used directly in boolean contexts.
// EXPECTED (C-style truthiness): 0.0 is falsy, nonzero float is truthy.
fn main()
    let fs = [0.0, 2.5]
    // bare if on a boxed float element
    if fs[0]
        print("BUG bare-if 0.0 truthy")
    else
        print("ok bare-if 0.0 falsy")
    if fs[1]
        print("ok bare-if 2.5 truthy")
    else
        print("BUG bare-if 2.5 falsy")
    // not on a boxed float element
    if not fs[0]
        print("ok not-0.0 => true")
    else
        print("BUG not-0.0 => false")
    // dict-boxed float
    let d = {}
    d["z"] = 0.0
    if d["z"]
        print("BUG dict 0.0 truthy")
    else
        print("ok dict 0.0 falsy")
    print("done-truth")
