import std/game/maze_sidewinder

// --- Structural validation helpers ---

// Count total edges (passages) in links.  Each passage stored twice.
fn _edge_count(links)
    let total = 0
    let i = 0
    let n = len(links)
    while i < n
        total = total + len(links[i])
        i = i + 1
    return total / 2

// BFS from cell 0; return number of reachable cells.
fn _bfs_count(links)
    let n = len(links)
    let visited = []
    let i = 0
    while i < n
        push(visited, 0)
        i = i + 1

    // Queue implemented as a list; use a head pointer to avoid O(n^2) removal.
    let queue = []
    push(queue, 0)
    visited[0] = 1
    let head = 0
    let count = 1

    // Bound: each cell enqueued at most once, so at most n iterations.
    while head < len(queue)
        let cell = queue[head]
        head = head + 1
        let nbrs = links[cell]
        let j = 0
        let nblen = len(nbrs)
        while j < nblen
            let nb = nbrs[j]
            if visited[nb] == 0
                visited[nb] = 1
                push(queue, nb)
                count = count + 1
            j = j + 1

    return count

// Deep-equal two lists-of-lists.
fn _links_equal(a, b)
    let na = len(a)
    let nb = len(b)
    if na != nb
        return 0
    let i = 0
    while i < na
        let ai = a[i]
        let bi = b[i]
        if len(ai) != len(bi)
            return 0
        let j = 0
        while j < len(ai)
            if ai[j] != bi[j]
                return 0
            j = j + 1
        i = i + 1
    return 1

// Check that the top row forms a fully connected east-west corridor.
// In sidewinder, every cell in row 0 except the last must have a passage east,
// i.e. cell c and c+1 are connected.  We verify by checking BFS reaches all w
// cells from cell 0 using only same-row links.
fn _top_row_connected(links, w)
    // BFS restricted to cells 0..w-1.
    let visited = []
    let i = 0
    while i < w
        push(visited, 0)
        i = i + 1

    let queue = []
    push(queue, 0)
    visited[0] = 1
    let head = 0
    let count = 1

    while head < len(queue)
        let cell = queue[head]
        head = head + 1
        let nbrs = links[cell]
        let j = 0
        let nblen = len(nbrs)
        while j < nblen
            let nb = nbrs[j]
            // Only consider top-row cells.
            if nb < w
                if visited[nb] == 0
                    visited[nb] = 1
                    push(queue, nb)
                    count = count + 1
            j = j + 1

    return count

// --- KAT ---

fn main()
    // Test 1: 6x6 grid, seed 42 -> edge_count == 35, fully connected
    let w1 = 6
    let h1 = 6
    let links1 = gen(w1, h1, 42)
    let ec1 = _edge_count(links1)
    let want_ec1 = w1 * h1 - 1
    if ec1 != want_ec1
        print("FAIL maze_sidewinder edge_count 6x6: got " + str(ec1) + " want " + str(want_ec1))
        exit(1)
    let conn1 = _bfs_count(links1)
    if conn1 != w1 * h1
        print("FAIL maze_sidewinder connected 6x6: visited " + str(conn1) + " want " + str(w1 * h1))
        exit(1)

    // Test 2: 4x4 grid, seed 7 -> edge_count == 15, fully connected
    let w2 = 4
    let h2 = 4
    let links2 = gen(w2, h2, 7)
    let ec2 = _edge_count(links2)
    let want_ec2 = w2 * h2 - 1
    if ec2 != want_ec2
        print("FAIL maze_sidewinder edge_count 4x4: got " + str(ec2) + " want " + str(want_ec2))
        exit(1)
    let conn2 = _bfs_count(links2)
    if conn2 != w2 * h2
        print("FAIL maze_sidewinder connected 4x4: visited " + str(conn2) + " want " + str(w2 * h2))
        exit(1)

    // Test 3: 5x3 grid, seed 1 -> edge_count == 14, fully connected
    let w3 = 5
    let h3 = 3
    let links3 = gen(w3, h3, 1)
    let ec3 = _edge_count(links3)
    let want_ec3 = w3 * h3 - 1
    if ec3 != want_ec3
        print("FAIL maze_sidewinder edge_count 5x3: got " + str(ec3) + " want " + str(want_ec3))
        exit(1)
    let conn3 = _bfs_count(links3)
    if conn3 != w3 * h3
        print("FAIL maze_sidewinder connected 5x3: visited " + str(conn3) + " want " + str(w3 * h3))
        exit(1)

    // Test 4: determinism — gen with same seed returns identical links
    let links1b = gen(w1, h1, 42)
    if _links_equal(links1, links1b) == 0
        print("FAIL maze_sidewinder determinism 6x6: two calls with seed 42 differ")
        exit(1)
    let links2b = gen(w2, h2, 7)
    if _links_equal(links2, links2b) == 0
        print("FAIL maze_sidewinder determinism 4x4: two calls with seed 7 differ")
        exit(1)
    let links3b = gen(w3, h3, 1)
    if _links_equal(links3, links3b) == 0
        print("FAIL maze_sidewinder determinism 5x3: two calls with seed 1 differ")
        exit(1)

    // Test 5: top row is fully connected east-west (all w cells reachable from cell 0
    //         using only row-0 passages).
    let top1 = _top_row_connected(links1, w1)
    if top1 != w1
        print("FAIL maze_sidewinder top_row 6x6: reached " + str(top1) + " want " + str(w1))
        exit(1)
    let top2 = _top_row_connected(links2, w2)
    if top2 != w2
        print("FAIL maze_sidewinder top_row 4x4: reached " + str(top2) + " want " + str(w2))
        exit(1)
    let top3 = _top_row_connected(links3, w3)
    if top3 != w3
        print("FAIL maze_sidewinder top_row 5x3: reached " + str(top3) + " want " + str(w3))
        exit(1)

    print("PASS _maze_sidewinder_test")
