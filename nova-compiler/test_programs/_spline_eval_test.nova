// KAT test for std/numeric/spline_eval — natural cubic spline evaluation.
// Tests pass-through at knots, in-range values, and extrapolation.
import std/numeric/spline_natural
import std/numeric/spline_eval

fn approx(a: float, b: float, tol: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < tol

fn chk(label: string, cond: bool)
    if not cond
        print("FAIL spline_eval " + label)
        exit(1)
    print("ok " + label)

fn main()
    // Dataset: arch (0,0),(1,1),(2,0)
    let xs = [0.0, 1.0, 2.0]
    let ys = [0.0, 1.0, 0.0]
    let M = spline_coeffs(xs, ys)

    // KAT 1: passes through knot x=0 -> y=0
    let v0 = spline_eval(xs, ys, M, 0.0)
    chk("knot_x0", approx(v0, 0.0, 0.0001))

    // KAT 2: passes through knot x=1 -> y=1
    let v1 = spline_eval(xs, ys, M, 1.0)
    chk("knot_x1", approx(v1, 1.0, 0.0001))

    // KAT 3: passes through knot x=2 -> y=0
    let v2 = spline_eval(xs, ys, M, 2.0)
    chk("knot_x2", approx(v2, 0.0, 0.0001))

    // KAT 4: x=0.5 should be between 0 and 1 (arch shape)
    let v05 = spline_eval(xs, ys, M, 0.5)
    chk("mid_in_range", v05 > 0.0 and v05 < 1.0)

    // KAT 5: x=1.5 should also be between 0 and 1
    let v15 = spline_eval(xs, ys, M, 1.5)
    chk("mid2_in_range", v15 > 0.0 and v15 < 1.0)

    // KAT 6: symmetry — arch is symmetric, so f(0.5) == f(1.5)
    chk("symmetry", approx(v05, v15, 0.0001))

    // KAT 7: straight-line dataset -> spline == linear interpolation
    let xs2 = [0.0, 1.0, 2.0, 3.0]
    let ys2 = [0.0, 2.0, 4.0, 6.0]
    let M2 = spline_coeffs(xs2, ys2)
    let sl1 = spline_eval(xs2, ys2, M2, 1.5)
    chk("straight_line_mid", approx(sl1, 3.0, 0.0001))

    // KAT 8: inline convenience agrees with two-step
    let vi = spline_eval_inline(xs, ys, 0.5)
    chk("inline_agrees", approx(vi, v05, 0.0001))

    // KAT 9: extrapolation is graceful (no crash, finite value)
    let vext = spline_eval(xs, ys, M, -0.5)
    let vext_pos = vext
    if vext_pos < 0.0
        vext_pos = 0.0 - vext_pos
    chk("extrapolate_finite", vext_pos < 1000.0)

    // KAT 10: exact mid-arch value via natural spline formula
    // With M[0]=0, M[1]=-3, M[2]=0, h=1:
    //   at x=0.5, A=0.5, B=0.5
    //   cubic = ((0.125-0.5)*0 + (0.125-0.5)*(-3))*1/6 = ((-0.375)*(-3))/6 = 1.125/6 = 0.1875
    //   S(0.5) = 0.5*0 + 0.5*1 + 0.1875 = 0.6875
    chk("mid_exact", approx(v05, 0.6875, 0.001))

    print("PASS _spline_eval_test")
