// L8 fix: `obj[i]` on an unannotated struct param can't be statically dispatched -> must PANIC loudly
// (previously it silently returned 0, a wrong answer). Expect: prints "before", then aborts (non-zero
// exit, stderr mentions the struct-index error), and NEVER prints "after".
type Bag
    items: list

fn Bag.index(self, i) -> any
    self.items[i]

fn read_unannotated(a) -> any      // param type inferred only from [] usage -> unresolved -> loud fail
    a[0]

fn main()
    let b = Bag([10, 20])
    print("before")
    let x = read_unannotated(b)
    print("after x=" + str(x))     // must NOT be reached
