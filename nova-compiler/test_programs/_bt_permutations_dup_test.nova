import std/backtracking/bt_permutations_dup

// cki — check integer equality
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL bt_permutations_dup " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb — check bool equality
fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL bt_permutations_dup " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

// list_to_str — convert int list to string
fn list_to_str(xs) -> string
    let s = "["
    let i = 0
    let n = len(xs)
    while i < n
        if i > 0
            s = s + ","
        s = s + str(xs[i])
        i = i + 1
    s = s + "]"
    s

// cks — check string equality
fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL bt_permutations_dup " + label + ": got=" + got + " want=" + want)
        exit(1)

// list_eq — true if two int lists are equal element-wise
fn list_eq(a, b) -> bool
    if len(a) != len(b)
        return false
    let i = 0
    while i < len(a)
        if a[i] != b[i]
            return false
        i = i + 1
    true

// contains_perm — true if xss contains a sublist equal to target
fn contains_perm(xss, target) -> bool
    let i = 0
    while i < len(xss)
        if list_eq(xss[i], target)
            return true
        i = i + 1
    false

// cknest — check that result has expected length
fn cknest(label: string, xss, wlen: int)
    if len(xss) != wlen
        print("FAIL bt_permutations_dup " + label + "_len: got=" + str(len(xss)) + " want=" + str(wlen))
        exit(1)

fn main()
    // --- pd_count ---
    let e = []
    cki("count_empty", pd_count(e), 1)

    let a112 = [1, 1, 2]
    cki("count_112", pd_count(a112), 3)

    let a123 = [1, 2, 3]
    cki("count_123", pd_count(a123), 6)

    let a222 = [2, 2, 2]
    cki("count_222", pd_count(a222), 1)

    let a1112 = [1, 1, 1, 2]
    cki("count_1112", pd_count(a1112), 4)

    // --- pd_solve([]) = [[]] ---
    let pe = pd_solve(e)
    cki("solve_empty_len", len(pe), 1)
    let emptylist = []
    ckb("solve_empty_has_empty", contains_perm(pe, emptylist), true)

    // --- pd_solve([1,1,2]) = [[1,1,2],[1,2,1],[2,1,1]] ---
    let p112 = pd_solve(a112)
    cknest("solve_112", p112, 3)

    let w112 = [1, 1, 2]
    let w121 = [1, 2, 1]
    let w211 = [2, 1, 1]
    ckb("solve_112_has_112", contains_perm(p112, w112), true)
    ckb("solve_112_has_121", contains_perm(p112, w121), true)
    ckb("solve_112_has_211", contains_perm(p112, w211), true)

    // lex order check: first = [1,1,2], last = [2,1,1]
    cks("solve_112_first", list_to_str(p112[0]), "[1,1,2]")
    cks("solve_112_last", list_to_str(p112[2]), "[2,1,1]")

    // --- pd_solve([1,2,3]) has 6 permutations ---
    let p123 = pd_solve(a123)
    cknest("solve_123", p123, 6)
    // lex first = [1,2,3], last = [3,2,1]
    cks("solve_123_first", list_to_str(p123[0]), "[1,2,3]")
    cks("solve_123_last", list_to_str(p123[5]), "[3,2,1]")

    // --- pd_solve([2,2,2]) = [[2,2,2]] ---
    let p222 = pd_solve(a222)
    cknest("solve_222", p222, 1)
    cks("solve_222_0", list_to_str(p222[0]), "[2,2,2]")

    // --- pd_solve([1,1,1,2]) has 4 perms: [1,1,1,2],[1,1,2,1],[1,2,1,1],[2,1,1,1] ---
    let p1112 = pd_solve(a1112)
    cknest("solve_1112", p1112, 4)
    let w1112 = [1, 1, 1, 2]
    let w1121 = [1, 1, 2, 1]
    let w1211 = [1, 2, 1, 1]
    let w2111 = [2, 1, 1, 1]
    ckb("solve_1112_has_1112", contains_perm(p1112, w1112), true)
    ckb("solve_1112_has_1121", contains_perm(p1112, w1121), true)
    ckb("solve_1112_has_1211", contains_perm(p1112, w1211), true)
    ckb("solve_1112_has_2111", contains_perm(p1112, w2111), true)

    // --- single element ---
    let a1 = [5]
    let p1 = pd_solve(a1)
    cki("solve_1elem_len", len(p1), 1)
    cks("solve_1elem_0", list_to_str(p1[0]), "[5]")

    print("PASS _bt_permutations_dup_test")
