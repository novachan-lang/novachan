import std/quantum/quantum_state
import std/quantum/quantum_entangle

// cki — integer known-answer check.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _quantum_entangle_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // qen_bell_phi_plus: (|00>+|11>)/sqrt(2)
    let phip = qen_bell_phi_plus()
    cki("phi_plus prob0", qst_prob_x1000(phip, 0), 500)
    cki("phi_plus prob1", qst_prob_x1000(phip, 1), 0)
    cki("phi_plus prob2", qst_prob_x1000(phip, 2), 0)
    cki("phi_plus prob3", qst_prob_x1000(phip, 3), 500)

    // qen_bell_phi_minus: (|00>-|11>)/sqrt(2) — same probabilities as phi_plus
    let phim = qen_bell_phi_minus()
    cki("phi_minus prob0", qst_prob_x1000(phim, 0), 500)
    cki("phi_minus prob3", qst_prob_x1000(phim, 3), 500)

    // qen_bell_psi_plus: (|01>+|10>)/sqrt(2)
    let psip = qen_bell_psi_plus()
    cki("psi_plus prob0", qst_prob_x1000(psip, 0), 0)
    cki("psi_plus prob1", qst_prob_x1000(psip, 1), 500)
    cki("psi_plus prob2", qst_prob_x1000(psip, 2), 500)
    cki("psi_plus prob3", qst_prob_x1000(psip, 3), 0)

    // qen_bell_psi_minus: (|01>-|10>)/sqrt(2) — same probabilities as psi_plus
    let psim = qen_bell_psi_minus()
    cki("psi_minus prob1", qst_prob_x1000(psim, 1), 500)
    cki("psi_minus prob2", qst_prob_x1000(psim, 2), 500)

    // qen_ghz(3): (|000>+|111>)/sqrt(2)
    let g3 = qen_ghz(3)
    cki("ghz3 dim", qst_dim(g3), 8)
    cki("ghz3 prob0", qst_prob_x1000(g3, 0), 500)
    cki("ghz3 prob7", qst_prob_x1000(g3, 7), 500)
    cki("ghz3 prob1", qst_prob_x1000(g3, 1), 0)
    cki("ghz3 prob4", qst_prob_x1000(g3, 4), 0)

    // qen_ghz(2) should equal bell_phi_plus
    let g2 = qen_ghz(2)
    cki("ghz2 equals phi_plus", qst_equal_x1000(g2, phip), 1)

    // qen_w(2): (|01>+|10>)/sqrt(2) — indices with exactly one bit set: 2,1
    let w2 = qen_w(2)
    cki("w2 prob0", qst_prob_x1000(w2, 0), 0)
    cki("w2 prob1", qst_prob_x1000(w2, 1), 500)
    cki("w2 prob2", qst_prob_x1000(w2, 2), 500)
    cki("w2 prob3", qst_prob_x1000(w2, 3), 0)

    // qen_w(3): (|100>+|010>+|001>)/sqrt(3) — indices 4,2,1 each 1/3
    let w3 = qen_w(3)
    cki("w3 prob1", qst_prob_x1000(w3, 1), 333)
    cki("w3 prob2", qst_prob_x1000(w3, 2), 333)
    cki("w3 prob4", qst_prob_x1000(w3, 4), 333)
    cki("w3 prob0", qst_prob_x1000(w3, 0), 0)
    cki("w3 prob7", qst_prob_x1000(w3, 7), 0)

    // qen_is_product_2q: |00> is a product state
    cki("is_product |00>", qen_is_product_2q(qst_basis(2, 0)), 1)
    // |01>, |10>, |11> are also product states
    cki("is_product |01>", qen_is_product_2q(qst_basis(2, 1)), 1)
    cki("is_product |11>", qen_is_product_2q(qst_basis(2, 3)), 1)
    // Bell states are entangled (not product)
    cki("is_product phi_plus", qen_is_product_2q(phip), 0)
    cki("is_product psi_plus", qen_is_product_2q(psip), 0)

    // qen_concurrence_x1000: Bell states are maximally entangled (C=1)
    cki("concurrence phi_plus", qen_concurrence_x1000(phip), 1000)
    cki("concurrence phi_minus", qen_concurrence_x1000(phim), 1000)
    cki("concurrence psi_plus", qen_concurrence_x1000(psip), 1000)
    cki("concurrence psi_minus", qen_concurrence_x1000(psim), 1000)
    // Product states have zero concurrence
    cki("concurrence |00>", qen_concurrence_x1000(qst_basis(2, 0)), 0)
    cki("concurrence |01>", qen_concurrence_x1000(qst_basis(2, 1)), 0)

    print("PASS _quantum_entangle_test")
