// KAT test for std/encoding/uuencode
// Tests: uu_encode_line + uu_decode_line round-trip and known vectors.

import std/encoding/uuencode

// Build a bytes value from a plain ASCII string (safe for non-NUL ASCII).
fn _bytes(s) -> any
    let b = bytes(0)
    let i = 0
    while i < len(s)
        let ch = ord(s[i]) & 0xFF
        b = bytes_append(b, ch)
        i = i + 1
    b

// ── Helper assertions ─────────────────────────────────────────────────────────

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + got + " expected=" + expected)
        exit(1)

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

// ── KAT 1: encode "Cat" -> "#0V%T" ──────────────────────────────────────────
// "Cat" = [0x43, 0x61, 0x74]; n=3; length char chr(35)='#'
// 24-bit acc=0x436174; 6-bit groups: 16,54,5,52 -> '0','V','%','T'
let cat_bytes = _bytes("Cat")
let cat_enc = uu_encode_line(cat_bytes)
cks("encode_Cat_len", str(len(cat_enc)), str(5))
// length char = chr(3+32) = chr(35) = '#'
cki("encode_Cat_lench", ord(cat_enc[0]), 35)
// data chars: '0'=48, 'V'=86, '%'=37, 'T'=84
cki("encode_Cat_c0", ord(cat_enc[1]), 48)
cki("encode_Cat_c1", ord(cat_enc[2]), 86)
cki("encode_Cat_c2", ord(cat_enc[3]), 37)
cki("encode_Cat_c3", ord(cat_enc[4]), 84)

// ── KAT 2: encode empty bytes -> chr(32) (one space) ─────────────────────────
let empty_bytes = bytes(0)
let empty_enc = uu_encode_line(empty_bytes)
cki("encode_empty_len", len(empty_enc), 1)
cki("encode_empty_lench", ord(empty_enc[0]), 32)

// ── KAT 3: round-trip [0x00, 0xFF] ───────────────────────────────────────────
let b2 = bytes(0)
b2 = bytes_append(b2, 0)
b2 = bytes_append(b2, 255)
let enc2 = uu_encode_line(b2)
let dec2 = uu_decode_line(enc2)
// length char = chr(2+32) = chr(34) = '"'
cki("rt2_lench", ord(enc2[0]), 34)
// decoded length
cki("rt2_len", bytes_len(dec2), 2)
// decoded bytes
cki("rt2_byte0", bytes_get(dec2, 0) & 0xFF, 0)
cki("rt2_byte1", bytes_get(dec2, 1) & 0xFF, 255)

// ── KAT 4: empty bytes round-trip ────────────────────────────────────────────
let empty2 = bytes(0)
let enc_empty = uu_encode_line(empty2)
let dec_empty = uu_decode_line(enc_empty)
cki("rt_empty_len", bytes_len(dec_empty), 0)

// ── KAT 5: decode empty string -> empty bytes ────────────────────────────────
let dec_empty_str = uu_decode_line("")
cki("dec_emptystr_len", bytes_len(dec_empty_str), 0)

// ── KAT 6: round-trip single byte 0x42 = 'B' ────────────────────────────────
// n=1, length char = chr(33)='!'
// b0=0x42=66, b1=0, b2=0 (zero-padded)
// acc=(66<<16)=4325376=0x420000
// c0=(0x420000>>18)&0x3F = 0x10 & 0x3F = 16 -> chr(48)='0'
// c1=(0x420000>>12)&0x3F = 0x420 & 0x3F = 0x420 mod 64 = 1056 mod 64 = 1056-16*64=1056-1024=32... hmm
// Let me just test round-trip
let b1_val = bytes(0)
b1_val = bytes_append(b1_val, 66)
let enc1 = uu_encode_line(b1_val)
// length char should be chr(33)='!'
cki("rt1_lench", ord(enc1[0]), 33)
let dec1 = uu_decode_line(enc1)
cki("rt1_len", bytes_len(dec1), 1)
cki("rt1_byte0", bytes_get(dec1, 0) & 0xFF, 66)

// ── KAT 7: round-trip 3 known bytes [1, 2, 3] ───────────────────────────────
let b3 = bytes(0)
b3 = bytes_append(b3, 1)
b3 = bytes_append(b3, 2)
b3 = bytes_append(b3, 3)
let enc3 = uu_encode_line(b3)
// length char = chr(3+32)='#'
cki("rt3_lench", ord(enc3[0]), 35)
let dec3 = uu_decode_line(enc3)
cki("rt3_len", bytes_len(dec3), 3)
cki("rt3_byte0", bytes_get(dec3, 0) & 0xFF, 1)
cki("rt3_byte1", bytes_get(dec3, 1) & 0xFF, 2)
cki("rt3_byte2", bytes_get(dec3, 2) & 0xFF, 3)

// ── KAT 8: round-trip 6 bytes (two groups) [0x10, 0x20, 0x30, 0x40, 0x50, 0x60]
let b6 = bytes(0)
b6 = bytes_append(b6, 16)
b6 = bytes_append(b6, 32)
b6 = bytes_append(b6, 48)
b6 = bytes_append(b6, 64)
b6 = bytes_append(b6, 80)
b6 = bytes_append(b6, 96)
let enc6 = uu_encode_line(b6)
// length char = chr(6+32) = chr(38) = '&'
cki("rt6_lench", ord(enc6[0]), 38)
// encoded length: 1 + 2*4 = 9
cki("rt6_enclen", len(enc6), 9)
let dec6 = uu_decode_line(enc6)
cki("rt6_len", bytes_len(dec6), 6)
cki("rt6_byte0", bytes_get(dec6, 0) & 0xFF, 16)
cki("rt6_byte1", bytes_get(dec6, 1) & 0xFF, 32)
cki("rt6_byte2", bytes_get(dec6, 2) & 0xFF, 48)
cki("rt6_byte3", bytes_get(dec6, 3) & 0xFF, 64)
cki("rt6_byte4", bytes_get(dec6, 4) & 0xFF, 80)
cki("rt6_byte5", bytes_get(dec6, 5) & 0xFF, 96)

print("_uuencode_test passed")
