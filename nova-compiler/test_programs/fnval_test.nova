// First-class function values stored in locals can be called via name() — the
// unused-var checker must count `f()` as a read of the local f (regression for the
// E1000 false-positive found via ptestx).

fn double(x)
    return x * 2

fn apply_it(getter)
    let f = getter        // fn-value local
    return f(21)          // calling it counts as a read of f

fn pick()
    return double

fn main()
    let g = pick()        // g holds a fn value
    assert_eq(g(10), 20)  // calling a fn-value local
    assert_eq(apply_it(double), 42)
    print("fnval passed")
