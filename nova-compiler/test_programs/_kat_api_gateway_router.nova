import forge_api_gateway_router

fn main()
    let g = gw_new()
    assert(gw_route_count(g) == 0, "no routes")

    g = gw_add_route(g, "/api/users", "user-service:8080")
    g = gw_add_route(g, "/api/orders", "order-service:8081")
    g = gw_add_route(g, "/api/", "default-backend:8000")
    assert(gw_route_count(g) == 3, "3 routes")

    let r1 = gw_route(g, "/api/users/123")
    g = r1["g"]
    assert(r1["found"] == 1, "found users route")
    assert(r1["backend"] == "user-service:8080", "users backend")

    let r2 = gw_route(g, "/api/orders/456")
    g = r2["g"]
    assert(r2["found"] == 1, "found orders route")
    assert(r2["backend"] == "order-service:8081", "orders backend")

    let r3 = gw_route(g, "/api/health")
    g = r3["g"]
    assert(r3["found"] == 1, "fallback to /api/")
    assert(r3["backend"] == "default-backend:8000", "default backend")

    let r4 = gw_route(g, "/other/path")
    g = r4["g"]
    assert(r4["found"] == 0, "no match")
    assert(gw_total_misses(g) == 1, "1 miss")

    g = gw_disable_route(g, 0)
    let r5 = gw_route(g, "/api/users/789")
    g = r5["g"]
    assert(r5["backend"] == "default-backend:8000", "disabled users -> default")

    assert(gw_total_requests(g) == 5, "5 total requests")

    print("API-GATEWAY-ROUTER KAT PASS")
