fn slugify(text)
  let out = ""
  let prev_dash = 0
  let lower_text = lower(text)
  let i = 0
  while i < len(lower_text)
    let cp = code_points(slice(lower_text, i, i + 1))
    let c = cp[0]
    if (c >= 97 and c <= 122) or (c >= 48 and c <= 57)
      out = out + from_codepoint(c)
      prev_dash = 0
    else
      if len(out) > 0 and prev_dash == 0
        out = out + "-"
        prev_dash = 1
    i = i + 1
  if len(out) > 0 and slice(out, len(out) - 1, len(out)) == "-"
    out = slice(out, 0, len(out) - 1)
  out

fn slugify_max(text, max_len)
  let slug = slugify(text)
  if len(slug) <= max_len
    return slug
  let truncated = slice(slug, 0, max_len)
  if slice(truncated, len(truncated) - 1, len(truncated)) == "-"
    truncated = slice(truncated, 0, len(truncated) - 1)
  truncated

fn deslugify(slug)
  let words = split(slug, "-")
  let result = []
  for w in words
    if len(w) > 0
      let first = upper(slice(w, 0, 1))
      let rest = slice(w, 1, len(w))
      push(result, first + rest)
  join(result, " ")

fn main()
  assert(slugify("Hello World") == "hello-world", "basic slug")
  assert(slugify("NOVA Programming Language!") == "nova-programming-language", "caps + punctuation")
  assert(slugify("  multiple   spaces  ") == "multiple-spaces", "multiple spaces")
  assert(slugify("already-slug") == "already-slug", "idempotent")
  assert(slugify("Price: $9.99") == "price-9-99", "special chars")
  assert(slugify("a") == "a", "single char")
  assert(slugify("123") == "123", "numbers only")
  assert(slugify("") == "", "empty")
  assert(slugify("---") == "", "only dashes")

  assert(slugify_max("This Is A Very Long Title", 15) == "this-is-a-very", "truncated")
  assert(slugify_max("short", 50) == "short", "no truncation needed")

  assert(deslugify("hello-world") == "Hello World", "deslugify basic")
  assert(deslugify("nova-programming") == "Nova Programming", "deslugify multi")

  print("slugx: all passed")
