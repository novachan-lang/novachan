import std/midi/timesig

fn main()
    // ── timesig_encode ────────────────────────────────────────────────────────

    // 4/4 time: num=4 den=4 -> den_power=2, clocks=24, n32=8
    let r1 = timesig_encode(4, 4)
    if r1[0] != 4
        print("FAIL timesig encode(4,4)[0]: got " + str(r1[0]) + " want 4")
        exit(1)
    if r1[1] != 2
        print("FAIL timesig encode(4,4)[1]: got " + str(r1[1]) + " want 2")
        exit(1)
    if r1[2] != 24
        print("FAIL timesig encode(4,4)[2]: got " + str(r1[2]) + " want 24")
        exit(1)
    if r1[3] != 8
        print("FAIL timesig encode(4,4)[3]: got " + str(r1[3]) + " want 8")
        exit(1)

    // 6/8 time: num=6 den=8 -> den_power=3
    let r2 = timesig_encode(6, 8)
    if r2[0] != 6
        print("FAIL timesig encode(6,8)[0]: got " + str(r2[0]) + " want 6")
        exit(1)
    if r2[1] != 3
        print("FAIL timesig encode(6,8)[1]: got " + str(r2[1]) + " want 3")
        exit(1)
    if r2[2] != 24
        print("FAIL timesig encode(6,8)[2]: got " + str(r2[2]) + " want 24")
        exit(1)
    if r2[3] != 8
        print("FAIL timesig encode(6,8)[3]: got " + str(r2[3]) + " want 8")
        exit(1)

    // 3/4 time: num=3 den=4 -> den_power=2
    let r3 = timesig_encode(3, 4)
    if r3[0] != 3
        print("FAIL timesig encode(3,4)[0]: got " + str(r3[0]) + " want 3")
        exit(1)
    if r3[1] != 2
        print("FAIL timesig encode(3,4)[1]: got " + str(r3[1]) + " want 2")
        exit(1)
    if r3[2] != 24
        print("FAIL timesig encode(3,4)[2]: got " + str(r3[2]) + " want 24")
        exit(1)
    if r3[3] != 8
        print("FAIL timesig encode(3,4)[3]: got " + str(r3[3]) + " want 8")
        exit(1)

    // ── timesig_decode ────────────────────────────────────────────────────────

    // Decode [4,2,24,8] -> [4,4]
    let fields1 = []
    push(fields1, 4)
    push(fields1, 2)
    push(fields1, 24)
    push(fields1, 8)
    let d1 = timesig_decode(fields1)
    if d1[0] != 4
        print("FAIL timesig decode([4,2,24,8])[0]: got " + str(d1[0]) + " want 4")
        exit(1)
    if d1[1] != 4
        print("FAIL timesig decode([4,2,24,8])[1]: got " + str(d1[1]) + " want 4")
        exit(1)

    // Decode [6,3,24,8] -> [6,8]
    let fields2 = []
    push(fields2, 6)
    push(fields2, 3)
    push(fields2, 24)
    push(fields2, 8)
    let d2 = timesig_decode(fields2)
    if d2[0] != 6
        print("FAIL timesig decode([6,3,24,8])[0]: got " + str(d2[0]) + " want 6")
        exit(1)
    if d2[1] != 8
        print("FAIL timesig decode([6,3,24,8])[1]: got " + str(d2[1]) + " want 8")
        exit(1)

    // ── round-trip timesig ────────────────────────────────────────────────────

    // encode(3,4) -> decode -> should give back [3,4]
    let enc34 = timesig_encode(3, 4)
    let dec34 = timesig_decode(enc34)
    if dec34[0] != 3
        print("FAIL timesig round-trip(3,4)[0]: got " + str(dec34[0]) + " want 3")
        exit(1)
    if dec34[1] != 4
        print("FAIL timesig round-trip(3,4)[1]: got " + str(dec34[1]) + " want 4")
        exit(1)

    // encode(5,8) -> decode -> should give back [5,8]
    let enc58 = timesig_encode(5, 8)
    let dec58 = timesig_decode(enc58)
    if dec58[0] != 5
        print("FAIL timesig round-trip(5,8)[0]: got " + str(dec58[0]) + " want 5")
        exit(1)
    if dec58[1] != 8
        print("FAIL timesig round-trip(5,8)[1]: got " + str(dec58[1]) + " want 8")
        exit(1)

    // ── keysig_name ───────────────────────────────────────────────────────────

    let n0 = keysig_name(0, 0)
    if n0 != "C major"
        print("FAIL keysig_name(0,false): got " + n0 + " want C major")
        exit(1)

    let n2 = keysig_name(2, 0)
    if n2 != "D major"
        print("FAIL keysig_name(2,false): got " + n2 + " want D major")
        exit(1)

    let nm1 = keysig_name(-1, 0)
    if nm1 != "F major"
        print("FAIL keysig_name(-1,false): got " + nm1 + " want F major")
        exit(1)

    let n0m = keysig_name(0, 1)
    if n0m != "A minor"
        print("FAIL keysig_name(0,true): got " + n0m + " want A minor")
        exit(1)

    let n1m = keysig_name(1, 1)
    if n1m != "E minor"
        print("FAIL keysig_name(1,true): got " + n1m + " want E minor")
        exit(1)

    let n1s = keysig_name(1, 0)
    if n1s != "G major"
        print("FAIL keysig_name(1,false): got " + n1s + " want G major")
        exit(1)

    let nm2m = keysig_name(-2, 1)
    if nm2m != "G minor"
        print("FAIL keysig_name(-2,true): got " + nm2m + " want G minor")
        exit(1)

    // ── keysig_encode ─────────────────────────────────────────────────────────

    // sharps=0, major -> [0, 0]
    let ke0 = keysig_encode(0, 0)
    if ke0[0] != 0
        print("FAIL keysig_encode(0,0)[0]: got " + str(ke0[0]) + " want 0")
        exit(1)
    if ke0[1] != 0
        print("FAIL keysig_encode(0,0)[1]: got " + ke0[1] + " want 0")
        exit(1)

    // sharps=-1, major -> sf_byte=255 (0xFF two's complement), mi=0
    let kem1 = keysig_encode(-1, 0)
    if kem1[0] != 255
        print("FAIL keysig_encode(-1,0)[0]: got " + str(kem1[0]) + " want 255")
        exit(1)
    if kem1[1] != 0
        print("FAIL keysig_encode(-1,0)[1]: got " + str(kem1[1]) + " want 0")
        exit(1)

    // sharps=2, minor -> [2, 1]
    let ke2m = keysig_encode(2, 1)
    if ke2m[0] != 2
        print("FAIL keysig_encode(2,1)[0]: got " + str(ke2m[0]) + " want 2")
        exit(1)
    if ke2m[1] != 1
        print("FAIL keysig_encode(2,1)[1]: got " + str(ke2m[1]) + " want 1")
        exit(1)

    // sharps=-3, minor -> sf_byte=253 (256-3), mi=1
    let kem3m = keysig_encode(-3, 1)
    if kem3m[0] != 253
        print("FAIL keysig_encode(-3,1)[0]: got " + str(kem3m[0]) + " want 253")
        exit(1)
    if kem3m[1] != 1
        print("FAIL keysig_encode(-3,1)[1]: got " + str(kem3m[1]) + " want 1")
        exit(1)

    // sharps=7, major -> [7, 0] (C# major)
    let ke7 = keysig_encode(7, 0)
    if ke7[0] != 7
        print("FAIL keysig_encode(7,0)[0]: got " + str(ke7[0]) + " want 7")
        exit(1)
    if ke7[1] != 0
        print("FAIL keysig_encode(7,0)[1]: got " + str(ke7[1]) + " want 0")
        exit(1)

    print("PASS _timesig_test")
