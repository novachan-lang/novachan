// KAT for std/math/fixedpoint — all functions with scale=1000.
import std/math/fixedpoint

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckf(label: string, got: float, want: float)
    let d = got - want
    if d < 0.0
        d = 0.0 - d
    if d > 0.001
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // fp_from_float: 1.5 * 1000 = 1500 (round-half-up)
    cki("fp_from_float-1.5", fp_from_float(1.5, 1000), 1500)

    // fp_to_float: 1500 / 1000.0 = 1.5
    ckf("fp_to_float-1500", fp_to_float(1500.0, 1000.0), 1.5)

    // fp_add: 1500 + 500 = 2000
    cki("fp_add", fp_add(1500, 500), 2000)

    // fp_sub: 2000 - 500 = 1500
    cki("fp_sub", fp_sub(2000, 500), 1500)

    // fp_mul: (1500 * 2000) / 1000 = 3000000 / 1000 = 3000 (1.5 * 2.0 = 3.0)
    cki("fp_mul", fp_mul(1500, 2000, 1000), 3000)

    // fp_div: (3000 * 1000) / 2000 = 3000000 / 2000 = 1500 (3.0 / 2.0 = 1.5)
    cki("fp_div", fp_div(3000, 2000, 1000), 1500)

    // fp_str: 1500 with scale 1000 -> "1.500"
    cks("fp_str-1500", fp_str(1500, 1000), "1.500")

    // fp_str: 500 with scale 1000 -> "0.500"
    cks("fp_str-500", fp_str(500, 1000), "0.500")

    // fp_from_int: 2 * 1000 = 2000
    cki("fp_from_int-2", fp_from_int(2, 1000), 2000)

    // Additional coverage: negative value
    cks("fp_str-neg", fp_str(0 - 750, 1000), "-0.750")

    // fp_from_float with rounding: 1.2345 * 1000 = 1234.5 -> rounds to 1235
    cki("fp_from_float-round", fp_from_float(1.2345, 1000), 1235)

    // fp_from_float zero
    cki("fp_from_float-zero", fp_from_float(0.0, 1000), 0)

    // fp_str zero
    cks("fp_str-zero", fp_str(0, 1000), "0.000")

    // fp_mul with 0
    cki("fp_mul-zero", fp_mul(0, 2000, 1000), 0)

    print("_fixedpoint_test passed")
