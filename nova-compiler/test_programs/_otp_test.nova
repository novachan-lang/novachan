// _otp_test.nova -- KAT for std/crypto/otp
// Tests: xor_bytes, encrypt/decrypt round-trip, str conversions, hex encode/decode,
//        Hamming distance (Cryptopals vector), key_reuse_xor, verify_key_length.
import std/crypto/otp

// ── helpers ────────────────────────────────────────────────────────────────────

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL otp " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        print("FAIL otp " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL otp " + label + ": got=" + got + " want=" + want)
        exit(1)

// Compare two int-lists element by element. Returns 1 if equal.
fn lists_eq(a: any, b: any) -> int
    let la = len(a)
    let lb = len(b)
    if la != lb
        return 0
    let i = 0
    while i < la
        if a[i] != b[i]
            return 0
        i = i + 1
    return 1

fn ckl(label: string, got: any, want: any)
    let ok = lists_eq(got, want)
    if ok != 1
        print("FAIL otp " + label + ": lists differ")
        exit(1)

fn main()
    // KAT 1: otp_xor_bytes([1,2,3],[1,1,1]) == [0,3,2]
    let a1 = [1, 2, 3]
    let b1 = [1, 1, 1]
    let r1 = otp_xor_bytes(a1, b1)
    let want1 = [0, 3, 2]
    ckl("xor_bytes_basic", r1, want1)

    // KAT 2: round-trip encrypt->decrypt restores plaintext
    // msg = "attack at dawn", key = "yellow submarine" (16 chars >= 14 chars)
    let msg = otp_str_to_bytes("attack at dawn")
    let key = otp_str_to_bytes("yellow submarine")
    let enc = otp_encrypt(msg, key)
    let dec = otp_decrypt(enc, key)
    let recovered = otp_bytes_to_str(dec)
    cks("roundtrip_str", recovered, "attack at dawn")

    // KAT 3: otp_str_to_bytes / otp_bytes_to_str round-trip
    let test_str = "Hello, NOVA!"
    let bts = otp_str_to_bytes(test_str)
    let back = otp_bytes_to_str(bts)
    cks("str_bytes_roundtrip", back, "Hello, NOVA!")

    // KAT 4: otp_str_encrypt / otp_str_decrypt round-trip
    let plain = "secret message"
    let kstr = "random key here"
    let enc2 = otp_str_encrypt(plain, kstr)
    let dec2 = otp_str_decrypt(enc2, kstr)
    cks("str_encrypt_decrypt", dec2, "secret message")

    // KAT 5: FAMOUS VECTOR -- Cryptopals set1 challenge 6 Hamming distance
    // hamming_distance("this is a test", "wokka wokka!!!") == 37
    let ha = otp_str_to_bytes("this is a test")
    let hb = otp_str_to_bytes("wokka wokka!!!")
    cki("hamming_cryptopals", otp_hamming_distance(ha, hb), 37)

    // KAT 6: otp_hex_encode([255,16,0]) == "ff1000"
    let hex_in = [255, 16, 0]
    cks("hex_encode_ff1000", otp_hex_encode(hex_in), "ff1000")

    // KAT 7: otp_hex_decode("ff1000") == [255,16,0]
    let hex_dec = otp_hex_decode("ff1000")
    ckl("hex_decode_ff1000", hex_dec, [255, 16, 0])

    // KAT 8: hex round-trip -- encode then decode recovers original
    let orig = [0, 1, 127, 128, 200, 255]
    let enc_hex = otp_hex_encode(orig)
    let dec_hex = otp_hex_decode(enc_hex)
    ckl("hex_roundtrip", dec_hex, orig)

    // KAT 9: otp_key_reuse_xor -- xor(c1,c2) == xor(p1,p2) when c1=xor(p1,k), c2=xor(p2,k)
    // Build p1, p2, k (all same length)
    let p1 = [72, 101, 108, 108, 111]
    let p2 = [87, 111, 114, 108, 100]
    let k  = [42, 99, 17, 200, 33]
    let c1 = otp_xor_bytes(p1, k)
    let c2 = otp_xor_bytes(p2, k)
    let xor_c = otp_key_reuse_xor(c1, c2)
    let xor_p = otp_xor_bytes(p1, p2)
    ckl("key_reuse_xor", xor_c, xor_p)

    // KAT 10: otp_verify_key_length
    ckb("verify_key_ok", otp_verify_key_length(5, 10), true)
    ckb("verify_key_exact", otp_verify_key_length(8, 8), true)
    ckb("verify_key_short", otp_verify_key_length(10, 5), false)

    // KAT 11: hamming distance of identical inputs is 0
    let same = [1, 2, 3, 255, 0]
    cki("hamming_zero", otp_hamming_distance(same, same), 0)

    // KAT 12: single-byte hamming: 0x00 vs 0xFF = 8 bits
    let zeros = [0]
    let ones  = [255]
    cki("hamming_byte_8bits", otp_hamming_distance(zeros, ones), 8)

    // KAT 13: hex_encode empty list returns ""
    let empty_in = []
    cks("hex_encode_empty", otp_hex_encode(empty_in), "")

    // KAT 14: xor_bytes identity (xor with zeros)
    let data_vals = [10, 20, 30]
    let zero_key  = [0, 0, 0]
    let id_result = otp_xor_bytes(data_vals, zero_key)
    ckl("xor_identity", id_result, data_vals)

    print("PASS _otp_test")
