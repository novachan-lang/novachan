import std/lambda/lambda_beta

// cki: check int equality
fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// ckb: check bool (int) equality
fn ckb(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// term_eq: recursive structural equality of two terms (tagged lists).
fn term_eq(a, b) -> int
    if len(a) != len(b)
        return 0
    let ta = a[0]
    let tb = b[0]
    if ta != tb
        return 0
    if ta == "var"
        if int(a[1]) != int(b[1])
            return 0
        return 1
    if ta == "lam"
        return term_eq(a[1], b[1])
    // "app"
    if term_eq(a[1], b[1]) == 0
        return 0
    return term_eq(a[2], b[2])

// ckt: check term equality
fn ckt(label, a, b)
    if term_eq(a, b) == 0
        print("FAIL " + label + ": terms differ")
        exit(1)

fn main()
    // ── KAT 1: identity applied: (λx.x) y  =  y
    // term: ["app", ["lam", ["var",0]], ["var",3]]
    // expected result: ["var",3]
    let id_lam = lambda_beta.lbt_mk_lam(lambda_beta.lbt_mk_var(0))
    let var3 = lambda_beta.lbt_mk_var(3)
    let id_app = lambda_beta.lbt_mk_app(id_lam, var3)
    let r1 = lambda_beta.lbt_normalize(id_app, 100)
    ckt("identity_app", r1, lambda_beta.lbt_mk_var(3))

    // ── KAT 2: K-like: (λx.λy.x) y  normalizes to  λy.y[1]
    // term: ["app", ["lam",["lam",["var",1]]], ["var",0]]
    // After beta: shift(-1,0, subst(0, shift(1,0,["var",0]), ["lam",["var",1]]))
    //   shift(1,0,["var",0]) = ["var",1]
    //   subst(0, ["var",1], ["lam",["var",1]]) = ["lam", subst(1, shift(1,0,["var",1]), ["var",1])]
    //     shift(1,0,["var",1]) = ["var",2]; subst(1,["var",2],["var",1]) = ["var",2]
    //   => ["lam",["var",2]]
    //   shift(-1,0,["lam",["var",2]]) = ["lam", shift(-1,1,["var",2])] = ["lam",["var",1]]
    // Expected: ["lam",["var",1]]
    let inner_lam = lambda_beta.lbt_mk_lam(lambda_beta.lbt_mk_var(1))
    let k_lam = lambda_beta.lbt_mk_lam(inner_lam)
    let var0 = lambda_beta.lbt_mk_var(0)
    let k_app = lambda_beta.lbt_mk_app(k_lam, var0)
    let r2 = lambda_beta.lbt_normalize(k_app, 100)
    let expected2 = lambda_beta.lbt_mk_lam(lambda_beta.lbt_mk_var(1))
    ckt("K_like", r2, expected2)

    // ── KAT 3: lbt_is_normal_form on identity lambda (no redex)
    let id2 = lambda_beta.lbt_mk_lam(lambda_beta.lbt_mk_var(0))
    ckb("is_nf_identity", lambda_beta.lbt_is_normal_form(id2), 1)

    // ── KAT 4: lbt_is_normal_form on redex = false
    let id3 = lambda_beta.lbt_mk_lam(lambda_beta.lbt_mk_var(0))
    let v0 = lambda_beta.lbt_mk_var(0)
    let redex = lambda_beta.lbt_mk_app(id3, v0)
    ckb("is_nf_redex_false", lambda_beta.lbt_is_normal_form(redex), 0)

    // ── KAT 5: lbt_is_redex on redex = true
    let id4 = lambda_beta.lbt_mk_lam(lambda_beta.lbt_mk_var(0))
    let v0b = lambda_beta.lbt_mk_var(0)
    let redex2 = lambda_beta.lbt_mk_app(id4, v0b)
    ckb("is_redex_true", lambda_beta.lbt_is_redex(redex2), 1)

    // ── KAT 6: lbt_step on non-redex variable returns unchanged
    let vterm = lambda_beta.lbt_mk_var(5)
    let sr = lambda_beta.lbt_step(vterm)
    ckb("step_var_unchanged", int(sr[0]), 0)

    print("PASS _lambda_beta_test")
