// LOCK-10 / L5 — const generics: INTEGER-valued type parameters.
// The point is that a size mismatch becomes a COMPILE error, not a runtime crash.
type Vec<T>
    v_items: list

fn take3(v: Vec<3>) -> int
    return 3

fn take4(v: Vec<4>) -> int
    return 4

fn main()
    let a: Vec<3> = Vec([1, 2, 3])
    let b: Vec<4> = Vec([1, 2, 3, 4])
    print("take3(a) = " + str(take3(a)))
    print("take4(b) = " + str(take4(b)))
    print("PASS const-generic accept")
