import forge_spatial_hash

fn main()
    let s = sh_new(10)
    s = sh_insert(s, "player", 5, 5)
    s = sh_insert(s, "enemy1", 7, 8)
    s = sh_insert(s, "enemy2", 25, 30)
    assert(sh_count(s) == 3, "3 objects")

    assert(sh_query_cell(s, 5, 5) == 2, "2 in cell 0:0")
    assert(sh_query_cell(s, 25, 30) == 1, "1 in cell 2:3")
    assert(sh_query_cell(s, 50, 50) == 0, "0 in empty cell")

    assert(sh_nearby(s, 5, 5, 5) == 2, "2 nearby r=5")
    assert(sh_nearby(s, 5, 5, 30) == 3, "3 nearby r=30")
    assert(sh_nearby(s, 100, 100, 5) == 0, "0 nearby far")

    assert(sh_obj_name(s, 0) == "player", "obj 0 player")

    print("SPATIAL-HASH KAT PASS")
