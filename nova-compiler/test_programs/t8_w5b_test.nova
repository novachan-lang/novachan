fn build_and_drop_dict(iters: int) -> int
    let total = 0
    let i = 0
    while i < iters
        let d = {}
        let j = 0
        while j < 50
            d["k_" + str(j)] = j
            j = j + 1
        total = total + len(d)
        dict_free_local(d)
        i = i + 1
    total

fn main()
    let n = build_and_drop_dict(20)
    print(n)
    print("W5b dict_free_local: 20x build-and-drop dict cycles completed")
