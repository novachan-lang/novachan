// KAT for prism/ui/prism_ui_copy.nova (copy-to-clipboard / copyable text components).
//
// Covers all 5 constructors structurally (kind + attrs + child count, not just "it returned ok"):
//   1. prism_cp_copyable  -- band[label, press[label]]
//   2. prism_cp_code      -- band[label, press[label]], accessible name "Copy code"
//   3. prism_cp_feedback  -- band[label, press[label]], button label flips Copy/Copied! on `copied`
//   4. prism_cp_share     -- band[label, press[label], press[label]] (copy + share)
//   5. prism_cp_labeled   -- stack[label, band[label, press[label]]]
// plus every empty-input error path.

import prism_node
import prism_ui_copy

let FAILED = [0]

fn _check(label: string, got: string, want: string)
    if got == want
        print("  pass  " + label)
    else
        print("  FAIL  " + label + "  got=" + got + "  want=" + want)
        FAILED[0] = FAILED[0] + 1

fn _check_true(label: string, cond: bool)
    if cond
        print("  pass  " + label)
    else
        print("  FAIL  " + label)
        FAILED[0] = FAILED[0] + 1

fn main()
    print("== 1. prism_cp_copyable(\"hello world\") ==")
    let r1 = prism_ui_copy.prism_cp_copyable("hello world")
    _check_true("copyable: returns ok", is_ok(r1))
    let n1 = unwrap(r1)
    _check("copyable: root kind is band", prism_node.prism_node_kind_str(n1), "band")
    let k1 = prism_node.prism_node_children(n1)
    _check("copyable: root has 2 children", str(len(k1)), "2")
    _check("copyable: child0 kind is label", prism_node.prism_node_kind_str(k1[0]), "label")
    _check("copyable: child0 text is the copyable text", prism_node.prism_node_attr_str(k1[0], "text", ""), "hello world")
    _check("copyable: child1 kind is press", prism_node.prism_node_kind_str(k1[1]), "press")
    _check("copyable: child1 accessible name", prism_node.prism_node_attr_str(k1[1], "text", ""), "Copy to clipboard")
    let btn1 = prism_node.prism_node_children(k1[1])
    _check("copyable: button has 1 child", str(len(btn1)), "1")
    _check("copyable: button child is a label", prism_node.prism_node_kind_str(btn1[0]), "label")
    _check("copyable: button label text is Copy", prism_node.prism_node_attr_str(btn1[0], "text", ""), "Copy")

    print("== 2. prism_cp_copyable(\"\") -- error path ==")
    let r1e = prism_ui_copy.prism_cp_copyable("")
    _check_true("copyable empty: returns err", is_err(r1e))
    _check("copyable empty: error message", unwrap_err(r1e), "prism_cp_copyable: text must not be empty")

    print("== 3. prism_cp_code(\"let x = 1\") ==")
    let r2 = prism_ui_copy.prism_cp_code("let x = 1")
    _check_true("code: returns ok", is_ok(r2))
    let n2 = unwrap(r2)
    _check("code: root kind is band", prism_node.prism_node_kind_str(n2), "band")
    let k2 = prism_node.prism_node_children(n2)
    _check("code: root has 2 children", str(len(k2)), "2")
    _check("code: child0 kind is label", prism_node.prism_node_kind_str(k2[0]), "label")
    _check("code: child0 text is the code snippet", prism_node.prism_node_attr_str(k2[0], "text", ""), "let x = 1")
    _check("code: child1 kind is press", prism_node.prism_node_kind_str(k2[1]), "press")
    _check("code: child1 accessible name is 'Copy code'", prism_node.prism_node_attr_str(k2[1], "text", ""), "Copy code")
    let btn2 = prism_node.prism_node_children(k2[1])
    _check("code: button has 1 child", str(len(btn2)), "1")
    _check("code: button label text is Copy", prism_node.prism_node_attr_str(btn2[0], "text", ""), "Copy")

    print("== 4. prism_cp_code(\"\") -- error path ==")
    let r2e = prism_ui_copy.prism_cp_code("")
    _check_true("code empty: returns err", is_err(r2e))
    _check("code empty: error message", unwrap_err(r2e), "prism_cp_code: code must not be empty")

    print("== 5. prism_cp_feedback(\"secret-token\", false) -- not yet copied ==")
    let r3a = prism_ui_copy.prism_cp_feedback("secret-token", false)
    _check_true("feedback(false): returns ok", is_ok(r3a))
    let n3a = unwrap(r3a)
    _check("feedback(false): root kind is band", prism_node.prism_node_kind_str(n3a), "band")
    let k3a = prism_node.prism_node_children(n3a)
    _check("feedback(false): root has 2 children", str(len(k3a)), "2")
    _check("feedback(false): child0 text is the value", prism_node.prism_node_attr_str(k3a[0], "text", ""), "secret-token")
    _check("feedback(false): child1 kind is press", prism_node.prism_node_kind_str(k3a[1]), "press")
    _check("feedback(false): child1 accessible name", prism_node.prism_node_attr_str(k3a[1], "text", ""), "Copy to clipboard")
    let btn3a = prism_node.prism_node_children(k3a[1])
    _check("feedback(false): button has 1 child", str(len(btn3a)), "1")
    _check("feedback(false): button label is 'Copy'", prism_node.prism_node_attr_str(btn3a[0], "text", ""), "Copy")

    print("== 6. prism_cp_feedback(\"secret-token\", true) -- just copied ==")
    let r3b = prism_ui_copy.prism_cp_feedback("secret-token", true)
    _check_true("feedback(true): returns ok", is_ok(r3b))
    let n3b = unwrap(r3b)
    _check("feedback(true): root kind is band", prism_node.prism_node_kind_str(n3b), "band")
    let k3b = prism_node.prism_node_children(n3b)
    _check("feedback(true): root has 2 children", str(len(k3b)), "2")
    _check("feedback(true): child0 text is unchanged", prism_node.prism_node_attr_str(k3b[0], "text", ""), "secret-token")
    _check("feedback(true): child1 accessible name is unchanged", prism_node.prism_node_attr_str(k3b[1], "text", ""), "Copy to clipboard")
    let btn3b = prism_node.prism_node_children(k3b[1])
    _check("feedback(true): button has 1 child", str(len(btn3b)), "1")
    _check("feedback(true): button label is 'Copied!'", prism_node.prism_node_attr_str(btn3b[0], "text", ""), "Copied!")

    print("== 7. prism_cp_feedback(\"\", false) -- error path ==")
    let r3e = prism_ui_copy.prism_cp_feedback("", false)
    _check_true("feedback empty: returns err", is_err(r3e))
    _check("feedback empty: error message", unwrap_err(r3e), "prism_cp_feedback: text must not be empty")

    print("== 8. prism_cp_share(\"https://example.com/x\") ==")
    let r4 = prism_ui_copy.prism_cp_share("https://example.com/x")
    _check_true("share: returns ok", is_ok(r4))
    let n4 = unwrap(r4)
    _check("share: root kind is band", prism_node.prism_node_kind_str(n4), "band")
    let k4 = prism_node.prism_node_children(n4)
    _check("share: root has 3 children", str(len(k4)), "3")
    _check("share: child0 kind is label", prism_node.prism_node_kind_str(k4[0]), "label")
    _check("share: child0 text is the url", prism_node.prism_node_attr_str(k4[0], "text", ""), "https://example.com/x")
    _check("share: child1 kind is press", prism_node.prism_node_kind_str(k4[1]), "press")
    _check("share: child1 accessible name is 'Copy link'", prism_node.prism_node_attr_str(k4[1], "text", ""), "Copy link")
    let btn4a = prism_node.prism_node_children(k4[1])
    _check("share: copy button has 1 child", str(len(btn4a)), "1")
    _check("share: copy button label is 'Copy'", prism_node.prism_node_attr_str(btn4a[0], "text", ""), "Copy")
    _check("share: child2 kind is press", prism_node.prism_node_kind_str(k4[2]), "press")
    _check("share: child2 accessible name is 'Share link'", prism_node.prism_node_attr_str(k4[2], "text", ""), "Share link")
    let btn4b = prism_node.prism_node_children(k4[2])
    _check("share: share button has 1 child", str(len(btn4b)), "1")
    _check("share: share button label is 'Share'", prism_node.prism_node_attr_str(btn4b[0], "text", ""), "Share")

    print("== 9. prism_cp_share(\"\") -- error path ==")
    let r4e = prism_ui_copy.prism_cp_share("")
    _check_true("share empty: returns err", is_err(r4e))
    _check("share empty: error message", unwrap_err(r4e), "prism_cp_share: url must not be empty")

    print("== 10. prism_cp_labeled(\"Email\", \"user@example.com\") ==")
    let r5 = prism_ui_copy.prism_cp_labeled("Email", "user@example.com")
    _check_true("labeled: returns ok", is_ok(r5))
    let n5 = unwrap(r5)
    _check("labeled: root kind is stack", prism_node.prism_node_kind_str(n5), "stack")
    let k5 = prism_node.prism_node_children(n5)
    _check("labeled: root has 2 children", str(len(k5)), "2")
    _check("labeled: child0 kind is label", prism_node.prism_node_kind_str(k5[0]), "label")
    _check("labeled: child0 text is the label", prism_node.prism_node_attr_str(k5[0], "text", ""), "Email")
    _check("labeled: child1 kind is band", prism_node.prism_node_kind_str(k5[1]), "band")
    let row5 = prism_node.prism_node_children(k5[1])
    _check("labeled: row has 2 children", str(len(row5)), "2")
    _check("labeled: row child0 kind is label", prism_node.prism_node_kind_str(row5[0]), "label")
    _check("labeled: row child0 text is the value", prism_node.prism_node_attr_str(row5[0], "text", ""), "user@example.com")
    _check("labeled: row child1 kind is press", prism_node.prism_node_kind_str(row5[1]), "press")
    _check("labeled: row child1 accessible name includes the label", prism_node.prism_node_attr_str(row5[1], "text", ""), "Copy Email")
    let btn5 = prism_node.prism_node_children(row5[1])
    _check("labeled: button has 1 child", str(len(btn5)), "1")
    _check("labeled: button label is 'Copy'", prism_node.prism_node_attr_str(btn5[0], "text", ""), "Copy")

    print("== 11. prism_cp_labeled(\"\", \"user@example.com\") -- empty label error ==")
    let r5e1 = prism_ui_copy.prism_cp_labeled("", "user@example.com")
    _check_true("labeled empty-label: returns err", is_err(r5e1))
    _check("labeled empty-label: error message", unwrap_err(r5e1), "prism_cp_labeled: label must not be empty")

    print("== 12. prism_cp_labeled(\"Email\", \"\") -- empty value error ==")
    let r5e2 = prism_ui_copy.prism_cp_labeled("Email", "")
    _check_true("labeled empty-value: returns err", is_err(r5e2))
    _check("labeled empty-value: error message", unwrap_err(r5e2), "prism_cp_labeled: value must not be empty")

    if FAILED[0] == 0
        print("")
        print("_kat_prism_ui_copy: ALL PASS")
    else
        print("")
        print("_kat_prism_ui_copy: " + str(FAILED[0]) + " FAILURE(S)")
        exit(1)
