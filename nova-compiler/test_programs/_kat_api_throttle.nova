import forge_api_throttle

fn main()
    let a = at_new(3, 60)
    let r1 = at_request(a, "client1", 100)
    assert(is_ok(r1), "req 1 ok")
    a = unwrap(r1)
    let r2 = at_request(a, "client1", 110)
    assert(is_ok(r2), "req 2 ok")
    a = unwrap(r2)
    let r3 = at_request(a, "client1", 120)
    assert(is_ok(r3), "req 3 ok")
    a = unwrap(r3)

    let r4 = at_request(a, "client1", 130)
    assert(is_err(r4), "rate limited")
    assert(at_total_allowed(a) == 3, "3 allowed")
    assert(at_total_denied(a) == 1, "1 denied")

    assert(at_remaining(a, "client1") == 0, "0 remaining")
    assert(at_remaining(a, "client2") == 3, "new client full quota")

    let r5 = at_request(a, "client1", 200)
    assert(is_ok(r5), "new window ok")
    a = unwrap(r5)

    print("API-THROTTLE KAT PASS")
