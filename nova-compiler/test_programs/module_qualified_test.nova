import mathlib
import mathlib as m

// Direct module-qualified calls
let r1 = mathlib.add(10, 20)
print(r1)

let r2 = mathlib.multiply(3, 7)
print(r2)

let r3 = mathlib.square(5)
print(r3)

// Alias-qualified calls
let r4 = m.add(100, 200)
print(r4)

let r5 = m.multiply(11, 11)
print(r5)

// Nested: module-qualified calls as arguments
let r6 = mathlib.add(mathlib.multiply(2, 3), m.square(4))
print(r6)

// Bare (unqualified) calls still work
let r7 = add(1, 2)
print(r7)

let r8 = multiply(4, 5)
print(r8)

// Mixed qualified and unqualified
let r9 = mathlib.add(square(3), m.multiply(2, 5))
print(r9)
