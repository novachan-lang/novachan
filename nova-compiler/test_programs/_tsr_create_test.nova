import std/tensor/tsr_create

// cki — check int equality.
fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb — check bool equality.
fn ckb(label, got, want)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

// ckl — check two int lists element-by-element.
fn ckl(label, got, want)
    let ok = true
    if len(got) != len(want)
        ok = false
    if ok
        let i = 0
        while i < len(want)
            if got[i] != want[i]
                ok = false
            i = i + 1
    if not ok
        print("FAIL " + label + ": list mismatch")
        exit(1)

// ckt — check tensor: flat list and shape list.
fn ckt(label, t, want_flat, want_shape)
    let flat = t[0]
    let shape = t[1]
    let ok = true
    if len(flat) != len(want_flat)
        ok = false
    if ok
        let i = 0
        while i < len(want_flat)
            if flat[i] != want_flat[i]
                ok = false
            i = i + 1
    if ok
        if len(shape) != len(want_shape)
            ok = false
    if ok
        let i = 0
        while i < len(want_shape)
            if shape[i] != want_shape[i]
                ok = false
            i = i + 1
    if not ok
        print("FAIL " + label + ": tensor mismatch")
        exit(1)

fn main()
    // tc_zeros([2,3]) -> flat=[0,0,0,0,0,0] shape=[2,3]
    let sh1 = []
    push(sh1, 2)
    push(sh1, 3)
    let z1 = tc_zeros(sh1)
    let wf1 = []
    push(wf1, 0)
    push(wf1, 0)
    push(wf1, 0)
    push(wf1, 0)
    push(wf1, 0)
    push(wf1, 0)
    let ws1 = []
    push(ws1, 2)
    push(ws1, 3)
    ckt("zeros_2x3", z1, wf1, ws1)

    // tc_full([2,2],7) -> flat=[7,7,7,7] shape=[2,2]
    let sh2 = []
    push(sh2, 2)
    push(sh2, 2)
    let f2 = tc_full(sh2, 7)
    let wf2 = []
    push(wf2, 7)
    push(wf2, 7)
    push(wf2, 7)
    push(wf2, 7)
    let ws2 = []
    push(ws2, 2)
    push(ws2, 2)
    ckt("full_2x2_7", f2, wf2, ws2)

    // tc_arange(4) -> flat=[0,1,2,3] shape=[4]
    let a3 = tc_arange(4)
    let wf3 = []
    push(wf3, 0)
    push(wf3, 1)
    push(wf3, 2)
    push(wf3, 3)
    let ws3 = []
    push(ws3, 4)
    ckt("arange_4", a3, wf3, ws3)

    // tc_eye(2) -> flat=[1,0,0,1] shape=[2,2]
    let e4 = tc_eye(2)
    let wf4 = []
    push(wf4, 1)
    push(wf4, 0)
    push(wf4, 0)
    push(wf4, 1)
    let ws4 = []
    push(ws4, 2)
    push(ws4, 2)
    ckt("eye_2", e4, wf4, ws4)

    // tc_from_nested([[1,2],[3,4]]) -> flat=[1,2,3,4] shape=[2,2]
    let row1 = []
    push(row1, 1)
    push(row1, 2)
    let row2 = []
    push(row2, 3)
    push(row2, 4)
    let nested5 = []
    push(nested5, row1)
    push(nested5, row2)
    let fn5 = tc_from_nested(nested5)
    let wf5 = []
    push(wf5, 1)
    push(wf5, 2)
    push(wf5, 3)
    push(wf5, 4)
    let ws5 = []
    push(ws5, 2)
    push(ws5, 2)
    ckt("from_nested_2x2", fn5, wf5, ws5)

    // tc_to_nested round-trip: tc_to_nested(tc_from_nested([[1,2],[3,4]])) == [[1,2],[3,4]]
    let row6a = []
    push(row6a, 1)
    push(row6a, 2)
    let row6b = []
    push(row6b, 3)
    push(row6b, 4)
    let nested6 = []
    push(nested6, row6a)
    push(nested6, row6b)
    let t6 = tc_from_nested(nested6)
    let back6 = tc_to_nested(t6)
    // back6 should be [[1,2],[3,4]]; check element by element
    let r6_0 = back6[0]
    let r6_1 = back6[1]
    cki("to_nested_rt_0_0", r6_0[0], 1)
    cki("to_nested_rt_0_1", r6_0[1], 2)
    cki("to_nested_rt_1_0", r6_1[0], 3)
    cki("to_nested_rt_1_1", r6_1[1], 4)

    // tc_size(tc_zeros([2,3])) == 6
    let sh7 = []
    push(sh7, 2)
    push(sh7, 3)
    let z7 = tc_zeros(sh7)
    cki("size_2x3", tc_size(z7), 6)

    // tc_ndim(tc_zeros([2,3])) == 2
    let sh8 = []
    push(sh8, 2)
    push(sh8, 3)
    let z8 = tc_zeros(sh8)
    cki("ndim_2x3", tc_ndim(z8), 2)

    // tc_shape returns the shape list
    let sh9 = []
    push(sh9, 2)
    push(sh9, 3)
    let z9 = tc_zeros(sh9)
    let s9 = tc_shape(z9)
    cki("shape_0", s9[0], 2)
    cki("shape_1", s9[1], 3)

    // scalar: tc_zeros([]) -> flat=[0] shape=[]
    let sh10 = []
    let z10 = tc_zeros(sh10)
    cki("scalar_size", tc_size(z10), 1)
    cki("scalar_ndim", tc_ndim(z10), 0)

    // tc_eye(3) -> 3x3 identity: check corner and center
    let e11 = tc_eye(3)
    let ef11 = e11[0]
    // flat: [1,0,0, 0,1,0, 0,0,1]
    cki("eye3_00", ef11[0], 1)
    cki("eye3_01", ef11[1], 0)
    cki("eye3_11", ef11[4], 1)
    cki("eye3_22", ef11[8], 1)
    cki("eye3_02", ef11[2], 0)

    // tc_arange(0) -> flat=[] shape=[0]
    let a12 = tc_arange(0)
    let af12 = a12[0]
    let as12 = a12[1]
    cki("arange0_flatlen", len(af12), 0)
    cki("arange0_shape", as12[0], 0)

    print("PASS _tsr_create_test")
