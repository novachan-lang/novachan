// KAT for std/image/img_crop — grayscale image crop and padding.
import std/image/img_crop

// Helper: check two lists are equal
fn chk_list(label: str, got: list, want: list)
    let gn = len(got)
    let wn = len(want)
    if gn != wn
        print("FAIL " + label + " length: got " + str(gn) + " want " + str(wn))
        exit(1)
    let i = 0
    while i < wn
        let gv = got[i]
        let wv = want[i]
        if gv != wv
            print("FAIL " + label + "[" + str(i) + "]: got " + str(gv) + " want " + str(wv))
            exit(1)
        i = i + 1

fn main()
    // Build 3x3 image: [1,2,3,4,5,6,7,8,9]
    let px3x3 = []
    px3x3.push(1)
    px3x3.push(2)
    px3x3.push(3)
    px3x3.push(4)
    px3x3.push(5)
    px3x3.push(6)
    px3x3.push(7)
    px3x3.push(8)
    px3x3.push(9)

    // KAT 1: bottom-right 2x2 = img_crop(px, 3, 3, 1, 1, 2, 2) == [5,6,8,9]
    // row=1,col=1: idx=1*3+1=4 => 5; col=2: idx=1*3+2=5 => 6
    // row=2,col=1: idx=2*3+1=7 => 8; col=2: idx=2*3+2=8 => 9
    let crop1 = img_crop(px3x3, 3, 3, 1, 1, 2, 2)
    let want1 = []
    want1.push(5)
    want1.push(6)
    want1.push(8)
    want1.push(9)
    chk_list("crop_bottom_right_2x2", crop1, want1)

    // KAT 2: crop of the full image returns the full image
    let crop2 = img_crop(px3x3, 3, 3, 0, 0, 3, 3)
    chk_list("crop_full_image", crop2, px3x3)

    // KAT 3: top-left 1x1 == [1]
    let crop3 = img_crop(px3x3, 3, 3, 0, 0, 1, 1)
    let want3 = []
    want3.push(1)
    chk_list("crop_topleft_1x1", crop3, want3)

    // KAT 4: top row (y=0, x=0, cw=3, ch=1) == [1,2,3]
    let crop4 = img_crop(px3x3, 3, 3, 0, 0, 3, 1)
    let want4 = []
    want4.push(1)
    want4.push(2)
    want4.push(3)
    chk_list("crop_top_row", crop4, want4)

    // KAT 5: img_pad of a 1x1 image [42] with pad=1, value=0 gives 3x3
    // Result should be 9 pixels: 0,0,0,0,42,0,0,0,0
    let px1x1 = []
    px1x1.push(42)
    let pad1 = img_pad(px1x1, 1, 1, 1, 0)
    let want5 = []
    want5.push(0)
    want5.push(0)
    want5.push(0)
    want5.push(0)
    want5.push(42)
    want5.push(0)
    want5.push(0)
    want5.push(0)
    want5.push(0)
    chk_list("pad_1x1_pad1_val0", pad1, want5)

    // KAT 6: img_pad of a 1x1 image [0] with pad=1, value=255 gives 3x3 all-255 border
    let px1x1b = []
    px1x1b.push(0)
    let pad2 = img_pad(px1x1b, 1, 1, 1, 255)
    let want6 = []
    want6.push(255)
    want6.push(255)
    want6.push(255)
    want6.push(255)
    want6.push(0)
    want6.push(255)
    want6.push(255)
    want6.push(255)
    want6.push(255)
    chk_list("pad_1x1_val255", pad2, want6)

    // KAT 7: img_pad with pad=0 returns identical content
    let pad3 = img_pad(px3x3, 3, 3, 0, 0)
    chk_list("pad_zero_identical", pad3, px3x3)

    // KAT 8: img_pad 2x2 image [10,20,30,40] with pad=1, value=0
    // Result 4x4:
    //  0  0  0  0
    //  0 10 20  0
    //  0 30 40  0
    //  0  0  0  0
    let px2x2 = []
    px2x2.push(10)
    px2x2.push(20)
    px2x2.push(30)
    px2x2.push(40)
    let pad4 = img_pad(px2x2, 2, 2, 1, 0)
    let want8 = []
    want8.push(0)
    want8.push(0)
    want8.push(0)
    want8.push(0)
    want8.push(0)
    want8.push(10)
    want8.push(20)
    want8.push(0)
    want8.push(0)
    want8.push(30)
    want8.push(40)
    want8.push(0)
    want8.push(0)
    want8.push(0)
    want8.push(0)
    want8.push(0)
    chk_list("pad_2x2_border", pad4, want8)

    print("PASS _img_crop_test")
