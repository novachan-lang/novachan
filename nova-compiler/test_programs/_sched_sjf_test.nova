import std/scheduling/sched_sjf

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL sched_sjf " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(label: string, got: list, want: list)
    let ng = len(got)
    let nw = len(want)
    if ng != nw
        print("FAIL sched_sjf " + label + ": len got=" + str(ng) + " want=" + str(nw))
        exit(1)
    let i = 0
    while i < nw
        if got[i] != want[i]
            print("FAIL sched_sjf " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // KAT 1: 4 processes all arrive at 0, bursts 6,8,7,3
    // Order: P3(3) -> P0(6) -> P2(7) -> P1(8)
    // completion: P0=9,P1=24,P2=16,P3=3
    let p1 = []
    let p1a = []
    push(p1a, 0)
    push(p1a, 6)
    push(p1, p1a)
    let p1b = []
    push(p1b, 0)
    push(p1b, 8)
    push(p1, p1b)
    let p1c = []
    push(p1c, 0)
    push(p1c, 7)
    push(p1, p1c)
    let p1d = []
    push(p1d, 0)
    push(p1d, 3)
    push(p1, p1d)

    let wc = []
    push(wc, 9)
    push(wc, 24)
    push(wc, 16)
    push(wc, 3)
    ckl("completion_basic", sj_completion_times(p1), wc)

    let ww = []
    push(ww, 3)
    push(ww, 16)
    push(ww, 9)
    push(ww, 0)
    ckl("waiting_basic", sj_waiting_times(p1), ww)

    let wo = []
    push(wo, 3)
    push(wo, 0)
    push(wo, 2)
    push(wo, 1)
    ckl("order_basic", sj_order(p1), wo)

    // KAT 2: single process
    let p2 = []
    let p2a = []
    push(p2a, 0)
    push(p2a, 5)
    push(p2, p2a)
    let wc2 = []
    push(wc2, 5)
    ckl("completion_single", sj_completion_times(p2), wc2)
    let ww2 = []
    push(ww2, 0)
    ckl("waiting_single", sj_waiting_times(p2), ww2)

    // KAT 3: empty
    let p3 = []
    ckl("completion_empty", sj_completion_times(p3), p3)
    ckl("order_empty", sj_order(p3), p3)

    // KAT 4: with idle gap — P0 arrives at 0 burst 3, P1 arrives at 10 burst 2
    // P0 runs 0..3, idle 3..10, P1 runs 10..12
    let p4 = []
    let p4a = []
    push(p4a, 0)
    push(p4a, 3)
    push(p4, p4a)
    let p4b = []
    push(p4b, 10)
    push(p4b, 2)
    push(p4, p4b)
    let wc4 = []
    push(wc4, 3)
    push(wc4, 12)
    ckl("completion_idle", sj_completion_times(p4), wc4)
    let ww4 = []
    push(ww4, 0)
    push(ww4, 0)
    ckl("waiting_idle", sj_waiting_times(p4), ww4)

    // KAT 5: tie-breaking by PID — two processes with same burst arrive simultaneously
    // P0 burst=4, P1 burst=4 both arrive at 0 => P0 runs first (lower PID)
    let p5 = []
    let p5a = []
    push(p5a, 0)
    push(p5a, 4)
    push(p5, p5a)
    let p5b = []
    push(p5b, 0)
    push(p5b, 4)
    push(p5, p5b)
    let wc5 = []
    push(wc5, 4)
    push(wc5, 8)
    ckl("completion_tie", sj_completion_times(p5), wc5)
    let wo5 = []
    push(wo5, 0)
    push(wo5, 1)
    ckl("order_tie", sj_order(p5), wo5)

    print("PASS _sched_sjf_test")
