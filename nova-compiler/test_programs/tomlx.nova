// tomlx.nova — TOML parser (subset: key=value, sections, strings, ints, floats, bools, arrays)
// Returns a dict<string, any> where section keys are "section.key".

fn _toml_skip_ws(s: string, i: int) -> int
    while i < len(s) and (s[i:i + 1] == " " or s[i:i + 1] == "\t")
        i = i + 1
    return i

fn _toml_is_digit(c: string) -> int
    let o = ord(c)
    return o >= 48 and o <= 57

fn _toml_parse_string(s: string, i: int) -> list
    let q = s[i:i + 1]
    if q != chr(34) and q != "'"
        return [i, ""]
    let cur = i + 1
    let result = ""
    while cur < len(s) and s[cur:cur + 1] != q
        if s[cur:cur + 1] == "\\" and q == chr(34)
            cur = cur + 1
            if cur < len(s)
                let esc = s[cur:cur + 1]
                if esc == "n"
                    result = result + "\n"
                else if esc == "t"
                    result = result + "\t"
                else if esc == "\\"
                    result = result + "\\"
                else if esc == chr(34)
                    result = result + chr(34)
                else
                    result = result + esc
        else
            result = result + s[cur:cur + 1]
        cur = cur + 1
    if cur < len(s)
        cur = cur + 1
    return [cur, result]

fn _toml_parse_value(s: string, i: int) -> list
    let c = s[i:i + 1]
    if c == chr(34) or c == "'"
        return _toml_parse_string(s, i)
    if s[i:i + 4] == "true"
        return [i + 4, 1]
    if s[i:i + 5] == "false"
        return [i + 5, 0]
    if c == "["
        let arr = []
        let cur = i + 1
        while cur < len(s) and s[cur:cur + 1] != "]"
            cur = _toml_skip_ws(s, cur)
            if s[cur:cur + 1] == "]"
                break
            if s[cur:cur + 1] == ","
                cur = cur + 1
                continue
            let vr = _toml_parse_value(s, cur)
            push(arr, vr[1])
            cur = vr[0]
        if cur < len(s)
            cur = cur + 1
        return [cur, arr]
    // number (int or float)
    let start = i
    let is_float = 0
    if c == "-" or c == "+"
        i = i + 1
    while i < len(s) and _toml_is_digit(s[i:i + 1])
        i = i + 1
    if i < len(s) and s[i:i + 1] == "."
        is_float = 1
        i = i + 1
        while i < len(s) and _toml_is_digit(s[i:i + 1])
            i = i + 1
    let numstr = s[start:i]
    if is_float
        return [i, float(numstr)]
    return [i, int(numstr)]

fn parse_toml(text: string) -> dict
    let result = {}
    let section = ""
    let lines = split(text, "\n")
    for line in lines
        let l = trim(line)
        if l == "" or l[0:1] == "#"
            continue
        if l[0:1] == "["
            let end = 1
            while end < len(l) and l[end:end + 1] != "]"
                end = end + 1
            section = l[1:end]
            continue
        let eq = 0
        while eq < len(l) and l[eq:eq + 1] != "="
            eq = eq + 1
        if eq >= len(l)
            continue
        let key = trim(l[0:eq])
        let vi = _toml_skip_ws(l, eq + 1)
        let vr = _toml_parse_value(l, vi)
        let full_key = key
        if section != ""
            full_key = section + "." + key
        result[full_key] = vr[1]
    result

fn toml_get(d: dict, key: string)
    if contains(d, key)
        return d[key]
    return ""

fn toml_get_int(d: dict, key: string) -> int
    if contains(d, key)
        return int(d[key])
    return 0

fn toml_get_str(d: dict, key: string) -> string
    if contains(d, key)
        return str(d[key])
    return ""

// ── Tests ──────────────────────────────────────────────────────────────────

fn main()
    let dq = chr(34)

    // Basic key=value
    let t1 = parse_toml("name = " + dq + "NOVA" + dq + "\nversion = 1")
    assert(toml_get(t1, "name") == "NOVA", "basic string")
    assert(toml_get(t1, "version") == 1, "basic int")

    // Sections
    let t2 = parse_toml("[server]\nhost = " + dq + "localhost" + dq + "\nport = 8080\n[db]\nname = " + dq + "test" + dq)
    assert(toml_get(t2, "server.host") == "localhost", "section host")
    assert(toml_get(t2, "server.port") == 8080, "section port")
    assert(toml_get(t2, "db.name") == "test", "section db")

    // Booleans
    let t3 = parse_toml("debug = true\nverbose = false")
    assert(toml_get(t3, "debug") == 1, "bool true")
    assert(toml_get(t3, "verbose") == 0, "bool false")

    // Floats
    let t4 = parse_toml("pi = 3.14\nneg = -2.5")
    assert(toml_get(t4, "pi") == 3.14, "float pi")

    // Arrays
    let t5 = parse_toml("ports = [80, 443, 8080]")
    let ports = toml_get(t5, "ports")
    assert(len(ports) == 3, "array len")
    assert(ports[0] == 80, "arr 0")
    assert(ports[1] == 443, "arr 1")
    assert(ports[2] == 8080, "arr 2")

    // Comments
    let t6 = parse_toml("# this is a comment\nkey = 42\n# another comment")
    assert(toml_get(t6, "key") == 42, "comments")

    // Empty lines
    let t7 = parse_toml("\n\nkey = 1\n\n")
    assert(toml_get(t7, "key") == 1, "empty lines")

    // String escapes
    let t8 = parse_toml("msg = " + dq + "hello\\nworld" + dq)
    assert(contains(toml_get(t8, "msg"), "\n"), "escape newline")

    // Negative integers
    let t9 = parse_toml("offset = -42")
    assert(toml_get(t9, "offset") == -42, "negative int")

    // String arrays
    let t10 = parse_toml("tags = [" + dq + "web" + dq + ", " + dq + "api" + dq + "]")
    let tags = toml_get(t10, "tags")
    assert(len(tags) == 2, "str array len")
    assert(tags[0] == "web", "str arr 0")
    assert(tags[1] == "api", "str arr 1")

    print("tomlx: all passed")
