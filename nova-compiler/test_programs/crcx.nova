fn crc16(data)
  let bytes = str_to_bytes(data)
  let n = bytes_len(bytes)
  let crc = 65535
  let i = 0
  while i < n
    let b = bytes_get(bytes, i)
    crc = crc ^ b
    let j = 0
    while j < 8
      if (crc & 1) == 1
        crc = (crc >> 1) ^ 40961
      else
        crc = crc >> 1
      j = j + 1
    i = i + 1
  crc & 65535

fn checksum8(data)
  let bytes = str_to_bytes(data)
  let n = bytes_len(bytes)
  let sum = 0
  let i = 0
  while i < n
    sum = sum + bytes_get(bytes, i)
    i = i + 1
  sum & 255

fn adler32(data)
  let bytes = str_to_bytes(data)
  let n = bytes_len(bytes)
  let a = 1
  let b = 0
  let i = 0
  while i < n
    a = (a + bytes_get(bytes, i)) % 65521
    b = (b + a) % 65521
    i = i + 1
  (b << 16) | a

fn main()
  let c1 = crc16("Hello")
  assert(c1 > 0, "crc16 non-zero")
  let c2 = crc16("Hello")
  assert(c1 == c2, "crc16 deterministic")
  assert(crc16("Hello") != crc16("World"), "crc16 different inputs")
  assert(crc16("") == 65535, "crc16 empty = init")

  let s1 = checksum8("AB")
  assert(s1 == (65 + 66) & 255, "checksum8 AB")
  assert(checksum8("") == 0, "checksum8 empty")

  let a1 = adler32("Hello")
  assert(a1 > 0, "adler32 non-zero")
  assert(adler32("Hello") == adler32("Hello"), "adler32 deterministic")
  assert(adler32("Hello") != adler32("World"), "adler32 different")
  assert(adler32("") == 1, "adler32 empty = 1")

  print("crcx: all passed")
