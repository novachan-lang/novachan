import std/game/connect4
import std/game/lights_out
import std/game/magic_square
import std/game/mastermind
import std/game/ladder
import std/game/leaderboard
import std/game/round_robin
import std/game/seed_bracket
import std/game/swiss_pair
import std/game/tourney_bracket

fn assert_eq(label: string, got: any, want: any)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
    else
        print("ok " + label)

fn list_eq(a: list, b: list) -> bool
    if len(a) != len(b)
        return false
    for i in 0..len(a)
        if a[i] != b[i]
            return false
    true

fn main()
    // connect4: build a horizontal win for player 1 on bottom row, 7-wide 6-tall
    let board = [0 for i in 0..42]
    let b1 = c4_drop(board, 7, 6, 0, 1)
    let b2 = c4_drop(b1, 7, 6, 1, 1)
    let b3 = c4_drop(b2, 7, 6, 2, 1)
    let b4 = c4_drop(b3, 7, 6, 3, 1)
    assert_eq("c4_winner horizontal", c4_winner(b4, 7, 6), 1)
    assert_eq("c4_winner none", c4_winner(board, 7, 6), 0)

    // lights_out 2x2 solvable board: press cell 0 toggles 0,1,2 (no diag). Use n=2 all-lit.
    let lo_board = [1, 1, 1, 0]
    let sol = lights_out_solve(lo_board, 2)
    let applied = lights_out_apply(lo_board, 2, sol)
    assert_eq("lights_out solved (all zero)", sum(applied), 0)

    // magic_square
    let ms = magic_square(3)
    assert_eq("magic_square 3x3 is_magic", is_magic(ms, 3), true)
    assert_eq("magic_constant 3", magic_constant(3), 15)
    let ms5 = magic_square(5)
    assert_eq("magic_square 5x5 is_magic", is_magic(ms5, 5), true)

    // mastermind
    let score1 = mastermind_score([1, 2, 3, 4], [1, 2, 3, 4])
    assert_eq("mastermind all black", list_eq(score1, [4, 0]), true)
    let score2 = mastermind_score([1, 2, 3, 4], [4, 3, 2, 1])
    assert_eq("mastermind all white", list_eq(score2, [0, 4]), true)
    let score3 = mastermind_score([1, 1, 2, 2], [1, 2, 1, 2])
    assert_eq("mastermind mixed", list_eq(score3, [2, 2]), true)

    // ladder
    assert_eq("ladder_rank found", ladder_rank([10, 20, 30], 20), 1)
    assert_eq("ladder_rank missing", ladder_rank([10, 20, 30], 99), -1)
    let newladder = ladder_challenge([10, 20, 30], 2, 0, true)
    assert_eq("ladder_challenge swap", list_eq(newladder, [30, 20, 10]), true)
    let unchanged = ladder_challenge([10, 20, 30], 2, 0, false)
    assert_eq("ladder_challenge no swap", list_eq(unchanged, [10, 20, 30]), true)

    // leaderboard
    let entries = [[1, 100], [2, 90], [3, 90], [4, 80]]
    let ranked = rank_entries(entries)
    assert_eq("rank_entries r0", ranked[0][2], 1)
    assert_eq("rank_entries tie r1", ranked[1][2], 2)
    assert_eq("rank_entries tie r2", ranked[2][2], 2)
    assert_eq("rank_entries r3 skips to 4", ranked[3][2], 4)
    let top2 = top_n(entries, 2)
    assert_eq("top_n count", len(top2), 2)

    // round_robin
    assert_eq("total_rounds even", total_rounds(4), 3)
    assert_eq("total_rounds odd", total_rounds(5), 5)
    let sched = round_robin_schedule(4)
    assert_eq("round_robin_schedule rounds", len(sched), 3)
    assert_eq("round_robin_schedule pairs_per_round", len(sched[0]), 2)

    // seed_bracket
    assert_eq("seed_order 4", list_eq(seed_order(4), [1, 4, 2, 3]), true)
    assert_eq("seed_order 8", list_eq(seed_order(8), [1, 8, 4, 5, 2, 7, 3, 6]), true)
    let matchups = seed_matchups(4)
    assert_eq("seed_matchups", list_eq(matchups[0], [1, 4]), true)

    // swiss_pair
    let pairs = swiss_pair([[1, 100], [2, 90], [3, 80]])
    assert_eq("swiss_pair count", len(pairs), 2)
    assert_eq("swiss_pair bye", list_eq(pairs[1], [3, -1]), true)

    // tourney_bracket
    assert_eq("bracket_size", bracket_size(5), 8)
    assert_eq("single_elim_rounds", single_elim_rounds(8), 3)
    let adv = advance_bracket([1, 2, 3, 4, 5])
    assert_eq("advance_bracket count", len(adv), 3)
    assert_eq("advance_bracket bye", list_eq(adv[2], [5]), true)

    print("_game3_kat_test passed")
