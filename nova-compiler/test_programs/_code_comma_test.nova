// KAT test for std/compress/code_comma
// Verifies: known-answer digit vectors, round-trips 0..100, sequence round-trip.
//
// CONVENTION: comma3_encode(n) encodes n >= 0 as {0,1}* ++ [2].
//   n=0 -> [2]
//   n=1 -> [0,2]   (m=2, payload=[0])
//   n=2 -> [1,2]   (m=3, payload=[1])
//   n=3 -> [0,0,2] (m=4, payload=[0,0])
//   n=4 -> [0,1,2] (m=5, payload=[0,1])
//   n=5 -> [1,0,2] (m=6, payload=[1,0])
//   n=6 -> [1,1,2] (m=7, payload=[1,1])
//   n=7 -> [0,0,0,2]
import std/compress/code_comma

// ── Helpers ───────────────────────────────────────────────────────────────────

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl_eq(label, got, want)
    if len(got) != len(want)
        print("FAIL " + label + " len: got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

// make helpers for building small lists without multi-line literals
fn mk1(a) -> list
    let r = []
    push(r, a)
    r

fn mk2(a, b) -> list
    let r = []
    push(r, a)
    push(r, b)
    r

fn mk3(a, b, c) -> list
    let r = []
    push(r, a)
    push(r, b)
    push(r, c)
    r

fn mk4(a, b, c, d) -> list
    let r = []
    push(r, a)
    push(r, b)
    push(r, c)
    push(r, d)
    r

fn mk5(a, b, c, d, e) -> list
    let r = []
    push(r, a)
    push(r, b)
    push(r, c)
    push(r, d)
    push(r, e)
    r

fn mk7(a, b, c, d, e, f, g) -> list
    let r = []
    push(r, a)
    push(r, b)
    push(r, c)
    push(r, d)
    push(r, e)
    push(r, f)
    push(r, g)
    r

fn mk8(a, b, c, d, e, f, g, h) -> list
    let r = []
    push(r, a)
    push(r, b)
    push(r, c)
    push(r, d)
    push(r, e)
    push(r, f)
    push(r, g)
    push(r, h)
    r

// ── KAT 1: known digit-vector vectors ────────────────────────────────────────

// n=0: m=1, k=0, payload=[], code=[2]
let enc0 = comma3_encode(0)
ckl_eq("encode_0", enc0, mk1(2))

// n=1: m=2, k=1, payload=[0], code=[0,2]
let enc1 = comma3_encode(1)
ckl_eq("encode_1", enc1, mk2(0, 2))

// n=2: m=3, k=1, payload=[1], code=[1,2]
let enc2 = comma3_encode(2)
ckl_eq("encode_2", enc2, mk2(1, 2))

// n=3: m=4, k=2, payload=[0,0], code=[0,0,2]
let enc3 = comma3_encode(3)
ckl_eq("encode_3", enc3, mk3(0, 0, 2))

// n=4: m=5, k=2, payload=[0,1], code=[0,1,2]
let enc4 = comma3_encode(4)
ckl_eq("encode_4", enc4, mk3(0, 1, 2))

// n=5: m=6, k=2, payload=[1,0], code=[1,0,2]
let enc5 = comma3_encode(5)
ckl_eq("encode_5", enc5, mk3(1, 0, 2))

// n=6: m=7, k=2, payload=[1,1], code=[1,1,2]
let enc6 = comma3_encode(6)
ckl_eq("encode_6", enc6, mk3(1, 1, 2))

// n=7: m=8, k=3, payload=[0,0,0], code=[0,0,0,2]
let enc7 = comma3_encode(7)
ckl_eq("encode_7", enc7, mk4(0, 0, 0, 2))

// n=100: m=101=0b1100101, k=6, payload=[1,0,0,1,0,1], code=[1,0,0,1,0,1,2]
let enc100 = comma3_encode(100)
ckl_eq("encode_100", enc100, mk7(1, 0, 0, 1, 0, 1, 2))

// ── KAT 2: invalid input guard ────────────────────────────────────────────────

// comma3_encode(-1) must return []
let enc_neg = comma3_encode(-1)
cki("encode_neg_len", len(enc_neg), 0)

// ── KAT 3: known decode vectors ──────────────────────────────────────────────

// [2] -> [0, 1]
let d0 = comma3_decode(mk1(2), 0)
cki("decode_0_val", d0[0], 0)
cki("decode_0_pos", d0[1], 1)

// [0,2] -> [1, 2]
let d1 = comma3_decode(mk2(0, 2), 0)
cki("decode_1_val", d1[0], 1)
cki("decode_1_pos", d1[1], 2)

// [1,2] -> [2, 2]
let d2 = comma3_decode(mk2(1, 2), 0)
cki("decode_2_val", d2[0], 2)
cki("decode_2_pos", d2[1], 2)

// [0,0,2] -> [3, 3]
let d3 = comma3_decode(mk3(0, 0, 2), 0)
cki("decode_3_val", d3[0], 3)
cki("decode_3_pos", d3[1], 3)

// [0,1,2] -> [4, 3]
let d4 = comma3_decode(mk3(0, 1, 2), 0)
cki("decode_4_val", d4[0], 4)
cki("decode_4_pos", d4[1], 3)

// [1,0,2] -> [5, 3]
let d5 = comma3_decode(mk3(1, 0, 2), 0)
cki("decode_5_val", d5[0], 5)
cki("decode_5_pos", d5[1], 3)

// [1,1,2] -> [6, 3]
let d6 = comma3_decode(mk3(1, 1, 2), 0)
cki("decode_6_val", d6[0], 6)
cki("decode_6_pos", d6[1], 3)

// [1,0,0,1,0,1,2] -> [100, 7]
let d100 = comma3_decode(mk7(1, 0, 0, 1, 0, 1, 2), 0)
cki("decode_100_val", d100[0], 100)
cki("decode_100_pos", d100[1], 7)

// ── KAT 4: decode from non-zero pos ──────────────────────────────────────────
// concat encode(1) ++ encode(4) = [0,2,0,1,2]; decode from pos=2 -> [4, 5]
let concat_pos = mk5(0, 2, 0, 1, 2)
let dp4 = comma3_decode(concat_pos, 2)
cki("decode_pos_val", dp4[0], 4)
cki("decode_pos_pos", dp4[1], 5)

// ── KAT 5: malformed input (no comma) ────────────────────────────────────────
// [0, 1] (no 2) -> [-1, 2]
let bad_digits = mk2(0, 1)
let bad_dec = comma3_decode(bad_digits, 0)
cki("decode_malformed_val", bad_dec[0], -1)
cki("decode_malformed_pos", bad_dec[1], 2)

// ── KAT 6: round-trip 0..100 ─────────────────────────────────────────────────
// For each n in [0..100]: decode(encode(n), 0) must return [n, len(encode(n))].
let rt_n = 0
while rt_n <= 100
    let enc = comma3_encode(rt_n)
    let dec = comma3_decode(enc, 0)
    if dec[0] != rt_n
        print("FAIL round_trip_" + str(rt_n) + " val: got=" + str(dec[0]) + " want=" + str(rt_n))
        exit(1)
    if dec[1] != len(enc)
        print("FAIL round_trip_" + str(rt_n) + " pos: got=" + str(dec[1]) + " want=" + str(len(enc)))
        exit(1)
    rt_n = rt_n + 1

// ── KAT 7: last digit of every codeword is 2 ─────────────────────────────────
// Verify comma3_encode produces codes that always end in 2 for n in 0..50.
let comma_n = 0
while comma_n <= 50
    let code = comma3_encode(comma_n)
    let last = code[len(code) - 1]
    if last != 2
        print("FAIL last_digit_" + str(comma_n) + ": got=" + str(last) + " want=2")
        exit(1)
    comma_n = comma_n + 1

// ── KAT 8: no 2 appears in payload digits ────────────────────────────────────
// For n in 0..50: every digit except the last must be 0 or 1.
let payload_n = 0
while payload_n <= 50
    let code = comma3_encode(payload_n)
    let clen = len(code)
    let pi = 0
    while pi < clen - 1
        let d = code[pi]
        if d != 0 and d != 1
            print("FAIL payload_digit_" + str(payload_n) + "[" + str(pi) + "]: got=" + str(d))
            exit(1)
        pi = pi + 1
    payload_n = payload_n + 1

// ── KAT 9: code length = floor(log2(n+1)) + 1 ────────────────────────────────
// Verify length formula for n in 0..100.
let len_n = 0
while len_n <= 100
    let code = comma3_encode(len_n)
    let got_len = len(code)
    // compute floor(log2(len_n+1)) + 1
    let m = len_n + 1
    let k = 0
    let v = m
    while v > 1
        v = v / 2
        k = k + 1
    let want_len = k + 1
    if got_len != want_len
        print("FAIL len_formula_" + str(len_n) + ": got=" + str(got_len) + " want=" + str(want_len))
        exit(1)
    len_n = len_n + 1

// ── KAT 10: sequence round-trip — the task-specified case ────────────────────
// comma3_decode_seq(comma3_encode_seq([3, 1, 4])) == [3, 1, 4]
let seq314 = []
push(seq314, 3)
push(seq314, 1)
push(seq314, 4)
let enc_seq = comma3_encode_seq(seq314)
let dec_seq = comma3_decode_seq(enc_seq)
ckl_eq("seq314_roundtrip", dec_seq, seq314)

// ── KAT 11: sequence round-trip — wider range ────────────────────────────────
// Encode sequence [0,1,2,3,5,10,15,31,32,63,64,100] and decode back.
let wide_vals = []
push(wide_vals, 0)
push(wide_vals, 1)
push(wide_vals, 2)
push(wide_vals, 3)
push(wide_vals, 5)
push(wide_vals, 10)
push(wide_vals, 15)
push(wide_vals, 31)
push(wide_vals, 32)
push(wide_vals, 63)
push(wide_vals, 64)
push(wide_vals, 100)
let wide_enc = comma3_encode_seq(wide_vals)
let wide_dec = comma3_decode_seq(wide_enc)
ckl_eq("wide_seq_roundtrip", wide_dec, wide_vals)

// ── KAT 12: sequential decode using pos chain ─────────────────────────────────
// Manually decode a sequence of 3 values using the next_pos return from each decode.
// encode(3)=[0,0,2], encode(1)=[0,2], encode(4)=[0,1,2]
// concat=[0,0,2,0,2,0,1,2]
let seq_concat = mk8(0, 0, 2, 0, 2, 0, 1, 2)
let sc0 = comma3_decode(seq_concat, 0)
cki("seq_concat_v0", sc0[0], 3)
let sc1 = comma3_decode(seq_concat, sc0[1])
cki("seq_concat_v1", sc1[0], 1)
let sc2 = comma3_decode(seq_concat, sc1[1])
cki("seq_concat_v2", sc2[0], 4)
cki("seq_concat_end", sc2[1], 8)

// ── KAT 13: larger round-trips ────────────────────────────────────────────────
let big_vals = []
push(big_vals, 200)
push(big_vals, 500)
push(big_vals, 1000)
push(big_vals, 9999)
let bv_i = 0
while bv_i < len(big_vals)
    let bv = big_vals[bv_i]
    let bv_enc = comma3_encode(bv)
    let bv_dec = comma3_decode(bv_enc, 0)
    if bv_dec[0] != bv
        print("FAIL big_rt_" + str(bv) + ": got=" + str(bv_dec[0]) + " want=" + str(bv))
        exit(1)
    bv_i = bv_i + 1

print("PASS _code_comma_test")
