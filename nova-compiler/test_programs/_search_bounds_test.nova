import std/search/search_bounds

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL search_bounds " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // --- sb_lower_bound ---
    // KAT: sb_lower_bound([1,2,2,3],2)=1
    let a1 = [1, 2, 2, 3]
    cki("lb([1,2,2,3],2)", sb_lower_bound(a1, 2), 1)
    // KAT: sb_lower_bound([1,3,5],4)=2  (first index >= 4 is index 2, value 5)
    let a2 = [1, 3, 5]
    cki("lb([1,3,5],4)", sb_lower_bound(a2, 4), 2)
    // lower bound of existing first element
    cki("lb([1,2,2,3],1)", sb_lower_bound(a1, 1), 0)
    // lower bound of existing last element
    cki("lb([1,2,2,3],3)", sb_lower_bound(a1, 3), 3)
    // lower bound larger than all elements -> len(a)
    cki("lb([1,2,2,3],5)", sb_lower_bound(a1, 5), 4)
    // lower bound smaller than all elements -> 0
    cki("lb([1,2,2,3],0)", sb_lower_bound(a1, 0), 0)
    // empty list -> 0
    let a_empty = []
    cki("lb([],1)", sb_lower_bound(a_empty, 1), 0)

    // --- sb_upper_bound ---
    // KAT: sb_upper_bound([1,2,2,3],2)=3
    cki("ub([1,2,2,3],2)", sb_upper_bound(a1, 2), 3)
    // KAT: sb_upper_bound([1,3,5],5)=3  (all elements <= 5, so len=3)
    cki("ub([1,3,5],5)", sb_upper_bound(a2, 5), 3)
    // upper bound of first element
    cki("ub([1,2,2,3],1)", sb_upper_bound(a1, 1), 1)
    // upper bound of last element -> len(a)
    cki("ub([1,2,2,3],3)", sb_upper_bound(a1, 3), 4)
    // upper bound larger than all -> len(a)
    cki("ub([1,2,2,3],5)", sb_upper_bound(a1, 5), 4)
    // upper bound smaller than all -> 0
    cki("ub([1,2,2,3],0)", sb_upper_bound(a1, 0), 0)
    // empty list -> 0
    cki("ub([],1)", sb_upper_bound(a_empty, 1), 0)

    // --- sb_count ---
    // KAT: sb_count([1,2,2,2,3],2)=3
    let a3 = [1, 2, 2, 2, 3]
    cki("count([1,2,2,2,3],2)", sb_count(a3, 2), 3)
    // KAT: sb_count([1,3,5],4)=0
    cki("count([1,3,5],4)", sb_count(a2, 4), 0)
    // count of single-occurrence element
    cki("count([1,2,2,2,3],1)", sb_count(a3, 1), 1)
    cki("count([1,2,2,2,3],3)", sb_count(a3, 3), 1)
    // count of absent element
    cki("count([1,2,2,2,3],5)", sb_count(a3, 5), 0)
    // empty list
    cki("count([],2)", sb_count(a_empty, 2), 0)
    // all same
    let a_all = [2, 2, 2]
    cki("count([2,2,2],2)", sb_count(a_all, 2), 3)
    cki("count([2,2,2],1)", sb_count(a_all, 1), 0)

    // --- sb_insertion_point ---
    // KAT: sb_insertion_point([1,3,5],0)=0
    cki("ins([1,3,5],0)", sb_insertion_point(a2, 0), 0)
    // insert in the middle
    cki("ins([1,3,5],2)", sb_insertion_point(a2, 2), 1)
    cki("ins([1,3,5],4)", sb_insertion_point(a2, 4), 2)
    // insert at end
    cki("ins([1,3,5],6)", sb_insertion_point(a2, 6), 3)
    // insert existing (lower bound = first occurrence)
    cki("ins([1,2,2,3],2)", sb_insertion_point(a1, 2), 1)
    // empty list
    cki("ins([],5)", sb_insertion_point(a_empty, 5), 0)

    print("PASS _search_bounds_test")
