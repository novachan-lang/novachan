@comptime
fn version() -> string
    return "2.1.0"

@comptime
fn build_tag() -> string
    return "nova-" + "v2.1.0" + "-release"

@comptime
fn max_retries() -> int
    return 3 + 2

@comptime
fn greeting(name: string) -> string
    return "Hello, " + name + "!"

@comptime
fn compute(a: int, b: int) -> int
    let sum = a + b
    let doubled = sum * 2
    return doubled

@comptime
fn classify(x: int) -> string
    if x > 10
        return "big"
    return "small"

fn main()
    let v = version()
    assert(v == "2.1.0", "comptime version")

    let tag = build_tag()
    assert(tag == "nova-v2.1.0-release", "comptime concat")

    let r = max_retries()
    assert(r == 5, "comptime arithmetic")

    let g = greeting("Nova")
    assert(g == "Hello, Nova!", "comptime with args")

    let c = compute(3, 4)
    assert(c == 14, "comptime multi-step")

    let cl = classify(15)
    assert(cl == "big", "comptime if-else big")

    let cl2 = classify(5)
    assert(cl2 == "small", "comptime if-else small")

    print("COMPTIME TEST PASS")
