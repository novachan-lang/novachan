fn work(x)
    let s = 0
    let i = 0
    while i < 50
        s = s + (x + i) * (x + i)
        i = i + 1
    s

fn main()
    let xs = []
    let k = 0
    while k < 10000
        push(xs, k)
        k = k + 1
    let results = map(xs, work)
    let total = 0
    for r in results
        total = total + r
    print(str(total))
