// Regression guard for the int/pointer + int/string value-model soundness fix.
// UNTYPED `work` => `x`/`s` are `any` => `+`/`*` lower to dynamic nova_rt_add/mul.
// 10k calls produce ~10^6 dynamic ops whose large integer results used to collide
// with readable process addresses and get strlen()'d as strings -> wild-read crash.
// With sound discrimination (every runtime string carries identity), a bare integer
// can never be mistaken for a string. Must compute the exact deterministic sum.

fn work(x)
    let s = 0
    let i = 0
    while i < 50
        s = s + (x + i) * (x + i)
        i = i + 1
    s

fn main()
    let xs = []
    let k = 0
    while k < 10000
        push(xs, k)
        k = k + 1
    let results = map(xs, work)
    let total = 0
    for r in results
        total = total + r
    assert_eq(total, 16787058750000)
    print("int_ptr_soundness_repro passed")
