import std/functional/freduce

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _freduce_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL _freduce_test " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn ckl(label: string, got: list, want: list)
    cki(label + ".len", len(got), len(want))
    let i = 0
    while i < len(want)
        cki(label + "[" + str(i) + "]", got[i], want[i])
        i = i + 1

// Helper binary functions
fn add(a, b)
    a + b

fn sub(a, b)
    a - b

fn mul(a, b)
    a * b

fn main()
    // fr_foldl: sum [1,2,3,4] from 0 = 10
    cki("foldl_sum_1234", fr_foldl(add, 0, [1, 2, 3, 4]), 10)

    // fr_foldl: left sub [1,2,3] from 0 = ((0-1)-2)-3 = -6
    cki("foldl_sub_123", fr_foldl(sub, 0, [1, 2, 3]), -6)

    // fr_foldl: empty list returns init
    cki("foldl_empty", fr_foldl(add, 100, []), 100)

    // fr_foldl: single element
    cki("foldl_single", fr_foldl(add, 5, [3]), 8)

    // fr_foldl: product [1,2,3,4] from 1 = 24
    cki("foldl_product", fr_foldl(mul, 1, [1, 2, 3, 4]), 24)

    // fr_foldl: sum with non-zero init
    cki("foldl_init", fr_foldl(add, 10, [1, 2, 3]), 16)

    // fr_foldr: right sub [1,2,3] from 0 = 1-(2-(3-0)) = 1-(2-3) = 1-(-1) = 2
    cki("foldr_sub_123", fr_foldr(sub, 0, [1, 2, 3]), 2)

    // fr_foldr: sum is same as foldl for add (commutative+associative)
    cki("foldr_sum_1234", fr_foldr(add, 0, [1, 2, 3, 4]), 10)

    // fr_foldr: empty list returns init
    cki("foldr_empty", fr_foldr(sub, 99, []), 99)

    // fr_foldr: single element: f(xs[0], init) = 7 - 3 = 4
    cki("foldr_single", fr_foldr(sub, 3, [7]), 4)

    // fr_foldr: right sub [2,3] from 0 = 2-(3-0) = 2-3 = -1
    cki("foldr_sub_23", fr_foldr(sub, 0, [2, 3]), -1)

    // fr_scanl: prefix sums [1,2,3,4] from 0 = [0,1,3,6,10]
    let r1 = fr_scanl(add, 0, [1, 2, 3, 4])
    ckl("scanl_sum_1234", r1, [0, 1, 3, 6, 10])

    // fr_scanl: empty list returns [init]
    let r2 = fr_scanl(add, 0, [])
    ckl("scanl_empty", r2, [0])

    // fr_scanl: single element returns [init, f(init, x)]
    let r3 = fr_scanl(add, 10, [5])
    ckl("scanl_single", r3, [10, 15])

    // fr_scanl: subtraction scan [1,2,3] from 0 = [0,-1,-3,-6]
    let r4 = fr_scanl(sub, 0, [1, 2, 3])
    ckl("scanl_sub_123", r4, [0, -1, -3, -6])

    // fr_scanl: product scan [2,3,4] from 1 = [1,2,6,24]
    let r5 = fr_scanl(mul, 1, [2, 3, 4])
    ckl("scanl_product", r5, [1, 2, 6, 24])

    print("PASS _freduce_test")

main()
