import forge_scale

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn nearp(name: string, a: float, b: float) -> int
    let d = a - b
    if d > -0.001 and d < 0.001
        return 0
    print("FAIL " + name + ": got=" + str(a) + " want~=" + str(b))
    1

fn main()
    let fails = 0

    // min-max: [0,5,10] -> [0, 0.5, 1]
    let mm = scale_minmax([0.0, 5.0, 10.0])
    fails = fails + nearp("mm0", mm[0], 0.0)
    fails = fails + nearp("mm1", mm[1], 0.5)
    fails = fails + nearp("mm2", mm[2], 1.0)
    // constant list -> all 0
    let mmc = scale_minmax([3.0, 3.0, 3.0])
    fails = fails + nearp("mm_const", mmc[1], 0.0)

    // bounds + apply
    let b = scale_bounds([0.0, 5.0, 10.0])
    fails = fails + nearp("bounds_min", b[0], 0.0)
    fails = fails + nearp("bounds_max", b[1], 10.0)
    fails = fails + nearp("mm_apply", scale_minmax_apply(b, 2.5), 0.25)

    // z-score: [2,4,4,4,5,5,7,9] mean 5 std 2 -> [-1.5,-0.5,-0.5,-0.5,0,0,1,2]
    let z = scale_zscore([2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0])
    fails = fails + nearp("z0", z[0], -1.5)
    fails = fails + nearp("z4", z[4], 0.0)
    fails = fails + nearp("z6", z[6], 1.0)
    fails = fails + nearp("z7", z[7], 2.0)

    // stats + apply
    let st = scale_stats([2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0])
    fails = fails + nearp("stats_mean", st[0], 5.0)
    fails = fails + nearp("stats_std", st[1], 2.0)
    fails = fails + nearp("z_apply", scale_zscore_apply(st, 11.0), 3.0)

    // unit vector: [3,4] -> [0.6, 0.8]
    let u = scale_unit([3.0, 4.0])
    fails = fails + nearp("u0", u[0], 0.6)
    fails = fails + nearp("u1", u[1], 0.8)
    // zero vector stays zero
    let uz = scale_unit([0.0, 0.0])
    fails = fails + nearp("u_zero", uz[0], 0.0)
    // unit vector has length 1
    let u3 = scale_unit([1.0, 2.0, 2.0])
    fails = fails + nearp("u3_len", u3[0] * u3[0] + u3[1] * u3[1] + u3[2] * u3[2], 1.0)

    // integer inputs coerce
    let mi = scale_minmax([0, 2, 4])
    fails = fails + nearp("int_mid", mi[1], 0.5)

    if fails == 0
        print("forge_scale: all passed")
    else
        print("forge_scale: " + str(fails) + " FAILED")
