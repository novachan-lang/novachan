// KAT for std/dsp/convolution — discrete convolution of float lists.
// Hand-computed expected values; epsilon 0.001 for float comparisons.
import std/dsp/convolution

// ckf: compare two floats within epsilon 0.001
fn ckf(label: string, got: float, want: float)
    let d = got - want
    if d < 0.0
        d = 0.0 - d
    if d > 0.001
        print("FAIL " + label + ": " + str(got) + " != " + str(want))
        exit(1)

// ckfl: compare two float lists element-wise within epsilon 0.001
fn ckfl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + " length: " + str(len(got)) + " != " + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        let gv = got[i] * 1.0
        let wv = want[i] * 1.0
        let d = gv - wv
        if d < 0.0
            d = 0.0 - d
        if d > 0.001
            print("FAIL " + label + "[" + str(i) + "]: " + str(gv) + " != " + str(wv))
            exit(1)
        i = i + 1

fn main()
    // KAT 1: cnv_full([1,2,3],[0,1,0.5]) == [0,1,2.5,4,1.5]
    let a1 = [1.0, 2.0, 3.0]
    let b1 = [0.0, 1.0, 0.5]
    let w1 = [0.0, 1.0, 2.5, 4.0, 1.5]
    ckfl("cnv_full_basic", cnv_full(a1, b1), w1)

    // KAT 2: cnv_full([1,1],[1,1]) == [1,2,1]
    let a2 = [1.0, 1.0]
    let b2 = [1.0, 1.0]
    let w2 = [1.0, 2.0, 1.0]
    ckfl("cnv_full_box", cnv_full(a2, b2), w2)

    // KAT 3: cnv_full([1],[5]) == [5]
    let a3 = [1.0]
    let b3 = [5.0]
    let w3 = [5.0]
    ckfl("cnv_full_scalar", cnv_full(a3, b3), w3)

    // KAT 4: len(cnv_full([1,2,3],[1,1])) == 4
    let a4 = [1.0, 2.0, 3.0]
    let b4 = [1.0, 1.0]
    let r4 = cnv_full(a4, b4)
    ckf("cnv_full_len", len(r4) * 1.0, 4.0)

    // KAT 5: cnv_valid([1,2,3,4],[1,1]) == [3,5,7]
    let a5 = [1.0, 2.0, 3.0, 4.0]
    let b5 = [1.0, 1.0]
    let w5 = [3.0, 5.0, 7.0]
    ckfl("cnv_valid_basic", cnv_valid(a5, b5), w5)

    // KAT 6: cnv_same([1,2,3],[1,1]) length == 3
    let a6 = [1.0, 2.0, 3.0]
    let b6 = [1.0, 1.0]
    let r6 = cnv_same(a6, b6)
    ckf("cnv_same_len", len(r6) * 1.0, 3.0)

    // KAT 7: cnv_full empty a returns empty
    let r7 = cnv_full([], [1.0, 2.0])
    ckf("cnv_full_empty_a", len(r7) * 1.0, 0.0)

    // KAT 8: cnv_valid where b longer than a returns empty
    let r8 = cnv_valid([1.0, 2.0], [1.0, 1.0, 1.0])
    ckf("cnv_valid_no_overlap", len(r8) * 1.0, 0.0)

    print("_convolution_test passed")
