// Transparent type aliases (table-stakes ergonomics):
//   type Name = TargetType
// A `type X = T` makes X a zero-cost synonym for T — fully interchangeable
// with T, resolved during inference (ti_ann_to_type_g), with NO runtime
// representation. Aliases are pre-scanned, so a forward reference (using the
// alias before it is declared) resolves correctly regardless of source order.

// 1. Primitive alias used BEFORE it is declared (exercises the pre-scan).
fn bump(n: Counter) -> Counter
    return n + 1

// 2. Alias-of-an-alias: Tally -> Counter -> int.
type Counter = int
type Tally = Counter

fn double_t(t: Tally) -> Tally
    return t * 2

// 3. Parametric aliases over the collection types.
type Headers = dict<string, string>
type Ints = list<int>

fn first_int(xs: Ints) -> int
    return xs[0]

// 4. Alias to a struct type — Coord is just Point.
type Point
    x: int
    y: int

type Coord = Point

fn origin() -> Coord
    return Point { x: 0, y: 0 }

// 5. Alias to a primitive float.
type Celsius = float

fn freezing() -> Celsius
    return 0.0

// 6. Aliases used as STRUCT FIELD types (Id = int, Ints = list<int>).
type Id = int

type User
    id: Id
    tags: Ints

// 7. Double-nested parametric alias (exercises `>>` capture + recursive
//    resolution through the alias).
type Grid = list<list<int>>

fn cell(g: Grid, r: int, c: int) -> int
    return g[r][c]

// 8. Dict alias with a non-string value type (distinct from Headers above).
type Scores = dict<string, int>

fn score_of(m: Scores, k: string) -> int
    return m[k]

fn main()
    // primitive alias, forward-referenced from bump()
    assert_eq(bump(41), 42)

    // alias-of-alias flows transparently as int arithmetic
    assert_eq(double_t(21), 42)

    // an int value is interchangeable with its alias at the call boundary
    let raw = 5
    assert_eq(bump(raw), 6)

    // parametric dict alias
    let h = {}
    h["content-type"] = "text/html"
    assert_eq(h["content-type"], "text/html")

    // parametric list alias
    assert_eq(first_int([10, 20, 30]), 10)

    // struct fields typed via aliases
    let u = User { id: 7, tags: [1, 2, 3] }
    assert_eq(u.id, 7)
    assert_eq(u.tags, [1, 2, 3])

    // alias to a struct type
    let p = origin()
    assert_eq(p.x, 0)
    assert_eq(p.y, 0)

    // alias to float
    assert_eq(freezing(), 0.0)

    // double-nested generic alias
    let grid = [[1, 2, 3], [4, 5, 6]]
    assert_eq(cell(grid, 1, 2), 6)

    // dict alias with an int value type
    let scores = {}
    scores["alice"] = 90
    scores["bob"] = 75
    assert_eq(score_of(scores, "alice"), 90)
    assert_eq(score_of(scores, "bob"), 75)

    print("type_alias_test passed")
