import forge_crypto

fn _hex(bl) -> string
    let h = "0123456789abcdef"
    let out = ""
    let i = 0
    while i < len(bl)
        let b = bl[i]
        out = out + char_at(h, (b >> 4) & 15) + char_at(h, b & 15)
        i = i + 1
    out

fn main()
    let pw = str_to_blist("password")
    let salt = str_to_blist("salt")
    // RFC-style PBKDF2-HMAC-SHA256 vectors (P="password", S="salt")
    assert_eq(_hex(pbkdf2_sha256_native(pw, salt, 1, 32)), "120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b")
    assert_eq(_hex(pbkdf2_sha256_native(pw, salt, 2, 32)), "ae4d0c95af6b46d32d0adff928f06dd02a303f8ef3c251dfd6e2d85a95474c43")
    // native == pure-NOVA (hashes interchangeable)
    assert_eq(_hex(pbkdf2_sha256_native(pw, salt, 100, 32)), _hex(pbkdf2_sha256(pw, salt, 100, 32)))
    // 100k iters must be FAST now (native) -- if this hangs, the native path failed
    assert_eq(len(pbkdf2_sha256_native(pw, salt, 100000, 32)), 32)
    print("pbkdf2_native_test passed")
