// KAT test for std/graph/boruvka_mst.
import std/graph/boruvka_mst

fn cki(name, got, want)
    if got != want
        print("FAIL " + name + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("ok " + name)

fn ckb(name, got, want)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + name + ": got " + str(gi) + " want " + str(wi))
        exit(1)
    print("ok " + name)

fn main()
    // -- KAT 1: 4-node cycle + chord
    // edges: [0,1,1],[1,2,2],[2,3,3],[3,0,4],[0,2,5]
    // MST: 0-1(1) + 1-2(2) + 2-3(3) = weight 6
    let e1 = []
    let e1a = []
    e1a.push(0)
    e1a.push(1)
    e1a.push(1)
    e1.push(e1a)
    let e1b = []
    e1b.push(1)
    e1b.push(2)
    e1b.push(2)
    e1.push(e1b)
    let e1c = []
    e1c.push(2)
    e1c.push(3)
    e1c.push(3)
    e1.push(e1c)
    let e1d = []
    e1d.push(3)
    e1d.push(0)
    e1d.push(4)
    e1.push(e1d)
    let e1e = []
    e1e.push(0)
    e1e.push(2)
    e1e.push(5)
    e1.push(e1e)

    cki("4node weight", bm_weight(4, e1), 6)
    cki("4node edge_count", bm_edge_count(4, e1), 3)
    ckb("4node connected", bm_is_connected(4, e1), true)

    // -- KAT 2: 3-node path 0-1-2
    // edges: [0,1,1],[1,2,2] -> MST weight = 3
    let e2 = []
    let e2a = []
    e2a.push(0)
    e2a.push(1)
    e2a.push(1)
    e2.push(e2a)
    let e2b = []
    e2b.push(1)
    e2b.push(2)
    e2b.push(2)
    e2.push(e2b)

    cki("3node weight", bm_weight(3, e2), 3)
    ckb("3node connected", bm_is_connected(3, e2), true)

    // -- KAT 3: disconnected (4 nodes, only 1 edge)
    let e3 = []
    let e3a = []
    e3a.push(0)
    e3a.push(1)
    e3a.push(1)
    e3.push(e3a)

    cki("disconnected weight", bm_weight(4, e3), -1)
    ckb("disconnected connected", bm_is_connected(4, e3), false)

    // -- KAT 4: single node, no edges
    cki("single node weight", bm_weight(1, []), 0)
    ckb("single node connected", bm_is_connected(1, []), true)

    // -- KAT 5: triangle (choose min 2 edges)
    // edges: [0,1,3],[1,2,1],[0,2,2] -> MST: 1-2(1) + 0-2(2) = 3
    let e5 = []
    let e5a = []
    e5a.push(0)
    e5a.push(1)
    e5a.push(3)
    e5.push(e5a)
    let e5b = []
    e5b.push(1)
    e5b.push(2)
    e5b.push(1)
    e5.push(e5b)
    let e5c = []
    e5c.push(0)
    e5c.push(2)
    e5c.push(2)
    e5.push(e5c)

    cki("triangle weight", bm_weight(3, e5), 3)
    cki("triangle edge_count", bm_edge_count(3, e5), 2)
    ckb("triangle connected", bm_is_connected(3, e5), true)

    // -- KAT 6: 2-node single edge
    let e6 = []
    let e6a = []
    e6a.push(0)
    e6a.push(1)
    e6a.push(7)
    e6.push(e6a)

    cki("2node weight", bm_weight(2, e6), 7)
    cki("2node edge_count", bm_edge_count(2, e6), 1)
    ckb("2node connected", bm_is_connected(2, e6), true)

    // -- KAT 7: self-loop only (2 nodes, no real edges)
    let e7 = []
    let e7a = []
    e7a.push(0)
    e7a.push(0)
    e7a.push(5)
    e7.push(e7a)

    cki("selfloop weight", bm_weight(2, e7), -1)
    ckb("selfloop connected", bm_is_connected(2, e7), false)

    // -- KAT 8: 5-node complete graph with varying weights
    // MST should pick lightest edges spanning all 5 nodes
    let e8 = []
    let e8a = []
    e8a.push(0)
    e8a.push(1)
    e8a.push(2)
    e8.push(e8a)
    let e8b = []
    e8b.push(0)
    e8b.push(2)
    e8b.push(3)
    e8.push(e8b)
    let e8c = []
    e8c.push(0)
    e8c.push(3)
    e8c.push(6)
    e8.push(e8c)
    let e8d = []
    e8d.push(0)
    e8d.push(4)
    e8d.push(9)
    e8.push(e8d)
    let e8e = []
    e8e.push(1)
    e8e.push(2)
    e8e.push(1)
    e8.push(e8e)
    let e8f = []
    e8f.push(1)
    e8f.push(3)
    e8f.push(4)
    e8.push(e8f)
    let e8g = []
    e8g.push(1)
    e8g.push(4)
    e8g.push(7)
    e8.push(e8g)
    let e8h = []
    e8h.push(2)
    e8h.push(3)
    e8h.push(5)
    e8.push(e8h)
    let e8i = []
    e8i.push(2)
    e8i.push(4)
    e8i.push(8)
    e8.push(e8i)
    let e8j = []
    e8j.push(3)
    e8j.push(4)
    e8j.push(10)
    e8.push(e8j)

    // MST: 1-2(1), 0-1(2), 0-2(3)... let's trace Boruvka:
    // Round 1: comp 0 cheapest=0-1(2), comp 1 cheapest=1-2(1), comp 2 cheapest=1-2(1), comp 3 cheapest=1-3(4), comp 4 cheapest=1-4(7)
    // Merges: {1-2}->wt1, {0-1}->wt2, {1-3}->wt4, {1-4}->wt7 => all in one component? No...
    // Actually Boruvka merges: 1-2(1), 0-1(2): now {0,1,2} component; 1-3(4): merge comp3 in; 1-4(7): merge comp4 in
    // Total = 1+2+4+7 = 14. Let me verify: MST of K5 above should be 1+2+3+4=10 (Kruskal: 1-2(1),0-1(2),0-2(3) SKIP (same comp),0-3(6)? wait...
    // Kruskal order: 1-2(1), 0-1(2), 0-2(3)-skip, 1-3(4), 0-3(6)-skip, 1-4(7) wait is that right?
    // After 1-2(1): {1,2},{0},{3},{4}. After 0-1(2): {0,1,2},{3},{4}. After 0-2(3)-skip. After 1-3(4): {0,1,2,3},{4}. After 0-3(6)-skip. After 1-4(7): {0,1,2,3,4}. Done. Total=1+2+4+7=14.
    cki("k5 weight", bm_weight(5, e8), 14)
    cki("k5 edge_count", bm_edge_count(5, e8), 4)
    ckb("k5 connected", bm_is_connected(5, e8), true)

    print("PASS _boruvka_mst_test")
