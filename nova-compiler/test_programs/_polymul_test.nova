import std/poly/polymul

fn list_eq(a, b) -> bool
    let la = len(a)
    let lb = len(b)
    if la != lb
        return false
    let i = 0
    while i < la
        if a[i] != b[i]
            return false
        i = i + 1
    true

fn ck_list(label, got, want)
    if list_eq(got, want) == false
        let gs = str(len(got))
        let ws = str(len(want))
        print("FAIL polymul " + label + ": len got=" + gs + " want=" + ws)
        exit(1)

fn ck_int(label, got, want)
    if got != want
        print("FAIL polymul " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // pm_mul: (1+x)^2 = 1 + 2x + x^2
    let a1 = [1, 1]
    let b1 = [1, 1]
    let r1 = pm_mul(a1, b1)
    let w1 = [1, 2, 1]
    ck_list("pm_mul (1+x)(1+x)=[1,2,1]", r1, w1)

    // pm_mul: (1-x)(1+x) = 1 - x^2
    let a2 = [1, -1]
    let b2 = [1, 1]
    let r2 = pm_mul(a2, b2)
    let w2 = [1, 0, -1]
    ck_list("pm_mul (1-x)(1+x)=[1,0,-1]", r2, w2)

    // pm_mul: constant * linear
    let a3 = [2]
    let b3 = [3, 4]
    let r3 = pm_mul(a3, b3)
    let w3 = [6, 8]
    ck_list("pm_mul [2]*[3,4]=[6,8]", r3, w3)

    // pm_power: (1+x)^3 = 1 + 3x + 3x^2 + x^3
    let p4 = [1, 1]
    let r4 = pm_power(p4, 3)
    let w4 = [1, 3, 3, 1]
    ck_list("pm_power [1,1]^3=[1,3,3,1]", r4, w4)

    // pm_power: p^0 = [1]
    let p5 = [1, 1]
    let r5 = pm_power(p5, 0)
    let w5 = [1]
    ck_list("pm_power [1,1]^0=[1]", r5, w5)

    // pm_square: (1+2x)^2 = 1 + 4x + 4x^2
    let p6 = [1, 2]
    let r6 = pm_square(p6)
    let w6 = [1, 4, 4]
    ck_list("pm_square [1,2]=[1,4,4]", r6, w6)

    // pm_mul: zero * anything = zero
    let a7 = []
    let b7 = [1, 2]
    let r7 = pm_mul(a7, b7)
    let w7 = []
    ck_list("pm_mul []*(p)=[]", r7, w7)

    // pm_mul: (1 + x^2)(1+x) = 1 + x + x^2 + x^3
    let a8 = [1, 0, 1]
    let b8 = [1, 1]
    let r8 = pm_mul(a8, b8)
    let w8 = [1, 1, 1, 1]
    ck_list("pm_mul [1,0,1]*[1,1]=[1,1,1,1]", r8, w8)

    // pm_multiply_all: product of [[1,1],[1,1],[1,1]] = (1+x)^3 = [1,3,3,1]
    let polys9 = [[1, 1], [1, 1], [1, 1]]
    let r9 = pm_multiply_all(polys9)
    let w9 = [1, 3, 3, 1]
    ck_list("pm_multiply_all 3x[1,1]=[1,3,3,1]", r9, w9)

    // pm_conv: alias for pm_mul
    let ac = [1, 2]
    let bc = [3, 4]
    let rc = pm_conv(ac, bc)
    let rm = pm_mul(ac, bc)
    ck_list("pm_conv==pm_mul", rc, rm)

    // pm_scale: scale by 0 -> zero poly
    let ps = [1, 2, 3]
    let rs = pm_scale(ps, 0)
    let rs_len = len(rs)
    ck_int("pm_scale by 0 == zero", rs_len, 0)

    // pm_scale: scale by 3
    let ps2 = [1, 2, 3]
    let rs2 = pm_scale(ps2, 3)
    let ws2 = [3, 6, 9]
    ck_list("pm_scale [1,2,3]*3=[3,6,9]", rs2, ws2)

    // pm_mul_monomial: [1,2]*2*x^2 = [0,0,2,4]
    let pm1 = [1, 2]
    let rm1 = pm_mul_monomial(pm1, 2, 2)
    let wm1 = [0, 0, 2, 4]
    ck_list("pm_mul_monomial [1,2]*2x^2=[0,0,2,4]", rm1, wm1)

    // pm_mul_monomial: c=0 -> zero
    let rm2 = pm_mul_monomial([1, 2], 0, 1)
    let rm2l = len(rm2)
    ck_int("pm_mul_monomial c=0 == zero", rm2l, 0)

    // pm_degree
    let pd1 = pm_degree([1, 0, 3])
    ck_int("pm_degree [1,0,3]==2", pd1, 2)
    let pd2 = pm_degree([])
    ck_int("pm_degree []==-1", pd2, -1)

    // pm_multiply_all empty list -> [1]
    let empty_polys = []
    let r_empty = pm_multiply_all(empty_polys)
    let w_empty = [1]
    ck_list("pm_multiply_all []=[1]", r_empty, w_empty)

    // pm_power of zero poly
    let pz = []
    let rz = pm_power(pz, 0)
    let wz = [1]
    ck_list("pm_power []^0=[1]", rz, wz)

    print("PASS _polymul_test")
