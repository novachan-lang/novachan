fn _echo_handle(client, done_ch)
    let data = tcp_recv(client)
    if len(data) > 0
        tcp_send(client, "ECHO:" + data)
    tcp_close(client)
    send(done_ch, 1)

fn _server(port, ready_ch, done_ch, count)
    let srv = tcp_listen(port)
    assert(srv >= 0, "listen failed")
    send(ready_ch, 1)
    let i = 0
    while i < count
        let client = tcp_accept(srv)
        if client >= 0
            let c = client
            let dc = done_ch
            sched_spawn(fn(z) _echo_handle(c, dc))
        i = i + 1
    tcp_close(srv)

fn _client(port, msg, result_ch)
    sleep(20)
    let sock = tcp_connect("127.0.0.1", port)
    if sock >= 0
        tcp_send(sock, msg)
        let resp = tcp_recv(sock)
        tcp_close(sock)
        send(result_ch, resp)
    else
        send(result_ch, "FAIL")

fn _test1(z)
    let port = 18930
    let ready_ch = channel()
    let done_ch = channel()
    let result_ch = channel()
    let n = 3
    let p = port
    let rch = ready_ch
    let dch = done_ch
    sched_spawn(fn(z) _server(p, rch, dch, n))
    recv(ready_ch)
    let i = 0
    while i < n
        let msg = "hello" + str(i)
        let pp = port
        let rc = result_ch
        sched_spawn(fn(z) _client(pp, msg, rc))
        i = i + 1
    let j = 0
    while j < n
        let resp = recv(result_ch)
        assert(starts_with(str(resp), "ECHO:"), "got echo: " + str(resp))
        j = j + 1
    let k = 0
    while k < n
        recv(done_ch)
        k = k + 1
    print("  green netpoll echo: PASS")

fn _server2(port, ready_ch, n)
    let srv = tcp_listen(port)
    assert(srv >= 0, "listen2 failed")
    send(ready_ch, 1)
    let i = 0
    while i < n
        let client = tcp_accept(srv)
        if client >= 0
            let data = tcp_recv(client)
            tcp_send(client, "OK:" + str(len(data)))
            tcp_close(client)
        i = i + 1
    tcp_close(srv)

fn _client2(port, result_ch)
    sleep(10)
    let s = tcp_connect("127.0.0.1", port)
    if s >= 0
        tcp_send(s, "data")
        let r = tcp_recv(s)
        tcp_close(s)
        send(result_ch, r)
    else
        send(result_ch, "FAIL")

fn _test2(z)
    let port = 18931
    let ready_ch = channel()
    let result_ch = channel()
    let n = 5
    let p = port
    let rch = ready_ch
    sched_spawn(fn(z) _server2(p, rch, n))
    recv(ready_ch)
    let i = 0
    while i < n
        let pp = port
        let rc = result_ch
        sched_spawn(fn(z) _client2(pp, rc))
        i = i + 1
    let received = 0
    while received < n
        let r = recv(result_ch)
        assert(starts_with(str(r), "OK:"), "concurrent accept: " + str(r))
        received = received + 1
    print("  concurrent accepts: PASS")

fn main()
    sched_spawn(fn(z) _test1(z))
    sched_run()
    sched_spawn(fn(z) _test2(z))
    sched_run()
    print("green_netpoll_test: all passed")
