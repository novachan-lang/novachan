import forge_lorem

fn tf(b: bool) -> string
    if b
        return "T"
    "F"

fn main()
    print("w3=" + tf(lorem_words(3) == "lorem ipsum dolor"))
    print("w0=" + tf(lorem_words(0) == ""))
    print("w_deterministic=" + tf(lorem_words(5) == lorem_words(5)))
    let s = lorem_sentence(4)
    print("sent=" + tf(s == "Lorem ipsum dolor sit."))
    print("sent_cap=" + tf(starts_with(s, "Lorem")))
    print("sent_period=" + tf(ends_with(s, ".")))
    let p = lorem_paragraph(2)
    print("para_two=" + tf(find(p, ". ") >= 0))
    print("para_ends=" + tf(ends_with(p, ".")))
    // cycling past pool length works (n > 46)
    print("cycle=" + tf(len(lorem_words(100)) > 0))
