import forge_interval

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name + ": expected true")
    1

fn expect_false(name: string, cond: bool) -> int
    if cond
        print("FAIL " + name + ": expected false")
        return 1
    0

// stringify a list of [s,e] as "s-e,s-e"
fn iv_str(ivs: list) -> string
    let parts = []
    let i = 0
    while i < len(ivs)
        push(parts, str(ivs[i][0]) + "-" + str(ivs[i][1]))
        i = i + 1
    join(parts, ",")

fn main()
    let fails = 0

    // overlaps
    fails = fails + expect_true("ov1", interval_overlaps([1, 5], [3, 8]))
    fails = fails + expect_false("ov2", interval_overlaps([1, 3], [5, 8]))
    fails = fails + expect_true("ov_touch", interval_overlaps([1, 3], [3, 5]))

    // contains
    fails = fails + expect_true("c_mid", interval_contains([1, 10], 5))
    fails = fails + expect_true("c_end", interval_contains([1, 10], 10))
    fails = fails + expect_false("c_out", interval_contains([1, 10], 11))

    // intersect
    fails = fails + expect("is1", iv_str([interval_intersect([1, 5], [3, 8])]), "3-5")
    fails = fails + expect_true("is_none", interval_intersect([1, 3], [5, 8]) == null)

    // merge (sorted, unsorted, touching, empty)
    fails = fails + expect("mg1", iv_str(interval_merge([[1, 3], [2, 6], [8, 10], [15, 18]])), "1-6,8-10,15-18")
    fails = fails + expect("mg_unsorted", iv_str(interval_merge([[8, 10], [1, 3], [2, 6]])), "1-6,8-10")
    fails = fails + expect("mg_touch", iv_str(interval_merge([[1, 3], [3, 5]])), "1-5")
    fails = fails + expect("mg_empty", iv_str(interval_merge([])), "")
    fails = fails + expect("mg_single", iv_str(interval_merge([[4, 9]])), "4-9")

    // insert
    fails = fails + expect("ins_gap", iv_str(interval_insert([[1, 3], [12, 15]], [5, 9])), "1-3,5-9,12-15")
    fails = fails + expect("ins_merge", iv_str(interval_insert([[1, 3], [7, 9]], [2, 5])), "1-5,7-9")

    // total coverage
    fails = fails + expect("cov_disjoint", str(interval_total_coverage([[1, 3], [5, 7]])), "6")
    fails = fails + expect("cov_overlap", str(interval_total_coverage([[1, 5], [2, 6]])), "6")

    // gaps
    fails = fails + expect("gap1", iv_str(interval_gaps([[2, 4], [7, 8]], 0, 10)), "0-1,5-6,9-10")
    fails = fails + expect("gap_full", iv_str(interval_gaps([[0, 10]], 0, 10)), "")
    fails = fails + expect("gap_none", iv_str(interval_gaps([], 0, 5)), "0-5")
    fails = fails + expect("gap_edge", iv_str(interval_gaps([[3, 6]], 0, 10)), "0-2,7-10")

    if fails == 0
        print("forge_interval: all passed")
    else
        print("forge_interval: " + str(fails) + " FAILED")
