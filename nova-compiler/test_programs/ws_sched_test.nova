fn test_ws_init_shutdown()
  let n = ws_init(4)
  assert(n == 4, "ws_init(4) returns 4: " + str(n))
  sleep(50)
  ws_shutdown()
  print("  init/shutdown: PASS")

fn test_ws_spawn_tasks()
  ws_init(2)
  let ch = channel()
  let count = 10

  let i = 0
  while i < count
    let c = ch
    spawn
      sleep(10)
      send(c, 1)
    i = i + 1

  let received = 0
  while received < count
    recv(ch)
    received = received + 1

  assert(received == count, "received all: " + str(received))
  ws_shutdown()
  print("  spawn tasks: PASS")

fn test_ws_parallel_sum()
  ws_init(4)
  let ch = channel()
  let n = 100

  let i = 0
  while i < n
    let val = i
    let c = ch
    spawn
      send(c, val)
    i = i + 1

  let total = 0
  let j = 0
  while j < n
    let v = recv(ch)
    total = total + v
    j = j + 1

  let expected = n * (n - 1) / 2
  assert(total == expected, "sum 0..99 = " + str(expected) + ": " + str(total))
  ws_shutdown()
  print("  parallel sum: PASS")

fn main()
  test_ws_init_shutdown()
  test_ws_spawn_tasks()
  test_ws_parallel_sum()
  print("ws_sched_test: all passed")
