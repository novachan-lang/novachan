import std/sketch/quotientfilter

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // KAT 1: qf_new(8) creates 256 slots.
    let qf = qf_new(8)
    cki("slots", qf["slots"], 256)
    cki("q", qf["q"], 8)
    cki("count_init", qf_count(qf), 0)

    // KAT 2: INVARIANT — no false negatives. Add three items, all must be present.
    qf_add(qf, "alpha")
    qf_add(qf, "beta")
    qf_add(qf, "gamma")

    if qf_contains(qf, "alpha") == false
        print("FAIL no_false_neg_alpha: alpha must be present after add")
        exit(1)
    if qf_contains(qf, "beta") == false
        print("FAIL no_false_neg_beta: beta must be present after add")
        exit(1)
    if qf_contains(qf, "gamma") == false
        print("FAIL no_false_neg_gamma: gamma must be present after add")
        exit(1)

    // KAT 3: count == 3 after three distinct adds.
    cki("count_after_3", qf_count(qf), 3)

    // KAT 4: qf_may_contain is an alias for qf_contains (must agree).
    if qf_may_contain(qf, "alpha") == false
        print("FAIL may_contain_alpha")
        exit(1)
    if qf_may_contain(qf, "beta") == false
        print("FAIL may_contain_beta")
        exit(1)

    // KAT 5: load factor = 3 / 256 after 3 inserts into a 256-slot filter.
    let lf = qf_load_factor(qf)
    if lf <= 0.0
        print("FAIL load_factor_zero: got=" + str(lf))
        exit(1)
    if lf >= 1.0
        print("FAIL load_factor_full: got=" + str(lf))
        exit(1)

    // KAT 6: qf_fingerprint is deterministic.
    let fp1 = qf_fingerprint("alpha", 8, 8)
    let fp2 = qf_fingerprint("alpha", 8, 8)
    cki("fp_determinism_quo", fp1[0], fp2[0])
    cki("fp_determinism_rem", fp1[1], fp2[1])

    // KAT 7: Two filters with the same adds agree on all queries.
    let qf2 = qf_new(8)
    qf_add(qf2, "alpha")
    qf_add(qf2, "beta")
    qf_add(qf2, "gamma")
    if qf_contains(qf2, "alpha") == false
        print("FAIL qf2_alpha")
        exit(1)
    if qf_contains(qf2, "beta") == false
        print("FAIL qf2_beta")
        exit(1)
    if qf_contains(qf2, "gamma") == false
        print("FAIL qf2_gamma")
        exit(1)
    cki("qf2_count", qf_count(qf2), 3)

    // KAT 8: Add more items to stress the no-false-negatives invariant.
    let items = ["apple", "banana", "cherry", "date", "elderberry", "fig", "grape", "honeydew"]
    let qf3 = qf_new(8)
    let idx = 0
    while idx < 8
        qf_add(qf3, items[idx])
        idx = idx + 1
    // All must be present.
    let idx2 = 0
    while idx2 < 8
        if qf_contains(qf3, items[idx2]) == false
            print("FAIL no_false_neg_stress: " + items[idx2])
            exit(1)
        idx2 = idx2 + 1
    cki("stress_count", qf_count(qf3), 8)

    // KAT 9: qf_quotient and qf_remainder functions are deterministic.
    let h63val = 123456789
    let quo_val = qf_quotient(h63val, 8)
    let rem_val = qf_remainder(h63val, 8, 8)
    // Quotient must be in [0, 255], remainder in [0, 255].
    if quo_val < 0 or quo_val > 255
        print("FAIL quo_range: got=" + str(quo_val))
        exit(1)
    if rem_val < 0 or rem_val > 255
        print("FAIL rem_range: got=" + str(rem_val))
        exit(1)

    print("PASS _quotientfilter_test")

main()
