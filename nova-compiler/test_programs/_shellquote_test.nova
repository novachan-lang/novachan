// KAT for std/text/shellquote -- POSIX shell single-quote quoting.
import std/text/shellquote

fn cks(label, got, expected)
    if got == expected
        return 0
    print("FAIL " + label + ": got=" + got + " expected=" + expected)
    exit(1)
    return 1

fn ckb(label, got, expected)
    if got == expected
        return 0
    let gs = "false"
    if got
        gs = "true"
    let es = "false"
    if expected
        es = "true"
    print("FAIL " + label + ": got=" + gs + " expected=" + es)
    exit(1)
    return 1

fn main()
    let dq = chr(34)

    // KAT 1: safe word returned unchanged
    cks("sq_quote_safe", sq_quote("hello"), "hello")

    // KAT 2: empty string -> ''
    cks("sq_quote_empty", sq_quote(""), "''")

    // KAT 3: string with space -> single-quoted
    cks("sq_quote_space", sq_quote("a b"), "'a b'")

    // KAT 4: string with single-quote -> '"'"' escaping
    // it's  =>  'it'"'"'s'
    let expected_its = "'it'" + dq + "'" + dq + "'s'"
    cks("sq_quote_apostrophe", sq_quote("it's"), expected_its)

    // KAT 5: sq_needs_quoting safe name
    ckb("needs_quoting_safe", sq_needs_quoting("safe_name-1.2"), false)

    // KAT 6: sq_needs_quoting space
    ckb("needs_quoting_space", sq_needs_quoting("a b"), true)

    // KAT 7: sq_quote_list
    let args = ["a", "b c"]
    cks("sq_quote_list", sq_quote_list(args), "a 'b c'")

    print("_shellquote_test passed")
