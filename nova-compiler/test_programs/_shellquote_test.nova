// KAT for std/os/shellquote -- POSIX shell quoting utilities.
import std/os/shellquote

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL shellquote " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL shellquote " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn list_eq(a: any, b: any) -> bool
    if len(a) != len(b)
        return false
    let i = 0
    while i < len(a)
        if a[i] != b[i]
            return false
        i = i + 1
    return true

fn main()
    // KAT 1: safe string returned unquoted
    cks("safe_abc", sh_quote("abc"), "abc")

    // KAT 2: safe path chars unquoted
    cks("safe_path", sh_quote("foo/bar.baz"), "foo/bar.baz")

    // KAT 3: safe dash+underscore unquoted
    cks("safe_dash", sh_quote("my-file_1"), "my-file_1")

    // KAT 4: string with space gets single-quoted
    cks("space", sh_quote("a b"), "'a b'")

    // KAT 5: empty string -> ''
    cks("empty", sh_quote(""), "''")

    // KAT 6: string with single quote -> '\''  escaping
    // it's  ->  'it'\''s'
    cks("squote", sh_quote("it's"), "'it'\\''s'")

    // KAT 7: sh_quote_list
    let args = []
    push(args, "a")
    push(args, "b c")
    let ql = sh_quote_list(args)
    cks("quote_list", ql, "a 'b c'")

    // KAT 8: sh_split basic — "a 'b c' d" -> ["a","b c","d"]
    let sp1 = sh_split("a 'b c' d")
    let want1 = []
    push(want1, "a")
    push(want1, "b c")
    push(want1, "d")
    if not list_eq(sp1, want1)
        print("FAIL shellquote sh_split basic: got len=" + str(len(sp1)))
        exit(1)

    // KAT 9: sh_split single word
    let sp2 = sh_split("x")
    let want2 = []
    push(want2, "x")
    if not list_eq(sp2, want2)
        print("FAIL shellquote sh_split single: got len=" + str(len(sp2)))
        exit(1)

    // KAT 10: sh_split empty
    let sp3 = sh_split("")
    cki("sh_split_empty_len", len(sp3), 0)

    print("PASS _shellquote_test")
