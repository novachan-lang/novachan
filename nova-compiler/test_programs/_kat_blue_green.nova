import forge_blue_green

fn main()
    let bg = bg_new()
    assert(bg_active_env(bg) == "blue", "starts blue")
    assert(bg_inactive_env(bg) == "green", "inactive green")

    bg = bg_deploy(bg, "blue", "v1.0")
    bg = bg_deploy(bg, "green", "v2.0")
    assert(bg_active_version(bg) == "v1.0", "blue is v1.0")

    bg = bg_swap(bg)
    assert(bg_active_env(bg) == "green", "swapped to green")
    assert(bg_active_version(bg) == "v2.0", "green is v2.0")
    assert(bg_inactive_env(bg) == "blue", "blue inactive")
    assert(bg_swap_count(bg) == 1, "1 swap")

    bg = bg_rollback(bg)
    assert(bg_active_env(bg) == "blue", "rolled back to blue")
    assert(bg_active_version(bg) == "v1.0", "back to v1.0")
    assert(bg_swap_count(bg) == 2, "2 swaps")

    bg = bg_set_health(bg, "green", 0)
    assert(bg_is_healthy(bg, "green") == 0, "green unhealthy")
    assert(bg_is_healthy(bg, "blue") == 1, "blue healthy")

    bg = bg_set_health(bg, "green", 1)
    assert(bg_is_healthy(bg, "green") == 1, "green recovered")

    assert(bg_history_count(bg) == 4, "4 history entries")
    assert(bg_is_healthy(bg, "other") == 0, "unknown env = 0")

    print("BLUE-GREEN KAT PASS")
