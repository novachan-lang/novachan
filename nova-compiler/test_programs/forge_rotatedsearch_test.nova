import forge_rotatedsearch

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

// brute-force index of target
fn brute(arr: list, t: int) -> int
    let i = 0
    while i < len(arr)
        if arr[i] == t
            return i
        i = i + 1
    0 - 1

fn main()
    let fails = 0

    let a = [4, 5, 6, 7, 0, 1, 2]
    fails = fails + expect("s0", str(search_rotated(a, 0)), "4")
    fails = fails + expect("s6", str(search_rotated(a, 6)), "2")
    fails = fails + expect("s4", str(search_rotated(a, 4)), "0")
    fails = fails + expect("s2", str(search_rotated(a, 2)), "6")
    fails = fails + expect("s_absent", str(search_rotated(a, 3)), "-1")

    // rotation point + min
    fails = fails + expect("rp", str(find_rotation_point(a)), "4")
    fails = fails + expect("rp_none", str(find_rotation_point([1, 2, 3, 4])), "0")
    fails = fails + expect("min1", str(find_min_rotated(a)), "0")
    fails = fails + expect("min2", str(find_min_rotated([3, 4, 5, 1, 2])), "1")
    fails = fails + expect("min_sorted", str(find_min_rotated([1, 2, 3])), "1")

    // exhaustive: for every rotation of a sorted array, search every element and a couple absent values
    let base = [1, 3, 5, 7, 9, 11, 13]
    let ok = 1
    let rot = 0
    while rot < len(base)
        // build the rotation
        let arr = []
        let k = 0
        while k < len(base)
            push(arr, base[(rot + k) % len(base)])
            k = k + 1
        // search each element -> must find it (index matches brute)
        let e = 0
        while e < len(base)
            if search_rotated(arr, base[e]) != brute(arr, base[e])
                ok = 0
            e = e + 1
        // absent values
        if search_rotated(arr, 0) != 0 - 1
            ok = 0
        if search_rotated(arr, 100) != 0 - 1
            ok = 0
        // min is always 1
        if find_min_rotated(arr) != 1
            ok = 0
        rot = rot + 1
    fails = fails + expect("exhaustive_rotations", str(ok), "1")

    // single element
    fails = fails + expect("single", str(search_rotated([5], 5)), "0")
    fails = fails + expect("single_no", str(search_rotated([5], 3)), "-1")

    if fails == 0
        print("forge_rotatedsearch: all passed")
    else
        print("forge_rotatedsearch: " + str(fails) + " FAILED")
