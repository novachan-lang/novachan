// KAT for std/bio/seq — DNA/RNA sequence basics.
// All reference values verified against standard bioinformatics definitions.
import std/bio/seq

// cks — check string equality.
fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

// cki — check int equality.
fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb — check bool equality.
fn ckb(label, got, want)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
        exit(1)

// ckf — check float within tolerance.
fn ckf(label, got, want, tol)
    let diff = got - want
    if diff < 0.0
        diff = 0.0 - diff
    if diff >= tol
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── seq_validate ────────────────────────────────────────────────────────
    ckb("validate_valid",    seq_validate("ATGC"),   true)
    ckb("validate_atgc",     seq_validate("AATTGGCC"), true)
    ckb("validate_invalid",  seq_validate("ATBX"),   false)
    ckb("validate_rna_in_dna", seq_validate("AUGC"), false)
    ckb("validate_empty",    seq_validate(""),        true)

    // ── seq_validate_rna ─────────────────────────────────────────────────────
    ckb("validate_rna_valid",   seq_validate_rna("AUGC"),   true)
    ckb("validate_rna_invalid", seq_validate_rna("ATGC"),   false)
    ckb("validate_rna_empty",   seq_validate_rna(""),       true)

    // ── seq_complement ───────────────────────────────────────────────────────
    cks("complement_atgc",   seq_complement("ATGC"),   "TACG")
    cks("complement_empty",  seq_complement(""),       "")
    cks("complement_aaaa",   seq_complement("AAAA"),   "TTTT")
    cks("complement_ccgg",   seq_complement("CCGG"),   "GGCC")

    // ── seq_reverse ──────────────────────────────────────────────────────────
    cks("reverse_atgc",      seq_reverse("ATGC"),     "CGTA")
    cks("reverse_empty",     seq_reverse(""),          "")
    cks("reverse_single",    seq_reverse("A"),         "A")

    // ── seq_reverse_complement ────────────────────────────────────────────────
    cks("revcomp_atgc",      seq_reverse_complement("ATGC"),  "GCAT")
    cks("revcomp_aaa",       seq_reverse_complement("AAA"),   "TTT")
    cks("revcomp_empty",     seq_reverse_complement(""),      "")

    // ── seq_transcribe ────────────────────────────────────────────────────────
    cks("transcribe_atgc",   seq_transcribe("ATGC"),   "AUGC")
    cks("transcribe_tttt",   seq_transcribe("TTTT"),   "UUUU")
    cks("transcribe_empty",  seq_transcribe(""),        "")
    cks("transcribe_no_t",   seq_transcribe("AAGC"),   "AAGC")

    // ── seq_back_transcribe ────────────────────────────────────────────────────
    cks("btranscribe_augc",  seq_back_transcribe("AUGC"),   "ATGC")
    cks("btranscribe_uuuu",  seq_back_transcribe("UUUU"),   "TTTT")
    cks("btranscribe_empty", seq_back_transcribe(""),        "")

    // ── seq_gc_content ────────────────────────────────────────────────────────
    ckf("gc_ggcc",  seq_gc_content("GGCC"),  1.0,  0.001)
    ckf("gc_atat",  seq_gc_content("ATAT"),  0.0,  0.001)
    ckf("gc_atgc",  seq_gc_content("ATGC"),  0.5,  0.001)
    ckf("gc_empty", seq_gc_content(""),      0.0,  0.001)

    // ── seq_at_content ────────────────────────────────────────────────────────
    ckf("at_atat",  seq_at_content("ATAT"),  1.0,  0.001)
    ckf("at_ggcc",  seq_at_content("GGCC"),  0.0,  0.001)
    ckf("at_atgc",  seq_at_content("ATGC"),  0.5,  0.001)
    ckf("at_empty", seq_at_content(""),      0.0,  0.001)

    // ── seq_base_count ────────────────────────────────────────────────────────
    cki("base_count_A_2",    seq_base_count("AATTGG", "A"),  2)
    cki("base_count_T_2",    seq_base_count("AATTGG", "T"),  2)
    cki("base_count_G_2",    seq_base_count("AATTGG", "G"),  2)
    cki("base_count_C_0",    seq_base_count("AATTGG", "C"),  0)
    cki("base_count_empty",  seq_base_count("", "A"),         0)

    // ── seq_base_freq ─────────────────────────────────────────────────────────
    let freq = seq_base_freq("AATTGG")
    cki("base_freq_A",  freq["A"],  2)
    cki("base_freq_T",  freq["T"],  2)
    cki("base_freq_G",  freq["G"],  2)

    // ── seq_hamming ───────────────────────────────────────────────────────────
    cki("hamming_1",        seq_hamming("ATGC", "ATGG"),  1)
    cki("hamming_0",        seq_hamming("ATGC", "ATGC"),  0)
    cki("hamming_all",      seq_hamming("AAAA", "TTTT"),  4)
    cki("hamming_unequal",  seq_hamming("ATG",  "ATGC"), -1)
    cki("hamming_empty",    seq_hamming("", ""),           0)

    // ── seq_shannon_entropy ────────────────────────────────────────────────────
    // Uniform 4-base: H = 2 bits exactly.
    ckf("entropy_uniform", seq_shannon_entropy("ACGT"), 2.0, 0.001)
    // Single base: entropy = 0.
    ckf("entropy_single",  seq_shannon_entropy("AAAA"), 0.0, 0.001)
    // Empty: entropy = 0.
    ckf("entropy_empty",   seq_shannon_entropy(""),     0.0, 0.001)
    // 50/50 A/T: H = 1 bit.
    ckf("entropy_50_50",   seq_shannon_entropy("ATAT"), 1.0, 0.001)

    print("PASS _seq_test")
