import std/collections/union_find

fn cki(got, expected, label)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn ckb(got, expected, label)
    let gi = 0
    let ei = 0
    if got
        gi = 1
    if expected
        ei = 1
    if gi != ei
        print("FAIL " + label + ": got " + str(gi) + " expected " + str(ei))
        exit(1)

fn main()
    // --- KAT: spec scenario ---
    let uf = uf_make(5)
    uf_union(uf, 0, 1)
    uf_union(uf, 1, 2)
    cki(uf_connected(uf, 0, 2), 1, "connected(0,2)=true")
    cki(uf_connected(uf, 0, 3), 0, "connected(0,3)=false")
    cki(uf_count(uf), 3, "count=3")
    cki(uf_set_size(uf, 0), 3, "set_size(0)=3")
    cki(uf_union(uf, 0, 2), 0, "union(0,2)=false already same")

    // --- extra edge-case checks ---
    // count should still be 3 (no-op union)
    cki(uf_count(uf), 3, "count still 3 after no-op union")
    // element 3 and 4 are still separate singletons
    cki(uf_set_size(uf, 3), 1, "set_size(3)=1")
    cki(uf_set_size(uf, 4), 1, "set_size(4)=1")

    // union 3 and 4; count drops to 2
    uf_union(uf, 3, 4)
    cki(uf_count(uf), 2, "count=2 after union(3,4)")
    cki(uf_set_size(uf, 3), 2, "set_size(3)=2")

    // --- single element ---
    let uf1 = uf_make(1)
    cki(uf_count(uf1), 1, "single count=1")
    cki(uf_find(uf1, 0), 0, "single find=0")
    cki(uf_set_size(uf1, 0), 1, "single set_size=1")
    cki(uf_connected(uf1, 0, 0), 1, "element connected to itself")

    // --- path compression stress: chain 0-1-2-3-4-5 ---
    let uf2 = uf_make(6)
    uf_union(uf2, 0, 1)
    uf_union(uf2, 1, 2)
    uf_union(uf2, 2, 3)
    uf_union(uf2, 3, 4)
    uf_union(uf2, 4, 5)
    cki(uf_count(uf2), 1, "chain: all one set")
    cki(uf_set_size(uf2, 0), 6, "chain: set_size=6")
    cki(uf_find(uf2, 5), uf_find(uf2, 0), "chain: find(5)==find(0)")
    cki(uf_connected(uf2, 0, 5), 1, "chain: 0 and 5 connected")

    print("PASS _union_find_test")

main()
