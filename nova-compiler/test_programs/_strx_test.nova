import std/text/strx

// _ck_s — check string equality.
fn _ck_s(label: string, got: string, want: string)
    if got != want
        print("FAIL strx " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

// _ck_i — check integer equality.
fn _ck_i(label: string, got: int, want: int)
    if got != want
        print("FAIL strx " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ---- capitalize: first letter upper, rest lower ----
    _ck_s("capitalize_mixed", capitalize("heLLO"), "Hello")
    _ck_s("capitalize_lower", capitalize("hello"), "Hello")
    _ck_s("capitalize_empty", capitalize(""), "")
    _ck_s("capitalize_nonletter_first", capitalize("123abc"), "123abc")

    // ---- title_case: capitalize each space-separated word ----
    _ck_s("title_case_basic", title_case("hello world"), "Hello World")
    _ck_s("title_case_mixed_case", title_case("the quick brown FOX"), "The Quick Brown Fox")

    // ---- str_upper_ascii / str_lower_ascii ----
    _ck_s("upper_ascii", str_upper_ascii("aB3"), "AB3")
    _ck_s("upper_ascii_punct", str_upper_ascii("a.b.c"), "A.B.C")
    _ck_s("lower_ascii", str_lower_ascii("aB3"), "ab3")

    // ---- count_substr: NON-overlapping, scan resumes past the match ----
    _ck_i("count_substr_aaaa_aa", count_substr("aaaa", "aa"), 2)
    _ck_i("count_substr_aaa_aa", count_substr("aaa", "aa"), 1)
    _ck_i("count_substr_absent", count_substr("hello", "z"), 0)
    _ck_i("count_substr_empty_haystack", count_substr("", "a"), 0)

    // ---- replace_all: non-overlapping, left to right ----
    _ck_s("replace_all_expand", replace_all("aaa", "a", "bb"), "bbbbbb")
    _ck_s("replace_all_basic", replace_all("a.b.c", ".", "-"), "a-b-c")
    _ck_s("replace_all_no_match", replace_all("hello", "z", "Z"), "hello")
    _ck_s("replace_all_delete", replace_all("xxx", "x", ""), "")

    // ---- str_count_char: single-byte occurrence count ----
    _ck_i("str_count_char_basic", str_count_char("hello", "l"), 2)
    _ck_i("str_count_char_notfound", str_count_char("hello", "z"), 0)
    _ck_i("str_count_char_multibyte_arg", str_count_char("hello", "ll"), 0)

    // ---- levenshtein: classic edit-distance oracle ----
    _ck_i("levenshtein_kitten_sitting", levenshtein("kitten", "sitting"), 3)
    _ck_i("levenshtein_same", levenshtein("abc", "abc"), 0)
    _ck_i("levenshtein_empty", levenshtein("", "abc"), 3)

    print("PASS _strx_test")
