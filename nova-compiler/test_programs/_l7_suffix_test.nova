// L7 increment 1: sized-numeric literal suffixes (lex + range-check, base-type value)
fn main()
    let a = 255u8
    let b = 1000u16
    let c = 1.5f32
    let d = 42i32
    let e = 100u64
    let f = 7i8
    if a != 255
        print("FAIL u8")
        exit(1)
    if b != 1000
        print("FAIL u16")
        exit(1)
    if c < 1.4 or c > 1.6
        print("FAIL f32")
        exit(1)
    if d != 42
        print("FAIL i32")
        exit(1)
    if e != 100
        print("FAIL u64")
        exit(1)
    if f != 7
        print("FAIL i8")
        exit(1)
    if 255 != 255
        print("FAIL plain")
        exit(1)
    let g = 10u8 + 5u8
    if g != 15
        print("FAIL expr")
        exit(1)
    print("PASS _l7_suffix_test")
