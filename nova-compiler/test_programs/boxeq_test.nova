// boxeq_test — boxed-scalar (float/bool) equality + hashing consistency.
// Floats/bools are heap-boxed when stored in lists/dicts via push/index-set, but
// kept raw in literals. nova_rt_eq/hash now unbox first, so equal values compare
// and hash equal regardless of representation. (Regression guard for a real
// silent-correctness bug: [1.5,2.5] == [1.5,2.5] used to be false.)

fn main()
    // --- float list equality across build methods ---
    let a = []
    push(a, 1.5)
    push(a, 2.5)
    assert_eq(a, [1.5, 2.5])              // push-built == literal (mixed rep)
    assert_eq([1.5, 2.5], [1.5, 2.5])    // literal == literal
    let b = []
    push(b, 1.5)
    push(b, 2.5)
    assert_eq(a, b)                       // push == push

    // inequality still distinguishes
    assert(a != [1.5, 2.6], "distinct floats stay unequal")
    assert(a != [1.5], "different length stays unequal")

    // --- dict with boxed float values ---
    let d1 = {}
    d1["x"] = 1.5
    d1["y"] = 2.5
    assert_eq(d1, {"x": 1.5, "y": 2.5})

    // --- nested: list of float lists ---
    let nested = []
    push(nested, [1.5, 2.5])
    assert_eq(nested, [[1.5, 2.5]])

    // --- contains / index_of over boxed floats (route through eq) ---
    assert(contains(a, 2.5), "contains finds boxed float")
    assert_eq(index_of(a, 2.5), 1)

    // --- boxed bool (bbox) equality ---
    let bl = []
    push(bl, true)
    push(bl, false)
    assert_eq(bl, [true, false])
    assert(contains(bl, true), "contains finds boxed bool")

    // --- regression: int/string/struct equality unaffected by the unbox no-op ---
    assert_eq([1, 2, 3], [1, 2, 3])
    let big = []
    push(big, 1000000000000000000)
    assert_eq(big, [1000000000000000000])
    assert_eq("abc", "abc")
    assert_eq({"k": 1}, {"k": 1})

    print("boxeq_test passed")
