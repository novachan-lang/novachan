// KAT for std/text/shlex -- shell-style word splitting.
import std/text/shlex

// Compare a list of strings element-by-element; exit(1) on any mismatch.
fn _leq(label: string, got: any, want: any)
    if len(got) != len(want)
        print("FAIL " + label + ": len " + str(len(got)) + " != " + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL " + label + " [" + str(i) + "]: '" + got[i] + "' != '" + want[i] + "'")
            exit(1)
        i = i + 1

fn main()
    // Byte constants for characters that cannot be embedded directly.
    let dq = chr(34)
    let sq = chr(39)
    let bs = chr(92)

    // KAT 1: double-quoted group with interior space.
    // Input:  a "b c" d
    _leq("dquote_group", sh_split("a " + dq + "b c" + dq + " d"), ["a", "b c", "d"])

    // KAT 2: single-quoted group with interior space.
    // Input:  x 'y z'
    _leq("squote_group", sh_split("x " + sq + "y z" + sq), ["x", "y z"])

    // KAT 3: backslash-escaped space outside quotes -> single token "a b".
    // Input:  a\ b  (a, backslash, space, b)
    _leq("backslash_space", sh_split("a" + bs + " b"), ["a b"])

    // KAT 4: multiple leading/trailing/interior spaces collapse; only real tokens kept.
    _leq("multi_space", sh_split("  spaced  out "), ["spaced", "out"])

    // KAT 5: adjacent quoted+unquoted parts fuse into one token.
    // Input:  "mixed"plain   ->  ["mixedplain"]
    _leq("fuse_adjacent", sh_split(dq + "mixed" + dq + "plain"), ["mixedplain"])

    // KAT 6: empty string -> empty list.
    _leq("empty", sh_split(""), [])

    // Extra assertions for robustness.

    // Single token, no quotes.
    _leq("single_word", sh_split("hello"), ["hello"])

    // Two plain words.
    _leq("two_words", sh_split("hello world"), ["hello", "world"])

    // Leading and trailing whitespace only -> empty list.
    _leq("only_spaces", sh_split("   "), [])

    // Backslash escapes a double-quote character outside quotes.
    // Input:  a\"b  (a, backslash, dquote, b) -> token "a\"b"
    _leq("backslash_dq", sh_split("a" + bs + dq + "b"), ["a" + dq + "b"])

    // Single-quoted string containing a backslash: backslash is NOT special inside single quotes.
    // Input:  'a\b'  ->  ["a\b"]
    _leq("sq_literal_bs", sh_split(sq + "a" + bs + "b" + sq), ["a" + bs + "b"])

    // Double-quoted group preserves spaces and adjacent unquoted text fuses.
    // Input: say "hello world" now
    _leq("dq_in_middle", sh_split("say " + dq + "hello world" + dq + " now"), ["say", "hello world", "now"])

    // Empty single-quoted string produces a single empty-string token (not zero tokens).
    _leq("empty_sq", sh_split(sq + sq), [""])

    // Empty double-quoted string produces a single empty-string token.
    _leq("empty_dq", sh_split(dq + dq), [""])

    print("_shlex_test passed")
