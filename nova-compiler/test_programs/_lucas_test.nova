// _lucas_test.nova — KAT for std/math/lucas
import std/math/lucas

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + " got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + " got=" + got + " want=" + want)
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        print("FAIL " + label + " got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // KAT 1: luc(0) == 2
    cki("luc(0)", luc(0), 2)

    // KAT 2: luc(1) == 1
    cki("luc(1)", luc(1), 1)

    // KAT 3: luc(2) == 3  (2+1)
    cki("luc(2)", luc(2), 3)

    // KAT 4: luc(5) == 11  (2,1,3,4,7,11)
    cki("luc(5)", luc(5), 11)

    // KAT 5: luc(9) == 76  (2,1,3,4,7,11,18,29,47,76)
    cki("luc(9)", luc(9), 76)

    // KAT 6: luc_list(6) == [2,1,3,4,7,11]
    let lst = luc_list(6)
    cki("luc_list(6).len", len(lst), 6)
    cki("luc_list(6)[0]", lst[0], 2)
    cki("luc_list(6)[1]", lst[1], 1)
    cki("luc_list(6)[2]", lst[2], 3)
    cki("luc_list(6)[3]", lst[3], 4)
    cki("luc_list(6)[4]", lst[4], 7)
    cki("luc_list(6)[5]", lst[5], 11)

    // KAT 7: luc_is(18) == true  (L(7)=18)
    ckb("luc_is(18)", luc_is(18), true)

    // KAT 8: luc_is(19) == false  (19 not in Lucas sequence)
    ckb("luc_is(19)", luc_is(19), false)

    // Additional edge cases
    ckb("luc_is(1)", luc_is(1), true)
    ckb("luc_is(2)", luc_is(2), true)
    ckb("luc_is(3)", luc_is(3), true)
    ckb("luc_is(4)", luc_is(4), true)
    ckb("luc_is(5)", luc_is(5), false)
    ckb("luc_is(7)", luc_is(7), true)
    ckb("luc_is(11)", luc_is(11), true)
    ckb("luc_is(0)", luc_is(0), false)
    cki("luc_list(0).len", len(luc_list(0)), 0)
    cki("luc_list(1)[0]", luc_list(1)[0], 2)

    print("_lucas_test passed")
