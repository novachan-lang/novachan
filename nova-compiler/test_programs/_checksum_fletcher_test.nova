// KAT test for std/coding/checksum_fletcher.
// Verifies Fletcher-16/32/8, Adler-32, verify16, checkbytes16, and fletcher16_sums
// against authoritative reference vectors.
import std/coding/checksum_fletcher

fn list_eq(a: list, b: list) -> bool
    if len(a) != len(b)
        return false
    let i = 0
    while i < len(a)
        if a[i] != b[i]
            return false
        i = i + 1
    true

fn assert_int(label: string, got: int, want: int)
    if got != want
        print("FAIL checksum_fletcher " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn assert_bool(label: string, got: bool, want: bool)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL checksum_fletcher " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn main()
    // --- fl_fletcher16 KAT ---
    // Empty list => 0
    let empty = []
    assert_int("fl16_empty", fl_fletcher16(empty), 0)

    // 'abcde' => 0xC8F0 = 51440
    let abcde = []
    push(abcde, 97)
    push(abcde, 98)
    push(abcde, 99)
    push(abcde, 100)
    push(abcde, 101)
    assert_int("fl16_abcde", fl_fletcher16(abcde), 51440)

    // 'abcdef' => 0x2057 = 8279
    let abcdef = []
    push(abcdef, 97)
    push(abcdef, 98)
    push(abcdef, 99)
    push(abcdef, 100)
    push(abcdef, 101)
    push(abcdef, 102)
    assert_int("fl16_abcdef", fl_fletcher16(abcdef), 8279)

    // --- fl_fletcher16_sums KAT ---
    // 'abcde': s1=240, s2=200; combined = (200<<8)|240 = 51440
    let sums = fl_fletcher16_sums(abcde)
    assert_int("fl16_sums_s1", sums[0], 240)
    assert_int("fl16_sums_s2", sums[1], 200)
    // verify combined equals fl_fletcher16
    let combined = (sums[1] << 8) | sums[0]
    assert_int("fl16_sums_combined", combined, 51440)

    // --- fl_fletcher32 KAT ---
    // 'abcde' => 0xF04FC729 = 4031760169
    assert_int("fl32_abcde", fl_fletcher32(abcde), 4031760169)

    // --- fl_adler32 KAT ---
    // 'abc' => 0x024D0127 = 38600999
    let abc = []
    push(abc, 97)
    push(abc, 98)
    push(abc, 99)
    assert_int("adler32_abc", fl_adler32(abc), 38600999)

    // --- fl_verify16 ---
    assert_bool("verify16_ok", fl_verify16(abcde, 51440), true)
    assert_bool("verify16_bad", fl_verify16(abcde, 0), false)

    // --- fl_checkbytes16 round-trip ---
    // Appending check bytes should make fl_fletcher16 return 0
    let cb = fl_checkbytes16(abcde)
    let extended = []
    let ii = 0
    while ii < len(abcde)
        push(extended, abcde[ii])
        ii = ii + 1
    push(extended, cb[0])
    push(extended, cb[1])
    assert_int("checkbytes16_roundtrip", fl_fletcher16(extended), 0)

    // --- fl_fletcher8 smoke test (non-zero, consistent) ---
    let v8 = fl_fletcher8(abcde)
    if v8 < 0 or v8 > 255
        print("FAIL fl8_range: got=" + str(v8))
        exit(1)
    // Verify it is consistent (same input same output)
    let v8b = fl_fletcher8(abcde)
    assert_int("fl8_consistent", v8, v8b)

    // --- zero message ---
    let zeros = []
    push(zeros, 0)
    push(zeros, 0)
    push(zeros, 0)
    assert_int("fl16_zeros", fl_fletcher16(zeros), 0)
    assert_int("adler32_zeros", fl_adler32(zeros), 196609)

    print("PASS _checksum_fletcher_test")
