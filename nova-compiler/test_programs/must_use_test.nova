fn safe_div(a, b)
  if b == 0
    return err("division by zero")
  return ok(a / b)

fn main()
  let r1 = safe_div(10, 2)
  assert(is_ok(r1), "10/2 should be ok")
  assert(unwrap(r1) == 5, "10/2 == 5")

  let r2 = safe_div(10, 0)
  assert(is_err(r2), "10/0 should be err")

  let _d = safe_div(6, 3)

  let r3 = parse_int_safe("42")
  assert(unwrap(r3) == 42, "parse 42")

  let _d2 = parse_int_safe("999")

  print("must_use_test: all passed")
