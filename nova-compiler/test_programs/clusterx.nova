// clusterx.nova — NOVA cluster membership (increment 1: seed-join + gossip convergence)
//
// A grow-only G-Set CRDT (Shapiro et al. 2011): union-merge is commutative, associative,
// and idempotent, so every node CONVERGES to the same member set regardless of message
// order or duplication. Pure NOVA over the real remote_* TCP transport. One actor task
// owns the member set (no shared mutable state — NOVA's process-isolation model); all
// other tasks query/update it via a command channel.
//
// Increment 1 is GROW-ONLY: members are never removed. So cluster_members() returns every
// node that has EVER joined, not necessarily those alive. Heartbeat / failure detection /
// removal is increment 2.

fn cluster_start(port, seeds)
    let self_addr = "127.0.0.1:" + str(port)
    let cmd_ch = channel()
    spawn _manager_loop(cmd_ch, self_addr)   // sole owner of the member set
    spawn _acceptor_loop(port, cmd_ch)       // inbound peers -> manager
    for seed in seeds
        if seed != self_addr
            spawn _join_seed(seed, self_addr, cmd_ch)
    spawn _gossip_loop(cmd_ch, self_addr)    // periodic push-pull gossip
    {"cmd_ch": cmd_ch, "self": self_addr}

fn cluster_members(info)
    let reply = channel()
    send(info["cmd_ch"], {"cmd": "get", "reply": reply})
    receive(reply)

// ── failure detection (increment 2): live members + per-member status ────────
// Liveness is a SEPARATE axis from membership: the G-Set never shrinks; a member not
// heard from within the timeout is reported "down" (gossip doubles as the heartbeat).
fn cluster_alive(info)
    let reply = channel()
    send(info["cmd_ch"], {"cmd": "alive", "reply": reply})
    receive(reply)

fn cluster_status(info)
    let reply = channel()
    send(info["cmd_ch"], {"cmd": "status", "reply": reply})
    receive(reply)

// Graceful leave: announce departure to every peer so they mark us "down" IMMEDIATELY,
// instead of waiting out the failure-detection timeout. Best-effort — a peer we can't
// reach just falls back to timeout detection (peers are alive in a graceful-leave scenario;
// localhost connect to a dead/absent peer fails fast, so this never blocks on the living).
fn cluster_leave(info)
    let reply = channel()
    send(info["cmd_ch"], {"cmd": "get", "reply": reply})
    let members = receive(reply)
    let self_addr = info["self"]
    for m in members
        if m != self_addr
            let parts = split(m, ":")
            let conn = remote_connect(parts[0], parse_int(parts[1]))
            if conn != -1
                remote_send(conn, {"type": "leave", "from": self_addr})
                remote_close(conn)

// Distributed task placement (Erlang-class rpc): run fn_name(fn_args) on a LIVE peer and
// return its result. The cluster's liveness axis chooses the target — we never dispatch to a
// member we believe is down. Returns {"ok": true, "value": r, "node": addr} on success, or
// {"ok": false, "error": msg} if there is no live peer or it is unreachable. Never blocks on a
// DEAD peer: a failed connect and a socket-EOF (the peer process died) both short-circuit to an
// error; only a hung-but-alive peer could block awaiting its reply (recv-timeout is future).
// Run fn_name(fn_args) on a SPECIFIC target addr. The reusable core of cluster_spawn/pmap:
// connect → send the spawn request → recv the result. Always RETURNS (never an infinite park):
// a failed connect and a socket-EOF (peer process died) both short-circuit to an error, so a
// dead target cannot hang a caller — only a hung-but-alive peer could (recv-timeout is future).
fn _spawn_to(target, fn_name, fn_args)
    if target == ""
        return {"ok": false, "error": "no live peer"}
    let parts = split(target, ":")
    let conn = remote_connect(parts[0], parse_int(parts[1]))
    if conn == -1
        return {"ok": false, "error": "connect failed: " + target}
    remote_send(conn, {"type": "spawn", "fn": fn_name, "args": fn_args})
    // recv-timeout: a hung-but-alive peer (accepts the connection but never replies -- a slow or crashed
    // remote fn, or a wedged node) must NOT block the caller forever. remote_connect is a raw TCP fd, so
    // tcp_wait_readable parks on the netpoller with a deadline; ready != 1 (timeout=0 / error=-1) -> a
    // bounded error instead of an infinite park. This closes the "recv-timeout is future" gap.
    let ready = tcp_wait_readable(conn, 10000)
    if ready != 1
        remote_close(conn)
        return {"ok": false, "error": "peer reply timeout: " + target}
    let reply = remote_recv(conn)
    remote_close(conn)
    if reply == 0
        return {"ok": false, "error": "peer closed before replying: " + target}
    {"ok": true, "value": reply["value"], "node": target}

fn cluster_spawn(info, fn_name, fn_args)
    let live = cluster_alive(info)
    let self_addr = info["self"]
    let target = ""
    for m in live
        if m != self_addr
            target = m
    _spawn_to(target, fn_name, fn_args)

// One pmap task: run on its assigned peer, then send the INDEX-TAGGED result on the shared gather
// channel. Spawned as its own green task so a slow/dead peer only stalls ITS slot, not the batch
// (channels are reference-shared across spawn — same as _gossip_once → the manager).
fn _pmap_worker(result_ch, idx, target, fn_name, task_args)
    let r = _spawn_to(target, fn_name, task_args)
    send(result_ch, {"idx": idx, "result": r})

// Distributed scatter-gather (the point of a cluster: run the whole batch across the membership
// AT ONCE). Distributes args_list round-robin over the LIVE peers, runs every task concurrently,
// and gathers results IN INPUT ORDER (each worker tags its slot index; the gatherer places by
// index regardless of completion order). Returns {"ok": true, "values": [<per-task result>...]}
// where each per-task result is itself {"ok":bool, "value"|"error":..} — so one failed/dead peer
// produces an error in ITS slot WITHOUT sinking the rest of the batch. No live peer / empty input
// short-circuit; a dead peer mid-batch cannot hang the gather (every _spawn_to returns).
fn cluster_pmap(info, fn_name, args_list)
    let n = len(args_list)
    if n == 0
        return {"ok": true, "values": []}
    let live = cluster_alive(info)
    let self_addr = info["self"]
    let peers = []
    for m in live
        if m != self_addr
            push(peers, m)
    if len(peers) == 0
        return {"ok": false, "error": "no live peer"}
    let result_ch = channel()
    let i = 0
    let pidx = 0
    while i < n
        spawn _pmap_worker(result_ch, i, peers[pidx], fn_name, args_list[i])
        pidx = pidx + 1
        if pidx >= len(peers)
            pidx = 0
        i = i + 1
    let slots = []
    let j = 0
    while j < n
        push(slots, 0)                       // placeholders so index-set lands IN ORDER
        j = j + 1
    let got = 0
    while got < n
        let msg = receive(result_ch)         // exactly n arrive (every worker sends once)
        slots[msg["idx"]] = msg["result"]
        got = got + 1
    {"ok": true, "values": slots}

// ── membership manager actor (single owner of the set + last-seen) ───────────

fn _union(members, incoming)
    for m in incoming
        if contains(members, m) == false
            push(members, m)
    sort(members)

fn _pick_peer(members, self_addr)
    let peers = []
    for m in members
        if m != self_addr
            push(peers, m)
    if len(peers) == 0
        return ""
    peers[time_ms() % len(peers)]

fn _manager_loop(cmd_ch, self_addr)
    let members = [self_addr]
    let last_seen = {}              // addr -> time_ms() of last contact (failure detection)
    let left = {}                   // addr -> 1 if the node gracefully LEFT (tombstone): a stray gossip from
                                    // the departed node must NOT revive it; only an explicit rejoin clears it.
    let timeout = 4000              // ms; member silent longer than this => "down". Generous vs the
                                    // ~300ms gossip interval (~13 missed rounds) so steady-state churn
                                    // never false-positives a live node. (For larger clusters T should
                                    // scale with N; liveness is a best-effort hint, membership is the
                                    // hard truth — a phi-accrual/suspicion detector is increment 3.)
    let registry = {}               // D6.3 global registry: name -> value (a handle/addr), registered locally
    let subs = {}                   // D6.5 cluster pubsub: topic -> [subscriber channels] (local subscribers)
    last_seen[self_addr] = time_ms()
    while true
        let cmd = receive(cmd_ch)
        let c = cmd["cmd"]
        if c == "merge"
            members = _union(members, cmd["members"])
            let now = time_ms()
            for m in members
                if contains(last_seen, m) == false
                    last_seen[m] = now
        else if c == "merge_get"
            members = _union(members, cmd["members"])
            let now2 = time_ms()
            for m in members
                if contains(last_seen, m) == false
                    last_seen[m] = now2
            send(cmd["reply"], members)
        else if c == "get"
            send(cmd["reply"], members)
        else if c == "get_peer"
            send(cmd["reply"], _pick_peer(members, self_addr))
        else if c == "touch"
            // proof-of-life from a peer (any inbound message). TOMBSTONE GUARD: a stray gossip from a node
            // that gracefully LEFT must NOT revive it (left[addr]==1 => skip); only an explicit rejoin does.
            if left[cmd["addr"]] != 1
                last_seen[cmd["addr"]] = time_ms()
        else if c == "mark_left"
            // a peer announced a graceful leave: TOMBSTONE it + force "down" now (last_seen=0 => the age
            // (now-0) exceeds any timeout). The tombstone makes the leave DURABLE against later gossip touches.
            left[cmd["addr"]] = 1
            last_seen[cmd["addr"]] = 0
        else if c == "rejoin"
            // an explicit join from a (possibly previously-departed) node: clear any tombstone + mark alive.
            left[cmd["addr"]] = 0
            last_seen[cmd["addr"]] = time_ms()
        else if c == "alive"
            let now3 = time_ms()
            let alive = []
            for m in members
                if m == self_addr or (now3 - last_seen[m]) < timeout   // self is always alive
                    push(alive, m)
            send(cmd["reply"], sort(alive))
        else if c == "status"
            let now4 = time_ms()
            let result = []
            for m in members
                let s = "alive"
                if m != self_addr and (now4 - last_seen[m]) >= timeout
                    s = "down"
                push(result, {"addr": m, "status": s})
            send(cmd["reply"], result)
        else if c == "reg"
            registry[cmd["name"]] = cmd["val"]
        else if c == "lookup"
            let lv = ""
            if contains(registry, cmd["name"])
                lv = registry[cmd["name"]]
            send(cmd["reply"], lv)
        else if c == "sub"
            let tp = cmd["topic"]
            if contains(subs, tp) == false
                subs[tp] = []
            push(subs[tp], cmd["ch"])
        else if c == "pub_local"
            let tp2 = cmd["topic"]
            if contains(subs, tp2)
                let sl = subs[tp2]
                let si = 0
                while si < len(sl)
                    send(sl[si], cmd["msg"])
                    si = si + 1

// ── acceptor: inbound connections route to the manager ──────────────────────

fn _acceptor_loop(port, cmd_ch)
    let listener = remote_bind(port)
    if listener < 0
        return 0                              // bind failed (port in use) -> don't spin accept() on -1
    while true
        let conn = remote_accept(listener)
        if conn < 0
            return 0                          // listener error -> stop instead of busy-spinning at 100% CPU
        spawn _handle_peer(conn, cmd_ch)

fn _handle_peer(conn, cmd_ch)
    let msg = remote_recv(conn)
    if msg != 0
        let reply = channel()
        if msg["type"] == "join"
            // add the joiner, then reply with our full (updated) member list — atomic, no add-then-get race
            // (merge_get does both in one command). "rejoin" clears any tombstone so a node that LEFT and
            // comes back is revived (a plain gossip from it would stay tombstoned).
            send(cmd_ch, {"cmd": "rejoin", "addr": msg["from"]})
            send(cmd_ch, {"cmd": "merge_get", "members": [msg["from"]], "reply": reply})
            remote_send(conn, {"type": "ack", "members": receive(reply)})
        else if msg["type"] == "gossip"
            // gossip carries the sender's addr ("from") — proof-of-life (heartbeat).
            if msg["from"] != 0
                send(cmd_ch, {"cmd": "touch", "addr": msg["from"]})
            send(cmd_ch, {"cmd": "merge_get", "members": msg["members"], "reply": reply})
            remote_send(conn, {"type": "ack", "members": receive(reply)})
        else if msg["type"] == "leave"
            // graceful departure: mark the sender down immediately (no ack — it's gone).
            if msg["from"] != 0
                send(cmd_ch, {"cmd": "mark_left", "addr": msg["from"]})
        else if msg["type"] == "spawn"
            // distributed task placement: resolve + run the requested function HERE. call_by_name
            // uses the immutable fn registry (built at @main init, lock-free reads); args were
            // deep-copied off the wire (process isolation), so this is a normal local call.
            let rv = call_by_name(msg["fn"], msg["args"])
            remote_send(conn, {"type": "result", "value": rv})
        else if msg["type"] == "whereis"
            // D6.3: a peer asks who holds a registered name -> local lookup, reply with the value ("" if none).
            let wreply = channel()
            send(cmd_ch, {"cmd": "lookup", "name": msg["name"], "reply": wreply})
            remote_send(conn, {"type": "found", "val": receive(wreply)})
        else if msg["type"] == "pub"
            // D6.5: a peer broadcast a message -> deliver to our LOCAL subscribers of that topic.
            send(cmd_ch, {"cmd": "pub_local", "topic": msg["topic"], "msg": msg["msg"]})
    remote_close(conn)

// ── outbound: join a seed (with retry — a transient connect failure must NOT leave
//    the node permanently isolated) ──────────────────────────────────────────

fn _join_seed(seed_addr, self_addr, cmd_ch)
    let parts = split(seed_addr, ":")
    let host = parts[0]
    let port = parse_int(parts[1])
    let conn = -1
    let attempt = 0
    while attempt < 12
        conn = remote_connect(host, port)
        if conn != -1
            break
        sleep(200)
        attempt = attempt + 1
    if conn == -1
        return 0
    remote_send(conn, {"type": "join", "from": self_addr})
    let reply = remote_recv(conn)
    remote_close(conn)
    if reply != 0
        send(cmd_ch, {"cmd": "merge", "members": reply["members"]})

// ── periodic push-pull gossip: send our list to a random peer, merge their reply ──

// One gossip exchange, run as its OWN spawned task so that contacting a DEAD/slow peer
// (connect or recv that parks waiting on a node that never answers) cannot stall the
// gossip loop — if it did, the node would stop self-touching and gossiping to LIVE peers,
// cascading into "everyone looks down" (incl. self). Decoupling keeps the loop ticking;
// a stuck attempt just parks harmlessly until the OS tears the dead socket down.
fn _gossip_once(cmd_ch, self_addr, peer, mine)
    let parts = split(peer, ":")
    let conn = remote_connect(parts[0], parse_int(parts[1]))
    if conn != -1
        remote_send(conn, {"type": "gossip", "members": mine, "from": self_addr})
        let ack = remote_recv(conn)
        remote_close(conn)
        if ack != 0
            send(cmd_ch, {"cmd": "touch", "addr": peer})   // peer replied = alive
            send(cmd_ch, {"cmd": "merge", "members": ack["members"]})

fn _gossip_loop(cmd_ch, self_addr)
    sleep(300)
    while true
        send(cmd_ch, {"cmd": "touch", "addr": self_addr})   // keep self alive every tick
        let pch = channel()
        send(cmd_ch, {"cmd": "get_peer", "reply": pch})
        let peer = receive(pch)
        if peer != ""
            let lch = channel()
            send(cmd_ch, {"cmd": "get", "reply": lch})
            let mine = receive(lch)
            spawn _gossip_once(cmd_ch, self_addr, peer, mine)   // decoupled: dead peer can't stall the loop
        sleep(300)

// ── D6.3 global registry: register a name -> value locally; resolve cluster-wide ──────────────────────
// global_register(info, name, value) records name->value on THIS node. global_whereis(info, name) resolves
// it: local first, else a fan-out "whereis" query to each LIVE peer (first hit wins). A bounded query (per
// the _spawn_to model: connect + tcp_wait_readable deadline), so a dead peer can't hang the resolve. Names
// are cluster-unique by convention; the caller registers on exactly one node.
fn global_register(info, name, value)
    send(info["cmd_ch"], {"cmd": "reg", "name": name, "val": value})
    0

fn global_whereis(info, name)
    let reply = channel()
    send(info["cmd_ch"], {"cmd": "lookup", "name": name, "reply": reply})
    let local = receive(reply)
    if local != ""
        return local
    let live = cluster_alive(info)
    let self_addr = info["self"]
    for m in live
        if m != self_addr
            let parts = split(m, ":")
            let conn = remote_connect(parts[0], parse_int(parts[1]))
            if conn != -1
                remote_send(conn, {"type": "whereis", "name": name})
                let ready = tcp_wait_readable(conn, 5000)
                if ready == 1
                    let r = remote_recv(conn)
                    remote_close(conn)
                    if r != 0 and r["val"] != ""
                        return r["val"]
                else
                    remote_close(conn)
    ""

// ── D6.5 cluster PubSub: publish on any node reaches subscribers on every node ─────────────────────────
// cluster_subscribe(info, topic) -> a channel the caller receive()s published messages on (registered with
// the local manager). cluster_broadcast(info, topic, msg) delivers to LOCAL subscribers AND fans out to
// every LIVE peer (remote "pub"), whose manager delivers to ITS local subscribers. So a publish on node A
// reaches a subscriber on node B. Best-effort (a dead peer just misses the message; connect fails fast).
fn cluster_subscribe(info, topic)
    let ch = channel()
    send(info["cmd_ch"], {"cmd": "sub", "topic": topic, "ch": ch})
    ch

fn cluster_broadcast(info, topic, msg)
    send(info["cmd_ch"], {"cmd": "pub_local", "topic": topic, "msg": msg})
    let members = cluster_alive(info)
    let self_addr = info["self"]
    for m in members
        if m != self_addr
            let parts = split(m, ":")
            let conn = remote_connect(parts[0], parse_int(parts[1]))
            if conn != -1
                remote_send(conn, {"type": "pub", "topic": topic, "msg": msg})
                remote_close(conn)
    0

// ── D6.4 distributed monitor: get a DOWN signal when a remote node dies ────────────────────────────────
// cluster_monitor(info, node) -> a channel that delivers ONE {"type":"DOWN","node":addr} when `node`
// transitions to "down" per the cluster's failure detector (cluster_status). A supervisor receive()s it
// and reacts (restart elsewhere). Poll-based over the existing gossip heartbeat (a phi-accrual detector is
// future); the monitor task exits after firing so it never leaks.
fn _monitor_loop(info, node, ch)
    let down = false
    while down == false
        let status = cluster_status(info)
        for s in status
            if s["addr"] == node and s["status"] == "down"
                down = true
        if down == false
            sleep(500)
    send(ch, {"type": "DOWN", "node": node})

fn cluster_monitor(info, node)
    let ch = channel()
    spawn _monitor_loop(info, node, ch)
    ch
