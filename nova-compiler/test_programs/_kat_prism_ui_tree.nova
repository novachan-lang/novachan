// KAT for prism/ui/prism_ui_tree.nova (PRISM_ROADMAP.md milestone MB.12b, the `ui/` composition
// layer's tree view: leaf, collapsible branch, tree container, file-tree convenience builder,
// and a label-substring search filter).
//
// Every expected depth/count/child_count value below is HAND-COMPUTED from prism_node.nova's own
// rules (leaf depth=1/count=1; a branch's depth = max(child depths)+1, count = 1 + sum(child
// counts)), not asserted against whatever the code happens to produce. Structural shapes
// (`_prism_tv_header` always wraps in a `band`, even for a single, icon-less label) are traced
// through explicitly rather than assumed.
//
// Proves, against concrete expected values:
//   1. PrismTvEntry constructors: prism_tve_file / prism_tve_dir build correctly; each rejects an
//      empty name; prism_tve_dir rejects a non-PrismTvEntry child.
//   2. prism_tv_leaf: exact band(d=2,c=2,children=1) without an icon, band(d=2,c=3,children=2)
//      with one; exact "text"/"icon" attrs; rejects an empty label.
//   3. prism_tv_branch: exact stack(d=3,c=7,children=3) when expanded with 2 leaf children,
//      exact stack(d=3,c=4,children=1) when COLLAPSED (children discarded, only the header
//      survives); exact tv_expanded/text/icon attrs on both; rejects an empty label, an empty
//      children list, and a non-PrismNode child element.
//   4. prism_tv_tree: exact stack(d=3,c=5,children=2) over two leaves; rejects an empty roots
//      list and a non-PrismNode root.
//   5. prism_tv_file_tree: a 2-level fixture (a directory containing one file, alongside a
//      second top-level file) reproduced exactly -- kind/depth/count/child_count/attrs at every
//      level, including the header's own glyph+label children; rejects an empty entries list, a
//      non-PrismTvEntry element, and an empty-children directory (propagated from
//      prism_tv_branch's own "children must not be empty" rejection).
//   6. prism_tv_search_tree: "apple" keeps the ancestor branch pruned to only the matching leaf
//      (ancestor preservation) and drops the unrelated sibling branch entirely; "APPLE" proves
//      case-insensitivity yields the identical shape; "fruits" (the branch's OWN label matches,
//      no descendant does) keeps the branch pruned to JUST its header, not its full original
//      subtree; a standalone leaf root also matches directly; a query matching nothing anywhere
//      is a rejection; rejects an empty roots list, a non-PrismNode root, and an empty query.
//   7. Accessors: prism_tv_is_expanded / prism_tv_label_of read the right attr off both leaf and
//      branch nodes, and default sanely (false / "") off a node that carries neither.
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova into
// $NOVA_HOME/lib, so `import prism_node` / `import prism_ui_tree` resolve.
//   ./gen3_test.exe _kat_prism_ui_tree.nova
//   clang -O2 -o _kat_prism_ui_tree.exe _kat_prism_ui_tree.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_ui_tree.exe

import prism_node
import prism_content
import prism_ui_tree

let mut _fail_count = 0

// `got`/`want` are left unannotated (implicit generics, NOVA_LANGUAGE_FEATURES.md's own
// "an unannotated fn is already generic") so this ONE function serves string, int, and bool
// call sites without duplication.
fn _check(label: string, got, want) -> bool
    if got == want
        print("OK    " + label)
        return true
    print("FAIL  " + label + ": got " + str(got) + ", want " + str(want))
    false

fn _check_true(label: string, cond: bool) -> bool
    if cond
        print("OK    " + label)
        return true
    print("FAIL  " + label)
    false

fn main()
    // ── 1. PrismTvEntry constructors ─────────────────────────────────────────────────────────
    let file_r = prism_ui_tree.prism_tve_file("readme.txt")
    if is_err(file_r)
        print("FAIL  prism_tve_file(\"readme.txt\") should succeed: " + unwrap_err(file_r))
        _fail_count += 1
    else
        let fe = unwrap(file_r)
        if not _check(" tve_file: name", fe.tve_name, "readme.txt")
            _fail_count += 1
        if not _check_true(" tve_file: is_dir false", not fe.tve_is_dir)
            _fail_count += 1
        if not _check(" tve_file: children empty", len(fe.tve_children), 0)
            _fail_count += 1

    let dir_r = prism_ui_tree.prism_tve_dir("src", [unwrap(prism_ui_tree.prism_tve_file("a.nova"))])
    if is_err(dir_r)
        print("FAIL  prism_tve_dir(\"src\", [...]) should succeed: " + unwrap_err(dir_r))
        _fail_count += 1
    else
        let de = unwrap(dir_r)
        if not _check(" tve_dir: name", de.tve_name, "src")
            _fail_count += 1
        if not _check_true(" tve_dir: is_dir true", de.tve_is_dir)
            _fail_count += 1
        if not _check(" tve_dir: children count", len(de.tve_children), 1)
            _fail_count += 1

    if not _check_true(" tve_file rejects empty name", is_err(prism_ui_tree.prism_tve_file("")))
        _fail_count += 1
    if not _check_true(" tve_dir rejects empty name", is_err(prism_ui_tree.prism_tve_dir("", [])))
        _fail_count += 1
    if not _check_true(" tve_dir rejects a non-PrismTvEntry child", is_err(prism_ui_tree.prism_tve_dir("bad", [123])))
        _fail_count += 1
    print("1. PrismTvEntry: prism_tve_file/prism_tve_dir build correctly; reject empty name (both) and a non-PrismTvEntry child (dir): done")

    // ── 2. prism_tv_leaf ──────────────────────────────────────────────────────────────────────
    let leaf_plain_r = prism_ui_tree.prism_tv_leaf("Documents", none())
    if is_err(leaf_plain_r)
        print("FAIL  prism_tv_leaf(\"Documents\", none()): " + unwrap_err(leaf_plain_r))
        _fail_count += 1
    else
        let n = unwrap(leaf_plain_r)
        if not _check(" leaf(no icon): kind", prism_node.prism_node_kind_str(n), "band")
            _fail_count += 1
        if not _check(" leaf(no icon): depth", prism_node.prism_node_depth(n), 2)
            _fail_count += 1
        if not _check(" leaf(no icon): count", prism_node.prism_node_count(n), 2)
            _fail_count += 1
        if not _check(" leaf(no icon): child_count", prism_node.prism_node_child_count(n), 1)
            _fail_count += 1
        if not _check(" leaf(no icon): label_of", prism_ui_tree.prism_tv_label_of(n), "Documents")
            _fail_count += 1
        if not _check_true(" leaf(no icon): not has 'icon' attr", not prism_node.prism_node_has_attr(n, "icon"))
            _fail_count += 1

    let leaf_icon_r = prism_ui_tree.prism_tv_leaf("readme.txt", some(prism_content.prism_icon_info()))
    if is_err(leaf_icon_r)
        print("FAIL  prism_tv_leaf(\"readme.txt\", Some(info)): " + unwrap_err(leaf_icon_r))
        _fail_count += 1
    else
        let n2 = unwrap(leaf_icon_r)
        if not _check(" leaf(icon): kind", prism_node.prism_node_kind_str(n2), "band")
            _fail_count += 1
        if not _check(" leaf(icon): depth", prism_node.prism_node_depth(n2), 2)
            _fail_count += 1
        if not _check(" leaf(icon): count", prism_node.prism_node_count(n2), 3)
            _fail_count += 1
        if not _check(" leaf(icon): child_count", prism_node.prism_node_child_count(n2), 2)
            _fail_count += 1
        if not _check(" leaf(icon): label_of", prism_ui_tree.prism_tv_label_of(n2), "readme.txt")
            _fail_count += 1
        if not _check(" leaf(icon): icon attr", prism_node.prism_node_attr_str(n2, "icon", ""), "info")
            _fail_count += 1
        let n2_kids = prism_node.prism_node_children(n2)
        if not _check(" leaf(icon): child[0] kind", prism_node.prism_node_kind_str(n2_kids[0]), "glyph")
            _fail_count += 1
        if not _check(" leaf(icon): child[0] icon", prism_node.prism_node_attr_str(n2_kids[0], "icon", ""), "info")
            _fail_count += 1
        if not _check(" leaf(icon): child[1] kind", prism_node.prism_node_kind_str(n2_kids[1]), "label")
            _fail_count += 1
        if not _check(" leaf(icon): child[1] text", prism_node.prism_node_attr_str(n2_kids[1], "text", ""), "readme.txt")
            _fail_count += 1

    if not _check_true(" leaf rejects empty label", is_err(prism_ui_tree.prism_tv_leaf("", none())))
        _fail_count += 1
    print("2. prism_tv_leaf: exact band(d=2,c=2,children=1) w/o icon, band(d=2,c=3,children=2) w/ icon (glyph+label traced), rejects empty label: done")

    // ── 3. prism_tv_branch ────────────────────────────────────────────────────────────────────
    let leaf_a = unwrap(prism_ui_tree.prism_tv_leaf("a.txt", none()))
    let leaf_b = unwrap(prism_ui_tree.prism_tv_leaf("b.txt", none()))

    let branch_exp_r = prism_ui_tree.prism_tv_branch("Folder", [leaf_a, leaf_b], true, none())
    if is_err(branch_exp_r)
        print("FAIL  prism_tv_branch(\"Folder\", [a,b], true, none()): " + unwrap_err(branch_exp_r))
        _fail_count += 1
    else
        let b = unwrap(branch_exp_r)
        if not _check(" branch(expanded): kind", prism_node.prism_node_kind_str(b), "stack")
            _fail_count += 1
        if not _check(" branch(expanded): depth", prism_node.prism_node_depth(b), 3)
            _fail_count += 1
        if not _check(" branch(expanded): count", prism_node.prism_node_count(b), 7)
            _fail_count += 1
        if not _check(" branch(expanded): child_count", prism_node.prism_node_child_count(b), 3)
            _fail_count += 1
        if not _check_true(" branch(expanded): is_expanded true", prism_ui_tree.prism_tv_is_expanded(b))
            _fail_count += 1
        if not _check(" branch(expanded): label_of", prism_ui_tree.prism_tv_label_of(b), "Folder")
            _fail_count += 1
        let b_kids = prism_node.prism_node_children(b)
        if not _check(" branch(expanded): header kind", prism_node.prism_node_kind_str(b_kids[0]), "band")
            _fail_count += 1
        if not _check(" branch(expanded): header child_count", prism_node.prism_node_child_count(b_kids[0]), 1)
            _fail_count += 1
        let header_kids = prism_node.prism_node_children(b_kids[0])
        if not _check(" branch(expanded): header's label text", prism_node.prism_node_attr_str(header_kids[0], "text", ""), "Folder")
            _fail_count += 1
        if not _check(" branch(expanded): children[1] is leaf_a", prism_ui_tree.prism_tv_label_of(b_kids[1]), "a.txt")
            _fail_count += 1
        if not _check(" branch(expanded): children[2] is leaf_b", prism_ui_tree.prism_tv_label_of(b_kids[2]), "b.txt")
            _fail_count += 1

    let branch_col_r = prism_ui_tree.prism_tv_branch("Folder2", [leaf_a], false, some(prism_content.prism_icon_menu()))
    if is_err(branch_col_r)
        print("FAIL  prism_tv_branch(\"Folder2\", [a], false, Some(menu)): " + unwrap_err(branch_col_r))
        _fail_count += 1
    else
        let bc = unwrap(branch_col_r)
        if not _check(" branch(collapsed): kind", prism_node.prism_node_kind_str(bc), "stack")
            _fail_count += 1
        if not _check(" branch(collapsed): depth", prism_node.prism_node_depth(bc), 3)
            _fail_count += 1
        if not _check(" branch(collapsed): count", prism_node.prism_node_count(bc), 4)
            _fail_count += 1
        if not _check(" branch(collapsed): child_count (header only, subtree discarded)", prism_node.prism_node_child_count(bc), 1)
            _fail_count += 1
        if not _check_true(" branch(collapsed): is_expanded false", not prism_ui_tree.prism_tv_is_expanded(bc))
            _fail_count += 1
        if not _check(" branch(collapsed): icon attr", prism_node.prism_node_attr_str(bc, "icon", ""), "menu")
            _fail_count += 1
        let bc_header = prism_node.prism_node_children(bc)[0]
        if not _check(" branch(collapsed): header child_count (glyph+label)", prism_node.prism_node_child_count(bc_header), 2)
            _fail_count += 1

    if not _check_true(" branch rejects empty label", is_err(prism_ui_tree.prism_tv_branch("", [leaf_a], true, none())))
        _fail_count += 1
    if not _check_true(" branch rejects empty children", is_err(prism_ui_tree.prism_tv_branch("X", [], true, none())))
        _fail_count += 1
    if not _check_true(" branch rejects a non-PrismNode child", is_err(prism_ui_tree.prism_tv_branch("X", [leaf_a, 42], true, none())))
        _fail_count += 1
    print("3. prism_tv_branch: exact stack(d=3,c=7,children=3) expanded, exact stack(d=3,c=4,children=1) collapsed (subtree discarded, header survives), tv_expanded/icon attrs exact, rejects empty label/empty children/non-PrismNode child: done")

    // ── 4. prism_tv_tree ──────────────────────────────────────────────────────────────────────
    let tree_r = prism_ui_tree.prism_tv_tree([leaf_a, leaf_b])
    if is_err(tree_r)
        print("FAIL  prism_tv_tree([a,b]): " + unwrap_err(tree_r))
        _fail_count += 1
    else
        let t = unwrap(tree_r)
        if not _check(" tree: kind", prism_node.prism_node_kind_str(t), "stack")
            _fail_count += 1
        if not _check(" tree: depth", prism_node.prism_node_depth(t), 3)
            _fail_count += 1
        if not _check(" tree: count", prism_node.prism_node_count(t), 5)
            _fail_count += 1
        if not _check(" tree: child_count", prism_node.prism_node_child_count(t), 2)
            _fail_count += 1

    if not _check_true(" tree rejects empty roots", is_err(prism_ui_tree.prism_tv_tree([])))
        _fail_count += 1
    if not _check_true(" tree rejects a non-PrismNode root", is_err(prism_ui_tree.prism_tv_tree([leaf_a, "bad"])))
        _fail_count += 1
    print("4. prism_tv_tree: exact stack(d=3,c=5,children=2), rejects empty roots and a non-PrismNode root: done")

    // ── 5. prism_tv_file_tree ─────────────────────────────────────────────────────────────────
    let main_entry = unwrap(prism_ui_tree.prism_tve_file("main.nova"))
    let src_entry = unwrap(prism_ui_tree.prism_tve_dir("src", [main_entry]))
    let readme_entry = unwrap(prism_ui_tree.prism_tve_file("readme.txt"))

    let ft_r = prism_ui_tree.prism_tv_file_tree([src_entry, readme_entry])
    if is_err(ft_r)
        print("FAIL  prism_tv_file_tree([src, readme]): " + unwrap_err(ft_r))
        _fail_count += 1
    else
        let ft = unwrap(ft_r)
        if not _check(" file_tree: kind", prism_node.prism_node_kind_str(ft), "stack")
            _fail_count += 1
        if not _check(" file_tree: depth", prism_node.prism_node_depth(ft), 4)
            _fail_count += 1
        if not _check(" file_tree: count", prism_node.prism_node_count(ft), 11)
            _fail_count += 1
        if not _check(" file_tree: child_count", prism_node.prism_node_child_count(ft), 2)
            _fail_count += 1

        let ft_kids = prism_node.prism_node_children(ft)
        let src_node = ft_kids[0]
        if not _check(" file_tree: src node kind", prism_node.prism_node_kind_str(src_node), "stack")
            _fail_count += 1
        if not _check(" file_tree: src node depth", prism_node.prism_node_depth(src_node), 3)
            _fail_count += 1
        if not _check(" file_tree: src node count", prism_node.prism_node_count(src_node), 7)
            _fail_count += 1
        if not _check(" file_tree: src node child_count", prism_node.prism_node_child_count(src_node), 2)
            _fail_count += 1
        if not _check_true(" file_tree: src node is_expanded (dirs auto-expand)", prism_ui_tree.prism_tv_is_expanded(src_node))
            _fail_count += 1
        if not _check(" file_tree: src node label_of", prism_ui_tree.prism_tv_label_of(src_node), "src")
            _fail_count += 1
        if not _check(" file_tree: src node icon", prism_node.prism_node_attr_str(src_node, "icon", ""), "menu")
            _fail_count += 1

        let src_kids = prism_node.prism_node_children(src_node)
        let src_header = src_kids[0]
        if not _check(" file_tree: src header kind", prism_node.prism_node_kind_str(src_header), "band")
            _fail_count += 1
        if not _check(" file_tree: src header child_count", prism_node.prism_node_child_count(src_header), 2)
            _fail_count += 1
        let src_header_kids = prism_node.prism_node_children(src_header)
        if not _check(" file_tree: src header glyph icon", prism_node.prism_node_attr_str(src_header_kids[0], "icon", ""), "menu")
            _fail_count += 1
        if not _check(" file_tree: src header label text", prism_node.prism_node_attr_str(src_header_kids[1], "text", ""), "src")
            _fail_count += 1

        let main_node = src_kids[1]
        if not _check(" file_tree: main.nova label_of", prism_ui_tree.prism_tv_label_of(main_node), "main.nova")
            _fail_count += 1
        if not _check(" file_tree: main.nova icon", prism_node.prism_node_attr_str(main_node, "icon", ""), "info")
            _fail_count += 1

        let readme_node = ft_kids[1]
        if not _check(" file_tree: readme.txt kind", prism_node.prism_node_kind_str(readme_node), "band")
            _fail_count += 1
        if not _check(" file_tree: readme.txt label_of", prism_ui_tree.prism_tv_label_of(readme_node), "readme.txt")
            _fail_count += 1
        if not _check(" file_tree: readme.txt icon", prism_node.prism_node_attr_str(readme_node, "icon", ""), "info")
            _fail_count += 1

    if not _check_true(" file_tree rejects empty entries", is_err(prism_ui_tree.prism_tv_file_tree([])))
        _fail_count += 1
    if not _check_true(" file_tree rejects a non-PrismTvEntry element", is_err(prism_ui_tree.prism_tv_file_tree(["not_an_entry"])))
        _fail_count += 1
    let empty_dir_entry = unwrap(prism_ui_tree.prism_tve_dir("emptydir", []))
    if not _check_true(" file_tree rejects an empty-children directory (propagated from prism_tv_branch)", is_err(prism_ui_tree.prism_tv_file_tree([empty_dir_entry])))
        _fail_count += 1
    print("5. prism_tv_file_tree: exact 2-level fixture (stack d=4,c=11,children=2 -> src dir stack d=3,c=7,children=2 -> header band(glyph=menu,label='src') + main.nova leaf; readme.txt leaf sibling), rejects empty entries/non-entry element/empty-children dir: done")

    // ── 6. prism_tv_search_tree ───────────────────────────────────────────────────────────────
    let s_leaf1 = unwrap(prism_ui_tree.prism_tv_leaf("apple.txt", none()))
    let s_leaf2 = unwrap(prism_ui_tree.prism_tv_leaf("banana.txt", none()))
    let s_leaf3 = unwrap(prism_ui_tree.prism_tv_leaf("cherry.txt", none()))
    let branch_fruits = unwrap(prism_ui_tree.prism_tv_branch("Fruits", [s_leaf1, s_leaf2], true, none()))
    let branch_other = unwrap(prism_ui_tree.prism_tv_branch("Other", [s_leaf3], true, none()))
    let search_roots = [branch_fruits, branch_other]

    let search_apple_r = prism_ui_tree.prism_tv_search_tree(search_roots, "apple")
    if is_err(search_apple_r)
        print("FAIL  prism_tv_search_tree([fruits,other], \"apple\"): " + unwrap_err(search_apple_r))
        _fail_count += 1
    else
        let sr = unwrap(search_apple_r)
        if not _check(" search('apple'): result kind", prism_node.prism_node_kind_str(sr), "stack")
            _fail_count += 1
        if not _check(" search('apple'): result child_count (Other dropped entirely)", prism_node.prism_node_child_count(sr), 1)
            _fail_count += 1
        if not _check(" search('apple'): result depth", prism_node.prism_node_depth(sr), 4)
            _fail_count += 1
        if not _check(" search('apple'): result count", prism_node.prism_node_count(sr), 6)
            _fail_count += 1
        let kept_fruits = prism_node.prism_node_children(sr)[0]
        if not _check(" search('apple'): kept branch label_of (ancestor preserved by name)", prism_ui_tree.prism_tv_label_of(kept_fruits), "Fruits")
            _fail_count += 1
        if not _check_true(" search('apple'): kept branch force-expanded", prism_ui_tree.prism_tv_is_expanded(kept_fruits))
            _fail_count += 1
        if not _check(" search('apple'): kept branch child_count (header + only apple.txt)", prism_node.prism_node_child_count(kept_fruits), 2)
            _fail_count += 1
        let kept_kids = prism_node.prism_node_children(kept_fruits)
        if not _check(" search('apple'): kept branch children[1] label_of", prism_ui_tree.prism_tv_label_of(kept_kids[1]), "apple.txt")
            _fail_count += 1

    // Case-insensitivity: "APPLE" must yield the identical shape as "apple".
    let search_upper_r = prism_ui_tree.prism_tv_search_tree(search_roots, "APPLE")
    if is_err(search_upper_r)
        print("FAIL  prism_tv_search_tree([fruits,other], \"APPLE\"): " + unwrap_err(search_upper_r))
        _fail_count += 1
    else
        let sru = unwrap(search_upper_r)
        if not _check(" search('APPLE'): case-insensitive, same child_count as 'apple'", prism_node.prism_node_child_count(sru), 1)
            _fail_count += 1
        if not _check(" search('APPLE'): case-insensitive, same count as 'apple'", prism_node.prism_node_count(sru), 6)
            _fail_count += 1

    // Own-label match with NO matching descendant: branch is kept but pruned to header only.
    let search_fruits_r = prism_ui_tree.prism_tv_search_tree(search_roots, "fruits")
    if is_err(search_fruits_r)
        print("FAIL  prism_tv_search_tree([fruits,other], \"fruits\"): " + unwrap_err(search_fruits_r))
        _fail_count += 1
    else
        let srf = unwrap(search_fruits_r)
        if not _check(" search('fruits'): result child_count (Other still dropped)", prism_node.prism_node_child_count(srf), 1)
            _fail_count += 1
        let kept_by_name = prism_node.prism_node_children(srf)[0]
        if not _check(" search('fruits'): own-name match kept, pruned to header ONLY (not full subtree)", prism_node.prism_node_child_count(kept_by_name), 1)
            _fail_count += 1
        if not _check_true(" search('fruits'): kept branch still force-expanded", prism_ui_tree.prism_tv_is_expanded(kept_by_name))
            _fail_count += 1

    // A standalone leaf root matches directly (the non-branch path of the filter).
    let s_leaf_direct = unwrap(prism_ui_tree.prism_tv_leaf("standalone_apple.md", none()))
    let search_direct_r = prism_ui_tree.prism_tv_search_tree([s_leaf_direct], "apple")
    if is_err(search_direct_r)
        print("FAIL  prism_tv_search_tree([standalone leaf], \"apple\"): " + unwrap_err(search_direct_r))
        _fail_count += 1
    else
        let srd = unwrap(search_direct_r)
        if not _check(" search(standalone leaf, 'apple'): child_count", prism_node.prism_node_child_count(srd), 1)
            _fail_count += 1
        if not _check(" search(standalone leaf, 'apple'): label_of round-trips", prism_ui_tree.prism_tv_label_of(prism_node.prism_node_children(srd)[0]), "standalone_apple.md")
            _fail_count += 1

    if not _check_true(" search rejects a query matching nothing anywhere", is_err(prism_ui_tree.prism_tv_search_tree(search_roots, "zzz_no_match")))
        _fail_count += 1
    if not _check_true(" search rejects an empty roots list", is_err(prism_ui_tree.prism_tv_search_tree([], "apple")))
        _fail_count += 1
    if not _check_true(" search rejects a non-PrismNode root", is_err(prism_ui_tree.prism_tv_search_tree([branch_fruits, "bad"], "apple")))
        _fail_count += 1
    if not _check_true(" search rejects an empty query", is_err(prism_ui_tree.prism_tv_search_tree(search_roots, "")))
        _fail_count += 1
    print("6. prism_tv_search_tree: 'apple' keeps Fruits pruned to [header, apple.txt] and drops Other entirely, 'APPLE' yields the identical shape, 'fruits' (own-name match) keeps [header] ONLY (not the full subtree), a standalone leaf root matches directly, rejects no-match query / empty roots / non-PrismNode root / empty query: done")

    // ── 7. Accessors default sanely off a node carrying neither attr ────────────────────────
    let bare_r = prism_ui_tree.prism_tv_tree([leaf_a, leaf_b])
    let bare = unwrap(bare_r)
    if not _check_true(" prism_tv_is_expanded defaults false off a plain tree container", not prism_ui_tree.prism_tv_is_expanded(bare))
        _fail_count += 1
    if not _check(" prism_tv_label_of defaults \"\" off a plain tree container", prism_ui_tree.prism_tv_label_of(bare), "")
        _fail_count += 1
    print("7. accessors: prism_tv_is_expanded/prism_tv_label_of read the right attr off leaf and branch nodes, and default sanely (false/\"\") off a node carrying neither: done")

    if _fail_count == 0
        print("KAT prism_ui_tree PASSED: leaf/branch/tree/file_tree exact structure, collapsed-branch discards children, search ancestor-preservation + own-name-match pruning + case-insensitivity, all rejections at exact boundaries")
    else
        print("KAT prism_ui_tree FAILED: " + str(_fail_count) + " check(s) failed")
        exit(1)
