// KAT: std/data/sub_shift
import std/data/sub_shift

fn cki(label, got, want)
    if got != want
        print("FAIL sub_shift " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL sub_shift " + label + ": got=[" + got + "] want=[" + want + "]")
        exit(1)

// ── Build two test cues ──────────────────────────────────────────────────────
let c0 = {}
c0["index"] = 0
c0["start"] = 1000
c0["end"] = 4000
c0["text"] = "Hello"

let c1 = {}
c1["index"] = 1
c1["start"] = 5000
c1["end"] = 8000
c1["text"] = "World"

let cues = []
cues.push(c0)
cues.push(c1)

// ── Test 1: sub_shift positive offset ───────────────────────────────────────
let shifted = sub_shift(cues, 1000)
cki("shift_len",       len(shifted),       2)
cki("shift_c0_start",  shifted[0]["start"], 2000)
cki("shift_c0_end",    shifted[0]["end"],   5000)
cki("shift_c1_start",  shifted[1]["start"], 6000)
cki("shift_c1_end",    shifted[1]["end"],   9000)

// ── Test 2: sub_shift clamp at 0 ────────────────────────────────────────────
let clamped = sub_shift(cues, -2000)
cki("clamp_c0_start", clamped[0]["start"], 0)
cki("clamp_c0_end",   clamped[0]["end"],   2000)
cki("clamp_c1_start", clamped[1]["start"], 3000)
cki("clamp_c1_end",   clamped[1]["end"],   6000)

// ── Test 3: input not mutated ────────────────────────────────────────────────
cki("input_c0_start", cues[0]["start"], 1000)
cki("input_c0_end",   cues[0]["end"],   4000)
cki("input_c1_start", cues[1]["start"], 5000)
cki("input_c1_end",   cues[1]["end"],   8000)

// ── Test 4: sub_shift zero offset is a copy ──────────────────────────────────
let same = sub_shift(cues, 0)
cki("zero_c0_start", same[0]["start"], 1000)
cki("zero_c1_end",   same[1]["end"],   8000)

// ── Test 5: sub_shift_range — only c1 in window ─────────────────────────────
let ranged = sub_shift_range(cues, 500, 4000, 9000)
cki("range_c0_start", ranged[0]["start"], 1000)
cki("range_c0_end",   ranged[0]["end"],   4000)
cki("range_c1_start", ranged[1]["start"], 5500)
cki("range_c1_end",   ranged[1]["end"],   8500)

// ── Test 6: sub_shift_range — neither cue in window ─────────────────────────
let none_in = sub_shift_range(cues, 1000, 9000, 10000)
cki("norange_c0_start", none_in[0]["start"], 1000)
cki("norange_c1_start", none_in[1]["start"], 5000)

// ── Test 7: clamp in sub_shift_range ────────────────────────────────────────
let clamped2 = sub_shift_range(cues, -3000, 0, 2000)
cki("rangeClamp_c0_start", clamped2[0]["start"], 0)
cki("rangeClamp_c1_start", clamped2[1]["start"], 5000)

// ── Test 8: text preserved ───────────────────────────────────────────────────
cks("text_c0", shifted[0]["text"], "Hello")
cks("text_c1", shifted[1]["text"], "World")

print("PASS _sub_shift_test")
