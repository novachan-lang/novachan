// Test f-string interpolation and 'in' operator in IR pipeline

// in operator
let nums = [10, 20, 30, 40, 50]

if 20 in nums
    print("PASS: 20 in nums")
else
    print("FAIL: 20 in nums")

if 99 in nums
    print("FAIL: 99 not in nums")
else
    print("PASS: 99 not in nums")

let d = {"a": 1, "b": 2, "c": 3}

if "b" in d
    print("PASS: b in dict")
else
    print("FAIL: b in dict")

if "z" in d
    print("FAIL: z not in dict")
else
    print("PASS: z not in dict")

// f-string interpolation
let name = "NOVA"
let version = 1
print(f"Hello, {name}!")
print(f"Version: {version}")

let a = 10
let b = 20
print(f"{a} + {b} = {a + b}")

print(f"name is {name}, len is {len(name)}")

// Nested expressions
let items = [1, 2, 3]
print(f"count: {len(items)}")

// No interpolation parts
print(f"plain string")

// Single expression
print(f"{42}")

// Multiple adjacent expressions
let x = "A"
let y = "B"
print(f"{x}{y}")

// Expression with string methods
print(f"upper: {upper(name)}")

// Combining in and f-strings
if 10 in nums
    print(f"found 10 in list of {len(nums)} items")
