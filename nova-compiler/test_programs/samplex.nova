fn sample_one(items)
  if len(items) == 0
    return err("empty list")
  let idx = random_int(0, len(items) - 1)
  ok(items[idx])

fn sample_n(items, n)
  let result = []
  if len(items) == 0 or n <= 0
    return result
  let available = []
  for item in items
    push(available, item)
  let count = n
  if count > len(available)
    count = len(available)
  let i = 0
  while i < count
    let idx = random_int(0, len(available) - 1)
    push(result, available[idx])
    available[idx] = available[len(available) - 1]
    available = list_slice(available, 0, len(available) - 1)
    i = i + 1
  result

fn shuffle(items)
  sample_n(items, len(items))

fn weighted_choice(items, weights)
  let total = sum(weights)
  let r = random_int(0, total - 1)
  let cumulative = 0
  let i = 0
  while i < len(weights)
    cumulative = cumulative + weights[i]
    if r < cumulative
      return items[i]
    i = i + 1
  items[len(items) - 1]

fn main()
  let items = [10, 20, 30, 40, 50]
  let picked = sample_one(items)
  assert(is_ok(picked), "sample_one ok")
  assert(contains(items, unwrap(picked)), "picked from list")

  let empty_pick = sample_one([])
  assert(is_err(empty_pick), "empty sample err")

  let sampled = sample_n(items, 3)
  assert(len(sampled) == 3, "sample_n count")

  let over = sample_n(items, 100)
  assert(len(over) == 5, "sample_n capped")

  let shuffled = shuffle(items)
  assert(len(shuffled) == 5, "shuffle preserves len")
  assert(sum(shuffled) == sum(items), "shuffle preserves sum")

  let colors = ["red", "green", "blue"]
  let wts = [70, 20, 10]
  let counts = {"red": 0, "green": 0, "blue": 0}
  let i = 0
  while i < 100
    let c = weighted_choice(colors, wts)
    counts[c] = counts[c] + 1
    i = i + 1
  assert(counts["red"] > 0, "red picked at least once")
  assert(counts["red"] + counts["green"] + counts["blue"] == 100, "total 100")

  print("samplex: all passed")
