// KAT for std/image/img_histogram — grayscale image histogram and equalization.
import std/image/img_histogram

fn main()
    // KAT 1: img_histogram([0,0,255]) — hist[0]==2, hist[255]==1, rest==0
    let px1 = []
    px1.push(0)
    px1.push(0)
    px1.push(255)
    let h1 = img_histogram(px1)
    let h1_0 = h1[0]
    let h1_255 = h1[255]
    if h1_0 != 2
        print("FAIL hist[0]: got " + str(h1_0) + " want 2")
        exit(1)
    if h1_255 != 1
        print("FAIL hist[255]: got " + str(h1_255) + " want 1")
        exit(1)
    // All other bins must be 0
    let i = 1
    while i < 255
        let bv = h1[i]
        if bv != 0
            print("FAIL hist[" + str(i) + "]: got " + str(bv) + " want 0")
            exit(1)
        i = i + 1

    // KAT 2: hist length must be exactly 256
    let hn = len(h1)
    if hn != 256
        print("FAIL hist length: got " + str(hn) + " want 256")
        exit(1)

    // KAT 3: hist_min([50,100,200]) == 50
    let px3 = []
    px3.push(50)
    px3.push(100)
    px3.push(200)
    let mn3 = hist_min(px3)
    if mn3 != 50
        print("FAIL hist_min: got " + str(mn3) + " want 50")
        exit(1)

    // KAT 4: hist_max([50,100,200]) == 200
    let mx4 = hist_max(px3)
    if mx4 != 200
        print("FAIL hist_max: got " + str(mx4) + " want 200")
        exit(1)

    // KAT 5: hist_mean([100,200]) == 150  (floor((100+200)/2) = 150)
    let px5 = []
    px5.push(100)
    px5.push(200)
    let mn5 = hist_mean(px5)
    if mn5 != 150
        print("FAIL hist_mean: got " + str(mn5) + " want 150")
        exit(1)

    // KAT 6: hist_mean([0]) == 0
    let px6 = []
    px6.push(0)
    let mn6 = hist_mean(px6)
    if mn6 != 0
        print("FAIL hist_mean_zero: got " + str(mn6) + " want 0")
        exit(1)

    // KAT 7: img_histogram of single pixel 128 => hist[128]==1, all others 0
    let px7 = []
    px7.push(128)
    let h7 = img_histogram(px7)
    let h7_128 = h7[128]
    if h7_128 != 1
        print("FAIL hist_single_pixel[128]: got " + str(h7_128) + " want 1")
        exit(1)
    let h7_0 = h7[0]
    if h7_0 != 0
        print("FAIL hist_single_pixel[0]: got " + str(h7_0) + " want 0")
        exit(1)

    // KAT 8: img_equalize of a uniform image is unchanged.
    // All pixels the same value => cdf_min == n == denom => output == input.
    let px8 = []
    px8.push(128)
    px8.push(128)
    px8.push(128)
    px8.push(128)
    let eq8 = img_equalize(px8)
    let eq8n = len(eq8)
    if eq8n != 4
        print("FAIL equalize_uniform length: got " + str(eq8n) + " want 4")
        exit(1)
    let j = 0
    while j < 4
        let gv = eq8[j]
        if gv != 128
            print("FAIL equalize_uniform[" + str(j) + "]: got " + str(gv) + " want 128")
            exit(1)
        j = j + 1

    // KAT 9: img_equalize of [0,255] should map to [0,255]
    // n=2, hist[0]=1, hist[255]=1
    // CDF: cdf[0]=1, cdf[255]=2
    // cdf_min=1, denom=2-1=1
    // lut[0] = round((1-1)*255/1) = 0
    // lut[255] = round((2-1)*255/1) = 255
    let px9 = []
    px9.push(0)
    px9.push(255)
    let eq9 = img_equalize(px9)
    let eq9_0 = eq9[0]
    let eq9_1 = eq9[1]
    if eq9_0 != 0
        print("FAIL equalize_0_255[0]: got " + str(eq9_0) + " want 0")
        exit(1)
    if eq9_1 != 255
        print("FAIL equalize_0_255[1]: got " + str(eq9_1) + " want 255")
        exit(1)

    // KAT 10: hist_mean with floor behavior: [0,1] => 0
    let px10 = []
    px10.push(0)
    px10.push(1)
    let mn10 = hist_mean(px10)
    if mn10 != 0
        print("FAIL hist_mean_floor: got " + str(mn10) + " want 0")
        exit(1)

    // KAT 11: histogram sum equals number of pixels
    let px11 = []
    px11.push(10)
    px11.push(20)
    px11.push(30)
    px11.push(10)
    let h11 = img_histogram(px11)
    let total = 0
    let k = 0
    while k < 256
        total = total + h11[k]
        k = k + 1
    if total != 4
        print("FAIL hist_sum: got " + str(total) + " want 4")
        exit(1)

    print("PASS _img_histogram_test")
