// KAT for std/math/interp — map_range/clamp01/inv_lerp/smoothstep (epsilon compares).
import std/math/interp

fn ckf(label: string, got: float, want: float)
    let d = got - want
    if d < 0.0
        d = 0.0 - d
    if d > 0.001
        print("FAIL " + label + ": " + str(got) + " != " + str(want))
        exit(1)

fn main()
    ckf("mr1", map_range(5, 0, 10, 0, 100), 50.0)
    ckf("mr2", map_range(0, 0, 10, 100, 200), 100.0)
    ckf("mr3", map_range(10, 0, 10, 0, 100), 100.0)
    ckf("c1", clamp01(1.5), 1.0)
    ckf("c2", clamp01(0.0 - 0.5), 0.0)
    ckf("c3", clamp01(0.5), 0.5)
    ckf("inv", inv_lerp(0.0, 10.0, 5.0), 0.5)
    ckf("ss0", smoothstep(0.0), 0.0)
    ckf("ss1", smoothstep(1.0), 1.0)
    ckf("ss5", smoothstep(0.5), 0.5)
    print("_interp_test passed")
