import std/game2d/sweep_test

// approx: float equality within tolerance.
fn approx(a: float, b: float, tol: float) -> bool
    let diff = a - b
    if diff < 0.0
        diff = 0.0 - diff
    let ok = diff <= tol
    ok

// ckf: check float within tolerance; exit 1 on mismatch.
fn ckf(label: string, got: float, want: float, tol: float) -> any
    if not approx(got, want, tol)
        print("FAIL sweep_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)
    0

// cki: check int equality.
fn cki(label: string, got: int, want: int) -> any
    if got != want
        print("FAIL sweep_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)
    0

// ckb: check bool.
fn ckb(label: string, got: bool, want: bool) -> any
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL sweep_test " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)
    0

fn main()
    let tol = 0.0001

    // === KAT 1: sw_broadphase_box ===
    // box [0,0,1,1] vx=4, vy=0 -> swept box [0,0,5,1]
    let box1 = []
    push(box1, 0)
    push(box1, 0)
    push(box1, 1)
    push(box1, 1)
    let bpb = sw_broadphase_box(box1, 4.0, 0.0)
    ckf("broadphase_x", bpb[0], 0.0, tol)
    ckf("broadphase_y", bpb[1], 0.0, tol)
    ckf("broadphase_w", bpb[2], 5.0, tol)
    ckf("broadphase_h", bpb[3], 1.0, tol)

    // === KAT 2: sw_slab — normal case ===
    // o=0, d=1, slab [3,5] -> t_near=3, t_far=5
    let sl1 = sw_slab(0.0, 1.0, 3.0, 5.0)
    ckf("slab_near", sl1[0], 3.0, tol)
    ckf("slab_far", sl1[1], 5.0, tol)

    // negative direction: o=6, d=-1, slab [3,5] -> t1=(3-6)/(-1)=3, t2=(5-6)/(-1)=1 -> near=1, far=3
    let sl2 = sw_slab(6.0, -1.0, 3.0, 5.0)
    ckf("slab_neg_near", sl2[0], 1.0, tol)
    ckf("slab_neg_far", sl2[1], 3.0, tol)

    // parallel (d=0), origin=0 OUTSIDE slab [3,5]: returns (big, neg_big) = miss sentinel (tmin > tmax)
    let sl3 = sw_slab(0.0, 0.0, 3.0, 5.0)
    // tmin should be a large positive sentinel (bigger than tmax = negative sentinel)
    if sl3[0] <= sl3[1]
        print("FAIL sweep_test slab_parallel_outside_miss: tmin=" + str(sl3[0]) + " should be > tmax=" + str(sl3[1]))
        exit(1)

    // parallel (d=0), origin=4 INSIDE slab [3,5]: returns (neg_big, big) = always-overlap sentinel
    let sl3b = sw_slab(4.0, 0.0, 3.0, 5.0)
    if sl3b[0] >= 0.0
        print("FAIL sweep_test slab_parallel_inside_near should be large negative: got=" + str(sl3b[0]))
        exit(1)
    if sl3b[1] <= 1000.0
        print("FAIL sweep_test slab_parallel_inside_far should be large positive: got=" + str(sl3b[1]))
        exit(1)

    // === KAT 3: sw_ray_aabb ===
    // Ray (0, 0.5) dir (1,0) vs box [5,0,1,1]
    // x-slab: (5-0)/1=5, (6-0)/1=6 -> tmin=5, tmax=6
    // y-slab: (0-0.5)/0=parallel no constraint
    // combined tmin=5, tmax=6 -> hit=true
    let box_tgt = []
    push(box_tgt, 5)
    push(box_tgt, 0)
    push(box_tgt, 1)
    push(box_tgt, 1)
    let ray1 = sw_ray_aabb(0.0, 0.5, 1.0, 0.0, box_tgt)
    ckb("ray_aabb_hit", ray1["hit"], true)
    ckf("ray_aabb_tmin", ray1["tmin"], 5.0, tol)

    // Ray at angle going through the box: origin (0,5) dir (1,-1).
    // At t=5: x=5, y=0 (corner of box). Box y=[0,1], so y=0 is on the boundary -> hit.
    let ray3 = sw_ray_aabb(0.0, 5.0, 1.0, -1.0, box_tgt)
    ckb("ray_aabb_diagonal_hit", ray3["hit"], true)

    // Ray in completely wrong direction: origin (0,0.5) dir (-1, 0) away from box at x=5
    // x-slab t_near=(5-0)/(-1)=-5, t_far=(6-0)/(-1)=-6 -> tmin=max(-6,-big)=-6 tmax=min(-5,+big)=-5
    // tmin=-6 < tmax=-5 but tmax=-5 < 0 -> no hit
    let ray4 = sw_ray_aabb(0.0, 0.5, -1.0, 0.0, box_tgt)
    ckb("ray_aabb_behind_miss", ray4["hit"], false)

    // === KAT 4: sw_time_of_impact — exact contact at t=1 ===
    // box [0,0,1,1] vx=4, vy=0 vs target [5,0,1,1]
    // Minkowski expand target by box dims: etx=5-1=4, ety=0-1=-1, etw=1+1=2, eth=1+1=2
    // expanded target: [4,-1,2,2] x-extent=[4,6], y-extent=[-1,1]
    // Ray from (0,0) with (4,0):
    // x-slab: (4-0)/4=1.0, (6-0)/4=1.5 -> tmin_x=1.0, tmax_x=1.5
    // y-slab: o=0, d=0, slab=[-1,1] -> parallel -> (-big,+big)
    // combined tmin=1.0, tmax=1.5 -> hit, t=1.0 (clamped to [0,1))
    // BUT t >= 1.0 returns no_hit (since we check tmin >= 1.0). So t_of_impact = 1.0 (no-hit fallback).
    let moving = []
    push(moving, 0)
    push(moving, 0)
    push(moving, 1)
    push(moving, 1)
    let target1 = []
    push(target1, 5)
    push(target1, 0)
    push(target1, 1)
    push(target1, 1)
    let t1 = sw_time_of_impact(moving, 4.0, 0.0, target1)
    ckf("toi_vx4_exactly_1", t1, 1.0, tol)

    // === KAT 5: sw_time_of_impact — hit at t=0.5 ===
    // box [0,0,1,1] vx=8, vy=0 vs target [5,0,1,1]
    // expanded: [4,-1,2,2]. Ray (0,0) vel (8,0):
    // x: (4-0)/8=0.5, (6-0)/8=0.75 -> tmin=0.5
    // t=0.5 < 1.0 -> hit
    let t2 = sw_time_of_impact(moving, 8.0, 0.0, target1)
    ckf("toi_vx8_half", t2, 0.5, tol)

    // === KAT 6: sw_will_collide ===
    ckb("will_collide_vx8", sw_will_collide(moving, 8.0, 0.0, target1), true)

    // Different Y — box [0,0,1,1] vx=8 vs target [5,10,1,1]
    let target2 = []
    push(target2, 5)
    push(target2, 10)
    push(target2, 1)
    push(target2, 1)
    ckb("will_not_collide_diff_y", sw_will_collide(moving, 8.0, 0.0, target2), false)

    // === KAT 7: sw_aabb — surface normal ===
    // Hitting from left (positive x motion): normal should be (-1, 0) — pointing left away from target
    let col = sw_aabb(moving, 8.0, 0.0, target1)
    ckb("sw_aabb_hit", col["hit"], true)
    ckf("sw_aabb_t", col["t"], 0.5, tol)
    ckf("sw_aabb_nx", col["nx"], -1.0, tol)
    ckf("sw_aabb_ny", col["ny"], 0.0, tol)

    // === KAT 8: sw_resolve ===
    // Safe end position at t=0.5 with vx=8: x=0 + 8*0.5=4, y=0
    let res = sw_resolve(moving, 8.0, 0.0, target1)
    ckf("resolve_x", res[0], 4.0, tol)
    ckf("resolve_y", res[1], 0.0, tol)

    // === KAT 9: no collision — full displacement ===
    // box [0,0,1,1] vx=1 vs target [100,0,1,1] -> no hit, t=1.0, resolve=(1,0)
    let far_target = []
    push(far_target, 100)
    push(far_target, 0)
    push(far_target, 1)
    push(far_target, 1)
    ckb("no_hit_far", sw_will_collide(moving, 1.0, 0.0, far_target), false)
    let res2 = sw_resolve(moving, 1.0, 0.0, far_target)
    ckf("resolve_no_hit_x", res2[0], 1.0, tol)

    // === KAT 10: broadphase with negative velocity ===
    // box [5,5,1,1] vx=-4 vy=0 -> start x=5, end x=1; swept min_x=1, max_x=6 -> w=5
    let box2 = []
    push(box2, 5)
    push(box2, 5)
    push(box2, 1)
    push(box2, 1)
    let bpb2 = sw_broadphase_box(box2, -4.0, 0.0)
    ckf("broadphase_neg_x", bpb2[0], 1.0, tol)
    ckf("broadphase_neg_w", bpb2[2], 5.0, tol)

    // === KAT 11: zero velocity — no hit (box not moving) ===
    ckb("zero_vel_no_hit", sw_will_collide(moving, 0.0, 0.0, target1), false)

    print("PASS _sweep_test_test")

main()
