// KAT test for std/data/geojson_build
import std/data/geojson_build
import std/data/geojson_parse

// ── Helpers ───────────────────────────────────────────────────────────────────

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + got + " expected=" + expected)
        exit(1)

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

fn contains_sub(s, needle) -> int
    let sn = len(s)
    let nn = len(needle)
    let found = 0
    let i = 0
    let done = 0
    while i <= sn - nn and done == 0
        let matched = 1
        let j = 0
        while j < nn and matched == 1
            if char_at(s, i + j) != char_at(needle, j)
                matched = 0
            j = j + 1
        if matched == 1
            found = 1
            done = 1
        i = i + 1
    found

fn ck_contains(label, s, needle)
    let ok = contains_sub(s, needle)
    if ok == 0
        print("FAIL " + label + ": " + s + " does not contain " + needle)
        exit(1)

fn approx(a, b, tol) -> int
    let diff = a - b
    let adiff = diff
    if diff < 0.0
        adiff = 0.0 - diff
    let ok = 1
    if adiff > tol
        ok = 0
    ok

fn ckf(label, got, expected, tol)
    let ok = approx(got, expected, tol)
    if ok == 0
        print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

// ── Test 1: build a Point ─────────────────────────────────────────────────────

let g1 = {}
g1["type"] = "Point"
let c1 = []
push(c1, 1.0)
push(c1, 2.0)
g1["coordinates"] = c1
let s1 = geojson_build(g1)
ck_contains("point_has_type",  s1, "Point")
ck_contains("point_has_coord", s1, "coordinates")
ck_contains("point_has_1", s1, "1")
ck_contains("point_has_2", s1, "2")

// ── Test 2: build a LineString ────────────────────────────────────────────────

let g2 = {}
g2["type"] = "LineString"
let p2a = []
push(p2a, 0.0)
push(p2a, 0.0)
let p2b = []
push(p2b, 3.0)
push(p2b, 4.0)
let c2 = []
push(c2, p2a)
push(c2, p2b)
g2["coordinates"] = c2
let s2 = geojson_build(g2)
ck_contains("ls_has_type",  s2, "LineString")
ck_contains("ls_has_coord", s2, "coordinates")
ck_contains("ls_has_3", s2, "3")
ck_contains("ls_has_4", s2, "4")

// ── Test 3: round-trip Point ──────────────────────────────────────────────────
// build -> string -> parse -> check values preserved

let rt_geom = {}
rt_geom["type"] = "Point"
let rt_c = []
push(rt_c, 10.5)
push(rt_c, 20.25)
rt_geom["coordinates"] = rt_c
let rt_str = geojson_build(rt_geom)
let rt_parsed = geojson_parse(rt_str)
cks("rt_type", rt_parsed["type"], "Point")
let rt_coords = rt_parsed["coordinates"]
cki("rt_len", len(rt_coords), 2)
let rt_lon = rt_coords[0]
let rt_lat = rt_coords[1]
ckf("rt_lon", rt_lon, 10.5, 0.001)
ckf("rt_lat", rt_lat, 20.25, 0.001)

// ── Test 4: round-trip LineString ─────────────────────────────────────────────

let rt2 = {}
rt2["type"] = "LineString"
let rt2_pa = []
push(rt2_pa, 1.0)
push(rt2_pa, 2.0)
let rt2_pb = []
push(rt2_pb, 3.0)
push(rt2_pb, 4.0)
let rt2_c = []
push(rt2_c, rt2_pa)
push(rt2_c, rt2_pb)
rt2["coordinates"] = rt2_c
let rt2_str = geojson_build(rt2)
let rt2_p = geojson_parse(rt2_str)
cks("rt2_type", rt2_p["type"], "LineString")
let rt2_coords = rt2_p["coordinates"]
cki("rt2_len", len(rt2_coords), 2)
let rt2_p0 = rt2_coords[0]
let rt2_p0_lon = rt2_p0[0]
ckf("rt2_p0_lon", rt2_p0_lon, 1.0, 0.001)

print("PASS _geojson_build_test")
