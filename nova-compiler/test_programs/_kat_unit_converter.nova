import forge_unit_converter

fn main()
    let u = uc_new()
    u = uc_add_conversion(u, "km", "m", 1000)
    u = uc_add_conversion(u, "kg", "g", 1000)
    u = uc_add_conversion(u, "hr", "min", 60)
    assert(uc_conversion_count(u) == 3, "3 conversions")

    let r1 = uc_convert(u, 5, "km", "m")
    assert(is_ok(r1), "convert ok")
    assert(unwrap(r1) == 5000, "5km = 5000m")

    let r2 = uc_convert(u, 10, "m", "m")
    assert(is_ok(r2), "same unit")
    assert(unwrap(r2) == 10, "identity")

    let r3 = uc_convert(u, 1, "m", "km")
    assert(is_err(r3), "no reverse conversion")

    assert(uc_has_conversion(u, "km", "m") == 1, "has km->m")
    assert(uc_has_conversion(u, "m", "km") == 0, "no m->km")
    assert(uc_total_conversions(u) == 1, "1 total conversion")

    print("UNIT-CONVERTER KAT PASS")
