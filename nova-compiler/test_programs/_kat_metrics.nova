import forge_metrics

fn main()
    let r = metrics_registry()
    r = metrics_counter(r, "http_requests", "Total HTTP requests")
    r = metrics_inc(r, "http_requests")
    r = metrics_inc(r, "http_requests")
    r = metrics_inc_by(r, "http_requests", 5)
    assert(metrics_get_counter(r, "http_requests") == 7, "counter=7")

    r = metrics_gauge(r, "cpu_usage", "CPU usage percent")
    r = metrics_set(r, "cpu_usage", 45)
    assert(metrics_get_gauge(r, "cpu_usage") == 45, "gauge=45")
    r = metrics_set(r, "cpu_usage", 72)
    assert(metrics_get_gauge(r, "cpu_usage") == 72, "gauge=72")

    let buckets = [10, 50, 100, 500, 1000]
    r = metrics_histogram(r, "latency_ms", "Request latency", buckets)
    r = metrics_observe(r, "latency_ms", 5)
    r = metrics_observe(r, "latency_ms", 42)
    r = metrics_observe(r, "latency_ms", 150)
    r = metrics_observe(r, "latency_ms", 800)

    assert(metrics_get_counter(r, "missing") == 0, "missing counter=0")

    let text = metrics_export_text(r)
    assert(len(text) > 0, "export not empty")
    assert(contains(text, "http_requests"), "export has counter")
    assert(contains(text, "cpu_usage"), "export has gauge")

    print("METRICS KAT PASS")
