import forge_bitio

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn joinl(xs: list) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + ","
        out = out + str(xs[i])
        i = i + 1
    out

fn main()
    let fails = 0

    // 3-bit 5 (101) + 5-bit 20 (10100) => 10110100 = 180
    let w = bw_new()
    bw_write_bits(w, 5, 3)
    bw_write_bits(w, 20, 5)
    fails = fails + expect("bits_written", str(bw_bitcount(w)), "8")
    let b1 = bw_finish(w)
    fails = fails + expect("byte180", joinl(b1), "180")

    let r = br_new(b1)
    fails = fails + expect("read3", str(br_read_bits(r, 3)), "5")
    fails = fails + expect("read5", str(br_read_bits(r, 5)), "20")

    // two nibbles 0xA, 0xB => 0xAB = 171
    let w2 = bw_new()
    bw_write_bits(w2, 10, 4)
    bw_write_bits(w2, 11, 4)
    let b2 = bw_finish(w2)
    fails = fails + expect("nibbles", joinl(b2), "171")
    let r2 = br_new(b2)
    fails = fails + expect("nib_a", str(br_read_bits(r2, 4)), "10")
    fails = fails + expect("nib_b", str(br_read_bits(r2, 4)), "11")

    // 12-bit value 0xABC (2748) spans two bytes: AB C0 = 171,192
    let w3 = bw_new()
    bw_write_bits(w3, 2748, 12)
    let b3 = bw_finish(w3)
    fails = fails + expect("span", joinl(b3), "171,192")
    let r3 = br_new(b3)
    fails = fails + expect("span_read", str(br_read_bits(r3, 12)), "2748")

    // 1 bit + 7 bits: 1_0101010 = 0xAA = 170
    let w4 = bw_new()
    bw_write_bits(w4, 1, 1)
    bw_write_bits(w4, 42, 7)
    let b4 = bw_finish(w4)
    fails = fails + expect("flag", joinl(b4), "170")
    let r4 = br_new(b4)
    fails = fails + expect("flag_read", str(br_read_bits(r4, 1)), "1")
    fails = fails + expect("count_read", str(br_read_bits(r4, 7)), "42")

    // round-trip a heterogeneous record: 3,5,12,1,7 bit fields
    let w5 = bw_new()
    bw_write_bits(w5, 6, 3)
    bw_write_bits(w5, 25, 5)
    bw_write_bits(w5, 4000, 12)
    bw_write_bits(w5, 0, 1)
    bw_write_bits(w5, 99, 7)
    let b5 = bw_finish(w5)
    let r5 = br_new(b5)
    fails = fails + expect("rt1", str(br_read_bits(r5, 3)), "6")
    fails = fails + expect("rt2", str(br_read_bits(r5, 5)), "25")
    fails = fails + expect("rt3", str(br_read_bits(r5, 12)), "4000")
    fails = fails + expect("rt4", str(br_read_bits(r5, 1)), "0")
    fails = fails + expect("rt5", str(br_read_bits(r5, 7)), "99")

    // remaining bit count
    let r6 = br_new([255, 255])
    br_read_bits(r6, 5)
    fails = fails + expect("remaining", str(br_remaining(r6)), "11")

    if fails == 0
        print("forge_bitio: all passed")
    else
        print("forge_bitio: " + str(fails) + " FAILED")
