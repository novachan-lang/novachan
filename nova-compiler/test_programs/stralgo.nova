// stralgo — classic string algorithms in pure NOVA: edit distance (fuzzy match /
// typo suggestions), longest-common-subsequence length (diffs), and prefix/suffix
// helpers. No runtime/compiler changes; built on string + list primitives.

fn _min3(a: int, b: int, c: int) -> int
    let m = a
    if b < m
        m = b
    if c < m
        m = c
    return m

// Levenshtein edit distance (insert/delete/substitute), 1-D rolling DP.
fn levenshtein(a: string, b: string) -> int
    let n = len(a)
    let m = len(b)
    if n == 0
        return m
    if m == 0
        return n
    let prev = []
    let j = 0
    while j <= m
        push(prev, j)
        j = j + 1
    let i = 0
    while i < n
        let curr = [i + 1]
        let k = 0
        while k < m
            let cost = 1
            if a[i] == b[k]
                cost = 0
            push(curr, _min3(prev[k + 1] + 1, curr[k] + 1, prev[k] + cost))
            k = k + 1
        prev = curr
        i = i + 1
    return prev[m]

// Length of the longest common subsequence (order-preserving, not contiguous).
fn lcs_length(a: string, b: string) -> int
    let n = len(a)
    let m = len(b)
    let prev = []
    let j = 0
    while j <= m
        push(prev, 0)
        j = j + 1
    let i = 0
    while i < n
        let curr = [0]
        let k = 0
        while k < m
            if a[i] == b[k]
                push(curr, prev[k] + 1)
            else
                let best = prev[k + 1]
                if curr[k] > best
                    best = curr[k]
                push(curr, best)
            k = k + 1
        prev = curr
        i = i + 1
    return prev[m]

fn common_prefix_len(a: string, b: string) -> int
    let n = len(a)
    let m = len(b)
    let lim = n
    if m < lim
        lim = m
    let i = 0
    while i < lim and a[i] == b[i]
        i = i + 1
    return i

fn is_subsequence(sub: string, s: string) -> bool
    let i = 0
    let j = 0
    while i < len(sub) and j < len(s)
        if sub[i] == s[j]
            i = i + 1
        j = j + 1
    return i == len(sub)

fn main()
    // edit distance
    assert_eq(levenshtein("kitten", "sitting"), 3)
    assert_eq(levenshtein("flaw", "lawn"), 2)
    assert_eq(levenshtein("", "abc"), 3)
    assert_eq(levenshtein("same", "same"), 0)
    assert_eq(levenshtein("abc", ""), 3)
    // typo-suggestion style: small distance to the intended word
    assert_eq(levenshtein("lenght", "length"), 2)

    // longest common subsequence
    assert_eq(lcs_length("ABCBDAB", "BDCAB"), 4)
    assert_eq(lcs_length("abc", "abc"), 3)
    assert_eq(lcs_length("abc", "xyz"), 0)

    // prefix
    assert_eq(common_prefix_len("foobar", "foobaz"), 5)
    assert_eq(common_prefix_len("abc", "xyz"), 0)

    // subsequence
    assert_eq(is_subsequence("ace", "abcde"), true)
    assert_eq(is_subsequence("aec", "abcde"), false)
    assert_eq(is_subsequence("", "abc"), true)

    print("stralgo passed")
