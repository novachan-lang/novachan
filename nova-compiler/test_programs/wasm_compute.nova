// Pure-compute NOVA program compiled to WebAssembly and run in Node (the browser/
// frontend target). No IO/threads/net (not available in the wasm compute sandbox).
// main() RETURNS sum(1..100) = 5050 — the Node host reads the return value of the
// exported nova_user_main (stdout is a no-op stub in wasm).
fn main()
    let total = 0
    let i = 1
    while i <= 100
        total = total + i
        i = i + 1
    total
