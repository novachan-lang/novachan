import std/typesystem/type_curry

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _type_curry_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL _type_curry_test " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL _type_curry_test " + label + ": got=" + got + " want=" + want)
        exit(1)

// ── Proof term builders ──────────────────────────────────────────────────────

fn mk_var(name: string) -> list
    let t = []
    push(t, "var")
    push(t, name)
    return t

fn mk_lam(name: string, body: list) -> list
    let t = []
    push(t, "lam")
    push(t, name)
    push(t, body)
    return t

fn mk_app(f: list, a: list) -> list
    let t = []
    push(t, "app")
    push(t, f)
    push(t, a)
    return t

fn main()
    let ctx = []

    // ── Spec KAT: I combinator ──

    // I = lam x.x inhabits a->a: true
    let I_term = mk_lam("x", mk_var("x"))
    let I_prop = tyc_arr(tyc_tvar(0), tyc_tvar(0))
    ckb("I inhabits a->a", tcur_check_proof(ctx, I_term, I_prop), true)

    // K = lam x. lam y. x inhabits a->b->a: true
    let K_term = mk_lam("x", mk_lam("y", mk_var("x")))
    let K_prop = tyc_arr(tyc_tvar(0), tyc_arr(tyc_tvar(1), tyc_tvar(0)))
    ckb("K inhabits a->b->a", tcur_check_proof(ctx, K_term, K_prop), true)

    // lam x.x does NOT inhabit a->b (a != b): false
    let bad_prop = tyc_arr(tyc_tvar(0), tyc_tvar(1))
    ckb("I does NOT inhabit a->b", tcur_check_proof(ctx, I_term, bad_prop), false)

    // S = lam f. lam g. lam x. (f x)(g x) inhabits (a->b->c)->(a->b)->a->c: true
    let S_fx = mk_app(mk_var("f"), mk_var("x"))
    let S_gx = mk_app(mk_var("g"), mk_var("x"))
    let S_fxgx = mk_app(S_fx, S_gx)
    let S_term = mk_lam("f", mk_lam("g", mk_lam("x", S_fxgx)))
    let a = tyc_tvar(0)
    let b = tyc_tvar(1)
    let c = tyc_tvar(2)
    let S_prop = tyc_arr(tyc_arr(a, tyc_arr(b, c)), tyc_arr(tyc_arr(a, b), tyc_arr(a, c)))
    ckb("S inhabits (a->b->c)->(a->b)->a->c", tcur_check_proof(ctx, S_term, S_prop), true)

    // ── Additional proof-check tests ──

    // var x : a, when x:a is in context
    let entry = []
    push(entry, "x")
    push(entry, tyc_tvar(0))
    let ctx1 = []
    push(ctx1, entry)
    ckb("var x:a in ctx", tcur_check_proof(ctx1, mk_var("x"), tyc_tvar(0)), true)

    // var x : a does not inhabit b (different tvar)
    ckb("var x:a not b", tcur_check_proof(ctx1, mk_var("x"), tyc_tvar(1)), false)

    // app: in context f:(a->b), x:a, the term (f x) has type b
    let ef = []
    push(ef, "f")
    push(ef, tyc_arr(tyc_tvar(0), tyc_tvar(1)))
    let ex_fx = []
    push(ex_fx, ef)
    let efx = []
    push(efx, "x")
    push(efx, tyc_tvar(0))
    push(ex_fx, efx)
    let fx_term = mk_app(mk_var("f"), mk_var("x"))
    ckb("f x : b in ctx f:a->b, x:a", tcur_check_proof(ex_fx, fx_term, tyc_tvar(1)), true)
    ckb("f x not : a in ctx f:a->b, x:a", tcur_check_proof(ex_fx, fx_term, tyc_tvar(0)), false)

    // K applied via context variable: in ctx k:a->b->a, x:a, y:b, (k x y) : a
    let ctx_k = []
    let ek = []
    push(ek, "k")
    push(ek, K_prop)
    push(ctx_k, ek)
    let ex_k = []
    push(ex_k, "x")
    push(ex_k, tyc_tvar(0))
    push(ctx_k, ex_k)
    let ey_k = []
    push(ey_k, "y")
    push(ey_k, tyc_tvar(1))
    push(ctx_k, ey_k)
    let kxy = mk_app(mk_app(mk_var("k"), mk_var("x")), mk_var("y"))
    ckb("k x y : a (ctx k:a->b->a)", tcur_check_proof(ctx_k, kxy, tyc_tvar(0)), true)
    ckb("k x y not : b (ctx k:a->b->a)", tcur_check_proof(ctx_k, kxy, tyc_tvar(1)), false)

    // ── tcur_is_tautology_simple tests ──

    // I prop: a -> a
    ckb("is_tautology I", tcur_is_tautology_simple(tyc_arr(tyc_tvar(0), tyc_tvar(0))), true)
    // K prop (different tvar ids but same structure)
    ckb("is_tautology K", tcur_is_tautology_simple(tyc_arr(tyc_tvar(5), tyc_arr(tyc_tvar(7), tyc_tvar(5)))), true)
    // S prop (different tvar ids but same structure)
    let sa = tyc_tvar(10)
    let sb = tyc_tvar(11)
    let sc = tyc_tvar(12)
    let S_prop2 = tyc_arr(tyc_arr(sa, tyc_arr(sb, sc)), tyc_arr(tyc_arr(sa, sb), tyc_arr(sa, sc)))
    ckb("is_tautology S", tcur_is_tautology_simple(S_prop2), true)

    // Non-tautology: a -> b (not I, K, or S)
    ckb("is_tautology a->b = false", tcur_is_tautology_simple(tyc_arr(tyc_tvar(0), tyc_tvar(1))), false)
    // Non-tautology: int (base type)
    ckb("is_tautology int = false", tcur_is_tautology_simple(tyc_int()), false)

    print("PASS _type_curry_test")
