// Bootstrap test 18: null values and unary operators
// Null used 27 times, unary operators used extensively in the compiler

// Null literal
let x = null
if x == null
    print("null_ok")

// Unary minus
let a = 5
let b = -a
print(b)

let c = -10
print(c)

// Unary not
let t = true
let f = not t
if f == false
    print("not_ok")

// Unary minus in expressions
let result = 10 + -3
print(result)

// Null as function return
fn find_item(items, target)
    let i = 0
    while i < len(items)
        if items[i] == target
            return items[i]
        i = i + 1
    return null

let found = find_item([1, 2, 3], 2)
print(found)
let missing = find_item([1, 2, 3], 9)
if missing == null
    print("not_found")
