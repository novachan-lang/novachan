import forge_adler

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn main()
    let fails = 0

    // Adler-32 known vectors
    // adler32("") = 1
    fails = fails + expect("adler_empty", str(adler32("")), "1")
    // adler32("Wikipedia") = 0x11E60398 = 300286872
    fails = fails + expect("adler_wikipedia", str(adler32("Wikipedia")), "300286872")

    // Fletcher-16 known vectors (Wikipedia)
    // fletcher16("abcde") = 0xC8F0 = 51440
    fails = fails + expect("fletcher_abcde", str(fletcher16("abcde")), "51440")
    // fletcher16("abcdef") = 0x2057 = 8279
    fails = fails + expect("fletcher_abcdef", str(fletcher16("abcdef")), "8279")
    // fletcher16("abcdefgh") = 0x0627 = 1575
    fails = fails + expect("fletcher_abcdefgh", str(fletcher16("abcdefgh")), "1575")

    // position-sensitive: reordering changes the checksum (unlike a plain sum)
    fails = fails + expect_true("adler_position", adler32("ab") != adler32("ba"))
    fails = fails + expect_true("fletcher_position", fletcher16("ab") != fletcher16("ba"))

    // deterministic
    fails = fails + expect_true("deterministic", adler32("hello world") == adler32("hello world"))

    // verify helper: matches for the same data, fails for corrupted
    let cs = adler32("important data")
    fails = fails + expect_true("verify_ok", adler32_verify("important data", cs))
    fails = fails + expect_true("verify_corrupt", adler32_verify("important dat!", cs) == false)

    // a single bit/char change alters the checksum
    fails = fails + expect_true("sensitive", adler32("test") != adler32("Test"))

    if fails == 0
        print("forge_adler: all passed")
    else
        print("forge_adler: " + str(fails) + " FAILED")
