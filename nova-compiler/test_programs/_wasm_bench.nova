// Compute microbench: a tight scalar-int loop (zero annotations -> specialized to native mul/add). Same source
// runs native AND wasm; compare per-iteration speed to see if the wasm value-model is native-class.
fn bench(n: int) -> int
    let s = 0
    let i = 0
    while i < n
        s = s + i * i
        i = i + 1
    s
fn main()
    print(bench(30000000))
