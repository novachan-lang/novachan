// Forge S5 LiveView: the mount frame. live_mount_json carries the statics (once) + initial dynamics so
// the client renders the full document, then applies patch frames by slot. Asserts: s[] + d[] present,
// dynamics stringified, statics JSON-escaped. With patch_json this is the complete wire protocol.
// Pure, socketless, deterministic.
import forge_live

fn main()
    let q = chr(34)
    let bs = chr(92)

    let m = live_mount_json(["<p>n=", "</p>"], [5])
    if find(m, q + "s" + q + ":[") < 0
        print("FAIL: missing s array -> " + m)
        exit(1)
    if find(m, q + "d" + q + ":[") < 0
        print("FAIL: missing d array -> " + m)
        exit(1)
    if find(m, q + "<p>n=" + q) < 0
        print("FAIL: static 0 missing -> " + m)
        exit(1)
    if find(m, q + "5" + q) < 0
        print("FAIL: dynamic 0 should be stringified -> " + m)
        exit(1)

    // a static containing a quote must be escaped
    let m2 = live_mount_json([q], ["x"])
    if find(m2, bs + q) < 0
        print("FAIL: a quote in a static must be JSON-escaped -> " + m2)
        exit(1)

    print("PASS forge_live_mount (mount frame: s[] statics + d[] stringified dynamics, escaped)")
