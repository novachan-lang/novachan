import forge_cqrs_store

fn main()
    let c = cqrs_new()
    c = cqrs_command(c, "create_user", "alice")
    c = cqrs_command(c, "update_email", "alice@example.com")
    c = cqrs_command(c, "create_user", "bob")
    assert(cqrs_event_count(c) == 3, "3 events")
    assert(cqrs_command_count(c) == 3, "3 commands")

    let q1 = cqrs_query(c, "update_email")
    assert(is_ok(q1), "query ok")
    assert(unwrap(q1) == "alice@example.com", "email found")

    let q2 = cqrs_query(c, "create_user")
    assert(is_ok(q2), "query2 ok")
    assert(unwrap(q2) == "bob", "latest create_user=bob")

    assert(cqrs_query_count(c) == 2, "2 queries")

    let q3 = cqrs_query(c, "delete_user")
    assert(is_err(q3), "no delete events")

    let e0 = cqrs_event_at(c, 0)
    assert(is_ok(e0), "event 0 ok")
    assert(unwrap(e0) == "alice", "event 0 data")

    let t0 = cqrs_event_type(c, 0)
    assert(is_ok(t0), "type 0 ok")
    assert(unwrap(t0) == "create_user", "type 0")

    let bad = cqrs_event_at(c, 10)
    assert(is_err(bad), "out of range")

    print("CQRS-STORE KAT PASS")
