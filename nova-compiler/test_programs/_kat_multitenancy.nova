import forge_multitenancy

fn main()
    let r = mt_registry()
    r = mt_register(r, "t1", "Acme Corp")
    r = mt_register(r, "t2", "Globex Inc")

    let tenants = mt_list_tenants(r)
    assert(len(tenants) == 2, "2 tenants")

    r = mt_set_current(r, "t1")
    assert(mt_current(r) == "t1", "current=t1")

    assert(mt_is_active(r, "t1") == true, "t1 active")
    r = mt_deactivate(r, "t1")
    assert(mt_is_active(r, "t1") == false, "t1 inactive")
    r = mt_activate(r, "t1")
    assert(mt_is_active(r, "t1") == true, "t1 re-active")

    r = mt_set_quota(r, "t1", 1000)
    r = mt_use_quota(r, "t1", 300)
    assert(mt_quota_remaining(r, "t1") == 700, "700 remaining")
    r = mt_use_quota(r, "t1", 200)
    assert(mt_quota_remaining(r, "t1") == 500, "500 remaining")

    r = mt_set_config(r, "t2", "theme", "dark")
    assert(mt_get_config(r, "t2", "theme") == "dark", "config=dark")
    assert(mt_get_config(r, "t2", "missing") == "", "missing config empty")

    let scoped = mt_scoped_key(r, "users")
    assert(scoped == "t1:users", "scoped key")

    print("MULTITENANCY KAT PASS")
