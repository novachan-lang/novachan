// Distributed channels over TCP: a client green-task connects to a server (main),
// they round-trip a JSON-serialized value. Proves remote_listen/connect/send/recv/close.
fn client(port)
    let ch = remote_connect("127.0.0.1", port)
    remote_send(ch, 42)
    let reply = remote_recv(ch)
    assert_eq(reply, 142)
    remote_close(ch)

fn main()
    let port = 19911
    spawn client(port)
    let ch = remote_listen(port)      // bind+listen, then park on accept (client connects meanwhile)
    let msg = remote_recv(ch)
    assert_eq(msg, 42)
    remote_send(ch, msg + 100)
    remote_close(ch)
    print("remote_test passed: round-trip 42 -> 142")
