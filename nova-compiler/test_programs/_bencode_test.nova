// KAT test for std/data/bencode
import std/data/bencode

// Helper: check string equality
fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + got + " expected=" + expected)
        exit(1)

// Helper: check integer equality
fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

// ── Encode: integers ─────────────────────────────────────────────────────────
cks("enc_42",    bnc_encode(42),   "i42e")
cks("enc_0",     bnc_encode(0),    "i0e")
cks("enc_neg7",  bnc_encode(-7),   "i-7e")
cks("enc_1000",  bnc_encode(1000), "i1000e")

// ── Encode: strings ───────────────────────────────────────────────────────────
cks("enc_spam",  bnc_encode("spam"),  "4:spam")
cks("enc_empty", bnc_encode(""),      "0:")
cks("enc_hello", bnc_encode("hello"), "5:hello")

// ── Encode: lists ─────────────────────────────────────────────────────────────
cks("enc_list12",    bnc_encode([1, 2]),    "li1ei2ee")
cks("enc_list_empty", bnc_encode([]),       "le")
cks("enc_list_str",  bnc_encode(["ab"]),    "l2:abe")
cks("enc_nested",    bnc_encode([[1]]),     "lli1eee")

// ── Encode: dict ──────────────────────────────────────────────────────────────
let d1 = {}
d1["a"] = 1
cks("enc_dict_a1", bnc_encode(d1), "d1:ai1ee")

let d2 = {}
d2["foo"] = "bar"
cks("enc_dict_foobar", bnc_encode(d2), "d3:foo3:bare")

// Dict keys must be sorted: b before c
let d3 = {}
d3["c"] = 3
d3["b"] = 2
cks("enc_dict_sorted", bnc_encode(d3), "d1:bi2e1:ci3ee")

// ── Decode: integers ──────────────────────────────────────────────────────────
cki("dec_42",   bnc_decode("i42e"),  42)
cki("dec_0",    bnc_decode("i0e"),   0)
cki("dec_neg7", bnc_decode("i-7e"), -7)

// ── Decode: strings ───────────────────────────────────────────────────────────
cks("dec_spam",  bnc_decode("4:spam"),  "spam")
cks("dec_empty", bnc_decode("0:"),      "")
cks("dec_hello", bnc_decode("5:hello"), "hello")

// ── Decode: lists ─────────────────────────────────────────────────────────────
let lst = bnc_decode("li1ei2ee")
cki("dec_list_len", len(lst), 2)
cki("dec_list_0",   lst[0],   1)
cki("dec_list_1",   lst[1],   2)

let elst = bnc_decode("le")
cki("dec_empty_list_len", len(elst), 0)

// ── Decode: dict ──────────────────────────────────────────────────────────────
let dd = bnc_decode("d1:ai1ee")
cki("dec_dict_a", dd["a"], 1)

let dd2 = bnc_decode("d3:foo3:bare")
cks("dec_dict_foo", dd2["foo"], "bar")

// ── bnc_decode_at: positional decode ─────────────────────────────────────────
let pair1 = bnc_decode_at("i42e", 0)
cki("at_val",  pair1[0], 42)
cki("at_next", pair1[1], 4)

let pair2 = bnc_decode_at("4:spam", 0)
cks("at_str_val",  pair2[0], "spam")
cki("at_str_next", pair2[1], 6)

// ── Round-trip tests ──────────────────────────────────────────────────────────
cki("rt_int",  bnc_decode(bnc_encode(99)),   99)
cks("rt_str",  bnc_decode(bnc_encode("xyz")), "xyz")

let orig_list = [10, 20, 30]
let rt_lst = bnc_decode(bnc_encode(orig_list))
cki("rt_list_len", len(rt_lst), 3)
cki("rt_list_0",   rt_lst[0],   10)
cki("rt_list_1",   rt_lst[1],   20)
cki("rt_list_2",   rt_lst[2],   30)

// ── Nested round-trip ─────────────────────────────────────────────────────────
let nested = bnc_encode([[1, 2], [3]])
let n_dec = bnc_decode(nested)
cki("rt_nested_len",   len(n_dec),    2)
cki("rt_nested_0_len", len(n_dec[0]), 2)
cki("rt_nested_1_len", len(n_dec[1]), 1)

print("_bencode_test passed")
