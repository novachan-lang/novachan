// KAT test for std/dsp/normalize.nova
//
// Hand-computed reference values:
//   nrm_peak([1.0,-2.0,1.0])          = [0.5,-1.0,0.5]   (peak abs=2.0; /2.0)
//   nrm_minmax([0.0,5.0,10.0],0.0,1.0)= [0.0,0.5,1.0]    (min=0,max=10,span=1)
//   nrm_dc_remove([1.0,2.0,3.0])      = [-1.0,0.0,1.0]    (mean=2.0)
//   nrm_rms([3.0,4.0])                = 3.5355            (sqrt((9+16)/2)=sqrt(12.5))
//   nrm_rms([0.0,0.0])                = 0.0
//   nrm_zscore([2,4,4,4,5,5,7,9])[0]  = -1.5              (mean=5,std=2;(2-5)/2=-1.5)

import std/dsp/normalize

// ckf: compare two floats within eps 0.001
fn ckf(label: string, got: float, want: float)
    let diff = got - want
    if diff < 0.0
        diff = 0.0 - diff
    if diff > 0.001
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// ckf_list: compare two float lists element-wise within eps 0.001
fn ckf_list(label: string, got: list, want: list)
    let ng = len(got)
    let nw = len(want)
    if ng != nw
        print("FAIL " + label + " length: got " + str(ng) + " want " + str(nw))
        exit(1)
    let i = 0
    while i < nw
        let gv = got[i] * 1.0
        let wv = want[i] * 1.0
        let diff = gv - wv
        if diff < 0.0
            diff = 0.0 - diff
        if diff > 0.001
            print("FAIL " + label + "[" + str(i) + "]: got " + str(gv) + " want " + str(wv))
            exit(1)
        i = i + 1

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // ── KAT 1: nrm_peak([1.0,-2.0,1.0]) == [0.5,-1.0,0.5] ──────────────────
    // Peak absolute value is 2.0; each element divided by 2.0.
    let xs1 = []
    push(xs1, 1.0)
    push(xs1, 0.0 - 2.0)
    push(xs1, 1.0)
    let want1 = []
    push(want1, 0.5)
    push(want1, 0.0 - 1.0)
    push(want1, 0.5)
    let r1 = nrm_peak(xs1)
    ckf_list("peak_1_n2_1", r1, want1)

    // ── KAT 2: nrm_minmax([0.0,5.0,10.0], 0.0, 1.0) == [0.0,0.5,1.0] ───────
    // min=0, max=10, range=10, span=1.  (v-0)/10 * 1 + 0 = v/10.
    let xs2 = []
    push(xs2, 0.0)
    push(xs2, 5.0)
    push(xs2, 10.0)
    let want2 = []
    push(want2, 0.0)
    push(want2, 0.5)
    push(want2, 1.0)
    let r2 = nrm_minmax(xs2, 0.0, 1.0)
    ckf_list("minmax_0_5_10", r2, want2)

    // ── KAT 3: nrm_dc_remove([1.0,2.0,3.0]) == [-1.0,0.0,1.0] ──────────────
    // mean = (1+2+3)/3 = 2.0; subtract from each.
    let xs3 = []
    push(xs3, 1.0)
    push(xs3, 2.0)
    push(xs3, 3.0)
    let want3 = []
    push(want3, 0.0 - 1.0)
    push(want3, 0.0)
    push(want3, 1.0)
    let r3 = nrm_dc_remove(xs3)
    ckf_list("dc_remove_123", r3, want3)

    // ── KAT 4: nrm_rms([3.0,4.0]) == sqrt(12.5) == 3.5355 ───────────────────
    // (3^2+4^2)/2 = (9+16)/2 = 12.5; sqrt(12.5) = 3.53553...
    let xs4 = []
    push(xs4, 3.0)
    push(xs4, 4.0)
    let r4 = nrm_rms(xs4)
    ckf("rms_3_4", r4, 3.5355)

    // ── KAT 5: nrm_rms([0.0,0.0]) == 0.0 ───────────────────────────────────
    let xs5 = []
    push(xs5, 0.0)
    push(xs5, 0.0)
    let r5 = nrm_rms(xs5)
    ckf("rms_zeros", r5, 0.0)

    // ── KAT 6: nrm_zscore([2,4,4,4,5,5,7,9])[0] == -1.5 ────────────────────
    // mean = (2+4+4+4+5+5+7+9)/8 = 40/8 = 5.0
    // deviations^2: 9,1,1,1,0,0,4,16 -> sum=32 -> var=32/8=4.0 -> std=2.0
    // z[0] = (2-5)/2 = -1.5
    let xs6 = []
    push(xs6, 2.0)
    push(xs6, 4.0)
    push(xs6, 4.0)
    push(xs6, 4.0)
    push(xs6, 5.0)
    push(xs6, 5.0)
    push(xs6, 7.0)
    push(xs6, 9.0)
    let r6 = nrm_zscore(xs6)
    let z0 = r6[0] * 1.0
    ckf("zscore_first", z0, 0.0 - 1.5)

    // ── KAT 7: nrm_zscore last element == +2.0 ───────────────────────────────
    // z[7] = (9-5)/2 = 4/2 = 2.0
    let z7 = r6[7] * 1.0
    ckf("zscore_last", z7, 2.0)

    // ── KAT 8: nrm_minmax remapped to [-1,1] ──────────────────────────────────
    // xs=[0,10], lo=-1, hi=1 -> range=10, span=2: [0+(-1+0*2/10), -1+10*2/10] = [-1.0, 1.0]
    let xs8 = []
    push(xs8, 0.0)
    push(xs8, 5.0)
    push(xs8, 10.0)
    let r8 = nrm_minmax(xs8, 0.0 - 1.0, 1.0)
    let want8 = []
    push(want8, 0.0 - 1.0)
    push(want8, 0.0)
    push(want8, 1.0)
    ckf_list("minmax_neg1_pos1", r8, want8)

    // ── KAT 9: nrm_peak single positive value → [1.0] ────────────────────────
    let xs9 = []
    push(xs9, 4.0)
    let r9 = nrm_peak(xs9)
    cki("peak_single_len", len(r9), 1)
    let v9 = r9[0] * 1.0
    ckf("peak_single_val", v9, 1.0)

    // ── KAT 10: nrm_rms single element == abs(element) ───────────────────────
    // rms([5.0]) = sqrt(25/1) = 5.0
    let xs10 = []
    push(xs10, 5.0)
    let r10 = nrm_rms(xs10)
    ckf("rms_single", r10, 5.0)

    print("_normalize_test passed")
