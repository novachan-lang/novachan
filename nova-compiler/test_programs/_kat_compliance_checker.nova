import forge_compliance_checker

fn main()
    // --- API #1: field-record validation (renamed from the original
    // cc_add_rule/cc_check/cc_compliance_rate/cc_total_checks/cc_rule_count
    // to make room for API #2's identically-named, differently-shaped
    // functions below) ---
    let c = cc_new()
    c = cc_add_field_rule(c, "has_name", "required", "name")
    c = cc_add_field_rule(c, "has_email", "required", "email")
    c = cc_add_field_rule(c, "name_filled", "not_empty", "name")
    assert(cc_field_rule_count(c) == 3, "3 field rules")

    let good = {}
    good["name"] = "Alice"
    good["email"] = "a@b.com"
    let r1 = cc_validate_record(c, good)
    c = r1["c"]
    assert(r1["violations"] == 0, "good: 0 violations")

    let missing = {}
    missing["name"] = "Bob"
    let r2 = cc_validate_record(c, missing)
    c = r2["c"]
    assert(r2["violations"] == 1, "missing email: 1 violation")
    assert(r2["first_violation"] == "has_email", "first violation")

    let empty_name = {}
    empty_name["name"] = ""
    empty_name["email"] = "x@y.com"
    let r3 = cc_validate_record(c, empty_name)
    c = r3["c"]
    assert(r3["violations"] == 1, "empty name: 1 violation")
    assert(r3["first_violation"] == "name_filled", "not_empty violation")

    assert(cc_field_checks_total(c) == 3, "3 field checks")
    assert(cc_field_compliance_rate(c) == 33, "33% field compliance")

    // --- API #2: named compliance-rule tracking (new) ---
    let s = cc_new()
    s = cc_add_rule(s, "R-001", "encryption at rest", "critical")
    s = cc_add_rule(s, "R-002", "access logging enabled", "high")
    s = cc_add_rule(s, "R-003", "password rotation 90d", "medium")
    assert(cc_rule_count(s) == 3, "3 named rules")
    assert(cc_has_rule(s, "R-001") == 1, "R-001 registered")
    assert(cc_has_rule(s, "R-999") == 0, "R-999 not registered")

    let ok1 = cc_check(s, "R-001", 1)
    assert(is_ok(ok1), "check R-001 recorded")
    let ok2 = cc_check(s, "R-002", 1)
    assert(is_ok(ok2), "check R-002 recorded")
    let ok3 = cc_check(s, "R-003", 0)
    assert(is_ok(ok3), "check R-003 recorded")
    let bad = cc_check(s, "R-404", 1)
    assert(is_err(bad), "checking unregistered rule errs")

    assert(cc_passed_count(s) == 2, "2 passed")
    assert(cc_failed_count(s) == 1, "1 failed")
    assert(cc_total_checks(s) == 3, "3 total named-rule checks")
    assert(cc_critical_failures(s) == 0, "no critical failures yet")

    let rate1 = cc_compliance_rate(s)
    assert(is_ok(rate1), "compliance rate ok")
    assert(unwrap(rate1) == 66, "2 of 3 = 66% compliance")

    // fail the critical rule this time
    let ok4 = cc_check(s, "R-001", 0)
    assert(is_ok(ok4), "second R-001 check recorded")
    assert(cc_critical_failures(s) == 1, "1 critical failure now")
    assert(cc_total_checks(s) == 4, "4 total named-rule checks")

    let fresh = cc_new()
    let rate_empty = cc_compliance_rate(fresh)
    assert(is_err(rate_empty), "compliance rate on no checks errs")

    print("COMPLIANCE-CHECKER KAT PASS")
