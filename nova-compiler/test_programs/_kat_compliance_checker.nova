import forge_compliance_checker

fn main()
    let c = cc_new()
    c = cc_add_rule(c, "has_name", "required", "name")
    c = cc_add_rule(c, "has_email", "required", "email")
    c = cc_add_rule(c, "name_filled", "not_empty", "name")
    assert(cc_rule_count(c) == 3, "3 rules")

    let good = {}
    good["name"] = "Alice"
    good["email"] = "a@b.com"
    let r1 = cc_check(c, good)
    c = r1["c"]
    assert(r1["violations"] == 0, "good: 0 violations")

    let missing = {}
    missing["name"] = "Bob"
    let r2 = cc_check(c, missing)
    c = r2["c"]
    assert(r2["violations"] == 1, "missing email: 1 violation")
    assert(r2["first_violation"] == "has_email", "first violation")

    let empty_name = {}
    empty_name["name"] = ""
    empty_name["email"] = "x@y.com"
    let r3 = cc_check(c, empty_name)
    c = r3["c"]
    assert(r3["violations"] == 1, "empty name: 1 violation")
    assert(r3["first_violation"] == "name_filled", "not_empty violation")

    assert(cc_total_checks(c) == 3, "3 checks")
    assert(cc_compliance_rate(c) == 33, "33% compliance")

    print("COMPLIANCE-CHECKER KAT PASS")
