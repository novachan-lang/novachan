import std/net/udphdr

fn main()
    // ── Vector 1: byte-exact encode of a known UDP header ─────────────────────
    // udp_encode({"src_port":0xC000,"dst_port":0x0035,"length":0x0026,"checksum":0})
    // Wire bytes: C0 00 | 00 35 | 00 26 | 00 00  (8 bytes, big-endian)
    let h1 = {"src_port": 0xC000, "dst_port": 0x0035, "length": 0x0026, "checksum": 0}
    let enc1 = udp_encode(h1)

    // Length must be exactly 8
    let got_len = bytes_len(enc1)
    if got_len != 8
        print("FAIL udphdr encode-len: got "+str(got_len)+" want 8")
        exit(1)

    // u16@0 == 0xC000  ->  byte[0]=0xC0, byte[1]=0x00
    let got_b0 = bytes_get(enc1, 0)
    if got_b0 != 0xC0
        print("FAIL udphdr byte[0]: got "+str(got_b0)+" want 192")
        exit(1)
    let got_b1 = bytes_get(enc1, 1)
    if got_b1 != 0x00
        print("FAIL udphdr byte[1]: got "+str(got_b1)+" want 0")
        exit(1)

    // u16@2 == 0x0035  ->  byte[2]=0x00, byte[3]=0x35
    let got_b2 = bytes_get(enc1, 2)
    if got_b2 != 0x00
        print("FAIL udphdr byte[2]: got "+str(got_b2)+" want 0")
        exit(1)
    let got_b3 = bytes_get(enc1, 3)
    if got_b3 != 0x35
        print("FAIL udphdr byte[3]: got "+str(got_b3)+" want 53")
        exit(1)

    // u16@4 == 0x0026  ->  byte[4]=0x00, byte[5]=0x26
    let got_b4 = bytes_get(enc1, 4)
    if got_b4 != 0x00
        print("FAIL udphdr byte[4]: got "+str(got_b4)+" want 0")
        exit(1)
    let got_b5 = bytes_get(enc1, 5)
    if got_b5 != 0x26
        print("FAIL udphdr byte[5]: got "+str(got_b5)+" want 38")
        exit(1)

    // checksum field == 0  ->  byte[6]=0x00, byte[7]=0x00
    let got_b6 = bytes_get(enc1, 6)
    if got_b6 != 0x00
        print("FAIL udphdr byte[6]: got "+str(got_b6)+" want 0")
        exit(1)
    let got_b7 = bytes_get(enc1, 7)
    if got_b7 != 0x00
        print("FAIL udphdr byte[7]: got "+str(got_b7)+" want 0")
        exit(1)

    // ── Vector 2: encode->decode round-trip ────────────────────────────────────
    let dec1 = udp_decode(enc1)

    let got_src = dec1["src_port"]
    if got_src != 0xC000
        print("FAIL udphdr decode src_port: got "+str(got_src)+" want 49152")
        exit(1)

    let got_dst = dec1["dst_port"]
    if got_dst != 0x0035
        print("FAIL udphdr decode dst_port: got "+str(got_dst)+" want 53")
        exit(1)

    let got_plen = dec1["length"]
    if got_plen != 0x0026
        print("FAIL udphdr decode length: got "+str(got_plen)+" want 38")
        exit(1)

    let got_cks = dec1["checksum"]
    if got_cks != 0
        print("FAIL udphdr decode checksum: got "+str(got_cks)+" want 0")
        exit(1)

    // ── Vector 3: non-zero checksum encodes and round-trips correctly ──────────
    let h2 = {"src_port": 1234, "dst_port": 5678, "length": 12, "checksum": 0xABCD}
    let enc2 = udp_encode(h2)
    if bytes_len(enc2) != 8
        print("FAIL udphdr v3 encode-len: got "+str(bytes_len(enc2))+" want 8")
        exit(1)
    let dec2 = udp_decode(enc2)
    let got_src2 = dec2["src_port"]
    if got_src2 != 1234
        print("FAIL udphdr v3 src_port: got "+str(got_src2)+" want 1234")
        exit(1)
    let got_dst2 = dec2["dst_port"]
    if got_dst2 != 5678
        print("FAIL udphdr v3 dst_port: got "+str(got_dst2)+" want 5678")
        exit(1)
    let got_cks2 = dec2["checksum"]
    if got_cks2 != 0xABCD
        print("FAIL udphdr v3 checksum: got "+str(got_cks2)+" want 43981")
        exit(1)

    // ── Vector 4: length field reflects header+payload scenario ───────────────
    // A 30-byte payload -> length = 8 + 30 = 38 = 0x0026 (same as vector 1, confirmed)
    // Now test with a 100-byte payload: length = 8 + 100 = 108 = 0x006C
    let h3 = {"src_port": 9999, "dst_port": 80, "length": 108, "checksum": 0x1234}
    let enc3 = udp_encode(h3)
    let dec3 = udp_decode(enc3)
    let got_len3 = dec3["length"]
    if got_len3 != 108
        print("FAIL udphdr v4 length: got "+str(got_len3)+" want 108")
        exit(1)

    // ── Vector 5: short input decode returns empty dict (bounds safety) ────────
    let short_b = bytes(4)
    let dec_short = udp_decode(short_b)
    if contains(dec_short, "src_port")
        print("FAIL udphdr short-decode: expected empty dict but got src_port key")
        exit(1)

    // ── Vector 6: zero-length input ───────────────────────────────────────────
    let empty_b = bytes(0)
    let dec_empty = udp_decode(empty_b)
    if contains(dec_empty, "dst_port")
        print("FAIL udphdr empty-decode: expected empty dict but got dst_port key")
        exit(1)

    // ── Vector 7: missing dict keys default to 0 in encode ────────────────────
    let h_minimal = {"dst_port": 53}
    let enc_min = udp_encode(h_minimal)
    if bytes_len(enc_min) != 8
        print("FAIL udphdr minimal encode-len: got "+str(bytes_len(enc_min))+" want 8")
        exit(1)
    let dec_min = udp_decode(enc_min)
    let got_min_src = dec_min["src_port"]
    if got_min_src != 0
        print("FAIL udphdr minimal src_port: got "+str(got_min_src)+" want 0")
        exit(1)
    let got_min_dst = dec_min["dst_port"]
    if got_min_dst != 53
        print("FAIL udphdr minimal dst_port: got "+str(got_min_dst)+" want 53")
        exit(1)

    print("PASS _udphdr_test")
