// Forge-readiness: measure per-request memory growth of a real request round-trip.
// A spawned forge server handles N requests (parse + build JSON); the client sends N GETs.
// live_count() is process-global, so the delta covers BOTH the per-request handler temporaries
// AND the client http_get temporaries -- a true round-trip leak proxy. per_req ~0 => server-ready.
import forge

fn handle(m, p, b)
    let items = []
    push(items, ["method", m])
    push(items, ["path", p])
    push(items, ["ok", "true"])
    forge.json_obj(200, items)

fn main()
    let port = 18931
    let n = 400
    spawn fn()
        forge.serve_n(port, fn(m, p, b) handle(m, p, b), n)
    sleep(300)
    let base = "http://127.0.0.1:" + str(port)
    // warm up one request (one-time allocations: connection setup, interned strings)
    http_get(base + "/warmup")
    let before = live_count()
    let i = 1
    while i < n
        http_get(base + "/req")
        i = i + 1
    let after = live_count()
    let delta = after - before
    print("forge_readiness requests=" + str(n - 1) + " live_delta=" + str(delta))
