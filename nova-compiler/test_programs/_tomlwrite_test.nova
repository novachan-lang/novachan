// KAT test suite for std/data/tomlwrite
// Tests tw_write_value, tw_write_bool, and tw_write (document serialiser).
// Also tests round-trip via build_toml_parse.
//
// NOVA BOOL GOTCHA: type_of(true) == "int" — booleans and ints are
// indistinguishable at the scalar level.  tw_write_value(true) returns "1".
// tw_write_bool(v) is the explicit bool serialiser that returns "true"/"false".

import std/data/tomlwrite

// ── Helpers ───────────────────────────────────────────────────────────────────

fn cks(got: string, want: string, label: string)
    if got != want
        print("FAIL " + label + ": got [" + got + "] want [" + want + "]")
        exit(1)

fn ck_contains(haystack: string, needle: string, label: string)
    let found = 0
    let hlen = len(haystack)
    let nlen = len(needle)
    if nlen > 0
        let i = 0
        while i <= hlen - nlen
            let candidate = slice(haystack, i, i + nlen)
            if candidate == needle
                found = 1
            i = i + 1
    if found == 0
        print("FAIL " + label + ": [" + haystack + "] does not contain [" + needle + "]")
        exit(1)

fn ck_not_contains(haystack: string, needle: string, label: string)
    let found = 0
    let hlen = len(haystack)
    let nlen = len(needle)
    if nlen > 0
        let i = 0
        while i <= hlen - nlen
            let candidate = slice(haystack, i, i + nlen)
            if candidate == needle
                found = 1
            i = i + 1
    if found == 1
        print("FAIL " + label + ": [" + haystack + "] should NOT contain [" + needle + "]")
        exit(1)

// ── KAT 1: tw_write_value("hi") == chr(34)+"hi"+chr(34) ─────────────────────

let want_str_hi = chr(34) + "hi" + chr(34)
let got_str_hi = tw_write_value("hi")
cks(got_str_hi, want_str_hi, "tw_write_value string hi")

// ── KAT 2: tw_write_value(42) == "42" ────────────────────────────────────────

let got_int_42 = tw_write_value(42)
cks(got_int_42, "42", "tw_write_value int 42")

// ── KAT 3: tw_write_value(1) == "1" (ints, including bool literals) ──────────
// NOVA gotcha: type_of(true)=="int"; booleans appear as int at the scalar level.

let got_int_1 = tw_write_value(1)
cks(got_int_1, "1", "tw_write_value int 1")

// ── KAT 4: tw_write_bool(1) == "true" / tw_write_bool(0) == "false" ──────────
// Use tw_write_bool when you KNOW a value is semantic-boolean.

let got_twb_true = tw_write_bool(1)
cks(got_twb_true, "true", "tw_write_bool 1=true")

let got_twb_false = tw_write_bool(0)
cks(got_twb_false, "false", "tw_write_bool 0=false")

// ── KAT 5: string escaping — backslash and double-quote ──────────────────────
// tw_write_value("a" + chr(34) + "b") should produce  chr(34)+"a\\"b"+chr(34)

let want_esc = chr(34) + "a" + chr(92) + chr(34) + "b" + chr(34)
let got_esc = tw_write_value("a" + chr(34) + "b")
cks(got_esc, want_esc, "tw_write_value escape quote")

// ── KAT 6: tw_write flat dict contains expected key=value lines ───────────────
// Build dict with string and int values.

let flat = {}
flat["name"] = "nova"
flat["version"] = 1

let doc = tw_write(flat)

ck_contains(doc, "name = " + chr(34) + "nova" + chr(34), "tw_write name=nova")
ck_contains(doc, "version = 1", "tw_write version=1")

// ── KAT 7: nested dict becomes [section] header ───────────────────────────────

let top = {}
let srv = {}
srv["port"] = 8080
top["server"] = srv

let sect_doc = tw_write(top)
ck_contains(sect_doc, "[server]", "tw_write section header")
ck_contains(sect_doc, "port = 8080", "tw_write section key")

// ── KAT 8: list serialisation ────────────────────────────────────────────────

let lst = []
lst.push(1)
lst.push(2)
lst.push(3)
let got_list = tw_write_value(lst)
cks(got_list, "[1, 2, 3]", "tw_write_value list")

// ── KAT 9: keys are sorted (deterministic output) ────────────────────────────
// dict with keys "z", "a", "m" — "a" must appear before "m" before "z" in output.

let unsorted = {}
unsorted["z"] = 3
unsorted["a"] = 1
unsorted["m"] = 2
let sorted_doc = tw_write(unsorted)
// Find first occurrence of each key letter in the output
let pos_a = 0
let pos_m = 0
let pos_z = 0
let di = 0
while di < len(sorted_doc)
    let ch = char_at(sorted_doc, di)
    if ch == "a"
        if pos_a == 0
            pos_a = di + 1
    if ch == "m"
        if pos_m == 0
            pos_m = di + 1
    if ch == "z"
        if pos_z == 0
            pos_z = di + 1
    di = di + 1
if pos_a >= pos_m
    print("FAIL sorted order: a should appear before m in [" + sorted_doc + "]")
    exit(1)
if pos_m >= pos_z
    print("FAIL sorted order: m should appear before z in [" + sorted_doc + "]")
    exit(1)

// ── KAT 10: round-trip via build_toml_parse ──────────────────────────────────
// build_toml_parse(path) reads a TOML file and returns a flat dict (all string values).
// We write doc to a temp file and verify "name" round-trips.

let tmp_path = "._tw_rt_tmp.toml"
write_file(tmp_path, doc)
let parsed = build_toml_parse(tmp_path)
let name_val = ""
if contains(parsed, "name")
    name_val = str(parsed["name"])
cks(name_val, "nova", "round-trip name key")
remove_file(tmp_path)

// ── KAT 11: string with newline and tab escaping ──────────────────────────────

let nl_str = "line1" + chr(10) + "line2"
let got_nl = tw_write_value(nl_str)
let want_nl = chr(34) + "line1\\nline2" + chr(34)
cks(got_nl, want_nl, "tw_write_value newline escape")

print("_tomlwrite_test passed")
