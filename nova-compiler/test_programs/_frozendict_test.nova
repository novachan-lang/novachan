import std/collections/frozendict

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + got + " expected " + expected)
        exit(1)

fn main()
    // Build base frozendict from a plain dict
    let d = {}
    d["a"] = 1
    d["b"] = 2
    let f = fz_of(d)

    // KAT 1: fz_get retrieves the correct value
    cki("fz_get a", fz_get(f, "a"), 1)

    // KAT 2: fz_has returns true for present key
    cki("fz_has b", fz_has(f, "b"), 1)

    // KAT 3: fz_has returns false for absent key
    cki("fz_has z", fz_has(f, "z"), 0)

    // KAT 4: fz_len returns correct count
    cki("fz_len", fz_len(f), 2)

    // KAT 5: fz_with adds a key; original is unchanged
    let g = fz_with(f, "c", 3)
    cki("fz_with get c", fz_get(g, "c"), 3)
    cki("fz_with original no c", fz_has(f, "c"), 0)

    // KAT 6: fz_without removes a key; original is unchanged
    let h = fz_without(f, "a")
    cki("fz_without has a", fz_has(h, "a"), 0)
    cki("fz_without original still has a", fz_has(f, "a"), 1)

    // KAT 7: fz_to_dict returns a mutable copy; mutating it doesn't affect frozen
    let copy = fz_to_dict(f)
    copy["x"] = 99
    cki("fz_to_dict copy has x", fz_has(fz_of(copy), "x"), 1)
    cki("original unaffected after copy mutation", fz_has(f, "x"), 0)

    // KAT 8: fz_keys returns all expected keys (check count; order not guaranteed)
    let ks = fz_keys(f)
    cki("fz_keys len", len(ks), 2)

    // KAT 9: mutating source dict after fz_of does not affect the frozendict
    d["a"] = 999
    cki("fz_of defensive copy", fz_get(f, "a"), 1)

    print("_frozendict_test passed")
