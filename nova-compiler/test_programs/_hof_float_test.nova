// Regression gate for the HOF float-ABI fix: a typed-float arg passed to a fn-VALUE
// (dyn_call) must be boxed so the trampoline reads it as a float, not raw bits.
// Before the fix, ap_f(dblf,3.5) returned 9.23e18 instead of 7.0.
fn dblf(x: float) -> float
    return x * 2.0

fn inc(x: int) -> int
    return x + 1

fn ap(f, x)
    return f(x)

fn ap_f(f, x: float) -> float
    return f(x)

fn twolayer(f, x: float) -> float
    let r = ap_f(f, x)
    return r

fn ckf(label: string, got: float, want: float)
    let d = got - want
    if d < 0.0
        d = 0.0 - d
    if d > 0.0001
        print("FAIL " + label + ": " + str(got) + " != " + str(want))
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": " + str(got) + " != " + str(want))
        exit(1)

fn main()
    cki("int_hof", ap(inc, 5), 6)
    ckf("typed_float_hof", ap_f(dblf, 3.5), 7.0)
    ckf("untyped_float_hof", ap(dblf, 3.5), 7.0)
    let d = {}
    d["v"] = 2.5
    ckf("dict_routed", ap_f(dblf, d["v"]), 5.0)
    let xs = [1.5, 2.5, 3.5]
    ckf("list_elem", ap_f(dblf, xs[1]), 5.0)
    ckf("two_layer", twolayer(dblf, 4.0), 8.0)
    ckf("negative", ap_f(dblf, 0.0 - 1.25), -2.5)
    print("_hof_float_test passed")
