// functional: local blob storage put/get/exists/delete
import forge_storage

fn main()
    let s = storage_local("_storage_test_dir")
    if is_ok(storage_put(s, "hello.txt", "world")) != true
        print("FAIL put")
        exit(1)
    if storage_exists(s, "hello.txt") != true
        print("FAIL exists")
        exit(1)
    let gr = storage_get(s, "hello.txt")
    if is_ok(gr) != true
        print("FAIL get")
        exit(1)
    if unwrap(gr) != "world"
        print("FAIL content = " + unwrap(gr))
        exit(1)
    if is_ok(storage_delete(s, "hello.txt")) != true
        print("FAIL delete")
        exit(1)
    if storage_exists(s, "hello.txt") != false
        print("FAIL still exists")
        exit(1)
    print("PASS forge_storage")
