import forge_pwned

fn main()
    // Known SHA-1 of "password" = "5BAA61E4C9B93F3F0682250B6CF8331B7EE68FD8"
    // prefix = "5BAA6", suffix = "1E4C9B93F3F0682250B6CF8331B7EE68FD8"
    let prefix = pwned_prefix("password")
    assert(len(prefix) == 5, "prefix is 5 chars")
    assert(prefix == "5BAA6", "password prefix")

    let suffix = pwned_suffix("password")
    assert(len(suffix) == 35, "suffix is 35 chars")
    assert(suffix == "1E4C9B93F3F0682250B6CF8331B7EE68FD8", "password suffix")

    // Simulate API response
    let response = "1D2DA4053E34E76F6576ED1DA63134B5E2A:2\n1E4C9B93F3F0682250B6CF8331B7EE68FD8:3861493\nABCDEF1234567890ABCDEF1234567890ABC:15"
    let count = pwned_count(suffix, response)
    assert(count == 3861493, "found breach count")

    // Convenience check
    assert(pwned_is_breached("password", response), "password is breached")

    // Non-matching suffix
    assert(pwned_count("ZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZ", response) == 0, "not found")

    print("PWNED KAT PASS")
