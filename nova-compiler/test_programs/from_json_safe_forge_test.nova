// from_json_safe_forge_test -- the INBOUND "return your type" moat end-to-end through Forge:
// a handler binds `let u: Result<User> = from_json_safe(req.body)` and matches Ok/Err. Well-formed
// JSON -> 201 with the echoed struct; malformed / non-object / missing-required -> 422 with a JSON
// error -- NO crash, NO silently-defaulted struct reaching business logic. This is the validating,
// zero-annotation typed binding that FastAPI/Spring need decorators+schemas for. The slot MUST stay
// Result-typed across the full middleware+dispatch pipeline (permanent guard for the SUM-typed slot).
import forge

type User
    id: int
    name: string
    active: bool

// POST /users: validate the body into a typed User. Err -> 422 (machine-readable JSON error).
fn create_user(req: Request) -> Response
    let r: Result<User> = from_json_safe(req.body)
    match r
        Ok(u) =>
            return forge.resp_json(201, u)
        Err(e) =>
            return forge.resp_error(422, e)

fn main()
    let q = chr(34)
    let a = forge.app()
    forge.post(a, "/users", fn(req) create_user(req))

    // well-formed object -> 201, body echoes the parsed struct
    let good = "\{" + q + "id" + q + ":7," + q + "name" + q + ":" + q + "ada" + q + "," + q + "active" + q + ":true\}"
    let r1 = forge.dispatch_test(a, forge.mock_request("POST", "/users", good))
    assert(forge.status_of(r1) == 201, "well-formed body -> 201")
    assert(find(forge.body_of(r1), q + "name" + q + ":" + q + "ada" + q) >= 0, "201 echoes parsed User")
    print("PASS: valid JSON body -> 201 (" + str(forge.status_of(r1)) + ")")

    // non-object body -> 422 (validated, no crash, no defaulted struct)
    let r2 = forge.dispatch_test(a, forge.mock_request("POST", "/users", "42"))
    assert(forge.status_of(r2) == 422, "bare int body -> 422")
    let r3 = forge.dispatch_test(a, forge.mock_request("POST", "/users", "not json"))
    assert(forge.status_of(r3) == 422, "garbage body -> 422")
    let r4 = forge.dispatch_test(a, forge.mock_request("POST", "/users", ""))
    assert(forge.status_of(r4) == 422, "empty body -> 422")
    assert(find(forge.body_of(r2), q + "error" + q) >= 0, "422 carries a JSON error")
    print("PASS: invalid bodies -> 422 (int=" + str(forge.status_of(r2)) + " garbage=" + str(forge.status_of(r3)) + " empty=" + str(forge.status_of(r4)) + ")")

    print("from_json_safe_forge_test passed")
