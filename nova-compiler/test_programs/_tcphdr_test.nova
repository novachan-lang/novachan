import std/net/tcphdr

fn main()
    // ── KAT 1: tcp_encode known vector ────────────────────────────────────────
    // Encode a SYN segment: src=0x1F90(8080), dst=0x0050(80),
    // seq=0x12345678, ack=0, data_offset=5, flags=0x02(SYN),
    // window=0x7210, checksum=0, urgent=0
    let h = {"src_port": 0x1F90, "dst_port": 0x0050, "seq": 0x12345678, "ack": 0, "data_offset": 5, "flags": 0x02, "window": 0x7210, "checksum": 0, "urgent": 0}
    let enc = tcp_encode(h)

    // Must be exactly 20 bytes
    let got_len = bytes_len(enc)
    if got_len != 20
        print("FAIL tcphdr encode-length: got "+str(got_len)+" want 20")
        exit(1)

    // u16 @ offset 0 == 0x1F90 (src_port)
    let sp_hi = bytes_get(enc, 0)
    let sp_lo = bytes_get(enc, 1)
    let got_sp = (sp_hi << 8) | sp_lo
    if got_sp != 0x1F90
        print("FAIL tcphdr src_port: got "+str(got_sp)+" want "+str(0x1F90))
        exit(1)

    // u16 @ offset 2 == 0x0050 (dst_port)
    let dp_hi = bytes_get(enc, 2)
    let dp_lo = bytes_get(enc, 3)
    let got_dp = (dp_hi << 8) | dp_lo
    if got_dp != 0x0050
        print("FAIL tcphdr dst_port: got "+str(got_dp)+" want "+str(0x0050))
        exit(1)

    // u32 @ offset 4 == 0x12345678 (seq)
    let s0 = bytes_get(enc, 4)
    let s1 = bytes_get(enc, 5)
    let s2 = bytes_get(enc, 6)
    let s3 = bytes_get(enc, 7)
    let got_seq = ((s0 << 24) | (s1 << 16) | (s2 << 8) | s3) & 0xFFFFFFFF
    if got_seq != 0x12345678
        print("FAIL tcphdr seq: got "+str(got_seq)+" want "+str(0x12345678))
        exit(1)

    // byte 12 == 0x50 (data_offset=5 -> 5<<4 = 0x50)
    let got_b12 = bytes_get(enc, 12)
    if got_b12 != 0x50
        print("FAIL tcphdr byte12 (data_offset): got "+str(got_b12)+" want 80")
        exit(1)

    // byte 13 == 0x02 (SYN flag)
    let got_b13 = bytes_get(enc, 13)
    if got_b13 != 0x02
        print("FAIL tcphdr byte13 (flags): got "+str(got_b13)+" want 2")
        exit(1)

    // ack field (bytes 8-11) == 0
    let a0 = bytes_get(enc, 8)
    let a1 = bytes_get(enc, 9)
    let a2 = bytes_get(enc, 10)
    let a3 = bytes_get(enc, 11)
    let got_ack = (a0 << 24) | (a1 << 16) | (a2 << 8) | a3
    if got_ack != 0
        print("FAIL tcphdr ack: got "+str(got_ack)+" want 0")
        exit(1)

    // window == 0x7210
    let w0 = bytes_get(enc, 14)
    let w1 = bytes_get(enc, 15)
    let got_win = (w0 << 8) | w1
    if got_win != 0x7210
        print("FAIL tcphdr window: got "+str(got_win)+" want "+str(0x7210))
        exit(1)

    // ── KAT 2: tcp_decode round-trip ──────────────────────────────────────────
    let dec = tcp_decode(enc)

    // Decoded dict must not be empty
    if contains(dec, "src_port") == false
        print("FAIL tcphdr decode: returned empty dict")
        exit(1)

    let d_sp = dec["src_port"]
    if d_sp != 0x1F90
        print("FAIL tcphdr decode src_port: got "+str(d_sp)+" want "+str(0x1F90))
        exit(1)

    let d_dp = dec["dst_port"]
    if d_dp != 0x0050
        print("FAIL tcphdr decode dst_port: got "+str(d_dp)+" want "+str(0x0050))
        exit(1)

    let d_seq = dec["seq"]
    if d_seq != 0x12345678
        print("FAIL tcphdr decode seq: got "+str(d_seq)+" want "+str(0x12345678))
        exit(1)

    let d_doff = dec["data_offset"]
    if d_doff != 5
        print("FAIL tcphdr decode data_offset: got "+str(d_doff)+" want 5")
        exit(1)

    let d_flags = dec["flags"]
    if d_flags != 0x02
        print("FAIL tcphdr decode flags: got "+str(d_flags)+" want 2")
        exit(1)

    let d_win = dec["window"]
    if d_win != 0x7210
        print("FAIL tcphdr decode window: got "+str(d_win)+" want "+str(0x7210))
        exit(1)

    // ── KAT 3: tcp_flag_syn / tcp_flag_ack on decoded header ─────────────────
    let syn_ok = tcp_flag_syn(dec)
    if syn_ok == false
        print("FAIL tcphdr tcp_flag_syn: expected true")
        exit(1)

    let ack_ok = tcp_flag_ack(dec)
    if ack_ok == true
        print("FAIL tcphdr tcp_flag_ack: expected false (SYN-only segment)")
        exit(1)

    // ── KAT 4: ACK-only segment flag checks ──────────────────────────────────
    let hack = {"src_port": 1234, "dst_port": 80, "seq": 1, "ack": 1, "data_offset": 5, "flags": 0x10, "window": 65535, "checksum": 0, "urgent": 0}
    let enc_ack = tcp_encode(hack)
    let dec_ack = tcp_decode(enc_ack)
    let syn_false = tcp_flag_syn(dec_ack)
    if syn_false == true
        print("FAIL tcphdr tcp_flag_syn on ACK: expected false")
        exit(1)
    let ack_true = tcp_flag_ack(dec_ack)
    if ack_true == false
        print("FAIL tcphdr tcp_flag_ack on ACK: expected true")
        exit(1)

    // ── KAT 5: malformed / short input returns empty dict ────────────────────
    let short_b = bytes(10)
    let bad = tcp_decode(short_b)
    if contains(bad, "src_port")
        print("FAIL tcphdr decode-short: should return empty dict")
        exit(1)

    // ── KAT 6: data_offset < 5 returns empty dict ────────────────────────────
    // Build a 20-byte buffer with data_offset=4 (invalid): byte12 = 0x40 -> doff=4
    let inv = bytes(20)
    bytes_set(inv, 12, 0x40)
    let inv_dec = tcp_decode(inv)
    if contains(inv_dec, "src_port")
        print("FAIL tcphdr decode-bad-doff: should return empty dict for doff=4")
        exit(1)

    // ── KAT 7: SYN+ACK segment encode/decode ─────────────────────────────────
    let synack = {"src_port": 80, "dst_port": 0x1F90, "seq": 0xABCD0001, "ack": 0x12345679, "data_offset": 5, "flags": 0x12, "window": 8192, "checksum": 0xBEEF, "urgent": 0}
    let enc_sa = tcp_encode(synack)
    let dec_sa = tcp_decode(enc_sa)
    let sa_syn = tcp_flag_syn(dec_sa)
    if sa_syn == false
        print("FAIL tcphdr SYN+ACK: syn flag not set")
        exit(1)
    let sa_ack = tcp_flag_ack(dec_sa)
    if sa_ack == false
        print("FAIL tcphdr SYN+ACK: ack flag not set")
        exit(1)
    let sa_csum = dec_sa["checksum"]
    if sa_csum != 0xBEEF
        print("FAIL tcphdr SYN+ACK checksum: got "+str(sa_csum)+" want "+str(0xBEEF))
        exit(1)

    print("PASS _tcphdr_test")
