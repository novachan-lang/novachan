fn double(x)
    x * 2

fn add(x, y)
    x + y

fn square(x)
    x * x

fn main()
    let v1 = 5 |> double
    assert(v1 == 10, "pipe bare fn")

    let v2 = 5 |> add(3)
    assert(v2 == 8, "pipe fn with arg")

    let v3 = 5 |> double |> square
    assert(v3 == 100, "pipe chain")

    let v4 = [1, 2, 3, 4, 5] |> filter(fn(x) x > 2) |> map(fn(x) x * 10)
    assert(len(v4) == 3, "pipe filter+map len")
    assert(v4[0] == 30, "pipe filter+map first")
    assert(v4[1] == 40, "pipe filter+map second")
    assert(v4[2] == 50, "pipe filter+map third")

    let v5 = [1, 2, 3] |> map(fn(x) x * x) |> filter(fn(x) x > 3)
    assert(len(v5) == 2, "pipe map+filter len")
    assert(v5[0] == 4, "pipe map+filter first")
    assert(v5[1] == 9, "pipe map+filter second")

    let v6 = "hello" |> len
    assert(v6 == 5, "pipe len")

    let v7 = 3 |> add(4) |> double |> add(1)
    assert(v7 == 15, "pipe multi-chain")

    print("pipe_test: all passed")
