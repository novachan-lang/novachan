// ============================================================================
// KAT test for std/compress/arithmetic
// ============================================================================
// Tests the integer range/arithmetic coder:
//   1. Round-trip arc_decode(arc_encode(x, arc_build_model(x)), arc_build_model(x), len(x)) == x
//      for: "", "a", "aaaa", "abab", "hello", "mississippi"
//   2. Monotone code size: more repetition -> fewer bits
//   3. Single-symbol alphabet produces a valid (very short) code
//   4. arc_build_model correctness for "abba"
// ============================================================================
import std/compress/arithmetic

fn cks(label, got, want)
    if got == want
        return
    print("FAIL " + label + ": got=" + got + " want=" + want)
    exit(1)

fn cki(label, got, want)
    if got == want
        return
    print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
    exit(1)

// Helper: encode then decode, return the decoded string.
fn roundtrip(s) -> string
    let m = arc_build_model(s)
    let bits = arc_encode(s, m)
    return arc_decode(bits, m, len(s))

// ── KAT 1: round-trip "" ─────────────────────────────────────────────────────
cks("rt_empty", roundtrip(""), "")

// ── KAT 2: round-trip "a" ────────────────────────────────────────────────────
cks("rt_a", roundtrip("a"), "a")

// ── KAT 3: round-trip "aaaa" (single-symbol) ─────────────────────────────────
cks("rt_aaaa", roundtrip("aaaa"), "aaaa")

// ── KAT 4: round-trip "abab" ─────────────────────────────────────────────────
cks("rt_abab", roundtrip("abab"), "abab")

// ── KAT 5: round-trip "hello" ────────────────────────────────────────────────
cks("rt_hello", roundtrip("hello"), "hello")

// ── KAT 6: round-trip "mississippi" ─────────────────────────────────────────
cks("rt_mississippi", roundtrip("mississippi"), "mississippi")

// ── KAT 7: single-symbol model covers the full range ─────────────────────────
// Model for "aaaa": only 'a', cum=[0,4), total=4.
// arc_encode must produce a small non-empty bit list (the flush bits).
let m_aaaa = arc_build_model("aaaa")
let bits_aaaa = arc_encode("aaaa", m_aaaa)
// Must decode correctly — already tested in KAT 3.
// Also verify: the output is non-empty (flush emits at least 1 bit)
// and decode length == 4.
let decoded_aaaa = arc_decode(bits_aaaa, m_aaaa, 4)
cks("single_sym_decode", decoded_aaaa, "aaaa")

// ── KAT 8: model correctness for "abba" ──────────────────────────────────────
// Expected: total=4, 'a' -> [0,2], 'b' -> [2,4]
let m_abba = arc_build_model("abba")
cki("model_total", m_abba["total"], 4)
let chars_abba = m_abba["chars"]
let pair_a = chars_abba["a"]
cki("model_a_lo", pair_a[0], 0)
cki("model_a_hi", pair_a[1], 2)
let pair_b = chars_abba["b"]
cki("model_b_lo", pair_b[0], 2)
cki("model_b_hi", pair_b[1], 4)

// ── KAT 9: monotone code size — "aaaa" uses fewer bits than "abab" ──────────
// "aaaa" is perfectly predictable; "abab" has higher entropy.
let bits_abab = arc_bits_count("abab")
let bits_aaaa_count = arc_bits_count("aaaa")
// Note: each is encoded with its OWN model, so "abab" with 2 equal-prob
// symbols needs ~2 bits/symbol = ~8 bits; "aaaa" with 1 symbol needs ~0
// bits/symbol = very few flush bits. So bits_aaaa_count < bits_abab.
if bits_aaaa_count >= bits_abab
    print("FAIL monotone_size: aaaa bits=" + str(bits_aaaa_count) + " abab bits=" + str(bits_abab) + " (expected aaaa < abab)")
    exit(1)

// ── KAT 10: round-trip a longer sentence ─────────────────────────────────────
let sentence = "the quick brown fox"
cks("rt_sentence", roundtrip(sentence), sentence)

// ── KAT 11: round-trip "abcabc" ──────────────────────────────────────────────
cks("rt_abcabc", roundtrip("abcabc"), "abcabc")

// ── KAT 12: arc_bits_count for empty is 0 ────────────────────────────────────
cki("bits_empty", arc_bits_count(""), 0)

print("_arithmetic_test passed")
