// _cbor_rfc8949_kat — KAT for std/data/cbor against RFC 8949 Appendix A vectors,
// exactly as specified: unsigned/negative ints, byte strings, text strings,
// arrays, maps, bool, null.  Verifies BOTH encode(x) == vector AND
// decode(vector) round-trips for every vector.
import std/data/cbor

// ckb: check that a bytes value matches an expected list of ints byte-by-byte.
fn ckb(label: string, b: any, expected: list)
    let blen = bytes_len(b)
    let elen = len(expected)
    if blen != elen
        print("FAIL " + label + "_len: got " + str(blen) + " want " + str(elen))
        exit(1)
    let i = 0
    while i < elen
        let got = bytes_get(b, i)
        let want = expected[i]
        if got != want
            print("FAIL " + label + "_b" + str(i) + ": got " + str(got) + " want " + str(want))
            exit(1)
        i = i + 1

// cki: check int equality.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// cks: check string equality.
fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got " + got + " want " + want)
        exit(1)

fn main()
    // ── 0 -> 0x00 ─────────────────────────────────────────────────────────
    ckb("enc_0", cb_encode(0), [0x00])
    cki("dec_0", cb_decode(cb_encode(0)), 0)

    // ── 23 -> 0x17 ────────────────────────────────────────────────────────
    ckb("enc_23", cb_encode(23), [0x17])
    cki("dec_23", cb_decode(cb_encode(23)), 23)

    // ── 24 -> 0x1818 ──────────────────────────────────────────────────────
    ckb("enc_24", cb_encode(24), [0x18, 0x18])
    cki("dec_24", cb_decode(cb_encode(24)), 24)

    // ── 1000 -> 0x1903e8 ──────────────────────────────────────────────────
    ckb("enc_1000", cb_encode(1000), [0x19, 0x03, 0xe8])
    cki("dec_1000", cb_decode(cb_encode(1000)), 1000)

    // ── -1 -> 0x20 ────────────────────────────────────────────────────────
    ckb("enc_neg1", cb_encode(0 - 1), [0x20])
    cki("dec_neg1", cb_decode(cb_encode(0 - 1)), 0 - 1)

    // ── "a" -> 0x6161 ─────────────────────────────────────────────────────
    ckb("enc_a", cb_encode("a"), [0x61, 0x61])
    cks("dec_a", cb_decode(cb_encode("a")), "a")

    // ── "IETF" -> 0x6449455446 ────────────────────────────────────────────
    ckb("enc_IETF", cb_encode("IETF"), [0x64, 0x49, 0x45, 0x54, 0x46])
    cks("dec_IETF", cb_decode(cb_encode("IETF")), "IETF")

    // ── [1,2,3] -> 0x83010203 ─────────────────────────────────────────────
    ckb("enc_arr", cb_encode([1, 2, 3]), [0x83, 0x01, 0x02, 0x03])
    let arr_dec = cb_decode(cb_encode([1, 2, 3]))
    cki("dec_arr_len", len(arr_dec), 3)
    cki("dec_arr_0", arr_dec[0], 1)
    cki("dec_arr_1", arr_dec[1], 2)
    cki("dec_arr_2", arr_dec[2], 3)

    // ── {"a":1,"b":[2,3]} -> 0xa26161016162820203 ────────────────────────
    let m = {}
    m["a"] = 1
    m["b"] = [2, 3]
    let m_enc = cb_encode(m)
    ckb("enc_map", m_enc, [0xa2, 0x61, 0x61, 0x01, 0x61, 0x62, 0x82, 0x02, 0x03])
    let m_dec = cb_decode(m_enc)
    cki("dec_map_a", m_dec["a"], 1)
    let m_dec_b = m_dec["b"]
    cki("dec_map_b_len", len(m_dec_b), 2)
    cki("dec_map_b_0", m_dec_b[0], 2)
    cki("dec_map_b_1", m_dec_b[1], 3)

    // ── false -> 0xf4, true -> 0xf5, null -> 0xf6 ────────────────────────
    ckb("enc_false", cb_encode_bool(0), [0xf4])
    ckb("enc_true", cb_encode_bool(1), [0xf5])
    ckb("enc_null", cb_encode_null(), [0xf6])
    cki("dec_false", cb_decode(cb_encode_bool(0)), 0)
    cki("dec_true", cb_decode(cb_encode_bool(1)), 1)
    let null_dec = cb_decode(cb_encode_null())
    if null_dec != null
        print("FAIL dec_null: got non-null")
        exit(1)

    // ── byte string (major 2), binary-safe incl. embedded 0x00 ──────────
    let bstr = bytes(0)
    bstr = bytes_append(bstr, 1)
    bstr = bytes_append(bstr, 0)
    bstr = bytes_append(bstr, 255)
    let bstr_enc = cb_encode(bstr)
    ckb("enc_bytes", bstr_enc, [0x43, 0x01, 0x00, 0xff])
    let bstr_dec = cb_decode(bstr_enc)
    cki("dec_bytes_len", bytes_len(bstr_dec), 3)
    cki("dec_bytes_0", bytes_get(bstr_dec, 0), 1)
    cki("dec_bytes_1", bytes_get(bstr_dec, 1), 0)
    cki("dec_bytes_2", bytes_get(bstr_dec, 2), 255)

    print("PASS _cbor_rfc8949_kat")
