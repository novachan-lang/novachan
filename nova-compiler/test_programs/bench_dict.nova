// Dict operations benchmark (vs Python)
fn dict_insert_lookup(n)
    d = {"init": 0}
    i = 0
    while i < n
        d["key" + str(i)] = i * i
        i = i + 1
    total = 0
    j = 0
    while j < n
        total = total + d["key" + str(j)]
        j = j + 1
    total

result = dict_insert_lookup(10000)
print(result)
