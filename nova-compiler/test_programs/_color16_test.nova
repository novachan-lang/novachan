import std/term/color16

// ── check helpers ─────────────────────────────────────────────────────────────

fn cks(label: str, got: str, want: str)
    if got != want
        print("FAIL color16 " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        print("  got  [" + got + "]")
        print("  want [" + want + "]")
        exit(1)

fn main()
    let ESC = chr(27)

    // ── KAT: fg("red") == ESC+"[31m" ─────────────────────────────────────────
    let want_fg_red = ESC + "[31m"
    let got_fg_red = fg("red")
    cks("fg_red", got_fg_red, want_fg_red)

    // ── KAT: fg("black") == ESC+"[30m" ───────────────────────────────────────
    let want_fg_black = ESC + "[30m"
    let got_fg_black = fg("black")
    cks("fg_black", got_fg_black, want_fg_black)

    // ── KAT: fg("white") == ESC+"[37m" ───────────────────────────────────────
    let want_fg_white = ESC + "[37m"
    let got_fg_white = fg("white")
    cks("fg_white", got_fg_white, want_fg_white)

    // ── KAT: bg("green") == ESC+"[42m" ───────────────────────────────────────
    let want_bg_green = ESC + "[42m"
    let got_bg_green = bg("green")
    cks("bg_green", got_bg_green, want_bg_green)

    // ── KAT: fg_bright("red") == ESC+"[91m" ──────────────────────────────────
    let want_fg_bright_red = ESC + "[91m"
    let got_fg_bright_red = fg_bright("red")
    cks("fg_bright_red", got_fg_bright_red, want_fg_bright_red)

    // ── KAT: colorize("x","red") == ESC+"[31m"+"x"+ESC+"[0m" ────────────────
    let want_colorize = ESC + "[31m" + "x" + ESC + "[0m"
    let got_colorize = colorize("x", "red")
    cks("colorize_red_x", got_colorize, want_colorize)

    // ── KAT: unknown color -> "" (safe) ──────────────────────────────────────
    let got_unknown_fg = fg("purple")
    cks("fg_unknown", got_unknown_fg, "")

    let got_unknown_bg = bg("ultraviolet")
    cks("bg_unknown", got_unknown_bg, "")

    let got_unknown_bright = fg_bright("neon")
    cks("fg_bright_unknown", got_unknown_bright, "")

    // ── KAT: colorize unknown -> plain text ───────────────────────────────────
    let got_colorize_unk = colorize("hello", "notacolor")
    cks("colorize_unknown", got_colorize_unk, "hello")

    // ── coverage: all 8 fg normal codes ──────────────────────────────────────
    cks("fg_green",   fg("green"),   ESC + "[32m")
    cks("fg_yellow",  fg("yellow"),  ESC + "[33m")
    cks("fg_blue",    fg("blue"),    ESC + "[34m")
    cks("fg_magenta", fg("magenta"), ESC + "[35m")
    cks("fg_cyan",    fg("cyan"),    ESC + "[36m")

    // ── coverage: all 8 bg normal codes ──────────────────────────────────────
    cks("bg_black",   bg("black"),   ESC + "[40m")
    cks("bg_red",     bg("red"),     ESC + "[41m")
    cks("bg_yellow",  bg("yellow"),  ESC + "[43m")
    cks("bg_blue",    bg("blue"),    ESC + "[44m")
    cks("bg_magenta", bg("magenta"), ESC + "[45m")
    cks("bg_cyan",    bg("cyan"),    ESC + "[46m")
    cks("bg_white",   bg("white"),   ESC + "[47m")

    // ── coverage: bright fg ───────────────────────────────────────────────────
    cks("fg_bright_black",   fg_bright("black"),   ESC + "[90m")
    cks("fg_bright_green",   fg_bright("green"),   ESC + "[92m")
    cks("fg_bright_yellow",  fg_bright("yellow"),  ESC + "[93m")
    cks("fg_bright_blue",    fg_bright("blue"),    ESC + "[94m")
    cks("fg_bright_magenta", fg_bright("magenta"), ESC + "[95m")
    cks("fg_bright_cyan",    fg_bright("cyan"),    ESC + "[96m")
    cks("fg_bright_white",   fg_bright("white"),   ESC + "[97m")

    // ── coverage: bright bg ───────────────────────────────────────────────────
    cks("bg_bright_black",   bg_bright("black"),   ESC + "[100m")
    cks("bg_bright_red",     bg_bright("red"),     ESC + "[101m")
    cks("bg_bright_green",   bg_bright("green"),   ESC + "[102m")
    cks("bg_bright_yellow",  bg_bright("yellow"),  ESC + "[103m")
    cks("bg_bright_blue",    bg_bright("blue"),    ESC + "[104m")
    cks("bg_bright_magenta", bg_bright("magenta"), ESC + "[105m")
    cks("bg_bright_cyan",    bg_bright("cyan"),    ESC + "[106m")
    cks("bg_bright_white",   bg_bright("white"),   ESC + "[107m")

    // ── KAT: RESET() == ESC+"[0m" ────────────────────────────────────────────
    let want_reset = ESC + "[0m"
    cks("RESET", RESET(), want_reset)

    // ── length sanity: fg("red") is 5 chars: ESC [ 3 1 m ────────────────────
    let fg_red_len = len(fg("red"))
    if fg_red_len != 5
        print("FAIL color16 fg_red_len: got " + str(fg_red_len) + " want 5")
        exit(1)

    // ── length sanity: colorize("x","red") is 1+4+1+1+3=10 chars ────────────
    // ESC[31m=5 + x=1 + ESC[0m=4 = 10
    let colorize_len = len(colorize("x", "red"))
    if colorize_len != 10
        print("FAIL color16 colorize_len: got " + str(colorize_len) + " want 10")
        exit(1)

    print("PASS _color16_test")
