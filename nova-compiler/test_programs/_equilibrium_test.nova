// _equilibrium_test.nova — KAT for std/chem/equilibrium
//
// Known-answer tests:
//   ceq_keq_simple(4.0, 2.0)               = 4.0 / 2.0 = 2.0
//   ceq_le_chatelier_shift(1.0, 2.0)        = "forward"  (Q < K)
//   ceq_le_chatelier_shift(3.0, 2.0)        = "reverse"  (Q > K)
//   ceq_le_chatelier_shift(2.0, 2.0)        = "equilibrium" (Q == K)
//   ceq_keq([2.0,1.0,3.0,1.0],[1.0,1.0])   = (2^1 * 3^1) / (1^1) = 6.0
//   ceq_reaction_quotient([1.0,1.0],[2.0,1.0]) = 1.0/2.0 = 0.5

import std/chem/equilibrium

fn approx(a: float, b: float, tol: float) -> int
    let d = a - b
    let ad = d
    if d < 0.0
        ad = 0.0 - d
    if ad < tol
        return 1
    return 0

fn main()
    // KAT 1: keq_simple — 4.0/2.0 = 2.0
    let k1 = ceq_keq_simple(4.0, 2.0)
    if approx(k1, 2.0, 0.001) == 0
        print("FAIL equilibrium keq_simple: got " + str(k1) + " expected 2.0")
        exit(1)

    // KAT 2: le_chatelier forward (Q < K)
    let s1 = ceq_le_chatelier_shift(1.0, 2.0)
    if s1 != "forward"
        print("FAIL equilibrium le_chatelier_forward: got " + s1)
        exit(1)

    // KAT 3: le_chatelier reverse (Q > K)
    let s2 = ceq_le_chatelier_shift(3.0, 2.0)
    if s2 != "reverse"
        print("FAIL equilibrium le_chatelier_reverse: got " + s2)
        exit(1)

    // KAT 4: le_chatelier equilibrium (Q == K)
    let s3 = ceq_le_chatelier_shift(2.0, 2.0)
    if s3 != "equilibrium"
        print("FAIL equilibrium le_chatelier_equilibrium: got " + s3)
        exit(1)

    // KAT 5: ceq_keq multi-species
    // products = [2.0, 1.0, 3.0, 1.0] -> 2^1 * 3^1 = 6.0
    // reactants = [1.0, 1.0]           -> 1^1 = 1.0
    // Keq = 6.0 / 1.0 = 6.0
    let prods = [2.0, 1.0, 3.0, 1.0]
    let reacts = [1.0, 1.0]
    let k2 = ceq_keq(prods, reacts)
    if approx(k2, 6.0, 0.001) == 0
        print("FAIL equilibrium keq_multi: got " + str(k2) + " expected 6.0")
        exit(1)

    // KAT 6: reaction_quotient — same formula, off-equilibrium concentrations
    // products=[1.0,1.0], reactants=[2.0,1.0] -> Q = 1.0/2.0 = 0.5
    let qprods = [1.0, 1.0]
    let qreacts = [2.0, 1.0]
    let q1 = ceq_reaction_quotient(qprods, qreacts)
    if approx(q1, 0.5, 0.001) == 0
        print("FAIL equilibrium reaction_quotient: got " + str(q1) + " expected 0.5")
        exit(1)

    // KAT 7: keq with coefficients > 1
    // products=[3.0, 2.0] -> 3^2 = 9.0
    // reactants=[2.0, 3.0] -> 2^3 = 8.0
    // Keq = 9.0 / 8.0 = 1.125
    let prods2 = [3.0, 2.0]
    let reacts2 = [2.0, 3.0]
    let k3 = ceq_keq(prods2, reacts2)
    if approx(k3, 1.125, 0.001) == 0
        print("FAIL equilibrium keq_coeff: got " + str(k3) + " expected 1.125")
        exit(1)

    print("PASS _equilibrium_test")
