import std/gametheory/euclid_game

fn ckb(label: string, got: bool, want: bool)
    let gs = "false"
    if got
        gs = "true"
    let ws = "false"
    if want
        ws = "true"
    if got != want
        print("FAIL _euclid_game_test " + label + ": got " + gs + " want " + ws)
        exit(1)

fn main()
    // KAT values from spec
    ckb("win_2_1", eg_is_winning(2, 1), true)
    ckb("win_3_2", eg_is_winning(3, 2), false)
    ckb("win_5_3", eg_is_winning(5, 3), true)
    ckb("win_8_5", eg_is_winning(8, 5), false)
    ckb("win_5_2", eg_is_winning(5, 2), true)
    ckb("win_7_4", eg_is_winning(7, 4), true)
    // Note: (13,8) -- the algorithm gives true (N-position by Euclid game theory);
    // the spec notes "consecutive Fibonacci -> losing" but by standard analysis
    // (8,13)=(F_6,F_7) is an N-position (the P-positions alternate: F3/F4, F5/F6, ...).
    // We test the value the algorithm produces which is true.
    ckb("win_13_8", eg_is_winning(13, 8), true)

    // eg_loser_is_current is the complement
    ckb("loser_3_2", eg_loser_is_current(3, 2), true)
    ckb("loser_2_1", eg_loser_is_current(2, 1), false)

    print("PASS _euclid_game_test")
