import std/rational/rfrac_continued

// ckr — check rational equality element-wise
fn ckr(label, got, wn, wd)
    if got[0] != wn or got[1] != wd
        print("FAIL rfrac_continued " + label + ": got=" + str(got[0]) + "/" + str(got[1]) + " want=" + str(wn) + "/" + str(wd))
        exit(1)

// cki — check integer equality
fn cki(label, got, want)
    if got != want
        print("FAIL rfrac_continued " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// helper: build rational [n, d]
fn rat(n, d)
    let r = []
    r.push(n)
    r.push(d)
    r

// --- rfk_continued_fraction ---

// rfk_continued_fraction([415,93]) = [4,2,6,7]
// 415 = 4*93+43; 93 = 2*43+7; 43 = 6*7+1; 7 = 7*1+0
let cf1 = rfk_continued_fraction(rat(415, 93))
cki("cf_415_93_len", len(cf1), 4)
cki("cf_415_93_0", cf1[0], 4)
cki("cf_415_93_1", cf1[1], 2)
cki("cf_415_93_2", cf1[2], 6)
cki("cf_415_93_3", cf1[3], 7)

// rfk_continued_fraction([45,16]) = [2,1,4,3]
// 45 = 2*16+13; 16 = 1*13+3; 13 = 4*3+1; 3 = 3*1+0
let cf2 = rfk_continued_fraction(rat(45, 16))
cki("cf_45_16_len", len(cf2), 4)
cki("cf_45_16_0", cf2[0], 2)
cki("cf_45_16_1", cf2[1], 1)
cki("cf_45_16_2", cf2[2], 4)
cki("cf_45_16_3", cf2[3], 3)

// rfk_continued_fraction([5,1]) = [5]
let cf3 = rfk_continued_fraction(rat(5, 1))
cki("cf_5_1_len", len(cf3), 1)
cki("cf_5_1_0", cf3[0], 5)

// rfk_continued_fraction([1,2]) = [0,2]
// 1 = 0*2+1; 2 = 2*1+0
let cf4 = rfk_continued_fraction(rat(1, 2))
cki("cf_1_2_len", len(cf4), 2)
cki("cf_1_2_0", cf4[0], 0)
cki("cf_1_2_1", cf4[1], 2)

// --- rfk_from_continued ---

// rfk_from_continued([4,2,6,7]) = [415,93]
let coeffs1 = []
coeffs1.push(4)
coeffs1.push(2)
coeffs1.push(6)
coeffs1.push(7)
let fc1 = rfk_from_continued(coeffs1)
ckr("from_cf_4267", fc1, 415, 93)

// rfk_from_continued([0,2]) = [1,2]
let coeffs2 = []
coeffs2.push(0)
coeffs2.push(2)
let fc2 = rfk_from_continued(coeffs2)
ckr("from_cf_0_2", fc2, 1, 2)

// --- rfk_convergents ---

// rfk_convergents([415,93]) = [[4,1],[9,2],[58,13],[415,93]]
let cv1 = rfk_convergents(rat(415, 93))
cki("cv_415_93_len", len(cv1), 4)
let cv1_0 = cv1[0]
ckr("cv_415_93_0", cv1_0, 4, 1)
let cv1_1 = cv1[1]
ckr("cv_415_93_1", cv1_1, 9, 2)
let cv1_2 = cv1[2]
ckr("cv_415_93_2", cv1_2, 58, 13)
let cv1_3 = cv1[3]
ckr("cv_415_93_3", cv1_3, 415, 93)

// --- round-trip: rfk_from_continued(rfk_continued_fraction([45,16])) = [45,16] ---
let rt_cf = rfk_continued_fraction(rat(45, 16))
let rt = rfk_from_continued(rt_cf)
ckr("roundtrip_45_16", rt, 45, 16)

// --- rfk_nth_convergent ---
// 0th convergent of 415/93 = [4,1]
let nc0 = rfk_nth_convergent(rat(415, 93), 0)
ckr("nth_cv_0", nc0, 4, 1)
// 1st convergent = [9,2]
let nc1 = rfk_nth_convergent(rat(415, 93), 1)
ckr("nth_cv_1", nc1, 9, 2)
// 3rd (last) convergent = [415,93]
let nc3 = rfk_nth_convergent(rat(415, 93), 3)
ckr("nth_cv_3", nc3, 415, 93)

print("PASS _rfrac_continued_test")
