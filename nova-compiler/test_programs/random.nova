// NOVA RANDOM — pseudo-random number generation via xorshift64.
// Deterministic, seedable, no external dependencies. Suitable for
// simulations, games, randomized algorithms, and testing. NOT
// cryptographically secure — use a CSPRNG for security contexts.
//
// State is a single-element list [state] mutated in place, so the
// caller holds the RNG and passes it to each function. Multiple
// independent RNGs can coexist.
//
// Public API:
//   rng_new(seed)                    -> list   (create RNG state)
//   rng_next(rng)                    -> int    (raw xorshift64 step)
//   rng_int(rng, lo, hi)             -> int    (uniform int in [lo, hi])
//   rng_float(rng)                   -> float  (uniform in [0.0, 1.0))
//   rng_choice(rng, items)           -> value  (pick random element)
//   rng_shuffle(rng, items)          -> list   (Fisher-Yates, new list)
//   rng_sample(rng, items, n)        -> list   (n items without replacement)
//   rng_gauss(rng, mean, stddev)     -> float  (Gaussian via Box-Muller approx)

// ── core ─────────────────────────────────────────────────────────────────

fn rng_new(seed: int) -> list
    let s = seed
    if s == 0
        s = 88172645463325252
    let state = [s]
    state

fn rng_next(rng: list) -> int
    let s = rng[0]
    s = s ^ (s << 13)
    s = s ^ (s >> 7)
    s = s ^ (s << 17)
    rng[0] = s
    s

// ── integer range ────────────────────────────────────────────────────────

fn _rng_abs(x: int) -> int
    if x < 0
        return -x
    x

fn rng_int(rng: list, lo: int, hi: int) -> int
    let raw = rng_next(rng)
    let span = hi - lo + 1
    if span <= 0
        return lo
    let v = _rng_abs(raw) % span
    lo + v

// ── float [0.0, 1.0) ────────────────────────────────────────────────────

fn rng_float(rng: list) -> float
    let raw = rng_next(rng)
    let v = _rng_abs(raw)
    // Mask to 53 bits (mantissa width of double) then divide by 2^53.
    // 2^53 = 9007199254740992
    let masked = v & 9007199254740991
    float(masked) / 9007199254740992.0

// ── selection ────────────────────────────────────────────────────────────

fn rng_choice(rng: list, items: list)
    let idx = rng_int(rng, 0, len(items) - 1)
    items[idx]

// ── Fisher-Yates shuffle ─────────────────────────────────────────────────

fn rng_shuffle(rng: list, items: list) -> list
    // Copy into new list
    let out = []
    let j = 0
    while j < len(items)
        out.push(items[j])
        j = j + 1
    // Shuffle in place on the copy
    let i = len(out) - 1
    while i > 0
        let k = rng_int(rng, 0, i)
        let tmp = out[i]
        out[i] = out[k]
        out[k] = tmp
        i = i - 1
    out

// ── sampling without replacement ─────────────────────────────────────────

fn rng_sample(rng: list, items: list, n: int) -> list
    let pool = []
    let j = 0
    while j < len(items)
        pool.push(items[j])
        j = j + 1
    let count = n
    if count > len(pool)
        count = len(pool)
    let result = []
    let i = 0
    while i < count
        let idx = rng_int(rng, i, len(pool) - 1)
        // Swap pool[i] and pool[idx]
        let tmp = pool[i]
        pool[i] = pool[idx]
        pool[idx] = tmp
        result.push(pool[i])
        i = i + 1
    result

// ── Gaussian (Box-Muller approximation) ──────────────────────────────────
// True Box-Muller needs ln() and cos()/sin() which may not be available
// yet. We use the Irwin-Hall approximation: sum of 12 uniform [0,1)
// samples minus 6 gives a good approximation of N(0,1) with range ~[-6,6].

fn rng_gauss(rng: list, mean: float, stddev: float) -> float
    let sum = 0.0
    let i = 0
    while i < 12
        sum = sum + rng_float(rng)
        i = i + 1
    let z = sum - 6.0
    mean + z * stddev
