// KAT test for std/util/ratelimiter
// Hand-computed expected values based on token-bucket spec:
//
//   rl = rl_new(10, 1)   => cap=10, rate=1/s, tokens=10, last=0
//
//   Case 1: rl_try(rl, 0, 5)
//     elapsed=0, refill=10+0*1=10, clamped=10, 10>=5 -> true, tokens=5
//
//   Case 2: rl_try(rl, 0, 5)
//     elapsed=0, refill=5+0*1=5, clamped=5, 5>=5 -> true, tokens=0
//
//   Case 3: rl_try(rl, 0, 1)
//     elapsed=0, refill=0+0*1=0, 0<1 -> false, tokens=0
//
//   Case 4: rl_try(rl, 5, 3)
//     elapsed=5, refill=0+5*1=5, clamped=5, 5>=3 -> true, tokens=2
//
//   Case 5: rl_try(rl, 100, 10)
//     elapsed=95, refill=2+95*1=97, clamped=10 (cap), 10>=10 -> true, tokens=0
//
//   Case 6: rl_try(rl, 100, 1)   (burst-then-throttle: same timestamp)
//     elapsed=0, refill=0+0=0, 0<1 -> false (bucket exhausted)
//
//   rl_available should return 0.0 after case 6.

import std/util/ratelimiter

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label: str, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got " + gs + " want " + ws)
        exit(1)

fn ckf(label: str, got: float, want: float)
    let diff = got - want
    if diff < 0.0
        diff = 0.0 - diff
    if diff > 0.001
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // ── Construct ─────────────────────────────────────────────────────────────
    let rl = rl_new(10, 1)

    // Verify initial state
    ckf("initial_tokens", rl_available(rl), 10.0)

    // ── Case 1: t=0, cost=5 -> true, tokens become 5 ─────────────────────────
    let r1 = rl_try(rl, 0, 5)
    ckb("case1_result", r1, true)
    ckf("case1_tokens", rl_available(rl), 5.0)

    // ── Case 2: t=0, cost=5 -> true, tokens become 0 ─────────────────────────
    let r2 = rl_try(rl, 0, 5)
    ckb("case2_result", r2, true)
    ckf("case2_tokens", rl_available(rl), 0.0)

    // ── Case 3: t=0, cost=1 -> false (bucket empty) ───────────────────────────
    let r3 = rl_try(rl, 0, 1)
    ckb("case3_result", r3, false)
    ckf("case3_tokens", rl_available(rl), 0.0)

    // ── Case 4: t=5, cost=3 -> refill +5 -> 5, then 5-3=2, true ─────────────
    let r4 = rl_try(rl, 5, 3)
    ckb("case4_result", r4, true)
    ckf("case4_tokens", rl_available(rl), 2.0)

    // ── Case 5: t=100, cost=10 -> refill caps at 10, 10-10=0, true ───────────
    let r5 = rl_try(rl, 100, 10)
    ckb("case5_result", r5, true)
    ckf("case5_tokens", rl_available(rl), 0.0)

    // ── Case 6: t=100, cost=1 -> burst exhausted, false ──────────────────────
    let r6 = rl_try(rl, 100, 1)
    ckb("case6_result", r6, false)
    ckf("case6_tokens", rl_available(rl), 0.0)

    // ── Verify rl_available is a pure snapshot (no side effects) ──────────────
    let avail_a = rl_available(rl)
    let avail_b = rl_available(rl)
    ckf("available_idempotent", avail_a, avail_b)

    // ── Partial refill check: capacity=5, rate=2 ──────────────────────────────
    // rl2 = rl_new(5, 2): cap=5, rate=2
    // rl_try(rl2, 0, 3) -> true, tokens=2
    // rl_try(rl2, 1, 3) -> refill=2+1*2=4, 4>=3 -> true, tokens=1
    // rl_try(rl2, 1, 2) -> refill=1+0*2=1, 1<2 -> false
    let rl2 = rl_new(5, 2)
    let p1 = rl_try(rl2, 0, 3)
    ckb("partial1_result", p1, true)
    ckf("partial1_tokens", rl_available(rl2), 2.0)

    let p2 = rl_try(rl2, 1, 3)
    ckb("partial2_result", p2, true)
    ckf("partial2_tokens", rl_available(rl2), 1.0)

    let p3 = rl_try(rl2, 1, 2)
    ckb("partial3_result", p3, false)
    ckf("partial3_tokens", rl_available(rl2), 1.0)

    print("_ratelimiter_test passed")
