fn main()
    let name = "NOVA"
    let version = 1
    let msg = f"Hello {name} v{version}!"
    print(msg)
    assert(msg == "Hello NOVA v1!", "basic interp")

    let x = 10
    let y = 20
    let sum_msg = f"{x} + {y} = {x + y}"
    print(sum_msg)
    assert(sum_msg == "10 + 20 = 30", "expr interp")

    print("interp_test: all passed")
