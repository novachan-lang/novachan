// _acid_base_test.nova — KAT for std/chem/acid_base
//
// Known answers:
//   ph_from_h(0.001)    = -log10(0.001) = 3.0
//   ph_from_h(1e-7)     = 7.0  (neutral)
//   poh_from_oh(0.01)   = -log10(0.01)  = 2.0
//   ph_to_h(7.0)        = 10^-7 = 1e-7 (relative tolerance)
//   ph_to_h(3.0)        = 10^-3 = 0.001
//   ph_poh_sum()        = 14.0
//   is_acidic(3.0)      = true (nonzero)
//   is_acidic(9.0)      = false (0)
//   ka_from_ph(3.0,0.1) ~ 1.01e-5

import std/chem/acid_base

fn approx(a, b, tol)
    let d = a - b
    let ad = d
    if d < 0.0
        ad = 0.0 - d
    if ad > tol
        print("FAIL approx: got " + str(a) + " expected " + str(b) + " tol " + str(tol))
        exit(1)
    return 0

// Relative tolerance: |a-b|/|b| < rel_tol
fn approx_rel(a, b, rel_tol)
    let d = a - b
    let ad = d
    if d < 0.0
        ad = 0.0 - d
    let ab = b
    if ab < 0.0
        ab = 0.0 - ab
    let threshold = ab * rel_tol
    if ad > threshold
        print("FAIL approx_rel: got " + str(a) + " expected " + str(b) + " rel " + str(rel_tol))
        exit(1)
    return 0

fn main()
    // KAT 1: ph_from_h(0.001) = 3.0
    let v1 = ph_from_h(0.001)
    approx(v1, 3.0, 0.01)

    // KAT 2: ph_from_h(1e-7) via 1.0/pow(10,7) = 7.0
    let h7 = 1.0 / pow(10.0, 7.0)
    let v2 = ph_from_h(h7)
    approx(v2, 7.0, 0.01)

    // KAT 3: poh_from_oh(0.01) = 2.0
    let v3 = poh_from_oh(0.01)
    approx(v3, 2.0, 0.01)

    // KAT 4: ph_to_h(7.0) = 1e-7 — relative tolerance since magnitude is tiny
    let v4 = ph_to_h(7.0)
    let expected4 = 1.0 / pow(10.0, 7.0)
    approx_rel(v4, expected4, 0.001)

    // KAT 5: ph_to_h(3.0) = 0.001
    let v5 = ph_to_h(3.0)
    approx(v5, 0.001, 0.000001)

    // KAT 6: ph_poh_sum() = 14.0
    let v6 = ph_poh_sum()
    approx(v6, 14.0, 0.0001)

    // KAT 7: is_acidic(3.0) must be nonzero (true)
    let v7 = is_acidic(3.0)
    if v7 == 0
        print("FAIL is_acidic(3.0) should be true")
        exit(1)

    // KAT 8: is_acidic(9.0) must be zero (false)
    let v8 = is_acidic(9.0)
    if v8 != 0
        print("FAIL is_acidic(9.0) should be false")
        exit(1)

    // KAT 9: ka_from_ph(3.0, 0.1) ~ (0.001)^2 / (0.1-0.001) = 0.000001/0.099 ~ 1.0101e-5
    // expressed as pow: 1.0101 * pow(10,5) = 101010 -> invert: 1.0/101010 ~ 9.9e-6
    // Direct: 0.001*0.001/0.099 = 0.000001/0.099 ~ 0.000010101
    let v9 = ka_from_ph(3.0, 0.1)
    let expected9 = 0.000010101
    approx_rel(v9, expected9, 0.05)

    print("PASS _acid_base_test")
