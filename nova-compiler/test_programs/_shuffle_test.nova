// KAT test for std/random/shuffle
// All expected values hand-computed via LCG simulation (see module header).

import std/random/shuffle

// ── helpers ──────────────────────────────────────────────────────────────────

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got " + got + " want " + want)
        exit(1)

fn list_to_str(xs: list) -> string
    let s = "["
    let i = 0
    while i < len(xs)
        if i > 0
            s = s + ","
        s = s + str(xs[i])
        i = i + 1
    s = s + "]"
    s

// ── sort a list of ints (bubble sort for test-only use) ──────────────────────
fn _sort_ints(xs: list) -> list
    let buf = []
    let i = 0
    while i < len(xs)
        buf = buf + [xs[i]]
        i = i + 1
    let n = len(buf)
    let outer = 0
    while outer < n
        let inner = 0
        while inner < n - 1 - outer
            if buf[inner] > buf[inner + 1]
                let tmp = buf[inner]
                buf[inner] = buf[inner + 1]
                buf[inner + 1] = tmp
            inner = inner + 1
        outer = outer + 1
    buf

// ── check that two int lists are equal element-wise ─────────────────────────
fn lists_equal(a: list, b: list) -> int
    if len(a) != len(b)
        return 0
    let i = 0
    while i < len(a)
        if a[i] != b[i]
            return 0
        i = i + 1
    1

// ── check that all elements of sub are in src ───────────────────────────────
fn all_in(sub: list, src: list) -> int
    let i = 0
    while i < len(sub)
        let v = sub[i]
        let found = 0
        let j = 0
        while j < len(src)
            if src[j] == v
                found = 1
            j = j + 1
        if found == 0
            return 0
        i = i + 1
    1

// ── check all distinct ───────────────────────────────────────────────────────
fn all_distinct(xs: list) -> int
    let i = 0
    while i < len(xs)
        let j = i + 1
        while j < len(xs)
            if xs[i] == xs[j]
                return 0
            j = j + 1
        i = i + 1
    1

// ═════════════════════════════════════════════════════════════════════════════
// KAT 1: sh_shuffle([1,2,3,4,5], 123) is a permutation of [1,2,3,4,5]
// ═════════════════════════════════════════════════════════════════════════════
let input5 = [1, 2, 3, 4, 5]
let shuffled5 = sh_shuffle(input5, 123)

// length preserved
cki("kat1_len", len(shuffled5), 5)

// sorted result equals sorted input -> permutation
let sorted_input5 = _sort_ints(input5)
let sorted_shuf5 = _sort_ints(shuffled5)
let perm_ok = lists_equal(sorted_input5, sorted_shuf5)
cki("kat1_permutation", perm_ok, 1)

// ═════════════════════════════════════════════════════════════════════════════
// KAT 2: sh_shuffle([1,2,3,4,5], 123) == sh_shuffle([1,2,3,4,5], 123) (deterministic)
// ═════════════════════════════════════════════════════════════════════════════
let shuffled5b = sh_shuffle([1, 2, 3, 4, 5], 123)
let det_ok = lists_equal(shuffled5, shuffled5b)
cki("kat2_deterministic", det_ok, 1)

// ═════════════════════════════════════════════════════════════════════════════
// KAT 3: sh_choice([7], 999) == 7
// ═════════════════════════════════════════════════════════════════════════════
let choice_val = sh_choice([7], 999)
cki("kat3_choice_singleton", choice_val, 7)

// ═════════════════════════════════════════════════════════════════════════════
// KAT 4: sh_sample([1,2,3,4,5], 3, 42) -- length 3, all distinct, all in input
// ═════════════════════════════════════════════════════════════════════════════
let sample3 = sh_sample([1, 2, 3, 4, 5], 3, 42)
cki("kat4_sample_len", len(sample3), 3)
let sample3_distinct = all_distinct(sample3)
cki("kat4_sample_distinct", sample3_distinct, 1)
let sample3_in_src = all_in(sample3, [1, 2, 3, 4, 5])
cki("kat4_sample_in_src", sample3_in_src, 1)

// ═════════════════════════════════════════════════════════════════════════════
// KAT 5: sh_shuffled_range(4, 5) is a permutation of [0,1,2,3]
// ═════════════════════════════════════════════════════════════════════════════
let sr = sh_shuffled_range(4, 5)
cki("kat5_range_len", len(sr), 4)
let sorted_sr = _sort_ints(sr)
let sorted_012 = [0, 1, 2, 3]
let range_perm = lists_equal(sorted_sr, sorted_012)
cki("kat5_range_permutation", range_perm, 1)

// ═════════════════════════════════════════════════════════════════════════════
// KAT 6: CONCRETE output -- sh_shuffle([1,2,3], 1) == [1, 3, 2]
// (computed by Python simulation of the exact same LCG)
// ═════════════════════════════════════════════════════════════════════════════
let concrete = sh_shuffle([1, 2, 3], 1)
cki("kat6_concrete_len", len(concrete), 3)
cki("kat6_concrete_0", concrete[0], 1)
cki("kat6_concrete_1", concrete[1], 3)
cki("kat6_concrete_2", concrete[2], 2)

// ═════════════════════════════════════════════════════════════════════════════
// KAT 7: input not mutated -- sh_shuffle does NOT change the original list
// ═════════════════════════════════════════════════════════════════════════════
let orig = [10, 20, 30]
let shuf_orig = sh_shuffle(orig, 77)
cki("kat7_no_mutate_0", orig[0], 10)
cki("kat7_no_mutate_1", orig[1], 20)
cki("kat7_no_mutate_2", orig[2], 30)
// suppress unused warning -- we use shuf_orig length
cki("kat7_shuf_len", len(shuf_orig), 3)

// ═════════════════════════════════════════════════════════════════════════════
// KAT 8: sh_sample with k==0 returns empty list
// ═════════════════════════════════════════════════════════════════════════════
let empty_samp = sh_sample([1, 2, 3], 0, 42)
cki("kat8_sample_zero", len(empty_samp), 0)

// ═════════════════════════════════════════════════════════════════════════════
// KAT 9: sh_sample with k > len returns all elements (full permutation)
// ═════════════════════════════════════════════════════════════════════════════
let oversample = sh_sample([1, 2, 3], 10, 99)
cki("kat9_oversample_len", len(oversample), 3)
let sorted_over = _sort_ints(oversample)
let over_perm = lists_equal(sorted_over, [1, 2, 3])
cki("kat9_oversample_permutation", over_perm, 1)

print("_shuffle_test passed")
