import std/finance/bond

// Helper: check float within epsilon, print FAIL and exit(1) on mismatch.
fn _bnd_check(label: string, got: float, want: float, eps: float)
    let d = got - want
    let ad = d
    if ad < 0.0
        ad = 0.0 - ad
    if ad > eps
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // KAT 1: at-par bond — when coupon_rate == market_rate, price == face value.
    // bnd_price(1000.0, 0.05, 0.05, 10) == 1000.0
    let p1 = bnd_price(1000.0, 0.05, 0.05, 10)
    _bnd_check("price_at_par", p1, 1000.0, 0.01)

    // KAT 2: premium bond — coupon > market rate, price > face.
    // bnd_price(1000.0, 0.06, 0.05, 10) == 1077.22
    // PV_ann = 60 * (1 - 1/1.05^10)/0.05 = 60 * 7.72173 = 463.30
    // PV_face = 1000/1.05^10 = 1000/1.62889 = 613.91
    // Price = 463.30 + 613.91 = 1077.21
    let p2 = bnd_price(1000.0, 0.06, 0.05, 10)
    _bnd_check("price_premium", p2, 1077.22, 0.01)

    // KAT 3: discount bond — coupon < market rate, price < face.
    // bnd_price(1000.0, 0.04, 0.05, 10) == 922.78
    // PV_ann = 40 * 7.72173 = 308.87
    // PV_face = 613.91
    // Price = 308.87 + 613.91 = 922.78
    let p3 = bnd_price(1000.0, 0.04, 0.05, 10)
    _bnd_check("price_discount", p3, 922.78, 0.01)

    // KAT 4: current yield of premium bond.
    // bnd_current_yield(1000.0, 0.06, 1077.22) == 60/1077.22 == 0.05570
    let cy4 = bnd_current_yield(1000.0, 0.06, 1077.22)
    _bnd_check("current_yield_premium", cy4, 0.0557, 0.0001)

    // KAT 5: current yield at par — equals coupon rate.
    // bnd_current_yield(1000.0, 0.05, 1000.0) == 0.05
    let cy5 = bnd_current_yield(1000.0, 0.05, 1000.0)
    _bnd_check("current_yield_at_par", cy5, 0.05, 0.0001)

    // KAT 6: approximate YTM of premium bond.
    // bnd_ytm_approx(1000.0, 0.06, 1077.22, 10)
    // C=60, (F-P)/n=(1000-1077.22)/10=-7.722, num=52.278, denom=(1000+1077.22)/2=1038.61
    // YTM = 52.278/1038.61 = 0.05034 — within 0.002 of 0.0505
    let ytm6 = bnd_ytm_approx(1000.0, 0.06, 1077.22, 10)
    _bnd_check("ytm_approx_premium", ytm6, 0.0505, 0.002)

    // KAT 7: approximate YTM at par — should equal coupon rate.
    // bnd_ytm_approx(1000.0, 0.05, 1000.0, 10)
    // C=50, (F-P)/n=0, num=50, denom=1000 => YTM=0.05
    let ytm7 = bnd_ytm_approx(1000.0, 0.05, 1000.0, 10)
    _bnd_check("ytm_approx_at_par", ytm7, 0.05, 0.0001)

    // KAT 8: Macaulay duration of at-par 5% bond, 10 years.
    // Standard formula: D = (1+r)/r * [1 - 1/(1+r)^n] for par bond
    // = 1.05/0.05 * (1 - 1/1.62889) = 21 * 0.38609 = 8.108 years
    let dur8 = bnd_duration(1000.0, 0.05, 0.05, 10)
    _bnd_check("duration_at_par", dur8, 8.108, 0.05)

    print("_bond_test passed")
