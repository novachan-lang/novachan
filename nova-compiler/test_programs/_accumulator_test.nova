// KAT test for std/util/accumulator.nova
// Reference dataset: 2,4,4,4,5,5,7,9 (n=8)
//   sum  = 40.0
//   mean = 5.0
//   population variance = 4.0   (Welford exact)
//   std  = 2.0
//   min  = 2.0   max = 9.0
//
// All floats compared with eps = 0.001.

import std/util/accumulator

fn _ckf(label: string, got: float, want: float)
    let diff = got - want
    if diff < 0.0
        diff = 0.0 - diff
    if diff > 0.001
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn _cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // ── KAT 1: fresh accumulator has count 0 ────────────────────────────────
    let empty = ac_new()
    _cki("empty_count", ac_count(empty), 0)

    // ── KAT 2-8: canonical dataset 2,4,4,4,5,5,7,9 ──────────────────────────
    let a = ac_new()
    ac_add(a, 2.0)
    ac_add(a, 4.0)
    ac_add(a, 4.0)
    ac_add(a, 4.0)
    ac_add(a, 5.0)
    ac_add(a, 5.0)
    ac_add(a, 7.0)
    ac_add(a, 9.0)

    _cki("count",    ac_count(a),    8)
    _ckf("sum",      ac_sum(a),      40.0)
    _ckf("mean",     ac_mean(a),     5.0)
    _ckf("variance", ac_variance(a), 4.0)
    let sd = ac_std(a)
    _ckf("std",      sd,             2.0)
    _ckf("min",      ac_min(a),      2.0)
    _ckf("max",      ac_max(a),      9.0)

    // ── KAT 9: single-element accumulator (variance/std == 0) ────────────────
    let b = ac_new()
    ac_add(b, 7.0)
    _cki("single_count", ac_count(b), 1)
    _ckf("single_mean",     ac_mean(b),     7.0)
    _ckf("single_variance", ac_variance(b), 0.0)
    let sd_b = ac_std(b)
    _ckf("single_std",      sd_b,           0.0)
    _ckf("single_min",      ac_min(b),      7.0)
    _ckf("single_max",      ac_max(b),      7.0)

    // ── KAT 10: empty guards (all return 0.0) ────────────────────────────────
    let e = ac_new()
    _ckf("empty_mean",     ac_mean(e),     0.0)
    _ckf("empty_variance", ac_variance(e), 0.0)
    let sd_e = ac_std(e)
    _ckf("empty_std",      sd_e,           0.0)
    _ckf("empty_min",      ac_min(e),      0.0)
    _ckf("empty_max",      ac_max(e),      0.0)

    // ── KAT 11: negative-value dataset [-3, 0, 3] ────────────────────────────
    // mean = 0.0, pop_var = 6.0, std ~ 2.449
    let c = ac_new()
    ac_add(c, -3.0)
    ac_add(c, 0.0)
    ac_add(c, 3.0)
    _ckf("neg_mean",     ac_mean(c),     0.0)
    _ckf("neg_variance", ac_variance(c), 6.0)
    _ckf("neg_min",      ac_min(c),     -3.0)
    _ckf("neg_max",      ac_max(c),      3.0)
    let sd_c = ac_std(c)
    _ckf("neg_std",      sd_c,           2.449)

    // ── KAT 12: incremental sum stays accurate ────────────────────────────────
    // Add 1.0 ten times: sum == 10.0, mean == 1.0, variance == 0.0
    let d = ac_new()
    let i = 0
    while i < 10
        ac_add(d, 1.0)
        i = i + 1
    _cki("rep_count", ac_count(d), 10)
    _ckf("rep_sum",   ac_sum(d),   10.0)
    _ckf("rep_mean",  ac_mean(d),  1.0)
    let vd = ac_variance(d)
    _ckf("rep_var",   vd,          0.0)

    print("_accumulator_test passed")
