// _dist_t_test.nova — KAT for std/numeric/dist_t
// Known-answer values verified analytically / against scipy.stats.t.
import std/numeric/dist_t

fn approx(a, b, tol) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < tol
        return 1
    return 0

fn ck(label: string, got: float, want: float, tol: float)
    let ok = approx(got, want, tol)
    if ok == 0
        print("FAIL dist_t " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)
    print("ok " + label)

fn main()
    // t_cdf(0.0, 10) = 0.5 by symmetry
    let v1 = t_cdf(0.0, 10.0)
    ck("t_cdf(0,10)=0.5", v1, 0.5, 0.001)

    // t_pdf(0.0, 100) ~ normal pdf at 0 = 0.3989 (within 0.01 for large df)
    let v2 = t_pdf(0.0, 100.0)
    ck("t_pdf(0,100)~0.3989", v2, 0.3989, 0.01)

    // Symmetry: t_pdf(1.0, df) == t_pdf(-1.0, df)
    let v3a = t_pdf(1.0, 10.0)
    let v3b = t_pdf(0.0 - 1.0, 10.0)
    ck("t_pdf symmetry: pdf(1,10)==pdf(-1,10)", v3a, v3b, 0.0001)

    // Heavier tails than normal: t_pdf(3.0, 2) > normal_pdf(3.0)
    // normal_pdf(3) = 0.004432; t(df=2) pdf(3) ~ 0.0286 > 0.004432
    let v4 = t_pdf(3.0, 2.0)
    // Just check it's larger than the normal pdf at 3 (0.0044) by a clear margin
    let ok4 = approx(v4, 0.0286, 0.01)
    if ok4 == 0
        print("FAIL dist_t heavier-tails: got=" + str(v4) + " want~0.0286")
        exit(1)
    print("ok t_pdf heavier tails (df=2)")

    // t_cdf(-inf limit): t_cdf(-50, 10) ~ 0
    let v5 = t_cdf(0.0 - 50.0, 10.0)
    ck("t_cdf(-50,10)~0", v5, 0.0, 0.001)

    // t_cdf(50, 10) ~ 1
    let v6 = t_cdf(50.0, 10.0)
    ck("t_cdf(50,10)~1", v6, 1.0, 0.001)

    // t_cdf(1.812, 10) ~ 0.95 (from t-table, df=10, 95th pct)
    let v7 = t_cdf(1.812, 10.0)
    ck("t_cdf(1.812,10)~0.95", v7, 0.95, 0.005)

    // Symmetry of CDF: t_cdf(-x,df) + t_cdf(x,df) = 1
    let vcdf_pos = t_cdf(1.5, 5.0)
    let vcdf_neg = t_cdf(0.0 - 1.5, 5.0)
    let cdf_sum = vcdf_pos + vcdf_neg
    ck("t_cdf sym: cdf(1.5)+cdf(-1.5)=1", cdf_sum, 1.0, 0.002)

    print("PASS _dist_t_test")
