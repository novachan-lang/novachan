// KAT for std/chem/electrochemistry — electrochemical cell formulas.
import std/chem/electrochemistry

// approx — float equality within tolerance.
fn approx(a, b, tol)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < tol

fn ckf(label, got, want, tol)
    if not approx(got, want, tol)
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // cell_potential: E = cathode - anode
    // Cu/Zn cell: cathode=0.34 (Cu2+/Cu), anode=-0.76 (Zn2+/Zn) -> 1.10 V
    ckf("cell_potential(0.34,-0.76)", cell_potential(0.34, -0.76), 1.10, 0.001)
    // Zero: same electrode
    ckf("cell_potential(0.5,0.5)", cell_potential(0.5, 0.5), 0.0, 0.001)

    // nernst: E = E0 - (0.0257/n)*ln(Q)
    // Q=1 -> ln(1)=0 -> E = E0
    ckf("nernst(1.10,2.0,1.0)", nernst(1.10, 2.0, 1.0), 1.10, 0.001)
    // Q=e (Euler's number, ln(e)=1) -> E = E0 - 0.0257/2 = 1.10 - 0.01285 = 1.08715
    // e ~ 2.71828
    let e_val = 2.71828
    let expected_nernst = 1.10 - (0.0257 / 2.0)
    ckf("nernst(1.10,2.0,e)", nernst(1.10, 2.0, e_val), expected_nernst, 0.002)

    // is_spontaneous: positive cell potential = spontaneous
    if not is_spontaneous(1.10)
        print("FAIL is_spontaneous(1.10) should be true")
        exit(1)
    if is_spontaneous(-0.5)
        print("FAIL is_spontaneous(-0.5) should be false")
        exit(1)
    if is_spontaneous(0.0)
        print("FAIL is_spontaneous(0.0) should be false")
        exit(1)

    // faraday_moles_electrons: moles = charge / 96485
    ckf("faraday_moles_electrons(96485.0)", faraday_moles_electrons(96485.0), 1.0, 0.001)
    ckf("faraday_moles_electrons(48242.5)", faraday_moles_electrons(48242.5), 0.5, 0.001)

    print("PASS _electrochemistry_test")
