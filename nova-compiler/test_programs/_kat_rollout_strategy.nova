import forge_rollout_strategy

fn main()
    let r = rs_new("linear", 100)
    assert(rs_strategy(r) == "linear", "linear")
    assert(rs_current_pct(r) == 0, "starts 0%")
    assert(rs_is_complete(r) == 0, "not complete")

    r = rs_advance(r)
    assert(rs_current_pct(r) == 10, "10%")
    assert(rs_targets_affected(r) == 10, "10 targets")

    r = rs_advance(r)
    r = rs_advance(r)
    assert(rs_current_pct(r) == 30, "30%")
    assert(rs_step_count(r) == 3, "3 steps")

    r = rs_pause(r)
    r = rs_advance(r)
    assert(rs_current_pct(r) == 30, "paused no advance")
    r = rs_resume(r)
    r = rs_advance(r)
    assert(rs_current_pct(r) == 40, "resumed to 40%")

    r = rs_rollback(r)
    assert(rs_current_pct(r) == 0, "rolled back to 0%")
    assert(rs_step_count(r) == 0, "0 steps after rollback")

    let e = rs_new("exponential", 1000)
    e = rs_advance(e)
    assert(rs_current_pct(e) == 1, "exp 1%")
    e = rs_advance(e)
    assert(rs_current_pct(e) == 2, "exp 2%")
    e = rs_advance(e)
    assert(rs_current_pct(e) == 4, "exp 4%")
    e = rs_advance(e)
    assert(rs_current_pct(e) == 8, "exp 8%")

    print("ROLLOUT-STRATEGY KAT PASS")
