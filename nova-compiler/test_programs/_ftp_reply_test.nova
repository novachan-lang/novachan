// KAT for std/net/ftp_reply — FTP reply + command codec (RFC 959).
import std/net/ftp_reply

// ── Assert helpers ───────────────────────────────────────────────────────────

fn assert_s(label: string, got: string, want: string)
    if got != want
        print("FAIL ftp_reply " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn assert_i(label: string, got: int, want: int)
    if got != want
        print("FAIL ftp_reply " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    let crlf = chr(13) + chr(10)

    // ── KAT 1: single-line parse ──────────────────────────────────────────────
    let r1 = ftp_reply_parse("230 Login successful")
    assert_i("single-code",     r1["code"],     230)
    assert_i("single-complete", r1["complete"],   1)
    let r1lines = r1["lines"]
    assert_i("single-lines-len", len(r1lines), 1)
    assert_s("single-lines-0",   r1lines[0], "Login successful")

    // ── KAT 2: multi-line parse ───────────────────────────────────────────────
    let multi = "211-Features:" + crlf + " STARTTLS" + crlf + "211 End"
    let r2 = ftp_reply_parse(multi)
    assert_i("multi-code",     r2["code"],     211)
    assert_i("multi-complete", r2["complete"],   1)
    let r2lines = r2["lines"]
    assert_i("multi-lines-len", len(r2lines), 3)
    assert_s("multi-lines-0",   r2lines[0], "Features:")
    assert_s("multi-lines-1",   r2lines[1], " STARTTLS")
    assert_s("multi-lines-2",   r2lines[2], "End")

    // ── KAT 3: ftp_command with argument ─────────────────────────────────────
    let cmd1 = ftp_command("USER", "bob")
    assert_s("cmd-user", cmd1, "USER bob" + crlf)

    // ── KAT 4: ftp_command without argument ──────────────────────────────────
    let cmd2 = ftp_command("PASV", "")
    assert_s("cmd-pasv", cmd2, "PASV" + crlf)

    // ── KAT 5: round-trip single-line build -> parse ──────────────────────────
    let blines1 = []
    push(blines1, "Welcome to FTP server")
    let built1 = ftp_reply_build(220, blines1)
    let rb1 = ftp_reply_parse(built1)
    assert_i("rt1-code",     rb1["code"],     220)
    assert_i("rt1-complete", rb1["complete"],   1)
    let rb1lines = rb1["lines"]
    assert_i("rt1-lines-len", len(rb1lines), 1)
    assert_s("rt1-lines-0",   rb1lines[0], "Welcome to FTP server")

    // ── KAT 6: round-trip multi-line build -> parse ───────────────────────────
    let blines2 = []
    push(blines2, "Extensions supported:")
    push(blines2, " SIZE")
    push(blines2, " MLST")
    push(blines2, "Done")
    let built2 = ftp_reply_build(211, blines2)
    let rb2 = ftp_reply_parse(built2)
    assert_i("rt2-code",     rb2["code"],     211)
    assert_i("rt2-complete", rb2["complete"],   1)
    let rb2lines = rb2["lines"]
    assert_i("rt2-lines-len", len(rb2lines), 4)
    assert_s("rt2-lines-0",   rb2lines[0], "Extensions supported:")
    assert_s("rt2-lines-1",   rb2lines[1], " SIZE")
    assert_s("rt2-lines-2",   rb2lines[2], " MLST")
    assert_s("rt2-lines-3",   rb2lines[3], "Done")

    // ── KAT 7: malformed / no code → code=0, complete=0 ──────────────────────
    let rbad = ftp_reply_parse("hello world")
    assert_i("bad-code",     rbad["code"],     0)
    assert_i("bad-complete", rbad["complete"],  0)

    // ── KAT 8: incomplete multi-line (no terminator) → complete=0 ────────────
    let partial = "211-Features:" + crlf + " STARTTLS"
    let rp = ftp_reply_parse(partial)
    assert_i("partial-code",     rp["code"],    211)
    assert_i("partial-complete", rp["complete"],  0)

    // ── KAT 9: single-line with CRLF terminator ───────────────────────────────
    let r9 = ftp_reply_parse("331 Password required" + crlf)
    assert_i("crlf-code",     r9["code"],     331)
    assert_i("crlf-complete", r9["complete"],   1)
    let r9lines = r9["lines"]
    assert_s("crlf-lines-0",  r9lines[0], "Password required")

    // ── KAT 10: ftp_reply_build single empty line ─────────────────────────────
    let blines3 = []
    push(blines3, "")
    let built3 = ftp_reply_build(200, blines3)
    assert_s("build-empty-line", built3, "200 " + crlf)

    // ── KAT 11: more ftp_command variants ────────────────────────────────────
    let cmd3 = ftp_command("STOR", "file.txt")
    assert_s("cmd-stor", cmd3, "STOR file.txt" + crlf)

    let cmd4 = ftp_command("QUIT", "")
    assert_s("cmd-quit", cmd4, "QUIT" + crlf)

    print("PASS _ftp_reply_test")
