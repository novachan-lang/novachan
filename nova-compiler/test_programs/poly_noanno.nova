fn first(items) -> string
    return str(items[0])

fn main()
    let nums = [42, 99]
    let strs = ["hello", "world"]
    let r1 = first(nums)
    let r2 = first(strs)
    assert(r1 == "42", "first(nums) should be 42, got: " + r1)
    assert(r2 == "hello", "first(strs) should be hello, got: " + r2)
    print("OK: " + r1 + " " + r2)
