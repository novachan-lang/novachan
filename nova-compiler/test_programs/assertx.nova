fn assert_gt(a, b, msg)
  if a <= b
    panic(msg + " (expected " + str(a) + " > " + str(b) + ")")

fn assert_gte(a, b, msg)
  if a < b
    panic(msg + " (expected " + str(a) + " >= " + str(b) + ")")

fn assert_lt(a, b, msg)
  if a >= b
    panic(msg + " (expected " + str(a) + " < " + str(b) + ")")

fn assert_lte(a, b, msg)
  if a > b
    panic(msg + " (expected " + str(a) + " <= " + str(b) + ")")

fn assert_between(val, lo, hi, msg)
  if val < lo or val > hi
    panic(msg + " (expected " + str(val) + " between " + str(lo) + " and " + str(hi) + ")")

fn assert_len(xs, expected, msg)
  let actual = len(xs)
  if actual != expected
    panic(msg + " (expected len " + str(expected) + ", got " + str(actual) + ")")

fn assert_starts(s, prefix, msg)
  if not starts_with(s, prefix)
    panic(msg + " (expected to start with '" + prefix + "', got '" + s + "')")

fn assert_ends(s, suffix, msg)
  let slen = len(s)
  let suflen = len(suffix)
  if slen < suflen
    panic(msg + " (string too short for suffix)")
  if slice(s, slen - suflen, slen) != suffix
    panic(msg + " (expected to end with '" + suffix + "')")

fn assert_type(val, expected_type, msg)
  let actual = type_of(val)
  if actual != expected_type
    panic(msg + " (expected type '" + expected_type + "', got '" + actual + "')")

fn assert_not_eq(a, b, msg)
  if a == b
    panic(msg + " (expected " + str(a) + " != " + str(b) + ")")

fn assert_ok(result, msg)
  if is_err(result)
    panic(msg + " (expected Ok, got Err)")

fn assert_err(result, msg)
  if is_ok(result)
    panic(msg + " (expected Err, got Ok)")

fn main()
  assert_gt(10, 5, "10 > 5")
  assert_gte(10, 10, "10 >= 10")
  assert_lt(5, 10, "5 < 10")
  assert_lte(10, 10, "10 <= 10")
  assert_between(5, 1, 10, "5 in 1-10")
  assert_len([1, 2, 3], 3, "list len 3")
  assert_starts("hello world", "hello", "starts hello")
  assert_ends("hello world", "world", "ends world")
  assert_type(42, "int", "42 is int")
  assert_type("hi", "string", "hi is string")
  assert_type([1], "list", "list is list")
  assert_not_eq(1, 2, "1 != 2")
  assert_ok(ok(1), "ok is ok")
  assert_err(err("x"), "err is err")

  print("assertx: all passed")
