import std/finance/bond_price

fn approx(a: float, b: float, tol: float) -> float
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < tol
        return 1.0
    return 0.0

fn main()
    // KAT 1: par bond — coupon_rate == ytm => price == face
    // bond_price(1000.0, 0.05, 0.05, 10) == 1000.0
    let p1 = bond_price(1000.0, 0.05, 0.05, 10)
    let ok1 = approx(p1, 1000.0, 0.01)
    if ok1 == 0.0
        print("FAIL bond_price par_bond: got=" + str(p1))
        exit(1)

    // KAT 2: discount bond — ytm > coupon_rate => price < face
    // bond_price(1000.0, 0.04, 0.05, 10) should be ~922.78
    let p2 = bond_price(1000.0, 0.04, 0.05, 10)
    if p2 >= 1000.0
        print("FAIL bond_price discount_bond not below face: got=" + str(p2))
        exit(1)
    let ok2 = approx(p2, 922.78, 0.05)
    if ok2 == 0.0
        print("FAIL bond_price discount_bond value: got=" + str(p2))
        exit(1)

    // KAT 3: zero-coupon 1yr at 5%
    // bond_price(1000.0, 0.0, 0.05, 1) == 1000/1.05 == 952.38...
    let p3 = bond_price(1000.0, 0.0, 0.05, 1)
    let ok3 = approx(p3, 952.38, 0.05)
    if ok3 == 0.0
        print("FAIL bond_price zero_coupon_1yr: got=" + str(p3))
        exit(1)

    // KAT 4: premium bond — coupon_rate > ytm => price > face
    // bond_price(1000.0, 0.06, 0.05, 10) should be ~1077.22
    let p4 = bond_price(1000.0, 0.06, 0.05, 10)
    if p4 <= 1000.0
        print("FAIL bond_price premium_bond not above face: got=" + str(p4))
        exit(1)
    let ok4 = approx(p4, 1077.22, 0.05)
    if ok4 == 0.0
        print("FAIL bond_price premium_bond value: got=" + str(p4))
        exit(1)

    // KAT 5: zero-coupon 10yr at 5%
    // bond_price(1000.0, 0.0, 0.05, 10) == 1000/1.05^10 == 613.91
    let p5 = bond_price(1000.0, 0.0, 0.05, 10)
    let ok5 = approx(p5, 613.91, 0.05)
    if ok5 == 0.0
        print("FAIL bond_price zero_coupon_10yr: got=" + str(p5))
        exit(1)

    print("PASS _bond_price_test")
