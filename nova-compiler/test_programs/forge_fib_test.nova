import forge_fib

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn expect_false(name: string, cond: bool) -> int
    if cond
        print("FAIL " + name + ": expected false")
        return 1
    0

fn join_ints(lst) -> string
    let parts = []
    let i = 0
    while i < len(lst)
        push(parts, str(lst[i]))
        i = i + 1
    join(parts, ",")

fn main()
    let fails = 0

    // known fibonacci values
    fails = fails + expect("f0", str(fibonacci(0)), "0")
    fails = fails + expect("f1", str(fibonacci(1)), "1")
    fails = fails + expect("f2", str(fibonacci(2)), "1")
    fails = fails + expect("f10", str(fibonacci(10)), "55")
    fails = fails + expect("f20", str(fibonacci(20)), "6765")
    fails = fails + expect("f30", str(fibonacci(30)), "832040")

    // sequence
    fails = fails + expect("seq8", join_ints(fib_sequence(8)), "0,1,1,2,3,5,8,13")
    fails = fails + expect("seq1", join_ints(fib_sequence(1)), "0")
    fails = fails + expect("seq0", str(len(fib_sequence(0))), "0")

    // is_fibonacci
    fails = fails + expect_true("is_13", is_fibonacci(13))
    fails = fails + expect_true("is_0", is_fibonacci(0))
    fails = fails + expect_true("is_144", is_fibonacci(144))
    fails = fails + expect_false("is_14", is_fibonacci(14))
    fails = fails + expect_false("is_100", is_fibonacci(100))
    fails = fails + expect_false("is_neg", is_fibonacci(0 - 5))

    // lucas
    fails = fails + expect("l0", str(lucas(0)), "2")
    fails = fails + expect("l1", str(lucas(1)), "1")
    fails = fails + expect("l2", str(lucas(2)), "3")
    fails = fails + expect("l5", str(lucas(5)), "11")
    fails = fails + expect("l10", str(lucas(10)), "123")

    // identity: L(n) = F(n-1) + F(n+1) for n>=1
    let idn_ok = true
    let n = 1
    while n < 15
        if lucas(n) != fibonacci(n - 1) + fibonacci(n + 1)
            idn_ok = false
        n = n + 1
    fails = fails + expect_true("lucas_fib_identity", idn_ok)

    if fails == 0
        print("forge_fib: all passed")
    else
        print("forge_fib: " + str(fails) + " FAILED")
