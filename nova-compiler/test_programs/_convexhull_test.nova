import std/geometry/convexhull

// Helper: compare two hull results element-by-element.
// Each element is a [x,y] list; we compare as "x*10000+y" to get a unique int.
fn hull_eq(a: list, b: list) -> bool
    if len(a) != len(b)
        return false
    let i = 0
    while i < len(a)
        let ai = a[i]
        let bi = b[i]
        if ai[0] != bi[0]
            return false
        if ai[1] != bi[1]
            return false
        i = i + 1
    true

fn main()
    // KAT 1: ch_size of a 5-point set with one interior point.
    // pts = [[0,0],[1,1],[2,2],[2,0],[0,2]]
    // Hull = [[0,0],[2,0],[2,2],[0,2]] -> 4 vertices.
    let pts5 = [[0, 0], [1, 1], [2, 2], [2, 0], [0, 2]]
    let s1 = ch_size(pts5)
    if s1 != 4
        print("FAIL ch_size(pts5): expected 4 got " + str(s1))
        exit(1)

    // KAT 2: ch_area2 of the same set.
    // 2 * area of the 2x2 square = 2*4 = 8.
    let a2 = ch_area2(pts5)
    if a2 != 8
        print("FAIL ch_area2(pts5): expected 8 got " + str(a2))
        exit(1)

    // KAT 3: ch_hull returns the correct ordered vertices.
    // Expected CCW from lex-min: [[0,0],[2,0],[2,2],[0,2]].
    let h3 = ch_hull(pts5)
    let expected3 = [[0, 0], [2, 0], [2, 2], [0, 2]]
    if hull_eq(h3, expected3) == false
        print("FAIL ch_hull(pts5): wrong hull")
        exit(1)

    // KAT 4: ch_size of a triangle — all 3 points on the hull.
    let tri = [[0, 0], [1, 0], [0, 1]]
    let s4 = ch_size(tri)
    if s4 != 3
        print("FAIL ch_size(triangle): expected 3 got " + str(s4))
        exit(1)

    // KAT 5: ch_size of 3 collinear points — only the 2 endpoints survive.
    let col = [[0, 0], [1, 1], [2, 2]]
    let s5 = ch_size(col)
    if s5 != 2
        print("FAIL ch_size(collinear): expected 2 got " + str(s5))
        exit(1)

    // KAT 6: ch_area2 of a 4x3 rectangle.
    // Vertices [[0,0],[4,0],[4,3],[0,3]] -> 2*area = 2*12 = 24.
    let rect = [[0, 0], [4, 0], [4, 3], [0, 3]]
    let a6 = ch_area2(rect)
    if a6 != 24
        print("FAIL ch_area2(rect): expected 24 got " + str(a6))
        exit(1)

    // KAT 7: single point -> hull size 1.
    let single = [[3, 7]]
    let s7 = ch_size(single)
    if s7 != 1
        print("FAIL ch_size(single): expected 1 got " + str(s7))
        exit(1)

    // KAT 8: empty set -> hull size 0.
    let empty = []
    let s8 = ch_size(empty)
    if s8 != 0
        print("FAIL ch_size(empty): expected 0 got " + str(s8))
        exit(1)

    print("_convexhull_test passed")
