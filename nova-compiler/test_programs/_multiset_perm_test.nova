import std/combinatorics/multiset_perm

// cki — check integer equality
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL multiset_perm " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// list_to_str — flatten a list to a string
fn list_to_str(xs) -> string
    let s = "["
    let i = 0
    let n = len(xs)
    while i < n
        if i > 0
            s = s + ","
        s = s + str(xs[i])
        i = i + 1
    s = s + "]"
    return s

// sublist_to_str — convert list-of-lists to string
fn sublist_to_str(xss) -> string
    let s = "["
    let i = 0
    let n = len(xss)
    while i < n
        if i > 0
            s = s + ","
        s = s + list_to_str(xss[i])
        i = i + 1
    s = s + "]"
    return s

fn ckl(label: string, got, want: string)
    let gs = list_to_str(got)
    if gs != want
        print("FAIL multiset_perm " + label + ": got=" + gs + " want=" + want)
        exit(1)

fn ckll(label: string, got, want: string)
    let gs = sublist_to_str(got)
    if gs != want
        print("FAIL multiset_perm " + label + ": got=" + gs + " want=" + want)
        exit(1)

fn main()
    // --- mp_factorial ---
    cki("factorial(0)", mp_factorial(0), 1)
    cki("factorial(1)", mp_factorial(1), 1)
    cki("factorial(5)", mp_factorial(5), 120)

    // --- mp_multinomial ---
    // 3!/(2!1!) = 3
    let c21 = [2, 1]
    cki("mp_count([2,1])", mp_count(c21), 3)
    cki("mp_multinomial([2,1])", mp_multinomial(c21), 3)
    // 4!/(2!2!) = 6
    let c22 = [2, 2]
    cki("mp_multinomial([2,2])", mp_multinomial(c22), 6)
    // 6!/(3!2!1!) = 720/12 = 60
    let c321 = [3, 2, 1]
    cki("mp_multinomial([3,2,1])", mp_multinomial(c321), 60)
    // all distinct: 3!/1!1!1! = 6
    let c111 = [1, 1, 1]
    cki("mp_multinomial([1,1,1])", mp_multinomial(c111), 6)

    // --- mp_all ---
    // [1,1,2] => [[1,1,2],[1,2,1],[2,1,1]]
    let items112 = [1, 1, 2]
    let a112 = mp_all(items112)
    cki("mp_all([1,1,2]) len", len(a112), 3)
    ckll("mp_all([1,1,2])", a112, "[[1,1,2],[1,2,1],[2,1,1]]")

    // [1,2,3] — all distinct, 6 permutations
    let items123 = [1, 2, 3]
    let a123 = mp_all(items123)
    cki("mp_all([1,2,3]) len", len(a123), 6)
    ckl("mp_all([1,2,3])[0]", a123[0], "[1,2,3]")
    ckl("mp_all([1,2,3])[5]", a123[5], "[3,2,1]")

    // [1,1,1] — only one distinct permutation
    let items111 = [1, 1, 1]
    let a111 = mp_all(items111)
    cki("mp_all([1,1,1]) len", len(a111), 1)
    ckll("mp_all([1,1,1])", a111, "[[1,1,1]]")

    // [1,1,2,2] — 4!/(2!2!) = 6
    let items1122 = [1, 1, 2, 2]
    let a1122 = mp_all(items1122)
    cki("mp_all([1,1,2,2]) len", len(a1122), 6)

    // --- mp_distinct_count ---
    cki("mp_distinct_count([1,1,2])", mp_distinct_count(items112), 3)
    cki("mp_distinct_count([1,2,3])", mp_distinct_count(items123), 6)
    cki("mp_distinct_count([1,1,1])", mp_distinct_count(items111), 1)
    cki("mp_distinct_count([1,1,2,2])", mp_distinct_count(items1122), 6)

    // --- mp_next ---
    // [1,1,2] -> [1,2,1]
    let nx1 = mp_next(items112)
    ckl("mp_next([1,1,2])", nx1, "[1,2,1]")
    // [1,2,1] -> [2,1,1]
    let p121 = [1, 2, 1]
    let nx2 = mp_next(p121)
    ckl("mp_next([1,2,1])", nx2, "[2,1,1]")
    // [2,1,1] -> [] (last permutation)
    let p211 = [2, 1, 1]
    let nx3 = mp_next(p211)
    cki("mp_next([2,1,1]) len (last)", len(nx3), 0)
    // [1,2,3] -> [1,3,2]
    let p123 = [1, 2, 3]
    let nx4 = mp_next(p123)
    ckl("mp_next([1,2,3])", nx4, "[1,3,2]")
    // [3,2,1] -> [] (last)
    let p321 = [3, 2, 1]
    let nx5 = mp_next(p321)
    cki("mp_next([3,2,1]) len (last)", len(nx5), 0)

    print("PASS _multiset_perm_test")
