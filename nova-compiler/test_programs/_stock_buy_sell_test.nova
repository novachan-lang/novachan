import std/greedy/stock_buy_sell

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _stock_buy_sell_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: int, want: int)
    if got != want
        print("FAIL _stock_buy_sell_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── sb_one_transaction ──────────────────────────────────────────────────
    // buy at 1, sell at 6 => profit 5
    cki("one_1", sb_one_transaction([7, 1, 5, 3, 6, 4]), 5)
    // always decreasing => no profit
    cki("one_dec", sb_one_transaction([7, 6, 4, 3, 1]), 0)
    // empty => 0
    cki("one_empty", sb_one_transaction([]), 0)
    // single price => 0
    cki("one_single", sb_one_transaction([5]), 0)
    // two prices, profitable
    cki("one_two_up", sb_one_transaction([1, 10]), 9)
    // two prices, not profitable
    cki("one_two_down", sb_one_transaction([10, 1]), 0)
    // all same => 0
    cki("one_flat", sb_one_transaction([3, 3, 3, 3]), 0)
    // buy at start, sell at end
    cki("one_ends", sb_one_transaction([1, 2, 3, 4, 5]), 4)

    // ── sb_multi_transaction ────────────────────────────────────────────────
    // [7,1,5,3,6,4]: buy@1 sell@5 (+4), buy@3 sell@6 (+3) = 7
    cki("multi_1", sb_multi_transaction([7, 1, 5, 3, 6, 4]), 7)
    // monotone up: buy@1 sell@5 = 4
    cki("multi_up", sb_multi_transaction([1, 2, 3, 4, 5]), 4)
    // monotone down: no profits
    cki("multi_down", sb_multi_transaction([5, 4, 3, 2, 1]), 0)
    // empty => 0
    cki("multi_empty", sb_multi_transaction([]), 0)
    // single => 0
    cki("multi_single", sb_multi_transaction([3]), 0)
    // flat => 0
    cki("multi_flat", sb_multi_transaction([2, 2, 2, 2]), 0)

    // ── sb_with_fee ─────────────────────────────────────────────────────────
    // [1,3,2,8,4,9] fee=2: buy@1 sell@3 net=0; or buy@1 sell@8 net=5, buy@4 sell@9 net=3 = 8
    cki("fee_1", sb_with_fee([1, 3, 2, 8, 4, 9], 2), 8)
    // empty => 0
    cki("fee_empty", sb_with_fee([], 2), 0)
    // single => 0
    cki("fee_single", sb_with_fee([5], 2), 0)
    // fee eats all profit: buy@1 sell@2 would give 1-1=0
    cki("fee_kills", sb_with_fee([1, 2], 1), 0)
    // fee=0, equivalent to multi_transaction
    cki("fee_zero", sb_with_fee([1, 2, 3, 4, 5], 0), 4)
    // decreasing, no trades
    cki("fee_dec", sb_with_fee([9, 8, 7, 6], 2), 0)

    print("PASS _stock_buy_sell_test")
