import forge_connection_pool

fn main()
    let p = cp_new(3)
    let r1 = cp_add(p, "conn1")
    assert(is_ok(r1), "add conn1")
    p = unwrap(r1)
    let r2 = cp_add(p, "conn2")
    assert(is_ok(r2), "add conn2")
    p = unwrap(r2)
    assert(cp_available(p) == 2, "2 available")

    let b1 = cp_borrow(p)
    assert(is_ok(b1), "borrow ok")
    let conn_key = unwrap(b1)
    assert(cp_in_use(p) == 1, "1 in use")
    assert(cp_available(p) == 1, "1 available after borrow")

    let rel = cp_release(p, conn_key)
    assert(is_ok(rel), "release ok")
    p = unwrap(rel)
    assert(cp_in_use(p) == 0, "0 in use after release")
    assert(cp_available(p) == 2, "2 available after release")

    assert(cp_total_created(p) == 2, "2 created")
    assert(cp_total_borrowed(p) == 1, "1 borrowed")

    let r3 = cp_add(p, "conn3")
    assert(is_ok(r3), "add conn3")
    p = unwrap(r3)
    let r4 = cp_add(p, "conn4")
    assert(is_err(r4), "pool full")

    print("CONNECTION-POOL KAT PASS")
