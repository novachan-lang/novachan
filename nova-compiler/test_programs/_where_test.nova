print(a + b) where a = 10, b = 20

let total = sum(xs) where xs = [1, 2, 3, 4, 5]
assert(total == 15, "where with let")

let result = x * y where x = 6, y = 7
assert(result == 42, "where multiple bindings")

let msg = upper(s) where s = "hello"
assert(msg == "HELLO", "where with function call")

let doubled = map(nums, fn(x) x * 2) where nums = [1, 2, 3]
assert(doubled == [2, 4, 6], "where with lambda")

let greeting = name + "!" where name = "NOVA"
assert(greeting == "NOVA!", "where with string concat")

print("all where tests passed")
