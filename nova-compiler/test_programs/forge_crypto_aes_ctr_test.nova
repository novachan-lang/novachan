// Forge crypto: AES-CTR, gated against the NIST SP 800-38A CTR-AES128 vector + a self-inverse round-trip.
import forge_crypto

fn main()
    let key = hex_to_blist("2b7e151628aed2a6abf7158809cf4f3c")
    let iv = hex_to_blist("f0f1f2f3f4f5f6f7f8f9fafbfcfdfeff")
    let pt = hex_to_blist("6bc1bee22e409f96e93d7e117393172aae2d8a571e03ac9c9eb76fac45af8e5130c81c46a35ce411e5fbc1191a0a52eff69f2445df4f9b17ad2b417be66c3710")
    let want = "874d6191b620e3261bef6864990db6ce9806f66b7970fdff8617187bb9fffdff5ae4df3edbd5d35e5b4f09020db03eab1e031dda2fbe03d1792170a0f3009cee"

    let ct = aes_ctr(key, iv, pt)
    if hex_of(ct) != want
        print("FAIL: CTR vector -> " + hex_of(ct))
        exit(1)

    // self-inverse: CTR over the ciphertext recovers the plaintext
    if hex_of(aes_ctr(key, iv, ct)) != hex_of(pt)
        print("FAIL: CTR round-trip")
        exit(1)

    print("PASS forge_crypto_aes_ctr (NIST SP 800-38A CTR-AES128 + round-trip)")
