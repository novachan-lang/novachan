// KAT test for std/numeric/sf_beta — Beta function and combinatorics.
//
// Known answers:
//   beta(2.0, 3.0)  = Gamma(2)*Gamma(3)/Gamma(5) = 1*2/24 = 1/12 ~= 0.0833333
//   beta(1.0, 1.0)  = Gamma(1)*Gamma(1)/Gamma(2) = 1*1/1  = 1.0
//   beta(0.5, 0.5)  = Gamma(0.5)^2 / Gamma(1)   = pi / 1 = pi ~= 3.14159
//   ln_beta(2.0, 3.0) = ln(1/12) ~= -2.484907
//   binomial_coeff_float(5.0, 2.0) = C(5,2) = 10
//   binomial_coeff_float(4.0, 0.0) = C(4,0) = 1
import std/numeric/sf_beta

fn approx(a, b, tol) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < tol
        return 1
    return 0

fn ck(label: string, got: float, want: float, tol: float)
    let ok = approx(got, want, tol)
    if ok == 0
        print("FAIL sf_beta " + label + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("ok " + label)

fn main()
    // beta(2.0, 3.0) = 1/12 ~= 0.0833333
    let b23 = beta(2.0, 3.0)
    ck("beta(2.0,3.0)=1/12", b23, 0.0833333, 0.0001)

    // beta(1.0, 1.0) = 1.0
    let b11 = beta(1.0, 1.0)
    ck("beta(1.0,1.0)=1.0", b11, 1.0, 0.0001)

    // ln_beta(2.0, 3.0) = ln(1/12) ~= -2.4849066
    let lb23 = ln_beta(2.0, 3.0)
    ck("ln_beta(2.0,3.0)=ln(1/12)", lb23, 0.0 - 2.4849066, 0.0001)

    // binomial_coeff_float(5.0, 2.0) = C(5,2) = 10
    let c52 = binomial_coeff_float(5.0, 2.0)
    ck("binomial_coeff_float(5.0,2.0)=10", c52, 10.0, 0.01)

    // binomial_coeff_float(6.0, 3.0) = C(6,3) = 20
    let c63 = binomial_coeff_float(6.0, 3.0)
    ck("binomial_coeff_float(6.0,3.0)=20", c63, 20.0, 0.01)

    // binomial_coeff_float(4.0, 0.0) = C(4,0) = 1
    let c40 = binomial_coeff_float(4.0, 0.0)
    ck("binomial_coeff_float(4.0,0.0)=1", c40, 1.0, 0.01)

    print("PASS _sf_beta_test")
