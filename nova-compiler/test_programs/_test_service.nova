@service
type AuthService
    db: string
    cache: string

@service("custom_auth")
type CustomAuth
    store: string

fn main()
    assert(AuthService__service_name() == "auth_service", "auto name")
    assert(AuthService__is_service() == 1, "is service")
    assert(AuthService__dependencies() == "string, string", "deps")

    assert(CustomAuth__service_name() == "custom_auth", "custom name")
    assert(CustomAuth__is_service() == 1, "custom is service")
    assert(CustomAuth__dependencies() == "string", "custom deps")

    let a = AuthService("pg", "redis")
    assert(a.db == "pg", "struct works")

    print("SERVICE ANNOTATION TEST PASS")
