// D11 extended-math builtins: isnan/isinf/clamp/copysign/fma/nextafter/lgamma/erf.
fn ok_t(name: string, cond: bool)
    if not cond
        print("FAIL " + name)
        exit(1)
    print("ok " + name)

fn approx(name: string, a: float, b: float)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d >= 0.0001
        print("FAIL " + name + ": got " + str(a) + " want " + str(b))
        exit(1)
    print("ok " + name)

fn main()
    let inf = exp(710.0)
    let nan = sqrt(0.0 - 1.0)
    ok_t("isnan(nan)", isnan(nan))
    ok_t("isnan(1.0) false", not isnan(1.0))
    ok_t("isinf(inf)", isinf(inf))
    ok_t("isinf(1.0) false", not isinf(1.0))
    approx("clamp mid", clamp(5.0, 1.0, 10.0), 5.0)
    approx("clamp lo", clamp(0.0, 1.0, 10.0), 1.0)
    approx("clamp hi", clamp(20.0, 1.0, 10.0), 10.0)
    approx("copysign", copysign(3.0, 0.0 - 2.0), 0.0 - 3.0)
    approx("fma", fma(2.0, 3.0, 4.0), 10.0)
    approx("lgamma(5)=ln24", lgamma(5.0), 3.17805383)
    approx("erf(0)", erf(0.0), 0.0)
    approx("erf(3)~1", erf(3.0), 0.99997791)
    ok_t("nextafter up", nextafter(1.0, 2.0) > 1.0)
    ok_t("nextafter down", nextafter(1.0, 0.0) < 1.0)
    print("_d11_math_test passed")
