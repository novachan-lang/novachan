// Native helper for _prism_canvas_gate.ps1's stage 3 (Node harness check). Builds the EXACT same
// small tree the KAT (_kat_prism_render_canvas.nova) hand-verifies and prints one word per line.
// This is how the Node-side draw-call test gets a real, renderer-produced word array without
// hand-retyping 61 numbers into JavaScript (which would test nothing but a human's transcription).
// The words themselves are already proven correct by the KAT's exact-dump assertion; this program
// exists only to hand them to a different process (Node) in a trivially parseable form.
import prism_node
import prism_arrange
import prism_content
import prism_interact
import prism_render_canvas as pc

fn main()
    let tree = unwrap(prism_arrange.prism_stack([
        unwrap(prism_content.prism_label("Hi")),
        unwrap(prism_interact.prism_press("Go", []))
    ]))
    let words = unwrap(pc.prism_canvas_render(tree, 200, 100))
    for w in words
        print(str(w))
