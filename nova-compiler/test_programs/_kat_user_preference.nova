import forge_user_preference

fn main()
    let u = up_new()
    u = up_set(u, "alice", "theme", "dark")
    u = up_set(u, "alice", "lang", "en")
    u = up_set(u, "bob", "theme", "light")
    assert(up_user_count(u) == 2, "2 users")

    let r1 = up_get(u, "alice", "theme")
    assert(is_ok(r1), "get ok")
    assert(unwrap(r1) == "dark", "dark theme")

    assert(up_has(u, "alice", "lang") == 1, "has lang")
    assert(up_has(u, "alice", "nope") == 0, "no nope")

    let def = up_get_or_default(u, "alice", "font_size", "14")
    assert(def == "14", "default 14")

    let def2 = up_get_or_default(u, "alice", "theme", "light")
    assert(def2 == "dark", "existing pref")

    let bad = up_get(u, "charlie", "theme")
    assert(is_err(bad), "no charlie")

    assert(up_total_writes(u) == 3, "3 writes")
    assert(up_total_reads(u) == 4, "4 reads")

    print("USER-PREFERENCE KAT PASS")
