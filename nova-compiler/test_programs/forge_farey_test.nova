import forge_farey

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn renderf(xs: list) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + " "
        out = out + str(xs[i][0]) + "/" + str(xs[i][1])
        i = i + 1
    out

fn main()
    let fails = 0

    // mediant
    let m = mediant(1, 3, 1, 2)
    fails = fails + expect("mediant", str(m[0]) + "/" + str(m[1]), "2/5")
    let m2 = mediant(0, 1, 1, 1)
    fails = fails + expect("mediant2", str(m2[0]) + "/" + str(m2[1]), "1/2")

    // Farey sequences
    fails = fails + expect("F1", renderf(farey(1)), "0/1 1/1")
    fails = fails + expect("F2", renderf(farey(2)), "0/1 1/2 1/1")
    fails = fails + expect("F3", renderf(farey(3)), "0/1 1/3 1/2 2/3 1/1")
    fails = fails + expect("F4", renderf(farey(4)), "0/1 1/4 1/3 1/2 2/3 3/4 1/1")
    fails = fails + expect("F5", renderf(farey(5)), "0/1 1/5 1/4 1/3 2/5 1/2 3/5 2/3 3/4 4/5 1/1")

    // lengths
    fails = fails + expect("len1", str(farey_count(1)), "2")
    fails = fails + expect("len2", str(farey_count(2)), "3")
    fails = fails + expect("len3", str(farey_count(3)), "5")
    fails = fails + expect("len4", str(farey_count(4)), "7")
    fails = fails + expect("len5", str(farey_count(5)), "11")
    fails = fails + expect("len8", str(farey_count(8)), "23")
    // count matches actual generation
    fails = fails + expect("len_matches_6", str(len(farey(6))), str(farey_count(6)))
    fails = fails + expect("len_matches_10", str(len(farey(10))), str(farey_count(10)))

    // neighbor property: consecutive terms a/b,c/d satisfy bc - ad = 1
    let f = farey(7)
    let prop_ok = 1
    let i = 1
    while i < len(f)
        let a = f[i - 1][0]
        let b = f[i - 1][1]
        let c = f[i][0]
        let d = f[i][1]
        if b * c - a * d != 1
            prop_ok = 0
        i = i + 1
    fails = fails + expect("neighbor_prop", str(prop_ok), "1")

    if fails == 0
        print("forge_farey: all passed")
    else
        print("forge_farey: " + str(fails) + " FAILED")
