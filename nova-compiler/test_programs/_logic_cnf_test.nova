import std/logic/logic_cnf

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn ckl(label, got, want)
    if len(got) != len(want)
        print("FAIL " + label + ": len=" + str(len(got)) + " want len=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // =========================================================================
    // KAT: lcnf_eval_clause
    // clause [1,-2] on [0,0]: var1=0 (lit +1 false), var2=0 (lit -2 true) -> 1
    // =========================================================================
    let cl12n2 = [1, -2]
    let a00 = [0, 0]
    let a10 = [1, 0]
    let a01 = [0, 1]
    let a11 = [1, 1]
    cki("eval_clause_1n2_00", lcnf_eval_clause(cl12n2, a00), 1)
    cki("eval_clause_1n2_10", lcnf_eval_clause(cl12n2, a10), 1)
    cki("eval_clause_1n2_01", lcnf_eval_clause(cl12n2, a01), 0)
    cki("eval_clause_1n2_11", lcnf_eval_clause(cl12n2, a11), 1)

    // empty clause -> 0
    cki("eval_clause_empty", lcnf_eval_clause([], [0, 0]), 0)

    // =========================================================================
    // KAT: lcnf_eval_cnf
    // cnf = [[1,2],[-1,-2]]
    // [1,0]: clause1=[1,2] true (var1=1); clause2=[-1,-2] true (var2=0,-2=true) -> 1
    // [1,1]: clause1 true; clause2=[-1,-2]: -1 needs var1=0 (false), -2 needs var2=0 (false) -> 0
    // =========================================================================
    let cnf_xor_clauses = [[1, 2], [-1, -2]]
    cki("eval_cnf_10", lcnf_eval_cnf(cnf_xor_clauses, a10), 1)
    cki("eval_cnf_11", lcnf_eval_cnf(cnf_xor_clauses, a11), 0)
    cki("eval_cnf_00", lcnf_eval_cnf(cnf_xor_clauses, a00), 0)
    cki("eval_cnf_01", lcnf_eval_cnf(cnf_xor_clauses, a01), 1)

    // empty cnf -> 1
    cki("eval_cnf_empty", lcnf_eval_cnf([], a00), 1)

    // =========================================================================
    // KAT: lcnf_eval_dnf
    // dnf = [[1,-2],[-1,2]] — this is XOR
    // [1,0]: term [1,-2]: var1=1 (+1 ok), var2=0 (-2 ok) -> 1 -> dnf=1
    // [1,1]: term [1,-2]: var2=1 (-2 fails); term [-1,2]: var1=1 (-1 fails) -> 0
    // =========================================================================
    let dnf_xor = [[1, -2], [-1, 2]]
    cki("eval_dnf_10", lcnf_eval_dnf(dnf_xor, a10), 1)
    cki("eval_dnf_01", lcnf_eval_dnf(dnf_xor, a01), 1)
    cki("eval_dnf_00", lcnf_eval_dnf(dnf_xor, a00), 0)
    cki("eval_dnf_11", lcnf_eval_dnf(dnf_xor, a11), 0)

    // empty dnf -> 0
    cki("eval_dnf_empty", lcnf_eval_dnf([], a00), 0)

    // =========================================================================
    // KAT: lcnf_tt_to_dnf(6, 2)
    // T=6=0b0110: bit0=0(asgn 00), bit1=1(asgn 01 i.e.var1=1,var2=0), bit2=1(asgn 10 i.e.var1=0,var2=1), bit3=0
    // So minterms at i=1 and i=2:
    //   i=1 (binary 01): bit0=1 (var1=1 -> lit +1), bit1=0 (var2=0 -> lit -2) => term [1,-2]
    //   i=2 (binary 10): bit0=0 (var1=0 -> lit -1), bit1=1 (var2=1 -> lit +2) => term [-1,2]
    // =========================================================================
    let dnf6 = lcnf_tt_to_dnf(6, 2)
    cki("tt_to_dnf_6_2_len", len(dnf6), 2)
    ckl("tt_to_dnf_term0", dnf6[0], [1, -2])
    ckl("tt_to_dnf_term1", dnf6[1], [-1, 2])

    // =========================================================================
    // Enumeration cross-check: lcnf_tt_to_dnf(6,2) matches truth table on all 4 assignments
    // =========================================================================
    let T = 6
    let n = 2
    let dnf_check = lcnf_tt_to_dnf(T, n)
    let total = 1 << n
    let enum_i = 0
    while enum_i < total
        let expect = (T >> enum_i) & 1
        // Build assignment from enum_i
        let asgn_e = [0, 0]
        asgn_e[0] = (enum_i >> 0) & 1
        asgn_e[1] = (enum_i >> 1) & 1
        let got = lcnf_eval_dnf(dnf_check, asgn_e)
        if got != expect
            print("FAIL tt_to_dnf enum i=" + str(enum_i) + " got=" + str(got) + " want=" + str(expect))
            exit(1)
        enum_i = enum_i + 1

    // =========================================================================
    // Enumeration cross-check: lcnf_tt_to_cnf(6,2) matches truth table on all 4 assignments
    // =========================================================================
    let cnf_check = lcnf_tt_to_cnf(T, n)
    let enum2 = 0
    while enum2 < total
        let expect2 = (T >> enum2) & 1
        let asgn_e2 = [0, 0]
        asgn_e2[0] = (enum2 >> 0) & 1
        asgn_e2[1] = (enum2 >> 1) & 1
        let got2 = lcnf_eval_cnf(cnf_check, asgn_e2)
        if got2 != expect2
            print("FAIL tt_to_cnf enum i=" + str(enum2) + " got=" + str(got2) + " want=" + str(expect2))
            exit(1)
        enum2 = enum2 + 1

    // =========================================================================
    // Enumeration cross-check: all-false function T=0 and all-true T=15 (n=2)
    // =========================================================================
    let dnf0 = lcnf_tt_to_dnf(0, 2)
    cki("tt_to_dnf_0_len", len(dnf0), 0)
    let cnf0 = lcnf_tt_to_cnf(0, 2)
    cki("tt_to_cnf_0_len", len(cnf0), 4)

    let dnf15 = lcnf_tt_to_dnf(15, 2)
    cki("tt_to_dnf_15_len", len(dnf15), 4)
    let cnf15 = lcnf_tt_to_cnf(15, 2)
    cki("tt_to_cnf_15_len", len(cnf15), 0)

    // enumerate and verify T=0 (const-false): dnf should always give 0, cnf always 0
    let ei3 = 0
    while ei3 < 4
        let ae3 = [0, 0]
        ae3[0] = (ei3 >> 0) & 1
        ae3[1] = (ei3 >> 1) & 1
        if lcnf_eval_dnf(dnf0, ae3) != 0
            print("FAIL dnf0 enum i=" + str(ei3))
            exit(1)
        if lcnf_eval_cnf(cnf0, ae3) != 0
            print("FAIL cnf0 enum i=" + str(ei3))
            exit(1)
        ei3 = ei3 + 1

    // enumerate and verify T=15 (const-true): cnf should always give 1, dnf always 1
    let ei4 = 0
    while ei4 < 4
        let ae4 = [0, 0]
        ae4[0] = (ei4 >> 0) & 1
        ae4[1] = (ei4 >> 1) & 1
        if lcnf_eval_dnf(dnf15, ae4) != 1
            print("FAIL dnf15 enum i=" + str(ei4))
            exit(1)
        if lcnf_eval_cnf(cnf15, ae4) != 1
            print("FAIL cnf15 enum i=" + str(ei4))
            exit(1)
        ei4 = ei4 + 1

    // =========================================================================
    // KAT: lcnf_is_horn
    // [[1,-2],[-1,-3]]: clause [1,-2] has 1 positive (+1), clause [-1,-3] has 0 positives -> horn
    // [[1,2]]: has 2 positives -> not horn
    // =========================================================================
    let horn1 = [[1, -2], [-1, -3]]
    let horn2 = [[1, 2]]
    ckb("is_horn_true", lcnf_is_horn(horn1), true)
    ckb("is_horn_false", lcnf_is_horn(horn2), false)

    // empty cnf is horn (vacuously)
    ckb("is_horn_empty", lcnf_is_horn([]), true)

    // =========================================================================
    // Additional n=3 enumeration check (T=0b10010110 = 150, AND+OR combos)
    // T3=150 = 0b10010110: bits 1,2,4,7 set (assignments 1,2,4,7)
    // =========================================================================
    let T3 = 150
    let n3 = 3
    let dnf3 = lcnf_tt_to_dnf(T3, n3)
    let cnf3 = lcnf_tt_to_cnf(T3, n3)
    let ei5 = 0
    let total3 = 1 << n3
    while ei5 < total3
        let ae5 = [0, 0, 0]
        ae5[0] = (ei5 >> 0) & 1
        ae5[1] = (ei5 >> 1) & 1
        ae5[2] = (ei5 >> 2) & 1
        let exp5 = (T3 >> ei5) & 1
        let gd5 = lcnf_eval_dnf(dnf3, ae5)
        let gc5 = lcnf_eval_cnf(cnf3, ae5)
        if gd5 != exp5
            print("FAIL dnf3 T=150 i=" + str(ei5) + " got=" + str(gd5) + " want=" + str(exp5))
            exit(1)
        if gc5 != exp5
            print("FAIL cnf3 T=150 i=" + str(ei5) + " got=" + str(gc5) + " want=" + str(exp5))
            exit(1)
        ei5 = ei5 + 1

    print("PASS _logic_cnf_test")
