import forge_graph_builder

fn main()
    let g = gb_new()
    g = gb_add_node(g, "A")
    g = gb_add_node(g, "B")
    g = gb_add_node(g, "C")
    assert(gb_node_count(g) == 3, "3 nodes")
    assert(gb_has_node(g, "A") == 1, "has A")
    assert(gb_has_node(g, "X") == 0, "no X")

    g = gb_add_node(g, "A")
    assert(gb_node_count(g) == 3, "no dup A")

    g = gb_add_edge(g, "A", "B")
    g = gb_add_edge(g, "A", "C")
    g = gb_add_edge(g, "B", "C")
    assert(gb_edge_count(g) == 3, "3 edges")

    assert(gb_out_degree(g, "A") == 2, "A out 2")
    assert(gb_out_degree(g, "B") == 1, "B out 1")
    assert(gb_out_degree(g, "C") == 0, "C out 0")

    assert(gb_in_degree(g, "C") == 2, "C in 2")
    assert(gb_in_degree(g, "A") == 0, "A in 0")

    assert(gb_has_edge(g, "A", "B") == 1, "A->B exists")
    assert(gb_has_edge(g, "C", "A") == 0, "C->A not exists")

    print("GRAPH-BUILDER KAT PASS")
