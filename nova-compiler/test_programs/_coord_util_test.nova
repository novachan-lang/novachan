// KAT test for std/data/coord_util
import std/data/coord_util

// ── Helper: approximate float equality ───────────────────────────────────────
fn approx(a, b, tol)
    let diff = a - b
    let adiff = diff
    if diff < 0.0
        adiff = 0.0 - diff
    let result = 0
    if adiff <= tol
        result = 1
    return result

// ── Test 1: dms_to_dd — spec vector ──────────────────────────────────────────
// 40 deg 26 min 46 sec -> 40 + 26/60 + 46/3600 = 40.44611...
let dd1 = dms_to_dd(40.0, 26.0, 46.0)
if approx(dd1, 40.4461, 0.001) != 1
    print("FAIL dms_to_dd(40,26,46): got " + str(dd1) + " expected ~40.4461")
    exit(1)

// ── Test 2: dms_to_dd — equator ──────────────────────────────────────────────
let dd2 = dms_to_dd(0.0, 0.0, 0.0)
if approx(dd2, 0.0, 0.000001) != 1
    print("FAIL dms_to_dd(0,0,0): got " + str(dd2))
    exit(1)

// ── Test 3: dms_to_dd — 90 degrees ───────────────────────────────────────────
let dd3 = dms_to_dd(90.0, 0.0, 0.0)
if approx(dd3, 90.0, 0.000001) != 1
    print("FAIL dms_to_dd(90,0,0): got " + str(dd3))
    exit(1)

// ── Test 4: dms_to_dd — negative (southern hemisphere) ───────────────────────
// -33 deg 51 min 35.9 sec -> -33 - 51/60 - 35.9/3600 ~ -33.8600
let dd4 = dms_to_dd(0.0 - 33.0, 51.0, 35.9)
if approx(dd4, 0.0 - 33.8600, 0.001) != 1
    print("FAIL dms_to_dd negative: got " + str(dd4))
    exit(1)

// ── Test 5: dms_to_dd — minutes only ─────────────────────────────────────────
// 1 deg 30 min 0 sec = 1.5 deg
let dd5 = dms_to_dd(1.0, 30.0, 0.0)
if approx(dd5, 1.5, 0.000001) != 1
    print("FAIL dms_to_dd(1,30,0): got " + str(dd5))
    exit(1)

// ── Test 6: dd_to_dms — round-trip 40.4461 ───────────────────────────────────
let dms6 = dd_to_dms(40.4461)
let back6 = dms_to_dd(dms6[0], dms6[1], dms6[2])
if approx(back6, 40.4461, 0.001) != 1
    print("FAIL dd_to_dms rt 40.4461: got " + str(back6))
    exit(1)

// ── Test 7: dd_to_dms — check degrees component ──────────────────────────────
let dms7 = dd_to_dms(40.4461)
if approx(dms7[0], 40.0, 0.0001) != 1
    print("FAIL dd_to_dms[0] degrees: got " + str(dms7[0]))
    exit(1)

// ── Test 8: dd_to_dms — zero ─────────────────────────────────────────────────
let dms8 = dd_to_dms(0.0)
if approx(dms8[0], 0.0, 0.000001) != 1
    print("FAIL dd_to_dms(0) deg: got " + str(dms8[0]))
    exit(1)
if approx(dms8[1], 0.0, 0.000001) != 1
    print("FAIL dd_to_dms(0) min: got " + str(dms8[1]))
    exit(1)
if approx(dms8[2], 0.0, 0.000001) != 1
    print("FAIL dd_to_dms(0) sec: got " + str(dms8[2]))
    exit(1)

// ── Test 9: normalize_lon — 190 -> -170 ──────────────────────────────────────
let nl1 = normalize_lon(190.0)
if approx(nl1, 0.0 - 170.0, 0.000001) != 1
    print("FAIL normalize_lon(190): got " + str(nl1) + " expected -170")
    exit(1)

// ── Test 10: normalize_lon — -190 -> 170 ─────────────────────────────────────
let nl2 = normalize_lon(0.0 - 190.0)
if approx(nl2, 170.0, 0.000001) != 1
    print("FAIL normalize_lon(-190): got " + str(nl2) + " expected 170")
    exit(1)

// ── Test 11: normalize_lon — already in range ────────────────────────────────
let nl3 = normalize_lon(0.0)
if approx(nl3, 0.0, 0.000001) != 1
    print("FAIL normalize_lon(0): got " + str(nl3))
    exit(1)
let nl4 = normalize_lon(90.0)
if approx(nl4, 90.0, 0.000001) != 1
    print("FAIL normalize_lon(90): got " + str(nl4))
    exit(1)
let nl5 = normalize_lon(0.0 - 90.0)
if approx(nl5, 0.0 - 90.0, 0.000001) != 1
    print("FAIL normalize_lon(-90): got " + str(nl5))
    exit(1)

// ── Test 12: normalize_lon — 360 -> 0 (or -180 edge) ────────────────────────
let nl6 = normalize_lon(360.0)
// 360+180=540, 540 mod 360=180, 180-180=0
if approx(nl6, 0.0, 0.000001) != 1
    print("FAIL normalize_lon(360): got " + str(nl6) + " expected 0")
    exit(1)

// ── Test 13: normalize_lon — 540 -> 180 edge ─────────────────────────────────
let nl7 = normalize_lon(540.0)
// 540+180=720, 720 mod 360=0, 0-180=-180
if approx(nl7, 0.0 - 180.0, 0.001) != 1
    print("FAIL normalize_lon(540): got " + str(nl7))
    exit(1)

// ── Test 14: valid_coord — true cases ────────────────────────────────────────
let vc1 = valid_coord(45.0, 90.0)
if vc1 != 1
    print("FAIL valid_coord(45,90): expected true got " + str(vc1))
    exit(1)
let vc2 = valid_coord(0.0, 0.0)
if vc2 != 1
    print("FAIL valid_coord(0,0): expected true")
    exit(1)
let vc3 = valid_coord(0.0 - 90.0, 0.0 - 180.0)
if vc3 != 1
    print("FAIL valid_coord(-90,-180): expected true")
    exit(1)
let vc4 = valid_coord(90.0, 180.0)
if vc4 != 1
    print("FAIL valid_coord(90,180): expected true")
    exit(1)

// ── Test 15: valid_coord — false cases ───────────────────────────────────────
let vc5 = valid_coord(91.0, 0.0)
if vc5 != 0
    print("FAIL valid_coord(91,0): expected false got " + str(vc5))
    exit(1)
let vc6 = valid_coord(0.0, 181.0)
if vc6 != 0
    print("FAIL valid_coord(0,181): expected false")
    exit(1)
let vc7 = valid_coord(0.0 - 91.0, 0.0)
if vc7 != 0
    print("FAIL valid_coord(-91,0): expected false")
    exit(1)

print("PASS _coord_util_test")
