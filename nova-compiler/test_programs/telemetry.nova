// ══════════════════════════════════════════════════════════════════════════════
// telemetry — observability metrics for NOVA services (#18: OTP telemetry)
//
// In-process metrics registry: counters (monotonic), gauges (set), and histograms
// (observations -> count/min/max/mean/sum). A metrics value is a dict held in the
// registry; snapshot/report read it out. Pair with a GenServer (otp) for a shared
// cross-process collector, or use directly within one process.
//
//   m = telem_new()
//   telem_counter(m, "requests", 1)
//   telem_gauge(m, "queue_depth", 7.0)
//   telem_observe(m, "latency_ms", 12.0)
//   telem_get(m, "requests")          // 1
//   telem_hist(m, "latency_ms")       // {"count","min","max","mean","sum"}
// ══════════════════════════════════════════════════════════════════════════════

fn telem_new() -> dict
    {"counters": {}, "gauges": {}, "hists": {}}

// monotonic counter: add `delta` to `name` (created at 0).
fn telem_counter(m: dict, name: string, delta) -> dict
    let c = m["counters"]
    let cur = 0
    if contains(c, name)
        cur = c[name]
    c[name] = cur + delta
    m["counters"] = c
    m

fn telem_get(m: dict, name: string)
    let c = m["counters"]
    if contains(c, name)
        return c[name]
    0

// gauge: set `name` to `val` (last-write-wins).
fn telem_gauge(m: dict, name: string, val) -> dict
    let g = m["gauges"]
    g[name] = val
    m["gauges"] = g
    m

fn telem_gauge_get(m: dict, name: string)
    let g = m["gauges"]
    if contains(g, name)
        return g[name]
    0

// histogram: record an observation; running count/min/max/sum (mean derived).
fn telem_observe(m: dict, name: string, val: float) -> dict
    let h = m["hists"]
    if not contains(h, name)
        h[name] = {"count": 0, "min": val, "max": val, "sum": 0.0}
    let e = h[name]
    e["count"] = e["count"] + 1
    if val < e["min"]
        e["min"] = val
    if val > e["max"]
        e["max"] = val
    e["sum"] = e["sum"] + val
    h[name] = e
    m["hists"] = h
    m

// histogram snapshot: {count, min, max, sum, mean}.
fn telem_hist(m: dict, name: string) -> dict
    let h = m["hists"]
    if not contains(h, name)
        return {"count": 0, "min": 0.0, "max": 0.0, "sum": 0.0, "mean": 0.0}
    let e = h[name]
    let mean = 0.0
    if e["count"] > 0
        mean = e["sum"] / (e["count"] + 0.0)
    {"count": e["count"], "min": e["min"], "max": e["max"], "sum": e["sum"], "mean": mean}
