import std/text/anagram

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // ── an_sort_key KAT ───────────────────────────────────────────────────────
    cks("sort_key_cba",   an_sort_key("cba"),   "abc")
    cks("sort_key_Hello", an_sort_key("Hello"), "ehllo")
    cks("sort_key_listen", an_sort_key("listen"), "eilnst")
    cks("sort_key_spaces", an_sort_key("Dirty Room"), "dimoorrty")
    cks("sort_key_empty",  an_sort_key(""), "")

    // ── an_is_anagram KAT ─────────────────────────────────────────────────────
    cki("anagram_listen_silent",   an_is_anagram("listen",    "silent"),    1)
    cki("anagram_hello_world",     an_is_anagram("hello",     "world"),     0)
    cki("anagram_dormitory",       an_is_anagram("Dormitory", "Dirty Room"), 1)
    cki("anagram_abc_bca",         an_is_anagram("abc",       "bca"),       1)
    cki("anagram_same_word",       an_is_anagram("test",      "test"),      1)
    cki("anagram_diff_len",        an_is_anagram("ab",        "abc"),       0)

    // ── an_group KAT ─────────────────────────────────────────────────────────
    let words = ["eat", "tea", "tan", "ate", "nat", "bat"]
    let g = an_group(words)

    // There should be 3 groups total (aet->3 words, ant->2 words, abt->1 word).
    cki("group_count", len(g), 3)

    // Find the group containing "eat" (signature "aet") and verify it has 3 members.
    let eat_group_len = 0
    let gi = 0
    while gi < len(g)
        let grp = g[gi]
        let gj = 0
        while gj < len(grp)
            if grp[gj] == "eat"
                eat_group_len = len(grp)
            gj = gj + 1
        gi = gi + 1
    cki("eat_group_len", eat_group_len, 3)

    // Find the group containing "bat" and verify it has 1 member.
    let bat_group_len = 0
    let bi = 0
    while bi < len(g)
        let bgrp = g[bi]
        let bj = 0
        while bj < len(bgrp)
            if bgrp[bj] == "bat"
                bat_group_len = len(bgrp)
            bj = bj + 1
        bi = bi + 1
    cki("bat_group_len", bat_group_len, 1)

    // an_group(["a","b","c"]) -> 3 singleton groups (all different signatures).
    let singles = an_group(["a", "b", "c"])
    cki("singles_group_count", len(singles), 3)

    print("_anagram_test passed")
