fn set_from(items)
  let s = {}
  for item in items
    s[str(item)] = item
  s

fn set_add(s, item)
  s[str(item)] = item

fn set_has(s, item)
  contains(s, str(item))

fn set_items(s)
  let result = []
  let ks = keys(s)
  for k in ks
    push(result, s[k])
  result

fn set_size(s)
  len(keys(s))

fn set_union(a, b)
  let result = {}
  let ka = keys(a)
  for k in ka
    result[k] = a[k]
  let kb = keys(b)
  for k in kb
    result[k] = b[k]
  result

fn set_intersect(a, b)
  let result = {}
  let ka = keys(a)
  for k in ka
    if contains(b, k)
      result[k] = a[k]
  result

fn set_difference(a, b)
  let result = {}
  let ka = keys(a)
  for k in ka
    if not contains(b, k)
      result[k] = a[k]
  result

fn set_symmetric_diff(a, b)
  set_union(set_difference(a, b), set_difference(b, a))

fn set_is_subset(a, b)
  let ka = keys(a)
  for k in ka
    if not contains(b, k)
      return 0
  1

fn main()
  let a = set_from([1, 2, 3, 4])
  let b = set_from([3, 4, 5, 6])

  assert(set_has(a, 1) == 1, "has 1")
  assert(set_has(a, 5) == 0, "not has 5")
  assert(set_size(a) == 4, "size 4")

  let u = set_union(a, b)
  assert(set_size(u) == 6, "union size 6")

  let inter = set_intersect(a, b)
  assert(set_size(inter) == 2, "intersect 2")
  assert(set_has(inter, 3) == 1, "intersect has 3")
  assert(set_has(inter, 4) == 1, "intersect has 4")

  let diff = set_difference(a, b)
  assert(set_size(diff) == 2, "diff 2")
  assert(set_has(diff, 1) == 1, "diff has 1")
  assert(set_has(diff, 2) == 1, "diff has 2")

  let sym = set_symmetric_diff(a, b)
  assert(set_size(sym) == 4, "sym diff 4")

  let sub = set_from([3, 4])
  assert(set_is_subset(sub, a) == 1, "subset")
  assert(set_is_subset(a, sub) == 0, "not subset")

  print("setx: all passed")
