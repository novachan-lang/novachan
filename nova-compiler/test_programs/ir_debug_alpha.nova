fn test_alpha()
    let c = ord("l")
    print("ord(l) = " + str(c))
    print("c >= 65: " + str(c >= 65))
    print("c <= 90: " + str(c <= 90))
    print("c >= 97: " + str(c >= 97))
    print("c <= 122: " + str(c <= 122))
    print("(c >= 65 and c <= 90): " + str(c >= 65 and c <= 90))
    print("(c >= 97 and c <= 122): " + str(c >= 97 and c <= 122))
    let r1 = c >= 65 and c <= 90
    let r2 = c >= 97 and c <= 122
    print("r1: " + str(r1))
    print("r2: " + str(r2))
    print("r1 or r2: " + str(r1 or r2))

test_alpha()
