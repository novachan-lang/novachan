import std/tensor/tsr_broadcast

// cki — check two ints are equal.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// ckb — check a bool.
fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got " + gs + " want " + ws)
        exit(1)

// ckl — check a flat int list element by element.
fn ckl(label: string, got: any, want: any)
    let ng = len(got)
    let nw = len(want)
    if ng != nw
        print("FAIL " + label + ": len got " + str(ng) + " want " + str(nw))
        exit(1)
    let i = 0
    while i < ng
        if got[i] != want[i]
            print("FAIL " + label + "[" + str(i) + "]: got " + str(got[i]) + " want " + str(want[i]))
            exit(1)
        i = i + 1

// ckt — check a tensor [flat, shape] against expected flat and shape.
fn ckt(label: string, t: any, want_flat: any, want_shape: any)
    ckl(label + ".flat", t[0], want_flat)
    ckl(label + ".shape", t[1], want_shape)

fn main()
    // ── tb_broadcast_shapes ───────────────────────────────────────────────
    // [3,1] x [1,4] = [3,4]: (3 vs 1)->3, (1 vs 4)->4
    ckl("bcast_shapes_3x1_1x4", tb_broadcast_shapes([3,1], [1,4]), [3,4])

    // [2,3] x [3] = [2,3]: right-align (2 vs 1)->2, (3 vs 3)->3
    ckl("bcast_shapes_2x3_3", tb_broadcast_shapes([2,3], [3]), [2,3])

    // [5] x [5] = [5]
    ckl("bcast_shapes_5_5", tb_broadcast_shapes([5], [5]), [5])

    // [] (scalar) x [3] = [3]
    ckl("bcast_shapes_scalar_3", tb_broadcast_shapes([], [3]), [3])

    // [1,1] x [3,4] = [3,4]
    ckl("bcast_shapes_1x1_3x4", tb_broadcast_shapes([1,1], [3,4]), [3,4])

    // incompatible: [2,3] x [4] -> neither (3 vs 4) is 1 -> []
    ckl("bcast_shapes_incompat", tb_broadcast_shapes([2,3], [4]), [])

    // incompatible: [5] x [6] -> []
    ckl("bcast_shapes_5_6", tb_broadcast_shapes([5], [6]), [])

    // ── tb_broadcastable ──────────────────────────────────────────────────
    ckb("broadcastable_2x3_4", tb_broadcastable([2,3], [4]), false)
    ckb("broadcastable_3x1_1x4", tb_broadcastable([3,1], [1,4]), true)
    ckb("broadcastable_5_5", tb_broadcastable([5], [5]), true)
    ckb("broadcastable_1_n", tb_broadcastable([1], [7]), true)
    ckb("broadcastable_scalar_any", tb_broadcastable([], [3,4]), true)

    // ── tb_broadcast_to ───────────────────────────────────────────────────
    // [[10,20,30],[1,3]] broadcast to [2,3]: replicate row twice
    let bto1 = tb_broadcast_to([[10,20,30],[1,3]], [2,3])
    ckt("bcast_to_1x3_2x3", bto1, [10,20,30,10,20,30], [2,3])

    // scalar [[7],[]] broadcast to [3]: [7,7,7]
    let bto2 = tb_broadcast_to([[7],[]], [3])
    ckt("bcast_to_scalar_3", bto2, [7,7,7], [3])

    // column [[1,2],[2,1]] (shape [2,1]) broadcast to [2,4]
    // row 0 all 1s, row 1 all 2s
    let bto3 = tb_broadcast_to([[1,2],[2,1]], [2,4])
    ckt("bcast_to_2x1_2x4", bto3, [1,1,1,1,2,2,2,2], [2,4])

    // ── tb_add_bc ─────────────────────────────────────────────────────────
    // [[1,2,3,4,5,6],[2,3]] + [[10,20,30],[3]] -> broadcast [3] to [2,3]
    // row 0: 1+10=11, 2+20=22, 3+30=33
    // row 1: 4+10=14, 5+20=25, 6+30=36
    let abc1 = tb_add_bc([[1,2,3,4,5,6],[2,3]], [[10,20,30],[3]])
    ckt("add_bc_2x3_plus_3", abc1, [11,22,33,14,25,36], [2,3])

    // same shape, trivial broadcast
    let abc2 = tb_add_bc([[5,10,15],[3]], [[1,2,3],[3]])
    ckt("add_bc_same_shape", abc2, [6,12,18], [3])

    // scalar + vector: [[3],[]] + [[1,2,3],[3]] = [[4,5,6],[3]]
    let abc3 = tb_add_bc([[3],[]], [[1,2,3],[3]])
    ckt("add_bc_scalar_vec", abc3, [4,5,6], [3])

    // column + row: [[1,2,3],[3,1]] + [[10,20],[1,2]]
    // shape [3,1] x [1,2] -> [3,2]
    // row0=[11,21] row1=[12,22] row2=[13,23]
    let abc4 = tb_add_bc([[1,2,3],[3,1]], [[10,20],[1,2]])
    ckt("add_bc_col_plus_row", abc4, [11,21,12,22,13,23], [3,2])

    // incompatible shapes: result shape is []
    let incompat = tb_add_bc([[1,2,3],[3]], [[1,2],[2]])
    ckl("add_bc_incompat_shape", incompat[1], [])

    print("PASS _tsr_broadcast_test")
