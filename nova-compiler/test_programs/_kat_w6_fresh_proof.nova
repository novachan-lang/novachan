// Wave-B #6 part 4 — the fresh-return prover MUST reject any fn that can return a BORROW.
// Dropping a borrowed pointer is CORE_GAP 0.10 (use-after-free), so these cases are the
// whole safety boundary. Every value below must still be readable after being inserted.

type Box
    b_name: string

// FRESH: every return is a string concat -> provable, safe to MOVE.
fn make_fresh(i: int) -> string
    return "fresh-" + str(i)

// BORROW: returns an ELEMENT of a container the caller still owns. Must NOT be proven.
fn borrow_elem(xs: list) -> string
    return xs[0]

// BORROW: returns a FIELD of a struct the caller still owns. Must NOT be proven.
fn borrow_field(bx: Box) -> string
    return bx.b_name

// BORROW: returns its own PARAMETER. Must NOT be proven.
fn borrow_param(s: string) -> string
    return s

// MIXED: one path fresh, one path a borrow -> must NOT be proven (fail-closed).
fn mixed(xs: list, flag: int) -> string
    if flag == 1
        return "mixed-" + str(flag)
    return xs[0]

fn main()
    let src = ["ORIGINAL", "second"]
    let bx = Box("FIELDVAL")

    // fresh insert -> MOVE is safe
    let a = []
    a.push(make_fresh(1))
    print("fresh:  " + str(a))

    // borrow inserts -> must NOT be dropped; the SOURCE must stay intact
    let b = []
    b.push(borrow_elem(src))
    b.push(borrow_field(bx))
    b.push(borrow_param("PARAMVAL"))
    b.push(mixed(src, 0))
    print("borrow: " + str(b))

    // the originals must be unharmed
    print("src[0] still: " + src[0])
    print("bx field still: " + bx.b_name)
    print("src still: " + str(src))
