import forge_cloudevents

fn tf(b: bool) -> string
    if b
        return "T"
    "F"

fn has(s: string, sub: string) -> string
    if find(s, sub) >= 0
        return "T"
    "F"

fn main()
    let ce = cloudevent("A234-1234-1234", "/mycontext", "com.example.someevent", "hello")
    let j = cloudevent_to_json(ce)
    // structured JSON must carry all four required attrs
    print("hasspec=" + has(j, chr(34) + "specversion" + chr(34) + ":" + chr(34) + "1.0" + chr(34)))
    print("hasid=" + has(j, "A234-1234-1234"))
    print("hassrc=" + has(j, "/mycontext"))
    print("hastype=" + has(j, "com.example.someevent"))
    print("valid=" + tf(cloudevent_valid(ce)))
    print("is_match=" + tf(cloudevent_is(ce, "com.example.someevent")))
    print("is_nomatch=" + tf(cloudevent_is(ce, "other.type")))
    // full event carries optional subject + time
    let cf = cloudevent_full("id2", "/svc", "t.x", "orders/42", "2026-07-03T10:00:00Z", "application/json", "payload")
    let jf = cloudevent_to_json(cf)
    print("hassubj=" + has(jf, "orders/42"))
    print("hastime=" + has(jf, "2026-07-03T10:00:00Z"))
    // invalid: missing type
    let bad = {}
    bad["specversion"] = "1.0"
    bad["id"] = "x"
    bad["source"] = "/s"
    print("badvalid=" + tf(cloudevent_valid(bad)))
    // invalid: wrong specversion
    let bad2 = cloudevent("i", "/s", "t", "d")
    bad2["specversion"] = "0.3"
    print("bad2valid=" + tf(cloudevent_valid(bad2)))
    // round-trip
    let rt = cloudevent_from_json(j)
    print("rt_id=" + tf(rt["id"] == "A234-1234-1234"))
