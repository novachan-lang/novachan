// showcase_codec_roundtrip_test.nova
// Binary codec round-trip harness.
// BUG-HUNT TARGET: NUL-truncation / binary-safety.
//
// Payload (8 bytes, multiple-of-4 for z85, two 0x00 bytes, one 0xFF):
//   [72, 0, 255, 105, 65, 0, 200, 48]
//    H  NUL  xFF  i    A  NUL  C8  0
//
// Each codec:  enc = encode(b);  dec = decode(enc)
//   - Assert bytes_len(dec) == 8
//   - Assert each byte matches the original
//
// If any codec loses the 0x00 byte (NUL-truncation) the assert fires.

import std/encoding/hex
import std/encoding/base32
import std/encoding/base45
import std/encoding/base58
import std/encoding/z85
import std/encoding/percent

// Build the 8-byte test payload containing 0x00 and 0xFF bytes.
fn _make_payload() -> any
    let b = bytes(8)
    b[0] = 72
    b[1] = 0
    b[2] = 255
    b[3] = 105
    b[4] = 65
    b[5] = 0
    b[6] = 200
    b[7] = 48
    b

// Compare two bytes values; return 1 if equal, 0 otherwise.
fn _bytes_eq(a, b) -> int
    if bytes_len(a) != bytes_len(b)
        return 0
    let i = 0
    while i < bytes_len(a)
        if bytes_get(a, i) != bytes_get(b, i)
            return 0
        i = i + 1
    return 1

// Assert that decoded bytes exactly match the original payload.
// Reports the codec name and which byte failed if there is a mismatch.
fn _check_roundtrip(codec_name, original, decoded) -> int
    let orig_len = bytes_len(original)
    let dec_len  = bytes_len(decoded)
    if dec_len != orig_len
        print("FAIL " + codec_name + ": length mismatch: got " + str(dec_len) + " want " + str(orig_len))
        exit(1)
    let i = 0
    while i < orig_len
        let ob = bytes_get(original, i)
        let db = bytes_get(decoded, i)
        if ob != db
            print("FAIL " + codec_name + ": byte[" + str(i) + "] got " + str(db) + " want " + str(ob))
            exit(1)
        i = i + 1
    1

fn main()
    let payload = _make_payload()
    let n = bytes_len(payload)
    print("Payload length: " + str(n))
    print("Byte[0]=72 (H)  Byte[1]=0 (NUL)  Byte[2]=255 (0xFF)  Byte[3]=105 (i)")
    print("Byte[4]=65 (A)  Byte[5]=0 (NUL)  Byte[6]=200 (0xC8)  Byte[7]=48 (0)")

    // ── hex ──────────────────────────────────────────────────────────────────
    let hex_enc = hex_encode(payload)
    print("hex encoded: " + hex_enc)
    // Hand-computed: 48 00 ff 69 41 00 c8 30 -> "4800ff6941" + "00c830"
    // Actually: 72=0x48, 0=0x00, 255=0xff, 105=0x69, 65=0x41, 0=0x00, 200=0xc8, 48=0x30
    // Expected hex string: "4800ff694100c830"
    if hex_enc != "4800ff694100c830"
        print("FAIL hex_encode: got " + hex_enc + " want 4800ff694100c830")
        exit(1)
    let hex_dec = hex_decode(hex_enc)
    _check_roundtrip("hex", payload, hex_dec)
    print("hex: PASS (round-trip verified including 0x00 at indices 1,5 and 0xFF at index 2)")

    // ── base32 ───────────────────────────────────────────────────────────────
    let b32_enc = base32_encode(payload)
    print("base32 encoded: " + b32_enc)
    let b32_dec = base32_decode(b32_enc)
    _check_roundtrip("base32", payload, b32_dec)
    print("base32: PASS (round-trip verified including 0x00 and 0xFF bytes)")

    // ── base45 ───────────────────────────────────────────────────────────────
    let b45_enc = base45_encode(payload)
    print("base45 encoded: " + b45_enc)
    let b45_dec = base45_decode(b45_enc)
    _check_roundtrip("base45", payload, b45_dec)
    print("base45: PASS (round-trip verified including 0x00 and 0xFF bytes)")

    // ── base58 ───────────────────────────────────────────────────────────────
    let b58_enc = base58_encode(payload)
    print("base58 encoded: " + b58_enc)
    let b58_dec = base58_decode(b58_enc)
    _check_roundtrip("base58", payload, b58_dec)
    print("base58: PASS (round-trip verified including 0x00 and 0xFF bytes)")

    // ── z85 (payload must be multiple-of-4 bytes — our 8-byte payload qualifies)
    let z85_enc = z85_encode(payload)
    print("z85 encoded: " + z85_enc)
    // z85 returns "" on bad-length; verify we got a real encoding
    if len(z85_enc) == 0
        print("FAIL z85_encode: returned empty string (length-check rejection?)")
        exit(1)
    let z85_dec = z85_decode(z85_enc)
    _check_roundtrip("z85", payload, z85_dec)
    print("z85: PASS (round-trip verified including 0x00 and 0xFF bytes)")

    // ── percent ──────────────────────────────────────────────────────────────
    let pct_enc = percent_encode(payload)
    print("percent encoded: " + pct_enc)
    // 0x00 must appear as "%00", 0xFF as "%FF"
    // Bytes: 72='H'(unreserved), 0->%00, 255->%FF, 105='i'(unreserved),
    //        65='A'(unreserved), 0->%00, 200->%C8, 48='0'(unreserved)
    let want_pct = "H%00%FFiA%00%C80"
    if pct_enc != want_pct
        print("FAIL percent_encode: got " + pct_enc + " want " + want_pct)
        exit(1)
    let pct_dec = percent_decode(pct_enc)
    _check_roundtrip("percent", payload, pct_dec)
    print("percent: PASS (round-trip verified; 0x00 encoded as %00, 0xFF as %FF)")

    print("showcase_codec_roundtrip_test passed")
