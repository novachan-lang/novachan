fn pool_new(create_fn, max_size)
  let p = {}
  p["items"] = channel()
  p["create"] = create_fn
  p["max"] = max_size
  p["created"] = 0
  let i = 0
  while i < max_size
    let item = create_fn(i)
    send(p["items"], item)
    i = i + 1
  p["created"] = max_size
  p

fn pool_acquire(pool)
  receive(pool["items"])

fn pool_release(pool, item)
  send(pool["items"], item)

fn pool_with(pool, action)
  let item = pool_acquire(pool)
  let result = action(item)
  pool_release(pool, item)
  result

fn pool_size(pool)
  pool["created"]

fn _make_conn(id)
  let conn = {}
  conn["id"] = id
  conn["queries"] = 0
  conn

fn _run_query(conn)
  conn["queries"] = conn["queries"] + 1
  "result-" + str(conn["id"])

fn main()
  let pool = pool_new(fn(z) _make_conn(z), 3)
  assert(pool_size(pool) == 3, "pool of 3")

  let c1 = pool_acquire(pool)
  assert(c1["id"] == 0 or c1["id"] == 1 or c1["id"] == 2, "acquired valid conn")

  let c2 = pool_acquire(pool)
  let c3 = pool_acquire(pool)

  let r1 = _run_query(c1)
  assert(starts_with(r1, "result-"), "query result")

  pool_release(pool, c1)
  pool_release(pool, c2)
  pool_release(pool, c3)

  let r2 = pool_with(pool, fn(z) _run_query(z))
  assert(starts_with(r2, "result-"), "pool_with result")

  let c4 = pool_acquire(pool)
  pool_release(pool, c4)

  print("poolx: all passed")
