import forge_gossip_state

fn main()
    let g = gs_new()
    g = gs_add_node(g, "node1")
    g = gs_add_node(g, "node2")
    assert(gs_node_count(g) == 2, "2 nodes")

    assert(gs_is_alive(g, "node1") == 1, "node1 alive")
    assert(gs_is_alive(g, "nope") == 0, "unknown dead")

    let s1 = gs_set_state(g, "node1", "role", "leader")
    assert(is_ok(s1), "set state ok")
    g = unwrap(s1)

    let r1 = gs_get_state(g, "node1", "role")
    assert(is_ok(r1), "get state ok")
    assert(unwrap(r1) == "leader", "leader")

    let gen = gs_generation(g, "node1")
    assert(is_ok(gen), "gen ok")
    assert(unwrap(gen) == 1, "gen=1")

    let d = gs_mark_dead(g, "node2")
    assert(is_ok(d), "mark dead ok")
    g = unwrap(d)
    assert(gs_is_alive(g, "node2") == 0, "node2 dead")

    g = gs_gossip(g)
    g = gs_gossip(g)
    assert(gs_gossip_rounds(g) == 2, "2 rounds")

    let bad = gs_set_state(g, "nope", "x", "y")
    assert(is_err(bad), "node not found")

    print("GOSSIP-STATE KAT PASS")
