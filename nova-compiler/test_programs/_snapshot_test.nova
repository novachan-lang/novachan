// KAT for std/testing/snapshot
// Tests snap_serialize, snap_matches, snap_diff with known-answer vectors.
// NOTE: Brace chars INTERPOLATE in strings -- use chr(123)/chr(125) for { / }.
import std/testing/snapshot

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn ckb(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // KAT 1: snap_serialize(42) == "42"
    cks("serialize_int", snap_serialize(42), "42")

    // KAT 2: snap_serialize([1,2,3]) == "[1,2,3]"
    cks("serialize_list", snap_serialize([1, 2, 3]), "[1,2,3]")

    // KAT 3: snap_serialize("hi") == "hi"
    cks("serialize_string", snap_serialize("hi"), "hi")

    // KAT 4: dict with sorted keys: d["b"]=2, d["a"]=1 -> "{a:1,b:2}"
    // chr(123)='{' chr(125)='}' to avoid string interpolation hazard.
    let d = {}
    d["b"] = 2
    d["a"] = 1
    let ob = chr(123)
    let cb = chr(125)
    cks("serialize_dict_sorted", snap_serialize(d), ob + "a:1,b:2" + cb)

    // KAT 5: snap_matches([1,2,3], "[1,2,3]") == true (1)
    ckb("matches_true", snap_matches([1, 2, 3], "[1,2,3]"), 1)

    // KAT 6: snap_matches([1,2], "[1,2,3]") == false (0)
    ckb("matches_false", snap_matches([1, 2], "[1,2,3]"), 0)

    // KAT 7: snap_diff([1,2,3], "[1,2,3]") == ""
    cks("diff_match", snap_diff([1, 2, 3], "[1,2,3]"), "")

    // Additional coverage

    // snap_diff mismatch returns the expected diagnostic string
    let diffstr = snap_diff([1, 2], "[1,2,3]")
    cks("diff_mismatch_msg", diffstr, "snapshot mismatch: got [1,2] want [1,2,3]")

    // nested list serialization
    cks("serialize_nested_list", snap_serialize([[1, 2], [3, 4]]), "[[1,2],[3,4]]")

    // empty list
    cks("serialize_empty_list", snap_serialize([]), "[]")

    // empty dict: chr(123) + chr(125)
    let ed = {}
    cks("serialize_empty_dict", snap_serialize(ed), ob + cb)

    // three-key dict sorted: {a:1,m:2,z:3}
    let d3 = {}
    d3["z"] = 3
    d3["m"] = 2
    d3["a"] = 1
    cks("serialize_dict3_sorted", snap_serialize(d3), ob + "a:1,m:2,z:3" + cb)

    print("_snapshot_test passed")
