import forge_request_dedup

fn main()
    let r = rd_new()
    assert(rd_inflight_count(r) == 0, "starts empty")

    let s1 = rd_start(r, "GET:/api/users")
    r = s1["r"]
    assert(s1["is_first"] == 1, "first is original")
    assert(rd_waiters(r, "GET:/api/users") == 1, "1 waiter")

    let s2 = rd_start(r, "GET:/api/users")
    r = s2["r"]
    assert(s2["is_first"] == 0, "second is deduped")
    assert(rd_waiters(r, "GET:/api/users") == 2, "2 waiters")
    assert(rd_total_deduped(r) == 1, "1 deduped")

    let s3 = rd_start(r, "GET:/api/orders")
    r = s3["r"]
    assert(s3["is_first"] == 1, "orders is new")
    assert(rd_inflight_count(r) == 2, "2 inflight keys")

    r = rd_complete(r, "GET:/api/users")
    assert(rd_inflight_count(r) == 1, "1 after complete")
    assert(rd_waiters(r, "GET:/api/users") == 0, "0 waiters after complete")

    assert(rd_total_requests(r) == 3, "3 total")
    assert(rd_dedup_rate(r) == 33, "33% dedup")

    print("REQUEST-DEDUP KAT PASS")
