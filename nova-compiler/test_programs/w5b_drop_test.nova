// W5b benefit oracle: a function-local list, used but NOT returned/escaped, should be FREED at
// return under W5b. Called 1000x -> under W5b-on live_count stays bounded; under W5b-off it leaks ~1000.
fn make_and_discard() -> int
    let x = [1, 2, 3, 4, 5]
    let d = {}
    d["a"] = x[0]
    let s = x[0] + x[4] + d["a"]
    return s

fn main()
    let before = live_count()
    let i = 0
    while i < 1000
        make_and_discard()
        i = i + 1
    let after = live_count()
    let delta = after - before
    print("w5b_drop delta=" + str(delta))
    if delta > 100
        print("FAIL w5b_drop leak (delta=" + str(delta) + ") -- locals not freed")
        exit(1)
    print("w5b_drop PASS")
