import forge_convexgeom as cg

fn check(cond: bool, label: string)
    if cond == false
        print("FAIL: " + label)

fn lcg(state: int) -> int
    (state * 1103515245 + 12345) % 2147483648

fn distsq(a: list, b: list) -> int
    let dx = a[0] - b[0]
    let dy = a[1] - b[1]
    dx * dx + dy * dy

// brute diameter: max squared distance over all vertex pairs
fn brute_diameter(poly: list) -> int
    let best = 0
    let i = 0
    while i < len(poly)
        let j = i + 1
        while j < len(poly)
            let d = distsq(poly[i], poly[j])
            if d > best
                best = d
            j = j + 1
        i = i + 1
    best

// is a polygon strictly convex + CCW? (every turn non-negative cross)
fn is_ccw_convex(poly: list) -> bool
    let n = len(poly)
    let out = true
    if n < 3
        out = false
    else
        let i = 0
        while i < n
            let a = poly[i]
            let b = poly[(i + 1) % n]
            let c = poly[(i + 2) % n]
            if cg.orientation(a, b, c) < 0
                out = false
            i = i + 1
    out

fn main()
    // ---- point_in_convex: square [0,0]-[4,0]-[4,4]-[0,4] (CCW) ----
    let sq = [[0, 0], [4, 0], [4, 4], [0, 4]]
    check(cg.point_in_convex(sq, 2, 2), "square: (2,2) inside")
    check(cg.point_in_convex(sq, 5, 5) == false, "square: (5,5) outside")
    check(cg.point_in_convex(sq, 4, 2), "square: (4,2) on edge")
    check(cg.point_in_convex(sq, 0, 0), "square: (0,0) vertex")
    check(cg.point_in_convex(sq, 0 - 1, 2) == false, "square: (-1,2) outside")

    // ---- convex_hull of a known set ----
    let pts = [[0, 0], [1, 1], [2, 2], [4, 0], [0, 4], [4, 4], [2, 1]]
    let hull = cg.convex_hull(pts)
    check(is_ccw_convex(hull), "hull is CCW convex")
    // every input point must be inside or on the hull
    let pi = 0
    while pi < len(pts)
        check(cg.point_in_convex(hull, pts[pi][0], pts[pi][1]), "input point inside hull")
        pi = pi + 1
    // the 4 corners are hull vertices -> hull has 4 vertices (interior/collinear excluded)
    check(len(hull) == 4, "hull of square-ish set has 4 corners")

    // ---- diameter: square diagonal = (4-0)^2+(4-0)^2 = 32 ----
    check(cg.polygon_diameter_sq(sq) == 32, "square diameter^2 == 32")

    // ---- BIG cross-check: random convex polygons, rotating-calipers diameter == brute all-pairs ----
    let st = 246813579
    let trial = 0
    while trial < 40
        // random points, take hull
        st = lcg(st)
        let m = 6 + (st % 10)
        let raw = []
        let k = 0
        while k < m
            st = lcg(st)
            let x = st % 40
            st = lcg(st)
            let y = st % 40
            push(raw, [x, y])
            k = k + 1
        let poly = cg.convex_hull(raw)
        if len(poly) >= 3
            check(is_ccw_convex(poly), "trial hull convex " + str(trial))
            check(cg.polygon_diameter_sq(poly) == brute_diameter(poly), "diameter matches brute " + str(trial))
        trial = trial + 1

    // ---- Minkowski sum ----
    // triangle + triangle
    let ta = cg.convex_hull([[0, 0], [3, 0], [0, 3]])
    let tb = cg.convex_hull([[0, 0], [2, 0], [0, 2]])
    let msum = cg.minkowski_sum(ta, tb)
    check(is_ccw_convex(msum), "minkowski result convex")
    // every pairwise vertex sum must be inside-or-on the result
    let ia = 0
    while ia < len(ta)
        let ib = 0
        while ib < len(tb)
            let sx = ta[ia][0] + tb[ib][0]
            let sy = ta[ia][1] + tb[ib][1]
            check(cg.point_in_convex(msum, sx, sy), "pairwise sum inside minkowski")
            ib = ib + 1
        ia = ia + 1
    // area cross-check vs brute hull of all pairwise sums
    let allsums = []
    let ja = 0
    while ja < len(ta)
        let jb = 0
        while jb < len(tb)
            push(allsums, [ta[ja][0] + tb[jb][0], ta[ja][1] + tb[jb][1]])
            jb = jb + 1
        ja = ja + 1
    let bruteMink = cg.convex_hull(allsums)
    check(cg.twice_signed_area(msum) == cg.twice_signed_area(bruteMink), "minkowski area matches brute hull")

    // ---- BIG minkowski cross-check over random convex polygons ----
    let st2 = 55554444
    let t2 = 0
    while t2 < 25
        st2 = lcg(st2)
        let ma = 4 + (st2 % 5)
        let rawA = []
        let ka = 0
        while ka < ma
            st2 = lcg(st2)
            push(rawA, [st2 % 25, (st2 / 25) % 25])
            ka = ka + 1
        st2 = lcg(st2)
        let mb = 4 + (st2 % 5)
        let rawB = []
        let kb = 0
        while kb < mb
            st2 = lcg(st2)
            push(rawB, [st2 % 25, (st2 / 25) % 25])
            kb = kb + 1
        let A = cg.convex_hull(rawA)
        let B = cg.convex_hull(rawB)
        if len(A) >= 3 and len(B) >= 3
            let ms = cg.minkowski_sum(A, B)
            check(is_ccw_convex(ms), "rand minkowski convex " + str(t2))
            // brute hull of pairwise sums
            let sums = []
            let xa = 0
            while xa < len(A)
                let xb = 0
                while xb < len(B)
                    push(sums, [A[xa][0] + B[xb][0], A[xa][1] + B[xb][1]])
                    xb = xb + 1
                xa = xa + 1
            let bm = cg.convex_hull(sums)
            check(cg.twice_signed_area(ms) == cg.twice_signed_area(bm), "rand minkowski area matches brute " + str(t2))
        t2 = t2 + 1

    print("forge_convexgeom: all passed")
