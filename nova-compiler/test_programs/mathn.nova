fn gcd(a, b)
  let x = a
  let y = b
  if x < 0
    x = 0 - x
  if y < 0
    y = 0 - y
  while y != 0
    let t = y
    y = x % y
    x = t
  x

fn lcm(a, b)
  if a == 0 or b == 0
    return 0
  let g = gcd(a, b)
  (a / g) * b

fn is_prime(n)
  if n < 2
    return 0
  if n < 4
    return 1
  if n % 2 == 0 or n % 3 == 0
    return 0
  let i = 5
  while i * i <= n
    if n % i == 0 or n % (i + 2) == 0
      return 0
    i = i + 6
  1

fn factorial(n)
  if n <= 1
    return 1
  let result = 1
  let i = 2
  while i <= n
    result = result * i
    i = i + 1
  result

fn fibonacci(n)
  if n <= 0
    return 0
  if n == 1
    return 1
  let a = 0
  let b = 1
  let i = 2
  while i <= n
    let t = a + b
    a = b
    b = t
    i = i + 1
  b

fn binomial(n, k)
  if k < 0 or k > n
    return 0
  if k == 0 or k == n
    return 1
  let result = 1
  let i = 0
  while i < k
    result = result * (n - i)
    result = result / (i + 1)
    i = i + 1
  result

fn is_perfect_square(n)
  if n < 0
    return 0
  let s = int_sqrt(n)
  s * s == n

fn int_sqrt(n)
  if n <= 0
    return 0
  let x = n
  let y = (x + 1) / 2
  while y < x
    x = y
    y = (x + n / x) / 2
  x

fn main()
  assert(gcd(12, 8) == 4, "gcd(12,8)=4")
  assert(gcd(100, 75) == 25, "gcd(100,75)=25")
  assert(gcd(17, 13) == 1, "coprime")
  assert(gcd(0, 5) == 5, "gcd(0,5)")

  assert(lcm(4, 6) == 12, "lcm(4,6)=12")
  assert(lcm(12, 18) == 36, "lcm(12,18)=36")
  assert(lcm(0, 5) == 0, "lcm(0,5)=0")

  assert(is_prime(2) == 1, "2 prime")
  assert(is_prime(3) == 1, "3 prime")
  assert(is_prime(4) == 0, "4 not prime")
  assert(is_prime(17) == 1, "17 prime")
  assert(is_prime(97) == 1, "97 prime")
  assert(is_prime(100) == 0, "100 not prime")

  assert(factorial(0) == 1, "0!")
  assert(factorial(1) == 1, "1!")
  assert(factorial(5) == 120, "5!")
  assert(factorial(10) == 3628800, "10!")

  assert(fibonacci(0) == 0, "fib(0)")
  assert(fibonacci(1) == 1, "fib(1)")
  assert(fibonacci(10) == 55, "fib(10)")
  assert(fibonacci(20) == 6765, "fib(20)")

  assert(binomial(5, 2) == 10, "C(5,2)")
  assert(binomial(10, 3) == 120, "C(10,3)")
  assert(binomial(0, 0) == 1, "C(0,0)")

  assert(int_sqrt(16) == 4, "sqrt(16)")
  assert(int_sqrt(25) == 5, "sqrt(25)")
  assert(int_sqrt(26) == 5, "sqrt(26) floor")

  assert(is_perfect_square(16) == 1, "16 perfect sq")
  assert(is_perfect_square(15) == 0, "15 not perfect sq")

  print("mathn: all passed")
