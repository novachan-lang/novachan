// KAT for std/text/diff
import std/text/diff

fn list_eq(a, b)
    if len(a) != len(b)
        return 0
    let i = 0
    while i < len(a)
        if a[i] != b[i]
            return 0
        i = i + 1
    return 1

fn list_str(xs)
    let s = "["
    let i = 0
    while i < len(xs)
        if i > 0
            s = s + ","
        s = s + xs[i]
        i = i + 1
    s = s + "]"
    s

fn cka(got, want, label)
    if list_eq(got, want) == 0
        print("FAIL " + label + " got=" + list_str(got) + " want=" + list_str(want))
        exit(1)

fn main()
    let nl = chr(10)

    // KAT 1: one substitution in the middle
    let k1_got  = diff_lines("a" + nl + "b" + nl + "c", "a" + nl + "x" + nl + "c")
    let k1_want = [" a", "-b", "+x", " c"]
    cka(k1_got, k1_want, "KAT1 one-substitution")

    // KAT 2: identical texts → all common
    let k2_got  = diff_lines("a" + nl + "b", "a" + nl + "b")
    let k2_want = [" a", " b"]
    cka(k2_got, k2_want, "KAT2 identical")

    // KAT 3: a empty, b has one line → insertion
    let k3_got  = diff_lines("", "x")
    let k3_want = ["+x"]
    cka(k3_got, k3_want, "KAT3 a-empty")

    // KAT 4: b empty, a has one line → deletion
    let k4_got  = diff_lines("x", "")
    let k4_want = ["-x"]
    cka(k4_got, k4_want, "KAT4 b-empty")

    // KAT 5: delete one line from middle (a has extra "b")
    let k5_got  = diff_lines("a" + nl + "b" + nl + "c", "a" + nl + "c")
    let k5_want = [" a", "-b", " c"]
    cka(k5_got, k5_want, "KAT5 delete-middle")

    // KAT 6: both empty → empty list
    let k6_got  = diff_lines("", "")
    let k6_want = []
    cka(k6_got, k6_want, "KAT6 both-empty")

    // KAT 7: completely different single lines
    let k7_got  = diff_lines("hello", "world")
    let k7_want = ["-hello", "+world"]
    cka(k7_got, k7_want, "KAT7 complete-replace")

    // KAT 8: insert at start
    let k8_got  = diff_lines("b" + nl + "c", "a" + nl + "b" + nl + "c")
    let k8_want = ["+a", " b", " c"]
    cka(k8_got, k8_want, "KAT8 insert-at-start")

    print("_diff_test passed")
