import forge_metric_gauge

fn main()
    let m = mg_new()
    assert(mg_gauge_count(m) == 0, "starts empty")
    assert(mg_get(m, "connections") == 0, "missing = 0")

    m = mg_set(m, "connections", 10)
    assert(mg_get(m, "connections") == 10, "set to 10")

    m = mg_inc(m, "connections")
    m = mg_inc(m, "connections")
    assert(mg_get(m, "connections") == 12, "12 after 2 incs")

    m = mg_dec(m, "connections")
    assert(mg_get(m, "connections") == 11, "11 after dec")

    m = mg_add(m, "connections", -5)
    assert(mg_get(m, "connections") == 6, "6 after add -5")

    m = mg_set(m, "cpu_pct", 75)
    assert(mg_gauge_count(m) == 2, "2 gauges")

    m = mg_inc(m, "new_gauge")
    assert(mg_get(m, "new_gauge") == 1, "new gauge starts at 1")

    m = mg_dec(m, "another")
    assert(mg_get(m, "another") == -1, "dec on new = -1")

    print("METRIC-GAUGE KAT PASS")
