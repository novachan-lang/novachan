import forge_ui_state

fn main()
    let us = us_new()
    us = us_create(us, "counter", "0")
    us = us_create(us, "theme", "light")
    assert(us_component_count(us) == 2, "2 components")
    assert(us_has_component(us, "counter") == 1, "has counter")

    let v1 = us_get(us, "counter")
    assert(unwrap(v1) == "0", "initial 0")

    let s1 = us_set(us, "counter", "5")
    us = unwrap(s1)
    let v2 = us_get(us, "counter")
    assert(unwrap(v2) == "5", "updated to 5")
    let pv = us_previous(us, "counter")
    assert(unwrap(pv) == "0", "prev was 0")

    let d1 = us_is_dirty(us, "counter")
    assert(unwrap(d1) == 1, "dirty after set")

    let cl = us_clean(us, "counter")
    us = unwrap(cl)
    let d2 = us_is_dirty(us, "counter")
    assert(unwrap(d2) == 0, "clean after clean")

    let s2 = us_set(us, "counter", "10")
    us = unwrap(s2)
    let cu = us_component_updates(us, "counter")
    assert(unwrap(cu) == 2, "2 updates to counter")
    assert(us_update_count(us) == 2, "2 total updates")

    let bad = us_get(us, "nope")
    assert(is_err(bad), "unknown component")

    let bad2 = us_set(us, "nope", "x")
    assert(is_err(bad2), "unknown set")

    print("UI-STATE KAT PASS")
