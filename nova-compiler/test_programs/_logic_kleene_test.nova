import std/logic/logic_kleene

// cki — integer known-answer check.
fn cki(label, got, want)
    if got != want
        print("FAIL _logic_kleene_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb — boolean known-answer check.
fn ckb(label, got, want)
    if got != want
        print("FAIL _logic_kleene_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // Values: 0=false, 1=unknown, 2=true

    // ─── lk3_not ────────────────────────────────────────────────────────────
    cki("not_0", lk3_not(0), 2)
    cki("not_1", lk3_not(1), 1)
    cki("not_2", lk3_not(2), 0)

    // ─── lk3_and ────────────────────────────────────────────────────────────
    // min(a,b)
    cki("and_2_1", lk3_and(2, 1), 1)
    cki("and_0_1", lk3_and(0, 1), 0)
    cki("and_2_2", lk3_and(2, 2), 2)
    cki("and_0_0", lk3_and(0, 0), 0)
    cki("and_1_1", lk3_and(1, 1), 1)
    cki("and_0_2", lk3_and(0, 2), 0)
    cki("and_2_0", lk3_and(2, 0), 0)
    cki("and_1_0", lk3_and(1, 0), 0)
    cki("and_1_2", lk3_and(1, 2), 1)

    // ─── lk3_or ─────────────────────────────────────────────────────────────
    // max(a,b)
    cki("or_0_1", lk3_or(0, 1), 1)
    cki("or_2_1", lk3_or(2, 1), 2)
    cki("or_0_0", lk3_or(0, 0), 0)
    cki("or_2_2", lk3_or(2, 2), 2)
    cki("or_1_1", lk3_or(1, 1), 1)
    cki("or_0_2", lk3_or(0, 2), 2)
    cki("or_2_0", lk3_or(2, 0), 2)
    cki("or_1_0", lk3_or(1, 0), 1)
    cki("or_1_2", lk3_or(1, 2), 2)

    // ─── lk3_implies ────────────────────────────────────────────────────────
    // max(2-a, b)
    cki("impl_2_0", lk3_implies(2, 0), 0)
    cki("impl_1_2", lk3_implies(1, 2), 2)
    cki("impl_0_0", lk3_implies(0, 0), 2)
    cki("impl_1_1", lk3_implies(1, 1), 1)
    cki("impl_0_2", lk3_implies(0, 2), 2)
    cki("impl_2_2", lk3_implies(2, 2), 2)
    cki("impl_0_1", lk3_implies(0, 1), 2)
    cki("impl_2_1", lk3_implies(2, 1), 1)
    cki("impl_1_0", lk3_implies(1, 0), 1)

    // ─── lk3_iff ────────────────────────────────────────────────────────────
    // min(implies(a,b), implies(b,a))
    cki("iff_2_2", lk3_iff(2, 2), 2)
    cki("iff_2_0", lk3_iff(2, 0), 0)
    cki("iff_1_0", lk3_iff(1, 0), 1)
    cki("iff_0_0", lk3_iff(0, 0), 2)
    cki("iff_1_1", lk3_iff(1, 1), 1)
    cki("iff_2_1", lk3_iff(2, 1), 1)
    cki("iff_0_2", lk3_iff(0, 2), 0)
    cki("iff_1_2", lk3_iff(1, 2), 1)
    cki("iff_0_1", lk3_iff(0, 1), 1)

    // ─── lk3_is_designated ──────────────────────────────────────────────────
    // only 2 (true) is designated
    if lk3_is_designated(2) == true
        cki("designated_2", 1, 1)
    if lk3_is_designated(2) == false
        cki("designated_2", 0, 1)
    if lk3_is_designated(1) == true
        cki("designated_1", 0, 1)
    if lk3_is_designated(0) == true
        cki("designated_0", 0, 1)

    // ─── lk3_from_bool ──────────────────────────────────────────────────────
    cki("from_bool_0", lk3_from_bool(0), 0)
    cki("from_bool_1", lk3_from_bool(1), 2)

    // ─── Kleene law checks (full 3x3 enumeration) ───────────────────────────
    // law: NOT(NOT(a)) == a for all a in {0,1,2}
    let a = 0
    while a <= 2
        let dbl = lk3_not(lk3_not(a))
        if dbl != a
            print("FAIL _logic_kleene_test double_neg[" + str(a) + "]: got=" + str(dbl) + " want=" + str(a))
            exit(1)
        a = a + 1

    // law: a OR NOT(a) is designated iff a == 0 or a == 2 (classical tautology breaks in K3)
    // In K3: a=1 => OR(1, NOT(1)) = OR(1,1) = 1 which is NOT designated
    cki("excluded_middle_0", lk3_or(0, lk3_not(0)), 2)
    cki("excluded_middle_1", lk3_or(1, lk3_not(1)), 1)
    cki("excluded_middle_2", lk3_or(2, lk3_not(2)), 2)

    // law: a AND NOT(a) = 0 for a=0,2 but =1 for a=1
    cki("contradiction_0", lk3_and(0, lk3_not(0)), 0)
    cki("contradiction_1", lk3_and(1, lk3_not(1)), 1)
    cki("contradiction_2", lk3_and(2, lk3_not(2)), 0)

    // law: De Morgan NOT(AND(a,b)) == OR(NOT(a), NOT(b)) for all a,b in {0,1,2}
    let p = 0
    while p <= 2
        let q = 0
        while q <= 2
            let lhs = lk3_not(lk3_and(p, q))
            let rhs = lk3_or(lk3_not(p), lk3_not(q))
            if lhs != rhs
                print("FAIL _logic_kleene_test demorgan_and[" + str(p) + "," + str(q) + "]: lhs=" + str(lhs) + " rhs=" + str(rhs))
                exit(1)
            q = q + 1
        p = p + 1

    // law: De Morgan NOT(OR(a,b)) == AND(NOT(a), NOT(b)) for all a,b
    let r = 0
    while r <= 2
        let s = 0
        while s <= 2
            let lhs2 = lk3_not(lk3_or(r, s))
            let rhs2 = lk3_and(lk3_not(r), lk3_not(s))
            if lhs2 != rhs2
                print("FAIL _logic_kleene_test demorgan_or[" + str(r) + "," + str(s) + "]: lhs=" + str(lhs2) + " rhs=" + str(rhs2))
                exit(1)
            s = s + 1
        r = r + 1

    // law: implies(a,b) = or(not(a),b) for all a,b
    let u = 0
    while u <= 2
        let v = 0
        while v <= 2
            let imp = lk3_implies(u, v)
            let orv = lk3_or(lk3_not(u), v)
            if imp != orv
                print("FAIL _logic_kleene_test impl_eq_or_not[" + str(u) + "," + str(v) + "]: imp=" + str(imp) + " orv=" + str(orv))
                exit(1)
            v = v + 1
        u = u + 1

    // law: iff(a,b) == iff(b,a) for all a,b (symmetry)
    let x = 0
    while x <= 2
        let y = 0
        while y <= 2
            let iff_ab = lk3_iff(x, y)
            let iff_ba = lk3_iff(y, x)
            if iff_ab != iff_ba
                print("FAIL _logic_kleene_test iff_sym[" + str(x) + "," + str(y) + "]: got=" + str(iff_ab) + " rev=" + str(iff_ba))
                exit(1)
            y = y + 1
        x = x + 1

    print("PASS _logic_kleene_test")
