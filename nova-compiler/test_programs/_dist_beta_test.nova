// KAT test for std/numeric/dist_beta — Beta distribution.
//
// Known answers:
//   beta_mean(2.0, 3.0) = 2/(2+3) = 0.4
//   beta(1,1) is Uniform(0,1): pdf=1.0 everywhere in (0,1)
//   beta_pdf(1.5, a, b) = 0.0 (outside [0,1])
//   beta_cdf(0.5, 1.0, 1.0) = 0.5 (uniform median)
import std/numeric/dist_beta

fn approx(a, b, tol) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < tol
        return 1
    return 0

fn ck(label: string, got: float, want: float, tol: float)
    let ok = approx(got, want, tol)
    if ok == 0
        print("FAIL dist_beta " + label + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("ok " + label)

fn main()
    // beta_mean(2.0, 3.0) = 0.4
    let m = beta_mean(2.0, 3.0)
    ck("beta_mean(2,3)=0.4", m, 0.4, 0.0001)

    // Beta(1,1) = Uniform(0,1): pdf=1.0 at any point in (0,1)
    let p = beta_pdf(0.5, 1.0, 1.0)
    ck("beta_pdf(0.5,1,1)=1.0", p, 1.0, 0.001)

    // beta_pdf outside [0,1] = 0.0
    let p2 = beta_pdf(1.5, 2.0, 3.0)
    ck("beta_pdf(1.5,2,3)=0.0", p2, 0.0, 0.001)

    let p3 = beta_pdf(0.0, 2.0, 3.0)
    ck("beta_pdf(0.0,2,3)=0.0", p3, 0.0, 0.001)

    // beta_cdf(0.5, 1.0, 1.0) = 0.5 (uniform CDF at midpoint)
    let c = beta_cdf(0.5, 1.0, 1.0)
    ck("beta_cdf(0.5,1,1)=0.5", c, 0.5, 0.001)

    // beta_cdf(0.0, ...) = 0.0
    let c0 = beta_cdf(0.0, 2.0, 3.0)
    ck("beta_cdf(0.0,2,3)=0.0", c0, 0.0, 0.001)

    // beta_cdf(1.0, ...) = 1.0
    let c1 = beta_cdf(1.0, 2.0, 3.0)
    ck("beta_cdf(1.0,2,3)=1.0", c1, 1.0, 0.001)

    // beta_pdf(0.5, 2.0, 2.0) = 6*0.5*(0.5) = 1.5
    // B(2,2) = Gamma(2)*Gamma(2)/Gamma(4) = 1*1/6 = 1/6
    // pdf = 0.5^1 * 0.5^1 / (1/6) = 0.25 * 6 = 1.5
    let p4 = beta_pdf(0.5, 2.0, 2.0)
    ck("beta_pdf(0.5,2,2)=1.5", p4, 1.5, 0.001)

    print("PASS _dist_beta_test")
