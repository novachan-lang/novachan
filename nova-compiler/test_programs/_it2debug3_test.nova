fn mysort(out, n)
    let j = 1
    while j < n
        let key = out[j]
        let klo = key[0]
        let khi = key[1]
        let pos = j
        let k = j - 1
        let done = false
        while k >= 0 and done == false
            let cur = out[k]
            let clo = cur[0]
            let chi = cur[1]
            let shift = 0
            if clo > klo
                shift = 1
            else
                if clo == klo and chi > khi
                    shift = 1
            if shift == 1
                out[k + 1] = out[k]
                pos = k
                k = k - 1
            else
                done = true
        out[pos] = key
        j = j + 1

fn main()
    let ivs = []
    push(ivs, [1,3])
    push(ivs, [5,8])
    push(ivs, [6,10])
    push(ivs, [15,20])
    print("before sort:")
    let i = 0
    while i < 4
        let ii = i
        let v = ivs[ii]
        print("  ivs[" + str(ii) + "]=" + str(v[0]) + "," + str(v[1]))
        i = i + 1
    mysort(ivs, 4)
    print("after sort:")
    let j = 0
    while j < 4
        let jj = j
        let v = ivs[jj]
        print("  ivs[" + str(jj) + "]=" + str(v[0]) + "," + str(v[1]))
        j = j + 1

main()
