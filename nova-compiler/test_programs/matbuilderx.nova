fn mat_new(rows, cols, fill)
  let m = {}
  m["rows"] = rows
  m["cols"] = cols
  let data = []
  let i = 0
  while i < rows * cols
    push(data, fill)
    i = i + 1
  m["data"] = data
  m

fn mat_get(m, r, c)
  m["data"][r * m["cols"] + c]

fn mat_set(m, r, c, val)
  m["data"][r * m["cols"] + c] = val

fn mat_rows(m)
  m["rows"]

fn mat_cols(m)
  m["cols"]

fn mat_identity(n)
  let m = mat_new(n, n, 0)
  let i = 0
  while i < n
    mat_set(m, i, i, 1)
    i = i + 1
  m

fn mat_add(a, b)
  let r = mat_rows(a)
  let c = mat_cols(a)
  let result = mat_new(r, c, 0)
  let i = 0
  while i < r
    let j = 0
    while j < c
      mat_set(result, i, j, mat_get(a, i, j) + mat_get(b, i, j))
      j = j + 1
    i = i + 1
  result

fn mat_mul(a, b)
  let ra = mat_rows(a)
  let ca = mat_cols(a)
  let cb = mat_cols(b)
  let result = mat_new(ra, cb, 0)
  let i = 0
  while i < ra
    let j = 0
    while j < cb
      let s = 0
      let k = 0
      while k < ca
        s = s + mat_get(a, i, k) * mat_get(b, k, j)
        k = k + 1
      mat_set(result, i, j, s)
      j = j + 1
    i = i + 1
  result

fn mat_transpose(m)
  let r = mat_rows(m)
  let c = mat_cols(m)
  let result = mat_new(c, r, 0)
  let i = 0
  while i < r
    let j = 0
    while j < c
      mat_set(result, j, i, mat_get(m, i, j))
      j = j + 1
    i = i + 1
  result

fn main()
  let m = mat_new(2, 3, 0)
  mat_set(m, 0, 0, 1)
  mat_set(m, 0, 1, 2)
  mat_set(m, 0, 2, 3)
  mat_set(m, 1, 0, 4)
  mat_set(m, 1, 1, 5)
  mat_set(m, 1, 2, 6)
  assert(mat_get(m, 0, 0) == 1, "get 0,0")
  assert(mat_get(m, 1, 2) == 6, "get 1,2")
  assert(mat_rows(m) == 2, "2 rows")
  assert(mat_cols(m) == 3, "3 cols")

  let id = mat_identity(3)
  assert(mat_get(id, 0, 0) == 1, "identity diag")
  assert(mat_get(id, 0, 1) == 0, "identity off-diag")

  let a = mat_new(2, 2, 0)
  mat_set(a, 0, 0, 1)
  mat_set(a, 0, 1, 2)
  mat_set(a, 1, 0, 3)
  mat_set(a, 1, 1, 4)
  let b = mat_new(2, 2, 0)
  mat_set(b, 0, 0, 5)
  mat_set(b, 0, 1, 6)
  mat_set(b, 1, 0, 7)
  mat_set(b, 1, 1, 8)

  let sum = mat_add(a, b)
  assert(mat_get(sum, 0, 0) == 6, "add 0,0")
  assert(mat_get(sum, 1, 1) == 12, "add 1,1")

  let prod = mat_mul(a, b)
  assert(mat_get(prod, 0, 0) == 19, "mul 0,0 (1*5+2*7)")
  assert(mat_get(prod, 1, 1) == 50, "mul 1,1 (3*6+4*8)")

  let t = mat_transpose(m)
  assert(mat_rows(t) == 3, "transpose rows")
  assert(mat_cols(t) == 2, "transpose cols")
  assert(mat_get(t, 2, 0) == 3, "transpose value")

  print("matbuilderx: all passed")
