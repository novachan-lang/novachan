// T? optionality sugar: `T?` in param and return positions == Option<T>,
// interoperating with some/none/match. Zero-ceremony optional values.

fn first_even(xs: list<int>) -> int?
    for x in xs
        if x % 2 == 0
            return some(x)
    return none()

fn describe(v: int?) -> string
    match v
        Some(n) => return "got " + str(n)
        None => return "nothing"

fn main()
    let a = first_even([1, 3, 4, 7])
    assert_eq(is_some(a), 1)
    assert_eq(unwrap(a), 4)
    assert_eq(describe(a), "got 4")

    let b = first_even([1, 3, 5])
    assert_eq(is_none(b), 1)
    assert_eq(describe(b), "nothing")

    print("optional passed")
