import std/data/riff

// cki: check int equality; print FAIL and exit(1) on mismatch.
fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// cks: check string equality; print FAIL and exit(1) on mismatch.
fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + got + " want " + want)
        exit(1)

// _rff_bytes: build a minimal RIFF file as a bytes value.
//
// Layout (34 bytes total):
//   [0..3]  "RIFF"                         magic
//   [4..7]  LE-u32 = 26                    size = 34 - 8
//   [8..11] "WAVE"                         form type
//  -- fmt chunk --
//   [12..15] "fmt "                        chunk id
//   [16..19] LE-u32 = 4                    chunk size
//   [20..23] 0x01 0x00 0x01 0x00           chunk data (4 bytes)
//  -- data chunk --
//   [24..27] "data"                        chunk id
//   [28..31] LE-u32 = 2                    chunk size
//   [32..33] 0xAB 0xCD                     chunk data (2 bytes)
//
// RIFF size = 34 - 8 = 26; LE bytes = [26, 0, 0, 0].
// "fmt " size = 4 (even, no pad); "data" size = 2 (even, no pad).
fn _rff_bytes() -> any
    let b = bytes(0)
    // "RIFF"
    b = bytes_append(b, 82)
    b = bytes_append(b, 73)
    b = bytes_append(b, 70)
    b = bytes_append(b, 70)
    // LE-u32 size = 26
    b = bytes_append(b, 26)
    b = bytes_append(b, 0)
    b = bytes_append(b, 0)
    b = bytes_append(b, 0)
    // "WAVE"
    b = bytes_append(b, 87)
    b = bytes_append(b, 65)
    b = bytes_append(b, 86)
    b = bytes_append(b, 69)
    // "fmt " -- 102 111 116 32
    b = bytes_append(b, 102)
    b = bytes_append(b, 109)
    b = bytes_append(b, 116)
    b = bytes_append(b, 32)
    // chunk size LE-u32 = 4
    b = bytes_append(b, 4)
    b = bytes_append(b, 0)
    b = bytes_append(b, 0)
    b = bytes_append(b, 0)
    // fmt data: 4 bytes
    b = bytes_append(b, 1)
    b = bytes_append(b, 0)
    b = bytes_append(b, 1)
    b = bytes_append(b, 0)
    // "data" -- 100 97 116 97
    b = bytes_append(b, 100)
    b = bytes_append(b, 97)
    b = bytes_append(b, 116)
    b = bytes_append(b, 97)
    // chunk size LE-u32 = 2
    b = bytes_append(b, 2)
    b = bytes_append(b, 0)
    b = bytes_append(b, 0)
    b = bytes_append(b, 0)
    // data payload: 2 bytes
    b = bytes_append(b, 171)
    b = bytes_append(b, 205)
    b

fn main()
    let b = _rff_bytes()

    // ── KAT 1: total byte count ───────────────────────────────────────────────
    cki("total bytes", bytes_len(b), 34)
    print("KAT 1 passed: total byte count")

    // ── KAT 2: rff_form_type ─────────────────────────────────────────────────
    cks("form_type", rff_form_type(b), "WAVE")
    print("KAT 2 passed: rff_form_type == WAVE")

    // ── KAT 3: rff_riff_size ─────────────────────────────────────────────────
    // total=34, size field = 34-8 = 26
    cki("riff_size", rff_riff_size(b), 26)
    print("KAT 3 passed: rff_riff_size == 26")

    // ── KAT 4: rff_chunk_ids ─────────────────────────────────────────────────
    let ids = rff_chunk_ids(b)
    cki("chunk_ids len", len(ids), 2)
    cks("chunk_ids[0]", ids[0], "fmt ")
    cks("chunk_ids[1]", ids[1], "data")
    print("KAT 4 passed: rff_chunk_ids == [fmt , data]")

    // ── KAT 5: rff_find_chunk present ────────────────────────────────────────
    let fc = rff_find_chunk(b, "data")
    // "data" chunk header at offset 24; data starts at 24+8=32; size=2
    cki("find_chunk data start", fc[0], 32)
    cki("find_chunk data len",   fc[1], 2)
    print("KAT 5 passed: rff_find_chunk data -> [32, 2]")

    // ── KAT 6: rff_find_chunk absent ─────────────────────────────────────────
    let fn2 = rff_find_chunk(b, "none")
    cki("find_chunk none[0]", fn2[0], -1)
    cki("find_chunk none[1]", fn2[1], -1)
    print("KAT 6 passed: rff_find_chunk none -> [-1, -1]")

    // ── KAT 7: rff_find_chunk fmt  ───────────────────────────────────────────
    let ff = rff_find_chunk(b, "fmt ")
    // "fmt " chunk header at offset 12; data starts at 12+8=20; size=4
    cki("find_chunk fmt start", ff[0], 20)
    cki("find_chunk fmt len",   ff[1], 4)
    print("KAT 7 passed: rff_find_chunk fmt  -> [20, 4]")

    // ── KAT 8: verify fmt data bytes ─────────────────────────────────────────
    cki("fmt data[0]", bytes_get(b, ff[0]),     1)
    cki("fmt data[1]", bytes_get(b, ff[0] + 1), 0)
    cki("fmt data[2]", bytes_get(b, ff[0] + 2), 1)
    cki("fmt data[3]", bytes_get(b, ff[0] + 3), 0)
    print("KAT 8 passed: fmt data bytes verified")

    // ── KAT 9: verify data chunk payload ─────────────────────────────────────
    cki("data payload[0]", bytes_get(b, fc[0]),     171)
    cki("data payload[1]", bytes_get(b, fc[0] + 1), 205)
    print("KAT 9 passed: data chunk payload verified")

    // ── KAT 10: LE-u32 decoding for multi-byte size ──────────────────────────
    // Build a bytes buffer with a 4-byte LE-u32 = 0x01020304 at offset 4
    // Value = 1 + 2*256 + 3*65536 + 4*16777216 = 1 + 512 + 196608 + 67108864 = 67306497 - check:
    // 0x04030201 in LE is stored as [1, 2, 3, 4] -> value = 0x04030201 = 67305985
    // Let's be precise: LE [b0=1, b1=2, b2=3, b3=4] = 1 + 512 + 196608 + 67108864 = 67306497? No:
    // 4 * 16777216 = 67108864; 3 * 65536 = 196608; 2 * 256 = 512; 1 = 1 -> 67306985?
    // 67108864 + 196608 = 67305472; + 512 = 67305984; + 1 = 67305985. Value = 67305985.
    let bigb = bytes(0)
    // padding 4 bytes at start (dummy RIFF header: "RIFF" = [82,73,70,70])
    bigb = bytes_append(bigb, 82)
    bigb = bytes_append(bigb, 73)
    bigb = bytes_append(bigb, 70)
    bigb = bytes_append(bigb, 70)
    // size field LE = [1, 2, 3, 4]
    bigb = bytes_append(bigb, 1)
    bigb = bytes_append(bigb, 2)
    bigb = bytes_append(bigb, 3)
    bigb = bytes_append(bigb, 4)
    cki("le32 multi-byte", rff_riff_size(bigb), 67305985)
    print("KAT 10 passed: LE-u32 multi-byte decode")

    print("_riff_test passed")
