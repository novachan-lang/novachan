import std/cli/cli_usage

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // KAT 1: usage line with tokens
    cks("usage_tokens", clu_usage_line("myapp", ["-v", "-h"]), "Usage: myapp [-v] [-h]")

    // KAT 2: usage line with no tokens
    cks("usage_empty", clu_usage_line("app", []), "Usage: app")

    // KAT 3: option line formatting
    cks("opt_line", clu_option_line("-v", "--verbose", "be loud"), "  -v, --verbose  be loud")

    // KAT 4: pad_right shorter string
    cks("pad_short", clu_pad_right("ab", 5), "ab   ")

    // KAT 5: pad_right already at width — no truncation
    cks("pad_exact", clu_pad_right("abcde", 3), "abcde")

    // KAT 6: pad_right empty string
    cks("pad_empty", clu_pad_right("", 3), "   ")

    // KAT 7: pad_right already exactly width
    cks("pad_fit", clu_pad_right("abc", 3), "abc")

    // KAT 8: usage line with single token
    cks("usage_one", clu_usage_line("cmd", ["FILE"]), "Usage: cmd [FILE]")

    // KAT 9: option line with long desc
    cks("opt_long_desc", clu_option_line("-o", "--output", "write output to file"), "  -o, --output  write output to file")

    print("PASS _cli_usage_test")
