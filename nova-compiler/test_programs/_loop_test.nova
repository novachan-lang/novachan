let count = 0
loop
    count += 1
    if count >= 5
        break
assert(count == 5, "loop with break")

let total = 0
let i = 0
loop
    if i >= 10
        break
    total += i
    i += 1
assert(total == 45, "loop sum 0..9")

fn find_first_even(nums: list) -> int
    let idx = 0
    loop
        if idx >= len(nums)
            return -1
        if nums[idx] % 2 == 0
            return nums[idx]
        idx += 1
    return -1

assert(find_first_even([1, 3, 5, 4, 7]) == 4, "find_first_even")
assert(find_first_even([1, 3, 5]) == -1, "find_first_even none")

print("all loop tests passed")
