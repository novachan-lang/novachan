// forge_connguard_test -- the N>1-safe concurrent-connection guard ACTOR (accept-storm backpressure, B4).
// The pure conn_new/conn_acquire dict counter races at NOVA_CARRIERS>1 (acceptor increments, worker
// releases). conn_guard serializes acquire/release through one owning task, so the cap is exact under any
// carrier count. This is the primitive the accept loop will call to 503 an accept storm (T1.6 wires it in).
import forge_limits

fn main()
    // cap = 2: two acquires succeed, the third is refused, a release frees exactly one slot.
    let g = forge_limits.conn_guard(2)
    assert(forge_limits.cg_acquire(g) == 1, "1st acquire under cap -> granted")
    assert(forge_limits.cg_acquire(g) == 1, "2nd acquire at cap boundary -> granted")
    assert(forge_limits.cg_acquire(g) == 0, "3rd acquire over cap -> refused (503)")
    forge_limits.cg_release(g)
    assert(forge_limits.cg_acquire(g) == 1, "acquire after a release -> granted again")
    assert(forge_limits.cg_acquire(g) == 0, "back at cap -> refused")
    print("PASS: conn_guard cap enforced (grant to cap, refuse over, release frees exactly one)")

    // release floor: over-releasing must not drive the count negative (a later acquire still respects cap).
    forge_limits.cg_release(g)
    forge_limits.cg_release(g)
    forge_limits.cg_release(g)
    forge_limits.cg_release(g)   // more releases than live slots
    assert(forge_limits.cg_acquire(g) == 1, "post over-release: 1st acquire granted")
    assert(forge_limits.cg_acquire(g) == 1, "post over-release: 2nd acquire granted")
    assert(forge_limits.cg_acquire(g) == 0, "post over-release: cap still 2 (count floored at 0, not negative)")
    print("PASS: conn_guard release floored at 0 (over-release cannot inflate capacity)")

    forge_limits.conn_guard_stop(g)

    // Independent guards keep independent counts.
    let g2 = forge_limits.conn_guard(1)
    assert(forge_limits.cg_acquire(g2) == 1, "separate guard: first slot")
    assert(forge_limits.cg_acquire(g2) == 0, "separate guard: at its own cap of 1")
    forge_limits.conn_guard_stop(g2)
    print("PASS: independent guards, independent counts")

    print("forge_connguard_test passed")
