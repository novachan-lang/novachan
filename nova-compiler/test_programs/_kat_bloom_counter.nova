import forge_bloom_counter

fn main()
    let b = bc_new(64)
    b = bc_add(b, "apple")
    b = bc_add(b, "banana")
    b = bc_add(b, "cherry")
    assert(bc_total_added(b) == 3, "3 added")

    assert(bc_might_contain(b, "apple") == 1, "apple yes")
    assert(bc_might_contain(b, "banana") == 1, "banana yes")
    assert(bc_might_contain(b, "cherry") == 1, "cherry yes")

    assert(bc_min_count(b, "apple") >= 1, "apple count >= 1")

    b = bc_add(b, "apple")
    b = bc_add(b, "apple")
    assert(bc_min_count(b, "apple") >= 3, "apple count >= 3")
    assert(bc_total_added(b) == 5, "5 total")

    print("BLOOM-COUNTER KAT PASS")
