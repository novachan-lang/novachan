// KAT for std/net/tcpopts — TCP options TLV codec.
// Canonical wire vector: encode [MSS 1460, NOP, WSCALE 7, SACKPERM]
//   02 04 05 B4  01  03 03 07  04 02   (10 bytes)
import std/net/tcpopts

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL tcpopts " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── Vector 1: byte-exact encode of known header ───────────────────────────
    let mss_opt = {"kind": 2, "value": 1460}
    let nop_opt = {"kind": 1}
    let ws_opt = {"kind": 3, "value": 7}
    let sp_opt = {"kind": 4}
    let opts = [mss_opt, nop_opt, ws_opt, sp_opt]
    let enc = tcpopt_encode(opts)

    // 10 bytes total
    cki("enc_len",   bytes_len(enc), 10)
    // MSS: 02 04 05 B4
    cki("enc_b0",  bytes_get(enc, 0), 0x02)
    cki("enc_b1",  bytes_get(enc, 1), 0x04)
    cki("enc_b2",  bytes_get(enc, 2), 0x05)
    cki("enc_b3",  bytes_get(enc, 3), 0xB4)
    // NOP: 01
    cki("enc_b4",  bytes_get(enc, 4), 0x01)
    // WSCALE: 03 03 07
    cki("enc_b5",  bytes_get(enc, 5), 0x03)
    cki("enc_b6",  bytes_get(enc, 6), 0x03)
    cki("enc_b7",  bytes_get(enc, 7), 0x07)
    // SACKPERM: 04 02
    cki("enc_b8",  bytes_get(enc, 8), 0x04)
    cki("enc_b9",  bytes_get(enc, 9), 0x02)

    // ── Vector 2: decode round-trip ───────────────────────────────────────────
    let dec = tcpopt_decode(enc)
    // Should produce 4 options: MSS, NOP, WSCALE, SACKPERM
    cki("dec_len", len(dec), 4)

    let opt0 = dec[0]
    cki("dec0_kind",  opt0["kind"],  2)
    cki("dec0_value", opt0["value"], 1460)

    let opt1 = dec[1]
    cki("dec1_kind", opt1["kind"], 1)

    let opt2 = dec[2]
    cki("dec2_kind",  opt2["kind"],  3)
    cki("dec2_value", opt2["value"], 7)

    let opt3 = dec[3]
    cki("dec3_kind", opt3["kind"], 4)

    // ── Vector 3: tcpopt_mss returns 1460 ────────────────────────────────────
    let mss_val = tcpopt_mss(enc)
    cki("mss", mss_val, 1460)

    // ── Vector 4: NOP-only buffer, no MSS → -1 ───────────────────────────────
    let nop_buf = bytes(0)
    nop_buf = bytes_append(nop_buf, 1)
    nop_buf = bytes_append(nop_buf, 1)
    cki("no_mss", tcpopt_mss(nop_buf), -1)

    // ── Vector 5: EOL stops decode ────────────────────────────────────────────
    let eol_buf = bytes(0)
    eol_buf = bytes_append(eol_buf, 1)
    eol_buf = bytes_append(eol_buf, 0)
    eol_buf = bytes_append(eol_buf, 1)
    let dec_eol = tcpopt_decode(eol_buf)
    // Only the NOP before EOL; the NOP after EOL is not parsed
    cki("eol_stop_len", len(dec_eol), 1)
    let eoopt = dec_eol[0]
    cki("eol_opt_kind", eoopt["kind"], 1)

    // ── Vector 6: TIMESTAMP encode+decode round-trip ─────────────────────────
    let ts_opt = {"kind": 8, "tsval": 123456789, "tsecr": 987654321}
    let ts_list = [ts_opt]
    let ts_enc = tcpopt_encode(ts_list)
    // 10 bytes: kind=08, len=0A, 4-byte tsval, 4-byte tsecr
    cki("ts_len",  bytes_len(ts_enc), 10)
    cki("ts_kind", bytes_get(ts_enc, 0), 8)
    cki("ts_olen", bytes_get(ts_enc, 1), 10)
    let ts_dec = tcpopt_decode(ts_enc)
    cki("ts_dec_count", len(ts_dec), 1)
    let ts_d = ts_dec[0]
    cki("ts_dec_kind",  ts_d["kind"],  8)
    cki("ts_dec_tsval", ts_d["tsval"], 123456789)
    cki("ts_dec_tsecr", ts_d["tsecr"], 987654321)

    // ── Vector 7: SACK encode+decode round-trip (2 blocks) ───────────────────
    let blk1 = [1000, 2000]
    let blk2 = [3000, 4000]
    let sblocks = [blk1, blk2]
    let sack_opt = {"kind": 5, "blocks": sblocks}
    let sack_list = [sack_opt]
    let sack_enc = tcpopt_encode(sack_list)
    // 2+8*2 = 18 bytes
    cki("sack_len",  bytes_len(sack_enc), 18)
    cki("sack_kind", bytes_get(sack_enc, 0), 5)
    cki("sack_olen", bytes_get(sack_enc, 1), 18)
    let sack_dec = tcpopt_decode(sack_enc)
    cki("sack_dec_count", len(sack_dec), 1)
    let sack_d = sack_dec[0]
    cki("sack_dec_kind", sack_d["kind"], 5)
    let sblks = sack_d["blocks"]
    cki("sack_dec_nblks", len(sblks), 2)
    let sb0 = sblks[0]
    cki("sack_b0_left",  sb0[0], 1000)
    cki("sack_b0_right", sb0[1], 2000)
    let sb1 = sblks[1]
    cki("sack_b1_left",  sb1[0], 3000)
    cki("sack_b1_right", sb1[1], 4000)

    // ── Vector 8: truncated buffer is safe (no crash) ─────────────────────────
    let trunc = bytes_slice(enc, 0, 3)
    let dec_trunc = tcpopt_decode(trunc)
    // Only the MSS TLV is incomplete (needs 4 bytes, but we have 3); decode stops
    // before adding MSS. Result: 0 options (bounds violation on first option).
    cki("trunc_safe", len(dec_trunc), 0)

    // ── Vector 9: empty buffer → empty decode ────────────────────────────────
    let empty_buf = bytes(0)
    let dec_empty = tcpopt_decode(empty_buf)
    cki("empty_len", len(dec_empty), 0)

    // ── Vector 10: MSS encode value boundary — MSS 536 (min typical) ─────────
    let mss536_opt = {"kind": 2, "value": 536}
    let mss536_list = [mss536_opt]
    let mss536_enc = tcpopt_encode(mss536_list)
    cki("mss536_b0", bytes_get(mss536_enc, 0), 2)
    cki("mss536_b1", bytes_get(mss536_enc, 1), 4)
    cki("mss536_b2", bytes_get(mss536_enc, 2), 0x02)
    cki("mss536_b3", bytes_get(mss536_enc, 3), 0x18)
    cki("mss536_val", tcpopt_mss(mss536_enc), 536)

    print("PASS _tcpopts_test")
