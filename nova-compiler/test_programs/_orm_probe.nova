import forge_orm

type Widget
    name: string
    qty: int

type Order
    id: int
    total: float

type Todo
    id: int
    title: string
    done: bool

fn showres(tag, r)
    if is_ok(r)
        print(tag + " OK affected=" + str(unwrap(r)))
    else
        print(tag + " ERR " + unwrap_err(r))

fn main()
    let sr = orm_open("sqlite://_orm_probe.db")
    match sr
        Ok(db) =>
            // ---- CASE 1: struct with NO id field ----
            _ = orm_exec(db, "DROP TABLE IF EXISTS Widget", [])
            showres("ensure(Widget)", orm_ensure(db, Widget("", 0)))
            showres("save(Widget bolt)", orm_save(db, Widget("bolt", 5)))
            showres("save(Widget nut)", orm_save(db, Widget("nut", 9)))
            let wcount0 = orm_count(db, "Widget", "", [])
            print("Widget count before modify/remove = " + str(wcount0))
            showres("modify(Widget)", orm_modify(db, Widget("bolt", 99)))
            showres("remove(Widget)", orm_remove(db, Widget("bolt", 5)))
            let wcount1 = orm_count(db, "Widget", "", [])
            print("Widget count after modify/remove = " + str(wcount1))

            // ---- CASE 2: SQL keyword type name (Order) ----
            _ = orm_exec(db, "DROP TABLE IF EXISTS Order", [])
            showres("ensure(Order)", orm_ensure(db, Order(0, 0.0)))
            showres("save(Order)", orm_save(db, Order(0, 12.5)))

            // ---- CASE 3: auto-id round trip + float/bool ----
            _ = orm_exec(db, "DROP TABLE IF EXISTS Todo", [])
            _ = orm_ensure(db, Todo(0, "", false))
            showres("save(Todo auto)", orm_save(db, Todo(0, "ship", true)))
            let one: Result<Todo> = orm_one(db, "SELECT * FROM Todo", [])
            match one
                Ok(t) =>
                    print("Todo assigned id=" + str(t.id) + " title=" + t.title + " done=" + str(t.done))
                    // now remove using the IN-MEMORY struct that still has id=0
                    showres("remove(Todo id=0 in-mem)", orm_remove(db, Todo(0, "ship", true)))
                    let after = orm_count(db, "Todo", "", [])
                    print("Todo count after remove(id=0) = " + str(after))
                Err(e) =>
                    print("no todo row: " + e)
            orm_close(db)
            print("PROBE DONE")
        Err(e) =>
            print("open fail: " + e)
