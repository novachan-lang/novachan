// KAT for std/bits/bitfield — bit-field extraction, deposit, and single-bit ops.
// All expected values hand-computed and cross-checked.
import std/bits/bitfield

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL bitfield " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL bitfield " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn main()
    // --- bf_mask ---
    // 4-bit mask = 0b1111 = 15
    cki("bf_mask(4)", bf_mask(4), 15)
    // 8-bit mask = 255
    cki("bf_mask(8)", bf_mask(8), 255)
    // 1-bit mask = 1
    cki("bf_mask(1)", bf_mask(1), 1)
    // 0-bit mask = 0
    cki("bf_mask(0)", bf_mask(0), 0)
    // 16-bit mask = 65535
    cki("bf_mask(16)", bf_mask(16), 65535)

    // --- bf_get ---
    // 5 = 0b101: bit0=1, bit1=0, bit2=1
    cki("bf_get(5,0)", bf_get(5, 0), 1)
    cki("bf_get(5,1)", bf_get(5, 1), 0)
    cki("bf_get(5,2)", bf_get(5, 2), 1)
    // 0 -> all bits 0
    cki("bf_get(0,0)", bf_get(0, 0), 0)
    cki("bf_get(0,7)", bf_get(0, 7), 0)
    // 8 = 0b1000: bit3=1, bit0=0
    cki("bf_get(8,3)", bf_get(8, 3), 1)
    cki("bf_get(8,0)", bf_get(8, 0), 0)

    // --- bf_set ---
    // set bit 3 of 0 -> 8
    cki("bf_set(0,3)", bf_set(0, 3), 8)
    // set bit 0 of 0 -> 1
    cki("bf_set(0,0)", bf_set(0, 0), 1)
    // set already-set bit is idempotent: bf_set(8,3)=8
    cki("bf_set(8,3)", bf_set(8, 3), 8)
    // set bit 0 of 4 (0b100) -> 5 (0b101)
    cki("bf_set(4,0)", bf_set(4, 0), 5)

    // --- bf_clear ---
    // 15 = 0b1111, clear bit 1 -> 0b1101 = 13
    cki("bf_clear(15,1)", bf_clear(15, 1), 13)
    // 0xFF, clear bit 0 -> 254
    cki("bf_clear(255,0)", bf_clear(255, 0), 254)
    // clear already-clear bit: bf_clear(0,3)=0
    cki("bf_clear(0,3)", bf_clear(0, 3), 0)
    // 0b1010=10, clear bit 3 -> 0b0010=2
    cki("bf_clear(10,3)", bf_clear(10, 3), 2)

    // --- bf_toggle ---
    // 5 = 0b101, toggle bit 1 -> 0b111 = 7
    cki("bf_toggle(5,1)", bf_toggle(5, 1), 7)
    // toggle bit 0 of 0 -> 1
    cki("bf_toggle(0,0)", bf_toggle(0, 0), 1)
    // toggle bit 0 of 1 -> 0
    cki("bf_toggle(1,0)", bf_toggle(1, 0), 0)
    // 0b1010=10, toggle bit 1 -> 0b1000=8
    cki("bf_toggle(10,1)", bf_toggle(10, 1), 8)

    // --- bf_test ---
    // 4 = 0b100: bit 2 is set
    ckb("bf_test(4,2)", bf_test(4, 2), true)
    ckb("bf_test(4,0)", bf_test(4, 0), false)
    ckb("bf_test(4,1)", bf_test(4, 1), false)
    // 0 -> no bit set
    ckb("bf_test(0,0)", bf_test(0, 0), false)
    // 1 -> bit 0 set
    ckb("bf_test(1,0)", bf_test(1, 0), true)

    // --- bf_extract ---
    // 243 = 0b11110011: bits[0..3] = 0b0011 = 3
    cki("bf_extract(243,0,4)", bf_extract(243, 0, 4), 3)
    // 243 = 0b11110011: bits[4..7] = 0b1111 = 15
    cki("bf_extract(243,4,4)", bf_extract(243, 4, 4), 15)
    // 0b10110100 = 180: bits[2..5] = 0b1101 = 13
    cki("bf_extract(180,2,4)", bf_extract(180, 2, 4), 13)
    // extract 8 bits of 0xABCD starting at bit 4 = 0xBC
    cki("bf_extract(0xABCD,4,8)", bf_extract(0xABCD, 4, 8), 0xBC)
    // extract 1 bit: same as bf_get
    cki("bf_extract(5,2,1)", bf_extract(5, 2, 1), 1)
    cki("bf_extract(5,1,1)", bf_extract(5, 1, 1), 0)

    // --- bf_deposit ---
    // deposit 5 at pos=4, len=4 into 0: 5<<4=80
    cki("bf_deposit(0,5,4,4)", bf_deposit(0, 5, 4, 4), 80)
    // deposit 0b1111=15 at pos=0, len=4 into 0: 15
    cki("bf_deposit(0,15,0,4)", bf_deposit(0, 15, 0, 4), 15)
    // deposit into existing: replace bits[0..3] of 0xFF with 0 -> 0xF0=240
    cki("bf_deposit(255,0,0,4)", bf_deposit(255, 0, 0, 4), 240)
    // replace bits[4..7] of 0xFF with 0b0101=5 -> 0b01011111=95
    cki("bf_deposit(255,5,4,4)", bf_deposit(255, 5, 4, 4), 95)
    // deposit 1 bit: same as bf_set/bf_clear
    cki("bf_deposit(0,1,3,1)", bf_deposit(0, 1, 3, 1), 8)
    cki("bf_deposit(15,0,3,1)", bf_deposit(15, 0, 3, 1), 7)

    // --- ROUND-TRIP: deposit then extract ---
    // extract(deposit(x, val, pos, len), pos, len) == val & mask(len)
    let x0 = 0
    let val0 = 5
    cki("rt-extract-deposit(5,4,4)", bf_extract(bf_deposit(x0, val0, 4, 4), 4, 4), val0)
    let x1 = 0xFF
    let val1 = 3
    cki("rt-extract-deposit(3,0,4)", bf_extract(bf_deposit(x1, val1, 0, 4), 0, 4), val1)
    cki("rt-extract-deposit(3,4,4)", bf_extract(bf_deposit(x1, val1, 4, 4), 4, 4), val1)

    // --- ROUND-TRIP: set then clear ---
    let base = 0b10100
    cki("rt-set-clear(3)", bf_clear(bf_set(base, 3), 3), base)
    cki("rt-toggle-twice(2)", bf_toggle(bf_toggle(base, 2), 2), base)

    print("PASS _bitfield_test")

main()
