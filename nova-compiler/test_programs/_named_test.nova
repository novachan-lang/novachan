// KAT test for std/color/named.
// Verifies: cn_to_rgb, cn_name, cn_is_named, cn_names.
import std/color/named

// Helper: check that an int-list [r,g,b] equals expected [er,eg,eb].
fn _ck_rgb(label: str, got: list, er: int, eg: int, eb: int)
    let r = got[0]
    let g = got[1]
    let b = got[2]
    if r != er
        print("FAIL " + label + ": r=" + str(r) + " want " + str(er))
        exit(1)
    if g != eg
        print("FAIL " + label + ": g=" + str(g) + " want " + str(eg))
        exit(1)
    if b != eb
        print("FAIL " + label + ": b=" + str(b) + " want " + str(eb))
        exit(1)

// KAT 1: cn_to_rgb("red") == [255, 0, 0]
let t1 = cn_to_rgb("red")
_ck_rgb("cn_to_rgb(red)", t1, 255, 0, 0)

// KAT 2: cn_to_rgb("white") == [255, 255, 255]
let t2 = cn_to_rgb("white")
_ck_rgb("cn_to_rgb(white)", t2, 255, 255, 255)

// KAT 3: cn_to_rgb("Black") == [0, 0, 0]  (case-insensitive)
let t3 = cn_to_rgb("Black")
_ck_rgb("cn_to_rgb(Black)", t3, 0, 0, 0)

// KAT 4: cn_to_rgb("lime") == [0, 255, 0]
let t4 = cn_to_rgb("lime")
_ck_rgb("cn_to_rgb(lime)", t4, 0, 255, 0)

// KAT 5: cn_to_rgb("navy") == [0, 0, 128]
let t5 = cn_to_rgb("navy")
_ck_rgb("cn_to_rgb(navy)", t5, 0, 0, 128)

// KAT 6: cn_to_rgb("notacolor") == [-1, -1, -1]
let t6 = cn_to_rgb("notacolor")
let t6r = t6[0]
let t6g = t6[1]
let t6b = t6[2]
if t6r != 0 - 1
    print("FAIL cn_to_rgb(notacolor): r=" + str(t6r) + " want -1")
    exit(1)
if t6g != 0 - 1
    print("FAIL cn_to_rgb(notacolor): g=" + str(t6g) + " want -1")
    exit(1)
if t6b != 0 - 1
    print("FAIL cn_to_rgb(notacolor): b=" + str(t6b) + " want -1")
    exit(1)

// KAT 7: cn_name([255,0,0]) == "red"
let namecolor = []
namecolor.push(255)
namecolor.push(0)
namecolor.push(0)
let t7 = cn_name(namecolor)
if t7 != "red"
    print("FAIL cn_name([255,0,0]): got=" + t7 + " want red")
    exit(1)

// KAT 8: cn_is_named("cyan") == true
let t8 = cn_is_named("cyan")
if t8 == false
    print("FAIL cn_is_named(cyan): expected true")
    exit(1)

// KAT 9: cn_is_named("zzz") == false
let t9 = cn_is_named("zzz")
if t9 == true
    print("FAIL cn_is_named(zzz): expected false")
    exit(1)

// KAT 10: cn_to_rgb("yellow") == [255, 255, 0]
let t10 = cn_to_rgb("yellow")
_ck_rgb("cn_to_rgb(yellow)", t10, 255, 255, 0)

// KAT 11: cn_to_rgb("NAVY") == [0, 0, 128] (uppercase input)
let t11 = cn_to_rgb("NAVY")
_ck_rgb("cn_to_rgb(NAVY)", t11, 0, 0, 128)

// KAT 12: cn_names() returns a non-empty sorted list that contains "red"
let t12 = cn_names()
if len(t12) < 10
    print("FAIL cn_names(): too few names: " + str(len(t12)))
    exit(1)
// Verify "red" is in the names list
let found_red = false
let ci = 0
while ci < len(t12)
    let nm = t12[ci]
    if nm == "red"
        found_red = true
    ci = ci + 1
if found_red == false
    print("FAIL cn_names(): red not found in names list")
    exit(1)
// Verify sorted: every adjacent pair has first <= second lexicographically.
// We check a few known ordering invariants: "black" < "blue" < "cyan"
let has_black = false
let has_blue = false
let has_cyan = false
let idx_black = 0 - 1
let idx_blue = 0 - 1
let idx_cyan = 0 - 1
let si = 0
while si < len(t12)
    let sn = t12[si]
    if sn == "black"
        has_black = true
        idx_black = si
    if sn == "blue"
        has_blue = true
        idx_blue = si
    if sn == "cyan"
        has_cyan = true
        idx_cyan = si
    si = si + 1
if has_black == false
    print("FAIL cn_names(): black not found")
    exit(1)
if has_blue == false
    print("FAIL cn_names(): blue not found")
    exit(1)
if has_cyan == false
    print("FAIL cn_names(): cyan not found")
    exit(1)
if idx_black >= idx_blue
    print("FAIL cn_names(): black not before blue in sorted list")
    exit(1)
if idx_blue >= idx_cyan
    print("FAIL cn_names(): blue not before cyan in sorted list")
    exit(1)

// KAT 13: cn_name for white
let white_c = []
white_c.push(255)
white_c.push(255)
white_c.push(255)
let t13 = cn_name(white_c)
if t13 != "white"
    print("FAIL cn_name([255,255,255]): got=" + t13 + " want white")
    exit(1)

// KAT 14: cn_is_named case-insensitive: "RED" should be recognized
let t14 = cn_is_named("RED")
if t14 == false
    print("FAIL cn_is_named(RED): expected true")
    exit(1)

print("_named_test passed")
