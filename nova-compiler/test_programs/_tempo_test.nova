import std/midi/tempo

fn main()
    // ── bpm_to_us ─────────────────────────────────────────────────────────────
    let r1 = bpm_to_us(120)
    if r1 != 500000
        print("FAIL tempo bpm_to_us(120): got " + str(r1) + " want 500000")
        exit(1)

    let r2 = bpm_to_us(60)
    if r2 != 1000000
        print("FAIL tempo bpm_to_us(60): got " + str(r2) + " want 1000000")
        exit(1)

    // ── us_to_bpm ─────────────────────────────────────────────────────────────
    let r3 = us_to_bpm(500000)
    if r3 != 120
        print("FAIL tempo us_to_bpm(500000): got " + str(r3) + " want 120")
        exit(1)

    let r4 = us_to_bpm(1000000)
    if r4 != 60
        print("FAIL tempo us_to_bpm(1000000): got " + str(r4) + " want 60")
        exit(1)

    // ── ticks_to_ms ───────────────────────────────────────────────────────────
    // 480 ticks at 480 PPQ, 500000 us/qn (120 BPM) = 500 ms
    let r5 = ticks_to_ms(480, 480, 500000)
    if r5 != 500
        print("FAIL tempo ticks_to_ms(480,480,500000): got " + str(r5) + " want 500")
        exit(1)

    // 240 ticks = half quarter = 250 ms at 120 BPM
    let r6 = ticks_to_ms(240, 480, 500000)
    if r6 != 250
        print("FAIL tempo ticks_to_ms(240,480,500000): got " + str(r6) + " want 250")
        exit(1)

    // ── beats_to_ticks ────────────────────────────────────────────────────────
    // 4 beats at 480 PPQ = 1920 ticks
    let r7 = beats_to_ticks(4, 480)
    if r7 != 1920
        print("FAIL tempo beats_to_ticks(4,480): got " + str(r7) + " want 1920")
        exit(1)

    // ── ms_to_ticks ───────────────────────────────────────────────────────────
    // 500 ms at 120 BPM (500000 us/qn), 480 PPQ = 480 ticks
    let r8 = ms_to_ticks(500, 480, 500000)
    if r8 != 480
        print("FAIL tempo ms_to_ticks(500,480,500000): got " + str(r8) + " want 480")
        exit(1)

    // ── round-trip sanity: bpm -> us -> bpm ──────────────────────────────────
    let us96 = bpm_to_us(96)
    let bpm96 = us_to_bpm(us96)
    if bpm96 != 96
        print("FAIL tempo round-trip bpm=96: got " + str(bpm96) + " want 96")
        exit(1)

    // ── round-trip: ms -> ticks -> ms ─────────────────────────────────────────
    let tk = ms_to_ticks(1000, 480, 500000)
    let ms_back = ticks_to_ms(tk, 480, 500000)
    if ms_back != 1000
        print("FAIL tempo round-trip ms=1000: got " + str(ms_back) + " want 1000")
        exit(1)

    print("PASS _tempo_test")
