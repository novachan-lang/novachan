import std/game/maze_solve_bfs

// Build a hand-crafted 3x3 maze (w=3, h=3, 9 cells, 8 passages = spanning tree).
//
// Cell layout:
//   0 1 2
//   3 4 5
//   6 7 8
//
// Passages (spanning tree, 8 edges):
//   0-1, 1-2, 2-5, 5-8, 5-4, 4-3, 3-6, 6-7
//
// Shortest path 0->8: 0->1->2->5->8 (4 steps, length 5 list).

fn _make_3x3_maze()
    // 9 empty lists
    let links = []
    let i = 0
    while i < 9
        let cl = []
        push(links, cl)
        i = i + 1

    // Carve passage between a and b (bidirectional)
    // 0-1
    push(links[0], 1)
    push(links[1], 0)
    // 1-2
    push(links[1], 2)
    push(links[2], 1)
    // 2-5
    push(links[2], 5)
    push(links[5], 2)
    // 5-8
    push(links[5], 8)
    push(links[8], 5)
    // 5-4
    push(links[5], 4)
    push(links[4], 5)
    // 4-3
    push(links[4], 3)
    push(links[3], 4)
    // 3-6
    push(links[3], 6)
    push(links[6], 3)
    // 6-7
    push(links[6], 7)
    push(links[7], 6)

    return links

// Build an empty-links maze (no passages) for unreachable test.
fn _make_empty_maze(n)
    let links = []
    let i = 0
    while i < n
        let cl = []
        push(links, cl)
        i = i + 1
    return links

fn main()
    let links = _make_3x3_maze()

    // Test 1: path from 0 to 8 exists and is valid.
    let path = solve_bfs(links, 0, 8)
    let plen = len(path)
    if plen == 0
        print("FAIL maze_solve_bfs path_exists: got empty path")
        exit(1)

    // First cell must be 0.
    if path[0] != 0
        print("FAIL maze_solve_bfs path_start: got " + str(path[0]) + " want 0")
        exit(1)

    // Last cell must be 8.
    if path[plen - 1] != 8
        print("FAIL maze_solve_bfs path_end: got " + str(path[plen - 1]) + " want 8")
        exit(1)

    // is_valid_path must be true.
    let vp = is_valid_path(links, path)
    if vp != 1
        print("FAIL maze_solve_bfs is_valid_path: returned 0")
        exit(1)

    // Shortest path: 0->1->2->5->8 = length 4 (5 cells).
    // path_length returns 4.
    let pl = path_length(links, 0, 8)
    if pl != 4
        print("FAIL maze_solve_bfs path_length: got " + str(pl) + " want 4")
        exit(1)

    // Verify the actual path matches the known shortest path.
    if plen != 5
        print("FAIL maze_solve_bfs path_size: got " + str(plen) + " want 5")
        exit(1)

    // Check exact sequence: [0,1,2,5,8]
    let expect = []
    push(expect, 0)
    push(expect, 1)
    push(expect, 2)
    push(expect, 5)
    push(expect, 8)
    let seq_ok = 1
    let si = 0
    while si < 5
        if path[si] != expect[si]
            seq_ok = 0
        si = si + 1
    if seq_ok != 1
        print("FAIL maze_solve_bfs path_sequence: path does not match [0,1,2,5,8]")
        exit(1)

    // Test 2: unreachable — empty links, solve_bfs(_, 0, 8) -> [].
    let empty = _make_empty_maze(9)
    let epath = solve_bfs(empty, 0, 8)
    if len(epath) != 0
        print("FAIL maze_solve_bfs unreachable: got non-empty path on empty links")
        exit(1)
    let epl = path_length(empty, 0, 8)
    if epl != -1
        print("FAIL maze_solve_bfs unreachable path_length: got " + str(epl) + " want -1")
        exit(1)

    // Test 3: solve_bfs(links, 0, 0) == [0].
    let self_path = solve_bfs(links, 0, 0)
    if len(self_path) != 1
        print("FAIL maze_solve_bfs self_path_len: got " + str(len(self_path)) + " want 1")
        exit(1)
    if self_path[0] != 0
        print("FAIL maze_solve_bfs self_path_val: got " + str(self_path[0]) + " want 0")
        exit(1)
    let self_pl = path_length(links, 0, 0)
    if self_pl != 0
        print("FAIL maze_solve_bfs self_path_length: got " + str(self_pl) + " want 0")
        exit(1)

    // Test 4: is_valid_path on an invalid path (cells not connected).
    let bad_path = []
    push(bad_path, 0)
    push(bad_path, 8)
    let bvp = is_valid_path(links, bad_path)
    if bvp != 0
        print("FAIL maze_solve_bfs invalid_path: is_valid_path returned 1 for disconnected path")
        exit(1)

    // Test 5: is_valid_path on empty path -> 0.
    let empty_path = []
    let evp = is_valid_path(links, empty_path)
    if evp != 0
        print("FAIL maze_solve_bfs empty_path: is_valid_path returned 1 for empty path")
        exit(1)

    // Test 6: path to adjacent cell (0->1), length 1.
    let short_path = solve_bfs(links, 0, 1)
    if len(short_path) != 2
        print("FAIL maze_solve_bfs short_path_len: got " + str(len(short_path)) + " want 2")
        exit(1)
    if path_length(links, 0, 1) != 1
        print("FAIL maze_solve_bfs short_path_length: got " + str(path_length(links, 0, 1)) + " want 1")
        exit(1)

    print("PASS _maze_solve_bfs_test")
