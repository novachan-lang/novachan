fn main()
    let sum = 0
    for i in 0..5
        sum = sum + i
    assert(sum == 10, "0..5 sum should be 10")

    let items = []
    for i in 1..4
        push(items, i)
    assert(len(items) == 3, "1..4 should have 3 items")
    assert(items[0] == 1, "first is 1")
    assert(items[2] == 3, "last is 3")

    print("range_test: all passed")
