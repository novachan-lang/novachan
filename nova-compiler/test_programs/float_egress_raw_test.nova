// #13 S1 pre-flight for S2: push RAW float-typed values (the kind a promoted floatlist
// read would yield) through EVERY any-sink, WITHOUT enabling promotion. This validates
// box-on-egress completeness safely — if a sink mishandles a raw float here, S2 would
// have corrupted there (the 06-20 failure mode). Must pass before S2 is attempted.

type FP
    a: float
    b: float

fn take_any(v)
    v

fn id2(v)
    take_any(v)

fn main()
    let f = 1.0 + 0.5      // raw float 1.5 (typed "float", not boxed)
    let g = 2.0 + 0.5      // raw float 2.5

    // sink: call-arg bound to an any/val parameter (the 06-20 corruptor)
    assert(take_any(f) == 1.5, "raw float through any param")
    // sink: nested return-through-any
    assert(id2(f) == 1.5, "raw float through nested any return")

    // sink: cross-block comparison + phi
    if f > 1.0
        assert(f == 1.5, "raw float comparison-true branch")
    else
        assert(1 == 0, "raw float wrong branch")
    let m = 0.0
    if g > 2.0
        m = f
    else
        m = g
    assert(m == 1.5, "raw float through phi merge")

    // sink: index_set of a raw float into a plain (any) list
    let xs = []
    push(xs, 0)
    xs[0] = f
    assert(xs[0] == 1.5, "raw float index_set into any list")

    // sink: struct field store (both fields)
    let p = FP { a: f, b: g }
    assert(p.a == 1.5, "raw float struct field a")
    assert(p.b == 2.5, "raw float struct field b")
    // sink: field_set after construction
    p.a = g
    assert(p.a == 2.5, "raw float field_set")

    // sink: dict value
    let d = {}
    d["k"] = f
    assert(d["k"] == 1.5, "raw float dict value")

    // sink: make_list element + read back
    let lst = []
    push(lst, f)
    push(lst, g)
    assert(lst[0] == 1.5, "raw float make_list elem 0")
    assert(lst[1] == 2.5, "raw float make_list elem 1")

    // sink: any-float compared against raw-float
    let af = take_any(f)
    assert(af == f, "any-boxed float == raw float")

    // sink: arithmetic chain through any and back
    let s = take_any(f) + take_any(g)
    assert(s == 4.0, "sum through any params = 4.0")

    print("float_egress_raw_test: all passed")
