import forge_morton

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn main()
    let fails = 0

    // known small codes: interleave x(even bits) and y(odd bits)
    fails = fails + expect("enc_00", str(morton_encode(0, 0)), "0")
    fails = fails + expect("enc_10", str(morton_encode(1, 0)), "1")
    fails = fails + expect("enc_01", str(morton_encode(0, 1)), "2")
    fails = fails + expect("enc_11", str(morton_encode(1, 1)), "3")
    fails = fails + expect("enc_20", str(morton_encode(2, 0)), "4")
    fails = fails + expect("enc_35", str(morton_encode(3, 5)), "39")

    // decode is the inverse
    let d = morton_decode(39)
    fails = fails + expect("dec_39", str(d[0]) + "," + str(d[1]), "3,5")
    fails = fails + expect("morton_x", str(morton_x(39)), "3")
    fails = fails + expect("morton_y", str(morton_y(39)), "5")

    // roundtrip over a range of coordinates
    let rt_ok = true
    let x = 0
    while x < 40
        let y = 0
        while y < 40
            let code = morton_encode(x, y)
            let dd = morton_decode(code)
            if dd[0] != x or dd[1] != y
                rt_ok = false
            y = y + 3
        x = x + 3
    fails = fails + expect_true("roundtrip", rt_ok)

    // large coordinates near the 16-bit edge
    let big = morton_encode(65535, 65535)
    let dbig = morton_decode(big)
    fails = fails + expect("big_roundtrip", str(dbig[0]) + "," + str(dbig[1]), "65535,65535")

    // locality: (5,5) and (5,6) codes differ by less than (5,5) and (50,50)
    let near1 = morton_encode(5, 5)
    let near2 = morton_encode(5, 6)
    let far = morton_encode(50, 50)
    let dnear = near2 - near1
    if dnear < 0
        dnear = 0 - dnear
    let dfar = far - near1
    if dfar < 0
        dfar = 0 - dfar
    fails = fails + expect_true("locality", dnear < dfar)

    if fails == 0
        print("forge_morton: all passed")
    else
        print("forge_morton: " + str(fails) + " FAILED")
