import forge_protocol_adapter

fn main()
    let pa = pa_new()
    pa = pa_register(pa, "mqtt2http", "mqtt", "http")
    pa = pa_register(pa, "grpc2rest", "grpc", "rest")
    assert(pa_adapter_count(pa) == 2, "2 adapters")

    let t1 = pa_transform(pa, "mqtt2http", "sensor_data:42")
    pa = unwrap(t1)
    let t2 = pa_transform(pa, "mqtt2http", "temp:25")
    pa = unwrap(t2)
    assert(pa_message_count(pa) == 2, "2 messages")
    assert(pa_transform_count(pa) == 2, "2 transforms")

    let lr = pa_last_result(pa)
    assert(unwrap(lr) == "[http]temp:25", "last result")

    let am = pa_adapter_messages(pa, "mqtt2http")
    assert(unwrap(am) == 2, "mqtt2http 2 msgs")

    let t3 = pa_transform(pa, "grpc2rest", "call:GetUser")
    pa = unwrap(t3)
    let am2 = pa_adapter_messages(pa, "grpc2rest")
    assert(unwrap(am2) == 1, "grpc2rest 1 msg")

    let e1 = pa_record_error(pa, "mqtt2http", "timeout")
    pa = unwrap(e1)
    assert(pa_error_count(pa) == 1, "1 error")
    let ae = pa_adapter_errors(pa, "mqtt2http")
    assert(unwrap(ae) == 1, "mqtt2http 1 error")

    let sp = pa_source_proto(pa, "mqtt2http")
    assert(unwrap(sp) == "mqtt", "source mqtt")
    let tp = pa_target_proto(pa, "mqtt2http")
    assert(unwrap(tp) == "http", "target http")

    let bad = pa_transform(pa, "nope", "data")
    assert(is_err(bad), "unknown adapter")

    print("PROTOCOL-ADAPTER KAT PASS")
