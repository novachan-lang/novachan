import std/data/geojson_parse

fn q() -> string
    chr(34)

fn ob() -> string
    chr(123)

fn cb() -> string
    chr(125)

fn main() -> int
    let fails = []

    // Unicode content in a PRECEDING unrelated field (not inside "type" value
    // itself), with a recognized type so dispatch goes through the real
    // LineString path -- the genuine desync-stress scenario.
    let cafe = "caf" + from_codepoint(233)
    let emoji = from_codepoint(128512) + from_codepoint(128512)
    let j1 = ob() + q() + "name" + q() + ":" + q() + cafe + emoji + q() + "," + q() + "type" + q() + ":" + q() + "LineString" + q() + "," + q() + "coordinates" + q() + ":[[-1.5,-2.5],[-3.5,-4.5],[9.25,-9.25]]" + cb()
    let r1 = geojson_parse(j1)
    if r1["type"] != "LineString"
        push(fails, "unicode_prefix_type: got=" + r1["type"])
    let c1 = r1["coordinates"]
    if not (len(c1) == 3)
        push(fails, "unicode_prefix_coords_len: got_len=" + str(len(c1)))
    else
        if not (c1[0][0] == -1.5 and c1[0][1] == -2.5 and c1[1][0] == -3.5 and c1[1][1] == -4.5 and c1[2][0] == 9.25 and c1[2][1] == -9.25)
            push(fails, "unicode_prefix_coords_values")

    // Same but Polygon, with unicode inside the type-key's SIBLING string
    // field that appears between "type" and "coordinates" in the source.
    let j2 = ob() + q() + "type" + q() + ":" + q() + "Polygon" + q() + "," + q() + "note" + q() + ":" + q() + emoji + cafe + q() + "," + q() + "coordinates" + q() + ":[[[0.0,0.0],[2.0,0.0],[2.0,2.0],[0.0,0.0]]]" + cb()
    let r2 = geojson_parse(j2)
    // NOTE: coordinates lookup is purely positional (first '[' after the
    // literal "coordinates": key), so a sibling field AFTER "type" but
    // BEFORE "coordinates" should not matter -- but let's verify.
    if r2["type"] != "Polygon"
        push(fails, "sibling_unicode_type: got=" + r2["type"])
    let c2 = r2["coordinates"]
    if not (len(c2) == 1 and len(c2[0]) == 4)
        push(fails, "sibling_unicode_shape")
    else
        if not (c2[0][2][0] == 2.0 and c2[0][2][1] == 2.0)
            push(fails, "sibling_unicode_values")

    if len(fails) == 0
        print("GEOJSON-ADV3 KAT PASS")
    else
        print("GEOJSON-ADV3 KAT FAIL: " + join(fails, ", "))
    0
