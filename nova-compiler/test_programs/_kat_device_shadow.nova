import forge_device_shadow

fn main()
    let s = ds_new()
    assert(ds_device_count(s) == 0, "0 devices")
    assert(ds_has_device(s, "sensor-1") == 0, "no sensor-1 yet")

    s = ds_create(s, "sensor-1")
    s = ds_create(s, "sensor-2")
    assert(ds_device_count(s) == 2, "2 devices")
    assert(ds_has_device(s, "sensor-1") == 1, "has sensor-1")

    let sd = ds_set_desired(s, "sensor-1", "brightness", "80")
    assert(is_ok(sd), "set desired ok")
    let sr = ds_set_reported(s, "sensor-1", "brightness", "60")
    assert(is_ok(sr), "set reported ok")

    let sdm = ds_set_desired(s, "missing", "x", "1")
    assert(is_err(sdm), "set desired missing device errs")

    let gd = ds_get_desired(s, "sensor-1", "brightness")
    assert(is_ok(gd), "get desired ok")
    assert(unwrap(gd) == "80", "desired = 80")

    let gr = ds_get_reported(s, "sensor-1", "brightness")
    assert(is_ok(gr), "get reported ok")
    assert(unwrap(gr) == "60", "reported = 60")

    let gm = ds_get_desired(s, "sensor-1", "nope")
    assert(is_err(gm), "get desired missing key errs")

    let sync1 = ds_is_synced(s, "sensor-1", "brightness")
    assert(is_ok(sync1), "synced check ok")
    assert(unwrap(sync1) == 0, "not synced (80 != 60)")

    let sr2 = ds_set_reported(s, "sensor-1", "brightness", "80")
    assert(is_ok(sr2), "set reported 80 ok")
    let sync2 = ds_is_synced(s, "sensor-1", "brightness")
    assert(unwrap(sync2) == 1, "now synced")

    let sd2 = ds_set_desired(s, "sensor-1", "mode", "auto")
    assert(is_ok(sd2), "set desired mode ok")
    let dc = ds_delta_count(s, "sensor-1")
    assert(is_ok(dc), "delta count ok")
    assert(unwrap(dc) == 1, "1 delta (mode has no reported yet)")

    let sr3 = ds_set_reported(s, "sensor-1", "mode", "auto")
    assert(is_ok(sr3), "set reported mode ok")
    let dc2 = ds_delta_count(s, "sensor-1")
    assert(unwrap(dc2) == 0, "0 deltas once mode synced")

    let dcm = ds_delta_count(s, "missing")
    assert(is_err(dcm), "delta count missing device errs")

    print("DEVICE-SHADOW KAT PASS")
