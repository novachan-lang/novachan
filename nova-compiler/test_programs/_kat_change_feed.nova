import forge_change_feed

fn main()
    let c = cf_new()
    c = cf_append(c, "users", "INSERT", "u1", "alice")
    c = cf_append(c, "users", "UPDATE", "u1", "alice2")
    c = cf_append(c, "orders", "INSERT", "o1", "order1")
    assert(cf_total_changes(c) == 3, "3 changes")

    let sub = cf_subscribe(c, "worker-1")
    assert(is_ok(sub), "subscribe ok")
    c = unwrap(sub)
    assert(cf_consumer_count(c) == 1, "1 consumer")

    let dup = cf_subscribe(c, "worker-1")
    assert(is_err(dup), "duplicate subscribe is err")

    let p1 = cf_poll(c, "worker-1")
    assert(is_ok(p1), "poll 1 ok")
    let msg = unwrap(p1)
    assert(msg == "users:INSERT:u1", "first change")

    let lag = cf_lag(c, "worker-1")
    assert(is_ok(lag), "lag ok")

    let bad = cf_poll(c, "unknown")
    assert(is_err(bad), "unknown consumer is err")

    print("CHANGE-FEED KAT PASS")
