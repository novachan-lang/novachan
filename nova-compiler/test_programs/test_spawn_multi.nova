fn compute(ch: channel, n: int)
    let result = n * n * n
    send(ch, result)

fn main()
    let ch = channel()
    spawn compute(ch, 3)
    spawn compute(ch, 4)
    spawn compute(ch, 5)

    let total = 0
    let i = 0
    while i < 3
        let val = receive(ch)
        total = total + val
        i = i + 1

    print("total: " + str(total))
    assert(total == 216, "expected 27+64+125=216")
    print("MULTI SPAWN PASSED")
