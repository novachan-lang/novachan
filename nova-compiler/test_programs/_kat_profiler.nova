import forge_profiler

fn main()
    let p = prof_new()
    p = prof_register(p, "parse")
    p = prof_register(p, "compile")
    p = prof_register(p, "link")
    assert(prof_fn_count(p) == 3, "3 fns")

    p = prof_enter(p, "parse", 100)
    let r1 = prof_exit(p, "parse", 150)
    assert(is_ok(r1), "exit ok")
    p = unwrap(r1)

    p = prof_enter(p, "parse", 200)
    let r2 = prof_exit(p, "parse", 280)
    p = unwrap(r2)

    p = prof_enter(p, "compile", 300)
    let r3 = prof_exit(p, "compile", 600)
    p = unwrap(r3)

    p = prof_enter(p, "link", 700)
    let r4 = prof_exit(p, "link", 720)
    p = unwrap(r4)

    assert(prof_total_samples(p) == 4, "4 samples")

    let c1 = prof_calls(p, "parse")
    assert(unwrap(c1) == 2, "parse 2 calls")

    let t1 = prof_total_time(p, "parse")
    assert(unwrap(t1) == 130, "parse total 130")

    let a1 = prof_avg_time(p, "parse")
    assert(unwrap(a1) == 65, "parse avg 65")

    let mn1 = prof_min_time(p, "parse")
    assert(unwrap(mn1) == 50, "parse min 50")

    let mx1 = prof_max_time(p, "parse")
    assert(unwrap(mx1) == 80, "parse max 80")

    let hot = prof_hotspot(p)
    assert(unwrap(hot) == "compile", "hotspot=compile")

    let pct = prof_pct(p, "compile")
    assert(is_ok(pct), "pct ok")
    let pct_val = unwrap(pct)
    assert(pct_val > 50, "compile >50%")

    let rpt = prof_report(p, "parse")
    assert(is_ok(rpt), "report ok")

    let rall = prof_report_all(p)
    assert(len(rall) > 0, "report non-empty")

    let bad = prof_exit(p, "nope", 999)
    assert(is_err(bad), "unknown fn")

    let bad2 = prof_calls(p, "nope")
    assert(is_err(bad2), "unknown calls")

    print("PROFILER KAT PASS")
