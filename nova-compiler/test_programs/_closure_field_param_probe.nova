// The exact shape forge uses: a typed fn PARAMETER whose struct type declares a
// closure field, called directly off the parameter. This exercises a different
// receiver-type resolution path than a `let`-bound local.
type Conn
    cid: int
    recv_fn: any
    send_fn: any

fn pump(c: Conn) -> int
    let got = c.recv_fn()
    c.send_fn(got + 1)

fn nested(c: Conn) -> int
    // chained/nested use inside an expression, plus a second call in one fn
    let a = c.recv_fn()
    let b = c.recv_fn()
    a + b

fn main()
    let c = Conn(7, fn() 20, fn(v) v * 2)
    print(pump(c))
    print(nested(c))
