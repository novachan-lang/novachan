// KAT for std/functional/fzipwith — zip-with combinators
import std/functional/fzipwith

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckl(label: string, got: list, want: list)
    let gl = len(got)
    let wl = len(want)
    if gl != wl
        print("FAIL " + label + ": len got " + str(gl) + " want " + str(wl))
        exit(1)
    let i = 0
    while i < wl
        if got[i] != want[i]
            print("FAIL " + label + "[" + str(i) + "]: got " + str(got[i]) + " want " + str(want[i]))
            exit(1)
        i = i + 1

fn add(a, b)
    a + b

fn mul(a, b)
    a * b

fn add3(a, b, c)
    a + b + c

fn idx_times10(i, v)
    i * 10 + v

fn main()
    // --- fz_zip_with ---
    ckl("zip_with add [1,2,3] [4,5,6]", fz_zip_with(add, [1, 2, 3], [4, 5, 6]), [5, 7, 9])
    ckl("zip_with mul [1,2,3] [4,5]", fz_zip_with(mul, [1, 2, 3], [4, 5]), [4, 10])
    ckl("zip_with add [] [1]", fz_zip_with(add, [], [1]), [])
    ckl("zip_with add [1] []", fz_zip_with(add, [1], []), [])
    ckl("zip_with add [] []", fz_zip_with(add, [], []), [])
    ckl("zip_with add [1,2] [10,20]", fz_zip_with(add, [1, 2], [10, 20]), [11, 22])
    ckl("zip_with mul longer left", fz_zip_with(mul, [1, 2, 3, 4], [10, 10]), [10, 20])

    // --- fz_zip_with3 ---
    ckl("zip_with3 [1,2] [3,4] [5,6]", fz_zip_with3(add3, [1, 2], [3, 4], [5, 6]), [9, 12])
    ckl("zip_with3 truncate to shortest", fz_zip_with3(add3, [1, 2, 3], [10, 20], [100, 200, 300]), [111, 222])
    ckl("zip_with3 empty", fz_zip_with3(add3, [], [1], [2]), [])
    ckl("zip_with3 single", fz_zip_with3(add3, [5], [3], [2]), [10])

    // --- fz_zip_with_index ---
    // idx_times10(i, v) = i*10 + v
    // [7,8,9] -> [0*10+7, 1*10+8, 2*10+9] = [7, 18, 29]
    ckl("zip_with_index [7,8,9]", fz_zip_with_index(idx_times10, [7, 8, 9]), [7, 18, 29])
    ckl("zip_with_index []", fz_zip_with_index(idx_times10, []), [])
    ckl("zip_with_index [42]", fz_zip_with_index(idx_times10, [42]), [42])
    // [0,0,0] -> [0,10,20]
    ckl("zip_with_index [0,0,0]", fz_zip_with_index(idx_times10, [0, 0, 0]), [0, 10, 20])

    print("PASS _fzipwith_test")

main()
