// KAT for std/text/bbcode_quote
import std/text/bbcode_quote

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got [" + got + "] want [" + want + "]")
        exit(1)

fn main()
    // KAT-1: build with author
    cks("build-with-author", bquo_build("Hello", "Alice"), "[quote=Alice]Hello[/quote]")

    // KAT-2: build without author (bare form)
    cks("build-no-author", bquo_build("Hello", ""), "[quote]Hello[/quote]")

    // KAT-3: extract a single quote with an author
    let q1 = bquo_extract_quotes("[quote=Alice]Hi there[/quote]")
    cki("q1-count", len(q1), 1)
    let q1a = q1[0]
    cks("q1-author", q1a["author"], "Alice")
    cks("q1-text", q1a["text"], "Hi there")

    // KAT-4: extract a single bare quote (no author)
    let q2 = bquo_extract_quotes("[quote]Just text[/quote]")
    cki("q2-count", len(q2), 1)
    let q2a = q2[0]
    cks("q2-author", q2a["author"], "")
    cks("q2-text", q2a["text"], "Just text")

    // KAT-5: nested quotes — inner quote is emitted before the outer one,
    // and the outer's text includes the inner's raw markup.
    let nested = "[quote=Alice]Hi [quote=Bob]there[/quote] friend[/quote]"
    let q3 = bquo_extract_quotes(nested)
    cki("q3-count", len(q3), 2)
    let q3_inner = q3[0]
    cks("q3-inner-author", q3_inner["author"], "Bob")
    cks("q3-inner-text", q3_inner["text"], "there")
    let q3_outer = q3[1]
    cks("q3-outer-author", q3_outer["author"], "Alice")
    cks("q3-outer-text", q3_outer["text"], "Hi [quote=Bob]there[/quote] friend")

    // KAT-6: depth of a single (non-nested) quote is 1
    cki("depth-single", bquo_depth("[quote]a[/quote]"), 1)

    // KAT-7: depth of the two-level nested example is 2
    cki("depth-nested", bquo_depth(nested), 2)

    // KAT-8: depth of plain text with no quotes is 0
    cki("depth-none", bquo_depth("plain text"), 0)

    // KAT-9: flatten strips all quote tags at every nesting level
    cks("flatten-nested", bquo_flatten(nested), "Hi there friend")

    // KAT-10: an unmatched opening tag (no closing "[/quote]") yields no entry
    let q4 = bquo_extract_quotes("[quote=Alice]no closing tag here")
    cki("unmatched-count", len(q4), 0)

    print("PASS _bbcode_quote_test")
