import std/vector/vec_distance

fn cki(label: string, got: int, want: int)
    if got == want
        return
    print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
    exit(1)

fn main()
    // vds_l2_sq([1,2],[4,6]) = (4-1)^2 + (6-2)^2 = 9+16 = 25
    cki("l2sq_1", vds_l2_sq([1, 2], [4, 6]), 25)
    // vds_l1([1,2],[4,6]) = |4-1|+|6-2| = 3+4 = 7
    cki("l1_1", vds_l1([1, 2], [4, 6]), 7)
    // vds_linf([1,2],[4,6]) = max(3,4) = 4
    cki("linf_1", vds_linf([1, 2], [4, 6]), 4)
    // vds_l2_sq([0,0,0],[1,2,2]) = 1+4+4 = 9
    cki("l2sq_2", vds_l2_sq([0, 0, 0], [1, 2, 2]), 9)
    // vds_l1([0,0],[0,0]) = 0
    cki("l1_zero", vds_l1([0, 0], [0, 0]), 0)
    // vds_linf([1,5,3],[2,1,9]) = max(|1|,|4|,|6|) = 6
    cki("linf_2", vds_linf([1, 5, 3], [2, 1, 9]), 6)
    // additional: empty vectors
    cki("l2sq_empty", vds_l2_sq([], []), 0)
    cki("l1_empty", vds_l1([], []), 0)
    cki("linf_empty", vds_linf([], []), 0)
    // negative coordinates
    cki("l2sq_neg", vds_l2_sq([-1, -2], [1, 2]), 20)
    cki("l1_neg", vds_l1([-3, 0], [3, 0]), 6)
    cki("linf_neg", vds_linf([-5, 2], [5, -2]), 10)
    print("PASS _vec_distance_test")
