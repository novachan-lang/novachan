// KAT for std/net/stomp_build — STOMP 1.2 frame builder.
import std/net/stomp_build
import std/net/stomp_frame

// ── Assert helpers ───────────────────────────────────────────────────────────

fn assert_s(label: string, got: string, want: string)
    if got != want
        print("FAIL stomp_build " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn assert_i(label: string, got: int, want: int)
    if got != want
        print("FAIL stomp_build " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ── Helper: decode byte-list to ASCII string (stop at NUL) ──────────────────

fn bytes_to_str_full(bl: list) -> string
    let n = len(bl)
    let s = ""
    let i = 0
    while i < n
        let b = bl[i]
        s = s + chr(b)
        i = i + 1
    s

// ── KAT 1: stomp_build("SEND", [["destination", "/q"]], "hi") ───────────────
// Expected byte-list decodes to: "SEND\ndestination:/q\n\nhi\0"
// where \n=chr(10) and \0=chr(0)

fn main()
    let hpairs = []
    let pair1 = []
    push(pair1, "destination")
    push(pair1, "/q")
    push(hpairs, pair1)

    let frame1 = stomp_build("SEND", hpairs, "hi")

    // Verify the length: "SEND"(4) + LF(1) + "destination:/q"(14) + LF(1) + LF(1) + "hi"(2) + NUL(1) = 24
    assert_i("build-len", len(frame1), 24)

    // Verify specific bytes:
    // frame1[0..3] = 83,69,78,68 ("SEND")
    assert_i("byte-S", frame1[0], 83)
    assert_i("byte-E", frame1[1], 69)
    assert_i("byte-N", frame1[2], 78)
    assert_i("byte-D", frame1[3], 68)
    // frame1[4] = LF(10)
    assert_i("byte-lf1", frame1[4], 10)
    // "destination" starts at 5: d=100
    assert_i("byte-dest-d", frame1[5], 100)
    // colon at position 5+11=16: ':'=58
    assert_i("byte-colon", frame1[16], 58)
    // "/q" after colon: /=47, q=113
    assert_i("byte-slash", frame1[17], 47)
    assert_i("byte-q",     frame1[18], 113)
    // LF after header value: position 19
    assert_i("byte-lf2", frame1[19], 10)
    // blank LF: position 20
    assert_i("byte-lf3", frame1[20], 10)
    // body "hi": h=104, i=105
    assert_i("byte-h", frame1[21], 104)
    assert_i("byte-i", frame1[22], 105)
    // NUL: position 23
    assert_i("byte-nul", frame1[23], 0)

    // Verify full ASCII decoding equals expected string
    let expected = "SEND" + chr(10) + "destination:/q" + chr(10) + chr(10) + "hi" + chr(0)
    let decoded = bytes_to_str_full(frame1)
    assert_s("full-decode", decoded, expected)

    // ── KAT 2: round-trip — stomp_frame_parse(stomp_build(...)) ──────────────
    let rt = stomp_frame_parse(frame1)
    assert_s("rt-command", rt["command"], "SEND")
    let rth = rt["headers"]
    assert_s("rt-dest", rth["destination"], "/q")
    assert_s("rt-body", rt["body"], "hi")

    // ── KAT 3: build with no headers ─────────────────────────────────────────
    let empty_pairs = []
    let frame2 = stomp_build("DISCONNECT", empty_pairs, "")
    // "DISCONNECT"(10) + LF(1) + LF(1) + NUL(1) = 13
    assert_i("no-hdr-len", len(frame2), 13)
    // Last byte is NUL
    assert_i("no-hdr-nul", frame2[12], 0)
    // Round-trip
    let rt2 = stomp_frame_parse(frame2)
    assert_s("no-hdr-command", rt2["command"], "DISCONNECT")
    assert_s("no-hdr-body", rt2["body"], "")

    // ── KAT 4: build with multiple headers ───────────────────────────────────
    let mpairs = []
    let mp1 = []
    push(mp1, "destination")
    push(mp1, "/topic/news")
    push(mpairs, mp1)
    let mp2 = []
    push(mp2, "content-type")
    push(mp2, "text/plain")
    push(mpairs, mp2)

    let frame3 = stomp_build("SEND", mpairs, "hello world")
    let rt3 = stomp_frame_parse(frame3)
    assert_s("multi-hdr-command", rt3["command"], "SEND")
    let rt3h = rt3["headers"]
    assert_s("multi-hdr-dest", rt3h["destination"], "/topic/news")
    assert_s("multi-hdr-ctype", rt3h["content-type"], "text/plain")
    assert_s("multi-hdr-body", rt3["body"], "hello world")

    // ── KAT 5: CONNECT frame round-trip ──────────────────────────────────────
    let cpairs = []
    let cp1 = []
    push(cp1, "accept-version")
    push(cp1, "1.2")
    push(cpairs, cp1)
    let cp2 = []
    push(cp2, "host")
    push(cp2, "stomp.example.com")
    push(cpairs, cp2)

    let frame4 = stomp_build("CONNECT", cpairs, "")
    let rt4 = stomp_frame_parse(frame4)
    assert_s("conn-command", rt4["command"], "CONNECT")
    let rt4h = rt4["headers"]
    assert_s("conn-version", rt4h["accept-version"], "1.2")
    assert_s("conn-host", rt4h["host"], "stomp.example.com")
    assert_s("conn-body", rt4["body"], "")

    print("PASS _stomp_build_test")
