import forge_svg

// Count non-overlapping occurrences of `needle` in `hay` (simple substring scan; test-only helper).
fn count_occ(hay: string, needle: string) -> int
    let n = 0
    let i = 0
    let hlen = len(hay)
    let nlen = len(needle)
    while i + nlen <= hlen
        if slice(hay, i, i + nlen) == needle
            n = n + 1
            i = i + nlen
        else
            i = i + 1
    n

fn main()
    let bar_data = [
        {"label": "Jan", "value": 12},
        {"label": "Feb", "value": 30},
        {"label": "Mar", "value": 7},
        {"label": "Apr", "value": -5}
    ]
    let bar_opts = {"title": "Monthly", "width": 400, "height": 260}
    let bar_svg = svg_bar_chart(bar_data, bar_opts)
    print("bar_has_svg=" + str(bar_svg.contains("<svg")))
    print("bar_rect_count=" + str(count_occ(bar_svg, "<rect")) + " want=" + str(len(bar_data)))
    print("bar_ok=" + str(bar_svg.contains("<svg") and count_occ(bar_svg, "<rect") == len(bar_data)))

    let line_data = [
        {"x": 0, "y": 3.5},
        {"x": 1, "y": 8.0},
        {"x": 2, "y": 2.0},
        {"x": 3, "y": 9.5},
        {"x": 4, "y": 6.0}
    ]
    let line_opts = {"title": "Trend", "width": 400, "height": 240}
    let line_svg = svg_line_chart(line_data, line_opts)
    print("line_has_svg=" + str(line_svg.contains("<svg")))
    print("line_has_polyline=" + str(line_svg.contains("<polyline")))
    print("line_circle_count=" + str(count_occ(line_svg, "<circle")) + " want=" + str(len(line_data)))
    print("line_ok=" + str(line_svg.contains("<svg") and line_svg.contains("<polyline") and count_occ(line_svg, "<circle") == len(line_data)))

    let pie_data = [
        {"label": "A", "value": 40},
        {"label": "B", "value": 25},
        {"label": "C", "value": 35}
    ]
    let pie_opts = {"title": "Share", "width": 300, "height": 300}
    let pie_svg = svg_pie_chart(pie_data, pie_opts)
    print("pie_has_svg=" + str(pie_svg.contains("<svg")))
    print("pie_path_count=" + str(count_occ(pie_svg, "<path")) + " want=" + str(len(pie_data)))
    print("pie_ok=" + str(pie_svg.contains("<svg") and count_occ(pie_svg, "<path") == len(pie_data)))

    // single-slice pie -> renders as one <circle>, not a degenerate <path>
    let pie1 = [{"label": "All", "value": 10}]
    let pie1_svg = svg_pie_chart(pie1, {})
    print("pie1_circle=" + str(count_occ(pie1_svg, "<circle")) + " pie1_path=" + str(count_occ(pie1_svg, "<path")))
    print("pie1_ok=" + str(count_occ(pie1_svg, "<circle") == 1 and count_occ(pie1_svg, "<path") == 0))

    let scatter_data = [
        {"x": 1, "y": 5},
        {"x": 2, "y": 9},
        {"x": 3, "y": 4},
        {"x": 4, "y": 12},
        {"x": 5, "y": 7},
        {"x": 6, "y": 3}
    ]
    let scatter_opts = {"title": "Points", "width": 400, "height": 260, "radius": 5}
    let scatter_svg = svg_scatter(scatter_data, scatter_opts)
    print("scatter_has_svg=" + str(scatter_svg.contains("<svg")))
    print("scatter_circle_count=" + str(count_occ(scatter_svg, "<circle")) + " want=" + str(len(scatter_data)))
    print("scatter_ok=" + str(scatter_svg.contains("<svg") and count_occ(scatter_svg, "<circle") == len(scatter_data)))

    // edge cases: empty data must not crash and must still be valid SVG
    let empty_bar = svg_bar_chart([], {})
    let empty_line = svg_line_chart([], {})
    let empty_pie = svg_pie_chart([], {})
    let empty_scatter = svg_scatter([], {})
    print("empty_ok=" + str(empty_bar.contains("<svg") and empty_line.contains("<svg") and empty_pie.contains("<svg") and empty_scatter.contains("<svg")))

    // all-zero pie (total <= 0) must not crash and must still be valid SVG with no slices
    let zero_pie = svg_pie_chart([{"label": "X", "value": 0}, {"label": "Y", "value": 0}], {})
    print("zero_pie_ok=" + str(zero_pie.contains("<svg") and count_occ(zero_pie, "<path") == 0 and count_occ(zero_pie, "<circle") == 0))

    // data-only opts (no title/width/height) still produce valid, correctly-sized output
    let default_bar = svg_bar_chart(bar_data, {})
    print("default_ok=" + str(default_bar.contains("<svg") and count_occ(default_bar, "<rect") == len(bar_data)))

    let all_ok = bar_svg.contains("<svg") and count_occ(bar_svg, "<rect") == len(bar_data) and line_svg.contains("<polyline") and count_occ(line_svg, "<circle") == len(line_data) and count_occ(pie_svg, "<path") == len(pie_data) and count_occ(pie1_svg, "<circle") == 1 and count_occ(scatter_svg, "<circle") == len(scatter_data) and empty_bar.contains("<svg") and empty_line.contains("<svg") and empty_pie.contains("<svg") and empty_scatter.contains("<svg") and zero_pie.contains("<svg") and default_bar.contains("<svg")

    if all_ok
        print("SVG-CHARTS KAT PASS")
    else
        print("SVG-CHARTS KAT FAIL")
