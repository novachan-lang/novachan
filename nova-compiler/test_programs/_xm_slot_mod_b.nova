// Field-slot collision probe, module B (WEAPON_PARITY_PLAN 1.4).
// Same field NAME as module A's XsAlpha, deliberately at a DIFFERENT slot (3, not 1).

type XsBeta
    xs_b_one: int
    xs_b_two: int
    xs_shared: int

fn xs_beta_make(v: int) -> XsBeta
    XsBeta(10, 20, v)

fn xs_beta_boxed(v: int) -> list
    [XsBeta(10, 20, v)]
