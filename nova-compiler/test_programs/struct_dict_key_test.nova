// struct_dict_key_test.nova -- permanent guard for the struct-as-dict-key fix.
// The 8ca2f19 soundness sweep replaced `k = (char*)key` with `k = nova_str_safe(key)`
// in the dict key path, which coerced EVERY non-string key to "" -> all struct keys
// collided on the "" hash but the stored raw pointer never strcmp-matched -> lookups
// returned 0 (silent data loss). auto_reflect_test caught it; this pins it directly.
// Fix: dict keys route non-string keys through structural nova_rt_hash / nova_rt_eq.
type Point
    x: int
    y: int

fn main()
    let d = {}
    let a = Point { x: 3, y: 4 }
    let b = Point { x: 3, y: 4 }   // structurally equal to a
    let c = Point { x: 3, y: 9 }   // different
    d[a] = "alpha"
    // exact key retrieves
    assert_eq(d[a], "alpha")
    // a STRUCTURALLY-EQUAL but distinct key retrieves the same entry
    assert_eq(d[b], "alpha")
    // overwrite via the equal key updates in place (no duplicate entry)
    d[b] = "beta"
    assert_eq(d[a], "beta")
    assert_eq(len(d), 1)
    // a different struct is a different key
    d[c] = "gamma"
    assert_eq(d[c], "gamma")
    assert_eq(len(d), 2)
    // string keys still work alongside (back-compat of the fast path)
    let s = {}
    s["k"] = "v"
    assert_eq(s["k"], "v")
    print("struct_dict_key_test passed")
