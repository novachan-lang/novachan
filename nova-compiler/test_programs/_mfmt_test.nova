// KAT for std/money/format — money display formatting.
import std/money/format

fn cks(label, got, want)
    if got != want
        print("FAIL _mfmt_test " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn main()
    // mfmt_group
    cks("group_7dig", mfmt_group("1234567"), "1,234,567")
    cks("group_3dig", mfmt_group("999"), "999")
    cks("group_4dig", mfmt_group("1234"), "1,234")
    cks("group_6dig", mfmt_group("123456"), "123,456")
    cks("group_1dig", mfmt_group("5"), "5")
    cks("group_neg",  mfmt_group("-1234"), "-1,234")
    cks("group_empty", mfmt_group(""), "")

    // mfmt_amount
    cks("amt_2dec",  mfmt_amount(123456, 2), "1,234.56")
    cks("amt_0dec",  mfmt_amount(1000, 0), "1,000")
    cks("amt_3dec",  mfmt_amount(1234567, 3), "1,234.567")
    cks("amt_small", mfmt_amount(5, 2), "0.05")
    cks("amt_neg",   mfmt_amount(-123456, 2), "-1,234.56")
    cks("amt_zero",  mfmt_amount(0, 2), "0.00")
    cks("amt_1000_2", mfmt_amount(100000, 2), "1,000.00")

    // mfmt_money
    cks("money_usd", mfmt_money(123456, "USD"), "$1,234.56")
    cks("money_jpy", mfmt_money(1000, "JPY"), "¥1,000")
    cks("money_eur", mfmt_money(123456, "EUR"), "€1,234.56")
    cks("money_gbp", mfmt_money(123456, "GBP"), "£1,234.56")
    cks("money_bhd", mfmt_money(1500, "BHD"), "BHD 1.500")
    cks("money_xyz", mfmt_money(100, "XYZ"), "XYZ 1.00")

    // mfmt_with_symbol
    cks("wsym", mfmt_with_symbol(123456, 2, "$"), "$1,234.56")
    cks("wsym_euro", mfmt_with_symbol(50000, 2, "€"), "€500.00")

    // mfmt_negative_paren
    cks("paren_neg", mfmt_negative_paren(-123456, 2), "(1,234.56)")
    cks("paren_pos", mfmt_negative_paren(123456, 2), "1,234.56")
    cks("paren_zero", mfmt_negative_paren(0, 2), "0.00")

    // mfmt_plain
    cks("plain_2dec", mfmt_plain(123456, 2), "1234.56")
    cks("plain_small", mfmt_plain(5, 2), "0.05")
    cks("plain_0dec", mfmt_plain(1000, 0), "1000")
    cks("plain_neg", mfmt_plain(-123456, 2), "-1234.56")

    print("PASS _mfmt_test")
