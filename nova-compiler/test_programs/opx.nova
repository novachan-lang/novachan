fn opt_map(opt, f)
  if is_some(opt)
    return some(f(unwrap(opt)))
  none()

fn opt_flat_map(opt, f)
  if is_some(opt)
    return f(unwrap(opt))
  none()

fn opt_filter(opt, pred)
  if is_some(opt) and pred(unwrap(opt))
    return opt
  none()

fn opt_or(opt, default_val)
  if is_some(opt)
    return unwrap(opt)
  default_val

fn opt_or_else(opt, f)
  if is_some(opt)
    return unwrap(opt)
  f(0)

fn opt_zip(a, b)
  if is_some(a) and is_some(b)
    return some([unwrap(a), unwrap(b)])
  none()

fn opt_to_list(opt)
  if is_some(opt)
    return [unwrap(opt)]
  []

fn opt_contains(opt, val)
  if is_some(opt)
    return unwrap(opt) == val
  0

fn _double(x)
  x * 2

fn _is_positive(x)
  x > 0

fn _safe_sqrt(x)
  if x < 0
    return none()
  some(int_sqrt(x))

fn int_sqrt(n)
  if n <= 0
    return 0
  let x = n
  let y = (x + 1) / 2
  while y < x
    x = y
    y = (x + n / x) / 2
  x

fn main()
  let s = some(21)
  let n = none()

  let mapped = opt_map(s, fn(z) _double(z))
  assert(is_some(mapped), "map some")
  assert(unwrap(mapped) == 42, "map value")

  let mapped_n = opt_map(n, fn(z) _double(z))
  assert(is_none(mapped_n), "map none")

  let fm = opt_flat_map(some(16), fn(z) _safe_sqrt(z))
  assert(unwrap(fm) == 4, "flat_map some")

  let fm2 = opt_flat_map(some(-1), fn(z) _safe_sqrt(z))
  assert(is_none(fm2), "flat_map -> none")

  let f1 = opt_filter(some(5), fn(z) _is_positive(z))
  assert(is_some(f1), "filter pass")
  let f2 = opt_filter(some(-3), fn(z) _is_positive(z))
  assert(is_none(f2), "filter reject")

  assert(opt_or(some(10), 0) == 10, "or some")
  assert(opt_or(none(), 99) == 99, "or none")

  let z = opt_zip(some(1), some(2))
  assert(is_some(z), "zip both some")
  assert(unwrap(z)[0] == 1, "zip first")

  let z2 = opt_zip(some(1), none())
  assert(is_none(z2), "zip one none")

  assert(len(opt_to_list(some(5))) == 1, "to_list some")
  assert(len(opt_to_list(none())) == 0, "to_list none")

  assert(opt_contains(some(42), 42) == 1, "contains match")
  assert(opt_contains(some(42), 0) == 0, "contains no match")

  print("opx: all passed")
