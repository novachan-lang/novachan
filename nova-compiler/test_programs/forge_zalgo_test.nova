import forge_zalgo

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn map_str(xs: list) -> list
    let out = []
    let i = 0
    while i < len(xs)
        push(out, str(xs[i]))
        i = i + 1
    out

fn join_str(xs: list, sep: string) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + sep
        out = out + xs[i]
        i = i + 1
    out

fn main()
    let fails = 0

    // Z-array (z[0]=0 convention)
    fails = fails + expect("z_aaaaa", join_str(map_str(z_function("aaaaa")), ","), "0,4,3,2,1")
    fails = fails + expect("z_aabaab", join_str(map_str(z_function("aabaab")), ","), "0,1,0,3,1,0")
    fails = fails + expect("z_abc", join_str(map_str(z_function("abc")), ","), "0,0,0")
    fails = fails + expect("z_single", join_str(map_str(z_function("x")), ","), "0")

    // search (first index)
    fails = fails + expect("s_basic", str(z_search("abxabcabcaby", "abcaby")), "6")
    fails = fails + expect("s_absent", str(z_search("hello world", "xyz")), "-1")
    fails = fails + expect("s_at0", str(z_search("abcdef", "abc")), "0")
    fails = fails + expect("s_atend", str(z_search("abcdef", "def")), "3")
    fails = fails + expect("s_empty", str(z_search("abc", "")), "0")
    fails = fails + expect("s_full", str(z_search("abc", "abc")), "0")
    fails = fails + expect("s_longer", str(z_search("abc", "abcd")), "-1")

    // find all (overlapping)
    fails = fails + expect("all_aa", join_str(map_str(z_find_all("aaaa", "aa")), ","), "0,1,2")
    fails = fails + expect("all_ana", join_str(map_str(z_find_all("banana", "ana")), ","), "1,3")
    fails = fails + expect("all_abc", join_str(map_str(z_find_all("abcabcabc", "abc")), ","), "0,3,6")
    fails = fails + expect("all_none", join_str(map_str(z_find_all("abcabc", "xy")), ","), "")

    // longest repeated prefix
    fails = fails + expect("lrp_aaaa", str(longest_repeated_prefix("aaaa")), "3")
    fails = fails + expect("lrp_aabaab", str(longest_repeated_prefix("aabaab")), "3")
    fails = fails + expect("lrp_none", str(longest_repeated_prefix("abcd")), "0")

    if fails == 0
        print("forge_zalgo: all passed")
    else
        print("forge_zalgo: " + str(fails) + " FAILED")
