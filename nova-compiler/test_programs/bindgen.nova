// bindgen -- auto-generate NOVA FFI bindings from C function declarations. Parses
// simple C prototypes (the common 90%) and emits `extern fn name(args) -> ret`, mapping
// C types to NOVA: char* -> string, double/float -> float, other pointers -> int,
// int/long/short/size_t -> int, void return -> int (ignored). So wrapping a C library
// is a one-liner instead of hand-writing every extern -- "the developer never leaves".

fn _trim(s)
    let a = 0
    while a < len(s) and (s[a] == " " or s[a] == chr(10) or s[a] == chr(9))
        a = a + 1
    let b = len(s)
    while b > a and (s[b - 1] == " " or s[b - 1] == chr(10) or s[b - 1] == chr(9))
        b = b - 1
    return slice(s, a, b)

fn _is_type_word(w)
    if w == "int" or w == "char" or w == "double" or w == "float" or w == "void" or w == "long" or w == "short" or w == "size_t"
        return 1
    return 0

fn _tokens(s)                          // normalize '*' spacing, split, drop noise words
    let norm = ""
    let i = 0
    while i < len(s)
        if s[i] == "*"
            norm = norm + " * "
        else
            norm = norm + s[i]
        i = i + 1
    let out = []
    for p in split(norm, " ")
        if p != "" and p != "const" and p != "unsigned" and p != "signed" and p != "register"
            push(out, p)
    return out

fn _map_type(tokens)
    let has_star = 0
    let has_char = 0
    let has_float = 0
    for t in tokens
        if t == "*"
            has_star = 1
        if t == "char"
            has_char = 1
        if t == "double" or t == "float"
            has_float = 1
    if has_star == 1 and has_char == 1
        return "string"
    if has_star == 1
        return "int"
    if has_float == 1
        return "float"
    return "int"

fn bindgen_fn(decl)
    let d = _trim(decl)
    if len(d) > 0 and d[len(d) - 1] == ";"
        d = _trim(slice(d, 0, len(d) - 1))
    let lp = find(d, "(")
    let rp = find(d, ")")
    if lp < 0 or rp < 0
        return ""
    let sigtoks = _tokens(slice(d, 0, lp))
    if len(sigtoks) < 2
        return ""
    let nm = sigtoks[len(sigtoks) - 1]
    let rettoks = []
    let i = 0
    while i < len(sigtoks) - 1
        push(rettoks, sigtoks[i])
        i = i + 1
    // void return -> int (ignored); otherwise map normally (void* stays a pointer->int)
    let rett = _map_type(rettoks)
    let is_void = 0
    if len(rettoks) == 1 and rettoks[0] == "void"
        is_void = 1
    if is_void == 1
        rett = "int"

    let params_str = _trim(slice(d, lp + 1, rp))
    let paramdecls = []
    if params_str != "" and params_str != "void"
        let plist = split(params_str, ",")
        let pi = 0
        while pi < len(plist)
            let ptoks = _tokens(plist[pi])
            let pname = "p" + str(pi)
            let typetoks = ptoks
            if len(ptoks) > 0
                let last = ptoks[len(ptoks) - 1]
                if _is_type_word(last) == 0 and last != "*"
                    pname = last
                    typetoks = []
                    let k = 0
                    while k < len(ptoks) - 1
                        push(typetoks, ptoks[k])
                        k = k + 1
            push(paramdecls, pname + ": " + _map_type(typetoks))
            pi = pi + 1

    let args = ""
    let ai = 0
    while ai < len(paramdecls)
        if ai > 0
            args = args + ", "
        args = args + paramdecls[ai]
        ai = ai + 1
    return "extern fn " + nm + "(" + args + ") -> " + rett

fn bindgen(header)                     // a whole header -> list of extern decls
    let out = []
    for p in split(header, ";")
        let t = _trim(p)
        if len(t) > 0
            push(out, bindgen_fn(t))
    return out

fn main()
    assert_eq(bindgen_fn("int strlen(char* s);"), "extern fn strlen(s: string) -> int")
    assert_eq(bindgen_fn("double pow(double x, double y);"), "extern fn pow(x: float, y: float) -> float")
    assert_eq(bindgen_fn("int rand(void);"), "extern fn rand() -> int")
    assert_eq(bindgen_fn("char* getenv(const char* name);"), "extern fn getenv(name: string) -> string")
    assert_eq(bindgen_fn("void srand(unsigned int seed);"), "extern fn srand(seed: int) -> int")
    // unnamed params get positional names
    assert_eq(bindgen_fn("int memcmp(char*, char*, int);"), "extern fn memcmp(p0: string, p1: string, p2: int) -> int")
    // a whole mini-header
    let outs = bindgen("int abs(int x); double sqrt(double v);")
    assert_eq(len(outs), 2)
    assert_eq(outs[0], "extern fn abs(x: int) -> int")
    assert_eq(outs[1], "extern fn sqrt(v: float) -> float")

    print("bindgen passed")
