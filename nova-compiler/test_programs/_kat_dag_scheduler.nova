import forge_dag_scheduler

fn main()
    let d = ds_new()
    d = ds_add_task(d, "compile")
    d = ds_add_task(d, "test")
    d = ds_add_task(d, "deploy")
    d = ds_add_dep(d, "test", "compile")
    d = ds_add_dep(d, "deploy", "test")

    assert(ds_is_ready(d, "compile") == 1, "compile ready")
    assert(ds_is_ready(d, "test") == 0, "test not ready")
    assert(ds_is_ready(d, "deploy") == 0, "deploy not ready")

    let first = ds_next_ready(d)
    assert(first == "compile", "compile first")

    d = ds_complete(d, "compile")
    assert(ds_is_ready(d, "test") == 1, "test now ready")
    assert(ds_progress(d) == 33, "33% done")

    d = ds_complete(d, "test")
    assert(ds_is_ready(d, "deploy") == 1, "deploy now ready")

    d = ds_complete(d, "deploy")
    assert(ds_all_done(d) == 1, "all done")
    assert(ds_progress(d) == 100, "100% done")

    print("DAG-SCHEDULER KAT PASS")
