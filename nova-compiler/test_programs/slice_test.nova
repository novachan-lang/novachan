// Test string slicing
fn test_string_slice()
    s = "hello world"
    print(s[0:5])
    print(s[6:11])
    print(s[:5])
    print(s[6:])

// Test list slicing
fn test_list_slice()
    nums = [10, 20, 30, 40, 50]
    first_three = nums[0:3]
    for v in first_three
        print(v)
    print("---")
    last_two = nums[3:]
    for v in last_two
        print(v)
    print("---")
    middle = nums[1:4]
    for v in middle
        print(v)

// Test empty slices
fn test_edge_cases()
    s = "abc"
    print(s[0:0])
    nums = [1, 2, 3]
    empty = nums[2:2]
    print(len(empty))

test_string_slice()
print("===")
test_list_slice()
print("===")
test_edge_cases()
print("done")
