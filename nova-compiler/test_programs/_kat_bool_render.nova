// KAT: a comparison / logical op YIELDS a bool, so str()/print() must render
// true/false — not 1/0. Before the fix `print(x == y)` printed 1, which is a
// direct Python-parity failure (NOVA's bar is "simpler than Python").
//
// Covers BOTH paths: const-folded literal comparisons (folded before inference
// runs, so the folded constant itself must be bool-typed) and runtime values
// (typed in ir_infer_one). Also pins neg/bitnot as INTS — they are not bools.
fn ident(n: int) -> int
    n

fn main() -> int
    // literal / const-folded
    assert(str(true) == "true", "literal true")
    assert(str(false) == "false", "literal false")
    assert(str(1 == 1) == "true", "folded eq")
    assert(str(1 < 2) == "true", "folded lt")
    assert(str(2 <= 1) == "false", "folded le")
    assert(str(not true) == "false", "folded not")
    assert(str([true, 1 == 1]) == "[true, true]", "folded bool in list")

    // runtime values (not const-foldable)
    let a = ident(1)
    let b = ident(2)
    assert(str(a == b) == "false", "runtime eq")
    assert(str(a != b) == "true", "runtime ne")
    assert(str(a < b) == "true", "runtime lt")
    assert(str(not (a == b)) == "true", "runtime not")

    // string and float comparisons
    let s1 = "x"
    let s2 = "y"
    assert(str(s1 == s2) == "false", "runtime str eq")
    let f1 = 1.5
    let f2 = 2.5
    assert(str(f1 < f2) == "true", "runtime float lt")

    // neg / bitnot are INTS, not bools — guards against over-applying the fix
    assert(str(-5) == "-5", "neg stays int")
    assert(str(-(2 + 3)) == "-5", "folded neg stays int")
    assert(str(~5) == "-6", "bitnot stays int")

    print("PASS _kat_bool_render")
    return 0

main()
