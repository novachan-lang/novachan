import std/collections/fenwickrange

// Helper: check int equality; print FAIL and exit(1) on mismatch.
fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// ---------------------------------------------------------------------------
// KAT sequence from spec:
//   t = fwr_new(5)
//   fwr_range_add(t, 1, 3, 5)
//   fwr_point_query(t, 2) == 5
//   fwr_point_query(t, 4) == 0
//   fwr_range_add(t, 2, 5, 3)
//   fwr_point_query(t, 2) == 8
//   fwr_point_query(t, 5) == 3
//   fwr_point_query(t, 1) == 5
//   fwr_size(t) == 5
// ---------------------------------------------------------------------------

let t = fwr_new(5)

// After fwr_range_add(t, 1, 3, 5): positions 1,2,3 each hold 5; 4,5 hold 0.
fwr_range_add(t, 1, 3, 5)

cki("query(2) after add(1,3,5)", fwr_point_query(t, 2), 5)
cki("query(4) after add(1,3,5)", fwr_point_query(t, 4), 0)

// After fwr_range_add(t, 2, 5, 3): positions 2,3,4,5 get +3.
// Position 1: 5       (only first add)
// Position 2: 5+3 = 8
// Position 3: 5+3 = 8
// Position 4: 0+3 = 3
// Position 5: 0+3 = 3
fwr_range_add(t, 2, 5, 3)

cki("query(2) after add(2,5,3)", fwr_point_query(t, 2), 8)
cki("query(5) after add(2,5,3)", fwr_point_query(t, 5), 3)
cki("query(1) after add(2,5,3)", fwr_point_query(t, 1), 5)
cki("size",                       fwr_size(t),            5)

// Extra: verify position 3 and 4 as well (beyond the spec minimum).
cki("query(3) after both adds", fwr_point_query(t, 3), 8)
cki("query(4) after both adds", fwr_point_query(t, 4), 3)

print("_fenwickrange_test passed")
