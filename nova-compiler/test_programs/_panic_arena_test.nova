// _panic_arena_test -- regression guard for the panic-safe arena cleanup (Phase 0). A crash-isolated
// handler that enters a per-request arena and then PANICS longjmps OVER its arena_scope_exit. Without the
// fix the request arena leaks AND active_arena is left dangling for the next task on that carrier/pool
// thread (cross-task corruption, reachable in normal "let it crash" operation). The fix frees + resets the
// arena at every fault boundary. This drives 200 such panics synchronously via dispatch_safe and asserts
// the process survives with a clean 500 each time; under ASAN/LSan it also proves no arena leak.
import forge

fn _crash_handler(req: Request) -> Response
    let p = arena_enter()
    let junk = "panic-payload-" + str(len(req.path)) + "-padding-padding-padding-padding"
    panic("intentional crash inside an active arena: " + junk + " arena=" + str(p))
    forge.resp_text(200, "unreachable")

fn main()
    let app = forge.app()
    forge.get(app, "/c", _crash_handler)
    let i = 0
    while i < 200
        let r: Response = forge.dispatch_safe(app, forge.build_request("GET /c HTTP/1.1\r\n\r\n", 0))
        assert(r.status == 500, "panic-in-arena handler contained -> 500")
        i = i + 1
    print("PASS: survived 200 panic-in-arena crash-isolated requests, each a clean 500")
    print("_panic_arena_test passed")
