// KAT: `EXPR else FALLBACK` -- NOVA's one-word error handling.
// Value form (unwrap_or) and escape form (`else return X`), plus the two things that
// must NOT regress: the `if c then a else b` sugar, and full if/else blocks.

fn half(n: int) -> Result
    if n % 2 == 1
        return err("odd")
    ok(n / 2)

fn chain(a: int, b: int) -> Result
    // escape form: bind once, bail on Err, otherwise unwrap
    let x = half(a) else return err("a is odd")
    let y = half(b) else return err("b is odd")
    ok(x + y)

// the subject must be evaluated EXACTLY ONCE (`??` mentions it twice)
fn bump(c: list) -> Result
    c[0] = c[0] + 1
    err("always")

fn pick(y: int) -> string
    let msg = ""
    // the `if c then A else B` sugar: this `else` belongs to the if, NOT to `msg = "big"`
    if y > 5 then msg = "big" else msg = "small"
    msg

fn main()
    let ok_n = 0
    let fail = 0

    // ── value form ────────────────────────────────────────────────────────
    let a = half(10) else 0
    let b = half(7) else -1
    if a == 5 and b == -1
        ok_n = ok_n + 1
        print("ok: value form -- ok unwraps, err takes the fallback")
    else
        print("FAIL value form: " + str(a) + " " + str(b))
        fail = fail + 1

    // bare assignment (no `let`) is the same parse path
    let c = 99
    c = half(8) else 0
    if c == 4
        ok_n = ok_n + 1
        print("ok: bare `target = expr else d`")
    else
        print("FAIL bare assign: " + str(c))
        fail = fail + 1

    // ── escape form ───────────────────────────────────────────────────────
    match chain(10, 20)
        Ok(v) =>
            if v == 15
                ok_n = ok_n + 1
                print("ok: escape form -- both halves succeed, binding visible after")
            else
                print("FAIL chain value " + str(v))
                fail = fail + 1
        Err(e) =>
            print("FAIL chain errored: " + str(e))
            fail = fail + 1
    match chain(10, 7)
        Ok(v) =>
            print("FAIL chain should have escaped")
            fail = fail + 1
        Err(e) =>
            if e == "b is odd"
                ok_n = ok_n + 1
                print("ok: escape form returns the custom error")
            else
                print("FAIL wrong escape error: " + str(e))
                fail = fail + 1

    // ── single evaluation ────────────────────────────────────────────────
    let ctr = [0]
    let z = bump(ctr) else 42
    if ctr[0] == 1 and z == 42
        ok_n = ok_n + 1
        print("ok: subject evaluated exactly once")
    else
        print("FAIL eval count=" + str(ctr[0]) + " z=" + str(z))
        fail = fail + 1

    // ── no regression: `then ... else` sugar ─────────────────────────────
    if pick(9) == "big" and pick(2) == "small"
        ok_n = ok_n + 1
        print("ok: `if c then x = a else x = b` sugar unaffected")
    else
        print("FAIL then-sugar: " + pick(9) + "/" + pick(2))
        fail = fail + 1

    // ── no regression: inline if-expression and block if/else ────────────
    let m = if 3 > 7 3 else 7
    let n2 = 0
    if 3 > 7
        n2 = 1
    else
        n2 = 2
    if m == 7 and n2 == 2
        ok_n = ok_n + 1
        print("ok: inline if-expression and block if/else unaffected")
    else
        print("FAIL if forms: " + str(m) + " " + str(n2))
        fail = fail + 1

    print("ok=" + str(ok_n) + " fail=" + str(fail))
    assert(fail == 0, "else_fallback: all checks pass")
    assert(ok_n == 7, "else_fallback: all 7 checks ran")
    print("KAT else_fallback PASS")
