import forge_circuit_pool

fn main()
    let p = pool_new(3)
    assert(pool_size(p) == 0, "empty pool")
    assert(pool_available(p) == 0, "none available")

    let r1 = pool_create_conn(p, "db-1")
    p = r1["pool"]
    assert(r1["conn_id"] == 1, "conn id=1")
    let r2 = pool_create_conn(p, "db-2")
    p = r2["pool"]
    let r3 = pool_create_conn(p, "db-3")
    p = r3["pool"]
    assert(pool_size(p) == 3, "3 connections")
    assert(pool_available(p) == 3, "3 available")

    let r4 = pool_create_conn(p, "db-4")
    assert(r4["conn_id"] == -1, "pool full")

    let a1 = pool_acquire(p)
    p = a1["pool"]
    assert(a1["conn_id"] == 1, "acquired conn 1")
    assert(pool_available(p) == 2, "2 available")
    assert(pool_in_use(p) == 1, "1 in use")

    let a2 = pool_acquire(p)
    p = a2["pool"]
    let a3 = pool_acquire(p)
    p = a3["pool"]
    assert(pool_available(p) == 0, "0 available")
    assert(pool_in_use(p) == 3, "3 in use")

    let a4 = pool_acquire(p)
    assert(a4["conn_id"] == -1, "none available")

    p = pool_release(p, 1)
    assert(pool_available(p) == 1, "1 available after release")
    assert(pool_in_use(p) == 2, "2 in use")

    p = pool_release(p, 2)
    p = pool_release(p, 3)

    let stats = pool_stats(p)
    assert(stats["size"] == 3, "stats size=3")
    assert(stats["total_acquired"] == 3, "3 total acquired")
    assert(stats["total_released"] == 3, "3 total released")
    assert(stats["in_use"] == 0, "0 in use")

    print("CIRCUIT-POOL KAT PASS")
