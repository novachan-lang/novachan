// fenwickx.nova — Fenwick tree (Binary Indexed Tree): O(log n) mutable prefix sums.
//
// Maintains running prefix sums under POINT UPDATES, both in O(log n) — far
// better than an array (O(n) prefix) or recomputing. The structure behind
// cumulative frequency tables, running statistics, inversion counting, and
// range-sum queries on a changing sequence. 1-indexed; lowbit via i & -i.

fn fenwick_new(n)
  let tree = []
  let i = 0
  while i <= n                       // 1-indexed: slots 0..n
    push(tree, 0)
    i = i + 1
  let f = {}
  f["tree"] = tree
  f["n"] = n
  f

// add `delta` at position i (1-indexed).
fn fenwick_update(f, i, delta)
  let tree = f["tree"]
  let n = f["n"]
  let idx = i
  while idx <= n
    tree[idx] = tree[idx] + delta
    idx = idx + (idx & (0 - idx))    // idx += lowbit(idx)
  0

// sum of positions [1..i].
fn fenwick_prefix(f, i)
  let tree = f["tree"]
  let s = 0
  let idx = i
  while idx > 0
    s = s + tree[idx]
    idx = idx - (idx & (0 - idx))    // idx -= lowbit(idx)
  s

// sum of positions [lo..hi].
fn fenwick_range(f, lo, hi)
  fenwick_prefix(f, hi) - fenwick_prefix(f, lo - 1)

// ── Tests ────────────────────────────────────────────────────────────

let f = fenwick_new(10)
fenwick_update(f, 3, 5)
fenwick_update(f, 5, 2)
fenwick_update(f, 7, 1)

assert(fenwick_prefix(f, 2) == 0, "prefix before any value = 0")
assert(fenwick_prefix(f, 3) == 5, "prefix(3) = 5")
assert(fenwick_prefix(f, 5) == 7, "prefix(5) = 5+2")
assert(fenwick_prefix(f, 10) == 8, "prefix(10) = 5+2+1")
print("PASS: prefix sums")

assert(fenwick_range(f, 4, 7) == 3, "range[4..7] = 2+1 = 3")
assert(fenwick_range(f, 3, 5) == 7, "range[3..5] = 5+2 = 7")
assert(fenwick_range(f, 1, 10) == 8, "whole range = 8")
print("PASS: range sums")

// a point update is reflected everywhere instantly
fenwick_update(f, 3, 10)             // index 3 now holds 15
assert(fenwick_prefix(f, 3) == 15, "after +10 at 3, prefix(3) = 15")
assert(fenwick_prefix(f, 10) == 18, "total now 18")
assert(fenwick_range(f, 3, 3) == 15, "single index = 15")
print("PASS: dynamic update")

// build a cumulative frequency table from a stream of values 1..6
let freq = fenwick_new(6)
let stream = [3, 1, 4, 1, 5, 3, 3, 6, 1]
for v in stream
  fenwick_update(freq, v, 1)
assert(fenwick_range(freq, 1, 1) == 3, "value 1 appeared 3 times")
assert(fenwick_range(freq, 3, 3) == 3, "value 3 appeared 3 times")
assert(fenwick_prefix(freq, 6) == 9, "9 values total")
assert(fenwick_prefix(freq, 3) == 6, "values <= 3: three 1s + zero 2s + three 3s = 6")
print("PASS: cumulative frequency table")

print("ALL PASS: fenwickx — Fenwick tree / BIT")
