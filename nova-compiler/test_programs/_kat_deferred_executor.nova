import forge_deferred_executor

fn main()
    let d = de_new()
    d = de_schedule(d, "send_email", "send welcome email", 1100)
    d = de_schedule(d, "cleanup", "cleanup temp files", 1200)
    assert(de_pending_count(d) == 2, "2 pending")

    let e1 = de_execute_due(d, 1050)
    assert(e1 == 0, "nothing due at 1050")

    let e2 = de_execute_due(d, 1150)
    assert(e2 == 1, "1 due at 1150")
    assert(de_executed_count(d) == 1, "1 executed")
    assert(de_pending_count(d) == 1, "1 pending")

    let s = de_status(d, "send_email")
    assert(is_ok(s), "status ok")
    assert(unwrap(s) == "executed", "email executed")

    let s2 = de_status(d, "cleanup")
    assert(unwrap(s2) == "pending", "cleanup pending")

    let e3 = de_execute_due(d, 1300)
    assert(e3 == 1, "cleanup due at 1300")
    assert(de_executed_count(d) == 2, "2 executed")

    print("DEFERRED-EXECUTOR KAT PASS")
