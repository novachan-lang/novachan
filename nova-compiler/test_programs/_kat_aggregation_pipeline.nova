import forge_aggregation_pipeline

fn main()
    let ap = ap_new()
    ap = ap_add_stage(ap, "filter", "where")
    ap = ap_add_stage(ap, "group", "group_by")
    assert(ap_stage_count(ap) == 2, "2 stages")

    ap = ap_record(ap, "us", "sales", 100)
    ap = ap_record(ap, "us", "sales", 200)
    ap = ap_record(ap, "eu", "sales", 150)
    ap = ap_record(ap, "us", "cost", 50)
    assert(ap_record_count(ap) == 4, "4 records")
    assert(ap_group_count_total(ap) == 2, "2 groups")

    let us_sum = ap_group_sum(ap, "us", "sales")
    assert(is_ok(us_sum), "sum ok")
    assert(unwrap(us_sum) == 300, "us sales sum 300")

    let us_cnt = ap_group_count(ap, "us", "sales")
    assert(unwrap(us_cnt) == 2, "us sales count 2")

    let us_mean = ap_group_mean(ap, "us", "sales")
    assert(unwrap(us_mean) == 150, "us sales mean 150")

    let us_min = ap_group_min(ap, "us", "sales")
    assert(unwrap(us_min) == 100, "us sales min 100")

    let us_max = ap_group_max(ap, "us", "sales")
    assert(unwrap(us_max) == 200, "us sales max 200")

    let eu_sum = ap_group_sum(ap, "eu", "sales")
    assert(unwrap(eu_sum) == 150, "eu sales sum 150")

    let bad = ap_group_sum(ap, "asia", "sales")
    assert(is_err(bad), "no asia group")

    let gl = ap_group_list(ap)
    assert(len(gl) > 0, "group list non-empty")

    let sn = ap_stage_names(ap)
    assert(find(sn, "filter") >= 0, "has filter stage")

    print("AGGREGATION-PIPELINE KAT PASS")
