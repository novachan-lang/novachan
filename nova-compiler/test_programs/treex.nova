fn tree_node(value)
  let n = {}
  n["value"] = value
  n["children"] = []
  n

fn tree_add(parent, child)
  push(parent["children"], child)
  child

fn tree_value(node)
  node["value"]

fn tree_children(node)
  node["children"]

fn tree_is_leaf(node)
  len(node["children"]) == 0

fn tree_depth(node)
  if tree_is_leaf(node)
    return 0
  let max_d = 0
  let children = tree_children(node)
  let i = 0
  while i < len(children)
    let d = tree_depth(children[i])
    if d > max_d
      max_d = d
    i = i + 1
  max_d + 1

fn tree_size(node)
  let count = 1
  let children = tree_children(node)
  let i = 0
  while i < len(children)
    count = count + tree_size(children[i])
    i = i + 1
  count

fn tree_leaves(node)
  if tree_is_leaf(node)
    return [tree_value(node)]
  let result = []
  let children = tree_children(node)
  let i = 0
  while i < len(children)
    let child_leaves = tree_leaves(children[i])
    for l in child_leaves
      push(result, l)
    i = i + 1
  result

fn tree_find(node, target)
  if tree_value(node) == target
    return node
  let children = tree_children(node)
  let i = 0
  while i < len(children)
    let found = tree_find(children[i], target)
    if found != 0
      return found
    i = i + 1
  0

fn tree_map(node, f)
  let new_node = tree_node(f(tree_value(node)))
  let children = tree_children(node)
  let i = 0
  while i < len(children)
    tree_add(new_node, tree_map(children[i], f))
    i = i + 1
  new_node

fn _double(x)
  x * 2

fn main()
  let root = tree_node("root")
  let a = tree_add(root, tree_node("a"))
  let b = tree_add(root, tree_node("b"))
  let _a1 = tree_add(a, tree_node("a1"))
  let _a2 = tree_add(a, tree_node("a2"))
  let _b1 = tree_add(b, tree_node("b1"))

  assert(tree_value(root) == "root", "root value")
  assert(len(tree_children(root)) == 2, "root has 2 children")
  assert(tree_is_leaf(root) == 0, "root is not leaf")
  assert(tree_is_leaf(_a1) == 1, "a1 is leaf")

  assert(tree_depth(root) == 2, "depth 2")
  assert(tree_depth(a) == 1, "depth of a = 1")
  assert(tree_depth(_a1) == 0, "depth of leaf = 0")

  assert(tree_size(root) == 6, "6 nodes total")
  assert(tree_size(a) == 3, "a subtree = 3")

  let leaves = tree_leaves(root)
  assert(len(leaves) == 3, "3 leaves")
  assert(contains(leaves, "a1"), "a1 is leaf")
  assert(contains(leaves, "b1"), "b1 is leaf")

  let found = tree_find(root, "a2")
  assert(found != 0, "found a2")
  assert(tree_value(found) == "a2", "found value")

  let not_found = tree_find(root, "xyz")
  assert(not_found == 0, "not found")

  let nums = tree_node(1)
  let _n2 = tree_add(nums, tree_node(2))
  let _n3 = tree_add(nums, tree_node(3))
  let doubled = tree_map(nums, fn(z) _double(z))
  assert(tree_value(doubled) == 2, "mapped root")
  assert(tree_value(tree_children(doubled)[0]) == 4, "mapped child")

  print("treex: all passed")
