import forge_access_log

fn main()
    let al = al_new()
    assert(al_count(al) == 0, "empty")

    al = al_log(al, "10.0.0.1", "GET", "/", 200, 5000, "Mozilla/5.0")
    al = al_log(al, "10.0.0.1", "GET", "/api/users", 200, 2000, "Mozilla/5.0")
    al = al_log(al, "10.0.0.2", "POST", "/api/users", 201, 500, "curl/7.0")
    al = al_log(al, "10.0.0.3", "GET", "/missing", 404, 200, "Python/3.11")
    al = al_log(al, "10.0.0.1", "GET", "/api/users", 500, 100, "Mozilla/5.0")
    assert(al_count(al) == 5, "5 entries")
    assert(al_total_bytes(al) == 7800, "7800 bytes")

    assert(al_unique_ip_count(al) == 3, "3 unique ips")
    let ips = al_unique_ips(al)
    assert(ips[0] == "10.0.0.1", "first ip")

    let api_hits = al_by_path(al, "/api/users")
    assert(len(api_hits) == 3, "3 hits to /api/users")

    let counts = al_status_counts(al)
    assert(counts["200"] == 2, "2 x 200")
    assert(counts["404"] == 1, "1 x 404")

    let err_rate = al_error_rate(al)
    assert(err_rate == 40, "40% error rate (2/5)")

    print("ACCESS-LOG KAT PASS")
