import std/text/pigify

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got [" + got + "] expected [" + expected + "]")
        exit(1)

fn main()
    // ── KAT spec vectors (hand-computed) ────────────────────────────────────
    cks("pig_word pig",    pig_word("pig"),    "igpay")
    cks("pig_word banana", pig_word("banana"), "ananabay")
    cks("pig_word smile",  pig_word("smile"),  "ilesmay")
    cks("pig_word eat",    pig_word("eat"),    "eatway")
    cks("pig_word apple",  pig_word("apple"),  "appleway")
    cks("pig_word string", pig_word("string"), "ingstray")
    cks("pig_sentence hello world", pig_sentence("hello world"), "ellohay orldway")

    // ── additional known-answer assertions ───────────────────────────────────
    // Uppercase input -> lowercase output
    cks("pig_word PIG upper",    pig_word("PIG"),    "igpay")
    cks("pig_word APPLE upper",  pig_word("APPLE"),  "appleway")

    // Single character: vowel
    cks("pig_word a",  pig_word("a"),  "away")

    // Single character: consonant (no vowels -> entire cluster moved)
    cks("pig_word b",  pig_word("b"),  "bay")

    // Three-word sentence
    let s3 = pig_sentence("string eat pig")
    cks("pig_sentence 3 words", s3, "ingstray eatway igpay")

    print("_pigify_test passed")
