// forge_totp NUL-safety fix + RFC 6238 correctness (Wave-C #11 soundness: binary-safe secrets)
import forge_base32
import forge_totp

fn main()
    // base32_decode_bytes is BINARY-SAFE: "AAAAAAAA" decodes to five 0x00 bytes (not truncated)
    let z = base32_decode_bytes("AAAAAAAA")
    if len(z) != 5
        print("FAIL zeros-len: got " + str(len(z)) + " want 5")
        exit(1)
    if z[0] != 0 or z[2] != 0 or z[4] != 0
        print("FAIL zeros-val")
        exit(1)
    // normal RFC 4648 vector: base32("foo") = "MZXW6===" -> [102,111,111]
    let foo = base32_decode_bytes("MZXW6===")
    if len(foo) != 3 or foo[0] != 102 or foo[1] != 111 or foo[2] != 111
        print("FAIL foo-decode: len " + str(len(foo)))
        exit(1)
    // demonstrate the OLD string decode DID truncate at 0x00 (all-zero -> empty)
    let trunc = base32_decode("AAAAAAAA")
    if len(trunc) != 0
        print("FAIL old-string-decode expected truncation to len 0, got " + str(len(trunc)))
        exit(1)
    // RFC 6238 TOTP SHA-1 vector: secret base32("12345678901234567890"), T=59s, period=30, 8 digits -> 94287082
    let code = totp("GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ", 59, 30, 8)
    if code != "94287082"
        print("FAIL totp-rfc6238: got '" + code + "' want 94287082")
        exit(1)

    // base32_encode_bytes is BINARY-SAFE (encode side): a byte list WITH an interior 0x00 round-trips
    // intact through encode->decode (the old totp_secret string path dropped the 0x00 and shifted bytes).
    let payload = [72, 0, 33, 153, 0, 255]
    let enc = base32_encode_bytes(payload)
    let back = base32_decode_bytes(enc)
    if len(back) != 6
        print("FAIL encbytes-len: got " + str(len(back)) + " want 6")
        exit(1)
    if back[0] != 72 or back[1] != 0 or back[2] != 33 or back[3] != 153 or back[4] != 0 or back[5] != 255
        print("FAIL encbytes-roundtrip (0x00 corrupted)")
        exit(1)
    // consistency: base32_encode_bytes of ASCII "foo" bytes == base32_encode("foo")
    if base32_encode_bytes([102, 111, 111]) != base32_encode("foo")
        print("FAIL encbytes-ascii-consistency")
        exit(1)
    // totp_secret now round-trips to the FULL requested length even when random bytes contain 0x00:
    // decode the generated secret and confirm it is exactly 20 bytes (the requested entropy).
    let sec = totp_secret(20)
    if len(base32_decode_bytes(sec)) != 20
        print("FAIL totp_secret-entropy: decoded len " + str(len(base32_decode_bytes(sec))) + " want 20")
        exit(1)

    print("PASS _totp_nulsafe_test")
