// INDEPENDENT ADVERSARIAL PROBE for forge/forge_otel.nova.
// Re-derives expected OTLP/HTTP JSON from the proto3-JSON spec myself (do NOT trust builder's KAT).
import forge_otel

fn main()
    // (A) int64 boundary values must serialize as JSON STRINGS, exact digits, including negative.
    assert_eq(json_stringify(otel_attr_value(9223372036854775807)), "\{\"intValue\":\"9223372036854775807\"\}")
    assert_eq(json_stringify(otel_attr_value(-9223372036854775807)), "\{\"intValue\":\"-9223372036854775807\"\}")
    assert_eq(json_stringify(otel_attr_value(0)), "\{\"intValue\":\"0\"\}")
    assert_eq(json_stringify(otel_attr_value(-1)), "\{\"intValue\":\"-1\"\}")

    // (B) explicit kind=0 (UNSPECIFIED) must NOT be overridden by the default(2) -- contains()
    // guard must distinguish "explicitly zero" from "absent".
    let span0 = {}
    span0["trace_id"] = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    span0["span_id"] = "bbbbbbbbbbbbbbbb"
    span0["name"] = "explicit-unspecified"
    span0["start_ns"] = 100
    span0["end_ns"] = 200
    span0["kind"] = 0
    let j0 = json_stringify(otel_span(span0))
    assert(find(j0, "\"kind\":0,") >= 0, "explicit kind=0 must be preserved, not defaulted to 2")

    // (C) status: message present but code absent -> code defaults to 0, message passes through.
    let st = {}
    st["message"] = "only msg"
    assert_eq(json_stringify(otel_status(st)), "\{\"code\":0,\"message\":\"only msg\"\}")

    // (D) empty spans list -> "spans":[] (no crash, no trailing garbage).
    let empty_full = otel_export_request([], {}, "svc")
    assert(find(empty_full, "\"spans\":[]") >= 0, "empty span list must serialize as empty JSON array")

    // (E) multiple attribute types in one dict, order preserved: string, int, float, negative int.
    let mattrs = {}
    mattrs["a.str"] = "x"
    mattrs["b.int"] = 7
    mattrs["c.float"] = 3.5
    mattrs["d.negint"] = -3
    let mlist = otel_attributes(mattrs)
    assert_eq(len(mlist), 4)
    let mjson = json_stringify(mlist)
    let expect_m = "[\{\"key\":\"a.str\",\"value\":\{\"stringValue\":\"x\"\}\},\{\"key\":\"b.int\",\"value\":\{\"intValue\":\"7\"\}\},\{\"key\":\"c.float\",\"value\":\{\"doubleValue\":3.5\}\},\{\"key\":\"d.negint\",\"value\":\{\"intValue\":\"-3\"\}\}]"
    assert_eq(mjson, expect_m)

    // (F) two spans in one request -- nesting/array-of-spans correctness (not just single-element).
    let spanA = {}
    spanA["trace_id"] = "11111111111111111111111111111111"
    spanA["span_id"] = "2222222222222222"
    spanA["name"] = "spanA"
    spanA["start_ns"] = 1
    spanA["end_ns"] = 2
    let spanB = {}
    spanB["trace_id"] = "33333333333333333333333333333333"
    spanB["span_id"] = "4444444444444444"
    spanB["name"] = "spanB"
    spanB["start_ns"] = 3
    spanB["end_ns"] = 4
    let two = otel_export_request([spanA, spanB], {}, "")
    let idx_a = find(two, "\"name\":\"spanA\"")
    let idx_b = find(two, "\"name\":\"spanB\"")
    assert(idx_a >= 0, "spanA must be present")
    assert(idx_b >= 0, "spanB must be present")
    assert(idx_a < idx_b, "spans must preserve caller order (spanA before spanB)")
    // exactly one "spans" array containing both, not two separate resourceSpans entries.
    assert(find(two, "\"resourceSpans\":[") == 1, "must be a single-element top-level resourceSpans array start")

    // (G) top-level structural shape sanity via key presence at expected nesting.
    assert(find(two, "\{\"resourceSpans\":[\{\"resource\":\{\"attributes\":[]\},\"scopeSpans\":[\{\"scope\":\{\"name\":\"\"\},\"spans\":[") == 0, "top-level nesting must match resourceSpans->resource/scopeSpans->scope/spans exactly")

    print("PASS otoreadv2")
