// Track 7: Collections test
// Tests PriorityQueue, Deque, SortedMap, LRU, Counter, RingBuffer, Arena

fn test_priority_queue()
    let pq = pq_create()
    pq_push(pq, 10, 100)
    pq_push(pq, 3, 300)
    pq_push(pq, 7, 700)
    pq_push(pq, 1, 111)
    // min-heap: pops lowest priority first (priority 1)
    let v1 = pq_pop(pq)
    let v2 = pq_pop(pq)
    let v3 = pq_pop(pq)
    assert_eq(pq_len(pq), 1)
    print("pq pop1=" + str(v1) + " pop2=" + str(v2) + " pop3=" + str(v3))
    print("PQ test passed")

fn test_deque()
    let d = deque_create()
    deque_push_back(d, 10)
    deque_push_back(d, 20)
    deque_push_front(d, 5)
    // [5, 10, 20]
    let f = deque_pop_front(d)
    let b = deque_pop_back(d)
    assert_eq(f, 5)
    assert_eq(b, 20)
    print("Deque test passed")

fn test_counter()
    let c = counter_create()
    counter_inc(c, "apple")
    counter_inc(c, "apple")
    counter_inc(c, "banana")
    counter_inc(c, "apple")
    // apple=3, banana=1
    let top = counter_most_common(c, 1)
    print("top=" + str(len(top)))
    print("Counter test passed")

fn test_ring_buffer()
    let rb = ringbuf_create(3)
    ringbuf_push(rb, 10)
    ringbuf_push(rb, 20)
    ringbuf_push(rb, 30)
    // Full: next push overwrites oldest
    ringbuf_push(rb, 40)  // evicts 10
    let v = ringbuf_pop(rb)
    assert_eq(v, 20)
    print("RingBuffer test passed")

fn test_arena()
    let a = arena_create()
    let p1 = arena_alloc(a, 64)
    let p2 = arena_alloc(a, 128)
    let used = arena_used(a)
    assert_eq(used > 0, true)
    print("arena used=" + str(used) + " p1=" + str(p1 > 0) + " p2=" + str(p2 > 0))
    arena_reset(a)
    let used2 = arena_used(a)
    assert_eq(used2, 0)
    arena_free(a)
    print("Arena test passed")

fn main()
    test_priority_queue()
    test_deque()
    test_counter()
    test_ring_buffer()
    test_arena()
    print("All Track 7 collection tests passed!")
