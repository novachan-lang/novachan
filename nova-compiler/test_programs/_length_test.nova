import std/units/length

// Float approximate equality with tolerance.
fn approx(a: float, b: float, tol: float) -> int
    let diff = a - b
    let adiff = diff
    if diff < 0.0
        adiff = 0.0 - diff
    let ok = 1
    if adiff > tol
        ok = 0
    ok

fn ckf(label: string, got: float, want: float, tol: float)
    let ok = approx(got, want, tol)
    if ok == 0
        print("FAIL length " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL length " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // length_convert(1.0,'km','m') == 1000.0
    let v1 = length_convert(1.0, "km", "m")
    ckf("km_to_m", v1, 1000.0, 0.0001)

    // length_convert(1.0,'mi','m') == 1609.344
    let v2 = length_convert(1.0, "mi", "m")
    ckf("mi_to_m", v2, 1609.344, 0.001)

    // length_convert(1.0,'ft','in') == 12.0
    let v3 = length_convert(1.0, "ft", "in")
    ckf("ft_to_in", v3, 12.0, 0.0001)

    // length_convert(1.0,'yd','ft') == 3.0
    let v4 = length_convert(1.0, "yd", "ft")
    ckf("yd_to_ft", v4, 3.0, 0.0001)

    // round-trip: from_base(to_base(5.5,'mi'),'mi') approx 5.5
    let base5 = length_to_base(5.5, "mi")
    let v5 = length_from_base(base5, "mi")
    ckf("roundtrip_mi", v5, 5.5, 0.000001)

    // length_is_supported('km') == 1
    let s1 = length_is_supported("km")
    cki("supported_km", s1, 1)

    // length_is_supported('xyz') == 0
    let s2 = length_is_supported("xyz")
    cki("unsupported_xyz", s2, 0)

    // length_factor('m') == 1.0
    let f1 = length_factor("m")
    ckf("factor_m", f1, 1.0, 0.0000001)

    // length_factor('nmi') == 1852.0
    let f2 = length_factor("nmi")
    ckf("factor_nmi", f2, 1852.0, 0.0001)

    // km_to_m convenience
    let c1 = km_to_m(3.0)
    ckf("km_to_m_conv", c1, 3000.0, 0.0001)

    // mi_to_km convenience: 1 mile = 1.609344 km
    let c2 = mi_to_km(1.0)
    ckf("mi_to_km_conv", c2, 1.609344, 0.000001)

    // ft_to_m convenience
    let c3 = ft_to_m(1.0)
    ckf("ft_to_m_conv", c3, 0.3048, 0.0000001)

    // length_units() has 11 entries
    let us = length_units()
    let ulen = len(us)
    cki("units_count", ulen, 11)

    // cm roundtrip
    let base_cm = length_to_base(100.0, "cm")
    ckf("cm_to_base", base_cm, 1.0, 0.0000001)
    let from_cm = length_from_base(1.0, "cm")
    ckf("from_base_cm", from_cm, 100.0, 0.0000001)

    // mm roundtrip
    let base_mm = length_to_base(1000.0, "mm")
    ckf("mm_to_base", base_mm, 1.0, 0.0000001)

    print("PASS _length_test")
