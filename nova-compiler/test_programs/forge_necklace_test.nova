import forge_necklace as nk

fn check(cond: bool, label: string)
    if cond == false
        print("FAIL: " + label)

// ---- brute-force references over base-k strings of length n (as integer-digit arrays) ----

// canonical rotation form key: the lexicographically smallest rotation, encoded as a base-k integer
fn rot_canon(digits: list, n: int, k: int) -> int
    let best = 0 - 1
    let r = 0
    while r < n
        // value of rotation starting at r
        let v = 0
        let i = 0
        while i < n
            v = v * k + digits[(r + i) % n]
            i = i + 1
        if best < 0 or v < best
            best = v
        r = r + 1
    best

// canonical rotation+reflection form
fn bracelet_canon(digits: list, n: int, k: int) -> int
    let best = rot_canon(digits, n, k)
    // reversed
    let rev = []
    let z = 0
    while z < n
        push(rev, digits[n - 1 - z])
        z = z + 1
    let br = rot_canon(rev, n, k)
    if br < best
        best = br
    best

// is this string a Lyndon word (strictly smaller than all proper rotations)?
fn brute_is_lyndon(digits: list, n: int, k: int) -> bool
    let v0 = 0
    let i = 0
    while i < n
        v0 = v0 * k + digits[i]
        i = i + 1
    let out = true
    let r = 1
    while r < n
        let v = 0
        let j = 0
        while j < n
            v = v * k + digits[(r + j) % n]
            j = j + 1
        if v <= v0
            out = false
        r = r + 1
    out

// count distinct necklaces/bracelets/lyndon by brute force over all k^n strings
fn brute_counts(n: int, k: int) -> list
    let total = 1
    let e = 0
    while e < n
        total = total * k
        e = e + 1
    // use dicts as sets of canonical forms
    let neck = {}
    let brac = {}
    let lyn = 0
    let code = 0
    while code < total
        // decode code into n base-k digits
        let digits = []
        let c = code
        let z = 0
        while z < n
            push(digits, c % k)
            c = c / k
            z = z + 1
        neck[str(rot_canon(digits, n, k))] = 1
        brac[str(bracelet_canon(digits, n, k))] = 1
        if brute_is_lyndon(digits, n, k)
            lyn = lyn + 1
        code = code + 1
    [len(keys(neck)), len(keys(brac)), lyn]

fn main()
    // ---- known values ----
    // binary necklaces of length n: 1,2,3,4,6,8,14,20,36,60 for n=1..10
    check(nk.necklace_count(1, 2) == 2, "necklace n=1 k=2")
    check(nk.necklace_count(2, 2) == 3, "necklace n=2 k=2")
    check(nk.necklace_count(3, 2) == 4, "necklace n=3 k=2")
    check(nk.necklace_count(4, 2) == 6, "necklace n=4 k=2")
    check(nk.necklace_count(5, 2) == 8, "necklace n=5 k=2")
    check(nk.necklace_count(6, 2) == 14, "necklace n=6 k=2")
    check(nk.necklace_count(8, 2) == 36, "necklace n=8 k=2")
    // Lyndon words (aperiodic) binary: 2,1,2,3,6,9,18,30 for n=1..8
    check(nk.aperiodic_necklace_count(1, 2) == 2, "lyndon n=1 k=2")
    check(nk.aperiodic_necklace_count(2, 2) == 1, "lyndon n=2 k=2")
    check(nk.aperiodic_necklace_count(4, 2) == 3, "lyndon n=4 k=2")
    check(nk.aperiodic_necklace_count(6, 2) == 9, "lyndon n=6 k=2")
    // bracelets binary (OEIS A000029): n=1..8 -> 2,3,4,6,8,13,18,30
    check(nk.bracelet_count(3, 2) == 4, "bracelet n=3 k=2")
    check(nk.bracelet_count(4, 2) == 6, "bracelet n=4 k=2")
    check(nk.bracelet_count(6, 2) == 13, "bracelet n=6 k=2")
    check(nk.bracelet_count(8, 2) == 30, "bracelet n=8 k=2")

    // ---- EXHAUSTIVE cross-check vs brute force over all n in 1..9, k in 2..3 ----
    let n = 1
    while n <= 9
        let k = 2
        while k <= 3
            let b = brute_counts(n, k)
            check(nk.necklace_count(n, k) == b[0], "necklace matches brute n=" + str(n) + " k=" + str(k))
            check(nk.bracelet_count(n, k) == b[1], "bracelet matches brute n=" + str(n) + " k=" + str(k))
            check(nk.aperiodic_necklace_count(n, k) == b[2], "lyndon matches brute n=" + str(n) + " k=" + str(k))
            k = k + 1
        n = n + 1

    // ---- structural identity: necklace(n,k) == sum over d|n of aperiodic(d,k) ----
    let nn = 1
    while nn <= 12
        let s = 0
        let d = 1
        while d <= nn
            if nn % d == 0
                s = s + nk.aperiodic_necklace_count(d, 2)
            d = d + 1
        check(s == nk.necklace_count(nn, 2), "necklace == sum aperiodic over divisors n=" + str(nn))
        nn = nn + 1

    print("forge_necklace: all passed")
