// KAT: std/data/atom_parse
import std/data/atom_parse

fn cki(label, got, want)
    if got != want
        print("FAIL atom_parse " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL atom_parse " + label + ": got=[" + got + "] want=[" + want + "]")
        exit(1)

// ── Test 1: minimal KAT from spec ───────────────────────────────────────────
// Build: <feed><title>F</title><entry><title>E1</title><link href="http://x/1"/><id>1</id></entry></feed>
// The spec uses escaped \" which in the actual XML is a plain double-quote.
let q = chr(34)
let xml1 = "<feed><title>F</title><entry><title>E1</title><link href=" + q + "http://x/1" + q + "/><id>1</id></entry></feed>"
let feed1 = atom_parse(xml1)

cks("feed_title",         feed1["title"], "F")
let entries1 = feed1["entries"]
cki("entry_count",        len(entries1), 1)
let e0 = entries1[0]
cks("entry0_title",       e0["title"], "E1")
cks("entry0_link",        e0["link"],  "http://x/1")
cks("entry0_id",          e0["id"],    "1")

// ── Test 2: multiple entries with updated field ──────────────────────────────
let xml2 = "<feed><title>Blog</title><entry><title>Post 1</title><link href=" + q + "http://b/1" + q + "/><id>p1</id><updated>2024-01-01</updated></entry><entry><title>Post 2</title><link href=" + q + "http://b/2" + q + "/><id>p2</id><updated>2024-01-02</updated></entry></feed>"
let feed2 = atom_parse(xml2)
cks("blog_title",         feed2["title"], "Blog")
let entries2 = feed2["entries"]
cki("blog_entry_count",   len(entries2), 2)
cks("blog_e0_title",      entries2[0]["title"],   "Post 1")
cks("blog_e0_link",       entries2[0]["link"],    "http://b/1")
cks("blog_e0_id",         entries2[0]["id"],      "p1")
cks("blog_e0_updated",    entries2[0]["updated"], "2024-01-01")
cks("blog_e1_title",      entries2[1]["title"],   "Post 2")
cks("blog_e1_link",       entries2[1]["link"],    "http://b/2")
cks("blog_e1_updated",    entries2[1]["updated"], "2024-01-02")

// ── Test 3: empty feed (no entries) ─────────────────────────────────────────
let xml3 = "<feed><title>Empty</title></feed>"
let feed3 = atom_parse(xml3)
cks("empty_title",        feed3["title"], "Empty")
let entries3 = feed3["entries"]
cki("empty_entry_count",  len(entries3), 0)

// ── Test 4: entry with no link (link defaults to "") ────────────────────────
let xml4 = "<feed><title>T</title><entry><title>No Link</title><id>nl1</id></entry></feed>"
let feed4 = atom_parse(xml4)
let entries4 = feed4["entries"]
cki("nolink_count",       len(entries4), 1)
cks("nolink_link",        entries4[0]["link"], "")
cks("nolink_title",       entries4[0]["title"], "No Link")

print("PASS _atom_parse_test")
