import forge_inbox

fn main()
    let b = inbox_new()
    b = inbox_add(b, "m1", "alice", "Hello")
    b = inbox_add(b, "m2", "bob", "Meeting")
    assert(inbox_total(b) == 2, "2 messages")
    assert(inbox_unread_count(b) == 2, "2 unread")

    let r1 = inbox_read(b, "m1")
    assert(is_ok(r1), "read ok")
    assert(unwrap(r1) == "alice: Hello", "correct content")
    assert(inbox_unread_count(b) == 1, "1 unread after read")
    assert(inbox_is_read(b, "m1") == 1, "m1 is read")

    let r2 = inbox_read(b, "m1")
    assert(is_ok(r2), "re-read ok")
    assert(inbox_unread_count(b) == 1, "still 1 unread")

    let s = inbox_sender(b, "m2")
    assert(is_ok(s), "sender ok")
    assert(unwrap(s) == "bob", "bob is sender")

    let d = inbox_delete(b, "m2")
    assert(is_ok(d), "delete ok")
    b = unwrap(d)
    assert(inbox_total(b) == 1, "1 after delete")
    assert(inbox_unread_count(b) == 0, "0 unread after delete")

    let bad = inbox_read(b, "nope")
    assert(is_err(bad), "not found")

    print("INBOX KAT PASS")
