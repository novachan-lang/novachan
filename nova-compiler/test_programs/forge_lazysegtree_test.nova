import forge_lazysegtree

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    let arr = [1, 2, 3, 4, 5]
    let seg = lseg_build(arr)

    // initial sums
    fails = fails + expect("all", str(lseg_range_sum(seg, 0, 4)), "15")
    fails = fails + expect("mid", str(lseg_range_sum(seg, 1, 3)), "9")
    fails = fails + expect("single", str(lseg_range_sum(seg, 2, 2)), "3")

    // range add
    lseg_range_add(seg, 1, 3, 10)
    fails = fails + expect("after_add_all", str(lseg_range_sum(seg, 0, 4)), "45")
    fails = fails + expect("after_add_mid", str(lseg_range_sum(seg, 1, 3)), "39")
    fails = fails + expect("after_add_0", str(lseg_range_sum(seg, 0, 0)), "1")
    fails = fails + expect("after_add_4", str(lseg_range_sum(seg, 4, 4)), "5")

    // overlapping range add
    lseg_range_add(seg, 0, 4, 1)
    fails = fails + expect("after_add2", str(lseg_range_sum(seg, 0, 4)), "50")

    // brute-force cross-check: naive array with the same range adds, compare every range sum
    let n = 10
    let base = []
    let g = 0
    while g < n
        push(base, g + 1)
        g = g + 1
    let s2 = lseg_build(base)
    let naive = []
    let h = 0
    while h < n
        push(naive, base[h])
        h = h + 1
    // a sequence of range adds
    let ops = []
    push(ops, [2, 7, 5])
    push(ops, [0, 3, 0 - 2])
    push(ops, [4, 9, 3])
    push(ops, [1, 1, 100])
    push(ops, [5, 8, 0 - 1])
    push(ops, [0, 9, 10])
    let o = 0
    while o < len(ops)
        let l = ops[o][0]
        let r = ops[o][1]
        let d = ops[o][2]
        lseg_range_add(s2, l, r, d)
        let k = l
        while k <= r
            naive[k] = naive[k] + d
            k = k + 1
        o = o + 1
    // check every [l,r] range sum
    let ok = 1
    let l1 = 0
    while l1 < n
        let r1 = l1
        while r1 < n
            let bsum = 0
            let m = l1
            while m <= r1
                bsum = bsum + naive[m]
                m = m + 1
            if lseg_range_sum(s2, l1, r1) != bsum
                ok = 0
            r1 = r1 + 1
        l1 = l1 + 1
    fails = fails + expect("brute_all_ranges", str(ok), "1")

    if fails == 0
        print("forge_lazysegtree: all passed")
    else
        print("forge_lazysegtree: " + str(fails) + " FAILED")
