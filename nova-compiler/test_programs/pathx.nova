fn path_join(a, b)
  if len(a) == 0
    return b
  if len(b) == 0
    return a
  let last = slice(a, len(a) - 1, len(a))
  if last == "/" or last == "\\"
    return a + b
  a + "/" + b

fn path_ext(p)
  let i = len(p) - 1
  while i >= 0
    let ch = slice(p, i, i + 1)
    if ch == "."
      return slice(p, i + 1, len(p))
    if ch == "/" or ch == "\\"
      return ""
    i = i - 1
  ""

fn path_basename(p)
  let i = len(p) - 1
  while i >= 0
    let ch = slice(p, i, i + 1)
    if ch == "/" or ch == "\\"
      return slice(p, i + 1, len(p))
    i = i - 1
  p

fn path_dirname(p)
  let i = len(p) - 1
  while i >= 0
    let ch = slice(p, i, i + 1)
    if ch == "/" or ch == "\\"
      return slice(p, 0, i)
    i = i - 1
  "."

fn path_stem(p)
  let base = path_basename(p)
  let i = len(base) - 1
  while i > 0
    if slice(base, i, i + 1) == "."
      return slice(base, 0, i)
    i = i - 1
  base

fn path_is_absolute(p)
  if len(p) == 0
    return 0
  let first = slice(p, 0, 1)
  if first == "/" or first == "\\"
    return 1
  if len(p) >= 3
    let second = slice(p, 1, 2)
    let third = slice(p, 2, 3)
    if second == ":" and (third == "/" or third == "\\")
      return 1
  0

fn main()
  assert(path_join("src", "main.nova") == "src/main.nova", "join basic")
  assert(path_join("src/", "main.nova") == "src/main.nova", "join trailing slash")
  assert(path_join("", "file.txt") == "file.txt", "join empty a")
  assert(path_join("dir", "") == "dir", "join empty b")

  assert(path_ext("file.nova") == "nova", "ext nova")
  assert(path_ext("archive.tar.gz") == "gz", "ext gz")
  assert(path_ext("Makefile") == "", "no ext")
  assert(path_ext("/path/to/file.txt") == "txt", "ext with path")

  assert(path_basename("/home/user/file.txt") == "file.txt", "basename unix")
  assert(path_basename("file.txt") == "file.txt", "basename bare")
  assert(path_basename("dir/sub/name") == "name", "basename no ext")

  assert(path_dirname("/home/user/file.txt") == "/home/user", "dirname unix")
  assert(path_dirname("file.txt") == ".", "dirname bare")
  assert(path_dirname("a/b/c") == "a/b", "dirname nested")

  assert(path_stem("file.nova") == "file", "stem basic")
  assert(path_stem("archive.tar.gz") == "archive.tar", "stem double ext")
  assert(path_stem("Makefile") == "Makefile", "stem no ext")

  assert(path_is_absolute("/usr/bin") == 1, "abs unix")
  assert(path_is_absolute("relative/path") == 0, "rel path")
  assert(path_is_absolute("C:/Windows") == 1, "abs windows")

  print("pathx: all passed")
