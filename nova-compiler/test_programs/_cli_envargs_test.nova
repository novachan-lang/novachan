// KAT for std/cli/cli_envargs — priority-ordered value resolution.
import std/cli/cli_envargs

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let g = "false"
        if got
            g = "true"
        let w = "false"
        if want
            w = "true"
        print("FAIL " + label + ": got=" + g + " want=" + w)
        exit(1)

fn main()
    // ── KAT: spec cases ────────────────────────────────────────────────────
    // cle_resolve(['--port','9'],'--port','8080','3000') = '9'
    let a1 = ["--port", "9"]
    cks("resolve_argv_wins", cle_resolve(a1, "--port", "8080", "3000"), "9")

    // cle_resolve([],'--port','8080','3000') = '8080'
    cks("resolve_env_wins", cle_resolve([], "--port", "8080", "3000"), "8080")

    // cle_resolve([],'--port','','3000') = '3000'
    cks("resolve_fallback", cle_resolve([], "--port", "", "3000"), "3000")

    // cle_present(['--x','1'],'--x','') = true
    let a2 = ["--x", "1"]
    ckb("present_argv", cle_present(a2, "--x", ""), true)

    // cle_present([],'--x','v') = true
    ckb("present_env", cle_present([], "--x", "v"), true)

    // cle_present([],'--x','') = false
    ckb("present_neither", cle_present([], "--x", ""), false)

    // ── Additional edge cases ───────────────────────────────────────────────
    // --name=value form in argv
    let a3 = ["--port=4000"]
    cks("resolve_eq_form", cle_resolve(a3, "--port", "8080", "3000"), "4000")

    // argv present via = form → cle_present true
    ckb("present_eq_form", cle_present(a3, "--port", ""), true)

    // argv option with no following value → ""  (argv present but empty value)
    let a4 = ["--port"]
    let v4 = cle_resolve(a4, "--port", "8080", "3000")
    // argv is present but its value is "" → falls through to env_val
    cks("resolve_argv_empty_val", v4, "8080")

    // all three empty → returns fallback
    cks("resolve_all_empty", cle_resolve([], "--port", "", "default"), "default")

    // argv value takes priority over non-empty env
    let a5 = ["--host", "localhost"]
    cks("resolve_argv_over_env", cle_resolve(a5, "--host", "remotehost", "nohost"), "localhost")

    // unrelated argv tokens don't interfere
    let a6 = ["--verbose", "--port", "7000"]
    cks("resolve_unrelated_tok", cle_resolve(a6, "--port", "8080", "3000"), "7000")
    ckb("present_unrelated_tok", cle_present(a6, "--port", ""), true)
    ckb("present_missing_in_argv", cle_present(a6, "--host", ""), false)

    print("PASS _cli_envargs_test")
