// NOVA LOGGING — structured logging module.
// Provides human-readable and JSON-formatted log output with
// configurable severity levels and arbitrary key-value fields.
//
// Public API:
//   log_level_name(level)                 -> string ("TRACE".."FATAL")
//   log_config()                          -> dict   (default config: level=INFO, format=human)
//   log_set_level(config, level)          -> dict   (returns updated config)
//   log_msg(config, level, msg, fields)   -> string (format message; "" if filtered)
//   log_trace(config, msg, fields)        -> string
//   log_debug(config, msg, fields)        -> string
//   log_info(config, msg, fields)         -> string
//   log_warn(config, msg, fields)         -> string
//   log_error(config, msg, fields)        -> string
//   log_fatal(config, msg, fields)        -> string
//   log_human_format(level, msg, fields)  -> string
//   log_json_format(level, msg, fields)   -> string

// Level constants: 0=TRACE, 1=DEBUG, 2=INFO, 3=WARN, 4=ERROR, 5=FATAL

fn log_level_name(level: int) -> string
    if level == 0
        return "TRACE"
    if level == 1
        return "DEBUG"
    if level == 2
        return "INFO"
    if level == 3
        return "WARN"
    if level == 4
        return "ERROR"
    if level == 5
        return "FATAL"
    "UNKNOWN"

fn _log_level_lower(level: int) -> string
    if level == 0
        return "trace"
    if level == 1
        return "debug"
    if level == 2
        return "info"
    if level == 3
        return "warn"
    if level == 4
        return "error"
    if level == 5
        return "fatal"
    "unknown"

// ── config ───────────────────────────────────────────────────────────────

fn log_config() -> dict
    let cfg = {}
    cfg["level"] = 2
    cfg["format"] = "human"
    cfg

fn log_set_level(config: dict, level: int) -> dict
    config["level"] = level
    config

// ── JSON helpers ─────────────────────────────────────────────────────────
// Minimal JSON escaping for log values. Full JSON lives in a future
// json.nova module; this is just enough for structured log lines.

fn _json_escape(s: string) -> string
    let dq = chr(34)
    let bs = chr(92)
    let out = ""
    let i = 0
    while i < len(s)
        let c = s[i]
        if c == dq
            out = out + bs + dq
        else if c == bs
            out = out + bs + bs
        else if c == chr(10)
            out = out + bs + "n"
        else if c == chr(13)
            out = out + bs + "r"
        else if c == chr(9)
            out = out + bs + "t"
        else
            out = out + c
        i = i + 1
    out

// ── formatters ───────────────────────────────────────────────────────────

fn log_human_format(level: int, msg: string, fields: dict) -> string
    let ts = str(time_ms())
    let line = ts + " [" + log_level_name(level) + "] " + msg
    for k in keys(fields)
        line = line + " " + k + "=" + str(fields[k])
    line

fn log_json_format(level: int, msg: string, fields: dict) -> string
    let q = chr(34)
    let out = "\{" + q + "ts" + q + ":" + str(time_ms())
    out = out + "," + q + "level" + q + ":" + q + _log_level_lower(level) + q
    out = out + "," + q + "msg" + q + ":" + q + _json_escape(msg) + q
    for k in keys(fields)
        out = out + "," + q + _json_escape(k) + q + ":" + q + _json_escape(str(fields[k])) + q
    out = out + "\}"
    out

// ── core log dispatch ────────────────────────────────────────────────────

fn log_msg(config: dict, level: int, msg: string, fields: dict) -> string
    if level < config["level"]
        return ""
    let fmt = config["format"]
    if fmt == "json"
        return log_json_format(level, msg, fields)
    log_human_format(level, msg, fields)

// ── convenience wrappers ─────────────────────────────────────────────────

fn log_trace(config: dict, msg: string, fields: dict) -> string
    log_msg(config, 0, msg, fields)

fn log_debug(config: dict, msg: string, fields: dict) -> string
    log_msg(config, 1, msg, fields)

fn log_info(config: dict, msg: string, fields: dict) -> string
    log_msg(config, 2, msg, fields)

fn log_warn(config: dict, msg: string, fields: dict) -> string
    log_msg(config, 3, msg, fields)

fn log_error(config: dict, msg: string, fields: dict) -> string
    log_msg(config, 4, msg, fields)

fn log_fatal(config: dict, msg: string, fields: dict) -> string
    log_msg(config, 5, msg, fields)
