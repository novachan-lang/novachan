import std/text/ordinal

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // KAT: known-answer tests from spec
    cks("ord_str(1)",   ord_str(1),   "1st")
    cks("ord_str(2)",   ord_str(2),   "2nd")
    cks("ord_str(3)",   ord_str(3),   "3rd")
    cks("ord_str(4)",   ord_str(4),   "4th")
    cks("ord_str(11)",  ord_str(11),  "11th")
    cks("ord_str(12)",  ord_str(12),  "12th")
    cks("ord_str(13)",  ord_str(13),  "13th")
    cks("ord_str(21)",  ord_str(21),  "21st")
    cks("ord_str(22)",  ord_str(22),  "22nd")
    cks("ord_str(23)",  ord_str(23),  "23rd")
    cks("ord_str(101)", ord_str(101), "101st")
    cks("ord_str(111)", ord_str(111), "111th")
    cks("ord_str(113)", ord_str(113), "113th")

    // Extra coverage: suffix-only checks
    cks("ord_suffix(0)",    ord_suffix(0),    "th")
    cks("ord_suffix(5)",    ord_suffix(5),    "th")
    cks("ord_suffix(10)",   ord_suffix(10),   "th")
    cks("ord_suffix(14)",   ord_suffix(14),   "th")
    cks("ord_suffix(100)",  ord_suffix(100),  "th")
    cks("ord_suffix(112)",  ord_suffix(112),  "th")
    cks("ord_str(1001)",    ord_str(1001),    "1001st")

    print("_ordinal_test passed")
