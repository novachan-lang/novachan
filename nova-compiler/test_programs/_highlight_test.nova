import std/text/highlight

// Helper macros: cks(got, expected, label)
fn cks(got, expected, label)
    if got != expected
        print("FAIL " + label + ": got=" + got + " expected=" + expected)
        exit(1)

fn cki(got, expected, label)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

fn main()
    // ── hl_mark KAT ─────────────────────────────────────────────────────────

    // KAT-1: basic single match
    cks(hl_mark("the cat sat", "cat", "[", "]"), "the [cat] sat", "hl_mark basic")

    // KAT-2: every character matches (keyword = "a", 3-char haystack "aaa")
    cks(hl_mark("aaa", "a", "<", ">"), "<a><a><a>", "hl_mark every char")

    // KAT-3: no match -> text unchanged
    cks(hl_mark("abc", "z", "[", "]"), "abc", "hl_mark no match")

    // KAT-4: non-overlapping "aa" in "aaaa" -> exactly 2 matches
    cks(hl_mark("aaaa", "aa", "[", "]"), "[aa][aa]", "hl_mark non-overlapping")

    // KAT-5: keyword at very beginning of string
    cks(hl_mark("catfish", "cat", "(", ")"), "(cat)fish", "hl_mark at start")

    // KAT-6: keyword at very end of string
    cks(hl_mark("a big cat", "cat", "(", ")"), "a big (cat)", "hl_mark at end")

    // KAT-7: empty keyword -> text unchanged
    cks(hl_mark("hello", "", "[", "]"), "hello", "hl_mark empty keyword")

    // KAT-8: empty text -> empty text
    cks(hl_mark("", "a", "[", "]"), "", "hl_mark empty text")

    // KAT-9: multi-char pre/post markers
    cks(hl_mark("say hello", "hello", "**", "**"), "say **hello**", "hl_mark multi-char markers")

    // KAT-10: keyword longer than text -> no match
    cks(hl_mark("hi", "hello", "[", "]"), "hi", "hl_mark kw longer than text")

    // ── hl_count KAT ────────────────────────────────────────────────────────

    // KAT-11: spec example — two non-overlapping "cat"
    cki(hl_count("the cat and cat", "cat"), 2, "hl_count two cats")

    // KAT-12: spec example — non-overlapping "aa" in "aaaa" = 2 (not 3)
    cki(hl_count("aaaa", "aa"), 2, "hl_count non-overlapping aa")

    // KAT-13: zero occurrences
    cki(hl_count("hello world", "xyz"), 0, "hl_count none")

    // KAT-14: empty keyword -> 0
    cki(hl_count("hello", ""), 0, "hl_count empty keyword")

    // KAT-15: single occurrence
    cki(hl_count("abcabc", "abc"), 2, "hl_count abc twice")

    // KAT-16: keyword == entire text
    cki(hl_count("cat", "cat"), 1, "hl_count exact match")

    // ── hl_mark_all KAT ─────────────────────────────────────────────────────

    // KAT-17: spec example — mark "a" and "c" in "a b c"
    cks(hl_mark_all("a b c", ["a", "c"], "*", "*"), "*a* b *c*", "hl_mark_all spec")

    // KAT-18: empty keyword list -> text unchanged
    cks(hl_mark_all("hello world", [], "[", "]"), "hello world", "hl_mark_all empty list")

    // KAT-19: single keyword in list behaves like hl_mark
    cks(hl_mark_all("the cat sat", ["cat"], "[", "]"), "the [cat] sat", "hl_mark_all single kw")

    // KAT-20: two distinct non-overlapping keywords
    cks(hl_mark_all("foo bar baz", ["foo", "baz"], "<", ">"), "<foo> bar <baz>", "hl_mark_all two kw")

    print("_highlight_test passed")
