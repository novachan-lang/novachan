import forge_closestpair

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

// brute-force min squared distance
fn brute(points: list) -> int
    let best = 4611686018427387904
    let i = 0
    while i < len(points)
        let j = i + 1
        while j < len(points)
            let dx = points[i][0] - points[j][0]
            let dy = points[i][1] - points[j][1]
            let d = dx * dx + dy * dy
            if d < best
                best = d
            j = j + 1
        i = i + 1
    best

fn main()
    let fails = 0

    // small exact cases
    let p1 = []
    push(p1, [0, 0])
    push(p1, [3, 4])
    push(p1, [1, 1])
    fails = fails + expect("small", str(closest_pair_dist2(p1)), "2")

    let p2 = []
    push(p2, [0, 0])
    push(p2, [10, 10])
    push(p2, [5, 5])
    push(p2, [5, 6])
    fails = fails + expect("close", str(closest_pair_dist2(p2)), "1")

    // duplicate points -> 0
    let p3 = []
    push(p3, [2, 3])
    push(p3, [7, 8])
    push(p3, [2, 3])
    fails = fails + expect("dup", str(closest_pair_dist2(p3)), "0")

    // two points
    let p4 = []
    push(p4, [0, 0])
    push(p4, [6, 8])
    fails = fails + expect("two", str(closest_pair_dist2(p4)), "100")

    // fewer than 2 -> -1
    let p5 = []
    push(p5, [1, 1])
    fails = fails + expect("one", str(closest_pair_dist2(p5)), "-1")

    // bigger sets cross-checked against brute force
    let big = []
    push(big, [3, 7])
    push(big, [1, 2])
    push(big, [8, 4])
    push(big, [5, 5])
    push(big, [9, 1])
    push(big, [2, 9])
    push(big, [6, 6])
    push(big, [4, 3])
    push(big, [7, 8])
    push(big, [0, 0])
    push(big, [5, 4])
    fails = fails + expect("big_cross", str(closest_pair_dist2(big)), str(brute(big)))

    // another with a tight pair spanning the divide
    let big2 = []
    push(big2, [0, 0])
    push(big2, [10, 0])
    push(big2, [20, 0])
    push(big2, [30, 0])
    push(big2, [15, 1])
    push(big2, [16, 1])
    push(big2, [40, 5])
    push(big2, [41, 6])
    fails = fails + expect("divide_cross", str(closest_pair_dist2(big2)), str(brute(big2)))

    if fails == 0
        print("forge_closestpair: all passed")
    else
        print("forge_closestpair: " + str(fails) + " FAILED")
