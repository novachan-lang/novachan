// Monadic ? on a typed Result: `parse_int_safe(s)?` yields the ok value as a
// concrete int (the refinement), and on the err branch ? early-returns the error.
// Combines typed Result + safe parsing + ? propagation end-to-end.

fn parse_and_double(s)
    let n = parse_int_safe(s)?      // n : int  (? yields T from Sum<int,string>)
    return ok(n * 2)                // -> Result<int, string>

fn sum_two(a, b)
    let x = parse_int_safe(a)?      // short-circuits to err if a is invalid
    let y = parse_int_safe(b)?      // short-circuits to err if b is invalid
    return ok(x + y)

fn main()
    // happy path: ? yields the int, arithmetic works
    let r = parse_and_double("21")
    assert_eq(is_ok(r), 1)
    assert_eq(unwrap(r), 42)

    // error propagation: a bad parse makes ? early-return the err
    let r2 = parse_and_double("xyz")
    assert_eq(is_err(r2), 1)

    // two-step propagation
    assert_eq(unwrap(sum_two("10", "32")), 42)
    assert_eq(is_err(sum_two("10", "bad")), 1)   // second ? short-circuits
    assert_eq(is_err(sum_two("bad", "10")), 1)   // first ? short-circuits

    print("q_propagate_test passed")
