import forge_stablematch as sm

fn check(cond: bool, label: string)
    if cond == false
        print("FAIL: " + label)

// a random permutation of 0..n-1 driven by seed (Fisher-Yates)
fn rand_perm(n: int, seed: int) -> list
    let arr = []
    let i = 0
    while i < n
        push(arr, i)
        i = i + 1
    let s = seed
    let k = n - 1
    while k > 0
        s = (s * 1103515245 + 12345) % 2147483648
        let j = s % (k + 1)
        let tmp = arr[k]
        arr[k] = arr[j]
        arr[j] = tmp
        k = k - 1
    arr

fn main()
    // ---- tiny fixed example n=2 ----
    let mp = sm.stable_matching([[0, 1], [1, 0]], [[0, 1], [1, 0]])
    check(mp[0] == 0 and mp[1] == 1, "n=2 obvious matching")
    check(sm.is_stable([[0, 1], [1, 0]], [[0, 1], [1, 0]], mp), "n=2 result stable")
    check(sm.is_perfect(mp, 2), "n=2 result perfect")
    // the SWAPPED matching must be detected as unstable (M0&W0 form a blocking pair)
    check(sm.is_stable([[0, 1], [1, 0]], [[0, 1], [1, 0]], [1, 0]) == false, "n=2 swapped is unstable")

    // ---- classic 3x3 example ----
    // men prefs, women prefs
    let mpref = [[0, 1, 2], [1, 0, 2], [0, 1, 2]]
    let wpref = [[1, 0, 2], [0, 1, 2], [0, 1, 2]]
    let r3 = sm.stable_matching(mpref, wpref)
    check(sm.is_perfect(r3, 3), "3x3 perfect")
    check(sm.is_stable(mpref, wpref, r3), "3x3 stable")

    // ---- BIG randomized self-check: GS output is ALWAYS a perfect + stable matching ----
    let trial = 0
    while trial < 60
        let n = 2 + (trial % 7)   // sizes 2..8
        // build random preference lists for both sides using distinct seeds
        let pprefs = []
        let rprefs = []
        let i = 0
        while i < n
            push(pprefs, rand_perm(n, 1000 + trial * 100 + i))
            push(rprefs, rand_perm(n, 500000 + trial * 100 + i))
            i = i + 1
        let mtch = sm.stable_matching(pprefs, rprefs)
        check(sm.is_perfect(mtch, n), "trial " + str(trial) + " perfect n=" + str(n))
        check(sm.is_stable(pprefs, rprefs, mtch), "trial " + str(trial) + " stable n=" + str(n))
        trial = trial + 1

    // mismatched sizes (2 proposers, 1 receiver) -> empty
    check(len(sm.stable_matching([[0, 1], [1, 0]], [[0]])) == 0, "size mismatch -> empty")

    print("forge_stablematch: all passed")
