import forge_content_store

fn main()
    let cms = cms_new()
    let fields = ["title", "body", "author"]
    cms = cms_define_type(cms, "article", fields)
    let pfields = ["name", "url"]
    cms = cms_define_type(cms, "page", pfields)
    assert(cms_type_count(cms) == 2, "2 types")

    let d1 = {}
    d1["title"] = "Hello World"
    d1["body"] = "First post"
    d1["author"] = "alice"
    cms = cms_create_entry(cms, "article", d1)
    let id1 = cms_last_id(cms)

    let d2 = {}
    d2["title"] = "Second Post"
    d2["body"] = "More content"
    d2["author"] = "bob"
    cms = cms_create_entry(cms, "article", d2)
    let id2 = cms_last_id(cms)

    assert(cms_entry_count(cms) == 2, "2 entries")

    let e1 = cms_get(cms, id1)
    assert(e1["status"] == "draft", "draft by default")
    assert(e1["data"]["title"] == "Hello World", "title correct")

    cms = cms_publish(cms, id1)
    let e1b = cms_get(cms, id1)
    assert(e1b["status"] == "published", "published")

    let articles = cms_query_type(cms, "article")
    assert(len(articles) == 1, "1 published article")

    cms = cms_publish(cms, id2)
    let articles2 = cms_query_type(cms, "article")
    assert(len(articles2) == 2, "2 published articles")

    cms = cms_update(cms, id1, "title", "Updated Title")
    let e1c = cms_get(cms, id1)
    assert(e1c["data"]["title"] == "Updated Title", "updated title")
    assert(e1c["version"] == 2, "version bumped")

    cms = cms_unpublish(cms, id2)
    let articles3 = cms_query_type(cms, "article")
    assert(len(articles3) == 1, "1 after unpublish")

    print("CONTENT-STORE KAT PASS")
