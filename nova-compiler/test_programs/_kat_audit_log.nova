import forge_audit_log

fn main()
    let log = audit_log_new()
    let m1 = {}
    m1["ip"] = "192.168.1.1"
    log = audit_append(log, "admin", "CREATE", "user/alice", m1)
    let m2 = {}
    m2["field"] = "email"
    log = audit_append(log, "admin", "UPDATE", "user/alice", m2)
    let m3 = {}
    log = audit_append(log, "alice", "READ", "user/alice", m3)
    let m4 = {}
    m4["reason"] = "inactive"
    log = audit_append(log, "admin", "DELETE", "user/bob", m4)

    assert(audit_count(log) == 4, "4 entries")

    let admin_events = audit_query_actor(log, "admin")
    assert(len(admin_events) == 3, "admin has 3")

    let alice_events = audit_query_actor(log, "alice")
    assert(len(alice_events) == 1, "alice has 1")

    let creates = audit_query_action(log, "CREATE")
    assert(len(creates) == 1, "1 create")

    let user_alice = audit_query_resource(log, "user/alice")
    assert(len(user_alice) == 3, "3 events for user/alice")

    let last2 = audit_last_n(log, 2)
    assert(len(last2) == 2, "last 2")
    assert(last2[0]["action"] == "READ", "second to last")
    assert(last2[1]["action"] == "DELETE", "last")

    let summary = audit_summary(log)
    assert(summary["CREATE"] == 1, "1 create")
    assert(summary["UPDATE"] == 1, "1 update")
    assert(summary["READ"] == 1, "1 read")
    assert(summary["DELETE"] == 1, "1 delete")

    let first = admin_events[0]
    assert(first["metadata"]["ip"] == "192.168.1.1", "metadata ip")

    print("AUDIT-LOG KAT PASS")
