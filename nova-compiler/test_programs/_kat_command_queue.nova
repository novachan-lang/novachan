import forge_command_queue

fn main()
    let cq = cq_new()
    cq = cq_enqueue(cq, "create-user", "alice", 1)
    cq = cq_enqueue(cq, "send-email", "welcome", 2)
    cq = cq_enqueue(cq, "update-profile", "bob", 1)
    assert(cq_total_pending(cq) == 3, "3 pending")
    assert(cq_pending_count(cq, 1) == 2, "2 at priority 1")
    assert(cq_pending_count(cq, 2) == 1, "1 at priority 2")

    let cmd = cq_dequeue(cq, 1)
    assert(cmd["found"] == 1, "found cmd")
    assert(cmd["type"] == "create-user", "FIFO first")
    assert(cmd["payload"] == "alice", "correct payload")
    cq = cq_mark_done(cq)
    assert(cq_processed(cq) == 1, "1 processed")
    assert(cq_pending_count(cq, 1) == 1, "1 left at p1")

    let cmd2 = cq_dequeue(cq, 1)
    assert(cmd2["type"] == "update-profile", "second FIFO")
    cq = cq_mark_failed(cq)
    assert(cq_failed(cq) == 1, "1 failed")

    cq = cq_retry(cq, "update-profile", "bob", 1)
    assert(cq_retried(cq) == 1, "1 retried")
    assert(cq_pending_count(cq, 1) == 1, "retried cmd pending")

    let empty = cq_dequeue(cq, 99)
    assert(empty["found"] == 0, "empty queue")

    assert(cq_pending_count(cq, 99) == 0, "no priority 99")

    print("COMMAND-QUEUE KAT PASS")
