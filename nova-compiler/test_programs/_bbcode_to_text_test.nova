import std/text/bbcode_to_text

fn main()
    let nl = chr(10)

    // KAT 1: [b]/[i]/[u]/[s] stripped silently
    let got1 = btxt_convert("[b]hi[/b]")
    if got1 != "hi"
        print("FAIL bbcode_to_text KAT1: got [" + got1 + "]")
        exit(1)

    // KAT 2: [url=X]text[/url] -> "text (X)"
    let got2 = btxt_convert("[url=http://x.com]click[/url]")
    if got2 != "click (http://x.com)"
        print("FAIL bbcode_to_text KAT2: got [" + got2 + "]")
        exit(1)

    // KAT 3: bare [url]text[/url] -> "text" (text doubles as the URL)
    let got3 = btxt_convert("[url]http://x.com[/url]")
    if got3 != "http://x.com"
        print("FAIL bbcode_to_text KAT3: got [" + got3 + "]")
        exit(1)

    // KAT 4: [img]url[/img] -> "[Image: url]"
    let got4 = btxt_convert("[img]http://x.com/1.png[/img]")
    if got4 != "[Image: http://x.com/1.png]"
        print("FAIL bbcode_to_text KAT4: got [" + got4 + "]")
        exit(1)

    // KAT 5: [quote]text[/quote] -> "> text" (single line)
    let got5 = btxt_convert("[quote]said it[/quote]")
    if got5 != "> said it"
        print("FAIL bbcode_to_text KAT5: got [" + got5 + "]")
        exit(1)

    // KAT 6: [quote] over multiple lines -> every line prefixed "> "
    let got6 = btxt_convert("[quote]line1" + nl + "line2[/quote]")
    let exp6 = "> line1" + nl + "> line2"
    if got6 != exp6
        print("FAIL bbcode_to_text KAT6: got [" + got6 + "]")
        exit(1)

    // KAT 7: [code]text[/code] -> 4-space indented, verbatim (not re-parsed)
    let got7 = btxt_convert("[code]a=1[/code]")
    if got7 != "    a=1"
        print("FAIL bbcode_to_text KAT7: got [" + got7 + "]")
        exit(1)

    // KAT 8: [list][*]a[*]b[/list] -> "- a" NL "- b"
    let got8 = btxt_convert("[list][*]a[*]b[/list]")
    let exp8 = "- a" + nl + "- b"
    if got8 != exp8
        print("FAIL bbcode_to_text KAT8: got [" + got8 + "]")
        exit(1)

    // KAT 9: [color=X] wrapping [b] — both stripped, nested content survives
    let got9 = btxt_convert("[color=red][b]hot[/b][/color]")
    if got9 != "hot"
        print("FAIL bbcode_to_text KAT9: got [" + got9 + "]")
        exit(1)

    // KAT 10: plain text with no tags passes through unchanged
    let got10 = btxt_convert("plain text, no tags")
    if got10 != "plain text, no tags"
        print("FAIL bbcode_to_text KAT10: got [" + got10 + "]")
        exit(1)

    // KAT 11: unrecognized tag passes through as literal text
    let got11 = btxt_convert("[foo]hi[/foo]")
    if got11 != "[foo]hi[/foo]"
        print("FAIL bbcode_to_text KAT11: got [" + got11 + "]")
        exit(1)

    print("PASS _bbcode_to_text_test")
