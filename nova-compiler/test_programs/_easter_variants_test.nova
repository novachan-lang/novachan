import std/calendar/easter_variants

fn main()
    // ── easter_western KAT vectors ───────────────────────────────────────────

    // 2024: March 31
    let ew24 = easter_western(2024)
    let ew24_y = ew24[0]
    let ew24_m = ew24[1]
    let ew24_d = ew24[2]
    if ew24_y != 2024 or ew24_m != 3 or ew24_d != 31
        print("FAIL easter_variants easter_western(2024): got " + str(ew24_y) + "-" + str(ew24_m) + "-" + str(ew24_d) + " want 2024-3-31")
        exit(1)

    // 2025: April 20
    let ew25 = easter_western(2025)
    let ew25_y = ew25[0]
    let ew25_m = ew25[1]
    let ew25_d = ew25[2]
    if ew25_y != 2025 or ew25_m != 4 or ew25_d != 20
        print("FAIL easter_variants easter_western(2025): got " + str(ew25_y) + "-" + str(ew25_m) + "-" + str(ew25_d) + " want 2025-4-20")
        exit(1)

    // 2027: March 28
    let ew27 = easter_western(2027)
    let ew27_y = ew27[0]
    let ew27_m = ew27[1]
    let ew27_d = ew27[2]
    if ew27_y != 2027 or ew27_m != 3 or ew27_d != 28
        print("FAIL easter_variants easter_western(2027): got " + str(ew27_y) + "-" + str(ew27_m) + "-" + str(ew27_d) + " want 2027-3-28")
        exit(1)

    // Extra: 2000 = April 23 (well-known)
    let ew00 = easter_western(2000)
    let ew00_y = ew00[0]
    let ew00_m = ew00[1]
    let ew00_d = ew00[2]
    if ew00_y != 2000 or ew00_m != 4 or ew00_d != 23
        print("FAIL easter_variants easter_western(2000): got " + str(ew00_y) + "-" + str(ew00_m) + "-" + str(ew00_d) + " want 2000-4-23")
        exit(1)

    // ── easter_orthodox KAT vectors ──────────────────────────────────────────

    // 2024: May 5 (Gregorian)
    let eo24 = easter_orthodox(2024)
    let eo24_y = eo24[0]
    let eo24_m = eo24[1]
    let eo24_d = eo24[2]
    if eo24_y != 2024 or eo24_m != 5 or eo24_d != 5
        print("FAIL easter_variants easter_orthodox(2024): got " + str(eo24_y) + "-" + str(eo24_m) + "-" + str(eo24_d) + " want 2024-5-5")
        exit(1)

    // Orthodox is on or after Western in most years:
    // 2024: Western=Mar 31, Orthodox=May 5 → orth >= west ✓
    // 2025: Western=Apr 20, Orthodox=Apr 20 (same day, coincidence year) — skip strict check
    // Check Orthodox >= Western by comparing JDN equivalent (month*100+day suffices for same year)
    let eo25 = easter_orthodox(2025)
    let eo25_m = eo25[1]
    let eo25_d = eo25[2]
    let eo25_cmp = eo25_m * 100 + eo25_d
    let ew25_cmp = ew25_m * 100 + ew25_d
    if eo25_cmp < ew25_cmp
        print("FAIL easter_variants orthodox(2025) before western: orth=" + str(eo25_m) + "-" + str(eo25_d) + " west=" + str(ew25_m) + "-" + str(ew25_d))
        exit(1)

    // Extra: 2000 Orthodox = April 30 (Gregorian), Western = April 23 → orth >= west ✓
    let eo00 = easter_orthodox(2000)
    let eo00_m = eo00[1]
    let eo00_d = eo00[2]
    let eo00_cmp = eo00_m * 100 + eo00_d
    let ew00_cmp = ew00_m * 100 + ew00_d
    if eo00_cmp < ew00_cmp
        print("FAIL easter_variants orthodox(2000) before western: orth=" + str(eo00_m) + "-" + str(eo00_d) + " west=" + str(ew00_m) + "-" + str(ew00_d))
        exit(1)

    print("PASS _easter_variants_test")
