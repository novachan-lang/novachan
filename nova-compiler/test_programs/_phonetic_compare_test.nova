import std/phonetic/phonetic_compare

fn cks(label, got, want)
    if got != want
        print("FAIL phonetic_compare " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL phonetic_compare " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckf: float tolerance check.
fn ckf(label, got, want, eps)
    let diff = got - want
    if diff < 0.0
        diff = 0.0 - diff
    if diff > eps
        print("FAIL phonetic_compare " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── pc_soundex ────────────────────────────────────────────────────────────
    // NARA canonical KAT: Robert -> R163.
    cks("soundex_robert",   pc_soundex("Robert"),   "R163")
    cks("soundex_rupert",   pc_soundex("Rupert"),   "R163")
    cks("soundex_rubin",    pc_soundex("Rubin"),    "R150")
    cks("soundex_euler",    pc_soundex("Euler"),    "E460")
    cks("soundex_honeyman", pc_soundex("Honeyman"), "H555")
    cks("soundex_lee",      pc_soundex("Lee"),      "L000")
    cks("soundex_lloyd",    pc_soundex("Lloyd"),    "L300")
    cks("soundex_single",   pc_soundex("A"),        "A000")
    cks("soundex_empty",    pc_soundex(""),         "0000")

    // ── pc_same_soundex ───────────────────────────────────────────────────────
    // Robert and Rupert share R163.
    cki("same_soundex_robert_rupert", pc_same_soundex("Robert", "Rupert"), 1)
    // Robert and Rubin do NOT share a code.
    cki("same_soundex_robert_rubin",  pc_same_soundex("Robert", "Rubin"),  0)
    // Smith and Smyth map to the same Soundex code.
    cki("same_soundex_smith_smyth",   pc_same_soundex("Smith", "Smyth"),   1)

    // ── pc_edit_distance ──────────────────────────────────────────────────────
    // Classic: kitten -> sitting = 3.
    cki("edit_kitten_sitting", pc_edit_distance("kitten", "sitting"), 3)
    // flaw -> lawn = 2 (delete f, insert n).
    cki("edit_flaw_lawn", pc_edit_distance("flaw", "lawn"), 2)
    // Identical strings -> 0.
    cki("edit_identical", pc_edit_distance("abc", "abc"), 0)
    // One empty -> length of other.
    cki("edit_empty_a", pc_edit_distance("", "abc"), 3)
    cki("edit_empty_b", pc_edit_distance("abc", ""), 3)
    // Both empty -> 0.
    cki("edit_both_empty", pc_edit_distance("", ""), 0)

    // ── pc_jaro ───────────────────────────────────────────────────────────────
    // Published Jaro (1989) KAT: MARTHA vs MARHTA = 0.944.
    let j1 = pc_jaro("MARTHA", "MARHTA")
    ckf("jaro_martha_marhta", j1, 0.944444, 0.001)

    // DWAYNE vs DUANE = 0.822.
    let j2 = pc_jaro("DWAYNE", "DUANE")
    ckf("jaro_dwayne_duane", j2, 0.822222, 0.001)

    // Identical -> 1.0.
    let j3 = pc_jaro("abc", "abc")
    ckf("jaro_identical", j3, 1.0, 0.001)

    // No matches -> 0.0.
    let j4 = pc_jaro("abc", "xyz")
    ckf("jaro_no_match", j4, 0.0, 0.001)

    // Both empty -> 1.0.
    let j5 = pc_jaro("", "")
    ckf("jaro_both_empty", j5, 1.0, 0.001)

    // One empty -> 0.0.
    let j6 = pc_jaro("hello", "")
    ckf("jaro_one_empty", j6, 0.0, 0.001)

    // ── pc_common_prefix_len ──────────────────────────────────────────────────
    // MARTHA vs MARHTA: M,A,R match; then T != H -> 3.
    cki("prefix_martha_marhta", pc_common_prefix_len("MARTHA", "MARHTA"), 3)
    // Both empty -> 0.
    cki("prefix_both_empty", pc_common_prefix_len("", ""), 0)
    // Completely different -> 0.
    cki("prefix_no_match", pc_common_prefix_len("ABC", "XYZ"), 0)
    // Long common prefix capped at 4.
    cki("prefix_cap4", pc_common_prefix_len("ABCDEFG", "ABCDEFG"), 4)

    // ── pc_jaro_winkler ───────────────────────────────────────────────────────
    // MARTHA vs MARHTA: jaro=0.944, prefix=3, winkler=0.944+3*0.1*(1-0.944)=0.961.
    let jw1 = pc_jaro_winkler("MARTHA", "MARHTA")
    ckf("jwinkler_martha_marhta", jw1, 0.961111, 0.001)

    // DWAYNE vs DUANE: jaro=0.822, prefix=1 (D only), winkler=0.822+0.1*(0.178)=0.840.
    let jw2 = pc_jaro_winkler("DWAYNE", "DUANE")
    ckf("jwinkler_dwayne_duane", jw2, 0.840000, 0.001)

    // Identical -> 1.0.
    let jw3 = pc_jaro_winkler("abc", "abc")
    ckf("jwinkler_identical", jw3, 1.0, 0.001)

    // ── pc_match ──────────────────────────────────────────────────────────────
    // Smith / Smyth: high jaro-winkler + same Soundex -> well above 0.8.
    cki("match_smith_smyth_08", pc_match("Smith", "Smyth", 0.8), 1)

    // Completely different names should NOT match at 0.9 threshold.
    cki("match_smith_jones_09", pc_match("Smith", "Jones", 0.9), 0)

    // Identical names always match at any threshold.
    cki("match_identical_099", pc_match("Robert", "Robert", 0.99), 1)

    // ── pc_similarity sanity ──────────────────────────────────────────────────
    // Identical strings -> 1.0.
    let s1 = pc_similarity("Smith", "Smith")
    ckf("sim_identical", s1, 1.0, 0.001)

    // Completely different -> near 0.
    let s2 = pc_similarity("Smith", "Zzzzz")
    let sim_low = 0
    if s2 < 0.5
        sim_low = 1
    cki("sim_different_low", sim_low, 1)

    print("PASS _phonetic_compare_test")
