import std/devtool/gitignore_common

// _list_contains(lst, val) -> int : 1 if val occurs anywhere in lst, else 0.
fn _list_contains(lst: list, val: string) -> int
    let i = 0
    let n = len(lst)
    let found = 0
    while i < n
        if lst[i] == val
            found = 1
        i = i + 1
    return found

// _count_exact_lines(text, line) -> int : number of "\n"-split lines of `text` equal to `line`.
fn _count_exact_lines(text: string, line: string) -> int
    let lines = split(text, "\n")
    let i = 0
    let n = len(lines)
    let count = 0
    while i < n
        if lines[i] == line
            count = count + 1
        i = i + 1
    return count

fn main()
    // --- gic_python ---
    let py = gic_python()
    if find(py, "# Python") != 0
        print("FAIL gic_python-header: got find=" + str(find(py, "# Python")) + " want 0")
        exit(1)
    if find(py, "__pycache__/") == -1
        print("FAIL gic_python-pattern: __pycache__/ not found")
        exit(1)

    // --- gic_node ---
    let node = gic_node()
    if find(node, "# Node") != 0
        print("FAIL gic_node-header: got find=" + str(find(node, "# Node")) + " want 0")
        exit(1)
    if find(node, "node_modules/") == -1
        print("FAIL gic_node-pattern: node_modules/ not found")
        exit(1)

    // --- gic_java ---
    let java = gic_java()
    if find(java, "*.class") == -1
        print("FAIL gic_java-pattern: *.class not found")
        exit(1)

    // --- gic_rust ---
    let rust = gic_rust()
    if find(rust, "target/") == -1
        print("FAIL gic_rust-pattern: target/ not found")
        exit(1)

    // --- gic_go ---
    let go = gic_go()
    if find(go, "*.exe") == -1
        print("FAIL gic_go-pattern: *.exe not found")
        exit(1)

    // --- gic_general ---
    let general = gic_general()
    if find(general, ".DS_Store") == -1
        print("FAIL gic_general-pattern: .DS_Store not found")
        exit(1)

    // --- gic_lines ---
    let py_lines = gic_lines(py)
    if py_lines[0] == "# Python"
        print("FAIL gic_lines-header-not-dropped: first elem is '" + py_lines[0] + "'")
        exit(1)
    if _list_contains(py_lines, "__pycache__/") != 1
        print("FAIL gic_lines-missing-pattern: __pycache__/ not in gic_lines(gic_python())")
        exit(1)

    // --- gic_merge: headers preserved ---
    let templates = [gic_python(), gic_node()]
    let merged = gic_merge(templates)
    if find(merged, "# Python") == -1
        print("FAIL gic_merge-missing-python-header")
        exit(1)
    if find(merged, "# Node") == -1
        print("FAIL gic_merge-missing-node-header")
        exit(1)

    // --- gic_merge: dedup ---
    // "dist/" appears in BOTH gic_python() and gic_node() — after merge+dedup it must
    // appear exactly once as its own line, not twice.
    let dist_count = _count_exact_lines(merged, "dist/")
    if dist_count != 1
        print("FAIL gic_merge-dedup: 'dist/' appears " + str(dist_count) + " times, want 1")
        exit(1)

    // non-duplicate patterns from each side still present exactly once
    let pycache_count = _count_exact_lines(merged, "__pycache__/")
    if pycache_count != 1
        print("FAIL gic_merge-keep-unique-python: __pycache__/ appears " + str(pycache_count) + " times, want 1")
        exit(1)
    let nodemod_count = _count_exact_lines(merged, "node_modules/")
    if nodemod_count != 1
        print("FAIL gic_merge-keep-unique-node: node_modules/ appears " + str(nodemod_count) + " times, want 1")
        exit(1)

    print("PASS _gitignore_common_test")
