import std/random/mt19937

// KAT 1: ANCHOR — seed 5489, first three outputs must match reference MT19937 values.
fn test_anchor()
    let rng = mt_seed(5489)
    let v1  = mt_next(rng)
    let v2  = mt_next(rng)
    let v3  = mt_next(rng)
    if v1 != 3499211612
        print("FAIL mt19937 anchor1: got "+str(v1)+" want 3499211612")
        exit(1)
    if v2 != 581869302
        print("FAIL mt19937 anchor2: got "+str(v2)+" want 581869302")
        exit(1)
    if v3 != 3890346734
        print("FAIL mt19937 anchor3: got "+str(v3)+" want 3890346734")
        exit(1)

// KAT 2: DETERMINISM — two generators seeded the same produce identical outputs.
fn test_determinism()
    let rng1 = mt_seed(42)
    let rng2 = mt_seed(42)
    let k    = 0
    while k < 5
        let a = mt_next(rng1)
        let b = mt_next(rng2)
        if a != b
            print("FAIL mt19937 determinism at k="+str(k)+": got "+str(a)+" vs "+str(b))
            exit(1)
        k = k + 1

// KAT 3: RANGE — mt_next_range(rng, n) must stay in [0, n).
fn test_range()
    let rng = mt_seed(123)
    let k   = 0
    while k < 1000
        let n = (k % 99) + 2
        let v = mt_next_range(rng, n)
        if v < 0
            print("FAIL mt19937 range negative: v="+str(v)+" n="+str(n))
            exit(1)
        if v >= n
            print("FAIL mt19937 range too large: v="+str(v)+" n="+str(n))
            exit(1)
        k = k + 1

// KAT 4: TWIST — verify outputs survive past the first block (twist > 624 values).
fn test_twist()
    let rng = mt_seed(5489)
    let k   = 0
    while k < 623
        mt_next(rng)
        k = k + 1
    // word 624 triggers a second twist; just check it doesn't crash and is 32-bit.
    let v = mt_next(rng)
    if v < 0
        print("FAIL mt19937 twist: negative value "+str(v))
        exit(1)
    if v > 4294967295
        print("FAIL mt19937 twist: value exceeds 32-bit "+str(v))
        exit(1)

fn main()
    test_anchor()
    test_determinism()
    test_range()
    test_twist()
    print("PASS _mt19937_test")
