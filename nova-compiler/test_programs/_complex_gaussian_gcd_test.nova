import std/complex/complex_gaussian_gcd

// cki — assert integer equality
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _complex_gaussian_gcd_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb — assert bool equality
fn ckb(label: string, got: bool, want: bool)
    if got != want
        print("FAIL _complex_gaussian_gcd_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// cks — assert string equality
fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL _complex_gaussian_gcd_test " + label + ": got=" + got + " want=" + want)
        exit(1)

// cxg_norm([1,2]) = 1+4 = 5
let z12 = []
push(z12, 1)
push(z12, 2)
cki("norm_1_2", cxg_norm(z12), 5)

// cxg_norm([3,4]) = 9+16 = 25
let z34 = []
push(z34, 3)
push(z34, 4)
cki("norm_3_4", cxg_norm(z34), 25)

// cxg_norm([0,0]) = 0
let z00 = []
push(z00, 0)
push(z00, 0)
cki("norm_0_0", cxg_norm(z00), 0)

// cxg_divmod([2,4], [1,2]): (2+4i)/(1+2i) = (2+4i)(1-2i)/5 = (2+8+4i-4i)/5 = 10/5 = 2
// q=[2,0], r=[0,0]
let a24 = []
push(a24, 2)
push(a24, 4)
let b12 = []
push(b12, 1)
push(b12, 2)
let dm1 = cxg_divmod(a24, b12)
let q1 = dm1[0]
let r1 = dm1[1]
cki("divmod_q_re", q1[0], 2)
cki("divmod_q_im", q1[1], 0)
cki("divmod_r_re", r1[0], 0)
cki("divmod_r_im", r1[1], 0)

// cxg_gcd_norm([1,2], [2,4]) = 5 (2+4i = 2*(1+2i), gcd = 1+2i up to unit, norm=5)
let a1 = []
push(a1, 1)
push(a1, 2)
let b1 = []
push(b1, 2)
push(b1, 4)
cki("gcd_norm_1p2i_2p4i", cxg_gcd_norm(a1, b1), 5)

// cxg_gcd_norm([5,0], [1,2]) = 5 (5 = (1+2i)(1-2i), gcd = 1+2i up to unit, norm=5)
let a2 = []
push(a2, 5)
push(a2, 0)
let b2 = []
push(b2, 1)
push(b2, 2)
cki("gcd_norm_5_1p2i", cxg_gcd_norm(a2, b2), 5)

// cxg_gcd_norm([2,0], [0,2]) = 4 (gcd = 2, norm = 4)
let a3 = []
push(a3, 2)
push(a3, 0)
let b3 = []
push(b3, 0)
push(b3, 2)
cki("gcd_norm_2_2i", cxg_gcd_norm(a3, b3), 4)

// cxg_gcd_norm([3,0], [1,1]) = 1 (coprime)
let a4 = []
push(a4, 3)
push(a4, 0)
let b4 = []
push(b4, 1)
push(b4, 1)
cki("gcd_norm_3_1p1i", cxg_gcd_norm(a4, b4), 1)

print("PASS _complex_gaussian_gcd_test")
