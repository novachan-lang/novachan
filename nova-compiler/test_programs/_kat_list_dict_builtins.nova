fn main()
    let pass = true

    // list basics
    let lst = [10, 20, 30, 40, 50]
    if len(lst) != 5
        print("FAIL: list len")
        pass = false

    // list_sort
    let unsorted = [3, 1, 4, 1, 5, 9, 2, 6]
    let sorted_l = list_sort(unsorted)
    if sorted_l[0] != 1 or sorted_l[1] != 1 or sorted_l[7] != 9
        print("FAIL: list_sort")
        pass = false

    // list_reverse
    let rev = list_reverse([1, 2, 3])
    if rev[0] != 3 or rev[1] != 2 or rev[2] != 1
        print("FAIL: list_reverse")
        pass = false

    // list_slice
    let sl = list_slice(lst, 1, 3)
    if len(sl) != 2 or sl[0] != 20 or sl[1] != 30
        print("FAIL: list_slice")
        pass = false

    // index_of
    if index_of(lst, 30) != 2
        print("FAIL: index_of")
        pass = false
    if index_of(lst, 99) != -1
        print("FAIL: index_of miss")
        pass = false

    // list_min / list_max
    if list_min([5, 3, 7, 1, 9]) != 1
        print("FAIL: list_min")
        pass = false
    if list_max([5, 3, 7, 1, 9]) != 9
        print("FAIL: list_max")
        pass = false

    // range
    let r = range(5)
    if len(r) != 5
        print("FAIL: range len")
        pass = false
    if r[0] != 0 or r[4] != 4
        print("FAIL: range vals")
        pass = false

    // map
    let doubled = map([1, 2, 3], fn(x) x * 2)
    if doubled[0] != 2 or doubled[1] != 4 or doubled[2] != 6
        print("FAIL: map")
        pass = false

    // filter
    let evens = filter([1, 2, 3, 4, 5], fn(x) x % 2 == 0)
    if len(evens) != 2 or evens[0] != 2 or evens[1] != 4
        print("FAIL: filter")
        pass = false

    // sum
    if sum([1, 2, 3, 4, 5]) != 15
        print("FAIL: sum")
        pass = false

    // sort
    let s = sort(["c", "a", "b"])
    if s[0] != "a" or s[1] != "b" or s[2] != "c"
        print("FAIL: sort strings")
        pass = false

    // dict basics
    let d = {"x": 10, "y": 20, "z": 30}
    if len(keys(d)) != 3
        print("FAIL: dict keys len")
        pass = false
    if d["x"] != 10
        print("FAIL: dict get")
        pass = false

    // contains (dict)
    if not contains(d, "y")
        print("FAIL: contains dict key")
        pass = false
    if contains(d, "w")
        print("FAIL: contains dict miss")
        pass = false

    // values
    let vals = values(d)
    if len(vals) != 3
        print("FAIL: dict values len")
        pass = false

    // items
    let itms = items(d)
    if len(itms) != 3
        print("FAIL: dict items len")
        pass = false

    // dict_merge
    let d1 = {"a": 1}
    let d2 = {"b": 2}
    let merged = dict_merge(d1, d2)
    if len(keys(merged)) != 2
        print("FAIL: dict_merge")
        pass = false

    // json round-trip
    let obj = {"name": "test", "val": 42}
    let json_str = json_stringify(obj)
    let parsed = json_parse(json_str)
    if parsed["name"] != "test" or parsed["val"] != 42
        print("FAIL: json round-trip")
        pass = false

    if pass
        print("PASS _kat_list_dict_builtins")
    else
        print("FAIL _kat_list_dict_builtins")
