// L1 Phase-1: declarative routing (@get/@post/...). The compiler collects annotated handlers and
// generates __nova_register_routes(a) which registers each on the Forge app via get/post. Spring's
// @GetMapping in NOVA. Offline-verified via dispatch() (no socket).
import forge

@get("/hello")
fn h_hello(req) -> string
    "HELLO-BODY"

@post("/echo")
fn h_echo(req) -> string
    "ECHO-BODY"

fn main()
    let a = app()
    a = __nova_register_routes(a)
    let r1 = dispatch(a, "GET", "/hello", "")
    if not contains(r1, "HELLO-BODY")
        print("FAIL get: [" + r1 + "]")
        exit(1)
    let r2 = dispatch(a, "POST", "/echo", "")
    if not contains(r2, "ECHO-BODY")
        print("FAIL post: [" + r2 + "]")
        exit(1)
    // method-guard: GET on a POST-only route must NOT reach the handler
    let r3 = dispatch(a, "GET", "/echo", "")
    if contains(r3, "ECHO-BODY")
        print("FAIL method-guard: GET /echo hit the POST handler")
        exit(1)
    print("PASS _aroute_test")
