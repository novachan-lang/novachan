let s = "Hello, World!"

assert(s[0] == "H", "first char")
assert(s[-1] == "!", "last char")
assert(len(s) == 13, "length")

let up = upper(s)
assert(up == "HELLO, WORLD!", "upper")

let lo = lower(s)
assert(lo == "hello, world!", "lower")

let trimmed = trim("  hi  ")
assert(trimmed == "hi", "trim")

let rep = repeat("ab", 3)
assert(rep == "ababab", "repeat")

let indent = repeat("  ", 4)
assert(indent == "        ", "indent repeat")

let count = 0
for c in s
    count = count + 1
assert(count == 13, "string iteration count")

let reversed = ""
for c in "nova"
    reversed = c + reversed
assert(reversed == "avon", "reverse via iteration")

let sub = slice(s, 0, 5)
assert(sub == "Hello", "slice")

assert(starts_with(s, "Hello"), "starts_with")
assert(ends_with(s, "World!"), "ends_with")
assert(contains(s, "World"), "contains")

let idx = find(s, "World")
assert(idx == 7, "find")

let replaced = replace(s, "World", "NOVA")
assert(replaced == "Hello, NOVA!", "replace")

let parts = split("a,b,c", ",")
assert(len(parts) == 3, "split length")
assert(parts[0] == "a", "split[0]")
assert(parts[2] == "c", "split[2]")

let joined = join(parts, "-")
assert(joined == "a-b-c", "join")

print("All string operations passed!")
