// Wave-B #6 part 3 — MOVE-on-insert. A FRESH OWNED TEMP inserted into a container:
// the container takes its OWN +1 (list_append_no_rc's elision was DISABLED as unsound in
// CORE_GAP 0.10, so insert universally retains), but the temp's original +1 was never
// released -> leaked. Dropping our +1 after the insert is correct MOVE semantics: the
// container becomes the sole owner.
//
// n starts >= 10000 so str(n) is a REAL allocation, not the small-int cache.
fn main()
    // (1) push a fresh temp into a list that is itself rebound each iteration
    let acc = 0
    let b0 = live_count()
    let i = 100000
    while i < 101000
        let tmp = []
        tmp.push("row-" + str(i))
        acc = acc + len(tmp)
        i = i + 1
    print("acc=" + str(acc))
    print("push-temp delta over 1000 iters = " + str(live_count() - b0))

    // (2) dict-set a fresh temp value
    let b1 = live_count()
    let j = 200000
    while j < 201000
        let d = {}
        d["k"] = "val-" + str(j)
        acc = acc + len(d)
        j = j + 1
    print("dictset-temp delta over 1000 iters = " + str(live_count() - b1))

    // (3) CORRECTNESS GUARD: inserted values must still be readable and correct.
    let keep = []
    let m = 300000
    while m < 300005
        keep.push("keep-" + str(m))
        m = m + 1
    print("inserted readable: " + str(keep))
    print("inserted count: " + str(len(keep)))

    // (4) GUARD: a temp used TWICE (inserted AND read) must NOT be dropped.
    let two = []
    let s = "shared-" + str(400000)
    two.push(s)
    print("two-use still readable: " + s + " / " + str(two))
