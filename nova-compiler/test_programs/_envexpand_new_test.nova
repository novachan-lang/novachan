// KAT for std/os/envexpand — env_expand / env_vars_used API.
import std/os/envexpand

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL _envexpand_new_test " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn main()
    let dollar = chr(36)
    let ob = chr(123)
    let cb = chr(125)

    // $HOME/x -> /h/x
    let r1 = env_expand(dollar + "HOME/x", {"HOME": "/h"})
    cks("bare_home", r1, "/h/x")

    // ${A}-${B} -> 1-2
    let s2 = dollar + ob + "A" + cb + "-" + dollar + ob + "B" + cb
    let r2 = env_expand(s2, {"A": "1", "B": "2"})
    cks("two_braced", r2, "1-2")

    // ${X:-def} with X missing -> def
    let s3 = dollar + ob + "X:-def" + cb
    let r3 = env_expand(s3, {})
    cks("default_missing", r3, "def")

    // ${X:-def} with X present -> y
    let r4 = env_expand(s3, {"X": "y"})
    cks("default_present", r4, "y")

    // missing $VAR with no default -> ""
    let r5 = env_expand(dollar + "NOVAR", {})
    cks("missing_no_default", r5, "")

    // env_vars_used: $A/${B} contains A and B
    let svars = dollar + "A/" + dollar + ob + "B" + cb
    let vs = env_vars_used(svars)
    if len(vs) != 2
        print("FAIL _envexpand_new_test vars_len: got=" + str(len(vs)) + " want=2")
        exit(1)
    cks("vars_0", vs[0], "A")
    cks("vars_1", vs[1], "B")

    print("PASS _envexpand_new_test")
