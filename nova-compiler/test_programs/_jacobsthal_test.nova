import std/math/jacobsthal

// KAT: jb_jacobsthal
let j0 = jb_jacobsthal(0)
if j0 != 0
    print("FAIL jb_jacobsthal(0) expected 0 got " + str(j0))
    exit(1)

let j1 = jb_jacobsthal(1)
if j1 != 1
    print("FAIL jb_jacobsthal(1) expected 1 got " + str(j1))
    exit(1)

let j2 = jb_jacobsthal(2)
if j2 != 1
    print("FAIL jb_jacobsthal(2) expected 1 got " + str(j2))
    exit(1)

let j3 = jb_jacobsthal(3)
if j3 != 3
    print("FAIL jb_jacobsthal(3) expected 3 got " + str(j3))
    exit(1)

let j4 = jb_jacobsthal(4)
if j4 != 5
    print("FAIL jb_jacobsthal(4) expected 5 got " + str(j4))
    exit(1)

let j5 = jb_jacobsthal(5)
if j5 != 11
    print("FAIL jb_jacobsthal(5) expected 11 got " + str(j5))
    exit(1)

let j6 = jb_jacobsthal(6)
if j6 != 21
    print("FAIL jb_jacobsthal(6) expected 21 got " + str(j6))
    exit(1)

// KAT: jb_lucas
let l0 = jb_lucas(0)
if l0 != 2
    print("FAIL jb_lucas(0) expected 2 got " + str(l0))
    exit(1)

let l3 = jb_lucas(3)
if l3 != 7
    print("FAIL jb_lucas(3) expected 7 got " + str(l3))
    exit(1)

// KAT: jb_list(6) == [0,1,1,3,5,11]
let lst = jb_list(6)
let lst_len = len(lst)
if lst_len != 6
    print("FAIL jb_list(6) length expected 6 got " + str(lst_len))
    exit(1)

let e0 = lst[0]
if e0 != 0
    print("FAIL jb_list(6)[0] expected 0 got " + str(e0))
    exit(1)

let e1 = lst[1]
if e1 != 1
    print("FAIL jb_list(6)[1] expected 1 got " + str(e1))
    exit(1)

let e2 = lst[2]
if e2 != 1
    print("FAIL jb_list(6)[2] expected 1 got " + str(e2))
    exit(1)

let e3 = lst[3]
if e3 != 3
    print("FAIL jb_list(6)[3] expected 3 got " + str(e3))
    exit(1)

let e4 = lst[4]
if e4 != 5
    print("FAIL jb_list(6)[4] expected 5 got " + str(e4))
    exit(1)

let e5 = lst[5]
if e5 != 11
    print("FAIL jb_list(6)[5] expected 11 got " + str(e5))
    exit(1)

// Additional: jb_list(0) == []
let lst0 = jb_list(0)
let lst0_len = len(lst0)
if lst0_len != 0
    print("FAIL jb_list(0) length expected 0 got " + str(lst0_len))
    exit(1)

// Additional: jb_lucas(1) == 1
let l1 = jb_lucas(1)
if l1 != 1
    print("FAIL jb_lucas(1) expected 1 got " + str(l1))
    exit(1)

// Additional: jb_lucas(2) == 1*1 + 2*2 = 1+4 = 5
let l2 = jb_lucas(2)
if l2 != 5
    print("FAIL jb_lucas(2) expected 5 got " + str(l2))
    exit(1)

print("_jacobsthal_test passed")
