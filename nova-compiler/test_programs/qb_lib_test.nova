import qb

// Validation for the qb query builder. Each expected SQL string is written by hand.
fn main()
    // SELECT *
    let r0 = qb.qb_build(qb.qb_select("users", []))
    assert(r0["sql"] == "SELECT * FROM users", "select all")
    assert(len(r0["params"]) == 0, "select all no params")

    // SELECT cols + WHERE + ORDER + LIMIT
    let q = qb.qb_select("users", ["id", "name"])
    q = qb.qb_where(q, "age", ">=", 18)
    q = qb.qb_order(q, "name", "ASC")
    q = qb.qb_limit(q, 10)
    let r1 = qb.qb_build(q)
    assert(r1["sql"] == "SELECT id, name FROM users WHERE age >= ? ORDER BY name ASC LIMIT 10", "select full")
    assert(r1["params"][0] == 18, "where param 18")
    assert(len(r1["params"]) == 1, "one param")

    // two WHERE clauses -> AND, params in order
    let q2 = qb.qb_select("users", ["id"])
    q2 = qb.qb_where(q2, "age", ">=", 18)
    q2 = qb.qb_where(q2, "active", "=", 1)
    let r2 = qb.qb_build(q2)
    assert(r2["sql"] == "SELECT id FROM users WHERE age >= ? AND active = ?", "two wheres AND")
    assert(r2["params"][0] == 18, "param0=18")
    assert(r2["params"][1] == 1, "param1=1")

    // JOIN
    let q3 = qb.qb_select("orders", ["*"])
    q3 = qb.qb_join(q3, "users", "orders.uid = users.id")
    let r3 = qb.qb_build(q3)
    assert(r3["sql"] == "SELECT * FROM orders JOIN users ON orders.uid = users.id", "join")

    // INSERT (cols sorted; params follow)
    let ins = qb.qb_insert("users", {"name": "Bob", "age": 30})
    assert(ins["sql"] == "INSERT INTO users (age, name) VALUES (?, ?)", "insert sql")
    assert(ins["params"][0] == 30, "insert age param")
    assert(ins["params"][1] == "Bob", "insert name param")

    // UPDATE with WHERE
    let upd = qb.qb_update("users", {"age": 31}, "id", "=", 5)
    assert(upd["sql"] == "UPDATE users SET age = ? WHERE id = ?", "update sql")
    assert(upd["params"][0] == 31, "update set param")
    assert(upd["params"][1] == 5, "update where param")

    // DELETE with WHERE
    let del = qb.qb_delete("users", "id", "=", 5)
    assert(del["sql"] == "DELETE FROM users WHERE id = ?", "delete sql")
    assert(del["params"][0] == 5, "delete where param")

    // INJECTION SAFETY: a malicious value stays a bound parameter, never SQL.
    let qm = qb.qb_select("users", ["id"])
    qm = qb.qb_where(qm, "name", "=", "x'; DROP TABLE users;--")
    let rm = qb.qb_build(qm)
    assert(rm["sql"] == "SELECT id FROM users WHERE name = ?", "malicious value is a placeholder, not SQL")
    assert(rm["params"][0] == "x'; DROP TABLE users;--", "malicious string carried as a bound param")
    assert(not contains(rm["sql"], "DROP"), "no injected SQL in the statement")

    print("qb_lib_test: all passed")
