import std/probability/prob_bayes

fn ckr(label: string, got: list, wn: int, wd: int)
    if got[0] != wn or got[1] != wd
        print("FAIL " + label + ": got=" + str(got[0]) + "/" + str(got[1]) + " want=" + str(wn) + "/" + str(wd))
        exit(1)

fn main()
    // pby_posterior(1,1000, 99,100, 5,100)
    // prior=1/1000, sens=99/100, fpr=5/100
    // num = 1/1000 * 99/100 = 99/100000
    // denom = 99/100000 + (999/1000)*(5/100) = 99/100000 + 4995/100000 = 5094/100000
    // posterior = 99/5094 = 11/566
    ckr("posterior rare disease", pby_posterior(1, 1000, 99, 100, 5, 100), 11, 566)

    // pby_posterior(1,2, 1,1, 1,1)
    // prior=1/2, sens=1, fpr=1
    // num = 1/2*1 = 1/2
    // denom = 1/2 + 1/2*1 = 1
    // posterior = 1/2
    ckr("posterior prior=1/2 perfect", pby_posterior(1, 2, 1, 1, 1, 1), 1, 2)

    // pby_joint(1,2, 1,3) = 1/6
    ckr("joint(1/2, 1/3)", pby_joint(1, 2, 1, 3), 1, 6)

    // pby_posterior(1,100, 90,100, 10,100)
    // prior=1/100, sens=90/100, fpr=10/100
    // num = 1/100 * 90/100 = 90/10000
    // denom = 90/10000 + (99/100)*(10/100) = 90/10000 + 990/10000 = 1080/10000
    // posterior = 90/1080 = 1/12
    ckr("posterior 1pct prior", pby_posterior(1, 100, 90, 100, 10, 100), 1, 12)

    // pby_total_prob(1,1000, 99,100, 5,100) = 5094/100000 = 2547/50000
    ckr("total_prob rare", pby_total_prob(1, 1000, 99, 100, 5, 100), 2547, 50000)

    // pby_joint(0,1, 1,2) = 0/1
    ckr("joint zero", pby_joint(0, 1, 1, 2), 0, 1)

    // pby_joint(3,4, 2,5) = 6/20 = 3/10
    ckr("joint(3/4, 2/5)", pby_joint(3, 4, 2, 5), 3, 10)

    // prior=1, sens=1, fpr=0 => posterior must be 1/1
    // num = 1*1 = 1; denom = 1 + 0 = 1; posterior = 1/1
    ckr("posterior certain", pby_posterior(1, 1, 1, 1, 0, 1), 1, 1)

    // prior=0, sens=1, fpr=1 => num=0, denom=1; posterior=0/1
    ckr("posterior zero prior", pby_posterior(0, 1, 1, 1, 1, 1), 0, 1)

    print("PASS _prob_bayes_test")
