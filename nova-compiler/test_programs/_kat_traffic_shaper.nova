import forge_traffic_shaper

fn main()
    let t = tsh_new(1, 5)
    assert(tsh_tokens_available(t) == 5, "5 burst tokens")

    let r1 = tsh_consume(t, 3, 0)
    t = r1["t"]
    assert(r1["allowed"] == 1, "3 consumed")
    assert(tsh_tokens_available(t) == 2, "2 left")

    let r2 = tsh_consume(t, 3, 0)
    t = r2["t"]
    assert(r2["allowed"] == 0, "not enough")
    assert(tsh_total_shaped(t) == 1, "1 shaped")

    let r3 = tsh_consume(t, 1, 2)
    t = r3["t"]
    assert(r3["allowed"] == 1, "refill + consume")

    assert(tsh_total_allowed(t) == 2, "2 allowed")
    assert(tsh_shape_rate(t) == 33, "33% shaped")

    print("TRAFFIC-SHAPER KAT PASS")
