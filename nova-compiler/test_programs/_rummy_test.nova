// KAT for std/game/rummy — rummy meld detection.
// Deterministic vectors verified against spec.
import std/game/rummy

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL rummy " + label + ": got " + gs + " want " + ws)
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL rummy " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // ── is_set ────────────────────────────────────────────────────────────────

    // Three 7s of different suits -> true
    let s1 = []
    push(s1, [7, 0])
    push(s1, [7, 1])
    push(s1, [7, 2])
    ckb("is_set_three7s", is_set(s1), true)

    // 7C 7D 8H -> false (mixed ranks)
    let s2 = []
    push(s2, [7, 0])
    push(s2, [7, 1])
    push(s2, [8, 2])
    ckb("is_set_mixed_rank", is_set(s2), false)

    // Only 2 cards of same rank -> false (need 3+)
    let s3 = []
    push(s3, [9, 0])
    push(s3, [9, 1])
    ckb("is_set_only2", is_set(s3), false)

    // Four Kings (all suits) -> true
    let s4 = []
    push(s4, [13, 0])
    push(s4, [13, 1])
    push(s4, [13, 2])
    push(s4, [13, 3])
    ckb("is_set_four_kings", is_set(s4), true)

    // ── is_run ────────────────────────────────────────────────────────────────

    // 5C 6C 7C -> true (normal run, same suit)
    let r1 = []
    push(r1, [5, 0])
    push(r1, [6, 0])
    push(r1, [7, 0])
    ckb("is_run_5C6C7C", is_run(r1), true)

    // 5C 6C 7H -> false (mixed suits)
    let r2 = []
    push(r2, [5, 0])
    push(r2, [6, 0])
    push(r2, [7, 1])
    ckb("is_run_mixed_suit", is_run(r2), false)

    // Low-ace run: AC 2C 3C -> true
    let r3 = []
    push(r3, [14, 0])
    push(r3, [2, 0])
    push(r3, [3, 0])
    ckb("is_run_low_ace", is_run(r3), true)

    // High-ace run: QC KC AC -> true
    let r4 = []
    push(r4, [12, 0])
    push(r4, [13, 0])
    push(r4, [14, 0])
    ckb("is_run_high_ace", is_run(r4), true)

    // Only 2 cards -> false
    let r5 = []
    push(r5, [5, 0])
    push(r5, [6, 0])
    ckb("is_run_only2", is_run(r5), false)

    // Non-consecutive same suit -> false
    let r6 = []
    push(r6, [5, 0])
    push(r6, [6, 0])
    push(r6, [8, 0])
    ckb("is_run_gap", is_run(r6), false)

    // Longer ace-low run: AC 2C 3C 4C -> true
    let r7 = []
    push(r7, [14, 0])
    push(r7, [2, 0])
    push(r7, [3, 0])
    push(r7, [4, 0])
    ckb("is_run_ace_low_4", is_run(r7), true)

    // ── find_sets ─────────────────────────────────────────────────────────────

    // Hand with three Kings (KC KD KH) + two other cards -> find_sets returns 1 group
    let fh = []
    push(fh, [13, 0])
    push(fh, [13, 1])
    push(fh, [13, 2])
    push(fh, [5, 0])
    push(fh, [7, 1])
    let sets_found = find_sets(fh)
    cki("find_sets_one_group", len(sets_found), 1)
    // The group should have 3 cards
    let king_grp = sets_found[0]
    cki("find_sets_king_group_len", len(king_grp), 3)

    // Hand with no sets -> find_sets returns empty list
    let fh2 = []
    push(fh2, [2, 0])
    push(fh2, [3, 1])
    push(fh2, [4, 2])
    push(fh2, [5, 3])
    let sets_found2 = find_sets(fh2)
    cki("find_sets_empty", len(sets_found2), 0)

    // Hand with four Aces -> one group of 4
    let fh3 = []
    push(fh3, [14, 0])
    push(fh3, [14, 1])
    push(fh3, [14, 2])
    push(fh3, [14, 3])
    let sets_found3 = find_sets(fh3)
    cki("find_sets_four_aces_groups", len(sets_found3), 1)
    let ace_grp = sets_found3[0]
    cki("find_sets_four_aces_len", len(ace_grp), 4)

    // ── find_runs ─────────────────────────────────────────────────────────────

    // Hand with a 3-card club run 5C-6C-7C
    let rh1 = []
    push(rh1, [5, 0])
    push(rh1, [6, 0])
    push(rh1, [7, 0])
    push(rh1, [9, 1])
    push(rh1, [10, 1])
    let runs1 = find_runs(rh1)
    cki("find_runs_one_run", len(runs1), 1)
    let run1 = runs1[0]
    cki("find_runs_run_len", len(run1), 3)

    // Hand with no runs (isolated cards)
    let rh2 = []
    push(rh2, [2, 0])
    push(rh2, [4, 0])
    push(rh2, [6, 0])
    push(rh2, [8, 0])
    let runs2 = find_runs(rh2)
    cki("find_runs_no_runs", len(runs2), 0)

    // Hand with a 5-card run 3H-4H-5H-6H-7H -> 1 maximal run of length 5
    let rh3 = []
    push(rh3, [3, 2])
    push(rh3, [4, 2])
    push(rh3, [5, 2])
    push(rh3, [6, 2])
    push(rh3, [7, 2])
    let runs3 = find_runs(rh3)
    cki("find_runs_5card", len(runs3), 1)
    let run3 = runs3[0]
    cki("find_runs_5card_len", len(run3), 5)

    // ── deadwood ──────────────────────────────────────────────────────────────

    // Hand: three 7s (a set, all melded) + KH (10 pts) + 5D (5 pts) -> deadwood = 15
    let dh1 = []
    push(dh1, [7, 0])
    push(dh1, [7, 1])
    push(dh1, [7, 2])
    push(dh1, [13, 2])
    push(dh1, [5, 1])
    let dw1 = deadwood(dh1)
    cki("deadwood_set_meld", dw1, 15)

    // Hand: all in a set -> deadwood = 0
    let dh2 = []
    push(dh2, [9, 0])
    push(dh2, [9, 1])
    push(dh2, [9, 2])
    let dw2 = deadwood(dh2)
    cki("deadwood_all_melded_set", dw2, 0)

    // Hand: run 5C-6C-7C (melded) + AC (deadwood ace=1) + JH (deadwood=10) -> 11
    let dh3 = []
    push(dh3, [5, 0])
    push(dh3, [6, 0])
    push(dh3, [7, 0])
    push(dh3, [14, 0])
    push(dh3, [11, 2])
    let dw3 = deadwood(dh3)
    cki("deadwood_run_meld", dw3, 11)

    // Hand with no melds: AC(1) + 2D(2) + 5H(5) + JC(10) -> deadwood = 18
    let dh4 = []
    push(dh4, [14, 0])
    push(dh4, [2, 1])
    push(dh4, [5, 2])
    push(dh4, [11, 0])
    let dw4 = deadwood(dh4)
    cki("deadwood_no_melds", dw4, 18)

    // Empty hand -> deadwood = 0
    let dh5 = []
    let dw5 = deadwood(dh5)
    cki("deadwood_empty", dw5, 0)

    // All face cards, no melds -> 10+10+10 = 30
    let dh6 = []
    push(dh6, [11, 0])
    push(dh6, [12, 1])
    push(dh6, [13, 2])
    let dw6 = deadwood(dh6)
    cki("deadwood_face_cards", dw6, 30)

    // Three face cards of same rank (set) -> deadwood = 0
    let dh7 = []
    push(dh7, [12, 0])
    push(dh7, [12, 1])
    push(dh7, [12, 2])
    let dw7 = deadwood(dh7)
    cki("deadwood_face_set", dw7, 0)

    print("PASS _rummy_test")
