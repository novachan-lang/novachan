import forge_file_upload

fn main()
    let fu = fu_new(10000000)
    fu = fu_allow_type(fu, "image/png")
    fu = fu_allow_type(fu, "image/jpeg")
    fu = fu_allow_type(fu, "application/pdf")

    let v1 = fu_validate(fu, "photo.png", 5000, "image/png")
    assert(v1["valid"] == 1, "valid upload")
    assert(len(v1["errors"]) == 0, "no errors")

    let v2 = fu_validate(fu, "huge.png", 20000000, "image/png")
    assert(v2["valid"] == 0, "too large")

    let v3 = fu_validate(fu, "script.exe", 1000, "application/exe")
    assert(v3["valid"] == 0, "type not allowed")

    let v4 = fu_validate(fu, "", 1000, "image/png")
    assert(v4["valid"] == 0, "empty filename")

    let r1 = fu_store(fu, "photo.png", 5000, "image/png", "/uploads/photo.png")
    fu = r1["fu"]
    assert(r1["upload_id"] == 1, "first upload id=1")

    let r2 = fu_store(fu, "doc.pdf", 8000, "application/pdf", "/uploads/doc.pdf")
    fu = r2["fu"]

    let r3 = fu_store(fu, "avatar.jpeg", 3000, "image/jpeg", "/uploads/avatar.jpeg")
    fu = r3["fu"]

    assert(fu_count(fu) == 3, "3 uploads")
    assert(fu_total_bytes(fu) == 16000, "16000 bytes total")

    let got = fu_get(fu, 1)
    assert(got["filename"] == "photo.png", "got filename")
    assert(got["path"] == "/uploads/photo.png", "got path")

    let missing = fu_get(fu, 99)
    assert(missing["id"] == -1, "missing upload")

    let pngs = fu_by_type(fu, "image/png")
    assert(len(pngs) == 1, "1 png")

    print("FILE-UPLOAD KAT PASS")
