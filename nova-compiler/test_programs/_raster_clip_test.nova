import std/raster/raster_clip

// cki — check int equality; FAIL+exit(1) on mismatch.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL raster_clip " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb — check bool equality; FAIL+exit(1) on mismatch.
fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL raster_clip " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

// pt_eq — true iff two [x,y] points are equal.
fn pt_eq(a: list, b: list) -> bool
    a[0] == b[0] and a[1] == b[1]

fn main()
    // KAT 1: rc_outcode(5,5, 0,0,10,10) == 0 (inside)
    let oc1 = rc_outcode(5, 5, 0, 0, 10, 10)
    cki("kat1_inside", oc1, 0)

    // KAT 2: rc_outcode(-5,5, 0,0,10,10) == 1 (LEFT bit set)
    let oc2 = rc_outcode(-5, 5, 0, 0, 10, 10)
    cki("kat2_left", oc2, 1)

    // KAT 3: rc_outcode(5,15, 0,0,10,10) == 8 (TOP bit set, y>ymax)
    let oc3 = rc_outcode(5, 15, 0, 0, 10, 10)
    cki("kat3_top", oc3, 8)

    // KAT 4: rc_outcode(15,5, 0,0,10,10) == 2 (RIGHT bit)
    let oc4 = rc_outcode(15, 5, 0, 0, 10, 10)
    cki("kat4_right", oc4, 2)

    // KAT 5: rc_outcode(5,-5, 0,0,10,10) == 4 (BOTTOM bit, y<ymin)
    let oc5 = rc_outcode(5, -5, 0, 0, 10, 10)
    cki("kat5_bottom", oc5, 4)

    // KAT 6: rc_outcode(-5,-5, 0,0,10,10) == 5 (LEFT+BOTTOM = 1|4)
    let oc6 = rc_outcode(-5, -5, 0, 0, 10, 10)
    cki("kat6_left_bottom", oc6, 5)

    // KAT 7: rc_point_in_rect(5,5, 0,0,10,10) == true
    let pr7 = rc_point_in_rect(5, 5, 0, 0, 10, 10)
    ckb("kat7_pt_in", pr7, true)

    // KAT 8: rc_point_in_rect(11,5, 0,0,10,10) == false
    let pr8 = rc_point_in_rect(11, 5, 0, 0, 10, 10)
    ckb("kat8_pt_out", pr8, false)

    // KAT 9: rc_point_in_rect(0,0, 0,0,10,10) == true (boundary inclusive)
    let pr9 = rc_point_in_rect(0, 0, 0, 0, 10, 10)
    ckb("kat9_pt_boundary", pr9, true)

    // KAT 10: rc_clip_line(-5,5, 15,5, 0,0,10,10) == [[0,5],[10,5]]
    let cl10 = rc_clip_line(-5, 5, 15, 5, 0, 0, 10, 10)
    cki("kat10_clip_horiz_len", len(cl10), 2)
    cki("kat10_clip_horiz_x0", cl10[0][0], 0)
    cki("kat10_clip_horiz_y0", cl10[0][1], 5)
    cki("kat10_clip_horiz_x1", cl10[1][0], 10)
    cki("kat10_clip_horiz_y1", cl10[1][1], 5)

    // KAT 11: rc_clip_line(20,20, 30,30, 0,0,10,10) == [] (fully outside)
    let cl11 = rc_clip_line(20, 20, 30, 30, 0, 0, 10, 10)
    cki("kat11_fully_outside_len", len(cl11), 0)

    // KAT 12: rc_clip_line(2,2, 8,8, 0,0,10,10) == [[2,2],[8,8]] (fully inside)
    let cl12 = rc_clip_line(2, 2, 8, 8, 0, 0, 10, 10)
    cki("kat12_fully_inside_len", len(cl12), 2)
    cki("kat12_fully_inside_x0", cl12[0][0], 2)
    cki("kat12_fully_inside_y0", cl12[0][1], 2)
    cki("kat12_fully_inside_x1", cl12[1][0], 8)
    cki("kat12_fully_inside_y1", cl12[1][1], 8)

    // KAT 13: rc_clip_point(-5,15, 0,0,10,10) == [0,10] (clamped)
    let cp13 = rc_clip_point(-5, 15, 0, 0, 10, 10)
    cki("kat13_clip_pt_x", cp13[0], 0)
    cki("kat13_clip_pt_y", cp13[1], 10)

    // KAT 14: rc_clip_point(5,5, 0,0,10,10) == [5,5] (already inside)
    let cp14 = rc_clip_point(5, 5, 0, 0, 10, 10)
    cki("kat14_clip_pt_inside_x", cp14[0], 5)
    cki("kat14_clip_pt_inside_y", cp14[1], 5)

    // KAT 15: rc_rect_intersect — two overlapping rects
    let ra = {}
    ra["xmin"] = 0
    ra["ymin"] = 0
    ra["xmax"] = 10
    ra["ymax"] = 10
    let rb = {}
    rb["xmin"] = 5
    rb["ymin"] = 5
    rb["xmax"] = 15
    rb["ymax"] = 15
    let ri15 = rc_rect_intersect(ra, rb)
    cki("kat15_rect_isect_len", len(ri15), 1)
    let ir15 = ri15[0]
    cki("kat15_rect_isect_xmin", ir15["xmin"], 5)
    cki("kat15_rect_isect_ymin", ir15["ymin"], 5)
    cki("kat15_rect_isect_xmax", ir15["xmax"], 10)
    cki("kat15_rect_isect_ymax", ir15["ymax"], 10)

    // KAT 16: rc_rect_intersect — disjoint rects
    let rc16 = {}
    rc16["xmin"] = 20
    rc16["ymin"] = 20
    rc16["xmax"] = 30
    rc16["ymax"] = 30
    let ri16 = rc_rect_intersect(ra, rc16)
    cki("kat16_rect_disjoint_len", len(ri16), 0)

    // KAT 17: rc_line_fully_inside — segment (2,2)-(8,8) inside rect 0..10
    let rect17 = {}
    rect17["xmin"] = 0
    rect17["ymin"] = 0
    rect17["xmax"] = 10
    rect17["ymax"] = 10
    let fi17 = rc_line_fully_inside(2, 2, 8, 8, rect17)
    ckb("kat17_fully_inside", fi17, true)

    // KAT 18: rc_line_fully_inside — one endpoint outside
    let fi18 = rc_line_fully_inside(2, 2, 15, 8, rect17)
    ckb("kat18_not_fully_inside", fi18, false)

    // KAT 19: rc_line_fully_outside — (20,20)-(30,30) trivially outside (both TOP+RIGHT)
    let fo19 = rc_line_fully_outside(20, 20, 30, 30, rect17)
    ckb("kat19_fully_outside", fo19, true)

    // KAT 20: rc_line_fully_outside — crossing line is NOT trivially outside
    let fo20 = rc_line_fully_outside(-5, 5, 15, 5, rect17)
    ckb("kat20_crossing_not_trivially_outside", fo20, false)

    // KAT 21: vertical clip — line from (5,-5) to (5,15) clipped to y=0..10
    let cl21 = rc_clip_line(5, -5, 5, 15, 0, 0, 10, 10)
    cki("kat21_vert_clip_len", len(cl21), 2)
    cki("kat21_vert_clip_x0", cl21[0][0], 5)
    cki("kat21_vert_clip_y0", cl21[0][1], 0)
    cki("kat21_vert_clip_x1", cl21[1][0], 5)
    cki("kat21_vert_clip_y1", cl21[1][1], 10)

    print("PASS _raster_clip_test")
