import forge_subsetsum

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // subset sum existence
    fails = fails + expect("ss1", str(subset_sum_exists([3, 34, 4, 12, 5, 2], 9)), "true")
    fails = fails + expect("ss2", str(subset_sum_exists([3, 34, 4, 12, 5, 2], 30)), "false")
    fails = fails + expect("ss_zero", str(subset_sum_exists([1, 2, 3], 0)), "true")
    fails = fails + expect("ss_all", str(subset_sum_exists([1, 2, 3], 6)), "true")
    fails = fails + expect("ss_over", str(subset_sum_exists([1, 2, 3], 7)), "false")
    fails = fails + expect("ss_single", str(subset_sum_exists([5], 5)), "true")
    fails = fails + expect("ss_empty", str(subset_sum_exists([], 5)), "false")

    // count subsets
    fails = fails + expect("cnt1", str(count_subsets_sum([2, 3, 5, 6, 8, 10], 10)), "3")
    fails = fails + expect("cnt_zero", str(count_subsets_sum([1, 2, 3], 0)), "1")
    fails = fails + expect("cnt2", str(count_subsets_sum([1, 1, 1, 1], 2)), "6")
    fails = fails + expect("cnt_none", str(count_subsets_sum([1, 2], 5)), "0")

    // can partition (equal sum halves)
    fails = fails + expect("part_yes", str(can_partition([1, 5, 11, 5])), "true")
    fails = fails + expect("part_no", str(can_partition([1, 2, 3, 5])), "false")
    fails = fails + expect("part_even", str(can_partition([1, 1])), "true")
    fails = fails + expect("part_all_same", str(can_partition([2, 2, 2, 2])), "true")

    if fails == 0
        print("forge_subsetsum: all passed")
    else
        print("forge_subsetsum: " + str(fails) + " FAILED")
