import forge_trim

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // trim
    fails = fails + expect("trim1", trim("  hello  "), "hello")
    fails = fails + expect("trim_none", trim("hello"), "hello")
    fails = fails + expect("trim_allws", trim("   "), "")
    fails = fails + expect("trim_empty", trim(""), "")
    fails = fails + expect("trim_interior", trim("  a b c  "), "a b c")
    fails = fails + expect("trim_tabs", trim(chr(9) + "hi" + chr(10)), "hi")

    // ltrim / rtrim
    fails = fails + expect("ltrim", ltrim("  hi  "), "hi  ")
    fails = fails + expect("rtrim", rtrim("  hi  "), "  hi")
    fails = fails + expect("ltrim_none", ltrim("hi"), "hi")
    fails = fails + expect("rtrim_all", rtrim("hi   "), "hi")

    // trim_chars
    fails = fails + expect("tc_x", trim_chars("xxhelloxx", "x"), "hello")
    fails = fails + expect("tc_dots", trim_chars("...a.b.c...", "."), "a.b.c")
    fails = fails + expect("tc_multi", trim_chars("/-path-/", "/-"), "path")
    fails = fails + expect("tc_none", trim_chars("hello", "x"), "hello")
    fails = fails + expect("tc_all", trim_chars("xxxx", "x"), "")

    if fails == 0
        print("forge_trim: all passed")
    else
        print("forge_trim: " + str(fails) + " FAILED")
