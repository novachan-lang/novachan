type Expr
    tag: string
    value: string
    num: int
    children: list
    fields: list
    line: int

type Stmt
    tag: string
    name: string
    expr: Expr
    body: list
    params: list
    else_body: list
    annotations: list
    line: int

fn null_expr() -> Expr
    Expr("null", "", 0, [], [], 0)

fn main()
    let e = Expr("var", "x", 0, [], [], 42)
    match e
        Expr(tag, value, num, children, fields, eline) =>
            print("Expr tag: " + tag + " line: " + str(eline))
    let ne = null_expr()
    match ne
        Expr(tag, value, num, children, fields, eline) =>
            print("null_expr tag: " + tag)
    let s = Stmt("let", "x", e, [], [], [], [], 10)
    match s
        Stmt(stag, name, expr, body, params, else_body, annotations, sline) =>
            print("Stmt tag: " + stag + " line: " + str(sline))
    print("done")
