// Test the enhanced linter (nova lint) and ABI version stamp

fn main()
    // ABI version: 1.0.0 packed as (1<<16)|(0<<8)|0 = 65536
    let v = abi_version()
    assert_eq(v, 65536)

    // cov_export_lcov: returns 0 if coverage data exists (--cov), -1 if none
    let lcov_rc = cov_export_lcov("_test_lint_cov.lcov")
    // Either outcome is fine; just must not crash
    if lcov_rc == 0
        let lc = read_file("_test_lint_cov.lcov")
        if len(lc) > 0
            assert_eq(contains(lc, "SF:"), true)

    print("linter_test passed")
