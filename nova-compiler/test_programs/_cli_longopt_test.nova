import std/cli/cli_longopt

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL _cli_longopt_test " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL _cli_longopt_test " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _cli_longopt_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL _cli_longopt_test " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL _cli_longopt_test " + label + "[" + str(i) + "]: got='" + got[i] + "' want='" + want[i] + "'")
            exit(1)
        i = i + 1

fn main()
    // KAT spec: cll_split_eq('--port=8080')=['--port','8080']
    let sp1 = cll_split_eq("--port=8080")
    let w1 = []
    push(w1, "--port")
    push(w1, "8080")
    ckl("spec1_split_eq", sp1, w1)

    // KAT spec: cll_split_eq('--verbose')=['--verbose']
    let sp2 = cll_split_eq("--verbose")
    let w2 = []
    push(w2, "--verbose")
    ckl("spec2_split_no_eq", sp2, w2)

    // KAT spec: cll_normalize(['--a=1','--b','2'])=['--a','1','--b','2']
    let n1 = []
    push(n1, "--a=1")
    push(n1, "--b")
    push(n1, "2")
    let wn1 = []
    push(wn1, "--a")
    push(wn1, "1")
    push(wn1, "--b")
    push(wn1, "2")
    ckl("spec3_normalize", cll_normalize(n1), wn1)

    // KAT spec: cll_match_abbrev('--verb',['--verbose','--version'])='--verbose'
    let cands1 = []
    push(cands1, "--verbose")
    push(cands1, "--version")
    cks("spec4_abbrev_uniq", cll_match_abbrev("--verb", cands1), "--verbose")

    // KAT spec: cll_match_abbrev('--ver',['--verbose','--version'])='' (ambiguous)
    let cands2 = []
    push(cands2, "--verbose")
    push(cands2, "--version")
    cks("spec5_abbrev_ambig", cll_match_abbrev("--ver", cands2), "")

    // KAT spec: cll_match_abbrev('--version',['--verbose','--version'])='--version'
    let cands3 = []
    push(cands3, "--verbose")
    push(cands3, "--version")
    cks("spec6_abbrev_exact", cll_match_abbrev("--version", cands3), "--version")

    // Edge: cll_split_eq on short option (no '--') — still splits on '='
    let sp3 = cll_split_eq("-o=file")
    let w3 = []
    push(w3, "-o")
    push(w3, "file")
    ckl("split_short_eq", sp3, w3)

    // Edge: cll_split_eq on value containing '=' (only first '=' is the delimiter)
    let sp4 = cll_split_eq("--expr=a=b")
    let w4 = []
    push(w4, "--expr")
    push(w4, "a=b")
    ckl("split_value_with_eq", sp4, w4)

    // Edge: cll_normalize with no '=' tokens passes all through unchanged
    let n2 = []
    push(n2, "--verbose")
    push(n2, "file.txt")
    let norm2 = cll_normalize(n2)
    ckl("normalize_no_eq", norm2, n2)

    // Edge: cll_normalize on empty argv
    let empty = []
    let norm_empty = cll_normalize(empty)
    cki("normalize_empty_len", len(norm_empty), 0)

    // Edge: cll_match_abbrev with no candidates returns ''
    let cands4 = []
    cks("abbrev_no_cands", cll_match_abbrev("--foo", cands4), "")

    // Edge: cll_match_abbrev with no match returns ''
    let cands5 = []
    push(cands5, "--port")
    push(cands5, "--host")
    cks("abbrev_no_match", cll_match_abbrev("--xyz", cands5), "")

    // Edge: cll_match_abbrev exact match wins even when another candidate is longer
    // '--port' is prefix of '--portable', but '--port' is exact; returns '--port'
    let cands6 = []
    push(cands6, "--portable")
    push(cands6, "--port")
    cks("abbrev_exact_wins", cll_match_abbrev("--port", cands6), "--port")

    // Edge: cll_normalize with multiple '=' tokens in one batch
    let n3 = []
    push(n3, "--a=1")
    push(n3, "--b=2")
    push(n3, "--c")
    let wn3 = []
    push(wn3, "--a")
    push(wn3, "1")
    push(wn3, "--b")
    push(wn3, "2")
    push(wn3, "--c")
    ckl("normalize_multi_eq", cll_normalize(n3), wn3)

    print("PASS _cli_longopt_test")
