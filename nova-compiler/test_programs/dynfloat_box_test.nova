fn scale(x)
    x * 1.5

fn add_one(x)
    x + 1.0

fn main()
    let xs = [10, 20, 30]

    let mapped = map(xs, fn(e) e * 2.5)
    print("test 1: map lambda dynamic float")
    print(mapped)
    assert(len(mapped) == 3, "len")

    let s = str(mapped)
    assert(contains(s, "25"), "t1a")
    assert(contains(s, "50"), "t1b")
    assert(contains(s, "75"), "t1c")
    print("PASS 1")

    let mapped2 = map(xs, fn(e) e + 0.5)
    print("test 2: map lambda add float")
    print(mapped2)
    let s2 = str(mapped2)
    assert(contains(s2, "10.5"), "t2a")
    assert(contains(s2, "20.5"), "t2b")
    assert(contains(s2, "30.5"), "t2c")
    print("PASS 2")

    print("test 3: dynamic arith stored in list")
    let results = []
    let a = 10
    let b = 3.0
    push(results, a + b)
    push(results, a - b)
    push(results, a * b)
    push(results, a / b)
    print(results)
    let sr = str(results)
    assert(contains(sr, "13"), "t3a")
    assert(contains(sr, "7"), "t3b")
    assert(contains(sr, "30"), "t3c")
    assert(contains(sr, "3.3"), "t3d")
    print("PASS 3")

    print("test 4: large int in mixed list with floats")
    let big = 9007199254740993
    let mixed = [big, 1.5, 42]
    print(mixed)
    let sm = str(mixed)
    assert(contains(sm, "9007199254740993"), "t4a")
    assert(contains(sm, "1.5"), "t4b")
    assert(contains(sm, "42"), "t4c")
    print("PASS 4")

    print("test 5: dynamic float in dict values")
    let d = {}
    d["sum"] = 10 + 2.5
    d["diff"] = 10 - 2.5
    print(d)
    print("PASS 5")

    print("test 6: chained dynamic float ops")
    let v = 5
    let r = v + 1.0
    let r2 = r * 2.0
    let r3 = r2 - 1.0
    print(r3)
    let sr3 = str(r3)
    assert(contains(sr3, "11"), "t6a")
    print("PASS 6")

    print("test 7: int ops stay int")
    let ia = 100
    let ib = 37
    let ic = ia + ib
    assert(ic == 137, "t7a")
    let id = ia * ib
    assert(id == 3700, "t7b")
    let ie = ia - ib
    assert(ie == 63, "t7c")
    let ig = ia / ib
    assert(ig == 2, "t7d")
    print("PASS 7: " + str(ic) + " " + str(id) + " " + str(ie) + " " + str(ig))

    print("test 8: float(dynamic_result)")
    let fr = 10 + 2.5
    let fv = float(fr)
    assert(fv == 12.5, "t8a")
    print("PASS 8")

    print("test 9: int(dynamic_float_result)")
    let fr2 = 10 + 2.7
    let iv = int(fr2)
    assert(iv == 12, "t9a")
    print("PASS 9")

    print("ALL PASS")
