// _mobius_test.nova — KAT for std/math/mobius
// Hand-computed expected values verified by factorisation.
//
// mob_mu hand-traces:
//   mob_mu(1)  = 1   (base case: by definition)
//   mob_mu(2)  = -1  (2 prime, count=1, (-1)^1=-1)
//   mob_mu(6)  = 1   (6=2×3, count=2, (-1)^2=1)
//   mob_mu(4)  = 0   (4=2^2, 4|4 → square factor detected)
//   mob_mu(30) = -1  (30=2×3×5, count=3, (-1)^3=-1)
//   mob_mu(12) = 0   (12=2^2×3, square factor)
//   mob_mu(15) = 1   (15=3×5, count=2, (-1)^2=1)
//
// mob_is_squarefree hand-traces:
//   12 = 2^2 × 3 → has square factor → false
//   30 = 2 × 3 × 5 → no square factor → true
//
// mob_mertens(5) = mu(1)+mu(2)+mu(3)+mu(4)+mu(5)
//               = 1 + (-1) + (-1) + 0 + (-1) = -2
//
// mob_mertens(10) = mob_mertens(5) + mu(6)+mu(7)+mu(8)+mu(9)+mu(10)
//   mu(6)=1 (6=2×3, 2 primes), mu(7)=-1 (prime), mu(8)=0 (8=2^3), mu(9)=0 (9=3^2)
//   mu(10)=1 (10=2×5, 2 primes, (-1)^2=1)
//   = -2 + 1 + (-1) + 0 + 0 + 1 = -1

import std/math/mobius

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got " + gs + " want " + ws)
        exit(1)

fn main()
    // mob_mu KATs
    cki("mob_mu(1)", mob_mu(1), 1)
    cki("mob_mu(2)", mob_mu(2), -1)
    cki("mob_mu(6)", mob_mu(6), 1)
    cki("mob_mu(4)", mob_mu(4), 0)
    cki("mob_mu(30)", mob_mu(30), -1)
    cki("mob_mu(12)", mob_mu(12), 0)
    cki("mob_mu(15)", mob_mu(15), 1)
    cki("mob_mu(3)", mob_mu(3), -1)
    cki("mob_mu(5)", mob_mu(5), -1)
    cki("mob_mu(9)", mob_mu(9), 0)

    // mob_is_squarefree KATs
    ckb("mob_is_squarefree(1)", mob_is_squarefree(1), true)
    ckb("mob_is_squarefree(2)", mob_is_squarefree(2), true)
    ckb("mob_is_squarefree(4)", mob_is_squarefree(4), false)
    ckb("mob_is_squarefree(12)", mob_is_squarefree(12), false)
    ckb("mob_is_squarefree(30)", mob_is_squarefree(30), true)
    ckb("mob_is_squarefree(9)", mob_is_squarefree(9), false)

    // mob_mertens KATs
    cki("mob_mertens(0)", mob_mertens(0), 0)
    cki("mob_mertens(1)", mob_mertens(1), 1)
    cki("mob_mertens(2)", mob_mertens(2), 0)
    cki("mob_mertens(5)", mob_mertens(5), -2)
    cki("mob_mertens(10)", mob_mertens(10), -1)

    print("_mobius_test passed")
