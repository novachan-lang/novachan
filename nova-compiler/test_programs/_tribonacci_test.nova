// KAT test for std/math/tribonacci
import std/math/tribonacci

fn main()
    // --- trib(n) scalar tests ---
    // T(0)=0
    let t0 = trib(0)
    if t0 != 0
        print("FAIL trib(0): expected 0 got " + str(t0))
        exit(1)

    // T(1)=1
    let t1 = trib(1)
    if t1 != 1
        print("FAIL trib(1): expected 1 got " + str(t1))
        exit(1)

    // T(2)=1
    let t2 = trib(2)
    if t2 != 1
        print("FAIL trib(2): expected 1 got " + str(t2))
        exit(1)

    // T(3)=2
    let t3 = trib(3)
    if t3 != 2
        print("FAIL trib(3): expected 2 got " + str(t3))
        exit(1)

    // T(4)=4
    let t4 = trib(4)
    if t4 != 4
        print("FAIL trib(4): expected 4 got " + str(t4))
        exit(1)

    // T(5)=7
    let t5 = trib(5)
    if t5 != 7
        print("FAIL trib(5): expected 7 got " + str(t5))
        exit(1)

    // T(6)=13
    let t6 = trib(6)
    if t6 != 13
        print("FAIL trib(6): expected 13 got " + str(t6))
        exit(1)

    // T(7)=24
    let t7 = trib(7)
    if t7 != 24
        print("FAIL trib(7): expected 24 got " + str(t7))
        exit(1)

    // --- trib_list(7) = [0,1,1,2,4,7,13] ---
    let lst = trib_list(7)
    let lst_len = len(lst)
    if lst_len != 7
        print("FAIL trib_list(7) len: expected 7 got " + str(lst_len))
        exit(1)

    let expected_0 = 0
    let got_0 = lst[0]
    if got_0 != expected_0
        print("FAIL trib_list(7)[0]: expected 0 got " + str(got_0))
        exit(1)

    let expected_1 = 1
    let got_1 = lst[1]
    if got_1 != expected_1
        print("FAIL trib_list(7)[1]: expected 1 got " + str(got_1))
        exit(1)

    let expected_2 = 1
    let got_2 = lst[2]
    if got_2 != expected_2
        print("FAIL trib_list(7)[2]: expected 1 got " + str(got_2))
        exit(1)

    let expected_3 = 2
    let got_3 = lst[3]
    if got_3 != expected_3
        print("FAIL trib_list(7)[3]: expected 2 got " + str(got_3))
        exit(1)

    let expected_4 = 4
    let got_4 = lst[4]
    if got_4 != expected_4
        print("FAIL trib_list(7)[4]: expected 4 got " + str(got_4))
        exit(1)

    let expected_5 = 7
    let got_5 = lst[5]
    if got_5 != expected_5
        print("FAIL trib_list(7)[5]: expected 7 got " + str(got_5))
        exit(1)

    let expected_6 = 13
    let got_6 = lst[6]
    if got_6 != expected_6
        print("FAIL trib_list(7)[6]: expected 13 got " + str(got_6))
        exit(1)

    // --- trib_list edge cases ---
    let lst0 = trib_list(0)
    if len(lst0) != 0
        print("FAIL trib_list(0) len: expected 0 got " + str(len(lst0)))
        exit(1)

    let lst1 = trib_list(1)
    if len(lst1) != 1
        print("FAIL trib_list(1) len: expected 1 got " + str(len(lst1)))
        exit(1)

    let lst1v = lst1[0]
    if lst1v != 0
        print("FAIL trib_list(1)[0]: expected 0 got " + str(lst1v))
        exit(1)

    // --- trib_sum tests ---
    // trib_sum(0)=0
    let s0 = trib_sum(0)
    if s0 != 0
        print("FAIL trib_sum(0): expected 0 got " + str(s0))
        exit(1)

    // trib_sum(1)=T(0)=0
    let s1 = trib_sum(1)
    if s1 != 0
        print("FAIL trib_sum(1): expected 0 got " + str(s1))
        exit(1)

    // trib_sum(3)=T(0)+T(1)+T(2)=0+1+1=2
    let s3 = trib_sum(3)
    if s3 != 2
        print("FAIL trib_sum(3): expected 2 got " + str(s3))
        exit(1)

    // trib_sum(7)=0+1+1+2+4+7+13=28
    let s7 = trib_sum(7)
    if s7 != 28
        print("FAIL trib_sum(7): expected 28 got " + str(s7))
        exit(1)

    // trib_sum(5)=0+1+1+2+4=8
    let s5 = trib_sum(5)
    if s5 != 8
        print("FAIL trib_sum(5): expected 8 got " + str(s5))
        exit(1)

    // negative input guard
    let tneg = trib(-1)
    if tneg != 0
        print("FAIL trib(-1): expected 0 got " + str(tneg))
        exit(1)

    print("_tribonacci_test passed")
