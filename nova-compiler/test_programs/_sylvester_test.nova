import std/math/sylvester

// cki — check integer equality, print FAIL+exit(1) on mismatch
fn cki(label: string, got: int, expected: int)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// list_to_str — flatten an int list to "[a,b,c]" for comparison
fn list_to_str(xs)
    let s = "["
    let i = 0
    let n = len(xs)
    while i < n
        if i > 0
            s = s + ","
        s = s + str(xs[i])
        i = i + 1
    s = s + "]"
    s

fn main()
    // KAT 1: sv_sylvester(0) == 2
    cki("sv_sylvester(0)", sv_sylvester(0), 2)

    // KAT 2: sv_sylvester(1) == 3
    // a(1) = 2*2 - 2 + 1 = 3
    cki("sv_sylvester(1)", sv_sylvester(1), 3)

    // KAT 3: sv_sylvester(2) == 7
    // a(2) = 3*3 - 3 + 1 = 7
    cki("sv_sylvester(2)", sv_sylvester(2), 7)

    // KAT 4: sv_sylvester(3) == 43
    // a(3) = 7*7 - 7 + 1 = 43
    cki("sv_sylvester(3)", sv_sylvester(3), 43)

    // KAT 5: sv_sylvester(4) == 1807
    // a(4) = 43*43 - 43 + 1 = 1849 - 43 + 1 = 1807
    cki("sv_sylvester(4)", sv_sylvester(4), 1807)

    // KAT 6: sv_list(4) == [2,3,7,43]
    let l4 = sv_list(4)
    cki("sv_list(4)_len", len(l4), 4)
    let l4s = list_to_str(l4)
    if l4s != "[2,3,7,43]"
        print("FAIL sv_list(4): got " + l4s + " expected [2,3,7,43]")
        exit(1)

    // KAT 7: sv_list(5) == [2,3,7,43,1807]
    let l5 = sv_list(5)
    cki("sv_list(5)_len", len(l5), 5)
    let l5s = list_to_str(l5)
    if l5s != "[2,3,7,43,1807]"
        print("FAIL sv_list(5): got " + l5s + " expected [2,3,7,43,1807]")
        exit(1)

    // KAT 8: sv_product(3) == 42
    // product = a(0)*a(1)*a(2) = 2*3*7 = 42
    cki("sv_product(3)", sv_product(3), 42)

    // KAT 9: sv_product(0) == 1 (empty product)
    cki("sv_product(0)", sv_product(0), 1)

    // KAT 10: sv_product(1) == 2 (just a(0)=2)
    cki("sv_product(1)", sv_product(1), 2)

    // KAT 11: sv_product(2) == 6  (2*3=6)
    cki("sv_product(2)", sv_product(2), 6)

    // KAT 12: sv_list(0) == []
    let l0 = sv_list(0)
    cki("sv_list(0)_len", len(l0), 0)

    // KAT 13: sv_list(1) == [2]
    let l1 = sv_list(1)
    cki("sv_list(1)_len", len(l1), 1)
    cki("sv_list(1)[0]", l1[0], 2)

    // KAT 14: sv_sylvester(5) == 3263443
    // a(5) = 1807*1807 - 1807 + 1 = 3265249 - 1807 + 1 = 3263443
    cki("sv_sylvester(5)", sv_sylvester(5), 3263443)

    print("_sylvester_test passed")
