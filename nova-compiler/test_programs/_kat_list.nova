import std/core/list

fn main() -> int
    let fails = 0
    let xs = [1, 2, 3, 2, 1]
    if not list_contains(xs, 3)
        print("FAIL contains 3")
        fails = fails + 1
    if list_contains(xs, 9)
        print("FAIL contains 9")
        fails = fails + 1
    if list_index_of(xs, 2) != 1
        print("FAIL index_of 2")
        fails = fails + 1
    if list_index_of(xs, 9) != 0 - 1
        print("FAIL index_of missing")
        fails = fails + 1
    let u = list_unique(xs)
    if len(u) != 3
        print("FAIL unique len=" + str(len(u)))
        fails = fails + 1
    let c = list_concat([1, 2], [3, 4])
    if len(c) != 4
        print("FAIL concat")
        fails = fails + 1
    if c[3] != 4
        print("FAIL concat[3]")
        fails = fails + 1
    let fl = list_flatten([[1, 2], [3], [4, 5]])
    if len(fl) != 5
        print("FAIL flatten len=" + str(len(fl)))
        fails = fails + 1
    if fl[4] != 5
        print("FAIL flatten[4]")
        fails = fails + 1
    if list_sum([10, 20, 30]) != 60
        print("FAIL sum")
        fails = fails + 1
    let ch = list_chunk([1, 2, 3, 4, 5], 2)
    if len(ch) != 3
        print("FAIL chunk count=" + str(len(ch)))
        fails = fails + 1
    if len(ch[2]) != 1
        print("FAIL chunk last")
        fails = fails + 1
    if fails == 0
        print("PASS _kat_list")
    else
        print("FAILED _kat_list")
    return 0
