import std/money/aggregate

// _ck — check integer equality; print FAIL + exit(1) on mismatch.
fn _ck(label: string, got: int, want: int)
    if got != want
        print("FAIL aggregate " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// _ck_list — check two int lists are equal element-by-element.
fn _ck_list(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL aggregate " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL aggregate " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // magg_sum
    let xs1 = []
    push(xs1, 100)
    push(xs1, 200)
    push(xs1, 300)
    _ck("sum_basic", magg_sum(xs1), 600)

    let xs_empty = []
    _ck("sum_empty", magg_sum(xs_empty), 0)

    // magg_avg
    let xs2 = []
    push(xs2, 100)
    push(xs2, 200)
    push(xs2, 300)
    _ck("avg_half_up", magg_avg(xs2, "half_up"), 200)

    let xs_avg2 = []
    push(xs_avg2, 100)
    push(xs_avg2, 200)
    _ck("avg_half_up_round", magg_avg(xs_avg2, "half_up"), 150)

    _ck("avg_empty", magg_avg(xs_empty, "half_up"), 0)

    // magg_min / magg_max
    let xs3 = []
    push(xs3, 300)
    push(xs3, 100)
    push(xs3, 200)
    _ck("min_basic", magg_min(xs3), 100)
    _ck("max_basic", magg_max(xs3), 300)

    _ck("min_empty", magg_min(xs_empty), 0)
    _ck("max_empty", magg_max(xs_empty), 0)

    // magg_count
    _ck("count_3", magg_count(xs1), 3)
    _ck("count_empty", magg_count(xs_empty), 0)

    // magg_pct_of
    _ck("pct_25pct", magg_pct_of(2500, 10000), 2500)
    _ck("pct_third", magg_pct_of(1, 3), 3333)
    _ck("pct_zero_whole", magg_pct_of(100, 0), 0)
    _ck("pct_100pct", magg_pct_of(10000, 10000), 10000)

    // magg_running_total
    let xs4 = []
    push(xs4, 100)
    push(xs4, 200)
    push(xs4, 300)
    let rt = magg_running_total(xs4)
    let rt_want = []
    push(rt_want, 100)
    push(rt_want, 300)
    push(rt_want, 600)
    _ck_list("running_total_basic", rt, rt_want)

    let rt_empty = magg_running_total(xs_empty)
    let rt_empty_want = []
    _ck_list("running_total_empty", rt_empty, rt_empty_want)

    // magg_diff
    let xs5 = []
    push(xs5, 100)
    push(xs5, 300)
    push(xs5, 200)
    let diff = magg_diff(xs5)
    let diff_want = []
    push(diff_want, 200)
    push(diff_want, -100)
    _ck_list("diff_basic", diff, diff_want)

    // magg_range
    let xs6 = []
    push(xs6, 100)
    push(xs6, 500)
    push(xs6, 200)
    _ck("range_basic", magg_range(xs6), 400)
    _ck("range_empty", magg_range(xs_empty), 0)

    // magg_median — odd count
    let xs7 = []
    push(xs7, 300)
    push(xs7, 100)
    push(xs7, 200)
    _ck("median_odd", magg_median(xs7), 200)

    // magg_median — even count: [100,200,300,400] -> (200+300)/2 = 250
    let xs8 = []
    push(xs8, 400)
    push(xs8, 100)
    push(xs8, 300)
    push(xs8, 200)
    _ck("median_even", magg_median(xs8), 250)

    // magg_median — single element
    let xs9 = []
    push(xs9, 777)
    _ck("median_single", magg_median(xs9), 777)

    // magg_median — empty
    _ck("median_empty", magg_median(xs_empty), 0)

    // magg_median — two elements: [100, 300] -> (100+300)/2 = 200
    let xs10 = []
    push(xs10, 300)
    push(xs10, 100)
    _ck("median_two", magg_median(xs10), 200)

    print("PASS _aggregate_test")
