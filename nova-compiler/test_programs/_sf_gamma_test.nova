// KAT test for std/numeric/sf_gamma — Gamma function via Lanczos approximation.
//
// Known answers:
//   gamma(5.0)   = 4! = 24.0
//   gamma(1.0)   = 0! = 1.0
//   gamma(0.5)   = sqrt(pi) ~= 1.7724538509...
//   gamma(2.0)   = 1! = 1.0
//   gamma(3.0)   = 2! = 2.0
//   ln_gamma(5.0) = ln(24) ~= 3.1780538...
//   factorial_float(5.0) = 120.0
import std/numeric/sf_gamma

fn approx(a, b, tol) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < tol
        return 1
    return 0

fn ck(label: string, got: float, want: float, tol: float)
    let ok = approx(got, want, tol)
    if ok == 0
        print("FAIL sf_gamma " + label + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("ok " + label)

fn main()
    // gamma(5.0) = 4! = 24.0
    let g5 = gamma(5.0)
    ck("gamma(5.0)=24.0", g5, 24.0, 0.001)

    // gamma(1.0) = 1.0
    let g1 = gamma(1.0)
    ck("gamma(1.0)=1.0", g1, 1.0, 0.0001)

    // gamma(0.5) = sqrt(pi) ~= 1.7724539
    let gh = gamma(0.5)
    ck("gamma(0.5)=sqrt(pi)", gh, 1.7724539, 0.001)

    // gamma(2.0) = 1.0
    let g2 = gamma(2.0)
    ck("gamma(2.0)=1.0", g2, 1.0, 0.0001)

    // gamma(3.0) = 2.0
    let g3 = gamma(3.0)
    ck("gamma(3.0)=2.0", g3, 2.0, 0.0001)

    // ln_gamma(5.0) = ln(24) ~= 3.1780538
    let lg5 = ln_gamma(5.0)
    ck("ln_gamma(5.0)=ln(24)", lg5, 3.1780538, 0.0001)

    // factorial_float(5.0) = 120.0
    let f5 = factorial_float(5.0)
    ck("factorial_float(5.0)=120.0", f5, 120.0, 0.01)

    print("PASS _sf_gamma_test")
