import std/devtool/gitignore_negate

fn main()
    // --- gin_is_negated ---
    let r1 = gin_is_negated("!foo")
    if r1 != 1
        print("FAIL gin_is_negated-bang: got " + str(r1) + " want 1")
        exit(1)

    let r2 = gin_is_negated("foo")
    if r2 != 0
        print("FAIL gin_is_negated-plain: got " + str(r2) + " want 0")
        exit(1)

    let r3 = gin_is_negated("")
    if r3 != 0
        print("FAIL gin_is_negated-empty: got " + str(r3) + " want 0")
        exit(1)

    let r4 = gin_is_negated("!")
    if r4 != 1
        print("FAIL gin_is_negated-lone-bang: got " + str(r4) + " want 1")
        exit(1)

    // --- gin_strip_negation ---
    let r5 = gin_strip_negation("!foo")
    if r5 != "foo"
        print("FAIL gin_strip_negation-bang: got " + r5 + " want foo")
        exit(1)

    let r6 = gin_strip_negation("foo")
    if r6 != "foo"
        print("FAIL gin_strip_negation-plain: got " + r6 + " want foo")
        exit(1)

    let r7 = gin_strip_negation("!")
    if r7 != ""
        print("FAIL gin_strip_negation-lone-bang: got '" + r7 + "' want ''")
        exit(1)

    // --- gin_split_rules ---
    let raw = []
    push(raw, "a.log")
    push(raw, "!keep.log")
    push(raw, "b.tmp")
    let split = gin_split_rules(raw)
    let ignore_list = split[0]
    let negate_list = split[1]
    if len(ignore_list) != 2
        print("FAIL gin_split_rules-ignore-len: got " + str(len(ignore_list)) + " want 2")
        exit(1)
    if ignore_list[0] != "a.log" or ignore_list[1] != "b.tmp"
        print("FAIL gin_split_rules-ignore-content")
        exit(1)
    if len(negate_list) != 1
        print("FAIL gin_split_rules-negate-len: got " + str(len(negate_list)) + " want 1")
        exit(1)
    if negate_list[0] != "keep.log"
        print("FAIL gin_split_rules-negate-content: got " + negate_list[0] + " want keep.log")
        exit(1)

    // --- gin_apply: basic ignore ---
    let p1 = []
    let r1a = ["*.log", 0]
    push(p1, r1a)
    let a1 = gin_apply(p1, "a.log", 0)
    if a1 != 1
        print("FAIL gin_apply-basic-ignore: got " + str(a1) + " want 1")
        exit(1)

    // --- gin_apply: negation un-ignores ---
    let p2 = []
    push(p2, ["*.log", 0])
    push(p2, ["important.log", 1])
    let a2 = gin_apply(p2, "important.log", 0)
    if a2 != 0
        print("FAIL gin_apply-negate: got " + str(a2) + " want 0")
        exit(1)

    // negated pattern does not affect an unrelated path
    let a2b = gin_apply(p2, "other.log", 0)
    if a2b != 1
        print("FAIL gin_apply-negate-unrelated: got " + str(a2b) + " want 1")
        exit(1)

    // --- gin_apply: last match wins (negate then re-ignore) ---
    let p3 = []
    push(p3, ["a.txt", 0])
    push(p3, ["a.txt", 1])
    let a3 = gin_apply(p3, "a.txt", 0)
    if a3 != 0
        print("FAIL gin_apply-last-wins-unignore: got " + str(a3) + " want 0")
        exit(1)

    let p4 = []
    push(p4, ["a.txt", 1])
    push(p4, ["a.txt", 0])
    let a4 = gin_apply(p4, "a.txt", 0)
    if a4 != 1
        print("FAIL gin_apply-last-wins-reignore: got " + str(a4) + " want 1")
        exit(1)

    // --- gin_apply: directory-only pattern ---
    let p5 = []
    push(p5, ["build/", 0])
    let a5 = gin_apply(p5, "build", 1)
    if a5 != 1
        print("FAIL gin_apply-dir-only-isdir: got " + str(a5) + " want 1")
        exit(1)
    let a5b = gin_apply(p5, "build", 0)
    if a5b != 0
        print("FAIL gin_apply-dir-only-notdir: got " + str(a5b) + " want 0")
        exit(1)

    // --- gin_apply: anchored pattern (exact segment count) ---
    let p6 = []
    push(p6, ["src/main.rs", 0])
    let a6 = gin_apply(p6, "src/main.rs", 0)
    if a6 != 1
        print("FAIL gin_apply-anchored-match: got " + str(a6) + " want 1")
        exit(1)
    let a6b = gin_apply(p6, "other/src/main.rs", 0)
    if a6b != 0
        print("FAIL gin_apply-anchored-nomatch: got " + str(a6b) + " want 0")
        exit(1)

    // --- gin_apply: unanchored pattern matches nested segment ---
    let p7 = []
    push(p7, ["*.log", 0])
    let a7 = gin_apply(p7, "a/b/c.log", 0)
    if a7 != 1
        print("FAIL gin_apply-unanchored-nested: got " + str(a7) + " want 1")
        exit(1)

    // --- gin_apply: empty pattern list ---
    let p8 = []
    let a8 = gin_apply(p8, "anything", 0)
    if a8 != 0
        print("FAIL gin_apply-empty-patterns: got " + str(a8) + " want 0")
        exit(1)

    print("PASS _gitignore_negate_test")
