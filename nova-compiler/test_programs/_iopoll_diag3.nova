fn connector()
  sleep(100)
  print("connecting...")
  let c = tcp_connect("127.0.0.1", 19879)
  print("connect result: " + str(c))
  if c >= 0
    tcp_send(c, "hi")
    tcp_close(c)
  print("connector done")

fn main()
  let server = tcp_listen(19879)
  print("server=" + str(server))
  io_set_nonblocking(server)

  let p = io_poll_create()
  io_poll_add(p, server, 1)
  print("polling...")

  spawn connector()

  let events = io_poll_wait(p, 3000)
  print("events=" + str(len(events)))

  if len(events) > 0
    print("GOT EVENT")
    let client = tcp_accept(server)
    if client >= 0
      let data = tcp_recv(client)
      print("data=" + data)
      tcp_close(client)
  else
    print("NO EVENTS - trying accept anyway")
    let client = tcp_accept(server)
    print("accept result=" + str(client))

  io_poll_close(p)
  tcp_close(server)
  sleep(200)
  print("done")
