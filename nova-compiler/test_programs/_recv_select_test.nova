// Erlang frontier Stage-1: selective receive. A worker matches tag 1 before tag 2 even though 2
// arrives first -> 2 is deferred to the save-queue and matched by the next receive (Erlang semantics).
fn worker(parent)
    receive
        1 => send_msg(parent, 100)
    receive
        2 => send_msg(parent, 200)

fn main()
    let me = self_pid()
    let w = spawn worker(me)
    let wb = mailbox_of(w)
    send_msg(wb, 2)        // arrives first, but no arm matches it in the 1st receive -> deferred
    send_msg(wb, 1)        // matched by the 1st receive
    let r1 = recv_msg()
    assert(r1 == 100, "1st reply 100 (matched 1, deferred 2)")
    let r2 = recv_msg()
    assert(r2 == 200, "2nd reply 200 (2 pulled from the save-queue)")
    print("RECV_SELECT_OK")
