fn main()
    let items = [10, 20, 30, 40, 50]
    let s1 = items[1..3]
    assert(len(s1) == 2, "1..3 should give 2 elements")
    assert(s1[0] == 20, "s1[0]")
    assert(s1[1] == 30, "s1[1]")
    let s2 = items[0..5]
    assert(len(s2) == 5, "full slice")
    assert(s2[4] == 50, "last elem")
    let s3 = items[3..5]
    assert(len(s3) == 2, "tail slice")
    assert(s3[0] == 40, "s3[0]")
    let s4 = items[1:3]
    assert(len(s4) == 2, "colon slice still works")
    assert(s4[0] == 20, "colon s4[0]")
    let s5 = "hello"[1..4]
    assert(s5 == "ell", "string slice with ..")
    let s6 = "hello"[1:4]
    assert(s6 == "ell", "string slice with :")
    print("slice_test: all passed")
