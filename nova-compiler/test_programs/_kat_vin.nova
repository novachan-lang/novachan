import forge_vin

fn tf(b: bool) -> string
    if b
        return "T"
    "F"

fn main()
    // classic published valid VIN (check digit 3 at position 9)
    print("classic=" + tf(vin_valid("1HGCM82633A004352")))
    print("cc_classic=" + vin_check_char("1HGCM82633A004352"))
    // another valid VIN (2017 Ford, check digit computed)
    print("allones=" + tf(vin_valid("11111111111111111")))
    // invalid: corrupted check digit
    print("bad_cd=" + tf(vin_valid("1HGCM82634A004352"))) 
    // invalid: contains forbidden letter O
    print("bad_O=" + tf(vin_valid("1HGCM8263OA004352")))
    // invalid: wrong length
    print("bad_len=" + tf(vin_valid("1HGCM82633A00435")))
