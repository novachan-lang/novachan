// KAT for forge_pwgen. This module MINTS SECRETS and had no KAT at all -- found by the adversarial
// verification pass on 2026-08-05.
//
// A generator's output is CSPRNG-random, so the known answers here are the module's INVARIANTS, which are
// exactly the properties a caller's security depends on:
//   1. the default alphabet is a fixed, KNOWN string (a silently changed pool changes every password's
//      entropy and can introduce shell/JSON-unsafe characters)
//   2. len(pwgen_alphabet()) == 83 -- the number a caller uses to size a password (log2(83) = 6.37 b/char)
//   3. every generator emits ONLY characters from its own pool, and never a byte outside it
//   4. a requested length is delivered EXACTLY -- no NUL truncation from a random 0x00 byte
//   5. a refused request is a NAMED error, never "" masquerading as a password and never a silent
//      fallback to a different alphabet
import forge_pwgen

fn only_from(s: string, pool: string) -> bool
    all_match([char_at(s, i) for i in 0..len(s)], (c) => find(pool, c) >= 0)

fn check(name: string, cond: bool, fails: list) -> int
    if not cond
        push(fails, name)
    0

// The error message, or "" when the Result is ok. Never unwrap_err an ok Result: a regression that turns
// an expected failure into a success would FAULT the KAT instead of naming the broken invariant. Proven by
// negative control B (a silent fallback in pwgen_named) -- the unguarded form aborted with
// "unwrap_err called on Ok/Some" and reported nothing.
fn errmsg(r) -> string
    if is_err(r)
        return unwrap_err(r)
    ""

fn main()
    // The KNOWN alphabets, written out here independently of the module so a change to either side shows up.
    let ALNUM = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
    let SYM = "!@#$%^&*()-_=+[];:,.?"
    let FULL = ALNUM + SYM
    let DIGITS = "0123456789"
    let fails = []

    // 1 + 2 -- the pools are exactly these strings, and the documented size is real
    check("alphabet_identity", pwgen_alphabet() == FULL, fails)
    check("alphabet_len_83", len(pwgen_alphabet()) == 83, fails)
    check("alnum_len_62", len(ALNUM) == 62, fails)
    check("sym_len_21", len(SYM) == 21, fails)
    let tbl = pwgen_alphabets()
    check("row_full", tbl["full"] == FULL, fails)
    check("row_alnum", tbl["alnum"] == ALNUM, fails)
    check("row_digits", tbl["digits"] == DIGITS, fails)
    check("names", join(pwgen_alphabet_names(), "|") == "full|alnum|digits", fails)

    // 3 + 4 -- pool containment and exact length, at a size big enough that a 0x00 byte is near-certain
    check("full_pool", only_from(pwgen(512), FULL), fails)
    check("alnum_pool", only_from(pwgen_alnum(512), ALNUM), fails)
    check("digits_pool", only_from(pwgen_digits(512), DIGITS), fails)
    check("alnum_no_punct", only_from(pwgen_alnum(512), ALNUM), fails)
    check("full_len", len(pwgen(512)) == 512, fails)
    check("alnum_len", len(pwgen_alnum(512)) == 512, fails)
    check("digits_len", len(pwgen_digits(512)) == 512, fails)
    check("len_1", len(pwgen(1)) == 1, fails)
    check("named_pool", only_from(unwrap_or(pwgen_named("alnum", 256), "!"), ALNUM), fails)

    // 5 -- refusals are named, and the "" adapter contract is intact
    check("zero_is_empty", pwgen(0) == "", fails)
    check("neg_is_empty", pwgen(0 - 1) == "", fails)
    check("zero_checked_err", is_err(pwgen_checked(0)), fails)
    check("zero_checked_msg", errmsg(pwgen_checked(0)) == "length must be positive, got 0", fails)
    check("neg_checked_msg", errmsg(pwgen_checked(0 - 4)) == "length must be positive, got -4", fails)
    check("empty_alpha_msg", errmsg(pwgen_over("", 8)) == "alphabet is empty", fails)
    check("unknown_name_err", is_err(pwgen_named("bogus", 16)), fails)
    check("unknown_name_msg", errmsg(pwgen_named("bogus", 16)) == "no such alphabet 'bogus'", fails)
    check("empty_name_err", is_err(pwgen_named("", 16)), fails)
    check("case_name_err", is_err(pwgen_named("FULL", 16)), fails)
    check("no_silent_fallback", is_err(pwgen_named("symbols", 16)), fails)

    // a 1-char alphabet must be a valid index domain (byte % 1 == 0), not an out-of-bounds read
    check("one_char_alpha", unwrap_or(pwgen_over("Z", 12), "") == "ZZZZZZZZZZZZ", fails)

    // passphrase: word count and the named wordlist failure
    let w = ["alpha", "bravo", "charlie", "delta"]
    check("phrase_4", len(split(passphrase(w, 4, "-"), "-")) == 4, fails)
    check("phrase_1", len(split(passphrase(w, 1, "-"), "-")) == 1, fails)
    check("phrase_words_subset", all_match(split(passphrase(w, 32, "-"), "-"), (x) => x in w), fails)
    check("phrase_empty_words", errmsg(passphrase_checked([], 3, "-")) == "wordlist is empty", fails)
    check("phrase_zero", errmsg(passphrase_checked(w, 0, "-")) == "length must be positive, got 0", fails)
    check("phrase_zero_adapter", passphrase(w, 0, "-") == "", fails)

    if len(fails) == 0
        print("PWGEN KAT PASS")
    else
        print("PWGEN KAT FAIL: " + join(fails, ", "))
