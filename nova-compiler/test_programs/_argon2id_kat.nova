// Adversarial KAT harness for std/crypto/argon2id (RFC 9106 section 5.3).
import std/crypto/argon2id

fn _hex(b) -> string
    let digs = "0123456789abcdef"
    let out = ""
    let n = bytes_len(b)
    let i = 0
    while i < n
        let x = bytes_get(b, i)
        out = out + char_at(digs, (x >> 4) & 15) + char_at(digs, x & 15)
        i = i + 1
    out

fn _fill(n: int, val: int) -> list
    let b = bytes(0)
    let i = 0
    while i < n
        b = bytes_append(b, val)
        i = i + 1
    b

fn eq_s(name: string, got: string, want: string)
    if got != want
        print("FAIL " + name)
        print("  got  " + got)
        print("  want " + want)
        exit(1)
    print("ok " + name)

fn main()
    // RFC 9106 section 5.3 Argon2id vector.
    let pwd = _fill(32, 0x01)
    let salt = _fill(16, 0x02)
    let secret = _fill(8, 0x03)
    let ad = _fill(12, 0x04)
    let tag = argon2id_raw(pwd, salt, secret, ad, 3, 32, 4, 32)
    eq_s("rfc9106-5.3", _hex(tag), "0d640df58d78766c08c037a34a8b53c9d01ef0452d75b65eb52520e96b01e659")

    // PHC round-trip: correct password verifies.
    let t2 = argon2id_hash(pwd, salt, 2, 32, 2, 32)
    let phc = argon2id_encode(salt, t2, 2, 32, 2)
    print("phc = " + phc)
    if argon2id_verify(pwd, phc)
        print("ok verify-correct")
    else
        print("FAIL verify-correct")
        exit(1)

    // wrong password rejects
    let wrong = _fill(32, 0x09)
    if argon2id_verify(wrong, phc)
        print("FAIL verify-wrong-accepted")
        exit(1)
    else
        print("ok verify-wrong-rejected")

    // tampered PHC (flip a tag char) rejects and does not crash
    let bad = ""
    let n = len(phc)
    let i = 0
    while i < n
        let ch = char_at(phc, i)
        if i == (n - 1)
            if ch == "A"
                bad = bad + "B"
            else
                bad = bad + "A"
        else
            bad = bad + ch
        i = i + 1
    if argon2id_verify(pwd, bad)
        print("FAIL verify-tampered-accepted")
        exit(1)
    else
        print("ok verify-tampered-rejected")

    // malformed PHC does not crash
    if argon2id_verify(pwd, "not-a-phc-string")
        print("FAIL verify-malformed-accepted")
        exit(1)
    else
        print("ok verify-malformed-rejected")

    // determinism + salt sensitivity
    let a = argon2id_hash(pwd, salt, 2, 32, 1, 32)
    let b = argon2id_hash(pwd, salt, 2, 32, 1, 32)
    eq_s("determinism", _hex(a), _hex(b))
    let salt2 = _fill(16, 0x05)
    let c = argon2id_hash(pwd, salt2, 2, 32, 1, 32)
    if _hex(a) == _hex(c)
        print("FAIL salt-insensitive")
        exit(1)
    print("ok salt-sensitive")

    print("ALL_ARGON2ID_KAT_PASSED")
