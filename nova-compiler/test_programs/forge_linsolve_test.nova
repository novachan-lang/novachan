import forge_linsolve

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn near(a: float, b: float) -> bool
    let d = a - b
    d > -0.001 and d < 0.001

fn main()
    let fails = 0

    // 2x2: 2x+y=5, x+3y=10 -> x=1, y=3
    let x1 = solve([[2, 1], [1, 3]], [5, 10])
    fails = fails + expect_true("2x2", near(x1[0], 1.0) and near(x1[1], 3.0))

    // identity -> x = b
    let x2 = solve([[1, 0, 0], [0, 1, 0], [0, 0, 1]], [7, 8, 9])
    fails = fails + expect_true("identity", near(x2[0], 7.0) and near(x2[1], 8.0) and near(x2[2], 9.0))

    // 3x3 known system:
    //  2x + y - z = 8
    // -3x - y + 2z = -11
    // -2x + y + 2z = -3   -> x=2, y=3, z=-1
    let x3 = solve([[2, 1, 0 - 1], [0 - 3, 0 - 1, 2], [0 - 2, 1, 2]], [8, 0 - 11, 0 - 3])
    fails = fails + expect_true("3x3", near(x3[0], 2.0) and near(x3[1], 3.0) and near(x3[2], 0 - 1.0))

    // system requiring pivoting (zero in the first pivot position)
    let x4 = solve([[0, 2, 1], [1, 0, 0], [0, 1, 1]], [5, 3, 3])
    // x=3; from row2: 2y+z=5, row3: y+z=3 -> y=2, z=1
    fails = fails + expect_true("pivoting", near(x4[0], 3.0) and near(x4[1], 2.0) and near(x4[2], 1.0))

    // singular matrix -> null
    let xs = solve([[1, 2], [2, 4]], [3, 6])
    fails = fails + expect_true("singular_null", xs == null)

    // verify: A x = b for the 3x3 case (residual ~ 0)
    let ax0 = 2.0 * x3[0] + 1.0 * x3[1] - 1.0 * x3[2]
    fails = fails + expect_true("residual", near(ax0, 8.0))

    // 1x1
    let x5 = solve([[4]], [12])
    fails = fails + expect_true("1x1", near(x5[0], 3.0))

    // floats with fractional solution: x+y=1, x-y=0 -> x=0.5,y=0.5
    let x6 = solve([[1, 1], [1, 0 - 1]], [1, 0])
    fails = fails + expect_true("fractional", near(x6[0], 0.5) and near(x6[1], 0.5))

    if fails == 0
        print("forge_linsolve: all passed")
    else
        print("forge_linsolve: " + str(fails) + " FAILED")
