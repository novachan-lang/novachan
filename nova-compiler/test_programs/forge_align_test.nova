import forge_align

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn degap(s: string) -> string
    let out = ""
    let i = 0
    while i < len(s)
        if char_at(s, i) != "-"
            out = out + char_at(s, i)
        i = i + 1
    out

fn main()
    let fails = 0

    // identical -> score = len * match, no gaps
    let r1 = align_global("GATTACA", "GATTACA", 1, 0 - 1, 0 - 1)
    fails = fails + expect("id_score", str(r1[0]), "7")
    fails = fails + expect("id_a", r1[1], "GATTACA")
    fails = fails + expect("id_b", r1[2], "GATTACA")

    // simple gap: AB vs ABC with a costly gap -> gap at end
    let r2 = align_global("AB", "ABC", 1, 0 - 1, 0 - 2)
    fails = fails + expect("gap_score", str(r2[0]), "0")
    fails = fails + expect("gap_a", r2[1], "AB-")
    fails = fails + expect("gap_b", r2[2], "ABC")

    // empty vs string -> all gaps
    let r3 = align_global("", "ABC", 1, 0 - 1, 0 - 1)
    fails = fails + expect("empty_score", str(r3[0]), "-3")
    fails = fails + expect("empty_a", r3[1], "---")
    fails = fails + expect("empty_b", r3[2], "ABC")

    // de-gap property: aligned strings, gaps removed, reconstruct the originals; equal length
    let a = "GCATGCU"
    let b = "GATTACA"
    let r4 = align_global(a, b, 1, 0 - 1, 0 - 1)
    fails = fails + expect("degap_a", degap(r4[1]), a)
    fails = fails + expect("degap_b", degap(r4[2]), b)
    fails = fails + expect("eqlen", str(len(r4[1]) == len(r4[2])), "1")
    // classic Needleman-Wunsch score for GCATGCU/GATTACA with (1,-1,-1) is 0
    fails = fails + expect("nw_score", str(r4[0]), "0")

    // align_score convenience
    fails = fails + expect("score_fn", str(align_score("ACGT", "ACGT", 2, 0 - 1, 0 - 1)), "8")
    fails = fails + expect("score_mismatch", str(align_score("ACGT", "ACCT", 1, 0 - 1, 0 - 2)), "2")

    if fails == 0
        print("forge_align: all passed")
    else
        print("forge_align: " + str(fails) + " FAILED")
