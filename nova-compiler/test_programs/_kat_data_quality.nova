import forge_data_quality

fn main()
    let d = dq_new()
    d = dq_add_check(d, "has_name", "not_null", "name")
    d = dq_add_check(d, "name_filled", "not_empty", "name")
    d = dq_add_check(d, "has_email", "not_null", "email")
    assert(dq_check_count(d) == 3, "3 checks")

    let good = {}
    good["name"] = "Alice"
    good["email"] = "a@b.com"
    let r1 = dq_run_check(d, 0, good)
    assert(is_ok(r1), "not_null pass")
    d = unwrap(r1)

    let r2 = dq_run_check(d, 1, good)
    assert(is_ok(r2), "not_empty pass")
    d = unwrap(r2)

    let empty = {}
    empty["name"] = ""
    let r3 = dq_run_check(d, 1, empty)
    assert(is_err(r3), "empty name fails not_empty")

    assert(dq_pass_rate(d) == 66, "66% pass")
    assert(dq_total_failures(d) == 1, "1 failure")

    let bad_idx = dq_run_check(d, 99, good)
    assert(is_err(bad_idx), "out of range is err")

    print("DATA-QUALITY KAT PASS")
