// KAT test for std/data/xmlpath — XPath-like query over XML strings.
// All 7 spec vectors plus round-trip and edge-case probes.
import std/data/xmlpath

fn cks(name: string, got: string, want: string)
    if got != want
        print("FAIL " + name + ": got='" + got + "' want='" + want + "'")
        exit(1)
    print("ok " + name)

fn cki(name: string, got: int, want: int)
    if got != want
        print("FAIL " + name + ": got=" + str(got) + " want=" + str(want))
        exit(1)
    print("ok " + name)

fn ckb(name: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + name + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)
    print("ok " + name)

fn main()
    // KAT 1 — spec: xp_first("<a><b>hi</b></a>", "a/b") == "hi"
    cks("first_simple", xp_first("<a><b>hi</b></a>", "a/b"), "hi")

    // KAT 2 — spec: xp_first("<a><b>1</b><b>2</b></a>", "a/b") == "1"  (returns FIRST)
    cks("first_of_many", xp_first("<a><b>1</b><b>2</b></a>", "a/b"), "1")

    // KAT 3 — spec: xp_all("<a><b>1</b><b>2</b></a>", "a/b") == ["1","2"]
    let all_b = xp_all("<a><b>1</b><b>2</b></a>", "a/b")
    cki("all_len", len(all_b), 2)
    cks("all_0", all_b[0], "1")
    cks("all_1", all_b[1], "2")

    // KAT 4 — spec: xp_count("<r><i>x</i><i>y</i><i>z</i></r>", "r/i") == 3
    cki("count_3", xp_count("<r><i>x</i><i>y</i><i>z</i></r>", "r/i"), 3)

    // KAT 5 — spec: xp_exists("<a><b>x</b></a>", "a/b") == true
    ckb("exists_true", xp_exists("<a><b>x</b></a>", "a/b"), true)

    // KAT 6 — spec: xp_exists("<a><b>x</b></a>", "a/c") == false
    ckb("exists_false", xp_exists("<a><b>x</b></a>", "a/c"), false)

    // KAT 7 — spec: xp_first("<a><b><c>deep</c></b></a>", "a/b/c") == "deep"
    cks("first_deep", xp_first("<a><b><c>deep</c></b></a>", "a/b/c"), "deep")

    // Edge: wrong root tag -> "" / 0 / false
    cks("wrong_root_first", xp_first("<a><b>hi</b></a>", "x/b"), "")
    cki("wrong_root_count", xp_count("<a><b>hi</b></a>", "x/b"), 0)
    ckb("wrong_root_exists", xp_exists("<a><b>hi</b></a>", "x/b"), false)

    // Edge: path == root only (single segment)
    cks("root_only", xp_first("<msg>hello</msg>", "msg"), "hello")

    // Edge: xp_all on empty match returns []
    let none = xp_all("<a><b>x</b></a>", "a/c")
    cki("all_empty", len(none), 0)

    // Edge: multiple children at deeper level
    cki("count_deep_multi", xp_count("<r><a><i>1</i><i>2</i></a><a><i>3</i></a></r>", "r/a/i"), 3)
    let deep3 = xp_all("<r><a><i>1</i><i>2</i></a><a><i>3</i></a></r>", "r/a/i")
    cks("deep_multi_0", deep3[0], "1")
    cks("deep_multi_1", deep3[1], "2")
    cks("deep_multi_2", deep3[2], "3")

    print("_xmlpath_test passed")
