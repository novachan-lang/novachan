import std/graph/bipartite

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // =========================================================================
    // EXAMPLE bipartite graph: A--C, A--D, B--C, B--D  (complete bipartite K2,2)
    // Expected 2-coloring: A->0, B->0, C->1, D->1  (or flipped per component start)
    // BFS from A: A=0, C=1, D=1, then B (unvisited) gets 0 -> A==B color (both 0).
    // =========================================================================
    let bip = {}
    bip["A"] = ["C", "D"]
    bip["B"] = ["C", "D"]
    bip["C"] = ["A", "B"]
    bip["D"] = ["A", "B"]
    let bip_nodes = ["A", "B", "C", "D"]

    // KAT 1: K2,2 is bipartite
    let bip_result = bipartite.bp_is_bipartite(bip, bip_nodes)
    if bip_result == false
        print("FAIL kat1_bip_is_bipartite: expected true")
        exit(1)

    // KAT 2: bp_odd_cycle_free is an alias for bp_is_bipartite
    let ocf_result = bipartite.bp_odd_cycle_free(bip, bip_nodes)
    if ocf_result == false
        print("FAIL kat2_odd_cycle_free: expected true")
        exit(1)

    // KAT 3 & 4: coloring — A and C must differ; A and B must be equal
    let col = bipartite.bp_coloring(bip, bip_nodes)
    let col_a = col["A"]
    let col_b = col["B"]
    let col_c = col["C"]
    // A and C are in different partitions -> different colors
    if col_a == col_c
        print("FAIL kat3_A_ne_C: A and C got same color " + str(col_a))
        exit(1)
    // A and B are in the same partition -> same color
    if col_a != col_b
        print("FAIL kat4_A_eq_B: A=" + str(col_a) + " B=" + str(col_b) + " expected equal")
        exit(1)

    // =========================================================================
    // EXAMPLE odd cycle (triangle): X--Y--Z--X
    // Three-cycle is NOT bipartite.
    // =========================================================================
    let tri = {}
    tri["X"] = ["Y", "Z"]
    tri["Y"] = ["X", "Z"]
    tri["Z"] = ["X", "Y"]
    let tri_nodes = ["X", "Y", "Z"]

    // KAT 5: triangle is NOT bipartite
    let tri_result = bipartite.bp_is_bipartite(tri, tri_nodes)
    if tri_result == true
        print("FAIL kat5_tri_not_bipartite: expected false")
        exit(1)

    // KAT 6: coloring of non-bipartite returns empty dict
    let tri_col = bipartite.bp_coloring(tri, tri_nodes)
    let tri_col_keys = keys(tri_col)
    cki("kat6_tri_coloring_empty", len(tri_col_keys), 0)

    // =========================================================================
    // ADDITIONAL: even cycle (4-cycle) P--Q--R--S--P is bipartite
    // =========================================================================
    let even = {}
    even["P"] = ["Q", "S"]
    even["Q"] = ["P", "R"]
    even["R"] = ["Q", "S"]
    even["S"] = ["R", "P"]
    let even_nodes = ["P", "Q", "R", "S"]

    let even_result = bipartite.bp_is_bipartite(even, even_nodes)
    if even_result == false
        print("FAIL kat7_even_cycle: expected true")
        exit(1)

    // =========================================================================
    // ADDITIONAL: disconnected graph — one bipartite component + one triangle
    // Overall graph must NOT be bipartite
    // =========================================================================
    let disc = {}
    disc["A2"] = ["B2"]
    disc["B2"] = ["A2"]
    disc["X2"] = ["Y2", "Z2"]
    disc["Y2"] = ["X2", "Z2"]
    disc["Z2"] = ["X2", "Y2"]
    let disc_nodes = ["A2", "B2", "X2", "Y2", "Z2"]

    let disc_result = bipartite.bp_is_bipartite(disc, disc_nodes)
    if disc_result == true
        print("FAIL kat8_disc_with_odd: expected false")
        exit(1)

    // =========================================================================
    // ADDITIONAL: isolated node — single node with no edges is bipartite
    // =========================================================================
    let iso = {}
    iso["N"] = []
    let iso_nodes = ["N"]

    let iso_result = bipartite.bp_is_bipartite(iso, iso_nodes)
    if iso_result == false
        print("FAIL kat9_isolated_node: expected true")
        exit(1)

    print("_bipartite_test passed")

main()
