import forge_idempotency_store

fn main()
    let s = ids_new(60)

    let r1 = ids_check(s, "req-001", 100)
    s = r1["s"]
    assert(r1["duplicate"] == 0, "first is new")

    s = ids_store(s, "req-001", "ok-200", 100)
    assert(ids_count(s) == 1, "1 stored")

    let r2 = ids_check(s, "req-001", 120)
    s = r2["s"]
    assert(r2["duplicate"] == 1, "duplicate detected")
    assert(r2["result"] == "ok-200", "cached result")

    let r3 = ids_check(s, "req-001", 200)
    s = r3["s"]
    assert(r3["duplicate"] == 0, "expired after TTL")

    let r4 = ids_check(s, "req-002", 100)
    s = r4["s"]
    assert(r4["duplicate"] == 0, "new key")

    assert(ids_hit_rate(s) == 25, "25% hit rate")

    print("IDEMPOTENCY-STORE KAT PASS")
