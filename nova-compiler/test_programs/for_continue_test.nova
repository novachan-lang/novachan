// Regression test for the for-in + continue codegen bug (fixed 2026-05-31).
// Before the fix, `continue` inside `for x in list` jumped to the loop
// condition WITHOUT advancing the iterator index → infinite loop.
// Uses assert so a wrong result fails the regression suite (a regression would
// otherwise re-introduce the hang, caught by the run timeout).

fn simple_skip(items: list) -> int
    let kept = 0
    for v in items
        if v == "skip"
            continue
        kept = kept + 1
    kept

fn multi_continue(nums: list) -> int
    let total = 0
    for n in nums
        if n < 0
            continue
        if n % 2 == 0
            continue
        total = total + n
    total

fn all_skipped(items: list) -> int
    let count = 0
    for v in items
        continue
    count

fn nested_continue(rows: list) -> int
    let total = 0
    for row in rows
        for c in row
            if c == 0
                continue
            total = total + c
    total

fn continue_then_break(items: list) -> int
    let seen = 0
    for v in items
        if v == "skip"
            continue
        if v == "stop"
            break
        seen = seen + 1
    seen

fn dict_continue(d: dict) -> int
    let sum = 0
    for k in keys(d)
        if d[k] < 0
            continue
        sum = sum + d[k]
    sum

fn string_continue(s: string) -> int
    let count = 0
    for ch in chars(s)
        if ch != "a"
            continue
        count = count + 1
    count

fn match_continue(items: list) -> int
    let kept = 0
    for v in items
        match v
            0 =>
                continue
            _ =>
                kept = kept + 1
    kept

fn deep_nesting(matrix: list) -> int
    let acc = 0
    for row in matrix
        let i = 0
        while i < len(row)
            let cell = row[i]
            i = i + 1
            for x in cell
                if x == 0
                    continue
                acc = acc + x
    acc

fn main()
    assert(simple_skip(["a", "skip", "b", "skip", "c"]) == 3, "simple_skip")
    assert(multi_continue([-1, 2, 3, -5, 4, 1, 6]) == 4, "multi_continue")
    assert(all_skipped(["x", "y", "z"]) == 0, "all_skipped")
    assert(nested_continue([[1, 0, 2], [0, 3, 0], [4, 5, 6]]) == 21, "nested_continue")
    assert(continue_then_break(["a", "skip", "b", "stop", "c"]) == 2, "continue_then_break")
    assert(dict_continue({"a": 3, "b": -2, "c": 5, "d": -9}) == 8, "dict_continue")
    assert(string_continue("banana") == 3, "string_continue")
    assert(match_continue([0, 7, 0, 9]) == 2, "match_continue")
    assert(deep_nesting([[[1, 0, 2], [3]], [[0, 0], [4, 2]]]) == 12, "deep_nesting")
    print("for_continue_test: all assertions passed")
