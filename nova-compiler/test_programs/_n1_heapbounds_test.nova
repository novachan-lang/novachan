// Stage 0A guard (run with NOVA_CARRIERS>1): hammer concurrent ANY-typed allocation + dispatch across
// carriers to stress nova_track_heap_bounds (the monotonic-CAS write race) and find_tag (the any-
// dispatch consumer of the [base,top) heap bounds). A clobbered bound => find_tag misclassifies a
// genuine heap object as a raw int => crash or wrong result. Each worker allocates a list + a dict and
// reads the list back THROUGH the dict value (any-typed) so find_tag fires; asserts the exact sum.
// At N=1 it is a correct cooperative run; the bug only manifests at N>1, so the gate runs it at N=4.

fn worker(reps)
    let acc = 0
    let i = 0
    while i < reps
        let xs = [i, i + 1, i + 2, i + 3]   // list alloc -> tracks heap bounds
        let d = {}                          // dict alloc -> tracks heap bounds
        d["v"] = xs                         // store list as an any-typed dict value
        let got = d["v"]                    // read back through `any` -> find_tag dispatch
        acc = acc + len(got) + got[0]       // len + index through `any`
        i = i + 1
    acc

fn main() -> int
    let workers = 8
    let reps = 5000
    let hub = channel()
    let w = 0
    while w < workers
        spawn fn()
            send(hub, worker(reps))
        w = w + 1
    let total = 0
    let got = 0
    while got < workers
        total = total + receive(hub)
        got = got + 1
    // per worker: sum over i in [0,reps) of (len=4 + got[0]=i) = reps*4 + reps*(reps-1)/2
    let expected = workers * (reps * 4 + reps * (reps - 1) / 2)
    if total != expected
        print("FAIL n1_heapbounds total=" + str(total) + " expected=" + str(expected))
        exit(1)
    print("PASS n1_heapbounds (" + str(workers) + " workers x" + str(reps) + " any-alloc+dispatch)")
    return 0
