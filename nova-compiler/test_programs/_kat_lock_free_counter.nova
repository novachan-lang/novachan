import forge_lock_free_counter

fn main()
    let c = lfc_new()
    c = lfc_create(c, "hits")
    c = lfc_create(c, "errors")
    assert(lfc_counter_count(c) == 2, "2 counters")

    let r1 = lfc_increment(c, "hits")
    assert(is_ok(r1), "inc ok")
    assert(unwrap(r1) == 1, "hits=1")
    let r2 = lfc_increment(c, "hits")
    assert(is_ok(r2), "inc again")
    assert(unwrap(r2) == 2, "hits=2")

    let r3 = lfc_decrement(c, "hits")
    assert(is_ok(r3), "dec ok")
    assert(unwrap(r3) == 1, "hits=1 after dec")

    let g = lfc_get(c, "hits")
    assert(is_ok(g), "get ok")
    assert(unwrap(g) == 1, "get hits=1")

    assert(lfc_total_ops(c) == 3, "3 ops")

    let r4 = lfc_reset(c, "hits")
    assert(is_ok(r4), "reset ok")
    c = unwrap(r4)
    let g2 = lfc_get(c, "hits")
    assert(unwrap(g2) == 0, "reset to 0")

    let bad = lfc_increment(c, "nope")
    assert(is_err(bad), "not found")

    print("LOCK-FREE-COUNTER KAT PASS")
