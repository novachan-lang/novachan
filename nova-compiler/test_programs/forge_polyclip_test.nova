import forge_polyclip

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn near(a: float, b: float) -> bool
    let d = a - b
    d > -0.001 and d < 0.001

// all vertices within [minx,maxx] x [miny,maxy] (with small epsilon)
fn all_in_bounds(poly, minx: float, miny: float, maxx: float, maxy: float) -> bool
    let ok = true
    let i = 0
    while i < len(poly)
        let x = poly[i][0]
        let y = poly[i][1]
        if x < minx - 0.001 or x > maxx + 0.001 or y < miny - 0.001 or y > maxy + 0.001
            ok = false
        i = i + 1
    ok

fn main()
    let fails = 0

    // big square clipped to an inner rectangle -> the inner rectangle (4 vertices)
    let bigsq = [[0.0, 0.0], [10.0, 0.0], [10.0, 10.0], [0.0, 10.0]]
    let clipped = clip_rect(bigsq, 2, 2, 8, 8)
    fails = fails + expect("bigsq_verts", str(len(clipped)), "4")
    fails = fails + expect_true("bigsq_bounds", all_in_bounds(clipped, 2.0, 2.0, 8.0, 8.0))
    // the clipped square should have corners at (2,2),(8,2),(8,8),(2,8) - check bounding extent
    let minx = 999.0
    let maxx = 0 - 999.0
    let i = 0
    while i < len(clipped)
        if clipped[i][0] < minx
            minx = clipped[i][0]
        if clipped[i][0] > maxx
            maxx = clipped[i][0]
        i = i + 1
    fails = fails + expect_true("bigsq_extent", near(minx, 2.0) and near(maxx, 8.0))

    // polygon fully inside the clip -> unchanged vertex count (4)
    let inner = [[3.0, 3.0], [7.0, 3.0], [7.0, 7.0], [3.0, 7.0]]
    let stay = clip_rect(inner, 0, 0, 10, 10)
    fails = fails + expect("inside_count", str(len(stay)), "4")

    // polygon fully outside -> empty
    let outside = [[20.0, 20.0], [30.0, 20.0], [30.0, 30.0], [20.0, 30.0]]
    fails = fails + expect("outside_empty", str(len(clip_rect(outside, 0, 0, 10, 10))), "0")

    // triangle partly outside -> clipped, all vertices in bounds
    let tri = [[0.0, 0.0], [10.0, 0.0], [5.0, 10.0]]
    let ctri = clip_rect(tri, 2, 2, 8, 8)
    fails = fails + expect_true("tri_clipped_nonempty", len(ctri) > 0)
    fails = fails + expect_true("tri_in_bounds", all_in_bounds(ctri, 2.0, 2.0, 8.0, 8.0))

    // clip against a convex (triangle) clip region
    let sq = [[0.0, 0.0], [6.0, 0.0], [6.0, 6.0], [0.0, 6.0]]
    let clipTri = [[0.0, 0.0], [6.0, 0.0], [0.0, 6.0]]
    let cc = clip_polygon(sq, clipTri)
    fails = fails + expect_true("convex_clip_nonempty", len(cc) > 0)

    if fails == 0
        print("forge_polyclip: all passed")
    else
        print("forge_polyclip: " + str(fails) + " FAILED")
