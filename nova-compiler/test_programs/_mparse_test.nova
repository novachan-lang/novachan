import std/money/parse

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL mparse " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL mparse " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // ── mparse_minor KAT vectors ──────────────────────────────────────────────

    // Basic: 1,234.56 with 2 decimals -> 123456
    cki("minor_basic", mparse_minor("1,234.56", 2), 123456)

    // Leading $: strip and parse
    cki("minor_dollar", mparse_minor("$1,234.56", 2), 123456)

    // Pad fractional part: "1234.5" with 2 decimals -> "50" frac -> 123450
    cki("minor_pad_frac", mparse_minor("1234.5", 2), 123450)

    // Negative: -12.34 with 2 decimals -> -1234
    cki("minor_negative", mparse_minor("-12.34", 2), -1234)

    // No decimal point: 1000 with 2 decimals -> 100000
    cki("minor_no_decimal", mparse_minor("1000", 2), 100000)

    // Truncate excess frac digits: "12.345" with 2 decimals -> keep "34" -> 1234
    cki("minor_trunc_frac", mparse_minor("12.345", 2), 1234)

    // Zero decimals (JPY-style): "1234" -> 1234
    cki("minor_zero_dec", mparse_minor("1234", 0), 1234)

    // Currency code prefix: "USD 12.00" -> 1200
    cki("minor_usd_prefix", mparse_minor("USD 12.00", 2), 1200)

    // Zero amount
    cki("minor_zero", mparse_minor("0.00", 2), 0)

    // Small amount: "$0.05" -> 5
    cki("minor_small", mparse_minor("$0.05", 2), 5)

    // ── mparse_detect_decimals KAT vectors ────────────────────────────────────

    cki("detect_2", mparse_detect_decimals("12.34"), 2)
    cki("detect_0", mparse_detect_decimals("12"), 0)
    cki("detect_1", mparse_detect_decimals("1.5"), 1)
    cki("detect_3", mparse_detect_decimals("1.234"), 3)

    // ── mparse_strip_symbols ──────────────────────────────────────────────────

    cks("strip_dollar", mparse_strip_symbols("$1,234.56"), "1234.56")
    cks("strip_usd", mparse_strip_symbols("USD 12.00"), "12.00")
    cks("strip_neg", mparse_strip_symbols("-12.34"), "-12.34")
    cks("strip_clean", mparse_strip_symbols("1234.56"), "1234.56")

    // ── mparse_sign ───────────────────────────────────────────────────────────

    cki("sign_pos", mparse_sign("1234.56"), 1)
    cki("sign_neg", mparse_sign("-12.34"), -1)
    cki("sign_dollar_pos", mparse_sign("$1.00"), 1)

    // ── mparse_int_part / mparse_frac_part ────────────────────────────────────

    cks("int_part_basic", mparse_int_part("1234.56"), "1234")
    cks("int_part_no_dot", mparse_int_part("1234"), "1234")
    cks("int_part_neg", mparse_int_part("-12.34"), "12")
    cks("frac_part_basic", mparse_frac_part("1234.56"), "56")
    cks("frac_part_no_dot", mparse_frac_part("1234"), "")
    cks("frac_part_neg", mparse_frac_part("-12.34"), "34")

    // ── mparse_is_valid ───────────────────────────────────────────────────────

    cki("valid_basic", mparse_is_valid("1234.56"), 1)
    cki("valid_neg", mparse_is_valid("-12.34"), 1)
    cki("valid_int", mparse_is_valid("1234"), 1)
    cki("valid_empty", mparse_is_valid(""), 0)

    print("PASS _mparse_test")
