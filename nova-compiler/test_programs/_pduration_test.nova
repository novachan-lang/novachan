// KAT for std/time/pduration — ISO 8601 P-notation duration parse/format/totals.
import std/time/pduration

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL pduration " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL pduration " + label + ": got '" + got + "' want '" + want + "'")
        exit(1)

fn main()
    // ── pd_parse: full ISO 8601 ──────────────────────────────────────────────
    let p1 = pd_parse("P1Y2M3DT4H5M6S")
    cki("full-years",  p1["years"],  1)
    cki("full-months", p1["months"], 2)
    cki("full-days",   p1["days"],   3)
    cki("full-hours",  p1["hours"],  4)
    cki("full-mins",   p1["mins"],   5)
    cki("full-secs",   p1["secs"],   6)

    // ── pd_parse: time-only ─────────────────────────────────────────────────
    let p2 = pd_parse("PT30M")
    cki("tonly-years",  p2["years"],  0)
    cki("tonly-months", p2["months"], 0)
    cki("tonly-days",   p2["days"],   0)
    cki("tonly-hours",  p2["hours"],  0)
    cki("tonly-mins",   p2["mins"],   30)
    cki("tonly-secs",   p2["secs"],   0)

    // ── pd_parse: date only (no T) ──────────────────────────────────────────
    let p3 = pd_parse("P5D")
    cki("donly-days",   p3["days"],   5)
    cki("donly-hours",  p3["hours"],  0)

    // ── pd_parse: malformed → all zero ──────────────────────────────────────
    let p4 = pd_parse("garbage")
    cki("mal-years",  p4["years"],  0)
    cki("mal-months", p4["months"], 0)
    cki("mal-secs",   p4["secs"],   0)

    // ── pd_format: specified vectors ────────────────────────────────────────
    let fd1 = {}
    fd1["days"] = 3
    fd1["hours"] = 4
    cks("fmt-days-hours", pd_format(fd1), "P3DT4H")

    let fd2 = {}
    fd2["secs"] = 90
    cks("fmt-secs90", pd_format(fd2), "PT90S")

    // ── pd_format: full dict ────────────────────────────────────────────────
    let fd3 = {}
    fd3["years"] = 1
    fd3["months"] = 2
    fd3["days"] = 3
    fd3["hours"] = 4
    fd3["mins"] = 5
    fd3["secs"] = 6
    cks("fmt-full", pd_format(fd3), "P1Y2M3DT4H5M6S")

    // ── pd_format: all-zero → PT0S ──────────────────────────────────────────
    let fd4 = {}
    fd4["years"] = 0
    fd4["months"] = 0
    fd4["days"] = 0
    fd4["hours"] = 0
    fd4["mins"] = 0
    fd4["secs"] = 0
    cks("fmt-zero", pd_format(fd4), "PT0S")

    // ── pd_format: date-only (no time portion) ──────────────────────────────
    let fd5 = {}
    fd5["years"] = 2
    fd5["months"] = 6
    cks("fmt-date-only", pd_format(fd5), "P2Y6M")

    // ── pd_total_seconds: specified vectors ─────────────────────────────────
    let ts1 = {}
    ts1["hours"] = 1
    ts1["mins"] = 30
    cki("total-1h30m", pd_total_seconds(ts1), 5400)

    let ts2 = {}
    ts2["days"] = 1
    cki("total-1day", pd_total_seconds(ts2), 86400)

    // ── pd_total_seconds: mixed ─────────────────────────────────────────────
    let ts3 = {}
    ts3["years"] = 1
    cki("total-1year", pd_total_seconds(ts3), 31536000)

    let ts4 = {}
    ts4["months"] = 1
    cki("total-1month", pd_total_seconds(ts4), 2592000)

    // ── Round-trip ──────────────────────────────────────────────────────────
    cks("roundtrip", pd_format(pd_parse("P1Y2M3DT4H5M6S")), "P1Y2M3DT4H5M6S")

    // ── Additional edge cases ────────────────────────────────────────────────
    // PT0S round-trip
    let pz = pd_parse("PT0S")
    cki("pt0s-secs", pz["secs"], 0)
    cki("pt0s-mins", pz["mins"], 0)
    // Large values
    let ts5 = {}
    ts5["days"] = 7
    ts5["hours"] = 2
    ts5["mins"] = 30
    cki("total-7d2h30m", pd_total_seconds(ts5), 613800)

    print("PASS _pduration_test")
