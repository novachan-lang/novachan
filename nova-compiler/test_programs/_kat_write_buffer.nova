import forge_write_buffer

fn main()
    let w = wb_new(3)
    assert(wb_threshold(w) == 3, "threshold=3")
    assert(wb_pending(w) == 0, "0 pending")
    assert(wb_should_flush(w) == 0, "no flush needed")

    w = wb_write(w, "line1")
    w = wb_write(w, "line2")
    assert(wb_pending(w) == 2, "2 pending")
    assert(wb_should_flush(w) == 0, "not yet")

    w = wb_write(w, "line3")
    assert(wb_should_flush(w) == 1, "flush needed")

    let r1 = wb_flush(w)
    assert(is_ok(r1), "flush ok")
    w = unwrap(r1)
    assert(wb_pending(w) == 0, "0 after flush")
    assert(wb_total_flushed(w) == 3, "3 flushed")
    assert(wb_flush_count(w) == 1, "1 flush")

    let r2 = wb_flush(w)
    assert(is_err(r2), "empty buffer err")

    w = wb_write(w, "line4")
    w = wb_write(w, "line5")
    w = wb_write(w, "line6")
    w = wb_write(w, "line7")
    let r3 = wb_flush(w)
    assert(is_ok(r3), "flush2 ok")
    w = unwrap(r3)
    assert(wb_total_flushed(w) == 7, "7 total flushed")
    assert(wb_flush_count(w) == 2, "2 flushes")

    print("WRITE-BUFFER KAT PASS")
