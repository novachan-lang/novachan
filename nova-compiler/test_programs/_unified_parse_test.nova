// KAT for std/text/unified_parse
import std/text/unified_parse

// ── helpers ──────────────────────────────────────────────────────────────────

fn _ck_int(got, want, label)
    if got != want
        print("FAIL unified_parse " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn _ck_str(got, want, label)
    if got != want
        print("FAIL unified_parse " + label + ": got " + got + " want " + want)
        exit(1)

fn _op_tag(op)
    op[0]

fn _op_text(op)
    op[1]

// ── KAT 1: single-hunk diff — canonical spec vector ──────────────────────────
// "@@ -1,3 +1,3 @@\n a\n-b\n+x\n c\n"
// -> one hunk: a_start=1 a_count=3 b_start=1 b_count=3
//    lines: ["=","a"] ["-","b"] ["+","x"] ["=","c"]
fn main()
    let nl = chr(10)

    let diff1 = "@@ -1,3 +1,3 @@" + nl + " a" + nl + "-b" + nl + "+x" + nl + " c" + nl

    let hunks1 = unified_parse(diff1)
    _ck_int(len(hunks1), 1, "KAT1 hunk count")

    let h1 = hunks1[0]
    _ck_int(h1["a_start"], 1, "KAT1 a_start")
    _ck_int(h1["a_count"], 3, "KAT1 a_count")
    _ck_int(h1["b_start"], 1, "KAT1 b_start")
    _ck_int(h1["b_count"], 3, "KAT1 b_count")

    let ops1 = h1["lines"]
    _ck_int(len(ops1), 4, "KAT1 op count")

    _ck_str(_op_tag(ops1[0]), "=", "KAT1 op0 tag")
    _ck_str(_op_text(ops1[0]), "a", "KAT1 op0 text")

    _ck_str(_op_tag(ops1[1]), "-", "KAT1 op1 tag")
    _ck_str(_op_text(ops1[1]), "b", "KAT1 op1 text")

    _ck_str(_op_tag(ops1[2]), "+", "KAT1 op2 tag")
    _ck_str(_op_text(ops1[2]), "x", "KAT1 op2 text")

    _ck_str(_op_tag(ops1[3]), "=", "KAT1 op3 tag")
    _ck_str(_op_text(ops1[3]), "c", "KAT1 op3 text")

    // ── KAT 2: empty input -> 0 hunks ────────────────────────────────────────
    _ck_int(unified_hunks(""), 0, "KAT2 empty hunks")

    let hunks2 = unified_parse("")
    _ck_int(len(hunks2), 0, "KAT2 empty parse")

    // ── KAT 3: 2-hunk diff -> count 2 ────────────────────────────────────────
    let diff3 = "@@ -1,2 +1,2 @@" + nl + " ctx1" + nl + "-old1" + nl + "+new1" + nl + "@@ -10,2 +10,2 @@" + nl + " ctx2" + nl + "-old2" + nl + "+new2" + nl

    _ck_int(unified_hunks(diff3), 2, "KAT3 two-hunk count")

    let hunks3 = unified_parse(diff3)
    _ck_int(len(hunks3), 2, "KAT3 parse count")

    let h3a = hunks3[0]
    _ck_int(h3a["a_start"], 1, "KAT3 hunk0 a_start")
    _ck_int(h3a["a_count"], 2, "KAT3 hunk0 a_count")

    let h3b = hunks3[1]
    _ck_int(h3b["a_start"], 10, "KAT3 hunk1 a_start")
    _ck_int(h3b["a_count"], 2,  "KAT3 hunk1 a_count")

    // ── KAT 4: malformed header -> empty list (robust parse) ─────────────────
    let hunks4 = unified_parse("@@ garbage @@" + nl + " line" + nl)
    _ck_int(len(hunks4), 0, "KAT4 malformed header")

    // ── KAT 5: no hunk headers at all ────────────────────────────────────────
    let hunks5 = unified_parse("--- a/foo.txt" + nl + "+++ b/foo.txt" + nl + " context" + nl)
    _ck_int(len(hunks5), 0, "KAT5 no hunk headers")

    // ── KAT 6: hunk with no count (abbreviated form "@@ -5 +5 @@") ───────────
    let diff6 = "@@ -5 +5 @@" + nl + " same" + nl
    let hunks6 = unified_parse(diff6)
    _ck_int(len(hunks6), 1, "KAT6 abbreviated header hunk count")
    let h6 = hunks6[0]
    _ck_int(h6["a_start"], 5, "KAT6 a_start")
    _ck_int(h6["a_count"], 1, "KAT6 a_count default")
    _ck_int(h6["b_start"], 5, "KAT6 b_start")
    _ck_int(h6["b_count"], 1, "KAT6 b_count default")

    // ── KAT 7: diff with file headers followed by hunk ────────────────────────
    let diff7 = "--- a/file.txt" + nl + "+++ b/file.txt" + nl + "@@ -1,1 +1,1 @@" + nl + "-old" + nl + "+new" + nl
    let hunks7 = unified_parse(diff7)
    _ck_int(len(hunks7), 1, "KAT7 with-file-headers count")
    let h7 = hunks7[0]
    _ck_int(h7["a_start"], 1, "KAT7 a_start")
    let ops7 = h7["lines"]
    _ck_int(len(ops7), 2, "KAT7 op count")
    _ck_str(_op_tag(ops7[0]), "-", "KAT7 op0 tag")
    _ck_str(_op_tag(ops7[1]), "+", "KAT7 op1 tag")

    print("PASS _unified_parse_test")
