// KAT: two surface forms the founding spec uses that the implementation had drifted from.
//   1. `-> T or E`         fallible return type  (spec program 9)
//   2. `f(name = value)`   named argument spelling (spec program 10)
// Both are pure surface: `or` desugars to Result<T,E>, and `=` is accepted alongside
// the `:` spelling the implementation already had.

type Cfg
    c_host: string
    c_port: int

fn half(n: int) -> int or string
    if n % 2 == 1
        return err("odd")
    ok(n / 2)

fn mk(host: string, port: int, retries: int) -> Cfg
    Cfg { c_host: host, c_port: port + retries }

fn main()
    let ok_n = 0
    let fail = 0

    match half(10)
        Ok(v) =>
            if v == 5
                ok_n = ok_n + 1
                print("ok: `-> T or E` ok path")
            else
                fail = fail + 1
        Err(e) =>
            fail = fail + 1
            print("FAIL or-type ok path")
    match half(7)
        Ok(v) =>
            fail = fail + 1
            print("FAIL or-type should be err")
        Err(e) =>
            if e == "odd"
                ok_n = ok_n + 1
                print("ok: `-> T or E` err path")
            else
                fail = fail + 1

    // `else` composes with an `or`-typed function
    let h = half(9) else -1
    if h == -1
        ok_n = ok_n + 1
        print("ok: `else` fallback on an `or`-typed return")
    else
        fail = fail + 1
        print("FAIL else on or-type: " + str(h))

    // named args, `=` spelling, out of declaration order
    let a = mk(port = 80, retries = 3, host = "x")
    // named args, `:` spelling, still works
    let b = mk(host: "x", port: 80, retries: 3)
    if a.c_port == 83 and b.c_port == 83 and a.c_host == "x" and b.c_host == "x"
        ok_n = ok_n + 1
        print("ok: named args accept both `=` and `:`, order-independent")
    else
        fail = fail + 1
        print("FAIL named args: " + str(a.c_port) + " " + str(b.c_port))

    // positional calls must be unaffected
    let c = mk("y", 1, 2)
    if c.c_port == 3 and c.c_host == "y"
        ok_n = ok_n + 1
        print("ok: positional calls unaffected")
    else
        fail = fail + 1

    print("ok=" + str(ok_n) + " fail=" + str(fail))
    assert(fail == 0, "spec_surface: all checks pass")
    assert(ok_n == 5, "spec_surface: all 5 checks ran")
    print("KAT spec_surface PASS")
