fn registry_new()
  {}

fn reg_register(r, name, factory)
  r[name] = factory

fn reg_create(r, name, arg)
  if not contains(r, name)
    return err("unknown: " + name)
  let factory = r[name]
  ok(factory(arg))

fn reg_has(r, name)
  contains(r, name)

fn reg_names(r)
  keys(r)

fn reg_count(r)
  len(keys(r))

fn _make_circle(radius)
  {"shape": "circle", "radius": radius}

fn _make_rect(size)
  {"shape": "rect", "width": size, "height": size}

fn main()
  let shapes = registry_new()
  reg_register(shapes, "circle", fn(z) _make_circle(z))
  reg_register(shapes, "rect", fn(z) _make_rect(z))

  assert(reg_has(shapes, "circle") == 1, "has circle")
  assert(reg_has(shapes, "triangle") == 0, "no triangle")
  assert(reg_count(shapes) == 2, "2 registered")

  let c = reg_create(shapes, "circle", 5)
  assert(is_ok(c), "create ok")
  let circle = unwrap(c)
  assert(circle["shape"] == "circle", "is circle")
  assert(circle["radius"] == 5, "radius 5")

  let r2 = reg_create(shapes, "rect", 10)
  let rect = unwrap(r2)
  assert(rect["width"] == 10, "width 10")

  let bad = reg_create(shapes, "triangle", 3)
  assert(is_err(bad), "unknown = err")

  let names = reg_names(shapes)
  assert(len(names) == 2, "2 names")

  print("regtryx: all passed")
