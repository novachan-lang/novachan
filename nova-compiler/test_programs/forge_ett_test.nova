import forge_ett as ett

fn check(cond: bool, label: str)
    if cond == false
        print("FAIL: " + label)

// Reference forest model with parent pointers.
fn ref_connected(parent: list, u: int, v: int) -> bool
    let ru = u
    while parent[ru] >= 0
        ru = parent[ru]
    let rv = v
    while parent[rv] >= 0
        rv = parent[rv]
    return ru == rv

fn ref_component_size(n: int, parent: list, u: int) -> int
    // root of u
    let ru = u
    while parent[ru] >= 0
        ru = parent[ru]
    // count nodes whose root is ru
    let cnt = 0
    let w = 0
    while w < n
        let cur = w
        while parent[cur] >= 0
            cur = parent[cur]
        if cur == ru
            cnt = cnt + 1
        w = w + 1
    return cnt

// TEST 1: basic link/connected
let e = ett.ett_new(5)
check(ett.ett_connected(e, 0, 1) == false, "initially disconnected")
ett.ett_link(e, 0, 1)
check(ett.ett_connected(e, 0, 1), "linked 0-1 connected")
check(ett.ett_component_size(e, 0) == 2, "component size 2 after link")
ett.ett_link(e, 1, 2)
check(ett.ett_connected(e, 0, 2), "0-2 connected via 1")
check(ett.ett_component_size(e, 0) == 3, "component size 3")
check(ett.ett_connected(e, 0, 3) == false, "0-3 still disconnected")

// TEST 2: cut splits
ett.ett_cut(e, 1, 2)
check(ett.ett_connected(e, 0, 2) == false, "after cut 1-2, 0-2 disconnected")
check(ett.ett_connected(e, 0, 1), "0-1 still connected")
check(ett.ett_component_size(e, 0) == 2, "component size 2 after cut")
check(ett.ett_component_size(e, 2) == 1, "node 2 isolated size 1")

// TEST 3: relink
ett.ett_link(e, 2, 0)
check(ett.ett_connected(e, 2, 1), "relink reconnects")

// TEST 4: DECISIVE cross-check with a reference forest (LINK/CUT that maintain a valid forest)
// We maintain edges as a set; only link when u,v are in different trees; only cut existing edges.
let n = 10
let e2 = ett.ett_new(n)
let parent = []
let i = 0
while i < n
    push(parent, 0 - 1)
    i = i + 1
// track undirected edges as a list of [a,b]
let edges = []
let ok = true
let seed = 77777
let step = 0
while step < 250
    seed = (seed * 1103515245 + 12345) % 2147483648
    let op = seed % 3
    seed = (seed * 1103515245 + 12345) % 2147483648
    let u = seed % n
    seed = (seed * 1103515245 + 12345) % 2147483648
    let v = seed % n
    if op == 0
        // link if different trees
        if u != v and ref_connected(parent, u, v) == false
            ett.ett_link(e2, u, v)
            // in reference: make u's root a child of v (attach the tree)
            let ru = u
            while parent[ru] >= 0
                ru = parent[ru]
            parent[ru] = v
            push(edges, [u, v])
    else
        if op == 1
            // cut a RANDOM existing edge
            if len(edges) > 0
                seed = (seed * 1103515245 + 12345) % 2147483648
                let ei = seed % len(edges)
                let a = edges[ei][0]
                let b = edges[ei][1]
                ett.ett_cut(e2, a, b)
                // reference: recompute parent pointers by removing edge (a,b) and rebuilding the forest
                // remove edge from list
                let new_edges = []
                let k = 0
                while k < len(edges)
                    if k != ei
                        push(new_edges, edges[k])
                    k = k + 1
                edges = new_edges
                // rebuild parent from scratch from remaining edges (BFS each component)
                parent = _rebuild_parent(n, edges)
        else
            // connectivity query
            let exp = ref_connected(parent, u, v)
            let got = ett.ett_connected(e2, u, v)
            if exp != got
                ok = false
                print("CONN MISMATCH step=" + str(step) + " u=" + str(u) + " v=" + str(v) + " exp=" + str(exp) + " got=" + str(got))
    step = step + 1
check(ok, "DECISIVE: 250 random link/cut/connected ops match reference forest")

fn _rebuild_parent(n: int, edges: list) -> list
    // build adjacency
    let adj = []
    let i = 0
    while i < n
        push(adj, [])
        i = i + 1
    let ei2 = 0
    while ei2 < len(edges)
        push(adj[edges[ei2][0]], edges[ei2][1])
        push(adj[edges[ei2][1]], edges[ei2][0])
        ei2 = ei2 + 1
    let parent = []
    let visited = []
    let j = 0
    while j < n
        push(parent, 0 - 1)
        push(visited, 0)
        j = j + 1
    let s = 0
    while s < n
        if visited[s] == 0
            visited[s] = 1
            let queue = [s]
            let qi = 0
            while qi < len(queue)
                let node = queue[qi]
                qi = qi + 1
                let nbrs = adj[node]
                let ni = 0
                while ni < len(nbrs)
                    let w = nbrs[ni]
                    if visited[w] == 0
                        visited[w] = 1
                        parent[w] = node
                        push(queue, w)
                    ni = ni + 1
        s = s + 1
    return parent

print("forge_ett: KAT done")
