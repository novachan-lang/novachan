// KAT test for std/midi/smf
// Known-answer byte vectors for the Standard MIDI File (SMF) chunk API.
// All byte values hand-verified against the SMF specification.
import std/midi/smf

// ── Test helpers ──────────────────────────────────────────────────────────────

// Compare two int lists element-by-element; return 1 if equal, 0 otherwise.
fn _st_list_eq(a, b) -> int
    let la = len(a)
    let lb = len(b)
    if la != lb
        return 0
    let i = 0
    while i < la
        if a[i] != b[i]
            return 0
        i = i + 1
    1

// Format an int list as "[a,b,c]" for error messages.
fn _st_lst_str(lst) -> string
    let s = "["
    let i = 0
    let n = len(lst)
    while i < n
        s = s + str(lst[i])
        if i < n - 1
            s = s + ","
        i = i + 1
    s = s + "]"
    s

// Assert two int lists are equal; print FAIL + exit(1) on mismatch.
fn ckl(label, got, want) -> int
    if _st_list_eq(got, want) == 0
        print("FAIL smf " + label + ": got=" + _st_lst_str(got) + " want=" + _st_lst_str(want))
        exit(1)
    0

// Assert two ints are equal; print FAIL + exit(1) on mismatch.
fn cki(label, got, want) -> int
    if got != want
        print("FAIL smf " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)
    0

// Assert two strings are equal; print FAIL + exit(1) on mismatch.
fn cks(label, got, want) -> int
    if got != want
        print("FAIL smf " + label + ": got=" + got + " want=" + want)
        exit(1)
    0

// Assert a list has a given length; print FAIL + exit(1) on mismatch.
fn ck_len(label, lst, want) -> int
    let got = len(lst)
    if got != want
        print("FAIL smf " + label + " len: got=" + str(got) + " want=" + str(want))
        exit(1)
    0

// ── KAT 1: smf_header(0, 1, 480) exact bytes ──────────────────────────────────
// "MThd" = [77,84,104,100]
// u32(6)  = [0,0,0,6]
// u16(0)  = [0,0]   (format=0 single track)
// u16(1)  = [0,1]   (ntracks=1)
// u16(480)= [1,224] (480=0x01E0; hi=1, lo=224)
// Total 14 bytes.
fn test_header_basic() -> int
    let want = [77, 84, 104, 100, 0, 0, 0, 6, 0, 0, 0, 1, 1, 224]
    let got = smf_header(0, 1, 480)
    ckl("header(0,1,480)", got, want)

// ── KAT 2: smf_header produces exactly 14 bytes ───────────────────────────────
fn test_header_length() -> int
    let h = smf_header(0, 1, 480)
    ck_len("header length", h, 14)

// ── KAT 3: smf_track prefix bytes ─────────────────────────────────────────────
// smf_track([0xFF,0x2F,0x00]) must start with "MTrk" + u32(3).
// "MTrk" = [77,84,114,107]; u32(3) = [0,0,0,3].
// Full result: [77,84,114,107,0,0,0,3,255,47,0]
fn test_track_prefix() -> int
    let events = [255, 47, 0]
    let got = smf_track(events)
    let want = [77, 84, 114, 107, 0, 0, 0, 3, 255, 47, 0]
    ckl("track([0xFF,0x2F,0x00])", got, want)

// ── KAT 4: smf_track total length = 8 header + event bytes ────────────────────
fn test_track_length() -> int
    let events = [255, 47, 0]
    let got = smf_track(events)
    ck_len("track total len", got, 11)

// ── KAT 5: smf_track prefix check (first 8 bytes only) ───────────────────────
// Verify the MTrk tag + u32 length separately.
fn test_track_header_bytes() -> int
    let events = [255, 47, 0]
    let got = smf_track(events)
    let prefix = [77, 84, 114, 107, 0, 0, 0, 3]
    let i = 0
    while i < 8
        if got[i] != prefix[i]
            print("FAIL smf track_header_bytes at byte " + str(i) + ": got=" + str(got[i]) + " want=" + str(prefix[i]))
            exit(1)
        i = i + 1
    0

// ── KAT 6: smf_track preserves event bytes verbatim ──────────────────────────
fn test_track_event_bytes() -> int
    let events = [255, 47, 0]
    let got = smf_track(events)
    // Event bytes start at offset 8
    cki("track[8]", got[8], 255)
    cki("track[9]", got[9], 47)
    cki("track[10]", got[10], 0)

// ── KAT 7: smf_parse_header round-trip format=1, ntracks=2, division=96 ───────
// smf_header(1,2,96):
//   "MThd"=[77,84,104,100], u32(6)=[0,0,0,6], u16(1)=[0,1],
//   u16(2)=[0,2], u16(96)=[0,96].
// Parse must return format==1, ntracks==2, division==96.
fn test_parse_header_roundtrip() -> int
    let hdr = smf_header(1, 2, 96)
    let parsed = smf_parse_header(hdr)
    cki("parse format",   parsed["format"],   1)
    cki("parse ntracks",  parsed["ntracks"],  2)
    cki("parse division", parsed["division"], 96)

// ── KAT 8: smf_parse_header — zero division (format=0) ───────────────────────
fn test_parse_header_zero_div() -> int
    let hdr = smf_header(0, 1, 0)
    let parsed = smf_parse_header(hdr)
    cki("parse zero div format",   parsed["format"],   0)
    cki("parse zero div ntracks",  parsed["ntracks"],  1)
    cki("parse zero div division", parsed["division"], 0)

// ── KAT 9: smf_parse_header — large division (quarter-note ticks=960) ─────────
fn test_parse_header_div960() -> int
    let hdr = smf_header(0, 1, 960)
    let parsed = smf_parse_header(hdr)
    cki("parse div 960", parsed["division"], 960)

// ── KAT 10: smf_parse_header — malformed: too short ──────────────────────────
// A buffer shorter than 14 bytes must return format=-1.
fn test_parse_too_short() -> int
    let short = [77, 84, 104, 100, 0, 0, 0, 6, 0, 0]
    let parsed = smf_parse_header(short)
    cki("parse too-short format", parsed["format"], -1)

// ── KAT 11: smf_parse_header — bad magic ──────────────────────────────────────
// Buffer with wrong magic bytes must return format=-1.
fn test_parse_bad_magic() -> int
    let bad = [0, 0, 0, 0, 0, 0, 0, 6, 0, 0, 0, 1, 0, 96]
    let parsed = smf_parse_header(bad)
    cki("parse bad-magic format", parsed["format"], -1)

// ── KAT 12: smf_chunk_type(smf_header(0,1,480)) == "MThd" ────────────────────
fn test_chunk_type_mthd() -> int
    let hdr = smf_header(0, 1, 480)
    let got = smf_chunk_type(hdr)
    cks("chunk_type MThd", got, "MThd")

// ── KAT 13: smf_chunk_type on a track chunk == "MTrk" ────────────────────────
fn test_chunk_type_mtrk() -> int
    let events = [255, 47, 0]
    let trk = smf_track(events)
    let got = smf_chunk_type(trk)
    cks("chunk_type MTrk", got, "MTrk")

// ── KAT 14: smf_chunk_type on short buffer returns "?" ────────────────────────
fn test_chunk_type_short() -> int
    let short = [77, 84]
    let got = smf_chunk_type(short)
    cks("chunk_type short", got, "?")

// ── KAT 15: smf_track with empty event list ────────────────────────────────────
// Empty event list → length 0 → MTrk header only (8 bytes).
fn test_track_empty_events() -> int
    let events = []
    let got = smf_track(events)
    let want = [77, 84, 114, 107, 0, 0, 0, 0]
    ckl("track empty", got, want)

// ── KAT 16: smf_header format=2 (multi-track async) ──────────────────────────
fn test_header_format2() -> int
    let h = smf_header(2, 8, 240)
    let parsed = smf_parse_header(h)
    cki("format2 format",   parsed["format"],   2)
    cki("format2 ntracks",  parsed["ntracks"],  8)
    cki("format2 division", parsed["division"], 240)

// ── KAT 17: smf_header(0,1,480) byte-by-byte spot check ──────────────────────
// Redundant with KAT 1 but verifies individual byte positions.
fn test_header_spot() -> int
    let h = smf_header(0, 1, 480)
    // tag
    cki("h[0]",  h[0],  77)
    cki("h[1]",  h[1],  84)
    cki("h[2]",  h[2],  104)
    cki("h[3]",  h[3],  100)
    // length=6
    cki("h[4]",  h[4],  0)
    cki("h[5]",  h[5],  0)
    cki("h[6]",  h[6],  0)
    cki("h[7]",  h[7],  6)
    // format=0
    cki("h[8]",  h[8],  0)
    cki("h[9]",  h[9],  0)
    // ntracks=1
    cki("h[10]", h[10], 0)
    cki("h[11]", h[11], 1)
    // division=480=0x01E0
    cki("h[12]", h[12], 1)
    cki("h[13]", h[13], 224)

// ── Entry point ───────────────────────────────────────────────────────────────
fn main() -> int
    test_header_basic()
    test_header_length()
    test_track_prefix()
    test_track_length()
    test_track_header_bytes()
    test_track_event_bytes()
    test_parse_header_roundtrip()
    test_parse_header_zero_div()
    test_parse_header_div960()
    test_parse_too_short()
    test_parse_bad_magic()
    test_chunk_type_mthd()
    test_chunk_type_mtrk()
    test_chunk_type_short()
    test_track_empty_events()
    test_header_format2()
    test_header_spot()
    print("PASS _smf_test")
    0
