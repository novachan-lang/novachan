import std/itertools/it_product

// ── helpers ────────────────────────────────────────────────────────────────

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cknest_outer(label: string, got, want_len: int)
    let gl = len(got)
    if gl != want_len
        print("FAIL " + label + " outer_len: got=" + str(gl) + " want=" + str(want_len))
        exit(1)

fn cknest_inner_len(label: string, got, i: int, want: int)
    let inner = got[i]
    let il = len(inner)
    if il != want
        print("FAIL " + label + "[" + str(i) + "] inner_len: got=" + str(il) + " want=" + str(want))
        exit(1)

fn cknest_elem(label: string, got, i: int, j: int, want: int)
    let inner = got[i]
    let v = inner[j]
    if v != want
        print("FAIL " + label + "[" + str(i) + "][" + str(j) + "]: got=" + str(v) + " want=" + str(want))
        exit(1)

fn main()
    // ── itpr_cartesian ───────────────────────────────────────────────────────
    // itpr_cartesian([1,2],[3,4]) = [[1,3],[1,4],[2,3],[2,4]]
    let c2 = itpr_cartesian([1, 2], [3, 4])
    cknest_outer("cart2", c2, 4)
    cknest_inner_len("cart2_0", c2, 0, 2)
    cknest_elem("cart2_0", c2, 0, 0, 1)
    cknest_elem("cart2_0", c2, 0, 1, 3)
    cknest_inner_len("cart2_1", c2, 1, 2)
    cknest_elem("cart2_1", c2, 1, 0, 1)
    cknest_elem("cart2_1", c2, 1, 1, 4)
    cknest_inner_len("cart2_2", c2, 2, 2)
    cknest_elem("cart2_2", c2, 2, 0, 2)
    cknest_elem("cart2_2", c2, 2, 1, 3)
    cknest_inner_len("cart2_3", c2, 3, 2)
    cknest_elem("cart2_3", c2, 3, 0, 2)
    cknest_elem("cart2_3", c2, 3, 1, 4)

    // empty b -> []
    let c_empty_b = itpr_cartesian([1, 2], [])
    cki("cart_empty_b", len(c_empty_b), 0)

    // empty a -> []
    let c_empty_a = itpr_cartesian([], [3, 4])
    cki("cart_empty_a", len(c_empty_a), 0)

    // single pair
    let c_single = itpr_cartesian([5], [7])
    cknest_outer("cart_single", c_single, 1)
    cknest_elem("cart_single_0", c_single, 0, 0, 5)
    cknest_elem("cart_single_0", c_single, 0, 1, 7)

    // ── itpr_cartesian3 ──────────────────────────────────────────────────────
    // itpr_cartesian3([1],[2],[3,4]) = [[1,2,3],[1,2,4]]
    let c3 = itpr_cartesian3([1], [2], [3, 4])
    cknest_outer("cart3", c3, 2)
    cknest_inner_len("cart3_0", c3, 0, 3)
    cknest_elem("cart3_0", c3, 0, 0, 1)
    cknest_elem("cart3_0", c3, 0, 1, 2)
    cknest_elem("cart3_0", c3, 0, 2, 3)
    cknest_inner_len("cart3_1", c3, 1, 3)
    cknest_elem("cart3_1", c3, 1, 0, 1)
    cknest_elem("cart3_1", c3, 1, 1, 2)
    cknest_elem("cart3_1", c3, 1, 2, 4)

    // 2x2x2 = 8
    let c3_8 = itpr_cartesian3([1, 2], [3, 4], [5, 6])
    cknest_outer("cart3_2x2x2", c3_8, 8)
    // row 0: [1,3,5], row 7: [2,4,6]
    cknest_elem("cart3_2x2x2_0", c3_8, 0, 0, 1)
    cknest_elem("cart3_2x2x2_0", c3_8, 0, 1, 3)
    cknest_elem("cart3_2x2x2_0", c3_8, 0, 2, 5)
    cknest_elem("cart3_2x2x2_7", c3_8, 7, 0, 2)
    cknest_elem("cart3_2x2x2_7", c3_8, 7, 1, 4)
    cknest_elem("cart3_2x2x2_7", c3_8, 7, 2, 6)

    // empty any dimension
    cki("cart3_empty_c", len(itpr_cartesian3([1], [2], [])), 0)

    // ── itpr_count ───────────────────────────────────────────────────────────
    cki("count_3x2", itpr_count([1, 2, 3], [4, 5]), 6)
    cki("count_0x5", itpr_count([], [1, 2, 3, 4, 5]), 0)
    cki("count_3x0", itpr_count([1, 2, 3], []), 0)
    cki("count_1x1", itpr_count([7], [8]), 1)

    // ── itpr_pairs_upper ─────────────────────────────────────────────────────
    // itpr_pairs_upper([1,2,3]) = [[1,2],[1,3],[2,3]]
    let pu = itpr_pairs_upper([1, 2, 3])
    cknest_outer("pairs_upper_3", pu, 3)
    cknest_elem("pu_0", pu, 0, 0, 1)
    cknest_elem("pu_0", pu, 0, 1, 2)
    cknest_elem("pu_1", pu, 1, 0, 1)
    cknest_elem("pu_1", pu, 1, 1, 3)
    cknest_elem("pu_2", pu, 2, 0, 2)
    cknest_elem("pu_2", pu, 2, 1, 3)

    // n=4: C(4,2)=6 pairs
    let pu4 = itpr_pairs_upper([1, 2, 3, 4])
    cknest_outer("pairs_upper_4", pu4, 6)
    // first pair [1,2], last pair [3,4]
    cknest_elem("pu4_first", pu4, 0, 0, 1)
    cknest_elem("pu4_first", pu4, 0, 1, 2)
    cknest_elem("pu4_last", pu4, 5, 0, 3)
    cknest_elem("pu4_last", pu4, 5, 1, 4)

    // empty -> []
    cki("pairs_upper_empty", len(itpr_pairs_upper([])), 0)

    // single element -> []
    cki("pairs_upper_single", len(itpr_pairs_upper([42])), 0)

    // round-trip count check: pairs_upper([1..4]) == C(4,2) = 6
    cki("pairs_upper_count_4", len(itpr_pairs_upper([1, 2, 3, 4])), 6)

    // pairs_upper([1,2]) = [[1,2]]
    let pu2 = itpr_pairs_upper([1, 2])
    cknest_outer("pairs_upper_2", pu2, 1)
    cknest_elem("pu2_0", pu2, 0, 0, 1)
    cknest_elem("pu2_0", pu2, 0, 1, 2)

    print("PASS _it_product_test")
