import std/numeral/gray_code

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL gray_code " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL gray_code " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL gray_code " + label + " len: got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL gray_code " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // gc_to_gray KAT
    cki("to_gray(0)", gc_to_gray(0), 0)
    cki("to_gray(1)", gc_to_gray(1), 1)
    cki("to_gray(2)", gc_to_gray(2), 3)
    cki("to_gray(3)", gc_to_gray(3), 2)
    cki("to_gray(4)", gc_to_gray(4), 6)
    cki("to_gray(7)", gc_to_gray(7), 4)

    // gc_from_gray KAT
    cki("from_gray(0)", gc_from_gray(0), 0)
    cki("from_gray(2)", gc_from_gray(2), 3)
    cki("from_gray(6)", gc_from_gray(6), 4)

    // Round-trip: gc_from_gray(gc_to_gray(k)) == k for k=0..31
    let k = 0
    while k <= 31
        cki("roundtrip(" + str(k) + ")", gc_from_gray(gc_to_gray(k)), k)
        k = k + 1

    // gc_to_gray_bits KAT
    cks("bits(4,4)", gc_to_gray_bits(4, 4), "0110")
    cks("bits(0,4)", gc_to_gray_bits(0, 4), "0000")
    cks("bits(1,4)", gc_to_gray_bits(1, 4), "0001")
    cks("bits(3,4)", gc_to_gray_bits(3, 4), "0010")
    cks("bits(7,4)", gc_to_gray_bits(7, 4), "0100")

    // gc_gray_sequence KAT: bits=2 -> [0,1,3,2]
    let seq2 = gc_gray_sequence(2)
    let want2 = []
    want2.push(0)
    want2.push(1)
    want2.push(3)
    want2.push(2)
    ckl("sequence(2)", seq2, want2)

    // gc_gray_sequence(3): length 8, consecutive entries differ by exactly 1 bit
    let seq3 = gc_gray_sequence(3)
    cki("sequence(3) len", len(seq3), 8)
    let i = 0
    while i < 7
        let a = seq3[i]
        let b = seq3[i + 1]
        // XOR should be a power of 2 (exactly one bit set)
        let diff = a ^ b
        // diff & (diff-1) == 0 iff diff is a power of 2 (and diff != 0)
        let is_pow2 = 0
        if diff > 0
            if (diff & (diff - 1)) == 0
                is_pow2 = 1
        if is_pow2 != 1
            print("FAIL gray_code sequence3 adjacent[" + str(i) + "]: diff=" + str(diff))
            exit(1)
        i = i + 1

    // Large round-trip
    cki("roundtrip(1000)", gc_from_gray(gc_to_gray(1000)), 1000)
    cki("roundtrip(65535)", gc_from_gray(gc_to_gray(65535)), 65535)

    print("PASS _gray_code_test")
