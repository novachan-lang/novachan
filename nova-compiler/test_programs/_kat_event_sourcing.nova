import forge_event_sourcing

fn main()
    let es = es_new("orders")
    assert(es_stream_name(es) == "orders", "stream name")
    assert(es_event_count(es) == 0, "0 events")
    assert(es_version(es) == 0, "version 0")

    es = es_append(es, "created", "order-1")
    es = es_append(es, "paid", "amount-100")
    es = es_append(es, "shipped", "tracking-xyz")
    assert(es_event_count(es) == 3, "3 events")
    assert(es_version(es) == 3, "version 3")

    assert(es_event_type(es, 0) == "created", "event 0 type")
    assert(es_event_data(es, 0) == "order-1", "event 0 data")
    assert(es_event_type(es, 2) == "shipped", "event 2 type")
    assert(es_event_data(es, 2) == "tracking-xyz", "event 2 data")

    assert(es_event_type(es, -1) == "", "neg index empty")
    assert(es_event_type(es, 99) == "", "out of range empty")

    let since = es_events_since(es, 1)
    assert(since["count"] == 2, "2 events since v1")
    assert(since["0_type"] == "paid", "since v1 first = paid")

    let since0 = es_events_since(es, 0)
    assert(since0["count"] == 3, "3 events since v0")

    print("EVENT-SOURCING KAT PASS")
