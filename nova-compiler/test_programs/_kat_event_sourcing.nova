import forge_event_sourcing

fn main()
    let e = es_new()
    e = es_append(e, "user-1", "created", "alice")
    e = es_append(e, "user-1", "updated", "bob")
    e = es_append(e, "user-2", "created", "carol")
    assert(es_event_count(e) == 3, "3 events")

    let r1 = es_get_event(e, 0)
    assert(is_ok(r1), "get 0 ok")
    assert(unwrap(r1) == "created:alice", "event 0")

    assert(es_stream_count(e, "user-1") == 2, "user-1 has 2")
    assert(es_stream_count(e, "user-2") == 1, "user-2 has 1")

    e = es_save_snapshot(e, "user-1", "bob")
    let snap = es_load_snapshot(e, "user-1")
    assert(is_ok(snap), "snapshot ok")
    assert(unwrap(snap) == "bob", "snapshot=bob")

    let bad = es_load_snapshot(e, "nope")
    assert(is_err(bad), "no snapshot")

    let bad2 = es_get_event(e, 99)
    assert(is_err(bad2), "out of range")

    print("EVENT-SOURCING KAT PASS")
