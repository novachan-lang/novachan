import std/data/geojson_parse

fn q() -> string
    chr(34)

fn ob() -> string
    chr(123)

fn cb() -> string
    chr(125)

fn main() -> int
    // Pure-ASCII unknown type with nested coordinates -- does the
    // best-effort flat-array fallback mishandle it too? (checking whether
    // this is pre-existing behavior, unrelated to the UTF-8/perf fix.)
    let j = ob() + q() + "type" + q() + ":" + q() + "MultiPoint" + q() + "," + q() + "coordinates" + q() + ":[[-1.5,-2.5],[-3.5,-4.5]]" + cb()
    let r = geojson_parse(j)
    print("type=" + r["type"])
    print("coords_len=" + str(len(r["coordinates"])))
    let c = r["coordinates"]
    let i = 0
    while i < len(c)
        print("elem[" + str(i) + "]=" + str(c[i]))
        i = i + 1
    0
