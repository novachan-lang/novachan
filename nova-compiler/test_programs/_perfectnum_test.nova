// _perfectnum_test.nova — KAT for std/math/perfectnum
// Hand-computed expected values verified against OEIS A000396 (perfect numbers).
//
// Hand-trace pn_divisor_sum(6):
//   total=1; i=2: 6%2==0 → +2, pair=3 (!=6,!=2) → +3; i=3: 3*3=9>6 stop.
//   total = 1+2+3 = 6. ✓
//
// Hand-trace pn_divisor_sum(28):
//   total=1; i=2: pair=14 → +2+14; i=3: 28%3!=0; i=4: pair=7 → +4+7;
//   i=5: 25<28, 28%5!=0; i=6: 36>28 stop. total=1+2+14+4+7=28. ✓
//
// Hand-trace pn_divisor_sum(12):
//   total=1; i=2: pair=6 → +2+6; i=3: pair=4 → +3+4; i=4: 16>12 stop.
//   total=1+2+6+3+4=16. ✓
//
// Hand-trace pn_divisor_sum(8):
//   total=1; i=2: pair=4 → +2+4; i=3: 9>8 stop. total=1+2+4=7. ✓

import std/math/perfectnum

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got " + got + " want " + want)
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got " + gs + " want " + ws)
        exit(1)

fn main()
    // --- pn_divisor_sum ---
    // Published: OEIS A001065 proper divisor sum sequence
    cki("divisor_sum(1)", pn_divisor_sum(1), 0)       // n=1: no proper divisors
    cki("divisor_sum(6)", pn_divisor_sum(6), 6)       // 1+2+3=6
    cki("divisor_sum(12)", pn_divisor_sum(12), 16)    // 1+2+3+4+6=16
    cki("divisor_sum(28)", pn_divisor_sum(28), 28)    // 1+2+4+7+14=28
    cki("divisor_sum(8)", pn_divisor_sum(8), 7)       // 1+2+4=7
    cki("divisor_sum(496)", pn_divisor_sum(496), 496) // 3rd perfect: OEIS A000396
    cki("divisor_sum(4)", pn_divisor_sum(4), 3)       // 1+3=... wait: 1+2=3 (4%2==0 pair=2; 4%3? no; sqrt=2)

    // --- pn_aliquot (must equal pn_divisor_sum) ---
    cki("aliquot(6)", pn_aliquot(6), 6)
    cki("aliquot(28)", pn_aliquot(28), 28)
    cki("aliquot(8)", pn_aliquot(8), 7)

    // --- pn_is_perfect ---
    ckb("is_perfect(6)", pn_is_perfect(6), true)
    ckb("is_perfect(28)", pn_is_perfect(28), true)
    ckb("is_perfect(12)", pn_is_perfect(12), false)
    ckb("is_perfect(1)", pn_is_perfect(1), false)
    ckb("is_perfect(496)", pn_is_perfect(496), true)  // 3rd perfect number (OEIS A000396)

    // --- pn_is_abundant ---
    ckb("is_abundant(12)", pn_is_abundant(12), true)   // divisor_sum=16 > 12
    ckb("is_abundant(18)", pn_is_abundant(18), true)   // 1+2+3+6+9=21 > 18
    ckb("is_abundant(6)", pn_is_abundant(6), false)    // perfect, not abundant
    ckb("is_abundant(8)", pn_is_abundant(8), false)    // deficient

    // --- pn_is_deficient ---
    ckb("is_deficient(8)", pn_is_deficient(8), true)   // divisor_sum=7 < 8
    ckb("is_deficient(1)", pn_is_deficient(1), true)   // divisor_sum=0 < 1
    ckb("is_deficient(4)", pn_is_deficient(4), true)   // 1+2=3 < 4
    ckb("is_deficient(6)", pn_is_deficient(6), false)  // perfect
    ckb("is_deficient(12)", pn_is_deficient(12), false)// abundant

    // --- pn_perfects_upto ---
    let p0 = pn_perfects_upto(5)
    cki("perfects_upto(5) len", len(p0), 0)

    let p6 = pn_perfects_upto(6)
    cki("perfects_upto(6) len", len(p6), 1)
    cki("perfects_upto(6)[0]", p6[0], 6)

    let p30 = pn_perfects_upto(30)
    cki("perfects_upto(30) len", len(p30), 2)
    cki("perfects_upto(30)[0]", p30[0], 6)
    cki("perfects_upto(30)[1]", p30[1], 28)

    let p500 = pn_perfects_upto(500)
    cki("perfects_upto(500) len", len(p500), 3)
    cki("perfects_upto(500)[2]", p500[2], 496)

    print("_perfectnum_test passed")
