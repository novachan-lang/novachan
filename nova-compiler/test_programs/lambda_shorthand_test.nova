fn main()
    let items = [1, 2, 3, 4, 5]

    let doubled = map(items, |x| x * 2)
    assert_eq(doubled, [2, 4, 6, 8, 10])

    let big = filter(items, |x| x > 3)
    assert_eq(big, [4, 5])

    let total = reduce(items, |a, b| a + b, 0)
    assert_eq(total, 15)

    let f = |x| x + 100
    assert_eq(f(5), 105)

    let add = |a, b| a + b
    assert_eq(add(10, 20), 30)

    let strs = map(items, |x| str(x))
    assert_eq(strs, ["1", "2", "3", "4", "5"])

    let evens = filter(items, |x| x % 2 == 0)
    assert_eq(evens, [2, 4])

    let chain = map(filter(items, |x| x > 2), |x| x * 10)
    assert_eq(chain, [30, 40, 50])

    let zero_p = || 42
    assert_eq(zero_p(), 42)

    let nums = [10, 20, 30]
    let with_idx = []
    let i = 0
    for n in nums
        push(with_idx, (|v| v + 1)(n))
        i = i + 1
    assert_eq(with_idx, [11, 21, 31])

    print("ALL LAMBDA SHORTHAND TESTS PASSED")
