// Subprocess pipes: proc_open / proc_read_stdout / proc_write_stdin / proc_close_stdin / proc_wait.
//
// PORTABILITY: this test hardcoded `cmd /c echo` and `cmd /c sort`. `cmd` exists only on Windows,
// so on Linux and macOS proc_open spawned nothing and the test failed -- reporting a HARDCODED
// SHELL as a NOVA defect. The feature under test is the PIPE PLUMBING, not which shell runs, so
// the command is selected per-OS and the assertions stay identical on every platform.
//
// `sort` is used for the stdin half on all three: it is a POSIX standard utility AND a Windows
// built-in, and it is the property that matters here -- it cannot emit anything until stdin is
// CLOSED, so it proves proc_close_stdin actually reaches the child rather than the test merely
// racing a program that would have printed anyway.

fn _read_all(handle)
  let output = ""
  let chunk = proc_read_stdout(handle)
  while len(chunk) > 0
    output = output + chunk
    chunk = proc_read_stdout(handle)
  output

fn _echo_cmd() -> string
  if os_name() == "windows"
    return "cmd /c echo hello from pipe"
  return "/bin/sh -c \"echo hello from pipe\""

fn _sort_cmd() -> string
  if os_name() == "windows"
    return "cmd /c sort"
  return "/bin/sh -c sort"

fn _nl() -> string
  // CRLF is what cmd's `sort` expects; POSIX `sort` treats a bare CR as data and would fold it
  // into the compared key, so the newline has to follow the platform too.
  if os_name() == "windows"
    return "\r\n"
  return "\n"

fn main()
  let p = proc_open(_echo_cmd())
  assert(p != 0, "proc_open succeeded")
  let output = _read_all(p)
  let code = proc_wait(p)
  assert(code == 0, "exit code 0")
  assert(contains(output, "hello"), "captured: " + output)

  let nl = _nl()
  let p2 = proc_open(_sort_cmd())
  assert(p2 != 0, "proc_open (sort) succeeded")
  let _w1 = proc_write_stdin(p2, "banana" + nl)
  let _w2 = proc_write_stdin(p2, "apple" + nl)
  let _w3 = proc_write_stdin(p2, "cherry" + nl)
  proc_close_stdin(p2)
  let sorted_out = _read_all(p2)
  let code2 = proc_wait(p2)
  assert(code2 == 0, "sort exit 0")
  assert(contains(sorted_out, "apple"), "sorted: " + sorted_out)

  print("proc_pipe_test: all passed on " + os_name())
