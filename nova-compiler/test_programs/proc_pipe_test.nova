fn _read_all(handle)
  let output = ""
  let chunk = proc_read_stdout(handle)
  while len(chunk) > 0
    output = output + chunk
    chunk = proc_read_stdout(handle)
  output

fn main()
  let p = proc_open("cmd /c echo hello from pipe")
  assert(p != 0, "proc_open succeeded")
  let output = _read_all(p)
  let code = proc_wait(p)
  assert(code == 0, "exit code 0")
  assert(contains(output, "hello"), "captured: " + output)

  let p2 = proc_open("cmd /c sort")
  let _w1 = proc_write_stdin(p2, "banana\r\n")
  let _w2 = proc_write_stdin(p2, "apple\r\n")
  let _w3 = proc_write_stdin(p2, "cherry\r\n")
  proc_close_stdin(p2)
  let sorted_out = _read_all(p2)
  let code2 = proc_wait(p2)
  assert(code2 == 0, "sort exit 0")
  assert(contains(sorted_out, "apple"), "sorted: " + sorted_out)

  print("proc_pipe_test: all passed")
