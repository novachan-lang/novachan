// showcase_date -- a calendar/date calculator in pure NOVA: leap years, days-in-month, day-of-year,
// days-between-dates, and day-of-week via Zeller's congruence. A THIRTEENTH angle: integer date
// arithmetic (a new domain), verified against known calendar facts.

fn is_leap(y: int) -> int
    if y % 400 == 0
        return 1
    if y % 100 == 0
        return 0
    if y % 4 == 0
        return 1
    return 0

fn days_in_month(y: int, m: int) -> int
    if m == 2
        if is_leap(y) == 1
            return 29
        return 28
    if m == 4 or m == 6 or m == 9 or m == 11
        return 30
    return 31

fn day_of_year(y: int, m: int, d: int) -> int
    let total = d
    let mm = 1
    while mm < m
        total = total + days_in_month(y, mm)
        mm = mm + 1
    return total

// days since 0001-01-01 (proleptic Gregorian), for date differences.
fn days_from_epoch(y: int, m: int, d: int) -> int
    let yv = y - 1
    let leaps = yv / 4 - yv / 100 + yv / 400
    return yv * 365 + leaps + day_of_year(y, m, d) - 1

fn days_between(y1: int, m1: int, d1: int, y2: int, m2: int, d2: int) -> int
    return days_from_epoch(y2, m2, d2) - days_from_epoch(y1, m1, d1)

// Zeller's congruence: 0=Saturday, 1=Sunday, 2=Monday, ... 6=Friday.
fn day_of_week(y: int, m: int, d: int) -> int
    let mm = m
    let yy = y
    if mm < 3
        mm = mm + 12
        yy = yy - 1
    let k = yy % 100
    let j = yy / 100
    let h = (d + (13 * (mm + 1)) / 5 + k + k / 4 + j / 4 + 5 * j) % 7
    return h

fn dow_name(h: int) -> string
    let names = ["Saturday", "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday"]
    return names[h]

fn main()
    // leap years
    assert(is_leap(2000) == 1, "2000 is leap (div 400)")
    assert(is_leap(1900) == 0, "1900 is not leap (div 100 not 400)")
    assert(is_leap(2024) == 1, "2024 is leap (div 4)")
    assert(is_leap(2023) == 0, "2023 is not leap")

    // days in month
    assert(days_in_month(2024, 2) == 29, "Feb 2024 has 29 days")
    assert(days_in_month(2023, 2) == 28, "Feb 2023 has 28 days")
    assert(days_in_month(2024, 4) == 30, "Apr has 30 days")
    assert(days_in_month(2024, 12) == 31, "Dec has 31 days")

    // day of year
    assert(day_of_year(2024, 1, 1) == 1, "Jan 1 is day 1")
    assert(day_of_year(2024, 3, 1) == 61, "Mar 1 2024 is day 61 (leap)")
    assert(day_of_year(2023, 3, 1) == 60, "Mar 1 2023 is day 60")
    assert(day_of_year(2024, 12, 31) == 366, "Dec 31 2024 is day 366 (leap)")

    // days between
    assert(days_between(2000, 1, 1, 2000, 12, 31) == 365, "2000-01-01 to 2000-12-31 = 365")
    assert(days_between(2024, 1, 1, 2025, 1, 1) == 366, "2024 (leap) has 366 days")
    assert(days_between(2023, 1, 1, 2024, 1, 1) == 365, "2023 has 365 days")

    // day of week (known facts)
    assert(day_of_week(2000, 1, 1) == 0, "2000-01-01 was a Saturday")
    assert(dow_name(day_of_week(2000, 1, 1)) == "Saturday", "Saturday name")
    assert(dow_name(day_of_week(2024, 2, 29)) == "Thursday", "2024-02-29 was a Thursday")
    assert(dow_name(day_of_week(1969, 7, 20)) == "Sunday", "moon landing 1969-07-20 was a Sunday")

    print("2024-02-29 was a " + dow_name(day_of_week(2024, 2, 29)))
    print("days from 2000-01-01 to 2024-02-29 = " + str(days_between(2000, 1, 1, 2024, 2, 29)))
    print("showcase_date_test passed -- leap years + day-of-year + date diff + Zeller day-of-week, pure NOVA")
