import std/core/collect

fn main() -> int
    let fails = 0

    // chunk — last chunk short
    let ch = chunk([1, 2, 3, 4, 5, 6, 7], 3)
    if ch != [[1, 2, 3], [4, 5, 6], [7]]
        print("FAIL chunk=" + str(ch))
        fails = fails + 1

    // windows — sliding, width 2
    let win = windows([1, 2, 3, 4], 2)
    if win != [[1, 2], [2, 3], [3, 4]]
        print("FAIL windows=" + str(win))
        fails = fails + 1

    // partition — even vs odd
    let part = partition([1, 2, 3, 4, 5, 6], fn(x) x % 2 == 0)
    if part != [[2, 4, 6], [1, 3, 5]]
        print("FAIL partition=" + str(part))
        fails = fails + 1

    // flatten — one level
    let fl = flatten([[1, 2], [3], [4, 5, 6]])
    if fl != [1, 2, 3, 4, 5, 6]
        print("FAIL flatten=" + str(fl))
        fails = fails + 1

    // unique — order-preserving dedup
    let uq = unique([3, 1, 3, 2, 1, 4, 2])
    if uq != [3, 1, 2, 4]
        print("FAIL unique=" + str(uq))
        fails = fails + 1

    // frequencies — str-keyed counts
    let fq = frequencies([1, 1, 2, 3, 3, 3])
    if get(fq, "1", 0) != 2 or get(fq, "2", 0) != 1 or get(fq, "3", 0) != 3 or get(fq, "9", 0) != 0
        print("FAIL frequencies=" + str(fq))
        fails = fails + 1

    // scan — running sum (seeded prefix sums), length len+1
    let sc = scan([1, 2, 3, 4], fn(a, x) a + x, 0)
    if sc != [0, 1, 3, 6, 10]
        print("FAIL scan=" + str(sc))
        fails = fails + 1

    // zip_with — elementwise add, length = min
    let zw = zip_with([1, 2, 3], [10, 20, 30, 99], fn(a, b) a + b)
    if zw != [11, 22, 33]
        print("FAIL zip_with=" + str(zw))
        fails = fails + 1

    // interleave — alternate then append tail
    let iv = interleave([1, 2, 3], [10, 20, 30, 40, 50])
    if iv != [1, 10, 2, 20, 3, 30, 40, 50]
        print("FAIL interleave=" + str(iv))
        fails = fails + 1

    if fails == 0
        print("COLLECT KAT PASS")
    else
        print("COLLECT KAT FAILED (" + str(fails) + ")")
    return 0
