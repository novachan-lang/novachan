// functional: GraphQL parse+execute, list mapping, trivial resolver, variables, depth limit
import forge_graphql

fn _r_todos(parent, args)
    let t1 = {}
    t1["title"] = "a"
    let t2 = {}
    t2["title"] = "b"
    [t1, t2]

fn _r_user(parent, args)
    let u = {}
    u["name"] = "u" + str(args["id"])
    u

fn _lb() -> string
    chr(123)

fn _rb() -> string
    chr(125)

fn main()
    let r = {}
    r["todos"] = _r_todos
    r["user"] = _r_user
    let q = _lb() + " todos " + _lb() + " title " + _rb() + " " + _rb()
    let res = gql_execute(q, r, 0)
    let todos = res["data"]["todos"]
    if len(todos) != 2
        print("FAIL todos len")
        exit(1)
    if todos[0]["title"] != "a"
        print("FAIL todos[0].title = " + str(todos[0]["title"]))
        exit(1)
    if todos[1]["title"] != "b"
        print("FAIL todos[1].title")
        exit(1)
    let qv = _lb() + " user(id: $id) " + _lb() + " name " + _rb() + " " + _rb()
    let vars = {}
    vars["id"] = 5
    let rv = gql_execute_vars(qv, r, 0, vars)
    if rv["data"]["user"]["name"] != "u5"
        print("FAIL var subst = " + str(rv["data"]["user"]["name"]))
        exit(1)
    let deep = _lb() + " a " + _lb() + " b " + _lb() + " c " + _rb() + _rb() + _rb()
    let lim = gql_execute_limited(deep, r, 0, 2, 100)
    if contains(lim, "errors") != true
        print("FAIL depth limit not enforced")
        exit(1)
    print("PASS forge_graphql")
