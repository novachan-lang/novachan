import forge_cloudevents

fn tf(b: bool) -> string
    if b
        return "T"
    "F"

fn main()
    let ce = cloudevent_full("id2", "/svc", "t.x", "orders/42", "2026-07-03T10:00:00Z", "application/json", "payload")
    let h = cloudevent_to_headers(ce)
    print("h_id=" + tf(h["ce-id"] == "id2"))
    print("h_src=" + tf(h["ce-source"] == "/svc"))
    print("h_type=" + tf(h["ce-type"] == "t.x"))
    print("h_spec=" + tf(h["ce-specversion"] == "1.0"))
    print("h_subj=" + tf(h["ce-subject"] == "orders/42"))
    print("h_time=" + tf(h["ce-time"] == "2026-07-03T10:00:00Z"))
    print("h_ct=" + tf(h["content-type"] == "application/json"))
    // data must NOT be a header (it's the body)
    print("no_data_hdr=" + tf(contains(h, "ce-data") == false))
    // round-trip: headers + body -> event
    let e2 = cloudevent_from_headers(h, "payload")
    print("rt_valid=" + tf(cloudevent_valid(e2)))
    print("rt_id=" + tf(e2["id"] == "id2"))
    print("rt_data=" + tf(e2["data"] == "payload"))
    print("rt_ct=" + tf(e2["datacontenttype"] == "application/json"))
