import std/game/glicko1

// approx: check two floats are within tolerance
fn approx(a: float, b: float, tol: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    d < tol

fn assert_approx(label: string, a: float, b: float, tol: float)
    let ok = approx(a, b, tol)
    if not ok
        print("FAIL glicko1 " + label + ": got " + str(a) + " want ~" + str(b))
        exit(1)

fn assert_true(label: string, cond: bool)
    if not cond
        print("FAIL glicko1 " + label)
        exit(1)

fn main()
    // Standard Glicko-1 scenario: equal-rated players (1500.0 vs 1500.0)
    // After a WIN, rating should increase and RD should decrease.
    let r1 = 1500.0
    let rd1 = 200.0
    let r2 = 1500.0
    let rd2 = 200.0

    let res_win = glicko_update(r1, rd1, r2, rd2, 1.0)
    let new_r_win = res_win[0] * 1.0
    let new_rd_win = res_win[1] * 1.0

    // Win vs equal-rated should increase rating
    assert_true("win_increases_rating", new_r_win > r1)

    // RD decreases after a game (more certainty)
    assert_true("win_rd_decreases", new_rd_win < rd1)

    // RD must stay positive (> 0)
    assert_true("win_rd_positive", new_rd_win > 0.0)

    // After a LOSS vs equal-rated player, rating should decrease
    let res_loss = glicko_update(r1, rd1, r2, rd2, 0.0)
    let new_r_loss = res_loss[0] * 1.0
    let new_rd_loss = res_loss[1] * 1.0
    assert_true("loss_decreases_rating", new_r_loss < r1)

    // RD decreases after a loss too
    assert_true("loss_rd_decreases", new_rd_loss < rd1)

    // After a DRAW vs equal-rated player, rating should stay near 1500
    let res_draw = glicko_update(r1, rd1, r2, rd2, 0.5)
    let new_r_draw = res_draw[0] * 1.0
    assert_approx("draw_stable_rating", new_r_draw, 1500.0, 5.0)

    // Determinism check: same inputs give same output
    let res_a = glicko_update(1600.0, 150.0, 1400.0, 180.0, 1.0)
    let res_b = glicko_update(1600.0, 150.0, 1400.0, 180.0, 1.0)
    let ra0 = res_a[0] * 1.0
    let rb0 = res_b[0] * 1.0
    let ra1 = res_a[1] * 1.0
    let rb1 = res_b[1] * 1.0
    assert_approx("deterministic_rating", ra0, rb0, 0.0001)
    assert_approx("deterministic_rd", ra1, rb1, 0.0001)

    // Underdog wins: lower-rated player beats higher-rated, should gain more
    let res_upset = glicko_update(1200.0, 200.0, 1600.0, 200.0, 1.0)
    let new_r_upset = res_upset[0] * 1.0
    assert_true("upset_big_rating_gain", new_r_upset > 1200.0 + 50.0)

    // Favorite wins: expected outcome, small gain
    let res_fav = glicko_update(1600.0, 200.0, 1200.0, 200.0, 1.0)
    let new_r_fav = res_fav[0] * 1.0
    let upset_gain = new_r_upset - 1200.0
    let fav_gain = new_r_fav - 1600.0
    assert_true("upset_gains_more_than_fav", upset_gain > fav_gain)

    // High certainty player (small RD): rating changes less
    let res_hi_cert = glicko_update(1500.0, 50.0, 1500.0, 200.0, 1.0)
    let new_r_hi = res_hi_cert[0] * 1.0
    let new_rd_hi = res_hi_cert[1] * 1.0
    let res_lo_cert = glicko_update(1500.0, 300.0, 1500.0, 200.0, 1.0)
    let new_r_lo = res_lo_cert[0] * 1.0
    let hi_gain = new_r_hi - 1500.0
    let lo_gain = new_r_lo - 1500.0
    assert_true("uncertain_player_changes_more", lo_gain > hi_gain)
    assert_true("hi_cert_rd_positive", new_rd_hi > 0.0)

    print("PASS _glicko1_test")
