import std/semver/semver_tilde

fn cks(label, got, want)
    if got != want
        print("FAIL _semver_tilde_test " + label + ": got=" + got + " want=" + want)
        exit(1)

fn ckb(label, got, want)
    if got != want
        print("FAIL _semver_tilde_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // --- svt_lower ---
    cks("lower_1.2.3",   svt_lower("~1.2.3"),  "1.2.3")
    cks("lower_1.2",     svt_lower("~1.2"),     "1.2.0")
    cks("lower_1",       svt_lower("~1"),       "1.0.0")
    cks("lower_0.0.0",   svt_lower("~0.0.0"),   "0.0.0")
    cks("lower_no_tilde",svt_lower("1.2.3"),    "1.2.3")

    // --- svt_upper ---
    cks("upper_1.2.3",   svt_upper("~1.2.3"),  "1.3.0")
    cks("upper_1.2",     svt_upper("~1.2"),     "1.3.0")
    cks("upper_1",       svt_upper("~1"),       "2.0.0")
    cks("upper_0.2.3",   svt_upper("~0.2.3"),  "0.3.0")
    cks("upper_0.0.3",   svt_upper("~0.0.3"),  "0.1.0")
    cks("upper_2",       svt_upper("~2"),       "3.0.0")

    // --- svt_satisfies: ~1.2.3 -> [1.2.3, 1.3.0) ---
    ckb("sat_1.2.5_in",  svt_satisfies("1.2.5", "~1.2.3"), true)
    ckb("sat_1.3.0_out", svt_satisfies("1.3.0", "~1.2.3"), false)
    ckb("sat_1.2.3_eq",  svt_satisfies("1.2.3", "~1.2.3"), true)
    ckb("sat_1.2.2_lo",  svt_satisfies("1.2.2", "~1.2.3"), false)
    ckb("sat_1.2.9_in",  svt_satisfies("1.2.9", "~1.2.3"), true)

    // --- svt_satisfies: ~1.2 -> [1.2.0, 1.3.0) ---
    ckb("sat_1.2.9_tilde12_in",  svt_satisfies("1.2.9", "~1.2"), true)
    ckb("sat_1.3.0_tilde12_out", svt_satisfies("1.3.0", "~1.2"), false)
    ckb("sat_1.2.0_tilde12_eq",  svt_satisfies("1.2.0", "~1.2"), true)
    ckb("sat_1.1.9_tilde12_lo",  svt_satisfies("1.1.9", "~1.2"), false)

    // --- svt_satisfies: ~1 -> [1.0.0, 2.0.0) ---
    ckb("sat_1.9.9_tilde1_in",  svt_satisfies("1.9.9", "~1"), true)
    ckb("sat_2.0.0_tilde1_out", svt_satisfies("2.0.0", "~1"), false)
    ckb("sat_1.0.0_tilde1_eq",  svt_satisfies("1.0.0", "~1"), true)
    ckb("sat_0.9.9_tilde1_lo",  svt_satisfies("0.9.9", "~1"), false)

    // --- build/prerelease in version stripped for comparison ---
    ckb("sat_build_meta",svt_satisfies("1.2.5+build.1", "~1.2.3"), true)

    print("PASS _semver_tilde_test")
