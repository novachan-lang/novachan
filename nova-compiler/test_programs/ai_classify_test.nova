// End-to-end AI classification in NOVA: load weights -> matmul -> softmax -> argmax.
// All steps real; oracle values hand-computed.

fn load_matrix(path: string)
    let content = read_file(path)
    let lines = split(content, "\n")
    let dims = split(lines[0], " ")
    let rows = parse_int(dims[0])
    let cols = parse_int(dims[1])
    let flat = []
    let r = 1
    while r <= rows
        let vals = split(lines[r], " ")
        for v in vals
            if len(v) > 0
                flat.push(parse_float(v))
        r = r + 1
    tensor_from_list(flat, [rows, cols])

fn softmax(xs: list) -> list
    let m = xs[0]
    for x in xs
        if x > m
            m = x
    let exps = xs.map(fn(x) exp(x - m))
    let total = 0.0
    for e in exps
        total = total + e
    exps.map(fn(e) e / total)

fn argmax(xs: list) -> int
    let best = 0
    let bestv = xs[0]
    let i = 1
    while i < len(xs)
        if xs[i] > bestv
            bestv = xs[i]
            best = i
        i = i + 1
    best

fn main()
    // 2-input -> 3-class linear classifier
    write_file("clf_w.txt", "2 3\n1.0 2.0 0.0\n0.0 1.0 1.0\n")
    let w = load_matrix("clf_w.txt")
    let x = tensor_from_list([1.0, 2.0], [1, 2])

    // logits = x @ W = [1*1+2*0, 1*2+2*1, 1*0+2*1] = [1, 4, 2]
    let logits = tensor_to_list(tensor_matmul(x, w))
    assert_near(logits[0], 1.0, 0.001)
    assert_near(logits[1], 4.0, 0.001)
    assert_near(logits[2], 2.0, 0.001)

    let probs = softmax(logits)
    assert_near(probs[0] + probs[1] + probs[2], 1.0, 0.001)

    // class 1 has the largest logit (4) -> predicted class 1
    let pred = argmax(probs)
    assert_eq(pred, 1)

    print("classification pipeline passed: predicted class = {pred}")
