// KAT for std/net/dns_types — DNS constants and name<->number maps.
import std/net/dns_types

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL dns_types " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL dns_types " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // --- dns_type_num: name -> number ---
    cki("type_num_A",     dns_type_num("A"),     1)
    cki("type_num_NS",    dns_type_num("NS"),    2)
    cki("type_num_CNAME", dns_type_num("CNAME"), 5)
    cki("type_num_SOA",   dns_type_num("SOA"),   6)
    cki("type_num_PTR",   dns_type_num("PTR"),   12)
    cki("type_num_MX",    dns_type_num("MX"),    15)
    cki("type_num_TXT",   dns_type_num("TXT"),   16)
    cki("type_num_AAAA",  dns_type_num("AAAA"),  28)
    cki("type_num_SRV",   dns_type_num("SRV"),   33)
    cki("type_num_OPT",   dns_type_num("OPT"),   41)
    cki("type_num_unknown", dns_type_num("BOGUS"), 0)

    // --- dns_type_name: number -> name ---
    cks("type_name_1",  dns_type_name(1),  "A")
    cks("type_name_2",  dns_type_name(2),  "NS")
    cks("type_name_5",  dns_type_name(5),  "CNAME")
    cks("type_name_6",  dns_type_name(6),  "SOA")
    cks("type_name_12", dns_type_name(12), "PTR")
    cks("type_name_15", dns_type_name(15), "MX")
    cks("type_name_16", dns_type_name(16), "TXT")
    cks("type_name_28", dns_type_name(28), "AAAA")
    cks("type_name_33", dns_type_name(33), "SRV")
    cks("type_name_41", dns_type_name(41), "OPT")
    cks("type_name_unknown", dns_type_name(99), "")

    // --- dns_class_num: name -> number ---
    cki("class_num_IN", dns_class_num("IN"), 1)
    cki("class_num_CS", dns_class_num("CS"), 2)
    cki("class_num_CH", dns_class_num("CH"), 3)
    cki("class_num_HS", dns_class_num("HS"), 4)
    cki("class_num_unknown", dns_class_num("ANY"), 0)

    // --- dns_class_name: number -> name ---
    cks("class_name_1", dns_class_name(1), "IN")
    cks("class_name_2", dns_class_name(2), "CS")
    cks("class_name_3", dns_class_name(3), "CH")
    cks("class_name_4", dns_class_name(4), "HS")
    cks("class_name_unknown", dns_class_name(255), "")

    // --- dns_rcode_name: number -> mnemonic ---
    cks("rcode_0", dns_rcode_name(0), "NOERROR")
    cks("rcode_1", dns_rcode_name(1), "FORMERR")
    cks("rcode_2", dns_rcode_name(2), "SERVFAIL")
    cks("rcode_3", dns_rcode_name(3), "NXDOMAIN")
    cks("rcode_4", dns_rcode_name(4), "NOTIMP")
    cks("rcode_5", dns_rcode_name(5), "REFUSED")
    cks("rcode_unknown", dns_rcode_name(9), "")

    // --- dns_opcode_name: number -> mnemonic ---
    cks("opcode_0", dns_opcode_name(0), "QUERY")
    cks("opcode_1", dns_opcode_name(1), "IQUERY")
    cks("opcode_2", dns_opcode_name(2), "STATUS")
    cks("opcode_unknown", dns_opcode_name(7), "")

    // --- round-trip: type num -> name -> num ---
    cki("rt_A",    dns_type_num(dns_type_name(1)),  1)
    cki("rt_AAAA", dns_type_num(dns_type_name(28)), 28)
    cki("rt_MX",   dns_type_num(dns_type_name(15)), 15)
    cki("rt_OPT",  dns_type_num(dns_type_name(41)), 41)

    // --- round-trip: class num -> name -> num ---
    cki("rt_class_IN", dns_class_num(dns_class_name(1)), 1)
    cki("rt_class_CH", dns_class_num(dns_class_name(3)), 3)

    print("PASS _dns_types_test")
