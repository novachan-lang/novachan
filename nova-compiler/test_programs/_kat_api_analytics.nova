import forge_api_analytics

fn main()
    let a = aa_new()
    a = aa_record(a, "GET", "/users", 200, 15)
    a = aa_record(a, "GET", "/users", 200, 25)
    a = aa_record(a, "GET", "/users", 500, 100)
    a = aa_record(a, "POST", "/users", 201, 50)
    a = aa_record(a, "POST", "/users", 400, 10)

    assert(aa_total_requests(a) == 5, "5 total requests")
    assert(aa_total_errors(a) == 2, "2 errors (500+400)")
    assert(aa_endpoint_count(a) == 2, "2 endpoints")

    let avg = aa_avg_latency(a, "GET", "/users")
    assert(avg == 46, "avg latency GET /users = 46ms")

    let err = aa_error_rate(a, "GET", "/users")
    assert(err == 33, "33% error rate GET /users")

    let err2 = aa_error_rate(a, "POST", "/users")
    assert(err2 == 50, "50% error rate POST /users")

    assert(aa_avg_latency(a, "DELETE", "/missing") == 0, "missing=0")

    let top = aa_top_endpoints(a)
    assert(len(top) == 2, "2 in top list")
    assert(top[0]["count"] == 3, "most popular=3")

    print("API-ANALYTICS KAT PASS")
