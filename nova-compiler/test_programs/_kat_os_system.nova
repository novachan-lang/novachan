// KAT for the 12 std/os "system utility" modules: fileutil, tempfile, loghandler, argsparse,
// termctl, envconfig, bufreader, filewatch, procutil, treeprint, ini_config, lockfile.
//
// File-based checks use a dedicated working directory (`_kat_os_system_tmp`, a basename not
// used by any other KAT) that is torn down before AND after the run, so re-running is
// idempotent even after a prior failed run left artifacts behind.
import std/os/fileutil
import std/os/tempfile
import std/os/loghandler
import std/os/argsparse
import std/os/termctl
import std/os/envconfig
import std/os/bufreader
import std/os/filewatch
import std/os/procutil
import std/os/treeprint
import std/os/ini_config
import std/os/lockfile

let _c = [0, 0]

fn cks(label: string, got: string, want: string)
    _c[0] = _c[0] + 1
    if got != want
        _c[1] = _c[1] + 1
        print("FAIL " + label + ": got=" + got + " want=" + want)

fn cki(label: string, got: int, want: int)
    _c[0] = _c[0] + 1
    if got != want
        _c[1] = _c[1] + 1
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))

fn ckb(label: string, got: bool, want: bool)
    _c[0] = _c[0] + 1
    if got != want
        _c[1] = _c[1] + 1
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))

fn _teardown(dir: string)
    remove_file(dir + "/a.txt")
    remove_file(dir + "/b.txt")
    remove_file(dir + "/log.txt")
    remove_file(dir + "/cfg.ini")
    remove_file(dir + "/lock.lock")
    remove_dir(dir)

fn main()
    let dir = "_kat_os_system_tmp"
    _teardown(dir)
    make_dir(dir)

    // ---- fileutil ----
    cks("fu_basename", fu_basename("/a/b/c.txt"), "c.txt")
    cks("fu_dirname", fu_dirname("/a/b/c.txt"), "/a/b")
    cks("fu_extension", fu_extension("f.tar.gz"), ".gz")
    cks("fu_join", fu_join("a", "b/"), "a/b/")
    cks("fu_normalize", fu_normalize("a/./b/../c"), "a/c")
    ckb("fu_is_absolute_true", fu_is_absolute("/x"), true)
    ckb("fu_is_absolute_false", fu_is_absolute("x"), false)
    let fpath_a = dir + "/a.txt"
    let fpath_b = dir + "/b.txt"
    ckb("fu_touch", fu_touch(fpath_a), true)
    cki("fu_size_empty", fu_size(fpath_a), 0)
    write_file(fpath_a, "hello")
    cki("fu_size", fu_size(fpath_a), 5)
    ckb("fu_copy", fu_copy(fpath_a, fpath_b), true)
    cks("fu_copy_content", read_file(fpath_b), "hello")
    cki("fu_size_missing", fu_size(dir + "/nope.txt"), 0 - 1)

    // ---- tempfile ----
    let tdir = tf_temp_dir()
    ckb("tf_temp_dir_nonempty", len(tdir) > 0, true)
    let tmp_path = tf_create("_kat_os_")
    ckb("tf_create_exists", file_exists(tmp_path), true)
    ckb("tf_cleanup", tf_cleanup(tmp_path), true)
    ckb("tf_cleanup_gone", file_exists(tmp_path), false)
    let tmp_dir_path = tf_create_dir("_kat_os_dir_")
    ckb("tf_create_dir_exists", is_dir(tmp_dir_path), true)
    ckb("tf_cleanup_dir", tf_cleanup(tmp_dir_path), true)

    // ---- loghandler ----
    let logpath = dir + "/log.txt"
    let lg = log_new(logpath)
    log_write(lg, log_level_info(), "starting up")
    log_write(lg, log_level_error(), "boom")
    ckb("log_buffer_has_info", find(lg["buffer"], "[INFO] starting up") >= 0, true)
    ckb("log_flush", log_flush(lg), true)
    let logged = read_file(logpath)
    ckb("log_file_has_error", find(logged, "[ERROR] boom") >= 0, true)
    cks("log_buffer_cleared", lg["buffer"], "")

    // ---- argsparse ----
    let ap = ap_new("kat-tool")
    ap_add_flag(ap, "verbose", "v", "be verbose")
    ap_add_option(ap, "output", "o", "out.txt", "output path")
    ap_add_positional(ap, "input", "input file")
    let parsed = ap_parse(ap, ["--verbose", "-o", "result.txt", "in.txt"])
    ckb("ap_flag", parsed["verbose"], true)
    cks("ap_option", parsed["output"], "result.txt")
    cks("ap_positional", parsed["input"], "in.txt")
    let parsed_defaults = ap_parse(ap, [])
    ckb("ap_flag_default", parsed_defaults["verbose"], false)
    cks("ap_option_default", parsed_defaults["output"], "out.txt")
    ckb("ap_usage_nonempty", len(ap_usage(ap)) > 0, true)

    // ---- termctl ----
    cks("tc_move_cursor", tc_move_cursor(3, 5), chr(27) + "[3;5H")
    cks("tc_hide_cursor", tc_hide_cursor(), chr(27) + "[?25l")
    cks("tc_show_cursor", tc_show_cursor(), chr(27) + "[?25h")
    cks("tc_set_title", tc_set_title("nova"), chr(27) + "]0;nova" + chr(7))
    ckb("tc_width_positive", tc_width() > 0, true)
    ckb("tc_height_positive", tc_height() > 0, true)

    // ---- envconfig ----
    cks("ec_get_default", ec_get("NOVA_KAT_UNSET_XYZ", "fallback"), "fallback")
    cki("ec_get_int_default", ec_get_int("NOVA_KAT_UNSET_XYZ", 42), 42)
    ckb("ec_get_bool_default", ec_get_bool("NOVA_KAT_UNSET_XYZ", true), true)
    let req = ec_require("NOVA_KAT_UNSET_XYZ")
    ckb("ec_require_missing_is_err", is_err(req), true)
    let prefixed = ec_prefix("NOVA_KAT_", ["UNSET_XYZ"])
    cki("ec_prefix_empty", len(keys(prefixed)), 0)

    // ---- bufreader ----
    let br = br_new("line1" + chr(10) + "line2" + chr(10) + "line3")
    let l1 = br_read_line(br)
    ckb("br_read_line1_ok", is_ok(l1), true)
    cks("br_read_line1_val", unwrap(l1), "line1")
    let l2 = br_read_line(br)
    cks("br_read_line2_val", unwrap(l2), "line2")
    cks("br_peek_line3", br_peek_line(br), "line3")
    cks("br_remaining", br_remaining(br), "line3")
    let l3 = br_read_line(br)
    cks("br_read_line3_val", unwrap(l3), "line3")
    let l4 = br_read_line(br)
    ckb("br_read_eof_is_err", is_err(l4), true)

    // ---- filewatch ----
    let watch_path = dir + "/a.txt"
    write_file(watch_path, "version-1")
    let h1 = fw_snapshot(watch_path)
    let h1b = fw_snapshot(watch_path)
    cki("fw_snapshot_stable", h1, h1b)
    ckb("fw_changed_false", fw_changed(watch_path, h1), false)
    write_file(watch_path, "version-2")
    ckb("fw_changed_true", fw_changed(watch_path, h1), true)
    cki("fw_snapshot_missing", fw_snapshot(dir + "/does_not_exist.txt"), 0 - 1)
    let dirsnap = fw_snapshot_dir(dir)
    ckb("fw_snapshot_dir_has_a", contains(dirsnap, "a.txt"), true)

    // ---- procutil ----
    let start = time_ms()
    ckb("pu_uptime_nonneg", pu_uptime_ms(start) >= 0, true)
    cki("pu_argv_empty", len(pu_argv()), 0)
    ckb("pu_hostname_nonempty", len(pu_hostname()) > 0, true)
    ckb("pu_pid_nonneg", pu_pid() >= 0, true)

    // ---- treeprint ----
    let tree_txt = tp_tree(["a/b.txt", "a/c.txt", "d.txt"])
    ckb("tp_tree_has_a", find(tree_txt, "a") >= 0, true)
    ckb("tp_tree_has_last_connector", find(tree_txt, "└──") >= 0, true)
    ckb("tp_tree_has_mid_connector", find(tree_txt, "├──") >= 0, true)
    cks("tp_indent_2", tp_indent(2), "        ")

    // ---- ini_config ----
    let ini_src = "[server]" + chr(10) + "host = localhost" + chr(10) + "port = 8080" + chr(10)
    let cfg = ic_parse(ini_src)
    cks("ic_get_host", ic_get(cfg, "server", "host", ""), "localhost")
    cks("ic_get_port", ic_get(cfg, "server", "port", ""), "8080")
    cks("ic_get_missing_default", ic_get(cfg, "server", "nope", "dflt"), "dflt")
    ic_set(cfg, "server", "timeout", "30")
    cks("ic_get_after_set", ic_get(cfg, "server", "timeout", ""), "30")
    let secs = ic_sections(cfg)
    cki("ic_sections_count", len(secs), 1)
    cks("ic_sections_name", secs[0], "server")
    let rebuilt = ic_build(cfg)
    ckb("ic_build_has_header", find(rebuilt, "[server]") >= 0, true)
    ckb("ic_build_has_host", find(rebuilt, "host = localhost") >= 0, true)
    let reparsed = ic_parse(rebuilt)
    cks("ic_roundtrip_host", ic_get(reparsed, "server", "host", ""), "localhost")

    // ---- lockfile ----
    let lockpath = dir + "/lock.lock"
    let acq1 = lf_acquire(lockpath)
    ckb("lf_acquire_ok", is_ok(acq1), true)
    ckb("lf_is_locked_true", lf_is_locked(lockpath), true)
    let acq2 = lf_acquire(lockpath)
    ckb("lf_acquire_second_is_err", is_err(acq2), true)
    ckb("lf_stale_immediately", lf_stale(lockpath, 0 - 1), true)
    ckb("lf_stale_far_future", lf_stale(lockpath, 999999999), false)
    ckb("lf_release", lf_release(lockpath), true)
    ckb("lf_is_locked_false", lf_is_locked(lockpath), false)

    _teardown(dir)

    if _c[1] == 0
        print("ALL PASSED (" + str(_c[0]) + " checks)")
    else
        print(str(_c[1]) + " of " + str(_c[0]) + " checks FAILED")
        exit(1)
