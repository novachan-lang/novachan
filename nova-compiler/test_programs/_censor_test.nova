import std/text/censor

// Helper: check string equality
fn cks(label, got, expected) -> int
    if got != expected
        print("FAIL " + label + ": got=" + got + " expected=" + expected)
        exit(1)
    0

// Helper: check int equality
fn cki(label, got, expected) -> int
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)
    0

// ── KAT 1: basic single-word mask ────────────────────────────────────────────
let r1 = cn_mask("hello world", ["world"], "*")
cks("kat1_basic_mask", r1, "hello *****")

// ── KAT 2: case-insensitive mask ─────────────────────────────────────────────
let r2 = cn_mask("a BAD thing", ["bad"], "#")
cks("kat2_case_insensitive", r2, "a ### thing")

// ── KAT 3: cn_contains_any false ─────────────────────────────────────────────
let r3 = cn_contains_any("clean text", ["bad"])
cki("kat3_contains_false", r3, 0)

// ── KAT 4: cn_contains_any true ──────────────────────────────────────────────
let r4 = cn_contains_any("a bad word", ["bad"])
cki("kat4_contains_true", r4, 1)

// ── KAT 5: cn_count two occurrences ──────────────────────────────────────────
let r5 = cn_count("bad bad good", ["bad"])
cki("kat5_count_two", r5, 2)

// ── KAT 6: sub-string inside word should NOT match ───────────────────────────
let r6 = cn_mask("badness", ["bad"], "*")
cks("kat6_no_partial_match", r6, "badness")

// ── KAT 7: no match at all ───────────────────────────────────────────────────
let r7 = cn_mask("no match", ["xyz"], "*")
cks("kat7_no_match", r7, "no match")

// ── KAT 8: multiple banned words in one pass ─────────────────────────────────
let r8 = cn_mask("foo and bar are here", ["foo", "bar"], "-")
cks("kat8_multi_word", r8, "--- and --- are here")

// ── KAT 9: cn_count with multiple words counted separately ───────────────────
let r9 = cn_count("bad evil bad evil evil", ["bad", "evil"])
cki("kat9_count_multi", r9, 5)

// ── KAT 10: word at start and end of string ───────────────────────────────────
let r10 = cn_mask("bad is bad", ["bad"], "X")
cks("kat10_start_end", r10, "XXX is XXX")

print("_censor_test passed")
