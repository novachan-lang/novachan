import std/sketch/reservoir

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn main()
    // --- KAT 1: rs_new(3, 42); add '1'..'10'; size <= 3; count == 10 ---
    let st = rs_new(3, 42)
    let i = 0
    while i < 10
        rs_add(st, str(i + 1))
        i = i + 1
    let sz = rs_size(st)
    if sz > 3
        print("FAIL size_bounded: got=" + str(sz) + " want<=3")
        exit(1)
    cki("count_10", rs_count(st), 10)

    // --- KAT 2: every item in sample came from '1'..'10' ---
    let samp = rs_sample(st)
    let valid = true
    let j = 0
    while j < len(samp)
        let v = samp[j]
        let found = false
        let check = 1
        while check <= 10
            if v == str(check)
                found = true
            check = check + 1
        if found == false
            valid = false
        j = j + 1
    ckb("valid_members", valid, true)

    // --- KAT 3: DETERMINISM — same seed, same stream -> identical sample ---
    let st2 = rs_new(3, 42)
    let i2 = 0
    while i2 < 10
        rs_add(st2, str(i2 + 1))
        i2 = i2 + 1
    let samp2 = rs_sample(st2)
    cki("det_size", len(samp2), len(samp))
    let same = true
    let d = 0
    while d < len(samp)
        if samp[d] != samp2[d]
            same = false
        d = d + 1
    ckb("determinism", same, true)

    // --- KAT 4: when count <= k, reservoir holds ALL items ---
    let st3 = rs_new(5, 1)
    rs_add(st3, "1")
    rs_add(st3, "2")
    rs_add(st3, "3")
    cki("small_count", rs_count(st3), 3)
    cki("small_size", rs_size(st3), 3)
    let samp3 = rs_sample(st3)
    // all three must be present
    let has1 = false
    let has2 = false
    let has3 = false
    let e = 0
    while e < len(samp3)
        if samp3[e] == "1"
            has1 = true
        if samp3[e] == "2"
            has2 = true
        if samp3[e] == "3"
            has3 = true
        e = e + 1
    ckb("small_has1", has1, true)
    ckb("small_has2", has2, true)
    ckb("small_has3", has3, true)

    // --- KAT 5: rs_size never exceeds k ---
    let st4 = rs_new(3, 99)
    let m = 0
    while m < 50
        rs_add(st4, str(m))
        let cur_sz = rs_size(st4)
        if cur_sz > 3
            print("FAIL monotonic_size: at step " + str(m) + " size=" + str(cur_sz))
            exit(1)
        m = m + 1
    cki("final_count", rs_count(st4), 50)

    // --- KAT 6: rs_reset clears reservoir ---
    rs_reset(st4)
    cki("reset_count", rs_count(st4), 0)
    cki("reset_size", rs_size(st4), 0)

    // --- KAT 7: k=0 never stores anything ---
    let st5 = rs_new(0, 7)
    rs_add(st5, "x")
    rs_add(st5, "y")
    cki("k0_size", rs_size(st5), 0)
    cki("k0_count", rs_count(st5), 2)

    // --- KAT 8: rs_sample returns a copy (mutation does not affect state) ---
    let st6 = rs_new(3, 1)
    rs_add(st6, "a")
    rs_add(st6, "b")
    rs_add(st6, "c")
    let samp6a = rs_sample(st6)
    samp6a[0] = "MUTATED"
    let samp6b = rs_sample(st6)
    // The underlying reservoir should still be intact
    let mutated_internal = false
    let q = 0
    while q < len(samp6b)
        if samp6b[q] == "MUTATED"
            mutated_internal = true
        q = q + 1
    ckb("copy_isolation", mutated_internal, false)

    print("PASS _reservoir_test")

main()
