// forge_urlencode_test -- url_encode percent-encodes every byte outside the RFC 3986 unreserved set (so a
// value can't break URL structure), unreserved chars pass through, and url_decode(url_encode(s)) == s for
// every byte (including space, specials, tab, high-bit, control -- uppercase %XX decodes case-insensitively).
import forge

fn main()
    // dangerous URL-structure chars are all encoded
    let e = forge.url_encode("a b&c=d/e?f#g")
    if find(e, " ") >= 0 or find(e, "&") >= 0 or find(e, "=") >= 0 or find(e, "/") >= 0 or find(e, "?") >= 0 or find(e, "#") >= 0
        print("FAIL: a dangerous char was left raw -> " + e)
        exit(1)
    if find(e, "%20") < 0 or find(e, "%26") < 0 or find(e, "%3D") < 0
        print("FAIL: expected %-encodings missing -> " + e)
        exit(1)

    // the unreserved set passes through unchanged
    if forge.url_encode("Aa0-_.~") != "Aa0-_.~"
        print("FAIL: unreserved chars must pass through -> " + forge.url_encode("Aa0-_.~"))
        exit(1)

    // round-trip over a wide byte range: space, specials, '+', tab, high-bit, control
    let s = "hello world! +/=&#%" + chr(9) + chr(200) + chr(1)
    if forge.url_decode(forge.url_encode(s)) != s
        print("FAIL: url_decode(url_encode(s)) != s")
        exit(1)

    print("PASS forge_urlencode (encodes non-unreserved; unreserved pass-through; round-trips all bytes)")
