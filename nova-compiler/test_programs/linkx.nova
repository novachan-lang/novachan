fn linked_new()
  let ll = {}
  ll["head"] = 0
  ll["tail"] = 0
  ll["size"] = 0
  ll

fn _ll_node(value, prev, next)
  let n = {}
  n["value"] = value
  n["prev"] = prev
  n["next"] = next
  n

fn ll_push_back(ll, value)
  let node = _ll_node(value, ll["tail"], 0)
  if ll["tail"] != 0
    ll["tail"]["next"] = node
  else
    ll["head"] = node
  ll["tail"] = node
  ll["size"] = ll["size"] + 1

fn ll_push_front(ll, value)
  let node = _ll_node(value, 0, ll["head"])
  if ll["head"] != 0
    ll["head"]["prev"] = node
  else
    ll["tail"] = node
  ll["head"] = node
  ll["size"] = ll["size"] + 1

fn ll_pop_front(ll)
  if ll["head"] == 0
    return 0
  let node = ll["head"]
  let val = node["value"]
  ll["head"] = node["next"]
  if ll["head"] != 0
    ll["head"]["prev"] = 0
  else
    ll["tail"] = 0
  ll["size"] = ll["size"] - 1
  val

fn ll_pop_back(ll)
  if ll["tail"] == 0
    return 0
  let node = ll["tail"]
  let val = node["value"]
  ll["tail"] = node["prev"]
  if ll["tail"] != 0
    ll["tail"]["next"] = 0
  else
    ll["head"] = 0
  ll["size"] = ll["size"] - 1
  val

fn ll_peek_front(ll)
  if ll["head"] == 0
    return 0
  ll["head"]["value"]

fn ll_peek_back(ll)
  if ll["tail"] == 0
    return 0
  ll["tail"]["value"]

fn ll_size(ll)
  ll["size"]

fn ll_to_list(ll)
  let result = []
  let node = ll["head"]
  while node != 0
    push(result, node["value"])
    node = node["next"]
  result

fn main()
  let ll = linked_new()
  assert(ll_size(ll) == 0, "empty size")

  ll_push_back(ll, 1)
  ll_push_back(ll, 2)
  ll_push_back(ll, 3)
  assert(ll_size(ll) == 3, "size 3")
  assert(ll_peek_front(ll) == 1, "front = 1")
  assert(ll_peek_back(ll) == 3, "back = 3")

  let items = ll_to_list(ll)
  assert(len(items) == 3, "to_list len")
  assert(items[0] == 1, "first")
  assert(items[2] == 3, "last")

  ll_push_front(ll, 0)
  assert(ll_peek_front(ll) == 0, "pushed front")
  assert(ll_size(ll) == 4, "size 4")

  let front = ll_pop_front(ll)
  assert(front == 0, "popped 0")
  assert(ll_size(ll) == 3, "size back to 3")

  let back = ll_pop_back(ll)
  assert(back == 3, "popped back 3")
  assert(ll_size(ll) == 2, "size 2")

  let v1 = ll_pop_front(ll)
  let v2 = ll_pop_front(ll)
  assert(v1 == 1, "drain 1")
  assert(v2 == 2, "drain 2")
  assert(ll_size(ll) == 0, "empty after drain")

  print("linkx: all passed")
