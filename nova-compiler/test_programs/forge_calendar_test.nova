import forge_calendar

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // day of week (0=Sun..6=Sat)
    fails = fails + expect("dow_2000", str(day_of_week(2000, 1, 1)), "6")
    fails = fails + expect("dow_2024", str(day_of_week(2024, 1, 1)), "1")
    fails = fails + expect("dow_1970", str(day_of_week(1970, 1, 1)), "4")
    fails = fails + expect("dow_moon", str(day_of_week(1969, 7, 20)), "0")
    fails = fails + expect("name_2000", day_name(2000, 1, 1), "Saturday")
    fails = fails + expect("name_2024", day_name(2024, 1, 1), "Monday")
    fails = fails + expect("weekend_yes", str(is_weekend(2000, 1, 1)), "true")
    fails = fails + expect("weekend_no", str(is_weekend(2024, 1, 1)), "false")

    // Easter (Gregorian Computus) -> [month, day]
    let e2024 = easter(2024)
    fails = fails + expect("easter_2024", str(e2024[0]) + "/" + str(e2024[1]), "3/31")
    let e2025 = easter(2025)
    fails = fails + expect("easter_2025", str(e2025[0]) + "/" + str(e2025[1]), "4/20")
    let e2000 = easter(2000)
    fails = fails + expect("easter_2000", str(e2000[0]) + "/" + str(e2000[1]), "4/23")
    let e2008 = easter(2008)
    fails = fails + expect("easter_2008", str(e2008[0]) + "/" + str(e2008[1]), "3/23")

    // Julian Day Number
    fails = fails + expect("jdn_2000", str(julian_day(2000, 1, 1)), "2451545")
    fails = fails + expect("jdn_1970", str(julian_day(1970, 1, 1)), "2440588")
    fails = fails + expect("jdn_2024", str(julian_day(2024, 1, 1)), "2460311")

    // inverse round-trips
    let r2000 = from_julian_day(2451545)
    fails = fails + expect("inv_2000", str(r2000[0]) + "-" + str(r2000[1]) + "-" + str(r2000[2]), "2000-1-1")
    let r1970 = from_julian_day(2440588)
    fails = fails + expect("inv_1970", str(r1970[0]) + "-" + str(r1970[1]) + "-" + str(r1970[2]), "1970-1-1")

    // days_between
    fails = fails + expect("between_year", str(days_between(2023, 1, 1, 2024, 1, 1)), "365")
    fails = fails + expect("between_leap", str(days_between(2024, 1, 1, 2025, 1, 1)), "366")
    fails = fails + expect("between_week", str(days_between(2024, 1, 1, 2024, 1, 8)), "7")

    // add_days
    let a1 = add_days(2024, 1, 1, 31)
    fails = fails + expect("add_31", str(a1[0]) + "-" + str(a1[1]) + "-" + str(a1[2]), "2024-2-1")
    let a2 = add_days(2024, 2, 28, 1)
    fails = fails + expect("add_leap", str(a2[0]) + "-" + str(a2[1]) + "-" + str(a2[2]), "2024-2-29")
    let a3 = add_days(2024, 1, 1, 0 - 1)
    fails = fails + expect("add_back", str(a3[0]) + "-" + str(a3[1]) + "-" + str(a3[2]), "2023-12-31")

    if fails == 0
        print("forge_calendar: all passed")
    else
        print("forge_calendar: " + str(fails) + " FAILED")
