import std/text/pluralize

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // KAT: pl_pluralize
    cks("pluralize cat",   pl_pluralize("cat"),   "cats")
    cks("pluralize bus",   pl_pluralize("bus"),   "buses")
    cks("pluralize baby",  pl_pluralize("baby"),  "babies")
    cks("pluralize leaf",  pl_pluralize("leaf"),  "leaves")
    cks("pluralize man",   pl_pluralize("man"),   "men")
    cks("pluralize child", pl_pluralize("child"), "children")

    // Additional pluralize KAT
    cks("pluralize dog",   pl_pluralize("dog"),   "dogs")
    cks("pluralize box",   pl_pluralize("box"),   "boxes")
    cks("pluralize church",pl_pluralize("church"),"churches")
    cks("pluralize dish",  pl_pluralize("dish"),  "dishes")
    cks("pluralize knife", pl_pluralize("knife"), "knives")
    cks("pluralize wolf",  pl_pluralize("wolf"),  "wolves")
    cks("pluralize woman", pl_pluralize("woman"), "women")
    cks("pluralize foot",  pl_pluralize("foot"),  "feet")
    cks("pluralize tooth", pl_pluralize("tooth"), "teeth")
    cks("pluralize mouse", pl_pluralize("mouse"), "mice")
    cks("pluralize person",pl_pluralize("person"),"people")
    cks("pluralize day",   pl_pluralize("day"),   "days")
    cks("pluralize boy",   pl_pluralize("boy"),   "boys")
    cks("pluralize buzz",  pl_pluralize("buzz"),  "buzzes")

    // KAT: pl_singularize
    cks("singularize cats",   pl_singularize("cats"),   "cat")
    cks("singularize babies", pl_singularize("babies"), "baby")
    cks("singularize leaves", pl_singularize("leaves"), "leaf")
    cks("singularize men",    pl_singularize("men"),    "man")
    cks("singularize buses",  pl_singularize("buses"),  "bus")
    cks("singularize boxes",  pl_singularize("boxes"),  "box")
    cks("singularize churches",pl_singularize("churches"),"church")
    cks("singularize dishes", pl_singularize("dishes"), "dish")
    cks("singularize knives", pl_singularize("knives"), "knife")
    cks("singularize wolves", pl_singularize("wolves"), "wolf")
    cks("singularize women",  pl_singularize("women"),  "woman")
    cks("singularize feet",   pl_singularize("feet"),   "foot")
    cks("singularize teeth",  pl_singularize("teeth"),  "tooth")
    cks("singularize mice",   pl_singularize("mice"),   "mouse")
    cks("singularize people", pl_singularize("people"), "person")
    cks("singularize dogs",   pl_singularize("dogs"),   "dog")

    // KAT: pl_plural_n
    cks("plural_n cat 1",  pl_plural_n("cat", 1), "cat")
    cks("plural_n cat 2",  pl_plural_n("cat", 2), "cats")
    cks("plural_n baby 0", pl_plural_n("baby", 0), "babies")
    cks("plural_n man 1",  pl_plural_n("man", 1), "man")
    cks("plural_n man 5",  pl_plural_n("man", 5), "men")
    cks("plural_n bus 2",  pl_plural_n("bus", 2), "buses")

    print("_pluralize_test passed")
