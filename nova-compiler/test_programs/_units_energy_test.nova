import std/units/energy
fn _ap(a, b) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < 0.01
fn _ck(label, got, want)
    if _ap(got, want) == false
        print("FAIL units_energy " + label + " got=" + str(got) + " want=" + str(want))
        exit(1)
fn main()
    _ck("kj_j", energy_convert(1.0, "kj", "j"), 1000.0)
    _ck("kcal_cal", energy_convert(1.0, "kcal", "cal"), 1000.0)
    _ck("kwh_j", energy_convert(1.0, "kwh", "j"), 3600000.0)
    _ck("kwh_wh", energy_convert(1.0, "kwh", "wh"), 1000.0)
    _ck("cal_j", energy_convert(1.0, "cal", "j"), 4.184)
    _ck("j_kj", energy_convert(2000.0, "j", "kj"), 2.0)
    let rt = energy_from_base(energy_to_base(5.5, "btu"), "btu")
    _ck("btu_roundtrip", rt, 5.5)
    if energy_is_supported("kwh") == false
        print("FAIL units_energy supported")
        exit(1)
    print("PASS _units_energy_test")
