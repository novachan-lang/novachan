// KAT test for std/text/readability
import std/text/readability

// Helper: check int equality
fn cki(label, got, expected) -> int
    if got == expected
        return 0
    print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
    exit(1)
    0

// Helper: check string equality
fn cks(label, got, expected) -> int
    if got == expected
        return 0
    print("FAIL " + label + ": got " + got + " expected " + expected)
    exit(1)
    0

// Helper: check float within epsilon
fn ckf(label, got, expected, eps) -> int
    let diff = got - expected
    if diff < 0.0
        diff = 0.0 - diff
    if diff <= eps
        return 0
    print("FAIL " + label + ": got " + str(got) + " expected " + str(expected) + " eps " + str(eps))
    exit(1)
    0

// ── KAT assertions ──────────────────────────────────────────────────────────

// 1. rd_word_count on simple sentence
cki("wc_basic", rd_word_count("The cat sat."), 3)

// 2. rd_sentence_count with two terminators
cki("sc_two", rd_sentence_count("Hi. Bye!"), 2)

// 3. rd_sentence_count on text with no terminator (must return 1)
cki("sc_no_terminator", rd_sentence_count("no terminator"), 1)

// 4. rd_word_count on four-word string
cki("wc_four", rd_word_count("one two three four"), 4)

// 5. rd_word_count on empty string
cki("wc_empty", rd_word_count(""), 0)

// 6. rd_syllable_count: "hello" -> at least 1
let sy_hello = rd_syllable_count("hello")
if sy_hello < 1
    print("FAIL sc_hello: got " + str(sy_hello) + " expected >= 1")
    exit(1)

// 7. rd_flesch_reading_ease on simple sentence should be in [0.0, 130.0]
let fre = rd_flesch_reading_ease("The cat sat on the mat.")
if fre < 0.0
    print("FAIL fre_range_low: got " + str(fre))
    exit(1)
if fre > 130.0
    print("FAIL fre_range_high: got " + str(fre))
    exit(1)

// 8. rd_sentence_count with question mark
cki("sc_question", rd_sentence_count("What? Really! Yes."), 3)

// 9. rd_word_count on multi-space / tab separated
cki("wc_spaces", rd_word_count("  hello   world  "), 2)

// 10. rd_flesch_kincaid_grade returns a float (just check it doesn't crash and
//     is within a sane range for a simple sentence)
let fkg = rd_flesch_kincaid_grade("The cat sat on the mat.")
// FK grade for very simple text can be low; just check it's a plausible float
// (finite, between -20 and 20 for this text)
if fkg < -20.0
    print("FAIL fkg_range_low: got " + str(fkg))
    exit(1)
if fkg > 20.0
    print("FAIL fkg_range_high: got " + str(fkg))
    exit(1)

// 11. rd_ari on empty string returns 0.0
ckf("ari_empty", rd_ari(""), 0.0, 0.5)

// 12. rd_syllable_count on "cat sat" -> at least 2 (one per word)
let sy_cats = rd_syllable_count("cat sat")
if sy_cats < 2
    print("FAIL sy_cat_sat: got " + str(sy_cats) + " expected >= 2")
    exit(1)

// 13. rd_word_count empty-only whitespace
cki("wc_ws_only", rd_word_count("   "), 0)

// 14. rd_sentence_count on empty string returns 0
cki("sc_empty", rd_sentence_count(""), 0)

// 15. rd_syllable_count("hello") specifically >= 1 via ckf-style bounds
if sy_hello < 1
    print("FAIL sy_hello_min: got " + str(sy_hello))
    exit(1)

print("_readability_test passed")
