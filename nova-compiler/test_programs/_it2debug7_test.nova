import std/interval/interval_tree2

fn main()
    let ivs = []
    push(ivs, [1,3])
    push(ivs, [5,8])
    push(ivs, [6,10])
    push(ivs, [15,20])
    print("before all:")
    let i = 0
    while i < 4
        let ii = i
        let v = ivs[ii]
        print("  [" + str(ii) + "]=" + str(v[0]) + "," + str(v[1]))
        i = i + 1
    // Now call _it2_sort via it_build by making the build function operate on our list
    // Actually let's just call it_build
    let t = it_build(ivs)
    print("after build count=" + str(it_count(t)))
    let all = it_all(t)
    let j = 0
    while j < len(all)
        let jj = j
        let v = all[jj]
        print("  [" + str(jj) + "]=" + str(v[0]) + "," + str(v[1]))
        j = j + 1
    print("original ivs still intact?")
    let k = 0
    while k < 4
        let kk = k
        let v = ivs[kk]
        print("  ivs[" + str(kk) + "]=" + str(v[0]) + "," + str(v[1]))
        k = k + 1

main()
