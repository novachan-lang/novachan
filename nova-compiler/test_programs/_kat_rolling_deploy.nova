import forge_rolling_deploy

fn main()
    let rd = rd_new(10, 3)
    assert(rd_status(rd) == "idle", "starts idle")
    assert(rd_remaining(rd) == 10, "10 remaining")

    rd = rd_start(rd, "v2.0")
    assert(rd_status(rd) == "deploying", "deploying")
    assert(rd_version(rd) == "v2.0", "version")

    rd = rd_advance_batch(rd, 3, 0)
    assert(rd_progress_pct(rd) == 30, "30% done")
    assert(rd_remaining(rd) == 7, "7 remaining")
    assert(rd_batches_done(rd) == 1, "1 batch")

    rd = rd_advance_batch(rd, 2, 1)
    assert(rd_failure_rate(rd) == 16, "16% failure rate")

    rd = rd_pause(rd)
    assert(rd_status(rd) == "paused", "paused")

    rd = rd_resume(rd)
    assert(rd_status(rd) == "deploying", "resumed")

    rd = rd_advance_batch(rd, 3, 0)
    rd = rd_advance_batch(rd, 1, 0)
    assert(rd_status(rd) == "complete", "complete")
    assert(rd_progress_pct(rd) == 90, "90% deployed")

    let rd2 = rd_new(5, 2)
    rd2 = rd_start(rd2, "v1.0")
    rd2 = rd_rollback(rd2)
    assert(rd_status(rd2) == "rolling-back", "rollback")

    print("ROLLING-DEPLOY KAT PASS")
