// _gzip_member_test.nova — KAT for std/compress/gzip_member
import std/compress/gzip_member

fn ck_bool(label, got, want)
    if got != want
        let gs = "false"
        let ws = "false"
        if got
            gs = "true"
        if want
            ws = "true"
        print("FAIL gzip_member " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn ck_int(label, got, want)
    if got != want
        print("FAIL gzip_member " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck_str(label, got, want)
    if got != want
        print("FAIL gzip_member " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // ── Build a 20-byte gzip member ─────────────────────────────────────────
    // Header (10 bytes):
    //   byte0=31, byte1=139, byte2=8 (deflate), byte3=8 (FLG: FNAME set)
    //   MTIME u32le 0: 0,0,0,0
    //   XFL=0, OS=3 (Unix)
    // Body (arbitrary 5 bytes, simulating compressed data + NUL-terminated name):
    //   65,66,67,0,0
    // Footer (8 bytes):
    //   CRC32 u32le 305419896 = 0x12345678 -> bytes 0x78,0x56,0x34,0x12 = 120,86,52,18
    //   ISIZE u32le 10 -> 10,0,0,0
    let buf = []
    // header
    push(buf, 31)
    push(buf, 139)
    push(buf, 8)
    push(buf, 8)
    // mtime u32le 0
    push(buf, 0)
    push(buf, 0)
    push(buf, 0)
    push(buf, 0)
    // xfl
    push(buf, 0)
    // os = 3 (Unix)
    push(buf, 3)
    // body bytes (5 bytes: 65,66,67,0,0)
    push(buf, 65)
    push(buf, 66)
    push(buf, 67)
    push(buf, 0)
    push(buf, 0)
    // footer: CRC32 = 305419896 = 0x12345678 -> LE bytes = 0x78,0x56,0x34,0x12
    push(buf, 120)
    push(buf, 86)
    push(buf, 52)
    push(buf, 18)
    // footer: ISIZE = 10 -> LE bytes = 10,0,0,0
    push(buf, 10)
    push(buf, 0)
    push(buf, 0)
    push(buf, 0)

    ck_bool("magic_check", gz_magic_check(buf), true)
    ck_int("method", gz_method(buf), 8)
    ck_bool("flag_fname", gz_flag_fname(buf), true)
    ck_bool("flag_ftext", gz_flag_ftext(buf), false)
    ck_bool("flag_fhcrc", gz_flag_fhcrc(buf), false)
    ck_bool("flag_fextra", gz_flag_fextra(buf), false)
    ck_bool("flag_fcomment", gz_flag_fcomment(buf), false)
    ck_int("mtime", gz_mtime(buf), 0)
    ck_int("xfl", gz_xfl(buf), 0)
    ck_int("os", gz_os(buf), 3)
    ck_str("os_name", gz_os_name(buf), "Unix")
    ck_int("footer_isize", gz_footer_isize(buf), 10)
    ck_int("footer_crc32", gz_footer_crc32(buf), 305419896)

    // ── All-flags set: byte3 = 31 (bits 0-4 all set) ─────────────────────────
    let buf2 = []
    push(buf2, 31)
    push(buf2, 139)
    push(buf2, 8)
    push(buf2, 31)
    push(buf2, 0)
    push(buf2, 0)
    push(buf2, 0)
    push(buf2, 0)
    push(buf2, 0)
    push(buf2, 0)
    ck_bool("all_ftext", gz_flag_ftext(buf2), true)
    ck_bool("all_fhcrc", gz_flag_fhcrc(buf2), true)
    ck_bool("all_fextra", gz_flag_fextra(buf2), true)
    ck_bool("all_fname", gz_flag_fname(buf2), true)
    ck_bool("all_fcomment", gz_flag_fcomment(buf2), true)

    // ── OS variants ──────────────────────────────────────────────────────────
    let buf3 = []
    push(buf3, 31)
    push(buf3, 139)
    push(buf3, 8)
    push(buf3, 0)
    push(buf3, 0)
    push(buf3, 0)
    push(buf3, 0)
    push(buf3, 0)
    push(buf3, 0)
    push(buf3, 0)
    ck_str("os_fat", gz_os_name(buf3), "FAT")

    let buf4 = []
    push(buf4, 31)
    push(buf4, 139)
    push(buf4, 8)
    push(buf4, 0)
    push(buf4, 0)
    push(buf4, 0)
    push(buf4, 0)
    push(buf4, 0)
    push(buf4, 0)
    push(buf4, 255)
    ck_str("os_unknown", gz_os_name(buf4), "unknown")

    let buf5 = []
    push(buf5, 31)
    push(buf5, 139)
    push(buf5, 8)
    push(buf5, 0)
    push(buf5, 0)
    push(buf5, 0)
    push(buf5, 0)
    push(buf5, 0)
    push(buf5, 0)
    push(buf5, 7)
    ck_str("os_other", gz_os_name(buf5), "other")

    // ── Bad magic ────────────────────────────────────────────────────────────
    let bad = []
    push(bad, 0)
    push(bad, 0)
    ck_bool("bad_magic", gz_magic_check(bad), false)

    // ── Too-short buffer ──────────────────────────────────────────────────────
    let tiny = [31]
    ck_bool("tiny_magic", gz_magic_check(tiny), false)
    ck_int("tiny_method", gz_method(tiny), 0)

    // ── MTIME non-zero test ──────────────────────────────────────────────────
    // mtime = 0x12345678 = 305419896
    let buf6 = []
    push(buf6, 31)
    push(buf6, 139)
    push(buf6, 8)
    push(buf6, 0)
    // mtime u32le 305419896 = 0x12345678 -> bytes 0x78,0x56,0x34,0x12
    push(buf6, 120)
    push(buf6, 86)
    push(buf6, 52)
    push(buf6, 18)
    push(buf6, 0)
    push(buf6, 3)
    ck_int("mtime_nonzero", gz_mtime(buf6), 305419896)

    print("PASS _gzip_member_test")
