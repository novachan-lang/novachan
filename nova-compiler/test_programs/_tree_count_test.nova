import std/tree/tree_count

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn main()
    // Tree: 0-{1,2}, 1-{3,4}  n=5  adj=[[1,2],[0,3,4],[0],[1],[1]]
    let adj5 = [[1,2],[0,3,4],[0],[1],[1]]

    // KAT 1: leaves = nodes with degree 1: nodes 2,3,4 -> 3
    cki("leaves_5", tcnt_leaves(adj5, 5), 3)

    // KAT 2: internal = n - leaves = 5 - 3 = 2
    cki("internal_5", tcnt_internal(adj5, 5), 2)

    // KAT 3: degree of node 1 = len([0,3,4]) = 3
    cki("degree_1", tcnt_degree(adj5, 5, 1), 3)

    // KAT 4: nodes at depth 2 from root 0: nodes 3 and 4 -> 2
    cki("at_depth_2", tcnt_nodes_at_depth(adj5, 5, 0, 2), 2)

    // KAT 5: nodes at depth 0 from root 0: just root -> 1
    cki("at_depth_0", tcnt_nodes_at_depth(adj5, 5, 0, 0), 1)

    // KAT 6: single-node tree counts as 1 leaf
    let adj1 = [[]]
    cki("leaves_n1", tcnt_leaves(adj1, 1), 1)

    // KAT 7: single-node tree has 0 internal nodes
    cki("internal_n1", tcnt_internal(adj1, 1), 0)

    // KAT 8: degree of node 0 in n=1 tree = 0
    cki("degree_n1", tcnt_degree(adj1, 1, 0), 0)

    // KAT 9: nodes at depth 0 in n=1 tree = 1
    cki("n1_depth0", tcnt_nodes_at_depth(adj1, 1, 0, 0), 1)

    // KAT 10: nodes at depth 1 in n=1 tree = 0
    cki("n1_depth1", tcnt_nodes_at_depth(adj1, 1, 0, 1), 0)

    // KAT 11: star graph n=5 (node 0 center, leaves 1,2,3,4)
    let adjstar = [[1,2,3,4],[0],[0],[0],[0]]
    cki("star_leaves", tcnt_leaves(adjstar, 5), 4)
    cki("star_internal", tcnt_internal(adjstar, 5), 1)
    cki("star_degree_0", tcnt_degree(adjstar, 5, 0), 4)

    // KAT 12: nodes at depth 1 in star (root=0) = 4
    cki("star_at_depth1", tcnt_nodes_at_depth(adjstar, 5, 0, 1), 4)

    // KAT 13: nodes at depth 2 in star (root=0) = 0
    cki("star_at_depth2", tcnt_nodes_at_depth(adjstar, 5, 0, 2), 0)

    // KAT 14: path graph n=4  (0-1-2-3), leaves=2 (nodes 0,3)
    let adjpath4 = [[1],[0,2],[1,3],[2]]
    cki("path4_leaves", tcnt_leaves(adjpath4, 4), 2)
    cki("path4_internal", tcnt_internal(adjpath4, 4), 2)

    // KAT 15: nodes at depth 1 from root 0 in path 0-1-2-3 = 1 (only node 1)
    cki("path4_at_depth1", tcnt_nodes_at_depth(adjpath4, 4, 0, 1), 1)

    print("PASS _tree_count_test")
