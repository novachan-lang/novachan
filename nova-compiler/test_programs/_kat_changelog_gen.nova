import forge_changelog_gen

fn main()
    let cg = cg_new("v1.2.0")
    cg = cg_add_entry(cg, "feat", "Add user search", "alice")
    cg = cg_add_entry(cg, "feat", "Add dark mode", "bob")
    cg = cg_add_entry(cg, "fix", "Fix login timeout", "alice")
    cg = cg_add_entry(cg, "fix", "Fix crash on empty input", "carol")
    cg = cg_add_entry(cg, "docs", "Update README", "bob")

    assert(cg_entry_count(cg) == 5, "5 entries")

    let feats = cg_by_category(cg, "feat")
    assert(len(feats) == 2, "2 features")
    let fixes = cg_by_category(cg, "fix")
    assert(len(fixes) == 2, "2 fixes")

    let cats = cg_categories(cg)
    assert(len(cats) == 3, "3 categories")

    assert(cg_has_breaking(cg) == 0, "no breaking")
    assert(cg_suggest_bump(cg) == "minor", "minor bump (has feat)")

    let rendered = cg_render(cg)
    assert(len(rendered) > 50, "rendered has content")

    let cg2 = cg_new("v2.0.0")
    cg2 = cg_add_entry(cg2, "breaking", "Remove legacy API", "admin")
    assert(cg_has_breaking(cg2) == 1, "has breaking")
    assert(cg_suggest_bump(cg2) == "major", "major bump")

    let cg3 = cg_new("v1.2.1")
    cg3 = cg_add_entry(cg3, "fix", "Patch security hole", "ops")
    assert(cg_suggest_bump(cg3) == "patch", "patch bump (fix only)")

    print("CHANGELOG-GEN KAT PASS")
