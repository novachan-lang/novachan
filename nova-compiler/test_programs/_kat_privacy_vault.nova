import forge_privacy_vault

fn main()
    let p = pv_new()
    p = pv_set_retention(p, 30)
    p = pv_store(p, "user1", "email", "alice@example.com")
    p = pv_store(p, "user1", "ssn", "123-45-6789")
    p = pv_store(p, "user2", "email", "bob@example.com")
    assert(pv_record_count(p) == 3, "3 records")

    let r1 = pv_retrieve(p, "user1", "email", "admin")
    p = r1["p"]
    assert(r1["found"] == 1, "found user1 email")
    assert(r1["value"] == "alice@example.com", "correct value")
    assert(pv_access_count(p) == 1, "1 access")
    assert(pv_last_accessor(p) == "admin", "accessor=admin")

    let r2 = pv_retrieve(p, "user1", "phone", "admin")
    p = r2["p"]
    assert(r2["found"] == 0, "phone not found")
    assert(pv_access_count(p) == 1, "still 1 access")

    p = pv_delete_subject(p, "user1")

    let r3 = pv_retrieve(p, "user1", "email", "bob")
    p = r3["p"]
    assert(r3["value"] == "", "deleted user1 email empty")

    let r4 = pv_retrieve(p, "user2", "email", "admin")
    p = r4["p"]
    assert(r4["found"] == 1, "user2 still exists")
    assert(r4["value"] == "bob@example.com", "user2 email correct")

    print("PRIVACY-VAULT KAT PASS")
