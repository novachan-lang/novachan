// _latlon_bbox_test.nova — KAT for std/geo/latlon_bbox
import std/geo/latlon_bbox

fn ckf(label, got, expected, eps)
    let diff = got - expected
    if diff < 0.0
        diff = 0.0 - diff
    if diff > eps
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(expected))
        exit(1)

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(expected))
        exit(1)

fn ckb(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(expected))
        exit(1)

fn main()
    // Build test bbox [0,0,10,10]
    let box1 = bb_make(0.0, 0.0, 10.0, 10.0)

    // KAT 1: bb_contains inside
    ckb("contains inside", bb_contains(box1, 5.0, 5.0), true)

    // KAT 2: bb_contains outside
    ckb("contains outside", bb_contains(box1, 15.0, 5.0), false)

    // KAT 3: bb_center of [0,0,10,20] == [5,10]
    let box2 = bb_make(0.0, 0.0, 10.0, 20.0)
    let c2 = bb_center(box2)
    let c2lat = c2[0] * 1.0
    let c2lon = c2[1] * 1.0
    ckf("center lat", c2lat, 5.0, 0.0001)
    ckf("center lon", c2lon, 10.0, 0.0001)

    // KAT 4: bb_expand [2,2,4,4] by 1,1 == [1,1,5,5]
    let box3 = bb_make(2.0, 2.0, 4.0, 4.0)
    let e3 = bb_expand(box3, 1.0, 1.0)
    let e3mnlat = e3[0] * 1.0
    let e3mnlon = e3[1] * 1.0
    let e3mxlat = e3[2] * 1.0
    let e3mxlon = e3[3] * 1.0
    ckf("expand min_lat", e3mnlat, 1.0, 0.0001)
    ckf("expand min_lon", e3mnlon, 1.0, 0.0001)
    ckf("expand max_lat", e3mxlat, 5.0, 0.0001)
    ckf("expand max_lon", e3mxlon, 5.0, 0.0001)

    // KAT 5: bb_union [0,0,5,5] and [3,3,8,8] == [0,0,8,8]
    let ua = bb_make(0.0, 0.0, 5.0, 5.0)
    let ub = bb_make(3.0, 3.0, 8.0, 8.0)
    let un = bb_union(ua, ub)
    let umnlat = un[0] * 1.0
    let umnlon = un[1] * 1.0
    let umxlat = un[2] * 1.0
    let umxlon = un[3] * 1.0
    ckf("union min_lat", umnlat, 0.0, 0.0001)
    ckf("union min_lon", umnlon, 0.0, 0.0001)
    ckf("union max_lat", umxlat, 8.0, 0.0001)
    ckf("union max_lon", umxlon, 8.0, 0.0001)

    // KAT 6: bb_intersect [0,0,5,5] and [3,3,8,8] == [3,3,5,5]
    let ix = bb_intersect(ua, ub)
    let ixmnlat = ix[0] * 1.0
    let ixmnlon = ix[1] * 1.0
    let ixmxlat = ix[2] * 1.0
    let ixmxlon = ix[3] * 1.0
    ckf("intersect min_lat", ixmnlat, 3.0, 0.0001)
    ckf("intersect min_lon", ixmnlon, 3.0, 0.0001)
    ckf("intersect max_lat", ixmxlat, 5.0, 0.0001)
    ckf("intersect max_lon", ixmxlon, 5.0, 0.0001)

    // KAT 7: bb_intersects disjoint == false
    let da = bb_make(0.0, 0.0, 2.0, 2.0)
    let db = bb_make(5.0, 5.0, 6.0, 6.0)
    ckb("intersects disjoint", bb_intersects(da, db), false)

    // KAT 8: bb_intersects overlapping == true
    ckb("intersects overlap", bb_intersects(ua, ub), true)

    // KAT 9: bb_intersect disjoint returns empty list
    let ix2 = bb_intersect(da, db)
    cki("intersect disjoint len", len(ix2), 0)

    // KAT 10: bb_from_points [[1,2],[3,4],[0,5]] == [0,2,3,5]
    let pts = []
    let p0 = []
    p0.push(1.0)
    p0.push(2.0)
    let p1 = []
    p1.push(3.0)
    p1.push(4.0)
    let p2 = []
    p2.push(0.0)
    p2.push(5.0)
    pts.push(p0)
    pts.push(p1)
    pts.push(p2)
    let fp = bb_from_points(pts)
    let fpmnlat = fp[0] * 1.0
    let fpmnlon = fp[1] * 1.0
    let fpmxlat = fp[2] * 1.0
    let fpmxlon = fp[3] * 1.0
    ckf("from_points min_lat", fpmnlat, 0.0, 0.0001)
    ckf("from_points min_lon", fpmnlon, 2.0, 0.0001)
    ckf("from_points max_lat", fpmxlat, 3.0, 0.0001)
    ckf("from_points max_lon", fpmxlon, 5.0, 0.0001)

    // KAT 11: bb_width [0,0,10,20] == 20.0
    let wbox = bb_make(0.0, 0.0, 10.0, 20.0)
    let w = bb_width(wbox)
    ckf("width", w, 20.0, 0.0001)

    // KAT 12: bb_height [0,0,10,20] == 10.0
    let h = bb_height(wbox)
    ckf("height", h, 10.0, 0.0001)

    // KAT 13: bb_corners returns 4 points
    let corn = bb_corners(box2)
    cki("corners count", len(corn), 4)
    // SW corner = [0,0]
    let sw = corn[0]
    let sw_lat = sw[0] * 1.0
    let sw_lon = sw[1] * 1.0
    ckf("corner SW lat", sw_lat, 0.0, 0.0001)
    ckf("corner SW lon", sw_lon, 0.0, 0.0001)
    // NE corner = [10,20]
    let ne = corn[2]
    let ne_lat = ne[0] * 1.0
    let ne_lon = ne[1] * 1.0
    ckf("corner NE lat", ne_lat, 10.0, 0.0001)
    ckf("corner NE lon", ne_lon, 20.0, 0.0001)

    // KAT 14: bb_contains_bbox — b inside a
    let big = bb_make(0.0, 0.0, 10.0, 10.0)
    let small = bb_make(2.0, 2.0, 5.0, 5.0)
    ckb("contains_bbox inside", bb_contains_bbox(big, small), true)

    // KAT 15: bb_contains_bbox — b partially outside
    let part = bb_make(8.0, 8.0, 15.0, 15.0)
    ckb("contains_bbox partial", bb_contains_bbox(big, part), false)

    // KAT 16: bb_contains on boundary
    ckb("contains boundary", bb_contains(box1, 0.0, 0.0), true)
    ckb("contains boundary max", bb_contains(box1, 10.0, 10.0), true)

    print("PASS _latlon_bbox_test")
