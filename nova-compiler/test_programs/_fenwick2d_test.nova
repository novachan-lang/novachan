import std/collections/fenwick2d

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn main()
    // Build a 4x4 tree with three point updates
    let t = f2_new(4, 4)
    f2_update(t, 1, 1, 5)
    f2_update(t, 2, 3, 7)
    f2_update(t, 4, 4, 2)

    // KAT 1: prefix sum over entire grid = 5+7+2 = 14
    cki("f2_query(4,4)", f2_query(t, 4, 4), 14)

    // KAT 2: only cell (1,1) in rows 1..1, cols 1..1 -> 5
    cki("f2_query(1,1)", f2_query(t, 1, 1), 5)

    // KAT 3: rows 1..2, cols 1..3 -> (1,1)=5 + (2,3)=7 = 12
    cki("f2_query(2,3)", f2_query(t, 2, 3), 12)

    // KAT 4: rows 1..3, cols 1..3 -> same 12 (no updates in row 3, col 4 excluded)
    cki("f2_query(3,3)", f2_query(t, 3, 3), 12)

    // KAT 5: rect rows 2..4, cols 3..4 -> (2,3)=7 + (4,4)=2 = 9
    cki("f2_range(2,3,4,4)", f2_range(t, 2, 3, 4, 4), 9)

    // KAT 6: single-cell rect (1,1)..(1,1) -> 5
    cki("f2_range(1,1,1,1)", f2_range(t, 1, 1, 1, 1), 5)

    // KAT 7: rect rows 3..4, cols 1..4 -> only (4,4)=2
    cki("f2_range(3,1,4,4)", f2_range(t, 3, 1, 4, 4), 2)

    // KAT 8: additional update and re-query
    // Add 3 at (2,1); now rect rows 2..2, cols 1..1 should be 3
    f2_update(t, 2, 1, 3)
    cki("f2_range(2,1,2,1) after update", f2_range(t, 2, 1, 2, 1), 3)

    // KAT 9: full grid now = 14 + 3 = 17
    cki("f2_query(4,4) after second update", f2_query(t, 4, 4), 17)

    // KAT 10: zero-boundary query: prefix(0,*) and prefix(*,0) should be 0
    cki("f2_query(0,4)", f2_query(t, 0, 4), 0)

    print("_fenwick2d_test passed")
