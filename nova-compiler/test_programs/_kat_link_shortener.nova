import forge_link_shortener

fn main()
    let ls = ls_new()
    ls = ls_create(ls, "https://example.com/very/long/url", "abc")
    ls = ls_create(ls, "https://docs.nova-lang.dev", "docs")
    assert(ls_link_count(ls) == 2, "2 links")

    assert(ls_resolve(ls, "abc") == "https://example.com/very/long/url", "resolve abc")
    assert(ls_resolve(ls, "docs") == "https://docs.nova-lang.dev", "resolve docs")
    assert(ls_resolve(ls, "missing") == "", "missing = empty")

    ls = ls_click(ls, "abc")
    ls = ls_click(ls, "abc")
    ls = ls_click(ls, "docs")
    assert(ls_clicks(ls, "abc") == 2, "abc clicked 2x")
    assert(ls_clicks(ls, "docs") == 1, "docs clicked 1x")
    assert(ls_total_clicks(ls) == 3, "3 total clicks")

    ls = ls_deactivate(ls, "abc")
    assert(ls_resolve(ls, "abc") == "", "deactivated = empty")

    ls = ls_create_auto(ls, "https://auto.example.com")
    assert(ls_link_count(ls) == 3, "3 links")

    assert(ls_clicks(ls, "nonexistent") == 0, "missing clicks = 0")

    print("LINK-SHORTENER KAT PASS")
