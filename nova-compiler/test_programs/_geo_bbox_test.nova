// _geo_bbox_test.nova — KAT for std/geo/geo_bbox
import std/geo/geo_bbox

fn approx(a: float, b: float, tol: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < tol

fn ckf(label: str, got: float, expected: float, tol: float)
    if not approx(got, expected, tol)
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn ckb(label: str, got: bool, expected: bool)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn main()
    // KAT 1: bbox of 3 points
    // bbox([[0.0,0.0],[1.0,2.0],[-1.0,1.0]]) == [-1.0, 0.0, 1.0, 2.0]
    let pts1 = []
    let p0 = []
    p0.push(0.0)
    p0.push(0.0)
    let p1 = []
    p1.push(1.0)
    p1.push(2.0)
    let p2 = []
    p2.push(0.0 - 1.0)
    p2.push(1.0)
    pts1.push(p0)
    pts1.push(p1)
    pts1.push(p2)
    let box1 = bbox(pts1)
    let b1_min_lat = box1[0] * 1.0
    let b1_min_lon = box1[1] * 1.0
    let b1_max_lat = box1[2] * 1.0
    let b1_max_lon = box1[3] * 1.0
    ckf("bbox min_lat", b1_min_lat, 0.0 - 1.0, 0.0001)
    ckf("bbox min_lon", b1_min_lon, 0.0, 0.0001)
    ckf("bbox max_lat", b1_max_lat, 1.0, 0.0001)
    ckf("bbox max_lon", b1_max_lon, 2.0, 0.0001)

    // KAT 2: bbox_contains — point inside
    let box2 = box1
    ckb("contains inside", bbox_contains(box2, 0.5, 1.0), true)

    // KAT 3: bbox_contains — point outside
    ckb("contains outside", bbox_contains(box2, 5.0, 5.0), false)

    // KAT 4: bbox_contains — on boundary
    ckb("contains boundary lat", bbox_contains(box2, 0.0 - 1.0, 1.0), true)

    // KAT 5: bbox_center of [0.0, 0.0, 2.0, 2.0] == [1.0, 1.0]
    let cbox = []
    cbox.push(0.0)
    cbox.push(0.0)
    cbox.push(2.0)
    cbox.push(2.0)
    let center = bbox_center(cbox)
    let clat = center[0] * 1.0
    let clon = center[1] * 1.0
    ckf("center lat", clat, 1.0, 0.0001)
    ckf("center lon", clon, 1.0, 0.0001)

    // KAT 6: single-point bbox — min == max
    let pts2 = []
    let sp = []
    sp.push(42.5)
    sp.push(13.7)
    pts2.push(sp)
    let box3 = bbox(pts2)
    let b3_min_lat = box3[0] * 1.0
    let b3_max_lat = box3[2] * 1.0
    ckf("single point min_lat", b3_min_lat, 42.5, 0.0001)
    ckf("single point max_lat", b3_max_lat, 42.5, 0.0001)

    // KAT 7: bbox_center of asymmetric box
    let abox = []
    abox.push(10.0)
    abox.push(20.0)
    abox.push(30.0)
    abox.push(60.0)
    let ac = bbox_center(abox)
    let aclat = ac[0] * 1.0
    let aclon = ac[1] * 1.0
    ckf("asym center lat", aclat, 20.0, 0.0001)
    ckf("asym center lon", aclon, 40.0, 0.0001)

    print("PASS _geo_bbox_test")
