// Tuple destructuring tests
fn swap(a, b)
    [b, a]

result = swap(1, 2)
(x, y) = result
print(x)
print(y)

// Direct destructuring from function return
(a, b) = swap(10, 20)
print(a)
print(b)

// Nested lists
data = [100, 200, 300]
(first, second, third) = data
print(first)
print(second)
print(third)

// With string values
(name, age) = ["Alice", 30]
print(name)
print(age)
