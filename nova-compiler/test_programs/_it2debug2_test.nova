fn main()
    let intervals = [[1,3],[5,8],[6,10],[15,20]]
    let n = len(intervals)
    let ivs = []
    let i = 0
    while i < n
        let ii = i
        push(ivs, intervals[ii])
        i = i + 1
    print("after copy, len=" + str(len(ivs)))
    let j = 0
    while j < len(ivs)
        let jj = j
        let v = ivs[jj]
        print("ivs[" + str(jj) + "]=" + str(v[0]) + "," + str(v[1]))
        j = j + 1

main()
