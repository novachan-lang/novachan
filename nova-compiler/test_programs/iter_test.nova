// Lazy iterator protocol test suite

fn test_basic_iter()
    print("--- iter from list ---")
    let nums = [10, 20, 30, 40, 50]
    let it = iter(nums)
    let r = iter_collect(it)
    print(len(r))
    print(r[0])
    print(r[4])

fn test_iter_range()
    print("--- iter_range ---")
    let it = iter_range(1, 6)
    let r = iter_collect(it)
    print(len(r))
    print(r[0])
    print(r[4])

fn test_iter_range_step()
    print("--- iter_range_step ---")
    let it = iter_range_step(0, 20, 5)
    let r = iter_collect(it)
    print(len(r))
    print(r[0])
    print(r[3])

fn test_iter_map()
    print("--- iter_map ---")
    let it = iter_map(iter_range(1, 6), fn(x) x * x)
    let r = iter_collect(it)
    print(len(r))
    print(r[0])
    print(r[1])
    print(r[4])

fn test_iter_filter()
    print("--- iter_filter ---")
    let it = iter_filter(iter_range(1, 11), fn(x) x % 2 == 0)
    let r = iter_collect(it)
    print(len(r))
    print(r[0])
    print(r[4])

fn test_chained()
    print("--- chained map+filter ---")
    let it = iter_range(1, 21)
    let it2 = iter_filter(it, fn(x) x % 3 == 0)
    let it3 = iter_map(it2, fn(x) x * 10)
    let r = iter_collect(it3)
    print(len(r))
    print(r[0])
    print(r[5])

fn test_iter_take()
    print("--- iter_take ---")
    let it = iter_take(iter_range(0, 1000000), 5)
    let r = iter_collect(it)
    print(len(r))
    print(r[4])

fn test_iter_skip()
    print("--- iter_skip ---")
    let it = iter_skip(iter_range(0, 10), 7)
    let r = iter_collect(it)
    print(len(r))
    print(r[0])
    print(r[2])

fn test_iter_zip()
    print("--- iter_zip ---")
    let a = iter(["a", "b", "c"])
    let b = iter_range(1, 4)
    let it = iter_zip(a, b)
    let r = iter_collect(it)
    print(len(r))
    let pair = r[1]
    print(pair[0])
    print(pair[1])

fn test_iter_chain()
    print("--- iter_chain ---")
    let a = iter_range(1, 4)
    let b = iter_range(10, 13)
    let it = iter_chain(a, b)
    let r = iter_collect(it)
    print(len(r))
    print(r[0])
    print(r[3])
    print(r[5])

fn test_iter_enumerate()
    print("--- iter_enumerate ---")
    let it = iter_enumerate(iter(["x", "y", "z"]))
    let r = iter_collect(it)
    print(len(r))
    let p = r[2]
    print(p[0])
    print(p[1])

fn test_iter_next()
    print("--- iter_next ---")
    let it = iter_range(100, 103)
    let v1 = iter_next(it)
    print(unwrap(v1))
    let v2 = iter_next(it)
    print(unwrap(v2))
    let v3 = iter_next(it)
    print(unwrap(v3))
    let v4 = iter_next(it)
    print(is_none(v4))

fn test_iter_reduce()
    print("--- iter_reduce ---")
    let total = iter_reduce(iter_range(1, 6), 0, fn(acc, x) acc + x)
    print(total)

    let product = iter_reduce(iter_range(1, 6), 1, fn(acc, x) acc * x)
    print(product)

fn test_iter_count()
    print("--- iter_count ---")
    let n = iter_count(iter_filter(iter_range(1, 101), fn(x) x % 7 == 0))
    print(n)

fn test_iter_sum()
    print("--- iter_sum ---")
    let s = iter_sum(iter_range(1, 101))
    print(s)

fn test_iter_any_all()
    print("--- iter_any / iter_all ---")
    let has_even = iter_any(iter_range(1, 6), fn(x) x % 2 == 0)
    print(has_even)
    let all_pos = iter_all(iter_range(1, 6), fn(x) x > 0)
    print(all_pos)
    let all_lt3 = iter_all(iter_range(1, 6), fn(x) x < 3)
    print(all_lt3)

fn test_iter_find()
    print("--- iter_find ---")
    let r1 = iter_find(iter_range(1, 100), fn(x) x * x > 50)
    print(unwrap(r1))
    let r2 = iter_find(iter_range(1, 5), fn(x) x > 100)
    print(is_none(r2))

fn test_iter_for_each()
    print("--- iter_for_each ---")
    let total = iter_reduce(iter_range(1, 4), 0, fn(a, x) a + x)
    print(total)

fn test_sum_of_squares_even()
    print("--- sum of squares of evens 1-100 ---")
    let it = iter_range(1, 101)
    let it2 = iter_filter(it, fn(x) x % 2 == 0)
    let it3 = iter_map(it2, fn(x) x * x)
    let total = iter_sum(it3)
    print(total)

fn test_flat_map()
    print("--- iter_flat_map ---")
    let it = iter_flat_map(iter_range(1, 4), fn(x) iter_range(0, x))
    let r = iter_collect(it)
    print(len(r))
    print(r[0])
    print(r[1])
    print(r[5])

fn main()
    test_basic_iter()
    test_iter_range()
    test_iter_range_step()
    test_iter_map()
    test_iter_filter()
    test_chained()
    test_iter_take()
    test_iter_skip()
    test_iter_zip()
    test_iter_chain()
    test_iter_enumerate()
    test_iter_next()
    test_iter_reduce()
    test_iter_count()
    test_iter_sum()
    test_iter_any_all()
    test_iter_find()
    test_iter_for_each()
    test_sum_of_squares_even()
    test_flat_map()
    print("ALL ITERATOR TESTS PASSED")
