// KAT for std/time/julianday — Julian Day Number conversions (proleptic Gregorian).
import std/time/julianday

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": " + str(got) + " != " + str(want))
        exit(1)

fn main()
    // KAT 1: jd_from_date(2000,1,1) == 2451545  (J2000.0 epoch, published)
    cki("jd_from J2000", jd_from_date(2000, 1, 1), 2451545)

    // KAT 2: jd_from_date(1970,1,1) == 2440588  (Unix epoch, published)
    cki("jd_from Unix", jd_from_date(1970, 1, 1), 2440588)

    // KAT 3: jd_from_date(-4713,11,24) == 0  (Julian Period epoch, definition)
    cki("jd_from epoch0", jd_from_date(-4713, 11, 24), 0)

    // KAT 4: jd_to_date(2451545) == [2000,1,1]  (J2000.0 inverse)
    let r4 = jd_to_date(2451545)
    let r4y = r4[0]
    let r4m = r4[1]
    let r4d = r4[2]
    cki("jd_to J2000 year",  r4y, 2000)
    cki("jd_to J2000 month", r4m, 1)
    cki("jd_to J2000 day",   r4d, 1)

    // KAT 5: jd_to_date(2440588) == [1970,1,1]  (Unix epoch inverse)
    let r5 = jd_to_date(2440588)
    let r5y = r5[0]
    let r5m = r5[1]
    let r5d = r5[2]
    cki("jd_to Unix year",  r5y, 1970)
    cki("jd_to Unix month", r5m, 1)
    cki("jd_to Unix day",   r5d, 1)

    // KAT 6: jd_days_between(2000,1,1, 2000,1,31) == 30  (30 days in Jan 2000)
    cki("days_between 30", jd_days_between(2000, 1, 1, 2000, 1, 31), 30)

    // KAT 7: jd_weekday(2000,1,1) == 5  (Saturday, universally known)
    cki("weekday Sat", jd_weekday(2000, 1, 1), 5)

    // KAT 8: negative days_between (reverse direction)
    cki("days_between neg", jd_days_between(2000, 1, 31, 2000, 1, 1), -30)

    // KAT 9: round-trip JDN 0 -> date -> JDN
    let r9 = jd_to_date(0)
    let r9y = r9[0]
    let r9m = r9[1]
    let r9d = r9[2]
    cki("round-trip jdn0", jd_from_date(r9y, r9m, r9d), 0)

    print("_julianday_test passed")
