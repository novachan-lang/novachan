import std/text/truncate

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // tr_truncate: basic truncation
    cks("t1", tr_truncate("hello world", 8, "..."), "hello...")
    // tr_truncate: string shorter than maxlen -> unchanged
    cks("t2", tr_truncate("hi", 10, "..."), "hi")
    // tr_truncate: string exactly maxlen -> unchanged
    cks("t3", tr_truncate("abcdef", 6, "..."), "abcdef")
    // tr_truncate: string one longer than maxlen
    cks("t4", tr_truncate("abcdefg", 6, "..."), "abc...")
    // tr_truncate: single char ell (keep 6 chars + "~" = 7)
    // "hello world"[0:6]="hello " so result="hello ~"
    cks("t5", tr_truncate("hello world", 7, "~"), "hello ~")

    // tr_truncate_words: keep first 3 of 5 words, append ell
    cks("w1", tr_truncate_words("a b c d e", 3, "..."), "a b c...")
    // tr_truncate_words: fewer words than maxwords -> unchanged
    cks("w2", tr_truncate_words("a b", 5, "..."), "a b")
    // tr_truncate_words: exactly maxwords -> unchanged
    cks("w3", tr_truncate_words("x y z", 3, "..."), "x y z")
    // tr_truncate_words: maxwords=1 -> just first word + ell
    cks("w4", tr_truncate_words("one two three", 1, "..."), "one...")
    // tr_truncate_words: maxwords=2
    cks("w5", tr_truncate_words("alpha beta gamma delta", 2, "~"), "alpha beta~")

    // tr_middle: truncate with head+tail
    // "abcdefghij" len=10, maxlen=7: head=(7-3+1)/2=2, tail=7-3-2=2 -> "ab...ij"
    cks("m1", tr_middle("abcdefghij", 7), "ab...ij")
    // tr_middle: short string -> unchanged
    cks("m2", tr_middle("short", 10), "short")
    // tr_middle: exactly maxlen -> unchanged
    cks("m3", tr_middle("abcde", 5), "abcde")
    // tr_middle: maxlen=6, head=(6-3+1)/2=2, tail=6-3-2=1 -> "ab...j"
    cks("m4", tr_middle("abcdefghij", 6), "ab...j")
    // tr_middle: maxlen=9, head=(9-3+1)/2=3, tail=9-3-3=3 -> "abc...hij"
    cks("m5", tr_middle("abcdefghij", 9), "abc...hij")

    print("_truncate_test passed")
