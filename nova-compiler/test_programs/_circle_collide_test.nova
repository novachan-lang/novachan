import std/game2d/circle_collide

// ckb — check boolean equality; exit(1) on mismatch.
fn ckb(label: string, got: bool, want: bool)
    let goti = 0
    if got
        goti = 1
    let wanti = 0
    if want
        wanti = 1
    if goti != wanti
        print("FAIL circle_collide " + label + ": got=" + str(goti) + " want=" + str(wanti))
        exit(1)

// ckf — check float with tolerance 0.0001.
fn ckf(label: string, got: float, want: float)
    let tol = 0.0001
    let hi = want + tol
    let lo = want - tol
    if got > hi
        print("FAIL circle_collide " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)
    if got < lo
        print("FAIL circle_collide " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ---- cc_circles ----
    // dist=1, r1+r2=2 -> true
    ckb("circles_overlap", cc_circles(0, 0, 1, 1, 0, 1), true)
    // dist=3, r1+r2=2 -> false
    ckb("circles_disjoint", cc_circles(0, 0, 1, 3, 0, 1), false)
    // touching: dist=2, r1+r2=2 -> true
    ckb("circles_touching", cc_circles(0, 0, 1, 2, 0, 1), true)

    // ---- cc_circle_point ----
    // sqrt(1+1)=sqrt(2)~1.414 < 2 -> true
    ckb("circle_point_inside", cc_circle_point(0, 0, 2, 1, 1), true)
    // sqrt(9+16)=5 > 2 -> false
    ckb("circle_point_outside", cc_circle_point(0, 0, 2, 3, 4), false)
    // exactly on boundary: sqrt(4)=2==r -> true
    ckb("circle_point_on_boundary", cc_circle_point(0, 0, 2, 2, 0), true)

    // ---- cc_dist ----
    // 3-4-5 triangle
    let d345 = cc_dist(0, 0, 3, 4)
    ckf("dist_3_4_5", d345, 5.0)
    // coincident
    let d0 = cc_dist(1, 2, 1, 2)
    ckf("dist_zero", d0, 0.0)

    // ---- cc_closest_on_aabb ----
    // point outside right side: (5,2) closest on [0,0,4,4] is (4,2)
    let cl1 = cc_closest_on_aabb(5, 2, [0, 0, 4, 4])
    ckf("closest_right_x", cl1[0], 4.0)
    ckf("closest_right_y", cl1[1], 2.0)
    // point inside: clamp = point itself
    let cl2 = cc_closest_on_aabb(2, 3, [0, 0, 4, 4])
    ckf("closest_inside_x", cl2[0], 2.0)
    ckf("closest_inside_y", cl2[1], 3.0)
    // point above-left corner
    let cl3 = cc_closest_on_aabb(-1, -1, [0, 0, 4, 4])
    ckf("closest_corner_x", cl3[0], 0.0)
    ckf("closest_corner_y", cl3[1], 0.0)

    // ---- cc_circle_aabb ----
    // circle (5,2,2) vs [0,0,4,4]: closest=(4,2), dist=1 < 2 -> true
    ckb("circle_aabb_near", cc_circle_aabb(5, 2, 2, [0, 0, 4, 4]), true)
    // circle (5,2,0) vs [0,0,4,4]: closest=(4,2), dist=1 > 0 -> false
    ckb("circle_aabb_far", cc_circle_aabb(10, 10, 1, [0, 0, 4, 4]), false)
    // circle inside box -> true
    ckb("circle_aabb_inside", cc_circle_aabb(2, 2, 1, [0, 0, 4, 4]), true)

    // ---- cc_penetration ----
    // (0,0,2) vs (3,0,2): d=3, r1+r2=4, depth=1.0
    let pen1 = cc_penetration(0, 0, 2, 3, 0, 2)
    ckf("penetration_1", pen1, 1.0)
    // not overlapping: d=5 > r1+r2=2
    let pen2 = cc_penetration(0, 0, 1, 5, 0, 1)
    ckf("penetration_none", pen2, 0.0)
    // touching: d=2 == r1+r2=2 -> depth=0
    let pen3 = cc_penetration(0, 0, 1, 2, 0, 1)
    ckf("penetration_touching", pen3, 0.0)

    // ---- cc_normal ----
    // from (0,0) to (3,0): unit vector = [1,0]
    let nm1 = cc_normal(0, 0, 3, 0)
    ckf("normal_x_dir_x", nm1[0], 1.0)
    ckf("normal_x_dir_y", nm1[1], 0.0)
    // from (0,0) to (0,5): unit vector = [0,1]
    let nm2 = cc_normal(0, 0, 0, 5)
    ckf("normal_y_dir_x", nm2[0], 0.0)
    ckf("normal_y_dir_y", nm2[1], 1.0)
    // coincident -> [0,0]
    let nm3 = cc_normal(1, 1, 1, 1)
    ckf("normal_coincident_x", nm3[0], 0.0)
    ckf("normal_coincident_y", nm3[1], 0.0)

    // ---- cc_contains (alias for cc_circle_point) ----
    ckb("contains_inside", cc_contains(0, 0, 5, 3, 4), true)
    ckb("contains_outside", cc_contains(0, 0, 2, 5, 5), false)

    print("PASS _circle_collide_test")
