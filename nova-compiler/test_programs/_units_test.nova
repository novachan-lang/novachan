// KAT for std/numeric/units.nova
import std/numeric/units

fn ckf(name: string, got: float, want: float, eps: float)
    let d = got - want
    if d < 0.0
        d = 0.0 - d
    if d > eps
        print("FAIL " + name + ": got=" + str(got) + " want=" + str(want))
        exit(1)
    print("ok " + name)

fn cki(name: string, got: int, want: int)
    if got != want
        print("FAIL " + name + ": got=" + str(got) + " want=" + str(want))
        exit(1)
    print("ok " + name)

fn main()
    // KAT 1: 1000 m -> 1 km
    let r1 = un_convert(1000.0, "m", "km")
    ckf("1000m->km", r1, 1.0, 0.01)

    // KAT 2: 1 km -> 1000 m
    let r2 = un_convert(1.0, "km", "m")
    ckf("1km->m", r2, 1000.0, 0.01)

    // KAT 3: 1 mi -> 1609.344 m
    let r3 = un_convert(1.0, "mi", "m")
    ckf("1mi->m", r3, 1609.344, 0.01)

    // KAT 4: 1 kg -> 1000 g
    let r4 = un_convert(1.0, "kg", "g")
    ckf("1kg->g", r4, 1000.0, 0.01)

    // KAT 5: 12 in -> 1 ft
    let r5 = un_convert(12.0, "in", "ft")
    ckf("12in->ft", r5, 1.0, 0.01)

    // KAT 6: 0 C -> 32 F
    let r6 = un_convert(0.0, "C", "F")
    ckf("0C->F", r6, 32.0, 0.01)

    // KAT 7: 100 C -> 212 F
    let r7 = un_convert(100.0, "C", "F")
    ckf("100C->F", r7, 212.0, 0.01)

    // KAT 8: 0 C -> 273.15 K
    let r8 = un_convert(0.0, "C", "K")
    ckf("0C->K", r8, 273.15, 0.01)

    // KAT 9: un_factor("km") == 1000.0
    let f1 = un_factor("km")
    ckf("factor_km", f1, 1000.0, 0.01)

    // KAT 10: un_same_category("m","km") == true
    let sc1 = un_same_category("m", "km")
    cki("same_cat_length", sc1, 1)

    // KAT 11: un_same_category("m","kg") == false
    let sc2 = un_same_category("m", "kg")
    cki("diff_cat", sc2, 0)

    // KAT 12: un_convert 1 hr -> 3600 s
    let r12 = un_convert(1.0, "hr", "s")
    ckf("1hr->s", r12, 3600.0, 0.01)

    // KAT 13: F -> C round-trip: 32F = 0C
    let r13 = un_convert(32.0, "F", "C")
    ckf("32F->C", r13, 0.0, 0.01)

    // KAT 14: K -> C: 273.15K = 0C
    let r14 = un_convert(273.15, "K", "C")
    ckf("273.15K->C", r14, 0.0, 0.01)

    print("_units_test passed")
