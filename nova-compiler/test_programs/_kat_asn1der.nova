import std/encoding/asn1
import std/encoding/hex

fn ck(label: string, got: string, want: string)
    let ok = "FAIL"
    if got == want
        ok = "ok"
    print(label + "=" + ok + " (got=" + got + " want=" + want + ")")

fn ckb(label: string, got: bool)
    let ok = "FAIL"
    if got
        ok = "ok"
    print(label + "=" + ok)

fn ck_int(label: string, got: int, want: int)
    let ok = "FAIL"
    if got == want
        ok = "ok"
    print(label + "=" + ok + " (got=" + str(got) + " want=" + str(want) + ")")

fn ck_str(label: string, got: string, want: string)
    let ok = "FAIL"
    if got == want
        ok = "ok"
    print(label + "=" + ok + " (got='" + got + "' want='" + want + "')")

// round-trip an INTEGER through encode->decode and check both byte-exactness
// (when want_hex is non-empty) and value fidelity.
fn ck_integer(label: string, n: int, want_hex: string)
    let enc = asn1_encode_integer(n)
    if want_hex != ""
        ck(label + "_bytes", hex_encode(enc), want_hex)
    let dr = asn1_decode_integer(enc, 0)
    ck_int(label + "_roundtrip", dr[0], n)
    ck_int(label + "_next", dr[1], bytes_len(enc))

fn main()
    // ── INTEGER byte-exact vectors from spec ────────────────────────────
    ck_integer("int_zero", 0, "020100")
    ck_integer("int_127", 127, "02017f")
    ck_integer("int_128", 128, "02020080")
    ck_integer("int_256", 256, "02020100")
    ck_integer("int_neg128", -128, "020180")

    // ── INTEGER additional width-boundary vectors (hand-derived) ────────
    ck_integer("int_255", 255, "020200ff")
    ck_integer("int_neg255", -255, "0202ff01")
    ck_integer("int_neg1", -1, "0201ff")
    ck_integer("int_1", 1, "020101")

    // ── INTEGER round-trip only (width/extreme boundaries) ──────────────
    ck_integer("int_2p31m1", 2147483647, "")
    ck_integer("int_2p31", 2147483648, "")
    ck_integer("int_2p32m1", 4294967295, "")
    ck_integer("int_2p32", 4294967296, "")
    ck_integer("int_i64max", 9223372036854775807, "")
    ck_integer("int_i64near_min", 0 - 9223372036854775807, "")
    ck_integer("int_neg2p31", 0 - 2147483648, "")

    // ── BOOLEAN ───────────────────────────────────────────────────────
    ck("bool_true_bytes", hex_encode(asn1_encode_boolean(true)), "0101ff")
    ck("bool_false_bytes", hex_encode(asn1_encode_boolean(false)), "010100")
    let bt = asn1_decode_boolean(asn1_encode_boolean(true), 0)
    ckb("bool_true_roundtrip", bt[0] == true)
    let bf = asn1_decode_boolean(asn1_encode_boolean(false), 0)
    ckb("bool_false_roundtrip", bf[0] == false)

    // ── NULL ──────────────────────────────────────────────────────────
    ck("null_bytes", hex_encode(asn1_encode_null()), "0500")
    let nn = asn1_decode_null(asn1_encode_null(), 0)
    ck_int("null_next", nn, 2)

    // ── OCTET STRING — binary-safe, embedded 0x00 round-trips ───────────
    let osrc = bytes_create(5)
    bytes_set(osrc, 0, 0x41)
    bytes_set(osrc, 1, 0x00)
    bytes_set(osrc, 2, 0xFF)
    bytes_set(osrc, 3, 0x00)
    bytes_set(osrc, 4, 0x42)
    let oenc = asn1_encode_octet_string(osrc)
    ck("octstr_bytes", hex_encode(oenc), "04054100ff0042")
    let odec = asn1_decode_octet_string(oenc, 0)
    ck("octstr_roundtrip", hex_encode(odec[0]), hex_encode(osrc))
    ck_int("octstr_next", odec[1], bytes_len(oenc))

    // ── injection check: an embedded byte pattern that LOOKS like a NULL
    //    TLV header (05 00) inside OCTET STRING content must never be
    //    parsed as a nested/sibling element — length is authoritative,
    //    not content scanning.
    let inj = bytes_create(6)
    bytes_set(inj, 0, 0x11)
    bytes_set(inj, 1, 0x05)
    bytes_set(inj, 2, 0x00)
    bytes_set(inj, 3, 0x30)
    bytes_set(inj, 4, 0x00)
    bytes_set(inj, 5, 0x22)
    let injenc = asn1_encode_octet_string(inj)
    let injdec = asn1_decode_octet_string(injenc, 0)
    ck("injection_octstr_intact", hex_encode(injdec[0]), hex_encode(inj))
    ck_int("injection_next_at_end", injdec[1], bytes_len(injenc))

    // ── UTF8String ────────────────────────────────────────────────────
    let uenc = asn1_encode_utf8_string("NOVA")
    ck("utf8str_bytes", hex_encode(uenc), "0c044e4f5641")
    let udec = asn1_decode_utf8_string(uenc, 0)
    ck_str("utf8str_roundtrip", udec[0], "NOVA")
    let uenc_empty = asn1_encode_utf8_string("")
    ck("utf8str_empty_bytes", hex_encode(uenc_empty), "0c00")

    // ── OBJECT IDENTIFIER — 1.2.840.113549 (RSADSI, from PKCS/X.509) ────
    let oidenc = asn1_encode_oid("1.2.840.113549")
    ck("oid_bytes", hex_encode(oidenc), "06062a864886f70d")
    let oiddec = asn1_decode_oid(oidenc, 0)
    ck_str("oid_roundtrip", oiddec[0], "1.2.840.113549")

    // OID with small arcs (single-byte components) and arc1=2 branch
    let oid2 = asn1_encode_oid("2.5.4.3")
    let oid2dec = asn1_decode_oid(oid2, 0)
    ck_str("oid_arc2_roundtrip", oid2dec[0], "2.5.4.3")

    // OID arc1=0 branch
    let oid0 = asn1_encode_oid("0.9.2342.19200300.100.1.1")
    let oid0dec = asn1_decode_oid(oid0, 0)
    ck_str("oid_arc0_roundtrip", oid0dec[0], "0.9.2342.19200300.100.1.1")

    // ── length encoding boundaries: short/long form transition ─────────
    ck("len_127", hex_encode(asn1_encode_length(127)), "7f")
    ck("len_128", hex_encode(asn1_encode_length(128)), "8180")
    ck("len_255", hex_encode(asn1_encode_length(255)), "81ff")
    ck("len_256", hex_encode(asn1_encode_length(256)), "820100")
    let ld127 = asn1_decode_length(asn1_encode_length(127), 0)
    ck_int("len_127_roundtrip", ld127[0], 127)
    let ld128 = asn1_decode_length(asn1_encode_length(128), 0)
    ck_int("len_128_roundtrip", ld128[0], 128)
    let ld256 = asn1_decode_length(asn1_encode_length(256), 0)
    ck_int("len_256_roundtrip", ld256[0], 256)

    // ── SEQUENCE of two INTEGERs, short-form length ─────────────────────
    let e1 = asn1_encode_integer(1)
    let e2 = asn1_encode_integer(256)
    let seq_elems = [e1, e2]
    let seqenc = asn1_encode_sequence(seq_elems)
    // e1 = 02 01 01 (3 bytes), e2 = 02 02 01 00 (4 bytes) -> content=7 bytes
    // header = 30 07 -> total "30 07 02 01 01 02 02 01 00"
    ck("seq_two_ints_bytes", hex_encode(seqenc), "300702010102020100")
    let seqdec = asn1_decode_sequence(seqenc, 0)
    let parts = asn1_sequence_elements(seqdec[0])
    ck_int("seq_two_ints_count", len(parts), 2)
    let p1 = asn1_decode_integer(parts[0], 0)
    ck_int("seq_elem0_value", p1[0], 1)
    let p2 = asn1_decode_integer(parts[1], 0)
    ck_int("seq_elem1_value", p2[0], 256)

    // ── SEQUENCE with long-form length (content > 127 bytes) ────────────
    let big = bytes_create(200)
    let i = 0
    while i < 200
        bytes_set(big, i, 0xAA)
        i = i + 1
    let bigoct = asn1_encode_octet_string(big)
    // octet-string TLV = 04 81 C8 <200 bytes> -> 203 bytes total
    ck_int("bigoct_len", bytes_len(bigoct), 203)
    let bigseq = asn1_encode_sequence([bigoct])
    // sequence content = 203 bytes (>127) -> long form 81 CB
    ck("bigseq_header", hex_encode(bytes_slice(bigseq, 0, 3)), "3081cb")
    ck_int("bigseq_total_len", bytes_len(bigseq), 3 + 203)
    let bigseqdec = asn1_decode_sequence(bigseq, 0)
    let bigparts = asn1_sequence_elements(bigseqdec[0])
    ck_int("bigseq_elem_count", len(bigparts), 1)
    let bigoctdec = asn1_decode_octet_string(bigparts[0], 0)
    ck("bigseq_octet_roundtrip", hex_encode(bigoctdec[0]), hex_encode(big))

    // ── empty inputs / degenerate shapes ────────────────────────────────
    let emptyoct = asn1_encode_octet_string(bytes_create(0))
    ck("octstr_empty_bytes", hex_encode(emptyoct), "0400")
    let emptyoctdec = asn1_decode_octet_string(emptyoct, 0)
    ck_int("octstr_empty_len", bytes_len(emptyoctdec[0]), 0)

    let emptyseq = asn1_encode_sequence([])
    ck("seq_empty_bytes", hex_encode(emptyseq), "3000")
    let emptyseqdec = asn1_decode_sequence(emptyseq, 0)
    let emptyparts = asn1_sequence_elements(emptyseqdec[0])
    ck_int("seq_empty_count", len(emptyparts), 0)

    print("DONE")
