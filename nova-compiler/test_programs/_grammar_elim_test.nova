// KAT for std/grammar/grammar_elim
import std/grammar/grammar_elim

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL grammar_elim " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL grammar_elim " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL grammar_elim " + label + ": got=" + gs + " want=" + ws)
        exit(1)

// Helper: check if a production [lhs, rhs] exists in prods.
fn has_prod(prods, lhs, rhs) -> bool
    let i = 0
    while i < len(prods)
        let p = prods[i]
        if p[0] == lhs
            let r = p[1]
            if len(r) == len(rhs)
                let ok = true
                let j = 0
                while j < len(r)
                    if r[j] != rhs[j]
                        ok = false
                    j = j + 1
                if ok
                    return true
        i = i + 1
    return false

fn main()
    // =========================================================
    // KAT 1: grel_remove_epsilon
    // Grammar: S -> A B, A -> a | epsilon, B -> b
    // Nullable: A
    // Expected: S -> A B | B (A removed), A -> a, B -> b
    // =========================================================
    let re_prods = []
    let rhs_ab = []
    rhs_ab.push("A")
    rhs_ab.push("B")
    re_prods.push(["S", rhs_ab])
    let rhs_a = []
    rhs_a.push("a")
    re_prods.push(["A", rhs_a])
    let rhs_eps = []
    re_prods.push(["A", rhs_eps])
    let rhs_b = []
    rhs_b.push("b")
    re_prods.push(["B", rhs_b])

    let re_result = grel_remove_epsilon(re_prods, "S")

    // S -> A B must remain
    let want_ab = []
    want_ab.push("A")
    want_ab.push("B")
    ckb("re_SAB", has_prod(re_result, "S", want_ab), true)

    // S -> B must appear (A omitted since nullable)
    let want_b2 = []
    want_b2.push("B")
    ckb("re_SB", has_prod(re_result, "S", want_b2), true)

    // A -> a must remain
    let want_a2 = []
    want_a2.push("a")
    ckb("re_Aa", has_prod(re_result, "A", want_a2), true)

    // A -> epsilon must NOT appear (A is not start)
    let eps = []
    ckb("re_no_Aeps", has_prod(re_result, "A", eps), false)

    // B -> b must remain
    let want_b3 = []
    want_b3.push("b")
    ckb("re_Bb", has_prod(re_result, "B", want_b3), true)

    // =========================================================
    // KAT 2: grel_remove_units — A -> B -> b becomes A -> b
    // Grammar: A -> B, B -> b
    // Expected after unit removal: A -> b, B -> b
    // =========================================================
    let unit_prods = []
    let rhs_B = []
    rhs_B.push("B")
    unit_prods.push(["A", rhs_B])
    let rhs_b2 = []
    rhs_b2.push("b")
    unit_prods.push(["B", rhs_b2])

    let unit_result = grel_remove_units(unit_prods)

    // A -> b (via unit chain)
    let want_bx = []
    want_bx.push("b")
    ckb("unit_Ab", has_prod(unit_result, "A", want_bx), true)
    // A -> B (unit) must be gone
    let want_Bu = []
    want_Bu.push("B")
    ckb("unit_no_AB", has_prod(unit_result, "A", want_Bu), false)
    // B -> b retained
    let want_by = []
    want_by.push("b")
    ckb("unit_Bb", has_prod(unit_result, "B", want_by), true)

    // =========================================================
    // KAT 3: grel_remove_useless — unreachable NT dropped
    // Grammar: S -> a, D -> d (D unreachable from S)
    // After useless removal: only S -> a remains.
    // =========================================================
    let ul_prods = []
    let rhs_sa = []
    rhs_sa.push("a")
    ul_prods.push(["S", rhs_sa])
    let rhs_d = []
    rhs_d.push("d")
    ul_prods.push(["D", rhs_d])

    let ul_result = grel_remove_useless(ul_prods, "S")

    // S -> a present
    let want_sa = []
    want_sa.push("a")
    ckb("ul_Sa", has_prod(ul_result, "S", want_sa), true)
    // D -> d absent
    let want_d = []
    want_d.push("d")
    ckb("ul_no_Dd", has_prod(ul_result, "D", want_d), false)

    // =========================================================
    // KAT 4: grel_remove_useless — non-generating NT dropped
    // Grammar: S -> A | a, A -> B, B -> A (cycle, never generates)
    // After useless removal: S -> a only.
    // =========================================================
    let ug_prods = []
    let rhs_A2 = []
    rhs_A2.push("A")
    ug_prods.push(["S", rhs_A2])
    let rhs_a3 = []
    rhs_a3.push("a")
    ug_prods.push(["S", rhs_a3])
    let rhs_B2 = []
    rhs_B2.push("B")
    ug_prods.push(["A", rhs_B2])
    let rhs_A3 = []
    rhs_A3.push("A")
    ug_prods.push(["B", rhs_A3])

    let ug_result = grel_remove_useless(ug_prods, "S")

    // S -> a should remain
    let want_a4 = []
    want_a4.push("a")
    ckb("ug_Sa", has_prod(ug_result, "S", want_a4), true)
    // S -> A must be gone (A non-generating)
    let want_A4 = []
    want_A4.push("A")
    ckb("ug_no_SA", has_prod(ug_result, "S", want_A4), false)

    // =========================================================
    // KAT 5: grel_eliminate_left_recursion
    // E -> E "+" T | T   and   T -> "id"
    // After elim: E -> T E1, E1 -> "+" T E1 | epsilon, T -> "id"
    // Language preserved: recognizes id, id+id, id+id+id
    // =========================================================
    let lr_prods = []
    let rhs_E1 = []
    rhs_E1.push("E")
    rhs_E1.push("+")
    rhs_E1.push("T")
    lr_prods.push(["E", rhs_E1])
    let rhs_T = []
    rhs_T.push("T")
    lr_prods.push(["E", rhs_T])
    let rhs_id = []
    rhs_id.push("id")
    lr_prods.push(["T", rhs_id])

    let lr_result = grel_eliminate_left_recursion(lr_prods)

    // E -> E "+" T must be GONE
    ckb("lr_no_E_plus", has_prod(lr_result, "E", rhs_E1), false)

    // E -> T E1 must exist (where E1 is the fresh prime)
    // Find the fresh prime name by looking for the E1 epsilon production.
    let prime_name = ""
    let lri = 0
    while lri < len(lr_result)
        let p = lr_result[lri]
        if p[0] != "E" and p[0] != "T"
            // This is the prime NT
            if len(p[1]) == 0
                prime_name = p[0]
        lri = lri + 1
    ckb("lr_prime_found", prime_name != "", true)

    // E -> T <prime> must exist
    let want_TE = []
    want_TE.push("T")
    want_TE.push(prime_name)
    ckb("lr_E_T_prime", has_prod(lr_result, "E", want_TE), true)

    // <prime> -> "+" T <prime> must exist
    let want_plus_T_prime = []
    want_plus_T_prime.push("+")
    want_plus_T_prime.push("T")
    want_plus_T_prime.push(prime_name)
    ckb("lr_prime_rhs", has_prod(lr_result, prime_name, want_plus_T_prime), true)

    // <prime> -> epsilon must exist
    let eps2 = []
    ckb("lr_prime_eps", has_prod(lr_result, prime_name, eps2), true)

    // Language preserved: grel_recognizes on LR grammar and result grammar agree.
    // Original LR grammar (left-recursive) — recognizes via the bounded recognizer.
    let tok_id = []
    tok_id.push("id")
    let tok_id_plus_id = []
    tok_id_plus_id.push("id")
    tok_id_plus_id.push("+")
    tok_id_plus_id.push("id")
    let tok_triple = []
    tok_triple.push("id")
    tok_triple.push("+")
    tok_triple.push("id")
    tok_triple.push("+")
    tok_triple.push("id")

    // Transformed grammar recognizes same strings.
    ckb("lr_rec_id", grel_recognizes(lr_result, "E", tok_id, 30), true)
    ckb("lr_rec_id_plus_id", grel_recognizes(lr_result, "E", tok_id_plus_id, 50), true)
    ckb("lr_rec_triple", grel_recognizes(lr_result, "E", tok_triple, 80), true)

    // =========================================================
    // KAT 6: grel_left_factor
    // A -> a b | a c  =>  A -> a A1, A1 -> b | c
    // =========================================================
    let lf_prods = []
    let rhs_ab2 = []
    rhs_ab2.push("a")
    rhs_ab2.push("b")
    lf_prods.push(["A", rhs_ab2])
    let rhs_ac = []
    rhs_ac.push("a")
    rhs_ac.push("c")
    lf_prods.push(["A", rhs_ac])

    let lf_result = grel_left_factor(lf_prods)

    // A -> a b and A -> a c must be gone (replaced by factored form).
    ckb("lf_no_ab", has_prod(lf_result, "A", rhs_ab2), false)
    ckb("lf_no_ac", has_prod(lf_result, "A", rhs_ac), false)

    // A -> a <prime> must exist.
    // Find the prime for A.
    let lf_prime = ""
    let lfi = 0
    while lfi < len(lf_result)
        let p = lf_result[lfi]
        if p[0] != "A"
            lf_prime = p[0]
        lfi = lfi + 1

    ckb("lf_prime_found", lf_prime != "", true)

    let want_a_prime = []
    want_a_prime.push("a")
    want_a_prime.push(lf_prime)
    ckb("lf_A_a_prime", has_prod(lf_result, "A", want_a_prime), true)

    // prime -> b and prime -> c
    let want_bz = []
    want_bz.push("b")
    ckb("lf_prime_b", has_prod(lf_result, lf_prime, want_bz), true)
    let want_cz = []
    want_cz.push("c")
    ckb("lf_prime_c", has_prod(lf_result, lf_prime, want_cz), true)

    print("PASS _grammar_elim_test")
