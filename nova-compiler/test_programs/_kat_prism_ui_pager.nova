// KAT for prism/ui/prism_ui_pager.nova -- pagination: windowed page nav bar, page-size selector,
// item-range info line, compact prev/label/next, and "load more". Data-driven: every group of
// structurally-similar cases (rejections, per-child field checks) is a list of rows walked by one
// loop, through ONE shared assertion helper, rather than one hand-written block per case.
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova into
// $NOVA_HOME/lib, so `import prism_node` / `import prism_ui_pager` resolve.
//   ./gen3_test.exe _kat_prism_ui_pager.nova
//   clang -O2 -o _kat_prism_ui_pager.exe _kat_prism_ui_pager.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_ui_pager.exe

import prism_node
import prism_ui_pager

let STATS = [0, 0]  // [passed, failed]

fn check(name: string, got: string, want: string) -> bool
    if got == want
        print("  pass  {name}")
        STATS[0] = STATS[0] + 1
        return true
    print("  FAIL  {name}  got={got}  want={want}")
    STATS[1] = STATS[1] + 1
    return false

fn check_true(name: string, cond: bool) -> bool
    if cond
        print("  pass  {name}")
        STATS[0] = STATS[0] + 1
        return true
    print("  FAIL  {name}")
    STATS[1] = STATS[1] + 1
    return false

fn _kind(n: PrismNode) -> string
    prism_node.prism_node_kind_str(n)

fn _text(n: PrismNode) -> string
    prism_node.prism_node_attr_str(n, "text", "")

fn _href(n: PrismNode) -> string
    prism_node.prism_node_attr_str(n, "href", "")

// One field extractor shared by every per-child assertion below, dispatched by field name so a
// check row is just [child_index, field, expected] -- not a copy of the same 3-line block.
fn _field(n: PrismNode, field: string) -> string
    if field == "kind"
        return _kind(n)
    if field == "text"
        return _text(n)
    _href(n)

// ═══ 1. prism_pg_pager: windowed page nav bar ══════════════════════════════════════════════════
// win_lo/win_hi and the resulting nums list are hand-computed per case in the header of each row's
// comment; the shape checks below prove the module's actual output matches.
fn _run_pager_case(label: string, cur: int, tot: int, win: int, exp_count: int, exp_kids: int, fields: list)
    let r = prism_ui_pager.prism_pg_pager(cur, tot, win)
    if is_err(r)
        check_true("{label} builds", false)
        return
    let node = unwrap(r)
    check("{label} kind", _kind(node), "band")
    check("{label} count", str(prism_node.prism_node_count(node)), str(exp_count))
    check("{label} child_count", str(prism_node.prism_node_child_count(node)), str(exp_kids))
    let kids = prism_node.prism_node_children(node)
    for f in fields
        check("{label} [{f[0]}] {f[1]}", _field(kids[f[0]], f[1]), f[2])

fn kat_pager()
    print("== 1. prism_pg_pager: windowed page nav bar ==")
    let cases = [
        // 1a. current=5,total=20,window=2: win_lo=3,win_hi=7 -> [1,gap,3,4,5,6,7,gap,20] -- BOTH ellipses.
        ["1a cur=5 tot=20 win=2", 5, 20, 2, 12, 11, [
            [0, "kind", "link"], [0, "text", "Previous"], [0, "href", "/#page-4"],
            [1, "kind", "link"], [1, "href", "/#page-1"],
            [2, "kind", "label"], [2, "text", "..."],
            [5, "kind", "label"], [5, "text", "5"],
            [8, "text", "..."],
            [9, "kind", "link"], [9, "href", "/#page-20"],
            [10, "kind", "link"], [10, "href", "/#page-6"]]],
        // 1b. current=1,total=1,window=3 (window > total): no ellipsis, both prev/next disabled.
        ["1b cur=1 tot=1 win=3", 1, 1, 3, 4, 3, [
            [0, "kind", "label"], [0, "text", "Previous"],
            [1, "kind", "label"], [1, "text", "1"],
            [2, "kind", "label"], [2, "text", "Next"]]],
        // 1c. current=1,total=20,window=0: head has NO gap (current==page 1); tail HAS a gap.
        ["1c cur=1 tot=20 win=0", 1, 20, 0, 6, 5, [
            [0, "kind", "label"], [1, "text", "1"], [2, "text", "..."],
            [3, "kind", "link"], [3, "href", "/#page-20"],
            [4, "kind", "link"], [4, "href", "/#page-2"]]],
        // 1d. current=19,total=20,window=0: window adjacent to the LAST page -> NO tail gap.
        ["1d cur=19 tot=20 win=0", 19, 20, 0, 7, 6, [
            [1, "kind", "link"], [2, "text", "..."], [3, "text", "19"],
            [4, "kind", "link"], [4, "text", "20"], [5, "href", "/#page-20"]]],
        // 1e. current=2,total=20,window=0: window adjacent to the FIRST page -> NO head gap.
        ["1e cur=2 tot=20 win=0", 2, 20, 0, 7, 6, [
            [1, "text", "1"], [2, "kind", "label"], [2, "text", "2"],
            [3, "text", "..."], [4, "text", "20"], [0, "href", "/#page-1"]]]
    ]
    for c in cases
        _run_pager_case(c[0], c[1], c[2], c[3], c[4], c[5], c[6])

    let bad = [
        ["1f rejects pg_total<1", 1, 0, 2],
        ["1g rejects pg_window<0", 1, 10, -1],
        ["1h rejects pg_current<1", 0, 10, 2],
        ["1i rejects pg_current>pg_total", 11, 10, 2]
    ]
    for c in bad
        check_true(c[0], is_err(prism_ui_pager.prism_pg_pager(c[1], c[2], c[3])))

// ═══ 2. prism_pg_size_select: page-size selector ═══════════════════════════════════════════════
fn kat_size_select()
    print("== 2. prism_pg_size_select: page-size selector ==")
    let r = prism_ui_pager.prism_pg_size_select("Show", [10, 25, 50], 25)
    if is_err(r)
        check_true("2a prism_pg_size_select builds", false)
    else
        let node = unwrap(r)
        check("2a kind", _kind(node), "band")
        check("2a count", str(prism_node.prism_node_count(node)), "6")
        let kids = prism_node.prism_node_children(node)
        check("2a caption text", _text(kids[0]), "Show")
        check("2a items kind", _kind(kids[1]), "flow")
        let items = prism_node.prism_node_children(kids[1])
        let item_fields = [
            [0, "kind", "link"], [0, "text", "10"], [0, "href", "/#size-10"],
            [1, "kind", "label"], [1, "text", "25"],
            [2, "kind", "link"], [2, "href", "/#size-50"]]
        for f in item_fields
            check("2a item[{f[0]}] {f[1]}", _field(items[f[0]], f[1]), f[2])

    let bad = [
        ["2b rejects empty pg_label", "", [10, 25, 50], 25],
        ["2c rejects empty pg_sizes", "Show", [], 25],
        ["2d rejects a non-int element", "Show", [10, "25", 50], 25],
        ["2e rejects a non-positive element", "Show", [10, -5, 50], 10],
        ["2f rejects a duplicate element", "Show", [10, 10, 50], 10],
        ["2g rejects pg_selected not in pg_sizes", "Show", [10, 25, 50], 99]
    ]
    for c in bad
        check_true(c[0], is_err(prism_ui_pager.prism_pg_size_select(c[1], c[2], c[3])))

// ═══ 3. prism_pg_info: item-range info line ════════════════════════════════════════════════════
fn kat_info()
    print("== 3. prism_pg_info: item-range info line ==")
    let ok_cases = [
        ["3a", 1, 10, 100, "Showing 1-10 of 100 items"],
        ["3b (0-0-0 edge)", 0, 0, 0, "Showing 0-0 of 0 items"]
    ]
    for c in ok_cases
        let r = prism_ui_pager.prism_pg_info(c[1], c[2], c[3])
        if is_err(r)
            check_true("{c[0]} builds", false)
        else
            check("{c[0]} text", _text(unwrap(r)), c[4])

    let bad = [
        ["3c rejects pg_start<0", -1, 5, 10],
        ["3d rejects pg_end<pg_start", 10, 5, 20],
        ["3e rejects pg_end>pg_total_items", 1, 200, 100],
        ["3f rejects pg_total_items<0", 0, 0, -1]
    ]
    for c in bad
        check_true(c[0], is_err(prism_ui_pager.prism_pg_info(c[1], c[2], c[3])))

// ═══ 4. prism_pg_compact: [prev] label [next] ══════════════════════════════════════════════════
fn _run_compact_case(label: string, cur: int, tot: int, fields: list)
    let r = prism_ui_pager.prism_pg_compact(cur, tot)
    if is_err(r)
        check_true("{label} builds", false)
        return
    let node = unwrap(r)
    check("{label} kind", _kind(node), "band")
    check("{label} count", str(prism_node.prism_node_count(node)), "4")
    let kids = prism_node.prism_node_children(node)
    for f in fields
        check("{label} [{f[0]}] {f[1]}", _field(kids[f[0]], f[1]), f[2])

fn kat_compact()
    print("== 4. prism_pg_compact: [prev] label [next] ==")
    let cases = [
        ["4a cur=3 tot=10 (both enabled)", 3, 10, [
            [0, "kind", "link"], [0, "href", "/#page-2"],
            [1, "text", "Page 3 of 10"],
            [2, "kind", "link"], [2, "href", "/#page-4"]]],
        ["4b cur=1 tot=1 (both disabled)", 1, 1, [
            [0, "kind", "label"], [1, "text", "Page 1 of 1"], [2, "kind", "label"]]],
        ["4c cur=1 tot=5 (prev-only disabled)", 1, 5, [
            [0, "kind", "label"], [2, "kind", "link"], [2, "href", "/#page-2"]]],
        ["4d cur=5 tot=5 (next-only disabled)", 5, 5, [
            [0, "kind", "link"], [0, "href", "/#page-4"], [2, "kind", "label"]]]
    ]
    for c in cases
        _run_compact_case(c[0], c[1], c[2], c[3])

    let bad = [
        ["4e rejects pg_total<1", 1, 0],
        ["4f rejects pg_current<1", 0, 5],
        ["4g rejects pg_current>pg_total", 6, 5]
    ]
    for c in bad
        check_true(c[0], is_err(prism_ui_pager.prism_pg_compact(c[1], c[2])))

// ═══ 5. prism_pg_load_more ══════════════════════════════════════════════════════════════════════
fn kat_load_more()
    print("== 5. prism_pg_load_more ==")
    let cases = [
        ["5a loading", "Load more", 20, 100, "stack", "20 of 100 loaded"],
        ["5b loaded==total (done)", "Load more", 100, 100, "label", "All items loaded"],
        ["5c loaded>total (stale overshoot still reads as done)", "Load more", 150, 100, "label", "All items loaded"]
    ]
    for c in cases
        let r = prism_ui_pager.prism_pg_load_more(c[1], c[2], c[3])
        if is_err(r)
            check_true("{c[0]} builds", false)
        else
            let node = unwrap(r)
            check("{c[0]} kind", _kind(node), c[4])
            if c[4] == "stack"
                let kids = prism_node.prism_node_children(node)
                check("{c[0]} child[0] kind", _kind(kids[0]), "press")
                check("{c[0]} child[0] text", _text(kids[0]), c[1])
                check("{c[0]} child[1] text", _text(kids[1]), c[5])
            else
                check("{c[0]} text", _text(node), c[5])

    let bad = [
        ["5d rejects empty pg_label", "", 0, 10],
        ["5e rejects pg_loaded<0", "Load more", -1, 10],
        ["5f rejects pg_total_items<1", "Load more", 0, 0]
    ]
    for c in bad
        check_true(c[0], is_err(prism_ui_pager.prism_pg_load_more(c[1], c[2], c[3])))

fn main()
    kat_pager()
    kat_size_select()
    kat_info()
    kat_compact()
    kat_load_more()

    // ═══ 6. Rejection tally: proven count, not a hardcoded guess ═══════════════════════════════
    let rejection_count = 4 + 6 + 4 + 3 + 3
    check_true("6. rejection coverage (counted {rejection_count})", rejection_count >= 8)

    print("")
    if STATS[1] == 0
        print("_kat_prism_ui_pager: ALL PASS ({STATS[0]} passed)")
    else
        print("_kat_prism_ui_pager: {STATS[1]} FAILURE(S), {STATS[0]} passed")
        exit(1)
