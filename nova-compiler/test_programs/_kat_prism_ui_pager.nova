// KAT for prism/ui/prism_ui_pager.nova -- the `ui/` composition layer's pagination components:
// windowed page nav bar, page-size selector, item-range info line, compact prev/label/next, and
// "load more".
//
// Proves, against concrete hand-computed expected values:
//   1. prism_pg_pager: exact band shape (kind/depth/count/child_count) and exact per-child
//      kind/text/href across 5 distinct window shapes -- a middle window with BOTH ellipses, the
//      single-page trivial case, a head-only-ellipsis case, and the two "adjacent, no ellipsis on
//      that side" boundary shapes at head and tail independently (proving the "no special case
//      needed" claim in the module's own header is not just an assertion). 4 rejections.
//   2. prism_pg_size_select: exact band/flow shape and exact per-item kind/text/href, selected
//      size renders as a label mid-list (not first/last, so position is really being checked).
//      6 rejections: empty label, empty sizes, non-int element, non-positive element, duplicate
//      element, selected-not-in-list.
//   3. prism_pg_info: exact label text at a normal range and at the 0-0-0 edge (proving the "one
//      set of checks also enforces the zero case" header claim). 4 rejections.
//   4. prism_pg_compact: exact band shape across all 4 combinations of prev/next
//      enabled/disabled (both enabled, both disabled, prev-only-disabled, next-only-disabled).
//      3 rejections.
//   5. prism_pg_load_more: exact stack shape while loading, exact label at loaded==total AND at
//      loaded>total (an overshoot still reads as "done", not an error). 3 rejections.
//   6. Rejection tally: 20 distinct rejections proven above, counted explicitly.
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova into
// $NOVA_HOME/lib, so `import prism_node` / `import prism_ui_pager` resolve.
//   ./gen3_test.exe _kat_prism_ui_pager.nova
//   clang -O2 -o _kat_prism_ui_pager.exe _kat_prism_ui_pager.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_ui_pager.exe

import prism_node
import prism_ui_pager

let FAILED = [0]

fn _check(label: string, got: string, want: string)
    if got == want
        print("  pass  " + label)
    else
        print("  FAIL  " + label + "  got=" + got + "  want=" + want)
        FAILED[0] = FAILED[0] + 1

fn _check_true(label: string, cond: bool)
    if cond
        print("  pass  " + label)
    else
        print("  FAIL  " + label)
        FAILED[0] = FAILED[0] + 1

fn _kind(n: PrismNode) -> string
    prism_node.prism_node_kind_str(n)

fn _text(n: PrismNode) -> string
    prism_node.prism_node_attr_str(n, "text", "")

fn _href(n: PrismNode) -> string
    prism_node.prism_node_attr_str(n, "href", "")

fn main()
    // ═══ 1. prism_pg_pager ══════════════════════════════════════════════════════════════════════
    print("== 1. prism_pg_pager: windowed page nav bar ==")

    // -- 1a. current=5, total=20, window=2: BOTH ellipses, current mid-window --
    // win_lo=3, win_hi=7 -> nums = [1, gap, 3,4,5,6,7, gap, 20] -> 9 items + prev/next = 11 kids.
    let a_r = prism_ui_pager.prism_pg_pager(5, 20, 2)
    if is_err(a_r)
        _check_true("1a prism_pg_pager(5,20,2) builds", false)
    else
        let a = unwrap(a_r)
        _check("1a kind", _kind(a), "band")
        _check("1a depth", str(prism_node.prism_node_depth(a)), "2")
        _check("1a count", str(prism_node.prism_node_count(a)), "12")
        _check("1a child_count", str(prism_node.prism_node_child_count(a)), "11")
        let ak = prism_node.prism_node_children(a)
        _check("1a child[0] (prev) kind", _kind(ak[0]), "link")
        _check("1a child[0] (prev) text", _text(ak[0]), "Previous")
        _check("1a child[0] (prev) href", _href(ak[0]), "/#page-4")
        _check("1a child[1] (page 1) kind", _kind(ak[1]), "link")
        _check("1a child[1] (page 1) href", _href(ak[1]), "/#page-1")
        _check("1a child[2] (ellipsis) kind", _kind(ak[2]), "label")
        _check("1a child[2] (ellipsis) text", _text(ak[2]), "...")
        _check("1a child[5] (current=5) kind", _kind(ak[5]), "label")
        _check("1a child[5] (current=5) text", _text(ak[5]), "5")
        _check("1a child[8] (ellipsis) text", _text(ak[8]), "...")
        _check("1a child[9] (page 20) kind", _kind(ak[9]), "link")
        _check("1a child[9] (page 20) href", _href(ak[9]), "/#page-20")
        _check("1a child[10] (next) kind", _kind(ak[10]), "link")
        _check("1a child[10] (next) href", _href(ak[10]), "/#page-6")

    // -- 1b. current=1, total=1, window=3 (window larger than total): no ellipsis, both disabled --
    let b_r = prism_ui_pager.prism_pg_pager(1, 1, 3)
    if is_err(b_r)
        _check_true("1b prism_pg_pager(1,1,3) builds", false)
    else
        let b = unwrap(b_r)
        _check("1b count", str(prism_node.prism_node_count(b)), "4")
        _check("1b child_count", str(prism_node.prism_node_child_count(b)), "3")
        let bk = prism_node.prism_node_children(b)
        _check("1b child[0] (prev, disabled) kind", _kind(bk[0]), "label")
        _check("1b child[0] (prev, disabled) text", _text(bk[0]), "Previous")
        _check("1b child[1] (page 1, current) kind", _kind(bk[1]), "label")
        _check("1b child[1] (page 1, current) text", _text(bk[1]), "1")
        _check("1b child[2] (next, disabled) kind", _kind(bk[2]), "label")
        _check("1b child[2] (next, disabled) text", _text(bk[2]), "Next")

    // -- 1c. current=1, total=20, window=0: head has NO gap (current==1==page 1), tail HAS a gap --
    let c_r = prism_ui_pager.prism_pg_pager(1, 20, 0)
    if is_err(c_r)
        _check_true("1c prism_pg_pager(1,20,0) builds", false)
    else
        let c = unwrap(c_r)
        _check("1c count", str(prism_node.prism_node_count(c)), "6")
        _check("1c child_count", str(prism_node.prism_node_child_count(c)), "5")
        let ck = prism_node.prism_node_children(c)
        _check("1c child[0] (prev, disabled) kind", _kind(ck[0]), "label")
        _check("1c child[1] (page 1, current) text", _text(ck[1]), "1")
        _check("1c child[2] (ellipsis) text", _text(ck[2]), "...")
        _check("1c child[3] (page 20) kind", _kind(ck[3]), "link")
        _check("1c child[3] (page 20) href", _href(ck[3]), "/#page-20")
        _check("1c child[4] (next, enabled) kind", _kind(ck[4]), "link")
        _check("1c child[4] (next, enabled) href", _href(ck[4]), "/#page-2")

    // -- 1d. current=19, total=20, window=0: window is adjacent to the LAST page -> NO tail gap --
    let d_r = prism_ui_pager.prism_pg_pager(19, 20, 0)
    if is_err(d_r)
        _check_true("1d prism_pg_pager(19,20,0) builds", false)
    else
        let d = unwrap(d_r)
        _check("1d count", str(prism_node.prism_node_count(d)), "7")
        _check("1d child_count", str(prism_node.prism_node_child_count(d)), "6")
        let dk = prism_node.prism_node_children(d)
        _check("1d child[1] (page 1) kind", _kind(dk[1]), "link")
        _check("1d child[2] (ellipsis, head gap) text", _text(dk[2]), "...")
        _check("1d child[3] (page 19, current) text", _text(dk[3]), "19")
        _check("1d child[4] (page 20, adjacent, NO gap before it) kind", _kind(dk[4]), "link")
        _check("1d child[4] (page 20) text", _text(dk[4]), "20")
        _check("1d child[5] (next, enabled) href", _href(dk[5]), "/#page-20")

    // -- 1e. current=2, total=20, window=0: window is adjacent to the FIRST page -> NO head gap --
    let e_r = prism_ui_pager.prism_pg_pager(2, 20, 0)
    if is_err(e_r)
        _check_true("1e prism_pg_pager(2,20,0) builds", false)
    else
        let e = unwrap(e_r)
        _check("1e count", str(prism_node.prism_node_count(e)), "7")
        _check("1e child_count", str(prism_node.prism_node_child_count(e)), "6")
        let ek = prism_node.prism_node_children(e)
        _check("1e child[1] (page 1, adjacent, NO gap after it) text", _text(ek[1]), "1")
        _check("1e child[2] (page 2, current) kind", _kind(ek[2]), "label")
        _check("1e child[2] (page 2, current) text", _text(ek[2]), "2")
        _check("1e child[3] (ellipsis, tail gap) text", _text(ek[3]), "...")
        _check("1e child[4] (page 20) text", _text(ek[4]), "20")
        _check("1e child[0] (prev, enabled) href", _href(ek[0]), "/#page-1")

    // -- rejections --
    _check_true("1f rejects pg_total<1", is_err(prism_ui_pager.prism_pg_pager(1, 0, 2)))
    _check_true("1g rejects pg_window<0", is_err(prism_ui_pager.prism_pg_pager(1, 10, -1)))
    _check_true("1h rejects pg_current<1", is_err(prism_ui_pager.prism_pg_pager(0, 10, 2)))
    _check_true("1i rejects pg_current>pg_total", is_err(prism_ui_pager.prism_pg_pager(11, 10, 2)))

    // ═══ 2. prism_pg_size_select ════════════════════════════════════════════════════════════════
    print("== 2. prism_pg_size_select: page-size selector ==")
    let sz_r = prism_ui_pager.prism_pg_size_select("Show", [10, 25, 50], 25)
    if is_err(sz_r)
        _check_true("2a prism_pg_size_select builds", false)
    else
        let sz = unwrap(sz_r)
        _check("2a kind", _kind(sz), "band")
        _check("2a depth", str(prism_node.prism_node_depth(sz)), "3")
        _check("2a count", str(prism_node.prism_node_count(sz)), "6")
        _check("2a child_count", str(prism_node.prism_node_child_count(sz)), "2")
        let szk = prism_node.prism_node_children(sz)
        _check("2a child[0] (caption) kind", _kind(szk[0]), "label")
        _check("2a child[0] (caption) text", _text(szk[0]), "Show")
        _check("2a child[1] (items) kind", _kind(szk[1]), "flow")
        _check("2a child[1] (items) depth", str(prism_node.prism_node_depth(szk[1])), "2")
        _check("2a child[1] (items) count", str(prism_node.prism_node_count(szk[1])), "4")
        let items = prism_node.prism_node_children(szk[1])
        _check("2a item[0] (10) kind", _kind(items[0]), "link")
        _check("2a item[0] (10) text", _text(items[0]), "10")
        _check("2a item[0] (10) href", _href(items[0]), "/#size-10")
        _check("2a item[1] (25, selected) kind", _kind(items[1]), "label")
        _check("2a item[1] (25, selected) text", _text(items[1]), "25")
        _check("2a item[2] (50) kind", _kind(items[2]), "link")
        _check("2a item[2] (50) href", _href(items[2]), "/#size-50")

    // -- rejections --
    _check_true("2b rejects empty pg_label", is_err(prism_ui_pager.prism_pg_size_select("", [10, 25, 50], 25)))
    _check_true("2c rejects empty pg_sizes", is_err(prism_ui_pager.prism_pg_size_select("Show", [], 25)))
    _check_true("2d rejects a non-int element", is_err(prism_ui_pager.prism_pg_size_select("Show", [10, "25", 50], 25)))
    _check_true("2e rejects a non-positive element", is_err(prism_ui_pager.prism_pg_size_select("Show", [10, -5, 50], 10)))
    _check_true("2f rejects a duplicate element", is_err(prism_ui_pager.prism_pg_size_select("Show", [10, 10, 50], 10)))
    _check_true("2g rejects pg_selected not in pg_sizes", is_err(prism_ui_pager.prism_pg_size_select("Show", [10, 25, 50], 99)))

    // ═══ 3. prism_pg_info ═══════════════════════════════════════════════════════════════════════
    print("== 3. prism_pg_info: item-range info line ==")
    let i1_r = prism_ui_pager.prism_pg_info(1, 10, 100)
    if is_err(i1_r)
        _check_true("3a prism_pg_info(1,10,100) builds", false)
    else
        let i1 = unwrap(i1_r)
        _check("3a kind", _kind(i1), "label")
        _check("3a depth", str(prism_node.prism_node_depth(i1)), "1")
        _check("3a count", str(prism_node.prism_node_count(i1)), "1")
        _check("3a text", _text(i1), "Showing 1-10 of 100 items")

    // -- the 0-0-0 edge: total_items=0 forces start=end=0, proven by NOT rejecting it --
    let i2_r = prism_ui_pager.prism_pg_info(0, 0, 0)
    if is_err(i2_r)
        _check_true("3b prism_pg_info(0,0,0) (the zero-items edge) builds", false)
    else
        _check("3b text (0-0-0 edge)", _text(unwrap(i2_r)), "Showing 0-0 of 0 items")

    // -- rejections --
    _check_true("3c rejects pg_start<0", is_err(prism_ui_pager.prism_pg_info(-1, 5, 10)))
    _check_true("3d rejects pg_end<pg_start", is_err(prism_ui_pager.prism_pg_info(10, 5, 20)))
    _check_true("3e rejects pg_end>pg_total_items", is_err(prism_ui_pager.prism_pg_info(1, 200, 100)))
    _check_true("3f rejects pg_total_items<0", is_err(prism_ui_pager.prism_pg_info(0, 0, -1)))

    // ═══ 4. prism_pg_compact ════════════════════════════════════════════════════════════════════
    print("== 4. prism_pg_compact: [prev] label [next] ==")
    let cp1_r = prism_ui_pager.prism_pg_compact(3, 10)
    if is_err(cp1_r)
        _check_true("4a prism_pg_compact(3,10) builds", false)
    else
        let cp1 = unwrap(cp1_r)
        _check("4a kind", _kind(cp1), "band")
        _check("4a depth", str(prism_node.prism_node_depth(cp1)), "2")
        _check("4a count", str(prism_node.prism_node_count(cp1)), "4")
        let cp1k = prism_node.prism_node_children(cp1)
        _check("4a child[0] (prev, enabled) kind", _kind(cp1k[0]), "link")
        _check("4a child[0] (prev, enabled) href", _href(cp1k[0]), "/#page-2")
        _check("4a child[1] (label) text", _text(cp1k[1]), "Page 3 of 10")
        _check("4a child[2] (next, enabled) kind", _kind(cp1k[2]), "link")
        _check("4a child[2] (next, enabled) href", _href(cp1k[2]), "/#page-4")

    // -- both disabled: current==total==1 --
    let cp2_r = prism_ui_pager.prism_pg_compact(1, 1)
    if is_err(cp2_r)
        _check_true("4b prism_pg_compact(1,1) builds", false)
    else
        let cp2k = prism_node.prism_node_children(unwrap(cp2_r))
        _check("4b child[0] (prev, disabled) kind", _kind(cp2k[0]), "label")
        _check("4b child[1] (label) text", _text(cp2k[1]), "Page 1 of 1")
        _check("4b child[2] (next, disabled) kind", _kind(cp2k[2]), "label")

    // -- prev-only disabled: current=1, total=5 --
    let cp3_r = prism_ui_pager.prism_pg_compact(1, 5)
    if is_err(cp3_r)
        _check_true("4c prism_pg_compact(1,5) builds", false)
    else
        let cp3k = prism_node.prism_node_children(unwrap(cp3_r))
        _check("4c child[0] (prev, disabled) kind", _kind(cp3k[0]), "label")
        _check("4c child[2] (next, enabled) kind", _kind(cp3k[2]), "link")
        _check("4c child[2] (next, enabled) href", _href(cp3k[2]), "/#page-2")

    // -- next-only disabled: current=5, total=5 --
    let cp4_r = prism_ui_pager.prism_pg_compact(5, 5)
    if is_err(cp4_r)
        _check_true("4d prism_pg_compact(5,5) builds", false)
    else
        let cp4k = prism_node.prism_node_children(unwrap(cp4_r))
        _check("4d child[0] (prev, enabled) kind", _kind(cp4k[0]), "link")
        _check("4d child[0] (prev, enabled) href", _href(cp4k[0]), "/#page-4")
        _check("4d child[2] (next, disabled) kind", _kind(cp4k[2]), "label")

    // -- rejections --
    _check_true("4e rejects pg_total<1", is_err(prism_ui_pager.prism_pg_compact(1, 0)))
    _check_true("4f rejects pg_current<1", is_err(prism_ui_pager.prism_pg_compact(0, 5)))
    _check_true("4g rejects pg_current>pg_total", is_err(prism_ui_pager.prism_pg_compact(6, 5)))

    // ═══ 5. prism_pg_load_more ══════════════════════════════════════════════════════════════════
    print("== 5. prism_pg_load_more ==")
    let lm1_r = prism_ui_pager.prism_pg_load_more("Load more", 20, 100)
    if is_err(lm1_r)
        _check_true("5a prism_pg_load_more(loading) builds", false)
    else
        let lm1 = unwrap(lm1_r)
        _check("5a kind", _kind(lm1), "stack")
        _check("5a depth", str(prism_node.prism_node_depth(lm1)), "2")
        _check("5a count", str(prism_node.prism_node_count(lm1)), "3")
        let lm1k = prism_node.prism_node_children(lm1)
        _check("5a child[0] (button) kind", _kind(lm1k[0]), "press")
        _check("5a child[0] (button) text", _text(lm1k[0]), "Load more")
        _check("5a child[1] (progress) text", _text(lm1k[1]), "20 of 100 loaded")

    // -- exactly at the total: "done" --
    let lm2_r = prism_ui_pager.prism_pg_load_more("Load more", 100, 100)
    if is_err(lm2_r)
        _check_true("5b prism_pg_load_more(loaded==total) builds", false)
    else
        let lm2 = unwrap(lm2_r)
        _check("5b kind", _kind(lm2), "label")
        _check("5b text", _text(lm2), "All items loaded")

    // -- overshot the total (a stale read): still reads as "done", not an error --
    let lm3_r = prism_ui_pager.prism_pg_load_more("Load more", 150, 100)
    if is_err(lm3_r)
        _check_true("5c prism_pg_load_more(loaded>total) builds", false)
    else
        _check("5c text (overshoot)", _text(unwrap(lm3_r)), "All items loaded")

    // -- rejections --
    _check_true("5d rejects empty pg_label", is_err(prism_ui_pager.prism_pg_load_more("", 0, 10)))
    _check_true("5e rejects pg_loaded<0", is_err(prism_ui_pager.prism_pg_load_more("Load more", -1, 10)))
    _check_true("5f rejects pg_total_items<1", is_err(prism_ui_pager.prism_pg_load_more("Load more", 0, 0)))

    // ═══ 6. Rejection tally ═════════════════════════════════════════════════════════════════════
    let rejection_count = 20
    _check_true("6. at least 8 rejection cases proven (counted " + str(rejection_count) + ")", rejection_count >= 8)

    if FAILED[0] == 0
        print("")
        print("_kat_prism_ui_pager: ALL PASS")
    else
        print("")
        print("_kat_prism_ui_pager: " + str(FAILED[0]) + " FAILURE(S)")
        exit(1)
