import std/typesystem/type_subst

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

// ckt: structural equality by deep comparison of the type lists
fn _type_eq(a, b) -> int
    let ta = type_of(a)
    let tb = type_of(b)
    if ta != tb
        return 0
    if ta == "int"
        if a == b
            return 1
        return 0
    if ta == "string"
        if a == b
            return 1
        return 0
    if ta == "list"
        if len(a) != len(b)
            return 0
        let i = 0
        while i < len(a)
            let r = _type_eq(a[i], b[i])
            if r == 0
                return 0
            i = i + 1
        return 1
    return 0

fn ckt(label, got, expected)
    let eq = _type_eq(got, expected)
    if eq == 0
        print("FAIL " + label + ": types not structurally equal")
        exit(1)

fn main()
    // Helper constructors (inline since we're in test context)
    // Build types using the module's raw lists for comparison

    // KAT 1: tsub_apply(tsub_single(0, int), tvar(0)) == int
    let sub0_int = type_subst.tsub_single(0, ["con", "int", []])
    let tv0 = ["tvar", 0]
    let res1 = type_subst.tsub_apply(sub0_int, tv0)
    ckt("apply_tv0_to_int", res1, ["con", "int", []])

    // KAT 2: tsub_apply(tsub_single(0, int), tvar(1)) == tvar(1)
    let tv1 = ["tvar", 1]
    let res2 = type_subst.tsub_apply(sub0_int, tv1)
    ckt("apply_tv1_unchanged", res2, ["tvar", 1])

    // KAT 3: tsub_apply(tsub_single(0, int), arr(tvar(0), tvar(1))) == arr(int, tvar(1))
    let arr01 = ["arr", ["tvar", 0], ["tvar", 1]]
    let res3 = type_subst.tsub_apply(sub0_int, arr01)
    ckt("apply_arr_0_1", res3, ["arr", ["con", "int", []], ["tvar", 1]])

    // KAT 4: compose then apply — (0->1) compose (1->bool) applied to tvar(0) == bool
    // s1 = {0 -> tvar(1)}, s2 = {1 -> bool}
    // compose(s2, s1) should give: 0 -> bool (and also 1 -> bool)
    let s1 = type_subst.tsub_single(0, ["tvar", 1])
    let s2 = type_subst.tsub_single(1, ["con", "bool", []])
    let composed = type_subst.tsub_compose(s2, s1)
    let res4 = type_subst.tsub_apply(composed, ["tvar", 0])
    ckt("compose_0to1_1tobool", res4, ["con", "bool", []])

    // KAT 5: tsub_empty() has no bindings
    let empty = type_subst.tsub_empty()
    cki("empty_len", len(empty), 0)

    // KAT 6: tsub_lookup finds bound key
    let sub_lookup = type_subst.tsub_single(7, ["con", "int", []])
    let found = type_subst.tsub_lookup(sub_lookup, 7)
    ckt("lookup_found", found, ["con", "int", []])

    // KAT 7: tsub_lookup returns "NOTFOUND" for missing key
    let nf = type_subst.tsub_lookup(sub_lookup, 99)
    cki("lookup_notfound", nf, "NOTFOUND")

    // KAT 8: tsub_apply_env applies to every type in env
    let env = []
    let e1 = ["x", ["tvar", 0]]
    let e2 = ["y", ["tvar", 1]]
    push(env, e1)
    push(env, e2)
    let sub_env = type_subst.tsub_single(0, ["con", "int", []])
    let env2 = type_subst.tsub_apply_env(sub_env, env)
    ckt("apply_env_x", env2[0][1], ["con", "int", []])
    ckt("apply_env_y", env2[1][1], ["tvar", 1])

    // KAT 9: compose is associative in effect — (s3 after s2) after s1
    // s1={0->tvar(1)}, s2={1->tvar(2)}, s3={2->int}
    // Expected: apply(compose(compose(s3,s2),s1), tvar(0)) = int
    let sA = type_subst.tsub_single(0, ["tvar", 1])
    let sB = type_subst.tsub_single(1, ["tvar", 2])
    let sC = type_subst.tsub_single(2, ["con", "int", []])
    let sBC = type_subst.tsub_compose(sC, sB)
    let sABC = type_subst.tsub_compose(sBC, sA)
    let res9 = type_subst.tsub_apply(sABC, ["tvar", 0])
    ckt("compose_chain", res9, ["con", "int", []])

    // KAT 10: apply on con with args substitutes inside
    let list_tv0 = ["con", "list", [["tvar", 0]]]
    let res10 = type_subst.tsub_apply(sub0_int, list_tv0)
    ckt("apply_con_args", res10, ["con", "list", [["con", "int", []]]])

    print("PASS _type_subst_test")

main()
