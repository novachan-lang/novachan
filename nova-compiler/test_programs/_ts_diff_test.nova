import std/math/ts_diff

fn approx(a: float, b: float, tol: float) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < tol
        return 1
    return 0

fn ck_list(label: str, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + " len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        let g = got[i] * 1.0
        let w = want[i] * 1.0
        if approx(g, w, 0.0001) == 0
            print("FAIL " + label + " idx=" + str(i) + " got=" + str(g) + " want=" + str(w))
            exit(1)
        i = i + 1

fn main()
    // KAT 1: ts_diff([1.0,3.0,6.0,10.0]) == [2.0,3.0,4.0]
    let d1 = [1.0, 3.0, 6.0, 10.0]
    let r1 = ts_diff(d1)
    let w1 = [2.0, 3.0, 4.0]
    ck_list("ts_diff basic", r1, w1)

    // KAT 2: ts_diff([5.0,5.0,5.0]) == [0.0,0.0]
    let d2 = [5.0, 5.0, 5.0]
    let r2 = ts_diff(d2)
    let w2 = [0.0, 0.0]
    ck_list("ts_diff constant", r2, w2)

    // KAT 3: ts_diff([]) == []
    let d3 = []
    let r3 = ts_diff(d3)
    ck_list("ts_diff empty", r3, [])

    // KAT 4: ts_diff([42.0]) == []
    let d4 = [42.0]
    let r4 = ts_diff(d4)
    ck_list("ts_diff single", r4, [])

    // KAT 5: ts_diff_n([1.0,3.0,6.0,10.0], 2) == [1.0,1.0]
    // 1st diff: [2.0,3.0,4.0]; 2nd diff: [1.0,1.0]
    let d5 = [1.0, 3.0, 6.0, 10.0]
    let r5 = ts_diff_n(d5, 2)
    let w5 = [1.0, 1.0]
    ck_list("ts_diff_n order2", r5, w5)

    // KAT 6: ts_diff_n(data, 1) == ts_diff(data)
    let d6 = [1.0, 3.0, 6.0, 10.0]
    let r6a = ts_diff_n(d6, 1)
    let r6b = ts_diff(d6)
    ck_list("ts_diff_n order1 matches ts_diff", r6a, r6b)

    // KAT 7: ts_diff_n(data, 0) == data (as floats)
    let d7 = [2.0, 4.0, 8.0]
    let r7 = ts_diff_n(d7, 0)
    let w7 = [2.0, 4.0, 8.0]
    ck_list("ts_diff_n order0 identity", r7, w7)

    // KAT 8: ts_diff_n(data, order >= len) -> []
    let d8 = [1.0, 2.0]
    let r8 = ts_diff_n(d8, 3)
    ck_list("ts_diff_n order_exceeds_len", r8, [])

    // KAT 9: descending differences
    let d9 = [10.0, 7.0, 3.0]
    let r9 = ts_diff(d9)
    let w9 = [-3.0, -4.0]
    ck_list("ts_diff descending", r9, w9)

    print("PASS _ts_diff_test")
