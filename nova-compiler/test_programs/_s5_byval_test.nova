// _s5_byval_test.nova — by-value struct ABI correctness canary
// Tests: field reads, float precision, int boundary values, multi-param.
// NOTE: does NOT test callee-mutation-visibility (that changes semantics
// under by-value ABI by design — the callee gets a copy).

type Vec2
    x: float
    y: float

type Trio
    a: int
    b: float
    c: int

// Leaf: reads fields and returns a float (dot product)
fn dot(a: Vec2, b: Vec2) -> float
    a.x * b.x + a.y * b.y

// Leaf: reads mixed fields
fn trio_sum(t: Trio) -> float
    let fi = 0.0
    if t.c == 1
        fi = 1.0
    float(t.a) + t.b + fi

// Multi-param: all scalars read and combined
fn combine(v: Vec2, t: Trio) -> float
    v.x + v.y + float(t.a) + t.b

// Int at boundary
fn int_boundary(t: Trio) -> int
    t.a

// Multiple calls to same fn (use-set must see identical S)
fn double_dot(a: Vec2, b: Vec2) -> float
    let d1 = dot(a, b)
    let d2 = dot(b, a)
    d1 + d2

fn main()
    // Basic dot product
    let a = Vec2(3.0, 4.0)
    let b = Vec2(5.0, 6.0)
    let d = dot(a, b)
    print(d)

    // Trio mixed (c=1 -> true branch)
    let t = Trio(10, 2.5, 1)
    let ts = trio_sum(t)
    print(ts)

    // Trio mixed (c=0 -> false branch)
    let tf = Trio(5, 3.0, 0)
    let tsf = trio_sum(tf)
    print(tsf)

    // Multi-param cross-struct
    let cm = combine(Vec2(1.0, 2.0), Trio(100, 0.5, 0))
    print(cm)

    // Int boundary (large int)
    let tb = Trio(4611686018427387903, 0.0, 0)
    let ib = int_boundary(tb)
    print(ib)

    // Negative float
    let neg = dot(Vec2(-1.5, -2.5), Vec2(3.0, 4.0))
    print(neg)

    // Double-call (same fn called twice with same type)
    let dd = double_dot(Vec2(1.0, 0.0), Vec2(0.0, 1.0))
    print(dd)

    // Zero
    let z = dot(Vec2(0.0, 0.0), Vec2(999.0, 999.0))
    print(z)

    print("s5_byval_test_done")
