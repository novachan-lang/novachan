import forge_deploy_tracker

fn main()
    let d = dt_new()
    d = dt_deploy(d, "v1.0", 1000)
    d = dt_deploy(d, "v1.1", 2000)
    assert(dt_deploy_count(d) == 2, "2 deploys")

    let c = dt_current(d)
    assert(is_ok(c), "current ok")
    assert(unwrap(c) == "v1.1", "current v1.1")

    let r = dt_rollback(d)
    assert(is_ok(r), "rollback ok")
    d = unwrap(r)
    assert(dt_rollback_count(d) == 1, "1 rollback")

    let c2 = dt_current(d)
    assert(is_ok(c2), "current after rollback")
    assert(unwrap(c2) == "v1.0", "rolled back to v1.0")

    assert(dt_success_rate(d) == 50, "50% success rate")

    let r2 = dt_rollback(d)
    assert(is_err(r2), "no more rollbacks")

    print("DEPLOY-TRACKER KAT PASS")
