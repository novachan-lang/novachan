import forge_security_headers

fn main()
    // Basic headers without HSTS
    let h = security_headers(0, "DENY")
    assert(h["X-Content-Type-Options"] == "nosniff", "nosniff")
    assert(h["X-Frame-Options"] == "DENY", "frame deny")
    assert(h["X-XSS-Protection"] == "0", "xss off")
    assert("Strict-Transport-Security" not in h, "no hsts when 0")

    // With HSTS
    let h2 = security_headers(31536000, "SAMEORIGIN")
    assert("Strict-Transport-Security" in h2, "hsts present")
    assert(h2["X-Frame-Options"] == "SAMEORIGIN", "sameorigin")

    // Strict defaults
    let h3 = security_headers_strict()
    assert("Permissions-Policy" in h3, "strict has permissions")
    assert(h3["X-Frame-Options"] == "DENY", "strict denies frames")

    // apply_headers merges
    let target = {"Content-Type": "text/html"}
    let merged = apply_headers(target, h)
    assert("Content-Type" in merged, "kept existing")
    assert("X-Content-Type-Options" in merged, "added security")

    print("SECURITY-HEADERS KAT PASS")
