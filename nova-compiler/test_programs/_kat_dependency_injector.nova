import forge_dependency_injector

fn main()
    let di = di_new()
    assert(di_service_count(di) == 0, "starts empty")

    di = di_register(di, "db", "postgres://localhost")
    di = di_register(di, "cache", "redis://localhost")
    assert(di_service_count(di) == 2, "2 services")
    assert(di_has(di, "db") == 1, "has db")
    assert(di_has(di, "missing") == 0, "no missing")

    let r1 = di_resolve(di, "db")
    di = r1["di"]
    assert(r1["found"] == 1, "db found")
    assert(r1["value"] == "postgres://localhost", "db value")
    assert(di_total_resolves(di) == 1, "1 resolve")

    di = di_register_singleton(di, "logger", "file:///var/log")
    assert(di_is_singleton(di, "logger") == 1, "logger is singleton")
    assert(di_is_singleton(di, "db") == 0, "db not singleton")

    let r2 = di_resolve(di, "missing")
    di = r2["di"]
    assert(r2["found"] == 0, "missing not found")
    assert(di_total_resolves(di) == 1, "still 1 resolve")

    di = di_remove(di, "cache")
    assert(di_service_count(di) == 2, "2 after remove cache")
    assert(di_has(di, "cache") == 0, "cache removed")

    print("DEPENDENCY-INJECTOR KAT PASS")
