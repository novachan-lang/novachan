import std/crypto/pwentropy

fn approx(a: float, b: float, tol: float) -> bool
    let diff = a - b
    if diff < 0.0
        diff = 0.0 - diff
    diff < tol

fn assert_int(label: string, got: int, want: int)
    if got != want
        print("FAIL pwentropy " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn assert_bool(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL pwentropy " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn assert_str(label: string, got: string, want: string)
    if got != want
        print("FAIL pwentropy " + label + ": got=" + got + " want=" + want)
        exit(1)

fn assert_approx(label: string, got: float, want: float, tol: float)
    if not approx(got, want, tol)
        print("FAIL pwentropy " + label + ": not close enough")
        exit(1)

fn main()
    // pw_charset_size
    assert_int("charset_lower", pw_charset_size("abc"), 26)
    assert_int("charset_mixed", pw_charset_size("Abc"), 52)
    assert_int("charset_alnum", pw_charset_size("Abc1"), 62)
    assert_int("charset_full", pw_charset_size("Abc1!"), 95)

    // pw_entropy_bits: 'aaaaaaaa' => 8 * log2(26) = ~37.6035
    let e_aaa = pw_entropy_bits("aaaaaaaa")
    assert_approx("entropy_8lower", e_aaa, 37.6035, 0.1)

    // pw_diversity_score
    assert_int("diversity_full", pw_diversity_score("Abc1!"), 4)
    assert_int("diversity_lower", pw_diversity_score("abc"), 1)

    // pw_is_common
    assert_bool("common_password", pw_is_common("password"), true)
    assert_bool("common_strong", pw_is_common("Xk9$mLp2vQ"), false)

    // pw_has_sequence
    assert_bool("seq_abc", pw_has_sequence("abcXYZ"), true)
    assert_bool("seq_no", pw_has_sequence("random"), false)

    // pw_has_repeat
    assert_bool("repeat_aaa", pw_has_repeat("aaa123"), true)
    assert_bool("repeat_no", pw_has_repeat("ab1cd2"), false)

    // pw_crack_label
    assert_str("label_instant", pw_crack_label(20.0), "instant")
    assert_str("label_verystrong", pw_crack_label(130.0), "very strong")
    assert_str("label_weak", pw_crack_label(30.0), "weak")
    assert_str("label_reasonable", pw_crack_label(50.0), "reasonable")
    assert_str("label_strong", pw_crack_label(80.0), "strong")

    // pw_adjusted_entropy: 'password' is common so adjusted < base
    let base_e = pw_entropy_bits("password")
    let adj_e = pw_adjusted_entropy("password")
    if not (adj_e < base_e)
        print("FAIL pwentropy adjusted_lt_base: adjusted should be less than base for 'password'")
        exit(1)

    // pw_adjusted_entropy with all penalties: 'abc123' has sequence + maybe common
    let adj2 = pw_adjusted_entropy("abc123")
    if adj2 < 0.0
        print("FAIL pwentropy adjusted_floor: should not be negative")
        exit(1)

    // round-trip: pw_strength_score is 0..100
    let sc1 = pw_strength_score("password")
    if sc1 < 0 or sc1 > 100
        print("FAIL pwentropy score_range password: got=" + str(sc1))
        exit(1)
    let sc2 = pw_strength_score("Xk9$mLp2vQ!!SuperLong#2026")
    if sc2 < 0 or sc2 > 100
        print("FAIL pwentropy score_range strong: got=" + str(sc2))
        exit(1)

    // pw_min_length_for_bits: for charset_size=95 to reach 128 bits
    let ml = pw_min_length_for_bits(128, 95)
    if ml < 1 or ml > 30
        print("FAIL pwentropy min_length_range: got=" + str(ml))
        exit(1)

    // pw_shannon_bits: all same chars -> 0 entropy per symbol = 0 total
    let sh_same = pw_shannon_bits("aaaa")
    if not approx(sh_same, 0.0, 0.001)
        print("FAIL pwentropy shannon_same: got non-zero for all-same chars")
        exit(1)

    // pw_shannon_bits: diverse password has positive entropy
    let sh_div = pw_shannon_bits("abcdefghij")
    if sh_div <= 0.0
        print("FAIL pwentropy shannon_diverse: should be positive")
        exit(1)

    // empty password edge cases
    assert_int("charset_empty", pw_charset_size(""), 0)
    let empty_e = pw_entropy_bits("")
    if not approx(empty_e, 0.0, 0.001)
        print("FAIL pwentropy entropy_empty: should be 0.0")
        exit(1)

    print("PASS _pwentropy_test")
