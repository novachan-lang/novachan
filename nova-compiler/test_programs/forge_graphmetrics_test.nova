import forge_graphmetrics

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn near(a: float, b: float) -> bool
    let d = a - b
    d > -0.001 and d < 0.001

fn join_ints(lst) -> string
    let parts = []
    let i = 0
    while i < len(lst)
        push(parts, str(lst[i]))
        i = i + 1
    join(parts, ",")

fn main()
    let fails = 0

    // triangle: each node degree 2, complete -> density 1
    let tri = [["a", "b"], ["b", "c"], ["c", "a"]]
    fails = fails + expect("tri_seq", join_ints(degree_sequence(tri)), "2,2,2")
    fails = fails + expect("tri_maxdeg", str(max_degree(tri)), "2")
    fails = fails + expect_true("tri_density", near(graph_density(tri), 1.0))
    fails = fails + expect_true("tri_avg", near(avg_degree(tri), 2.0))

    // path a-b-c: degrees a=1,b=2,c=1 -> sequence [2,1,1]
    let path = [["a", "b"], ["b", "c"]]
    fails = fails + expect("path_seq", join_ints(degree_sequence(path)), "2,1,1")
    fails = fails + expect("path_b_deg", str(node_degree(path, "b")), "2")
    fails = fails + expect("path_a_deg", str(node_degree(path, "a")), "1")
    fails = fails + expect("path_maxdeg", str(max_degree(path)), "2")
    fails = fails + expect("path_mindeg", str(min_degree(path)), "1")
    // density 2*2/(3*2) = 0.6667
    fails = fails + expect_true("path_density", near(graph_density(path), 0.66667))

    // star: hub degree 4, leaves degree 1 -> [4,1,1,1,1]
    let star = [["h", "a"], ["h", "b"], ["h", "c"], ["h", "d"]]
    fails = fails + expect("star_seq", join_ints(degree_sequence(star)), "4,1,1,1,1")
    fails = fails + expect("star_hub_deg", str(node_degree(star, "h")), "4")

    // complete K4: all degree 3, density 1
    let k4 = [["a", "b"], ["a", "c"], ["a", "d"], ["b", "c"], ["b", "d"], ["c", "d"]]
    fails = fails + expect("k4_seq", join_ints(degree_sequence(k4)), "3,3,3,3")
    fails = fails + expect_true("k4_density", near(graph_density(k4), 1.0))

    // sparse graph density < 1
    let sparse = [["a", "b"], ["c", "d"], ["e", "f"]]
    fails = fails + expect_true("sparse_density", graph_density(sparse) < 0.5)

    // unknown node degree 0
    fails = fails + expect("unknown_deg", str(node_degree(tri, "zzz")), "0")

    if fails == 0
        print("forge_graphmetrics: all passed")
    else
        print("forge_graphmetrics: " + str(fails) + " FAILED")
