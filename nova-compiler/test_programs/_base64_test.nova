import std/encoding/base64

// Helper: build a `bytes` value from a plain ASCII string.
// Uses ord(char_at) so 0x00 is safe (we test it explicitly below).
fn _bytes(s) -> any
    let b = bytes(0)
    let i = 0
    let n = len(s)
    while i < n
        let ch = s[i]
        let bv = ord(ch)
        b = bytes_append(b, bv)
        i = i + 1
    b

// Helpers: build a bytes value containing arbitrary byte values.
fn _bytes2(v0, v1) -> any
    let b = bytes(0)
    b = bytes_append(b, v0)
    b = bytes_append(b, v1)
    b

fn _bytes3(v0, v1, v2) -> any
    let b = bytes(0)
    b = bytes_append(b, v0)
    b = bytes_append(b, v1)
    b = bytes_append(b, v2)
    b

fn _bytes4(v0, v1, v2, v3) -> any
    let b = bytes(0)
    b = bytes_append(b, v0)
    b = bytes_append(b, v1)
    b = bytes_append(b, v2)
    b = bytes_append(b, v3)
    b

// Check bytes equality byte-by-byte.
fn _bytes_eq(a, b) -> int
    let na = bytes_len(a)
    let nb = bytes_len(b)
    if na != nb
        return 0
    let i = 0
    while i < na
        if bytes_get(a, i) != bytes_get(b, i)
            return 0
        i = i + 1
    1

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn ckb(label, got, want)
    if _bytes_eq(got, want) == 0
        print("FAIL " + label + ": bytes mismatch")
        exit(1)

fn main()
    // ── KAT 1: RFC 4648 §10 standard vectors ─────────────────────────────────
    // "Man" -> "TWFu"  (3 bytes, no padding)
    cks("encode_Man",  b64_encode(_bytes("Man")), "TWFu")

    // "Ma" -> "TWE="   (2 bytes, 1 pad)
    cks("encode_Ma",   b64_encode(_bytes("Ma")),  "TWE=")

    // "M" -> "TQ=="    (1 byte, 2 pad)
    cks("encode_M",    b64_encode(_bytes("M")),   "TQ==")

    // "" -> ""          (empty)
    cks("encode_empty", b64_encode(_bytes("")),   "")

    // ── KAT 2: decode the RFC vectors back ───────────────────────────────────
    ckb("decode_TWFu", b64_decode("TWFu"), _bytes("Man"))
    ckb("decode_TWE=", b64_decode("TWE="), _bytes("Ma"))
    ckb("decode_TQ==", b64_decode("TQ=="), _bytes("M"))
    ckb("decode_empty", b64_decode(""), _bytes(""))

    // ── KAT 3: round-trip with 0x00 and 0xFF (binary-safety) ─────────────────
    // Payload: [0x00, 0xFF, 0x41, 0x42]  (0x00 = NUL, 0xFF = all-bits-set, "AB")
    let payload = _bytes4(0, 255, 65, 66)
    let encoded = b64_encode(payload)
    let decoded = b64_decode(encoded)
    ckb("roundtrip_0x00_0xFF", decoded, payload)

    // ── KAT 4: URL-safe alphabet replaces +/ with -_ (no padding) ────────────
    // Bytes that produce '+' and '/' in standard base64:
    // Standard "+" appears at index 62 (bits 111110), "/" at index 63 (bits 111111).
    // A 3-byte group [0xFB, 0xFF, 0xFF] splits as:
    //   bits: 11111011 11111111 11111111
    //   6-bit groups: 111110 111111 111111 111111
    //   indices: 62 63 63 63  => "+///" in standard, "-___" in URL-safe
    let plus_slash = _bytes3(0xFB, 0xFF, 0xFF)
    cks("encode_url_minusunderscore", b64_encode_url(plus_slash), "-___")
    // Standard would be "+///" — verify standard and URL differ
    cks("encode_std_plusslash", b64_encode(plus_slash), "+///")

    // ── KAT 5: URL-safe round-trip ────────────────────────────────────────────
    let url_payload = _bytes4(0xFB, 0xFF, 0x00, 0x41)
    let url_encoded = b64_encode_url(url_payload)
    let url_decoded = b64_decode_url(url_encoded)
    ckb("roundtrip_url", url_decoded, url_payload)

    // ── KAT 6: a longer known payload — "Hello, World!" ─────────────────────
    // RFC hand-computed: "Hello, World!" = 72 65 6c 6c 6f 2c 20 57 6f 72 6c 64 21
    // Groups of 3: [H,e,l]=>[SGVs] [l,o,,]=>[bG8s] [_,W,o]=>[IFdv] [r,l,d]=>[cmxk] [!]=>[IQ==]
    // Wait, let me recompute precisely:
    // H(72)=0x48 e(101)=0x65 l(108)=0x6C: 010010 000110 010101 101100 => S G V s => "SGVs"?
    // Actually: 72=01001000 101=01100101 108=01101100
    //   bits: 010010 000110 010101 101100 => 18,6,21,44 => S,G,V,s => "SGVs" ✓ (nope, 'l' not 's')
    // Let me use the known standard result: "SGVsbG8sIFdvcmxkIQ=="
    cks("encode_hello_world", b64_encode(_bytes("Hello, World!")), "SGVsbG8sIFdvcmxkIQ==")
    ckb("decode_hello_world", b64_decode("SGVsbG8sIFdvcmxkIQ=="), _bytes("Hello, World!"))

    print("_base64_test passed")
