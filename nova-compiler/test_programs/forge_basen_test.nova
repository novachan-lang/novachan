import forge_basen

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn main()
    let fails = 0

    // to_base known values
    fails = fails + expect("bin_10", to_base(10, 2), "1010")
    fails = fails + expect("hex_255", to_base(255, 16), "ff")
    fails = fails + expect("oct_8", to_base(8, 8), "10")
    fails = fails + expect("base36_1295", to_base(1295, 36), "zz")
    fails = fails + expect("dec_123", to_base(123, 10), "123")
    fails = fails + expect("zero", to_base(0, 16), "0")
    fails = fails + expect("neg", to_base(0 - 255, 16), "-ff")

    // from_base known values
    fails = fails + expect("from_bin", str(from_base("1010", 2)), "10")
    fails = fails + expect("from_hex", str(from_base("ff", 16)), "255")
    fails = fails + expect("from_hex_upper", str(from_base("FF", 16)), "255")
    fails = fails + expect("from_base36", str(from_base("zz", 36)), "1295")
    fails = fails + expect("from_neg", str(from_base("-ff", 16)), "-255")
    fails = fails + expect("from_zero", str(from_base("0", 10)), "0")

    // roundtrip over many numbers and bases
    let rt_ok = true
    let base = 2
    while base <= 36
        let n = 0
        while n < 1000
            if from_base(to_base(n, base), base) != n
                rt_ok = false
            n = n + 137
        base = base + 3
    fails = fails + expect_true("roundtrip", rt_ok)

    // negative roundtrip
    fails = fails + expect_true("neg_roundtrip", from_base(to_base(0 - 98765, 16), 16) == 0 - 98765)

    // hex of a big number
    fails = fails + expect("hex_big", to_base(1000000, 16), "f4240")
    fails = fails + expect("from_hex_big", str(from_base("f4240", 16)), "1000000")

    if fails == 0
        print("forge_basen: all passed")
    else
        print("forge_basen: " + str(fails) + " FAILED")
