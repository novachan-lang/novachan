import std/tree/tree_ancestors

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn ckl(label, got, want)
    if len(got) != len(want)
        print("FAIL " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL " + label + ": at " + str(i) + " got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

// Build tree5: 0-1, 0-2, 1-3, 1-4
fn make_tree5() -> list
    let a0 = [1, 2]
    let a1 = [0, 3, 4]
    let a2 = [0]
    let a3 = [1]
    let a4 = [1]
    let adj = []
    push(adj, a0)
    push(adj, a1)
    push(adj, a2)
    push(adj, a3)
    push(adj, a4)
    return adj

fn main()
    let adj5 = make_tree5()

    // KAT 1: ta_parent rooted at 0
    // expected: [-1, 0, 0, 1, 1]
    let par1 = ta_parent(adj5, 5, 0)
    let want_par = [-1, 0, 0, 1, 1]
    ckl("parent_tree5", par1, want_par)

    // KAT 2: ta_depth rooted at 0
    // expected: [0, 1, 1, 2, 2]
    let dep2 = ta_depth(adj5, 5, 0)
    let want_dep = [0, 1, 1, 2, 2]
    ckl("depth_tree5", dep2, want_dep)

    // KAT 3: ta_kth_ancestor of node 3, k=1 -> 1
    cki("kth_3_k1", ta_kth_ancestor(adj5, 5, 0, 3, 1), 1)

    // KAT 4: ta_kth_ancestor of node 3, k=2 -> 0
    cki("kth_3_k2", ta_kth_ancestor(adj5, 5, 0, 3, 2), 0)

    // KAT 5: ta_kth_ancestor of node 3, k=3 -> -1 (above root)
    cki("kth_3_k3", ta_kth_ancestor(adj5, 5, 0, 3, 3), -1)

    // KAT 6: ta_kth_ancestor of root 0, k=0 -> 0 (itself)
    cki("kth_root_k0", ta_kth_ancestor(adj5, 5, 0, 0, 0), 0)

    // KAT 7: ta_kth_ancestor of root 0, k=1 -> -1
    cki("kth_root_k1", ta_kth_ancestor(adj5, 5, 0, 0, 1), -1)

    // KAT 8: ta_is_ancestor: 1 is ancestor of 3 -> true
    ckb("anc_1_of_3", ta_is_ancestor(adj5, 5, 0, 1, 3), true)

    // KAT 9: ta_is_ancestor: 0 is ancestor of 2 -> true (root is ancestor of all)
    ckb("anc_0_of_2", ta_is_ancestor(adj5, 5, 0, 0, 2), true)

    // KAT 10: ta_is_ancestor: 2 is NOT ancestor of 3 -> false
    ckb("anc_2_of_3", ta_is_ancestor(adj5, 5, 0, 2, 3), false)

    // KAT 11: a node is an ancestor of itself
    ckb("anc_3_of_3", ta_is_ancestor(adj5, 5, 0, 3, 3), true)

    // KAT 12: single node
    let single = [[]]
    let par_s = ta_parent(single, 1, 0)
    cki("parent_single_root", par_s[0], -1)
    let dep_s = ta_depth(single, 1, 0)
    cki("depth_single_root", dep_s[0], 0)

    // KAT 13: rooted at different root - root at 3
    // Tree: 3-1-0-2, 1-4 (rooted at 3)
    // parent: 3->-1, 1->3, 0->1, 2->0, 4->1
    let par13 = ta_parent(adj5, 5, 3)
    cki("parent_at3_root", par13[3], -1)
    cki("parent_at3_1", par13[1], 3)
    cki("parent_at3_0", par13[0], 1)
    cki("parent_at3_2", par13[2], 0)
    cki("parent_at3_4", par13[4], 1)

    // KAT 14: depth from root 3: 3->0, 1->1, 0->2, 4->2, 2->3
    let dep14 = ta_depth(adj5, 5, 3)
    cki("depth_at3_3", dep14[3], 0)
    cki("depth_at3_1", dep14[1], 1)
    cki("depth_at3_0", dep14[0], 2)
    cki("depth_at3_4", dep14[4], 2)
    cki("depth_at3_2", dep14[2], 3)

    print("PASS _tree_ancestors_test")
