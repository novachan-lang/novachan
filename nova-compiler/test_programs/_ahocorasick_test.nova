// KAT for std/text/ahocorasick
// Hand-computed expected values — verified against the Aho-Corasick paper.
import std/text/ahocorasick

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got " + got + " want " + want)
        exit(1)

fn main()
    // ── Build standard automaton ──────────────────────────────────────────────
    let pats = []
    pats.push("he")
    pats.push("she")
    pats.push("his")
    pats.push("hers")
    let ac = ac_build(pats)

    // KAT 1: ac_count("ushers") == 3  (she@1, he@2, hers@2)
    cki("count-ushers", ac_count(ac, "ushers"), 3)

    // KAT 2: ac_matches_any on a string with no patterns
    cki("no-match-xyz", ac_matches_any(ac, "xyz"), 0)

    // KAT 3: ac_matches_any on "the" contains "he" at position 1
    cki("match-the", ac_matches_any(ac, "the"), 1)

    // KAT 4: ac_count("hehehe") == 3  (he@0, he@2, he@4)
    cki("count-hehehe", ac_count(ac, "hehehe"), 3)

    // KAT 5: ac_search("ushers") — verify ["she",1] and ["hers",2] present
    // "ushers": u(0) s(1) h(2) e(3) r(4) s(5)
    //   she ends at index 3 -> start = 3-3+1 = 1
    //   he  ends at index 3 -> start = 3-2+1 = 2
    //   hers ends at index 5 -> start = 5-4+1 = 2
    let matches = ac_search(ac, "ushers")
    // must have exactly 3 matches
    cki("search-ushers-count", len(matches), 3)
    // scan for ["she",1]
    let found_she = 0
    let found_hers = 0
    let mi = 0
    while mi < len(matches)
        let pair = matches[mi]
        let mpat = pair[0]
        let mstart = pair[1]
        if mpat == "she" and mstart == 1
            found_she = 1
        if mpat == "hers" and mstart == 2
            found_hers = 1
        mi = mi + 1
    cki("search-ushers-she-at-1", found_she, 1)
    cki("search-ushers-hers-at-2", found_hers, 1)

    // KAT 6: single-char pattern "a" repeated text "aaa" -> 3 matches
    let pats2 = []
    pats2.push("a")
    let ac2 = ac_build(pats2)
    cki("count-aaa", ac_count(ac2, "aaa"), 3)

    // KAT 7: overlapping pattern at boundary — "ab" in "abab" -> 2 matches
    let pats3 = []
    pats3.push("ab")
    let ac3 = ac_build(pats3)
    cki("count-abab", ac_count(ac3, "abab"), 2)

    // KAT 8: empty text -> 0 matches
    cki("count-empty-text", ac_count(ac, ""), 0)

    print("_ahocorasick_test passed")
