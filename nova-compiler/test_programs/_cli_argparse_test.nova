// KAT for std/cli/cli_argparse — integrated argv parser.
import std/cli/cli_argparse

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let g = "false"
        if got
            g = "true"
        let w = "false"
        if want
            w = "true"
        print("FAIL " + label + ": got=" + g + " want=" + w)
        exit(1)

fn ckl(label: string, got: list, want: list)
    cki(label + "_len", len(got), len(want))
    let i = 0
    while i < len(want)
        cks(label + "_" + str(i), got[i], want[i])
        i = i + 1

fn main()
    // ── KAT: spec cases ────────────────────────────────────────────────────
    // cla_get_opt(['-v','--port','8080','file'],['--port'],'--port') = '8080'
    let a1 = ["-v", "--port", "8080", "file"]
    let vo1 = ["--port"]
    cks("get_opt_basic", cla_get_opt(a1, vo1, "--port"), "8080")

    // cla_has_flag(['-v','--port','8080','file'],['--port'],'-v') = true
    ckb("has_flag_basic", cla_has_flag(a1, vo1, "-v"), true)

    // cla_positionals(['-v','--port','8080','file'],['--port']) = ['file']
    let pos1 = cla_positionals(a1, vo1)
    let wpos1 = ["file"]
    ckl("positionals_basic", pos1, wpos1)

    // cla_positionals(['a','b'],[]) = ['a','b']
    let a2 = ["a", "b"]
    let pos2 = cla_positionals(a2, [])
    let wpos2 = ["a", "b"]
    ckl("positionals_all_pos", pos2, wpos2)

    // cla_get_opt(['file'],[],'--x') = ''
    let a3 = ["file"]
    cks("get_opt_absent", cla_get_opt(a3, [], "--x"), "")

    // ── Additional edge cases ───────────────────────────────────────────────
    // empty argv
    cks("get_opt_empty_argv", cla_get_opt([], ["--port"], "--port"), "")
    ckb("has_flag_empty_argv", cla_has_flag([], ["--port"], "-v"), false)
    let pos3 = cla_positionals([], [])
    cki("positionals_empty_argv", len(pos3), 0)

    // --name=value form
    let a4 = ["--port=9090", "server.nova"]
    cks("get_opt_eq_form", cla_get_opt(a4, ["--port"], "--port"), "9090")
    let pos4 = cla_positionals(a4, ["--port"])
    let wpos4 = ["server.nova"]
    ckl("positionals_eq_form", pos4, wpos4)

    // unknown --opt with no value_opts registered → flag, not consumed
    let a5 = ["--unknown", "val"]
    ckb("has_flag_unknown", cla_has_flag(a5, [], "--unknown"), true)
    // "val" becomes positional
    let pos5 = cla_positionals(a5, [])
    let wpos5 = ["val"]
    ckl("positionals_after_unknown_flag", pos5, wpos5)

    // multiple positionals interleaved
    let a6 = ["foo", "--verbose", "bar", "--out", "out.txt", "baz"]
    let vo6 = ["--out"]
    cks("get_opt_interleaved", cla_get_opt(a6, vo6, "--out"), "out.txt")
    ckb("has_flag_interleaved", cla_has_flag(a6, vo6, "--verbose"), true)
    let pos6 = cla_positionals(a6, vo6)
    let wpos6 = ["foo", "bar", "baz"]
    ckl("positionals_interleaved", pos6, wpos6)

    // option at end of argv with no value → empty string
    let a7 = ["--port"]
    cks("get_opt_at_end", cla_get_opt(a7, ["--port"], "--port"), "")

    // cla_parse structure: verify all three buckets
    let a8 = ["-v", "--debug", "--port", "8080", "input.txt"]
    let vo8 = ["--port"]
    let parsed = cla_parse(a8, vo8)
    let flags8 = parsed[0]
    let opts8 = parsed[1]
    let pos8 = parsed[2]
    cki("parse_flags_len", len(flags8), 2)
    cks("parse_flag0", flags8[0], "-v")
    cks("parse_flag1", flags8[1], "--debug")
    cki("parse_opts_len", len(opts8), 1)
    cks("parse_opt0_name", opts8[0][0], "--port")
    cks("parse_opt0_val", opts8[0][1], "8080")
    cki("parse_pos_len", len(pos8), 1)
    cks("parse_pos0", pos8[0], "input.txt")

    print("PASS _cli_argparse_test")
