import forge_cost_tracker

fn main()
    let c = ct_new()
    assert(ct_total(c) == 0, "zero total")
    assert(ct_service_count(c) == 0, "zero services")

    c = ct_add_cost(c, "compute", 500)
    c = ct_add_cost(c, "storage", 200)
    c = ct_add_cost(c, "network", 100)
    assert(ct_total(c) == 800, "total 800")
    assert(ct_service_count(c) == 3, "3 services")
    assert(ct_get_cost(c, "compute") == 500, "compute 500")
    assert(ct_get_cost(c, "storage") == 200, "storage 200")
    assert(ct_get_cost(c, "unknown") == 0, "unknown 0")

    c = ct_add_cost(c, "compute", 300)
    assert(ct_get_cost(c, "compute") == 800, "compute now 800")
    assert(ct_total(c) == 1100, "total 1100")

    assert(ct_top_service(c) == "compute", "top is compute")
    assert(ct_pct_of_total(c, "compute") == 72, "compute 72%")
    assert(ct_pct_of_total(c, "storage") == 18, "storage 18%")

    print("COST-TRACKER KAT PASS")
