import std/coding/crc_param

fn cki(label, got, want)
    if got != want
        print("FAIL crc_param " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    if got != want
        let gs = "false"
        let ws = "false"
        if got
            gs = "true"
        if want
            ws = "true"
        print("FAIL crc_param " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn main()
    // Build "123456789" as a list of byte values [49,50,51,52,53,54,55,56,57]
    let b9 = []
    b9.push(49)
    b9.push(50)
    b9.push(51)
    b9.push(52)
    b9.push(53)
    b9.push(54)
    b9.push(55)
    b9.push(56)
    b9.push(57)

    // KAT 1: CRC-8/SMBUS check value for "123456789" == 0xF4 (244)
    cki("crc8_smbus_check", cp_crc8(b9), 244)

    // KAT 2: CRC-16/CCITT-FALSE check value for "123456789" == 0x29B1 (10673)
    cki("crc16_ccitt_check", cp_crc16_ccitt_false(b9), 10673)

    // KAT 3: CRC-16/MODBUS check value for "123456789" == 0x4B37 (19255)
    cki("crc16_modbus_check", cp_crc16_modbus(b9), 19255)

    // KAT 4: CRC-32 check value for "123456789" == 0xCBF43926 (3421780262)
    cki("crc32_check", cp_crc32(b9), 3421780262)

    // KAT 5: cp_reflect(0x01, 8) == 0x80
    cki("reflect_0x01_8", cp_reflect(1, 8), 128)

    // KAT 6: cp_reflect(0xB1, 8) == 0x8D
    // 0xB1 = 10110001 reversed = 10001101 = 0x8D = 141
    cki("reflect_0xB1_8", cp_reflect(177, 8), 141)

    // KAT 7: cp_reflect identity — reflect twice gives original
    let orig = 0xA5
    let ref1 = cp_reflect(orig, 8)
    let ref2 = cp_reflect(ref1, 8)
    cki("reflect_double", ref2, orig)

    // KAT 8: cp_reflect 4-bit
    // 0x3 = 0011 reversed = 1100 = 0xC
    cki("reflect_0x3_4", cp_reflect(3, 4), 12)

    // KAT 9: CRC-8/SMBUS empty input == 0 (init=0, no bytes)
    let empty = []
    cki("crc8_empty", cp_crc8(empty), 0)

    // KAT 10: CRC-16/CCITT-FALSE empty == 0xFFFF (65535)
    cki("crc16_ccitt_empty", cp_crc16_ccitt_false(empty), 65535)

    // KAT 11: CRC-16/MODBUS empty == 0xFFFF (65535)
    cki("crc16_modbus_empty", cp_crc16_modbus(empty), 65535)

    // KAT 12: CRC-32 empty == 0 (init^xorout = 0xFFFFFFFF^0xFFFFFFFF = 0)
    cki("crc32_empty", cp_crc32(empty), 0)

    // KAT 13: cp_crc_check round-trip for CRC-8/SMBUS
    ckb("crc_check_crc8", cp_crc_check(b9, 8, 7, 0, 0, 0, 0, 244), true)

    // KAT 14: cp_crc_check returns false on wrong expected value
    ckb("crc_check_wrong", cp_crc_check(b9, 8, 7, 0, 0, 0, 0, 1), false)

    // KAT 15: single-byte "a" (0x61 = 97) CRC-8/SMBUS == 0x20 (32)
    let a_byte = []
    a_byte.push(97)
    cki("crc8_a", cp_crc8(a_byte), 32)

    // KAT 16: determinism — same input same result
    let r1 = cp_crc32(b9)
    let r2 = cp_crc32(b9)
    cki("crc32_determinism", r1, r2)

    print("PASS _crc_param_test")
