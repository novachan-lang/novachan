// KAT test for std/text/rabinkarp
import std/text/rabinkarp

// ── helper: compare int list to expected values ───────────────────────────────
// Prints FAIL and exits 1 if the list does not exactly match the expected ints.
fn _rkt_list_eq(label, got, exp_len, e0, e1, e2, e3) -> int
    if len(got) != exp_len
        print("FAIL " + label + ": len=" + str(len(got)) + " want " + str(exp_len))
        exit(1)
    if exp_len > 0
        if got[0] != e0
            print("FAIL " + label + ": [0]=" + str(got[0]) + " want " + str(e0))
            exit(1)
    if exp_len > 1
        if got[1] != e1
            print("FAIL " + label + ": [1]=" + str(got[1]) + " want " + str(e1))
            exit(1)
    if exp_len > 2
        if got[2] != e2
            print("FAIL " + label + ": [2]=" + str(got[2]) + " want " + str(e2))
            exit(1)
    if exp_len > 3
        if got[3] != e3
            print("FAIL " + label + ": [3]=" + str(got[3]) + " want " + str(e3))
            exit(1)
    0

fn main()
    // ── KAT 1: rk_search — first occurrence (longer pattern near end) ────────
    // text="abxabcabcaby", pat="abcaby"
    // indices: a0 b1 x2 a3 b4 c5 a6 b7 c8 a9 b10 y11
    // window at pos 6: text[6..11]="abcaby" == pat  → expect 6
    let r1 = rk_search("abxabcabcaby", "abcaby")
    if r1 != 6
        print("FAIL KAT1: rk_search abxabcabcaby/abcaby = " + str(r1) + " want 6")
        exit(1)

    // ── KAT 2: rk_search — short pattern ────────────────────────────────────
    // text="hello", pat="ll" → pos 2: "ll" matches → expect 2
    let r2 = rk_search("hello", "ll")
    if r2 != 2
        print("FAIL KAT2: rk_search hello/ll = " + str(r2) + " want 2")
        exit(1)

    // ── KAT 3: rk_search — absent pattern ───────────────────────────────────
    // text="abc", pat="xyz" → never matches → expect -1
    let r3 = rk_search("abc", "xyz")
    if r3 != -1
        print("FAIL KAT3: rk_search abc/xyz = " + str(r3) + " want -1")
        exit(1)

    // ── KAT 4: rk_search_all — overlapping occurrences ──────────────────────
    // text="aaaa", pat="aa"
    // overlapping windows: pos 0 "aa", pos 1 "aa", pos 2 "aa" → expect [0,1,2]
    let r4 = rk_search_all("aaaa", "aa")
    let _chk4 = _rkt_list_eq("KAT4", r4, 3, 0, 1, 2, 0)

    // ── KAT 5: rk_count — overlapping occurrences counted ───────────────────
    // text="mississippi" = m(0)i(1)s(2)s(3)i(4)s(5)s(6)i(7)p(8)p(9)i(10)
    // "issi" at pos 1 (text[1..4]="issi") and pos 4 (text[4..7]="issi")
    // Slide-by-1 counting: pos 1 → match, pos 4 → match. count = 2
    let r5 = rk_count("mississippi", "issi")
    if r5 != 2
        print("FAIL KAT5: rk_count mississippi/issi = " + str(r5) + " want 2")
        exit(1)

    // ── KAT 6: rk_search — pattern starts mid-string ────────────────────────
    // text="abcabcabc", pat="cab" (m=3)
    // pos 0: "abc" ≠; pos 1: "bca" ≠; pos 2: "cab" match → expect 2
    let r6 = rk_search("abcabcabc", "cab")
    if r6 != 2
        print("FAIL KAT6: rk_search abcabcabc/cab = " + str(r6) + " want 2")
        exit(1)

    // ── KAT 7 (bonus): edge case — pattern equals text ───────────────────────
    let r7 = rk_search("hello", "hello")
    if r7 != 0
        print("FAIL KAT7: rk_search hello/hello = " + str(r7) + " want 0")
        exit(1)

    // ── KAT 8 (bonus): rk_count — no occurrences ─────────────────────────────
    let r8 = rk_count("hello", "xyz")
    if r8 != 0
        print("FAIL KAT8: rk_count hello/xyz = " + str(r8) + " want 0")
        exit(1)

    print("_rabinkarp_test passed")
