import std/game/card
import std/game/deck
import std/game/deal
import std/game/suit
import std/game/handrank
import std/game/handscore
import std/game/handcompare
import std/game/blackjack

fn assert_eq(label: string, got: any, want: any)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
    else
        print("ok " + label)

fn list_eq(a: list, b: list) -> bool
    if len(a) != len(b)
        return false
    for i in 0..len(a)
        if a[i] != b[i]
            return false
    true

fn main()
    // card
    assert_eq("card_name AS", card_name([14, 3]), "AS")
    assert_eq("card_name TH", card_name([10, 2]), "TH")
    assert_eq("card_parse AS", list_eq(card_parse("AS"), [14, 3]), true)
    assert_eq("card_parse KD", list_eq(card_parse("KD"), [13, 1]), true)
    assert_eq("rank_name", rank_name(11), "J")
    assert_eq("suit_name", suit_name(0), "C")

    // deck
    let d = deck()
    assert_eq("deck size", len(d), 52)
    assert_eq("deck first", list_eq(d[0], [2, 0]), true)
    assert_eq("deck last", list_eq(d[51], [14, 3]), true)
    assert_eq("deck_index", deck_index([14, 3]), 51)
    assert_eq("deck_contains true", deck_contains(d, [5, 2]), true)
    assert_eq("deck_contains false", deck_contains(d, [99, 9]), false)
    let ed = euchre_deck()
    assert_eq("euchre_deck size", len(ed), 24)
    let pd = pinochle_deck()
    assert_eq("pinochle_deck size", len(pd), 48)

    // deal
    let hands = deal_all(d, 4)
    assert_eq("deal_all hand count", len(hands), 4)
    assert_eq("deal_all hand0 size", len(hands[0]), 13)
    let cutres = cut(d, 10)
    assert_eq("cut top size", len(cutres[0]), 10)
    assert_eq("cut bottom size", len(cutres[1]), 42)
    let drawres = draw(d, 5)
    assert_eq("draw drawn size", len(drawres[0]), 5)
    assert_eq("draw remaining size", len(drawres[1]), 47)

    // suit
    assert_eq("suit_symbol", suit_symbol(2), "H")
    assert_eq("suit_color red", suit_color(1), "red")
    assert_eq("suit_color black", suit_color(3), "black")
    assert_eq("rank_char", rank_char(14), "A")
    let sorted_rank = sort_by_rank([[14, 0], [2, 1], [7, 2]])
    assert_eq("sort_by_rank", list_eq(sorted_rank[0], [2, 1]), true)
    let grouped_suit = group_by_suit([[2, 0], [3, 1], [4, 0], [5, 3]])
    assert_eq("group_by_suit clubs", len(grouped_suit[0]), 2)
    assert_eq("group_by_suit spades", len(grouped_suit[3]), 1)

    // handrank — royal flush
    let royal = [[10, 0], [11, 0], [12, 0], [13, 0], [14, 0]]
    assert_eq("classify royal", classify_poker(royal), "royal_flush")
    let sflush = [[6, 1], [7, 1], [8, 1], [9, 1], [10, 1]]
    assert_eq("classify straight_flush", classify_poker(sflush), "straight_flush")
    let quad = [[5, 0], [5, 1], [5, 2], [5, 3], [9, 0]]
    assert_eq("classify four_kind", classify_poker(quad), "four_kind")
    let full = [[5, 0], [5, 1], [5, 2], [9, 0], [9, 1]]
    assert_eq("classify full_house", classify_poker(full), "full_house")
    let wheel = [[14, 0], [2, 1], [3, 2], [4, 3], [5, 0]]
    assert_eq("classify wheel straight", classify_poker(wheel), "straight")
    assert_eq("is_straight wheel", is_straight(wheel), true)
    let highc = [[2, 0], [5, 1], [9, 2], [11, 3], [13, 0]]
    assert_eq("classify high_card", classify_poker(highc), "high_card")

    // handscore
    assert_eq("category_rank royal", category_rank("royal_flush"), 9)
    assert_eq("category_rank unknown", category_rank("nope"), -1)
    let s_royal = poker_score(royal)
    let s_quad = poker_score(quad)
    assert_eq("poker_score royal > quad", s_royal > s_quad, true)
    let s_full = poker_score(full)
    let s_high = poker_score(highc)
    assert_eq("poker_score full > high", s_full > s_high, true)

    // handcompare
    assert_eq("compare_poker royal beats quad", compare_poker(royal, quad), 1)
    assert_eq("beats", beats(royal, highc), true)
    assert_eq("best_hand", best_hand([highc, royal, quad]), 1)

    // blackjack
    assert_eq("bj_value blackjack", bj_value([[14, 0], [13, 1]]), 21)
    assert_eq("bj_is_blackjack true", bj_is_blackjack([[14, 0], [13, 1]]), true)
    assert_eq("bj_value bust", bj_value([[13, 0], [13, 1], [13, 2]]), 30)
    assert_eq("bj_is_bust true", bj_is_bust([[13, 0], [13, 1], [13, 2]]), true)
    assert_eq("bj_value soft17", bj_value([[14, 0], [6, 1]]), 17)
    assert_eq("bj_is_soft true", bj_is_soft([[14, 0], [6, 1]]), true)
    assert_eq("bj_value two_aces", bj_value([[14, 0], [14, 1]]), 12)

    print("_game1_kat_test passed")
