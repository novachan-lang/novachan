type V
    x: int
    y: int

fn store_in_list(v)
    let lst = []
    push(lst, v)
    lst

fn make_v() -> V
    V(1, 2)

fn use_closure()
    let v = V(3, 4)
    let f = fn() v.x + v.y
    f()

fn main()
    let a = V(10, 20)
    print("local: " + str(a.x + a.y))
    let r = make_v()
    print("returned: " + str(r.x))
    let lst = store_in_list(V(5, 6))
    print("listed: " + str(len(lst)))
    let c = use_closure()
    print("captured: " + str(c))
