import forge_gf2 as gf

fn check(cond: bool, label: string)
    if cond == false
        print("FAIL: " + label)

// parity of popcount of x
fn _par(x: int) -> int
    let v = x
    let p = 0
    while v != 0
        if (v & 1) == 1
            p = p ^ 1
        v = v >> 1
    p

// verify a solution list x satisfies A x = b over GF(2)
fn verify(coeffs: list, rhs: list, x: list) -> bool
    // pack x into a bitmask
    let xm = 0
    let j = 0
    while j < len(x)
        if x[j] == 1
            xm = xm | (1 << j)
        j = j + 1
    let ok = true
    let i = 0
    while i < len(coeffs)
        if _par(coeffs[i] & xm) != rhs[i]
            ok = false
        i = i + 1
    ok

fn main()
    // ---- gf2_rank ----
    check(gf.gf2_rank([1, 2, 4]) == 3, "rank independent 3")
    check(gf.gf2_rank([3, 5, 6]) == 2, "rank 3,5,6 -> 2 (3^5=6)")
    check(gf.gf2_rank([3, 3]) == 1, "rank duplicate -> 1")
    check(gf.gf2_rank([0, 0]) == 0, "rank zeros -> 0")
    check(gf.gf2_rank([7, 7, 7, 1]) == 2, "rank 7,7,7,1 -> 2")
    check(gf.gf2_rank([1, 3, 7, 15]) == 4, "rank staircase -> 4")

    // ---- gf2_solve: determined 2x2 ----
    // x0 XOR x1 = 1 ; x1 = 1  -> x1=1, x0=0
    let s1 = gf.gf2_solve([3, 2], [1, 1], 2)
    check(len(s1) == 2, "s1 has 2 vars")
    check(s1[0] == 0 and s1[1] == 1, "s1 == [0,1]")
    check(verify([3, 2], [1, 1], s1), "s1 satisfies system")

    // ---- gf2_solve: inconsistent ----
    // x0 = 1 and x0 = 0
    let s2 = gf.gf2_solve([1, 1], [1, 0], 1)
    check(len(s2) == 0, "inconsistent -> empty")

    // ---- gf2_solve: underdetermined single equation ----
    // x0 XOR x1 XOR x2 = 1 ; free vars 0 -> [1,0,0]
    let s3 = gf.gf2_solve([7], [1], 3)
    check(len(s3) == 3, "s3 has 3 vars")
    check(verify([7], [1], s3), "s3 satisfies")

    // ---- gf2_solve: 3x3 full-rank system, verify solution ----
    // rows: x0^x1=1, x1^x2=0, x0^x2=1
    let cf = [3, 6, 5]
    let rh = [1, 0, 1]
    let s4 = gf.gf2_solve(cf, rh, 3)
    check(len(s4) == 3, "s4 solved")
    check(verify(cf, rh, s4), "s4 satisfies 3x3")

    // ---- brute self-check: build systems from a KNOWN x, solve, verify solution satisfies ----
    // enumerate all x in {0,1}^4 as the "true" assignment for a fixed coefficient matrix
    let A = [9, 6, 15, 3, 10]   // 5 equations, 4 vars (bits 0..3)
    let xt = 0
    while xt < 16
        // b_i = parity(A_i AND xt)
        let b = []
        let i = 0
        while i < len(A)
            push(b, _par(A[i] & xt))
            i = i + 1
        let sol = gf.gf2_solve(A, b, 4)
        check(len(sol) == 4, "brute: solvable xt=" + str(xt))
        check(verify(A, b, sol), "brute: solution satisfies xt=" + str(xt))
        xt = xt + 1

    // ---- gf2_xor_subset ----
    // subset of [1,2,3] XOR to 0 -> e.g. {1,2,3} (1^2^3=0) ; verify XOR of chosen == target
    let sub1 = gf.gf2_xor_subset([1, 2, 3, 8], 3)
    let x1 = 0
    let a = 0
    while a < len(sub1)
        x1 = x1 ^ sub1[a]
        a = a + 1
    check(x1 == 3, "xor_subset reaches 3")

    let sub2 = gf.gf2_xor_subset([6, 10, 12], 0)  // 6^10^12 = 0
    // target 0: empty subset is valid; just assert XOR of chosen is 0
    let x2 = 0
    let a2 = 0
    while a2 < len(sub2)
        x2 = x2 ^ sub2[a2]
        a2 = a2 + 1
    check(x2 == 0, "xor_subset target 0")

    // impossible: [2,4] can never make an odd number (bit 0 unreachable)
    let sub3 = gf.gf2_xor_subset([2, 4], 1)
    check(len(sub3) == 0, "xor_subset impossible -> empty")

    // reachable odd target
    let sub4 = gf.gf2_xor_subset([1, 2, 4, 8], 7)  // 1^2^4 = 7
    let x4 = 0
    let a4 = 0
    while a4 < len(sub4)
        x4 = x4 ^ sub4[a4]
        a4 = a4 + 1
    check(x4 == 7, "xor_subset reaches 7")

    print("forge_gf2: all passed")
