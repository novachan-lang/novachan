// Canonical KAT test for std/crypto/argon2id (RFC 9106). The exact RFC 5.3 vector + PHC verify + the
// DoS-fix (out-of-range PHC returns false, never exit). Adversarially cross-checked vs an independent ref.
import std/crypto/argon2id

fn _fill(n: int, b: int) -> any
    let out = bytes(0)
    let i = 0
    while i < n
        out = bytes_append(out, b)
        i = i + 1
    return out

fn _hex(bts) -> string
    let digs = "0123456789abcdef"
    let out = ""
    let n = bytes_len(bts)
    let i = 0
    while i < n
        let v = bytes_get(bts, i)
        out = out + char_at(digs, (v >> 4) & 15) + char_at(digs, v & 15)
        i = i + 1
    return out

fn main()
    let pwd = _fill(32, 1)
    let salt = _fill(16, 2)
    let secret = _fill(8, 3)
    let ad = _fill(12, 4)
    let tag = argon2id_raw(pwd, salt, secret, ad, 3, 32, 4, 32)
    if _hex(tag) != "0d640df58d78766c08c037a34a8b53c9d01ef0452d75b65eb52520e96b01e659"
        print("FAIL RFC 9106 vector: " + _hex(tag))
        exit(1)
    print("ok RFC 9106 section-5.3 vector")
    // PHC round-trip
    let salt2 = _fill(16, 9)
    let tag2 = argon2id_hash(pwd, salt2, 2, 32, 1, 32)
    let phc = argon2id_encode(salt2, tag2, 2, 32, 1)
    if not argon2id_verify(pwd, phc)
        print("FAIL verify(correct)")
        exit(1)
    print("ok verify(correct) == true")
    if argon2id_verify(_fill(32, 7), phc)
        print("FAIL verify(wrong pwd) accepted")
        exit(1)
    print("ok verify(wrong pwd) == false")
    // DoS fix: out-of-range params (m < 8*p) must return false, NOT exit the process
    if argon2id_verify(pwd, "$argon2id$v=19$m=1,t=1,p=4$AAAAAAAA$AAAAAAAA")
        print("FAIL out-of-range PHC accepted")
        exit(1)
    print("ok out-of-range PHC returns false (no crash)")
    if argon2id_verify(pwd, "not-a-phc-string")
        print("FAIL malformed PHC accepted")
        exit(1)
    print("ok malformed PHC returns false")
    print("_argon2id_test passed")
