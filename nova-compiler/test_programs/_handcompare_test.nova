// KAT for std/game/handcompare — poker hand comparison
// Cards: [rank, suit]  rank 2..14 (14=A), suit 0..3 (0=C 1=D 2=H 3=S)
import std/game/handcompare

fn ck(label: string, got: int, want: int)
    if got != want
        print("FAIL handcompare " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // Build hands as 5-element lists of [rank, suit]

    // flush: 5 hearts 2H 5H 7H 9H KH
    let flush_hand = [[2,2],[5,2],[7,2],[9,2],[13,2]]

    // straight: 5c 6d 7h 8s 9c (not a flush)
    let straight_hand = [[5,0],[6,1],[7,2],[8,3],[9,0]]

    // pair: two Kings + random
    let pair_kings = [[13,0],[13,1],[2,2],[5,3],[7,0]]

    // pair: two Queens + random
    let pair_queens = [[12,0],[12,1],[2,2],[5,3],[7,0]]

    // one pair (low): pair of 3s
    let pair_threes = [[3,0],[3,1],[2,2],[5,3],[7,0]]

    // high card: A K Q J 9 (different suits, no pair, no straight, no flush)
    let high_card = [[14,0],[13,1],[12,2],[11,3],[9,0]]

    // identical hand (same as flush_hand): for tie test
    let flush_copy = [[2,2],[5,2],[7,2],[9,2],[13,2]]

    // second flush: 2H 5H 7H 9H AH (ace-high flush beats king-high flush)
    let flush_high = [[2,2],[5,2],[7,2],[9,2],[14,2]]

    // four of a kind: four Aces + 2
    let four_aces = [[14,0],[14,1],[14,2],[14,3],[2,0]]

    // full house: three Kings + two Qs
    let full_house = [[13,0],[13,1],[13,2],[12,0],[12,1]]

    // straight flush: 6H 7H 8H 9H TH
    let str_flush = [[6,2],[7,2],[8,2],[9,2],[10,2]]

    // KAT 1: flush beats straight
    ck("flush>straight", compare_poker(flush_hand, straight_hand), 1)

    // KAT 2: pair beats high card
    ck("pair>high", compare_poker(pair_kings, high_card), 1)

    // KAT 3: higher pair beats lower pair (kings vs queens)
    ck("pk>pq", compare_poker(pair_kings, pair_queens), 1)

    // KAT 4: identical hands => tie
    ck("flush==flush", compare_poker(flush_hand, flush_copy), 0)

    // KAT 5: ace-high flush beats king-high flush (tiebreaker by high card)
    ck("aflush>kflush", compare_poker(flush_high, flush_hand), 1)
    // and the reverse
    ck("kflush<aflush", compare_poker(flush_hand, flush_high), 0 - 1)

    // KAT 6: beats() — four of a kind beats full house
    ck("4aces beats fullhouse", beats(four_aces, full_house), 1)
    ck("fullhouse !beats 4aces", beats(full_house, four_aces), 0)

    // KAT 7: best_hand picks the strongest
    let hands = [high_card, pair_threes, pair_queens, str_flush, full_house]
    // str_flush is index 3 — should be the best
    ck("best_hand picks str_flush", best_hand(hands), 3)

    // KAT 8: best_hand single element returns 0
    ck("best_hand single", best_hand([high_card]), 0)

    // KAT 9: pair queens beats pair threes (same hand rank, higher pair rank wins)
    ck("pq>p3", compare_poker(pair_queens, pair_threes), 1)

    // KAT 10: straight flush beats four of a kind
    ck("sf>4k", compare_poker(str_flush, four_aces), 1)

    // KAT 11: full house beats flush
    ck("fh>flush", compare_poker(full_house, flush_high), 1)

    print("PASS _handcompare_test")
