import forge_isin

fn tf(b: bool) -> string
    if b
        return "T"
    "F"

fn main()
    // Published valid ISINs
    print("apple=" + tf(isin_valid("US0378331005")))
    print("bae=" + tf(isin_valid("GB0002634946")))
    print("nortel=" + tf(isin_valid("US0378331005")))
    print("treasury=" + tf(isin_valid("US9128283G32")))
    // check digit of Apple body
    print("cd_apple=" + str(isin_check_digit("US037833100")))
    // invalid: wrong check digit
    print("bad_cd=" + tf(isin_valid("US0378331004")))
    // invalid: wrong length
    print("bad_len=" + tf(isin_valid("US03783310")))
    // invalid: country code not letters
    print("bad_cc=" + tf(isin_valid("120378331005")))
    // invalid: bad char in body
    print("bad_char=" + tf(isin_valid("US03783310!5")))
