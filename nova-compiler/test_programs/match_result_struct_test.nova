// match-on-Result<Struct> must preserve the payload's STRUCT TYPE so a FLOAT field reads back
// correctly via str()/arithmetic -- not just to_json. Regression for a silent-corruption soundness
// bug: `match r { Ok(a) => str(a.bal) }` previously dropped a's struct type, so a float field was
// read as its raw IEEE-754 bits (3.14159 -> 4614256650576692846). to_json MASKED it (struct-meta
// render), so a to_json-only test would have shipped the bug. We assert str + arithmetic + to_json.
type Acct
    bal: float
    rate: float
    n: int

fn ret(raw: string, rate: string) -> Result<Acct>
    ok(Acct(float(raw), float(rate), 5))

fn main()
    let q = chr(34)

    // 1) match Ok from a fn returning Result<Acct>: float fields via str() AND arithmetic
    let r: Result<Acct> = ret("3.14159", "2.5")
    match r
        Ok(a) =>
            assert(str(a.bal) == "3.14159", "float field via str() after match-Ok (got " + str(a.bal) + ")")
            assert(a.bal > 3.1415 and a.bal < 3.1416, "float field arithmetic-comparable after match-Ok")
            assert(a.bal * 2.0 > 6.283 and a.bal * 2.0 < 6.284, "float field multiplies correctly")
            assert(str(a.rate) == "2.5", "second float field correct (got " + str(a.rate) + ")")
            assert(a.n == 5, "int field intact")
            assert(find(to_json(a), q + "bal" + q + ":3.14159") >= 0, "to_json still correct")
            print("PASS: match-Ok preserves float struct fields (bal=" + str(a.bal) + " rate=" + str(a.rate) + ")")
        Err(e) =>
            assert(false, "unexpected Err")

    // 2) the from_json_safe path: annotated Result<Acct> let + match-Ok + float read via str/arith
    let body = "\{" + q + "bal" + q + ":1.5," + q + "rate" + q + ":0.25," + q + "n" + q + ":9\}"
    let r2: Result<Acct> = from_json_safe(body)
    match r2
        Ok(a2) =>
            assert(str(a2.bal) == "1.5", "from_json_safe float via str after match (got " + str(a2.bal) + ")")
            assert(a2.bal + a2.rate > 1.74 and a2.bal + a2.rate < 1.76, "from_json_safe float arithmetic")
            print("PASS: from_json_safe match-Ok float fields (bal=" + str(a2.bal) + ")")
        Err(e2) =>
            assert(false, "unexpected Err from from_json_safe")

    print("match_result_struct_test passed")
