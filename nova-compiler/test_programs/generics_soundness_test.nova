// ── NOVA Generics Soundness Test ────────────────────────────
// These tests verify that the type checker catches invalid generic usage.
// Programs that should type-error must be tested individually (since any
// error stops compilation). This file tests VALID programs that exercise
// subtle corners of the type system.

// Test 1: Polymorphic function called at different types directly
fn<T> id(x: T) -> T
    return x

let a = id(42)
let b = id("hello")
print(a)
print(b)

// Test 2: Generic function passed as argument
fn<T> apply(f, x: T) -> T
    return f(x)

fn double(x: int) -> int
    return x * 2

let r = apply(double, 21)
print(r)

// Test 3: Return type properly inferred through generic chain
fn<T> wrap_in_list(x: T) -> list
    return [x, x, x]

let ints = wrap_in_list(7)
print(len(ints))
print(ints[0])

let strs = wrap_in_list("abc")
print(len(strs))
print(strs[0])

// Test 4: Generic struct field access preserves type
type Holder<T>
    val: T

fn<T> get_val(h: Holder<T>) -> T
    return h.val

let h1 = Holder(100)
let h2 = Holder("stored")
print(get_val(h1))
print(get_val(h2))

// Test 5: Nested generic struct construction
type Outer<T>
    inner: T

let deep = Outer(Outer(Outer(42)))
print(deep.inner.inner.inner)

// Test 6: Generic with mutation
fn<T> set_first(xs: list, val: T)
    xs[0] = val

let nums = [1, 2, 3]
set_first(nums, 99)
print(nums[0])

// Test 7: Generic function returns different types based on input
fn<T> echo_type(x: T) -> T
    let result = x
    return result

print(echo_type(42) + 1)
print(echo_type("hello") + " world")

// Expected:
// 42
// hello
// 42
// 3
// 7
// 3
// abc
// 100
// stored
// 42
// 99
// 43
// hello world
