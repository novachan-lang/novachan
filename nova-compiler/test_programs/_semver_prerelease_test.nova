// KAT for std/semver/semver_prerelease — SemVer 2.0.0 pre-release comparison.
// Vectors from §11 example chain and spec rules.
import std/semver/semver_prerelease

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _semver_prerelease_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL _semver_prerelease_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // SemVer §11 canonical ordering chain:
    // 1.0.0-alpha < 1.0.0-alpha.1 < 1.0.0-alpha.beta < 1.0.0-beta
    //   < 1.0.0-beta.2 < 1.0.0-beta.11 < 1.0.0-rc.1 < 1.0.0

    // svp_compare('alpha','alpha.1') = -1  (fewer identifiers < more)
    cki("alpha_lt_alpha.1", svp_compare("alpha", "alpha.1"), 0 - 1)

    // svp_compare('alpha.1','alpha.beta') = -1  (numeric 1 < alphanumeric beta)
    cki("alpha.1_lt_alpha.beta", svp_compare("alpha.1", "alpha.beta"), 0 - 1)

    // svp_compare('alpha.beta','beta') = -1  (alpha < beta lexicographic)
    cki("alpha.beta_lt_beta", svp_compare("alpha.beta", "beta"), 0 - 1)

    // svp_compare('beta','beta.2') = -1  (fewer identifiers < more)
    cki("beta_lt_beta.2", svp_compare("beta", "beta.2"), 0 - 1)

    // svp_compare('beta.2','beta.11') = -1  (2 < 11 numerically)
    cki("beta.2_lt_beta.11", svp_compare("beta.2", "beta.11"), 0 - 1)

    // svp_compare('beta.11','rc.1') = -1  (beta < rc lexicographic)
    cki("beta.11_lt_rc.1", svp_compare("beta.11", "rc.1"), 0 - 1)

    // svp_compare('','alpha') = 1  (no prerelease = HIGHEST)
    cki("empty_gt_alpha", svp_compare("", "alpha"), 1)

    // svp_compare('1','2') = -1  (numeric 1 < 2)
    cki("1_lt_2", svp_compare("1", "2"), 0 - 1)

    // svp_compare('alpha.1','alpha.1') = 0  (equal)
    cki("equal", svp_compare("alpha.1", "alpha.1"), 0)

    // svp_is_numeric_ident('11') = true
    ckb("is_numeric_11", svp_is_numeric_ident("11"), true)

    // svp_is_numeric_ident('beta') = false
    ckb("not_numeric_beta", svp_is_numeric_ident("beta"), false)

    // Additional checks
    // svp_compare('','') = 0  (both no prerelease)
    cki("both_empty", svp_compare("", ""), 0)

    // svp_compare('alpha','') = -1  (prerelease < no prerelease)
    cki("alpha_lt_empty", svp_compare("alpha", ""), 0 - 1)

    // svp_compare('rc.1','') = -1  (any prerelease < no prerelease)
    cki("rc.1_lt_empty", svp_compare("rc.1", ""), 0 - 1)

    // svp_is_numeric_ident('0') = true
    ckb("is_numeric_0", svp_is_numeric_ident("0"), true)

    // svp_is_numeric_ident('') = false  (empty is not numeric)
    ckb("not_numeric_empty", svp_is_numeric_ident(""), false)

    // svp_is_numeric_ident('1a') = false
    ckb("not_numeric_1a", svp_is_numeric_ident("1a"), false)

    // svp_compare: same length, all equal
    cki("equal_multi", svp_compare("rc.1.2", "rc.1.2"), 0)

    // svp_compare: numeric wins by value (larger wins)
    cki("num_100_gt_99", svp_compare("100", "99"), 1)

    print("PASS _semver_prerelease_test")
