import std/geometry3d/cg3_convex3

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(label: string, got: list, wn: int, wd: int)
    let gn = got[0]
    let gd = got[1]
    if gn != wn or gd != wd
        print("FAIL " + label + ": got=[" + str(gn) + "," + str(gd) + "] want=[" + str(wn) + "," + str(wd) + "]")
        exit(1)

fn main()
    // Unit cube [0,2]^3 via 6 half-space planes.
    // Convention: n.pt + d <= 0 means INSIDE.
    // x >= 0:  -x <= 0  => [-1,0,0,0]
    // x <= 2:   x - 2 <= 0 => [1,0,0,-2]
    // y >= 0:  -y <= 0  => [0,-1,0,0]
    // y <= 2:   y - 2 <= 0 => [0,1,0,-2]
    // z >= 0:  -z <= 0  => [0,0,-1,0]
    // z <= 2:   z - 2 <= 0 => [0,0,1,-2]
    let p0 = [-1,0,0,0]
    let p1 = [1,0,0,-2]
    let p2 = [0,-1,0,0]
    let p3 = [0,1,0,-2]
    let p4 = [0,0,-1,0]
    let p5 = [0,0,1,-2]
    let planes = []
    push(planes, p0)
    push(planes, p1)
    push(planes, p2)
    push(planes, p3)
    push(planes, p4)
    push(planes, p5)

    // ── cgc3_in_halfspaces ────────────────────────────────────────────────
    // KAT: interior point [1,1,1] -> inside all -> true
    ckb("in [1,1,1]", cgc3_in_halfspaces(planes, [1,1,1]), true)
    // KAT: exterior point [3,1,1] -> x=3>2, violates x<=2 -> false
    ckb("out [3,1,1]", cgc3_in_halfspaces(planes, [3,1,1]), false)
    // KAT: face point [0,1,1] -> x=0 is on x>=0 face -> true (on boundary counts as inside)
    ckb("on face [0,1,1]", cgc3_in_halfspaces(planes, [0,1,1]), true)
    // Additional: corner [0,0,0] -> on 3 faces, still inside
    ckb("corner [0,0,0]", cgc3_in_halfspaces(planes, [0,0,0]), true)
    // Additional: corner [2,2,2] -> on 3 faces, still inside
    ckb("corner [2,2,2]", cgc3_in_halfspaces(planes, [2,2,2]), true)
    // Strictly outside on z: [1,1,3] -> z=3>2 -> false
    ckb("out [1,1,3]", cgc3_in_halfspaces(planes, [1,1,3]), false)
    // Negative coord: [1,-1,1] -> y=-1 < 0 -> false
    ckb("out [1,-1,1]", cgc3_in_halfspaces(planes, [1,-1,1]), false)

    // ── cgc3_on_boundary ─────────────────────────────────────────────────
    // KAT: [0,1,1] -> on x=0 face -> true
    ckb("boundary [0,1,1]", cgc3_on_boundary(planes, [0,1,1]), true)
    // KAT: [1,1,1] interior -> not on any face -> false
    ckb("not boundary [1,1,1]", cgc3_on_boundary(planes, [1,1,1]), false)
    // Corner is on 3 faces -> true
    ckb("boundary corner [0,0,0]", cgc3_on_boundary(planes, [0,0,0]), true)
    // Edge midpoint [0,0,1] -> on x=0 AND z-not-extremal but still 2 faces zero -> true
    ckb("boundary edge [0,0,1]", cgc3_on_boundary(planes, [0,0,1]), true)
    // Exterior point: not on boundary (fails in_halfspaces) -> false
    ckb("not boundary exterior [3,1,1]", cgc3_on_boundary(planes, [3,1,1]), false)

    // ── cgc3_count_inside ─────────────────────────────────────────────────
    // 3 interior + 2 face + 1 exterior = 5 inside (face points count)
    let pt_in1 = [1,1,1]
    let pt_in2 = [0,1,1]
    let pt_in3 = [2,2,2]
    let pt_out1 = [3,1,1]
    let pt_in4 = [1,1,0]
    let pt_out2 = [-1,1,1]
    let pts = []
    push(pts, pt_in1)
    push(pts, pt_in2)
    push(pts, pt_in3)
    push(pts, pt_out1)
    push(pts, pt_in4)
    push(pts, pt_out2)
    cki("count_inside 4 of 6", cgc3_count_inside(planes, pts), 4)

    // Empty points list -> 0
    let empty_pts = []
    cki("count_inside empty", cgc3_count_inside(planes, empty_pts), 0)

    print("PASS _cg3_convex3_test")
