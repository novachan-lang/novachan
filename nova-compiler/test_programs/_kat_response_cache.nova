import forge_response_cache

fn main()
    let c = rc_new(100)

    c = rc_store(c, "/api/users", "user-list-json", "abc123", 300)
    c = rc_store(c, "/api/posts", "posts-json", "def456", 60)

    assert(rc_size(c) == 2, "2 cached")

    let r1 = rc_lookup(c, "/api/users")
    assert(r1["found"] == true, "found users")
    assert(r1["body"] == "user-list-json", "users body")
    assert(r1["etag"] == "abc123", "users etag")

    let r2 = rc_lookup(c, "/api/missing")
    assert(r2["found"] == false, "not found")

    assert(rc_check_etag(c, "/api/users", "abc123") == "not_modified", "etag match")
    assert(rc_check_etag(c, "/api/users", "old") == "stale", "etag stale")
    assert(rc_check_etag(c, "/api/nope", "x") == "miss", "etag miss")

    assert(rc_is_fresh(c, "/api/users") == true, "fresh")

    c = rc_invalidate(c, "/api/users")
    assert(rc_is_fresh(c, "/api/users") == false, "invalidated")

    assert(rc_hit_rate(c) > 0, "hit rate > 0")

    c = rc_clear(c)
    assert(rc_size(c) == 0, "cleared")

    print("RESPONSE-CACHE KAT PASS")
