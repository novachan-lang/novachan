import forge_nextgreater

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn joinl(xs: list) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + ","
        out = out + str(xs[i])
        i = i + 1
    out

// brute next greater
fn brute_ng(arr: list) -> list
    let out = []
    let i = 0
    while i < len(arr)
        let v = 0 - 1
        let j = i + 1
        let done = 0
        while j < len(arr) and done == 0
            if arr[j] > arr[i]
                v = arr[j]
                done = 1
            j = j + 1
        push(out, v)
        i = i + 1
    out

fn main()
    let fails = 0

    fails = fails + expect("ng1", joinl(next_greater([2, 1, 2, 4, 3])), "4,2,4,-1,-1")
    fails = fails + expect("ng_desc", joinl(next_greater([5, 4, 3, 2, 1])), "-1,-1,-1,-1,-1")
    fails = fails + expect("ng_asc", joinl(next_greater([1, 2, 3, 4])), "2,3,4,-1")
    fails = fails + expect("ng_single", joinl(next_greater([7])), "-1")

    fails = fails + expect("ns1", joinl(next_smaller([2, 1, 2, 4, 3])), "1,-1,-1,3,-1")
    fails = fails + expect("ns_asc", joinl(next_smaller([1, 2, 3])), "-1,-1,-1")

    fails = fails + expect("pg1", joinl(previous_greater([2, 1, 2, 4, 3])), "-1,2,-1,-1,4")
    fails = fails + expect("pg_asc", joinl(previous_greater([1, 2, 3])), "-1,-1,-1")

    // stock span classic
    fails = fails + expect("span", joinl(stock_span([100, 80, 60, 70, 60, 75, 85])), "1,1,1,2,1,4,6")
    fails = fails + expect("span_asc", joinl(stock_span([10, 20, 30, 40])), "1,2,3,4")
    fails = fails + expect("span_desc", joinl(stock_span([40, 30, 20, 10])), "1,1,1,1")

    // brute-force cross-check on several arrays
    let ok = 1
    let arrs = []
    push(arrs, [3, 1, 4, 1, 5, 9, 2, 6])
    push(arrs, [1, 3, 2, 4])
    push(arrs, [10, 10, 10])
    push(arrs, [5, 1, 2, 8, 3])
    let t = 0
    while t < len(arrs)
        if joinl(next_greater(arrs[t])) != joinl(brute_ng(arrs[t]))
            ok = 0
        t = t + 1
    fails = fails + expect("brute_cross", str(ok), "1")

    if fails == 0
        print("forge_nextgreater: all passed")
    else
        print("forge_nextgreater: " + str(fails) + " FAILED")
