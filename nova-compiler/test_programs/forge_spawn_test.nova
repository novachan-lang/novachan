// forge_spawn_test -- Phase 1a guard: forge.serve_req_n is SPAWN-PER-CONNECTION. N concurrent
// clients hit a typed-dispatch server; each connection runs in its own green task with its own
// per-task arena. Proves the accept loop never blocks on a handler and the per-task arena is
// sound under concurrent load (the G1 fix + the concurrency moat). Server-binding test -> runs
// serially in the regression.
import forge

type Msg
    id: int
    text: string

fn h_echo(req: Request) -> Response
    forge.resp_json(200, Msg(42, "echo"))

fn _client(port, path, rch)
    sleep(20)
    let sock = tcp_connect("127.0.0.1", port)
    if sock >= 0
        tcp_send(sock, "GET " + path + " HTTP/1.1\r\nHost: x\r\n\r\n")
        let resp = tcp_recv(sock)
        tcp_close(sock)
        send(rch, resp)
    else
        send(rch, "FAIL")

fn main()
    let q = chr(34)
    let app = forge.app()
    forge.get(app, "/u/:id", h_echo)
    let port = 18991
    let results = channel()
    let n = 6
    // forge's spawn-per-connection serve in a green task
    let p = port
    let ap = app
    sched_spawn(fn(z) forge.serve_req_n(ap, p, n))
    sleep(40)
    let i = 0
    while i < n
        let pp = port
        let rc = results
        let pth = "/u/" + str(i)
        sched_spawn(fn(z) _client(pp, pth, rc))
        i = i + 1
    let got = 0
    let j = 0
    while j < n
        let r = recv(results)
        let s = str(r)
        if find(s, "200 OK") >= 0 and find(s, q + "id" + q + ":42") >= 0
            got = got + 1
        j = j + 1
    assert(got == n, "all concurrent requests OK via serve_req_n: " + str(got) + "/" + str(n))
    print("forge_spawn_test passed (" + str(got) + "/" + str(n) + " concurrent, spawn-per-conn + per-task arena)")
