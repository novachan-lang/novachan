import forge_cqrs_handler

fn main()
    let c = cq_new()
    c = cq_register_command(c, "CreateUser", "user_create_handler")
    c = cq_register_command(c, "DeleteUser", "user_delete_handler")
    c = cq_register_query(c, "GetUser", "user_get_handler")
    assert(cq_command_count(c) == 2, "2 commands")
    assert(cq_query_count(c) == 1, "1 query")

    let r1 = cq_execute_command(c, "CreateUser", "alice")
    assert(is_ok(r1), "command ok")
    assert(unwrap(r1) == "user_create_handler", "correct handler")

    let r2 = cq_execute_command(c, "Unknown", "x")
    assert(is_err(r2), "unknown command is err")

    let r3 = cq_execute_query(c, "GetUser")
    assert(is_ok(r3), "query ok")
    assert(unwrap(r3) == "user_get_handler", "query handler")

    let r4 = cq_execute_query(c, "Missing")
    assert(is_err(r4), "unknown query is err")

    assert(cq_log_count(c) == 1, "1 log entry")
    let le = cq_log_entry(c, 0)
    assert(unwrap(le) == "CreateUser", "log entry 0")

    let bad = cq_log_entry(c, 99)
    assert(is_err(bad), "log out of range is err")

    print("CQRS-HANDLER KAT PASS")
