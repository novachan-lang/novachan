import forge_event_bus_typed

fn main()
    let eb = eb_new()
    eb = eb_subscribe(eb, "analytics", "user.created")
    eb = eb_subscribe(eb, "email-svc", "user.created")
    eb = eb_subscribe(eb, "billing", "order.placed")

    eb = eb_publish(eb, "user.created", "user-1", 1000)
    eb = eb_publish(eb, "user.created", "user-2", 1001)
    eb = eb_publish(eb, "order.placed", "order-1", 1002)
    assert(eb_total_published(eb) == 3, "3 published")
    assert(eb_event_count(eb) == 3, "3 events")

    assert(eb_subscriber_count(eb, "user.created") == 2, "2 subs for user.created")
    assert(eb_received_count(eb, "analytics") == 2, "analytics got 2")
    assert(eb_received_count(eb, "billing") == 1, "billing got 1")

    let user_events = eb_events_of_type(eb, "user.created")
    assert(len(user_events) == 2, "2 user events")

    let recent = eb_since(eb, 1001)
    assert(len(recent) == 2, "2 since 1001")

    assert(eb_received_count(eb, "nonexistent") == 0, "no sub = 0")
    assert(eb_subscriber_count(eb, "nonexistent") == 0, "no type = 0 subs")

    print("EVENT-BUS-TYPED KAT PASS")
