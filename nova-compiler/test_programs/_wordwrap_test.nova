import std/textlayout/wordwrap

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cklist(label, got, want)
    if len(got) != len(want)
        print("FAIL " + label + ": len=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL " + label + "[" + str(i) + "]: got=" + got[i] + " want=" + want[i])
            exit(1)
        i = i + 1

fn main()
    // ww_wrap: basic greedy wrap at width=10
    // 'the quick brown fox' -> ['the quick','brown fox']
    cklist("wrap_basic", ww_wrap("the quick brown fox", 10), ["the quick", "brown fox"])

    // ww_wrap: all words fit on one line
    cklist("wrap_fits", ww_wrap("a b c", 10), ["a b c"])

    // ww_wrap: single word longer than width goes unbroken on its own line
    cklist("wrap_longword", ww_wrap("hello", 3), ["hello"])

    // ww_wrap: empty string returns empty list
    cklist("wrap_empty", ww_wrap("", 10), [])

    // ww_wrap_str: joined by newline
    let want_str = "the quick" + chr(10) + "brown fox"
    cks("wrap_str", ww_wrap_str("the quick brown fox", 10), want_str)

    // ww_break_long: 'abcdefg' at width 3 -> ['abc','def','g']
    cklist("break_long_abcdefg", ww_break_long("abcdefg", 3), ["abc", "def", "g"])

    // ww_break_long: word shorter than width stays whole
    cklist("break_long_short", ww_break_long("hi", 5), ["hi"])

    // ww_break_long: exact multiple
    cklist("break_long_exact", ww_break_long("abcdef", 3), ["abc", "def"])

    // ww_lines: 'the quick brown fox jumps' at width=10 -> 3 lines
    // Lines: 'the quick', 'brown fox', 'jumps'
    cki("ww_lines_3", ww_lines("the quick brown fox jumps", 10), 3)

    // ww_lines: single line
    cki("ww_lines_1", ww_lines("hello world", 20), 1)

    // ww_fits: word within width
    ckb("fits_yes", ww_fits("hello", 5), true)
    ckb("fits_no", ww_fits("hello", 4), false)
    ckb("fits_eq", ww_fits("hello", 6), true)

    // ww_split_words: basic
    cklist("split_words", ww_split_words("a b c"), ["a", "b", "c"])
    cklist("split_words_empty", ww_split_words(""), [])
    cklist("split_words_multi_space", ww_split_words("a  b"), ["a", "b"])

    // ww_wrap_hard: hard-break a long word
    // 'verylongword' width=4 -> ['very','long','word']
    cklist("wrap_hard_long", ww_wrap_hard("verylongword", 4), ["very", "long", "word"])

    // ww_wrap_hard: short words still pack greedily
    cklist("wrap_hard_mixed", ww_wrap_hard("ab cd ef", 5), ["ab cd", "ef"])

    print("PASS _wordwrap_test")
