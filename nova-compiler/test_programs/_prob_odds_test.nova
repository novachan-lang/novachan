import std/probability/prob_odds

// ckr — check reduced fraction [num,den] equals expected [wn,wd].
fn ckr(label: string, got, wn: int, wd: int)
    if got[0] != wn or got[1] != wd
        print("FAIL prob_odds " + label + ": got=[" + str(got[0]) + "," + str(got[1]) + "] want=[" + str(wn) + "," + str(wd) + "]")
        exit(1)

fn main()
    // po_prob_to_odds(1,4) = 1:3
    let r1 = po_prob_to_odds(1, 4)
    ckr("po_prob_to_odds(1,4)", r1, 1, 3)

    // po_odds_to_prob(2,3) = 2/(2+3) = 2/5
    let r2 = po_odds_to_prob(2, 3)
    ckr("po_odds_to_prob(2,3)", r2, 2, 5)

    // po_complement(1,4) = 3/4
    let r3 = po_complement(1, 4)
    ckr("po_complement(1,4)", r3, 3, 4)

    // po_and_independent(1,2,1,3) = 1/6
    let r4 = po_and_independent(1, 2, 1, 3)
    ckr("po_and_independent(1,2,1,3)", r4, 1, 6)

    // po_or_independent(1,2,1,3) = 1/2+1/3-1/6 = 3/6+2/6-1/6 = 4/6 = 2/3
    let r5 = po_or_independent(1, 2, 1, 3)
    ckr("po_or_independent(1,2,1,3)", r5, 2, 3)

    // po_prob_to_odds(2,5) = 2:3
    let r6 = po_prob_to_odds(2, 5)
    ckr("po_prob_to_odds(2,5)", r6, 2, 3)

    // Additional edge: po_complement(1,2) = 1/2
    let r7 = po_complement(1, 2)
    ckr("po_complement(1,2)", r7, 1, 2)

    // po_and_independent(1,4,1,4) = 1/16
    let r8 = po_and_independent(1, 4, 1, 4)
    ckr("po_and_independent(1,4,1,4)", r8, 1, 16)

    // po_or_independent(1,2,1,2) = 3/4
    let r9 = po_or_independent(1, 2, 1, 2)
    ckr("po_or_independent(1,2,1,2)", r9, 3, 4)

    print("PASS _prob_odds_test")
