type Token
    kind: string
    value: string

type Expr
    tag: string
    value: string
    num: int
    children: list

type Stmt
    tag: string
    name: string
    expr: Expr
    body: list
    params: list

type ExprResult
    expr: Expr
    pos: int

type StmtResult
    stmt: Stmt
    pos: int

type Env
    bindings: dict
    parent: list

fn env_new() -> Env
    Env({}, [])

fn env_set(e: Env, name: string, v: int) -> Env
    e.bindings[name] = v
    e

fn env_get(e: Env, name: string) -> int
    if contains(e.bindings, name)
        return e.bindings[name]
    assert(false, "undefined: " + name)
    0

fn is_alpha(ch: string) -> bool
    let c = ord(ch)
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or ch == "_"

fn is_digit(ch: string) -> bool
    let c = ord(ch)
    c >= 48 and c <= 57

fn is_alnum(ch: string) -> bool
    is_alpha(ch) or is_digit(ch)

fn tokenize(source: string) -> list
    let tokens = []
    let pos = 0
    let length = len(source)
    while pos < length
        let ch = source[pos]
        if ch == " " or ch == "\t" or ch == "\r"
            pos = pos + 1
        else if ch == "\n"
            push(tokens, Token("NL", "\\n"))
            pos = pos + 1
        else if is_alpha(ch)
            let word = ""
            while pos < length and is_alnum(source[pos])
                word = word + source[pos]
                pos = pos + 1
            let kind = if word == "let" or word == "if" or word == "else" or word == "while" or word == "return"
                "KW"
            else
                "ID"
            push(tokens, Token(kind, word))
        else if is_digit(ch)
            let num = ""
            while pos < length and is_digit(source[pos])
                num = num + source[pos]
                pos = pos + 1
            push(tokens, Token("NUM", num))
        else if ch == "+" or ch == "*" or ch == "/" or ch == "-"
            push(tokens, Token("OP", ch))
            pos = pos + 1
        else if ch == "="
            if pos + 1 < length and source[pos + 1] == "="
                push(tokens, Token("OP", "=="))
                pos = pos + 2
            else
                push(tokens, Token("EQ", "="))
                pos = pos + 1
        else if ch == "<"
            push(tokens, Token("OP", "<"))
            pos = pos + 1
        else if ch == ">"
            push(tokens, Token("OP", ">"))
            pos = pos + 1
        else
            pos = pos + 1
    push(tokens, Token("EOF", ""))
    tokens

fn tok_kind(tokens: list, pos: int) -> string
    match tokens[pos]
        Token(kind, value) => kind

fn tok_val(tokens: list, pos: int) -> string
    match tokens[pos]
        Token(kind, value) => value

fn prec(op: string) -> int
    if op == "==" or op == "<" or op == ">"
        1
    else if op == "+" or op == "-"
        2
    else if op == "*" or op == "/"
        3
    else
        0

fn skip_nl(tokens: list, pos: int) -> int
    while tok_kind(tokens, pos) == "NL"
        pos = pos + 1
    pos

fn parse_primary(tokens: list, pos: int) -> ExprResult
    let kind = tok_kind(tokens, pos)
    let val = tok_val(tokens, pos)
    if kind == "NUM"
        ExprResult(Expr("num", val, int(val), []), pos + 1)
    else if kind == "ID"
        ExprResult(Expr("var", val, 0, []), pos + 1)
    else
        ExprResult(Expr("num", "0", 0, []), pos + 1)

fn parse_expr(tokens: list, pos: int, min_prec: int) -> ExprResult
    let left_r = parse_primary(tokens, pos)
    let left = left_r.expr
    let cur = left_r.pos
    while tok_kind(tokens, cur) == "OP" and prec(tok_val(tokens, cur)) > min_prec
        let op = tok_val(tokens, cur)
        let p = prec(op)
        let right_r = parse_expr(tokens, cur + 1, p)
        left = Expr("binop", op, 0, [left, right_r.expr])
        cur = right_r.pos
    ExprResult(left, cur)

fn parse_stmt(tokens: list, pos: int) -> StmtResult
    let kind = tok_kind(tokens, pos)
    let val = tok_val(tokens, pos)
    if kind == "KW" and val == "let"
        let name = tok_val(tokens, pos + 1)
        let er = parse_expr(tokens, pos + 3, 0)
        StmtResult(Stmt("let", name, er.expr, [], []), er.pos)
    else if kind == "KW" and val == "if"
        let cond_r = parse_expr(tokens, pos + 1, 0)
        let p = skip_nl(tokens, cond_r.pos)
        let then_r = parse_stmt(tokens, p)
        let p2 = skip_nl(tokens, then_r.pos)
        if tok_kind(tokens, p2) == "KW" and tok_val(tokens, p2) == "else"
            let p3 = skip_nl(tokens, p2 + 1)
            let else_r = parse_stmt(tokens, p3)
            StmtResult(Stmt("if", "", cond_r.expr, [then_r.stmt, else_r.stmt], []), else_r.pos)
        else
            StmtResult(Stmt("if", "", cond_r.expr, [then_r.stmt], []), p2)
    else if kind == "KW" and val == "while"
        let cond_r = parse_expr(tokens, pos + 1, 0)
        let p = skip_nl(tokens, cond_r.pos)
        let body_r = parse_stmt(tokens, p)
        StmtResult(Stmt("while", "", cond_r.expr, [body_r.stmt], []), body_r.pos)
    else
        let er = parse_expr(tokens, pos, 0)
        StmtResult(Stmt("expr", "", er.expr, [], []), er.pos)

fn parse_program(tokens: list) -> list
    let stmts = []
    let pos = skip_nl(tokens, 0)
    while tok_kind(tokens, pos) != "EOF"
        let sr = parse_stmt(tokens, pos)
        push(stmts, sr.stmt)
        pos = skip_nl(tokens, sr.pos)
    stmts

fn eval_expr(e: Expr, env: Env) -> int
    match e
        Expr(tag, value, num, children) =>
            if tag == "num"
                num
            else if tag == "var"
                env_get(env, value)
            else if tag == "binop"
                let l = eval_expr(children[0], env)
                let r = eval_expr(children[1], env)
                if value == "+"
                    l + r
                else if value == "-"
                    l - r
                else if value == "*"
                    l * r
                else if value == "/"
                    l / r
                else if value == "=="
                    if l == r
                        1
                    else
                        0
                else if value == "<"
                    if l < r
                        1
                    else
                        0
                else
                    if l > r
                        1
                    else
                        0
            else
                0

fn eval_if(expr: Expr, body: list, env: Env) -> int
    let cond = eval_expr(expr, env)
    if cond != 0
        return eval_stmt(body[0], env)
    if len(body) > 1
        return eval_stmt(body[1], env)
    0

fn eval_while(expr: Expr, body: list, env: Env) -> int
    let result = 0
    while eval_expr(expr, env) != 0
        result = eval_stmt(body[0], env)
    result

fn eval_stmt(s: Stmt, env: Env) -> int
    match s
        Stmt(tag, name, expr, body, params) =>
            if tag == "let"
                let v = eval_expr(expr, env)
                env_set(env, name, v)
                return v
            if tag == "expr"
                return eval_expr(expr, env)
            if tag == "if"
                return eval_if(expr, body, env)
            if tag == "while"
                return eval_while(expr, body, env)
            0

fn run_program(source: string) -> int
    let tokens = tokenize(source)
    let stmts = parse_program(tokens)
    let env = env_new()
    let result = 0
    let i = 0
    while i < len(stmts)
        result = eval_stmt(stmts[i], env)
        i = i + 1
    result

fn run()
    print("STARTING")
    print("test 1: arithmetic")
    let r1 = run_program("3 + 4 * 2")
    print("  = " + str(r1))
    assert(r1 == 11, "t1=" + str(r1))

    print("test 2: let binding")
    let r2 = run_program("let x = 10\nlet y = x + 5\ny")
    print("  = " + str(r2))
    assert(r2 == 15, "t2=" + str(r2))

    print("test 3: comparison")
    let r3 = run_program("5 > 3")
    print("  5>3 = " + str(r3))
    assert(r3 == 1, "t3=" + str(r3))

    print("test 4: if/else literal")
    let r4 = run_program("if 1\n10\nelse\n20")
    print("  = " + str(r4))
    assert(r4 == 10, "t4=" + str(r4))

    print("test 5: while loop")
    let r5 = run_program("let x = 0\nwhile x < 5\nlet x = x + 1\nx")
    print("  = " + str(r5))
    assert(r5 == 5, "t5=" + str(r5))

    print("ALL TESTS PASSED")

run()
