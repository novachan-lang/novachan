import complexnum

// Validation test for the complexnum module ([re, im] float pairs).
// Tolerance for float comparison.
fn near(a, b) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < 0.000001
        return 1
    return 0

fn main()
    // add: (1+2i) + (3+4i) = 4 + 6i
    let s = complexnum.c_add(complexnum.complex(1, 2), complexnum.complex(3, 4))
    assert(near(complexnum.c_re(s), 4.0) == 1, "c_add re == 4")
    assert(near(complexnum.c_im(s), 6.0) == 1, "c_add im == 6")

    // sub: (5+7i) - (2+3i) = 3 + 4i
    let d = complexnum.c_sub(complexnum.complex(5, 7), complexnum.complex(2, 3))
    assert(near(complexnum.c_re(d), 3.0) == 1, "c_sub re == 3")
    assert(near(complexnum.c_im(d), 4.0) == 1, "c_sub im == 4")

    // mul: (1+2i)(3+4i) = -5 + 10i
    let m = complexnum.c_mul(complexnum.complex(1, 2), complexnum.complex(3, 4))
    assert(near(complexnum.c_re(m), -5.0) == 1, "c_mul re == -5")
    assert(near(complexnum.c_im(m), 10.0) == 1, "c_mul im == 10")

    // abs: |3+4i| = 5
    assert(near(complexnum.c_abs(complexnum.complex(3, 4)), 5.0) == 1, "c_abs 3,4 == 5")

    // conj: conj(3+4i) = 3 - 4i
    let cj = complexnum.c_conj(complexnum.complex(3, 4))
    assert(near(complexnum.c_re(cj), 3.0) == 1, "c_conj re == 3")
    assert(near(complexnum.c_im(cj), -4.0) == 1, "c_conj im == -4")

    print("complexnum_lib_test passed")
