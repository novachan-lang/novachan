import std/net/telnet_opt

// ── Helper: assert integer equality ──────────────────────────────────────────
fn cki(label, got, want)
    if got != want
        print("FAIL telnet_opt " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// ── Helper: assert bytes length equality ─────────────────────────────────────
fn cklen(label, b, want)
    let n = bytes_len(b)
    if n != want
        print("FAIL telnet_opt " + label + "_len: got " + str(n) + " want " + str(want))
        exit(1)

fn main()
    // ── KAT 1: telnet_will ────────────────────────────────────────────────────
    // telnet_will(1) -> [255, 251, 1]
    let will1 = telnet_will(1)
    cklen("will1", will1, 3)
    cki("will1[0]", bytes_get(will1, 0), 255)
    cki("will1[1]", bytes_get(will1, 1), 251)
    cki("will1[2]", bytes_get(will1, 2), 1)
    print("PASS telnet_opt will1")

    // ── KAT 2: telnet_wont ────────────────────────────────────────────────────
    // telnet_wont(1) -> [255, 252, 1]
    let wont1 = telnet_wont(1)
    cklen("wont1", wont1, 3)
    cki("wont1[0]", bytes_get(wont1, 0), 255)
    cki("wont1[1]", bytes_get(wont1, 1), 252)
    cki("wont1[2]", bytes_get(wont1, 2), 1)
    print("PASS telnet_opt wont1")

    // ── KAT 3: telnet_do ──────────────────────────────────────────────────────
    // telnet_do(3) -> [255, 253, 3]
    let do3 = telnet_do(3)
    cklen("do3", do3, 3)
    cki("do3[0]", bytes_get(do3, 0), 255)
    cki("do3[1]", bytes_get(do3, 1), 253)
    cki("do3[2]", bytes_get(do3, 2), 3)
    print("PASS telnet_opt do3")

    // ── KAT 4: telnet_dont ────────────────────────────────────────────────────
    // telnet_dont(5) -> [255, 254, 5]
    let dont5 = telnet_dont(5)
    cklen("dont5", dont5, 3)
    cki("dont5[0]", bytes_get(dont5, 0), 255)
    cki("dont5[1]", bytes_get(dont5, 1), 254)
    cki("dont5[2]", bytes_get(dont5, 2), 5)
    print("PASS telnet_opt dont5")

    // ── KAT 5: telnet_sub basic ───────────────────────────────────────────────
    // telnet_sub(1, data=[65,66,67]) -> [255,250,1,65,66,67,255,240]
    let sub_data = bytes(0)
    sub_data = bytes_append(sub_data, 65)
    sub_data = bytes_append(sub_data, 66)
    sub_data = bytes_append(sub_data, 67)
    let sub1 = telnet_sub(1, sub_data)
    cklen("sub1", sub1, 8)
    cki("sub1[0]", bytes_get(sub1, 0), 255)
    cki("sub1[1]", bytes_get(sub1, 1), 250)
    cki("sub1[2]", bytes_get(sub1, 2), 1)
    cki("sub1[3]", bytes_get(sub1, 3), 65)
    cki("sub1[4]", bytes_get(sub1, 4), 66)
    cki("sub1[5]", bytes_get(sub1, 5), 67)
    cki("sub1[6]", bytes_get(sub1, 6), 255)
    cki("sub1[7]", bytes_get(sub1, 7), 240)
    print("PASS telnet_opt sub1")

    // ── KAT 6: telnet_sub with IAC escape ────────────────────────────────────
    // If data contains 0xFF, it must be escaped as 0xFF 0xFF in the output.
    // telnet_sub(1, [65, 255, 66]) -> [255,250,1, 65,255,255,66, 255,240] (9 bytes)
    let sub_iac_data = bytes(0)
    sub_iac_data = bytes_append(sub_iac_data, 65)
    sub_iac_data = bytes_append(sub_iac_data, 255)
    sub_iac_data = bytes_append(sub_iac_data, 66)
    let sub_iac = telnet_sub(1, sub_iac_data)
    cklen("sub_iac", sub_iac, 9)
    cki("sub_iac[3]", bytes_get(sub_iac, 3), 65)
    cki("sub_iac[4]", bytes_get(sub_iac, 4), 255)
    cki("sub_iac[5]", bytes_get(sub_iac, 5), 255)
    cki("sub_iac[6]", bytes_get(sub_iac, 6), 66)
    cki("sub_iac[7]", bytes_get(sub_iac, 7), 255)
    cki("sub_iac[8]", bytes_get(sub_iac, 8), 240)
    print("PASS telnet_opt sub_iac_escape")

    // ── KAT 7: telnet_parse — DO negotiation + data chunk ────────────────────
    // Buffer: [255,253,1, 65,66]  -> DO/opt1 negotiation, then data "AB"
    let parse_buf = bytes(0)
    parse_buf = bytes_append(parse_buf, 255)
    parse_buf = bytes_append(parse_buf, 253)
    parse_buf = bytes_append(parse_buf, 1)
    parse_buf = bytes_append(parse_buf, 65)
    parse_buf = bytes_append(parse_buf, 66)
    let parsed = telnet_parse(parse_buf)
    cki("parse_buf_len", len(parsed), 2)
    // First element: DO negotiation
    let p0 = parsed[0]
    cki("parse_do_cmd", p0["cmd"], 253)
    cki("parse_do_opt", p0["opt"], 1)
    // Second element: data chunk containing "AB"
    let p1 = parsed[1]
    let p1data = p1["data"]
    cki("parse_data_len", bytes_len(p1data), 2)
    cki("parse_data_0", bytes_get(p1data, 0), 65)
    cki("parse_data_1", bytes_get(p1data, 1), 66)
    print("PASS telnet_opt parse_do_then_data")

    // ── KAT 8: telnet_parse — WILL + WONT sequence ───────────────────────────
    let w_buf = bytes_concat(telnet_will(1), telnet_wont(3))
    let w_parsed = telnet_parse(w_buf)
    cki("will_wont_len", len(w_parsed), 2)
    cki("will_wont_0_cmd", w_parsed[0]["cmd"], 251)
    cki("will_wont_0_opt", w_parsed[0]["opt"], 1)
    cki("will_wont_1_cmd", w_parsed[1]["cmd"], 252)
    cki("will_wont_1_opt", w_parsed[1]["opt"], 3)
    print("PASS telnet_opt parse_will_wont")

    // ── KAT 9: telnet_parse — subnegotiation round-trip ─────────────────────
    // Build: IAC SB 1 [65 66 67] IAC SE, parse it back
    let rt_data = bytes(0)
    rt_data = bytes_append(rt_data, 65)
    rt_data = bytes_append(rt_data, 66)
    rt_data = bytes_append(rt_data, 67)
    let rt_wire = telnet_sub(1, rt_data)
    let rt_parsed = telnet_parse(rt_wire)
    cki("sub_rt_len", len(rt_parsed), 1)
    let rt0 = rt_parsed[0]
    cki("sub_rt_cmd", rt0["cmd"], 250)
    cki("sub_rt_opt", rt0["opt"], 1)
    let rt0d = rt0["data"]
    cki("sub_rt_data_len", bytes_len(rt0d), 3)
    cki("sub_rt_data_0", bytes_get(rt0d, 0), 65)
    cki("sub_rt_data_1", bytes_get(rt0d, 1), 66)
    cki("sub_rt_data_2", bytes_get(rt0d, 2), 67)
    print("PASS telnet_opt sub_roundtrip")

    // ── KAT 10: telnet_strip — IAC IAC un-escape ─────────────────────────────
    // [255,255,65] -> bytes [255, 65]
    let strip_buf = bytes(0)
    strip_buf = bytes_append(strip_buf, 255)
    strip_buf = bytes_append(strip_buf, 255)
    strip_buf = bytes_append(strip_buf, 65)
    let stripped = telnet_strip(strip_buf)
    cklen("strip_iac_iac", stripped, 2)
    cki("strip_iac_iac[0]", bytes_get(stripped, 0), 255)
    cki("strip_iac_iac[1]", bytes_get(stripped, 1), 65)
    print("PASS telnet_opt strip_iac_iac")

    // ── KAT 11: telnet_strip — negotiations stripped ──────────────────────────
    // [65, 255,253,1, 66] -> [65, 66]  (DO opt1 is stripped)
    let strip_neg = bytes(0)
    strip_neg = bytes_append(strip_neg, 65)
    strip_neg = bytes_append(strip_neg, 255)
    strip_neg = bytes_append(strip_neg, 253)
    strip_neg = bytes_append(strip_neg, 1)
    strip_neg = bytes_append(strip_neg, 66)
    let stripped_neg = telnet_strip(strip_neg)
    cklen("strip_neg", stripped_neg, 2)
    cki("strip_neg[0]", bytes_get(stripped_neg, 0), 65)
    cki("strip_neg[1]", bytes_get(stripped_neg, 1), 66)
    print("PASS telnet_opt strip_negotiations")

    // ── KAT 12: telnet_strip — subnegotiation stripped ───────────────────────
    // [65, IAC SB 1 "CD" IAC SE, 66] -> [65, 66]
    let strip_sub = bytes(0)
    strip_sub = bytes_append(strip_sub, 65)
    strip_sub = bytes_append(strip_sub, 255)
    strip_sub = bytes_append(strip_sub, 250)
    strip_sub = bytes_append(strip_sub, 1)
    strip_sub = bytes_append(strip_sub, 67)
    strip_sub = bytes_append(strip_sub, 68)
    strip_sub = bytes_append(strip_sub, 255)
    strip_sub = bytes_append(strip_sub, 240)
    strip_sub = bytes_append(strip_sub, 66)
    let stripped_sub = telnet_strip(strip_sub)
    cklen("strip_sub", stripped_sub, 2)
    cki("strip_sub[0]", bytes_get(stripped_sub, 0), 65)
    cki("strip_sub[1]", bytes_get(stripped_sub, 1), 66)
    print("PASS telnet_opt strip_subneg")

    // ── KAT 13: telnet_parse — mixed data/commands ───────────────────────────
    // [72,101,108,108,111, 255,251,1, 87,111,114,108,100]
    // "Hello" + WILL(1) + "World"
    let mixed = bytes(0)
    mixed = bytes_append(mixed, 72)
    mixed = bytes_append(mixed, 101)
    mixed = bytes_append(mixed, 108)
    mixed = bytes_append(mixed, 108)
    mixed = bytes_append(mixed, 111)
    mixed = bytes_append(mixed, 255)
    mixed = bytes_append(mixed, 251)
    mixed = bytes_append(mixed, 1)
    mixed = bytes_append(mixed, 87)
    mixed = bytes_append(mixed, 111)
    mixed = bytes_append(mixed, 114)
    mixed = bytes_append(mixed, 108)
    mixed = bytes_append(mixed, 100)
    let mixed_p = telnet_parse(mixed)
    // Should produce: data("Hello"), WILL(1), data("World") — 3 entries
    cki("mixed_count", len(mixed_p), 3)
    let md0 = mixed_p[0]
    let md0d = md0["data"]
    cki("mixed_d0_len", bytes_len(md0d), 5)
    cki("mixed_d0_0", bytes_get(md0d, 0), 72)
    let mn1 = mixed_p[1]
    cki("mixed_n1_cmd", mn1["cmd"], 251)
    cki("mixed_n1_opt", mn1["opt"], 1)
    let md2 = mixed_p[2]
    let md2d = md2["data"]
    cki("mixed_d2_len", bytes_len(md2d), 5)
    cki("mixed_d2_0", bytes_get(md2d, 0), 87)
    print("PASS telnet_opt parse_mixed")

    // ── KAT 14: telnet_parse — IAC IAC inside data produces data chunk ────────
    // [255,255, 65] -> one data chunk [0xFF, 65]
    let iac_data_buf = bytes(0)
    iac_data_buf = bytes_append(iac_data_buf, 255)
    iac_data_buf = bytes_append(iac_data_buf, 255)
    iac_data_buf = bytes_append(iac_data_buf, 65)
    let iac_data_p = telnet_parse(iac_data_buf)
    cki("iac_data_count", len(iac_data_p), 1)
    let iac_d0 = iac_data_p[0]
    let iac_d0d = iac_d0["data"]
    cki("iac_data_chunk_len", bytes_len(iac_d0d), 2)
    cki("iac_data_chunk_0", bytes_get(iac_d0d, 0), 255)
    cki("iac_data_chunk_1", bytes_get(iac_d0d, 1), 65)
    print("PASS telnet_opt parse_iac_iac_data")

    // ── KAT 15: telnet_parse — empty buffer ───────────────────────────────────
    let empty_p = telnet_parse(bytes(0))
    cki("empty_parse_len", len(empty_p), 0)
    print("PASS telnet_opt parse_empty")

    // ── KAT 16: subneg with IAC IAC inside — parse un-escapes ────────────────
    // Build IAC SB 1 [65, 255, 255, 66] IAC SE (IAC IAC in the subneg payload)
    // Expected: parsed data = [65, 255, 66]
    let sub_esc_wire = bytes(0)
    sub_esc_wire = bytes_append(sub_esc_wire, 255)
    sub_esc_wire = bytes_append(sub_esc_wire, 250)
    sub_esc_wire = bytes_append(sub_esc_wire, 1)
    sub_esc_wire = bytes_append(sub_esc_wire, 65)
    sub_esc_wire = bytes_append(sub_esc_wire, 255)
    sub_esc_wire = bytes_append(sub_esc_wire, 255)
    sub_esc_wire = bytes_append(sub_esc_wire, 66)
    sub_esc_wire = bytes_append(sub_esc_wire, 255)
    sub_esc_wire = bytes_append(sub_esc_wire, 240)
    let sub_esc_p = telnet_parse(sub_esc_wire)
    cki("sub_esc_count", len(sub_esc_p), 1)
    let sub_esc0 = sub_esc_p[0]
    cki("sub_esc_cmd", sub_esc0["cmd"], 250)
    cki("sub_esc_opt", sub_esc0["opt"], 1)
    let sub_esc0d = sub_esc0["data"]
    cki("sub_esc_data_len", bytes_len(sub_esc0d), 3)
    cki("sub_esc_data_0", bytes_get(sub_esc0d, 0), 65)
    cki("sub_esc_data_1", bytes_get(sub_esc0d, 1), 255)
    cki("sub_esc_data_2", bytes_get(sub_esc0d, 2), 66)
    print("PASS telnet_opt sub_iac_iac_unescaped")

    print("PASS _telnet_opt_test")
