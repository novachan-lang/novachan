import std/phonetic/match_rating

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL match_rating " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL match_rating " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ---- mra_codex reference vectors ----
    cks("codex_Byrne",  mra_codex("Byrne"),  "BYRN")
    cks("codex_Boern",  mra_codex("Boern"),  "BRN")
    cks("codex_Smith",  mra_codex("Smith"),  "SMTH")
    cks("codex_Smyth",  mra_codex("Smyth"),  "SMYTH")
    // MRA codex: >6 chars -> first3+last3
    // Katherine -> KATHERINE -> remove vowels AEIE -> KTHRN (len=5 <=6)
    cks("codex_Katherine", mra_codex("Katherine"), "KTHRN")
    // Empty/short
    cks("codex_empty", mra_codex(""), "")
    cks("codex_A",     mra_codex("A"), "A")

    // ---- mra_min_rating threshold table ----
    cki("min_rating_5", mra_min_rating(5),  5)
    cki("min_rating_7", mra_min_rating(7),  4)
    cki("min_rating_11", mra_min_rating(11), 3)
    cki("min_rating_12", mra_min_rating(12), 2)
    cki("min_rating_4",  mra_min_rating(4),  5)
    cki("min_rating_6",  mra_min_rating(6),  4)
    cki("min_rating_8",  mra_min_rating(8),  3)

    // ---- mra_compare reference vectors ----
    // Byrne (BYRN len=4) vs Boern (BRN len=3): sum=7 thresh=4; ua=1(Y) ub=0 sim=6-0=6 -> MATCH
    cki("compare_Byrne_Boern", mra_compare("Byrne", "Boern"), 1)
    // Smith (SMTH len=4) vs Smyth (SMYTH len=5): sum=9 thresh=3; ua=0 ub=1(Y) sim=6-0=6 -> MATCH
    cki("compare_Smith_Smyth", mra_compare("Smith", "Smyth"), 1)
    // Very different names with large codex difference: length diff > 3 -> fail
    // Xiomara -> XMRN (4) vs Li -> L (1): diff=3 sum=5 thresh=5; J==not-match anyway
    // Use names with diff > 3 to test the diff gate:
    // "Elizabeth" -> LZBTH (5) vs "Li" -> L (1): diff=4 -> should be 0
    cki("compare_Elizabeth_Li", mra_compare("Elizabeth", "Li"), 0)

    // ---- mra_similarity ----
    // Byrne (BYRN) vs Boern (BRN):
    //   Left: B==B match. xs=[Y,R,N] ys=[R,N]
    //   Left: Y!=R stop. Right: N==N match. xs=[Y,R] ys=[R]
    //   Right: R==R match. xs=[Y] ys=[]
    //   ua=1 ub=0 sim=6-(1+0)/2=6-0=6
    cki("sim_Byrne_Boern", mra_similarity("Byrne", "Boern"), 6)
    // Smith (SMTH) vs Smyth (SMYTH):
    //   Left: S==S match. xs=[M,T,H] ys=[M,Y,T,H]
    //   Left: M==M match. xs=[T,H] ys=[Y,T,H]
    //   Left: T!=Y stop. Right: H==H match. xs=[T] ys=[Y,T]
    //   Right: T==T match. xs=[] ys=[Y] -> done
    //   ua=0 ub=1 sim=6-0=6
    cki("sim_Smith_Smyth", mra_similarity("Smith", "Smyth"), 6)
    // Catherine (CTHRN) vs Kathryn (KTHRYN):
    //   Left: C!=K stop. Right: N==N match. xs=[C,T,H,R] ys=[K,T,H,R,Y]
    //   Right: R!=Y stop. ua=4 ub=5 sim=6-(4+5)/2=6-4=2
    cki("sim_Catherine_Kathryn", mra_similarity("Catherine", "Kathryn"), 2)
    // sum=5+6=11 thresh=3; sim=2 < 3 -> 0
    cki("compare_Catherine_Kathryn", mra_compare("Catherine", "Kathryn"), 0)

    print("PASS _match_rating_test")
