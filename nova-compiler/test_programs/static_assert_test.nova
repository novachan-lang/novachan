// Compile-time assertions: static_assert(constexpr) is evaluated by the compiler
// at build time and emits ZERO runtime code. A false (or non-constant) assertion
// fails the build with a source location -- NOVA's answer to C's static_assert /
// Rust's const{assert!}, but with no ceremony. These all hold, so this compiles
// and runs; the asserts themselves cost nothing at runtime.

fn main()
    static_assert(1 + 1 == 2)
    static_assert(2 * 3 == 6)
    static_assert(100 / 4 == 25)
    static_assert(7 % 2 == 1)
    static_assert(10 > 5)
    static_assert(5 <= 5)
    static_assert(3 != 4)
    static_assert(true)
    static_assert(not false)
    static_assert((4 < 8) and (9 >= 9))
    static_assert((1 == 2) or (3 == 3))
    static_assert(-5 + 5 == 0)
    static_assert(1 == 1, "one equals one")

    print("static_assert passed")
