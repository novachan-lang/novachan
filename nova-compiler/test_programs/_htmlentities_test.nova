// KAT test for std/encoding/htmlentities
// Verifies he_encode, he_encode_min, he_decode against known-answer vectors.

import std/encoding/htmlentities

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=[" + got + "] expected=[" + expected + "]")
        exit(1)

// ── he_encode KATs ────────────────────────────────────────────────────────────

// KAT-1: angle-bracket tag
cks("he_encode_tag", he_encode(chr(60) + "a" + chr(62)), "&lt;a&gt;")

// KAT-2: ampersand in text
cks("he_encode_amp", he_encode("Tom & Jerry"), "Tom &amp; Jerry")

// KAT-3: double-quote
cks("he_encode_dquote", he_encode(chr(34)), "&quot;")

// KAT-4: single-quote
cks("he_encode_squote", he_encode(chr(39)), "&#39;")

// KAT-5: all five special chars at once
let all5in = chr(38) + chr(60) + chr(62) + chr(34) + chr(39)
let all5out = "&amp;&lt;&gt;&quot;&#39;"
cks("he_encode_all5", he_encode(all5in), all5out)

// ── he_decode KATs ────────────────────────────────────────────────────────────

// KAT-6: named lt and gt
let ltgt_want = chr(60) + "b" + chr(62)
cks("he_decode_ltgt", he_decode("&lt;b&gt;"), ltgt_want)

// KAT-7: &amp;
cks("he_decode_amp", he_decode("&amp;"), chr(38))

// KAT-8: decimal numeric &#65; -> A
cks("he_decode_dec", he_decode("&#65;"), "A")

// KAT-9: hex numeric &#x41; -> A
cks("he_decode_hex_lower", he_decode("&#x41;"), "A")

// KAT-10: hex numeric &#X41; -> A (uppercase X)
cks("he_decode_hex_upper", he_decode("&#X41;"), "A")

// KAT-11: &quot; and &#39;
cks("he_decode_quot", he_decode("&quot;"), chr(34))
cks("he_decode_apos", he_decode("&#39;"), chr(39))

// KAT-12: unrecognised entity passes through verbatim
cks("he_decode_unknown", he_decode("&nbsp;"), "&nbsp;")

// ── he_encode_min KATs ────────────────────────────────────────────────────────

// KAT-13a: lt gt escaped
cks("he_encode_min_ltgt", he_encode_min("Hello <World>"), "Hello &lt;World&gt;")

// KAT-13b: amp escaped
cks("he_encode_min_amp", he_encode_min("Tom & Jerry"), "Tom &amp; Jerry")

// KAT-13c: double-quote NOT escaped
let dq = chr(34)
cks("he_encode_min_dquote_passthru", he_encode_min(dq + "x" + dq), dq + "x" + dq)

// KAT-13d: single-quote NOT escaped
let sq = chr(39)
cks("he_encode_min_squote_passthru", he_encode_min(sq + "x" + sq), sq + "x" + sq)

// ── Round-trip KATs ───────────────────────────────────────────────────────────

// KAT-14: round-trip he_decode(he_encode(x)) == x
let rt1 = "a" + chr(60) + "b" + chr(62) + chr(38) + "c"
cks("roundtrip_encode", he_decode(he_encode(rt1)), rt1)

// KAT-15: round-trip he_decode(he_encode_min(x)) == x
let rt2 = "Tom & " + chr(60) + "b" + chr(62) + " Jerry"
cks("roundtrip_encode_min", he_decode(he_encode_min(rt2)), rt2)

// KAT-16: numeric entity codepoint 169 copyright sign
cks("he_decode_cp169", he_decode("&#169;"), from_codepoint(169))

// KAT-17: mixed text with entities and plain chars
cks("he_decode_mixed", he_decode("Tom &amp; Jerry &lt; 10"), "Tom & Jerry < 10")

// KAT-18: bare & without semicolon passes through
cks("he_decode_bare_amp", he_decode("a & b"), "a & b")

// KAT-19: plain ASCII is identity
cks("he_encode_plain", he_encode("Hello, world!"), "Hello, world!")

// KAT-20: empty strings
cks("he_encode_empty", he_encode(""), "")
cks("he_decode_empty", he_decode(""), "")
cks("he_encode_min_empty", he_encode_min(""), "")

print("_htmlentities_test passed")
