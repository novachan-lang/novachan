import std/httphdr/http_link

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)

fn main()
    // ── KAT: hlk_by_rel ───────────────────────────────────────────────────────
    cks("by_rel next", hlk_by_rel("<https://api/p2>; rel=" + chr(34) + "next" + chr(34) + ", <https://api/p0>; rel=" + chr(34) + "prev" + chr(34), "next"), "https://api/p2")
    cks("by_rel prev", hlk_by_rel("<https://api/p2>; rel=" + chr(34) + "next" + chr(34) + ", <https://api/p0>; rel=" + chr(34) + "prev" + chr(34), "prev"), "https://api/p0")
    cks("by_rel missing", hlk_by_rel("<https://api/p2>; rel=" + chr(34) + "next" + chr(34), "prev"), "")
    cks("by_rel empty", hlk_by_rel("", "next"), "")

    // ── KAT: hlk_rels ─────────────────────────────────────────────────────────
    let rels1 = hlk_rels("<u1>; rel=" + chr(34) + "next" + chr(34) + ", <u2>; rel=" + chr(34) + "last" + chr(34))
    cki("rels count", len(rels1), 2)
    cks("rels[0]", rels1[0], "next")
    cks("rels[1]", rels1[1], "last")

    let rels2 = hlk_rels("")
    cki("rels empty", len(rels2), 0)

    // ── KAT: hlk_parse ────────────────────────────────────────────────────────
    let p1 = hlk_parse("<https://x>; rel=" + chr(34) + "self" + chr(34))
    cki("parse count single", len(p1), 1)
    let pair1 = p1[0]
    cks("parse url self", pair1[0], "https://x")
    cks("parse rel self", pair1[1], "self")

    // two-entry parse
    let p2 = hlk_parse("<https://api/p2>; rel=" + chr(34) + "next" + chr(34) + ", <https://api/p0>; rel=" + chr(34) + "prev" + chr(34))
    cki("parse count two", len(p2), 2)
    let pa = p2[0]
    let pb = p2[1]
    cks("parse url next", pa[0], "https://api/p2")
    cks("parse rel next", pa[1], "next")
    cks("parse url prev", pb[0], "https://api/p0")
    cks("parse rel prev", pb[1], "prev")

    // empty input
    let p3 = hlk_parse("")
    cki("parse empty", len(p3), 0)

    // URL only (no rel)
    let p4 = hlk_parse("<https://x>")
    cki("parse norel count", len(p4), 1)
    let pn = p4[0]
    cks("parse norel url", pn[0], "https://x")
    cks("parse norel rel", pn[1], "")

    print("PASS _http_link_test")
