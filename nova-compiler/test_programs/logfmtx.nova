fn _needs_quote(s)
  let i = 0
  while i < len(s)
    let ch = slice(s, i, i + 1)
    if ch == " " or ch == "=" or ch == "\""
      return 1
    i = i + 1
  0

fn _quote_val(s)
  if _needs_quote(s)
    return "\"" + s + "\""
  s

fn logfmt(pairs)
  let parts = []
  let i = 0
  while i < len(pairs)
    let pair = pairs[i]
    let key = str(pair[0])
    let val = _quote_val(str(pair[1]))
    push(parts, key + "=" + val)
    i = i + 1
  join(parts, " ")

fn logfmt_parse(s)
  let result = {}
  let i = 0
  let n = len(s)
  while i < n
    while i < n and slice(s, i, i + 1) == " "
      i = i + 1
    if i >= n
      return result
    let key_start = i
    while i < n and slice(s, i, i + 1) != "="
      i = i + 1
    if i >= n
      return result
    let key = slice(s, key_start, i)
    i = i + 1
    let val = ""
    if i < n and slice(s, i, i + 1) == "\""
      i = i + 1
      let vs = i
      while i < n and slice(s, i, i + 1) != "\""
        i = i + 1
      val = slice(s, vs, i)
      if i < n
        i = i + 1
    else
      let vs2 = i
      while i < n and slice(s, i, i + 1) != " "
        i = i + 1
      val = slice(s, vs2, i)
    result[key] = val
  result

fn log_info(msg, pairs)
  let all = [["level", "INFO"], ["msg", msg]]
  for p in pairs
    push(all, p)
  print(logfmt(all))

fn log_error(msg, pairs)
  let all = [["level", "ERROR"], ["msg", msg]]
  for p in pairs
    push(all, p)
  print(logfmt(all))

fn main()
  let out = logfmt([["level", "INFO"], ["msg", "started"], ["port", 8080]])
  assert(contains(out, "level=INFO"), "level key")
  assert(contains(out, "msg=started"), "msg key")
  assert(contains(out, "port=8080"), "port key")

  let q = logfmt([["key", "has space"]])
  assert(contains(q, "\"has space\""), "quoted value")

  let parsed = logfmt_parse("level=INFO msg=hello count=42")
  assert(parsed["level"] == "INFO", "parsed level")
  assert(parsed["msg"] == "hello", "parsed msg")
  assert(parsed["count"] == "42", "parsed count")

  let p2 = logfmt_parse("key=\"quoted val\"")
  assert(p2["key"] == "quoted val", "parsed quoted")

  let rt = logfmt_parse(logfmt([["a", "1"], ["b", "test"]]))
  assert(rt["a"] == "1", "round-trip a")
  assert(rt["b"] == "test", "round-trip b")

  print("logfmtx: all passed")
