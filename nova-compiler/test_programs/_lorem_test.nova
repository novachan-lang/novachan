// KAT test for std/text/lorem.
//
// All expected values were HAND-COMPUTED by tracing prng_seed(42) and
// prng_seed(99) through the xorshift64 generator (see std/util/prng.nova)
// and applying prng_range(state, 0, 19) -> _lo_vocab(idx) for each word draw.
//
// Seed 42 trace (prng_seed(42) = 1363149450):
//   step 0: idx=11 -> "tempor"
//   step 1: idx=15 -> "et"
//   step 2: idx=17 -> "magna"
//   step 3: idx=7  -> "elit"
//   step 4: idx=13 -> "ut"
//   lo_words(5) = "tempor et magna elit ut"
//   step 5: idx=7  -> "elit"   (6th word for sentence)
//   lo_sentence = "Tempor et magna elit ut elit."
//   Sentence 2 continues:
//     idx=17 -> "magna", idx=7 -> "elit", idx=18 -> "aliqua",
//     idx=13 -> "ut",    idx=8 -> "sed",  idx=16 -> "dolore"
//   lo_paragraph(2) = "Tempor et magna elit ut elit. Magna elit aliqua ut sed dolore."
//
// Seed 99 trace: lo_words(5) = "elit adipiscing amet aliqua consectetur"

import std/text/lorem
import std/util/prng

fn cks(got, expected, label)
    if got != expected
        print("FAIL " + label + ": got '" + got + "' expected '" + expected + "'")
        exit(1)

fn cki(got: int, expected: int, label)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn ckt(condition: int, label)
    if condition == 0
        print("FAIL " + label)
        exit(1)

// Count space-separated tokens in s.
fn _count_tokens(s: string) -> int
    if len(s) == 0
        return 0
    let count = 1
    let i = 0
    while i < len(s)
        if char_at(s, i) == " "
            count = count + 1
        i = i + 1
    count

// Return the k-th space-separated token (0-based).
fn _token(s: string, k: int) -> string
    let tok = ""
    let ti = 0
    let i = 0
    while i < len(s)
        let c = char_at(s, i)
        if c == " "
            if ti == k
                return tok
            ti = ti + 1
            tok = ""
        else
            tok = tok + c
        i = i + 1
    tok

fn main()
    let seed42 = prng_seed(42)
    let seed99 = prng_seed(99)

    // ── KAT 1: lo_words(5, seed42) exact value ────────────────────────────
    let r5 = lo_words(5, seed42)
    cks(r5[0], "tempor et magna elit ut", "lo_words_5_seed42")

    // ── KAT 2: result has exactly 5 space-separated tokens ────────────────
    cki(_count_tokens(r5[0]), 5, "lo_words_5_token_count")

    // ── KAT 3: every token is in the vocabulary ────────────────────────────
    let w0 = _token(r5[0], 0)
    let w1 = _token(r5[0], 1)
    let w2 = _token(r5[0], 2)
    let w3 = _token(r5[0], 3)
    let w4 = _token(r5[0], 4)
    ckt(lo_in_vocab(w0), "w0_in_vocab")
    ckt(lo_in_vocab(w1), "w1_in_vocab")
    ckt(lo_in_vocab(w2), "w2_in_vocab")
    ckt(lo_in_vocab(w3), "w3_in_vocab")
    ckt(lo_in_vocab(w4), "w4_in_vocab")

    // ── KAT 4: same seed -> identical string (reproducibility) ────────────
    let r5b = lo_words(5, seed42)
    cks(r5b[0], r5[0], "lo_words_reproducible")

    // ── KAT 5: lo_sentence exact value + structural constraints ───────────
    let rs = lo_sentence(seed42)
    cks(rs[0], "Tempor et magna elit ut elit.", "lo_sentence_seed42")
    // Must end with "."
    let slen = len(rs[0])
    cks(char_at(rs[0], slen - 1), ".", "lo_sentence_ends_dot")
    // Must start with uppercase (first char is "T")
    cks(char_at(rs[0], 0), "T", "lo_sentence_starts_upper")

    // ── KAT 6: lo_paragraph(2, seed42) exact value ────────────────────────
    let rp = lo_paragraph(2, seed42)
    cks(rp[0], "Tempor et magna elit ut elit. Magna elit aliqua ut sed dolore.", "lo_paragraph_2_seed42")

    // ── KAT 7: different seed -> different words ───────────────────────────
    let r5s99 = lo_words(5, seed99)
    cks(r5s99[0], "elit adipiscing amet aliqua consectetur", "lo_words_5_seed99")
    ckt((r5[0] != r5s99[0]), "different_seeds_different_words")

    // ── KAT 8: lo_paragraph(0, state) -> empty string, state unchanged ────
    let rp0 = lo_paragraph(0, seed42)
    cks(rp0[0], "", "lo_paragraph_0_empty")
    cki(rp0[1], seed42, "lo_paragraph_0_state_unchanged")

    // ── KAT 9: lo_words(1, seed42) returns exactly one token in vocab ─────
    let r1 = lo_words(1, seed42)
    cki(_count_tokens(r1[0]), 1, "lo_words_1_single_token")
    ckt(lo_in_vocab(r1[0]), "lo_words_1_in_vocab")

    // ── KAT 10: lo_sentence starts uppercase, ends dot, all words in vocab ─
    let rs99 = lo_sentence(seed99)
    let fc = char_at(rs99[0], 0)
    // First char must be A-Z (code 65-90)
    let fcode = ord(fc)
    ckt((fcode >= 65), "lo_sentence_seed99_upper_ge")
    ckt((fcode <= 90), "lo_sentence_seed99_upper_le")
    let slen99 = len(rs99[0])
    cks(char_at(rs99[0], slen99 - 1), ".", "lo_sentence_seed99_ends_dot")

    print("_lorem_test passed")
