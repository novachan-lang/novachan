fn cp_str(c)
    from_codepoint(c)

fn main()
    // é (U+00E9 precomposed) NFD -> e (U+0065) + combining acute (U+0301)
    let e_acute = cp_str(233)
    let d = normalize_nfd(e_acute)
    assert(char_count(d) == 2, "nfd e-acute = 2 cps")
    let dc = code_points(d)
    assert(dc[0] == 101, "base e 0x65")
    assert(dc[1] == 769, "combining acute 0x301")

    // NFC recomposes back to é
    let c = normalize_nfc(d)
    assert(char_count(c) == 1, "nfc back to 1 cp")
    assert(code_points(c)[0] == 233, "nfc == e-acute")

    // Hangul GA (U+AC00) -> L(U+1100) + V(U+1161), algorithmic
    let ga = cp_str(44032)
    let gad = normalize_nfd(ga)
    assert(char_count(gad) == 2, "hangul nfd = 2")
    let gc = code_points(gad)
    assert(gc[0] == 4352, "hangul L 0x1100")
    assert(gc[1] == 4449, "hangul V 0x1161")
    assert(code_points(normalize_nfc(gad))[0] == 44032, "hangul recompose")

    // pass-through: ASCII unchanged
    assert(normalize_nfd("hello") == "hello", "ascii nfd identity")
    assert(normalize_nfc("hello") == "hello", "ascii nfc identity")

    // idempotence
    assert(normalize_nfd(d) == d, "nfd idempotent")
    assert(normalize_nfc(c) == c, "nfc idempotent")

    // multi-mark canonical ordering: e + U+0323 (below,CCC220) + U+0301 (above,CCC230)
    // canonical order keeps 0323 before 0301 (220 < 230); NFC composes to e-dot-below + acute? 
    // at minimum NFD must reorder marks by CCC deterministically
    let multi = cp_str(101) + cp_str(769) + cp_str(803)   // e + acute(230) + dot-below(220)
    let multi_nfd = normalize_nfd(multi)
    let mc = code_points(multi_nfd)
    assert(mc[0] == 101, "multi base e")
    assert(mc[1] == 803, "dot-below(220) reordered before acute(230)")
    assert(mc[2] == 769, "acute(230) after")

    print("normx ok")
