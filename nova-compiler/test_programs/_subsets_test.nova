import std/combinatorics/subsets

// cki — check integer equality
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL subsets " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb — check bool equality
fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL subsets " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

// list_to_str — convert int list to string
fn list_to_str(xs) -> string
    let s = "["
    let i = 0
    let n = len(xs)
    while i < n
        if i > 0
            s = s + ","
        s = s + str(xs[i])
        i = i + 1
    s = s + "]"
    s

// cks — check string equality
fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL subsets " + label + ": got=" + got + " want=" + want)
        exit(1)

// list_eq — check two int lists are equal
fn list_eq(a, b) -> bool
    if len(a) != len(b)
        return false
    let i = 0
    while i < len(a)
        if a[i] != b[i]
            return false
        i = i + 1
    true

// contains_subset — check if any element of xss equals target
fn contains_subset(xss, target) -> bool
    let i = 0
    while i < len(xss)
        if list_eq(xss[i], target)
            return true
        i = i + 1
    false

fn main()
    // --- sub_count ---
    cki("count0", sub_count(0), 1)
    cki("count1", sub_count(1), 2)
    cki("count2", sub_count(2), 4)
    cki("count3", sub_count(3), 8)
    cki("count4", sub_count(4), 16)

    // --- sub_k_count ---
    cki("kcount_5_2", sub_k_count(5, 2), 10)
    cki("kcount_4_2", sub_k_count(4, 2), 6)
    cki("kcount_3_0", sub_k_count(3, 0), 1)
    cki("kcount_3_3", sub_k_count(3, 3), 1)
    cki("kcount_5_0", sub_k_count(5, 0), 1)
    cki("kcount_5_5", sub_k_count(5, 5), 1)
    cki("kcount_6_3", sub_k_count(6, 3), 20)

    // --- sub_all([1,2,3]) ---
    let xs3 = [1, 2, 3]
    let all3 = sub_all(xs3)
    cki("all_3_len", len(all3), 8)

    // First subset is always [] (mask 0)
    cks("all_3_mask0", list_to_str(all3[0]), "[]")
    // mask 1 = [1], mask 2 = [2], mask 3 = [1,2], mask 4 = [3], mask 5=[1,3], mask 6=[2,3], mask 7=[1,2,3]
    cks("all_3_mask1", list_to_str(all3[1]), "[1]")
    cks("all_3_mask2", list_to_str(all3[2]), "[2]")
    cks("all_3_mask3", list_to_str(all3[3]), "[1,2]")
    cks("all_3_mask4", list_to_str(all3[4]), "[3]")
    cks("all_3_mask5", list_to_str(all3[5]), "[1,3]")
    cks("all_3_mask6", list_to_str(all3[6]), "[2,3]")
    cks("all_3_mask7", list_to_str(all3[7]), "[1,2,3]")

    // Must contain each of the 4 subsets of [1,2]
    let xs2 = [1, 2]
    let all2 = sub_all(xs2)
    cki("all_2_len", len(all2), 4)

    let empty_list = []
    let list1 = [1]
    let list2 = [2]
    let list12 = [1, 2]
    ckb("all_2_has_empty", contains_subset(all2, empty_list), true)
    ckb("all_2_has_1", contains_subset(all2, list1), true)
    ckb("all_2_has_2", contains_subset(all2, list2), true)
    ckb("all_2_has_12", contains_subset(all2, list12), true)

    // Also verify sub_all([1,2,3]) has all four specific subsets
    ckb("all3_has_empty", contains_subset(all3, empty_list), true)
    ckb("all3_has_1", contains_subset(all3, [1]), true)
    ckb("all3_has_2", contains_subset(all3, [2]), true)
    ckb("all3_has_12", contains_subset(all3, [1, 2]), true)

    // sub_all([]) = [[]]
    let xs0 = []
    let all0 = sub_all(xs0)
    cki("all_0_len", len(all0), 1)
    cks("all_0_0", list_to_str(all0[0]), "[]")

    // --- sub_k ---
    // sub_k([1,2,3], 0) = [[]]
    let k0 = sub_k(xs3, 0)
    cki("k_3_0_len", len(k0), 1)
    cks("k_3_0_0", list_to_str(k0[0]), "[]")

    // sub_k([1,2,3], 1) = [[1],[2],[3]]
    let k1 = sub_k(xs3, 1)
    cki("k_3_1_len", len(k1), 3)
    cks("k_3_1_0", list_to_str(k1[0]), "[1]")
    cks("k_3_1_1", list_to_str(k1[1]), "[2]")
    cks("k_3_1_2", list_to_str(k1[2]), "[3]")

    // sub_k([1,2,3], 2) = [[1,2],[1,3],[2,3]]
    let k2 = sub_k(xs3, 2)
    cki("k_3_2_len", len(k2), 3)
    cks("k_3_2_0", list_to_str(k2[0]), "[1,2]")
    cks("k_3_2_1", list_to_str(k2[1]), "[1,3]")
    cks("k_3_2_2", list_to_str(k2[2]), "[2,3]")

    // sub_k([1,2,3], 3) = [[1,2,3]]
    let k3 = sub_k(xs3, 3)
    cki("k_3_3_len", len(k3), 1)
    cks("k_3_3_0", list_to_str(k3[0]), "[1,2,3]")

    // sub_k([1,2,3], 4) = [] (impossible)
    let k4 = sub_k(xs3, 4)
    cki("k_3_4_len", len(k4), 0)

    // sub_k([1,2,3,4], 2) has 6 elements = C(4,2)
    let xs4 = [1, 2, 3, 4]
    let k42 = sub_k(xs4, 2)
    cki("k_4_2_len", len(k42), 6)

    // sum of sub_k sizes over k=0..3 = 2^3 = 8
    let total_check = len(k0) + len(k1) + len(k2) + len(k3)
    cki("k_sum_equals_power", total_check, 8)

    // --- sub_nonempty ---
    let ne3 = sub_nonempty(xs3)
    cki("nonempty_3_len", len(ne3), 7)

    let ne0 = sub_nonempty(xs0)
    cki("nonempty_0_len", len(ne0), 0)

    let ne1 = sub_nonempty([5])
    cki("nonempty_1_len", len(ne1), 1)
    cks("nonempty_1_0", list_to_str(ne1[0]), "[5]")

    // --- sub_unrank ---
    // mask 0 over [1,2,3] = []
    let ur0 = sub_unrank(0, xs3)
    cks("unrank_0", list_to_str(ur0), "[]")
    // mask 5 = 101 in binary = items[0] and items[2] = [1,3]
    let ur5 = sub_unrank(5, xs3)
    cks("unrank_5", list_to_str(ur5), "[1,3]")
    // mask 7 = 111 = all = [1,2,3]
    let ur7 = sub_unrank(7, xs3)
    cks("unrank_7", list_to_str(ur7), "[1,2,3]")

    // --- sub_rank (treating subset values as bit positions) ---
    // sub_rank([0,2], 3) = bit 0 + bit 2 = 1 + 4 = 5
    let rk = sub_rank([0, 2], 3)
    cki("rank_02_3", rk, 5)
    // sub_rank([0,1,2], 3) = 1+2+4 = 7
    let rk7 = sub_rank([0, 1, 2], 3)
    cki("rank_012_3", rk7, 7)
    // sub_rank([], 3) = 0
    let rk0 = sub_rank([], 3)
    cki("rank_empty_3", rk0, 0)

    // --- sub_complement ---
    // complement of [1,3] in [1,2,3] = [2]
    let comp = sub_complement([1, 3], xs3)
    cks("complement_13", list_to_str(comp), "[2]")
    // complement of [] = all items
    let compfull = sub_complement([], xs3)
    cks("complement_empty", list_to_str(compfull), "[1,2,3]")
    // complement of [1,2,3] = []
    let compempty = sub_complement([1, 2, 3], xs3)
    cks("complement_all", list_to_str(compempty), "[]")

    // --- sub_contains ---
    ckb("contains_2_in_123", sub_contains([1, 2, 3], 2), true)
    ckb("contains_5_in_123", sub_contains([1, 2, 3], 5), false)
    ckb("contains_empty", sub_contains([], 1), false)
    ckb("contains_single", sub_contains([7], 7), true)

    print("PASS _subsets_test")
