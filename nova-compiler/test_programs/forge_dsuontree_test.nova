import forge_dsuontree as dot

fn check(cond: bool, label: str)
    if cond == false
        print("FAIL: " + label)

// Brute-force: build children, then for each node count distinct colors / mode in its subtree.
fn brute_children(n: int, parent: list) -> list
    let ch = []
    let i = 0
    while i < n
        push(ch, [])
        i = i + 1
    let v = 0
    while v < n
        if parent[v] >= 0
            push(ch[parent[v]], v)
        v = v + 1
    return ch

// collect all nodes in subtree(v) via iterative DFS
fn subtree_nodes(v: int, children: list) -> list
    let out = []
    let stack = [v]
    while len(stack) > 0
        let node = stack[len(stack) - 1]
        let ns = []
        let si = 0
        while si < len(stack) - 1
            push(ns, stack[si])
            si = si + 1
        stack = ns
        push(out, node)
        let ch = children[node]
        let ci = 0
        while ci < len(ch)
            push(stack, ch[ci])
            ci = ci + 1
    return out

fn brute_distinct(v: int, children: list, color: list) -> int
    let nodes = subtree_nodes(v, children)
    let seen = {}
    let cnt = 0
    let i = 0
    while i < len(nodes)
        let key = str(color[nodes[i]])
        if get(seen, key, 0) == 0
            seen[key] = 1
            cnt = cnt + 1
        i = i + 1
    return cnt

fn brute_mode(v: int, children: list, color: list) -> int
    let nodes = subtree_nodes(v, children)
    let freq = {}
    let i = 0
    while i < len(nodes)
        let key = str(color[nodes[i]])
        freq[key] = get(freq, key, 0) + 1
        i = i + 1
    let ks = keys(freq)
    let mx = 0
    let j = 0
    while j < len(ks)
        let f = get(freq, ks[j], 0)
        if f > mx
            mx = f
        j = j + 1
    return mx

// TEST 1: small tree
//        0(c=1)
//       /      \
//      1(c=2)   2(c=1)
//     /  \        \
//    3(c=2) 4(c=3) 5(c=1)
let parent1 = [0 - 1, 0, 0, 1, 1, 2]
let color1 = [1, 2, 1, 2, 3, 1]
let dist1 = dot.dot_distinct_per_subtree(6, parent1, 0, color1)
// subtree(0) = {1,2,1,2,3,1} colors {1,2,3} = 3
check(dist1[0] == 3, "distinct subtree(0) = 3")
// subtree(1) = {2,2,3} colors {2,3} = 2
check(dist1[1] == 2, "distinct subtree(1) = 2")
// subtree(2) = {1,1} colors {1} = 1
check(dist1[2] == 1, "distinct subtree(2) = 1")
// leaves
check(dist1[3] == 1, "distinct subtree(3) = 1")
check(dist1[4] == 1, "distinct subtree(4) = 1")
check(dist1[5] == 1, "distinct subtree(5) = 1")

// mode counts
let mode1 = dot.dot_mode_count_per_subtree(6, parent1, 0, color1)
// subtree(0): color1 appears 3 times (nodes 0,2,5), mode = 3
check(mode1[0] == 3, "mode subtree(0) = 3")
// subtree(1): color2 twice (nodes 1,3), color3 once -> mode 2
check(mode1[1] == 2, "mode subtree(1) = 2")
// subtree(2): color1 twice -> mode 2
check(mode1[2] == 2, "mode subtree(2) = 2")

// TEST 2: chain
let parent2 = [0 - 1, 0, 1, 2, 3]
let color2 = [5, 5, 6, 6, 5]
let dist2 = dot.dot_distinct_per_subtree(5, parent2, 0, color2)
// subtree(0) = all {5,5,6,6,5} -> {5,6} = 2
check(dist2[0] == 2, "chain distinct subtree(0) = 2")
// subtree(2) = {6,6,5} -> {5,6} = 2
check(dist2[2] == 2, "chain distinct subtree(2) = 2")
// subtree(4) = {5} -> 1
check(dist2[4] == 1, "chain distinct subtree(4) = 1")

// TEST 3: DECISIVE brute-force cross-check on random trees for BOTH distinct and mode
let ok_d = true
let ok_m = true
let seed = 13579
let tc = 0
while tc < 30
    seed = (seed * 1103515245 + 12345) % 2147483648
    let n = seed % 20 + 2  // 2..21 nodes
    let parent = [0 - 1]
    let color = []
    seed = (seed * 1103515245 + 12345) % 2147483648
    push(color, seed % 6)
    let v = 1
    while v < n
        seed = (seed * 1103515245 + 12345) % 2147483648
        push(parent, seed % v)
        seed = (seed * 1103515245 + 12345) % 2147483648
        push(color, seed % 6)  // colors 0..5
        v = v + 1
    let children = brute_children(n, parent)
    let dist = dot.dot_distinct_per_subtree(n, parent, 0, color)
    let mode = dot.dot_mode_count_per_subtree(n, parent, 0, color)
    let u = 0
    while u < n
        let ed = brute_distinct(u, children, color)
        if dist[u] != ed
            ok_d = false
            print("DIST MISMATCH tc=" + str(tc) + " u=" + str(u) + " exp=" + str(ed) + " got=" + str(dist[u]))
        let em = brute_mode(u, children, color)
        if mode[u] != em
            ok_m = false
            print("MODE MISMATCH tc=" + str(tc) + " u=" + str(u) + " exp=" + str(em) + " got=" + str(mode[u]))
        u = u + 1
    tc = tc + 1
check(ok_d, "DECISIVE: distinct-per-subtree matches brute over 30 random trees, ALL nodes")
check(ok_m, "DECISIVE: mode-count-per-subtree matches brute over 30 random trees, ALL nodes")

print("forge_dsuontree: KAT done")
