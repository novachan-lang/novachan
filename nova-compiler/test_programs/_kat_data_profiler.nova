import forge_data_profiler

fn main()
    let s = dp_new()
    s = dp_add_column(s, "age", "int")
    s = dp_add_column(s, "score", "float")
    s = dp_add_column(s, "name", "string")

    assert(dp_column_count(s) == 3, "3 columns")

    s = dp_record(s, "age", 30)
    s = dp_record(s, "age", 25)
    s = dp_record(s, "age", 40)
    s = dp_record(s, "age", 25)
    s = dp_record(s, "age", "")

    let c = dp_count(s, "age")
    assert(is_ok(c), "age count ok")
    assert(unwrap(c) == 4, "4 non-null age values")

    let nc = dp_null_count(s, "age")
    assert(is_ok(nc), "age null count ok")
    assert(unwrap(nc) == 1, "1 null age value")

    let mn = dp_min(s, "age")
    assert(is_ok(mn), "age min ok")
    assert(unwrap(mn) == "25", "age min is 25")

    let mx = dp_max(s, "age")
    assert(is_ok(mx), "age max ok")
    assert(unwrap(mx) == "40", "age max is 40")

    let mean = dp_mean(s, "age")
    assert(is_ok(mean), "age mean ok")
    assert(unwrap(mean) == 30, "age mean is 30 (int div)")

    let uc = dp_unique_count(s, "age")
    assert(is_ok(uc), "age unique count ok")
    assert(unwrap(uc) == 3, "3 unique age values (30,25,40)")

    s = dp_record(s, "score", 1.5)
    s = dp_record(s, "score", 2.5)
    let smean = dp_mean(s, "score")
    assert(is_ok(smean), "score mean ok")
    assert(unwrap(smean) == 2.0, "score mean is 2.0")

    s = dp_record(s, "name", "bob")
    s = dp_record(s, "name", "alice")
    let smin = dp_min(s, "name")
    assert(is_ok(smin), "name min ok")
    assert(unwrap(smin) == "alice", "name min is alice")

    assert(dp_total_records(s) == 9, "9 total records")

    assert(is_err(dp_count(s, "missing")), "unknown column errors")
    let empty = dp_new()
    empty = dp_add_column(empty, "x", "int")
    assert(is_err(dp_min(empty, "x")), "no data errors")

    print("DATA-PROFILER KAT PASS")
