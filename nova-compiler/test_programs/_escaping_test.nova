import std/framing/escaping

// ── Helpers ──────────────────────────────────────────────────────────────────

fn list_eq(a, b) -> bool
    let na = len(a)
    let nb = len(b)
    if na != nb
        return false
    let i = 0
    while i < na
        if a[i] != b[i]
            return false
        i = i + 1
    true

fn ck_int(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck_bool(label, got, want)
    let g = 0
    if got
        g = 1
    let w = 0
    if want
        w = 1
    if g != w
        print("FAIL " + label + ": got=" + str(g) + " want=" + str(w))
        exit(1)

fn ck_list(label, got, want)
    if not list_eq(got, want)
        print("FAIL " + label + ": list mismatch len_got=" + str(len(got)) + " len_want=" + str(len(want)))
        exit(1)

fn ck_str(label, got, want)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn main()
    // ── KAT 1: esc_simple([0xC0,1], 0xDB, [0xC0]) == [0xDB, 0xE0, 1] ─────────
    // 0xC0 XOR 0x20 = 0xE0; 1 passes through
    let data1 = []
    push(data1, 0xC0)
    push(data1, 1)
    let specials1 = []
    push(specials1, 0xC0)
    let got1 = esc_simple(data1, 0xDB, specials1)
    let want1 = []
    push(want1, 0xDB)
    push(want1, 0xE0)
    push(want1, 1)
    ck_list("esc_simple_C0", got1, want1)

    // ── KAT 2: ROUND-TRIP esc_simple / esc_unsimple for [0xC0,0xDB,1,2] ──────
    let data2 = []
    push(data2, 0xC0)
    push(data2, 0xDB)
    push(data2, 1)
    push(data2, 2)
    let specials2 = []
    push(specials2, 0xC0)
    push(specials2, 0xDB)
    let enc2 = esc_simple(data2, 0xDB, specials2)
    let dec2 = esc_unsimple(enc2, 0xDB)
    ck_list("esc_roundtrip_C0_DB_1_2", dec2, data2)

    // ── KAT 3: ROUND-TRIP for [1,2,3] ─────────────────────────────────────────
    let data3 = []
    push(data3, 1)
    push(data3, 2)
    push(data3, 3)
    let specials3 = []
    push(specials3, 0xC0)
    push(specials3, 0xDB)
    let enc3 = esc_simple(data3, 0xDB, specials3)
    let dec3 = esc_unsimple(enc3, 0xDB)
    ck_list("esc_roundtrip_1_2_3", dec3, data3)

    // ── KAT 4: ROUND-TRIP for [] (empty) ──────────────────────────────────────
    let data4 = []
    let specials4 = []
    push(specials4, 0xC0)
    let enc4 = esc_simple(data4, 0xDB, specials4)
    let dec4 = esc_unsimple(enc4, 0xDB)
    ck_list("esc_roundtrip_empty", dec4, data4)

    // ── KAT 5: esc_needs_escaping ─────────────────────────────────────────────
    let sp5 = []
    push(sp5, 0xC0)
    ck_bool("esc_needs_C0", esc_needs_escaping(0xC0, sp5), true)
    ck_bool("esc_needs_01", esc_needs_escaping(0x01, sp5), false)

    // ── KAT 6: esc_count ──────────────────────────────────────────────────────
    let data6 = []
    push(data6, 0xC0)
    push(data6, 1)
    push(data6, 0xDB)
    push(data6, 2)
    push(data6, 0xC0)
    let sp6 = []
    push(sp6, 0xC0)
    push(sp6, 0xDB)
    ck_int("esc_count", esc_count(data6, sp6), 3)

    // ── KAT 7: esc_c_style newline + backslash ────────────────────────────────
    // Build a string containing LF then backslash then quote
    let raw7 = chr(10) + chr(92) + chr(34)
    let escaped7 = esc_c_style(raw7)
    // Expected: backslash + n + backslash + backslash + backslash + quote
    // esc_c_style outputs: chr(92)+"n" for LF, chr(92)+chr(92) for backslash, chr(92)+chr(34) for quote
    let bs7 = chr(92)
    let want7 = bs7 + "n" + bs7 + bs7 + bs7 + chr(34)
    ck_str("esc_c_style", escaped7, want7)

    // ── KAT 8: esc_c_unstyle inverts esc_c_style ─────────────────────────────
    let rt8 = chr(10) + chr(92) + chr(34) + chr(9) + "A"
    let enc8 = esc_c_style(rt8)
    let dec8 = esc_c_unstyle(enc8)
    ck_str("esc_c_roundtrip", dec8, rt8)

    // ── KAT 9: esc_hex_dump_escape ────────────────────────────────────────────
    // [0x41, 0x00, 0x7F] -> "A\x00\x7f"
    let data9 = []
    push(data9, 0x41)
    push(data9, 0x00)
    push(data9, 0x7F)
    let got9 = esc_hex_dump_escape(data9)
    let want9 = "A" + chr(92) + "x00" + chr(92) + "x7f"
    ck_str("esc_hex_dump", got9, want9)

    // ── KAT 10: esc_escape / esc_unescape round-trip ─────────────────────────
    // SLIP-style: ESC=0xDB; map: 0xC0->0xDC, 0xDB->0xDD
    let esc_byte = 0xDB
    let map_from = []
    push(map_from, 0xC0)
    push(map_from, 0xDB)
    let map_to = []
    push(map_to, 0xDC)
    push(map_to, 0xDD)
    let data10 = []
    push(data10, 0xC0)
    push(data10, 0xDB)
    push(data10, 0x01)
    let enc10 = esc_escape(data10, esc_byte, map_from, map_to)
    let dec10 = esc_unescape(enc10, esc_byte, map_to, map_from)
    ck_list("esc_escape_roundtrip", dec10, data10)

    // ── KAT 11: esc_simple where the escape byte itself is in specials ─────────
    // esc=0xDB, specials=[0xC0, 0xDB]
    // Payload contains only 0xDB -> should produce [0xDB, 0xFB] (0xDB^0x20=0xFB)
    let data11 = []
    push(data11, 0xDB)
    let sp11 = []
    push(sp11, 0xC0)
    push(sp11, 0xDB)
    let enc11 = esc_simple(data11, 0xDB, sp11)
    let dec11 = esc_unsimple(enc11, 0xDB)
    ck_list("esc_simple_esc_itself", dec11, data11)

    // ── KAT 12: esc_c_style with TAB ─────────────────────────────────────────
    let tab_str = "A" + chr(9) + "B"
    let escaped_tab = esc_c_style(tab_str)
    // TAB (chr(9)) escapes to backslash + "t"
    let want_tab = "A" + chr(92) + "t" + "B"
    ck_str("esc_c_style_tab", escaped_tab, want_tab)

    let roundtrip_tab = esc_c_unstyle(escaped_tab)
    ck_str("esc_c_unstyle_tab", roundtrip_tab, tab_str)

    print("PASS _escaping_test")
