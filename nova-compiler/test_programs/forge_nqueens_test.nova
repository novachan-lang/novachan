import forge_nqueens

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

// validate a placement: no two queens share row/col/diagonal
fn valid_placement(p: list) -> int
    let n = len(p)
    let ok = 1
    let i = 0
    while i < n
        let j = i + 1
        while j < n
            if p[i] == p[j]
                ok = 0
            let dr = j - i
            let dc = p[j] - p[i]
            if dc < 0
                dc = 0 - dc
            if dr == dc
                ok = 0
            j = j + 1
        i = i + 1
    ok

fn main()
    let fails = 0

    // the famous solution-count sequence
    fails = fails + expect("n1", str(nqueens_count(1)), "1")
    fails = fails + expect("n2", str(nqueens_count(2)), "0")
    fails = fails + expect("n3", str(nqueens_count(3)), "0")
    fails = fails + expect("n4", str(nqueens_count(4)), "2")
    fails = fails + expect("n5", str(nqueens_count(5)), "10")
    fails = fails + expect("n6", str(nqueens_count(6)), "4")
    fails = fails + expect("n7", str(nqueens_count(7)), "40")
    fails = fails + expect("n8", str(nqueens_count(8)), "92")

    // solution is valid and complete
    let s4 = nqueens_solution(4)
    fails = fails + expect("s4_len", str(len(s4)), "4")
    fails = fails + expect("s4_valid", str(valid_placement(s4)), "1")
    let s8 = nqueens_solution(8)
    fails = fails + expect("s8_len", str(len(s8)), "8")
    fails = fails + expect("s8_valid", str(valid_placement(s8)), "1")

    // no solution for n=2,3 -> empty placement
    fails = fails + expect("s2_none", str(len(nqueens_solution(2))), "0")
    fails = fails + expect("s3_none", str(len(nqueens_solution(3))), "0")
    fails = fails + expect("s1", str(len(nqueens_solution(1))), "1")

    if fails == 0
        print("forge_nqueens: all passed")
    else
        print("forge_nqueens: " + str(fails) + " FAILED")
