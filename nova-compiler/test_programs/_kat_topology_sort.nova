import forge_topology_sort

fn main()
    let t = ts_new()
    t = ts_add_node(t, "A")
    t = ts_add_node(t, "B")
    t = ts_add_node(t, "C")
    t = ts_add_node(t, "D")
    t = ts_add_edge(t, "A", "B")
    t = ts_add_edge(t, "A", "C")
    t = ts_add_edge(t, "B", "D")
    t = ts_add_edge(t, "C", "D")
    assert(ts_node_count(t) == 4, "4 nodes")
    assert(ts_edge_count(t) == 4, "4 edges")

    let r = ts_sort(t)
    assert(r["has_cycle"] == 0, "no cycle")
    assert(r["count"] == 4, "all sorted")
    assert(r["0"] == "A", "A first")
    assert(r["3"] == "D", "D last")

    let t2 = ts_new()
    t2 = ts_add_node(t2, "X")
    t2 = ts_add_node(t2, "Y")
    t2 = ts_add_edge(t2, "X", "Y")
    t2 = ts_add_edge(t2, "Y", "X")
    let r2 = ts_sort(t2)
    assert(r2["has_cycle"] == 1, "cycle detected")

    print("TOPOLOGY-SORT KAT PASS")
