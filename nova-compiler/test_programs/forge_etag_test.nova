// forge_etag_test -- conditional GET for static files: a content-hash ETag, and a matching
// If-None-Match returns 304 (no body) so browsers skip re-downloading unchanged assets.
import forge

fn main()
    let a = forge.app()
    forge.static(a, "/assets", "_static_fixture")

    // first GET -> 200 with an ETag
    let r1: Response = forge.dispatch_req(a, forge.build_request("GET /assets/style.css HTTP/1.1\r\n\r\n", 0))
    assert(r1.status == 200, "first GET -> 200")
    assert(contains(r1.headers, "ETag"), "ETag header present")
    let etag = r1.headers["ETag"]
    assert(len(etag) > 2, "ETag is a non-empty quoted hash")
    print("PASS: 200 + ETag")

    // conditional GET with the matching ETag -> 304, empty body
    let r2: Response = forge.dispatch_req(a, forge.build_request("GET /assets/style.css HTTP/1.1\r\nIf-None-Match: " + etag + "\r\n\r\n", 0))
    assert(r2.status == 304, "matching If-None-Match -> 304")
    assert(r2.body == "", "304 has no body")
    assert(r2.headers["ETag"] == etag, "304 echoes the ETag")
    print("PASS: 304 on matching ETag")

    // stale ETag -> full 200 (fresh content)
    let r3: Response = forge.dispatch_req(a, forge.build_request("GET /assets/style.css HTTP/1.1\r\nIf-None-Match: " + chr(34) + "stale" + chr(34) + "\r\n\r\n", 0))
    assert(r3.status == 200, "stale If-None-Match -> 200")
    assert(find(r3.body, "color") >= 0, "200 carries the file body")
    print("PASS: 200 on stale ETag")
    print("forge_etag_test passed")
