// KAT for prism/ui/prism_ui_upload.nova (PRISM_ROADMAP.md milestone MB.21, the `ui/` composition
// layer's file upload/attachment components: dropzone, file_item, file_list, preview).
//
// Every expected shape below is hand-computed from `prism_node.prism_node_new`'s own depth/count
// rule (leaf: depth=1, count=1; branch: depth=max(child depths)+1, count=1+sum(child counts)) --
// never taken on faith from the implementation. Proves, against concrete expected values:
//   1. Status: all 3 values construct via their cross-module ctors, the exhaustive name match is
//      correct, and the exhaustive icon match maps each to a DISTINCT icon
//      (chevron_up/check/close).
//   2. Dropzone: exact stack(d=2,c=4) with no max size, exact stack(d=2,c=5) with one; accept text
//      is the joined ", "-separated list with the "Accepts: " prefix; max-size text is the bare
//      number with no invented unit; rejects an empty label, an empty accept list, a non-string
//      accept element (named by index and type), and a present max_size that is <= 0 (both the
//      exact-zero and negative cases).
//   3. File item: exact band(d=2,c=5) for all 3 statuses, icon/status-text pairs proven DISTINCT
//      per status (uploading->chevron_up, done->check, failed->close); rejects an empty name and
//      an empty size_text.
//   4. File list: rejects an EMPTY list outright (the dropzone is the empty state for this widget,
//      not this function -- see file header); exact stack(d=3,c=6) over 1 item, exact
//      stack(d=3,c=11) over 2 items; rejects a non-PrismNode element (named by index and actual
//      type).
//   5. Preview: exact stack(d=2,c=3); the art child carries BOTH "source" and "alt" attrs exactly;
//      rejects an empty name, an empty alt (a11y), and an empty source (propagated from
//      prism_content.prism_art unchanged).
//   6. Rejection tally: 12 distinct rejections are proven above, counted explicitly.
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova into
// $NOVA_HOME/lib, so `import prism_node` / `import prism_ui_upload` resolve.
//   ./gen3_test.exe _kat_prism_ui_upload.nova
//   clang -O2 -o _kat_prism_ui_upload.exe _kat_prism_ui_upload.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_ui_upload.exe

import prism_node
import prism_content
import prism_arrange
import prism_ui_upload

let FAILED = [0]

fn _check(label: string, got: string, want: string)
    if got == want
        print("  pass  " + label)
    else
        print("  FAIL  " + label + "  got=" + got + "  want=" + want)
        FAILED[0] = FAILED[0] + 1

fn _check_true(label: string, cond: bool)
    if cond
        print("  pass  " + label)
    else
        print("  FAIL  " + label)
        FAILED[0] = FAILED[0] + 1

fn main()
    let mut rejection_count = 0

    // ── 1. Status: 3 ctors, exhaustive name match, exhaustive icon match, all 3 distinct ────────
    print("== 1. status ==")
    let statuses = [prism_ui_upload.prism_up_uploading(), prism_ui_upload.prism_up_done(), prism_ui_upload.prism_up_failed()]
    _check("status name: uploading", prism_ui_upload.prism_up_status_name(statuses[0]), "uploading")
    _check("status name: done", prism_ui_upload.prism_up_status_name(statuses[1]), "done")
    _check("status name: failed", prism_ui_upload.prism_up_status_name(statuses[2]), "failed")
    let icon_names = []
    for s in statuses
        icon_names.push(prism_content.prism_icon_name(prism_ui_upload.prism_up_status_icon(s)))
    _check("status icon: uploading -> chevron_up", icon_names[0], "chevron_up")
    _check("status icon: done -> check", icon_names[1], "check")
    _check("status icon: failed -> close", icon_names[2], "close")
    let seen_icons = {}
    for nm in icon_names
        seen_icons[nm] = true
    _check("all 3 status icons are pairwise distinct", str(len(seen_icons.keys())), "3")
    print("")

    // ── 2. Dropzone ───────────────────────────────────────────────────────────────────────────
    print("== 2. dropzone ==")

    // No max size: stack[glyph(Plus), label(label), label(accept_text)].
    let dz1 = unwrap(prism_ui_upload.prism_up_dropzone("Drop files here", [".png", ".pdf"], none()))
    _check("dropzone(no max) kind == stack", prism_node.prism_node_kind_str(dz1), "stack")
    _check("dropzone(no max) depth", str(prism_node.prism_node_depth(dz1)), "2")
    _check("dropzone(no max) count", str(prism_node.prism_node_count(dz1)), "4")
    _check("dropzone(no max) child count", str(prism_node.prism_node_child_count(dz1)), "3")
    let dz1_kids = prism_node.prism_node_children(dz1)
    _check("dropzone(no max) child 0 kind == glyph", prism_node.prism_node_kind_str(dz1_kids[0]), "glyph")
    _check("dropzone(no max) child 0 icon == plus", prism_node.prism_node_attr_str(dz1_kids[0], "icon", ""), "plus")
    _check("dropzone(no max) child 1 text == label", prism_node.prism_node_attr_str(dz1_kids[1], "text", ""), "Drop files here")
    _check("dropzone(no max) child 2 text == joined accept", prism_node.prism_node_attr_str(dz1_kids[2], "text", ""), "Accepts: .png, .pdf")

    // With max size: stack[glyph(Plus), label(label), label(accept_text), label(max_text)].
    let dz2 = unwrap(prism_ui_upload.prism_up_dropzone("Upload", [".jpg"], some(5)))
    _check("dropzone(max=5) kind == stack", prism_node.prism_node_kind_str(dz2), "stack")
    _check("dropzone(max=5) depth", str(prism_node.prism_node_depth(dz2)), "2")
    _check("dropzone(max=5) count", str(prism_node.prism_node_count(dz2)), "5")
    _check("dropzone(max=5) child count", str(prism_node.prism_node_child_count(dz2)), "4")
    let dz2_kids = prism_node.prism_node_children(dz2)
    _check("dropzone(max=5) child 2 text == joined accept (single)", prism_node.prism_node_attr_str(dz2_kids[2], "text", ""), "Accepts: .jpg")
    _check("dropzone(max=5) child 3 text == bare number, no invented unit", prism_node.prism_node_attr_str(dz2_kids[3], "text", ""), "Max size: 5")

    // Rejections.
    let dz_empty_label = prism_ui_upload.prism_up_dropzone("", [".png"], none())
    _check_true("dropzone rejects empty up_label", is_err(dz_empty_label))
    rejection_count += 1
    let dz_empty_accept = prism_ui_upload.prism_up_dropzone("Drop", [], none())
    _check_true("dropzone rejects empty up_accept", is_err(dz_empty_accept))
    rejection_count += 1
    let dz_bad_elem = prism_ui_upload.prism_up_dropzone("Drop", [".png", 42], none())
    _check_true("dropzone rejects a non-string up_accept element", is_err(dz_bad_elem))
    if is_err(dz_bad_elem)
        _check_true("dropzone's rejection names the offending index and type", find(unwrap_err(dz_bad_elem), "1") >= 0 and find(unwrap_err(dz_bad_elem), "int") >= 0)
    rejection_count += 1
    let dz_max_zero = prism_ui_upload.prism_up_dropzone("Drop", [".png"], some(0))
    _check_true("dropzone rejects up_max_size == 0", is_err(dz_max_zero))
    rejection_count += 1
    let dz_max_neg = prism_ui_upload.prism_up_dropzone("Drop", [".png"], some(-3))
    _check_true("dropzone rejects up_max_size < 0", is_err(dz_max_neg))
    rejection_count += 1
    print("")

    // ── 3. File item ──────────────────────────────────────────────────────────────────────────
    print("== 3. file_item ==")

    let fi_up = unwrap(prism_ui_upload.prism_up_file_item("photo.png", "2.4 MB", prism_ui_upload.prism_up_uploading()))
    _check("file_item(uploading) kind == band", prism_node.prism_node_kind_str(fi_up), "band")
    _check("file_item(uploading) depth", str(prism_node.prism_node_depth(fi_up)), "2")
    _check("file_item(uploading) count", str(prism_node.prism_node_count(fi_up)), "5")
    _check("file_item(uploading) child count", str(prism_node.prism_node_child_count(fi_up)), "4")
    let fi_up_kids = prism_node.prism_node_children(fi_up)
    _check("file_item(uploading) child 0 kind == glyph", prism_node.prism_node_kind_str(fi_up_kids[0]), "glyph")
    _check("file_item(uploading) child 0 icon == chevron_up", prism_node.prism_node_attr_str(fi_up_kids[0], "icon", ""), "chevron_up")
    _check("file_item(uploading) child 1 text == name", prism_node.prism_node_attr_str(fi_up_kids[1], "text", ""), "photo.png")
    _check("file_item(uploading) child 2 text == size", prism_node.prism_node_attr_str(fi_up_kids[2], "text", ""), "2.4 MB")
    _check("file_item(uploading) child 3 text == status name", prism_node.prism_node_attr_str(fi_up_kids[3], "text", ""), "uploading")

    let fi_done = unwrap(prism_ui_upload.prism_up_file_item("doc.pdf", "512 KB", prism_ui_upload.prism_up_done()))
    let fi_done_kids = prism_node.prism_node_children(fi_done)
    _check("file_item(done) child 0 icon == check", prism_node.prism_node_attr_str(fi_done_kids[0], "icon", ""), "check")
    _check("file_item(done) child 3 text == done", prism_node.prism_node_attr_str(fi_done_kids[3], "text", ""), "done")

    let fi_failed = unwrap(prism_ui_upload.prism_up_file_item("bad.exe", "10 MB", prism_ui_upload.prism_up_failed()))
    let fi_failed_kids = prism_node.prism_node_children(fi_failed)
    _check("file_item(failed) child 0 icon == close", prism_node.prism_node_attr_str(fi_failed_kids[0], "icon", ""), "close")
    _check("file_item(failed) child 3 text == failed", prism_node.prism_node_attr_str(fi_failed_kids[3], "text", ""), "failed")

    // Rejections.
    let fi_empty_name = prism_ui_upload.prism_up_file_item("", "1 KB", prism_ui_upload.prism_up_done())
    _check_true("file_item rejects empty up_name", is_err(fi_empty_name))
    rejection_count += 1
    let fi_empty_size = prism_ui_upload.prism_up_file_item("a.png", "", prism_ui_upload.prism_up_done())
    _check_true("file_item rejects empty up_size_text", is_err(fi_empty_size))
    rejection_count += 1
    print("")

    // ── 4. File list ──────────────────────────────────────────────────────────────────────────
    print("== 4. file_list ==")

    // Empty list is a REJECTION here, not a substituted empty state -- see file header.
    let list_empty = prism_ui_upload.prism_up_file_list([])
    _check_true("file_list rejects an empty items list (dropzone is the empty state, not this fn)", is_err(list_empty))
    rejection_count += 1

    // One item: stack(d=3,c=6) over a single band(d=2,c=5).
    let list1 = unwrap(prism_ui_upload.prism_up_file_list([fi_up]))
    _check("file_list(1 item) kind == stack", prism_node.prism_node_kind_str(list1), "stack")
    _check("file_list(1 item) depth", str(prism_node.prism_node_depth(list1)), "3")
    _check("file_list(1 item) count", str(prism_node.prism_node_count(list1)), "6")
    _check("file_list(1 item) child count", str(prism_node.prism_node_child_count(list1)), "1")

    // Two items: stack(d=3,c=11) over two band(d=2,c=5) each.
    let list2 = unwrap(prism_ui_upload.prism_up_file_list([fi_up, fi_done]))
    _check("file_list(2 items) kind == stack", prism_node.prism_node_kind_str(list2), "stack")
    _check("file_list(2 items) depth", str(prism_node.prism_node_depth(list2)), "3")
    _check("file_list(2 items) count", str(prism_node.prism_node_count(list2)), "11")
    let list2_kids = prism_node.prism_node_children(list2)
    _check_true("file_list(2 items) child 0 is fi_up", list2_kids[0].count == 5)
    _check_true("file_list(2 items) child 1 is fi_done", list2_kids[1].count == 5)

    // Rejection: a non-PrismNode element, named by index and actual type.
    let list_bad_elem = prism_ui_upload.prism_up_file_list([fi_up, "not a node"])
    _check_true("file_list rejects a non-PrismNode element", is_err(list_bad_elem))
    if is_err(list_bad_elem)
        _check_true("file_list's rejection names the offending index and type", find(unwrap_err(list_bad_elem), "1") >= 0 and find(unwrap_err(list_bad_elem), "string") >= 0)
    rejection_count += 1
    print("")

    // ── 5. Preview ────────────────────────────────────────────────────────────────────────────
    print("== 5. preview ==")

    let prev1 = unwrap(prism_ui_upload.prism_up_preview("cat.png", "A photo of a cat", "/uploads/cat.png"))
    _check("preview kind == stack", prism_node.prism_node_kind_str(prev1), "stack")
    _check("preview depth", str(prism_node.prism_node_depth(prev1)), "2")
    _check("preview count", str(prism_node.prism_node_count(prev1)), "3")
    _check("preview child count", str(prism_node.prism_node_child_count(prev1)), "2")
    let prev1_kids = prism_node.prism_node_children(prev1)
    _check("preview child 0 kind == art", prism_node.prism_node_kind_str(prev1_kids[0]), "art")
    _check("preview child 0 source attr", prism_node.prism_node_attr_str(prev1_kids[0], "source", ""), "/uploads/cat.png")
    _check("preview child 0 alt attr", prism_node.prism_node_attr_str(prev1_kids[0], "alt", ""), "A photo of a cat")
    _check("preview child 1 text == name", prism_node.prism_node_attr_str(prev1_kids[1], "text", ""), "cat.png")

    // Rejections.
    let prev_empty_name = prism_ui_upload.prism_up_preview("", "alt text", "/x.png")
    _check_true("preview rejects empty up_name", is_err(prev_empty_name))
    rejection_count += 1
    let prev_empty_alt = prism_ui_upload.prism_up_preview("x.png", "", "/x.png")
    _check_true("preview rejects empty up_alt (a11y)", is_err(prev_empty_alt))
    rejection_count += 1
    let prev_empty_source = prism_ui_upload.prism_up_preview("x.png", "alt text", "")
    _check_true("preview rejects empty up_source (propagated from prism_content.prism_art)", is_err(prev_empty_source))
    rejection_count += 1
    print("")

    // ── 6. Rejection tally ────────────────────────────────────────────────────────────────────
    _check_true("rejection tally: 12 distinct rejections proven (dropzone=5, file_item=2, file_list=2, preview=3)", rejection_count == 12)

    // ── Summary ───────────────────────────────────────────────────────────────────────────────
    if FAILED[0] == 0
        print("")
        print("_kat_prism_ui_upload: ALL PASS")
    else
        print("")
        print("_kat_prism_ui_upload: " + str(FAILED[0]) + " FAILURE(S)")
        exit(1)
