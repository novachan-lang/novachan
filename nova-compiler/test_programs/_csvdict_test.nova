// KAT: std/data/csvdict
import std/data/csvdict

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=[" + got + "] want=[" + want + "]")
        exit(1)

// ── Test 1: basic parse ─────────────────────────────────────────────────────
let csv1 = "name,age" + chr(10) + "alice,30" + chr(10) + "bob,25"
let rows1 = cd_parse(csv1)
cki("parse_len", len(rows1), 2)
cks("parse_r0_name", rows1[0]["name"], "alice")
cks("parse_r0_age",  rows1[0]["age"],  "30")
cks("parse_r1_name", rows1[1]["name"], "bob")
cks("parse_r1_age",  rows1[1]["age"],  "25")

// ── Test 2: cd_headers ──────────────────────────────────────────────────────
let hdr_text = "name,age" + chr(10) + "x,y"
let hdrs = cd_headers(hdr_text)
cki("headers_len",  len(hdrs), 2)
cks("headers_0",    hdrs[0],   "name")
cks("headers_1",    hdrs[1],   "age")

// ── Test 3: cd_headers on multi-word columns ────────────────────────────────
let hdr2 = cd_headers("first,last,score" + chr(10) + "a,b,1")
cki("headers2_len", len(hdr2), 3)
cks("headers2_2",   hdr2[2],   "score")

// ── Test 4: cd_write round-trip ─────────────────────────────────────────────
let row_w = {}
row_w["a"] = "1"
row_w["b"] = "2"
let write_rows = []
write_rows.push(row_w)
let write_hdrs = []
write_hdrs.push("a")
write_hdrs.push("b")
let written = cd_write(write_rows, write_hdrs)
cks("write_basic", written, "a,b" + chr(10) + "1,2")

// ── Test 5: quoted field containing comma ───────────────────────────────────
// Input: x\n"a,b"   — the field value should be "a,b" (comma inside quotes)
let qcsv = "x" + chr(10) + chr(34) + "a,b" + chr(34)
let qrows = cd_parse(qcsv)
cki("quoted_len",    len(qrows), 1)
cks("quoted_field",  qrows[0]["x"], "a,b")

// ── Test 6: doubled quote inside quoted field ────────────────────────────────
// Input: x\n"say ""hi"""   — field value should be: say "hi"
let dqcsv = "x" + chr(10) + chr(34) + "say " + chr(34) + chr(34) + "hi" + chr(34) + chr(34) + chr(34)
let dqrows = cd_parse(dqcsv)
cks("double_quote", dqrows[0]["x"], "say " + chr(34) + "hi" + chr(34))

// ── Test 7: cd_write quotes a field containing a comma ──────────────────────
let row_q = {}
row_q["name"] = "Smith, John"
row_q["age"]  = "42"
let qwrite_rows = []
qwrite_rows.push(row_q)
let qwrite_hdrs = []
qwrite_hdrs.push("name")
qwrite_hdrs.push("age")
let qwritten = cd_write(qwrite_rows, qwrite_hdrs)
// Expected: name,age\n"Smith, John",42
let expected_qwrite = "name,age" + chr(10) + chr(34) + "Smith, John" + chr(34) + ",42"
cks("write_quoted_comma", qwritten, expected_qwrite)

// ── Test 8: cd_write quotes a field containing a double-quote ───────────────
let row_dq = {}
row_dq["val"] = "say " + chr(34) + "hello" + chr(34)
let dqwrite_rows = []
dqwrite_rows.push(row_dq)
let dqwrite_hdrs = []
dqwrite_hdrs.push("val")
let dqwritten = cd_write(dqwrite_rows, dqwrite_hdrs)
// Expected: val\n"say ""hello"""
let inner_dq = chr(34) + "say " + chr(34) + chr(34) + "hello" + chr(34) + chr(34) + chr(34)
let expected_dq = "val" + chr(10) + inner_dq
cks("write_quoted_quote", dqwritten, expected_dq)

// ── Test 9: cd_get present and missing ──────────────────────────────────────
let grow = {}
grow["k"] = "v"
cks("get_present", cd_get(grow, "k",     "dflt"), "v")
cks("get_missing", cd_get(grow, "other", "dflt"), "dflt")

// ── Test 10: CRLF tolerance ─────────────────────────────────────────────────
let crlf_csv = "a,b" + chr(13) + chr(10) + "1,2" + chr(13) + chr(10)
let crlf_rows = cd_parse(crlf_csv)
cki("crlf_len",  len(crlf_rows), 1)
cks("crlf_a",    crlf_rows[0]["a"], "1")
cks("crlf_b",    crlf_rows[0]["b"], "2")

// ── Test 11: parse round-trip ────────────────────────────────────────────────
// Write then parse back; verify values match.
let rt_row = {}
rt_row["x"] = "hello,world"
rt_row["y"] = "plain"
let rt_rows = []
rt_rows.push(rt_row)
let rt_hdrs = []
rt_hdrs.push("x")
rt_hdrs.push("y")
let rt_csv = cd_write(rt_rows, rt_hdrs)
let rt_parsed = cd_parse(rt_csv)
cki("roundtrip_len", len(rt_parsed), 1)
cks("roundtrip_x",   rt_parsed[0]["x"], "hello,world")
cks("roundtrip_y",   rt_parsed[0]["y"], "plain")

// ── Test 12: empty rows produce no output ───────────────────────────────────
let sparse_csv = "name,age" + chr(10) + chr(10) + "carol,99"
let sparse_rows = cd_parse(sparse_csv)
cki("sparse_len",   len(sparse_rows), 1)
cks("sparse_name",  sparse_rows[0]["name"], "carol")

print("_csvdict_test passed")
