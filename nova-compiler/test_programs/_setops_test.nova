// KAT for std/collections/setops — set algebra over plain lists (duplicates
// ignored, first-seen order preserved; == used for element equality).
import std/collections/setops

// cki — check int equality; print FAIL and exit(1) on mismatch.
fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// cke — check list-of-int equality element-by-element.
fn cke(label, got, want)
    if len(got) != len(want)
        print("FAIL " + label + ": len got " + str(len(got)) + " want " + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL " + label + "[" + str(i) + "]: got " + str(got[i]) + " want " + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // set_union: a's uniques first (in order), then b's not-already-present; deduped.
    cke("union_basic", setops.set_union([1, 2, 3], [3, 4, 5]), [1, 2, 3, 4, 5])
    cke("union_dedup_both", setops.set_union([1, 1, 2], [2, 2, 3]), [1, 2, 3])
    cke("union_empty_empty", setops.set_union([], []), [])
    cke("union_left_empty", setops.set_union([], [7, 8]), [7, 8])

    // set_intersection: elements of a also in b, deduped, in a's order.
    cke("intersect_basic", setops.set_intersection([1, 2, 3, 4], [2, 4, 6]), [2, 4])
    cke("intersect_disjoint", setops.set_intersection([1, 2, 3], [4, 5, 6]), [])
    cke("intersect_dedup", setops.set_intersection([1, 1, 2, 2], [2, 1]), [1, 2])

    // set_difference: in a but not in b, deduped, in a's order.
    cke("diff_basic", setops.set_difference([1, 2, 3, 4], [2, 4]), [1, 3])
    cke("diff_identical", setops.set_difference([1, 2, 3], [1, 2, 3]), [])
    cke("diff_disjoint", setops.set_difference([1, 2, 3], [4, 5]), [1, 2, 3])

    // set_symdiff: elements in exactly one of a or b.
    cke("symdiff_basic", setops.set_symdiff([1, 2, 3], [3, 4, 5]), [1, 2, 4, 5])
    cke("symdiff_identical", setops.set_symdiff([1, 2, 3], [1, 2, 3]), [])
    cke("symdiff_disjoint", setops.set_symdiff([1, 2], [3, 4]), [1, 2, 3, 4])

    // is_subset: 1 if every element of a is in b, else 0; empty is a subset of anything.
    cki("subset_proper", setops.is_subset([1, 2], [1, 2, 3]), 1)
    cki("subset_missing", setops.is_subset([1, 4], [1, 2, 3]), 0)
    cki("subset_empty_of_any", setops.is_subset([], [1, 2, 3]), 1)
    cki("subset_nonempty_of_empty", setops.is_subset([1], []), 0)

    // set_equal: same elements, ignoring order and duplicates.
    cki("equal_reordered", setops.set_equal([1, 2, 3], [3, 2, 1]), 1)
    cki("equal_dups_ignored", setops.set_equal([1, 2, 2, 3], [3, 1, 2]), 1)
    cki("equal_size_mismatch", setops.set_equal([1, 2, 3], [1, 2]), 0)
    cki("equal_both_empty", setops.set_equal([], []), 1)

    // cross-function invariant: symdiff(a,b) == difference(union(a,b), intersection(a,b)).
    let u = setops.set_union([1, 2, 3], [3, 4, 5])
    let x = setops.set_intersection([1, 2, 3], [3, 4, 5])
    let sd = setops.set_symdiff([1, 2, 3], [3, 4, 5])
    let dm = setops.set_difference(u, x)
    cki("symdiff_eq_union_minus_intersect", setops.set_equal(sd, dm), 1)

    print("PASS _setops_test")
