import forge_pollardbrent as pb

fn check(cond: bool, label: str)
    if cond == false
        print("FAIL: " + label)

// Verify a factor list multiplies back to n and every factor is prime.
fn is_prime_trial(n: int) -> bool
    if n < 2
        return false
    let d = 2
    while d * d <= n
        if n % d == 0
            return false
        d = d + 1
    return true

fn product(factors: list) -> int
    let p = 1
    let i = 0
    while i < len(factors)
        p = p * factors[i]
        i = i + 1
    return p

fn all_prime(factors: list) -> bool
    let i = 0
    while i < len(factors)
        if is_prime_trial(factors[i]) == false
            return false
        i = i + 1
    return true

// TEST 1: is_prime
check(pb.pb_is_prime(2), "2 prime")
check(pb.pb_is_prime(97), "97 prime")
check(pb.pb_is_prime(1000000007), "1e9+7 prime")
check(pb.pb_is_prime(1) == false, "1 not prime")
check(pb.pb_is_prime(100) == false, "100 not prime")
check(pb.pb_is_prime(561) == false, "561 Carmichael not prime")
check(pb.pb_is_prime(1105) == false, "1105 Carmichael not prime")

// TEST 2: small factorizations
let f12 = pb.pb_factor(12)
check(len(f12) == 3, "12 has 3 factors")
check(f12[0] == 2 and f12[1] == 2 and f12[2] == 3, "12 = 2*2*3")

let f100 = pb.pb_factor(100)
check(f100[0] == 2 and f100[1] == 2 and f100[2] == 5 and f100[3] == 5, "100 = 2*2*5*5")

let f97 = pb.pb_factor(97)
check(len(f97) == 1 and f97[0] == 97, "97 = 97 (prime)")

let f1 = pb.pb_factor(1)
check(len(f1) == 0, "1 has no prime factors")

// TEST 3: semiprime (product of two medium primes) requires rho to split
let sp = 1000003 * 1000033
let fsp = pb.pb_factor(sp)
check(len(fsp) == 2, "semiprime has 2 factors")
check(fsp[0] == 1000003 and fsp[1] == 1000033, "semiprime factored correctly")
check(product(fsp) == sp, "semiprime product matches")

// TEST 4: large semiprime near 1e18 (exercises overflow-safe mulmod in Brent's rho)
let big = 1000000007 * 1000000009
let fbig = pb.pb_factor(big)
check(len(fbig) == 2, "1e18 semiprime has 2 factors")
check(product(fbig) == big, "1e18 semiprime product matches")
check(pb.pb_is_prime(fbig[0]) and pb.pb_is_prime(fbig[1]), "both factors prime")

// TEST 5: Carmichael number factorization (composite that fools Fermat)
let fcarm = pb.pb_factor(561)  // 3 * 11 * 17
check(len(fcarm) == 3, "561 has 3 prime factors")
check(fcarm[0] == 3 and fcarm[1] == 11 and fcarm[2] == 17, "561 = 3*11*17")

// TEST 6: DECISIVE cross-check - factor many numbers, verify product==n AND all factors prime
let ok = true
let seed = 424242
let tc = 0
while tc < 80
    seed = (seed * 1103515245 + 12345) % 2147483648
    let n = seed % 10000000 + 2  // 2 .. ~1e7
    let factors = pb.pb_factor(n)
    if product(factors) != n
        ok = false
        print("PRODUCT MISMATCH n=" + str(n) + " product=" + str(product(factors)))
    if all_prime(factors) == false
        ok = false
        print("NON-PRIME FACTOR n=" + str(n))
    tc = tc + 1
check(ok, "DECISIVE: 80 random n in [2,1e7] factor to prime factors whose product == n")

// TEST 7: prime powers
let fpp = pb.pb_factor(1024)  // 2^10
check(len(fpp) == 10, "1024 = 2^10 has 10 factors")
let all2 = true
let i = 0
while i < len(fpp)
    if fpp[i] != 2
        all2 = false
    i = i + 1
check(all2, "1024 all factors are 2")

// 3^7 = 2187
let fpp3 = pb.pb_factor(2187)
check(len(fpp3) == 7, "2187 = 3^7 has 7 factors")
check(product(fpp3) == 2187, "3^7 product matches")

print("forge_pollardbrent: KAT done")
