// _bytes_identity_test -- Stage 0 binary-bytes hardening guard (NOVA_MEM_BYTES tag). Bytes are `any`-typed,
// so every operation routes through the patched any-dispatch runtime paths. Pre-fix these gave wrong/garbage
// answers or wild-read the {data,size,cap} struct as a C string; post-fix they are correct. This is the
// soundness gate centerpiece (the adversarial any-dispatch coverage the 484-suite lacked).
fn main()
    let b = bytes(4)
    bytes_set(b, 0, 72)
    bytes_set(b, 1, 73)

    // distinct type identity (was "string")
    assert(type_name(b) == "bytes", "type_name(bytes) == bytes")

    // true binary length via len_any (was strlen on the struct)
    assert(len(b) == 4, "len(bytes) == 4 via len_any")
    assert(bytes_len(b) == 4, "bytes_len == 4")

    // diagnostic render via any_to_str (was heap-pointer garbage)
    assert(str(b) == "<bytes:4>", "str(bytes) == <bytes:4>")

    // content equality via memcmp (was strcmp on struct addresses -> wrong)
    let c = bytes(4)
    bytes_set(c, 0, 72)
    bytes_set(c, 1, 73)
    assert(b == c, "content-equal bytes compare equal")
    let d = bytes(4)
    bytes_set(d, 0, 99)
    assert((b == d) == false, "different-content bytes compare unequal")
    assert(bytes(0) == bytes(0), "two empty bytes are equal (size-0 memcmp guard)")

    // deep-copy independence (copy -> deep_copy BYTES memcpy; not a shared buffer)
    let e = copy(b)
    bytes_set(e, 0, 88)
    assert(bytes_get(b, 0) == 72, "original unchanged after mutating the copy")
    assert(bytes_get(e, 0) == 88, "copy mutated independently")

    // json render via json_stringify (was crash/garbage)
    let dd = {}
    dd["x"] = b
    assert(find(json_stringify(dd), "<bytes:4>") >= 0, "json renders bytes diagnostically")

    // containment is safe (no wild strstr on the struct)
    assert(contains(b, 72) == 0, "bytes containment unsupported -> safe 0")

    // collection element render via elem_to_str
    let lst = [b, c]
    assert(find(str(lst), "<bytes:4>") >= 0, "list element renders as <bytes:N>")

    print("PASS: bytes any-dispatch sound (type_name/len/str/eq/json/contains/copy)")

    // process isolation: spawn deep-copies the captured bytes -> mutating the child's copy
    // must NOT affect the parent's buffer (the shared-mutable-across-spawn hazard).
    let res = channel()
    spawn fn()
        bytes_set(b, 0, 200)
        send(res, bytes_get(b, 0))
    let got = receive(res)
    assert(got == 200, "spawned task mutated its own copy")
    assert(bytes_get(b, 0) == 72, "parent bytes unchanged across spawn (process isolation)")

    print("PASS: spawn deep-copies bytes (process isolation, no shared-mutable buffer)")
    print("_bytes_identity_test passed")
