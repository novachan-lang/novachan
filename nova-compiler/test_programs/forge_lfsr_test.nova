import forge_lfsr as lf

fn check(cond: bool, label: string)
    if cond == false
        print("FAIL: " + label)

fn main()
    // ---- next is deterministic and reversible-in-cycle ----
    let a = lf.lfsr_next(1, 0xB8)
    let b = lf.lfsr_next(1, 0xB8)
    check(a == b, "next deterministic")
    check(a != 1, "next moves state")

    // ---- 8-bit maximal LFSR (taps 0xB8) has period exactly 255 ----
    check(lf.lfsr_period(1, 0xB8, 300) == 255, "8-bit 0xB8 period 255")
    check(lf.lfsr_is_maximal(0xB8, 8), "0xB8 maximal for width 8")

    // ---- decisive maximality proof: one full period visits every nonzero 8-bit state EXACTLY once ----
    let seen = []
    let z = 0
    while z < 256
        push(seen, 0)
        z = z + 1
    let s = 1
    let step = 0
    while step < 255
        check(s != 0, "never hits zero state at step " + str(step))
        seen[s] = seen[s] + 1
        s = lf.lfsr_next(s, 0xB8)
        step = step + 1
    // back to start after 255 steps
    check(s == 1, "returns to seed after 255 steps")
    // every nonzero state seen exactly once, state 0 never
    check(seen[0] == 0, "state 0 never visited")
    let k = 1
    let allonce = true
    while k < 256
        if seen[k] != 1
            allonce = false
        k = k + 1
    check(allonce, "every nonzero state visited exactly once")

    // ---- output stream: over a full period, a maximal n-bit LFSR emits 2^(n-1) ones ----
    let bits = lf.lfsr_bits(1, 0xB8, 255)
    check(len(bits) == 255, "255 bits pulled")
    let ones = 0
    let i = 0
    while i < len(bits)
        if bits[i] == 1
            ones = ones + 1
        i = i + 1
    check(ones == 128, "maximal 8-bit period has 128 ones")   // 2^7 = 128

    // ---- 16-bit maximal LFSR (taps 0xB400) has period 65535 ----
    check(lf.lfsr_period(1, 0xB400, 70000) == 65535, "16-bit 0xB400 period 65535")
    check(lf.lfsr_is_maximal(0xB400, 16), "0xB400 maximal for width 16")

    // ---- a deliberately NON-maximal tap mask is detected ----
    // taps 0x80 (single tap) on width 8 does not give full period
    check(lf.lfsr_is_maximal(0x80, 8) == false, "0x80 not maximal width 8")

    print("forge_lfsr: all passed")
