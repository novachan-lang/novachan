// KAT for std/os/pathutil — POSIX path ops.
import std/os/pathutil

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL _pathutil_test " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _pathutil_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // path_join
    let p1 = []
    push(p1, "a")
    push(p1, "b")
    push(p1, "c")
    cks("join_abc", path_join(p1), "a/b/c")

    // path_normalize
    cks("normalize_dotdot", path_normalize("a/./b/../c"), "a/c")

    // path_basename
    cks("basename", path_basename("a/b/c.txt"), "c.txt")

    // path_dirname
    cks("dirname", path_dirname("a/b/c"), "a/b")

    // path_ext with dot
    cks("ext_gz", path_ext("f.tar.gz"), ".gz")

    // path_ext none
    cks("ext_none", path_ext("noext"), "")

    // path_is_absolute true
    if not path_is_absolute("/x")
        print("FAIL _pathutil_test is_abs_true: expected true for /x")
        exit(1)

    // path_is_absolute false
    if path_is_absolute("x")
        print("FAIL _pathutil_test is_abs_false: expected false for x")
        exit(1)

    // path_split
    let p2 = []
    push(p2, "a")
    push(p2, "b")
    push(p2, "c")
    let sp = path_split("a/b/c")
    cki("split_len", len(sp), 3)
    cks("split_0", sp[0], "a")
    cks("split_1", sp[1], "b")
    cks("split_2", sp[2], "c")

    // path_split strips leading slash
    let sp2 = path_split("/a/b")
    cki("split_abs_len", len(sp2), 2)
    cks("split_abs_0", sp2[0], "a")

    // path_normalize absolute
    cks("norm_abs", path_normalize("/a//b/./c"), "/a/b/c")

    print("PASS _pathutil_test")
