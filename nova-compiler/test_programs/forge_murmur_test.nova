import forge_murmur as mm

fn check(cond: bool, label: string)
    if cond == false
        print("FAIL: " + label)

fn popcount32(x: int) -> int
    let v = x & 0xFFFFFFFF
    let c = 0
    while v != 0
        c = c + (v & 1)
        v = v >> 1
    c

fn main()
    // ---- definitive fmix vector: MurmurHash3_x86_32("", seed=1) == 0x514E28B7 ----
    check(mm.murmur3_bytes([], 1) == 0x514E28B7, "empty seed1 == 0x514E28B7")
    // empty seed 0 == 0
    check(mm.murmur3_bytes([], 0) == 0, "empty seed0 == 0")
    // empty seed 0xffffffff == 0x81F16F39 (documented)
    check(mm.murmur3_bytes([], 0xffffffff) == 0x81F16F39, "empty seedFFFFFFFF == 0x81F16F39")

    // ---- DECISIVE: SMHasher verification value for MurmurHash3_x86_32 == 0xB0F57EE3 ----
    // for i in 0..255: hash the first i bytes of key (key[j]=j) with seed 256-i, append as 4 LE bytes;
    // then hash the whole 1024-byte buffer with seed 0.
    let hashes = []
    let i = 0
    while i < 256
        // key_i = bytes [0,1,...,i-1]
        let key = []
        let j = 0
        while j < i
            push(key, j)
            j = j + 1
        let h = mm.murmur3_bytes(key, 256 - i)
        push(hashes, h & 0xFF)
        push(hashes, (h >> 8) & 0xFF)
        push(hashes, (h >> 16) & 0xFF)
        push(hashes, (h >> 24) & 0xFF)
        i = i + 1
    check(len(hashes) == 1024, "smhasher buffer 1024 bytes")
    let verification = mm.murmur3_bytes(hashes, 0)
    check(verification == 0xB0F57EE3, "SMHasher verification == 0xB0F57EE3")

    // ---- determinism ----
    check(mm.murmur3_str("hello", 0) == mm.murmur3_str("hello", 0), "deterministic")
    // different seed -> (almost surely) different hash
    check(mm.murmur3_str("hello", 0) != mm.murmur3_str("hello", 1), "seed sensitivity")

    // ---- output is always within 32 bits ----
    let hh = mm.murmur3_str("the quick brown fox", 12345)
    check(hh >= 0 and hh <= 0xFFFFFFFF, "output within 32 bits")

    // ---- avalanche: flipping ONE input bit changes many output bits (~16 on average) ----
    // hash a byte and the same byte with one bit flipped; expect a large hamming distance in the outputs
    let base = mm.murmur3_bytes([0x41, 0x42, 0x43, 0x44], 0)
    let flipped = mm.murmur3_bytes([0x41, 0x42, 0x43, 0x45], 0)   // last byte 0x44 -> 0x45 (1 bit)
    let hd = popcount32(base ^ flipped)
    check(hd >= 8, "avalanche: 1-bit input change flips many output bits")

    // ---- distribution: few collisions hashing many distinct 4-byte keys into 4096 buckets ----
    let seen = {}
    let collisions = 0
    let n = 0
    while n < 4000
        let d0 = n & 255
        let d1 = (n >> 8) & 255
        let key2 = [d0, d1, 0x5A, 0xA5]
        let hv = mm.murmur3_bytes(key2, 99)
        let b = hv % 4096
        let kk = str(b)
        collisions = collisions + get(seen, kk, 0)
        seen[kk] = get(seen, kk, 0) + 1
        n = n + 1
    // 4000 keys into 4096 buckets: birthday-expected ~ well under 4000; assert far below pathological
    check(collisions < 3000, "distribution: collisions reasonable")

    print("forge_murmur: all passed")
