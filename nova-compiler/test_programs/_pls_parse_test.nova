// KAT test for std/data/pls_parse
import std/data/pls_parse

fn cki(label, got, expected)
    if got != expected
        print("FAIL pls_parse " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL pls_parse " + label + ": got=" + got + " expected=" + expected)
        exit(1)

// ── KAT from spec ────────────────────────────────────────────────────────────
let lf = chr(10)
let text1 = "[playlist]" + lf + "File1=http://x/a" + lf + "Title1=Song A" + lf + "Length1=123" + lf + "NumberOfEntries=1" + lf
let e1 = pls_parse(text1)
cki("spec_len", len(e1), 1)
cks("spec_url", e1[0]["url"], "http://x/a")
cks("spec_title", e1[0]["title"], "Song A")
cki("spec_length", e1[0]["length"], 123)

// ── KAT: multiple entries ─────────────────────────────────────────────────────
let text2 = "[playlist]" + lf + "File1=http://a/1.mp3" + lf + "Title1=Track 1" + lf + "Length1=60" + lf + "File2=http://a/2.mp3" + lf + "Title2=Track 2" + lf + "Length2=90" + lf + "NumberOfEntries=2" + lf + "Version=2" + lf
let e2 = pls_parse(text2)
cki("multi_len", len(e2), 2)
cks("multi_e0_url", e2[0]["url"], "http://a/1.mp3")
cks("multi_e0_title", e2[0]["title"], "Track 1")
cki("multi_e0_len", e2[0]["length"], 60)
cks("multi_e1_url", e2[1]["url"], "http://a/2.mp3")
cks("multi_e1_title", e2[1]["title"], "Track 2")
cki("multi_e1_len", e2[1]["length"], 90)

// ── KAT: live stream (Length=-1) ─────────────────────────────────────────────
let text3 = "[playlist]" + lf + "File1=http://live/stream" + lf + "Title1=Live Radio" + lf + "Length1=-1" + lf + "NumberOfEntries=1" + lf
let e3 = pls_parse(text3)
cki("live_len", len(e3), 1)
cki("live_length", e3[0]["length"], -1)
cks("live_title", e3[0]["title"], "Live Radio")

// ── KAT: missing title/length default to empty/"" and -1 ─────────────────────
let text4 = "[playlist]" + lf + "File1=http://x/only.mp3" + lf + "NumberOfEntries=1" + lf
let e4 = pls_parse(text4)
cki("minimal_len", len(e4), 1)
cks("minimal_url", e4[0]["url"], "http://x/only.mp3")
cks("minimal_title", e4[0]["title"], "")
cki("minimal_length", e4[0]["length"], -1)

// ── KAT: case-insensitive keys ────────────────────────────────────────────────
let text5 = "[PLAYLIST]" + lf + "file1=http://x/case.mp3" + lf + "TITLE1=Case Test" + lf + "LENGTH1=45" + lf
let e5 = pls_parse(text5)
cki("ci_len", len(e5), 1)
cks("ci_url", e5[0]["url"], "http://x/case.mp3")
cks("ci_title", e5[0]["title"], "Case Test")
cki("ci_length", e5[0]["length"], 45)

// ── KAT: empty input ─────────────────────────────────────────────────────────
let e6 = pls_parse("")
cki("empty_len", len(e6), 0)

print("PASS _pls_parse_test")
