// forge_testsurface_test -- master plan Phase 1.17: the pure test surface lets you exercise
// handlers without a socket. mock_request builds the Request; dispatch_test runs the pipeline;
// status_of/body_of read the result.
import forge

type Echo
    method: string
    got: string

fn h(req: Request) -> Echo
    Echo(req.method, req.body)

fn main()
    let q = chr(34)
    let a = forge.app()
    forge.post(a, "/echo", h)

    let r: Response = forge.dispatch_test(a, forge.mock_request("POST", "/echo", "hello body"))
    assert(forge.status_of(r) == 200, "status_of -> 200")
    assert(find(forge.body_of(r), q + "method" + q + ":" + q + "POST" + q) >= 0, "mock_request set method")
    assert(find(forge.body_of(r), q + "got" + q + ":" + q + "hello body" + q) >= 0, "mock_request set body")
    print("PASS: mock_request + dispatch_test + status_of/body_of")

    let nf: Response = forge.dispatch_test(a, forge.mock_request("GET", "/nope", ""))
    assert(forge.status_of(nf) == 404, "unknown route -> 404 via test surface")
    print("PASS: 404 via test surface")
    print("forge_testsurface_test passed")
