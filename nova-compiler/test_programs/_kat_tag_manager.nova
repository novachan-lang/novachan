import forge_tag_manager

fn main()
    let t = tag_new()
    let r1 = tag_create(t, "urgent")
    assert(is_ok(r1), "create ok")
    t = unwrap(r1)
    let r2 = tag_create(t, "bug")
    t = unwrap(r2)
    let r3 = tag_create(t, "feature")
    t = unwrap(r3)
    assert(tag_total_tags(t) == 3, "3 tags")

    let dup = tag_create(t, "urgent")
    assert(is_err(dup), "duplicate tag is err")

    let a1 = tag_assign(t, "issue-1", "urgent")
    assert(is_ok(a1), "assign ok")
    t = unwrap(a1)
    let a2 = tag_assign(t, "issue-1", "bug")
    t = unwrap(a2)
    let a3 = tag_assign(t, "issue-2", "feature")
    t = unwrap(a3)

    assert(tag_has(t, "issue-1", "urgent") == 1, "has urgent")
    assert(tag_has(t, "issue-1", "feature") == 0, "no feature")

    t = tag_remove(t, "issue-1", "urgent")
    assert(tag_has(t, "issue-1", "urgent") == 0, "removed")

    let bad = tag_assign(t, "x", "unknown")
    assert(is_err(bad), "unknown tag is err")

    assert(tag_total_assignments(t) == 3, "3 assignments")

    print("TAG-MANAGER KAT PASS")
