// KAT probe for std/data/ini — INI config parser/writer.
// All expected values are HAND-COMPUTED from the spec.
import std/data/ini

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ── KAT 1: exact task spec example ───────────────────────────────────────────
// '; c\n[db]\nhost = localhost\nport=5432\n[app]\nname = "My App"\n'
// Hand-computed:
//   "; c" is a full-line comment (default section stays empty/absent)
//   section "db": host->"localhost", port->"5432"
//   section "app": name->"My App" (quotes stripped)
fn kat1()
    let nl = chr(10)
    let text = "; c" + nl + "[db]" + nl + "host = localhost" + nl + "port=5432" + nl + "[app]" + nl + "name = " + chr(34) + "My App" + chr(34) + nl
    let result = ini_parse(text)
    cks("kat1-db-host", result["db"]["host"], "localhost")
    cks("kat1-db-port", result["db"]["port"], "5432")
    cks("kat1-app-name", result["app"]["name"], "My App")
    print("KAT 1 PASS: task-spec example parses correctly")

// ── KAT 2: default/global section for keys before any header ────────────────
// Input: "greeting=hi\n[s]\nk=v"
// Hand-computed: section "" has greeting->hi; section "s" has k->v
fn kat2()
    let nl = chr(10)
    let text = "greeting=hi" + nl + "[s]" + nl + "k=v"
    let result = ini_parse(text)
    cks("kat2-default-greeting", result[""]["greeting"], "hi")
    cks("kat2-s-k", result["s"]["k"], "v")
    print("KAT 2 PASS: default section '' captures pre-header keys")

// ── KAT 3: ':' separator works the same as '=' ───────────────────────────────
// Input: "[net]\nhost : example.com\nport : 80"
// Hand-computed: host->"example.com", port->"80"
fn kat3()
    let nl = chr(10)
    let text = "[net]" + nl + "host : example.com" + nl + "port : 80"
    let result = ini_parse(text)
    cks("kat3-host", result["net"]["host"], "example.com")
    cks("kat3-port", result["net"]["port"], "80")
    print("KAT 3 PASS: ':' key/value separator parsed correctly")

// ── KAT 4: trailing inline comment (';' and '#') stripped to EOL ────────────
// Input: "[c]\na=1 ; trailing semi comment\nb=2 # trailing hash comment"
// Hand-computed: a->"1", b->"2" (comments removed, value trimmed)
fn kat4()
    let nl = chr(10)
    let text = "[c]" + nl + "a=1 ; trailing semi comment" + nl + "b=2 # trailing hash comment"
    let result = ini_parse(text)
    cks("kat4-a", result["c"]["a"], "1")
    cks("kat4-b", result["c"]["b"], "2")
    print("KAT 4 PASS: trailing ';'/'#' comments stripped to end of line")

// ── KAT 5: quoted value containing a ';' is NOT treated as a comment ────────
// Input: '[q]\nmsg = "a;b#c"'
// Hand-computed: msg -> "a;b#c" (quote-protected; comment strip must not fire)
fn kat5()
    let nl = chr(10)
    let text = "[q]" + nl + "msg = " + chr(34) + "a;b#c" + chr(34)
    let result = ini_parse(text)
    cks("kat5-msg", result["q"]["msg"], "a;b#c")
    print("KAT 5 PASS: ';'/'#' inside a quoted value is preserved, not a comment")

// ── KAT 6: values with interior spaces are kept verbatim ────────────────────
// Input: "[app]\ntitle = Hello World Wide"
// Hand-computed: title -> "Hello World Wide" (only exterior ws trimmed)
fn kat6()
    let nl = chr(10)
    let text = "[app]" + nl + "title = Hello World Wide"
    let result = ini_parse(text)
    cks("kat6-title", result["app"]["title"], "Hello World Wide")
    print("KAT 6 PASS: interior spaces in unquoted values preserved")

// ── KAT 7: round-trip ini_write(ini_parse(text)) reproduces all values ──────
fn kat7()
    let nl = chr(10)
    let text = "; c" + nl + "[db]" + nl + "host = localhost" + nl + "port=5432" + nl + "[app]" + nl + "name = " + chr(34) + "My App" + chr(34) + nl
    let parsed = ini_parse(text)
    let written = ini_write(parsed)
    let reparsed = ini_parse(written)
    cks("kat7-rt-db-host", reparsed["db"]["host"], "localhost")
    cks("kat7-rt-db-port", reparsed["db"]["port"], "5432")
    cks("kat7-rt-app-name", reparsed["app"]["name"], "My App")
    print("KAT 7 PASS: ini_write -> ini_parse round-trip preserves values")

// ── KAT 8: ini_write auto-quotes values that would otherwise corrupt a
// round-trip — an empty value, and a value that itself contains ';' (which
// unquoted would be mistaken for a comment marker on re-parse). These values
// are built directly (not parsed from unquoted text), because an unquoted
// ';' in SOURCE text is legitimately a comment marker per spec — the point
// of this KAT is that ini_write must quote such values so ini_parse gets
// them back intact.
fn kat8()
    let d = {}
    let def_sec = {}
    def_sec["top"] = ""
    d[""] = def_sec
    let sec = {}
    sec["note"] = "has;semicolon"
    d["sec"] = sec
    let written = ini_write(d)
    let reparsed = ini_parse(written)
    cks("kat8-rt-top-empty", reparsed[""]["top"], "")
    cks("kat8-rt-note", reparsed["sec"]["note"], "has;semicolon")
    print("KAT 8 PASS: auto-quoting on write makes empty/semicolon values round-trip")

// ── KAT 9: CRLF line endings parse identically to LF ─────────────────────────
fn kat9()
    let nl = chr(13) + chr(10)
    let text = "[cfg]" + nl + "host=localhost" + nl + "port=8080" + nl
    let result = ini_parse(text)
    cks("kat9-host", result["cfg"]["host"], "localhost")
    cks("kat9-port", result["cfg"]["port"], "8080")
    print("KAT 9 PASS: CRLF line endings parsed correctly")

// ── KAT 10: ini_write quotes values with leading/trailing whitespace
// (space or tab) so ini_parse round-trips them EXACTLY — the parser trims
// unquoted values, so an unquoted leading/trailing tab or space would
// otherwise be silently lost. Interior tabs are also covered since they
// don't need quoting to survive (no trim on interior bytes) but must still
// come back byte-for-byte through the write/parse round-trip.
fn kat10()
    let tab = chr(9)
    let d = {}
    let sec = {}
    sec["lead_tab"] = tab + "value"
    sec["trail_tab"] = "value" + tab
    sec["lead_space"] = " value"
    sec["trail_space"] = "value "
    sec["interior_tab"] = "a" + tab + "b"
    d["ws"] = sec
    let written = ini_write(d)
    let reparsed = ini_parse(written)
    cks("kat10-lead-tab", reparsed["ws"]["lead_tab"], tab + "value")
    cks("kat10-trail-tab", reparsed["ws"]["trail_tab"], "value" + tab)
    cks("kat10-lead-space", reparsed["ws"]["lead_space"], " value")
    cks("kat10-trail-space", reparsed["ws"]["trail_space"], "value ")
    cks("kat10-interior-tab", reparsed["ws"]["interior_tab"], "a" + tab + "b")
    print("KAT 10 PASS: leading/trailing/interior whitespace round-trips exactly through ini_write/ini_parse")

fn main()
    kat1()
    kat2()
    kat3()
    kat4()
    kat5()
    kat6()
    kat7()
    kat8()
    kat9()
    kat10()
    print("_ini_data_kat passed")
