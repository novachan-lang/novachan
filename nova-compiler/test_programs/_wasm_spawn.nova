// Definitive: a spawned green task EXECUTES ITS BODY in wasm -- it writes 42 to the shared runtime cell; run()
// spawns it, waits for it to exit (monitor+receive), then reads the cell. run()==42 => the actor model (spawn
// a worker that mutates shared/owned state) is viable in the wasm value-model path.
extern fn nova_state_get() -> int
extern fn nova_state_set(v: int)
fn _worker()
    unsafe nova_state_set(42)
fn run() -> int
    unsafe nova_state_set(0)
    let p = spawn _worker()
    let m = monitor(p)
    receive(m)
    unsafe nova_state_get()
fn main()
    run()
