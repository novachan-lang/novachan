// _kat_tpl_render.nova — KAT probe for std/text/template's tpl_render /
// tpl_render_default / tpl_keys / tpl_fill (single-brace {key} style).
//
// NOTE: template strings are built via chr(123)/chr(125) concatenation, never
// as a raw "{key}" literal in NOVA source — a bare "{key}" inside a NOVA
// string literal is parsed as INTERPOLATION at compile time (confirmed: an
// undefined identifier like `name` inside {..} silently becomes 0, it is NOT
// a compile error), which would corrupt the very template text this test is
// trying to construct. This is the same reason std/text/template's own
// _kat_template.nova KAT builds braces via chr() instead of source literals.
import std/text/template

fn _ob() -> string
    chr(123)

fn _cb() -> string
    chr(125)

// build a {key} placeholder span without a source-level brace literal.
fn _ph(inner: string) -> string
    _ob() + inner + _cb()

// ── KAT 1: basic substitution, ok() ─────────────────────────────────────────
let t1 = "Hi " + _ph("name") + ", you are " + _ph("age")
let vars1 = {}
vars1["name"] = "Eve"
vars1["age"] = "30"
let r1 = tpl_render(t1, vars1)
if r1 != ok("Hi Eve, you are 30")
    match r1
        Ok(v) =>
            print("FAIL KAT1: expected ok('Hi Eve, you are 30') got ok(" + v + ")")
        Err(e) =>
            print("FAIL KAT1: expected ok('Hi Eve, you are 30') got err(" + e + ")")
    exit(1)
print("OK KAT1: basic substitution")

// ── KAT 2: unknown key -> Err ────────────────────────────────────────────────
let t2 = "Hello " + _ph("missing") + "!"
let vars2 = {}
vars2["name"] = "Eve"
let r2 = tpl_render(t2, vars2)
match r2
    Ok(v) =>
        print("FAIL KAT2: expected Err, got Ok(" + v + ")")
        exit(1)
    Err(e) =>
        if e != "unknown key: missing"
            print("FAIL KAT2: wrong error message: " + e)
            exit(1)
print("OK KAT2: unknown key errs")

// ── KAT 3: tpl_render_default -- missing key uses the default, never errs ──
let t3 = "Hi " + _ph("name") + ", you are " + _ph("age")
let vars3 = {}
vars3["name"] = "Eve"
let r3 = tpl_render_default(t3, vars3, "N/A")
if r3 != "Hi Eve, you are N/A"
    print("FAIL KAT3: expected 'Hi Eve, you are N/A' got: " + r3)
    exit(1)
print("OK KAT3: tpl_render_default fills missing key with default")

// ── KAT 4: tpl_keys -- distinct, order-preserving ({a}{b}{a} -> [a, b]) ─────
let t4 = _ph("a") + _ph("b") + _ph("a")
let k4 = tpl_keys(t4)
if k4 != ["a", "b"]
    print("FAIL KAT4: expected ['a','b'] got: " + str(k4))
    exit(1)
print("OK KAT4: tpl_keys distinct + order-preserving")

// ── KAT 5: escaped braces stay literal (\{ and \}) ──────────────────────────
// Source-level: NOVA's OWN "\{" / "\}" string-literal escape (see
// NOVA_LANGUAGE_FEATURES.md) already collapses to a plain brace char at lex
// time, so to hand tpl_render an actual runtime "\" + "{" pair (the case its
// OWN escape handling must recognize) we build it explicitly with chr(92).
let bs = chr(92)
let t5 = "Amount: " + bs + _ob() + "100" + bs + _cb() + " exactly"
let vars5 = {}
let r5 = tpl_render(t5, vars5)
if r5 != ok("Amount: " + _ob() + "100" + _cb() + " exactly")
    match r5
        Ok(v) =>
            print("FAIL KAT5: expected literal braces, got ok(" + v + ")")
        Err(e) =>
            print("FAIL KAT5: expected literal braces, got err(" + e + ")")
    exit(1)
print("OK KAT5: escaped braces stay literal")

// ── KAT 6: tpl_fill -- render each row of a list of dicts ───────────────────
let t6 = "Hi " + _ph("name") + "!"
let row_a = {}
row_a["name"] = "Ann"
let row_b = {}
row_b["name"] = "Bo"
let rows = [row_a, row_b]
let filled = tpl_fill(t6, rows)
if filled != ["Hi Ann!", "Hi Bo!"]
    print("FAIL KAT6: expected ['Hi Ann!','Hi Bo!'] got: " + str(filled))
    exit(1)
print("OK KAT6: tpl_fill renders each row")

// ── KAT 7: sanity -- template_render (existing double-brace API) untouched ─
let t7 = "Hi " + _ob() + _ob() + "name" + _cb() + _cb()
let vars7 = {}
vars7["name"] = "World"
let r7 = template_render(t7, vars7)
if r7 != "Hi World"
    print("FAIL KAT7: template_render regressed, got: " + r7)
    exit(1)
print("OK KAT7: template_render still passes (regression guard)")

print("TEMPLATE KAT PASS")
