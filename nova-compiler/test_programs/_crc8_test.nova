// _crc8_test.nova — KAT for std/hash/crc8
//
// All expected values are verifiable with Python:
//
//   def crc8_smbus(data):
//       crc = 0
//       for b in data:
//           crc ^= b
//           for _ in range(8):
//               crc = (((crc<<1)^0x07)&0xFF) if (crc&0x80) else ((crc<<1)&0xFF)
//       return crc
//
//   def crc8_maxim(data):   # reflected poly 0x8C
//       crc = 0
//       for b in data:
//           crc ^= b
//           for _ in range(8):
//               crc = (((crc>>1)^0x8C)&0xFF) if (crc&1) else ((crc>>1)&0xFF)
//       return crc
//
//   crc8_smbus(b"123456789") == 0xF4  (244)
//   crc8_maxim(b"123456789") == 0xA1  (161)
//   crc8_smbus(b"a")         == 0x20  (32)
//   crc8_maxim(b"a")         == 0x3B  (59)
//   crc8_smbus(b"abc")       == 0x5F  (95)
//   crc8_maxim(b"abc")       == 0x42  (66)

import std/hash/crc8

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL crc8 " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // KAT 1: SMBus canonical check vector — "123456789" → 0xF4 (244)
    cki("smbus_123456789", h_crc8_smbus(str_to_bytes("123456789")), 244)

    // KAT 2: Maxim canonical check vector — "123456789" → 0xA1 (161)
    cki("maxim_123456789", h_crc8_maxim(str_to_bytes("123456789")), 161)

    // KAT 3: SMBus empty bytes → 0x00 (init is 0, no bytes processed)
    cki("smbus_empty", h_crc8_smbus(bytes(0)), 0)

    // KAT 4: Maxim empty bytes → 0x00
    cki("maxim_empty", h_crc8_maxim(bytes(0)), 0)

    // KAT 5: SMBus single byte "a" (0x61 = 97) → 0x20 (32)
    cki("smbus_a", h_crc8_smbus(str_to_bytes("a")), 32)

    // KAT 6: Maxim single byte "a" (0x61 = 97) → 0x3B (59)
    cki("maxim_a", h_crc8_maxim(str_to_bytes("a")), 59)

    // KAT 7: SMBus "abc" → 0x5F (95)
    cki("smbus_abc", h_crc8_smbus(str_to_bytes("abc")), 95)

    // KAT 8: Maxim "abc" → 0x42 (66)
    cki("maxim_abc", h_crc8_maxim(str_to_bytes("abc")), 66)

    // KAT 9: h_crc8_generic with SMBus parameters matches h_crc8_smbus
    let msg = str_to_bytes("123456789")
    cki("generic_smbus_eq", h_crc8_generic(msg, 7, 0), 244)

    // KAT 10: h_crc8_generic with SMBus params on "abc" matches h_crc8_smbus "abc"
    let abc = str_to_bytes("abc")
    cki("generic_abc", h_crc8_generic(abc, 7, 0), 95)

    // KAT 11: determinism — same input always gives same result for smbus
    let r1 = h_crc8_smbus(str_to_bytes("hello"))
    let r2 = h_crc8_smbus(str_to_bytes("hello"))
    cki("smbus_determinism", r1, r2)

    // KAT 12: determinism — same input always gives same result for maxim
    let r3 = h_crc8_maxim(str_to_bytes("hello"))
    let r4 = h_crc8_maxim(str_to_bytes("hello"))
    cki("maxim_determinism", r3, r4)

    print("PASS _crc8_test")
