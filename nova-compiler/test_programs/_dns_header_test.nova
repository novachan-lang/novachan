// KAT for std/net/dns_header — RFC 1035 §4.1.1 12-byte header codec.
import std/net/dns_header

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL dns_header " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── Vector 1: encode {"id":0x1234, "rd":1, "qdcount":1} ─────────────────
    // Expected wire bytes:
    //   [0]=0x12 [1]=0x34  (ID=0x1234)
    //   [2]=0x01 [3]=0x00  (FLAGS: RD=1 => bit8 set => 0x0100)
    //   [4]=0x00 [5]=0x01  (QDCOUNT=1)
    //   [6..11]=0x00        (ANCOUNT/NSCOUNT/ARCOUNT=0)
    let q = {"id": 0x1234, "rd": 1, "qdcount": 1}
    let enc1 = dns_header_encode(q)
    cki("enc1_len",  bytes_len(enc1), 12)
    cki("enc1_b0",  bytes_get(enc1, 0),  0x12)
    cki("enc1_b1",  bytes_get(enc1, 1),  0x34)
    cki("enc1_b2",  bytes_get(enc1, 2),  0x01)
    cki("enc1_b3",  bytes_get(enc1, 3),  0x00)
    cki("enc1_b4",  bytes_get(enc1, 4),  0x00)
    cki("enc1_b5",  bytes_get(enc1, 5),  0x01)
    cki("enc1_b6",  bytes_get(enc1, 6),  0x00)
    cki("enc1_b7",  bytes_get(enc1, 7),  0x00)
    // QDCOUNT as u16 big-endian at offset 4: (byte4<<8)|byte5 == 1
    let qdcount_wire = (bytes_get(enc1, 4) << 8) | bytes_get(enc1, 5)
    cki("enc1_qdcount_u16", qdcount_wire, 1)

    // ── Vector 2: encode a response with qr=1, rcode=3, ancount=2 ───────────
    // FLAGS = (1<<15)|(3&0xF) = 0x8000|0x0003 = 0x8003
    // Expected: [2]=0x80 [3]=0x03; ancount u16@6 == 2
    let resp = {"id": 5, "qr": 1, "rcode": 3, "ancount": 2}
    let enc2 = dns_header_encode(resp)
    cki("enc2_len",   bytes_len(enc2), 12)
    cki("enc2_id_hi", bytes_get(enc2, 0), 0)
    cki("enc2_id_lo", bytes_get(enc2, 1), 5)
    cki("enc2_fl_hi", bytes_get(enc2, 2), 0x80)
    cki("enc2_fl_lo", bytes_get(enc2, 3), 0x03)
    let ancount_wire = (bytes_get(enc2, 6) << 8) | bytes_get(enc2, 7)
    cki("enc2_ancount_u16", ancount_wire, 2)

    // ── Decode the response back ─────────────────────────────────────────────
    let dec2 = dns_header_decode(enc2, 0)
    let hdr2 = dec2[0]
    let nxt2 = dec2[1]
    cki("dec2_next",    nxt2,         12)
    cki("dec2_id",      hdr2["id"],   5)
    cki("dec2_qr",      hdr2["qr"],   1)
    cki("dec2_rcode",   hdr2["rcode"],3)
    cki("dec2_ancount", hdr2["ancount"], 2)
    cki("dec2_opcode",  hdr2["opcode"],  0)
    cki("dec2_aa",      hdr2["aa"],      0)
    cki("dec2_tc",      hdr2["tc"],      0)
    cki("dec2_rd",      hdr2["rd"],      0)
    cki("dec2_ra",      hdr2["ra"],      0)
    cki("dec2_qdcount", hdr2["qdcount"], 0)
    cki("dec2_nscount", hdr2["nscount"], 0)
    cki("dec2_arcount", hdr2["arcount"], 0)

    // ── Full round-trip: encode all fields, decode, verify every field ────────
    let full = {"id": 0xABCD, "qr": 1, "opcode": 2, "aa": 1, "tc": 0, "rd": 1, "ra": 1, "rcode": 0, "qdcount": 3, "ancount": 7, "nscount": 1, "arcount": 4}
    let encF = dns_header_encode(full)
    cki("rt_len", bytes_len(encF), 12)
    let decF = dns_header_decode(encF, 0)
    let hdrF = decF[0]
    let nxtF = decF[1]
    cki("rt_next",    nxtF,            12)
    cki("rt_id",      hdrF["id"],      0xABCD)
    cki("rt_qr",      hdrF["qr"],      1)
    cki("rt_opcode",  hdrF["opcode"],  2)
    cki("rt_aa",      hdrF["aa"],      1)
    cki("rt_tc",      hdrF["tc"],      0)
    cki("rt_rd",      hdrF["rd"],      1)
    cki("rt_ra",      hdrF["ra"],      1)
    cki("rt_rcode",   hdrF["rcode"],   0)
    cki("rt_qdcount", hdrF["qdcount"], 3)
    cki("rt_ancount", hdrF["ancount"], 7)
    cki("rt_nscount", hdrF["nscount"], 1)
    cki("rt_arcount", hdrF["arcount"], 4)

    // ── Bounds-safety: decode from truncated buffer returns empty dict + same pos
    let short_buf = bytes(6)
    let decS = dns_header_decode(short_buf, 0)
    let hdrS = decS[0]
    let nxtS = decS[1]
    cki("short_next", nxtS, 0)
    // hdrS is empty — verify "id" key is absent (contains returns false/0)
    let short_has_id = 0
    if contains(hdrS, "id")
        short_has_id = 1
    cki("short_no_id", short_has_id, 0)

    // ── Decode at non-zero offset ────────────────────────────────────────────
    // Prepend 4 zero bytes then the enc2 wire bytes; decode at pos=4
    let prefix = bytes(4)
    let padded = bytes_concat(prefix, enc2)
    let decP = dns_header_decode(padded, 4)
    let hdrP = decP[0]
    let nxtP = decP[1]
    cki("offset_next",  nxtP,          16)
    cki("offset_id",    hdrP["id"],    5)
    cki("offset_qr",    hdrP["qr"],    1)
    cki("offset_rcode", hdrP["rcode"], 3)

    // ── Flags field: all-zeros query ─────────────────────────────────────────
    let plain = {}
    let encZ = dns_header_encode(plain)
    cki("zero_b0", bytes_get(encZ, 0), 0)
    cki("zero_b1", bytes_get(encZ, 1), 0)
    cki("zero_b2", bytes_get(encZ, 2), 0)
    cki("zero_b3", bytes_get(encZ, 3), 0)
    cki("zero_len", bytes_len(encZ), 12)

    print("PASS _dns_header_test")
