import forge_intervalsched

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // max non-overlapping (activity selection): [1,3],[2,5],[4,7],[6,8] -> pick [1,3],[4,7] or [1,3],[6,8]... = 2? no
    // sorted by end: [1,3],[2,5],[4,7],[6,8]. greedy: take [1,3](end3), next start>=3: [4,7](end7), next>=7: none([6,8] start6<7). = 2
    fails = fails + expect("activity_2", str(max_nonoverlapping([[1, 3], [2, 5], [4, 7], [6, 8]])), "2")
    // classic: [1,2],[3,4],[0,6],[5,7],[8,9],[5,9] -> 4 ([1,2],[3,4],[5,7],[8,9])
    fails = fails + expect("activity_4", str(max_nonoverlapping([[1, 2], [3, 4], [0, 6], [5, 7], [8, 9], [5, 9]])), "4")
    // all overlapping -> 1
    fails = fails + expect("activity_all_overlap", str(max_nonoverlapping([[1, 10], [2, 9], [3, 8]])), "1")
    // all disjoint -> all
    fails = fails + expect("activity_disjoint", str(max_nonoverlapping([[1, 2], [3, 4], [5, 6]])), "3")
    // touching allowed (end==start)
    fails = fails + expect("activity_touching", str(max_nonoverlapping([[1, 3], [3, 5], [5, 7]])), "3")

    // weighted: [1,3,5],[2,5,6],[4,6,5],[6,7,4] -> best = [1,3,5]+[4,6,5]+[6,7,4] = 14
    fails = fails + expect("weighted_14", str(max_weight_schedule([[1, 3, 5], [2, 5, 6], [4, 6, 5], [6, 7, 4]])), "14")
    // single high-value overlapping beats many small: [1,10,100],[1,2,1],[3,4,1] -> 100
    fails = fails + expect("weighted_bigone", str(max_weight_schedule([[1, 10, 100], [1, 2, 1], [3, 4, 1]])), "100")
    // two small non-overlapping beat one overlapping: [1,2,3],[3,4,3],[1,4,5] -> 6 (3+3 > 5)
    fails = fails + expect("weighted_two", str(max_weight_schedule([[1, 2, 3], [3, 4, 3], [1, 4, 5]])), "6")
    // all disjoint -> sum
    fails = fails + expect("weighted_sum", str(max_weight_schedule([[1, 2, 10], [3, 4, 20], [5, 6, 30]])), "60")
    // single interval
    fails = fails + expect("weighted_single", str(max_weight_schedule([[0, 5, 42]])), "42")

    if fails == 0
        print("forge_intervalsched: all passed")
    else
        print("forge_intervalsched: " + str(fails) + " FAILED")
