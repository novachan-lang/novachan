import std/math/ts_rolling_std

fn approx(a: float, b: float, tol: float) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < tol
        return 1
    return 0

fn ck(label: str, got: float, want: float)
    if approx(got, want, 0.0001) == 0
        print("FAIL " + label + " got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // KAT 1: ts_rolling_std([1,2,3], 2) -> [0.5, 0.5]
    // window [1,2]: var=0.25, std=0.5
    // window [2,3]: var=0.25, std=0.5
    let d1 = [1.0, 2.0, 3.0]
    let r1 = ts_rolling_std(d1, 2)
    if len(r1) != 2
        print("FAIL ts_rolling_std len expected 2 got=" + str(len(r1)))
        exit(1)
    ck("rs_w2[0]", r1[0], 0.5)
    ck("rs_w2[1]", r1[1], 0.5)

    // KAT 2: ts_rolling_std([1,3], 2) -> [1.0]
    // mean=2.0, var=1.0, std=1.0
    let d2 = [1.0, 3.0]
    let r2 = ts_rolling_std(d2, 2)
    if len(r2) != 1
        print("FAIL ts_rolling_std [1,3] len expected 1 got=" + str(len(r2)))
        exit(1)
    ck("rs_13", r2[0], 1.0)

    // KAT 3: constant window -> std = 0.0
    let d3 = [7.0, 7.0, 7.0, 7.0]
    let r3 = ts_rolling_std(d3, 2)
    if len(r3) != 3
        print("FAIL ts_rolling_std const len expected 3 got=" + str(len(r3)))
        exit(1)
    ck("rs_const[0]", r3[0], 0.0)
    ck("rs_const[1]", r3[1], 0.0)
    ck("rs_const[2]", r3[2], 0.0)

    // KAT 4: window==len -> single population std
    // [1,2,3,4]: mean=2.5, var=1.25, std=sqrt(1.25)=1.11803...
    let d4 = [1.0, 2.0, 3.0, 4.0]
    let r4 = ts_rolling_std(d4, 4)
    if len(r4) != 1
        print("FAIL ts_rolling_std full len expected 1 got=" + str(len(r4)))
        exit(1)
    ck("rs_full", r4[0], 1.11803)

    // KAT 5: window > len -> empty
    let d5 = [1.0, 2.0]
    let r5 = ts_rolling_std(d5, 5)
    if len(r5) != 0
        print("FAIL ts_rolling_std window>len expected 0 got=" + str(len(r5)))
        exit(1)

    // KAT 6: window=1 -> all zeros (std of single value = 0)
    let d6 = [3.0, 5.0, 9.0]
    let r6 = ts_rolling_std(d6, 1)
    if len(r6) != 3
        print("FAIL ts_rolling_std w1 len expected 3 got=" + str(len(r6)))
        exit(1)
    ck("rs_w1[0]", r6[0], 0.0)
    ck("rs_w1[1]", r6[1], 0.0)
    ck("rs_w1[2]", r6[2], 0.0)

    // KAT 7: window=3 on [0,4,0,4,0]
    // [0,4,0]: mean=4/3, deviations: -4/3, 8/3, -4/3; var=(16/9+64/9+16/9)/3=96/27=32/9; std=sqrt(32/9)=5.6568.../3=1.88562...
    // Actually: mean=4.0/3.0=1.33333, dev0=0-1.333=-1.333, dev1=4-1.333=2.666, dev2=0-1.333=-1.333
    // var=(1.7778+7.1111+1.7778)/3=10.6667/3=3.5556; std=sqrt(3.5556)=1.88562
    // [4,0,4]: mean=8/3=2.6667, dev0=4-2.6667=1.3333, dev1=0-2.6667=-2.6667, dev2=4-2.6667=1.3333
    // var=(1.7778+7.1111+1.7778)/3=3.5556; std=1.88562
    // [0,4,0]: same as first = 1.88562
    let d7 = [0.0, 4.0, 0.0, 4.0, 0.0]
    let r7 = ts_rolling_std(d7, 3)
    if len(r7) != 3
        print("FAIL ts_rolling_std w3 len expected 3 got=" + str(len(r7)))
        exit(1)
    ck("rs_w3[0]", r7[0], 1.88562)
    ck("rs_w3[1]", r7[1], 1.88562)
    ck("rs_w3[2]", r7[2], 1.88562)

    print("PASS _ts_rolling_std_test")
