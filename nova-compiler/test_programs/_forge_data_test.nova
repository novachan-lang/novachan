// _forge_data_test.nova -- Forge v0.3: request-data accessors + DB row->dict bridge.
// Covers the pure-NOVA data pieces that work today (json_decode body, urlencoded form,
// row->dict). The TYPED struct path (body_as<T>/query_as<T>) needs the struct<-JSON/row
// compiler dispatch (a tracked keystone) and is intentionally NOT tested here.
import forge

fn main()
    // body_json: JSON body -> dict
    let req = {}
    req["body"] = "\{\"name\": \"ada\", \"age\": 36\}"
    let j = forge.body_json(req)
    assert(j["name"] == "ada", "body_json name")
    assert(str(j["age"]) == "36", "body_json age")
    print("PASS: body_json (JSON body -> dict)")

    // form_decode + body_form: urlencoded -> dict
    let f = forge.form_decode("user=bob&role=admin&x=1")
    assert(f["user"] == "bob", "form user")
    assert(f["role"] == "admin", "form role")
    assert(f["x"] == "1", "form x")
    let req2 = {}
    req2["body"] = "a=hello&b=world"
    let bf = forge.body_form(req2)
    assert(bf["a"] == "hello", "body_form a")
    assert(bf["b"] == "world", "body_form b")
    print("PASS: form_decode + body_form (urlencoded -> dict)")

    // row_dict + rows_dicts: DB rows (lists) -> named dicts (the sqlitex bridge)
    let cols = ["id", "name"]
    let rows = [["1", "ada"], ["2", "bob"]]
    let ds = forge.rows_dicts(cols, rows)
    assert(len(ds) == 2, "two rows")
    assert(ds[0]["id"] == "1", "row0 id")
    assert(ds[0]["name"] == "ada", "row0 name")
    assert(ds[1]["name"] == "bob", "row1 name")
    print("PASS: row_dict + rows_dicts (DB rows -> named dicts)")
    print("ALL PASS: forge_data")
