// KAT for std/time/tz — POSIX-TZ-rule DST engine. Ground-truth IANA offsets (seconds east of UTC).
// Epochs: 1610712000 = 2021-01-15 12:00Z (N. winter / S. summer); 1626350400 = 2021-07-15 12:00Z (N. summer / S. winter).
import std/time/tz

fn ck(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": " + str(got) + " != " + str(want))
        exit(1)

fn main()
    let win = 1610712000
    let sum = 1626350400
    // no-DST zones
    ck("UTC", tz_offset_at(win, "UTC"), 0)
    ck("Kolkata", tz_offset_at(sum, "Asia/Kolkata"), 19800)
    ck("Tokyo", tz_offset_at(win, "Asia/Tokyo"), 32400)
    // northern DST zones
    ck("NY-EST", tz_offset_at(win, "America/New_York"), -18000)
    ck("NY-EDT", tz_offset_at(sum, "America/New_York"), -14400)
    ck("LA-PST", tz_offset_at(win, "America/Los_Angeles"), -28800)
    ck("LA-PDT", tz_offset_at(sum, "America/Los_Angeles"), -25200)
    ck("London-GMT", tz_offset_at(win, "Europe/London"), 0)
    ck("London-BST", tz_offset_at(sum, "Europe/London"), 3600)
    ck("Paris-CET", tz_offset_at(win, "Europe/Paris"), 3600)
    ck("Paris-CEST", tz_offset_at(sum, "Europe/Paris"), 7200)
    // southern hemisphere (DST window wraps year-end: summer is January)
    ck("Sydney-AEDT", tz_offset_at(win, "Australia/Sydney"), 39600)
    ck("Sydney-AEST", tz_offset_at(sum, "Australia/Sydney"), 36000)
    // tz_to_local + unknown-zone fallback + raw POSIX string
    ck("to_local-NY", tz_to_local(win, "America/New_York"), win - 18000)
    ck("unknown->UTC", tz_offset_at(win, "Mars/Olympus"), 0)
    ck("raw-POSIX", tz_offset_at(sum, "PST8PDT,M3.2.0,M11.1.0"), -25200)
    print("_tz_test passed (16 IANA-offset KATs)")
