import forge_sliding_window_log

fn main()
    let s = swl_new(100, 3)
    assert(swl_window_size(s) == 100, "window 100")
    assert(swl_max_requests(s) == 3, "max 3")
    assert(swl_current_count(s) == 0, "starts empty")

    let r1 = swl_request(s, 10)
    s = r1["s"]
    assert(r1["allowed"] == 1, "req 1 allowed")

    let r2 = swl_request(s, 20)
    s = r2["s"]
    assert(r2["allowed"] == 1, "req 2 allowed")

    let r3 = swl_request(s, 30)
    s = r3["s"]
    assert(r3["allowed"] == 1, "req 3 allowed")

    let r4 = swl_request(s, 40)
    s = r4["s"]
    assert(r4["allowed"] == 0, "req 4 denied (at limit)")
    assert(swl_total_denied(s) == 1, "1 denied")

    let r5 = swl_request(s, 120)
    s = r5["s"]
    assert(r5["allowed"] == 1, "req at t=120 allowed (t=10 expired)")
    assert(swl_total_allowed(s) == 4, "4 total allowed")

    let r6 = swl_request(s, 125)
    s = r6["s"]
    assert(r6["allowed"] == 1, "req at t=125 allowed (t=20 expired)")

    print("SLIDING-WINDOW-LOG KAT PASS")
