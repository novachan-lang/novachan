// Forge T4.12: a serialized state cell. agent_update applies a fn to the state (serialized -> no lost
// updates); agent_get_and does a read-modify-write returning the OLD value. Socketless, kill-on-timeout.
import forge_otp

fn inc(x)
    x + 1

fn double_keep_old(x)
    [x * 2, x]      // get_and: new state = x*2, reply = old x

fn main()
    let a = agent(10)
    agent_update(a, inc)        // 10 -> 11
    agent_update(a, inc)        // 11 -> 12
    let v = agent_get(a)
    if v != 12
        print("FAIL get: expected 12 got " + str(v))
        exit(1)
    let old = agent_get_and(a, double_keep_old)   // 12 -> 24, returns 12
    if old != 12
        print("FAIL get_and: expected old 12 got " + str(old))
        exit(1)
    let v2 = agent_get(a)
    if v2 != 24
        print("FAIL post get_and: expected 24 got " + str(v2))
        exit(1)
    print("PASS forge_agent (update inc x2 -> 12; get_and double returns old 12, state -> 24)")
