// KAT test for std/cipher/playfair
import std/cipher/playfair

fn cks(label, got, want)
    if got != want
        print("FAIL playfair " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL playfair " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// KAT 1: square length = 25
let sq = playfair_square("PLAYFAIREXAMPLE")
cki("square_len", len(sq), 25)

// KAT 2: first letter is P
cks("square_0", sq[0], "P")

// KAT 3: second letter is L
cks("square_1", sq[1], "L")

// KAT 4: J not in square (merged into I)
let found_j = 0
let si = 0
while si < 25
    if sq[si] == "J"
        found_j = 1
    si = si + 1
cki("no_J_in_square", found_j, 0)

// KAT 5: known published encryption vector
let known_enc = playfair_encrypt("HIDETHEGOLDINTHETREESTUMP", "PLAYFAIREXAMPLE")
cks("known_vector_enc", known_enc, "BMODZBXDNABEKUDMUIXMMOUVIF")

// KAT 6: decrypt known ciphertext
// EE doubled -> EX inserted, so decrypt yields HIDETHEGOLDINTHETREXESTUMP
let known_dec = playfair_decrypt("BMODZBXDNABEKUDMUIXMMOUVIF", "PLAYFAIREXAMPLE")
cks("known_vector_dec", known_dec, "HIDETHEGOLDINTHETREXESTUMP")

// KAT 7: round-trip with clean plaintext (no doubles, even length)
let rt_enc = playfair_encrypt("MONARCHISAFINE", "KEYWORD")
let rt_dec = playfair_decrypt(rt_enc, "KEYWORD")
cks("roundtrip_clean", rt_dec, "MONARCHISAFINE")

// KAT 8: second round-trip
let rt2_enc = playfair_encrypt("NOVAISFAST", "SECURITYKEY")
let rt2_dec = playfair_decrypt(rt2_enc, "SECURITYKEY")
cks("roundtrip_nova", rt2_dec, "NOVAISFAST")

// KAT 9: empty input safety
cks("empty_enc", playfair_encrypt("", "KEY"), "")
cks("empty_dec", playfair_decrypt("", "KEY"), "")

// KAT 10: single letter padded to digraph -> 2-char ciphertext
let single_enc = playfair_encrypt("A", "KEYWORD")
cki("single_letter_len", len(single_enc), 2)

// KAT 11: J treated same as I in plaintext
let j_enc = playfair_encrypt("JAVA", "KEYWORD")
let i_enc = playfair_encrypt("IAVA", "KEYWORD")
cks("j_as_i", j_enc, i_enc)

// KAT 12: duplicate letters in key -- only first occurrence kept
let sq3 = playfair_square("AABBCC")
cks("dup_key_sq0", sq3[0], "A")
cks("dup_key_sq1", sq3[1], "B")
cks("dup_key_sq2", sq3[2], "C")
cki("dup_key_sq_len", len(sq3), 25)

// KAT 13: same row rule
// Square PLAYFAIREXAMPLE: Row1 = I R E X M
// Pair EX: E=(1,2) X=(1,3) same row -> E->X, X->M => "XM"
let same_row_result = playfair_encrypt("EX", "PLAYFAIREXAMPLE")
cks("same_row_EX", same_row_result, "XM")

// KAT 14: same column rule
// Square PLAYFAIREXAMPLE col 2: A(0,2) E(1,2) D(2,2) O(3,2) V(4,2)
// Pair DE: D=(2,2) E=(1,2) same col -> D row+1=3->O, E row+1=2->D => "OD"
let same_col_result = playfair_encrypt("DE", "PLAYFAIREXAMPLE")
cks("same_col_DE", same_col_result, "OD")

// KAT 15: non-letter stripped input
// "HELPWORLD" = 9 letters no doubles -> HE LP WO RL DX -> 10 ct chars
let strip_enc = playfair_encrypt("HELPWORLD", "KEYWORD")
cki("stripped_len", len(strip_enc), 10)

print("PASS _playfair_test")
