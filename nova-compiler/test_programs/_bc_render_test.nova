import std/barcode/bc_render

fn chki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn chks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=[" + got + "] want=[" + want + "]")
        exit(1)

// ── KAT: render_ascii ────────────────────────────────────────────────────────

// KAT-1: single bar -> full block char; render_ascii("1") has length 1 in our model.
// NOTE: chr(9608) = U+2588 encodes as 3 UTF-8 bytes in C-string representation.
// We check length by comparing substring equality, not ord().
let block = chr(9608)
let r1 = render_ascii("1")
// The result should equal the block character
chks("ra_1_is_block", r1, block)

// KAT-2: "101" -> bar space bar, when we compare the known output
let r2 = render_ascii("101")
let want101 = block + " " + block
chks("ra_101", r2, want101)

// KAT-3: all zeros -> all spaces, length in string chars=3
let r3 = render_ascii("000")
chks("ra_000", r3, "   ")

// KAT-4: "110011" -> block block space space block block
let r4 = render_ascii("110011")
let want110011 = block + block + "  " + block + block
chks("ra_110011", r4, want110011)

// KAT-5: render_ascii("1") length equals len(block)
// (internal string measure: chr(9608) is 3 bytes in UTF-8)
// We just confirm it's non-empty
chki("ra_nonempty", len(r1) > 0, 1)

// ── KAT: render_hash ─────────────────────────────────────────────────────────

// KAT-6: "101" -> "# #"
let rh = render_hash("101")
chks("rh_101", rh, "# #")

// KAT-7: "0" -> " "
chks("rh_0", render_hash("0"), " ")

// KAT-8: "11" -> "##"
chks("rh_11", render_hash("11"), "##")

// KAT-9: "110011" -> "##  ##"
chks("rh_110011", render_hash("110011"), "##  ##")

// ── KAT: render_ascii_tall ───────────────────────────────────────────────────

// KAT-10: height=1 -> same as render_ascii
let rt1 = render_ascii_tall("1", 1)
chks("rat_h1", rt1, block)

// KAT-11: height=2, pattern="1" -> "block\nblock"
// We verify by checking: contains newline and both halves are block
let rt2 = render_ascii_tall("1", 2)
let expected_rt2 = block + "\n" + block
chks("rat_h2", rt2, expected_rt2)

// KAT-12: height=2, pattern "101" -> 2 identical rows separated by \n
let rt3 = render_ascii_tall("101", 2)
let row101 = block + " " + block
let expected_rt3 = row101 + "\n" + row101
chks("rat_h2_101", rt3, expected_rt3)

// KAT-13: height=0 -> empty string
let rt0 = render_ascii_tall("1", 0)
chks("rat_h0_empty", rt0, "")

// KAT-14: height=3 -> 3 rows separated by 2 newlines
let rt_3 = render_ascii_tall("1", 3)
let expected_rt_3 = block + "\n" + block + "\n" + block
chks("rat_h3", rt_3, expected_rt_3)

// KAT-15 (from task spec): render_ascii_tall("1",2) has 2 rows (verified above via string match)
// Additionally verify with render_hash for ASCII sanity check
let rth2 = render_ascii_tall("10", 2)
let rowhash = render_ascii(render_hash("10"))
// just check non-empty
chki("rat_h2_10_nonempty", len(rth2) > 0, 1)

// ── KAT: pattern_to_widths ───────────────────────────────────────────────────

// KAT-16: "110011" -> [2,2,2]
let pw1 = pattern_to_widths("110011")
chki("ptw_110011_len", len(pw1), 3)
chki("ptw_110011_0", pw1[0], 2)
chki("ptw_110011_1", pw1[1], 2)
chki("ptw_110011_2", pw1[2], 2)

// KAT-17: "101" -> [1,1,1]
let pw2 = pattern_to_widths("101")
chki("ptw_101_len", len(pw2), 3)
chki("ptw_101_0", pw2[0], 1)
chki("ptw_101_1", pw2[1], 1)
chki("ptw_101_2", pw2[2], 1)

// KAT-18: "1" -> [1]
let pw3 = pattern_to_widths("1")
chki("ptw_1_len", len(pw3), 1)
chki("ptw_1_0", pw3[0], 1)

// KAT-19: "" -> [] (empty)
let pw4 = pattern_to_widths("")
chki("ptw_empty_len", len(pw4), 0)

// KAT-20: "1111" -> [4]
let pw5 = pattern_to_widths("1111")
chki("ptw_1111_len", len(pw5), 1)
chki("ptw_1111_0", pw5[0], 4)

// KAT-21: "10" -> [1,1]
let pw6 = pattern_to_widths("10")
chki("ptw_10_len", len(pw6), 2)
chki("ptw_10_0", pw6[0], 1)
chki("ptw_10_1", pw6[1], 1)

// KAT-22: "11100" -> [3,2]
let pw7 = pattern_to_widths("11100")
chki("ptw_11100_len", len(pw7), 2)
chki("ptw_11100_0", pw7[0], 3)
chki("ptw_11100_1", pw7[1], 2)

print("PASS _bc_render_test")
