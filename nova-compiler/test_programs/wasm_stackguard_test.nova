// WASM has neither signals nor SEH, so the software depth counter is the ONLY stack-overflow
// containment available there. Native targets deliberately do not emit it -- the hardware guard
// page catches the fault for free, and a counter in every prologue/epilogue would be a permanent
// throughput cost. This program recurses without bound; under WASM it must exit cleanly via the
// guard instead of dying in an opaque engine trap.
fn deep(n: int) -> int
    if n <= 0
        return 0
    return deep(n - 1) + 1

fn main() -> int
    return deep(100000)
