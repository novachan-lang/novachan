// forge_reqparse_test -- request-line/body parsing hardening (from the HTTP adversarial review wwjmhnt34):
// parse_method must not carry CR/LF into the method (log-injection defense), and parse_body must return
// EXACTLY Content-Length bytes (no over-read of trailing/pipelined bytes). Pure string functions.
import forge

fn main()
    // parse_method: normal
    if forge.parse_method("GET / HTTP/1.1\r\nHost: x\r\n\r\n") != "GET"
        print("FAIL: normal method")
        exit(1)
    if forge.parse_method("POST /x HTTP/1.1\r\n\r\n") != "POST"
        print("FAIL: POST method")
        exit(1)
    // parse_method: a request line with no space before the CRLF must NOT leak CR/LF into the method
    if forge.parse_method("GET\r\nHost: evil\r\n\r\n") != "GET"
        print("FAIL: CR/LF leaked into method -> " + forge.parse_method("GET\r\nHost: evil\r\n\r\n"))
        exit(1)

    // parse_body: clamp to Content-Length -- trailing/pipelined bytes after the declared length are dropped
    if forge.parse_body("POST / HTTP/1.1\r\nContent-Length: 5\r\n\r\nhelloEXTRA") != "hello"
        print("FAIL: body not clamped to Content-Length -> " + forge.parse_body("POST / HTTP/1.1\r\nContent-Length: 5\r\n\r\nhelloEXTRA"))
        exit(1)
    // exact-length body unchanged
    if forge.parse_body("POST / HTTP/1.1\r\nContent-Length: 5\r\n\r\nhello") != "hello"
        print("FAIL: exact body")
        exit(1)
    // no Content-Length, no trailing bytes (e.g. a GET) -> empty body
    if forge.parse_body("GET / HTTP/1.1\r\nHost: x\r\n\r\n") != ""
        print("FAIL: absent CL with no trailing bytes should be empty")
        exit(1)
    // no Content-Length WITH a trailing payload -> LENIENT: the trailing bytes ARE the body (a no-CL request
    // has no length to clamp to and no pipelined boundary to over-read; the string serve paths are one-shot)
    if forge.parse_body("POST /x HTTP/1.1\r\nHost: x\r\n\r\nrawbody") != "rawbody"
        print("FAIL: no-CL request body should be extracted leniently -> " + forge.parse_body("POST /x HTTP/1.1\r\nHost: x\r\n\r\nrawbody"))
        exit(1)
    // duplicate Content-Length is AMBIGUOUS (-2) -> refuse (no body) even though a payload is present
    if forge.parse_body("POST / HTTP/1.1\r\nContent-Length: 5\r\nContent-Length: 6\r\n\r\nhello") != ""
        print("FAIL: ambiguous duplicate CL should yield empty body")
        exit(1)

    print("PASS forge_reqparse (parse_method CR/LF-safe + parse_body clamped to Content-Length)")
