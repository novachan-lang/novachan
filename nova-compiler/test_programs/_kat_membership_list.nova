import forge_membership_list

fn main()
    let m = ml_new()
    m = ml_join(m, "node-1", 1000)
    m = ml_join(m, "node-2", 1001)
    m = ml_join(m, "node-3", 1002)
    assert(ml_total_members(m) == 3, "3 members")
    assert(ml_alive_count(m) == 3, "3 alive")

    m = ml_suspect(m, "node-2")
    assert(ml_status(m, "node-2") == "suspect", "suspected")
    assert(ml_is_alive(m, "node-2") == 0, "suspect not alive")
    assert(ml_suspicion_count(m) == 1, "1 suspicion")

    m = ml_confirm_alive(m, "node-2")
    assert(ml_is_alive(m, "node-2") == 1, "confirmed alive")

    m = ml_confirm_dead(m, "node-3")
    assert(ml_status(m, "node-3") == "dead", "dead")
    assert(ml_alive_count(m) == 2, "2 alive")

    m = ml_leave(m, "node-1")
    assert(ml_status(m, "node-1") == "left", "left")
    assert(ml_alive_count(m) == 1, "1 alive")

    print("MEMBERSHIP-LIST KAT PASS")
