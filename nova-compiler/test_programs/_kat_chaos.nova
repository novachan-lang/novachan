import forge_chaos

fn main()
    let c = chaos_new()
    c = chaos_add_fault(c, "db-latency", "latency", "db-service", 50)
    c = chaos_add_fault(c, "api-error", "error", "api-service", 100)
    assert(chaos_fault_count(c) == 2, "2 faults")

    let r1 = chaos_should_inject(c, "db-service", 10)
    assert(r1["inject"] == 1, "10%50 injected")
    assert(r1["fault"] == "db-latency", "correct fault name")
    assert(r1["kind"] == "latency", "correct kind")

    let r2 = chaos_should_inject(c, "db-service", 75)
    assert(r2["inject"] == 0, "75%50 not injected")

    let r3 = chaos_should_inject(c, "api-service", 99)
    assert(r3["inject"] == 1, "100% always injects")

    assert(chaos_trigger_count(c, "db-latency") == 1, "db triggered 1x")
    assert(chaos_trigger_count(c, "api-error") == 1, "api triggered 1x")
    assert(chaos_log_count(c) == 2, "2 log entries")

    c = chaos_disable_fault(c, "db-latency")
    let r4 = chaos_should_inject(c, "db-service", 10)
    assert(r4["inject"] == 0, "disabled = no inject")

    c = chaos_pause(c)
    let r5 = chaos_should_inject(c, "api-service", 0)
    assert(r5["inject"] == 0, "paused = no inject")

    c = chaos_resume(c)
    let r6 = chaos_should_inject(c, "api-service", 50)
    assert(r6["inject"] == 1, "resumed = inject again")

    assert(chaos_should_inject(c, "nonexistent", 0)["inject"] == 0, "no target")
    assert(chaos_trigger_count(c, "nonexistent") == 0, "no trigger")

    print("CHAOS KAT PASS")
