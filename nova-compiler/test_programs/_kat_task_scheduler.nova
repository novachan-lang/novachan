import forge_task_scheduler

fn main()
    let s = ts_new()
    s = ts_add(s, "low_task", 1)
    s = ts_add(s, "high_task", 10)
    s = ts_add(s, "mid_task", 5)
    assert(ts_task_count(s) == 3, "3 tasks")

    let n = ts_next(s)
    assert(is_ok(n), "next ok")
    assert(unwrap(n) == "high_task", "highest priority first")

    let c = ts_complete(s, "high_task")
    assert(is_ok(c), "complete ok")
    s = unwrap(c)
    assert(ts_pending_count(s) == 2, "2 pending")

    let n2 = ts_next(s)
    assert(is_ok(n2), "next ok 2")
    assert(unwrap(n2) == "mid_task", "mid next")

    let f = ts_fail(s, "mid_task")
    assert(is_ok(f), "fail ok")
    s = unwrap(f)

    assert(ts_completion_rate(s) == 33, "33% complete")

    let bad = ts_complete(s, "nope")
    assert(is_err(bad), "unknown task")

    print("TASK-SCHEDULER KAT PASS")
