import forge_task_scheduler

fn main()
    let ts = ts_new()
    assert(ts_total_count(ts) == 0, "starts empty")

    ts = ts_add(ts, "low-task", 1, 100)
    ts = ts_add(ts, "high-task", 10, 50)
    ts = ts_add(ts, "mid-task", 5, 75)
    assert(ts_total_count(ts) == 3, "3 tasks")
    assert(ts_pending_count(ts) == 3, "3 pending")

    let next = ts_next(ts)
    assert(next["name"] == "high-task", "highest priority first")
    assert(next["priority"] == 10, "priority 10")

    ts = ts_complete(ts, next["id"])
    assert(ts_completed_count(ts) == 1, "1 completed")
    assert(ts_pending_count(ts) == 2, "2 pending")

    let next2 = ts_next(ts)
    assert(next2["name"] == "mid-task", "mid next")

    ts = ts_fail(ts, next2["id"])
    assert(ts_pending_count(ts) == 1, "1 pending after fail")

    let next3 = ts_next(ts)
    assert(next3["name"] == "low-task", "low last")

    ts = ts_complete(ts, next3["id"])
    assert(ts_pending_count(ts) == 0, "0 pending")
    assert(ts_completed_count(ts) == 2, "2 completed")

    print("TASK-SCHEDULER KAT PASS")
