import std/dp/dp_max_subarray

fn cki(got, expected, label)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn ckl(got, expected_len, label)
    if len(got) != expected_len
        print("FAIL " + label + " len: got " + str(len(got)) + " expected " + str(expected_len))
        exit(1)

fn ckli(got, idx, expected, label)
    if got[idx] != expected
        print("FAIL " + label + "[" + str(idx) + "]: got " + str(got[idx]) + " expected " + str(expected))
        exit(1)

fn main()
    // KAT 1: ms_max_sum [-2,1,-3,4,-1,2,1,-5,4] -> 6
    let a1 = []
    push(a1, -2)
    push(a1, 1)
    push(a1, -3)
    push(a1, 4)
    push(a1, -1)
    push(a1, 2)
    push(a1, 1)
    push(a1, -5)
    push(a1, 4)
    cki(ms_max_sum(a1), 6, "max_sum [-2,1,-3,4,-1,2,1,-5,4]")

    // KAT 2: ms_range -> [3,6]
    let r1 = ms_range(a1)
    ckl(r1, 2, "range result length")
    ckli(r1, 0, 3, "range start==3")
    ckli(r1, 1, 6, "range end==6")

    // KAT 3: ms_max_sum all negative [-1,-2,-3] -> -1
    let a2 = []
    push(a2, -1)
    push(a2, -2)
    push(a2, -3)
    cki(ms_max_sum(a2), -1, "max_sum all-neg [-1,-2,-3]")

    // KAT 4: ms_max_sum [5,4,-1,7,8] -> 23 (entire array)
    let a3 = []
    push(a3, 5)
    push(a3, 4)
    push(a3, -1)
    push(a3, 7)
    push(a3, 8)
    cki(ms_max_sum(a3), 23, "max_sum [5,4,-1,7,8]")

    // KAT 5: ms_max_sum_circular [5,-3,5] -> 10
    let a4 = []
    push(a4, 5)
    push(a4, -3)
    push(a4, 5)
    cki(ms_max_sum_circular(a4), 10, "circular [5,-3,5]")

    // KAT 6: ms_max_sum single element [3] -> 3
    let a5 = []
    push(a5, 3)
    cki(ms_max_sum(a5), 3, "max_sum single [3]")

    // KAT 7: ms_range for all-negative [-1,-2,-3] -> [0,0] (single element -1 at index 0)
    let r2 = ms_range(a2)
    ckl(r2, 2, "range all-neg length")
    ckli(r2, 0, 0, "range all-neg start==0")
    ckli(r2, 1, 0, "range all-neg end==0")

    // KAT 8: ms_range for [5,4,-1,7,8] -> [0,4] (entire array)
    let r3 = ms_range(a3)
    ckl(r3, 2, "range [5,4,-1,7,8] length")
    ckli(r3, 0, 0, "range [5,4,-1,7,8] start==0")
    ckli(r3, 1, 4, "range [5,4,-1,7,8] end==4")

    // KAT 9: ms_max_sum_circular all-negative [-1,-2,-3] -> -1 (falls back to linear max)
    cki(ms_max_sum_circular(a2), -1, "circular all-neg [-1,-2,-3]")

    // KAT 10: ms_max_sum_circular single element [3] -> 3
    cki(ms_max_sum_circular(a5), 3, "circular single [3]")

    // KAT 11: ms_max_sum_circular [1,-1,1] -> 2 (1+1 wrapping)
    let a6 = []
    push(a6, 1)
    push(a6, -1)
    push(a6, 1)
    cki(ms_max_sum_circular(a6), 2, "circular [1,-1,1]")

    print("PASS _dp_max_subarray_test")
