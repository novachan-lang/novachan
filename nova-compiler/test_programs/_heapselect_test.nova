import std/collections/heapselect

fn list_eq(a, b)
    if len(a) != len(b)
        return 0
    let i = 0
    while i < len(a)
        if a[i] != b[i]
            return 0
        i = i + 1
    return 1

fn assert_int(label, got, want)
    if got != want
        print("FAIL heapselect " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn assert_list(label, got, want)
    if list_eq(got, want) == 0
        let gs = "["
        let i = 0
        while i < len(got)
            if i > 0
                gs = gs + ","
            gs = gs + str(got[i])
            i = i + 1
        gs = gs + "]"
        let ws = "["
        let j = 0
        while j < len(want)
            if j > 0
                ws = ws + ","
            ws = ws + str(want[j])
            j = j + 1
        ws = ws + "]"
        print("FAIL heapselect " + label + ": got " + gs + " want " + ws)
        exit(1)

fn main()
    let data = [5, 3, 8, 1, 9, 2]

    // KAT 1: kth_smallest k=1 -> 1
    assert_int("kth_smallest_k1", kth_smallest(data, 1), 1)

    // KAT 2: kth_smallest k=2 -> 2
    assert_int("kth_smallest_k2", kth_smallest(data, 2), 2)

    // KAT 3: kth_smallest k=3 -> 3  (spec: [5,3,8,1,9,2] sorted = [1,2,3,5,8,9])
    assert_int("kth_smallest_k3", kth_smallest(data, 3), 3)

    // KAT 4: kth_smallest k=6 (last) -> 9
    assert_int("kth_smallest_k6", kth_smallest(data, 6), 9)

    // KAT 5: kth_largest k=1 -> 9
    assert_int("kth_largest_k1", kth_largest(data, 1), 9)

    // KAT 6: kth_largest k=2 -> 8
    assert_int("kth_largest_k2", kth_largest(data, 2), 8)

    // KAT 7: kth_largest k=3 -> 5
    assert_int("kth_largest_k3", kth_largest(data, 3), 5)

    // KAT 8: top_k_smallest k=3 -> [1,2,3]
    let tk_small3 = top_k_smallest(data, 3)
    assert_list("top_k_smallest_3", tk_small3, [1, 2, 3])

    // KAT 9: top_k_largest k=3 -> [9,8,5]
    let tk_large3 = top_k_largest(data, 3)
    assert_list("top_k_largest_3", tk_large3, [9, 8, 5])

    // KAT 10: k > len -> returns all sorted (clamp)
    let tk_small_all = top_k_smallest(data, 100)
    assert_list("top_k_smallest_overflow", tk_small_all, [1, 2, 3, 5, 8, 9])

    let tk_large_all = top_k_largest(data, 100)
    assert_list("top_k_largest_overflow", tk_large_all, [9, 8, 5, 3, 2, 1])

    // KAT 11: kth_smallest with k > len -> clamps to max = 9
    assert_int("kth_smallest_overflow", kth_smallest(data, 100), 9)

    // KAT 12: kth_largest with k > len -> clamps to min = 1
    assert_int("kth_largest_overflow", kth_largest(data, 100), 1)

    // KAT 13: duplicates — [3,3,1,3,2]
    let dups = [3, 3, 1, 3, 2]
    // sorted: [1,2,3,3,3]
    assert_int("dups_kth_smallest_1", kth_smallest(dups, 1), 1)
    assert_int("dups_kth_smallest_2", kth_smallest(dups, 2), 2)
    assert_int("dups_kth_smallest_3", kth_smallest(dups, 3), 3)
    assert_int("dups_kth_smallest_4", kth_smallest(dups, 4), 3)
    assert_int("dups_kth_largest_1", kth_largest(dups, 1), 3)
    assert_int("dups_kth_largest_2", kth_largest(dups, 2), 3)
    assert_int("dups_kth_largest_3", kth_largest(dups, 3), 3)
    assert_int("dups_kth_largest_4", kth_largest(dups, 4), 2)

    // KAT 14: top_k with duplicates
    let tk_dups2 = top_k_smallest(dups, 2)
    assert_list("dups_top_k_smallest_2", tk_dups2, [1, 2])

    let tk_dups3 = top_k_largest(dups, 3)
    assert_list("dups_top_k_largest_3", tk_dups3, [3, 3, 3])

    // KAT 15: single element
    let one = [42]
    assert_int("single_kth_smallest_1", kth_smallest(one, 1), 42)
    assert_int("single_kth_largest_1", kth_largest(one, 1), 42)
    let single_s = top_k_smallest(one, 1)
    assert_list("single_top_k_smallest", single_s, [42])
    let single_l = top_k_largest(one, 1)
    assert_list("single_top_k_largest", single_l, [42])

    // KAT 16: empty list
    let empty = []
    let r1 = kth_smallest(empty, 1)
    if r1 != null
        print("FAIL heapselect empty_kth_smallest: expected null")
        exit(1)
    let r2 = kth_largest(empty, 1)
    if r2 != null
        print("FAIL heapselect empty_kth_largest: expected null")
        exit(1)
    let r3 = top_k_smallest(empty, 3)
    assert_list("empty_top_k_smallest", r3, [])
    let r4 = top_k_largest(empty, 3)
    assert_list("empty_top_k_largest", r4, [])

    // KAT 17: k=1 is essentially find-min / find-max
    let big = [7, 4, 2, 9, 1, 6, 8, 3, 5]
    assert_int("big_min", kth_smallest(big, 1), 1)
    assert_int("big_max", kth_largest(big, 1), 9)
    assert_int("big_2nd_smallest", kth_smallest(big, 2), 2)
    assert_int("big_2nd_largest", kth_largest(big, 2), 8)

    print("PASS _heapselect_test")
