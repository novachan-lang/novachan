import forge_request_pipeline

fn main()
    let p = rp_new()
    assert(rp_middleware_count(p) == 0, "no middleware")

    p = rp_use(p, "auth", "pass")
    p = rp_use(p, "logging", "pass")
    p = rp_use(p, "handler", "pass")
    assert(rp_middleware_count(p) == 3, "3 middleware")

    let r1 = rp_process(p, "/api/users")
    p = r1["p"]
    assert(r1["steps_run"] == 3, "3 steps run")
    assert(r1["aborted"] == 0, "not aborted")
    assert(rp_total_processed(p) == 1, "1 processed")

    p = rp_disable(p, 1)
    let r2 = rp_process(p, "/api/orders")
    p = r2["p"]
    assert(r2["steps_run"] == 2, "2 steps (logging disabled)")

    p = rp_enable(p, 1)
    p = rp_use(p, "blocker", "reject")
    let r3 = rp_process(p, "/blocked")
    p = r3["p"]
    assert(r3["aborted"] == 1, "aborted by reject")
    assert(rp_total_aborted(p) == 1, "1 aborted")
    assert(rp_total_processed(p) == 2, "still 2 processed")

    print("REQUEST-PIPELINE KAT PASS")
