import forge_circuit_monitor

fn main()
    let cm = cm_new()
    cm = cm_register(cm, "payment-api", 3)
    cm = cm_register(cm, "user-api", 5)
    assert(cm_circuit_count(cm) == 2, "2 circuits")

    assert(cm_state(cm, "payment-api") == "closed", "starts closed")

    cm = cm_record_success(cm, "payment-api")
    cm = cm_record_success(cm, "payment-api")
    cm = cm_record_failure(cm, "payment-api")
    cm = cm_record_failure(cm, "payment-api")
    assert(cm_state(cm, "payment-api") == "closed", "still closed at 2 failures")
    assert(cm_failure_rate(cm, "payment-api") == 50, "50% failure rate")

    cm = cm_record_failure(cm, "payment-api")
    assert(cm_state(cm, "payment-api") == "open", "tripped at 3 failures")
    assert(cm_trip_count(cm, "payment-api") == 1, "1 trip")
    assert(cm_open_count(cm) == 1, "1 open circuit")

    cm = cm_half_open(cm, "payment-api")
    assert(cm_state(cm, "payment-api") == "half-open", "half-open")

    cm = cm_reset(cm, "payment-api")
    assert(cm_state(cm, "payment-api") == "closed", "reset to closed")

    assert(cm_state(cm, "nonexistent") == "", "unknown = empty")
    assert(cm_failure_rate(cm, "nonexistent") == 0, "unknown = 0 rate")
    assert(cm_trip_count(cm, "nonexistent") == 0, "unknown = 0 trips")

    cm = cm_record_success(cm, "nonexistent")
    assert(cm_circuit_count(cm) == 2, "still 2 circuits")

    print("CIRCUIT-MONITOR KAT PASS")
