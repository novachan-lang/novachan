/// real_cli_grep.nova — A real grep-like CLI tool written in NOVA
///
/// Demonstrates: file I/O, string processing, command-line parsing,
/// pattern matching, colored output, result formatting.
///
/// Usage: nova_grep <pattern> <file>
///   -i         case-insensitive
///   -n         show line numbers
///   -c         count matches only
///   --after N  show N lines after each match

fn _to_lower(s)
    let result = ""
    let i = 0
    while i < len(s)
        let c = ord(s[i])
        if c >= 65 and c <= 90
            result = result + chr(c + 32)
        else
            result = result + s[i]
        i = i + 1
    result

fn _contains_pattern(line, pattern, case_insensitive)
    if case_insensitive
        contains(_to_lower(line), _to_lower(pattern))
    else
        contains(line, pattern)

fn _highlight_match(line, pattern, case_insensitive)
    let search_line = if case_insensitive
        _to_lower(line)
    else
        line
    let search_pat = if case_insensitive
        _to_lower(pattern)
    else
        pattern
    let idx = find(search_line, search_pat)
    if idx < 0
        return line
    let before = slice(line, 0, idx)
    let matched = slice(line, idx, idx + len(pattern))
    let after = slice(line, idx + len(pattern), len(line))
    let esc = chr(27)
    before + esc + "[1;31m" + matched + esc + "[0m" + after

fn _parse_args(args)
    let opts = {"pattern": "", "file": "", "case_insensitive": 0, "show_numbers": 0, "count_only": 0, "after_context": 0}
    let i = 1
    while i < len(args)
        let arg = str(args[i])
        if arg == "-i"
            opts["case_insensitive"] = 1
        else if arg == "-n"
            opts["show_numbers"] = 1
        else if arg == "-c"
            opts["count_only"] = 1
        else if arg == "--after" and i + 1 < len(args)
            i = i + 1
            opts["after_context"] = parse_int(str(args[i]))
        else if opts["pattern"] == ""
            opts["pattern"] = arg
        else
            opts["file"] = arg
        i = i + 1
    opts

fn grep_string(content, pattern, case_insensitive, show_numbers, count_only, after_context)
    let lines = split(content, "\n")
    let matches = []
    let match_count = 0
    let remaining_after = 0

    let line_num = 0
    while line_num < len(lines)
        let line = lines[line_num]
        let is_match = _contains_pattern(line, pattern, case_insensitive)

        if is_match
            match_count = match_count + 1
            remaining_after = after_context
            if not count_only
                let display = _highlight_match(line, pattern, case_insensitive)
                if show_numbers
                    push(matches, str(line_num + 1) + ":" + display)
                else
                    push(matches, display)
        else if remaining_after > 0
            remaining_after = remaining_after - 1
            if not count_only
                if show_numbers
                    push(matches, str(line_num + 1) + "-" + line)
                else
                    push(matches, line)
                if remaining_after == 0 and line_num + 1 < len(lines)
                    push(matches, "--")
        line_num = line_num + 1

    {"matches": matches, "count": match_count}

fn _test_basic_grep()
    let content = "Hello World\nfoo bar\nHello NOVA\nbaz qux\nhello again"
    let r = grep_string(content, "Hello", 0, 0, 0, 0)
    assert(r["count"] == 2, "found 2 Hello matches")
    assert(len(r["matches"]) == 2, "2 match lines")
    print("  basic grep: PASS")

fn _test_case_insensitive()
    let content = "Hello World\nfoo bar\nHello NOVA\nbaz qux\nhello again"
    let r = grep_string(content, "hello", 1, 0, 0, 0)
    assert(r["count"] == 3, "found 3 case-insensitive matches")
    print("  case insensitive: PASS")

fn _test_line_numbers()
    let content = "aaa\nbbb\nccc\nbbb\neee"
    let r = grep_string(content, "bbb", 0, 1, 0, 0)
    assert(r["count"] == 2, "2 bbb matches")
    let m0 = str(r["matches"][0])
    assert(starts_with(m0, "2:"), "first match at line 2: " + m0)
    print("  line numbers: PASS")

fn _test_count_only()
    let content = "apple\nbanana\napricot\navocado\nblueberry"
    let r = grep_string(content, "a", 0, 0, 1, 0)
    assert(r["count"] == 4, "4 lines with 'a'")
    assert(len(r["matches"]) == 0, "count-only shows no lines")
    print("  count only: PASS")

fn _test_after_context()
    let content = "line1\nMATCH\nctx1\nctx2\nline5\nMATCH2\nctx3"
    let r = grep_string(content, "MATCH", 0, 0, 0, 2)
    assert(r["count"] == 2, "2 matches")
    assert(len(r["matches"]) > 2, "context lines included")
    print("  after context: PASS")

fn _test_highlight()
    let line = "Hello World"
    let h = _highlight_match(line, "World", 0)
    assert(contains(h, chr(27) + "[1;31m"), "has color code")
    assert(contains(h, "World"), "has match text")
    print("  highlight: PASS")

fn _test_no_matches()
    let content = "foo\nbar\nbaz"
    let r = grep_string(content, "xyz", 0, 0, 0, 0)
    assert(r["count"] == 0, "no matches")
    assert(len(r["matches"]) == 0, "no match lines")
    print("  no matches: PASS")

fn main()
    _test_basic_grep()
    _test_case_insensitive()
    _test_line_numbers()
    _test_count_only()
    _test_after_context()
    _test_highlight()
    _test_no_matches()
    print("real_cli_grep: all passed")
