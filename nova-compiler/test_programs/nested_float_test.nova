// FINDING #1 nested: floats stored in a list must serialize correctly in JSON,
// and read back correctly for computation. Previously float list elements printed
// as garbage bits. Now the compiler boxes float elements (type-directed) and the
// JSON walker / accessors handle them.
fn main()
    let lst = []
    lst.push(1.5)
    lst.push(2.5)
    lst.push(0.25)
    // JSON of a float list — was garbage, now exact (hand-computed oracle).
    assert_eq(json_encode(lst), "[1.5,2.5,0.25]")
    // Read-back must transparently unbox to a usable float.
    assert_near(lst[0], 1.5, 0.001)
    assert_near(lst[2], 0.25, 0.001)
    print("nested float list test passed")
