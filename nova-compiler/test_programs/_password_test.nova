// _password_test.nova — KAT for std/validation/password
import std/validation/password

fn ckb(label: string, got: bool, expected: bool)
    if got != expected
        let gs = "false"
        if got
            gs = "true"
        let es = "false"
        if expected
            es = "true"
        print("FAIL " + label + ": got " + gs + " expected " + es)
        exit(1)

fn cki(label: string, got: int, expected: int)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(label: string, got: string, expected: string)
    if got != expected
        print("FAIL " + label + ": got " + got + " expected " + expected)
        exit(1)

fn main()
    // --- vpw_score ---
    // "abc": len=3(<8), has_lower=yes, no upper, no digit, no special -> score=1
    cki("score_abc",        vpw_score("abc"),        1)

    // "Abcdef12": len=8(+1), lower=yes(+1), upper=yes(+1), digit=yes(+1), no special -> score=4
    cki("score_Abcdef12",   vpw_score("Abcdef12"),   4)

    // "Abcdef1!": len=8(+1), lower=yes(+1), upper=yes(+1), digit=yes(+1), special=yes(+1) -> score=5
    cki("score_Abcdef1!",   vpw_score("Abcdef1!"),   5)

    // "" (empty): nothing -> score=0
    cki("score_empty",      vpw_score(""),            0)

    // "ABCDEFGH": len>=8, upper, no lower, no digit, no special -> score=2
    cki("score_ABCDEFGH",   vpw_score("ABCDEFGH"),   2)

    // "abc12345!": len>=8, lower, no upper, digit, special -> score=4
    cki("score_abc12345!",  vpw_score("abc12345!"),  4)

    // --- vpw_strength ---
    // score=5 -> "strong"
    cks("strength_strong",   vpw_strength("Abcdef1!"),  "strong")

    // "abc" -> score=1 -> "weak"
    cks("strength_weak_abc", vpw_strength("abc"),        "weak")

    // "ABCDEFGH" -> score=2 -> "weak"
    cks("strength_weak2",    vpw_strength("ABCDEFGH"),   "weak")

    // "Abcdef12" -> score=4 -> "medium"
    cks("strength_medium4",  vpw_strength("Abcdef12"),   "medium")

    // "abc12345!" -> score=4 -> "medium"
    cks("strength_medium4b", vpw_strength("abc12345!"),  "medium")

    // "abcABC1!" -> score=5 -> "strong"
    cks("strength_strong2",  vpw_strength("abcABC1!"),   "strong")

    // --- vpw_meets ---
    // "Abcdef1!" meets(8, true, true, true) -> true
    ckb("meets_all_true",    vpw_meets("Abcdef1!", 8, true, true, true),   true)

    // "abcdefgh" meets(8, true, true, true) -> false (no upper, no digit, no special)
    ckb("meets_no_upper_digit_special", vpw_meets("abcdefgh", 8, true, true, true), false)

    // "abcdefgh" meets(8, false, false, false) -> true (only length required)
    ckb("meets_len_only_true",  vpw_meets("abcdefgh", 8, false, false, false), true)

    // "abc" meets(8, false, false, false) -> false (too short)
    ckb("meets_too_short",      vpw_meets("abc", 8, false, false, false), false)

    // "Abcdef1!" meets(6, true, false, false) -> true (len>=6, has upper)
    ckb("meets_len6_upper",     vpw_meets("Abcdef1!", 6, true, false, false), true)

    // "ABCDEFGH" meets(8, true, true, false) -> false (no digit)
    ckb("meets_no_digit",       vpw_meets("ABCDEFGH", 8, true, true, false), false)

    // --- vpw_has_upper / vpw_has_lower / vpw_has_digit / vpw_has_special ---
    ckb("has_upper_true",    vpw_has_upper("Abcdef1!"),  true)
    ckb("has_upper_false",   vpw_has_upper("abcdef1!"),  false)
    ckb("has_lower_true",    vpw_has_lower("Abcdef1!"),  true)
    ckb("has_lower_false",   vpw_has_lower("ABCDEF1!"),  false)
    ckb("has_digit_true",    vpw_has_digit("Abcdef1!"),  true)
    ckb("has_digit_false",   vpw_has_digit("abc"),       false)
    ckb("has_special_true",  vpw_has_special("a!b"),     true)
    ckb("has_special_false", vpw_has_special("abc123"),  false)

    // Additional special character edge cases
    ckb("has_special_hash",  vpw_has_special("abc#def"), true)
    ckb("has_special_space", vpw_has_special("abc def"), false)  // space ord=32, below 33

    print("_password_test passed")
