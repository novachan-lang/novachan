// FLAGSHIP full-stack demo (the founding promise): a NOVA WASM frontend fetches from a NOVA backend
// and renders the response to the DOM, on a click. ONE language, backend + frontend, run anywhere.
// Note: the frontend renders the fetched response (string-level). Rich in-browser JSON parsing
// (json_decode in wasm) awaits m7 -- the JS runtime is a 21/789 partial; full stdlib in-browser
// needs the real tagged runtime compiled to wasm (blocked on a wasi-sdk sysroot). The BACKEND
// parses/serves JSON faithfully (native json_decode/to_json, the JSON-native value model).
extern fn dom_get_by_id(id: string) -> int
extern fn dom_create(tag: string) -> int
extern fn dom_set_text(node: int, txt: string)
extern fn dom_append(parent: int, child: int)
extern fn dom_on_click(node: int, handler_name: string)
extern fn http_get_json(url: string, on_data_name: string)

// callback: the fetched response arrives here as a string; render it under #app.
fn on_items(json_str: string)
    let app = unsafe dom_get_by_id("app")
    let pre = unsafe dom_create("pre")
    unsafe dom_set_text(pre, json_str)
    unsafe dom_append(app, pre)

// click handler: ask the host to fetch from the NOVA backend, callback -> on_items
fn load()
    unsafe http_get_json("/api/items", "on_items")

fn main()
    let app = unsafe dom_get_by_id("app")
    let btn = unsafe dom_create("button")
    unsafe dom_set_text(btn, "Load from NOVA backend")
    unsafe dom_append(app, btn)
    unsafe dom_on_click(btn, "load")
