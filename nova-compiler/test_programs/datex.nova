// datex — pure-NOVA proleptic-Gregorian calendar math: leap years, month lengths,
// day-of-week (Zeller's congruence), day-of-year, validity, and name lookups. Pure
// integer arithmetic; no runtime/compiler changes, no ambient timezone.

fn is_leap_year(y: int) -> bool
    if y % 400 == 0
        return true
    if y % 100 == 0
        return false
    return y % 4 == 0

fn days_in_month(y: int, m: int) -> int
    if m == 2
        if is_leap_year(y)
            return 29
        return 28
    if m == 4 or m == 6 or m == 9 or m == 11
        return 30
    return 31

fn is_valid_date(y: int, m: int, d: int) -> bool
    if m < 1 or m > 12
        return false
    if d < 1 or d > days_in_month(y, m)
        return false
    return true

// 0 = Sunday .. 6 = Saturday (Zeller's congruence, Gregorian).
fn day_of_week(y: int, m: int, d: int) -> int
    let mm = m
    let yy = y
    if mm < 3
        mm = mm + 12
        yy = yy - 1
    let k = yy % 100
    let j = yy / 100
    let h = (d + (13 * (mm + 1)) / 5 + k + k / 4 + j / 4 + 5 * j) % 7
    return (h + 6) % 7

fn day_of_year(y: int, m: int, d: int) -> int
    let total = d
    let i = 1
    while i < m
        total = total + days_in_month(y, i)
        i = i + 1
    return total

fn month_name(m: int) -> string
    let names = ["", "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
    if m < 1 or m > 12
        return "?"
    return names[m]

fn weekday_name(wd: int) -> string
    let names = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]
    if wd < 0 or wd > 6
        return "?"
    return names[wd]

fn main()
    // leap years
    assert_eq(is_leap_year(2000), true)
    assert_eq(is_leap_year(1900), false)
    assert_eq(is_leap_year(2024), true)
    assert_eq(is_leap_year(2023), false)

    // month lengths
    assert_eq(days_in_month(2024, 2), 29)
    assert_eq(days_in_month(2023, 2), 28)
    assert_eq(days_in_month(2024, 4), 30)
    assert_eq(days_in_month(2024, 1), 31)

    // validity
    assert_eq(is_valid_date(2024, 2, 29), true)
    assert_eq(is_valid_date(2023, 2, 29), false)
    assert_eq(is_valid_date(2024, 13, 1), false)

    // day-of-week (0=Sun..6=Sat)
    assert_eq(day_of_week(2000, 1, 1), 6)   // Saturday
    assert_eq(day_of_week(2024, 1, 1), 1)   // Monday
    assert_eq(day_of_week(1970, 1, 1), 4)   // Thursday
    assert_eq(weekday_name(day_of_week(2024, 1, 1)), "Monday")

    // day-of-year
    assert_eq(day_of_year(2024, 1, 1), 1)
    assert_eq(day_of_year(2024, 3, 1), 61)  // 31 + 29 + 1 (leap)
    assert_eq(day_of_year(2023, 3, 1), 60)  // 31 + 28 + 1

    // names
    assert_eq(month_name(1), "January")
    assert_eq(month_name(12), "December")

    print("datex passed")
