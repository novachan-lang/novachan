// _img_rotate_test.nova — KAT for std/image/img_rotate
import std/image/img_rotate

fn lists_equal(a, b)
    let na = len(a)
    let nb = len(b)
    if na != nb
        return 0
    let i = 0
    while i < na
        if a[i] != b[i]
            return 0
        i = i + 1
    return 1

fn list_to_str(lst)
    let s = "["
    let i = 0
    let n = len(lst)
    while i < n
        if i > 0
            s = s + ","
        s = s + str(lst[i])
        i = i + 1
    s = s + "]"
    s

fn main()
    // KAT 1: img_rotate_90 on 2x2 [1,2,3,4] -> [3,1,4,2]
    // Input: row0=[1,2], row1=[3,4]
    // CW90: new_w=2,new_h=2; dst(r,c)=src(h-1-c,r)
    // dst(0,0)=src(1,0)=3, dst(0,1)=src(0,0)=1, dst(1,0)=src(1,1)=4, dst(1,1)=src(0,1)=2
    let px1 = []
    px1.push(1)
    px1.push(2)
    px1.push(3)
    px1.push(4)
    let got1 = img_rotate_90(px1, 2, 2)
    let want1 = []
    want1.push(3)
    want1.push(1)
    want1.push(4)
    want1.push(2)
    if not lists_equal(got1, want1)
        print("FAIL img_rotate_90 2x2: got " + list_to_str(got1) + " want " + list_to_str(want1))
        exit(1)

    // KAT 2: img_rotate_180 on 2x2 [1,2,3,4] -> [4,3,2,1]
    let px2 = []
    px2.push(1)
    px2.push(2)
    px2.push(3)
    px2.push(4)
    let got2 = img_rotate_180(px2, 2, 2)
    let want2 = []
    want2.push(4)
    want2.push(3)
    want2.push(2)
    want2.push(1)
    if not lists_equal(got2, want2)
        print("FAIL img_rotate_180 2x2: got " + list_to_str(got2) + " want " + list_to_str(want2))
        exit(1)

    // KAT 3: img_rotate_270 on 2x2 [1,2,3,4] -> [2,4,1,3]
    // dst(r,c)=src(c,w-1-r): dst(0,0)=src(0,1)=2,dst(0,1)=src(1,1)=4,dst(1,0)=src(0,0)=1,dst(1,1)=src(1,0)=3
    let px3 = []
    px3.push(1)
    px3.push(2)
    px3.push(3)
    px3.push(4)
    let got3 = img_rotate_270(px3, 2, 2)
    let want3 = []
    want3.push(2)
    want3.push(4)
    want3.push(1)
    want3.push(3)
    if not lists_equal(got3, want3)
        print("FAIL img_rotate_270 2x2: got " + list_to_str(got3) + " want " + list_to_str(want3))
        exit(1)

    // KAT 4: rotating a 2x3 image (w=3,h=2) gives a 3x2 (new_w=2,new_h=3)
    // Input w=3,h=2: [1,2,3,4,5,6]
    //   row0=[1,2,3], row1=[4,5,6]
    // CW90: dst(r,c)=src(h-1-c,r), r in [0,new_h=3), c in [0,new_w=2)
    //   dst(0,0)=src(1,0)=4, dst(0,1)=src(0,0)=1
    //   dst(1,0)=src(1,1)=5, dst(1,1)=src(0,1)=2
    //   dst(2,0)=src(1,2)=6, dst(2,1)=src(0,2)=3
    // Output: [4,1,5,2,6,3] (3 rows x 2 cols)
    let px4 = []
    px4.push(1)
    px4.push(2)
    px4.push(3)
    px4.push(4)
    px4.push(5)
    px4.push(6)
    let got4 = img_rotate_90(px4, 3, 2)
    // Verify output has 6 pixels = 3 rows x 2 cols
    if len(got4) != 6
        print("FAIL img_rotate_90 2x3 wrong len: got " + str(len(got4)))
        exit(1)
    let want4 = []
    want4.push(4)
    want4.push(1)
    want4.push(5)
    want4.push(2)
    want4.push(6)
    want4.push(3)
    if not lists_equal(got4, want4)
        print("FAIL img_rotate_90 2x3: got " + list_to_str(got4) + " want " + list_to_str(want4))
        exit(1)

    // KAT 5: four 90-degree rotations of 2x2 returns to original
    let px5 = []
    px5.push(1)
    px5.push(2)
    px5.push(3)
    px5.push(4)
    let r90 = img_rotate_90(px5, 2, 2)
    let r180 = img_rotate_90(r90, 2, 2)
    let r270 = img_rotate_90(r180, 2, 2)
    let r360 = img_rotate_90(r270, 2, 2)
    if not lists_equal(r360, px5)
        print("FAIL 4x rotate_90 not identity: got " + list_to_str(r360) + " want " + list_to_str(px5))
        exit(1)

    // KAT 6: rotate_180 twice is identity
    let px6 = []
    px6.push(10)
    px6.push(20)
    px6.push(30)
    px6.push(40)
    let r1 = img_rotate_180(px6, 2, 2)
    let r2 = img_rotate_180(r1, 2, 2)
    if not lists_equal(r2, px6)
        print("FAIL 2x rotate_180 not identity: got " + list_to_str(r2) + " want " + list_to_str(px6))
        exit(1)

    // KAT 7: rotate_90 + rotate_270 = identity (on square image)
    let px7 = []
    px7.push(7)
    px7.push(14)
    px7.push(21)
    px7.push(28)
    let rr90 = img_rotate_90(px7, 2, 2)
    let rr90_270 = img_rotate_270(rr90, 2, 2)
    if not lists_equal(rr90_270, px7)
        print("FAIL rotate_90 + rotate_270 not identity: got " + list_to_str(rr90_270) + " want " + list_to_str(px7))
        exit(1)

    print("PASS _img_rotate_test")
