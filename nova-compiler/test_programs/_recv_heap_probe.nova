// Erlang frontier Stage-1 selective-receive UAF/leak PROBE (HEAP messages).
// Strings are RC-managed heap objects, deep-copied on send. Three arrive as "c","b","a" but the
// worker matches them in the order a,b,c -> each receive must DEFER the non-matching heads to the
// save-queue (a HEAP object survives there) and a LATER receive pulls + matches them. If commit's
// remove-at freed a saved message prematurely (no ownership transfer via recv_next's rc_inc), the
// matched-from-save-queue arm reads freed memory -> ASAN heap-use-after-free. The repeated
// defer/re-scan also exercises the recv_defer rc_dec balance (no permanent leak).
fn sworker(parent)
    receive
        "a" => send_msg(parent, 1)
    receive
        "b" => send_msg(parent, 2)
    receive
        "c" => send_msg(parent, 3)

fn main()
    let me = self_pid()
    let w = spawn sworker(me)
    let wb = mailbox_of(w)
    send_msg(wb, "c")          // deferred twice (matched by the 3rd receive)
    send_msg(wb, "b")          // deferred once  (matched by the 2nd receive)
    send_msg(wb, "a")          // matched by the 1st receive
    let r1 = recv_msg()
    assert(r1 == 1, "1st reply 1 (matched a, deferred c,b)")
    let r2 = recv_msg()
    assert(r2 == 2, "2nd reply 2 (b pulled from save-queue, c re-deferred)")
    let r3 = recv_msg()
    assert(r3 == 3, "3rd reply 3 (c pulled from save-queue)")
    print("RECV_HEAP_OK")
