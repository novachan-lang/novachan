// KAT probe for std/data/ndjson — Newline-Delimited JSON
//
// All answers hand-computed.  The NDJSON document under test is:
//   {"a":1}
//   {"b":2}
// (two lines, joined by chr(10), built with chr(34) for double-quotes
//  and chr(123)/chr(125) for braces to avoid NOVA string interpolation.)
import std/data/ndjson

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn main()
    let q  = chr(34)
    let lb = chr(123)
    let rb = chr(125)
    let nl = chr(10)

    // Build: {"a":1}\n{"b":2}
    let line1 = lb + q + "a" + q + ":1" + rb
    let line2 = lb + q + "b" + q + ":2" + rb
    let t = line1 + nl + line2

    // ── KAT 1: nd_parse returns a list of length 2 ──────────────────────────
    let parsed = nd_parse(t)
    cki("kat1-len", len(parsed), 2)
    print("KAT 1 PASS: nd_parse length == 2")

    // ── KAT 2: first value is a dict with key "a" == 1 ──────────────────────
    let first = parsed[0]
    cks("kat2-type-first", type_of(first), "dict")
    // Access the "a" key via dict indexing (value is any-typed after json_parse).
    let a_val = first["a"]
    cki("kat2-a-eq-1", a_val, 1)
    print("KAT 2 PASS: parsed[0][" + q + "a" + q + "] == 1")

    // ── KAT 3: second value is a dict with key "b" == 2 ─────────────────────
    let second = parsed[1]
    cks("kat3-type-second", type_of(second), "dict")
    let b_val = second["b"]
    cki("kat3-b-eq-2", b_val, 2)
    print("KAT 3 PASS: parsed[1][" + q + "b" + q + "] == 2")

    // ── KAT 4: nd_count(t) == 2 ─────────────────────────────────────────────
    let cnt = nd_count(t)
    cki("kat4-count", cnt, 2)
    print("KAT 4 PASS: nd_count == 2")

    // ── KAT 5: nd_count with a trailing blank line still == 2 ───────────────
    let t_trail = t + nl
    let cnt2 = nd_count(t_trail)
    cki("kat5-count-trailing-nl", cnt2, 2)
    print("KAT 5 PASS: nd_count with trailing newline == 2")

    // ── KAT 6: nd_stringify -> nd_parse round-trip preserves both values ─────
    let rt_text = nd_stringify(parsed)
    let rt = nd_parse(rt_text)
    cki("kat6-rt-len", len(rt), 2)
    let rt0 = rt[0]
    let rt1 = rt[1]
    cki("kat6-rt-a", rt0["a"], 1)
    cki("kat6-rt-b", rt1["b"], 2)
    print("KAT 6 PASS: nd_stringify -> nd_parse round-trip yields same values")

    // ── KAT 7: nd_stringify of empty list == "" ──────────────────────────────
    let empty_list = []
    let empty_str = nd_stringify(empty_list)
    cks("kat7-stringify-empty", empty_str, "")
    print("KAT 7 PASS: nd_stringify([]) == empty string")

    // ── KAT 8: nd_count of empty string == 0 ────────────────────────────────
    let cnt3 = nd_count("")
    cki("kat8-count-empty", cnt3, 0)
    print("KAT 8 PASS: nd_count('') == 0")

    print("_ndjson_test passed")
