import std/backtracking/bt_restore_ip

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn list_contains_str(xs: list, target: string) -> bool
    let i = 0
    while i < len(xs)
        if xs[i] == target
            return true
        i = i + 1
    false

fn main()
    // ri_count basic cases
    cki("ri_count_25525511135", ri_count("25525511135"), 2)
    cki("ri_count_0000", ri_count("0000"), 1)
    cki("ri_count_1111", ri_count("1111"), 1)
    cki("ri_count_101023", ri_count("101023"), 5)
    cki("ri_count_12", ri_count("12"), 0)
    cki("ri_count_empty", ri_count(""), 0)
    cki("ri_count_255255255255", ri_count("255255255255"), 1)
    cki("ri_count_256256256256", ri_count("256256256256"), 0)
    cki("ri_count_00000", ri_count("00000"), 0)

    // ri_solve("0000") -> ["0.0.0.0"]
    let s0 = ri_solve("0000")
    cki("ri_solve_0000_len", len(s0), 1)
    cks("ri_solve_0000[0]", s0[0], "0.0.0.0")

    // ri_solve("1111") -> ["1.1.1.1"]
    let s1 = ri_solve("1111")
    cki("ri_solve_1111_len", len(s1), 1)
    cks("ri_solve_1111[0]", s1[0], "1.1.1.1")

    // ri_solve("25525511135") -> ["255.255.11.135", "255.255.111.35"] in depth-first order
    let s2 = ri_solve("25525511135")
    cki("ri_solve_25525511135_len", len(s2), 2)
    cks("ri_solve_25525511135[0]", s2[0], "255.255.11.135")
    cks("ri_solve_25525511135[1]", s2[1], "255.255.111.35")

    // ri_solve("101023") has 5 results; check all 5 expected addresses are present
    let s3 = ri_solve("101023")
    cki("ri_solve_101023_len", len(s3), 5)
    ckb("ri_solve_101023_has_1.0.10.23", list_contains_str(s3, "1.0.10.23"), true)
    ckb("ri_solve_101023_has_1.0.102.3", list_contains_str(s3, "1.0.102.3"), true)
    ckb("ri_solve_101023_has_10.1.0.23", list_contains_str(s3, "10.1.0.23"), true)
    ckb("ri_solve_101023_has_10.10.2.3", list_contains_str(s3, "10.10.2.3"), true)
    ckb("ri_solve_101023_has_101.0.2.3", list_contains_str(s3, "101.0.2.3"), true)

    // Leading zero check: "010010" — "01" and "00" have leading zeros so invalid as multi-char octets
    // Valid: "0.1.0.010"? No, "010" invalid. "0.10.0.10" valid, "0.10.01.0" invalid.
    // Let me check: "010010" len=6
    // (1,1,1,3): 0,1,0,"010" invalid
    // (1,1,2,2): 0,1,"00","10" -> "00" invalid
    // (1,1,3,1): 0,1,"001","0" -> "001" invalid
    // (1,2,1,2): 0,"10","0","10" -> valid: 0.10.0.10
    // (1,2,2,1): 0,"10","01","0" -> "01" invalid
    // (1,3,1,1): 0,"100","1","0" -> valid: 0.100.1.0
    // (2,1,1,2): "01","0","1","0" -> "01" invalid
    // (2,1,2,1): "01","0","10","0" -> "01" invalid
    // (2,2,1,1): "01","00","1","0" -> "01" invalid
    // (3,1,1,1): "010","0","1","0" -> "010" invalid
    // So only 2 valid: "0.10.0.10" and "0.100.1.0"
    let s4 = ri_solve("010010")
    cki("ri_solve_010010_len", len(s4), 2)
    ckb("ri_solve_010010_has_0.10.0.10", list_contains_str(s4, "0.10.0.10"), true)
    ckb("ri_solve_010010_has_0.100.1.0", list_contains_str(s4, "0.100.1.0"), true)

    // ri_solve("12") -> [] (too short for 4 octets)
    let s5 = ri_solve("12")
    cki("ri_solve_12_len", len(s5), 0)

    // 255.255.255.255 is valid
    let s6 = ri_solve("255255255255")
    cki("ri_solve_255255255255_len", len(s6), 1)
    cks("ri_solve_255255255255[0]", s6[0], "255.255.255.255")

    print("PASS _bt_restore_ip_test")
