import forge_data_partitioner

fn main()
    let d = dp_new(4)
    assert(dp_partition_count(d) == 4, "4 partitions")

    let p1 = dp_assign(d, "key1")
    let p2 = dp_assign(d, "key2")
    let p3 = dp_assign(d, "key3")
    let p4 = dp_assign(d, "key4")
    assert(dp_total(d) == 4, "4 total")

    assert(p1 >= 0, "valid partition 1")
    assert(p1 < 4, "valid partition 1 range")
    assert(p2 >= 0, "valid partition 2")
    assert(p3 >= 0, "valid partition 3")
    assert(p4 >= 0, "valid partition 4")

    let sz = dp_partition_size(d, p1)
    assert(is_ok(sz), "size ok")
    assert(unwrap(sz) >= 1, "at least 1 in partition")

    let bad = dp_partition_size(d, 99)
    assert(is_err(bad), "invalid partition")

    let lg = dp_largest_partition(d)
    assert(lg >= 0, "valid largest")
    assert(lg < 4, "valid largest range")

    print("DATA-PARTITIONER KAT PASS")
