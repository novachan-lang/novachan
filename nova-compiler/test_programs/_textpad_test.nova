import std/textlayout/textpad

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn main()
    // tp_ljust: pad right with spaces
    cks("ljust_basic", tp_ljust("hi", 5), "hi   ")
    // tp_ljust: already >= width -> unchanged
    cks("ljust_noop", tp_ljust("hello", 3), "hello")
    // tp_ljust: exactly width -> unchanged
    cks("ljust_exact", tp_ljust("hi", 2), "hi")

    // tp_rjust: pad left with spaces
    cks("rjust_basic", tp_rjust("hi", 5), "   hi")
    cks("rjust_noop", tp_rjust("hello", 3), "hello")

    // tp_center: even padding splits evenly
    cks("center_even", tp_center("hi", 6), "  hi  ")
    // tp_center: odd padding -> extra space to the RIGHT
    cks("center_odd", tp_center("hi", 5), " hi  ")
    // tp_center: no padding needed
    cks("center_noop", tp_center("hi", 2), "hi")

    // tp_ljust_ch: pad right with custom char
    cks("ljust_ch", tp_ljust_ch("7", 4, "0"), "7000")
    cks("ljust_ch_noop", tp_ljust_ch("hello", 3, "x"), "hello")

    // tp_rjust_ch: pad left with custom char
    cks("rjust_ch", tp_rjust_ch("7", 4, "0"), "0007")

    // tp_center_ch: center with custom char
    cks("center_ch_even", tp_center_ch("ab", 6, "-"), "--ab--")
    cks("center_ch_odd", tp_center_ch("ab", 5, "-"), "-ab--")

    // tp_zfill: zero-pad numeric
    cks("zfill_neg", tp_zfill("-5", 4), "-005")
    cks("zfill_pos", tp_zfill("5", 4), "0005")
    cks("zfill_sign_plus", tp_zfill("+5", 4), "+005")
    cks("zfill_noop", tp_zfill("123", 3), "123")
    cks("zfill_noop2", tp_zfill("1234", 3), "1234")

    // tp_repeat: repeat a multi-char string
    cks("repeat_multi", tp_repeat("ab", 3), "ababab")
    cks("repeat_single", tp_repeat("x", 4), "xxxx")
    cks("repeat_zero", tp_repeat("x", 0), "")

    // tp_truncate_pad: truncate when too long
    cks("trunc_pad_trunc", tp_truncate_pad("hello", 3), "hel")
    // tp_truncate_pad: pad when too short
    cks("trunc_pad_pad", tp_truncate_pad("hi", 5), "hi   ")
    // tp_truncate_pad: exact length
    cks("trunc_pad_exact", tp_truncate_pad("hello", 5), "hello")

    print("PASS _textpad_test")
