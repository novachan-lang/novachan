import std/money/allocate

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL allocate " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cklist(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL allocate " + label + " len: got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL allocate " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // ── alloc_equal KAT vectors ───────────────────────────────────────────────

    // 100 / 3 = [34, 33, 33]; remainder=1 goes to first part
    let e1 = alloc_equal(100, 3)
    cklist("equal_100_3", e1, [34, 33, 33])
    cki("equal_100_3_sum", alloc_sum(e1), 100)

    // 10 / 3 = [4, 3, 3]; remainder=1
    let e2 = alloc_equal(10, 3)
    cklist("equal_10_3", e2, [4, 3, 3])
    cki("equal_10_3_sum", alloc_sum(e2), 10)

    // 9 / 3 = [3, 3, 3]; exact
    let e3 = alloc_equal(9, 3)
    cklist("equal_9_3", e3, [3, 3, 3])
    cki("equal_9_3_sum", alloc_sum(e3), 9)

    // 7 / 7 = [1,1,1,1,1,1,1]
    let e4 = alloc_equal(7, 7)
    cki("equal_7_7_len", len(e4), 7)
    cki("equal_7_7_sum", alloc_sum(e4), 7)
    cki("equal_7_7_first", e4[0], 1)

    // alloc_check: parts from equal allocation sum correctly
    cki("check_100_7", alloc_check(100, alloc_equal(100, 7)), 1)

    // alloc_first_remainder
    cki("first_rem_100_3", alloc_first_remainder(100, 3), 34)
    cki("first_rem_9_3", alloc_first_remainder(9, 3), 3)
    cki("first_rem_10_3", alloc_first_remainder(10, 3), 4)

    // ── alloc_weighted KAT vectors ────────────────────────────────────────────

    // [1, 1, 2] -> [25, 25, 50]; exact, no remainder
    let w1 = alloc_weighted(100, [1, 1, 2])
    cklist("weighted_1_1_2", w1, [25, 25, 50])
    cki("weighted_1_1_2_sum", alloc_sum(w1), 100)

    // [1, 1, 1] -> [34, 33, 33]; remainder=1 to largest-remainder slot
    let w2 = alloc_weighted(100, [1, 1, 1])
    cki("weighted_1_1_1_sum", alloc_sum(w2), 100)
    cki("weighted_1_1_1_first", w2[0], 34)
    cki("weighted_1_1_1_second", w2[1], 33)
    cki("weighted_1_1_1_third", w2[2], 33)

    // alloc_check on weighted result
    cki("check_weighted", alloc_check(100, alloc_weighted(100, [1, 1, 1])), 1)

    // ── alloc_percentages KAT vectors ─────────────────────────────────────────

    // 50%+50% of 10000 = [5000, 5000]
    let p1 = alloc_percentages(10000, [5000, 5000])
    cklist("pct_50_50", p1, [5000, 5000])
    cki("pct_50_50_sum", alloc_sum(p1), 10000)

    // 25%+75% of 10000 = [2500, 7500]
    let p2 = alloc_percentages(10000, [2500, 7500])
    cklist("pct_25_75", p2, [2500, 7500])
    cki("pct_25_75_sum", alloc_sum(p2), 10000)

    // 33%+33%+34% (bps: 3300+3300+3400=10000) of 100
    let p3 = alloc_percentages(100, [3300, 3300, 3400])
    cki("pct_33_33_34_sum", alloc_sum(p3), 100)

    // ── alloc_sum edge cases ──────────────────────────────────────────────────

    // Sum of empty list
    cki("sum_empty", alloc_sum([]), 0)

    // Sum of single element
    cki("sum_single", alloc_sum([42]), 42)

    // ── alloc_ratios (alias for alloc_weighted) ───────────────────────────────

    let r1 = alloc_ratios(100, [1, 1, 2])
    cki("ratios_sum", alloc_sum(r1), 100)
    cki("ratios_last", r1[2], 50)

    // ── invariant: alloc_equal sums to original for various values ────────────

    let v = 1000
    let n = 7
    let parts = alloc_equal(v, n)
    cki("inv_1000_7_sum", alloc_sum(parts), v)

    let v2 = 9999
    let parts2 = alloc_equal(v2, 4)
    cki("inv_9999_4_sum", alloc_sum(parts2), v2)

    print("PASS _allocate_test")
