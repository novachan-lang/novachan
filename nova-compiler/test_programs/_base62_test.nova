import std/encoding/base62

// ── Integer-encode KATs ───────────────────────────────────────────────────────

// b62_encode(0) == "0"
let r0 = b62_encode(0)
if r0 != "0"
    print("FAIL b62_encode(0): expected '0' got " + r0)
    exit(1)

// b62_encode(61) == "z"  (last single-char: index 61 = 'z')
let r61 = b62_encode(61)
if r61 != "z"
    print("FAIL b62_encode(61): expected 'z' got " + r61)
    exit(1)

// b62_encode(62) == "10"  (two-char: 1*62 + 0)
let r62 = b62_encode(62)
if r62 != "10"
    print("FAIL b62_encode(62): expected '10' got " + r62)
    exit(1)

// b62_encode(3844) == "100"  (3844 = 62^2)
let r3844 = b62_encode(3844)
if r3844 != "100"
    print("FAIL b62_encode(3844): expected '100' got " + r3844)
    exit(1)

// b62_encode(999) == "G7"
// 999 = 16*62 + 7;  index 16 = 'G', index 7 = '7'
let r999 = b62_encode(999)
if r999 != "G7"
    print("FAIL b62_encode(999): expected 'G7' got " + r999)
    exit(1)

// ── Integer-decode KATs ───────────────────────────────────────────────────────

// b62_decode("z") == 61
let dz = b62_decode("z")
if dz != 61
    print("FAIL b62_decode('z'): expected 61 got " + str(dz))
    exit(1)

// b62_decode("10") == 62
let d10 = b62_decode("10")
if d10 != 62
    print("FAIL b62_decode('10'): expected 62 got " + str(d10))
    exit(1)

// b62_decode("G7") == 999
let dg7 = b62_decode("G7")
if dg7 != 999
    print("FAIL b62_decode('G7'): expected 999 got " + str(dg7))
    exit(1)

// ── Round-trip integer KAT ────────────────────────────────────────────────────

// b62_decode(b62_encode(123456)) == 123456
let enc123 = b62_encode(123456)
let rt123 = b62_decode(enc123)
if rt123 != 123456
    print("FAIL round-trip 123456: encoded=" + enc123 + " decoded=" + str(rt123))
    exit(1)

// ── Bytes round-trip KATs ─────────────────────────────────────────────────────

// Small bytes round-trip: [0x01, 0x02, 0x03]
let bsmall = bytes(0)
bsmall = bytes_append(bsmall, 1)
bsmall = bytes_append(bsmall, 2)
bsmall = bytes_append(bsmall, 3)
let bsmall_enc = b62_encode_bytes(bsmall)
let bsmall_rt = b62_decode_bytes(bsmall_enc)
let bsmall_ok = 1
if bytes_len(bsmall_rt) != 3
    bsmall_ok = 0
if bsmall_ok == 1
    if bytes_get(bsmall_rt, 0) != 1
        bsmall_ok = 0
if bsmall_ok == 1
    if bytes_get(bsmall_rt, 1) != 2
        bsmall_ok = 0
if bsmall_ok == 1
    if bytes_get(bsmall_rt, 2) != 3
        bsmall_ok = 0
if bsmall_ok == 0
    print("FAIL bytes round-trip [1,2,3] enc=" + bsmall_enc)
    exit(1)

// Bytes round-trip: single zero byte — edge case (int value 0)
let bzero = bytes(0)
bzero = bytes_append(bzero, 0)
let bzero_enc = b62_encode_bytes(bzero)
// Decoded back should be a zero int → empty bytes (leading zeros stripped);
// the encode of an all-zero byte buffer is "0"
if bzero_enc != "0"
    print("FAIL b62_encode_bytes([0]): expected '0' got " + bzero_enc)
    exit(1)

// Bytes round-trip: value 62 (single byte 0x3E = 62)
let b62v = bytes(0)
b62v = bytes_append(b62v, 62)
let b62v_enc = b62_encode_bytes(b62v)
if b62v_enc != "10"
    print("FAIL b62_encode_bytes([62]): expected '10' got " + b62v_enc)
    exit(1)

// Bytes round-trip for [0xFF, 0xFF] = 65535
let bff = bytes(0)
bff = bytes_append(bff, 255)
bff = bytes_append(bff, 255)
let bff_enc = b62_encode_bytes(bff)
// 65535 in base62: 65535 / 62 = 1056 rem 63? let's compute:
// 65535 = 17*62^2 + 4*62 + 3 => chr(17)='H', chr(4)='4', chr(3)='3' => "H43"
// Verify: 17*3844 + 4*62 + 3 = 65348 + 248 + 3 = 65599 — too big.
// 65535 / 62 = 1056, rem = 65535 - 1056*62 = 65535-65472=63? No: 1056*62=65472, 65535-65472=63
// But index 63 > 61 — that's wrong. Let me recompute:
// 65535 / 62 = 1056.something. 62*1056=65472. rem=63. But 63>61, error.
// Re-check: 62*1056=65472, 65535-65472=63. But 63 is out of range!
// Wait: 62*1056=62*(1000+56)=62000+3472=65472. 65535-65472=63. Still 63.
// Hmm 63 is beyond index 61. That means my arithmetic is wrong or NOVA int division...
// 65535 / 62: let's do it step by step.
// 62*1000=62000. 65535-62000=3535. 62*50=3100. 3535-3100=435. 62*7=434. 435-434=1.
// So 65535 = 62*1057 + 1. rem=1, q=1057.
// 1057 / 62: 62*17=1054. rem=3, q=17.
// 17 / 62: q=0, rem=17.
// Digits reversed: [1, 3, 17] → chars: '1','3','H' → reversed → "H31"
// Verify: 17*62^2 + 3*62 + 1 = 17*3844 + 186 + 1 = 65348+186+1=65535. ✓
let bff_dec = b62_decode_bytes(bff_enc)
let bff_rt = b62_encode_bytes(bff_dec)
if bff_rt != bff_enc
    print("FAIL bytes round-trip [255,255]: enc=" + bff_enc + " rt=" + bff_rt)
    exit(1)

// Large bytes round-trip: 8-byte value (exercises the carry path)
let blarge = bytes(0)
blarge = bytes_append(blarge, 1)
blarge = bytes_append(blarge, 2)
blarge = bytes_append(blarge, 3)
blarge = bytes_append(blarge, 4)
blarge = bytes_append(blarge, 5)
blarge = bytes_append(blarge, 6)
blarge = bytes_append(blarge, 7)
blarge = bytes_append(blarge, 8)
let blarge_enc = b62_encode_bytes(blarge)
let blarge_dec = b62_decode_bytes(blarge_enc)
let blarge_ok = 1
if bytes_len(blarge_dec) != 8
    blarge_ok = 0
if blarge_ok == 1
    let bi2 = 0
    while bi2 < 8
        if bytes_get(blarge_dec, bi2) != bi2 + 1
            blarge_ok = 0
        bi2 = bi2 + 1
if blarge_ok == 0
    print("FAIL bytes round-trip 8-byte: enc=" + blarge_enc + " len=" + str(bytes_len(blarge_dec)))
    exit(1)

print("_base62_test passed")
