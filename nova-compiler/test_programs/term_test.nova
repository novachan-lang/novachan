// Compact binary term codec: term_encode(value) -> bytes, term_decode(bytes) -> value.
// A self-describing tag-coded binary serialization (MessagePack / Erlang
// term_to_binary class) — the compact binary alternative to json_stringify text,
// preserving the int/float distinction exactly. Round-trips any Value.

// Test 1: integers round-trip.
let bi = term_encode(42)
let vi = term_decode(bi)
assert(vi == 42, "int round-trip")
assert(term_decode(term_encode(0)) == 0, "zero round-trips")
assert(term_decode(term_encode(0 - 7)) == 0 - 7, "negative int round-trips")
let big = 9000000000
assert(term_decode(term_encode(big)) == big, "large int (>32 bit) round-trips")
print("PASS: integers")

// Test 2: strings round-trip.
let bs = term_encode("hello nova")
let vs = term_decode(bs)
assert(vs == "hello nova", "string round-trip")
assert(term_decode(term_encode("")) == "", "empty string round-trips")
print("PASS: strings")

// Test 3: floats round-trip EXACTLY (binary preserves IEEE bits, unlike text).
let bf = term_encode(3.14159)
let vf = term_decode(bf)
assert(vf == 3.14159, "float round-trip exact")
assert(term_decode(term_encode(0.0)) == 0.0, "zero float")
print("PASS: floats (exact)")

// Test 4: lists round-trip (heterogeneous).
let lst = [1, 2, 3, 100]
let vl = term_decode(term_encode(lst))
assert(len(vl) == 4, "list length")
assert(vl[0] == 1, "list[0]")
assert(vl[3] == 100, "list[3]")
print("PASS: lists")

// Test 5: nested list of lists.
let nested = [[1, 2], [3, 4], [5]]
let vn = term_decode(term_encode(nested))
assert(len(vn) == 3, "outer length")
let inner = vn[1]
assert(inner[0] == 3, "nested[1][0]")
assert(inner[1] == 4, "nested[1][1]")
print("PASS: nested lists")

// Test 6: dicts round-trip.
let d = {}
d["name"] = "nova"
d["count"] = 7
let vd = term_decode(term_encode(d))
assert(vd["name"] == "nova", "dict string value")
assert(vd["count"] == 7, "dict int value")
print("PASS: dicts")

// Test 7: deeply nested structure (dict of lists of dicts) — the real wire case.
let users = []
let u1 = {}
u1["id"] = 1
u1["name"] = "alice"
let u2 = {}
u2["id"] = 2
u2["name"] = "bob"
push(users, u1)
push(users, u2)
let payload = {}
payload["users"] = users
payload["total"] = 2
let rt = term_decode(term_encode(payload))
assert(rt["total"] == 2, "payload total")
let ru = rt["users"]
assert(len(ru) == 2, "two users")
let ru0 = ru[0]
assert(ru0["id"] == 1, "user0 id")
assert(ru0["name"] == "alice", "user0 name")
let ru1 = ru[1]
assert(ru1["name"] == "bob", "user1 name")
print("PASS: deep nested wire payload")

// Test 8: term encoding is more COMPACT than JSON text (varint ints + lengths).
let bytes_term = term_encode(payload)
let json_text = json_stringify(payload)
let tb = bytes_len(bytes_term)
let jc = len(json_text)
print("  term bytes=" + str(tb) + " json chars=" + str(jc))
assert(tb < jc, "binary term form is smaller than JSON text for this payload")
print("PASS: compactness (binary < json)")

print("ALL PASS: term codec — compact binary serialization round-trips")
