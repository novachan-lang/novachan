// Stage 4 guard (run with NOVA_CARRIERS>1): heavy spawn/finish CHURN. Each finished task's fiber is now
// reclaimed by its home carrier at N>1 (was leaked). If reclaim races (UAF), ASAN flags it / it crashes.
// Without the fix, ~20k leaked fiber stacks -> RSS grows into hundreds of MB; with it, RSS stays bounded.
fn task()
    2
fn main() -> int
    let batches = 200
    let per = 100
    let total = 0
    let b = 0
    while b < batches
        let hub = channel()
        let i = 0
        while i < per
            spawn fn()
                send(hub, task())
            i = i + 1
        let got = 0
        while got < per
            total = total + receive(hub)
            got = got + 1
        b = b + 1
    let expected = batches * per * 2          // 200 * 100 * 2 = 40000
    if total != expected
        print("FAIL n1_reclaim total=" + str(total))
        exit(1)
    print("PASS n1_reclaim (200x100 = 20k spawn/finish churn, fibers reclaimed at N>1)")
    return 0
