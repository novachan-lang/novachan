import std/httphdr/http_etag

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)

fn main()
    // ── KAT: het_is_weak ─────────────────────────────────────────────────────
    ckb("is_weak W/abc", het_is_weak("W/" + chr(34) + "abc" + chr(34)), true)
    ckb("is_weak strong", het_is_weak(chr(34) + "abc" + chr(34)), false)
    ckb("is_weak empty", het_is_weak(""), false)
    ckb("is_weak bare", het_is_weak("abc"), false)

    // ── KAT: het_tag ──────────────────────────────────────────────────────────
    cks("tag weak", het_tag("W/" + chr(34) + "abc" + chr(34)), "abc")
    cks("tag strong", het_tag(chr(34) + "abc" + chr(34)), "abc")
    cks("tag empty", het_tag(""), "")
    cks("tag malformed", het_tag("abc"), "")
    cks("tag with content", het_tag(chr(34) + "v2.0" + chr(34)), "v2.0")

    // ── KAT: het_weak_match ───────────────────────────────────────────────────
    ckb("weak_match W vs strong same", het_weak_match("W/" + chr(34) + "abc" + chr(34), chr(34) + "abc" + chr(34)), true)
    ckb("weak_match both strong same", het_weak_match(chr(34) + "abc" + chr(34), chr(34) + "abc" + chr(34)), true)
    ckb("weak_match both weak same", het_weak_match("W/" + chr(34) + "abc" + chr(34), "W/" + chr(34) + "abc" + chr(34)), true)
    ckb("weak_match different", het_weak_match(chr(34) + "x" + chr(34), chr(34) + "y" + chr(34)), false)

    // ── KAT: het_strong_match ─────────────────────────────────────────────────
    ckb("strong_match W vs strong", het_strong_match("W/" + chr(34) + "abc" + chr(34), chr(34) + "abc" + chr(34)), false)
    ckb("strong_match both strong same", het_strong_match(chr(34) + "abc" + chr(34), chr(34) + "abc" + chr(34)), true)
    ckb("strong_match both weak", het_strong_match("W/" + chr(34) + "abc" + chr(34), "W/" + chr(34) + "abc" + chr(34)), false)
    ckb("strong_match different", het_strong_match(chr(34) + "x" + chr(34), chr(34) + "y" + chr(34)), false)

    // ── KAT: het_matches_list ─────────────────────────────────────────────────
    ckb("matches_list star", het_matches_list(chr(34) + "abc" + chr(34), "*"), true)
    ckb("matches_list found", het_matches_list(chr(34) + "abc" + chr(34), chr(34) + "x" + chr(34) + ", " + chr(34) + "abc" + chr(34)), true)
    ckb("matches_list not found", het_matches_list(chr(34) + "abc" + chr(34), chr(34) + "y" + chr(34)), false)
    ckb("matches_list weak in list", het_matches_list("W/" + chr(34) + "abc" + chr(34), chr(34) + "abc" + chr(34)), true)
    ckb("matches_list empty list", het_matches_list(chr(34) + "abc" + chr(34), ""), false)

    print("PASS _http_etag_test")
