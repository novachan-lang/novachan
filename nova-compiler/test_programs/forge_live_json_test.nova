// Forge S5 LiveView: the patch wire format. patch_json serializes a diff to the compact
// {"c":[{"i":I,"v":"V"}]} the client applies by slot index. Asserts: both changed slots present with
// stringified values, an empty patch -> c:[], and a value containing a quote is JSON-escaped (cannot
// break the message frame). Pure, socketless, deterministic.
import forge_live

fn main()
    let q = chr(34)
    let bs = chr(92)

    // both slots change -> two wire entries
    let p2 = live_diff(["a", "1"], ["b", "2"])
    let j = patch_json(p2)
    if find(j, q + "c" + q + ":[") < 0
        print("FAIL: missing c array -> " + j)
        exit(1)
    if find(j, q + "i" + q + ":0," + q + "v" + q + ":" + q + "b" + q) < 0
        print("FAIL: slot 0 entry missing -> " + j)
        exit(1)
    if find(j, q + "i" + q + ":1," + q + "v" + q + ":" + q + "2" + q) < 0
        print("FAIL: slot 1 entry missing -> " + j)
        exit(1)

    // no change -> empty changed array
    let je = patch_json(live_diff(["a"], ["a"]))
    if find(je, "[]") < 0
        print("FAIL: empty patch should serialize c:[] -> " + je)
        exit(1)

    // a value containing a double-quote must be escaped (\")
    let jq = patch_json(live_diff([""], [q]))
    if find(jq, bs + q) < 0
        print("FAIL: a quote in a value must be JSON-escaped -> " + jq)
        exit(1)

    print("PASS forge_live_json (patch_json: compact c/i/v wire, empty -> c:[], quote escaped)")
