// KAT for std/game/deck — standard 52-card deck utilities.
// Deterministic vectors verified by hand against the spec.
import std/game/deck

// cki — check int equality; print FAIL and exit(1) on mismatch.
fn cki(label, got, want)
    if got != want
        print("FAIL deck " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// ckb — check bool equality; print FAIL and exit(1) on mismatch.
fn ckb(label, got, want)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL deck " + label + ": got " + gs + " want " + ws)
        exit(1)

// ckcard — check that a card at position i equals [r,s].
fn ckcard(label, card, r, s)
    if card[0] != r or card[1] != s
        print("FAIL deck " + label + ": got [" + str(card[0]) + "," + str(card[1]) + "] want [" + str(r) + "," + str(s) + "]")
        exit(1)

fn main()
    let d = deck()

    // len(deck()) == 52
    cki("len(deck())", len(d), 52)

    // deck()[0] == [2,0]
    ckcard("deck()[0]", d[0], 2, 0)

    // deck()[51] == [14,3]
    ckcard("deck()[51]", d[51], 14, 3)

    // deck_size() == 52
    cki("deck_size()", deck_size(), 52)

    // deck_contains(deck(), [14,3]) == true
    let ace_spades = [14, 3]
    ckb("deck_contains([14,3])", deck_contains(d, ace_spades), true)

    // deck_contains should return false for a non-existent card
    let bad_card = [1, 0]
    ckb("deck_contains([1,0])", deck_contains(d, bad_card), false)

    // deck_index([2,0]) == 0
    let two_clubs = [2, 0]
    cki("deck_index([2,0])", deck_index(two_clubs), 0)

    // deck_index([14,3]) == 51
    let ace_sp2 = [14, 3]
    cki("deck_index([14,3])", deck_index(ace_sp2), 51)

    // Spot-check: deck_index([2,1]) == 13 (first diamond)
    let two_diamonds = [2, 1]
    cki("deck_index([2,1])", deck_index(two_diamonds), 13)

    // Spot-check: deck_index([14,0]) == 12 (ace of clubs)
    let ace_clubs = [14, 0]
    cki("deck_index([14,0])", deck_index(ace_clubs), 12)

    // Verify deck ordering: each consecutive card in d has the right index
    cki("deck_index(d[0])", deck_index(d[0]), 0)
    cki("deck_index(d[13])", deck_index(d[13]), 13)
    cki("deck_index(d[26])", deck_index(d[26]), 26)

    // euchre_deck: 24 cards
    let eu = euchre_deck()
    cki("len(euchre_deck())", len(eu), 24)

    // euchre_deck first card: [9,0], last: [14,3]
    ckcard("euchre_deck()[0]", eu[0], 9, 0)
    ckcard("euchre_deck()[23]", eu[23], 14, 3)

    // pinochle_deck: 48 cards
    let pi = pinochle_deck()
    cki("len(pinochle_deck())", len(pi), 48)

    // pinochle first two cards should both be [9,0]
    ckcard("pinochle_deck()[0]", pi[0], 9, 0)
    ckcard("pinochle_deck()[1]", pi[1], 9, 0)

    // pinochle last two cards should both be [14,3]
    ckcard("pinochle_deck()[46]", pi[46], 14, 3)
    ckcard("pinochle_deck()[47]", pi[47], 14, 3)

    print("PASS _deck_test")
