import std/text/wcwidth

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn main()
    cki("ascii_A",        ww_char_width(65),     1)
    cki("hangul_start",   ww_char_width(0x1100), 2)
    cki("cjk_unified",   ww_char_width(0x4E00), 2)
    cki("combining_301", ww_char_width(0x0301), 0)
    cki("zero_width",    ww_char_width(0x200B), 0)
    cki("tab_ctrl",      ww_char_width(9),      -1)
    cki("hangul_syll",   ww_char_width(0xAC00), 2)
    cki("str_hello",     ww_string_width("hello"), 5)
    cki("str_empty",     ww_string_width(""), 0)

    // Non-ASCII: built via from_codepoint to avoid source-encoding ambiguity
    // (same convention as unicode_math_test.nova / normx_test.nova).
    //
    // An ASCII-only test proves nothing about a display-width API: the old
    // byte-wise walker charged every UTF-8 continuation byte as width 1, so a
    // 3-byte CJK codepoint (U+7530 / U+4E2D) reported width 3 instead of the
    // correct 2 -- a 50% over-count. These assertions decode real multi-byte
    // UTF-8 and would have failed against that byte-wise implementation.
    let tian = from_codepoint(0x7530)   // 田 -- CJK unified ideograph, width 2
    let zhong = from_codepoint(0x4E2D)  // 中 -- CJK unified ideograph, width 2
    cki("str_cjk_pair", ww_string_width(tian + zhong), 4)

    cki("str_mixed_cjk", ww_string_width("a" + tian + "b"), 4)

    // Accented Latin: 2 UTF-8 bytes but ONE codepoint of width 1. This is the
    // case that distinguishes correct codepoint-decoding from merely "not
    // over-counting CJK": a byte-wise walker over-counts this string by
    // exactly 1 (6 bytes seen vs 5 codepoints), even though no character here
    // is double-width.
    let eacute = from_codepoint(233)    // é
    cki("str_accented", ww_string_width("h" + eacute + "llo"), 5)

    // Combining mark (width 0) fused onto a base letter (width 1): total
    // width is the base letter's width only, not one unit per codepoint.
    let e_base = from_codepoint(101)      // e
    let acute_mark = from_codepoint(769)  // U+0301 combining acute
    cki("str_combining", ww_string_width(e_base + acute_mark), 1)

    // Control character (ww_char_width returns -1) embedded in a string must
    // still contribute 0, not -1 or 1, to the total -- preserves the
    // pre-existing "if w > 0" skip behavior through the rewrite.
    let tab = from_codepoint(9)
    cki("str_control_embedded", ww_string_width("a" + tab + "b"), 2)

    print("_wcwidth_test passed")
