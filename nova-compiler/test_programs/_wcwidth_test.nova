import std/text/wcwidth

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn main()
    cki("ascii_A",        ww_char_width(65),     1)
    cki("hangul_start",   ww_char_width(0x1100), 2)
    cki("cjk_unified",   ww_char_width(0x4E00), 2)
    cki("combining_301", ww_char_width(0x0301), 0)
    cki("zero_width",    ww_char_width(0x200B), 0)
    cki("tab_ctrl",      ww_char_width(9),      -1)
    cki("hangul_syll",   ww_char_width(0xAC00), 2)
    cki("str_hello",     ww_string_width("hello"), 5)
    cki("str_empty",     ww_string_width(""), 0)
    print("_wcwidth_test passed")
