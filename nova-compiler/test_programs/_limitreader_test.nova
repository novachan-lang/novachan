import std/io/limitreader

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got [" + got + "] expected [" + expected + "]")
        exit(1)

fn main()
    // KAT 1-5: spec example with limit=5 on "hello world"
    let r = lr_new("hello world", 5)
    let s1 = lr_read(r, 3)
    cks("read_3", s1, "hel")

    let s2 = lr_read(r, 10)
    cks("read_10_capped", s2, "lo")

    let ex = lr_exhausted(r)
    cki("exhausted", ex, 1)

    let rem = lr_remaining(r)
    cki("remaining_zero", rem, 0)

    // KAT 5: lr_read_all reads entire string when limit > len
    let r2 = lr_new("abc", 100)
    let sa = lr_read_all(r2)
    cks("read_all", sa, "abc")

    // KAT 6: fresh reader remaining == limit before any read
    let r3 = lr_new("abcdef", 4)
    let rem3 = lr_remaining(r3)
    cki("remaining_fresh", rem3, 4)

    // KAT 7: lr_read_all on a limit=3 string of length 6 returns only 3 chars
    let r4 = lr_new("abcdef", 3)
    let sa4 = lr_read_all(r4)
    cks("read_all_limited", sa4, "abc")

    // KAT 8: after lr_read_all, lr_exhausted is true
    let r5 = lr_new("xyz", 3)
    let _ = lr_read_all(r5)
    let ex5 = lr_exhausted(r5)
    cki("exhausted_after_read_all", ex5, 1)

    // KAT 9: partial read then remaining reflects chars still under limit
    let r6 = lr_new("abcdef", 6)
    let _ = lr_read(r6, 2)
    let rem6 = lr_remaining(r6)
    cki("remaining_after_partial", rem6, 4)

    // KAT 10: reading zero chars is safe and returns empty string
    let r7 = lr_new("hello", 5)
    let s7 = lr_read(r7, 0)
    cks("read_zero", s7, "")
    let rem7 = lr_remaining(r7)
    cki("remaining_after_read_zero", rem7, 5)

    print("_limitreader_test passed")
