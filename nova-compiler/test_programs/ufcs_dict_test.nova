type Rect
    x: Int
    y: Int
    w: Int
    h: Int

type Circle
    cx: Int
    cy: Int
    r: Int

fn Rect.contains(px, py)
    px >= self.x and px < self.x + self.w and py >= self.y and py < self.y + self.h

fn Circle.contains(px, py)
    let dx = px - self.cx
    let dy = py - self.cy
    dx * dx + dy * dy <= self.r * self.r

fn main()
    let d = {"a": 1, "b": 2}
    print("before UFCS")
    let res = d.contains("a")
    print("after UFCS: " + str(res))
    print("ufcs_dict_test: PASS")
