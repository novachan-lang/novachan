import std/game2d/tilemap

fn main()
    // ── KAT 1: tm_new and basic gets ─────────────────────────────────────────
    let m = tm_new(4, 4, 16, 0)

    // All cells should be 0.
    let v00 = tm_get(m, 0, 0)
    if v00 != 0
        print("FAIL tilemap tm_get(0,0) on fresh: got=" + str(v00) + " want=0")
        exit(1)

    // ── KAT 2: tm_set and tm_get ─────────────────────────────────────────────
    tm_set(m, 1, 1, 5)
    let v11 = tm_get(m, 1, 1)
    if v11 != 5
        print("FAIL tilemap tm_get(1,1) after set: got=" + str(v11) + " want=5")
        exit(1)

    let v00b = tm_get(m, 0, 0)
    if v00b != 0
        print("FAIL tilemap tm_get(0,0) unmodified: got=" + str(v00b) + " want=0")
        exit(1)

    // ── KAT 3: tm_is_solid ───────────────────────────────────────────────────
    let solid11 = tm_is_solid(m, 1, 1)
    if solid11 != true
        print("FAIL tilemap tm_is_solid(1,1): got=" + str(solid11) + " want=true")
        exit(1)

    let solid00 = tm_is_solid(m, 0, 0)
    if solid00 != false
        print("FAIL tilemap tm_is_solid(0,0): got=" + str(solid00) + " want=false")
        exit(1)

    // ── KAT 4: tm_in_bounds ──────────────────────────────────────────────────
    let inb_ok = tm_in_bounds(m, 0, 0)
    if inb_ok != true
        print("FAIL tilemap tm_in_bounds(0,0): got=" + str(inb_ok) + " want=true")
        exit(1)

    let inb_edge = tm_in_bounds(m, 3, 3)
    if inb_edge != true
        print("FAIL tilemap tm_in_bounds(3,3): got=" + str(inb_edge) + " want=true")
        exit(1)

    let inb_oob = tm_in_bounds(m, 4, 0)
    if inb_oob != false
        print("FAIL tilemap tm_in_bounds(4,0): got=" + str(inb_oob) + " want=false")
        exit(1)

    let inb_oob2 = tm_in_bounds(m, 0, 4)
    if inb_oob2 != false
        print("FAIL tilemap tm_in_bounds(0,4): got=" + str(inb_oob2) + " want=false")
        exit(1)

    let inb_neg = tm_in_bounds(m, -1, 0)
    if inb_neg != false
        print("FAIL tilemap tm_in_bounds(-1,0): got=" + str(inb_neg) + " want=false")
        exit(1)

    // ── KAT 5: tm_world_to_tile ──────────────────────────────────────────────
    // tilesize=16; world (20,35) -> tile (floor(20/16), floor(35/16)) = (1,2).
    let t1 = tm_world_to_tile(m, 20.0, 35.0)
    let tx1 = t1[0]
    let ty1 = t1[1]
    if tx1 != 1 or ty1 != 2
        print("FAIL tilemap tm_world_to_tile(20,35): got=[" + str(tx1) + "," + str(ty1) + "] want=[1,2]")
        exit(1)

    // (0,0) -> tile (0,0).
    let t2 = tm_world_to_tile(m, 0.0, 0.0)
    if t2[0] != 0 or t2[1] != 0
        print("FAIL tilemap tm_world_to_tile(0,0): got=[" + str(t2[0]) + "," + str(t2[1]) + "] want=[0,0]")
        exit(1)

    // (15.9, 15.9) -> still tile (0,0).
    let t3 = tm_world_to_tile(m, 15.9, 15.9)
    if t3[0] != 0 or t3[1] != 0
        print("FAIL tilemap tm_world_to_tile(15.9,15.9): got=[" + str(t3[0]) + "," + str(t3[1]) + "] want=[0,0]")
        exit(1)

    // (16.0, 16.0) -> tile (1,1).
    let t4 = tm_world_to_tile(m, 16.0, 16.0)
    if t4[0] != 1 or t4[1] != 1
        print("FAIL tilemap tm_world_to_tile(16,16): got=[" + str(t4[0]) + "," + str(t4[1]) + "] want=[1,1]")
        exit(1)

    // ── KAT 6: tm_tile_to_world ──────────────────────────────────────────────
    // tile (1,2) -> world top-left (1*16, 2*16) = (16, 32).
    let w1 = tm_tile_to_world(m, 1, 2)
    let wx1 = w1[0]
    let wy1 = w1[1]
    if wx1 != 16 or wy1 != 32
        print("FAIL tilemap tm_tile_to_world(1,2): got=[" + str(wx1) + "," + str(wy1) + "] want=[16,32]")
        exit(1)

    // tile (0,0) -> (0,0).
    let w0 = tm_tile_to_world(m, 0, 0)
    if w0[0] != 0 or w0[1] != 0
        print("FAIL tilemap tm_tile_to_world(0,0): got=[" + str(w0[0]) + "," + str(w0[1]) + "]")
        exit(1)

    // ── KAT 7: tm_solid_at_world ─────────────────────────────────────────────
    // Tile (1,1) is solid (value 5). World coords that fall in (1,1): e.g., (24,24).
    // tile = floor(24/16)=1, floor(24/16)=1 => solid.
    let sol_w = tm_solid_at_world(m, 24.0, 24.0)
    if sol_w != true
        print("FAIL tilemap tm_solid_at_world(24,24): got=" + str(sol_w) + " want=true")
        exit(1)

    // World (0,0) is tile (0,0) = 0 => not solid.
    let sol_w2 = tm_solid_at_world(m, 0.0, 0.0)
    if sol_w2 != false
        print("FAIL tilemap tm_solid_at_world(0,0): got=" + str(sol_w2) + " want=false")
        exit(1)

    // ── KAT 8: tm_tile_bounds ────────────────────────────────────────────────
    // tile (1,1) bounds = [1*16, 1*16, 16, 16] = [16, 16, 16, 16].
    let bounds11 = tm_tile_bounds(m, 1, 1)
    if bounds11[0] != 16 or bounds11[1] != 16 or bounds11[2] != 16 or bounds11[3] != 16
        print("FAIL tilemap tm_tile_bounds(1,1): got=[" + str(bounds11[0]) + "," + str(bounds11[1]) + "," + str(bounds11[2]) + "," + str(bounds11[3]) + "] want=[16,16,16,16]")
        exit(1)

    // tile (0,0) bounds = [0,0,16,16].
    let bounds00 = tm_tile_bounds(m, 0, 0)
    if bounds00[0] != 0 or bounds00[1] != 0 or bounds00[2] != 16 or bounds00[3] != 16
        print("FAIL tilemap tm_tile_bounds(0,0): got wrong bounds")
        exit(1)

    // ── KAT 9: tm_count ──────────────────────────────────────────────────────
    // Only one cell is 5 (set at (1,1)).
    let cnt5 = tm_count(m, 5)
    if cnt5 != 1
        print("FAIL tilemap tm_count(5): got=" + str(cnt5) + " want=1")
        exit(1)

    // Count of 0 = 15 (total 16 cells, one is 5).
    let cnt0 = tm_count(m, 0)
    if cnt0 != 15
        print("FAIL tilemap tm_count(0): got=" + str(cnt0) + " want=15")
        exit(1)

    // ── KAT 10: tm_neighbors4 ────────────────────────────────────────────────
    // Interior tile (1,1) in a 4x4 map has 4 neighbors: (0,1),(2,1),(1,0),(1,2).
    let nb11 = tm_neighbors4(m, 1, 1)
    let nb11_len = len(nb11)
    if nb11_len != 4
        print("FAIL tilemap tm_neighbors4(1,1): got=" + str(nb11_len) + " want=4")
        exit(1)

    // Corner (0,0) has 2 neighbors: (1,0),(0,1).
    let nb00 = tm_neighbors4(m, 0, 0)
    let nb00_len = len(nb00)
    if nb00_len != 2
        print("FAIL tilemap tm_neighbors4(0,0): got=" + str(nb00_len) + " want=2")
        exit(1)

    // Edge tile (0,1) has 3 neighbors.
    let nb01 = tm_neighbors4(m, 0, 1)
    let nb01_len = len(nb01)
    if nb01_len != 3
        print("FAIL tilemap tm_neighbors4(0,1): got=" + str(nb01_len) + " want=3")
        exit(1)

    // ── KAT 11: tm_fill_rect ─────────────────────────────────────────────────
    let m2 = tm_new(5, 5, 8, 0)
    tm_fill_rect(m2, 1, 1, 3, 2, 7)
    // Tiles (1,1),(2,1),(3,1),(1,2),(2,2),(3,2) should be 7.
    if tm_get(m2, 1, 1) != 7
        print("FAIL tilemap tm_fill_rect(1,1): got=" + str(tm_get(m2, 1, 1)) + " want=7")
        exit(1)
    if tm_get(m2, 3, 1) != 7
        print("FAIL tilemap tm_fill_rect(3,1): got=" + str(tm_get(m2, 3, 1)) + " want=7")
        exit(1)
    if tm_get(m2, 2, 2) != 7
        print("FAIL tilemap tm_fill_rect(2,2): got=" + str(tm_get(m2, 2, 2)) + " want=7")
        exit(1)
    // Tile outside the rect should still be 0.
    if tm_get(m2, 0, 0) != 0
        print("FAIL tilemap tm_fill_rect outside(0,0): got=" + str(tm_get(m2, 0, 0)) + " want=0")
        exit(1)

    let cnt7 = tm_count(m2, 7)
    if cnt7 != 6
        print("FAIL tilemap tm_fill_rect tm_count(7): got=" + str(cnt7) + " want=6")
        exit(1)

    // ── KAT 12: tm_get out-of-bounds returns 0 ──────────────────────────────
    let oob = tm_get(m, 10, 10)
    if oob != 0
        print("FAIL tilemap tm_get out-of-bounds: got=" + str(oob) + " want=0")
        exit(1)

    print("PASS _tilemap_test")
