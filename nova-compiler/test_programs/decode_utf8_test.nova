// Total charset decoding (secure by default):
//   decode_utf8(bytes)       -> Result<str, str>   ok(text) | err("invalid UTF-8 at byte N")
//   decode_utf8_lossy(bytes) -> str                valid through, bad bytes -> U+FFFD, never fails
// The typed, total replacement for bytes_to_str, which silently coerces malformed
// bytes into a garbage string. Built on the existing UTF-8 decoder + typed Result.

fn main()
    // ── valid round-trips ──
    let r1 = decode_utf8(str_to_bytes("hello"))
    assert_eq(is_ok(r1), 1)
    assert_eq(unwrap(r1), "hello")

    // empty bytes -> ok("")
    let r0 = decode_utf8(bytes(0))
    assert_eq(is_ok(r0), 1)
    assert_eq(unwrap(r0), "")

    // 2-byte sequence: "caf" + U+00E9 ('é')
    let cafe = "caf" + from_codepoint(233)
    let rc = decode_utf8(str_to_bytes(cafe))
    assert_eq(is_ok(rc), 1)
    assert_eq(unwrap(rc), cafe)
    assert_eq(char_count(unwrap(rc)), 4)

    // 4-byte sequence: U+1F600
    let emoji = from_codepoint(128512)
    let re = decode_utf8(str_to_bytes(emoji))
    assert_eq(is_ok(re), 1)
    assert_eq(unwrap(re), emoji)
    assert_eq(char_count(unwrap(re)), 1)

    // ── malformed -> Err (recoverable, not a crash, not silent garbage) ──
    let bad = bytes(2)
    bytes_set(bad, 0, 255)                 // 0xFF: invalid lead byte
    bytes_set(bad, 1, 65)                  // 'A'
    let rbad = decode_utf8(bad)
    assert_eq(is_ok(rbad), 0)
    assert_eq(is_err(rbad), 1)
    assert_eq(unwrap_or(rbad, "FALLBACK"), "FALLBACK")

    // truncated 2-byte sequence (lead with no continuation) -> Err
    let trunc = bytes(1)
    bytes_set(trunc, 0, 195)               // 0xC3
    assert_eq(is_err(decode_utf8(trunc)), 1)

    // stray continuation byte (no lead) -> Err
    let cont = bytes(1)
    bytes_set(cont, 0, 169)                // 0xA9
    assert_eq(is_err(decode_utf8(cont)), 1)

    // ── RFC-3629 strictness: structurally-decodable but ILLEGAL -> Err ──
    // overlong '/' (0xC0 0xAF encodes U+002F in 2 bytes) — the classic filter
    // bypass; a lenient decoder would hand back "/".
    let overlong = bytes(2)
    bytes_set(overlong, 0, 192)            // 0xC0
    bytes_set(overlong, 1, 175)            // 0xAF
    assert_eq(is_err(decode_utf8(overlong)), 1)

    // UTF-16 surrogate U+D800 (0xED 0xA0 0x80) — illegal in UTF-8
    let surrogate = bytes(3)
    bytes_set(surrogate, 0, 237)           // 0xED
    bytes_set(surrogate, 1, 160)           // 0xA0
    bytes_set(surrogate, 2, 128)           // 0x80
    assert_eq(is_err(decode_utf8(surrogate)), 1)

    // codepoint above U+10FFFF (0xF4 0x90 0x80 0x80 = U+110000)
    let toobig = bytes(4)
    bytes_set(toobig, 0, 244)              // 0xF4
    bytes_set(toobig, 1, 144)              // 0x90
    bytes_set(toobig, 2, 128)              // 0x80
    bytes_set(toobig, 3, 128)              // 0x80
    assert_eq(is_err(decode_utf8(toobig)), 1)

    // ── lossy: never fails, replaces each bad byte with U+FFFD ──
    let repl = from_codepoint(65533)       // U+FFFD
    assert_eq(decode_utf8_lossy(bad), repl + "A")
    assert_eq(char_count(decode_utf8_lossy(bad)), 2)

    // lossy on a decodable-but-illegal sequence: one U+FFFD for the whole 2-byte
    // overlong form (skips both bytes), exercising the strict-reject branch.
    assert_eq(decode_utf8_lossy(overlong), repl)
    assert_eq(char_count(decode_utf8_lossy(overlong)), 1)

    // lossy on valid input is identity
    assert_eq(decode_utf8_lossy(str_to_bytes(cafe)), cafe)
    assert_eq(decode_utf8_lossy(str_to_bytes("hello")), "hello")
    assert_eq(decode_utf8_lossy(bytes(0)), "")

    print("decode_utf8_test passed")
