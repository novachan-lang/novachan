// forge_flash_test -- flash messages (one-time POST-redirect-GET notifications). /set stashes a flash and
// the response carries a percent-encoded flash cookie; a follow-up /show carrying that cookie reads the
// DECODED message and mw_flash auto-expires the cookie (show-once). Over a real socket.
import forge

fn _set(req: Request) -> Response
    forge.flash(forge.resp_text(200, "set"), "Saved & ok!")

fn _show(req: Request) -> Response
    forge.resp_text(200, "MSG[" + forge.get_flash(req) + "]")

fn _server(port: int)
    let a = forge.app()
    forge.use(a, forge.mw_flash())
    forge.get(a, "/set", fn(req) _set(req))
    forge.get(a, "/show", fn(req) _show(req))
    forge.serve_req_n(a, port, 2)

fn _get(port: int, path: string, cookie: string) -> string
    let s = tcp_connect("127.0.0.1", port)
    let req = "GET " + path + " HTTP/1.0\r\nConnection: close\r\n"
    if cookie != ""
        req = req + "Cookie: " + cookie + "\r\n"
    req = req + "\r\n"
    tcp_send(s, req)
    let r = tcp_recv(s)
    let go = true
    while go
        let more = tcp_recv(s)
        if len(more) == 0
            go = false
        else
            r = r + more
    tcp_close(s)
    r

fn main()
    // (the percent-encoder is exercised end-to-end below: the encoded Set-Cookie + the decoded message)
    let port = 19424
    spawn fn()
        _server(port)
    sleep(300)

    // /set -> response sets a percent-encoded flash cookie
    let r1 = _get(port, "/set", "")
    assert(find(r1, "Set-Cookie: flash=Saved%20%26%20ok%21") >= 0, "flash cookie set, percent-encoded")
    print("PASS: flash() sets an encoded cookie")

    // /show carrying that cookie -> handler reads the DECODED message; mw_flash clears it (show-once)
    let r2 = _get(port, "/show", "flash=Saved%20%26%20ok%21")
    assert(find(r2, "MSG[Saved & ok!]") >= 0, "get_flash decoded the message")
    assert(find(r2, "flash=; ") >= 0 and find(r2, "Max-Age=0") >= 0, "mw_flash auto-cleared the flash (show-once)")
    print("PASS: get_flash decodes + mw_flash consumes once")
    print("forge_flash_test passed")
