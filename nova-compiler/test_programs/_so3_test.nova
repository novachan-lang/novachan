// KAT for std/control/so3 — SO(3) rotation matrix library.
import std/control/so3

fn _pi() -> float
    let r = 3.141592653589793
    r

fn _fabs(x: float) -> float
    let r = x
    if r < 0.0
        r = 0.0 - r
    r

fn approx(a: float, b: float) -> bool
    let d = _fabs(a - b)
    return d < 0.0001

fn ckf(label: string, got: float, want: float)
    if not approx(got, want)
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckv(label: string, got: any, want: any)
    if len(got) != len(want)
        print("FAIL " + label + ": len " + str(len(got)) + " != " + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        let gv = got[i] * 1.0
        let wv = want[i] * 1.0
        if not approx(gv, wv)
            print("FAIL " + label + "[" + str(i) + "]: got=" + str(gv) + " want=" + str(wv))
            exit(1)
        i = i + 1

fn main()
    // KAT 1: 90-deg Z rotation of X-axis -> Y-axis
    let pi = _pi()
    let Rz = so3_rot_z(pi * 0.5)
    let xaxis = []
    push(xaxis, 1.0)
    push(xaxis, 0.0)
    push(xaxis, 0.0)
    let yhat = so3_apply(Rz, xaxis)
    let want_y = []
    push(want_y, 0.0)
    push(want_y, 1.0)
    push(want_y, 0.0)
    ckv("rot_z_90_x_to_y", yhat, want_y)

    // KAT 2: R * R^T = identity for R = so3_rot_x(0.7)
    let Rx = so3_rot_x(0.7)
    let RxT = so3_transpose(Rx)
    let Icheck = so3_mul(Rx, RxT)
    let Iref = so3_identity()
    ckv("Rx_times_RxT_is_I", Icheck, Iref)

    // KAT 3: det of rot_y(1.0) ~ 1.0
    let Ry = so3_rot_y(1.0)
    let d = so3_det(Ry)
    ckf("det_rot_y_1", d, 1.0)

    // KAT 4: trace of identity == 3.0
    let I = so3_identity()
    let tr = so3_trace(I)
    ckf("trace_identity", tr, 3.0)

    // KAT 5: apply identity to [3,5,7] -> [3,5,7]
    let v357 = []
    push(v357, 3.0)
    push(v357, 5.0)
    push(v357, 7.0)
    let v357out = so3_apply(I, v357)
    ckv("apply_identity", v357out, v357)

    // KAT 6: so3_from_euler round-trip via so3_to_euler
    let roll_in = 0.3
    let pitch_in = 0.2
    let yaw_in = 0.5
    let Me = so3_from_euler(roll_in, pitch_in, yaw_in)
    let euler_out = so3_to_euler(Me)
    let e0 = euler_out[0] * 1.0
    let e1 = euler_out[1] * 1.0
    let e2 = euler_out[2] * 1.0
    ckf("euler_rt_roll", e0, roll_in)
    ckf("euler_rt_pitch", e1, pitch_in)
    ckf("euler_rt_yaw", e2, yaw_in)

    // KAT 7: so3_is_valid returns true for a valid rotation matrix
    let Ry2 = so3_rot_y(0.5)
    if not so3_is_valid(Ry2)
        print("FAIL is_valid_rot_y")
        exit(1)

    // KAT 8: so3_angle of 90-deg Z rotation ~ pi/2
    let half_pi = pi * 0.5
    let ang = so3_angle(Rz)
    ckf("angle_rot_z_90", ang, half_pi)

    // KAT 9: so3_angle of identity matrix ~ 0
    let ang_I = so3_angle(I)
    ckf("angle_identity", ang_I, 0.0)

    // KAT 10: from_axis_angle(0,0,1,pi/2) should give same as rot_z(pi/2)
    let Rzaa = so3_from_axis_angle(0.0, 0.0, 1.0, half_pi)
    ckv("from_axis_angle_vs_rot_z", Rzaa, Rz)

    print("PASS _so3_test")
