fn fizzbuzz(n)
    match n % 15
        0 => "FizzBuzz"
        _ => match n % 3
            0 => "Fizz"
            _ => match n % 5
                0 => "Buzz"
                _ => "{n}"

print(fizzbuzz(15))
print(fizzbuzz(9))
print(fizzbuzz(10))
print(fizzbuzz(7))

fn grade(score)
    match score
        100 => "perfect"
        _ => match score >= 90
            1 => "A"
            _ => match score >= 80
                1 => "B"
                _ => "C"

print(grade(100))
print(grade(95))
print(grade(85))
print(grade(70))
