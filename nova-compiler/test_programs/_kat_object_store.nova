import forge_object_store

fn main()
    let os = os_new()
    os = os_create_bucket(os, "images")
    os = os_create_bucket(os, "docs")
    assert(os_bucket_count(os) == 2, "2 buckets")

    os = os_put(os, "images", "logo.png", "PNG-DATA-HERE", "image/png")
    os = os_put(os, "images", "bg.jpg", "JPEG-DATA", "image/jpeg")
    os = os_put(os, "docs", "readme.md", "# Hello", "text/markdown")
    assert(os_object_count(os, "images") == 2, "2 in images")
    assert(os_object_count(os, "docs") == 1, "1 in docs")

    assert(os_get(os, "images", "logo.png") == "PNG-DATA-HERE", "get logo")
    assert(os_get(os, "images", "missing") == "", "missing = empty")
    assert(os_get(os, "nope", "logo.png") == "", "no bucket = empty")

    assert(os_exists(os, "images", "logo.png") == 1, "exists")
    assert(os_exists(os, "images", "missing") == 0, "not exists")

    os = os_delete(os, "images", "bg.jpg")
    assert(os_object_count(os, "images") == 1, "1 after delete")
    assert(os_exists(os, "images", "bg.jpg") == 0, "deleted gone")

    let k = os_list_keys(os, "images")
    assert(len(k) == 1, "1 key listed")

    assert(os_object_count(os, "nonexistent") == 0, "no bucket = 0")

    print("OBJECT-STORE KAT PASS")
