// HTTP server test — start server, make a request, verify response

fn run_http_server(port)
    server = http_listen(port)
    req = http_accept(server)
    // req is [client_socket, method, path, body]
    client = req[0]
    method = req[1]
    path = req[2]
    http_respond(client, 200, "method=" + method + " path=" + path)
    tcp_close(server)

port = 19877

spawn fn()
    run_http_server(port)

sleep(100)

// Use tcp_connect to make a raw HTTP request
sock = tcp_connect("127.0.0.1", port)
tcp_send(sock, "GET /hello HTTP/1.1\r\nHost: localhost\r\n\r\n")
sleep(50)
response = tcp_recv(sock)
// Get body if not in first chunk
response2 = tcp_recv(sock)
response = response + response2
tcp_close(sock)

// Verify response contains our expected body
assert(response matches "200 OK", "status 200")
assert(response matches "method=GET", "method parsed")
assert(response matches "path=/hello", "path parsed")

print("HTTP: ALL PASSED")
