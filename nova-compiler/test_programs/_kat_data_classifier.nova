import forge_data_classifier

fn main()
    let s = dc_new()
    s = dc_add_class(s, "public", 1)
    s = dc_add_class(s, "internal", 2)
    s = dc_add_class(s, "confidential", 3)
    s = dc_add_class(s, "restricted", 4)
    assert(dc_class_count(s) == 4, "4 classes registered")

    let r1 = dc_classify(s, "doc1", "public")
    assert(is_ok(r1), "classify doc1 ok")

    let r2 = dc_classify(s, "doc2", "confidential")
    assert(is_ok(r2), "classify doc2 ok")

    let r3 = dc_classify(s, "doc3", "restricted")
    assert(is_ok(r3), "classify doc3 ok")

    let r4 = dc_classify(s, "doc4", "internal")
    assert(is_ok(r4), "classify doc4 ok")

    let r_bad = dc_classify(s, "doc5", "top_secret")
    assert(is_err(r_bad), "unknown class rejected")

    assert(dc_data_count(s) == 4, "4 items classified")

    let gc = dc_get_class(s, "doc2")
    assert(is_ok(gc), "get_class ok")
    assert(unwrap(gc) == "confidential", "doc2 is confidential")

    let gl = dc_get_level(s, "doc2")
    assert(is_ok(gl), "get_level ok")
    assert(unwrap(gl) == 3, "doc2 level is 3")

    let gc_missing = dc_get_class(s, "unknown_doc")
    assert(is_err(gc_missing), "unclassified id errs")

    assert(dc_count_at_level(s, 1) == 1, "1 at public")
    assert(dc_count_at_level(s, 2) == 1, "1 at internal")
    assert(dc_count_at_level(s, 3) == 1, "1 at confidential")
    assert(dc_count_at_level(s, 4) == 1, "1 at restricted")

    // reclassify doc1 as restricted — level 1 bucket should empty, level 4 grows
    let r5 = dc_classify(s, "doc1", "restricted")
    assert(is_ok(r5), "reclassify doc1 ok")
    assert(dc_count_at_level(s, 1) == 0, "0 at public after reclassify")
    assert(dc_count_at_level(s, 4) == 2, "2 at restricted after reclassify")
    assert(dc_data_count(s) == 4, "still 4 items (no dup)")

    let ir1 = dc_is_restricted(s, "doc2")
    assert(is_ok(ir1), "is_restricted doc2 ok")
    assert(unwrap(ir1) == 1, "doc2 restricted (confidential>=3)")

    let ir2 = dc_is_restricted(s, "doc4")
    assert(unwrap(ir2) == 0, "doc4 not restricted (internal=2)")

    let ir3 = dc_is_restricted(s, "never_seen")
    assert(is_err(ir3), "unknown doc errors on is_restricted")

    print("DATA-CLASSIFIER KAT PASS")
