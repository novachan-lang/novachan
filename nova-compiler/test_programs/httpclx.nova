fn http_get_raw(host, port, path)
  let conn = tcp_connect(host, port)
  if conn == 0
    return err("connection failed")
  let request = "GET " + path + " HTTP/1.1\r\nHost: " + host + "\r\nConnection: close\r\n\r\n"
  tcp_send(conn, request)
  let response = ""
  let chunk = tcp_recv(conn)
  while len(chunk) > 0
    response = response + chunk
    chunk = tcp_recv(conn)
  tcp_close(conn)
  ok(response)

fn http_parse_response(raw)
  let result = {}
  let header_end = -1
  let i = 0
  while i < len(raw) - 3
    if slice(raw, i, i + 4) == "\r\n\r\n"
      header_end = i
      i = len(raw)
    i = i + 1
  if header_end < 0
    result["status"] = 0
    result["headers"] = ""
    result["body"] = raw
    return result
  let header_part = slice(raw, 0, header_end)
  let body_part = slice(raw, header_end + 4, len(raw))
  let status_line = header_part
  let si = 0
  while si < len(header_part) - 1
    if slice(header_part, si, si + 2) == "\r\n"
      status_line = slice(header_part, 0, si)
      si = len(header_part)
    si = si + 1
  let status_code = 0
  if len(status_line) > 12
    let sc_str = slice(status_line, 9, 12)
    let sc_r = parse_int_safe(sc_str)
    if is_ok(sc_r)
      status_code = unwrap(sc_r)
  result["status"] = status_code
  result["headers"] = header_part
  result["body"] = body_part
  result

fn http_get_header(header_text, name)
  let search = lower(name) + ":"
  let lines = split(header_text, "\r\n")
  for line in lines
    if starts_with(lower(line), search)
      return trim(slice(line, len(search), len(line)))
  ""

fn main()
  let parsed = http_parse_response("HTTP/1.1 200 OK\r\nContent-Type: text/html\r\nServer: nova\r\n\r\n<h1>Hello</h1>")
  assert(parsed["status"] == 200, "status 200")
  assert(parsed["body"] == "<h1>Hello</h1>", "body extracted")
  assert(contains(parsed["headers"], "Content-Type"), "headers present")

  let ct = http_get_header(parsed["headers"], "Content-Type")
  assert(ct == "text/html", "content type header")

  let sv = http_get_header(parsed["headers"], "Server")
  assert(sv == "nova", "server header")

  let missing = http_get_header(parsed["headers"], "X-Missing")
  assert(missing == "", "missing header empty")

  let p404 = http_parse_response("HTTP/1.1 404 Not Found\r\n\r\nNot Found")
  assert(p404["status"] == 404, "404 status")
  assert(p404["body"] == "Not Found", "404 body")

  print("httpclx: all passed")
