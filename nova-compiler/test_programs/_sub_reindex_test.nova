// KAT for std/data/sub_reindex
// Tests sub_reindex, sub_sort, sub_renumber_from, sub_validate
import std/data/sub_reindex

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got [" + got + "] expected [" + expected + "]")
        exit(1)

fn _make_cue(idx, start_ms, end_ms, txt)
    let c = {}
    c["index"] = idx
    c["start"] = start_ms
    c["end"] = end_ms
    c["text"] = txt
    return c

fn main()
    // Cues with out-of-order indices [5,9,2] and different start times
    let c0 = _make_cue(5, 1000, 4000, "First")
    let c1 = _make_cue(9, 5000, 8000, "Second")
    let c2 = _make_cue(2, 9000, 12000, "Third")
    let cues = []
    push(cues, c0)
    push(cues, c1)
    push(cues, c2)

    // ── sub_reindex ──────────────────────────────────────────────────────────
    // KAT 1: reindex assigns 1,2,3 in order
    let ri = sub_reindex(cues)
    cki("reindex_len", len(ri), 3)
    cki("reindex_0_idx", ri[0]["index"], 1)
    cki("reindex_1_idx", ri[1]["index"], 2)
    cki("reindex_2_idx", ri[2]["index"], 3)

    // KAT 2: reindex preserves start times
    cki("reindex_0_start", ri[0]["start"], 1000)
    cki("reindex_1_start", ri[1]["start"], 5000)
    cki("reindex_2_start", ri[2]["start"], 9000)

    // KAT 3: original cues not mutated
    cki("original_0_idx_unmutated", cues[0]["index"], 5)
    cki("original_1_idx_unmutated", cues[1]["index"], 9)
    cki("original_2_idx_unmutated", cues[2]["index"], 2)

    // KAT 4: empty list reindexes to empty
    let empty = []
    let re_empty = sub_reindex(empty)
    cki("reindex_empty_len", len(re_empty), 0)

    // ── sub_sort ─────────────────────────────────────────────────────────────
    // Build cues with shuffled start times: 9000, 1000, 5000
    let s0 = _make_cue(1, 9000, 12000, "C")
    let s1 = _make_cue(2, 1000, 4000, "A")
    let s2 = _make_cue(3, 5000, 8000, "B")
    let shuffled = []
    push(shuffled, s0)
    push(shuffled, s1)
    push(shuffled, s2)

    let sorted = sub_sort(shuffled)

    // KAT 5: sort produces 3 cues
    cki("sort_len", len(sorted), 3)

    // KAT 6: first cue by start is 1000
    cki("sort_0_start", sorted[0]["start"], 1000)

    // KAT 7: second cue by start is 5000
    cki("sort_1_start", sorted[1]["start"], 5000)

    // KAT 8: third cue by start is 9000
    cki("sort_2_start", sorted[2]["start"], 9000)

    // KAT 9: text preserved after sort
    cks("sort_0_text", sorted[0]["text"], "A")
    cks("sort_1_text", sorted[1]["text"], "B")
    cks("sort_2_text", sorted[2]["text"], "C")

    // KAT 10: original order unchanged
    cki("sort_original_0_start", shuffled[0]["start"], 9000)

    // ── sub_renumber_from ────────────────────────────────────────────────────
    // KAT 11: renumber_from(cues, 10) -> indices [10,11,12]
    let rn = sub_renumber_from(cues, 10)
    cki("renumber_0_idx", rn[0]["index"], 10)
    cki("renumber_1_idx", rn[1]["index"], 11)
    cki("renumber_2_idx", rn[2]["index"], 12)

    // KAT 12: start times preserved after renumber
    cki("renumber_0_start", rn[0]["start"], 1000)
    cki("renumber_2_start", rn[2]["start"], 9000)

    // KAT 13: renumber from 1 is like reindex
    let rn1 = sub_renumber_from(cues, 1)
    cki("renumber_from1_0_idx", rn1[0]["index"], 1)
    cki("renumber_from1_2_idx", rn1[2]["index"], 3)

    // ── sub_validate ─────────────────────────────────────────────────────────
    // KAT 14: well-formed cues are valid
    let v0 = _make_cue(1, 1000, 4000, "First")
    let v1 = _make_cue(2, 5000, 8000, "Second")
    let v2 = _make_cue(3, 9000, 12000, "Third")
    let valid_cues = []
    push(valid_cues, v0)
    push(valid_cues, v1)
    push(valid_cues, v2)
    cki("validate_good", sub_validate(valid_cues), 1)

    // KAT 15: cue with start >= end is invalid
    let bad_dur = []
    let bd = _make_cue(1, 5000, 3000, "Bad")
    push(bad_dur, bd)
    cki("validate_bad_duration", sub_validate(bad_dur), 0)

    // KAT 16: non-sequential index is invalid (first index != 1)
    let bad_idx = []
    let bi = _make_cue(2, 1000, 4000, "Bad idx")
    push(bad_idx, bi)
    cki("validate_bad_index", sub_validate(bad_idx), 0)

    // KAT 17: overlapping cues are invalid
    let bad_overlap = []
    let bo0 = _make_cue(1, 1000, 5000, "Overlap A")
    let bo1 = _make_cue(2, 3000, 8000, "Overlap B")
    push(bad_overlap, bo0)
    push(bad_overlap, bo1)
    cki("validate_overlap", sub_validate(bad_overlap), 0)

    // KAT 18: empty list is valid
    let empty2 = []
    cki("validate_empty", sub_validate(empty2), 1)

    // KAT 19: single cue is valid
    let single = []
    let sc = _make_cue(1, 0, 1000, "Only")
    push(single, sc)
    cki("validate_single", sub_validate(single), 1)

    // KAT 20: adjacent cues (touching) are valid — cues[i].start == cues[i-1].end
    let adjacent = []
    let ad0 = _make_cue(1, 0, 1000, "A")
    let ad1 = _make_cue(2, 1000, 2000, "B")
    push(adjacent, ad0)
    push(adjacent, ad1)
    cki("validate_adjacent", sub_validate(adjacent), 1)

    print("PASS _sub_reindex_test")

main()
