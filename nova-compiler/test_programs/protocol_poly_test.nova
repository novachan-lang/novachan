// Test polymorphic method dispatch across types
// When multiple types implement the same method name

type Circle
    radius: float

type Rect
    w: float
    h: float

fn Circle__area(c: Circle) -> float
    return 3.14159 * c.radius * c.radius

fn Rect__area(r: Rect) -> float
    return r.w * r.h

fn Circle__describe(c: Circle) -> string
    return "circle"

fn Rect__describe(r: Rect) -> string
    return "rect"

fn main()
    let c = Circle(5.0)
    let r = Rect(3.0, 4.0)

    // Static dispatch (type known)
    assert(c.describe() == "circle", "circle.describe")
    assert(r.describe() == "rect", "rect.describe")

    // Dynamic dispatch (type erased via any)
    let shapes = [c, r]
    let descs = []
    for s in shapes
        push(descs, s.describe())
    assert(descs[0] == "circle", "dyn circle")
    assert(descs[1] == "rect", "dyn rect")

    print("protocol_poly: all passed")
