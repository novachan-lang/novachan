// _heapmedian_test.nova — KAT for std/collections/heapmedian
import std/collections/heapmedian

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn ckf(label, got, expected, eps)
    let diff = got - expected
    let adiff = diff
    if diff < 0.0
        adiff = 0.0 - diff
    if adiff > eps
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn main()
    // KAT 1: single element -> median == that element
    let h = heapmedian.hmd_new()
    heapmedian.hmd_add(h, 1)
    let m1 = heapmedian.hmd_median(h)
    ckf("single 1 median", m1, 1.0, 0.001)

    // KAT 2: two elements [1,2] -> median == 1.5
    heapmedian.hmd_add(h, 2)
    let m2 = heapmedian.hmd_median(h)
    ckf("two [1,2] median", m2, 1.5, 0.001)

    // KAT 3: three elements [1,2,3] -> median == 2.0
    heapmedian.hmd_add(h, 3)
    let m3 = heapmedian.hmd_median(h)
    ckf("three [1,2,3] median", m3, 2.0, 0.001)

    // KAT 4: four elements [1,2,3,4] -> median == 2.5
    heapmedian.hmd_add(h, 4)
    let m4 = heapmedian.hmd_median(h)
    ckf("four [1,2,3,4] median", m4, 2.5, 0.001)

    // KAT 5: count == 4
    let cnt = heapmedian.hmd_count(h)
    cki("count after 4 adds", cnt, 4)

    // KAT 6: second heap g = [5,15,1,3] -> sorted [1,3,5,15] -> median == (3+5)/2 == 4.0
    let g = heapmedian.hmd_new()
    heapmedian.hmd_add(g, 5)
    heapmedian.hmd_add(g, 15)
    heapmedian.hmd_add(g, 1)
    heapmedian.hmd_add(g, 3)
    let mg = heapmedian.hmd_median(g)
    ckf("g=[5,15,1,3] median", mg, 4.0, 0.001)

    // KAT 7: duplicate values [5,5,5] -> median == 5.0
    let d = heapmedian.hmd_new()
    heapmedian.hmd_add(d, 5)
    heapmedian.hmd_add(d, 5)
    heapmedian.hmd_add(d, 5)
    let md = heapmedian.hmd_median(d)
    ckf("duplicates [5,5,5] median", md, 5.0, 0.001)

    // KAT 8: descending insert [10,8,6,4,2] sorted=[2,4,6,8,10] -> median==6.0
    let e = heapmedian.hmd_new()
    heapmedian.hmd_add(e, 10)
    heapmedian.hmd_add(e, 8)
    heapmedian.hmd_add(e, 6)
    heapmedian.hmd_add(e, 4)
    heapmedian.hmd_add(e, 2)
    let me = heapmedian.hmd_median(e)
    ckf("descending [10,8,6,4,2] median", me, 6.0, 0.001)
    cki("descending count==5", heapmedian.hmd_count(e), 5)

    print("_heapmedian_test passed")
