import forge_leb128

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn join_ints(lst) -> string
    let parts = []
    let i = 0
    while i < len(lst)
        push(parts, str(lst[i]))
        i = i + 1
    join(parts, ",")

fn main()
    let fails = 0

    // UNSIGNED known vectors
    fails = fails + expect("u0", join_ints(uleb128_encode(0)), "0")
    fails = fails + expect("u127", join_ints(uleb128_encode(127)), "127")
    fails = fails + expect("u128", join_ints(uleb128_encode(128)), "128,1")
    fails = fails + expect("u300", join_ints(uleb128_encode(300)), "172,2")
    fails = fails + expect("u624485", join_ints(uleb128_encode(624485)), "229,142,38")

    // SIGNED known vectors
    fails = fails + expect("s2", join_ints(sleb128_encode(2)), "2")
    fails = fails + expect("s_neg2", join_ints(sleb128_encode(-2)), "126")
    fails = fails + expect("s127", join_ints(sleb128_encode(127)), "255,0")
    fails = fails + expect("s_neg128", join_ints(sleb128_encode(-128)), "128,127")
    fails = fails + expect("s0", join_ints(sleb128_encode(0)), "0")

    // UNSIGNED decode
    let d1 = uleb128_decode([229, 142, 38], 0)
    fails = fails + expect("udec_val", str(d1[0]), "624485")
    fails = fails + expect("udec_off", str(d1[1]), "3")

    // SIGNED decode
    let d2 = sleb128_decode([126], 0)
    fails = fails + expect("sdec_neg2", str(d2[0]), "-2")
    let d3 = sleb128_decode([128, 127], 0)
    fails = fails + expect("sdec_neg128", str(d3[0]), "-128")

    // ROUNDTRIP unsigned
    let uvals = [0, 1, 127, 128, 255, 16384, 624485, 2000000000]
    let up = 0
    while up < len(uvals)
        let enc = uleb128_encode(uvals[up])
        let dec = uleb128_decode(enc, 0)
        fails = fails + expect_true("uroundtrip_" + str(up), dec[0] == uvals[up])
        up = up + 1

    // ROUNDTRIP signed (positive + negative)
    let svals = [0, 1, -1, 63, 64, -64, -65, 127, -128, 1000000, -1000000, 2000000000, 0 - 2000000000]
    let sp = 0
    while sp < len(svals)
        let enc = sleb128_encode(svals[sp])
        let dec = sleb128_decode(enc, 0)
        fails = fails + expect_true("sroundtrip_" + str(sp), dec[0] == svals[sp])
        sp = sp + 1

    // sequential decode (two values back to back)
    let seq = uleb128_encode(300)
    push(seq, uleb128_encode(128)[0])
    push(seq, uleb128_encode(128)[1])
    let first = uleb128_decode(seq, 0)
    let second = uleb128_decode(seq, first[1])
    fails = fails + expect("seq1", str(first[0]), "300")
    fails = fails + expect("seq2", str(second[0]), "128")

    if fails == 0
        print("forge_leb128: all passed")
    else
        print("forge_leb128: " + str(fails) + " FAILED")
