// Phase 7.5: Default trait methods test
// Tests that traits can provide default method implementations
// and implementing types can override or inherit them.

trait Describable
    fn name() -> string
    fn describe() -> string
        "I am " + self.name()
    fn tag() -> string
        "object"

type Dog: Describable
    breed: string

fn Dog.name() -> string
    "Dog(" + self.breed + ")"

type Cat: Describable
    color: string

fn Cat.name() -> string
    "Cat(" + self.color + ")"

fn Cat.tag() -> string
    "feline"

// Dog: inherits describe() and tag() defaults
let d = Dog("Labrador")
assert(d.name() == "Dog(Labrador)", "dog name")
assert(d.describe() == "I am Dog(Labrador)", "dog describe default")
assert(d.tag() == "object", "dog tag default")

// Cat: inherits describe() default, overrides tag()
let c = Cat("orange")
assert(c.name() == "Cat(orange)", "cat name")
assert(c.describe() == "I am Cat(orange)", "cat describe default")
assert(c.tag() == "feline", "cat tag override")

// Test with a numeric trait
trait HasMagnitude
    fn value() -> float
    fn magnitude() -> float
        let v = self.value()
        if v < 0.0
            return 0.0 - v
        v
    fn is_positive() -> bool
        self.value() > 0.0

type Temperature: HasMagnitude
    degrees: float

fn Temperature.value() -> float
    self.degrees

let hot = Temperature(37.5)
let cold = Temperature(-10.0)

assert(hot.value() == 37.5, "temp value")
assert(hot.is_positive(), "temp positive")

let cold_mag = cold.magnitude()
assert(cold_mag == 10.0, "temp magnitude abs")

print("PHASE 7.5 DEFAULT TRAIT METHODS TEST PASSED")
