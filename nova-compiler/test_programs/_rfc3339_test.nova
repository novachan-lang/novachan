import std/time/rfc3339

// Helper assertions
fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + got + " want " + want)
        exit(1)

// ── KAT 1: basic UTC parse ───────────────────────────────────────────────────
let d1 = rf_parse("2026-07-13T15:30:00Z")
cki("d1.year",   d1["year"],   2026)
cki("d1.month",  d1["month"],  7)
cki("d1.day",    d1["day"],    13)
cki("d1.hour",   d1["hour"],   15)
cki("d1.minute", d1["minute"], 30)
cki("d1.second", d1["second"], 0)
cki("d1.tzoff",  d1["tzoff"],  0)

// ── KAT 2: positive timezone offset (+05:30 = 330 minutes) ──────────────────
let d2 = rf_parse("2026-07-13T15:30:00+05:30")
cki("d2.tzoff", d2["tzoff"], 330)

// ── KAT 3: negative timezone offset (-08:00 = -480 minutes) ─────────────────
let d3 = rf_parse("2026-07-13T15:30:00-08:00")
cki("d3.tzoff", d3["tzoff"], -480)

// ── KAT 4: epoch 0 round-trip (1970-01-01T00:00:00Z) ────────────────────────
let d_epoch0 = rf_parse("1970-01-01T00:00:00Z")
let e0 = rf_to_epoch(d_epoch0)
cki("epoch0", e0, 0)

// ── KAT 5: known epoch — 2000-01-01T00:00:00Z = 946684800 ───────────────────
let d_y2k = rf_parse("2000-01-01T00:00:00Z")
let e_y2k = rf_to_epoch(d_y2k)
cki("y2k_epoch", e_y2k, 946684800)

// ── KAT 6: rf_from_epoch round-trip → rf_format ─────────────────────────────
let d_back = rf_from_epoch(946684800)
cki("y2k_back.year",  d_back["year"],  2000)
cki("y2k_back.month", d_back["month"], 1)
cki("y2k_back.day",   d_back["day"],   1)
let formatted = rf_format(d_back)
cks("y2k_format", formatted, "2000-01-01T00:00:00Z")

// ── KAT 7: rf_to_epoch accounts for tzoff ────────────────────────────────────
// "1970-01-01T05:30:00+05:30" == epoch 0 (local time 5:30 AM IST = UTC 00:00)
let d_ist = rf_parse("1970-01-01T05:30:00+05:30")
let e_ist = rf_to_epoch(d_ist)
cki("epoch_ist_to_utc", e_ist, 0)

// ── KAT 8: rf_format normalises non-UTC to UTC form ──────────────────────────
// "2000-01-01T08:00:00+08:00" is UTC 2000-01-01T00:00:00Z
let d_cst = rf_parse("2000-01-01T08:00:00+08:00")
let f_cst = rf_format(d_cst)
cks("cst_to_utc_format", f_cst, "2000-01-01T00:00:00Z")

// ── KAT 9: leap year day (2000-02-29 exists in a leap year) ──────────────────
let d_leap = rf_parse("2000-02-29T12:00:00Z")
cki("leap.day",   d_leap["day"],   29)
cki("leap.month", d_leap["month"], 2)
cki("leap.year",  d_leap["year"],  2000)

// ── KAT 10: rf_from_epoch for a time mid-day ─────────────────────────────────
// 2000-01-01T12:34:56Z = 946684800 + 12*3600 + 34*60 + 56 = 946729496? let me compute:
// 946684800 + 43200 + 2040 + 56 = 946684800 + 45296 = 946730096
let d_mid = rf_from_epoch(946730096)
cki("mid.hour",   d_mid["hour"],   12)
cki("mid.minute", d_mid["minute"], 34)
cki("mid.second", d_mid["second"], 56)
cki("mid.year",   d_mid["year"],   2000)
cki("mid.month",  d_mid["month"],  1)
cki("mid.day",    d_mid["day"],    1)

print("_rfc3339_test passed")
