import std/scheduling/sched_hrrn

fn cki(got, want, label)
    if got != want
        print("FAIL sched_hrrn " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(got, want, label)
    if len(got) != len(want)
        print("FAIL sched_hrrn " + label + ": got len=" + str(len(got)) + " want len=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL sched_hrrn " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // KAT 1: hr_completion_times([[0,5],[3,3],[4,2]]) = [5,8,10]
    let p1 = []
    let p1a = []
    push(p1a, 0)
    push(p1a, 5)
    push(p1, p1a)
    let p1b = []
    push(p1b, 3)
    push(p1b, 3)
    push(p1, p1b)
    let p1c = []
    push(p1c, 4)
    push(p1c, 2)
    push(p1, p1c)

    let ct1 = hr_completion_times(p1)
    let want_ct1 = []
    push(want_ct1, 5)
    push(want_ct1, 8)
    push(want_ct1, 10)
    ckl(ct1, want_ct1, "completion_times_basic")

    // KAT 2: hr_order([[0,5],[3,3],[4,2]]) = [0,1,2]
    let ord1 = hr_order(p1)
    let want_ord1 = []
    push(want_ord1, 0)
    push(want_ord1, 1)
    push(want_ord1, 2)
    ckl(ord1, want_ord1, "order_basic")

    // KAT 3: hr_waiting_times([[0,5],[3,3],[4,2]]) = [0,2,4]
    let wt1 = hr_waiting_times(p1)
    let want_wt1 = []
    push(want_wt1, 0)
    push(want_wt1, 2)
    push(want_wt1, 4)
    ckl(wt1, want_wt1, "waiting_times_basic")

    // KAT 4: empty input
    let ct_empty = hr_completion_times([])
    cki(len(ct_empty), 0, "empty_completion")
    let ord_empty = hr_order([])
    cki(len(ord_empty), 0, "empty_order")
    let wt_empty = hr_waiting_times([])
    cki(len(wt_empty), 0, "empty_waiting")

    // KAT 5: single process [0, 7] => completes at 7, wait=0
    let p5 = []
    let p5a = []
    push(p5a, 0)
    push(p5a, 7)
    push(p5, p5a)
    let ct5 = hr_completion_times(p5)
    cki(ct5[0], 7, "single_completion")
    let wt5 = hr_waiting_times(p5)
    cki(wt5[0], 0, "single_wait")

    // KAT 6: idle gap — P0 arrives at 5, P1 arrives at 10
    // CPU idles until 5, runs P0 (burst 3) → done at 8
    // then P1 arrived at 10, CPU idles 8..10, runs P1 (burst 2) → done at 12
    let p6 = []
    let p6a = []
    push(p6a, 5)
    push(p6a, 3)
    push(p6, p6a)
    let p6b = []
    push(p6b, 10)
    push(p6b, 2)
    push(p6, p6b)
    let ct6 = hr_completion_times(p6)
    cki(ct6[0], 8, "idle_gap_p0_ct")
    cki(ct6[1], 12, "idle_gap_p1_ct")
    let wt6 = hr_waiting_times(p6)
    cki(wt6[0], 0, "idle_gap_p0_wt")
    cki(wt6[1], 0, "idle_gap_p1_wt")

    // KAT 7: HRRN tie-break by PID
    // P0=[0,4], P1=[0,4]: both arrive at 0, equal ratio => PID 0 wins
    let p7 = []
    let p7a = []
    push(p7a, 0)
    push(p7a, 4)
    push(p7, p7a)
    let p7b = []
    push(p7b, 0)
    push(p7b, 4)
    push(p7, p7b)
    let ord7 = hr_order(p7)
    cki(ord7[0], 0, "tiebreak_first")
    cki(ord7[1], 1, "tiebreak_second")

    print("PASS _sched_hrrn_test")
