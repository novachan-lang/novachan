// Distinct newtypes: `type X = distinct T` mints a type that is NOT interchangeable
// with T (UserId != int), preventing whole classes of mix-up bugs. Desugars to a
// single-field struct, so it gets construction `UserId(x)`, `.value` extraction,
// structural ==, and structural print — all for free. (Transparent `type X = T`
// aliases stay interchangeable; only `distinct` mints a fresh type.)

type UserId = distinct int
type Celsius = distinct float
type Name = distinct string

fn id_num(u: UserId) -> int
    return u.value

fn main()
    // construction + extraction
    let u = UserId(42)
    assert_eq(u.value, 42)

    // structural equality between two of the same newtype
    assert_eq(u == UserId(42), true)
    assert_eq(u == UserId(7), false)

    // the underlying value is usable via .value
    assert_eq(u.value + 1, 43)

    // flows through a function typed with the newtype
    assert_eq(id_num(UserId(99)), 99)

    // distinct newtype over float
    let c = Celsius(36.6)
    assert_near(c.value, 36.6, 0.001)

    // distinct newtype over string
    let n = Name("nova")
    assert_eq(n.value, "nova")

    print("newtype_test passed")
