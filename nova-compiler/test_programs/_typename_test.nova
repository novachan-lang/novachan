// KAT test for std/util/typename
import std/util/typename

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got [" + got + "] want [" + want + "]")
        exit(1)

fn ckb(label, got, want)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got " + gs + " want " + ws)
        exit(1)

// KAT 1: tn_kind on list
let lst = [1, 2]
cks("tn_kind_list", tn_kind(lst), "list")

// KAT 2: tn_kind on dict
let d = {}
cks("tn_kind_dict", tn_kind(d), "dict")

// KAT 3: tn_is_container on list
let lst2 = [1]
ckb("tn_is_container_list", tn_is_container(lst2), true)

// KAT 4: tn_is_container on int
ckb("tn_is_container_int", tn_is_container(5), false)

// KAT 5: tn_is_scalar on int
ckb("tn_is_scalar_int", tn_is_scalar(5), true)

// KAT 6: tn_is_scalar on list
let lst3 = [1]
ckb("tn_is_scalar_list", tn_is_scalar(lst3), false)

// KAT 7: tn_describe on 3-element list
let lst4 = [1, 2, 3]
cks("tn_describe_list3", tn_describe(lst4), "list[3]")

// KAT 8: tn_describe on dict with 2 keys
let d2 = {}
d2["a"] = 1
d2["b"] = 2
let expected_dict = "dict" + chr(123) + "2" + chr(125)
cks("tn_describe_dict2", tn_describe(d2), expected_dict)

// KAT 9: tn_describe on int returns kind string
cks("tn_describe_int", tn_describe(42), "int")

// KAT 10: tn_is_scalar on string and float
ckb("tn_is_scalar_string", tn_is_scalar("hello"), true)
ckb("tn_is_scalar_float", tn_is_scalar(3.14), true)

print("_typename_test passed")
