// forge_h2_server_test -- HTTP/2 serve mapping (D2.5 core): HEADERS -> Request and Response -> HEADERS+DATA
// frames, round-tripped through HPACK + the frame codec. Imports ONLY forge_h2_server (single path, no
// diamond). Deterministic (socket-free): the socket serve loop is thin glue over this mapping.
import forge
import forge_h2_server

fn main()
    // ── HTTP/2 HEADERS -> Forge Request (routes through the existing parser) ──────────────────────────
    let hdrs = []
    push(hdrs, [":method", "POST"])
    push(hdrs, [":scheme", "https"])
    push(hdrs, [":path", "/api/items?q=1"])
    push(hdrs, [":authority", "example.com"])
    push(hdrs, ["content-type", "application/json"])
    let req = forge_h2_server.h2_request_from_headers(hdrs)
    assert(req.method == "POST", "h2 :method -> req.method (" + req.method + ")")
    assert(req.path == "/api/items", "h2 :path -> req.path (query stripped) (" + req.path + ")")
    assert(forge.req_query(req, "q") == "1", "h2 :path query -> req.query")
    assert(forge.req_header(req, "content-type") == "application/json", "h2 header -> req header")
    assert(forge.req_header(req, "host") == "example.com", "h2 :authority -> Host header")
    print("PASS: h2 HEADERS -> Request (method/path/query/headers/authority)")

    // ── Forge Response -> HEADERS+DATA frames -> decode back ──────────────────────────────────────────
    let resp = forge.resp_json(201, "created")   // status 201, JSON content-type, body a JSON string
    let frames = forge_h2_server.h2_response_frames(resp, 1)
    let dr = forge_h2_server.h2_decode_response(frames)
    assert(dr[0] == 201, "response :status round-trips (got " + str(dr[0]) + ")")
    assert(dr[1] == forge.body_of(resp), "response DATA body round-trips [" + dr[1] + "]")
    print("PASS: h2 Response -> HEADERS+DATA frames -> decode ([status, body] round-trip)")

    print("forge_h2_server_test passed")
