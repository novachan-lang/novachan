// _protein_test.nova — KAT for std/bio/protein
//
// Known-answer vectors:
//   peptide_mw("A") = 71.0788 + 18.01524 = 89.09404  (single residue + water)
//   aa_mw("G")      = 57.0519
//   aa_is_hydrophobic("A") = true
//   aa_is_hydrophobic("D") = false
//   aa_is_charged("K") = true
//   net_charge("DEKR") = -1 + -1 + 1 + 1 = 0
//   aromaticity("FWYA") = 3/4 = 0.75
//   aa_composition("AAG")["A"] = 2
//   count_positive("KRDE") = 2

import std/bio/protein

fn approx(label, a, b, tol)
    let d = a - b
    let ad = d
    if d < 0.0
        ad = 0.0 - d
    if ad > tol
        print("FAIL " + label + ": got=" + str(a) + " want~" + str(b) + " tol=" + str(tol))
        exit(1)
    return 0

fn ck_int(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)
    return 0

fn ck_bool(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)
    return 0

fn main()
    // KAT 1: peptide_mw("A") = residue mass A + water
    let mw_a = peptide_mw("A")
    approx("peptide_mw_A", mw_a, 89.09404, 0.1)

    // KAT 2: aa_mw("G") ~ 57.0519
    let mw_g = aa_mw("G")
    approx("aa_mw_G", mw_g, 57.0519, 0.001)

    // KAT 3: aa_is_hydrophobic("A") == true
    let hyd_a = aa_is_hydrophobic("A")
    ck_bool("hydrophobic_A", hyd_a, true)

    // KAT 4: aa_is_hydrophobic("D") == false
    let hyd_d = aa_is_hydrophobic("D")
    ck_bool("hydrophobic_D", hyd_d, false)

    // KAT 5: aa_is_charged("K") == true
    let chrg_k = aa_is_charged("K")
    ck_bool("charged_K", chrg_k, true)

    // KAT 6: net_charge("DEKR") = -1 + -1 + 1 + 1 = 0
    let nc = net_charge("DEKR")
    ck_int("net_charge_DEKR", nc, 0)

    // KAT 7: aromaticity("FWYA") = 3 aromatic / 4 total = 0.75
    let ar = aromaticity("FWYA")
    approx("aromaticity_FWYA", ar, 0.75, 0.01)

    // KAT 8: aa_composition("AAG")["A"] == 2
    let comp = aa_composition("AAG")
    let ca = comp["A"]
    ck_int("composition_AAG_A", ca, 2)

    // KAT 9: aa_composition("AAG")["G"] == 1
    let cg = comp["G"]
    ck_int("composition_AAG_G", cg, 1)

    // KAT 10: count_positive("KRDE") == 2
    let pos = count_positive("KRDE")
    ck_int("count_positive_KRDE", pos, 2)

    // KAT 11: count_negative("KRDE") == 2
    let neg = count_negative("KRDE")
    ck_int("count_negative_KRDE", neg, 2)

    // KAT 12: protein_length of a known 10-residue sequence
    let pl = protein_length("ACDEFGHIKL")
    ck_int("protein_length", pl, 10)

    // KAT 13: aa_is_polar("S") == true
    let pol_s = aa_is_polar("S")
    ck_bool("polar_S", pol_s, true)

    // KAT 14: aa_is_polar("A") == false
    let pol_a = aa_is_polar("A")
    ck_bool("polar_A", pol_a, false)

    // KAT 15: GRAVY of pure alanine (A=1.8) should be 1.8
    let gravy = hydrophobicity_gravy("A")
    approx("gravy_A", gravy, 1.8, 0.001)

    // KAT 16: net_charge of empty string = 0
    let nc_empty = net_charge("")
    ck_int("net_charge_empty", nc_empty, 0)

    // KAT 17: peptide_mw of longer peptide
    // "GG" = 57.0519 + 57.0519 + 18.01524 = 132.11904
    let mw_gg = peptide_mw("GG")
    approx("peptide_mw_GG", mw_gg, 132.11904, 0.01)

    print("PASS _protein_test")
