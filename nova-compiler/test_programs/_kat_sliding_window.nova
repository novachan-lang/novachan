import forge_sliding_window

fn main()
    let s = sw_new(60)
    s = sw_record(s, 10, 5)
    s = sw_record(s, 20, 3)
    s = sw_record(s, 30, 7)
    assert(sw_count(s) == 3, "3 records")
    assert(sw_total(s) == 15, "total 15")

    let q = sw_query(s, 10, 30)
    assert(q == 15, "query 10-30 = 15")

    let q2 = sw_query(s, 10, 20)
    assert(q2 == 8, "query 10-20 = 8")

    let q3 = sw_query(s, 25, 35)
    assert(q3 == 7, "query 25-35 = 7")

    assert(sw_window_size(s) == 60, "window 60")

    print("SLIDING-WINDOW KAT PASS")
