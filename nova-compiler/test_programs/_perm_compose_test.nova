import std/permutation/perm_compose

// cki — check integer equality
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb — check bool equality
fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

// list_str — render int list as "[a,b,c]"
fn list_str(xs) -> string
    let s = "["
    let i = 0
    while i < len(xs)
        if i > 0
            s = s + ","
        s = s + str(xs[i])
        i = i + 1
    s + "]"

// ckl — check list equality element-wise
fn ckl(label: string, got, want)
    if len(got) != len(want)
        print("FAIL " + label + ": got=" + list_str(got) + " want=" + list_str(want))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL " + label + ": got=" + list_str(got) + " want=" + list_str(want))
            exit(1)
        i = i + 1

fn main()
    // KAT: pc_compose([1,0,2],[2,1,0]) = [2,0,1]
    // (p after q)[i] = p[q[i]]
    // i=0: p[q[0]] = p[2] = 2
    // i=1: p[q[1]] = p[1] = 0
    // i=2: p[q[2]] = p[0] = 1
    let p1 = [1, 0, 2]
    let q1 = [2, 1, 0]
    let c1 = pc_compose(p1, q1)
    ckl("compose_1_0_2__2_1_0", c1, [2, 0, 1])

    // KAT: pc_compose([1,2,0],[1,2,0]) = [2,0,1]
    // i=0: p[q[0]] = p[1] = 2
    // i=1: p[q[1]] = p[2] = 0
    // i=2: p[q[2]] = p[0] = 1
    let p2 = [1, 2, 0]
    let q2 = [1, 2, 0]
    let c2 = pc_compose(p2, q2)
    ckl("compose_1_2_0__1_2_0", c2, [2, 0, 1])

    // KAT: pc_identity(3) = [0,1,2]
    let id3 = pc_identity(3)
    ckl("identity_3", id3, [0, 1, 2])

    // KAT: pc_identity(0) = []
    let id0 = pc_identity(0)
    cki("identity_0_len", len(id0), 0)

    // KAT: pc_identity(1) = [0]
    let id1 = pc_identity(1)
    ckl("identity_1", id1, [0])

    // KAT: pc_is_identity([0,1,2]) = true
    ckb("is_identity_true", pc_is_identity([0, 1, 2]), true)

    // KAT: pc_is_identity([1,0,2]) = false
    ckb("is_identity_false", pc_is_identity([1, 0, 2]), false)

    // KAT: pc_is_identity([]) = true (vacuously)
    ckb("is_identity_empty", pc_is_identity([]), true)

    // KAT: pc_equal([1,2,0],[1,2,0]) = true
    ckb("equal_same", pc_equal([1, 2, 0], [1, 2, 0]), true)

    // KAT: pc_equal([1,2,0],[2,0,1]) = false
    ckb("equal_diff", pc_equal([1, 2, 0], [2, 0, 1]), false)

    // KAT: pc_equal([], []) = true
    ckb("equal_empty", pc_equal([], []), true)

    // Composing with identity on the right: p after id = p
    let p3 = [2, 0, 1]
    let id = pc_identity(3)
    let c3 = pc_compose(p3, id)
    ckb("compose_p_id", pc_equal(c3, p3), true)

    // Composing with identity on the left: id after p = p
    let c4 = pc_compose(id, p3)
    ckb("compose_id_p", pc_equal(c4, p3), true)

    // Single element: compose([0],[0]) = [0]
    let c5 = pc_compose([0], [0])
    ckl("compose_n1", c5, [0])

    print("PASS _perm_compose_test")
