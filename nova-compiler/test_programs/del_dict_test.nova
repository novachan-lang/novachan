fn main()
    let m = {}
    m["d"] = 1
    print("contains d: " + str(contains(m, "d")))
    print("contains del: " + str(contains(m, "del")))
    print("contains e: " + str(contains(m, "e")))

    if not contains(m, "del")
        print("NOT in dict - correct")
    else
        print("BUG: false positive for del!")

    print("del_dict_test: PASS")
