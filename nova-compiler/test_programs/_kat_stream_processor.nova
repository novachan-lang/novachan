import forge_stream_processor

fn main()
    let s = sp_new(3)
    assert(sp_window_count(s) == 0, "empty window")

    s = sp_push(s, 10)
    s = sp_push(s, 20)
    s = sp_push(s, 30)
    assert(sp_window_count(s) == 3, "3 in window")
    assert(sp_window_sum(s) == 60, "sum 60")
    assert(sp_window_avg(s) == 20, "avg 20")
    assert(sp_latest(s) == 30, "latest 30")

    s = sp_push(s, 40)
    assert(sp_window_count(s) == 3, "still 3")
    assert(sp_window_sum(s) == 90, "sum 90 (20+30+40)")
    assert(sp_window_avg(s) == 30, "avg 30")
    assert(sp_total_processed(s) == 4, "4 processed")

    s = sp_filter_push(s, 5, 10)
    assert(sp_total_processed(s) == 4, "filtered out")
    assert(sp_drop_rate(s) == 20, "20% drop")

    s = sp_filter_push(s, 50, 10)
    assert(sp_total_processed(s) == 5, "50 passed filter")
    assert(sp_latest(s) == 50, "latest 50")

    print("STREAM-PROCESSOR KAT PASS")
