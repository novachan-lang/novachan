// KAT for std/text/damerau — dl_distance (Optimal String Alignment)
import std/text/damerau

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // KAT 1: empty string to "abc" = 3 insertions
    cki("dl-empty-to-abc", dl_distance("", "abc"), 3)

    // KAT 2: identical strings -> 0
    cki("dl-same-abc", dl_distance("abc", "abc"), 0)

    // KAT 3: one transposition "ca" -> "ac" = 1 (swap adjacent chars)
    //   Levenshtein would give 2 (delete+insert); Damerau gives 1.
    cki("dl-ca-ac", dl_distance("ca", "ac"), 1)

    // KAT 4: "kitten" -> "sitting" = 3
    //   k->s (sub), e->i (sub), +g (insert) — no transpositions help here
    cki("dl-kitten-sitting", dl_distance("kitten", "sitting"), 3)

    // KAT 5: "ab" -> "ba" = 1 (one adjacent transposition)
    cki("dl-ab-ba", dl_distance("ab", "ba"), 1)

    // KAT 6: "a cat" -> "an act" = 2 (published OSA value)
    cki("dl-a-cat-an-act", dl_distance("a cat", "an act"), 2)

    // KAT 7: "abcdef" -> "abcdef" = 0
    cki("dl-same-abcdef", dl_distance("abcdef", "abcdef"), 0)

    // Additional sanity checks
    // KAT 8: symmetry — distance is symmetric
    cki("dl-sym-kitten", dl_distance("sitting", "kitten"), 3)

    // KAT 9: single char to empty = 1 deletion
    cki("dl-a-empty", dl_distance("a", ""), 1)

    // KAT 10: "abc" -> "bac" = 1 (adjacent transposition of a,b)
    cki("dl-abc-bac", dl_distance("abc", "bac"), 1)

    print("_damerau_test passed")
