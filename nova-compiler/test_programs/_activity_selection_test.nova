import std/greedy/activity_selection

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _activity_selection_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL _activity_selection_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(label: string, got: list, want: list)
    cki(label + ".len", len(got), len(want))
    let i = 0
    while i < len(want)
        cki(label + "[" + str(i) + "]", got[i], want[i])
        i = i + 1

fn main()
    // KAT 1: classic 6-activity example (greedy by earliest finish)
    // starts=[1,3,0,5,8,5], ends=[2,4,6,7,9,9]
    // Sort by end: idx0(e=2),idx1(e=4),idx2(e=6),idx3(e=7),idx4(e=9),idx5(e=9)
    // Pick idx0(s=1,e=2). idx1: s=3>=2 pick(e=4). idx2: s=0<4 skip.
    // idx3: s=5>=4 pick(e=7). idx4: s=8>=7 pick(e=9). idx5: s=5<9 skip. count=4
    let st1 = [1, 3, 0, 5, 8, 5]
    let en1 = [2, 4, 6, 7, 9, 9]
    cki("max_count_4", as_max_count(st1, en1), 4)

    // KAT 2: two overlapping activities — can only pick 1
    // starts=[1,2], ends=[3,4]: [1,3] and [2,4] overlap (2<3)
    let st2 = [1, 2]
    let en2 = [3, 4]
    cki("max_count_overlap_1", as_max_count(st2, en2), 1)

    // KAT 3: touching at endpoints is allowed
    // starts=[1,2], ends=[2,3]: [1,2] then [2,3]: start=2>=end=2 OK -> count=2
    let st3 = [1, 2]
    let en3 = [2, 3]
    cki("max_count_touching_2", as_max_count(st3, en3), 2)

    // KAT 4: starts=[1,3], ends=[4,2] — end[1]=2 < end[0]=4 so sort puts idx1 first
    // Pick idx1 (start=3,end=2). Then idx0: start=1 < last_end=2 -> skip. count=1
    let st4 = [1, 3]
    let en4 = [4, 2]
    cki("max_count_unsorted_1", as_max_count(st4, en4), 1)

    // KAT 5: empty inputs
    let st5 = []
    let en5 = []
    cki("max_count_empty", as_max_count(st5, en5), 0)

    // KAT 6: starts=[1,2,3,3], ends=[3,4,5,6]
    // Sort by end: (1,3),(2,4),(3,5),(3,6) -> idx0,1,2,3
    // Pick idx0(e=3). idx1: s=2<3 skip. idx2: s=3>=3 pick(e=5). idx3: s=3<5 skip. count=2
    let st6 = [1, 2, 3, 3]
    let en6 = [3, 4, 5, 6]
    cki("max_count_2", as_max_count(st6, en6), 2)

    // KAT 7: single activity
    let st7 = [5]
    let en7 = [10]
    cki("max_count_single", as_max_count(st7, en7), 1)

    // KAT 8: as_selected returns the correct indices for classic 6-activity example
    // Expected: [0, 1, 3, 4] (activities 0,1,3,4 by original index)
    let sel1 = as_selected(st1, en1)
    let exp1 = [0, 1, 3, 4]
    ckl("selected_4", sel1, exp1)

    // KAT 9: as_selected empty
    let sel_empty = as_selected(st5, en5)
    cki("selected_empty_len", len(sel_empty), 0)

    // KAT 10: as_selected single
    let sel7 = as_selected(st7, en7)
    ckl("selected_single", sel7, [0])

    // KAT 11: as_selected touching pair
    let sel3 = as_selected(st3, en3)
    ckl("selected_touching", sel3, [0, 1])

    // KAT 12: all non-overlapping
    // starts=[1,3,5], ends=[2,4,6]: all disjoint -> count=3
    let st12 = [1, 3, 5]
    let en12 = [2, 4, 6]
    cki("max_count_all_disjoint", as_max_count(st12, en12), 3)

    // KAT 13: all overlapping with same start
    // starts=[0,0,0], ends=[5,3,1]: sort by end -> idx2(e=1),idx1(e=3),idx0(e=5)
    // Pick idx2(s=0,e=1). idx1: s=0<1 skip. idx0: s=0<1 skip. count=1
    let st13 = [0, 0, 0]
    let en13 = [5, 3, 1]
    cki("max_count_same_start", as_max_count(st13, en13), 1)

    print("PASS _activity_selection_test")
