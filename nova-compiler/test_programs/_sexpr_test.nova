// KAT for std/data/sexpr
// Tests sx_parse, sx_write, sx_is_atom against spec-defined and hand-computed values.
import std/data/sexpr

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got [" + got + "] expected [" + expected + "]")
        exit(1)

fn main()
    // ── KAT 1: sx_parse flat list ────────────────────────────────────────────
    // sx_parse("(a b c)") == ["a","b","c"]
    let list1 = sx_parse("(a b c)")
    cki("parse_flat_len", len(list1), 3)
    cks("parse_flat_0", list1[0], "a")
    cks("parse_flat_1", list1[1], "b")
    cks("parse_flat_2", list1[2], "c")

    // ── KAT 2: sx_parse nested list ─────────────────────────────────────────
    // sx_parse("(a (b c) d)") == ["a",["b","c"],"d"]
    let list2 = sx_parse("(a (b c) d)")
    cki("parse_nested_len", len(list2), 3)
    cks("parse_nested_0", list2[0], "a")
    let inner2 = list2[1]
    cki("parse_nested_1_len", len(inner2), 2)
    cks("parse_nested_1_0", inner2[0], "b")
    cks("parse_nested_1_1", inner2[1], "c")
    cks("parse_nested_2", list2[2], "d")

    // ── KAT 3: sx_parse empty list ───────────────────────────────────────────
    // sx_parse("()") == []
    let list3 = sx_parse("()")
    cki("parse_empty_len", len(list3), 0)
    cki("parse_empty_is_atom", sx_is_atom(list3), 0)

    // ── KAT 4: sx_parse atom ────────────────────────────────────────────────
    // sx_parse("atom") == "atom"
    let atom4 = sx_parse("atom")
    cks("parse_atom", atom4, "atom")
    cki("parse_atom_is_atom", sx_is_atom(atom4), 1)

    // ── KAT 5: sx_write flat list ────────────────────────────────────────────
    // sx_write(["a","b"]) == "(a b)"
    let wl5 = []
    wl5.push("a")
    wl5.push("b")
    cks("write_flat", sx_write(wl5), "(a b)")

    // ── KAT 6: sx_write nested list ─────────────────────────────────────────
    // sx_write(["+",["*","2","3"],"4"]) == "(+ (* 2 3) 4)"
    let inner6 = []
    inner6.push("*")
    inner6.push("2")
    inner6.push("3")
    let wl6 = []
    wl6.push("+")
    wl6.push(inner6)
    wl6.push("4")
    cks("write_nested", sx_write(wl6), "(+ (* 2 3) 4)")

    // ── KAT 7: sx_is_atom string ─────────────────────────────────────────────
    // sx_is_atom("x") == 1
    cki("is_atom_string", sx_is_atom("x"), 1)

    // ── KAT 8: sx_is_atom list ───────────────────────────────────────────────
    // sx_is_atom(["x"]) == 0
    let xl8 = []
    xl8.push("x")
    cki("is_atom_list", sx_is_atom(xl8), 0)

    // ── KAT 9: round-trip ────────────────────────────────────────────────────
    // sx_write(sx_parse("(f (g x) y)")) == "(f (g x) y)"
    let rt = sx_parse("(f (g x) y)")
    let rtw = sx_write(rt)
    cks("round_trip", rtw, "(f (g x) y)")

    // ── KAT 10: sx_write empty list ──────────────────────────────────────────
    let wempty = []
    cks("write_empty", sx_write(wempty), "()")

    // ── KAT 11: sx_write atom passthrough ────────────────────────────────────
    cks("write_atom", sx_write("hello"), "hello")

    // ── KAT 12: round-trip with multiple spaces (parser normalises) ───────────
    // Extra whitespace in source normalises in output (atoms unchanged)
    let rt2 = sx_parse("(a   b   c)")
    cks("round_trip_spaces", sx_write(rt2), "(a b c)")

    // ── KAT 13: deeply nested three levels ───────────────────────────────────
    // sx_parse("(a (b (c d)))") -> ["a", ["b", ["c","d"]]]
    let deep = sx_parse("(a (b (c d)))")
    cki("deep_len", len(deep), 2)
    cks("deep_0", deep[0], "a")
    let deep1 = deep[1]
    cki("deep_1_len", len(deep1), 2)
    cks("deep_1_0", deep1[0], "b")
    let deep2 = deep1[1]
    cki("deep_2_len", len(deep2), 2)
    cks("deep_2_0", deep2[0], "c")
    cks("deep_2_1", deep2[1], "d")

    // ── KAT 14: round-trip deeply nested ─────────────────────────────────────
    let rt3 = sx_parse("(a (b (c d)))")
    cks("round_trip_deep", sx_write(rt3), "(a (b (c d)))")

    // ── KAT 15: sx_is_atom on empty list ─────────────────────────────────────
    let empty_l = []
    cki("is_atom_empty_list", sx_is_atom(empty_l), 0)

    print("_sexpr_test passed")

main()
