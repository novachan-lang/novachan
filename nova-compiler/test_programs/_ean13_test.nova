import std/barcode/ean13

// Helper check functions — print FAIL and exit(1) on mismatch.
fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // ── KAT 1: ean13_check ISBN-13 978-0-306-40615-? ────────────────────────
    cki("check_isbn13", ean13_check("978030640615"), 7)

    // ── KAT 2: ean13_check second vector ─────────────────────────────────────
    cki("check_vec2", ean13_check("400638133393"), 1)

    // ── KAT 3: ean13_encode produces 95-module pattern ───────────────────────
    let enc = ean13_encode("978030640615")
    cki("encode_len", len(enc), 95)

    // ── KAT 4: pattern starts with left guard 101 ────────────────────────────
    cks("encode_left_guard", slice(enc, 0, 3), "101")

    // ── KAT 5: pattern ends with right guard 101 ─────────────────────────────
    cks("encode_right_guard", slice(enc, 92, 95), "101")

    // ── KAT 6: center guard at positions 45..49 is "01010" ──────────────────
    cks("encode_center_guard", slice(enc, 45, 50), "01010")

    // ── KAT 7: ean13_valid for correct 13-digit code ─────────────────────────
    cki("valid_ok", ean13_valid("9780306406157"), 1)

    // ── KAT 8: ean13_valid rejects wrong check digit ─────────────────────────
    cki("valid_bad", ean13_valid("9780306406158"), 0)

    // ── KAT 9: ean13_check with a simple all-zeros payload ───────────────────
    // All zeros: sum = 0, check = (10 - 0) % 10 = 0
    cki("check_zeros", ean13_check("000000000000"), 0)

    // ── KAT 10: check second vector validates ─────────────────────────────────
    cki("valid_vec2", ean13_valid("4006381333931"), 1)

    // ── KAT 11: encode length for all-zeros ───────────────────────────────────
    cki("encode_len_zeros", len(ean13_encode("000000000000")), 95)

    // ── KAT 12: ean13_valid rejects wrong check on second vector ─────────────
    cki("valid_vec2_bad", ean13_valid("4006381333930"), 0)

    print("PASS _ean13_test")
