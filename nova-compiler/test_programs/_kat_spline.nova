import forge_spline

fn ap(a: float, b: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    d < 0.0001
fn tf(b: bool) -> string
    if b
        return "T"
    "F"

fn main()
    let p0 = [0.0, 0.0]
    let p1 = [1.0, 0.0]
    let p2 = [2.0, 1.0]
    let p3 = [3.0, 1.0]
    // passes THROUGH P1 at t=0 and P2 at t=1
    let a0 = catmull_rom(p0, p1, p2, p3, 0.0)
    let a1 = catmull_rom(p0, p1, p2, p3, 1.0)
    print("through_p1=" + tf(ap(a0[0], 1.0) and ap(a0[1], 0.0)))
    print("through_p2=" + tf(ap(a1[0], 2.0) and ap(a1[1], 1.0)))
    // midpoint lies between P1 and P2 in x (monotone-ish)
    let mid = catmull_rom(p0, p1, p2, p3, 0.5)
    print("mid_between=" + tf(mid[0] > 1.0 and mid[0] < 2.0))
    // symmetric straight line: collinear points -> midpoint on the line
    let l0 = [0.0, 0.0]
    let l1 = [1.0, 1.0]
    let l2 = [2.0, 2.0]
    let l3 = [3.0, 3.0]
    let lm = catmull_rom(l0, l1, l2, l3, 0.5)
    print("line_mid=" + tf(ap(lm[0], 1.5) and ap(lm[1], 1.5)))
    // path sampling: first==P1, last==P2
    let path = catmull_rom_path(p0, p1, p2, p3, 5)
    print("path_len=" + tf(len(path) == 5))
    print("path_first=" + tf(ap(path[0][0], 1.0)))
    print("path_last=" + tf(ap(path[4][0], 2.0) and ap(path[4][1], 1.0)))
