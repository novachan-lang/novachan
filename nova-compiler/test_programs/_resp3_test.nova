// ============================================================================
// KAT for std/net/resp3 — RESP3 codec (Redis 6+ binary-safe protocol)
// ============================================================================
// Known vectors:
//   (a) resp3_null()          => "_\r\n"
//   (b) resp3_bool(true)      => "#t\r\n"
//   (c) resp3_bool(false)     => "#f\r\n"
//   (d) resp3_double("3.14")  => ",3.14\r\n"
//   (e) resp3_bignum("12345678901234567890") => "(12345678901234567890\r\n"
//   (f) resp3_simple("OK")    => "+OK\r\n"
//   (g) resp3_error("ERR")    => "-ERR\r\n"
//   (h) resp3_integer(42)     => ":42\r\n"
//   (i) resp3_integer(-7)     => ":-7\r\n"
//   (j) resp3_map(1 pair)     => "%1\r\n..." round-trip
//   (k) resp3_set(2 items)    => "~2\r\n..." round-trip
//   (l) resp3_push(2 items)   => ">2\r\n..." round-trip
//   (m) resp3_verbatim        => "=<len>\r\ntxt:hello\r\n"
//   (n) resp3_blob_error      => "!<len>\r\nERR bad\r\n"
//   (o) resp3_bulk            => "$5\r\nhello\r\n"
//   (p) parse round-trips for all types
// ============================================================================
import std/net/resp3

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL resp3 " + label + ": got=[" + got + "] want=[" + want + "]")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL resp3 " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    let crlf = chr(13) + chr(10)

    // ── (a) Null ──────────────────────────────────────────────────────────────
    let null_b = resp3_null()
    cks("null_wire", bytes_to_str(null_b), "_" + crlf)

    // ── (b) Boolean true ─────────────────────────────────────────────────────
    let bool_t = resp3_bool(1)
    cks("bool_true_wire", bytes_to_str(bool_t), "#t" + crlf)

    // ── (c) Boolean false ────────────────────────────────────────────────────
    let bool_f = resp3_bool(0)
    cks("bool_false_wire", bytes_to_str(bool_f), "#f" + crlf)

    // ── (d) Double ───────────────────────────────────────────────────────────
    let dbl_b = resp3_double("3.14")
    cks("double_wire", bytes_to_str(dbl_b), ",3.14" + crlf)

    // ── (e) Big number ───────────────────────────────────────────────────────
    let big_b = resp3_bignum("12345678901234567890")
    cks("bignum_wire", bytes_to_str(big_b), "(12345678901234567890" + crlf)

    // ── (f) Simple string ────────────────────────────────────────────────────
    let simple_b = resp3_simple("OK")
    cks("simple_wire", bytes_to_str(simple_b), "+OK" + crlf)

    // ── (g) Simple error ─────────────────────────────────────────────────────
    let err_b = resp3_error("ERR bad command")
    cks("error_wire", bytes_to_str(err_b), "-ERR bad command" + crlf)

    // ── (h) Integer positive ─────────────────────────────────────────────────
    let int_b = resp3_integer(42)
    cks("int_wire", bytes_to_str(int_b), ":42" + crlf)

    // ── (i) Integer negative ─────────────────────────────────────────────────
    let int_neg_b = resp3_integer(-7)
    cks("int_neg_wire", bytes_to_str(int_neg_b), ":-7" + crlf)

    // ── (j) Map (1 pair: simple "key" -> integer 99) ─────────────────────────
    let key_enc = resp3_simple("mykey")
    let val_enc = resp3_integer(99)
    let pair_list = [key_enc, val_enc]
    let map_b = resp3_map(pair_list)
    // wire: %1\r\n+mykey\r\n:99\r\n
    let want_map = "%" + "1" + crlf + "+mykey" + crlf + ":99" + crlf
    cks("map_wire", bytes_to_str(map_b), want_map)

    // ── (k) Set (2 simple strings) ───────────────────────────────────────────
    let s1 = resp3_simple("alpha")
    let s2 = resp3_simple("beta")
    let set_items = [s1, s2]
    let set_b = resp3_set(set_items)
    let want_set = "~2" + crlf + "+alpha" + crlf + "+beta" + crlf
    cks("set_wire", bytes_to_str(set_b), want_set)

    // ── (l) Push (2 items) ───────────────────────────────────────────────────
    let p1 = resp3_simple("subscribe")
    let p2 = resp3_integer(1)
    let push_items = [p1, p2]
    let push_b = resp3_push(push_items)
    let want_push = ">2" + crlf + "+subscribe" + crlf + ":1" + crlf
    cks("push_wire", bytes_to_str(push_b), want_push)

    // ── (m) Verbatim string ──────────────────────────────────────────────────
    // body = "txt:hello", len = 9
    let verb_b = resp3_verbatim("txt", "hello")
    let want_verb = "=9" + crlf + "txt:hello" + crlf
    cks("verbatim_wire", bytes_to_str(verb_b), want_verb)

    // ── (n) Blob error ───────────────────────────────────────────────────────
    // "ERR bad" = 7 chars
    let bloberr_b = resp3_blob_error("ERR bad")
    let want_bloberr = "!7" + crlf + "ERR bad" + crlf
    cks("blob_error_wire", bytes_to_str(bloberr_b), want_bloberr)

    // ── (o) Bulk string ──────────────────────────────────────────────────────
    let bulk_data = str_to_bytes("hello")
    let bulk_b = resp3_bulk(bulk_data)
    let want_bulk = "$5" + crlf + "hello" + crlf
    cks("bulk_wire", bytes_to_str(bulk_b), want_bulk)

    // ── (p) Parse round-trips ─────────────────────────────────────────────────

    // parse null
    let pn = resp3_parse(null_b, 0)
    let pn_res = pn[0]
    let pn_nxt = pn[1]
    cks("parse_null_type", pn_res["type"], "null")
    cki("parse_null_nxt", pn_nxt, bytes_len(null_b))

    // parse bool true
    let pt = resp3_parse(bool_t, 0)
    let pt_res = pt[0]
    cks("parse_bool_true_type", pt_res["type"], "bool")
    cki("parse_bool_true_val", pt_res["value"], 1)

    // parse bool false
    let pf = resp3_parse(bool_f, 0)
    let pf_res = pf[0]
    cks("parse_bool_false_type", pf_res["type"], "bool")
    cki("parse_bool_false_val", pf_res["value"], 0)

    // parse double
    let pd = resp3_parse(dbl_b, 0)
    let pd_res = pd[0]
    cks("parse_double_type", pd_res["type"], "double")
    cks("parse_double_val", pd_res["value"], "3.14")

    // parse bignum
    let pb = resp3_parse(big_b, 0)
    let pb_res = pb[0]
    cks("parse_bignum_type", pb_res["type"], "bignum")
    cks("parse_bignum_val", pb_res["value"], "12345678901234567890")

    // parse simple string
    let ps = resp3_parse(simple_b, 0)
    let ps_res = ps[0]
    cks("parse_simple_type", ps_res["type"], "simple")
    cks("parse_simple_val", ps_res["value"], "OK")

    // parse simple error
    let pe = resp3_parse(err_b, 0)
    let pe_res = pe[0]
    cks("parse_error_type", pe_res["type"], "error")
    cks("parse_error_val", pe_res["value"], "ERR bad command")

    // parse integer
    let pi = resp3_parse(int_b, 0)
    let pi_res = pi[0]
    cks("parse_int_type", pi_res["type"], "integer")
    cki("parse_int_val", pi_res["value"], 42)

    // parse negative integer
    let pin = resp3_parse(int_neg_b, 0)
    let pin_res = pin[0]
    cks("parse_int_neg_type", pin_res["type"], "integer")
    cki("parse_int_neg_val", pin_res["value"], -7)

    // parse map
    let pm = resp3_parse(map_b, 0)
    let pm_res = pm[0]
    cks("parse_map_type", pm_res["type"], "map")
    let pm_pairs = pm_res["value"]
    cki("parse_map_count", len(pm_pairs), 1)
    let pm_kv = pm_pairs[0]
    let pm_k = pm_kv[0]
    let pm_v = pm_kv[1]
    cks("parse_map_key_type", pm_k["type"], "simple")
    cks("parse_map_key_val", pm_k["value"], "mykey")
    cks("parse_map_val_type", pm_v["type"], "integer")
    cki("parse_map_val_val", pm_v["value"], 99)

    // parse set
    let pset = resp3_parse(set_b, 0)
    let pset_res = pset[0]
    cks("parse_set_type", pset_res["type"], "set")
    let pset_items = pset_res["value"]
    cki("parse_set_count", len(pset_items), 2)
    cks("parse_set_0_type", pset_items[0]["type"], "simple")
    cks("parse_set_0_val", pset_items[0]["value"], "alpha")
    cks("parse_set_1_val", pset_items[1]["value"], "beta")

    // parse push
    let ppu = resp3_parse(push_b, 0)
    let ppu_res = ppu[0]
    cks("parse_push_type", ppu_res["type"], "push")
    let ppu_items = ppu_res["value"]
    cki("parse_push_count", len(ppu_items), 2)
    cks("parse_push_0_val", ppu_items[0]["value"], "subscribe")
    cki("parse_push_1_val", ppu_items[1]["value"], 1)

    // parse verbatim
    let pv = resp3_parse(verb_b, 0)
    let pv_res = pv[0]
    cks("parse_verbatim_type", pv_res["type"], "verbatim")
    cks("parse_verbatim_val", pv_res["value"], "txt:hello")

    // parse blob error
    let pbe = resp3_parse(bloberr_b, 0)
    let pbe_res = pbe[0]
    cks("parse_blob_error_type", pbe_res["type"], "blob_error")
    cks("parse_blob_error_val", bytes_to_str(pbe_res["value"]), "ERR bad")

    // parse bulk string
    let pbk = resp3_parse(bulk_b, 0)
    let pbk_res = pbk[0]
    cks("parse_bulk_type", pbk_res["type"], "bulk")
    cks("parse_bulk_val", bytes_to_str(pbk_res["value"]), "hello")

    // ── Malformed input safety ────────────────────────────────────────────────
    // Empty bytes -> parse_error
    let empty_b = bytes(0)
    let perr = resp3_parse(empty_b, 0)
    cks("parse_empty_type", perr[0]["type"], "parse_error")
    cki("parse_empty_nxt", perr[1], -1)

    // Truncated null (missing CRLF)
    let trunc = str_to_bytes("_")
    let ptrunc = resp3_parse(trunc, 0)
    cks("parse_trunc_null_type", ptrunc[0]["type"], "parse_error")

    // Unknown sigil
    let unk_b = str_to_bytes("?" + crlf)
    let punk = resp3_parse(unk_b, 0)
    cks("parse_unknown_sigil_type", punk[0]["type"], "parse_error")

    // ── Multi-value stream parsing (sequential pos advancement) ───────────────
    // Stream: null + bool_true + integer(7)
    let int7 = resp3_integer(7)
    let stream = bytes_concat(bytes_concat(null_b, bool_t), int7)
    let r0 = resp3_parse(stream, 0)
    cks("stream_0_type", r0[0]["type"], "null")
    let r1 = resp3_parse(stream, r0[1])
    cks("stream_1_type", r1[0]["type"], "bool")
    cki("stream_1_val", r1[0]["value"], 1)
    let r2 = resp3_parse(stream, r1[1])
    cks("stream_2_type", r2[0]["type"], "integer")
    cki("stream_2_val", r2[0]["value"], 7)
    cki("stream_final_pos", r2[1], bytes_len(stream))

    print("PASS _resp3_test")
