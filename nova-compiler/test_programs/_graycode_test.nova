import std/math/graycode

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn ckb(label, got, expected)
    if got != expected
        let gs = "false"
        let es = "false"
        if got
            gs = "true"
        if expected
            es = "true"
        print("FAIL " + label + ": got " + gs + " expected " + es)
        exit(1)

fn main()
    cki("encode(0)", gray_encode(0), 0)
    cki("encode(1)", gray_encode(1), 1)
    cki("encode(2)", gray_encode(2), 3)
    cki("encode(3)", gray_encode(3), 2)
    cki("encode(4)", gray_encode(4), 6)
    cki("encode(5)", gray_encode(5), 7)
    cki("encode(6)", gray_encode(6), 5)
    cki("encode(7)", gray_encode(7), 4)

    let k = 0
    while k <= 10
        let encoded = gray_encode(k)
        let decoded = gray_decode(encoded)
        cki("roundtrip(" + str(k) + ")", decoded, k)
        k = k + 1

    let g2 = gray_list(2)
    cki("list2[0]", g2[0], 0)
    cki("list2[1]", g2[1], 1)
    cki("list2[2]", g2[2], 3)
    cki("list2[3]", g2[3], 2)
    cki("list2 len", len(g2), 4)

    let g3 = gray_list(3)
    cki("list3 len", len(g3), 8)
    let i = 0
    while i < 7
        let a = g3[i]
        let b = g3[i + 1]
        ckb("list3 adjacent[" + str(i) + "," + str(i+1) + "]", gray_adjacent_differ_one(a, b), true)
        i = i + 1

    ckb("adjacent(0,1)", gray_adjacent_differ_one(0, 1), true)
    ckb("adjacent(1,3)", gray_adjacent_differ_one(1, 3), true)
    ckb("adjacent(3,2)", gray_adjacent_differ_one(3, 2), true)
    ckb("adjacent(0,3)", gray_adjacent_differ_one(0, 3), false)
    ckb("adjacent(0,0)", gray_adjacent_differ_one(0, 0), false)

    cki("roundtrip(1000)", gray_decode(gray_encode(1000)), 1000)
    cki("roundtrip(65535)", gray_decode(gray_encode(65535)), 65535)

    print("_graycode_test passed")
