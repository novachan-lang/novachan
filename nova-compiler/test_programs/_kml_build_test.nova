// KAT test for std/data/kml_build
import std/data/kml_build
import std/data/kml_parse

// Helper: check that string contains a substring.
fn must_contain(label: string, haystack: string, needle: string)
    let hn = len(haystack)
    let nn = len(needle)
    let found = 0
    let i = 0
    while i <= hn - nn
        let matched = 1
        let j = 0
        while j < nn
            if char_at(haystack, i + j) != char_at(needle, j)
                matched = 0
            j = j + 1
        if matched == 1
            found = 1
        i = i + 1
    if found == 0
        print("FAIL " + label + ": needle not found: " + needle)
        exit(1)

// Helper: integer equality check.
fn cki(label: string, got: int, expected: int)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

// Helper: float approximate equality — delegates to kml_parse's kml_approx.
fn approx(a: float, b: float, tol: float) -> int
    kml_approx(a, b, tol)

// ── Test kml_approx (from kml_parse) ─────────────────────────────────────────

cki("approx_eq",   kml_approx(1.0, 1.0, 0.0001), 1)
cki("approx_ne",   kml_approx(1.0, 2.0, 0.0001), 0)
cki("approx_edge", kml_approx(1.0, 1.0001, 0.0001), 1)
cki("approx_just_outside", kml_approx(1.0, 1.0002, 0.0001), 0)

// ── Test kml_build structure ─────────────────────────────────────────────────

let pts = [[1.0, 2.0], [3.0, 4.0]]
let kml = kml_build(pts)

must_contain("has_kml_open",         kml, "<kml")
must_contain("has_document",         kml, "<Document>")
must_contain("has_placemark",        kml, "<Placemark>")
must_contain("has_linestring",       kml, "<LineString>")
must_contain("has_coordinates_open", kml, "<coordinates>")
must_contain("has_coordinates_close",kml, "</coordinates>")
must_contain("has_kml_close",        kml, "</kml>")
must_contain("has_ns",               kml, "opengis.net/kml")

// The coordinate values must appear.
must_contain("has_lon1", kml, "1")
must_contain("has_lon2", kml, "3")

// ── Test round-trip via kml_parse ─────────────────────────────────────────────

let pts2 = [[10.5, 20.75], [-73.9857, 40.7484], [0.0, 0.0]]
let kml2 = kml_build(pts2)
let parsed = kml_parse(kml2)

cki("rt_len", len(parsed), 3)

let tol = 0.000000001
let p0 = parsed[0]
let p1 = parsed[1]
let p2 = parsed[2]

if approx(p0[0], 10.5, tol) == 0
    print("FAIL rt_p0_lon: got " + str(p0[0]) + " expected 10.5")
    exit(1)
if approx(p0[1], 20.75, tol) == 0
    print("FAIL rt_p0_lat: got " + str(p0[1]) + " expected 20.75")
    exit(1)
if approx(p1[0], -73.9857, tol) == 0
    print("FAIL rt_p1_lon: got " + str(p1[0]) + " expected -73.9857")
    exit(1)
if approx(p1[1], 40.7484, tol) == 0
    print("FAIL rt_p1_lat: got " + str(p1[1]) + " expected 40.7484")
    exit(1)
if approx(p2[0], 0.0, tol) == 0
    print("FAIL rt_p2_lon: got " + str(p2[0]) + " expected 0.0")
    exit(1)
if approx(p2[1], 0.0, tol) == 0
    print("FAIL rt_p2_lat: got " + str(p2[1]) + " expected 0.0")
    exit(1)

// ── Test empty points ────────────────────────────────────────────────────────

let kml_empty = kml_build([])
must_contain("empty_kml_open",  kml_empty, "<kml")
must_contain("empty_coord_tag", kml_empty, "<coordinates>")

// ── Test single point ────────────────────────────────────────────────────────

let kml_one = kml_build([[5.5, -3.25]])
must_contain("single_has_kml",  kml_one, "<kml")
must_contain("single_has_5",    kml_one, "5.5")
let parsed_one = kml_parse(kml_one)
cki("single_rt_len", len(parsed_one), 1)
let q0 = parsed_one[0]
if approx(q0[0], 5.5, tol) == 0
    print("FAIL single_rt_lon: got " + str(q0[0]))
    exit(1)
if approx(q0[1], -3.25, tol) == 0
    print("FAIL single_rt_lat: got " + str(q0[1]))
    exit(1)

print("PASS _kml_build_test")
