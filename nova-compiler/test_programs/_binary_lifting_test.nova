import std/collections/binary_lifting

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn main()
    // Tree: parent=[0,0,0,1,1] root=0
    // Node 0: root; nodes 1,2 are children of 0; nodes 3,4 are children of 1.
    // Depths: 0->0, 1->1, 2->1, 3->2, 4->2.
    let parent = []
    parent.push(0)
    parent.push(0)
    parent.push(0)
    parent.push(1)
    parent.push(1)
    let bl = blt_build(parent, 0)

    // blt_depth checks
    cki("depth(0)", blt_depth(bl, 0), 0)
    cki("depth(1)", blt_depth(bl, 1), 1)
    cki("depth(2)", blt_depth(bl, 2), 1)
    cki("depth(3)", blt_depth(bl, 3), 2)
    cki("depth(4)", blt_depth(bl, 4), 2)

    // blt_kth_ancestor
    cki("kth_anc(3,1)", blt_kth_ancestor(bl, 3, 1), 1)
    cki("kth_anc(3,2)", blt_kth_ancestor(bl, 3, 2), 0)
    cki("kth_anc(3,5)", blt_kth_ancestor(bl, 3, 5), -1)
    cki("kth_anc(0,0)", blt_kth_ancestor(bl, 0, 0), 0)
    cki("kth_anc(0,1)", blt_kth_ancestor(bl, 0, 1), -1)
    cki("kth_anc(4,1)", blt_kth_ancestor(bl, 4, 1), 1)
    cki("kth_anc(2,1)", blt_kth_ancestor(bl, 2, 1), 0)

    // blt_lca
    cki("lca(3,4)", blt_lca(bl, 3, 4), 1)
    cki("lca(3,2)", blt_lca(bl, 3, 2), 0)
    cki("lca(1,2)", blt_lca(bl, 1, 2), 0)
    cki("lca(3,1)", blt_lca(bl, 3, 1), 1)
    cki("lca(0,4)", blt_lca(bl, 0, 4), 0)
    cki("lca(2,2)", blt_lca(bl, 2, 2), 2)

    // blt_distance
    cki("dist(3,4)", blt_distance(bl, 3, 4), 2)
    cki("dist(3,2)", blt_distance(bl, 3, 2), 3)
    cki("dist(3,1)", blt_distance(bl, 3, 1), 1)
    cki("dist(0,4)", blt_distance(bl, 0, 4), 2)
    cki("dist(2,2)", blt_distance(bl, 2, 2), 0)

    // Deeper tree: linear chain 0<-1<-2<-3<-4<-5<-6<-7
    let par2 = []
    par2.push(0)
    par2.push(0)
    par2.push(1)
    par2.push(2)
    par2.push(3)
    par2.push(4)
    par2.push(5)
    par2.push(6)
    let bl2 = blt_build(par2, 0)
    cki("chain depth(7)", blt_depth(bl2, 7), 7)
    cki("chain kth_anc(7,3)", blt_kth_ancestor(bl2, 7, 3), 4)
    cki("chain kth_anc(7,7)", blt_kth_ancestor(bl2, 7, 7), 0)
    cki("chain kth_anc(7,8)", blt_kth_ancestor(bl2, 7, 8), -1)
    cki("chain lca(5,3)", blt_lca(bl2, 5, 3), 3)
    cki("chain dist(7,0)", blt_distance(bl2, 7, 0), 7)
    cki("chain dist(5,3)", blt_distance(bl2, 5, 3), 2)

    print("PASS _binary_lifting_test")
