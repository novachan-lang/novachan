import forge_interval_tree

fn main()
    let t = it_new()
    t = it_insert(t, 10, 20, "meeting-a")
    t = it_insert(t, 15, 25, "meeting-b")
    t = it_insert(t, 30, 40, "meeting-c")
    assert(it_count(t) == 3, "3 intervals")

    assert(it_overlaps(t, 12, 18) == 2, "12-18 overlaps a+b")
    assert(it_overlaps(t, 22, 28) == 1, "22-28 overlaps b only")
    assert(it_overlaps(t, 26, 29) == 0, "26-29 no overlap")
    assert(it_overlaps(t, 0, 50) == 3, "0-50 overlaps all")

    assert(it_contains_point(t, 17) == 2, "point 17 in a+b")
    assert(it_contains_point(t, 35) == 1, "point 35 in c")
    assert(it_contains_point(t, 50) == 0, "point 50 outside")

    let lbl = it_first_overlap_label(t, 32, 38)
    assert(lbl == "meeting-c", "first overlap is c")

    assert(it_label(t, 0) == "meeting-a", "label 0")
    assert(it_label(t, 2) == "meeting-c", "label 2")

    print("INTERVAL-TREE KAT PASS")
