import std/game2d/quadtree_hit

// cki: check integer equality.
fn cki(label: string, got: int, want: int) -> any
    if got != want
        print("FAIL quadtree_hit " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)
    0

// ckb: check bool (1/0 from bool coerce).
fn ckb(label: string, got: bool, want: bool) -> any
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL quadtree_hit " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)
    0

// has_id: check if string id is in list.
fn has_id(ids: list, target: string) -> bool
    let found = false
    let i = 0
    let n = len(ids)
    while i < n
        if ids[i] == target
            found = true
        i = i + 1
    found

// approx: float equality within tolerance.
fn approx(a: float, b: float, tol: float) -> bool
    let diff = a - b
    if diff < 0.0
        diff = 0.0 - diff
    let ok = diff <= tol
    ok

fn main()
    // === KAT 1: qt_new + qt_count ===
    let qt = qt_new(0.0, 0.0, 16.0, 16.0, 2)
    cki("empty_count", qt_count(qt), 0)

    // === KAT 2: qt_contains_point ===
    ckb("contains_interior", qt_contains_point(qt, 5.0, 5.0), true)
    ckb("contains_origin", qt_contains_point(qt, 0.0, 0.0), true)
    ckb("contains_boundary_max", qt_contains_point(qt, 16.0, 16.0), true)
    ckb("not_contains_outside", qt_contains_point(qt, 20.0, 5.0), false)
    ckb("not_contains_neg", qt_contains_point(qt, -1.0, 5.0), false)

    // === KAT 3: insert 4 points (forces subdivision at cap=2) ===
    // Points: (1,1)='a', (2,2)='b', (10,10)='c', (3,3)='d'
    qt_insert(qt, "a", 1.0, 1.0)
    qt_insert(qt, "b", 2.0, 2.0)
    qt_insert(qt, "c", 10.0, 10.0)
    qt_insert(qt, "d", 3.0, 3.0)
    cki("count_4", qt_count(qt), 4)

    // === KAT 4: qt_query_rect — all in [0,5) x [0,5) ===
    // {a,b,d} in top-left; c at (10,10) is outside
    let box1 = []
    push(box1, 0)
    push(box1, 0)
    push(box1, 5)
    push(box1, 5)
    let r1 = qt_query_rect(qt, box1)
    cki("query_rect_0_0_5_5_len", len(r1), 3)
    if not has_id(r1, "a")
        print("FAIL quadtree_hit query_rect missing a")
        exit(1)
    if not has_id(r1, "b")
        print("FAIL quadtree_hit query_rect missing b")
        exit(1)
    if not has_id(r1, "d")
        print("FAIL quadtree_hit query_rect missing d")
        exit(1)
    if has_id(r1, "c")
        print("FAIL quadtree_hit query_rect should NOT have c (at 10,10)")
        exit(1)

    // === KAT 5: qt_query_rect — box around (10,10) ===
    // [8,8,4,4] covers (8..12, 8..12) -> c at (10,10)
    let box2 = []
    push(box2, 8)
    push(box2, 8)
    push(box2, 4)
    push(box2, 4)
    let r2 = qt_query_rect(qt, box2)
    cki("query_rect_8_8_4_4_len", len(r2), 1)
    if not has_id(r2, "c")
        print("FAIL quadtree_hit query_rect [8,8,4,4] missing c")
        exit(1)

    // === KAT 6: qt_depth > 1 after subdivision ===
    let d = qt_depth(qt)
    if d <= 1
        print("FAIL quadtree_hit depth should be > 1 after subdivision: got " + str(d))
        exit(1)

    // === KAT 7: qt_all returns all 4 entries ===
    let all = qt_all(qt)
    cki("qt_all_len", len(all), 4)

    // === KAT 8: qt_query_circle — radius 1 around (1.5, 1.5) ===
    // Points: a=(1,1) dist=sqrt(0.5)~0.707 <= 1 YES
    //         b=(2,2) dist=sqrt(0.5)~0.707 <= 1 YES
    //         c=(10,10) dist way outside
    //         d=(3,3) dist=sqrt(4.5)~2.12 > 1 NO
    let rc = qt_query_circle(qt, 1.5, 1.5, 1.0)
    if not has_id(rc, "a")
        print("FAIL quadtree_hit query_circle missing a (dist ~0.707 <= 1)")
        exit(1)
    if not has_id(rc, "b")
        print("FAIL quadtree_hit query_circle missing b (dist ~0.707 <= 1)")
        exit(1)
    if has_id(rc, "d")
        print("FAIL quadtree_hit query_circle should NOT have d (dist ~2.12 > 1)")
        exit(1)
    if has_id(rc, "c")
        print("FAIL quadtree_hit query_circle should NOT have c (far away)")
        exit(1)

    // === KAT 9: degenerate — insert point outside region is ignored ===
    let qt2 = qt_new(0.0, 0.0, 10.0, 10.0, 2)
    qt_insert(qt2, "out", 20.0, 20.0)
    cki("outside_ignored", qt_count(qt2), 0)

    // === KAT 10: empty query returns empty list ===
    let emptybox = []
    push(emptybox, 100)
    push(emptybox, 100)
    push(emptybox, 1)
    push(emptybox, 1)
    let r3 = qt_query_rect(qt, emptybox)
    cki("query_empty_region", len(r3), 0)

    // === KAT 11: large insertion forcing multiple levels of subdivision ===
    let qt3 = qt_new(0.0, 0.0, 100.0, 100.0, 2)
    qt_insert(qt3, "p1", 1.0, 1.0)
    qt_insert(qt3, "p2", 2.0, 2.0)
    qt_insert(qt3, "p3", 3.0, 3.0)
    qt_insert(qt3, "p4", 4.0, 4.0)
    qt_insert(qt3, "p5", 50.0, 50.0)
    cki("multi_insert_count", qt_count(qt3), 5)
    let deepbox = []
    push(deepbox, 0)
    push(deepbox, 0)
    push(deepbox, 10)
    push(deepbox, 10)
    let r4 = qt_query_rect(qt3, deepbox)
    cki("multi_deep_rect", len(r4), 4)

    print("PASS _quadtree_hit_test")

main()
