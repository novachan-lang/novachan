// KAT for std/math/round — round_to/clamp/sign/lerp (float compares use epsilon).
import std/math/round

fn ckf(label: string, got: float, want: float)
    let d = got - want
    if d < 0.0
        d = 0.0 - d
    if d > 0.001
        print("FAIL " + label + ": " + str(got) + " != " + str(want))
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": " + str(got) + " != " + str(want))
        exit(1)

fn main()
    ckf("r-pi", round_to(3.14159, 2), 3.14)
    ckf("r-999", round_to(9.999, 2), 10.0)
    ckf("r-half", round_to(1.25, 1), 1.3)
    cki("clamp-mid", clamp(5, 0, 10), 5)
    cki("clamp-lo", clamp(0 - 1, 0, 10), 0)
    cki("clamp-hi", clamp(15, 0, 10), 10)
    cki("sign-neg", sign(0.0 - 3.5), 0 - 1)
    cki("sign-zero", sign(0.0), 0)
    cki("sign-pos", sign(2.0), 1)
    ckf("lerp-half", lerp(0.0, 10.0, 0.5), 5.0)
    ckf("lerp-0", lerp(0.0, 10.0, 0.0), 0.0)
    ckf("lerp-1", lerp(0.0, 10.0, 1.0), 10.0)
    print("_round_test passed")
