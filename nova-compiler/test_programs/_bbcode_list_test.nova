// KAT for std/text/bbcode_list
import std/text/bbcode_list

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got [" + got + "] want [" + want + "]")
        exit(1)

fn main()
    let nl = chr(10)

    // KAT-1: extract items from a single-line list
    let it1 = blst_extract_items("[list][*]A[*]B[/list]")
    cki("it1-count", len(it1), 2)
    cks("it1-first", it1[0], "A")
    cks("it1-second", it1[1], "B")

    // KAT-2: extract items from a multi-line list, whitespace trimmed
    let ml = "[list]" + nl + "[*]Apple" + nl + "[*]Banana" + nl + "[/list]"
    let it2 = blst_extract_items(ml)
    cki("it2-count", len(it2), 2)
    cks("it2-first", it2[0], "Apple")
    cks("it2-second", it2[1], "Banana")

    // KAT-3: no [list] tag at all -> empty result
    let it3 = blst_extract_items("no list tag here")
    cki("it3-count", len(it3), 0)

    // KAT-4: tag matching is case-insensitive
    let it4 = blst_extract_items("[LIST][*]X[*]Y[/LIST]")
    cki("it4-count", len(it4), 2)
    cks("it4-first", it4[0], "X")
    cks("it4-second", it4[1], "Y")

    // KAT-5: build an unordered list from items
    let items5 = []
    push(items5, "A")
    push(items5, "B")
    cks("build-unordered", blst_build(items5), "[list][*]A[*]B[/list]")

    // KAT-6: build an ordered list from items
    cks("build-ordered", blst_ordered_build(items5), "[list=1][*]A[*]B[/list]")

    // KAT-7: count [*] markers
    cki("count-three", blst_count_items("[list][*]A[*]B[*]C[/list]"), 3)

    // KAT-8: count with no markers
    cki("count-zero", blst_count_items("no markers here"), 0)

    // KAT-9: is_ordered true for [list=1]
    cki("ordered-numeric", blst_is_ordered("[list=1][*]A[/list]"), 1)

    // KAT-10: is_ordered true for [list=a] (lettered)
    cki("ordered-lettered", blst_is_ordered("[list=a][*]A[/list]"), 1)

    // KAT-11: is_ordered false for bare [list]
    cki("unordered-bare", blst_is_ordered("[list][*]A[/list]"), 0)

    // KAT-12: is_ordered false when there is no [list] tag
    cki("unordered-none", blst_is_ordered("no list tag"), 0)

    print("PASS _bbcode_list_test")
