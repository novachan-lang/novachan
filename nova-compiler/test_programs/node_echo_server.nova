// Distributed node echo server: length-framed JSON message round-trip.
fn main()
    let argv = args()
    let port = 18920
    if len(argv) > 1
        port = parse_int(argv[1])
    let server = node_listen(port)
    print("node listening on {port}")
    let conn = node_accept(server)
    let msg = node_recv(conn, 0)
    print("recv ok")
    // msg is the parsed value (a dict); echo it straight back.
    node_send(conn, msg)
    print("echoed")
    // Stay alive until the client has read the echo and closed, so the
    // process exit doesn't RST the connection and drop the buffered payload.
    node_recv(conn, 0)
    print("client closed")
