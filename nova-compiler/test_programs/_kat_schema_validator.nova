import forge_schema_validator

fn main()
    let s = sv_new()
    assert(sv_schema_count(s) == 0, "starts empty")
    assert(sv_has_schema(s, "user") == 0, "user schema not yet registered")

    s = sv_add_field(s, "user", "name", "string")
    s = sv_add_field(s, "user", "age", "int")
    s = sv_add_field(s, "user", "active", "bool")
    assert(sv_has_schema(s, "user") == 1, "user schema now registered")
    assert(sv_schema_count(s) == 1, "1 schema")

    let fc = sv_field_count(s, "user")
    assert(is_ok(fc) == true, "field count readable")
    assert(unwrap(fc) == 3, "user has 3 fields")

    let fc_missing = sv_field_count(s, "nope")
    assert(is_err(fc_missing) == true, "unknown schema field_count errs")

    let setreq = sv_set_required(s, "user", "name")
    assert(is_ok(setreq) == true, "set required ok")
    let req = sv_is_required(s, "user", "name")
    assert(is_ok(req) == true, "required check readable")
    assert(unwrap(req) == 1, "name is required")

    let opt = sv_is_required(s, "user", "age")
    assert(is_ok(opt) == true, "age required check readable")
    assert(unwrap(opt) == 0, "age is optional by default")

    let req_missing = sv_set_required(s, "user", "nope")
    assert(is_err(req_missing) == true, "setting required on undeclared field errs")

    let v1 = sv_validate_field(s, "user", "name", "Alice")
    assert(is_ok(v1) == true, "string value passes")

    let v2 = sv_validate_field(s, "user", "age", 30)
    assert(is_ok(v2) == true, "int value passes")

    let v3 = sv_validate_field(s, "user", "name", 42)
    assert(is_err(v3) == true, "int value for string field fails")

    let v4 = sv_validate_field(s, "user", "age", "thirty")
    assert(is_err(v4) == true, "string value for int field fails")

    let v5 = sv_validate_field(s, "user", "missing_field", "x")
    assert(is_err(v5) == true, "undeclared field fails")

    let v6 = sv_validate_field(s, "user", "active", true)
    assert(is_ok(v6) == true, "bool value passes bool field")

    let v7 = sv_validate_field(s, "user", "active", "yes")
    assert(is_err(v7) == true, "string value for bool field fails")

    assert(sv_total_validations(s) == 6, "6 validations counted (undeclared field not counted)")
    assert(sv_pass_count(s) == 3, "3 validations passed")

    // second schema, independent field/required state
    s = sv_add_field(s, "product", "sku", "string")
    assert(sv_schema_count(s) == 2, "2 schemas now")
    let fc2 = sv_field_count(s, "product")
    assert(unwrap(fc2) == 1, "product has 1 field")
    let req2 = sv_is_required(s, "product", "sku")
    assert(unwrap(req2) == 0, "product.sku not required (schemas independent)")

    print("SCHEMA-VALIDATOR KAT PASS")
