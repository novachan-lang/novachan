import forge_schema_validator

fn main()
    let s = sv_new()
    s = sv_require(s, "name", "string")
    s = sv_require(s, "age", "int")
    s = sv_optional(s, "email", "string")
    s = sv_range(s, "score", 0, 100)
    assert(sv_rule_count(s) == 4, "4 rules")

    let d1 = {}
    d1["name"] = "Alice"
    d1["age"] = 30
    d1["score"] = 85
    let r1 = sv_validate(s, d1)
    s = r1["s"]
    assert(r1["errors"] == 0, "no errors")

    let d2 = {}
    d2["age"] = 25
    d2["score"] = 50
    let r2 = sv_validate(s, d2)
    s = r2["s"]
    assert(r2["errors"] > 0, "missing name")
    assert(r2["first_error"] == "missing:name", "name missing")

    let d3 = {}
    d3["name"] = "Bob"
    d3["age"] = 20
    d3["score"] = 150
    let r3 = sv_validate(s, d3)
    s = r3["s"]
    assert(r3["errors"] > 0, "score over max")
    assert(r3["first_error"] == "above_max:score", "above_max")

    assert(sv_failure_rate(s) == 66, "66% fail")

    print("SCHEMA-VALIDATOR KAT PASS")
