import forge_text

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // sentence_count
    fails = fails + expect("sc1", str(sentence_count("Hello world. How are you? I am fine!")), "3")
    fails = fails + expect("sc_no_punct", str(sentence_count("just some text")), "1")
    fails = fails + expect("sc_ellipsis", str(sentence_count("Wait... really?")), "2")
    fails = fails + expect("sc_empty", str(sentence_count("")), "0")
    fails = fails + expect("sc_one", str(sentence_count("One sentence.")), "1")
    fails = fails + expect("sc_no_trailing", str(sentence_count("A. B. C")), "3")

    // char_count
    fails = fails + expect("cc_with", str(char_count("a b c", false)), "5")
    fails = fails + expect("cc_without", str(char_count("a b c", true)), "3")
    fails = fails + expect("cc_empty", str(char_count("", false)), "0")

    // longest_word
    fails = fails + expect("lw1", longest_word("the quick brown fox"), "quick")
    fails = fails + expect("lw_tie", longest_word("cat dog bird"), "bird")
    fails = fails + expect("lw_single", longest_word("hello"), "hello")
    fails = fails + expect("lw_empty", longest_word(""), "")
    fails = fails + expect("lw_spaces", longest_word("  ab   cde "), "cde")

    if fails == 0
        print("forge_text_ext: all passed")
    else
        print("forge_text_ext: " + str(fails) + " FAILED")
