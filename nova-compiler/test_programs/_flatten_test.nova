// KAT for std/data/flatten
// Tests fd_flatten, fd_unflatten, fd_get against hand-computed values.
import std/data/flatten

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got [" + got + "] expected [" + expected + "]")
        exit(1)

fn main()
    // Build nested dict: {"a":1, "b":{"x":2, "y":{"z":3}}}
    let inner = {}
    inner["z"] = 3
    let mid = {}
    mid["x"] = 2
    mid["y"] = inner
    let d = {}
    d["a"] = 1
    d["b"] = mid

    // ── fd_flatten ───────────────────────────────────────────────────────────
    let f = fd_flatten(d)

    // KAT 1: top-level scalar preserved
    cki("flat_a", f["a"], 1)

    // KAT 2: one level deep
    cki("flat_b.x", f["b.x"], 2)

    // KAT 3: two levels deep
    cki("flat_b.y.z", f["b.y.z"], 3)

    // KAT 4: flat dict has exactly 3 keys (no dict-valued keys leaked out)
    cki("flat_len", len(keys(f)), 3)

    // ── fd_unflatten ─────────────────────────────────────────────────────────
    let u = fd_unflatten(f)

    // KAT 5: top-level scalar round-trips
    cki("unflat_a", u["a"], 1)

    // KAT 6: one level deep round-trip
    let ub = u["b"]
    cki("unflat_b.x", ub["x"], 2)

    // KAT 7: two levels deep round-trip
    let uby = ub["y"]
    cki("unflat_b.y.z", uby["z"], 3)

    // ── fd_get ───────────────────────────────────────────────────────────────

    // KAT 8: deep path resolves correctly on original nested dict
    let got_z = fd_get(d, "b.y.z")
    cki("fdget_b.y.z", got_z, 3)

    // KAT 9: missing key returns null
    let got_q = fd_get(d, "b.q")
    cki("fdget_missing", got_q, null)

    // KAT 10: single-segment path works
    let got_a = fd_get(d, "a")
    cki("fdget_a", got_a, 1)

    // KAT 11: fd_flatten on already-flat dict is identity
    let flat2 = {}
    flat2["x"] = 10
    flat2["y"] = 20
    let ff = fd_flatten(flat2)
    cki("flatflat_x", ff["x"], 10)
    cki("flatflat_y", ff["y"], 20)
    cki("flatflat_len", len(keys(ff)), 2)

    // KAT 12: fd_unflatten single key
    let single = {}
    single["hello"] = 99
    let us = fd_unflatten(single)
    cki("unflat_single", us["hello"], 99)

    print("_flatten_test passed")

main()
