// KAT test for std/compress/code_bitpack
// PRIMARY:   round-trip int_from_bits(bits_from_int(v,w),0,w) == [v,w] for v in 0..255 w in 1..8
//            sequence round-trip via bitpack_seq + int_from_bits
// SECONDARY: known bit-pattern vectors from the spec
import std/compress/code_bitpack

// ── Helper: compare two lists and fail loudly ─────────────────────────────────
fn ckl(label, got, want)
    let ng = len(got)
    let nw = len(want)
    if ng != nw
        print("FAIL " + label + ": length got=" + str(ng) + " want=" + str(nw))
        exit(1)
    let i = 0
    while i < nw
        let _u = 0
        if got[i] != want[i]
            print("FAIL " + label + ": pos=" + str(i) + " got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ── KAT 1: bits_from_int known vectors ───────────────────────────────────────
// bits_from_int(5, 4) == [0, 1, 0, 1]
let bfi_5_4 = []
push(bfi_5_4, 0)
push(bfi_5_4, 1)
push(bfi_5_4, 0)
push(bfi_5_4, 1)
ckl("bfi_5_4", bits_from_int(5, 4), bfi_5_4)

// bits_from_int(255, 8) == [1,1,1,1,1,1,1,1]
let bfi_255_8 = []
push(bfi_255_8, 1)
push(bfi_255_8, 1)
push(bfi_255_8, 1)
push(bfi_255_8, 1)
push(bfi_255_8, 1)
push(bfi_255_8, 1)
push(bfi_255_8, 1)
push(bfi_255_8, 1)
ckl("bfi_255_8", bits_from_int(255, 8), bfi_255_8)

// bits_from_int(0, 4) == [0,0,0,0]
let bfi_0_4 = []
push(bfi_0_4, 0)
push(bfi_0_4, 0)
push(bfi_0_4, 0)
push(bfi_0_4, 0)
ckl("bfi_0_4", bits_from_int(0, 4), bfi_0_4)

// bits_from_int(7, 3) == [1,1,1]
let bfi_7_3 = []
push(bfi_7_3, 1)
push(bfi_7_3, 1)
push(bfi_7_3, 1)
ckl("bfi_7_3", bits_from_int(7, 3), bfi_7_3)

// bits_from_int(1, 1) == [1]
let bfi_1_1 = []
push(bfi_1_1, 1)
ckl("bfi_1_1", bits_from_int(1, 1), bfi_1_1)

// bits_from_int(0, 0) == []
let bfi_0_0 = []
ckl("bfi_0_0", bits_from_int(0, 0), bfi_0_0)

// ── KAT 2: int_from_bits known vectors ───────────────────────────────────────
// int_from_bits([0,1,0,1], 0, 4) == [5, 4]
let ifb_in1 = []
push(ifb_in1, 0)
push(ifb_in1, 1)
push(ifb_in1, 0)
push(ifb_in1, 1)
let ifb_r1 = int_from_bits(ifb_in1, 0, 4)
cki("ifb_5_val", ifb_r1[0], 5)
cki("ifb_5_pos", ifb_r1[1], 4)

// int_from_bits([1,1,1,1,1,1,1,1], 0, 8) == [255, 8]
let ifb_in2 = []
push(ifb_in2, 1)
push(ifb_in2, 1)
push(ifb_in2, 1)
push(ifb_in2, 1)
push(ifb_in2, 1)
push(ifb_in2, 1)
push(ifb_in2, 1)
push(ifb_in2, 1)
let ifb_r2 = int_from_bits(ifb_in2, 0, 8)
cki("ifb_255_val", ifb_r2[0], 255)
cki("ifb_255_pos", ifb_r2[1], 8)

// int_from_bits([0,1,0,1], 2, 2) == [1, 4]  (reads bits[2]=0, bits[3]=1 -> 01 = 1)
let ifb_r3 = int_from_bits(ifb_in1, 2, 2)
cki("ifb_mid_val", ifb_r3[0], 1)
cki("ifb_mid_pos", ifb_r3[1], 4)

// ── KAT 3: pack_bits known vectors ───────────────────────────────────────────
// pack_bits([1,0,0,0,0,0,0,1]) -> byte[0] == 0x81 == 129
let pb_in1 = []
push(pb_in1, 1)
push(pb_in1, 0)
push(pb_in1, 0)
push(pb_in1, 0)
push(pb_in1, 0)
push(pb_in1, 0)
push(pb_in1, 0)
push(pb_in1, 1)
let pb_r1 = pack_bits(pb_in1)
cki("pack_single_len", len(pb_r1), 1)
cki("pack_single_val", pb_r1[0], 129)

// pack_bits([1,0,1,1,0,0,1,0, 1,1]) -> [178, 192]
// byte 0: 10110010 = 178; byte 1: 11000000 = 192
let pb_in2 = []
push(pb_in2, 1)
push(pb_in2, 0)
push(pb_in2, 1)
push(pb_in2, 1)
push(pb_in2, 0)
push(pb_in2, 0)
push(pb_in2, 1)
push(pb_in2, 0)
push(pb_in2, 1)
push(pb_in2, 1)
let pb_r2 = pack_bits(pb_in2)
cki("pack_two_len",   len(pb_r2), 2)
cki("pack_two_byte0", pb_r2[0], 178)
cki("pack_two_byte1", pb_r2[1], 192)

// pack_bits([]) -> []
let pb_r3 = pack_bits([])
cki("pack_empty_len", len(pb_r3), 0)

// All-zeros 8 bits -> byte 0
let pb_in4 = []
push(pb_in4, 0)
push(pb_in4, 0)
push(pb_in4, 0)
push(pb_in4, 0)
push(pb_in4, 0)
push(pb_in4, 0)
push(pb_in4, 0)
push(pb_in4, 0)
let pb_r4 = pack_bits(pb_in4)
cki("pack_zeros_len", len(pb_r4), 1)
cki("pack_zeros_val", pb_r4[0], 0)

// ── KAT 4: unpack_bits known vectors ─────────────────────────────────────────
// unpack_bits([129], 8) -> [1,0,0,0,0,0,0,1]
let upb_in1 = []
push(upb_in1, 129)
let upb_r1 = unpack_bits(upb_in1, 8)
let upb_want1 = []
push(upb_want1, 1)
push(upb_want1, 0)
push(upb_want1, 0)
push(upb_want1, 0)
push(upb_want1, 0)
push(upb_want1, 0)
push(upb_want1, 0)
push(upb_want1, 1)
ckl("unpack_129_8", upb_r1, upb_want1)

// unpack_bits([178], 8) -> [1,0,1,1,0,0,1,0]
let upb_in2 = []
push(upb_in2, 178)
let upb_r2 = unpack_bits(upb_in2, 8)
let upb_want2 = []
push(upb_want2, 1)
push(upb_want2, 0)
push(upb_want2, 1)
push(upb_want2, 1)
push(upb_want2, 0)
push(upb_want2, 0)
push(upb_want2, 1)
push(upb_want2, 0)
ckl("unpack_178_8", upb_r2, upb_want2)

// unpack_bits([129], 4) -> [1,0,0,0]  (top 4 bits of 0x81)
let upb_r3 = unpack_bits(upb_in1, 4)
let upb_want3 = []
push(upb_want3, 1)
push(upb_want3, 0)
push(upb_want3, 0)
push(upb_want3, 0)
ckl("unpack_129_4", upb_r3, upb_want3)

// ── KAT 5: bitpack_seq known vectors ─────────────────────────────────────────
// bitpack_seq([1, 2, 3], 2) -> [0,1, 1,0, 1,1]
// 1 in 2 bits = 01, 2 in 2 bits = 10, 3 in 2 bits = 11
let bps_vals = []
push(bps_vals, 1)
push(bps_vals, 2)
push(bps_vals, 3)
let bps_r1 = bitpack_seq(bps_vals, 2)
let bps_want1 = []
push(bps_want1, 0)
push(bps_want1, 1)
push(bps_want1, 1)
push(bps_want1, 0)
push(bps_want1, 1)
push(bps_want1, 1)
ckl("bitpack_seq_123_2", bps_r1, bps_want1)

// bitpack_seq([5], 4) -> [0,1,0,1]
let bps_vals2 = []
push(bps_vals2, 5)
let bps_r2 = bitpack_seq(bps_vals2, 4)
ckl("bitpack_seq_5_4", bps_r2, bfi_5_4)

// bitpack_seq([], 8) -> []
let bps_r3 = bitpack_seq([], 8)
cki("bitpack_seq_empty", len(bps_r3), 0)

// ── KAT 6: PRIMARY round-trip for v in 0..255, w in 1..8 ────────────────────
// int_from_bits(bits_from_int(v, w), 0, w) == [v & mask, w]
// We compute mask inline: 2^w - 1
let w = 1
while w <= 8
    let _u = 0
    // compute 2^w - 1 inline (no private helper)
    let pow2w = 1
    let bi2 = 0
    while bi2 < w
        let _u3 = 0
        pow2w = pow2w * 2
        bi2 = bi2 + 1
    let mask = pow2w - 1
    let v = 0
    while v <= 255
        let _u2 = 0
        let masked = v & mask
        let enc = bits_from_int(masked, w)
        let dec = int_from_bits(enc, 0, w)
        if dec[0] != masked
            print("FAIL round_trip_val v=" + str(masked) + " w=" + str(w) + " got=" + str(dec[0]))
            exit(1)
        if dec[1] != w
            print("FAIL round_trip_pos v=" + str(masked) + " w=" + str(w) + " got=" + str(dec[1]))
            exit(1)
        v = v + 1
    w = w + 1

// ── KAT 7: pack_bits / unpack_bits round-trip for 8-bit multiples ────────────
// For a list of bits that is a multiple of 8 in length,
// unpack_bits(pack_bits(bl), len(bl)) should equal bl.
let rt_bits = []
push(rt_bits, 1)
push(rt_bits, 0)
push(rt_bits, 1)
push(rt_bits, 1)
push(rt_bits, 0)
push(rt_bits, 0)
push(rt_bits, 1)
push(rt_bits, 0)
push(rt_bits, 0)
push(rt_bits, 1)
push(rt_bits, 1)
push(rt_bits, 1)
push(rt_bits, 0)
push(rt_bits, 0)
push(rt_bits, 0)
push(rt_bits, 1)
let rt_packed = pack_bits(rt_bits)
let rt_unpacked = unpack_bits(rt_packed, 16)
ckl("pack_unpack_rt_16", rt_unpacked, rt_bits)

// ── KAT 8: PRIMARY sequence round-trip via bitpack_seq ───────────────────────
// Encode values [10,20,30,40,50,60,100] each in 7 bits (range 0..127),
// concatenate, then decode each back using int_from_bits at advancing pos.
let seq_values = []
push(seq_values, 10)
push(seq_values, 20)
push(seq_values, 30)
push(seq_values, 40)
push(seq_values, 50)
push(seq_values, 60)
push(seq_values, 100)
let seq_width = 7
let seq_stream = bitpack_seq(seq_values, seq_width)
cki("seq_stream_len", len(seq_stream), 49)

// decode back in order
let seq_pos = 0
let svi = 0
while svi < len(seq_values)
    let _u = 0
    let sv = seq_values[svi]
    let dec = int_from_bits(seq_stream, seq_pos, seq_width)
    if dec[0] != sv
        print("FAIL seq_rt val=" + str(sv) + " got=" + str(dec[0]) + " at_pos=" + str(seq_pos))
        exit(1)
    seq_pos = dec[1]
    svi = svi + 1
cki("seq_rt_end_pos", seq_pos, 49)

// ── KAT 9: int_from_bits safe underflow (reading past end returns 0) ─────────
// Reading 4 bits from a 2-bit list at pos=0: bits[0], bits[1] exist; bits[2], bits[3] = 0
let short_bits = []
push(short_bits, 1)
push(short_bits, 1)
// reads: 1, 1, 0, 0 -> 12
let uf_dec = int_from_bits(short_bits, 0, 4)
cki("underflow_val", uf_dec[0], 12)
cki("underflow_pos", uf_dec[1], 4)

// ── KAT 10: pack_bits byte ordering sanity ───────────────────────────────────
// 0xFF = 11111111 -> pack_bits gives [255]
let all1 = bits_from_int(255, 8)
let p_all1 = pack_bits(all1)
cki("pack_ff_len", len(p_all1), 1)
cki("pack_ff_val", p_all1[0], 255)

// 0x00 -> pack_bits([0,0,0,0,0,0,0,0]) gives [0]
let all0 = bits_from_int(0, 8)
let p_all0 = pack_bits(all0)
cki("pack_00_len", len(p_all0), 1)
cki("pack_00_val", p_all0[0], 0)

// single bit 1 -> pack_bits([1]) = [128]  (10000000 = 128)
let one_bit = []
push(one_bit, 1)
let p_one = pack_bits(one_bit)
cki("pack_1bit_len", len(p_one), 1)
cki("pack_1bit_val", p_one[0], 128)

// ── KAT 11: bitpack_seq then pack_bits, verify total byte count ───────────────
// 8 values each 4 bits = 32 bits = 4 bytes
let vals8 = []
push(vals8, 0)
push(vals8, 1)
push(vals8, 2)
push(vals8, 3)
push(vals8, 4)
push(vals8, 5)
push(vals8, 6)
push(vals8, 7)
let bits8 = bitpack_seq(vals8, 4)
cki("bitpack_seq_8vals_bitlen", len(bits8), 32)
let bytes8 = pack_bits(bits8)
cki("bitpack_seq_8vals_bytelen", len(bytes8), 4)

// Verify each 4-bit value can be recovered from the bitstream
let vi8 = 0
while vi8 < 8
    let _u = 0
    let dec8 = int_from_bits(bits8, vi8 * 4, 4)
    if dec8[0] != vi8
        print("FAIL bitpack_seq_8vals val=" + str(vi8) + " got=" + str(dec8[0]))
        exit(1)
    vi8 = vi8 + 1

// ── KAT 12: unpack_bits nbits clamped to available bits ──────────────────────
// 1 byte, ask for 16 bits -> get 8
let clamp_in = []
push(clamp_in, 170)
let clamp_out = unpack_bits(clamp_in, 16)
cki("unpack_clamp_len", len(clamp_out), 8)
// 170 = 10101010
let clamp_want = []
push(clamp_want, 1)
push(clamp_want, 0)
push(clamp_want, 1)
push(clamp_want, 0)
push(clamp_want, 1)
push(clamp_want, 0)
push(clamp_want, 1)
push(clamp_want, 0)
ckl("unpack_170_clamped", clamp_out, clamp_want)

print("PASS _code_bitpack_test")
