// Pattern matching on Result/Option (Ok/Err/Some/None) — the idiomatic, safe,
// exhaustive way to consume a typed Result. Previously `match r { Ok(x)=>.. }`
// silently never matched (only `_` fired); now the inferrer marks a Sum-typed
// subject and codegen compares the NovaResult tag (Ok/Some=0, Err/None=1),
// binding the payload at the Sum's ok/err element type. User enums (nt_struct,
// e.g. a user-defined Option) are unaffected — they keep the type-hash path.

// return-match form (function body is a match yielding the return value)
fn classify(s: string) -> string
    match parse_int_safe(s)
        Ok(n) => "int:" + str(n)
        Err(e) => "err:" + e

fn main()
    // payload binding + both arms
    assert_eq(classify("42"), "int:42")
    assert_eq(classify("-17"), "int:-17")
    assert_eq(classify("abc"), "err:not an integer")
    assert_eq(classify(""), "err:empty string")

    // statement-match form, with a large-int payload (scalar compare is exact)
    let r = parse_int_safe("9007199254740993")
    let hit = 0
    match r
        Ok(n) =>
            assert_eq(n, 9007199254740993)
            hit = 1
        Err(e) =>
            hit = -1
    assert_eq(hit, 1)

    // the Err arm actually fires on bad input
    let bad = 0
    match parse_int_safe("nope")
        Ok(n) =>
            bad = -1
        Err(e) =>
            bad = 1
    assert_eq(bad, 1)

    // expression-match form yielding a value
    let msg = match parse_int_safe("-5")
        Ok(n) => "got " + str(n)
        Err(e) => "bad"
    assert_eq(msg, "got -5")

    print("match_result_test passed")
