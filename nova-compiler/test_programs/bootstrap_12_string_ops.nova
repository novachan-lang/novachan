// Bootstrap test 12: string operations the compiler uses
let s = "hello world"
print(len(s))

// contains
if contains(s, "world")
    print("found")

// split and join
let parts = split(s, " ")
print(len(parts))
print(parts[0])
print(parts[1])

// str() conversion
let n = 42
let msg = "number is " + str(n)
print(msg)
