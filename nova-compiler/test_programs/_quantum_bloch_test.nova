import std/quantum/quantum_qubit
import std/quantum/quantum_bloch

// cki — integer known-answer check, exact match required.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _quantum_bloch_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// cka — integer known-answer check with tolerance (trig-derived values).
fn cka(label: string, got: int, want: int, tol: int)
    let d = got - want
    let ad = d
    if ad < 0
        ad = 0 - ad
    if ad > tol
        print("FAIL _quantum_bloch_test " + label + ": got=" + str(got) + " want=" + str(want) + " tol=" + str(tol))
        exit(1)

fn main()
    // north/south poles: |0> at +z, |1> at -z
    cki("z(|0>)", qbl_z_x1000(qbt_zero()), 1000)
    cki("z(|1>)", qbl_z_x1000(qbt_one()), 0 - 1000)
    cki("x(|0>)", qbl_x_x1000(qbt_zero()), 0)
    cki("y(|0>)", qbl_y_x1000(qbt_zero()), 0)

    // |+> sits on +x axis
    cki("x(|+>)", qbl_x_x1000(qbt_plus()), 1000)
    cki("y(|+>)", qbl_y_x1000(qbt_plus()), 0)
    cki("z(|+>)", qbl_z_x1000(qbt_plus()), 0)

    // |-> sits on -x axis
    cki("x(|->)", qbl_x_x1000(qbt_minus()), 0 - 1000)

    // |+i> sits on +y axis
    cki("y(|+i>)", qbl_y_x1000(qbt_plus_i()), 1000)
    cki("x(|+i>)", qbl_x_x1000(qbt_plus_i()), 0)

    // |-i> sits on -y axis
    cki("y(|-i>)", qbl_y_x1000(qbt_minus_i()), 0 - 1000)

    // purity is 1000 for every pure single qubit
    cki("purity(|0>)", qbl_purity_x1000(qbt_zero()), 1000)
    cki("purity(|+>)", qbl_purity_x1000(qbt_plus()), 1000)
    cki("purity(|+i>)", qbl_purity_x1000(qbt_plus_i()), 1000)

    // theta: |0> -> 0, |1> -> pi (~3141), |+> -> pi/2 (~1571)
    cka("theta(|0>)", qbl_theta_x1000(qbt_zero()), 0, 2)
    cka("theta(|1>)", qbl_theta_x1000(qbt_one()), 3142, 2)
    cka("theta(|+>)", qbl_theta_x1000(qbt_plus()), 1571, 2)

    // qbl_from_angles round trip against Bloch coordinates
    let PI = 3.14159265358979323846
    let half_pi = PI / 2.0
    let q_from_zero = qbl_from_angles(0.0, 0.0)
    cka("from_angles(0,0) z", qbl_z_x1000(q_from_zero), 1000, 2)

    let q_from_plus = qbl_from_angles(half_pi, 0.0)
    cka("from_angles(pi/2,0) x", qbl_x_x1000(q_from_plus), 1000, 2)
    cka("from_angles(pi/2,0) z", qbl_z_x1000(q_from_plus), 0, 2)

    let q_from_plus_i = qbl_from_angles(half_pi, half_pi)
    cka("from_angles(pi/2,pi/2) y", qbl_y_x1000(q_from_plus_i), 1000, 2)

    print("PASS _quantum_bloch_test")
