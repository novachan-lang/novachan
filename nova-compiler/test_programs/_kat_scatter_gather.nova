import forge_scatter_gather

fn main()
    let s = sg_new()
    s = sg_scatter(s, "t1", "fetch-users")
    s = sg_scatter(s, "t2", "fetch-orders")
    s = sg_scatter(s, "t3", "fetch-products")

    assert(sg_is_complete(s) == 0, "not complete")
    assert(sg_progress(s) == 0, "0% progress")

    s = sg_gather_ok(s, "t1", "100 users")
    s = sg_gather_ok(s, "t2", "50 orders")
    assert(sg_progress(s) == 66, "66% progress")

    s = sg_gather_err(s, "t3", "timeout")
    assert(sg_is_complete(s) == 1, "complete")
    assert(sg_success_count(s) == 2, "2 success")
    assert(sg_error_count(s) == 1, "1 error")

    assert(sg_result_for(s, "t1") == "100 users", "t1 result")
    assert(sg_result_for(s, "t3") == "timeout", "t3 error")

    print("SCATTER-GATHER KAT PASS")
