// Stress test for the nova_rc_free NOVA_MEM_STRUCT field-dec fix. Creates and destroys
// many structs holding HEAP fields (lists, strings, nested structs). If the fix
// over-decrements (struct doesn't truly own its fields) this surfaces as a double-free /
// use-after-free: corrupted values or a crash, because freed field memory gets reused by
// later allocations. Correct behavior = stable values + clean exit (and no leak).

type Bag
    items: list
    name: string

type Nest
    inner: Bag
    tag: string

fn make_bag(n)
    let lst = []
    let i = 0
    while i < n
        push(lst, i * 2)
        i = i + 1
    Bag(lst, "bag-" + str(n))

fn main()
    // 1) Many short-lived structs with heap fields: each `b` dies at iteration end ->
    //    struct freed -> fields dec'd. Reuses freed memory heavily.
    let total = 0
    let k = 0
    while k < 200000
        let b = make_bag(5)
        total = total + len(b.items) + len(b.name)
        k = k + 1
    print("loop1: " + str(total))     // 200000 * (5 + 5) = 2000000

    // 2) Nested structs (struct field holding a struct holding heap fields).
    let nt = 0
    let j = 0
    while j < 100000
        let inner = make_bag(3)
        let nst = Nest(inner, "n" + str(j))
        nt = nt + len(nst.inner.items) + nst.inner.items[0]
        j = j + 1
    print("loop2: " + str(nt))        // 100000 * (3 + 0) = 300000

    // 3) Structs stored in a list then the list dropped (list-of-structs ownership).
    let acc = 0
    let r = 0
    while r < 50000
        let bags = []
        push(bags, make_bag(4))
        push(bags, make_bag(6))
        acc = acc + len(bags[0].items) + len(bags[1].items)
        r = r + 1
    print("loop3: " + str(acc))       // 50000 * (4 + 6) = 500000

    print("struct_rc_test passed")
