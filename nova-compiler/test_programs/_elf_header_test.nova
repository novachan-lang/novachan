import std/os/elf_header

fn ck_bool(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL _elf_header_test " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn ck_int(label: string, got: int, want: int)
    if got != want
        print("FAIL _elf_header_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck_str(label: string, got: string, want: string)
    if got != want
        print("FAIL _elf_header_test " + label + ": got=" + got + " want=" + want)
        exit(1)

// Build a 64-bit LE x86-64 EXEC ELF header buffer
// EI_IDENT: magic(4) + class(1) + data(1) + version(1) + osabi(1) + pad(8) = 16 bytes
// e_type u16le at 16, e_machine u16le at 18
let hdr = []
push(hdr, 127)
push(hdr, 69)
push(hdr, 76)
push(hdr, 70)
push(hdr, 2)
push(hdr, 1)
push(hdr, 1)
push(hdr, 0)
push(hdr, 0)
push(hdr, 0)
push(hdr, 0)
push(hdr, 0)
push(hdr, 0)
push(hdr, 0)
push(hdr, 0)
push(hdr, 0)
push(hdr, 2)
push(hdr, 0)
push(hdr, 62)
push(hdr, 0)

ck_bool("magic_check", elf_magic_check(hdr), true)
ck_int("ei_class", elf_ei_class(hdr), 2)
ck_int("ei_data", elf_ei_data(hdr), 1)
ck_bool("is_64bit", elf_is_64bit(hdr), true)
ck_bool("is_le", elf_is_le(hdr), true)
ck_int("e_type", elf_e_type(hdr), 2)
ck_int("e_machine", elf_e_machine(hdr), 62)
ck_str("class_name", elf_class_name(hdr), "ELF64")
ck_str("machine_name", elf_machine_name(hdr), "x86-64")
ck_str("type_name", elf_type_name(hdr), "EXEC")

// Negative: wrong magic
let bad = [1, 2, 3, 4]
ck_bool("bad_magic", elf_magic_check(bad), false)

// Short buffer
let empty = []
ck_bool("empty_magic", elf_magic_check(empty), false)
ck_int("empty_class", elf_ei_class(empty), 0)

print("PASS _elf_header_test")
