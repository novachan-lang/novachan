@entity
type User
    id: int
    name: string
    email: string

@entity("orders")
type OrderItem
    id: int
    product: string
    quantity: int

fn main()
    assert(User__table_name() == "user", "User table name")
    assert(User__primary_key() == "id", "User pk")
    assert(User__columns() == "id, name, email", "User columns")

    assert(OrderItem__table_name() == "orders", "custom table name")
    assert(OrderItem__primary_key() == "id", "OrderItem pk")
    assert(OrderItem__columns() == "id, product, quantity", "OrderItem columns")

    let u = User(1, "alice", "alice@test.com")
    assert(u.name == "alice", "struct still works")

    print("ENTITY ANNOTATION TEST PASS")
