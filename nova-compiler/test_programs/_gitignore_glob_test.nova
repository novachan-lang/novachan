import std/devtool/gitignore_glob

fn main()
    // --- gig_match: star ---
    if gig_match("*", "anything") != 1
        print("FAIL gig_match-star-any")
        exit(1)
    if gig_match("*", "") != 1
        print("FAIL gig_match-star-empty")
        exit(1)
    if gig_match("*.log", "test.log") != 1
        print("FAIL gig_match-suffix-match")
        exit(1)
    if gig_match("*.log", "test.txt") != 0
        print("FAIL gig_match-suffix-nomatch")
        exit(1)

    // --- gig_match: question mark ---
    if gig_match("?oo", "foo") != 1
        print("FAIL gig_match-qmark-match")
        exit(1)
    if gig_match("?oo", "oo") != 0
        print("FAIL gig_match-qmark-short")
        exit(1)

    // --- gig_match: bracket classes ---
    if gig_match("[abc]", "a") != 1
        print("FAIL gig_match-class-in")
        exit(1)
    if gig_match("[abc]", "d") != 0
        print("FAIL gig_match-class-out")
        exit(1)
    if gig_match("[a-z]", "m") != 1
        print("FAIL gig_match-range-in")
        exit(1)
    if gig_match("[a-z]", "M") != 0
        print("FAIL gig_match-range-out")
        exit(1)
    if gig_match("[!a-z]", "M") != 1
        print("FAIL gig_match-negrange-in")
        exit(1)
    if gig_match("[!a-z]", "m") != 0
        print("FAIL gig_match-negrange-out")
        exit(1)
    if gig_match("[^a-z]", "M") != 1
        print("FAIL gig_match-caret-negrange-in")
        exit(1)

    // --- gig_match: star in middle ---
    if gig_match("foo*bar", "fooXYZbar") != 1
        print("FAIL gig_match-middle-star-match")
        exit(1)
    if gig_match("foo*bar", "fobar") != 0
        print("FAIL gig_match-middle-star-nomatch")
        exit(1)

    // --- gig_char_class direct ---
    let cls1 = gig_char_class("a", "[abc]", 1)
    if cls1[0] != 1 or cls1[1] != 5
        print("FAIL gig_char_class-basic: got " + str(cls1))
        exit(1)
    let cls2 = gig_char_class("d", "[abc]", 1)
    if cls2[0] != 0 or cls2[1] != 5
        print("FAIL gig_char_class-nomatch: got " + str(cls2))
        exit(1)
    let cls3 = gig_char_class("m", "[a-z]", 1)
    if cls3[0] != 1 or cls3[1] != 5
        print("FAIL gig_char_class-range: got " + str(cls3))
        exit(1)

    // --- gig_match_path ---
    if gig_match_path("src/*.rs", "src/main.rs") != 1
        print("FAIL gig_match_path-match")
        exit(1)
    if gig_match_path("src/*.rs", "lib/main.rs") != 0
        print("FAIL gig_match_path-dirmismatch")
        exit(1)
    if gig_match_path("src/*.rs", "deep/src/main.rs") != 0
        print("FAIL gig_match_path-segcount")
        exit(1)

    // --- gig_match_basename ---
    if gig_match_basename("*.log", "a/b/test.log") != 1
        print("FAIL gig_match_basename-match")
        exit(1)
    if gig_match_basename("*.log", "a/b/test.txt") != 0
        print("FAIL gig_match_basename-nomatch")
        exit(1)

    print("PASS _gitignore_glob_test")
