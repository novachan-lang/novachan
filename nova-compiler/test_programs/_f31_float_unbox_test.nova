// 3.1 correctness: the inline unbox fast-reject must NOT change behaviour for genuinely
// BOXED floats. A float stored in a list<any>/dict is boxed (a real heap pointer, which
// lands INSIDE the object-space reservation), so it must fall through the reject to the
// full structural check and unbox correctly. If the reject were wrong, these read back as
// astronomically large garbage (a pointer bit-pattern read as a double).
fn near(a: float, b: float) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < 0.0000001
        return 1
    0

fn takes_float(x: float) -> float
    x * 2.0

fn main()
    // boxed via a heterogeneous list
    let mixed = [1.5, "s", 2.5]
    assert(near(mixed[0], 1.5), "boxed list elem 0")
    assert(near(mixed[2], 2.5), "boxed list elem 2")
    assert(near(takes_float(mixed[0]), 3.0), "boxed -> float param")

    // boxed via a dict
    let d = {"a": 3.25, "b": 4.75}
    assert(near(d["a"], 3.25), "boxed dict a")
    assert(near(takes_float(d["b"]), 9.5), "boxed dict -> float param")

    // raw path still correct
    let r = 6.5
    assert(near(takes_float(r), 13.0), "raw -> float param")

    // round trip through any
    let anyv = 7.25
    assert(near(takes_float(anyv), 14.5), "any round trip")

    // negative and tiny values (bit patterns near zero / with the sign bit set)
    assert(near(takes_float(0.0 - 2.5), 0.0 - 5.0), "negative float")
    assert(near(takes_float(0.0), 0.0), "zero float")

    print("FLOAT-UNBOX-OK")
