// bytes_socket_test -- binary-safe TCP I/O. tcp_send_bytes sends EXACTLY b->size bytes (not strlen),
// tcp_recv_bytes returns a NovaBytes preserving embedded NULs. Proves the NUL-truncation boundary is gone
// for socket transfer -- the foundation for binary serving / uploads / streaming. Channel-synchronized
// (ready after listen), no sleep.
fn _server(port, ready)
    let srv = tcp_listen(port)
    send(ready, 1)
    let conn = tcp_accept(srv)
    let _req = tcp_recv(conn)
    // 5-byte payload WITH embedded NULs: [72, 0, 73, 0, 90]
    let payload = bytes(5)
    bytes_set(payload, 0, 72)
    bytes_set(payload, 1, 0)
    bytes_set(payload, 2, 73)
    bytes_set(payload, 3, 0)
    bytes_set(payload, 4, 90)
    let sent = tcp_send_bytes(conn, payload)
    assert(sent == 5, "server sent 5 bytes")
    tcp_close(conn)
    tcp_close(srv)

fn main()
    let port = 19210
    let ready = channel()
    spawn fn()
        _server(port, ready)
    receive(ready)
    let sock = tcp_connect("127.0.0.1", port)
    tcp_send(sock, "GET / HTTP/1.0\r\n\r\n")
    let got = tcp_recv_bytes(sock)
    tcp_close(sock)

    assert(type_name(got) == "bytes", "tcp_recv_bytes returns bytes")
    assert(bytes_len(got) == 5, "received 5 bytes incl NULs (got " + str(bytes_len(got)) + ")")
    assert(bytes_get(got, 0) == 72, "byte 0 = 72")
    assert(bytes_get(got, 1) == 0, "byte 1 = NUL preserved (would truncate as a string)")
    assert(bytes_get(got, 2) == 73, "byte 2 = 73 (survives past the NUL)")
    assert(bytes_get(got, 3) == 0, "byte 3 = NUL preserved")
    assert(bytes_get(got, 4) == 90, "byte 4 = 90")
    print("PASS: tcp_send_bytes/tcp_recv_bytes preserve embedded NULs over real TCP")
    print("bytes_socket_test passed")
