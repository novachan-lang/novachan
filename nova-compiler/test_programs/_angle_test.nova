import std/math/angle

fn ckf(label: string, got: float, expected: float)
    let diff = got - expected
    let adiff = 0.0
    if diff < 0.0
        adiff = 0.0 - diff
    else
        adiff = diff
    if adiff > 0.0001
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn main()
    // deg2rad(180.0) = pi ~ 3.14159265
    let pi_val = pi()
    let v1 = ang_deg2rad(180.0)
    ckf("deg2rad_180", v1, pi_val)

    // rad2deg(pi) = 180.0
    let v2 = ang_rad2deg(pi_val)
    ckf("rad2deg_pi", v2, 180.0)

    // normalize_deg(370.0) = 10.0
    let v3 = ang_normalize_deg(370.0)
    ckf("norm_deg_370", v3, 10.0)

    // normalize_deg(-10.0) = 350.0
    let v4 = ang_normalize_deg(-10.0)
    ckf("norm_deg_neg10", v4, 350.0)

    // normalize_deg(720.0) = 0.0
    let v5 = ang_normalize_deg(720.0)
    ckf("norm_deg_720", v5, 0.0)

    // diff_deg(10.0, 350.0) = -20.0
    let v6 = ang_diff_deg(10.0, 350.0)
    ckf("diff_deg_10_350", v6, -20.0)

    // diff_deg(350.0, 10.0) = 20.0
    let v7 = ang_diff_deg(350.0, 10.0)
    ckf("diff_deg_350_10", v7, 20.0)

    // diff_deg(0.0, 90.0) = 90.0
    let v8 = ang_diff_deg(0.0, 90.0)
    ckf("diff_deg_0_90", v8, 90.0)

    print("_angle_test passed")
