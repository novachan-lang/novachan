// KAT test for std/compress/code_unary
// PRIMARY:  round-trip for n in 1..50; sequence round-trip [3,1,4]
// SECONDARY: known bit-pattern vectors from spec
import std/compress/code_unary

// ── Helpers ───────────────────────────────────────────────────────────────────

fn _ck_int(label, got, want)
    if got != want
        print("FAIL code_unary " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn _lists_eq(a, b) -> int
    let na = len(a)
    let nb = len(b)
    if na != nb
        return 0
    let i = 0
    let ok = 1
    while i < na
        if a[i] != b[i]
            ok = 0
        i = i + 1
    ok

fn _ck_list(label, got, want)
    if _lists_eq(got, want) == 0
        print("FAIL code_unary " + label + ": lists differ")
        exit(1)

// ── KAT 1: unary_encode known bit-pattern vectors ────────────────────────────
// unary_encode(1) == [0]
// unary_encode(3) == [1, 1, 0]
// unary_encode(5) == [1, 1, 1, 1, 0]

let want1 = []
push(want1, 0)
_ck_list("encode_1", unary_encode(1), want1)

let want3 = []
push(want3, 1)
push(want3, 1)
push(want3, 0)
_ck_list("encode_3", unary_encode(3), want3)

let want5 = []
push(want5, 1)
push(want5, 1)
push(want5, 1)
push(want5, 1)
push(want5, 0)
_ck_list("encode_5", unary_encode(5), want5)

// ── KAT 2: encode length == n ────────────────────────────────────────────────
// For n in 1..10, len(unary_encode(n)) must equal n.
let i = 1
while i <= 10
    let enc = unary_encode(i)
    _ck_int("encode_len_" + str(i), len(enc), i)
    i = i + 1

// ── KAT 3: round-trip for n in 1..50 ─────────────────────────────────────────
// decode(encode(n), 0) == [n, n]  (next_pos = n because code length = n)
let j = 1
while j <= 50
    let enc2 = unary_encode(j)
    let dec2 = unary_decode(enc2, 0)
    _ck_int("rt_val_" + str(j), dec2[0], j)
    _ck_int("rt_pos_" + str(j), dec2[1], j)
    j = j + 1

// ── KAT 4: sequence round-trip [3, 1, 4] ─────────────────────────────────────
// Concatenate encode(3) ++ encode(1) ++ encode(4) into one flat list,
// then decode three values sequentially.
// encode(3)=[1,1,0] encode(1)=[0] encode(4)=[1,1,1,0]
// concatenated = [1,1,0, 0, 1,1,1,0]
let seq = []
let e3 = unary_encode(3)
let k3 = 0
while k3 < len(e3)
    push(seq, e3[k3])
    k3 = k3 + 1

let e1 = unary_encode(1)
let k1 = 0
while k1 < len(e1)
    push(seq, e1[k1])
    k1 = k1 + 1

let e4 = unary_encode(4)
let k4 = 0
while k4 < len(e4)
    push(seq, e4[k4])
    k4 = k4 + 1

// decode first: 3
let d_a = unary_decode(seq, 0)
_ck_int("seq_val_0", d_a[0], 3)
// decode second: 1
let d_b = unary_decode(seq, d_a[1])
_ck_int("seq_val_1", d_b[0], 1)
// decode third: 4
let d_c = unary_decode(seq, d_b[1])
_ck_int("seq_val_2", d_c[0], 4)
// verify we consumed the whole stream
_ck_int("seq_end_pos", d_c[1], len(seq))

// ── KAT 5: unary_encode0 known bit-pattern vectors ───────────────────────────
// unary_encode0(0) == [1]
// unary_encode0(1) == [0, 1]
// unary_encode0(3) == [0, 0, 0, 1]

let w0 = []
push(w0, 1)
_ck_list("encode0_0", unary_encode0(0), w0)

let w01 = []
push(w01, 0)
push(w01, 1)
_ck_list("encode0_1", unary_encode0(1), w01)

let w03 = []
push(w03, 0)
push(w03, 0)
push(w03, 0)
push(w03, 1)
_ck_list("encode0_3", unary_encode0(3), w03)

// ── KAT 6: unary_encode0 length == n+1 ───────────────────────────────────────
let m = 0
while m <= 10
    let enc0 = unary_encode0(m)
    _ck_int("encode0_len_" + str(m), len(enc0), m + 1)
    m = m + 1

// ── KAT 7: unary_decode0 round-trip for n in 0..49 ───────────────────────────
let p = 0
while p <= 49
    let enc0r = unary_encode0(p)
    let dec0r = unary_decode0(enc0r, 0)
    _ck_int("rt0_val_" + str(p), dec0r[0], p)
    _ck_int("rt0_pos_" + str(p), dec0r[1], p + 1)
    p = p + 1

// ── KAT 8: unary_decode with pos offset ──────────────────────────────────────
// Build [1,0, 1,1,0] = encode(2) ++ encode(3), decode from pos=2
let off = []
push(off, 1)
push(off, 0)
push(off, 1)
push(off, 1)
push(off, 0)
let d_off = unary_decode(off, 2)
_ck_int("offset_val", d_off[0], 3)
_ck_int("offset_pos", d_off[1], 5)

// ── KAT 9: malformed input — no terminator ───────────────────────────────────
// A stream of all ones with no zero terminator must return -1.
let noterm = []
push(noterm, 1)
push(noterm, 1)
push(noterm, 1)
let d_bad = unary_decode(noterm, 0)
_ck_int("bad_val", d_bad[0], -1)
_ck_int("bad_pos", d_bad[1], 3)

// ── KAT 10: malformed input unary_decode0 — no one-terminator ────────────────
let noterm0 = []
push(noterm0, 0)
push(noterm0, 0)
let d_bad0 = unary_decode0(noterm0, 0)
_ck_int("bad0_val", d_bad0[0], -1)
_ck_int("bad0_pos", d_bad0[1], 2)

print("PASS _code_unary_test")
