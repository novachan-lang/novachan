// selectx.nova — quickselect: k-th smallest, median, and percentiles in O(n) avg.
//
// Finds the k-th smallest element (or a percentile) WITHOUT fully sorting —
// O(n) average via partitioning. The basis of medians, p50/p90/p99 latency
// monitoring, and top-k selection. Operates on a copy (never mutates the input).

fn _partition(arr, lo, hi)
  let pivot = arr[hi]              // Lomuto, pivot = last element
  let i = lo - 1
  let j = lo
  while j < hi
    if arr[j] <= pivot
      i = i + 1
      let tmp = arr[i]
      arr[i] = arr[j]
      arr[j] = tmp
    j = j + 1
  let t2 = arr[i + 1]
  arr[i + 1] = arr[hi]
  arr[hi] = t2
  i + 1

// the k-th smallest (0-indexed) element of lst.
fn quickselect(lst, k)
  let arr = []
  for x in lst
    push(arr, x)
  let lo = 0
  let hi = len(arr) - 1
  while lo < hi
    let p = _partition(arr, lo, hi)
    if p == k
      lo = k
      hi = k
    else if p < k
      lo = p + 1
    else
      hi = p - 1
  arr[k]

// the median (middle element; upper-middle for even length).
fn median(lst)
  quickselect(lst, len(lst) / 2)

// the p-th percentile value (p in 0..100), nearest-rank.
fn percentile(lst, p)
  let n = len(lst)
  let idx = p * (n - 1) / 100
  quickselect(lst, idx)

// ── Tests ────────────────────────────────────────────────────────────

let data = [3, 1, 4, 1, 5, 9, 2, 6]    // sorted: 1 1 2 3 4 5 6 9
assert(quickselect(data, 0) == 1, "0th smallest = 1")
assert(quickselect(data, 7) == 9, "7th (largest) = 9")
assert(quickselect(data, 3) == 3, "3rd smallest = 3")
assert(quickselect(data, 5) == 5, "5th smallest = 5")
// input was not mutated
assert(data[0] == 3, "input list untouched (still starts with 3)")
assert(data[1] == 1, "input[1] still 1")
print("PASS: quickselect + no mutation")

assert(median([1, 2, 3, 4, 5]) == 3, "median of 1..5 = 3")
assert(median([5, 3, 8, 1, 9]) == 5, "median of 1,3,5,8,9 = 5")
assert(median([3, 1, 2]) == 2, "median of 1,2,3 = 2")
print("PASS: median")

// percentiles over 0..99 (sorted), nearest-rank
let big = []
let i = 0
while i < 100
  push(big, i)
  i = i + 1
assert(percentile(big, 0) == 0, "p0 = min = 0")
assert(percentile(big, 100) == 99, "p100 = max = 99")
assert(percentile(big, 50) == 49, "p50 ~ 49 (nearest-rank of 0..99)")
assert(percentile(big, 90) == 89, "p90 = 89")
assert(percentile(big, 99) == 98, "p99 = 98")
print("PASS: percentiles (p50/p90/p99)")

print("ALL PASS: selectx — quickselect, median, percentiles")
