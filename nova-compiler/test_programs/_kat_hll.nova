import forge_hll

fn tf(b: bool) -> string
    if b
        return "T"
    "F"

fn main()
    // add 10000 distinct items to a p=12 (m=4096) HLL; estimate within ~10%
    let h = hll_new(12)
    let i = 0
    while i < 10000
        hll_add(h, "user-" + str(i))
        i = i + 1
    let est = hll_count(h)
    print("est=" + str(est))
    print("in_band=" + tf(est >= 9000 and est <= 11000))
    // duplicates do not inflate cardinality: re-add the same 10000 -> estimate stays in band
    let j = 0
    while j < 10000
        hll_add(h, "user-" + str(j))
        j = j + 1
    let est2 = hll_count(h)
    print("dedup=" + tf(est2 >= 9000 and est2 <= 11000))
    // a fresh HLL with 500 distinct -> in a wider band (raw estimator, mid-range)
    let h2 = hll_new(12)
    let k = 0
    while k < 500
        hll_add(h2, "x" + str(k))
        k = k + 1
    let e3 = hll_count(h2)
    print("est500=" + str(e3) + " band500=" + tf(e3 >= 400 and e3 <= 600))
