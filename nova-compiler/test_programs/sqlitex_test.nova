// Self-test for the sqlitex library, exercised THROUGH `import` -- this is the regression
// guard for the modular-FFI fix (iter-74): an imported module's wrapper bodies resolve their
// extern (sqlite3_*) calls to real `call @sqlite3_` (not stray %slot). A pre-iter-74 compiler
// lowered these to slots and this round-trip would crash/garble.
import sqlitex

fn main()
    let db = sqlitex.db_open(":memory:")
    assert_eq(sqlitex.db_exec(db, "CREATE TABLE users (id INTEGER, name TEXT)"), 0)
    // Parameterized inserts -- injection-safe by construction. Row 3's name is a SQL payload.
    sqlitex.db_query(db, "INSERT INTO users VALUES (?, ?)", [1, "alice"])
    sqlitex.db_query(db, "INSERT INTO users VALUES (?, ?)", [2, "bob"])
    sqlitex.db_query(db, "INSERT INTO users VALUES (?, ?)", [3, "'; DROP TABLE users; --"])
    let r = sqlitex.db_query(db, "SELECT name FROM users WHERE id = ?", [2])
    assert_eq(len(r), 1)
    assert_eq(r[0][0], "bob")
    let all = sqlitex.db_query(db, "SELECT id, name FROM users ORDER BY id", [])
    assert_eq(len(all), 3)
    assert_eq(all[0][0], "1")
    assert_eq(all[0][1], "alice")
    // Injection payload stored as literal data (DROP not executed): table intact, read verbatim.
    assert_eq(all[2][1], "'; DROP TABLE users; --")
    let cnt = sqlitex.db_query(db, "SELECT count(*) FROM users", [])
    assert_eq(cnt[0][0], "3")
    assert_eq(sqlitex.db_close(db), 0)
    print("sqlitex_test passed: imported FFI library, ergonomic + injection-safe DB round-trip (3 rows)")
