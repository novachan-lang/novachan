import std/util/humansize

// ── check helpers ─────────────────────────────────────────────────────────────

fn cks(label: str, got: str, want: str)
    if got != want
        print("FAIL " + label + ": got [" + got + "] want [" + want + "]")
        exit(1)

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // ── hs_format: spec KAT ──────────────────────────────────────────────────
    // 0 bytes -> "0 B"
    cks("fmt_0",       hs_format(0),          "0 B")
    // 512 bytes (< 1024) -> "512 B"
    cks("fmt_512",     hs_format(512),        "512 B")
    // 1024 = exactly 1 KB
    cks("fmt_1024",    hs_format(1024),       "1.0 KB")
    // 1536 = 1.5 KB  (1536*10/1024=15; whole=1 tenths=5)
    cks("fmt_1536",    hs_format(1536),       "1.5 KB")
    // 1048576 = 1 MB  (1<<20)
    cks("fmt_1MB",     hs_format(1048576),    "1.0 MB")
    // 1073741824 = 1 GB  (1<<30)
    cks("fmt_1GB",     hs_format(1073741824), "1.0 GB")

    // ── hs_format: extra coverage ────────────────────────────────────────────
    // 1023 -> "1023 B"  (just below KB threshold)
    cks("fmt_1023",    hs_format(1023),       "1023 B")
    // 2048 = 2.0 KB
    cks("fmt_2048",    hs_format(2048),       "2.0 KB")
    // 1572864 = 1.5 MB  (1.5 * 1048576; tenths: 1572864*10/1048576=15 %10=5)
    cks("fmt_1_5MB",   hs_format(1572864),    "1.5 MB")
    // 1099511627776 = 1 TB  (1<<40)
    cks("fmt_1TB",     hs_format(1099511627776), "1.0 TB")

    // ── hs_parse: spec KAT ───────────────────────────────────────────────────
    // "1 KB" -> 1024
    cki("parse_1KB",   hs_parse("1 KB"),    1024)
    // "1.5 KB" -> 1536
    cki("parse_1_5KB", hs_parse("1.5 KB"), 1536)
    // "2 MB" -> 2097152
    cki("parse_2MB",   hs_parse("2 MB"),   2097152)
    // "512 B" -> 512
    cki("parse_512B",  hs_parse("512 B"),  512)

    // ── hs_parse: extra coverage ─────────────────────────────────────────────
    // "0 B" -> 0
    cki("parse_0B",    hs_parse("0 B"),    0)
    // "1024 B" -> 1024 (B unit uses divisor=1)
    cki("parse_1024B", hs_parse("1024 B"), 1024)
    // "1 MB" -> 1048576
    cki("parse_1MB",   hs_parse("1 MB"),   1048576)
    // "1 GB" -> 1073741824
    cki("parse_1GB",   hs_parse("1 GB"),   1073741824)
    // "1.5 MB" -> 1048576 + 5*1048576/10 = 1048576 + 524288 = 1572864
    cki("parse_1_5MB", hs_parse("1.5 MB"), 1572864)

    // ── round-trip: format then parse ────────────────────────────────────────
    cki("rt_1024",    hs_parse(hs_format(1024)),    1024)
    cki("rt_1536",    hs_parse(hs_format(1536)),    1536)
    cki("rt_1048576", hs_parse(hs_format(1048576)), 1048576)

    print("_humansize_test passed")
