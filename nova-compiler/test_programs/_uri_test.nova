// KAT for std/net/uri — RFC 3986 URI parse/build + query_parse + component codec.
import std/net/uri

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn dget(d: dict, k: string) -> string
    if contains(d, k)
        return d[k]
    ""

fn main()
    // ── full absolute URI with all components ────────────────────────────────
    let u1 = uri_parse("https://user:pw@ex.com:8443/a/b?x=1&y=2#frag")
    cks("scheme", dget(u1, "scheme"), "https")
    cks("userinfo", dget(u1, "userinfo"), "user:pw")
    cks("host", dget(u1, "host"), "ex.com")
    cks("port", dget(u1, "port"), "8443")
    cks("path", dget(u1, "path"), "/a/b")
    cks("query", dget(u1, "query"), "x=1&y=2")
    cks("fragment", dget(u1, "fragment"), "frag")

    // round-trip via uri_build
    cks("roundtrip", uri_build(u1), "https://user:pw@ex.com:8443/a/b?x=1&y=2#frag")

    // ── query_parse on the extracted query component ─────────────────────────
    let qp = query_parse(dget(u1, "query"))
    cks("qp-x", dget(qp, "x"), "1")
    cks("qp-y", dget(qp, "y"), "2")

    // ── percent-decode "%2F%20" -> "/ " ───────────────────────────────────────
    cks("decode-slash-space", uri_decode_component("%2F%20"), "/ ")
    // and the encode direction round-trips
    cks("encode-slash-space", uri_encode_component("/ "), "%2F%20")

    // ── scheme-relative URI: "//ex.com/a/b" (no scheme, no crash) ────────────
    let u2 = uri_parse("//ex.com/a/b")
    cks("sr-scheme", dget(u2, "scheme"), "")
    cks("sr-userinfo", dget(u2, "userinfo"), "")
    cks("sr-host", dget(u2, "host"), "ex.com")
    cks("sr-port", dget(u2, "port"), "")
    cks("sr-path", dget(u2, "path"), "/a/b")
    cks("sr-query", dget(u2, "query"), "")
    cks("sr-fragment", dget(u2, "fragment"), "")
    cks("sr-build", uri_build(u2), "//ex.com/a/b")

    // ── path-only URI: "/a/b?x=1" (no scheme, no authority, no crash) ────────
    let u3 = uri_parse("/a/b?x=1")
    cks("po-scheme", dget(u3, "scheme"), "")
    cks("po-host", dget(u3, "host"), "")
    cks("po-port", dget(u3, "port"), "")
    cks("po-path", dget(u3, "path"), "/a/b")
    cks("po-query", dget(u3, "query"), "x=1")
    cks("po-build", uri_build(u3), "/a/b?x=1")

    // ── empty query_parse -> empty dict, no crash on missing '=' pair ────────
    let p_empty = query_parse("")
    cks("qp-empty-lookup", dget(p_empty, "z"), "")

    let p_bare = query_parse("flag")
    cks("qp-bare", dget(p_bare, "flag"), "")

    // ── query_parse: leading '?' stripped, percent-decoded values ────────────
    let p_lead = query_parse("?q=hello%20world&n=%2B1")
    cks("qp-lead-q", dget(p_lead, "q"), "hello world")
    cks("qp-lead-n", dget(p_lead, "n"), "+1")

    // ── minimal URI: scheme + host only ───────────────────────────────────────
    let u4 = uri_parse("http://h")
    cks("min-scheme", dget(u4, "scheme"), "http")
    cks("min-host", dget(u4, "host"), "h")
    cks("min-path", dget(u4, "path"), "")
    cks("min-build", uri_build(u4), "http://h")

    // ── IPv6 host literal keeps brackets, port split correctly ───────────────
    let u5 = uri_parse("https://[::1]:9443/x")
    cks("ipv6-host", dget(u5, "host"), "[::1]")
    cks("ipv6-port", dget(u5, "port"), "9443")
    cks("ipv6-path", dget(u5, "path"), "/x")

    // ── FIX: authority PRESENT-but-EMPTY must round-trip ("file:///path") ────
    // Before the fix, uri_build only emitted "//" when host/userinfo were
    // non-empty, so a triple-slash authority silently collapsed to "file:/path".
    let u6 = uri_parse("file:///etc/hosts")
    cks("triple-slash-scheme", dget(u6, "scheme"), "file")
    cks("triple-slash-host", dget(u6, "host"), "")
    cks("triple-slash-authpresent", dget(u6, "authority_present"), "1")
    cks("triple-slash-path", dget(u6, "path"), "/etc/hosts")
    cks("triple-slash-roundtrip", uri_build(u6), "file:///etc/hosts")

    // ── FIX: scheme-relative authority still round-trips (host non-empty case) ──
    let u7 = uri_parse("//example.com/p")
    cks("schemerel-authpresent", dget(u7, "authority_present"), "1")
    cks("schemerel-host", dget(u7, "host"), "example.com")
    cks("schemerel-roundtrip", uri_build(u7), "//example.com/p")

    // ── FIX regression guard: a normal full authority still round-trips ──────
    let u8 = uri_parse("https://user:pw@ex.com:8443/a/b?x=1&y=2#frag")
    cks("normal-authpresent", dget(u8, "authority_present"), "1")
    cks("normal-roundtrip", uri_build(u8), "https://user:pw@ex.com:8443/a/b?x=1&y=2#frag")

    // ── FIX: path-only reference (no authority at all) still has no "//" ────
    let u9 = uri_parse("/a/b?x=1")
    cks("pathonly-authpresent", dget(u9, "authority_present"), "")
    cks("pathonly-roundtrip", uri_build(u9), "/a/b?x=1")

    print("_uri_test passed")
