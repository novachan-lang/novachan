import forge_countmin

fn ck(label: string, got: int, want: int)
    let ok = "FAIL"
    if got == want
        ok = "ok"
    print(label + "=" + ok + "(" + str(got) + ")")
fn ge(label: string, got: int, floor: int)
    let ok = "FAIL"
    if got >= floor
        ok = "ok"
    print(label + "=" + ok + "(" + str(got) + ")")

fn main()
    let c = cms_new(1000, 4)
    cms_add(c, "apple", 5)
    cms_add(c, "banana", 3)
    cms_add(c, "cherry", 1)
    // wide sketch -> exact for a few items
    ck("apple", cms_estimate(c, "apple"), 5)
    ck("banana", cms_estimate(c, "banana"), 3)
    ck("cherry", cms_estimate(c, "cherry"), 1)
    ck("absent", cms_estimate(c, "durian"), 0)
    // never under-counts
    ge("apple_floor", cms_estimate(c, "apple"), 5)
    // accumulate more
    cms_add(c, "apple", 10)
    ck("apple2", cms_estimate(c, "apple"), 15)
    // heavy-hitter: 1000 distinct low-freq + one heavy
    let big = cms_new(2000, 5)
    cms_add(big, "HOT", 500)
    let i = 0
    while i < 300
        cms_add(big, "cold" + str(i), 1)
        i = i + 1
    ge("hot_heavy", cms_estimate(big, "HOT"), 500)
