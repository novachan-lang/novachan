// KAT test for std/game/maze_eller
// Structural validation: edge_count == w*h-1, fully connected, deterministic.
//
// KAT assertions:
//   gen(6,6,42)  -> edge_count==35 and connected (36 cells)
//   gen(4,4,5)   -> edge_count==15 and connected (16 cells)
//   gen(5,3,2)   -> edge_count==14 and connected (15 cells)
//   determinism: gen(6,6,42) called twice is identical

import std/game/maze_eller

// ── helpers ──────────────────────────────────────────────────────────────────

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL maze_eller " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// edge_count: sum of len(links[c]) for all c, divided by 2.
fn _edge_count(links: list) -> int
    let total = len(links)
    let s = 0
    let i = 0
    while i < total
        s = s + len(links[i])
        i = i + 1
    s / 2

// _bfs_visited: BFS from cell 0; returns number of distinct cells visited.
fn _bfs_visited(links: list) -> int
    let total = len(links)
    let vis = []
    let vi = 0
    while vi < total
        vis = vis + [0]
        vi = vi + 1
    let q = [0]
    vis[0] = 1
    let head = 0
    let count = 1
    let iters = 0
    let maxiters = total * total
    while head < len(q) and iters < maxiters
        let cur = q[head]
        head = head + 1
        let nb = links[cur]
        let nlen = len(nb)
        let ni = 0
        while ni < nlen
            let nc = nb[ni]
            if vis[nc] == 0
                vis[nc] = 1
                push(q, nc)
                count = count + 1
            ni = ni + 1
        iters = iters + 1
    count

// _sort_small: insertion sort on a small list of ints (returns a new sorted list).
fn _sort_small(xs: list) -> list
    let n = len(xs)
    let buf = []
    let ii = 0
    while ii < n
        buf = buf + [xs[ii]]
        ii = ii + 1
    let oi = 0
    while oi < n
        let ij = oi + 1
        while ij < n
            if buf[oi] > buf[ij]
                let tmp = buf[oi]
                buf[oi] = buf[ij]
                buf[ij] = tmp
            ij = ij + 1
        oi = oi + 1
    buf

// _links_equal: check two adjacency-list mazes are identical (order-insensitive).
fn _links_equal(a: list, b: list) -> int
    if len(a) != len(b)
        return 0
    let n = len(a)
    let i = 0
    while i < n
        let sa = _sort_small(a[i])
        let sb = _sort_small(b[i])
        if len(sa) != len(sb)
            return 0
        let j = 0
        while j < len(sa)
            if sa[j] != sb[j]
                return 0
            j = j + 1
        i = i + 1
    1

// ── KAT 1: gen(6,6,42) -> edge_count==35 and connected ──────────────────────
let links66 = gen(6, 6, 42)
let ec66 = _edge_count(links66)
cki("kat1_6x6_edge_count", ec66, 35)
let vis66 = _bfs_visited(links66)
cki("kat1_6x6_connected", vis66, 36)

// ── KAT 2: gen(4,4,5) -> edge_count==15 and connected ───────────────────────
let links44 = gen(4, 4, 5)
let ec44 = _edge_count(links44)
cki("kat2_4x4_edge_count", ec44, 15)
let vis44 = _bfs_visited(links44)
cki("kat2_4x4_connected", vis44, 16)

// ── KAT 3: gen(5,3,2) -> edge_count==14 and connected ───────────────────────
let links53 = gen(5, 3, 2)
let ec53 = _edge_count(links53)
cki("kat3_5x3_edge_count", ec53, 14)
let vis53 = _bfs_visited(links53)
cki("kat3_5x3_connected", vis53, 15)

// ── KAT 4: determinism -- gen(6,6,42) called twice is identical ──────────────
let links66b = gen(6, 6, 42)
let det_ok = _links_equal(links66, links66b)
cki("kat4_determinism_6x6", det_ok, 1)

// ── KAT 5: determinism -- gen(4,4,5) called twice is identical ───────────────
let links44b = gen(4, 4, 5)
let det44_ok = _links_equal(links44, links44b)
cki("kat5_determinism_4x4", det44_ok, 1)

print("PASS _maze_eller_test")
