import forge_barycentric

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn expect_false(name: string, cond: bool) -> int
    if cond
        print("FAIL " + name + ": expected false")
        return 1
    0

fn near(a: float, b: float) -> bool
    let d = a - b
    d > -0.001 and d < 0.001

fn main()
    let fails = 0
    let a = [0.0, 0.0]
    let b = [4.0, 0.0]
    let c = [0.0, 4.0]

    // vertex a -> [1,0,0]
    let ba = barycentric(a, a, b, c)
    fails = fails + expect_true("vertex_a", near(ba[0], 1.0) and near(ba[1], 0.0) and near(ba[2], 0.0))
    // vertex b -> [0,1,0]
    let bb = barycentric(b, a, b, c)
    fails = fails + expect_true("vertex_b", near(bb[1], 1.0))
    // centroid -> [1/3,1/3,1/3]
    let cen = barycentric([1.33333, 1.33333], a, b, c)
    fails = fails + expect_true("centroid", near(cen[0], 0.33333) and near(cen[1], 0.33333) and near(cen[2], 0.33333))
    // weights sum to 1
    let mid = barycentric([1.0, 1.0], a, b, c)
    fails = fails + expect_true("sum_to_1", near(mid[0] + mid[1] + mid[2], 1.0))

    // point_in_triangle
    fails = fails + expect_true("inside", point_in_triangle([1.0, 1.0], a, b, c))
    fails = fails + expect_true("on_edge", point_in_triangle([2.0, 0.0], a, b, c))
    fails = fails + expect_true("on_vertex", point_in_triangle([0.0, 0.0], a, b, c))
    fails = fails + expect_false("outside", point_in_triangle([5.0, 5.0], a, b, c))
    fails = fails + expect_false("outside2", point_in_triangle([3.0, 3.0], a, b, c))
    fails = fails + expect_false("outside_neg", point_in_triangle([0 - 1.0, 1.0], a, b, c))

    // triangle area (base 4, height 4 -> 8)
    fails = fails + expect_true("area", near(triangle_area(a, b, c), 8.0))
    // degenerate (collinear) -> 0 area
    fails = fails + expect_true("degenerate_area", near(triangle_area([0.0, 0.0], [1.0, 1.0], [2.0, 2.0]), 0.0))

    // interpolation: values 0 at a, 10 at b, 20 at c; centroid -> (0+10+20)/3 = 10
    fails = fails + expect_true("interp_centroid", near(bary_interpolate([1.33333, 1.33333], a, b, c, 0.0, 10.0, 20.0), 10.0))
    // at vertex b -> exactly vb (10)
    fails = fails + expect_true("interp_vertex", near(bary_interpolate(b, a, b, c, 0.0, 10.0, 20.0), 10.0))

    if fails == 0
        print("forge_barycentric: all passed")
    else
        print("forge_barycentric: " + str(fails) + " FAILED")
