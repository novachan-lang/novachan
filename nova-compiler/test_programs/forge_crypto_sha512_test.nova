// Forge crypto: SHA-512 / SHA-384, gated against the FIPS 180-4 "abc" KATs + an empty-string vector.
import forge_crypto

fn main()
    if sha512_hex("abc") != "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f"
        print("FAIL: SHA-512 abc -> " + sha512_hex("abc"))
        exit(1)

    if sha512_hex("") != "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e"
        print("FAIL: SHA-512 empty -> " + sha512_hex(""))
        exit(1)

    if sha384_hex("abc") != "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7"
        print("FAIL: SHA-384 abc -> " + sha384_hex("abc"))
        exit(1)

    print("PASS forge_crypto_sha512 (FIPS 180-4 SHA-512 + SHA-384 KATs)")
