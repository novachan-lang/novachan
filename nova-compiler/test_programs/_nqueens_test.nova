import std/game/nqueens

fn assert_int(label: string, got: int, want: int)
    if got != want
        print("FAIL nqueens " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn assert_bool(label: string, got: bool, want: bool)
    let gs = "false"
    if got
        gs = "true"
    let ws = "false"
    if want
        ws = "true"
    if gs != ws
        print("FAIL nqueens " + label + ": got " + gs + " want " + ws)
        exit(1)

// Verify a solution: n queens, no two attack each other.
fn _verify_solution(cols, n)
    if len(cols) != n
        return false
    let ok = true
    let r1 = 0
    while r1 < n and ok
        let c1 = cols[r1]
        if c1 < 0 or c1 >= n
            ok = false
        let r2 = r1 + 1
        while r2 < n and ok
            let c2 = cols[r2]
            if c1 == c2
                ok = false
            let diff = r2 - r1
            if c1 == c2 + diff or c1 == c2 - diff
                ok = false
            r2 = r2 + 1
        r1 = r1 + 1
    ok

fn main()
    // nqueens_count(1) == 1
    let c1 = nqueens_count(1)
    assert_int("count_1", c1, 1)

    // nqueens_count(4) == 2
    let c4 = nqueens_count(4)
    assert_int("count_4", c4, 2)

    // nqueens_count(8) == 92
    let c8 = nqueens_count(8)
    assert_int("count_8", c8, 92)

    // nqueens_first(8) has length 8 and is valid
    let f8 = nqueens_first(8)
    let flen = len(f8)
    assert_int("first_8_len", flen, 8)
    let fvalid = _verify_solution(f8, 8)
    assert_bool("first_8_valid", fvalid, true)

    // nqueens_first(1) has length 1
    let f1 = nqueens_first(1)
    let f1len = len(f1)
    assert_int("first_1_len", f1len, 1)

    // nqueens_first(0) returns []
    let f0 = nqueens_first(0)
    let f0len = len(f0)
    assert_int("first_0_len", f0len, 0)

    // nqueens_count(0) == 0
    let c0 = nqueens_count(0)
    assert_int("count_0", c0, 0)

    print("PASS _nqueens_test")
