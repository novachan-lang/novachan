import std/media/id3

// cki: assert integer equality, exit(1) on mismatch.
fn cki(label, got, want)
    if got != want
        print("FAIL id3 " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// cks: assert string equality, exit(1) on mismatch.
fn cks(label, got, want)
    if got != want
        print("FAIL id3 " + label + ": got=" + got + " want=" + want)
        exit(1)

// ckb: assert boolean equality, exit(1) on mismatch.
fn ckb(label, got, want)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL id3 " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn main()
    // Build a minimal ID3v2 header buffer:
    // 73,68,51 = 'ID3'
    // 3 = major version
    // 0 = revision
    // 0 = flags (no unsync, no ext, no experimental, no footer)
    // syncsafe size bytes: 0,0,2,1 = (2<<7)+1 = 256+1 = 257
    let buf = []
    push(buf, 73)
    push(buf, 68)
    push(buf, 51)
    push(buf, 3)
    push(buf, 0)
    push(buf, 0)
    push(buf, 0)
    push(buf, 0)
    push(buf, 2)
    push(buf, 1)

    // KAT 1: magic check
    ckb("magic_check", id3v2_magic_check(buf), true)

    // KAT 2: major version
    cki("major", id3v2_major(buf), 3)

    // KAT 3: revision
    cki("revision", id3v2_revision(buf), 0)

    // KAT 4: flags
    cki("flags", id3v2_flags(buf), 0)

    // KAT 5: individual flag bits (all false since flags=0)
    ckb("flag_unsync", id3v2_flag_unsync(buf), false)
    ckb("flag_ext", id3v2_flag_ext(buf), false)
    ckb("flag_experimental", id3v2_flag_experimental(buf), false)
    ckb("flag_footer", id3v2_flag_footer(buf), false)

    // KAT 6: syncsafe decoding
    // (0,0,2,1): (0<<21)+(0<<14)+(2<<7)+1 = 256+1 = 257
    cki("syncsafe_0_0_2_1", id3v2_syncsafe(0, 0, 2, 1), 257)

    // KAT 7: size from buffer
    cki("size", id3v2_size(buf), 257)

    // KAT 8: total size = 10 + 257 = 267
    cki("total_size", id3v2_total_size(buf), 267)

    // KAT 9: version name
    cks("version_name", id3v2_version_name(buf), "ID3v2.3")

    // KAT 10: additional syncsafe vectors
    cki("syncsafe_0_0_0_10", id3v2_syncsafe(0, 0, 0, 10), 10)
    cki("syncsafe_0_1_0_0", id3v2_syncsafe(0, 1, 0, 0), 16384)

    // KAT 11: larger syncsafe (max value: all bytes 0x7F)
    // (127<<21) + (127<<14) + (127<<7) + 127 = 268435456-1 would be 268435455
    // (0x7F<<21)=267386880, (0x7F<<14)=2080768, (0x7F<<7)=16256, 127=127
    // sum = 267386880 + 2080768 + 16256 + 127 = 269484031
    cki("syncsafe_max", id3v2_syncsafe(127, 127, 127, 127), 268435455)

    // KAT 12: flag bits (build a buf with all flags set = 0xF0 = 240)
    let fbuf = []
    push(fbuf, 73)
    push(fbuf, 68)
    push(fbuf, 51)
    push(fbuf, 4)
    push(fbuf, 0)
    push(fbuf, 240)
    push(fbuf, 0)
    push(fbuf, 0)
    push(fbuf, 0)
    push(fbuf, 0)
    ckb("flag_unsync_set", id3v2_flag_unsync(fbuf), true)
    ckb("flag_ext_set", id3v2_flag_ext(fbuf), true)
    ckb("flag_experimental_set", id3v2_flag_experimental(fbuf), true)
    ckb("flag_footer_set", id3v2_flag_footer(fbuf), true)
    cks("version4", id3v2_version_name(fbuf), "ID3v2.4")

    // KAT 13: ID3v1 check -- needs 128-byte buffer with 'TAG' at offset 0 (len=128)
    let v1buf = []
    push(v1buf, 84)
    push(v1buf, 65)
    push(v1buf, 71)
    let i = 3
    while i < 128
        push(v1buf, 0)
        i = i + 1
    ckb("id3v1_check", id3v1_check(v1buf), true)

    // KAT 14: ID3v1 check fails on short buffer
    let shortbuf = []
    push(shortbuf, 84)
    push(shortbuf, 65)
    push(shortbuf, 71)
    ckb("id3v1_short", id3v1_check(shortbuf), false)

    // KAT 15: ID3v1 check with 'TAG' NOT at offset len-128 (wrong bytes)
    let v1bad = []
    let j = 0
    while j < 128
        push(v1bad, 0)
        j = j + 1
    ckb("id3v1_bad", id3v1_check(v1bad), false)

    // KAT 16: bad magic
    let badbuf = []
    push(badbuf, 0)
    push(badbuf, 1)
    push(badbuf, 2)
    ckb("bad_magic", id3v2_magic_check(badbuf), false)

    print("PASS _id3_test")
