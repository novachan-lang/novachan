import std/typesystem/type_pretty

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _type_pretty_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL _type_pretty_test " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL _type_pretty_test " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // ── Spec KAT: print tests ──

    // a -> b  (simple arrow, no parens needed)
    cks("print arr(0,1)", tpp_print(tyc_arr(tyc_tvar(0), tyc_tvar(1))), "a -> b")

    // (a -> b) -> a  (left arg of arrow is itself an arrow => wrap in parens)
    cks("print arr(arr(0,1),0)", tpp_print(tyc_arr(tyc_arr(tyc_tvar(0), tyc_tvar(1)), tyc_tvar(0))), "(a -> b) -> a")

    // a -> b -> a  (right-assoc, no extra parens; same as arr(a,arr(b,a)))
    cks("print arr(0,arr(1,0))", tpp_print(tyc_arr(tyc_tvar(0), tyc_arr(tyc_tvar(1), tyc_tvar(0)))), "a -> b -> a")

    // "int"
    cks("print int", tpp_print(tyc_int()), "int")

    // ── Additional print tests ──
    cks("print bool", tpp_print(tyc_bool()), "bool")
    cks("print tvar(0)", tpp_print(tyc_tvar(0)), "a")
    cks("print tvar(1)", tpp_print(tyc_tvar(1)), "b")
    cks("print tvar(25)", tpp_print(tyc_tvar(25)), "z")
    cks("print list(int)", tpp_print(tyc_list(tyc_int())), "list int")
    cks("print list(tvar0)", tpp_print(tyc_list(tyc_tvar(0))), "list a")
    cks("print pair(int,bool)", tpp_print(tyc_pair(tyc_int(), tyc_bool())), "pair int bool")
    // pair with tvar args
    cks("print pair(a,b)", tpp_print(tyc_pair(tyc_tvar(0), tyc_tvar(1))), "pair a b")
    // list of arrow type: needs parens around the arrow arg
    cks("print list(arr(a,b))", tpp_print(tyc_list(tyc_arr(tyc_tvar(0), tyc_tvar(1)))), "list (a -> b)")
    // pair with list arg: list has 1 arg so is "multi_con" => needs parens
    cks("print pair(list a,int)", tpp_print(tyc_pair(tyc_list(tyc_tvar(0)), tyc_int())), "pair (list a) int")

    // ── Spec KAT: round-trip test ──
    // tpp_parse("a -> b -> a") then tpp_print must equal "a -> b -> a"
    let rt = tpp_parse("a -> b -> a")
    cks("roundtrip a->b->a", tpp_print(rt), "a -> b -> a")

    // ── Additional parse + round-trip ──
    let p1 = tpp_parse("int")
    cks("parse int", tpp_print(p1), "int")

    let p2 = tpp_parse("bool")
    cks("parse bool", tpp_print(p2), "bool")

    let p3 = tpp_parse("a -> b")
    cks("parse a->b", tpp_print(p3), "a -> b")

    // (a -> b) -> a
    let p4 = tpp_parse("(a -> b) -> a")
    cks("parse (a->b)->a", tpp_print(p4), "(a -> b) -> a")

    // parse "a" => tvar(0)
    let p5 = tpp_parse("a")
    cks("parse a", tpp_print(p5), "a")

    // parse "list a"
    let p6 = tpp_parse("list a")
    cks("parse list a", tpp_print(p6), "list a")

    // parse "pair a b"
    let p7 = tpp_parse("pair a b")
    cks("parse pair a b", tpp_print(p7), "pair a b")

    // parse "list int"
    let p8 = tpp_parse("list int")
    cks("parse list int", tpp_print(p8), "list int")

    // deep: a -> (a -> b) -> b  (note right-assoc so no parens on right)
    let p9 = tpp_parse("a -> (a -> b) -> b")
    cks("parse deep", tpp_print(p9), "a -> (a -> b) -> b")

    print("PASS _type_pretty_test")
