// KAT for std/compress/code_exp_golomb
// PRIMARY:  round-trip for k in {0,1,2} and n 0..100; sequence round-trip.
// SECONDARY: known bit-pattern vectors (order-0 spec examples from H.264).

import std/compress/code_exp_golomb

// ── helpers ───────────────────────────────────────────────────────────────────

fn _lists_eq(a, b) -> int
    if len(a) != len(b)
        return 0
    let i = 0
    while i < len(a)
        if a[i] != b[i]
            return 0
        i = i + 1
    1

fn _list_to_str(lst) -> str
    let s = "["
    let i = 0
    while i < len(lst)
        if i > 0
            s = s + ","
        s = s + str(lst[i])
        i = i + 1
    s = s + "]"
    s

// ── SECONDARY: known bit-pattern vectors (order k=0) ─────────────────────────

fn _kat_known_vectors()
    // expgolomb_encode(0,0) == [1]
    let got0 = expgolomb_encode(0, 0)
    let want0 = [1]
    if _lists_eq(got0, want0) == 0
        print("FAIL code_exp_golomb encode(0,0): got " + _list_to_str(got0) + " want [1]")
        exit(1)

    // expgolomb_encode(1,0) == [0,1,0]
    let got1 = expgolomb_encode(1, 0)
    let want1 = [0, 1, 0]
    if _lists_eq(got1, want1) == 0
        print("FAIL code_exp_golomb encode(1,0): got " + _list_to_str(got1) + " want [0,1,0]")
        exit(1)

    // expgolomb_encode(2,0) == [0,1,1]
    let got2 = expgolomb_encode(2, 0)
    let want2 = [0, 1, 1]
    if _lists_eq(got2, want2) == 0
        print("FAIL code_exp_golomb encode(2,0): got " + _list_to_str(got2) + " want [0,1,1]")
        exit(1)

    // expgolomb_encode(3,0) == [0,0,1,0,0]
    let got3 = expgolomb_encode(3, 0)
    let want3 = [0, 0, 1, 0, 0]
    if _lists_eq(got3, want3) == 0
        print("FAIL code_exp_golomb encode(3,0): got " + _list_to_str(got3) + " want [0,0,1,0,0]")
        exit(1)

    // expgolomb_encode(4,0) == [0,0,1,0,1]
    let got4 = expgolomb_encode(4, 0)
    let want4 = [0, 0, 1, 0, 1]
    if _lists_eq(got4, want4) == 0
        print("FAIL code_exp_golomb encode(4,0): got " + _list_to_str(got4) + " want [0,0,1,0,1]")
        exit(1)

    // expgolomb_encode(6,0) == [0,0,1,1,1]
    let got6 = expgolomb_encode(6, 0)
    let want6 = [0, 0, 1, 1, 1]
    if _lists_eq(got6, want6) == 0
        print("FAIL code_exp_golomb encode(6,0): got " + _list_to_str(got6) + " want [0,0,1,1,1]")
        exit(1)

    // expgolomb_encode(7,0) == [0,0,0,1,0,0,0]
    let got7 = expgolomb_encode(7, 0)
    let want7 = [0, 0, 0, 1, 0, 0, 0]
    if _lists_eq(got7, want7) == 0
        print("FAIL code_exp_golomb encode(7,0): got " + _list_to_str(got7) + " want [0,0,0,1,0,0,0]")
        exit(1)

    // k=1 vectors: encode(0,1)=[1,0], encode(1,1)=[1,1], encode(2,1)=[0,1,0,0], encode(3,1)=[0,1,0,1]
    let gk1n0 = expgolomb_encode(0, 1)
    let wk1n0 = [1, 0]
    if _lists_eq(gk1n0, wk1n0) == 0
        print("FAIL code_exp_golomb encode(0,1): got " + _list_to_str(gk1n0) + " want [1,0]")
        exit(1)

    let gk1n1 = expgolomb_encode(1, 1)
    let wk1n1 = [1, 1]
    if _lists_eq(gk1n1, wk1n1) == 0
        print("FAIL code_exp_golomb encode(1,1): got " + _list_to_str(gk1n1) + " want [1,1]")
        exit(1)

    let gk1n2 = expgolomb_encode(2, 1)
    let wk1n2 = [0, 1, 0, 0]
    if _lists_eq(gk1n2, wk1n2) == 0
        print("FAIL code_exp_golomb encode(2,1): got " + _list_to_str(gk1n2) + " want [0,1,0,0]")
        exit(1)

    let gk1n3 = expgolomb_encode(3, 1)
    let wk1n3 = [0, 1, 0, 1]
    if _lists_eq(gk1n3, wk1n3) == 0
        print("FAIL code_exp_golomb encode(3,1): got " + _list_to_str(gk1n3) + " want [0,1,0,1]")
        exit(1)

// ── PRIMARY: round-trip for each k in {0,1,2}, n=0..100 ─────────────────────

fn _kat_roundtrip_single(k)
    let n = 0
    while n <= 100
        let bits = expgolomb_encode(n, k)
        let dr = expgolomb_decode(bits, 0, k)
        let got_n = dr[0]
        let got_pos = dr[1]
        let expected_len = len(bits)
        if got_n != n
            print("FAIL code_exp_golomb roundtrip k=" + str(k) + " n=" + str(n) + ": decoded=" + str(got_n))
            exit(1)
        if got_pos != expected_len
            print("FAIL code_exp_golomb roundtrip k=" + str(k) + " n=" + str(n) + ": next_pos=" + str(got_pos) + " want=" + str(expected_len))
            exit(1)
        n = n + 1

// ── PRIMARY: sequence round-trip ──────────────────────────────────────────────

fn _kat_seq_roundtrip(k)
    // Build a sequence: [0,1,2,...,30]
    let ns = []
    let i = 0
    while i <= 30
        push(ns, i)
        i = i + 1
    let stream = expgolomb_encode_seq(ns, k)
    let decoded = expgolomb_decode_seq(stream, 0, k, 31)
    let ok = _lists_eq(ns, decoded)
    if ok == 0
        print("FAIL code_exp_golomb seq_roundtrip k=" + str(k) + ": got " + _list_to_str(decoded))
        exit(1)

// ── decode at offset (concatenation correctness) ─────────────────────────────

fn _kat_offset_decode()
    // Concatenate encode(5,0) ++ encode(3,0) and decode both sequentially
    let b5 = expgolomb_encode(5, 0)
    let b3 = expgolomb_encode(3, 0)
    let stream = []
    let i = 0
    while i < len(b5)
        push(stream, b5[i])
        i = i + 1
    let j = 0
    while j < len(b3)
        push(stream, b3[j])
        j = j + 1
    let dr1 = expgolomb_decode(stream, 0, 0)
    if dr1[0] != 5
        print("FAIL code_exp_golomb offset: first value got " + str(dr1[0]) + " want 5")
        exit(1)
    let dr2 = expgolomb_decode(stream, dr1[1], 0)
    if dr2[0] != 3
        print("FAIL code_exp_golomb offset: second value got " + str(dr2[0]) + " want 3")
        exit(1)
    if dr2[1] != len(stream)
        print("FAIL code_exp_golomb offset: final pos got " + str(dr2[1]) + " want " + str(len(stream)))
        exit(1)

// ── pack_bits spot-check ──────────────────────────────────────────────────────

fn _kat_pack_bits()
    // pack_bits([1,0,1,1,0,0,1,0]) -> [178]  (0xB2 = 10110010)
    let bits = [1, 0, 1, 1, 0, 0, 1, 0]
    let packed = expgolomb_pack_bits(bits)
    if len(packed) != 1
        print("FAIL code_exp_golomb pack_bits: length " + str(len(packed)) + " want 1")
        exit(1)
    if packed[0] != 178
        print("FAIL code_exp_golomb pack_bits: value " + str(packed[0]) + " want 178")
        exit(1)
    // pack_bits([1,0,1]) -> [160]  (10100000 = 0xA0 = 160)
    let bits2 = [1, 0, 1]
    let packed2 = expgolomb_pack_bits(bits2)
    if packed2[0] != 160
        print("FAIL code_exp_golomb pack_bits3: value " + str(packed2[0]) + " want 160")
        exit(1)

// ── main ──────────────────────────────────────────────────────────────────────

_kat_known_vectors()
_kat_roundtrip_single(0)
_kat_roundtrip_single(1)
_kat_roundtrip_single(2)
_kat_seq_roundtrip(0)
_kat_seq_roundtrip(1)
_kat_seq_roundtrip(2)
_kat_offset_decode()
_kat_pack_bits()
print("PASS _code_exp_golomb_test")
