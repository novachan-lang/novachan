import forge_checkpoint_store

fn main()
    let c = cps_new()
    c = cps_save(c, "job-1", 500, "processing")
    assert(cps_count(c) == 1, "1 checkpoint")
    assert(cps_has(c, "job-1") == 1, "has job-1")

    let r1 = cps_restore(c, "job-1")
    c = r1["c"]
    assert(r1["found"] == 1, "found")
    assert(r1["offset"] == 500, "offset 500")
    assert(r1["state"] == "processing", "state=processing")

    c = cps_save(c, "job-1", 1000, "done")
    let r2 = cps_restore(c, "job-1")
    c = r2["c"]
    assert(r2["offset"] == 1000, "updated offset")
    assert(r2["state"] == "done", "updated state")

    let r3 = cps_restore(c, "job-99")
    c = r3["c"]
    assert(r3["found"] == 0, "not found")

    assert(cps_total_restores(c) == 2, "2 restores")

    c = cps_delete(c, "job-1")
    assert(cps_has(c, "job-1") == 0, "deleted")

    print("CHECKPOINT-STORE KAT PASS")
