// forge_hub_test -- the pub/sub hub (spine of WS broadcast), proven over channels alone (no sockets).
// A hub daemon task owns the subscriber registry; subscribers register channels (channel-of-channels) and
// receive every published message. Verifies fan-out to N subscribers + that unsub removes one from the set.
import forge

fn main()
    let h = forge.hub()
    let a = channel()
    let b = channel()
    let c = channel()
    forge.hub_sub(h, 1, a)
    forge.hub_sub(h, 2, b)
    forge.hub_sub(h, 3, c)
    sleep(50)

    // (1) one publish fans out to all three subscribers
    forge.hub_pub(h, "broadcast-1")
    assert(recv(a) == "broadcast-1", "subscriber 1 received the broadcast")
    assert(recv(b) == "broadcast-1", "subscriber 2 received the broadcast")
    assert(recv(c) == "broadcast-1", "subscriber 3 received the broadcast")
    print("PASS: one publish fanned out to all 3 subscribers")

    // (2) unsubscribe #2; the next publish reaches 1 and 3 but NOT 2
    forge.hub_unsub(h, 2)
    sleep(50)
    forge.hub_pub(h, "broadcast-2")
    assert(recv(a) == "broadcast-2", "subscriber 1 still receives after #2 unsubscribed")
    assert(recv(c) == "broadcast-2", "subscriber 3 still receives after #2 unsubscribed")
    let t = try_recv(b)
    assert(t[0] == 0, "unsubscribed subscriber 2 received nothing")
    print("PASS: unsubscribe removes a subscriber from the fan-out set")

    forge.hub_stop(h)
    print("forge_hub_test passed")
