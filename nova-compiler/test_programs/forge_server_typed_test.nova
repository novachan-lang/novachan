// Forge T4.7+T4.8+T4.9: a GenServer with TYPE-dispatched handling + threaded state. ONE handler
// MATCHES on the message (Erlang handle_call shape) -> dispatch by message type, race-free state
// (the actor loop serializes every call). Socketless (spawn/channel) -> kill-on-timeout safe.
import forge_otp

type AddItem
    n: int
type GetCount
    z: int

// handler: fn(state, msg) -> [new_state, reply]. match dispatches on the message's runtime type.
fn counter_handle(state, msg)
    match msg
        AddItem(n) =>
            [state + n, state + n]
        GetCount(z) =>
            [state, state]

fn main()
    let srv = server(0, counter_handle)
    gen_start(srv)
    let r1 = call(srv, AddItem(5))     // 0 -> 5, reply 5
    let r2 = call(srv, AddItem(3))     // 5 -> 8, reply 8
    let r3 = call(srv, GetCount(0))    // reply 8 (unchanged)
    if r1 != 5 or r2 != 8 or r3 != 8
        print("FAIL: expected 5,8,8 got " + str(r1) + "," + str(r2) + "," + str(r3))
        exit(1)
    print("PASS forge_server (match-dispatch AddItem/GetCount + threaded state: 5, 8, 8)")
