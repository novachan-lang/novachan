// Bootstrap test 15: complex program similar to compiler patterns
// Dict-based symbol table, struct walking, recursive processing

type Node
    kind: string
    value: string
    children: list

fn make_leaf(kind: string, value: string) -> Node
    return Node(kind, value, [])

fn make_node(kind: string, children: list) -> Node
    return Node(kind, "", children)

fn node_to_str(n: Node) -> string
    match n
        Node(k, v, ch) =>
            if len(ch) == 0
                return k + "(" + v + ")"
            let parts = k + "["
            let i = 0
            while i < len(ch)
                if i > 0
                    parts = parts + ", "
                parts = parts + node_to_str(ch[i])
                i = i + 1
            return parts + "]"
    return "?"

let tree = make_node("add", [make_leaf("int", "3"), make_leaf("int", "4")])
print(node_to_str(tree))

// Symbol table
let syms = {}
syms["x"] = "int"
syms["y"] = "string"
syms["z"] = "bool"

fn lookup(table, name)
    if contains(table, name)
        return table[name]
    return "unknown"

print(lookup(syms, "x"))
print(lookup(syms, "w"))
