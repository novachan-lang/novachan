fn memo_new()
  {}

fn memo_get(cache, key)
  if contains(cache, key)
    return ok(cache[key])
  err("miss")

fn memo_set(cache, key, value)
  cache[key] = value
  value

fn memo_call(cache, key, compute_fn)
  if contains(cache, key)
    return cache[key]
  let result = compute_fn(key)
  cache[key] = result
  result

fn memo_size(cache)
  len(keys(cache))

fn memo_clear(cache)
  let ks = keys(cache)
  for k in ks
    cache[k] = 0

fn _expensive_compute(n)
  let result = 0
  let i = 0
  while i < n
    result = result + i * i
    i = i + 1
  result

fn main()
  let cache = memo_new()
  assert(memo_size(cache) == 0, "empty cache")

  let r1 = memo_call(cache, "100", fn(z) _expensive_compute(100))
  assert(r1 == 328350, "compute 100")
  assert(memo_size(cache) == 1, "cached 1")

  let r2 = memo_call(cache, "100", fn(z) _expensive_compute(100))
  assert(r2 == 328350, "cached hit")

  let r3 = memo_call(cache, "50", fn(z) _expensive_compute(50))
  assert(r3 == 40425, "compute 50")
  assert(memo_size(cache) == 2, "cached 2")

  let hit = memo_get(cache, "100")
  assert(is_ok(hit), "get hit")
  assert(unwrap(hit) == 328350, "get value")

  let miss = memo_get(cache, "999")
  assert(is_err(miss), "get miss")

  let _v = memo_set(cache, "manual", 42)
  assert(unwrap(memo_get(cache, "manual")) == 42, "manual set")

  print("memox: all passed")
