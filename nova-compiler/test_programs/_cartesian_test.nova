import std/combinatorics/cartesian

// cki — check integer equality
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL cartesian " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// list_to_str — flatten a list to a string
fn list_to_str(xs) -> string
    let s = "["
    let i = 0
    let n = len(xs)
    while i < n
        if i > 0
            s = s + ","
        s = s + str(xs[i])
        i = i + 1
    s = s + "]"
    return s

fn sublist_to_str(xss) -> string
    let s = "["
    let i = 0
    let n = len(xss)
    while i < n
        if i > 0
            s = s + ","
        s = s + list_to_str(xss[i])
        i = i + 1
    s = s + "]"
    return s

fn ckl(label: string, got, want: string)
    let gs = list_to_str(got)
    if gs != want
        print("FAIL cartesian " + label + ": got=" + gs + " want=" + want)
        exit(1)

fn ckll(label: string, got, want: string)
    let gs = sublist_to_str(got)
    if gs != want
        print("FAIL cartesian " + label + ": got=" + gs + " want=" + want)
        exit(1)

fn main()
    // --- cart_count ---
    let l12 = [1, 2]
    let l345 = [3, 4, 5]
    let lists_2_3 = [l12, l345]
    cki("cart_count([[1,2],[3,4,5]])", cart_count(lists_2_3), 6)
    // empty list of lists => 1
    let empty_lists = []
    cki("cart_count([])", cart_count(empty_lists), 1)
    // single list [1,2,3] => 3
    let single = [[1, 2, 3]]
    cki("cart_count([[1,2,3]])", cart_count(single), 3)

    // --- cart_power_count ---
    cki("cart_power_count(2,3)", cart_power_count(2, 3), 8)
    cki("cart_power_count(3,2)", cart_power_count(3, 2), 9)
    cki("cart_power_count(5,0)", cart_power_count(5, 0), 1)
    cki("cart_power_count(0,3)", cart_power_count(0, 3), 0)

    // --- cart_pair ---
    let a12 = [1, 2]
    let b34 = [3, 4]
    let p = cart_pair(a12, b34)
    cki("cart_pair len", len(p), 4)
    ckll("cart_pair([1,2],[3,4])", p, "[[1,3],[1,4],[2,3],[2,4]]")

    // --- cart_product ---
    let lists_cp = [a12, b34]
    let cp = cart_product(lists_cp)
    cki("cart_product([[1,2],[3,4]]) len", len(cp), 4)
    ckll("cart_product([[1,2],[3,4]])", cp, "[[1,3],[1,4],[2,3],[2,4]]")

    // single-element list
    let single_list = [[1]]
    let sp = cart_product(single_list)
    cki("cart_product([[1]]) len", len(sp), 1)
    ckll("cart_product([[1]])", sp, "[[1]]")

    // empty list-of-lists => one empty tuple
    let ep = cart_product(empty_lists)
    cki("cart_product([]) len", len(ep), 1)
    cki("cart_product([])[0] len", len(ep[0]), 0)

    // 3-way product [[1,2],[3],[4,5]] => 4 tuples
    let l3 = [1, 2]
    let l4 = [3]
    let l5 = [4, 5]
    let lists3way = [l3, l4, l5]
    let cp3 = cart_product(lists3way)
    cki("cart_product 3-way len", len(cp3), 4)
    ckl("cart_product 3-way [0]", cp3[0], "[1,3,4]")
    ckl("cart_product 3-way [3]", cp3[3], "[2,3,5]")

    // --- cart_power ---
    let bits = [0, 1]
    let pw2 = cart_power(bits, 2)
    cki("cart_power([0,1],2) len", len(pw2), 4)
    ckll("cart_power([0,1],2)", pw2, "[[0,0],[0,1],[1,0],[1,1]]")

    let pw3 = cart_power(bits, 3)
    cki("cart_power([0,1],3) len", len(pw3), 8)
    ckl("cart_power([0,1],3)[0]", pw3[0], "[0,0,0]")
    ckl("cart_power([0,1],3)[7]", pw3[7], "[1,1,1]")

    // k=0 => one empty tuple
    let pw0 = cart_power(bits, 0)
    cki("cart_power([0,1],0) len", len(pw0), 1)
    cki("cart_power([0,1],0)[0] len", len(pw0[0]), 0)

    // --- cart_nth ---
    // [[1,2],[3,4]]: order is [1,3],[1,4],[2,3],[2,4]
    let ln12 = [1, 2]
    let ln34 = [3, 4]
    let nlists = [ln12, ln34]
    let t0 = cart_nth(nlists, 0)
    ckl("cart_nth([[1,2],[3,4]],0)", t0, "[1,3]")
    let t1 = cart_nth(nlists, 1)
    ckl("cart_nth([[1,2],[3,4]],1)", t1, "[1,4]")
    let t2 = cart_nth(nlists, 2)
    ckl("cart_nth([[1,2],[3,4]],2)", t2, "[2,3]")
    let t3 = cart_nth(nlists, 3)
    ckl("cart_nth([[1,2],[3,4]],3)", t3, "[2,4]")

    // out of range
    let t_oor = cart_nth(nlists, 4)
    cki("cart_nth out-of-range len", len(t_oor), 0)

    // --- cart_index ---
    let idx0 = cart_index(t0, nlists)
    cki("cart_index([1,3],[[1,2],[3,4]])", idx0, 0)
    let idx3 = cart_index(t3, nlists)
    cki("cart_index([2,4],[[1,2],[3,4]])", idx3, 3)

    // --- consistency: cart_nth + cart_index roundtrip ---
    let total6 = cart_count(lists_2_3)
    cki("roundtrip total", total6, 6)
    let rr = 0
    while rr < total6
        let tup = cart_nth(lists_2_3, rr)
        let back = cart_index(tup, lists_2_3)
        if back != rr
            print("FAIL cartesian roundtrip idx=" + str(rr) + " got=" + str(back))
            exit(1)
        rr = rr + 1

    print("PASS _cartesian_test")
