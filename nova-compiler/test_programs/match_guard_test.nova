fn classify(n)
    return match n
        x if x < 0 => "negative"
        x if x == 0 => "zero"
        x if x < 10 => "small"
        _ => "large"

print(classify(-5))
print(classify(0))
print(classify(7))
print(classify(100))

fn fizzbuzz(n)
    return match n
        x if x % 15 == 0 => "fizzbuzz"
        x if x % 3 == 0 => "fizz"
        x if x % 5 == 0 => "buzz"
        _ => "other"

print(fizzbuzz(15))
print(fizzbuzz(9))
print(fizzbuzz(10))
print(fizzbuzz(7))
