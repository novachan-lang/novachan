import std/dp/dp_edit_distance

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

fn ckb(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

fn ckl(label, got, expected)
    let gl = len(got)
    let el = len(expected)
    if gl != el
        print("FAIL " + label + " len: got=" + str(gl) + " expected=" + str(el))
        exit(1)
    let i = 0
    while i < gl
        if got[i] != expected[i]
            print("FAIL " + label + " [" + str(i) + "]: got=" + str(got[i]) + " expected=" + str(expected[i]))
            exit(1)
        i = i + 1

fn main()
    // KAT 1: ed_distance([1,2,3],[1,3]) = 1  (delete 2)
    let a1 = [1, 2, 3]
    let b1 = [1, 3]
    cki("ed_distance [1,2,3]/[1,3]", ed_distance(a1, b1), 1)

    // KAT 2: ed_distance([1,2,3],[4,5,6]) = 3  (sub all)
    let a2 = [1, 2, 3]
    let b2 = [4, 5, 6]
    cki("ed_distance [1,2,3]/[4,5,6]", ed_distance(a2, b2), 3)

    // KAT 3: ed_distance([],[1,2,3]) = 3  (3 insertions)
    let a3 = []
    let b3 = [1, 2, 3]
    cki("ed_distance []/[1,2,3]", ed_distance(a3, b3), 3)

    // KAT 4: ed_distance([1,2,3],[1,2,3]) = 0  (identical)
    cki("ed_distance identical", ed_distance(a1, a1), 0)

    // KAT 5: ed_distance([11,9,20,20,5,14],[19,9,20,20,9,14,7]) = 3
    let a5 = [11, 9, 20, 20, 5, 14]
    let b5 = [19, 9, 20, 20, 9, 14, 7]
    cki("ed_distance [11,9,20,20,5,14]/[19,9,20,20,9,14,7]", ed_distance(a5, b5), 3)

    // KAT 6: ed_distance_costs([1],[2],1,1,5) = 2  (sub=5 > del+ins=2)
    let a6 = [1]
    let b6 = [2]
    cki("ed_distance_costs sub>del+ins", ed_distance_costs(a6, b6, 1, 1, 5), 2)

    // KAT 7: ed_distance_costs when sub is cheaper
    // [1]->[2] with ins=10,del=10,sub=1 = sub wins -> 1
    cki("ed_distance_costs sub cheaper", ed_distance_costs(a6, b6, 10, 10, 1), 1)

    // KAT 8: ed_distance_costs empty->empty = 0
    let ae = []
    let be = []
    cki("ed_distance_costs both empty", ed_distance_costs(ae, be, 2, 3, 4), 0)

    // KAT 9: ed_distance_costs empty->[1,2,3] = 3*ins
    cki("ed_distance_costs empty/[1,2,3] ins=2", ed_distance_costs(ae, b3, 2, 3, 4), 6)

    // KAT 10: ed_distance_costs [1,2,3]->empty = 3*del
    cki("ed_distance_costs [1,2,3]/empty del=3", ed_distance_costs(a1, ae, 2, 3, 4), 9)

    // KAT 11: ed_lcs_distance([1,2,3],[1,3]) = 1  (delete 2; LCS=2, so 3+2-4=1)
    cki("ed_lcs_distance [1,2,3]/[1,3]", ed_lcs_distance(a1, b1), 1)

    // KAT 12: ed_lcs_distance([1,2,3],[4,5,6]) = 6  (no common; LCS=0, 3+3-0=6)
    cki("ed_lcs_distance [1,2,3]/[4,5,6]", ed_lcs_distance(a2, b2), 6)

    // KAT 13: ed_lcs_distance([],[1,2,3]) = 3
    cki("ed_lcs_distance []/[1,2,3]", ed_lcs_distance(ae, b3), 3)

    // KAT 14: ed_lcs_distance identical = 0
    cki("ed_lcs_distance identical", ed_lcs_distance(a1, a1), 0)

    // KAT 15: ed_distance symmetry
    let d_fwd = ed_distance(a5, b5)
    let d_rev = ed_distance(b5, a5)
    cki("ed_distance symmetry", d_fwd, d_rev)

    print("PASS _dp_edit_distance_test")
