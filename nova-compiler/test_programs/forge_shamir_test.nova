import forge_shamir as ss

fn check(cond: bool, label: string)
    if cond == false
        print("FAIL: " + label)

fn lcg(state: int) -> int
    (state * 1103515245 + 12345) % 2147483648

// extract xs and ys for the shares at the given flat-share indices (0-based share number)
fn subset_x(shares: list, idxs: list) -> list
    let out = []
    let i = 0
    while i < len(idxs)
        push(out, shares[idxs[i] * 2])
        i = i + 1
    out

fn subset_y(shares: list, idxs: list) -> list
    let out = []
    let i = 0
    while i < len(idxs)
        push(out, shares[idxs[i] * 2 + 1])
        i = i + 1
    out

fn main()
    let P = 2147483647   // 2^31 - 1, a Mersenne prime

    // ---- basic 3-of-5 ----
    let secret = 1234567
    let shares = ss.shamir_split(secret, 5, 3, P, 42)
    check(len(shares) == 10, "5 shares (flat len 10)")
    // reconstruct from three different 3-subsets -> all give the secret
    check(ss.shamir_reconstruct(subset_x(shares, [0, 1, 2]), subset_y(shares, [0, 1, 2]), P) == secret, "reconstruct 012")
    check(ss.shamir_reconstruct(subset_x(shares, [1, 3, 4]), subset_y(shares, [1, 3, 4]), P) == secret, "reconstruct 134")
    check(ss.shamir_reconstruct(subset_x(shares, [0, 2, 4]), subset_y(shares, [0, 2, 4]), P) == secret, "reconstruct 024")
    // using MORE than k shares also works (over-determined but consistent)
    check(ss.shamir_reconstruct(subset_x(shares, [0, 1, 2, 3, 4]), subset_y(shares, [0, 1, 2, 3, 4]), P) == secret, "reconstruct all 5")

    // ---- 2-of-2 (simplest split) ----
    let sh2 = ss.shamir_split(999, 2, 2, P, 7)
    check(ss.shamir_reconstruct(subset_x(sh2, [0, 1]), subset_y(sh2, [0, 1]), P) == 999, "2-of-2 reconstruct")

    // ---- small prime, secret must be < prime ----
    let sp = 7919
    let sh3 = ss.shamir_split(1000, 6, 4, sp, 123)
    check(ss.shamir_reconstruct(subset_x(sh3, [0, 1, 2, 3]), subset_y(sh3, [0, 1, 2, 3]), sp) == 1000, "small-prime 4-of-6 A")
    check(ss.shamir_reconstruct(subset_x(sh3, [2, 3, 4, 5]), subset_y(sh3, [2, 3, 4, 5]), sp) == 1000, "small-prime 4-of-6 B")

    // ---- a wrong / insufficient subset (k-1 shares) generally does NOT recover the secret ----
    // (information-theoretic: k-1 points underdetermine; here we just confirm 2 shares of a 3-threshold split
    //  interpolate a DIFFERENT value than the true secret for this instance)
    let two = ss.shamir_reconstruct(subset_x(shares, [0, 1]), subset_y(shares, [0, 1]), P)
    check(two != secret, "k-1 shares do not recover the secret (this instance)")

    // ---- BIG self-check: random secrets/seeds/thresholds, every valid k-subset reconstructs exactly ----
    let st = 20240706
    let trial = 0
    while trial < 40
        st = lcg(st)
        let k = 2 + (st % 4)          // threshold 2..5
        st = lcg(st)
        let n = k + (st % 4)          // n = k..k+3
        st = lcg(st)
        let sec = st % P
        st = lcg(st)
        let sd = st
        let sh = ss.shamir_split(sec, n, k, P, sd)
        check(len(sh) == n * 2, "trial " + str(trial) + " share count")
        // reconstruct from the first k shares
        let idxsA = []
        let a = 0
        while a < k
            push(idxsA, a)
            a = a + 1
        check(ss.shamir_reconstruct(subset_x(sh, idxsA), subset_y(sh, idxsA), P) == sec, "trial " + str(trial) + " first-k reconstruct")
        // reconstruct from the LAST k shares
        let idxsB = []
        let b = n - k
        while b < n
            push(idxsB, b)
            b = b + 1
        check(ss.shamir_reconstruct(subset_x(sh, idxsB), subset_y(sh, idxsB), P) == sec, "trial " + str(trial) + " last-k reconstruct")
        trial = trial + 1

    print("forge_shamir: all passed")
