import std/collections/pvecx

fn main()
    // build by repeated push -- each push returns a NEW version
    let v0 = pvecx.pvec_new()
    assert(pvecx.pvec_len(v0) == 0, "empty pvec has length 0")
    let v1 = pvecx.pvec_push(v0, 10)
    let v2 = pvecx.pvec_push(v1, 20)
    let v3 = pvecx.pvec_push(v2, 30)
    assert(pvecx.pvec_len(v3) == 3, "v3 has length 3")
    assert(pvecx.pvec_get(v3, 0) == 10, "v3[0] == 10")
    assert(pvecx.pvec_get(v3, 2) == 30, "v3[2] == 30")

    // PERSISTENCE: the earlier version v0 is untouched by later pushes
    assert(pvecx.pvec_len(v0) == 0, "v0 still length 0 after pushes -> persistent")

    // set returns a new version; the source version stays unchanged
    let v4 = pvecx.pvec_set(v3, 1, 99)
    assert(pvecx.pvec_get(v4, 1) == 99, "v4[1] updated to 99")
    assert(pvecx.pvec_get(v3, 1) == 20, "v3[1] still 20 -> set is persistent")
    assert(pvecx.pvec_to_list(v4) == [10, 99, 30], "v4 materializes to [10,99,30]")

    // larger vector spanning multiple chunks (size 6 -> 2 chunks of 4)
    let big = pvecx.pvec_from_list([0, 1, 2, 3, 4, 5])
    assert(pvecx.pvec_len(big) == 6, "from_list of 6 elems has length 6")
    assert(pvecx.pvec_get(big, 5) == 5, "big[5] == 5 (second chunk)")
    assert(pvecx.pvec_to_list(big) == [0, 1, 2, 3, 4, 5], "big round-trips to the same list")

    print("pvecx_lib_test passed")
