fn queue_new()
  let q = {}
  q["head"] = 0
  q["tail"] = 0
  q["size"] = 0
  q

fn _q_node(val, next)
  let n = {}
  n["value"] = val
  n["next"] = next
  n

fn queue_push(q, val)
  let node = _q_node(val, 0)
  if q["tail"] != 0
    q["tail"]["next"] = node
  else
    q["head"] = node
  q["tail"] = node
  q["size"] = q["size"] + 1

fn queue_pop(q)
  if q["head"] == 0
    return err("queue empty")
  let node = q["head"]
  let val = node["value"]
  q["head"] = node["next"]
  if q["head"] == 0
    q["tail"] = 0
  q["size"] = q["size"] - 1
  ok(val)

fn queue_peek(q)
  if q["head"] == 0
    return err("queue empty")
  ok(q["head"]["value"])

fn queue_size(q)
  q["size"]

fn queue_is_empty(q)
  q["size"] == 0

fn queue_to_list(q)
  let result = []
  let node = q["head"]
  while node != 0
    push(result, node["value"])
    node = node["next"]
  result

fn main()
  let q = queue_new()
  assert(queue_is_empty(q) == 1, "new queue empty")
  assert(queue_size(q) == 0, "size 0")

  queue_push(q, "a")
  queue_push(q, "b")
  queue_push(q, "c")
  assert(queue_size(q) == 3, "size 3")

  let pk = queue_peek(q)
  assert(unwrap(pk) == "a", "peek = a (FIFO)")

  let p1 = queue_pop(q)
  assert(unwrap(p1) == "a", "pop a")
  let p2 = queue_pop(q)
  assert(unwrap(p2) == "b", "pop b")
  assert(queue_size(q) == 1, "size 1")

  queue_push(q, "d")
  assert(queue_size(q) == 2, "size 2")

  let items = queue_to_list(q)
  assert(len(items) == 2, "to_list len")
  assert(items[0] == "c", "first is c")
  assert(items[1] == "d", "second is d")

  let p3 = queue_pop(q)
  let p4 = queue_pop(q)
  assert(unwrap(p3) == "c", "pop c")
  assert(unwrap(p4) == "d", "pop d")
  assert(queue_is_empty(q) == 1, "empty after drain")

  let perr = queue_pop(q)
  assert(is_err(perr), "pop empty = err")

  print("queuex: all passed")
