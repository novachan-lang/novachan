// _palette_test.nova — KAT for std/color/palette
import std/color/palette
import std/color/hsl

// helper: print list-of-3-ints
fn print_rgb(label: str, c: list) -> int
    let r = c[0]
    let g = c[1]
    let b = c[2]
    print(label + " [" + str(r) + "," + str(g) + "," + str(b) + "]")
    0

// KAT 1: pal_triadic([255,0,0]) has length 3
let red = []
red.push(255)
red.push(0)
red.push(0)

let tri = pal_triadic(red)
let tri_len = len(tri)
if tri_len != 3
    print("FAIL KAT1: pal_triadic length expected 3, got " + str(tri_len))
    exit(1)

// KAT 2: pal_triadic([255,0,0])[0] == [255,0,0]
let tri0 = tri[0]
let tri0r = tri0[0]
let tri0g = tri0[1]
let tri0b = tri0[2]
if tri0r != 255
    print("FAIL KAT2: triadic[0][r] expected 255, got " + str(tri0r))
    exit(1)
if tri0g != 0
    print("FAIL KAT2: triadic[0][g] expected 0, got " + str(tri0g))
    exit(1)
if tri0b != 0
    print("FAIL KAT2: triadic[0][b] expected 0, got " + str(tri0b))
    exit(1)

// KAT 3: pal_complementary([255,0,0])[1] is cyan-ish
// Red = hue 0; complement = hue 180 => cyan [0,255,255].
// Allow +/-3 per channel.
let comp_pair = pal_complementary(red)
let comp = comp_pair[1]
let comp_r = comp[0]
let comp_g = comp[1]
let comp_b = comp[2]
// cyan: r~0, g~255, b~255
let diff_r = comp_r - 0
if diff_r < 0
    diff_r = 0 - diff_r
let diff_g = comp_g - 255
if diff_g < 0
    diff_g = 0 - diff_g
let diff_b = comp_b - 255
if diff_b < 0
    diff_b = 0 - diff_b
if diff_r > 3
    print("FAIL KAT3: complement r expected ~0, got " + str(comp_r))
    exit(1)
if diff_g > 3
    print("FAIL KAT3: complement g expected ~255, got " + str(comp_g))
    exit(1)
if diff_b > 3
    print("FAIL KAT3: complement b expected ~255, got " + str(comp_b))
    exit(1)

// KAT 4: pal_analogous([0,255,0]) has length 3
let green = []
green.push(0)
green.push(255)
green.push(0)

let ana = pal_analogous(green)
let ana_len = len(ana)
if ana_len != 3
    print("FAIL KAT4: pal_analogous length expected 3, got " + str(ana_len))
    exit(1)

// KAT 5: pal_analogous(c)[1] == c (middle element is the base color)
let ana1 = ana[1]
let ana1r = ana1[0]
let ana1g = ana1[1]
let ana1b = ana1[2]
if ana1r != 0
    print("FAIL KAT5: analogous[1][r] expected 0, got " + str(ana1r))
    exit(1)
if ana1g != 255
    print("FAIL KAT5: analogous[1][g] expected 255, got " + str(ana1g))
    exit(1)
if ana1b != 0
    print("FAIL KAT5: analogous[1][b] expected 0, got " + str(ana1b))
    exit(1)

// KAT 6: pal_monochromatic([100,100,100], 5) has length 5
let gray = []
gray.push(100)
gray.push(100)
gray.push(100)

let mono = pal_monochromatic(gray, 5)
let mono_len = len(mono)
if mono_len != 5
    print("FAIL KAT6: pal_monochromatic length expected 5, got " + str(mono_len))
    exit(1)

// KAT 7: pal_tetradic([255,0,0]) has length 4
let tet = pal_tetradic(red)
let tet_len = len(tet)
if tet_len != 4
    print("FAIL KAT7: pal_tetradic length expected 4, got " + str(tet_len))
    exit(1)

print("_palette_test passed")
