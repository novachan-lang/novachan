fn ansi_fg(code)
  from_codepoint(27) + "[38;5;" + str(code) + "m"

fn ansi_bg(code)
  from_codepoint(27) + "[48;5;" + str(code) + "m"

fn ansi_reset()
  from_codepoint(27) + "[0m"

fn ansi_bold()
  from_codepoint(27) + "[1m"

fn ansi_dim()
  from_codepoint(27) + "[2m"

fn ansi_underline()
  from_codepoint(27) + "[4m"

fn colorize(text, fg_code)
  ansi_fg(fg_code) + text + ansi_reset()

fn bg_colorize(text, bg_code)
  ansi_bg(bg_code) + text + ansi_reset()

fn bold(text)
  ansi_bold() + text + ansi_reset()

fn underline(text)
  ansi_underline() + text + ansi_reset()

fn red(text)
  colorize(text, 196)

fn green(text)
  colorize(text, 46)

fn blue(text)
  colorize(text, 21)

fn yellow(text)
  colorize(text, 226)

fn main()
  let esc = from_codepoint(27)
  let r = ansi_fg(196)
  assert(contains(r, "38;5;196"), "fg code")
  assert(starts_with(r, esc), "starts with ESC")

  let bg = ansi_bg(21)
  assert(contains(bg, "48;5;21"), "bg code")

  let rst = ansi_reset()
  assert(contains(rst, "[0m"), "reset code")

  let colored = colorize("hello", 196)
  assert(contains(colored, "hello"), "text present")
  assert(contains(colored, "38;5;196"), "color present")
  assert(contains(colored, "[0m"), "reset at end")

  let b = bold("test")
  assert(contains(b, "[1m"), "bold code")
  assert(contains(b, "test"), "bold text")

  let _r = red("error")
  let _g = green("ok")
  let _b = blue("info")
  let _y = yellow("warn")

  print("color256x: all passed")
