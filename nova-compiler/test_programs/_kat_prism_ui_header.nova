import prism_ui_header
import prism_node
import prism_arrange
import prism_content
import prism_interact
import prism_link

fn kat_assert(name: string, cond: bool) -> bool
    if cond
        return true
    else
        print("FAIL: " + name)
        return false

fn main()
    let mut total = 0
    let mut passed = 0

    // ==================== 1. prism_hd_header WITH nav ====================
    let nav_home = unwrap(prism_content.prism_label("Home"))
    let nav_docs = unwrap(prism_content.prism_label("Docs"))
    let r_hdr_nav = prism_ui_header.prism_hd_header("Nova", [nav_home, nav_docs])
    total += 1
    if kat_assert("header_with_nav: is_ok", is_ok(r_hdr_nav))
        passed += 1
    let n_hdr_nav = unwrap(r_hdr_nav)
    total += 1
    if kat_assert("header_with_nav: kind=band", prism_node.prism_node_kind_str(n_hdr_nav) == "band")
        passed += 1
    let c_hdr_nav = prism_node.prism_node_children(n_hdr_nav)
    total += 1
    if kat_assert("header_with_nav: children len=3", len(c_hdr_nav) == 3)
        passed += 1
    total += 1
    if kat_assert("header_with_nav: child0 kind=label", prism_node.prism_node_kind_str(c_hdr_nav[0]) == "label")
        passed += 1
    total += 1
    if kat_assert("header_with_nav: child0 text=Nova", prism_node.prism_node_attr_str(c_hdr_nav[0], "text", "") == "Nova")
        passed += 1
    total += 1
    if kat_assert("header_with_nav: child1 kind=gap", prism_node.prism_node_kind_str(c_hdr_nav[1]) == "gap")
        passed += 1
    total += 1
    if kat_assert("header_with_nav: child2 kind=band", prism_node.prism_node_kind_str(c_hdr_nav[2]) == "band")
        passed += 1
    let c_nav = prism_node.prism_node_children(c_hdr_nav[2])
    total += 1
    if kat_assert("header_with_nav: nav children len=2", len(c_nav) == 2)
        passed += 1
    total += 1
    if kat_assert("header_with_nav: nav child0 text=Home", prism_node.prism_node_attr_str(c_nav[0], "text", "") == "Home")
        passed += 1
    total += 1
    if kat_assert("header_with_nav: nav child1 text=Docs", prism_node.prism_node_attr_str(c_nav[1], "text", "") == "Docs")
        passed += 1

    // ==================== 2. prism_hd_header WITHOUT nav ====================
    let r_hdr_no_nav = prism_ui_header.prism_hd_header("Nova", [])
    total += 1
    if kat_assert("header_no_nav: is_ok", is_ok(r_hdr_no_nav))
        passed += 1
    let n_hdr_no_nav = unwrap(r_hdr_no_nav)
    total += 1
    if kat_assert("header_no_nav: kind=band", prism_node.prism_node_kind_str(n_hdr_no_nav) == "band")
        passed += 1
    let c_hdr_no_nav = prism_node.prism_node_children(n_hdr_no_nav)
    total += 1
    if kat_assert("header_no_nav: children len=2", len(c_hdr_no_nav) == 2)
        passed += 1
    total += 1
    if kat_assert("header_no_nav: child0 kind=label", prism_node.prism_node_kind_str(c_hdr_no_nav[0]) == "label")
        passed += 1
    total += 1
    if kat_assert("header_no_nav: child0 text=Nova", prism_node.prism_node_attr_str(c_hdr_no_nav[0], "text", "") == "Nova")
        passed += 1
    total += 1
    if kat_assert("header_no_nav: child1 kind=gap", prism_node.prism_node_kind_str(c_hdr_no_nav[1]) == "gap")
        passed += 1

    // ==================== 3. prism_hd_footer WITH links ====================
    let copyright_txt = "(c) 2026 Nova"
    let link_privacy = unwrap(prism_content.prism_label("Privacy"))
    let link_terms = unwrap(prism_content.prism_label("Terms"))
    let r_ftr_links = prism_ui_header.prism_hd_footer(copyright_txt, [link_privacy, link_terms])
    total += 1
    if kat_assert("footer_with_links: is_ok", is_ok(r_ftr_links))
        passed += 1
    let n_ftr_links = unwrap(r_ftr_links)
    total += 1
    if kat_assert("footer_with_links: kind=stack", prism_node.prism_node_kind_str(n_ftr_links) == "stack")
        passed += 1
    let c_ftr_links = prism_node.prism_node_children(n_ftr_links)
    total += 1
    if kat_assert("footer_with_links: children len=2", len(c_ftr_links) == 2)
        passed += 1
    total += 1
    if kat_assert("footer_with_links: divider kind=label", prism_node.prism_node_kind_str(c_ftr_links[0]) == "label")
        passed += 1
    total += 1
    if kat_assert("footer_with_links: divider text=---", prism_node.prism_node_attr_str(c_ftr_links[0], "text", "") == "---")
        passed += 1
    total += 1
    if kat_assert("footer_with_links: row kind=band", prism_node.prism_node_kind_str(c_ftr_links[1]) == "band")
        passed += 1
    let c_row_links = prism_node.prism_node_children(c_ftr_links[1])
    total += 1
    if kat_assert("footer_with_links: row children len=3", len(c_row_links) == 3)
        passed += 1
    total += 1
    if kat_assert("footer_with_links: row child0 kind=label", prism_node.prism_node_kind_str(c_row_links[0]) == "label")
        passed += 1
    total += 1
    if kat_assert("footer_with_links: row child0 text=copyright", prism_node.prism_node_attr_str(c_row_links[0], "text", "") == copyright_txt)
        passed += 1
    total += 1
    if kat_assert("footer_with_links: row child1 kind=gap", prism_node.prism_node_kind_str(c_row_links[1]) == "gap")
        passed += 1
    total += 1
    if kat_assert("footer_with_links: row child2 kind=band", prism_node.prism_node_kind_str(c_row_links[2]) == "band")
        passed += 1
    let c_links_band = prism_node.prism_node_children(c_row_links[2])
    total += 1
    if kat_assert("footer_with_links: links band children len=2", len(c_links_band) == 2)
        passed += 1
    total += 1
    if kat_assert("footer_with_links: link0 text=Privacy", prism_node.prism_node_attr_str(c_links_band[0], "text", "") == "Privacy")
        passed += 1
    total += 1
    if kat_assert("footer_with_links: link1 text=Terms", prism_node.prism_node_attr_str(c_links_band[1], "text", "") == "Terms")
        passed += 1

    // ==================== 4. prism_hd_footer WITHOUT links ====================
    let r_ftr_no_links = prism_ui_header.prism_hd_footer(copyright_txt, [])
    total += 1
    if kat_assert("footer_no_links: is_ok", is_ok(r_ftr_no_links))
        passed += 1
    let n_ftr_no_links = unwrap(r_ftr_no_links)
    total += 1
    if kat_assert("footer_no_links: kind=stack", prism_node.prism_node_kind_str(n_ftr_no_links) == "stack")
        passed += 1
    let c_ftr_no_links = prism_node.prism_node_children(n_ftr_no_links)
    total += 1
    if kat_assert("footer_no_links: children len=2", len(c_ftr_no_links) == 2)
        passed += 1
    total += 1
    if kat_assert("footer_no_links: row kind=band", prism_node.prism_node_kind_str(c_ftr_no_links[1]) == "band")
        passed += 1
    let c_row_no_links = prism_node.prism_node_children(c_ftr_no_links[1])
    total += 1
    if kat_assert("footer_no_links: row children len=2", len(c_row_no_links) == 2)
        passed += 1
    total += 1
    if kat_assert("footer_no_links: row child0 text=copyright", prism_node.prism_node_attr_str(c_row_no_links[0], "text", "") == copyright_txt)
        passed += 1

    // ==================== 5. prism_hd_hero WITH cta ====================
    let hero_title = "Welcome"
    let hero_subtitle = "Build anything"
    let hero_cta = "Get Started"
    let r_hero_cta = prism_ui_header.prism_hd_hero(hero_title, hero_subtitle, hero_cta)
    total += 1
    if kat_assert("hero_with_cta: is_ok", is_ok(r_hero_cta))
        passed += 1
    let n_hero_cta = unwrap(r_hero_cta)
    total += 1
    if kat_assert("hero_with_cta: kind=stack", prism_node.prism_node_kind_str(n_hero_cta) == "stack")
        passed += 1
    let c_hero_cta = prism_node.prism_node_children(n_hero_cta)
    total += 1
    if kat_assert("hero_with_cta: children len=5", len(c_hero_cta) == 5)
        passed += 1
    total += 1
    if kat_assert("hero_with_cta: child0 kind=label", prism_node.prism_node_kind_str(c_hero_cta[0]) == "label")
        passed += 1
    total += 1
    if kat_assert("hero_with_cta: child0 text=title", prism_node.prism_node_attr_str(c_hero_cta[0], "text", "") == hero_title)
        passed += 1
    total += 1
    if kat_assert("hero_with_cta: child1 kind=gap", prism_node.prism_node_kind_str(c_hero_cta[1]) == "gap")
        passed += 1
    total += 1
    if kat_assert("hero_with_cta: child2 kind=label", prism_node.prism_node_kind_str(c_hero_cta[2]) == "label")
        passed += 1
    total += 1
    if kat_assert("hero_with_cta: child2 text=subtitle", prism_node.prism_node_attr_str(c_hero_cta[2], "text", "") == hero_subtitle)
        passed += 1
    total += 1
    if kat_assert("hero_with_cta: child3 kind=gap", prism_node.prism_node_kind_str(c_hero_cta[3]) == "gap")
        passed += 1
    total += 1
    if kat_assert("hero_with_cta: child4 kind=press", prism_node.prism_node_kind_str(c_hero_cta[4]) == "press")
        passed += 1
    total += 1
    if kat_assert("hero_with_cta: child4 accessible name=cta", prism_node.prism_node_attr_str(c_hero_cta[4], "text", "") == hero_cta)
        passed += 1
    let c_btn = prism_node.prism_node_children(c_hero_cta[4])
    total += 1
    if kat_assert("hero_with_cta: button children len=1", len(c_btn) == 1)
        passed += 1
    total += 1
    if kat_assert("hero_with_cta: button label text=cta", prism_node.prism_node_attr_str(c_btn[0], "text", "") == hero_cta)
        passed += 1

    // ==================== 6. prism_hd_hero WITHOUT cta ====================
    let r_hero_no_cta = prism_ui_header.prism_hd_hero(hero_title, hero_subtitle, "")
    total += 1
    if kat_assert("hero_no_cta: is_ok", is_ok(r_hero_no_cta))
        passed += 1
    let n_hero_no_cta = unwrap(r_hero_no_cta)
    total += 1
    if kat_assert("hero_no_cta: kind=stack", prism_node.prism_node_kind_str(n_hero_no_cta) == "stack")
        passed += 1
    let c_hero_no_cta = prism_node.prism_node_children(n_hero_no_cta)
    total += 1
    if kat_assert("hero_no_cta: children len=2", len(c_hero_no_cta) == 2)
        passed += 1
    total += 1
    if kat_assert("hero_no_cta: child0 text=title", prism_node.prism_node_attr_str(c_hero_no_cta[0], "text", "") == hero_title)
        passed += 1
    total += 1
    if kat_assert("hero_no_cta: child1 text=subtitle", prism_node.prism_node_attr_str(c_hero_no_cta[1], "text", "") == hero_subtitle)
        passed += 1

    // ==================== 7. prism_hd_page ====================
    let page_hdr = unwrap(prism_ui_header.prism_hd_header("Nova", []))
    let page_ftr = unwrap(prism_ui_header.prism_hd_footer("(c) 2026", []))
    let page_content = unwrap(prism_content.prism_label("Body content"))
    let r_page = prism_ui_header.prism_hd_page(page_hdr, [page_content], page_ftr)
    total += 1
    if kat_assert("page: is_ok", is_ok(r_page))
        passed += 1
    let n_page = unwrap(r_page)
    total += 1
    if kat_assert("page: kind=stack", prism_node.prism_node_kind_str(n_page) == "stack")
        passed += 1
    let c_page = prism_node.prism_node_children(n_page)
    total += 1
    if kat_assert("page: children len=5", len(c_page) == 5)
        passed += 1
    total += 1
    if kat_assert("page: child0 kind=band (header)", prism_node.prism_node_kind_str(c_page[0]) == "band")
        passed += 1
    total += 1
    if kat_assert("page: child1 kind=gap", prism_node.prism_node_kind_str(c_page[1]) == "gap")
        passed += 1
    total += 1
    if kat_assert("page: child2 kind=stack (body)", prism_node.prism_node_kind_str(c_page[2]) == "stack")
        passed += 1
    let c_body = prism_node.prism_node_children(c_page[2])
    total += 1
    if kat_assert("page: body children len=1", len(c_body) == 1)
        passed += 1
    total += 1
    if kat_assert("page: child3 kind=gap", prism_node.prism_node_kind_str(c_page[3]) == "gap")
        passed += 1
    total += 1
    if kat_assert("page: child4 kind=stack (footer)", prism_node.prism_node_kind_str(c_page[4]) == "stack")
        passed += 1

    // ==================== 8. Error paths ====================
    let r_err_logo = prism_ui_header.prism_hd_header("", [])
    total += 1
    if kat_assert("err: empty logo is_err", is_err(r_err_logo))
        passed += 1
    total += 1
    if kat_assert("err: empty logo msg mentions logo", contains(unwrap_err(r_err_logo), "logo"))
        passed += 1

    let r_err_nav_type = prism_ui_header.prism_hd_header("Nova", ["not_a_node"])
    total += 1
    if kat_assert("err: bad nav item is_err", is_err(r_err_nav_type))
        passed += 1
    total += 1
    if kat_assert("err: bad nav item msg mentions PrismNode", contains(unwrap_err(r_err_nav_type), "PrismNode"))
        passed += 1

    let r_err_copyright = prism_ui_header.prism_hd_footer("", [])
    total += 1
    if kat_assert("err: empty copyright is_err", is_err(r_err_copyright))
        passed += 1
    total += 1
    if kat_assert("err: empty copyright msg mentions copyright", contains(unwrap_err(r_err_copyright), "copyright"))
        passed += 1

    let r_err_link_type = prism_ui_header.prism_hd_footer("Co", ["not_a_node"])
    total += 1
    if kat_assert("err: bad link item is_err", is_err(r_err_link_type))
        passed += 1
    total += 1
    if kat_assert("err: bad link item msg mentions PrismNode", contains(unwrap_err(r_err_link_type), "PrismNode"))
        passed += 1

    let r_err_title = prism_ui_header.prism_hd_hero("", "sub", "")
    total += 1
    if kat_assert("err: empty title is_err", is_err(r_err_title))
        passed += 1
    total += 1
    if kat_assert("err: empty title msg mentions title", contains(unwrap_err(r_err_title), "title"))
        passed += 1

    let r_err_subtitle = prism_ui_header.prism_hd_hero("title", "", "")
    total += 1
    if kat_assert("err: empty subtitle is_err", is_err(r_err_subtitle))
        passed += 1
    total += 1
    if kat_assert("err: empty subtitle msg mentions subtitle", contains(unwrap_err(r_err_subtitle), "subtitle"))
        passed += 1

    let r_err_content_empty = prism_ui_header.prism_hd_page(page_hdr, [], page_ftr)
    total += 1
    if kat_assert("err: empty content is_err", is_err(r_err_content_empty))
        passed += 1
    total += 1
    if kat_assert("err: empty content msg mentions content", contains(unwrap_err(r_err_content_empty), "content"))
        passed += 1

    let r_err_content_type = prism_ui_header.prism_hd_page(page_hdr, ["not_a_node"], page_ftr)
    total += 1
    if kat_assert("err: bad content item is_err", is_err(r_err_content_type))
        passed += 1
    total += 1
    if kat_assert("err: bad content item msg mentions PrismNode", contains(unwrap_err(r_err_content_type), "PrismNode"))
        passed += 1

    // ==================== Summary ====================
    print("")
    print("KAT prism_ui_header: " + str(passed) + "/" + str(total) + " assertions passed")
    if passed != total
        print("KAT prism_ui_header: FAILED")
    else
        print("KAT prism_ui_header: ALL GREEN")
