import forge_cusip

fn tf(b: bool) -> string
    if b
        return "T"
    "F"

fn main()
    // Published CUSIPs
    print("apple=" + tf(cusip_valid("037833100")))
    print("cisco=" + tf(cusip_valid("17275R102")))
    print("cd_apple=" + str(cusip_check_digit("03783310")))
    print("cd_cisco=" + str(cusip_check_digit("17275R10")))
    // invalid: wrong check digit
    print("bad_cd=" + tf(cusip_valid("037833101")))
    // invalid: wrong length
    print("bad_len=" + tf(cusip_valid("03783310")))
    // invalid: bad char
    print("bad_char=" + tf(cusip_valid("0378331!0")))
