// Forge TLS 1.3 handshake messages: parse the RFC 8448 §3 ServerHello, walk the decrypted server-flight
// framing (EncryptedExtensions/Certificate/CertificateVerify/Finished), and round-trip a ClientHello.
import forge_tls
import forge_crypto

fn main()
    // (a) parse the real RFC 8448 ServerHello
    let sh = hex_to_blist("020000560303a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e2692800130100002e00330024001d0020c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f002b00020304")
    let parsed = tls13_parse_server_hello(sh)
    if parsed[0] != 4865
        print("FAIL: SH cipher_suite not 0x1301")
        exit(1)
    if parsed[1] != 29
        print("FAIL: SH key_share group not x25519")
        exit(1)
    if hex_of(parsed[2]) != "c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f"
        print("FAIL: SH key_share pubkey -> " + hex_of(parsed[2]))
        exit(1)
    if parsed[3] != 772
        print("FAIL: SH selected_version not 0x0304")
        exit(1)

    // (b) walk the framing of the decrypted server handshake flight
    let key = hex_to_blist("3fce516009c21727d0f2e4e86ee403bc")
    let iv = hex_to_blist("5d313eb2671276ee13000b30")
    let rec = hex_to_blist("")
    let opened = tls13_record_open(key, iv, 0, rec)
    if opened[0] != true
        print("FAIL: flight record open")
        exit(1)
    let content = opened[1]
    let m1 = tls13_hs_header(content, 0)
    let m2 = tls13_hs_header(content, m1[3])
    let m3 = tls13_hs_header(content, m2[3])
    let m4 = tls13_hs_header(content, m3[3])
    if m1[0] != 8
        print("FAIL: msg1 not EncryptedExtensions")
        exit(1)
    if m2[0] != 11
        print("FAIL: msg2 not Certificate")
        exit(1)
    if m3[0] != 15
        print("FAIL: msg3 not CertificateVerify")
        exit(1)
    if m4[0] != 20
        print("FAIL: msg4 not Finished")
        exit(1)
    if m4[3] != 657
        print("FAIL: flight messages do not tile 657 bytes")
        exit(1)

    // (c) ClientHello round-trip: encode then re-read its header + key_share
    let random = hex_to_blist("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
    let pub = hex_to_blist("99381de560e4bd43d23d8e435a7dbafeb3c06e51c13cae4d5413691e529aaf2c")
    let ch = tls13_make_client_hello(random, pub)
    let hh = tls13_hs_header(ch, 0)
    if hh[0] != 1
        print("FAIL: CH type not ClientHello")
        exit(1)
    if hh[1] != len(ch) - 4
        print("FAIL: CH length field inconsistent")
        exit(1)
    let okpub = 1
    let i = 0
    while i < 32
        if ch[len(ch) - 32 + i] != pub[i]
            okpub = 0
        i = i + 1
    if okpub != 1
        print("FAIL: CH key_share pubkey not encoded")
        exit(1)

    print("PASS forge_tls_hs (RFC8448 ServerHello parse + server-flight framing + ClientHello round-trip)")
