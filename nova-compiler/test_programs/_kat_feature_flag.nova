import forge_feature_flag

fn main()
    let store = ff_store()
    store = ff_define(store, "new_dashboard", true)
    store = ff_define(store, "dark_mode", false)
    store = ff_define_rollout(store, "beta_search", 50)

    assert(ff_is_enabled(store, "new_dashboard"), "dashboard enabled")
    assert(not ff_is_enabled(store, "dark_mode"), "dark_mode disabled")
    assert(not ff_is_enabled(store, "nonexistent"), "missing flag")

    store = ff_set_description(store, "new_dashboard", "Redesigned dashboard UI")
    store = ff_add_group(store, "beta_search", "beta_testers")
    assert(ff_is_in_group(store, "beta_search", "beta_testers"), "in group")
    assert(not ff_is_in_group(store, "beta_search", "other"), "not in group")

    store = ff_override(store, "dark_mode", "user123", true)
    assert(ff_is_enabled_for(store, "dark_mode", "user123"), "override enabled")
    assert(not ff_is_enabled_for(store, "dark_mode", "user456"), "no override")

    assert(ff_is_enabled_for(store, "new_dashboard", "anyone"), "100pct rollout")

    let enabled_count = 0
    let i = 0
    while i < 100
        let uid = "user_" + str(i)
        if ff_is_enabled_for(store, "beta_search", uid)
            enabled_count = enabled_count + 1
        i = i + 1
    assert(enabled_count > 10 and enabled_count < 90, "approx 50pct rollout")

    store = ff_toggle(store, "dark_mode")
    assert(ff_is_enabled(store, "dark_mode"), "toggled on")
    store = ff_toggle(store, "dark_mode")
    assert(not ff_is_enabled(store, "dark_mode"), "toggled off")

    let flags = ff_list(store)
    assert(len(flags) == 3, "3 flags")

    store = ff_remove(store, "dark_mode")
    assert(not ff_is_enabled(store, "dark_mode"), "removed")

    print("FEATURE-FLAG KAT PASS")
