// KAT for std/calendar/doomsday
// Tests: day_of_week, day_name, doomsday_of_year
import std/calendar/doomsday

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _doomsday_test " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL _doomsday_test " + label + ": got '" + got + "' want '" + want + "'")
        exit(1)

fn main()
    // ── day_of_week ───────────────────────────────────────────────────────
    // 2000-01-01 was a Saturday = 6
    cki("dow-2000-01-01", day_of_week(2000, 1, 1), 6)

    // 2024-02-29 (leap day) was a Thursday = 4
    cki("dow-2024-02-29", day_of_week(2024, 2, 29), 4)

    // 1970-01-01 was a Thursday = 4
    cki("dow-1970-01-01", day_of_week(1970, 1, 1), 4)

    // Additional well-known dates
    // 2001-09-11 was a Tuesday = 2
    cki("dow-2001-09-11", day_of_week(2001, 9, 11), 2)

    // 1969-07-20 (Moon landing) was a Sunday = 0
    cki("dow-1969-07-20", day_of_week(1969, 7, 20), 0)

    // 2024-01-01 was a Monday = 1
    cki("dow-2024-01-01", day_of_week(2024, 1, 1), 1)

    // 2023-12-25 (Christmas) was a Monday = 1
    cki("dow-2023-12-25", day_of_week(2023, 12, 25), 1)

    // 2026-07-04 (US Independence Day): check
    // 2026-01-01 is Thursday(4), day-of-year(7,4)=31+28+31+30+31+30+4=185
    // (185-1)%7 = 184%7 = 2, Thur+2=Sat -> 2026-07-04=Saturday=6
    cki("dow-2026-07-04", day_of_week(2026, 7, 4), 6)

    // 1582-10-15 (first Gregorian calendar date) was a Friday = 5
    cki("dow-1582-10-15", day_of_week(1582, 10, 15), 5)

    // ── day_name ──────────────────────────────────────────────────────────
    cks("name-0", day_name(0), "Sunday")
    cks("name-1", day_name(1), "Monday")
    cks("name-2", day_name(2), "Tuesday")
    cks("name-3", day_name(3), "Wednesday")
    cks("name-4", day_name(4), "Thursday")
    cks("name-5", day_name(5), "Friday")
    cks("name-6", day_name(6), "Saturday")

    // day_name of computed values
    cks("name-dow-2000-01-01", day_name(day_of_week(2000, 1, 1)), "Saturday")
    cks("name-dow-1970-01-01", day_name(day_of_week(1970, 1, 1)), "Thursday")

    // ── doomsday_of_year ──────────────────────────────────────────────────
    // Doomsday 2000 = Tuesday = 2
    // Verify: 2000-04-04 = Tue(2); also 2000-12-12 should be Tue
    cki("doomsday-2000", doomsday_of_year(2000), 2)
    cki("doomsday-anchor-2000-04-04", day_of_week(2000, 4, 4), 2)
    cki("doomsday-anchor-2000-06-06", day_of_week(2000, 6, 6), 2)
    cki("doomsday-anchor-2000-08-08", day_of_week(2000, 8, 8), 2)
    cki("doomsday-anchor-2000-12-12", day_of_week(2000, 12, 12), 2)

    // Doomsday 2024: 2024-04-04 was a Thursday = 4
    cki("doomsday-2024", doomsday_of_year(2024), 4)

    // Doomsday 1970: 1970-04-04 was a Saturday = 6
    cki("doomsday-1970", doomsday_of_year(1970), 6)

    // Doomsday 2026: 2026-04-04 was a Saturday = 6
    cki("doomsday-2026", doomsday_of_year(2026), 6)

    print("PASS _doomsday_test")
