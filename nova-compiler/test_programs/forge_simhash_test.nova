import forge_simhash

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn main()
    let fails = 0

    // identical token lists -> identical fingerprint -> distance 0
    let a = ["the", "quick", "brown", "fox", "jumps"]
    let b = ["the", "quick", "brown", "fox", "jumps"]
    fails = fails + expect("identical_dist", str(simhash_token_distance(a, b)), "0")
    fails = fails + expect_true("identical_fp", simhash(a) == simhash(b))

    // determinism: same input -> same fingerprint
    fails = fails + expect_true("deterministic", simhash(a) == simhash(a))

    // set semantics-ish: reordered tokens -> same fingerprint (order-independent voting)
    let ar = ["fox", "the", "jumps", "brown", "quick"]
    fails = fails + expect("reordered_dist", str(simhash_token_distance(a, ar)), "0")

    // near-duplicate: change 1 of 5 tokens -> small distance
    let c = ["the", "quick", "brown", "fox", "leaps"]
    let near = simhash_token_distance(a, c)
    fails = fails + expect_true("near_small", near <= 12)

    // very different documents -> larger distance than the near-dup
    let d = ["completely", "unrelated", "words", "here", "totally", "different"]
    let far = simhash_token_distance(a, d)
    fails = fails + expect_true("far_bigger", far > near)

    // distance to self is 0; distance is symmetric
    let fa = simhash(a)
    let fc = simhash(c)
    fails = fails + expect("self_zero", str(simhash_distance(fa, fa)), "0")
    fails = fails + expect_true("symmetric", simhash_distance(fa, fc) == simhash_distance(fc, fa))

    // distance is in [0,32]
    fails = fails + expect_true("range", far >= 0 and far <= 32)

    // similar threshold
    fails = fails + expect_true("similar_yes", simhash_similar(fa, fa, 3))
    fails = fails + expect_true("similar_no", simhash_similar(fa, simhash(d), 3) == false)

    // hand-checkable Hamming distance: distance between fingerprints differing in known bits
    // (5 & 6 = 0101 ^ 0110 = 0011 -> 2 bits)
    fails = fails + expect("hamming_5_6", str(simhash_distance(5, 6)), "2")
    fails = fails + expect("hamming_0_7", str(simhash_distance(0, 7)), "3")

    if fails == 0
        print("forge_simhash: all passed")
    else
        print("forge_simhash: " + str(fails) + " FAILED")
