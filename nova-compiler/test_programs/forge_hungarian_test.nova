import forge_hungarian

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn joinl(xs: list) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + ","
        out = out + str(xs[i])
        i = i + 1
    out

// brute-force min-cost assignment via recursion with a used-bitmask
fn brute(cost: list, row: int, used: int, n: int) -> int
    let out = 0
    if row < n
        let best = 1000000000
        let c = 0
        while c < n
            if ((used >> c) & 1) == 0
                let val = cost[row][c] + brute(cost, row + 1, used | (1 << c), n)
                if val < best
                    best = val
            c = c + 1
        out = best
    out

// verify the assignment is a valid permutation and its cost matches
fn assign_cost(cost: list, ans: list) -> int
    let t = 0
    let i = 0
    while i < len(ans)
        t = t + cost[i][ans[i]]
        i = i + 1
    t

fn main()
    let fails = 0

    // classic 3x3
    let c = []
    push(c, [4, 1, 3])
    push(c, [2, 0, 5])
    push(c, [3, 2, 2])
    let r = hungarian(c)
    fails = fails + expect("cost3", str(r[0]), "5")
    fails = fails + expect("assign3", joinl(r[1]), "1,0,2")
    fails = fails + expect("assign3_valid", str(assign_cost(c, r[1])), "5")

    // cross-check several matrices against brute force
    let c2 = []
    push(c2, [10, 19, 8, 15])
    push(c2, [10, 18, 7, 17])
    push(c2, [13, 16, 9, 14])
    push(c2, [12, 19, 8, 18])
    fails = fails + expect("cross4", str(assignment_cost(c2)), str(brute(c2, 0, 0, 4)))

    let c3 = []
    push(c3, [7, 5, 11])
    push(c3, [5, 4, 1])
    push(c3, [9, 3, 2])
    fails = fails + expect("cross3", str(assignment_cost(c3)), str(brute(c3, 0, 0, 3)))

    let c4 = []
    push(c4, [1, 2, 3, 4, 5])
    push(c4, [5, 4, 3, 2, 1])
    push(c4, [2, 3, 4, 5, 1])
    push(c4, [4, 1, 5, 3, 2])
    push(c4, [3, 5, 2, 1, 4])
    let r4 = hungarian(c4)
    fails = fails + expect("cross5", str(r4[0]), str(brute(c4, 0, 0, 5)))
    fails = fails + expect("cross5_valid", str(assign_cost(c4, r4[1])), str(r4[0]))

    // 1x1 and 2x2
    let c5 = []
    push(c5, [42])
    fails = fails + expect("one", str(assignment_cost(c5)), "42")
    let c6 = []
    push(c6, [1, 2])
    push(c6, [2, 1])
    fails = fails + expect("two", str(assignment_cost(c6)), "2")

    if fails == 0
        print("forge_hungarian: all passed")
    else
        print("forge_hungarian: " + str(fails) + " FAILED")
