// WASM frontend: a NOVA-COMPUTED render drives a real DOM tree. Uses the dom_* host-import surface AND the
// value-model (loop + str() + concat) to build <ul><li>item 1</li><li>item 2</li><li>item 3</li> under #app.
extern fn dom_get_by_id(id: string) -> int
extern fn dom_create(tag: string) -> int
extern fn dom_set_text(node: int, txt: string)
extern fn dom_append(parent: int, child: int)
fn render()
    let root = unsafe dom_get_by_id("app")
    let ul = unsafe dom_create("ul")
    let i = 1
    while i <= 3
        let li = unsafe dom_create("li")
        let txt = "item " + str(i)
        unsafe dom_set_text(li, txt)
        unsafe dom_append(ul, li)
        i = i + 1
    unsafe dom_append(root, ul)
fn main()
    render()
