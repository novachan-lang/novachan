import forge_orm
import forge_pg
type BR
    id: int
    payload: string
fn main()
    let db = unwrap(orm_open_with_pool("postgres://postgres:root@127.0.0.1:5432/postgres", 2))
    let n = 5000
    let cols = ["id", "payload"]
    let raw = [[i, "payload-value-{i}"] for i in 0..n]

    _ = orm_exec(db, "DROP TABLE IF EXISTS cb_ins", [])
    _ = orm_exec(db, "CREATE TABLE cb_ins (id int, payload text)", [])
    // multi-row INSERT path, chunked exactly like orm_insert_many does (60000/2 = 30000 rows/chunk)
    let t0 = time_ms()
    let one = "(?, ?)"
    let tuples = join([one for r in raw], ", ")
    let params = []
    for r in raw
        push(params, r[0])
        push(params, r[1])
    let ri = orm_exec(db, "INSERT INTO cb_ins (id, payload) VALUES " + tuples, params)
    let t_ins = time_ms() - t0
    print("multi-row INSERT {n} rows : {t_ins} ms   ok={is_ok(ri)}")

    _ = orm_exec(db, "DROP TABLE IF EXISTS cb_copy", [])
    _ = orm_exec(db, "CREATE TABLE cb_copy (id int, payload text)", [])
    let t1 = time_ms()
    let rc = forge_pg.pg_copy_in_pool(orm_pool(db), "cb_copy", cols, raw)
    let t_copy = time_ms() - t1
    print("COPY FROM STDIN {n} rows  : {t_copy} ms   ok={is_ok(rc)}")

    print("rows: insert={orm_count(db, "cb_ins", "", [])}  copy={orm_count(db, "cb_copy", "", [])}")
    _ = orm_exec(db, "DROP TABLE IF EXISTS cb_ins", [])
    _ = orm_exec(db, "DROP TABLE IF EXISTS cb_copy", [])
    orm_close(db)
