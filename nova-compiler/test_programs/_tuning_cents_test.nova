import std/music/tuning_cents

fn main()
    // ── cents_from_ratio ─────────────────────────────────────────────────────

    // Octave 2:1 = 1200 cents (exact)
    let r1 = cents_from_ratio(2, 1)
    if r1 != 1200
        print("FAIL tuning_cents cents_from_ratio(2,1): got " + str(r1) + " want 1200")
        exit(1)

    // Perfect fifth 3:2 = 701.96 cents -> rounds to 702
    let r2 = cents_from_ratio(3, 2)
    if r2 != 702
        print("FAIL tuning_cents cents_from_ratio(3,2): got " + str(r2) + " want 702")
        exit(1)

    // Unison 1:1 = 0 cents
    let r3 = cents_from_ratio(1, 1)
    if r3 != 0
        print("FAIL tuning_cents cents_from_ratio(1,1): got " + str(r3) + " want 0")
        exit(1)

    // Two octaves 4:1 = 2400 cents
    let r4 = cents_from_ratio(4, 1)
    if r4 != 2400
        print("FAIL tuning_cents cents_from_ratio(4,1): got " + str(r4) + " want 2400")
        exit(1)

    // Perfect fourth 4:3 = 498 cents (498.04 rounds to 498)
    let r5 = cents_from_ratio(4, 3)
    if r5 != 498
        print("FAIL tuning_cents cents_from_ratio(4,3): got " + str(r5) + " want 498")
        exit(1)

    // Major third 5:4 = 386 cents (386.31 rounds to 386)
    let r6 = cents_from_ratio(5, 4)
    if r6 != 386
        print("FAIL tuning_cents cents_from_ratio(5,4): got " + str(r6) + " want 386")
        exit(1)

    // ── cents_add ────────────────────────────────────────────────────────────

    let a1 = cents_add(700, 500)
    if a1 != 1200
        print("FAIL tuning_cents cents_add(700,500): got " + str(a1) + " want 1200")
        exit(1)

    let a2 = cents_add(0, 702)
    if a2 != 702
        print("FAIL tuning_cents cents_add(0,702): got " + str(a2) + " want 702")
        exit(1)

    let a3 = cents_add(386, 316)
    if a3 != 702
        print("FAIL tuning_cents cents_add(386,316): got " + str(a3) + " want 702")
        exit(1)

    // ── interval_cents ───────────────────────────────────────────────────────

    // 440 -> 880 = one octave = 1200 cents
    let i1 = interval_cents(440, 880)
    if i1 != 1200
        print("FAIL tuning_cents interval_cents(440,880): got " + str(i1) + " want 1200")
        exit(1)

    // 220 -> 440 = one octave = 1200 cents
    let i2 = interval_cents(220, 440)
    if i2 != 1200
        print("FAIL tuning_cents interval_cents(220,440): got " + str(i2) + " want 1200")
        exit(1)

    // 440 -> 660 = perfect fifth = 702 cents
    let i3 = interval_cents(440, 660)
    if i3 != 702
        print("FAIL tuning_cents interval_cents(440,660): got " + str(i3) + " want 702")
        exit(1)

    // Same freq = 0 cents
    let i4 = interval_cents(440, 440)
    if i4 != 0
        print("FAIL tuning_cents interval_cents(440,440): got " + str(i4) + " want 0")
        exit(1)

    // ── is_octave ────────────────────────────────────────────────────────────

    let o1 = is_octave(1200)
    if o1 != true
        print("FAIL tuning_cents is_octave(1200): got " + str(o1) + " want true")
        exit(1)

    let o2 = is_octave(700)
    if o2 != false
        print("FAIL tuning_cents is_octave(700): got " + str(o2) + " want false")
        exit(1)

    let o3 = is_octave(2400)
    if o3 != true
        print("FAIL tuning_cents is_octave(2400): got " + str(o3) + " want true")
        exit(1)

    let o4 = is_octave(0)
    if o4 != true
        print("FAIL tuning_cents is_octave(0): got " + str(o4) + " want true")
        exit(1)

    let o5 = is_octave(1201)
    if o5 != false
        print("FAIL tuning_cents is_octave(1201): got " + str(o5) + " want false")
        exit(1)

    // ── cents_to_ratio_approx ────────────────────────────────────────────────

    // 0 cents -> 1:1
    let ra0 = cents_to_ratio_approx(0)
    let rn0 = ra0[0]
    let rd0 = ra0[1]
    if rn0 != 1 or rd0 != 1
        print("FAIL tuning_cents cents_to_ratio_approx(0): got " + str(rn0) + "/" + str(rd0) + " want 1/1")
        exit(1)

    // 1200 cents -> 2:1 (octave, exact)
    let ra1200 = cents_to_ratio_approx(1200)
    let rn1200 = ra1200[0]
    let rd1200 = ra1200[1]
    if rn1200 != 2 or rd1200 != 1
        print("FAIL tuning_cents cents_to_ratio_approx(1200): got " + str(rn1200) + "/" + str(rd1200) + " want 2/1")
        exit(1)

    // 702 cents -> should approximate 3:2
    let ra702 = cents_to_ratio_approx(702)
    let rn702 = ra702[0]
    let rd702 = ra702[1]
    if rn702 != 3 or rd702 != 2
        print("FAIL tuning_cents cents_to_ratio_approx(702): got " + str(rn702) + "/" + str(rd702) + " want 3/2")
        exit(1)

    // 386 cents -> should approximate 5:4 (major third)
    let ra386 = cents_to_ratio_approx(386)
    let rn386 = ra386[0]
    let rd386 = ra386[1]
    if rn386 != 5 or rd386 != 4
        print("FAIL tuning_cents cents_to_ratio_approx(386): got " + str(rn386) + "/" + str(rd386) + " want 5/4")
        exit(1)

    // 498 cents -> should approximate 4:3 (perfect fourth)
    let ra498 = cents_to_ratio_approx(498)
    let rn498 = ra498[0]
    let rd498 = ra498[1]
    if rn498 != 4 or rd498 != 3
        print("FAIL tuning_cents cents_to_ratio_approx(498): got " + str(rn498) + "/" + str(rd498) + " want 4/3")
        exit(1)

    print("PASS _tuning_cents_test")
