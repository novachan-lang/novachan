import std/functional/fgroupby

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got " + gs + " want " + ws)
        exit(1)

fn ckl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + ": length got " + str(len(got)) + " want " + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL " + label + ": index " + str(i) + " got " + str(got[i]) + " want " + str(want[i]))
            exit(1)
        i = i + 1

// ── helpers ──────────────────────────────────────────────────────────────────
fn parity(x)
    x % 2

fn is_even(x)
    x % 2 == 0

fn main()
    // ── fg_group_by ──────────────────────────────────────────────────────────

    // KAT: fg_group_by(parity,[1,2,3,4,5])=[[0,[2,4]],[1,[1,3,5]]]
    let xs1 = [1, 2, 3, 4, 5]
    let g1 = fg_group_by(parity, xs1)
    cki("group_by len", len(g1), 2)
    // pair 0: key=0, members=[2,4]
    let p0 = g1[0]
    cki("group_by p0 key", p0[0], 0)
    let m0 = p0[1]
    cki("group_by p0 members len", len(m0), 2)
    cki("group_by p0 members[0]", m0[0], 2)
    cki("group_by p0 members[1]", m0[1], 4)
    // pair 1: key=1, members=[1,3,5]
    let p1 = g1[1]
    cki("group_by p1 key", p1[0], 1)
    let m1 = p1[1]
    cki("group_by p1 members len", len(m1), 3)
    cki("group_by p1 members[0]", m1[0], 1)
    cki("group_by p1 members[1]", m1[1], 3)
    cki("group_by p1 members[2]", m1[2], 5)

    // KAT: empty list
    let ge = fg_group_by(parity, [])
    cki("group_by empty len", len(ge), 0)

    // KAT: single element
    let gs1 = fg_group_by(parity, [7])
    cki("group_by single len", len(gs1), 1)
    let gsp = gs1[0]
    cki("group_by single key", gsp[0], 1)
    let gsm = gsp[1]
    cki("group_by single members len", len(gsm), 1)
    cki("group_by single members[0]", gsm[0], 7)

    // KAT: all same key
    let ga = fg_group_by(parity, [2, 4, 6])
    cki("group_by all_even len", len(ga), 1)
    let gap = ga[0]
    cki("group_by all_even key", gap[0], 0)
    let gam = gap[1]
    cki("group_by all_even members len", len(gam), 3)

    // ── fg_count_by ──────────────────────────────────────────────────────────

    // KAT: fg_count_by(parity,[1,2,3,4,5])=[[0,2],[1,3]]
    let c1 = fg_count_by(parity, [1, 2, 3, 4, 5])
    cki("count_by len", len(c1), 2)
    let cp0 = c1[0]
    cki("count_by p0 key", cp0[0], 0)
    cki("count_by p0 count", cp0[1], 2)
    let cp1 = c1[1]
    cki("count_by p1 key", cp1[0], 1)
    cki("count_by p1 count", cp1[1], 3)

    // KAT: empty
    let ce = fg_count_by(parity, [])
    cki("count_by empty len", len(ce), 0)

    // KAT: single
    let cs1 = fg_count_by(parity, [4])
    cki("count_by single len", len(cs1), 1)
    let csp = cs1[0]
    cki("count_by single key", csp[0], 0)
    cki("count_by single count", csp[1], 1)

    // ── fg_partition_by ──────────────────────────────────────────────────────

    // KAT: fg_partition_by(is_even,[2,4,1,3,6])=[[2,4],[1,3],[6]]
    let pb1 = fg_partition_by(is_even, [2, 4, 1, 3, 6])
    cki("partition_by len", len(pb1), 3)
    // run 0: [2,4]
    let r0 = pb1[0]
    cki("partition_by r0 len", len(r0), 2)
    cki("partition_by r0[0]", r0[0], 2)
    cki("partition_by r0[1]", r0[1], 4)
    // run 1: [1,3]
    let r1 = pb1[1]
    cki("partition_by r1 len", len(r1), 2)
    cki("partition_by r1[0]", r1[0], 1)
    cki("partition_by r1[1]", r1[1], 3)
    // run 2: [6]
    let r2 = pb1[2]
    cki("partition_by r2 len", len(r2), 1)
    cki("partition_by r2[0]", r2[0], 6)

    // KAT: empty
    let pbe = fg_partition_by(is_even, [])
    cki("partition_by empty len", len(pbe), 0)

    // KAT: single element
    let pbs = fg_partition_by(is_even, [3])
    cki("partition_by single len", len(pbs), 1)
    let pbsr = pbs[0]
    cki("partition_by single run len", len(pbsr), 1)
    cki("partition_by single run[0]", pbsr[0], 3)

    // KAT: all same pred value
    let pbsame = fg_partition_by(is_even, [2, 4, 6])
    cki("partition_by all_even len", len(pbsame), 1)
    let pbsamer = pbsame[0]
    cki("partition_by all_even run len", len(pbsamer), 3)

    // KAT: alternating
    let pbalt = fg_partition_by(is_even, [1, 2, 3, 4])
    cki("partition_by alt len", len(pbalt), 4)
    cki("partition_by alt r0 len", len(pbalt[0]), 1)
    cki("partition_by alt r1 len", len(pbalt[1]), 1)
    cki("partition_by alt r2 len", len(pbalt[2]), 1)
    cki("partition_by alt r3 len", len(pbalt[3]), 1)

    print("PASS _fgroupby_test")

main()
