fn list_contains_str(lst: list, item: string) -> bool
    for x in lst
        if x == item
            return true
    false

fn my_resolve(name: string) -> string
    if name == "del"
        "rt_del"
    else
        name

fn main()
    let locals = {}
    locals["d"] = 1

    let fn_name = "del"

    let r1 = not contains(locals, fn_name)
    print("not contains(locals, del): " + str(r1))

    let fnames = ["main"]
    let r2 = list_contains_str(fnames, fn_name)
    print("list_contains(fnames, del): " + str(r2))

    let resolved = my_resolve(fn_name)
    print("resolve(del): " + resolved)

    let r3 = resolved != fn_name
    print("resolve != name: " + str(r3))

    let r4 = my_resolve(fn_name) != fn_name
    print("inline resolve != name: " + str(r4))

    if not contains(locals, fn_name) and (list_contains_str(fnames, fn_name) or my_resolve(fn_name) != fn_name)
        print("STATIC path - CORRECT")
    else
        print("DYNAMIC path - BUG")

    print("del_cond_test: done")
