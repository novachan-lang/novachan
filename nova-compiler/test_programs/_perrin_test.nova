// _perrin_test.nova — KAT for std/math/perrin.nova
import std/math/perrin

// KAT 1: pe_perrin(0) == 3
let r0 = pe_perrin(0)
if r0 != 3
    print("FAIL pe_perrin(0): expected 3 got " + str(r0))
    exit(1)

// KAT 2: pe_perrin(1) == 0
let r1 = pe_perrin(1)
if r1 != 0
    print("FAIL pe_perrin(1): expected 0 got " + str(r1))
    exit(1)

// KAT 3: pe_perrin(2) == 2
let r2 = pe_perrin(2)
if r2 != 2
    print("FAIL pe_perrin(2): expected 2 got " + str(r2))
    exit(1)

// KAT 4: pe_perrin(3) == 3
let r3 = pe_perrin(3)
if r3 != 3
    print("FAIL pe_perrin(3): expected 3 got " + str(r3))
    exit(1)

// KAT 5: pe_perrin(4) == 2
let r4 = pe_perrin(4)
if r4 != 2
    print("FAIL pe_perrin(4): expected 2 got " + str(r4))
    exit(1)

// KAT 6: pe_perrin(5) == 5
let r5 = pe_perrin(5)
if r5 != 5
    print("FAIL pe_perrin(5): expected 5 got " + str(r5))
    exit(1)

// KAT 7: pe_perrin(9) == 12
let r9 = pe_perrin(9)
if r9 != 12
    print("FAIL pe_perrin(9): expected 12 got " + str(r9))
    exit(1)

// KAT 8: pe_perrin(10) == 17
let r10 = pe_perrin(10)
if r10 != 17
    print("FAIL pe_perrin(10): expected 17 got " + str(r10))
    exit(1)

// KAT 9: pe_list(6) == [3, 0, 2, 3, 2, 5]
let lst = pe_list(6)
let expected0 = 3
let expected1 = 0
let expected2 = 2
let expected3 = 3
let expected4 = 2
let expected5 = 5
let lst0 = lst[0]
let lst1 = lst[1]
let lst2 = lst[2]
let lst3 = lst[3]
let lst4 = lst[4]
let lst5 = lst[5]
if lst0 != expected0
    print("FAIL pe_list(6)[0]: expected 3 got " + str(lst0))
    exit(1)
if lst1 != expected1
    print("FAIL pe_list(6)[1]: expected 0 got " + str(lst1))
    exit(1)
if lst2 != expected2
    print("FAIL pe_list(6)[2]: expected 2 got " + str(lst2))
    exit(1)
if lst3 != expected3
    print("FAIL pe_list(6)[3]: expected 3 got " + str(lst3))
    exit(1)
if lst4 != expected4
    print("FAIL pe_list(6)[4]: expected 2 got " + str(lst4))
    exit(1)
if lst5 != expected5
    print("FAIL pe_list(6)[5]: expected 5 got " + str(lst5))
    exit(1)

// KAT 10: pe_is_perrin membership checks
let is0 = pe_is_perrin(0)
if is0 != true
    print("FAIL pe_is_perrin(0): expected true")
    exit(1)

let is3 = pe_is_perrin(3)
if is3 != true
    print("FAIL pe_is_perrin(3): expected true")
    exit(1)

let is12 = pe_is_perrin(12)
if is12 != true
    print("FAIL pe_is_perrin(12): expected true")
    exit(1)

let is4 = pe_is_perrin(4)
if is4 != false
    print("FAIL pe_is_perrin(4): expected false")
    exit(1)

let is6 = pe_is_perrin(6)
if is6 != false
    print("FAIL pe_is_perrin(6): expected false")
    exit(1)

let is17 = pe_is_perrin(17)
if is17 != true
    print("FAIL pe_is_perrin(17): expected true")
    exit(1)

print("_perrin_test passed")
