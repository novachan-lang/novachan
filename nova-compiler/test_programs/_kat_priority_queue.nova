import forge_priority_queue

fn main()
    let q = pq_new()
    q = pq_push(q, "low", 1)
    q = pq_push(q, "high", 10)
    q = pq_push(q, "mid", 5)
    assert(pq_size(q) == 3, "size 3")
    assert(pq_is_empty(q) == 0, "not empty")

    let r1 = pq_peek(q)
    assert(is_ok(r1), "peek ok")
    assert(unwrap(r1) == "high", "peek=high")
    assert(pq_size(q) == 3, "peek doesnt remove")

    let r2 = pq_pop(q)
    assert(is_ok(r2), "pop ok")
    assert(unwrap(r2) == "high", "pop=high")
    assert(pq_size(q) == 2, "size 2")

    let r3 = pq_pop(q)
    assert(is_ok(r3), "pop ok 2")
    assert(unwrap(r3) == "mid", "pop=mid")

    let r4 = pq_pop(q)
    assert(is_ok(r4), "pop ok 3")
    assert(unwrap(r4) == "low", "pop=low")

    let r5 = pq_pop(q)
    assert(is_err(r5), "empty pop")
    assert(pq_is_empty(q) == 1, "empty")

    print("PRIORITY-QUEUE KAT PASS")
