import forge_priority_queue

fn main()
    let pq = pq_new()
    assert(pq_is_empty(pq) == 1, "starts empty")

    pq = pq_enqueue(pq, "low-task", 10)
    pq = pq_enqueue(pq, "high-task", 1)
    pq = pq_enqueue(pq, "med-task", 5)
    assert(pq_size(pq) == 3, "3 items")
    assert(pq_is_empty(pq) == 0, "not empty")

    let top = pq_peek(pq)
    assert(top["value"] == "high-task", "peek = highest priority")
    assert(top["priority"] == 1, "priority 1")
    assert(pq_size(pq) == 3, "peek doesnt remove")

    let d1 = pq_dequeue(pq)
    assert(d1["value"] == "high-task", "dequeue highest first")
    assert(d1["found"] == 1, "found")
    assert(pq_size(pq) == 2, "2 left")

    let d2 = pq_dequeue(pq)
    assert(d2["value"] == "med-task", "second = medium")

    let d3 = pq_dequeue(pq)
    assert(d3["value"] == "low-task", "third = low")

    let d4 = pq_dequeue(pq)
    assert(d4["found"] == 0, "empty dequeue")
    assert(pq_is_empty(pq) == 1, "empty after all dequeued")

    print("PRIORITY-QUEUE KAT PASS")
