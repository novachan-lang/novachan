import std/money/parse
fn _i(l, g, w)
    if g != w
        print("FAIL parse " + l + " got=" + str(g) + " want=" + str(w))
        exit(1)
fn main()
    _i("a", mparse_minor("1,234.56", 2), 123456)
    _i("b", mparse_minor("$1,234.56", 2), 123456)
    _i("c", mparse_minor("1234.5", 2), 123450)
    _i("d", mparse_minor("-12.34", 2), -1234)
    _i("e", mparse_minor("1000", 2), 100000)
    _i("f", mparse_minor("12.345", 2), 1234)
    _i("dd", mparse_detect_decimals("12.34"), 2)
    _i("dd0", mparse_detect_decimals("12"), 0)
    print("PASS _money_parse_test")
