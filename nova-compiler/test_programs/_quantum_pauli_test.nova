import std/quantum/quantum_state
import std/quantum/quantum_pauli

// cki — integer known-answer check.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _quantum_pauli_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// _round1000 — local test helper: round x*1000 to nearest int (handles negative x).
fn _round1000(x: float) -> int
    if x < 0.0
        let neg = 0.0 - x
        let scaled = neg * 1000.0 + 0.5
        let r = float_to_int(scaled)
        return 0 - r
    let scaled = x * 1000.0 + 0.5
    float_to_int(scaled)

// cks — string known-answer check.
fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL _quantum_pauli_test " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // qpl_matrix sanity: X flips |0>-column onto |1>-column (c01=1, c10=1)
    let mx = qpl_matrix("X")
    cki("X[0][1] re", _round1000(mx[0][1][0]), 1000)
    cki("X[1][0] re", _round1000(mx[1][0][0]), 1000)
    cki("X[0][0] re", _round1000(mx[0][0][0]), 0)

    let mi = qpl_matrix("I")
    cki("I[0][0] re", _round1000(mi[0][0][0]), 1000)
    cki("I[1][1] re", _round1000(mi[1][1][0]), 1000)
    cki("I[0][1] re", _round1000(mi[0][1][0]), 0)

    // qpl_mul: X*X == [1, "I"]
    let xx = qpl_mul("X", "X")
    let xx_phase = xx[0]
    cki("X*X phase re", _round1000(xx_phase[0]), 1000)
    cki("X*X phase im", _round1000(xx_phase[1]), 0)
    cks("X*X char", xx[1], "I")

    // qpl_mul: X*Y == [i, "Z"]
    let xy = qpl_mul("X", "Y")
    let xy_phase = xy[0]
    cki("X*Y phase re", _round1000(xy_phase[0]), 0)
    cki("X*Y phase im", _round1000(xy_phase[1]), 1000)
    cks("X*Y char", xy[1], "Z")

    // qpl_mul: Z*X == [i, "Y"]
    let zx = qpl_mul("Z", "X")
    let zx_phase = zx[0]
    cki("Z*X phase re", _round1000(zx_phase[0]), 0)
    cki("Z*X phase im", _round1000(zx_phase[1]), 1000)
    cks("Z*X char", zx[1], "Y")

    // qpl_mul: Y*X == [-i, "Z"] (reverse order flips phase sign)
    let yx = qpl_mul("Y", "X")
    let yx_phase = yx[0]
    cki("Y*X phase im", _round1000(yx_phase[1]), 0 - 1000)
    cks("Y*X char", yx[1], "Z")

    // qpl_mul with I is neutral
    let ix = qpl_mul("I", "X")
    cks("I*X char", ix[1], "X")
    let xi = qpl_mul("X", "I")
    cks("X*I char", xi[1], "X")

    // qpl_commute / qpl_anticommute
    cki("commute(X,X)", qpl_commute("X", "X"), 1)
    cki("commute(X,Y)", qpl_commute("X", "Y"), 0)
    cki("commute(X,I)", qpl_commute("X", "I"), 1)
    cki("commute(I,I)", qpl_commute("I", "I"), 1)
    cki("anticommute(X,Z)", qpl_anticommute("X", "Z"), 1)
    cki("anticommute(X,X)", qpl_anticommute("X", "X"), 0)
    cki("anticommute(X,I)", qpl_anticommute("X", "I"), 0)

    // qpl_expect_x1000
    cki("expect(|0>,Z,0)", qpl_expect_x1000(qst_basis(1, 0), "Z", 0), 1000)
    cki("expect(|0>,X,0)", qpl_expect_x1000(qst_basis(1, 0), "X", 0), 0)
    cki("expect(|1>,Z,0)", qpl_expect_x1000(qst_basis(1, 1), "Z", 0), 0 - 1000)

    // qpl_expect_x1000 on a specific qubit of a 2-qubit state: |10>, Z on qubit0 -> -1
    cki("expect(b2=|10>,Z,0)", qpl_expect_x1000(qst_basis(2, 2), "Z", 0), 0 - 1000)
    // qubit1 of |10> is |0> -> Z expectation +1
    cki("expect(b2=|10>,Z,1)", qpl_expect_x1000(qst_basis(2, 2), "Z", 1), 1000)

    // qpl_string_matches
    cki("string_matches equal", qpl_string_matches("XYZI", "XYZI"), 1)
    cki("string_matches diff char", qpl_string_matches("XYZI", "XYZX"), 0)
    cki("string_matches diff len", qpl_string_matches("XYZ", "XYZI"), 0)

    print("PASS _quantum_pauli_test")
