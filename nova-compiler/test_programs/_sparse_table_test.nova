import std/collections/sparse_table

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn ckl(label, got, expected)
    let ng = len(got)
    let ne = len(expected)
    if ng != ne
        print("FAIL " + label + ": length " + str(ng) + " != " + str(ne))
        exit(1)
    let i = 0
    while i < ng
        let gv = got[i]
        let ev = expected[i]
        if gv != ev
            print("FAIL " + label + "[" + str(i) + "]: got " + str(gv) + " expected " + str(ev))
            exit(1)
        i = i + 1

fn main()
    // Build table over [5,2,8,1,9,3]
    let arr = [5, 2, 8, 1, 9, 3]
    let st = spt_build(arr)

    // Min queries
    cki("min(0,5)", spt_query_min(st, 0, 5), 1)
    cki("min(0,2)", spt_query_min(st, 0, 2), 2)
    cki("min(4,5)", spt_query_min(st, 4, 5), 3)
    cki("min(2,2)", spt_query_min(st, 2, 2), 8)

    // Max queries
    cki("max(0,5)", spt_query_max(st, 0, 5), 9)
    cki("max(1,3)", spt_query_max(st, 1, 3), 8)

    // Single-element queries
    cki("min(0,0)", spt_query_min(st, 0, 0), 5)
    cki("max(0,0)", spt_query_max(st, 0, 0), 5)
    cki("min(3,3)", spt_query_min(st, 3, 3), 1)
    cki("max(4,4)", spt_query_max(st, 4, 4), 9)

    // Single-element array
    let st1 = spt_build([42])
    cki("single min(0,0)", spt_query_min(st1, 0, 0), 42)
    cki("single max(0,0)", spt_query_max(st1, 0, 0), 42)

    // Two-element array
    let st2 = spt_build([7, 3])
    cki("two min(0,1)", spt_query_min(st2, 0, 1), 3)
    cki("two max(0,1)", spt_query_max(st2, 0, 1), 7)
    cki("two min(0,0)", spt_query_min(st2, 0, 0), 7)
    cki("two max(1,1)", spt_query_max(st2, 1, 1), 3)

    print("PASS _sparse_table_test")
