// Test 'in' operator for containment checking

fn test_list_in()
    nums = [10, 20, 30, 40, 50]
    print(10 in nums)
    print(25 in nums)
    print(50 in nums)

fn test_dict_in()
    d = {"name": "nova", "version": "1.0"}
    print("name" in d)
    print("age" in d)

fn test_string_in()
    s = "hello world"
    print("hello" in s)
    print("xyz" in s)
    print("world" in s)

fn test_in_conditions()
    fruits = ["apple", "banana", "cherry"]
    if "banana" in fruits
        print("found banana")
    if "grape" in fruits
        print("found grape")
    else
        print("no grape")

test_list_in()
print("---")
test_dict_in()
print("---")
test_string_in()
print("---")
test_in_conditions()
print("done")
