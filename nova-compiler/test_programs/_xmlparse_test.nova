// Canonical KAT test for forge_xmlparse (the SAFE inbound XML parser). Explicit exit(1) on mismatch
// (robust vs the soft-fail-assert gotcha). Vectors are the adversarially-verified Wave-1 set.
import forge_xmlparse

fn expect_s(name: string, got: string, want: string)
    if got != want
        print("FAIL " + name + ": got '" + got + "' want '" + want + "'")
        exit(1)
    print("ok " + name)

fn expect_i(name: string, got: int, want: int)
    if got != want
        print("FAIL " + name + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("ok " + name)

fn main()
    let n = xml_parse("<a x='1'><b>hi</b><b>yo</b><c/></a>")
    expect_s("attr x", xml_attr(n, "x"), "1")
    expect_s("find b text", xml_text(xml_find(n, "b")), "hi")
    expect_i("find_all b", len(xml_find_all(n, "b")), 2)
    // entities in text
    expect_s("entities", xml_text(xml_parse("<p>a &lt; b &amp; c</p>")), "a < b & c")
    // double-quoted attribute
    let img = xml_parse("<img src=\"a.png\" alt='pic'/>")
    expect_s("dq attr", xml_attr(img, "src"), "a.png")
    expect_s("sq attr", xml_attr(img, "alt"), "pic")
    // comments ignored
    let r = xml_parse("<r><!-- hi <fake> --><x>1</x></r>")
    expect_i("comment skip find_all x", len(xml_find_all(r, "x")), 1)
    expect_s("x text", xml_text(xml_find(r, "x")), "1")
    // CDATA raw
    expect_s("cdata", xml_text(xml_parse("<d><![CDATA[<not a tag> & raw]]></d>")), "<not a tag> & raw")
    // DOCTYPE/prolog skipped, custom entity NOT expanded (billion-laughs safe)
    let dt = xml_parse("<?xml?><!DOCTYPE r [<!ENTITY x 'boom'>]><r>&x;ok</r>")
    expect_s("no custom entity", xml_text(dt), "&x;ok")
    print("_xmlparse_test passed")
