fn main()
    let pass = true

    // list_for_each — side effect only, verify no crash
    let acc = [0]
    list_for_each([10, 20, 30], fn(x) push(acc, x))
    if len(acc) != 4 or acc[1] != 10 or acc[3] != 30
        print("FAIL: list_for_each")
        pass = false

    // list_map_indexed — index + value
    let indexed = list_map_indexed(["a", "b", "c"], fn(i, v) str(i) + ":" + v)
    if indexed[0] != "0:a" or indexed[1] != "1:b" or indexed[2] != "2:c"
        print("FAIL: list_map_indexed")
        pass = false

    // dict_update — merge b into a (mutates a)
    let da = {"x": 1, "y": 2}
    let db = {"y": 99, "z": 3}
    dict_update(da, db)
    if da["y"] != 99 or da["z"] != 3 or da["x"] != 1
        print("FAIL: dict_update")
        pass = false

    // dict_filter — keep entries matching predicate
    let df = {"a": 1, "b": 2, "c": 3, "d": 4}
    let even_vals = dict_filter(df, fn(k, v) v % 2 == 0)
    if len(keys(even_vals)) != 2
        print("FAIL: dict_filter count")
        pass = false
    if even_vals["b"] != 2 or even_vals["d"] != 4
        print("FAIL: dict_filter vals")
        pass = false

    // dict_map_values — transform values
    let dm = {"a": 1, "b": 2, "c": 3}
    let doubled = dict_map_values(dm, fn(v) v * 10)
    if doubled["a"] != 10 or doubled["b"] != 20 or doubled["c"] != 30
        print("FAIL: dict_map_values")
        pass = false

    if pass
        print("PASS _kat_functional_builtins")
    else
        print("FAIL _kat_functional_builtins")
