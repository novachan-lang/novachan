import forge_versioned_store

fn main()
    let v = vs_new()
    v = vs_put(v, "config", "v1")
    v = vs_put(v, "config", "v2")
    v = vs_put(v, "config", "v3")
    assert(vs_count(v) == 1, "1 key")

    let cur = vs_get(v, "config")
    assert(is_ok(cur), "get ok")
    assert(unwrap(cur) == "v3", "current=v3")

    let ver = vs_version(v, "config")
    assert(unwrap(ver) == 3, "version=3")

    let old = vs_get_version(v, "config", 1)
    assert(is_ok(old), "version 1 ok")
    assert(unwrap(old) == "v1", "version 1=v1")

    let v2 = vs_get_version(v, "config", 2)
    assert(unwrap(v2) == "v2", "version 2=v2")

    let bad = vs_get(v, "missing")
    assert(is_err(bad), "missing is err")

    let bad_ver = vs_get_version(v, "config", 99)
    assert(is_err(bad_ver), "bad version is err")

    print("VERSIONED-STORE KAT PASS")
