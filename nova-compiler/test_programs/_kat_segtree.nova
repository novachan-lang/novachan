import forge_segtree

fn ck(label: string, got: int, want: int)
    let ok = "FAIL"
    if got == want
        ok = "ok"
    print(label + "=" + ok + "(" + str(got) + ")")

fn main()
    let t = segtree_build([5, 2, 8, 1, 9, 3])
    ck("all", segtree_query_min(t, 0, 5), 1)
    ck("left", segtree_query_min(t, 0, 2), 2)
    ck("right", segtree_query_min(t, 3, 5), 1)
    ck("mid", segtree_query_min(t, 4, 5), 3)
    ck("single", segtree_query_min(t, 2, 2), 8)
    // point update: index 3 (was 1) -> 10
    segtree_update(t, 3, 10)
    ck("after_all", segtree_query_min(t, 0, 5), 2)
    ck("after_right", segtree_query_min(t, 3, 5), 3)
    // update index 1 (was 2) -> 0 -> new global min
    segtree_update(t, 1, 0)
    ck("after_min0", segtree_query_min(t, 0, 5), 0)
