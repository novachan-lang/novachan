import forge_logfmt

fn tf(b: bool) -> string
    if b
        return "T"
    "F"
fn has(s: string, sub: string) -> string
    if find(s, sub) >= 0
        return "T"
    "F"

fn main()
    let d = {}
    d["level"] = "info"
    d["msg"] = "hello world"
    d["code"] = "200"
    let line = logfmt_encode(d)
    print("enc_level=" + has(line, "level=info"))
    print("enc_msg=" + has(line, "msg=" + chr(34) + "hello world" + chr(34)))
    print("enc_code=" + has(line, "code=200"))
    let back = logfmt_decode(line)
    print("rt_level=" + tf(back["level"] == "info"))
    print("rt_msg=" + tf(back["msg"] == "hello world"))
    print("rt_code=" + tf(back["code"] == "200"))
    // bool flag + escaped quote inside a quoted value: b="x\"y"
    let inp = "a=1 ok b=" + chr(34) + "x" + chr(92) + chr(34) + "y" + chr(34)
    let d2 = logfmt_decode(inp)
    print("dec_a=" + tf(d2["a"] == "1"))
    print("dec_bool=" + tf(d2["ok"] == "true"))
    print("dec_esc=" + tf(d2["b"] == "x" + chr(34) + "y"))
    // encode a value containing a quote round-trips
    let d3 = {}
    d3["q"] = "say " + chr(34) + "hi" + chr(34)
    let rt3 = logfmt_decode(logfmt_encode(d3))
    print("rt_quote=" + tf(rt3["q"] == "say " + chr(34) + "hi" + chr(34)))
