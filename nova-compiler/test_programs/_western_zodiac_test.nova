import std/calendar/western_zodiac

fn main()
    // ── western_zodiac KAT vectors ───────────────────────────────────────────

    // Mar 25 = Aries
    let g1 = western_zodiac(3, 25)
    if g1 != "Aries"
        print("FAIL western_zodiac western_zodiac(3,25): got " + g1 + " want Aries")
        exit(1)

    // Jan 1 = Capricorn
    let g2 = western_zodiac(1, 1)
    if g2 != "Capricorn"
        print("FAIL western_zodiac western_zodiac(1,1): got " + g2 + " want Capricorn")
        exit(1)

    // Jun 15 = Gemini
    let g3 = western_zodiac(6, 15)
    if g3 != "Gemini"
        print("FAIL western_zodiac western_zodiac(6,15): got " + g3 + " want Gemini")
        exit(1)

    // Dec 25 = Capricorn
    let g4 = western_zodiac(12, 25)
    if g4 != "Capricorn"
        print("FAIL western_zodiac western_zodiac(12,25): got " + g4 + " want Capricorn")
        exit(1)

    // Boundary checks
    // Mar 20 = Pisces (last day before Aries)
    let g5 = western_zodiac(3, 20)
    if g5 != "Pisces"
        print("FAIL western_zodiac western_zodiac(3,20): got " + g5 + " want Pisces")
        exit(1)

    // Mar 21 = Aries (first day of Aries)
    let g6 = western_zodiac(3, 21)
    if g6 != "Aries"
        print("FAIL western_zodiac western_zodiac(3,21): got " + g6 + " want Aries")
        exit(1)

    // Jan 19 = Capricorn (last day of Capricorn)
    let g7 = western_zodiac(1, 19)
    if g7 != "Capricorn"
        print("FAIL western_zodiac western_zodiac(1,19): got " + g7 + " want Capricorn")
        exit(1)

    // Jan 20 = Aquarius
    let g8 = western_zodiac(1, 20)
    if g8 != "Aquarius"
        print("FAIL western_zodiac western_zodiac(1,20): got " + g8 + " want Aquarius")
        exit(1)

    // Dec 21 = Sagittarius
    let g9 = western_zodiac(12, 21)
    if g9 != "Sagittarius"
        print("FAIL western_zodiac western_zodiac(12,21): got " + g9 + " want Sagittarius")
        exit(1)

    // Dec 22 = Capricorn
    let g10 = western_zodiac(12, 22)
    if g10 != "Capricorn"
        print("FAIL western_zodiac western_zodiac(12,22): got " + g10 + " want Capricorn")
        exit(1)

    // ── zodiac_dates KAT vectors ─────────────────────────────────────────────

    // Aries: [3, 21, 4, 19]
    let da = zodiac_dates("Aries")
    let da_sm = da[0]
    let da_sd = da[1]
    let da_em = da[2]
    let da_ed = da[3]
    if da_sm != 3 or da_sd != 21 or da_em != 4 or da_ed != 19
        print("FAIL western_zodiac zodiac_dates(Aries): got " + str(da_sm) + "/" + str(da_sd) + "-" + str(da_em) + "/" + str(da_ed) + " want 3/21-4/19")
        exit(1)

    // Capricorn: [12, 22, 1, 19]
    let dc = zodiac_dates("Capricorn")
    let dc_sm = dc[0]
    let dc_sd = dc[1]
    let dc_em = dc[2]
    let dc_ed = dc[3]
    if dc_sm != 12 or dc_sd != 22 or dc_em != 1 or dc_ed != 19
        print("FAIL western_zodiac zodiac_dates(Capricorn): got " + str(dc_sm) + "/" + str(dc_sd) + "-" + str(dc_em) + "/" + str(dc_ed) + " want 12/22-1/19")
        exit(1)

    // Unknown sign
    let du = zodiac_dates("Ophiuchus")
    let du_sm = du[0]
    if du_sm != 0
        print("FAIL western_zodiac zodiac_dates unknown: got " + str(du_sm) + " want 0")
        exit(1)

    // ── zodiac_element KAT vectors ───────────────────────────────────────────

    // Aries = fire
    let e1 = zodiac_element("Aries")
    if e1 != "fire"
        print("FAIL western_zodiac zodiac_element(Aries): got " + e1 + " want fire")
        exit(1)

    // Taurus = earth
    let e2 = zodiac_element("Taurus")
    if e2 != "earth"
        print("FAIL western_zodiac zodiac_element(Taurus): got " + e2 + " want earth")
        exit(1)

    // Gemini = air
    let e3 = zodiac_element("Gemini")
    if e3 != "air"
        print("FAIL western_zodiac zodiac_element(Gemini): got " + e3 + " want air")
        exit(1)

    // Cancer = water
    let e4 = zodiac_element("Cancer")
    if e4 != "water"
        print("FAIL western_zodiac zodiac_element(Cancer): got " + e4 + " want water")
        exit(1)

    // Capricorn = earth
    let e5 = zodiac_element("Capricorn")
    if e5 != "earth"
        print("FAIL western_zodiac zodiac_element(Capricorn): got " + e5 + " want earth")
        exit(1)

    // Unknown
    let e6 = zodiac_element("Ophiuchus")
    if e6 != "unknown"
        print("FAIL western_zodiac zodiac_element unknown: got " + e6 + " want unknown")
        exit(1)

    print("PASS _western_zodiac_test")
