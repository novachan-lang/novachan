import forge_event_journal

fn main()
    let j = ej_new()
    j = ej_append(j, "user_created", "alice", 1000)
    j = ej_append(j, "user_login", "alice", 1010)
    j = ej_append(j, "user_created", "bob", 1020)
    assert(ej_count(j) == 3, "3 events")

    let r1 = ej_get(j, 0)
    assert(is_ok(r1), "get 0 ok")
    assert(unwrap(r1) == "alice", "first payload")

    let t1 = ej_type_at(j, 1)
    assert(is_ok(t1), "type at 1")
    assert(unwrap(t1) == "user_login", "correct type")

    assert(ej_count_by_type(j, "user_created") == 2, "2 user_created")
    assert(ej_count_by_type(j, "user_login") == 1, "1 login")
    assert(ej_count_by_type(j, "nope") == 0, "0 nope")

    let bad = ej_get(j, 99)
    assert(is_err(bad), "out of range")

    print("EVENT-JOURNAL KAT PASS")
