import forge_barrier

fn main()
    let b = bar_new(3)
    assert(bar_parties(b) == 3, "3 parties")
    assert(bar_arrived_count(b) == 0, "0 arrived")
    assert(bar_remaining(b) == 3, "3 remaining")
    assert(bar_generation(b) == 0, "gen 0")

    let r1 = bar_arrive(b)
    b = r1["b"]
    assert(r1["released"] == 0, "not released at 1")
    assert(bar_arrived_count(b) == 1, "1 arrived")

    let r2 = bar_arrive(b)
    b = r2["b"]
    assert(r2["released"] == 0, "not released at 2")
    assert(bar_remaining(b) == 1, "1 remaining")

    let r3 = bar_arrive(b)
    b = r3["b"]
    assert(r3["released"] == 1, "released at 3")
    assert(bar_generation(b) == 1, "gen 1")
    assert(bar_arrived_count(b) == 0, "reset to 0")

    let r4 = bar_arrive(b)
    b = r4["b"]
    assert(r4["released"] == 0, "new round not released")
    assert(bar_arrived_count(b) == 1, "1 in new round")

    assert(bar_is_broken(b) == 0, "not broken")
    b = bar_break(b)
    assert(bar_is_broken(b) == 1, "broken")
    b = bar_reset(b)
    assert(bar_is_broken(b) == 0, "reset unbroken")
    assert(bar_arrived_count(b) == 0, "reset arrived 0")

    print("BARRIER KAT PASS")
