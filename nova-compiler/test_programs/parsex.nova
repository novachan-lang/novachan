// parsex — parser combinators (PEG-style) in pure NOVA. A Parser is a single-arg
// closure  st => [ok, value, newpos]  where st = [src, pos]. Combinators compose
// parsers; each returns a single-expression lambda calling a named helper. Ordered
// choice (alt) gives PEG semantics. Recurse via named fns referencing combinators.

fn _st(src, pos)
    return [src, pos]
fn parse(p, src)
    return p(_st(src, 0))

fn _lit_run(litv, st)
    let src = st[0]
    let pos = st[1]
    let l = len(litv)
    if pos + l <= len(src) and slice(src, pos, pos + l) == litv
        return [1, litv, pos + l]
    return [0, "", pos]
fn lit(s)
    return st => _lit_run(s, st)

fn _seq2_run(p1, p2, st)
    let r1 = p1(st)
    if r1[0] == 0
        return [0, "", st[1]]
    let r2 = p2(_st(st[0], r1[2]))
    if r2[0] == 0
        return [0, "", st[1]]
    return [1, [r1[1], r2[1]], r2[2]]
fn seq2(p1, p2)
    return st => _seq2_run(p1, p2, st)

fn _alt2_run(p1, p2, st)
    let r1 = p1(st)
    if r1[0] == 1
        return r1
    return p2(st)
fn alt2(p1, p2)
    return st => _alt2_run(p1, p2, st)

fn _many_run(p, st)
    let vals = []
    let cur = st[1]
    let src = st[0]
    let go = 1
    while go == 1
        let r = p(_st(src, cur))
        if r[0] == 1 and r[2] > cur
            push(vals, r[1])
            cur = r[2]
        else
            go = 0
    return [1, vals, cur]
fn many(p)
    return st => _many_run(p, st)

fn _opt_run(p, st)
    let r = p(st)
    if r[0] == 1
        return r
    return [1, "", st[1]]
fn opt(p)
    return st => _opt_run(p, st)

fn main()
    let a = lit("a")
    assert_eq(parse(a, "a")[0], 1)
    assert_eq(parse(a, "b")[0], 0)

    let ab = seq2(lit("a"), lit("b"))
    let r = parse(ab, "ab")
    assert_eq(r[0], 1)
    assert_eq(r[2], 2)
    assert_eq(parse(ab, "ax")[0], 0)

    let aOrB = alt2(lit("a"), lit("b"))
    assert_eq(parse(aOrB, "b")[0], 1)
    assert_eq(parse(aOrB, "c")[0], 0)

    let manyA = many(lit("a"))
    let rm = parse(manyA, "aaab")
    assert_eq(rm[0], 1)
    assert_eq(len(rm[1]), 3)
    assert_eq(rm[2], 3)

    let maybeA = opt(lit("a"))
    assert_eq(parse(maybeA, "xyz")[0], 1)
    assert_eq(parse(maybeA, "xyz")[2], 0)

    print("parsex passed")
