fn pluralize(word, count)
  if count == 1
    return word
  let n = len(word)
  if n == 0
    return word
  let last = lower(slice(word, n - 1, n))
  let last2 = ""
  if n >= 2
    last2 = lower(slice(word, n - 2, n))
  if last2 == "ch" or last2 == "sh" or last2 == "ss"
    return word + "es"
  if last == "s" or last == "x" or last == "z"
    return word + "es"
  if last == "y"
    if n >= 2
      let before_y = lower(slice(word, n - 2, n - 1))
      if before_y != "a" and before_y != "e" and before_y != "i" and before_y != "o" and before_y != "u"
        return slice(word, 0, n - 1) + "ies"
    return word + "s"
  if last == "f"
    return slice(word, 0, n - 1) + "ves"
  if last2 == "fe"
    return slice(word, 0, n - 2) + "ves"
  word + "s"

fn count_noun(count, singular)
  str(count) + " " + pluralize(singular, count)

fn main()
  assert(pluralize("cat", 1) == "cat", "singular")
  assert(pluralize("cat", 2) == "cats", "regular plural")
  assert(pluralize("bus", 2) == "buses", "s -> es")
  assert(pluralize("box", 2) == "boxes", "x -> es")
  assert(pluralize("church", 2) == "churches", "ch -> es")
  assert(pluralize("dish", 2) == "dishes", "sh -> es")
  assert(pluralize("baby", 2) == "babies", "y -> ies")
  assert(pluralize("day", 2) == "days", "vowel+y -> s")
  assert(pluralize("leaf", 2) == "leaves", "f -> ves")
  assert(pluralize("dog", 5) == "dogs", "regular")

  assert(count_noun(1, "item") == "1 item", "1 item")
  assert(count_noun(3, "item") == "3 items", "3 items")
  assert(count_noun(0, "error") == "0 errors", "0 errors")
  assert(count_noun(1, "class") == "1 class", "1 class")
  assert(count_noun(2, "class") == "2 classes", "2 classes")

  print("pluralx: all passed")
