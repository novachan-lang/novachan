import std/core/list
fn main()
    print("contains    " + str(list_contains([1,2,3], 2)) + " " + str(list_contains([1,2,3], 9)) + " " + str(list_contains([], 1)))
    print("index_of    " + str(list_index_of([1,2,3], 3)) + " " + str(list_index_of([1,2,3], 9)) + " " + str(list_index_of([], 1)))
    print("unique      " + str(list_unique([3,1,3,2,1])) + " " + str(list_unique([])))
    print("concat      " + str(list_concat([1,2],[3])) + " " + str(list_concat([],[])))
    print("flatten     " + str(list_flatten([[1,2],[3],[]])) + " " + str(list_flatten([])))
    print("sum         " + str(list_sum([1,2,3])) + " " + str(list_sum([])))
    print("chunk       " + str(list_chunk([1,2,3,4,5], 2)) + " " + str(list_chunk([], 2)))
    print("take        " + str(list_take([1,2,3], 2)) + " " + str(list_take([1,2,3], 9)) + " " + str(list_take([1,2,3], 0)) + " " + str(list_take([1,2,3], -1)))
    print("drop        " + str(list_drop([1,2,3], 1)) + " " + str(list_drop([1,2,3], 9)) + " " + str(list_drop([1,2,3], -1)))
    print("intersperse " + str(list_intersperse([1,2,3], 0)) + " " + str(list_intersperse([], 0)) + " " + str(list_intersperse([7], 0)))
    print("windows     " + str(list_windows([1,2,3,4], 2)) + " " + str(list_windows([1,2], 3)) + " " + str(list_windows([1,2], 0)))
    print("group_by    " + str(list_group_by([1,2,3,4], x => x % 2)))
    print("zip         " + str(list_zip([1,2,3],[4,5])) + " " + str(list_zip([],[1])))
    print("repeat      " + str(list_repeat(7, 3)) + " " + str(list_repeat(7, 0)) + " " + str(list_repeat(7, -1)))
