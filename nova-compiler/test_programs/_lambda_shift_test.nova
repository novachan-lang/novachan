import std/lambda/lambda_shift

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn ckb(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// _term_equal: recursive structural equality for terms (lists or scalars).
fn _term_equal(a, b) -> int
    let ta = type_of(a)
    let tb = type_of(b)
    if ta != tb
        return 0
    if ta == "list"
        let na = len(a)
        let nb = len(b)
        if na != nb
            return 0
        let i = 0
        let ok = 1
        while i < na
            let sub = _term_equal(a[i], b[i])
            if sub == 0
                ok = 0
            i = i + 1
        return ok
    if ta == "int"
        if a == b
            return 1
        return 0
    if ta == "string"
        if a == b
            return 1
        return 0
    return 0

fn ckt(label, a, b)
    let eq = _term_equal(a, b)
    if eq == 0
        print("FAIL " + label + ": terms not equal")
        exit(1)

fn mk_var(k) -> list
    let t = []
    push(t, "var")
    push(t, k)
    return t

fn mk_lam(body) -> list
    let t = []
    push(t, "lam")
    push(t, body)
    return t

fn mk_app(f, a) -> list
    let t = []
    push(t, "app")
    push(t, f)
    push(t, a)
    return t

fn main()
    // KAT 1: lsh_shift(1,0,["var",0]) == ["var",1]
    // Free var 0 gets lifted to 1
    let r1 = lambda_shift.lsh_shift(1, 0, mk_var(0))
    ckt("shift_var0_d1_c0", r1, mk_var(1))

    // KAT 2: lsh_shift(1,0,["lam",["var",0]]) == ["lam",["var",0]]
    // Under lam, cutoff becomes 1; var 0 < 1 so it is BOUND — untouched
    let r2 = lambda_shift.lsh_shift(1, 0, mk_lam(mk_var(0)))
    ckt("shift_lam_var0_d1_c0", r2, mk_lam(mk_var(0)))

    // KAT 3: lsh_shift(1,0,["lam",["var",1]]) == ["lam",["var",2]]
    // Under lam, cutoff=1; var 1 >= 1 so it is FREE — gets shifted: 1+1=2
    let r3 = lambda_shift.lsh_shift(1, 0, mk_lam(mk_var(1)))
    ckt("shift_lam_var1_d1_c0", r3, mk_lam(mk_var(2)))

    // KAT 4: lsh_shift(2,0,["app",["var",0],["var",1]]) == ["app",["var",2],["var",3]]
    // Both vars are free (>= 0), both get +2
    let app01 = mk_app(mk_var(0), mk_var(1))
    let r4 = lambda_shift.lsh_shift(2, 0, app01)
    ckt("shift_app_d2_c0", r4, mk_app(mk_var(2), mk_var(3)))

    // KAT 5: lsh_lift(["var",5]) == ["var",6]
    let r5 = lambda_shift.lsh_lift(mk_var(5))
    ckt("lift_var5", r5, mk_var(6))

    // Additional: shift with d=0 is identity
    let r6 = lambda_shift.lsh_shift(0, 0, mk_var(3))
    ckt("shift_d0_identity", r6, mk_var(3))

    // Additional: shift with negative d (used in beta)
    // shift(-1, 0, ["var",1]) == ["var",0]
    let r7 = lambda_shift.lsh_shift(-1, 0, mk_var(1))
    ckt("shift_d_neg1", r7, mk_var(0))

    // Additional: lsh_free_vars on identity lambda has no free vars
    let id_lam = mk_lam(mk_var(0))
    let fv1 = lambda_shift.lsh_free_vars(id_lam)
    cki("free_vars_id_lam_len", len(fv1), 0)

    // Additional: lsh_free_vars(["var",0]) == [0]
    let fv2 = lambda_shift.lsh_free_vars(mk_var(0))
    cki("free_vars_var0_len", len(fv2), 1)
    cki("free_vars_var0_0", fv2[0], 0)

    // Additional: lsh_free_vars(["lam",["var",1]]) == [0]
    // Under the lam (d=1), var 1 is free; top-level index = 1 - 1 = 0
    let fv3 = lambda_shift.lsh_free_vars(mk_lam(mk_var(1)))
    cki("free_vars_lam_var1_len", len(fv3), 1)
    cki("free_vars_lam_var1_0", fv3[0], 0)

    // Additional: lsh_free_vars(["app",["var",0],["var",2]]) == [0,2]
    let fv4 = lambda_shift.lsh_free_vars(mk_app(mk_var(0), mk_var(2)))
    cki("free_vars_app_len", len(fv4), 2)
    cki("free_vars_app_0", fv4[0], 0)
    cki("free_vars_app_1", fv4[1], 2)

    // Additional: shift bound vs free under nested lams
    // shift(1,0, ["lam",["lam",["var",0]]]) — var 0 bound at depth 2, untouched
    let r8 = lambda_shift.lsh_shift(1, 0, mk_lam(mk_lam(mk_var(0))))
    ckt("shift_lam_lam_var0", r8, mk_lam(mk_lam(mk_var(0))))

    // shift(1,0, ["lam",["lam",["var",2]]]) — var 2 at depth 2, cutoff=2, 2>=2 => free, +1=3
    let r9 = lambda_shift.lsh_shift(1, 0, mk_lam(mk_lam(mk_var(2))))
    ckt("shift_lam_lam_var2", r9, mk_lam(mk_lam(mk_var(3))))

    print("PASS _lambda_shift_test")

main()
