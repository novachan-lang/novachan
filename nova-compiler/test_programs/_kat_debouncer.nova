import forge_debouncer

fn main()
    let d = db_new(100)
    let r1 = db_call(d, "btn", 1000)
    assert(is_ok(r1), "first call ok")

    let r2 = db_call(d, "btn", 1050)
    assert(is_err(r2), "debounced at 50ms")

    let r3 = db_call(d, "btn", 1150)
    assert(is_ok(r3), "accepted after delay")

    assert(db_total_calls(d) == 3, "3 calls")
    assert(db_acceptance_rate(d) == 66, "66% accepted")

    let r4 = db_call(d, "other", 1000)
    assert(is_ok(r4), "different key ok")

    d = db_reset(d, "btn")
    let r5 = db_call(d, "btn", 1000)
    assert(is_ok(r5), "ok after reset")

    print("DEBOUNCER KAT PASS")
