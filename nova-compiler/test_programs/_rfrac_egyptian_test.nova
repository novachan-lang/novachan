import std/rational/rfrac_egyptian

fn ckr(label: string, got: list, wn: int, wd: int)
    if got[0] != wn or got[1] != wd
        print("FAIL rfrac_egyptian " + label + ": got=" + str(got[0]) + "/" + str(got[1]) + " want=" + str(wn) + "/" + str(wd))
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL rfrac_egyptian " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck_elist(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL rfrac_egyptian " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL rfrac_egyptian " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // rfe_egyptian KAT vectors
    ck_elist("egyptian(3,4)", rfe_egyptian(3, 4), [2, 4])
    ck_elist("egyptian(5,6)", rfe_egyptian(5, 6), [2, 3])
    ck_elist("egyptian(2,3)", rfe_egyptian(2, 3), [2, 6])
    ck_elist("egyptian(4,13)", rfe_egyptian(4, 13), [4, 18, 468])

    // rfe_egyptian_sum KAT vectors
    ckr("sum([2,4])", rfe_egyptian_sum([2, 4]), 3, 4)
    ckr("sum([2,3,6])", rfe_egyptian_sum([2, 3, 6]), 1, 1)

    // rfe_is_unit
    cki("is_unit([1,7])", rfe_is_unit([1, 7]), 1)
    cki("is_unit([2,7])", rfe_is_unit([2, 7]), 0)
    cki("is_unit([1,1])", rfe_is_unit([1, 1]), 1)

    // Round-trip: rfe_egyptian_sum(rfe_egyptian(5,6)) == [5,6]
    let e56 = rfe_egyptian(5, 6)
    ckr("roundtrip(5,6)", rfe_egyptian_sum(e56), 5, 6)

    // Additional round-trips
    let e34 = rfe_egyptian(3, 4)
    ckr("roundtrip(3,4)", rfe_egyptian_sum(e34), 3, 4)

    let e413 = rfe_egyptian(4, 13)
    ckr("roundtrip(4,13)", rfe_egyptian_sum(e413), 4, 13)

    // rfe_egyptian_length
    cki("length(3,4)", rfe_egyptian_length(3, 4), 2)
    cki("length(5,6)", rfe_egyptian_length(5, 6), 2)
    cki("length(4,13)", rfe_egyptian_length(4, 13), 3)

    // Edge: unit fraction
    ck_elist("egyptian(1,5)", rfe_egyptian(1, 5), [5])
    ckr("sum([5])", rfe_egyptian_sum([5]), 1, 5)

    print("PASS _rfrac_egyptian_test")
