fn isEven(n)
    n % 2 == 0

fn toFloat(n)
    n * 1.0

fn sqrtApprox(x)
    g = x / 2.0
    g = (g + x / g) / 2.0
    g = (g + x / g) / 2.0
    g = (g + x / g) / 2.0
    g = (g + x / g) / 2.0
    g = (g + x / g) / 2.0
    g

fn distance(x1, y1, x2, y2)
    dx = x2 - x1
    dy = y2 - y1
    sqrtApprox(dx * dx + dy * dy)

fn power(base, exp)
    result = 1
    i = 0
    while i < exp
        result *= base
        i += 1
    result

print("--- Integer ops ---")
print(power(2, 10))
print(power(3, 5))
print(isEven(42))
print(isEven(17))

print("--- Float ops ---")
print(distance(0.0, 0.0, 3.0, 4.0))
print(toFloat(42))

print("--- Mixed computation ---")
print(power(2, 20))
