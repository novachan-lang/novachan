import forge_movingavg

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn near(a: float, b: float) -> bool
    let d = a - b
    d > -0.0001 and d < 0.0001

fn main()
    let fails = 0

    // SMA window 3 over 1,2,3,4,5 -> 1, 1.5, 2, 3, 4
    let s = sma_new(3)
    fails = fails + expect_true("sma1", near(sma_add(s, 1), 1.0))
    fails = fails + expect_true("sma2", near(sma_add(s, 2), 1.5))
    fails = fails + expect_true("sma3", near(sma_add(s, 3), 2.0))
    fails = fails + expect_true("sma4", near(sma_add(s, 4), 3.0))
    fails = fails + expect_true("sma5", near(sma_add(s, 5), 4.0))
    fails = fails + expect("sma_count", str(sma_count(s)), "3")
    fails = fails + expect_true("sma_full", sma_full(s))
    fails = fails + expect_true("sma_value", near(sma_value(s), 4.0))

    // SMA not yet full
    let s2 = sma_new(5)
    sma_add(s2, 10)
    sma_add(s2, 20)
    fails = fails + expect_true("sma_partial", near(sma_value(s2), 15.0))
    fails = fails + expect_true("sma_notfull", sma_full(s2) == false)

    // EMA alpha 0.5 over 1,2,3 -> 1, 1.5, 2.25
    let e = ema_new(0.5)
    fails = fails + expect_true("ema1", near(ema_add(e, 1), 1.0))
    fails = fails + expect_true("ema2", near(ema_add(e, 2), 1.5))
    fails = fails + expect_true("ema3", near(ema_add(e, 3), 2.25))
    fails = fails + expect_true("ema_value", near(ema_value(e), 2.25))

    // ema_new_span(3) -> alpha 0.5, same result
    let e2 = ema_new_span(3)
    ema_add(e2, 1)
    ema_add(e2, 2)
    fails = fails + expect_true("ema_span", near(ema_add(e2, 3), 2.25))

    // EMA converges toward a constant input
    let e3 = ema_new(0.3)
    let k = 0
    while k < 100
        ema_add(e3, 50)
        k = k + 1
    fails = fails + expect_true("ema_converge", near(ema_value(e3), 50.0))

    // SMA with float inputs
    let s3 = sma_new(2)
    sma_add(s3, 1.5)
    fails = fails + expect_true("sma_float", near(sma_add(s3, 2.5), 2.0))

    if fails == 0
        print("forge_movingavg: all passed")
    else
        print("forge_movingavg: " + str(fails) + " FAILED")
