import forge_feature_store

fn main()
    let f = fs_new()
    f = fs_set(f, "user:1", "age", "30", 1)
    f = fs_set(f, "user:1", "score", "95", 1)
    f = fs_set(f, "user:2", "age", "25", 1)

    let r1 = fs_get(f, "user:1", "age")
    assert(is_ok(r1), "get ok")
    assert(unwrap(r1) == "30", "age=30")

    let r2 = fs_get(f, "user:1", "missing")
    assert(is_err(r2), "missing feature is err")

    let v = fs_get_version(f, "user:1", "age")
    assert(is_ok(v), "version ok")
    assert(unwrap(v) == 1, "version=1")

    assert(fs_has(f, "user:2", "age") == 1, "user2 has age")
    assert(fs_has(f, "user:2", "score") == 0, "user2 no score")

    assert(fs_total_sets(f) == 3, "3 sets")

    f = fs_set(f, "user:1", "age", "31", 2)
    let r3 = fs_get(f, "user:1", "age")
    assert(unwrap(r3) == "31", "updated age")

    print("FEATURE-STORE KAT PASS")
