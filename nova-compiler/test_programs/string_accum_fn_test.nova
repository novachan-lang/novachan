type Token
    kind: string
    value: string

fn tokenize(input: string) -> list
    let tokens = []
    let current = ""
    let i = 0
    while i < len(input)
        let ch = input[i]
        if ch == " "
            if len(current) > 0
                push(tokens, Token("word", current))
                current = ""
        else
            current = current + ch
        i = i + 1
    if len(current) > 0
        push(tokens, Token("word", current))
    tokens

let toks = tokenize("ab cd ef")
print("count: " + str(len(toks)))
match toks[0]
    Token(kind, value) =>
        print("t0: " + value)
match toks[1]
    Token(kind, value) =>
        print("t1: " + value)
match toks[2]
    Token(kind, value) =>
        print("t2: " + value)
