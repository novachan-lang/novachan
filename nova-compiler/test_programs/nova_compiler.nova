    ire_line(e, "declare i64 @nova_rt_crc32(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_fnv1a(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_murmur3(i64, i64) nounwind")
    // Track 7: Arena allocator
    ire_line(e, "declare i64 @nova_rt_arena_create() nounwind")
    ire_line(e, "declare i64 @nova_rt_arena_alloc(i64, i64) nounwind")
    ire_line(e, "declare void @nova_rt_arena_reset(i64) nounwind")
    ire_line(e, "declare void @nova_rt_arena_free(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_arena_used(i64) nounwind")
    // Track 8: Overflow / Weak Refs / Process Monitoring / Stack Guard
    ire_line(e, "declare i64 @nova_rt_checked_add(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_checked_sub(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_checked_mul(i64, i64) nounwind")
    ire_line(e, "declare void @nova_rt_overflow_panic() nounwind")
    ire_line(e, "declare i64 @nova_rt_weak_create(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_weak_upgrade(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_weak_alive(i64) nounwind")
    ire_line(e, "declare void @nova_rt_weak_invalidate(i64) nounwind")
    ire_line(e, "declare void @nova_rt_process_link(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_process_monitor(i64, i64) nounwind")
    ire_line(e, "declare void @nova_rt_process_demonitor(i64) nounwind")
    ire_line(e, "declare void @nova_rt_process_exit_notify(i64, i64) nounwind")
    ire_line(e, "declare void @nova_rt_stack_enter() nounwind")
    ire_line(e, "declare void @nova_rt_stack_exit() nounwind")
    ire_line(e, "declare void @nova_rt_stack_set_max(i64) nounwind")
    ire_line(e, "declare void @nova_rt_deprecated_warn(i64, i64) nounwind")
    // Phase 7.5: FFI helpers
    ire_line(e, "declare i64 @nova_rt_cstr_of(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_null_ptr() nounwind")
    ire_line(e, "declare i64 @nova_rt_is_null(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_ptr_read(i64) nounwind")
    ire_line(e, "declare void @nova_rt_ptr_write(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_ptr_add(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_ptr_diff(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_memcpy_unsafe(i64, i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_memset_unsafe(i64, i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_sizeof_ptr() nounwind")
    ire_line(e, "declare i64 @nova_rt_alloc_raw(i64) nounwind")
    ire_line(e, "declare void @nova_rt_free_raw(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_str_from_cstr(i64) nounwind")
    // Phase 8: Build system, formatter, cross-compile
    ire_line(e, "declare i64 @nova_rt_build_toml_parse(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_build_toml_format(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_build_get_sources(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_build_file_mtime(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_build_needs_rebuild(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_build_changed_sources(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_fmt_format(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_fmt_check(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_target_current() nounwind")
    ire_line(e, "declare i64 @nova_rt_target_list() nounwind")
    ire_line(e, "declare i64 @nova_rt_target_is_wasm(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_target_arch(i64) nounwind")
    // Phase 9: Benchmarking, coverage, profiling, DAP
    ire_line(e, "declare i64 @nova_rt_bench_run(i64, i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_bench_report() nounwind")
    ire_line(e, "declare i64 @nova_rt_bench_reset() nounwind")
    ire_line(e, "declare i64 @nova_rt_cov_mark(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_cov_get(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_cov_report() nounwind")
    ire_line(e, "declare i64 @nova_rt_cov_reset() nounwind")
    ire_line(e, "declare i64 @nova_rt_prof_start(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_prof_stop(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_prof_report() nounwind")
    ire_line(e, "declare i64 @nova_rt_prof_get_ns(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_prof_reset() nounwind")
    ire_line(e, "declare i64 @nova_rt_dap_log(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_dap_breakpoint(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_dap_send(i64) nounwind")
    // Phase 10: Documentation generator
    ire_line(e, "declare i64 @nova_rt_doc_extract(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_doc_to_markdown(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_doc_to_html(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_doc_entry_count(i64) nounwind")
    // Phase 11: TLS, WebSocket, multi-node, hot reload
    ire_line(e, "declare i64 @nova_rt_tls_connect(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_tls_listen(i64, i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_tls_accept(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_tls_send(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_tls_recv(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_tls_close(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_ws_upgrade(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_ws_send(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_ws_recv(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_ws_close(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_node_connect(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_node_send(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_node_recv(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_node_close(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_node_listen(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_node_accept(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_hot_reload_watch(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_hot_reload_check() nounwind")
    ire_line(e, "declare i64 @nova_rt_hot_reload_path(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_wasm_compile(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_wasm_run(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_wasm_free(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_gpu_alloc(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_gpu_free(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_gpu_write(i64, i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_gpu_read(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_gpu_kernel_run(i64, i64, i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_gpu_sync() nounwind")
    ire_line(e, "declare i64 @nova_rt_json_encode(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_json_encode_float(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_json_encode_bool(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_json_decode(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_http_close(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_route_match(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_arr_create(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_arr_free(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_arr_set(i64, i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_arr_get(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_arr_fill(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_arr_size(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_arr_add(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_arr_dot(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_model_load(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_model_close(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_model_infer(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_ecs_world() nounwind")
    ire_line(e, "declare i64 @nova_rt_ecs_entity(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_ecs_set(i64, i64, i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_ecs_get(i64, i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_ecs_has(i64, i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_ecs_query(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_ecs_destroy(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_deploy_config(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_deploy_validate(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_semver_compatible(i64, i64) nounwind")
    ire_line(e, "")

    // FFI: emit declares for extern functions, with synthesized i64-calling-
    // convention wrappers when the C signature uses non-i64 types. NOVA's
    // internal calling convention is i64-everywhere; the wrappers bridge to
    // each C function's real signature using LLVM bitcast / inttoptr.
    if len(b.ir_externs) > 0
        ire_line(e, "; Extern (FFI) declarations")
        for ext_stmt in b.ir_externs
            match ext_stmt
                Stmt(et, en, eexpr, ebody, eparams, eelse, eann, esline) =>
                    let real_ret = "i64"
                    match eexpr
                        Expr(rxt, rxv, rxn, rxc, rxf, rxl) =>
                            if rxt == "rettype"
                                real_ret = ffi_llvm_type(rxv)
                    let real_arg_types = []
                    for p in eparams
                        match p
                            Param(pn, pt, pd) =>
                                push(real_arg_types, ffi_llvm_type(pt))
                    let needs_wrapper = real_ret != "i64"
                    let ai = 0
                    while ai < len(real_arg_types) and not needs_wrapper
                        if real_arg_types[ai] != "i64"
                            needs_wrapper = true
                        ai = ai + 1

                    // Emit the raw C function declare with native types
                    let real_arg_sig = ""
                    let aj = 0
                    while aj < len(real_arg_types)
                        if aj > 0
                            real_arg_sig = real_arg_sig + ", "
                        real_arg_sig = real_arg_sig + real_arg_types[aj]
                        aj = aj + 1
                    ire_line(e, "declare " + real_ret + " @" + en + "(" + real_arg_sig + ") nounwind")

                    // If non-i64 types are involved, emit a NOVA-callable wrapper
                    // that takes i64 args and marshals them to/from the C types.
                    if needs_wrapper
                        let nova_args = ""
                        let ak = 0
                        while ak < len(real_arg_types)
                            if ak > 0
                                nova_args = nova_args + ", "
                            nova_args = nova_args + "i64 %a" + str(ak)
                            ak = ak + 1
                        ire_line(e, "define i64 @nova_ffi_" + en + "(" + nova_args + ") nounwind \{")
                        ire_line(e, "entry:")
                        // Marshal each arg from i64 to its real LLVM type
                        let am = 0
                        let call_args = ""
                        while am < len(real_arg_types)
                            if am > 0
                                call_args = call_args + ", "
                            let rt = real_arg_types[am]
                            if rt == "i64"
                                call_args = call_args + "i64 %a" + str(am)
                            else if rt == "double"
                                ire_line(e, "  %f" + str(am) + " = bitcast i64 %a" + str(am) + " to double")
                                call_args = call_args + "double %f" + str(am)
                            else if rt == "ptr"
                                ire_line(e, "  %p" + str(am) + " = inttoptr i64 %a" + str(am) + " to ptr")
                                call_args = call_args + "ptr %p" + str(am)
                            else
                                call_args = call_args + rt + " %a" + str(am)
                            am = am + 1
                        // Call the real C function
                        if real_ret == "void"
                            ire_line(e, "  call void @" + en + "(" + call_args + ")")
                            ire_line(e, "  ret i64 0")
                        else if real_ret == "double"
                            ire_line(e, "  %r = call double @" + en + "(" + call_args + ")")
                            ire_line(e, "  %ri = bitcast double %r to i64")
                            ire_line(e, "  ret i64 %ri")
                        else if real_ret == "ptr"
                            ire_line(e, "  %r = call ptr @" + en + "(" + call_args + ")")
                            ire_line(e, "  %ri = ptrtoint ptr %r to i64")
                            ire_line(e, "  ret i64 %ri")
                        else if real_ret == "i32"
                            ire_line(e, "  %r = call i32 @" + en + "(" + call_args + ")")
                            ire_line(e, "  %ri = sext i32 %r to i64")
                            ire_line(e, "  ret i64 %ri")
                        else
                            ire_line(e, "  %r = call " + real_ret + " @" + en + "(" + call_args + ")")
                            ire_line(e, "  ret i64 %r")
                        ire_line(e, "\}")
        ire_line(e, "")

    // Pass 1: Lower all functions to IR (start with imported module functions)
    let ir_fns = []
    for imp_fn in import_ir_fns
        push(ir_fns, imp_fn)
    for fn_stmt in functions
        let ir_fn = ir_optimize(ir_lower_function(b, fn_stmt))
        push(ir_fns, ir_fn)
        match fn_stmt
            Stmt(ftag, fname, fexpr, fbody, fparams, felse, fanns, fsline) =>
                let ir_name = fname
                if fname == "main"
                    ir_name = "nova_user_main"
                e.ire_fn_lines[ir_name] = fsline

    // Include lambdas generated during function lowering
    for lam_fn in b.ir_lambdas
        push(ir_fns, lam_fn)
    let lambdas_before_main = len(b.ir_lambdas)

    // Lower nova_main (top-level statements) before analysis
    b.ir_insts = []
    b.ir_blocks = []
    b.ir_clabel = "entry"
    b.ir_rc = 0
    b.ir_locals = {}
    for s in top_stmts
        ir_lower_stmt(b, s)
    if list_contains(b.ir_fnames, "nova_user_main")
        let umr = ir_fresh_reg(b)
        ir_emit_side(b, "call", umr, ir_type_any(), [], "nova_user_main", 0)
    ir_flush_pending_block(b)
    if len(b.ir_blocks) == 0
        ir_finish_block(b, IrInst("return", "", ir_type_void(), ["0"], "", 0, "pure", b.ir_cur_line))
    let main_fn = IrFunction("nova_main", [], ir_type_any(), b.ir_blocks, [], 0)

    // Build all_fns for inter-procedural analysis
    let all_fns = []
    for f in ir_fns
        push(all_fns, f)
    push(all_fns, main_fn)
    let mi = lambdas_before_main
    while mi < len(b.ir_lambdas)
        push(all_fns, b.ir_lambdas[mi])
        mi = mi + 1

    // Pass 2: Return types + parameter types (combined inter-procedural fixpoint).
    // Combined because a function's return type can depend on its own parameter
    // types (e.g. make_mat returns a list whose element type depends on its
    // `seed` parameter), and parameter types depend on callee return types.
    let frt = {}
    for ti_fname in keys(ti_state.ti_fn_types)
        frt[ti_fname] = ti_state.ti_fn_types[ti_fname]
    let fpt = {}
    let changed = true
    let pass_count = 0
    while changed and pass_count < 6
        changed = false
        pass_count = pass_count + 1
        fpt = ir_collect_param_types(all_fns, frt)
        for ir_fn in all_fns
            match ir_fn
                IrFunction(fname, fp, fret, fblocks, ftp, fex) =>
                    let old_type = "any"
                    if contains(frt, fname)
                        old_type = frt[fname]
                    let new_type = ir_analyze_return_type(ir_fn, frt, fpt)
                    if new_type != old_type and new_type != "any"
                        frt[fname] = new_type
                        changed = true
    fpt = ir_collect_param_types(all_fns, frt)

    // Pass 3: Infer types with inter-procedural info and emit
    for ir_fn in ir_fns
        let typed_fn = ir_infer_types(ir_fn, frt, fpt)
        ire_emit_function(e, typed_fn)

    // Emit nova_main
    let typed_main = ir_infer_types(main_fn, frt, fpt)
    ire_emit_function(e, typed_main)

    // Emit any lambdas generated during nova_main lowering
    let mi2 = lambdas_before_main
    while mi2 < len(b.ir_lambdas)
        let lam_fn = b.ir_lambdas[mi2]
        let typed_lam = ir_infer_types(lam_fn, frt, fpt)
        ire_emit_function(e, typed_lam)
        mi2 = mi2 + 1

    // Emit trampolines
    for spec in b.ir_tramps
        let tname = spec[0]
        let target = spec[1]
        let ncap = spec[2]
        let npar = spec[3]
        let hdr = "define i64 @" + tname + "(i64 %record"
        let pi = 0
        while pi < npar
            hdr = hdr + ", i64 %p" + str(pi)
            pi = pi + 1
        hdr = hdr + ") nounwind \{"
        ire_line(e, hdr)
        ire_line(e, "entry:")
        if ncap > 0
            ire_indent(e, "%rec_ptr = inttoptr i64 %record to ptr")
            let ci = 0
            while ci < ncap
                let gep_name = "%cap" + str(ci) + "_ptr"
                ire_indent(e, gep_name + " = getelementptr i64, ptr %rec_ptr, i64 " + str(ci + 1))
                ire_indent(e, "%cap" + str(ci) + " = load i64, ptr " + gep_name + ", align 8")
                ci = ci + 1
        let call_str = "call i64 @" + target + "("
        let first_arg = 1
        let ci2 = 0
        while ci2 < ncap
            if first_arg == 0
                call_str = call_str + ", "
            call_str = call_str + "i64 %cap" + str(ci2)
            first_arg = 0
            ci2 = ci2 + 1
        let pi2 = 0
        while pi2 < npar
            if first_arg == 0
                call_str = call_str + ", "
            call_str = call_str + "i64 %p" + str(pi2)
            first_arg = 0
            pi2 = pi2 + 1
        call_str = call_str + ")"
        ire_indent(e, "%result = " + call_str)
        ire_indent(e, "ret i64 %result")
        ire_line(e, "}")
        ire_line(e, "")

    // Emit main entry point
    ire_line(e, "define i32 @main(i32 %argc, ptr %argv) nounwind \{")
    ire_line(e, "entry:")
    ire_indent(e, "%argc64 = sext i32 %argc to i64")
    ire_indent(e, "%argv64 = ptrtoint ptr %argv to i64")
    ire_indent(e, "call void @nova_rt_init_args(i64 %argc64, i64 %argv64)")
    ire_indent(e, "call i64 @nova_main()")
    ire_indent(e, "call void @nova_rt_wait_all()")
    ire_indent(e, "call void @nova_rt_cleanup()")
    ire_indent(e, "ret i32 0")
    ire_line(e, "}")
    ire_line(e, "")

    // Emit string constants
    if len(e.ire_strs) > 0
        ire_line(e, "; String constants")
        for sc in e.ire_strs
            ire_line(e, sc)
        ire_line(e, "")

    // Emit debug metadata
    let lb = chr(123)
    let rb = chr(125)
    if len(e.ire_dbg_entries) > 0
        ire_line(e, "; Debug metadata")
        ire_line(e, "!llvm.dbg.cu = !" + lb + "!100" + rb)
        ire_line(e, "!llvm.module.flags = !" + lb + "!102, !103" + rb)
        ire_line(e, "")
        ire_line(e, "!100 = distinct !DICompileUnit(language: DW_LANG_C99, file: !101, producer: " + dq + "NOVA Compiler" + dq + ", isOptimized: false, emissionKind: LineTablesOnly)")
        ire_line(e, "!101 = !DIFile(filename: " + dq + e.ire_filename + dq + ", directory: " + dq + "." + dq + ")")
        if target_is_windows(e.ire_target) == 1
            ire_line(e, "!102 = !" + lb + "i32 2, !" + dq + "CodeView" + dq + ", i32 1" + rb)
        else
            ire_line(e, "!102 = !" + lb + "i32 7, !" + dq + "Dwarf Version" + dq + ", i32 4" + rb)
        ire_line(e, "!103 = !" + lb + "i32 2, !" + dq + "Debug Info Version" + dq + ", i32 3" + rb)
        ire_line(e, "!104 = !DISubroutineType(types: !105)")
        ire_line(e, "!105 = !" + lb + "null" + rb)
        for dbg_entry in e.ire_dbg_entries
            let sp_id = dbg_entry[0]
            let loc_id = dbg_entry[1]
            let dbg_name = dbg_entry[2]
            let dbg_line = dbg_entry[3]
            ire_line(e, "!" + str(sp_id) + " = distinct !DISubprogram(name: " + dq + dbg_name + dq + ", scope: !101, file: !101, line: " + str(dbg_line) + ", type: !104, scopeLine: " + str(dbg_line) + ", spFlags: DISPFlagDefinition, unit: !100)")
            ire_line(e, "!" + str(loc_id) + " = !DILocation(line: " + str(dbg_line) + ", column: 0, scope: !" + str(sp_id) + ")")
        // Per-statement DILocations (one per unique line per function scope).
        // Stepping the debugger through compiled code lands on these lines
        // instead of always reporting the function's start line.
        for loc_entry in e.ire_loc_entries
            let pl_id = loc_entry[0]
            let pl_sp = loc_entry[1]
            let pl_line = loc_entry[2]
            ire_line(e, "!" + str(pl_id) + " = !DILocation(line: " + str(pl_line) + ", column: 0, scope: !" + str(pl_sp) + ")")
        ire_line(e, "")

    // Emit TBAA and loop metadata
    ire_line(e, "; TBAA metadata")
    ire_line(e, "!0 = !" + lb + "!" + dq + "NOVA TBAA" + dq + rb)
    ire_line(e, "!1 = !" + lb + "!" + dq + "list_data_ptr" + dq + ", !0" + rb)
    ire_line(e, "!2 = !" + lb + "!1, !1, i64 0" + rb)
    ire_line(e, "!3 = !" + lb + "!" + dq + "list_elem" + dq + ", !0" + rb)
    ire_line(e, "!4 = !" + lb + "!3, !3, i64 0" + rb)
    ire_line(e, "!5 = !" + lb + "!" + dq + "list_size" + dq + ", !0" + rb)
    ire_line(e, "!6 = !" + lb + "!5, !5, i64 0" + rb)
    ire_line(e, "!90 = !" + lb + "!" + dq + "branch_weights" + dq + ", i32 2000, i32 1" + rb)
    // Loop metadata removed: !llvm.loop.unroll.enable caused 693x unrolling,
    // producing 2.1MB assembly vs 7.8KB without hints. LLVM default heuristics
    // produce identical is_prime assembly and correct loop optimization.
    ire_line(e, "")

    join(e.ire_out, "\n")

fn compile_ir(source: string) -> string
    compile_ir_core(source, "")

// ── Entry Point ──────────────────────────────────────────────────────────────

fn path_dir(path: string) -> string
    let last_sep = -1
    let i = 0
    while i < len(path)
        if path[i] == "/" or path[i] == "\\"
            last_sep = i
        i = i + 1
    if last_sep < 0
        return ""
    slice(path, 0, last_sep + 1)

fn resolve_module_file(name: string, base_dir: string) -> string
    let candidate = base_dir + name + ".nova"
    let content = read_file(candidate)
    if len(content) > 0
        return candidate
    candidate = name + ".nova"
    content = read_file(candidate)
    if len(content) > 0
        return candidate
    candidate = path_join(path_join("nova_packages", name), name + ".nova")
    content = read_file(candidate)
    if len(content) > 0
        return candidate
    candidate = path_join("nova_packages", name + ".nova")
    content = read_file(candidate)
    if len(content) > 0
        return candidate
    return ""

fn compile_module_ir(b: IrBuilder, mod_source: string, mod_name: string, visited: dict) -> list
    let tokens = tokenize(mod_source)
    let _mpe = []
    let stmts = parse_program(tokens, _mpe)
    let mod_fns = []
    let exported = []
    for s in stmts
        match s
            Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
                if tag == "fn"
                    push(mod_fns, s)
                    push(b.ir_fnames, name)
                    b.ir_fn_arity[name] = len(params)
                    if len(name) > 0 and name[0] != "_"
                        push(exported, name)
                else if tag == "type"
                    b.ir_sdefs[name] = params
                    let fi = 1
                    for p in params
                        match p
                            Param(pname, ptype, pdefault) =>
                                b.ir_fmap[pname] = fi
                                b.ir_field_types[name + "." + pname] = ptype
                        fi = fi + 1
                else if tag == "enum"
                    for variant in body
                        match variant
                            Stmt(vtag, vname, vexpr, vbody, vparams, velse, vann, vln) =>
                                if vtag == "type"
                                    b.ir_sdefs[vname] = vparams
                                    let vfi = 1
                                    for vp in vparams
                                        match vp
                                            Param(vpname, vptype, vpdefault) =>
                                                b.ir_fmap[vpname] = vfi
                                                b.ir_field_types[vname + "." + vpname] = vptype
                                        vfi = vfi + 1
    let ir_fns = []
    for fn_stmt in mod_fns
        let ir_fn = ir_lower_function(b, fn_stmt)
        push(ir_fns, ir_fn)
    for lam_fn in b.ir_lambdas
        push(ir_fns, lam_fn)
    b.ir_lambdas = []
    b.ir_modules[mod_name] = exported
    ir_fns

fn resolve_and_compile_imports(b: IrBuilder, stmts: list, base_dir: string) -> list
    let all_ir_fns = []
    let visited = {}
    for s in stmts
        match s
            Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
                if tag == "import"
                    let mod_name = name
                    let alias = mod_name
                    if len(annotations) > 0
                        alias = annotations[0]
                    if not contains(visited, mod_name)
                        visited[mod_name] = alias
                        let mod_path = resolve_module_file(mod_name, base_dir)
                        if mod_path == ""
                            print("error: cannot find module '" + mod_name + "'")
                            exit(1)
                        let mod_source = read_file(mod_path)
                        let mod_fns = compile_module_ir(b, mod_source, alias, visited)
                        for mf in mod_fns
                            push(all_ir_fns, mf)
                    else
                        let first_alias = visited[mod_name]
                        if contains(b.ir_modules, first_alias) and alias != first_alias
                            b.ir_modules[alias] = b.ir_modules[first_alias]
    all_ir_fns

fn nova_replace_ext(path: string, old_ext: string, new_ext: string) -> string
    if ends_with(path, old_ext)
        return slice(path, 0, len(path) - len(old_ext)) + new_ext
    return path + new_ext

fn nova_compile_file(input_path: string, output_path: string, use_ir: int, target: string) -> string
    if not file_exists(input_path)
        print("error: cannot read '" + input_path + "': file not found")
        exit(1)
    let source = read_file(input_path)
    let base_dir = path_dir(input_path)
    let llvm_ir = if use_ir == 1
        compile_ir_core_named(source, base_dir, input_path, target)
    else
        compile(source)
    write_file(output_path, llvm_ir)
    return output_path

fn nova_find_runtime() -> string
    let candidates = ["output/nova_runtime.c", "test_programs/output/nova_runtime.c", "nova_runtime.c"]
    for c in candidates
        let content = read_file(c)
        if contains(content, "nova_rt_system")
            return c
    for c in candidates
        let content = read_file(c)
        if len(content) > 100
            return c
    return "nova_runtime.c"

fn nova_link(ll_path: string, exe_path: string, opt_level: string, target: string) -> int
    let rt = nova_find_runtime()
    let resolved = resolve_target(target)
    let cmd = "clang " + opt_level + " -w"
    if target != "" and target != "native" and target != "windows" and target != "win"
        cmd = cmd + " --target=" + resolved
    cmd = cmd + " \"" + ll_path + "\" \"" + rt + "\" -o \"" + exe_path + "\""
    if target_is_windows(resolved) == 1
        cmd = cmd + " -lws2_32 -lwinhttp"
    cmd = cmd + " 2>&1"
    let ret = system(cmd)
    return ret

// ── Package Manager ─────────────────────────────────────────────────────────

fn nova_toml_default(name: string) -> string
    let content = "[package]\n"
    content = content + "name = \"" + name + "\"\n"
    content = content + "version = \"0.1.0\"\n"
    content = content + "description = \"\"\n"
    content = content + "author = \"\"\n"
    content = content + "\n"
    content = content + "[dependencies]\n"
    content

fn nova_pkg_init()
    let existing = read_file("nova.toml")
    if len(existing) > 0
        print("nova.toml already exists")
        return 0
    let content = nova_toml_default("my-project")
    write_file("nova.toml", content)
    print("Created nova.toml")

fn nova_pkg_new(project_name: string)
    if path_exists(project_name) == 1
        print("error: '" + project_name + "' already exists")
        exit(1)
    mkdir_p(project_name)
    mkdir_p(path_join(project_name, "src"))
    mkdir_p(path_join(project_name, "tests"))
    write_file(path_join(project_name, "nova.toml"), nova_toml_default(project_name))
    let main_src = "fn main()\n    print(" + chr(34) + "Hello from " + project_name + "!" + chr(34) + ")\n"
    write_file(path_join(project_name, "src/main.nova"), main_src)
    let test_src = "fn main()\n    assert(1 + 1 == 2, " + chr(34) + "math works" + chr(34) + ")\n    print(" + chr(34) + "ok" + chr(34) + ")\n"
    write_file(path_join(project_name, "tests/example_test.nova"), test_src)
    let gitignore = "*.ll\n*.exe\n*.exp\n*.lib\nnova_packages/\n"
    write_file(path_join(project_name, ".gitignore"), gitignore)
    print("Created project '" + project_name + "':")
    print("  " + project_name + "/nova.toml")
    print("  " + project_name + "/src/main.nova")
    print("  " + project_name + "/tests/example_test.nova")
    print("  " + project_name + "/.gitignore")
    print("")
    print("Next steps:")
    print("  cd " + project_name)
    print("  nova run             # run main")
    print("  nova test            # run all tests")

fn nova_pkg_entry() -> string
    if path_exists("src/main.nova") == 1
        return "src/main.nova"
    if path_exists("main.nova") == 1
        return "main.nova"
    return ""

fn nova_pkg_clean()
    let removed = 0
    let dirs = ["."]
    for d in dirs
        let files = list_dir(d)
        for f in files
            if ends_with(f, ".ll") or ends_with(f, ".exe") or ends_with(f, ".exp") or ends_with(f, ".lib") or ends_with(f, ".pdb")
                let full = path_join(d, f)
                system("del " + chr(34) + full + chr(34) + " >nul 2>&1")
                removed = removed + 1
    if path_exists("src") == 1
        let sfiles = list_dir("src")
        for f in sfiles
            if ends_with(f, ".ll") or ends_with(f, ".exe")
                let full = path_join("src", f)
                system("del " + chr(34) + full + chr(34) + " >nul 2>&1")
                removed = removed + 1
    print("Cleaned " + str(removed) + " artifact(s)")

fn nova_pkg_test()
    let test_files = []
    if path_exists("tests") == 1
        let files = list_dir("tests")
        for f in files
            if ends_with(f, "_test.nova") or ends_with(f, "_tests.nova")
                push(test_files, path_join("tests", f))
    if path_exists(".") == 1
        let cfiles = list_dir(".")
        for f in cfiles
            if ends_with(f, "_test.nova")
                push(test_files, f)
    if len(test_files) == 0
        print("No test files found (looking for *_test.nova in ./ or tests/)")
        return 0
    print("Running " + str(len(test_files)) + " test file(s)...")
    let passed = 0
    let failed = 0
    for tf in test_files
        let exe_path = nova_replace_ext(tf, ".nova", ".exe")
        let ll_path = nova_replace_ext(tf, ".nova", ".ll")
        nova_compile_file(tf, ll_path, 1, "")
        let link_ret = nova_link(ll_path, exe_path, "-O2", "")
        if link_ret != 0
            print("  FAIL link: " + tf)
            failed = failed + 1
        else
            let run_ret = system(chr(34) + exe_path + chr(34))
            if run_ret == 0
                print("  PASS: " + tf)
                passed = passed + 1
            else
                print("  FAIL run: " + tf + " (exit " + str(run_ret) + ")")
                failed = failed + 1
        system("del " + chr(34) + ll_path + chr(34) + " >nul 2>&1")
        system("del " + chr(34) + exe_path + chr(34) + " >nul 2>&1")
    print("")
    print("Test results: " + str(passed) + " passed, " + str(failed) + " failed")
    if failed > 0
        exit(1)

fn nova_parse_toml_deps(content: string) -> dict
    let deps = {}
    let lines = split(content, "\n")
    let in_deps = 0
    let idx = 0
    while idx < len(lines)
        let trimmed = trim(lines[idx])
        if trimmed == "[dependencies]"
            in_deps = 1
        else if len(trimmed) > 0
            let first_ch = slice(trimmed, 0, 1)
            if first_ch == "["
                in_deps = 0
            else if in_deps == 1 and first_ch != "#"
                let eq_pos = find(trimmed, "=")
                if eq_pos >= 0
                    let key = trim(slice(trimmed, 0, eq_pos))
                    let val = trim(slice(trimmed, eq_pos + 1, len(trimmed)))
                    if len(val) >= 2
                        let vfirst = slice(val, 0, 1)
                        if vfirst == "\""
                            val = slice(val, 1, len(val) - 1)
                    deps[key] = val
        idx = idx + 1
    deps

fn nova_registry_url() -> string
    "https://raw.githubusercontent.com/nova-lang/packages/main/registry/"

fn nova_pkg_is_valid_source(content: string) -> int
    if len(content) == 0
        return 0
    let t = trim(content)
    if starts_with(t, "<") or starts_with(t, "<!") or starts_with(t, "404")
        return 0
    if starts_with(t, "fn ") or starts_with(t, "//") or starts_with(t, "let ") or starts_with(t, "type ") or starts_with(t, "import ") or starts_with(t, "enum ")
        return 1
    if find(t, "fn ") >= 0
        return 1
    return 0

fn nova_pkg_download(pkg_name: string, pkg_version: string) -> int
    let pkg_dir = path_join("nova_packages", pkg_name)
    let marker = path_join(pkg_dir, pkg_name + ".nova")
    if path_exists(marker) == 1
        return 1
    mkdir_p(path_join("nova_packages", pkg_name))
    let registry = nova_registry_url()
    let index_url = registry + pkg_name + "/index.toml"
    let index_content = http_get(index_url)
    if len(index_content) > 0 and nova_pkg_is_valid_source(index_content) == 0
        let lines = split(index_content, "\n")
        let src_url = ""
        for line in lines
            let trimmed = trim(line)
            if starts_with(trimmed, "source")
                let eq = find(trimmed, "=")
                if eq >= 0
                    src_url = trim(slice(trimmed, eq + 1, len(trimmed)))
                    if len(src_url) >= 2 and slice(src_url, 0, 1) == "\""
                        src_url = slice(src_url, 1, len(src_url) - 1)
        if len(src_url) > 0
            let content = http_get(src_url)
            if nova_pkg_is_valid_source(content) == 1
                write_file(marker, content)
                print("  Downloaded " + pkg_name)
                return 1
            else
                print("  warning: " + pkg_name + " source URL returned invalid content")
    let gh_url = "https://raw.githubusercontent.com/nova-lang/pkg-" + pkg_name + "/main/" + pkg_name + ".nova"
    let content = http_get(gh_url)
    if nova_pkg_is_valid_source(content) == 1
        write_file(marker, content)
        print("  Downloaded " + pkg_name + " (github)")
        return 1
    print("  error: could not download " + pkg_name + " — package not found in registry or github")
    print("  Place " + pkg_name + ".nova in nova_packages/" + pkg_name + "/ manually")
    return 0

fn nova_pkg_install()
    let toml = read_file("nova.toml")
    if len(toml) == 0
        print("error: no nova.toml found. Run nova init first")
        exit(1)
    let deps = nova_parse_toml_deps(toml)
    let dep_keys = keys(deps)
    if len(dep_keys) == 0
        print("No dependencies to install")
        return 0
    print("Installing " + str(len(dep_keys)) + " package(s)...")
    let installed = 0
    for pkg_name in dep_keys
        let version = deps[pkg_name]
        let ok = nova_pkg_download(pkg_name, version)
        if ok == 1
            installed = installed + 1
    print("Installed " + str(installed) + "/" + str(len(dep_keys)) + " packages")

fn nova_pkg_get(pkg_spec: string)
    let pkg_name = pkg_spec
    let pkg_version = "*"
    let at_pos = find(pkg_spec, "@")
    if at_pos >= 0
        pkg_name = slice(pkg_spec, 0, at_pos)
        pkg_version = slice(pkg_spec, at_pos + 1, len(pkg_spec))
    let toml = read_file("nova.toml")
    if len(toml) == 0
        print("error: no nova.toml found. Run nova init first")
        exit(1)
    let deps = nova_parse_toml_deps(toml)
    if contains(deps, pkg_name)
        print("Package " + pkg_name + " already in dependencies")
        return 0
    let dep_line = pkg_name + " = " + chr(34) + pkg_version + chr(34) + "\n"
    let new_toml = toml + dep_line
    write_file("nova.toml", new_toml)
    print("Added " + pkg_name + "@" + pkg_version + " to nova.toml")
    nova_pkg_download(pkg_name, pkg_version)

// ── LSP Server ──────────────────────────────────────────────────────────────

fn lsp_read_message() -> string
    let content_length = 0
    let line = read_line()
    while line != "" and line != "\r" and line != "\r\n"
        if starts_with(line, "Content-Length:")
            let num_str = trim(slice(line, 15, len(line)))
            num_str = replace(num_str, "\r", "")
            num_str = replace(num_str, "\n", "")
            content_length = int(num_str)
        line = read_line()
    if content_length <= 0
        return ""
    stdin_read_n(content_length)

fn lsp_send(msg: string)
    let body = msg
    let header = "Content-Length: " + str(len(body)) + "\r\n\r\n"
    stdout_write(header + body)

fn lsp_respond(id, result: string)
    lsp_send("\{\"jsonrpc\":\"2.0\",\"id\":" + str(id) + ",\"result\":" + result + "\}")

fn lsp_notify(method: string, params: string)
    lsp_send("\{\"jsonrpc\":\"2.0\",\"method\":\"" + method + "\",\"params\":" + params + "\}")

fn lsp_error_response(id, code: int, msg: string)
    lsp_send("\{\"jsonrpc\":\"2.0\",\"id\":" + str(id) + ",\"error\":\{\"code\":" + str(code) + ",\"message\":\"" + msg + "\"\}\}")

fn lsp_escape_json(s: string) -> string
    let out = ""
    let i = 0
    while i < len(s)
        let c = s[i]
        if c == "\\"
            out = out + "\\\\"
        else if c == "\""
            out = out + "\\\""
        else if c == "\n"
            out = out + "\\n"
        else if c == "\r"
            out = out + "\\r"
        else if c == "\t"
            out = out + "\\t"
        else
            out = out + c
        i = i + 1
    out

fn lsp_collect_diagnostics(source: string, filename: string) -> list
    let diags = []
    let tokens = tokenize(source)
    let parse_errors = []
    let stmts = parse_program(tokens, parse_errors)
    for pe in parse_errors
        let pe_line = 0
        let colon_idx = find(pe, ":")
        if colon_idx > 0
            let after = slice(pe, colon_idx + 1, len(pe))
            let space_idx = find(after, " ")
            if space_idx > 0
                let num = slice(after, 0, space_idx)
                pe_line = int(num) - 1
                if pe_line < 0
                    pe_line = 0
        push(diags, [pe_line, 0, lsp_escape_json(pe)])
    let source_lines = split(source, "\n")
    let ti_state = ti_infer_program_named(stmts, source_lines, filename)
    for te in ti_state.ti_errors
        let te_line = 0
        let arrow_idx = find(te, "--> ")
        if arrow_idx >= 0
            let after = slice(te, arrow_idx + 4, len(te))
            let colon_idx = find(after, ":")
            if colon_idx > 0
                let num_end = find(after, "\n")
                if num_end < 0
                    num_end = len(after)
                let num_str = slice(after, colon_idx + 1, num_end)
                num_str = trim(num_str)
                te_line = int(num_str) - 1
                if te_line < 0
                    te_line = 0
        let msg_end = find(te, "\n")
        let msg = te
        if msg_end > 0
            msg = slice(te, 0, msg_end)
        push(diags, [te_line, 0, lsp_escape_json(msg)])
    diags

fn lsp_publish_diagnostics(uri: string, source: string, filename: string)
    let diags = lsp_collect_diagnostics(source, filename)
    let items = ""
    let di = 0
    for d in diags
        let line = d[0]
        let col = d[1]
        let msg = d[2]
        if di > 0
            items = items + ","
        items = items + "\{\"range\":\{\"start\":\{\"line\":" + str(line) + ",\"character\":" + str(col) + "\},\"end\":\{\"line\":" + str(line) + ",\"character\":999\}\},\"severity\":1,\"source\":\"nova\",\"message\":\"" + msg + "\"\}"
        di = di + 1
    lsp_notify("textDocument/publishDiagnostics", "\{\"uri\":\"" + lsp_escape_json(uri) + "\",\"diagnostics\":[" + items + "]\}")

fn lsp_uri_to_path(uri: string) -> string
    if starts_with(uri, "file:///")
        let path = slice(uri, 8, len(uri))
        path = replace(path, "%20", " ")
        path = replace(path, "%3A", ":")
        path = replace(path, "%5C", "\\")
        return path
    uri

fn lsp_server_main()
    write_raw("NOVA LSP server started\n")
    let docs = {}
    let running = true
    while running
        let body = lsp_read_message()
        if body == ""
            continue
        let msg = json_parse(body)
        let method = ""
        let id = 0
        let has_id = false
        if contains(msg, "method")
            method = msg["method"]
        if contains(msg, "id")
            id = msg["id"]
            has_id = true
        if method == "initialize"
            let caps = "\{\"capabilities\":\{\"textDocumentSync\":\{\"openClose\":true,\"change\":1,\"save\":\{\"includeText\":true\}\},\"diagnosticProvider\":\{\"interFileDependencies\":false,\"workspaceDiagnostics\":false\}\}\}"
            lsp_respond(id, caps)
        else if method == "initialized"
            write_raw("NOVA LSP initialized\n")
        else if method == "shutdown"
            lsp_respond(id, "null")
        else if method == "exit"
            running = false
        else if method == "textDocument/didOpen"
            let params = msg["params"]
            let td = params["textDocument"]
            let uri = td["uri"]
            let text = td["text"]
            docs[uri] = text
            let fpath = lsp_uri_to_path(uri)
            lsp_publish_diagnostics(uri, text, fpath)
        else if method == "textDocument/didChange"
            let params = msg["params"]
            let td = params["textDocument"]
            let uri = td["uri"]
            let changes = params["contentChanges"]
            if len(changes) > 0
                let text = changes[0]["text"]
                docs[uri] = text
                let fpath = lsp_uri_to_path(uri)
                lsp_publish_diagnostics(uri, text, fpath)
        else if method == "textDocument/didSave"
            let params = msg["params"]
            let td = params["textDocument"]
            let uri = td["uri"]
            if contains(params, "text")
                docs[uri] = params["text"]
            if contains(docs, uri)
                let fpath = lsp_uri_to_path(uri)
                lsp_publish_diagnostics(uri, docs[uri], fpath)
        else if method == "textDocument/didClose"
            let params = msg["params"]
            let td = params["textDocument"]
            let uri = td["uri"]
            if contains(docs, uri)
                docs[uri] = ""
            lsp_notify("textDocument/publishDiagnostics", "\{\"uri\":\"" + lsp_escape_json(uri) + "\",\"diagnostics\":[]\}")
        else if has_id
            lsp_error_response(id, -32601, "Method not found: " + method)

fn compiler_main()
    let arguments = args()
    if len(arguments) < 2
        print("NOVA Programming Language v0.1.0")
        print("Usage: nova <command> [options] [file.nova]")
        print("")
        print("Project commands:")
        print("  new <name>            Create a new project skeleton")
        print("  init                  Create nova.toml in current directory")
        print("  build [file]          Build project (or specific file) to executable")
        print("  run [file]            Build and run project (or specific file)")
        print("  test                  Run all *_test.nova files in tests/ and ./")
        print("  clean                 Remove .ll, .exe build artifacts")
        print("")
        print("Single-file commands:")
        print("  compile <file.nova>   Compile to LLVM IR only")
        print("")
        print("Package commands:")
        print("  get <package>[@ver]   Add a dependency to nova.toml")
        print("  install               Download all dependencies from nova.toml")
        print("")
        print("Tools:")
        print("  version               Show version")
        print("  self-test             Run compiler self-test")
        print("  lsp                   Start LSP server (for IDE integration)")
        print("")
        print("Options:")
        print("  -O0                   Disable optimizations")
        print("  -o <output>           Output file path")
        print("  --target <target>     Cross-compile target:")
        print("    linux, linux-arm64, macos, macos-arm64, windows, wasm")
        print("  --old                 Use legacy non-IR compiler")
        exit(0)
    let cmd = arguments[1]
    if cmd == "version" or cmd == "--version"
        print("NOVA v0.1.0 (self-hosted, IR pipeline)")
        exit(0)
    if cmd == "self-test"
        run_self_test()
        exit(0)
    if cmd == "lsp" or cmd == "--lsp"
        lsp_server_main()
        exit(0)
    if cmd == "init"
        nova_pkg_init()
        exit(0)
    if cmd == "new"
        if len(arguments) < 3
            print("Usage: nova new <project-name>")
            exit(1)
        nova_pkg_new(arguments[2])
        exit(0)
    if cmd == "clean"
        nova_pkg_clean()
        exit(0)
    if cmd == "test"
        nova_pkg_test()
        exit(0)
    if cmd == "get"
        if len(arguments) < 3
            print("Usage: nova get <package>[@version]")
            exit(1)
        nova_pkg_get(arguments[2])
        exit(0)
    if cmd == "install"
        nova_pkg_install()
        exit(0)
    // Parse: nova run/build/compile [--old] [-O0] [-o out] [--target T] <file>
    if cmd == "run" or cmd == "build" or cmd == "compile"
        let use_ir = 1
        let opt_level = "-O2"
        let output_file = ""
        let input_file = ""
        let target = ""
        let i = 2
        while i < len(arguments)
            let a = arguments[i]
            if a == "--old"
                use_ir = 0
            else if a == "-O0"
                opt_level = "-O0"
            else if a == "-o"
                i = i + 1
                if i < len(arguments)
                    output_file = arguments[i]
            else if a == "--target"
                i = i + 1
                if i < len(arguments)
                    target = arguments[i]
            else
                input_file = a
            i = i + 1
        if input_file == ""
            input_file = nova_pkg_entry()
        if input_file == ""
            print("error: no input file and no src/main.nova found in project")
            exit(1)
        if cmd == "compile"
            let ll = if output_file != ""
                output_file
            else
                nova_replace_ext(input_file, ".nova", ".ll")
            nova_compile_file(input_file, ll, use_ir, target)
            print("Compiled: " + input_file + " -> " + ll + " (target: " + resolve_target(target) + ")")
        else if cmd == "build"
            let ll = nova_replace_ext(input_file, ".nova", ".ll")
            let exe = if output_file != ""
                output_file
            else
                nova_replace_ext(input_file, ".nova", ".exe")
            nova_compile_file(input_file, ll, use_ir, target)
            let ret = nova_link(ll, exe, opt_level, target)
            if ret == 0
                print("Built: " + exe + " (target: " + resolve_target(target) + ")")
            else
                print("error: linking failed (exit " + str(ret) + ")")
                exit(1)
        else if cmd == "run"
            let ll = nova_replace_ext(input_file, ".nova", ".ll")
            let exe = nova_replace_ext(input_file, ".nova", ".exe")
            nova_compile_file(input_file, ll, use_ir, target)
            let ret = nova_link(ll, exe, opt_level, target)
            if ret != 0
                print("error: linking failed (exit " + str(ret) + ")")
                exit(1)
            let norm_exe = replace(exe, "/", "\\")
            let prefix = ".\\"
            if starts_with(norm_exe, "\\") or starts_with(norm_exe, ".\\")
                prefix = ""
            if len(norm_exe) >= 2 and slice(norm_exe, 1, 2) == ":"
                prefix = ""
            let run_cmd = chr(34) + prefix + norm_exe + chr(34)
            let run_ret = system(run_cmd)
            exit(run_ret)
        exit(0)
    // Legacy mode: nova <file.nova> [output.ll]
    let use_ir = 1
    let file_idx = 1
    if arguments[1] == "--old"
        use_ir = 0
        file_idx = 2
    else if arguments[1] == "--ir"
        file_idx = 2
    if file_idx >= len(arguments)
        print("error: no input file")
        exit(1)
    let input_path = arguments[file_idx]
    let output_path = if file_idx + 1 < len(arguments)
        arguments[file_idx + 1]
    else
        nova_replace_ext(input_path, ".nova", ".ll")
    nova_compile_file(input_path, output_path, use_ir, "")
    if use_ir == 1
        print("Compiled (IR): " + input_path + " -> " + output_path)
    else
        print("Compiled: " + input_path + " -> " + output_path)

// ── Self-Test ────────────────────────────────────────────────────────────────

fn run_self_test()
    let tokens = tokenize("let x = 42 + 3")
    let non_nl = []
    for t in tokens
        match t
            Token(kind, value, line, col) =>
                if kind != "NEWLINE" and kind != "EOF"
                    push(non_nl, t)
    assert(len(non_nl) == 6, "lexer: expected 6 tokens, got " + str(len(non_nl)))
    match non_nl[0]
        Token(k, v, l, c) => assert(k == "KW" and v == "let", "lexer: t0 " + k + ":" + v)
    match non_nl[1]
        Token(k, v, l, c) => assert(k == "IDENT" and v == "x", "lexer: t1 " + k + ":" + v)
    match non_nl[2]
        Token(k, v, l, c) => assert(k == "ASSIGN" and v == "=", "lexer: t2 " + k + ":" + v)
    match non_nl[3]
        Token(k, v, l, c) => assert(k == "INT" and v == "42", "lexer: t3 " + k + ":" + v)
    match non_nl[4]
        Token(k, v, l, c) => assert(k == "OP" and v == "+", "lexer: t4 " + k + ":" + v)
    match non_nl[5]
        Token(k, v, l, c) => assert(k == "INT" and v == "3", "lexer: t5 " + k + ":" + v)

    let tokens2 = tokenize("x = 10\ny = x + 5\nprint(y)")
    let _tpe = []
    let stmts = parse_program(tokens2, _tpe)
    assert(len(stmts) == 3, "parser: expected 3 stmts, got " + str(len(stmts)))

    let source = "x = 42\nprint(x)"
    let result = compile(source)
    assert(contains(result, "define i64 @nova_main"), "codegen: has nova_main")
    assert(contains(result, "nova_rt_print_any"), "codegen: has print call")

    // Test function compilation
    let fn_source = "fn add(a, b)\n    return a + b\nresult = add(3, 4)\nprint(result)"
    let fn_result = compile(fn_source)
    assert(contains(fn_result, "define i64 @add"), "codegen: has user function")

    // Test string literal compilation (full pipeline)
    let str_source = "x = \"hello\"\nprint(x)"
    let str_result = compile(str_source)
    assert(contains(str_result, "@.str."), "codegen: has string constant")
    assert(contains(str_result, "nova_rt_print_any"), "codegen: string print call")

    print("NOVA Self-Hosting Compiler: ALL TESTS PASSED")

compiler_main()
