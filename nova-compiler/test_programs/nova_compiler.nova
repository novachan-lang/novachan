// ══════════════════════════════════════════════════════════════════════════════
// NOVA Self-Hosting Compiler — Phase 7
// Compiles NOVA source → LLVM IR text → native binary (via clang)
//
// Architecture: Source → Lexer → Parser → LLVM Codegen → .ll file
// All values are i64 (matching the Kotlin compiler's convention).
// Links against nova_runtime.c for string/list/dict/IO operations.
// ══════════════════════════════════════════════════════════════════════════════

// ── Data Types ───────────────────────────────────────────────────────────────

type Token
    kind: string
    value: string
    line: int
    col: int

type Expr
    tag: string
    value: string
    num: int
    children: list
    fields: list
    eline: int

type Stmt
    tag: string
    name: string
    expr: Expr
    body: list
    params: list
    else_body: list
    annotations: list
    sline: int

type Param
    name: string
    type_ann: string
    default_val: Expr

type ParseResult
    expr: Expr
    pos: int

type StmtParseResult
    stmt: Stmt
    pos: int

// ── IR Types ─────────────────────────────────────────────────────────────────

type IrType
    kind: string
    name: string
    params: list
    id: int

type IrInst
    op: string
    dest: string
    type: IrType
    args: list
    value: string
    num: int
    effect: string
    line: int

type IrBlock
    label: string
    insts: list
    terminator: IrInst

type IrParam
    name: string
    type: IrType

type IrFunction
    name: string
    params: list
    ret_type: IrType
    blocks: list
    type_params: list
    is_extern: int

type IrModule
    functions: list
    structs: list
    globals: list
    string_constants: list

// ── Lexer ────────────────────────────────────────────────────────────────────

fn is_alpha(ch: string) -> bool
    let c = ord(ch)
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or ch == "_"

fn is_digit(ch: string) -> bool
    let c = ord(ch)
    c >= 48 and c <= 57

fn is_alnum(ch: string) -> bool
    is_alpha(ch) or is_digit(ch)

fn is_ws(ch: string) -> bool
    ch == " " or ch == "\t" or ch == "\r"

fn is_keyword(word: string) -> bool
    (word == "fn" or word == "return" or word == "if" or word == "else" or word == "for" or word == "while" or word == "match" or word == "break" or word == "continue" or word == "type" or word == "enum" or word == "spawn" or word == "send" or word == "receive" or word == "channel" or word == "or" or word == "and" or word == "not" or word == "import" or word == "true" or word == "false" or word == "null" or word == "in" or word == "as" or word == "select" or word == "try" or word == "catch" or word == "trait" or word == "matches" or word == "yield" or word == "let" or word == "extern")

fn lex_error(code: string, msg: string, line: int, col: int, help: string)
    lex_error_file(code, msg, "", line, col, help)

fn lex_error_file(code: string, msg: string, filename: string, line: int, col: int, help: string)
    let fname = filename
    if fname == ""
        fname = "<source>"
    print("error[" + code + "]: " + msg)
    print("  --> " + fname + ":" + str(line) + ":" + str(col))
    print_source_snippet(filename, line, col)
    if help != ""
        print("  = help: " + help)
    print("compilation failed: 1 error(s)")
    exit(1)

// Read source file and print a snippet of the line where the error occurred.
// Silently does nothing if filename is empty or unreadable.
fn print_source_snippet(filename: string, line: int, col: int)
    if filename != "" and file_exists(filename) and line > 0
        let content = read_file(filename)
        if len(content) > 0
            let lines = split(content, "\n")
            if line <= len(lines)
                let snippet = lines[line - 1]
                let lnum = str(line)
                let pad = ""
                let pi = 0
                while pi < len(lnum)
                    pad = pad + " "
                    pi = pi + 1
                print("  " + pad + " |")
                print("  " + lnum + " | " + snippet)
                print("  " + pad + " |")

// Returns a formatted source snippet string (line with surrounding bars).
fn format_source_snippet(filename: string, line: int) -> string
    if filename != "" and file_exists(filename) and line > 0
        let content = read_file(filename)
        if len(content) > 0
            let lines = split(content, "\n")
            if line <= len(lines)
                let snippet = lines[line - 1]
                let lnum = str(line)
                let pad = ""
                let pi = 0
                while pi < len(lnum)
                    pad = pad + " "
                    pi = pi + 1
                return "  " + pad + " |\n" + "  " + lnum + " | " + snippet + "\n" + "  " + pad + " |\n"
    ""

// Skip tokens forward to the next top-level sync point (next statement boundary).
fn sync_to_stmt(tokens: list, pos: int) -> int
    let p = pos
    while p < len(tokens) - 1
        let kind = tk(tokens, p)
        if kind == "EOF"
            return p
        let col = tok_col(tokens, p)
        if col <= 1 and kind == "NEWLINE"
            return p + 1
        if col <= 1 and kind == "KW"
            return p
        p = p + 1
    len(tokens) - 1

// Dummy "error" statement returned when a parse error occurs and recovery skips a construct.
fn error_stmt(line: int) -> Stmt
    Stmt("error", "", Expr("null", "", 0, [], [], 0), [], [], [], [], line)

fn int_fits_i64(s: string) -> bool
    if len(s) == 0
        return true
    if len(s) < 19
        return true
    if len(s) > 19
        return false
    s <= "9223372036854775807"

fn tokenize(source: string) -> list
    tokenize_file(source, "")

fn tokenize_file(source: string, filename: string) -> list
    let tokens = []
    let pos = 0
    let line = 1
    let col = 1
    let length = len(source)
    // Skip UTF-8 BOM if present (EF BB BF = ord 239, 187, 191)
    if length >= 3 and ord(source[0]) == 239 and ord(source[1]) == 187 and ord(source[2]) == 191
        pos = 3

    while pos < length
        let ch = source[pos]

        if ch == "\n"
            push(tokens, Token("NEWLINE", "\\n", line, col))
            line = line + 1
            col = 1
            pos = pos + 1
        else if is_ws(ch)
            while pos < length and is_ws(source[pos])
                pos = pos + 1
                col = col + 1
        else if ch == "/" and pos + 1 < length and source[pos + 1] == "/"
            while pos < length and source[pos] != "\n"
                pos = pos + 1
                col = col + 1
        else if ch == "/" and pos + 1 < length and source[pos + 1] == "*"
            pos = pos + 2
            col = col + 2
            let depth = 1
            while pos < length and depth > 0
                if source[pos] == "/" and pos + 1 < length and source[pos + 1] == "*"
                    depth = depth + 1
                    pos = pos + 2
                    col = col + 2
                else if source[pos] == "*" and pos + 1 < length and source[pos + 1] == "/"
                    depth = depth - 1
                    pos = pos + 2
                    col = col + 2
                else if source[pos] == "\n"
                    line = line + 1
                    col = 1
                    pos = pos + 1
                else
                    pos = pos + 1
                    col = col + 1
        else if ch == "@"
            push(tokens, Token("AT", "@", line, col))
            pos = pos + 1
            col = col + 1
        else if is_alpha(ch)
            let start_col = col
            let word = ""
            while pos < length and is_alnum(source[pos])
                word = word + source[pos]
                pos = pos + 1
                col = col + 1
            if word == "f" and pos < length and source[pos] == "\""
                pos = pos + 1
                col = col + 1
                let fstr = ""
                let has_interp = false
                while pos < length and source[pos] != "\""
                    if source[pos] == "\\" and pos + 1 < length
                        let esc = source[pos + 1]
                        if esc == "\{"
                            fstr = fstr + "\{"
                            pos = pos + 2
                            col = col + 2
                        else if esc == "\}"
                            fstr = fstr + "\}"
                            pos = pos + 2
                            col = col + 2
                        else if esc == "n"
                            fstr = fstr + "\n"
                            pos = pos + 2
                            col = col + 2
                        else if esc == "t"
                            fstr = fstr + "\t"
                            pos = pos + 2
                            col = col + 2
                        else if esc == "r"
                            fstr = fstr + "\r"
                            pos = pos + 2
                            col = col + 2
                        else if esc == "\\"
                            fstr = fstr + "\\"
                            pos = pos + 2
                            col = col + 2
                        else if esc == "\""
                            fstr = fstr + "\""
                            pos = pos + 2
                            col = col + 2
                        else if esc == "\{"
                            fstr = fstr + "\{"
                            pos = pos + 2
                            col = col + 2
                        else if esc == "\}"
                            fstr = fstr + "\}"
                            pos = pos + 2
                            col = col + 2
                        else
                            fstr = fstr + source[pos]
                            pos = pos + 1
                            col = col + 1
                    else if source[pos] == "\{"
                        if not has_interp
                            push(tokens, Token("INTERP_START", fstr, line, start_col))
                        else
                            push(tokens, Token("INTERP_MID", fstr, line, col))
                        fstr = ""
                        has_interp = true
                        pos = pos + 1
                        col = col + 1
                        let depth = 1
                        let interp_src = ""
                        while pos < length and depth > 0
                            if source[pos] == "\{"
                                depth = depth + 1
                                interp_src = interp_src + source[pos]
                            else if source[pos] == "\}"
                                depth = depth - 1
                                if depth > 0
                                    interp_src = interp_src + source[pos]
                            else if source[pos] == "\\" and pos + 1 < length and source[pos + 1] == "\""
                                interp_src = interp_src + "\""
                                pos = pos + 1
                                col = col + 1
                            else
                                interp_src = interp_src + source[pos]
                            if depth > 0
                                pos = pos + 1
                                col = col + 1
                        pos = pos + 1
                        col = col + 1
                        let inner_tokens = tokenize(interp_src)
                        for itk in inner_tokens
                            match itk
                                Token(ik, iv, il, ic) =>
                                    if ik != "EOF"
                                        push(tokens, Token(ik, iv, line, ic))
                    else
                        fstr = fstr + source[pos]
                        pos = pos + 1
                        col = col + 1
                if pos < length
                    pos = pos + 1
                    col = col + 1
                if has_interp
                    push(tokens, Token("INTERP_END", fstr, line, col))
                else
                    push(tokens, Token("STR", fstr, line, start_col))
            else if is_keyword(word)
                push(tokens, Token("KW", word, line, start_col))
            else
                push(tokens, Token("IDENT", word, line, start_col))
        else if is_digit(ch)
            let start_col = col
            if ch == "0" and pos + 1 < length and (source[pos + 1] == "x" or source[pos + 1] == "X")
                pos = pos + 2
                col = col + 2
                let hval = 0
                while pos < length
                    let hc = source[pos]
                    if is_digit(hc)
                        hval = hval * 16 + (ord(hc) - ord("0"))
                    else if hc == "a" or hc == "b" or hc == "c" or hc == "d" or hc == "e" or hc == "f"
                        hval = hval * 16 + (ord(hc) - ord("a") + 10)
                    else if hc == "A" or hc == "B" or hc == "C" or hc == "D" or hc == "E" or hc == "F"
                        hval = hval * 16 + (ord(hc) - ord("A") + 10)
                    else if hc == "_"
                        pos = pos + 1
                        col = col + 1
                        continue
                    else
                        break
                    pos = pos + 1
                    col = col + 1
                push(tokens, Token("INT", str(hval), line, start_col))
            else if ch == "0" and pos + 1 < length and (source[pos + 1] == "b" or source[pos + 1] == "B")
                pos = pos + 2
                col = col + 2
                let bval = 0
                while pos < length and (source[pos] == "0" or source[pos] == "1" or source[pos] == "_")
                    if source[pos] != "_"
                        bval = bval * 2 + (ord(source[pos]) - ord("0"))
                    pos = pos + 1
                    col = col + 1
                push(tokens, Token("INT", str(bval), line, start_col))
            else
                let num = ""
                let is_float = false
                while pos < length and (is_digit(source[pos]) or (source[pos] == "." and pos + 1 < length and source[pos + 1] != ".") or source[pos] == "_" or source[pos] == "e" or source[pos] == "E")
                    if source[pos] == "." or source[pos] == "e" or source[pos] == "E"
                        is_float = true
                    if source[pos] != "_"
                        num = num + source[pos]
                    pos = pos + 1
                    col = col + 1
                if is_float
                    push(tokens, Token("FLOAT", num, line, start_col))
                else
                    if not int_fits_i64(num)
                        lex_error_file("E0012", "integer literal '" + num + "' is too large for i64", filename, line, start_col, "i64 max is 9223372036854775807 (19 digits); use a smaller value")
                    push(tokens, Token("INT", num, line, start_col))
        else if ch == "\""
            let start_col = col
            let start_line = line
            pos = pos + 1
            col = col + 1
            let fstr = ""
            let has_interp = false
            while pos < length and source[pos] != "\""
                if source[pos] == "\n"
                    lex_error_file("E0010", "unterminated string literal", filename, start_line, start_col, "string literals must be closed with \" before the end of the line; use \\n for embedded newlines")
                if source[pos] == "\\" and pos + 1 < length
                    let esc = source[pos + 1]
                    if esc == "\{"
                        fstr = fstr + "\{"
                        pos = pos + 2
                        col = col + 2
                    else if esc == "\}"
                        fstr = fstr + "\}"
                        pos = pos + 2
                        col = col + 2
                    else if esc == "n"
                        fstr = fstr + "\n"
                        pos = pos + 2
                        col = col + 2
                    else if esc == "t"
                        fstr = fstr + "\t"
                        pos = pos + 2
                        col = col + 2
                    else if esc == "r"
                        fstr = fstr + "\r"
                        pos = pos + 2
                        col = col + 2
                    else if esc == "\\"
                        fstr = fstr + "\\"
                        pos = pos + 2
                        col = col + 2
                    else if esc == "\""
                        fstr = fstr + "\""
                        pos = pos + 2
                        col = col + 2
                    else if esc == "0"
                        fstr = fstr + "\0"
                        pos = pos + 2
                        col = col + 2
                    else
                        lex_error_file("E0011", "invalid escape sequence '\\" + esc + "' in string", filename, line, col, "valid escapes are: \\n \\t \\r \\\\ \\\" \\0 \\\{ \\\}")
                else if source[pos] == "\{"
                    if not has_interp
                        push(tokens, Token("INTERP_START", fstr, line, start_col))
                    else
                        push(tokens, Token("INTERP_MID", fstr, line, col))
                    fstr = ""
                    has_interp = true
                    pos = pos + 1
                    col = col + 1
                    let depth = 1
                    let interp_src = ""
                    while pos < length and depth > 0
                        if source[pos] == "\{"
                            depth = depth + 1
                            interp_src = interp_src + source[pos]
                        else if source[pos] == "\}"
                            depth = depth - 1
                            if depth > 0
                                interp_src = interp_src + source[pos]
                        else if source[pos] == "\\" and pos + 1 < length and source[pos + 1] == "\""
                            interp_src = interp_src + "\""
                            pos = pos + 1
                            col = col + 1
                        else
                            interp_src = interp_src + source[pos]
                        if depth > 0
                            pos = pos + 1
                            col = col + 1
                    pos = pos + 1
                    col = col + 1
                    let inner_tokens = tokenize(interp_src)
                    for itk in inner_tokens
                        match itk
                            Token(ik, iv, il, ic) =>
                                if ik != "EOF"
                                    push(tokens, Token(ik, iv, line, ic))
                else
                    fstr = fstr + source[pos]
                    pos = pos + 1
                    col = col + 1
            if pos >= length
                lex_error_file("E0010", "unterminated string literal", filename, start_line, start_col, "string literal opened with \" was never closed")
            pos = pos + 1
            col = col + 1
            if has_interp
                push(tokens, Token("INTERP_END", fstr, line, col))
            else
                push(tokens, Token("STR", fstr, line, start_col))
        else if ch == "`"
            let start_col = col
            let start_line = line
            pos = pos + 1
            col = col + 1
            let raw = ""
            while pos < length and source[pos] != "`"
                if source[pos] == "\n"
                    line = line + 1
                    col = 1
                else
                    col = col + 1
                raw = raw + source[pos]
                pos = pos + 1
            if pos >= length
                lex_error_file("E0010", "unterminated raw string literal", filename, start_line, start_col, "raw string opened with ` was never closed")
            pos = pos + 1
            col = col + 1
            push(tokens, Token("RAW_STR", raw, line, start_col))
        else if ch == "(" or ch == ")" or ch == "[" or ch == "]" or ch == "\{" or ch == "\}"
            push(tokens, Token("DELIM", ch, line, col))
            pos = pos + 1
            col = col + 1
        else if ch == ","
            push(tokens, Token("COMMA", ",", line, col))
            pos = pos + 1
            col = col + 1
        else if ch == ":"
            push(tokens, Token("COLON", ":", line, col))
            pos = pos + 1
            col = col + 1
        else if ch == "."
            if pos + 1 < length and source[pos + 1] == "."
                push(tokens, Token("DOTDOT", "..", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("DOT", ".", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == "+"
            if pos + 1 < length and source[pos + 1] == "="
                push(tokens, Token("OP", "+=", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("OP", "+", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == "-"
            if pos + 1 < length and source[pos + 1] == ">"
                push(tokens, Token("ARROW", "->", line, col))
                pos = pos + 2
                col = col + 2
            else if pos + 1 < length and source[pos + 1] == "="
                push(tokens, Token("OP", "-=", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("OP", "-", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == "*"
            if pos + 1 < length and source[pos + 1] == "*"
                push(tokens, Token("OP", "**", line, col))
                pos = pos + 2
                col = col + 2
            else if pos + 1 < length and source[pos + 1] == "="
                push(tokens, Token("OP", "*=", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("OP", "*", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == "/"
            if pos + 1 < length and source[pos + 1] == "="
                push(tokens, Token("OP", "/=", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("OP", "/", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == "%"
            if pos + 1 < length and source[pos + 1] == "="
                push(tokens, Token("OP", "%=", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("OP", "%", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == "="
            if pos + 1 < length and source[pos + 1] == "="
                push(tokens, Token("OP", "==", line, col))
                pos = pos + 2
                col = col + 2
            else if pos + 1 < length and source[pos + 1] == ">"
                push(tokens, Token("FAT_ARROW", "=>", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("ASSIGN", "=", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == "!"
            if pos + 1 < length and source[pos + 1] == "="
                push(tokens, Token("OP", "!=", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("OP", "!", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == "<"
            if pos + 1 < length and source[pos + 1] == "="
                push(tokens, Token("OP", "<=", line, col))
                pos = pos + 2
                col = col + 2
            else if pos + 1 < length and source[pos + 1] == "<"
                push(tokens, Token("OP", "<<", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("OP", "<", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == ">"
            if pos + 1 < length and source[pos + 1] == "="
                push(tokens, Token("OP", ">=", line, col))
                pos = pos + 2
                col = col + 2
            else if pos + 1 < length and source[pos + 1] == ">"
                push(tokens, Token("OP", ">>", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("OP", ">", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == "&"
            push(tokens, Token("OP", "&", line, col))
            pos = pos + 1
            col = col + 1
        else if ch == "|"
            if pos + 1 < length and source[pos + 1] == ">"
                push(tokens, Token("PIPE_GT", "|>", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("OP", "|", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == "^"
            push(tokens, Token("OP", "^", line, col))
            pos = pos + 1
            col = col + 1
        else if ch == "~"
            push(tokens, Token("OP", "~", line, col))
            pos = pos + 1
            col = col + 1
        else if ch == "?"
            push(tokens, Token("QUESTION", "?", line, col))
            pos = pos + 1
            col = col + 1
        else
            lex_error_file("E0013", "unexpected character '" + ch + "' (code " + str(ord(ch)) + ") in source", filename, line, col, "NOVA source must be ASCII; statements end with newlines, not semicolons or other punctuation")

    push(tokens, Token("EOF", filename, line, col))
    tokens

// ── Parser Utilities ─────────────────────────────────────────────────────────

fn tok_at(tokens: list, pos: int) -> Token
    tokens[pos]

fn tk(tokens: list, pos: int) -> string
    match tokens[pos]
        Token(kind, value, line, col) => kind

fn tv(tokens: list, pos: int) -> string
    match tokens[pos]
        Token(kind, value, line, col) => value

fn tl(tokens: list, pos: int) -> int
    match tokens[pos]
        Token(kind, value, line, col) => line

fn skip_nl(tokens: list, pos: int) -> int
    while tk(tokens, pos) == "NEWLINE"
        pos = pos + 1
    pos

fn tok_line(tokens: list, pos: int) -> int
    match tokens[pos]
        Token(kind, value, line, col) => line

fn tok_col(tokens: list, pos: int) -> int
    match tokens[pos]
        Token(kind, value, line, col) => col

// Read filename from the EOF token's value, if present.
fn tok_filename(tokens: list) -> string
    let n = len(tokens)
    if n == 0
        return ""
    match tokens[n - 1]
        Token(k, v, l, c) =>
            if k == "EOF"
                return v
    ""

// Records a syntax error (accumulate all, not exit-on-first).
// Returns the position of the next top-level sync token for recovery.
fn syntax_error(tokens: list, pos: int, msg: string, pe: list) -> int
    let ln = tok_line(tokens, pos)
    let cl = tok_col(tokens, pos)
    let raw_fname = tok_filename(tokens)
    let fname = raw_fname
    if fname == ""
        fname = "<source>"
    let help = ""
    if contains(msg, "expected ')'")
        help = "you may be missing a closing ')' or have an unbalanced expression"
    else if contains(msg, "expected '('")
        help = "function calls and parameter lists require parentheses"
    else if contains(msg, "expected ','")
        help = "list and argument items must be separated by commas"
    else if contains(msg, "expected ':'")
        help = "type annotations and dict literals use ':' between name and value"
    else if contains(msg, "unexpected")
        help = "check that the surrounding syntax (parens, braces, indentation) is balanced"
    let out = "error[E0001]: " + msg + "\n  --> " + fname + ":" + str(ln) + ":" + str(cl) + "\n" + format_source_snippet(raw_fname, ln)
    if help != ""
        out = out + "  = help: " + help + "\n"
    push(pe, out)
    sync_to_stmt(tokens, pos)

fn expect(tokens: list, pos: int, expected_val: string, pe: list) -> int
    if tv(tokens, pos) != expected_val
        return syntax_error(tokens, pos, "expected '" + expected_val + "' but found '" + tv(tokens, pos) + "'", pe)
    pos + 1

// ── Operator Precedence (Pratt Parser) ───────────────────────────────────────

fn prefix_bp(op: string) -> int
    if op == "-" or op == "not" or op == "~"
        27
    else
        0

fn infix_bp(op: string) -> list
    if op == "catch"
        [2, 3]
    else if op == "or"
        [3, 4]
    else if op == "and"
        [5, 6]
    else if op == "|"
        [7, 8]
    else if op == "^"
        [9, 10]
    else if op == "&"
        [11, 12]
    else if op == "==" or op == "!=" or op == "matches"
        [13, 14]
    else if op == "<" or op == ">" or op == "<=" or op == ">=" or op == "in"
        [15, 16]
    else if op == "<<" or op == ">>"
        [17, 18]
    else if op == "+" or op == "-"
        [19, 20]
    else if op == "*" or op == "/" or op == "%"
        [21, 22]
    else if op == "**"
        [24, 23]
    else if op == ".."
        [1, 2]
    else
        [0, 0]

fn is_infix_op(tokens: list, pos: int) -> bool
    let kind = tk(tokens, pos)
    let val = tv(tokens, pos)
    if kind == "OP"
        let bp = infix_bp(val)
        bp[0] > 0
    else if kind == "KW" and (val == "and" or val == "or" or val == "in" or val == "matches" or val == "catch")
        true
    else if kind == "DOTDOT"
        true
    else
        false

fn get_infix_op(tokens: list, pos: int) -> string
    tv(tokens, pos)

// ── Expression Parser ────────────────────────────────────────────────────────

fn null_expr() -> Expr
    Expr("null", "", 0, [], [], 0)

fn parse_expr(tokens: list, pos: int, min_bp: int, pe: list) -> ParseResult
    let ln = tl(tokens, pos)
    let left_r = parse_prefix(tokens, pos, pe)
    let left = left_r.expr
    let cur = left_r.pos

    while cur < len(tokens) and tk(tokens, cur) != "EOF" and tk(tokens, cur) != "NEWLINE"
        // Check for postfix operations: function call, index, member access
        if tk(tokens, cur) == "DELIM" and tv(tokens, cur) == "("
            let call_r = parse_call_args(tokens, cur, left, pe)
            left = call_r.expr
            cur = call_r.pos
        else if tk(tokens, cur) == "DELIM" and tv(tokens, cur) == "["
            let idx_r = parse_index(tokens, cur, left, pe)
            left = idx_r.expr
            cur = idx_r.pos
        else if tk(tokens, cur) == "DELIM" and tv(tokens, cur) == "\{"
            match left
                Expr(ltag, lval, lnum, lchildren, lfields, lln) =>
                    if ltag == "ident"
                        let struct_fields = []
                        let sp = cur + 1
                        while sp < len(tokens) and tv(tokens, sp) != "\}" and tk(tokens, sp) != "EOF"
                            if len(struct_fields) > 0
                                sp = expect(tokens, sp, ",", pe)
                                if tv(tokens, sp) == "\}" or tk(tokens, sp) == "EOF"
                                    break
                            let fname = tv(tokens, sp)
                            sp = sp + 1
                            sp = expect(tokens, sp, ":", pe)
                            let fval_r = parse_expr(tokens, sp, 0, pe)
                            push(struct_fields, Expr("field_init", fname, 0, [fval_r.expr], [], ln))
                            sp = fval_r.pos
                        sp = expect(tokens, sp, "\}", pe)
                        left = Expr("struct_init", lval, 0, struct_fields, [], ln)
                        cur = sp
                    else
                        break
        else if tk(tokens, cur) == "DOT"
            cur = cur + 1
            let member_name = tv(tokens, cur)
            cur = cur + 1
            // Check for method call: obj.method(args)
            if cur < len(tokens) and tk(tokens, cur) == "DELIM" and tv(tokens, cur) == "("
                let method_r = parse_call_args(tokens, cur, Expr("member", member_name, 0, [left], [], ln), pe)
                left = method_r.expr
                cur = method_r.pos
            else
                left = Expr("member", member_name, 0, [left], [], ln)
        else if tk(tokens, cur) == "QUESTION"
            left = Expr("try_unwrap", "", 0, [left], [], ln)
            cur = cur + 1
        else if tk(tokens, cur) == "FAT_ARROW" and min_bp <= 1
            // Lambda: left => body (lowest precedence)
            cur = cur + 1
            let body_r = parse_expr(tokens, cur, 0, pe)
            match left
                Expr(ltag, lval, lnum, lchildren, lfields, lln) =>
                    if ltag == "ident"
                        left = Expr("lambda", "", 0, [body_r.expr], [left], ln)
                    else if ltag == "tuple"
                        left = Expr("lambda", "", 0, [body_r.expr], lchildren, ln)
                    else
                        left = Expr("lambda", "", 0, [body_r.expr], [left], ln)
            cur = body_r.pos
        else if is_infix_op(tokens, cur)
            let op = get_infix_op(tokens, cur)
            let bp = infix_bp(op)
            let lbp = bp[0]
            let rbp = bp[1]
            if lbp < min_bp
                break
            cur = cur + 1
            if op == "catch"
                let err_var = tv(tokens, cur)
                cur = cur + 1
                let pre_nl = cur
                cur = skip_nl(tokens, cur)
                if pre_nl != cur and tk(tokens, cur) != "EOF"
                    let body_col = tok_col(tokens, cur)
                    let body_stmts = []
                    while tk(tokens, cur) != "EOF" and tok_col(tokens, cur) >= body_col
                        let sr = parse_stmt(tokens, cur, pe)
                        push(body_stmts, sr.stmt)
                        cur = skip_nl(tokens, sr.pos)
                    if len(body_stmts) > 1
                        left = Expr("catch", err_var, len(body_stmts), [left], body_stmts, ln)
                    else if len(body_stmts) == 1
                        match body_stmts[0]
                            Stmt(stag, sname, sexpr, sbody, sparams, selse, sanns, ssln) =>
                                left = Expr("catch", err_var, 0, [left, sexpr], [], ln)
                    else
                        left = Expr("catch", err_var, 0, [left, null_expr()], [], ln)
                else
                    let handler_r = parse_expr(tokens, cur, 0, pe)
                    left = Expr("catch", err_var, 0, [left, handler_r.expr], [], ln)
                    cur = handler_r.pos
            else
                let right_r = parse_expr(tokens, cur, rbp, pe)
                left = Expr("binop", op, 0, [left, right_r.expr], [], ln)
                cur = right_r.pos
        else
            break

    ParseResult(left, cur)

fn parse_prefix(tokens: list, pos: int, pe: list) -> ParseResult
    let ln = tl(tokens, pos)
    let kind = tk(tokens, pos)
    let val = tv(tokens, pos)

    if kind == "INT"
        ParseResult(Expr("int", val, int(val), [], [], ln), pos + 1)
    else if kind == "FLOAT"
        ParseResult(Expr("float", val, 0, [], [], ln), pos + 1)
    else if kind == "STR"
        ParseResult(Expr("str", val, 0, [], [], ln), pos + 1)
    else if kind == "RAW_STR"
        ParseResult(Expr("str", val, 0, [], [], ln), pos + 1)
    else if kind == "KW" and val == "true"
        ParseResult(Expr("bool", "true", 1, [], [], ln), pos + 1)
    else if kind == "KW" and val == "false"
        ParseResult(Expr("bool", "false", 0, [], [], ln), pos + 1)
    else if kind == "KW" and val == "null"
        ParseResult(Expr("null", "", 0, [], [], ln), pos + 1)
    else if kind == "IDENT"
        ParseResult(Expr("ident", val, 0, [], [], ln), pos + 1)
    else if kind == "OP" and val == "-"
        if tk(tokens, pos + 1) == "FLOAT"
            let fv = tv(tokens, pos + 1)
            ParseResult(Expr("float", "-" + fv, 0, [], [], ln), pos + 2)
        else
            let rbp = prefix_bp("-")
            let operand_r = parse_expr(tokens, pos + 1, rbp, pe)
            ParseResult(Expr("unary", "-", 0, [operand_r.expr], [], ln), operand_r.pos)
    else if kind == "KW" and val == "not"
        let rbp = prefix_bp("not")
        let operand_r = parse_expr(tokens, pos + 1, rbp, pe)
        ParseResult(Expr("unary", "not", 0, [operand_r.expr], [], ln), operand_r.pos)
    else if kind == "OP" and val == "~"
        let rbp = prefix_bp("~")
        let operand_r = parse_expr(tokens, pos + 1, rbp, pe)
        ParseResult(Expr("unary", "~", 0, [operand_r.expr], [], ln), operand_r.pos)
    else if kind == "DELIM" and val == "("
        // Grouped expression or tuple
        let inner_r = parse_expr(tokens, pos + 1, 0, pe)
        if tk(tokens, inner_r.pos) == "COMMA"
            // Tuple literal
            let elements = [inner_r.expr]
            let p = inner_r.pos
            while tv(tokens, p) == "," and tk(tokens, p) != "EOF"
                p = p + 1
                let elem_r = parse_expr(tokens, p, 0, pe)
                push(elements, elem_r.expr)
                p = elem_r.pos
            p = expect(tokens, p, ")", pe)
            ParseResult(Expr("tuple", "", 0, elements, [], ln), p)
        else
            let p2 = expect(tokens, inner_r.pos, ")", pe)
            ParseResult(inner_r.expr, p2)
    else if kind == "DELIM" and val == "["
        // List literal — trailing comma allowed: [1, 2, 3,]
        let elements = []
        let p = pos + 1
        while tv(tokens, p) != "]" and tk(tokens, p) != "EOF"
            if len(elements) > 0
                p = expect(tokens, p, ",", pe)
                if tv(tokens, p) == "]" or tk(tokens, p) == "EOF"
                    break
            let elem_r = parse_expr(tokens, p, 0, pe)
            push(elements, elem_r.expr)
            if elem_r.pos <= p
                break
            p = elem_r.pos
        p = expect(tokens, p, "]", pe)
        ParseResult(Expr("list", "", 0, elements, [], ln), p)
    else if kind == "DELIM" and val == "\{"
        // Dict literal
        let entries = []
        let p = pos + 1
        while tv(tokens, p) != "\}" and tk(tokens, p) != "EOF"
            if len(entries) > 0
                p = expect(tokens, p, ",", pe)
                if tv(tokens, p) == "\}" or tk(tokens, p) == "EOF"
                    break
            let key_r = parse_expr(tokens, p, 0, pe)
            p = expect(tokens, key_r.pos, ":", pe)
            let val_r = parse_expr(tokens, p, 0, pe)
            push(entries, Expr("pair", "", 0, [key_r.expr, val_r.expr], [], ln))
            if val_r.pos <= p
                break
            p = val_r.pos
        p = expect(tokens, p, "\}", pe)
        ParseResult(Expr("dict", "", 0, entries, [], ln), p)
    else if kind == "INTERP_START"
        let parts = []
        push(parts, Expr("str", val, 0, [], [], ln))
        let p = pos + 1
        let interp_expr_r = parse_expr(tokens, p, 0, pe)
        push(parts, interp_expr_r.expr)
        p = interp_expr_r.pos
        while p < len(tokens) and tk(tokens, p) == "INTERP_MID"
            push(parts, Expr("str", tv(tokens, p), 0, [], [], ln))
            p = p + 1
            let next_r = parse_expr(tokens, p, 0, pe)
            push(parts, next_r.expr)
            p = next_r.pos
        if p < len(tokens) and tk(tokens, p) == "INTERP_END"
            push(parts, Expr("str", tv(tokens, p), 0, [], [], ln))
            p = p + 1
        ParseResult(Expr("str_interp", "", 0, parts, [], ln), p)
    else if kind == "KW" and val == "try"
        let inner_r = parse_expr(tokens, pos + 1, 5, pe)
        ParseResult(Expr("try", "", 0, [inner_r.expr], [], ln), inner_r.pos)
    else if kind == "KW" and val == "if"
        parse_if_expr(tokens, pos, pe)
    else if kind == "KW" and val == "match"
        parse_match_expr(tokens, pos, pe)
    else if kind == "KW" and val == "for"
        parse_for_expr(tokens, pos, pe)
    else if kind == "KW" and (val == "send" or val == "receive" or val == "select" or val == "close" or val == "matches" or val == "monitor" or val == "recv" or val == "recv_timeout")
        ParseResult(Expr("ident", val, 0, [], [], ln), pos + 1)
    else if kind == "KW" and val == "fn"
        let fp = pos + 1
        fp = expect(tokens, fp, "(", pe)
        let fn_params = []
        while tv(tokens, fp) != ")" and tk(tokens, fp) != "EOF"
            if len(fn_params) > 0
                fp = expect(tokens, fp, ",", pe)
                if tk(tokens, fp) == "EOF"
                    break
            push(fn_params, Expr("ident", tv(tokens, fp), 0, [], [], ln))
            fp = fp + 1
        fp = expect(tokens, fp, ")", pe)
        let fn_body_r = parse_expr(tokens, fp, 0, pe)
        ParseResult(Expr("lambda", "", 0, [fn_body_r.expr], fn_params, ln), fn_body_r.pos)
    else if kind == "KW" and val == "channel"
        let ch_p = pos + 1
        if ch_p < len(tokens) and tk(tokens, ch_p) == "DELIM" and tv(tokens, ch_p) == "("
            ch_p = expect(tokens, ch_p + 1, ")", pe)
            ParseResult(Expr("call", "channel", 0, [], [], ln), ch_p)
        else
            ParseResult(Expr("ident", "channel", 0, [], [], ln), ch_p)
    else if kind == "KW" and val == "spawn"
        let sp_r = parse_expr(tokens, pos + 1, 0, pe)
        ParseResult(Expr("spawn", "", 0, [sp_r.expr], [], ln), sp_r.pos)
    else if kind == "KW" and val == "yield"
        let yd_r = parse_expr(tokens, pos + 1, 0, pe)
        ParseResult(Expr("call", "yield", 0, [yd_r.expr], [], ln), yd_r.pos)
    else if kind == "KW" and val == "trait"
        ParseResult(Expr("ident", "trait", 0, [], [], ln), pos + 1)
    else
        let erp = syntax_error(tokens, pos, "unexpected " + kind + " '" + val + "' in expression", pe)
        ParseResult(null_expr(), erp)

fn parse_call_args(tokens: list, pos: int, callee: Expr, pe: list) -> ParseResult
    let ln = tl(tokens, pos)
    let p = pos + 1
    let cargs = []
    while tv(tokens, p) != ")" and tk(tokens, p) != "EOF"
        if len(cargs) > 0
            p = expect(tokens, p, ",", pe)
            if tk(tokens, p) == "EOF"
                break
        let arg_r = parse_expr(tokens, p, 0, pe)
        push(cargs, arg_r.expr)
        if arg_r.pos <= p
            break
        p = arg_r.pos
    p = expect(tokens, p, ")", pe)
    // Determine call name from callee
    match callee
        Expr(tag, value, num, children, fields, eline) =>
            if tag == "ident"
                ParseResult(Expr("call", value, 0, cargs, [], ln), p)
            else if tag == "member"
                // Method call: children[0] is receiver
                let all_args = [children[0]]
                for a in cargs
                    push(all_args, a)
                ParseResult(Expr("method_call", value, 0, all_args, [], ln), p)
            else
                ParseResult(Expr("dyn_call", "", 0, [callee] + cargs, [], ln), p)

fn parse_index(tokens: list, pos: int, target: Expr, pe: list) -> ParseResult
    let ln = tl(tokens, pos)
    let p = pos + 1
    if tk(tokens, p) == "COLON"
        p = p + 1
        let end_r = parse_expr(tokens, p, 0, pe)
        p = expect(tokens, end_r.pos, "]", pe)
        return ParseResult(Expr("slice", "", 0, [target, Expr("int", "0", 0, [], [], ln), end_r.expr], [], ln), p)
    let idx_r = parse_expr(tokens, p, 0, pe)
    if tk(tokens, idx_r.pos) == "COLON"
        let p2 = idx_r.pos + 1
        if tk(tokens, p2) == "DELIM" and tv(tokens, p2) == "]"
            p2 = p2 + 1
            return ParseResult(Expr("slice", "", 0, [target, idx_r.expr, Expr("int", "999999999", 999999999, [], [], ln)], [], ln), p2)
        let end_r = parse_expr(tokens, p2, 0, pe)
        p2 = expect(tokens, end_r.pos, "]", pe)
        return ParseResult(Expr("slice", "", 0, [target, idx_r.expr, end_r.expr], [], ln), p2)
    p = expect(tokens, idx_r.pos, "]", pe)
    ParseResult(Expr("index", "", 0, [target, idx_r.expr], [], ln), p)

fn parse_if_expr(tokens: list, pos: int, pe: list) -> ParseResult
    let ln = tl(tokens, pos)
    let p = pos + 1
    let cond_r = parse_expr(tokens, p, 0, pe)
    let p2 = skip_nl(tokens, cond_r.pos)
    let then_r = parse_expr(tokens, p2, 0, pe)
    let p3 = skip_nl(tokens, then_r.pos)
    if tk(tokens, p3) == "KW" and tv(tokens, p3) == "else"
        let p4 = skip_nl(tokens, p3 + 1)
        let else_r = parse_expr(tokens, p4, 0, pe)
        ParseResult(Expr("if", "", 0, [cond_r.expr, then_r.expr, else_r.expr], [], ln), else_r.pos)
    else
        ParseResult(Expr("if", "", 0, [cond_r.expr, then_r.expr], [], ln), p3)

fn parse_match_expr(tokens: list, pos: int, pe: list) -> ParseResult
    let ln = tl(tokens, pos)
    let p = pos + 1
    let subject_r = parse_expr(tokens, p, 0, pe)
    let p2 = skip_nl(tokens, subject_r.pos)
    let arms = []
    let arm_col = tok_col(tokens, p2)
    while tk(tokens, p2) != "EOF"
        if len(arms) > 0 and tok_col(tokens, p2) < arm_col
            break
        let cur_kind = tk(tokens, p2)
        if cur_kind != "IDENT" and cur_kind != "INT" and cur_kind != "STR"
            break
        let pat_r = parse_pattern(tokens, p2, pe)
        p2 = skip_nl(tokens, pat_r.pos)
        let guard_expr = null_expr()
        if tk(tokens, p2) == "KW" and tv(tokens, p2) == "if"
            p2 = p2 + 1
            let guard_r = parse_expr(tokens, p2, 2, pe)
            guard_expr = guard_r.expr
            p2 = skip_nl(tokens, guard_r.pos)
        p2 = expect(tokens, p2, "=>", pe)
        p2 = skip_nl(tokens, p2)
        let body_r = parse_expr(tokens, p2, 0, pe)
        push(arms, Expr("arm", "", 0, [pat_r.expr, body_r.expr, guard_expr], [], ln))
        p2 = skip_nl(tokens, body_r.pos)
    ParseResult(Expr("match", "", 0, [subject_r.expr] + arms, [], ln), p2)

fn parse_pattern(tokens: list, pos: int, pe: list) -> ParseResult
    let ln = tl(tokens, pos)
    let kind = tk(tokens, pos)
    let val = tv(tokens, pos)
    if kind == "IDENT"
        if pos + 1 < len(tokens) and tv(tokens, pos + 1) == "("
            // Constructor pattern: Name(field1, field2, ...)
            let name = val
            let p = pos + 2
            let fields = []
            while tv(tokens, p) != ")" and tk(tokens, p) != "EOF"
                if len(fields) > 0
                    p = expect(tokens, p, ",", pe)
                    if tk(tokens, p) == "EOF"
                        break
                push(fields, Expr("pat_var", tv(tokens, p), 0, [], [], ln))
                p = p + 1
            p = expect(tokens, p, ")", pe)
            ParseResult(Expr("pat_ctor", name, 0, fields, [], ln), p)
        else if val == "_"
            ParseResult(Expr("pat_wild", "_", 0, [], [], ln), pos + 1)
        else
            ParseResult(Expr("pat_var", val, 0, [], [], ln), pos + 1)
    else if kind == "INT"
        ParseResult(Expr("pat_lit", val, int(val), [], [], ln), pos + 1)
    else if kind == "STR"
        ParseResult(Expr("pat_str", val, 0, [], [], ln), pos + 1)
    else
        ParseResult(Expr("pat_wild", "_", 0, [], [], ln), pos)

fn parse_for_expr(tokens: list, pos: int, pe: list) -> ParseResult
    let ln = tl(tokens, pos)
    let p = pos + 1
    let var_name = tv(tokens, p)
    p = p + 1
    p = skip_nl(tokens, p)
    if tk(tokens, p) == "KW" and tv(tokens, p) == "in"
        p = p + 1
    let iter_r = parse_expr(tokens, p, 0, pe)
    let p2 = skip_nl(tokens, iter_r.pos)
    let body_r = parse_expr(tokens, p2, 0, pe)
    ParseResult(Expr("for", var_name, 0, [iter_r.expr, body_r.expr], [], ln), body_r.pos)

// ── Statement Parser ─────────────────────────────────────────────────────────

fn parse_block(tokens: list, pos: int, pe: list) -> StmtParseResult
    let ln = tl(tokens, pos)
    let stmts = []
    let p = skip_nl(tokens, pos)
    while tk(tokens, p) != "EOF" and tk(tokens, p) != "KW"
        let sr = parse_stmt(tokens, p, pe)
        push(stmts, sr.stmt)
        p = skip_nl(tokens, sr.pos)
        // Heuristic: stop block at dedent (no explicit INDENT/DEDENT in this tokenizer)
        // For now: parse one statement per block-line
        break
    StmtParseResult(Stmt("block", "", null_expr(), stmts, [], [], [], ln), p)

fn parse_stmt(tokens: list, pos: int, pe: list) -> StmtParseResult
    let ln = tl(tokens, pos)
    let kind = tk(tokens, pos)
    let val = tv(tokens, pos)

    if kind == "AT"
        // Annotation: @name followed by statement
        let ann_name = tv(tokens, pos + 1)
        let p = skip_nl(tokens, pos + 2)
        let inner_r = parse_stmt(tokens, p, pe)
        match inner_r.stmt
            Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
                let new_anns = [ann_name]
                for a in annotations
                    push(new_anns, a)
                StmtParseResult(Stmt(tag, name, expr, body, params, else_body, new_anns, sline), inner_r.pos)
    else if kind == "KW" and val == "fn"
        parse_fn_decl(tokens, pos, pe)
    else if kind == "KW" and val == "extern"
        parse_extern_decl(tokens, pos, pe)
    else if kind == "KW" and val == "type"
        parse_type_decl(tokens, pos, pe)
    else if kind == "KW" and val == "trait"
        parse_trait_decl(tokens, pos, pe)
    else if kind == "KW" and val == "enum"
        parse_enum_decl(tokens, pos, pe)
    else if kind == "KW" and val == "spawn"
        let spawn_col = tok_col(tokens, pos)
        let sp = pos + 1
        if tk(tokens, sp) == "KW" and tv(tokens, sp) == "fn"
            sp = sp + 1
            sp = expect(tokens, sp, "(", pe)
            let sp_params = []
            while tv(tokens, sp) != ")" and tk(tokens, sp) != "EOF"
                if len(sp_params) > 0
                    sp = expect(tokens, sp, ",", pe)
                let sp_pname = tv(tokens, sp)
                sp = sp + 1
                push(sp_params, Param(sp_pname, "", null_expr()))
            sp = expect(tokens, sp, ")", pe)
            let sp2 = skip_nl(tokens, sp)
            let sp_body = []
            while tk(tokens, sp2) != "EOF"
                if tok_col(tokens, sp2) <= spawn_col
                    break
                let sp_r = parse_stmt(tokens, sp2, pe)
                push(sp_body, sp_r.stmt)
                sp2 = skip_nl(tokens, sp_r.pos)
            StmtParseResult(Stmt("spawn", "", null_expr(), sp_body, sp_params, [], [], ln), sp2)
        else if tk(tokens, sp) == "NEWLINE" or tk(tokens, sp) == "NL"
            let sp2 = skip_nl(tokens, sp)
            if tk(tokens, sp2) != "EOF" and tok_col(tokens, sp2) > spawn_col
                let sp_body = []
                while tk(tokens, sp2) != "EOF"
                    if tok_col(tokens, sp2) <= spawn_col
                        break
                    let sp_r = parse_stmt(tokens, sp2, pe)
                    push(sp_body, sp_r.stmt)
                    sp2 = skip_nl(tokens, sp_r.pos)
                StmtParseResult(Stmt("spawn", "", null_expr(), sp_body, [], [], [], ln), sp2)
            else
                let sp_expr = parse_expr(tokens, sp2, 0, pe)
                StmtParseResult(Stmt("expr", "", Expr("spawn", "", 0, [sp_expr.expr], [], ln), [], [], [], [], ln), sp_expr.pos)
        else
            let sp_expr = parse_expr(tokens, sp, 0, pe)
            StmtParseResult(Stmt("expr", "", Expr("spawn", "", 0, [sp_expr.expr], [], ln), [], [], [], [], ln), sp_expr.pos)
    else if kind == "KW" and val == "if"
        parse_if_stmt(tokens, pos, pe)
    else if kind == "KW" and val == "while"
        parse_while_stmt(tokens, pos, pe)
    else if kind == "KW" and val == "for"
        parse_for_stmt(tokens, pos, pe)
    else if kind == "KW" and val == "return"
        let p = pos + 1
        if tk(tokens, p) == "NEWLINE" or tk(tokens, p) == "EOF"
            StmtParseResult(Stmt("return", "", null_expr(), [], [], [], [], ln), p)
        else
            let expr_r = parse_expr(tokens, p, 0, pe)
            StmtParseResult(Stmt("return", "", expr_r.expr, [], [], [], [], ln), expr_r.pos)
    else if kind == "KW" and val == "yield"
        let expr_r = parse_expr(tokens, pos + 1, 0, pe)
        StmtParseResult(Stmt("yield", "", expr_r.expr, [], [], [], [], ln), expr_r.pos)
    else if kind == "KW" and val == "break"
        StmtParseResult(Stmt("break", "", null_expr(), [], [], [], [], ln), pos + 1)
    else if kind == "KW" and val == "continue"
        StmtParseResult(Stmt("continue", "", null_expr(), [], [], [], [], ln), pos + 1)
    else if kind == "KW" and val == "import"
        parse_import_stmt(tokens, pos)
    else if kind == "KW" and val == "match"
        parse_match_stmt(tokens, pos, pe)
    else if kind == "KW" and val == "let"
        // let name = expr
        let name = tv(tokens, pos + 1)
        let p = pos + 2
        if tk(tokens, p) == "ASSIGN"
            p = p + 1
            if tk(tokens, p) == "KW" and tv(tokens, p) == "spawn" and tk(tokens, p + 1) == "KW" and tv(tokens, p + 1) == "fn"
                let spawn_col = tok_col(tokens, p)
                let sp = p + 2
                sp = expect(tokens, sp, "(", pe)
                let sp_params = []
                while tv(tokens, sp) != ")" and tk(tokens, sp) != "EOF"
                    if len(sp_params) > 0
                        sp = expect(tokens, sp, ",", pe)
                    push(sp_params, Param(tv(tokens, sp), "", null_expr()))
                    sp = sp + 1
                sp = expect(tokens, sp, ")", pe)
                let sp2 = skip_nl(tokens, sp)
                let sp_body = []
                while tk(tokens, sp2) != "EOF"
                    if tok_col(tokens, sp2) <= spawn_col
                        break
                    let sp_r = parse_stmt(tokens, sp2, pe)
                    push(sp_body, sp_r.stmt)
                    sp2 = skip_nl(tokens, sp_r.pos)
                StmtParseResult(Stmt("spawn", name, null_expr(), sp_body, sp_params, [], [], ln), sp2)
            else
                let expr_r = parse_expr(tokens, p, 0, pe)
                StmtParseResult(Stmt("assign", name, expr_r.expr, [], [], [], [], ln), expr_r.pos)
        else
            StmtParseResult(Stmt("assign", name, null_expr(), [], [], [], [], ln), p)
    else if kind == "IDENT"
        if tk(tokens, pos + 1) == "ASSIGN" and tk(tokens, pos + 2) == "KW" and tv(tokens, pos + 2) == "spawn" and tk(tokens, pos + 3) == "KW" and tv(tokens, pos + 3) == "fn"
            let sa_name = tv(tokens, pos)
            let spawn_col = tok_col(tokens, pos + 2)
            let sp = pos + 4
            sp = expect(tokens, sp, "(", pe)
            let sp_params = []
            while tv(tokens, sp) != ")" and tk(tokens, sp) != "EOF"
                if len(sp_params) > 0
                    sp = expect(tokens, sp, ",", pe)
                push(sp_params, Param(tv(tokens, sp), "", null_expr()))
                sp = sp + 1
            sp = expect(tokens, sp, ")", pe)
            let sp2 = skip_nl(tokens, sp)
            let sp_body = []
            while tk(tokens, sp2) != "EOF"
                if tok_col(tokens, sp2) <= spawn_col
                    break
                let sp_r = parse_stmt(tokens, sp2, pe)
                push(sp_body, sp_r.stmt)
                sp2 = skip_nl(tokens, sp_r.pos)
            StmtParseResult(Stmt("spawn", sa_name, null_expr(), sp_body, sp_params, [], [], ln), sp2)
        else
            let expr_r = parse_expr(tokens, pos, 0, pe)
            let p = expr_r.pos
            if tk(tokens, p) == "ASSIGN"
                p = p + 1
                let rhs_r = parse_expr(tokens, p, 0, pe)
                StmtParseResult(Stmt("assign", "", rhs_r.expr, [], [], [], [expr_r.expr], ln), rhs_r.pos)
            else if tk(tokens, p) == "OP" and (tv(tokens, p) == "+=" or tv(tokens, p) == "-=" or tv(tokens, p) == "*=" or tv(tokens, p) == "/=")
                let op = tv(tokens, p)
                p = p + 1
                let rhs_r = parse_expr(tokens, p, 0, pe)
                StmtParseResult(Stmt("compound_assign", op, rhs_r.expr, [], [], [], [expr_r.expr], ln), rhs_r.pos)
            else
                StmtParseResult(Stmt("expr", "", expr_r.expr, [], [], [], [], ln), p)
    else
        let expr_r = parse_expr(tokens, pos, 0, pe)
        if tk(tokens, expr_r.pos) == "ASSIGN"
            let dp = expr_r.pos + 1
            let rhs_r = parse_expr(tokens, dp, 0, pe)
            StmtParseResult(Stmt("assign", "", rhs_r.expr, [], [], [], [expr_r.expr], ln), rhs_r.pos)
        else
            StmtParseResult(Stmt("expr", "", expr_r.expr, [], [], [], [], ln), expr_r.pos)

fn ffi_llvm_type(ann: string) -> string
    if ann == "float"
        return "double"
    if ann == "string" or ann == "str"
        return "ptr"
    if ann == "void" or ann == "unit"
        return "void"
    if ann == "i32" or ann == "int32"
        return "i32"
    "i64"

fn parse_extern_decl(tokens: list, pos: int, pe: list) -> StmtParseResult
    let ln = tl(tokens, pos)
    let p = pos + 1
    if tk(tokens, p) != "KW" or tv(tokens, p) != "fn"
        p = syntax_error(tokens, p, "expected 'fn' after 'extern'", pe)
        return StmtParseResult(error_stmt(ln), p)
    p = p + 1
    let name = tv(tokens, p)
    p = p + 1
    p = expect(tokens, p, "(", pe)
    let params = []
    while tv(tokens, p) != ")" and tk(tokens, p) != "EOF"
        if len(params) > 0
            p = expect(tokens, p, ",", pe)
            if tk(tokens, p) == "EOF"
                break
        let param_name = tv(tokens, p)
        p = p + 1
        let type_ann = ""
        if tk(tokens, p) == "COLON"
            p = p + 1
            type_ann = tv(tokens, p)
            p = p + 1
        push(params, Param(param_name, type_ann, null_expr()))
    p = expect(tokens, p, ")", pe)
    let ret_ann = ""
    if tk(tokens, p) == "ARROW"
        p = p + 1
        if tk(tokens, p) == "IDENT"
            ret_ann = tv(tokens, p)
        while tk(tokens, p) == "IDENT" or tk(tokens, p) == "DELIM"
            p = p + 1
    let ret_expr = null_expr()
    if ret_ann != ""
        ret_expr = Expr("rettype", ret_ann, 0, [], [], ln)
    let ext_ann = []
    push(ext_ann, Expr("extern", "", 0, [], [], ln))
    StmtParseResult(Stmt("extern_fn", name, ret_expr, [], params, [], ext_ann, ln), p)

fn parse_fn_decl(tokens: list, pos: int, pe: list) -> StmtParseResult
    let ln = tl(tokens, pos)
    let p = pos + 1
    let generic_params = []
    let generic_bounds = {}
    if tk(tokens, p) == "OP" and tv(tokens, p) == "<"
        p = p + 1
        while tv(tokens, p) != ">" and tk(tokens, p) != "EOF"
            if len(generic_params) > 0
                p = expect(tokens, p, ",", pe)
                if tk(tokens, p) == "EOF"
                    break
            let gp_name = tv(tokens, p)
            push(generic_params, gp_name)
            p = p + 1
            if tk(tokens, p) == "COLON"
                p = p + 1
                generic_bounds[gp_name] = tv(tokens, p)
                p = p + 1
        if tk(tokens, p) != "EOF"
            p = p + 1
    let name = tv(tokens, p)
    p = p + 1
    let is_method = false
    if tk(tokens, p) == "DOT"
        is_method = true
        p = p + 1
        let method_name = tv(tokens, p)
        name = name + "__" + method_name
        p = p + 1
    p = expect(tokens, p, "(", pe)
    let params = []
    while tv(tokens, p) != ")" and tk(tokens, p) != "EOF"
        if len(params) > 0
            p = expect(tokens, p, ",", pe)
            if tk(tokens, p) == "EOF"
                break
        let param_name = tv(tokens, p)
        p = p + 1
        let type_ann = ""
        let default_val = null_expr()
        if tk(tokens, p) == "COLON"
            p = p + 1
            type_ann = tv(tokens, p)
            p = p + 1
            if tk(tokens, p) == "OP" and tv(tokens, p) == "<"
                // Capture nested generic args into the type_ann string.
                // Handles `>>` (right-shift token) as two-level close.
                type_ann = type_ann + "<"
                let pdepth = 1
                p = p + 1
                while pdepth > 0 and tk(tokens, p) != "EOF" and tk(tokens, p) != "NEWLINE"
                    let tkk = tk(tokens, p)
                    let tvv = tv(tokens, p)
                    if tkk == "OP" and tvv == "<"
                        pdepth = pdepth + 1
                        type_ann = type_ann + "<"
                    else if tkk == "OP" and tvv == ">"
                        pdepth = pdepth - 1
                        type_ann = type_ann + ">"
                    else if tkk == "OP" and tvv == ">>"
                        pdepth = pdepth - 2
                        type_ann = type_ann + ">>"
                    else if tkk == "DELIM" and tvv == ","
                        type_ann = type_ann + ","
                    else if tkk == "IDENT"
                        type_ann = type_ann + tvv
                    p = p + 1
        if tk(tokens, p) == "ASSIGN"
            p = p + 1
            let def_r = parse_expr(tokens, p, 0, pe)
            default_val = def_r.expr
            p = def_r.pos
        push(params, Param(param_name, type_ann, default_val))
    p = expect(tokens, p, ")", pe)
    if is_method
        let has_self = false
        if len(params) > 0
            match params[0]
                Param(pn, pt, pd) =>
                    if pn == "self"
                        has_self = true
        if not has_self
            let self_params = [Param("self", "", null_expr())]
            for ep in params
                push(self_params, ep)
            params = self_params
    // Capture return type annotation (full parametric type after ->)
    let ret_ann = ""
    if tk(tokens, p) == "ARROW"
        p = p + 1
        if tk(tokens, p) == "IDENT"
            ret_ann = tv(tokens, p)
            p = p + 1
            if tk(tokens, p) == "OP" and tv(tokens, p) == "<"
                ret_ann = ret_ann + "<"
                let rdepth = 1
                p = p + 1
                while rdepth > 0 and tk(tokens, p) != "EOF" and tk(tokens, p) != "NEWLINE"
                    let rtkk = tk(tokens, p)
                    let rtvv = tv(tokens, p)
                    if rtkk == "OP" and rtvv == "<"
                        rdepth = rdepth + 1
                        ret_ann = ret_ann + "<"
                    else if rtkk == "OP" and rtvv == ">"
                        rdepth = rdepth - 1
                        ret_ann = ret_ann + ">"
                    else if rtkk == "OP" and rtvv == ">>"
                        rdepth = rdepth - 2
                        ret_ann = ret_ann + ">>"
                    else if rtkk == "DELIM" and rtvv == ","
                        ret_ann = ret_ann + ","
                    else if rtkk == "IDENT"
                        ret_ann = ret_ann + rtvv
                    p = p + 1
    let fn_col = 1
    let fn_tok = tokens[pos]
    match fn_tok
        Token(fk, fv, fline, fcol) =>
            fn_col = fcol
    let p2 = skip_nl(tokens, p)
    let body = []
    let body_col = -1
    while tk(tokens, p2) != "EOF"
        let cur_tok = tokens[p2]
        let cur_col = -1
        match cur_tok
            Token(k, v, line, col) =>
                if col <= fn_col
                    break
                cur_col = col
        if body_col < 0
            body_col = cur_col
        else if cur_col != body_col
            p2 = syntax_error(tokens, p2, "inconsistent indentation in body of function '" + name + "' (expected column " + str(body_col) + ", got " + str(cur_col) + "); check for mixed tabs and spaces", pe)
            break
        let sr = parse_stmt(tokens, p2, pe)
        push(body, sr.stmt)
        p2 = skip_nl(tokens, sr.pos)
    if len(body) == 0
        syntax_error(tokens, pos, "function '" + name + "' has an empty body; function bodies must be indented past the 'fn' keyword and contain at least one statement", pe)
    let ret_expr = null_expr()
    if ret_ann != ""
        ret_expr = Expr("rettype", ret_ann, 0, [], [], ln)
    let annotations = []
    if len(generic_params) > 0
        let gen_children = []
        for g in generic_params
            push(gen_children, Expr("ident", g, 0, [], [], ln))
        push(annotations, Expr("generics", "", 0, gen_children, [], ln))
        if len(generic_bounds) > 0
            let bound_children = []
            for bk in keys(generic_bounds)
                push(bound_children, Expr("bound", bk, 0, [Expr("ident", generic_bounds[bk], 0, [], [], ln)], [], ln))
            push(annotations, Expr("generic_bounds", "", 0, bound_children, [], ln))
    StmtParseResult(Stmt("fn", name, ret_expr, body, params, [], annotations, ln), p2)

fn parse_type_decl(tokens: list, pos: int, pe: list) -> StmtParseResult
    let ln = tl(tokens, pos)
    let p = pos + 1
    let name = tv(tokens, p)
    p = p + 1
    let type_generics = []
    if tk(tokens, p) == "OP" and tv(tokens, p) == "<"
        p = p + 1
        while tv(tokens, p) != ">" and tk(tokens, p) != "EOF"
            if len(type_generics) > 0
                p = expect(tokens, p, ",", pe)
                if tk(tokens, p) == "EOF"
                    break
            push(type_generics, tv(tokens, p))
            p = p + 1
        if tk(tokens, p) != "EOF"
            p = p + 1
    let impl_traits = []
    if tk(tokens, p) == "COLON"
        p = p + 1
        push(impl_traits, tv(tokens, p))
        p = p + 1
        while tv(tokens, p) == ","
            p = p + 1
            push(impl_traits, tv(tokens, p))
            p = p + 1
    let p2 = skip_nl(tokens, p)
    let fields = []
    while tk(tokens, p2) != "EOF"
        let cur_tok = tokens[p2]
        match cur_tok
            Token(k, v, line, col) =>
                if col <= 1 and k != "IDENT"
                    break
                if col <= 1 and k == "IDENT"
                    if p2 + 1 < len(tokens) and tk(tokens, p2 + 1) == "COLON"
                        let fname = tv(tokens, p2)
                        p2 = p2 + 2
                        let ftype = tv(tokens, p2)
                        p2 = p2 + 1
                        push(fields, Param(fname, ftype, null_expr()))
                        p2 = skip_nl(tokens, p2)
                    else
                        break
                else if k == "IDENT"
                    let fname = tv(tokens, p2)
                    p2 = p2 + 1
                    if tk(tokens, p2) == "COLON"
                        p2 = p2 + 1
                        let ftype = tv(tokens, p2)
                        p2 = p2 + 1
                        push(fields, Param(fname, ftype, null_expr()))
                    p2 = skip_nl(tokens, p2)
                else
                    break
    let type_annotations = []
    if len(type_generics) > 0
        let tg_children = []
        for g in type_generics
            push(tg_children, Expr("ident", g, 0, [], [], ln))
        push(type_annotations, Expr("generics", "", 0, tg_children, [], ln))
    for it in impl_traits
        push(type_annotations, Expr("impl_trait", it, 0, [], [], ln))
    StmtParseResult(Stmt("type", name, null_expr(), [], fields, [], type_annotations, ln), p2)

fn parse_trait_decl(tokens: list, pos: int, pe: list) -> StmtParseResult
    let ln = tl(tokens, pos)
    let p = pos + 1
    let name = tv(tokens, p)
    p = p + 1
    let p2 = skip_nl(tokens, p)
    let trait_col = 1
    let trait_tok = tokens[pos]
    match trait_tok
        Token(tk2, tv2, tl2, tc2) =>
            trait_col = tc2
    let methods = []
    while tk(tokens, p2) != "EOF"
        if tk(tokens, p2) == "NEWLINE"
            p2 = p2 + 1
            continue
        let cur_tok = tokens[p2]
        let cur_col = 0
        match cur_tok
            Token(k, v, line, col) =>
                cur_col = col
        if cur_col <= trait_col
            break
        if tk(tokens, p2) == "KW" and tv(tokens, p2) == "fn"
            let mln = tl(tokens, p2)
            p2 = p2 + 1
            let mname = tv(tokens, p2)
            p2 = p2 + 1
            let mparams = []
            if tv(tokens, p2) == "("
                p2 = p2 + 1
                while tv(tokens, p2) != ")" and tk(tokens, p2) != "EOF"
                    if len(mparams) > 0
                        if tv(tokens, p2) == ","
                            p2 = p2 + 1
                    let mpn = tv(tokens, p2)
                    p2 = p2 + 1
                    let mpt = ""
                    if tk(tokens, p2) == "COLON"
                        p2 = p2 + 1
                        mpt = tv(tokens, p2)
                        p2 = p2 + 1
                    push(mparams, Param(mpn, mpt, null_expr()))
                if tv(tokens, p2) == ")"
                    p2 = p2 + 1
            let mret = ""
            if tk(tokens, p2) == "ARROW"
                p2 = p2 + 1
                mret = tv(tokens, p2)
                p2 = p2 + 1
            push(methods, Stmt("fn_sig", mname, Expr("rettype", mret, 0, [], [], mln), [], mparams, [], [], mln))
        else
            p2 = p2 + 1
    StmtParseResult(Stmt("trait", name, null_expr(), methods, [], [], [], ln), p2)

fn parse_enum_decl(tokens: list, pos: int, pe: list) -> StmtParseResult
    let ln = tl(tokens, pos)
    let p = pos + 1
    let enum_name = tv(tokens, p)
    p = p + 1
    let p2 = skip_nl(tokens, p)
    let variant_stmts = []
    while tk(tokens, p2) != "EOF"
        let cur_tok = tokens[p2]
        match cur_tok
            Token(k, v, line, col) =>
                if col <= 1 and k != "IDENT"
                    break
                if k == "IDENT"
                    let vname = tv(tokens, p2)
                    p2 = p2 + 1
                    let vfields = []
                    if p2 < len(tokens) and tk(tokens, p2) == "DELIM" and tv(tokens, p2) == "("
                        p2 = p2 + 1
                        while tv(tokens, p2) != ")" and tk(tokens, p2) != "EOF"
                            if len(vfields) > 0
                                p2 = expect(tokens, p2, ",", pe)
                                if tk(tokens, p2) == "EOF"
                                    break
                            let fname = tv(tokens, p2)
                            p2 = p2 + 1
                            let ftype = ""
                            if tk(tokens, p2) == "COLON"
                                p2 = p2 + 1
                                ftype = tv(tokens, p2)
                                p2 = p2 + 1
                            else
                                ftype = "any"
                            push(vfields, Param(fname, ftype, null_expr()))
                        p2 = expect(tokens, p2, ")", pe)
                    push(variant_stmts, Stmt("type", vname, null_expr(), [], vfields, [], [], ln))
                    p2 = skip_nl(tokens, p2)
                else
                    break
    StmtParseResult(Stmt("enum", enum_name, null_expr(), variant_stmts, [], [], [], ln), p2)

fn parse_if_chain(tokens: list, pos: int, base_col: int, pe: list) -> StmtParseResult
    let ln = tl(tokens, pos)
    let p = pos + 1
    let cond_r = parse_expr(tokens, p, 0, pe)
    let p2 = skip_nl(tokens, cond_r.pos)
    let then_body = []
    while tk(tokens, p2) != "EOF"
        if tok_col(tokens, p2) <= base_col
            break
        let sr = parse_stmt(tokens, p2, pe)
        push(then_body, sr.stmt)
        p2 = skip_nl(tokens, sr.pos)
    let else_body = []
    if tk(tokens, p2) == "KW" and tv(tokens, p2) == "else" and tok_col(tokens, p2) == base_col
        p2 = p2 + 1
        if tk(tokens, p2) == "KW" and tv(tokens, p2) == "if"
            let nested_r = parse_if_chain(tokens, p2, base_col, pe)
            push(else_body, nested_r.stmt)
            p2 = nested_r.pos
        else
            p2 = skip_nl(tokens, p2)
            while tk(tokens, p2) != "EOF"
                if tok_col(tokens, p2) <= base_col
                    break
                let sr = parse_stmt(tokens, p2, pe)
                push(else_body, sr.stmt)
                p2 = skip_nl(tokens, sr.pos)
    StmtParseResult(Stmt("if", "", cond_r.expr, then_body, [], else_body, [], ln), p2)

fn parse_if_stmt(tokens: list, pos: int, pe: list) -> StmtParseResult
    parse_if_chain(tokens, pos, tok_col(tokens, pos), pe)

fn parse_while_stmt(tokens: list, pos: int, pe: list) -> StmtParseResult
    let ln = tl(tokens, pos)
    let kw_col = tok_col(tokens, pos)
    let p = pos + 1
    let cond_r = parse_expr(tokens, p, 0, pe)
    let p2 = skip_nl(tokens, cond_r.pos)
    let body = []
    while tk(tokens, p2) != "EOF"
        if tok_col(tokens, p2) <= kw_col
            break
        let sr = parse_stmt(tokens, p2, pe)
        push(body, sr.stmt)
        p2 = skip_nl(tokens, sr.pos)
    if len(body) == 0
        syntax_error(tokens, pos, "while loop has an empty body; loop body must be indented past the 'while' keyword and contain at least one statement", pe)
    StmtParseResult(Stmt("while", "", cond_r.expr, body, [], [], [], ln), p2)

fn parse_for_stmt(tokens: list, pos: int, pe: list) -> StmtParseResult
    let ln = tl(tokens, pos)
    let kw_col = tok_col(tokens, pos)
    let p = pos + 1
    let var_name = tv(tokens, p)
    p = p + 1
    if tk(tokens, p) == "KW" and tv(tokens, p) == "in"
        p = p + 1
    let iter_r = parse_expr(tokens, p, 0, pe)
    let p2 = skip_nl(tokens, iter_r.pos)
    let body = []
    while tk(tokens, p2) != "EOF"
        if tok_col(tokens, p2) <= kw_col
            break
        let sr = parse_stmt(tokens, p2, pe)
        push(body, sr.stmt)
        p2 = skip_nl(tokens, sr.pos)
    if len(body) == 0
        syntax_error(tokens, pos, "for loop has an empty body; loop body must be indented past the 'for' keyword and contain at least one statement", pe)
    StmtParseResult(Stmt("for", var_name, iter_r.expr, body, [], [], [], ln), p2)

fn parse_match_stmt(tokens: list, pos: int, pe: list) -> StmtParseResult
    let ln = tl(tokens, pos)
    let p = pos + 1
    let subject_r = parse_expr(tokens, p, 0, pe)
    let p2 = skip_nl(tokens, subject_r.pos)
    let arms = []
    let arm_ref_col = tok_col(tokens, p2)
    while tk(tokens, p2) != "EOF"
        if tok_col(tokens, p2) < arm_ref_col
            break
        let pat_start = p2
        let pat_r = parse_pattern(tokens, p2, pe)
        let arm_col = tok_col(tokens, p2)
        p2 = pat_r.pos
        if p2 <= pat_start
            p2 = syntax_error(tokens, p2, "invalid match arm pattern; expected a pattern, got '" + tv(tokens, p2) + "'", pe)
            break
        let arm_guard = null_expr()
        if tk(tokens, p2) == "KW" and tv(tokens, p2) == "if"
            p2 = p2 + 1
            let guard_r = parse_expr(tokens, p2, 2, pe)
            arm_guard = guard_r.expr
            p2 = guard_r.pos
        if tk(tokens, p2) == "FAT_ARROW"
            p2 = p2 + 1
        p2 = skip_nl(tokens, p2)
        let arm_body = []
        while tk(tokens, p2) != "EOF"
            if tok_col(tokens, p2) <= arm_col
                break
            let sr = parse_stmt(tokens, p2, pe)
            push(arm_body, sr.stmt)
            p2 = skip_nl(tokens, sr.pos)
        push(arms, Stmt("arm", "", pat_r.expr, arm_body, [], [], [arm_guard], ln))
    if len(arms) == 0
        syntax_error(tokens, pos, "match has no arms; provide at least one pattern arm", pe)
    StmtParseResult(Stmt("match", "", subject_r.expr, arms, [], [], [], ln), p2)

fn parse_import_stmt(tokens: list, pos: int) -> StmtParseResult
    let ln = tl(tokens, pos)
    let p = pos + 1
    let module_name = tv(tokens, p)
    p = p + 1
    let alias = module_name
    if tk(tokens, p) == "KW" and tv(tokens, p) == "as"
        p = p + 1
        alias = tv(tokens, p)
        p = p + 1
    StmtParseResult(Stmt("import", module_name, null_expr(), [], [], [], [alias], ln), p)

fn parse_program(tokens: list, pe: list) -> list
    let stmts = []
    let pos = skip_nl(tokens, 0)
    while tk(tokens, pos) != "EOF"
        let prev_pe_len = len(pe)
        let sr = parse_stmt(tokens, pos, pe)
        let new_pos = skip_nl(tokens, sr.pos)
        // If a parse error was recorded and pos didn't advance, force forward
        if len(pe) > prev_pe_len and new_pos <= pos and tk(tokens, pos) != "EOF"
            pos = pos + 1
        else
            pos = new_pos
        match sr.stmt
            Stmt(stag, sn, se, sb, sp2, seb, sa, sl) =>
                if stag != "error"
                    push(stmts, sr.stmt)
    stmts

// ── LLVM IR Code Generator ───────────────────────────────────────────────────

type CodeGen
    output: list
    strings: list
    str_map: dict
    reg_count: int
    label_count: int
    fn_names: list
    current_slots: dict
    current_fn: string
    struct_defs: dict
    indent: string
    loop_hdr: string
    loop_exit: string
    field_map: dict

fn new_codegen() -> CodeGen
    CodeGen([], [], {}, 0, 0, [], {}, "", {}, "  ", "", "", {})

fn fresh_reg(cg: CodeGen) -> string
    let r = "%r" + str(cg.reg_count)
    cg.reg_count = cg.reg_count + 1
    r

fn fresh_tmp(cg: CodeGen) -> string
    let t = "%t" + str(cg.reg_count)
    cg.reg_count = cg.reg_count + 1
    t

fn fresh_label(cg: CodeGen, prefix: string) -> string
    let l = prefix + str(cg.label_count)
    cg.label_count = cg.label_count + 1
    l

fn intern_string(cg: CodeGen, s: string) -> int
    if contains(cg.str_map, s)
        return cg.str_map[s]
    let idx = len(cg.strings)
    push(cg.strings, s)
    cg.str_map[s] = idx
    idx

fn emit(cg: CodeGen, line: string)
    push(cg.output, line)

fn emit_indent(cg: CodeGen, line: string)
    push(cg.output, cg.indent + line)

// Get or create a stack slot for a variable
fn get_slot(cg: CodeGen, name: string) -> string
    let slots = cg.current_slots
    if contains(slots, name)
        return slots[name]
    let slot = "%slot." + name
    slots[name] = slot
    slot

// ── LLVM Codegen: Expressions ────────────────────────────────────────────────

fn codegen_expr(cg: CodeGen, expr: Expr) -> string
    match expr
        Expr(tag, value, num, children, fields, eline) =>
            if tag == "int"
                str(num)
            else if tag == "bool"
                str(num)
            else if tag == "null"
                "0"
            else if tag == "float"
                let bits = float_bits(value)
                str(bits)
            else if tag == "str"
                let idx = intern_string(cg, value)
                let r = fresh_reg(cg)
                let slen = len(value) + 1
                emit_indent(cg, r + " = getelementptr inbounds [" + str(slen) + " x i8], ptr @.str." + str(idx) + ", i64 0, i64 0")
                let r2 = fresh_reg(cg)
                emit_indent(cg, r2 + " = ptrtoint ptr " + r + " to i64")
                r2
            else if tag == "str_interp"
                let acc = ""
                let si = 0
                while si < len(children)
                    let part = children[si]
                    match part
                        Expr(ptag, pval, pnum, pch, pf, pln) =>
                            if ptag == "str"
                                let sidx = intern_string(cg, pval)
                                let sr = fresh_reg(cg)
                                let sl = len(pval) + 1
                                emit_indent(cg, sr + " = getelementptr inbounds [" + str(sl) + " x i8], ptr @.str." + str(sidx) + ", i64 0, i64 0")
                                let sr2 = fresh_reg(cg)
                                emit_indent(cg, sr2 + " = ptrtoint ptr " + sr + " to i64")
                                if acc == ""
                                    acc = sr2
                                else
                                    let cat = fresh_reg(cg)
                                    emit_indent(cg, cat + " = call i64 @nova_rt_str_concat(i64 " + acc + ", i64 " + sr2 + ")")
                                    acc = cat
                            else
                                let val_r = codegen_expr(cg, part)
                                let str_r = fresh_reg(cg)
                                emit_indent(cg, str_r + " = call i64 @nova_rt_any_to_str(i64 " + val_r + ")")
                                if acc == ""
                                    acc = str_r
                                else
                                    let cat = fresh_reg(cg)
                                    emit_indent(cg, cat + " = call i64 @nova_rt_str_concat(i64 " + acc + ", i64 " + str_r + ")")
                                    acc = cat
                    si = si + 1
                if acc == ""
                    let eidx = intern_string(cg, "")
                    let er = fresh_reg(cg)
                    emit_indent(cg, er + " = getelementptr inbounds [1 x i8], ptr @.str." + str(eidx) + ", i64 0, i64 0")
                    let er2 = fresh_reg(cg)
                    emit_indent(cg, er2 + " = ptrtoint ptr " + er + " to i64")
                    er2
                else
                    acc
            else if tag == "ident"
                let slot = get_slot(cg, value)
                let r = fresh_reg(cg)
                emit_indent(cg, r + " = load i64, ptr " + slot + ", align 8")
                r
            else if tag == "binop"
                codegen_binop(cg, value, children[0], children[1])
            else if tag == "unary"
                codegen_unary(cg, value, children[0])
            else if tag == "call"
                codegen_call(cg, value, children)
            else if tag == "method_call"
                codegen_method_call(cg, value, children)
            else if tag == "index"
                let target_r = codegen_expr(cg, children[0])
                let idx_r = codegen_expr(cg, children[1])
                let r = fresh_reg(cg)
                emit_indent(cg, r + " = call i64 @nova_rt_index_get(i64 " + target_r + ", i64 " + idx_r + ")")
                r
            else if tag == "member"
                let target_r = codegen_expr(cg, children[0])
                // Member access: field name is in 'value'
                // Lookup struct field index from struct_defs
                let field_idx = get_field_index(cg, value)
                let r = fresh_reg(cg)
                let ptr = fresh_tmp(cg)
                emit_indent(cg, ptr + " = inttoptr i64 " + target_r + " to ptr")
                let gep = fresh_tmp(cg)
                emit_indent(cg, gep + " = getelementptr i64, ptr " + ptr + ", i64 " + str(field_idx))
                emit_indent(cg, r + " = load i64, ptr " + gep + ", align 8")
                r
            else if tag == "list"
                let r = fresh_reg(cg)
                emit_indent(cg, r + " = call i64 @nova_rt_list_create()")
                for elem in children
                    let elem_r = codegen_expr(cg, elem)
                    let tmp = fresh_tmp(cg)
                    emit_indent(cg, tmp + " = call i64 @nova_rt_list_append(i64 " + r + ", i64 " + elem_r + ")")
                r
            else if tag == "dict"
                let r = fresh_reg(cg)
                emit_indent(cg, r + " = call i64 @nova_rt_dict_create()")
                for entry in children
                    match entry
                        Expr(et, ev, en, ec, ef, eln) =>
                            let key_r = codegen_expr(cg, ec[0])
                            let val_r = codegen_expr(cg, ec[1])
                            let tmp = fresh_tmp(cg)
                            emit_indent(cg, tmp + " = call i64 @nova_rt_dict_set(i64 " + r + ", i64 " + key_r + ", i64 " + val_r + ")")
                r
            else if tag == "if"
                codegen_if_expr(cg, children)
            else
                "0"

fn codegen_binop(cg: CodeGen, op: string, left: Expr, right: Expr) -> string
    let l = codegen_expr(cg, left)
    let r_val = codegen_expr(cg, right)
    let result = fresh_reg(cg)
    if op == "+"
        emit_indent(cg, result + " = call i64 @nova_rt_add(i64 " + l + ", i64 " + r_val + ")")
    else if op == "-"
        emit_indent(cg, result + " = sub i64 " + l + ", " + r_val)
    else if op == "*"
        emit_indent(cg, result + " = mul i64 " + l + ", " + r_val)
    else if op == "/"
        emit_indent(cg, result + " = sdiv i64 " + l + ", " + r_val)
    else if op == "%"
        emit_indent(cg, result + " = srem i64 " + l + ", " + r_val)
    else if op == "=="
        let cmp = fresh_tmp(cg)
        emit_indent(cg, cmp + " = call i64 @nova_rt_eq(i64 " + l + ", i64 " + r_val + ")")
        emit_indent(cg, result + " = and i64 " + cmp + ", 1")
        // Use result directly (already i64 0 or 1)
        return cmp
    else if op == "!="
        let cmp = fresh_tmp(cg)
        emit_indent(cg, cmp + " = call i64 @nova_rt_neq(i64 " + l + ", i64 " + r_val + ")")
        return cmp
    else if op == "<"
        let cmp = fresh_tmp(cg)
        emit_indent(cg, cmp + " = icmp slt i64 " + l + ", " + r_val)
        emit_indent(cg, result + " = zext i1 " + cmp + " to i64")
    else if op == ">"
        let cmp = fresh_tmp(cg)
        emit_indent(cg, cmp + " = icmp sgt i64 " + l + ", " + r_val)
        emit_indent(cg, result + " = zext i1 " + cmp + " to i64")
    else if op == "<="
        let cmp = fresh_tmp(cg)
        emit_indent(cg, cmp + " = icmp sle i64 " + l + ", " + r_val)
        emit_indent(cg, result + " = zext i1 " + cmp + " to i64")
    else if op == ">="
        let cmp = fresh_tmp(cg)
        emit_indent(cg, cmp + " = icmp sge i64 " + l + ", " + r_val)
        emit_indent(cg, result + " = zext i1 " + cmp + " to i64")
    else if op == "and"
        let lbl_entry = fresh_label(cg, "and_entry")
        emit_indent(cg, "br label %" + lbl_entry)
        emit(cg, lbl_entry + ":")
        let cmp = fresh_tmp(cg)
        emit_indent(cg, cmp + " = icmp ne i64 " + l + ", 0")
        let lbl_rhs = fresh_label(cg, "and_rhs")
        let lbl_end = fresh_label(cg, "and_end")
        emit_indent(cg, "br i1 " + cmp + ", label %" + lbl_rhs + ", label %" + lbl_end)
        emit(cg, lbl_rhs + ":")
        let r2 = codegen_expr(cg, right)
        let lbl_rhs_done = fresh_label(cg, "and_done")
        emit_indent(cg, "br label %" + lbl_rhs_done)
        emit(cg, lbl_rhs_done + ":")
        emit_indent(cg, "br label %" + lbl_end)
        emit(cg, lbl_end + ":")
        emit_indent(cg, result + " = phi i64 [0, %" + lbl_entry + "], [" + r2 + ", %" + lbl_rhs_done + "]")
        return result
    else if op == "or"
        let lbl_entry = fresh_label(cg, "or_entry")
        emit_indent(cg, "br label %" + lbl_entry)
        emit(cg, lbl_entry + ":")
        let cmp = fresh_tmp(cg)
        emit_indent(cg, cmp + " = icmp ne i64 " + l + ", 0")
        let lbl_rhs = fresh_label(cg, "or_rhs")
        let lbl_end = fresh_label(cg, "or_end")
        emit_indent(cg, "br i1 " + cmp + ", label %" + lbl_end + ", label %" + lbl_rhs)
        emit(cg, lbl_rhs + ":")
        let r2 = codegen_expr(cg, right)
        let lbl_rhs_done = fresh_label(cg, "or_done")
        emit_indent(cg, "br label %" + lbl_rhs_done)
        emit(cg, lbl_rhs_done + ":")
        emit_indent(cg, "br label %" + lbl_end)
        emit(cg, lbl_end + ":")
        emit_indent(cg, result + " = phi i64 [" + l + ", %" + lbl_entry + "], [" + r2 + ", %" + lbl_rhs_done + "]")
        return result
    else if op == "<<" or op == ">>" or op == "&" or op == "|" or op == "^"
        let llvm_op = if op == "<<"
            "shl"
        else if op == ">>"
            "ashr"
        else if op == "&"
            "and"
        else if op == "|"
            "or"
        else
            "xor"
        emit_indent(cg, result + " = " + llvm_op + " i64 " + l + ", " + r_val)
    else if op == ".."
        emit_indent(cg, result + " = call i64 @nova_rt_range_from_to(i64 " + l + ", i64 " + r_val + ")")
    else
        emit_indent(cg, result + " = add i64 " + l + ", " + r_val)
    result

fn codegen_unary(cg: CodeGen, op: string, operand: Expr) -> string
    let val = codegen_expr(cg, operand)
    let result = fresh_reg(cg)
    if op == "-"
        emit_indent(cg, result + " = sub i64 0, " + val)
    else if op == "not"
        let cmp = fresh_tmp(cg)
        emit_indent(cg, cmp + " = icmp eq i64 " + val + ", 0")
        emit_indent(cg, result + " = zext i1 " + cmp + " to i64")
    else if op == "~"
        emit_indent(cg, result + " = xor i64 " + val + ", -1")
    else
        return val
    result

fn codegen_call(cg: CodeGen, name: string, args: list) -> string
    // Check if this is a struct constructor
    if contains(cg.struct_defs, name)
        let num_fields = len(args)
        let alloc_size = num_fields * 8
        let ptr = fresh_reg(cg)
        emit_indent(cg, ptr + " = call ptr @nova_rt_struct_alloc(i64 " + str(alloc_size) + ")")
        let fi = 0
        for arg in args
            let arg_r = codegen_expr(cg, arg)
            let gep = fresh_tmp(cg)
            emit_indent(cg, gep + " = getelementptr i64, ptr " + ptr + ", i64 " + str(fi))
            emit_indent(cg, "store i64 " + arg_r + ", ptr " + gep + ", align 8")
            fi = fi + 1
        let result = fresh_reg(cg)
        emit_indent(cg, result + " = ptrtoint ptr " + ptr + " to i64")
        return result
    // Map NOVA stdlib names to runtime functions
    let rt_name = resolve_runtime_fn(name)
    let arg_strs = []
    for arg in args
        let a = codegen_expr(cg, arg)
        push(arg_strs, "i64 " + a)
    let result = fresh_reg(cg)
    let args_str = join(arg_strs, ", ")
    emit_indent(cg, result + " = call i64 @" + rt_name + "(" + args_str + ")")
    result

fn codegen_method_call(cg: CodeGen, method: string, args: list) -> string
    // args[0] is receiver, rest are method args
    let rt_name = resolve_method_fn(method)
    let arg_strs = []
    for arg in args
        let a = codegen_expr(cg, arg)
        push(arg_strs, "i64 " + a)
    let result = fresh_reg(cg)
    let args_str = join(arg_strs, ", ")
    emit_indent(cg, result + " = call i64 @" + rt_name + "(" + args_str + ")")
    result

fn codegen_if_expr(cg: CodeGen, parts: list) -> string
    let cond_r = codegen_expr(cg, parts[0])
    let cmp = fresh_tmp(cg)
    emit_indent(cg, cmp + " = icmp ne i64 " + cond_r + ", 0")
    let lbl_then = fresh_label(cg, "if_then")
    let lbl_else = fresh_label(cg, "if_else")
    let lbl_merge = fresh_label(cg, "if_merge")
    emit_indent(cg, "br i1 " + cmp + ", label %" + lbl_then + ", label %" + lbl_else)
    emit(cg, lbl_then + ":")
    let then_r = codegen_expr(cg, parts[1])
    let lbl_then_done = fresh_label(cg, "if_then_done")
    emit_indent(cg, "br label %" + lbl_then_done)
    emit(cg, lbl_then_done + ":")
    emit_indent(cg, "br label %" + lbl_merge)
    emit(cg, lbl_else + ":")
    let else_r = if len(parts) > 2
        codegen_expr(cg, parts[2])
    else
        "0"
    let lbl_else_done = fresh_label(cg, "if_else_done")
    emit_indent(cg, "br label %" + lbl_else_done)
    emit(cg, lbl_else_done + ":")
    emit_indent(cg, "br label %" + lbl_merge)
    emit(cg, lbl_merge + ":")
    let result = fresh_reg(cg)
    emit_indent(cg, result + " = phi i64 [" + then_r + ", %" + lbl_then_done + "], [" + else_r + ", %" + lbl_else_done + "]")
    result

// ── LLVM Codegen: Statements ─────────────────────────────────────────────────

fn codegen_stmt(cg: CodeGen, stmt: Stmt)
    match stmt
        Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
            if tag == "assign"
                let val_r = codegen_expr(cg, expr)
                if name != ""
                    let slot = get_slot(cg, name)
                    emit_indent(cg, "store i64 " + val_r + ", ptr " + slot + ", align 8")
                else if len(annotations) > 0
                    let lhs = annotations[0]
                    let lhs_is_ident = false
                    let lhs_ident_nm = ""
                    match lhs
                        Expr(et, ev, en, ec, ef, eln) =>
                            if et == "ident"
                                lhs_is_ident = true
                                lhs_ident_nm = ev
                    if lhs_is_ident
                        let slot = get_slot(cg, lhs_ident_nm)
                        emit_indent(cg, "store i64 " + val_r + ", ptr " + slot + ", align 8")
                    else
                        codegen_assign_target(cg, lhs, val_r)
            else if tag == "compound_assign"
                let lhs = annotations[0]
                let lhs_val = codegen_expr(cg, lhs)
                let rhs_val = codegen_expr(cg, expr)
                let result = fresh_reg(cg)
                if name == "+=" or name == "+"
                    emit_indent(cg, result + " = call i64 @nova_rt_add(i64 " + lhs_val + ", i64 " + rhs_val + ")")
                else if name == "-=" or name == "-"
                    emit_indent(cg, result + " = sub i64 " + lhs_val + ", " + rhs_val)
                else if name == "*=" or name == "*"
                    emit_indent(cg, result + " = mul i64 " + lhs_val + ", " + rhs_val)
                else
                    emit_indent(cg, result + " = sdiv i64 " + lhs_val + ", " + rhs_val)
                codegen_assign_target(cg, lhs, result)
            else if tag == "expr"
                let _discard = codegen_expr(cg, expr)
            else if tag == "return"
                let val_r = codegen_expr(cg, expr)
                emit_indent(cg, "ret i64 " + val_r)
            else if tag == "if"
                codegen_if_stmt(cg, stmt)
            else if tag == "while"
                codegen_while_stmt(cg, stmt)
            else if tag == "for"
                codegen_for_stmt(cg, stmt)
            else if tag == "match"
                codegen_match_stmt(cg, stmt)
            else if tag == "break"
                emit_indent(cg, "br label %" + cg.loop_exit)
            else if tag == "continue"
                emit_indent(cg, "br label %" + cg.loop_hdr)

fn codegen_assign_target(cg: CodeGen, target: Expr, val_reg: string)
    match target
        Expr(tag, value, num, children, fields, eline) =>
            if tag == "ident"
                let slot = get_slot(cg, value)
                emit_indent(cg, "store i64 " + val_reg + ", ptr " + slot + ", align 8")
            else if tag == "index"
                let target_r = codegen_expr(cg, children[0])
                let idx_r = codegen_expr(cg, children[1])
                let tmp = fresh_tmp(cg)
                emit_indent(cg, tmp + " = call i64 @nova_rt_index_set(i64 " + target_r + ", i64 " + idx_r + ", i64 " + val_reg + ")")
            else if tag == "member"
                let target_r = codegen_expr(cg, children[0])
                let field_idx = get_field_index(cg, value)
                let ptr = fresh_tmp(cg)
                emit_indent(cg, ptr + " = inttoptr i64 " + target_r + " to ptr")
                let gep = fresh_tmp(cg)
                emit_indent(cg, gep + " = getelementptr i64, ptr " + ptr + ", i64 " + str(field_idx))
                emit_indent(cg, "store i64 " + val_reg + ", ptr " + gep + ", align 8")

fn codegen_if_stmt(cg: CodeGen, stmt: Stmt)
    match stmt
        Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
            let cond_r = codegen_expr(cg, expr)
            let cmp = fresh_tmp(cg)
            emit_indent(cg, cmp + " = icmp ne i64 " + cond_r + ", 0")
            let lbl_then = fresh_label(cg, "then")
            let lbl_else = fresh_label(cg, "else")
            let lbl_merge = fresh_label(cg, "merge")
            emit_indent(cg, "br i1 " + cmp + ", label %" + lbl_then + ", label %" + lbl_else)
            emit(cg, lbl_then + ":")
            for s in body
                codegen_stmt(cg, s)
            emit_indent(cg, "br label %" + lbl_merge)
            emit(cg, lbl_else + ":")
            for s in else_body
                codegen_stmt(cg, s)
            emit_indent(cg, "br label %" + lbl_merge)
            emit(cg, lbl_merge + ":")

fn codegen_while_stmt(cg: CodeGen, stmt: Stmt)
    match stmt
        Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
            let prev_hdr = cg.loop_hdr
            let prev_exit = cg.loop_exit
            let lbl_hdr = fresh_label(cg, "while_hdr")
            let lbl_body = fresh_label(cg, "while_body")
            let lbl_exit = fresh_label(cg, "while_exit")
            cg.loop_hdr = lbl_hdr
            cg.loop_exit = lbl_exit
            emit_indent(cg, "br label %" + lbl_hdr)
            emit(cg, lbl_hdr + ":")
            let cond_r = codegen_expr(cg, expr)
            let cmp = fresh_tmp(cg)
            emit_indent(cg, cmp + " = icmp ne i64 " + cond_r + ", 0")
            emit_indent(cg, "br i1 " + cmp + ", label %" + lbl_body + ", label %" + lbl_exit)
            emit(cg, lbl_body + ":")
            for s in body
                codegen_stmt(cg, s)
            emit_indent(cg, "br label %" + lbl_hdr)
            emit(cg, lbl_exit + ":")
            cg.loop_hdr = prev_hdr
            cg.loop_exit = prev_exit

fn codegen_for_stmt(cg: CodeGen, stmt: Stmt)
    match stmt
        Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
            let prev_hdr = cg.loop_hdr
            let prev_exit = cg.loop_exit
            let raw_iter = codegen_expr(cg, expr)
            let iter_r = fresh_reg(cg)
            emit_indent(cg, iter_r + " = call i64 @nova_rt_for_iter_init(i64 " + raw_iter + ")")
            let len_r = fresh_reg(cg)
            emit_indent(cg, len_r + " = call i64 @nova_rt_len_any(i64 " + iter_r + ")")
            let idx_name = "__for_idx_" + str(cg.label_count)
            let idx_slot = get_slot(cg, idx_name)
            emit_indent(cg, idx_slot + " = alloca i64, align 8")
            emit_indent(cg, "store i64 0, ptr " + idx_slot + ", align 8")
            let lbl_hdr = fresh_label(cg, "for_hdr")
            let lbl_body = fresh_label(cg, "for_body")
            let lbl_exit = fresh_label(cg, "for_exit")
            cg.loop_hdr = lbl_hdr
            cg.loop_exit = lbl_exit
            emit_indent(cg, "br label %" + lbl_hdr)
            emit(cg, lbl_hdr + ":")
            let idx_r = fresh_reg(cg)
            emit_indent(cg, idx_r + " = load i64, ptr " + idx_slot + ", align 8")
            let cmp = fresh_tmp(cg)
            emit_indent(cg, cmp + " = icmp slt i64 " + idx_r + ", " + len_r)
            emit_indent(cg, "br i1 " + cmp + ", label %" + lbl_body + ", label %" + lbl_exit)
            emit(cg, lbl_body + ":")
            // Load current element
            let elem_r = fresh_reg(cg)
            emit_indent(cg, elem_r + " = call i64 @nova_rt_index_get(i64 " + iter_r + ", i64 " + idx_r + ")")
            let var_slot = get_slot(cg, name)
            emit_indent(cg, "store i64 " + elem_r + ", ptr " + var_slot + ", align 8")
            for s in body
                codegen_stmt(cg, s)
            // Increment index
            let new_idx = fresh_reg(cg)
            let cur_idx = fresh_reg(cg)
            emit_indent(cg, cur_idx + " = load i64, ptr " + idx_slot + ", align 8")
            emit_indent(cg, new_idx + " = add i64 " + cur_idx + ", 1")
            emit_indent(cg, "store i64 " + new_idx + ", ptr " + idx_slot + ", align 8")
            emit_indent(cg, "br label %" + lbl_hdr)
            emit(cg, lbl_exit + ":")
            cg.loop_hdr = prev_hdr
            cg.loop_exit = prev_exit

fn codegen_match_stmt(cg: CodeGen, stmt: Stmt)
    match stmt
        Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
            let subject_r = codegen_expr(cg, expr)
            // For struct destructuring: load fields into variables
            for arm in body
                match arm
                    Stmt(at, an, pattern, arm_body, ap, ae, aa, _aln) =>
                        match pattern
                            Expr(pt, pv, pn, pchildren, pf, pln2) =>
                                if pt == "pat_ctor"
                                    // Destructure: load each field
                                    let ptr = fresh_tmp(cg)
                                    emit_indent(cg, ptr + " = inttoptr i64 " + subject_r + " to ptr")
                                    let fi = 0
                                    for field_pat in pchildren
                                        match field_pat
                                            Expr(fpt, fpv, fpn, fpc, fpf, fpln) =>
                                                if fpv != "_"
                                                    let gep = fresh_tmp(cg)
                                                    emit_indent(cg, gep + " = getelementptr i64, ptr " + ptr + ", i64 " + str(fi))
                                                    let fval = fresh_reg(cg)
                                                    emit_indent(cg, fval + " = load i64, ptr " + gep + ", align 8")
                                                    let fslot = get_slot(cg, fpv)
                                                    emit_indent(cg, "store i64 " + fval + ", ptr " + fslot + ", align 8")
                                        fi = fi + 1
                                for s in arm_body
                                    codegen_stmt(cg, s)

// ── Runtime Function Resolution ──────────────────────────────────────────────

fn resolve_runtime_fn(name: string) -> string
    if name == "print"
        "nova_rt_print_any"
    else if name == "copy"
        "nova_rt_deep_copy"
