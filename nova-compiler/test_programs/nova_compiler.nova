fn emit_string_constants(cg: CodeGen)
    if len(cg.strings) > 0
        emit(cg, "; String constants")
        let i = 0
        for s in cg.strings
            let escaped = llvm_escape_string(s)
            let byte_len = len(s) + 1
            emit(cg, "@.str." + str(i) + " = private unnamed_addr constant [" + str(byte_len) + " x i8] c\"" + escaped + "\\00\"")
            i = i + 1
        emit(cg, "")

fn codegen_last_as_return(cg: CodeGen, stmt: Stmt)
    match stmt
        Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
            if tag == "expr"
                let val = codegen_expr(cg, expr)
                emit_indent(cg, "ret i64 " + val)
            else if tag == "return"
                let val_r = codegen_expr(cg, expr)
                emit_indent(cg, "ret i64 " + val_r)
            else if tag == "match"
                let subject_r = codegen_expr(cg, expr)
                for arm in body
                    match arm
                        Stmt(at, an, pattern, arm_body, ap, ae, aa, _aln) =>
                            match pattern
                                Expr(pt, pv, pn, pchildren, pf, pln2) =>
                                    if pt == "pat_ctor"
                                        let ptr = fresh_tmp(cg)
                                        emit_indent(cg, ptr + " = inttoptr i64 " + subject_r + " to ptr")
                                        let fi = 0
                                        for field_pat in pchildren
                                            match field_pat
                                                Expr(fpt, fpv, fpn, fpc, fpf, fpln) =>
                                                    if fpv != "_"
                                                        let gep = fresh_tmp(cg)
                                                        emit_indent(cg, gep + " = getelementptr i64, ptr " + ptr + ", i64 " + str(fi))
                                                        let fval = fresh_reg(cg)
                                                        emit_indent(cg, fval + " = load i64, ptr " + gep + ", align 8")
                                                        let fslot = get_slot(cg, fpv)
                                                        emit_indent(cg, "store i64 " + fval + ", ptr " + fslot + ", align 8")
                                            fi = fi + 1
                                    let arm_len = len(arm_body)
                                    if arm_len > 0
                                        let ai = 0
                                        while ai < arm_len - 1
                                            codegen_stmt(cg, arm_body[ai])
                                            ai = ai + 1
                                        codegen_last_as_return(cg, arm_body[arm_len - 1])
                                    else
                                        emit_indent(cg, "ret i64 0")
            else if tag == "if"
                let cond_r = codegen_expr(cg, expr)
                let cmp = fresh_tmp(cg)
                emit_indent(cg, cmp + " = icmp ne i64 " + cond_r + ", 0")
                let lbl_then = fresh_label(cg, "ret_then")
                let lbl_else = fresh_label(cg, "ret_else")
                emit_indent(cg, "br i1 " + cmp + ", label %" + lbl_then + ", label %" + lbl_else)
                emit(cg, lbl_then + ":")
                let then_len = len(body)
                if then_len > 0
                    let ti = 0
                    while ti < then_len - 1
                        codegen_stmt(cg, body[ti])
                        ti = ti + 1
                    codegen_last_as_return(cg, body[then_len - 1])
                else
                    emit_indent(cg, "ret i64 0")
                emit(cg, lbl_else + ":")
                let else_len = len(else_body)
                if else_len > 0
                    let ei = 0
                    while ei < else_len - 1
                        codegen_stmt(cg, else_body[ei])
                        ei = ei + 1
                    codegen_last_as_return(cg, else_body[else_len - 1])
                else
                    emit_indent(cg, "ret i64 0")
            else
                codegen_stmt(cg, stmt)
                emit_indent(cg, "ret i64 0")

fn emit_function(cg: CodeGen, stmt: Stmt)
    match stmt
        Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
            cg.current_slots = {}
            cg.reg_count = 0
            let param_strs = []
            let i = 0
            for p in params
                match p
                    Param(pname, ptype, pdefault) =>
                        push(param_strs, "i64 %p" + str(i))
                        i = i + 1
            let params_str = join(param_strs, ", ")
            emit(cg, "define i64 @" + name + "(" + params_str + ") nounwind \{")
            emit(cg, "entry:")
            i = 0
            for p in params
                match p
                    Param(pname, ptype, pdefault) =>
                        let slot = get_slot(cg, pname)
                        emit_indent(cg, slot + " = alloca i64, align 8")
                        emit_indent(cg, "store i64 %p" + str(i) + ", ptr " + slot + ", align 8")
                        i = i + 1
            let locals = collect_locals(body)
            for local_name in locals
                if not contains(cg.current_slots, local_name)
                    let slot = get_slot(cg, local_name)
                    emit_indent(cg, slot + " = alloca i64, align 8")
                    emit_indent(cg, "store i64 0, ptr " + slot + ", align 8")
            let body_len = len(body)
            if body_len > 0
                let si = 0
                while si < body_len - 1
                    codegen_stmt(cg, body[si])
                    si = si + 1
                codegen_last_as_return(cg, body[body_len - 1])
            else
                emit_indent(cg, "ret i64 0")
            emit(cg, "}")
            emit(cg, "")

fn emit_nova_main(cg: CodeGen, stmts: list)
    cg.current_slots = {}
    cg.reg_count = 0
    emit(cg, "define i64 @nova_main() nounwind \{")
    emit(cg, "entry:")
    let locals = collect_locals(stmts)
    for local_name in locals
        let slot = get_slot(cg, local_name)
        emit_indent(cg, slot + " = alloca i64, align 8")
        emit_indent(cg, "store i64 0, ptr " + slot + ", align 8")
    for s in stmts
        codegen_stmt(cg, s)
    if list_contains(cg.fn_names, "nova_user_main")
        let rn = fresh_reg(cg)
        emit_indent(cg, rn + " = call i64 @nova_user_main()")
    emit_indent(cg, "ret i64 0")
    emit(cg, "}")
    emit(cg, "")

fn emit_main_entry(cg: CodeGen)
    emit(cg, "define i32 @main(i32 %argc, ptr %argv) nounwind \{")
    emit(cg, "entry:")
    emit_indent(cg, "%argc64 = sext i32 %argc to i64")
    emit_indent(cg, "%argv64 = ptrtoint ptr %argv to i64")
    emit_indent(cg, "call void @nova_rt_init_args(i64 %argc64, i64 %argv64)")
    emit_indent(cg, "call i64 @nova_main()")
    emit_indent(cg, "call void @nova_rt_wait_all()")
    emit_indent(cg, "call void @nova_rt_cleanup()")
    emit_indent(cg, "ret i32 0")
    emit(cg, "}")

// ── Utility Functions ────────────────────────────────────────────────────────

fn extract_pattern_names(pattern: Expr) -> list
    let names = []
    match pattern
        Expr(tag, value, num, children, fields, eline) =>
            if tag == "pat_ctor"
                for field_pat in children
                    match field_pat
                        Expr(ft, fv, fn_val, fc, ff, _fln) =>
                            if fv != "_" and fv != ""
                                push(names, fv)
    return names

fn expr_ident_name(e: Expr) -> string
    match e
        Expr(tag, value, num, children, fields, eline) =>
            if tag == "ident"
                return value
    return ""

fn collect_locals(stmts: list) -> list
    let locals = []
    for s in stmts
        match s
            Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
                if tag == "assign" and name != ""
                    if not list_contains(locals, name)
                        push(locals, name)
                else if tag == "assign" and len(annotations) > 0
                    let lhs_name = expr_ident_name(annotations[0])
                    if lhs_name != "" and not list_contains(locals, lhs_name)
                        push(locals, lhs_name)
                else if tag == "spawn" and name != ""
                    if not list_contains(locals, name)
                        push(locals, name)
                else if tag == "for"
                    if not list_contains(locals, name)
                        push(locals, name)
                    let sub = collect_locals(body)
                    for l in sub
                        if not list_contains(locals, l)
                            push(locals, l)
                else if tag == "while" or tag == "if"
                    let sub = collect_locals(body)
                    for l in sub
                        if not list_contains(locals, l)
                            push(locals, l)
                    let sub2 = collect_locals(else_body)
                    for l in sub2
                        if not list_contains(locals, l)
                            push(locals, l)
                else if tag == "match"
                    for arm in body
                        match arm
                            Stmt(at, an, pattern, arm_body, ap, ae, aa, _aln) =>
                                let pat_names = extract_pattern_names(pattern)
                                for pn in pat_names
                                    if not list_contains(locals, pn)
                                        push(locals, pn)
                                let sub = collect_locals(arm_body)
                                for l in sub
                                    if not list_contains(locals, l)
                                        push(locals, l)
    locals

fn stmts_has_yield(stmts: list) -> bool
    for s in stmts
        match s
            Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
                if tag == "yield"
                    return true
                if len(body) > 0
                    if stmts_has_yield(body)
                        return true
                if len(else_body) > 0
                    if stmts_has_yield(else_body)
                        return true
    false

fn list_contains(lst: list, item: string) -> bool
    for x in lst
        if x == item
            return true
    false

// ── Free Variable Analysis (for closures) ──────────────────────────────────

fn collect_free_vars_inner(expr: Expr, bound: list, free: list)
    match expr
        Expr(tag, value, num, children, fields, eline) =>
            if tag == "ident"
                if not list_contains(bound, value) and not list_contains(free, value)
                    push(free, value)
            else if tag == "call"
                if value != "" and not list_contains(bound, value) and not list_contains(free, value)
                    push(free, value)
                for child in children
                    collect_free_vars_inner(child, bound, free)
            else if tag == "lambda"
                let inner_bound = []
                for b_item in bound
                    push(inner_bound, b_item)
                for p in fields
                    match p
                        Expr(pt, pv, pn, pc, pf, pln3) =>
                            push(inner_bound, pv)
                if len(children) > 0
                    collect_free_vars_inner(children[0], inner_bound, free)
            else if tag == "for"
                let inner_bound = []
                for b_item in bound
                    push(inner_bound, b_item)
                push(inner_bound, value)
                for child in children
                    collect_free_vars_inner(child, inner_bound, free)
            else
                for child in children
                    collect_free_vars_inner(child, bound, free)

fn collect_free_vars_stmt(stmt: Stmt, bound: list, free: list)
    match stmt
        Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
            if tag == "fn"
                let inner_bound = []
                for b_item in bound
                    push(inner_bound, b_item)
                push(inner_bound, name)
                for p in params
                    match p
                        Param(pname, ptype, pdefault) =>
                            push(inner_bound, pname)
                for s in body
                    collect_free_vars_stmt(s, inner_bound, free)
                push(bound, name)
            else if tag == "let" or tag == "assign"
                collect_free_vars_inner(expr, bound, free)
                if name != ""
                    push(bound, name)
            else if tag == "return" or tag == "expr"
                collect_free_vars_inner(expr, bound, free)
            else if tag == "for"
                collect_free_vars_inner(expr, bound, free)
                let inner_bound = []
                for b_item in bound
                    push(inner_bound, b_item)
                push(inner_bound, name)
                for s in body
                    collect_free_vars_stmt(s, inner_bound, free)
            else
                collect_free_vars_inner(expr, bound, free)
                for s in body
                    collect_free_vars_stmt(s, bound, free)
                for s in else_body
                    collect_free_vars_stmt(s, bound, free)
            for a in annotations
                collect_free_vars_inner(a, bound, free)

fn filter_captures(free: list, fnames: list, sdefs: dict) -> list
    let result = []
    for v in free
        if not list_contains(fnames, v) and resolve_runtime_fn(v) == v and not contains(sdefs, v)
            push(result, v)
    result

// ── Move-Elision Analysis ───────────────────────────────────────────────────

fn me_expr_refs(e: Expr, vn: string) -> int
    match e
        Expr(tag, value, num, children, fields, eline) =>
            let c = 0
            if tag == "ident" and value == vn
                c = 1
            for ch in children
                c = c + me_expr_refs(ch, vn)
            c

fn me_stmt_refs(s: Stmt, vn: string) -> int
    match s
        Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
            let c = me_expr_refs(expr, vn)
            for bs in body
                c = c + me_stmt_refs(bs, vn)
            for es in else_body
                c = c + me_stmt_refs(es, vn)
            if tag == "assign" and len(annotations) > 0
                let a0 = annotations[0]
                match a0
                    Expr(at, av, _, _, _, _) =>
                        if at == "ident" and av == vn
                            let ai = 1
                            while ai < len(annotations)
                                c = c + me_expr_refs(annotations[ai], vn)
                                ai = ai + 1
                        else
                            for a in annotations
                                c = c + me_expr_refs(a, vn)
            else
                for a in annotations
                    c = c + me_expr_refs(a, vn)
            c

fn ir_mark_move_sends(b: IrBuilder, stmts: list)
    let idx = 0
    while idx < len(stmts)
        let s = stmts[idx]
        match s
            Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
                if tag == "expr"
                    match expr
                        Expr(etag, evalue, enum_val, echildren, efields, eline) =>
                            if etag == "call" and evalue == "send" and len(echildren) >= 2
                                let arg2 = echildren[1]
                                match arg2
                                    Expr(a2tag, a2value, _, _, _, _) =>
                                        if a2tag == "ident"
                                            let vn = a2value
                                            let total = 0
                                            for bs in stmts
                                                total = total + me_stmt_refs(bs, vn)
                                            if total == 1
                                                b.ir_locals["__ms_" + str(eline)] = 1
        idx = idx + 1

// ── Lambda Lifting ──────────────────────────────────────────────────────────

fn ir_lift_lambda(b: IrBuilder, lam_params: list, body: Expr, captures: list) -> string
    let lname = "__lambda_" + str(b.ir_lamc)
    let tname = "__tramp_" + str(b.ir_lamc)
    b.ir_lamc = b.ir_lamc + 1

    // Build param list: captures first, then lambda params
    let all_params = []
    for fv in captures
        push(all_params, Param(fv, "", null_expr()))
    let lam_pnames = []
    for p in lam_params
        match p
            Expr(pt, pv, pn, pc, pf, pln3) =>
                push(all_params, Param(pv, "", null_expr()))
                push(lam_pnames, pv)

    // Save builder state
    let save_insts = b.ir_insts
    let save_blocks = b.ir_blocks
    let save_clabel = b.ir_clabel
    let save_rc = b.ir_rc
    let save_locals = b.ir_locals

    // Lower as function: body is a single expression → implicit return
    let body_stmt = Stmt("expr", "", body, [], [], [], [], body.eline)
    let fn_stmt = Stmt("fn", lname, null_expr(), [body_stmt], all_params, [], [], body.eline)
    let ir_fn = ir_lower_function(b, fn_stmt)
    push(b.ir_lambdas, ir_fn)
    push(b.ir_fnames, lname)
    b.ir_fn_arity[lname] = len(all_params)

    // Record trampoline spec: [tramp_name, target_name, num_captures, num_lambda_params]
    let spec = [tname, lname, len(captures), len(lam_pnames)]
    push(b.ir_tramps, spec)
    push(b.ir_fnames, tname)
    b.ir_fn_arity[tname] = 1 + len(lam_pnames)

    // Restore builder state
    b.ir_insts = save_insts
    b.ir_blocks = save_blocks
    b.ir_clabel = save_clabel
    b.ir_rc = save_rc
    b.ir_locals = save_locals

    tname

fn ir_lift_nested_fn(b: IrBuilder, orig_name: string, fn_params: list, fn_body: list, captures: list) -> string
    let lname = "__nfn_" + orig_name + "_" + str(b.ir_lamc)
    let tname = "__ntramp_" + orig_name + "_" + str(b.ir_lamc)
    b.ir_lamc = b.ir_lamc + 1
    let all_params = []
    for fv in captures
        push(all_params, Param(fv, "", null_expr()))
    let user_count = 0
    for p in fn_params
        push(all_params, p)
        user_count = user_count + 1
    let save_insts = b.ir_insts
    let save_blocks = b.ir_blocks
    let save_clabel = b.ir_clabel
    let save_rc = b.ir_rc
    let save_locals = b.ir_locals
    let fn_stmt = Stmt("fn", lname, null_expr(), fn_body, all_params, [], [], 0)
    let ir_fn = ir_lower_function(b, fn_stmt)
    push(b.ir_lambdas, ir_fn)
    push(b.ir_fnames, lname)
    b.ir_fn_arity[lname] = len(all_params)
    let spec = [tname, lname, len(captures), user_count]
    push(b.ir_tramps, spec)
    push(b.ir_fnames, tname)
    b.ir_fn_arity[tname] = 1 + user_count
    b.ir_insts = save_insts
    b.ir_blocks = save_blocks
    b.ir_clabel = save_clabel
    b.ir_rc = save_rc
    b.ir_locals = save_locals
    tname

fn llvm_escape_string(s: string) -> string
    let result = ""
    let i = 0
    while i < len(s)
        let ch = s[i]
        if ch == "\n"
            result = result + "\\0A"
        else if ch == "\r"
            result = result + "\\0D"
        else if ch == "\t"
            result = result + "\\09"
        else if ch == "\0"
            result = result + "\\00"
        else if ch == "\\"
            result = result + "\\\\"
        else if ch == "\""
            result = result + "\\22"
        else
            result = result + ch
        i = i + 1
    result

fn float_bits(s: string) -> int
    parse_float(s)

// ══════════════════════════════════════════════════════════════════════════════
// TYPED IR PIPELINE — AST → IR → LLVM
// Phase 1: All values typed as "any" (equivalent to existing codegen)
// Phase 2: Type inference refines IrType.kind → "int", "str", etc.
//          enabling direct arithmetic, eliminating runtime calls
// ══════════════════════════════════════════════════════════════════════════════

fn ir_type_int() -> IrType
    IrType("int", "", [], 0)

fn ir_type_str() -> IrType
    IrType("str", "", [], 0)

fn ir_type_any() -> IrType
    IrType("any", "", [], 0)

fn ir_type_void() -> IrType
    IrType("void", "", [], 0)

fn ir_type_bool() -> IrType
    IrType("bool", "", [], 0)

fn ir_type_list() -> IrType
    IrType("list", "", [], 0)

fn ir_type_dict() -> IrType
    IrType("dict", "", [], 0)

fn ir_type_float() -> IrType
    IrType("float", "", [], 0)

fn type_name_hash(name: string) -> int
    let h = 5381
    let i = 0
    while i < len(name)
        h = h * 33 + ord(name[i])
        i = i + 1
    h

// ── IR Builder ───────────────────────────────────────────────────────────────

type IrBuilder
    ir_insts: list
    ir_rc: int
    ir_blocks: list
    ir_clabel: string
    ir_slots: dict
    ir_strlits: list
    ir_strmap: dict
    ir_lc: int
    ir_fnames: list
    ir_sdefs: dict
    ir_fmap: dict
    ir_loop_hdr: string
    ir_loop_exit: string
    ir_lambdas: list
    ir_lamc: int
    ir_fn_arity: dict
    ir_locals: dict
    ir_tramps: list
    ir_modules: dict
    ir_fn_defaults: dict
    ir_methods: dict
    ir_field_types: dict
    ir_externs: list
    ir_fn_returns: dict
    ir_ffi_wrapped: dict
    ir_cur_line: int

fn new_ir_builder() -> IrBuilder
    IrBuilder([], 0, [], "entry", {}, [], {}, 0, [], {}, {}, "", "", [], 0, {}, {}, [], {}, {}, {}, {}, [], {}, {}, 0)

fn ir_fresh_reg(b: IrBuilder) -> string
    let r = "%r" + str(b.ir_rc)
    b.ir_rc = b.ir_rc + 1
    r

fn ir_fresh_label(b: IrBuilder, prefix: string) -> string
    let l = prefix + str(b.ir_lc)
    b.ir_lc = b.ir_lc + 1
    l

fn ir_emit_inst(b: IrBuilder, op: string, dest: string, typ: IrType, args: list, value: string, num: int)
    push(b.ir_insts, IrInst(op, dest, typ, args, value, num, "pure", b.ir_cur_line))

fn ir_emit_side(b: IrBuilder, op: string, dest: string, typ: IrType, args: list, value: string, num: int)
    push(b.ir_insts, IrInst(op, dest, typ, args, value, num, "side_effect", b.ir_cur_line))

fn ir_finish_block(b: IrBuilder, terminator: IrInst)
    let block = IrBlock(b.ir_clabel, b.ir_insts, terminator)
    push(b.ir_blocks, block)
    b.ir_insts = []
    b.ir_clabel = ""

fn ir_start_block(b: IrBuilder, label: string)
    b.ir_clabel = label

// ── AST → IR Lowering ────────────────────────────────────────────────────────

fn ir_lower_expr(b: IrBuilder, expr: Expr) -> string
    match expr
        Expr(tag, value, num, children, fields, eline) =>
            if eline > 0
                b.ir_cur_line = eline
            if tag == "int"
                let dest = ir_fresh_reg(b)
                ir_emit_inst(b, "const_int", dest, ir_type_int(), [], str(num), num)
                return dest
            else if tag == "str"
                let dest = ir_fresh_reg(b)
                if not contains(b.ir_strmap, value)
                    push(b.ir_strlits, value)
                    b.ir_strmap[value] = len(b.ir_strlits) - 1
                ir_emit_inst(b, "const_str", dest, ir_type_str(), [], value, 0)
                return dest
            else if tag == "str_interp"
                let acc = ""
                let idx = 0
                while idx < len(children)
                    let part = children[idx]
                    match part
                        Expr(ptag, pval, pnum, pch, pf, pln) =>
                            if ptag == "str"
                                let sreg = ir_fresh_reg(b)
                                if not contains(b.ir_strmap, pval)
                                    push(b.ir_strlits, pval)
                                    b.ir_strmap[pval] = len(b.ir_strlits) - 1
                                ir_emit_inst(b, "const_str", sreg, ir_type_str(), [], pval, 0)
                                if acc == ""
                                    acc = sreg
                                else
                                    let cat = ir_fresh_reg(b)
                                    ir_emit_side(b, "call", cat, ir_type_str(), [acc, sreg], "nova_rt_str_concat", 0)
                                    acc = cat
                            else
                                let val_reg = ir_lower_expr(b, part)
                                let str_reg = ir_fresh_reg(b)
                                ir_emit_side(b, "call", str_reg, ir_type_str(), [val_reg], "nova_rt_any_to_str", 0)
                                if acc == ""
                                    acc = str_reg
                                else
                                    let cat = ir_fresh_reg(b)
                                    ir_emit_side(b, "call", cat, ir_type_str(), [acc, str_reg], "nova_rt_str_concat", 0)
                                    acc = cat
                    idx = idx + 1
                if acc == ""
                    let dest = ir_fresh_reg(b)
                    if not contains(b.ir_strmap, "")
                        push(b.ir_strlits, "")
                        b.ir_strmap[""] = len(b.ir_strlits) - 1
                    ir_emit_inst(b, "const_str", dest, ir_type_str(), [], "", 0)
                    return dest
                return acc
            else if tag == "ident"
                if not contains(b.ir_locals, value) and list_contains(b.ir_fnames, value)
                    // Function reference: wrap in a closure record (no captures)
                    let arity = 0
                    if contains(b.ir_fn_arity, value)
                        arity = b.ir_fn_arity[value]
                    let tname = "__fnref_" + value
                    if not list_contains(b.ir_fnames, tname)
                        let spec = [tname, value, 0, arity]
                        push(b.ir_tramps, spec)
                        push(b.ir_fnames, tname)
                        b.ir_fn_arity[tname] = 1 + arity
                    let dest = ir_fresh_reg(b)
                    ir_emit_inst(b, "make_closure", dest, ir_type_any(), [], tname, 0)
                    return dest
                let dest = ir_fresh_reg(b)
                ir_emit_inst(b, "slot_load", dest, ir_type_any(), [], value, 0)
                return dest
            else if tag == "bool"
                let dest = ir_fresh_reg(b)
                let bv = if value == "true"
                    1
                else
                    0
                // Carry bool type (still a const_int op, so optimizer passes are unaffected);
                // inference reads the type so bool keeps its identity through Any/JSON.
                ir_emit_inst(b, "const_int", dest, ir_type_bool(), [], str(bv), bv)
                return dest
            else if tag == "binop"
                if value == "and"
                    let left = ir_lower_expr(b, children[0])
                    let sc_slot = "__sc_" + str(b.ir_lc)
                    b.ir_lc = b.ir_lc + 1
                    ir_emit_inst(b, "slot_store", "", ir_type_void(), [left], sc_slot, 0)
                    let rhs_label = ir_fresh_label(b, "and_rhs")
                    let merge_label = ir_fresh_label(b, "and_merge")
                    ir_finish_block(b, IrInst("branch", "", ir_type_void(), [left, merge_label], rhs_label, 0, "pure", b.ir_cur_line))
                    ir_start_block(b, rhs_label)
                    let right = ir_lower_expr(b, children[1])
                    ir_emit_inst(b, "slot_store", "", ir_type_void(), [right], sc_slot, 0)
                    ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], merge_label, 0, "pure", b.ir_cur_line))
                    ir_start_block(b, merge_label)
                    let dest = ir_fresh_reg(b)
                    ir_emit_inst(b, "slot_load", dest, ir_type_any(), [], sc_slot, 0)
                    return dest
                else if value == "or"
                    let left = ir_lower_expr(b, children[0])
                    let sc_slot = "__sc_" + str(b.ir_lc)
                    b.ir_lc = b.ir_lc + 1
                    ir_emit_inst(b, "slot_store", "", ir_type_void(), [left], sc_slot, 0)
                    let rhs_label = ir_fresh_label(b, "or_rhs")
                    let merge_label = ir_fresh_label(b, "or_merge")
                    ir_finish_block(b, IrInst("branch", "", ir_type_void(), [left, rhs_label], merge_label, 0, "pure", b.ir_cur_line))
                    ir_start_block(b, rhs_label)
                    let right = ir_lower_expr(b, children[1])
                    ir_emit_inst(b, "slot_store", "", ir_type_void(), [right], sc_slot, 0)
                    ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], merge_label, 0, "pure", b.ir_cur_line))
                    ir_start_block(b, merge_label)
                    let dest = ir_fresh_reg(b)
                    ir_emit_inst(b, "slot_load", dest, ir_type_any(), [], sc_slot, 0)
                    return dest
                let left = ir_lower_expr(b, children[0])
                let right = ir_lower_expr(b, children[1])
                let dest = ir_fresh_reg(b)
                if value == "+"
                    ir_emit_inst(b, "add", dest, ir_type_any(), [left, right], "+", 0)
                else if value == "-"
                    ir_emit_inst(b, "sub", dest, ir_type_any(), [left, right], "-", 0)
                else if value == "*"
                    ir_emit_inst(b, "mul", dest, ir_type_any(), [left, right], "*", 0)
                else if value == "/"
                    ir_emit_inst(b, "div", dest, ir_type_any(), [left, right], "/", 0)
                else if value == "%"
                    ir_emit_inst(b, "mod", dest, ir_type_any(), [left, right], "%", 0)
                else if value == "=="
                    ir_emit_inst(b, "eq", dest, ir_type_any(), [left, right], "==", 0)
                else if value == "!="
                    ir_emit_inst(b, "neq", dest, ir_type_any(), [left, right], "!=", 0)
                else if value == "<"
                    ir_emit_inst(b, "lt", dest, ir_type_any(), [left, right], "<", 0)
                else if value == "<="
                    ir_emit_inst(b, "le", dest, ir_type_any(), [left, right], "<=", 0)
                else if value == ">"
                    ir_emit_inst(b, "gt", dest, ir_type_any(), [left, right], ">", 0)
                else if value == ">="
                    ir_emit_inst(b, "ge", dest, ir_type_any(), [left, right], ">=", 0)
                else if value == "in"
                    ir_emit_side(b, "call", dest, ir_type_any(), [right, left], "nova_rt_contains", 0)
                else if value == "matches"
                    ir_emit_side(b, "call", dest, ir_type_any(), [left, right], "nova_rt_regex_match", 0)
                else if value == ".."
                    ir_emit_side(b, "call", dest, ir_type_any(), [left, right], "nova_rt_range_from_to", 0)
                else if value == "&"
                    ir_emit_inst(b, "bitand", dest, ir_type_int(), [left, right], "&", 0)
                else if value == "|"
                    ir_emit_inst(b, "bitor", dest, ir_type_int(), [left, right], "|", 0)
                else if value == "^"
                    ir_emit_inst(b, "bitxor", dest, ir_type_int(), [left, right], "^", 0)
                else if value == "<<"
                    ir_emit_inst(b, "shl", dest, ir_type_int(), [left, right], "<<", 0)
                else if value == ">>"
                    ir_emit_inst(b, "shr", dest, ir_type_int(), [left, right], ">>", 0)
                return dest
            else if tag == "unary"
                let operand = ir_lower_expr(b, children[0])
                let dest = ir_fresh_reg(b)
                if value == "-"
                    ir_emit_inst(b, "neg", dest, ir_type_any(), [operand], "-", 0)
                else if value == "not"
                    ir_emit_inst(b, "not", dest, ir_type_any(), [operand], "not", 0)
                else if value == "~"
                    ir_emit_inst(b, "bitnot", dest, ir_type_int(), [operand], "~", 0)
                return dest
            else if tag == "call"
                let fn_name = value
                if fn_name == "main"
                    fn_name = "nova_user_main"
                let arg_regs = []
                for child in children
                    push(arg_regs, ir_lower_expr(b, child))
                if contains(b.ir_fn_defaults, fn_name)
                    let def_params = b.ir_fn_defaults[fn_name]
                    let di = len(arg_regs)
                    while di < len(def_params)
                        let dp = def_params[di]
                        match dp
                            Param(dpn, dpt, dpd) =>
                                match dpd
                                    Expr(dtag, dval, dnum, dch, dfl, dln) =>
                                        if dtag != "null"
                                            push(arg_regs, ir_lower_expr(b, dpd))
                        di = di + 1
                let dest = ir_fresh_reg(b)
                if fn_name == "error"
                    ir_emit_side(b, "set_error", dest, ir_type_any(), arg_regs, "", 0)
                    return dest
                else if fn_name == "select"
                    let sel_list = ir_fresh_reg(b)
                    ir_emit_side(b, "call", sel_list, ir_type_any(), [], "nova_rt_list_create", 0)
                    for sel_ch in arg_regs
                        let sel_tmp = ir_fresh_reg(b)
                        ir_emit_side(b, "call", sel_tmp, ir_type_any(), [sel_list, sel_ch], "nova_rt_list_append", 0)
                    ir_emit_side(b, "call", dest, ir_type_any(), [sel_list], "nova_rt_select", 0)
                    return dest
                else if contains(b.ir_sdefs, fn_name)
                    ir_emit_inst(b, "make_struct", dest, ir_type_any(), arg_regs, fn_name, len(arg_regs))
                else if list_contains(b.ir_fnames, fn_name) or resolve_runtime_fn(fn_name) != fn_name
                    // User-defined functions shadow built-ins of the same name: only
                    // resolve to a runtime built-in when no user fn with that name exists.
                    let rt_name = fn_name
                    if not list_contains(b.ir_fnames, fn_name)
                        rt_name = resolve_runtime_fn(fn_name)
                    if fn_name == "send" and contains(b.ir_locals, "__ms_" + str(eline))
                        rt_name = "nova_rt_channel_send_move"
                    if contains(b.ir_ffi_wrapped, fn_name)
                        rt_name = "nova_ffi_" + fn_name
                    ir_emit_side(b, "call", dest, ir_type_any(), arg_regs, rt_name, 0)
                else
                    // Dynamic call: fn_name is a variable holding a closure
                    let closure_reg = ir_fresh_reg(b)
                    ir_emit_inst(b, "slot_load", closure_reg, ir_type_any(), [], fn_name, 0)
                    let call_args = [closure_reg]
                    for ar in arg_regs
                        push(call_args, ar)
                    ir_emit_side(b, "dyn_call", dest, ir_type_any(), call_args, "", len(arg_regs))
                return dest
            else if tag == "dyn_call"
                // Dynamic call: children[0] is callee expression, rest are args
                let callee_reg = ir_lower_expr(b, children[0])
                let arg_regs = []
                let ci = 1
                while ci < len(children)
                    push(arg_regs, ir_lower_expr(b, children[ci]))
                    ci = ci + 1
                let dest = ir_fresh_reg(b)
                let call_args = [callee_reg]
                for ar in arg_regs
                    push(call_args, ar)
                ir_emit_side(b, "dyn_call", dest, ir_type_any(), call_args, "", len(arg_regs))
                return dest
            else if tag == "lambda"
                let lam_params = fields
                let body_expr = children[0]
                let bound = []
                for p in lam_params
                    match p
                        Expr(pt, pv, pn, pc, pf, pln3) =>
                            push(bound, pv)
                let free = []
                collect_free_vars_inner(body_expr, bound, free)
                let captures = filter_captures(free, b.ir_fnames, b.ir_sdefs)
                let tramp_name = ir_lift_lambda(b, lam_params, body_expr, captures)
                let capture_regs = []
                for cap in captures
                    let cr = ir_fresh_reg(b)
                    ir_emit_inst(b, "slot_load", cr, ir_type_any(), [], cap, 0)
                    push(capture_regs, cr)
                let dest = ir_fresh_reg(b)
                ir_emit_inst(b, "make_closure", dest, ir_type_any(), capture_regs, tramp_name, len(captures))
                return dest
            else if tag == "null"
                let dest = ir_fresh_reg(b)
                ir_emit_inst(b, "const_int", dest, ir_type_any(), [], "0", 0)
                return dest
            else if tag == "float"
                let bits = float_bits(value)
                let dest = ir_fresh_reg(b)
                ir_emit_inst(b, "const_float", dest, ir_type_float(), [], str(bits), bits)
                return dest
            else if tag == "method" or tag == "method_call"
                // Check if this is a module-qualified call: module.func(args)
                // children[0] is the receiver, value is the method name
                if len(children) > 0
                    match children[0]
                        Expr(rtag, rval, rnum, rch, rf, rln) =>
                            if rtag == "ident" and contains(b.ir_modules, rval)
                                let mod_fns = b.ir_modules[rval]
                                if list_contains(mod_fns, value)
                                    let arg_regs = []
                                    let ai = 1
                                    while ai < len(children)
                                        push(arg_regs, ir_lower_expr(b, children[ai]))
                                        ai = ai + 1
                                    let dest = ir_fresh_reg(b)
                                    ir_emit_side(b, "call", dest, ir_type_any(), arg_regs, value, 0)
                                    return dest
                let arg_regs = []
                for child in children
                    push(arg_regs, ir_lower_expr(b, child))
                let dest = ir_fresh_reg(b)
                let resolved_method = ""
                if len(children) > 0
                    let recv_type = ir_expr_struct_type(b, children[0])
                    if recv_type != ""
                        let typed_m = recv_type + "__" + value
                        if list_contains(b.ir_fnames, typed_m)
                            resolved_method = typed_m
                if resolved_method != ""
                    ir_emit_side(b, "call", dest, ir_type_any(), arg_regs, resolved_method, 0)
                else if contains(b.ir_methods, value)
                    let user_method = b.ir_methods[value]
                    ir_emit_side(b, "call", dest, ir_type_any(), arg_regs, user_method, 0)
                else
                    let rt_name = resolve_method_fn(value)
                    ir_emit_side(b, "call", dest, ir_type_any(), arg_regs, rt_name, 0)
                return dest
            else if tag == "list"
                let dest = ir_fresh_reg(b)
                let elem_regs = []
                for child in children
                    push(elem_regs, ir_lower_expr(b, child))
                ir_emit_inst(b, "make_list", dest, ir_type_list(), elem_regs, "", len(children))
                return dest
            else if tag == "dict"
                let dest = ir_fresh_reg(b)
                ir_emit_inst(b, "make_dict", dest, ir_type_dict(), [], "", 0)
                for entry in children
                    match entry
                        Expr(et, ev, en, ec, ef, eln) =>
                            let key_r = ir_lower_expr(b, ec[0])
                            let val_r = ir_lower_expr(b, ec[1])
                            ir_emit_side(b, "call", "", ir_type_void(), [dest, key_r, val_r], "nova_rt_dict_set", 0)
                return dest
            else if tag == "struct_init"
                let sname = value
                if contains(b.ir_sdefs, sname)
                    let field_params = b.ir_sdefs[sname]
                    let nfields = len(field_params)
                    let ordered_regs = []
                    let oi = 0
                    while oi < nfields
                        push(ordered_regs, "0")
                        oi = oi + 1
                    for fi_child in children
                        match fi_child
                            Expr(fi_tag, fi_name, fi_num, fi_children, fi_fields, fi_ln) =>
                                let fi_val = ir_lower_expr(b, fi_children[0])
                                let pi = 0
                                for fp in field_params
                                    match fp
                                        Param(pname, ptype, pdefault) =>
                                            if pname == fi_name
                                                ordered_regs[pi] = fi_val
                                    pi = pi + 1
                    let dest = ir_fresh_reg(b)
                    ir_emit_inst(b, "make_struct", dest, ir_type_any(), ordered_regs, sname, nfields)
                    return dest
                else
                    let dest = ir_fresh_reg(b)
                    ir_emit_inst(b, "const_int", dest, ir_type_int(), [], "0", 0)
                    return dest
            else if tag == "index"
                let obj = ir_lower_expr(b, children[0])
                let idx = ir_lower_expr(b, children[1])
                let dest = ir_fresh_reg(b)
                ir_emit_inst(b, "index_get", dest, ir_type_any(), [obj, idx], "", 0)
                return dest
            else if tag == "slice"
                let sl_obj = ir_lower_expr(b, children[0])
                let sl_start = ir_lower_expr(b, children[1])
                let sl_end = ir_lower_expr(b, children[2])
                let dest = ir_fresh_reg(b)
                ir_emit_side(b, "call", dest, ir_type_any(), [sl_obj, sl_start, sl_end], "nova_rt_slice_any", 0)
                return dest
            else if tag == "field" or tag == "member"
                let fld_type = ir_type_any()
                let recv_stype = ""
                let c0 = children[0]
                match c0
                    Expr(c0t, c0v, c0n, c0c, c0f, c0l) =>
                        if c0t == "ident" and contains(b.ir_locals, c0v)
                            let lt = b.ir_locals[c0v]
                            if lt != 1 and contains(b.ir_sdefs, lt)
                                recv_stype = lt
                        else if c0t == "call" and contains(b.ir_sdefs, c0v)
                            recv_stype = c0v
                if recv_stype != ""
                    let ftkey = recv_stype + "." + value
                    if not contains(b.ir_field_types, ftkey)
                        print("error[E1007]: struct '" + recv_stype + "' has no field '" + value + "'")
                        print("  --> <source>")
                        print("compilation failed: 1 error(s)")
                        exit(1)
                    let ft = b.ir_field_types[ftkey]
                    if ft == "float"
                        fld_type = ir_type_float()
                    else if ft == "int"
                        fld_type = ir_type_int()
                    else if ft == "string"
                        fld_type = ir_type_str()
                let obj = ir_lower_expr(b, children[0])
                let dest = ir_fresh_reg(b)
                let fi = get_ir_field_index_for(b, recv_stype, value)
                ir_emit_inst(b, "field_get", dest, fld_type, [obj], value, fi)
                return dest
            else if tag == "if"
                let cond = ir_lower_expr(b, children[0])
                let if_slot = "__ifexpr_" + str(b.ir_lc)
                b.ir_lc = b.ir_lc + 1
                let then_label = ir_fresh_label(b, "ife_then")
                let else_label = ir_fresh_label(b, "ife_else")
                let merge_label = ir_fresh_label(b, "ife_merge")
                ir_finish_block(b, IrInst("branch", "", ir_type_void(), [cond, else_label], then_label, 0, "pure", b.ir_cur_line))
                ir_start_block(b, then_label)
                let then_val = ir_lower_expr(b, children[1])
                ir_emit_inst(b, "slot_store", "", ir_type_void(), [then_val], if_slot, 0)
                ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], merge_label, 0, "pure", b.ir_cur_line))
                ir_start_block(b, else_label)
                if len(children) > 2
                    let else_val = ir_lower_expr(b, children[2])
                    ir_emit_inst(b, "slot_store", "", ir_type_void(), [else_val], if_slot, 0)
                ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], merge_label, 0, "pure", b.ir_cur_line))
                ir_start_block(b, merge_label)
                let dest = ir_fresh_reg(b)
                ir_emit_inst(b, "slot_load", dest, ir_type_any(), [], if_slot, 0)
                return dest
            else if tag == "try"
                let inner = ir_lower_expr(b, children[0])
                let dest = ir_fresh_reg(b)
                ir_emit_side(b, "is_error", dest, ir_type_int(), [inner], "", 0)
                let err_label = ir_fresh_label(b, "try_err")
                let ok_label = ir_fresh_label(b, "try_ok")
                ir_finish_block(b, IrInst("branch", "", ir_type_void(), [dest, ok_label], err_label, 0, "pure", b.ir_cur_line))
                ir_start_block(b, err_label)
                ir_emit_side(b, "raise_error", "", ir_type_void(), [], "", 0)
                ir_finish_block(b, IrInst("return", "", ir_type_void(), ["0"], "", 0, "pure", b.ir_cur_line))
                ir_start_block(b, ok_label)
                return inner
            else if tag == "try_unwrap"
                ir_emit_side(b, "clear_is_result", "", ir_type_void(), [], "", 0)
                let inner = ir_lower_expr(b, children[0])
                let unwrapped = ir_fresh_reg(b)
                ir_emit_side(b, "try_unwrap_value", unwrapped, ir_type_any(), [inner], "", 0)
                let err_check = ir_fresh_reg(b)
                ir_emit_side(b, "is_error", err_check, ir_type_int(), [unwrapped], "", 0)
                let err_label = ir_fresh_label(b, "try_err")
                let ok_label = ir_fresh_label(b, "try_ok")
                ir_finish_block(b, IrInst("branch", "", ir_type_void(), [err_check, ok_label], err_label, 0, "pure", b.ir_cur_line))
                ir_start_block(b, err_label)
                ir_emit_side(b, "raise_error", "", ir_type_void(), [], "", 0)
                ir_finish_block(b, IrInst("return", "", ir_type_void(), [inner], "", 0, "pure", b.ir_cur_line))
                ir_start_block(b, ok_label)
                return unwrapped
            else if tag == "catch"
                let tried = ir_lower_expr(b, children[0])
                let catch_slot = "__catch_" + str(b.ir_lc)
                b.ir_lc = b.ir_lc + 1
                ir_emit_inst(b, "slot_store", "", ir_type_void(), [tried], catch_slot, 0)
                let err_dest = ir_fresh_reg(b)
                ir_emit_side(b, "is_error", err_dest, ir_type_int(), [tried], "", 0)
                let err_label = ir_fresh_label(b, "catch_err")
                let ok_label = ir_fresh_label(b, "catch_ok")
                let merge_label = ir_fresh_label(b, "catch_merge")
                ir_finish_block(b, IrInst("branch", "", ir_type_void(), [err_dest, ok_label], err_label, 0, "pure", b.ir_cur_line))
                ir_start_block(b, err_label)
                let msg_reg = ir_fresh_reg(b)
                ir_emit_side(b, "load_error_msg", msg_reg, ir_type_str(), [], "", 0)
                ir_emit_inst(b, "slot_store", "", ir_type_void(), [msg_reg], value, 0)
                b.ir_locals[value] = 1
                let handler_val = ""
                if num > 0
                    let ci = 0
                    while ci < len(fields)
                        if ci == len(fields) - 1
                            match fields[ci]
                                Stmt(stag, sname, sexpr, sbody, sparams, selse, sanns, ssln) =>
                                    handler_val = ir_lower_expr(b, sexpr)
                        else
                            ir_lower_stmt(b, fields[ci])
                        ci = ci + 1
                else
                    handler_val = ir_lower_expr(b, children[1])
                ir_emit_inst(b, "slot_store", "", ir_type_void(), [handler_val], catch_slot, 0)
                ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], merge_label, 0, "pure", b.ir_cur_line))
                ir_start_block(b, ok_label)
                ir_emit_inst(b, "slot_store", "", ir_type_void(), [tried], catch_slot, 0)
                ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], merge_label, 0, "pure", b.ir_cur_line))
                ir_start_block(b, merge_label)
                let result = ir_fresh_reg(b)
                ir_emit_inst(b, "slot_load", result, ir_type_any(), [], catch_slot, 0)
                return result
            else if tag == "spawn"
                let sp_child = children[0]
                let sp_is_call = 0
                match sp_child
                    Expr(sp_ct, sp_cv, sp_cn, sp_cc, sp_cf, sp_cln) =>
                        if sp_ct == "call"
                            sp_is_call = 1
                if sp_is_call == 1
                    let sp_call_body = [Stmt("expr", "", sp_child, [], [], [], [], b.ir_cur_line)]
                    let sp_bound = []
                    let sp_free = []
                    for sp_s in sp_call_body
                        collect_free_vars_stmt(sp_s, sp_bound, sp_free)
                    let sp_caps = filter_captures(sp_free, b.ir_fnames, b.ir_sdefs)
                    let sp_tramp = ir_lift_nested_fn(b, "__spawn_call", [], sp_call_body, sp_caps)
                    let sp_cap_regs = []
                    for sp_cap in sp_caps
                        let sp_cr = ir_fresh_reg(b)
                        ir_emit_inst(b, "slot_load", sp_cr, ir_type_any(), [], sp_cap, 0)
                        push(sp_cap_regs, sp_cr)
                    let sp_closure = ir_fresh_reg(b)
                    ir_emit_inst(b, "make_closure", sp_closure, ir_type_any(), sp_cap_regs, sp_tramp, len(sp_caps))
                    let sp_fn_ptr = ir_fresh_reg(b)
                    ir_emit_inst(b, "field_get", sp_fn_ptr, ir_type_any(), [sp_closure], "__fn_ptr", 0)
                    let sp_result = ir_fresh_reg(b)
                    ir_emit_side(b, "call", sp_result, ir_type_any(), [sp_fn_ptr, sp_closure], "nova_rt_spawn", 0)
                    return sp_result
                let sp_lambda = ir_lower_expr(b, children[0])
                let sp_fn = ir_fresh_reg(b)
                ir_emit_inst(b, "field_get", sp_fn, ir_type_any(), [sp_lambda], "__fn_ptr", 0)
                let sp_dest = ir_fresh_reg(b)
                ir_emit_side(b, "call", sp_dest, ir_type_any(), [sp_fn, sp_lambda], "nova_rt_spawn", 0)
                return sp_dest
            else if tag == "match"
                let m_subject = ir_lower_expr(b, children[0])
                let m_arm_count = len(children) - 1
                let m_exit = ir_fresh_label(b, "mexpr_exit")
                let m_slot = "__mexpr_" + str(b.ir_lc)
                b.ir_lc = b.ir_lc + 1
                let m_is_value = 0
                let m_si = 1
                while m_si < len(children)
                    match children[m_si]
                        Expr(m_at, m_av, m_an, m_ac, m_af, m_aln) =>
                            if len(m_ac) >= 1
                                match m_ac[0]
                                    Expr(m_spt, m_spv, m_spn, m_spc, m_spf, m_spln) =>
                                        if m_spt == "pat_lit" or m_spt == "pat_str" or m_spt == "pat_var"
                                            m_is_value = 1
                    m_si = m_si + 1
                let m_hash = ""
                if m_is_value == 0
                    m_hash = ir_fresh_reg(b)
                    ir_emit_inst(b, "field_get", m_hash, ir_type_int(), [m_subject], "__type_hash", 0)
                let m_arm_labels = []
                let m_aidx = 0
                while m_aidx < m_arm_count
                    push(m_arm_labels, ir_fresh_label(b, "mearm_" + str(m_aidx)))
                    m_aidx = m_aidx + 1
                let m_check_labels = []
                let m_cidx = 1
                while m_cidx < m_arm_count
                    push(m_check_labels, ir_fresh_label(b, "mechk_" + str(m_cidx)))
                    m_cidx = m_cidx + 1
                let m_fall = ir_fresh_label(b, "mexpr_fall")
                let m_arm_idx = 0
                let m_ai = 1
                while m_ai < len(children)
                    match children[m_ai]
                        Expr(m_at2, m_av2, m_an2, m_ac2, m_af2, m_aln2) =>
                            let m_pattern = m_ac2[0]
                            let m_body_expr = m_ac2[1]
                            match m_pattern
                                Expr(m_pt, m_pv, m_pn, m_pchildren, m_pf, m_pln2) =>
                                    if m_pt == "pat_ctor"
                                        if m_arm_idx > 0
                                            ir_start_block(b, m_check_labels[m_arm_idx - 1])
                                        let m_expected = type_name_hash(m_pv)
                                        let m_exp_reg = ir_fresh_reg(b)
                                        ir_emit_inst(b, "const_int", m_exp_reg, ir_type_int(), [], str(m_expected), m_expected)
                                        let m_cmp = ir_fresh_reg(b)
                                        ir_emit_inst(b, "eq", m_cmp, ir_type_int(), [m_hash, m_exp_reg], "==", 0)
                                        let m_next = m_fall
                                        if m_arm_idx + 1 < m_arm_count
                                            m_next = m_check_labels[m_arm_idx]
                                        ir_finish_block(b, IrInst("branch", "", ir_type_void(), [m_cmp, m_next], m_arm_labels[m_arm_idx], 0, "pure", b.ir_cur_line))
                                        ir_start_block(b, m_arm_labels[m_arm_idx])
                                        let m_fi = 1
                                        for m_fp in m_pchildren
                                            match m_fp
                                                Expr(m_fpt, m_fpv, m_fpn, m_fpc, m_fpf, m_fpln) =>
                                                    if m_fpv != "_"
                                                        let m_fd = ir_fresh_reg(b)
                                                        ir_emit_inst(b, "field_get", m_fd, ir_type_any(), [m_subject], m_fpv, m_fi)
                                                        ir_emit_inst(b, "slot_store", "", ir_type_void(), [m_fd], m_fpv, 0)
                                                        b.ir_locals[m_fpv] = 1
                                            m_fi = m_fi + 1
                                    else if m_pt == "pat_lit"
                                        if m_arm_idx > 0
                                            ir_start_block(b, m_check_labels[m_arm_idx - 1])
                                        let m_exp_reg = ir_fresh_reg(b)
                                        ir_emit_inst(b, "const_int", m_exp_reg, ir_type_int(), [], m_pv, m_pn)
                                        let m_cmp = ir_fresh_reg(b)
                                        ir_emit_inst(b, "eq", m_cmp, ir_type_int(), [m_subject, m_exp_reg], "==", 0)
                                        let m_next = m_fall
                                        if m_arm_idx + 1 < m_arm_count
                                            m_next = m_check_labels[m_arm_idx]
                                        ir_finish_block(b, IrInst("branch", "", ir_type_void(), [m_cmp, m_next], m_arm_labels[m_arm_idx], 0, "pure", b.ir_cur_line))
                                        ir_start_block(b, m_arm_labels[m_arm_idx])
                                    else if m_pt == "pat_str"
                                        if m_arm_idx > 0
                                            ir_start_block(b, m_check_labels[m_arm_idx - 1])
                                        let m_exp_reg = ir_fresh_reg(b)
                                        ir_emit_inst(b, "const_str", m_exp_reg, ir_type_str(), [], m_pv, 0)
                                        let m_cmp = ir_fresh_reg(b)
                                        ir_emit_inst(b, "eq", m_cmp, ir_type_str(), [m_subject, m_exp_reg], "==", 0)
                                        let m_next = m_fall
                                        if m_arm_idx + 1 < m_arm_count
                                            m_next = m_check_labels[m_arm_idx]
                                        ir_finish_block(b, IrInst("branch", "", ir_type_void(), [m_cmp, m_next], m_arm_labels[m_arm_idx], 0, "pure", b.ir_cur_line))
                                        ir_start_block(b, m_arm_labels[m_arm_idx])
                                    else
                                        if m_arm_idx > 0
                                            ir_start_block(b, m_check_labels[m_arm_idx - 1])
                                        if m_pt == "pat_var" and m_pv != "_"
                                            ir_emit_inst(b, "slot_store", "", ir_type_void(), [m_subject], m_pv, 0)
                                            b.ir_locals[m_pv] = 1
                            if len(m_ac2) > 2
                                match m_ac2[2]
                                    Expr(mg_tag, mg_v, mg_n, mg_ch, mg_f, mg_ln) =>
                                        if mg_tag != "null"
                                            let mg_val = ir_lower_expr(b, m_ac2[2])
                                            let mg_ok = ir_fresh_label(b, "mguard_ok_" + str(m_arm_idx))
                                            let mg_next = m_fall
                                            if m_arm_idx + 1 < m_arm_count
                                                mg_next = m_check_labels[m_arm_idx]
                                            ir_finish_block(b, IrInst("branch", "", ir_type_void(), [mg_val, mg_next], mg_ok, 0, "pure", b.ir_cur_line))
                                            ir_start_block(b, mg_ok)
                            let m_val = ir_lower_expr(b, m_body_expr)
                            ir_emit_inst(b, "slot_store", "", ir_type_void(), [m_val], m_slot, 0)
                            if b.ir_clabel != ""
                                ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], m_exit, 0, "pure", b.ir_cur_line))
                    m_arm_idx = m_arm_idx + 1
                    m_ai = m_ai + 1
                ir_start_block(b, m_fall)
                let m_zero = ir_fresh_reg(b)
                ir_emit_inst(b, "const_int", m_zero, ir_type_int(), [], "0", 0)
                ir_emit_inst(b, "slot_store", "", ir_type_void(), [m_zero], m_slot, 0)
                ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], m_exit, 0, "pure", b.ir_cur_line))
                ir_start_block(b, m_exit)
                let m_result = ir_fresh_reg(b)
                ir_emit_inst(b, "slot_load", m_result, ir_type_any(), [], m_slot, 0)
                return m_result
            // Fallback
            let dest = ir_fresh_reg(b)
            ir_emit_inst(b, "const_int", dest, ir_type_any(), [], "0", 0)
            return dest

fn get_ir_field_index(b: IrBuilder, field_name: string) -> int
    if contains(b.ir_fmap, field_name)
        return b.ir_fmap[field_name]
    0

fn get_ir_field_index_for(b: IrBuilder, stype: string, field_name: string) -> int
    if stype != "" and contains(b.ir_sdefs, stype)
        let sparams = b.ir_sdefs[stype]
        let sfi = 1
        for sp in sparams
            match sp
                Param(spn, spt, spd) =>
                    if spn == field_name
                        return sfi
            sfi = sfi + 1
    get_ir_field_index(b, field_name)

fn ir_expr_struct_type(b: IrBuilder, expr: Expr) -> string
    match expr
        Expr(et, ev, en, ec, ef, eln) =>
            if et == "struct_init" and contains(b.ir_sdefs, ev)
                return ev
            if et == "call" and contains(b.ir_sdefs, ev)
                return ev
            if et == "call" and contains(b.ir_fn_returns, ev)
                let rt = b.ir_fn_returns[ev]
                if contains(b.ir_sdefs, rt)
                    return rt
            if et == "ident" and contains(b.ir_locals, ev)
                let lt = b.ir_locals[ev]
                if lt != 1 and contains(b.ir_sdefs, lt)
                    return lt
    ""

fn ir_lower_stmt(b: IrBuilder, stmt: Stmt)
    match stmt
        Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
            if sline > 0
                b.ir_cur_line = sline
            if tag == "expr"
                ir_lower_expr(b, expr)
            else if tag == "let"
                let val = ir_lower_expr(b, expr)
                ir_emit_inst(b, "slot_store", "", ir_type_void(), [val], name, 0)
                let let_stype = ir_expr_struct_type(b, expr)
                if let_stype != ""
                    b.ir_locals[name] = let_stype
                else
                    b.ir_locals[name] = 1
            else if tag == "assign"
                let val = ir_lower_expr(b, expr)
                if name != ""
                    ir_emit_inst(b, "slot_store", "", ir_type_void(), [val], name, 0)
                    let asg_stype = ir_expr_struct_type(b, expr)
                    if asg_stype != ""
                        b.ir_locals[name] = asg_stype
                    else
                        b.ir_locals[name] = 1
                else if len(annotations) > 0
                    let a0 = annotations[0]
                    let a0_is_ident = false
                    let a0_ident_name = ""
                    match a0
                        Expr(et, ev, en, ec, ef, eln) =>
                            if et == "ident"
                                a0_is_ident = true
                                a0_ident_name = ev
                    if a0_is_ident
                        ir_emit_inst(b, "slot_store", "", ir_type_void(), [val], a0_ident_name, 0)
                        let ann_stype = ir_expr_struct_type(b, expr)
                        if ann_stype != ""
                            b.ir_locals[a0_ident_name] = ann_stype
                        else
                            b.ir_locals[a0_ident_name] = 1
                    else
                        ir_lower_assign_target(b, a0, val)
            else if tag == "compound_assign"
                let rhs_val = ir_lower_expr(b, expr)
                if len(annotations) > 0
                    let lhs_expr = annotations[0]
                    let lhs_is_ident = false
                    let lhs_name = ""
                    match lhs_expr
                        Expr(et, ev, en, ec, ef, eln) =>
                            if et == "ident"
                                lhs_is_ident = true
                                lhs_name = ev
                    if lhs_is_ident
                        let lhs_val = ir_fresh_reg(b)
                        ir_emit_inst(b, "slot_load", lhs_val, ir_type_any(), [], lhs_name, 0)
                        let result = ir_fresh_reg(b)
                        if name == "+="
                            ir_emit_inst(b, "add", result, ir_type_any(), [lhs_val, rhs_val], "+", 0)
                        else if name == "-="
                            ir_emit_inst(b, "sub", result, ir_type_int(), [lhs_val, rhs_val], "-", 0)
                        else if name == "*="
                            ir_emit_inst(b, "mul", result, ir_type_int(), [lhs_val, rhs_val], "*", 0)
                        else
                            ir_emit_inst(b, "div", result, ir_type_int(), [lhs_val, rhs_val], "/", 0)
                        ir_emit_inst(b, "slot_store", "", ir_type_void(), [result], lhs_name, 0)
                    else
                        let lhs_val = ir_lower_expr(b, lhs_expr)
                        let result = ir_fresh_reg(b)
                        if name == "+="
                            ir_emit_inst(b, "add", result, ir_type_any(), [lhs_val, rhs_val], "+", 0)
                        else if name == "-="
                            ir_emit_inst(b, "sub", result, ir_type_int(), [lhs_val, rhs_val], "-", 0)
                        else if name == "*="
                            ir_emit_inst(b, "mul", result, ir_type_int(), [lhs_val, rhs_val], "*", 0)
                        else
                            ir_emit_inst(b, "div", result, ir_type_int(), [lhs_val, rhs_val], "/", 0)
                        ir_lower_assign_target(b, lhs_expr, result)
            else if tag == "return"
                let val = ir_lower_expr(b, expr)
                ir_finish_block(b, IrInst("return", "", ir_type_void(), [val], "", 0, "pure", b.ir_cur_line))
            else if tag == "yield"
                let yval = ir_lower_expr(b, expr)
                let yacc = ir_fresh_reg(b)
                ir_emit_inst(b, "slot_load", yacc, ir_type_any(), [], "__yield_acc", 0)
                let ydiscard = ir_fresh_reg(b)
                ir_emit_side(b, "call", ydiscard, ir_type_any(), [yacc, yval], "nova_rt_list_append", 0)
            else if tag == "if"
                let cond = ir_lower_expr(b, expr)
                let then_label = ir_fresh_label(b, "then")
                let else_label = ir_fresh_label(b, "else")
                let end_label = ir_fresh_label(b, "endif")
                ir_finish_block(b, IrInst("branch", "", ir_type_void(), [cond, else_label], then_label, 0, "pure", b.ir_cur_line))
                ir_start_block(b, then_label)
                for s in body
                    ir_lower_stmt(b, s)
                if b.ir_clabel != ""
                    ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], end_label, 0, "pure", b.ir_cur_line))
                ir_start_block(b, else_label)
                for s in else_body
                    ir_lower_stmt(b, s)
                if b.ir_clabel != ""
                    ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], end_label, 0, "pure", b.ir_cur_line))
                ir_start_block(b, end_label)
            else if tag == "while"
                let hdr_label = ir_fresh_label(b, "while_hdr")
                let body_label = ir_fresh_label(b, "while_body")
                let exit_label = ir_fresh_label(b, "while_exit")
                let save_hdr = b.ir_loop_hdr
                let save_exit = b.ir_loop_exit
                b.ir_loop_hdr = hdr_label
                b.ir_loop_exit = exit_label
                ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], hdr_label, 0, "pure", b.ir_cur_line))
                ir_start_block(b, hdr_label)
                let cond = ir_lower_expr(b, expr)
                ir_finish_block(b, IrInst("branch", "", ir_type_void(), [cond, exit_label], body_label, 0, "pure", b.ir_cur_line))
                ir_start_block(b, body_label)
                for s in body
                    ir_lower_stmt(b, s)
                if b.ir_clabel != ""
                    ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], hdr_label, 0, "pure", b.ir_cur_line))
                ir_start_block(b, exit_label)
                b.ir_loop_hdr = save_hdr
                b.ir_loop_exit = save_exit
            else if tag == "for"
                b.ir_locals[name] = 1
                let raw_iter = ir_lower_expr(b, expr)
                let iter_reg = ir_fresh_reg(b)
                ir_emit_side(b, "call", iter_reg, ir_type_any(), [raw_iter], "nova_rt_for_iter_init", 0)
                let len_reg = ir_fresh_reg(b)
                ir_emit_side(b, "call", len_reg, ir_type_int(), [iter_reg], "nova_rt_len_any", 0)
                let idx_slot = "__for_idx_" + str(b.ir_lc)
                let zero_r = ir_fresh_reg(b)
                ir_emit_inst(b, "const_int", zero_r, ir_type_int(), [], "0", 0)
                ir_emit_inst(b, "slot_store", "", ir_type_void(), [zero_r], idx_slot, 0)
                let hdr_label = ir_fresh_label(b, "for_hdr")
                let body_label = ir_fresh_label(b, "for_body")
                let exit_label = ir_fresh_label(b, "for_exit")
                let save_hdr = b.ir_loop_hdr
                let save_exit = b.ir_loop_exit
                b.ir_loop_hdr = hdr_label
                b.ir_loop_exit = exit_label
                ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], hdr_label, 0, "pure", b.ir_cur_line))
                ir_start_block(b, hdr_label)
                let idx_r = ir_fresh_reg(b)
                ir_emit_inst(b, "slot_load", idx_r, ir_type_int(), [], idx_slot, 0)
                let cmp_r = ir_fresh_reg(b)
                ir_emit_inst(b, "lt", cmp_r, ir_type_int(), [idx_r, len_reg], "<", 0)
                ir_finish_block(b, IrInst("branch", "", ir_type_void(), [cmp_r, exit_label], body_label, 0, "pure", b.ir_cur_line))
                ir_start_block(b, body_label)
                let elem_r = ir_fresh_reg(b)
                ir_emit_inst(b, "index_get", elem_r, ir_type_any(), [iter_reg, idx_r], "", 0)
                ir_emit_inst(b, "slot_store", "", ir_type_void(), [elem_r], name, 0)
                for s in body
                    ir_lower_stmt(b, s)
                if b.ir_clabel != ""
                    let next_idx = ir_fresh_reg(b)
                    ir_emit_inst(b, "slot_load", next_idx, ir_type_int(), [], idx_slot, 0)
                    let inc_r = ir_fresh_reg(b)
                    ir_emit_inst(b, "const_int", inc_r, ir_type_int(), [], "1", 1)
                    let new_idx = ir_fresh_reg(b)
                    ir_emit_inst(b, "add", new_idx, ir_type_int(), [next_idx, inc_r], "+", 0)
                    ir_emit_inst(b, "slot_store", "", ir_type_void(), [new_idx], idx_slot, 0)
                    ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], hdr_label, 0, "pure", b.ir_cur_line))
                ir_start_block(b, exit_label)
                b.ir_loop_hdr = save_hdr
                b.ir_loop_exit = save_exit
            else if tag == "match"
                let subject = ir_lower_expr(b, expr)
                let exit_label = ir_fresh_label(b, "match_exit")
                let sm_is_value = 0
                for sm_scan in body
                    match sm_scan
                        Stmt(sm_at, sm_an, sm_pat, sm_ab, sm_ap, sm_ae, sm_aa, sm_sl) =>
                            match sm_pat
                                Expr(sm_pt, sm_pv, sm_pn, sm_pc, sm_pf, sm_pln) =>
                                    if sm_pt == "pat_lit" or sm_pt == "pat_str" or sm_pt == "pat_var"
                                        sm_is_value = 1
                let hash_reg = ""
                if sm_is_value == 0
                    hash_reg = ir_fresh_reg(b)
                    ir_emit_inst(b, "field_get", hash_reg, ir_type_int(), [subject], "__type_hash", 0)
                let arm_count = len(body)
                let arm_idx = 0
                let arm_labels = []
                let aidx = 0
                while aidx < arm_count
                    push(arm_labels, ir_fresh_label(b, "marm_" + str(aidx)))
                    aidx = aidx + 1
                let check_labels = []
                let cidx = 1
                while cidx < arm_count
                    push(check_labels, ir_fresh_label(b, "mchk_" + str(cidx)))
                    cidx = cidx + 1
                let fall_label = ir_fresh_label(b, "match_fall")
                for arm in body
                    match arm
                        Stmt(at, an, pattern, arm_body, ap, ae, aa, _aln) =>
                            match pattern
                                Expr(pt, pv, pn, pchildren, pf, pln2) =>
                                    if pt == "pat_ctor"
                                        if arm_idx > 0
                                            ir_start_block(b, check_labels[arm_idx - 1])
                                        let expected = type_name_hash(pv)
                                        let exp_reg = ir_fresh_reg(b)
                                        ir_emit_inst(b, "const_int", exp_reg, ir_type_int(), [], str(expected), expected)
                                        let cmp_reg = ir_fresh_reg(b)
                                        ir_emit_inst(b, "eq", cmp_reg, ir_type_int(), [hash_reg, exp_reg], "==", 0)
                                        let next_label = fall_label
                                        if arm_idx + 1 < arm_count
                                            next_label = check_labels[arm_idx]
                                        ir_finish_block(b, IrInst("branch", "", ir_type_void(), [cmp_reg, next_label], arm_labels[arm_idx], 0, "pure", b.ir_cur_line))
                                        ir_start_block(b, arm_labels[arm_idx])
                                        let fi = 1
                                        for field_pat in pchildren
                                            match field_pat
                                                Expr(fpt, fpv, fpn, fpc, fpf, fpln) =>
                                                    if fpv != "_"
                                                        let fd = ir_fresh_reg(b)
                                                        ir_emit_inst(b, "field_get", fd, ir_type_any(), [subject], fpv, fi)
                                                        ir_emit_inst(b, "slot_store", "", ir_type_void(), [fd], fpv, 0)
                                                        b.ir_locals[fpv] = 1
                                            fi = fi + 1
                                    else if pt == "pat_lit"
                                        if arm_idx > 0
                                            ir_start_block(b, check_labels[arm_idx - 1])
                                        let exp_reg = ir_fresh_reg(b)
                                        ir_emit_inst(b, "const_int", exp_reg, ir_type_int(), [], pv, pn)
                                        let cmp_reg = ir_fresh_reg(b)
                                        ir_emit_inst(b, "eq", cmp_reg, ir_type_int(), [subject, exp_reg], "==", 0)
                                        let next_label = fall_label
                                        if arm_idx + 1 < arm_count
                                            next_label = check_labels[arm_idx]
                                        ir_finish_block(b, IrInst("branch", "", ir_type_void(), [cmp_reg, next_label], arm_labels[arm_idx], 0, "pure", b.ir_cur_line))
                                        ir_start_block(b, arm_labels[arm_idx])
                                    else if pt == "pat_str"
                                        if arm_idx > 0
                                            ir_start_block(b, check_labels[arm_idx - 1])
                                        let exp_reg = ir_fresh_reg(b)
                                        ir_emit_inst(b, "const_str", exp_reg, ir_type_str(), [], pv, 0)
                                        let cmp_reg = ir_fresh_reg(b)
                                        ir_emit_inst(b, "eq", cmp_reg, ir_type_str(), [subject, exp_reg], "==", 0)
                                        let next_label = fall_label
                                        if arm_idx + 1 < arm_count
                                            next_label = check_labels[arm_idx]
                                        ir_finish_block(b, IrInst("branch", "", ir_type_void(), [cmp_reg, next_label], arm_labels[arm_idx], 0, "pure", b.ir_cur_line))
                                        ir_start_block(b, arm_labels[arm_idx])
                                    else
                                        if arm_idx > 0
                                            ir_start_block(b, check_labels[arm_idx - 1])
                                        if pt == "pat_var" and pv != "_"
                                            ir_emit_inst(b, "slot_store", "", ir_type_void(), [subject], pv, 0)
                                            b.ir_locals[pv] = 1
                            if len(aa) > 0
                                match aa[0]
                                    Expr(gtag, gv, gn, gch, gf, gln) =>
                                        if gtag != "null"
                                            let guard_val = ir_lower_expr(b, aa[0])
                                            let guard_ok = ir_fresh_label(b, "guard_ok_" + str(arm_idx))
                                            let guard_next = fall_label
                                            if arm_idx + 1 < arm_count
                                                guard_next = check_labels[arm_idx]
                                            ir_finish_block(b, IrInst("branch", "", ir_type_void(), [guard_val, guard_next], guard_ok, 0, "pure", b.ir_cur_line))
                                            ir_start_block(b, guard_ok)
                            for s in arm_body
                                ir_lower_stmt(b, s)
                            if b.ir_clabel != ""
                                ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], exit_label, 0, "pure", b.ir_cur_line))
                    arm_idx = arm_idx + 1
                ir_start_block(b, fall_label)
                if b.ir_clabel != ""
                    ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], exit_label, 0, "pure", b.ir_cur_line))
                ir_start_block(b, exit_label)
            else if tag == "spawn"
                let sp_bound = []
                for sp_p in params
                    match sp_p
                        Param(sp_pn, sp_pt, sp_pd) =>
                            push(sp_bound, sp_pn)
                let sp_free = []
                for sp_s in body
                    collect_free_vars_stmt(sp_s, sp_bound, sp_free)
                let sp_caps = filter_captures(sp_free, b.ir_fnames, b.ir_sdefs)
                let sp_tramp = ir_lift_nested_fn(b, "__spawn", params, body, sp_caps)
                let sp_cap_regs = []
                for sp_cap in sp_caps
                    let sp_cr = ir_fresh_reg(b)
                    ir_emit_inst(b, "slot_load", sp_cr, ir_type_any(), [], sp_cap, 0)
                    push(sp_cap_regs, sp_cr)
                let sp_closure = ir_fresh_reg(b)
                ir_emit_inst(b, "make_closure", sp_closure, ir_type_any(), sp_cap_regs, sp_tramp, len(sp_caps))
                let sp_fn_ptr = ir_fresh_reg(b)
                ir_emit_inst(b, "field_get", sp_fn_ptr, ir_type_any(), [sp_closure], "__fn_ptr", 0)
                let sp_result = ir_fresh_reg(b)
                ir_emit_side(b, "call", sp_result, ir_type_any(), [sp_fn_ptr, sp_closure], "nova_rt_spawn", 0)
                if name != ""
                    b.ir_locals[name] = 1
                    ir_emit_inst(b, "slot_store", "", ir_type_void(), [sp_result], name, 0)
            else if tag == "break"
                if b.ir_loop_exit != ""
                    ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], b.ir_loop_exit, 0, "pure", b.ir_cur_line))
            else if tag == "continue"
                if b.ir_loop_hdr != ""
                    ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], b.ir_loop_hdr, 0, "pure", b.ir_cur_line))
            else if tag == "fn"
                let fn_bound = []
                push(fn_bound, name)
                for p in params
                    match p
                        Param(pname, ptype, pdefault) =>
                            push(fn_bound, pname)
                let free = []
                for s in body
                    collect_free_vars_stmt(s, fn_bound, free)
                let captures = filter_captures(free, b.ir_fnames, b.ir_sdefs)
                let tramp_name = ir_lift_nested_fn(b, name, params, body, captures)
                let capture_regs = []
                for cap in captures
                    let cr = ir_fresh_reg(b)
                    ir_emit_inst(b, "slot_load", cr, ir_type_any(), [], cap, 0)
                    push(capture_regs, cr)
                let dest = ir_fresh_reg(b)
                ir_emit_inst(b, "make_closure", dest, ir_type_any(), capture_regs, tramp_name, len(captures))
                ir_emit_inst(b, "slot_store", "", ir_type_void(), [dest], name, 0)
                b.ir_locals[name] = 1

fn ir_lower_last_stmt(b: IrBuilder, stmt: Stmt)
    match stmt
        Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
            if tag == "expr" and b.ir_clabel != ""
                let val = ir_lower_expr(b, expr)
                ir_finish_block(b, IrInst("return", "", ir_type_void(), [val], "", 0, "pure", b.ir_cur_line))
            else if tag == "return"
                ir_lower_stmt(b, stmt)
            else if tag == "match"
                let subject = ir_lower_expr(b, expr)
                let arm_count = len(body)
                let rm_is_value = 0
                for rm_scan in body
                    match rm_scan
                        Stmt(rm_at, rm_an, rm_pat, rm_ab, rm_ap, rm_ae, rm_aa, rm_sl) =>
                            match rm_pat
                                Expr(rm_pt, rm_pv, rm_pn, rm_pc, rm_pf, rm_pln) =>
                                    if rm_pt == "pat_lit" or rm_pt == "pat_str" or rm_pt == "pat_var"
                                        rm_is_value = 1
                let arm_labels = []
                let aidx = 0
                while aidx < arm_count
                    push(arm_labels, ir_fresh_label(b, "rmarm_" + str(aidx)))
                    aidx = aidx + 1
                let rcheck_labels = []
                let rcidx = 1
                while rcidx < arm_count
                    push(rcheck_labels, ir_fresh_label(b, "rchk_" + str(rcidx)))
                    rcidx = rcidx + 1
                let fall_label = ir_fresh_label(b, "rmatch_fall")
                let hash_reg = ""
                if rm_is_value == 0
                    hash_reg = ir_fresh_reg(b)
                    ir_emit_inst(b, "field_get", hash_reg, ir_type_int(), [subject], "__type_hash", 0)
                let arm_idx = 0
                for arm in body
                    match arm
                        Stmt(at, an, pattern, arm_body, ap, ae, aa, _aln) =>
                            match pattern
                                Expr(pt, pv, pn, pchildren, pf, pln2) =>
                                    if pt == "pat_ctor"
                                        if arm_idx > 0
                                            ir_start_block(b, rcheck_labels[arm_idx - 1])
                                        let expected = type_name_hash(pv)
                                        let exp_reg = ir_fresh_reg(b)
                                        ir_emit_inst(b, "const_int", exp_reg, ir_type_int(), [], str(expected), expected)
                                        let cmp_reg = ir_fresh_reg(b)
                                        ir_emit_inst(b, "eq", cmp_reg, ir_type_int(), [hash_reg, exp_reg], "==", 0)
                                        let next_label = fall_label
                                        if arm_idx + 1 < arm_count
                                            next_label = rcheck_labels[arm_idx]
                                        ir_finish_block(b, IrInst("branch", "", ir_type_void(), [cmp_reg, next_label], arm_labels[arm_idx], 0, "pure", b.ir_cur_line))
                                        ir_start_block(b, arm_labels[arm_idx])
                                        let fi = 1
                                        for field_pat in pchildren
                                            match field_pat
                                                Expr(fpt, fpv, fpn, fpc, fpf, fpln) =>
                                                    if fpv != "_"
                                                        let fd = ir_fresh_reg(b)
                                                        ir_emit_inst(b, "field_get", fd, ir_type_any(), [subject], fpv, fi)
                                                        ir_emit_inst(b, "slot_store", "", ir_type_void(), [fd], fpv, 0)
                                                        b.ir_locals[fpv] = 1
                                            fi = fi + 1
                                    else if pt == "pat_lit"
                                        if arm_idx > 0
                                            ir_start_block(b, rcheck_labels[arm_idx - 1])
                                        let exp_reg = ir_fresh_reg(b)
                                        ir_emit_inst(b, "const_int", exp_reg, ir_type_int(), [], pv, pn)
                                        let cmp_reg = ir_fresh_reg(b)
                                        ir_emit_inst(b, "eq", cmp_reg, ir_type_int(), [subject, exp_reg], "==", 0)
                                        let next_label = fall_label
                                        if arm_idx + 1 < arm_count
                                            next_label = rcheck_labels[arm_idx]
                                        ir_finish_block(b, IrInst("branch", "", ir_type_void(), [cmp_reg, next_label], arm_labels[arm_idx], 0, "pure", b.ir_cur_line))
                                        ir_start_block(b, arm_labels[arm_idx])
                                    else if pt == "pat_str"
                                        if arm_idx > 0
                                            ir_start_block(b, rcheck_labels[arm_idx - 1])
                                        let exp_reg = ir_fresh_reg(b)
                                        ir_emit_inst(b, "const_str", exp_reg, ir_type_str(), [], pv, 0)
                                        let cmp_reg = ir_fresh_reg(b)
                                        ir_emit_inst(b, "eq", cmp_reg, ir_type_str(), [subject, exp_reg], "==", 0)
                                        let next_label = fall_label
                                        if arm_idx + 1 < arm_count
                                            next_label = rcheck_labels[arm_idx]
                                        ir_finish_block(b, IrInst("branch", "", ir_type_void(), [cmp_reg, next_label], arm_labels[arm_idx], 0, "pure", b.ir_cur_line))
                                        ir_start_block(b, arm_labels[arm_idx])
                                    else
                                        if arm_idx > 0
                                            ir_start_block(b, rcheck_labels[arm_idx - 1])
                                        if pt == "pat_var" and pv != "_"
                                            ir_emit_inst(b, "slot_store", "", ir_type_void(), [subject], pv, 0)
                                            b.ir_locals[pv] = 1
                            if len(aa) > 0
                                match aa[0]
                                    Expr(rg_tag, rg_v, rg_n, rg_ch, rg_f, rg_ln) =>
                                        if rg_tag != "null"
                                            let rg_val = ir_lower_expr(b, aa[0])
                                            let rg_ok = ir_fresh_label(b, "rguard_ok_" + str(arm_idx))
                                            let rg_next = fall_label
                                            if arm_idx + 1 < arm_count
                                                rg_next = rcheck_labels[arm_idx]
                                            ir_finish_block(b, IrInst("branch", "", ir_type_void(), [rg_val, rg_next], rg_ok, 0, "pure", b.ir_cur_line))
                                            ir_start_block(b, rg_ok)
                            let arm_len = len(arm_body)
                            if arm_len > 0
                                let ai = 0
                                while ai < arm_len - 1
                                    ir_lower_stmt(b, arm_body[ai])
                                    ai = ai + 1
                                ir_lower_last_stmt(b, arm_body[arm_len - 1])
                            else
                                if b.ir_clabel != ""
                                    ir_finish_block(b, IrInst("return", "", ir_type_void(), ["0"], "", 0, "pure", b.ir_cur_line))
                    arm_idx = arm_idx + 1
                ir_start_block(b, fall_label)
                if b.ir_clabel != ""
                    ir_finish_block(b, IrInst("return", "", ir_type_void(), ["0"], "", 0, "pure", b.ir_cur_line))
            else if tag == "if"
                let cond = ir_lower_expr(b, expr)
                let then_label = ir_fresh_label(b, "retthen")
                let else_label = ir_fresh_label(b, "retelse")
                ir_finish_block(b, IrInst("branch", "", ir_type_void(), [cond, else_label], then_label, 0, "pure", b.ir_cur_line))
                ir_start_block(b, then_label)
                let then_len = len(body)
                if then_len > 0
                    let ti = 0
                    while ti < then_len - 1
                        ir_lower_stmt(b, body[ti])
                        ti = ti + 1
                    ir_lower_last_stmt(b, body[then_len - 1])
                else
                    if b.ir_clabel != ""
                        ir_finish_block(b, IrInst("return", "", ir_type_void(), ["0"], "", 0, "pure", b.ir_cur_line))
                ir_start_block(b, else_label)
                let else_len = len(else_body)
                if else_len > 0
                    let ei = 0
                    while ei < else_len - 1
                        ir_lower_stmt(b, else_body[ei])
                        ei = ei + 1
                    ir_lower_last_stmt(b, else_body[else_len - 1])
                else
                    if b.ir_clabel != ""
                        ir_finish_block(b, IrInst("return", "", ir_type_void(), ["0"], "", 0, "pure", b.ir_cur_line))
            else
                ir_lower_stmt(b, stmt)
                if b.ir_clabel != ""
                    ir_finish_block(b, IrInst("return", "", ir_type_void(), ["0"], "", 0, "pure", b.ir_cur_line))

fn ir_lower_assign_target(b: IrBuilder, target: Expr, val_reg: string)
    match target
        Expr(tag, value, num, children, fields, eline) =>
            if tag == "ident"
                ir_emit_inst(b, "slot_store", "", ir_type_void(), [val_reg], value, 0)
                b.ir_locals[value] = 1
            else if tag == "index"
                let target_r = ir_lower_expr(b, children[0])
                let idx_r = ir_lower_expr(b, children[1])
                ir_emit_side(b, "index_set", "", ir_type_void(), [target_r, idx_r, val_reg], "", 0)
            else if tag == "member"
                let target_r = ir_lower_expr(b, children[0])
                let mstype = ""
                match children[0]
                    Expr(mc0t, mc0v, mc0n, mc0c, mc0f, mc0l) =>
                        if mc0t == "ident" and contains(b.ir_locals, mc0v)
                            let mlt = b.ir_locals[mc0v]
                            if mlt != 1 and contains(b.ir_sdefs, mlt)
                                mstype = mlt
                        else if mc0t == "call" and contains(b.ir_sdefs, mc0v)
                            mstype = mc0v
                let fi = get_ir_field_index_for(b, mstype, value)
                let ptr_reg = ir_fresh_reg(b)
                ir_emit_inst(b, "field_set", ptr_reg, ir_type_void(), [target_r, val_reg], value, fi)
            else if tag == "tuple"
                let ti = 0
                for tc in children
                    let idx_reg = ir_fresh_reg(b)
                    ir_emit_inst(b, "const_int", idx_reg, ir_type_int(), [], str(ti), ti)
                    let elem_reg = ir_fresh_reg(b)
                    ir_emit_side(b, "call", elem_reg, ir_type_any(), [val_reg, idx_reg], "nova_rt_index_get", 0)
                    ir_lower_assign_target(b, tc, elem_reg)
                    ti = ti + 1

fn ir_flush_pending_block(b: IrBuilder)
    if b.ir_clabel != ""
        ir_finish_block(b, IrInst("return", "", ir_type_void(), ["0"], "", 0, "pure", b.ir_cur_line))

fn source_type_to_ir(t: string) -> IrType
    if t == "int"
        ir_type_int()
    else if t == "string" or t == "str"
        ir_type_str()
    else if t == "list"
        IrType("list", "", [], 0)
    else if t == "dict"
        IrType("dict", "", [], 0)
    else if t == "bool"
        ir_type_int()
    else
        ir_type_any()

// Returns the target variable of an assignment/let statement. Handles both
// parser forms: name-based (Stmt.name set) and the IDENT-led form where name
// is "" and the LHS identifier is annotations[0]. "" if not a simple
// single-identifier assignment.
fn fl_assign_var(stmt: Stmt) -> string
    let result = ""
    match stmt
        Stmt(t, n, e, sb, sp, seb, sa, sl) =>
            if t == "let" or t == "assign"
                if n != ""
                    result = n
                else if len(sa) == 1
                    match sa[0]
                        Expr(at, av, an, ac, af, al) =>
                            if at == "ident"
                                result = av
    result

// List-fill loop optimization. Recognizes the exact pattern
//   L = []
//   CV = 0
//   while CV <= LIMIT   (or <)
//       L.push(Vconst)
//       CV = CV + 1
// at body[i..i+2] and replaces it with a single bulk allocation:
//   L  = nova_rt_list_create_filled(LIMIT+1, Vconst)
//   CV = max(0, LIMIT+1)
// LIMIT must be a plain identifier (loop-invariant, side-effect-free) distinct
// from L and CV. The transformation is semantically exact for any LIMIT value
// (create_filled clamps count<0 to 0; max gives CV its true final value).
// Returns 3 if matched and emitted, 0 otherwise. Conservative by design:
// any deviation from the exact pattern yields 0 (no change).
fn ir_try_fill_loop(b: IrBuilder, body: list, i: int) -> int
    if b.ir_clabel == ""
        return 0
    if i + 3 >= len(body)
        return 0
    let s0 = body[i]
    let s1 = body[i + 1]
    let s2 = body[i + 2]
    // stmt 0:  L = []
    let lname = fl_assign_var(s0)
    if lname == ""
        return 0
    let s0_ok = 0
    match s0
        Stmt(t0, n0, e0, sb0, sp0, seb0, sa0, sl0) =>
            match e0
                Expr(et0, ev0, en0, ec0, ef0, eel0) =>
                    if et0 == "list" and len(ec0) == 0
                        s0_ok = 1
    if s0_ok == 0
        return 0
    // stmt 1:  CV = 0
    let cvname = fl_assign_var(s1)
    if cvname == ""
        return 0
    let s1_ok = 0
    match s1
        Stmt(t1, n1, e1, sb1, sp1, seb1, sa1, sl1) =>
            match e1
                Expr(et1, ev1, en1, ec1, ef1, eel1) =>
                    if et1 == "int" and en1 == 0
                        s1_ok = 1
    if s1_ok == 0
        return 0
    if cvname == lname
        return 0
    // stmt 2:  while CV <op> LIMIT { L.push(Vint); CV = CV + 1 }
    let fl_matched = 0
    let limitname = ""
    let fl_op = ""
    let fl_vnum = 0
    match s2
        Stmt(t2, n2, e2, sb2, sp2, seb2, sa2, sl2) =>
            if t2 == "while" and len(sb2) == 2
                match e2
                    Expr(et2, ev2, en2, ec2, ef2, eel2) =>
                        if et2 == "binop" and (ev2 == "<=" or ev2 == "<") and len(ec2) == 2
                            let lhs_is_cv = 0
                            match ec2[0]
                                Expr(clt, clv, cln, clc, clf, cll) =>
                                    if clt == "ident" and clv == cvname
                                        lhs_is_cv = 1
                            let rhs_name = ""
                            match ec2[1]
                                Expr(crt, crv, crn, crc, crf, crl) =>
                                    if crt == "ident"
                                        rhs_name = crv
                            if lhs_is_cv == 1 and rhs_name != "" and rhs_name != cvname and rhs_name != lname
                                let push_ok = 0
                                let inc_ok = 0
                                match sb2[0]
                                    Stmt(pt, pn, pe, pb, pp, peb, pa, pl) =>
                                        if pt == "expr"
                                            match pe
                                                Expr(met, mev, men, mec, mef, mel) =>
                                                    if (met == "method" or met == "method_call") and mev == "push" and len(mec) == 2
                                                        let recv_is_l = 0
                                                        match mec[0]
                                                            Expr(rct, rcv, rcn, rcc, rcf, rcl) =>
                                                                if rct == "ident" and rcv == lname
                                                                    recv_is_l = 1
                                                        let arg_is_int = 0
                                                        let arg_num = 0
                                                        match mec[1]
                                                            Expr(aat, aav, aan, aac, aaf, aal) =>
                                                                if aat == "int"
                                                                    arg_is_int = 1
                                                                    arg_num = aan
                                                        if recv_is_l == 1 and arg_is_int == 1
                                                            push_ok = 1
                                                            fl_vnum = arg_num
                                match sb2[1]
                                    Stmt(gstag, gsname, gsexpr, gsbody, gsparams, gselse, gsann, gsline) =>
                                        if fl_assign_var(sb2[1]) == cvname
                                            match gsexpr
                                                Expr(iet, iev, ien, iec, ief, iel) =>
                                                    if iet == "binop" and iev == "+" and len(iec) == 2
                                                        let inc_l = 0
                                                        match iec[0]
                                                            Expr(ilt, ilv, iln, ilc, ilf, ill) =>
                                                                if ilt == "ident" and ilv == cvname
                                                                    inc_l = 1
                                                        let inc_r = 0
                                                        match iec[1]
                                                            Expr(irt, irv, irn, irc, irf, irl) =>
                                                                if irt == "int" and irn == 1
                                                                    inc_r = 1
                                                        if inc_l == 1 and inc_r == 1
                                                            inc_ok = 1
                                if push_ok == 1 and inc_ok == 1
                                    fl_matched = 1
                                    limitname = rhs_name
                                    fl_op = ev2
    if fl_matched == 0
        return 0
    // emit: count = LIMIT (+1 for <=)
    let limit_reg = ir_fresh_reg(b)
    ir_emit_inst(b, "slot_load", limit_reg, ir_type_int(), [], limitname, 0)
    let count_reg = limit_reg
    if fl_op == "<="
        let one_reg = ir_fresh_reg(b)
        ir_emit_inst(b, "const_int", one_reg, ir_type_int(), [], "1", 1)
        let cnt_reg = ir_fresh_reg(b)
        ir_emit_inst(b, "add", cnt_reg, ir_type_int(), [limit_reg, one_reg], "+", 0)
        count_reg = cnt_reg
    // emit: V (fill value)
    let v_reg = ir_fresh_reg(b)
    ir_emit_inst(b, "const_int", v_reg, ir_type_int(), [], str(fl_vnum), fl_vnum)
    // emit: L = nova_rt_list_create_filled(count, V)
    let l_reg = ir_fresh_reg(b)
    ir_emit_side(b, "call", l_reg, ir_type_list(), [count_reg, v_reg], "nova_rt_list_create_filled", 0)
    ir_emit_inst(b, "slot_store", "", ir_type_void(), [l_reg], lname, 0)
    b.ir_locals[lname] = 1
    // emit: CV = max(0, count)  -- exact final counter value
    let zero_reg = ir_fresh_reg(b)
    ir_emit_inst(b, "const_int", zero_reg, ir_type_int(), [], "0", 0)
    let cv_reg = ir_fresh_reg(b)
    ir_emit_side(b, "call", cv_reg, ir_type_int(), [zero_reg, count_reg], "nova_rt_max", 0)
    ir_emit_inst(b, "slot_store", "", ir_type_void(), [cv_reg], cvname, 0)
    b.ir_locals[cvname] = 1
    return 3

fn ir_lower_function(b: IrBuilder, stmt: Stmt) -> IrFunction
    match stmt
        Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
            let ir_params = []
            b.ir_locals = {}
            for p in params
                match p
                    Param(pname, ptype, pdefault) =>
                        push(ir_params, IrParam(pname, source_type_to_ir(ptype)))
                        if ptype != "" and contains(b.ir_sdefs, ptype)
                            b.ir_locals[pname] = ptype
                        else
                            b.ir_locals[pname] = 1
            let dunder = find(name, "__")
            if dunder > 0
                let self_type = slice(name, 0, dunder)
                if contains(b.ir_sdefs, self_type)
                    b.ir_locals["self"] = self_type
            b.ir_insts = []
            b.ir_blocks = []
            b.ir_clabel = "entry"
            b.ir_rc = 0
            ir_mark_move_sends(b, body)
            let is_gen = stmts_has_yield(body)
            if is_gen
                let acc_r = ir_fresh_reg(b)
                ir_emit_side(b, "call", acc_r, ir_type_any(), [], "nova_rt_list_create", 0)
                ir_emit_inst(b, "slot_store", "", ir_type_void(), [acc_r], "__yield_acc", 0)
                b.ir_locals["__yield_acc"] = 1
                for s in body
                    ir_lower_stmt(b, s)
                if b.ir_clabel != ""
                    let ret_acc = ir_fresh_reg(b)
                    ir_emit_inst(b, "slot_load", ret_acc, ir_type_any(), [], "__yield_acc", 0)
                    ir_finish_block(b, IrInst("return", "", ir_type_void(), [ret_acc], "", 0, "pure", b.ir_cur_line))
            else
                let n_body = len(body)
                if n_body > 0
                    let i = 0
                    while i < n_body - 1
                        let consumed = ir_try_fill_loop(b, body, i)
                        if consumed > 0
                            i = i + consumed
                        else
                            ir_lower_stmt(b, body[i])
                            i = i + 1
                    ir_lower_last_stmt(b, body[n_body - 1])
            ir_flush_pending_block(b)
            if len(b.ir_blocks) == 0
                ir_finish_block(b, IrInst("return", "", ir_type_void(), ["0"], "", 0, "pure", b.ir_cur_line))
            let emit_name = name
            if emit_name == "main"
                emit_name = "nova_user_main"
            IrFunction(emit_name, ir_params, ir_type_any(), b.ir_blocks, [], 0)

// ══════════════════════════════════════════════════════════════════════════════
// AST-Level Type Inferrer (Hindley-Milner with constraint solving)
// Runs between parsing and IR lowering. Produces function return types
// and type errors. Feeds into the IR pipeline for better codegen.
// ══════════════════════════════════════════════════════════════════════════════

// ── NType: Structural type representation ────────────────────────────────────
// kind: "int","float","string","bool","unit","any","nothing","range",
//       "list","dict","tuple","channel","fn","struct","sum","process","var"
// params: child NTypes (semantics depend on kind)
//   list → [elem], dict → [key, val], fn → [p1..pN, ret], channel → [payload]
//   sum → [ok, err], process → [yield], tuple → elements
// id: TypeVar id (kind=="var" only)
// name: struct name (kind=="struct" only)

type NType
    kind: string
    name: string
    params: list
    id: int

type NTypeScheme
    quantified: list
    body: NType

type NConstraint
    a: NType
    b: NType
    line: int

type TiState
    ti_next_id: int
    ti_bindings: dict
    ti_constraints: list
    ti_errors: list
    ti_scope: list
    ti_structs: dict
    ti_fn_types: dict
    ti_ret_var: NType
    ti_in_fn: string
    ti_stdlib: dict
    ti_unify_count: int
    ti_source_lines: list
    ti_min_arity: dict
    ti_enum_variants: dict
    ti_variant_enum: dict
    ti_filename: string
    ti_modules: dict
    ti_traits: dict
    ti_type_traits: dict
    ti_type_methods: dict
    ti_fn_defer: dict
    ti_fn_bounds: dict
    ti_bound_checks: list

// ── NType constructors ───────────────────────────────────────────────────────

fn nt_int() -> NType
    NType("int", "", [], 0)

fn nt_float() -> NType
    NType("float", "", [], 0)

fn nt_string() -> NType
    NType("string", "", [], 0)

fn nt_bool() -> NType
    NType("bool", "", [], 0)

fn nt_unit() -> NType
    NType("unit", "", [], 0)

fn nt_any() -> NType
    NType("any", "", [], 0)

fn nt_nothing() -> NType
    NType("nothing", "", [], 0)

fn nt_range() -> NType
    NType("range", "", [], 0)

fn nt_list(elem: NType) -> NType
    NType("list", "", [elem], 0)

fn nt_dict(k: NType, v: NType) -> NType
    NType("dict", "", [k, v], 0)

fn nt_tuple(elems: list) -> NType
    NType("tuple", "", elems, 0)

fn nt_channel(payload: NType) -> NType
    NType("channel", "", [payload], 0)

fn nt_fn(ps: list, ret: NType) -> NType
    NType("fn", "", ps + [ret], 0)

fn nt_struct(sname: string) -> NType
    NType("struct", sname, [], 0)

fn nt_var(vid: int) -> NType
    NType("var", "", [], vid)

fn nt_process(yt: NType) -> NType
    NType("process", "", [yt], 0)

fn nt_sum(ok: NType, err: NType) -> NType
    NType("sum", "", [ok, err], 0)

// ── TiState: inference state ─────────────────────────────────────────────────

fn ti_new(source_lines: list) -> TiState
    ti_new_named(source_lines, "")

fn ti_new_named(source_lines: list, filename: string) -> TiState
    let stdlib = ti_build_stdlib()
    TiState(1, {}, [], [], [{}], {}, {}, nt_unit(), "", stdlib, 0, source_lines, {}, {}, {}, filename, {}, {}, {}, {}, {}, {}, [])

fn ti_fresh(st: TiState) -> NType
    let vid = st.ti_next_id
    st.ti_next_id = vid + 1
    nt_var(vid)

fn ti_push_scope(st: TiState)
    push(st.ti_scope, {})

fn ti_pop_scope(st: TiState)
    if len(st.ti_scope) > 1
        let ns = []
        let i = 0
        while i < len(st.ti_scope) - 1
            push(ns, st.ti_scope[i])
            i = i + 1
        st.ti_scope = ns

fn ti_define(st: TiState, vname: string, scheme: NTypeScheme)
    let top = st.ti_scope[len(st.ti_scope) - 1]
    top[vname] = scheme

fn ti_mono(t: NType) -> NTypeScheme
    NTypeScheme([], t)

// ── Union-Find ───────────────────────────────────────────────────────────────

fn ti_walk_depth(st: TiState, t: NType, depth: int) -> NType
    if depth > 500
        return nt_any()
    match t
        NType(kind, name, params, id) =>
            if kind != "var"
                return t
            let key = str(id)
            if contains(st.ti_bindings, key)
                return ti_walk_depth(st, st.ti_bindings[key], depth + 1)
            return t
    t

fn ti_walk(st: TiState, t: NType) -> NType
    ti_walk_depth(st, t, 0)

fn ti_bind(st: TiState, vid: int, t: NType)
    st.ti_bindings[str(vid)] = t

fn ti_occurs(st: TiState, vid: int, t: NType) -> bool
    let w = ti_walk(st, t)
    match w
        NType(wk, wn, wp, wi) =>
            if wk == "var"
                return wi == vid
            for p in wp
                if ti_occurs(st, vid, p)
                    return true
    false

// ── Constraint & error management ────────────────────────────────────────────

fn ti_constrain(st: TiState, a: NType, b: NType, line: int)
    push(st.ti_constraints, NConstraint(a, b, line))

fn ti_error_full(st: TiState, code: string, msg: string, line: int, help: string)
    let out = ""
    let in_fn = ""
    if st.ti_in_fn != ""
        in_fn = " (in function '" + st.ti_in_fn + "')"
    let header_code = code
    if header_code == ""
        header_code = "E1000"
    out = out + "error[" + header_code + "]: " + msg + in_fn + "\n"
    let file_loc = st.ti_filename
    if file_loc == ""
        file_loc = "<source>"
    out = out + "  --> " + file_loc + ":" + str(line) + "\n"
    if line > 0 and len(st.ti_source_lines) >= line
        let src = st.ti_source_lines[line - 1]
        let lnum = str(line)
        let pad = ""
        let pi = 0
        while pi < len(lnum)
            pad = pad + " "
            pi = pi + 1
        out = out + " " + pad + " |\n"
        out = out + " " + lnum + " | " + src + "\n"
        out = out + " " + pad + " |\n"
    if help != ""
        out = out + "  = help: " + help + "\n"
    push(st.ti_errors, out)

fn ti_error(st: TiState, msg: string, line: int)
    let code = "E1000"
    let help = ""
    if starts_with(msg, "unknown identifier")
        code = "E1002"
        if contains(msg, "did you mean")
            help = "check the spelling, or import a module that defines this name"
        else
            help = "this name is not defined; declare it with `let`, `fn`, or import it"
    else if starts_with(msg, "function expects")
        code = "E1003"
        help = "check the function signature and supply the correct number of arguments"
    else if starts_with(msg, "type mismatch")
        code = "E1001"
        if contains(msg, "found string") or contains(msg, "expected string")
            help = "use str() to convert to string, or int()/float() to convert from string"
        else if contains(msg, "found int") and contains(msg, "expected float")
            help = "int and float are auto-coerced in NOVA; this may be a container type mismatch"
        else if contains(msg, "List<") or contains(msg, "Dict<")
            help = "container element types must match; check that both sides use the same element type"
        else
            help = "these types are incompatible; check that both sides of the expression have the same type"
    else if contains(msg, "does not fully implement trait")
        code = "E1006"
        help = "add the missing method(s) as TypeName__method_name functions"
    else if contains(msg, "unknown trait")
        code = "E1007"
        help = "declare the trait with `trait Name` before implementing it"
    else if starts_with(msg, "cannot iterate")
        code = "E1008"
        help = "for-loops work with list, dict, string, and range values"
    else if starts_with(msg, "non-exhaustive match")
        code = "E1009"
        help = "add the missing variant(s) to your match expression, or add a wildcard `_ =>` arm"
    else if contains(msg, "has no field")
        code = "E1010"
        help = "check the struct definition for available fields"
    else if contains(msg, "is not indexable")
        code = "E1011"
        help = "only list, dict, and string support [] indexing"
    else if contains(msg, "duplicate function")
        code = "E1012"
        help = "rename one of the functions, or remove the duplicate"
    ti_error_full(st, code, msg, line, help)

// ── Type display ─────────────────────────────────────────────────────────────

fn ti_type_str(t: NType) -> string
    match t
        NType(kind, name, params, id) =>
            if kind == "var"
                return "?T" + str(id)
            if kind == "list" and len(params) > 0
                return "List<" + ti_type_str(params[0]) + ">"
            if kind == "dict" and len(params) >= 2
                return "Dict<" + ti_type_str(params[0]) + ", " + ti_type_str(params[1]) + ">"
            if kind == "fn" and len(params) > 0
                let ret = params[len(params) - 1]
                let ps = []
                let i = 0
                while i < len(params) - 1
                    push(ps, ti_type_str(params[i]))
                    i = i + 1
                return "(" + join(ps, ", ") + ") -> " + ti_type_str(ret)
            if kind == "channel" and len(params) > 0
                return "Channel<" + ti_type_str(params[0]) + ">"
            if kind == "struct"
                return name
            if kind == "sum" and len(params) >= 2
                return ti_type_str(params[0]) + " | " + ti_type_str(params[1])
            if kind == "tuple"
                let ps = []
                for p in params
                    push(ps, ti_type_str(p))
                return "(" + join(ps, ", ") + ")"
            if kind == "process" and len(params) > 0
                return "Process<" + ti_type_str(params[0]) + ">"
            return kind
    "any"

// ── Instantiation ────────────────────────────────────────────────────────────

fn ti_instantiate(st: TiState, scheme: NTypeScheme) -> NType
    match scheme
        NTypeScheme(q, b) =>
            let b2 = ti_zonk(st, b)
            if len(q) == 0
                return b2
            let subst = {}
            let qi = 0
            while qi < len(q)
                let qw = ti_walk(st, nt_var(q[qi]))
                match qw
                    NType(qwk, qwn, qwp, qwi) =>
                        if qwk == "var"
                            subst[str(qwi)] = ti_fresh(st)
                qi = qi + 1
            return ti_subst(b2, subst)
    nt_any()

fn ti_subst(t: NType, subst: dict) -> NType
    match t
        NType(kind, name, params, id) =>
            if kind == "var"
                let key = str(id)
                if contains(subst, key)
                    return subst[key]
                return t
            if len(params) == 0
                return t
            let np = []
            for p in params
                push(np, ti_subst(p, subst))
            return NType(kind, name, np, id)
    t

// ── Generalization ───────────────────────────────────────────────────────────

fn ti_collect_fv(st: TiState, t: NType, out: list, seen: dict)
    let w = ti_walk(st, t)
    match w
        NType(wk, wn, wp, wi) =>
            if wk == "var"
                let key = str(wi)
                if not contains(seen, key)
                    seen[key] = 1
                    push(out, wi)
                return
            for p in wp
                ti_collect_fv(st, p, out, seen)

fn ti_scope_fv(st: TiState) -> dict
    let ids = {}
    for frame in st.ti_scope
        for k in keys(frame)
            let scheme = frame[k]
            match scheme
                NTypeScheme(sq, sb) =>
                    let fv = []
                    ti_collect_fv(st, sb, fv, {})
                    for vid in fv
                        ids[str(vid)] = 1
    ids

fn ti_generalize(st: TiState, t: NType) -> NTypeScheme
    let sfv = ti_scope_fv(st)
    let tfv = []
    ti_collect_fv(st, t, tfv, {})
    let quantified = []
    for vid in tfv
        if not contains(sfv, str(vid))
            push(quantified, vid)
    NTypeScheme(quantified, t)

// ── Apply (resolve all type vars to concrete types) ──────────────────────────

fn ti_apply(st: TiState, t: NType) -> NType
    let w = ti_walk(st, t)
    match w
        NType(wk, wn, wp, wi) =>
            if wk == "var"
                return nt_any()
            if len(wp) == 0
                return w
            let np = []
            for p in wp
                push(np, ti_apply(st, p))
            return NType(wk, wn, np, wi)
    nt_any()

// ── Zonk (resolve bindings, keep unbound vars as vars) ───────────────────────

fn ti_zonk(st: TiState, t: NType) -> NType
    let w = ti_walk(st, t)
    match w
        NType(wk, wn, wp, wi) =>
            if wk == "var"
                return w
            if len(wp) == 0
                return w
            let np = []
            for p in wp
                push(np, ti_zonk(st, p))
            return NType(wk, wn, np, wi)
    nt_any()

// ── Unification ──────────────────────────────────────────────────────────────

fn ti_unify_d(st: TiState, a: NType, b: NType, line: int, depth: int)
    st.ti_unify_count = st.ti_unify_count + 1
    if depth > 50 or st.ti_unify_count > 5000
        return
    let wa = ti_walk(st, a)
    let wb = ti_walk(st, b)
    match wa
        NType(wak, wan, wap, wai) =>
            match wb
                NType(wbk, wbn, wbp, wbi) =>
                    if wak == wbk
                        if wak == "int" or wak == "float" or wak == "string" or wak == "bool" or wak == "unit" or wak == "nothing" or wak == "any" or wak == "range"
                            return
                        if wak == "var"
                            if wai == wbi
                                return
                            ti_bind(st, wai, wb)
                            return
                        if wak == "struct"
                            if wan == wbn
                                return
                            ti_error(st, "type mismatch: expected " + ti_type_str(wa) + ", found " + ti_type_str(wb), line)
                            return
                        if wak == "list" or wak == "dict" or wak == "tuple" or wak == "channel" or wak == "fn" or wak == "sum" or wak == "process"
                            if len(wap) == len(wbp)
                                let i = 0
                                while i < len(wap)
                                    ti_unify_d(st, wap[i], wbp[i], line, depth + 1)
                                    i = i + 1
                                return
                            if wak == "fn"
                                ti_error(st, "function expects " + str(len(wap) - 1) + " arguments, but got " + str(len(wbp) - 1) + ": expected " + ti_type_str(wa) + ", found " + ti_type_str(wb), line)
                            else
                                ti_error(st, "type mismatch: expected " + ti_type_str(wa) + ", found " + ti_type_str(wb), line)
                            return
                    if wak == "var"
                        if ti_occurs(st, wai, wb)
                            return
                        ti_bind(st, wai, wb)
                        return
                    if wbk == "var"
                        if ti_occurs(st, wbi, wa)
                            return
                        ti_bind(st, wbi, wa)
                        return
                    if wak == "nothing" or wbk == "nothing"
                        return
                    if wak == "any" or wbk == "any"
                        return
                    // int / float / bool are all mutually compatible in NOVA
                    // (numeric coercion + C-style truthiness).
                    let a_num = wak == "int" or wak == "float" or wak == "bool"
                    let b_num = wbk == "int" or wbk == "float" or wbk == "bool"
                    if a_num and b_num
                        return
                    // Catch-all: any remaining kind disagreement is a genuine
                    // type error. Without this, incompatible types unified
                    // silently and the type checker caught nothing.
                    ti_error(st, "type mismatch: expected " + ti_type_str(wa) + ", found " + ti_type_str(wb), line)

fn ti_unify(st: TiState, a: NType, b: NType, line: int)
    ti_unify_d(st, a, b, line, 0)

// Tolerant arm-vs-arm unification for match expressions / branches.
// Only enforces equality when BOTH sides are concrete, non-any, non-unit,
// non-nothing. This catches arms that disagree on a real type (e.g. one arm
// returns string, another returns int) while letting control-flow arms
// (one prints, one returns a value — different "value-ness") pass through.
fn ti_unify_arms(st: TiState, a: NType, b: NType, line: int)
    let wa = ti_walk(st, a)
    let wb = ti_walk(st, b)
    let a_ok = false
    let b_ok = false
    match wa
        NType(wak, wan, wap, wai) =>
            if wak != "any" and wak != "var" and wak != "unit" and wak != "nothing"
                a_ok = true
    match wb
        NType(wbk, wbn, wbp, wbi) =>
            if wbk != "any" and wbk != "var" and wbk != "unit" and wbk != "nothing"
                b_ok = true
    if a_ok and b_ok
        ti_constrain(st, a, b, line)

fn ti_solve(st: TiState)
    let total = len(st.ti_constraints)
    let i = 0
    while i < total
        let c = st.ti_constraints[i]
        match c
            NConstraint(ca, cb, cline) =>
                ti_unify(st, ca, cb, cline)
        i = i + 1
    st.ti_constraints = []

// ── Stdlib type registry ─────────────────────────────────────────────────────

fn ti_build_stdlib() -> dict
    let reg = {}
    let T = nt_var(-1)
    let U = nt_var(-2)
    reg["print"] = NTypeScheme([-1], nt_fn([T], nt_unit()))
    reg["copy"] = NTypeScheme([-1], nt_fn([T], T))
