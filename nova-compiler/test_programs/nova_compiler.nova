// ── Edit distance for 'did you mean?' ────────────────────────────────────────

fn edit_distance(a: string, b: string) -> int
    let la = len(a)
    let lb = len(b)
    if la == 0
        return lb
    if lb == 0
        return la
    let prev = []
    let j = 0
    while j <= lb
        push(prev, j)
        j = j + 1
    let i = 1
    while i <= la
        let curr = [i]
        let j2 = 1
        while j2 <= lb
            let cost = 1
            if a[i - 1] == b[j2 - 1]
                cost = 0
            let del_cost = prev[j2] + 1
            let ins_cost = curr[j2 - 1] + 1
            let sub_cost = prev[j2 - 1] + cost
            let best = del_cost
            if ins_cost < best
                best = ins_cost
            if sub_cost < best
                best = sub_cost
            push(curr, best)
            j2 = j2 + 1
        prev = curr
        i = i + 1
    prev[lb]

fn ti_suggest_name(st: TiState, vname: string) -> string
    let best = ""
    let best_dist = 999
    let max_dist = 3
    if len(vname) <= 3
        max_dist = 1
    else if len(vname) <= 6
        max_dist = 2
    let scope = st.ti_scope
    let si = len(scope) - 1
    while si >= 0
        let frame = scope[si]
        for k in keys(frame)
            let d = edit_distance(vname, k)
            if d < best_dist and d <= max_dist and d > 0
                best_dist = d
                best = k
        si = si - 1
    for k in keys(st.ti_stdlib)
        let d = edit_distance(vname, k)
        if d < best_dist and d <= max_dist and d > 0
            best_dist = d
            best = k
    best

// ── Scope lookup ─────────────────────────────────────────────────────────────

fn ti_lookup(st: TiState, vname: string, line: int) -> NType
    let scope = st.ti_scope
    let i = len(scope) - 1
    while i >= 0
        let frame = scope[i]
        if contains(frame, vname)
            return ti_instantiate(st, frame[vname])
        i = i - 1
    let stdlib = st.ti_stdlib
    if contains(stdlib, vname)
        let scheme = stdlib[vname]
        return ti_instantiate(st, scheme)
    let suggestion = ti_suggest_name(st, vname)
    let msg = "unknown identifier '" + vname + "'"
    if suggestion != ""
        msg = msg + "; did you mean '" + suggestion + "'?"
    ti_error(st, msg, line)
    nt_any()

// ── Source type annotation to NType ──────────────────────────────────────────

fn ti_ann_to_type(ann: string) -> NType
    if ann == "int" or ann == "Int"
        return nt_int()
    if ann == "string" or ann == "str" or ann == "String" or ann == "Str"
        return nt_string()
    if ann == "float" or ann == "Float"
        return nt_float()
    if ann == "bool" or ann == "Bool"
        return nt_bool()
    if ann == "list" or ann == "List"
        return nt_list(nt_any())
    if ann == "dict" or ann == "Dict" or ann == "Map"
        return nt_dict(nt_string(), nt_any())
    if ann == "" or ann == "any" or ann == "Any"
        return nt_any()
    nt_struct(ann)

// Split a parametric annotation like "Map<string,int>" or "List<List<int>>"
// at the comma separators of the OUTER pair of angle brackets.
fn ti_split_type_args(args: string) -> list
    let parts = []
    let depth = 0
    let start = 0
    let i = 0
    while i < len(args)
        let c = args[i]
        if c == "<"
            depth = depth + 1
        else if c == ">"
            depth = depth - 1
        else if c == "," and depth == 0
            push(parts, trim(slice(args, start, i)))
            start = i + 1
        i = i + 1
    if start < len(args)
        push(parts, trim(slice(args, start, len(args))))
    parts

fn ti_ann_to_type_g(ann: string, gmap: dict) -> NType
    if contains(gmap, ann)
        return gmap[ann]
    let lt = find(ann, "<")
    if lt < 0
        return ti_ann_to_type(ann)
    if not ends_with(ann, ">")
        return ti_ann_to_type(ann)
    let base = slice(ann, 0, lt)
    let args_str = slice(ann, lt + 1, len(ann) - 1)
    let args = ti_split_type_args(args_str)
    if base == "List" or base == "list"
        if len(args) >= 1
            return nt_list(ti_ann_to_type_g(args[0], gmap))
        return nt_list(nt_any())
    if base == "Map" or base == "dict" or base == "Dict"
        if len(args) >= 2
            return nt_dict(ti_ann_to_type_g(args[0], gmap), ti_ann_to_type_g(args[1], gmap))
        return nt_dict(nt_string(), nt_any())
    if base == "Option"
        if len(args) >= 1
            return ti_ann_to_type_g(args[0], gmap)
        return nt_any()
    if base == "Result"
        if len(args) >= 1
            return ti_ann_to_type_g(args[0], gmap)
        return nt_any()
    if base == "Channel" or base == "channel"
        if len(args) >= 1
            return nt_channel(ti_ann_to_type_g(args[0], gmap))
        return nt_channel(nt_any())
    ti_ann_to_type(base)

fn ti_extract_generics(annotations: list) -> list
    for a in annotations
        match a
            Expr(at, av, an, ac, af, al) =>
                if at == "generics"
                    let names = []
                    for c in ac
                        match c
                            Expr(ct, cv, cn, cc, cf, cl) =>
                                push(names, cv)
                    return names
    []

fn ti_extract_bounds(annotations: list) -> dict
    for a in annotations
        match a
            Expr(at, av, an, ac, af, al) =>
                if at == "generic_bounds"
                    let bounds = {}
                    for c in ac
                        match c
                            Expr(ct, cv, cn, cc, cf, cl) =>
                                if ct == "bound" and len(cc) > 0
                                    match cc[0]
                                        Expr(bt, bv, bn, bc, bf, bl) =>
                                            bounds[cv] = bv
                    return bounds
    {}

// ── Expression inference ─────────────────────────────────────────────────────

fn ti_infer_expr(st: TiState, expr: Expr) -> NType
    ti_infer_expr_inner(st, expr)

fn ti_infer_expr_inner(st: TiState, expr: Expr) -> NType
    match expr
        Expr(tag, value, num, children, fields, eline) =>
            if tag == "int"
                return nt_int()
            if tag == "float"
                return nt_float()
            if tag == "str" or tag == "str_interp"
                return nt_string()
            if tag == "bool"
                return nt_bool()
            if tag == "null"
                return nt_any()
            if tag == "ident"
                return ti_lookup(st, value, eline)
            if tag == "call"
                let fn_t = ti_lookup(st, value, eline)
                let arg_types = []
                let ai = 0
                while ai < len(children)
                    push(arg_types, ti_infer_expr(st, children[ai]))
                    ai = ai + 1
                if contains(st.ti_min_arity, value)
                    let full_ar = 0
                    match fn_t
                        NType(ftk, ftn, ftp, fti) =>
                            if ftk == "fn"
                                full_ar = len(ftp) - 1
                            else if ftk == "scheme"
                                match ftp[0]
                                    NType(sk, sn, sp, si) =>
                                        if sk == "fn"
                                            full_ar = len(sp) - 1
                    let min_ar = st.ti_min_arity[value]
                    if len(arg_types) < min_ar
                        ti_error(st, "function expects " + str(min_ar) + " arguments, but got " + str(len(arg_types)), eline)
                    while len(arg_types) < full_ar
                        push(arg_types, ti_fresh(st))
                let ret_var = ti_fresh(st)
                if value == "select"
                    return ret_var
                let expected_fn = nt_fn(arg_types, ret_var)
                ti_constrain(st, fn_t, expected_fn, eline)
                if contains(st.ti_fn_bounds, value)
                    let fn_bounds = st.ti_fn_bounds[value]
                    let bci = 0
                    while bci < len(arg_types)
                        if contains(fn_bounds, str(bci))
                            push(st.ti_bound_checks, [arg_types[bci], fn_bounds[str(bci)], eline, value])
                        bci = bci + 1
                return ret_var
            if tag == "method_call"
                if len(children) > 0
                    match children[0]
                        Expr(rtag, rval, rnum, rch, rf, rln) =>
                            if rtag == "ident" and contains(st.ti_modules, rval)
                                let mod_fns = st.ti_modules[rval]
                                if contains(mod_fns, value)
                                    let mfn_t = mod_fns[value]
                                    let arg_types = []
                                    let mai = 1
                                    while mai < len(children)
                                        push(arg_types, ti_infer_expr(st, children[mai]))
                                        mai = mai + 1
                                    let ret_var = ti_fresh(st)
                                    ti_constrain(st, mfn_t, nt_fn(arg_types, ret_var), eline)
                                    return ret_var
                                else
                                    ti_error(st, "module '" + rval + "' has no exported function '" + value + "'", eline)
                                    return nt_any()
                let ai = 0
                while ai < len(children)
                    ti_infer_expr(st, children[ai])
                    ai = ai + 1
                return nt_any()
            if tag == "dyn_call"
                let ai = 0
                while ai < len(children)
                    ti_infer_expr(st, children[ai])
                    ai = ai + 1
                return nt_any()
            if tag == "binop"
                let left = ti_infer_expr(st, children[0])
                let right = ti_infer_expr(st, children[1])
                if value == "+" or value == "-" or value == "*" or value == "/" or value == "%" or value == "**"
                    ti_constrain(st, left, right, eline)
                    return left
                if value == "==" or value == "!=" or value == "<" or value == ">" or value == "<=" or value == ">="
                    ti_constrain(st, left, right, eline)
                    return nt_bool()
                if value == "and" or value == "or"
                    ti_constrain(st, left, nt_bool(), eline)
                    ti_constrain(st, right, nt_bool(), eline)
                    return nt_bool()
                if value == "&" or value == "|" or value == "^" or value == "<<" or value == ">>"
                    ti_constrain(st, left, nt_int(), eline)
                    ti_constrain(st, right, nt_int(), eline)
                    return nt_int()
                if value == ".."
                    ti_constrain(st, left, nt_int(), eline)
                    ti_constrain(st, right, nt_int(), eline)
                    return nt_range()
                if value == "in"
                    return nt_bool()
                if value == "matches"
                    return nt_bool()
                return left
            if tag == "unary"
                let operand = ti_infer_expr(st, children[0])
                if value == "not"
                    ti_constrain(st, operand, nt_bool(), eline)
                    return nt_bool()
                return operand
            if tag == "list"
                // NOVA list literals may be heterogeneous (the compiler itself
                // uses them, e.g. [name, value, 0, arity]). Infer each element
                // (so errors inside elements still surface) but do NOT
                // constrain elements to each other; the list is list<any>.
                let ci = 0
                while ci < len(children)
                    ti_infer_expr(st, children[ci])
                    ci = ci + 1
                return nt_list(nt_any())
            if tag == "dict"
                return nt_dict(nt_string(), nt_any())
            if tag == "tuple"
                let elem_types = []
                for c in children
                    push(elem_types, ti_infer_expr(st, c))
                return nt_tuple(elem_types)
            if tag == "index"
                let idx_subj = ti_infer_expr(st, children[0])
                let idx_key = ti_infer_expr(st, children[1])
                let idx_w = ti_walk(st, idx_subj)
                match idx_w
                    NType(iwk, iwn, iwp, iwi) =>
                        if iwk == "int" or iwk == "float" or iwk == "bool" or iwk == "range"
                            ti_error(st, "type " + ti_type_str(idx_w) + " is not indexable; only list, dict, and string support [] access", eline)
                        else if iwk == "list" or iwk == "string"
                            // list and string both require integer indices.
                            let kw = ti_walk(st, idx_key)
                            match kw
                                NType(kwk, kwn, kwp, kwi) =>
                                    if kwk == "string" or kwk == "list" or kwk == "dict" or kwk == "struct" or kwk == "range"
                                        ti_error(st, "type " + ti_type_str(idx_w) + " requires an integer index, but found " + ti_type_str(kw), eline)
                        else if iwk == "dict" and len(iwp) > 0
                            // dict key type comes from the type parameter.
                            // Only flag when both sides are concrete and
                            // clearly disjoint kinds (int vs string is the
                            // common case).
                            let dkw = ti_walk(st, iwp[0])
                            let kw = ti_walk(st, idx_key)
                            let dk_kind = ""
                            let k_kind = ""
                            match dkw
                                NType(dkk, _, _, _) =>
                                    dk_kind = dkk
                            match kw
                                NType(kk, _, _, _) =>
                                    k_kind = kk
                            let dk_concrete = dk_kind == "int" or dk_kind == "string" or dk_kind == "float" or dk_kind == "bool"
                            let k_concrete = k_kind == "int" or k_kind == "string" or k_kind == "float" or k_kind == "bool"
                            if dk_concrete and k_concrete and dk_kind != k_kind
                                let dk_num = dk_kind == "int" or dk_kind == "float" or dk_kind == "bool"
                                let k_num = k_kind == "int" or k_kind == "float" or k_kind == "bool"
                                if not (dk_num and k_num)
                                    ti_error(st, "dict has key type " + ti_type_str(dkw) + ", but index is of type " + ti_type_str(kw), eline)
                return nt_any()
            if tag == "member"
                if len(children) > 0
                    let obj_t = ti_infer_expr(st, children[0])
                    let walked = ti_walk(st, obj_t)
                    match walked
                        NType(wk, wn, wp, wi) =>
                            if wk == "struct" and wn != "" and contains(st.ti_structs, wn)
                                let fields = st.ti_structs[wn]
                                if not contains(fields, value)
                                    ti_error(st, "struct " + ti_type_str(walked) + " has no field '" + value + "'", eline)
                                else
                                    return fields[value]
                            else if wk == "int" or wk == "float" or wk == "bool" or wk == "range"
                                ti_error(st, "type " + ti_type_str(walked) + " has no field '" + value + "' (field access requires a struct)", eline)
                return nt_any()
            if tag == "if"
                let cond = ti_infer_expr(st, children[0])
                ti_constrain(st, cond, nt_bool(), eline)
                if len(children) > 1
                    let then_t = ti_infer_expr(st, children[1])
                    if len(children) > 2
                        let else_t = ti_infer_expr(st, children[2])
                        ti_constrain(st, then_t, else_t, eline)
                    return then_t
                return nt_any()
            if tag == "lambda"
                return nt_any()
            if tag == "match"
                let m_subj = nt_any()
                if len(children) > 0
                    m_subj = ti_infer_expr(st, children[0])
                let ex_pats = []
                let m_result = nt_any()
                let m_first = true
                let mci = 1
                while mci < len(children)
                    match children[mci]
                        Expr(xat, xav, xan, xac, xaf, xal) =>
                            if xat == "arm" and len(xac) > 0
                                push(ex_pats, xac[0])
                                ti_push_scope(st)
                                ti_infer_pattern(st, xac[0], m_subj)
                                let m_armt = nt_any()
                                if len(xac) > 1
                                    m_armt = ti_infer_expr(st, xac[1])
                                ti_pop_scope(st)
                                if m_first
                                    m_result = m_armt
                                    m_first = false
                                else
                                    ti_unify_arms(st, m_result, m_armt, xal)
                    mci = mci + 1
                ti_check_exhaustive(st, ex_pats, eline)
                return m_result
            if tag == "for"
                return nt_any()
            if tag == "try"
                if len(children) > 0
                    return ti_infer_expr(st, children[0])
                return nt_any()
            if tag == "try_unwrap"
                if len(children) > 0
                    ti_infer_expr(st, children[0])
                return nt_any()
            if tag == "catch"
                let catch_t = nt_any()
                if len(children) > 0
                    catch_t = ti_infer_expr(st, children[0])
                ti_push_scope(st)
                if value != ""
                    ti_define(st, value, ti_mono(nt_string()))
                if num > 0
                    for s in fields
                        ti_infer_stmt(st, s)
                else if len(children) > 1
                    ti_infer_expr(st, children[1])
                ti_pop_scope(st)
                return catch_t
            if tag == "pair"
                if len(children) > 1
                    return ti_infer_expr(st, children[1])
                return nt_any()
            return nt_any()
    nt_any()

// ── Statement inference ──────────────────────────────────────────────────────

fn ti_infer_stmt(st: TiState, stmt: Stmt) -> NType
    ti_infer_stmt_inner(st, stmt)

fn ti_infer_stmt_inner(st: TiState, stmt: Stmt) -> NType
    match stmt
        Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
            if tag == "fn"
                let saved_fn = st.ti_in_fn
                st.ti_in_fn = name
                let gnames = ti_extract_generics(annotations)
                let gbounds = ti_extract_bounds(annotations)
                let gmap = {}
                for gn in gnames
                    gmap[gn] = ti_fresh(st)
                if len(gbounds) > 0
                    let fn_bounds = {}
                    let pbi = 0
                    for p in params
                        match p
                            Param(pname, ptype, pdefault) =>
                                if ptype != "" and contains(gbounds, ptype)
                                    fn_bounds[str(pbi)] = gbounds[ptype]
                        pbi = pbi + 1
                    if len(fn_bounds) > 0
                        st.ti_fn_bounds[name] = fn_bounds
                let param_types = []
                for p in params
                    match p
                        Param(pname, ptype, pdefault) =>
                            let pt = ti_fresh(st)
                            if ptype != "" and ptype != "any"
                                pt = ti_ann_to_type_g(ptype, gmap)
                            push(param_types, pt)
                let ret_var = ti_fresh(st)
                match expr
                    Expr(rxt, rxv, rxn, rxc, rxf, rxl) =>
                        if rxt == "rettype" and rxv != "" and rxv != "any"
                            let ann_t = ti_ann_to_type_g(rxv, gmap)
                            match ann_t
                                NType(ak, an2, ap, ai) =>
                                    if ak != "any"
                                        ti_constrain(st, ret_var, ann_t, sline)
                let fn_type = nt_fn(param_types, ret_var)
                let fn_name = name
                if fn_name == "main"
                    fn_name = "nova_user_main"
                let has_pre = false
                let scope_i = len(st.ti_scope) - 1
                while scope_i >= 0
                    if contains(st.ti_scope[scope_i], name)
                        has_pre = true
                        scope_i = -1
                    scope_i = scope_i - 1
                if has_pre
                    let pre_t = ti_lookup(st, name, sline)
                    ti_unify(st, fn_type, pre_t, sline)
                let fn_scheme = ti_mono(fn_type)
                ti_define(st, name, fn_scheme)
                let saved_ret = st.ti_ret_var
                st.ti_ret_var = ret_var
                ti_push_scope(st)
                let pi = 0
                for p in params
                    match p
                        Param(pname, ptype, pdefault) =>
                            ti_define(st, pname, ti_mono(param_types[pi]))
                            pi = pi + 1
                let last_t = nt_unit()
                for s in body
                    last_t = ti_infer_stmt(st, s)
                let is_nothing = false
                match last_t
                    NType(lk, ln, lp, li) =>
                        if lk == "nothing"
                            is_nothing = true
                if not is_nothing
                    ti_constrain(st, ret_var, last_t, sline)
                unused_check_function(body, params, name, st)
                break_continue_check(body, st)
                ti_pop_scope(st)
                st.ti_ret_var = saved_ret
                ti_solve(st)
                ti_define(st, name, ti_mono(nt_any()))
                let resolved = ti_zonk(st, fn_type)
                ti_define(st, name, ti_generalize(st, resolved))
                st.ti_fn_types[fn_name] = ti_to_ir_kind(ti_apply(st, ret_var))
                st.ti_fn_defer[name] = [fn_type, ret_var, fn_name]
                let min_ar = 0
                for mp in params
                    match mp
                        Param(mpn, mpt, mpd) =>
                            match mpd
                                Expr(mdt, mdv, mdn, mdc, mdf, mdl) =>
                                    if mdt == "null"
                                        min_ar = min_ar + 1
                st.ti_min_arity[name] = min_ar
                st.ti_in_fn = saved_fn
                return nt_unit()
            if tag == "extern_fn"
                return nt_unit()
            if tag == "type"
                let tgnames = ti_extract_generics(annotations)
                let tgmap = {}
                for tgn in tgnames
                    tgmap[tgn] = ti_fresh(st)
                let field_map = {}
                for p in params
                    match p
                        Param(pname, ptype, pdefault) =>
                            field_map[pname] = ti_ann_to_type_g(ptype, tgmap)
                st.ti_structs[name] = field_map
                let field_types = []
                for p in params
                    match p
                        Param(pname, ptype, pdefault) =>
                            push(field_types, ti_ann_to_type_g(ptype, tgmap))
                let ctor_type = nt_fn(field_types, nt_struct(name))
                ti_solve(st)
                let resolved_ctor = ti_zonk(st, ctor_type)
                ti_define(st, name, ti_generalize(st, resolved_ctor))
                for ann in annotations
                    match ann
                        Expr(at, av, an2, ac, af, al) =>
                            if at == "impl_trait"
                                if not contains(st.ti_type_traits, name)
                                    st.ti_type_traits[name] = {}
                                st.ti_type_traits[name][av] = sline
                return nt_unit()
            if tag == "enum"
                for variant in body
                    match variant
                        Stmt(vtag, vname, vexpr, vbody, vparams, velse, vann, vln) =>
                            if vtag == "type"
                                let vfield_map = {}
                                for vp in vparams
                                    match vp
                                        Param(vpname, vptype, vpdefault) =>
                                            vfield_map[vpname] = ti_ann_to_type(vptype)
                                st.ti_structs[vname] = vfield_map
                                let vfield_types = []
                                for vp in vparams
                                    match vp
                                        Param(vpname, vptype, vpdefault) =>
                                            push(vfield_types, ti_ann_to_type(vptype))
                                let vctor_type = nt_fn(vfield_types, nt_struct(vname))
                                ti_define(st, vname, ti_mono(vctor_type))
                return nt_unit()
            if tag == "assign"
                let rhs = ti_infer_expr(st, expr)
                if name != ""
                    let in_local = false
                    for frame in st.ti_scope
                        if contains(frame, name)
                            in_local = true
                    if not in_local
                        ti_define(st, name, ti_mono(rhs))
                    else
                        let existing = ti_lookup(st, name, sline)
                        let we = ti_walk(st, existing)
                        let we_is_unbound_any = false
                        match we
                            NType(wk, wn, wp, wi_id) =>
                                if wk == "any" and wn == ""
                                    we_is_unbound_any = true
                        if we_is_unbound_any
                            ti_define(st, name, ti_mono(rhs))
                        else
                            ti_constrain(st, existing, rhs, sline)
                    return nt_unit()
                else if len(annotations) > 0
                    let lhs_expr = annotations[0]
                    let lhs_is_ident = false
                    let lhs_ident_name = ""
                    match lhs_expr
                        Expr(et, ev, en, ec, ef, eln) =>
                            if et == "ident"
                                lhs_is_ident = true
                                lhs_ident_name = ev
                    if lhs_is_ident
                        let in_local = false
                        for frame in st.ti_scope
                            if contains(frame, lhs_ident_name)
                                in_local = true
                        if not in_local
                            ti_define(st, lhs_ident_name, ti_mono(rhs))
                        else
                            let existing = ti_lookup(st, lhs_ident_name, sline)
                            let we = ti_walk(st, existing)
                            let we_is_unbound_any = false
                            match we
                                NType(wk, wn, wp, wi_id) =>
                                    if wk == "any" and wn == ""
                                        we_is_unbound_any = true
                            if we_is_unbound_any
                                ti_define(st, lhs_ident_name, ti_mono(rhs))
                            else
                                ti_constrain(st, existing, rhs, sline)
                    else
                        match lhs_expr
                            Expr(let2, lev2, len2, lec2, lef2, leln2) =>
                                if let2 == "tuple"
                                    for telem in lec2
                                        match telem
                                            Expr(tet, tev, ten, tec, tef, teln) =>
                                                if tet == "ident"
                                                    ti_define(st, tev, ti_mono(nt_any()))
                                else
                                    let lhs = ti_infer_expr(st, lhs_expr)
                                    ti_constrain(st, lhs, rhs, sline)
                return nt_unit()
            if tag == "compound_assign"
                let rhs = ti_infer_expr(st, expr)
                if len(annotations) > 0
                    let lhs = ti_infer_expr(st, annotations[0])
                    ti_constrain(st, lhs, rhs, sline)
                return nt_unit()
            if tag == "spawn"
                // `pid = spawn fn() ...` binds the process handle to `name`.
                if name != ""
                    ti_define(st, name, ti_mono(nt_any()))
                return nt_unit()
            if tag == "expr"
                return ti_infer_expr(st, expr)
            if tag == "return"
                match expr
                    Expr(et, ev, en, ec, ef, eln) =>
                        if et != "null" or ev != "" or en != 0
                            let rt = ti_infer_expr(st, expr)
                            ti_constrain(st, st.ti_ret_var, rt, sline)
                            return nt_nothing()
                return nt_nothing()
            if tag == "yield"
                ti_infer_expr(st, expr)
                return nt_unit()
            if tag == "break" or tag == "continue"
                return nt_unit()
            if tag == "if"
                let cond = ti_infer_expr(st, expr)
                ti_constrain(st, cond, nt_bool(), sline)
                ti_push_scope(st)
                let last_t = nt_unit()
                for s in body
                    last_t = ti_infer_stmt(st, s)
                ti_pop_scope(st)
                if len(else_body) > 0
                    ti_push_scope(st)
                    let else_last_t = nt_unit()
                    for s in else_body
                        else_last_t = ti_infer_stmt(st, s)
                    ti_pop_scope(st)
                    // Branches must agree in value position. ti_unify_arms is
                    // tolerant: it skips when either side is unit/any/var/
                    // nothing, so a plain control-flow if (one branch prints,
                    // the other returns) still type-checks.
                    ti_unify_arms(st, last_t, else_last_t, sline)
                return last_t
            if tag == "while"
                let cond = ti_infer_expr(st, expr)
                ti_constrain(st, cond, nt_bool(), sline)
                ti_push_scope(st)
                for s in body
                    ti_infer_stmt(st, s)
                ti_pop_scope(st)
                // Detect infinite loops: while 1, while true → never exits normally
                let is_infinite = false
                match expr
                    Expr(et, ev, en, ec, ef, el) =>
                        if et == "int" and en != 0
                            is_infinite = true
                        if et == "bool" and ev == "true"
                            is_infinite = true
                if is_infinite
                    return nt_nothing()
                return nt_unit()
            if tag == "for"
                let iter_t = ti_infer_expr(st, expr)
                let elem_var = ti_fresh(st)
                let wi = ti_walk(st, iter_t)
                match wi
                    NType(wk, wn, wp, wi_id) =>
                        if wk == "list" and len(wp) > 0
                            ti_constrain(st, elem_var, wp[0], sline)
                        else if wk == "range"
                            ti_constrain(st, elem_var, nt_int(), sline)
                        else if wk == "string"
                            ti_constrain(st, elem_var, nt_string(), sline)
                        else if wk == "dict" and len(wp) > 0
                            ti_constrain(st, elem_var, wp[0], sline)
                        else if wk == "int" or wk == "float" or wk == "bool" or wk == "struct" or wk == "channel" or wk == "process"
                            ti_error(st, "cannot iterate over type " + ti_type_str(wi) + "; for-loop expects list, dict, string, or range", sline)
                ti_push_scope(st)
                ti_define(st, name, ti_mono(elem_var))
                for s in body
                    ti_infer_stmt(st, s)
                ti_pop_scope(st)
                return nt_unit()
            if tag == "match"
                let subj = ti_infer_expr(st, expr)
                let match_t = nt_unit()
                let match_first = true
                let ex_pats = []
                for arm in body
                    match arm
                        Stmt(at, an, ae, abody, ap, aeb, aann, asln) =>
                            if at == "arm"
                                push(ex_pats, ae)
                                ti_push_scope(st)
                                ti_infer_pattern(st, ae, subj)
                                let arm_t = nt_unit()
                                for s in abody
                                    arm_t = ti_infer_stmt(st, s)
                                ti_pop_scope(st)
                                if match_first
                                    match_t = arm_t
                                    match_first = false
                                else
                                    ti_unify_arms(st, match_t, arm_t, asln)
                ti_check_exhaustive(st, ex_pats, sline)
                // A match used as a function's last expression yields the
                // value of its arms; report the first arm's value type.
                return match_t
            if tag == "import"
                return nt_unit()
            if tag == "block"
                ti_push_scope(st)
                let last_t = nt_unit()
                for s in body
                    last_t = ti_infer_stmt(st, s)
                ti_pop_scope(st)
                return last_t
            return nt_unit()
    nt_unit()

// ── Pattern inference (match arms) ───────────────────────────────────────────

fn ti_infer_pattern(st: TiState, pat: Expr, expected: NType)
    match pat
        Expr(tag, value, num, children, fields, eline) =>
            if tag == "pat_var"
                // A bare identifier in a pattern is normally a binder, but it
                // may also name an enum variant (e.g. `match c { Red => ... }`
                // where Red is a niladic variant). In the variant case, the
                // subject must be of an enum/struct type — primitive subjects
                // are a soundness hole.
                if contains(st.ti_variant_enum, value)
                    let pv_w = ti_walk(st, expected)
                    match pv_w
                        NType(pvk, pvn, pvp, pvi) =>
                            if pvk == "int" or pvk == "float" or pvk == "bool" or pvk == "string" or pvk == "range" or pvk == "list" or pvk == "dict"
                                ti_error(st, "cannot match enum variant '" + value + "' against subject of type " + ti_type_str(pv_w), eline)
                ti_define(st, value, ti_mono(expected))
            else if tag == "pat_wild"
                return
            else if tag == "pat_lit"
                ti_constrain(st, expected, nt_int(), eline)
            else if tag == "pat_str"
                ti_constrain(st, expected, nt_string(), eline)
            else if tag == "pat_ctor"
                if contains(st.ti_variant_enum, value)
                    let pc_w = ti_walk(st, expected)
                    match pc_w
                        NType(pwk, pwn, pwp, pwi) =>
                            if pwk == "int" or pwk == "float" or pwk == "bool" or pwk == "string" or pwk == "range" or pwk == "list" or pwk == "dict"
                                ti_error(st, "cannot match enum variant '" + value + "' against subject of type " + ti_type_str(pc_w), eline)
                for child in children
                    match child
                        Expr(ct, cv, cn, cc, cf, cln) =>
                            if ct == "pat_var"
                                ti_define(st, cv, ti_mono(ti_fresh(st)))

// ── Match exhaustiveness check ───────────────────────────────────────────────

fn ti_check_exhaustive(st: TiState, patterns: list, line: int)
    let ex_catchall = false
    let ex_covered = []
    let ex_enum = ""
    let ex_is_enum = true
    for pat in patterns
        match pat
            Expr(pt, pv, pn, pc, pf, pl) =>
                if pt == "pat_wild"
                    ex_catchall = true
                else if pt == "pat_var"
                    if contains(st.ti_variant_enum, pv)
                        push(ex_covered, pv)
                        ex_enum = st.ti_variant_enum[pv]
                    else
                        ex_catchall = true
                else if pt == "pat_ctor"
                    if contains(st.ti_variant_enum, pv)
                        push(ex_covered, pv)
                        ex_enum = st.ti_variant_enum[pv]
                    else
                        ex_is_enum = false
                else
                    ex_is_enum = false
    if ex_is_enum and not ex_catchall and ex_enum != ""
        let ex_all = st.ti_enum_variants[ex_enum]
        let ex_missing = []
        for ev in ex_all
            if not list_contains(ex_covered, ev)
                push(ex_missing, ev)
        if len(ex_missing) > 0
            let ex_msg = "non-exhaustive match on enum '" + ex_enum + "': missing "
            let emi = 0
            while emi < len(ex_missing)
                if emi > 0
                    ex_msg = ex_msg + ", "
                ex_msg = ex_msg + ex_missing[emi]
                emi = emi + 1
            ti_error(st, ex_msg, line)

// ── Resolved type to IR type kind ────────────────────────────────────────────

fn ti_to_ir_kind(t: NType) -> string
    match t
        NType(kind, name, params, id) =>
            if kind == "int" or kind == "bool"
                return "int"
            if kind == "float"
                return "float"
            if kind == "string"
                return "str"
            if kind == "list"
                return "list"
            if kind == "dict"
                return "dict"
            if kind == "struct"
                return "struct"
    "any"

// ── Unused-variable analysis (catches typos like `counte = counter + 1`) ─────

fn unused_reads_expr(e: Expr, reads: dict)
    match e
        Expr(tag, value, num, children, fields, line) =>
            if tag == "ident"
                reads[value] = 1
            let ci = 0
            while ci < len(children)
                unused_reads_expr(children[ci], reads)
                ci = ci + 1
            let fi = 0
            while fi < len(fields)
                unused_reads_expr(fields[fi], reads)
                fi = fi + 1

fn unused_walk_stmt(s: Stmt, writes: dict, reads: dict)
    match s
        Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
            let skip_lhs_idx = -1
            if tag == "assign"
                if name != ""
                    if not contains(writes, name)
                        writes[name] = sline
                else if len(annotations) > 0
                    let lhs = annotations[0]
                    match lhs
                        Expr(et, ev, en, ec, ef, eln) =>
                            if et == "ident"
                                if not contains(writes, ev)
                                    writes[ev] = sline
                                skip_lhs_idx = 0
            else if tag == "compound_assign"
                if len(annotations) > 0
                    let lhs = annotations[0]
                    match lhs
                        Expr(et, ev, en, ec, ef, eln) =>
                            if et == "ident"
                                reads[ev] = 1
            else if tag == "for"
                reads[name] = 1
            else if tag == "spawn"
                if name != ""
                    if not contains(writes, name)
                        writes[name] = sline

            unused_reads_expr(expr, reads)
            let ai = 0
            while ai < len(annotations)
                if ai != skip_lhs_idx
                    unused_reads_expr(annotations[ai], reads)
                ai = ai + 1
            let bi = 0
            while bi < len(body)
                unused_walk_stmt(body[bi], writes, reads)
                bi = bi + 1
            let ebi = 0
            while ebi < len(else_body)
                unused_walk_stmt(else_body[ebi], writes, reads)
                ebi = ebi + 1
            let pi = 0
            while pi < len(params)
                match params[pi]
                    Param(ppn, ppt, ppd) =>
                        unused_reads_expr(ppd, reads)
                pi = pi + 1

fn unused_check_function(body: list, params: list, fn_name: string, st: TiState)
    let writes = {}
    let reads = {}
    let param_names = {}
    let p_i = 0
    while p_i < len(params)
        match params[p_i]
            Param(ppn, ppt, ppd) =>
                param_names[ppn] = 1
        p_i = p_i + 1
    let i = 0
    while i < len(body)
        unused_walk_stmt(body[i], writes, reads)
        i = i + 1
    let wks = keys(writes)
    let ki = 0
    while ki < len(wks)
        let wn = wks[ki]
        if not contains(reads, wn) and not contains(param_names, wn) and not starts_with(wn, "_")
            ti_error(st, "variable '" + wn + "' is assigned but never read (likely a typo)", writes[wn])
        ki = ki + 1

// ── break/continue context check ─────────────────────────────────────────────

fn break_continue_walk(s: Stmt, depth: int, st: TiState)
    match s
        Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
            if tag == "break" and depth == 0
                ti_error(st, "'break' is not allowed outside of a loop", sline)
            else if tag == "continue" and depth == 0
                ti_error(st, "'continue' is not allowed outside of a loop", sline)
            let new_depth = depth
            if tag == "for" or tag == "while"
                new_depth = depth + 1
            let bi = 0
            while bi < len(body)
                break_continue_walk(body[bi], new_depth, st)
                bi = bi + 1
            let ebi = 0
            while ebi < len(else_body)
                break_continue_walk(else_body[ebi], depth, st)
                ebi = ebi + 1

fn break_continue_check(body: list, st: TiState)
    let i = 0
    while i < len(body)
        break_continue_walk(body[i], 0, st)
        i = i + 1

// ── Main entry point: infer types for a parsed program ───────────────────────

fn ti_infer_program(stmts: list, source_lines: list) -> TiState
    ti_infer_program_named(stmts, source_lines, "")

fn ti_infer_program_named(stmts: list, source_lines: list, filename: string) -> TiState
    let st = ti_new_named(source_lines, filename)
    let seen_fns = {}
    let base_dir = path_dir(filename)
    let si = 0
    while si < len(stmts)
        match stmts[si]
            Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
                if tag == "import"
                    let mod_alias = name
                    if len(annotations) > 0 and annotations[0] != ""
                        mod_alias = annotations[0]
                    let mod_path = resolve_module_file(name, base_dir)
                    if mod_path != ""
                        let mod_source = read_file(mod_path)
                        if len(mod_source) > 0
                            let mod_tokens = tokenize(mod_source)
                            let mod_pe = []
                            let mod_stmts = parse_program(mod_tokens, mod_pe)
                            let mod_fn_types = {}
                            for ms in mod_stmts
                                match ms
                                    Stmt(mtag, mname, mexpr, mbody, mparams, meb, man, msl) =>
                                        if mtag == "fn" and len(mname) > 0 and mname[0] != "_"
                                            let mod_param_types = []
                                            let mpp = 0
                                            while mpp < len(mparams)
                                                push(mod_param_types, nt_any())
                                                mpp = mpp + 1
                                            let fn_type = nt_fn(mod_param_types, nt_any())
                                            ti_define(st, mname, ti_mono(fn_type))
                                            st.ti_min_arity[mname] = len(mparams)
                                            mod_fn_types[mname] = fn_type
                            st.ti_modules[mod_alias] = mod_fn_types
                if tag == "fn"
                    if contains(seen_fns, name)
                        ti_error(st, "duplicate function definition: '" + name + "' was already defined on line " + str(seen_fns[name]), sline)
                    else
                        seen_fns[name] = sline
                    let param_types = []
                    for p in params
                        push(param_types, ti_fresh(st))
                    let ret_var = ti_fresh(st)
                    ti_define(st, name, ti_mono(nt_fn(param_types, ret_var)))
                if tag == "extern_fn"
                    let ext_param_types = []
                    for p in params
                        match p
                            Param(pname, ptype, pdefault) =>
                                if ptype != "" and ptype != "any"
                                    push(ext_param_types, ti_ann_to_type(ptype))
                                else
                                    push(ext_param_types, nt_any())
                    let ext_ret_t = nt_any()
                    match expr
                        Expr(ert, erv, ern, erc, erf, erl) =>
                            if ert == "rettype"
                                ext_ret_t = ti_ann_to_type(erv)
                    ti_define(st, name, ti_mono(nt_fn(ext_param_types, ext_ret_t)))
                if tag == "enum"
                    let variant_names = []
                    for variant in body
                        match variant
                            Stmt(vtag, vname, vexpr, vbody, vparams, velse, vann, vln) =>
                                if vtag == "type"
                                    push(variant_names, vname)
                                    st.ti_variant_enum[vname] = name
                    st.ti_enum_variants[name] = variant_names
                if tag == "trait"
                    let trait_methods = []
                    for tm in body
                        match tm
                            Stmt(tmt, tmn, tme, tmb, tmp, tmeb, tma, tml) =>
                                if tmt == "fn_sig"
                                    let param_count = len(tmp)
                                    let has_self = false
                                    for tp in tmp
                                        match tp
                                            Param(tpn, tpt, tpd) =>
                                                if tpn == "self"
                                                    has_self = true
                                    if has_self
                                        param_count = param_count - 1
                                    push(trait_methods, tmn)
                    st.ti_traits[name] = trait_methods
                if tag == "fn"
                    let dunder = find(name, "__")
                    if dunder > 0
                        let type_name = slice(name, 0, dunder)
                        let method_name = slice(name, dunder + 2, len(name))
                        if not contains(st.ti_type_methods, type_name)
                            st.ti_type_methods[type_name] = []
                        push(st.ti_type_methods[type_name], method_name)
        si = si + 1
    si = 0
    while si < len(stmts)
        match stmts[si]
            Stmt(tt2, nn2, ee2, bb2, pp2, eb2, an2, sl2) =>
                if tt2 == "return"
                    ti_error(st, "'return' outside of a function is not allowed", sl2)
                if tt2 == "break"
                    ti_error(st, "'break' outside of a loop is not allowed", sl2)
                if tt2 == "continue"
                    ti_error(st, "'continue' outside of a loop is not allowed", sl2)
        ti_infer_stmt(st, stmts[si])
        si = si + 1
    ti_check_trait_conformance(st)
    ti_solve(st)
    let defer_names = keys(st.ti_fn_defer)
    for dn in defer_names
        let dinfo = st.ti_fn_defer[dn]
        let d_fn_type = dinfo[0]
        let d_ret_var = dinfo[1]
        let d_fn_name = dinfo[2]
        ti_define(st, dn, ti_mono(nt_any()))
        let d_resolved = ti_zonk(st, d_fn_type)
        ti_define(st, dn, ti_generalize(st, d_resolved))
        st.ti_fn_types[d_fn_name] = ti_to_ir_kind(ti_apply(st, d_ret_var))
    ti_check_bounds(st)
    st

fn ti_check_bounds(st: TiState)
    for bc in st.ti_bound_checks
        let bc_type = bc[0]
        let bc_trait = bc[1]
        let bc_line = bc[2]
        let bc_fn = bc[3]
        let resolved = ti_apply(st, bc_type)
        match resolved
            NType(rk, rn, rp, ri) =>
                if rk == "any" or rk == "var"
                    continue
                let type_name = rk
                if rk == "struct"
                    type_name = rn
                let has_trait = false
                if contains(st.ti_type_traits, type_name)
                    if contains(st.ti_type_traits[type_name], bc_trait)
                        has_trait = true
                if not has_trait
                    ti_error(st, "type " + ti_type_str(resolved) + " does not implement trait '" + bc_trait + "' (required by " + bc_fn + ")", bc_line)

fn ti_check_trait_conformance(st: TiState)
    let type_names = keys(st.ti_type_traits)
    for tn in type_names
        let trait_map = st.ti_type_traits[tn]
        let trait_names = keys(trait_map)
        for trait_name in trait_names
            let decl_line = trait_map[trait_name]
            if not contains(st.ti_traits, trait_name)
                ti_error(st, "type '" + tn + "' declares conformance to unknown trait '" + trait_name + "'", decl_line)
            else
                let required = st.ti_traits[trait_name]
                let implemented = []
                if contains(st.ti_type_methods, tn)
                    implemented = st.ti_type_methods[tn]
                let missing = []
                for rm in required
                    if not list_contains(implemented, rm)
                        push(missing, rm)
                if len(missing) > 0
                    let msg = "type '" + tn + "' does not fully implement trait '" + trait_name + "': missing "
                    let mi = 0
                    while mi < len(missing)
                        if mi > 0
                            msg = msg + ", "
                        msg = msg + missing[mi] + "()"
                        mi = mi + 1
                    ti_error(st, msg, decl_line)

// ── Tail Call Optimization ───────────────────────────────────────────────────

fn ir_tco_rewrite_block(label: string, insts: list, call_idx: int, params: list) -> IrBlock
    let new_insts = []
    let ii = 0
    while ii < call_idx
        push(new_insts, insts[ii])
        ii = ii + 1
    let call_line = 0
    match insts[call_idx]
        IrInst(_, _, _, cargs, _, _, _, cline) =>
            call_line = cline
            let pi = 0
            while pi < len(params)
                match params[pi]
                    IrParam(pname, ptype) =>
                        push(new_insts, IrInst("slot_store", "", ir_type_void(), [cargs[pi]], pname, 0, "side", cline))
                pi = pi + 1
    IrBlock(label, new_insts, IrInst("goto", "", ir_type_void(), [], "tco_loop", 0, "pure", call_line))

fn ir_tco(func: IrFunction) -> IrFunction
    match func
        IrFunction(name, params, ret_type, blocks, type_params, is_extern) =>
            if is_extern == 1 or len(params) == 0 or len(blocks) == 0
                return func
            let tail_map = {}
            for block in blocks
                match block
                    IrBlock(label, insts, terminator) =>
                        match terminator
                            IrInst(top, _, _, targs, _, _, _, _) =>
                                if top == "return" and len(targs) > 0
                                    let rv = targs[0]
                                    let idx = len(insts) - 1
                                    while idx >= 0
                                        match insts[idx]
                                            IrInst(iop, idest, _, iargs, ival, _, _, _) =>
                                                if iop == "call" and ival == name and idest == rv and len(iargs) == len(params)
                                                    tail_map[label] = idx
                                                    idx = -1
                                        if idx >= 0
                                            idx = idx - 1
            if len(tail_map) == 0
                return func
            let new_blocks = []
            for block in blocks
                match block
                    IrBlock(label, insts, terminator) =>
                        if label == "entry"
                            push(new_blocks, IrBlock("entry", [], IrInst("goto", "", ir_type_void(), [], "tco_loop", 0, "pure", 0)))
                            if contains(tail_map, "entry")
                                let ci = tail_map["entry"]
                                push(new_blocks, ir_tco_rewrite_block("tco_loop", insts, ci, params))
                            else
                                push(new_blocks, IrBlock("tco_loop", insts, terminator))
                        else if contains(tail_map, label)
                            let ci = tail_map[label]
                            push(new_blocks, ir_tco_rewrite_block(label, insts, ci, params))
                        else
                            push(new_blocks, block)
            IrFunction(name, params, ret_type, new_blocks, type_params, is_extern)

// ── Dead Block Elimination ──────────────────────────────────────────────────

fn ir_dbe(func: IrFunction) -> IrFunction
    match func
        IrFunction(name, params, ret_type, blocks, type_params, is_extern) =>
            if is_extern == 1 or len(blocks) == 0
                return func
            let reachable = {}
            let queue = []
            match blocks[0]
                IrBlock(elabel, _, _) =>
                    push(queue, elabel)
            let qi = 0
            while qi < len(queue)
                let lbl = queue[qi]
                qi = qi + 1
                if contains(reachable, lbl)
                    continue
                reachable[lbl] = 1
                for block in blocks
                    match block
                        IrBlock(blabel, _, terminator) =>
                            if blabel == lbl
                                match terminator
                                    IrInst(top, _, _, targs, tval, _, _, _) =>
                                        if top == "goto"
                                            if not contains(reachable, tval)
                                                push(queue, tval)
                                        else if top == "branch"
                                            if not contains(reachable, tval)
                                                push(queue, tval)
                                            if len(targs) > 1 and not contains(reachable, targs[1])
                                                push(queue, targs[1])
            let new_blocks = []
            for block in blocks
                match block
                    IrBlock(blabel, _, _) =>
                        if contains(reachable, blabel)
                            push(new_blocks, block)
            IrFunction(name, params, ret_type, new_blocks, type_params, is_extern)

// ── Dead Instruction Elimination ────────────────────────────────────────────

fn ir_die(func: IrFunction) -> IrFunction
    match func
        IrFunction(name, params, ret_type, blocks, type_params, is_extern) =>
            if is_extern == 1 or len(blocks) == 0
                return func
            let used = {}
            for block in blocks
                match block
                    IrBlock(_, insts, terminator) =>
                        for inst in insts
                            match inst
                                IrInst(_, _, _, args, _, _, _, _) =>
                                    for arg in args
                                        used[arg] = 1
                        match terminator
                            IrInst(_, _, _, targs, _, _, _, _) =>
                                for targ in targs
                                    used[targ] = 1
            let new_blocks = []
            for block in blocks
                match block
                    IrBlock(label, insts, terminator) =>
                        let new_insts = []
                        for inst in insts
                            match inst
                                IrInst(op, dest, _, _, _, _, effect, line) =>
                                    if dest == "" or contains(used, dest) or effect == "side_effect" or op == "slot_store" or op == "call" or op == "index_set" or op == "field_set"
                                        push(new_insts, inst)
                        push(new_blocks, IrBlock(label, new_insts, terminator))
            IrFunction(name, params, ret_type, new_blocks, type_params, is_extern)

// ── Constant Folding + Slot Forwarding ──────────────────────────────────────

fn ir_const_fold(func: IrFunction) -> IrFunction
    match func
        IrFunction(name, params, ret_type, blocks, type_params, is_extern) =>
            if is_extern == 1 or len(blocks) == 0
                return func
            let const_vals = {}
            let new_blocks = []
            for block in blocks
                match block
                    IrBlock(label, insts, terminator) =>
                        let slot_last = {}
                        let new_insts = []
                        for inst in insts
                            match inst
                                IrInst(op, dest, typ, args, value, num, effect, line) =>
                                    if op == "const_int"
                                        const_vals[dest] = num
                                        push(new_insts, inst)
                                    else if op == "slot_store"
                                        slot_last[value] = args[0]
                                        push(new_insts, inst)
                                    else if op == "slot_load"
                                        if contains(slot_last, value)
                                            let fwd = slot_last[value]
                                            push(new_insts, IrInst("copy", dest, typ, [fwd], "", 0, "pure", line))
                                            if contains(const_vals, fwd)
                                                const_vals[dest] = const_vals[fwd]
                                        else
                                            push(new_insts, inst)
                                    else if op == "add" and len(args) == 2
                                        if contains(const_vals, args[0]) and contains(const_vals, args[1])
                                            match typ
                                                IrType(tk, _, _, _) =>
                                                    if tk == "int" or tk == "any"
                                                        let result = const_vals[args[0]] + const_vals[args[1]]
                                                        const_vals[dest] = result
                                                        push(new_insts, IrInst("const_int", dest, ir_type_int(), [], str(result), result, "pure", line))
                                                    else
                                                        push(new_insts, inst)
                                        else
                                            push(new_insts, inst)
                                    else if op == "sub" and len(args) == 2
                                        if contains(const_vals, args[0]) and contains(const_vals, args[1])
                                            match typ
                                                IrType(tk, _, _, _) =>
                                                    if tk == "int" or tk == "any"
                                                        let result = const_vals[args[0]] - const_vals[args[1]]
                                                        const_vals[dest] = result
                                                        push(new_insts, IrInst("const_int", dest, ir_type_int(), [], str(result), result, "pure", line))
                                                    else
                                                        push(new_insts, inst)
                                        else
                                            push(new_insts, inst)
                                    else if op == "mul" and len(args) == 2
                                        if contains(const_vals, args[0]) and contains(const_vals, args[1])
                                            match typ
                                                IrType(tk, _, _, _) =>
                                                    if tk == "int" or tk == "any"
                                                        let result = const_vals[args[0]] * const_vals[args[1]]
                                                        const_vals[dest] = result
                                                        push(new_insts, IrInst("const_int", dest, ir_type_int(), [], str(result), result, "pure", line))
                                                    else
                                                        push(new_insts, inst)
                                        else
                                            push(new_insts, inst)
                                    else if op == "eq" and len(args) == 2
                                        if contains(const_vals, args[0]) and contains(const_vals, args[1])
                                            match typ
                                                IrType(tk, _, _, _) =>
                                                    if tk == "int" or tk == "any"
                                                        let result = 0
                                                        if const_vals[args[0]] == const_vals[args[1]]
                                                            result = 1
                                                        const_vals[dest] = result
                                                        push(new_insts, IrInst("const_int", dest, ir_type_int(), [], str(result), result, "pure", line))
                                                    else
                                                        push(new_insts, inst)
                                        else
                                            push(new_insts, inst)
                                    else if op == "neq" and len(args) == 2
                                        if contains(const_vals, args[0]) and contains(const_vals, args[1])
                                            match typ
                                                IrType(tk, _, _, _) =>
                                                    if tk == "int" or tk == "any"
                                                        let result = 0
                                                        if const_vals[args[0]] != const_vals[args[1]]
                                                            result = 1
                                                        const_vals[dest] = result
                                                        push(new_insts, IrInst("const_int", dest, ir_type_int(), [], str(result), result, "pure", line))
                                                    else
                                                        push(new_insts, inst)
                                        else
                                            push(new_insts, inst)
                                    else if op == "lt" and len(args) == 2
                                        if contains(const_vals, args[0]) and contains(const_vals, args[1])
                                            match typ
                                                IrType(tk, _, _, _) =>
                                                    if tk == "int" or tk == "any"
                                                        let result = 0
                                                        if const_vals[args[0]] < const_vals[args[1]]
                                                            result = 1
                                                        const_vals[dest] = result
                                                        push(new_insts, IrInst("const_int", dest, ir_type_int(), [], str(result), result, "pure", line))
                                                    else
                                                        push(new_insts, inst)
                                        else
                                            push(new_insts, inst)
                                    else if op == "le" and len(args) == 2
                                        if contains(const_vals, args[0]) and contains(const_vals, args[1])
                                            match typ
                                                IrType(tk, _, _, _) =>
                                                    if tk == "int" or tk == "any"
                                                        let result = 0
                                                        if const_vals[args[0]] <= const_vals[args[1]]
                                                            result = 1
                                                        const_vals[dest] = result
                                                        push(new_insts, IrInst("const_int", dest, ir_type_int(), [], str(result), result, "pure", line))
                                                    else
                                                        push(new_insts, inst)
                                        else
                                            push(new_insts, inst)
                                    else if op == "gt" and len(args) == 2
                                        if contains(const_vals, args[0]) and contains(const_vals, args[1])
                                            match typ
                                                IrType(tk, _, _, _) =>
                                                    if tk == "int" or tk == "any"
                                                        let result = 0
                                                        if const_vals[args[0]] > const_vals[args[1]]
                                                            result = 1
                                                        const_vals[dest] = result
                                                        push(new_insts, IrInst("const_int", dest, ir_type_int(), [], str(result), result, "pure", line))
                                                    else
                                                        push(new_insts, inst)
                                        else
                                            push(new_insts, inst)
                                    else if op == "ge" and len(args) == 2
                                        if contains(const_vals, args[0]) and contains(const_vals, args[1])
                                            match typ
                                                IrType(tk, _, _, _) =>
                                                    if tk == "int" or tk == "any"
                                                        let result = 0
                                                        if const_vals[args[0]] >= const_vals[args[1]]
                                                            result = 1
                                                        const_vals[dest] = result
                                                        push(new_insts, IrInst("const_int", dest, ir_type_int(), [], str(result), result, "pure", line))
                                                    else
                                                        push(new_insts, inst)
                                        else
                                            push(new_insts, inst)
                                    else if op == "copy" and len(args) == 1
                                        if contains(const_vals, args[0])
                                            const_vals[dest] = const_vals[args[0]]
                                        push(new_insts, inst)
                                    else
                                        push(new_insts, inst)
                        let new_term = terminator
                        match terminator
                            IrInst(top, tdest, ttyp, targs, tval, tnum, teff, tline) =>
                                if top == "branch" and len(targs) > 0
                                    if contains(const_vals, targs[0])
                                        let cv = const_vals[targs[0]]
                                        if cv != 0
                                            new_term = IrInst("goto", "", ir_type_void(), [], tval, 0, "pure", tline)
                                        else
                                            if len(targs) > 1
                                                new_term = IrInst("goto", "", ir_type_void(), [], targs[1], 0, "pure", tline)
                        push(new_blocks, IrBlock(label, new_insts, new_term))
            IrFunction(name, params, ret_type, new_blocks, type_params, is_extern)

// IR optimizer pipeline. Slot-level dead-store elimination is intentionally
// NOT done here — slot_store/slot_load lower to LLVM alloca/store/load, and
// clang -O2's mem2reg + DSE already eliminate them completely. A NOVA-level
// DSE pass would be pure redundancy with the backend.
//
// Performance strategy (Option D):
// - readonly/readnone attributes on runtime declarations enable LLVM's
//   LICM (list_len hoisting), GVN (redundant call elimination), and CSE
// - TBAA metadata on inlined list/dict ops gives LLVM aliasing info
// - Arena mode (Option E2) eliminates all RC overhead for single-process code
fn ir_optimize(func: IrFunction) -> IrFunction
    let f = ir_tco(func)
    f = ir_const_fold(f)
    f = ir_die(f)
    f = ir_dbe(f)
    f

// ── IR Type Inference ────────────────────────────────────────────────────────

fn ir_reg_type(reg_types: dict, reg: string) -> string
    if contains(reg_types, reg)
        return reg_types[reg]
    "any"

// Non-negativity tracking. A register/slot is "@nn@"-marked when proven to
// hold a non-negative value, so list index access can skip the negative-index
// (Python a[-1]) adjustment. Conservative: only const>=0 and add/mul of
// non-negatives; sub/div/mod/neg are never assumed non-negative.
fn ir_reg_nn(rt: dict, reg: string) -> int
    let k = "@nn@" + reg
    if contains(rt, k)
        return rt[k]
    0

fn ir_infer_one(rt: dict, st: dict, frt: dict, inst: IrInst) -> IrInst
    match inst
        IrInst(op, dest, typ, args, value, num, effect, line) =>
            if op == "const_int"
                if typ.kind == "bool"
                    rt[dest] = "bool"
                    rt["@nn@" + dest] = 1
                    return IrInst(op, dest, typ, args, value, num, effect, line)
                rt[dest] = "int"
                if num >= 0
                    rt["@nn@" + dest] = 1
                return IrInst(op, dest, ir_type_int(), args, value, num, effect, line)
            else if op == "const_float"
                rt[dest] = "float"
                return IrInst(op, dest, ir_type_float(), args, value, num, effect, line)
            else if op == "const_str"
                rt[dest] = "str"
                return IrInst(op, dest, ir_type_str(), args, value, num, effect, line)
            else if op == "add"
                if len(args) == 2 and ir_reg_nn(rt, args[0]) == 1 and ir_reg_nn(rt, args[1]) == 1
                    rt["@nn@" + dest] = 1
                let lt = ir_reg_type(rt, args[0])
                let rty = ir_reg_type(rt, args[1])
                if lt == "float" and rty == "float"
                    rt[dest] = "float"
                    return IrInst(op, dest, ir_type_float(), args, "", num, effect, line)
                if lt == "float" and rty == "int"
                    rt[dest] = "float"
                    return IrInst(op, dest, ir_type_float(), args, "R", num, effect, line)
                if lt == "int" and rty == "float"
                    rt[dest] = "float"
                    return IrInst(op, dest, ir_type_float(), args, "L", num, effect, line)
                if lt == "int" and rty == "int"
                    rt[dest] = "int"
                    return IrInst(op, dest, ir_type_int(), args, value, num, effect, line)
                else if lt == "str" or rty == "str"
                    rt[dest] = "str"
                    return IrInst(op, dest, ir_type_str(), args, value, num, effect, line)
                else if lt == "list" or rty == "list" or lt == "intlist" or rty == "intlist"
                    rt[dest] = "list"
                    return IrInst("call", dest, ir_type_any(), args, "nova_rt_list_concat", num, effect, line)
                rt[dest] = "any"
                return inst
            else if op == "sub" or op == "mul" or op == "div" or op == "mod"
                if op == "mul" and len(args) == 2 and ir_reg_nn(rt, args[0]) == 1 and ir_reg_nn(rt, args[1]) == 1
                    rt["@nn@" + dest] = 1
                let lt = ir_reg_type(rt, args[0])
                let rty = ir_reg_type(rt, args[1])
                if lt == "float" and rty == "float"
                    rt[dest] = "float"
                    return IrInst(op, dest, ir_type_float(), args, "", num, effect, line)
                if lt == "float" and rty == "int"
                    rt[dest] = "float"
                    return IrInst(op, dest, ir_type_float(), args, "R", num, effect, line)
                if lt == "int" and rty == "float"
                    rt[dest] = "float"
                    return IrInst(op, dest, ir_type_float(), args, "L", num, effect, line)
                if lt == "int" and rty == "int"
                    rt[dest] = "int"
                    return IrInst(op, dest, ir_type_int(), args, value, num, effect, line)
                rt[dest] = "any"
                return IrInst(op, dest, ir_type_any(), args, value, num, effect, line)
            else if op == "neg"
                let lt = ir_reg_type(rt, args[0])
                if lt == "float"
                    rt[dest] = "float"
                    return IrInst(op, dest, ir_type_float(), args, value, num, effect, line)
                rt[dest] = "int"
                return IrInst(op, dest, ir_type_int(), args, value, num, effect, line)
            else if op == "eq" or op == "neq"
                let lt = ir_reg_type(rt, args[0])
                let rty = ir_reg_type(rt, args[1])
                let itype = ir_type_any()
                let promote = ""
                if lt == "float" and rty == "float"
                    itype = ir_type_float()
                else if lt == "float" and rty == "int"
                    itype = ir_type_float()
                    promote = "R"
                else if lt == "int" and rty == "float"
                    itype = ir_type_float()
                    promote = "L"
                else if lt == "int" and rty == "int"
                    itype = ir_type_int()
                else if lt == "str" or rty == "str"
                    itype = ir_type_str()
                rt[dest] = "int"
                return IrInst(op, dest, itype, args, promote, num, effect, line)
            else if op == "lt" or op == "le" or op == "gt" or op == "ge"
                let lt = ir_reg_type(rt, args[0])
                let rty = ir_reg_type(rt, args[1])
                if lt == "float" and rty == "float"
                    rt[dest] = "int"
                    return IrInst(op, dest, ir_type_float(), args, "", num, effect, line)
                if lt == "float" and rty == "int"
                    rt[dest] = "int"
                    return IrInst(op, dest, ir_type_float(), args, "R", num, effect, line)
                if lt == "int" and rty == "float"
                    rt[dest] = "int"
                    return IrInst(op, dest, ir_type_float(), args, "L", num, effect, line)
                if lt == "str" or rty == "str"
                    rt[dest] = "int"
                    return IrInst(op, dest, ir_type_str(), args, value, num, effect, line)
                rt[dest] = "int"
                return IrInst(op, dest, ir_type_int(), args, value, num, effect, line)
            else if op == "not" or op == "and" or op == "or"
                rt[dest] = "int"
                return IrInst(op, dest, ir_type_int(), args, value, num, effect, line)
            else if op == "slot_load"
                let stype = "any"
                if contains(st, value)
                    stype = st[value]
                rt[dest] = stype
                rt["@slot@" + dest] = value
                if contains(st, "@nn@" + value) and st["@nn@" + value] == 1
                    rt["@nn@" + dest] = 1
                return IrInst(op, dest, IrType(stype, "", [], 0), args, value, num, effect, line)
            else if op == "slot_store"
                let val_type = ir_reg_type(rt, args[0])
                rt["@slot@" + args[0]] = value
                if contains(st, value)
                    if st[value] != val_type
                        let a_listish = st[value] == "list" or st[value] == "intlist"
                        let b_listish = val_type == "list" or val_type == "intlist"
                        if a_listish and b_listish
                            st[value] = "list"
                        else
                            st[value] = "any"
                else
                    st[value] = val_type
                let store_nn = ir_reg_nn(rt, args[0])
                if contains(st, "@nn@" + value)
                    if store_nn == 0
                        st["@nn@" + value] = 0
                else
                    st["@nn@" + value] = store_nn
                return inst
            else if op == "call"
                if value == "nova_rt_print_any" and len(args) == 1
                    let arg_type = ir_reg_type(rt, args[0])
                    if arg_type == "bool"
                        if dest != ""
                            rt[dest] = "int"
                        return IrInst(op, dest, typ, args, "nova_rt_print_bool", num, effect, line)
                    if arg_type == "float"
                        if dest != ""
                            rt[dest] = "int"
                        return IrInst(op, dest, typ, args, "nova_rt_print_float", num, effect, line)
                    if arg_type == "int"
                        if dest != ""
                            rt[dest] = "int"
                        return IrInst(op, dest, typ, args, "nova_rt_print_int", num, effect, line)
                    if arg_type == "str"
                        if dest != ""
                            rt[dest] = "int"
                        return IrInst(op, dest, typ, args, "nova_rt_print_str", num, effect, line)
                if value == "nova_rt_int_to_str" and len(args) == 1
                    let arg_type = ir_reg_type(rt, args[0])
                    if arg_type == "float"
                        if dest != ""
                            rt[dest] = "str"
                        return IrInst(op, dest, typ, args, "nova_rt_float_to_str", num, effect, line)
                    if arg_type == "str"
                        if dest != ""
                            rt[dest] = "str"
                        return IrInst("copy", dest, ir_type_str(), args, "", 0, "pure", line)
                    if arg_type != "int" and arg_type != "any"
                        if dest != ""
                            rt[dest] = "str"
                        return IrInst(op, dest, typ, args, "nova_rt_any_to_str", num, effect, line)
                if value == "nova_rt_json_encode" and len(args) == 1
                    let je_type = ir_reg_type(rt, args[0])
                    if je_type == "float"
                        if dest != ""
                            rt[dest] = "str"
                        return IrInst(op, dest, typ, args, "nova_rt_json_encode_float", num, effect, line)
                    if je_type == "bool"
                        if dest != ""
                            rt[dest] = "str"
                        return IrInst(op, dest, typ, args, "nova_rt_json_encode_bool", num, effect, line)
                if (value == "nova_rt_len" or value == "nova_rt_len_any") and len(args) == 1
                    let arg_type = ir_reg_type(rt, args[0])
                    if arg_type == "list" or arg_type == "intlist"
                        if dest != ""
                            rt[dest] = "int"
                        return IrInst("list_len", dest, ir_type_int(), args, "", 0, "pure", line)
                if value == "nova_rt_list_append" and len(args) == 2
                    let lk = "@slot@" + args[0]
                    if contains(rt, lk)
                        let lslot = rt[lk]
                        if contains(st, lslot)
                            let vt = ir_reg_type(rt, args[1])
                            if vt == "int"
                                if st[lslot] == "list" or st[lslot] == "intlist"
                                    st[lslot] = "intlist"
                                if dest != ""
                                    rt[dest] = "intlist"
                                return inst
                            else
                                if st[lslot] == "intlist"
                                    st[lslot] = "list"
                                rt[args[0]] = "list"
                                if dest != ""
                                    rt[dest] = "list"
                                if vt == "float"
                                    return IrInst(op, dest, typ, args, "nova_rt_list_append_fbox", num, effect, line)
                                if vt == "bool"
                                    return IrInst(op, dest, typ, args, "nova_rt_list_append_bbox", num, effect, line)
                                return inst
                    if ir_reg_type(rt, args[1]) == "float"
                        return IrInst(op, dest, typ, args, "nova_rt_list_append_fbox", num, effect, line)
                    if ir_reg_type(rt, args[1]) == "bool"
                        return IrInst(op, dest, typ, args, "nova_rt_list_append_bbox", num, effect, line)
                if value == "nova_rt_list_create_filled" and len(args) == 2
                    if dest != ""
                        if ir_reg_type(rt, args[1]) == "int"
                            rt[dest] = "intlist"
                        else
                            rt[dest] = "list"
                    return inst
                if value == "nova_rt_for_iter_init" and len(args) == 1
                    let fi_type = ir_reg_type(rt, args[0])
                    if fi_type == "intlist" or fi_type == "list"
                        if dest != ""
                            rt[dest] = fi_type
                        return IrInst("copy", dest, ir_type_any(), args, "", 0, "pure", line)
                    if dest != ""
                        rt[dest] = "any"
                    return inst
                if dest != ""
                    let rtype = "any"
                    if value == "nova_rt_len" or value == "nova_rt_len_any" or value == "nova_rt_ord" or value == "nova_rt_parse_int" or value == "nova_rt_system"
                        rtype = "int"
                    else if value == "nova_rt_find" or value == "nova_rt_index_of" or value == "nova_rt_str_count" or value == "nova_rt_time_ms" or value == "nova_rt_clock_ns" or value == "nova_rt_random_int" or value == "nova_rt_hash" or value == "nova_rt_bytes_get" or value == "nova_rt_bytes_len" or value == "nova_rt_float_to_int" or value == "nova_rt_to_int" or value == "nova_rt_int_pow" or value == "nova_rt_abs" or value == "nova_rt_max" or value == "nova_rt_min" or value == "nova_rt_floor" or value == "nova_rt_ceil" or value == "nova_rt_str_len" or value == "nova_rt_dict_len" or value == "nova_rt_cpu_count" or value == "nova_rt_sum" or value == "nova_rt_tensor_size" or value == "nova_rt_tensor_rank" or value == "nova_rt_alloc_count" or value == "nova_rt_live_count" or value == "nova_rt_result_tag" or value == "nova_rt_iter_count" or value == "nova_rt_iter_sum" or value == "nova_rt_list_min" or value == "nova_rt_list_max" or value == "nova_rt_set_len" or value == "nova_rt_buffer_len" or value == "nova_rt_semver_compare"
                        rtype = "int"
                    else if value == "nova_rt_contains" or value == "nova_rt_starts_with" or value == "nova_rt_ends_with" or value == "nova_rt_regex_match" or value == "nova_rt_dict_has" or value == "nova_rt_path_exists" or value == "nova_rt_file_exists" or value == "nova_rt_is_ok" or value == "nova_rt_is_err" or value == "nova_rt_is_some" or value == "nova_rt_is_none" or value == "nova_rt_any_match" or value == "nova_rt_all_match" or value == "nova_rt_iter_any" or value == "nova_rt_iter_all" or value == "nova_rt_any_truthy" or value == "nova_rt_all_truthy" or value == "nova_rt_set_has" or value == "nova_rt_semver_satisfies" or value == "nova_rt_is_arena_mode"
                        rtype = "bool"
                    else if value == "nova_rt_str_concat" or value == "nova_rt_int_to_str" or value == "nova_rt_any_to_str" or value == "nova_rt_chr" or value == "nova_rt_exec" or value == "nova_rt_shell" or value == "nova_rt_buffer_to_str" or value == "nova_rt_buffer_str" or value == "nova_rt_semver_format"
                        rtype = "str"
                    else if value == "nova_rt_regex_find" or value == "nova_rt_regex_replace" or value == "nova_rt_slice" or value == "nova_rt_upper" or value == "nova_rt_lower" or value == "nova_rt_trim" or value == "nova_rt_repeat" or value == "nova_rt_join" or value == "nova_rt_float_to_str" or value == "nova_rt_bool_to_str" or value == "nova_rt_read_file" or value == "nova_rt_read_line" or value == "nova_rt_path_join" or value == "nova_rt_path_parent" or value == "nova_rt_path_name" or value == "nova_rt_path_ext" or value == "nova_rt_cwd" or value == "nova_rt_env" or value == "nova_rt_bytes_to_str" or value == "nova_rt_str_char_at" or value == "nova_rt_hex" or value == "nova_rt_oct" or value == "nova_rt_bin" or value == "nova_rt_format" or value == "nova_rt_lstrip" or value == "nova_rt_rstrip" or value == "nova_rt_pad_left" or value == "nova_rt_pad_right" or value == "nova_rt_center" or value == "nova_rt_json_stringify" or value == "nova_rt_type_of"
                        rtype = "str"
                    else if value == "nova_rt_list_create" or value == "nova_rt_list_append" or value == "nova_rt_list_concat" or value == "nova_rt_chars" or value == "nova_rt_range" or value == "nova_rt_range_from_to" or value == "nova_rt_list_sort" or value == "nova_rt_list_reverse" or value == "nova_rt_list_map" or value == "nova_rt_list_filter" or value == "nova_rt_list_slice" or value == "nova_rt_dict_keys" or value == "nova_rt_dict_values" or value == "nova_rt_dict_items" or value == "nova_rt_args"
                        rtype = "list"
                    else if value == "nova_rt_regex_split" or value == "nova_rt_split" or value == "nova_rt_enumerate" or value == "nova_rt_zip" or value == "nova_rt_list_dir" or value == "nova_rt_flatten" or value == "nova_rt_sort_by" or value == "nova_rt_pmap" or value == "nova_rt_pfilter" or value == "nova_rt_tensor_shape" or value == "nova_rt_tensor_to_list" or value == "nova_rt_iter_collect" or value == "nova_rt_str_to_bytes" or value == "nova_rt_list_create_filled" or value == "nova_rt_await_all" or value == "nova_rt_set_to_list" or value == "nova_rt_semver_parse"
                        rtype = "list"
                    else if value == "nova_rt_dict_create" or value == "nova_rt_dict_merge" or value == "nova_rt_lockfile_read" or value == "nova_rt_pkg_resolve"
                        rtype = "dict"
                    else if value == "nova_rt_sin" or value == "nova_rt_cos" or value == "nova_rt_tan" or value == "nova_rt_asin" or value == "nova_rt_acos" or value == "nova_rt_atan" or value == "nova_rt_atan2" or value == "nova_rt_log" or value == "nova_rt_log2" or value == "nova_rt_log10" or value == "nova_rt_exp" or value == "nova_rt_fabs" or value == "nova_rt_fmod" or value == "nova_rt_sqrt" or value == "nova_rt_pow" or value == "nova_rt_fmax" or value == "nova_rt_fmin" or value == "nova_rt_random_float" or value == "nova_rt_int_to_float" or value == "nova_rt_to_float" or value == "nova_rt_parse_float"
                        rtype = "float"
                    else if contains(frt, value)
                        rtype = frt[value]
                    if rtype == "any"
                        rtype = "val"
                    rt[dest] = rtype
                return inst
            else if op == "make_struct"
                if dest != ""
                    rt[dest] = "struct"
                return inst
            else if op == "make_list"
                if dest != ""
                    let ml_all_int = len(args) > 0
                    for ml_a in args
                        if ir_reg_type(rt, ml_a) != "int"
                            ml_all_int = false
                    if ml_all_int
                        rt[dest] = "intlist"
                    else
                        rt[dest] = "list"
                return inst
            else if op == "make_dict"
                if dest != ""
                    rt[dest] = "dict"
                return inst
            else if op == "index_get"
                let ig_nn = 0
                if len(args) > 1 and ir_reg_nn(rt, args[1]) == 1
                    ig_nn = 1
                if dest != ""
                    if ir_reg_type(rt, args[0]) == "intlist"
                        rt[dest] = "int"
                        return IrInst(op, dest, ir_type_int(), args, value, ig_nn, effect, line)
                    rt[dest] = "val"
                return IrInst(op, dest, typ, args, value, ig_nn, effect, line)
            else if op == "index_set"
                let is_nn = 0
                let is_marker = value
                if len(args) == 3
                    let isk = "@slot@" + args[0]
                    if contains(rt, isk)
                        let isslot = rt[isk]
                        if contains(st, isslot) and st[isslot] == "intlist"
                            if ir_reg_type(rt, args[2]) != "int"
                                st[isslot] = "list"
                    if ir_reg_nn(rt, args[1]) == 1
                        is_nn = 1
                    // Mark float/bool values so the emitter boxes them into the Any element slot.
                    if ir_reg_type(rt, args[2]) == "float"
                        is_marker = "fbox"
                    if ir_reg_type(rt, args[2]) == "bool"
                        is_marker = "bbox"
                return IrInst(op, dest, typ, args, is_marker, is_nn, effect, line)
            else if op == "field_get"
                if dest != ""
                    if value == "__type_hash"
                        rt[dest] = "int"
                    else
                        match typ
                            IrType(tk, tn, tp, tid) =>
                                if tk == "float"
                                    rt[dest] = "float"
                                else if tk == "int"
                                    rt[dest] = "int"
                                else if tk == "str"
                                    rt[dest] = "str"
                                else
                                    rt[dest] = "any"
                return inst
            else if op == "is_error"
                if dest != ""
                    rt[dest] = "int"
                return IrInst(op, dest, ir_type_int(), args, value, num, effect, line)
            else if op == "set_error"
                if dest != ""
                    rt[dest] = "any"
                return inst
            else if op == "load_error_msg"
                if dest != ""
                    rt[dest] = "str"
                return IrInst(op, dest, ir_type_str(), args, value, num, effect, line)
            else if op == "raise_error"
                return inst
            else if op == "clear_is_result"
                return inst
            else if op == "try_unwrap_value"
                if dest != ""
                    rt[dest] = "any"
                return inst
            else if op == "copy" and len(args) == 1
                let src_type = ir_reg_type(rt, args[0])
                let slot_key = "@slot@" + args[0]
                if contains(rt, slot_key)
                    let slot_nm = rt[slot_key]
                    if contains(st, slot_nm)
                        let stype = st[slot_nm]
                        if stype != "any"
                            src_type = stype
                if dest != ""
                    rt[dest] = src_type
                    if ir_reg_nn(rt, args[0]) == 1
                        rt["@nn@" + dest] = 1
                    if contains(rt, slot_key)
                        rt["@slot@" + dest] = rt[slot_key]
                let copy_itype = ir_type_any()
                if src_type == "float"
                    copy_itype = ir_type_float()
                else if src_type == "int"
                    copy_itype = ir_type_int()
                else if src_type == "str"
                    copy_itype = ir_type_str()
                return IrInst(op, dest, copy_itype, args, value, num, effect, line)
            return inst

fn ir_infer_block(rt: dict, st: dict, frt: dict, block: IrBlock) -> IrBlock
    match block
        IrBlock(label, insts, terminator) =>
            let new_insts = []
            for inst in insts
                push(new_insts, ir_infer_one(rt, st, frt, inst))
            IrBlock(label, new_insts, terminator)

fn ir_infer_types(func: IrFunction, frt: dict, fpt: dict) -> IrFunction
    match func
        IrFunction(name, params, ret_type, blocks, type_params, is_extern) =>
            if is_extern == 1
                return func
            let st = {}
            let new_params = []
            let pi = 0
            for p in params
                match p
                    IrParam(pname, ptype) =>
                        let ek = "any"
                        match ptype
                            IrType(tk, tn, tp, tid) =>
                                if tk == "int" or tk == "str" or tk == "list" or tk == "dict"
                                    ek = tk
                                else if contains(fpt, name)
                                    let pm = fpt[name]
                                    let pk = str(pi)
                                    if contains(pm, pk)
                                        ek = pm[pk]
                        st[pname] = ek
                        if ek != "any"
                            push(new_params, IrParam(pname, IrType(ek, "", [], 0)))
                        else
                            push(new_params, p)
                pi = pi + 1
            let pass_n = 0
            let new_blocks = []
            let converged = false
            while not converged and pass_n < 3
                pass_n = pass_n + 1
                let old_keys = keys(st)
                let old_vals = []
                for k in old_keys
                    push(old_vals, st[k])
                let rt = {}
                new_blocks = []
                for block in blocks
                    push(new_blocks, ir_infer_block(rt, st, frt, block))
                converged = true
                let i = 0
                while i < len(old_keys)
                    if contains(st, old_keys[i])
                        if st[old_keys[i]] != old_vals[i]
                            converged = false
                    i = i + 1
            IrFunction(name, new_params, ret_type, new_blocks, type_params, is_extern)

fn ir_analyze_return_type(func: IrFunction, frt: dict, fpt: dict) -> string
    match func
        IrFunction(name, params, ret_type, blocks, type_params, is_extern) =>
            let rt = {}
            let st = {}
            let pidx = 0
            for p in params
                match p
                    IrParam(pname, ptype) =>
                        match ptype
                            IrType(tk, tn, tp, tid) =>
                                if tk == "int" or tk == "str" or tk == "list" or tk == "dict"
                                    st[pname] = tk
                                else if contains(fpt, name) and contains(fpt[name], str(pidx))
                                    st[pname] = fpt[name][str(pidx)]
                                else
                                    st[pname] = "any"
                pidx = pidx + 1
            let pass_n = 0
            while pass_n < 3
                pass_n = pass_n + 1
                rt = {}
                for block in blocks
                    ir_infer_block(rt, st, frt, block)
            for block in blocks
                match block
                    IrBlock(label, insts, terminator) =>
                        match terminator
                            IrInst(top, tdest, ttyp, targs, tval, tnum, teff, tline) =>
                                if top == "return" and len(targs) > 0
                                    let rv = targs[0]
                                    if rv != "0" and contains(rt, rv)
                                        return rt[rv]
            "any"

fn ir_collect_param_types(all_fns: list, frt: dict) -> dict
    let fpt = {}
    for ir_fn in all_fns
        match ir_fn
            IrFunction(fname, fp, fret, fblocks, ftp, fex) =>
                if fex == 0
                    let rt = {}
                    let st = {}
                    for p in fp
                        match p
                            IrParam(pname, ptype) =>
                                match ptype
                                    IrType(tk, _, _, _) =>
                                        if tk == "int" or tk == "str" or tk == "list" or tk == "dict"
                                            st[pname] = tk
                                        else
                                            st[pname] = "any"
                    for block in fblocks
                        ir_infer_block(rt, st, frt, block)
                    for block in fblocks
                        match block
                            IrBlock(label, insts, terminator) =>
                                for inst in insts
                                    match inst
                                        IrInst(iop, idest, ityp, iargs, ival, inum, ieff, iline) =>
                                            if iop == "call"
                                                let callee = ival
                                                if not contains(fpt, callee)
                                                    fpt[callee] = {}
                                                let ai = 0
                                                while ai < len(iargs)
                                                    let atype = "any"
                                                    if contains(rt, iargs[ai])
                                                        atype = rt[iargs[ai]]
                                                    if atype != "any"
                                                        let akey = str(ai)
                                                        if contains(fpt[callee], akey)
                                                            if fpt[callee][akey] != atype
                                                                fpt[callee][akey] = "any"
                                                        else
                                                            fpt[callee][akey] = atype
                                                    ai = ai + 1
    fpt

// ── IR → LLVM Emission ───────────────────────────────────────────────────────

fn resolve_target(target: string) -> string
    if target == "" or target == "native" or target == "windows" or target == "win"
        return "x86_64-pc-windows-msvc"
    if target == "linux" or target == "linux-x64"
        return "x86_64-unknown-linux-gnu"
    if target == "linux-arm64" or target == "linux-aarch64"
        return "aarch64-unknown-linux-gnu"
    if target == "macos" or target == "darwin" or target == "macos-x64"
        return "x86_64-apple-darwin"
    if target == "macos-arm64" or target == "darwin-arm64"
        return "aarch64-apple-darwin"
    if target == "wasm" or target == "wasm32"
        return "wasm32-unknown-unknown"
    target

fn target_datalayout(triple: string) -> string
    if contains(triple, "windows")
        return "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
    if contains(triple, "apple")
        return "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
    if contains(triple, "wasm")
        return "e-m:e-p:32:32-p10:8:8-p20:8:8-i64:64-n32:64-S128-ni:1:10:20"
    "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"

fn target_is_windows(triple: string) -> int
    if contains(triple, "windows")
        return 1
    0

type IrEmitter
    ire_out: list
    ire_strs: list
    ire_smap: dict
    ire_sc: int
    ire_reg_types: dict
    ire_tc: int
    ire_filename: string
    ire_fn_lines: dict
    ire_dbg_counter: int
    ire_dbg_entries: list
    ire_dbg_loc: int
    ire_target: string
    ire_line_locs: dict
    ire_loc_entries: list
    ire_fn_sp_id: int

fn new_ir_emitter(filename: string, target: string) -> IrEmitter
    IrEmitter([], [], {}, 0, {}, 0, filename, {}, 200, [], 0, target, {}, [], 0)

// Mint or recycle a DILocation id for a given source line within the current
// function's scope. Returns 0 if no scope is active (debug info off for this
// function), in which case the caller falls back to the function-default loc.
fn ire_get_line_loc(e: IrEmitter, line_num: int) -> int
    if e.ire_fn_sp_id == 0 or line_num <= 0
        return 0
    let key = str(e.ire_fn_sp_id) + ":" + str(line_num)
    if contains(e.ire_line_locs, key)
        return e.ire_line_locs[key]
    let loc_id = e.ire_dbg_counter
    e.ire_dbg_counter = e.ire_dbg_counter + 1
    e.ire_line_locs[key] = loc_id
    push(e.ire_loc_entries, [loc_id, e.ire_fn_sp_id, line_num])
    loc_id

fn ire_fresh_tmp(e: IrEmitter, prefix: string) -> string
    let name = "%" + prefix + str(e.ire_tc)
    e.ire_tc = e.ire_tc + 1
    name

fn ire_line(e: IrEmitter, line: string)
    push(e.ire_out, line)

fn ire_indent(e: IrEmitter, line: string)
    if e.ire_dbg_loc > 0
        push(e.ire_out, "  " + line + ", !dbg !" + str(e.ire_dbg_loc))
    else
        push(e.ire_out, "  " + line)

fn ire_intern_string(e: IrEmitter, s: string) -> string
    if contains(e.ire_smap, s)
        return e.ire_smap[s]
    let escaped = llvm_escape_string(s)
    let name = "@.str." + str(e.ire_sc)
    e.ire_sc = e.ire_sc + 1
    let byte_len = len(s) + 1
    push(e.ire_strs, name + " = private unnamed_addr constant [" + str(byte_len) + " x i8] c\"" + escaped + "\\00\"")
    e.ire_smap[s] = name
    name

fn ire_emit_inst(e: IrEmitter, inst: IrInst)
    match inst
        IrInst(op, dest, typ, args, value, num, effect, line) =>
            let saved_loc = e.ire_dbg_loc
            if line > 0 and e.ire_fn_sp_id != 0
                let line_loc = ire_get_line_loc(e, line)
                if line_loc != 0
                    e.ire_dbg_loc = line_loc
            if op == "const_int"
                ire_indent(e, dest + " = add i64 " + str(num) + ", 0")
            else if op == "const_float"
                ire_indent(e, dest + " = add i64 " + str(num) + ", 0")
            else if op == "const_str"
                let str_name = ire_intern_string(e, value)
                let byte_len = len(value) + 1
                let ptr_reg = dest + ".p"
                ire_indent(e, ptr_reg + " = getelementptr inbounds [" + str(byte_len) + " x i8], ptr " + str_name + ", i64 0, i64 0")
                ire_indent(e, dest + " = ptrtoint ptr " + ptr_reg + " to i64")
            else if op == "add"
                match typ
                    IrType(tk, tn, tp, tid) =>
                        if tk == "float"
                            let af = dest + ".af"
                            let bf = dest + ".bf"
                            let rf = dest + ".rf"
                            if contains(value, "L")
                                ire_indent(e, af + " = sitofp i64 " + args[0] + " to double")
                            else
                                ire_indent(e, af + " = bitcast i64 " + args[0] + " to double")
                            if contains(value, "R")
                                ire_indent(e, bf + " = sitofp i64 " + args[1] + " to double")
                            else
                                ire_indent(e, bf + " = bitcast i64 " + args[1] + " to double")
                            ire_indent(e, rf + " = fadd double " + af + ", " + bf)
                            ire_indent(e, dest + " = bitcast double " + rf + " to i64")
                        else if tk == "int"
                            ire_indent(e, dest + " = add i64 " + args[0] + ", " + args[1])
                        else if tk == "str"
                            ire_indent(e, dest + " = call i64 @nova_rt_str_concat(i64 " + args[0] + ", i64 " + args[1] + ")")
                        else
                            ire_indent(e, dest + " = call i64 @nova_rt_add(i64 " + args[0] + ", i64 " + args[1] + ")")
            else if op == "sub"
                match typ
                    IrType(tk, tn, tp, tid) =>
                        if tk == "float"
                            let af = dest + ".af"
                            let bf = dest + ".bf"
                            let rf = dest + ".rf"
                            if contains(value, "L")
                                ire_indent(e, af + " = sitofp i64 " + args[0] + " to double")
                            else
                                ire_indent(e, af + " = bitcast i64 " + args[0] + " to double")
                            if contains(value, "R")
                                ire_indent(e, bf + " = sitofp i64 " + args[1] + " to double")
                            else
                                ire_indent(e, bf + " = bitcast i64 " + args[1] + " to double")
                            ire_indent(e, rf + " = fsub double " + af + ", " + bf)
                            ire_indent(e, dest + " = bitcast double " + rf + " to i64")
                        else if tk == "int"
                            ire_indent(e, dest + " = sub i64 " + args[0] + ", " + args[1])
                        else
                            ire_indent(e, dest + " = call i64 @nova_rt_sub(i64 " + args[0] + ", i64 " + args[1] + ")")
            else if op == "mul"
                match typ
                    IrType(tk, tn, tp, tid) =>
                        if tk == "float"
                            let af = dest + ".af"
                            let bf = dest + ".bf"
                            let rf = dest + ".rf"
                            if contains(value, "L")
                                ire_indent(e, af + " = sitofp i64 " + args[0] + " to double")
                            else
                                ire_indent(e, af + " = bitcast i64 " + args[0] + " to double")
                            if contains(value, "R")
                                ire_indent(e, bf + " = sitofp i64 " + args[1] + " to double")
                            else
                                ire_indent(e, bf + " = bitcast i64 " + args[1] + " to double")
                            ire_indent(e, rf + " = fmul double " + af + ", " + bf)
                            ire_indent(e, dest + " = bitcast double " + rf + " to i64")
                        else if tk == "int"
                            ire_indent(e, dest + " = mul i64 " + args[0] + ", " + args[1])
                        else
                            ire_indent(e, dest + " = call i64 @nova_rt_mul(i64 " + args[0] + ", i64 " + args[1] + ")")
            else if op == "div"
                match typ
                    IrType(tk, tn, tp, tid) =>
                        if tk == "float"
                            let af = dest + ".af"
                            let bf = dest + ".bf"
                            let rf = dest + ".rf"
                            if contains(value, "L")
                                ire_indent(e, af + " = sitofp i64 " + args[0] + " to double")
                            else
                                ire_indent(e, af + " = bitcast i64 " + args[0] + " to double")
                            if contains(value, "R")
                                ire_indent(e, bf + " = sitofp i64 " + args[1] + " to double")
                            else
                                ire_indent(e, bf + " = bitcast i64 " + args[1] + " to double")
                            ire_indent(e, rf + " = fdiv double " + af + ", " + bf)
                            ire_indent(e, dest + " = bitcast double " + rf + " to i64")
                        else if tk == "int"
                            ire_indent(e, dest + " = sdiv i64 " + args[0] + ", " + args[1])
                        else
                            ire_indent(e, dest + " = call i64 @nova_rt_div(i64 " + args[0] + ", i64 " + args[1] + ")")
            else if op == "mod"
                match typ
                    IrType(tk, tn, tp, tid) =>
                        if tk == "float"
                            let af = dest + ".af"
                            let bf = dest + ".bf"
                            let rf = dest + ".rf"
                            if contains(value, "L")
                                ire_indent(e, af + " = sitofp i64 " + args[0] + " to double")
                            else
                                ire_indent(e, af + " = bitcast i64 " + args[0] + " to double")
                            if contains(value, "R")
                                ire_indent(e, bf + " = sitofp i64 " + args[1] + " to double")
                            else
                                ire_indent(e, bf + " = bitcast i64 " + args[1] + " to double")
                            ire_indent(e, rf + " = frem double " + af + ", " + bf)
                            ire_indent(e, dest + " = bitcast double " + rf + " to i64")
                        else
                            ire_indent(e, dest + " = srem i64 " + args[0] + ", " + args[1])
            else if op == "neg"
                match typ
                    IrType(tk, tn, tp, tid) =>
                        if tk == "float"
                            let af = dest + ".af"
                            let rf = dest + ".rf"
                            ire_indent(e, af + " = bitcast i64 " + args[0] + " to double")
                            ire_indent(e, rf + " = fsub double -0.0, " + af)
                            ire_indent(e, dest + " = bitcast double " + rf + " to i64")
                        else
                            ire_indent(e, dest + " = sub i64 0, " + args[0])
            else if op == "eq"
                match typ
                    IrType(tk, tn, tp, tid) =>
                        if tk == "float"
                            let af = dest + ".af"
                            let bf = dest + ".bf"
                            let tmp = dest + ".cmp"
                            if contains(value, "L")
                                ire_indent(e, af + " = sitofp i64 " + args[0] + " to double")
                            else
                                ire_indent(e, af + " = bitcast i64 " + args[0] + " to double")
                            if contains(value, "R")
                                ire_indent(e, bf + " = sitofp i64 " + args[1] + " to double")
                            else
                                ire_indent(e, bf + " = bitcast i64 " + args[1] + " to double")
                            ire_indent(e, tmp + " = fcmp oeq double " + af + ", " + bf)
                            ire_indent(e, dest + " = zext i1 " + tmp + " to i64")
                        else if tk == "int"
                            let tmp = dest + ".cmp"
                            ire_indent(e, tmp + " = icmp eq i64 " + args[0] + ", " + args[1])
                            ire_indent(e, dest + " = zext i1 " + tmp + " to i64")
                        else if tk == "str"
                            let p0 = dest + ".p0"
                            let p1 = dest + ".p1"
                            let cmp = dest + ".sc"
                            let tmp = dest + ".cmp"
                            ire_indent(e, p0 + " = inttoptr i64 " + args[0] + " to ptr")
                            ire_indent(e, p1 + " = inttoptr i64 " + args[1] + " to ptr")
                            ire_indent(e, cmp + " = call i32 @strcmp(ptr " + p0 + ", ptr " + p1 + ")")
                            ire_indent(e, tmp + " = icmp eq i32 " + cmp + ", 0")
                            ire_indent(e, dest + " = zext i1 " + tmp + " to i64")
                        else
                            ire_indent(e, dest + " = call i64 @nova_rt_eq(i64 " + args[0] + ", i64 " + args[1] + ")")
            else if op == "neq"
                match typ
                    IrType(tk, tn, tp, tid) =>
                        if tk == "float"
                            let af = dest + ".af"
                            let bf = dest + ".bf"
                            let tmp = dest + ".cmp"
                            if contains(value, "L")
                                ire_indent(e, af + " = sitofp i64 " + args[0] + " to double")
                            else
                                ire_indent(e, af + " = bitcast i64 " + args[0] + " to double")
                            if contains(value, "R")
                                ire_indent(e, bf + " = sitofp i64 " + args[1] + " to double")
                            else
                                ire_indent(e, bf + " = bitcast i64 " + args[1] + " to double")
                            ire_indent(e, tmp + " = fcmp one double " + af + ", " + bf)
                            ire_indent(e, dest + " = zext i1 " + tmp + " to i64")
                        else if tk == "int"
                            let tmp = dest + ".cmp"
                            ire_indent(e, tmp + " = icmp ne i64 " + args[0] + ", " + args[1])
                            ire_indent(e, dest + " = zext i1 " + tmp + " to i64")
                        else if tk == "str"
                            let p0 = dest + ".p0"
                            let p1 = dest + ".p1"
                            let cmp = dest + ".sc"
                            let tmp = dest + ".cmp"
                            ire_indent(e, p0 + " = inttoptr i64 " + args[0] + " to ptr")
                            ire_indent(e, p1 + " = inttoptr i64 " + args[1] + " to ptr")
                            ire_indent(e, cmp + " = call i32 @strcmp(ptr " + p0 + ", ptr " + p1 + ")")
                            ire_indent(e, tmp + " = icmp ne i32 " + cmp + ", 0")
                            ire_indent(e, dest + " = zext i1 " + tmp + " to i64")
                        else
                            ire_indent(e, dest + " = call i64 @nova_rt_neq(i64 " + args[0] + ", i64 " + args[1] + ")")
            else if op == "lt"
                match typ
                    IrType(tk, tn, tp, tid) =>
                        if tk == "float"
                            let af = dest + ".af"
                            let bf = dest + ".bf"
                            let tmp = dest + ".cmp"
                            if contains(value, "L")
                                ire_indent(e, af + " = sitofp i64 " + args[0] + " to double")
                            else
                                ire_indent(e, af + " = bitcast i64 " + args[0] + " to double")
                            if contains(value, "R")
                                ire_indent(e, bf + " = sitofp i64 " + args[1] + " to double")
                            else
                                ire_indent(e, bf + " = bitcast i64 " + args[1] + " to double")
                            ire_indent(e, tmp + " = fcmp olt double " + af + ", " + bf)
                            ire_indent(e, dest + " = zext i1 " + tmp + " to i64")
                        else if tk == "str"
                            let p0 = dest + ".p0"
                            let p1 = dest + ".p1"
                            let sc = dest + ".sc"
                            let tmp = dest + ".cmp"
                            ire_indent(e, p0 + " = inttoptr i64 " + args[0] + " to ptr")
                            ire_indent(e, p1 + " = inttoptr i64 " + args[1] + " to ptr")
                            ire_indent(e, sc + " = call i32 @strcmp(ptr " + p0 + ", ptr " + p1 + ")")
                            ire_indent(e, tmp + " = icmp slt i32 " + sc + ", 0")
                            ire_indent(e, dest + " = zext i1 " + tmp + " to i64")
                        else
                            let tmp = dest + ".cmp"
                            ire_indent(e, tmp + " = icmp slt i64 " + args[0] + ", " + args[1])
                            ire_indent(e, dest + " = zext i1 " + tmp + " to i64")
            else if op == "le"
                match typ
                    IrType(tk, tn, tp, tid) =>
                        if tk == "float"
                            let af = dest + ".af"
                            let bf = dest + ".bf"
                            let tmp = dest + ".cmp"
                            if contains(value, "L")
                                ire_indent(e, af + " = sitofp i64 " + args[0] + " to double")
                            else
                                ire_indent(e, af + " = bitcast i64 " + args[0] + " to double")
                            if contains(value, "R")
                                ire_indent(e, bf + " = sitofp i64 " + args[1] + " to double")
                            else
                                ire_indent(e, bf + " = bitcast i64 " + args[1] + " to double")
                            ire_indent(e, tmp + " = fcmp ole double " + af + ", " + bf)
                            ire_indent(e, dest + " = zext i1 " + tmp + " to i64")
                        else if tk == "str"
                            let p0 = dest + ".p0"
                            let p1 = dest + ".p1"
                            let sc = dest + ".sc"
                            let tmp = dest + ".cmp"
                            ire_indent(e, p0 + " = inttoptr i64 " + args[0] + " to ptr")
                            ire_indent(e, p1 + " = inttoptr i64 " + args[1] + " to ptr")
                            ire_indent(e, sc + " = call i32 @strcmp(ptr " + p0 + ", ptr " + p1 + ")")
                            ire_indent(e, tmp + " = icmp sle i32 " + sc + ", 0")
                            ire_indent(e, dest + " = zext i1 " + tmp + " to i64")
                        else
                            let tmp = dest + ".cmp"
                            ire_indent(e, tmp + " = icmp sle i64 " + args[0] + ", " + args[1])
                            ire_indent(e, dest + " = zext i1 " + tmp + " to i64")
            else if op == "gt"
                match typ
                    IrType(tk, tn, tp, tid) =>
                        if tk == "float"
                            let af = dest + ".af"
                            let bf = dest + ".bf"
                            let tmp = dest + ".cmp"
                            if contains(value, "L")
                                ire_indent(e, af + " = sitofp i64 " + args[0] + " to double")
                            else
                                ire_indent(e, af + " = bitcast i64 " + args[0] + " to double")
                            if contains(value, "R")
                                ire_indent(e, bf + " = sitofp i64 " + args[1] + " to double")
                            else
                                ire_indent(e, bf + " = bitcast i64 " + args[1] + " to double")
                            ire_indent(e, tmp + " = fcmp ogt double " + af + ", " + bf)
                            ire_indent(e, dest + " = zext i1 " + tmp + " to i64")
                        else if tk == "str"
                            let p0 = dest + ".p0"
                            let p1 = dest + ".p1"
                            let sc = dest + ".sc"
                            let tmp = dest + ".cmp"
                            ire_indent(e, p0 + " = inttoptr i64 " + args[0] + " to ptr")
                            ire_indent(e, p1 + " = inttoptr i64 " + args[1] + " to ptr")
                            ire_indent(e, sc + " = call i32 @strcmp(ptr " + p0 + ", ptr " + p1 + ")")
                            ire_indent(e, tmp + " = icmp sgt i32 " + sc + ", 0")
                            ire_indent(e, dest + " = zext i1 " + tmp + " to i64")
                        else
                            let tmp = dest + ".cmp"
                            ire_indent(e, tmp + " = icmp sgt i64 " + args[0] + ", " + args[1])
                            ire_indent(e, dest + " = zext i1 " + tmp + " to i64")
            else if op == "ge"
                match typ
                    IrType(tk, tn, tp, tid) =>
                        if tk == "float"
                            let af = dest + ".af"
                            let bf = dest + ".bf"
                            let tmp = dest + ".cmp"
                            if contains(value, "L")
                                ire_indent(e, af + " = sitofp i64 " + args[0] + " to double")
                            else
                                ire_indent(e, af + " = bitcast i64 " + args[0] + " to double")
                            if contains(value, "R")
                                ire_indent(e, bf + " = sitofp i64 " + args[1] + " to double")
                            else
                                ire_indent(e, bf + " = bitcast i64 " + args[1] + " to double")
                            ire_indent(e, tmp + " = fcmp oge double " + af + ", " + bf)
                            ire_indent(e, dest + " = zext i1 " + tmp + " to i64")
                        else if tk == "str"
                            let p0 = dest + ".p0"
                            let p1 = dest + ".p1"
                            let sc = dest + ".sc"
                            let tmp = dest + ".cmp"
                            ire_indent(e, p0 + " = inttoptr i64 " + args[0] + " to ptr")
                            ire_indent(e, p1 + " = inttoptr i64 " + args[1] + " to ptr")
                            ire_indent(e, sc + " = call i32 @strcmp(ptr " + p0 + ", ptr " + p1 + ")")
                            ire_indent(e, tmp + " = icmp sge i32 " + sc + ", 0")
                            ire_indent(e, dest + " = zext i1 " + tmp + " to i64")
                        else
                            let tmp = dest + ".cmp"
                            ire_indent(e, tmp + " = icmp sge i64 " + args[0] + ", " + args[1])
                            ire_indent(e, dest + " = zext i1 " + tmp + " to i64")
            else if op == "not"
                let tmp = dest + ".cmp"
                ire_indent(e, tmp + " = icmp eq i64 " + args[0] + ", 0")
                ire_indent(e, dest + " = zext i1 " + tmp + " to i64")
            else if op == "and"
                let tmp = dest + ".cmp"
                ire_indent(e, tmp + " = icmp ne i64 " + args[0] + ", 0")
                let tmp2 = dest + ".cmp2"
                ire_indent(e, tmp2 + " = icmp ne i64 " + args[1] + ", 0")
                let tmp3 = dest + ".and"
                ire_indent(e, tmp3 + " = and i1 " + tmp + ", " + tmp2)
                ire_indent(e, dest + " = zext i1 " + tmp3 + " to i64")
            else if op == "or"
                let tmp = dest + ".cmp"
                ire_indent(e, tmp + " = icmp ne i64 " + args[0] + ", 0")
                let tmp2 = dest + ".cmp2"
                ire_indent(e, tmp2 + " = icmp ne i64 " + args[1] + ", 0")
                let tmp3 = dest + ".or"
                ire_indent(e, tmp3 + " = or i1 " + tmp + ", " + tmp2)
                ire_indent(e, dest + " = zext i1 " + tmp3 + " to i64")
            else if op == "bitand"
                ire_indent(e, dest + " = and i64 " + args[0] + ", " + args[1])
            else if op == "bitor"
                ire_indent(e, dest + " = or i64 " + args[0] + ", " + args[1])
            else if op == "bitxor"
                ire_indent(e, dest + " = xor i64 " + args[0] + ", " + args[1])
            else if op == "shl"
                ire_indent(e, dest + " = shl i64 " + args[0] + ", " + args[1])
            else if op == "shr"
                ire_indent(e, dest + " = ashr i64 " + args[0] + ", " + args[1])
            else if op == "bitnot"
                ire_indent(e, dest + " = xor i64 " + args[0] + ", -1")
            else if op == "slot_load"
                ire_indent(e, dest + " = load i64, ptr %slot." + value + ", align 8")
                let slot_key = "slot." + value
                if contains(e.ire_reg_types, slot_key)
                    e.ire_reg_types[dest] = e.ire_reg_types[slot_key]
            else if op == "slot_store"
                ire_indent(e, "store i64 " + args[0] + ", ptr %slot." + value + ", align 8")
                if contains(e.ire_reg_types, args[0])
                    e.ire_reg_types["slot." + value] = e.ire_reg_types[args[0]]
            else if op == "call"
                let call_inlined = false
                if value == "nova_rt_index_set" and len(args) == 3
                    let tgt_kind = ""
                    if contains(e.ire_reg_types, args[0])
                        tgt_kind = e.ire_reg_types[args[0]]
                    if tgt_kind == "list"
                        let lp = ire_fresh_tmp(e, "_iset.lp")
                        let dp = ire_fresh_tmp(e, "_iset.dp")
                        let ep = ire_fresh_tmp(e, "_iset.ep")
                        let szp = ire_fresh_tmp(e, "_iset.szp")
                        let sz = ire_fresh_tmp(e, "_iset.sz")
                        let neg = ire_fresh_tmp(e, "_iset.neg")
                        let adj = ire_fresh_tmp(e, "_iset.adj")
                        let fi = ire_fresh_tmp(e, "_iset.fi")
                        ire_indent(e, lp + " = inttoptr i64 " + args[0] + " to ptr")
                        ire_indent(e, dp + " = load ptr, ptr " + lp + ", align 8, !tbaa !2")
                        ire_indent(e, szp + " = getelementptr i64, ptr " + lp + ", i64 1")
                        ire_indent(e, sz + " = load i64, ptr " + szp + ", align 8, !tbaa !6")
                        ire_indent(e, neg + " = icmp slt i64 " + args[1] + ", 0")
                        ire_indent(e, adj + " = add i64 " + args[1] + ", " + sz)
                        ire_indent(e, fi + " = select i1 " + neg + ", i64 " + adj + ", i64 " + args[1])
                        ire_indent(e, ep + " = getelementptr i64, ptr " + dp + ", i64 " + fi)
                        ire_indent(e, "store i64 " + args[2] + ", ptr " + ep + ", align 8, !tbaa !4")
                        call_inlined = true
                if value == "nova_rt_index_get" and len(args) == 2
                    let tgt_kind = ""
                    if contains(e.ire_reg_types, args[0])
                        tgt_kind = e.ire_reg_types[args[0]]
                    if tgt_kind == "list"
                        let lp = dest + ".lp"
                        let dp = dest + ".dp"
                        let ep = dest + ".ep"
                        let szp = dest + ".szp"
                        let sz = dest + ".sz"
                        let neg = dest + ".neg"
                        let adj = dest + ".adj"
                        let fi = dest + ".fi"
                        ire_indent(e, lp + " = inttoptr i64 " + args[0] + " to ptr")
                        ire_indent(e, dp + " = load ptr, ptr " + lp + ", align 8, !tbaa !2")
                        ire_indent(e, szp + " = getelementptr i64, ptr " + lp + ", i64 1")
                        ire_indent(e, sz + " = load i64, ptr " + szp + ", align 8, !tbaa !6")
                        ire_indent(e, neg + " = icmp slt i64 " + args[1] + ", 0")
                        ire_indent(e, adj + " = add i64 " + args[1] + ", " + sz)
                        ire_indent(e, fi + " = select i1 " + neg + ", i64 " + adj + ", i64 " + args[1])
                        ire_indent(e, ep + " = getelementptr i64, ptr " + dp + ", i64 " + fi)
                        ire_indent(e, dest + ".lv = load i64, ptr " + ep + ", align 8, !tbaa !4")
                        ire_indent(e, dest + " = call i64 @nova_rt_unbox(i64 " + dest + ".lv)")
                        call_inlined = true
                if (value == "nova_rt_list_create" or value == "nova_rt_list_create_filled") and dest != ""
                    e.ire_reg_types[dest] = "list"
                if value == "nova_rt_for_iter_init" and len(args) == 1 and dest != ""
                    if contains(e.ire_reg_types, args[0])
                        if e.ire_reg_types[args[0]] == "list"
                            e.ire_reg_types[dest] = "list"
                if value == "nova_rt_dict_create" and dest != ""
                    e.ire_reg_types[dest] = "dict"
                if not call_inlined
                    let call_str = "call i64 @" + value + "("
                    let i = 0
                    while i < len(args)
                        if i > 0
                            call_str = call_str + ", "
                        call_str = call_str + "i64 " + args[i]
                        i = i + 1
                    call_str = call_str + ")"
                    if dest != ""
                        ire_indent(e, dest + " = " + call_str)
                    else
                        ire_indent(e, call_str)
            else if op == "make_struct"
                let size = (num + 1) * 8
                ire_indent(e, dest + ".ptr = call ptr @nova_rt_struct_alloc(i64 " + str(size) + ")")
                let hash_val = type_name_hash(value)
                let hash_gep = dest + ".thash"
                ire_indent(e, hash_gep + " = getelementptr i64, ptr " + dest + ".ptr, i64 0")
                ire_indent(e, "store i64 " + str(hash_val) + ", ptr " + hash_gep + ", align 8")
                let fi = 0
                while fi < len(args)
                    let gep = dest + ".f" + str(fi)
                    ire_indent(e, gep + " = getelementptr i64, ptr " + dest + ".ptr, i64 " + str(fi + 1))
                    ire_indent(e, "store i64 " + args[fi] + ", ptr " + gep + ", align 8")
                    fi = fi + 1
                ire_indent(e, dest + " = ptrtoint ptr " + dest + ".ptr to i64")
            else if op == "make_list"
                ire_indent(e, dest + " = call i64 @nova_rt_list_create()")
                let i = 0
                while i < len(args)
                    ire_indent(e, "call i64 @nova_rt_list_append(i64 " + dest + ", i64 " + args[i] + ")")
                    i = i + 1
                e.ire_reg_types[dest] = "list"
            else if op == "make_dict"
                ire_indent(e, dest + " = call i64 @nova_rt_dict_create()")
                e.ire_reg_types[dest] = "dict"
            else if op == "index_get"
                let target_kind = ""
                if contains(e.ire_reg_types, args[0])
                    target_kind = e.ire_reg_types[args[0]]
                if target_kind == "list"
                    let lp = dest + ".lp"
                    let dp = dest + ".dp"
                    let ep = dest + ".ep"
                    ire_indent(e, lp + " = inttoptr i64 " + args[0] + " to ptr")
                    ire_indent(e, dp + " = load ptr, ptr " + lp + ", align 8, !tbaa !2")
                    if num == 1
                        ire_indent(e, ep + " = getelementptr i64, ptr " + dp + ", i64 " + args[1])
                    else
                        let szp = dest + ".szp"
                        let sz = dest + ".sz"
                        let neg = dest + ".neg"
                        let adj = dest + ".adj"
                        let fi = dest + ".fi"
                        ire_indent(e, szp + " = getelementptr i64, ptr " + lp + ", i64 1")
                        ire_indent(e, sz + " = load i64, ptr " + szp + ", align 8, !tbaa !6")
                        ire_indent(e, neg + " = icmp slt i64 " + args[1] + ", 0")
                        ire_indent(e, adj + " = add i64 " + args[1] + ", " + sz)
                        ire_indent(e, fi + " = select i1 " + neg + ", i64 " + adj + ", i64 " + args[1])
                        ire_indent(e, ep + " = getelementptr i64, ptr " + dp + ", i64 " + fi)
                    ire_indent(e, dest + ".lv = load i64, ptr " + ep + ", align 8, !tbaa !4")
                    ire_indent(e, dest + " = call i64 @nova_rt_unbox(i64 " + dest + ".lv)")
                else if target_kind == "dict"
                    ire_indent(e, dest + " = call i64 @nova_rt_dict_get(i64 " + args[0] + ", i64 " + args[1] + ")")
                else
                    ire_indent(e, dest + " = call i64 @nova_rt_index_get(i64 " + args[0] + ", i64 " + args[1] + ")")
            else if op == "field_get"
                let ptr_name = dest + ".ptr"
                ire_indent(e, ptr_name + " = inttoptr i64 " + args[0] + " to ptr")
                let gep = dest + ".gep"
                ire_indent(e, gep + " = getelementptr i64, ptr " + ptr_name + ", i64 " + str(num))
                ire_indent(e, dest + " = load i64, ptr " + gep + ", align 8")
            else if op == "field_set"
                let ptr_name = dest + ".ptr"
                ire_indent(e, ptr_name + " = inttoptr i64 " + args[0] + " to ptr")
                let gep = dest + ".gep"
                ire_indent(e, gep + " = getelementptr i64, ptr " + ptr_name + ", i64 " + str(num))
                ire_indent(e, "store i64 " + args[1] + ", ptr " + gep + ", align 8")
            else if op == "index_set"
                let is_target_kind = ""
                if contains(e.ire_reg_types, args[0])
                    is_target_kind = e.ire_reg_types[args[0]]
                if is_target_kind == "list"
                    let is_lp = ire_fresh_tmp(e, "_is.lp")
                    let is_dp = ire_fresh_tmp(e, "_is.dp")
                    let is_ep = ire_fresh_tmp(e, "_is.ep")
                    ire_indent(e, is_lp + " = inttoptr i64 " + args[0] + " to ptr")
                    ire_indent(e, is_dp + " = load ptr, ptr " + is_lp + ", align 8, !tbaa !2")
                    if num == 1
                        ire_indent(e, is_ep + " = getelementptr i64, ptr " + is_dp + ", i64 " + args[1])
                    else
                        let is_szp = ire_fresh_tmp(e, "_is.szp")
                        let is_sz = ire_fresh_tmp(e, "_is.sz")
                        let is_neg = ire_fresh_tmp(e, "_is.neg")
                        let is_adj = ire_fresh_tmp(e, "_is.adj")
                        let is_fi = ire_fresh_tmp(e, "_is.fi")
                        ire_indent(e, is_szp + " = getelementptr i64, ptr " + is_lp + ", i64 1")
                        ire_indent(e, is_sz + " = load i64, ptr " + is_szp + ", align 8, !tbaa !6")
                        ire_indent(e, is_neg + " = icmp slt i64 " + args[1] + ", 0")
                        ire_indent(e, is_adj + " = add i64 " + args[1] + ", " + is_sz)
                        ire_indent(e, is_fi + " = select i1 " + is_neg + ", i64 " + is_adj + ", i64 " + args[1])
                        ire_indent(e, is_ep + " = getelementptr i64, ptr " + is_dp + ", i64 " + is_fi)
                    let is_sv = args[2]
                    if value == "fbox"
                        let is_bx = ire_fresh_tmp(e, "_is.bx")
                        ire_indent(e, is_bx + " = call i64 @nova_rt_box_float(i64 " + args[2] + ")")
                        is_sv = is_bx
                    if value == "bbox"
                        let is_bbx = ire_fresh_tmp(e, "_is.bbx")
                        ire_indent(e, is_bbx + " = call i64 @nova_rt_box_bool(i64 " + args[2] + ")")
                        is_sv = is_bbx
                    ire_indent(e, "store i64 " + is_sv + ", ptr " + is_ep + ", align 8, !tbaa !4")
                else if is_target_kind == "dict"
                    let is_dtmp = ire_fresh_tmp(e, "_is.dv")
                    let is_dfn = "nova_rt_dict_set"
                    if value == "fbox"
                        is_dfn = "nova_rt_dict_set_fbox"
                    if value == "bbox"
                        is_dfn = "nova_rt_dict_set_bbox"
                    ire_indent(e, is_dtmp + " = call i64 @" + is_dfn + "(i64 " + args[0] + ", i64 " + args[1] + ", i64 " + args[2] + ")")
                else
                    let is_gtmp = ire_fresh_tmp(e, "_is.gv")
                    let is_gv = args[2]
                    if value == "fbox"
                        let is_gbx = ire_fresh_tmp(e, "_is.gbx")
                        ire_indent(e, is_gbx + " = call i64 @nova_rt_box_float(i64 " + args[2] + ")")
                        is_gv = is_gbx
                    if value == "bbox"
                        let is_gbbx = ire_fresh_tmp(e, "_is.gbbx")
                        ire_indent(e, is_gbbx + " = call i64 @nova_rt_box_bool(i64 " + args[2] + ")")
                        is_gv = is_gbbx
                    ire_indent(e, is_gtmp + " = call i64 @nova_rt_index_set(i64 " + args[0] + ", i64 " + args[1] + ", i64 " + is_gv + ")")
            else if op == "list_len"
                let ll_lp = dest + ".lp"
                let ll_szp = dest + ".szp"
                ire_indent(e, ll_lp + " = inttoptr i64 " + args[0] + " to ptr")
                ire_indent(e, ll_szp + " = getelementptr i64, ptr " + ll_lp + ", i64 1")
                ire_indent(e, dest + " = load i64, ptr " + ll_szp + ", align 8, !tbaa !6")
            else if op == "copy"
                ire_indent(e, dest + " = add i64 " + args[0] + ", 0")
                if len(args) == 1 and contains(e.ire_reg_types, args[0])
                    e.ire_reg_types[dest] = e.ire_reg_types[args[0]]
            else if op == "make_closure"
                // Allocate closure record: [trampoline_ptr, cap0, cap1, ...]
                let record_size = (1 + num) * 8
                ire_indent(e, dest + ".ptr = call ptr @nova_rt_struct_alloc(i64 " + str(record_size) + ")")
                // Store trampoline function pointer at slot 0
                let tramp_gep = dest + ".tgep"
                ire_indent(e, tramp_gep + " = getelementptr i64, ptr " + dest + ".ptr, i64 0")
                let tramp_val = dest + ".tfn"
                ire_indent(e, tramp_val + " = ptrtoint ptr @" + value + " to i64")
                ire_indent(e, "store i64 " + tramp_val + ", ptr " + tramp_gep + ", align 8")
                // Store captures at slots 1, 2, ...
                let ci = 0
                while ci < len(args)
                    let cap_gep = dest + ".c" + str(ci)
                    ire_indent(e, cap_gep + " = getelementptr i64, ptr " + dest + ".ptr, i64 " + str(ci + 1))
                    ire_indent(e, "store i64 " + args[ci] + ", ptr " + cap_gep + ", align 8")
                    ci = ci + 1
                ire_indent(e, dest + " = ptrtoint ptr " + dest + ".ptr to i64")
            else if op == "dyn_call"
                // Dynamic closure call: args[0] = closure record, args[1..] = call arguments
                // num = number of actual arguments (excluding closure record)
                let rec_ptr = dest + ".rec"
                ire_indent(e, rec_ptr + " = inttoptr i64 " + args[0] + " to ptr")
                let fn_raw = dest + ".fnraw"
                ire_indent(e, fn_raw + " = load i64, ptr " + rec_ptr + ", align 8")
                let fn_ptr = dest + ".fnptr"
                ire_indent(e, fn_ptr + " = inttoptr i64 " + fn_raw + " to ptr")
                // Build call: fn_ptr(closure_record, arg0, arg1, ...)
                let call_str = "call i64 " + fn_ptr + "(i64 " + args[0]
                let ai = 1
                while ai < len(args)
                    call_str = call_str + ", i64 " + args[ai]
                    ai = ai + 1
                call_str = call_str + ")"
                if dest != ""
                    ire_indent(e, dest + " = " + call_str)
                else
                    ire_indent(e, call_str)
            else if op == "set_error"
                ire_indent(e, "store i64 1, ptr @__nova_error_flag")
                if len(args) > 0
                    ire_indent(e, "store i64 " + args[0] + ", ptr @__nova_error_msg")
                if dest != ""
                    ire_indent(e, dest + " = add i64 0, 0")
            else if op == "is_error"
                let flag_tmp = dest + ".fl"
                let cmp_tmp = dest + ".cmp"
                ire_indent(e, flag_tmp + " = load i64, ptr @__nova_error_flag")
                ire_indent(e, "store i64 0, ptr @__nova_error_flag")
                ire_indent(e, cmp_tmp + " = icmp ne i64 " + flag_tmp + ", 0")
                ire_indent(e, dest + " = zext i1 " + cmp_tmp + " to i64")
            else if op == "load_error_msg"
                let msg_tmp = dest + ".raw"
                ire_indent(e, msg_tmp + " = load i64, ptr @__nova_error_msg")
                ire_indent(e, "store i64 0, ptr @__nova_error_msg")
                ire_indent(e, dest + " = add i64 " + msg_tmp + ", 0")
            else if op == "raise_error"
                ire_indent(e, "store i64 1, ptr @__nova_error_flag")
            else if op == "clear_is_result"
                ire_indent(e, "call void @nova_rt_clear_is_result()")
            else if op == "try_unwrap_value"
                if dest != ""
                    ire_indent(e, dest + " = call i64 @nova_rt_try_unwrap_value(i64 " + args[0] + ")")
                else
                    ire_indent(e, "call i64 @nova_rt_try_unwrap_value(i64 " + args[0] + ")")
            e.ire_dbg_loc = saved_loc

fn ire_is_loop_header(label: string) -> int
    if contains(label, "for_body") or contains(label, "while_body")
        return 1
    return 0

fn ire_is_backedge(label: string) -> int
    if contains(label, "for_hdr") or contains(label, "while_hdr") or label == "tco_loop"
        return 1
    return 0

fn ire_emit_terminator(e: IrEmitter, term: IrInst)
    match term
        IrInst(op, dest, typ, args, value, num, effect, line) =>
            let saved_loc = e.ire_dbg_loc
            if line > 0 and e.ire_fn_sp_id != 0
                let line_loc = ire_get_line_loc(e, line)
                if line_loc != 0
                    e.ire_dbg_loc = line_loc
            if op == "return"
                if len(args) > 0
                    ire_indent(e, "ret i64 " + args[0])
                else
                    ire_indent(e, "ret i64 0")
            else if op == "goto"
                if ire_is_backedge(value) == 1
                    ire_indent(e, "br label %" + value)
                else
                    ire_indent(e, "br label %" + value)
            else if op == "branch"
                let cond_cmp = dest + ".br"
                let prof_hint = ""
                if ire_is_loop_header(value) == 1
                    prof_hint = ", !prof !90"
                if cond_cmp == ".br"
                    let cond_cmp2 = "%br_" + value
                    ire_indent(e, cond_cmp2 + " = icmp ne i64 " + args[0] + ", 0")
                    ire_indent(e, "br i1 " + cond_cmp2 + ", label %" + value + ", label %" + args[1] + prof_hint)
                else
                    ire_indent(e, cond_cmp + " = icmp ne i64 " + args[0] + ", 0")
                    ire_indent(e, "br i1 " + cond_cmp + ", label %" + value + ", label %" + args[1] + prof_hint)
            e.ire_dbg_loc = saved_loc

fn ire_collect_slots(blocks: list, param_names: list) -> list
    let slots = []
    for block in blocks
        match block
            IrBlock(label, insts, terminator) =>
                for inst in insts
                    match inst
                        IrInst(op, dest, typ, args, value, num, effect, line) =>
                            if (op == "slot_store" or op == "slot_load") and value != ""
                                if not list_contains(slots, value) and not list_contains(param_names, value)
                                    push(slots, value)
    slots

fn ire_emit_function(e: IrEmitter, func: IrFunction)
    // Reset per-function state
    e.ire_reg_types = {}
    e.ire_tc = 0
    match func
        IrFunction(name, params, ret_type, blocks, type_params, is_extern) =>
            if is_extern == 1
                let decl = "declare i64 @" + name + "("
                let i = 0
                while i < len(params)
                    if i > 0
                        decl = decl + ", "
                    decl = decl + "i64"
                    i = i + 1
                decl = decl + ") nounwind"
                ire_line(e, decl)
                return 0
            let header = "define i64 @" + name + "("
            let i = 0
            while i < len(params)
                if i > 0
                    header = header + ", "
                header = header + "i64 %p" + str(i)
                i = i + 1
            header = header + ") nounwind"
            let has_dbg = contains(e.ire_fn_lines, name)
            if has_dbg
                let sp_id = e.ire_dbg_counter
                let loc_id = e.ire_dbg_counter + 1
                e.ire_dbg_counter = e.ire_dbg_counter + 2
                push(e.ire_dbg_entries, [sp_id, loc_id, name, e.ire_fn_lines[name]])
                header = header + " !dbg !" + str(sp_id)
                // Per-line DILocations live in a fresh map per function so they
                // are scoped to this DISubprogram. Anything stale from a prior
                // function is discarded.
                e.ire_line_locs = {}
                e.ire_fn_sp_id = sp_id
            else
                e.ire_fn_sp_id = 0
            header = header + " \{"
            ire_line(e, header)
            if has_dbg
                e.ire_dbg_loc = e.ire_dbg_entries[len(e.ire_dbg_entries) - 1][1]
            // Collect param names for alloca exclusion
            let param_names = []
            let pi = 0
            while pi < len(params)
                match params[pi]
                    IrParam(pname, ptype) =>
                        push(param_names, pname)
                pi = pi + 1
            // Collect all local slot names (excluding params)
            let local_slots = ire_collect_slots(blocks, param_names)
            for block in blocks
                match block
                    IrBlock(label, insts, terminator) =>
                        ire_line(e, label + ":")
                        if label == "entry"
                            // Allocate param slots
                            let pi2 = 0
                            while pi2 < len(params)
                                match params[pi2]
                                    IrParam(pname, ptype) =>
                                        ire_indent(e, "%slot." + pname + " = alloca i64, align 8")
                                        ire_indent(e, "store i64 %p" + str(pi2) + ", ptr %slot." + pname + ", align 8")
                                        match ptype
                                            IrType(pk, _, _, _) =>
                                                if pk == "list" or pk == "intlist"
                                                    e.ire_reg_types["slot." + pname] = "list"
                                                else if pk == "dict"
                                                    e.ire_reg_types["slot." + pname] = "dict"
                                pi2 = pi2 + 1
                            // Allocate local variable slots
                            for slot_name in local_slots
                                ire_indent(e, "%slot." + slot_name + " = alloca i64, align 8")
                                ire_indent(e, "store i64 0, ptr %slot." + slot_name + ", align 8")
                        for inst in insts
                            ire_emit_inst(e, inst)
                        ire_emit_terminator(e, terminator)
            e.ire_dbg_loc = 0
            ire_line(e, "}")
            ire_line(e, "")

// ── Main Compiler Pipeline ───────────────────────────────────────────────────

fn compile(source: string) -> string
    let tokens = tokenize(source)
    let _cpe = []
    let stmts = parse_program(tokens, _cpe)
    let cg = new_codegen()

    // Separate functions from top-level statements
    let functions = []
    let top_stmts = []
    for s in stmts
        match s
            Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
                if tag == "fn"
                    push(functions, s)
                    push(cg.fn_names, name)
                else if tag == "type"
                    // Register struct fields and build field→index map
                    cg.struct_defs[name] = params
                    let fi = 0
                    for p in params
                        match p
                            Param(pname, ptype, pdefault) =>
                                cg.field_map[pname] = fi
                        fi = fi + 1
                else if tag != "import" and tag != "trait"
                    push(top_stmts, s)

    // Pass 1: Generate all string constants (by doing a dry-run or pre-scan)
    // For now, strings are interned during codegen

    // Emit module
    emit_module_header(cg)
    emit_runtime_declarations(cg)

    // Emit user functions
    for fn_stmt in functions
        emit_function(cg, fn_stmt)

    // Emit main
    emit_nova_main(cg, top_stmts)
    emit_main_entry(cg)

    // Emit string constants (at end, so we know all of them)
    emit_string_constants(cg)

    join(cg.output, "\n")

// ── IR-Based Compiler Pipeline ───────────────────────────────────────────────

fn compile_ir_core(source: string, base_dir: string) -> string
    compile_ir_core_named(source, base_dir, "<source>", "")

fn compile_ir_core_named(source: string, base_dir: string, filename: string, target: string) -> string
    let tokens = tokenize_file(source, filename)
    let parse_errors = []
    let stmts = parse_program(tokens, parse_errors)
    if len(parse_errors) > 0
        for perr in parse_errors
            print(perr)
        print("compilation failed: " + str(len(parse_errors)) + " error(s)")
        exit(1)

    // Split source into lines for error display
    let source_lines = split(source, "\n")

    // AST-level type inference (Hindley-Milner)
    let ti_state = ti_infer_program_named(stmts, source_lines, filename)
    if len(ti_state.ti_errors) > 0
        for err in ti_state.ti_errors
            print(err)
        print("compilation failed: " + str(len(ti_state.ti_errors)) + " error(s)")
        exit(1)

    let b = new_ir_builder()
    let resolved_target = resolve_target(target)
    let e = new_ir_emitter(filename, resolved_target)

    // Resolve and compile imported modules
    let import_ir_fns = resolve_and_compile_imports(b, stmts, base_dir)

    // Separate functions, types, and top-level statements
    let functions = []
    let top_stmts = []
    for s in stmts
        match s
            Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
                if tag == "fn"
                    push(functions, s)
                    let fn_name = name
                    if fn_name == "main"
                        fn_name = "nova_user_main"
                    push(b.ir_fnames, fn_name)
                    b.ir_fn_arity[fn_name] = len(params)
                    b.ir_fn_defaults[fn_name] = params
                    match expr
                        Expr(rtt, rtv, rtn, rtc, rtf, rtl) =>
                            if rtt == "rettype" and rtv != ""
                                let rt_base = rtv
                                let rt_lt = find(rtv, "<")
                                if rt_lt > 0
                                    rt_base = slice(rtv, 0, rt_lt)
                                b.ir_fn_returns[name] = rt_base
                    let dunder_pos = find(fn_name, "__")
                    if dunder_pos > 0
                        let method_suffix = fn_name[dunder_pos + 2:999999999]
                        b.ir_methods[method_suffix] = fn_name
                else if tag == "extern_fn"
                    push(b.ir_externs, s)
                    push(b.ir_fnames, name)
                    b.ir_fn_arity[name] = len(params)
                    // Decide if we need a marshaling wrapper based on declared types
                    let ext_ret_ll = "i64"
                    match expr
                        Expr(rxt, rxv, rxn, rxc, rxf, rxl) =>
                            if rxt == "rettype"
                                ext_ret_ll = ffi_llvm_type(rxv)
                    let ext_needs = ext_ret_ll != "i64"
                    if not ext_needs
                        for ep in params
                            match ep
                                Param(epn, ept, epd) =>
                                    if ffi_llvm_type(ept) != "i64"
                                        ext_needs = true
                    if ext_needs
                        b.ir_ffi_wrapped[name] = 1
                else if tag == "type"
                    b.ir_sdefs[name] = params
                    let fi = 1
                    for p in params
                        match p
                            Param(pname, ptype, pdefault) =>
                                b.ir_fmap[pname] = fi
                                b.ir_field_types[name + "." + pname] = ptype
                        fi = fi + 1
                else if tag == "enum"
                    for variant in body
                        match variant
                            Stmt(vtag, vname, vexpr, vbody, vparams, velse, vann, vln) =>
                                if vtag == "type"
                                    b.ir_sdefs[vname] = vparams
                                    let vfi = 1
                                    for vp in vparams
                                        match vp
                                            Param(vpname, vptype, vpdefault) =>
                                                b.ir_fmap[vpname] = vfi
                                                b.ir_field_types[vname + "." + vpname] = vptype
                                        vfi = vfi + 1
                else if tag != "import" and tag != "trait"
                    push(top_stmts, s)

    // Emit module header
    let dq = chr(34)
    ire_line(e, "; NOVA IR-Pipeline Compiler Output")
    ire_line(e, "target datalayout = " + dq + target_datalayout(e.ire_target) + dq)
    ire_line(e, "target triple = " + dq + e.ire_target + dq)
    ire_line(e, "")
    ire_line(e, "@__nova_error_flag = thread_local global i64 0")
    ire_line(e, "@__nova_error_msg = thread_local global i64 0")
    ire_line(e, "")

    // Emit runtime declarations with LLVM optimization attributes
    // readonly = function does not write memory (enables LICM, CSE, GVN)
    // willreturn = function always returns (enables dead code elimination)
    ire_line(e, "; Runtime declarations")
    ire_line(e, "declare i32 @puts(ptr) nounwind")
    ire_line(e, "declare i32 @printf(ptr, ...) nounwind")
    ire_line(e, "declare i32 @strcmp(ptr, ptr) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_list_create() nounwind")
    ire_line(e, "declare i64 @nova_rt_deep_copy(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_list_create_filled(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_list_append(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_list_append_fbox(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_list_append_bbox(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_box_bool(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_unbox(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_list_get(i64, i64) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_list_len(i64) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_dict_create() nounwind")
    ire_line(e, "declare i64 @nova_rt_dict_set(i64, i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_dict_set_fbox(i64, i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_dict_set_bbox(i64, i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_box_float(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_dict_get(i64, i64) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_dict_contains(i64, i64) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_str_concat(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_int_to_str(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_parse_int(i64) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_len(i64) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_len_any(i64) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_ord(i64) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_chr(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_contains(i64, i64) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_index_get(i64, i64) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_index_set(i64, i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_add(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_sub(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_mul(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_div(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_eq(i64, i64) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_neq(i64, i64) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_any_to_str(i64) nounwind")
    ire_line(e, "declare void @nova_rt_assert(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_read_file(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_write_file(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_args() nounwind")
    ire_line(e, "declare void @nova_rt_exit(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_split(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_join(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_upper(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_lower(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_trim(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_replace(i64, i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_starts_with(i64, i64) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_ends_with(i64, i64) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_print_any(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_print_bool(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_print_float(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_print_int(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_print_str(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_float_bits(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_float_to_str(i64) nounwind")
    ire_line(e, "declare ptr @nova_rt_struct_alloc(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_slice(i64, i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_slice_any(i64, i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_repeat(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_chars(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_time_ms() nounwind")
    ire_line(e, "declare i64 @nova_rt_sleep_ms(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_clock_ns() nounwind")
    ire_line(e, "declare i64 @nova_rt_type_of(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_range(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_range_from_to(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_dict_keys(i64) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_dict_values(i64) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_dict_items(i64) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_for_iter_init(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_dict_has(i64, i64) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_dict_del(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_system(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_exec(i64) nounwind")
