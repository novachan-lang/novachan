// NOVA FORGE v0.1 end-to-end demo. Imports the forge module, defines a
// handler that routes by (method, path), spawns the server, then drives
// 4 distinct HTTP requests through it. Each verifies a different leg of
// the framework: HTML root, JSON API, POST echo with body, 404 path.
import forge

fn route(method: string, path: string, body: string) -> string
    if method == "GET" and path == "/"
        return forge.html(200, "<h1>NOVA Forge v0.1</h1><p>It works!</p>")
    if method == "GET" and path == "/api/hello"
        return forge.json(200, "\{\"msg\":\"hello from forge\",\"ok\":true\}")
    if method == "POST" and path == "/api/echo"
        return forge.text(200, "echo: " + body)
    if method == "GET" and path == "/about"
        return forge.text(200, "NOVA Forge: pure-NOVA web framework")
    forge.text(404, "not found: " + path)

fn main()
    let port = 18891
    spawn fn()
        forge.serve_n(port, route, 4)
    sleep(300)

    let base = "http://127.0.0.1:" + str(port)

    // 1. HTML root — body content (http_get returns body only)
    let r1 = http_get(base + "/")
    if find(r1, "NOVA Forge v0.1") < 0
        print("FAIL 1 (GET /): " + r1)
        exit(1)
    if find(r1, "It works!") < 0
        print("FAIL 1 missing It works!: " + r1)
        exit(1)

    // 2. JSON API body
    let r2 = http_get(base + "/api/hello")
    if find(r2, "hello from forge") < 0
        print("FAIL 2 (GET /api/hello): " + r2)
        exit(1)
    if find(r2, "\"ok\":true") < 0
        print("FAIL 2 missing ok field: " + r2)
        exit(1)

    // 3. POST echo with body
    let r3 = http_post(base + "/api/echo", "test-body-payload", "text/plain")
    if find(r3, "echo: test-body-payload") < 0
        print("FAIL 3 (POST /api/echo): " + r3)
        exit(1)

    // 4. 404 — body should say "not found"
    let r4 = http_get(base + "/nonexistent")
    if find(r4, "not found: /nonexistent") < 0
        print("FAIL 4 body missing: " + r4)
        exit(1)

    print("FORGE v0.1 demo passed: routed 4 distinct request types (HTML, JSON, POST echo, 404) through pure-NOVA framework")
