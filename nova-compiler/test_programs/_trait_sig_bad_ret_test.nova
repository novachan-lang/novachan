// LOCK-3 negative: impl's RETURN type disagrees with the trait (trait -> string, impl -> int).
// Unsound under dynamic dispatch (runtime returns int reinterpreted as the trait's declared string).
// MUST be rejected at compile time (E1006 incompatible method signature).
trait Serialize
    fn encode(self) -> string

type Widget : Serialize
    id: int

fn Widget.encode() -> int
    self.id

fn main()
    let w = Widget(7)
    print(str(w.encode()))
