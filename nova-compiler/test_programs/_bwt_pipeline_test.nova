// _bwt_pipeline_test.nova — KAT for std/compress/bwt_pipeline
//
// Tests round-trip bwt_inverse(bwt_forward(x)[0], bwt_forward(x)[1]) == x
// for multiple inputs: empty, single byte, repetitive, "banana"-as-bytes,
// "TOBEORNOTTOBEORTOBEORNOT"-as-bytes, mixed bytes.
//
// Also verifies:
//   - Repetitive input groups like bytes together (BWT clustering property)
//   - The transform of a repetitive run produces sorted runs in last column

import std/compress/bwt_pipeline

// ── Helpers ──────────────────────────────────────────────────────────────────

fn bytes_eq(a, b) -> int
    if len(a) != len(b)
        return 0
    let i = 0
    let ok = 1
    while i < len(a)
        if a[i] != b[i]
            ok = 0
        i = i + 1
    ok

fn str_to_bytes(s) -> list
    let out = []
    let i = 0
    while i < len(s)
        push(out, ord(s[i]))
        i = i + 1
    out

fn bytes_to_str(b) -> string
    let out = ""
    let i = 0
    while i < len(b)
        out = out + chr(b[i])
        i = i + 1
    out

fn ckrt(label, input_bytes)
    let fwd = bwt_forward(input_bytes)
    let transformed = fwd[0]
    let pidx = fwd[1]
    let recovered = bwt_inverse(transformed, pidx)
    if bytes_eq(recovered, input_bytes) == 0
        print("FAIL " + label + ": round-trip mismatch")
        print("  input len=" + str(len(input_bytes)))
        print("  recovered len=" + str(len(recovered)))
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label, got, want)
    if bytes_eq(got, want) == 0
        print("FAIL " + label + ": bytes mismatch")
        exit(1)

fn main()
    // KAT 1: empty byte-list
    let empty = []
    ckrt("empty", empty)
    let fwd_empty = bwt_forward(empty)
    cki("empty-pidx", fwd_empty[1], 0)
    let inv_empty = bwt_inverse([], 0)
    cki("empty-inv-len", len(inv_empty), 0)

    // KAT 2: single byte
    let single = [65]
    ckrt("single-A", single)
    let fwd_single = bwt_forward(single)
    cki("single-pidx", fwd_single[1], 0)

    // KAT 3: "banana" as bytes [98,97,110,97,110,97]
    // BWT of "banana" = "nnbaaa", primary = 3
    // As bytes: [110,110,98,97,97,97], primary = 3
    let banana = str_to_bytes("banana")
    let fwd_b = bwt_forward(banana)
    let tb = fwd_b[0]
    let pb = fwd_b[1]
    cki("banana-primary", pb, 3)
    // transformed = [110,110,98,97,97,97]
    let want_b = [110, 110, 98, 97, 97, 97]
    ckb("banana-transform", tb, want_b)
    ckrt("banana-roundtrip", banana)

    // KAT 4: repetitive "aaaa" = [97,97,97,97]
    // BWT of "aaaa" = "aaaa", primary = 0
    let aaaa = [97, 97, 97, 97]
    let fwd_a = bwt_forward(aaaa)
    cki("aaaa-primary", fwd_a[1], 0)
    ckb("aaaa-transform", fwd_a[0], [97, 97, 97, 97])
    ckrt("aaaa-roundtrip", aaaa)

    // KAT 5: "TOBEORNOTTOBEORTOBEORNOT" as bytes
    let tobe = str_to_bytes("TOBEORNOTTOBEORTOBEORNOT")
    ckrt("TOBE-roundtrip", tobe)
    // BWT clustering property: repetitive input should have runs in transform
    // (We just verify round-trip; ratio test would need compressor)

    // KAT 6: mixed bytes including values > 127
    let mixed = [0, 1, 127, 128, 200, 255, 100, 50, 0, 200]
    ckrt("mixed-bytes-roundtrip", mixed)

    // KAT 7: single repeated byte (different value)
    let bbb = [66, 66, 66, 66, 66]
    let fwd_bbb = bwt_forward(bbb)
    ckrt("bbb-roundtrip", bbb)
    // All same byte -> transform = all same, primary 0
    cki("bbb-primary", fwd_bbb[1], 0)

    // KAT 8: "abracadabra" as bytes
    let abra = str_to_bytes("abracadabra")
    ckrt("abracadabra-roundtrip", abra)

    // KAT 9: longer text
    let longer = str_to_bytes("the quick brown fox jumps over")
    ckrt("longer-text-roundtrip", longer)

    // KAT 10: two distinct bytes alternating
    let alt = [65, 66, 65, 66, 65, 66]
    ckrt("alternating-roundtrip", alt)

    print("PASS _bwt_pipeline_test")
