import std/sketch/simhash

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // KAT 1: determinism — sh_hash of same tokens gives same result twice.
    let tokens_fox = ["the", "quick", "brown", "fox"]
    let h1 = sh_hash(tokens_fox)
    let h2 = sh_hash(tokens_fox)
    cki("sh_hash_determinism", h1, h2)

    // KAT 2: sh_hamming(h, h) == 0 (same hash, no bit differences).
    let hd = sh_hamming(h1, h1)
    cki("hamming_self", hd, 0)

    // KAT 3: sh_similar(h, h, 3) == true (distance 0 <= 3).
    let sim_self = sh_similar(h1, h1, 3)
    if sim_self == false
        print("FAIL similar_self: expected true")
        exit(1)

    // KAT 4: ordering — similar token sets have smaller distance than very different ones.
    // Similar: differ by 1 of 5 tokens.
    let tokens_similar = ["the", "quick", "brown", "fox", "jumps"]
    let tokens_base    = ["the", "quick", "brown", "fox", "walks"]
    // Very different: completely different vocabulary.
    let tokens_diff    = ["apple", "banana", "cherry", "dragon", "elephant"]
    let hs = sh_hash(tokens_similar)
    let hb = sh_hash(tokens_base)
    let hd2 = sh_hash(tokens_diff)
    let sim_dist = sh_hamming(hs, hb)
    let diff_dist = sh_hamming(hb, hd2)
    // Similar sets should have smaller (or equal) hamming distance than dissimilar.
    if sim_dist >= diff_dist
        // This is a probabilistic test; allow a graceful check.
        // If it fails, it indicates the hash isn't separating well.
        print("FAIL ordering: sim_dist=" + str(sim_dist) + " diff_dist=" + str(diff_dist) + " (similar should be smaller)")
        exit(1)

    // KAT 5: sh_distance_tokens is consistent with sh_hash + sh_hamming.
    let dist_via_fn = sh_distance_tokens(tokens_fox, tokens_fox)
    cki("distance_tokens_self", dist_via_fn, 0)

    // KAT 6: sh_of_text tokenizes on spaces correctly.
    let h_text = sh_of_text("the quick brown fox")
    let h_tokens = sh_hash(["the", "quick", "brown", "fox"])
    cki("of_text_vs_tokens", h_text, h_tokens)

    // KAT 7: sh_bit extracts correct bits.
    // For value 5 (binary 101), bit 0 = 1, bit 1 = 0, bit 2 = 1.
    cki("bit_0_of_5", sh_bit(5, 0), 1)
    cki("bit_1_of_5", sh_bit(5, 1), 0)
    cki("bit_2_of_5", sh_bit(5, 2), 1)
    cki("bit_3_of_5", sh_bit(5, 3), 0)

    // KAT 8: sh_weight_bit returns 1 or -1.
    let wb = sh_weight_bit("hello", 0)
    if wb != 1 and wb != (0 - 1)
        print("FAIL weight_bit_range: got=" + str(wb))
        exit(1)

    // KAT 9: empty token list -> hash 0.
    let h_empty = sh_hash([])
    cki("empty_hash", h_empty, 0)

    // KAT 10: identical-set distance via distance_tokens is 0.
    let d_ident = sh_distance_tokens(tokens_fox, tokens_fox)
    cki("distance_identical", d_ident, 0)

    print("PASS _simhash_test")

main()
