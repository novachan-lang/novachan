// 1.7 cycle detector — POSITIVE case: every cycle SHAPE the SCC pass must handle.
//
// Each cycle is built inside a function that RETURNS. That shape matters: on return the
// locals release their references, so the only thing keeping the nodes alive is each
// other. Roots gone, objects immortal -- the textbook RC leak.
//
// Expected: 6 objects in 3 distinct cycles (2-node + self-loop + 3-node).
type CycNode
    cn_id: int
    cn_next: CycNode

// (a) the classic two-node cycle
fn make_pair()
    let a = CycNode(1, null)
    let b = CycNode(2, null)
    a.cn_next = b
    b.cn_next = a

// (b) SELF-LOOP — an SCC of size 1. Tarjan reports singletons as non-cyclic unless the
// node has an edge to ITSELF, so this is the case that catches a missing self-loop check.
fn make_self()
    let s = CycNode(3, null)
    s.cn_next = s

// (c) a longer ring, to prove detection is not hard-coded to length 2
fn make_triangle()
    let x = CycNode(4, null)
    let y = CycNode(5, null)
    let z = CycNode(6, null)
    x.cn_next = y
    y.cn_next = z
    z.cn_next = x

fn main()
    make_pair()
    make_self()
    make_triangle()
    print("built 3 cycles: pair + self-loop + triangle")
