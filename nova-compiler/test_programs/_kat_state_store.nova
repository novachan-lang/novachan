import forge_state_store

fn main()
    let s = ss_new()
    s = ss_set(s, "user:1", "Alice")
    s = ss_set(s, "user:2", "Bob")
    s = ss_set(s, "counter", 42)

    assert(ss_get(s, "user:1") == "Alice", "get Alice")
    assert(ss_get(s, "counter") == 42, "get counter")
    assert(ss_get(s, "missing") == "", "missing empty")

    assert(ss_has(s, "user:1") == true, "has user:1")
    assert(ss_has(s, "missing") == false, "no missing")

    assert(ss_size(s) == 3, "3 entries")
    assert(ss_version(s) == 3, "version=3")

    let v1 = ss_version(s)
    s = ss_set(s, "user:3", "Charlie")
    let changes = ss_changes_since(s, v1)
    assert(len(changes) == 1, "1 change")
    assert(changes[0]["key"] == "user:3", "change key")

    let snap = ss_snapshot(s)
    assert(snap["user:1"] == "Alice", "snapshot Alice")
    assert(snap["counter"] == 42, "snapshot counter")

    assert(ss_get_or(s, "missing", "default") == "default", "get_or fallback")
    assert(ss_get_or(s, "user:1", "x") == "Alice", "get_or found")

    assert(ss_tx_count(s) == 4, "4 transactions")

    print("STATE-STORE KAT PASS")
