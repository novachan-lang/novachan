import forge_mtf
import forge_bwt

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn joinl(xs: list) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + ","
        out = out + str(xs[i])
        i = i + 1
    out

fn main()
    let fails = 0

    // exact small cases
    fails = fails + expect("enc_aaa", joinl(mtf_encode("aaa")), "97,0,0")
    fails = fails + expect("enc_ab", joinl(mtf_encode("ab")), "97,98")
    fails = fails + expect("enc_aba", joinl(mtf_encode("aba")), "97,98,1")
    fails = fails + expect("enc_aaaa", joinl(mtf_encode("aaaa")), "97,0,0,0")

    // BWT synergy: BWT of banana is "nnbaaa"; MTF turns its runs into zeros
    fails = fails + expect("enc_nnbaaa", joinl(mtf_encode("nnbaaa")), "110,0,99,99,0,0")

    // round-trips
    fails = fails + expect("rt_banana", mtf_decode(mtf_encode("banana")), "banana")
    fails = fails + expect("rt_miss", mtf_decode(mtf_encode("mississippi")), "mississippi")
    fails = fails + expect("rt_hello", mtf_decode(mtf_encode("hello world")), "hello world")
    fails = fails + expect("rt_single", mtf_decode(mtf_encode("Z")), "Z")
    fails = fails + expect("rt_empty", mtf_decode(mtf_encode("")), "")
    fails = fails + expect("rt_mixed", mtf_decode(mtf_encode("The Quick Brown Fox 123!")), "The Quick Brown Fox 123!")

    // full bzip2-style pipeline round-trip: BWT -> MTF -> (decode) -> inverse BWT
    let src = "abracadabra_abracadabra"
    let bt = bwt_transform(src)
    let mtf = mtf_encode(bt[0])
    let back_col = mtf_decode(mtf)
    let recovered = bwt_inverse(back_col, bt[1])
    fails = fails + expect("pipeline", recovered, src)

    if fails == 0
        print("forge_mtf: all passed")
    else
        print("forge_mtf: " + str(fails) + " FAILED")
