// kmpx.nova — Knuth-Morris-Pratt substring search (linear time, all matches).
//
// Finds every occurrence of a pattern in text in O(n+m) with NO backtracking —
// faster and more predictable than naive scan, and distinct from regex (rex) and
// globs (globx). Built on the KMP failure function (longest proper prefix that is
// also a suffix). Codepoint-correct. Reports overlapping matches.

fn _kmp_table(pat)
  let m = len(pat)
  let lps = []
  let z = 0
  while z < m
    push(lps, 0)
    z = z + 1
  let length = 0
  let i = 1
  while i < m
    if pat[i] == pat[length]
      length = length + 1
      lps[i] = length
      i = i + 1
    else
      if length > 0
        length = lps[length - 1]
      else
        lps[i] = 0
        i = i + 1
  lps

// every start index where pat occurs in text (overlapping matches included).
fn kmp_find_all(text_str, pat_str)
  let text = code_points(text_str)
  let pat = code_points(pat_str)
  let n = len(text)
  let m = len(pat)
  let out = []
  if m == 0
    return out
  let lps = _kmp_table(pat)
  let i = 0
  let j = 0
  while i < n
    if text[i] == pat[j]
      i = i + 1
      j = j + 1
      if j == m
        push(out, i - j)
        j = lps[j - 1]
    else
      if j > 0
        j = lps[j - 1]
      else
        i = i + 1
  out

fn kmp_count(text, pat)
  len(kmp_find_all(text, pat))

// first occurrence index, or -1 if absent.
fn kmp_find(text, pat)
  let all = kmp_find_all(text, pat)
  if len(all) > 0
    return all[0]
  0 - 1

// ── Tests ────────────────────────────────────────────────────────────

let m1 = kmp_find_all("abababab", "ab")
assert(len(m1) == 4, "ab occurs 4 times in abababab")
assert(m1[0] == 0, "at 0")
assert(m1[1] == 2, "at 2")
assert(m1[3] == 6, "at 6")
print("PASS: repeated matches")

// overlapping matches
let m2 = kmp_find_all("aaaa", "aa")
assert(len(m2) == 3, "aa overlaps 3 times in aaaa (0,1,2)")
assert(m2[0] == 0 and m2[1] == 1 and m2[2] == 2, "overlapping positions")
print("PASS: overlapping matches")

// the classic KMP stress pattern (failure function matters)
let m3 = kmp_find_all("ababcababcabc", "ababc")
assert(len(m3) == 2, "ababc twice")
assert(m3[0] == 0 and m3[1] == 5, "at 0 and 5")
print("PASS: KMP failure-function case")

assert(kmp_find("hello world", "world") == 6, "world at 6")
assert(kmp_find("hello world", "o") == 4, "first o at 4")
assert(kmp_find("abc", "xyz") == 0 - 1, "absent -> -1")
assert(kmp_count("mississippi", "ss") == 2, "ss twice in mississippi")
assert(kmp_count("mississippi", "issi") == 2, "issi overlaps twice")
print("PASS: find + count")

print("ALL PASS: kmpx — KMP substring search")
