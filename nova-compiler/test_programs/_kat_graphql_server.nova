import forge_graphql_server

fn _gql_query_str() -> string
    let lb = chr(123)
    let rb = chr(125)
    "query " + lb + " hello user " + lb + " name email " + rb + " " + rb

fn _gql_mutation_str() -> string
    let lb = chr(123)
    let rb = chr(125)
    "mutation " + lb + " createUser " + rb

fn _gql_bad_str() -> string
    let lb = chr(123)
    let rb = chr(125)
    lb + " nonexistent " + rb

fn main()
    let schema = gql_schema_new()
    schema = gql_add_type(schema, "Query", {"hello": "String", "user": "User", "users": "[User]"})
    schema = gql_add_type(schema, "User", {"id": "Int", "name": "String", "email": "String"})

    let q = gql_parse_query(_gql_query_str())
    assert(q["operation"] == "query", "op=query")
    assert(len(q["selections"]) == 2, "2 selections")
    assert(q["selections"][0]["name"] == "hello", "sel0=hello")
    assert(q["selections"][1]["name"] == "user", "sel1=user")
    assert(len(q["selections"][1]["sub"]) == 2, "user has 2 sub")

    let root = {"hello": "world", "user": {"id": 1, "name": "Alice", "email": "alice@test.com"}}
    let ctx = {}
    let result = gql_execute(schema, q, root, ctx)
    assert(result["data"]["hello"] == "world", "hello=world")
    assert(result["data"]["user"]["name"] == "Alice", "user.name")
    assert(result["data"]["user"]["email"] == "alice@test.com", "user.email")
    assert(len(result["errors"]) == 0, "no errors")

    let q2 = gql_parse_query(_gql_mutation_str())
    assert(q2["operation"] == "mutation", "op=mutation")

    let errors = gql_validate_query(schema, q)
    assert(len(errors) == 0, "valid query")

    let bad_q = gql_parse_query(_gql_bad_str())
    let bad_errors = gql_validate_query(schema, bad_q)
    assert(len(bad_errors) == 1, "1 error for unknown field")

    let types = gql_introspect_types(schema)
    assert(len(types) == 2, "2 types")

    let json = gql_to_json_response(result)
    assert(contains(json, "world"), "json has world")

    print("GRAPHQL-SERVER KAT PASS")
