import std/combinatorics/powerset

// cki — check integer equality
fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// list_eq — compare two int lists for equality
fn list_eq(a, b)
    if len(a) != len(b)
        return 0
    let i = 0
    while i < len(a)
        if a[i] != b[i]
            return 0
        i = i + 1
    1

// list_str — render int list as "[a,b,c]"
fn list_str(xs)
    let s = "["
    let i = 0
    while i < len(xs)
        if i > 0
            s = s + ","
        s = s + str(xs[i])
        i = i + 1
    s + "]"

fn ck_list(label, got, want)
    if list_eq(got, want) == 0
        print("FAIL " + label + ": got=" + list_str(got) + " want=" + list_str(want))
        exit(1)

// _sym_diff_size — number of elements in the symmetric difference of two int lists
// (elements that are in one but not both). For subsets of a small universe this is correct.
fn _sym_diff_size(a, b)
    let count = 0
    // elements in a but not b
    let i = 0
    while i < len(a)
        let found = 0
        let j = 0
        while j < len(b)
            if a[i] == b[j]
                found = 1
            j = j + 1
        if found == 0
            count = count + 1
        i = i + 1
    // elements in b but not a
    let bi = 0
    while bi < len(b)
        let found2 = 0
        let bj = 0
        while bj < len(a)
            if b[bi] == a[bj]
                found2 = 1
            bj = bj + 1
        if found2 == 0
            count = count + 1
        bi = bi + 1
    count

fn main()
    // --- ps_count ---
    cki("ps_count(0)", ps_count(0), 1)
    cki("ps_count(1)", ps_count(1), 2)
    cki("ps_count(3)", ps_count(3), 8)
    cki("ps_count(4)", ps_count(4), 16)

    // --- ps_size ---
    cki("ps_size(0)", ps_size(0), 0)
    cki("ps_size(1)", ps_size(1), 1)
    cki("ps_size(7)", ps_size(7), 3)
    cki("ps_size(5)", ps_size(5), 2)
    cki("ps_size(15)", ps_size(15), 4)

    // --- ps_iter_mask ---
    let items3 = [1, 2, 3]
    ck_list("iter_mask(0)", ps_iter_mask(items3, 0), [])
    ck_list("iter_mask(1)", ps_iter_mask(items3, 1), [1])
    ck_list("iter_mask(3)", ps_iter_mask(items3, 3), [1, 2])
    ck_list("iter_mask(7)", ps_iter_mask(items3, 7), [1, 2, 3])
    ck_list("iter_mask(6)", ps_iter_mask(items3, 6), [2, 3])

    // --- ps_all ---
    let all3 = ps_all(items3)
    cki("len(ps_all([1,2,3]))", len(all3), 8)

    // first subset is empty, last is full
    ck_list("ps_all_first", all3[0], [])
    ck_list("ps_all_last", all3[7], [1, 2, 3])

    // empty input -> one empty subset
    let all0 = ps_all([])
    cki("ps_all([])_len", len(all0), 1)
    ck_list("ps_all([])_0", all0[0], [])

    // single element input -> [[],[x]]
    let all1 = ps_all([42])
    cki("ps_all([42])_len", len(all1), 2)
    ck_list("ps_all([42])_0", all1[0], [])
    ck_list("ps_all([42])_1", all1[1], [42])

    // --- ps_gray_code ---
    // 2-bit Gray codes: [0,1,3,2]
    let gc2 = ps_gray_code(2)
    cki("gray_code(2)_len", len(gc2), 4)
    cki("gray_code(2)_0", gc2[0], 0)
    cki("gray_code(2)_1", gc2[1], 1)
    cki("gray_code(2)_2", gc2[2], 3)
    cki("gray_code(2)_3", gc2[3], 2)

    // 1-bit Gray codes: [0, 1]
    let gc1 = ps_gray_code(1)
    cki("gray_code(1)_0", gc1[0], 0)
    cki("gray_code(1)_1", gc1[1], 1)

    // 3-bit: verify adjacent codes differ by exactly 1 bit
    let gc3 = ps_gray_code(3)
    cki("gray_code(3)_len", len(gc3), 8)
    let gi = 0
    while gi < 7
        let diff = gc3[gi] ^ gc3[gi + 1]
        // diff should be a power of 2 (exactly one bit)
        cki("gray3_adj_" + str(gi), diff & (diff - 1), 0)
        gi = gi + 1

    // --- ps_gray ---
    // ps_gray([1,2,3]) should have 8 subsets
    let gray3 = ps_gray(items3)
    cki("ps_gray([1,2,3])_len", len(gray3), 8)

    // adjacent subsets in ps_gray differ by exactly 1 element
    let pgi = 0
    while pgi < 7
        let sd = _sym_diff_size(gray3[pgi], gray3[pgi + 1])
        cki("gray_adj_symmdiff_" + str(pgi), sd, 1)
        pgi = pgi + 1

    // --- ps_by_size ---
    // ps_by_size([1,2]) = [], [1], [2], [1,2]
    let bs2 = ps_by_size([1, 2])
    cki("ps_by_size([1,2])_len", len(bs2), 4)
    ck_list("ps_by_size_0", bs2[0], [])
    ck_list("ps_by_size_1", bs2[1], [1])
    ck_list("ps_by_size_2", bs2[2], [2])
    ck_list("ps_by_size_3", bs2[3], [1, 2])

    // ps_by_size([1,2,3]): size-0=1, size-1=3, size-2=3, size-3=1
    let bs3 = ps_by_size(items3)
    cki("ps_by_size3_len", len(bs3), 8)
    ck_list("bs3_first", bs3[0], [])
    ck_list("bs3_last", bs3[7], [1, 2, 3])
    // subsets at index 1,2,3 are the singletons
    cki("bs3_size_at_1", len(bs3[1]), 1)
    cki("bs3_size_at_2", len(bs3[2]), 1)
    cki("bs3_size_at_3", len(bs3[3]), 1)
    // subsets at index 4,5,6 are pairs
    cki("bs3_size_at_4", len(bs3[4]), 2)
    cki("bs3_size_at_5", len(bs3[5]), 2)
    cki("bs3_size_at_6", len(bs3[6]), 2)

    // --- ps_subset_sum_exists ---
    // [3,34,4,12,5,2] has subset summing to 9: {3,4,2} or {4,5} etc.
    cki("subset_sum_9", ps_subset_sum_exists([3, 34, 4, 12, 5, 2], 9), 1)

    // [1,2,5] cannot sum to 4 (only 1,2,3,5,6,7,8)
    cki("subset_sum_4_false", ps_subset_sum_exists([1, 2, 5], 4), 0)

    // trivial: empty set sums to 0
    cki("subset_sum_0_empty", ps_subset_sum_exists([], 0), 1)

    // sum of full set
    cki("subset_sum_full", ps_subset_sum_exists([1, 2, 3], 6), 1)

    // cannot reach 0 from positive elements (only via empty subset)
    cki("subset_sum_0_pos", ps_subset_sum_exists([1, 2, 3], 0), 1)

    // unreachable target
    cki("subset_sum_100", ps_subset_sum_exists([1, 2, 3], 100), 0)

    print("PASS _powerset_test")
