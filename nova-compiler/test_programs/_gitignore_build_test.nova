import std/devtool/gitignore_build

fn main()
    // --- gib_new ---
    let n1 = gib_new()
    if len(n1) != 0
        print("FAIL gib_new-empty: got len " + str(len(n1)) + " want 0")
        exit(1)

    // --- gib_add ---
    let p1 = gib_add(gib_new(), "*.log")
    if len(p1) != 1
        print("FAIL gib_add-len: got " + str(len(p1)) + " want 1")
        exit(1)
    if p1[0] != "*.log"
        print("FAIL gib_add-content: got " + p1[0] + " want *.log")
        exit(1)

    // --- gib_add_comment ---
    let p2 = gib_add_comment(gib_new(), "text")
    if p2[0] != "# text"
        print("FAIL gib_add_comment: got '" + p2[0] + "' want '# text'")
        exit(1)

    // --- gib_add_blank ---
    let p3 = gib_add_blank(gib_new())
    if len(p3) != 1
        print("FAIL gib_add_blank-len: got " + str(len(p3)) + " want 1")
        exit(1)
    if p3[0] != ""
        print("FAIL gib_add_blank-content: got '" + p3[0] + "' want ''")
        exit(1)

    // --- gib_add_negate ---
    let p4 = gib_add_negate(gib_new(), "foo")
    if p4[0] != "!foo"
        print("FAIL gib_add_negate: got '" + p4[0] + "' want '!foo'")
        exit(1)

    // --- gib_render ---
    let p5 = gib_new()
    p5 = gib_add(p5, "*.log")
    p5 = gib_add(p5, "*.tmp")
    let r5 = gib_render(p5)
    if r5 != "*.log\n*.tmp"
        print("FAIL gib_render: got '" + r5 + "' want '*.log\\n*.tmp'")
        exit(1)

    // --- gib_add_section: empty patterns -> no leading blank ---
    let sec_a = ["__pycache__/", "*.pyc"]
    let p6 = gib_add_section(gib_new(), "Python", sec_a)
    if len(p6) != 3
        print("FAIL gib_add_section-empty-len: got " + str(len(p6)) + " want 3")
        exit(1)
    if p6[0] != "# Python"
        print("FAIL gib_add_section-empty-header: got '" + p6[0] + "' want '# Python'")
        exit(1)
    if p6[1] != "__pycache__/" or p6[2] != "*.pyc"
        print("FAIL gib_add_section-empty-body")
        exit(1)

    // --- gib_add_section: non-empty patterns -> blank separator first ---
    let p7 = gib_add(gib_new(), "x")
    let sec_b = ["c"]
    p7 = gib_add_section(p7, "Node", sec_b)
    if len(p7) != 4
        print("FAIL gib_add_section-nonempty-len: got " + str(len(p7)) + " want 4")
        exit(1)
    if p7[0] != "x" or p7[1] != "" or p7[2] != "# Node" or p7[3] != "c"
        print("FAIL gib_add_section-nonempty-content")
        exit(1)

    // --- Full integration: two sections rendered ---
    let g = gib_new()
    let python_patterns = ["__pycache__/", "*.pyc"]
    let node_patterns = ["node_modules/", "*.log"]
    g = gib_add_section(g, "Python", python_patterns)
    g = gib_add_section(g, "Node", node_patterns)
    let text = gib_render(g)
    let want = "# Python\n__pycache__/\n*.pyc\n\n# Node\nnode_modules/\n*.log"
    if text != want
        print("FAIL gib-integration: got '" + text + "' want '" + want + "'")
        exit(1)

    print("PASS _gitignore_build_test")
