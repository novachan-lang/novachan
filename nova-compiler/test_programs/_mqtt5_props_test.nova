import std/net/mqtt5_props

// ── Assert helpers ────────────────────────────────────────────────────────────

fn assert_i(label, got, want)
    if got != want
        print("FAIL mqtt5_props " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn assert_s(label, got, want)
    if got != want
        print("FAIL mqtt5_props " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // ── KAT 1: encode [[0x21,10]] -> [3, 0x21, 0, 10] ───────────────────────
    // 0x21 = Receive-Maximum (u16)
    // property bytes: 0x21(1 byte id) + 0x00 0x0A (u16 value 10) = 3 bytes
    // output: varint(3)=3, then 0x21, 0x00, 0x0A
    let props1 = []
    let p1 = []
    push(p1, 0x21)
    push(p1, 10)
    push(props1, p1)
    let enc1 = mqtt5_prop_encode(props1)
    let enc1_len = len(enc1)
    assert_i("receive-max-len", enc1_len, 4)
    assert_i("receive-max-byte0", enc1[0], 3)
    assert_i("receive-max-byte1", enc1[1], 0x21)
    assert_i("receive-max-byte2", enc1[2], 0)
    assert_i("receive-max-byte3", enc1[3], 10)
    print("PASS mqtt5_props encode-receive-max")

    // ── KAT 2: empty props -> [0] ────────────────────────────────────────────
    let props_empty = []
    let enc_empty = mqtt5_prop_encode(props_empty)
    assert_i("empty-len", len(enc_empty), 1)
    assert_i("empty-byte0", enc_empty[0], 0)
    print("PASS mqtt5_props encode-empty")

    // ── KAT 3: decode round-trip for receive-max ─────────────────────────────
    let dec1_r = mqtt5_prop_decode(enc1, 0)
    let dec1 = dec1_r[0]
    let dec1_pos = dec1_r[1]
    assert_i("decode-rt-pos", dec1_pos, 4)
    let dec1_rm = dec1[0x21]
    assert_i("decode-rt-receive-max", dec1_rm, 10)
    print("PASS mqtt5_props decode-roundtrip")

    // ── KAT 4: Session-Expiry-Interval (0x11) = u32 ──────────────────────────
    // prop bytes: 0x11 + 4 bytes = 5 bytes; length varint = 5
    let props2 = []
    let p2 = []
    push(p2, 0x11)
    push(p2, 300)
    push(props2, p2)
    let enc2 = mqtt5_prop_encode(props2)
    // [5, 0x11, 0, 0, 1, 44]  (300 = 0x0000012C)
    assert_i("sei-byte0", enc2[0], 5)
    assert_i("sei-id", enc2[1], 0x11)
    assert_i("sei-val-b0", enc2[2], 0)
    assert_i("sei-val-b1", enc2[3], 0)
    assert_i("sei-val-b2", enc2[4], 1)
    assert_i("sei-val-b3", enc2[5], 44)
    let dec2_r = mqtt5_prop_decode(enc2, 0)
    let dec2 = dec2_r[0]
    let dec2_sei = dec2[0x11]
    assert_i("sei-decode", dec2_sei, 300)
    print("PASS mqtt5_props session-expiry")

    // ── KAT 5: Maximum-Packet-Size (0x27) = u32 ──────────────────────────────
    let props3 = []
    let p3 = []
    push(p3, 0x27)
    push(p3, 65536)
    push(props3, p3)
    let enc3 = mqtt5_prop_encode(props3)
    // 65536 = 0x00010000
    assert_i("mps-byte0", enc3[0], 5)
    assert_i("mps-id", enc3[1], 0x27)
    assert_i("mps-val-b0", enc3[2], 0)
    assert_i("mps-val-b1", enc3[3], 1)
    assert_i("mps-val-b2", enc3[4], 0)
    assert_i("mps-val-b3", enc3[5], 0)
    let dec3_r = mqtt5_prop_decode(enc3, 0)
    let dec3 = dec3_r[0]
    assert_i("mps-decode", dec3[0x27], 65536)
    print("PASS mqtt5_props max-packet-size")

    // ── KAT 6: User-Property (0x26) = two strings ────────────────────────────
    // "k"(1 char) "v"(1 char)
    // prop bytes: 0x26 + u16(1) + 'k' + u16(1) + 'v' = 1+2+1+2+1 = 7 bytes
    // length varint = 7
    let props4 = []
    let p4 = []
    push(p4, 0x26)
    let kv = []
    push(kv, "k")
    push(kv, "v")
    push(p4, kv)
    push(props4, p4)
    let enc4 = mqtt5_prop_encode(props4)
    assert_i("up-byte0", enc4[0], 7)
    assert_i("up-id", enc4[1], 0x26)
    // key: len=1 then 'k'=107
    assert_i("up-klen-hi", enc4[2], 0)
    assert_i("up-klen-lo", enc4[3], 1)
    assert_i("up-k", enc4[4], 107)
    // val: len=1 then 'v'=118
    assert_i("up-vlen-hi", enc4[5], 0)
    assert_i("up-vlen-lo", enc4[6], 1)
    assert_i("up-v", enc4[7], 118)
    let dec4_r = mqtt5_prop_decode(enc4, 0)
    let dec4 = dec4_r[0]
    let dec4_up = dec4[0x26]
    assert_i("up-decode-list-len", len(dec4_up), 1)
    let dec4_pair = dec4_up[0]
    assert_s("up-decode-key", dec4_pair[0], "k")
    assert_s("up-decode-val", dec4_pair[1], "v")
    print("PASS mqtt5_props user-property")

    // ── KAT 7: multiple properties together ──────────────────────────────────
    let props5 = []
    let pa = []
    push(pa, 0x21)
    push(pa, 100)
    let pb = []
    push(pb, 0x11)
    push(pb, 60)
    push(props5, pa)
    push(props5, pb)
    let enc5 = mqtt5_prop_encode(props5)
    // 0x21 -> 3 bytes; 0x11 -> 5 bytes; total = 8 bytes; length = 8
    assert_i("multi-len-varint", enc5[0], 8)
    assert_i("multi-total-len", len(enc5), 9)
    let dec5_r = mqtt5_prop_decode(enc5, 0)
    let dec5 = dec5_r[0]
    assert_i("multi-decode-rm", dec5[0x21], 100)
    assert_i("multi-decode-sei", dec5[0x11], 60)
    print("PASS mqtt5_props multi-props")

    // ── KAT 8: decode with offset (simulate properties mid-packet) ───────────
    // Prepend 3 bytes of padding before properties
    let padded = []
    push(padded, 0xFF)
    push(padded, 0xFF)
    push(padded, 0xFF)
    let i = 0
    while i < len(enc1)
        push(padded, enc1[i])
        i = i + 1
    let dec8_r = mqtt5_prop_decode(padded, 3)
    let dec8 = dec8_r[0]
    let dec8_next = dec8_r[1]
    assert_i("offset-decode-rm", dec8[0x21], 10)
    assert_i("offset-decode-pos", dec8_next, 7)
    print("PASS mqtt5_props decode-with-offset")

    print("PASS _mqtt5_props_test")
