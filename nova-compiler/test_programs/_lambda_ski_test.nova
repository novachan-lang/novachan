import std/lambda/lambda_ski

// Integer check helper.
fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// Bool check helper.
fn ckb(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// Structural term equality check helper.
fn ckt(label, a, b)
    if lambda_ski.lsk_term_eq(a, b) == 0
        print("FAIL " + label + ": terms not equal")
        exit(1)

fn main()
    // KAT 1: normalize(app(app(app(S,K),K), var(7))) == var(7)
    // SKK = I, so (SKK) x = x
    let skk_x = lambda_ski.lsk_app(lambda_ski.lsk_app(lambda_ski.lsk_app(lambda_ski.lsk_S(), lambda_ski.lsk_K()), lambda_ski.lsk_K()), lambda_ski.lsk_var(7))
    let r1 = lambda_ski.lsk_reduce(skk_x, 10000)
    ckt("SKKx=x", r1, lambda_ski.lsk_var(7))

    // KAT 2: normalize(app(app(K, var(3)), var(9))) == var(3)
    let kab = lambda_ski.lsk_app(lambda_ski.lsk_app(lambda_ski.lsk_K(), lambda_ski.lsk_var(3)), lambda_ski.lsk_var(9))
    let r2 = lambda_ski.lsk_reduce(kab, 10000)
    ckt("Kab=a", r2, lambda_ski.lsk_var(3))

    // KAT 3: normalize(app(I, var(5))) == var(5)
    let ix = lambda_ski.lsk_app(lambda_ski.lsk_I(), lambda_ski.lsk_var(5))
    let r3 = lambda_ski.lsk_reduce(ix, 10000)
    ckt("Ix=x", r3, lambda_ski.lsk_var(5))

    // KAT 4: bracket-abstracting the identity then applying to a var normalizes to that var
    // lsk_abstract(I) should produce a SKI term that behaves like I
    let ident = lambda_ski.lsk_I()
    let abstracted = lambda_ski.lsk_abstract(ident)
    // Apply abstracted identity to var(2) and normalize
    let app_abs = lambda_ski.lsk_app(abstracted, lambda_ski.lsk_var(2))
    let r4 = lambda_ski.lsk_reduce(app_abs, 10000)
    ckt("abstract(I) x = x", r4, lambda_ski.lsk_var(2))

    // KAT 5: term_eq basic checks
    cki("term_eq var same", lambda_ski.lsk_term_eq(lambda_ski.lsk_var(3), lambda_ski.lsk_var(3)), 1)
    cki("term_eq var diff", lambda_ski.lsk_term_eq(lambda_ski.lsk_var(3), lambda_ski.lsk_var(4)), 0)
    cki("term_eq tag diff", lambda_ski.lsk_term_eq(lambda_ski.lsk_var(0), lambda_ski.lsk_I()), 0)

    // KAT 6: NESTED-lambda bracket abstraction (regression for the S(KK)I fix).
    // abstract(K) applied to a,b must reduce to a; abstract(S) applied to f,g,x must
    // reduce like S. The abstracted form must behave identically to the original term.
    let va = lambda_ski.lsk_var(100)
    let vb = lambda_ski.lsk_var(101)
    let vc = lambda_ski.lsk_var(102)
    // K = lam lam var1
    let kterm = lambda_ski.lsk_lam(lambda_ski.lsk_lam(lambda_ski.lsk_var(1)))
    let kabs = lambda_ski.lsk_abstract(kterm)
    let kapp = lambda_ski.lsk_app(lambda_ski.lsk_app(kabs, va), vb)
    ckt("abstract(K) a b = a", lambda_ski.lsk_reduce(kapp, 100000), va)
    // S combinator behaves like S after abstraction
    let sterm = lambda_ski.lsk_S()
    let sabs = lambda_ski.lsk_abstract(sterm)
    let sapp = lambda_ski.lsk_app(lambda_ski.lsk_app(lambda_ski.lsk_app(sabs, va), vb), vc)
    let swant = lambda_ski.lsk_app(lambda_ski.lsk_app(va, vc), lambda_ski.lsk_app(vb, vc))
    ckt("abstract(S) f g x = f x (g x)", lambda_ski.lsk_reduce(sapp, 100000), swant)

    print("PASS _lambda_ski_test")

main()
