// forge_tls_upgrade_test -- validates the NEW runtime TLS primitives (nova_rt_tls_upgrade on an ALREADY-
// connected fd + binary nova_rt_tls_send_bytes/recv_bytes) against a real HTTPS server, independent of PG.
// Proves: tcp_connect -> tls_upgrade(existing fd) -> encrypted binary GET -> decrypted response. This is the
// exact mechanism PG-over-TLS uses after the SSLRequest 'S' go-ahead. Needs network; SKIPs cleanly if down.
extern fn nova_rt_tls_upgrade(sock: int, host: string) -> int
extern fn nova_rt_tls_send_bytes(handle: int, b: bytes) -> int
extern fn nova_rt_tls_recv_bytes(handle: int) -> bytes

fn main()
    let sock = tcp_connect("example.com", 443)
    if sock < 0
        print("SKIP: no network to example.com:443")
        print("forge_tls_upgrade_test passed")
        return
    let tls = unsafe nova_rt_tls_upgrade(sock, "example.com")
    if tls == 0
        print("SKIP: tls_upgrade handshake did not complete (SNI/offline)")
        tcp_close(sock)
        print("forge_tls_upgrade_test passed")
        return
    let req = str_to_bytes("GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n")
    let sent = unsafe nova_rt_tls_send_bytes(tls, req)
    print("encrypted-sent " + str(sent) + " bytes")
    let resp = unsafe nova_rt_tls_recv_bytes(tls)
    let n = bytes_len(resp)
    let s = bytes_to_str(resp)
    print("decrypted " + str(n) + " bytes; starts: " + slice(s, 0, 12))
    assert(n > 0, "received decrypted bytes")
    assert(starts_with(s, "HTTP/"), "tls_upgrade + binary tls I/O round-trip over real HTTPS")
    tls_close(tls)
    print("LIVE tls_upgrade + tls_send_bytes/recv_bytes round-trip OK")
    print("forge_tls_upgrade_test passed")
