// forge_tls_upgrade_test -- validates the runtime TLS primitives (nova_rt_tls_upgrade on an ALREADY-connected
// fd + binary nova_rt_tls_send_bytes/recv_bytes), INCLUDING verify-full (cert chain + hostname validation).
// Three live checks (skip cleanly if offline):
//   (1) verify=0 (encrypt-only) to example.com:443 -> handshake + encrypted GET -> decrypted HTTP/1.1 200.
//   (2) verify=1 (verify-full) to example.com:443 -> ACCEPTS (valid public cert chain + hostname).
//   (3) verify=1 (verify-full) to a host with a BAD cert -> REJECTS (tls_upgrade returns 0). This is the
//       MITM-safety proof: a self-signed / expired / wrong-host cert must NOT be accepted.
extern fn nova_rt_tls_upgrade(sock: int, host: string, verify: int) -> int
extern fn nova_rt_tls_send_bytes(handle: int, b: bytes) -> int
extern fn nova_rt_tls_recv_bytes(handle: int) -> bytes

fn _https_get(host: string, verify: int) -> int
    let sock = tcp_connect(host, 443)
    if sock < 0
        return 0 - 2
    let tls = unsafe nova_rt_tls_upgrade(sock, host, verify)
    if tls == 0
        tcp_close(sock)
        return 0 - 1
    let req = str_to_bytes("GET / HTTP/1.1\r\nHost: " + host + "\r\nConnection: close\r\n\r\n")
    let sent = unsafe nova_rt_tls_send_bytes(tls, req)
    let resp = unsafe nova_rt_tls_recv_bytes(tls)
    let n = bytes_len(resp)
    tls_close(tls)
    if sent > 0 and n > 0 and starts_with(bytes_to_str(resp), "HTTP/")
        return 1
    return 0

fn main()
    let r0 = _https_get("example.com", 0)
    if r0 == (0 - 2)
        print("SKIP: no network")
        print("forge_tls_upgrade_test passed")
        return
    assert_eq(r0, 1)
    print("OK (1) verify=0 encrypted round-trip over real HTTPS (example.com)")

    let r1 = _https_get("example.com", 1)
    assert_eq(r1, 1)
    print("OK (2) verify-full ACCEPTED example.com (valid chain + hostname)")

    let r2 = _https_get("self-signed.badssl.com", 1)
    if r2 == (0 - 2)
        print("SKIP (3): self-signed.badssl.com unreachable -- cannot test rejection")
    else
        assert_eq(r2, 0 - 1)
        print("OK (3) verify-full REJECTED self-signed.badssl.com (MITM-safe)")

    print("forge_tls_upgrade_test passed")
