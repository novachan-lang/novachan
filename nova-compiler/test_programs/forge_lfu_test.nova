import forge_lfu

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // frequency-based eviction: 'a' is used more, 'b' evicted
    let c = lfu_new(2)
    lfu_put(c, "a", 1)
    lfu_put(c, "b", 2)
    lfu_get(c, "a")
    lfu_put(c, "c", 3)
    fails = fails + expect("size", str(lfu_size(c)), "2")
    fails = fails + expect("has_a", str(lfu_contains(c, "a")), "true")
    fails = fails + expect("has_b", str(lfu_contains(c, "b")), "false")
    fails = fails + expect("has_c", str(lfu_contains(c, "c")), "true")
    let ga = lfu_get(c, "a")
    fails = fails + expect("get_a", str(ga[0]) + ":" + str(ga[1]), "1:1")
    let gb = lfu_get(c, "b")
    fails = fails + expect("get_b_miss", str(gb[0]), "0")

    // tie-break by least-recently-used: both freq 1, 'a' older -> evicted
    let c2 = lfu_new(2)
    lfu_put(c2, "a", 1)
    lfu_put(c2, "b", 2)
    lfu_put(c2, "d", 4)
    fails = fails + expect("tie_a_out", str(lfu_contains(c2, "a")), "false")
    fails = fails + expect("tie_b_in", str(lfu_contains(c2, "b")), "true")
    fails = fails + expect("tie_d_in", str(lfu_contains(c2, "d")), "true")

    // updating an existing key does not evict
    let c3 = lfu_new(2)
    lfu_put(c3, "x", 1)
    lfu_put(c3, "y", 2)
    lfu_put(c3, "x", 10)
    fails = fails + expect("update_size", str(lfu_size(c3)), "2")
    let gx = lfu_get(c3, "x")
    fails = fails + expect("update_val", str(gx[1]), "10")

    // frequency counting
    let c4 = lfu_new(3)
    lfu_put(c4, "k", 1)
    lfu_get(c4, "k")
    lfu_get(c4, "k")
    // freq = 1 (put) + 2 (gets) + 1 (the get above via gx? no separate) = 3
    fails = fails + expect("freq", str(lfu_freq(c4, "k")), "3")
    fails = fails + expect("freq_absent", str(lfu_freq(c4, "zzz")), "0")

    // a hot key survives many evictions
    let c5 = lfu_new(2)
    lfu_put(c5, "hot", 1)
    let w = 0
    while w < 5
        lfu_get(c5, "hot")
        w = w + 1
    lfu_put(c5, "p", 2)
    lfu_put(c5, "q", 3)
    lfu_put(c5, "r", 4)
    fails = fails + expect("hot_survives", str(lfu_contains(c5, "hot")), "true")

    if fails == 0
        print("forge_lfu: all passed")
    else
        print("forge_lfu: " + str(fails) + " FAILED")
