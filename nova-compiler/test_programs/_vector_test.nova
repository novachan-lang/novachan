// KAT for std/math/vector — N-d float vector ops (epsilon compares).
import std/math/vector

fn _veps(a: float, b: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d <= 0.001

fn _vleq(label: string, got: any, want: any)
    if len(got) != len(want)
        print("FAIL " + label + ": len " + str(len(got)) + " != " + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        if not _veps(got[i] * 1.0, want[i] * 1.0)
            print("FAIL " + label + " [" + str(i) + "]: " + str(got[i]) + " != " + str(want[i]))
            exit(1)
        i = i + 1

fn ckf(label: string, got: float, want: float)
    if not _veps(got, want)
        print("FAIL " + label + ": " + str(got) + " != " + str(want))
        exit(1)

fn main()
    _vleq("add", vec_add([1, 2], [3, 4]), [4.0, 6.0])
    _vleq("sub", vec_sub([5, 5], [1, 2]), [4.0, 3.0])
    _vleq("scale", vec_scale([1, 2, 3], 2.0), [2.0, 4.0, 6.0])
    ckf("dot", vec_dot([1, 2], [3, 4]), 11.0)
    ckf("length", vec_length([3, 4]), 5.0)
    _vleq("normalize", vec_normalize([3, 4]), [0.6, 0.8])
    _vleq("cross", vec_cross([1, 0, 0], [0, 1, 0]), [0.0, 0.0, 1.0])
    ckf("length0", vec_length([0, 0]), 0.0)
    print("_vector_test passed")
