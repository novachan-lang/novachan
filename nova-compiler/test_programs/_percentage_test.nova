import std/numeric/percentage

fn main()
    // KAT 1: pc_of(20.0, 50.0) == 10.0
    let r1 = pc_of(20.0, 50.0)
    let d1 = r1 - 10.0
    if d1 < 0.0
        d1 = d1 * -1.0
    if d1 > 0.001
        print("FAIL KAT1 pc_of(20,50): got " + str(r1) + " expected 10.0")
        exit(1)

    // KAT 2: pc_what_percent(10.0, 50.0) == 20.0
    let r2 = pc_what_percent(10.0, 50.0)
    let d2 = r2 - 20.0
    if d2 < 0.0
        d2 = d2 * -1.0
    if d2 > 0.001
        print("FAIL KAT2 pc_what_percent(10,50): got " + str(r2) + " expected 20.0")
        exit(1)

    // KAT 3: pc_change(100.0, 150.0) == 50.0
    let r3 = pc_change(100.0, 150.0)
    let d3 = r3 - 50.0
    if d3 < 0.0
        d3 = d3 * -1.0
    if d3 > 0.001
        print("FAIL KAT3 pc_change(100,150): got " + str(r3) + " expected 50.0")
        exit(1)

    // KAT 4: pc_change(100.0, 80.0) == -20.0
    let r4 = pc_change(100.0, 80.0)
    let d4 = r4 - (-20.0)
    if d4 < 0.0
        d4 = d4 * -1.0
    if d4 > 0.001
        print("FAIL KAT4 pc_change(100,80): got " + str(r4) + " expected -20.0")
        exit(1)

    // KAT 5: pc_apply(100.0, 10.0) == 110.0
    let r5 = pc_apply(100.0, 10.0)
    let d5 = r5 - 110.0
    if d5 < 0.0
        d5 = d5 * -1.0
    if d5 > 0.001
        print("FAIL KAT5 pc_apply(100,10): got " + str(r5) + " expected 110.0")
        exit(1)

    // KAT 6: pc_discount(100.0, 25.0) == 75.0
    let r6 = pc_discount(100.0, 25.0)
    let d6 = r6 - 75.0
    if d6 < 0.0
        d6 = d6 * -1.0
    if d6 > 0.001
        print("FAIL KAT6 pc_discount(100,25): got " + str(r6) + " expected 75.0")
        exit(1)

    // KAT 7: pc_of(50.0, 200.0) == 100.0
    let r7 = pc_of(50.0, 200.0)
    let d7 = r7 - 100.0
    if d7 < 0.0
        d7 = d7 * -1.0
    if d7 > 0.001
        print("FAIL KAT7 pc_of(50,200): got " + str(r7) + " expected 100.0")
        exit(1)

    // KAT 8: pc_ratio_to_pct(3.0, 12.0) == 25.0
    let r8 = pc_ratio_to_pct(3.0, 12.0)
    let d8 = r8 - 25.0
    if d8 < 0.0
        d8 = d8 * -1.0
    if d8 > 0.001
        print("FAIL KAT8 pc_ratio_to_pct(3,12): got " + str(r8) + " expected 25.0")
        exit(1)

    // KAT 9: pc_discount with 0% leaves price unchanged
    let r9 = pc_discount(250.0, 0.0)
    let d9 = r9 - 250.0
    if d9 < 0.0
        d9 = d9 * -1.0
    if d9 > 0.001
        print("FAIL KAT9 pc_discount(250,0): got " + str(r9) + " expected 250.0")
        exit(1)

    // KAT 10: pc_apply 50% on 200 gives 300
    let r10 = pc_apply(200.0, 50.0)
    let d10 = r10 - 300.0
    if d10 < 0.0
        d10 = d10 * -1.0
    if d10 > 0.001
        print("FAIL KAT10 pc_apply(200,50): got " + str(r10) + " expected 300.0")
        exit(1)

    print("_percentage_test passed")
