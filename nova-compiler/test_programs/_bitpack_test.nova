// _bitpack_test.nova — KAT for std/bits/bitpack
//
// Hand-traces:
//   pk_pack([[1,1],[2,2],[3,3]]):
//     field0: value=1, width=1, shift=0  → 1<<0 = 1
//     field1: value=2, width=2, shift=1  → 2<<1 = 4
//     field2: value=3, width=3, shift=3  → 3<<3 = 24
//     result = 1|4|24 = 29
//
//   pk_unpack(29, [1,2,3]):
//     shift=0: mask=1,  (29>>0)&1  = 1
//     shift=1: mask=3,  (29>>1)&3  = 14&3 = 2
//     shift=3: mask=7,  (29>>3)&7  = 3&7  = 3
//     → [1,2,3]
//
//   pk_rgb565(31,63,31):
//     31<<11=63488, 63<<5=2016, 31<<0=31; 63488|2016|31=65535
//
//   pk_rgb565(0,0,0): 0

import std/bits/bitpack

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL bitpack " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck_list_len(label: str, got: list, want_len: int)
    if len(got) != want_len
        print("FAIL bitpack " + label + "_len: got=" + str(len(got)) + " want=" + str(want_len))
        exit(1)

fn ck_list_elem(label: str, got: list, idx: int, want: int)
    let v = got[idx]
    if v != want
        print("FAIL bitpack " + label + "[" + str(idx) + "]: got=" + str(v) + " want=" + str(want))
        exit(1)

fn main()
    // --- pk_pack ---
    // Spec example: [[1,1],[2,2],[3,3]] = 29
    let fields1 = [[1,1],[2,2],[3,3]]
    cki("pack_29", pk_pack(fields1), 29)

    // Zero fields
    let fields0 = [[0,1],[0,2],[0,3]]
    cki("pack_zeros", pk_pack(fields0), 0)

    // Single field: value=5, width=4 → 5
    let fields_single = [[5,4]]
    cki("pack_single", pk_pack(fields_single), 5)

    // Mask: value=15 in width=3 → only low 3 bits → 7
    let fields_masked = [[15,3]]
    cki("pack_masked", pk_pack(fields_masked), 7)

    // Round-trip source: [[5,3],[6,4],[7,5]]
    //   5 at shift=0 (3 bits), 6 at shift=3 (4 bits), 7 at shift=7 (5 bits)
    //   5<<0=5, 6<<3=48, 7<<7=896; 5|48|896=949
    let fields_rt = [[5,3],[6,4],[7,5]]
    cki("pack_rt_949", pk_pack(fields_rt), 949)

    // --- pk_unpack ---
    // Spec example: pk_unpack(29, [1,2,3]) = [1,2,3]
    let widths1 = [1,2,3]
    let res1 = pk_unpack(29, widths1)
    ck_list_len("unpack_29", res1, 3)
    ck_list_elem("unpack_29", res1, 0, 1)
    ck_list_elem("unpack_29", res1, 1, 2)
    ck_list_elem("unpack_29", res1, 2, 3)

    // Zero: pk_unpack(0, [4,4,4]) = [0,0,0]
    let widths0 = [4,4,4]
    let res0 = pk_unpack(0, widths0)
    ck_list_len("unpack_0", res0, 3)
    ck_list_elem("unpack_0", res0, 0, 0)
    ck_list_elem("unpack_0", res0, 1, 0)
    ck_list_elem("unpack_0", res0, 2, 0)

    // ROUND-TRIP: pk_unpack(pk_pack([[5,3],[6,4],[7,5]]), [3,4,5]) = [5,6,7]
    let widths_rt = [3,4,5]
    let packed_rt = pk_pack(fields_rt)
    let res_rt = pk_unpack(packed_rt, widths_rt)
    ck_list_len("rt_unpack", res_rt, 3)
    ck_list_elem("rt_unpack", res_rt, 0, 5)
    ck_list_elem("rt_unpack", res_rt, 1, 6)
    ck_list_elem("rt_unpack", res_rt, 2, 7)

    // Additional round-trip: single field
    let rt_single_packed = pk_pack([[42,8]])
    let rt_single_res = pk_unpack(rt_single_packed, [8])
    ck_list_len("rt_single", rt_single_res, 1)
    ck_list_elem("rt_single", rt_single_res, 0, 42)

    // --- pk_rgb565 ---
    // Spec: pk_rgb565(31,63,31) = 65535
    cki("rgb565_max",   pk_rgb565(31, 63, 31), 65535)
    // Spec: pk_rgb565(0,0,0) = 0
    cki("rgb565_zero",  pk_rgb565(0, 0, 0), 0)
    // Pure red: r=31, g=0, b=0 → 31<<11 = 63488
    cki("rgb565_red",   pk_rgb565(31, 0, 0), 63488)
    // Pure green: r=0, g=63, b=0 → 63<<5 = 2016
    cki("rgb565_green", pk_rgb565(0, 63, 0), 2016)
    // Pure blue: r=0, g=0, b=31 → 31
    cki("rgb565_blue",  pk_rgb565(0, 0, 31), 31)

    // --- pk_unrgb565 ---
    // Spec: pk_unrgb565(65535) = [31,63,31]
    let rgb_max = pk_unrgb565(65535)
    ck_list_len("unrgb565_max", rgb_max, 3)
    ck_list_elem("unrgb565_max", rgb_max, 0, 31)
    ck_list_elem("unrgb565_max", rgb_max, 1, 63)
    ck_list_elem("unrgb565_max", rgb_max, 2, 31)

    // pk_unrgb565(0) = [0,0,0]
    let rgb_zero = pk_unrgb565(0)
    ck_list_len("unrgb565_zero", rgb_zero, 3)
    ck_list_elem("unrgb565_zero", rgb_zero, 0, 0)
    ck_list_elem("unrgb565_zero", rgb_zero, 1, 0)
    ck_list_elem("unrgb565_zero", rgb_zero, 2, 0)

    // ROUND-TRIP: pk_unrgb565(pk_rgb565(r,g,b)) = [r,g,b]
    let rt_rgb = pk_unrgb565(pk_rgb565(10, 20, 15))
    ck_list_len("rt_rgb", rt_rgb, 3)
    ck_list_elem("rt_rgb", rt_rgb, 0, 10)
    ck_list_elem("rt_rgb", rt_rgb, 1, 20)
    ck_list_elem("rt_rgb", rt_rgb, 2, 15)

    // ROUND-TRIP: red only
    let rt_red = pk_unrgb565(pk_rgb565(15, 0, 0))
    ck_list_elem("rt_red_r", rt_red, 0, 15)
    ck_list_elem("rt_red_g", rt_red, 1, 0)
    ck_list_elem("rt_red_b", rt_red, 2, 0)

    print("PASS _bitpack_test")
