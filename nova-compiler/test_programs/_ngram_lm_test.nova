// KAT test for std/text/ngram_lm
// Train bigram model on ['i','like','cats','i','like','dogs'] (n=2).
// After 'i': 'like' appears 2 times, total=2 -> MLE prob=1.0
// After 'like': 'cats'=1, 'dogs'=1, total=2 -> MLE prob=0.5 each
// lm_count(model,'i','like') == 2
// lm_most_likely_next(model,'i') == 'like'
// Laplace unseen word: prob > 0
// Perplexity of training sentence < perplexity of totally foreign sentence
import std/text/ngram_lm

fn ckf(label, got, want, tol)
    let diff = got - want
    if diff < 0.0
        diff = 0.0 - diff
    if diff > tol
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── Build bigram model ───────────────────────────────────────────────────
    let corpus = ["i", "like", "cats", "i", "like", "dogs"]
    let model = lm_train(corpus, 2)

    // ── KAT 1: lm_count ──────────────────────────────────────────────────────
    let cnt_il = lm_count(model, "i", "like")
    cki("count_i_like", cnt_il, 2)

    let cnt_lc = lm_count(model, "like", "cats")
    cki("count_like_cats", cnt_lc, 1)

    let cnt_ld = lm_count(model, "like", "dogs")
    cki("count_like_dogs", cnt_ld, 1)

    let cnt_unseen = lm_count(model, "i", "cats")
    cki("count_unseen", cnt_unseen, 0)

    // ── KAT 2: lm_prob_mle ───────────────────────────────────────────────────
    let mle_il = lm_prob_mle(model, "i", "like")
    ckf("mle_i_like", mle_il, 1.0, 0.001)

    let mle_lc = lm_prob_mle(model, "like", "cats")
    ckf("mle_like_cats", mle_lc, 0.5, 0.001)

    // unseen context -> 0.0
    let mle_unseen_ctx = lm_prob_mle(model, "zzz", "like")
    ckf("mle_unseen_ctx", mle_unseen_ctx, 0.0, 0.001)

    // ── KAT 3: lm_most_likely_next ───────────────────────────────────────────
    let next_i = lm_most_likely_next(model, "i")
    if next_i != "like"
        print("FAIL most_likely_next_i: got=" + next_i + " want=like")
        exit(1)

    // ── KAT 4: lm_prob_laplace (smoothing) ──────────────────────────────────
    let k = 1.0
    let laplace_seen = lm_prob_laplace(model, "i", "like", k)
    // count=2, total=2, vocab_size=4 (i,like,cats,dogs)
    // (2+1)/(2+1*4) = 3/6 = 0.5
    ckf("laplace_i_like", laplace_seen, 0.5, 0.001)

    let laplace_unseen = lm_prob_laplace(model, "i", "zzz", k)
    // count=0, total=2, vocab_size=4 -> (0+1)/(2+4) = 1/6 ~ 0.1667
    ckf("laplace_unseen_word", laplace_unseen, 0.1667, 0.001)

    // Unseen word must have probability > 0 (smoothing works)
    if laplace_unseen <= 0.0
        print("FAIL laplace_unseen_gt0: smoothing must give >0 probability")
        exit(1)

    // ── KAT 5: lm_vocab_size ─────────────────────────────────────────────────
    let vs = lm_vocab_size(model)
    cki("vocab_size", vs, 4)

    // ── KAT 6: lm_context_total ──────────────────────────────────────────────
    let ct_i = lm_context_total(model, "i")
    cki("context_total_i", ct_i, 2)

    let ct_like = lm_context_total(model, "like")
    cki("context_total_like", ct_like, 2)

    // ── KAT 7: lm_add_k_default ──────────────────────────────────────────────
    let def_k = lm_add_k_default()
    ckf("add_k_default", def_k, 1.0, 0.001)

    // ── KAT 8: lm_sentence_logprob ──────────────────────────────────────────
    // log prob of training sentence should be finite (negative number)
    let lp = lm_sentence_logprob(model, corpus, k)
    if lp >= 0.0
        print("FAIL logprob_negative: log probability should be negative")
        exit(1)

    // ── KAT 9: lm_perplexity — training < foreign ───────────────────────────
    let pp_train = lm_perplexity(model, corpus, k)
    // Foreign sentence with no overlap in context transitions
    let foreign = ["xyz", "abc", "def", "xyz", "abc", "def"]
    let pp_foreign = lm_perplexity(model, foreign, k)
    if pp_train >= pp_foreign
        print("FAIL perplexity_ordering: training PP should be lower than foreign PP")
        exit(1)
    // Training PP must be > 1 (it's a probabilistic model with smoothing)
    if pp_train <= 1.0
        print("FAIL perplexity_gt1: PP should be > 1")
        exit(1)

    // ── KAT 10: lm_ngrams structure ──────────────────────────────────────────
    let bi = lm_ngrams(corpus, 2)
    // 6 tokens -> 5 bigrams
    cki("ngrams_count", len(bi), 5)
    let first_bg = bi[0]
    if first_bg[0] != "i"
        print("FAIL ngram_first0: expected 'i'")
        exit(1)
    if first_bg[1] != "like"
        print("FAIL ngram_first1: expected 'like'")
        exit(1)

    // ── KAT 11: lm_ngrams on short list ─────────────────────────────────────
    let short = ["a", "b"]
    let tri = lm_ngrams(short, 3)
    cki("ngrams_too_short", len(tri), 0)

    // ── KAT 12: unigram model ────────────────────────────────────────────────
    let uni_model = lm_train(corpus, 1)
    // Context is "" for unigrams; count of "like" = 2
    let cnt_like_uni = lm_count(uni_model, "", "like")
    cki("uni_count_like", cnt_like_uni, 2)

    // MLE P("i" | "") = 2/6 ~ 0.3333
    let mle_i_uni = lm_prob_mle(uni_model, "", "i")
    ckf("uni_mle_i", mle_i_uni, 0.3333, 0.001)

    // ── KAT 13: lm_unseen_prob alias ─────────────────────────────────────────
    let up = lm_unseen_prob(model, "i", "zzz", k)
    ckf("unseen_prob_alias", up, 0.1667, 0.001)

    print("PASS _ngram_lm_test")
