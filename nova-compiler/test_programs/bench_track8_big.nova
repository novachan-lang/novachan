// Bigger Track 8 bench: 1000 iter × 10000-element list. Total 10M pushes.
// Default mode = 10M rc_inc. Track 8 = 0. The difference is RC overhead.

fn build_and_sum(n: int) -> int
    let xs = []
    let i = 0
    while i < n
        xs.push("item_" + str(i))
        i = i + 1
    len(xs)

fn main()
    let iters = 1000
    let per_iter = 10000

    let t0 = time_ms()
    let total = 0
    let k = 0
    while k < iters
        total = total + build_and_sum(per_iter)
        k = k + 1
    let t1 = time_ms()

    let dt = t1 - t0
    print("bench: " + str(iters) + " iter * " + str(per_iter) + " elements -> total=" + str(total) + ", elapsed_ms=" + str(dt))
    rc_stats_dump()
