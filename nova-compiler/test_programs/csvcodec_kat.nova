import std/data/csv

fn main()
    let t = "a,b,c" + chr(10) + "1," + chr(34) + "x,y" + chr(34) + ",3" + chr(10) + chr(34) + "line" + chr(10) + "break" + chr(34) + "," + chr(34) + "he said " + chr(34) + chr(34) + "hi" + chr(34) + chr(34) + chr(34) + ",6" + chr(10)
    let rows = csv_parse(t)

    if len(rows) != 3
        print("FAIL row count: " + str(len(rows)))
        exit(1)

    if rows[0][0] != "a" or rows[0][1] != "b" or rows[0][2] != "c"
        print("FAIL header row: " + str(rows[0]))
        exit(1)

    if rows[1][1] != "x,y"
        print("FAIL embedded comma: " + rows[1][1])
        exit(1)

    if rows[2][0] != "line" + chr(10) + "break"
        print("FAIL embedded newline: " + rows[2][0])
        exit(1)

    if rows[2][1] != "he said " + chr(34) + "hi" + chr(34)
        print("FAIL escaped quote: " + rows[2][1])
        exit(1)

    if rows[2][2] != "6"
        print("FAIL plain field: " + rows[2][2])
        exit(1)

    // CRLF handling.
    let t_crlf = "x,y" + chr(13) + chr(10) + "1,2" + chr(13) + chr(10)
    let rows_crlf = csv_parse(t_crlf)
    if len(rows_crlf) != 2 or rows_crlf[0][0] != "x" or rows_crlf[1][1] != "2"
        print("FAIL CRLF: " + str(rows_crlf))
        exit(1)

    // Empty document.
    let rows_empty = csv_parse("")
    if len(rows_empty) != 0
        print("FAIL empty doc: " + str(len(rows_empty)))
        exit(1)

    // Round-trip: csv_parse(csv_write(csv_parse(t))) == csv_parse(t).
    let written = csv_write(rows)
    let reparsed = csv_write(csv_parse(written))
    let expected = csv_write(rows)
    if reparsed != expected
        print("FAIL round-trip write mismatch")
        print("expected: " + expected)
        print("got:      " + reparsed)
        exit(1)

    let rows2 = csv_parse(written)
    if len(rows2) != len(rows)
        print("FAIL round-trip row count: " + str(len(rows2)) + " vs " + str(len(rows)))
        exit(1)
    let ri = 0
    while ri < len(rows)
        if len(rows2[ri]) != len(rows[ri])
            print("FAIL round-trip field count row " + str(ri))
            exit(1)
        let ci = 0
        while ci < len(rows[ri])
            if rows2[ri][ci] != rows[ri][ci]
                print("FAIL round-trip field mismatch row " + str(ri) + " col " + str(ci) + ": " + rows2[ri][ci] + " vs " + rows[ri][ci])
                exit(1)
            ci = ci + 1
        ri = ri + 1

    // Writer quoting: a field with a plain comma must round-trip through quoting.
    let w_rows = [["a" + chr(44) + "b", "c"], ["d", "e" + chr(34) + "f"]]
    let w_text = csv_write(w_rows)
    let w_back = csv_parse(w_text)
    if w_back[0][0] != "a,b" or w_back[0][1] != "c" or w_back[1][1] != "e" + chr(34) + "f"
        print("FAIL writer quoting round-trip: " + w_text)
        exit(1)

    print("PASS csvcodec")
