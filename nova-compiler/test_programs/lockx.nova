// lockx — mutual exclusion & concurrency limiting, the NOVA way.
//
// NOVA has no shared mutable memory (process isolation IS memory safety: values are
// owned by processes, never shared), so a Java/C/Rust-style memory-guarding mutex is
// meaningless here — there is nothing to guard. What locks are ACTUALLY for once
// shared memory is gone — bounding concurrent access to a scarce resource, and mutual
// exclusion of a critical section — is EXPRESSED through the primitive NOVA already
// has: the Channel.
//
//   A counting semaphore IS a channel holding N permits.
//     acquire = receive a permit  (blocks when exhausted, via the channel's own
//               not-empty back-pressure — no new wait machinery)
//     release = send the permit back
//   A mutex is a semaphore of 1.
//
// No new primitive, no `lock` type, no separate runtime: ONE concept (channel)
// subsumes mutex + semaphore, and condition-variable "wait/notify" is just
// "await a message" — which CSP does natively. This is unification, not import.

fn semaphore(permits)
    let s = channel()
    let i = 0
    while i < permits
        send(s, 1)             // unbounded channel never blocks on send
        i = i + 1
    return s

fn acquire(sem)
    return receive(sem)        // takes a permit; blocks until one is available

fn release(sem)
    send(sem, 1)               // returns a permit; wakes a waiter
    return 0

fn mutex()
    return semaphore(1)        // a mutex is a semaphore with a single permit

fn lock(m)
    return acquire(m)

fn unlock(m)
    return release(m)

fn main()
    // semaphore(2): take both permits (available -> no block), return one, retake.
    let sem = semaphore(2)
    assert_eq(acquire(sem), 1)
    assert_eq(acquire(sem), 1)
    release(sem)
    assert_eq(acquire(sem), 1)
    release(sem)
    release(sem)

    // mutex round-trips
    let m = mutex()
    lock(m)
    unlock(m)
    lock(m)
    unlock(m)

    // real concurrency limiter: a shared permit channel (channels ARE shared across
    // processes) caps how many of the 3 spawned workers hold the resource at once.
    // All 3 still complete because every acquire is matched by a release.
    let gate = semaphore(2)
    let results = channel()
    let w = 0
    while w < 3
        spawn fn()
            acquire(gate)
            // critical section (bounded to 2 concurrent holders)
            release(gate)
            send(results, 1)
        w = w + 1
    let got = 0
    let r = 0
    while r < 3
        got = got + receive(results)
        r = r + 1
    assert_eq(got, 3)

    print("lockx passed")
