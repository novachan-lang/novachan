import std/automata/markov

fn main()
    // -----------------------------------------------------------------------
    // KAT 1 + 2: Simple two-state chain A<->B (weight 1 each).
    //   A has only one outgoing edge (A->B weight 1), so mkv_next(m,"A",*)
    //   must always return "B" regardless of seed.
    //   Similarly B->A is the only edge from B.
    // -----------------------------------------------------------------------
    let m = markov.mkv_new()
    markov.mkv_add(m, "A", "B", 1)
    markov.mkv_add(m, "B", "A", 1)

    // KAT 1: mkv_next from "A" must be "B" (only option).
    let n1 = markov.mkv_next(m, "A", 42)
    if n1 != "B"
        print("FAIL KAT1: mkv_next(A,42) expected B got " + n1)
        exit(1)

    // KAT 2: mkv_next from "B" must be "A" (only option).
    let n2 = markov.mkv_next(m, "B", 99999)
    if n2 != "A"
        print("FAIL KAT2: mkv_next(B,99999) expected A got " + n2)
        exit(1)

    // -----------------------------------------------------------------------
    // KAT 3: mkv_prob(m, "A", "B") == 1.0 (A has only one edge, to B, w=1).
    // We compare by checking |prob - 1.0| < 0.0001.
    // -----------------------------------------------------------------------
    let p3 = markov.mkv_prob(m, "A", "B")
    let diff3 = p3 - 1.0
    if diff3 < 0.0
        diff3 = 0.0 - diff3
    if diff3 > 0.0001
        print("FAIL KAT3: mkv_prob(A,B) expected 1.0 got " + str(p3))
        exit(1)

    // -----------------------------------------------------------------------
    // KAT 4: State with one edge of weight 0 and another of weight 5.
    //   X->Y weight 0  (never chosen)
    //   X->Z weight 5  (always chosen)
    //   mkv_next(m2,"X",anyseed) must always be "Z".
    // -----------------------------------------------------------------------
    let m2 = markov.mkv_new()
    markov.mkv_add(m2, "X", "Y", 0)
    markov.mkv_add(m2, "X", "Z", 5)

    let n4a = markov.mkv_next(m2, "X", 1)
    if n4a != "Z"
        print("FAIL KAT4a: mkv_next(X,1) expected Z got " + n4a)
        exit(1)
    let n4b = markov.mkv_next(m2, "X", 12345678)
    if n4b != "Z"
        print("FAIL KAT4b: mkv_next(X,12345678) expected Z got " + n4b)
        exit(1)

    // -----------------------------------------------------------------------
    // KAT 5: mkv_walk(m, "A", 4, seed) has length 5 and strictly alternates.
    //   Expected: ["A","B","A","B","A"]
    //   We re-use m (the A<->B chain) where each state has exactly one edge.
    // -----------------------------------------------------------------------
    let walk = markov.mkv_walk(m, "A", 4, 7)
    let wlen = len(walk)
    if wlen != 5
        print("FAIL KAT5: walk length expected 5 got " + str(wlen))
        exit(1)
    // Verify alternating pattern: A,B,A,B,A
    let w0 = walk[0]
    let w1 = walk[1]
    let w2 = walk[2]
    let w3 = walk[3]
    let w4 = walk[4]
    if w0 != "A"
        print("FAIL KAT5: walk[0] expected A got " + w0)
        exit(1)
    if w1 != "B"
        print("FAIL KAT5: walk[1] expected B got " + w1)
        exit(1)
    if w2 != "A"
        print("FAIL KAT5: walk[2] expected A got " + w2)
        exit(1)
    if w3 != "B"
        print("FAIL KAT5: walk[3] expected B got " + w3)
        exit(1)
    if w4 != "A"
        print("FAIL KAT5: walk[4] expected A got " + w4)
        exit(1)

    // -----------------------------------------------------------------------
    // KAT 6: mkv_prob(m, "A", "Z") == 0.0 (edge A->Z does not exist).
    // -----------------------------------------------------------------------
    let p6 = markov.mkv_prob(m, "A", "Z")
    let diff6 = p6 - 0.0
    if diff6 < 0.0
        diff6 = 0.0 - diff6
    if diff6 > 0.0001
        print("FAIL KAT6: mkv_prob(A,Z) expected 0.0 got " + str(p6))
        exit(1)

    print("_markov_test passed")

main()
