let a = 3.14
let b = float(a)
print(b)
assert(b == 3.14, "float(float-literal-var)")

fn ret_float() -> float
    2.5

let c = float(ret_float())
print(c)
assert(c == 2.5, "float(float-return)")

let xs = [1.5, 2.5, 3.5]
let d = float(xs[1])
print(d)
assert(d == 2.5, "float(float-element)")

let e = float(7.0)
print(e)
assert(e == 7.0, "float(float-literal)")

print("float(float) probe passed")
