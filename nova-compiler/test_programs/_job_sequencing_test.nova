import std/greedy/job_sequencing

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _job_sequencing_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL _job_sequencing_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(label: string, got: list, want: list)
    cki(label + ".len", len(got), len(want))
    let i = 0
    while i < len(want)
        cki(label + "[" + str(i) + "]", got[i], want[i])
        i = i + 1

fn main()
    // KAT 1: js_max_profit([2,1,2,1,3],[100,19,27,25,15])=142
    // Sort by profit desc: idx0(100,d=2),idx2(27,d=2),idx3(25,d=1),idx1(19,d=1),idx4(15,d=3)
    // Slots (maxd=3): [-,-,-]
    // idx0(d=2,p=100): slot 1. Slots:[-, 0, -]
    // idx2(d=2,p=27): slot 1 taken, try slot 0. Slots:[2, 0, -]
    // idx3(d=1,p=25): slot 0 taken. Skip.
    // idx1(d=1,p=19): slot 0 taken. Skip.
    // idx4(d=3,p=15): slot 2. Slots:[2, 0, 4]
    // total = 27+100+15 = 142
    let d1 = [2, 1, 2, 1, 3]
    let p1 = [100, 19, 27, 25, 15]
    cki("max_profit_142", js_max_profit(d1, p1), 142)
    cki("count_3", js_count_scheduled(d1, p1), 3)

    // KAT 2: js_max_profit([4,1,1,1],[20,10,40,30])=60
    // Sort by profit desc: idx2(40,d=1),idx3(30,d=1),idx0(20,d=4),idx1(10,d=1)
    // Slots (maxd=4): [-,-,-,-]
    // idx2(d=1,p=40): slot 0. Slots:[2,-,-,-]
    // idx3(d=1,p=30): slot 0 taken. Skip.
    // idx0(d=4,p=20): slot 3. Slots:[2,-,-,0]
    // idx1(d=1,p=10): slot 0 taken. Skip.
    // total = 40+20 = 60
    let d2 = [4, 1, 1, 1]
    let p2 = [20, 10, 40, 30]
    cki("max_profit_60", js_max_profit(d2, p2), 60)

    // KAT 3: single job
    let d3 = [1]
    let p3 = [50]
    cki("max_profit_single_50", js_max_profit(d3, p3), 50)
    cki("count_single_1", js_count_scheduled(d3, p3), 1)

    // KAT 4: empty
    let d4 = []
    let p4 = []
    cki("max_profit_empty", js_max_profit(d4, p4), 0)
    cki("count_empty", js_count_scheduled(d4, p4), 0)

    // KAT 5: all deadline=1, only the best-profit job fits
    // deadlines=[1,1,1], profits=[5,15,10]: only slot 0 available
    // Best: idx1(p=15,d=1) placed in slot 0; others skip. profit=15, count=1
    let d5 = [1, 1, 1]
    let p5 = [5, 15, 10]
    cki("max_profit_all_d1", js_max_profit(d5, p5), 15)
    cki("count_all_d1", js_count_scheduled(d5, p5), 1)

    // KAT 6: all different deadlines, all jobs fit
    // deadlines=[1,2,3], profits=[30,20,10]
    // Sort: idx0(30,d=1),idx1(20,d=2),idx2(10,d=3)
    // idx0: slot 0. idx1: slot 1. idx2: slot 2. total=60, count=3
    let d6 = [1, 2, 3]
    let p6 = [30, 20, 10]
    cki("max_profit_all_fit", js_max_profit(d6, p6), 60)
    cki("count_all_fit", js_count_scheduled(d6, p6), 3)

    // KAT 7: two jobs, same deadline, pick higher profit
    // deadlines=[2,2], profits=[50,80]: idx1(80,d=2) slot 1, idx0(50,d=2) slot 0. both fit. total=130
    let d7 = [2, 2]
    let p7 = [50, 80]
    cki("max_profit_both_fit_d2", js_max_profit(d7, p7), 130)
    cki("count_both_d2", js_count_scheduled(d7, p7), 2)

    print("PASS _job_sequencing_test")
