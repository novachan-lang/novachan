import std/time/reltime

// cks: assert two strings equal; fail loudly on mismatch.
fn cks(label, got, want)
    if got != want
        print("FAIL reltime " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

// cki: assert two ints equal; fail loudly on mismatch.
fn cki(label, got, want)
    if got != want
        print("FAIL reltime " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── rel_humanize: same instant → "just now" ──────────────────────────────
    cks("hum-justnow",   rel_humanize(1000, 1000),                       "just now")

    // ── rel_humanize: 90 s in the past → "1 minute ago" ─────────────────────
    cks("hum-1min",      rel_humanize(1000 - 90, 1000),                  "1 minute ago")

    // ── rel_humanize: 2 hours in the past → "2 hours ago" ───────────────────
    cks("hum-2hr",       rel_humanize(1000 - 7200, 1000),                "2 hours ago")

    // ── rel_humanize: 3 days in the past → "3 days ago" ─────────────────────
    cks("hum-3d",        rel_humanize(1000000 - 3 * 86400, 1000000),     "3 days ago")

    // ── rel_humanize: 2 days in the future → "in 2 days" ────────────────────
    cks("hum-fut2d",     rel_humanize(1000000 + 2 * 86400, 1000000),     "in 2 days")

    // ── rel_humanize: 1 second in the past (< 10) → "just now" ──────────────
    cks("hum-1s",        rel_humanize(999, 1000),                        "just now")

    // ── rel_humanize: 45 seconds in the past → "45 seconds ago" ─────────────
    cks("hum-45s",       rel_humanize(1000 - 45, 1000),                  "45 seconds ago")

    // ── rel_humanize: exactly 1 day in the past → "1 day ago" ───────────────
    cks("hum-1day",      rel_humanize(1000000 - 86400, 1000000),         "1 day ago")

    // ── rel_humanize: 1 month in the past → "1 month ago" ───────────────────
    // 1 month = 2592000 s (30 days)
    cks("hum-1mo",       rel_humanize(5000000 - 2592000, 5000000),       "1 month ago")

    // ── rel_humanize: 2 months in the past → "2 months ago" ─────────────────
    cks("hum-2mo",       rel_humanize(5000000 - 5184000, 5000000),       "2 months ago")

    // ── rel_humanize: 1 year in the past → "1 year ago" ─────────────────────
    // 1 year = 31536000 s (365 days)
    cks("hum-1yr",       rel_humanize(50000000 - 31536000, 50000000),    "1 year ago")

    // ── rel_humanize: future 1 hour → "in 1 hour" ───────────────────────────
    cks("hum-fut1hr",    rel_humanize(1000000 + 3600, 1000000),          "in 1 hour")

    // ── rel_humanize: future 30 seconds → "in 30 seconds" ───────────────────
    cks("hum-fut30s",    rel_humanize(1000000 + 30, 1000000),            "in 30 seconds")

    // ── rel_round KAT vectors ─────────────────────────────────────────────────
    // rel_round(3661) == [1, "hour"]
    let r1 = rel_round(3661)
    cki("round-3661-count", r1[0], 1)
    cks("round-3661-unit",  r1[1], "hour")

    // rel_round(90) == [1, "minute"]
    let r2 = rel_round(90)
    cki("round-90-count", r2[0], 1)
    cks("round-90-unit",  r2[1], "minute")

    // rel_round(45) → [45, "second"]
    let r3 = rel_round(45)
    cki("round-45-count", r3[0], 45)
    cks("round-45-unit",  r3[1], "second")

    // rel_round(86400) → [1, "day"]
    let r4 = rel_round(86400)
    cki("round-86400-count", r4[0], 1)
    cks("round-86400-unit",  r4[1], "day")

    // rel_round(604800) → [1, "week"]
    let r5 = rel_round(604800)
    cki("round-604800-count", r5[0], 1)
    cks("round-604800-unit",  r5[1], "week")

    // rel_round(2592000) → [1, "month"]
    let r6 = rel_round(2592000)
    cki("round-2592000-count", r6[0], 1)
    cks("round-2592000-unit",  r6[1], "month")

    // rel_round(31536000) → [1, "year"]
    let r7 = rel_round(31536000)
    cki("round-31536000-count", r7[0], 1)
    cks("round-31536000-unit",  r7[1], "year")

    // rel_round(63072000) → [2, "year"]  (2 * 31536000)
    let r8 = rel_round(63072000)
    cki("round-2yr-count", r8[0], 2)
    cks("round-2yr-unit",  r8[1], "year")

    // ── rel_compact KAT vectors ───────────────────────────────────────────────
    // rel_compact(7200) == "2h"
    cks("compact-7200",   rel_compact(7200),            "2h")

    // rel_compact(3*86400) == "3d"
    cks("compact-3d",     rel_compact(3 * 86400),       "3d")

    // rel_compact(45) → "45s"
    cks("compact-45s",    rel_compact(45),              "45s")

    // rel_compact(120) → "2m"
    cks("compact-120",    rel_compact(120),             "2m")

    // rel_compact(604800) → "1w"
    cks("compact-1w",     rel_compact(604800),          "1w")

    // rel_compact(2592000) → "1mo"
    cks("compact-1mo",    rel_compact(2592000),         "1mo")

    // rel_compact(31536000) → "1y"
    cks("compact-1y",     rel_compact(31536000),        "1y")

    // ── Round-trip: rel_round then rel_compact agree on largest unit ──────────
    // 7200 s → round gives [2, "hour"], compact gives "2h"
    let rt = rel_round(7200)
    cki("roundtrip-7200-count", rt[0], 2)
    cks("roundtrip-7200-unit",  rt[1], "hour")
    cks("roundtrip-7200-compact", rel_compact(7200), "2h")

    print("PASS _reltime_test")
