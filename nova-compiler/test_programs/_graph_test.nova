// KAT for std/collections/graph
// Tests both the primary gr_ API (directed/undirected) and legacy g_ API.
import std/collections/graph

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // =========================================================================
    // Spec KAT — directed graph: A->B, A->C, B->D, C->D
    // =========================================================================
    let g = graph.gr_new(1)
    graph.gr_add_edge(g, "A", "B")
    graph.gr_add_edge(g, "A", "C")
    graph.gr_add_edge(g, "B", "D")
    graph.gr_add_edge(g, "C", "D")

    // gr_neighbors(g,"A") = ["B","C"]
    let nb = graph.gr_neighbors(g, "A")
    cki("neighbors_A_len", len(nb), 2)
    cks("neighbors_A_0", nb[0], "B")
    cks("neighbors_A_1", nb[1], "C")

    // gr_has_edge
    cki("has_edge_AB", graph.gr_has_edge(g, "A", "B"), 1)
    cki("has_edge_BA_false", graph.gr_has_edge(g, "B", "A"), 0)
    cki("has_edge_AD_false", graph.gr_has_edge(g, "A", "D"), 0)
    cki("has_edge_BD", graph.gr_has_edge(g, "B", "D"), 1)

    // gr_bfs(g,"A") = ["A","B","C","D"]
    let bfs = graph.gr_bfs(g, "A")
    cki("bfs_len", len(bfs), 4)
    cks("bfs_0", bfs[0], "A")
    cks("bfs_1", bfs[1], "B")
    cks("bfs_2", bfs[2], "C")
    cks("bfs_3", bfs[3], "D")

    // gr_dfs(g,"A") = ["A","B","D","C"] (preorder, stack-based, rev-insertion)
    let dfs = graph.gr_dfs(g, "A")
    cki("dfs_len", len(dfs), 4)
    cks("dfs_0", dfs[0], "A")
    cks("dfs_1", dfs[1], "B")
    cks("dfs_2", dfs[2], "D")
    cks("dfs_3", dfs[3], "C")

    // gr_has_path
    cki("path_AD", graph.gr_has_path(g, "A", "D"), 1)
    cki("path_DA_false", graph.gr_has_path(g, "D", "A"), 0)
    cki("path_AA_self", graph.gr_has_path(g, "A", "A"), 1)
    cki("path_DA_false2", graph.gr_has_path(g, "D", "A"), 0)

    // gr_topo_sort: valid order with A first and D last
    let topo = graph.gr_topo_sort(g)
    cki("topo_len", len(topo), 4)
    cks("topo_first", topo[0], "A")
    let last = topo[len(topo) - 1]
    cks("topo_last", last, "D")

    // =========================================================================
    // Undirected graph: X-Y edge means gr_has_edge(g,"Y","X")=true
    // =========================================================================
    let ug = graph.gr_new(0)
    graph.gr_add_edge(ug, "X", "Y")
    cki("undir_XY", graph.gr_has_edge(ug, "X", "Y"), 1)
    cki("undir_YX", graph.gr_has_edge(ug, "Y", "X"), 1)
    cki("undir_path_XY", graph.gr_has_path(ug, "X", "Y"), 1)
    cki("undir_path_YX", graph.gr_has_path(ug, "Y", "X"), 1)

    // Deduplication: adding same edge twice must not create duplicate neighbors
    graph.gr_add_edge(ug, "X", "Y")
    let nb_x = graph.gr_neighbors(ug, "X")
    cki("undir_dedup_len", len(nb_x), 1)

    // =========================================================================
    // gr_add_node idempotence + isolated node
    // =========================================================================
    let g2 = graph.gr_new(1)
    graph.gr_add_node(g2, "P")
    graph.gr_add_node(g2, "P")
    graph.gr_add_node(g2, "Q")
    cki("isolated_P_no_nbrs", len(graph.gr_neighbors(g2, "P")), 0)
    cki("no_path_PQ", graph.gr_has_path(g2, "P", "Q"), 0)
    graph.gr_add_edge(g2, "P", "Q")
    cki("path_PQ_after_edge", graph.gr_has_path(g2, "P", "Q"), 1)

    // gr_topo_sort on a 2-node DAG
    let topo2 = graph.gr_topo_sort(g2)
    cki("topo2_len", len(topo2), 2)
    cks("topo2_0", topo2[0], "P")
    cks("topo2_1", topo2[1], "Q")

    // Cycle detection: add D->A back edge to original graph
    graph.gr_add_edge(g, "D", "A")
    let topo_cycle = graph.gr_topo_sort(g)
    cki("topo_cycle_empty", len(topo_cycle), 0)

    // Unknown start -> []
    cki("bfs_unknown", len(graph.gr_bfs(g2, "ZZZ")), 0)
    cki("dfs_unknown", len(graph.gr_dfs(g2, "ZZZ")), 0)

    // =========================================================================
    // Legacy g_ API regression
    // =========================================================================
    let lg = graph.g_new()
    graph.g_add_edge(lg, "a", "b")
    graph.g_add_edge(lg, "a", "c")
    graph.g_add_edge(lg, "b", "d")
    graph.g_add_edge(lg, "c", "d")

    let lnb = graph.g_neighbors(lg, "a")
    cki("leg_nbrs_len", len(lnb), 2)
    cks("leg_nbrs_0", lnb[0], "b")
    cks("leg_nbrs_1", lnb[1], "c")

    let lbfs = graph.g_bfs(lg, "a")
    cki("leg_bfs_len", len(lbfs), 4)
    cks("leg_bfs_0", lbfs[0], "a")
    cks("leg_bfs_3", lbfs[3], "d")

    let ldfs = graph.g_dfs(lg, "a")
    cki("leg_dfs_len", len(ldfs), 4)
    cks("leg_dfs_0", ldfs[0], "a")
    cks("leg_dfs_1", ldfs[1], "b")
    cks("leg_dfs_2", ldfs[2], "d")
    cks("leg_dfs_3", ldfs[3], "c")

    cki("leg_path_ad", graph.g_has_path(lg, "a", "d"), 1)
    cki("leg_path_da_false", graph.g_has_path(lg, "d", "a"), 0)

    let ltopo = graph.g_topo_sort(lg)
    cki("leg_topo_len", len(ltopo), 4)
    cks("leg_topo_first", ltopo[0], "a")
    cks("leg_topo_last", ltopo[len(ltopo)-1], "d")

    graph.g_add_edge(lg, "d", "a")
    let ltopo_cyc = graph.g_topo_sort(lg)
    cki("leg_topo_cycle", len(ltopo_cyc), 0)

    print("_graph_test passed")

main()
