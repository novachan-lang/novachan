import std/collections/graph

fn cki(got, expected, label)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(got, expected, label)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn ckb(got, label)
    if got == 0
        print("FAIL " + label + ": expected true but got false/0")
        exit(1)

fn main()
    // -----------------------------------------------------------------------
    // Build DAG: a->b, a->c, b->d, c->d
    // -----------------------------------------------------------------------
    let g = graph.g_new()
    graph.g_add_edge(g, "a", "b")
    graph.g_add_edge(g, "a", "c")
    graph.g_add_edge(g, "b", "d")
    graph.g_add_edge(g, "c", "d")

    // --- neighbors("a") = ["b","c"] (insertion order) ---
    let nb_a = graph.g_neighbors(g, "a")
    cki(len(nb_a), 2, "neighbors(a) len")
    cks(nb_a[0], "b", "neighbors(a)[0]")
    cks(nb_a[1], "c", "neighbors(a)[1]")

    // --- neighbors("d") = [] (leaf node) ---
    let nb_d = graph.g_neighbors(g, "d")
    cki(len(nb_d), 0, "neighbors(d) is empty")

    // --- neighbors of unknown node = [] ---
    let nb_z = graph.g_neighbors(g, "z")
    cki(len(nb_z), 0, "neighbors(unknown) is empty")

    // --- BFS from "a" = ["a","b","c","d"] ---
    let bfs_r = graph.g_bfs(g, "a")
    cki(len(bfs_r), 4, "bfs len")
    cks(bfs_r[0], "a", "bfs[0]=a")
    cks(bfs_r[1], "b", "bfs[1]=b")
    cks(bfs_r[2], "c", "bfs[2]=c")
    cks(bfs_r[3], "d", "bfs[3]=d")

    // --- DFS from "a": preorder should be a,b,d,c,d but d visited once
    //     expected: ["a","b","d","c"] (d already visited when reached via c)
    let dfs_r = graph.g_dfs(g, "a")
    cki(len(dfs_r), 4, "dfs len")
    cks(dfs_r[0], "a", "dfs[0]=a")
    cks(dfs_r[1], "b", "dfs[1]=b")
    cks(dfs_r[2], "d", "dfs[2]=d")
    cks(dfs_r[3], "c", "dfs[3]=c")

    // --- has_path ---
    cki(graph.g_has_path(g, "a", "d"), 1, "has_path(a,d)=true")
    cki(graph.g_has_path(g, "a", "b"), 1, "has_path(a,b)=true")
    cki(graph.g_has_path(g, "a", "a"), 1, "has_path(a,a)=true (same node)")
    cki(graph.g_has_path(g, "d", "a"), 0, "has_path(d,a)=false (no back-edge)")
    cki(graph.g_has_path(g, "b", "c"), 0, "has_path(b,c)=false")
    cki(graph.g_has_path(g, "z", "a"), 0, "has_path(unknown,a)=false")

    // --- topo_sort: must be a valid topological order
    //     a must be first, d must be last
    let topo = graph.g_topo_sort(g)
    cki(len(topo), 4, "topo_sort len")
    cks(topo[0], "a", "topo[0]=a (must be first, only source)")
    cks(topo[len(topo)-1], "d", "topo[last]=d (must be last, only sink)")
    // Verify b and c appear in the middle (positions 1 and 2)
    let t1 = topo[1]
    let t2 = topo[2]
    let bc_ok = 0
    if t1 == "b"
        if t2 == "c"
            bc_ok = 1
    if t1 == "c"
        if t2 == "b"
            bc_ok = 1
    cki(bc_ok, 1, "topo middle = b and c in some order")

    // --- add back-edge d->a to create a cycle; topo_sort must return [] ---
    graph.g_add_edge(g, "d", "a")
    let topo_cycle = graph.g_topo_sort(g)
    cki(len(topo_cycle), 0, "topo_sort with cycle returns []")

    // -----------------------------------------------------------------------
    // Additional coverage: isolated nodes, g_add_node idempotence
    // -----------------------------------------------------------------------
    let g2 = graph.g_new()
    graph.g_add_node(g2, "x")
    graph.g_add_node(g2, "x")   // idempotent
    graph.g_add_node(g2, "y")
    cki(len(graph.g_neighbors(g2, "x")), 0, "isolated x has no neighbors")
    cki(graph.g_has_path(g2, "x", "y"), 0, "no edge x->y yet")
    graph.g_add_edge(g2, "x", "y")
    cki(graph.g_has_path(g2, "x", "y"), 1, "has_path after add_edge")
    let topo2 = graph.g_topo_sort(g2)
    cki(len(topo2), 2, "g2 topo_sort len=2")
    cks(topo2[0], "x", "g2 topo[0]=x")
    cks(topo2[1], "y", "g2 topo[1]=y")

    // -----------------------------------------------------------------------
    // BFS / DFS on unknown start -> []
    // -----------------------------------------------------------------------
    let bfs_unk = graph.g_bfs(g2, "zzz")
    cki(len(bfs_unk), 0, "bfs unknown start = []")
    let dfs_unk = graph.g_dfs(g2, "zzz")
    cki(len(dfs_unk), 0, "dfs unknown start = []")

    print("_graph_test passed")

main()
