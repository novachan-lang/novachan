fn throttle_new(interval_ms)
  let t = {}
  t["interval"] = interval_ms
  t["last_fire"] = 0
  t

fn throttle_check(t)
  let now = time_ms()
  let elapsed = now - t["last_fire"]
  if elapsed >= t["interval"]
    t["last_fire"] = now
    return 1
  0

fn debounce_new(delay_ms)
  let d = {}
  d["delay"] = delay_ms
  d["last_call"] = 0
  d["pending"] = 0
  d

fn debounce_call(d)
  d["last_call"] = time_ms()
  d["pending"] = 1

fn debounce_ready(d)
  if d["pending"] == 0
    return 0
  let elapsed = time_ms() - d["last_call"]
  if elapsed >= d["delay"]
    d["pending"] = 0
    return 1
  0

fn cooldown_new(period_ms)
  let c = {}
  c["period"] = period_ms
  c["active_until"] = 0
  c

fn cooldown_activate(c)
  c["active_until"] = time_ms() + c["period"]

fn cooldown_ready(c)
  time_ms() >= c["active_until"]

fn main()
  let th = throttle_new(100)
  assert(throttle_check(th) == 1, "first throttle passes")
  assert(throttle_check(th) == 0, "immediate second blocked")

  sleep(110)
  assert(throttle_check(th) == 1, "after interval passes")

  let db = debounce_new(50)
  assert(debounce_ready(db) == 0, "no pending = not ready")
  debounce_call(db)
  assert(debounce_ready(db) == 0, "not ready yet (delay)")
  sleep(60)
  assert(debounce_ready(db) == 1, "ready after delay")
  assert(debounce_ready(db) == 0, "consumed = not ready")

  let cd = cooldown_new(50)
  assert(cooldown_ready(cd) == 1, "initially ready")
  cooldown_activate(cd)
  assert(cooldown_ready(cd) == 0, "on cooldown")
  sleep(60)
  assert(cooldown_ready(cd) == 1, "cooldown expired")

  print("debounx: all passed")
