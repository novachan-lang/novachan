import std/framing/lenprefix

// ── Helpers ──────────────────────────────────────────────────────────────────

fn list_eq(a, b) -> bool
    let na = len(a)
    let nb = len(b)
    if na != nb
        return false
    let i = 0
    while i < na
        if (a[i] & 0xFF) != (b[i] & 0xFF)
            return false
        i = i + 1
    true

fn list_eq_nested(a, b) -> bool
    let na = len(a)
    let nb = len(b)
    if na != nb
        return false
    let i = 0
    while i < na
        if not list_eq(a[i], b[i])
            return false
        i = i + 1
    true

fn assert_list(label: string, got, want)
    if not list_eq(got, want)
        let gs = "len=" + str(len(got))
        let ws = "len=" + str(len(want))
        print("FAIL lenprefix " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn assert_int(label: string, got: int, want: int)
    if got != want
        print("FAIL lenprefix " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── KAT 1: lp_frame_u8([1,2,3]) == [3,1,2,3] ────────────────────────────
    let d1 = []
    push(d1, 1)
    push(d1, 2)
    push(d1, 3)
    let f1 = lp_frame_u8(d1)
    let w1 = []
    push(w1, 3)
    push(w1, 1)
    push(w1, 2)
    push(w1, 3)
    assert_list("u8 frame [1,2,3]", f1, w1)

    // ── KAT 2: lp_frame_u16be([1,2,3]) == [0,3,1,2,3] ───────────────────────
    let d2 = []
    push(d2, 1)
    push(d2, 2)
    push(d2, 3)
    let f2 = lp_frame_u16be(d2)
    let w2 = []
    push(w2, 0)
    push(w2, 3)
    push(w2, 1)
    push(w2, 2)
    push(w2, 3)
    assert_list("u16be frame [1,2,3]", f2, w2)

    // ── KAT 3: lp_frame_u16be([]) == [0,0] ───────────────────────────────────
    let d3 = []
    let f3 = lp_frame_u16be(d3)
    let w3 = []
    push(w3, 0)
    push(w3, 0)
    assert_list("u16be frame []", f3, w3)

    // ── KAT 4: lp_frame_u32be([9]) == [0,0,0,1,9] ───────────────────────────
    let d4 = []
    push(d4, 9)
    let f4 = lp_frame_u32be(d4)
    let w4 = []
    push(w4, 0)
    push(w4, 0)
    push(w4, 0)
    push(w4, 1)
    push(w4, 9)
    assert_list("u32be frame [9]", f4, w4)

    // ── KAT 5: lp_deframe_u16be(lp_frame_u16be([5,6,7]),0)['data']==[5,6,7] ─
    let d5 = []
    push(d5, 5)
    push(d5, 6)
    push(d5, 7)
    let framed5 = lp_frame_u16be(d5)
    let dec5 = lp_deframe_u16be(framed5, 0)
    assert_list("u16be round-trip data", dec5["data"], d5)
    assert_int("u16be round-trip next", dec5["next"], 5)

    // ── KAT 6: lp_deframe_u8 round-trip ─────────────────────────────────────
    let d6 = []
    push(d6, 0xAB)
    push(d6, 0xCD)
    let framed6 = lp_frame_u8(d6)
    let dec6 = lp_deframe_u8(framed6, 0)
    assert_list("u8 round-trip data", dec6["data"], d6)
    assert_int("u8 round-trip next", dec6["next"], 3)

    // ── KAT 7: lp_deframe_u32be round-trip ───────────────────────────────────
    let d7 = []
    push(d7, 10)
    push(d7, 20)
    push(d7, 30)
    let framed7 = lp_frame_u32be(d7)
    let dec7 = lp_deframe_u32be(framed7, 0)
    assert_list("u32be round-trip data", dec7["data"], d7)
    assert_int("u32be round-trip next", dec7["next"], 7)

    // ── KAT 8: lp_split_u16be([[1,2],[3,4,5]]) ───────────────────────────────
    let pA = []
    push(pA, 1)
    push(pA, 2)
    let pB = []
    push(pB, 3)
    push(pB, 4)
    push(pB, 5)
    let fA = lp_frame_u16be(pA)
    let fB = lp_frame_u16be(pB)
    // build concatenated stream
    let stream8 = []
    let si = 0
    while si < len(fA)
        push(stream8, fA[si])
        si = si + 1
    let sj = 0
    while sj < len(fB)
        push(stream8, fB[sj])
        sj = sj + 1
    let split8 = lp_split_u16be(stream8)
    assert_int("split count", len(split8), 2)
    assert_list("split[0]", split8[0], pA)
    assert_list("split[1]", split8[1], pB)

    // ── KAT 9: lp_frame_count_u16be == 2 ────────────────────────────────────
    let count9 = lp_frame_count_u16be(stream8)
    assert_int("frame_count", count9, 2)

    // ── KAT 10: lp_read_len_u16be ────────────────────────────────────────────
    let d10 = []
    push(d10, 100)
    push(d10, 200)
    push(d10, 50)
    let framed10 = lp_frame_u16be(d10)
    let rlen10 = lp_read_len_u16be(framed10, 0)
    assert_int("read_len_u16be", rlen10, 3)

    // ── KAT 11: lp_read_len_u16be on short buffer returns -1 ─────────────────
    let short11 = []
    push(short11, 0)
    let rlen11 = lp_read_len_u16be(short11, 0)
    assert_int("read_len short", rlen11, -1)

    // ── KAT 12: truncated stream returns empty on deframe ────────────────────
    let trunc12 = []
    push(trunc12, 0)
    push(trunc12, 5)
    push(trunc12, 1)
    let dec12 = lp_deframe_u16be(trunc12, 0)
    assert_int("truncated data len", len(dec12["data"]), 0)

    // ── KAT 13: lp_frame_u16le ───────────────────────────────────────────────
    let d13 = []
    push(d13, 0xAA)
    push(d13, 0xBB)
    let f13 = lp_frame_u16le(d13)
    let w13 = []
    push(w13, 2)
    push(w13, 0)
    push(w13, 0xAA)
    push(w13, 0xBB)
    assert_list("u16le frame", f13, w13)

    // ── KAT 14: split on empty stream returns empty list ─────────────────────
    let empty14 = []
    let split14 = lp_split_u16be(empty14)
    assert_int("split empty", len(split14), 0)

    print("PASS _lenprefix_test")
