import forge_change_request

fn main()
    let cr = cr_new()
    cr = cr_submit(cr, "CR-001", "Upgrade DB", "alice", "high")
    cr = cr_submit(cr, "CR-002", "Add caching", "bob", "medium")
    assert(cr_total(cr) == 2, "2 CRs")
    assert(cr_has(cr, "CR-001") == 1, "has CR-001")
    assert(cr_pending_count(cr) == 2, "2 pending")

    let im = cr_impact(cr, "CR-001")
    assert(unwrap(im) == "high", "high impact")

    let a1 = cr_approve(cr, "CR-001", "bob")
    cr = unwrap(a1)
    let st = cr_status(cr, "CR-001")
    assert(unwrap(st) == "approved", "approved")
    assert(cr_approved_count(cr) == 1, "1 approved")
    assert(cr_pending_count(cr) == 1, "1 pending")

    let self_approve = cr_approve(cr, "CR-002", "bob")
    assert(is_err(self_approve), "self-approval blocked")

    let r1 = cr_reject(cr, "CR-002", "not needed")
    cr = unwrap(r1)
    assert(cr_rejected_count(cr) == 1, "1 rejected")
    assert(cr_pending_count(cr) == 0, "0 pending")

    let double = cr_approve(cr, "CR-002", "alice")
    assert(is_err(double), "not pending anymore")

    let bad = cr_status(cr, "CR-999")
    assert(is_err(bad), "not found")

    print("CHANGE-REQUEST KAT PASS")
