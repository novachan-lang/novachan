// Cross-import safety check: a single program using BOTH std/core/tree's Tree AND prism_node's
// PrismNode. Before Tree's fields were prefixed, both declared a bare `children` at DIFFERENT slot
// indices (Tree slot 2, PrismNode slot 3), so NOVA's global last-registration-wins field->slot
// table would have made one of them read the wrong field -- a wild pointer read on a struct-typed
// field, i.e. a crash rather than a wrong answer. This is the shape that took down the HTML
// renderer via PrismFormField.kind on 2026-08-16.
import std/core/tree as tr
import prism_node
import prism_content

fn main()
    let t = tr.tnode("root", [tr.tleaf("a"), tr.tleaf("b")])
    let n = unwrap(prism_content.prism_label("hello"))
    let p = unwrap(prism_node.prism_node_branch(prism_node.prism_kind_stack(), {}, [n]))
    print("tree count    = " + str(tr.t_count(t)))
    print("node kind     = " + prism_node.prism_node_kind_str(p))
    print("node count    = " + str(prism_node.prism_node_count(p)))
    if tr.t_count(t) == 3 and prism_node.prism_node_kind_str(p) == "stack" and prism_node.prism_node_count(p) == 2
        print("CROSS-IMPORT OK")
    else
        print("CROSS-IMPORT BROKEN")
        exit(1)
