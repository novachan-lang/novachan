import std/quantum/quantum_state
import std/quantum/quantum_measure

// cki — integer known-answer check.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _quantum_measure_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // qms_prob_qubit_x1000 / |10> in a 2-qubit state (qubit0 is MSB -> 1)
    let b2 = qst_basis(2, 2)
    cki("prob_qubit(b2,0,1)", qms_prob_qubit_x1000(b2, 0, 1), 1000)
    cki("prob_qubit(b2,0,0)", qms_prob_qubit_x1000(b2, 0, 0), 0)
    cki("prob_qubit(b2,1,0)", qms_prob_qubit_x1000(b2, 1, 0), 1000)
    cki("prob_qubit(b2,1,1)", qms_prob_qubit_x1000(b2, 1, 1), 0)

    // qms_expect_z_x1000
    cki("expect_z(|0>)", qms_expect_z_x1000(qst_basis(1, 0), 0), 1000)
    cki("expect_z(|1>)", qms_expect_z_x1000(qst_basis(1, 1), 0), 0 - 1000)

    // qms_most_likely
    cki("most_likely(basis(3,5))", qms_most_likely(qst_basis(3, 5)), 5)

    // ties -> smallest index: equal superposition over 2 qubits
    let eq = []
    push(eq, qst_c(0.5, 0.0))
    push(eq, qst_c(0.5, 0.0))
    push(eq, qst_c(0.5, 0.0))
    push(eq, qst_c(0.5, 0.0))
    cki("most_likely(tie)", qms_most_likely(eq), 0)

    // qms_probs == qst_to_probs
    let probs = qms_probs(b2)
    cki("probs len", len(probs), 4)
    cki("probs[2] x1000", qms_prob_outcome_x1000(b2, 2), 1000)
    cki("probs[0] x1000", qms_prob_outcome_x1000(b2, 0), 0)

    // qms_collapse: collapsing |10> on qubit0==1 keeps full weight at idx2
    let collapsed = qms_collapse(qst_basis(2, 2), 0, 1)
    cki("collapse prob idx2", qms_prob_outcome_x1000(collapsed, 2), 1000)
    cki("collapse prob idx0", qms_prob_outcome_x1000(collapsed, 0), 0)

    // qms_collapse on a superposition: collapse qubit0==0 half of |00>+|11>
    let bell = []
    let r = 1.0 / sqrt(2.0)
    push(bell, qst_c(r, 0.0))
    push(bell, qst_c(0.0, 0.0))
    push(bell, qst_c(0.0, 0.0))
    push(bell, qst_c(r, 0.0))
    let bc = qms_collapse(bell, 0, 0)
    cki("bell collapse idx0", qms_prob_outcome_x1000(bc, 0), 1000)
    cki("bell collapse idx3", qms_prob_outcome_x1000(bc, 3), 0)

    // qms_collapse zero-probability outcome returns input unchanged
    let zprob = qms_collapse(qst_basis(1, 0), 0, 1)
    cki("collapse zero-prob unchanged idx0", qms_prob_outcome_x1000(zprob, 0), 1000)
    cki("collapse zero-prob unchanged idx1", qms_prob_outcome_x1000(zprob, 1), 0)

    print("PASS _quantum_measure_test")
