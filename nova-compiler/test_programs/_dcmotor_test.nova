import std/control/dcmotor

// approx — float equality within tolerance.
fn approx(a, b, tol)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < tol

fn ckf(label, got, want)
    if not approx(got, want, 0.001)
        print("FAIL dcmotor " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // fo_new(2.0, 1.0): gain=2, tau=1
    let fo = fo_new(2.0, 1.0)

    // step response at t=0 => 0.0
    ckf("fo_step_t0", fo_step_response(fo, 0.0), 0.0)

    // step response at large t => ~2.0 (within 0.001 at t=20)
    let big = fo_step_response(fo, 20.0)
    ckf("fo_step_inf", big, 2.0)

    // response at tau=1: K*(1-1/e) = 2*(1-0.36788) = 2*0.63212 = 1.26424
    let at_tau = fo_response_at_tau(fo)
    ckf("fo_at_tau", at_tau, 1.26424)

    // fo_settling_time(tau=1) = 4*1 = 4.0
    ckf("fo_settling", fo_settling_time(fo), 4.0)

    // fo_time_constant
    ckf("fo_tau", fo_time_constant(fo), 1.0)

    // fo_dc_gain
    ckf("fo_gain", fo_dc_gain(fo), 2.0)

    // fo_rise_time: ~2.197*tau = 2.197
    ckf("fo_rise", fo_rise_time(fo), 2.197)

    // dcmotor_new: kt=0.1, ke=0.1, R=1.0, J=0.01, b=0.001
    let motor = dcmotor_new(0.1, 0.1, 1.0, 0.01, 0.001)

    // stall_torque at V=10: kt*V/R = 0.1*10/1 = 1.0
    ckf("stall_torque", dcmotor_stall_torque(motor, 10.0), 1.0)

    // steady_speed at V=10: kt*V / (kt*ke + b*R) = 0.1*10 / (0.01 + 0.001) = 1.0/0.011 = 90.909
    let ss = dcmotor_steady_speed(motor, 10.0)
    ckf("steady_speed", ss, 90.909)

    // dcmotor_time_constant: J*R / (kt*ke + b*R) = 0.01*1 / (0.01+0.001) = 0.01/0.011 = 0.9090
    let tc = dcmotor_time_constant(motor)
    ckf("motor_tau", tc, 0.9090)

    // dcmotor_ss_step from omega=0, V=10, dt=0.001 => first Euler step
    // alpha = (kt*(V-ke*0)/R - b*0)/J = (0.1*10/1)/0.01 = 100 rad/s^2
    // omega_next = 0 + 0.001 * 100 = 0.1
    let om1 = dcmotor_ss_step(motor, 0.0, 10.0, 0.001)
    ckf("ss_step_omega", om1, 0.1)

    // stall torque with different params: kt=0.5, R=2.0, V=4 => 0.5*4/2 = 1.0
    let m2 = dcmotor_new(0.5, 0.1, 2.0, 0.1, 0.01)
    ckf("stall_torque2", dcmotor_stall_torque(m2, 4.0), 1.0)

    // fo with tau=2: settling=8, at_tau = 2*K*(1-1/e) for K=1 -> 0.63212
    let fo2 = fo_new(1.0, 2.0)
    ckf("fo2_settling", fo_settling_time(fo2), 8.0)
    ckf("fo2_at_tau", fo_response_at_tau(fo2), 0.63212)

    print("PASS _dcmotor_test")
