// CAPABILITY AUDIT (corrected syntax): NOVA generics go BEFORE the name:
// `fn <T> name(...)`. Does a user-defined generic fn compile + run?
fn <T> identity(x: T) -> T
    return x

fn <A, B> second(a: A, b: B) -> B
    return b

fn <T> firstof(xs: list<T>) -> T
    return xs[0]

fn main() -> int
    let fails = 0
    if identity(42) != 42
        print("FAIL identity int")
        fails = fails + 1
    if identity("hi") != "hi"
        print("FAIL identity string")
        fails = fails + 1
    if second(1, "x") != "x"
        print("FAIL second A B")
        fails = fails + 1
    let xs = [10, 20, 30]
    if firstof(xs) != 10
        print("FAIL firstof int")
        fails = fails + 1
    let ss = ["a", "b", "c"]
    if firstof(ss) != "a"
        print("FAIL firstof string")
        fails = fails + 1
    if fails == 0
        print("PASS _cap_generics_probe (generics compile + run polymorphically)")
    else
        print("FAILED _cap_generics_probe")
    return 0
