import std/io/teewriter

// ─── helpers ────────────────────────────────────────────────────────────────

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got [" + got + "] want [" + want + "]")
        exit(1)

// ─── KAT 1: basic write + get on 2-sink tee ─────────────────────────────────

fn test_basic_write()
    let t = tt_new(2)
    tt_write(t, "a")
    tt_write(t, "b")
    cks("kat1_sink0", tt_get(t, 0), "ab")
    cks("kat1_sink1", tt_get(t, 1), "ab")
    cki("kat1_count", tt_count(t), 2)

// ─── KAT 2: writeln appends newline to every sink ───────────────────────────

fn test_writeln()
    let t = tt_new(2)
    tt_write(t, "ab")
    tt_writeln(t, "c")
    let want = "ab" + "c" + chr(10)
    cks("kat2_sink0", tt_get(t, 0), want)
    cks("kat2_sink1", tt_get(t, 1), want)

// ─── KAT 3: clear resets all sinks to "" ────────────────────────────────────

fn test_clear()
    let t = tt_new(3)
    tt_write(t, "hello")
    tt_clear(t)
    cks("kat3_sink0", tt_get(t, 0), "")
    cks("kat3_sink1", tt_get(t, 1), "")
    cks("kat3_sink2", tt_get(t, 2), "")
    cki("kat3_count", tt_count(t), 3)

// ─── KAT 4: single sink tee ─────────────────────────────────────────────────

fn test_single_sink()
    let t = tt_new(1)
    tt_write(t, "x")
    tt_writeln(t, "y")
    let want = "x" + "y" + chr(10)
    cks("kat4_sink0", tt_get(t, 0), want)
    cki("kat4_count", tt_count(t), 1)

// ─── KAT 5: 4-sink tee all receive identical content ────────────────────────

fn test_four_sinks()
    let t = tt_new(4)
    tt_writeln(t, "line1")
    tt_writeln(t, "line2")
    let want = "line1" + chr(10) + "line2" + chr(10)
    cks("kat5_sink0", tt_get(t, 0), want)
    cks("kat5_sink1", tt_get(t, 1), want)
    cks("kat5_sink2", tt_get(t, 2), want)
    cks("kat5_sink3", tt_get(t, 3), want)

// ─── KAT 6: write after clear continues correctly ───────────────────────────

fn test_write_after_clear()
    let t = tt_new(2)
    tt_write(t, "first")
    tt_clear(t)
    tt_write(t, "second")
    cks("kat6_sink0", tt_get(t, 0), "second")
    cks("kat6_sink1", tt_get(t, 1), "second")

// ─── KAT 7: spec-mandated sequence from the spec verbatim ───────────────────

fn test_spec_sequence()
    let t = tt_new(2)
    tt_write(t, "a")
    tt_write(t, "b")
    cks("kat7_spec_s0_ab",    tt_get(t, 0), "ab")
    cks("kat7_spec_s1_ab",    tt_get(t, 1), "ab")
    cki("kat7_spec_count",    tt_count(t),  2)
    tt_writeln(t, "c")
    let want_abc = "ab" + "c" + chr(10)
    cks("kat7_spec_s0_abcnl", tt_get(t, 0), want_abc)
    tt_clear(t)
    cks("kat7_spec_s0_empty", tt_get(t, 0), "")

fn main()
    test_basic_write()
    test_writeln()
    test_clear()
    test_single_sink()
    test_four_sinks()
    test_write_after_clear()
    test_spec_sequence()
    print("_teewriter_test passed")
