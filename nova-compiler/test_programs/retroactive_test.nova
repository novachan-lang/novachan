// retroactive_test.nova — extending built-in types with methods

fn int.double(self: int) -> int
    self * 2

fn int.is_even(self: int) -> int
    self % 2 == 0

fn string.shout(self: string) -> string
    upper(self) + "!"

fn string.repeat_n(self: string, n: int) -> string
    let out = ""
    let i = 0
    while i < n
        out = out + self
        i = i + 1
    out

fn list.second(self: list)
    self[1]

fn list.is_empty(self: list) -> int
    len(self) == 0

fn main()
    assert(double(42) == 84, "int.double")
    assert(double(0) == 0, "int.double zero")
    assert(is_even(4) == 1, "int.is_even true")
    assert(is_even(3) == 0, "int.is_even false")
    assert(shout("hello") == "HELLO!", "string.shout")
    assert(repeat_n("ab", 3) == "ababab", "string.repeat_n")
    assert(second([10, 20, 30]) == 20, "list.second")
    assert(is_empty([]) == 1, "list.is_empty true")
    assert(is_empty([1]) == 0, "list.is_empty false")
    let x: int = 7
    assert(double(x) == 14, "typed var int.double")
    let s: string = "hi"
    assert(shout(s) == "HI!", "typed var string.shout")
    print("retroactive_test: all passed")
