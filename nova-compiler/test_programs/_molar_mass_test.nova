// _molar_mass_test.nova — KAT for std/chem/molar_mass
//
// Known answers (g/mol, IUPAC 2021):
//   H2O       = 2*1.008 + 15.999    = 18.015
//   NaCl      = 22.990 + 35.453     = 58.443
//   C6H12O6   = 6*12.011 + 12*1.008 + 6*15.999 = 72.066+12.096+95.994 = 180.156
//   CO2       = 12.011 + 2*15.999   = 44.009
//   parse_formula("H2O") must contain ["H",2] and ["O",1]

import std/chem/molar_mass

// Float proximity check (absolute tolerance).
fn approx(a: float, b: float, tol: float) -> int
    let d = a - b
    let ad = d
    if d < 0.0
        ad = 0.0 - d
    if ad < tol
        return 1
    return 0

// Search parse_formula result for a [sym, cnt] pair.
fn _find_pair(pairs: list, sym: string, cnt: int) -> int
    let i = 0
    while i < len(pairs)
        let pair = pairs[i]
        let psym = pair[0]
        let pcnt = pair[1]
        if psym == sym
            if pcnt == cnt
                return 1
        i = i + 1
    return 0

fn main()
    // KAT 1: H2O molar mass ~= 18.015 (tol 0.01)
    let mm_h2o = molar_mass("H2O")
    if approx(mm_h2o, 18.015, 0.01) != 1
        print("FAIL molar_mass H2O: got " + str(mm_h2o))
        exit(1)

    // KAT 2: NaCl molar mass ~= 58.44 (tol 0.01)
    let mm_nacl = molar_mass("NaCl")
    if approx(mm_nacl, 58.44, 0.01) != 1
        print("FAIL molar_mass NaCl: got " + str(mm_nacl))
        exit(1)

    // KAT 3: C6H12O6 molar mass ~= 180.16 (tol 0.05)
    let mm_gluc = molar_mass("C6H12O6")
    if approx(mm_gluc, 180.16, 0.05) != 1
        print("FAIL molar_mass C6H12O6: got " + str(mm_gluc))
        exit(1)

    // KAT 4: CO2 molar mass ~= 44.01 (tol 0.01)
    let mm_co2 = molar_mass("CO2")
    if approx(mm_co2, 44.01, 0.01) != 1
        print("FAIL molar_mass CO2: got " + str(mm_co2))
        exit(1)

    // KAT 5: Ca(OH)2 molar mass ~= 74.09 (tol 0.05)
    //   Ca=40.078 + 2*(O=15.999+H=1.008) = 40.078 + 34.014 = 74.092
    let mm_caoh2 = molar_mass("Ca(OH)2")
    if approx(mm_caoh2, 74.09, 0.05) != 1
        print("FAIL molar_mass Ca(OH)2: got " + str(mm_caoh2))
        exit(1)

    // KAT 6: parse_formula("H2O") contains ["H",2] and ["O",1]
    let pf = parse_formula("H2O")
    if _find_pair(pf, "H", 2) != 1
        print("FAIL parse_formula H2O missing [H,2]")
        exit(1)
    if _find_pair(pf, "O", 1) != 1
        print("FAIL parse_formula H2O missing [O,1]")
        exit(1)
    if len(pf) != 2
        print("FAIL parse_formula H2O wrong pair count: " + str(len(pf)))
        exit(1)

    print("PASS _molar_mass_test")
