// LOCK-4 inc3b KAT — wrapping arithmetic at sized width (literal-driven).
// Proves: unsigned u8/u16/u32 add/sub/mul wrap modulo 2^bits; signed i8 sign-extends;
// and DEFAULT (unsuffixed) int arithmetic is UNCHANGED (no wrap, no perf/codegen cost).
fn check(name: string, got: int, want: int) -> bool
    if got == want
        print("  ok " + name + " = " + str(got))
        return true
    print("  FAIL " + name + " got " + str(got) + " want " + str(want))
    false

fn main() -> int
    let ok = true
    // unsigned u8 wrap (mod 256)
    if not check("255u8+1", 255u8 + 1, 0)
        ok = false
    if not check("200u8+100u8", 200u8 + 100u8, 44)
        ok = false
    if not check("100u8*3", 100u8 * 3, 44)
        ok = false
    if not check("0u8-1u8", 0u8 - 1u8, 255)
        ok = false
    // signed i8 sign-extend (127+1 -> -128; 100+100=200 -> -56)
    if not check("127i8+1", 127i8 + 1, 0 - 128)
        ok = false
    if not check("100i8+100i8", 100i8 + 100i8, 0 - 56)
        ok = false
    // u16 / u32 wrap
    if not check("65535u16+1", 65535u16 + 1, 0)
        ok = false
    if not check("4294967295u32+1", 4294967295u32 + 1, 0)
        ok = false
    // DEFAULT int arithmetic — must be UNCHANGED (no wrap)
    if not check("255+1", 255 + 1, 256)
        ok = false
    if not check("100*3", 100 * 3, 300)
        ok = false
    if ok
        print("L7-WRAP KAT PASS")
        return 0
    print("L7-WRAP KAT FAIL")
    1
