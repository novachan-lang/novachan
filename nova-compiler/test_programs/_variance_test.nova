// _variance_test.nova — KAT for std/math/variance
// Hand-traced reference values:
//   xs = [2,4,4,4,5,5,7,9], n=8, sum=40, mean=5.0
//   deviations: -3,-1,-1,-1,0,0,2,4  squared: 9,1,1,1,0,0,4,16  sum_sq=32
//   var_population = 32/8 = 4.0
//   sd_population  = sqrt(4.0) = 2.0
//   var_sample     = 32/7 = 4.571428...
//   sd_sample      = sqrt(32/7) = 2.13809...
//   var_coefficient= 2.13809.../5.0 = 0.42762...
//   var_zscore(9)  = (9-5)/2 = 2.0
//   xs2=[1,1,1,1]: mean=1.0, all deviations=0 -> var_population=0.0, var_sample=0.0

import std/math/variance

// Helpers
fn cki(label: str, got: int, expected: int)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn ckf(label: str, got: float, expected: float)
    let diff = got - expected
    let adiff = diff
    if adiff < 0.0
        adiff = adiff * -1.0
    if adiff > 0.001
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// --- KAT 1: canonical [2,4,4,4,5,5,7,9] ---
let xs = [2, 4, 4, 4, 5, 5, 7, 9]

ckf("var_population", var_population(xs), 4.0)
ckf("sd_population",  sd_population(xs),  2.0)
ckf("var_sample",     var_sample(xs),      4.5714)
ckf("sd_sample",      sd_sample(xs),       2.1381)
ckf("var_coefficient",var_coefficient(xs), 0.42762)
ckf("var_zscore_9",   var_zscore(9.0, xs), 2.0)

// --- KAT 2: constant list [1,1,1,1] — zero variance ---
let xs2 = [1, 1, 1, 1]
ckf("var_population_flat", var_population(xs2), 0.0)
ckf("var_sample_flat",     var_sample(xs2),     0.0)
ckf("sd_population_flat",  sd_population(xs2),  0.0)
ckf("sd_sample_flat",      sd_sample(xs2),      0.0)
// zscore of any member against flat list = 0.0 (sd=0 guard)
ckf("var_zscore_flat", var_zscore(1.0, xs2), 0.0)

// --- KAT 3: empty list — all return 0.0, no crash ---
let xs3 = []
ckf("var_population_empty", var_population(xs3), 0.0)
ckf("var_sample_empty",     var_sample(xs3),     0.0)
ckf("sd_population_empty",  sd_population(xs3),  0.0)
ckf("sd_sample_empty",      sd_sample(xs3),      0.0)
ckf("var_coefficient_empty",var_coefficient(xs3),0.0)
ckf("var_zscore_empty",     var_zscore(5.0, xs3),0.0)

// --- KAT 4: single element [7] ---
let xs4 = [7]
// var_population([7]) = ((7-7)^2)/1 = 0.0
ckf("var_population_single", var_population(xs4), 0.0)
// var_sample([7]) = 0.0 (n<2 guard)
ckf("var_sample_single",     var_sample(xs4),     0.0)
ckf("sd_population_single",  sd_population(xs4),  0.0)

// --- KAT 5: two elements [0, 10] ---
// mean=5.0, deviations: -5, 5  sum_sq=50
// var_population = 50/2 = 25.0  sd_pop = 5.0
// var_sample     = 50/1 = 50.0  sd_samp = sqrt(50) ~ 7.07107
// var_coefficient= 7.07107.../5.0 ~ 1.41421
let xs5 = [0, 10]
ckf("var_population_2", var_population(xs5), 25.0)
ckf("sd_population_2",  sd_population(xs5),  5.0)
ckf("var_sample_2",     var_sample(xs5),     50.0)
ckf("sd_sample_2",      sd_sample(xs5),      7.0711)
ckf("var_coefficient_2",var_coefficient(xs5),1.4142)

// --- KAT 6: zscore of mean itself = 0.0 ---
// zscore(5.0, [2,4,4,4,5,5,7,9]) = (5-5)/2 = 0.0
ckf("var_zscore_mean", var_zscore(5.0, xs), 0.0)

// --- KAT 7: float inputs ---
// [1.5, 2.5, 3.5]: mean=2.5, deviations: -1,0,1  sum_sq=2.0
// var_population=2/3=0.6667  sd_population=sqrt(2/3)=0.8165
// var_sample=2/2=1.0  sd_sample=1.0
let xs6 = [1.5, 2.5, 3.5]
ckf("var_population_float", var_population(xs6), 0.6667)
ckf("var_sample_float",     var_sample(xs6),     1.0)
ckf("sd_sample_float",      sd_sample(xs6),      1.0)

print("_variance_test passed")
