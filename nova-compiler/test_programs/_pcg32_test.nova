// KAT test for std/random/pcg32
// PCG32 (pcg_setseq_64_xsh_rr_32): 64-bit LCG with XSH-RR output permutation.
//
// Anchor values computed with a Python reference implementation matching
// O'Neill's canonical pcg_setseq_64_xsh_rr_32 (https://www.pcg-random.org/).
//
// pcg_seed(42, 54) first 3 outputs:
//   [0] = 2707161783  (0xA15C02B7)  -- canonical reference anchor
//   [1] = 2068313097  (0x7B47F409)
//   [2] = 3122475824  (0xBA1D3330)
//
// pcg_seed(1, 1) first 5 outputs (determinism reference):
//   [0] = 3380776849
//   [1] = 361947764
//   [2] = 3223725655
//   [3] = 2781001427
//   [4] = 2944471638

import std/random/pcg32

fn main()
    // ── KAT 1: canonical anchor -- pcg_seed(42,54) first output = 0xA15C02B7 ──
    let r1 = pcg_seed(42, 54)
    let v0 = pcg_next(r1)
    if v0 != 2707161783
        print("FAIL pcg32 KAT1: anchor[0] got " + str(v0) + " want 2707161783")
        exit(1)

    // ── KAT 2: anchor[1] ────────────────────────────────────────────────────
    let v1 = pcg_next(r1)
    if v1 != 2068313097
        print("FAIL pcg32 KAT2: anchor[1] got " + str(v1) + " want 2068313097")
        exit(1)

    // ── KAT 3: anchor[2] ────────────────────────────────────────────────────
    let v2 = pcg_next(r1)
    if v2 != 3122475824
        print("FAIL pcg32 KAT3: anchor[2] got " + str(v2) + " want 3122475824")
        exit(1)

    // ── KAT 4-8: determinism -- two generators seeded (1,1) produce same 5 outputs
    let ra = pcg_seed(1, 1)
    let rb = pcg_seed(1, 1)
    let a0 = pcg_next(ra)
    let b0 = pcg_next(rb)
    if a0 != b0
        print("FAIL pcg32 KAT4: determinism[0] got " + str(a0) + " vs " + str(b0))
        exit(1)
    let a1 = pcg_next(ra)
    let b1 = pcg_next(rb)
    if a1 != b1
        print("FAIL pcg32 KAT5: determinism[1] got " + str(a1) + " vs " + str(b1))
        exit(1)
    let a2 = pcg_next(ra)
    let b2 = pcg_next(rb)
    if a2 != b2
        print("FAIL pcg32 KAT6: determinism[2] got " + str(a2) + " vs " + str(b2))
        exit(1)
    let a3 = pcg_next(ra)
    let b3 = pcg_next(rb)
    if a3 != b3
        print("FAIL pcg32 KAT7: determinism[3] got " + str(a3) + " vs " + str(b3))
        exit(1)
    let a4 = pcg_next(ra)
    let b4 = pcg_next(rb)
    if a4 != b4
        print("FAIL pcg32 KAT8: determinism[4] got " + str(a4) + " vs " + str(b4))
        exit(1)

    // ── KAT 9-13: concrete seed(1,1) anchor values ──────────────────────────
    let rc = pcg_seed(1, 1)
    let c0 = pcg_next(rc)
    if c0 != 3380776849
        print("FAIL pcg32 KAT9: seed(1,1)[0] got " + str(c0) + " want 3380776849")
        exit(1)
    let c1 = pcg_next(rc)
    if c1 != 361947764
        print("FAIL pcg32 KAT10: seed(1,1)[1] got " + str(c1) + " want 361947764")
        exit(1)
    let c2 = pcg_next(rc)
    if c2 != 3223725655
        print("FAIL pcg32 KAT11: seed(1,1)[2] got " + str(c2) + " want 3223725655")
        exit(1)
    let c3 = pcg_next(rc)
    if c3 != 2781001427
        print("FAIL pcg32 KAT12: seed(1,1)[3] got " + str(c3) + " want 2781001427")
        exit(1)
    let c4 = pcg_next(rc)
    if c4 != 2944471638
        print("FAIL pcg32 KAT13: seed(1,1)[4] got " + str(c4) + " want 2944471638")
        exit(1)

    // ── KAT 14: pcg_next output is non-negative ──────────────────────────────
    let rn = pcg_seed(99, 7)
    let nv = pcg_next(rn)
    if nv < 0
        print("FAIL pcg32 KAT14: pcg_next returned negative: " + str(nv))
        exit(1)

    // ── KAT 15: pcg_next output fits in 32 bits ──────────────────────────────
    let mask32 = 4294967295
    let rn2 = pcg_seed(12345, 67890)
    let i = 0
    while i < 20
        let nv2 = pcg_next(rn2)
        if nv2 < 0
            print("FAIL pcg32 KAT15a: negative at step " + str(i) + ": " + str(nv2))
            exit(1)
        if nv2 > mask32
            print("FAIL pcg32 KAT15b: >2^32-1 at step " + str(i) + ": " + str(nv2))
            exit(1)
        i = i + 1

    // ── KAT 16: pcg_next_range stays in [0, n) ───────────────────────────────
    let rr = pcg_seed(777, 13)
    let j = 0
    while j < 100
        let rv = pcg_next_range(rr, 10)
        if rv < 0
            print("FAIL pcg32 KAT16a: range < 0 at step " + str(j) + ": " + str(rv))
            exit(1)
        if rv >= 10
            print("FAIL pcg32 KAT16b: range >= 10 at step " + str(j) + ": " + str(rv))
            exit(1)
        j = j + 1

    // ── KAT 17: pcg_next_range with n=1 always returns 0 ────────────────────
    let rr1 = pcg_seed(42, 42)
    let k = 0
    while k < 10
        let rv1 = pcg_next_range(rr1, 1)
        if rv1 != 0
            print("FAIL pcg32 KAT17: range(1) != 0 at step " + str(k) + ": " + str(rv1))
            exit(1)
        k = k + 1

    // ── KAT 18: different streams (same seed, diff seq) differ ───────────────
    let rs1 = pcg_seed(42, 1)
    let rs2 = pcg_seed(42, 2)
    let sv1 = pcg_next(rs1)
    let sv2 = pcg_next(rs2)
    if sv1 == sv2
        print("FAIL pcg32 KAT18: different streams produced same first output: " + str(sv1))
        exit(1)

    // ── KAT 19: pcg_next_range concrete anchor (42,54) mod 10 ────────────────
    // [0] 2707161783 % 10 = 3, [1] 2068313097 % 10 = 7, [2] 3122475824 % 10 = 4
    let ra2 = pcg_seed(42, 54)
    let rv3 = pcg_next_range(ra2, 10)
    if rv3 != 3
        print("FAIL pcg32 KAT19a: range anchor[0]%10 got " + str(rv3) + " want 3")
        exit(1)
    let rv4 = pcg_next_range(ra2, 10)
    if rv4 != 7
        print("FAIL pcg32 KAT19b: range anchor[1]%10 got " + str(rv4) + " want 7")
        exit(1)
    let rv5 = pcg_next_range(ra2, 10)
    if rv5 != 4
        print("FAIL pcg32 KAT19c: range anchor[2]%10 got " + str(rv5) + " want 4")
        exit(1)

    print("PASS _pcg32_test")
