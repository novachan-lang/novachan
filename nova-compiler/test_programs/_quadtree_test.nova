import std/collections/quadtree

fn cki(got, expected, label)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(got, expected, label)
    if got != expected
        print("FAIL " + label + ": got " + got + " expected " + expected)
        exit(1)

fn main()
    // Build the shared tree: bounding box [0,100) x [0,100), capacity 4
    let t = quadtree.qt_new(0, 0, 100, 100)
    quadtree.qt_insert(t, 10, 10)
    quadtree.qt_insert(t, 20, 20)
    quadtree.qt_insert(t, 80, 80)
    quadtree.qt_insert(t, 50, 50)
    quadtree.qt_insert(t, 15, 15)
    quadtree.qt_insert(t, 90, 10)

    // KAT 1: qt_size == 6
    cki(quadtree.qt_size(t), 6, "kat1: size==6")

    // KAT 2: qt_contains_point(t, 20, 20) == true
    cki(quadtree.qt_contains_point(t, 20, 20), 1, "kat2: contains (20,20)==true")

    // KAT 3: qt_contains_point(t, 99, 99) == false (not inserted)
    cki(quadtree.qt_contains_point(t, 99, 99), 0, "kat3: contains (99,99)==false")

    // KAT 4: qt_query_range(t, 0, 0, 30, 30) -> [10,10],[15,15],[20,20] (len==3)
    let r = quadtree.qt_query_range(t, 0, 0, 30, 30)
    cki(len(r), 3, "kat4: query_range len==3")
    // Sorted order: (10,10), (15,15), (20,20)
    let p0 = r[0]
    let p1 = r[1]
    let p2 = r[2]
    cki(p0[0], 10, "kat4: r[0].x==10")
    cki(p0[1], 10, "kat4: r[0].y==10")
    cki(p1[0], 15, "kat4: r[1].x==15")
    cki(p1[1], 15, "kat4: r[1].y==15")
    cki(p2[0], 20, "kat4: r[2].x==20")
    cki(p2[1], 20, "kat4: r[2].y==20")

    // KAT 5: (80,80) NOT in the query range [0,0,30,30)
    // Already verified by len==3, but confirm 80,80 absent by checking all elements
    let found80 = 0
    let ri = 0
    while ri < len(r)
        let rp = r[ri]
        if rp[0] == 80
            found80 = 1
        ri = ri + 1
    cki(found80, 0, "kat5: (80,80) not in query range [0,0,30,30)")

    // KAT 6: qt_insert(t, 200, 200) == false (outside bounds)
    let inserted = quadtree.qt_insert(t, 200, 200)
    cki(inserted, 0, "kat6: insert outside bounds returns 0")

    // KAT 7: size still 6 after failed insert
    cki(quadtree.qt_size(t), 6, "kat7: size unchanged after out-of-bounds insert")

    // KAT 8: query for all points in the entire bounding box returns 6 points
    let all = quadtree.qt_query_range(t, 0, 0, 100, 100)
    cki(len(all), 6, "kat8: full-range query returns all 6 points")

    // KAT 9: (90,10) found — it lives in the NE quadrant after subdivision
    cki(quadtree.qt_contains_point(t, 90, 10), 1, "kat9: contains (90,10)==true")

    // KAT 10: subdivision correctness — insert enough to force subdivision and query a narrow band
    let t2 = quadtree.qt_new(0, 0, 100, 100)
    quadtree.qt_insert(t2, 5, 5)
    quadtree.qt_insert(t2, 10, 10)
    quadtree.qt_insert(t2, 15, 15)
    quadtree.qt_insert(t2, 20, 20)
    quadtree.qt_insert(t2, 25, 25)
    // 5 points exceeds cap=4, so root must have subdivided
    cki(quadtree.qt_size(t2), 5, "kat10: size==5 after forced subdivision")
    let r2 = quadtree.qt_query_range(t2, 0, 0, 50, 50)
    cki(len(r2), 5, "kat10: query returns all 5 points in NW quadrant")

    print("_quadtree_test passed")

main()
