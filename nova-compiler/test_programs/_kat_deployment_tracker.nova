import forge_deployment_tracker

fn main()
    let d = dt_new()
    d = dt_deploy(d, "v1.0.0", "alice")
    d = dt_deploy(d, "v1.1.0", "bob")
    d = dt_deploy(d, "v1.2.0", "alice")
    assert(dt_deploy_count(d) == 3, "3 deploys")
    assert(dt_current_version(d) == "v1.2.0", "current v1.2.0")

    let ver = dt_version_at(d, 0)
    assert(is_ok(ver), "ver ok")
    assert(unwrap(ver) == "v1.0.0", "v1.0.0")

    let who = dt_deployer_at(d, 1)
    assert(is_ok(who), "who ok")
    assert(unwrap(who) == "bob", "bob")

    let rb = dt_rollback(d)
    assert(is_ok(rb), "rollback ok")
    d = unwrap(rb)
    assert(dt_current_version(d) == "v1.1.0", "rolled back to v1.1.0")
    assert(dt_rollback_count(d) == 1, "1 rollback")

    let st = dt_status_at(d, 2)
    assert(unwrap(st) == "rolled_back", "rolled back status")

    let bad = dt_version_at(d, 10)
    assert(is_err(bad), "out of range")

    print("DEPLOYMENT-TRACKER KAT PASS")
