// showcase_timeline — SHOWCASE + gated integration test.
// Dogfoods this session's std modules together end-to-end:
//   std/time/datetime  (parse ISO, calendar fields, weekday, day arithmetic)
//   std/text/pad        (ljust/rjust column alignment)
//   std/math/stats      (mean/max/min over milestone gaps)
//   std/text/template   ({{key}} header substitution)
//   std/text/wrap       (footer note reflow)
// Integration bugs that isolated KATs miss surface here. Self-checks then prints a report.
import std/time/datetime
import std/text/pad
import std/math/stats
import std/text/template
import std/text/wrap

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": " + str(got) + " != " + str(want))
        exit(1)

fn ckf(label: string, got: float, want: float)
    let d = got - want
    if d < 0.0
        d = 0.0 - d
    if d > 0.001
        print("FAIL " + label + ": " + str(got) + " != " + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": '" + got + "' != '" + want + "'")
        exit(1)

// {{key}} builder — literal braces would trigger NOVA string interpolation.
fn br(k: string) -> string
    return chr(123) + chr(123) + k + chr(125) + chr(125)

fn weekday_name(wd: int) -> string
    let names = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]
    return names[wd]

fn make_ms(date: string, name: string, status: string) -> any
    let m = {}
    m["date"] = date
    m["name"] = name
    m["status"] = status
    m["epoch"] = dt_parse_iso(date + "T00:00:00Z")
    return m

// selection sort a list of milestone dicts by epoch (ascending)
fn sort_by_epoch(ms: any) -> any
    let n = len(ms)
    let out = []
    let used = {}
    let c = 0
    while c < n
        let besti = 0 - 1
        let best = 0
        let i = 0
        while i < n
            if not contains(used, str(i))
                let e = ms[i]["epoch"]
                if besti < 0 or e < best
                    best = e
                    besti = i
            i = i + 1
        used[str(besti)] = true
        out.push(ms[besti])
        c = c + 1
    return out

fn main()
    let ms = []
    ms.push(make_ms("2026-03-15", "Beta", "active"))
    ms.push(make_ms("2026-01-05", "Kickoff", "done"))
    ms.push(make_ms("2026-05-01", "GA Launch", "planned"))
    ms.push(make_ms("2026-02-10", "Design Freeze", "done"))

    // all parsed successfully (epoch > 0)
    let i = 0
    while i < len(ms)
        if ms[i]["epoch"] <= 0
            print("FAIL parse: " + ms[i]["date"])
            exit(1)
        i = i + 1

    let sorted = sort_by_epoch(ms)

    // chronological invariant: epochs strictly increasing after sort
    let j = 1
    while j < len(sorted)
        if sorted[j]["epoch"] <= sorted[j - 1]["epoch"]
            print("FAIL not sorted at " + str(j))
            exit(1)
        j = j + 1

    // first milestone is Kickoff, last is GA Launch
    cks("first", sorted[0]["name"], "Kickoff")
    cks("last", sorted[len(sorted) - 1]["name"], "GA Launch")

    // gaps in days between consecutive milestones
    let gaps = []
    let k = 1
    while k < len(sorted)
        let dsec = sorted[k]["epoch"] - sorted[k - 1]["epoch"]
        gaps.push(dsec / 86400)
        k = k + 1

    // hand-verified gaps: Jan05->Feb10=36, Feb10->Mar15=33 (2026 non-leap), Mar15->May01=47
    cki("gap0", gaps[0], 36)
    cki("gap1", gaps[1], 33)
    cki("gap2", gaps[2], 47)

    // stats over the gaps
    ckf("mean", stats_mean(gaps), 38.6667)
    ckf("max", stats_max(gaps), 47.0)
    ckf("min", stats_min(gaps), 33.0)

    // datetime round-trip: Kickoff calendar fields
    let d0 = dt_from_epoch(sorted[0]["epoch"])
    cki("y", d0["year"], 2026)
    cki("mo", d0["month"], 1)
    cki("day", d0["day"], 5)

    // weekday coherence: the day after any epoch advances weekday by 1 (mod 7)
    let e = sorted[0]["epoch"]
    let wd0 = dt_from_epoch(e)["weekday"]
    let wd1 = dt_from_epoch(dt_add_days(e, 1))["weekday"]
    cki("wd+1", wd1, (wd0 + 1) % 7)

    // pad alignment produces fixed-width columns (length + content, avoids space-counting fragility)
    let lj = ljust("Beta", 14, " ")
    cki("ljust-len", len(lj), 14)
    cks("ljust-head", slice(lj, 0, 4), "Beta")
    let rjv = rjust("47", 4, " ")
    cki("rjust-len", len(rjv), 4)
    cks("rjust-tail", slice(rjv, 2, 4), "47")

    // ---- pretty report (the showcase half) ----
    let vars = {}
    vars["proj"] = "NOVA"
    vars["n"] = str(len(sorted))
    let header = template_render("PROJECT TIMELINE - " + br("proj") + " (" + br("n") + " milestones)", vars)
    print(header)
    print("--------------------------------------------------------")
    print(ljust("MILESTONE", 16, " ") + ljust("DATE", 12, " ") + ljust("DAY", 5, " ") + ljust("STATUS", 10, " ") + rjust("GAP", 5, " "))
    let r = 0
    while r < len(sorted)
        let m = sorted[r]
        let dd = dt_from_epoch(m["epoch"])
        let gapstr = "-"
        if r > 0
            gapstr = str(gaps[r - 1]) + "d"
        let line = ljust(m["name"], 16, " ") + ljust(m["date"], 12, " ") + ljust(weekday_name(dd["weekday"]), 5, " ") + ljust(m["status"], 10, " ") + rjust(gapstr, 5, " ")
        print(line)
        r = r + 1
    print("--------------------------------------------------------")
    let mean_gap = stats_mean(gaps)
    print("Milestones: " + str(len(sorted)) + "   Mean gap: " + str(mean_gap) + " days   Longest: " + str(stats_max(gaps)) + " days")

    let note = "This timeline reporter is written entirely in NOVA and integrates the datetime, pad, stats, template, and wrap standard-library modules into a single self-checking program."
    print("")
    let lines = wrap(note, 56)
    let li = 0
    while li < len(lines)
        print("  " + lines[li])
        li = li + 1

    print("")
    print("showcase_timeline_test passed")
