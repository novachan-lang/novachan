import std/httphdr/http_accept

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got=[" + got + "] want=[" + want + "]")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn ckl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        let gp = got[i]
        let wp = want[i]
        if gp[0] != wp[0] or gp[1] != wp[1]
            print("FAIL " + label + "[" + str(i) + "]: got=[" + str(gp[0]) + "," + str(gp[1]) + "] want=[" + str(wp[0]) + "," + str(wp[1]) + "]")
            exit(1)
        i = i + 1

fn main()
    // ── KAT spec: hac_best with mixed quality ─────────────────────────────────
    let offered1 = ["text/html", "application/json"]
    let best1 = hac_best("text/html;q=0.9, application/json", offered1)
    cks("spec-best-1", best1, "application/json")

    // ── KAT spec: hac_accepts wildcard type/* ─────────────────────────────────
    ckb("spec-accepts-wildtype", hac_accepts("text/*", "text/plain"), true)

    // ── KAT spec: hac_accepts mismatch ────────────────────────────────────────
    ckb("spec-accepts-mismatch", hac_accepts("application/json", "text/html"), false)

    // ── KAT spec: hac_accepts */* ────────────────────────────────────────────
    ckb("spec-accepts-star-star", hac_accepts("*/*", "anything/here"), true)

    // ── KAT spec: hac_best picking higher q ──────────────────────────────────
    let offered2 = ["text/plain", "text/html"]
    let best2 = hac_best("text/plain;q=0.5, text/html;q=0.8", offered2)
    cks("spec-best-2", best2, "text/html")

    // ── hac_parse: empty string -> [] ─────────────────────────────────────────
    let p0 = hac_parse("")
    cki("parse-empty-len", len(p0), 0)

    // ── hac_parse: single type, default q=1000 ───────────────────────────────
    let p1 = hac_parse("application/json")
    cki("parse-single-len", len(p1), 1)
    let e1 = p1[0]
    cks("parse-single-media", e1[0], "application/json")
    cki("parse-single-q", e1[1], 1000)

    // ── hac_parse: q=0.9 parsed as 900 ───────────────────────────────────────
    let p2 = hac_parse("text/html;q=0.9")
    cki("parse-q09-len", len(p2), 1)
    cki("parse-q09-q", p2[0][1], 900)

    // ── hac_parse: sorted descending by q ────────────────────────────────────
    let p3 = hac_parse("text/html;q=0.5, application/json;q=0.9, text/plain")
    // Expected order: text/plain(1000), application/json(900), text/html(500)
    cki("parse-sort-len", len(p3), 3)
    cki("parse-sort-0-q", p3[0][1], 1000)
    cks("parse-sort-0-media", p3[0][0], "text/plain")
    cki("parse-sort-1-q", p3[1][1], 900)
    cks("parse-sort-1-media", p3[1][0], "application/json")
    cki("parse-sort-2-q", p3[2][1], 500)
    cks("parse-sort-2-media", p3[2][0], "text/html")

    // ── hac_parse: ties preserve input order ──────────────────────────────────
    let p4 = hac_parse("a/b, c/d, e/f")
    cki("parse-ties-len", len(p4), 3)
    cks("parse-ties-0", p4[0][0], "a/b")
    cks("parse-ties-1", p4[1][0], "c/d")
    cks("parse-ties-2", p4[2][0], "e/f")

    // ── hac_accepts: exact match ──────────────────────────────────────────────
    ckb("accepts-exact", hac_accepts("text/html", "text/html"), true)

    // ── hac_accepts: q=0 means not acceptable ────────────────────────────────
    ckb("accepts-q0", hac_accepts("text/html;q=0", "text/html"), false)

    // ── hac_accepts: */* accepts everything ──────────────────────────────────
    ckb("accepts-starstar", hac_accepts("*/*", "image/png"), true)

    // ── hac_accepts: type/* wildcard ─────────────────────────────────────────
    ckb("accepts-typestar", hac_accepts("image/*", "image/jpeg"), true)
    ckb("accepts-typestar-no", hac_accepts("image/*", "text/plain"), false)

    // ── hac_accepts: empty header ─────────────────────────────────────────────
    ckb("accepts-empty", hac_accepts("", "text/html"), false)

    // ── hac_best: no offered -> "" ────────────────────────────────────────────
    let empty_off = []
    cks("best-no-offered", hac_best("text/html", empty_off), "")

    // ── hac_best: all q=0 -> "" ───────────────────────────────────────────────
    let off2 = ["text/html"]
    cks("best-all-q0", hac_best("text/html;q=0", off2), "")

    // ── hac_best: */* matches any offered ─────────────────────────────────────
    let off3 = ["application/xml"]
    cks("best-star-star", hac_best("*/*", off3), "application/xml")

    // ── hac_best: type/* preference ───────────────────────────────────────────
    let off4 = ["application/xml", "application/json"]
    cks("best-application-star", hac_best("application/*", off4), "application/xml")

    // ── hac_best: case-insensitive ────────────────────────────────────────────
    let off5 = ["TEXT/HTML"]
    cks("best-case-insensitive", hac_best("text/html", off5), "TEXT/HTML")

    // ── hac_parse: q=1.0 parsed as 1000 ──────────────────────────────────────
    let p5 = hac_parse("text/html;q=1.0")
    cki("parse-q1-q", p5[0][1], 1000)

    // ── hac_parse: q=0 parsed as 0 ───────────────────────────────────────────
    let p6 = hac_parse("text/html;q=0")
    cki("parse-q0-q", p6[0][1], 0)

    // ── hac_parse: q=0.001 parsed as 1 ──────────────────────────────────────
    let p7 = hac_parse("text/html;q=0.001")
    cki("parse-q001-q", p7[0][1], 1)

    print("PASS _http_accept_test")
