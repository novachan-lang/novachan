// KAT test for std/compress/bitwriter
// Tests: write_bits, to_bitstring, bit_count, write_bit, new_reader,
//        read_bits, read_bit, remaining, and round-trip.

import std/compress/bitwriter

// ── KAT 1: bwr_write_bits(5, 3) -> "101" ──────────────────────────────────────
let w1 = bwr_new_writer()
bwr_write_bits(w1, 5, 3)
let bs1 = bwr_to_bitstring(w1)
if bs1 != "101"
    print("FAIL KAT1: expected 101 got " + bs1)
    exit(1)

// ── KAT 2: after write_bits(5,3) then write_bit(0) -> bit_count==4 ────────────
bwr_write_bit(w1, 0)
let cnt1 = bwr_bit_count(w1)
if cnt1 != 4
    print("FAIL KAT2: expected bit_count==4 got " + str(cnt1))
    exit(1)

// ── KAT 3: to_bitstring after extra write_bit is "1010" ──────────────────────
let bs1b = bwr_to_bitstring(w1)
if bs1b != "1010"
    print("FAIL KAT3: expected 1010 got " + bs1b)
    exit(1)

// ── KAT 4: reader read_bits("1011", 3) == 5 ──────────────────────────────────
let r1 = bwr_new_reader("1011")
let v4 = bwr_read_bits(r1, 3)
if v4 != 5
    print("FAIL KAT4: expected 5 got " + str(v4))
    exit(1)

// ── KAT 5: reader read_bit after 3 read == 1, remaining == 0 ─────────────────
let b5 = bwr_read_bit(r1)
if b5 != 1
    print("FAIL KAT5: expected 1 got " + str(b5))
    exit(1)
let rem5 = bwr_remaining(r1)
if rem5 != 0
    print("FAIL KAT5b: expected remaining==0 got " + str(rem5))
    exit(1)

// ── KAT 6: round-trip — write 13 in 4 bits, read back 4 bits == 13 ───────────
let w2 = bwr_new_writer()
bwr_write_bits(w2, 13, 4)
let bs2 = bwr_to_bitstring(w2)
let r2 = bwr_new_reader(bs2)
let v6 = bwr_read_bits(r2, 4)
if v6 != 13
    print("FAIL KAT6: round-trip 13->4bits->read4 expected 13 got " + str(v6))
    exit(1)

// ── KAT 7: round-trip of value 0 in 3 bits ────────────────────────────────────
let w3 = bwr_new_writer()
bwr_write_bits(w3, 0, 3)
let bs3 = bwr_to_bitstring(w3)
if bs3 != "000"
    print("FAIL KAT7a: expected 000 got " + bs3)
    exit(1)
let r3 = bwr_new_reader(bs3)
let v7 = bwr_read_bits(r3, 3)
if v7 != 0
    print("FAIL KAT7b: expected 0 got " + str(v7))
    exit(1)

// ── KAT 8: write multiple values, reader sees them in sequence ─────────────────
// Write 3 (2 bits = "11") then 2 (2 bits = "10") -> full string "1110"
let w4 = bwr_new_writer()
bwr_write_bits(w4, 3, 2)
bwr_write_bits(w4, 2, 2)
let bs4 = bwr_to_bitstring(w4)
if bs4 != "1110"
    print("FAIL KAT8a: expected 1110 got " + bs4)
    exit(1)
let r4 = bwr_new_reader(bs4)
let v8a = bwr_read_bits(r4, 2)
let v8b = bwr_read_bits(r4, 2)
if v8a != 3
    print("FAIL KAT8b: expected first chunk 3 got " + str(v8a))
    exit(1)
if v8b != 2
    print("FAIL KAT8c: expected second chunk 2 got " + str(v8b))
    exit(1)

// ── KAT 9: empty writer ────────────────────────────────────────────────────────
let w5 = bwr_new_writer()
let bs5 = bwr_to_bitstring(w5)
if bs5 != ""
    print("FAIL KAT9a: expected empty string")
    exit(1)
if bwr_bit_count(w5) != 0
    print("FAIL KAT9b: expected bit_count==0")
    exit(1)

// ── KAT 10: remaining decrements correctly ────────────────────────────────────
let r5 = bwr_new_reader("10110")
if bwr_remaining(r5) != 5
    print("FAIL KAT10a: expected remaining==5")
    exit(1)
bwr_read_bit(r5)
if bwr_remaining(r5) != 4
    print("FAIL KAT10b: expected remaining==4")
    exit(1)
bwr_read_bits(r5, 3)
if bwr_remaining(r5) != 1
    print("FAIL KAT10c: expected remaining==1")
    exit(1)
bwr_read_bit(r5)
if bwr_remaining(r5) != 0
    print("FAIL KAT10d: expected remaining==0")
    exit(1)

print("_bitwriter_test passed")
