// _n1_monitor_race_test -- stresses the green monitor() vs task-finish race (CRITICAL-1) at N>1.
// At NOVA_CARRIERS>1, `spawn worker()` may start finishing on another carrier exactly while this
// carrier runs monitor(p): pre-fix, monitor()'s realloc of t->monitors raced finish()'s read of the
// same list (heap corruption / UAF), and a monitor added in the gap before finished=1 was a LOST DOWN
// (receive(m) hangs forever). With the g_green_monitor_lock fix, all K monitors fire exactly once, no
// corruption (ASAN-clean), no hang. At N=1 (cooperative) there is no race -- this just asserts every
// monitor fires. Run at NOVA_CARRIERS=4 (+ASAN) for the real stress; the regression runs it at N=1.
fn worker() -> int
    1

fn main()
    let n = 3000
    let got = 0
    let sum = 0
    let i = 0
    while i < n
        let p = spawn worker()
        let m = monitor(p)
        let st = receive(m)
        sum = sum + st
        got = got + 1
        i = i + 1
    assert(got == n, "all monitors fired (got " + str(got) + " of " + str(n) + ")")
    print("PASS monitor_race: " + str(got) + " monitors fired, exit_status sum=" + str(sum))
