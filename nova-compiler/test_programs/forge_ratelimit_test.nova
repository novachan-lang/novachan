// forge_ratelimit_test -- master plan Phase 2.13: fixed-window rate limit. max=2 per window: the
// 3rd request from the same client -> 429. Also verifies the closure-captured state dict persists
// counts across requests, and that a DIFFERENT client key has its own bucket.
import forge

fn h(req: Request) -> string
    "ok"

fn _req(ip: string) -> Request
    forge.build_request("GET /x HTTP/1.1\r\nX-Forwarded-For: " + ip + "\r\n\r\n", 0)

fn main()
    let a = forge.app()
    forge.use(a, forge.mw_rate_limit(2, 60000))
    forge.get(a, "/x", h)

    // client A: 2 allowed, 3rd blocked
    let a1: Response = forge.dispatch_req(a, _req("1.1.1.1"))
    let a2: Response = forge.dispatch_req(a, _req("1.1.1.1"))
    let a3: Response = forge.dispatch_req(a, _req("1.1.1.1"))
    assert(a1.status == 200, "req 1 allowed")
    assert(a2.status == 200, "req 2 allowed")
    assert(a3.status == 429, "req 3 over limit -> 429 (captured state persisted the count)")
    print("PASS: rate limit triggers after max (state persists across requests)")

    // a DIFFERENT client has its own bucket -> still allowed
    let b1: Response = forge.dispatch_req(a, _req("2.2.2.2"))
    assert(b1.status == 200, "different client -> own bucket, allowed")
    print("PASS: per-client buckets independent")
    print("forge_ratelimit_test passed")
