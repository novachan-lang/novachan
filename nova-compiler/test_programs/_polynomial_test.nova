import std/math/polynomial

// Known-answer tests for std/math/polynomial
// Hand-computed values verified manually.

fn cks(label: str, got: str, want: str)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckf(label: str, got: float, want: float)
    // Check within epsilon 1e-9
    let diff = got - want
    let adiff = diff
    if adiff < 0.0
        adiff = 0.0 - adiff
    if adiff > 0.000000001
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // KAT 1: poly_eval([1,2,3], 2.0) = 17.0
    // p(x)=1+2x+3x^2; p(2)=1+4+12=17
    let c1 = [1, 2, 3]
    let r1 = poly_eval(c1, 2.0)
    ckf("eval([1,2,3],2.0)", r1, 17.0)

    // KAT 2: poly_eval([5], 3.0) = 5.0
    // constant polynomial
    let c2 = [5]
    let r2 = poly_eval(c2, 3.0)
    ckf("eval([5],3.0)", r2, 5.0)

    // KAT 3: poly_derivative([1,2,3]) = [2.0, 6.0]
    // d/dx(1+2x+3x^2) = 2 + 6x
    let c3 = [1, 2, 3]
    let d3 = poly_derivative(c3)
    ckf("derivative([1,2,3])[0]", d3[0] * 1.0, 2.0)
    ckf("derivative([1,2,3])[1]", d3[1] * 1.0, 6.0)
    cki("derivative([1,2,3]) len", len(d3), 2)

    // KAT 4: poly_add([1,2],[3,4,5]) = [4.0,6.0,5.0]
    let a4 = [1, 2]
    let b4 = [3, 4, 5]
    let s4 = poly_add(a4, b4)
    ckf("add([1,2],[3,4,5])[0]", s4[0] * 1.0, 4.0)
    ckf("add([1,2],[3,4,5])[1]", s4[1] * 1.0, 6.0)
    ckf("add([1,2],[3,4,5])[2]", s4[2] * 1.0, 5.0)
    cki("add([1,2],[3,4,5]) len", len(s4), 3)

    // KAT 5: poly_mul([1,1],[1,1]) = [1.0,2.0,1.0]
    // (1+x)*(1+x) = 1+2x+x^2
    let a5 = [1, 1]
    let b5 = [1, 1]
    let m5 = poly_mul(a5, b5)
    ckf("mul([1,1],[1,1])[0]", m5[0] * 1.0, 1.0)
    ckf("mul([1,1],[1,1])[1]", m5[1] * 1.0, 2.0)
    ckf("mul([1,1],[1,1])[2]", m5[2] * 1.0, 1.0)
    cki("mul([1,1],[1,1]) len", len(m5), 3)

    // KAT 6: poly_degree([1,2,3]) = 2
    let deg6 = poly_degree([1, 2, 3])
    cki("degree([1,2,3])", deg6, 2)

    // KAT 7: poly_degree([7]) = 0 (only one term, degree 0)
    let deg7 = poly_degree([7])
    cki("degree([7])", deg7, 0)

    // KAT 8: poly_eval([0,0,1], 3.0) = 9.0
    // p(x)=x^2; p(3)=9
    let c8 = [0, 0, 1]
    let r8 = poly_eval(c8, 3.0)
    ckf("eval([0,0,1],3.0)", r8, 9.0)

    print("_polynomial_test passed")
