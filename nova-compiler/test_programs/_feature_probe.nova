fn greet(name: string, greeting: string = "Hello") -> string
    return greeting + ", " + name + "!"

fn main()
    let r1 = greet("World")
    assert_eq(r1, "Hello, World!")
    let r2 = greet("World", "Hi")
    assert_eq(r2, "Hi, World!")

    let xs = [1, 2, 3, 4, 5]
    let evens = [x for x in xs if x % 2 == 0]
    assert_eq(len(evens), 2)

    let d = {"a": 1, "b": 2, "c": 3}
    let big = {k: d[k] for k in keys(d) if d[k] > 1}
    print(big)

    print("feature_probe: all passed")
