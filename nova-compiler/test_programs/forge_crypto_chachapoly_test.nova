// Forge crypto: ChaCha20-Poly1305 AEAD, gated against the RFC 8439 Sec 2.8.2 KAT (ciphertext + tag)
// + a decrypt round-trip + tamper rejection. Socketless, deterministic.
import forge_crypto

fn main()
    let key = hex_to_blist("808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f")
    let nonce = hex_to_blist("070000004041424344454647")
    let aad = hex_to_blist("50515253c0c1c2c3c4c5c6c7")
    let pt = str_to_blist("Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it.")

    let r = chacha20_poly1305_encrypt(key, nonce, pt, aad)
    let want_ct = "d31a8d34648e60db7b86afbc53ef7ec2a4aded51296e08fea9e2b5a736ee62d63dbea45e8ca9671282fafb69da92728b1a71de0a9e060b2905d6a5b67ecd3b3692ddbd7f2d778b8c9803aee328091b58fab324e4fad675945585808b4831d7bc3ff4def08e4b7a9de576d26586cec64b6116"
    if hex_of(r[0]) != want_ct
        print("FAIL: AEAD ciphertext -> " + hex_of(r[0]))
        exit(1)
    if hex_of(r[1]) != "1ae10b594f09e26a7e902ecbd0600691"
        print("FAIL: AEAD tag -> " + hex_of(r[1]))
        exit(1)

    // decrypt round-trip recovers the plaintext and verifies the tag
    let dec = chacha20_poly1305_decrypt(key, nonce, r[0], aad, r[1])
    if dec[0] != true or hex_of(dec[1]) != hex_of(pt)
        print("FAIL: AEAD decrypt round-trip")
        exit(1)

    // tamper: flip a ciphertext byte -> auth must FAIL
    let bad = []
    let i = 0
    while i < len(r[0])
        push(bad, r[0][i])
        i = i + 1
    bad[0] = bad[0] ^ 1
    let dec2 = chacha20_poly1305_decrypt(key, nonce, bad, aad, r[1])
    if dec2[0] != false
        print("FAIL: AEAD tamper must be rejected")
        exit(1)

    print("PASS forge_crypto_chachapoly (RFC 8439 Sec 2.8.2 AEAD KAT + round-trip + tamper)")
