import forge_gf256 as gf

fn check(cond: bool, label: string)
    if cond == false
        print("FAIL: " + label)

fn main()
    // ---- addition is XOR ----
    check(gf.gf_add(0x53, 0xCA) == 0x99, "add is xor")
    check(gf.gf_add(0xFF, 0xFF) == 0, "a xor a == 0")

    // ---- the canonical FIPS-197 multiplication example: 0x57 * 0x83 == 0xC1 ----
    check(gf.gf_mul(0x57, 0x83) == 0xC1, "AES 0x57*0x83 == 0xC1")
    // 0x57 * 0x13 == 0xFE (another documented AES example)
    check(gf.gf_mul(0x57, 0x13) == 0xFE, "AES 0x57*0x13 == 0xFE")
    // multiply by 1 and 0
    check(gf.gf_mul(0xAB, 1) == 0xAB, "mul by 1")
    check(gf.gf_mul(0xAB, 0) == 0, "mul by 0")
    // xtime: 0x57 * 2 == 0xAE
    check(gf.gf_mul(0x57, 2) == 0xAE, "xtime 0x57 == 0xAE")

    // ---- EXHAUSTIVE: every nonzero byte times its inverse is 1 ----
    let a = 1
    while a < 256
        let inv = gf.gf_inv(a)
        check(gf.gf_mul(a, inv) == 1, "a * inv(a) == 1 for a=" + str(a))
        a = a + 1

    // ---- commutativity + distributivity over a spread of values ----
    let xs = [0, 1, 2, 3, 7, 15, 0x53, 0x57, 0x83, 0xCA, 0xFF, 0xA5]
    let i = 0
    while i < len(xs)
        let j = 0
        while j < len(xs)
            let u = xs[i]
            let v = xs[j]
            // commutative
            check(gf.gf_mul(u, v) == gf.gf_mul(v, u), "commutative " + str(u) + "," + str(v))
            let k = 0
            while k < len(xs)
                let w = xs[k]
                // distributive: u*(v+w) == u*v + u*w
                let lhs = gf.gf_mul(u, gf.gf_add(v, w))
                let rhs = gf.gf_add(gf.gf_mul(u, v), gf.gf_mul(u, w))
                check(lhs == rhs, "distributive")
                k = k + 1
            j = j + 1
        i = i + 1

    // ---- division inverts multiplication: (a*b)/b == a for b != 0 ----
    let b = 1
    while b < 256
        // sample a few a values to keep it quick
        let av = 0
        while av < 256
            let prod = gf.gf_mul(av, b)
            check(gf.gf_div(prod, b) == av, "div inverts mul a=" + str(av) + " b=" + str(b))
            av = av + 37
        b = b + 29

    // ---- log / exp tables consistency ----
    let exp = gf.gf_exp_table()
    let logt = gf.gf_log_table()
    // 3^0 == 1
    check(exp[0] == 1, "exp[0]==1")
    // generator cycles: exp[255] wraps back to 1 (3^255 == 1)
    check(exp[255] == 1, "exp[255]==1 (order 255)")
    // for every nonzero byte, exp[log[b]] == b
    let z = 1
    while z < 256
        let lg = logt[z]
        check(lg >= 0, "log defined for " + str(z))
        check(exp[lg] == z, "exp[log[z]]==z for z=" + str(z))
        z = z + 1
    // multiply via logs matches gf_mul: for nonzero u,v  u*v == exp[(log u + log v) mod 255]
    let u2 = 0x57
    let v2 = 0x83
    let viaLog = exp[(logt[u2] + logt[v2]) % 255]
    check(viaLog == gf.gf_mul(u2, v2), "log-based mul matches")

    print("forge_gf256: all passed")
