fn main()
    let pairs = [[1, "a"], [2, "b"], [3, "c"]]
    let strs = [str(n) + ":" + s for (n, s) in pairs]
    assert_eq(len(strs), 3)
    assert_eq(strs[0], "1:a")
    assert_eq(strs[1], "2:b")
    assert_eq(strs[2], "3:c")

    let d = {"x": 10, "y": 20, "z": 30}
    let doubled = {k: v * 2 for (k, v) in d}
    assert_eq(doubled["x"], 20)
    assert_eq(doubled["y"], 40)
    assert_eq(doubled["z"], 60)

    let big = {k: v for (k, v) in d if v > 15}
    assert_eq(len(keys(big)), 2)
    assert_eq(big["y"], 20)
    assert_eq(big["z"], 30)

    let inverted = {str(v): k for (k, v) in d}
    assert_eq(inverted["10"], "x")
    assert_eq(inverted["20"], "y")

    let nums = [x * 2 for (i, x) in enumerate([10, 20, 30])]
    assert_eq(nums[0], 20)
    assert_eq(nums[1], 40)
    assert_eq(nums[2], 60)

    print("comp_destr_test: all passed")
