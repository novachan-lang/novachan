@cache
fn get_config() -> string
    return "default_config"

@cache("300")
fn get_user(id: int) -> string
    return "user_" + str(id)

fn main()
    assert(get_config__is_cached() == 1, "is cached")
    assert(get_config__cache_ttl() == 60, "default ttl")

    assert(get_user__is_cached() == 1, "user cached")
    assert(get_user__cache_ttl() == 300, "custom ttl")

    let c = get_config()
    assert(c == "default_config", "fn works")

    let u = get_user(42)
    assert(u == "user_42", "user fn works")

    print("CACHE ANNOTATION TEST PASS")
