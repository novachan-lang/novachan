import forge_work_stealing

fn main()
    let ws = ws_new(3)
    assert(ws_worker_count(ws) == 3, "3 workers")

    ws = ws_submit(ws, 0, "task-a")
    ws = ws_submit(ws, 0, "task-b")
    ws = ws_submit(ws, 0, "task-c")
    ws = ws_submit(ws, 1, "task-d")
    assert(ws_total_submitted(ws) == 4, "4 submitted")
    assert(ws_queue_size(ws, 0) == 3, "worker 0 has 3")
    assert(ws_queue_size(ws, 1) == 1, "worker 1 has 1")
    assert(ws_queue_size(ws, 2) == 0, "worker 2 empty")

    let stolen = ws_steal(ws, 2)
    assert(stolen == "task-c", "stole from busiest")
    assert(ws_queue_size(ws, 0) == 2, "worker 0 now 2")
    assert(ws_queue_size(ws, 2) == 1, "worker 2 now 1")
    assert(ws_total_stolen(ws) == 1, "1 stolen")

    let exec1 = ws_execute(ws, 0)
    assert(exec1 == "task-a", "execute FIFO")
    assert(ws_total_completed(ws) == 1, "1 completed")

    let exec2 = ws_execute(ws, 0)
    assert(exec2 == "task-b", "second execute")

    let empty = ws_execute(ws, 0)
    assert(empty == "", "empty worker returns empty")

    let grabbed = ws_steal(ws, 0)
    assert(len(grabbed) > 0, "stole something")
    assert(ws_queue_size(ws, 0) == 1, "worker 0 has 1 after steal")

    print("WORK-STEALING KAT PASS")
