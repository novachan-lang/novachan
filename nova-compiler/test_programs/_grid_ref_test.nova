// _grid_ref_test.nova — KAT for std/geo/grid_ref
import std/geo/grid_ref

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got='" + got + "' want='" + expected + "'")
        exit(1)

fn ckb(label, got, expected)
    let gi = 0
    if got
        gi = 1
    let ei = 0
    if expected
        ei = 1
    if gi != ei
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(ei))
        exit(1)

fn main()
    // gr_letters_to_offset('SU') == [4, 1]
    // Minor letter U: col=4, N_idx=1 (row 3 from top, which is N_idx=4-3=1)
    let off = gr_letters_to_offset("SU")
    cki("gr_letters_to_offset SU E", off[0]*1, 4)
    cki("gr_letters_to_offset SU N", off[1]*1, 1)

    // gr_letters_to_offset('VU') == [4, 1] (same minor letter U)
    let off2 = gr_letters_to_offset("VU")
    cki("gr_letters_to_offset VU E", off2[0]*1, 4)
    cki("gr_letters_to_offset VU N", off2[1]*1, 1)

    // gr_offset_to_letters(4, 1) -> 'VU'
    // major_col=0, major_N=0 -> V; minor_col=4, minor_N=1 -> U
    cks("gr_offset_to_letters(4,1)", gr_offset_to_letters(4, 1), "VU")

    // gr_offset_to_letters(0, 0) -> 'VV'
    // e100=0: major_col=0,major_n_idx=0 -> row_from_top=4 -> alpha[20]='V'
    // minor_col=0,minor_n_idx=0 -> row_from_top=4 -> alpha[20]='V'
    cks("gr_offset_to_letters(0,0)", gr_offset_to_letters(0, 0), "VV")

    // gr_encode(432000, 145000, 3):
    // e100=4, n100=1 -> letters='VU'
    // sub_E = 432000 % 100000 = 32000, scale=100, 32000/100=320 -> '320'
    // sub_N = 145000 % 100000 = 45000, 45000/100=450 -> '450'
    // result = 'VU320450'
    let enc1 = gr_encode(432000, 145000, 3)
    cks("gr_encode(432000,145000,3)", enc1, "VU320450")

    // gr_encode(400000, 100000, 5):
    // e100=4, n100=1 -> 'VU'
    // sub_E=0, scale=1, '00000'; sub_N=0, '00000'
    // result = 'VU0000000000'
    let enc2 = gr_encode(400000, 100000, 5)
    cks("gr_encode(400000,100000,5)", enc2, "VU0000000000")

    // ROUND-TRIP: gr_decode(gr_encode(400000, 100000, 5)) == [400000, 100000]
    let rt = gr_decode(gr_encode(400000, 100000, 5))
    cki("round-trip E", rt[0]*1, 400000)
    cki("round-trip N", rt[1]*1, 100000)

    // ROUND-TRIP at digits=5 with sub-km value
    let rt2 = gr_decode(gr_encode(432100, 145200, 5))
    cki("round-trip2 E", rt2[0]*1, 432100)
    cki("round-trip2 N", rt2[1]*1, 145200)

    // ROUND-TRIP at digits=3 (100m resolution, rounds down to 100m)
    // gr_encode(432300, 145700, 3): sub_E=32300/100=323, sub_N=45700/100=457 -> 'VU323457'
    // gr_decode('VU323457'): e100=4,n100=1; sub_E=323*100=32300, sub_N=457*100=45700
    // -> [432300, 145700]
    let enc3 = gr_encode(432300, 145700, 3)
    cks("gr_encode(432300,145700,3)", enc3, "VU323457")
    let rt3 = gr_decode(enc3)
    cki("round-trip3 E", rt3[0]*1, 432300)
    cki("round-trip3 N", rt3[1]*1, 145700)

    // gr_precision_m(5) == 1
    cki("gr_precision_m(5)", gr_precision_m(5), 1)

    // gr_precision_m(3) == 100
    cki("gr_precision_m(3)", gr_precision_m(3), 100)

    // gr_precision_m(1) == 10000
    cki("gr_precision_m(1)", gr_precision_m(1), 10000)

    // gr_normalize('su 12 34') == 'SU1234'
    cks("gr_normalize", gr_normalize("su 12 34"), "SU1234")

    // gr_normalize already uppercase
    cks("gr_normalize upper", gr_normalize("SU1234"), "SU1234")

    // gr_is_valid('SU1234') == true
    ckb("gr_is_valid SU1234", gr_is_valid("SU1234"), true)

    // gr_is_valid('II1234') == false ('I' excluded)
    ckb("gr_is_valid II1234", gr_is_valid("II1234"), false)

    // gr_is_valid('VU') == false (no digit part or too short after letters)
    ckb("gr_is_valid VU", gr_is_valid("VU"), false)

    // gr_is_valid('VU123') == false (odd digit count)
    ckb("gr_is_valid VU123", gr_is_valid("VU123"), false)

    // gr_is_valid('VU1234') == true
    ckb("gr_is_valid VU1234", gr_is_valid("VU1234"), true)

    // gr_split('VU320450') -> ['VU', '320', '450']
    let sp = gr_split("VU320450")
    cks("gr_split letters", sp[0], "VU")
    cks("gr_split E", sp[1], "320")
    cks("gr_split N", sp[2], "450")

    // Additional round-trip: origin area (0,0) -> 'VV0000000000'
    let enc_origin = gr_encode(0, 0, 5)
    cks("gr_encode(0,0,5)", enc_origin, "VV0000000000")
    let rt4 = gr_decode(enc_origin)
    cki("round-trip origin E", rt4[0]*1, 0)
    cki("round-trip origin N", rt4[1]*1, 0)

    // gr_offset_to_letters -> round-trip with gr_letters_to_offset minor component
    let letters_rt = gr_offset_to_letters(9, 6)
    // abs_e100=9: major_col=9/5=1, minor_col=9-5=4; abs_n100=6: major_N=6/5=1, minor_N=6-5=1
    // major=(1,1)=G (col1,N1->row3: Q,R,S,T,U start at row3... wait: G is col1,row1 from top = N_idx=3
    // Let me trace: major_col=1,major_n_idx=1->row_from_top=4-1=3->slot=3*5+1=16->alpha[16]='R'
    // minor_col=4,minor_n_idx=1->row_from_top=3->slot=19->alpha[19]='U'
    // So letters = 'RU'
    cks("gr_offset_to_letters(9,6)", letters_rt, "RU")

    // Verify gr_decode(gr_encode(900000, 600000, 5)) round-trips
    let rt5 = gr_decode(gr_encode(900000, 600000, 5))
    cki("round-trip large E", rt5[0]*1, 900000)
    cki("round-trip large N", rt5[1]*1, 600000)

    print("PASS _grid_ref_test")
