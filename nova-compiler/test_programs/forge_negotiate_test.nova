// forge_negotiate_test -- content negotiation: accepts / wants_json / wants_html. Lets one route serve a
// browser HTML (forge_html) and an API client JSON (resp_json) off the same handler. Builds Requests with
// custom Accept / X-Requested-With headers via build_request (no socket).
import forge

fn _req_raw(headers: string)
    forge.build_request("GET /x HTTP/1.1\r\n" + headers + "\r\n", 0)

fn _req(accept: string)
    _req_raw("Accept: " + accept + "\r\n")

fn main()
    // a typical browser: prefers HTML, accepts anything via */*
    let browser = _req("text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8")
    assert(forge.wants_html(browser), "browser Accept -> wants_html")
    assert(not forge.wants_json(browser), "browser Accept -> not wants_json")
    assert(forge.accepts(browser, "text/html"), "browser accepts text/html")
    assert(forge.accepts(browser, "application/json"), "browser accepts json via */*")
    print("PASS: browser -> HTML")

    // an API client: only JSON
    let api = _req("application/json")
    assert(forge.wants_json(api), "json-only Accept -> wants_json")
    assert(not forge.wants_html(api), "json-only Accept -> not wants_html")
    assert(forge.accepts(api, "application/json"), "api accepts json")
    assert(not forge.accepts(api, "text/html"), "api does NOT accept html (no */*, no text/*)")
    print("PASS: API client -> JSON")

    // explicit ordering decides the tie
    assert(forge.wants_json(_req("application/json, text/html")), "json before html -> wants_json")
    assert(not forge.wants_json(_req("text/html, application/json")), "html before json -> not wants_json")
    print("PASS: q-order proxy via header position")

    // X-Requested-With: XMLHttpRequest forces JSON even with a browser Accept
    let xhr = _req_raw("Accept: text/html,*/*\r\nX-Requested-With: XMLHttpRequest\r\n")
    assert(forge.wants_json(xhr), "XHR header -> wants_json despite html Accept")
    print("PASS: XHR override")

    // absent Accept = accept anything (RFC 7231); default to serving HTML
    let none = _req_raw("")
    assert(forge.accepts(none, "application/json"), "absent Accept accepts anything")
    assert(not forge.wants_json(none), "absent Accept -> not wants_json (no explicit json)")
    assert(forge.wants_html(none), "absent Accept -> wants_html (sensible default)")
    print("PASS: absent Accept -> default HTML")

    // subtype wildcard
    assert(forge.accepts(_req("text/*"), "text/html"), "text/* wildcard accepts text/html")
    assert(not forge.accepts(_req("text/*"), "application/json"), "text/* does not accept json")
    print("PASS: subtype wildcard")
    print("forge_negotiate_test passed")
