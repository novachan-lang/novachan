import std/lambda/lambda_encode

// ── Check helpers ────────────────────────────────────────────────────────────

fn cki(label, got, want)
    if got != want
        print("FAIL _lambda_encode_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    if got != want
        let gs = "false"
        let ws = "false"
        if got
            gs = "true"
        if want
            ws = "true"
        print("FAIL _lambda_encode_test " + label + ": got=" + gs + " want=" + ws)
        exit(1)

// ── Term structural equality helper ─────────────────────────────────────────

fn ckt(label, a, b)
    // recursive structural term equality check
    let eq = _term_eq(a, b)
    if eq == 0
        print("FAIL _lambda_encode_test " + label + ": terms not equal")
        exit(1)

fn _term_eq(a, b) -> int
    let ta = a[0]
    let tb = b[0]
    if ta != tb
        return 0
    if ta == "var"
        if a[1] == b[1]
            return 1
        return 0
    if ta == "lam"
        return _term_eq(a[1], b[1])
    if _term_eq(a[1], b[1]) == 0
        return 0
    return _term_eq(a[2], b[2])

fn main()
    // KAT 1: pred(3) = 2
    let pred3 = lambda_encode.lnc_app(lambda_encode.lnc_church_pred(), lambda_encode.lnc_num(3))
    let pred3_nf = lambda_encode.lnc_normalize(pred3)
    cki("pred3", lambda_encode.lnc_decode_num(pred3_nf), 2)

    // KAT 2: pred(1) = 0
    let pred1 = lambda_encode.lnc_app(lambda_encode.lnc_church_pred(), lambda_encode.lnc_num(1))
    let pred1_nf = lambda_encode.lnc_normalize(pred1)
    cki("pred1", lambda_encode.lnc_decode_num(pred1_nf), 0)

    // KAT 3: pred(0) = 0 (Church predecessor of 0 is 0)
    let pred0 = lambda_encode.lnc_app(lambda_encode.lnc_church_pred(), lambda_encode.lnc_num(0))
    let pred0_nf = lambda_encode.lnc_normalize(pred0)
    cki("pred0", lambda_encode.lnc_decode_num(pred0_nf), 0)

    // KAT 4: iszero(0) = true (decodes to true = lam(lam(var(1))))
    let iz0 = lambda_encode.lnc_app(lambda_encode.lnc_church_iszero(), lambda_encode.lnc_num(0))
    let iz0_nf = lambda_encode.lnc_normalize(iz0)
    ckt("iszero0_true", iz0_nf, lambda_encode.lnc_lam(lambda_encode.lnc_lam(lambda_encode.lnc_var(1))))

    // KAT 5: iszero(2) = false (decodes to false = lam(lam(var(0))))
    let iz2 = lambda_encode.lnc_app(lambda_encode.lnc_church_iszero(), lambda_encode.lnc_num(2))
    let iz2_nf = lambda_encode.lnc_normalize(iz2)
    ckt("iszero2_false", iz2_nf, lambda_encode.lnc_lam(lambda_encode.lnc_lam(lambda_encode.lnc_var(0))))

    // KAT 6: sub(5, 2) = 3
    let sub52 = lambda_encode.lnc_app(lambda_encode.lnc_app(lambda_encode.lnc_church_sub(), lambda_encode.lnc_num(5)), lambda_encode.lnc_num(2))
    let sub52_nf = lambda_encode.lnc_normalize(sub52)
    cki("sub5m2", lambda_encode.lnc_decode_num(sub52_nf), 3)

    // KAT 7: sub(3, 3) = 0
    let sub33 = lambda_encode.lnc_app(lambda_encode.lnc_app(lambda_encode.lnc_church_sub(), lambda_encode.lnc_num(3)), lambda_encode.lnc_num(3))
    let sub33_nf = lambda_encode.lnc_normalize(sub33)
    cki("sub3m3", lambda_encode.lnc_decode_num(sub33_nf), 0)

    // KAT 8: length of [1,2,3] decodes to Church 3 -> int 3
    let lst3 = lambda_encode.lnc_from_list([1, 2, 3])
    let len3t = lambda_encode.lnc_app(lambda_encode.lnc_length(), lst3)
    let len3_nf = lambda_encode.lnc_normalize(len3t)
    cki("length3", lambda_encode.lnc_decode_num(len3_nf), 3)

    // KAT 9: length of [] = 0
    let lst0 = lambda_encode.lnc_from_list([])
    let len0t = lambda_encode.lnc_app(lambda_encode.lnc_length(), lst0)
    let len0_nf = lambda_encode.lnc_normalize(len0t)
    cki("length0", lambda_encode.lnc_decode_num(len0_nf), 0)

    // KAT 10: length of [7] = 1
    let lst1 = lambda_encode.lnc_from_list([7])
    let len1t = lambda_encode.lnc_app(lambda_encode.lnc_length(), lst1)
    let len1_nf = lambda_encode.lnc_normalize(len1t)
    cki("length1", lambda_encode.lnc_decode_num(len1_nf), 1)

    print("PASS _lambda_encode_test")
