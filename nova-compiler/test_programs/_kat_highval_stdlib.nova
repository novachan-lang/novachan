// _kat_highval_stdlib — combined KAT for 6 new pure-NOVA stdlib modules:
//   std/adt/maybe.nova                (new)  prefix may_
//   std/pipeline/stage_runner.nova    (new)  prefix stg_
//   std/collections/twoq_cache.nova   (new)  prefix tq_
//   std/text/fuzzy_match.nova         (new)  prefix fz_
//   std/data/table.nova               (new)  prefix tbl_
//   std/schedule/interval_scheduler.nova (new) prefix isc_
//
// Note on scope: the task brief that produced this file originally asked
// for std/math/fraction.nova and std/math/matrix_ops.nova (exact-rational
// and small-matrix helpers) plus std/cache-style LRU and std/regex-style
// glob modules. A pre-build duplicate survey found that:
//   - std/rational/rfrac_core.nova + rfrac_arith.nova already implement
//     exact rational arithmetic (add/sub/mul/div/reduce/to_string).
//   - std/matrix/matmul.nova + mattranspose.nova already implement the
//     exact same dict{r,c,d}-represented matrix ops (make/get/set/add/mul/
//     transpose/identity).
//   - std/cache/lru.nova already implements a fixed-capacity LRU cache.
//   - std/regex/glob.nova (+ std/parsing/glob.nova, wildcard.nova) already
//     implement shell-glob matching.
// Building near-duplicates of any of these would violate the "survey
// before adding" rule, so all four were swapped for genuinely new,
// non-overlapping modules (maybe/stage_runner/twoq_cache/fuzzy_match)
// while std/data/table.nova was kept — it is a stateful, schema-enforced
// table BUILDER (insert-based) that complements, rather than duplicates,
// std/data/tabular.nova's pure query functions over freeform row-dicts.

import std/adt/maybe
import std/pipeline/stage_runner
import std/collections/twoq_cache
import std/text/fuzzy_match
import std/data/table
import std/schedule/interval_scheduler

fn ck(name, got, want)
    if str(got) != str(want)
        print("FAIL " + name + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("ok " + name)

fn double_it(x)
    return x * 2

fn is_even(x)
    return x % 2 == 0

fn half_if_even(x)
    if x % 2 == 0
        return may_some(x / 2)
    return may_none()

fn stage_validate(v)
    if v < 0
        return stg_err("negative input")
    return stg_ok(v)

fn stage_double(v)
    return stg_ok(v * 2)

fn stage_add_ten(v)
    return stg_ok(v + 10)

fn main()
    // ================= std/adt/maybe (may_) =================
    let s1 = may_some(5)
    ck("may_is_some s1", may_is_some(s1), true)
    ck("may_is_none s1", may_is_none(s1), false)
    let n1 = may_none()
    ck("may_is_none n1", may_is_none(n1), true)
    ck("may_is_some n1", may_is_some(n1), false)
    ck("may_get s1 default", may_get(s1, 99), 5)
    ck("may_get n1 default", may_get(n1, 99), 99)
    ck("may_unwrap s1", may_unwrap(s1), 5)
    let mapped = may_map(s1, double_it)
    ck("may_map some to_str", may_to_str(mapped), "Some(10)")
    let mapped_none = may_map(n1, double_it)
    ck("may_map none to_str", may_to_str(mapped_none), "None")
    let chained_even = may_and_then(may_some(4), half_if_even)
    ck("may_and_then even", may_to_str(chained_even), "Some(2)")
    let chained_odd = may_and_then(may_some(3), half_if_even)
    ck("may_and_then odd", may_to_str(chained_odd), "None")
    let alt = may_or_else(n1, may_some(7))
    ck("may_or_else none", may_to_str(alt), "Some(7)")
    let alt2 = may_or_else(s1, may_some(7))
    ck("may_or_else some", may_to_str(alt2), "Some(5)")
    let filtered_keep = may_filter(may_some(4), is_even)
    ck("may_filter keep", may_to_str(filtered_keep), "Some(4)")
    let filtered_drop = may_filter(may_some(3), is_even)
    ck("may_filter drop", may_to_str(filtered_drop), "None")

    // ================= std/pipeline/stage_runner (stg_) =================
    let p = stg_new()
    stg_add(p, "validate", stage_validate)
    stg_add(p, "double", stage_double)
    stg_add(p, "add_ten", stage_add_ten)
    ck("stg_count", stg_count(p), 3)
    let names = stg_names(p)
    ck("stg_names len", len(names), 3)
    ck("stg_names[0]", names[0], "validate")

    let r1 = stg_run(p, 5)
    ck("stg_run ok status", r1["stg_status"], "ok")
    ck("stg_run ok value", r1["stg_value"], 20)
    ck("stg_run ok failed_at", r1["stg_failed_at"], "")
    ck("stg_run ok trace len", len(r1["stg_trace"]), 3)
    ck("stg_is_ok r1", stg_is_ok(r1), true)
    ck("stg_is_error r1", stg_is_error(r1), false)

    let r2 = stg_run(p, 0 - 1)
    ck("stg_run err status", r2["stg_status"], "error")
    ck("stg_run err value", r2["stg_value"], "negative input")
    ck("stg_run err failed_at", r2["stg_failed_at"], "validate")
    ck("stg_run err trace len", len(r2["stg_trace"]), 1)
    ck("stg_is_ok r2", stg_is_ok(r2), false)
    ck("stg_is_error r2", stg_is_error(r2), true)

    // ================= std/collections/twoq_cache (tq_) =================
    let c = tq_new(3)
    tq_put(c, "a", 1)
    tq_put(c, "b", 2)
    ck("tq get miss a", tq_get(c, "a"), 0)
    tq_put(c, "a", 10)
    ck("tq has a after promote", tq_has(c, "a"), true)
    ck("tq has b after promote", tq_has(c, "b"), true)
    ck("tq get b (a1in hit)", tq_get(c, "b"), 2)
    tq_put(c, "c", 3)
    ck("tq size after evict b", tq_size(c), 2)
    ck("tq has b evicted", tq_has(c, "b"), false)
    let keys1 = tq_keys(c)
    ck("tq keys1 len", len(keys1), 2)
    ck("tq keys1[0]", keys1[0], "c")
    ck("tq keys1[1]", keys1[1], "a")
    ck("tq evict_count after 2 evictions", tq_evict_count(c), 2)
    ck("tq get a (am touch)", tq_get(c, "a"), 10)
    tq_put(c, "d", 4)
    ck("tq size after d", tq_size(c), 2)
    tq_put(c, "b", 99)
    ck("tq size after b promote", tq_size(c), 3)
    tq_put(c, "e", 5)
    ck("tq size after e", tq_size(c), 3)
    tq_put(c, "c", 77)
    ck("tq has a evicted from am", tq_has(c, "a"), false)
    ck("tq has b still", tq_has(c, "b"), true)
    ck("tq has c promoted", tq_has(c, "c"), true)
    ck("tq has d evicted", tq_has(c, "d"), false)
    ck("tq has e", tq_has(c, "e"), true)
    ck("tq size final", tq_size(c), 3)
    ck("tq evict_count final", tq_evict_count(c), 5)
    let keys2 = tq_keys(c)
    ck("tq keys2 len", len(keys2), 3)
    ck("tq keys2[0]", keys2[0], "e")
    ck("tq keys2[1]", keys2[1], "b")
    ck("tq keys2[2]", keys2[2], "c")
    ck("tq get b touch", tq_get(c, "b"), 99)
    let keys3 = tq_keys(c)
    ck("tq keys3[0]", keys3[0], "e")
    ck("tq keys3[1]", keys3[1], "c")
    ck("tq keys3[2]", keys3[2], "b")

    // ================= std/text/fuzzy_match (fz_) =================
    ck("fz_match hit", fz_match("gmc", "get_module_config"), true)
    ck("fz_match miss", fz_match("xyz", "get_module_config"), false)
    ck("fz_match empty pattern", fz_match("", "anything"), true)

    let pos = fz_positions("abc", "aabbcc")
    ck("fz_positions len", len(pos), 3)
    ck("fz_positions[0]", pos[0], 0)
    ck("fz_positions[1]", pos[1], 2)
    ck("fz_positions[2]", pos[2], 4)
    let pos2 = fz_positions("xyz", "aabbcc")
    ck("fz_positions no match len", len(pos2), 0)

    ck("fz_score match", fz_score("abc", "aabbcc"), 9)
    ck("fz_score no match", fz_score("xyz", "aabbcc"), 0 - 1)
    ck("fz_score empty pattern", fz_score("", "abc"), 0)

    let candidates = ["foo", "get_module_config", "abc"]
    ck("fz_best_match", fz_best_match("gmc", candidates), "get_module_config")

    let filtered = fz_filter("ab", ["xaxbx", "abx", "xxab"])
    ck("fz_filter len", len(filtered), 3)
    ck("fz_filter[0]", filtered[0], "abx")
    ck("fz_filter[1]", filtered[1], "xxab")
    ck("fz_filter[2]", filtered[2], "xaxbx")

    // ================= std/data/table (tbl_) =================
    let t = tbl_new(["name", "age"])
    let row1 = {}
    row1["name"] = "Alice"
    row1["age"] = 30
    tbl_insert(t, row1)
    let row2 = {}
    row2["name"] = "Bob"
    row2["age"] = 25
    tbl_insert(t, row2)
    let row3 = {}
    row3["name"] = "Carol"
    row3["age"] = 30
    tbl_insert(t, row3)

    ck("tbl_count", tbl_count(t), 3)
    let ages = tbl_column_values(t, "age")
    ck("tbl ages len", len(ages), 3)
    ck("tbl ages[0]", ages[0], 30)
    ck("tbl ages[1]", ages[1], 25)

    let where30 = tbl_where(t, "age", 30)
    ck("tbl_where count", tbl_count(where30), 2)

    let selected = tbl_select(t, ["name"])
    ck("tbl_select count", tbl_count(selected), 3)
    let sel_names = tbl_column_values(selected, "name")
    ck("tbl_select names[0]", sel_names[0], "Alice")
    ck("tbl_select names[1]", sel_names[1], "Bob")
    ck("tbl_select names[2]", sel_names[2], "Carol")

    let csv = tbl_to_csv(t)
    ck("tbl_to_csv", csv, "name,age\nAlice,30\nBob,25\nCarol,30")

    let t2 = tbl_new(["name"])
    let row4 = {}
    row4["name"] = "Dan, Jr."
    tbl_insert(t2, row4)
    let csv2 = tbl_to_csv(t2)
    ck("tbl_to_csv quoting", csv2, "name\n\"Dan, Jr.\"")

    // ================= std/schedule/interval_scheduler (isc_) =================
    let sch = isc_new()
    isc_add_job(sch, "heartbeat", 10, 0)
    isc_add_job(sch, "backup", 100, 50)
    ck("isc_job_count", isc_job_count(sch), 2)

    let due1 = isc_due_jobs(sch, 5)
    ck("due1 len", len(due1), 1)
    ck("due1[0]", due1[0], "heartbeat")
    ck("isc_run_count heartbeat 1", isc_run_count(sch, "heartbeat"), 1)
    ck("isc_next_run heartbeat 1", isc_next_run(sch, "heartbeat"), 10)

    let due2 = isc_due_jobs(sch, 35)
    ck("due2 len", len(due2), 1)
    ck("due2[0]", due2[0], "heartbeat")
    ck("isc_run_count heartbeat 2", isc_run_count(sch, "heartbeat"), 2)
    ck("isc_next_run heartbeat 2", isc_next_run(sch, "heartbeat"), 40)

    let due3 = isc_due_jobs(sch, 60)
    ck("due3 len", len(due3), 2)
    ck("due3[0]", due3[0], "heartbeat")
    ck("due3[1]", due3[1], "backup")
    ck("isc_run_count heartbeat 3", isc_run_count(sch, "heartbeat"), 3)
    ck("isc_run_count backup 1", isc_run_count(sch, "backup"), 1)
    ck("isc_next_run heartbeat 3", isc_next_run(sch, "heartbeat"), 70)
    ck("isc_next_run backup 1", isc_next_run(sch, "backup"), 150)

    ck("isc_next_run unknown", isc_next_run(sch, "nope"), 0 - 1)
    ck("isc_run_count unknown", isc_run_count(sch, "nope"), 0)

    let removed = isc_remove_job(sch, "backup")
    ck("isc_remove_job backup", removed, true)
    ck("isc_job_count after remove", isc_job_count(sch), 1)
    let removed2 = isc_remove_job(sch, "backup")
    ck("isc_remove_job backup again", removed2, false)

    isc_add_job(sch, "heartbeat", 5, 100)
    ck("isc_next_run heartbeat updated", isc_next_run(sch, "heartbeat"), 100)
    ck("isc_job_count still 1", isc_job_count(sch), 1)

    print("ALL PASS")
