import std/lambda/lambda_combinators

// Integer check helper.
fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// Structural term equality check helper.
fn ckt(label, a, b)
    if lambda_combinators.lcb_term_eq(a, b) == 0
        print("FAIL " + label + ": terms not equal")
        exit(1)

fn main()
    // KAT 1: B I I var(4) = var(4)  (B = composition: B f g x = f(g x), B I I x = I(I x) = x)
    let bii_x = lambda_combinators.lcb_app(lambda_combinators.lcb_app(lambda_combinators.lcb_app(lambda_combinators.lcb_B(), lambda_combinators.lcb_I()), lambda_combinators.lcb_I()), lambda_combinators.lcb_var(4))
    let r1 = lambda_combinators.lcb_normalize(bii_x, 10000)
    ckt("BIIx=x", r1, lambda_combinators.lcb_var(4))

    // KAT 2: C K a b = K b a = b  (C = flip: C f x y = f y x)
    let ckab = lambda_combinators.lcb_app(lambda_combinators.lcb_app(lambda_combinators.lcb_app(lambda_combinators.lcb_C(), lambda_combinators.lcb_K()), lambda_combinators.lcb_var(1)), lambda_combinators.lcb_var(2))
    let r2 = lambda_combinators.lcb_normalize(ckab, 10000)
    ckt("CKab=b", r2, lambda_combinators.lcb_var(2))

    // KAT 3: W K x = K x x = x  (W = duplication: W f x = f x x)
    let wkx = lambda_combinators.lcb_app(lambda_combinators.lcb_app(lambda_combinators.lcb_W(), lambda_combinators.lcb_K()), lambda_combinators.lcb_var(5))
    let r3 = lambda_combinators.lcb_normalize(wkx, 10000)
    ckt("WKx=x", r3, lambda_combinators.lcb_var(5))

    // KAT 4: I var(0) = var(0)
    let ix = lambda_combinators.lcb_app(lambda_combinators.lcb_I(), lambda_combinators.lcb_var(0))
    let r4 = lambda_combinators.lcb_normalize(ix, 10000)
    ckt("Ix=x", r4, lambda_combinators.lcb_var(0))

    // KAT 5: term_eq basic sanity
    cki("teq_var_same", lambda_combinators.lcb_term_eq(lambda_combinators.lcb_var(3), lambda_combinators.lcb_var(3)), 1)
    cki("teq_var_diff", lambda_combinators.lcb_term_eq(lambda_combinators.lcb_var(3), lambda_combinators.lcb_var(4)), 0)

    // KAT 6: S K K x = x  (SKK = I)
    let skkx = lambda_combinators.lcb_app(lambda_combinators.lcb_app(lambda_combinators.lcb_app(lambda_combinators.lcb_S(), lambda_combinators.lcb_K()), lambda_combinators.lcb_K()), lambda_combinators.lcb_var(3))
    let r6 = lambda_combinators.lcb_normalize(skkx, 10000)
    ckt("SKKx=x", r6, lambda_combinators.lcb_var(3))

    // KAT 7: omega and Y exist (just structural checks — omega diverges, Y diverges on app)
    let om = lambda_combinators.lcb_omega()
    cki("omega_tag", om[0] == "lam", 1)
    let yc = lambda_combinators.lcb_Y()
    cki("Y_tag", yc[0] == "lam", 1)

    print("PASS _lambda_combinators_test")

main()
