import forge_notification_router

fn main()
    let s = nr_new()
    assert(nr_channel_count(s) == 0, "no channels yet")

    s = nr_add_channel(s, "ops-email", "email")
    s = nr_add_channel(s, "ops-slack", "slack")
    s = nr_add_channel(s, "audit-webhook", "webhook")
    s = nr_add_channel(s, "oncall-sms", "sms")
    assert(nr_channel_count(s) == 4, "4 channels")
    assert(nr_has_channel(s, "ops-slack") == 1, "has ops-slack")
    assert(nr_has_channel(s, "nope") == 0, "no nope channel")

    let rbad = nr_add_rule(s, "bad-rule", "critical", "no-such-channel")
    assert(is_err(rbad), "rule to unknown channel fails")

    let r1 = nr_add_rule(s, "critical-to-sms", "critical", "oncall-sms")
    assert(is_ok(r1), "add critical rule")
    let r2 = nr_add_rule(s, "warning-to-slack", "warning", "ops-slack")
    assert(is_ok(r2), "add warning rule")
    let r3 = nr_add_rule(s, "info-to-email", "info", "ops-email")
    assert(is_ok(r3), "add info rule")
    assert(nr_rule_count(s) == 3, "3 rules")

    let noroute = nr_route(s, "debug", "should not route")
    assert(is_err(noroute), "no rule for debug severity")

    let route1 = nr_route(s, "critical", "disk full")
    assert(is_ok(route1), "critical routed")
    assert(unwrap(route1) == "oncall-sms", "critical goes to sms")

    let route2 = nr_route(s, "warning", "cpu high")
    assert(is_ok(route2), "warning routed")
    assert(unwrap(route2) == "ops-slack", "warning goes to slack")

    let route3 = nr_route(s, "critical", "db down")
    assert(unwrap(route3) == "oncall-sms", "second critical also sms")

    assert(nr_sent_count(s) == 3, "3 notifications sent")
    let sc = nr_channel_sent(s, "oncall-sms")
    assert(is_ok(sc), "channel sent count ok")
    assert(unwrap(sc) == 2, "2 sent to sms channel")

    let sc2 = nr_channel_sent(s, "ops-email")
    assert(unwrap(sc2) == 0, "0 sent to email channel")

    let scbad = nr_channel_sent(s, "no-such-channel")
    assert(is_err(scbad), "sent count for unknown channel fails")

    let last = nr_last_message(s)
    assert(is_ok(last), "last message ok")
    assert(unwrap(last) == "db down", "last message is db down")

    print("NOTIFICATION-ROUTER KAT PASS")
