import std/math/roundmode

fn cki(label: str, got: int, expected: int)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn main()
    // rm_toward_zero: truncate toward zero
    cki("rm_toward_zero(2.9)", rm_toward_zero(2.9), 2)
    cki("rm_toward_zero(-2.9)", rm_toward_zero(-2.9), -2)

    // rm_floor: round toward negative infinity
    cki("rm_floor(2.9)", rm_floor(2.9), 2)
    cki("rm_floor(-2.1)", rm_floor(-2.1), -3)

    // rm_ceil: round toward positive infinity
    cki("rm_ceil(2.1)", rm_ceil(2.1), 3)
    cki("rm_ceil(-2.9)", rm_ceil(-2.9), -2)

    // rm_half_up: half away from zero
    cki("rm_half_up(2.5)", rm_half_up(2.5), 3)
    cki("rm_half_up(2.4)", rm_half_up(2.4), 2)
    cki("rm_half_up(-2.5)", rm_half_up(-2.5), -3)

    // rm_half_even: banker's rounding
    cki("rm_half_even(2.5)", rm_half_even(2.5), 2)
    cki("rm_half_even(3.5)", rm_half_even(3.5), 4)
    cki("rm_half_even(2.4)", rm_half_even(2.4), 2)

    print("_roundmode_test passed")
