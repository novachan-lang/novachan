// String formatting test suite

fn make_fmt(spec: string) -> string
    let lb = chr(123)
    let rb = chr(125)
    lb + spec + rb

fn make_fmt2(s1: string, spec1: string, s2: string, spec2: string, s3: string) -> string
    let lb = chr(123)
    let rb = chr(125)
    s1 + lb + spec1 + rb + s2 + lb + spec2 + rb + s3

fn make_fmt3(s1: string, spec1: string, s2: string, spec2: string, s3: string, spec3: string, s4: string) -> string
    let lb = chr(123)
    let rb = chr(125)
    s1 + lb + spec1 + rb + s2 + lb + spec2 + rb + s3 + lb + spec3 + rb + s4

fn main()
    // Basic positional formatting
    let tpl3 = make_fmt3("", "", " + ", "", " = ", "", "")
    print(format(tpl3, [1, 2, 3]))

    // Integer formatting
    print(format(make_fmt(":d"), [42]))
    print(format(make_fmt(":05d"), [42]))
    print(format(make_fmt(":>10d"), [42]))

    // Hex, oct, bin
    print(hex(255))
    print(oct(255))
    print(bin(255))

    // String padding
    print(format(make_fmt(":>10"), ["hello"]))
    print(format(make_fmt(":<10"), ["hello"]))
    print(format(make_fmt(":^10"), ["hello"]))
    print(format(make_fmt(":*>10"), ["hello"]))

    // Pad left/right/center functions
    print(pad_left("42", 5, ord("0")))
    print(pad_right("hi", 8, ord(".")))
    print(center("NOVA", 10, ord("-")))

    // Mixed types
    let tpl_mixed = make_fmt2("name=", "", " age=", "", "")
    print(format(tpl_mixed, ["Alice", 30]))

    // Escaped braces
    let lb = chr(123)
    let rb = chr(125)
    let tpl_esc = "set = " + lb + lb + rb + rb
    print(format(tpl_esc, []))

    print("FORMAT TESTS PASSED")
