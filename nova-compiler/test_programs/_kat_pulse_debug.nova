import forge_pulse
import std/data/dataframe

fn main()
    let names = ["Alice", "Bob", "Carol", "Dave", "Eve"]
    let depts = ["eng", "eng", "sales", "sales", "eng"]
    let salaries = [100, 120, 80, 90, 110]
    let bonuses = [10, 15, 8, 12, 11]
    let df = df_new(["name", "dept", "salary", "bonus"], [names, depts, salaries, bonuses])
    print("nrows={df_nrows(df)}")
    let sal_col = df_col(df, "salary")
    print("salary col len={len(sal_col)}")
    let i = 0
    while i < len(sal_col)
        print("  sal[{i}]={sal_col[i]}")
        i = i + 1
    let desc = pulse_describe(df)
    print("desc keys={keys(desc)}")
    if contains(desc, "salary")
        let sd = desc["salary"]
        print("salary desc={sd}")
    else
        print("NO salary key in desc!")
    print("DEBUG DONE")
