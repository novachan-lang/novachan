import std/collections/unionfind

fn cki(got, expected, label)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(got, expected, label)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn main()
    // --- uf_new(5): 5 singletons ---
    let uf = unionfind.uf_new(5)
    cki(unionfind.uf_count(uf), 5, "initial count")
    cki(unionfind.uf_find(uf, 0), 0, "find(0) is own root")
    cki(unionfind.uf_find(uf, 4), 4, "find(4) is own root")

    // --- After union(0,1) and union(2,3): count drops to 3 ---
    unionfind.uf_union(uf, 0, 1)
    unionfind.uf_union(uf, 2, 3)
    cki(unionfind.uf_count(uf), 3, "count after union(0,1)+union(2,3)")

    // --- connected(0,1) true; connected(0,2) false ---
    cki(unionfind.uf_connected(uf, 0, 1), 1, "0 and 1 connected")
    cki(unionfind.uf_connected(uf, 0, 2), 0, "0 and 2 not connected")
    cki(unionfind.uf_connected(uf, 2, 3), 1, "2 and 3 connected")

    // --- union(1,2): merges {0,1} and {2,3} -> count 2 ---
    unionfind.uf_union(uf, 1, 2)
    cki(unionfind.uf_count(uf), 2, "count after union(1,2)")

    // --- now 0,1,2,3 are all connected; 4 is still separate ---
    cki(unionfind.uf_connected(uf, 0, 3), 1, "0 and 3 connected after merge")
    cki(unionfind.uf_connected(uf, 1, 3), 1, "1 and 3 connected after merge")
    cki(unionfind.uf_connected(uf, 0, 4), 0, "0 and 4 not connected (4 is singleton)")
    cki(unionfind.uf_find(uf, 4), 4, "find(4) still own root")

    // --- union of an already-connected pair is a no-op on count ---
    unionfind.uf_union(uf, 0, 3)
    cki(unionfind.uf_count(uf), 2, "no-op union doesn't change count")

    // --- path compression: find after chain should still return root ---
    let uf2 = unionfind.uf_new(6)
    unionfind.uf_union(uf2, 0, 1)
    unionfind.uf_union(uf2, 1, 2)
    unionfind.uf_union(uf2, 2, 3)
    unionfind.uf_union(uf2, 3, 4)
    let root4 = unionfind.uf_find(uf2, 4)
    let root0 = unionfind.uf_find(uf2, 0)
    cki(root4, root0, "path-compressed: find(4)==find(0) in chain 0-1-2-3-4")
    cki(unionfind.uf_connected(uf2, 0, 4), 1, "0 and 4 connected via chain")
    cki(unionfind.uf_connected(uf2, 0, 5), 0, "0 and 5 not connected (5 separate)")
    cki(unionfind.uf_count(uf2), 2, "chain 0-4 + singleton 5 = 2 sets")

    // --- single element union-find ---
    let uf3 = unionfind.uf_new(1)
    cki(unionfind.uf_count(uf3), 1, "single elem count=1")
    cki(unionfind.uf_find(uf3, 0), 0, "single elem find=0")
    cki(unionfind.uf_connected(uf3, 0, 0), 1, "element connected to itself")

    print("_unionfind_test passed")

main()
