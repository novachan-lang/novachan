// KAT for std/matrix/matadjugate — adjugate, cofactor matrix, round-trip (tol 0.0001).
import std/matrix/matadjugate

fn _ck_fabs(x: float) -> float
    if x < 0.0
        return 0.0 - x
    x

fn ckf(label: string, got: float, want: float)
    let d = _ck_fabs(got - want)
    if d > 0.0001
        print("FAIL matadjugate " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        print("FAIL matadjugate " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn mk22(a: float, b: float, c: float, e: float) -> any
    let data = []
    push(data, a)
    push(data, b)
    push(data, c)
    push(data, e)
    madj_make(2, 2, data)

fn main()
    // KAT 1: madj_adjugate([[1,2],[3,4]]) == [[4,-2],[-3,1]]
    // adj[0][0]=cofactor(1,1)=4, adj[0][1]=cofactor(1,0)=-3 wait—
    // adj = transpose of cofactor matrix.
    // cofactor_matrix = [[C00, C01],[C10, C11]]
    //   C00=(-1)^0*det([[4]])=4, C01=(-1)^1*det([[3]])=-3
    //   C10=(-1)^1*det([[2]])=-2, C11=(-1)^0*det([[1]])=1
    // cofactor_matrix = [[4,-3],[-2,1]]
    // adjugate = transpose = [[4,-2],[-3,1]]
    let A22 = mk22(1.0, 2.0, 3.0, 4.0)
    let adj22 = madj_adjugate(A22)
    ckf("adj22_00", madj_get(adj22, 0, 0), 4.0)
    ckf("adj22_01", madj_get(adj22, 0, 1), -2.0)
    ckf("adj22_10", madj_get(adj22, 1, 0), -3.0)
    ckf("adj22_11", madj_get(adj22, 1, 1), 1.0)

    // KAT 2: ROUND-TRIP A*adj(A) == det(A)*I for [[1,2],[3,4]]
    // det = 1*4-2*3 = -2
    // det*I = [[-2,0],[0,-2]]
    let ok22 = madj_verify(A22, 0.0001)
    ckb("verify_2x2", ok22, true)

    // KAT 3: madj_det([[1,2],[3,4]]) == -2.0
    let det22 = madj_det(A22)
    ckf("det_2x2", det22, -2.0)

    // KAT 4: madj_inverse_via_adj([[4,7],[2,6]]) == [[0.6,-0.7],[-0.2,0.4]]
    // det=4*6-7*2=24-14=10, adj=[[6,-7],[-2,4]]
    // inv = adj/10 = [[0.6,-0.7],[-0.2,0.4]]
    let Binv = mk22(4.0, 7.0, 2.0, 6.0)
    let inv22 = madj_inverse_via_adj(Binv)
    ckf("inv22_00", madj_get(inv22, 0, 0), 0.6)
    ckf("inv22_01", madj_get(inv22, 0, 1), -0.7)
    ckf("inv22_10", madj_get(inv22, 1, 0), -0.2)
    ckf("inv22_11", madj_get(inv22, 1, 1), 0.4)

    // KAT 5: madj_cofactor([[1,2],[3,4]], 0, 0) == 4.0
    let cof00 = madj_cofactor(A22, 0, 0)
    ckf("cofactor_00", cof00, 4.0)

    // KAT 6: madj_cofactor([[1,2],[3,4]], 0, 1) == -3.0
    let cof01 = madj_cofactor(A22, 0, 1)
    ckf("cofactor_01", cof01, -3.0)

    // KAT 7: 3x3 adjugate round-trip — [[1,0,2],[-1,3,1],[2,1,1]]
    // Build it.
    let v33 = []
    push(v33, 1.0)
    push(v33, 0.0)
    push(v33, 2.0)
    push(v33, -1.0)
    push(v33, 3.0)
    push(v33, 1.0)
    push(v33, 2.0)
    push(v33, 1.0)
    push(v33, 1.0)
    let A33 = madj_make(3, 3, v33)
    let ok33 = madj_verify(A33, 0.0001)
    ckb("verify_3x3", ok33, true)

    // KAT 8: madj_minor([[1,2],[3,4]], 0, 0) == 4.0
    let mn00 = madj_minor(A22, 0, 0)
    ckf("minor_00", mn00, 4.0)

    // KAT 9: madj_minor([[1,2],[3,4]], 1, 1) == 1.0
    let mn11 = madj_minor(A22, 1, 1)
    ckf("minor_11", mn11, 1.0)

    // KAT 10: identity adjugate == identity
    let id2 = madj_identity(2)
    let adj_id = madj_adjugate(id2)
    ckf("adj_id_00", madj_get(adj_id, 0, 0), 1.0)
    ckf("adj_id_01", madj_get(adj_id, 0, 1), 0.0)
    ckf("adj_id_10", madj_get(adj_id, 1, 0), 0.0)
    ckf("adj_id_11", madj_get(adj_id, 1, 1), 1.0)

    // KAT 11: madj_cofactor_matrix element check for [[1,2],[3,4]]
    let cm = madj_cofactor_matrix(A22)
    // C[0][0]=4, C[0][1]=-3, C[1][0]=-2, C[1][1]=1
    ckf("cm_00", madj_get(cm, 0, 0), 4.0)
    ckf("cm_01", madj_get(cm, 0, 1), -3.0)
    ckf("cm_10", madj_get(cm, 1, 0), -2.0)
    ckf("cm_11", madj_get(cm, 1, 1), 1.0)

    // KAT 12: inverse of identity is identity
    let inv_id = madj_inverse_via_adj(id2)
    ckf("inv_id_00", madj_get(inv_id, 0, 0), 1.0)
    ckf("inv_id_01", madj_get(inv_id, 0, 1), 0.0)
    ckf("inv_id_10", madj_get(inv_id, 1, 0), 0.0)
    ckf("inv_id_11", madj_get(inv_id, 1, 1), 1.0)

    print("PASS _matadjugate_test")
