import forge_orm
fn main()
    let db = unwrap(orm_open_with_pool("mysql://root:root@127.0.0.1:3306/nova_test", 2))
    _ = orm_exec(db, "DROP TABLE IF EXISTS myzero", [])
    _ = orm_exec(db, "CREATE TABLE myzero (tag text, v int)", [])
    // A: bound param 0  vs  B: literal 0 in SQL
    _ = orm_exec(db, "INSERT INTO myzero (tag,v) VALUES (?,?)", ["bound0", 0])
    _ = orm_exec(db, "INSERT INTO myzero (tag,v) VALUES (?,?)", ["bound1", 1])
    _ = orm_exec(db, "INSERT INTO myzero (tag,v) VALUES ('literal0', 0)", [])
    _ = orm_exec(db, "INSERT INTO myzero (tag,v) VALUES (?,?)", ["boundneg", 0 - 5])
    _ = orm_exec(db, "INSERT INTO myzero (tag,v) VALUES (?,?)", ["boundstr0", "0"])
    let rows = orm_all(db, "SELECT tag, v, (v IS NULL) AS isnull FROM myzero ORDER BY tag", [])
    print("what MySQL actually STORED:")
    for r in rows
        print("  tag={str(r["tag"])}  v={str(r["v"])}  IS NULL={str(r["isnull"])}")
    _ = orm_exec(db, "DROP TABLE IF EXISTS myzero", [])
    orm_close(db)
