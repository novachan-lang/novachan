import forge_snapshot_store

fn main()
    let ss = snap_new()
    assert(snap_count(ss) == 0, "starts empty")
    assert(snap_latest_version(ss) == 0, "no latest")

    ss = snap_save(ss, 5, "state-at-5")
    assert(snap_count(ss) == 1, "1 snapshot")
    assert(snap_has(ss, 5) == 1, "has v5")
    assert(snap_has(ss, 3) == 0, "no v3")

    let r1 = snap_load(ss, 5)
    assert(r1["found"] == 1, "found v5")
    assert(r1["state"] == "state-at-5", "state correct")

    let r2 = snap_load(ss, 99)
    assert(r2["found"] == 0, "v99 not found")

    ss = snap_save(ss, 10, "state-at-10")
    ss = snap_save(ss, 7, "state-at-7")
    assert(snap_count(ss) == 3, "3 snapshots")
    assert(snap_latest_version(ss) == 10, "latest = 10")

    let latest = snap_latest(ss)
    assert(latest["found"] == 1, "latest found")
    assert(latest["version"] == 10, "latest version 10")
    assert(latest["state"] == "state-at-10", "latest state")

    let empty = snap_new()
    let empty_latest = snap_latest(empty)
    assert(empty_latest["found"] == 0, "empty latest not found")

    print("SNAPSHOT-STORE KAT PASS")
