// forge_html_test -- the HTML-as-function view layer: escaping, element/void builders, the page wrapper,
// child joining, and (critically) the XSS-prevention guarantee that attribute values are always escaped.
import forge_html

fn main()
    let q = chr(34)   // a double-quote

    // esc(): all five HTML-significant chars, and a GLOBAL replace (every '&' escaped, not just the first).
    assert(forge_html.esc("a&b<c>d") == "a&amp;b&lt;c&gt;d", "esc handles & < >")
    assert(forge_html.esc("x&y&z") == "x&amp;y&amp;z", "esc replaces ALL occurrences (global)")
    assert(forge_html.esc(q + "'") == "&quot;&#39;", "esc handles quote and apostrophe")

    // el(): structure + escaped attribute value.
    assert(forge_html.el("p", {}, "hi") == "<p>hi</p>", "el builds a simple element")
    assert(forge_html.div({"class": "card"}, "x") == "<div class=" + q + "card" + q + ">x</div>", "el escapes/quotes an attribute")

    // XSS: a hostile attribute value cannot break out of the attribute (the '"><script>' classic).
    let evil = forge_html.div({"class": q + "><script>alert(1)</script>"}, "ok")
    assert(find(evil, "<script>") < 0, "attribute injection: no raw <script> escapes into the markup")
    assert(find(evil, "&lt;script&gt;") >= 0, "the hostile attr value is escaped to entities")
    assert(find(evil, "&quot;") >= 0, "the breakout quote is escaped")

    // void elements + boolean attribute.
    assert(forge_html.input_tag({"disabled": ""}) == "<input disabled>", "empty value -> boolean attribute")
    let im = forge_html.img("/a.png", "logo")
    assert(starts_with(im, "<img ") and ends_with(im, ">") and find(im, "</") < 0, "img is a void element (no close tag)")
    assert(find(im, "src=" + q + "/a.png" + q) >= 0 and find(im, "alt=" + q + "logo" + q) >= 0, "img attrs present + escaped")

    // anchor convenience: href is an attribute -> auto-escaped.
    assert(forge_html.link("/home", "Home") == "<a href=" + q + "/home" + q + ">Home</a>", "link builds an anchor")

    // composition: nested builders + join_children for a collection.
    let items = ["<li>1</li>", "<li>2</li>", "<li>3</li>"]
    assert(forge_html.ul({}, forge_html.join_children(items)) == "<ul><li>1</li><li>2</li><li>3</li></ul>", "join_children + ul compose a list")
    assert(forge_html.ul({}, forge_html.li({}, "a") + forge_html.li({}, "b")) == "<ul><li>a</li><li>b</li></ul>", "nested li builders compose")

    // page(): a full HTML5 document with an escaped title.
    let doc = forge_html.page("Hi & Bye", "", "<p>body</p>")
    assert(starts_with(doc, "<!doctype html><html><head>"), "page starts with the doctype + head")
    assert(find(doc, "<title>Hi &amp; Bye</title>") >= 0, "page title is escaped")
    assert(find(doc, "<body><p>body</p></body></html>") >= 0, "page body is placed verbatim")

    // raw(): the explicit escape opt-out passes markup through unchanged.
    assert(forge_html.raw("<b>x</b>") == "<b>x</b>", "raw() is verbatim passthrough")

    print("PASS: esc/el/void/link/page/join + attribute-injection prevention")
    print("forge_html_test passed")
