import std/barcode/postnet

fn chki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn chks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=[" + got + "] want=[" + want + "]")
        exit(1)

// ── KAT: postnet_check ───────────────────────────────────────────────────────

// KAT-1: "12345" -> sum=15, (10-5)%10=5
chki("pc_12345", postnet_check("12345"), 5)

// KAT-2: "55555" -> sum=25, (10-5)%10=5
// NOTE: task spec said check==0 but math gives 5. 25%10=5, (10-5)%10=5.
chki("pc_55555", postnet_check("55555"), 5)

// KAT-3: "00000" -> sum=0, (10-0)%10=0
chki("pc_00000", postnet_check("00000"), 0)

// KAT-4: "99999" -> sum=45, (10-5)%10=5
chki("pc_99999", postnet_check("99999"), 5)

// KAT-5: "10000" -> sum=1, check=9
chki("pc_10000", postnet_check("10000"), 9)

// KAT-6: "50000" -> sum=5, check=5
chki("pc_50000", postnet_check("50000"), 5)

// KAT-7: single "0" -> check=0
chki("pc_0", postnet_check("0"), 0)

// KAT-8: single "5" -> sum=5, check=5
chki("pc_5", postnet_check("5"), 5)

// KAT-9: single "1" -> sum=1, check=9
chki("pc_1", postnet_check("1"), 9)

// ── KAT: postnet_encode ──────────────────────────────────────────────────────

// KAT-10: result starts and ends with "1" (frame bars)
let enc12345 = postnet_encode("12345")
chks("pe_12345_start", enc12345[0], "1")
// Last char: enc12345[len-1]
let elen = len(enc12345)
chks("pe_12345_end", enc12345[elen-1], "1")

// KAT-11: 5-digit ZIP -> length = 2 + (5+1)*5 = 32
chki("pe_12345_len", len(enc12345), 32)

// KAT-12: known full encoding of "12345" with check digit 5
// digits: 1->00011, 2->00101, 3->00110, 4->01001, 5->01010
// check=5->01010
// full: 1 + 00011 + 00101 + 00110 + 01001 + 01010 + 01010 + 1
chks("pe_12345_full", enc12345, "10001100101001100100101010010101")

// KAT-13: "00000" -> check=0, all digits encode as 11000
// 1 + 11000 + 11000 + 11000 + 11000 + 11000 + 11000 + 1 = 1+6*11000+1
// len = 32
let enc00000 = postnet_encode("00000")
chki("pe_00000_len", len(enc00000), 32)
// "1" + "11000"*6 + "1" = 32 chars
// "1"+"11000"+"11000"+"11000"+"11000"+"11000"+"11000"+"1"
// = "11100011000110001100011000110001"
let want00 = "11100011000110001100011000110001"
chki("pe_00000_len_verify", len(want00), 32)
chks("pe_00000_val", enc00000, want00)

// KAT-14: each digit encodes to exactly 5 chars (verify structure of "12345")
// After the leading "1", 6 groups of 5, then "1"
// chars 1..5 = digit 1 pattern = "00011"
let s1 = slice(enc12345, 1, 6)
chks("pe_12345_d1", s1, "00011")
// chars 6..10 = digit 2 pattern = "00101"
let s2 = slice(enc12345, 6, 11)
chks("pe_12345_d2", s2, "00101")

// KAT-15: "99999" check=5; verify deterministic
let enc99999 = postnet_encode("99999")
chki("pe_99999_len", len(enc99999), 32)
// digit 9 pattern = "10100", check 5 = "01010"
// "1"+"10100"*5+"01010"+"1"
let s99 = slice(enc99999, 1, 6)
chks("pe_99999_d9", s99, "10100")

// ── KAT: planet_encode ───────────────────────────────────────────────────────

// KAT-16: PLANET complement - digit 0 -> "00111" (complement of "11000")
let plenc = planet_encode("12345")
chki("pl_12345_len", len(plenc), 32)

// First digit (1) in PLANET = "11100" (complement of "00011")
let pls1 = slice(plenc, 1, 6)
chks("pl_12345_d1", pls1, "11100")

// KAT-17: PLANET starts and ends with frame bar "1"
chks("pl_start", plenc[0], "1")
let pllen = len(plenc)
chks("pl_end", plenc[pllen-1], "1")

// KAT-18: "00000" in PLANET: digit 0 -> "00111", check 0 -> "00111"
let plenc00 = planet_encode("00000")
chki("pl_00000_len", len(plenc00), 32)
let pl00d0 = slice(plenc00, 1, 6)
chks("pl_00000_d0", pl00d0, "00111")

print("PASS _postnet_test")
