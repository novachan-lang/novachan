fn main()
    let names = ["alice", "bob", "charlie"]
    let d = {name: len(name) for name in names}
    print(d)
    assert_eq(d["alice"], 5)
    assert_eq(d["bob"], 3)
    assert_eq(d["charlie"], 7)

    let nums = [1, 2, 3, 4, 5]
    let sq = {str(n): n * n for n in nums}
    assert_eq(sq["3"], 9)
    assert_eq(sq["5"], 25)

    let filtered = {str(n): n for n in nums if n > 3}
    assert_eq(len(filtered), 2)
    assert_eq(filtered["4"], 4)
    assert_eq(filtered["5"], 5)

    let empty = {str(x): x for x in nums if x > 100}
    assert_eq(len(empty), 0)

    print("ALL DICT COMPREHENSION TESTS PASSED")
