// KAT for std/physics/dynamics — Newton's laws of motion.
import std/physics/dynamics

// approx — float equality within 0.0001 tolerance.
fn approx(a, b)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < 0.0001

fn ckf(label, got, want)
    if not approx(got, want)
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // force: F = m * a
    ckf("force(10,2)", force(10.0, 2.0), 20.0)
    ckf("force(5,3)", force(5.0, 3.0), 15.0)
    ckf("force(0,9.81)", force(0.0, 9.81), 0.0)

    // weight: W = m * 9.81
    ckf("weight(1)", weight(1.0), 9.81)
    ckf("weight(10)", weight(10.0), 98.1)
    ckf("weight(0)", weight(0.0), 0.0)

    // acceleration: a = F / m
    ckf("acceleration(20,10)", acceleration(20.0, 10.0), 2.0)
    ckf("acceleration(15,5)", acceleration(15.0, 5.0), 3.0)
    ckf("acceleration(9.81,1)", acceleration(9.81, 1.0), 9.81)

    // newton_second: same as force
    ckf("newton_second(10,2)", newton_second(10.0, 2.0), 20.0)
    ckf("newton_second(3,4)", newton_second(3.0, 4.0), 12.0)

    // g constant
    ckf("g()", g(), 9.81)

    print("PASS _dynamics_test")
