// KAT test for std/dsp/peak.nova
//
// Hand-computed reference values:
//   pk_find_peaks([1.0,3.0,1.0,4.0,1.0]) == [1,3]
//     index 1: 3>1 and 3>1 -> peak
//     index 3: 4>1 and 4>1 -> peak
//   pk_find_peaks([1.0,2.0,3.0]) == []
//     monotonic, no interior index has value > both neighbors
//   pk_find_valleys([3.0,1.0,3.0]) == [1]
//     index 1: 1<3 and 1<3 -> valley
//   pk_max_index([1.0,5.0,3.0]) == 1
//     max is 5.0 at index 1
//   pk_zero_crossings([1.0,-1.0,1.0,-1.0]) == 3
//     pairs: (1,-1)->cross, (-1,1)->cross, (1,-1)->cross = 3
//   pk_zero_crossings([1.0,2.0,3.0]) == 0
//     all positive, no sign change
//   pk_count([1.0,3.0,1.0,3.0,1.0]) == 2
//     peaks at index 1 and 3

import std/dsp/peak

// cki: compare two ints, print FAIL + exit(1) on mismatch
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// cki_list: compare two int lists element-wise
fn cki_list(label: string, got: list, want: list)
    let ng = len(got)
    let nw = len(want)
    if ng != nw
        print("FAIL " + label + " length: got " + str(ng) + " want " + str(nw))
        exit(1)
    let i = 0
    while i < nw
        let gv = got[i]
        let wv = want[i]
        if gv != wv
            print("FAIL " + label + "[" + str(i) + "]: got " + str(gv) + " want " + str(wv))
            exit(1)
        i = i + 1

// ckf: compare two floats within eps 0.001
fn ckf(label: string, got: float, want: float)
    let diff = got - want
    if diff < 0.0
        diff = 0.0 - diff
    if diff > 0.001
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // ── KAT 1: pk_find_peaks([1.0,3.0,1.0,4.0,1.0]) == [1,3] ─────────────────
    let xs1 = []
    push(xs1, 1.0)
    push(xs1, 3.0)
    push(xs1, 1.0)
    push(xs1, 4.0)
    push(xs1, 1.0)
    let want1 = []
    push(want1, 1)
    push(want1, 3)
    let r1 = pk_find_peaks(xs1)
    cki_list("find_peaks_basic", r1, want1)

    // ── KAT 2: pk_find_peaks([1.0,2.0,3.0]) == [] (monotonic) ─────────────────
    let xs2 = []
    push(xs2, 1.0)
    push(xs2, 2.0)
    push(xs2, 3.0)
    let want2 = []
    let r2 = pk_find_peaks(xs2)
    cki_list("find_peaks_monotonic", r2, want2)

    // ── KAT 3: pk_find_valleys([3.0,1.0,3.0]) == [1] ──────────────────────────
    let xs3 = []
    push(xs3, 3.0)
    push(xs3, 1.0)
    push(xs3, 3.0)
    let want3 = []
    push(want3, 1)
    let r3 = pk_find_valleys(xs3)
    cki_list("find_valleys_basic", r3, want3)

    // ── KAT 4: pk_max_index([1.0,5.0,3.0]) == 1 ───────────────────────────────
    let xs4 = []
    push(xs4, 1.0)
    push(xs4, 5.0)
    push(xs4, 3.0)
    let r4 = pk_max_index(xs4)
    cki("max_index_basic", r4, 1)

    // ── KAT 5: pk_zero_crossings([1.0,-1.0,1.0,-1.0]) == 3 ───────────────────
    // pairs: (1,-1)->cross, (-1,1)->cross, (1,-1)->cross = 3
    let xs5 = []
    push(xs5, 1.0)
    push(xs5, 0.0 - 1.0)
    push(xs5, 1.0)
    push(xs5, 0.0 - 1.0)
    let r5 = pk_zero_crossings(xs5)
    cki("zero_crossings_alternating", r5, 3)

    // ── KAT 6: pk_zero_crossings([1.0,2.0,3.0]) == 0 ─────────────────────────
    let xs6 = []
    push(xs6, 1.0)
    push(xs6, 2.0)
    push(xs6, 3.0)
    let r6 = pk_zero_crossings(xs6)
    cki("zero_crossings_none", r6, 0)

    // ── KAT 7: pk_count([1.0,3.0,1.0,3.0,1.0]) == 2 ──────────────────────────
    let xs7 = []
    push(xs7, 1.0)
    push(xs7, 3.0)
    push(xs7, 1.0)
    push(xs7, 3.0)
    push(xs7, 1.0)
    let r7 = pk_count(xs7)
    cki("count_two_peaks", r7, 2)

    // ── KAT 8: pk_find_peaks([2.0,2.0,2.0]) == [] (flat, no strict maxima) ───
    let xs8 = []
    push(xs8, 2.0)
    push(xs8, 2.0)
    push(xs8, 2.0)
    let want8 = []
    let r8 = pk_find_peaks(xs8)
    cki_list("find_peaks_flat", r8, want8)

    // ── KAT 9: pk_max_index([9.0,1.0,1.0]) == 0 (max at first) ───────────────
    let xs9 = []
    push(xs9, 9.0)
    push(xs9, 1.0)
    push(xs9, 1.0)
    let r9 = pk_max_index(xs9)
    cki("max_index_first", r9, 0)

    // ── KAT 10: pk_find_valleys([1.0,3.0,1.0]) == [] (valley would need <1.0) -
    // index 1 is 3.0 > both neighbors 1.0 -- it's a peak, not a valley
    // index 0 and 2 are endpoints -- never valleys
    let xs10 = []
    push(xs10, 1.0)
    push(xs10, 3.0)
    push(xs10, 1.0)
    let want10 = []
    let r10 = pk_find_valleys(xs10)
    cki_list("find_valleys_no_valley", r10, want10)

    print("_peak_test passed")
