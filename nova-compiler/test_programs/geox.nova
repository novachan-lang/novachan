fn _deg2rad(deg)
  deg * 3.14159265358979 / 180.0

fn haversine(lat1, lon1, lat2, lon2)
  let r = 6371000
  let dlat = _deg2rad(lat2 - lat1)
  let dlon = _deg2rad(lon2 - lon1)
  let rlat1 = _deg2rad(lat1)
  let rlat2 = _deg2rad(lat2)
  let a = sin(dlat / 2.0) * sin(dlat / 2.0) + cos(rlat1) * cos(rlat2) * sin(dlon / 2.0) * sin(dlon / 2.0)
  let c = 2.0 * asin(sqrt(a))
  r * c

fn geo_point(lat, lon)
  [lat, lon]

fn geo_distance(p1, p2)
  haversine(p1[0], p1[1], p2[0], p2[1])

fn geo_midpoint(p1, p2)
  [(p1[0] + p2[0]) / 2.0, (p1[1] + p2[1]) / 2.0]

fn geo_bounding_box(points)
  let min_lat = points[0][0]
  let max_lat = points[0][0]
  let min_lon = points[0][1]
  let max_lon = points[0][1]
  for p in points
    if p[0] < min_lat
      min_lat = p[0]
    if p[0] > max_lat
      max_lat = p[0]
    if p[1] < min_lon
      min_lon = p[1]
    if p[1] > max_lon
      max_lon = p[1]
  [[min_lat, min_lon], [max_lat, max_lon]]

fn main()
  let ny = geo_point(40.7128, -74.006)
  let la = geo_point(33.9425, -118.408)
  let dist = geo_distance(ny, la)
  let dist_km = dist / 1000.0
  assert(dist_km > 3900.0 and dist_km < 4000.0, "NY-LA ~3950km")

  let london = geo_point(51.5074, -0.1278)
  let paris = geo_point(48.8566, 2.3522)
  let lp_dist = geo_distance(london, paris) / 1000.0
  assert(lp_dist > 330.0 and lp_dist < 350.0, "London-Paris ~340km")

  let same = geo_distance(ny, ny)
  assert(same == 0.0, "same point = 0")

  let mid = geo_midpoint(ny, la)
  assert(mid[0] > 35.0 and mid[0] < 40.0, "midpoint lat")

  let bb = geo_bounding_box([ny, la, london])
  assert(bb[0][0] < 35.0, "bbox min lat")
  assert(bb[1][0] > 50.0, "bbox max lat")

  print("geox: all passed")
