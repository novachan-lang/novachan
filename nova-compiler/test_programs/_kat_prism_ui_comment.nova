import prism_ui_comment
import prism_node

fn check(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL: " + name)
    return 1

fn main()
    let mut fails = 0

    // --- ctor + accessors ---
    let c1 = prism_ui_comment.prism_cm_comment("alice", "hello world", "2m ago")
    fails += check("ctor c1 author", prism_ui_comment.prism_cm_author(c1) == "alice")
    fails += check("ctor c1 text", prism_ui_comment.prism_cm_text(c1) == "hello world")
    fails += check("ctor c1 time", prism_ui_comment.prism_cm_time(c1) == "2m ago")

    let c2 = prism_ui_comment.prism_cm_comment("bob", "second comment", "")
    fails += check("ctor c2 author", prism_ui_comment.prism_cm_author(c2) == "bob")
    fails += check("ctor c2 text", prism_ui_comment.prism_cm_text(c2) == "second comment")
    fails += check("ctor c2 time empty", prism_ui_comment.prism_cm_time(c2) == "")

    let c3 = prism_ui_comment.prism_cm_comment("dave", "third comment", "5m ago")
    fails += check("ctor c3 author", prism_ui_comment.prism_cm_author(c3) == "dave")

    // --- render happy path, with time ---
    let r1 = prism_ui_comment.prism_cm_render(c1)
    fails += check("render c1 (with time) is_ok", is_ok(r1))
    if is_ok(r1)
        let n1 = unwrap(r1)
        fails += check("render c1 kind is stack", prism_node.prism_node_kind_str(n1) == "stack")
        let kids1 = prism_node.prism_node_children(n1)
        fails += check("render c1 has 2 children", len(kids1) == 2)
        let header1 = kids1[0]
        let header1_kids = prism_node.prism_node_children(header1)
        fails += check("render c1 header kind is band", prism_node.prism_node_kind_str(header1) == "band")
        fails += check("render c1 header has 2 children (author+time)", len(header1_kids) == 2)

    // --- render happy path, without time ---
    let r2 = prism_ui_comment.prism_cm_render(c2)
    fails += check("render c2 (without time) is_ok", is_ok(r2))
    if is_ok(r2)
        let n2 = unwrap(r2)
        let kids2 = prism_node.prism_node_children(n2)
        fails += check("render c2 has 2 children", len(kids2) == 2)
        let header2 = kids2[0]
        let header2_kids = prism_node.prism_node_children(header2)
        fails += check("render c2 header has 1 child (author only)", len(header2_kids) == 1)

    // --- render errors ---
    let c_empty_author = prism_ui_comment.prism_cm_comment("", "text", "now")
    let r3 = prism_ui_comment.prism_cm_render(c_empty_author)
    fails += check("render empty author is_err", is_err(r3))

    let c_empty_text = prism_ui_comment.prism_cm_comment("carol", "", "now")
    let r4 = prism_ui_comment.prism_cm_render(c_empty_text)
    fails += check("render empty text is_err", is_err(r4))

    // --- thread happy path ---
    let thread_list = [c1, c2, c3]
    let rt1 = prism_ui_comment.prism_cm_thread(thread_list)
    fails += check("thread([c1,c2,c3]) is_ok", is_ok(rt1))
    if is_ok(rt1)
        let tnode1 = unwrap(rt1)
        fails += check("thread kind is stack", prism_node.prism_node_kind_str(tnode1) == "stack")
        let tkids1 = prism_node.prism_node_children(tnode1)
        fails += check("thread([c1,c2,c3]) has 3 children", len(tkids1) == 3)

    let single_list = [c1]
    let rt2 = prism_ui_comment.prism_cm_thread(single_list)
    fails += check("thread([c1]) is_ok", is_ok(rt2))
    if is_ok(rt2)
        let tnode2 = unwrap(rt2)
        let tkids2 = prism_node.prism_node_children(tnode2)
        fails += check("thread([c1]) has 1 child", len(tkids2) == 1)

    // --- thread errors ---
    let empty_list = []
    let rt3 = prism_ui_comment.prism_cm_thread(empty_list)
    fails += check("thread empty list is_err", is_err(rt3))

    let bad_list = [c1, "not a comment"]
    let rt4 = prism_ui_comment.prism_cm_thread(bad_list)
    fails += check("thread bad element is_err", is_err(rt4))

    // --- reply_preview happy path, short text (no truncation) ---
    let c4 = prism_ui_comment.prism_cm_comment("erin", "short", "1m ago")
    let rp1 = prism_ui_comment.prism_cm_reply_preview(c4, 10)
    fails += check("reply_preview short is_ok", is_ok(rp1))
    if is_ok(rp1)
        let rpn1 = unwrap(rp1)
        fails += check("reply_preview short kind is band", prism_node.prism_node_kind_str(rpn1) == "band")
        let rpkids1 = prism_node.prism_node_children(rpn1)
        fails += check("reply_preview short has 3 children", len(rpkids1) == 3)

    // --- reply_preview happy path, exact-length (no truncation) ---
    let rp2 = prism_ui_comment.prism_cm_reply_preview(c4, 5)
    fails += check("reply_preview exact-length is_ok", is_ok(rp2))
    if is_ok(rp2)
        let rpn2 = unwrap(rp2)
        let rpkids2 = prism_node.prism_node_children(rpn2)
        fails += check("reply_preview exact-length has 3 children", len(rpkids2) == 3)

    // --- reply_preview happy path, long text (truncated) ---
    let c5 = prism_ui_comment.prism_cm_comment("frank", "this is a very long comment text that exceeds max", "10m ago")
    let rp3 = prism_ui_comment.prism_cm_reply_preview(c5, 5)
    fails += check("reply_preview long (truncated) is_ok", is_ok(rp3))
    if is_ok(rp3)
        let rpn3 = unwrap(rp3)
        let rpkids3 = prism_node.prism_node_children(rpn3)
        fails += check("reply_preview long has 3 children", len(rpkids3) == 3)

    // --- reply_preview errors ---
    let c_empty_author2 = prism_ui_comment.prism_cm_comment("", "text", "now")
    let rp4 = prism_ui_comment.prism_cm_reply_preview(c_empty_author2, 10)
    fails += check("reply_preview empty author is_err", is_err(rp4))

    let rp5 = prism_ui_comment.prism_cm_reply_preview(c4, 0)
    fails += check("reply_preview max_len zero is_err", is_err(rp5))

    let rp6 = prism_ui_comment.prism_cm_reply_preview(c4, -5)
    fails += check("reply_preview max_len negative is_err", is_err(rp6))

    let total = 34
    print(str(total - fails) + "/" + str(total) + " assertions passed")
    if fails > 0
        print("FAIL: " + str(fails) + " assertion(s) failed")
