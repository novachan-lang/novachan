// VARIANCE, NOVA-way: inferred, invisible, surfaced only in errors.
fn sum_any(xs: list<any>) -> int
    let t = 0
    for v in xs
        t = t + v
    return t

fn apply(f: fn, v: int) -> int
    return f(v)

fn wide(x: any) -> int
    return 1

fn main()
    // COVARIANCE: a list<int> used where list<any> is expected
    let ints = [1, 2, 3]
    print("covariant list: " + str(sum_any(ints)))
    // CONTRAVARIANCE: a fn taking `any` used where fn(int) is expected
    print("contravariant fn: " + str(apply(wide, 7)))
