// fsmx.nova — a finite state machine: states + event-driven transitions.
//
// Model protocols, UI/workflow states, parsers, and game logic as explicit
// (state, event) -> next-state transitions, then drive the machine with a stream
// of events. An unhandled event leaves the state unchanged (a safe default).
// Transitions are keyed "state|event" in a dict.

fn fsm_new()
  let m = {}
  m["t"] = {}
  m

fn fsm_add(fsm, from_state, event, to_state)
  let t = fsm["t"]
  t[from_state + "|" + event] = to_state

fn fsm_step(fsm, state, event)
  let t = fsm["t"]
  let key = state + "|" + event
  if contains(t, key)
    return t[key]
  state                              // no transition defined -> stay put

fn fsm_run(fsm, start, events)
  let state = start
  for e in events
    state = fsm_step(fsm, state, e)
  state

fn fsm_can(fsm, state, event)
  if contains(fsm["t"], state + "|" + event)
    return 1
  0

// ── Tests ────────────────────────────────────────────────────────────

// a turnstile: locked --coin--> unlocked --push--> locked
let gate = fsm_new()
fsm_add(gate, "locked", "coin", "unlocked")
fsm_add(gate, "unlocked", "push", "locked")

assert(fsm_step(gate, "locked", "coin") == "unlocked", "coin unlocks")
assert(fsm_step(gate, "unlocked", "push") == "locked", "push locks")
assert(fsm_step(gate, "locked", "push") == "locked", "push while locked = stay")
assert(fsm_step(gate, "unlocked", "coin") == "unlocked", "coin while unlocked = stay")
print("PASS: turnstile transitions")

assert(fsm_can(gate, "locked", "coin") == 1, "locked can coin")
assert(fsm_can(gate, "locked", "push") == 0, "locked has no push transition")
print("PASS: fsm_can")

// drive a sequence of events from a start state
let final1 = fsm_run(gate, "locked", ["coin", "push", "coin"])
assert(final1 == "unlocked", "coin,push,coin -> unlocked")
let final2 = fsm_run(gate, "locked", ["push", "push", "coin", "push"])
assert(final2 == "locked", "push,push,coin,push -> locked")
print("PASS: fsm_run sequence")

// a 3-state cycle: red -> green -> yellow -> red on "tick"
let light = fsm_new()
fsm_add(light, "red", "tick", "green")
fsm_add(light, "green", "tick", "yellow")
fsm_add(light, "yellow", "tick", "red")
assert(fsm_run(light, "red", ["tick", "tick", "tick"]) == "red", "full cycle returns to red")
assert(fsm_run(light, "red", ["tick"]) == "green", "one tick -> green")
assert(fsm_run(light, "red", ["tick", "tick"]) == "yellow", "two ticks -> yellow")
print("PASS: traffic-light cycle")

print("ALL PASS: fsmx — finite state machine")
