// Probe: does a host import RETURN a value to NOVA? make_node returns a JS-side handle (int),
// NOVA passes it back to tag_of -> proves the wasm<->JS handle round-trip.
extern fn make_node(tag: string) -> int
extern fn tag_len(node: int) -> int

fn main()
    let h = unsafe make_node("p")
    let n = unsafe tag_len(h)
    print("handle=" + str(h) + " taglen=" + str(n))
