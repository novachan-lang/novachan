// NOVA way (unique to us, not copied): structs compare by VALUE automatically — `a == b`
// is structural with zero @derive, zero .eq(). This isn't "structural eq minus an `is`
// operator" borrowed from Python; it's forced by NOVA's model: process isolation means a
// value is only ever deep-copied across channels, so object identity is unobservable and
// structural equality is the ONLY coherent notion. The SAME structure walk backs ==, hash,
// copy, to_json and show — so they cannot drift apart (no equals()/hashCode() contract to
// hand-maintain). hash() is consistent with == by construction.

type Point
    x: int
    y: int

type Seg
    a: Point
    b: Point

type Bag
    items: list
    label: string

fn main()
    // structural: equal fields => equal, though distinct objects (no @derive, no .eq())
    let p1 = Point { x: 3, y: 4 }
    let p2 = Point { x: 3, y: 4 }
    let p3 = Point { x: 3, y: 9 }
    assert_eq(p1 == p2, true)
    assert_eq(p1 == p3, false)

    // nested structs compare recursively
    let s1 = Seg { a: Point { x: 0, y: 0 }, b: Point { x: 1, y: 1 } }
    let s2 = Seg { a: Point { x: 0, y: 0 }, b: Point { x: 1, y: 1 } }
    let s3 = Seg { a: Point { x: 0, y: 0 }, b: Point { x: 2, y: 2 } }
    assert_eq(s1 == s2, true)
    assert_eq(s1 == s3, false)

    // collection fields compare structurally too (list eq is element-wise)
    let b1 = Bag { items: [1, 2, 3], label: "x" }
    let b2 = Bag { items: [1, 2, 3], label: "x" }
    let b3 = Bag { items: [1, 2, 4], label: "x" }
    assert_eq(b1 == b2, true)
    assert_eq(b1 == b3, false)

    // hash is consistent with == (equal values hash equal) — guaranteed by construction
    assert_eq(hash(p1) == hash(p2), true)
    assert_eq(hash(s1) == hash(s2), true)
    assert_eq(hash(b1) == hash(b2), true)

    // clone is copy() — the universal runtime deep-clone (no @derive(Clone) needed): the
    // copy equals the original by value, and is structurally independent (deep).
    let bc = copy(b1)
    assert_eq(bc == b1, true)
    let s_clone = copy(s1)
    assert_eq(s_clone == s1, true)

    print("auto_eq_test passed")
