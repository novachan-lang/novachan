// KAT for std/util/statemachine — deterministic FSM
import std/util/statemachine

// Helper: assert int equals expected
fn cki(got: int, expected: int, label: string)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// Helper: assert string equals expected
fn cks(got: string, expected: string, label: string)
    if got != expected
        print("FAIL " + label + ": got " + got + " expected " + expected)
        exit(1)

// ── Build the FSM ─────────────────────────────────────────────────────────────
let m = stm_new("idle")
stm_add_transition(m, "idle",    "start", "running")
stm_add_transition(m, "running", "stop",  "idle")

// KAT 1 — initial state is "idle"
cks(stm_state(m), "idle", "initial-state")

// KAT 2 — fire "start" from "idle" succeeds (returns true)
let r1 = stm_fire(m, "start")
if r1
    cki(1, 1, "fire-start-true-guard")
else
    print("FAIL fire-start: expected true got false")
    exit(1)

// KAT 3 — state is now "running" after "start"
cks(stm_state(m), "running", "state-after-start")

// KAT 4 — fire "start" from "running" fails (no transition defined)
let r2 = stm_fire(m, "start")
if r2
    print("FAIL fire-start-again: expected false got true")
    exit(1)
cki(1, 1, "fire-start-again-false-guard")

// KAT 5 — can_fire("stop") from "running" is true
let cf1 = stm_can_fire(m, "stop")
if cf1
    cki(1, 1, "can-fire-stop-true")
else
    print("FAIL can_fire stop: expected true got false")
    exit(1)

// KAT 6 — can_fire("start") from "running" is false
let cf2 = stm_can_fire(m, "start")
if cf2
    print("FAIL can_fire start from running: expected false got true")
    exit(1)
cki(1, 1, "can-fire-start-false-guard")

// KAT 7 — fire "stop" from "running" succeeds
let r3 = stm_fire(m, "stop")
if r3
    cki(1, 1, "fire-stop-true-guard")
else
    print("FAIL fire-stop: expected true got false")
    exit(1)

// KAT 8 — state is back to "idle" after "stop"
cks(stm_state(m), "idle", "state-after-stop")

// KAT 9 — reset returns to initial state (redundant here, but tests reset API)
stm_add_transition(m, "idle", "pause", "paused")
let r4 = stm_fire(m, "pause")
if r4
    cki(1, 1, "fire-pause-true-guard")
else
    print("FAIL fire-pause: expected true got false")
    exit(1)
cks(stm_state(m), "paused", "state-paused")
stm_reset(m)
cks(stm_state(m), "idle", "state-after-reset")

// KAT 10 — undefined event from initial state returns false
let r5 = stm_fire(m, "undefined_event")
if r5
    print("FAIL undefined-event: expected false got true")
    exit(1)
cki(1, 1, "undefined-event-false-guard")
// state must be unchanged after failed fire
cks(stm_state(m), "idle", "state-unchanged-after-fail")

print("_statemachine_test passed")
