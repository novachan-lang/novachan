import forge_metrics_histogram

fn main()
    let h = hist_new(10, 100)
    assert(hist_count(h) == 0, "starts empty")
    assert(hist_mean(h) == 0, "mean of 0")

    h = hist_observe(h, 50)
    h = hist_observe(h, 150)
    h = hist_observe(h, 250)
    h = hist_observe(h, 350)
    h = hist_observe(h, 950)
    assert(hist_count(h) == 5, "5 observations")
    assert(hist_min(h) == 50, "min 50")
    assert(hist_max(h) == 950, "max 950")
    assert(hist_sum(h) == 1750, "sum 1750")
    assert(hist_mean(h) == 350, "mean 350")

    assert(hist_bucket_value(h, 0) == 1, "bucket 0 has 50")
    assert(hist_bucket_value(h, 1) == 1, "bucket 1 has 150")
    assert(hist_bucket_value(h, 2) == 1, "bucket 2 has 250")
    assert(hist_bucket_value(h, 9) == 1, "bucket 9 has 950")

    let p50 = hist_percentile(h, 50)
    assert(p50 > 0, "p50 > 0")
    let p99 = hist_percentile(h, 99)
    assert(p99 >= p50, "p99 >= p50")

    assert(hist_bucket_value(h, -1) == 0, "neg bucket = 0")
    assert(hist_bucket_value(h, 99) == 0, "out of range = 0")

    print("METRICS-HISTOGRAM KAT PASS")
