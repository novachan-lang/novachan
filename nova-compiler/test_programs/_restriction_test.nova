// _restriction_test.nova — KAT for std/bio/restriction (restriction enzymes).
import std/bio/restriction

fn check_int(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn check_str(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn check_bool(label, got, want)
    let g = 0
    if got
        g = 1
    let w = 0
    if want
        w = 1
    if g != w
        print("FAIL " + label + ": got=" + str(g) + " want=" + str(w))
        exit(1)

fn main()
    // --- KAT 1: re_site ---
    check_str("re_site EcoRI", re_site("EcoRI"), "GAATTC")
    check_str("re_site BamHI", re_site("BamHI"), "GGATCC")
    check_str("re_site HindIII", re_site("HindIII"), "AAGCTT")
    check_str("re_site NotI", re_site("NotI"), "GCGGCCGC")
    check_str("re_site PstI", re_site("PstI"), "CTGCAG")
    check_str("re_site unknown", re_site("Fake"), "")

    // --- KAT 2: re_find ---
    // 'AAGAATTCAA': GAATTC starts at position 2
    let pos1 = re_find("AAGAATTCAA", "GAATTC")
    check_int("re_find count", len(pos1), 1)
    check_int("re_find pos[0]", pos1[0], 2)

    // 'GAATTCGAATTC': GAATTC at 0 and 6
    let pos2 = re_find("GAATTCGAATTC", "GAATTC")
    check_int("re_find two count", len(pos2), 2)
    check_int("re_find two [0]", pos2[0], 0)
    check_int("re_find two [1]", pos2[1], 6)

    // No site
    let pos3 = re_find("AAACCCGGG", "GAATTC")
    check_int("re_find none", len(pos3), 0)

    // --- KAT 3: re_count_sites ---
    check_int("re_count_sites 2", re_count_sites("GAATTCGAATTC", "EcoRI"), 2)
    check_int("re_count_sites 0", re_count_sites("AAACCC", "EcoRI"), 0)

    // --- KAT 4: re_is_palindrome ---
    // GAATTC revcomp: rev=CTTAAG, comp each: G->C, A->T, A->T, T->A, T->A, C->G => GAATTC
    check_bool("re_is_palindrome GAATTC", re_is_palindrome("GAATTC"), true)
    check_bool("re_is_palindrome GGATCC", re_is_palindrome("GGATCC"), true)
    check_bool("re_is_palindrome AAGCTT", re_is_palindrome("AAGCTT"), true)
    check_bool("re_is_palindrome GCGGCCGC", re_is_palindrome("GCGGCCGC"), true)
    // AAAA: revcomp = TTTT != AAAA => false (molecular palindrome, not string palindrome)
    check_bool("re_is_palindrome AAAA", re_is_palindrome("AAAA"), false)
    check_bool("re_is_palindrome AAAT", re_is_palindrome("AAAT"), false)
    // AATT: revcomp(AATT) = complement TTAA, reversed = AATT => true
    check_bool("re_is_palindrome AATT", re_is_palindrome("AATT"), true)
    // ATGC: revcomp(ATGC) = complement TACG, reversed = GCAT != ATGC => false
    check_bool("re_is_palindrome ATGC", re_is_palindrome("ATGC"), false)

    // --- KAT 5: re_fragment_count ---
    // 'AAGAATTCAA' with GAATTC at pos 2: cut yields 'AA' and 'AA' (2 fragments)
    check_int("re_fragment_count 2", re_fragment_count("AAGAATTCAA", "GAATTC"), 2)
    // No cuts: 1 fragment (the whole string)
    check_int("re_fragment_count 1", re_fragment_count("AAACCCGGG", "GAATTC"), 1)
    // Two cuts: 3 fragments
    check_int("re_fragment_count 3", re_fragment_count("GAATTCAAAGAATTC", "GAATTC"), 3)

    // --- KAT 6: re_digest content ---
    // 'AAGAATTCAA': cut at pos 2, site len 6 -> frag1='AA', frag2='AA'
    let frags1 = re_digest("AAGAATTCAA", "GAATTC")
    check_int("re_digest frag count", len(frags1), 2)
    check_str("re_digest frag[0]", frags1[0], "AA")
    check_str("re_digest frag[1]", frags1[1], "AA")

    // 'XGAATTCY': cut at pos 1 -> frag1='X', frag2='Y'
    let frags2 = re_digest("XGAATTCY", "GAATTC")
    check_int("re_digest frag2 count", len(frags2), 2)
    check_str("re_digest frag2[0]", frags2[0], "X")
    check_str("re_digest frag2[1]", frags2[1], "Y")

    // --- KAT 7: re_find_enzyme ---
    let fe1 = re_find_enzyme("GAATTCAAA", "EcoRI")
    check_int("re_find_enzyme count", len(fe1), 1)
    check_int("re_find_enzyme pos", fe1[0], 0)
    let fe2 = re_find_enzyme("AAAA", "EcoRI")
    check_int("re_find_enzyme none", len(fe2), 0)

    // --- KAT 8: re_overhang ---
    check_str("re_overhang EcoRI", re_overhang("EcoRI"), "AATT")
    check_str("re_overhang BamHI", re_overhang("BamHI"), "GATC")
    check_str("re_overhang unknown", re_overhang("Fake"), "")

    // --- KAT 9: re_sites_in ---
    let found = re_sites_in("AAAGAATTCGGATCCAAA")
    // Should find EcoRI and BamHI
    check_int("re_sites_in count", len(found), 2)
    // Should NOT find any
    let found2 = re_sites_in("AAATTTCCC")
    check_int("re_sites_in none", len(found2), 0)

    // --- KAT 10: re_longest_fragment ---
    // 'AAGAATTCAAAAAAAA': site=GAATTC at pos 2, frags='AA','AAAAAA' -> longest=6
    let lf1 = re_longest_fragment("AAGAATTCAAAAAAAA", "GAATTC")
    check_int("re_longest_fragment", lf1, 8)

    // --- KAT 11: re_enzymes dict ---
    let enzd = re_enzymes()
    check_bool("re_enzymes has EcoRI", contains(enzd, "EcoRI"), true)
    check_bool("re_enzymes has NotI", contains(enzd, "NotI"), true)

    // --- KAT 12: edge cases ---
    // Empty DNA
    let e1 = re_find("", "GAATTC")
    check_int("re_find empty dna", len(e1), 0)
    // DNA shorter than site
    let e2 = re_find("GAA", "GAATTC")
    check_int("re_find short dna", len(e2), 0)

    print("PASS _restriction_test")
