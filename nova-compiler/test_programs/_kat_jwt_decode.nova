import forge_jwt_decode

fn main()
    // Well-known JWT fixture: header {"alg":"HS256","typ":"JWT"}, payload
    // {"sub":"1234567890","name":"John","iat":1516239022} (no "exp" claim). jwt_decode_* never
    // verifies the signature, so the sig segment only needs to be a syntactically valid third part.
    let header_part = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9"
    let payload_part = "eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4iLCJpYXQiOjE1MTYyMzkwMjJ9"
    let sig_part = "SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c"
    let token = "{header_part}.{payload_part}.{sig_part}"

    let header = jwt_decode_header(token)
    assert(header["alg"] == "HS256", "header alg decodes to HS256")
    assert(header["typ"] == "JWT", "header typ decodes to JWT")

    let payload = jwt_decode_payload(token)
    assert(payload["sub"] == "1234567890", "payload sub decodes correctly")
    assert(payload["name"] == "John", "payload name decodes correctly")
    assert(payload["iat"] == 1516239022, "payload iat decodes correctly")

    assert(not jwt_is_expired(token, 1000000000), "no exp claim -> never reported expired")
    assert(not jwt_is_expired(token, 9999999999), "still not expired far in the future (no exp claim)")

    let bad_header = jwt_decode_header("notajwt")
    assert(len(bad_header) == 0, "malformed token header decodes to empty dict")

    let bad_payload = jwt_decode_payload("notajwt")
    assert(len(bad_payload) == 0, "malformed token payload decodes to empty dict")

    print("JWT-DECODE KAT PASS")
