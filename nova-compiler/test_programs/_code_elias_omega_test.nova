// KAT for std/compress/code_elias_omega
// PRIMARY gate: round-trip omega_decode(omega_encode(n), 0) == [n, len(omega_encode(n))]
//               for all n in 1..200, plus a sequence round-trip.
// SECONDARY: known bit-pattern vectors from the spec.
import std/compress/code_elias_omega

// ── Helpers ───────────────────────────────────────────────────────────────────

fn ck_int(label, got, want)
    if got != want
        print("FAIL code_elias_omega " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck_list_eq(label, a, b)
    let n = len(a)
    if n != len(b)
        print("FAIL code_elias_omega " + label + ": length got=" + str(n) + " want=" + str(len(b)))
        exit(1)
    let i = 0
    while i < n
        if a[i] != b[i]
            print("FAIL code_elias_omega " + label + ": idx=" + str(i) + " got=" + str(a[i]) + " want=" + str(b[i]))
            exit(1)
        i = i + 1

fn make1(a) -> list
    let r = []
    push(r, a)
    r

fn make3(a, b, c) -> list
    let r = []
    push(r, a)
    push(r, b)
    push(r, c)
    r

fn make6(a, b, c, d, e, f) -> list
    let r = []
    push(r, a)
    push(r, b)
    push(r, c)
    push(r, d)
    push(r, e)
    push(r, f)
    r

// ── KAT 1: Known bit-pattern vectors ─────────────────────────────────────────
// omega_encode(1):
//   k=1, while k>1 never triggers, code=[0]
let v1 = omega_encode(1)
ck_list_eq("enc_1", v1, make1(0))

// omega_encode(2): k=2 -> binary(2)=[1,0] prepend -> [1,0,0], k=1 -> done
let v2 = omega_encode(2)
ck_list_eq("enc_2", v2, make3(1, 0, 0))

// omega_encode(3): k=3 -> binary(3)=[1,1] prepend -> [1,1,0], k=1 -> done
let v3 = omega_encode(3)
ck_list_eq("enc_3", v3, make3(1, 1, 0))

// omega_encode(4):
//   k=4 -> binary(4)=[1,0,0] prepend -> [1,0,0,0], k=2
//   k=2 -> binary(2)=[1,0]   prepend -> [1,0,1,0,0,0], k=1 -> done
let v4 = omega_encode(4)
ck_list_eq("enc_4", v4, make6(1, 0, 1, 0, 0, 0))

// omega_encode(7):
//   k=7 -> binary(7)=[1,1,1] prepend -> [1,1,1,0], k=floor(log2(7))=2
//   k=2 -> binary(2)=[1,0]   prepend -> [1,0,1,1,1,0], k=1 -> done
let v7 = omega_encode(7)
ck_list_eq("enc_7", v7, make6(1, 0, 1, 1, 1, 0))

// ── KAT 2: Decode of known vectors matches n ──────────────────────────────────
let d1 = omega_decode(v1, 0)
ck_int("dec_1_val", d1[0], 1)
ck_int("dec_1_pos", d1[1], 1)

let d2 = omega_decode(v2, 0)
ck_int("dec_2_val", d2[0], 2)
ck_int("dec_2_pos", d2[1], 3)

let d3 = omega_decode(v3, 0)
ck_int("dec_3_val", d3[0], 3)
ck_int("dec_3_pos", d3[1], 3)

let d4 = omega_decode(v4, 0)
ck_int("dec_4_val", d4[0], 4)
ck_int("dec_4_pos", d4[1], 6)

let d7 = omega_decode(v7, 0)
ck_int("dec_7_val", d7[0], 7)
ck_int("dec_7_pos", d7[1], 6)

// ── KAT 3: Round-trip 1..200 ─────────────────────────────────────────────────
let rt_i = 1
while rt_i <= 200
    let dummy = 0
    let enc = omega_encode(rt_i)
    let dec = omega_decode(enc, 0)
    if dec[0] != rt_i
        print("FAIL code_elias_omega round_trip n=" + str(rt_i) + " got=" + str(dec[0]))
        exit(1)
    if dec[1] != len(enc)
        print("FAIL code_elias_omega round_trip_pos n=" + str(rt_i) + " got_pos=" + str(dec[1]) + " want=" + str(len(enc)))
        exit(1)
    rt_i = rt_i + 1

// ── KAT 4: Sequence round-trip ────────────────────────────────────────────────
// Concatenate omega codes for a sequence of values into one big bit list,
// then decode them back sequentially using next_pos from each decode call.
fn seq_round_trip(vals) -> int
    let bits = []
    let nv = len(vals)
    let vi = 0
    while vi < nv
        let enc = omega_encode(vals[vi])
        let ei = 0
        let elen = len(enc)
        while ei < elen
            push(bits, enc[ei])
            ei = ei + 1
        vi = vi + 1
    let pos = 0
    let vi2 = 0
    let ok = 1
    while vi2 < nv
        let dec = omega_decode(bits, pos)
        if dec[0] != vals[vi2]
            print("FAIL code_elias_omega seq_rt idx=" + str(vi2) + " got=" + str(dec[0]) + " want=" + str(vals[vi2]))
            ok = 0
        pos = dec[1]
        vi2 = vi2 + 1
    ok

// Sequence A: small mixed values
let seq_a = []
push(seq_a, 1)
push(seq_a, 2)
push(seq_a, 3)
push(seq_a, 4)
push(seq_a, 5)
push(seq_a, 10)
push(seq_a, 100)
let ok_a = seq_round_trip(seq_a)
if ok_a != 1
    exit(1)

// Sequence B: powers of two
let seq_b = []
push(seq_b, 1)
push(seq_b, 2)
push(seq_b, 4)
push(seq_b, 8)
push(seq_b, 16)
push(seq_b, 32)
push(seq_b, 64)
push(seq_b, 128)
let ok_b = seq_round_trip(seq_b)
if ok_b != 1
    exit(1)

// Sequence C: consecutive 1..20
let seq_c = []
let seq_ci = 1
while seq_ci <= 20
    let dummy = 0
    push(seq_c, seq_ci)
    seq_ci = seq_ci + 1
let ok_c = seq_round_trip(seq_c)
if ok_c != 1
    exit(1)

// ── KAT 5: omega_bit_length agrees with len(omega_encode(n)) ─────────────────
let bl_i = 1
while bl_i <= 100
    let dummy = 0
    let computed = omega_bit_length(bl_i)
    let actual = len(omega_encode(bl_i))
    if computed != actual
        print("FAIL code_elias_omega bit_length n=" + str(bl_i) + " got=" + str(computed) + " want=" + str(actual))
        exit(1)
    bl_i = bl_i + 1

// ── KAT 6: pack_bits sanity ───────────────────────────────────────────────────
// pack_bits([1,0,1,1,0,0,1,0]) -> byte=10110010 binary = 178 decimal
let pb_in = []
push(pb_in, 1)
push(pb_in, 0)
push(pb_in, 1)
push(pb_in, 1)
push(pb_in, 0)
push(pb_in, 0)
push(pb_in, 1)
push(pb_in, 0)
let pb_out = pack_bits(pb_in)
ck_int("pack_bits_len", len(pb_out), 1)
ck_int("pack_bits_val", pb_out[0], 178)

// pack_bits with zero-padding: [1,1,0] -> [1,1,0,0,0,0,0,0] = 192 decimal
let pb2_in = []
push(pb2_in, 1)
push(pb2_in, 1)
push(pb2_in, 0)
let pb2_out = pack_bits(pb2_in)
ck_int("pack_bits_pad_len", len(pb2_out), 1)
ck_int("pack_bits_pad_val", pb2_out[0], 192)

// ── KAT 7: Large value round-trips ───────────────────────────────────────────
let large_ns = []
push(large_ns, 255)
push(large_ns, 256)
push(large_ns, 1000)
push(large_ns, 65535)
push(large_ns, 100000)

let lv_i = 0
while lv_i < len(large_ns)
    let dummy = 0
    let n = large_ns[lv_i]
    let enc = omega_encode(n)
    let dec = omega_decode(enc, 0)
    if dec[0] != n
        print("FAIL code_elias_omega large n=" + str(n) + " got=" + str(dec[0]))
        exit(1)
    if dec[1] != len(enc)
        print("FAIL code_elias_omega large_pos n=" + str(n) + " got=" + str(dec[1]) + " want=" + str(len(enc)))
        exit(1)
    lv_i = lv_i + 1

print("PASS _code_elias_omega_test")
