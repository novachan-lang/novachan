// Oracle for the HTTPS client (Linux/macOS via OpenSSL; WinHTTP on Windows).
// Fetches https://example.com over real TLS (cert verification on) and checks the
// well-known page content. example.com is an IANA-reserved, rock-stable endpoint.
fn main()
    let resp = http_get("https://example.com")
    let n = len(resp)
    print("https body bytes: {n}")
    // Deterministic in CI: a live-network test must SKIP (not hard-fail) when the machine is offline
    // (0 bytes = no route to example.com), so the arc's red/green reflects OUR code, not connectivity.
    if n == 0
        print("https_client_test SKIP: no network access to example.com (offline environment)")
        return
    assert_eq(contains(resp, "Example Domain"), true)
    print("https client test passed")
