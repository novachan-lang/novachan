// 7.1 INLINE ASM — `asm(template, constraints) -> int`
//
// Emits `call i64 asm sideeffect "<tmpl>", "<cons>"()`, or `call void asm ...` when the
// constraints declare no output. `sideeffect` is ALWAYS set so LLVM cannot delete or
// reorder a block it can't reason about (fences, cpuid, int3). Requires `unsafe`.
//
// TWO REAL CONSTRAINTS, both found by probing rather than assumed:
//
// 1. Template and constraints must be STRING LITERALS. They are emitted into the
//    module, so a computed string cannot work; it is rejected (E1014) rather than
//    silently producing malformed asm — malformed asm assembles fine and fails at
//    RUNTIME, the worst outcome.
//
// 2. LLVM clobber syntax ~{reg} meets NOVA string interpolation, which also uses
//    braces -- but NOVA already has an escape: \{ produces a literal brace (the
//    lexer lists \n \t \r \ \" \0 \u{XXXX} \{ \} as valid). So a clobber list IS
//    expressible: "~\{memory}" emits "~{memory}". A {{ escape was considered and
//    REJECTED -- 123 occurrences of {{ already exist across std/text/template.nova,
//    std/parsing/template.nova and others whose entire syntax is {{var}}, so adding
//    it would have silently changed their meaning.
// Also note "=a"-style fixed-register constraints fail to allocate on this target
// ("couldn't allocate output register for constraint 'a'"); "=r" and let the register
// allocator choose is the portable form.

fn main()
    // Output operand: $0 is the first (output) operand, "=r" = any general register.
    let a = unsafe asm("mov $$42, $0", "=r")
    assert(a == 42, "asm with output constraint returns its value")

    // No output -> must lower to `call void asm`, and still yield a defined 0.
    let b = unsafe asm("nop", "")
    assert(b == 0, "no-output asm yields a defined 0")

    // Clobber list via the \{ escape -> emits "~{memory}", still the void form.
    let c = unsafe asm("nop", "~\{memory}")
    assert(c == 0, "clobber-only constraint lowers to void asm")

    print("ASM_INLINE_OK")
