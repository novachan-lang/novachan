import std/color/hex

// ── check helpers ─────────────────────────────────────────────────────────────

fn cks(label: str, got: str, want: str)
    if got != want
        print("FAIL " + label + ": got [" + got + "] want [" + want + "]")
        exit(1)

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label: str, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got " + str(gi) + " want " + str(wi))
        exit(1)

fn main()
    // ── chex_from_rgb ────────────────────────────────────────────────────────
    // KAT: [255,0,128] -> "#ff0080"
    cks("from_rgb_ff0080", chex_from_rgb([255, 0, 128]), "#ff0080")
    // KAT: [0,0,0] -> "#000000"
    cks("from_rgb_black", chex_from_rgb([0, 0, 0]), "#000000")
    // extra: white
    cks("from_rgb_white", chex_from_rgb([255, 255, 255]), "#ffffff")
    // extra: red
    cks("from_rgb_red", chex_from_rgb([255, 0, 0]), "#ff0000")

    // ── chex_to_rgb ──────────────────────────────────────────────────────────
    // KAT: "#ff0080" -> [255,0,128]
    let rgb1 = chex_to_rgb("#ff0080")
    cki("to_rgb_ff0080_r", rgb1[0], 255)
    cki("to_rgb_ff0080_g", rgb1[1], 0)
    cki("to_rgb_ff0080_b", rgb1[2], 128)
    // KAT: "#fff" (3-char shorthand) -> [255,255,255]
    let rgb2 = chex_to_rgb("#fff")
    cki("to_rgb_fff_r", rgb2[0], 255)
    cki("to_rgb_fff_g", rgb2[1], 255)
    cki("to_rgb_fff_b", rgb2[2], 255)
    // KAT: "00ff00" (no #) -> [0,255,0]
    let rgb3 = chex_to_rgb("00ff00")
    cki("to_rgb_00ff00_r", rgb3[0], 0)
    cki("to_rgb_00ff00_g", rgb3[1], 255)
    cki("to_rgb_00ff00_b", rgb3[2], 0)
    // extra: uppercase hex accepted
    let rgb4 = chex_to_rgb("#FF0000")
    cki("to_rgb_upper_r", rgb4[0], 255)
    cki("to_rgb_upper_g", rgb4[1], 0)
    cki("to_rgb_upper_b", rgb4[2], 0)
    // extra: 3-digit shorthand "#abc" -> a=0xaa=170, b=0xbb=187, c=0xcc=204
    let rgb5 = chex_to_rgb("#abc")
    cki("to_rgb_abc_r", rgb5[0], 170)
    cki("to_rgb_abc_g", rgb5[1], 187)
    cki("to_rgb_abc_b", rgb5[2], 204)

    // ── chex_is_valid ────────────────────────────────────────────────────────
    // KAT: "#gg0000" -> false (g is not a hex digit)
    ckb("valid_gg0000", chex_is_valid("#gg0000"), false)
    // KAT: "#abc" -> true (valid 3-digit shorthand)
    ckb("valid_abc", chex_is_valid("#abc"), true)
    // extra: valid 6-digit
    ckb("valid_ff0080", chex_is_valid("#ff0080"), true)
    // extra: no leading # still valid
    ckb("valid_no_hash", chex_is_valid("ffffff"), true)
    // extra: wrong length
    ckb("valid_too_short", chex_is_valid("#ff"), false)
    // extra: invalid char z
    ckb("valid_z", chex_is_valid("#zzzzzz"), false)

    // ── chex_shorthand ───────────────────────────────────────────────────────
    // KAT: [255,255,255] -> "#fff"
    cks("shorthand_white", chex_shorthand([255, 255, 255]), "#fff")
    // extra: [0,0,0] -> "#000"
    cks("shorthand_black", chex_shorthand([0, 0, 0]), "#000")
    // extra: [170,187,204] (0xaa,0xbb,0xcc) -> "#abc"
    cks("shorthand_abc", chex_shorthand([170, 187, 204]), "#abc")
    // extra: [255,0,128] cannot be shortened -> full form
    cks("shorthand_full", chex_shorthand([255, 0, 128]), "#ff0080")
    // extra: [17,34,51] (0x11,0x22,0x33) -> "#123"
    cks("shorthand_123", chex_shorthand([17, 34, 51]), "#123")

    print("_color_hex_test passed")
