// webx — HTTP depth the NOVA way: middleware, sessions, multipart. Pure-NOVA over
// first-class functions + dicts (no macros, no decorators). Complements httpx
// (cookies + Basic/Bearer auth) and forge (typed Request/Response).

// ── Middleware: fn(req, next) -> resp, composed by folding. chain([mw...], handler)
//    builds mw1(wraps mw2(wraps ... handler)). Just functions piping Values. ──
fn _chain_step(mws, idx, handler, req)
    if idx >= len(mws)
        return handler(req)
    let mw = mws[idx]
    return mw(req, fn(r) _chain_step(mws, idx + 1, handler, r))

fn chain(mws, handler, req)
    return _chain_step(mws, 0, handler, req)

// ── Sessions: an in-memory store of session-id -> {key: value}. ──
fn session_new()
    return {}

fn session_put(store, sid, key, val)
    if not contains(store, sid)
        store[sid] = {}
    let s = store[sid]            // inner dict is a reference; mutating it persists
    s[key] = val
    return 0

fn session_get(store, sid, key)
    if not contains(store, sid)
        return ""
    let s = store[sid]
    if not contains(s, key)
        return ""
    return s[key]

fn session_has(store, sid)
    if contains(store, sid)
        return 1
    return 0

// ── Multipart/form-data parser: body split on the boundary; each part's field name
//    (Content-Disposition name="...") maps to its value (after the blank line). ──
fn _between(s, pre, post)
    let i = find(s, pre)
    if i < 0
        return ""
    let start = i + len(pre)
    let rest = slice(s, start, len(s))
    let j = find(rest, post)
    if j < 0
        return ""
    return slice(rest, 0, j)

fn multipart_parse(body, boundary)
    let result = {}
    let crlf = chr(13) + chr(10)
    let parts = split(body, "--" + boundary)
    for part in parts
        if contains(part, "name=")
            let name = _between(part, "name=" + chr(34), chr(34))
            let sep = crlf + crlf
            let bi = find(part, sep)
            if name != "" and bi >= 0
                let raw = slice(part, bi + 4, len(part))
                // strip a single trailing CRLF
                let n = len(raw)
                if n >= 2 and slice(raw, n - 2, n) == crlf
                    raw = slice(raw, 0, n - 2)
                result[name] = raw
    return result

fn handler(req)
    return "handled:" + req
fn mw_log(req, next)
    let resp = next(req + "[log]")
    return resp + "{log}"
fn mw_auth(req, next)
    let resp = next(req + "[auth]")
    return resp + "{auth}"

fn main()
    // middleware: mw_log wraps mw_auth wraps handler
    let result = chain([mw_log, mw_auth], handler, "REQ")
    assert_eq(result, "handled:REQ[log][auth]{auth}{log}")

    // sessions
    let store = session_new()
    session_put(store, "s1", "user", "alice")
    session_put(store, "s1", "role", "admin")
    session_put(store, "s2", "user", "bob")
    assert_eq(session_get(store, "s1", "user"), "alice")
    assert_eq(session_get(store, "s1", "role"), "admin")
    assert_eq(session_get(store, "s2", "user"), "bob")
    assert_eq(session_get(store, "s1", "missing"), "")
    assert_eq(session_has(store, "s1"), 1)
    assert_eq(session_has(store, "nope"), 0)

    // multipart
    let crlf = chr(13) + chr(10)
    let body = "--B" + crlf + "Content-Disposition: form-data; name=" + chr(34) + "field1" + chr(34) + crlf + crlf + "value1" + crlf + "--B" + crlf + "Content-Disposition: form-data; name=" + chr(34) + "field2" + chr(34) + crlf + crlf + "value2" + crlf + "--B--" + crlf
    let fields = multipart_parse(body, "B")
    assert_eq(fields["field1"], "value1")
    assert_eq(fields["field2"], "value2")

    print("webx passed")
