// WASM frontend todo list: JS types an item -> wasm_alloc string IN -> NOVA splits the joined items with the
// VALUE-MODEL (split -> list) and RE-RENDERS the <ul> (dom_clear + dom_create/dom_set_text/dom_append). Shows
// string-in + value-model list + DOM render together. JS holds the item array; NOVA owns the split + render.
extern fn dom_get_by_id(id: string) -> int
extern fn dom_create(tag: string) -> int
extern fn dom_set_text(node: int, txt: string)
extern fn dom_append(parent: int, child: int)
extern fn dom_clear(node: int)
fn render_items(joined: string)
    let ul = unsafe dom_get_by_id("list")
    unsafe dom_clear(ul)
    let items = split(joined, "|")
    let i = 0
    while i < len(items)
        let li = unsafe dom_create("li")
        unsafe dom_set_text(li, items[i])
        unsafe dom_append(ul, li)
        i = i + 1
fn main()
    render_items("a|b")
