// forge_hpack_test -- HPACK (RFC 7541) §5.1 prefix-integer coding, byte-exact against the RFC C.1 vectors.
import forge_hpack

fn _eq(a: list, b: list) -> bool
    if len(a) != len(b)
        return false
    let i = 0
    while i < len(a)
        if a[i] != b[i]
            return false
        i = i + 1
    true

fn main()
    // C.1.1: encode 10 with a 5-bit prefix -> 0x0A
    assert(_eq(forge_hpack.hpack_encode_int([], 10, 5, 0), [10]), "C.1.1 encode 10@5 -> 0A")
    let d1 = forge_hpack.hpack_decode_int([10], 0, 5)
    assert(d1[0] == 10 and d1[1] == 1, "C.1.1 decode 0A@5 -> 10")

    // C.1.2: encode 1337 with a 5-bit prefix -> 1F 9A 0A
    assert(_eq(forge_hpack.hpack_encode_int([], 1337, 5, 0), [31, 154, 10]), "C.1.2 encode 1337@5 -> 1F 9A 0A")
    let d2 = forge_hpack.hpack_decode_int([31, 154, 10], 0, 5)
    assert(d2[0] == 1337 and d2[1] == 3, "C.1.2 decode 1F 9A 0A@5 -> 1337")

    // C.1.3: encode 42 with an 8-bit prefix -> 2A
    assert(_eq(forge_hpack.hpack_encode_int([], 42, 8, 0), [42]), "C.1.3 encode 42@8 -> 2A")
    let d3 = forge_hpack.hpack_decode_int([42], 0, 8)
    assert(d3[0] == 42 and d3[1] == 1, "C.1.3 decode 2A@8 -> 42")

    // representation flags survive in the high bits: 0x80 (indexed) | index 2 @7-bit prefix -> 0x82
    assert(_eq(forge_hpack.hpack_encode_int([], 2, 7, 128), [130]), "indexed 0x80 | idx 2@7 -> 0x82")
    let d4 = forge_hpack.hpack_decode_int([130], 0, 7)
    assert(d4[0] == 2, "decode 0x82@7 (mask off the flag) -> 2")

    // a value exactly at the prefix boundary uses the continuation form (31 @5 -> 1F 00)
    assert(_eq(forge_hpack.hpack_encode_int([], 31, 5, 0), [31, 0]), "boundary 31@5 -> 1F 00")
    let d5 = forge_hpack.hpack_decode_int([31, 0], 0, 5)
    assert(d5[0] == 31 and d5[1] == 2, "decode 1F 00@5 -> 31")

    print("PASS: HPACK integer coding byte-exact (RFC 7541 C.1 + flags + boundary)")

    // ── RFC 7541 C.3.1: decode a full request header block (raw literals + dynamic-table insert) ──────
    // 82 86 84 41 0f <"www.example.com"> = indexed :method GET / :scheme http / :path / +
    // literal-incremental :authority = www.example.com
    let block = [130, 134, 132, 65, 15, 119, 119, 119, 46, 101, 120, 97, 109, 112, 108, 101, 46, 99, 111, 109]
    let res = forge_hpack.hpack_decode_header_block(block, [])
    let hs = res[0]
    assert(len(hs) == 4, "C.3.1 decodes 4 headers (got " + str(len(hs)) + ")")
    assert(hs[0][0] == ":method" and hs[0][1] == "GET", "C.3.1 h0 = :method GET")
    assert(hs[1][0] == ":scheme" and hs[1][1] == "http", "C.3.1 h1 = :scheme http")
    assert(hs[2][0] == ":path" and hs[2][1] == "/", "C.3.1 h2 = :path /")
    assert(hs[3][0] == ":authority" and hs[3][1] == "www.example.com", "C.3.1 h3 = :authority www.example.com [" + hs[3][1] + "]")
    print("PASS: HPACK header-block decode (RFC 7541 C.3.1 indexed + literal)")

    // the literal-incremental field was added to the dynamic table -> index 62 resolves to it
    let dyn = res[1]
    assert(len(dyn) == 1, "dynamic table has 1 entry after C.3.1")
    let looked = forge_hpack.hpack_lookup(dyn, 62)
    assert(looked[0] == ":authority" and looked[1] == "www.example.com", "dynamic index 62 = the inserted :authority")
    print("PASS: HPACK dynamic-table insert + index 62 lookup")

    // ── encode -> decode round-trip (the serve_h2 response-headers path) ──────────────────────────────
    let out_headers = []
    push(out_headers, [":status", "200"])
    push(out_headers, ["content-type", "application/json"])
    push(out_headers, ["x-custom", "hello world"])
    let enc = forge_hpack.hpack_encode_header_block(out_headers)
    let back = forge_hpack.hpack_decode_header_block(enc, [])
    let bh = back[0]
    assert(len(bh) == 3, "round-trip: 3 headers")
    assert(bh[0][0] == ":status" and bh[0][1] == "200", "round-trip h0 :status 200")
    assert(bh[1][0] == "content-type" and bh[1][1] == "application/json", "round-trip h1 content-type")
    assert(bh[2][0] == "x-custom" and bh[2][1] == "hello world", "round-trip h2 literal name+value [" + bh[2][1] + "]")
    print("PASS: HPACK encode->decode round-trip (static-name index + literal name)")

    print("forge_hpack_test passed")
