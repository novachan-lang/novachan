import std/game/elo_update

fn approx(a: float, b: float, tol: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < tol

fn chk(name: string, got: float, want: float, tol: float)
    if not approx(got, want, tol)
        print("FAIL elo_update " + name + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // KAT: elo_update(1500, 0.5, 1.0, 32) = 1500 + 32*(1.0-0.5) = 1516
    let u1 = elo_update(1500.0, 0.5, 1.0, 32.0)
    chk("win_from_equal", u1, 1516.0, 0.001)

    // A loss should decrease rating
    let u2 = elo_update(1500.0, 0.5, 0.0, 32.0)
    if u2 >= 1500.0
        print("FAIL elo_update loss_decreases: got " + str(u2) + " expected < 1500")
        exit(1)

    // Draw from equal: no change
    let u3 = elo_update(1500.0, 0.5, 0.5, 32.0)
    chk("draw_equal", u3, 1500.0, 0.001)

    // elo_pair_update conserves total rating on symmetric K
    // equal players, A wins
    let pair1 = elo_pair_update(1500.0, 1500.0, 1.0, 32.0)
    let new_ra = pair1[0] * 1.0
    let new_rb = pair1[1] * 1.0
    let total = new_ra + new_rb
    chk("pair_conservation_win", total, 3000.0, 0.001)

    // equal players, draw
    let pair2 = elo_pair_update(1500.0, 1500.0, 0.5, 32.0)
    let ra2 = pair2[0] * 1.0
    let rb2 = pair2[1] * 1.0
    let total2 = ra2 + rb2
    chk("pair_conservation_draw", total2, 3000.0, 0.001)

    // unequal, A is stronger, A wins: smaller gain
    let pair3 = elo_pair_update(1800.0, 1500.0, 1.0, 32.0)
    let new_ra3 = pair3[0] * 1.0
    let new_rb3 = pair3[1] * 1.0
    // stronger player wins less
    if new_ra3 - 1800.0 >= 16.0
        print("FAIL elo_update strong_wins_less: gain " + str(new_ra3 - 1800.0) + " should be < 16")
        exit(1)
    // loser loses rating
    if new_rb3 >= 1500.0
        print("FAIL elo_update weak_loses: " + str(new_rb3) + " should be < 1500")
        exit(1)
    // conservation
    let total3 = new_ra3 + new_rb3
    chk("pair_conservation_unequal", total3, 3300.0, 0.001)

    print("PASS _elo_update_test")
