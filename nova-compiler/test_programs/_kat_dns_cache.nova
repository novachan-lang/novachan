import forge_dns_cache

fn main()
    let d = dns_new()
    d = dns_put(d, "example.com", "93.184.216.34", 300, 1000)
    d = dns_put(d, "api.test.com", "10.0.0.1", 60, 1000)
    assert(dns_count(d) == 2, "2 entries")

    let r1 = dns_lookup(d, "example.com", 1100)
    assert(is_ok(r1), "lookup ok")
    assert(unwrap(r1) == "93.184.216.34", "correct ip")

    let r2 = dns_lookup(d, "api.test.com", 1100)
    assert(is_err(r2), "expired after 60s")

    let r3 = dns_lookup(d, "nope.com", 1000)
    assert(is_err(r3), "not cached")

    assert(dns_hit_rate(d) == 33, "33% hit rate")

    let e = dns_evict(d, "example.com")
    assert(is_ok(e), "evict ok")
    d = unwrap(e)
    assert(dns_count(d) == 1, "1 after evict")

    print("DNS-CACHE KAT PASS")
