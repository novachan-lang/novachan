import std/raster/raster_rect

fn _ck_i(label: string, got: int, want: int)
    if got != want
        print("FAIL raster_rect " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn _ck_b(label: string, got: bool, want: bool)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL raster_rect " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

// _pt_eq — compare two [x,y] points.
fn _pt_eq(a: list, b: list) -> bool
    let result = false
    if a[0] == b[0] and a[1] == b[1]
        result = true
    result

fn main()
    // --- KAT 1: rr_area ---
    _ck_i("area_4_3", rr_area(4, 3), 12)
    _ck_i("area_1_1", rr_area(1, 1), 1)
    _ck_i("area_0_5", rr_area(0, 5), 0)

    // --- KAT 2: rr_perimeter_points ---
    _ck_i("perim_3_3", rr_perimeter_points(3, 3), 8)
    _ck_i("perim_4_4", rr_perimeter_points(4, 4), 12)
    _ck_i("perim_1_1", rr_perimeter_points(1, 1), 1)
    _ck_i("perim_1_5", rr_perimeter_points(1, 5), 5)
    _ck_i("perim_5_1", rr_perimeter_points(5, 1), 5)
    _ck_i("perim_2_2", rr_perimeter_points(2, 2), 4)

    // --- KAT 3: rr_fill count ---
    let f32 = rr_fill(0, 0, 3, 2)
    _ck_i("fill_3x2_count", len(f32), 6)

    // --- KAT 4: rr_fill(0,0,2,2) == [[0,0],[1,0],[0,1],[1,1]] ---
    let f22 = rr_fill(0, 0, 2, 2)
    _ck_i("fill_2x2_count", len(f22), 4)
    let ok0 = 0
    if _pt_eq(f22[0], [0,0])
        ok0 = 1
    _ck_i("fill_2x2_pt0", ok0, 1)
    let ok1 = 0
    if _pt_eq(f22[1], [1,0])
        ok1 = 1
    _ck_i("fill_2x2_pt1", ok1, 1)
    let ok2 = 0
    if _pt_eq(f22[2], [0,1])
        ok2 = 1
    _ck_i("fill_2x2_pt2", ok2, 1)
    let ok3 = 0
    if _pt_eq(f22[3], [1,1])
        ok3 = 1
    _ck_i("fill_2x2_pt3", ok3, 1)

    // --- KAT 5: rr_outline of 3x3 has 8 points ---
    let ol33 = rr_outline(0, 0, 3, 3)
    _ck_i("outline_3x3_count", len(ol33), 8)
    // first point is [0,0]
    let olok = 0
    if _pt_eq(ol33[0], [0,0])
        olok = 1
    _ck_i("outline_3x3_first", olok, 1)

    // --- KAT 6: rr_outline of 1x3 == rr_fill of 1x3 (3 pts) ---
    let ol13 = rr_outline(0, 0, 1, 3)
    _ck_i("outline_1x3_count", len(ol13), 3)

    // --- KAT 7: rr_contains ---
    _ck_b("contains_22_in", rr_contains(0, 0, 4, 4, 2, 2), true)
    _ck_b("contains_44_out", rr_contains(0, 0, 4, 4, 4, 4), false)
    _ck_b("contains_00_in", rr_contains(0, 0, 4, 4, 0, 0), true)
    _ck_b("contains_39_in", rr_contains(0, 0, 4, 4, 3, 3), true)
    _ck_b("contains_neg_out", rr_contains(0, 0, 4, 4, -1, 2), false)

    // --- KAT 8: rr_intersect ---
    let ra = []
    push(ra, 0)
    push(ra, 0)
    push(ra, 5)
    push(ra, 5)
    let rb = []
    push(rb, 3)
    push(rb, 3)
    push(rb, 5)
    push(rb, 5)
    let ix = rr_intersect(ra, rb)
    _ck_i("intersect_x", ix[0], 3)
    _ck_i("intersect_y", ix[1], 3)
    _ck_i("intersect_w", ix[2], 2)
    _ck_i("intersect_h", ix[3], 2)

    // --- KAT 9: rr_intersect disjoint ---
    let rc = []
    push(rc, 0)
    push(rc, 0)
    push(rc, 2)
    push(rc, 2)
    let rd = []
    push(rd, 5)
    push(rd, 5)
    push(rd, 2)
    push(rd, 2)
    let ix2 = rr_intersect(rc, rd)
    _ck_i("intersect_disjoint_len", len(ix2), 0)

    // --- KAT 10: rr_clip ---
    let clip1 = rr_clip(2, 2, 6, 6, 0, 0, 5, 5)
    _ck_i("clip_x", clip1[0], 2)
    _ck_i("clip_y", clip1[1], 2)
    _ck_i("clip_w", clip1[2], 3)
    _ck_i("clip_h", clip1[3], 3)

    // --- KAT 11: rr_fill_to_surface ---
    let surf_px = []
    let si = 0
    while si < 25
        push(surf_px, 0)
        si = si + 1
    let surf = {}
    surf["w"] = 5
    surf["h"] = 5
    surf["px"] = surf_px
    rr_fill_to_surface(surf, 1, 1, 3, 2, 9)
    let spx = surf["px"]
    // (1,1) = idx 1*5+1=6
    _ck_i("surf_fill_11", spx[6], 9)
    // (3,2) = idx 2*5+3=13
    _ck_i("surf_fill_32", spx[13], 9)
    // (0,0) = idx 0 untouched
    _ck_i("surf_fill_00_untouched", spx[0], 0)

    // --- KAT 12: rr_rounded with radius=0 matches rr_outline ---
    let rnd0 = rr_rounded(0, 0, 3, 3, 0)
    _ck_i("rounded_r0_count", len(rnd0), 8)

    // --- KAT 13: rr_fill empty ---
    let fempty = rr_fill(0, 0, 0, 3)
    _ck_i("fill_empty", len(fempty), 0)

    print("PASS _raster_rect_test")
