fn circuit_new(threshold, reset_ms)
  let cb = {}
  cb["state"] = "closed"
  cb["failures"] = 0
  cb["threshold"] = threshold
  cb["reset_ms"] = reset_ms
  cb["last_failure"] = 0
  cb["successes"] = 0
  cb

fn circuit_call(cb, action)
  let state = cb["state"]
  if state == "open"
    let now = time_ms()
    let elapsed = now - cb["last_failure"]
    if elapsed >= cb["reset_ms"]
      cb["state"] = "half-open"
    else
      return err("circuit open")
  let result = action(0)
  if is_ok(result)
    if cb["state"] == "half-open"
      cb["state"] = "closed"
      cb["failures"] = 0
    cb["successes"] = cb["successes"] + 1
    return result
  cb["failures"] = cb["failures"] + 1
  cb["last_failure"] = time_ms()
  if cb["failures"] >= cb["threshold"]
    cb["state"] = "open"
  result

fn circuit_state(cb)
  cb["state"]

fn circuit_reset(cb)
  cb["state"] = "closed"
  cb["failures"] = 0
  cb["successes"] = 0

fn circuit_stats(cb)
  let stats = {}
  stats["state"] = cb["state"]
  stats["failures"] = cb["failures"]
  stats["successes"] = cb["successes"]
  stats

fn _good_action(x)
  ok(42)

fn _bad_action(x)
  err("service down")

fn main()
  let cb = circuit_new(3, 5000)
  assert(circuit_state(cb) == "closed", "initial closed")

  let r1 = circuit_call(cb, fn(z) _good_action(z))
  assert(is_ok(r1), "good call succeeds")
  assert(unwrap(r1) == 42, "returns value")

  let _f1 = circuit_call(cb, fn(z) _bad_action(z))
  let _f2 = circuit_call(cb, fn(z) _bad_action(z))
  assert(circuit_state(cb) == "closed", "still closed at 2 failures")

  let _f3 = circuit_call(cb, fn(z) _bad_action(z))
  assert(circuit_state(cb) == "open", "opens at threshold 3")

  let r_open = circuit_call(cb, fn(z) _good_action(z))
  assert(is_err(r_open), "rejects when open")

  circuit_reset(cb)
  assert(circuit_state(cb) == "closed", "reset to closed")

  let r_after = circuit_call(cb, fn(z) _good_action(z))
  assert(is_ok(r_after), "works after reset")

  let stats = circuit_stats(cb)
  assert(stats["state"] == "closed", "stats state")
  assert(stats["successes"] == 1, "stats successes")

  print("circuitx: all passed")
