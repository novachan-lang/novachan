import forge_hot_config

fn main()
    let hc = hc_new()
    hc = hc_set(hc, "db.host", "localhost", 1)
    hc = hc_set(hc, "db.port", "5432", 1)
    hc = hc_set(hc, "app.debug", "true", 1)
    assert(hc_key_count(hc) == 3, "3 keys")

    assert(hc_get(hc, "db.host") == "localhost", "get host")
    assert(hc_get(hc, "db.port") == "5432", "get port")
    assert(hc_get(hc, "missing") == "", "missing = empty")
    assert(hc_get_version(hc, "db.host") == 1, "version 1")

    hc = hc_reload(hc, "db.host", "prod-db.example.com", 2)
    assert(hc_get(hc, "db.host") == "prod-db.example.com", "reloaded")
    assert(hc_get_version(hc, "db.host") == 2, "version 2")
    assert(hc_reload_count(hc) == 1, "1 reload")

    hc = hc_reload(hc, "db.host", "old-value", 1)
    assert(hc_get(hc, "db.host") == "prod-db.example.com", "old version ignored")
    assert(hc_reload_count(hc) == 1, "still 1 reload")

    hc = hc_add_watcher(hc, "db.host", "on_host_change")
    hc = hc_add_watcher(hc, "db.host", "notify_pool")
    hc = hc_add_watcher(hc, "app.debug", "toggle_debug")
    let watchers = hc_watchers_for(hc, "db.host")
    assert(len(watchers) == 2, "2 watchers for host")
    assert(watchers[0] == "on_host_change", "first watcher")

    assert(hc_has_key(hc, "db.host") == 1, "has key")
    assert(hc_has_key(hc, "nope") == 0, "no key")
    assert(hc_get_version(hc, "missing") == 0, "no version")

    print("HOT-CONFIG KAT PASS")
