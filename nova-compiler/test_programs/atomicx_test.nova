// Atomics: a lock-free Atomic<int>. The NOVA memory model is happens-before via
// channel send/receive; for the rare shared lock-free counter, atomic cells give real
// hardware atomicity (clang __atomic_* -> atomicrmw/cmpxchg seq_cst). Atomic cells are
// shared across Processes (NOVA_MEM_RAW deep-copies by sharing, like channels).

fn main()
    let a = atomic_new(10)
    assert_eq(atomic_get(a), 10)
    assert_eq(atomic_add(a, 5), 15)        // fetch-add returns the NEW value
    assert_eq(atomic_get(a), 15)
    assert_eq(atomic_add(a, -3), 12)
    atomic_set(a, 100)
    assert_eq(atomic_get(a), 100)

    // compare-and-swap
    assert_eq(atomic_cas(a, 100, 200), 1)  // matches -> swaps
    assert_eq(atomic_get(a), 200)
    assert_eq(atomic_cas(a, 100, 300), 0)  // no match -> no swap
    assert_eq(atomic_get(a), 200)

    // THE proof: 4 Processes each do 1000 atomic increments on a SHARED counter.
    // Without real atomicity this loses updates; with it the total is exactly 4000.
    let counter = atomic_new(0)
    let done = channel()
    let w = 0
    while w < 4
        spawn fn()
            let k = 0
            while k < 1000
                atomic_add(counter, 1)
                k = k + 1
            send(done, 1)
        w = w + 1
    let d = 0
    while d < 4
        receive(done)
        d = d + 1
    assert_eq(atomic_get(counter), 4000)

    print("atomicx passed")
