// KAT: @cdecl C-callback entry points, called from a REAL C host (_kat_cdecl_host.c).
//
// Original (LOCK-6 Phase 2): i64-shaped callbacks, proven from qsort + a no-prior-init entry.
// 7.3 (2026-08-22): ABI-correct sized ints and floats. The wrapper now derives the exact C
// prototype from the NOVA signature, so each fn below is declared in the C host with its
// TRUE prototype -- a mismatch is a real ABI bug, not a cosmetic one.

@cdecl
fn my_compare(a: int, b: int) -> int
    if a < b
        return -1
    if a > b
        return 1
    return 0

@cdecl
fn on_event(code: int) -> int
    code * 2

// ── 7.3: narrow signed int. C prototype: int32_t narrow_i32(int32_t, int32_t)
// Discriminator: C passes -7. Correct sext -> -7. A wrong zext -> 4294967289.
@cdecl
fn narrow_i32(a: i32, b: i32) -> i32
    a + b

// ── 7.3: narrow UNSIGNED int. C prototype: uint8_t narrow_u8(uint8_t)
// Discriminator: C passes 200. Correct zext -> 200. A wrong sext -> -56.
@cdecl
fn narrow_u8(x: u8) -> u8
    x

// ── 7.3: double params AND double return. C prototype: double dmul(double, double)
// This is the case the old i64-everywhere wrapper got HARD wrong: C passes doubles in
// XMM0/XMM1, the old wrapper read RDI/RSI -- garbage.
@cdecl
fn dmul(x: float, k: float) -> float
    x * k

// ── 7.3: 32-bit float. C prototype: float fhalf(float)
@cdecl
fn fhalf(x: f32) -> f32
    x * 0.5

@export
fn lib_version() -> int
    1

fn main()
    print("unused in library mode")
