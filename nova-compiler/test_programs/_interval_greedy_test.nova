import std/greedy/interval_greedy

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _interval_greedy_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── ig_min_removals ────────────────────────────────────────────────────
    // [[1,2],[2,3],[3,4],[1,3]]: max non-overlap=3, removals=1
    let ivs1 = []
    let iv1a = []
    push(iv1a, 1)
    push(iv1a, 2)
    push(ivs1, iv1a)
    let iv1b = []
    push(iv1b, 2)
    push(iv1b, 3)
    push(ivs1, iv1b)
    let iv1c = []
    push(iv1c, 3)
    push(iv1c, 4)
    push(ivs1, iv1c)
    let iv1d = []
    push(iv1d, 1)
    push(iv1d, 3)
    push(ivs1, iv1d)
    cki("min_removals_1", ig_min_removals(ivs1), 1)

    // empty: 0 removals
    let ivs_empty = []
    cki("min_removals_empty", ig_min_removals(ivs_empty), 0)

    // single interval: 0 removals
    let ivs_single = []
    let iv_s = []
    push(iv_s, 1)
    push(iv_s, 5)
    push(ivs_single, iv_s)
    cki("min_removals_single", ig_min_removals(ivs_single), 0)

    // all overlapping: [[1,10],[1,10],[1,10]] -> keep 1, remove 2
    let ivs2 = []
    let p1 = []
    push(p1, 1)
    push(p1, 10)
    push(ivs2, p1)
    let p2 = []
    push(p2, 1)
    push(p2, 10)
    push(ivs2, p2)
    let p3 = []
    push(p3, 1)
    push(p3, 10)
    push(ivs2, p3)
    cki("min_removals_all_overlap", ig_min_removals(ivs2), 2)

    // ── ig_min_arrows ──────────────────────────────────────────────────────
    // [[10,16],[2,8],[1,6],[7,12]]: sort by end -> [1,6],[2,8],[7,12],[10,16]
    // arrow at 6: pierces [1,6] and [2,8]; arrow at 12: pierces [7,12] and [10,16] -> 2
    let ivs3 = []
    let q1 = []
    push(q1, 10)
    push(q1, 16)
    push(ivs3, q1)
    let q2 = []
    push(q2, 2)
    push(q2, 8)
    push(ivs3, q2)
    let q3 = []
    push(q3, 1)
    push(q3, 6)
    push(ivs3, q3)
    let q4 = []
    push(q4, 7)
    push(q4, 12)
    push(ivs3, q4)
    cki("min_arrows_2", ig_min_arrows(ivs3), 2)

    // [[1,2],[3,4],[5,6],[7,8]]: all disjoint, need 4 arrows
    let ivs4 = []
    let r1 = []
    push(r1, 1)
    push(r1, 2)
    push(ivs4, r1)
    let r2 = []
    push(r2, 3)
    push(r2, 4)
    push(ivs4, r2)
    let r3 = []
    push(r3, 5)
    push(r3, 6)
    push(ivs4, r3)
    let r4 = []
    push(r4, 7)
    push(r4, 8)
    push(ivs4, r4)
    cki("min_arrows_4", ig_min_arrows(ivs4), 4)

    // empty: 0 arrows
    cki("min_arrows_empty", ig_min_arrows(ivs_empty), 0)

    // single: 1 arrow
    cki("min_arrows_single", ig_min_arrows(ivs_single), 1)

    // all same: [[2,5],[2,5],[2,5]] -> 1 arrow at 5
    let ivs5 = []
    let s1 = []
    push(s1, 2)
    push(s1, 5)
    push(ivs5, s1)
    let s2 = []
    push(s2, 2)
    push(s2, 5)
    push(ivs5, s2)
    let s3 = []
    push(s3, 2)
    push(s3, 5)
    push(ivs5, s3)
    cki("min_arrows_same", ig_min_arrows(ivs5), 1)

    // ── ig_max_nonoverlap ──────────────────────────────────────────────────
    // [[1,2],[2,3],[3,4],[1,3]]: sort by end -> [1,2],[1,3],[2,3],[3,4]
    // pick [1,2](end=2), skip [1,3](1<2), pick [2,3](2>=2), pick [3,4](3>=3) -> 3
    cki("max_nonoverlap_3", ig_max_nonoverlap(ivs1), 3)

    // empty: 0
    cki("max_nonoverlap_empty", ig_max_nonoverlap(ivs_empty), 0)

    // single: 1
    cki("max_nonoverlap_single", ig_max_nonoverlap(ivs_single), 1)

    // all disjoint: [[1,2],[3,4],[5,6]] -> 3
    let ivs6 = []
    let t1 = []
    push(t1, 1)
    push(t1, 2)
    push(ivs6, t1)
    let t2 = []
    push(t2, 3)
    push(t2, 4)
    push(ivs6, t2)
    let t3 = []
    push(t3, 5)
    push(t3, 6)
    push(ivs6, t3)
    cki("max_nonoverlap_disjoint", ig_max_nonoverlap(ivs6), 3)

    print("PASS _interval_greedy_test")
