import std/bits/rankselect

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL rankselect " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // rk_popcount
    cki("popcount(0)", rk_popcount(0), 0)
    cki("popcount(1)", rk_popcount(1), 1)
    cki("popcount(255)", rk_popcount(255), 8)
    cki("popcount(10)", rk_popcount(10), 2)

    // rk_rank
    cki("rank(255,4)", rk_rank(255, 4), 4)
    cki("rank(10,4)", rk_rank(10, 4), 2)
    cki("rank(10,2)", rk_rank(10, 2), 1)
    cki("rank(0,8)", rk_rank(0, 8), 0)
    cki("rank(255,8)", rk_rank(255, 8), 8)
    cki("rank(x,0)", rk_rank(255, 0), 0)

    // rk_select
    cki("select(10,1)", rk_select(10, 1), 1)
    cki("select(10,2)", rk_select(10, 2), 3)
    cki("select(255,8)", rk_select(255, 8), 7)
    cki("select(10,3)", rk_select(10, 3), 0 - 1)
    cki("select(0,1)", rk_select(0, 1), 0 - 1)
    cki("select(1,1)", rk_select(1, 1), 0)
    cki("select(255,1)", rk_select(255, 1), 0)

    // rk_count_range
    cki("range(255,2,6)", rk_count_range(255, 2, 6), 4)
    cki("range(10,0,2)", rk_count_range(10, 0, 2), 1)
    cki("range(0,0,8)", rk_count_range(0, 0, 8), 0)
    cki("range(255,0,8)", rk_count_range(255, 0, 8), 8)
    cki("range(x,lo=hi)", rk_count_range(255, 3, 3), 0)

    print("PASS _rankselect_test")
