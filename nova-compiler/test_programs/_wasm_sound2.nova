// Soundness batch 2: recursion, a big loop, bitwise, signed div/mod, string ops -- each returns a RAW value;
// wasm must equal native exactly. The trap-on-unknown-import harness flags any new undefined compiler-rt builtin.
fn fib(n: int) -> int
    if n < 2
        n
    else
        fib(n - 1) + fib(n - 2)
fn recur() -> int
    fib(28)
fn bigsum() -> int
    let s = 0
    let i = 0
    while i < 10000
        s = s + i
        i = i + 1
    s
fn bitops() -> int
    let a = 61680
    let b = 4080
    (a & b) + (a | b) + (a ^ b) + (a << 3) + (a >> 2)
fn signed() -> int
    let x = 0 - 7
    let q = x / 2
    x * 1000 + q * 100 + (x - q * 2)
fn strops() -> int
    let s = "hello world foo bar baz"
    len(s) * 1000 + find(s, "foo")
fn main()
    print(str(recur()) + " " + str(bigsum()) + " " + str(bitops()) + " " + str(signed()) + " " + str(strops()))
