import std/interval/interval_tree2

fn main()
    let t = it_build([[1,3],[5,8],[6,10],[15,20]])
    let c = it_count(t)
    print("count=" + str(c))
    let all = it_all(t)
    let i = 0
    while i < len(all)
        let ii = i
        let iv = all[ii]
        print("iv[" + str(ii) + "]=" + str(iv[0]) + "," + str(iv[1]))
        i = i + 1
    let r = it_query_point(t, 6)
    print("query_point(6) len=" + str(len(r)))

main()
