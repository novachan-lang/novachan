// Bootstrap test 22: if-as-expression (ternary)
// Used in the self-hosted compiler for inline conditionals

let x = 5
let label = if x > 3
    "big"
else
    "small"
print(label)

// If-expression in function
fn abs_val(n)
    return if n < 0
        -n
    else
        n

print(abs_val(-7))
print(abs_val(3))

// If-expression in assignment
let a = 10
let b = 20
let max_val = if a > b
    a
else
    b
print(max_val)

// Chained if-expression
fn sign(n)
    return if n > 0
        "positive"
    else if n < 0
        "negative"
    else
        "zero"

print(sign(5))
print(sign(-3))
print(sign(0))
