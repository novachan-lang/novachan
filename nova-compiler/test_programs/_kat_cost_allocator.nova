import forge_cost_allocator

fn main()
    let s = ca_new()
    s = ca_add_service(s, "api", "team-a")
    s = ca_add_service(s, "worker", "team-a")
    s = ca_add_service(s, "db", "team-b")

    assert(ca_service_count(s) == 3, "3 services")
    assert(ca_has_service(s, "api") == 1, "api exists")
    assert(ca_has_service(s, "ghost") == 0, "ghost does not exist")

    let r1 = ca_record_cost(s, "api", 100)
    assert(is_ok(r1), "record cost ok")
    let r1b = ca_record_cost(s, "api", 50)
    assert(is_ok(r1b), "record cost 1b ok")
    let r2 = ca_record_cost(s, "worker", 20)
    assert(is_ok(r2), "record cost 2 ok")
    let r3 = ca_record_cost(s, "db", 300)
    assert(is_ok(r3), "record cost 3 ok")

    let tc = ca_total_cost(s, "api")
    assert(is_ok(tc), "total cost ok")
    assert(unwrap(tc) == 150, "api total is 150")

    assert(ca_owner_cost(s, "team-a") == 170, "team-a owns 170 (api 150 + worker 20)")
    assert(ca_owner_cost(s, "team-b") == 300, "team-b owns 300")

    assert(ca_total_spend(s) == 470, "total spend is 470")
    assert(ca_cost_count(s) == 4, "4 cost entries recorded")

    let top = ca_top_service(s)
    assert(is_ok(top), "top service ok")
    assert(unwrap(top) == "db", "db is top service")

    assert(is_err(ca_record_cost(s, "ghost", 10)), "unknown service errors")
    assert(is_err(ca_total_cost(s, "ghost")), "unknown service total errors")

    let empty = ca_new()
    assert(is_err(ca_top_service(empty)), "no services errors")

    print("COST-ALLOCATOR KAT PASS")
