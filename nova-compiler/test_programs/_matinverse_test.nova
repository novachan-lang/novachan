// KAT for std/matrix/matinverse — matrix inverse via Gauss-Jordan.
import std/matrix/matinverse

// ckf — float tolerance check.
fn ckf(label, got, want)
    let diff = got - want
    if diff < 0.0
        diff = 0.0 - diff
    if diff > 0.0001
        print("FAIL matinverse " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// cki — exact int check.
fn cki(label, got, want)
    if got != want
        print("FAIL matinverse " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb — bool check.
fn ckb(label, got, want)
    if got != want
        print("FAIL matinverse " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// get_elem — read element (i,j) from a matrix dict by direct indexing.
fn get_elem(m, i, j)
    let c = m["c"]
    let dat = m["d"]
    let k = i * c + j
    dat[k] * 1.0

fn main()
    // --- mi_inverse([[4,7],[2,6]]) == [[0.6,-0.7],[-0.2,0.4]] ---
    // det = 24 - 14 = 10; inv = 1/10 * [[6,-7],[-2,4]]
    let d47 = {}
    d47["r"] = 2
    d47["c"] = 2
    let raw47 = [4.0, 7.0, 2.0, 6.0]
    d47["d"] = raw47
    let inv47 = mi_inverse(d47)
    let inv47_data = inv47["d"]
    let i00 = inv47_data[0] * 1.0
    let i01 = inv47_data[1] * 1.0
    let i10 = inv47_data[2] * 1.0
    let i11 = inv47_data[3] * 1.0
    ckf("inv47(0,0)", i00, 0.6)
    ckf("inv47(0,1)", i01, 0.0 - 0.7)
    ckf("inv47(1,0)", i10, 0.0 - 0.2)
    ckf("inv47(1,1)", i11, 0.4)

    // --- ROUND-TRIP: A * inv(A) == I (mi_verify) ---
    let vflag = mi_verify(d47, 0.0001)
    ckb("verify_47_true", vflag, true)

    // --- mi_inverse(mi_inverse(A)) approx A ---
    let inv_inv = mi_inverse(inv47)
    let ii_data = inv_inv["d"]
    let ii00 = ii_data[0] * 1.0
    let ii01 = ii_data[1] * 1.0
    let ii10 = ii_data[2] * 1.0
    let ii11 = ii_data[3] * 1.0
    ckf("inv_inv(0,0)", ii00, 4.0)
    ckf("inv_inv(0,1)", ii01, 7.0)
    ckf("inv_inv(1,0)", ii10, 2.0)
    ckf("inv_inv(1,1)", ii11, 6.0)

    // --- mi_inverse_2x2([[1,2],[3,4]]) == [[-2,1],[1.5,-0.5]] ---
    // det = 4 - 6 = -2; inv = 1/-2 * [[4,-2],[-3,1]] = [[-2,1],[1.5,-0.5]]
    let d12 = {}
    d12["r"] = 2
    d12["c"] = 2
    let raw12 = [1.0, 2.0, 3.0, 4.0]
    d12["d"] = raw12
    let inv2x2 = mi_inverse_2x2(d12)
    let inv2_data = inv2x2["d"]
    let j00 = inv2_data[0] * 1.0
    let j01 = inv2_data[1] * 1.0
    let j10 = inv2_data[2] * 1.0
    let j11 = inv2_data[3] * 1.0
    ckf("inv2x2(0,0)", j00, 0.0 - 2.0)
    ckf("inv2x2(0,1)", j01, 1.0)
    ckf("inv2x2(1,0)", j10, 1.5)
    ckf("inv2x2(1,1)", j11, 0.0 - 0.5)

    // --- Singular 2x2: [[1,2],[2,4]] -> mi_inverse returns empty list ---
    let dsing = {}
    dsing["r"] = 2
    dsing["c"] = 2
    let rawsing = [1.0, 2.0, 2.0, 4.0]
    dsing["d"] = rawsing
    let inv_sing = mi_inverse(dsing)
    cki("sing_empty_len", len(inv_sing), 0)

    // --- mi_is_invertible: singular -> false ---
    let inv_flag = mi_is_invertible(dsing, 0.0001)
    ckb("is_invertible_false", inv_flag, false)

    // --- mi_is_invertible: non-singular -> true ---
    let inv_flag2 = mi_is_invertible(d47, 0.0001)
    ckb("is_invertible_true", inv_flag2, true)

    // --- 3x3 inverse: A = [[1,2,3],[0,1,4],[5,6,0]] ---
    // det = 1*(0-24) - 2*(0-20) + 3*(0-5) = -24 + 40 - 15 = 1
    // Known inverse: [[-24,18,5],[20,-15,-4],[-5,4,1]]
    let d3 = {}
    d3["r"] = 3
    d3["c"] = 3
    let raw3 = [1.0, 2.0, 3.0, 0.0, 1.0, 4.0, 5.0, 6.0, 0.0]
    d3["d"] = raw3
    let inv3 = mi_inverse_3x3(d3)
    let inv3_data = inv3["d"]
    let e00 = inv3_data[0] * 1.0
    let e01 = inv3_data[1] * 1.0
    let e02 = inv3_data[2] * 1.0
    let e10 = inv3_data[3] * 1.0
    let e11 = inv3_data[4] * 1.0
    let e12 = inv3_data[5] * 1.0
    let e20 = inv3_data[6] * 1.0
    let e21 = inv3_data[7] * 1.0
    let e22 = inv3_data[8] * 1.0
    ckf("inv3x3(0,0)", e00, 0.0 - 24.0)
    ckf("inv3x3(0,1)", e01, 18.0)
    ckf("inv3x3(0,2)", e02, 5.0)
    ckf("inv3x3(1,0)", e10, 20.0)
    ckf("inv3x3(1,1)", e11, 0.0 - 15.0)
    ckf("inv3x3(1,2)", e12, 0.0 - 4.0)
    ckf("inv3x3(2,0)", e20, 0.0 - 5.0)
    ckf("inv3x3(2,1)", e21, 4.0)
    ckf("inv3x3(2,2)", e22, 1.0)

    // --- Round-trip: A * inv(A) == I for 3x3 ---
    let vflag3 = mi_verify(d3, 0.0001)
    ckb("verify_3x3_true", vflag3, true)

    // --- mi_solve_via_inverse: A x = b ---
    // A = [[2,1],[1,3]], b = [3,5] -> x = [0.8, 1.4]
    let dasv = {}
    dasv["r"] = 2
    dasv["c"] = 2
    let rawasv = [2.0, 1.0, 1.0, 3.0]
    dasv["d"] = rawasv
    let bsv = [3.0, 5.0]
    let xsv = mi_solve_via_inverse(dasv, bsv)
    let xsv0 = xsv[0] * 1.0
    let xsv1 = xsv[1] * 1.0
    ckf("solve_via_inv_x1", xsv0, 0.8)
    ckf("solve_via_inv_x2", xsv1, 1.4)

    // --- mi_solve_via_inverse with singular -> empty ---
    let bsing2 = [1.0, 2.0]
    let xsing = mi_solve_via_inverse(dsing, bsing2)
    cki("solve_via_inv_sing_empty", len(xsing), 0)

    // --- mi_verify for 2x2 round-trip ---
    let vflag2x2 = mi_verify(d12, 0.0001)
    ckb("verify_2x2_roundtrip", vflag2x2, true)

    print("PASS _matinverse_test")
