import forge_rollback_manager

fn main()
    let r = rm_new()
    r = rm_deploy(r, "v1.0.0")
    r = rm_deploy(r, "v1.1.0")
    r = rm_deploy(r, "v1.2.0")
    assert(rm_deploy_count(r) == 3, "3 deploys")

    let cur = rm_current(r)
    assert(is_ok(cur), "current ok")
    assert(unwrap(cur) == "v1.2.0", "current v1.2.0")

    let rb1 = rm_rollback(r)
    assert(is_ok(rb1), "rollback ok")
    r = unwrap(rb1)
    let cur2 = rm_current(r)
    assert(unwrap(cur2) == "v1.1.0", "rolled back to v1.1.0")
    assert(rm_rollback_count(r) == 1, "1 rollback")

    let v1 = rm_version_at(r, 1)
    assert(is_ok(v1), "v1 ok")
    assert(unwrap(v1) == "v1.0.0", "first was v1.0.0")

    let empty = rm_new()
    assert(is_err(rm_current(empty)), "no deployments")

    let single = rm_new()
    single = rm_deploy(single, "v0.1")
    assert(is_err(rm_rollback(single)), "cant rollback single")

    print("ROLLBACK-MANAGER KAT PASS")
