import std/core/dict

fn main() -> int
    let fails = 0
    let d = {}
    d["a"] = 1
    d["b"] = 2
    d["c"] = 3
    if dict_get_or(d, "a", 0) != 1
        print("FAIL get_or hit")
        fails = fails + 1
    if dict_get_or(d, "z", 99) != 99
        print("FAIL get_or miss")
        fails = fails + 1
    let kw = dict_keys_where(d, fn(v) v > 1)
    if len(kw) != 2
        print("FAIL keys_where=" + str(len(kw)))
        fails = fails + 1
    let dv = dict_map_values(d, fn(v) v * 10)
    if dict_get_or(dv, "b", 0) != 20
        print("FAIL map_values")
        fails = fails + 1
    let e = {}
    e["b"] = 200
    e["d"] = 4
    let m = dict_merge(d, e)
    if dict_get_or(m, "b", 0) != 200
        print("FAIL merge override")
        fails = fails + 1
    if dict_get_or(m, "a", 0) != 1
        print("FAIL merge keep")
        fails = fails + 1
    if dict_get_or(m, "d", 0) != 4
        print("FAIL merge new")
        fails = fails + 1
    if dict_count(d, fn(v) v >= 2) != 2
        print("FAIL count")
        fails = fails + 1
    if not dict_any_value(d, fn(v) v == 3)
        print("FAIL any_value")
        fails = fails + 1
    if fails == 0
        print("PASS _kat_dict")
    else
        print("FAILED _kat_dict")
    return 0
