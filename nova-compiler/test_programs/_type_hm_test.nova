import std/typesystem/type_hm

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _type_hm_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL _type_hm_test " + label + ": got=" + got + " want=" + want)
        exit(1)

fn ckb(label: string, got: int, want: int)
    if got != want
        print("FAIL _type_hm_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// Build term helpers
fn mk_var(name)
    let t = []
    push(t, "var")
    push(t, name)
    t

fn mk_lam(x, body)
    let t = []
    push(t, "lam")
    push(t, x)
    push(t, body)
    t

fn mk_app(f, a)
    let t = []
    push(t, "app")
    push(t, f)
    push(t, a)
    t

fn mk_let(x, e1, e2)
    let t = []
    push(t, "let")
    push(t, x)
    push(t, e1)
    push(t, e2)
    t

fn mk_tvar(k)
    let t = []
    push(t, "tvar")
    push(t, k)
    t

fn mk_arr(a, b)
    let t = []
    push(t, "arr")
    push(t, a)
    push(t, b)
    t

fn main()
    // --- KAT 1: let id = lam x. x in id id  =>  alpha-equal to a->a ---
    // This REQUIRES let-generalization: id is generalized to forall a. a->a,
    // so (id id) applies it at two different types: (a->a)->(a->a) then a->a.
    // Without let-gen this would FAIL (id applied to id needs occurs check).
    let id_def = mk_lam("x", mk_var("x"))
    let id_id = mk_app(mk_var("id"), mk_var("id"))
    let let_id_id = mk_let("id", id_def, id_id)
    let ty1 = thm_infer(let_id_id)
    cki("let_id_id_not_fail", ty1 == "FAIL", 0)
    cks("let_id_id_tag", ty1[0], "arr")
    let want_aa = mk_arr(mk_tvar(0), mk_tvar(0))
    cki("let_id_id_alpha_aa", thm_alpha_eq(ty1, want_aa), 1)

    // --- KAT 2: lam f. f f  =>  FAIL (even in HM, lambda-bound f is mono) ---
    let lam_ff = mk_lam("f", mk_app(mk_var("f"), mk_var("f")))
    let ty2 = thm_infer(lam_ff)
    cks("lam_ff_fail", ty2, "FAIL")

    // --- KAT 3: let k = lam x. lam y. x in k  =>  alpha-equal to a->(b->a) ---
    let k_def = mk_lam("x", mk_lam("y", mk_var("x")))
    let let_k = mk_let("k", k_def, mk_var("k"))
    let ty3 = thm_infer(let_k)
    cki("let_k_not_fail", ty3 == "FAIL", 0)
    let want_aba = mk_arr(mk_tvar(0), mk_arr(mk_tvar(1), mk_tvar(0)))
    cki("let_k_alpha_eq", thm_alpha_eq(ty3, want_aba), 1)
    // Canon check: outer dom == inner cod
    let ty3_c = thm_canonicalize(ty3)
    cki("let_k_outer_dom_eq_inner_cod", ty3_c[1][1], ty3_c[2][2][1])

    // --- KAT 4: Demonstrate let-polymorphism is KEY ---
    // Without let-gen: (lam id. id id) fails (same as tinf FAIL from self-app)
    // With let-gen: (let id=lam x.x in id id) succeeds (a->a)
    // We already confirmed KAT1 succeeds and KAT2 fails — now also check
    // that the pure-lam self-application case fails even in HM:
    let self_app = mk_lam("x", mk_app(mk_var("x"), mk_var("x")))
    let ty4 = thm_infer(self_app)
    cks("selfapp_fail_hm", ty4, "FAIL")

    // --- KAT 5: let id = lam x.x in lam y. id y  =>  alpha a->a ---
    // Uses id polymorphically inside another lambda
    let id_y = mk_app(mk_var("id"), mk_var("y"))
    let lam_y_id_y = mk_lam("y", id_y)
    let let_id_lam = mk_let("id", mk_lam("x", mk_var("x")), lam_y_id_y)
    let ty5 = thm_infer(let_id_lam)
    cki("let_id_lam_not_fail", ty5 == "FAIL", 0)
    cki("let_id_lam_alpha_aa", thm_alpha_eq(ty5, want_aa), 1)

    // --- KAT 6: let twice = lam f. lam x. f (f x) in twice  =>  (a->a)->(a->a) ---
    let f_fx = mk_app(mk_var("f"), mk_app(mk_var("f"), mk_var("x")))
    let twice_def = mk_lam("f", mk_lam("x", f_fx))
    let let_twice = mk_let("twice", twice_def, mk_var("twice"))
    let ty6 = thm_infer(let_twice)
    cki("twice_not_fail", ty6 == "FAIL", 0)
    let want_twice = mk_arr(mk_arr(mk_tvar(0), mk_tvar(0)), mk_arr(mk_tvar(0), mk_tvar(0)))
    cki("twice_alpha_eq", thm_alpha_eq(ty6, want_twice), 1)

    // --- KAT 7: nested let — let id=lam x.x in let k=lam x.lam y.x in id k ---
    // id k: id is forall a. a->a; applied to k :: forall a b. a->b->a => gives k's type
    let k_type = mk_arr(mk_tvar(0), mk_arr(mk_tvar(1), mk_tvar(0)))
    let id_k = mk_app(mk_var("id"), mk_var("k"))
    let nested = mk_let("id", mk_lam("x", mk_var("x")), mk_let("k", mk_lam("x", mk_lam("y", mk_var("x"))), id_k))
    let ty7 = thm_infer(nested)
    cki("nested_not_fail", ty7 == "FAIL", 0)
    cki("nested_alpha_k", thm_alpha_eq(ty7, k_type), 1)

    // --- KAT 8: thm_alpha_eq is symmetric and reflexive ---
    cki("alpha_refl", thm_alpha_eq(want_aa, want_aa), 1)
    cki("alpha_sym", thm_alpha_eq(want_aba, mk_arr(mk_tvar(2), mk_arr(mk_tvar(3), mk_tvar(2)))), 1)

    // --- KAT 9: var not in env fails ---
    let unbound = thm_infer(mk_var("z"))
    cks("unbound_fail", unbound, "FAIL")

    // --- KAT 10: lam x. x alone still works (same as tinf) ---
    let id_only = thm_infer(mk_lam("x", mk_var("x")))
    cki("hm_id_not_fail", id_only == "FAIL", 0)
    cki("hm_id_alpha_aa", thm_alpha_eq(id_only, want_aa), 1)

    print("PASS _type_hm_test")

main()
