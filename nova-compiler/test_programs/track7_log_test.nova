// Track 7: Structured logging test

fn main()
    log_set_level(2)  // INFO
    let fields = {}
    fields["user"] = "alice"
    fields["action"] = "login"
    log_info("User logged in", fields)

    log_set_level(0)  // TRACE - show all
    let fields2 = {}
    fields2["latency_ms"] = "42"
    log_trace("Request complete", fields2)

    log_set_json(1)
    let fields3 = {}
    fields3["code"] = "200"
    log_info("Response sent", fields3)
    log_set_json(0)

    print("Log test passed")
