// cluster_pmap_node.nova — a cluster node for the DISTRIBUTED SCATTER-GATHER test.
// Args: <port> [seeds...] [drive]. A "drive" node joins, converges, then cluster_pmaps
// add over [[1,2],[3,4],[5,6]] across the LIVE peers and prints the gathered results IN
// ORDER as "PMAP=v0,v1,v2" (each slot = its value, or "ERR(..)" if that task's peer was
// unreachable). Every other node is a WORKER that stays up to serve spawn requests. All
// run the SAME program, so each worker has `add` registered (unmangled) in its fn registry.
import clusterx

fn add(a, b)
    a + b

fn main()
    let argv = args()
    let port = parse_int(argv[1])
    let seeds = []
    let is_driver = false
    let i = 2
    while i < len(argv)
        if argv[i] == "drive"
            is_driver = true
        else
            push(seeds, argv[i])
        i = i + 1
    let info = cluster_start(port, seeds)
    if is_driver
        sleep(2800)                          // converge so live peers are known
        let r = cluster_pmap(info, "add", [[1, 2], [3, 4], [5, 6]])
        if r["ok"]
            let out = "PMAP="
            let vs = r["values"]
            let k = 0
            while k < len(vs)
                let slot = vs[k]
                if slot["ok"]
                    out = out + str(slot["value"])
                else
                    out = out + "ERR"
                if k < len(vs) - 1
                    out = out + ","
                k = k + 1
            print(out)
        else
            print("ERROR=" + r["error"])
        exit(0)
    sleep(7000)                              // worker: stay up to serve, then exit
    print("WORKER done")
    exit(0)
