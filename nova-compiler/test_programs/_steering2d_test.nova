// KAT for std/game2d/steering2d -- 2D steering behaviors.
import std/game2d/steering2d

// approx: tolerance-based float equality check (tol=0.0001).
fn approx(a: float, b: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    d < 0.0001

// vec_approx: check two 2-element float lists are component-wise close.
fn vec_approx(label: string, got: any, wx: float, wy: float)
    let gx = got[0] * 1.0
    let gy = got[1] * 1.0
    if not approx(gx, wx)
        print("FAIL steering2d " + label + ": got[0]=" + str(gx) + " want=" + str(wx))
        exit(1)
    if not approx(gy, wy)
        print("FAIL steering2d " + label + ": got[1]=" + str(gy) + " want=" + str(wy))
        exit(1)

// ckf: exact float KAT.
fn ckf(label: string, got: float, want: float)
    if not approx(got, want)
        print("FAIL steering2d " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // st_length(3,4) == 5.0
    let len34 = st_length(3.0, 4.0)
    ckf("st_length_3_4", len34, 5.0)

    // st_normalize(3,4) == [0.6, 0.8]
    let norm34 = st_normalize(3.0, 4.0)
    vec_approx("st_normalize_3_4", norm34, 0.6, 0.8)

    // st_normalize(0,0) == [0.0, 0.0]
    let norm00 = st_normalize(0.0, 0.0)
    vec_approx("st_normalize_0_0", norm00, 0.0, 0.0)

    // st_dist(0,0, 3,4) == 5.0
    let dist34 = st_dist(0.0, 0.0, 3.0, 4.0)
    ckf("st_dist_3_4", dist34, 5.0)

    // st_seek(0,0, 0,0, 10,0, 5.0) == [5.0, 0.0]
    // direction = [10,0]-[0,0]=[10,0]; normalize=[1,0]; * 5.0 = [5,0]
    let sk = st_seek(0.0, 0.0, 0.0, 0.0, 10.0, 0.0, 5.0)
    vec_approx("st_seek_toward_x", sk, 5.0, 0.0)

    // st_flee(0,0, 10,0, 5.0) == [-5.0, 0.0]
    // direction away = [0,0]-[10,0]=[-10,0]; normalize=[-1,0]; * 5.0 = [-5,0]
    let fl = st_flee(0.0, 0.0, 10.0, 0.0, 5.0)
    vec_approx("st_flee_from_x", fl, 0.0 - 5.0, 0.0)

    // st_limit(6,8, 5.0): magnitude = 10, capped to 5 -> [3, 4]
    let lim = st_limit(6.0, 8.0, 5.0)
    vec_approx("st_limit_6_8", lim, 3.0, 4.0)

    // st_limit(1,0, 5.0): magnitude = 1 < 5 -> unchanged [1,0]
    let lim2 = st_limit(1.0, 0.0, 5.0)
    vec_approx("st_limit_under", lim2, 1.0, 0.0)

    // st_arrive(0,0, 3,0, 10.0, 5.0):
    // dist=3 < slow_radius=5 -> speed = 10*3/5 = 6.0; direction=[1,0]; result=[6,0]
    let arr = st_arrive(0.0, 0.0, 3.0, 0.0, 10.0, 5.0)
    vec_approx("st_arrive_slow_zone", arr, 6.0, 0.0)

    // st_arrive outside slow_radius: target at 20,0, slow_radius=5 -> full speed=10
    let arr2 = st_arrive(0.0, 0.0, 20.0, 0.0, 10.0, 5.0)
    vec_approx("st_arrive_full_speed", arr2, 10.0, 0.0)

    // st_scale(3,4, 2.0) == [6, 8]
    let sc = st_scale(3.0, 4.0, 2.0)
    vec_approx("st_scale_3_4_2", sc, 6.0, 8.0)

    // st_pursue: target at (10,0) moving at (0,0) (stationary) -> same as seek
    let pur = st_pursue(0.0, 0.0, 10.0, 0.0, 0.0, 0.0, 5.0)
    vec_approx("st_pursue_stationary", pur, 5.0, 0.0)

    print("PASS _steering2d_test")
