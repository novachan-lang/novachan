import std/interval/interval_tree2

fn main()
    let inputs = []
    push(inputs, [1,3])
    push(inputs, [5,8])
    push(inputs, [6,10])
    push(inputs, [15,20])
    let t = it_build(inputs)
    let c = it_count(t)
    print("count=" + str(c))
    let all = it_all(t)
    let i = 0
    while i < len(all)
        let ii = i
        let iv = all[ii]
        print("iv[" + str(ii) + "]=" + str(iv[0]) + "," + str(iv[1]))
        i = i + 1

main()
