import forge_greedy

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // jump game
    fails = fails + expect("jg_yes", str(jump_game([2, 3, 1, 1, 4])), "true")
    fails = fails + expect("jg_no", str(jump_game([3, 2, 1, 0, 4])), "false")
    fails = fails + expect("jg_single", str(jump_game([0])), "true")
    fails = fails + expect("jg_zeros", str(jump_game([0, 1])), "false")

    // min jumps
    fails = fails + expect("mj1", str(min_jumps([2, 3, 1, 1, 4])), "2")
    fails = fails + expect("mj2", str(min_jumps([2, 3, 0, 1, 4])), "2")
    fails = fails + expect("mj_ones", str(min_jumps([1, 1, 1, 1])), "3")
    fails = fails + expect("mj_single", str(min_jumps([5])), "0")

    // gas station
    fails = fails + expect("gas1", str(gas_station([1, 2, 3, 4, 5], [3, 4, 5, 1, 2])), "3")
    fails = fails + expect("gas_none", str(gas_station([2, 3, 4], [3, 4, 3])), "-1")
    fails = fails + expect("gas_start0", str(gas_station([5, 1, 2, 3, 4], [4, 4, 1, 5, 1])), "4")

    // house robber (max non-adjacent sum)
    fails = fails + expect("hr1", str(max_non_adjacent_sum([2, 7, 9, 3, 1])), "12")
    fails = fails + expect("hr2", str(max_non_adjacent_sum([2, 1, 1, 2])), "4")
    fails = fails + expect("hr_single", str(max_non_adjacent_sum([5])), "5")
    fails = fails + expect("hr_empty", str(max_non_adjacent_sum([])), "0")
    fails = fails + expect("hr_two", str(max_non_adjacent_sum([3, 10])), "10")

    if fails == 0
        print("forge_greedy: all passed")
    else
        print("forge_greedy: " + str(fails) + " FAILED")
