import std/core/seq
fn main()
    print("take    " + str(seq_take([1,2,3],2)) + str(seq_take([1,2,3],9)) + str(seq_take([1,2,3],0)) + str(seq_take([1,2,3],-1)) + str(seq_take([],2)))
    print("drop    " + str(seq_drop([1,2,3],1)) + str(seq_drop([1,2,3],9)) + str(seq_drop([1,2,3],-1)) + str(seq_drop([],1)))
    print("zip     " + str(seq_zip([1,2,3],[4,5])) + str(seq_zip([],[1])) + str(seq_zip([1],[])))
    print("zipwith " + str(seq_zip_with([1,2],[3,4],(a,b) => a+b)) + str(seq_zip_with([],[1],(a,b) => a)))
    print("reverse " + str(seq_reverse([1,2,3])) + str(seq_reverse([])) + str(seq_reverse([9])))
    print("enum    " + str(seq_enumerate(["a","b"])) + str(seq_enumerate([])))
    print("flatmap " + str(seq_flat_map([1,2], x => [x,x])) + str(seq_flat_map([], x => [x])))
    print("windows " + str(seq_windows([1,2,3],2)) + str(seq_windows([1],3)))
    print("chunk   " + str(seq_chunk([1,2,3,4,5],2)))
    print("fold    " + str(seq_fold([1,2,3], 0, (a,x) => a+x)))
    print("find    " + str(seq_find([1,2,3], x => x>1)) + " any " + str(seq_any([1,2],x => x>1)) + " all " + str(seq_all([1,2],x => x>0)))
    print("distinct" + str(seq_distinct([3,1,3,2])))
