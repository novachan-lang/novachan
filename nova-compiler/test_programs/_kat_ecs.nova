import forge_ecs

fn main()
    let w = ecs_world()
    w = ecs_spawn(w)
    let e1 = ecs_last_id(w)
    w = ecs_spawn(w)
    let e2 = ecs_last_id(w)
    w = ecs_spawn(w)
    let e3 = ecs_last_id(w)

    assert(ecs_entity_count(w) == 3, "3 entities")

    w = ecs_attach(w, e1, "position", "10,20")
    w = ecs_attach(w, e1, "velocity", "1,0")
    w = ecs_attach(w, e2, "position", "50,50")
    w = ecs_attach(w, e3, "position", "0,0")
    w = ecs_attach(w, e3, "health", 100)

    assert(ecs_get(w, e1, "position") == "10,20", "e1 position")
    assert(ecs_get(w, e3, "health") == 100, "e3 health")
    assert(ecs_has(w, e1, "velocity") == true, "e1 has velocity")
    assert(ecs_has(w, e2, "velocity") == false, "e2 no velocity")

    let pos_entities = ecs_query(w, "position")
    assert(len(pos_entities) == 3, "3 with position")

    let vel_entities = ecs_query(w, "velocity")
    assert(len(vel_entities) == 1, "1 with velocity")

    w = ecs_despawn(w, e2)
    assert(ecs_alive(w, e2) == false, "e2 dead")
    assert(ecs_alive(w, e1) == true, "e1 alive")
    assert(ecs_entity_count(w) == 2, "2 alive")

    let pos_after = ecs_query(w, "position")
    assert(len(pos_after) == 2, "2 with position after despawn")

    w = ecs_register_system(w, "movement", "velocity")
    w = ecs_register_system(w, "damage", "health")
    let systems = ecs_list_systems(w)
    assert(len(systems) == 2, "2 systems")
    assert(systems[0] == "movement", "first system")

    print("ECS KAT PASS")
