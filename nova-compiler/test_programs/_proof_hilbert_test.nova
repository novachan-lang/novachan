import std/proof/proof_hilbert

// cki — integer known-answer check.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _proof_hilbert_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb — boolean known-answer check.
fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL _proof_hilbert_test " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

// cks — string known-answer check.
fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL _proof_hilbert_test " + label + ": got=" + got + " want=" + want)
        exit(1)

// ── Inline truth-table tautology oracle (independent of any module) ──────────
// Formula eval using same tagged-list convention.

fn _tt_lookup(name: string, env: list) -> int
    let n = len(env)
    let i = 0
    let result = 0
    while i < n
        let pair = env[i]
        if pair[0] == name
            result = pair[1]
        i = i + 1
    result

fn _tt_eval(f: list, env: list) -> int
    let tag = f[0]
    let result = 0
    if tag == "bot"
        result = 0
    if tag == "top"
        result = 1
    if tag == "var"
        result = _tt_lookup(f[1], env)
    if tag == "not"
        let sv = _tt_eval(f[1], env)
        if sv == 0
            result = 1
    if tag == "and"
        let lv = _tt_eval(f[1], env)
        let rv = _tt_eval(f[2], env)
        if lv == 1
            if rv == 1
                result = 1
    if tag == "or"
        let lv2 = _tt_eval(f[1], env)
        if lv2 == 1
            result = 1
        if lv2 == 0
            let rv2 = _tt_eval(f[2], env)
            if rv2 == 1
                result = 1
    if tag == "imp"
        let lv3 = _tt_eval(f[1], env)
        let rv3 = _tt_eval(f[2], env)
        if lv3 == 0
            result = 1
        if lv3 == 1
            if rv3 == 1
                result = 1
    result

fn _tt_collect_vars(f: list, seen: dict, out: list)
    let tag = f[0]
    if tag == "var"
        let nm = f[1]
        if not contains(seen, nm)
            seen[nm] = 1
            push(out, nm)
    if tag == "not"
        _tt_collect_vars(f[1], seen, out)
    if tag == "and"
        _tt_collect_vars(f[1], seen, out)
        _tt_collect_vars(f[2], seen, out)
    if tag == "or"
        _tt_collect_vars(f[1], seen, out)
        _tt_collect_vars(f[2], seen, out)
    if tag == "imp"
        _tt_collect_vars(f[1], seen, out)
        _tt_collect_vars(f[2], seen, out)

fn tt_is_tautology(f: list) -> int
    let seen = {}
    let vars = []
    _tt_collect_vars(f, seen, vars)
    let nv = len(vars)
    let total = 1
    let k = 0
    while k < nv
        total = total * 2
        k = k + 1
    let all_true = 1
    let i = 0
    while i < total
        let env = []
        let b = 0
        while b < nv
            let pair = []
            push(pair, vars[b])
            push(pair, (i >> b) & 1)
            push(env, pair)
            b = b + 1
        if _tt_eval(f, env) == 0
            all_true = 0
        i = i + 1
    all_true

fn main()
    // === phil_is_axiom ===
    // A1 instance: p->(q->p) (spec KAT)
    let p = phil_var("p")
    let q = phil_var("q")
    let a1_inst = phil_imp(p, phil_imp(q, p))
    ckb("is_axiom_a1_pqp", phil_is_axiom(a1_inst), true)

    // Variable alone is NOT an axiom (spec KAT)
    ckb("is_axiom_var_false", phil_is_axiom(p), false)

    // A1 with compound subformula: (p&q) -> (r -> (p&q))
    let pq = phil_and(p, q)
    let r = phil_var("r")
    let a1_cmpd = phil_imp(pq, phil_imp(r, pq))
    ckb("is_axiom_a1_compound", phil_is_axiom(a1_cmpd), true)

    // A2 instance: (p->(q->r))->((p->q)->(p->r))
    let rv = phil_var("r")
    let a2_inst = phil_imp(phil_imp(p, phil_imp(q, rv)), phil_imp(phil_imp(p, q), phil_imp(p, rv)))
    ckb("is_axiom_a2", phil_is_axiom(a2_inst), true)

    // A3 instance: (~p->~q)->(q->p)
    let a3_inst = phil_imp(phil_imp(phil_not(p), phil_not(q)), phil_imp(q, p))
    ckb("is_axiom_a3", phil_is_axiom(a3_inst), true)

    // imp(p,q) is NOT an axiom (not of form A1/A2/A3)
    ckb("is_axiom_pq_false", phil_is_axiom(phil_imp(p, q)), false)

    // === Standard 5-step Hilbert proof of p->p ===
    // Step 0: p->((p->p)->p)  [A1: A=p, B=(p->p)]
    let pp = phil_imp(p, p)
    let step0_f = phil_imp(p, phil_imp(pp, p))
    let step0 = []
    push(step0, "ax")
    push(step0, step0_f)

    // Step 1: (p->((p->p)->p))->((p->(p->p))->(p->p))  [A2: A=p, B=(p->p), C=p]
    let step1_f = phil_imp(phil_imp(p, phil_imp(pp, p)), phil_imp(phil_imp(p, pp), pp))
    let step1 = []
    push(step1, "ax")
    push(step1, step1_f)

    // Step 2: (p->(p->p))->(p->p)  [MP(0,1): step1 is imp(step0, step2)]
    let step2_f = phil_imp(phil_imp(p, pp), pp)
    let step2 = []
    push(step2, "mp")
    push(step2, 0)
    push(step2, 1)
    push(step2, step2_f)

    // Step 3: p->(p->p)  [A1: A=p, B=p]
    let step3_f = phil_imp(p, pp)
    let step3 = []
    push(step3, "ax")
    push(step3, step3_f)

    // Step 4: p->p  [MP(3,2): step2 is imp(step3, pp)]
    let step4 = []
    push(step4, "mp")
    push(step4, 3)
    push(step4, 2)
    push(step4, pp)

    // Build proof
    let proof_pp = []
    push(proof_pp, step0)
    push(proof_pp, step1)
    push(proof_pp, step2)
    push(proof_pp, step3)
    push(proof_pp, step4)

    // Check proof concludes p->p
    ckb("proof_pp_proves", phil_proves(proof_pp, pp), true)

    // Check result
    let result = phil_check(proof_pp)
    cks("proof_pp_tag", result[0], "imp")

    // === CROSS-CHECK: concluded formula is a tautology (spec: verified with inline truth-table) ===
    let is_taut = tt_is_tautology(result)
    cki("proof_pp_is_tautology", is_taut, 1)

    // Also cross-check A1, A2, A3 schemas are tautologies
    let a1_check = phil_imp(phil_var("A"), phil_imp(phil_var("B"), phil_var("A")))
    cki("a1_is_tautology", tt_is_tautology(a1_check), 1)
    let a2_check = phil_imp(phil_imp(phil_var("A"), phil_imp(phil_var("B"), phil_var("C"))), phil_imp(phil_imp(phil_var("A"), phil_var("B")), phil_imp(phil_var("A"), phil_var("C"))))
    cki("a2_is_tautology", tt_is_tautology(a2_check), 1)
    let a3_check = phil_imp(phil_imp(phil_not(phil_var("A")), phil_not(phil_var("B"))), phil_imp(phil_var("B"), phil_var("A")))
    cki("a3_is_tautology", tt_is_tautology(a3_check), 1)

    // === Bogus proof: MP with wrong antecedent ===
    // Step 0: p (not an axiom — should FAIL)
    let bad0 = []
    push(bad0, "ax")
    push(bad0, p)
    let bad_proof = []
    push(bad_proof, bad0)
    let bad_result = phil_check(bad_proof)
    cks("bogus_not_axiom_tag", bad_result[0], "FAIL")

    // Bogus MP: indices out of range
    let good0_f = phil_imp(p, phil_imp(q, p))
    let good0 = []
    push(good0, "ax")
    push(good0, good0_f)
    let bad_mp = []
    push(bad_mp, "mp")
    push(bad_mp, 5)
    push(bad_mp, 0)
    push(bad_mp, p)
    let bad_proof2 = []
    push(bad_proof2, good0)
    push(bad_proof2, bad_mp)
    let bad_result2 = phil_check(bad_proof2)
    cks("bogus_mp_oob_tag", bad_result2[0], "FAIL")

    // Bogus MP: imp_idx not an imp formula
    // proof: [ax: p->(q->p), mp(0,0, q)] — step 0 is not an imp
    let bad_mp2 = []
    push(bad_mp2, "mp")
    push(bad_mp2, 0)
    push(bad_mp2, 0)
    push(bad_mp2, q)
    let bad_proof3 = []
    push(bad_proof3, good0)
    push(bad_proof3, bad_mp2)
    let bad_result3 = phil_check(bad_proof3)
    cks("bogus_mp_nonadj_tag", bad_result3[0], "FAIL")

    // === phil_step_formula ===
    let ax_step = []
    push(ax_step, "ax")
    push(ax_step, a1_inst)
    let sf = phil_step_formula(ax_step)
    cks("step_formula_ax_tag", sf[0], "imp")

    let mp_step = []
    push(mp_step, "mp")
    push(mp_step, 0)
    push(mp_step, 1)
    push(mp_step, q)
    let sf2 = phil_step_formula(mp_step)
    cks("step_formula_mp_tag", sf2[0], "var")

    // === One more: proof of A1 instance directly (1 step) ===
    let one_step_proof = []
    let s0 = []
    push(s0, "ax")
    push(s0, a1_inst)
    push(one_step_proof, s0)
    ckb("one_step_a1", phil_proves(one_step_proof, a1_inst), true)
    let one_result = phil_check(one_step_proof)
    cki("one_step_result_taut", tt_is_tautology(one_result), 1)

    // === Wrong target: proves p->p but asked for p ===
    ckb("proves_wrong_target", phil_proves(proof_pp, p), false)

    print("PASS _proof_hilbert_test")
