// KAT test for std/collections/avltree
// Inserts 1..7 in ascending order (worst case for an unbalanced BST).
// Verifies: inorder traversal, balanced height, contains, size, delete,
//           min, and max.

import std/collections/avltree

fn main()
    let t = av_new()

    // Insert 1..7 in ascending order — an unbalanced BST would reach height 7.
    av_insert(t, 1)
    av_insert(t, 2)
    av_insert(t, 3)
    av_insert(t, 4)
    av_insert(t, 5)
    av_insert(t, 6)
    av_insert(t, 7)

    // KAT 1: inorder must be [1,2,3,4,5,6,7]
    let ord = av_inorder(t)
    let ok1 = 1
    if len(ord) != 7
        ok1 = 0
    if ok1 == 1
        if ord[0] != 1
            ok1 = 0
    if ok1 == 1
        if ord[1] != 2
            ok1 = 0
    if ok1 == 1
        if ord[2] != 3
            ok1 = 0
    if ok1 == 1
        if ord[3] != 4
            ok1 = 0
    if ok1 == 1
        if ord[4] != 5
            ok1 = 0
    if ok1 == 1
        if ord[5] != 6
            ok1 = 0
    if ok1 == 1
        if ord[6] != 7
            ok1 = 0
    if ok1 == 0
        print("FAIL KAT1: inorder wrong")
        exit(1)

    // KAT 2: height must be <= 3 (AVL guarantee for n=7)
    let h = av_height(t)
    if h > 3
        print("FAIL KAT2: height not balanced, got:")
        print(str(h))
        exit(1)

    // KAT 3: av_contains(t, 5) == true
    if av_contains(t, 5) != 1
        print("FAIL KAT3: contains(5) should be true")
        exit(1)

    // KAT 4: av_contains(t, 8) == false
    if av_contains(t, 8) != 0
        print("FAIL KAT4: contains(8) should be false")
        exit(1)

    // KAT 5: av_size(t) == 7
    if av_size(t) != 7
        print("FAIL KAT5: size should be 7")
        exit(1)

    // KAT 6: delete 4, then check contains(4)==false and inorder==[1,2,3,5,6,7]
    av_delete(t, 4)
    if av_contains(t, 4) != 0
        print("FAIL KAT6a: contains(4) after delete should be false")
        exit(1)
    let ord2 = av_inorder(t)
    let ok6 = 1
    if len(ord2) != 6
        ok6 = 0
    if ok6 == 1
        if ord2[0] != 1
            ok6 = 0
    if ok6 == 1
        if ord2[1] != 2
            ok6 = 0
    if ok6 == 1
        if ord2[2] != 3
            ok6 = 0
    if ok6 == 1
        if ord2[3] != 5
            ok6 = 0
    if ok6 == 1
        if ord2[4] != 6
            ok6 = 0
    if ok6 == 1
        if ord2[5] != 7
            ok6 = 0
    if ok6 == 0
        print("FAIL KAT6b: inorder after delete(4) wrong")
        exit(1)

    // KAT 7: av_min(t) == 1
    if av_min(t) != 1
        print("FAIL KAT7: min should be 1")
        exit(1)

    // KAT 8: av_max(t) == 7
    if av_max(t) != 7
        print("FAIL KAT8: max should be 7")
        exit(1)

    print("_avltree_test passed")
