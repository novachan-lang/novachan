import std/core/getin

// _ck_i — check integer equality.
fn _ck_i(label: string, got: int, want: int)
    if got != want
        print("FAIL getin " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// _ck_s — check string equality.
fn _ck_s(label: string, got: string, want: string)
    if got != want
        print("FAIL getin " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn _bump(v)
    return v + 1

fn main()
    let d = {"a": {"b": [10, 20]}}

    // ---- get_in: nested read (dict -> dict -> list index) ----
    _ck_i("nested_read", get_in(d, ["a", "b", 1], -1), 20)
    _ck_i("nested_read_0", get_in(d, ["a", "b", 0], -1), 10)

    // ---- get_in: missing key -> default ----
    _ck_i("missing_key", get_in(d, ["a", "z"], -1), -1)
    _ck_i("missing_top", get_in(d, ["nope"], -1), -1)
    _ck_i("out_of_range", get_in(d, ["a", "b", 9], -1), -1)

    // ---- get_in_str ----
    let d2 = {"name": "NOVA"}
    _ck_s("get_in_str_hit", get_in_str(d2, ["name"], ""), "NOVA")
    _ck_s("get_in_str_miss", get_in_str(d2, ["missing"], "fallback"), "fallback")

    // ---- has_in: present vs absent ----
    let hin_present = has_in(d, ["a", "b", 1])
    _ck_i("has_in_present", hin_present, 1)
    let hin_absent = has_in(d, ["a", "z"])
    _ck_i("has_in_absent", hin_absent, 0)
    let hin_oor = has_in(d, ["a", "b", 9])
    _ck_i("has_in_out_of_range", hin_oor, 0)

    // ---- put_in: write then re-read the SAME path ----
    let d3 = {"a": {"b": [10, 20]}}
    put_in(d3, ["a", "b", 1], 99)
    _ck_i("put_in_reread", get_in(d3, ["a", "b", 1], -1), 99)
    _ck_i("put_in_sibling_untouched", get_in(d3, ["a", "b", 0], -1), 10)

    // put_in creating a brand-new nested path
    let d4 = {}
    put_in(d4, ["x", "y", "z"], 7)
    _ck_i("put_in_create_nested", get_in(d4, ["x", "y", "z"], -1), 7)

    // ---- update_in: read-modify-write via a fn reference ----
    let d5 = {"a": {"b": [10, 20]}}
    update_in(d5, ["a", "b", 0], _bump)
    _ck_i("update_in_incr", get_in(d5, ["a", "b", 0], -1), 11)
    _ck_i("update_in_sibling_untouched", get_in(d5, ["a", "b", 1], -1), 20)

    print("PASS _getin_test")
