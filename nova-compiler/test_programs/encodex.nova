fn url_safe_base64_encode(data)
  let b64 = base64_encode(data)
  let out = ""
  let i = 0
  while i < len(b64)
    let ch = slice(b64, i, i + 1)
    if ch == "+"
      out = out + "-"
    else if ch == "/"
      out = out + "_"
    else if ch == "="
      i = i + 1
      continue
    else
      out = out + ch
    i = i + 1
  out

fn url_safe_base64_decode(data)
  let out = ""
  let i = 0
  while i < len(data)
    let ch = slice(data, i, i + 1)
    if ch == "-"
      out = out + "+"
    else if ch == "_"
      out = out + "/"
    else
      out = out + ch
    i = i + 1
  let rem = len(out) % 4
  if rem == 2
    out = out + "=="
  else if rem == 3
    out = out + "="
  base64_decode(out)

fn rot_n(text, n)
  let out = ""
  let i = 0
  while i < len(text)
    let cp = code_points(slice(text, i, i + 1))
    let c = cp[0]
    if c >= 65 and c <= 90
      c = 65 + (c - 65 + n) % 26
    else if c >= 97 and c <= 122
      c = 97 + (c - 97 + n) % 26
    out = out + from_codepoint(c)
    i = i + 1
  out

fn run_length_encode(text)
  if len(text) == 0
    return ""
  let out = ""
  let i = 0
  while i < len(text)
    let ch = slice(text, i, i + 1)
    let count = 1
    while i + count < len(text) and slice(text, i + count, i + count + 1) == ch
      count = count + 1
    if count > 1
      out = out + str(count) + ch
    else
      out = out + ch
    i = i + count
  out

fn main()
  let encoded = url_safe_base64_encode("Hello, World!")
  assert(not contains(encoded, "+"), "no +")
  assert(not contains(encoded, "/"), "no /")
  assert(not contains(encoded, "="), "no =")
  let decoded = url_safe_base64_decode(encoded)
  assert(decoded == "Hello, World!", "url-safe b64 round-trip")

  assert(rot_n("abc", 1) == "bcd", "rot1")
  assert(rot_n("xyz", 3) == "abc", "rot3 wrap")
  assert(rot_n(rot_n("Hello", 7), 19) == "Hello", "rot round-trip")

  assert(run_length_encode("aaabbc") == "3a2bc", "rle basic")
  assert(run_length_encode("abcd") == "abcd", "rle no runs")
  assert(run_length_encode("") == "", "rle empty")
  assert(run_length_encode("aaa") == "3a", "rle single run")

  print("encodex: all passed")
