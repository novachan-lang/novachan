// procx.nova — feed input to a subprocess and capture its output, the NOVA way.
//
// The existing exec()/shell() capture a command's stdout but cannot provide its
// stdin. procx closes that gap by feeding stdin via a temp file + shell input
// redirection — portable (works through cmd.exe and /bin/sh) and with NO
// pipe-deadlock risk (no concurrent bidirectional streaming to manage). This is
// the common "pipe data through a filter" pattern (sort, grep, tr, a custom
// tool). Pure-NOVA over write_file / exec / remove_file.

fn proc_run_input(cmd, input)
  let tmp = "_procin.tmp"
  write_file(tmp, input)
  let out = exec(cmd + " < " + tmp)
  remove_file(tmp)
  out

// Like proc_run_input but returns the output split into trimmed, non-empty lines
// (handles CRLF vs LF transparently).
fn proc_lines(cmd, input)
  let out = proc_run_input(cmd, input)
  let raw = split(out, "\n")
  let lines = []
  for ln in raw
    let t = trim(ln)
    if len(t) > 0
      push(lines, t)
  lines

// ── Tests ────────────────────────────────────────────────────────────
// `sort` exists on both Windows and Unix and sorts lowercase ASCII the same.

let sorted = proc_lines("sort", "banana\napple\ncherry\n")
assert(len(sorted) == 3, "3 sorted lines")
assert(sorted[0] == "apple", "first sorted line is apple")
assert(sorted[1] == "banana", "second is banana")
assert(sorted[2] == "cherry", "third is cherry")
print("PASS: feed stdin to `sort`, capture sorted stdout")

// A second run reuses the temp file cleanly (no leftover state).
let sorted2 = proc_lines("sort", "delta\nalpha\ncharlie\nbravo\n")
assert(len(sorted2) == 4, "4 lines")
assert(sorted2[0] == "alpha", "alpha first")
assert(sorted2[3] == "delta", "delta last")
print("PASS: second run, 4 lines")

// raw output still contains the data (capture works).
let raw = proc_run_input("sort", "zebra\nant\n")
assert(contains(raw, "ant"), "output contains ant")
assert(contains(raw, "zebra"), "output contains zebra")
print("PASS: raw capture")

// temp file is cleaned up.
assert(not file_exists("_procin.tmp"), "temp stdin file removed")
print("PASS: temp file cleaned up")

print("ALL PASS: procx — subprocess stdin via redirection")
