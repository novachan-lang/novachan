import std/game/maze_aldous_broder

// ---- structural helpers ----

// Count total edges: sum of all links lengths / 2
fn _edge_count(links)
    let total = len(links)
    let s = 0
    let i = 0
    while i < total
        s = s + len(links[i])
        i = i + 1
    return s / 2

// BFS from cell 0; returns number of reachable cells
fn _bfs_count(links)
    let total = len(links)
    let visited = []
    let k = 0
    while k < total
        push(visited, 0)
        k = k + 1
    // Queue: use a list as a queue with a head index
    let q = []
    push(q, 0)
    visited[0] = 1
    let head = 0
    let count = 1
    while head < len(q)
        let cur = q[head]
        head = head + 1
        let nb = links[cur]
        let nb_len = len(nb)
        let m = 0
        while m < nb_len
            let nxt = nb[m]
            if visited[nxt] == 0
                visited[nxt] = 1
                count = count + 1
                push(q, nxt)
            m = m + 1
    return count

// Check two adjacency lists are identical (same links in same order)
fn _links_equal(a, b)
    let ta = len(a)
    let tb = len(b)
    if ta != tb
        return 0
    let i = 0
    while i < ta
        let ai = a[i]
        let bi = b[i]
        let la = len(ai)
        let lb = len(bi)
        if la != lb
            return 0
        let j = 0
        while j < la
            if ai[j] != bi[j]
                return 0
            j = j + 1
        i = i + 1
    return 1

// ---- assertion helpers ----

fn _assert_int(label, got, want)
    if got != want
        print("FAIL maze_aldous_broder " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn _assert_true(label, val)
    if val == 0
        print("FAIL maze_aldous_broder " + label + ": expected true")
        exit(1)

// ---- KAT cases ----

fn _test_case(w, h, seed, label)
    let total = w * h
    let links = gen(w, h, seed)
    // edge count must equal total - 1 for a perfect maze
    let ec = _edge_count(links)
    _assert_int(label + "_edges", ec, total - 1)
    // all cells must be reachable (connected)
    let rc = _bfs_count(links)
    _assert_int(label + "_connected", rc, total)

fn main()
    // Case 1: 4x4, seed 42 — edge_count==15, connected
    _test_case(4, 4, 42, "4x4_s42")

    // Case 2: 3x3, seed 7 — edge_count==8, connected
    _test_case(3, 3, 7, "3x3_s7")

    // Case 3: 4x3, seed 1 — edge_count==11, connected
    _test_case(4, 3, 1, "4x3_s1")

    // Determinism: gen(4,4,42) twice gives identical links
    let la = gen(4, 4, 42)
    let lb = gen(4, 4, 42)
    let eq = _links_equal(la, lb)
    _assert_true("determinism_4x4_s42", eq)

    // Determinism: gen(3,3,7) twice
    let lc = gen(3, 3, 7)
    let ld = gen(3, 3, 7)
    let eq2 = _links_equal(lc, ld)
    _assert_true("determinism_3x3_s7", eq2)

    print("PASS _maze_aldous_broder_test")
