// KAT for std/term/gradient
// Tests: gradient, rainbow — exact escape string assertions.

import std/term/gradient

// ── helpers ──────────────────────────────────────────────────────────────────

fn _fail(label: str, got: str, want: str)
    print("FAIL gradient " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
    print("  got =" + got)
    print("  want=" + want)
    exit(1)

fn _assert_eq(label: str, got: str, want: str)
    if got == want
        return
    _fail(label, got, want)

// Check that haystack contains needle (returns 1 if found).
fn _contains(haystack: str, needle: str) -> int
    let hlen = len(haystack)
    let nlen = len(needle)
    if nlen == 0
        return 1
    let i = 0
    let found = 0
    while i <= hlen - nlen
        let seg = slice(haystack, i, i + nlen)
        if seg == needle
            found = 1
        i = i + 1
    found

// Count non-overlapping occurrences of needle in haystack.
fn _count_occ(haystack: str, needle: str) -> int
    let hlen = len(haystack)
    let nlen = len(needle)
    if nlen == 0
        return 0
    let i = 0
    let count = 0
    while i <= hlen - nlen
        let seg = slice(haystack, i, i + nlen)
        if seg == needle
            count = count + 1
            i = i + nlen
        if seg != needle
            i = i + 1
    count

fn main()
    let esc = chr(27)
    let reset = esc + "[0m"
    let fg_prefix = esc + "[38;2;"

    // ── KAT 1: gradient("ab", 0,0,0, 255,255,255) ────────────────────────────
    // n=2: step=0 => lerp(0,255,0,2)=0; step=1 => lerp(0,255,1,2)=127
    // Expected: ESC[38;2;0;0;0m + "a" + ESC[38;2;127;127;127m + "b" + ESC[0m
    let g_ab = gradient("ab", 0, 0, 0, 255, 255, 255)

    // Starts with start-colour sequence
    let want_start_black = esc + "[38;2;0;0;0m"
    let got_prefix_ab = slice(g_ab, 0, len(want_start_black))
    _assert_eq("gradient-ab-prefix", got_prefix_ab, want_start_black)

    // 'a' immediately follows
    let a_pos = len(want_start_black)
    let got_a = slice(g_ab, a_pos, a_pos + 1)
    _assert_eq("gradient-ab-char-a", got_a, "a")

    // Ends with reset (ESC[0m = 4 bytes)
    let gablen = len(g_ab)
    let got_ab_reset = slice(g_ab, gablen - 4, gablen)
    _assert_eq("gradient-ab-reset", got_ab_reset, reset)

    // Exactly 2 truecolor fg sequences
    let cnt_ab = _count_occ(g_ab, fg_prefix)
    if cnt_ab != 2
        print("FAIL gradient gradient-ab-count: got " + str(cnt_ab) + " want 2")
        exit(1)

    // ── KAT 2: empty text returns "" ─────────────────────────────────────────
    let g_empty = gradient("", 0, 0, 0, 255, 255, 255)
    _assert_eq("gradient-empty", g_empty, "")

    // ── KAT 3: single character uses start colour ─────────────────────────────
    let g_x = gradient("x", 10, 20, 30, 200, 200, 200)
    let want_x = esc + "[38;2;10;20;30m" + "x" + reset
    _assert_eq("gradient-single-char", g_x, want_x)

    // ── KAT 4: 3 chars — 3 fg sequences, correct start and end ───────────────
    // n=3: step=0 =>0, step=1 =>127, step=2 =>255  (lerp denom=2)
    let g_abc = gradient("abc", 0, 0, 0, 255, 255, 255)
    let cnt_abc = _count_occ(g_abc, fg_prefix)
    if cnt_abc != 3
        print("FAIL gradient gradient-abc-count: got " + str(cnt_abc) + " want 3")
        exit(1)
    // First sequence = black
    let got_abc_s0 = slice(g_abc, 0, len(want_start_black))
    _assert_eq("gradient-abc-s0", got_abc_s0, want_start_black)
    // Contains end-colour white
    let want_white = esc + "[38;2;255;255;255m"
    let has_white = _contains(g_abc, want_white)
    if has_white != 1
        print("FAIL gradient gradient-abc-white: not found")
        exit(1)

    // ── KAT 5: rainbow empty ──────────────────────────────────────────────────
    let r_empty = rainbow("")
    _assert_eq("rainbow-empty", r_empty, "")

    // ── KAT 6: rainbow single char — hue=0 => pure red ────────────────────────
    let r_one = rainbow("Z")
    let want_r_one = esc + "[38;2;255;0;0m" + "Z" + reset
    _assert_eq("rainbow-single", r_one, want_r_one)

    // ── KAT 7: rainbow("abc") — 3 fg sequences + reset ───────────────────────
    let r_abc = rainbow("abc")
    let cnt_rabc = _count_occ(r_abc, fg_prefix)
    if cnt_rabc != 3
        print("FAIL gradient rainbow-abc-count: got " + str(cnt_rabc) + " want 3")
        exit(1)
    let rabclen = len(r_abc)
    let got_rabc_reset = slice(r_abc, rabclen - 4, rabclen)
    _assert_eq("rainbow-abc-reset", got_rabc_reset, reset)
    // First char: hue=0 => red = ESC[38;2;255;0;0m
    let want_red = esc + "[38;2;255;0;0m"
    let got_r_start = slice(r_abc, 0, len(want_red))
    _assert_eq("rainbow-abc-start-red", got_r_start, want_red)

    // ── KAT 8: gradient clamped out-of-range channels ────────────────────────
    // start (-10,300,128) clamped => (0,255,128); end (256,-5,200) clamped => (255,0,200)
    // single char => uses start colour
    let g_clamp = gradient("a", -10, 300, 128, 256, -5, 200)
    let want_clamp = esc + "[38;2;0;255;128m" + "a" + reset
    _assert_eq("gradient-clamp", g_clamp, want_clamp)

    // ── KAT 9: gradient 4 chars — lerp steps ─────────────────────────────────
    // n=4: step=0 =>0, step=1 =>85, step=2 =>170, step=3 =>255
    let g4 = gradient("abcd", 0, 0, 0, 255, 255, 255)
    let cnt_g4 = _count_occ(g4, fg_prefix)
    if cnt_g4 != 4
        print("FAIL gradient gradient-4-count: got " + str(cnt_g4) + " want 4")
        exit(1)
    let want_g4_s1 = esc + "[38;2;85;85;85m"
    let has_s1 = _contains(g4, want_g4_s1)
    if has_s1 != 1
        print("FAIL gradient gradient-4-step1: missing " + want_g4_s1)
        exit(1)
    let want_g4_s2 = esc + "[38;2;170;170;170m"
    let has_s2 = _contains(g4, want_g4_s2)
    if has_s2 != 1
        print("FAIL gradient gradient-4-step2: missing " + want_g4_s2)
        exit(1)

    // ── KAT 10: constant colour gradient (start==end) ─────────────────────────
    let g_const = gradient("hi", 100, 150, 200, 100, 150, 200)
    let want_c1 = esc + "[38;2;100;150;200m"
    let got_c1 = slice(g_const, 0, len(want_c1))
    _assert_eq("gradient-const-start", got_c1, want_c1)
    let cnt_const = _count_occ(g_const, want_c1)
    if cnt_const != 2
        print("FAIL gradient gradient-const-count: got " + str(cnt_const) + " want 2")
        exit(1)

    print("PASS _term_gradient_test")
