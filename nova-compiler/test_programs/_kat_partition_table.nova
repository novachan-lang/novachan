import forge_partition_table

fn main()
    let p = pt_new(4)
    assert(pt_partition_count(p) == 4, "4 partitions")
    assert(pt_assigned_count(p) == 0, "0 assigned initially")
    assert(pt_is_assigned(p, 0) == 0, "0 not assigned yet")

    let a0 = pt_assign(p, 0, "A")
    assert(is_ok(a0), "assign 0 ok")
    let a1 = pt_assign(p, 1, "A")
    assert(is_ok(a1), "assign 1 ok")
    let a2 = pt_assign(p, 2, "B")
    assert(is_ok(a2), "assign 2 ok")
    let a3 = pt_assign(p, 3, "B")
    assert(is_ok(a3), "assign 3 ok")

    assert(pt_assigned_count(p) == 4, "4 assigned")
    assert(pt_is_assigned(p, 0) == 1, "0 assigned")
    assert(pt_node_partitions(p, "A") == 2, "A has 2")
    assert(pt_node_partitions(p, "B") == 2, "B has 2")

    let l0 = pt_lookup(p, 0)
    assert(is_ok(l0), "lookup 0 ok")
    assert(unwrap(l0) == "A", "0 owned by A")

    let bad_assign = pt_assign(p, 99, "C")
    assert(is_err(bad_assign), "assign out of range")

    let bad_lookup = pt_lookup(p, 99)
    assert(is_err(bad_lookup), "lookup out of range")

    // reassign partition 0 from A to C -- A drops to 1, C gains 1
    let re0 = pt_assign(p, 0, "C")
    assert(is_ok(re0), "reassign 0 to C ok")
    assert(pt_node_partitions(p, "A") == 1, "A now has 1")
    assert(pt_node_partitions(p, "C") == 1, "C now has 1")
    assert(pt_assigned_count(p) == 4, "still 4 assigned total")

    // rebalance B away: B's 2 partitions move to least-loaded of {A(1), C(1)}
    let rb = pt_rebalance(p, "B")
    assert(is_ok(rb), "rebalance ok")
    assert(unwrap(rb) == 2, "2 partitions moved")
    assert(pt_node_partitions(p, "B") == 0, "B now has 0")
    assert(pt_assigned_count(p) == 4, "still 4 assigned total after rebalance")

    let l2 = pt_lookup(p, 2)
    assert(is_ok(l2), "lookup 2 ok")
    assert(unwrap(l2) != "B", "2 no longer owned by B")

    let rb_unknown = pt_rebalance(p, "Z")
    assert(is_err(rb_unknown), "rebalance unknown node fails")

    // single-node scenario: no other node to rebalance to
    let p2 = pt_new(2)
    p2 = unwrap(pt_assign(p2, 0, "X"))
    p2 = unwrap(pt_assign(p2, 1, "X"))
    let rb2 = pt_rebalance(p2, "X")
    assert(is_err(rb2), "no target node available")

    print("PARTITION-TABLE KAT PASS")
