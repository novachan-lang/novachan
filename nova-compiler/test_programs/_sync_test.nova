// KAT for std/sync — mutex + semaphore (channel-token locks). Tier-1 semantics (deterministic, any N).
// Tier-2 mutual-exclusion (8 tasks x 1000 @ NOVA_CARRIERS=4 -> 8000, no lost updates) was verified live
// across 5 runs by the build workflow; this permanent test locks the API semantics.
import std/sync/mutex
import std/sync/semaphore

fn main()
    // mutex: fresh -> acquirable; held -> not; released -> acquirable again
    let m = mutex_new()
    if try_lock(m) != 1
        print("FAIL fresh try_lock")
        exit(1)
    if try_lock(m) != 0
        print("FAIL held try_lock (should be 0)")
        exit(1)
    unlock(m)
    if try_lock(m) != 1
        print("FAIL released try_lock")
        exit(1)
    unlock(m)

    // semaphore(2): two permits, then exhausted, then one back
    let s = sem_new(2)
    if sem_try_acquire(s) != 1
        print("FAIL sem acquire 1")
        exit(1)
    if sem_try_acquire(s) != 1
        print("FAIL sem acquire 2")
        exit(1)
    if sem_try_acquire(s) != 0
        print("FAIL sem acquire 3 (should be 0, exhausted)")
        exit(1)
    sem_release(s)
    if sem_try_acquire(s) != 1
        print("FAIL sem acquire 4 (after release)")
        exit(1)

    // sem_new(0) clamps to 1 permit (NOT an unbounded channel)
    let z = sem_new(0)
    if sem_try_acquire(z) != 1
        print("FAIL sem_new(0) clamp: first acquire")
        exit(1)
    if sem_try_acquire(z) != 0
        print("FAIL sem_new(0) clamp: should be bounded at 1")
        exit(1)

    print("_sync_test passed (mutex + semaphore tier-1 + sem_new clamp)")
