// Dependency check: does json_decode parse floats correctly? (AI service needs this.)
fn main()
    let arr = json_decode("[1.5, 2.5, 3.25]")
    assert_eq(len(arr), 3)
    assert_near(arr[0], 1.5, 0.001)
    assert_near(arr[1], 2.5, 0.001)
    assert_near(arr[2], 3.25, 0.001)
    let obj = json_decode("\{\"x\": 1.5, \"y\": 2.0\}")
    assert_near(obj["x"], 1.5, 0.001)
    assert_near(obj["y"], 2.0, 0.001)
    print("json float decode test passed")
