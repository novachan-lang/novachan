import std/gametheory/wythoff

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _wythoff_test " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gs = "false"
    if got
        gs = "true"
    let ws = "false"
    if want
        ws = "true"
    if got != want
        print("FAIL _wythoff_test " + label + ": got " + gs + " want " + ws)
        exit(1)

fn ckl(label: string, got: list, want: list)
    let n = len(want)
    if len(got) != n
        print("FAIL _wythoff_test " + label + ": len got " + str(len(got)) + " want " + str(n))
        exit(1)
    let i = 0
    while i < n
        if got[i] != want[i]
            print("FAIL _wythoff_test " + label + "[" + str(i) + "]: got " + str(got[i]) + " want " + str(want[i]))
            exit(1)
        i = i + 1

fn mk2(a: int, b: int) -> list
    let xs = []
    push(xs, a)
    push(xs, b)
    xs

fn main()
    // wy_nth_p_position(0) = [0,0]
    ckl("nth_0", wy_nth_p_position(0), mk2(0, 0))

    // wy_nth_p_position(1) = [1,2]
    ckl("nth_1", wy_nth_p_position(1), mk2(1, 2))

    // wy_nth_p_position(2) = [3,5]
    ckl("nth_2", wy_nth_p_position(2), mk2(3, 5))

    // wy_nth_p_position(3) = [4,7]
    ckl("nth_3", wy_nth_p_position(3), mk2(4, 7))

    // wy_is_losing(1,2) = true
    ckb("losing_1_2", wy_is_losing(1, 2), true)

    // wy_is_losing(2,1) = true  (symmetric)
    ckb("losing_2_1", wy_is_losing(2, 1), true)

    // wy_is_losing(3,5) = true
    ckb("losing_3_5", wy_is_losing(3, 5), true)

    // wy_is_losing(1,3) = false
    ckb("not_losing_1_3", wy_is_losing(1, 3), false)

    // wy_is_losing(0,0) = true
    ckb("losing_0_0", wy_is_losing(0, 0), true)

    // wy_p_positions(4) should return [[0,0],[1,2],[3,5],[4,7]]
    let ps = wy_p_positions(4)
    cki("p_positions_len", len(ps), 4)
    ckl("p_positions_0", ps[0], mk2(0, 0))
    ckl("p_positions_1", ps[1], mk2(1, 2))
    ckl("p_positions_2", ps[2], mk2(3, 5))
    ckl("p_positions_3", ps[3], mk2(4, 7))

    // Known non-P-positions
    ckb("not_losing_2_3", wy_is_losing(2, 3), false)
    ckb("not_losing_5_5", wy_is_losing(5, 5), false)

    print("PASS _wythoff_test")
