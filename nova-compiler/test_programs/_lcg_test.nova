// KAT test for std/random/lcg
// Tests MINSTD (Park-Miller) and glibc LCG variants.
//
// MINSTD anchor (Park-Miller reference from seed=1):
//   step 1: 16807
//   step 2: 282475249
//   step 3: 1622650073
//
// glibc anchor (seed=1, raw 32-bit state):
//   step 1: 1103527590
//   step 2: 2524885223
//   step 3: 662824084

import std/random/lcg

fn main()
    // ── KAT 1: MINSTD anchor vector, step 1 ───────────────────────────────
    let r1 = minstd_seed(1)
    let v1 = minstd_next(r1)
    if v1 != 16807
        print("FAIL lcg KAT1: minstd step1 got " + str(v1) + " want 16807")
        exit(1)

    // ── KAT 2: MINSTD anchor vector, step 2 ───────────────────────────────
    let v2 = minstd_next(r1)
    if v2 != 282475249
        print("FAIL lcg KAT2: minstd step2 got " + str(v2) + " want 282475249")
        exit(1)

    // ── KAT 3: MINSTD anchor vector, step 3 ───────────────────────────────
    let v3 = minstd_next(r1)
    if v3 != 1622650073
        print("FAIL lcg KAT3: minstd step3 got " + str(v3) + " want 1622650073")
        exit(1)

    // ── KAT 4: MINSTD output always in [1, 2147483646] ────────────────────
    let rm = minstd_seed(42)
    let i = 0
    while i < 200
        let vv = minstd_next(rm)
        if vv < 1
            print("FAIL lcg KAT4a: minstd output < 1 at step " + str(i) + ": " + str(vv))
            exit(1)
        if vv > 2147483646
            print("FAIL lcg KAT4b: minstd output > 2147483646 at step " + str(i) + ": " + str(vv))
            exit(1)
        i = i + 1

    // ── KAT 5: MINSTD determinism ─────────────────────────────────────────
    let ra = minstd_seed(7)
    let ra1 = minstd_next(ra)
    let ra2 = minstd_next(ra)
    let rb = minstd_seed(7)
    let rb1 = minstd_next(rb)
    let rb2 = minstd_next(rb)
    if ra1 != rb1
        print("FAIL lcg KAT5a: minstd determinism step1: " + str(ra1) + " vs " + str(rb1))
        exit(1)
    if ra2 != rb2
        print("FAIL lcg KAT5b: minstd determinism step2: " + str(ra2) + " vs " + str(rb2))
        exit(1)

    // ── KAT 6: glibc anchor vector, step 1 ────────────────────────────────
    let g1 = glibc_seed(1)
    let g1v = glibc_next(g1)
    if g1v != 1103527590
        print("FAIL lcg KAT6: glibc step1 got " + str(g1v) + " want 1103527590")
        exit(1)

    // ── KAT 7: glibc anchor vector, step 2 ────────────────────────────────
    let g2v = glibc_next(g1)
    if g2v != 2524885223
        print("FAIL lcg KAT7: glibc step2 got " + str(g2v) + " want 2524885223")
        exit(1)

    // ── KAT 8: glibc anchor vector, step 3 ────────────────────────────────
    let g3v = glibc_next(g1)
    if g3v != 662824084
        print("FAIL lcg KAT8: glibc step3 got " + str(g3v) + " want 662824084")
        exit(1)

    // ── KAT 9: glibc output always in [0, 4294967295] ─────────────────────
    let gm = glibc_seed(99)
    let j = 0
    while j < 200
        let gv = glibc_next(gm)
        if gv < 0
            print("FAIL lcg KAT9a: glibc output < 0 at step " + str(j) + ": " + str(gv))
            exit(1)
        if gv > 4294967295
            print("FAIL lcg KAT9b: glibc output > 2^32-1 at step " + str(j) + ": " + str(gv))
            exit(1)
        j = j + 1

    // ── KAT 10: glibc determinism ─────────────────────────────────────────
    let ga = glibc_seed(13)
    let ga1 = glibc_next(ga)
    let ga2 = glibc_next(ga)
    let gb = glibc_seed(13)
    let gb1 = glibc_next(gb)
    let gb2 = glibc_next(gb)
    if ga1 != gb1
        print("FAIL lcg KAT10a: glibc determinism step1: " + str(ga1) + " vs " + str(gb1))
        exit(1)
    if ga2 != gb2
        print("FAIL lcg KAT10b: glibc determinism step2: " + str(ga2) + " vs " + str(gb2))
        exit(1)

    // ── KAT 11: lcg_next_range on MINSTD stays in [0, n-1] ───────────────
    let rr = minstd_seed(5)
    let k = 0
    while k < 500
        let rv = lcg_next_range(rr, 10)
        if rv < 0
            print("FAIL lcg KAT11a: lcg_next_range(minstd) < 0 at step " + str(k) + ": " + str(rv))
            exit(1)
        if rv > 9
            print("FAIL lcg KAT11b: lcg_next_range(minstd) > 9 at step " + str(k) + ": " + str(rv))
            exit(1)
        k = k + 1

    // ── KAT 12: lcg_next_range on glibc stays in [0, n-1] ────────────────
    let gr = glibc_seed(5)
    let m = 0
    while m < 500
        let gvr = lcg_next_range(gr, 7)
        if gvr < 0
            print("FAIL lcg KAT12a: lcg_next_range(glibc) < 0 at step " + str(m) + ": " + str(gvr))
            exit(1)
        if gvr > 6
            print("FAIL lcg KAT12b: lcg_next_range(glibc) > 6 at step " + str(m) + ": " + str(gvr))
            exit(1)
        m = m + 1

    // ── KAT 13: lcg_next_range concrete anchor (MINSTD seed 1, n=100) ────
    // minstd_next(minstd_seed(1)) = 16807; 16807 % 100 = 7
    let rc = minstd_seed(1)
    let rc1 = lcg_next_range(rc, 100)
    if rc1 != 7
        print("FAIL lcg KAT13: lcg_next_range(minstd_seed(1),100) got " + str(rc1) + " want 7")
        exit(1)

    // ── KAT 14: minstd_seed(0) treated as seed=1 ──────────────────────────
    let r0 = minstd_seed(0)
    let r0v = minstd_next(r0)
    if r0v != 16807
        print("FAIL lcg KAT14: minstd_seed(0) should behave as seed=1, got " + str(r0v))
        exit(1)

    // ── KAT 15: different seeds produce different outputs ─────────────────
    let rxA = minstd_seed(1)
    let rxB = minstd_seed(2)
    let rxAv = minstd_next(rxA)
    let rxBv = minstd_next(rxB)
    if rxAv == rxBv
        print("FAIL lcg KAT15: minstd_seed(1) and minstd_seed(2) produced same output: " + str(rxAv))
        exit(1)

    print("PASS _lcg_test")
