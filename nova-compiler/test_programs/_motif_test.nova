// _motif_test.nova — KAT for std/bio/motif
//
// Known-answer vectors:
//   motif_find_exact('ATGATGATG','ATG') == [0,3,6]
//   motif_count('AAAA','AA') == 3  (overlapping)
//   iupac_match('A','R') == true  (R=A/G)
//   iupac_match('C','R') == false
//   iupac_match('T','N') == true
//   motif_consensus(['ATG','ATG','ACG']) == 'ATG'
//   motif_find_iupac('AAGTT','ARG') -> [0] (A,A matches A,R; G matches G)

import std/bio/motif

fn ck_int(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)
    return 0

fn ck_str(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)
    return 0

fn ck_bool(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)
    return 0

fn approx(label, a, b, tol)
    let d = a - b
    let ad = d
    if d < 0.0
        ad = 0.0 - d
    if ad > tol
        print("FAIL " + label + ": got=" + str(a) + " want~" + str(b))
        exit(1)
    return 0

fn main()
    // KAT 1: exact positions [0,3,6]
    let pos1 = motif_find_exact("ATGATGATG", "ATG")
    ck_int("exact_len", len(pos1), 3)
    ck_int("exact_0", pos1[0], 0)
    ck_int("exact_1", pos1[1], 3)
    ck_int("exact_2", pos1[2], 6)

    // KAT 2: overlapping count in AAAA for AA = 3
    let cnt = motif_count("AAAA", "AA")
    ck_int("motif_count_AAAA_AA", cnt, 3)

    // KAT 3: iupac_match A,R = true
    let r1 = iupac_match("A", "R")
    ck_bool("iupac_A_R", r1, true)

    // KAT 4: iupac_match C,R = false
    let r2 = iupac_match("C", "R")
    ck_bool("iupac_C_R", r2, false)

    // KAT 5: iupac_match T,N = true (N matches all)
    let r3 = iupac_match("T", "N")
    ck_bool("iupac_T_N", r3, true)

    // KAT 6: iupac_match G,R = true (R = A or G)
    let r4 = iupac_match("G", "R")
    ck_bool("iupac_G_R", r4, true)

    // KAT 7: iupac_match A,Y = false (Y = C or T)
    let r5 = iupac_match("A", "Y")
    ck_bool("iupac_A_Y", r5, false)

    // KAT 8: motif_consensus(['ATG','ATG','ACG']) = 'ATG'
    // col0: A,A,A -> A; col1: T,T,C -> T; col2: G,G,G -> G
    let seqs = []
    push(seqs, "ATG")
    push(seqs, "ATG")
    push(seqs, "ACG")
    let cons = motif_consensus(seqs)
    ck_str("consensus_ATG", cons, "ATG")

    // KAT 9: motif_find_iupac('AAGTT','ARG') -> [0]
    // Pattern ARG: pos0 A matches A; pos1 A matches R(A/G); pos2 G matches G -> match at 0
    // pos1: A,G,T -> R matches G at col1, T!=G -> no
    let ipos = motif_find_iupac("AAGTT", "ARG")
    ck_int("iupac_find_len", len(ipos), 1)
    ck_int("iupac_find_0", ipos[0], 0)

    // KAT 10: reverse complement of 'ATCG' = 'CGAT'
    let rc1 = motif_reverse_complement("ATCG")
    ck_str("revcomp_ATCG", rc1, "CGAT")

    // KAT 11: reverse complement involution: rc(rc(s)) == s
    let rc2 = motif_reverse_complement(rc1)
    ck_str("revcomp_invol", rc2, "ATCG")

    // KAT 12: GC content of 'GCGC' = 1.0
    let gc1 = motif_gc("GCGC")
    approx("gc_GCGC", gc1, 1.0, 0.001)

    // KAT 13: GC content of 'ATAT' = 0.0
    let gc2 = motif_gc("ATAT")
    approx("gc_ATAT", gc2, 0.0, 0.001)

    // KAT 14: GC content of 'GCTA' = 0.5
    let gc3 = motif_gc("GCTA")
    approx("gc_GCTA", gc3, 0.5, 0.001)

    // KAT 15: motif_count with no occurrences = 0
    let cnt2 = motif_count("AAAA", "TTT")
    ck_int("motif_count_none", cnt2, 0)

    // KAT 16: motif_find_exact empty motif = []
    let pos2 = motif_find_exact("ACGT", "")
    ck_int("exact_empty_motif", len(pos2), 0)

    // KAT 17: iupac W = A or T
    let r6 = iupac_match("A", "W")
    ck_bool("iupac_A_W", r6, true)
    let r7 = iupac_match("T", "W")
    ck_bool("iupac_T_W", r7, true)
    let r8 = iupac_match("G", "W")
    ck_bool("iupac_G_W", r8, false)

    // KAT 18: iupac S = C or G
    let r9 = iupac_match("C", "S")
    ck_bool("iupac_C_S", r9, true)
    let r10 = iupac_match("A", "S")
    ck_bool("iupac_A_S", r10, false)

    // KAT 19: pwm_counts structure for ['AT','AT']
    let seqs2 = []
    push(seqs2, "AT")
    push(seqs2, "AT")
    let pwm = motif_pwm_counts(seqs2)
    ck_int("pwm_cols", len(pwm), 2)
    let col0 = pwm[0]
    let ca = col0["A"]
    ck_int("pwm_col0_A", ca, 2)

    // KAT 20: information content for perfectly conserved motif
    // ['AA','AA'] -> each col has p(A)=1.0 -> entropy=0 -> IC=2 per col -> total=4
    let seqs3 = []
    push(seqs3, "AA")
    push(seqs3, "AA")
    let ic = motif_information(seqs3)
    approx("info_conserved", ic, 4.0, 0.01)

    print("PASS _motif_test")
