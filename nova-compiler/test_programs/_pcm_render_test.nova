// KAT test for std/audio/pcm_render.nova
//
// Hand-computed reference values:
//   float_to_pcm16(1.0)  = 32767   (max positive, clamp at 1.0 then *32767 + 0.5 round = 32767)
//   float_to_pcm16(0.0)  = 0
//   float_to_pcm16(-1.0) = -32768  (full negative, -1.0 * 32768 - 0.5 = -32768.5 -> int = -32768)
//   float_to_pcm16(2.0)  = 32767   (clamped)
//   float_to_pcm16(-2.0) = -32768  (clamped)
//   pcm16_to_float(-32768) = -1.0  (-32768 / 32768.0)
//   pcm16_to_float(0)      = 0.0
//   render_sine(440.0, 0.01, 44100.0): len ~= 441 samples; all in [-32768, 32767]

import std/audio/pcm_render

fn approx(a: float, b: float, tol: float) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < tol
        return 1
    return 0

fn ckf(label: string, got: float, want: float)
    let ok = approx(got, want, 0.001)
    if ok == 0
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // ── KAT 1: float_to_pcm16(1.0) == 32767 ─────────────────────────────────
    let r1 = float_to_pcm16(1.0)
    cki("pcm16_pos1", r1, 32767)

    // ── KAT 2: float_to_pcm16(0.0) == 0 ─────────────────────────────────────
    let r2 = float_to_pcm16(0.0)
    cki("pcm16_zero", r2, 0)

    // ── KAT 3: float_to_pcm16(-1.0) == -32768 ────────────────────────────────
    let r3 = float_to_pcm16(0.0 - 1.0)
    cki("pcm16_neg1", r3, 0 - 32768)

    // ── KAT 4: float_to_pcm16(2.0) == 32767 (clamped) ───────────────────────
    let r4 = float_to_pcm16(2.0)
    cki("pcm16_clamp_pos", r4, 32767)

    // ── KAT 5: float_to_pcm16(-2.0) == -32768 (clamped) ─────────────────────
    let r5 = float_to_pcm16(0.0 - 2.0)
    cki("pcm16_clamp_neg", r5, 0 - 32768)

    // ── KAT 6: pcm16_to_float(-32768) == -1.0 ────────────────────────────────
    let r6 = pcm16_to_float(0 - 32768)
    ckf("float_neg1", r6, 0.0 - 1.0)

    // ── KAT 7: pcm16_to_float(0) == 0.0 ─────────────────────────────────────
    let r7 = pcm16_to_float(0)
    ckf("float_zero", r7, 0.0)

    // ── KAT 8: pcm16_to_float(32767) ~= 1.0 (within 0.001) ──────────────────
    let r8 = pcm16_to_float(32767)
    ckf("float_pos1_approx", r8, 1.0)

    // ── KAT 9: render_sine length == ~441 samples for 440Hz, 0.01s, 44100Hz ──
    // floor(0.01 * 44100) = floor(441.0) = 441
    let rs = render_sine(440.0, 0.01, 44100.0)
    let rs_len = len(rs)
    // Accept 440 or 441 (float precision of 0.01*44100)
    if rs_len < 440
        print("FAIL render_sine_len_low: got " + str(rs_len) + " want >=440")
        exit(1)
    if rs_len > 442
        print("FAIL render_sine_len_high: got " + str(rs_len) + " want <=442")
        exit(1)

    // ── KAT 10: all render_sine samples in [-32768, 32767] ───────────────────
    let n = len(rs)
    let i = 0
    while i < n
        let v = rs[i]
        if v < 0 - 32768
            print("FAIL render_sine_range_low[" + str(i) + "]: " + str(v))
            exit(1)
        if v > 32767
            print("FAIL render_sine_range_high[" + str(i) + "]: " + str(v))
            exit(1)
        i = i + 1

    // ── KAT 11: first sample of sine at 0 phase == 0 (sin(0)=0 -> pcm 0) ────
    let first_pcm = rs[0]
    cki("render_sine_first_zero", first_pcm, 0)

    // ── KAT 12: round-trip: float_to_pcm16 then pcm16_to_float is close ──────
    // 0.5 -> pcm ~16383 or 16384 -> float ~= 0.5 (within 0.001)
    let enc = float_to_pcm16(0.5)
    let dec = pcm16_to_float(enc)
    ckf("roundtrip_0.5", dec, 0.5)

    // ── KAT 13: float_to_pcm16(0.5) is in range [16383,16384] ───────────────
    if enc < 16383
        print("FAIL pcm16_half_low: got " + str(enc))
        exit(1)
    if enc > 16384
        print("FAIL pcm16_half_high: got " + str(enc))
        exit(1)

    print("PASS _pcm_render_test")
