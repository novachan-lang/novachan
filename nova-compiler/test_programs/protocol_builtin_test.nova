fn int.double(self)
    self * 2

fn int.abs(self)
    if self < 0
        return 0 - self
    self

fn int.is_even(self)
    self % 2 == 0

fn float.floor_int(self)
    int(self)

fn string.shout(self)
    upper(self) + "!"

fn string.word_count(self)
    let parts = split(self, " ")
    len(parts)

fn list.first(self)
    self[0]

fn list.last_elem(self)
    self[len(self) - 1]

fn bool.to_yn(self)
    if self
        return "yes"
    "no"

fn test_int_protocol()
    let x = 42
    assert(x.double() == 84, "int.double: " + str(x.double()))
    assert(x.is_even(), "int.is_even")
    let neg = 0 - 7
    assert(neg.abs() == 7, "int.abs negative")
    assert(x.abs() == 42, "int.abs positive")
    print("  int protocol: PASS")

fn test_int_literal()
    assert(42.double() == 84, "literal 42.double")
    assert(10.is_even(), "literal 10.is_even")
    print("  int literal call: PASS")

fn test_float_protocol()
    let f = 3.7
    assert(f.floor_int() == 3, "float.floor_int: " + str(f.floor_int()))
    print("  float protocol: PASS")

fn test_string_protocol()
    let s = "hello world"
    assert(s.shout() == "HELLO WORLD!", "string.shout: " + s.shout())
    assert(s.word_count() == 2, "string.word_count: " + str(s.word_count()))
    let s2 = "one two three four"
    assert(s2.word_count() == 4, "word_count 4")
    print("  string protocol: PASS")

fn test_string_literal()
    assert("hi".shout() == "HI!", "literal string.shout")
    print("  string literal call: PASS")

fn test_list_protocol()
    let xs = [10, 20, 30]
    assert(xs.first() == 10, "list.first: " + str(xs.first()))
    assert(xs.last_elem() == 30, "list.last_elem")
    print("  list protocol: PASS")

fn test_bool_protocol()
    let t = true
    let f = false
    assert(t.to_yn() == "yes", "bool.to_yn true")
    assert(f.to_yn() == "no", "bool.to_yn false")
    print("  bool protocol: PASS")

fn test_chaining()
    let x = 5
    assert(x.double().double() == 20, "chain double.double")
    print("  chaining: PASS")

fn main()
    test_int_protocol()
    test_int_literal()
    test_float_protocol()
    test_string_protocol()
    test_string_literal()
    test_list_protocol()
    test_bool_protocol()
    test_chaining()
    print("protocol_builtin_test: all passed")
