// KAT for std/time/cron — cron expression parser, matcher, next-fire
// calculator, and describer.
import std/time/cron
import std/time/calendar

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

// ── Independent brute-force reference for cron_next (steps minute-by-minute,
// using ONLY cron_matches + calendar — never touches cron_next's internals). ─

fn _kat_advance_minute(y: int, m: int, d: int, h: int, mi: int) -> list
    let nmi = mi + 1
    let nh = h
    let nd = d
    let nm = m
    let ny = y
    if nmi >= 60
        nmi = 0
        nh = h + 1
        if nh >= 24
            nh = 0
            let dim = cal_days_in_month(y, m)
            if d < dim
                nd = d + 1
            else
                nd = 1
                nm = m + 1
                if nm > 12
                    nm = 1
                    ny = y + 1
    [ny, nm, nd, nh, nmi]

fn _kat_brute_next(parsed, y: int, m: int, d: int, h: int, mi: int, max_steps: int) -> list
    let cy = y
    let cm = m
    let cd = d
    let ch = h
    let cmi = mi
    let steps = 0
    while steps < max_steps
        let nxt = _kat_advance_minute(cy, cm, cd, ch, cmi)
        cy = nxt[0]
        cm = nxt[1]
        cd = nxt[2]
        ch = nxt[3]
        cmi = nxt[4]
        let dow = cal_weekday(cy, cm, cd)
        if cron_matches(parsed, cmi, ch, cd, cm, dow)
            return [1, cy, cm, cd, ch, cmi]
        steps = steps + 1
    [0, 0, 0, 0, 0, 0]

fn main()
    // ── cron_parse / cron_matches: "*/5 * * * *" ────────────────────────────
    let p1 = cron_parse("*/5 * * * *")
    cki("p1-min-count", len(p1["minute"]), 12)
    cki("p1-min-first", p1["minute"][0], 0)
    cki("p1-min-last", p1["minute"][11], 55)
    cki("p1-hour-count", len(p1["hour"]), 24)
    cki("p1-dom-count", len(p1["day_of_month"]), 31)

    ckb("p1-match-10", cron_matches(p1, 10, 9, 1, 1, 4), true)
    ckb("p1-match-11", cron_matches(p1, 11, 9, 1, 1, 4), false)
    ckb("p1-match-0", cron_matches(p1, 0, 0, 1, 1, 0), true)
    ckb("p1-match-59", cron_matches(p1, 59, 23, 31, 12, 6), false)

    cks("p1-describe", cron_describe("*/5 * * * *"), "every 5 minutes")
    cks("p0-describe", cron_describe("* * * * *"), "every minute")

    // ── cron_parse / cron_matches: "0 9 * * 1-5" (9 AM weekdays) ────────────
    let p2 = cron_parse("0 9 * * 1-5")
    cki("p2-dow-count", len(p2["day_of_week"]), 5)
    cki("p2-dow-0", p2["day_of_week"][0], 1)
    cki("p2-dow-4", p2["day_of_week"][4], 5)

    ckb("p2-mon-9am", cron_matches(p2, 0, 9, 15, 6, 1), true)
    ckb("p2-sun-9am", cron_matches(p2, 0, 9, 15, 6, 0), false)
    ckb("p2-mon-901", cron_matches(p2, 1, 9, 15, 6, 1), false)
    ckb("p2-mon-8am", cron_matches(p2, 0, 8, 15, 6, 1), false)
    ckb("p2-dow7-sunday", cron_matches(p2, 0, 9, 15, 6, 7), false)

    cks("p3-describe-weekdays", cron_describe("0 3 * * 1-5"), "at 3:00 AM on weekdays")

    // cron_next for p2, cross-checked against an independent brute-force
    // minute-stepper. Also verify the fired day is genuinely a weekday and
    // the fired time is exactly 09:00 (the only slot p2 can ever fire at).
    let start_y = 2026
    let start_m = 7
    let start_d = 30
    let start_h = 10
    let start_mi = 30
    let brute = _kat_brute_next(p2, start_y, start_m, start_d, start_h, start_mi, 20000)
    cki("p2-brute-found", brute[0], 1)
    let nxt2 = cron_next(p2, start_y, start_m, start_d, start_h, start_mi)
    cki("p2-next-year", nxt2["year"], brute[1])
    cki("p2-next-month", nxt2["month"], brute[2])
    cki("p2-next-day", nxt2["day"], brute[3])
    cki("p2-next-hour", nxt2["hour"], brute[4])
    cki("p2-next-minute", nxt2["minute"], brute[5])
    cki("p2-next-hour-is-9", nxt2["hour"], 9)
    cki("p2-next-minute-is-0", nxt2["minute"], 0)
    let fired_dow = cal_weekday(nxt2["year"], nxt2["month"], nxt2["day"])
    ckb("p2-next-is-weekday", fired_dow >= 1 and fired_dow <= 5, true)

    // ── cron_next: midnight rollover ("0 0 * * *", starting 23:59) ─────────
    let p3 = cron_parse("0 0 * * *")
    let nxt3 = cron_next(p3, 2026, 2, 27, 23, 59)
    cki("midnight-year", nxt3["year"], 2026)
    cki("midnight-month", nxt3["month"], 2)
    cki("midnight-day", nxt3["day"], 28)
    cki("midnight-hour", nxt3["hour"], 0)
    cki("midnight-minute", nxt3["minute"], 0)
    let brute3 = _kat_brute_next(p3, 2026, 2, 27, 23, 59, 20000)
    cki("midnight-brute-day", brute3[3], 28)

    // ── cron_next: month-end rollover, non-leap Feb -> March ────────────────
    let p4 = cron_parse("0 9 * * *")
    let nxt4 = cron_next(p4, 2026, 1, 31, 10, 0)
    cki("monthend-year", nxt4["year"], 2026)
    cki("monthend-month", nxt4["month"], 2)
    cki("monthend-day", nxt4["day"], 1)
    cki("monthend-hour", nxt4["hour"], 9)

    // ── cron_next: leap-year Feb 29 exists, then rolls to March 1 ───────────
    ckb("2024-is-leap", cal_is_leap(2024), true)
    let nxt5 = cron_next(p4, 2024, 2, 28, 10, 0)
    cki("leap-day-year", nxt5["year"], 2024)
    cki("leap-day-month", nxt5["month"], 2)
    cki("leap-day-day", nxt5["day"], 29)

    let nxt6 = cron_next(p4, 2024, 2, 29, 10, 0)
    cki("leap-rollover-year", nxt6["year"], 2024)
    cki("leap-rollover-month", nxt6["month"], 3)
    cki("leap-rollover-day", nxt6["day"], 1)

    // ── cron_matches: DOM/DOW "OR" quirk (both restricted -> union) ─────────
    let p7 = cron_parse("0 0 1,15 * 5")
    // Should fire on the 1st AND the 15th of the month, AND every Friday.
    ckb("or-quirk-1st", cron_matches(p7, 0, 0, 1, 6, 3), true)   // 1st (any weekday)
    ckb("or-quirk-15th", cron_matches(p7, 0, 0, 15, 6, 2), true) // 15th (any weekday)
    ckb("or-quirk-friday", cron_matches(p7, 0, 0, 10, 6, 5), true) // Friday the 10th
    ckb("or-quirk-neither", cron_matches(p7, 0, 0, 10, 6, 2), false) // 10th + Tuesday: neither

    // ── cron_describe: weekends + single weekday + step + malformed ─────────
    cks("describe-weekends", cron_describe("30 20 * * 0,6"), "at 8:30 PM on weekends")
    cks("describe-single-day", cron_describe("0 12 * * 3"), "at 12:00 PM on Wednesdays")
    cks("describe-invalid", cron_describe("* * *"), "invalid cron expression")

    // ── edge cases: empty / malformed expression must not crash ─────────────
    let pbad = cron_parse("")
    ckb("empty-invalid", pbad["_valid"], false)
    ckb("empty-nomatch", cron_matches(pbad, 0, 0, 1, 1, 1), false)
    let nxtbad = cron_next(pbad, 2026, 1, 1, 0, 0)
    cki("empty-next-size", len(nxtbad), 0)

    print("CRON KAT PASS")
