import forge_media_manager

fn main()
    let m = mm_new()
    m = mm_upload(m, "photo.jpg", "image/jpeg", 1024)
    m = mm_upload(m, "video.mp4", "video/mp4", 5000)
    assert(mm_count(m) == 2, "2 assets")
    assert(mm_total_size(m) == 6024, "6024 bytes")

    let t = mm_get(m, "photo.jpg")
    assert(is_ok(t), "get ok")
    assert(unwrap(t) == "image/jpeg", "jpeg type")

    let s = mm_size(m, "video.mp4")
    assert(unwrap(s) == 5000, "5000 bytes")

    let r = mm_delete(m, "photo.jpg")
    assert(is_ok(r), "delete ok")
    m = unwrap(r)
    assert(mm_total_size(m) == 5000, "5000 after delete")

    let bad = mm_get(m, "missing")
    assert(is_err(bad), "missing is err")

    let bad_del = mm_delete(m, "nope")
    assert(is_err(bad_del), "delete missing is err")

    print("MEDIA-MANAGER KAT PASS")
