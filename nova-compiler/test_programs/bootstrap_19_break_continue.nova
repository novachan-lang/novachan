// Bootstrap test 19: break and continue in loops
// Used in parser loops throughout the self-hosted compiler

// Simple break
let i = 0
let total = 0
while true
    if i >= 5
        break
    total = total + i
    i = i + 1
print(total)

// Continue to skip values
let total = 0
let j = 0
while j < 10
    j = j + 1
    if j == 3 or j == 7
        continue
    total = total + j
print(total)

// Break in for loop
fn find_first(items, target)
    let result = -1
    let idx = 0
    while idx < len(items)
        if items[idx] == target
            result = idx
            break
        idx = idx + 1
    return result

print(find_first(["a", "b", "c", "d"], "c"))

// Nested loop with break
let found = ""
let row = 0
while row < 3
    let col = 0
    while col < 3
        if row == 1 and col == 2
            found = str(row) + "," + str(col)
            break
        col = col + 1
    if found != ""
        break
    row = row + 1
print(found)
