// KAT test for std/random/wyrand
//
// wyrand (Wang Yi 2019): 64-bit counter + wymum(state, state^C2) mix.
// All anchor values computed with Python arbitrary-precision reference:
//   C1 = 0xA0761D6478BD642F, C2 = 0xE7037ED1A0B428DB
//   state += C1; out = wymum(state, state^C2).hi ^ .lo
//
// seed=42, first 8 outputs (signed i64):
//   [0] = -5887756399334017996
//   [1] = -1599892964753483310
//   [2] = -3794469254412942534
//   [3] = -1501472595352085903
//   [4] =  6502026092014180032
//   [5] = -1423648668587345843
//   [6] =  4222416168991763154
//   [7] =  1590502674916607357
//
// wy_wymum(1,1)                       = [0, 1]
// wy_wymum(0x100000000, 0x100000000)  = [1, 0]
// wy_next_range(wy_seed(42), 100)   = 12

import std/random/wyrand

fn main()
    // ── KAT 1: wy_wymum(1,1) = [0, 1] ─────────────────────────────────────────
    let m11 = wy_wymum(1, 1)
    if m11[0] != 0
        print("FAIL wyrand KAT1a: wy_wymum(1,1).hi got " + str(m11[0]) + " want 0")
        exit(1)
    if m11[1] != 1
        print("FAIL wyrand KAT1b: wy_wymum(1,1).lo got " + str(m11[1]) + " want 1")
        exit(1)

    // ── KAT 2: wy_wymum(0x100000000, 0x100000000) = [1, 0] ────────────────────
    let base = 0x100000000
    let m22 = wy_wymum(base, base)
    if m22[0] != 1
        print("FAIL wyrand KAT2a: wy_wymum(2^32,2^32).hi got " + str(m22[0]) + " want 1")
        exit(1)
    if m22[1] != 0
        print("FAIL wyrand KAT2b: wy_wymum(2^32,2^32).lo got " + str(m22[1]) + " want 0")
        exit(1)

    // ── KAT 3: seed=42 anchor[0] = -5887756399334017996 ─────────────────────
    let want0 = -5887756399334017996
    let r42 = wy_seed(42)
    let got0 = wy_next(r42)
    if got0 != want0
        print("FAIL wyrand KAT3: anchor[0] got " + str(got0) + " want " + str(want0))
        exit(1)

    // ── KAT 4: seed=42 anchor[1] = -1599892964753483310 ─────────────────────
    let want1 = -1599892964753483310
    let got1 = wy_next(r42)
    if got1 != want1
        print("FAIL wyrand KAT4: anchor[1] got " + str(got1) + " want " + str(want1))
        exit(1)

    // ── KAT 5: seed=42 anchor[2] = -3794469254412942534 ─────────────────────
    let want2 = -3794469254412942534
    let got2 = wy_next(r42)
    if got2 != want2
        print("FAIL wyrand KAT5: anchor[2] got " + str(got2) + " want " + str(want2))
        exit(1)

    // ── KAT 6: seed=42 anchor[3] = -1501472595352085903 ─────────────────────
    let want3 = -1501472595352085903
    let got3 = wy_next(r42)
    if got3 != want3
        print("FAIL wyrand KAT6: anchor[3] got " + str(got3) + " want " + str(want3))
        exit(1)

    // ── KAT 7: seed=42 anchor[4] = 6502026092014180032 ──────────────────────
    let want4 = 6502026092014180032
    let got4 = wy_next(r42)
    if got4 != want4
        print("FAIL wyrand KAT7: anchor[4] got " + str(got4) + " want " + str(want4))
        exit(1)

    // ── KAT 8: seed=42 anchor[5] = -1423648668587345843 ─────────────────────
    let want5 = -1423648668587345843
    let got5 = wy_next(r42)
    if got5 != want5
        print("FAIL wyrand KAT8: anchor[5] got " + str(got5) + " want " + str(want5))
        exit(1)

    // ── KAT 9: seed=42 anchor[6] = 4222416168991763154 ──────────────────────
    let want6 = 4222416168991763154
    let got6 = wy_next(r42)
    if got6 != want6
        print("FAIL wyrand KAT9: anchor[6] got " + str(got6) + " want " + str(want6))
        exit(1)

    // ── KAT 10: seed=42 anchor[7] = 1590502674916607357 ─────────────────────
    let want7 = 1590502674916607357
    let got7 = wy_next(r42)
    if got7 != want7
        print("FAIL wyrand KAT10: anchor[7] got " + str(got7) + " want " + str(want7))
        exit(1)

    // ── KAT 11: determinism -- two wy_seed(42) agree first 8 ─────────────────
    let ra = wy_seed(42)
    let rb = wy_seed(42)
    let di = 0
    while di < 8
        let va = wy_next(ra)
        let vb = wy_next(rb)
        if va != vb
            print("FAIL wyrand KAT11: determinism diverged at step " + str(di))
            exit(1)
        di = di + 1

    // ── KAT 12: different seeds differ ───────────────────────────────────────
    let rx = wy_seed(0)
    let ry = wy_seed(1)
    let vx = wy_next(rx)
    let vy = wy_next(ry)
    if vx == vy
        print("FAIL wyrand KAT12: seed 0 and seed 1 produced same first output: " + str(vx))
        exit(1)

    // ── KAT 13: wy_next_range(seed=42, 100) first call = 12 ─────────────────
    let rr = wy_seed(42)
    let rv = wy_next_range(rr, 100)
    if rv != 12
        print("FAIL wyrand KAT13: next_range(42,100) got " + str(rv) + " want 12")
        exit(1)

    // ── KAT 14: wy_next_range stays in [0, n) over 500 calls ─────────────────
    let rs = wy_seed(99999)
    let ji = 0
    while ji < 500
        let v14 = wy_next_range(rs, 137)
        if v14 < 0
            print("FAIL wyrand KAT14a: range < 0 at step " + str(ji))
            exit(1)
        if v14 >= 137
            print("FAIL wyrand KAT14b: range >= 137 at step " + str(ji))
            exit(1)
        ji = ji + 1

    // ── KAT 15: wy_next_range with n=1 always returns 0 ─────────────────────
    let r1 = wy_seed(7)
    let ki = 0
    while ki < 20
        let v15 = wy_next_range(r1, 1)
        if v15 != 0
            print("FAIL wyrand KAT15: range(1) != 0 at step " + str(ki) + ": " + str(v15))
            exit(1)
        ki = ki + 1

    // ── KAT 16: non-degenerate -- seed=0 first output is nonzero ─────────────
    let r0 = wy_seed(0)
    let v0 = wy_next(r0)
    if v0 == 0
        print("FAIL wyrand KAT16: seed=0 first output was 0 (degenerate)")
        exit(1)

    print("PASS _wyrand_test")
