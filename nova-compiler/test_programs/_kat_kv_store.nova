import forge_kv_store

fn main()
    let s = kv_new()
    s = kv_set(s, "name", "alice", 0)
    s = kv_set(s, "temp", "data", 100)
    assert(kv_count(s) == 2, "2 keys")

    let r1 = kv_get(s, "name", 50)
    assert(is_ok(r1), "get name ok")
    assert(unwrap(r1) == "alice", "name=alice")

    let r2 = kv_get(s, "temp", 50)
    assert(is_ok(r2), "temp not expired at 50")

    let r3 = kv_get(s, "temp", 200)
    assert(is_err(r3), "temp expired at 200")

    let r4 = kv_get(s, "missing", 0)
    assert(is_err(r4), "missing key")

    assert(kv_hit_rate(s) == 50, "50% hit rate")

    print("KV-STORE KAT PASS")
