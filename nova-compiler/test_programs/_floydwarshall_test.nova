// KAT for std/graph/floydwarshall
// Floyd-Warshall all-pairs shortest paths.
//
// Example graph (directed, weighted):
//   A -> [[B,3],[C,8]]
//   B -> [[C,2]]
//   C -> [[A,1]]
//
// Hand-computed shortest paths:
//   A->A = 0   (self)
//   A->B = 3   (direct)
//   A->C = 5   (A->B->C = 3+2)
//   B->A = 3   (B->C->A = 2+1)
//   B->B = 0   (self)
//   B->C = 2   (direct)
//   C->A = 1   (direct)
//   C->B = 4   (C->A->B = 1+3)
//   C->C = 0   (self)
import std/graph/floydwarshall

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // Build the adjacency dict.
    let g = {}
    let edgesA = []
    let eAB = []
    eAB.push("B")
    eAB.push(3)
    let eAC = []
    eAC.push("C")
    eAC.push(8)
    edgesA.push(eAB)
    edgesA.push(eAC)
    g["A"] = edgesA

    let edgesB = []
    let eBC = []
    eBC.push("C")
    eBC.push(2)
    edgesB.push(eBC)
    g["B"] = edgesB

    let edgesC = []
    let eCA = []
    eCA.push("A")
    eCA.push(1)
    edgesC.push(eCA)
    g["C"] = edgesC

    let nodes = ["A", "B", "C"]

    // Run Floyd-Warshall.
    let r = floydwarshall.fw_all_pairs(g, nodes)

    // === Spec KAT assertions ===

    // 1. A->C = 5 (A->B->C = 3+2, better than direct A->C = 8)
    cki("AtoC", floydwarshall.fw_distance(r, "A", "C"), 5)

    // 2. B->A = 3 (B->C->A = 2+1)
    cki("BtoA", floydwarshall.fw_distance(r, "B", "A"), 3)

    // 3. C->B = 4 (C->A->B = 1+3)
    cki("CtoB", floydwarshall.fw_distance(r, "C", "B"), 4)

    // 4. A->A = 0 (self-distance)
    cki("AtoA", floydwarshall.fw_distance(r, "A", "A"), 0)

    // 5. A->B = 3 (direct edge)
    cki("AtoB", floydwarshall.fw_distance(r, "A", "B"), 3)

    // 6. No negative cycle (all weights positive)
    cki("no_neg_cycle", floydwarshall.fw_has_negative_cycle(r, nodes), 0)

    // === Additional coverage ===

    // B->B = 0
    cki("BtoB", floydwarshall.fw_distance(r, "B", "B"), 0)

    // C->C = 0
    cki("CtoC", floydwarshall.fw_distance(r, "C", "C"), 0)

    // B->C = 2 (direct)
    cki("BtoC", floydwarshall.fw_distance(r, "B", "C"), 2)

    // C->A = 1 (direct)
    cki("CtoA", floydwarshall.fw_distance(r, "C", "A"), 1)

    // Unreachable node query returns INF = 1000000000
    let g2 = {}
    let e2 = []
    let edge2 = []
    edge2.push("Y")
    edge2.push(5)
    e2.push(edge2)
    g2["X"] = e2
    let n2 = ["X", "Y", "Z"]
    let r2 = floydwarshall.fw_all_pairs(g2, n2)
    cki("unreachable_ZtoX", floydwarshall.fw_distance(r2, "Z", "X"), 1000000000)
    cki("unreachable_XtoZ", floydwarshall.fw_distance(r2, "X", "Z"), 1000000000)
    cki("direct_XtoY", floydwarshall.fw_distance(r2, "X", "Y"), 5)

    // Negative cycle detection test.
    // Build a graph: P->Q weight -5, Q->P weight -5 => cycle weight -10 < 0
    let gn = {}
    let ePQ = []
    let edgePQ = []
    edgePQ.push("Q")
    edgePQ.push(-5)
    ePQ.push(edgePQ)
    gn["P"] = ePQ
    let eQP = []
    let edgeQP = []
    edgeQP.push("P")
    edgeQP.push(-5)
    eQP.push(edgeQP)
    gn["Q"] = eQP
    let nn = ["P", "Q"]
    let rn = floydwarshall.fw_all_pairs(gn, nn)
    cki("neg_cycle_detected", floydwarshall.fw_has_negative_cycle(rn, nn), 1)

    print("_floydwarshall_test passed")

main()
