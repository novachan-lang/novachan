import std/os/ar_archive

// cki: integer equality check
fn cki(label, got, want)
    if got != want
        print("FAIL ar_archive " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// cks: string equality check
fn cks(label, got, want)
    if got != want
        print("FAIL ar_archive " + label + ": got=" + got + " want=" + want)
        exit(1)

// ckb: bool equality check
fn ckb(label, got, want)
    let g = 0
    let w = 0
    if got
        g = 1
    if want
        w = 1
    if g != w
        print("FAIL ar_archive " + label + ": got=" + str(g) + " want=" + str(w))
        exit(1)

// _build_ar_buf: construct a minimal ar archive in a list-of-ints buffer.
// Layout:
//   [0..7]   global magic: !<arch>\n  (8 bytes)
//   [8..67]  entry header             (60 bytes)
//     [8..23]  name 'foo.o' + 11 spaces
//     [24..35] mtime '0' + 11 spaces
//     [36..41] uid '0' + 5 spaces
//     [42..47] gid '0' + 5 spaces
//     [48..55] mode '0644' + 4 spaces
//     [56..65] size '12' + 8 spaces
//     [66..67] end-magic 96, 10
//   [68..79]  12 data bytes (all zero)
fn _build_ar_buf() -> any
    let buf = []
    // global magic: !<arch>\n = 33,60,97,114,99,104,62,10
    push(buf, 33)
    push(buf, 60)
    push(buf, 97)
    push(buf, 114)
    push(buf, 99)
    push(buf, 104)
    push(buf, 62)
    push(buf, 10)
    // name field: 'foo.o' = 102,111,111,46,111 then 11 spaces
    push(buf, 102)
    push(buf, 111)
    push(buf, 111)
    push(buf, 46)
    push(buf, 111)
    push(buf, 32)
    push(buf, 32)
    push(buf, 32)
    push(buf, 32)
    push(buf, 32)
    push(buf, 32)
    push(buf, 32)
    push(buf, 32)
    push(buf, 32)
    push(buf, 32)
    push(buf, 32)
    // mtime field: '0' then 11 spaces (12 bytes)
    push(buf, 48)
    push(buf, 32)
    push(buf, 32)
    push(buf, 32)
    push(buf, 32)
    push(buf, 32)
    push(buf, 32)
    push(buf, 32)
    push(buf, 32)
    push(buf, 32)
    push(buf, 32)
    push(buf, 32)
    // uid field: '0' then 5 spaces (6 bytes)
    push(buf, 48)
    push(buf, 32)
    push(buf, 32)
    push(buf, 32)
    push(buf, 32)
    push(buf, 32)
    // gid field: '0' then 5 spaces (6 bytes)
    push(buf, 48)
    push(buf, 32)
    push(buf, 32)
    push(buf, 32)
    push(buf, 32)
    push(buf, 32)
    // mode field: '0644' then 4 spaces (8 bytes)
    push(buf, 48)
    push(buf, 54)
    push(buf, 52)
    push(buf, 52)
    push(buf, 32)
    push(buf, 32)
    push(buf, 32)
    push(buf, 32)
    // size field: '12' then 8 spaces (10 bytes)
    push(buf, 49)
    push(buf, 50)
    push(buf, 32)
    push(buf, 32)
    push(buf, 32)
    push(buf, 32)
    push(buf, 32)
    push(buf, 32)
    push(buf, 32)
    push(buf, 32)
    // end-magic: 96, 10
    push(buf, 96)
    push(buf, 10)
    // 12 data bytes (all 0)
    push(buf, 0)
    push(buf, 0)
    push(buf, 0)
    push(buf, 0)
    push(buf, 0)
    push(buf, 0)
    push(buf, 0)
    push(buf, 0)
    push(buf, 0)
    push(buf, 0)
    push(buf, 0)
    push(buf, 0)
    return buf

fn main()
    let buf = _build_ar_buf()

    // sanity: check total buffer length = 8 + 60 + 12 = 80
    cki("buf_len", len(buf), 80)

    // ar_magic_check
    ckb("magic_check", ar_magic_check(buf), true)

    // ar_first_entry_pos
    cki("first_entry_pos", ar_first_entry_pos(buf), 8)

    // ar_entry_name: 'foo.o' with trailing spaces and no '/'
    cks("entry_name", ar_entry_name(buf, 8), "foo.o")

    // ar_entry_mtime: '0' => 0
    cki("entry_mtime", ar_entry_mtime(buf, 8), 0)

    // ar_entry_uid: '0' => 0
    cki("entry_uid", ar_entry_uid(buf, 8), 0)

    // ar_entry_gid: '0' => 0
    cki("entry_gid", ar_entry_gid(buf, 8), 0)

    // ar_entry_mode: '0644' octal => 6*64 + 4*8 + 4 = 384+32+4 = 420
    cki("entry_mode", ar_entry_mode(buf, 8), 420)

    // ar_entry_size: '12' decimal => 12
    cki("entry_size", ar_entry_size(buf, 8), 12)

    // ar_entry_magic_check
    ckb("entry_magic_check", ar_entry_magic_check(buf, 8), true)

    // ar_entry_data_offset: pos+60 = 8+60 = 68
    cki("entry_data_offset", ar_entry_data_offset(buf, 8), 68)

    // ar_next_entry_pos: 8+60+12=80; size 12 is even so no extra pad
    cki("next_entry_pos", ar_next_entry_pos(buf, 8), 80)

    // ar_entry_count: 1 entry
    cki("entry_count", ar_entry_count(buf), 1)

    // negative: magic check on empty buf
    let empty = []
    ckb("magic_check_empty", ar_magic_check(empty), false)

    print("PASS _ar_archive_test")
