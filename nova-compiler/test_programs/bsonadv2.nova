import std/encoding/bson

fn main()
    let d = {}
    d["v"] = 0
    let e = bson_encode(d)
    print("int0 doclen=" + str(bytes_len(e)))
    print("int0 typebyte=" + str(bytes_get(e, 4)))

    let d2 = {}
    d2["v"] = ""
    let e2 = bson_encode(d2)
    print("emptystr doclen=" + str(bytes_len(e2)))
    print("emptystr typebyte=" + str(bytes_get(e2, 4)))

    let d3 = {}
    d3["v"] = []
    let e3 = bson_encode(d3)
    print("emptylist doclen=" + str(bytes_len(e3)))
    print("emptylist typebyte=" + str(bytes_get(e3, 4)))

    let d4 = {}
    d4["v"] = bytes_create(0)
    let e4 = bson_encode(d4)
    print("emptybytes doclen=" + str(bytes_len(e4)))
    print("emptybytes typebyte=" + str(bytes_get(e4, 4)))
