import std/interval/interval_stab

// Helper: compare two lists of [lo,hi] intervals for structural equality.
fn iv_eq(a, b)
    if len(a) != len(b)
        return 0
    let i = 0
    while i < len(a)
        let ii = i
        let pa = a[ii]
        let pb = b[ii]
        if pa[0] != pb[0] or pa[1] != pb[1]
            return 0
        i = i + 1
    return 1

fn main()
    let ivs = [[1,3],[2,4],[5,6]]

    // KAT 1: ist_stab([[1,3],[2,4],[5,6]], 2) == [[1,3],[2,4]]
    let r1 = ist_stab(ivs, 2)
    let want1 = [[1,3],[2,4]]
    if iv_eq(r1, want1) != 1
        print("FAIL ist_stab_1: got len=" + str(len(r1)))
        exit(1)

    // KAT 2: ist_stab_count([[1,3],[2,4],[5,6]], 2) == 2
    let r2 = ist_stab_count(ivs, 2)
    if r2 != 2
        print("FAIL ist_stab_count_2: got=" + str(r2) + " want=2")
        exit(1)

    // KAT 3: ist_stab_count([[1,3],[2,4]], 5) == 0
    let ivs2 = [[1,3],[2,4]]
    let r3 = ist_stab_count(ivs2, 5)
    if r3 != 0
        print("FAIL ist_stab_count_3: got=" + str(r3) + " want=0")
        exit(1)

    // KAT 4: ist_max_overlap_count([[1,5],[2,6],[3,7]]) == 3
    let ivs4 = [[1,5],[2,6],[3,7]]
    let r4 = ist_max_overlap_count(ivs4)
    if r4 != 3
        print("FAIL ist_max_overlap_count_4: got=" + str(r4) + " want=3")
        exit(1)

    // KAT 5: ist_max_overlap_count([[1,2],[3,4]]) == 1
    let ivs5 = [[1,2],[3,4]]
    let r5 = ist_max_overlap_count(ivs5)
    if r5 != 1
        print("FAIL ist_max_overlap_count_5: got=" + str(r5) + " want=1")
        exit(1)

    // KAT 6: ist_any_stab([[1,3],[5,7]], 4) == false (0)
    let ivs6 = [[1,3],[5,7]]
    let r6 = ist_any_stab(ivs6, 4)
    if r6 != 0
        print("FAIL ist_any_stab_6: got=" + str(r6) + " want=0")
        exit(1)

    // KAT 7: ist_any_stab([[1,3],[5,7]], 2) == true (1)
    let r7 = ist_any_stab(ivs6, 2)
    if r7 != 1
        print("FAIL ist_any_stab_7: got=" + str(r7) + " want=1")
        exit(1)

    // KAT 8: ist_deepest([[1,4],[2,3],[2,5]]) == 3
    let ivs8 = [[1,4],[2,3],[2,5]]
    let r8 = ist_deepest(ivs8)
    if r8 != 3
        print("FAIL ist_deepest_8: got=" + str(r8) + " want=3")
        exit(1)

    // KAT 9: ist_stab on boundary endpoints (point at lo and hi)
    let ivs9 = [[3,7]]
    let r9a = ist_stab_count(ivs9, 3)
    if r9a != 1
        print("FAIL ist_stab_boundary_lo: got=" + str(r9a) + " want=1")
        exit(1)
    let r9b = ist_stab_count(ivs9, 7)
    if r9b != 1
        print("FAIL ist_stab_boundary_hi: got=" + str(r9b) + " want=1")
        exit(1)
    let r9c = ist_stab_count(ivs9, 8)
    if r9c != 0
        print("FAIL ist_stab_outside_hi: got=" + str(r9c) + " want=0")
        exit(1)

    // KAT 10: ist_first_stabbed returns correct interval
    let rf = ist_first_stabbed(ivs, 2)
    if rf == null
        print("FAIL ist_first_stabbed_10: got null want [1,3]")
        exit(1)
    if rf[0] != 1 or rf[1] != 3
        print("FAIL ist_first_stabbed_10: got " + str(rf[0]) + "," + str(rf[1]) + " want 1,3")
        exit(1)

    // KAT 11: ist_first_stabbed returns null when no interval contains x
    let rf2 = ist_first_stabbed(ivs, 10)
    if rf2 != null
        print("FAIL ist_first_stabbed_11: got non-null want null")
        exit(1)

    // KAT 12: ist_sweep on [[1,3],[2,4]] produces 4 events sorted correctly
    let ivs12 = [[1,3],[2,4]]
    let sw = ist_sweep(ivs12)
    if len(sw) != 4
        print("FAIL ist_sweep_12: len=" + str(len(sw)) + " want=4")
        exit(1)
    // Events should be: [1,0,0],[2,0,1],[3,1,0],[4,1,1]
    let e0 = sw[0]
    let e1 = sw[1]
    let e2 = sw[2]
    let e3 = sw[3]
    if e0[0] != 1 or e0[1] != 0
        print("FAIL ist_sweep_12_e0: pt=" + str(e0[0]) + " type=" + str(e0[1]))
        exit(1)
    if e1[0] != 2 or e1[1] != 0
        print("FAIL ist_sweep_12_e1: pt=" + str(e1[0]) + " type=" + str(e1[1]))
        exit(1)
    if e2[0] != 3 or e2[1] != 1
        print("FAIL ist_sweep_12_e2: pt=" + str(e2[0]) + " type=" + str(e2[1]))
        exit(1)
    if e3[0] != 4 or e3[1] != 1
        print("FAIL ist_sweep_12_e3: pt=" + str(e3[0]) + " type=" + str(e3[1]))
        exit(1)

    // KAT 13: ist_count_at_each_endpoint on [[1,3],[2,4]]
    let cae = ist_count_at_each_endpoint(ivs12)
    // unique endpoints: 1,2,3,4 -> counts: 1,2,1,1
    if len(cae) != 4
        print("FAIL ist_count_at_each_endpoint_13: len=" + str(len(cae)) + " want=4")
        exit(1)
    let cae0 = cae[0]
    let cae1 = cae[1]
    let cae2 = cae[2]
    let cae3 = cae[3]
    if cae0[0] != 1 or cae0[1] != 1
        print("FAIL ist_count_at_each_endpoint_13_0: pt=" + str(cae0[0]) + " cnt=" + str(cae0[1]))
        exit(1)
    if cae1[0] != 2 or cae1[1] != 2
        print("FAIL ist_count_at_each_endpoint_13_1: pt=" + str(cae1[0]) + " cnt=" + str(cae1[1]))
        exit(1)
    // pt=3: [1,3] contains 3, [2,4] contains 3 -> count=2
    if cae2[0] != 3 or cae2[1] != 2
        print("FAIL ist_count_at_each_endpoint_13_2: pt=" + str(cae2[0]) + " cnt=" + str(cae2[1]))
        exit(1)
    if cae3[0] != 4 or cae3[1] != 1
        print("FAIL ist_count_at_each_endpoint_13_3: pt=" + str(cae3[0]) + " cnt=" + str(cae3[1]))
        exit(1)

    // KAT 14: empty intervals
    let empty = []
    if ist_stab_count(empty, 5) != 0
        print("FAIL ist_stab_count_empty")
        exit(1)
    if ist_deepest(empty) != 0
        print("FAIL ist_deepest_empty")
        exit(1)
    let mop = ist_max_overlap_point(empty)
    if mop[1] != 0
        print("FAIL ist_max_overlap_point_empty")
        exit(1)

    print("PASS _interval_stab_test")

main()
