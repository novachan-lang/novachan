import forge_crc16

fn blist(s: string) -> list
    let out = []
    let i = 0
    while i < len(s)
        push(out, ord(char_at(s, i)))
        i = i + 1
    out
fn tf(b: bool) -> string
    if b
        return "T"
    "F"

fn main()
    let check = blist("123456789")
    // CRC-16/CCITT-FALSE check = 0x29B1 = 10673
    print("ccitt=" + tf(crc16_ccitt(check) == 10673) + " hex=" + crc16_hex(crc16_ccitt(check)))
    // CRC-16/XMODEM check = 0x31C3 = 12739
    print("xmodem=" + tf(crc16_xmodem(check) == 12739) + " hex=" + crc16_hex(crc16_xmodem(check)))
    // empty CCITT = init 0xFFFF (no bytes processed)
    print("empty=" + tf(crc16_ccitt([]) == 65535))
    // single byte "A" (0x41) xmodem
    print("hexfmt=" + tf(crc16_hex(10673) == "29b1"))
