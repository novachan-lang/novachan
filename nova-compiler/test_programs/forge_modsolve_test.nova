import forge_modsolve as ms

fn check(cond: bool, label: string)
    if cond == false
        print("FAIL: " + label)

fn main()
    // ---- legendre ----
    // QRs mod 7 are {1,2,4}; non-residues {3,5,6}
    check(ms.legendre(1, 7) == 1, "leg 1,7")
    check(ms.legendre(2, 7) == 1, "leg 2,7")
    check(ms.legendre(4, 7) == 1, "leg 4,7")
    check(ms.legendre(3, 7) == 0 - 1, "leg 3,7")
    check(ms.legendre(5, 7) == 0 - 1, "leg 5,7")
    check(ms.legendre(7, 7) == 0, "leg 7,7 (divides)")
    check(ms.legendre(14, 7) == 0, "leg 14,7 (divides)")
    check(ms.is_quadratic_residue(2, 7), "is_qr 2,7")
    check(ms.is_quadratic_residue(3, 7) == false, "is_qr 3,7 false")

    // ---- mod_sqrt: p == 3 mod 4 fast path (p=7) ----
    // 3^2 = 9 = 2 mod 7; smaller root of 2 is 3
    check(ms.mod_sqrt(2, 7) == 3, "sqrt 2 mod 7")
    check(ms.mod_sqrt(4, 7) == 2, "sqrt 4 mod 7")
    check(ms.mod_sqrt(0, 7) == 0, "sqrt 0 mod 7")
    check(ms.mod_sqrt(3, 7) == 0 - 1, "sqrt 3 mod 7 (none)")

    // ---- mod_sqrt: p == 1 mod 4 general Tonelli-Shanks path (p=13,17) ----
    // squares mod 13: {1,4,9,3,12,10}; sqrt(10)=6 (6^2=36=10), sqrt(3)=4
    check(ms.mod_sqrt(10, 13) == 6, "sqrt 10 mod 13")
    check(ms.mod_sqrt(3, 13) == 4, "sqrt 3 mod 13")
    check(ms.mod_sqrt(2, 13) == 0 - 1, "sqrt 2 mod 13 (none)")
    // squares mod 17 include 2 (6^2=36=2); smaller root 6
    check(ms.mod_sqrt(2, 17) == 6, "sqrt 2 mod 17")

    // ---- mod_sqrt brute-force self-check over a p == 1 mod 4 prime (41) ----
    // every returned root must actually square back to n; every QR must be found
    let p = 41
    let n = 1
    while n < p
        let root = ms.mod_sqrt(n, p)
        let leg = ms.legendre(n, p)
        if leg == 1
            check(root >= 0, "41: QR should have a root n=" + str(n))
            check((root * root) % p == n, "41: root^2==n for n=" + str(n))
        else
            check(root == 0 - 1, "41: non-residue must return -1 n=" + str(n))
        n = n + 1

    // ---- mod_sqrt over a larger p == 1 mod 4 prime (10007 is prime, 10007 % 4 == 3 -> use 10009) ----
    // 10009 % 4 == 1 forces Tonelli general path on a big modulus
    let big = 10009
    let k = 2
    while k < 60
        let sq = (k * k) % big
        let root2 = ms.mod_sqrt(sq, big)
        check(root2 >= 0, "10009: sqrt exists for square of " + str(k))
        check((root2 * root2) % big == sq, "10009: root^2==sq for k=" + str(k))
        k = k + 1

    // ---- discrete_log: 3 is a primitive root mod 7 (order 6) ----
    // 3^0=1,3^1=3,3^2=2,3^3=6,3^4=4,3^5=5
    check(ms.discrete_log(3, 1, 7) == 0, "dlog 3->1 mod7")
    check(ms.discrete_log(3, 3, 7) == 1, "dlog 3->3 mod7")
    check(ms.discrete_log(3, 2, 7) == 2, "dlog 3->2 mod7")
    check(ms.discrete_log(3, 6, 7) == 3, "dlog 3->6 mod7")
    check(ms.discrete_log(3, 4, 7) == 4, "dlog 3->4 mod7")
    check(ms.discrete_log(3, 5, 7) == 5, "dlog 3->5 mod7")

    // ---- discrete_log: 2 mod 7 generates only {1,2,4}; 3,5,6 have no log ----
    check(ms.discrete_log(2, 1, 7) == 0, "dlog 2->1 mod7")
    check(ms.discrete_log(2, 4, 7) == 2, "dlog 2->4 mod7")
    check(ms.discrete_log(2, 3, 7) == 0 - 1, "dlog 2->3 mod7 (none)")
    check(ms.discrete_log(2, 5, 7) == 0 - 1, "dlog 2->5 mod7 (none)")

    // ---- discrete_log self-check on a bigger prime (2 is a primitive root mod 101) ----
    let pp = 101
    let x = 0
    while x < 100
        // compute 2^x mod 101 directly
        let val = 1
        let c = 0
        while c < x
            val = (val * 2) % pp
            c = c + 1
        let got = ms.discrete_log(2, val, pp)
        check(got >= 0, "101: dlog exists x=" + str(x))
        // recompute 2^got and compare (got may equal x since 2 is primitive)
        let v2 = 1
        let c2 = 0
        while c2 < got
            v2 = (v2 * 2) % pp
            c2 = c2 + 1
        check(v2 == val, "101: 2^dlog==val x=" + str(x))
        x = x + 1

    print("forge_modsolve: all passed")
