// Dict literal and basic ops
d = {"apple": 5, "banana": 3, "cherry": 8}
print(d["apple"])
print(d["banana"])

// Update existing key
d["apple"] = 10
print(d["apple"])

// has / len
print(d.has("cherry"))
print(d.has("grape"))
print(d.len())

// Add new key
d["grape"] = 7
print(d.len())

// Delete a key
d.del("banana")
print(d.len())
print(d.has("banana"))

// Iterate keys
freq = {}
freq["a"] = 1
freq["b"] = 2
freq["c"] = 3
for k in freq.keys()
    print(k)
