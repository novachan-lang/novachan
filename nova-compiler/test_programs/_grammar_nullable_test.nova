import std/grammar/grammar_nullable

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn ckl(label, got, expected)
    if len(got) != len(expected)
        print("FAIL " + label + ": length " + str(len(got)) + " != " + str(len(expected)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != expected[i]
            print("FAIL " + label + "[" + str(i) + "]: " + got[i] + " != " + expected[i])
            exit(1)
        i = i + 1

fn make_prod(lhs, rhs) -> list
    let p = []
    push(p, lhs)
    push(p, rhs)
    return p

fn main()
    // Grammar 1: S -> a S b | epsilon
    // Nullable: {S}
    let rhs1a = []
    push(rhs1a, "a")
    push(rhs1a, "S")
    push(rhs1a, "b")
    let rhs1b = []
    let prods1 = []
    push(prods1, make_prod("S", rhs1a))
    push(prods1, make_prod("S", rhs1b))

    let null1 = grammar_nullable.grn_nullable_set(prods1)
    let exp1 = []
    push(exp1, "S")
    ckl("nullable1", null1, exp1)

    // Grammar 2: A -> B C ; B -> epsilon ; C -> epsilon
    // Nullable: {A, B, C}
    let prods2 = []
    let rhsBC = []
    push(rhsBC, "B")
    push(rhsBC, "C")
    push(prods2, make_prod("A", rhsBC))
    push(prods2, make_prod("B", []))
    push(prods2, make_prod("C", []))

    let null2 = grammar_nullable.grn_nullable_set(prods2)
    // Expected sorted: ["A","B","C"]
    let exp2 = []
    push(exp2, "A")
    push(exp2, "B")
    push(exp2, "C")
    ckl("nullable2", null2, exp2)

    // Grammar 3: A -> b  (no epsilon productions)
    // Nullable: {}
    let prods3 = []
    let rhsb = []
    push(rhsb, "b")
    push(prods3, make_prod("A", rhsb))

    let null3 = grammar_nullable.grn_nullable_set(prods3)
    let exp3 = []
    ckl("nullable3_empty", null3, exp3)

    // grn_is_nullable_seq(prods2, ["B","C"]) = 1 (both B and C are nullable)
    let seq_bc = []
    push(seq_bc, "B")
    push(seq_bc, "C")
    cki("nullable_seq_BC", grammar_nullable.grn_is_nullable_seq(prods2, seq_bc), 1)

    // grn_is_nullable(prods1, "a") = 0 (terminal, never nullable)
    cki("nullable_terminal_a", grammar_nullable.grn_is_nullable(prods1, "a"), 0)

    // grn_is_nullable(prods1, "S") = 1
    cki("nullable_S", grammar_nullable.grn_is_nullable(prods1, "S"), 1)

    // grn_is_nullable_seq with empty seq = 1 (vacuously true)
    let empty_seq = []
    cki("nullable_seq_empty", grammar_nullable.grn_is_nullable_seq(prods1, empty_seq), 1)

    // Nullable chain: D -> E ; E -> epsilon  =>  D and E nullable
    let prods4 = []
    let rhsE = []
    push(rhsE, "E")
    push(prods4, make_prod("D", rhsE))
    push(prods4, make_prod("E", []))
    let null4 = grammar_nullable.grn_nullable_set(prods4)
    // Expected sorted: ["D","E"]
    let exp4 = []
    push(exp4, "D")
    push(exp4, "E")
    ckl("nullable4_chain", null4, exp4)

    print("PASS _grammar_nullable_test")
