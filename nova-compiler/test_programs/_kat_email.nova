import forge_email

fn main()
    let e = email_new("sender@test.com", "alice@test.com", "Hello World")
    e = email_to(e, "bob@test.com")
    e = email_cc(e, "carol@test.com")
    e = email_reply_to(e, "noreply@test.com")
    e = email_text(e, "Hello from NOVA!")
    e = email_html(e, "<h1>Hello from NOVA!</h1>")

    assert(len(e["to"]) == 2, "2 recipients")
    assert(len(e["cc"]) == 1, "1 cc")
    assert(e["reply_to"] == "noreply@test.com", "reply-to set")

    let errors = email_validate(e)
    assert(len(errors) == 0, "valid email")

    let rendered = email_render(e)
    assert(contains(rendered, "From: sender@test.com"), "has from")
    assert(contains(rendered, "To: alice@test.com, bob@test.com"), "has to")
    assert(contains(rendered, "Cc: carol@test.com"), "has cc")
    assert(contains(rendered, "Subject: Hello World"), "has subject")
    assert(contains(rendered, "MIME-Version: 1.0"), "has mime")
    assert(contains(rendered, "multipart/alternative"), "multipart alt")
    assert(contains(rendered, "text/plain"), "has text part")
    assert(contains(rendered, "text/html"), "has html part")
    assert(contains(rendered, "Hello from NOVA!"), "has body")

    let e2 = email_new("a@b.com", "c@d.com", "Test")
    e2 = email_text(e2, "Simple text")
    let r2 = email_render(e2)
    assert(contains(r2, "Content-Type: text/plain"), "simple text email")
    assert(not contains(r2, "boundary"), "no boundary for simple")

    let e3 = email_new("a@b.com", "c@d.com", "With attach")
    e3 = email_text(e3, "See attached")
    e3 = email_attach(e3, "report.csv", "text/csv", "name,value\nA,1\nB,2")
    let r3 = email_render(e3)
    assert(contains(r3, "multipart/mixed"), "mixed for attachments")
    assert(contains(r3, "report.csv"), "attachment filename")

    let bad = email_new("", "", "")
    let bad_errors = email_validate(bad)
    assert(len(bad_errors) >= 3, "at least 3 validation errors")

    let bad2 = email_new("a@b.com", "not-an-email", "Test")
    bad2 = email_text(bad2, "body")
    let bad2_errors = email_validate(bad2)
    assert(len(bad2_errors) == 1, "invalid address error")

    print("FORGE-EMAIL KAT PASS")
