import prism_ui_kit
import prism_content

fn mk(s: string) -> Result<string>
    if len(s) == 0
        return err("REJECTED_EMPTY")
    ok("<" + s + ">")

fn main()
    // is prism_label("") actually legal? (explains the earlier S1 result)
    let e = prism_content.prism_label("")
    print("prism_label(\"\") is_ok = {is_ok(e)}")

    // collect with a mapper that DEFINITELY errors
    let bad = prism_ui_kit.prism_ui_collect(["a", "", "c"], fn(s) mk(s))
    if is_err(bad)
        print("collect PROPAGATES: {unwrap_err(bad)}")
    else
        let l = unwrap(bad)
        print("collect SWALLOWED! len={len(l)} v1={l[1]}")

    let good = prism_ui_kit.prism_ui_collect(["a", "c"], fn(s) mk(s))
    print("collect happy: is_ok={is_ok(good)} v0={unwrap(good)[0]}")
