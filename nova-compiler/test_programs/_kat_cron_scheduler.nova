import forge_cron_scheduler

fn main()
    let c = cron_new()
    let r1 = cron_add(c, "backup", 60)
    assert(is_ok(r1), "add ok")
    c = unwrap(r1)
    assert(cron_job_count(c) == 1, "1 job")

    let dup = cron_add(c, "backup", 30)
    assert(is_err(dup), "duplicate job")

    assert(cron_should_run(c, "backup", 60) == 1, "should run at 60")
    let r2 = cron_mark_run(c, "backup", 60)
    assert(is_ok(r2), "mark run ok")
    c = unwrap(r2)
    assert(cron_total_runs(c) == 1, "1 run")

    assert(cron_should_run(c, "backup", 90) == 0, "not yet at 90")
    assert(cron_should_run(c, "backup", 120) == 1, "due at 120")

    let r3 = cron_disable(c, "backup")
    assert(is_ok(r3), "disable ok")
    c = unwrap(r3)
    assert(cron_should_run(c, "backup", 200) == 0, "disabled")

    let r4 = cron_enable(c, "backup")
    assert(is_ok(r4), "enable ok")
    c = unwrap(r4)
    assert(cron_should_run(c, "backup", 200) == 1, "enabled again")

    print("CRON-SCHEDULER KAT PASS")
