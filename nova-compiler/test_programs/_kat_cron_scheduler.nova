import forge_cron_scheduler

fn main()
    let c = cron_new()
    assert(cron_job_count(c) == 0, "no jobs")

    c = cron_add(c, "cleanup", 60)
    c = cron_add(c, "backup", 300)
    assert(cron_job_count(c) == 2, "2 jobs")

    let r1 = cron_tick(c, 60)
    c = r1["c"]
    assert(r1["triggered_count"] == 1, "cleanup triggered at t=60")
    assert(cron_total_executions(c) == 1, "1 execution")

    let r2 = cron_tick(c, 100)
    c = r2["c"]
    assert(r2["triggered_count"] == 0, "nothing at t=100")

    let r3 = cron_tick(c, 120)
    c = r3["c"]
    assert(r3["triggered_count"] == 1, "cleanup at t=120")
    assert(cron_job_runs(c, 1) == 2, "cleanup ran 2x")

    c = cron_disable(c, 1)
    let r4 = cron_tick(c, 300)
    c = r4["c"]
    assert(r4["triggered_count"] == 1, "backup at t=300")
    assert(cron_job_runs(c, 2) == 1, "backup ran 1x")

    c = cron_enable(c, 1)
    let r5 = cron_tick(c, 360)
    c = r5["c"]
    assert(r5["triggered_count"] == 1, "cleanup re-enabled at t=360")

    let r6 = cron_tick(c, 600)
    c = r6["c"]
    assert(r6["triggered_count"] == 2, "both at t=600")

    print("CRON-SCHEDULER KAT PASS")
