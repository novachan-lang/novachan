// forge_sse_test -- Server-Sent Events over the pub/sub hub. A client opens the SSE stream (/events); a
// publisher POSTs to /pub which calls sse_send(hub, body); the SSE client receives it as "data: <body>\n\n".
// Proves the hub powers SSE (server->client streaming over plain HTTP) just as it powers WebSocket rooms --
// the same NOVA channel fanning out across a different boundary.
import forge

fn _pub(req: Request, h)
    forge.sse_send(h, req.body)
    forge.resp_text(200, "ok")

fn _server(port: int)
    let a = forge.app()
    let h = forge.hub()
    forge.sse(a, "/events", h)
    forge.post(a, "/pub", fn(req) _pub(req, h))
    forge.serve_req_n(a, port, 3)

fn _post(port: int, body: string)
    let s = tcp_connect("127.0.0.1", port)
    tcp_send(s, "POST /pub HTTP/1.0\r\nContent-Length: " + str(len(body)) + "\r\n\r\n" + body)
    let r = tcp_recv(s)
    tcp_close(s)
    r

fn main()
    let port = 19384
    spawn fn()
        _server(port)
    sleep(300)

    // subscriber opens the SSE stream and reads the response headers
    let a = tcp_connect("127.0.0.1", port)
    tcp_send(a, "GET /events HTTP/1.1\r\nHost: localhost\r\n\r\n")
    let hdr = tcp_recv(a)
    assert(find(hdr, "200") >= 0 and find(hdr, "text/event-stream") >= 0, "SSE stream opened (200 text/event-stream)")
    print("PASS: SSE stream opened with the right headers")
    sleep(150)   // let the subscriber register with the hub before publishing

    // a publisher POSTs an event; the subscriber receives it
    _post(port, "hello sse")
    let ev = tcp_recv(a)
    assert(find(ev, "data: hello sse") >= 0, "subscriber received the published event as an SSE frame (got '" + ev + "')")
    print("PASS: event published via /pub streamed to the SSE subscriber through the hub")

    // clean shutdown: close the subscriber, then a 2nd publish unsticks its stream loop (send fails -> exits)
    tcp_close(a)
    _post(port, "bye")
    print("forge_sse_test passed")
