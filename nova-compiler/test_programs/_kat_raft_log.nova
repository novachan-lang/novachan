import forge_raft_log

fn main()
    let r = rl_new()
    r = rl_append(r, 1, "set x=1")
    r = rl_append(r, 1, "set y=2")
    r = rl_append(r, 2, "del x")
    assert(rl_entry_count(r) == 3, "3 entries")
    assert(rl_current_term(r) == 2, "term=2")
    assert(rl_commit_index(r) == -1, "nothing committed")

    let cmd = rl_get_command(r, 0)
    assert(is_ok(cmd), "cmd ok")
    assert(unwrap(cmd) == "set x=1", "cmd 0")

    let term = rl_get_term(r, 2)
    assert(is_ok(term), "term ok")
    assert(unwrap(term) == 2, "term 2")

    let c1 = rl_commit(r, 1)
    assert(is_ok(c1), "commit ok")
    r = unwrap(c1)
    assert(rl_commit_index(r) == 1, "commit=1")
    assert(rl_is_committed(r, 0) == 1, "0 committed")
    assert(rl_is_committed(r, 1) == 1, "1 committed")
    assert(rl_is_committed(r, 2) == 0, "2 not committed")

    let bad = rl_commit(r, 0)
    assert(is_err(bad), "already committed")

    let bad2 = rl_get_command(r, 10)
    assert(is_err(bad2), "out of range")

    print("RAFT-LOG KAT PASS")
