// KAT for std/physics/projectile
// Tests: deg_to_rad, proj_range, proj_max_height, proj_time_of_flight
import std/physics/projectile

fn approx(a, b)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    let result = d < 0.05
    result

fn approx_tight(a, b)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    let result = d < 0.0001
    result

fn main()
    // KAT 1: deg_to_rad(180.0) == pi ~ 3.14159
    let rad180 = deg_to_rad(180.0)
    let lo1 = 3.14159 - 0.0001
    let hi1 = 3.14159 + 0.0001
    if rad180 < lo1
        print("FAIL projectile deg_to_rad(180): too small got=" + str(rad180))
        exit(1)
    if rad180 > hi1
        print("FAIL projectile deg_to_rad(180): too large got=" + str(rad180))
        exit(1)

    // KAT 2: deg_to_rad(90.0) == pi/2 ~ 1.5708
    let rad90 = deg_to_rad(90.0)
    let lo2 = 1.5708 - 0.0001
    let hi2 = 1.5708 + 0.0001
    if rad90 < lo2
        print("FAIL projectile deg_to_rad(90): too small got=" + str(rad90))
        exit(1)
    if rad90 > hi2
        print("FAIL projectile deg_to_rad(90): too large got=" + str(rad90))
        exit(1)

    // KAT 3: proj_range(10.0, 45.0) == 100/9.81 ~ 10.19
    // v^2 * sin(90deg) / g = 100 * 1.0 / 9.81
    let range45 = proj_range(10.0, 45.0)
    let ok3 = approx(range45, 10.19)
    if ok3 != true
        print("FAIL projectile proj_range(10,45): got=" + str(range45) + " want~10.19")
        exit(1)

    // KAT 4: proj_range(10.0, 30.0) < proj_range(10.0, 45.0)
    // 45 deg gives max range
    let range30 = proj_range(10.0, 30.0)
    if range30 > range45
        print("FAIL projectile range45 should be max: range30=" + str(range30) + " range45=" + str(range45))
        exit(1)

    // KAT 5: proj_max_height at 90deg > max_height at 45deg
    let h90 = proj_max_height(10.0, 90.0)
    let h45 = proj_max_height(10.0, 45.0)
    if h90 < h45
        print("FAIL projectile h90 should exceed h45: h90=" + str(h90) + " h45=" + str(h45))
        exit(1)

    // KAT 6: proj_max_height(10.0, 90.0) == v^2/(2g) = 100/19.62 ~ 5.097
    let ok6 = approx(h90, 5.097)
    if ok6 != true
        print("FAIL projectile proj_max_height(10,90): got=" + str(h90) + " want~5.097")
        exit(1)

    // KAT 7: proj_time_of_flight(10.0, 90.0) = 2v/g ~ 2.039
    let tof90 = proj_time_of_flight(10.0, 90.0)
    let ok7 = approx(tof90, 2.039)
    if ok7 != true
        print("FAIL projectile proj_time_of_flight(10,90): got=" + str(tof90) + " want~2.039")
        exit(1)

    // KAT 8: proj_time_of_flight(10.0, 45.0) > 0
    let tof45 = proj_time_of_flight(10.0, 45.0)
    if tof45 < 0.0
        print("FAIL projectile time_of_flight negative: got=" + str(tof45))
        exit(1)

    print("PASS _projectile_test")
