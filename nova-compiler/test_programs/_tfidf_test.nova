// KAT test for std/text/tfidf
// corpus = [["a","b","a"], ["b","c"], ["a","c","c"]]
// N = 3 docs
// Hand-computed values:
//   tf("a" in doc0) = 2/3 = 0.6667
//   tf("z" in doc0) = 0/3 = 0.0
//   tf("c" in doc1) = 1/2 = 0.5
//   df("b") = 2 (doc0,doc1)  => idf = ln(3/2) = 0.4055
//   df("c") = 2 (doc1,doc2)  => idf = ln(3/2) = 0.4055
//   tfidf(corpus,1,"c") = 0.5 * 0.4055 = 0.2027
//   For idf = ln(3/1) = 1.0986: use tiny corpus [["x"],["y"],["z"]], term "x" -> df=1
//   tf_vector(corpus,0) must contain key "a"

import std/text/tfidf

fn ckf(label, got, expected, eps)
    let diff = got - expected
    if diff < 0.0
        diff = 0.0 - diff
    if diff > eps
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn main()
    let doc0 = ["a", "b", "a"]
    let doc1 = ["b", "c"]
    let doc2 = ["a", "c", "c"]
    let corpus = [doc0, doc1, doc2]

    // KAT 1: tf_term_freq — "a" appears twice in 3-token doc0 = 0.6667
    let tf_a = tf_term_freq(doc0, "a")
    ckf("tf_a", tf_a, 0.6667, 0.001)

    // KAT 2: tf_term_freq — absent term returns 0.0
    let tf_z = tf_term_freq(doc0, "z")
    ckf("tf_z", tf_z, 0.0, 0.001)

    // KAT 3: tf_idf_raw — "b" appears in doc0 and doc1, df=2
    //   idf = ln(3/2) = 0.4055
    let idf_b = tf_idf_raw(corpus, "b")
    ckf("idf_b", idf_b, 0.4055, 0.001)

    // KAT 4: idf for term in exactly 1 doc = ln(3/1) = 1.0986
    //   Use separate corpus where "x" appears only in first doc
    let cx = [["x", "y"], ["y", "z"], ["z", "w"]]
    let idf_x = tf_idf_raw(cx, "x")
    ckf("idf_x_1doc", idf_x, 1.0986, 0.001)

    // KAT 5: tf_tfidf(corpus, 1, "c")
    //   doc1=["b","c"], tf("c")=0.5, df("c")=2 (doc1,doc2), idf=ln(3/2)=0.4055
    //   tfidf = 0.5 * 0.4055 = 0.2027
    let tfidf_c1 = tf_tfidf(corpus, 1, "c")
    ckf("tfidf_c_doc1", tfidf_c1, 0.2027, 0.001)

    // KAT 6: tf_vector(corpus, 0) must contain key "a" with correct score
    //   doc0 terms: "a", "b"
    //   tfidf("a") = tf(2/3) * idf(ln(3/2)) = 0.6667 * 0.4055 = 0.2703
    let vec0 = tf_vector(corpus, 0)
    if contains(vec0, "a") == 0
        print("FAIL vec0_has_a: key 'a' missing from tf_vector result")
        exit(1)
    let vec_a = vec0["a"]
    ckf("vec0_a_score", vec_a, 0.2703, 0.001)

    // KAT 7: tf_idf_raw for term in all docs returns 0.0 (idf=ln(1)=0)
    //   corpus2 where "q" appears in all 3 docs
    let corpus2 = [["q", "r"], ["q", "s"], ["q", "t"]]
    let idf_q = tf_idf_raw(corpus2, "q")
    ckf("idf_q_all_docs", idf_q, 0.0, 0.001)

    // KAT 8: tf_term_freq on empty doc returns 0.0
    let empty_doc = []
    let tf_empty = tf_term_freq(empty_doc, "a")
    ckf("tf_empty_doc", tf_empty, 0.0, 0.001)

    print("_tfidf_test passed")
