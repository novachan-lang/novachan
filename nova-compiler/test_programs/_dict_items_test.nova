fn main()
    let d = {"name": "NOVA", "version": "1.0", "year": "2026"}
    let it = items(d)
    print(it)
    
    for pair in items(d)
        let k = pair[0]
        let v = pair[1]
        print(str(k) + " => " + str(v))
    
    print("items count: " + str(len(items(d))))
    print("dict_items_test: all passed")
