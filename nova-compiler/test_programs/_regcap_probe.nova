// KAT for regex_captures — numbered groups, alternation (non-participating -> ""), nesting (pre-order),
// and backtrack-restore (greedy a+ must give back a char to the next group, and the trail must restore
// group1's save). Char classes instead of \d/\w to avoid string-escape ambiguity.
fn _eq(label: string, got: any, want: any)
    if len(got) != len(want)
        print("FAIL " + label + ": len " + str(len(got)) + " != " + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL " + label + " [" + str(i) + "]: '" + got[i] + "' != '" + want[i] + "'")
            exit(1)
        i = i + 1
    print("ok " + label)

fn main()
    _eq("date",      regex_captures("2026-07-12", "([0-9]+)-([0-9]+)-([0-9]+)"), ["2026", "07", "12"])
    _eq("kv",        regex_captures("key=value", "([a-z]+)=([a-z]+)"), ["key", "value"])
    _eq("nomatch",   regex_captures("no digits", "([0-9]+)"), [])
    _eq("mixed",     regex_captures("abc123", "([a-z]+)([0-9]+)"), ["abc", "123"])
    _eq("alt",       regex_captures("cat", "(cat)|(dog)"), ["cat", ""])
    _eq("nested",    regex_captures("2026", "(([0-9][0-9])([0-9][0-9]))"), ["2026", "20", "26"])
    _eq("backtrack", regex_captures("aaa", "(a+)(a)"), ["aa", "a"])

    // named captures -> dict {name: substring}
    let m = regex_named_captures("2026-07-12", "(?<year>[0-9]+)-(?<month>[0-9]+)-(?<day>[0-9]+)")
    if m["year"] != "2026" or m["month"] != "07" or m["day"] != "12"
        print("FAIL named date: " + m["year"] + "/" + m["month"] + "/" + m["day"])
        exit(1)
    print("ok named-date")
    // mix of named + unnamed: only named groups appear in the dict
    let m2 = regex_named_captures("key=value", "(?<k>[a-z]+)=([a-z]+)")
    if m2["k"] != "key"
        print("FAIL named-mixed: " + m2["k"])
        exit(1)
    print("ok named-mixed")

    print("regex_captures + regex_named_captures: 9 KATs PASS")
