// REGRESSION: a module-level `let` with a COMPUTED initializer must not read back as 0.
//
// inline_module_consts propagated only bare-literal initializers, and the baking path
// (_is_module_state_init) covers only list/dict/channel(), so a scalar EXPRESSION fell
// through both. The identifier survived to codegen as a slot_load, and top-level statements
// execute in nova_main whose locals the user's `main` cannot see -> 0. Silent, no warning,
// on an entirely ordinary declaration. Even `24000000 / 8` (no identifiers) was 0.
//
// Found while building the parallel scaling benchmark: every worker got PER = 0, so the
// benchmark "ran" in 60ms doing nothing and its checksum was just the sum of the seeds.
// A perf number measured against a silently-empty loop is worse than no number at all.

let A = 8
let B = 24000000
let DIV = B / A
let ADD = B + A
let SUB = B - A
let MUL = A * 3
let LIT = 24000000 / 8
let MOD = B % 7
let CHAIN = DIV / 2

fn main()
    assert(A == 8, "bare literal")
    assert(B == 24000000, "bare literal large")
    assert(DIV == 3000000, "div of two module lets")
    assert(ADD == 24000008, "add")
    assert(SUB == 23999992, "sub")
    assert(MUL == 24, "mul by literal")
    assert(LIT == 3000000, "pure-literal expression (no identifiers)")
    assert(MOD == 24000000 % 7, "mod")
    assert(CHAIN == 1500000, "chained: depends on another computed let")
    // The same expression evaluated locally always worked; keep it as a control.
    let local_div = B / A
    assert(local_div == 3000000, "local control")
    print("MODLET_EXPR_OK")
