// Allocation-heavy workload: measures the cycle detector's OFF-path cost, which must be
// ~zero (one predicted compare on a cached global per alloc/free).
// Every value derives from time_ms() so nothing folds away.
fn main()
    let seed = time_ms() % 5 + 1
    let t0 = time_ms()
    let acc = 0
    let i = 0
    while i < 1500000
        let d = {"a": i, "b": i + seed}
        let l = [i, i + 1, i + 2]
        acc = acc + d["a"] + l[2]
        i = i + 1
    let el = time_ms() - t0
    print("allocbench ms=" + str(el) + " acc=" + str(acc))
