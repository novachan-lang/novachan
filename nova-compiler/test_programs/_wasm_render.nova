// WASM frontend RENDER-PATH proof: a NOVA fn BUILDS a string in the wasm value-model (concat) and hands it
// across the wasm import "channel" to the JS host (host_emit), which reads the built bytes out of wasm linear
// memory. This is the DOM "render" path -- compute the text/markup in NOVA, pass it to the browser host.
extern fn host_emit(s: string)
fn render()
    let name = "NOVA"
    let msg = "Hello from " + name + "!"
    unsafe host_emit(msg)
fn main()
    render()
