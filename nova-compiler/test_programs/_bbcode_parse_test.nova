import std/text/bbcode_lex
import std/text/bbcode_parse

// Test-local canonical renderer: walks a parsed AST back into a compact,
// unambiguous string ("<name:attr>...</name>" for tag nodes, verbatim for
// text nodes) so a whole tree can be checked with one string comparison.
fn _render(nodes: list) -> string
    let out = ""
    let n = len(nodes)
    let i = 0
    while i < n
        let node = nodes[i]
        if node[0] == "text"
            out = out + node[1]
        else
            let name = node[1]
            let attr = node[2]
            let kids = node[3]
            out = out + "<" + name + ":" + attr + ">" + _render(kids) + "</" + name + ">"
        i = i + 1
    out

fn _parse_str(input: string) -> list
    bpar_parse(blex_tokenize(input))

fn main()
    // KAT 1: simple matched pair
    let r1 = _render(_parse_str("[b]bold[/b]"))
    if r1 != "<b:>bold</b>"
        print("FAIL bbcode_parse KAT1: got [" + r1 + "]")
        exit(1)

    // KAT 2: nested tags
    let r2 = _render(_parse_str("[b][i]x[/i][/b]"))
    if r2 != "<b:><i:>x</i></b>"
        print("FAIL bbcode_parse KAT2: got [" + r2 + "]")
        exit(1)

    // KAT 3: attribute is carried onto the tag node
    let r3 = _render(_parse_str("[url=http://x]link[/url]"))
    if r3 != "<url:http://x>link</url>"
        print("FAIL bbcode_parse KAT3: got [" + r3 + "]")
        exit(1)

    // KAT 4: top-level text around a tag
    let r4 = _render(_parse_str("hi [b]there[/b] friend"))
    if r4 != "hi <b:>there</b> friend"
        print("FAIL bbcode_parse KAT4: got [" + r4 + "]")
        exit(1)

    // KAT 5: an open tag that is NEVER closed degrades to literal text --
    // its bracket text is reconstructed and its "children" (everything
    // after it) is promoted back to plain top-level text.
    let r5 = _render(_parse_str("[b]oops"))
    if r5 != "[b]oops"
        print("FAIL bbcode_parse KAT5: got [" + r5 + "]")
        exit(1)

    // KAT 6: a stray close tag with no matching open anywhere -- emitted
    // as literal text, surrounding text is untouched.
    let r6 = _render(_parse_str("hello[/b]world"))
    if r6 != "hello[/b]world"
        print("FAIL bbcode_parse KAT6: got [" + r6 + "]")
        exit(1)

    // KAT 7: misnested tags ("[b][i]x[/b][/i]") -- the inner [i] frame is
    // never properly closed (the first close we hit is [/b], which matches
    // the OUTER frame), so it is unwound: "[i]" reappears as literal text
    // and its child "x" is promoted into "b"'s children; the trailing
    // "[/i]" is then a stray close with nothing left on the stack.
    let r7 = _render(_parse_str("[b][i]x[/b][/i]"))
    if r7 != "<b:>[i]x</b>[/i]"
        print("FAIL bbcode_parse KAT7: got [" + r7 + "]")
        exit(1)

    // KAT 8: close-tag matching is CASE-INSENSITIVE, but the node keeps the
    // opening tag's original source casing.
    let r8 = _render(_parse_str("[B]hi[/b]"))
    if r8 != "<B:>hi</B>"
        print("FAIL bbcode_parse KAT8: got [" + r8 + "]")
        exit(1)

    // KAT 9: a tag with no content at all
    let r9 = _render(_parse_str("[b][/b]"))
    if r9 != "<b:></b>"
        print("FAIL bbcode_parse KAT9: got [" + r9 + "]")
        exit(1)

    // KAT 10: an empty token list parses to an empty AST
    let a10 = bpar_parse([])
    if len(a10) != 0
        print("FAIL bbcode_parse KAT10: got len " + str(len(a10)))
        exit(1)

    print("PASS _bbcode_parse_test")
