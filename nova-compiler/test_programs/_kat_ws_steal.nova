// KAT: proves the work-stealing deque actually STEALS, not just round-robins.
// ws_init(4) forces a 4-worker pool; the tasks are deliberately uneven in length
// so idle workers must take from a busy worker's deque. steals > 0 is the proof.
let ch = channel()

fn light()
    send(ch, 1)

fn heavy()
    let s = 0
    let i = 0
    while i < 200000
        s = s + i
        i = i + 1
    send(ch, 1)

fn main()
    ws_init(4)
    let n = 64
    let i = 0
    while i < n
        if i % 8 == 0
            ws_spawn(heavy)
        else
            ws_spawn(light)
        i = i + 1

    let got = 0
    while got < n
        got = got + recv(ch)

    let steals = ws_steal_count()
    print("completed=" + str(got))
    print("steals=" + str(steals))
    if got == n and steals > 0
        print("KAT ws_steal PASS")
    else
        print("KAT ws_steal FAIL")
