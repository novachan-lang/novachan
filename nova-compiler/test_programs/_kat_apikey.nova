import forge_apikey

fn main()
    let key1 = apikey_generate("sk")
    assert(starts_with(key1, "sk_"), "generated key starts with sk_")
    assert(len(key1) > 5, "generated key is a reasonable length")

    let store = apikey_store_new()
    assert(len(store) == 0, "new store is empty")

    store = apikey_register(store, key1, {"owner": "alice"})
    assert(apikey_valid(store, key1), "registered key is valid")
    assert(not apikey_valid(store, "fake"), "unregistered key is invalid")

    let meta = apikey_meta(store, key1)
    assert(meta["owner"] == "alice", "stored metadata round-trips")

    let missing_meta = apikey_meta(store, "fake")
    assert(len(missing_meta) == 0, "metadata for unknown key is empty")

    assert(apikey_extract("Bearer {key1}") == key1, "extract strips the Bearer prefix")
    assert(apikey_extract("raw") == "raw", "extract passes through a value with no prefix")

    store = apikey_revoke(store, key1)
    assert(not apikey_valid(store, key1), "revoked key is no longer valid")
    assert(len(store) == 0, "store is empty after revoking its only key")

    print("APIKEY KAT PASS")
