fn double(x: int) -> int
    x * 2

fn add_one(x: int) -> int
    x + 1

fn negate(x: int) -> int
    0 - x

fn main()
    let text = "hello world"
    let words = text
        .split(" ")
    assert_eq(words, ["hello", "world"])

    let result = "NOVA Language"
        .lower()
        .split(" ")
    assert_eq(result, ["nova", "language"])

    let chain3 = "  Hello World  "
        .trim()
        .lower()
        .split(" ")
    assert_eq(chain3, ["hello", "world"])

    let piped = 5
        |> double
        |> add_one
    assert_eq(piped, 11)

    let pipe3 = 10
        |> double
        |> double
        |> add_one
    assert_eq(pipe3, 41)

    let mixed = [1, 2, 3]
    let mlen = mixed
        .len()
    assert_eq(mlen, 3)

    let a = 42
    let b = a + 1
    assert_eq(b, 43)

    let x = "test"
    let y = x.upper()
    assert_eq(y, "TEST")

    print("chain_probe: all passed")
