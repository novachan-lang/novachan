// #19 oracle: sleep deadlines folded into the netpoller select() must still honor the
// sleep(ms)>=ms duration guarantee and wake near the deadline (not over-wait), including
// when MULTIPLE sleep waiters coexist (exercises the new deadline-fold loop).
fn check(ms: int, hi: int) -> int
    let t0 = time_ms()
    sleep(ms)
    let dt = time_ms() - t0
    assert(dt >= ms, "sleep honored duration (not early)")
    assert(dt < hi, "woke near deadline (not grossly over-waited)")
    1

fn main()
    // sequential sleeps: duration honored + not over-waited (loose upper for CI contention)
    assert(check(500, 1300) == 1, "500ms")
    assert(check(100, 900) == 1, "100ms")
    // concurrent: a spawned sleeper runs WHILE main sleeps -> 2+ simultaneous sleep waiters,
    // exercising Edit A's loop folding the soonest deadline into select().
    spawn fn()
        check(300, 1100)
    assert(check(350, 1150) == 1, "350ms with a concurrent 300ms sleeper")
    sleep(200)   // ensure the spawned sleeper has finished its assert
    print("fair_sleep_io: all passed")
