import std/sketch/countingbloom

fn check_true(label: string, got: bool)
    if got == false
        print("FAIL " + label + ": got=false want=true")
        exit(1)

fn check_false(label: string, got: bool)
    if got == true
        print("FAIL " + label + ": got=true want=false")
        exit(1)

fn ge(label: string, got: int, floor: int)
    if got < floor
        print("FAIL " + label + ": got=" + str(got) + " want>=" + str(floor))
        exit(1)

fn eq(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // --- KAT 1: basic structure ---
    let state = cbf_new(128, 3)
    eq("size", state["size"], 128)
    eq("k", state["k"], 3)
    let counts0 = state["counts"]
    eq("len_counts", len(counts0), 128)
    eq("count0_init", counts0[0], 0)

    // --- KAT 2: cbf_add 'a' and 'b'; both must be found (NO false negatives) ---
    cbf_add(state, "a")
    cbf_add(state, "b")
    check_true("contains_a", cbf_contains(state, "a"))
    check_true("contains_b", cbf_contains(state, "b"))

    // --- KAT 3: cbf_delete 'a'; 'a' must now be absent; 'b' still present ---
    cbf_delete(state, "a")
    check_false("a_gone", cbf_contains(state, "a"))
    check_true("b_after_del_a", cbf_contains(state, "b"))

    // --- KAT 4: add 'a' twice; cbf_count_estimate >= 2 ---
    cbf_add(state, "a")
    cbf_add(state, "a")
    check_true("a_back", cbf_contains(state, "a"))
    ge("a_count_ge2", cbf_count_estimate(state, "a"), 2)

    // --- KAT 5: cbf_delete does not go below 0 for an unseen item ---
    let fresh = cbf_new(64, 3)
    cbf_delete(fresh, "never_added")
    let counts_f = fresh["counts"]
    // Verify all counters are still >= 0 (no underflow)
    let i = 0
    let any_neg = 0
    while i < 64
        if counts_f[i] < 0
            any_neg = 1
        i = i + 1
    eq("no_underflow", any_neg, 0)

    // --- KAT 6: cbf_clear resets everything ---
    let s2 = cbf_new(32, 2)
    cbf_add(s2, "hello")
    cbf_add(s2, "world")
    check_true("before_clear_hello", cbf_contains(s2, "hello"))
    cbf_clear(s2)
    check_false("after_clear_hello", cbf_contains(s2, "hello"))
    check_false("after_clear_world", cbf_contains(s2, "world"))

    // --- KAT 7: cbf_hashes returns k indices, each in [0, size) ---
    let idxs = cbf_hashes("test_item", 3, 128)
    eq("hashes_len", len(idxs), 3)
    let vi = 0
    while vi < 3
        let idx = idxs[vi]
        if idx < 0
            print("FAIL hash_nonneg: idx=" + str(idx))
            exit(1)
        if idx >= 128
            print("FAIL hash_inrange: idx=" + str(idx))
            exit(1)
        vi = vi + 1

    // --- KAT 8: cbf_fill_ratio increases after adds ---
    let s3 = cbf_new(128, 3)
    // fill_ratio before any adds should be 0.0
    let r0 = cbf_fill_ratio(s3)
    if r0 > 0.0
        print("FAIL fill_ratio_init: got non-zero before any add")
        exit(1)
    cbf_add(s3, "hello")
    let r1 = cbf_fill_ratio(s3)
    if r1 <= 0.0
        print("FAIL fill_ratio_after_add: should be > 0")
        exit(1)

    // --- KAT 9: determinism — two identical filters behave identically ---
    let d1 = cbf_new(128, 3)
    let d2 = cbf_new(128, 3)
    cbf_add(d1, "apple")
    cbf_add(d2, "apple")
    let e1 = cbf_count_estimate(d1, "apple")
    let e2 = cbf_count_estimate(d2, "apple")
    eq("determinism", e1, e2)

    // --- KAT 10: large batch — add 100 items, all must be present (no false negatives) ---
    let s4 = cbf_new(512, 4)
    let j = 0
    while j < 100
        cbf_add(s4, "item" + str(j))
        j = j + 1
    let k = 0
    while k < 100
        check_true("batch_item" + str(k), cbf_contains(s4, "item" + str(k)))
        k = k + 1
    // delete all; none found after
    let m = 0
    while m < 100
        cbf_delete(s4, "item" + str(m))
        m = m + 1
    let n = 0
    while n < 100
        check_false("batch_del" + str(n), cbf_contains(s4, "item" + str(n)))
        n = n + 1

    print("PASS _countingbloom_test")

main()
