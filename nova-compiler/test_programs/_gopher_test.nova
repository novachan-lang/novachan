import std/net/gopher

fn main()
    let tab = chr(9)
    let crlf = chr(13) + chr(10)

    // ── KAT 1: gopher_item round-trip ────────────────────────────────────────
    let item1 = gopher_item("1", "Home", "/", "example.com", 70)
    let want1 = "1" + "Home" + tab + "/" + tab + "example.com" + tab + "70" + crlf
    if item1 != want1
        print("FAIL gopher item build: got [" + item1 + "] want [" + want1 + "]")
        exit(1)

    // ── KAT 2: gopher_parse_item on the item built above ─────────────────────
    let parsed = gopher_parse_item(item1)
    if parsed["type"] != "1"
        print("FAIL gopher parse type: got " + str(parsed["type"]) + " want 1")
        exit(1)
    if parsed["display"] != "Home"
        print("FAIL gopher parse display: got " + str(parsed["display"]) + " want Home")
        exit(1)
    if parsed["selector"] != "/"
        print("FAIL gopher parse selector: got " + str(parsed["selector"]) + " want /")
        exit(1)
    if parsed["host"] != "example.com"
        print("FAIL gopher parse host: got " + str(parsed["host"]) + " want example.com")
        exit(1)
    if parsed["port"] != 70
        print("FAIL gopher parse port: got " + str(parsed["port"]) + " want 70")
        exit(1)

    // ── KAT 3: round-trip (parse then rebuild must equal original) ────────────
    let rebuilt = gopher_item(str(parsed["type"]), str(parsed["display"]), str(parsed["selector"]), str(parsed["host"]), parsed["port"])
    if rebuilt != item1
        print("FAIL gopher round-trip: got [" + rebuilt + "] want [" + item1 + "]")
        exit(1)

    // ── KAT 4: gopher_menu ends with "." + CRLF ──────────────────────────────
    let items = []
    push(items, item1)
    let menu = gopher_menu(items)
    let sentinel = "." + crlf
    let mlen = len(menu)
    let slen = len(sentinel)
    let tail = slice(menu, mlen - slen, mlen)
    if tail != sentinel
        print("FAIL gopher menu sentinel: got [" + tail + "] want [" + sentinel + "]")
        exit(1)

    // menu must start with the item
    let mhead = slice(menu, 0, len(item1))
    if mhead != item1
        print("FAIL gopher menu head: got [" + mhead + "] want [" + item1 + "]")
        exit(1)

    // ── KAT 5: gopher_info produces type 'i' line ────────────────────────────
    let info = gopher_info("Hello Gopher")
    let want_info = "i" + "Hello Gopher" + tab + "" + tab + "error.host" + tab + "1" + crlf
    if info != want_info
        print("FAIL gopher info: got [" + info + "] want [" + want_info + "]")
        exit(1)

    // ── KAT 6: parse info line ───────────────────────────────────────────────
    let pi = gopher_parse_item(info)
    if pi["type"] != "i"
        print("FAIL gopher info parse type: got " + str(pi["type"]) + " want i")
        exit(1)
    if pi["display"] != "Hello Gopher"
        print("FAIL gopher info parse display: got " + str(pi["display"]) + " want Hello Gopher")
        exit(1)
    if pi["selector"] != ""
        print("FAIL gopher info parse selector: got [" + str(pi["selector"]) + "] want []")
        exit(1)
    if pi["host"] != "error.host"
        print("FAIL gopher info parse host: got " + str(pi["host"]) + " want error.host")
        exit(1)
    if pi["port"] != 1
        print("FAIL gopher info parse port: got " + str(pi["port"]) + " want 1")
        exit(1)

    // ── KAT 7: text file item (type "0") ─────────────────────────────────────
    let item0 = gopher_item("0", "README", "/README.txt", "gopher.floodgap.com", 70)
    let p0 = gopher_parse_item(item0)
    if p0["type"] != "0"
        print("FAIL gopher type0: got " + str(p0["type"]) + " want 0")
        exit(1)
    if p0["display"] != "README"
        print("FAIL gopher type0 display: got " + str(p0["display"]) + " want README")
        exit(1)
    if p0["selector"] != "/README.txt"
        print("FAIL gopher type0 selector: got " + str(p0["selector"]) + " want /README.txt")
        exit(1)
    if p0["host"] != "gopher.floodgap.com"
        print("FAIL gopher type0 host: got " + str(p0["host"]) + " want gopher.floodgap.com")
        exit(1)
    if p0["port"] != 70
        print("FAIL gopher type0 port: got " + str(p0["port"]) + " want 70")
        exit(1)

    // ── KAT 8: search item (type "7") ────────────────────────────────────────
    let item7 = gopher_item("7", "Search", "/search", "gopher.example.org", 7070)
    let p7 = gopher_parse_item(item7)
    if p7["type"] != "7"
        print("FAIL gopher type7: got " + str(p7["type"]) + " want 7")
        exit(1)
    if p7["port"] != 7070
        print("FAIL gopher type7 port: got " + str(p7["port"]) + " want 7070")
        exit(1)

    // ── KAT 9: malformed line (no tabs) returns zero-value port ──────────────
    let bad = gopher_parse_item("1BadLine")
    if bad["port"] != 0
        print("FAIL gopher malformed port: got " + str(bad["port"]) + " want 0")
        exit(1)
    if bad["type"] != "1"
        print("FAIL gopher malformed type: got " + str(bad["type"]) + " want 1")
        exit(1)

    // ── KAT 10: gopher_menu with multiple items ───────────────────────────────
    let mitems = []
    push(mitems, gopher_item("1", "Home", "/", "example.com", 70))
    push(mitems, gopher_info("Welcome!"))
    push(mitems, gopher_item("0", "About", "/about.txt", "example.com", 70))
    let mmenu = gopher_menu(mitems)
    let mmlen = len(mmenu)
    let mmtail = slice(mmenu, mmlen - slen, mmlen)
    if mmtail != sentinel
        print("FAIL gopher multi-menu sentinel: got [" + mmtail + "] want [" + sentinel + "]")
        exit(1)

    // ── KAT 11: parse line without CRLF (bare line) works ────────────────────
    let bare = "1" + "BareHome" + tab + "/" + tab + "bare.example.com" + tab + "70"
    let pb = gopher_parse_item(bare)
    if pb["display"] != "BareHome"
        print("FAIL gopher bare display: got " + str(pb["display"]) + " want BareHome")
        exit(1)
    if pb["host"] != "bare.example.com"
        print("FAIL gopher bare host: got " + str(pb["host"]) + " want bare.example.com")
        exit(1)
    if pb["port"] != 70
        print("FAIL gopher bare port: got " + str(pb["port"]) + " want 70")
        exit(1)

    // ── KAT 12: parse line with only LF (not full CRLF) ──────────────────────
    let lf_line = "1" + "LFHome" + tab + "/" + tab + "lf.example.com" + tab + "70" + chr(10)
    let plf = gopher_parse_item(lf_line)
    if plf["port"] != 70
        print("FAIL gopher lf-only port: got " + str(plf["port"]) + " want 70")
        exit(1)
    if plf["host"] != "lf.example.com"
        print("FAIL gopher lf-only host: got " + str(plf["host"]) + " want lf.example.com")
        exit(1)

    print("PASS _gopher_test")
