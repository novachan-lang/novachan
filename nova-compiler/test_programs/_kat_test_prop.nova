// KAT for forge_test_prop -- property-based testing (seeded deterministic generators + check ledger).
import forge_test_prop

fn main()
    // 1) tp_new seeds the state and starts the ledger empty.
    let s = tp_new(42)
    assert_eq(tp_current_seed(s), 42)
    assert_eq(tp_total_checks(s), 0)
    assert_eq(tp_pass_count(s), 0)
    assert_eq(tp_fail_count(s), 0)
    assert_eq(tp_failed_names(s), "")
    assert_eq(tp_all_passed(s), 0)

    // 2) tp_next_seed advances deterministically and is reproducible from the same starting seed.
    let s2 = tp_new(42)
    let n1a = tp_next_seed(s)
    let n1b = tp_next_seed(s2)
    assert_eq(n1a, n1b)
    assert_eq(tp_current_seed(s), n1a)

    // 3) tp_int_range: 500 draws all land in [10, 20], and the sequence is reproducible from the same seed.
    let rs = tp_new(7)
    let rs2 = tp_new(7)
    let i = 0
    let all_in_range = 1
    let seq_matches = 1
    while i < 500
        let vr = tp_int_range(rs, 10, 20)
        assert(is_ok(vr), "tp_int_range should succeed")
        let v = unwrap(vr)
        if v < 10 or v > 20
            all_in_range = 0
        let vr2 = tp_int_range(rs2, 10, 20)
        let v2 = unwrap(vr2)
        if v != v2
            seq_matches = 0
        i = i + 1
    assert_eq(all_in_range, 1)
    assert_eq(seq_matches, 1)

    // 3b) single-value range [5, 5] always yields 5.
    let rs3 = tp_new(99)
    let onlyr = tp_int_range(rs3, 5, 5)
    assert_eq(unwrap(onlyr), 5)

    // 3c) inverted range is rejected.
    let badr = tp_int_range(rs3, 20, 10)
    assert(is_err(badr), "tp_int_range should reject min_val > max_val")

    // 4) tp_bool: 200 draws are all 0 or 1, and not all the same value (sanity on the generator).
    let bs = tp_new(123)
    let j = 0
    let bools_valid = 1
    let saw_zero = 0
    let saw_one = 0
    while j < 200
        let b = tp_bool(bs)
        if b != 0 and b != 1
            bools_valid = 0
        if b == 0
            saw_zero = 1
        if b == 1
            saw_one = 1
        j = j + 1
    assert_eq(bools_valid, 1)
    assert_eq(saw_zero, 1)
    assert_eq(saw_one, 1)

    // 5) tp_string: non-empty, length within bound, and reproducible from the same seed.
    let ss = tp_new(55)
    let ss2 = tp_new(55)
    let str1r = tp_string(ss, 12)
    assert(is_ok(str1r), "tp_string should succeed")
    let str1 = unwrap(str1r)
    assert(len(str1) >= 1, "tp_string must be non-empty")
    assert(len(str1) <= 12, "tp_string must respect max_len")
    let str2 = unwrap(tp_string(ss2, 12))
    assert_eq(str1, str2)

    // 5b) max_len <= 0 is rejected.
    let badstr = tp_string(ss, 0)
    assert(is_err(badstr), "tp_string should reject max_len <= 0")

    // 6) tp_one_of: always returns one of the listed options.
    let os = tp_new(321)
    let opt_ok = 1
    let k = 0
    while k < 100
        let pickr = tp_one_of(os, "red,green,blue,yellow")
        assert(is_ok(pickr), "tp_one_of should succeed")
        let pick = unwrap(pickr)
        if pick != "red" and pick != "green" and pick != "blue" and pick != "yellow"
            opt_ok = 0
        k = k + 1
    assert_eq(opt_ok, 1)

    // 6b) empty option list is rejected.
    let emptyr = tp_one_of(os, "")
    assert(is_err(emptyr), "tp_one_of should reject an empty option list")

    // 7) tp_check ledger: record 3 passes and 2 fails, verify counts, names and rate.
    let cs = tp_new(1)
    tp_check(cs, "check_a", 1)
    tp_check(cs, "check_b", 0)
    tp_check(cs, "check_c", 1)
    tp_check(cs, "check_d", 0)
    tp_check(cs, "check_e", 1)
    assert_eq(tp_total_checks(cs), 5)
    assert_eq(tp_pass_count(cs), 3)
    assert_eq(tp_fail_count(cs), 2)
    assert_eq(tp_failed_names(cs), "check_b,check_d")
    assert_eq(tp_all_passed(cs), 0)

    let rater = tp_pass_rate(cs)
    assert(is_ok(rater), "tp_pass_rate should succeed once checks exist")
    assert_eq(unwrap(rater), 60)

    // 8) all-passed state: pass_rate 100, all_passed 1, no failed names.
    let ps = tp_new(2)
    tp_check(ps, "p1", 1)
    tp_check(ps, "p2", 1)
    assert_eq(tp_all_passed(ps), 1)
    assert_eq(tp_failed_names(ps), "")
    assert_eq(unwrap(tp_pass_rate(ps)), 100)

    // 9) pass_rate with no checks recorded yet is an error.
    let es = tp_new(3)
    let emptyrate = tp_pass_rate(es)
    assert(is_err(emptyrate), "tp_pass_rate should reject an empty ledger")

    print("TEST-PROP KAT PASS")
