import forge_dedup_store

fn main()
    let d = dd_new()
    let r1 = dd_check_and_add(d, "abc")
    assert(is_ok(r1), "first add ok")
    d = unwrap(r1)
    let r2 = dd_check_and_add(d, "def")
    assert(is_ok(r2), "second add ok")
    d = unwrap(r2)
    assert(dd_count(d) == 2, "2 unique")

    let r3 = dd_check_and_add(d, "abc")
    assert(is_err(r3), "duplicate detected")
    assert(dd_dup_count(d) == 1, "1 dup")
    assert(dd_is_duplicate(d, "abc") == 1, "abc is dup")
    assert(dd_is_duplicate(d, "xyz") == 0, "xyz not dup")
    assert(dd_dup_rate(d) == 33, "33% dup rate")

    print("DEDUP-STORE KAT PASS")
