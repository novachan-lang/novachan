import forge_bit_set

fn main()
    let b = bs_new()
    b = bs_set(b, 0)
    b = bs_set(b, 5)
    b = bs_set(b, 31)
    b = bs_set(b, 32)
    assert(bs_count(b) == 4, "4 bits set")

    assert(bs_test(b, 0) == 1, "bit 0 set")
    assert(bs_test(b, 5) == 1, "bit 5 set")
    assert(bs_test(b, 31) == 1, "bit 31 set")
    assert(bs_test(b, 32) == 1, "bit 32 set")
    assert(bs_test(b, 1) == 0, "bit 1 not set")
    assert(bs_test(b, 100) == 0, "bit 100 not set")

    b = bs_set(b, 5)
    assert(bs_count(b) == 4, "no dup")

    b = bs_clear(b, 5)
    assert(bs_test(b, 5) == 0, "bit 5 cleared")
    assert(bs_count(b) == 3, "3 after clear")

    b = bs_clear(b, 999)
    assert(bs_count(b) == 3, "clear absent = noop")

    print("BIT-SET KAT PASS")
