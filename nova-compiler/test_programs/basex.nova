// ============================================================================
// NOVA Standard Library — basex module
// ============================================================================
// Base conversion + integer-string validation. Pure NOVA, no builtins beyond
// the documented surface (string indexing, ord, len, slice, +).
//
// Closes:
//   cat-11 base conversion        -> to_base / from_base
//   cat-17 number-string validation -> is_digit_str / is_int_str
//
// Digit alphabet is a single lookup string indexed by value. A digit CHAR is
// mapped back to its value by scanning that same lookup, so the two directions
// share ONE source of truth (no parallel ord-range tables to drift out of sync).
//
// Public API:
//   to_base(n, base) -> str     (n >= 0, 2 <= base <= 36, lowercase digits)
//   from_base(s, base) -> int   (inverse; accepts lower OR upper case letters)
//   is_digit_str(s) -> int      (1 if non-empty and every char is 0-9, else 0)
//   is_int_str(s) -> int        (1 if optional +/- then >=1 digit, nothing else)

// The canonical digit alphabet. Position i (0..35) is the digit whose value is
// i: '0'..'9' then 'a'..'z'. Used in BOTH directions.
fn _digits() -> str
    "0123456789abcdefghijklmnopqrstuvwxyz"

// Map a single digit value (0..35) to its lowercase character by indexing the
// alphabet. Returns the 1-byte string for that digit.
fn _digit_char(v) -> str
    let alpha = _digits()
    alpha[v]

// Map a single digit CHARACTER (one byte) to its value 0..35 using ord ranges.
// Accepts '0'-'9', 'a'-'z' and 'A'-'Z' (case-insensitive letters). Returns -1
// for any byte that is not a base-36 digit, so callers can reject bad input.
fn _char_value(c) -> int
    let b = ord(c)
    // '0'..'9'  -> 0..9
    if b >= 48 and b <= 57
        return b - 48
    // 'a'..'z'  -> 10..35
    if b >= 97 and b <= 122
        return b - 97 + 10
    // 'A'..'Z'  -> 10..35
    if b >= 65 and b <= 90
        return b - 65 + 10
    -1

// ── to_base ──────────────────────────────────────────────────────────────────
// Convert a non-negative integer n to its string form in the given base
// (2..36). to_base(0, b) == "0". Digits are produced least-significant first by
// repeated division, then the order is corrected by prepending each new digit
// to the front of the accumulator (so the most-significant digit ends up first).
fn to_base(n, base) -> str
    // Boundary: zero is the single digit "0" in every base.
    if n == 0
        return "0"
    let out = ""
    let v = n
    while v > 0
        let d = v - (v / base) * base    // v mod base, base > 0 so this is 0..base-1
        // prepend: most-significant digit emerges last, so newest goes in front
        out = _digit_char(d) + out
        v = v / base                     // integer division truncates toward zero
    out

// ── from_base ────────────────────────────────────────────────────────────────
// Parse string s as an integer in the given base. Horner's method:
//   acc = acc * base + value(char)
// Accepts lowercase OR uppercase letters. Characters outside the base's valid
// range (value < 0 or value >= base) are skipped defensively, but well-formed
// input — the documented contract — uses every character.
fn from_base(s, base) -> int
    let acc = 0
    let i = 0
    while i < len(s)
        let val = _char_value(s[i])
        if val >= 0 and val < base
            acc = acc * base + val
        i = i + 1
    acc

// ── is_digit_str ─────────────────────────────────────────────────────────────
// 1 when s is NON-EMPTY and every byte is an ASCII digit '0'..'9'; else 0.
// Leading zeros are fine ("007" is all digits). Empty string -> 0.
fn is_digit_str(s) -> int
    if len(s) == 0
        return 0
    let i = 0
    while i < len(s)
        let b = ord(s[i])
        if b < 48 or b > 57
            return 0
        i = i + 1
    1

// ── is_int_str ───────────────────────────────────────────────────────────────
// 1 when s is an optional single leading sign ('+' or '-') followed by ONE OR
// MORE ASCII digits and nothing else; else 0. Rejects "", "-", "+", "12a",
// "1.0", " 12", "+-1". A bare sign with no digits is invalid.
fn is_int_str(s) -> int
    let n = len(s)
    if n == 0
        return 0
    let start = 0
    let first = ord(s[0])
    // optional leading sign consumes index 0
    if first == 43 or first == 45     // '+' == 43, '-' == 45
        start = 1
    // a sign with no following digits is not an integer
    if start >= n
        return 0
    let i = start
    while i < n
        let b = ord(s[i])
        if b < 48 or b > 57
            return 0
        i = i + 1
    1

// ── tests ────────────────────────────────────────────────────────────────────
fn main()
    // ---- _char_value / _digit_char internals ----
    assert_eq(_digit_char(0), "0")
    assert_eq(_digit_char(9), "9")
    assert_eq(_digit_char(10), "a")
    assert_eq(_digit_char(35), "z")
    assert_eq(_char_value("0"), 0)
    assert_eq(_char_value("9"), 9)
    assert_eq(_char_value("a"), 10)
    assert_eq(_char_value("z"), 35)
    assert_eq(_char_value("A"), 10)
    assert_eq(_char_value("Z"), 35)
    assert_eq(_char_value("F"), 15)
    assert_eq(_char_value("f"), 15)
    assert_eq(_char_value("@"), -1)   // not a digit byte
    assert_eq(_char_value(" "), -1)

    // ---- to_base: spec examples ----
    assert_eq(to_base(255, 16), "ff")
    assert_eq(to_base(10, 2), "1010")
    assert_eq(to_base(0, 16), "0")
    // ---- to_base: boundaries & more ----
    assert_eq(to_base(0, 2), "0")
    assert_eq(to_base(0, 36), "0")
    assert_eq(to_base(1, 2), "1")
    assert_eq(to_base(1, 16), "1")
    assert_eq(to_base(2, 2), "10")
    assert_eq(to_base(7, 2), "111")
    assert_eq(to_base(8, 8), "10")
    assert_eq(to_base(255, 2), "11111111")
    assert_eq(to_base(255, 10), "255")
    assert_eq(to_base(256, 16), "100")
    assert_eq(to_base(4095, 16), "fff")
    assert_eq(to_base(35, 36), "z")
    assert_eq(to_base(36, 36), "10")
    assert_eq(to_base(1295, 36), "zz")          // 35*36 + 35
    assert_eq(to_base(12345, 10), "12345")

    // ---- from_base: spec examples ----
    assert_eq(from_base("ff", 16), 255)
    assert_eq(from_base("1010", 2), 10)
    // ---- from_base: boundaries, case-insensitivity ----
    assert_eq(from_base("0", 16), 0)
    assert_eq(from_base("0", 2), 0)
    assert_eq(from_base("FF", 16), 255)         // uppercase accepted
    assert_eq(from_base("Ff", 16), 255)         // mixed case accepted
    assert_eq(from_base("100", 16), 256)
    assert_eq(from_base("fff", 16), 4095)
    assert_eq(from_base("11111111", 2), 255)
    assert_eq(from_base("255", 10), 255)
    assert_eq(from_base("z", 36), 35)
    assert_eq(from_base("Z", 36), 35)
    assert_eq(from_base("zz", 36), 1295)
    assert_eq(from_base("10", 8), 8)
    assert_eq(from_base("007", 10), 7)          // leading zeros fine

    // ---- round-trips across many bases ----
    assert_eq(from_base(to_base(12345, 36), 36), 12345)
    assert_eq(from_base(to_base(12345, 2), 2), 12345)
    assert_eq(from_base(to_base(12345, 16), 16), 12345)
    assert_eq(from_base(to_base(0, 16), 16), 0)
    assert_eq(from_base(to_base(1, 2), 2), 1)
    assert_eq(from_base(to_base(1000000, 36), 36), 1000000)
    assert_eq(from_base(to_base(65535, 16), 16), 65535)
    // round-trip every value 0..200 through bases 2, 8, 16, 36
    let k = 0
    while k <= 200
        assert_eq(from_base(to_base(k, 2), 2), k)
        assert_eq(from_base(to_base(k, 8), 8), k)
        assert_eq(from_base(to_base(k, 16), 16), k)
        assert_eq(from_base(to_base(k, 36), 36), k)
        k = k + 1

    // ---- is_digit_str ----
    assert_eq(is_digit_str("007"), 1)           // spec example
    assert_eq(is_digit_str("0"), 1)
    assert_eq(is_digit_str("123456789"), 1)
    assert_eq(is_digit_str(""), 0)              // empty -> 0
    assert_eq(is_digit_str("12a"), 0)
    assert_eq(is_digit_str("-1"), 0)           // sign is not a digit
    assert_eq(is_digit_str("1 2"), 0)          // space rejected
    assert_eq(is_digit_str(" 12"), 0)
    assert_eq(is_digit_str("1.0"), 0)

    // ---- is_int_str ----
    assert_eq(is_int_str("-42"), 1)            // spec example
    assert_eq(is_int_str("12a"), 0)            // spec example
    assert_eq(is_int_str(""), 0)               // spec example
    assert_eq(is_int_str("42"), 1)
    assert_eq(is_int_str("+42"), 1)
    assert_eq(is_int_str("-0"), 1)
    assert_eq(is_int_str("0"), 1)
    assert_eq(is_int_str("007"), 1)
    assert_eq(is_int_str("-"), 0)              // bare sign -> 0
    assert_eq(is_int_str("+"), 0)
    assert_eq(is_int_str("+-1"), 0)            // double sign
    assert_eq(is_int_str("1-2"), 0)            // sign mid-string
    assert_eq(is_int_str("1.0"), 0)
    assert_eq(is_int_str(" 12"), 0)            // leading space
    assert_eq(is_int_str("12 "), 0)            // trailing space
    assert_eq(is_int_str("0x1f"), 0)

    print("basex_test passed")
