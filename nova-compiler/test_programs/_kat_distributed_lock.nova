import forge_distributed_lock

fn main()
    let dl = dl_new()
    assert(dl_lock_count(dl) == 0, "no locks")

    let r1 = dl_acquire(dl, "resource-1", "node-A", 30, 100)
    assert(r1["acquired"] == 1, "acquired")
    assert(r1["holder"] == "node-A", "holder=A")
    dl = r1["dl"]

    assert(dl_is_held(dl, "resource-1", 110) == 1, "held at 110")
    assert(dl_holder(dl, "resource-1") == "node-A", "holder check")
    assert(dl_lock_count(dl) == 1, "1 lock")

    let r2 = dl_acquire(dl, "resource-1", "node-B", 30, 115)
    assert(r2["acquired"] == 0, "B rejected (A holds)")
    assert(r2["holder"] == "node-A", "A still holds")

    dl = dl_renew(dl, "resource-1", "node-A", 30, 120)
    assert(dl_is_held(dl, "resource-1", 145) == 1, "renewed, held at 145")

    dl = dl_release(dl, "resource-1", "node-A", 150)
    assert(dl_is_held(dl, "resource-1", 151) == 0, "released")

    let r3 = dl_acquire(dl, "resource-1", "node-B", 20, 155)
    assert(r3["acquired"] == 1, "B acquired after release")
    dl = r3["dl"]

    dl = dl_release(dl, "resource-1", "node-A", 160)
    assert(dl_holder(dl, "resource-1") == "node-B", "wrong owner release ignored")

    assert(dl_is_held(dl, "resource-1", 200) == 0, "expired at 200")
    let r4 = dl_acquire(dl, "resource-1", "node-C", 10, 200)
    assert(r4["acquired"] == 1, "C acquired after expiry")
    dl = r4["dl"]

    assert(dl_is_held(dl, "nonexistent", 100) == 0, "nonexistent=not held")
    assert(dl_holder(dl, "nonexistent") == "", "nonexistent holder empty")

    let hist = dl_history(dl)
    assert(len(hist) >= 4, "history has entries")
    assert(hist[0]["action"] == "acquire", "first=acquire")

    print("DISTRIBUTED-LOCK KAT PASS")
