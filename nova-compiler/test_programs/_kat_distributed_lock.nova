import forge_distributed_lock

fn main()
    let d = dl_new()
    let r1 = dl_acquire(d, "db", "node1", 1000)
    assert(is_ok(r1), "acquire ok")
    d = unwrap(r1)
    assert(dl_is_locked(d, "db") == 1, "locked")
    assert(dl_lock_count(d) == 1, "1 lock")

    let own = dl_owner(d, "db")
    assert(is_ok(own), "owner ok")
    assert(unwrap(own) == "node1", "owner=node1")

    let r2 = dl_acquire(d, "db", "node2", 2000)
    assert(is_err(r2), "contention")
    assert(dl_contention_count(d) == 1, "1 contention")

    let bad = dl_release(d, "db", "node2")
    assert(is_err(bad), "not owner")

    let r3 = dl_release(d, "db", "node1")
    assert(is_ok(r3), "release ok")
    d = unwrap(r3)
    assert(dl_is_locked(d, "db") == 0, "unlocked")

    print("DISTRIBUTED-LOCK KAT PASS")
