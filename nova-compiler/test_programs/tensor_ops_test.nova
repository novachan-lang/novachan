// AI tensor toolkit batch 2: elementwise sigmoid/tanh/log activations, the argmax
// classification head (returns a true int index), and elementwise sub/div completing
// the arithmetic set (add/mul/scale/sub/div). All operate purely on the NovaTensor
// double* buffer (no int/ptr/RC value-model surface). Floats are compared with an
// explicit tolerance gate (exit(1) on miss); int results are compared exactly.

fn check(got, want, msg)
    if got < want - 0.0001
        print(msg)
        exit(1)
    if got > want + 0.0001
        print(msg)
        exit(1)

fn main()
    // --- tensor_sigmoid: 1/(1+e^-x), stable at extremes (no overflow/nan) ---
    let sg = tensor_to_list(tensor_sigmoid(tensor_from_list([0.0, 100.0, -100.0], [3])))
    check(sg[0], 0.5, "sigmoid(0) != 0.5")
    check(sg[1], 1.0, "sigmoid(100) != ~1")
    check(sg[2], 0.0, "sigmoid(-100) != ~0")

    // --- tensor_tanh: saturating in (-1, 1) ---
    let th = tensor_to_list(tensor_tanh(tensor_from_list([0.0, 1.0, -1.0], [3])))
    check(th[0], 0.0, "tanh(0) != 0")
    check(th[1], 0.76159416, "tanh(1) ref")
    check(th[2], -0.76159416, "tanh(-1) ref")

    // --- tensor_log: natural log (log(e)=1, log(1)=0) ---
    let lg = tensor_to_list(tensor_log(tensor_from_list([2.718281828459045, 1.0], [2])))
    check(lg[0], 1.0, "log(e) != 1")
    check(lg[1], 0.0, "log(1) != 0")

    // --- tensor_argmax: flat index of the max, first on ties (returns int) ---
    let i1 = tensor_argmax(tensor_from_list([1.0, 5.0, 2.0, 4.0], [4]))
    if i1 != 1
        print("argmax([1,5,2,4]) != 1")
        exit(1)
    let i2 = tensor_argmax(tensor_from_list([3.0, 3.0, 1.0], [3]))
    if i2 != 0
        print("argmax tie should pick first index 0")
        exit(1)
    let i3 = tensor_argmax(tensor_from_list([7.0], [1]))
    if i3 != 0
        print("argmax single != 0")
        exit(1)

    // --- tensor_sub: elementwise a - b ---
    let sb = tensor_to_list(tensor_sub(tensor_from_list([5.0, 7.0, 9.0], [3]), tensor_from_list([1.0, 2.0, 3.0], [3])))
    check(sb[0], 4.0, "sub[0]")
    check(sb[1], 5.0, "sub[1]")
    check(sb[2], 6.0, "sub[2]")

    // --- tensor_div: elementwise a / b ---
    let dv = tensor_to_list(tensor_div(tensor_from_list([6.0, 8.0, 10.0], [3]), tensor_from_list([2.0, 2.0, 5.0], [3])))
    check(dv[0], 3.0, "div[0]")
    check(dv[1], 4.0, "div[1]")
    check(dv[2], 2.0, "div[2]")

    // --- end-to-end: softmax -> argmax picks the largest logit's class ---
    let cls = tensor_argmax(tensor_softmax(tensor_from_list([0.1, 0.2, 3.0, 0.5], [4])))
    if cls != 2
        print("softmax->argmax class != 2")
        exit(1)

    print("tensor_ops_test passed")
