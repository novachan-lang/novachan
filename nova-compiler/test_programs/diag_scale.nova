// Diagnostic: test heavy string building + many struct allocations

type Token
    kind: string
    value: string
    line: int
    col: int

fn build_string(n: int) -> string
    let s = ""
    let i = 0
    while i < n
        s = s + "a"
        i = i + 1
    s

fn make_many_tokens(n: int) -> list
    let tokens = []
    let i = 0
    while i < n
        let word = build_string(10)
        push(tokens, Token("IDENT", word, i, 1))
        i = i + 1
    tokens

// Test 1: Build large strings
let s1 = build_string(100)
print(len(s1))

// Test 2: Many struct allocations
let toks = make_many_tokens(500)
print(len(toks))

// Test 3: Access many fields
let count = 0
for t in toks
    match t
        Token(k, v, l, c) =>
            if len(v) == 10
                count = count + 1
print(count)

// Test 4: Nested string ops (simulating is_keyword pattern)
fn is_keyword(word: string) -> bool
    (word == "fn" or word == "return" or word == "if" or word == "else" or word == "for" or word == "while" or word == "match" or word == "break" or word == "continue" or word == "type" or word == "let")

print(is_keyword("fn"))
print(is_keyword("hello"))
print("DONE")
