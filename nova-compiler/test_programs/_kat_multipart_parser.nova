import forge_multipart_parser

fn main()
    let m = mp_new()
    m = mp_add_part(m, "file", "hello world", "text/plain")
    m = mp_add_part(m, "name", "Alice", "text/plain")
    m = mp_add_part(m, "avatar", "PNG_DATA_HERE", "image/png")
    assert(mp_part_count(m) == 3, "3 parts")

    let r1 = mp_get_part(m, "name")
    assert(is_ok(r1), "get ok")
    assert(unwrap(r1) == "Alice", "name=Alice")

    let ct = mp_content_type(m, 2)
    assert(is_ok(ct), "ct ok")
    assert(unwrap(ct) == "image/png", "png type")

    let sz = mp_part_size(m, 0)
    assert(is_ok(sz), "size ok")
    assert(unwrap(sz) == 11, "11 bytes")

    assert(mp_total_size(m) > 0, "positive total")

    let bad = mp_get_part(m, "nope")
    assert(is_err(bad), "not found")

    let bad2 = mp_content_type(m, 10)
    assert(is_err(bad2), "out of range")

    print("MULTIPART-PARSER KAT PASS")
