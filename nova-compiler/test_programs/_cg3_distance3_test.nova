import std/geometry3d/cg3_distance3

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(label: string, got: list, wn: int, wd: int)
    let gn = got[0]
    let gd = got[1]
    if gn != wn or gd != wd
        print("FAIL " + label + ": got=[" + str(gn) + "," + str(gd) + "] want=[" + str(wn) + "," + str(wd) + "]")
        exit(1)

fn main()
    // ── cgd3_point_point_sq ───────────────────────────────────────────────
    // KAT: [1,2,3] to [4,6,3] = (3)^2+(4)^2+(0)^2 = 9+16+0 = 25
    cki("pp_sq [1,2,3]-[4,6,3]", cgd3_point_point_sq([1,2,3], [4,6,3]), 25)
    // KAT: same point -> 0
    cki("pp_sq zero", cgd3_point_point_sq([0,0,0], [0,0,0]), 0)
    // Additional: [1,1,1] to [2,2,2] = 1+1+1 = 3
    cki("pp_sq [1,1,1]-[2,2,2]", cgd3_point_point_sq([1,1,1], [2,2,2]), 3)
    // Negative coords: [-1,-1,-1] to [1,1,1] = 4+4+4 = 12
    cki("pp_sq neg coords", cgd3_point_point_sq([-1,-1,-1], [1,1,1]), 12)

    // ── cgd3_point_segment_sq ─────────────────────────────────────────────
    // KAT: [5,0,0] to segment [0,0,0]-[2,0,0]: t_num=10, t_den=4; t_num>=t_den -> B=[2,0,0]
    //   dist^2 = (5-2)^2=9 -> [9,1]
    ckl("ps_sq beyond B", cgd3_point_segment_sq([5,0,0], [0,0,0], [2,0,0]), 9, 1)
    // KAT: [1,2,0] to segment [0,0,0]-[2,0,0]: t_num=1*2+2*0+0=2, t_den=4; 0<2<4 interior
    //   ap_sq=1+4+0=5, num=5*4-4=16, den=4 -> gcd=4 -> [4,1]
    ckl("ps_sq interior [1,2,0]", cgd3_point_segment_sq([1,2,0], [0,0,0], [2,0,0]), 4, 1)
    // t_num<=0 case: [-1,0,0] to [0,0,0]-[2,0,0]: dot=-2 <= 0 -> dist to A=1 -> [1,1]
    ckl("ps_sq before A", cgd3_point_segment_sq([-1,0,0], [0,0,0], [2,0,0]), 1, 1)
    // Degenerate a==b: dist to point a
    ckl("ps_sq degenerate a==b", cgd3_point_segment_sq([3,4,0], [0,0,0], [0,0,0]), 25, 1)
    // Point on segment: [1,0,0] on [0,0,0]-[2,0,0]: t_num=2, t_den=4 interior; ap_sq=1
    //   num=1*4-4=0 -> [0,1]
    ckl("ps_sq on segment", cgd3_point_segment_sq([1,0,0], [0,0,0], [2,0,0]), 0, 1)
    // 3D interior: [0,1,0] to segment [0,0,0]-[0,0,2]: AB=[0,0,2], AP=[0,1,0]
    //   t_num=0, t_den=4; t_num<=0 -> dist to A = 0+1+0=1 -> [1,1]
    ckl("ps_sq 3d clamp A", cgd3_point_segment_sq([0,1,0], [0,0,0], [0,0,2]), 1, 1)
    // Reduction: [0,3,0] to segment [0,0,0]-[4,0,0]: t_num=0, t_den=16; t_num<=0 -> dist to A = 9 -> [9,1]
    ckl("ps_sq reduction A", cgd3_point_segment_sq([0,3,0], [0,0,0], [4,0,0]), 9, 1)

    // ── cgd3_point_plane_sq ───────────────────────────────────────────────
    // KAT: pt=[0,0,3], plane=[0,0,1,0] (z=0 plane): dot_plus_d=0+0+3+0=3, norm_sq=1 -> [9,1]
    ckl("plane z=0 pt z=3", cgd3_point_plane_sq([0,0,3], [0,0,1,0]), 9, 1)
    // Point on plane: pt=[1,2,0], plane=[0,0,1,0]: dot_plus_d=0 -> [0,1]
    ckl("plane z=0 pt on plane", cgd3_point_plane_sq([1,2,0], [0,0,1,0]), 0, 1)
    // Oblique plane: pt=[1,0,0], plane=[1,0,0,-1] (x=1 plane): dot_plus_d=1-1=0 -> [0,1]
    ckl("plane x=1 pt on", cgd3_point_plane_sq([1,0,0], [1,0,0,-1]), 0, 1)
    // Oblique: pt=[3,0,0], plane=[1,0,0,-1]: dot_plus_d=3-1=2, norm_sq=1 -> [4,1]
    ckl("plane x=1 pt x=3", cgd3_point_plane_sq([3,0,0], [1,0,0,-1]), 4, 1)
    // Reduction: pt=[0,0,0], plane=[1,1,0,0] (x+y=0 plane): dot_plus_d=0, norm_sq=2 -> [0,1]
    ckl("plane x+y=0 origin", cgd3_point_plane_sq([0,0,0], [1,1,0,0]), 0, 1)
    // pt=[2,0,0], plane=[1,1,0,0]: dot_plus_d=2, norm_sq=2 -> num=4 den=2 -> gcd=2 -> [2,1]
    ckl("plane x+y=0 pt [2,0,0]", cgd3_point_plane_sq([2,0,0], [1,1,0,0]), 2, 1)
    // Degenerate zero normal: -> [0,1]
    ckl("plane degenerate", cgd3_point_plane_sq([5,5,5], [0,0,0,3]), 0, 1)

    print("PASS _cg3_distance3_test")
