// KAT for std/cipher/adfgx — ADFGX cipher
// Tests: round-trip decrypt(encrypt(pt,k1,k2),k1,k2)==pt, fractionation alphabet,
//        square properties, empty/short input safety.
import std/cipher/adfgx

fn main()
    // ── Test 1: Square has exactly 25 unique letters, no J ────────────────────
    let sq1 = adfgx_square("PHQGMEAYLNOFDXKRCVSZWBUTI")
    let sq_len = len(sq1)
    if sq_len != 25
        print("FAIL adfgx square size: got " + str(sq_len) + " want 25")
        exit(1)
    // Check uniqueness and no J
    let seen1 = {}
    let si = 0
    while si < 25
        let ch = sq1[si]
        if ch == "J"
            print("FAIL adfgx square contains J at index " + str(si))
            exit(1)
        if contains(seen1, ch)
            print("FAIL adfgx square duplicate letter " + ch + " at index " + str(si))
            exit(1)
        seen1[ch] = 1
        si = si + 1
    // ── Test 2: Empty square (default order) ─────────────────────────────────
    let sq2 = adfgx_square("")
    if sq2[0] != "A"
        print("FAIL adfgx default square[0]: got " + sq2[0] + " want A")
        exit(1)
    if sq2[8] != "I"
        print("FAIL adfgx default square[8]: got " + sq2[8] + " want I")
        exit(1)
    // ── Test 3: Fractionation uses only A,D,F,G,X ─────────────────────────────
    let key1_a = "PHQGMEAYLNOFDXKRCVSZWBUTI"
    let key2_a = "PRIVACY"
    let pt_a = "ATTACKATDAWN"
    let ct_a = adfgx_encrypt(pt_a, key1_a, key2_a)
    let ct_len = len(ct_a)
    let vi = 0
    while vi < ct_len
        let c = ct_a[vi]
        if c != "A"
            if c != "D"
                if c != "F"
                    if c != "G"
                        if c != "X"
                            print("FAIL adfgx frac alphabet: bad char " + c + " in " + ct_a)
                            exit(1)
        vi = vi + 1
    // ── Test 4: Round-trip for ATTACKATDAWN ──────────────────────────────────
    let rt_a = adfgx_decrypt(ct_a, key1_a, key2_a)
    if rt_a != "ATTACKATDAWN"
        print("FAIL adfgx round-trip ATTACKATDAWN: got " + rt_a + " want ATTACKATDAWN")
        exit(1)
    // ── Test 5: J→I mapping ───────────────────────────────────────────────────
    let pt_j = "JUNGLE"
    let pt_j_norm = "IUNGLE"
    let ct_j = adfgx_encrypt(pt_j, key1_a, key2_a)
    let rt_j = adfgx_decrypt(ct_j, key1_a, key2_a)
    if rt_j != pt_j_norm
        print("FAIL adfgx J->I mapping: got " + rt_j + " want " + pt_j_norm)
        exit(1)
    // ── Test 6: Different key1/key2 round-trips ───────────────────────────────
    let key1_b = "GERMAN"
    let key2_b = "BERLIN"
    let pt_b = "HELLOWORLD"
    let ct_b = adfgx_encrypt(pt_b, key1_b, key2_b)
    let rt_b = adfgx_decrypt(ct_b, key1_b, key2_b)
    if rt_b != "HELLOWORLD"
        print("FAIL adfgx round-trip HELLOWORLD: got " + rt_b + " want HELLOWORLD")
        exit(1)
    // ── Test 7: Single-letter plaintext ──────────────────────────────────────
    let ct_s = adfgx_encrypt("Z", key1_a, key2_a)
    let rt_s = adfgx_decrypt(ct_s, key1_a, key2_a)
    if rt_s != "Z"
        print("FAIL adfgx single letter: got " + rt_s + " want Z")
        exit(1)
    // ── Test 8: Empty plaintext ───────────────────────────────────────────────
    let ct_e = adfgx_encrypt("", key1_a, key2_a)
    if ct_e != ""
        print("FAIL adfgx empty encrypt: got " + ct_e + " want empty")
        exit(1)
    let rt_e = adfgx_decrypt("", key1_a, key2_a)
    if rt_e != ""
        print("FAIL adfgx empty decrypt: got " + rt_e + " want empty")
        exit(1)
    // ── Test 9: Longer text with digits/spaces stripped ───────────────────────
    let pt_c = "THE QUICK BROWN FOX 123"
    let pt_c_norm = "THEQUICKBROWNFOX"
    let ct_c = adfgx_encrypt(pt_c, key1_a, key2_a)
    let rt_c = adfgx_decrypt(ct_c, key1_a, key2_a)
    if rt_c != pt_c_norm
        print("FAIL adfgx long text: got " + rt_c + " want " + pt_c_norm)
        exit(1)
    // ── Test 10: key2 single-letter (degenerate — no real transposition) ──────
    let ct_k1 = adfgx_encrypt("HELLO", key1_a, "A")
    let rt_k1 = adfgx_decrypt(ct_k1, key1_a, "A")
    if rt_k1 != "HELLO"
        print("FAIL adfgx single-col key2: got " + rt_k1 + " want HELLO")
        exit(1)
    // ── Test 11: Ciphertext length is 2 * plaintext length ───────────────────
    let pt_len_check = "SECRETMESSAGE"
    let ct_check = adfgx_encrypt(pt_len_check, key1_a, key2_a)
    let expected_ct_len = 26
    let actual_ct_len = len(ct_check)
    if actual_ct_len != expected_ct_len
        print("FAIL adfgx ct length: got " + str(actual_ct_len) + " want " + str(expected_ct_len))
        exit(1)
    // ── Test 12: Round-trip with repeated letters in key2 ────────────────────
    let ct_d = adfgx_encrypt("NOVA", "KEY", "AABBCC")
    let rt_d = adfgx_decrypt(ct_d, "KEY", "AABBCC")
    if rt_d != "NOVA"
        print("FAIL adfgx dup-letter key2: got " + rt_d + " want NOVA")
        exit(1)
    print("PASS _adfgx_test")
