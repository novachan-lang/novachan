// KAT test for std/text/collocation
// Hand-computed values:
//   tokens = ['new','york','new','york','big','apple']
//   n=6, unigram: new=2 york=2 big=1 apple=1
//   bigram: new|york=2, york|new=1, york|big=1, big|apple=1
//   PMI(new,york): f_xy=2, f_x=2, f_y=2, n=6
//     = log2((2*6)/(2*2)) = log2(12/4) = log2(3) ~ 1.5850
//   PMI(big,apple): f_xy=1, f_x=1, f_y=1, n=6
//     = log2((1*6)/(1*1)) = log2(6) ~ 2.5850
//   col_pmi(10,10,10,100) = log2((10*100)/(10*10)) = log2(10) ~ 3.3219
//   col_pmi(5,10,10,100)  = log2((5*100)/(10*10))  = log2(5)  ~ 2.3219
import std/text/collocation

fn ckf(label, got, want, tol)
    let diff = got - want
    if diff < 0.0
        diff = 0.0 - diff
    if diff > tol
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── KAT 1: col_pmi hand values ──────────────────────────────────────────
    // col_pmi(10,10,10,100) = log2((10*100)/(10*10)) = log2(10) ~ 3.3219
    let pmi1 = col_pmi(10, 10, 10, 100)
    ckf("pmi_10_10_10_100", pmi1, 3.3219, 0.001)

    // col_pmi(5,10,10,100) = log2(5) ~ 2.3219
    let pmi2 = col_pmi(5, 10, 10, 100)
    ckf("pmi_5_10_10_100", pmi2, 2.3219, 0.001)

    // col_pmi with zero inputs returns 0.0
    let pmi_zero = col_pmi(0, 10, 10, 100)
    ckf("pmi_zero", pmi_zero, 0.0, 0.001)

    // ── KAT 2: col_bigram_freq ───────────────────────────────────────────────
    let tokens = ["new", "york", "new", "york", "big", "apple"]
    let bf = col_bigram_freq(tokens)
    let sep = chr(1)
    let key_ny = "new" + sep + "york"
    let key_yn = "york" + sep + "new"
    let key_ba = "big" + sep + "apple"
    cki("bf_new_york", bf[key_ny], 2)
    cki("bf_york_new", bf[key_yn], 1)
    cki("bf_big_apple", bf[key_ba], 1)

    // ── KAT 3: col_unigram_freq ─────────────────────────────────────────────
    let uf = col_unigram_freq(tokens)
    cki("uf_new", uf["new"], 2)
    cki("uf_york", uf["york"], 2)
    cki("uf_big", uf["big"], 1)
    cki("uf_apple", uf["apple"], 1)

    // ── KAT 4: co-occurring pair has higher PMI than independent pair ────────
    // new+york: f_xy=2,f_x=2,f_y=2,n=6 => PMI ~ 1.585
    // new+big (never co-occur): PMI=0
    let pmi_ny = col_pmi(2, 2, 2, 6)
    let pmi_nb = col_pmi(0, 2, 1, 6)
    // pmi_nb = 0 because f_xy=0
    if pmi_ny <= pmi_nb
        print("FAIL pmi_ordering: new-york PMI should exceed never-co-occurring pair")
        exit(1)

    // ── KAT 5: col_npmi on perfectly correlated pair ─────────────────────────
    // n=4, f_xy=2, f_x=2, f_y=2 (2 bigrams, "ab ab" style)
    // pmi = log2((2*4)/(2*2)) = log2(2) = 1.0
    // npmi = pmi / (-log2(2/4)) = 1.0 / (-log2(0.5)) = 1.0 / 1.0 = 1.0
    let npmi1 = col_npmi(2, 2, 2, 4)
    ckf("npmi_correlated", npmi1, 1.0, 0.001)

    // ── KAT 6: col_t_score ─────────────────────────────────────────────────
    // f_xy=2, f_x=2, f_y=2, n=6
    // expected = 2*2/6 = 0.6667; t = (2 - 0.6667)/sqrt(2) = 1.3333/1.4142 ~ 0.9428
    let ts = col_t_score(2, 2, 2, 6)
    ckf("tscore_ny", ts, 0.9428, 0.001)

    // t-score for perfectly expected (no association) should be near 0
    // f_xy=1, f_x=2, f_y=3, n=6, expected=2*3/6=1.0, t=(1-1)/sqrt(1)=0
    let ts_zero = col_t_score(1, 2, 3, 6)
    ckf("tscore_zero", ts_zero, 0.0, 0.001)

    // ── KAT 7: col_chi_square basic property ───────────────────────────────
    // Independent cells: f_xy=f_x*f_y/n -> chi=0 (no association)
    // n=100, f_x=50, f_y=50, f_xy=25 (exactly expected)
    let chi_indep = col_chi_square(25, 50, 50, 100)
    ckf("chi_indep", chi_indep, 0.0, 0.001)

    // Positive association: f_xy > expected -> chi > 0
    // n=100, f_x=10, f_y=10, f_xy=5 (expected=1.0); chi should be large
    let chi_pos = col_chi_square(5, 10, 10, 100)
    if chi_pos <= 0.0
        print("FAIL chi_positive: expected chi > 0 for positive association")
        exit(1)

    // ── KAT 8: col_log_likelihood ───────────────────────────────────────────
    // Independent case: G2 ~ 0
    // n=100, f_x=50, f_y=50, f_xy=25
    let ll_indep = col_log_likelihood(25, 50, 50, 100)
    ckf("ll_indep", ll_indep, 0.0, 0.01)

    // G2 > 0 for associated pair
    let ll_assoc = col_log_likelihood(5, 10, 10, 100)
    if ll_assoc <= 0.0
        print("FAIL ll_positive: G2 should be positive for associated pair")
        exit(1)

    // ── KAT 9: col_score_bigram ─────────────────────────────────────────────
    let score_pmi = col_score_bigram(tokens, "new", "york", "pmi")
    // pmi(2,2,2,6) ~ 1.585
    ckf("score_pmi_ny", score_pmi, 1.585, 0.01)

    let score_ts = col_score_bigram(tokens, "new", "york", "tscore")
    ckf("score_tscore_ny", score_ts, 0.9428, 0.01)

    // Unknown measure returns 0.0
    let score_unk = col_score_bigram(tokens, "new", "york", "unknown")
    ckf("score_unknown", score_unk, 0.0, 0.001)

    // ── KAT 10: col_top_bigrams ─────────────────────────────────────────────
    // "new\x01york" appears 2 times — should be top bigram
    let top1 = col_top_bigrams(tokens, 1)
    cki("top_bigrams_len", len(top1), 1)
    if top1[0] != key_ny
        print("FAIL top_bigram: expected new|york as most frequent bigram")
        exit(1)

    // ── KAT 11: col_top_pmi ─────────────────────────────────────────────────
    // With min_freq=1, top by PMI should contain big|apple (pmi~2.585) over new|york (~1.585)
    let toppmi = col_top_pmi(tokens, 2, 1)
    cki("top_pmi_len", len(toppmi), 2)
    // First result should be big|apple (highest PMI)
    if toppmi[0] != key_ba
        print("FAIL top_pmi_order: expected big|apple as top PMI bigram")
        exit(1)

    // With min_freq=2, only new|york qualifies
    let toppmi2 = col_top_pmi(tokens, 5, 2)
    cki("top_pmi_min2_len", len(toppmi2), 1)
    if toppmi2[0] != key_ny
        print("FAIL top_pmi_min2: expected new|york as only qualifying bigram")
        exit(1)

    // ── KAT 12: col_filter_by_freq ──────────────────────────────────────────
    let filt = col_filter_by_freq(bf, 2)
    // Only "new|york" (count=2) passes; others have count=1
    if not contains(filt, key_ny)
        print("FAIL filter_has_ny: new|york should pass freq filter")
        exit(1)
    if contains(filt, key_ba)
        print("FAIL filter_no_ba: big|apple should be filtered out")
        exit(1)

    // ── KAT 13: col_bigrams list structure ──────────────────────────────────
    let bigs = col_bigrams(tokens)
    cki("bigrams_len", len(bigs), 5)
    // First pair should be ["new","york"]
    let first = bigs[0]
    if first[0] != "new"
        print("FAIL bigrams_first0: expected 'new'")
        exit(1)
    if first[1] != "york"
        print("FAIL bigrams_first1: expected 'york'")
        exit(1)

    // ── KAT 14: empty / edge cases ──────────────────────────────────────────
    let empty_toks = []
    let bf_empty = col_bigram_freq(empty_toks)
    let uf_empty = col_unigram_freq(empty_toks)
    let bigs_empty = col_bigrams(empty_toks)
    cki("empty_bf_len", len(keys(bf_empty)), 0)
    cki("empty_uf_len", len(keys(uf_empty)), 0)
    cki("empty_bigrams_len", len(bigs_empty), 0)

    print("PASS _collocation_test")
