// functional: HPACK Huffman (RFC 7541 C.4.1/C.4.2 byte-exact + round-trip + H=1 literal)
import forge_hpack

fn main()
    let e1 = hpack_huffman_encode("www.example.com")
    if str(e1) != str([241, 227, 194, 229, 242, 58, 107, 160, 171, 144, 244, 255])
        print("FAIL C.4.1 = " + str(e1))
        exit(1)
    let e2 = hpack_huffman_encode("no-cache")
    if str(e2) != str([168, 235, 16, 100, 156, 191])
        print("FAIL C.4.2 = " + str(e2))
        exit(1)
    if hpack_huffman_decode(e1) != "www.example.com"
        print("FAIL decode C.4.1 = " + hpack_huffman_decode(e1))
        exit(1)
    if hpack_huffman_decode(e2) != "no-cache"
        print("FAIL decode C.4.2")
        exit(1)
    let s = "Hello, World! /api/v2?q=x&n=42 #frag ABCxyz 0123456789"
    if hpack_huffman_decode(hpack_huffman_encode(s)) != s
        print("FAIL round-trip general")
        exit(1)
    let lit = hpack_encode_string_huffman([], "custom-value")
    let dec = hpack_decode_string(lit, 0)
    if dec[0] != "custom-value"
        print("FAIL H=1 literal decode = " + str(dec[0]))
        exit(1)
    if dec[2] != 1
        print("FAIL H=1 flag")
        exit(1)
    print("PASS forge_hpack_huffman")
