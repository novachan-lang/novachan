import std/quantum/quantum_state

// cki — integer known-answer check.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _quantum_state_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// _round1000 — local test helper: round x*1000 to nearest int (handles negative x).
fn _round1000(x: float) -> int
    if x < 0.0
        let neg = 0.0 - x
        let scaled = neg * 1000.0 + 0.5
        let r = float_to_int(scaled)
        return 0 - r
    let scaled = x * 1000.0 + 0.5
    float_to_int(scaled)

fn main()
    // qst_zero / qst_dim / qst_num_qubits / qst_prob_x1000
    let z3 = qst_zero(3)
    cki("dim(zero(3))", qst_dim(z3), 8)
    cki("num_qubits(zero(3))", qst_num_qubits(z3), 3)
    cki("prob0(zero(3))", qst_prob_x1000(z3, 0), 1000)
    cki("prob1(zero(3))", qst_prob_x1000(z3, 1), 0)

    // qst_basis
    let b23 = qst_basis(2, 3)
    cki("prob3(basis(2,3))", qst_prob_x1000(b23, 3), 1000)

    // qst_cmul: i*i == -1
    let ii = qst_cmul(qst_c(0.0, 1.0), qst_c(0.0, 1.0))
    cki("i*i re", _round1000(ii[0]), 0 - 1000)
    cki("i*i im", _round1000(ii[1]), 0)

    // qst_kron: |1>@|0> == |10> == basis(2,2)
    let k = qst_kron(qst_basis(1, 1), qst_basis(1, 0))
    cki("kron equals basis(2,2)", qst_equal_x1000(k, qst_basis(2, 2)), 1)

    // qst_bit / qst_flip_bit (big-endian: q0 is MSB)
    cki("bit(2,2,0)", qst_bit(2, 2, 0), 1)
    cki("bit(2,2,1)", qst_bit(2, 2, 1), 0)
    cki("flip_bit(2,2,1)", qst_flip_bit(2, 2, 1), 3)
    cki("bit(6,3,0)", qst_bit(6, 3, 0), 1)

    // qst_set_bit
    cki("set_bit(2,2,1,1)", qst_set_bit(2, 2, 1, 1), 3)
    cki("set_bit(2,2,0,1)", qst_set_bit(2, 2, 0, 1), 2)
    cki("set_bit(2,2,0,0)", qst_set_bit(2, 2, 0, 0), 0)

    // qst_amp / qst_set_amp round trip
    let se = qst_zero(2)
    qst_set_amp(se, 1, qst_c(0.0, 1.0))
    let got = qst_amp(se, 1)
    cki("set_amp/amp re", _round1000(got[0]), 0)
    cki("set_amp/amp im", _round1000(got[1]), 1000)

    // qst_to_probs
    let probs = qst_to_probs(b23)
    cki("to_probs len", len(probs), 4)
    cki("to_probs[3]", _round1000(probs[3]), 1000)

    // qst_norm2
    let s = []
    push(s, qst_c(0.6, 0.0))
    push(s, qst_c(0.8, 0.0))
    cki("norm2([0.6,0.8])", _round1000(qst_norm2(s)), 1000)

    // qst_normalize
    let un = []
    push(un, qst_c(3.0, 0.0))
    push(un, qst_c(4.0, 0.0))
    let nrm = qst_normalize(un)
    cki("normalize prob0", qst_prob_x1000(nrm, 0), 360)
    cki("normalize prob1", qst_prob_x1000(nrm, 1), 640)

    print("PASS _quantum_state_test")
