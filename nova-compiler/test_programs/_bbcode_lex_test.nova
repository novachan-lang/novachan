import std/text/bbcode_lex

fn main()
    // KAT 1: plain text, no tags at all -> a single text token
    let t1 = blex_tokenize("hello world")
    if len(t1) != 1
        print("FAIL bbcode_lex KAT1 len: got " + str(len(t1)))
        exit(1)
    if blex_token_tag(t1[0]) != "text" or blex_token_value(t1[0]) != "hello world"
        print("FAIL bbcode_lex KAT1 content")
        exit(1)

    // KAT 2: simple matched pair [b]bold[/b] -> open, text, close
    let t2 = blex_tokenize("[b]bold[/b]")
    if len(t2) != 3
        print("FAIL bbcode_lex KAT2 len: got " + str(len(t2)))
        exit(1)
    if blex_token_tag(t2[0]) != "open" or blex_token_value(t2[0]) != "b" or blex_token_attr(t2[0]) != ""
        print("FAIL bbcode_lex KAT2 open")
        exit(1)
    if blex_token_tag(t2[1]) != "text" or blex_token_value(t2[1]) != "bold"
        print("FAIL bbcode_lex KAT2 text")
        exit(1)
    if blex_token_tag(t2[2]) != "close" or blex_token_value(t2[2]) != "b"
        print("FAIL bbcode_lex KAT2 close")
        exit(1)

    // KAT 3: attribute tag [url=http://x.com]link[/url]
    let t3 = blex_tokenize("[url=http://x.com]link[/url]")
    if len(t3) != 3
        print("FAIL bbcode_lex KAT3 len: got " + str(len(t3)))
        exit(1)
    if blex_token_tag(t3[0]) != "open" or blex_token_value(t3[0]) != "url" or blex_token_attr(t3[0]) != "http://x.com"
        print("FAIL bbcode_lex KAT3 open attr: got [" + blex_token_attr(t3[0]) + "]")
        exit(1)
    if blex_token_value(t3[1]) != "link"
        print("FAIL bbcode_lex KAT3 text")
        exit(1)
    if blex_token_tag(t3[2]) != "close" or blex_token_value(t3[2]) != "url"
        print("FAIL bbcode_lex KAT3 close")
        exit(1)

    // KAT 4: attribute value itself contains '=' (query string) -- must NOT
    // be re-split; only the FIRST '=' after the tag name divides name/attr.
    let t4 = blex_tokenize("[url=http://x.com/a?b=c]end")
    if len(t4) != 2
        print("FAIL bbcode_lex KAT4 len: got " + str(len(t4)))
        exit(1)
    if blex_token_attr(t4[0]) != "http://x.com/a?b=c"
        print("FAIL bbcode_lex KAT4 attr: got [" + blex_token_attr(t4[0]) + "]")
        exit(1)
    if blex_token_value(t4[1]) != "end"
        print("FAIL bbcode_lex KAT4 tail text")
        exit(1)

    // KAT 5: unclosed bracket -- no matching ']' -- degrades to literal text
    let t5 = blex_tokenize("[foo")
    if len(t5) != 1
        print("FAIL bbcode_lex KAT5 len: got " + str(len(t5)))
        exit(1)
    if blex_token_tag(t5[0]) != "text" or blex_token_value(t5[0]) != "[foo"
        print("FAIL bbcode_lex KAT5 content: got [" + blex_token_value(t5[0]) + "]")
        exit(1)

    // KAT 6: empty tag name "[]" -- also degrades to literal text
    let t6 = blex_tokenize("[]")
    if len(t6) != 1
        print("FAIL bbcode_lex KAT6 len: got " + str(len(t6)))
        exit(1)
    if blex_token_value(t6[0]) != "[]"
        print("FAIL bbcode_lex KAT6 content: got [" + blex_token_value(t6[0]) + "]")
        exit(1)

    // KAT 7: tag-name case is PRESERVED verbatim by the lexer (matching is
    // the parser's job, not the lexer's)
    let t7 = blex_tokenize("[B]x[/b]")
    if len(t7) != 3
        print("FAIL bbcode_lex KAT7 len: got " + str(len(t7)))
        exit(1)
    if blex_token_value(t7[0]) != "B"
        print("FAIL bbcode_lex KAT7 open case: got [" + blex_token_value(t7[0]) + "]")
        exit(1)
    if blex_token_value(t7[2]) != "b"
        print("FAIL bbcode_lex KAT7 close case: got [" + blex_token_value(t7[2]) + "]")
        exit(1)

    // KAT 8: bare list-item shorthand "[*]"
    let t8 = blex_tokenize("[*]item")
    if len(t8) != 2
        print("FAIL bbcode_lex KAT8 len: got " + str(len(t8)))
        exit(1)
    if blex_token_tag(t8[0]) != "open" or blex_token_value(t8[0]) != "*"
        print("FAIL bbcode_lex KAT8 open")
        exit(1)
    if blex_token_value(t8[1]) != "item"
        print("FAIL bbcode_lex KAT8 text")
        exit(1)

    // KAT 9: adjacent tags with no text between them
    let t9 = blex_tokenize("[b][i]x[/i][/b]")
    if len(t9) != 5
        print("FAIL bbcode_lex KAT9 len: got " + str(len(t9)))
        exit(1)
    if blex_token_tag(t9[0]) != "open" or blex_token_value(t9[0]) != "b"
        print("FAIL bbcode_lex KAT9 tok0")
        exit(1)
    if blex_token_tag(t9[1]) != "open" or blex_token_value(t9[1]) != "i"
        print("FAIL bbcode_lex KAT9 tok1")
        exit(1)
    if blex_token_tag(t9[2]) != "text" or blex_token_value(t9[2]) != "x"
        print("FAIL bbcode_lex KAT9 tok2")
        exit(1)
    if blex_token_tag(t9[3]) != "close" or blex_token_value(t9[3]) != "i"
        print("FAIL bbcode_lex KAT9 tok3")
        exit(1)
    if blex_token_tag(t9[4]) != "close" or blex_token_value(t9[4]) != "b"
        print("FAIL bbcode_lex KAT9 tok4")
        exit(1)

    // KAT 10: empty input -> no tokens at all
    let t10 = blex_tokenize("")
    if len(t10) != 0
        print("FAIL bbcode_lex KAT10 len: got " + str(len(t10)))
        exit(1)

    print("PASS _bbcode_lex_test")
