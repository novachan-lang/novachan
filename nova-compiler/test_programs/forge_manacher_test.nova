import forge_manacher

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // longest palindromic substring (unambiguous cases)
    fails = fails + expect("racecar", longest_palindrome("racecar"), "racecar")
    fails = fails + expect("embedded", longest_palindrome("xabacabay"), "abacaba")
    fails = fails + expect("cbbd", longest_palindrome("cbbd"), "bb")
    fails = fails + expect("single", longest_palindrome("z"), "z")
    fails = fails + expect("nopal", longest_palindrome("abcd"), "a")
    fails = fails + expect("empty", longest_palindrome(""), "")
    fails = fails + expect("forgeeks", longest_palindrome("forgeeksskeegfor"), "geeksskeeg")

    // lengths
    fails = fails + expect("len_babad", str(longest_palindrome_len("babad")), "3")
    fails = fails + expect("len_cbbd", str(longest_palindrome_len("cbbd")), "2")
    fails = fails + expect("len_racecar", str(longest_palindrome_len("racecar")), "7")
    fails = fails + expect("len_a", str(longest_palindrome_len("a")), "1")
    fails = fails + expect("len_empty", str(longest_palindrome_len("")), "0")
    fails = fails + expect("len_abcd", str(longest_palindrome_len("abcd")), "1")

    // whole-string palindrome test
    fails = fails + expect("isp_level", str(is_palindrome("level")), "true")
    fails = fails + expect("isp_noon", str(is_palindrome("noon")), "true")
    fails = fails + expect("isp_no", str(is_palindrome("hello")), "false")
    fails = fails + expect("isp_a", str(is_palindrome("a")), "true")
    fails = fails + expect("isp_empty", str(is_palindrome("")), "true")

    // count all palindromic substrings
    fails = fails + expect("cnt_aaa", str(count_palindromes("aaa")), "6")
    fails = fails + expect("cnt_abc", str(count_palindromes("abc")), "3")
    fails = fails + expect("cnt_aba", str(count_palindromes("aba")), "4")

    if fails == 0
        print("forge_manacher: all passed")
    else
        print("forge_manacher: " + str(fails) + " FAILED")
