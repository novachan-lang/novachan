import std/tree/tree_diameter

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(label, got, want)
    if len(got) != len(want)
        print("FAIL " + label + " (len): got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // =========================================================================
    // T5: adj=[[1,2],[0,3,4],[0],[1],[1]] n=5 diameter=3
    // =========================================================================
    let adj5 = []
    let r0 = []
    push(r0, 1)
    push(r0, 2)
    push(adj5, r0)
    let r1 = []
    push(r1, 0)
    push(r1, 3)
    push(r1, 4)
    push(adj5, r1)
    let r2 = []
    push(r2, 0)
    push(adj5, r2)
    let r3 = []
    push(r3, 1)
    push(adj5, r3)
    let r4 = []
    push(r4, 1)
    push(adj5, r4)

    cki("diameter_T5", td_diameter(adj5, 5), 3)

    // endpoints: a pair with distance 3; longest paths are 3->1->0->2 and 4->1->0->2
    // Both have distance 3; smallest u with a partner = 0 paired with 3 or 4
    // Our algorithm: furthest from 0 = node 2 (dist=2 at tie with 3,4 dist=2 — wait,
    //   dist[2]=1, dist[3]=dist[4]=2, dist[1]=1 — furthest is 3 (smallest at max dist 2)
    //   Then BFS from 3: dist[1]=1,dist[0]=2,dist[2]=dist[4]=3 — furthest=2 (smallest at 3)
    //   So endpoints = [2,3] normalised
    let ep5 = td_endpoints(adj5, 5)
    cki("endpoints_T5_len", len(ep5), 2)
    // verify the distance between endpoints equals diameter
    cki("endpoints_T5_u_lt_v", ep5[0] < ep5[1], 1)
    // distance between ep5[0] and ep5[1] must equal 3
    // (we can't easily compute this inline without importing; just check values are valid)
    // Valid pairs (dist=3): {2,3}, {2,4} — accept either
    let u5 = ep5[0]
    let v5 = ep5[1]
    let ok5 = 0
    if u5 == 2 and v5 == 3
        ok5 = 1
    if u5 == 2 and v5 == 4
        ok5 = 1
    if u5 == 3 and v5 == 4
        ok5 = 0
    cki("endpoints_T5_valid", ok5, 1)

    // td_center(T5): center of tree with diameter 3 (odd) -> 2 centers
    // Diameter path e.g. 3->1->0->2 (length 4 nodes), centers = nodes at positions 1,2 = {0,1}
    let center5 = td_center(adj5, 5)
    cki("center_T5_len", len(center5), 2)
    // centers must be {0,1}
    cki("center_T5_0", center5[0], 0)
    cki("center_T5_1", center5[1], 1)

    // =========================================================================
    // Path: adj=[[1],[0,2],[1,3],[2]] n=4 diameter=3
    // =========================================================================
    let adj_path = []
    let p0 = []
    push(p0, 1)
    push(adj_path, p0)
    let p1 = []
    push(p1, 0)
    push(p1, 2)
    push(adj_path, p1)
    let p2 = []
    push(p2, 1)
    push(p2, 3)
    push(adj_path, p2)
    let p3 = []
    push(p3, 2)
    push(adj_path, p3)

    cki("diameter_path4", td_diameter(adj_path, 4), 3)

    // td_center(path 0-1-2-3): diameter=3, path 0->1->2->3 (4 nodes)
    // mid = 4/2 = 2, even path -> two centers at positions 1 and 2 = nodes 1 and 2
    let center_path = td_center(adj_path, 4)
    cki("center_path4_len", len(center_path), 2)
    cki("center_path4_0", center_path[0], 1)
    cki("center_path4_1", center_path[1], 2)

    // =========================================================================
    // Star: adj=[[1,2,3],[0],[0],[0]] n=4 diameter=2
    // =========================================================================
    let adj_star = []
    let sc = []
    push(sc, 1)
    push(sc, 2)
    push(sc, 3)
    push(adj_star, sc)
    let sl1 = []
    push(sl1, 0)
    push(adj_star, sl1)
    let sl2 = []
    push(sl2, 0)
    push(adj_star, sl2)
    let sl3 = []
    push(sl3, 0)
    push(adj_star, sl3)

    cki("diameter_star4", td_diameter(adj_star, 4), 2)

    // td_center(star): diameter=2, path e.g. 1->0->2 (3 nodes)
    // plen=3, plen%2==1, mid=1, single center = path[1]=0
    let center_star = td_center(adj_star, 4)
    cki("center_star4_len", len(center_star), 1)
    cki("center_star4_0", center_star[0], 0)

    // =========================================================================
    // Single node: adj=[[]] n=1 diameter=0
    // =========================================================================
    let adj1 = []
    let n1 = []
    push(adj1, n1)

    cki("diameter_1node", td_diameter(adj1, 1), 0)

    let ep1 = td_endpoints(adj1, 1)
    cki("endpoints_1node_0", ep1[0], 0)
    cki("endpoints_1node_1", ep1[1], 0)

    let center1 = td_center(adj1, 1)
    cki("center_1node_len", len(center1), 1)
    cki("center_1node_0", center1[0], 0)

    // =========================================================================
    // 2-node path: adj=[[1],[0]] n=2 diameter=1
    // =========================================================================
    let adj2 = []
    let q0 = []
    push(q0, 1)
    push(adj2, q0)
    let q1 = []
    push(q1, 0)
    push(adj2, q1)

    cki("diameter_2node", td_diameter(adj2, 2), 1)

    // center of 2-node path: diameter=1, path=[0,1] len=2, even -> 2 centers {0,1}
    let center2 = td_center(adj2, 2)
    cki("center_2node_len", len(center2), 2)
    cki("center_2node_0", center2[0], 0)
    cki("center_2node_1", center2[1], 1)

    print("PASS _tree_diameter_test")

main()
