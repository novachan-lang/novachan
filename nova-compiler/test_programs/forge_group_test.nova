// forge_group_test -- Phase 1 incr-5: route groups (API versioning / sub-route mounting).
// forge.group(app, prefix) prefixes paths registered through it; grouped + ungrouped routes
// coexist; an unprefixed path must NOT match a grouped route.
import forge

fn h_users(req: Request) -> Response
    forge.resp_text(200, "users")

fn h_health(req: Request) -> Response
    forge.resp_text(200, "ok")

fn h_post(req: Request) -> Response
    forge.resp_text(201, "created")

fn main()
    let app = forge.app()
    let api = forge.group(app, "/api/v1")
    forge.get(api, "/users", h_users)       // -> GET /api/v1/users
    forge.post(api, "/users", h_post)       // -> POST /api/v1/users
    forge.get(app, "/health", h_health)     // -> GET /health (ungrouped)

    // grouped GET matches the prefixed path
    let r1: Response = forge.dispatch_req(app, forge.build_request("GET /api/v1/users HTTP/1.1\r\n\r\n", 0))
    assert(r1.status == 200, "grouped GET /api/v1/users matched")

    // grouped POST matches (method + prefix)
    let r2: Response = forge.dispatch_req(app, forge.build_request("POST /api/v1/users HTTP/1.1\r\n\r\n", 0))
    assert(r2.status == 201, "grouped POST /api/v1/users matched")

    // ungrouped route still works
    let r3: Response = forge.dispatch_req(app, forge.build_request("GET /health HTTP/1.1\r\n\r\n", 0))
    assert(r3.status == 200, "ungrouped GET /health matched")

    // the unprefixed path must NOT match the grouped route
    let r4: Response = forge.dispatch_req(app, forge.build_request("GET /users HTTP/1.1\r\n\r\n", 0))
    assert(r4.status == 404, "unprefixed /users does NOT match grouped route")

    print("forge_group_test passed")
