// KAT test for std/numeric/dist_binomial — Binomial distribution functions.
//
// Known answers:
//   binomial_pmf(2, 5, 0.5) = C(5,2)*0.5^2*0.5^3 = 10*0.25*0.125 = 0.3125
//   binomial_cdf(2, 5, 0.5) = pmf(0)+pmf(1)+pmf(2) = 0.03125+0.15625+0.3125 = 0.5
//   binomial_pmf(0, 3, 0.5) = 0.5^3 = 0.125
import std/numeric/dist_binomial

fn approx(a, b, tol) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < tol
        return 1
    return 0

fn ck(label: string, got: float, want: float, tol: float)
    let ok = approx(got, want, tol)
    if ok == 0
        print("FAIL dist_binomial " + label + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("ok " + label)

fn main()
    // Core KAT assertions from task spec
    let pmf25 = binomial_pmf(2, 5, 0.5)
    ck("binomial_pmf(2,5,0.5)=0.3125", pmf25, 0.3125, 0.0001)

    let cdf25 = binomial_cdf(2, 5, 0.5)
    ck("binomial_cdf(2,5,0.5)=0.5", cdf25, 0.5, 0.0001)

    let pmf03 = binomial_pmf(0, 3, 0.5)
    ck("binomial_pmf(0,3,0.5)=0.125", pmf03, 0.125, 0.0001)

    // Additional correctness checks
    // pmf(5,5,0.5) = 0.5^5 = 0.03125
    let pmf55 = binomial_pmf(5, 5, 0.5)
    ck("binomial_pmf(5,5,0.5)=0.03125", pmf55, 0.03125, 0.0001)

    // pmf(3,5,0.5) = C(5,3)*0.5^5 = 10/32 = 0.3125
    let pmf35 = binomial_pmf(3, 5, 0.5)
    ck("binomial_pmf(3,5,0.5)=0.3125", pmf35, 0.3125, 0.0001)

    // cdf(5,5,0.5) = 1.0 (all outcomes)
    let cdf55 = binomial_cdf(5, 5, 0.5)
    ck("binomial_cdf(5,5,0.5)=1.0", cdf55, 1.0, 0.0001)

    // mean(10, 0.3) = 3.0
    let mean103 = binomial_mean(10, 0.3)
    ck("binomial_mean(10,0.3)=3.0", mean103, 3.0, 0.0001)

    // pmf(0, 10, 0.1) = 0.9^10 = 0.34868
    let pmf0_10_01 = binomial_pmf(0, 10, 0.1)
    ck("binomial_pmf(0,10,0.1)=0.34868", pmf0_10_01, 0.34868, 0.001)

    // sum of all pmf(k,5,0.5) for k=0..5 = 1.0
    let sum = binomial_pmf(0, 5, 0.5)
    let sum1 = sum + binomial_pmf(1, 5, 0.5) * 1.0
    let sum2 = sum1 + binomial_pmf(2, 5, 0.5) * 1.0
    let sum3 = sum2 + binomial_pmf(3, 5, 0.5) * 1.0
    let sum4 = sum3 + binomial_pmf(4, 5, 0.5) * 1.0
    let sum5 = sum4 + binomial_pmf(5, 5, 0.5) * 1.0
    ck("sum_pmf(0..5,5,0.5)=1.0", sum5, 1.0, 0.0001)

    print("PASS _dist_binomial_test")
