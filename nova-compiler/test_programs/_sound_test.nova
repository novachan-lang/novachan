// KAT for std/physics/sound — acoustics formulas.
import std/physics/sound

// approx — float equality within 0.001 tolerance.
fn approx(a, b)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < 0.001

// approx_rel — relative tolerance for large/small magnitudes.
fn approx_rel(a, b, tol)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < tol

fn ckf(label, got, want)
    if not approx(got, want)
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ck_true(label, val)
    if not val
        print("FAIL " + label)
        exit(1)

fn main()
    // speed_in_air: v = 331.3 + 0.606*T
    // T=0 -> 331.3
    ckf("speed_in_air(0)", speed_in_air(0.0), 331.3)
    // T=20 -> 331.3 + 12.12 = 343.42
    ckf("speed_in_air(20)", speed_in_air(20.0), 343.42)
    // T=100 -> 331.3 + 60.6 = 391.9
    ckf("speed_in_air(100)", speed_in_air(100.0), 391.9)

    // beat_frequency: |f1 - f2|
    // 440 vs 444 -> 4
    ckf("beat_frequency(440,444)", beat_frequency(440.0, 444.0), 4.0)
    // 444 vs 440 -> 4 (order reversed — must be abs)
    ckf("beat_frequency(444,440)", beat_frequency(444.0, 440.0), 4.0)
    // same frequency -> 0
    ckf("beat_frequency(500,500)", beat_frequency(500.0, 500.0), 0.0)

    // intensity_db: dB = 10*log10(I/1e-12)
    // I=1e-12 (threshold) -> 0 dB
    let i_threshold = 1.0 * pow(10.0, -12.0)
    let db0 = intensity_db(i_threshold)
    ck_true("intensity_db(1e-12)=0", approx(db0, 0.0))
    // I=1e-11 -> 10 dB
    let i_10db = 1.0 * pow(10.0, -11.0)
    let db10 = intensity_db(i_10db)
    ck_true("intensity_db(1e-11)=10", approx(db10, 10.0))
    // I=1e-2 (very loud) -> 100 dB
    let i_100db = 1.0 * pow(10.0, -2.0)
    let db100 = intensity_db(i_100db)
    ck_true("intensity_db(1e-2)=100", approx(db100, 100.0))

    // doppler_observed: f*(vsound+vobs)/(vsound-vsrc)
    // vobs=vsrc=0 -> returns f unchanged
    let fobs0 = doppler_observed(440.0, 340.0, 0.0, 0.0)
    ckf("doppler(440,340,0,0)=440", fobs0, 440.0)
    // source moving toward observer at 34 m/s: f*340/(340-34) = 440*340/306 = 488.888...
    let fobs1 = doppler_observed(440.0, 340.0, 0.0, 34.0)
    ck_true("doppler src toward", approx_rel(fobs1, 488.888, 0.1))
    // observer moving toward source at 34 m/s: f*(340+34)/340 = 440*374/340 = 483.999...
    let fobs2 = doppler_observed(440.0, 340.0, 34.0, 0.0)
    ck_true("doppler obs toward", approx_rel(fobs2, 484.0, 0.1))

    print("PASS _sound_test")
