import forge_dependency_resolver

fn main()
    let d = dr_new()
    d = dr_add_package(d, "web", 1)
    d = dr_add_package(d, "db", 2)
    d = dr_add_package(d, "auth", 1)

    d = dr_add_dependency(d, "web", "db")
    d = dr_add_dependency(d, "web", "auth")
    d = dr_add_dependency(d, "auth", "db")

    assert(dr_total_packages(d) == 3, "3 packages")
    assert(dr_dep_count_for(d, "web") == 2, "web has 2 deps")
    assert(dr_dep_count_for(d, "db") == 0, "db has 0 deps")

    assert(dr_is_satisfied(d, "web") == 1, "web satisfied")
    assert(dr_is_satisfied(d, "auth") == 1, "auth satisfied")

    d = dr_add_dependency(d, "web", "missing-pkg")
    assert(dr_is_satisfied(d, "web") == 0, "web unsatisfied")
    assert(dr_missing_deps(d, "web") == 1, "1 missing")

    assert(dr_reverse_deps(d, "db") == 2, "db depended on by 2")
    assert(dr_reverse_deps(d, "auth") == 1, "auth depended on by 1")

    print("DEPENDENCY-RESOLVER KAT PASS")
