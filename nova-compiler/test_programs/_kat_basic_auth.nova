import forge_basic_auth

fn main()
    assert(basic_auth_header("admin", "secret") == "Basic YWRtaW46c2VjcmV0", "basic auth header encodes user:password")

    let creds = basic_auth_parse("Basic YWRtaW46c2VjcmV0")
    assert(creds == ["admin", "secret"], "basic auth header parses back to [user, password]")

    let bad_creds = basic_auth_parse("invalid")
    assert(len(bad_creds) == 0, "non-Basic header parses to an empty list")

    assert(bearer_from_header("Bearer tok123") == "tok123", "bearer token extracted from header")
    assert(bearer_from_header("Basic abc") == "", "a Basic header is not a bearer token")

    print("BASIC-AUTH KAT PASS")
