fn argparse_new(desc)
  let parser = {}
  parser["_desc"] = desc
  parser["_args"] = []
  parser["_flags"] = []
  parser["_pos"] = []
  parser

fn arg_add(p, name, help, default_val)
  push(p["_args"], [name, help, default_val])

fn arg_flag(p, name, help)
  push(p["_flags"], [name, help])

fn arg_positional(p, name, help)
  push(p["_pos"], [name, help])

fn _strip_dashes(name)
  if starts_with(name, "--")
    return slice(name, 2, len(name))
  if starts_with(name, "-")
    return slice(name, 1, len(name))
  name

fn arg_usage(p)
  let lines = []
  push(lines, "Usage: program [OPTIONS]")
  push(lines, "")
  push(lines, str(p["_desc"]))
  push(lines, "")
  push(lines, "Options:")
  let args = p["_args"]
  let ai = 0
  while ai < len(args)
    let a = args[ai]
    push(lines, "  " + str(a[0]) + " <value>  " + str(a[1]))
    ai = ai + 1
  let flags = p["_flags"]
  let fi = 0
  while fi < len(flags)
    let f = flags[fi]
    push(lines, "  " + str(f[0]) + "  " + str(f[1]))
    fi = fi + 1
  push(lines, "  --help          Show this help")
  join(lines, "\n")

fn arg_parse(p, argv)
  let result = {}
  let args = p["_args"]
  let flags = p["_flags"]
  let positionals = p["_pos"]
  let ai = 0
  while ai < len(args)
    let entry = args[ai]
    let key = _strip_dashes(entry[0])
    result[key] = entry[2]
    ai = ai + 1
  let fi = 0
  while fi < len(flags)
    let fentry = flags[fi]
    let fkey = _strip_dashes(fentry[0])
    result[fkey] = 0
    fi = fi + 1
  let pos_idx = 0
  let i = 0
  while i < len(argv)
    let a = argv[i]
    if a == "--help" or a == "-h"
      print(arg_usage(p))
      result["_help"] = 1
      return result
    let matched = 0
    let j = 0
    while j < len(args)
      let adef = args[j]
      if a == adef[0]
        if i + 1 < len(argv)
          let ak = _strip_dashes(adef[0])
          let raw = argv[i + 1]
          let _pi = parse_int_safe(raw)
          if is_ok(_pi)
            result[ak] = unwrap(_pi)
          else
            result[ak] = raw
          i = i + 1
          matched = 1
      j = j + 1
    if matched == 0
      let k = 0
      while k < len(flags)
        let fdef = flags[k]
        if a == fdef[0]
          let fk = _strip_dashes(fdef[0])
          result[fk] = 1
          matched = 1
        k = k + 1
    if matched == 0
      if not starts_with(a, "-")
        if pos_idx < len(positionals)
          let pdef = positionals[pos_idx]
          let pname = pdef[0]
          let _pi2 = parse_int_safe(a)
          if is_ok(_pi2)
            result[pname] = unwrap(_pi2)
          else
            result[pname] = a
          pos_idx = pos_idx + 1
    i = i + 1
  result

fn main()
  let p = argparse_new("A test CLI application")
  arg_add(p, "--port", "Server port", 8080)
  arg_add(p, "--host", "Server host", "localhost")
  arg_flag(p, "--verbose", "Enable verbose output")
  arg_positional(p, "file", "Input file path")

  let r1 = arg_parse(p, ["--port", "3000", "--verbose", "input.txt"])
  assert(r1["port"] == 3000, "port parsed: " + str(r1["port"]))
  assert(r1["host"] == "localhost", "host default")
  assert(r1["verbose"] == 1, "verbose flag set")
  assert(r1["file"] == "input.txt", "positional file")

  let r2 = arg_parse(p, [])
  assert(r2["port"] == 8080, "port default")
  assert(r2["verbose"] == 0, "verbose default off")

  let r3 = arg_parse(p, ["--host", "0.0.0.0", "data.csv"])
  assert(r3["host"] == "0.0.0.0", "host override")
  assert(r3["file"] == "data.csv", "positional")
  assert(r3["port"] == 8080, "port stays default")

  let usage = arg_usage(p)
  assert(contains(usage, "--port"), "usage has port")
  assert(contains(usage, "--verbose"), "usage has verbose")
  assert(contains(usage, "--help"), "usage has help")

  print("argparsex: all passed")
