import std/geometry/segment

fn cki(label: string, got: int, expected: int)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn ckb(label: string, got: bool, expected: bool)
    let gi = 0
    if got
        gi = 1
    let ei = 0
    if expected
        ei = 1
    if gi != ei
        print("FAIL " + label + ": got " + str(gi) + " expected " + str(ei))
        exit(1)

fn main()
    // KAT 1: collinear triple (0,0)-(1,1)-(2,2) -> 0
    let o1 = sg_orientation(0, 0, 1, 1, 2, 2)
    cki("orient_collinear", o1, 0)

    // KAT 2: counter-clockwise turn (0,0)-(4,0)-(4,4) -> 2
    let o2 = sg_orientation(0, 0, 4, 0, 4, 4)
    cki("orient_ccw", o2, 2)

    // KAT 3: clockwise turn (0,0)-(4,0)-(4,-4) -> 1
    let o3 = sg_orientation(0, 0, 4, 0, 4, -4)
    cki("orient_cw", o3, 1)

    // KAT 4: proper X-crossing -> true
    let i4 = sg_intersect([0, 0], [4, 4], [0, 4], [4, 0])
    ckb("intersect_x_cross", i4, true)

    // KAT 5: collinear, disjoint gap ([0,1] vs [2,3]) -> false
    let i5 = sg_intersect([0, 0], [1, 1], [2, 2], [3, 3])
    ckb("intersect_collinear_gap", i5, false)

    // KAT 6: collinear overlap ([0,2] vs [1,3]) -> true
    let i6 = sg_intersect([0, 0], [2, 0], [1, 0], [3, 0])
    ckb("intersect_collinear_overlap", i6, true)

    // KAT 7: collinear, adjacent but not touching ([0,1] vs [2,3]) -> false
    let i7 = sg_intersect([0, 0], [1, 0], [2, 0], [3, 0])
    ckb("intersect_collinear_disjoint", i7, false)

    print("_segment_test passed")
