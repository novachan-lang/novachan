import prism_ui_divider
import prism_node
import prism_arrange
import prism_content

fn main()
    print("== KAT prism_ui_divider ==")
    let mut passed = 0
    let mut failed = 0

    // 1. horizontal
    let r1 = prism_ui_divider.prism_dv_horizontal()
    if is_ok(r1)
        let n = unwrap(r1)
        if prism_node.prism_node_kind_str(n) == "label"
            print("  ok  horizontal_is_label")
            passed += 1
        else
            print("FAIL horizontal_is_label: got " + prism_node.prism_node_kind_str(n))
            failed += 1
        if prism_node.prism_node_attr_str(n, "text", "") == "---"
            print("  ok  horizontal_text")
            passed += 1
        else
            print("FAIL horizontal_text")
            failed += 1
    else
        print("FAIL horizontal: " + unwrap_err(r1))
        failed += 2

    // 2. vertical
    let r2 = prism_ui_divider.prism_dv_vertical()
    if is_ok(r2)
        let n2 = unwrap(r2)
        if prism_node.prism_node_attr_str(n2, "text", "") == "|"
            print("  ok  vertical_text")
            passed += 1
        else
            print("FAIL vertical_text")
            failed += 1
    else
        print("FAIL vertical: " + unwrap_err(r2))
        failed += 1

    // 3. labeled happy path
    let r3 = prism_ui_divider.prism_dv_labeled("Section A")
    if is_ok(r3)
        print("  ok  labeled_ok")
        passed += 1
        let n3 = unwrap(r3)
        if prism_node.prism_node_kind_str(n3) == "band"
            print("  ok  labeled_is_band")
            passed += 1
        else
            print("FAIL labeled_is_band: got " + prism_node.prism_node_kind_str(n3))
            failed += 1
        let ch3 = prism_node.prism_node_children(n3)
        if len(ch3) == 3
            print("  ok  labeled_3_children")
            passed += 1
        else
            print("FAIL labeled_3_children: got " + str(len(ch3)))
            failed += 1
        if prism_node.prism_node_attr_str(ch3[1], "text", "") == "Section A"
            print("  ok  labeled_middle_text")
            passed += 1
        else
            print("FAIL labeled_middle_text")
            failed += 1
        if prism_node.prism_node_attr_str(ch3[0], "text", "") == "---"
            print("  ok  labeled_left_dash")
            passed += 1
        else
            print("FAIL labeled_left_dash")
            failed += 1
        if prism_node.prism_node_attr_str(ch3[2], "text", "") == "---"
            print("  ok  labeled_right_dash")
            passed += 1
        else
            print("FAIL labeled_right_dash")
            failed += 1
    else
        print("FAIL labeled_ok: " + unwrap_err(r3))
        failed += 6

    // 4. labeled empty text error
    let r4 = prism_ui_divider.prism_dv_labeled("")
    if is_err(r4)
        print("  ok  labeled_err_empty")
        passed += 1
    else
        print("FAIL labeled_err_empty")
        failed += 1

    // 5. spaced happy path
    let r5 = prism_ui_divider.prism_dv_spaced(12)
    if is_ok(r5)
        print("  ok  spaced_ok")
        passed += 1
        let n5 = unwrap(r5)
        if prism_node.prism_node_kind_str(n5) == "stack"
            print("  ok  spaced_is_stack")
            passed += 1
        else
            print("FAIL spaced_is_stack: got " + prism_node.prism_node_kind_str(n5))
            failed += 1
        let ch5 = prism_node.prism_node_children(n5)
        if len(ch5) == 3
            print("  ok  spaced_3_children")
            passed += 1
        else
            print("FAIL spaced_3_children: got " + str(len(ch5)))
            failed += 1
        if prism_node.prism_node_kind_str(ch5[0]) == "gap"
            print("  ok  spaced_top_is_gap")
            passed += 1
        else
            print("FAIL spaced_top_is_gap: got " + prism_node.prism_node_kind_str(ch5[0]))
            failed += 1
        if prism_node.prism_node_kind_str(ch5[2]) == "gap"
            print("  ok  spaced_bottom_is_gap")
            passed += 1
        else
            print("FAIL spaced_bottom_is_gap: got " + prism_node.prism_node_kind_str(ch5[2]))
            failed += 1
        if not prism_arrange.prism_gap_is_flexible(ch5[0])
            print("  ok  spaced_gap_fixed")
            passed += 1
        else
            print("FAIL spaced_gap_fixed")
            failed += 1
        if prism_arrange.prism_gap_size(ch5[0], -1) == 12
            print("  ok  spaced_gap_size_12")
            passed += 1
        else
            print("FAIL spaced_gap_size_12: got " + str(prism_arrange.prism_gap_size(ch5[0], -1)))
            failed += 1
        if prism_node.prism_node_kind_str(ch5[1]) == "label"
            print("  ok  spaced_middle_is_label")
            passed += 1
        else
            print("FAIL spaced_middle_is_label")
            failed += 1
    else
        print("FAIL spaced_ok: " + unwrap_err(r5))
        failed += 8

    // 6. spaced zero error
    let r6 = prism_ui_divider.prism_dv_spaced(0)
    if is_err(r6)
        print("  ok  spaced_err_zero")
        passed += 1
    else
        print("FAIL spaced_err_zero")
        failed += 1

    // 7. spaced negative error
    let r7 = prism_ui_divider.prism_dv_spaced(-5)
    if is_err(r7)
        print("  ok  spaced_err_neg")
        passed += 1
    else
        print("FAIL spaced_err_neg")
        failed += 1

    // 8. section happy path
    let c1 = unwrap(prism_content.prism_label("Item One"))
    let c2 = unwrap(prism_content.prism_label("Item Two"))
    let r8 = prism_ui_divider.prism_dv_section("My Section", [c1, c2])
    if is_ok(r8)
        print("  ok  section_ok")
        passed += 1
        let n8 = unwrap(r8)
        if prism_node.prism_node_kind_str(n8) == "stack"
            print("  ok  section_is_stack")
            passed += 1
        else
            print("FAIL section_is_stack: got " + prism_node.prism_node_kind_str(n8))
            failed += 1
        let ch8 = prism_node.prism_node_children(n8)
        if len(ch8) == 3
            print("  ok  section_3_children")
            passed += 1
        else
            print("FAIL section_3_children: got " + str(len(ch8)))
            failed += 1
        if prism_node.prism_node_kind_str(ch8[0]) == "band"
            print("  ok  section_heading_is_band")
            passed += 1
        else
            print("FAIL section_heading_is_band: got " + prism_node.prism_node_kind_str(ch8[0]))
            failed += 1
    else
        print("FAIL section_ok: " + unwrap_err(r8))
        failed += 4

    // 9. section empty title
    let r9 = prism_ui_divider.prism_dv_section("", [c1])
    if is_err(r9)
        print("  ok  section_err_empty_title")
        passed += 1
    else
        print("FAIL section_err_empty_title")
        failed += 1

    // 10. section empty children
    let r10 = prism_ui_divider.prism_dv_section("Title", [])
    if is_err(r10)
        print("  ok  section_err_empty_children")
        passed += 1
    else
        print("FAIL section_err_empty_children")
        failed += 1

    // 11. section non-PrismNode child
    let r11 = prism_ui_divider.prism_dv_section("Title", ["not_a_node"])
    if is_err(r11)
        print("  ok  section_err_bad_child")
        passed += 1
    else
        print("FAIL section_err_bad_child")
        failed += 1

    print("== " + str(passed) + " passed, " + str(failed) + " failed ==")
    if failed > 0
        exit(1)
