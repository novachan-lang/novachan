// Function-by-name registry + dynamic apply: resolve a NOVA function from a
// runtime string name and invoke it with a runtime-sized argument list. This is
// the primitive that unblocks distributed spawn (the remote node resolves the
// requested function by name). Covers arity 0/1/2.
fn add(a, b)
    a + b

fn negate(x)
    0 - x

fn answer()
    42

fn main()
    assert_eq(call_by_name("add", [3, 4]), 7)
    assert_eq(call_by_name("negate", [9]), 0 - 9)
    assert_eq(call_by_name("answer", []), 42)
    print("call_by_name_test passed")
