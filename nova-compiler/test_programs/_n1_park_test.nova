// Stage 3a guard (run with NOVA_CARRIERS>1): many green tasks PARK on sleep across carriers, stressing
// nova_sched_park_sleep + the carrier wake_sleepers scan. The bug: status=2 was set AFTER the publish
// unlock, so a wake-scan on another carrier could set status=0 + enqueue, then get clobbered back to
// status=2 -> the task is enqueued-but-parked -> NEVER woken -> HANG. If any worker hangs, main never
// collects all of them and the test times out (kill-on-timeout). With the fix, all complete.
fn worker(reps)
    let i = 0
    while i < reps
        sleep(1)          // park_sleep: yields carrier, deadline-woken (the race window)
        i = i + 1
    reps

fn main() -> int
    let workers = 16
    let reps = 40
    let hub = channel()
    let w = 0
    while w < workers
        spawn fn()
            send(hub, worker(reps))
        w = w + 1
    let total = 0
    let got = 0
    while got < workers
        total = total + receive(hub)
        got = got + 1
    if total != workers * reps          // 16 * 40 = 640
        print("FAIL n1_park total=" + str(total))
        exit(1)
    print("PASS n1_park (16 workers x40 sleep-parks across carriers)")
    return 0
