import std/matrix/matlu

// Float tolerance check.
fn _ckf(label: string, got: float, want: float, tol: float)
    let diff = got - want
    if diff < 0.0
        diff = 0.0 - diff
    if diff > tol
        print("FAIL matlu " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// Bool check.
fn _ckb(label: string, got: bool, want: bool)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL matlu " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

// Approx for matrix element.
fn _approx(a: float, b: float, tol: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    d < tol

// Build a 2x2 float matrix from four values.
fn _mat2(a: float, b: float, c: float, d: float) -> dict
    let data = []
    push(data, a)
    push(data, b)
    push(data, c)
    push(data, d)
    mlu_make(2, 2, data)

// Build a 3x3 float matrix from nine values (row-major).
fn _mat3(a00: float, a01: float, a02: float, a10: float, a11: float, a12: float, a20: float, a21: float, a22: float) -> dict
    let data = []
    push(data, a00)
    push(data, a01)
    push(data, a02)
    push(data, a10)
    push(data, a11)
    push(data, a12)
    push(data, a20)
    push(data, a21)
    push(data, a22)
    mlu_make(3, 3, data)

fn main()
    let tol = 0.0001

    // ── 2x2 test: A = [[4,3],[6,3]] ──────────────────────────────────────────
    // det(A) = 4*3 - 3*6 = 12 - 18 = -6
    let a2 = _mat2(4.0, 3.0, 6.0, 3.0)
    let lu2 = mlu_decompose(a2)

    // mlu_det must be -6.0
    let det2 = mlu_det(lu2)
    _ckf("det_2x2", det2, 0.0 - 6.0, tol)

    // L must be unit-lower-triangular: diagonal all 1, top-right = 0.
    let L2 = mlu_l(lu2)
    _ckf("L_diag0", mlu_get(L2, 0, 0), 1.0, tol)
    _ckf("L_diag1", mlu_get(L2, 1, 1), 1.0, tol)
    _ckf("L_upper", mlu_get(L2, 0, 1), 0.0, tol)

    // U must be upper-triangular: lower-left = 0.
    let U2 = mlu_u(lu2)
    _ckf("U_lower", mlu_get(U2, 1, 0), 0.0, tol)

    // mlu_verify: P*A == L*U.
    let ok2 = mlu_verify(a2, tol)
    _ckb("verify_2x2", ok2, true)

    // mlu_solve: A*x = [10, 12].
    // A = [[4,3],[6,3]], b = [10,12]
    // By hand: 6x0 + 3x1 = 12, 4x0 + 3x1 = 10 => x0=1, x1=2.
    let b2 = []
    push(b2, 10.0)
    push(b2, 12.0)
    let x2 = mlu_solve(lu2, b2)
    _ckf("solve_2x2_x0", x2[0] * 1.0, 1.0, tol)
    _ckf("solve_2x2_x1", x2[1] * 1.0, 2.0, tol)

    // Verify A*x == b.
    let ax0 = 4.0 * (x2[0] * 1.0) + 3.0 * (x2[1] * 1.0)
    let ax1 = 6.0 * (x2[0] * 1.0) + 3.0 * (x2[1] * 1.0)
    _ckf("Ax_b_row0", ax0, 10.0, tol)
    _ckf("Ax_b_row1", ax1, 12.0, tol)

    // ── 3x3 test: A = [[2,1,1],[4,3,3],[8,7,9]] ──────────────────────────────
    // det = 2*(3*9-3*7) - 1*(4*9-3*8) + 1*(4*7-3*8) = 2*(27-21) - (36-24) + (28-24)
    //     = 2*6 - 12 + 4 = 12 - 12 + 4 = 4
    let a3 = _mat3(2.0, 1.0, 1.0, 4.0, 3.0, 3.0, 8.0, 7.0, 9.0)
    let lu3 = mlu_decompose(a3)

    let ok3 = mlu_verify(a3, tol)
    _ckb("verify_3x3", ok3, true)

    // L diagonal must all be 1.0.
    let L3 = mlu_l(lu3)
    _ckf("L3_diag0", mlu_get(L3, 0, 0), 1.0, tol)
    _ckf("L3_diag1", mlu_get(L3, 1, 1), 1.0, tol)
    _ckf("L3_diag2", mlu_get(L3, 2, 2), 1.0, tol)

    // L upper triangle must be 0.
    _ckf("L3_01", mlu_get(L3, 0, 1), 0.0, tol)
    _ckf("L3_02", mlu_get(L3, 0, 2), 0.0, tol)
    _ckf("L3_12", mlu_get(L3, 1, 2), 0.0, tol)

    // U lower triangle must be 0.
    let U3 = mlu_u(lu3)
    _ckf("U3_10", mlu_get(U3, 1, 0), 0.0, tol)
    _ckf("U3_20", mlu_get(U3, 2, 0), 0.0, tol)
    _ckf("U3_21", mlu_get(U3, 2, 1), 0.0, tol)

    // det_3x3 == 4.
    let det3 = mlu_det(lu3)
    _ckf("det_3x3", det3, 4.0, tol)

    // mlu_reconstruct produces L*U.
    let recon3 = mlu_reconstruct(lu3)
    let P3 = mlu_p(lu3)
    let pa3 = mlu_matmul(P3, a3)
    let ri = 0
    while ri < 3
        let rj = 0
        while rj < 3
            let rv = mlu_get(recon3, ri, rj)
            let pv = mlu_get(pa3, ri, rj)
            let ok_elem = _approx(rv, pv, tol)
            if ok_elem == false
                print("FAIL matlu recon3[" + str(ri) + "][" + str(rj) + "]: got=" + str(rv) + " want=" + str(pv))
                exit(1)
            rj = rj + 1
        ri = ri + 1

    print("PASS _matlu_test")
