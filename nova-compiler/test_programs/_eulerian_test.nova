// _eulerian_test.nova — KAT for std/math/eulerian
import std/math/eulerian

fn main()
    // KAT helpers
    // cki: check int equality
    // cks: check string equality
    // ckf: check float within eps

    // --- eu_number KATs ---

    // A(0,0) = 1  (base case)
    let v1 = eu_number(0, 0)
    if v1 != 1
        print("FAIL eu_number(0,0): expected 1 got " + str(v1))
        exit(1)

    // A(1,0) = 1  (only permutation of {1} has 0 ascents)
    let v2 = eu_number(1, 0)
    if v2 != 1
        print("FAIL eu_number(1,0): expected 1 got " + str(v2))
        exit(1)

    // A(3,0) = 1  (only descending perm 3,2,1 has 0 ascents)
    let v3 = eu_number(3, 0)
    if v3 != 1
        print("FAIL eu_number(3,0): expected 1 got " + str(v3))
        exit(1)

    // A(3,1) = 4
    let v4 = eu_number(3, 1)
    if v4 != 4
        print("FAIL eu_number(3,1): expected 4 got " + str(v4))
        exit(1)

    // A(3,2) = 1  (only ascending perm 1,2,3 has 2 ascents)
    let v5 = eu_number(3, 2)
    if v5 != 1
        print("FAIL eu_number(3,2): expected 1 got " + str(v5))
        exit(1)

    // A(4,1) = 11
    let v6 = eu_number(4, 1)
    if v6 != 11
        print("FAIL eu_number(4,1): expected 11 got " + str(v6))
        exit(1)

    // A(5,2) = 66
    let v7 = eu_number(5, 2)
    if v7 != 66
        print("FAIL eu_number(5,2): expected 66 got " + str(v7))
        exit(1)

    // A(4,2) = 11  (row 4 is symmetric: 1,11,11,1)
    let v8 = eu_number(4, 2)
    if v8 != 11
        print("FAIL eu_number(4,2): expected 11 got " + str(v8))
        exit(1)

    // A(n,k)=0 for k>=n when n>0
    let v9 = eu_number(3, 3)
    if v9 != 0
        print("FAIL eu_number(3,3): expected 0 got " + str(v9))
        exit(1)

    // A(n,k)=0 for k<0
    let v10 = eu_number(3, -1)
    if v10 != 0
        print("FAIL eu_number(3,-1): expected 0 got " + str(v10))
        exit(1)

    // --- eu_row KATs ---

    // eu_row(3) == [1,4,1]
    let r3 = eu_row(3)
    let r3len = len(r3)
    if r3len != 3
        print("FAIL eu_row(3) length: expected 3 got " + str(r3len))
        exit(1)
    let r3_0 = r3[0]
    let r3_1 = r3[1]
    let r3_2 = r3[2]
    if r3_0 != 1
        print("FAIL eu_row(3)[0]: expected 1 got " + str(r3_0))
        exit(1)
    if r3_1 != 4
        print("FAIL eu_row(3)[1]: expected 4 got " + str(r3_1))
        exit(1)
    if r3_2 != 1
        print("FAIL eu_row(3)[2]: expected 1 got " + str(r3_2))
        exit(1)

    // eu_row(4) == [1,11,11,1]
    let r4 = eu_row(4)
    let r4len = len(r4)
    if r4len != 4
        print("FAIL eu_row(4) length: expected 4 got " + str(r4len))
        exit(1)
    let r4_0 = r4[0]
    let r4_1 = r4[1]
    let r4_2 = r4[2]
    let r4_3 = r4[3]
    if r4_0 != 1
        print("FAIL eu_row(4)[0]: expected 1 got " + str(r4_0))
        exit(1)
    if r4_1 != 11
        print("FAIL eu_row(4)[1]: expected 11 got " + str(r4_1))
        exit(1)
    if r4_2 != 11
        print("FAIL eu_row(4)[2]: expected 11 got " + str(r4_2))
        exit(1)
    if r4_3 != 1
        print("FAIL eu_row(4)[3]: expected 1 got " + str(r4_3))
        exit(1)

    // eu_row(0) == [1]
    let r0 = eu_row(0)
    let r0len = len(r0)
    if r0len != 1
        print("FAIL eu_row(0) length: expected 1 got " + str(r0len))
        exit(1)
    let r0_0 = r0[0]
    if r0_0 != 1
        print("FAIL eu_row(0)[0]: expected 1 got " + str(r0_0))
        exit(1)

    // eu_row(1) == [1]
    let r1 = eu_row(1)
    let r1len = len(r1)
    if r1len != 1
        print("FAIL eu_row(1) length: expected 1 got " + str(r1len))
        exit(1)
    let r1_0 = r1[0]
    if r1_0 != 1
        print("FAIL eu_row(1)[0]: expected 1 got " + str(r1_0))
        exit(1)

    // --- eu_triangle KAT ---
    // eu_triangle(3) produces rows 0,1,2,3
    // Row sums: row 0 sum=1=0!, row 1 sum=1=1!, row 2 sum=2=2!, row 3 sum=6=3!
    let tri = eu_triangle(3)
    let trilen = len(tri)
    if trilen != 4
        print("FAIL eu_triangle(3) length: expected 4 got " + str(trilen))
        exit(1)

    // Row 3 of triangle should have 4 elements (indices 0..3), where index 3=0
    let row3 = tri[3]
    let row3len = len(row3)
    if row3len != 4
        print("FAIL eu_triangle(3) row3 length: expected 4 got " + str(row3len))
        exit(1)

    // Sum of row 3 first 3 elements = 1+4+1=6=3!
    let s0 = row3[0]
    let s1 = row3[1]
    let s2 = row3[2]
    let rowsum = s0 + s1 + s2
    if rowsum != 6
        print("FAIL eu_triangle row3 sum (excl trailing 0): expected 6 got " + str(rowsum))
        exit(1)

    // A(5,1)=26, A(5,3)=26 (symmetry: A(n,k)=A(n,n-1-k))
    let v11 = eu_number(5, 1)
    if v11 != 26
        print("FAIL eu_number(5,1): expected 26 got " + str(v11))
        exit(1)
    let v12 = eu_number(5, 3)
    if v12 != 26
        print("FAIL eu_number(5,3): expected 26 got " + str(v12))
        exit(1)

    // Row sum of eu_row(5) should be 5! = 120
    let r5 = eu_row(5)
    let r5len = len(r5)
    if r5len != 5
        print("FAIL eu_row(5) length: expected 5 got " + str(r5len))
        exit(1)
    let a = r5[0]
    let b = r5[1]
    let c = r5[2]
    let d = r5[3]
    let e = r5[4]
    let sum5 = a + b + c + d + e
    if sum5 != 120
        print("FAIL eu_row(5) sum: expected 120 got " + str(sum5))
        exit(1)

    print("_eulerian_test passed")
