// KAT: forge_signed_url -- HMAC-signed, self-expiring tokens and presigned URLs.
import forge_signed_url

fn main()
    let secret = "mysecret"
    let token = sign_token(secret, "order123", 2000000000)

    let parts = split(token, ".")
    assert(len(parts) == 3, "sign_token produces payload.expiry.sig (3 dot-separated parts)")

    let valid = verify_token(secret, token, 1000000000)
    assert(valid == "order123", "verify_token returns the payload when unexpired and correctly signed")

    let expired = verify_token(secret, token, 3000000000)
    assert(expired == "", "verify_token returns empty string once now_seconds passes the expiry")

    let wrong_secret = verify_token("wrong", token, 1000000000)
    assert(wrong_secret == "", "verify_token returns empty string on a tampered/wrong secret")

    let malformed = verify_token(secret, "bad", 1000)
    assert(malformed == "", "verify_token returns empty string for a malformed (non 3-part) token")

    let url1 = signed_url("https://example.com/dl", "s", "file1", 99999)
    assert(find(url1, "?t=") >= 0, "signed_url appends ?t=<token> when the base URL has no query string")

    let url2 = signed_url("https://example.com/dl?v=2", "s", "file1", 99999)
    assert(find(url2, "&t=") >= 0, "signed_url appends &t=<token> when the base URL already has a query string")

    print("SIGNED-URL KAT PASS")
