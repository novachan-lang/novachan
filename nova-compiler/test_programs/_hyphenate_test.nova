import std/text/hyphenate

// KAT 1: hello -> hel-lo  (VCCV: e,l,l,o -> break at index 3)
let r1 = hy_hyphenate("hello", "-")
if r1 != "hel-lo"
    print("FAIL KAT1: hy_hyphenate(hello,-) got " + r1)
    exit(1)

// KAT 2: hy_points("hello") == [3]
let pts2 = hy_points("hello")
if len(pts2) != 1
    print("FAIL KAT2: hy_points(hello) length got " + str(len(pts2)))
    exit(1)
let pt2v = pts2[0]
if pt2v != 3
    print("FAIL KAT2: hy_points(hello)[0] got " + str(pt2v))
    exit(1)

// KAT 3: pattern -> pat-tern  (VCCV: a,t,t,e -> break at index 3)
let r3 = hy_hyphenate("pattern", "-")
if r3 != "pat-tern"
    print("FAIL KAT3: hy_hyphenate(pattern,-) got " + r3)
    exit(1)

// KAT 4: cat -> cat  (only 3 chars, no VCCV window)
let r4 = hy_hyphenate("cat", "-")
if r4 != "cat"
    print("FAIL KAT4: hy_hyphenate(cat,-) got " + r4)
    exit(1)

// KAT 5: hy_syllables("hello") == ["hel","lo"]
let s5 = hy_syllables("hello")
if len(s5) != 2
    print("FAIL KAT5: hy_syllables(hello) length got " + str(len(s5)))
    exit(1)
let s5a = s5[0]
let s5b = s5[1]
if s5a != "hel"
    print("FAIL KAT5: hy_syllables(hello)[0] got " + s5a)
    exit(1)
if s5b != "lo"
    print("FAIL KAT5: hy_syllables(hello)[1] got " + s5b)
    exit(1)

// KAT 6: running -> run-ning  (VCCV: u,n,n,i -> break at index 3)
let r6 = hy_hyphenate("running", "-")
if r6 != "run-ning"
    print("FAIL KAT6: hy_hyphenate(running,-) got " + r6)
    exit(1)

// KAT 7: custom separator
let r7 = hy_hyphenate("pattern", "|")
if r7 != "pat|tern"
    print("FAIL KAT7: hy_hyphenate(pattern,|) got " + r7)
    exit(1)

// KAT 8: single-char word -> no break
let r8 = hy_hyphenate("a", "-")
if r8 != "a"
    print("FAIL KAT8: hy_hyphenate(a,-) got " + r8)
    exit(1)

print("_hyphenate_test passed")
