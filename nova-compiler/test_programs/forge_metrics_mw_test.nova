// Forge T8.2: the auto-metrics middleware. use(app, mw_metrics(reg)) observes every request into the
// RED registry, keyed by the route PATTERN (so /users/42 and /users/99 fold under /users/:id -> bounded
// label cardinality). End-to-end through dispatch_req (folds the middleware around the route terminal),
// socketless, deterministic, kill-on-timeout.
import forge
import forge_obs

fn h_user(req)
    resp_text(200, "user")

fn _count_for(reg, key: string) -> int
    let snap = metrics_snapshot(reg)
    let entries = snap["entries"]
    let c = 0
    let i = 0
    while i < len(entries)
        if entries[i]["key"] == key
            c = entries[i]["count"]
        i = i + 1
    c

fn main()
    let reg = metrics_registry()
    let a = app()
    use(a, mw_metrics(reg))
    get(a, "/users/:id", h_user)

    let resp = dispatch_req(a, build_request("GET /users/42 HTTP/1.1\r\n\r\n", 0))
    if resp.status != 200
        print("FAIL: status should be 200, got " + str(resp.status))
        exit(1)
    if _count_for(reg, "GET /users/:id") != 1
        print("FAIL: registry should have observed GET /users/:id once")
        exit(1)

    // a second request to a DIFFERENT id folds under the SAME pattern (bounded cardinality)
    dispatch_req(a, build_request("GET /users/99 HTTP/1.1\r\n\r\n", 0))
    let cnt = _count_for(reg, "GET /users/:id")
    if cnt != 2
        print("FAIL: /users/42 + /users/99 must fold under /users/:id -> count 2, got " + str(cnt))
        exit(1)

    print("PASS forge_metrics_mw (auto-observe; /users/42 + /users/99 fold under /users/:id, count 2)")
