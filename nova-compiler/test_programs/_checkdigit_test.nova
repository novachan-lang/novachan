// _checkdigit_test.nova — KAT for std/math/checkdigit
import std/math/checkdigit

fn cki(label: string, got: int, expected: int)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(label: string, got: string, expected: string)
    if got != expected
        print("FAIL " + label + ": got " + got + " expected " + expected)
        exit(1)

fn ckb(label: string, got: bool, expected: bool)
    if got != expected
        let gs = "false"
        if got
            gs = "true"
        let es = "false"
        if expected
            es = "true"
        print("FAIL " + label + ": got " + gs + " expected " + es)
        exit(1)

fn main()
    // --- Luhn validity ---
    // 4539148803436467 is a valid Luhn card number (total=80)
    ckb("luhn_valid_true",  cd_luhn_valid("4539148803436467"), true)
    // 4539148803436460 fails (total=73)
    ckb("luhn_valid_false", cd_luhn_valid("4539148803436460"), false)
    // Spaces/dashes ignored: same card with spaces
    ckb("luhn_valid_spaces", cd_luhn_valid("4539 1488 0343 6467"), true)

    // --- Luhn check digit computation ---
    // cd_luhn("7992739871") should return 3
    cki("luhn_check_digit", cd_luhn("7992739871"), 3)
    // Verify: "79927398713" is valid
    ckb("luhn_check_verify", cd_luhn_valid("79927398713"), true)
    // A single-digit partial: check digit for "0" appended as placeholder
    // luhn("") = 0 (empty -> sum=0 -> (10-0)%10=0)
    cki("luhn_empty", cd_luhn(""), 0)

    // --- ISBN-13 check digit ---
    // "978030640615" -> 7 (sum=93, (10-3)=7)
    cki("isbn13_check", cd_isbn13_check("978030640615"), 7)

    // --- ISBN-13 validity ---
    ckb("isbn13_valid_true",  cd_isbn13_valid("9780306406157"), true)
    ckb("isbn13_valid_false", cd_isbn13_valid("9780306406158"), false)
    // Wrong length -> false
    ckb("isbn13_len_false", cd_isbn13_valid("978030640615"), false)

    // --- ISBN-10 check character ---
    // "030640615" -> "2" (sum=130, rem=9, chk=(11-9)%11=2)
    cks("isbn10_check_digit", cd_isbn10_check("030640615"), "2")
    // A prefix that yields X: "156881385" -> check = ?
    // sum = 1*10+5*9+6*8+8*7+8*6+1*5+3*4+8*3+5*2
    //     = 10+45+48+56+48+5+12+24+10 = 258; 258%11=5; (11-5)%11=6 -> "6"
    cks("isbn10_check_6", cd_isbn10_check("156881385"), "6")

    // --- ISBN-10 validity ---
    ckb("isbn10_valid_true",  cd_isbn10_valid("0306406152"), true)
    ckb("isbn10_valid_false", cd_isbn10_valid("0306406153"), false)
    // Wrong length -> false
    ckb("isbn10_len_false", cd_isbn10_valid("030640615"), false)

    print("_checkdigit_test passed")
