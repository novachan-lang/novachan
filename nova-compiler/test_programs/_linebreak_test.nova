// KAT for std/textlayout/linebreak — line-breaking algorithms.
import std/textlayout/linebreak

fn cks(label, got, want)
    if got != want
        print("FAIL linebreak " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL linebreak " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    // bool: want is 0 or 1 (false/true)
    if got != want
        print("FAIL linebreak " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// Check a list of strings matches expected list.
fn ck_slist(label, got, want)
    if len(got) != len(want)
        print("FAIL linebreak " + label + ": len(got)=" + str(len(got)) + " len(want)=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL linebreak " + label + "[" + str(i) + "]: got='" + got[i] + "' want='" + want[i] + "'")
            exit(1)
        i = i + 1

// Check a list of ints matches expected.
fn ck_ilist(label, got, want)
    if len(got) != len(want)
        print("FAIL linebreak " + label + ": len(got)=" + str(len(got)) + " len(want)=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL linebreak " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // ── lb_word_widths ───────────────────────────────────────────────────────
    let w1 = ["the", "quick", "brown"]
    ck_ilist("lb_word_widths", lb_word_widths(w1), [3, 5, 5])
    ck_ilist("lb_word_widths-empty", lb_word_widths([]), [])

    // ── lb_fits_line ─────────────────────────────────────────────────────────
    // lb_fits_line(['ab','cd'], 0, 2, 5):
    //   used = len('ab')+len('cd') + 1 space = 2+2+1 = 5 <= 5 -> true
    let fw = ["ab", "cd"]
    ckb("lb_fits_line-true",  lb_fits_line(fw, 0, 2, 5), 1)
    // lb_fits_line(['ab','cd'], 0, 2, 4): 5 > 4 -> false
    ckb("lb_fits_line-false", lb_fits_line(fw, 0, 2, 4), 0)
    // Single word: fits if width >= word_len.
    ckb("lb_fits_line-single-ok",   lb_fits_line(fw, 0, 1, 2), 1)
    // 'ab' has len=2, width=1 -> does not fit
    ckb("lb_fits_line-single-fail", lb_fits_line(fw, 0, 1, 1), 0)
    // Empty range always fits.
    ckb("lb_fits_line-empty", lb_fits_line(fw, 0, 0, 0), 1)

    // ── lb_greedy_lines ──────────────────────────────────────────────────────
    // ['the','quick','brown','fox'], width=10
    //   'the'(3) -> 'the'
    //   'the quick'(9) <= 10 -> ok
    //   'the quick brown'(15) > 10 -> flush, start 'brown'
    //   'brown fox'(9) <= 10 -> ok
    //   -> ['the quick', 'brown fox']
    let w2 = ["the", "quick", "brown", "fox"]
    ck_slist("lb_greedy_lines-10", lb_greedy_lines(w2, 10), ["the quick", "brown fox"])

    // ['aaaa','bb','cc'], width=4
    //   'aaaa'(4) <= 4 -> ok
    //   'aaaa bb'(7) > 4 -> flush, start 'bb'
    //   'bb cc'(5) > 4 -> flush, start 'cc'
    //   -> ['aaaa', 'bb', 'cc']
    let w3 = ["aaaa", "bb", "cc"]
    ck_slist("lb_greedy_lines-4", lb_greedy_lines(w3, 4), ["aaaa", "bb", "cc"])

    // Single word
    ck_slist("lb_greedy_lines-single", lb_greedy_lines(["hello"], 10), ["hello"])

    // Empty words
    ck_slist("lb_greedy_lines-empty", lb_greedy_lines([], 10), [])

    // ── lb_break_points ──────────────────────────────────────────────────────
    // ['the','quick','brown','fox'], width=10 -> two lines, second starts at idx 2
    ck_ilist("lb_break_points-2lines", lb_break_points(w2, 10), [2])

    // ['a','b','c'], width=1 -> three lines, break at 1 and 2
    ck_ilist("lb_break_points-3lines", lb_break_points(["a", "b", "c"], 1), [1, 2])

    // One line: no break points
    ck_ilist("lb_break_points-1line", lb_break_points(["a", "b"], 10), [])

    // ── lb_line_count ────────────────────────────────────────────────────────
    // ['a','b','c'], width=1 -> each word alone -> 3 lines
    cki("lb_line_count-3", lb_line_count(["a", "b", "c"], 1), 3)
    cki("lb_line_count-1", lb_line_count(["hello", "world"], 20), 1)
    cki("lb_line_count-2", lb_line_count(w2, 10), 2)
    cki("lb_line_count-empty", lb_line_count([], 10), 0)

    // ── lb_cost_greedy ───────────────────────────────────────────────────────
    // ['the','quick','brown','fox'], width=10
    //   line 0 = 'the quick' (9 chars), trailing=10-9=1, cost=1
    //   line 1 = 'brown fox' (9 chars), last line NOT penalised
    //   total = 1
    cki("lb_cost_greedy-1", lb_cost_greedy(w2, 10), 1)
    // Width=20, all on one line -> no trailing on the only (last) line -> cost=0
    cki("lb_cost_greedy-0", lb_cost_greedy(w2, 20), 0)
    // Empty
    cki("lb_cost_greedy-empty", lb_cost_greedy([], 10), 0)

    // ── lb_balance ───────────────────────────────────────────────────────────
    // ['the','quick','brown','fox'], width=12
    //   natural greedy at 12: 'the quick brown'=15>12 -> 'the quick'(9), 'brown fox'(9) -> 2 lines
    //   binary search for min width keeping 2 lines:
    //   max_word=5('quick'/'brown'), lo=5, hi=12
    //   mid=8: 'the quick'(9)>8 -> 'the'(3), 'quick'(5), 'brown'(5), 'fox'(3) -> 4 lines != 2
    //   mid=9: 'the quick'(9)<=9 ok; 'brown fox'(9)<=9 ok -> 2 lines
    //   => balance at width=9 -> ['the quick','brown fox']
    let bal = lb_balance(["the", "quick", "brown", "fox"], 12)
    ck_slist("lb_balance", bal, ["the quick", "brown fox"])

    print("PASS _linebreak_test")
