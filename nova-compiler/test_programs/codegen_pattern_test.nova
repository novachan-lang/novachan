type Token
    kind: string
    value: string

fn tokenize(input: string) -> list
    let tokens = []
    let i = 0
    let current = ""
    while i < len(input)
        let ch = input[i]
        if ch == " " or ch == "\n"
            if len(current) > 0
                push(tokens, Token("word", current))
                current = ""
        else if ch == "(" or ch == ")" or ch == "+" or ch == "="
            if len(current) > 0
                push(tokens, Token("word", current))
                current = ""
            push(tokens, Token("sym", ch))
        else
            current = current + ch
        i = i + 1
    if len(current) > 0
        push(tokens, Token("word", current))
    tokens

fn emit_code(tokens: list) -> string
    let output = ""
    for tok in tokens
        match tok
            Token(kind, value) =>
                if kind == "word"
                    output = output + value + " "
                else
                    output = output + value + " "
    output

fn run_test()
    let tokens = tokenize("let x = (a + b)")
    assert(len(tokens) == 8, "token count: " + str(len(tokens)))

    match tokens[0]
        Token(kind, value) =>
            assert(kind == "word", "first is word: " + kind)
            assert(value == "let", "first is 'let': " + value)

    match tokens[3]
        Token(kind, value) =>
            assert(kind == "sym", "paren is sym: " + kind)
            assert(value == "(", "paren value: " + value)

    let code = emit_code(tokens)
    assert(starts_with(code, "let x = ( a + b )"), "codegen: " + code)

    print("Codegen pattern test passed!")
    print("Tokens: " + str(len(tokens)))
    print("Output: " + code)

run_test()
