// Auto-parallelization test: pmap, pfilter, pfor, cpu_count

fn heavy(x: int) -> int
    let acc = 0
    let i = 0
    while i < 5000
        acc = acc + (x * i) % 7
        i = i + 1
    acc

fn main()
    let cpus = cpu_count()
    print("CPUs:")
    print(cpus)

    // ── Correctness: pmap should give same result as map ──
    let nums = []
    let i = 0
    while i < 1000
        push(nums, i)
        i = i + 1

    let serial = map(nums, fn(x) x * 2 + 1)
    let parallel = pmap(nums, fn(x) x * 2 + 1)
    assert(len(serial) == len(parallel), "pmap length")
    let mismatch = 0
    let j = 0
    while j < len(serial)
        if serial[j] != parallel[j]
            mismatch = mismatch + 1
        j = j + 1
    assert(mismatch == 0, "pmap correctness")
    print("pmap correctness: OK")

    // ── pfilter correctness ──
    let s_filt = filter(nums, fn(x) x % 3 == 0)
    let p_filt = pfilter(nums, fn(x) x % 3 == 0)
    assert(len(s_filt) == len(p_filt), "pfilter length")
    let m2 = 0
    let k = 0
    while k < len(s_filt)
        if s_filt[k] != p_filt[k]
            m2 = m2 + 1
        k = k + 1
    assert(m2 == 0, "pfilter correctness")
    print("pfilter correctness: OK")

    // ── Speedup demo: heavy work, big list ──
    let big = []
    let bi = 0
    while bi < 50000
        push(big, bi)
        bi = bi + 1

    let t1 = time_ms()
    let serial_heavy = map(big, fn(x) heavy(x))
    let t2 = time_ms()
    let serial_time = t2 - t1

    let t3 = time_ms()
    let parallel_heavy = pmap(big, fn(x) heavy(x))
    let t4 = time_ms()
    let parallel_time = t4 - t3

    print("Serial time (ms):")
    print(serial_time)
    print("Parallel time (ms):")
    print(parallel_time)
    assert(len(serial_heavy) == len(parallel_heavy), "heavy length")
    let h_mismatch = 0
    let hi = 0
    while hi < len(serial_heavy)
        if serial_heavy[hi] != parallel_heavy[hi]
            h_mismatch = h_mismatch + 1
        hi = hi + 1
    assert(h_mismatch == 0, "heavy correctness")
    print("Heavy pmap correctness: OK")

    print("All tests passed")
