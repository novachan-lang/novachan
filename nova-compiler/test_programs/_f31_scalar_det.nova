// DETERMINISTIC twin of _f31_scalar. The original seeds `a` from time_ms(), and since
// acc = a*acc + 0.5 compounds 20M times, the seed decides whether acc overflows to inf --
// which changes the RUNTIME, not just the value. A benchmark whose speed depends on the
// clock cannot measure a 10% codegen effect. Here `a` is fixed and chosen < 1 so acc
// converges to a finite value: same work, same result, every run.
fn axpy(a: float, x: float, y: float) -> float
    a * x + y

fn main()
    let a = 0.9999999
    let n = 20000000
    let acc = 0.0
    let t0 = time_ms()
    let i = 0
    while i < n
        acc = axpy(a, acc, 0.5)
        i = i + 1
    let el = time_ms() - t0
    print("BENCH scalar_axpy_det elapsed_ms=" + str(el))
    print(acc)
