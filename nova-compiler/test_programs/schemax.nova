fn schema_string()
  {"type": "string"}

fn schema_int()
  {"type": "int"}

fn schema_int_range(lo, hi)
  {"type": "int", "min": lo, "max": hi}

fn schema_string_min(min_len)
  {"type": "string", "min_len": min_len}

fn schema_one_of(values)
  {"type": "one_of", "values": values}

fn schema_object(fields)
  {"type": "object", "fields": fields}

fn validate(schema, value)
  let t = schema["type"]
  if t == "string"
    if type_of(value) != "string"
      return err("expected string, got " + type_of(value))
    if contains(schema, "min_len")
      if len(value) < schema["min_len"]
        return err("string too short: min " + str(schema["min_len"]) + ", got " + str(len(value)))
    return ok(value)
  if t == "int"
    if type_of(value) != "int"
      return err("expected int, got " + type_of(value))
    if contains(schema, "min")
      if value < schema["min"]
        return err("value " + str(value) + " < min " + str(schema["min"]))
    if contains(schema, "max")
      if value > schema["max"]
        return err("value " + str(value) + " > max " + str(schema["max"]))
    return ok(value)
  if t == "one_of"
    let vals = schema["values"]
    for v in vals
      if v == value
        return ok(value)
    return err("value not in allowed set")
  if t == "object"
    if type_of(value) != "dict"
      return err("expected object, got " + type_of(value))
    let fields = schema["fields"]
    let field_names = keys(fields)
    for fname in field_names
      if not contains(value, fname)
        return err("missing field: " + fname)
      let field_schema = fields[fname]
      let field_result = validate(field_schema, value[fname])
      if is_err(field_result)
        return err(fname + ": " + unwrap_err(field_result))
    return ok(value)
  err("unknown schema type: " + str(t))

fn main()
  let str_schema = schema_string()
  assert(is_ok(validate(str_schema, "hello")), "string ok")
  assert(is_err(validate(str_schema, 42)), "string rejects int")

  let int_range = schema_int_range(1, 100)
  assert(is_ok(validate(int_range, 50)), "int in range")
  assert(is_err(validate(int_range, 0)), "int below min")
  assert(is_err(validate(int_range, 101)), "int above max")

  let min_str = schema_string_min(3)
  assert(is_ok(validate(min_str, "abc")), "string min ok")
  assert(is_err(validate(min_str, "ab")), "string too short")

  let color_schema = schema_one_of(["red", "green", "blue"])
  assert(is_ok(validate(color_schema, "red")), "one_of match")
  assert(is_err(validate(color_schema, "yellow")), "one_of no match")

  let user_schema = schema_object({"name": schema_string_min(1), "age": schema_int_range(0, 150)})
  assert(is_ok(validate(user_schema, {"name": "Alice", "age": 30})), "object ok")
  assert(is_err(validate(user_schema, {"name": "Alice"})), "object missing field")
  assert(is_err(validate(user_schema, {"name": "", "age": 30})), "object nested fail")

  print("schemax: all passed")
