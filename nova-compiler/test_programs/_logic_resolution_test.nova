import std/logic/logic_resolution

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn ckl(label, got, want)
    if len(got) != len(want)
        print("FAIL " + label + ": len=" + str(len(got)) + " want len=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

// Local brute-force SAT evaluator for cross-checking lrs_refute
fn _local_eval_cnf(cnf, asgn) -> int
    let nc = len(cnf)
    let ci = 0
    while ci < nc
        let clause = cnf[ci]
        let nl = len(clause)
        let found = 0
        let li = 0
        while li < nl
            let lit = clause[li]
            let var = lit
            if var < 0
                var = 0 - var
            let val = asgn[var - 1]
            if lit > 0 and val == 1
                found = 1
            if lit < 0 and val == 0
                found = 1
            li = li + 1
        if found == 0
            return 0
        ci = ci + 1
    1

fn _local_is_sat(cnf, nvars) -> int
    let total = 1 << nvars
    let i = 0
    while i < total
        let a = []
        let b = 0
        while b < nvars
            push(a, (i >> b) & 1)
            b = b + 1
        if _local_eval_cnf(cnf, a) == 1
            return 1
        i = i + 1
    0

fn main()
    // =========================================================================
    // KAT: lrs_resolve
    // lrs_resolve([1,2],[-1,3],1) == [2,3]
    // c1=[1,2] has +1; c2=[-1,3] has -1; resolvent = {2,3} (minus +1 and -1)
    // =========================================================================
    let r1 = lrs_resolve([1, 2], [-1, 3], 1)
    ckl("resolve_1_2_n1_3_on_1", r1, [2, 3])

    // lrs_resolve([1],[-1],1) == []  (empty clause)
    let r2 = lrs_resolve([1], [-1], 1)
    cki("resolve_1_n1_on_1_len", len(r2), 0)

    // lrs_resolve([1,2],[1,3],1) == "NR" (c2 doesn't have -1)
    let r3 = lrs_resolve([1, 2], [1, 3], 1)
    cki("resolve_NR_type", type_of(r3) == "string", 1)

    // lrs_resolve([2,3],[-1,4],1) == "NR" (c1 doesn't have +1)
    let r4 = lrs_resolve([2, 3], [-1, 4], 1)
    cki("resolve_NR2_type", type_of(r4) == "string", 1)

    // =========================================================================
    // KAT: lrs_is_tautology_clause
    // [1,-1] = true (contains +1 and -1)
    // [1,2]  = false
    // =========================================================================
    ckb("taut_1_n1", lrs_is_tautology_clause([1, -1]), true)
    ckb("taut_1_2_false", lrs_is_tautology_clause([1, 2]), false)
    ckb("taut_empty_false", lrs_is_tautology_clause([]), false)
    ckb("taut_1_n2_n1", lrs_is_tautology_clause([1, -2, -1]), true)

    // =========================================================================
    // KAT: lrs_subsumes
    // lrs_subsumes([1],[1,2]) = true  ([1] is subset of [1,2])
    // lrs_subsumes([1,2],[1]) = false ([1,2] is NOT subset of [1])
    // =========================================================================
    ckb("subsumes_1_in_12", lrs_subsumes([1], [1, 2]), true)
    ckb("subsumes_12_not_in_1", lrs_subsumes([1, 2], [1]), false)
    ckb("subsumes_empty_always", lrs_subsumes([], [1, 2]), true)
    ckb("subsumes_self", lrs_subsumes([1, 2], [1, 2]), true)
    ckb("subsumes_disjoint_false", lrs_subsumes([3], [1, 2]), false)

    // =========================================================================
    // KAT: lrs_refute
    // lrs_refute([[1],[-1]],1) = true   (UNSAT)
    // lrs_refute([[1,2]],2)    = false  (SAT)
    // lrs_refute([[1,2],[1,-2],[-1,2],[-1,-2]],2) = true  (all 4 clauses = all 4 maxterms, UNSAT)
    // =========================================================================
    ckb("refute_contra", lrs_refute([[1], [-1]], 1), true)
    ckb("refute_sat_12", lrs_refute([[1, 2]], 2), false)

    let cnf_all_max = [[1, 2], [1, -2], [-1, 2], [-1, -2]]
    ckb("refute_all_max", lrs_refute(cnf_all_max, 2), true)

    // =========================================================================
    // CROSS-CHECK: lrs_refute(cnf,nvars) must equal NOT brute-force-SAT
    // for all spec KATs
    // =========================================================================
    let sat_contra = _local_is_sat([[1], [-1]], 1)
    let ref_contra = lrs_refute([[1], [-1]], 1)
    let ref_contra_int = 0
    if ref_contra
        ref_contra_int = 1
    cki("cross_contra", ref_contra_int, 1 - sat_contra)

    let sat_12 = _local_is_sat([[1, 2]], 2)
    let ref_12 = lrs_refute([[1, 2]], 2)
    let ref_12_int = 0
    if ref_12
        ref_12_int = 1
    cki("cross_12", ref_12_int, 1 - sat_12)

    let sat_all_max = _local_is_sat(cnf_all_max, 2)
    let ref_all_max = lrs_refute(cnf_all_max, 2)
    let ref_all_max_int = 0
    if ref_all_max
        ref_all_max_int = 1
    cki("cross_all_max", ref_all_max_int, 1 - sat_all_max)

    // Additional cross-checks
    // 3-var: [[1,2,3],[-1,-2,-3]] — SAT (many solutions), should NOT refute
    let cnf_3v = [[1, 2, 3], [-1, -2, -3]]
    let sat_3v = _local_is_sat(cnf_3v, 3)
    let ref_3v = lrs_refute(cnf_3v, 3)
    let ref_3v_int = 0
    if ref_3v
        ref_3v_int = 1
    cki("cross_3v", ref_3v_int, 1 - sat_3v)

    // 2-var XOR: [[1,-2],[-1,2]] — SAT, should NOT refute
    let cnf_xor = [[1, -2], [-1, 2]]
    let sat_xor = _local_is_sat(cnf_xor, 2)
    let ref_xor = lrs_refute(cnf_xor, 2)
    let ref_xor_int = 0
    if ref_xor
        ref_xor_int = 1
    cki("cross_xor", ref_xor_int, 1 - sat_xor)

    // Pigeonhole 2-in-1: 2 pigeons, 1 hole
    // var 1 = pigeon1 in hole, var 2 = pigeon2 in hole
    // Both must be in hole: [1],[2] but at most one: [-1,-2]
    // -> [[1],[2],[-1,-2]] is UNSAT
    let cnf_php = [[1], [2], [-1, -2]]
    let sat_php = _local_is_sat(cnf_php, 2)
    let ref_php = lrs_refute(cnf_php, 2)
    let ref_php_int = 0
    if ref_php
        ref_php_int = 1
    cki("cross_php", ref_php_int, 1 - sat_php)
    ckb("refute_php", lrs_refute(cnf_php, 2), true)

    // Empty CNF = always SAT -> refute = false
    let ref_empty = lrs_refute([], 2)
    let ref_empty_int = 0
    if ref_empty
        ref_empty_int = 1
    cki("refute_empty_cnf", ref_empty_int, 0)

    print("PASS _logic_resolution_test")
