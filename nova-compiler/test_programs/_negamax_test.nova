import std/gametheory/negamax

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _negamax_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL _negamax_test " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn main()
    // leaf node returns itself
    cki("leaf 5", ng_value(5), 5)
    cki("leaf 0", ng_value(0), 0)
    cki("leaf -7", ng_value(-7), -7)

    // KAT 1: [[3,5],[2,9],[0,1]] -> mins 3,2,0 -> max 3
    let t1 = []
    let c1a = []
    push(c1a, 3)
    push(c1a, 5)
    let c1b = []
    push(c1b, 2)
    push(c1b, 9)
    let c1c = []
    push(c1c, 0)
    push(c1c, 1)
    push(t1, c1a)
    push(t1, c1b)
    push(t1, c1c)
    cki("[[3,5],[2,9],[0,1]]", ng_value(t1), 3)

    // KAT 2: [[3,12,8],[2,4,6],[14,5,2]] -> mins 3,2,2 -> max 3
    let t2 = []
    let c2a = []
    push(c2a, 3)
    push(c2a, 12)
    push(c2a, 8)
    let c2b = []
    push(c2b, 2)
    push(c2b, 4)
    push(c2b, 6)
    let c2c = []
    push(c2c, 14)
    push(c2c, 5)
    push(c2c, 2)
    push(t2, c2a)
    push(t2, c2b)
    push(t2, c2c)
    cki("[[3,12,8],[2,4,6],[14,5,2]]", ng_value(t2), 3)

    // KAT 3: [[1,2],[3,4]] -> mins 1,3 -> max 3
    let t3 = []
    let c3a = []
    push(c3a, 1)
    push(c3a, 2)
    let c3b = []
    push(c3b, 3)
    push(c3b, 4)
    push(t3, c3a)
    push(t3, c3b)
    cki("[[1,2],[3,4]]", ng_value(t3), 3)

    // single-child tree: [[7]] -> min(7)=7 -> max=7
    let t4 = []
    let c4a = []
    push(c4a, 7)
    push(t4, c4a)
    cki("[[7]]", ng_value(t4), 7)

    // single leaf child: [[42]]
    let t5 = []
    let c5a = []
    push(c5a, 42)
    push(t5, c5a)
    cki("single child [[42]]", ng_value(t5), 42)

    print("PASS _negamax_test")
