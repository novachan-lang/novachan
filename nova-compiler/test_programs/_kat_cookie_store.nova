import forge_cookie_store

fn main()
    let c = cs_new()
    c = cs_set(c, "session", "abc123", 3600)
    c = cs_set(c, "theme", "dark", 86400)
    assert(cs_cookie_count(c) == 2, "2 cookies")

    let r1 = cs_get(c, "session")
    assert(is_ok(r1), "get ok")
    assert(unwrap(r1) == "abc123", "session val")

    assert(cs_is_expired(c, "session") == 0, "not expired")

    let t1 = cs_tick(c, "session", 3600)
    assert(is_ok(t1), "tick ok")
    c = unwrap(t1)
    assert(cs_is_expired(c, "session") == 1, "expired after tick")

    let r2 = cs_get(c, "session")
    assert(is_err(r2), "expired cookie err")

    let r3 = cs_get(c, "theme")
    assert(is_ok(r3), "theme ok")
    assert(unwrap(r3) == "dark", "dark theme")

    let bad = cs_get(c, "nope")
    assert(is_err(bad), "not found")

    assert(cs_total_reads(c) == 4, "4 reads")

    print("COOKIE-STORE KAT PASS")
