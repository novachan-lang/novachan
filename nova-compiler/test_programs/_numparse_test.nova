// KAT for std/parsing/numparse
// Known-answer test — asserts exact behavioral vectors from spec.
import std/parsing/numparse

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL numparse " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ---- KAT 1: decimal positive -------------------------------------------
    cki("decimal_42", numparse("42"), 42)

    // ---- KAT 2: decimal negative -------------------------------------------
    cki("decimal_neg42", numparse("-42"), -42)

    // ---- KAT 3: hex 0xFF ---------------------------------------------------
    cki("hex_0xFF", numparse("0xFF"), 255)

    // ---- KAT 4: binary 0b1010 ----------------------------------------------
    cki("binary_0b1010", numparse("0b1010"), 10)

    // ---- KAT 5: octal 0o17 -------------------------------------------------
    cki("octal_0o17", numparse("0o17"), 15)

    // ---- KAT 6: underscore grouping ----------------------------------------
    cki("underscore_1_000_000", numparse("1_000_000"), 1000000)

    // ---- KAT 7: explicit plus sign -----------------------------------------
    cki("plus_7", numparse("+7"), 7)

    // ---- KAT 8: numparse_ok invalid hex ------------------------------------
    cki("ok_0xZZ_false", numparse_ok("0xZZ"), 0)

    // ---- KAT 9: numparse_ok valid decimal ----------------------------------
    cki("ok_12_true", numparse_ok("12"), 1)

    // ---- KAT 10: parse_radix ff base-16 ------------------------------------
    cki("radix_ff_16", parse_radix("ff", 16), 255)

    // ---- KAT 11: parse_radix 777 base-8 ------------------------------------
    cki("radix_777_8", parse_radix("777", 8), 511)

    // ---- KAT 12: empty string => 0, not crash ------------------------------
    cki("empty_numparse", numparse(""), 0)

    // ---- KAT 13: empty string => not ok ------------------------------------
    cki("empty_ok", numparse_ok(""), 0)

    // ---- KAT 14: whitespace only => 0, not crash ---------------------------
    cki("ws_only", numparse("   "), 0)

    // ---- KAT 15: leading/trailing whitespace trimmed -----------------------
    cki("trim_spaces", numparse("  99  "), 99)

    // ---- KAT 16: pure sign => invalid -------------------------------------
    cki("pure_minus", numparse("-"), 0)
    cki("pure_plus", numparse("+"), 0)

    // ---- KAT 17: hex uppercase prefix 0X -----------------------------------
    cki("hex_0Xff", numparse("0Xff"), 255)

    // ---- KAT 18: binary uppercase prefix 0B --------------------------------
    cki("binary_0B1010", numparse("0B1010"), 10)

    // ---- KAT 19: octal uppercase prefix 0O ---------------------------------
    cki("octal_0O17", numparse("0O17"), 15)

    // ---- KAT 20: hex with underscores --------------------------------------
    cki("hex_underscore", numparse("0xFF_00"), 65280)

    // ---- KAT 21: binary 0b0 ------------------------------------------------
    cki("binary_zero", numparse("0b0"), 0)

    // ---- KAT 22: zero decimal ----------------------------------------------
    cki("zero", numparse("0"), 0)

    // ---- KAT 23: negative hex ----------------------------------------------
    cki("neg_hex", numparse("-0x0F"), -15)

    // ---- KAT 24: invalid radix => 0 ----------------------------------------
    cki("radix_invalid_1", parse_radix("ff", 1), 0)
    cki("radix_invalid_37", parse_radix("ff", 37), 0)

    // ---- KAT 25: binary invalid digit --------------------------------------
    cki("ok_0b2", numparse_ok("0b2"), 0)

    // ---- KAT 26: octal invalid digit ---------------------------------------
    cki("ok_0o8", numparse_ok("0o8"), 0)

    // ---- KAT 27: parse_radix binary ----------------------------------------
    cki("radix_1010_2", parse_radix("1010", 2), 10)

    // ---- KAT 28: parse_radix decimal ---------------------------------------
    cki("radix_255_10", parse_radix("255", 10), 255)

    // ---- KAT 29: parse_radix with underscore -------------------------------
    cki("radix_underscore", parse_radix("1_00", 10), 100)

    // ---- KAT 30: numparse_ok on hex valid ----------------------------------
    cki("ok_hex_valid", numparse_ok("0xDEAD"), 1)

    // ---- KAT 31: large decimal ---------------------------------------------
    cki("large_dec", numparse("1000000"), 1000000)

    // ---- KAT 32: just digits in parse_radix with uppercase -----------------
    cki("radix_FF_16", parse_radix("FF", 16), 255)

    print("PASS _numparse_test")
