import std/semver/semver_satisfies

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let g = 0
    if got
        g = 1
    let w = 0
    if want
        w = 1
    if g != w
        print("FAIL " + label + ": got=" + str(g) + " want=" + str(w))
        exit(1)

fn main()
    // -- svs_satisfies: specified KAT vectors ----------------------------------
    ckb("sat_gte_lt true",  svs_satisfies("1.5.0", ">=1.2.3 <2.0.0"), true)
    ckb("sat_gte_lt false", svs_satisfies("2.0.0", ">=1.2.3 <2.0.0"), false)
    ckb("sat_or_exact",     svs_satisfies("1.0.0", "1.0.0 || 2.0.0"), true)
    ckb("sat_or_lt_gte t",  svs_satisfies("1.5.0", "<1.0.0 || >=1.4.0"), true)
    ckb("sat_or_lt_gte f",  svs_satisfies("1.2.0", "<1.0.0 || >=1.4.0"), false)

    // -- svs_satisfies: additional coverage ------------------------------------
    // equality operator '='
    ckb("eq_match",    svs_satisfies("1.2.3", "=1.2.3"), true)
    ckb("eq_mismatch", svs_satisfies("1.2.4", "=1.2.3"), false)
    // bare version (no operator) = equality
    ckb("bare_match",   svs_satisfies("1.0.0", "1.0.0"), true)
    ckb("bare_no",      svs_satisfies("1.0.1", "1.0.0"), false)
    // strict greater/less
    ckb("gt_true",  svs_satisfies("2.0.0", ">1.9.9"), true)
    ckb("gt_false", svs_satisfies("1.9.9", ">1.9.9"), false)
    ckb("lt_true",  svs_satisfies("0.9.0", "<1.0.0"), true)
    ckb("lt_false", svs_satisfies("1.0.0", "<1.0.0"), false)
    // lte
    ckb("lte_eq",   svs_satisfies("1.5.0", "<=1.5.0"), true)
    ckb("lte_below",svs_satisfies("1.4.9", "<=1.5.0"), true)
    ckb("lte_above",svs_satisfies("1.5.1", "<=1.5.0"), false)
    // prerelease: 1.0.0-alpha < 1.0.0
    ckb("pre_lt_release", svs_satisfies("1.0.0-alpha", ">=1.0.0"), false)
    ckb("pre_lt_ok",      svs_satisfies("1.0.0-alpha", ">=0.9.0"), true)
    // empty range group skipped
    ckb("empty_group", svs_satisfies("1.0.0", ""), false)

    // -- svs_any: alias check --------------------------------------------------
    ckb("any_alias", svs_any("1.5.0", ">=1.2.3 <2.0.0"), true)

    // -- svs_max_satisfying: specified KAT vector ------------------------------
    let v1 = []
    push(v1, "1.2.0")
    push(v1, "1.5.0")
    push(v1, "2.0.0")
    cks("max_sat", svs_max_satisfying(v1, ">=1.2.3 <2.0.0"), "1.5.0")

    // -- svs_max_satisfying: additional coverage -------------------------------
    // none match -> ''
    let v2 = []
    push(v2, "0.1.0")
    push(v2, "0.2.0")
    cks("max_none", svs_max_satisfying(v2, ">=1.0.0"), "")

    // multiple matches -> return highest
    let v3 = []
    push(v3, "1.3.0")
    push(v3, "1.4.0")
    push(v3, "1.5.0")
    cks("max_multiple", svs_max_satisfying(v3, ">=1.2.0 <2.0.0"), "1.5.0")

    // single element satisfies
    let v4 = []
    push(v4, "2.0.0")
    cks("max_single", svs_max_satisfying(v4, ">=2.0.0"), "2.0.0")

    print("PASS _semver_satisfies_test")
