// combinx — combinatorics & number theory in pure NOVA: factorials, permutations,
// binomial coefficients, primality, prime factorization, the Sieve of Eratosthenes,
// Fibonacci, and gcd. Built on int + list primitives; no runtime/compiler changes.
// (i64 range; factorial overflows past 20!.)

fn factorial(n: int) -> int
    let r = 1
    let i = 2
    while i <= n
        r = r * i
        i = i + 1
    return r

fn perm(n: int, k: int) -> int
    if k < 0 or k > n
        return 0
    let r = 1
    let i = 0
    while i < k
        r = r * (n - i)
        i = i + 1
    return r

// binomial(n,k) computed iteratively so the running value stays an exact integer.
fn binomial(n: int, k: int) -> int
    if k < 0 or k > n
        return 0
    let kk = k
    if kk > n - kk
        kk = n - kk
    let r = 1
    let i = 1
    while i <= kk
        r = r * (n - i + 1) / i
        i = i + 1
    return r

fn is_prime(n: int) -> bool
    if n < 2
        return false
    if n < 4
        return true
    if n % 2 == 0
        return false
    let i = 3
    while i * i <= n
        if n % i == 0
            return false
        i = i + 2
    return true

fn prime_factors(n: int) -> list
    let factors = []
    let m = n
    let d = 2
    while d * d <= m
        while m % d == 0
            push(factors, d)
            m = m / d
        d = d + 1
    if m > 1
        push(factors, m)
    return factors

fn sieve_primes(limit: int) -> list
    let primes = []
    if limit < 2
        return primes
    let comp = []
    let i = 0
    while i <= limit
        push(comp, 0)
        i = i + 1
    let p = 2
    while p * p <= limit
        if comp[p] == 0
            let mult = p * p
            while mult <= limit
                comp[mult] = 1
                mult = mult + p
        p = p + 1
    let q = 2
    while q <= limit
        if comp[q] == 0
            push(primes, q)
        q = q + 1
    return primes

fn fib(n: int) -> int
    if n < 2
        return n
    let a = 0
    let b = 1
    let i = 2
    while i <= n
        let c = a + b
        a = b
        b = c
        i = i + 1
    return b

fn gcd2(a: int, b: int) -> int
    let x = a
    let y = b
    while y != 0
        let t = y
        y = x % y
        x = t
    return x

fn main()
    assert_eq(factorial(0), 1)
    assert_eq(factorial(5), 120)
    assert_eq(factorial(10), 3628800)

    assert_eq(perm(5, 2), 20)
    assert_eq(perm(5, 0), 1)

    assert_eq(binomial(5, 2), 10)
    assert_eq(binomial(10, 3), 120)
    assert_eq(binomial(52, 5), 2598960)     // poker hands

    assert_eq(is_prime(2), true)
    assert_eq(is_prime(17), true)
    assert_eq(is_prime(1), false)
    assert_eq(is_prime(91), false)          // 7 * 13

    assert_eq(prime_factors(12), [2, 2, 3])
    assert_eq(prime_factors(17), [17])
    assert_eq(prime_factors(360), [2, 2, 2, 3, 3, 5])

    assert_eq(sieve_primes(20), [2, 3, 5, 7, 11, 13, 17, 19])

    assert_eq(fib(0), 0)
    assert_eq(fib(10), 55)
    assert_eq(fib(20), 6765)

    assert_eq(gcd2(48, 18), 6)
    assert_eq(gcd2(17, 5), 1)

    print("combinx passed")
