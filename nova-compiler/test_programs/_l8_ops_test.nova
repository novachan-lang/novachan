// L8 structural operators: a user struct becomes first-class with obj[i], obj[i]=v, and `for x in obj`
// just by defining index / index_set / iter -- zero annotations (the NOVA derive-from-structure way).
type Bag
    items: list

fn Bag.index(self, i) -> any
    self.items[i]

fn Bag.index_set(self, i, v)
    self.items[i] = v

fn Bag.iter(self) -> list
    self.items

// A struct that GENERATES its iteration (not backed by a stored list) -> tests iter independent of indexing.
type Countdown
    n: int

fn Countdown.iter(self) -> list
    let out = []
    let k = self.n
    while k > 0
        push(out, k)
        k = k - 1
    out

fn main()
    let b = Bag([10, 20, 30])
    if b[0] != 10 or b[2] != 30                 // index get -> Bag__index
        print("FAIL index get: " + str(b[0]) + "/" + str(b[2]))
        exit(1)
    b[1] = 99                                    // index set -> Bag__index_set (mutates via the shared list)
    if b[1] != 99
        print("FAIL index set: " + str(b[1]))
        exit(1)
    let sum = 0
    for x in b                                   // iteration -> Bag__iter
        sum = sum + x
    if sum != 139
        print("FAIL bag iter sum=" + str(sum))
        exit(1)
    let acc = 0
    for v in Countdown(5)                        // 5+4+3+2+1 = 15, generated by Countdown__iter
        acc = acc + v
    if acc != 15
        print("FAIL countdown iter acc=" + str(acc))
        exit(1)
    print("PASS _l8_ops_test")
