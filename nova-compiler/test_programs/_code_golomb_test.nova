// KAT test for std/compress/code_golomb
// Tests Golomb encoding/decoding using the list-of-ints bitstream representation.
// Gate: round-trip for m in {1,3,4,10} and n in 0..60; sequence round-trip;
//       known bit-pattern vectors from the spec.
import std/compress/code_golomb

// ── Helpers ───────────────────────────────────────────────────────────────────

fn ck_int(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck_list_eq(label, got, want)
    let ng = len(got)
    let nw = len(want)
    if ng != nw
        print("FAIL " + label + ": length got=" + str(ng) + " want=" + str(nw))
        exit(1)
    let i = 0
    while i < ng
        if got[i] != want[i]
            print("FAIL " + label + ": index " + str(i) + " got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

// ── KAT 1: Known bit patterns (spec vectors) ─────────────────────────────────

// m=4 (b=2, cutoff=0) — power of two, same as Rice k=2
// golomb_encode(0,4): q=0,r=0 -> unary=[0], rem 2bits of 0=[0,0] -> [0,0,0]
let enc_0_m4 = []
push(enc_0_m4, 0)
push(enc_0_m4, 0)
push(enc_0_m4, 0)
ck_list_eq("enc_0_m4", golomb_encode(0, 4), enc_0_m4)

// golomb_encode(5,4): q=1,r=1 -> unary=[1,0], rem 2bits of 1=[0,1] -> [1,0,0,1]
let enc_5_m4 = []
push(enc_5_m4, 1)
push(enc_5_m4, 0)
push(enc_5_m4, 0)
push(enc_5_m4, 1)
ck_list_eq("enc_5_m4", golomb_encode(5, 4), enc_5_m4)

// golomb_encode(10,4): q=2,r=2 -> unary=[1,1,0], rem 2bits of 2=[1,0] -> [1,1,0,1,0]
let enc_10_m4 = []
push(enc_10_m4, 1)
push(enc_10_m4, 1)
push(enc_10_m4, 0)
push(enc_10_m4, 1)
push(enc_10_m4, 0)
ck_list_eq("enc_10_m4", golomb_encode(10, 4), enc_10_m4)

// m=3 (b=2, cutoff=1): r<1 -> 1 bit; r>=1 -> 2 bits
// golomb_encode(0,3): q=0,r=0 -> [0] + 1-bit(0)=[0] -> [0,0]
let enc_0_m3 = []
push(enc_0_m3, 0)
push(enc_0_m3, 0)
ck_list_eq("enc_0_m3", golomb_encode(0, 3), enc_0_m3)

// golomb_encode(1,3): q=0,r=1 -> [0] + 2-bit(1+1=2)=[1,0] -> [0,1,0]
let enc_1_m3 = []
push(enc_1_m3, 0)
push(enc_1_m3, 1)
push(enc_1_m3, 0)
ck_list_eq("enc_1_m3", golomb_encode(1, 3), enc_1_m3)

// golomb_encode(2,3): q=0,r=2 -> [0] + 2-bit(2+1=3)=[1,1] -> [0,1,1]
let enc_2_m3 = []
push(enc_2_m3, 0)
push(enc_2_m3, 1)
push(enc_2_m3, 1)
ck_list_eq("enc_2_m3", golomb_encode(2, 3), enc_2_m3)

// golomb_encode(3,3): q=1,r=0 -> [1,0] + 1-bit(0)=[0] -> [1,0,0]
let enc_3_m3 = []
push(enc_3_m3, 1)
push(enc_3_m3, 0)
push(enc_3_m3, 0)
ck_list_eq("enc_3_m3", golomb_encode(3, 3), enc_3_m3)

// golomb_encode(4,3): q=1,r=1 -> [1,0] + 2-bit(2)=[1,0] -> [1,0,1,0]
let enc_4_m3 = []
push(enc_4_m3, 1)
push(enc_4_m3, 0)
push(enc_4_m3, 1)
push(enc_4_m3, 0)
ck_list_eq("enc_4_m3", golomb_encode(4, 3), enc_4_m3)

// m=1: b=0, cutoff=0, no remainder bits; n = q*1 = q = q ones then 0
// golomb_encode(0,1): q=0,r=0 -> unary=[0] -> [0]
let enc_0_m1 = []
push(enc_0_m1, 0)
ck_list_eq("enc_0_m1", golomb_encode(0, 1), enc_0_m1)

// golomb_encode(3,1): q=3 -> [1,1,1,0]
let enc_3_m1 = []
push(enc_3_m1, 1)
push(enc_3_m1, 1)
push(enc_3_m1, 1)
push(enc_3_m1, 0)
ck_list_eq("enc_3_m1", golomb_encode(3, 1), enc_3_m1)

// ── KAT 2: Decode of spec vectors ────────────────────────────────────────────

let dec_0_m4 = golomb_decode(enc_0_m4, 0, 4)
ck_int("dec_0_m4_val", dec_0_m4[0], 0)
ck_int("dec_0_m4_pos", dec_0_m4[1], 3)

let dec_5_m4 = golomb_decode(enc_5_m4, 0, 4)
ck_int("dec_5_m4_val", dec_5_m4[0], 5)
ck_int("dec_5_m4_pos", dec_5_m4[1], 4)

let dec_0_m3 = golomb_decode(enc_0_m3, 0, 3)
ck_int("dec_0_m3_val", dec_0_m3[0], 0)
ck_int("dec_0_m3_pos", dec_0_m3[1], 2)

let dec_1_m3 = golomb_decode(enc_1_m3, 0, 3)
ck_int("dec_1_m3_val", dec_1_m3[0], 1)
ck_int("dec_1_m3_pos", dec_1_m3[1], 3)

let dec_2_m3 = golomb_decode(enc_2_m3, 0, 3)
ck_int("dec_2_m3_val", dec_2_m3[0], 2)
ck_int("dec_2_m3_pos", dec_2_m3[1], 3)

let dec_3_m3 = golomb_decode(enc_3_m3, 0, 3)
ck_int("dec_3_m3_val", dec_3_m3[0], 3)
ck_int("dec_3_m3_pos", dec_3_m3[1], 3)

// ── KAT 3: Round-trip m=4, n in 0..60 ───────────────────────────────────────
let n_m4 = 0
while n_m4 <= 60
    let enc4 = golomb_encode(n_m4, 4)
    let dec4 = golomb_decode(enc4, 0, 4)
    if dec4[0] != n_m4
        print("FAIL rt_m4 n=" + str(n_m4) + ": got=" + str(dec4[0]))
        exit(1)
    if dec4[1] != len(enc4)
        print("FAIL rt_m4_pos n=" + str(n_m4) + ": got=" + str(dec4[1]) + " want=" + str(len(enc4)))
        exit(1)
    n_m4 = n_m4 + 1

// ── KAT 4: Round-trip m=3, n in 0..60 ───────────────────────────────────────
let n_m3 = 0
while n_m3 <= 60
    let enc3 = golomb_encode(n_m3, 3)
    let dec3 = golomb_decode(enc3, 0, 3)
    if dec3[0] != n_m3
        print("FAIL rt_m3 n=" + str(n_m3) + ": got=" + str(dec3[0]))
        exit(1)
    if dec3[1] != len(enc3)
        print("FAIL rt_m3_pos n=" + str(n_m3) + ": got=" + str(dec3[1]) + " want=" + str(len(enc3)))
        exit(1)
    n_m3 = n_m3 + 1

// ── KAT 5: Round-trip m=1, n in 0..60 ───────────────────────────────────────
let n_m1 = 0
while n_m1 <= 60
    let enc1 = golomb_encode(n_m1, 1)
    let dec1 = golomb_decode(enc1, 0, 1)
    if dec1[0] != n_m1
        print("FAIL rt_m1 n=" + str(n_m1) + ": got=" + str(dec1[0]))
        exit(1)
    if dec1[1] != len(enc1)
        print("FAIL rt_m1_pos n=" + str(n_m1) + ": got=" + str(dec1[1]) + " want=" + str(len(enc1)))
        exit(1)
    n_m1 = n_m1 + 1

// ── KAT 6: Round-trip m=10, n in 0..60 ──────────────────────────────────────
// m=10: b=4 (2^4=16>=10), cutoff=16-10=6
// r<6  -> 3-bit: r
// r>=6 -> 4-bit: r+6
let n_m10 = 0
while n_m10 <= 60
    let enc10 = golomb_encode(n_m10, 10)
    let dec10 = golomb_decode(enc10, 0, 10)
    if dec10[0] != n_m10
        print("FAIL rt_m10 n=" + str(n_m10) + ": got=" + str(dec10[0]))
        exit(1)
    if dec10[1] != len(enc10)
        print("FAIL rt_m10_pos n=" + str(n_m10) + ": got=" + str(dec10[1]) + " want=" + str(len(enc10)))
        exit(1)
    n_m10 = n_m10 + 1

// ── KAT 7: Sequence round-trip m=4 ───────────────────────────────────────────
// Encode [0, 5, 10, 15, 20, 1, 7] then decode them back in order.
let seq_ns = []
push(seq_ns, 0)
push(seq_ns, 5)
push(seq_ns, 10)
push(seq_ns, 15)
push(seq_ns, 20)
push(seq_ns, 1)
push(seq_ns, 7)

let seq_bits = golomb_encode_seq(seq_ns, 4)
let seq_dec = golomb_decode_seq(seq_bits, 0, 4, 7)
ck_int("seq_rt_m4_0",  seq_dec[0], 0)
ck_int("seq_rt_m4_1",  seq_dec[1], 5)
ck_int("seq_rt_m4_2",  seq_dec[2], 10)
ck_int("seq_rt_m4_3",  seq_dec[3], 15)
ck_int("seq_rt_m4_4",  seq_dec[4], 20)
ck_int("seq_rt_m4_5",  seq_dec[5], 1)
ck_int("seq_rt_m4_6",  seq_dec[6], 7)

// ── KAT 8: Sequence round-trip m=3 ───────────────────────────────────────────
let seq_ns3 = []
push(seq_ns3, 0)
push(seq_ns3, 1)
push(seq_ns3, 2)
push(seq_ns3, 3)
push(seq_ns3, 4)
push(seq_ns3, 5)
push(seq_ns3, 17)
push(seq_ns3, 29)
push(seq_ns3, 60)

let seq_bits3 = golomb_encode_seq(seq_ns3, 3)
let seq_dec3 = golomb_decode_seq(seq_bits3, 0, 3, 9)
ck_int("seq_rt_m3_0", seq_dec3[0], 0)
ck_int("seq_rt_m3_1", seq_dec3[1], 1)
ck_int("seq_rt_m3_2", seq_dec3[2], 2)
ck_int("seq_rt_m3_3", seq_dec3[3], 3)
ck_int("seq_rt_m3_4", seq_dec3[4], 4)
ck_int("seq_rt_m3_5", seq_dec3[5], 5)
ck_int("seq_rt_m3_6", seq_dec3[6], 17)
ck_int("seq_rt_m3_7", seq_dec3[7], 29)
ck_int("seq_rt_m3_8", seq_dec3[8], 60)

// ── KAT 9: Sequence round-trip m=10 ──────────────────────────────────────────
let seq_ns10 = []
push(seq_ns10, 0)
push(seq_ns10, 6)
push(seq_ns10, 9)
push(seq_ns10, 10)
push(seq_ns10, 15)
push(seq_ns10, 59)
push(seq_ns10, 60)

let seq_bits10 = golomb_encode_seq(seq_ns10, 10)
let seq_dec10 = golomb_decode_seq(seq_bits10, 0, 10, 7)
ck_int("seq_rt_m10_0", seq_dec10[0], 0)
ck_int("seq_rt_m10_1", seq_dec10[1], 6)
ck_int("seq_rt_m10_2", seq_dec10[2], 9)
ck_int("seq_rt_m10_3", seq_dec10[3], 10)
ck_int("seq_rt_m10_4", seq_dec10[4], 15)
ck_int("seq_rt_m10_5", seq_dec10[5], 59)
ck_int("seq_rt_m10_6", seq_dec10[6], 60)

// ── KAT 10: pack_bits basic ───────────────────────────────────────────────────
// [1,0,1,1,0,0,1,0] -> 0b10110010 = 178
let pb_in = []
push(pb_in, 1)
push(pb_in, 0)
push(pb_in, 1)
push(pb_in, 1)
push(pb_in, 0)
push(pb_in, 0)
push(pb_in, 1)
push(pb_in, 0)
let pb_out = pack_bits(pb_in)
ck_int("pack_bits_len", len(pb_out), 1)
ck_int("pack_bits_0", pb_out[0], 178)

// [1,0,1] -> zero-padded to [1,0,1,0,0,0,0,0] = 0b10100000 = 160
let pb_pad = []
push(pb_pad, 1)
push(pb_pad, 0)
push(pb_pad, 1)
let pb_pad_out = pack_bits(pb_pad)
ck_int("pack_bits_pad_len", len(pb_pad_out), 1)
ck_int("pack_bits_pad_0", pb_pad_out[0], 160)

// Empty bit list -> empty byte list
let pb_empty = []
let pb_empty_out = pack_bits(pb_empty)
ck_int("pack_bits_empty_len", len(pb_empty_out), 0)

// ── KAT 11: decode with non-zero start pos (stream-chaining) ─────────────────
// Concatenate encode(0,4) + encode(5,4) = [0,0,0,1,0,0,1] and decode both.
let chain_bits = []
push(chain_bits, 0)
push(chain_bits, 0)
push(chain_bits, 0)
push(chain_bits, 1)
push(chain_bits, 0)
push(chain_bits, 0)
push(chain_bits, 1)

let chain_d0 = golomb_decode(chain_bits, 0, 4)
ck_int("chain_d0_val", chain_d0[0], 0)
ck_int("chain_d0_pos", chain_d0[1], 3)

let chain_d1 = golomb_decode(chain_bits, chain_d0[1], 4)
ck_int("chain_d1_val", chain_d1[0], 5)
ck_int("chain_d1_pos", chain_d1[1], 7)

print("PASS _code_golomb_test")
