// Isolate the exact pattern from the compiler's tokenizer
fn is_alpha(ch: string) -> bool
    let c = ord(ch)
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or ch == "_"

fn is_digit(ch: string) -> bool
    let c = ord(ch)
    c >= 48 and c <= 57

fn is_alnum(ch: string) -> bool
    is_alpha(ch) or is_digit(ch)

fn is_ws(ch: string) -> bool
    ch == " " or ch == "\t" or ch == "\r"

type Token
    kind: string
    value: string
    line: int
    col: int

fn tokenize(source: string) -> list
    let tokens = []
    let pos = 0
    let line = 1
    let col = 1
    let length = len(source)

    while pos < length
        let ch = source[pos]

        if ch == "\n"
            push(tokens, Token("NEWLINE", "\\n", line, col))
            line = line + 1
            col = 1
            pos = pos + 1
        else if is_ws(ch)
            while pos < length and is_ws(source[pos])
                pos = pos + 1
                col = col + 1
        else if is_alpha(ch)
            let start_col = col
            let word = ""
            while pos < length and is_alnum(source[pos])
                word = word + source[pos]
                pos = pos + 1
                col = col + 1
            push(tokens, Token("IDENT", word, line, start_col))
        else if is_digit(ch)
            let start_col = col
            let num = ""
            while pos < length and is_digit(source[pos])
                num = num + source[pos]
                pos = pos + 1
                col = col + 1
            push(tokens, Token("INT", num, line, start_col))
        else if ch == "+"
            push(tokens, Token("OP", "+", line, col))
            pos = pos + 1
            col = col + 1
        else if ch == "="
            push(tokens, Token("ASSIGN", "=", line, col))
            pos = pos + 1
            col = col + 1
        else
            pos = pos + 1
            col = col + 1
    push(tokens, Token("EOF", "", line, col))
    return tokens

let result = tokenize("let x = 42 + 3")
let non_nl = []
for t in result
    match t
        Token(kind, value, line, col) =>
            if kind != "NEWLINE" and kind != "EOF"
                push(non_nl, t)
            print(kind + ":" + value)

print("Total: " + str(len(result)) + ", non-nl: " + str(len(non_nl)))
if len(non_nl) == 6
    print("PASS")
else
    print("FAIL: expected 6, got " + str(len(non_nl)))
