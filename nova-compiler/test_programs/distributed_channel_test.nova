// Test: NOVA distributed computing — remote channels over TCP
// This test runs a server and client in the same process using spawn.

fn server_worker(port)
    let node = node_listen(port)
    let client = node_accept(node)

    // Receive a value from the client
    let msg = remote_recv(client)
    print("server received: {msg}")

    // Send a response back
    remote_send(client, "hello from server")

    // Receive a list
    let data = remote_recv(client)
    print("server got list: {data}")

    // Send computed result
    let sum = 0
    for x in data
        sum = sum + x
    remote_send(client, sum)

    remote_close(client)
    node_stop(node)

fn client_worker(port)
    sleep(100)
    let conn = node_connect("127.0.0.1:{port}")

    // Send a greeting
    remote_send(conn, "hello from client")

    // Receive response
    let resp = remote_recv(conn)
    print("client received: {resp}")

    // Send a list for computation
    remote_send(conn, [10, 20, 30, 40])

    // Receive computed result
    let result = remote_recv(conn)
    print("computed sum: {result}")
    assert(result == 100, "sum should be 100")

    remote_close(conn)

fn main()
    let port = 19876

    // Spawn server and client
    spawn server_worker(port)
    spawn client_worker(port)

    // Wait for both to finish
    sleep(2000)
    print("distributed channel test passed")

main()
