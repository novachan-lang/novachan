import std/tensor/tsr_pad

// cki: assert integer equality
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _tsr_pad_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb: assert boolean equality
fn ckb(label: string, got: bool, want: bool)
    if got != want
        print("FAIL _tsr_pad_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckl: assert flat int list equality element-wise
fn ckl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL _tsr_pad_test " + label + " len: got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL _tsr_pad_test " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

// ckt: assert tensor [flat, shape] equality
fn ckt(label: string, t: list, want_flat: list, want_shape: list)
    let got_flat = t[0]
    let got_shape = t[1]
    ckl(label + "_shape", got_shape, want_shape)
    ckl(label + "_flat", got_flat, want_flat)

// ---- tp_pad ----
// 2x2 [[1,2],[3,4]], width=1, value=0
// Expected 4x4:
// 0 0 0 0
// 0 1 2 0
// 0 3 4 0
// 0 0 0 0
// flat = [0,0,0,0, 0,1,2,0, 0,3,4,0, 0,0,0,0], shape=[4,4]
let flat22 = []
push(flat22, 1)
push(flat22, 2)
push(flat22, 3)
push(flat22, 4)
let shape22 = []
push(shape22, 2)
push(shape22, 2)
let t22 = []
push(t22, flat22)
push(t22, shape22)

let padded = tp_pad(t22, 1, 0)
let want_pad_flat = []
push(want_pad_flat, 0)
push(want_pad_flat, 0)
push(want_pad_flat, 0)
push(want_pad_flat, 0)
push(want_pad_flat, 0)
push(want_pad_flat, 1)
push(want_pad_flat, 2)
push(want_pad_flat, 0)
push(want_pad_flat, 0)
push(want_pad_flat, 3)
push(want_pad_flat, 4)
push(want_pad_flat, 0)
push(want_pad_flat, 0)
push(want_pad_flat, 0)
push(want_pad_flat, 0)
push(want_pad_flat, 0)
let want_pad_shape = []
push(want_pad_shape, 4)
push(want_pad_shape, 4)
ckt("pad_2x2_w1_v0", padded, want_pad_flat, want_pad_shape)

// width=0 should be a no-op copy
let padded0 = tp_pad(t22, 0, 9)
let want_pad0_flat = []
push(want_pad0_flat, 1)
push(want_pad0_flat, 2)
push(want_pad0_flat, 3)
push(want_pad0_flat, 4)
let want_pad0_shape = []
push(want_pad0_shape, 2)
push(want_pad0_shape, 2)
ckt("pad_2x2_w0_noop", padded0, want_pad0_flat, want_pad0_shape)

// ---- tp_roll ----
// [1,2,3,4], shift=1 -> [4,1,2,3]
let flat4 = []
push(flat4, 1)
push(flat4, 2)
push(flat4, 3)
push(flat4, 4)
let shape4 = []
push(shape4, 4)
let t4 = []
push(t4, flat4)
push(t4, shape4)

let rolled1 = tp_roll(t4, 1)
let want_roll1 = []
push(want_roll1, 4)
push(want_roll1, 1)
push(want_roll1, 2)
push(want_roll1, 3)
let want_roll1_shape = []
push(want_roll1_shape, 4)
ckt("roll_4_shift1", rolled1, want_roll1, want_roll1_shape)

// shift=4 (full rotation = no-op)
let rolled4 = tp_roll(t4, 4)
let want_roll4 = []
push(want_roll4, 1)
push(want_roll4, 2)
push(want_roll4, 3)
push(want_roll4, 4)
let want_roll4_shape = []
push(want_roll4_shape, 4)
ckt("roll_4_shift4_noop", rolled4, want_roll4, want_roll4_shape)

// shift=2 -> [3,4,1,2]
let rolled2 = tp_roll(t4, 2)
let want_roll2 = []
push(want_roll2, 3)
push(want_roll2, 4)
push(want_roll2, 1)
push(want_roll2, 2)
let want_roll2_shape = []
push(want_roll2_shape, 4)
ckt("roll_4_shift2", rolled2, want_roll2, want_roll2_shape)

// ---- tp_flip ----
// 1-D [1,2,3], axis=0 -> [3,2,1]
let flat3 = []
push(flat3, 1)
push(flat3, 2)
push(flat3, 3)
let shape3 = []
push(shape3, 3)
let t3 = []
push(t3, flat3)
push(t3, shape3)

let flip1d = tp_flip(t3, 0)
let want_flip1d = []
push(want_flip1d, 3)
push(want_flip1d, 2)
push(want_flip1d, 1)
let want_flip1d_shape = []
push(want_flip1d_shape, 3)
ckt("flip_1d_axis0", flip1d, want_flip1d, want_flip1d_shape)

// 2x3 [[1,2,3],[4,5,6]], axis=0 (reverse row order) -> [[4,5,6],[1,2,3]]
// flat = [4,5,6,1,2,3], shape=[2,3]
let flat23 = []
push(flat23, 1)
push(flat23, 2)
push(flat23, 3)
push(flat23, 4)
push(flat23, 5)
push(flat23, 6)
let shape23 = []
push(shape23, 2)
push(shape23, 3)
let t23 = []
push(t23, flat23)
push(t23, shape23)

let flip2d_ax0 = tp_flip(t23, 0)
let want_flip2d_ax0 = []
push(want_flip2d_ax0, 4)
push(want_flip2d_ax0, 5)
push(want_flip2d_ax0, 6)
push(want_flip2d_ax0, 1)
push(want_flip2d_ax0, 2)
push(want_flip2d_ax0, 3)
let want_flip2d_ax0_shape = []
push(want_flip2d_ax0_shape, 2)
push(want_flip2d_ax0_shape, 3)
ckt("flip_2x3_axis0", flip2d_ax0, want_flip2d_ax0, want_flip2d_ax0_shape)

// 2x3 [[1,2,3],[4,5,6]], axis=1 (reverse columns) -> [[3,2,1],[6,5,4]]
// flat = [3,2,1,6,5,4], shape=[2,3]
let flip2d_ax1 = tp_flip(t23, 1)
let want_flip2d_ax1 = []
push(want_flip2d_ax1, 3)
push(want_flip2d_ax1, 2)
push(want_flip2d_ax1, 1)
push(want_flip2d_ax1, 6)
push(want_flip2d_ax1, 5)
push(want_flip2d_ax1, 4)
let want_flip2d_ax1_shape = []
push(want_flip2d_ax1_shape, 2)
push(want_flip2d_ax1_shape, 3)
ckt("flip_2x3_axis1", flip2d_ax1, want_flip2d_ax1, want_flip2d_ax1_shape)

// ---- tp_tile ----
// [1,2], reps=2 -> [1,2,1,2], shape=[4]
let flat2 = []
push(flat2, 1)
push(flat2, 2)
let shape2 = []
push(shape2, 2)
let t2 = []
push(t2, flat2)
push(t2, shape2)

let tiled = tp_tile(t2, 2)
let want_tiled = []
push(want_tiled, 1)
push(want_tiled, 2)
push(want_tiled, 1)
push(want_tiled, 2)
let want_tiled_shape = []
push(want_tiled_shape, 4)
ckt("tile_2_reps2", tiled, want_tiled, want_tiled_shape)

// reps=3 -> [1,2,1,2,1,2], shape=[6]
let tiled3 = tp_tile(t2, 3)
let want_tiled3 = []
push(want_tiled3, 1)
push(want_tiled3, 2)
push(want_tiled3, 1)
push(want_tiled3, 2)
push(want_tiled3, 1)
push(want_tiled3, 2)
let want_tiled3_shape = []
push(want_tiled3_shape, 6)
ckt("tile_2_reps3", tiled3, want_tiled3, want_tiled3_shape)

print("PASS _tsr_pad_test")
