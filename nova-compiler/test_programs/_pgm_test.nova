// _pgm_test.nova — KAT for std/media/pgm
// Netpbm PGM (grayscale) encoder/decoder — P5 binary and P2 ASCII variants.
//
// KAT vectors:
//   pgm_p5_encode(2,1,[0,255]) -> 13 bytes
//     bytes 0..10 = "P5\n2 1\n255\n" (header, 11 bytes)
//     bytes[11] = 0, bytes[12] = 255
//   pgm_p5_encode(1,2,[128,64]) -> 13 bytes, pixels 128,64
//   P5 round-trip: decode(encode(w,h,px)).px == px
//   pgm_p2_encode(2,1,[0,255]) -> "P2\n2 1\n255\n0 255\n"
//   P2 round-trip: decode(encode(w,h,px)).px == px
import std/media/pgm

// ── Assertion helpers ─────────────────────────────────────────────────────────

fn ck_int(label, got, want)
    if got != want
        print("FAIL pgm " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck_str(label, got, want)
    if got != want
        print("FAIL pgm " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn ck_byte(label, b, idx, want)
    let v = bytes_get(b, idx)
    if v != want
        print("FAIL pgm " + label + " byte[" + str(idx) + "]: got=" + str(v) + " want=" + str(want))
        exit(1)

// ── KAT 1: pgm_p5_encode(2,1,[0,255]) header bytes ──────────────────────────
fn kat1()
    let px = [0, 255]
    let b = pgm_p5_encode(2, 1, px)
    // Total length must be 13: 11 header + 2 pixels
    ck_int("kat1-len", bytes_len(b), 13)
    // Header: "P5\n2 1\n255\n"
    // P=80 5=53 \n=10 2=50 space=32 1=49 \n=10 2=50 5=53 5=53 \n=10
    ck_byte("kat1-hdr-P",   b, 0,  80)
    ck_byte("kat1-hdr-5",   b, 1,  53)
    ck_byte("kat1-hdr-nl1", b, 2,  10)
    ck_byte("kat1-hdr-2",   b, 3,  50)
    ck_byte("kat1-hdr-sp",  b, 4,  32)
    ck_byte("kat1-hdr-1",   b, 5,  49)
    ck_byte("kat1-hdr-nl2", b, 6,  10)
    ck_byte("kat1-hdr-255a",b, 7,  50)
    ck_byte("kat1-hdr-255b",b, 8,  53)
    ck_byte("kat1-hdr-255c",b, 9,  53)
    ck_byte("kat1-hdr-nl3", b, 10, 10)
    // Pixel data
    ck_byte("kat1-px0",     b, 11, 0)
    ck_byte("kat1-px1",     b, 12, 255)
    print("KAT 1 PASS: pgm_p5_encode(2,1,[0,255]) bytes exact")

// ── KAT 2: pgm_p5_encode pixel clamping ──────────────────────────────────────
fn kat2()
    let px = [-5, 300]
    let b = pgm_p5_encode(2, 1, px)
    ck_int("kat2-len", bytes_len(b), 13)
    ck_byte("kat2-px0-clamped-lo", b, 11, 0)
    ck_byte("kat2-px1-clamped-hi", b, 12, 255)
    print("KAT 2 PASS: pgm_p5_encode clamps out-of-range pixels to [0,255]")

// ── KAT 3: pgm_p5_encode error cases ─────────────────────────────────────────
fn kat3()
    // Wrong pixel count returns bytes(0)
    let px = [0, 128, 255]
    let b = pgm_p5_encode(2, 1, px)
    ck_int("kat3-wrong-len", bytes_len(b), 0)
    // Zero dimension returns bytes(0)
    let b2 = pgm_p5_encode(0, 1, [])
    ck_int("kat3-zero-w", bytes_len(b2), 0)
    let b3 = pgm_p5_encode(1, 0, [])
    ck_int("kat3-zero-h", bytes_len(b3), 0)
    print("KAT 3 PASS: pgm_p5_encode returns bytes(0) on invalid input")

// ── KAT 4: pgm_p5_decode — decode the vector from KAT 1 ─────────────────────
fn kat4()
    let px = [0, 255]
    let b = pgm_p5_encode(2, 1, px)
    let d = pgm_p5_decode(b)
    ck_int("kat4-w",     d["w"], 2)
    ck_int("kat4-h",     d["h"], 1)
    let got_px = d["px"]
    ck_int("kat4-pxlen", len(got_px), 2)
    ck_int("kat4-px0",   got_px[0], 0)
    ck_int("kat4-px1",   got_px[1], 255)
    print("KAT 4 PASS: pgm_p5_decode recovers w=2 h=1 px=[0,255]")

// ── KAT 5: P5 round-trip on a 3x2 image ──────────────────────────────────────
fn kat5()
    let px = [10, 20, 30, 40, 50, 60]
    let b = pgm_p5_encode(3, 2, px)
    // Header: "P5\n3 2\n255\n" = 11 bytes + 6 pixels = 17
    ck_int("kat5-total-len", bytes_len(b), 17)
    let d = pgm_p5_decode(b)
    ck_int("kat5-w", d["w"], 3)
    ck_int("kat5-h", d["h"], 2)
    let got_px = d["px"]
    ck_int("kat5-px0", got_px[0], 10)
    ck_int("kat5-px1", got_px[1], 20)
    ck_int("kat5-px2", got_px[2], 30)
    ck_int("kat5-px3", got_px[3], 40)
    ck_int("kat5-px4", got_px[4], 50)
    ck_int("kat5-px5", got_px[5], 60)
    print("KAT 5 PASS: P5 round-trip 3x2 image byte-identical")

// ── KAT 6: pgm_p5_decode error cases ─────────────────────────────────────────
fn kat6()
    // Bad magic (P6 instead of P5) -> {}
    let bad = bytes(0)
    bad = bytes_append(bad, 80)
    bad = bytes_append(bad, 54)
    bad = bytes_append(bad, 10)
    bad = bytes_append(bad, 49)
    bad = bytes_append(bad, 32)
    bad = bytes_append(bad, 49)
    bad = bytes_append(bad, 10)
    bad = bytes_append(bad, 50)
    bad = bytes_append(bad, 53)
    bad = bytes_append(bad, 53)
    bad = bytes_append(bad, 10)
    bad = bytes_append(bad, 128)
    let d = pgm_p5_decode(bad)
    ck_int("kat6-bad-magic-len", len(d), 0)
    // Truncated (only 5 bytes) -> {}
    let tiny = bytes(0)
    tiny = bytes_append(tiny, 80)
    tiny = bytes_append(tiny, 53)
    tiny = bytes_append(tiny, 10)
    tiny = bytes_append(tiny, 49)
    tiny = bytes_append(tiny, 32)
    let d2 = pgm_p5_decode(tiny)
    ck_int("kat6-truncated", len(d2), 0)
    print("KAT 6 PASS: pgm_p5_decode returns empty dict on malformed input")

// ── KAT 7: pgm_p2_encode(2,1,[0,255]) exact string ──────────────────────────
fn kat7()
    let px = [0, 255]
    let s = pgm_p2_encode(2, 1, px)
    ck_str("kat7-p2-str", s, "P2\n2 1\n255\n0 255\n")
    print("KAT 7 PASS: pgm_p2_encode(2,1,[0,255]) == 'P2\\n2 1\\n255\\n0 255\\n'")

// ── KAT 8: pgm_p2_encode a 3x1 image ─────────────────────────────────────────
fn kat8()
    let px = [0, 128, 255]
    let s = pgm_p2_encode(3, 1, px)
    ck_str("kat8-p2-3x1", s, "P2\n3 1\n255\n0 128 255\n")
    print("KAT 8 PASS: pgm_p2_encode(3,1,[0,128,255]) exact")

// ── KAT 9: pgm_p2_encode error cases ─────────────────────────────────────────
fn kat9()
    let s = pgm_p2_encode(2, 1, [0, 128, 255])
    ck_str("kat9-wrong-count", s, "")
    let s2 = pgm_p2_encode(0, 1, [])
    ck_str("kat9-zero-w", s2, "")
    print("KAT 9 PASS: pgm_p2_encode returns '' on invalid input")

// ── KAT 10: pgm_p2_decode — decode the vector from KAT 7 ─────────────────────
fn kat10()
    let s = "P2\n2 1\n255\n0 255\n"
    let d = pgm_p2_decode(s)
    ck_int("kat10-w",    d["w"], 2)
    ck_int("kat10-h",    d["h"], 1)
    let got_px = d["px"]
    ck_int("kat10-px0",  got_px[0], 0)
    ck_int("kat10-px1",  got_px[1], 255)
    print("KAT 10 PASS: pgm_p2_decode 'P2\\n2 1\\n255\\n0 255\\n' -> {w:2,h:1,px:[0,255]}")

// ── KAT 11: P2 round-trip on a 2x2 image ────────────────────────────────────
fn kat11()
    let px = [10, 20, 30, 40]
    let s = pgm_p2_encode(2, 2, px)
    let d = pgm_p2_decode(s)
    ck_int("kat11-w", d["w"], 2)
    ck_int("kat11-h", d["h"], 2)
    let got_px = d["px"]
    ck_int("kat11-px0", got_px[0], 10)
    ck_int("kat11-px1", got_px[1], 20)
    ck_int("kat11-px2", got_px[2], 30)
    ck_int("kat11-px3", got_px[3], 40)
    print("KAT 11 PASS: P2 round-trip 2x2 image pixel-identical")

// ── KAT 12: pgm_p2_decode error cases ────────────────────────────────────────
fn kat12()
    // Wrong magic (P5 header fed to P2 decode) -> {}
    let d = pgm_p2_decode("P5\n2 1\n255\n")
    ck_int("kat12-bad-magic", len(d), 0)
    // Empty string -> {}
    let d2 = pgm_p2_decode("")
    ck_int("kat12-empty", len(d2), 0)
    print("KAT 12 PASS: pgm_p2_decode returns empty dict on malformed input")

// ── KAT 13: cross-format — P5 encode then manually verify header prefix ──────
fn kat13()
    // Encode a 1x1 image (single pixel value 128)
    let px = [128]
    let b = pgm_p5_encode(1, 1, px)
    // Header "P5\n1 1\n255\n" = 11 bytes + 1 pixel = 12 total
    ck_int("kat13-len", bytes_len(b), 12)
    ck_byte("kat13-px0", b, 11, 128)
    // Decode and verify
    let d = pgm_p5_decode(b)
    ck_int("kat13-w", d["w"], 1)
    ck_int("kat13-h", d["h"], 1)
    let got_px = d["px"]
    ck_int("kat13-pixel", got_px[0], 128)
    print("KAT 13 PASS: 1x1 P5 image single mid-gray pixel")

fn main()
    kat1()
    kat2()
    kat3()
    kat4()
    kat5()
    kat6()
    kat7()
    kat8()
    kat9()
    kat10()
    kat11()
    kat12()
    kat13()
    print("PASS _pgm_test")
