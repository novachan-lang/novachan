enum PtrFail
    NoKey(string)
    IndexBad(int)
    Nullary()

// The whole point: a TYPED parameter and a TYPED return over an enum.
fn render(f: PtrFail) -> string
    match f
        NoKey(t) => "no key '{t}'"
        IndexBad(i) => "bad index {i}"
        Nullary() => "nullary"

fn pick(n: int) -> PtrFail
    if n == 0
        return NoKey("a")
    if n == 1
        return IndexBad(7)
    Nullary()

fn main()
    print(render(NoKey("k")))
    print(render(IndexBad(3)))
    print(render(Nullary()))
    print(render(pick(0)))
    print(render(pick(1)))
    print(render(pick(2)))
    // exhaustiveness must still work: a match missing an arm is still an error
    print("ADT-TYPED-OK")
