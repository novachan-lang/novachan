// heterogeneous un-annotated return -> should compile (widen to any)
fn classify(k: int)
    if k == 0
        return 42
    if k == 1
        return "hello"
    return true

// consistent un-annotated return -> should keep concrete int typing + correct math
fn addup(a: int, b: int)
    return a + b

// procedure with early return 0 + unit fall-through -> should compile (no int/unit conflict)
fn note(x: int, acc: list)
    if x < 0
        return 0
    push(acc, x)

fn main()
    print(classify(0))     // 42
    print(classify(1))     // hello
    print(classify(2))     // true -> prints 1
    let s = addup(3, 4)
    print(s + 1)           // 8  (proves addup result is a real int, not boxed garbage)
    let acc = []
    note(5, acc)
    note(-1, acc)
    print(len(acc))        // 1
    print("done-t1")
