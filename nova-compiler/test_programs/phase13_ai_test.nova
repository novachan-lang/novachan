// Phase 13 AI: 1D integer array ops + model inference stub

fn test_arr_basics()
    // Create a 4-element array
    let t = arr_create(4)
    assert_eq(t >= 0, true)
    assert_eq(arr_size(t), 4)
    // Set and get values
    arr_set(t, 0, 10)
    arr_set(t, 1, 20)
    arr_set(t, 2, 30)
    arr_set(t, 3, 40)
    assert_eq(arr_get(t, 0), 10)
    assert_eq(arr_get(t, 3), 40)
    // Fill with constant
    arr_fill(t, 5)
    assert_eq(arr_get(t, 0), 5)
    assert_eq(arr_get(t, 3), 5)
    arr_free(t)
    print("Array basics test passed")

fn test_arr_math()
    let a = arr_create(3)
    let b = arr_create(3)
    arr_set(a, 0, 1)
    arr_set(a, 1, 2)
    arr_set(a, 2, 3)
    arr_set(b, 0, 4)
    arr_set(b, 1, 5)
    arr_set(b, 2, 6)
    // Add: [1+4, 2+5, 3+6] = [5, 7, 9]
    let c = arr_add(a, b)
    assert_eq(arr_get(c, 0), 5)
    assert_eq(arr_get(c, 1), 7)
    assert_eq(arr_get(c, 2), 9)
    // Dot product: 1*4 + 2*5 + 3*6 = 4+10+18 = 32
    let d = arr_dot(a, b)
    assert_eq(d, 32)
    arr_free(a)
    arr_free(b)
    arr_free(c)
    print("Array math test passed")

fn test_model_inference()
    // model_load returns -1 if file missing
    let m = model_load("nonexistent_model.bin")
    assert_eq(m, -1)
    // Use this file itself as a "model" (identity stub)
    let m2 = model_load("phase13_ai_test.nova")
    assert_eq(m2 >= 0, true)
    // Create input array
    let inp = arr_create(3)
    arr_set(inp, 0, 100)
    arr_set(inp, 1, 200)
    arr_set(inp, 2, 300)
    // Run identity inference: output = copy of input
    let out = model_infer(m2, inp)
    assert_eq(out >= 0, true)
    assert_eq(arr_get(out, 0), 100)
    assert_eq(arr_get(out, 1), 200)
    assert_eq(arr_size(out), 3)
    arr_free(inp)
    arr_free(out)
    model_close(m2)
    print("Model inference test passed")

fn main()
    test_arr_basics()
    test_arr_math()
    test_model_inference()
    print("All Phase 13 AI tests passed!")
