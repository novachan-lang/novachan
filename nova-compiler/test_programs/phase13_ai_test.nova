// Phase 13 AI: 1D integer array ops + REAL tensor inference pipeline.
// (The former model_load/model_infer were a fake identity stub — removed
//  2026-05-29. Real inference = tensor matmul -> relu -> argmax, below.)

fn test_arr_basics()
    // Create a 4-element array
    let t = arr_create(4)
    assert_eq(t >= 0, true)
    assert_eq(arr_size(t), 4)
    // Set and get values
    arr_set(t, 0, 10)
    arr_set(t, 1, 20)
    arr_set(t, 2, 30)
    arr_set(t, 3, 40)
    assert_eq(arr_get(t, 0), 10)
    assert_eq(arr_get(t, 3), 40)
    // Fill with constant
    arr_fill(t, 5)
    assert_eq(arr_get(t, 0), 5)
    assert_eq(arr_get(t, 3), 5)
    arr_free(t)
    print("Array basics test passed")

fn test_arr_math()
    let a = arr_create(3)
    let b = arr_create(3)
    arr_set(a, 0, 1)
    arr_set(a, 1, 2)
    arr_set(a, 2, 3)
    arr_set(b, 0, 4)
    arr_set(b, 1, 5)
    arr_set(b, 2, 6)
    // Add: [1+4, 2+5, 3+6] = [5, 7, 9]
    let c = arr_add(a, b)
    assert_eq(arr_get(c, 0), 5)
    assert_eq(arr_get(c, 1), 7)
    assert_eq(arr_get(c, 2), 9)
    // Dot product: 1*4 + 2*5 + 3*6 = 4+10+18 = 32
    let d = arr_dot(a, b)
    assert_eq(d, 32)
    arr_free(a)
    arr_free(b)
    arr_free(c)
    print("Array math test passed")

fn argmax(xs: list) -> int
    let best = 0
    let bv = xs[0]
    let i = 1
    while i < len(xs)
        if xs[i] > bv
            bv = xs[i]
            best = i
        i = i + 1
    best

fn test_tensor_inference()
    // Real linear layer: x[1x2] @ W[2x3]. Hand-computed:
    // [1,2] @ [[1,2,0],[0,1,1]] = [1*1+2*0, 1*2+2*1, 1*0+2*1] = [1, 4, 2]
    let x = tensor_from_list([1.0, 2.0], [1, 2])
    let w = tensor_from_list([1.0, 2.0, 0.0, 0.0, 1.0, 1.0], [2, 3])
    let logits = tensor_to_list(tensor_matmul(x, w))
    assert_near(logits[0], 1.0, 0.001)
    assert_near(logits[1], 4.0, 0.001)
    assert_near(logits[2], 2.0, 0.001)
    // argmax of [1,4,2] is index 1 (the predicted class)
    assert_eq(argmax(logits), 1)
    // ReLU zeroes negatives: relu([-3,5,-1,2]) = [0,5,0,2]
    let r = tensor_to_list(tensor_relu(tensor_from_list([-3.0, 5.0, -1.0, 2.0], [4])))
    assert_near(r[0], 0.0, 0.001)
    assert_near(r[1], 5.0, 0.001)
    assert_near(r[2], 0.0, 0.001)
    assert_near(r[3], 2.0, 0.001)
    print("Tensor inference test passed")

fn main()
    test_arr_basics()
    test_arr_math()
    test_tensor_inference()
    print("All Phase 13 AI tests passed!")
