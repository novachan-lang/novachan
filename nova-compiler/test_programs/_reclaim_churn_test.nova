// Tombstone-split reclamation proof: spawn + FINISH 100k green tasks over time, with only ~1 alive at
// once (main waits for each to finish before spawning the next). With reclamation, peak memory stays
// BOUNDED (each finished task's stack is freed at finish, only a ~400B tombstone is retained). WITHOUT
// it, memory grows ~8-20KB per task (~1GB+ at 100k) -- the unbounded-server leak. Also a UAF stress for
// the finish-path free: if reclaiming the fiber corrupts the kept NovaSchedTask / mailbox / monitor
// state, this crashes well before 100k (and ASAN catches any use-after-free).
fn churn_worker(hub)
    send(hub, 1)

fn main()
    let hub = channel()
    let rounds = 30000
    let i = 0
    let total = 0
    while i < rounds
        spawn churn_worker(hub)
        total = total + receive(hub)   // wait for THIS task to finish -> few alive at once
        i = i + 1
    assert(total == rounds, "all churned tasks delivered")
    print("RECLAIM_CHURN_OK rounds=" + str(rounds))
