// showcase_life -- Conway's Game of Life in pure NOVA. A SEVENTH subsystem angle: 2D grid evolution
// with double-buffering (each generation builds a FRESH grid, so no in-place aliasing), neighbor
// counting with bounds handling, and pattern verification. Grid is a flat W*H int list (0/1). Self-
// verifying against the known behavior of a still-life (block: stable) and an oscillator (blinker:
// period 2).

fn at(g: list, w: int, h: int, r: int, c: int) -> int
    if r < 0 or r >= h or c < 0 or c >= w
        return 0
    return g[r * w + c]

fn neighbors(g: list, w: int, h: int, r: int, c: int) -> int
    let n = 0
    let dr = -1
    while dr <= 1
        let dc = -1
        while dc <= 1
            if not (dr == 0 and dc == 0)
                n = n + at(g, w, h, r + dr, c + dc)
            dc = dc + 1
        dr = dr + 1
    return n

// one generation -> a FRESH grid (double buffer; never mutates g in place).
fn step(g: list, w: int, h: int) -> list
    let out = []
    let r = 0
    while r < h
        let c = 0
        while c < w
            let live = at(g, w, h, r, c)
            let n = neighbors(g, w, h, r, c)
            let nv = 0
            if live == 1
                if n == 2 or n == 3
                    nv = 1
            else
                if n == 3
                    nv = 1
            push(out, nv)
            c = c + 1
        r = r + 1
    return out

fn population(g: list) -> int
    let s = 0
    for v in g
        s = s + v
    return s

fn same(a: list, b: list) -> int
    if len(a) != len(b)
        return 0
    let i = 0
    while i < len(a)
        if a[i] != b[i]
            return 0
        i = i + 1
    return 1

fn blank(w: int, h: int) -> list
    let g = []
    let i = 0
    while i < w * h
        push(g, 0)
        i = i + 1
    return g

fn set_cell(g: list, w: int, r: int, c: int)
    g[r * w + c] = 1

fn render(g: list, w: int, h: int)
    let r = 0
    while r < h
        let line = ""
        let c = 0
        while c < w
            if g[r * w + c] == 1
                line = line + "#"
            else
                line = line + "."
            c = c + 1
        print(line)
        r = r + 1

fn main()
    let w = 6
    let h = 6

    // --- still life: 2x2 block at (1,1) is STABLE ---
    let block = blank(w, h)
    set_cell(block, w, 1, 1)
    set_cell(block, w, 1, 2)
    set_cell(block, w, 2, 1)
    set_cell(block, w, 2, 2)
    let b1 = step(block, w, h)
    assert(same(block, b1) == 1, "block is a stable still life")
    assert(population(b1) == 4, "block keeps 4 cells")

    // --- oscillator: horizontal blinker at row 2, cols 1-3 -> period 2 ---
    let blink = blank(w, h)
    set_cell(blink, w, 2, 1)
    set_cell(blink, w, 2, 2)
    set_cell(blink, w, 2, 3)
    print("=== blinker gen 0 ===")
    render(blink, w, h)
    let g1 = step(blink, w, h)
    print("=== blinker gen 1 ===")
    render(g1, w, h)
    // after one step it must be the VERTICAL blinker: (1,2),(2,2),(3,2)
    assert(population(g1) == 3, "blinker conserves 3 cells")
    assert(at(g1, w, h, 1, 2) == 1 and at(g1, w, h, 2, 2) == 1 and at(g1, w, h, 3, 2) == 1, "blinker rotated to vertical")
    assert(at(g1, w, h, 2, 1) == 0 and at(g1, w, h, 2, 3) == 0, "old horizontal arms are dead")
    let g2 = step(g1, w, h)
    assert(same(blink, g2) == 1, "blinker returns to start after period 2")

    // --- a lone cell dies (underpopulation) ---
    let lone = blank(w, h)
    set_cell(lone, w, 3, 3)
    let l1 = step(lone, w, h)
    assert(population(l1) == 0, "a lone cell dies")

    print("showcase_life_test passed -- Conway's Life: still-life + oscillator + rules, pure NOVA")
