import forge_sudoku

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // canonical Wikipedia puzzle
    let b = []
    push(b, [5, 3, 0, 0, 7, 0, 0, 0, 0])
    push(b, [6, 0, 0, 1, 9, 5, 0, 0, 0])
    push(b, [0, 9, 8, 0, 0, 0, 0, 6, 0])
    push(b, [8, 0, 0, 0, 6, 0, 0, 0, 3])
    push(b, [4, 0, 0, 8, 0, 3, 0, 0, 1])
    push(b, [7, 0, 0, 0, 2, 0, 0, 0, 6])
    push(b, [0, 6, 0, 0, 0, 0, 2, 8, 0])
    push(b, [0, 0, 0, 4, 1, 9, 0, 0, 5])
    push(b, [0, 0, 0, 0, 8, 0, 0, 7, 9])

    fails = fails + expect("puzzle_valid", str(sudoku_valid(b)), "true")
    let solved = sudoku_solve(b)
    fails = fails + expect("solved_rows", str(len(solved)), "9")
    fails = fails + expect("solved_complete", str(sudoku_is_complete(solved)), "true")
    // known solution cells (canonical solution)
    fails = fails + expect("cell_0_2", str(solved[0][2]), "4")
    fails = fails + expect("cell_0_0", str(solved[0][0]), "5")
    fails = fails + expect("cell_8_8", str(solved[8][8]), "9")
    fails = fails + expect("cell_4_4", str(solved[4][4]), "5")

    // invalid board (two 5s in the first row) -> not valid
    let bad = []
    push(bad, [5, 5, 0, 0, 0, 0, 0, 0, 0])
    push(bad, [0, 0, 0, 0, 0, 0, 0, 0, 0])
    push(bad, [0, 0, 0, 0, 0, 0, 0, 0, 0])
    push(bad, [0, 0, 0, 0, 0, 0, 0, 0, 0])
    push(bad, [0, 0, 0, 0, 0, 0, 0, 0, 0])
    push(bad, [0, 0, 0, 0, 0, 0, 0, 0, 0])
    push(bad, [0, 0, 0, 0, 0, 0, 0, 0, 0])
    push(bad, [0, 0, 0, 0, 0, 0, 0, 0, 0])
    push(bad, [0, 0, 0, 0, 0, 0, 0, 0, 0])
    fails = fails + expect("bad_invalid", str(sudoku_valid(bad)), "false")

    // unsolvable board -> empty result
    let unsolv = []
    push(unsolv, [5, 1, 6, 8, 4, 9, 7, 3, 2])
    push(unsolv, [3, 0, 7, 6, 0, 5, 0, 0, 0])
    push(unsolv, [8, 0, 9, 7, 0, 0, 0, 6, 5])
    push(unsolv, [1, 3, 5, 0, 6, 0, 9, 0, 7])
    push(unsolv, [4, 7, 2, 5, 9, 1, 0, 0, 6])
    push(unsolv, [9, 6, 8, 3, 7, 0, 0, 5, 0])
    push(unsolv, [2, 5, 3, 1, 8, 6, 0, 7, 4])
    push(unsolv, [6, 8, 4, 2, 0, 7, 5, 0, 0])
    push(unsolv, [7, 9, 1, 0, 5, 0, 6, 0, 8])
    // this board has a contradiction (two of a number forced) -> unsolvable; verify solver returns empty
    fails = fails + expect("unsolv_empty", str(len(sudoku_solve(unsolv))), "0")

    if fails == 0
        print("forge_sudoku: all passed")
    else
        print("forge_sudoku: " + str(fails) + " FAILED")
