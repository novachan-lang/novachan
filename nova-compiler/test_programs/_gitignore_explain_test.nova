import std/devtool/gitignore_explain

fn main()
    // patterns list, 1-based line numbers = index + 1:
    //  line1: "# comment"        (comment)
    //  line2: "*.log"            (ignore)
    //  line3: ""                 (blank)
    //  line4: "!important.log"   (negate)
    //  line5: "build/"           (ignore, dir-only)
    //  line6: "*.tmp"            (ignore)
    //  line7: "!*.tmp"           (negate)
    let patterns = []
    push(patterns, "# comment")
    push(patterns, "*.log")
    push(patterns, "")
    push(patterns, "!important.log")
    push(patterns, "build/")
    push(patterns, "*.tmp")
    push(patterns, "!*.tmp")

    // --- gie_explain ---
    let e1 = gie_explain(patterns, "a.log", 0)
    if e1 != "ignored by pattern '*.log' (line 2)"
        print("FAIL gie_explain-basic: got '" + e1 + "'")
        exit(1)

    let e2 = gie_explain(patterns, "important.log", 0)
    if e2 != "negated by '!important.log' (line 4)"
        print("FAIL gie_explain-negated: got '" + e2 + "'")
        exit(1)

    let e3 = gie_explain(patterns, "readme.md", 0)
    if e3 != "not ignored (no matching pattern)"
        print("FAIL gie_explain-nomatch: got '" + e3 + "'")
        exit(1)

    let e4 = gie_explain(patterns, "build", 1)
    if e4 != "ignored by pattern 'build/' (line 5)"
        print("FAIL gie_explain-dironly-isdir: got '" + e4 + "'")
        exit(1)

    let e5 = gie_explain(patterns, "build", 0)
    if e5 != "not ignored (no matching pattern)"
        print("FAIL gie_explain-dironly-notdir: got '" + e5 + "'")
        exit(1)

    // --- gie_trace ---
    let t1 = gie_trace(patterns, "a.log", 0)
    if len(t1) != 5
        print("FAIL gie_trace-len: got " + str(len(t1)) + " want 5")
        exit(1)
    if t1[0][0] != "*.log" or t1[0][1] != 2 or t1[0][2] != "match"
        print("FAIL gie_trace-entry0: got " + t1[0][0] + "," + str(t1[0][1]) + "," + t1[0][2])
        exit(1)
    if t1[1][0] != "!important.log" or t1[1][1] != 4 or t1[1][2] != "no-match"
        print("FAIL gie_trace-entry1: got " + t1[1][0] + "," + str(t1[1][1]) + "," + t1[1][2])
        exit(1)
    if t1[2][0] != "build/" or t1[2][1] != 5 or t1[2][2] != "no-match"
        print("FAIL gie_trace-entry2: got " + t1[2][0] + "," + str(t1[2][1]) + "," + t1[2][2])
        exit(1)

    let t2 = gie_trace(patterns, "important.log", 0)
    if t2[0][2] != "match" or t2[1][2] != "negate"
        print("FAIL gie_trace-negate-status: got " + t2[0][2] + "," + t2[1][2])
        exit(1)

    // --- gie_summary ---
    let s1 = gie_summary(patterns)
    if s1 != "6 patterns (3 ignore, 2 negate, 1 comments)"
        print("FAIL gie_summary: got '" + s1 + "'")
        exit(1)

    let empty_summary = gie_summary([])
    if empty_summary != "0 patterns (0 ignore, 0 negate, 0 comments)"
        print("FAIL gie_summary-empty: got '" + empty_summary + "'")
        exit(1)

    // --- gie_conflicts ---
    let c1 = gie_conflicts(patterns)
    if len(c1) != 1
        print("FAIL gie_conflicts-len: got " + str(len(c1)) + " want 1")
        exit(1)
    if c1[0][0] != "*.tmp" or c1[0][1] != 6 or c1[0][2] != 7
        print("FAIL gie_conflicts-content: got " + c1[0][0] + "," + str(c1[0][1]) + "," + str(c1[0][2]))
        exit(1)

    let no_conflict = []
    push(no_conflict, "*.log")
    push(no_conflict, "!important.log")
    let c2 = gie_conflicts(no_conflict)
    if len(c2) != 0
        print("FAIL gie_conflicts-none: got " + str(len(c2)) + " want 0")
        exit(1)

    print("PASS _gitignore_explain_test")
