// cluster_leave_node.nova — a cluster node for the GRACEFUL-LEAVE test (increment 3).
// Args: <port> [seeds...] [leave]. A node whose args include the token "leave" plays the
// LEAVER: it joins, converges, then calls cluster_leave() and exits ~3.5s in. Every other
// node is an OBSERVER: it reads its liveness view at 5.5s. The point of the timing: the
// failure-detection timeout is 4000ms, so a node last-heard-from at ~2.4s would not be
// detected as "down" until ~6.4s (worst case, if an observer never re-hears it after the
// join, ~5.0s). The leaver departs at 2.5s; observers read at 4.0s. At 4.0s a CRASHED node
// is still alive (timeout not yet fired — the harness's crash-control phase proves this each
// run), so an observer seeing the leaver DOWN at 4.0s can only be the graceful-leave BROADCAST,
// not the timeout. ~1s of margin on each side keeps the verdict about the broadcast.
import clusterx

fn main()
    let argv = args()
    let port = parse_int(argv[1])
    let seeds = []
    let is_leaver = false
    let i = 2
    while i < len(argv)
        if argv[i] == "leave"
            is_leaver = true
        else
            push(seeds, argv[i])
        i = i + 1
    let info = cluster_start(port, seeds)
    if is_leaver
        sleep(2500)                          // converge first, then depart cleanly
        cluster_leave(info)
        print("LEFT port=" + str(port))
        exit(0)
    sleep(4000)                              // read AFTER the leaver's broadcast, BEFORE its timeout
    let alive = cluster_alive(info)
    let members = cluster_members(info)
    print("FINAL alive=" + str(alive) + " members=" + str(members))
    exit(0)
