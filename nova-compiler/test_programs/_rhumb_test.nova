// _rhumb_test.nova — KAT for std/geo/rhumb
import std/geo/rhumb

fn approx(a: float, b: float, tol: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < tol

fn main()
    // rhumb_distance(0,0, 0,1) -> ~111195 m (1 degree equatorial)
    let d1 = rhumb_distance(0.0, 0.0, 0.0, 1.0)
    if not approx(d1, 111195.0, 300.0)
        print("FAIL rhumb_distance equator 1deg: got " + str(d1))
        exit(1)

    // rhumb_distance >= 0 (non-negative)
    let d2 = rhumb_distance(51.5, 0.0, 48.8, 2.35)
    if d2 < 0.0
        print("FAIL rhumb_distance negative: got " + str(d2))
        exit(1)

    // rhumb_bearing(0,0, 0,1) -> 90 degrees (due east)
    let b1 = rhumb_bearing(0.0, 0.0, 0.0, 1.0)
    if not approx(b1, 90.0, 0.5)
        print("FAIL rhumb_bearing due east: got " + str(b1))
        exit(1)

    // rhumb_bearing(0,0, 1,0) -> 0 degrees (due north)
    let b2 = rhumb_bearing(0.0, 0.0, 1.0, 0.0)
    if not approx(b2, 0.0, 0.5)
        print("FAIL rhumb_bearing due north: got " + str(b2))
        exit(1)

    // rhumb_bearing(1,0, 0,0) -> 180 degrees (due south)
    let b3 = rhumb_bearing(1.0, 0.0, 0.0, 0.0)
    if not approx(b3, 180.0, 0.5)
        print("FAIL rhumb_bearing due south: got " + str(b3))
        exit(1)

    // rhumb_bearing(0,1, 0,0) -> 270 degrees (due west)
    let b4 = rhumb_bearing(0.0, 1.0, 0.0, 0.0)
    if not approx(b4, 270.0, 0.5)
        print("FAIL rhumb_bearing due west: got " + str(b4))
        exit(1)

    // rhumb_distance same point -> 0
    let d3 = rhumb_distance(0.0, 0.0, 0.0, 0.0)
    if not approx(d3, 0.0, 1.0)
        print("FAIL rhumb_distance same point: got " + str(d3))
        exit(1)

    print("PASS _rhumb_test")
