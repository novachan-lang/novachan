import std/text/frequency

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got [" + got + "] expected [" + expected + "]")
        exit(1)

// ── KAT 1: freq_chars("aab")["a"] == 2 ──────────────────────────────────────
let chars1 = freq_chars("aab")
let ka1 = chars1["a"]
cki("freq_chars aab a==2", ka1, 2)

// ── KAT 2: freq_chars("aab")["b"] == 1 ──────────────────────────────────────
let kb1 = chars1["b"]
cki("freq_chars aab b==1", kb1, 1)

// ── KAT 3: freq_words("the cat the dog the")["the"] == 3 ────────────────────
let words1 = freq_words("the cat the dog the")
let wthe = words1["the"]
cki("freq_words the==3", wthe, 3)

// ── KAT 4: freq_top_k("a a a b b c", 2) == [["a",3],["b",2]] ───────────────
let top2 = freq_top_k("a a a b b c", 2)
let t0 = top2[0]
let t1 = top2[1]
let t0w = t0[0]
let t0c = t0[1]
let t1w = t1[0]
let t1c = t1[1]
cks("freq_top_k top[0] word", t0w, "a")
cki("freq_top_k top[0] count", t0c, 3)
cks("freq_top_k top[1] word", t1w, "b")
cki("freq_top_k top[1] count", t1c, 2)

// ── KAT 5: freq_most_common_char("aabbbc") == "b" ───────────────────────────
let mc1 = freq_most_common_char("aabbbc")
cks("freq_most_common_char aabbbc", mc1, "b")

// ── KAT 6: len(keys(freq_words("one two"))) == 2 ────────────────────────────
let w2 = freq_words("one two")
let nkeys = len(keys(w2))
cki("freq_words two words key count", nkeys, 2)

print("_frequency_test passed")
