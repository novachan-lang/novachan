import std/parsing/exprvars

fn main()
    // KAT 1: a*2+b  with a=3,b=4 => 3*2+4 = 10
    let vars1 = {}
    vars1["a"] = 3
    vars1["b"] = 4
    let got1 = ev_eval("a*2+b", vars1)
    if got1 != 10
        print("FAIL exprvars a*2+b: got "+str(got1)+" want 10")
        exit(1)

    // KAT 2: max(a,b)  a=3,b=7 => 7
    let vars2 = {}
    vars2["a"] = 3
    vars2["b"] = 7
    let got2 = ev_eval("max(a,b)", vars2)
    if got2 != 7
        print("FAIL exprvars max(a,b): got "+str(got2)+" want 7")
        exit(1)

    // KAT 3: min(a,b)  a=3,b=7 => 3
    let got3 = ev_eval("min(a,b)", vars2)
    if got3 != 3
        print("FAIL exprvars min(a,b): got "+str(got3)+" want 3")
        exit(1)

    // KAT 4: abs(x)  x=-5 => 5
    let vars4 = {}
    vars4["x"] = -5
    let got4 = ev_eval("abs(x)", vars4)
    if got4 != 5
        print("FAIL exprvars abs(x): got "+str(got4)+" want 5")
        exit(1)

    // KAT 5: pow(2,n)  n=8 => 256
    let vars5 = {}
    vars5["n"] = 8
    let got5 = ev_eval("pow(2,n)", vars5)
    if got5 != 256
        print("FAIL exprvars pow(2,n): got "+str(got5)+" want 256")
        exit(1)

    // KAT 6: (a+b)*c  a=1,b=2,c=3 => 9
    let vars6 = {}
    vars6["a"] = 1
    vars6["b"] = 2
    vars6["c"] = 3
    let got6 = ev_eval("(a+b)*c", vars6)
    if got6 != 9
        print("FAIL exprvars (a+b)*c: got "+str(got6)+" want 9")
        exit(1)

    // KAT 7: ev_vars("a+b*a") contains "a" and "b"
    let vlist = ev_vars("a+b*a")
    let has_a = 0
    let has_b = 0
    let vi = 0
    while vi < len(vlist)
        if vlist[vi] == "a"
            has_a = 1
        if vlist[vi] == "b"
            has_b = 1
        vi = vi + 1
    if has_a != 1
        print("FAIL exprvars ev_vars missing a")
        exit(1)
    if has_b != 1
        print("FAIL exprvars ev_vars missing b")
        exit(1)

    // KAT 8: empty expression returns 0 (safe)
    let vars_empty = {}
    let got8 = ev_eval("", vars_empty)
    if got8 != 0
        print("FAIL exprvars empty: got "+str(got8)+" want 0")
        exit(1)

    // KAT 9: malformed expression returns 0 (safe, no crash)
    let got9 = ev_eval("((( ", vars_empty)
    if got9 != 0
        print("FAIL exprvars malformed: got "+str(got9)+" want 0")
        exit(1)

    // KAT 10: unknown variable evaluates to 0 (safe)
    let got10 = ev_eval("z+1", vars_empty)
    if got10 != 1
        print("FAIL exprvars unknown var: got "+str(got10)+" want 1")
        exit(1)

    // KAT 11: unary minus  -a  a=5 => -5
    let vars11 = {}
    vars11["a"] = 5
    let got11 = ev_eval("-a", vars11)
    if got11 != -5
        print("FAIL exprvars -a: got "+str(got11)+" want -5")
        exit(1)

    // KAT 12: ev_vars de-duplicates  "a+b*a" should have exactly 2 unique names
    let vlist2 = ev_vars("a+b*a")
    let vlen = len(vlist2)
    if vlen != 2
        print("FAIL exprvars ev_vars dedup: got "+str(vlen)+" want 2")
        exit(1)

    // KAT 13: ev_vars on expression with only built-ins -> empty list
    let bvars_empty = {}
    let vlist3 = ev_vars("max(1,2)")
    let vlen3 = len(vlist3)
    if vlen3 != 0
        print("FAIL exprvars ev_vars builtins not excluded: got "+str(vlen3)+" want 0")
        exit(1)

    // KAT 14: integer division truncates  7/2 = 3
    let got14 = ev_eval("7/2", bvars_empty)
    if got14 != 3
        print("FAIL exprvars 7/2: got "+str(got14)+" want 3")
        exit(1)

    // KAT 15: chained operations  1+2+3+4 = 10
    let got15 = ev_eval("1+2+3+4", bvars_empty)
    if got15 != 10
        print("FAIL exprvars 1+2+3+4: got "+str(got15)+" want 10")
        exit(1)

    print("PASS _exprvars_test")
