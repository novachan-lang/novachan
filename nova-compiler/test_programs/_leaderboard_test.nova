import std/game/leaderboard

fn chk_int(label, got, want)
    if got != want
        print("FAIL leaderboard " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn make_entry(id, score)
    let e = []
    push(e, id)
    push(e, score)
    return e

fn main()
    // KAT 1: basic 3 entries — rank_entries([[1,10],[2,30],[3,20]])
    // Expected: id2 rank1, id3 rank2, id1 rank3
    let e1 = []
    push(e1, make_entry(1, 10))
    push(e1, make_entry(2, 30))
    push(e1, make_entry(3, 20))
    let r1 = rank_entries(e1)
    chk_int("r1 len", len(r1), 3)
    chk_int("r1[0] id", r1[0][0], 2)
    chk_int("r1[0] score", r1[0][1], 30)
    chk_int("r1[0] rank", r1[0][2], 1)
    chk_int("r1[1] id", r1[1][0], 3)
    chk_int("r1[1] score", r1[1][1], 20)
    chk_int("r1[1] rank", r1[1][2], 2)
    chk_int("r1[2] id", r1[2][0], 1)
    chk_int("r1[2] score", r1[2][1], 10)
    chk_int("r1[2] rank", r1[2][2], 3)

    // KAT 2: ties — [[1,10],[2,10],[3,5]] -> ranks 1,1,3
    let e2 = []
    push(e2, make_entry(1, 10))
    push(e2, make_entry(2, 10))
    push(e2, make_entry(3, 5))
    let r2 = rank_entries(e2)
    chk_int("r2 len", len(r2), 3)
    chk_int("r2[0] rank", r2[0][2], 1)
    chk_int("r2[1] rank", r2[1][2], 1)
    chk_int("r2[2] rank", r2[2][2], 3)
    chk_int("r2[2] id", r2[2][0], 3)

    // KAT 3: single entry
    let e3 = []
    push(e3, make_entry(7, 100))
    let r3 = rank_entries(e3)
    chk_int("r3 len", len(r3), 1)
    chk_int("r3[0] rank", r3[0][2], 1)

    // KAT 4: empty
    let e4 = []
    let r4 = rank_entries(e4)
    chk_int("r4 len", len(r4), 0)

    // KAT 5: top_n returns first n
    let e5 = []
    push(e5, make_entry(1, 10))
    push(e5, make_entry(2, 30))
    push(e5, make_entry(3, 20))
    let t5 = top_n(e5, 2)
    chk_int("top_n len", len(t5), 2)
    chk_int("top_n[0] id", t5[0][0], 2)
    chk_int("top_n[1] id", t5[1][0], 3)

    // KAT 6: top_n with n > total returns all
    let t6 = top_n(e5, 10)
    chk_int("top_n overflow", len(t6), 3)

    // KAT 7: three-way tie — all rank 1, next rank would be 4
    let e7 = []
    push(e7, make_entry(1, 50))
    push(e7, make_entry(2, 50))
    push(e7, make_entry(3, 50))
    let r7 = rank_entries(e7)
    chk_int("3-tie r0 rank", r7[0][2], 1)
    chk_int("3-tie r1 rank", r7[1][2], 1)
    chk_int("3-tie r2 rank", r7[2][2], 1)

    print("PASS _leaderboard_test")
