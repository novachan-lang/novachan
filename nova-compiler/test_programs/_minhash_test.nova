import std/sketch/minhash

fn ckf(label, got, lo, hi)
    if got < lo or got > hi
        print("FAIL " + label + ": got=" + str(got) + " want=[" + str(lo) + "," + str(hi) + "]")
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    let state = mh_new(64)

    // KAT 1: num_hashes stored correctly.
    cki("num_hashes", mh_num_hashes(state), 64)

    // KAT 2: determinism — two calls to mh_signature with same tokens give same result.
    let tokens_abcd = ["a", "b", "c", "d"]
    let sig1 = mh_signature(state, tokens_abcd)
    let sig2 = mh_signature(state, tokens_abcd)
    cki("sig_len", len(sig1), 64)
    let ok = 1
    let i = 0
    while i < 64
        if sig1[i] != sig2[i]
            ok = 0
        i = i + 1
    cki("determinism", ok, 1)

    // KAT 3: identical sets -> similarity == 1.0.
    let sim_identical = mh_similarity(state, tokens_abcd, tokens_abcd)
    // Must be exactly 1.0 (every signature position agrees).
    if sim_identical < 0.99
        print("FAIL identical_sim: got=" + str(sim_identical) + " want=1.0")
        exit(1)

    // KAT 4: disjoint sets -> similarity near 0.0 (assert <= 0.2).
    let tokens_wxyz = ["w", "x", "y", "z"]
    let sim_disjoint = mh_similarity(state, tokens_abcd, tokens_wxyz)
    if sim_disjoint > 0.2
        print("FAIL disjoint_sim: got=" + str(sim_disjoint) + " want<=0.2")
        exit(1)

    // KAT 5: partial overlap -> similarity between disjoint and 1.0.
    // ['a','b','c','d'] vs ['a','b','c','e'] -> 3/4 Jaccard = 0.6 true; assert > 0.3 < 1.0.
    let tokens_abce = ["a", "b", "c", "e"]
    let sim_partial = mh_similarity(state, tokens_abcd, tokens_abce)
    if sim_partial <= 0.3
        print("FAIL partial_sim_low: got=" + str(sim_partial) + " want>0.3")
        exit(1)
    if sim_partial >= 1.0
        print("FAIL partial_sim_high: got=" + str(sim_partial) + " want<1.0")
        exit(1)

    // KAT 6: mh_jaccard of two identical signatures == 1.0.
    let sig_a = mh_signature(state, tokens_abcd)
    let sig_b = mh_signature(state, tokens_abcd)
    let jac = mh_jaccard(sig_a, sig_b)
    if jac < 0.99
        print("FAIL jaccard_identical: got=" + str(jac) + " want=1.0")
        exit(1)

    // KAT 7: mh_merge_sig gives union (element-wise min), same as identical sets.
    let sig_x = mh_signature(state, tokens_abcd)
    let sig_y = mh_signature(state, tokens_abcd)
    let merged = mh_merge_sig(sig_x, sig_y)
    cki("merge_len", len(merged), 64)
    // Merged of identical sigs should equal each sig element-wise.
    let match_ok = 1
    let mi = 0
    while mi < 64
        if merged[mi] != sig_x[mi]
            match_ok = 0
        mi = mi + 1
    cki("merge_identical", match_ok, 1)

    // KAT 8: mh_hash_i is deterministic.
    let h1 = mh_hash_i("hello", 0)
    let h2 = mh_hash_i("hello", 0)
    cki("hash_i_determinism", h1, h2)
    // And non-negative (63-bit).
    if h1 < 0
        print("FAIL hash_i_negative: got=" + str(h1))
        exit(1)

    // KAT 9: different hash-function indices give different values (with high probability).
    let ha = mh_hash_i("test_token", 0)
    let hb = mh_hash_i("test_token", 1)
    // Not strictly guaranteed but should be true for any reasonable token.
    if ha == hb
        print("FAIL hash_i_same_for_different_i: h0=" + str(ha) + " h1=" + str(hb))
        exit(1)

    // KAT 10: partial overlap rank ordering — partial must be between disjoint and identical.
    if sim_partial <= sim_disjoint and sim_disjoint > 0.0
        print("FAIL rank_order: partial=" + str(sim_partial) + " disjoint=" + str(sim_disjoint))
        exit(1)

    print("PASS _minhash_test")

main()
