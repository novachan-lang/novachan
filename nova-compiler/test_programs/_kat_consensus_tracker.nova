import forge_consensus_tracker

fn main()
    let c = ct_new(3)
    c = ct_propose(c, "p1", "set-leader-A")
    assert(ct_proposal_count(c) == 1, "1 proposal")
    assert(ct_value(c, "p1") == "set-leader-A", "value")

    c = ct_vote_for(c, "p1")
    c = ct_vote_for(c, "p1")
    assert(ct_is_decided(c, "p1") == 0, "not decided at 2")
    assert(ct_votes_for(c, "p1") == 2, "2 for")

    c = ct_vote_for(c, "p1")
    assert(ct_is_decided(c, "p1") == 1, "decided at 3")
    assert(ct_is_accepted(c, "p1") == 1, "accepted")

    c = ct_propose(c, "p2", "set-leader-B")
    c = ct_vote_against(c, "p2")
    c = ct_vote_against(c, "p2")
    c = ct_vote_against(c, "p2")
    assert(ct_is_decided(c, "p2") == 1, "p2 decided")
    assert(ct_is_accepted(c, "p2") == 0, "p2 rejected")

    print("CONSENSUS-TRACKER KAT PASS")
