// _dist_uniform_test.nova — KAT for std/numeric/dist_uniform
// Known-answer values verified analytically.
import std/numeric/dist_uniform

fn approx(a, b, tol) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < tol
        return 1
    return 0

fn ck(label: string, got: float, want: float, tol: float)
    let ok = approx(got, want, tol)
    if ok == 0
        print("FAIL dist_uniform " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)
    print("ok " + label)

fn main()
    // uni_pdf(0.5, 0.0, 1.0) = 1.0/(1.0-0.0) = 1.0
    let v1 = uni_pdf(0.5, 0.0, 1.0)
    ck("uni_pdf(0.5,0,1)=1.0", v1, 1.0, 0.0001)

    // uni_pdf outside range must be 0.0
    let v2 = uni_pdf(2.0, 0.0, 1.0)
    ck("uni_pdf(2,0,1)=0", v2, 0.0, 0.0001)

    let v3 = uni_pdf(0.0 - 0.5, 0.0, 1.0)
    ck("uni_pdf(-0.5,0,1)=0", v3, 0.0, 0.0001)

    // uni_pdf on wider interval [2, 6]: pdf = 1/(6-2) = 0.25
    let v4 = uni_pdf(4.0, 2.0, 6.0)
    ck("uni_pdf(4,2,6)=0.25", v4, 0.25, 0.0001)

    // uni_cdf(0.5, 0.0, 1.0) = 0.5
    let v5 = uni_cdf(0.5, 0.0, 1.0)
    ck("uni_cdf(0.5,0,1)=0.5", v5, 0.5, 0.0001)

    // uni_cdf(0.0, 0.0, 1.0) = 0.0
    let v6 = uni_cdf(0.0, 0.0, 1.0)
    ck("uni_cdf(0,0,1)=0", v6, 0.0, 0.0001)

    // uni_cdf(1.0, 0.0, 1.0) = 1.0
    let v7 = uni_cdf(1.0, 0.0, 1.0)
    ck("uni_cdf(1,0,1)=1", v7, 1.0, 0.0001)

    // uni_cdf clamp below: cdf(-1,0,1) = 0
    let v8 = uni_cdf(0.0 - 1.0, 0.0, 1.0)
    ck("uni_cdf(-1,0,1)=0", v8, 0.0, 0.0001)

    // uni_cdf clamp above: cdf(2,0,1) = 1
    let v9 = uni_cdf(2.0, 0.0, 1.0)
    ck("uni_cdf(2,0,1)=1", v9, 1.0, 0.0001)

    // uni_mean(0.0, 10.0) = 5.0
    let v10 = uni_mean(0.0, 10.0)
    ck("uni_mean(0,10)=5", v10, 5.0, 0.0001)

    // uni_mean(-3.0, 3.0) = 0.0
    let v11 = uni_mean(0.0 - 3.0, 3.0)
    ck("uni_mean(-3,3)=0", v11, 0.0, 0.0001)

    // uni_var(0.0, 1.0) = 1/12 ~= 0.08333
    let v12 = uni_var(0.0, 1.0)
    ck("uni_var(0,1)=1/12", v12, 0.0833, 0.0001)

    // uni_var(0.0, 2.0) = 4/12 = 1/3 ~= 0.33333
    let v13 = uni_var(0.0, 2.0)
    ck("uni_var(0,2)=1/3", v13, 0.3333, 0.0001)

    print("PASS _dist_uniform_test")
