import forge_paillier as pa

fn check(cond: bool, label: str)
    if cond == false
        print("FAIL: " + label)

// Use small primes for KAT: p=17, q=23 -> n=391, n^2=152881
let kp = pa.paillier_keygen(17, 23)
let n = kp[0]
let g = kp[1]
let lam = kp[2]
let mu = kp[3]

check(n == 391, "n=17*23=391")
check(g == 392, "g=n+1=392")

// TEST 1: Basic encrypt/decrypt round-trip
let c0 = pa.paillier_encrypt(0, n, g, 2)
check(pa.paillier_decrypt(c0, n, lam, mu) == 0, "decrypt(enc(0))=0")

let c5 = pa.paillier_encrypt(5, n, g, 3)
check(pa.paillier_decrypt(c5, n, lam, mu) == 5, "decrypt(enc(5))=5")

let c100 = pa.paillier_encrypt(100, n, g, 7)
check(pa.paillier_decrypt(c100, n, lam, mu) == 100, "decrypt(enc(100))=100")

let c200 = pa.paillier_encrypt(200, n, g, 11)
check(pa.paillier_decrypt(c200, n, lam, mu) == 200, "decrypt(enc(200))=200")

// TEST 2: Homomorphic addition: Enc(m1) * Enc(m2) decrypts to m1+m2 (mod n)
// NOTE: r must be coprime to n=391=17*23; avoid multiples of 17 or 23
let c3 = pa.paillier_encrypt(3, n, g, 5)
let c4 = pa.paillier_encrypt(4, n, g, 6)
let c_sum = pa.paillier_add(c3, c4, n)
check(pa.paillier_decrypt(c_sum, n, lam, mu) == 7, "HE: dec(enc(3)+enc(4))=7")

// Enc(10) + Enc(20) = Enc(30)
let c10 = pa.paillier_encrypt(10, n, g, 13)
let c20 = pa.paillier_encrypt(20, n, g, 15)
let c30 = pa.paillier_add(c10, c20, n)
check(pa.paillier_decrypt(c30, n, lam, mu) == 30, "HE: dec(enc(10)+enc(20))=30")

// TEST 3: Homomorphic scalar multiplication: Enc(m)^k decrypts to m*k (mod n)
let c7 = pa.paillier_encrypt(7, n, g, 19)
let c_times3 = pa.paillier_scalar_mul(c7, 3, n)
check(pa.paillier_decrypt(c_times3, n, lam, mu) == 21, "HE: dec(enc(7)^3)=21")

let c6 = pa.paillier_encrypt(6, n, g, 24)
let c_times0 = pa.paillier_scalar_mul(c6, 0, n)
// c^0 = 1, which should decrypt to 0 (since 1 = enc(0) with r=1 if computed correctly)
// Actually c^0 = 1 always, and paillier_decrypt(1) = L(1^lambda mod n^2) * mu = L(1) * mu = 0
check(pa.paillier_decrypt(c_times0, n, lam, mu) == 0, "HE: dec(enc(6)^0)=0")

// TEST 4: Addition of multiple ciphertexts = vote tallying
// Simulate: 5 votes for (1), 3 votes for (0), tally = 5
let c1_a = pa.paillier_encrypt(1, n, g, 2)
let c1_b = pa.paillier_encrypt(1, n, g, 4)
let c1_c = pa.paillier_encrypt(1, n, g, 8)
let c1_d = pa.paillier_encrypt(1, n, g, 16)
let c1_e = pa.paillier_encrypt(1, n, g, 32)
let c0_a = pa.paillier_encrypt(0, n, g, 64)
let c0_b = pa.paillier_encrypt(0, n, g, 128)
let c0_c = pa.paillier_encrypt(0, n, g, 3)
let tally = pa.paillier_add(c1_a, c1_b, n)
tally = pa.paillier_add(tally, c1_c, n)
tally = pa.paillier_add(tally, c1_d, n)
tally = pa.paillier_add(tally, c1_e, n)
tally = pa.paillier_add(tally, c0_a, n)
tally = pa.paillier_add(tally, c0_b, n)
tally = pa.paillier_add(tally, c0_c, n)
check(pa.paillier_decrypt(tally, n, lam, mu) == 5, "vote tally: 5 yes + 3 no = 5")

// TEST 5: Semantics - same message, different r -> different ciphertexts (semantic security)
let ca = pa.paillier_encrypt(42, n, g, 5)
let cb = pa.paillier_encrypt(42, n, g, 7)
check(ca != cb, "same msg different r -> different ciphertexts")
check(pa.paillier_decrypt(ca, n, lam, mu) == 42, "both decrypt to 42 (a)")
check(pa.paillier_decrypt(cb, n, lam, mu) == 42, "both decrypt to 42 (b)")

// TEST 6: DECISIVE - BIG cross-check: for many messages, HE addition is correct
// Use r values from a list known coprime to n=391 (not multiples of 17 or 23)
let safe_rs = [2, 3, 4, 5, 6, 7, 8, 9, 10, 12, 14, 15, 16, 18, 19, 20, 21, 24]
let ok = true
let m1 = 1
while m1 <= 12
    let m2 = 1
    while m2 <= 12
        let r1_idx = (m1 + m2 * 3) % len(safe_rs)
        let r2_idx = (m1 * 5 + m2) % len(safe_rs)
        let r1 = safe_rs[r1_idx]
        let r2 = safe_rs[r2_idx]
        let enc1 = pa.paillier_encrypt(m1, n, g, r1)
        let enc2 = pa.paillier_encrypt(m2, n, g, r2)
        let enc_sum = pa.paillier_add(enc1, enc2, n)
        let dec = pa.paillier_decrypt(enc_sum, n, lam, mu)
        let expected = (m1 + m2) % n
        if dec != expected
            ok = false
            print("HE add FAIL: m1=" + str(m1) + " m2=" + str(m2) + " got=" + str(dec))
        m2 = m2 + 1
    m1 = m1 + 1
check(ok, "HE addition correct for all m1,m2 in 1..12")

// TEST 7: Second keypair with different primes
let kp2 = pa.paillier_keygen(11, 19)
let n2 = kp2[0]
let g2 = kp2[1]
let lam2 = kp2[2]
let mu2 = kp2[3]
let c_p = pa.paillier_encrypt(50, n2, g2, 3)
check(pa.paillier_decrypt(c_p, n2, lam2, mu2) == 50, "second keypair decrypt 50")

print("forge_paillier: KAT done")
