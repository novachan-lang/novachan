// Typed DB extraction by COMPOSITION: pool_query_dicts returns {col:string} row dicts, and form_as<T>
// binds each into a VALIDATED struct -- zero annotation, name-keyed, sound. This IS query_as<T> built
// from shipped primitives (no dedicated compiler rewrite). Proves the float keystone end-to-end through
// the DB path: a REAL/float column extracted via form_as and summed with float arithmetic.
import forge
import forge_db

type Product
    id: int
    name: string
    price: float
    active: bool

fn main()
    let pool = forge_db.pool_open("_tq.db", 2)
    forge_db.pool_exec(pool, "DROP TABLE IF EXISTS products")
    forge_db.pool_exec(pool, "CREATE TABLE products (id INTEGER, name TEXT, price REAL, active INTEGER)")
    forge_db.pool_exec(pool, "INSERT INTO products VALUES (1, 'widget', 9.99, 1)")
    forge_db.pool_exec(pool, "INSERT INTO products VALUES (2, 'gadget', 19.5, 0)")

    let rows = forge_db.pool_query_dicts(pool, "SELECT id, name, price, active FROM products ORDER BY id", [], ["id", "name", "price", "active"])
    let total = 0.0
    let count = 0
    let actives = 0
    for row in rows
        let r: Result<Product> = form_as(row)
        match r
            Ok(p) =>
                assert(p.id > 0, "id coerced")
                total = total + p.price
                count = count + 1
                if p.active
                    actives = actives + 1
                print("row: " + p.name + " price=" + str(p.price) + " active=" + str(p.active))
            Err(e) =>
                assert(false, "decode err: " + e)

    assert(count == 2, "two rows decoded")
    assert(total > 29.48 and total < 29.50, "float column summed across DB rows = 29.49 (got " + str(total) + ")")
    assert(actives == 1, "bool column coerced (one active product)")
    forge_db.pool_close(pool, 2)
    print("forge_typed_query_test passed")
