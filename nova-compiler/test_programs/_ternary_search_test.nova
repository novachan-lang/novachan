import std/search/ternary_search

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL ternary_search " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ts_max_index — index of the max in a strictly unimodal array

    // [1,3,5,4,2] — max at index 2 (value 5)
    let a1 = [1, 3, 5, 4, 2]
    cki("max_index([1,3,5,4,2])", ts_max_index(a1), 2)

    // [1,2,3] — strictly increasing, max at last index
    let a2 = [1, 2, 3]
    cki("max_index([1,2,3])", ts_max_index(a2), 2)

    // [3,2,1] — strictly decreasing, max at first index
    let a3 = [3, 2, 1]
    cki("max_index([3,2,1])", ts_max_index(a3), 0)

    // [5] — single element
    let a4 = [5]
    cki("max_index([5])", ts_max_index(a4), 0)

    // [1,5,2] — max in the middle
    let a5 = [1, 5, 2]
    cki("max_index([1,5,2])", ts_max_index(a5), 1)

    // [1,2,10,3,1] — max at index 2
    let a6 = [1, 2, 10, 3, 1]
    cki("max_index([1,2,10,3,1])", ts_max_index(a6), 2)

    // ts_max_value — the maximum value itself

    // [1,3,5,4,2] — max value 5
    cki("max_value([1,3,5,4,2])", ts_max_value(a1), 5)

    // [1,2,3] — max value 3
    cki("max_value([1,2,3])", ts_max_value(a2), 3)

    // [3,2,1] — max value 3
    cki("max_value([3,2,1])", ts_max_value(a3), 3)

    // [5] — max value 5
    cki("max_value([5])", ts_max_value(a4), 5)

    // [1,5,2] — max value 5
    cki("max_value([1,5,2])", ts_max_value(a5), 5)

    // Large array with peak near center
    let a7 = [1, 3, 6, 10, 15, 12, 8, 4, 2]
    cki("max_index(large)", ts_max_index(a7), 4)
    cki("max_value(large)", ts_max_value(a7), 15)

    // Two-element cases
    let a8 = [1, 2]
    cki("max_index([1,2])", ts_max_index(a8), 1)
    let a9 = [2, 1]
    cki("max_index([2,1])", ts_max_index(a9), 0)

    print("PASS _ternary_search_test")
