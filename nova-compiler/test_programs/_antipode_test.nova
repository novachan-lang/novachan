// _antipode_test.nova — KAT for std/geo/antipode
import std/geo/antipode

fn approx(a: float, b: float, tol: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < tol

fn main()
    // antipode(0,0) -> [0, 180] (or [0,-180])
    let a1 = antipode(0.0, 0.0)
    let a1_lat = a1[0] * 1.0
    let a1_lon = a1[1] * 1.0
    if not approx(a1_lat, 0.0, 0.001)
        print("FAIL antipode(0,0) lat: got " + str(a1_lat))
        exit(1)
    // lon should be 180 or -180 (both are same point)
    let lon_ok = 0
    if approx(a1_lon, 180.0, 0.001)
        lon_ok = 1
    if approx(a1_lon, 0.0 - 180.0, 0.001)
        lon_ok = 1
    if lon_ok == 0
        print("FAIL antipode(0,0) lon: got " + str(a1_lon))
        exit(1)

    // antipode(45,90) -> [-45,-90]
    let a2 = antipode(45.0, 90.0)
    let a2_lat = a2[0] * 1.0
    let a2_lon = a2[1] * 1.0
    if not approx(a2_lat, 0.0 - 45.0, 0.001)
        print("FAIL antipode(45,90) lat: got " + str(a2_lat))
        exit(1)
    if not approx(a2_lon, 0.0 - 90.0, 0.001)
        print("FAIL antipode(45,90) lon: got " + str(a2_lon))
        exit(1)

    // antipode(-30,0) -> [30, 180]
    let a3 = antipode(0.0 - 30.0, 0.0)
    let a3_lat = a3[0] * 1.0
    let a3_lon = a3[1] * 1.0
    if not approx(a3_lat, 30.0, 0.001)
        print("FAIL antipode(-30,0) lat: got " + str(a3_lat))
        exit(1)
    if not approx(a3_lon, 180.0, 0.001)
        print("FAIL antipode(-30,0) lon: got " + str(a3_lon))
        exit(1)

    // antipode(0,90) -> [0, -90]
    let a4 = antipode(0.0, 90.0)
    let a4_lat = a4[0] * 1.0
    let a4_lon = a4[1] * 1.0
    if not approx(a4_lat, 0.0, 0.001)
        print("FAIL antipode(0,90) lat: got " + str(a4_lat))
        exit(1)
    if not approx(a4_lon, 0.0 - 90.0, 0.001)
        print("FAIL antipode(0,90) lon: got " + str(a4_lon))
        exit(1)

    // antipode(0,-170) -> [0, 10]  (lon = -170+180 = 10)
    let a5 = antipode(0.0, 0.0 - 170.0)
    let a5_lat = a5[0] * 1.0
    let a5_lon = a5[1] * 1.0
    if not approx(a5_lat, 0.0, 0.001)
        print("FAIL antipode(0,-170) lat: got " + str(a5_lat))
        exit(1)
    if not approx(a5_lon, 10.0, 0.001)
        print("FAIL antipode(0,-170) lon: got " + str(a5_lon))
        exit(1)

    print("PASS _antipode_test")
