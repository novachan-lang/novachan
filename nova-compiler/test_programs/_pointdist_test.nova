// _pointdist_test.nova — KAT for std/geometry/pointdist.nova
// All expected values are hand-computed; integer checks use cki, float checks use ckf.

import std/geometry/pointdist

// ── KAT 1: pd_euclidean_sq(0,0,3,4) == 25  (3²+4²=9+16=25)
let esq = pd_euclidean_sq(0, 0, 3, 4)
if esq != 25
    print("FAIL pd_euclidean_sq(0,0,3,4) expected 25 got " + str(esq))
    exit(1)

// ── KAT 2: pd_euclidean(0,0,3,4) == 5.0  (sqrt(25)=5)
let ed = pd_euclidean(0, 0, 3, 4)
let ed_diff = ed - 5.0
let ed_ok = false
if ed_diff < 0.001
    if ed_diff > -0.001
        ed_ok = true
if ed_ok == false
    print("FAIL pd_euclidean(0,0,3,4) expected 5.0 got " + str(ed))
    exit(1)

// ── KAT 3: pd_manhattan(0,0,3,4) == 7  (|3|+|4|=7)
let man1 = pd_manhattan(0, 0, 3, 4)
if man1 != 7
    print("FAIL pd_manhattan(0,0,3,4) expected 7 got " + str(man1))
    exit(1)

// ── KAT 4: pd_chebyshev(0,0,3,4) == 4  (max(3,4)=4)
let ch1 = pd_chebyshev(0, 0, 3, 4)
if ch1 != 4
    print("FAIL pd_chebyshev(0,0,3,4) expected 4 got " + str(ch1))
    exit(1)

// ── KAT 5: pd_manhattan(1,1,4,5) == 7  (|3|+|4|=7)
let man2 = pd_manhattan(1, 1, 4, 5)
if man2 != 7
    print("FAIL pd_manhattan(1,1,4,5) expected 7 got " + str(man2))
    exit(1)

// ── KAT 6: pd_point_to_segment(0,2, 0,0,4,0) == 2.0
// Segment is x-axis from (0,0) to (4,0). Point (0,2) projects to (0,0) — endpoint.
// Distance = 2.0.
let pts1 = pd_point_to_segment(0, 2, 0, 0, 4, 0)
let pts1_diff = pts1 - 2.0
let pts1_ok = false
if pts1_diff < 0.001
    if pts1_diff > -0.001
        pts1_ok = true
if pts1_ok == false
    print("FAIL pd_point_to_segment(0,2,0,0,4,0) expected 2.0 got " + str(pts1))
    exit(1)

// ── KAT 7: pd_point_to_segment(2,3, 0,0,4,0) == 3.0
// Segment x-axis (0,0)-(4,0). Point (2,3) projects to (2,0) — inside segment.
// Distance = 3.0.
let pts2 = pd_point_to_segment(2, 3, 0, 0, 4, 0)
let pts2_diff = pts2 - 3.0
let pts2_ok = false
if pts2_diff < 0.001
    if pts2_diff > -0.001
        pts2_ok = true
if pts2_ok == false
    print("FAIL pd_point_to_segment(2,3,0,0,4,0) expected 3.0 got " + str(pts2))
    exit(1)

// ── KAT 8: pd_point_to_segment(5,0, 0,0,4,0) == 1.0
// Segment x-axis (0,0)-(4,0). Point (5,0) is past the end; closest = (4,0).
// Distance = 1.0.
let pts3 = pd_point_to_segment(5, 0, 0, 0, 4, 0)
let pts3_diff = pts3 - 1.0
let pts3_ok = false
if pts3_diff < 0.001
    if pts3_diff > -0.001
        pts3_ok = true
if pts3_ok == false
    print("FAIL pd_point_to_segment(5,0,0,0,4,0) expected 1.0 got " + str(pts3))
    exit(1)

print("_pointdist_test passed")
