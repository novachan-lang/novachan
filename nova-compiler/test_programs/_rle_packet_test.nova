// KAT test for std/compress/rle_packet
// Tests: rle_packet_compress, rle_packet_decompress — PackBits-style RLE on byte-lists.
// PRIMARY gate: round-trip decompress(compress(x)) == x
// SECONDARY gate: a run of 100 identical bytes compresses to 2 bytes.
import std/compress/rle_packet

// ── Helpers ───────────────────────────────────────────────────────────────────

fn _lists_eq(a, b) -> int
    let na = len(a)
    let nb = len(b)
    if na != nb
        return 0
    let i = 0
    while i < na
        if a[i] != b[i]
            return 0
        i = i + 1
    1

fn list_to_str(xs) -> string
    let s = "["
    let n = len(xs)
    let i = 0
    while i < n
        if i > 0
            s = s + ","
        s = s + str(xs[i])
        i = i + 1
    s + "]"

fn check_lists(label, got, want)
    if _lists_eq(got, want) == 0
        print("FAIL " + label + ": got=" + list_to_str(got) + " want=" + list_to_str(want))
        exit(1)

fn check_int(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ── Build a byte-list from a string ──────────────────────────────────────────

fn str_to_bytes(s) -> list
    let out = []
    let n = len(s)
    let i = 0
    while i < n
        out.push(ord(s[i]))
        i = i + 1
    out

fn bytes_to_str(bs) -> string
    let out = ""
    let n = len(bs)
    let i = 0
    while i < n
        out = out + chr(bs[i])
        i = i + 1
    out

// ── KAT 1: empty input ───────────────────────────────────────────────────────

let rt1 = rle_packet_decompress(rle_packet_compress([]))
check_lists("empty_roundtrip", rt1, [])

// ── KAT 2: single byte ────────────────────────────────────────────────────────

let rt2 = rle_packet_decompress(rle_packet_compress([42]))
check_lists("single_byte", rt2, [42])

// ── KAT 3: run of 100 identical bytes ─────────────────────────────────────────

let run100 = []
let i3 = 0
while i3 < 100
    run100.push(0xAA)
    i3 = i3 + 1

let comp3 = rle_packet_compress(run100)
// A PackBits run packet for 100 bytes = 2 bytes total: [ctrl, val]
check_int("run100_compressed_len", len(comp3), 2)
// ctrl = 257 - 100 = 157
check_int("run100_ctrl_byte", comp3[0], 157)
check_int("run100_val_byte", comp3[1], 0xAA)

// Round-trip the run
let rt3 = rle_packet_decompress(comp3)
check_lists("run100_roundtrip", rt3, run100)

// ── KAT 4: all-different literals "ABCDE" ────────────────────────────────────

let in4 = str_to_bytes("ABCDE")
let rt4 = rle_packet_decompress(rle_packet_compress(in4))
check_lists("literal_ABCDE", rt4, in4)

// ── KAT 5: TOBEORNOTTOBEORTOBEORNOT ─────────────────────────────────────────

let in5 = str_to_bytes("TOBEORNOTTOBEORTOBEORNOT")
let rt5 = rle_packet_decompress(rle_packet_compress(in5))
check_lists("tobeornot_roundtrip", rt5, in5)

// ── KAT 6: repetitive "aaaa" (4 identical) ───────────────────────────────────

let in6 = str_to_bytes("aaaa")
let comp6 = rle_packet_compress(in6)
// Should be a single run packet: [257-4, ord('a')] = [253, 97]
check_int("aaaa_compressed_len", len(comp6), 2)
let rt6 = rle_packet_decompress(comp6)
check_lists("aaaa_roundtrip", rt6, in6)

// ── KAT 7: mixed literal + run ────────────────────────────────────────────────
// "ABCaaaaDEF" — literals A,B,C then run of 4 'a' then literals D,E,F

let in7 = str_to_bytes("ABCaaaaDEF")
let rt7 = rle_packet_decompress(rle_packet_compress(in7))
check_lists("mixed_literal_run", rt7, in7)

// ── KAT 8: mixed bytes (non-ASCII values) ────────────────────────────────────

let in8 = [0, 255, 128, 64, 192, 0, 0, 0, 255, 255]
let rt8 = rle_packet_decompress(rle_packet_compress(in8))
check_lists("mixed_bytes", rt8, in8)

// ── KAT 9: run of 128 bytes (max single run packet) ──────────────────────────

let run128 = []
let i9 = 0
while i9 < 128
    run128.push(7)
    i9 = i9 + 1

let comp9 = rle_packet_compress(run128)
// 128-byte run: ctrl = 257 - 128 = 129, so 2-byte packet
check_int("run128_compressed_len", len(comp9), 2)
check_int("run128_ctrl", comp9[0], 129)
let rt9 = rle_packet_decompress(comp9)
check_lists("run128_roundtrip", rt9, run128)

// ── KAT 10: longer run requiring split into two packets ───────────────────────

let run200 = []
let i10 = 0
while i10 < 200
    run200.push(99)
    i10 = i10 + 1

let rt10 = rle_packet_decompress(rle_packet_compress(run200))
check_lists("run200_roundtrip", rt10, run200)

// ── KAT 11: all-zero bytes ────────────────────────────────────────────────────

let in11 = [0, 0, 0, 0, 0]
let rt11 = rle_packet_decompress(rle_packet_compress(in11))
check_lists("all_zeros", rt11, in11)

// ── KAT 12: alternating bytes (no runs) ──────────────────────────────────────

let in12 = [1, 2, 1, 2, 1, 2, 1, 2]
let rt12 = rle_packet_decompress(rle_packet_compress(in12))
check_lists("alternating", rt12, in12)

print("PASS _rle_packet_test")
