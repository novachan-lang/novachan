import std/data/schema

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn main()
    // Build reference schema: name->string, age->int
    let schema = {}
    schema["name"] = "string"
    schema["age"] = "int"

    // KAT 1: valid value passes
    let v1 = {}
    v1["name"] = "bob"
    v1["age"] = 30
    cki("sc_validate valid", sc_validate(v1, schema), 1)

    // KAT 2: missing field 'age' -> fail
    let v2 = {}
    v2["name"] = "bob"
    cki("sc_validate missing_age", sc_validate(v2, schema), 0)

    // KAT 3: age is string not int -> fail
    let v3 = {}
    v3["name"] = "bob"
    v3["age"] = "x"
    cki("sc_validate wrong_type", sc_validate(v3, schema), 0)

    // KAT 4: extra key allowed -> still passes
    let v4 = {}
    v4["name"] = "alice"
    v4["age"] = 25
    v4["email"] = "alice@example.com"
    cki("sc_validate extra_key", sc_validate(v4, schema), 1)

    // KAT 5: sc_type_ok basic cases using types supported by type_of()
    // Note: NOVA's type_of returns "int" for ints, bools, and unboxed floats;
    // "string" for strings; "list" for lists; "dict" for dicts.
    cki("sc_type_ok int true",     sc_type_ok(5, "int"), 1)
    cki("sc_type_ok int false",    sc_type_ok("x", "int"), 0)
    cki("sc_type_ok list true",    sc_type_ok([1], "list"), 1)
    cki("sc_type_ok list false",   sc_type_ok(5, "list"), 0)
    cki("sc_type_ok string true",  sc_type_ok("hello", "string"), 1)
    cki("sc_type_ok string false", sc_type_ok(42, "string"), 0)
    cki("sc_type_ok dict true",    sc_type_ok({}, "dict"), 1)
    cki("sc_type_ok dict false",   sc_type_ok("x", "dict"), 0)
    // "str" alias for "string"
    cki("sc_type_ok str alias",    sc_type_ok("hello", "str"), 1)

    // KAT 6: sc_errors on missing field -> at least 1 error
    let errs_missing = sc_errors(v2, schema)
    if len(errs_missing) < 1
        print("FAIL sc_errors missing: expected >=1 error, got 0")
        exit(1)

    // KAT 7: sc_errors on type mismatch -> at least 1 error
    let errs_type = sc_errors(v3, schema)
    if len(errs_type) < 1
        print("FAIL sc_errors type_mismatch: expected >=1 error, got 0")
        exit(1)

    // KAT 8: sc_errors on valid value -> empty list
    let errs_ok = sc_errors(v1, schema)
    cki("sc_errors valid empty", len(errs_ok), 0)

    // KAT 9: value not a dict -> sc_validate returns 0
    cki("sc_validate non_dict", sc_validate("not_a_dict", schema), 0)

    // KAT 10: value not a dict -> sc_errors returns at least 1 error
    let errs_nd = sc_errors(42, schema)
    if len(errs_nd) < 1
        print("FAIL sc_errors non_dict: expected >=1 error, got 0")
        exit(1)

    // KAT 11: empty schema -> any dict validates
    let empty_schema = {}
    cki("sc_validate empty_schema", sc_validate(v1, empty_schema), 1)

    // KAT 12: sc_validate with list-typed field
    let s2 = {}
    s2["tags"] = "list"
    let val_list = {}
    val_list["tags"] = [1, 2, 3]
    cki("sc_validate list_field", sc_validate(val_list, s2), 1)
    let val_bad = {}
    val_bad["tags"] = "not_a_list"
    cki("sc_validate list_field_wrong", sc_validate(val_bad, s2), 0)

    print("_schema_test passed")

main()
