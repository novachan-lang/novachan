// _pearson_test.nova — KAT test for std/hash/pearson
//
// All expected values were computed by hand and cross-checked with
// the PowerShell reference implementation in the development session.
//
// HAND-TRACE h_pearson("a"):
//   T[i] = (i*167 + 13) & 0xFF
//   h  = len("a") & 0xFF = 1
//   b  = ord('a') = 97  (ASCII lowercase a = 97, not 65 which is uppercase A)
//   idx = (1 XOR 97) & 0xFF = 96
//   T[96] = (96*167 + 13) & 0xFF = (16032+13) & 0xFF = 16045 & 0xFF = 173
//   => h_pearson("a") = 173
//
// HAND-TRACE h_pearson("b"):
//   h = 1, b = ord('b') = 98
//   idx = (1 XOR 98) & 0xFF = 99
//   T[99] = (99*167 + 13) & 0xFF = (16533+13) & 0xFF = 16546 & 0xFF = 162
//   => h_pearson("b") = 162
//
// PERMUTATION ASSERTION:
//   T[i] = (i*167+13)&0xFF.  Because gcd(167,256)=1 the map i -> i*167 mod 256
//   is a bijection on Z/256Z.  We assert this empirically: build T, sort, and
//   verify T[255]-T[0] == 255 and all steps are +1 after sort, i.e. the sorted
//   list is exactly 0..255.

import std/hash/pearson

// Helper: check int equality
fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// Helper: check that a value is in 0..255
fn ck_byte(label, v)
    if v < 0
        print("FAIL " + label + ": value " + str(v) + " < 0")
        exit(1)
    if v > 255
        print("FAIL " + label + ": value " + str(v) + " > 255")
        exit(1)

// ---------------------------------------------------------------------------
// KAT 1: empty string -> 0
// h = len("") & 0xFF = 0; no bytes processed; return 0.
// ---------------------------------------------------------------------------
cki("empty", h_pearson(""), 0)

// ---------------------------------------------------------------------------
// KAT 2: "a" -> 173  (hand-traced above)
// ---------------------------------------------------------------------------
cki("a", h_pearson("a"), 173)

// ---------------------------------------------------------------------------
// KAT 3: "b" -> 162  (hand-traced above)
// ---------------------------------------------------------------------------
cki("b", h_pearson("b"), 162)

// ---------------------------------------------------------------------------
// KAT 4: "a" and "b" produce DIFFERENT hashes (sensitivity)
// ---------------------------------------------------------------------------
if h_pearson("a") == h_pearson("b")
    print("FAIL sensitivity: h_pearson(a) == h_pearson(b) unexpectedly")
    exit(1)

// ---------------------------------------------------------------------------
// KAT 5: "hello" -> 70
// ---------------------------------------------------------------------------
cki("hello", h_pearson("hello"), 70)

// ---------------------------------------------------------------------------
// KAT 6: "world" -> 114
// ---------------------------------------------------------------------------
cki("world", h_pearson("world"), 114)

// ---------------------------------------------------------------------------
// KAT 7: "abc" -> 166
// ---------------------------------------------------------------------------
cki("abc", h_pearson("abc"), 166)

// ---------------------------------------------------------------------------
// KAT 8: all outputs must be in 0..255
// ---------------------------------------------------------------------------
ck_byte("range_empty",  h_pearson(""))
ck_byte("range_a",      h_pearson("a"))
ck_byte("range_hello",  h_pearson("hello"))
ck_byte("range_world",  h_pearson("world"))

// ---------------------------------------------------------------------------
// KAT 9: DETERMINISM — calling h_pearson twice on the same string returns
// the same value each time (no hidden mutable state).
// ---------------------------------------------------------------------------
cki("determinism_hello_1", h_pearson("hello"), 70)
cki("determinism_hello_2", h_pearson("hello"), 70)

// ---------------------------------------------------------------------------
// KAT 10: wide hash — h_pearson_wide("", 2) = 256
// pass 0: init=0, no bytes -> h=0
// pass 1: init=1, no bytes -> h=1
// result = 0 | (1 << 8) = 256
// ---------------------------------------------------------------------------
cki("wide_empty_2", h_pearson_wide("", 2), 256)

// ---------------------------------------------------------------------------
// KAT 11: wide hash — h_pearson_wide("hello", 2) = 10915
// pass 0 (init=0): result byte = 163
// pass 1 (init=1): result byte = 42
// result = 163 | (42 << 8) = 163 | 10752 = 10915
// ---------------------------------------------------------------------------
cki("wide_hello_2", h_pearson_wide("hello", 2), 10915)

// ---------------------------------------------------------------------------
// KAT 12: PERMUTATION ASSERTION
// Build T[i]=(i*167+13)&0xFF for i=0..255, collect into a list, sort it.
// The sorted result must be exactly 0,1,2,...,255.
// ---------------------------------------------------------------------------
let perm_t = []
let pi = 0
while pi < 256
    push(perm_t, (pi * 167 + 13) & 0xFF)
    pi = pi + 1

let sorted_t = sort(perm_t)

// Check first=0, last=255, and all 256 entries strictly increment by 1
if sorted_t[0] != 0
    print("FAIL permutation: first sorted value is " + str(sorted_t[0]) + " not 0")
    exit(1)
if sorted_t[255] != 255
    print("FAIL permutation: last sorted value is " + str(sorted_t[255]) + " not 255")
    exit(1)

let pj = 1
while pj < 256
    if sorted_t[pj] != sorted_t[pj - 1] + 1
        print("FAIL permutation: gap at index " + str(pj))
        exit(1)
    pj = pj + 1

print("_pearson_test passed")
