// Exercises every headered runtime string producer, placing each result into an
// `any` context (a list -> str) which forces the int/string discrimination. If any
// runtime string lacked identity it would misrender as an integer. Completeness
// oracle for the int/string soundness fix.

fn check(label, s)
    let box = [s]
    print(label + ": " + str(box))

fn main()
    // generic string ops
    check("concat", "ab" + "cd")
    check("repeat", "xy" * 3)
    check("upper", upper("hello"))
    check("lower", lower("WORLD"))
    check("trim", trim("  hi  "))
    check("replace", replace("a.b.c", ".", "-"))
    check("str_int", str(12345))
    check("str_list", str([1, 2, 3]))

    let parts = split("p,q,r", ",")
    print("split: " + str(parts))
    check("join", join(parts, "+"))

    // converted: crypto / hashing / encoding (were raw malloc, now headered)
    check("sha256", sha256("nova"))
    check("hmac", hmac_sha256("key", "msg"))
    check("hex_encode", hex_encode("hi"))
    check("hex_rt", hex_decode(hex_encode("abc")))
    check("b64_encode", base64_encode("hello"))
    check("b64_rt", base64_decode(base64_encode("world")))
    let u = uuid4()
    print("uuid len: " + str(len(u)))

    // mixed int/string list: each element must render in its own type
    let mixed = [1, "two", 3, "four", 5]
    print("mixed: " + str(mixed))

    // dict with string values flowing through `any`
    let d = {"k1": "v1", "k2": sha256("x")}
    print("dict ok: " + str(len(d)))

    print("str_identity_test passed")
