import std/raster/flood_fill

fn _ck_i(label: string, got: int, want: int)
    if got != want
        print("FAIL flood_fill " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn _ck_b(label: string, got: bool, want: bool)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL flood_fill " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn main()
    // --- KAT 1: ff_new creates correct dimensions and fill ---
    let s1 = ff_new(3, 2, 7)
    _ck_i("new_w", s1["w"], 3)
    _ck_i("new_h", s1["h"], 2)
    _ck_i("new_px0", ff_get(s1, 0, 0), 7)
    _ck_i("new_px5", ff_get(s1, 2, 1), 7)
    // out-of-bounds get returns 0
    _ck_i("oob_get", ff_get(s1, 5, 5), 0)

    // --- KAT 2: ff_set/ff_get round-trip ---
    let s2 = ff_new(4, 4, 0)
    ff_set(s2, 2, 3, 42)
    _ck_i("set_get", ff_get(s2, 2, 3), 42)
    // other pixels untouched
    _ck_i("set_other", ff_get(s2, 1, 1), 0)

    // --- KAT 3: ff_fill4 fills interior bounded by border of 1s ---
    // Build 4x4 surface: border=1, interior=0
    let s3 = ff_new(4, 4, 0)
    // top row
    ff_set(s3, 0, 0, 1)
    ff_set(s3, 1, 0, 1)
    ff_set(s3, 2, 0, 1)
    ff_set(s3, 3, 0, 1)
    // bottom row
    ff_set(s3, 0, 3, 1)
    ff_set(s3, 1, 3, 1)
    ff_set(s3, 2, 3, 1)
    ff_set(s3, 3, 3, 1)
    // left col
    ff_set(s3, 0, 1, 1)
    ff_set(s3, 0, 2, 1)
    // right col
    ff_set(s3, 3, 1, 1)
    ff_set(s3, 3, 2, 1)
    // interior is 4 pixels: (1,1),(2,1),(1,2),(2,2)
    ff_fill4(s3, 1, 1, 5)
    // filled interior
    _ck_i("fill4_interior_11", ff_get(s3, 1, 1), 5)
    _ck_i("fill4_interior_21", ff_get(s3, 2, 1), 5)
    _ck_i("fill4_interior_12", ff_get(s3, 1, 2), 5)
    _ck_i("fill4_interior_22", ff_get(s3, 2, 2), 5)
    // border NOT changed
    _ck_i("fill4_border_00", ff_get(s3, 0, 0), 1)
    _ck_i("fill4_border_33", ff_get(s3, 3, 3), 1)

    // --- KAT 4: ff_count_region on all-0 surface = entire surface ---
    let s4 = ff_new(4, 4, 0)
    let cnt_all = ff_count_region(s4, 0, 0)
    _ck_i("count_all_16", cnt_all, 16)

    // --- KAT 5: ff_count_region split by a vertical line ---
    // 4x4 surface; column x=2 is all 1s, left side (0-1) is 0, right (3) is 0
    let s5 = ff_new(4, 4, 0)
    ff_set(s5, 2, 0, 1)
    ff_set(s5, 2, 1, 1)
    ff_set(s5, 2, 2, 1)
    ff_set(s5, 2, 3, 1)
    // left region from (0,0): x in {0,1} = 8 pixels
    let cnt_left = ff_count_region(s5, 0, 0)
    _ck_i("count_left_8", cnt_left, 8)
    // right region from (3,0): x=3 = 4 pixels
    let cnt_right = ff_count_region(s5, 3, 0)
    _ck_i("count_right_4", cnt_right, 4)

    // --- KAT 6: ff_fill4 on a single 0 surrounded by 1s fills exactly 1 pixel ---
    let s6 = ff_new(3, 3, 1)
    ff_set(s6, 1, 1, 0)
    ff_fill4(s6, 1, 1, 9)
    _ck_i("single_fill_center", ff_get(s6, 1, 1), 9)
    // neighbours unchanged (still 1)
    _ck_i("single_fill_up", ff_get(s6, 1, 0), 1)
    _ck_i("single_fill_down", ff_get(s6, 1, 2), 1)
    _ck_i("single_fill_left", ff_get(s6, 0, 1), 1)
    _ck_i("single_fill_right", ff_get(s6, 2, 1), 1)
    // count was 1
    let s6b = ff_new(3, 3, 1)
    ff_set(s6b, 1, 1, 0)
    let cnt6 = ff_count_region(s6b, 1, 1)
    _ck_i("count_single", cnt6, 1)

    // --- KAT 7: ff_fill8 — diagonal 0 region (4 diagonal pixels all connected via 8-conn) ---
    let s7 = ff_new(4, 4, 1)
    ff_set(s7, 0, 0, 0)
    ff_set(s7, 1, 1, 0)
    ff_set(s7, 2, 2, 0)
    ff_set(s7, 3, 3, 0)
    ff_fill8(s7, 0, 0, 7)
    _ck_i("fill8_diag_00", ff_get(s7, 0, 0), 7)
    _ck_i("fill8_diag_11", ff_get(s7, 1, 1), 7)
    _ck_i("fill8_diag_22", ff_get(s7, 2, 2), 7)
    _ck_i("fill8_diag_33", ff_get(s7, 3, 3), 7)
    // non-diagonal still 1
    _ck_i("fill8_other", ff_get(s7, 0, 1), 1)

    // --- KAT 8: ff_boundary_fill — fill region stopping at boundary value ---
    let s8 = ff_new(5, 5, 0)
    // draw a border of 2s
    ff_set(s8, 0, 0, 2)
    ff_set(s8, 1, 0, 2)
    ff_set(s8, 2, 0, 2)
    ff_set(s8, 3, 0, 2)
    ff_set(s8, 4, 0, 2)
    ff_set(s8, 0, 4, 2)
    ff_set(s8, 1, 4, 2)
    ff_set(s8, 2, 4, 2)
    ff_set(s8, 3, 4, 2)
    ff_set(s8, 4, 4, 2)
    ff_set(s8, 0, 1, 2)
    ff_set(s8, 0, 2, 2)
    ff_set(s8, 0, 3, 2)
    ff_set(s8, 4, 1, 2)
    ff_set(s8, 4, 2, 2)
    ff_set(s8, 4, 3, 2)
    ff_boundary_fill(s8, 2, 2, 6, 2)
    _ck_i("bfill_interior", ff_get(s8, 2, 2), 6)
    _ck_i("bfill_border_stays", ff_get(s8, 0, 0), 2)

    // --- KAT 9: ff_flood_bounded returns count ---
    let s9 = ff_new(3, 3, 0)
    // 3x3 all-0 -> fill all 9
    let cnt9 = ff_flood_bounded(s9, 0, 0, 3)
    _ck_i("flood_bounded_9", cnt9, 9)
    // filling same value returns 0
    let s9b = ff_new(2, 2, 5)
    let cnt9b = ff_flood_bounded(s9b, 0, 0, 5)
    _ck_i("flood_bounded_same_val", cnt9b, 0)

    // --- KAT 10: out-of-bounds fill is a no-op ---
    let s10 = ff_new(2, 2, 0)
    ff_fill4(s10, 99, 99, 1)
    _ck_i("oob_fill_noop", ff_get(s10, 0, 0), 0)

    print("PASS _flood_fill_test")
