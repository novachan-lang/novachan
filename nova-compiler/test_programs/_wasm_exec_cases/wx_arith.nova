// Scalar arithmetic breadth: division, negatives, comparison chains, nested calls.
fn gcd(a: int, b: int) -> int
    let x = a
    let y = b
    while y != 0
        let t = y
        y = x % y
        x = t
    x
fn main() -> int
    let acc = 0
    let i = 1
    while i <= 200
        acc += gcd(i, 84) * (i % 7) - (i / 3)
        i += 1
    print(str(acc))
    acc
