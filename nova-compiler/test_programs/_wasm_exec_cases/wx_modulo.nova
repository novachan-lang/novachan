// The case that FOUND the bug: modulo on a runtime value. `i % 2` returned 0 on wasm because
// nova_rt_mod was an unresolved import filled with a zero-returning host stub.
fn odd_count(limit: int) -> int
    let n = 0
    let i = 0
    while i < limit
        if i % 2 == 1
            n += 1
        i += 1
    n
fn main() -> int
    let c = odd_count(1000)
    print(str(c))
    c
