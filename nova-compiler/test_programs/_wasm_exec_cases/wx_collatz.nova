// Mixed %, /, * and branching -- native 16 steps for 300, wasm gave 8 before the fix.
fn collatz_len(n: int) -> int
    let steps = 0
    let x = n
    while x != 1
        if x % 2 == 0
            x = x / 2
        else
            x = 3 * x + 1
        steps += 1
    steps
fn main() -> int
    let total = 0
    let i = 1
    while i <= 300
        total += collatz_len(i)
        i += 1
    print(str(total))
    total
