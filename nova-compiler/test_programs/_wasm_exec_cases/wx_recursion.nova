// Recursion, so the wasm stack-depth guard is exercised on a real workload rather than only by
// the dedicated overflow probe. Depth stays far under the 8000 limit.
fn fib(n: int) -> int
    if n < 2
        return n
    fib(n - 1) + fib(n - 2)
fn main() -> int
    let v = fib(22)
    print(str(v))
    v
