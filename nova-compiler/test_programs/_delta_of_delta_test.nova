// KAT for std/compress/delta_of_delta — double-delta encoding
import std/compress/delta_of_delta

// ── helpers ──────────────────────────────────────────────────────────────────

fn lists_eq(a, b) -> int
    let na = len(a)
    let nb = len(b)
    if na != nb
        return 0
    let i = 0
    let ok = 1
    while i < na
        if a[i] != b[i]
            ok = 0
        i = i + 1
    ok

fn ck_rt(label, xs)
    let enc = dod_encode(xs)
    let got = dod_decode(enc)
    if lists_eq(got, xs) == 0
        print("FAIL round-trip " + label)
        exit(1)

fn ck_enc(label, xs, want)
    let got = dod_encode(xs)
    if lists_eq(got, want) == 0
        print("FAIL encode " + label)
        exit(1)

fn ck_dec(label, enc, want)
    let got = dod_decode(enc)
    if lists_eq(got, want) == 0
        print("FAIL decode " + label)
        exit(1)

fn main()
    // ── KAT 1: empty ─────────────────────────────────────────────────────────
    ck_rt("empty", [])
    ck_enc("empty encode", [], [])
    ck_dec("empty decode", [], [])

    // ── KAT 2: singleton ─────────────────────────────────────────────────────
    ck_rt("singleton", [42])
    ck_enc("singleton encode", [42], [42])
    ck_dec("singleton decode", [42], [42])

    // ── KAT 3: two elements ──────────────────────────────────────────────────
    ck_rt("two elements", [10, 20])
    ck_enc("two elements encode", [10, 20], [10, 10])
    ck_dec("two elements decode", [10, 10], [10, 20])

    // ── KAT 4: constant-delta series [100,110,120,130] ────────────────────────
    // deltas = [10, 10, 10]; dod = [0, 0]
    // encoded: [100, 10, 0, 0]
    let ts = [100, 110, 120, 130]
    ck_enc("const delta encode", ts, [100, 10, 0, 0])
    ck_rt("const delta rt", ts)

    // The last two values (position 2+) must be 0 (constant delta property)
    let enc4 = dod_encode(ts)
    if enc4[2] != 0
        print("FAIL const delta: dod[2] should be 0, got " + str(enc4[2]))
        exit(1)
    if enc4[3] != 0
        print("FAIL const delta: dod[3] should be 0, got " + str(enc4[3]))
        exit(1)

    // ── KAT 5: longer constant-delta — all dod values zero ───────────────────
    let ts5 = [1000, 1010, 1020, 1030, 1040, 1050]
    let enc5 = dod_encode(ts5)
    // positions 2..5 must all be 0
    let i5 = 2
    while i5 < len(enc5)
        if enc5[i5] != 0
            print("FAIL long const delta: dod[" + str(i5) + "] = " + str(enc5[i5]) + " want 0")
            exit(1)
        i5 = i5 + 1
    ck_rt("long const delta", ts5)

    // ── KAT 6: irregular sequence ────────────────────────────────────────────
    let irreg = [5, 10, 22, 31, 55]
    ck_rt("irregular", irreg)

    // ── KAT 7: known vector — quadratic sequence 1,4,9,16 ────────────────────
    // deltas = [3,5,7]; dod = [2,2]
    // encoded: [1, 3, 2, 2]
    let quad = [1, 4, 9, 16]
    ck_enc("quadratic encode", quad, [1, 3, 2, 2])
    ck_rt("quadratic rt", quad)

    // ── KAT 8: negative values ───────────────────────────────────────────────
    let neg = [-10, -5, 0, 5, 10]
    ck_rt("negative values", neg)

    // ── KAT 9: descending sequence ───────────────────────────────────────────
    let desc = [100, 90, 80, 70]
    // deltas = [-10,-10,-10]; dod = [0,0]
    // encoded: [100, -10, 0, 0]
    ck_enc("descending encode", desc, [100, -10, 0, 0])
    ck_rt("descending", desc)

    // ── KAT 10: mixed positive/negative deltas ────────────────────────────────
    let mixed = [0, 10, 5, 15, 3]
    ck_rt("mixed deltas", mixed)

    // ── KAT 11: single-step varying deltas ───────────────────────────────────
    // second differences = 1 (accelerating by 1 each step)
    // [1,2,4,7,11] -> deltas=[1,2,3,4] -> dod=[1,1,1]
    // encoded: [1, 1, 1, 1, 1]
    let accel = [1, 2, 4, 7, 11]
    ck_enc("accel encode", accel, [1, 1, 1, 1, 1])
    ck_rt("accel rt", accel)

    // ── KAT 12: large values (timestamp-like) ────────────────────────────────
    let ts12 = [1700000000, 1700000010, 1700000020, 1700000030]
    ck_enc("timestamp encode", ts12, [1700000000, 10, 0, 0])
    ck_rt("timestamp rt", ts12)

    // ── KAT 13: decode of known vector ───────────────────────────────────────
    ck_dec("decode known", [100, 10, 0, 0], [100, 110, 120, 130])
    ck_dec("decode quadratic", [1, 3, 2, 2], [1, 4, 9, 16])

    print("PASS _delta_of_delta_test")
