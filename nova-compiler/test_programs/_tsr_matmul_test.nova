import std/tensor/tsr_matmul

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL " + label + " got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(label: str, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + " len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL " + label + "[" + str(i) + "] got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn ckt(label: str, t: list, want_flat: list, want_shape: list)
    let flat = t[0]
    let shape = t[1]
    if len(flat) != len(want_flat)
        print("FAIL " + label + " flat len got=" + str(len(flat)) + " want=" + str(len(want_flat)))
        exit(1)
    let i = 0
    while i < len(flat)
        if flat[i] != want_flat[i]
            print("FAIL " + label + " flat[" + str(i) + "] got=" + str(flat[i]) + " want=" + str(want_flat[i]))
            exit(1)
        i = i + 1
    if len(shape) != len(want_shape)
        print("FAIL " + label + " shape len got=" + str(len(shape)) + " want=" + str(len(want_shape)))
        exit(1)
    let j = 0
    while j < len(shape)
        if shape[j] != want_shape[j]
            print("FAIL " + label + " shape[" + str(j) + "] got=" + str(shape[j]) + " want=" + str(want_shape[j]))
            exit(1)
        j = j + 1

fn main()
    // Build [[1,2],[3,4]] = 2x2 tensor
    let f22a = []
    push(f22a, 1)
    push(f22a, 2)
    push(f22a, 3)
    push(f22a, 4)
    let s22 = []
    push(s22, 2)
    push(s22, 2)
    let t22a = []
    push(t22a, f22a)
    push(t22a, s22)

    // Build [[5,6],[7,8]] = 2x2 tensor
    let f22b = []
    push(f22b, 5)
    push(f22b, 6)
    push(f22b, 7)
    push(f22b, 8)
    let s22b = []
    push(s22b, 2)
    push(s22b, 2)
    let t22b = []
    push(t22b, f22b)
    push(t22b, s22b)

    // KAT: tm_matmul([[1,2,3,4],[2,2]], [[5,6,7,8],[2,2]]) -> [19,22,43,50],[2,2]
    let mm1 = tm_matmul(t22a, t22b)
    let wf1 = []
    push(wf1, 19)
    push(wf1, 22)
    push(wf1, 43)
    push(wf1, 50)
    let ws1 = []
    push(ws1, 2)
    push(ws1, 2)
    ckt("tm_matmul 2x2", mm1, wf1, ws1)

    // Build 1-D vector [5,6] shape=[2]
    let fv2 = []
    push(fv2, 5)
    push(fv2, 6)
    let sv2 = []
    push(sv2, 2)
    let tv2 = []
    push(tv2, fv2)
    push(tv2, sv2)

    // KAT: tm_matvec([[1,2,3,4],[2,2]], [[5,6],[2]]) -> [17,39],[2]
    let mv1 = tm_matvec(t22a, tv2)
    let wfmv = []
    push(wfmv, 17)
    push(wfmv, 39)
    let wsmv = []
    push(wsmv, 2)
    ckt("tm_matvec 2x2", mv1, wfmv, wsmv)

    // Build 1-D vector [1,2,3] shape=[3]
    let fu3 = []
    push(fu3, 1)
    push(fu3, 2)
    push(fu3, 3)
    let su3 = []
    push(su3, 3)
    let tu3 = []
    push(tu3, fu3)
    push(tu3, su3)

    // Build 1-D vector [4,5,6] shape=[3]
    let fv3 = []
    push(fv3, 4)
    push(fv3, 5)
    push(fv3, 6)
    let sv3 = []
    push(sv3, 3)
    let tv3 = []
    push(tv3, fv3)
    push(tv3, sv3)

    // KAT: tm_dot([[1,2,3],[3]], [[4,5,6],[3]])=32
    let dot1 = tm_dot(tu3, tv3)
    cki("tm_dot 1d", dot1, 32)

    // Build 1-D vector [1,2] shape=[2]
    let fu2 = []
    push(fu2, 1)
    push(fu2, 2)
    let su2 = []
    push(su2, 2)
    let tu2 = []
    push(tu2, fu2)
    push(tu2, su2)

    // Build 1-D vector [3,4] shape=[2]
    let fv2b = []
    push(fv2b, 3)
    push(fv2b, 4)
    let sv2b = []
    push(sv2b, 2)
    let tv2b = []
    push(tv2b, fv2b)
    push(tv2b, sv2b)

    // KAT: tm_outer([[1,2],[2]], [[3,4],[2]]) -> [3,4,6,8],[2,2]
    let ou1 = tm_outer(tu2, tv2b)
    let wfou = []
    push(wfou, 3)
    push(wfou, 4)
    push(wfou, 6)
    push(wfou, 8)
    let wsou = []
    push(wsou, 2)
    push(wsou, 2)
    ckt("tm_outer 2x2", ou1, wfou, wsou)

    // KAT: tm_trace([[1,2,3,4],[2,2]])=5
    let tr1 = tm_trace(t22a)
    cki("tm_trace 2x2", tr1, 5)

    // Build [[1,2,3],[4,5,6]] = 2x3 tensor
    let f23 = []
    push(f23, 1)
    push(f23, 2)
    push(f23, 3)
    push(f23, 4)
    push(f23, 5)
    push(f23, 6)
    let s23 = []
    push(s23, 2)
    push(s23, 3)
    let t23 = []
    push(t23, f23)
    push(t23, s23)

    // Build [[1,2],[3,4],[5,6]] = 3x2 tensor
    let f32 = []
    push(f32, 1)
    push(f32, 2)
    push(f32, 3)
    push(f32, 4)
    push(f32, 5)
    push(f32, 6)
    let s32 = []
    push(s32, 3)
    push(s32, 2)
    let t32 = []
    push(t32, f32)
    push(t32, s32)

    // KAT: tm_matmul([[1,2,3,4,5,6],[2,3]], [[1,2,3,4,5,6],[3,2]]) -> [22,28,49,64],[2,2]
    let mm2 = tm_matmul(t23, t32)
    let wf2 = []
    push(wf2, 22)
    push(wf2, 28)
    push(wf2, 49)
    push(wf2, 64)
    let ws2 = []
    push(ws2, 2)
    push(ws2, 2)
    ckt("tm_matmul 2x3 * 3x2", mm2, wf2, ws2)

    // Extra: dot product of zero vectors
    let fz = []
    push(fz, 0)
    push(fz, 0)
    let sz = []
    push(sz, 2)
    let tz = []
    push(tz, fz)
    push(tz, sz)
    cki("tm_dot zeros", tm_dot(tz, tz), 0)

    // Extra: trace of 3x3 identity (flat=[1,0,0,0,1,0,0,0,1] shape=[3,3])
    let fi3 = []
    push(fi3, 1)
    push(fi3, 0)
    push(fi3, 0)
    push(fi3, 0)
    push(fi3, 1)
    push(fi3, 0)
    push(fi3, 0)
    push(fi3, 0)
    push(fi3, 1)
    let si3 = []
    push(si3, 3)
    push(si3, 3)
    let ti3 = []
    push(ti3, fi3)
    push(ti3, si3)
    cki("tm_trace 3x3 identity", tm_trace(ti3), 3)

    print("PASS _tsr_matmul_test")
