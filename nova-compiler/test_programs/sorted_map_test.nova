// Sorted Map + Ring Buffer test

fn sorted_map_new() -> list
    let pairs = []
    [pairs]

fn _sm_bsearch(pairs, key) -> int
    let lo = 0
    let hi = len(pairs) - 1
    while lo <= hi
        let mid = (lo + hi) / 2
        let mk = pairs[mid][0]
        if mk == key
            return mid
        if mk < key
            lo = mid + 1
        else
            hi = mid - 1
    -(lo + 1)

fn sorted_map_set(sm, key, value)
    let pairs = sm[0]
    let idx = _sm_bsearch(pairs, key)
    if idx >= 0
        pairs[idx] = [key, value]
        return 0
    let insert_at = -(idx + 1)
    push(pairs, [key, value])
    let i = len(pairs) - 1
    while i > insert_at
        pairs[i] = pairs[i - 1]
        i = i - 1
    pairs[insert_at] = [key, value]
    0

fn sorted_map_get(sm, key)
    let pairs = sm[0]
    let idx = _sm_bsearch(pairs, key)
    if idx >= 0
        return pairs[idx][1]
    null

fn sorted_map_has(sm, key) -> bool
    let pairs = sm[0]
    _sm_bsearch(pairs, key) >= 0

fn sorted_map_remove(sm, key) -> bool
    let pairs = sm[0]
    let idx = _sm_bsearch(pairs, key)
    if idx < 0
        return false
    let rebuilt = []
    let i = 0
    while i < len(pairs)
        if i != idx
            push(rebuilt, pairs[i])
        i = i + 1
    sm[0] = rebuilt
    true

fn sorted_map_size(sm) -> int
    len(sm[0])

fn sorted_map_keys(sm) -> list
    let pairs = sm[0]
    let result = []
    let i = 0
    while i < len(pairs)
        push(result, pairs[i][0])
        i = i + 1
    result

fn sorted_map_min_key(sm)
    let pairs = sm[0]
    if len(pairs) == 0
        return null
    pairs[0][0]

fn sorted_map_max_key(sm)
    let pairs = sm[0]
    if len(pairs) == 0
        return null
    pairs[len(pairs) - 1][0]

fn sorted_map_range(sm, lo_key, hi_key) -> list
    let pairs = sm[0]
    let result = []
    let i = 0
    while i < len(pairs)
        let k = pairs[i][0]
        if k >= lo_key and k <= hi_key
            push(result, pairs[i])
        i = i + 1
    result

// ── Ring Buffer ──────────────────────────────────────────────────────────────

fn ring_new(capacity: int) -> list
    let backing = []
    let i = 0
    while i < capacity
        push(backing, null)
        i = i + 1
    [backing, 0, 0, capacity, 0]

fn ring_push(r, item) -> bool
    let count = r[4]
    let cap = r[3]
    if count >= cap
        return false
    let backing = r[0]
    let tail = r[2]
    backing[tail] = item
    r[2] = (tail + 1) % cap
    r[4] = count + 1
    true

fn ring_pop(r)
    let count = r[4]
    if count == 0
        return null
    let backing = r[0]
    let head = r[1]
    let val = backing[head]
    r[1] = (head + 1) % r[3]
    r[4] = count - 1
    val

fn ring_size(r) -> int
    r[4]

fn ring_is_full(r) -> bool
    r[4] >= r[3]

fn ring_is_empty(r) -> bool
    r[4] == 0

// ── Tests ────────────────────────────────────────────────────────────────────

fn main()
    // Sorted Map tests
    let sm = sorted_map_new()
    sorted_map_set(sm, 30, "thirty")
    sorted_map_set(sm, 10, "ten")
    sorted_map_set(sm, 20, "twenty")
    sorted_map_set(sm, 50, "fifty")
    sorted_map_set(sm, 40, "forty")

    assert_eq(sorted_map_size(sm), 5)
    assert_eq(sorted_map_get(sm, 10), "ten")
    assert_eq(sorted_map_get(sm, 30), "thirty")
    assert_eq(sorted_map_get(sm, 50), "fifty")
    assert_eq(sorted_map_has(sm, 20), true)
    assert_eq(sorted_map_has(sm, 99), false)
    assert_eq(sorted_map_min_key(sm), 10)
    assert_eq(sorted_map_max_key(sm), 50)

    // Keys should be in sorted order
    let ks = sorted_map_keys(sm)
    assert_eq(ks[0], 10)
    assert_eq(ks[1], 20)
    assert_eq(ks[2], 30)
    assert_eq(ks[3], 40)
    assert_eq(ks[4], 50)

    // Update existing key
    sorted_map_set(sm, 30, "THIRTY")
    assert_eq(sorted_map_get(sm, 30), "THIRTY")
    assert_eq(sorted_map_size(sm), 5)

    // Remove
    sorted_map_remove(sm, 20)
    assert_eq(sorted_map_size(sm), 4)
    assert_eq(sorted_map_has(sm, 20), false)

    // Range query
    let range = sorted_map_range(sm, 30, 50)
    assert_eq(len(range), 3)
    assert_eq(range[0][0], 30)
    assert_eq(range[1][0], 40)
    assert_eq(range[2][0], 50)

    // Ring Buffer tests
    let ring = ring_new(3)
    assert_eq(ring_is_empty(ring), true)
    assert_eq(ring_is_full(ring), false)

    ring_push(ring, "a")
    ring_push(ring, "b")
    ring_push(ring, "c")
    assert_eq(ring_size(ring), 3)
    assert_eq(ring_is_full(ring), true)
    assert_eq(ring_push(ring, "d"), false)

    assert_eq(ring_pop(ring), "a")
    assert_eq(ring_pop(ring), "b")
    assert_eq(ring_size(ring), 1)

    ring_push(ring, "x")
    ring_push(ring, "y")
    assert_eq(ring_size(ring), 3)
    assert_eq(ring_pop(ring), "c")
    assert_eq(ring_pop(ring), "x")
    assert_eq(ring_pop(ring), "y")
    assert_eq(ring_is_empty(ring), true)

    print("sorted_map + ring_buffer tests passed")
