// from_json_safety_test -- from_json must NEVER produce an unsafe struct from incomplete/malformed
// JSON (was a SEGFAULT / remote DoS: a missing field stored a wrong-type value that derefs on read).
// Well-formed input is unchanged; missing fields get type-safe defaults; nested structs recurse.
type User
    id: int
    name: string
    active: bool

type Addr
    city: string
    zip: int

type Person
    name: string
    addr: Addr
    tags: list

type Priced
    price: float
    qty: int

fn main()
    let q = chr(34)

    // well-formed -> unchanged
    let good = "\{" + q + "id" + q + ":7," + q + "name" + q + ":" + q + "ada" + q + "," + q + "active" + q + ":true\}"
    let u: User = from_json(good)
    assert(u.id == 7, "good id")
    assert(u.name == "ada", "good name")
    print("PASS: well-formed unchanged")

    // missing fields -> type-safe defaults, NO crash
    let miss = "\{" + q + "id" + q + ":7\}"
    let u2: User = from_json(miss)
    assert(u2.id == 7, "present id kept")
    assert(u2.name == "", "missing string field -> empty string")
    print("PASS: missing field -> default (id=" + str(u2.id) + " name=[" + u2.name + "])")

    // malformed -> all defaults, no crash
    let u3: User = from_json("not json at all")
    assert(u3.name == "", "malformed -> default name (no crash)")
    print("PASS: malformed -> defaults, no crash")

    // VALID-but-non-dict JSON (int / array / string / bool) -> defaults, NO wild-deref crash
    // (was a remote-crash hole: contains(<bare-int>, field) deref'd a fake pointer).
    let nd1: User = from_json("42")
    assert(nd1.id == 0 and nd1.name == "", "non-dict int -> defaults, no crash")
    let nd2: User = from_json("[1, 2, 3]")
    assert(nd2.name == "", "non-dict array -> defaults, no crash")
    let nd3: User = from_json("\"just a string\"")
    assert(nd3.name == "", "non-dict string -> defaults, no crash")
    let nd4: User = from_json("true")
    assert(nd4.name == "", "non-dict bool -> defaults, no crash")
    print("PASS: valid-but-non-dict JSON -> defaults, no wild-deref")

    // missing NESTED struct + list -> recursive default; reading sub-fields is safe
    let pmiss = "\{" + q + "name" + q + ":" + q + "bob" + q + "\}"
    let p: Person = from_json(pmiss)
    assert(p.name == "bob", "person name")
    assert(p.addr.city == "", "missing nested struct -> defaulted (addr.city empty, no crash)")
    assert(p.addr.zip == 0, "missing nested struct int -> 0")
    assert(len(p.tags) == 0, "missing list field -> empty list")
    print("PASS: missing nested struct -> recursive default (addr.city=[" + p.addr.city + "])")

    // a JSON INTEGER into a FLOAT field must be i2f'd to the right double (was garbage ~2.5e-323)
    let pi: Priced = from_json("\{" + q + "price" + q + ":5," + q + "qty" + q + ":3\}")
    assert(pi.price > 4.999 and pi.price < 5.001, "JSON int -> float field = 5.0 (not raw-bit garbage)")
    assert(pi.qty == 3, "int field unchanged")
    let pf: Priced = from_json("\{" + q + "price" + q + ":5.5," + q + "qty" + q + ":3\}")
    assert(pf.price > 5.499 and pf.price < 5.501, "JSON float -> float field = 5.5 (still correct)")
    print("PASS: JSON int/float -> float field both correct")
    print("from_json_safety_test passed")
