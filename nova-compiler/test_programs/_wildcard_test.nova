import std/automata/wildcard

fn main()
    // KAT 1: * matches interior run
    let r1 = wildcard.wild_match("a*b", "aXXb")
    if r1 != 1
        print("FAIL KAT1: wild_match(a*b, aXXb) expected 1 got " + str(r1))
        exit(1)

    // KAT 2: * matches empty run (ab matches a*b)
    let r2 = wildcard.wild_match("a*b", "ab")
    if r2 != 1
        print("FAIL KAT2: wild_match(a*b, ab) expected 1 got " + str(r2))
        exit(1)

    // KAT 3: ? matches exactly one char
    let r3 = wildcard.wild_match("a?b", "axb")
    if r3 != 1
        print("FAIL KAT3: wild_match(a?b, axb) expected 1 got " + str(r3))
        exit(1)

    // KAT 4: ? does NOT match zero chars
    let r4 = wildcard.wild_match("a?b", "ab")
    if r4 != 0
        print("FAIL KAT4: wild_match(a?b, ab) expected 0 got " + str(r4))
        exit(1)

    // KAT 5: * matches empty string
    let r5 = wildcard.wild_match("*", "")
    if r5 != 1
        print("FAIL KAT5: wild_match(*, empty) expected 1 got " + str(r5))
        exit(1)

    // KAT 6: *.txt matches file.txt
    let r6 = wildcard.wild_match("*.txt", "file.txt")
    if r6 != 1
        print("FAIL KAT6: wild_match(*.txt, file.txt) expected 1 got " + str(r6))
        exit(1)

    // KAT 7: *.txt does NOT match file.md
    let r7 = wildcard.wild_match("*.txt", "file.md")
    if r7 != 0
        print("FAIL KAT7: wild_match(*.txt, file.md) expected 0 got " + str(r7))
        exit(1)

    // KAT 8: h?llo matches hello
    let r8 = wildcard.wild_match("h?llo", "hello")
    if r8 != 1
        print("FAIL KAT8: wild_match(h?llo, hello) expected 1 got " + str(r8))
        exit(1)

    // KAT 9: empty pattern matches empty text
    let r9 = wildcard.wild_match("", "")
    if r9 != 1
        print("FAIL KAT9: wild_match(empty, empty) expected 1 got " + str(r9))
        exit(1)

    // KAT 10: literal match
    let r10 = wildcard.wild_match("abc", "abc")
    if r10 != 1
        print("FAIL KAT10: wild_match(abc, abc) expected 1 got " + str(r10))
        exit(1)

    // KAT 11: case-insensitive match A* matches abc
    let r11 = wildcard.wild_match_ci("A*", "abc")
    if r11 != 1
        print("FAIL KAT11: wild_match_ci(A*, abc) expected 1 got " + str(r11))
        exit(1)

    // KAT 12a: wild_has_wildcard detects *
    let r12a = wildcard.wild_has_wildcard("*.txt")
    if r12a != 1
        print("FAIL KAT12a: wild_has_wildcard(*.txt) expected 1 got " + str(r12a))
        exit(1)

    // KAT 12b: wild_has_wildcard detects ?
    let r12b = wildcard.wild_has_wildcard("h?llo")
    if r12b != 1
        print("FAIL KAT12b: wild_has_wildcard(h?llo) expected 1 got " + str(r12b))
        exit(1)

    // KAT 12c: wild_has_wildcard returns 0 for plain literal
    let r12c = wildcard.wild_has_wildcard("abc")
    if r12c != 0
        print("FAIL KAT12c: wild_has_wildcard(abc) expected 0 got " + str(r12c))
        exit(1)

    // KAT 13: literal mismatch -> reject
    let r13 = wildcard.wild_match("abc", "abd")
    if r13 != 0
        print("FAIL KAT13: wild_match(abc, abd) expected 0 got " + str(r13))
        exit(1)

    // KAT 14: * at start matches prefix wildcard
    let r14 = wildcard.wild_match("*world", "hello world")
    if r14 != 1
        print("FAIL KAT14: wild_match(*world, hello world) expected 1 got " + str(r14))
        exit(1)

    // KAT 15: multiple wildcards
    let r15 = wildcard.wild_match("a*b*c", "aXbYc")
    if r15 != 1
        print("FAIL KAT15: wild_match(a*b*c, aXbYc) expected 1 got " + str(r15))
        exit(1)

    // KAT 16: case-insensitive reject
    let r16 = wildcard.wild_match_ci("A*Z", "abc")
    if r16 != 0
        print("FAIL KAT16: wild_match_ci(A*Z, abc) expected 0 got " + str(r16))
        exit(1)

    print("_wildcard_test passed")
