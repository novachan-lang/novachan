import std/parsing/wildcard

fn main()
    // --- Mandatory KAT vectors (from spec) ---

    // like("hello","h%o")==true
    let r1 = like("hello", "h%o")
    if r1 == 0
        print("FAIL wildcard like-h%o: got " + str(r1) + " want 1")
        exit(1)

    // like("hi","h_")==true
    let r2 = like("hi", "h_")
    if r2 == 0
        print("FAIL wildcard like-h_: got " + str(r2) + " want 1")
        exit(1)

    // like("hi","h_x")==false
    let r3 = like("hi", "h_x")
    if r3 == 1
        print("FAIL wildcard like-h_x: got " + str(r3) + " want 0")
        exit(1)

    // like("abc","%")==true
    let r4 = like("abc", "%")
    if r4 == 0
        print("FAIL wildcard like-abc-%: got " + str(r4) + " want 1")
        exit(1)

    // like("","")==true
    let r5 = like("", "")
    if r5 == 0
        print("FAIL wildcard like-empty: got " + str(r5) + " want 1")
        exit(1)

    // like("a%b","a\%b")==true  (literal percent via backslash escape)
    let r6 = like("a%b", "a\\%b")
    if r6 == 0
        print("FAIL wildcard like-escape-pct: got " + str(r6) + " want 1")
        exit(1)

    // ilike("HELLO","h%o")==true
    let r7 = ilike("HELLO", "h%o")
    if r7 == 0
        print("FAIL wildcard ilike-HELLO: got " + str(r7) + " want 1")
        exit(1)

    // like("cat","c_t")==true
    let r8 = like("cat", "c_t")
    if r8 == 0
        print("FAIL wildcard like-cat: got " + str(r8) + " want 1")
        exit(1)

    // like("ct","c_t")==false
    let r9 = like("ct", "c_t")
    if r9 == 1
        print("FAIL wildcard like-ct: got " + str(r9) + " want 0")
        exit(1)

    // --- Additional edge-case / safety vectors ---

    // % matches empty string
    let r10 = like("", "%")
    if r10 == 0
        print("FAIL wildcard like-empty-pct: got " + str(r10) + " want 1")
        exit(1)

    // _ does NOT match empty
    let r11 = like("", "_")
    if r11 == 1
        print("FAIL wildcard like-empty-und: got " + str(r11) + " want 0")
        exit(1)

    // non-empty text vs empty pattern
    let r12 = like("x", "")
    if r12 == 1
        print("FAIL wildcard like-x-empty: got " + str(r12) + " want 0")
        exit(1)

    // suffix match
    let r13 = like("hello world", "%world")
    if r13 == 0
        print("FAIL wildcard like-suffix: got " + str(r13) + " want 1")
        exit(1)

    // exact literal match
    let r14 = like("hello", "hello")
    if r14 == 0
        print("FAIL wildcard like-exact: got " + str(r14) + " want 1")
        exit(1)

    // literal too long
    let r15 = like("hell", "hello")
    if r15 == 1
        print("FAIL wildcard like-prefix-short: got " + str(r15) + " want 0")
        exit(1)

    // multiple % wildcards
    let r16 = like("abc", "a%b%c")
    if r16 == 0
        print("FAIL wildcard like-multi-pct: got " + str(r16) + " want 1")
        exit(1)

    // multiple % with interior chars
    let r17 = like("axbxc", "a%b%c")
    if r17 == 0
        print("FAIL wildcard like-multi-pct2: got " + str(r17) + " want 1")
        exit(1)

    // like_e with explicit esc char '!'
    let r18 = like_e("50%", "50!%", "!")
    if r18 == 0
        print("FAIL wildcard like_e-explicit-esc: got " + str(r18) + " want 1")
        exit(1)

    // like_e explicit esc no-match
    let r19 = like_e("50x", "50!%", "!")
    if r19 == 1
        print("FAIL wildcard like_e-explicit-esc-nomatch: got " + str(r19) + " want 0")
        exit(1)

    // like_e with no esc: % is wildcard
    let r20 = like_e("axb", "a%b", "")
    if r20 == 0
        print("FAIL wildcard like_e-no-esc: got " + str(r20) + " want 1")
        exit(1)

    // ilike with underscore
    let r21 = ilike("FOO_BAR", "foo_bar")
    if r21 == 0
        print("FAIL wildcard ilike-underscore: got " + str(r21) + " want 1")
        exit(1)

    // escaped underscore matches literal _
    let r22 = like("a_b", "a\\_b")
    if r22 == 0
        print("FAIL wildcard like-escape-und: got " + str(r22) + " want 1")
        exit(1)

    // escaped underscore does NOT match other chars
    let r23 = like("axb", "a\\_b")
    if r23 == 1
        print("FAIL wildcard like-escape-und-nomatch: got " + str(r23) + " want 0")
        exit(1)

    print("PASS _wildcard_test")
