// Supervisor pattern: a supervisor monitors workers and restarts them
// if they crash. Erlang-style fault tolerance, zero ceremony.

fn unreliable_worker(ch, id, attempt)
    if attempt == 1
        send(ch, "worker-" + str(id) + ": crash on attempt " + str(attempt))
        panic("simulated failure")
    send(ch, "worker-" + str(id) + ": OK on attempt " + str(attempt))

fn supervise_worker(ch, id)
    let attempt = 1
    let done = 0
    while done == 0
        let pid = spawn unreliable_worker(ch, id, attempt)
        let mon = monitor(pid)
        let status = receive(mon)
        if status == 0
            done = 1
        else
            attempt = attempt + 1
            if attempt > 3
                send(ch, "worker-" + str(id) + ": gave up")
                done = 1

fn main()
    let ch = channel()

    // Supervise 3 workers concurrently
    spawn supervise_worker(ch, 1)
    spawn supervise_worker(ch, 2)
    spawn supervise_worker(ch, 3)

    // Each worker crashes once then succeeds = 2 messages per worker = 6 total
    let msgs = []
    let i = 0
    while i < 6
        push(msgs, receive(ch))
        i = i + 1

    // Print all messages
    let j = 0
    while j < len(msgs)
        print(msgs[j])
        j = j + 1

    // Verify: every worker eventually reported OK
    let ok_count = 0
    let k = 0
    while k < len(msgs)
        if contains(msgs[k], "OK")
            ok_count = ok_count + 1
        k = k + 1

    assert(ok_count == 3, "all 3 workers eventually succeeded, got " + str(ok_count))
    print("mt_supervisor_test: PASSED — 3 supervised workers, crash+restart, all recovered")
