// NOVA EDGE — embedded / cross-platform helpers (framework 8 per strategy doc).
// v0.1 ships cross-platform host introspection + bit/byte manipulation
// primitives that embedded code typically needs. Real microcontroller
// targets ship in v0.2+ when a NOVA embedded backend is wired.
//
// Public API (v0.1):
//   edge.cores()              -> int (host CPU count)
//   edge.bit_set(v, bit)      -> v with bit set
//   edge.bit_clear(v, bit)    -> v with bit cleared
//   edge.bit_test(v, bit)     -> 1 if bit set, 0 otherwise
//   edge.hex_byte(b)          -> "FF"-style two-char hex
//   edge.bytes_to_hex(bytes)  -> "DEADBEEF"-style from a list of ints
//   edge.byte_at(value, i)    -> byte i of value (LSB at i=0)

fn cores() -> int
    cpu_count()

fn bit_set(v: int, bit: int) -> int
    v | (1 << bit)

fn bit_clear(v: int, bit: int) -> int
    v & ~(1 << bit)

fn bit_test(v: int, bit: int) -> int
    (v >> bit) & 1

fn _nibble_hex(n: int) -> string
    if n == 0
        return "0"
    if n == 1
        return "1"
    if n == 2
        return "2"
    if n == 3
        return "3"
    if n == 4
        return "4"
    if n == 5
        return "5"
    if n == 6
        return "6"
    if n == 7
        return "7"
    if n == 8
        return "8"
    if n == 9
        return "9"
    if n == 10
        return "A"
    if n == 11
        return "B"
    if n == 12
        return "C"
    if n == 13
        return "D"
    if n == 14
        return "E"
    "F"

fn hex_byte(b: int) -> string
    _nibble_hex((b >> 4) & 15) + _nibble_hex(b & 15)

fn bytes_to_hex(bytes: list) -> string
    let out = ""
    for b in bytes
        out = out + hex_byte(b)
    out

fn byte_at(value: int, i: int) -> int
    (value >> (i * 8)) & 255
