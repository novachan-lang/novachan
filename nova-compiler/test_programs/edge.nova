// NOVA EDGE — embedded / cross-platform helpers (framework 8 per strategy doc).
// v0.1 ships cross-platform host introspection + bit/byte manipulation
// primitives that embedded code typically needs. Real microcontroller
// targets ship in v0.2+ when a NOVA embedded backend is wired.
//
// Public API (v0.1):
//   edge.cores()              -> int (host CPU count)
//   edge.bit_set(v, bit)      -> v with bit set
//   edge.bit_clear(v, bit)    -> v with bit cleared
//   edge.bit_test(v, bit)     -> 1 if bit set, 0 otherwise
//   edge.hex_byte(b)          -> "FF"-style two-char hex
//   edge.bytes_to_hex(bytes)  -> "DEADBEEF"-style from a list of ints
//   edge.byte_at(value, i)    -> byte i of value (LSB at i=0)

fn cores() -> int
    cpu_count()

fn bit_set(v: int, bit: int) -> int
    v | (1 << bit)

fn bit_clear(v: int, bit: int) -> int
    v & ~(1 << bit)

fn bit_test(v: int, bit: int) -> int
    (v >> bit) & 1

fn _nibble_hex(n: int) -> string
    if n == 0
        return "0"
    if n == 1
        return "1"
    if n == 2
        return "2"
    if n == 3
        return "3"
    if n == 4
        return "4"
    if n == 5
        return "5"
    if n == 6
        return "6"
    if n == 7
        return "7"
    if n == 8
        return "8"
    if n == 9
        return "9"
    if n == 10
        return "A"
    if n == 11
        return "B"
    if n == 12
        return "C"
    if n == 13
        return "D"
    if n == 14
        return "E"
    "F"

fn hex_byte(b: int) -> string
    _nibble_hex((b >> 4) & 15) + _nibble_hex(b & 15)

fn bytes_to_hex(bytes: list) -> string
    let out = ""
    for b in bytes
        out = out + hex_byte(b)
    out

fn byte_at(value: int, i: int) -> int
    (value >> (i * 8)) & 255

// ── v0.2 additions ───────────────────────────────────────────────────────

// Big-endian byte unpack: 4 bytes -> 32-bit int.
fn be_u32(b0: int, b1: int, b2: int, b3: int) -> int
    (b0 << 24) | (b1 << 16) | (b2 << 8) | b3

// Little-endian byte unpack: 4 bytes -> 32-bit int.
fn le_u32(b0: int, b1: int, b2: int, b3: int) -> int
    (b3 << 24) | (b2 << 16) | (b1 << 8) | b0

// 16-bit endian helpers.
fn be_u16(b0: int, b1: int) -> int
    (b0 << 8) | b1

fn le_u16(b0: int, b1: int) -> int
    (b1 << 8) | b0

// CRC-16 (CRC-16/CCITT-FALSE, polynomial 0x1021, init 0xFFFF).
// Common for serial / RF / IoT framing.
fn crc16(bytes: list) -> int
    let crc = 65535
    for b in bytes
        crc = crc ^ (b << 8)
        let i = 0
        while i < 8
            if (crc & 32768) != 0
                crc = ((crc << 1) ^ 4129) & 65535
            else
                crc = (crc << 1) & 65535
            i = i + 1
    crc

// Hex string -> list of bytes.
fn hex_to_bytes(s: string) -> list
    let out = []
    let i = 0
    while i + 1 < len(s)
        let hi = _hex_nibble(s[i])
        let lo = _hex_nibble(s[i + 1])
        out.push((hi << 4) | lo)
        i = i + 2
    out

fn _hex_nibble(c: string) -> int
    if c == "0"
        return 0
    if c == "1"
        return 1
    if c == "2"
        return 2
    if c == "3"
        return 3
    if c == "4"
        return 4
    if c == "5"
        return 5
    if c == "6"
        return 6
    if c == "7"
        return 7
    if c == "8"
        return 8
    if c == "9"
        return 9
    if c == "A" or c == "a"
        return 10
    if c == "B" or c == "b"
        return 11
    if c == "C" or c == "c"
        return 12
    if c == "D" or c == "d"
        return 13
    if c == "E" or c == "e"
        return 14
    if c == "F" or c == "f"
        return 15
    0

// Base64 encode/decode (RFC 4648). The most common embedded-protocol
// text encoding besides hex.
fn base64_encode(bytes: list) -> string
    let alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    let out = ""
    let i = 0
    let n = len(bytes)
    while i + 2 < n
        let b0 = bytes[i]
        let b1 = bytes[i + 1]
        let b2 = bytes[i + 2]
        out = out + alphabet[(b0 >> 2) & 63]
        out = out + alphabet[((b0 << 4) | (b1 >> 4)) & 63]
        out = out + alphabet[((b1 << 2) | (b2 >> 6)) & 63]
        out = out + alphabet[b2 & 63]
        i = i + 3
    if i < n
        let b0 = bytes[i]
        out = out + alphabet[(b0 >> 2) & 63]
        if i + 1 < n
            let b1 = bytes[i + 1]
            out = out + alphabet[((b0 << 4) | (b1 >> 4)) & 63]
            out = out + alphabet[(b1 << 2) & 63]
            out = out + "="
        else
            out = out + alphabet[(b0 << 4) & 63]
            out = out + "=="
    out
