// orm_typed_rewrite_test -- guards the universal-ORM typed-let rewrite (no DB/forge deps, fast).
// `let xs: list<T> = orm_all(...)`  -> <T>__from_dict_list(orm_all(...))  (typed list of REAL structs)
// `let r: Result<T> = orm_one(...)` -> <T>__from_dict(orm_one(...))       (validated single struct)
// orm_all/orm_one here are LOCAL stubs returning name-keyed STRING row dicts (as a real driver would);
// the per-field string->typed coercion is the compiler-generated <T>__from_dict machinery.
type User
    id: int
    name: string
    age: int
    active: bool

fn orm_all(db, sql: string, params) -> list
    [{"id": "1", "name": "Ada", "age": "36", "active": "1"}, {"id": "2", "name": "Linus", "age": "54", "active": "0"}]

// Mirrors the real forge_orm.orm_one: returns an element of an untyped list (-> any), NOT a bare dict
// literal -- so it infers `any` (which the typed-let accepts), exactly like db_find.
fn orm_one(db, sql: string, params) -> any
    let rows = orm_all(db, sql, params)
    if len(rows) > 0
        return rows[0]
    {}

fn main()
    let users: list<User> = orm_all(0, "SELECT ...", [])
    assert_eq(len(users), 2)
    assert_eq(users[0].name, "Ada")
    assert_eq(users[0].age, 36)        // coerced text->int
    assert_eq(users[0].active, true)   // coerced "1"->bool
    assert_eq(users[1].id, 2)
    let r: Result<User> = orm_one(0, "SELECT ... LIMIT 1", [])
    match r
        Ok(u) =>
            assert_eq(u.name, "Ada")
            assert_eq(u.age, 36)
        Err(e) =>
            print("FAIL orm_one: " + e)
            exit(1)
    print("orm_typed_rewrite_test passed")
