// LOCK-4 / L7 #36 inc3c-part2 KAT — sized width must flow through SLOTS,
// not just through const-folded literals (inc3b / inc3c-part1a).
//
// The lattice under test: a slot's width is UNKNOWN -> <width> -> CONFLICTED("").
// It is monotonic and never returns to a previous state, which is what guarantees
// ir_infer_types reaches its fixpoint (the earlier attempt oscillated).
//
// NOTE: assertions are INLINE on purpose — a `fn check()` helper mutating
// module-level counters does not propagate (module vars are baked).
let pass = 0
let fail = 0

// ── 1. annotation bridge: `let x: u8 = <plain int>` seeds the slot width ─────
let a: u8 = 255
if a + 1 == 0
    pass = pass + 1
else
    print("FAIL annot u8 wrap: expected 0 got " + str(a + 1))
    fail = fail + 1

let b: u8 = 200
let c: u8 = 100
if b + c == 44
    pass = pass + 1
else
    print("FAIL annot u8 add: expected 44 got " + str(b + c))
    fail = fail + 1

let d: i8 = 127
if d + 1 == -128
    pass = pass + 1
else
    print("FAIL annot i8 overflow: expected -128 got " + str(d + 1))
    fail = fail + 1

let e: u16 = 65535
if e + 1 == 0
    pass = pass + 1
else
    print("FAIL annot u16 wrap: expected 0 got " + str(e + 1))
    fail = fail + 1

let f: u32 = 4294967295
if f + 1 == 0
    pass = pass + 1
else
    print("FAIL annot u32 wrap: expected 0 got " + str(f + 1))
    fail = fail + 1

// ── 2. reassignment through a mutable slot keeps the width ──────────────────
let mut g: u8 = 250
g = g + 10
if g == 4
    pass = pass + 1
else
    print("FAIL reassign u8 wrap: expected 4 got " + str(g))
    fail = fail + 1

// ── 3. runtime-valued sized vars — the actual inc3c-part2 target ────────────
// A loop accumulator is not const-foldable, so the width has to survive on the
// SLOT across store -> load.
let mut acc: u8 = 0
let mut i = 0
while i < 300
    acc = acc + 1
    i = i + 1
if acc == 44
    pass = pass + 1
else
    print("FAIL loop u8 accumulate: expected 44 got " + str(acc))
    fail = fail + 1

// ── 4. default (unsized) int must be COMPLETELY unaffected ──────────────────
let big = 4294967295
if big + 1 == 4294967296
    pass = pass + 1
else
    print("FAIL default int no wrap: expected 4294967296 got " + str(big + 1))
    fail = fail + 1

let mut sum = 0
let mut j = 0
while j < 300
    sum = sum + 1
    j = j + 1
if sum == 300
    pass = pass + 1
else
    print("FAIL default int loop: expected 300 got " + str(sum))
    fail = fail + 1

// ── 5. width must NOT leak across independent slots ─────────────────────────
let sized: u8 = 255
let plain = 255
if plain + 1 == 256
    pass = pass + 1
else
    print("FAIL plain int unaffected: expected 256 got " + str(plain + 1))
    fail = fail + 1

if sized + 1 == 0
    pass = pass + 1
else
    print("FAIL sized still wraps: expected 0 got " + str(sized + 1))
    fail = fail + 1

print("L7 inc3c-part2 KAT: " + str(pass) + " passed, " + str(fail) + " failed")
