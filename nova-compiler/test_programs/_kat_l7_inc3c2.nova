// LOCK-4 / L7 #36 inc3c-part2 KAT — sized width must flow through SLOTS,
// not just through const-folded literals (inc3b/inc3c-part1a).
//
// The lattice under test: a slot's width is UNKNOWN -> <width> -> CONFLICTED.
// It is monotonic and never returns to a previous state, which is what
// guarantees inference terminates (the earlier attempt oscillated and hung gen3).
let pass = 0
let fail = 0

fn check(name: string, got: int, want: int)
    if got == want
        pass = pass + 1
    else
        print("FAIL " + name + ": expected " + str(want) + " got " + str(got))
        fail = fail + 1

// ── 1. annotation bridge: `let x: u8 = <plain int>` seeds the slot width ──────
// This is the piece that makes sized numerics actually usable — without it a
// developer must write a suffix on every literal.
let a: u8 = 255
check("annot u8 wrap", a + 1, 0)

let b: u8 = 200
let c: u8 = 100
check("annot u8 add", b + c, 44)

let d: i8 = 127
check("annot i8 overflow", d + 1, -128)

let e: u16 = 65535
check("annot u16 wrap", e + 1, 0)

let f: u32 = 4294967295
check("annot u32 wrap", f + 1, 0)

// ── 2. reassignment through a mutable slot keeps the width ───────────────────
let mut g: u8 = 250
g = g + 10
check("reassign u8 wrap", g, 4)

let mut h = 255u8
h = h + 1
check("reassign suffix u8", h, 0)

// ── 3. runtime-valued sized vars (the actual inc3c-part2 target) ─────────────
// The value is not a compile-time constant, so const_fold cannot forward it;
// the width has to survive on the SLOT through store -> load.
fn make_u8(seed: int) -> int
    seed

let r: u8 = make_u8(255)
check("runtime-valued u8 wrap", r + 1, 0)

let mut acc: u8 = 0
let mut i = 0
while i < 300
    acc = acc + 1
    i = i + 1
check("loop accumulate u8 wraps at 256", acc, 44)

// ── 4. default (unsized) int must be COMPLETELY unaffected ───────────────────
// Any regression here is a hot-loop perf and correctness disaster.
let big = 4294967295
check("default int no wrap", big + 1, 4294967296)

let mut sum = 0
let mut j = 0
while j < 300
    sum = sum + 1
    j = j + 1
check("default int loop no wrap", sum, 300)

let neg = 0 - 200
check("default int stays signed", neg, -200)

// ── 5. width must NOT leak across independent slots ──────────────────────────
let sized: u8 = 255
let plain = 255
check("independent plain int unaffected", plain + 1, 256)
check("sized still wraps", sized + 1, 0)

print("L7 inc3c-part2 KAT: " + str(pass) + " passed, " + str(fail) + " failed")
