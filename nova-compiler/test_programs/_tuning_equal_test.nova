import std/music/tuning_equal

fn main()
    // ── et_cents ──────────────────────────────────────────────────────────────
    let c1 = et_cents(1)
    if c1 != 100
        print("FAIL tuning_equal et_cents(1): got " + str(c1) + " want 100")
        exit(1)

    let c12 = et_cents(12)
    if c12 != 1200
        print("FAIL tuning_equal et_cents(12): got " + str(c12) + " want 1200")
        exit(1)

    let c0 = et_cents(0)
    if c0 != 0
        print("FAIL tuning_equal et_cents(0): got " + str(c0) + " want 0")
        exit(1)

    let c7 = et_cents(7)
    if c7 != 700
        print("FAIL tuning_equal et_cents(7): got " + str(c7) + " want 700")
        exit(1)

    // negative semitones
    let cm1 = et_cents(-1)
    if cm1 != -100
        print("FAIL tuning_equal et_cents(-1): got " + str(cm1) + " want -100")
        exit(1)

    // ── et_freq_hz ────────────────────────────────────────────────────────────
    // A4 = MIDI 69 = 440 Hz
    let f69 = et_freq_hz(69)
    if f69 != 440
        print("FAIL tuning_equal et_freq_hz(69): got " + str(f69) + " want 440")
        exit(1)

    // C4 = MIDI 60 = 262 Hz (round(440 * 2^(-9/12)) = round(261.63) = 262)
    let f60 = et_freq_hz(60)
    if f60 != 262
        print("FAIL tuning_equal et_freq_hz(60): got " + str(f60) + " want 262")
        exit(1)

    // A5 = MIDI 81 = 880 Hz (440 * 2^(12/12) = 440 * 2 = 880)
    let f81 = et_freq_hz(81)
    if f81 != 880
        print("FAIL tuning_equal et_freq_hz(81): got " + str(f81) + " want 880")
        exit(1)

    // A3 = MIDI 57 = 220 Hz (440 * 2^(-12/12) = 440 / 2 = 220)
    let f57 = et_freq_hz(57)
    if f57 != 220
        print("FAIL tuning_equal et_freq_hz(57): got " + str(f57) + " want 220")
        exit(1)

    // C5 = MIDI 72 = round(440 * 2^(3/12)) = round(523.25) = 523
    let f72 = et_freq_hz(72)
    if f72 != 523
        print("FAIL tuning_equal et_freq_hz(72): got " + str(f72) + " want 523")
        exit(1)

    // ── et_ratio_millicents ───────────────────────────────────────────────────
    let r1 = et_ratio_millicents(1)
    if r1 != 100
        print("FAIL tuning_equal et_ratio_millicents(1): got " + str(r1) + " want 100")
        exit(1)

    let r12 = et_ratio_millicents(12)
    if r12 != 1200
        print("FAIL tuning_equal et_ratio_millicents(12): got " + str(r12) + " want 1200")
        exit(1)

    let r7 = et_ratio_millicents(7)
    if r7 != 700
        print("FAIL tuning_equal et_ratio_millicents(7): got " + str(r7) + " want 700")
        exit(1)

    // ── et_interval_cents ─────────────────────────────────────────────────────
    // C4 to G4 = 7 semitones = 700 cents
    let ic1 = et_interval_cents(60, 67)
    if ic1 != 700
        print("FAIL tuning_equal et_interval_cents(60,67): got " + str(ic1) + " want 700")
        exit(1)

    // G4 to C4 = -7 semitones = -700 cents (descending)
    let ic2 = et_interval_cents(67, 60)
    if ic2 != -700
        print("FAIL tuning_equal et_interval_cents(67,60): got " + str(ic2) + " want -700")
        exit(1)

    // unison
    let ic3 = et_interval_cents(60, 60)
    if ic3 != 0
        print("FAIL tuning_equal et_interval_cents(60,60): got " + str(ic3) + " want 0")
        exit(1)

    // octave = 1200 cents
    let ic4 = et_interval_cents(60, 72)
    if ic4 != 1200
        print("FAIL tuning_equal et_interval_cents(60,72): got " + str(ic4) + " want 1200")
        exit(1)

    // A3 to A4 = 1200 cents
    let ic5 = et_interval_cents(57, 69)
    if ic5 != 1200
        print("FAIL tuning_equal et_interval_cents(57,69): got " + str(ic5) + " want 1200")
        exit(1)

    print("PASS _tuning_equal_test")
