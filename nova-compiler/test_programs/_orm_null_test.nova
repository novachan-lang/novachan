import forge_orm
type Rec
    id: int
    note: string
fn main()
    let sr = orm_open("sqlite://_n.db")
    match sr
        Ok(db) =>
            orm_exec(db, "DROP TABLE IF EXISTS r", [])
            orm_exec(db, "CREATE TABLE r (id int, note text)", [])
            orm_exec(db, "INSERT INTO r (id, note) VALUES (?, ?)", [1, "hi"])
            orm_exec(db, "INSERT INTO r (id, note) VALUES (?, ?)", [2, orm_null()])
            assert_eq(orm_count(db, "r", "note IS NULL", []), 1)
            assert_eq(orm_count(db, "r", "note IS NOT NULL", []), 1)
            let got: Result<Rec> = orm_one(db, "SELECT id, note FROM r WHERE id = ?", [1])
            match got
                Ok(rc) =>
                    assert_eq(rc.note, "hi")
                Err(e) =>
                    print("FAIL one: " + e)
                    exit(1)
            print("NULL params OK")
            orm_exec(db, "DROP TABLE IF EXISTS r", [])
            orm_close(db)
        Err(e) =>
            print("open err " + e)
            exit(1)
