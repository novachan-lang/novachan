// H: minimal sorted_map_new pattern -- return an EMPTY local list wrapped in an outer
// literal, then APPEND to the inner list via the returned aggregate.
fn mk() -> list
    let pairs = []
    [pairs]
fn main()
    let sm = mk()
    let inner = sm[0]
    push(inner, 1)
    push(inner, 2)
    print(len(inner))
    print("H_DONE")
