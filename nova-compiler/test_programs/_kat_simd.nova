// KAT: explicit SIMD path. Elementwise kernels over NOVA float lists in RAW mode
// (elem_kind 2 — contiguous IEEE-754 doubles), which clang vectorizes to 4-wide AVX
// (confirmed: "vectorized loop (vectorization width: 4, interleaved count: 4)").
//
// SAFETY: every kernel refuses unless BOTH operands are genuine raw float lists. A boxed
// or heterogeneous list holds POINTERS; reading those as doubles would be type confusion.
// So refusal is a hard precondition, not an optimization — the cases below pin it.
fn main()
    let a = []
    let b = []
    let i = 0
    while i < 8
        a.push(1.0 * i)
        b.push(10.0 * i)
        i = i + 1

    assert(simd_ready(a) == true, "raw float list is SIMD-ready")
    assert(str(simd_add(a, b)) == "[0.0, 11.0, 22.0, 33.0, 44.0, 55.0, 66.0, 77.0]", "simd_add")
    assert(str(simd_sub(b, a)) == "[0.0, 9.0, 18.0, 27.0, 36.0, 45.0, 54.0, 63.0]", "simd_sub")
    assert(simd_dot(a, b) == 1400.0, "simd_dot")
    assert(simd_sum(a) == 28.0, "simd_sum")
    assert(simd_sum(simd_scale(a, 2.0)) == 56.0, "simd_scale then sum")
    assert(simd_sum(simd_mul(a, b)) == 1400.0, "simd_mul then sum == dot")

    // length mismatch uses the SHORTER operand — never over-reads
    let short = []
    short.push(1.0)
    short.push(2.0)
    assert(len(simd_add(a, short)) == 2, "mismatch uses shorter length")

    // a NON-raw list must be REFUSED, not misread as doubles
    let ints = [1, 2, 3]
    assert(simd_ready(ints) == false, "int list is NOT SIMD-ready")
    assert(len(simd_add(ints, ints)) == 0, "refused int list -> empty")
    assert(simd_dot(ints, ints) == 0.0, "refused int list -> 0.0")

    // a BOXED float literal list is also refused (literals build boxed, not raw)
    let lit = [1.0, 2.0]
    assert(simd_ready(lit) == false, "boxed float literal is NOT raw mode")
    assert(len(simd_add(lit, lit)) == 0, "refused boxed literal -> empty")

    // empty
    let e = []
    assert(simd_sum(e) == 0.0, "empty sum")

    print("PASS _kat_simd")
