// KAT test for std/collections/trie.
//
// Hand-computed expected values:
//   Insert: cat, car, card, dog
//
//   Trie structure (node paths, "$"=end-of-word):
//     root -> "c" -> "a" -> "t" -> "$"       (cat)
//                        -> "r" -> "$"       (car)
//                                -> "d" -> "$" (card)
//          -> "d" -> "o" -> "g" -> "$"       (dog)
//
//   size = 4 (four "$" markers)
//   contains("car")  = true  ("$" at root->c->a->r)
//   contains("ca")   = false (no "$" at root->c->a)
//   contains("dog")  = true  ("$" at root->d->o->g)
//   starts_with("ca") = true  (root->c->a path exists)
//   starts_with("z")  = false (no "z" at root)
//   keys_with_prefix("car") = ["car","card"] (DFS from root->c->a->r, sorted)

import std/collections/trie

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        let ws = "false"
        if got
            gs = "true"
        if want
            ws = "true"
        print("FAIL " + label + ": got " + gs + " want " + ws)
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got " + got + " want " + want)
        exit(1)

fn main()
    // --- Setup: build a trie with the four KAT words ---
    let t = tr_new()
    tr_insert(t, "cat")
    tr_insert(t, "car")
    tr_insert(t, "card")
    tr_insert(t, "dog")

    // --- KAT 1: tr_size = 4 ---
    cki("size", tr_size(t), 4)

    // --- KAT 2: tr_contains exact matches ---
    ckb("contains_cat",  tr_contains(t, "cat"),  true)
    ckb("contains_car",  tr_contains(t, "car"),  true)
    ckb("contains_card", tr_contains(t, "card"), true)
    ckb("contains_dog",  tr_contains(t, "dog"),  true)

    // --- KAT 3: tr_contains non-members ---
    ckb("contains_ca",   tr_contains(t, "ca"),   false)
    ckb("contains_ca_prefix_only", tr_contains(t, "ca"), false)
    ckb("contains_do",   tr_contains(t, "do"),   false)
    ckb("contains_cars", tr_contains(t, "cars"), false)
    ckb("contains_z",    tr_contains(t, "z"),    false)
    ckb("contains_empty", tr_contains(t, ""),    false)

    // --- KAT 4: tr_starts_with ---
    ckb("starts_with_ca",  tr_starts_with(t, "ca"),  true)
    ckb("starts_with_car", tr_starts_with(t, "car"), true)
    ckb("starts_with_d",   tr_starts_with(t, "d"),   true)
    ckb("starts_with_do",  tr_starts_with(t, "do"),  true)
    ckb("starts_with_dog", tr_starts_with(t, "dog"), true)
    ckb("starts_with_z",   tr_starts_with(t, "z"),   false)
    ckb("starts_with_da",  tr_starts_with(t, "da"),  false)
    ckb("starts_with_cats", tr_starts_with(t, "cats"), false)
    // empty prefix = any word exists -> true (root is always reachable)
    ckb("starts_with_empty", tr_starts_with(t, ""), true)

    // --- KAT 5: tr_keys_with_prefix("car") = ["car","card"] ---
    let kcar = tr_keys_with_prefix(t, "car")
    cki("prefix_car_len", len(kcar), 2)
    cks("prefix_car_0", kcar[0], "car")
    cks("prefix_car_1", kcar[1], "card")

    // --- KAT 6: tr_keys_with_prefix("ca") = ["car","card","cat"] (sorted) ---
    let kca = tr_keys_with_prefix(t, "ca")
    cki("prefix_ca_len", len(kca), 3)
    cks("prefix_ca_0", kca[0], "car")
    cks("prefix_ca_1", kca[1], "card")
    cks("prefix_ca_2", kca[2], "cat")

    // --- KAT 7: tr_keys_with_prefix("dog") = ["dog"] ---
    let kdog = tr_keys_with_prefix(t, "dog")
    cki("prefix_dog_len", len(kdog), 1)
    cks("prefix_dog_0", kdog[0], "dog")

    // --- KAT 8: tr_keys_with_prefix("z") = [] (no such prefix) ---
    let kz = tr_keys_with_prefix(t, "z")
    cki("prefix_z_len", len(kz), 0)

    // --- KAT 9: duplicate insert is idempotent (size stays 4) ---
    tr_insert(t, "cat")
    tr_insert(t, "dog")
    cki("size_after_dup_inserts", tr_size(t), 4)
    ckb("contains_cat_after_dup", tr_contains(t, "cat"), true)

    // --- KAT 10: single-char word ---
    let t2 = tr_new()
    tr_insert(t2, "a")
    tr_insert(t2, "b")
    cki("t2_size", tr_size(t2), 2)
    ckb("t2_contains_a", tr_contains(t2, "a"), true)
    ckb("t2_contains_b", tr_contains(t2, "b"), true)
    ckb("t2_contains_c", tr_contains(t2, "c"), false)
    ckb("t2_starts_with_a", tr_starts_with(t2, "a"), true)
    let ka = tr_keys_with_prefix(t2, "a")
    cki("t2_prefix_a_len", len(ka), 1)
    cks("t2_prefix_a_0", ka[0], "a")

    // --- KAT 11: empty trie ---
    let t3 = tr_new()
    cki("t3_size_empty", tr_size(t3), 0)
    ckb("t3_contains_empty_trie", tr_contains(t3, "cat"), false)
    ckb("t3_starts_with_empty_trie", tr_starts_with(t3, "c"), false)
    let k_empty = tr_keys_with_prefix(t3, "c")
    cki("t3_prefix_empty_len", len(k_empty), 0)

    print("_trie_test passed")

main()
