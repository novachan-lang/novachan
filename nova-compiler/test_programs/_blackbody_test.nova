// KAT for std/physics/blackbody — blackbody radiation formulas.
import std/physics/blackbody

// approx_rel — relative tolerance check: |a-b|/|b| < tol.
// Handles very small values where absolute tolerance is meaningless.
fn approx_rel(a, b, tol)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    let ref = b
    if ref < 0.0
        ref = 0.0 - ref
    if ref < 0.0000000000001
        return d < tol
    let ratio = d / ref
    return ratio < tol

fn ck_rel(label, got, want, tol)
    if not approx_rel(got, want, tol)
        print("FAIL blackbody " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // wien_peak_wavelength: lambda = 2.898e-3 / T
    // T=5800 K (solar surface) -> ~5.0e-7 m
    let lam_sun = wien_peak_wavelength(5800.0)
    // expected = 2.898e-3 / 5800 = 4.9965e-7
    let expected_sun = 2.898 * pow(10.0, 0.0 - 3.0) / 5800.0
    ck_rel("wien(5800K)", lam_sun, expected_sun, 0.001)
    // Verify it is in the visible range: ~400-700nm = 4e-7 to 7e-7
    let nm400 = 4.0 * pow(10.0, 0.0 - 7.0)
    let nm700 = 7.0 * pow(10.0, 0.0 - 7.0)
    if lam_sun < nm400 or lam_sun > nm700
        print("FAIL blackbody wien(5800K) out of visible range: " + str(lam_sun))
        exit(1)

    // T=3000 K (incandescent bulb) -> ~9.66e-7 (near-IR)
    let lam_3k = wien_peak_wavelength(3000.0)
    let expected_3k = 2.898 * pow(10.0, 0.0 - 3.0) / 3000.0
    ck_rel("wien(3000K)", lam_3k, expected_3k, 0.001)

    // T=300 K (room temperature) -> ~9.66e-6 (mid-IR)
    let lam_300 = wien_peak_wavelength(300.0)
    let expected_300 = 2.898 * pow(10.0, 0.0 - 3.0) / 300.0
    ck_rel("wien(300K)", lam_300, expected_300, 0.001)

    // stefan_boltzmann_power: j = sigma * T^4
    // T=1 K -> j = 5.67e-8
    let sb1 = stefan_boltzmann_power(1.0)
    let sigma = 5.67 * pow(10.0, 0.0 - 8.0)
    ck_rel("stefan(1K)", sb1, sigma, 0.001)

    // T=2 K -> j = 5.67e-8 * 16 = 9.072e-7
    let sb2 = stefan_boltzmann_power(2.0)
    let expected_2k = sigma * 16.0
    ck_rel("stefan(2K)", sb2, expected_2k, 0.001)

    // T=300 K (room temp) -> j = sigma * 300^4 = sigma * 8.1e9
    let sb300 = stefan_boltzmann_power(300.0)
    let expected_300k = sigma * pow(300.0, 4.0)
    ck_rel("stefan(300K)", sb300, expected_300k, 0.001)

    // Power scales as T^4: doubling T -> 16x power
    // stefan(2T) / stefan(T) = 16
    let sb_base = stefan_boltzmann_power(100.0)
    let sb_dbl = stefan_boltzmann_power(200.0)
    // ratio should be 16
    let ratio = sb_dbl / sb_base
    if not approx_rel(ratio, 16.0, 0.001)
        print("FAIL blackbody T^4 scaling: ratio=" + str(ratio) + " want 16.0")
        exit(1)

    // radiated_power: P = e * sigma * A * T^4
    // e=1.0, A=1.0, T=1.0 -> P = sigma
    let rp1 = radiated_power(1.0, 1.0, 1.0)
    ck_rel("radiated_power(1,1,1)", rp1, sigma, 0.001)

    // e=0.5, A=2.0, T=300K -> P = 0.5 * sigma * 2 * 300^4 = sigma * 300^4
    let rp2 = radiated_power(0.5, 2.0, 300.0)
    ck_rel("radiated_power(0.5,2,300)", rp2, expected_300k, 0.001)

    // e=0.8, A=10.0, T=500K -> P = 0.8 * sigma * 10 * 500^4
    let rp3 = radiated_power(0.8, 10.0, 500.0)
    let expected_rp3 = 0.8 * sigma * 10.0 * pow(500.0, 4.0)
    ck_rel("radiated_power(0.8,10,500)", rp3, expected_rp3, 0.001)

    print("PASS _blackbody_test")
