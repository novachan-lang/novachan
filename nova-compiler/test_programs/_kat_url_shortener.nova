import forge_url_shortener

fn main()
    let u = us_new()
    u = us_shorten(u, "https://example.com/very/long/path")
    u = us_shorten(u, "https://other.com/page")
    assert(us_count(u) == 2, "2 urls")

    let c1 = us_get_code(u, "https://example.com/very/long/path")
    assert(is_ok(c1), "got code")
    let code = unwrap(c1)

    let r1 = us_resolve(u, code)
    assert(is_ok(r1), "resolve ok")
    assert(unwrap(r1) == "https://example.com/very/long/path", "correct url")

    let r2 = us_resolve(u, "zzz999")
    assert(is_err(r2), "unknown code")

    let r3 = us_get_code(u, "https://nope.com")
    assert(is_err(r3), "url not shortened")

    u = us_shorten(u, "https://example.com/very/long/path")
    assert(us_count(u) == 2, "dedup same url")

    print("URL-SHORTENER KAT PASS")
