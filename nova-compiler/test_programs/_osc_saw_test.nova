// KAT test for std/audio/osc_saw.nova
import std/audio/osc_saw

fn approx(a: float, b: float, tol: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    let result = d < tol
    result

fn main()
    // KAT 1: osc_saw(0.0) == -1.0
    let s0 = osc_saw(0.0)
    if approx(s0, -1.0, 0.0001) != true
        print("FAIL osc_saw(0.0): got=" + str(s0) + " want=-1.0")
        exit(1)

    // KAT 2: osc_saw(0.5) == 0.0
    let s50 = osc_saw(0.5)
    if approx(s50, 0.0, 0.0001) != true
        print("FAIL osc_saw(0.5): got=" + str(s50) + " want=0.0")
        exit(1)

    // KAT 3: osc_saw(0.999) ~ 0.998 (tolerance 0.01)
    let s999 = osc_saw(0.999)
    if approx(s999, 0.998, 0.01) != true
        print("FAIL osc_saw(0.999): got=" + str(s999) + " want~0.998")
        exit(1)

    // KAT 4: osc_saw(0.25) == -0.5
    let s25 = osc_saw(0.25)
    if approx(s25, -0.5, 0.0001) != true
        print("FAIL osc_saw(0.25): got=" + str(s25) + " want=-0.5")
        exit(1)

    // KAT 5: osc_saw(0.75) == 0.5
    let s75 = osc_saw(0.75)
    if approx(s75, 0.5, 0.0001) != true
        print("FAIL osc_saw(0.75): got=" + str(s75) + " want=0.5")
        exit(1)

    // KAT 6: osc_saw(1.0) == 1.0 (top of ramp before next reset)
    let s100 = osc_saw(1.0)
    if approx(s100, 1.0, 0.0001) != true
        print("FAIL osc_saw(1.0): got=" + str(s100) + " want=1.0")
        exit(1)

    // KAT 7: monotone — osc_saw(0.3) > osc_saw(0.1)
    let s30 = osc_saw(0.3)
    let s10 = osc_saw(0.1)
    if s30 < s10
        print("FAIL osc_saw monotone: saw(0.3)=" + str(s30) + " < saw(0.1)=" + str(s10))
        exit(1)

    print("PASS _osc_saw_test")
