// KAT for std/physics/electrostatics — Coulomb's law and related formulas.
import std/physics/electrostatics

// approx — absolute float equality within 0.001 tolerance.
fn approx(a, b)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < 0.001

// approx_rel — relative tolerance: |a-b|/|b| < tol
fn approx_rel(a, b, tol)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    let babs = b
    if babs < 0.0
        babs = 0.0 - babs
    let ratio = d / babs
    return ratio < tol

fn main()
    // KAT 1: k() ~ 8.99e9 (just verify it is positive and large)
    let kval = k()
    let kexpected = 8.99 * pow(10.0, 9.0)
    if not approx_rel(kval, kexpected, 0.001)
        print("FAIL electrostatics k(): got=" + str(kval))
        exit(1)

    // KAT 2: coulomb_force(1.0, 1.0, 1.0) = k() * 1 * 1 / 1^2 = k()
    // Use relative tolerance: force / k() should be ~1.0
    let force = coulomb_force(1.0, 1.0, 1.0)
    let ratio = force / kval
    if not approx(ratio, 1.0)
        print("FAIL electrostatics coulomb_force ratio: got=" + str(ratio) + " want~1.0")
        exit(1)

    // KAT 3: capacitance(10.0, 5.0) = 2.0
    let cap = capacitance(10.0, 5.0)
    if not approx(cap, 2.0)
        print("FAIL electrostatics capacitance(10,5): got=" + str(cap) + " want=2.0")
        exit(1)

    // KAT 4: capacitance(0.0, 5.0) = 0.0
    let cap0 = capacitance(0.0, 5.0)
    if not approx(cap0, 0.0)
        print("FAIL electrostatics capacitance(0,5): got=" + str(cap0) + " want=0.0")
        exit(1)

    // KAT 5: electric_field(q, r) * r == electric_potential(q, r)
    // E = k*q/r^2, V = k*q/r => E * r = k*q/r = V
    let q = 2.0
    let r = 3.0
    let ef = electric_field(q, r)
    let ep = electric_potential(q, r)
    let ef_times_r = ef * r
    if not approx_rel(ef_times_r, ep, 0.001)
        print("FAIL electrostatics E*r==V: ef*r=" + str(ef_times_r) + " ep=" + str(ep))
        exit(1)

    // KAT 6: electric_potential(1.0, 1.0) = k()
    let vp = electric_potential(1.0, 1.0)
    let vp_ratio = vp / kval
    if not approx(vp_ratio, 1.0)
        print("FAIL electrostatics electric_potential(1,1)/k: got=" + str(vp_ratio) + " want~1.0")
        exit(1)

    // KAT 7: coulomb_force sign — opposite charges attract (negative force)
    let fattr = coulomb_force(1.0, 0.0 - 1.0, 1.0)
    if fattr > 0.0
        print("FAIL electrostatics coulomb_force sign: opposite charges should give negative force")
        exit(1)

    // KAT 8: coulomb_force scales as 1/r^2 — doubling r quarters the force
    let f1 = coulomb_force(1.0, 1.0, 1.0)
    let f2 = coulomb_force(1.0, 1.0, 2.0)
    let scale = f1 / f2
    if not approx(scale, 4.0)
        print("FAIL electrostatics 1/r^2 scaling: f1/f2=" + str(scale) + " want=4.0")
        exit(1)

    print("PASS _electrostatics_test")
