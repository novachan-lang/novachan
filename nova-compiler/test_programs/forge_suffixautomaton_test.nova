import forge_suffixautomaton as sam

fn check(cond: bool, label: str)
    if cond == false
        print("FAIL: " + label)

// Brute-force: count distinct non-empty substrings of s
fn brute_distinct(s: str) -> int
    let n = len(s)
    let seen = {}
    let i = 0
    while i < n
        let j = i + 1
        while j <= n
            let sub = slice(s, i, j)
            seen[sub] = 1
            j = j + 1
        i = i + 1
    return len(keys(seen))

// Brute-force: is p a substring of s?
fn brute_contains(s: str, p: str) -> bool
    let n = len(s)
    let m = len(p)
    if m == 0
        return true
    let i = 0
    while i + m <= n
        if slice(s, i, i + m) == p
            return true
        i = i + 1
    return false

// Brute-force longest common substring
fn brute_lcs(s: str, t: str) -> str
    let n = len(s)
    let best = ""
    let i = 0
    while i < n
        let j = i + 1
        while j <= n
            let sub = slice(s, i, j)
            if len(sub) > len(best)
                if brute_contains(t, sub)
                    best = sub
            j = j + 1
        i = i + 1
    return best

// TEST 1: basic build and contains
let a = sam.sam_build("abcbc")
check(sam.sam_contains(a, "abc"), "contains abc")
check(sam.sam_contains(a, "bcbc"), "contains bcbc")
check(sam.sam_contains(a, "cbc"), "contains cbc")
check(sam.sam_contains(a, "abcbc"), "contains whole string")
check(sam.sam_contains(a, "") == true, "contains empty")
check(sam.sam_contains(a, "abd") == false, "not contains abd")
check(sam.sam_contains(a, "cc") == false, "not contains cc")
check(sam.sam_contains(a, "xyz") == false, "not contains xyz")

// TEST 2: distinct substrings count
// "abcbc": substrings: a,b,c,ab,bc,cb,abc,bcb,cbc,abcb,bcbc,abcbc = let's compute by brute
let expected_distinct = brute_distinct("abcbc")
check(sam.sam_num_distinct_substrings(a) == expected_distinct, "distinct count matches brute for abcbc")

// TEST 3: known distinct-substring values
// "aaa" has substrings a, aa, aaa = 3 distinct
let s_aaa = sam.sam_build("aaa")
check(sam.sam_num_distinct_substrings(s_aaa) == 3, "aaa has 3 distinct substrings")
// "abc" has a,b,c,ab,bc,abc = 6 distinct
let s_abc = sam.sam_build("abc")
check(sam.sam_num_distinct_substrings(s_abc) == 6, "abc has 6 distinct substrings")
// "abab" has a,b,ab,ba,aba,bab,abab = 7 distinct
let s_abab = sam.sam_build("abab")
check(sam.sam_num_distinct_substrings(s_abab) == 7, "abab has 7 distinct substrings")

// TEST 4: state count bound (<= 2n-1 for n>=2)
check(sam.sam_num_states(a) <= 2 * 5 - 1, "abcbc states <= 2n-1")
check(sam.sam_num_states(s_abab) <= 2 * 4 - 1, "abab states <= 2n-1")

// TEST 5: longest common substring
let lcs1 = sam.sam_longest_common_substring("abcde", "xbcdy")
check(lcs1 == "bcd", "LCS(abcde, xbcdy) = bcd")
let lcs2 = sam.sam_longest_common_substring("hello", "world")
// common substrings: 'l','o'; longest is 'l' or 'o' (length 1). "lo" is in hello but not world.
// hello has 'l','lo'? world has 'l','o' but not adjacent lo. So LCS length 1.
check(len(lcs2) == 1, "LCS(hello, world) length 1")
let lcs3 = sam.sam_longest_common_substring("programming", "gaming")
// "ming" is in programming (...ming) and gaming (...ming) -> "ming" length 4
check(lcs3 == "ming", "LCS(programming, gaming) = ming")

// TEST 6: DECISIVE brute-force cross-check on many strings
let strings = ["aab", "abcabc", "banana", "mississippi", "aaaa", "abcba", "xyzzy", "aabbaabb", "racecar"]
let ok_distinct = true
let ok_contains = true
let si = 0
while si < len(strings)
    let s = strings[si]
    let sm = sam.sam_build(s)
    // distinct substrings
    let exp_d = brute_distinct(s)
    let got_d = sam.sam_num_distinct_substrings(sm)
    if exp_d != got_d
        ok_distinct = false
        print("DISTINCT MISMATCH s=" + s + " exp=" + str(exp_d) + " got=" + str(got_d))
    // state bound
    let ns = len(s)
    if ns >= 2
        if sam.sam_num_states(sm) > 2 * ns - 1
            print("STATE BOUND VIOLATED s=" + s)
    si = si + 1
check(ok_distinct, "DECISIVE: distinct-substring count matches brute for all test strings")

// TEST 7: DECISIVE contains cross-check: for each string, test many candidate substrings
let base = "abracadabra"
let sm_base = sam.sam_build(base)
let candidates = ["abra", "cada", "dab", "bra", "aca", "xyz", "abrc", "ra", "a", "abracadabra", "bracadabr", "racadabraa"]
let ci = 0
while ci < len(candidates)
    let p = candidates[ci]
    let exp_c = brute_contains(base, p)
    let got_c = sam.sam_contains(sm_base, p)
    if exp_c != got_c
        ok_contains = false
        print("CONTAINS MISMATCH p=" + p + " exp=" + str(exp_c) + " got=" + str(got_c))
    ci = ci + 1
check(ok_contains, "DECISIVE: contains matches brute for all candidates on abracadabra")

// TEST 8: DECISIVE LCS cross-check
let pairs_s = ["abcde", "hello", "programming", "banana", "aaabbb"]
let pairs_t = ["xbcdy", "world", "gaming", "ananas", "bbbaaa"]
let ok_lcs = true
let pi = 0
while pi < len(pairs_s)
    let exp_lcs = brute_lcs(pairs_s[pi], pairs_t[pi])
    let got_lcs = sam.sam_longest_common_substring(pairs_s[pi], pairs_t[pi])
    // Compare LENGTHS (there can be multiple valid LCS of same length)
    if len(exp_lcs) != len(got_lcs)
        ok_lcs = false
        print("LCS LEN MISMATCH s=" + pairs_s[pi] + " t=" + pairs_t[pi] + " exp_len=" + str(len(exp_lcs)) + " got=" + got_lcs)
    else
        // verify got_lcs is actually a common substring
        if len(got_lcs) > 0
            if brute_contains(pairs_s[pi], got_lcs) == false or brute_contains(pairs_t[pi], got_lcs) == false
                ok_lcs = false
                print("LCS NOT COMMON s=" + pairs_s[pi] + " got=" + got_lcs)
    pi = pi + 1
check(ok_lcs, "DECISIVE: LCS length matches brute AND result is a real common substring")

print("forge_suffixautomaton: KAT done")
