import forge_skip_list

fn main()
    let s = sl_new()
    s = sl_insert(s, 30, "thirty")
    s = sl_insert(s, 10, "ten")
    s = sl_insert(s, 20, "twenty")
    assert(sl_count(s) == 3, "3 items")
    assert(sl_min_key(s) == 10, "min 10")
    assert(sl_max_key(s) == 30, "max 30")

    let r1 = sl_search(s, 20)
    assert(r1["found"] == 1, "found 20")
    assert(r1["value"] == "twenty", "twenty")

    let r2 = sl_search(s, 25)
    assert(r2["found"] == 0, "not found 25")

    s = sl_insert(s, 20, "TWENTY")
    assert(sl_count(s) == 3, "update not insert")
    let r3 = sl_search(s, 20)
    assert(r3["value"] == "TWENTY", "updated")

    s = sl_remove(s, 10)
    assert(sl_count(s) == 2, "2 after remove")
    assert(sl_min_key(s) == 20, "new min 20")

    print("SKIP-LIST KAT PASS")
