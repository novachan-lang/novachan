import std/gametheory/minimax

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _minimax_test " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gs = "false"
    if got
        gs = "true"
    let ws = "false"
    if want
        ws = "true"
    if got != want
        print("FAIL _minimax_test " + label + ": got " + gs + " want " + ws)
        exit(1)

fn ckl(label: string, got, want)
    let gl = len(got)
    let wl = len(want)
    if gl != wl
        print("FAIL _minimax_test " + label + " len: got " + str(gl) + " want " + str(wl))
        exit(1)
    let i = 0
    while i < gl
        if got[i] != want[i]
            print("FAIL _minimax_test " + label + "[" + str(i) + "]: got " + str(got[i]) + " want " + str(want[i]))
            exit(1)
        i = i + 1

// Build a 2-element list
fn mk2(a, b) -> list
    let xs = []
    push(xs, a)
    push(xs, b)
    xs

// Build a 3-element list
fn mk3(a, b, c) -> list
    let xs = []
    push(xs, a)
    push(xs, b)
    push(xs, c)
    xs

fn main()
    // KAT: leaf
    cki("value(5)", mm_value(5), 5)
    cki("value_min(5)", mm_value_min(5), 5)

    // KAT: mm_value([[3,5],[2,9],[0,1]]) = 3
    // Root=MAX; children are MIN nodes.
    // min(3,5)=3, min(2,9)=2, min(0,1)=0; max(3,2,0)=3.
    let n1 = mk2(3, 5)
    let n2 = mk2(2, 9)
    let n3 = mk2(0, 1)
    let t1 = mk3(n1, n2, n3)
    cki("value([[3,5],[2,9],[0,1]])", mm_value(t1), 3)

    // KAT: mm_value([[3,12,8],[2,4,6],[14,5,2]]) = 3
    // Root=MAX; children MIN: min(3,12,8)=3, min(2,4,6)=2, min(14,5,2)=2; max=3.
    let na = mk3(3, 12, 8)
    let nb = mk3(2, 4, 6)
    let nc = mk3(14, 5, 2)
    let t2 = mk3(na, nb, nc)
    cki("value([[3,12,8],[2,4,6],[14,5,2]])", mm_value(t2), 3)

    // KAT: mm_value_min([[3,12,8],[2,4,6],[14,5,2]]) = 6
    // Root=MIN; children MAX: max(3,12,8)=12, max(2,4,6)=6, max(14,5,2)=14; min=6.
    let na2 = mk3(3, 12, 8)
    let nb2 = mk3(2, 4, 6)
    let nc2 = mk3(14, 5, 2)
    let t3 = mk3(na2, nb2, nc2)
    cki("value_min([[3,12,8],[2,4,6],[14,5,2]])", mm_value_min(t3), 6)

    // Edge: single-child internal node
    let leaf7 = 7
    let wrap = mk2(3, leaf7)
    // root=MAX, children are leaves 3 and 7 -> max=7
    cki("value([3,7])", mm_value(wrap), 7)
    cki("value_min([3,7])", mm_value_min(wrap), 3)

    // Deeper tree: 3 levels (MAX -> MIN -> MAX -> leaf)
    // Tree: [[[ 1, 2 ], [ 3, 4 ]], [[ 5, 6 ], [ 7, 8 ]]]
    // Leaves -> MAX lvl2: max(1,2)=2, max(3,4)=4, max(5,6)=6, max(7,8)=8
    // MIN lvl1: min(2,4)=2, min(6,8)=6
    // MAX root: max(2,6)=6
    let l12 = mk2(1, 2)
    let l34 = mk2(3, 4)
    let l56 = mk2(5, 6)
    let l78 = mk2(7, 8)
    let m1 = mk2(l12, l34)
    let m2 = mk2(l56, l78)
    let deep = mk2(m1, m2)
    cki("deep 3-level max-root", mm_value(deep), 6)

    print("PASS _minimax_test")
