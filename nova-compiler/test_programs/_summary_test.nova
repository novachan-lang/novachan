import std/math/summary

// Known-answer test for std/math/summary.
// Hand-computed values for xs = [1,2,3,4,5,6,7,8,9] (n=9):
//   sorted = [1,2,3,4,5,6,7,8,9]
//   Q1:  rank = 0.25 * 8 = 2.0  -> lo_i=2, frac=0.0 -> s[2]=3.0
//   med: rank = 0.50 * 8 = 4.0  -> lo_i=4, frac=0.0 -> s[4]=5.0
//   Q3:  rank = 0.75 * 8 = 6.0  -> lo_i=6, frac=0.0 -> s[6]=7.0
//   five_number = [1.0, 3.0, 5.0, 7.0, 9.0]
//   range     = 9.0 - 1.0 = 8.0
//   midrange  = (1.0 + 9.0) / 2.0 = 5.0

fn ckf(label: str, got: float, want: float)
    let diff = got - want
    if diff < 0.0
        diff = 0.0 - diff
    if diff > 0.001
        print("FAIL " + label + " got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    let xs = [1, 2, 3, 4, 5, 6, 7, 8, 9]

    // --- sm_five_number ---
    let fn_res = sm_five_number(xs)
    ckf("five_number[0] min",    fn_res[0] * 1.0, 1.0)
    ckf("five_number[1] q1",     fn_res[1] * 1.0, 3.0)
    ckf("five_number[2] median", fn_res[2] * 1.0, 5.0)
    ckf("five_number[3] q3",     fn_res[3] * 1.0, 7.0)
    ckf("five_number[4] max",    fn_res[4] * 1.0, 9.0)

    // --- sm_range ---
    let rng = sm_range(xs)
    ckf("sm_range", rng, 8.0)

    // --- sm_midrange ---
    let mid = sm_midrange(xs)
    ckf("sm_midrange", mid, 5.0)

    // --- sm_min on [3,1,2] ---
    let small = [3, 1, 2]
    let mn = sm_min(small)
    ckf("sm_min [3,1,2]", mn, 1.0)

    // --- sm_max on [3,1,2] ---
    let mx = sm_max(small)
    ckf("sm_max [3,1,2]", mx, 3.0)

    // --- empty list edge cases (should return 0.0, not crash) ---
    let empty = []
    ckf("sm_min empty",      sm_min(empty),      0.0)
    ckf("sm_max empty",      sm_max(empty),      0.0)
    ckf("sm_range empty",    sm_range(empty),    0.0)
    ckf("sm_midrange empty", sm_midrange(empty), 0.0)

    // --- single element list ---
    let one = [7]
    let fn_one = sm_five_number(one)
    ckf("five_number single[0]", fn_one[0] * 1.0, 7.0)
    ckf("five_number single[4]", fn_one[4] * 1.0, 7.0)
    ckf("sm_range single",  sm_range(one),  0.0)

    print("_summary_test passed")
