fn div_one(x: int) -> int
    x / 1

fn mod_one(x: int) -> int
    x % 1

fn div_const(a: int, b: int) -> int
    10 / 2

fn mod_const(a: int, b: int) -> int
    17 % 5

assert(div_one(42) == 42, "x / 1 == x")
assert(div_one(-7) == -7, "negative x / 1")
assert(div_one(0) == 0, "0 / 1 == 0")
assert(mod_one(42) == 0, "x % 1 == 0")
assert(mod_one(-7) == 0, "negative x % 1")
assert(mod_one(0) == 0, "0 % 1 == 0")
assert(div_const(0, 0) == 5, "10 / 2 folded")
assert(mod_const(0, 0) == 2, "17 % 5 folded")
assert(100 / 1 == 100, "literal / 1")
assert(99 % 1 == 0, "literal % 1")
assert(15 / 3 == 5, "constant fold div")
assert(15 % 4 == 3, "constant fold mod")
print("all div/mod strength tests passed")
