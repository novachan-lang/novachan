// Framework v0.2 smoke test: exercise the new function in each of the
// nine first-party framework modules and verify the result.

import forge
import cortex
import pulse
import mesh
import sentinel
import ops
import reactor
import prism
import edge

fn double_int(x: int) -> int
    x + x

fn tick(s: list) -> list
    let nxt = []
    for v in s
        nxt.push(v + 1)
    nxt

fn main()
    // ---- 1. Forge v0.2: status helpers + CORS ----
    let r = forge.ok_text("hello")
    assert_eq(find(r, "200"), 9)             // "HTTP/1.1 200 OK"
    let cr = forge.with_cors(r, "*")
    if find(cr, "Access-Control-Allow-Origin: *") < 0
        print("FAIL forge: CORS header missing")
        exit(1)

    // ---- 2. Cortex v0.2: confidence_scores + top_k ----
    // W is [in_dim=2, num_classes=3] so matmul(x, W) gives 3 logits.
    let w = tensor_from_list([1.0, 2.0, 0.0,    0.0, 1.0, 1.0], [2, 3])
    let x = tensor_from_list([1.0, 2.0], [1, 2])
    let probs = cortex.confidence_scores(w, x)
    assert_eq(len(probs), 3)
    let tk = cortex.top_k(w, x, 2)
    assert_eq(len(tk), 2)

    // ---- 3. Pulse v0.2: distinct + join ----
    let rows = []
    rows.push(["west", "apple", "100"])
    rows.push(["east", "apple", "200"])
    rows.push(["west", "banana", "150"])
    rows.push(["east", "banana", "175"])
    let regions = pulse.distinct(rows, 0)
    assert_eq(len(regions), 2)            // west, east

    let prices = []
    prices.push(["apple", "1.50"])
    prices.push(["banana", "0.50"])
    let joined = pulse.join_on(rows, prices, 1, 0)
    assert_eq(len(joined), 4)

    let groups = pulse.group_by(rows, 0)
    let means = pulse.agg_mean(groups, 2)
    // west: (100+150)/2 = 125, east: (200+175)/2 = 187.5
    assert_near(means["west"], 125.0, 0.001)
    assert_near(means["east"], 187.5, 0.001)

    // ---- 4. Mesh v0.2: parallel_map_int + chunked_for_each ----
    let mapped = mesh.parallel_map_int([1, 2, 3, 4, 5], double_int)
    assert_eq(mapped[0], 2)
    assert_eq(mapped[4], 10)

    // ---- 5. Sentinel v0.2: constant_time_eq + hmac_sha256 + api_token ----
    let same = sentinel.constant_time_eq("hello", "hello")
    let diff = sentinel.constant_time_eq("hello", "world")
    if not same
        print("FAIL sentinel: constant_time_eq(equal)")
        exit(1)
    if diff
        print("FAIL sentinel: constant_time_eq(diff)")
        exit(1)

    let mac = sentinel.hmac_sha256("secret-key", "hello world")
    assert_eq(len(mac), 64)                 // SHA-256 hex digest

    let tok = sentinel.api_token()
    if len(tok) < 2 or len(tok) > 64
        print("FAIL sentinel: api_token length unexpected")
        exit(1)

    // ---- 6. Ops v0.2: railway/fly/systemd/prometheus ----
    let rwy = ops.railway_config("myapp", 8080)
    if find(rwy, "PORT = \"8080\"") < 0
        print("FAIL ops: railway port")
        exit(1)
    let su = ops.systemd_unit("myapp", "/opt/myapp/myapp", "nova")
    if find(su, "ExecStart=/opt/myapp/myapp") < 0
        print("FAIL ops: systemd ExecStart")
        exit(1)
    let pg = ops.prometheus_gauge("request_count", 42.0, "Number of requests")
    if find(pg, "request_count 42") < 0
        print("FAIL ops: prometheus_gauge")
        exit(1)

    // ---- 7. Reactor v0.2: benchmark + fps_estimate ----
    let start = []
    start.push(1)
    start.push(2)
    start.push(3)
    let r2 = reactor.benchmark(start, tick, 100)
    let final = r2[0]
    assert_eq(final[0], 101)                // initial 1 + 100 ticks
    let fps = reactor.fps_estimate(100, 50)
    assert_eq(fps, 2000)                    // 100 frames / 0.05s = 2000 fps

    // ---- 8. Prism v0.2: hline + progress_bar + bold ----
    let line = prism.hline(10, "-")
    assert_eq(line, "----------")
    let pb = prism.progress_bar(50, 10)
    if find(pb, "50%") < 0
        print("FAIL prism: progress_bar percent")
        exit(1)
    let b = prism.bold("hello")
    if find(b, "hello") < 0
        print("FAIL prism: bold inner")
        exit(1)

    // ---- 9. Edge v0.2: base64 + crc16 + be_u32 ----
    let b64 = edge.base64_encode([72, 101, 108, 108, 111])
    assert_eq(b64, "SGVsbG8=")              // "Hello"
    let crc = edge.crc16([49, 50, 51, 52, 53, 54, 55, 56, 57])  // "123456789"
    assert_eq(crc, 10673)                    // 0x29B1, the canonical CCITT-FALSE test vector
    let val = edge.be_u32(255, 0, 0, 1)
    assert_eq(val, 4278190081)               // 0xFF000001

    print("FRAMEWORKS v0.2 DEMO PASSED: 9 frameworks, every new v0.2 function exercised")
