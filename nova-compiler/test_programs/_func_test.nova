// KAT for std/functional/func — function combinators
import std/functional/func

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn inc(x) x + 1
fn double(x) x * 2
fn square(x) x * x

fn main()
    // --- f_identity ---
    cki("identity(0)", f_identity(0), 0)
    cki("identity(77)", f_identity(77), 77)
    cki("identity(-5)", f_identity(-5), -5)

    // --- f_compose(f, g) = fn(x) f(g(x)) : right-to-left ---
    let compose_inc_double = f_compose(inc, double)
    // inc(double(3)) = inc(6) = 7
    cki("compose(inc,double)(3)", compose_inc_double(3), 7)
    // inc(double(0)) = inc(0) = 1
    cki("compose(inc,double)(0)", compose_inc_double(0), 1)

    let compose_double_inc = f_compose(double, inc)
    // double(inc(3)) = double(4) = 8
    cki("compose(double,inc)(3)", compose_double_inc(3), 8)

    let compose_sq_double = f_compose(square, double)
    // square(double(3)) = square(6) = 36
    cki("compose(sq,double)(3)", compose_sq_double(3), 36)

    // --- f_pipe2(f, g) = fn(x) g(f(x)) : left-to-right ---
    let pipe_double_inc = f_pipe2(double, inc)
    // inc(double(3)) = inc(6) = 7  (same as compose(inc,double))
    cki("pipe2(double,inc)(3)", pipe_double_inc(3), 7)

    let pipe_inc_double = f_pipe2(inc, double)
    // double(inc(3)) = double(4) = 8
    cki("pipe2(inc,double)(3)", pipe_inc_double(3), 8)

    // --- f_const ---
    let always9 = f_const(9)
    cki("const(9)(123)", always9(123), 9)
    cki("const(9)(0)", always9(0), 9)
    cki("const(9)(-999)", always9(-999), 9)

    let always0 = f_const(0)
    cki("const(0)(42)", always0(42), 0)

    // --- f_apply_n ---
    // apply inc 5 times starting from 0: 0->1->2->3->4->5
    cki("apply_n(inc,0,5)", f_apply_n(inc, 0, 5), 5)
    // apply double 4 times starting from 1: 1->2->4->8->16
    cki("apply_n(double,1,4)", f_apply_n(double, 1, 4), 16)
    // n=0 returns x unchanged
    cki("apply_n(inc,10,0)", f_apply_n(inc, 10, 0), 10)
    // n=1 applies once
    cki("apply_n(square,3,1)", f_apply_n(square, 3, 1), 9)
    // apply inc 100 times from 0 = 100
    cki("apply_n(inc,0,100)", f_apply_n(inc, 0, 100), 100)

    // --- f_memoize1 ---
    // Memoize double: should give same results as direct call
    let memo_double = f_memoize1(double)
    cki("memo_double(5)", memo_double(5), 10)
    cki("memo_double(5) again", memo_double(5), 10)
    cki("memo_double(7)", memo_double(7), 14)
    cki("memo_double(0)", memo_double(0), 0)

    // Memoize a more expensive-looking computation: square
    let memo_sq = f_memoize1(square)
    cki("memo_sq(9)", memo_sq(9), 81)
    cki("memo_sq(9) again", memo_sq(9), 81)
    cki("memo_sq(12)", memo_sq(12), 144)
    // Different memo instances are independent
    cki("memo_double(3) independent", memo_double(3), 6)

    // --- compose chain: inc . double . inc ---
    let inc_double = f_compose(double, inc)
    let triple_chain = f_compose(inc, inc_double)
    // inc(double(inc(4))) = inc(double(5)) = inc(10) = 11
    cki("compose chain(4)", triple_chain(4), 11)

    print("_func_test passed")

main()
