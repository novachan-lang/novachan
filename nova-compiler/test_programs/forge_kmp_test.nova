import forge_kmp

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // first-occurrence search
    fails = fails + expect("basic", str(kmp_search("abxabcabcaby", "abcaby")), "6")
    fails = fails + expect("absent", str(kmp_search("hello world", "xyz")), "-1")
    fails = fails + expect("at0", str(kmp_search("abcdef", "abc")), "0")
    fails = fails + expect("atend", str(kmp_search("abcdef", "def")), "3")
    fails = fails + expect("empty_pat", str(kmp_search("abc", "")), "0")
    fails = fails + expect("single", str(kmp_search("aaaaa", "a")), "0")
    fails = fails + expect("full", str(kmp_search("abc", "abc")), "0")
    fails = fails + expect("longer_pat", str(kmp_search("abc", "abcd")), "-1")

    // all occurrences (overlapping)
    fails = fails + expect("all_aa", join_str(map_str(kmp_find_all("aaaa", "aa")), ","), "0,1,2")
    fails = fails + expect("all_ana", join_str(map_str(kmp_find_all("banana", "ana")), ","), "1,3")
    fails = fails + expect("count_aa", str(kmp_count("aaaa", "aa")), "3")
    fails = fails + expect("count_none", str(kmp_count("abcabc", "xy")), "0")
    fails = fails + expect("count_abc", str(kmp_count("abcabcabc", "abc")), "3")

    // failure table  pattern "ababaca" -> [0,0,1,2,3,0,1]
    fails = fails + expect("fail_tbl", join_str(map_str(kmp_failure("ababaca")), ","), "0,0,1,2,3,0,1")
    // "aaaa" -> [0,1,2,3]
    fails = fails + expect("fail_aaaa", join_str(map_str(kmp_failure("aaaa")), ","), "0,1,2,3")

    // shortest period
    fails = fails + expect("period_abc", str(kmp_period("abcabcabc")), "3")
    fails = fails + expect("period_none", str(kmp_period("abcd")), "4")
    fails = fails + expect("period_aa", str(kmp_period("aaaa")), "1")
    fails = fails + expect("period_abab", str(kmp_period("abab")), "2")

    if fails == 0
        print("forge_kmp: all passed")
    else
        print("forge_kmp: " + str(fails) + " FAILED")

fn map_str(xs: list) -> list
    let out = []
    let i = 0
    while i < len(xs)
        push(out, str(xs[i]))
        i = i + 1
    out

fn join_str(xs: list, sep: string) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + sep
        out = out + xs[i]
        i = i + 1
    out
