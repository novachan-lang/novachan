// Test: read_file + args + the self-hosted compiler's own lexer logic
// This tests the critical path for self-hosting: reading source files

let test_src = "let x = 42\nprint(x)\n"

// Simulate tokenization (from the self-hosted compiler)
type Token
    kind: string
    value: string

fn is_alpha_char(ch: string) -> bool
    let c = ord(ch)
    return (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or ch == "_"

fn is_digit_char(ch: string) -> bool
    let c = ord(ch)
    return c >= 48 and c <= 57

fn tokenize_simple(src: string) -> list
    let tokens = []
    let i = 0
    while i < len(src)
        let ch = src[i]
        if ch == " " or ch == "\t"
            i = i + 1
        else if ch == "\n"
            push(tokens, Token("NL", "\\n"))
            i = i + 1
        else if is_alpha_char(ch)
            let start = i
            while i < len(src) and (is_alpha_char(src[i]) or is_digit_char(src[i]))
                i = i + 1
            let word = ""
            let j = start
            while j < i
                word = word + src[j]
                j = j + 1
            push(tokens, Token("ID", word))
        else if is_digit_char(ch)
            let start = i
            while i < len(src) and is_digit_char(src[i])
                i = i + 1
            let num = ""
            let j = start
            while j < i
                num = num + src[j]
                j = j + 1
            push(tokens, Token("NUM", num))
        else if ch == "="
            push(tokens, Token("EQ", "="))
            i = i + 1
        else if ch == "("
            push(tokens, Token("LP", "("))
            i = i + 1
        else if ch == ")"
            push(tokens, Token("RP", ")"))
            i = i + 1
        else
            push(tokens, Token("?", ch))
            i = i + 1
    return tokens

let toks = tokenize_simple(test_src)
print(len(toks))
for t in toks
    match t
        Token(kind, value) =>
            print(kind + " " + value)
