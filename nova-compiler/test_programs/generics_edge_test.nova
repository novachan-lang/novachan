// ── NOVA Generics Edge Cases ────────────────────────────────

// Test 1: Generic enum (Option-like)
enum Option
    type Some
        value: int
    type None

let s = Some(42)
let n = None()
match s
    Some(v) => print(v)
    None() => print("none")

match n
    Some(v) => print(v)
    None() => print("none")

// Test 2: Deeply nested generic function calls
fn<T> add_one(x: T) -> T
    return x + 1

fn<T> apply3(f, x: T) -> T
    return f(f(f(x)))

print(apply3(add_one, 0))

// Test 3: Generic function with string operations
fn<T> to_string_list(xs: List<T>) -> list
    let result = []
    for x in xs
        push(result, str(x))
    return result

let sl = to_string_list([1, 2, 3])
print(sl[0])
print(sl[1])
print(sl[2])

// Test 4: Generic function returning boolean
fn<T> is_empty(xs: List<T>) -> bool
    return len(xs) == 0

print(is_empty([1, 2]))
print(is_empty([]))

// Test 5: Multiple generic structs in same program
type Triple<A, B, C>
    x: A
    y: B
    z: C

let t = Triple(1, "two", 3)
print(t.x)
print(t.y)
print(t.z)

// Test 6: Generic function with dict
fn<T> dict_get_or(d: dict, key: string, default_val: T) -> T
    if contains(d, key)
        return d[key]
    return default_val

let m = {"a": 1, "b": 2}
print(dict_get_or(m, "a", 0))
print(dict_get_or(m, "z", 999))

// Test 7: Generic with list of generic structs
type Wrapper<T>
    inner: T

let wrappers = [Wrapper(10), Wrapper(20), Wrapper(30)]
print(wrappers[0].inner)
print(wrappers[2].inner)

// Test 8: Generic compose
fn<A, B, C> compose(f, g)
    return fn(x) f(g(x))

let inc = fn(x) x + 1
let dbl = fn(x) x * 2
let inc_then_dbl = compose(dbl, inc)
print(inc_then_dbl(5))

// Expected output:
// 42
// none
// 3
// 1
// 2
// 3
// false
// true
// 1
// two
// 3
// 1
// 999
// 10
// 30
// 12
