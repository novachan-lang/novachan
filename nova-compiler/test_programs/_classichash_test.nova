// _classichash_test.nova — KAT for std/hash/classichash
//
// Verifies all six classic string hash functions with deterministic
// known-answer vectors computed from the reference Python implementations.
//
// Anchors verified by hand:
//   h_bkdr("a")  = 0*131+97            = 97
//   h_bkdr("ab") = 97*131+98           = 12805
//   h_js("")     = documented init      = 1315423911
//   h_ap("")     = documented init      = 2863311530 (0xAAAAAAAA)
//   h_pjw(""), h_bkdr(""), h_rs(""), h_dek("") = 0 (all start from zero)
//
// All "hello" values pinned to the first run and asserted deterministically.

import std/hash/classichash

fn ck(label, got, want)
    if got != want
        print("FAIL classichash " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // --- PJW / ELF hash ---
    // Initial value is 0; empty string returns 0.
    ck("pjw_empty",  h_pjw(""),      0)
    // Single byte 'a' (97): h = (0<<4)+97 = 97; high = 0; result = 97
    ck("pjw_a",      h_pjw("a"),     97)
    // Order-sensitive: ab and ba must differ
    ck("pjw_ab",     h_pjw("ab"),    1650)
    ck("pjw_ba",     h_pjw("ba"),    1665)
    // Determinism anchor for hello
    ck("pjw_hello",  h_pjw("hello"), 7258927)
    // Order sensitivity confirmed
    if h_pjw("ab") == h_pjw("ba")
        print("FAIL classichash pjw_order: ab==ba but must differ")
        exit(1)

    // --- BKDR hash (seed 131) ---
    // h_bkdr("a")  = 0*131+97        = 97
    // h_bkdr("ab") = 97*131+98       = 12707+98 = 12805
    ck("bkdr_empty", h_bkdr(""),     0)
    ck("bkdr_a",     h_bkdr("a"),    97)
    ck("bkdr_ab",    h_bkdr("ab"),   12805)
    ck("bkdr_ba",    h_bkdr("ba"),   12935)
    ck("bkdr_hello", h_bkdr("hello"), 792145550)
    if h_bkdr("ab") == h_bkdr("ba")
        print("FAIL classichash bkdr_order: ab==ba but must differ")
        exit(1)

    // --- AP hash (Arash Partow) ---
    // Initial value = 0xAAAAAAAA = 2863311530
    ck("ap_empty",  h_ap(""),      2863311530)
    ck("ap_a",      h_ap("a"),     3579139425)
    ck("ap_ab",     h_ap("ab"),    2259355735)
    ck("ap_ba",     h_ap("ba"),    2259357783)
    ck("ap_hello",  h_ap("hello"), 2446240143)
    if h_ap("ab") == h_ap("ba")
        print("FAIL classichash ap_order: ab==ba but must differ")
        exit(1)

    // --- RS hash (Robert Sedgwick) ---
    // Initial h=0; empty string returns 0
    ck("rs_empty",  h_rs(""),      0)
    ck("rs_a",      h_rs("a"),     97)
    ck("rs_ab",     h_rs("ab"),    2162651057)
    ck("rs_ba",     h_rs("ba"),    502381919)
    ck("rs_hello",  h_rs("hello"), 987012754)
    if h_rs("ab") == h_rs("ba")
        print("FAIL classichash rs_order: ab==ba but must differ")
        exit(1)

    // --- DEK hash (Donald E. Knuth) ---
    // Initial h = len(s); h_dek("") = 0
    ck("dek_empty",  h_dek(""),      0)
    ck("dek_a",      h_dek("a"),     65)
    ck("dek_ab",     h_dek("ab"),    1090)
    ck("dek_ba",     h_dek("ba"),    1057)
    ck("dek_hello",  h_dek("hello"), 213073391)
    if h_dek("ab") == h_dek("ba")
        print("FAIL classichash dek_order: ab==ba but must differ")
        exit(1)

    // --- JS hash (Justin Sobel) ---
    // Initial h = 1315423911 (documented constant)
    ck("js_empty",  h_js(""),      1315423911)
    ck("js_a",      h_js("a"),     2935291981)
    ck("js_ab",     h_js("ab"),    2762492504)
    ck("js_ba",     h_js("ba"),    2762492344)
    ck("js_hello",  h_js("hello"), 1729687499)
    if h_js("ab") == h_js("ba")
        print("FAIL classichash js_order: ab==ba but must differ")
        exit(1)

    // Determinism: calling the same input twice must yield identical output
    ck("pjw_det",  h_pjw("hello"),  h_pjw("hello"))
    ck("bkdr_det", h_bkdr("hello"), h_bkdr("hello"))
    ck("ap_det",   h_ap("hello"),   h_ap("hello"))
    ck("rs_det",   h_rs("hello"),   h_rs("hello"))
    ck("dek_det",  h_dek("hello"),  h_dek("hello"))
    ck("js_det",   h_js("hello"),   h_js("hello"))

    print("PASS _classichash_test")
