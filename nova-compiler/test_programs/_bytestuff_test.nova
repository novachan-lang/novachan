// KAT for std/framing/bytestuff — generic byte stuffing / escaping.
import std/framing/bytestuff

// ── Private list equality helper ──────────────────────────────────────────────

fn list_eq(a: list, b: list) -> int
    if len(a) != len(b)
        return 0
    let i = 0
    let ok = 1
    while i < len(a) and ok == 1
        if a[i] != b[i]
            ok = 0
        i = i + 1
    ok

// ── Assert helpers ─────────────────────────────────────────────────────────────

fn ck_list(label: string, got: list, want: list)
    let eq = list_eq(got, want)
    if eq != 1
        let gs = "["
        let wi = "["
        let i = 0
        while i < len(got)
            if i > 0
                gs = gs + ","
            gs = gs + str(got[i])
            i = i + 1
        gs = gs + "]"
        let j = 0
        while j < len(want)
            if j > 0
                wi = wi + ","
            wi = wi + str(want[j])
            j = j + 1
        wi = wi + "]"
        print("FAIL bytestuff " + label + ": got=" + gs + " want=" + wi)
        exit(1)

fn ck_int(label: string, got: int, want: int)
    if got != want
        print("FAIL bytestuff " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ── Canonical KAT vectors ─────────────────────────────────────────────────────

fn main()
    // KAT 1: bs_stuff([0x7E,1,2], 0x7E, 0x7D) == [0x7D, 0x5E, 1, 2]
    let v1 = []
    push(v1, 0x7E)
    push(v1, 1)
    push(v1, 2)
    let r1 = bs_stuff(v1, 0x7E, 0x7D)
    let w1 = []
    push(w1, 0x7D)
    push(w1, 0x5E)
    push(w1, 1)
    push(w1, 2)
    ck_list("stuff-7E-in-7E", r1, w1)

    // KAT 2: bs_stuff([0x7D], 0x7E, 0x7D) == [0x7D, 0x5D]
    // 0x7D XOR 0x20 = 0x5D
    let v2 = []
    push(v2, 0x7D)
    let r2 = bs_stuff(v2, 0x7E, 0x7D)
    let w2 = []
    push(w2, 0x7D)
    push(w2, 0x5D)
    ck_list("stuff-esc-byte", r2, w2)

    // KAT 3: bs_stuff([1,2,3], 0x7E, 0x7D) == [1,2,3] (no specials)
    let v3 = []
    push(v3, 1)
    push(v3, 2)
    push(v3, 3)
    let r3 = bs_stuff(v3, 0x7E, 0x7D)
    let w3 = []
    push(w3, 1)
    push(w3, 2)
    push(w3, 3)
    ck_list("stuff-no-special", r3, w3)

    // KAT 4: bs_escape_byte
    ck_int("escape-byte-7E", bs_escape_byte(0x7E, 0x7D), 0x5E)
    ck_int("escape-byte-7D", bs_escape_byte(0x7D, 0x7D), 0x5D)

    // ── ROUND-TRIP: bs_unstuff(bs_stuff(x, 0x7E, 0x7D), 0x7D) == x ─────────────

    // RT 1: mixed special bytes
    let rt1 = []
    push(rt1, 0x7E)
    push(rt1, 0x7D)
    push(rt1, 1)
    push(rt1, 2)
    let rt1_got = bs_unstuff(bs_stuff(rt1, 0x7E, 0x7D), 0x7D)
    ck_list("rt-specials", rt1_got, rt1)

    // RT 2: plain bytes
    let rt2 = []
    push(rt2, 1)
    push(rt2, 2)
    push(rt2, 3)
    let rt2_got = bs_unstuff(bs_stuff(rt2, 0x7E, 0x7D), 0x7D)
    ck_list("rt-plain", rt2_got, rt2)

    // RT 3: empty
    let rt3 = []
    let rt3_got = bs_unstuff(bs_stuff(rt3, 0x7E, 0x7D), 0x7D)
    ck_list("rt-empty", rt3_got, rt3)

    // RT 4: all delimiter bytes
    let rt4 = []
    push(rt4, 0x7E)
    push(rt4, 0x7E)
    push(rt4, 0x7E)
    let rt4_got = bs_unstuff(bs_stuff(rt4, 0x7E, 0x7D), 0x7D)
    ck_list("rt-all-delim", rt4_got, rt4)

    // RT 5: single 0x00
    let rt5 = []
    push(rt5, 0x00)
    let rt5_got = bs_unstuff(bs_stuff(rt5, 0x7E, 0x7D), 0x7D)
    ck_list("rt-null-byte", rt5_got, rt5)

    // ── bs_stuff_set / bs_unstuff_set round-trip ───────────────────────────────

    // specials=[0xC0,0xDB], esc=0xDB on [0xC0, 0xDB, 5]
    let sps = []
    push(sps, 0xC0)
    push(sps, 0xDB)
    let payload = []
    push(payload, 0xC0)
    push(payload, 0xDB)
    push(payload, 5)
    let stuffed = bs_stuff_set(payload, sps, 0xDB)
    // 0xC0 (192) -> 0xDB (219), 0xC0^0x20=0xE0 (224)
    // 0xDB (219) -> 0xDB (219), 0xDB^0x20=0xFB (251)
    // 5 -> 5
    let ws = []
    push(ws, 0xDB)
    push(ws, 0xE0)
    push(ws, 0xDB)
    push(ws, 0xFB)
    push(ws, 5)
    ck_list("stuff-set-canonical", stuffed, ws)
    let unstuffed = bs_unstuff_set(stuffed, 0xDB)
    ck_list("stuff-set-rt", unstuffed, payload)

    // RT empty via set
    let rt_set_e = []
    let sps2 = []
    push(sps2, 0xC0)
    push(sps2, 0xDB)
    ck_list("stuff-set-empty", bs_unstuff_set(bs_stuff_set(rt_set_e, sps2, 0xDB), 0xDB), rt_set_e)

    // RT all specials via set
    let rt_set_all = []
    push(rt_set_all, 0xC0)
    push(rt_set_all, 0xDB)
    push(rt_set_all, 0xC0)
    let sps3 = []
    push(sps3, 0xC0)
    push(sps3, 0xDB)
    ck_list("stuff-set-all-sp", bs_unstuff_set(bs_stuff_set(rt_set_all, sps3, 0xDB), 0xDB), rt_set_all)

    // ── bs_count_specials ─────────────────────────────────────────────────────

    let cs_data = []
    push(cs_data, 0x7E)
    push(cs_data, 1)
    push(cs_data, 0x7E)
    let cs_sp = []
    push(cs_sp, 0x7E)
    ck_int("count-specials-2", bs_count_specials(cs_data, cs_sp), 2)

    let cs_data2 = []
    push(cs_data2, 1)
    push(cs_data2, 2)
    push(cs_data2, 3)
    ck_int("count-specials-0", bs_count_specials(cs_data2, cs_sp), 0)
    ck_int("count-specials-empty", bs_count_specials([], cs_sp), 0)

    // ── bs_overhead ──────────────────────────────────────────────────────────

    let oh_data = []
    push(oh_data, 0x7E)
    push(oh_data, 1)
    push(oh_data, 0x7E)
    let oh_sp = []
    push(oh_sp, 0x7E)
    ck_int("overhead-2", bs_overhead(oh_data, oh_sp), 2)
    ck_int("overhead-0", bs_overhead([1, 2, 3], oh_sp), 0)

    print("PASS _bytestuff_test")
