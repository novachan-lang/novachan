// Off-heap / direct memory regions: a writable, page-aligned byte region OUTSIDE the
// RC heap (VirtualAlloc / anonymous mmap). For large buffers, DMA staging, avoiding
// heap pressure. All access is runtime bounds-checked, so it can never UB.

fn main()
    let r = offheap_create(16)
    assert_eq(offheap_len(r), 16)
    // zero-initialized
    assert_eq(offheap_get(r, 5), 0)
    // write + read back
    offheap_set(r, 0, 65)
    offheap_set(r, 1, 66)
    offheap_set(r, 15, 90)
    assert_eq(offheap_get(r, 0), 65)
    assert_eq(offheap_get(r, 1), 66)
    assert_eq(offheap_get(r, 15), 90)
    // bounds safety: OOB read -> -1, OOB write -> no-op
    assert_eq(offheap_get(r, 16), -1)
    assert_eq(offheap_get(r, -1), -1)
    offheap_set(r, 16, 99)
    assert_eq(offheap_get(r, 16), -1)
    offheap_free(r)

    // large off-heap region (1 MB), far from the heap
    let big = offheap_create(1000000)
    offheap_set(big, 999999, 7)
    offheap_set(big, 500000, 42)
    assert_eq(offheap_get(big, 999999), 7)
    assert_eq(offheap_get(big, 500000), 42)
    assert_eq(offheap_get(big, 0), 0)
    offheap_free(big)

    print("offheap passed")
