// Software rendering (the compute substrate of graphics) in NOVA: rasterize a filled
// rectangle into an 8x8 framebuffer and verify pixels. (Rasterization is pure compute +
// verifiable; putting pixels on a SCREEN needs a display/GPU, which is the honest boundary.)
fn main()
    let w = 8
    let h = 8
    let fb = []
    let i = 0
    while i < w * h
        fb.push(0)
        i = i + 1
    // fill rect (2,2)..(5,5) inclusive with 255
    let y = 2
    while y <= 5
        let x = 2
        while x <= 5
            fb[y * w + x] = 255
            x = x + 1
        y = y + 1
    assert_eq(fb[2 * 8 + 2], 255)   // top-left corner of rect
    assert_eq(fb[5 * 8 + 5], 255)   // bottom-right corner
    assert_eq(fb[3 * 8 + 4], 255)   // interior
    assert_eq(fb[0], 0)             // outside (0,0)
    assert_eq(fb[1 * 8 + 1], 0)     // outside (1,1)
    assert_eq(fb[7 * 8 + 7], 0)     // outside (7,7)
    print("software render test passed: rasterized rect into 8x8 framebuffer")
