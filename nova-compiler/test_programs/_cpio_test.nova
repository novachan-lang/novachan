import std/os/cpio

// cki: integer equality check
fn cki(label, got, want)
    if got != want
        print("FAIL cpio " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// cks: string equality check
fn cks(label, got, want)
    if got != want
        print("FAIL cpio " + label + ": got=" + got + " want=" + want)
        exit(1)

// ckb: bool equality check
fn ckb(label, got, want)
    let g = 0
    let w = 0
    if got
        g = 1
    if want
        w = 1
    if g != w
        print("FAIL cpio " + label + ": got=" + str(g) + " want=" + str(w))
        exit(1)

// _push_ascii8: push 8 bytes of a constant ASCII hex field '00000000'
fn _push_zeros8(buf: any)
    push(buf, 48)
    push(buf, 48)
    push(buf, 48)
    push(buf, 48)
    push(buf, 48)
    push(buf, 48)
    push(buf, 48)
    push(buf, 48)

// _build_cpio_buf: build a minimal newc cpio header + filename.
// Magic = "070701", field 6 (filesize) = 0000000A (=10),
// field 11 (namesize) = 00000004 (=4), all others = 00000000.
// Name = "abc\0" (4 bytes).
fn _build_cpio_buf() -> any
    let buf = []
    // magic "070701" = 48,55,48,55,48,49
    push(buf, 48)
    push(buf, 55)
    push(buf, 48)
    push(buf, 55)
    push(buf, 48)
    push(buf, 49)
    // fields 0..5: all '00000000'
    _push_zeros8(buf)
    _push_zeros8(buf)
    _push_zeros8(buf)
    _push_zeros8(buf)
    _push_zeros8(buf)
    _push_zeros8(buf)
    // field 6 (filesize): '0000000A' = 48,48,48,48,48,48,48,65
    push(buf, 48)
    push(buf, 48)
    push(buf, 48)
    push(buf, 48)
    push(buf, 48)
    push(buf, 48)
    push(buf, 48)
    push(buf, 65)
    // fields 7..10: all '00000000'
    _push_zeros8(buf)
    _push_zeros8(buf)
    _push_zeros8(buf)
    _push_zeros8(buf)
    // field 11 (namesize): '00000004' = 48,48,48,48,48,48,48,52
    push(buf, 48)
    push(buf, 48)
    push(buf, 48)
    push(buf, 48)
    push(buf, 48)
    push(buf, 48)
    push(buf, 48)
    push(buf, 52)
    // field 12 (check): '00000000'
    _push_zeros8(buf)
    // name "abc\0" = 97,98,99,0
    push(buf, 97)
    push(buf, 98)
    push(buf, 99)
    push(buf, 0)
    return buf

fn main()
    let buf = _build_cpio_buf()

    // sanity: total length = 6 + 13*8 + 4 = 6 + 104 + 4 = 114
    cki("buf_len", len(buf), 114)

    // magic checks
    ckb("magic_check", cpio_magic_check(buf, 0), true)
    ckb("is_newc", cpio_is_newc(buf, 0), true)
    ckb("is_odc", cpio_is_odc(buf, 0), false)

    // field 6 (filesize) = 0x0000000A = 10
    cki("filesize", cpio_filesize(buf, 0), 10)

    // field 11 (namesize) = 0x00000004 = 4
    cki("namesize", cpio_namesize(buf, 0), 4)

    // all-zero fields
    cki("ino", cpio_ino(buf, 0), 0)
    cki("mode", cpio_mode(buf, 0), 0)
    cki("uid", cpio_uid(buf, 0), 0)
    cki("gid", cpio_gid(buf, 0), 0)
    cki("nlink", cpio_nlink(buf, 0), 0)
    cki("mtime", cpio_mtime(buf, 0), 0)

    // name = "abc" (namesize-1 = 3 chars, stop before NUL)
    cks("name", cpio_name(buf, 0), "abc")

    // is_trailer: "abc" != "TRAILER!!!"
    ckb("is_trailer_false", cpio_is_trailer(buf, 0), false)

    // odc magic check
    let odcbuf = []
    // "070707" = 48,55,48,55,48,55
    push(odcbuf, 48)
    push(odcbuf, 55)
    push(odcbuf, 48)
    push(odcbuf, 55)
    push(odcbuf, 48)
    push(odcbuf, 55)
    ckb("odc_magic", cpio_magic_check(odcbuf, 0), true)
    ckb("odc_is_odc", cpio_is_odc(odcbuf, 0), true)
    ckb("odc_is_newc", cpio_is_newc(odcbuf, 0), false)

    // empty buf: no crash
    let empty = []
    ckb("empty_magic", cpio_magic_check(empty, 0), false)

    // lower-case hex: build a buffer with field 6 = '0000000a' (lowercase)
    let lbuf = []
    push(lbuf, 48)
    push(lbuf, 55)
    push(lbuf, 48)
    push(lbuf, 55)
    push(lbuf, 48)
    push(lbuf, 49)
    // fields 0..5: all zeros
    let fi = 0
    while fi < 6
        _push_zeros8(lbuf)
        fi = fi + 1
    // field 6 (filesize) lowercase: '0000000a' = 48,48,48,48,48,48,48,97
    push(lbuf, 48)
    push(lbuf, 48)
    push(lbuf, 48)
    push(lbuf, 48)
    push(lbuf, 48)
    push(lbuf, 48)
    push(lbuf, 48)
    push(lbuf, 97)
    // fields 7..12: all zeros
    let fj = 0
    while fj < 6
        _push_zeros8(lbuf)
        fj = fj + 1
    cki("lowercase_hex", cpio_filesize(lbuf, 0), 10)

    print("PASS _cpio_test")
