// _asn1_length_test — KAT for std/data/asn1_length
//
// Verifies asn1_len_encode and asn1_len_decode against canonical DER vectors.
//
// CANONICAL KAT VECTORS (X.690 §8.1.3):
//   asn1_len_encode(0)     == [0x00]
//   asn1_len_encode(127)   == [0x7F]
//   asn1_len_encode(128)   == [0x81, 0x80]
//   asn1_len_encode(200)   == [0x81, 0xC8]
//   asn1_len_encode(255)   == [0x81, 0xFF]
//   asn1_len_encode(256)   == [0x82, 0x01, 0x00]
//   asn1_len_encode(65535) == [0x82, 0xFF, 0xFF]
//   asn1_len_decode([0x81,0xC8], 0) == [200, 2]
//   Round-trip: decode(encode(n), 0)[0] == n for all KAT values
//   Indefinite form decode([0x80], 0) == [-1, 1]

import std/data/asn1_length

// ── Helper: compare bytes to expected list ───────────────────────────────────
// We check each byte individually for precise failure reporting.

// ── KAT 1: asn1_len_encode(0) == [0x00] ─────────────────────────────────────
let e0 = asn1_len_encode(0)
if bytes_len(e0) != 1
    print("FAIL asn1_length encode(0): length != 1, got " + str(bytes_len(e0)))
    exit(1)
if bytes_get(e0, 0) != 0
    print("FAIL asn1_length encode(0): byte[0] != 0x00, got " + str(bytes_get(e0, 0)))
    exit(1)
print("PASS kat1: encode(0) == [0x00]")

// ── KAT 2: asn1_len_encode(127) == [0x7F] ───────────────────────────────────
let e127 = asn1_len_encode(127)
if bytes_len(e127) != 1
    print("FAIL asn1_length encode(127): length != 1, got " + str(bytes_len(e127)))
    exit(1)
if bytes_get(e127, 0) != 127
    print("FAIL asn1_length encode(127): byte[0] != 0x7F, got " + str(bytes_get(e127, 0)))
    exit(1)
print("PASS kat2: encode(127) == [0x7F]")

// ── KAT 3: asn1_len_encode(128) == [0x81, 0x80] ─────────────────────────────
let e128 = asn1_len_encode(128)
if bytes_len(e128) != 2
    print("FAIL asn1_length encode(128): length != 2, got " + str(bytes_len(e128)))
    exit(1)
if bytes_get(e128, 0) != 129
    print("FAIL asn1_length encode(128): byte[0] != 0x81, got " + str(bytes_get(e128, 0)))
    exit(1)
if bytes_get(e128, 1) != 128
    print("FAIL asn1_length encode(128): byte[1] != 0x80, got " + str(bytes_get(e128, 1)))
    exit(1)
print("PASS kat3: encode(128) == [0x81, 0x80]")

// ── KAT 4: asn1_len_encode(200) == [0x81, 0xC8] ─────────────────────────────
let e200 = asn1_len_encode(200)
if bytes_len(e200) != 2
    print("FAIL asn1_length encode(200): length != 2, got " + str(bytes_len(e200)))
    exit(1)
if bytes_get(e200, 0) != 129
    print("FAIL asn1_length encode(200): byte[0] != 0x81, got " + str(bytes_get(e200, 0)))
    exit(1)
if bytes_get(e200, 1) != 200
    print("FAIL asn1_length encode(200): byte[1] != 0xC8 (200), got " + str(bytes_get(e200, 1)))
    exit(1)
print("PASS kat4: encode(200) == [0x81, 0xC8]")

// ── KAT 5: asn1_len_encode(255) == [0x81, 0xFF] ─────────────────────────────
let e255 = asn1_len_encode(255)
if bytes_len(e255) != 2
    print("FAIL asn1_length encode(255): length != 2, got " + str(bytes_len(e255)))
    exit(1)
if bytes_get(e255, 0) != 129
    print("FAIL asn1_length encode(255): byte[0] != 0x81, got " + str(bytes_get(e255, 0)))
    exit(1)
if bytes_get(e255, 1) != 255
    print("FAIL asn1_length encode(255): byte[1] != 0xFF, got " + str(bytes_get(e255, 1)))
    exit(1)
print("PASS kat5: encode(255) == [0x81, 0xFF]")

// ── KAT 6: asn1_len_encode(256) == [0x82, 0x01, 0x00] ───────────────────────
let e256 = asn1_len_encode(256)
if bytes_len(e256) != 3
    print("FAIL asn1_length encode(256): length != 3, got " + str(bytes_len(e256)))
    exit(1)
if bytes_get(e256, 0) != 130
    print("FAIL asn1_length encode(256): byte[0] != 0x82, got " + str(bytes_get(e256, 0)))
    exit(1)
if bytes_get(e256, 1) != 1
    print("FAIL asn1_length encode(256): byte[1] != 0x01, got " + str(bytes_get(e256, 1)))
    exit(1)
if bytes_get(e256, 2) != 0
    print("FAIL asn1_length encode(256): byte[2] != 0x00, got " + str(bytes_get(e256, 2)))
    exit(1)
print("PASS kat6: encode(256) == [0x82, 0x01, 0x00]")

// ── KAT 7: asn1_len_encode(65535) == [0x82, 0xFF, 0xFF] ─────────────────────
let e65535 = asn1_len_encode(65535)
if bytes_len(e65535) != 3
    print("FAIL asn1_length encode(65535): length != 3, got " + str(bytes_len(e65535)))
    exit(1)
if bytes_get(e65535, 0) != 130
    print("FAIL asn1_length encode(65535): byte[0] != 0x82, got " + str(bytes_get(e65535, 0)))
    exit(1)
if bytes_get(e65535, 1) != 255
    print("FAIL asn1_length encode(65535): byte[1] != 0xFF, got " + str(bytes_get(e65535, 1)))
    exit(1)
if bytes_get(e65535, 2) != 255
    print("FAIL asn1_length encode(65535): byte[2] != 0xFF, got " + str(bytes_get(e65535, 2)))
    exit(1)
print("PASS kat7: encode(65535) == [0x82, 0xFF, 0xFF]")

// ── KAT 8: decode [0x81, 0xC8] at pos 0 -> [200, 2] ─────────────────────────
let db = bytes(2)
bytes_set(db, 0, 129)
bytes_set(db, 1, 200)
let d8 = asn1_len_decode(db, 0)
if d8[0] != 200
    print("FAIL asn1_length decode([0x81,0xC8]): length != 200, got " + str(d8[0]))
    exit(1)
if d8[1] != 2
    print("FAIL asn1_length decode([0x81,0xC8]): next_pos != 2, got " + str(d8[1]))
    exit(1)
print("PASS kat8: decode([0x81,0xC8],0) == [200, 2]")

// ── KAT 9: indefinite form [0x80] -> [-1, 1] ─────────────────────────────────
let indef = bytes(1)
bytes_set(indef, 0, 128)
let d9 = asn1_len_decode(indef, 0)
if d9[0] != -1
    print("FAIL asn1_length decode(indef): should be -1, got " + str(d9[0]))
    exit(1)
if d9[1] != 1
    print("FAIL asn1_length decode(indef): next_pos should be 1, got " + str(d9[1]))
    exit(1)
print("PASS kat9: decode([0x80],0) == [-1, 1] (indefinite rejected)")

// ── KAT 10: short-form decode [0x00] at pos 0 -> [0, 1] ─────────────────────
let sf0 = bytes(1)
bytes_set(sf0, 0, 0)
let d10 = asn1_len_decode(sf0, 0)
if d10[0] != 0
    print("FAIL asn1_length decode(short 0): length != 0, got " + str(d10[0]))
    exit(1)
if d10[1] != 1
    print("FAIL asn1_length decode(short 0): next_pos != 1, got " + str(d10[1]))
    exit(1)
print("PASS kat10: decode([0x00],0) == [0, 1]")

// ── KAT 11: short-form decode [0x7F] at pos 0 -> [127, 1] ───────────────────
let sf127 = bytes(1)
bytes_set(sf127, 0, 127)
let d11 = asn1_len_decode(sf127, 0)
if d11[0] != 127
    print("FAIL asn1_length decode(short 127): length != 127, got " + str(d11[0]))
    exit(1)
if d11[1] != 1
    print("FAIL asn1_length decode(short 127): next_pos != 1, got " + str(d11[1]))
    exit(1)
print("PASS kat11: decode([0x7F],0) == [127, 1]")

// ── KAT 12: round-trip all encode values ─────────────────────────────────────
// n=0: encode -> [0x00], decode at 0 -> [0, 1]
let rt0 = asn1_len_decode(asn1_len_encode(0), 0)
if rt0[0] != 0
    print("FAIL asn1_length round-trip(0): got " + str(rt0[0]))
    exit(1)
// n=127
let rt127 = asn1_len_decode(asn1_len_encode(127), 0)
if rt127[0] != 127
    print("FAIL asn1_length round-trip(127): got " + str(rt127[0]))
    exit(1)
// n=128
let rt128 = asn1_len_decode(asn1_len_encode(128), 0)
if rt128[0] != 128
    print("FAIL asn1_length round-trip(128): got " + str(rt128[0]))
    exit(1)
// n=200
let rt200 = asn1_len_decode(asn1_len_encode(200), 0)
if rt200[0] != 200
    print("FAIL asn1_length round-trip(200): got " + str(rt200[0]))
    exit(1)
// n=255
let rt255 = asn1_len_decode(asn1_len_encode(255), 0)
if rt255[0] != 255
    print("FAIL asn1_length round-trip(255): got " + str(rt255[0]))
    exit(1)
// n=256
let rt256 = asn1_len_decode(asn1_len_encode(256), 0)
if rt256[0] != 256
    print("FAIL asn1_length round-trip(256): got " + str(rt256[0]))
    exit(1)
// n=65535
let rt65535 = asn1_len_decode(asn1_len_encode(65535), 0)
if rt65535[0] != 65535
    print("FAIL asn1_length round-trip(65535): got " + str(rt65535[0]))
    exit(1)
print("PASS kat12: round-trip encode->decode all KAT values")

// ── KAT 13: decode with non-zero pos (embedded in a stream) ──────────────────
// Simulate a TLV stream: [0x02, 0x81, 0xC8, ...data...] — tag at 0, length at 1
// decode(b, 1) should yield [200, 3]
let tlv = bytes(3)
bytes_set(tlv, 0, 2)
bytes_set(tlv, 1, 129)
bytes_set(tlv, 2, 200)
let d13 = asn1_len_decode(tlv, 1)
if d13[0] != 200
    print("FAIL asn1_length decode embedded: length != 200, got " + str(d13[0]))
    exit(1)
if d13[1] != 3
    print("FAIL asn1_length decode embedded: next_pos != 3, got " + str(d13[1]))
    exit(1)
print("PASS kat13: decode at non-zero pos in TLV stream")

// ── KAT 14: decode 2-byte long form [0x82, 0x01, 0x00] -> [256, 3] ───────────
let lf256 = bytes(3)
bytes_set(lf256, 0, 130)
bytes_set(lf256, 1, 1)
bytes_set(lf256, 2, 0)
let d14 = asn1_len_decode(lf256, 0)
if d14[0] != 256
    print("FAIL asn1_length decode(256): length != 256, got " + str(d14[0]))
    exit(1)
if d14[1] != 3
    print("FAIL asn1_length decode(256): next_pos != 3, got " + str(d14[1]))
    exit(1)
print("PASS kat14: decode([0x82,0x01,0x00],0) == [256, 3]")

// ── KAT 15: decode [0x82, 0xFF, 0xFF] -> [65535, 3] ─────────────────────────
let lf65535 = bytes(3)
bytes_set(lf65535, 0, 130)
bytes_set(lf65535, 1, 255)
bytes_set(lf65535, 2, 255)
let d15 = asn1_len_decode(lf65535, 0)
if d15[0] != 65535
    print("FAIL asn1_length decode(65535): length != 65535, got " + str(d15[0]))
    exit(1)
if d15[1] != 3
    print("FAIL asn1_length decode(65535): next_pos != 3, got " + str(d15[1]))
    exit(1)
print("PASS kat15: decode([0x82,0xFF,0xFF],0) == [65535, 3]")

print("PASS _asn1_length_test")
