// forge_orm_test -- the universal ORM proven on a REAL database. SQLite always (no creds needed);
// PostgreSQL additionally when PG env creds are present. The SAME typed code path (run_suite) runs against
// both drivers unchanged -- that is the whole point: one ORM, every DB. `?` placeholders are written once
// and auto-translated to $N for PG; values are always bound (injection-safe); each field is coerced to the
// STRUCT's type with zero annotation.
import forge_orm

type User
    id: int
    name: string
    age: int
    active: bool

type Note
    id: int
    title: string
    body: string

type Post
    id: int
    user_id: int
    title: string

fn _envor(name: string, dflt: string) -> string
    let v = env(name)
    if len(v) > 0
        return v
    dflt

fn run_suite(db, label: string)
    orm_exec(db, "DROP TABLE IF EXISTS orm_users", [])
    orm_exec(db, "CREATE TABLE orm_users (id int, name text, age int, active int)", [])
    orm_exec(db, "INSERT INTO orm_users (id, name, age, active) VALUES (?, ?, ?, ?)", [1, "Ada", 36, 1])
    orm_exec(db, "INSERT INTO orm_users (id, name, age, active) VALUES (?, ?, ?, ?)", [2, "Linus", 54, 0])
    orm_exec(db, "INSERT INTO orm_users (id, name, age, active) VALUES (?, ?, ?, ?)", [3, "Grace", 85, 1])

    // Typed list query: list<User>, each field coerced by the struct's type (text -> int/bool).
    let users: list<User> = orm_all(db, "SELECT id, name, age, active FROM orm_users ORDER BY id", [])
    assert_eq(len(users), 3)
    assert_eq(users[0].name, "Ada")
    assert_eq(users[0].age, 36)
    assert_eq(users[0].active, true)
    assert_eq(users[1].active, false)

    // Parameterized typed query (injection-safe; `?` -> $N for PG automatically).
    let adults: list<User> = orm_all(db, "SELECT id, name, age, active FROM orm_users WHERE age > ? ORDER BY id", [40])
    assert_eq(len(adults), 2)
    assert_eq(adults[0].name, "Linus")

    // Typed single row.
    let one: Result<User> = orm_one(db, "SELECT id, name, age, active FROM orm_users WHERE id = ?", [3])
    match one
        Ok(u) =>
            assert_eq(u.name, "Grace")
            assert_eq(u.age, 85)
        Err(e) =>
            print(label + " FAIL orm_one: " + e)
            exit(1)

    // Inbuilt functions.
    assert_eq(orm_count(db, "orm_users", "active = ?", [1]), 2)
    assert(orm_exists(db, "orm_users", "name = ?", ["Ada"]), "exists Ada")
    assert_eq(parse_int(orm_agg(db, "max", "age", "orm_users", "", [])), 85)

    // struct-driven CRUD (RTTI, no SQL): insert/update/delete reflect the struct's fields.
    orm_exec(db, "DROP TABLE IF EXISTS orm_notes", [])
    orm_exec(db, "CREATE TABLE orm_notes (id int, title text, body text)", [])
    orm_insert(db, "orm_notes", Note(1, "first", "hello"))
    orm_insert(db, "orm_notes", Note(2, "second", "world"))
    assert_eq(orm_count(db, "orm_notes", "", []), 2)
    orm_update(db, "orm_notes", Note(1, "first-edited", "HELLO"))
    let n1: Result<Note> = orm_one(db, "SELECT id, title, body FROM orm_notes WHERE id = ?", [1])
    match n1
        Ok(nt) =>
            assert_eq(nt.title, "first-edited")
            assert_eq(nt.body, "HELLO")
        Err(e) =>
            print(label + " FAIL crud read: " + e)
            exit(1)
    orm_delete(db, "orm_notes", 2)
    assert_eq(orm_count(db, "orm_notes", "", []), 1)
    orm_exec(db, "DROP TABLE IF EXISTS orm_notes", [])

    // bool struct field round-trips through CRUD: field_get returns the raw 0/1, so it binds cleanly even
    // to a PG int column (str(field)=="1", not "true"). Proves the write path for bool fields.
    orm_insert(db, "orm_users", User(4, "Margaret", 60, true))
    let bm: Result<User> = orm_one(db, "SELECT id, name, age, active FROM orm_users WHERE id = ?", [4])
    match bm
        Ok(bu) =>
            assert_eq(bu.name, "Margaret")
            assert_eq(bu.active, true)
        Err(e) =>
            print(label + " FAIL bool-crud: " + e)
            exit(1)

    // fluent query builder -> typed list<User> (zero annotation). orm_users now: Ada36 Linus54 Grace85 Margaret60.
    let q = q_from("orm_users").where("age > ?", [40]).order_by("age").limit(5)
    let qusers: list<User> = orm_all(db, q.sql(), q.params)
    assert_eq(len(qusers), 3)
    assert_eq(qusers[0].name, "Linus")
    assert_eq(qusers[2].name, "Grace")

    // SQL-free typed repository: find by id (the JPA-repository win, zero annotations).
    let u2: Result<User> = orm_get(db, "orm_users", 2)
    match u2
        Ok(uu) =>
            assert_eq(uu.name, "Linus")
        Err(e) =>
            print(label + " FAIL orm_get: " + e)
            exit(1)

    // relations with no annotations: has-many = orm_where on the child FK; belongs-to = orm_get the parent.
    orm_exec(db, "DROP TABLE IF EXISTS orm_posts", [])
    orm_exec(db, "CREATE TABLE orm_posts (id int, user_id int, title text)", [])
    orm_insert(db, "orm_posts", Post(1, 1, "hello"))
    orm_insert(db, "orm_posts", Post(2, 1, "world"))
    orm_insert(db, "orm_posts", Post(3, 2, "linus-post"))
    let ada_posts: list<Post> = orm_where(db, "orm_posts", "user_id = ? ORDER BY id", [1])
    assert_eq(len(ada_posts), 2)
    assert_eq(ada_posts[0].title, "hello")
    let owner: Result<User> = orm_get(db, "orm_users", ada_posts[0].user_id)
    match owner
        Ok(o) =>
            assert_eq(o.name, "Ada")
        Err(e) =>
            print(label + " FAIL belongs-to: " + e)
            exit(1)
    orm_exec(db, "DROP TABLE IF EXISTS orm_posts", [])

    // migrations: schema generated from the struct (JPA's ddl-auto), no annotations, no DDL by hand.
    orm_drop_table(db, "orm_gen")
    orm_create_table(db, "orm_gen", User(0, "", 0, false))
    orm_insert(db, "orm_gen", User(1, "Zoe", 30, true))
    let gz: Result<User> = orm_get(db, "orm_gen", 1)
    match gz
        Ok(zz) =>
            assert_eq(zz.name, "Zoe")
            assert_eq(zz.age, 30)
            assert_eq(zz.active, true)
        Err(e) =>
            print(label + " FAIL migration: " + e)
            exit(1)
    orm_drop_table(db, "orm_gen")

    orm_exec(db, "DROP TABLE IF EXISTS orm_users", [])
    print(label + " universal ORM OK (typed list + params + one + count/exists/agg + struct CRUD + query builder + repository/relations + migrations)")

fn main()
    let sr = orm_open("sqlite://_orm.db")
    match sr
        Ok(sdb) =>
            run_suite(sdb, "[sqlite]")
            orm_close(sdb)
        Err(e) =>
            print("FAIL sqlite open: " + e)
            exit(1)

    let pw = env("PGPASSWORD")
    if len(pw) > 0
        let host = _envor("PGHOST", "127.0.0.1")
        let port = _envor("PGPORT", "5432")
        let user = _envor("PGUSER", "postgres")
        let dbn = _envor("PGDATABASE", "postgres")
        let url = "postgres://" + user + ":" + pw + "@" + host + ":" + port + "/" + dbn
        let pr = orm_open(url)
        match pr
            Ok(pdb) =>
                run_suite(pdb, "[postgres]")
                orm_close(pdb)
            Err(e) =>
                print("FAIL postgres open: " + e)
                exit(1)
    else
        print("[postgres] skipped (set PGPASSWORD to run the live PG path)")

    print("forge_orm_test passed")
