import forge_graceful_shutdown

fn main()
    let gs = gs_new()
    assert(gs_status(gs) == "running", "running")

    gs = gs_add_hook(gs, "close_db", 1)
    gs = gs_add_hook(gs, "flush_logs", 2)
    gs = gs_add_hook(gs, "stop_server", 3)
    assert(gs_hook_count(gs) == 3, "3 hooks")

    let order = gs_execution_order(gs)
    assert(order[0] == "close_db", "db first (prio 1)")
    assert(order[2] == "stop_server", "server last (prio 3)")

    gs = gs_initiate(gs)
    assert(gs_status(gs) == "shutting_down", "shutting down")

    let pending = gs_pending_hooks(gs)
    assert(len(pending) == 3, "3 pending")

    gs = gs_complete_hook(gs, "close_db")
    assert(gs_completed_count(gs) == 1, "1 completed")
    assert(gs_status(gs) == "shutting_down", "still shutting down")

    gs = gs_fail_hook(gs, "flush_logs", "timeout")
    assert(gs_failed_count(gs) == 1, "1 failed")

    gs = gs_complete_hook(gs, "stop_server")
    assert(gs_status(gs) == "stopped", "all done -> stopped")
    assert(gs_completed_count(gs) == 2, "2 completed")

    let pending2 = gs_pending_hooks(gs)
    assert(len(pending2) == 0, "0 pending")

    print("GRACEFUL-SHUTDOWN KAT PASS")
