// Wave-C #7: MySQL OK-packet affected_rows parse. Offline KAT with hand-built packets.
import forge_mysql

fn main()
    // OK packet, affected=5 (single-byte lenenc): [0x00, 0x05, lastid=0x00, status=0x0002, warn=0x0000]
    let p = bytes(0)
    p = bytes_append(p, 0)
    p = bytes_append(p, 5)
    p = bytes_append(p, 0)
    p = bytes_append(p, 2)
    p = bytes_append(p, 0)
    p = bytes_append(p, 0)
    p = bytes_append(p, 0)
    if mysql_ok_affected(p) != 5
        print("FAIL ok5: " + str(mysql_ok_affected(p)))
        exit(1)

    // affected=0
    let z = bytes(0)
    z = bytes_append(z, 0)
    z = bytes_append(z, 0)
    if mysql_ok_affected(z) != 0
        print("FAIL ok0")
        exit(1)

    // affected=300 via 0xfc + 2-byte little-endian (0x2c 0x01)
    let big = bytes(0)
    big = bytes_append(big, 0)
    big = bytes_append(big, 252)
    big = bytes_append(big, 44)
    big = bytes_append(big, 1)
    if mysql_ok_affected(big) != 300
        print("FAIL ok300: " + str(mysql_ok_affected(big)))
        exit(1)

    print("PASS _mysql_affected_test")
