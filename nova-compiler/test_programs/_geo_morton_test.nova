import std/geo/geo_morton

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckf(label, got, want, eps)
    let diff = got - want
    let adiff = diff
    if diff < 0.0
        adiff = 0.0 - diff
    if adiff > eps
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    if got != want
        let gs = "false"
        let ws = "false"
        if got
            gs = "true"
        if want
            ws = "true"
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn main()
    // gm_spread_bits
    cki("spread(0)", gm_spread_bits(0), 0)
    cki("spread(1)", gm_spread_bits(1), 1)
    // 0b11 -> 0b0101 = 5
    cki("spread(3)", gm_spread_bits(3), 5)
    // 0b111 -> 0b010101 = 21
    cki("spread(7)", gm_spread_bits(7), 21)
    // 0b1010 -> bits 1,3 spread to positions 2,6: 4+64=68
    cki("spread(10)", gm_spread_bits(10), 68)

    // gm_interleave: qlat=3=011b, qlon=5=101b -> code=27
    // spread_lon(5)=spread(101b): bit0->pos0=1, bit2->pos4=16; =17
    // spread_lat(3)=5, *2=10
    // 17|10=27
    cki("interleave(3,5,3)", gm_interleave(3, 5, 3), 27)
    cki("interleave(0,0,4)", gm_interleave(0, 0, 4), 0)
    cki("interleave(1,0,4)", gm_interleave(1, 0, 4), 2)
    cki("interleave(0,1,4)", gm_interleave(0, 1, 4), 1)
    cki("interleave(1,1,4)", gm_interleave(1, 1, 4), 3)

    // gm_deinterleave round-trip
    let dq1 = gm_deinterleave(gm_interleave(3, 5, 3), 3)
    cki("deinterleave.qlat", dq1[0], 3)
    cki("deinterleave.qlon", dq1[1], 5)

    let dq2 = gm_deinterleave(gm_interleave(0, 0, 8), 8)
    cki("deinterleave(0,0).qlat", dq2[0], 0)
    cki("deinterleave(0,0).qlon", dq2[1], 0)

    let dq3 = gm_deinterleave(gm_interleave(255, 255, 8), 8)
    cki("deinterleave(255,255).qlat", dq3[0], 255)
    cki("deinterleave(255,255).qlon", dq3[1], 255)

    // gm_quantize at extreme corners
    let q00 = gm_quantize(0.0 - 90.0, 0.0 - 180.0, 8)
    cki("quantize(-90,-180,8).qlat", q00[0], 0)
    cki("quantize(-90,-180,8).qlon", q00[1], 0)

    // North pole approximate (will be near max)
    let qne = gm_quantize(90.0, 180.0, 8)
    let qne_lat = qne[0]
    let qne_lon = qne[1]
    // Should be at or near 255 (2^8-1)
    ckb("quantize(90,180,8).qlat_big", qne_lat >= 250, true)
    ckb("quantize(90,180,8).qlon_big", qne_lon >= 250, true)

    // gm_encode / gm_decode round-trip at bits=16
    let code25 = gm_encode(25.0, 50.0, 16)
    let dec25 = gm_decode(code25, 16)
    let dec25_lat = dec25[0] * 1.0
    let dec25_lon = dec25[1] * 1.0
    // Cell size at 16 bits: 180/65536 ~ 0.00275 lat, 360/65536 ~ 0.00549 lon
    ckf("encode_decode(25,50,16).lat", dec25_lat, 25.0, 0.01)
    ckf("encode_decode(25,50,16).lon", dec25_lon, 50.0, 0.01)

    // Round-trip for origin
    let code0 = gm_encode(0.0, 0.0, 16)
    let dec0 = gm_decode(code0, 16)
    let dec0_lat = dec0[0] * 1.0
    let dec0_lon = dec0[1] * 1.0
    ckf("encode_decode(0,0,16).lat", dec0_lat, 0.0, 0.01)
    ckf("encode_decode(0,0,16).lon", dec0_lon, 0.0, 0.01)

    // Round-trip for negative coords
    let code_neg = gm_encode(0.0 - 33.0, 0.0 - 70.0, 16)
    let dec_neg = gm_decode(code_neg, 16)
    let dec_neg_lat = dec_neg[0] * 1.0
    let dec_neg_lon = dec_neg[1] * 1.0
    ckf("encode_decode(-33,-70,16).lat", dec_neg_lat, 0.0 - 33.0, 0.01)
    ckf("encode_decode(-33,-70,16).lon", dec_neg_lon, 0.0 - 70.0, 0.01)

    // gm_cell_size
    let cs8 = gm_cell_size(8)
    let cs8_dlat = cs8[0] * 1.0
    let cs8_dlon = cs8[1] * 1.0
    // 180/256 = 0.703125, 360/256 = 1.40625
    ckf("cell_size(8).dlat", cs8_dlat, 0.703125, 0.001)
    ckf("cell_size(8).dlon", cs8_dlon, 1.40625, 0.001)

    // gm_common_prefix: nearby codes share more prefix than far codes
    let code_a = gm_encode(51.5, 0.0 - 0.1, 16)
    let code_b = gm_encode(51.5, 0.0 - 0.2, 16)
    let code_far = gm_encode(0.0 - 33.0, 150.0, 16)
    let cp_near = gm_common_prefix(code_a, code_b)
    let cp_far = gm_common_prefix(code_a, code_far)
    ckb("common_prefix_near>far", cp_near > cp_far, true)

    // gm_common_prefix of identical codes should be high
    let cp_same = gm_common_prefix(code_a, code_a)
    ckb("common_prefix_same_big", cp_same >= 32, true)

    // gm_z_order_compare
    cki("z_order_compare(3,5)", gm_z_order_compare(3, 5), 0 - 1)
    cki("z_order_compare(5,3)", gm_z_order_compare(5, 3), 1)
    cki("z_order_compare(7,7)", gm_z_order_compare(7, 7), 0)

    // gm_neighbors: should return 8 codes
    let nbrs = gm_neighbors(gm_interleave(5, 5, 8), 8)
    cki("neighbors_count", len(nbrs), 8)

    print("PASS _geo_morton_test")
