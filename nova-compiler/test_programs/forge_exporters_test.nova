// forge_exporters_test -- D7r.3 outbound exporters: OTLP/HTTP span JSON + SMTP message formatting.
// Deterministic (socket-free): the actual POST (otlp_export) / SMTP conversation (send_mail) are thin glue
// over the already-proven http_post_json / tcp primitives; the format builders are where the logic lives.
import forge_http_client

fn main()
    // ── OTLP/HTTP span payload ──────────────────────────────────────────────────────────────────────
    let sp = {}
    sp["trace_id"] = "0af7651916cd43dd8448eb211c80319c"
    sp["span_id"] = "b7ad6b7169203331"
    sp["name"] = "GET /users/:id"
    sp["start_ns"] = 1700000000000000000
    sp["end_ns"] = 1700000000005000000
    let j = forge_http_client.otlp_spans_json([sp])
    assert(find(j, "resourceSpans") >= 0, "OTLP: resourceSpans envelope")
    assert(find(j, "scopeSpans") >= 0, "OTLP: scopeSpans")
    assert(find(j, "0af7651916cd43dd8448eb211c80319c") >= 0, "OTLP: traceId present")
    assert(find(j, "b7ad6b7169203331") >= 0, "OTLP: spanId present")
    assert(find(j, "GET /users/:id") >= 0, "OTLP: span name present")
    assert(find(j, "startTimeUnixNano") >= 0 and find(j, "endTimeUnixNano") >= 0, "OTLP: nano timestamps")
    print("PASS: otlp_spans_json builds the OTLP/HTTP resourceSpans envelope")

    // two spans in one batch -> both present
    let sp2 = {}
    sp2["trace_id"] = "aaaa"
    sp2["span_id"] = "bbbb"
    sp2["name"] = "db.query"
    sp2["start_ns"] = 1
    sp2["end_ns"] = 2
    let j2 = forge_http_client.otlp_spans_json([sp, sp2])
    assert(find(j2, "db.query") >= 0 and find(j2, "GET /users/:id") >= 0, "OTLP: batches multiple spans")
    print("PASS: otlp_spans_json batches multiple spans")

    // ── SMTP message (RFC 5322 headers + body) ──────────────────────────────────────────────────────
    let m = forge_http_client.smtp_message("a@x.io", "b@y.io", "Hello", "line one\nline two")
    assert(find(m, "From: a@x.io") >= 0, "SMTP: From header")
    assert(find(m, "To: b@y.io") >= 0, "SMTP: To header")
    assert(find(m, "Subject: Hello") >= 0, "SMTP: Subject header")
    assert(find(m, "Content-Type: text/plain") >= 0, "SMTP: Content-Type")
    assert(find(m, "\r\n\r\nline one\nline two") >= 0, "SMTP: blank line then body")
    print("PASS: smtp_message builds an RFC 5322 message (headers + body)")

    print("forge_exporters_test passed")
