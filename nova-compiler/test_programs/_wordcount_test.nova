import std/text/wordcount

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got [" + got + "] expected [" + expected + "]")
        exit(1)

fn main()
    // ── wc_words ─────────────────────────────────────────────────────────────
    // KAT: spec examples
    cki("wc_words basic 3", wc_words("hello world foo"), 3)
    cki("wc_words trimmed 2", wc_words("  a   b "), 2)
    // additional known-answer
    cki("wc_words empty", wc_words(""), 0)
    cki("wc_words single", wc_words("nova"), 1)
    cki("wc_words tabs", wc_words("x	y	z"), 3)
    let nl = chr(10)
    cki("wc_words newlines", wc_words("one" + nl + "two" + nl + "three"), 3)

    // ── wc_chars ─────────────────────────────────────────────────────────────
    // KAT: spec example
    cki("wc_chars abc", wc_chars("abc"), 3)
    // additional known-answer
    cki("wc_chars empty", wc_chars(""), 0)
    cki("wc_chars spaces", wc_chars("hello world"), 11)
    cki("wc_chars single", wc_chars("x"), 1)

    // ── wc_lines ─────────────────────────────────────────────────────────────
    // KAT: spec example  "a\nb\nc" = 3 lines (2 newlines + 1)
    cki("wc_lines 3", wc_lines("a" + nl + "b" + nl + "c"), 3)
    // additional known-answer
    cki("wc_lines empty", wc_lines(""), 0)
    cki("wc_lines single", wc_lines("hello"), 1)
    cki("wc_lines two", wc_lines("a" + nl + "b"), 2)
    // trailing newline: "a\nb\n" has 2 newlines -> 3 lines (POSIX-style)
    cki("wc_lines trailing", wc_lines("a" + nl + "b" + nl), 3)

    // ── wc_sentences ─────────────────────────────────────────────────────────
    // KAT: spec example
    cki("wc_sentences 3", wc_sentences("Hi. Bye! Ok?"), 3)
    // additional known-answer
    cki("wc_sentences empty", wc_sentences(""), 0)
    cki("wc_sentences none", wc_sentences("no terminator here"), 0)
    cki("wc_sentences dots only", wc_sentences("a.b.c."), 3)
    cki("wc_sentences mixed", wc_sentences("Wait... Really?!"), 5)

    // ── wc_frequency ─────────────────────────────────────────────────────────
    // KAT: spec example
    let freq1 = wc_frequency("the cat the dog the")
    cki("wc_freq the=3", freq1["the"], 3)
    cki("wc_freq cat=1", freq1["cat"], 1)
    cki("wc_freq dog=1", freq1["dog"], 1)
    // additional known-answer: case normalization
    let freq2 = wc_frequency("The THE the")
    cki("wc_freq case the=3", freq2["the"], 3)
    // additional: punctuation stripped from tokens
    let freq3 = wc_frequency("hello, world!")
    cki("wc_freq hello=1", freq3["hello"], 1)
    cki("wc_freq world=1", freq3["world"], 1)
    // additional: numbers kept
    let freq4 = wc_frequency("a1 b2 a1")
    cki("wc_freq a1=2", freq4["a1"], 2)

    // ── wc_top ───────────────────────────────────────────────────────────────
    // KAT: spec example — top 1 of "a a b" = [["a", 2]]
    let top1 = wc_top("a a b", 1)
    cki("wc_top len=1", len(top1), 1)
    cks("wc_top[0][0]=a", top1[0][0], "a")
    cki("wc_top[0][1]=2", top1[0][1], 2)
    // additional: top 2
    let top2 = wc_top("a a b", 2)
    cki("wc_top2 len=2", len(top2), 2)
    cks("wc_top2[0][0]=a", top2[0][0], "a")
    cki("wc_top2[0][1]=2", top2[0][1], 2)
    cks("wc_top2[1][0]=b", top2[1][0], "b")
    cki("wc_top2[1][1]=1", top2[1][1], 1)
    // additional: k > unique words
    let top10 = wc_top("x x x", 10)
    cki("wc_top clamped", len(top10), 1)
    cks("wc_top clamped word", top10[0][0], "x")
    cki("wc_top clamped count", top10[0][1], 3)
    // additional: empty string
    let top_empty = wc_top("", 5)
    cki("wc_top empty", len(top_empty), 0)

    print("_wordcount_test passed")
