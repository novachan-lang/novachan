import std/itertools/it_zip

// cki — check a single int
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// cknest — check a list-of-lists element-wise
fn cknest(label: string, got, want)
    cki(label + "_outer_len", len(got), len(want))
    let i = 0
    while i < len(want)
        let gi = got[i]
        let wi = want[i]
        cki(label + "_" + str(i) + "_len", len(gi), len(wi))
        let j = 0
        while j < len(wi)
            cki(label + "_" + str(i) + "_" + str(j), gi[j], wi[j])
            j = j + 1
        i = i + 1

fn main()
    // ── itz_zip ──
    // zip([1,2],[3,4]) = [[1,3],[2,4]]
    let z1_want = []
    let z1_r0 = [1, 3]
    let z1_r1 = [2, 4]
    push(z1_want, z1_r0)
    push(z1_want, z1_r1)
    cknest("zip_basic", itz_zip([1, 2], [3, 4]), z1_want)

    // zip truncates to shorter: zip([1,2,3],[4,5]) = [[1,4],[2,5]]
    let z2_want = []
    let z2_r0 = [1, 4]
    let z2_r1 = [2, 5]
    push(z2_want, z2_r0)
    push(z2_want, z2_r1)
    cknest("zip_trunc", itz_zip([1, 2, 3], [4, 5]), z2_want)

    // zip empty => []
    cki("zip_empty_a", len(itz_zip([], [1, 2])), 0)
    cki("zip_empty_b", len(itz_zip([1, 2], [])), 0)
    cki("zip_both_empty", len(itz_zip([], [])), 0)

    // ── itz_zip3 ──
    // zip3([1],[2],[3]) = [[1,2,3]]
    let z3_want = []
    let z3_r0 = [1, 2, 3]
    push(z3_want, z3_r0)
    cknest("zip3_basic", itz_zip3([1], [2], [3]), z3_want)

    // zip3 truncates to shortest
    cki("zip3_trunc", len(itz_zip3([1, 2, 3], [4, 5], [6, 7, 8])), 2)

    // ── itz_unzip ──
    // unzip([[1,3],[2,4]]) = [[1,2],[3,4]]
    let up_in = []
    let up_r0 = [1, 3]
    let up_r1 = [2, 4]
    push(up_in, up_r0)
    push(up_in, up_r1)
    let up_got = itz_unzip(up_in)
    cki("unzip_outer_len", len(up_got), 2)
    let up_firsts = up_got[0]
    let up_seconds = up_got[1]
    cki("unzip_firsts_len", len(up_firsts), 2)
    cki("unzip_firsts_0", up_firsts[0], 1)
    cki("unzip_firsts_1", up_firsts[1], 2)
    cki("unzip_seconds_len", len(up_seconds), 2)
    cki("unzip_seconds_0", up_seconds[0], 3)
    cki("unzip_seconds_1", up_seconds[1], 4)

    // unzip of empty => [[],[]]
    let up_empty = itz_unzip([])
    cki("unzip_empty_outer", len(up_empty), 2)
    cki("unzip_empty_firsts", len(up_empty[0]), 0)
    cki("unzip_empty_seconds", len(up_empty[1]), 0)

    // ── ROUND-TRIP: unzip(zip(a,b)) == [a,b] ──
    let rt_a = [1, 2, 3]
    let rt_b = [4, 5, 6]
    let rt_zipped = itz_zip(rt_a, rt_b)
    let rt_got = itz_unzip(rt_zipped)
    cki("roundtrip_outer", len(rt_got), 2)
    let rt_firsts = rt_got[0]
    let rt_seconds = rt_got[1]
    cki("roundtrip_firsts_len", len(rt_firsts), 3)
    cki("roundtrip_firsts_0", rt_firsts[0], 1)
    cki("roundtrip_firsts_1", rt_firsts[1], 2)
    cki("roundtrip_firsts_2", rt_firsts[2], 3)
    cki("roundtrip_seconds_len", len(rt_seconds), 3)
    cki("roundtrip_seconds_0", rt_seconds[0], 4)
    cki("roundtrip_seconds_1", rt_seconds[1], 5)
    cki("roundtrip_seconds_2", rt_seconds[2], 6)

    // ── itz_zip_longest ──
    // zip_longest([1,2,3],[4],0) = [[1,4],[2,0],[3,0]]
    let zl_got = itz_zip_longest([1, 2, 3], [4], 0)
    cki("zl_len", len(zl_got), 3)
    cki("zl_0_0", zl_got[0][0], 1)
    cki("zl_0_1", zl_got[0][1], 4)
    cki("zl_1_0", zl_got[1][0], 2)
    cki("zl_1_1", zl_got[1][1], 0)
    cki("zl_2_0", zl_got[2][0], 3)
    cki("zl_2_1", zl_got[2][1], 0)

    // zip_longest equal lengths => same as zip
    let zleq_got = itz_zip_longest([1, 2], [3, 4], 99)
    cki("zl_eq_len", len(zleq_got), 2)
    cki("zl_eq_0_0", zleq_got[0][0], 1)
    cki("zl_eq_0_1", zleq_got[0][1], 3)

    // zip_longest both empty => []
    cki("zl_both_empty", len(itz_zip_longest([], [], 0)), 0)

    // ── itz_enumerate ──
    // enumerate([10,20,30]) = [[0,10],[1,20],[2,30]]
    let en_got = itz_enumerate([10, 20, 30])
    cki("en_len", len(en_got), 3)
    cki("en_0_idx", en_got[0][0], 0)
    cki("en_0_val", en_got[0][1], 10)
    cki("en_1_idx", en_got[1][0], 1)
    cki("en_1_val", en_got[1][1], 20)
    cki("en_2_idx", en_got[2][0], 2)
    cki("en_2_val", en_got[2][1], 30)

    // enumerate empty => []
    cki("en_empty", len(itz_enumerate([])), 0)

    print("PASS _it_zip_test")
