import std/physics/fluid_statics

fn approx(a, b)
    let d = a - b
    let ad = 0.0
    if d < 0.0
        ad = 0.0 - d
    else
        ad = d
    let result = false
    if ad < 0.0001
        result = true
    result

fn main()
    // hydrostatic(1000.0, 1.0) = 1000*9.81*1 = 9810.0
    let v1 = hydrostatic(1000.0, 1.0)
    if approx(v1, 9810.0)
        print("hydrostatic OK: " + str(v1))
    else
        print("FAIL fluid_statics hydrostatic: got " + str(v1) + " expected 9810.0")
        exit(1)

    // buoyant_force(1000.0, 0.001) = 1000*0.001*9.81 = 9.81
    let v2 = buoyant_force(1000.0, 0.001)
    if approx(v2, 9.81)
        print("buoyant_force OK: " + str(v2))
    else
        print("FAIL fluid_statics buoyant_force: got " + str(v2) + " expected 9.81")
        exit(1)

    // pascal_force(10.0, 1.0, 2.0) = 10*2/1 = 20.0
    let v3 = pascal_force(10.0, 1.0, 2.0)
    if approx(v3, 20.0)
        print("pascal_force OK: " + str(v3))
    else
        print("FAIL fluid_statics pascal_force: got " + str(v3) + " expected 20.0")
        exit(1)

    // pressure(1000.0, 9.81, 2.0) = 1000*9.81*2 = 19620.0
    let v4 = pressure(1000.0, 9.81, 2.0)
    if approx(v4, 19620.0)
        print("pressure OK: " + str(v4))
    else
        print("FAIL fluid_statics pressure: got " + str(v4) + " expected 19620.0")
        exit(1)

    print("PASS _fluid_statics_test")
