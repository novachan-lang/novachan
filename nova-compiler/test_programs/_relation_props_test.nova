import std/relation/relation_props

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn ckl(label, got, want)
    if len(got) != len(want)
        print("FAIL " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL " + label + ": [" + str(i) + "] got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

// ckm — check two n x n matrices are equal cell by cell.
fn ckm(label, A, B)
    let n = len(A)
    if len(B) != n
        print("FAIL " + label + ": row count got=" + str(len(A)) + " want=" + str(len(B)))
        exit(1)
    let i = 0
    while i < n
        let j = 0
        while j < n
            if A[i][j] != B[i][j]
                print("FAIL " + label + ": [" + str(i) + "][" + str(j) + "] got=" + str(A[i][j]) + " want=" + str(B[i][j]))
                exit(1)
            j = j + 1
        i = i + 1

// Local helpers — build matrices without importing relation_core.
fn _mk_zeros(n)
    let M = []
    let i = 0
    while i < n
        let row = []
        let j = 0
        while j < n
            row.push(0)
            j = j + 1
        M.push(row)
        i = i + 1
    return M

fn _mk_pairs(pairs, n)
    let M = _mk_zeros(n)
    let k = 0
    while k < len(pairs)
        let p = pairs[k]
        M[p[0]][p[1]] = 1
        k = k + 1
    return M

fn _mk_id(n)
    let M = _mk_zeros(n)
    let i = 0
    while i < n
        M[i][i] = 1
        i = i + 1
    return M

fn _mk_universal(n)
    let M = []
    let i = 0
    while i < n
        let row = []
        let j = 0
        while j < n
            row.push(1)
            j = j + 1
        M.push(row)
        i = i + 1
    return M

fn main()
    // =========================================================================
    // rpr_is_reflexive
    // =========================================================================
    // identity(3): reflexive
    let id3 = _mk_id(3)
    ckb("reflexive_id3", rpr_is_reflexive(id3, 3), true)

    // zeros(3): NOT reflexive
    let Z3 = _mk_zeros(3)
    ckb("reflexive_zeros3_false", rpr_is_reflexive(Z3, 3), false)

    // universal(3): reflexive
    let U3 = _mk_universal(3)
    ckb("reflexive_universal3", rpr_is_reflexive(U3, 3), true)

    // {(0,1),(1,2)}: NOT reflexive (missing 0,0 etc)
    let p01_12 = []
    p01_12.push([0, 1])
    p01_12.push([1, 2])
    let R01_12 = _mk_pairs(p01_12, 3)
    ckb("reflexive_01_12_false", rpr_is_reflexive(R01_12, 3), false)

    // n=0 edge case: vacuously true
    let E0 = _mk_zeros(0)
    ckb("reflexive_n0_vacuous", rpr_is_reflexive(E0, 0), true)

    // =========================================================================
    // rpr_is_irreflexive
    // =========================================================================
    ckb("irreflexive_id3_false", rpr_is_irreflexive(id3, 3), false)
    ckb("irreflexive_zeros3", rpr_is_irreflexive(Z3, 3), true)

    // {(0,1)}: irreflexive (no self-loops)
    let p01 = []
    p01.push([0, 1])
    let R01 = _mk_pairs(p01, 3)
    ckb("irreflexive_01", rpr_is_irreflexive(R01, 3), true)

    // {(0,0),(0,1)}: NOT irreflexive
    let p00_01 = []
    p00_01.push([0, 0])
    p00_01.push([0, 1])
    let R00_01 = _mk_pairs(p00_01, 3)
    ckb("irreflexive_00_01_false", rpr_is_irreflexive(R00_01, 3), false)

    // =========================================================================
    // rpr_is_symmetric
    // =========================================================================
    // identity(3): symmetric
    ckb("symmetric_id3", rpr_is_symmetric(id3, 3), true)

    // {(0,1),(1,0)}: symmetric
    let p01_10 = []
    p01_10.push([0, 1])
    p01_10.push([1, 0])
    let R01_10 = _mk_pairs(p01_10, 2)
    ckb("symmetric_01_10", rpr_is_symmetric(R01_10, 2), true)

    // {(0,1)}: NOT symmetric (missing (1,0))
    let p01_only = []
    p01_only.push([0, 1])
    let R01_only = _mk_pairs(p01_only, 3)
    ckb("symmetric_01_only_false", rpr_is_symmetric(R01_only, 3), false)

    // universal: symmetric
    ckb("symmetric_universal3", rpr_is_symmetric(U3, 3), true)

    // zeros: symmetric (vacuously)
    ckb("symmetric_zeros3", rpr_is_symmetric(Z3, 3), true)

    // =========================================================================
    // rpr_is_antisymmetric
    // =========================================================================
    // identity(3): antisymmetric (only self-pairs)
    ckb("antisymmetric_id3", rpr_is_antisymmetric(id3, 3), true)

    // {(0,1)}: antisymmetric (no symmetric pairs with different indices)
    ckb("antisymmetric_01", rpr_is_antisymmetric(R01_only, 3), true)

    // {(0,1),(1,0)}: NOT antisymmetric (0!=1 but both (0,1) and (1,0) present)
    ckb("antisymmetric_01_10_false", rpr_is_antisymmetric(R01_10, 2), false)

    // zeros: antisymmetric (vacuously)
    ckb("antisymmetric_zeros3", rpr_is_antisymmetric(Z3, 3), true)

    // {(0,1),(1,2),(0,2)}: antisymmetric (no symmetric non-diagonal pairs)
    let p_trans = []
    p_trans.push([0, 1])
    p_trans.push([1, 2])
    p_trans.push([0, 2])
    let R_trans = _mk_pairs(p_trans, 3)
    ckb("antisymmetric_012_trans", rpr_is_antisymmetric(R_trans, 3), true)

    // =========================================================================
    // rpr_is_transitive
    // =========================================================================
    // identity: transitive (i->i->i => i->i, fine)
    ckb("transitive_id3", rpr_is_transitive(id3, 3), true)

    // {(0,1),(1,0)}: NOT transitive: 0->1->0 but no 0->0
    ckb("transitive_01_10_false", rpr_is_transitive(R01_10, 2), false)

    // {(0,1),(1,2)}: NOT transitive: 0->1->2 but no 0->2
    ckb("transitive_01_12_false", rpr_is_transitive(R01_12, 3), false)

    // {(0,1),(1,2),(0,2)}: transitive
    ckb("transitive_01_12_02", rpr_is_transitive(R_trans, 3), true)

    // zeros: transitive (vacuously)
    ckb("transitive_zeros3", rpr_is_transitive(Z3, 3), true)

    // universal: transitive
    ckb("transitive_universal3", rpr_is_transitive(U3, 3), true)

    // single pair {(0,1)}: transitive? 0->1 but no 1->*, so no chain to violate
    ckb("transitive_01_only", rpr_is_transitive(R01_only, 3), true)

    // =========================================================================
    // rpr_is_asymmetric
    // =========================================================================
    // {(0,1)}: asymmetric (if (0,1) in R then (1,0) must not be, which holds)
    ckb("asymmetric_01", rpr_is_asymmetric(R01_only, 3), true)

    // {(0,1),(1,0)}: NOT asymmetric
    ckb("asymmetric_01_10_false", rpr_is_asymmetric(R01_10, 2), false)

    // identity: NOT asymmetric (has (i,i) -> (i,i) would need to be absent)
    ckb("asymmetric_id3_false", rpr_is_asymmetric(id3, 3), false)

    // zeros: asymmetric (vacuously)
    ckb("asymmetric_zeros3", rpr_is_asymmetric(Z3, 3), true)

    // {(0,1),(1,2),(0,2)}: asymmetric? no reverse pairs present
    ckb("asymmetric_0112_02", rpr_is_asymmetric(R_trans, 3), true)

    // =========================================================================
    // rpr_is_connex
    // =========================================================================
    // universal(3): connex (for all i!=j, both (i,j) and (j,i) present)
    ckb("connex_universal3", rpr_is_connex(U3, 3), true)

    // {(0,1),(1,2)}: NOT connex on n=3 (missing (0,2) or (2,0))
    ckb("connex_01_12_false", rpr_is_connex(R01_12, 3), false)

    // A total order {(0,1),(0,2),(1,2)}: connex? 0-1: (0,1) yes; 0-2: (0,2) yes; 1-2: (1,2) yes
    let p_total = []
    p_total.push([0, 1])
    p_total.push([0, 2])
    p_total.push([1, 2])
    let R_total = _mk_pairs(p_total, 3)
    ckb("connex_total_order", rpr_is_connex(R_total, 3), true)

    // identity(3): NOT connex (for i!=j neither (i,j) nor (j,i))
    ckb("connex_id3_false", rpr_is_connex(id3, 3), false)

    // zeros: NOT connex on n>=2
    ckb("connex_zeros3_false", rpr_is_connex(Z3, 3), false)

    // n=0: vacuously connex
    ckb("connex_n0_vacuous", rpr_is_connex(E0, 0), true)

    // n=1: vacuously connex (no pairs i!=j exist)
    let id1 = _mk_id(1)
    ckb("connex_n1_vacuous", rpr_is_connex(id1, 1), true)

    // =========================================================================
    // Combined property checks (spec KATs)
    // =========================================================================
    // identity(3): reflexive, symmetric, antisymmetric, transitive
    ckb("spec_id3_refl", rpr_is_reflexive(id3, 3), true)
    ckb("spec_id3_sym", rpr_is_symmetric(id3, 3), true)
    ckb("spec_id3_antisym", rpr_is_antisymmetric(id3, 3), true)
    ckb("spec_id3_trans", rpr_is_transitive(id3, 3), true)

    // {(0,1),(1,0)} on n=2: symmetric, NOT transitive
    ckb("spec_01_10_sym", rpr_is_symmetric(R01_10, 2), true)
    ckb("spec_01_10_trans_false", rpr_is_transitive(R01_10, 2), false)

    // {(0,1),(1,2)} on n=3: NOT transitive
    ckb("spec_01_12_trans_false", rpr_is_transitive(R01_12, 3), false)

    // {(0,1),(1,2),(0,2)} on n=3: transitive
    ckb("spec_01_12_02_trans", rpr_is_transitive(R_trans, 3), true)

    // universal(3): connex
    ckb("spec_univ3_connex", rpr_is_connex(U3, 3), true)

    // {(0,1)} on n=3: antisymmetric, asymmetric
    ckb("spec_01_antisym", rpr_is_antisymmetric(R01_only, 3), true)
    ckb("spec_01_asym", rpr_is_asymmetric(R01_only, 3), true)

    print("PASS _relation_props_test")

main()
