import forge_service_discovery

fn main()
    let s = sd_new()
    assert(sd_total_services(s) == 0, "starts empty")

    s = sd_register(s, "api", "10.0.0.1", 8080)
    s = sd_register(s, "api", "10.0.0.2", 8080)
    s = sd_register(s, "db", "10.0.0.3", 5432)
    assert(sd_total_services(s) == 3, "3 services")
    assert(sd_healthy_count(s, "api") == 2, "2 healthy api")

    let r1 = sd_discover(s, "api")
    assert(r1["found"] == 1, "found api")
    assert(r1["port"] == 8080, "port 8080")

    s = sd_mark_unhealthy(s, 1)
    assert(sd_healthy_count(s, "api") == 1, "1 healthy after mark")

    let r2 = sd_discover(s, "api")
    assert(r2["found"] == 1, "still find healthy one")
    assert(r2["address"] == "10.0.0.2", "second api instance")

    s = sd_mark_unhealthy(s, 2)
    let r3 = sd_discover(s, "api")
    assert(r3["found"] == 0, "no healthy api")
    assert(sd_healthy_count(s, "api") == 0, "0 healthy")

    s = sd_mark_healthy(s, 1)
    let r4 = sd_discover(s, "api")
    assert(r4["found"] == 1, "recovered api")

    let r5 = sd_discover(s, "missing")
    assert(r5["found"] == 0, "missing service")

    print("SERVICE-DISCOVERY KAT PASS")
