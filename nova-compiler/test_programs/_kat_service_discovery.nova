import forge_service_discovery

fn main()
    let s = sd_new()
    s = sd_register(s, "auth", "10.0.0.1:8080", "1.0.0")
    s = sd_register(s, "billing", "10.0.0.2:8081", "2.1.0")
    s = sd_register(s, "cart", "10.0.0.3:8082", "1.4.0")

    assert(sd_service_count(s) == 3, "3 services registered")

    let ep = sd_lookup(s, "auth")
    assert(is_ok(ep), "lookup auth ok")
    assert(unwrap(ep) == "10.0.0.1:8080", "auth endpoint correct")

    let v = sd_version(s, "billing")
    assert(is_ok(v), "version billing ok")
    assert(unwrap(v) == "2.1.0", "billing version correct")

    assert(is_err(sd_lookup(s, "ghost")), "lookup unknown errors")
    assert(is_err(sd_version(s, "ghost")), "version unknown errors")

    let h1 = sd_is_healthy(s, "auth")
    assert(is_ok(h1), "is_healthy auth ok")
    assert(unwrap(h1) == 1, "auth healthy by default")

    assert(sd_healthy_count(s) == 3, "3 healthy services")

    let sh = sd_set_healthy(s, "cart", 0)
    assert(is_ok(sh), "set_healthy cart ok")
    let h2 = sd_is_healthy(s, "cart")
    assert(unwrap(h2) == 0, "cart now unhealthy")
    assert(sd_healthy_count(s) == 2, "2 healthy services after cart down")

    assert(is_err(sd_set_healthy(s, "ghost", 1)), "set_healthy unknown errors")

    let names = sd_service_list(s)
    assert(contains(names, "auth") == true, "list has auth")
    assert(contains(names, "billing") == true, "list has billing")
    assert(contains(names, "cart") == true, "list has cart")

    let dr = sd_deregister(s, "billing")
    assert(is_ok(dr), "deregister billing ok")
    assert(sd_service_count(s) == 2, "2 services after deregister")
    assert(is_err(sd_lookup(s, "billing")), "lookup deregistered errors")
    assert(is_err(sd_deregister(s, "billing")), "double deregister errors")

    // re-register after deregister should reactivate without double-counting
    s = sd_register(s, "billing", "10.0.0.9:9090", "3.0.0")
    assert(sd_service_count(s) == 3, "3 services after re-register")
    let ep2 = sd_lookup(s, "billing")
    assert(unwrap(ep2) == "10.0.0.9:9090", "re-registered endpoint updated")

    print("SERVICE-DISCOVERY KAT PASS")
