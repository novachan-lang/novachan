import forge_shard_map

fn main()
    let s = sm_new(4)
    assert(sm_shard_count(s) == 4, "4 shards")

    s = sm_assign(s, "user1")
    s = sm_assign(s, "user2")
    s = sm_assign(s, "user3")
    assert(sm_key_count(s) == 3, "3 keys")

    let r1 = sm_get_shard(s, "user1")
    assert(is_ok(r1), "shard ok")
    let shard1 = unwrap(r1)
    assert(shard1 >= 0, "shard >= 0")
    assert(shard1 < 4, "shard < 4")

    let sf = sm_shard_for(s, "user1")
    assert(sf == shard1, "consistent shard")

    let bad = sm_get_shard(s, "nope")
    assert(is_err(bad), "unknown key err")

    assert(sm_total_lookups(s) == 2, "2 lookups")

    print("SHARD-MAP KAT PASS")
