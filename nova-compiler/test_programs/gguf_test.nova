// Parse a real GGUF model file (the llama.cpp / ggml format) in pure NOVA, using
// read_bytes + byte ops. Proves NOVA can load a STANDARD model format (header,
// metadata KV, tensor info) — not just a custom one. Oracle = the hand-crafted
// minimal GGUF written by _gguf_probe.ps1 (version 3; kv answer=42; tensor w, dims [3], f32).
fn rd_u32(b, pos: int) -> int
    bytes_get(b, pos) + bytes_get(b, pos + 1) * 256 + bytes_get(b, pos + 2) * 65536 + bytes_get(b, pos + 3) * 16777216

fn main()
    let b = read_bytes("test.gguf")
    // magic "GGUF"
    assert_eq(bytes_get(b, 0), 71)
    assert_eq(bytes_get(b, 1), 71)
    assert_eq(bytes_get(b, 2), 85)
    assert_eq(bytes_get(b, 3), 70)
    let version = rd_u32(b, 4)
    assert_eq(version, 3)
    let tcount = rd_u32(b, 8)        // tensor_count (low 32 of u64)
    let kvcount = rd_u32(b, 16)      // metadata_kv_count
    assert_eq(tcount, 1)
    assert_eq(kvcount, 1)
    // metadata KV: key(gguf_string: u64 len + bytes), value_type(u32), value
    let pos = 24
    let klen = rd_u32(b, pos)
    assert_eq(klen, 6)
    pos = pos + 8
    let key = bytes_to_str(bytes_slice(b, pos, pos + klen))
    assert_eq(key, "answer")
    pos = pos + klen
    let vtype = rd_u32(b, pos)       // 4 = UINT32
    assert_eq(vtype, 4)
    pos = pos + 4
    let value = rd_u32(b, pos)       // 42
    assert_eq(value, 42)
    pos = pos + 4
    // tensor_info: name, n_dims(u32), dims(u64 each), type(u32), offset(u64)
    let nlen = rd_u32(b, pos)
    assert_eq(nlen, 1)
    pos = pos + 8
    let tname = bytes_to_str(bytes_slice(b, pos, pos + nlen))
    assert_eq(tname, "w")
    pos = pos + nlen
    let ndims = rd_u32(b, pos)
    assert_eq(ndims, 1)
    pos = pos + 4
    let dim0 = rd_u32(b, pos)
    assert_eq(dim0, 3)
    pos = pos + 8
    let ttype = rd_u32(b, pos)       // 0 = GGML_TYPE_F32
    assert_eq(ttype, 0)
    print("GGUF parse test passed: version={version}, kv answer={value}, tensor {tname} dims=[{dim0}] type={ttype}")
