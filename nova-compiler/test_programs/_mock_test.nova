// KAT for std/testing/mock — call-recording mock / stub
import std/testing/mock

// ── minimal test helpers ──────────────────────────────────────────────────────
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got " + got + " want " + want)
        exit(1)

fn ckb(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // ── KAT 1: new mock has zero calls ──────────────────────────────────────
    let m = tmock_new()
    cki("new_call_count", tmock_call_count(m), 0)

    // ── KAT 2: record two calls, count == 2 ─────────────────────────────────
    tmock_record(m, [1, 2])
    tmock_record(m, [3, 4])
    cki("after_two_records", tmock_call_count(m), 2)

    // ── KAT 3: called_with finds a recorded call ─────────────────────────────
    ckb("called_with_12", tmock_called_with(m, [1, 2]), 1)

    // ── KAT 4: called_with returns 0 for unknown args ────────────────────────
    ckb("called_with_99", tmock_called_with(m, [9, 9]), 0)

    // ── KAT 5: nth_call(m,1) returns the second recorded call ────────────────
    let c1 = tmock_nth_call(m, 1)
    cki("nth_call_1_len",  len(c1), 2)
    cki("nth_call_1_elem0", c1[0], 3)
    cki("nth_call_1_elem1", c1[1], 4)

    // ── KAT 6: nth_call(m,0) returns the first recorded call ─────────────────
    let c0 = tmock_nth_call(m, 0)
    cki("nth_call_0_elem0", c0[0], 1)
    cki("nth_call_0_elem1", c0[1], 2)

    // ── KAT 7: set_return / return round-trip ────────────────────────────────
    tmock_set_return(m, 42)
    cki("return_value", tmock_return(m), 42)

    // ── KAT 8: reset clears call log ─────────────────────────────────────────
    tmock_reset(m)
    cki("reset_call_count", tmock_call_count(m), 0)

    // ── KAT 9: reset also clears configured return (back to null) ────────────
    let rv = tmock_return(m)
    if rv != null
        print("FAIL reset_return: expected null after reset")
        exit(1)

    // ── KAT 10: called_with on fresh mock always returns 0 ───────────────────
    ckb("fresh_called_with", tmock_called_with(m, [1, 2]), 0)

    // ── KAT 11: multiple mocks are independent ────────────────────────────────
    let m2 = tmock_new()
    tmock_record(m2, [7, 8])
    cki("m2_count",    tmock_call_count(m2), 1)
    cki("m_count_still_0", tmock_call_count(m),  0)

    // ── KAT 12: called_with is false for a different arg value ────────────────
    ckb("m2_called_12",  tmock_called_with(m2, [1, 2]), 0)
    ckb("m2_called_78",  tmock_called_with(m2, [7, 8]), 1)

    // ── KAT 13: string return value works ────────────────────────────────────
    tmock_set_return(m2, "hello")
    cks("string_return", tmock_return(m2), "hello")

    // ── KAT 14: out-of-range nth_call returns empty list ─────────────────────
    let oob = tmock_nth_call(m, 99)
    cki("oob_nth_len", len(oob), 0)

    print("_mock_test passed")

main()
