import forge_geocoder

fn main()
    let g = geo_new()
    g = geo_add(g, "NYC", 40, -73)
    g = geo_add(g, "LA", 33, -118)
    assert(geo_count(g) == 2, "2 locations")

    let r1 = geo_lookup(g, "NYC")
    assert(is_ok(r1), "NYC found")

    let r2 = geo_lookup(g, "Mars")
    assert(is_err(r2), "Mars not found")

    let lat = geo_lat(g, "NYC")
    assert(is_ok(lat), "lat ok")
    assert(unwrap(lat) == 40, "NYC lat=40")

    let lon = geo_lon(g, "LA")
    assert(is_ok(lon), "lon ok")
    assert(unwrap(lon) == -118, "LA lon=-118")

    let bad = geo_lat(g, "missing")
    assert(is_err(bad), "unknown lat is err")

    assert(geo_total_lookups(g) == 2, "2 lookups")

    print("GEOCODER KAT PASS")
