let x = 10
let y = x if x > 5 else 0
print(y)
assert(y == 10, "ternary failed")

let z = 0 if x > 20 else -1
print(z)
assert(z == -1, "ternary false failed")

let d = {"a": 1, "b": 2, "c": 3}
let dk = keys(d)
let dv = values(d)
print(dk)
print(dv)

let s = "hello world"
let parts = split(s, " ")
print(parts)
assert(len(parts) == 2, "split failed")

let joined = join(["a", "b", "c"], "-")
print(joined)
assert(joined == "a-b-c", "join failed")

let r = replace("hello world", "world", "NOVA")
print(r)
assert(r == "hello NOVA", "replace failed")

let sw = starts_with("hello", "hel")
let ew = ends_with("hello", "llo")
assert(sw, "starts_with failed")
assert(ew, "ends_with failed")

let idx = find("hello world", "world")
print(idx)
assert(idx == 6, "find failed")

let rep = repeat("ab", 3)
print(rep)
assert(rep == "ababab", "repeat failed")

let ch = chars("abc")
print(ch)
assert(len(ch) == 3, "chars failed")

let n = abs(-42)
assert(n == 42, "abs failed")

let sq = sqrt(16.0)
assert(sq == 4.0, "sqrt failed")

let p = pow(2.0, 10.0)
assert(p == 1024.0, "pow failed")

let rd = round(3.7)
assert(rd == 4, "round failed")

let fl = floor(3.7)
assert(fl == 3, "floor failed")

let cl = ceil(3.2)
assert(cl == 4, "ceil failed")

print("ALL FEATURE PROBE 2 PASSED")
