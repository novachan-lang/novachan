import forge_route_planner

fn main()
    let r = rp_new()
    r = rp_add_waypoint(r, "Start", 0, 0)
    r = rp_add_waypoint(r, "Mid", 5, 5)
    r = rp_add_waypoint(r, "End", 10, 10)
    assert(rp_waypoint_count(r) == 3, "3 waypoints")

    r = rp_set_distance(r, "Start", "Mid", 100)
    r = rp_set_distance(r, "Mid", "End", 150)

    let d = rp_distance(r, "Start", "Mid")
    assert(is_ok(d), "distance ok")
    assert(unwrap(d) == 100, "100 units")

    let bad = rp_distance(r, "Start", "End")
    assert(is_err(bad), "no direct route")

    let route = {}
    route["0"] = "Start"
    route["1"] = "Mid"
    route["2"] = "End"
    let total = rp_total_distance(r, route, 3)
    assert(is_ok(total), "total ok")
    assert(unwrap(total) == 250, "250 total")

    let name = rp_waypoint_name(r, 1)
    assert(unwrap(name) == "Mid", "waypoint 1=Mid")

    print("ROUTE-PLANNER KAT PASS")
