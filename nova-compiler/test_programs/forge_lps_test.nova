import forge_lps

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    fails = fails + expect("bbbab", str(longest_palindromic_subseq("bbbab")), "4")
    fails = fails + expect("cbbd", str(longest_palindromic_subseq("cbbd")), "2")
    fails = fails + expect("character", str(longest_palindromic_subseq("character")), "5")
    fails = fails + expect("single", str(longest_palindromic_subseq("a")), "1")
    fails = fails + expect("nopal", str(longest_palindromic_subseq("abc")), "1")
    fails = fails + expect("empty", str(longest_palindromic_subseq("")), "0")
    fails = fails + expect("aba", str(longest_palindromic_subseq("aba")), "3")
    fails = fails + expect("racecar", str(longest_palindromic_subseq("racecar")), "7")
    fails = fails + expect("full_pal", str(longest_palindromic_subseq("abcba")), "5")

    // min insertions to make palindrome
    fails = fails + expect("ins_abc", str(min_insertions_palindrome("abc")), "2")
    fails = fails + expect("ins_aba", str(min_insertions_palindrome("aba")), "0")
    fails = fails + expect("ins_leetcode", str(min_insertions_palindrome("leetcode")), "5")
    fails = fails + expect("ins_empty", str(min_insertions_palindrome("")), "0")

    if fails == 0
        print("forge_lps: all passed")
    else
        print("forge_lps: " + str(fails) + " FAILED")
