// Bootstrap test 16: boolean literals, and/or/not operators
// These are used 194+ times in the self-hosted compiler

fn check(val, expected)
    if val == expected
        print("ok")
    else
        print("FAIL")

// Boolean literals
let t = true
let f = false
check(t, true)
check(f, false)

// not operator
check(not true, false)
check(not false, true)

// and operator (short-circuit)
check(true and true, true)
check(true and false, false)
check(false and true, false)
check(false and false, false)

// or operator (short-circuit)
check(true or true, true)
check(true or false, true)
check(false or true, true)
check(false or false, false)

// Short-circuit verification: side effects
let counter = 0
fn inc_and_true()
    counter = counter + 1
    return true

fn inc_and_false()
    counter = counter + 1
    return false

// false and X should NOT evaluate X
counter = 0
let r1 = false and inc_and_true()
check(counter, 0)

// true or X should NOT evaluate X
counter = 0
let r2 = true or inc_and_true()
check(counter, 0)

// Complex boolean chains
fn classify(x)
    if x > 0 and x < 10
        return "small_pos"
    if x < 0 or x > 100
        return "out_of_range"
    return "other"

print(classify(5))
print(classify(-3))
print(classify(50))
