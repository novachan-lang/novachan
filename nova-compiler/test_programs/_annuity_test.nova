// _annuity_test.nova — KAT for std/finance/annuity
//
// All expected values hand-computed:
//   ann_pv_ordinary(100, 0.05, 10) = 100 * (1 - 1.05^-10) / 0.05
//                                  = 100 * (1 - 0.613913) / 0.05
//                                  = 100 * 7.7217 = 772.17
//
//   ann_fv_ordinary(100, 0.05, 10) = 100 * (1.05^10 - 1) / 0.05
//                                  = 100 * (1.628895 - 1) / 0.05
//                                  = 100 * 12.5779 = 1257.79
//
//   ann_pv_due(100, 0.05, 10)     = 772.17 * 1.05 = 810.78
//   ann_fv_due(100, 0.05, 10)     = 1257.79 * 1.05 = 1320.68
//   ann_perpetuity_pv(100, 0.05)  = 100 / 0.05 = 2000.0
//   ann_payment_from_pv(772.17, 0.05, 10) = 772.17 * 0.05 / (1 - 1.05^-10)
//                                         = 38.6085 / 0.386087 ~ 100.0

import std/finance/annuity

// Float known-answer check within epsilon.
fn ckf(label: string, got: float, want: float, eps: float)
    let diff = got - want
    let adiff = diff
    if diff < 0.0
        adiff = 0.0 - diff
    if adiff > eps
        print("FAIL " + label + ": got " + str(got) + " expected " + str(want))
        exit(1)

fn main()
    // KAT 1: PV of ordinary annuity — 100*(1-1.05^-10)/0.05 = 772.17
    let v1 = ann_pv_ordinary(100.0, 0.05, 10.0)
    ckf("ann_pv_ordinary", v1, 772.17, 0.01)

    // KAT 2: FV of ordinary annuity — 100*(1.05^10-1)/0.05 = 1257.79
    let v2 = ann_fv_ordinary(100.0, 0.05, 10.0)
    ckf("ann_fv_ordinary", v2, 1257.79, 0.01)

    // KAT 3: PV of annuity-due — 772.17 * 1.05 = 810.78
    let v3 = ann_pv_due(100.0, 0.05, 10.0)
    ckf("ann_pv_due", v3, 810.78, 0.01)

    // KAT 4: FV of annuity-due — 1257.79 * 1.05 = 1320.68
    let v4 = ann_fv_due(100.0, 0.05, 10.0)
    ckf("ann_fv_due", v4, 1320.68, 0.01)

    // KAT 5: perpetuity PV — 100 / 0.05 = 2000.0
    let v5 = ann_perpetuity_pv(100.0, 0.05)
    ckf("ann_perpetuity_pv", v5, 2000.0, 0.01)

    // KAT 6: payment from PV — inverse of PV formula, recovers 100.0
    let v6 = ann_payment_from_pv(772.17, 0.05, 10.0)
    ckf("ann_payment_from_pv", v6, 100.0, 0.01)

    // --- canonical-name alias KATs (task-spec) ---

    // KAT 7: perpetuity_pv(100, 0.05) = 100/0.05 = 2000.0
    let pv7 = perpetuity_pv(100.0, 0.05)
    ckf("perpetuity_pv", pv7, 2000.0, 0.01)

    // KAT 8: annuity_payment matches loan_payment logic
    // annuity_payment(pv=10000, rate=0.005, n=60) should equal amt_payment(10000, 0.005, 60)
    // = 193.33 (same as amortization test)
    let ap8 = annuity_payment(10000.0, 0.005, 60)
    ckf("annuity_payment_loan", ap8, 193.33, 0.01)

    // KAT 9: growing_annuity_pv with growth=0 equals regular ann_pv_ordinary
    // growing_annuity_pv(100, 0.05, 0.0, 10) should equal ann_pv_ordinary(100, 0.05, 10) = 772.17
    let ga9 = growing_annuity_pv(100.0, 0.05, 0.0, 10)
    ckf("growing_annuity_zero_growth", ga9, 772.17, 0.05)

    // KAT 10: growing_annuity_pv with positive growth > ann_pv_ordinary (growth boosts PV)
    // growing_annuity_pv(100, 0.10, 0.05, 10):
    // = 100 * (1 - (1.05/1.10)^10) / (0.10 - 0.05)
    // = 100 * (1 - (0.954545...)^10) / 0.05
    // (0.954545)^10 ~ 0.6139
    // = 100 * 0.3861 / 0.05 = 772.2 (very close to ordinary at 10%)
    let ga10 = growing_annuity_pv(100.0, 0.10, 0.05, 10)
    // PV should be > ordinary annuity at same rate (growth adds value)
    let ordinary10 = ann_pv_ordinary(100.0, 0.10, 10.0)
    if ga10 <= ordinary10
        print("FAIL growing_annuity_gt_ordinary: " + str(ga10) + " <= " + str(ordinary10))
        exit(1)

    print("PASS _annuity_test")
