// Bootstrap test 17: index assignment for lists and dicts
// Critical: used hundreds of times in the self-hosted compiler

// Dict creation and assignment
let d = {}
d["x"] = 10
d["y"] = 20
d["z"] = 30
print(d["x"])
print(d["y"])
print(d["z"])

// Dict overwrite
d["x"] = 99
print(d["x"])

// List creation and index assignment
let items = [0, 0, 0, 0, 0]
items[0] = 10
items[2] = 30
items[4] = 50
print(items[0])
print(items[2])
print(items[4])

// Build a dict in a loop (compiler pattern: building symbol tables)
let table = {}
let i = 0
while i < 5
    table[str(i)] = i * i
    i = i + 1
print(table["3"])
print(table["4"])

// Nested dict operations
let outer = {}
outer["a"] = {}
let inner = outer["a"]
inner["val"] = 42
print(inner["val"])
