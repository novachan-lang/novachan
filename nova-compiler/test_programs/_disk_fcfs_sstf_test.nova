import std/scheduling/disk_fcfs_sstf

fn cki(got, want, label)
    if got != want
        print("FAIL disk_fcfs_sstf " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(got, want, label)
    if len(got) != len(want)
        print("FAIL disk_fcfs_sstf " + label + ": got len=" + str(len(got)) + " want len=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL disk_fcfs_sstf " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // KAT 1: dk_fcfs([5,25,18,3],10) = 47
    let req1 = []
    push(req1, 5)
    push(req1, 25)
    push(req1, 18)
    push(req1, 3)
    cki(dk_fcfs(req1, 10), 47, "fcfs_small")

    // KAT 2: dk_sstf([5,25,18,3],10) = 29
    cki(dk_sstf(req1, 10), 29, "sstf_small")

    // KAT 3: dk_sstf_order([5,25,18,3],10) = [5,3,18,25]
    let ord3 = dk_sstf_order(req1, 10)
    let want3 = []
    push(want3, 5)
    push(want3, 3)
    push(want3, 18)
    push(want3, 25)
    ckl(ord3, want3, "sstf_order_small")

    // KAT 4: dk_fcfs_order returns requests in original order
    let ord4 = dk_fcfs_order(req1, 10)
    ckl(ord4, req1, "fcfs_order_small")

    // KAT 5: dk_fcfs([98,183,37,122,14,124,65,67],53) = 640
    let req5 = []
    push(req5, 98)
    push(req5, 183)
    push(req5, 37)
    push(req5, 122)
    push(req5, 14)
    push(req5, 124)
    push(req5, 65)
    push(req5, 67)
    cki(dk_fcfs(req5, 53), 640, "fcfs_large")

    // KAT 6: dk_sstf([98,183,37,122,14,124,65,67],53) = 236
    cki(dk_sstf(req5, 53), 236, "sstf_large")

    // KAT 7: empty requests => 0 movement
    cki(dk_fcfs([], 50), 0, "fcfs_empty")
    cki(dk_sstf([], 50), 0, "sstf_empty")

    // KAT 8: single request
    let req8 = []
    push(req8, 80)
    cki(dk_fcfs(req8, 50), 30, "fcfs_single")
    cki(dk_sstf(req8, 50), 30, "sstf_single")

    // KAT 9: head already at a request cylinder
    let req9 = []
    push(req9, 10)
    push(req9, 20)
    cki(dk_fcfs(req9, 10), 10, "fcfs_head_at_req")
    cki(dk_sstf(req9, 10), 10, "sstf_head_at_req")

    print("PASS _disk_fcfs_sstf_test")
