// NOVA STDLIB — path module
// Cross-platform path manipulation utilities (pure string operations, no filesystem access).
// Uses "/" as the canonical separator internally.
//
// Public API:
//   path_join(parts)                   -> string  (join path components with "/")
//   path_dirname(p)                    -> string  (directory portion)
//   path_basename(p)                   -> string  (filename portion)
//   path_extension(p)                  -> string  (extension including ".", or "")
//   path_stem(p)                       -> string  (filename without extension)
//   path_normalize(p)                  -> string  (collapse "." and ".." segments)
//   path_is_absolute(p)               -> bool    (starts with "/" or drive letter)
//   path_is_relative(p)               -> bool    (not absolute)
//   path_split(p)                     -> list    (split into components)
//   path_with_extension(p, ext)       -> string  (replace extension)
//   path_parent(p)                    -> string  (parent directory, alias for dirname)
//   path_relative(base, target)       -> string  (relative path from base to target)

// ── Internal helpers ─────────────────────────────────────────────────────

// Normalize backslashes to forward slashes
fn _path_to_forward(p) -> string
    replace(p, "\\", "/")

// Check if character at position is an ASCII letter
fn _path_is_letter(ch) -> bool
    let c = ord(ch)
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122)

// Strip trailing slashes, preserving root "/" or "C:/"
fn _path_strip_trailing(p) -> string
    if len(p) == 0
        return ""
    // Don't strip the root slash
    if p == "/"
        return "/"
    // Don't strip drive root like "C:/"
    if len(p) == 3 and _path_is_letter(p[0]) and p[1] == ":" and p[2] == "/"
        return p
    // Strip trailing slashes
    let result = p
    while len(result) > 1 and result[len(result) - 1] == "/"
        result = slice(result, 0, len(result) - 1)
    result

// ── Core functions ───────────────────────────────────────────────────────

fn path_join(parts) -> string
    if len(parts) == 0
        return ""
    let result = ""
    let i = 0
    while i < len(parts)
        let part = _path_to_forward(parts[i])
        if len(part) == 0
            i = i + 1
            continue
        if len(result) == 0
            result = part
        else
            // Avoid double slashes at the join point
            let ends_slash = result[len(result) - 1] == "/"
            let starts_slash = part[0] == "/"
            if ends_slash and starts_slash
                result = result + slice(part, 1, len(part))
            else if ends_slash or starts_slash
                result = result + part
            else
                result = result + "/" + part
        i = i + 1
    result

fn path_dirname(p) -> string
    let s = _path_to_forward(p)
    s = _path_strip_trailing(s)
    if len(s) == 0
        return "."
    // Find last slash
    let last = find(s, "/")
    if last == -1
        return "."
    // Walk forward to find the actual last slash
    let pos = last
    let idx = pos + 1
    while idx < len(s)
        if s[idx] == "/"
            pos = idx
        idx = idx + 1
    // Root case: "/" or "C:/"
    if pos == 0
        return "/"
    // Drive root case: "C:/"
    if pos == 2 and _path_is_letter(s[0]) and s[1] == ":"
        return slice(s, 0, 3)
    slice(s, 0, pos)

fn path_basename(p) -> string
    let s = _path_to_forward(p)
    s = _path_strip_trailing(s)
    if len(s) == 0
        return ""
    // Find last slash
    let pos = -1
    let idx = 0
    while idx < len(s)
        if s[idx] == "/"
            pos = idx
        idx = idx + 1
    if pos == -1
        return s
    slice(s, pos + 1, len(s))

fn path_extension(p) -> string
    let base = path_basename(p)
    if len(base) == 0
        return ""
    // Find last dot (skip leading dots for hidden files like ".gitignore")
    let dot_pos = -1
    let idx = 1
    while idx < len(base)
        if base[idx] == "."
            dot_pos = idx
        idx = idx + 1
    if dot_pos == -1
        return ""
    slice(base, dot_pos, len(base))

fn path_stem(p) -> string
    let base = path_basename(p)
    if len(base) == 0
        return ""
    let ext = path_extension(p)
    if len(ext) == 0
        return base
    slice(base, 0, len(base) - len(ext))

fn path_normalize(p) -> string
    let s = _path_to_forward(p)
    if len(s) == 0
        return "."

    // Detect absolute prefix
    let prefix = ""
    let body = s
    if len(s) >= 1 and s[0] == "/"
        prefix = "/"
        body = slice(s, 1, len(s))
    else if len(s) >= 3 and _path_is_letter(s[0]) and s[1] == ":" and s[2] == "/"
        prefix = slice(s, 0, 3)
        body = slice(s, 3, len(s))

    // Split body into segments
    let segments = split(body, "/")
    let result = []

    let i = 0
    while i < len(segments)
        let seg = segments[i]
        if seg == "" or seg == "."
            // Skip empty and current-dir segments
            i = i + 1
            continue
        if seg == ".."
            if len(result) > 0 and result[len(result) - 1] != ".."
                // Pop the previous segment
                let new_result = []
                let j = 0
                while j < len(result) - 1
                    new_result.push(result[j])
                    j = j + 1
                result = new_result
            else if len(prefix) == 0
                // Relative path: keep the ".."
                result.push("..")
            // If absolute, silently discard ".." above root
        else
            result.push(seg)
        i = i + 1

    if len(result) == 0
        if len(prefix) > 0
            return _path_strip_trailing(prefix)
        return "."

    prefix + join(result, "/")

fn path_is_absolute(p) -> bool
    let s = _path_to_forward(p)
    if len(s) == 0
        return false
    if s[0] == "/"
        return true
    // Check for drive letter pattern: "C:/" or "C:\"
    if len(s) >= 3 and _path_is_letter(s[0]) and s[1] == ":" and s[2] == "/"
        return true
    false

fn path_is_relative(p) -> bool
    not path_is_absolute(p)

fn path_split(p) -> list
    let s = _path_to_forward(p)
    if len(s) == 0
        return []
    let parts = split(s, "/")
    // Filter out empty strings (from leading/trailing/double slashes)
    // but preserve a leading "" to indicate absolute path root
    let result = []
    let i = 0
    while i < len(parts)
        if len(parts[i]) > 0
            result.push(parts[i])
        i = i + 1
    result

fn path_with_extension(p, ext) -> string
    let dir = path_dirname(p)
    let stem = path_stem(p)
    if len(stem) == 0
        return p
    // Ensure ext starts with "."
    let new_ext = ext
    if len(ext) > 0 and ext[0] != "."
        new_ext = "." + ext
    let new_name = stem + new_ext
    if dir == "."
        return new_name
    dir + "/" + new_name

fn path_parent(p) -> string
    path_dirname(p)

fn path_relative(base, target) -> string
    // Normalize both paths
    let nb = path_normalize(base)
    let nt = path_normalize(target)

    // Split into components
    let base_parts = path_split(nb)
    let target_parts = path_split(nt)

    // Find common prefix length
    let common = 0
    let max_common = len(base_parts)
    if len(target_parts) < max_common
        max_common = len(target_parts)
    while common < max_common
        if base_parts[common] != target_parts[common]
            break
        common = common + 1

    // Build the relative path
    let result_parts = []

    // Add ".." for each remaining base component
    let ups = len(base_parts) - common
    let u = 0
    while u < ups
        result_parts.push("..")
        u = u + 1

    // Add remaining target components
    let t = common
    while t < len(target_parts)
        result_parts.push(target_parts[t])
        t = t + 1

    if len(result_parts) == 0
        return "."

    join(result_parts, "/")

// ── Self-test ────────────────────────────────────────────────────────────

fn _path_run_tests()
    // -- path_join --
    assert(path_join(["src", "main.nova"]) == "src/main.nova", "join basic")
    assert(path_join(["a", "b", "c"]) == "a/b/c", "join multi")
    assert(path_join(["/usr", "bin", "nova"]) == "/usr/bin/nova", "join abs")
    assert(path_join(["a/", "/b"]) == "a/b", "join no double slash")
    assert(path_join(["a/", "b"]) == "a/b", "join trailing slash")
    assert(path_join([]) == "", "join empty")
    assert(path_join(["", "a", "", "b"]) == "a/b", "join skip empty")

    // -- path_dirname --
    assert(path_dirname("/foo/bar.txt") == "/foo", "dirname basic")
    assert(path_dirname("/foo/bar/baz") == "/foo/bar", "dirname deep")
    assert(path_dirname("foo.txt") == ".", "dirname no dir")
    assert(path_dirname("/foo") == "/", "dirname root child")
    assert(path_dirname("C:/Users/test/file.txt") == "C:/Users/test", "dirname windows")
    assert(path_dirname("C:/file.txt") == "C:/", "dirname drive root")
    assert(path_dirname("/") == "/", "dirname root")

    // -- path_basename --
    assert(path_basename("/foo/bar.txt") == "bar.txt", "basename basic")
    assert(path_basename("bar.txt") == "bar.txt", "basename no dir")
    assert(path_basename("/foo/bar/") == "bar", "basename trailing slash")
    assert(path_basename("") == "", "basename empty")

    // -- path_extension --
    assert(path_extension("/foo/bar.txt") == ".txt", "ext basic")
    assert(path_extension("archive.tar.gz") == ".gz", "ext double")
    assert(path_extension("Makefile") == "", "ext none")
    assert(path_extension(".gitignore") == "", "ext hidden file")
    assert(path_extension(".config.json") == ".json", "ext hidden with ext")
    assert(path_extension("") == "", "ext empty")

    // -- path_stem --
    assert(path_stem("bar.txt") == "bar", "stem basic")
    assert(path_stem("archive.tar.gz") == "archive.tar", "stem double ext")
    assert(path_stem("Makefile") == "Makefile", "stem no ext")
    assert(path_stem(".gitignore") == ".gitignore", "stem hidden")
    assert(path_stem("/foo/bar.txt") == "bar", "stem with dir")

    // -- path_normalize --
    assert(path_normalize("a/b/../c") == "a/c", "norm dotdot")
    assert(path_normalize("a/./b/./c") == "a/b/c", "norm dots")
    assert(path_normalize("/a/b/../../c") == "/c", "norm abs dotdot")
    assert(path_normalize("a//b///c") == "a/b/c", "norm multi slash")
    assert(path_normalize("../a/b") == "../a/b", "norm relative dotdot")
    assert(path_normalize("/..") == "/", "norm above root")
    assert(path_normalize(".") == ".", "norm just dot")
    assert(path_normalize("") == ".", "norm empty")
    assert(path_normalize("a/b/c") == "a/b/c", "norm clean")

    // -- path_is_absolute / path_is_relative --
    assert(path_is_absolute("/usr/bin"), "abs unix")
    assert(path_is_absolute("C:/Users"), "abs windows")
    assert(not path_is_absolute("src/main"), "rel path")
    assert(not path_is_absolute(""), "empty not abs")
    assert(path_is_relative("src/main"), "is relative")
    assert(not path_is_relative("/usr/bin"), "abs not relative")

    // -- path_split --
    let parts = path_split("/usr/bin/nova")
    assert(len(parts) == 3, "split count")
    assert(parts[0] == "usr", "split[0]")
    assert(parts[1] == "bin", "split[1]")
    assert(parts[2] == "nova", "split[2]")

    let parts2 = path_split("a/b/c")
    assert(len(parts2) == 3, "split relative count")
    assert(parts2[0] == "a", "split rel[0]")

    // -- path_with_extension --
    assert(path_with_extension("foo.txt", ".md") == "foo.md", "with_ext basic")
    assert(path_with_extension("/a/b.txt", ".rs") == "/a/b.rs", "with_ext dir")
    assert(path_with_extension("foo.txt", "md") == "foo.md", "with_ext no dot")
    assert(path_with_extension("Makefile", ".bak") == "Makefile.bak", "with_ext add")

    // -- path_parent (alias for dirname) --
    assert(path_parent("/foo/bar") == "/foo", "parent basic")
    assert(path_parent("a/b/c") == "a/b", "parent relative")

    // -- path_relative --
    assert(path_relative("a/b", "a/c") == "../c", "relative sibling")
    assert(path_relative("a/b/c", "a/d/e") == "../../d/e", "relative diverge")
    assert(path_relative("a/b", "a/b") == ".", "relative same")
    assert(path_relative("a/b", "a/b/c/d") == "c/d", "relative descend")
    assert(path_relative("a/b/c", "a") == "../..", "relative ascend")

    // -- Backslash normalization --
    assert(path_basename("C:\\Users\\test\\file.txt") == "file.txt", "backslash basename")
    assert(path_dirname("C:\\foo\\bar.txt") == "C:/foo", "backslash dirname")

    print("path: ALL PASSED")

_path_run_tests()
