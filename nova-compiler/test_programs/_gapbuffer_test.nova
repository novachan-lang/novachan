import std/collections/gapbuffer

// Helper: check string equality, print FAIL and exit(1) on mismatch.
fn cks(label, got, expected)
    if got == expected
        let _ok = 1
    else
        print("FAIL " + label + ": got=" + got + " expected=" + expected)
        exit(1)

// Helper: check int equality.
fn cki(label, got, expected)
    if got == expected
        let _ok = 1
    else
        print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

// ── KAT 1: gap_new + gap_text on empty string ─────────────────────────────
let g0 = gap_new("")
cks("kat1_empty_text", gap_text(g0), "")
cki("kat1_empty_len",  gap_length(g0), 0)

// ── KAT 2: gap_new with content + gap_text + gap_length ───────────────────
let g = gap_new("hello")
cks("kat2_initial_text", gap_text(g), "hello")
cki("kat2_initial_len",  gap_length(g), 5)

// ── KAT 3: gap_insert at end → "hello world" ──────────────────────────────
gap_insert(g, 5, " world")
cks("kat3_after_insert", gap_text(g), "hello world")
cki("kat3_len_after_insert", gap_length(g), 11)

// ── KAT 4: gap_delete from front → "world" ────────────────────────────────
gap_delete(g, 0, 6)
cks("kat4_after_delete", gap_text(g), "world")
cki("kat4_len_after_delete", gap_length(g), 5)

// ── KAT 5: gap_insert at pos 0 → "the world" ──────────────────────────────
gap_insert(g, 0, "the ")
cks("kat5_insert_front", gap_text(g), "the world")

// ── KAT 6: gap_char_at checks ─────────────────────────────────────────────
cks("kat6_char_at_0", gap_char_at(g, 0), "t")
cks("kat6_char_at_3", gap_char_at(g, 3), " ")
cks("kat6_char_at_last", gap_char_at(g, 8), "d")
cks("kat6_char_at_oob", gap_char_at(g, 99), "")

// ── KAT 7: gap_insert in the middle ───────────────────────────────────────
let g2 = gap_new("abcde")
gap_insert(g2, 2, "XY")
cks("kat7_mid_insert", gap_text(g2), "abXYcde")
cki("kat7_mid_len", gap_length(g2), 7)

// ── KAT 8: gap_delete in the middle ───────────────────────────────────────
gap_delete(g2, 2, 2)
cks("kat8_mid_delete", gap_text(g2), "abcde")

// ── KAT 9: gap_delete clamping past end ───────────────────────────────────
let g3 = gap_new("hi")
gap_delete(g3, 1, 999)
cks("kat9_clamp_delete", gap_text(g3), "h")

print("_gapbuffer_test passed")
