import forge_sparkline

// Build the expected block glyph for level L (0..7): U+2581+L = bytes E2 96 (81+L).
fn expblock(level: int) -> string
    chr(226) + chr(150) + chr(129 + level)

fn main()
    // rising ramp 1..8 maps to levels 0..7, one block glyph each. Byte length = 8 glyphs * 3 = 24.
    let s = sparkline([1, 2, 3, 4, 5, 6, 7, 8])
    print("len=" + str(len(s)) + " points=" + str(sparkline_points(s)))
    // exact expected string: the eight block glyphs in ascending intensity.
    let want = expblock(0) + expblock(1) + expblock(2) + expblock(3) + expblock(4) + expblock(5) + expblock(6) + expblock(7)
    print("ramp_exact=" + str(s == want))
    // first codepoint = lowest block, last = full block (codepoint-indexed char_at)
    print("first_is_low=" + str(char_at(s, 0) == expblock(0)))
    print("last_is_full=" + str(char_at(s, 7) == expblock(7)))
    // flat series -> all baseline (level 0), 3 glyphs
    let f = sparkline([5, 5, 5])
    print("flat_exact=" + str(f == expblock(0) + expblock(0) + expblock(0)) + " flatpts=" + str(sparkline_points(f)))
    // single value -> one baseline glyph (span 0)
    print("single=" + str(sparkline([42]) == expblock(0)))
    // empty
    print("empty=" + str(len(sparkline([])) == 0))
    // negatives + descending: max at front -> full block first, min at back -> baseline last
    let d = sparkline([10, 0, -10])
    print("desc_first_full=" + str(char_at(d, 0) == expblock(7)) + " desc_last_low=" + str(char_at(d, 2) == expblock(0)))
