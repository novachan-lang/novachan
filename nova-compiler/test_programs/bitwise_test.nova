fn run()
    // AND, OR, XOR
    let a = 0xFF
    let b = 0x0F
    assert(a & b == 0x0F, "AND failed")
    assert(a | b == 0xFF, "OR failed")
    assert(a ^ b == 0xF0, "XOR failed")

    // Shifts
    assert(1 << 4 == 16, "SHL failed")
    assert(256 >> 4 == 16, "SHR failed")

    // Bitwise NOT
    assert(~0 == -1, "NOT 0 failed")
    assert(~1 == -2, "NOT 1 failed")

    // Binary literals
    let flags = 0b1010
    assert((flags & 0b1000) == 0b1000, "mask failed")
    assert((flags | 0b0001) == 0b1011, "set bit failed")
    assert((flags ^ 0b1111) == 0b0101, "toggle failed")

    // Precedence: & binds tighter than ==
    let x = 0xFF
    assert(x & 0x0F == 15, "precedence failed")

    print("BITWISE: ALL PASSED")

run()
