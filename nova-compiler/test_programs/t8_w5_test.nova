fn alloc_drop_loop(iters: int) -> int
    let total = 0
    let i = 0
    while i < iters
        let xs = []
        let j = 0
        while j < 100
            xs.push(j)
            j = j + 1
        total = total + len(xs)
        list_free_local(xs)
        i = i + 1
    total

fn main()
    let n = alloc_drop_loop(50)
    print(n)
    print("Track 8 W5: list_free_local primitive works — 50x build-and-drop cycle completed")
