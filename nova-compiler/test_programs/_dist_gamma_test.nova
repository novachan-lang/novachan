// _dist_gamma_test.nova — KAT for std/numeric/dist_gamma
import std/numeric/dist_gamma

fn approx(a, b, tol) -> float
    let af = a * 1.0
    let bf = b * 1.0
    let tf = tol * 1.0
    let d = af - bf
    if d < 0.0
        d = 0.0 - d
    if d < tf
        return 1.0
    return 0.0

fn check(name, got, want, tol)
    let af = got * 1.0
    let bf = want * 1.0
    let tf = tol * 1.0
    let ok = approx(af, bf, tf)
    if ok < 1.0
        print("FAIL " + name + ": got=" + str(af) + " want=" + str(bf))
        exit(1)

fn main()
    // gamma_mean(2.0, 1.0) = 2/1 = 2.0
    let m1 = gamma_mean(2.0, 1.0)
    check("gamma_mean(2,1)=2", m1, 2.0, 0.001)

    // gamma_mean(3.0, 2.0) = 3/2 = 1.5
    let m2 = gamma_mean(3.0, 2.0)
    check("gamma_mean(3,2)=1.5", m2, 1.5, 0.001)

    // gamma_mean(1.0, 1.0) = 1.0 (exponential with rate=1)
    let m3 = gamma_mean(1.0, 1.0)
    check("gamma_mean(1,1)=1", m3, 1.0, 0.001)

    // gamma with shape=1 equals exponential: pdf(x; 1, lambda) = lambda*exp(-lambda*x)
    // gamma_pdf(1.0, 1.0, 1.0) = exp(-1) ~ 0.3679
    let p1 = gamma_pdf(1.0, 1.0, 1.0)
    check("gamma_pdf(1,1,1)=0.3679", p1, 0.3679, 0.001)

    // gamma_pdf(2.0, 1.0, 1.0) = exp(-2) ~ 0.1353
    let p2 = gamma_pdf(2.0, 1.0, 1.0)
    check("gamma_pdf(2,1,1)=0.1353", p2, 0.1353, 0.001)

    // gamma_pdf(x, ...) == 0 for x < 0
    let pneg = gamma_pdf(0.0 - 1.0, 2.0, 1.0)
    check("gamma_pdf(-1,2,1)=0", pneg, 0.0, 0.001)

    // gamma_pdf(0, 2, 1) = 0 (shape > 1)
    let p0 = gamma_pdf(0.0, 2.0, 1.0)
    check("gamma_pdf(0,2,1)=0", p0, 0.0, 0.001)

    // gamma_pdf(1.0, 2.0, 1.0) = 1.0 * exp(-1) * 1^1 / Gamma(2) = exp(-1) ~ 0.3679
    // rate^shape * x^(shape-1) * exp(-rate*x) / Gamma(shape)
    // = 1^2 * 1^1 * exp(-1) / 1! = exp(-1) ~ 0.3679
    let p12 = gamma_pdf(1.0, 2.0, 1.0)
    check("gamma_pdf(1,2,1)=0.3679", p12, 0.3679, 0.001)

    // gamma_pdf(2.0, 2.0, 1.0) = 1^2 * 2^1 * exp(-2) / 1 = 2*exp(-2) ~ 0.2707
    let p22 = gamma_pdf(2.0, 2.0, 1.0)
    check("gamma_pdf(2,2,1)=0.2707", p22, 0.2707, 0.002)

    // gamma_pdf(1.0, 2.0, 2.0) = 2^2 * 1^1 * exp(-2) / 1 = 4*exp(-2) ~ 0.5413
    let p122 = gamma_pdf(1.0, 2.0, 2.0)
    check("gamma_pdf(1,2,2)=0.5413", p122, 0.5413, 0.002)

    // gamma_cdf(0, shape, rate) = 0 for any shape, rate
    let c0 = gamma_cdf(0.0, 2.0, 1.0)
    check("gamma_cdf(0,2,1)=0", c0, 0.0, 0.001)

    // For shape=1 (exponential with rate=1): cdf(x) = 1 - exp(-x)
    // gamma_cdf(1.0, 1.0, 1.0) = 1 - exp(-1) ~ 0.6321
    let ce1 = gamma_cdf(1.0, 1.0, 1.0)
    check("gamma_cdf(1,1,1)=0.6321", ce1, 0.6321, 0.005)

    // gamma_cdf(2.0, 1.0, 1.0) = 1 - exp(-2) ~ 0.8647
    let ce2 = gamma_cdf(2.0, 1.0, 1.0)
    check("gamma_cdf(2,1,1)=0.8647", ce2, 0.8647, 0.005)

    // CDF is monotone: cdf(1) < cdf(2) for shape=2, rate=1
    let cm1 = gamma_cdf(1.0, 2.0, 1.0)
    let cm2 = gamma_cdf(2.0, 2.0, 1.0)
    let cm3 = gamma_cdf(4.0, 2.0, 1.0)
    if cm1 >= cm2
        print("FAIL gamma_cdf not monotone at (1,2)")
        exit(1)
    if cm2 >= cm3
        print("FAIL gamma_cdf not monotone at (2,4)")
        exit(1)

    // gamma_cdf(large x, 2, 1) approx 1
    let clarge = gamma_cdf(20.0, 2.0, 1.0)
    check("gamma_cdf(20,2,1) ~= 1", clarge, 1.0, 0.01)

    print("PASS _dist_gamma_test")
