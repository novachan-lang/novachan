// GAP 5: module-level non-scalar STORAGE. Top-level `let` dict/list are ONE shared
// instance that NAMED FUNCTIONS read + mutate (before the fix, a function got a zero-
// init'd per-fn copy and saw nothing). Also tests reassignment of a baked var.

let registry = {}
let events = []
let config = {"limit": 10, "retries": 3}
let primes = [2, 3, 5, 7, 11]

fn config_limit() -> int
    return config["limit"]

fn nth_prime(i: int) -> int
    return primes[i]

fn register(name: string, val: int)
    registry[name] = val

fn count() -> int
    return len(registry)

fn add_event(msg: string)
    push(events, msg)

fn swap_registry() -> int
    // reassignment of a baked var (const_set path) followed by a read
    registry = {}
    registry["fresh"] = 99
    return registry["fresh"]

fn uses_local_shadow() -> int
    // a LOCAL `let registry` shadows the module var (Edit 4 guard): reads/writes here
    // must hit the local slot, leaving the module registry untouched.
    let registry = {}
    registry["only_local"] = 7
    return len(registry)

fn main() -> int
    let fails = 0

    // named functions mutate the shared module dict; nova_main sees the mutations
    register("a", 1)
    register("b", 2)
    register("c", 3)
    if count() != 3
        print("FAIL count=" + str(count()))
        fails = fails + 1
    if registry["b"] != 2
        print("FAIL registry[b]")
        fails = fails + 1

    // nova_main mutates the shared dict; a function sees it
    registry["d"] = 4
    if count() != 4
        print("FAIL count after direct set=" + str(count()))
        fails = fails + 1

    // shared module list, mutated by a named function
    add_event("start")
    add_event("middle")
    add_event("end")
    if len(events) != 3
        print("FAIL events len=" + str(len(events)))
        fails = fails + 1
    if events[0] != "start"
        print("FAIL events[0]")
        fails = fails + 1

    // reassignment of a baked var (const_set releases the old dict), then read it back
    let fresh = swap_registry()
    if fresh != 99
        print("FAIL swap_registry=" + str(fresh))
        fails = fails + 1
    // the whole-var reassignment is visible to nova_main (shared handle updated)
    if count() != 1
        print("FAIL count after swap=" + str(count()))
        fails = fails + 1

    // a function-local `let registry` shadows the module var and does NOT disturb it
    if uses_local_shadow() != 1
        print("FAIL shadow local len")
        fails = fails + 1
    if count() != 1
        print("FAIL module registry disturbed by shadow=" + str(count()))
        fails = fails + 1

    // literal-populated baked containers read from a named function (self-contained bake)
    if config_limit() != 10
        print("FAIL config_limit=" + str(config_limit()))
        fails = fails + 1
    if nth_prime(3) != 7
        print("FAIL nth_prime=" + str(nth_prime(3)))
        fails = fails + 1

    if fails == 0
        print("PASS _kat_module_state")
    else
        print("FAILED _kat_module_state")
    return 0
