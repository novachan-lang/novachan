import forge_bloom_filter

fn main()
    let b = bf_new(1000, 3)
    b = bf_add(b, "hello")
    b = bf_add(b, "world")
    assert(bf_count(b) == 2, "2 added")
    assert(bf_size(b) == 1000, "size 1000")

    assert(bf_might_contain(b, "hello") == 1, "contains hello")
    assert(bf_might_contain(b, "world") == 1, "contains world")
    assert(bf_might_contain(b, "xyz_not_here") == 0, "not contains xyz")

    print("BLOOM-FILTER KAT PASS")
