// _timed_park_test -- the netpoller timed park (Phase 3): tcp_wait_readable(fd, ms) PARKS a green task on
// the socket with a deadline and returns 1 if it became readable, 0 if the timeout elapsed. Unlike a
// busy-poll (select_timeout), it yields the carrier, so it neither spins the CPU nor starves the netpoller.
// The basis for WebSocket keepalive (wake on idle to send a ping). Verifies: wakes on data (1), and wakes
// on timeout with NO data (0) -- after actually waiting, not instantly.

fn _server(port: int, res)
    let lis = tcp_listen(port)
    let c = tcp_accept(lis)
    // (1) wait up to 2s for the client's data -- it arrives ~200ms in, so this returns 1 (readable)
    let r1 = tcp_wait_readable(c, 2000)
    let got = ""
    if r1 == 1
        got = tcp_recv(c)
    // (2) wait 300ms with no further data -> times out -> 0 (and it must actually have waited)
    let t0 = time_ms()
    let r2 = tcp_wait_readable(c, 300)
    let waited = time_ms() - t0
    send(res, str(r1) + "|" + str(r2) + "|" + got + "|" + str(waited))
    tcp_close(c)
    tcp_close(lis)

fn main()
    let port = 19390
    let res = channel()
    spawn fn()
        _server(port, res)
    sleep(300)
    let cli = tcp_connect("127.0.0.1", port)
    sleep(200)
    tcp_send(cli, "ping")
    let r = recv(res)
    tcp_close(cli)
    // r = "r1|r2|got|waited"
    let parts = split(r, "|")
    assert(parts[0] == "1", "wait_readable returned 1 when data arrived (got r1=" + parts[0] + ")")
    assert(parts[1] == "0", "wait_readable returned 0 on timeout with no data (got r2=" + parts[1] + ")")
    assert(parts[2] == "ping", "the data read after a readable wake was correct (got '" + parts[2] + "')")
    let waited = parse_int(parts[3])
    assert(waited >= 250, "the timeout park actually WAITED ~300ms, not a busy-spin instant return (waited " + parts[3] + "ms)")
    print("PASS: tcp_wait_readable -- 1 on data, 0 on timeout, parked ~" + parts[3] + "ms (no busy-spin)")
    print("_timed_park_test passed")
