// KAT test for std/tree/tree_dp_mis.
import std/tree/tree_dp_mis

fn cki(name, got, want)
    if got != want
        print("FAIL " + name + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("ok " + name)

fn main()
    // KAT 1: path of 4 nodes: 0-1-2-3, MIS = {0,2} or {0,3} or {1,3} -> size 2
    let a1 = []
    let r1a = []
    r1a.push(1)
    a1.push(r1a)
    let r1b = []
    r1b.push(0)
    r1b.push(2)
    a1.push(r1b)
    let r1c = []
    r1c.push(1)
    r1c.push(3)
    a1.push(r1c)
    let r1d = []
    r1d.push(2)
    a1.push(r1d)
    cki("path4 mis_size", tm_mis_size(a1, 4), 2)

    // KAT 2: star of 4: 0 center, leaves 1,2,3 -> MIS = {1,2,3} size 3
    let a2 = []
    let r2a = []
    r2a.push(1)
    r2a.push(2)
    r2a.push(3)
    a2.push(r2a)
    let r2b = []
    r2b.push(0)
    a2.push(r2b)
    let r2c = []
    r2c.push(0)
    a2.push(r2c)
    let r2d = []
    r2d.push(0)
    a2.push(r2d)
    cki("star4 mis_size", tm_mis_size(a2, 4), 3)

    // KAT 3: tree with 5 nodes: 0-1, 0-2, 1-3, 1-4
    // adj=[[1,2],[0,3,4],[0],[1],[1]], n=5
    // Options: {0,3,4,2} size 4? Check: 0 adj 1,2. 2 adj 0. 3 adj 1. 4 adj 1.
    // {0,3,4}: 0 not adj 3, 0 not adj 4, 3 not adj 4 = valid size 3
    // {2,3,4}: 2 adj 0 only, 3 adj 1 only, 4 adj 1 only. None adjacent to each other = valid size 3
    // {0,2,3,4}: 0-2 ARE adjacent -> invalid
    // So MIS = 3
    let a3 = []
    let r3a = []
    r3a.push(1)
    r3a.push(2)
    a3.push(r3a)
    let r3b = []
    r3b.push(0)
    r3b.push(3)
    r3b.push(4)
    a3.push(r3b)
    let r3c = []
    r3c.push(0)
    a3.push(r3c)
    let r3d = []
    r3d.push(1)
    a3.push(r3d)
    let r3e = []
    r3e.push(1)
    a3.push(r3e)
    cki("tree5 mis_size", tm_mis_size(a3, 5), 3)

    // KAT 4: single node -> MIS size = 1
    let a4 = []
    let r4a = []
    a4.push(r4a)
    cki("single mis_size", tm_mis_size(a4, 1), 1)

    // KAT 5: weighted mis: adj=[[1],[0]], n=2, weights=[5,3] -> MIS={0} weight 5
    let a5 = []
    let r5a = []
    r5a.push(1)
    a5.push(r5a)
    let r5b = []
    r5b.push(0)
    a5.push(r5b)
    let w5 = []
    w5.push(5)
    w5.push(3)
    cki("path2 weighted mis", tm_mis_weighted(a5, 2, w5), 5)

    // KAT 6: weighted star: adj=[[1,2,3],[0],[0],[0]], weights=[10,3,3,3]
    // Center weight=10 vs leaves sum=9 -> take center {0} weight 10
    let w6 = []
    w6.push(10)
    w6.push(3)
    w6.push(3)
    w6.push(3)
    cki("star4 weighted mis center", tm_mis_weighted(a2, 4, w6), 10)

    // KAT 7: weighted star leaves win: weights=[1,5,5,5]
    // Leaves sum = 15 > center=1 -> take leaves
    let w7 = []
    w7.push(1)
    w7.push(5)
    w7.push(5)
    w7.push(5)
    cki("star4 weighted mis leaves", tm_mis_weighted(a2, 4, w7), 15)

    print("PASS _tree_dp_mis_test")
