import forge_hyperloglog

fn main()
    let h = hll_new(64)
    h = hll_add(h, "a")
    h = hll_add(h, "b")
    h = hll_add(h, "c")
    h = hll_add(h, "a")
    assert(hll_total_added(h) == 4, "4 total added")
    assert(hll_filled_registers(h) >= 1, "at least 1 filled")

    let est = hll_estimate(h)
    assert(est >= 1, "estimate >= 1")

    print("HYPERLOGLOG KAT PASS")
