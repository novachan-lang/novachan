import std/util/prng

fn main()
    // prng_seed never returns 0 and is deterministic for the same seed.
    assert(prng.prng_seed(0) != 0, "seed(0) must be non-zero")
    assert(prng.prng_seed(42) == prng.prng_seed(42), "seed is deterministic")
    assert(prng.prng_seed(1) != prng.prng_seed(2), "different seeds differ")

    // prng_next returns [value, state]: length 2, non-negative value, deterministic.
    let s0 = prng.prng_seed(42)
    let n1 = prng.prng_next(s0)
    assert(len(n1) == 2, "prng_next returns a pair")
    assert(n1[0] >= 0, "prng_next value is non-negative")
    let n1b = prng.prng_next(s0)
    assert(n1b[0] == n1[0], "prng_next is deterministic")

    // prng_range single-point and inverted-range defensive behavior.
    let rp = prng.prng_range(s0, 7, 7)
    assert(rp[0] == 7, "single-point range yields lo")
    let rinv = prng.prng_range(s0, 9, 3)
    assert(rinv[0] == 9, "inverted range collapses to lo")
    let rng = prng.prng_range(s0, 10, 20)
    assert(rng[0] >= 10, "range value >= lo")
    assert(rng[0] <= 20, "range value <= hi")

    // prng_take: exact count, empty for count 0, reproducible for same seed.
    let seq = prng.prng_take(prng.prng_seed(2026), 5)
    assert(len(seq) == 5, "prng_take returns exactly count items")
    let seqEmpty = prng.prng_take(prng.prng_seed(1), 0)
    assert(len(seqEmpty) == 0, "prng_take with count 0 is empty")
    let seq2 = prng.prng_take(prng.prng_seed(2026), 5)
    assert(seq[0] == seq2[0], "same seed reproduces the same sequence")

    print("prng_lib_test passed")
