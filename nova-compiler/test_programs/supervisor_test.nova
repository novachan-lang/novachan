// Fault-tolerant supervision (Erlang's core FT idea) in NOVA: a supervisor spawns a
// worker; if the worker signals failure, the supervisor restarts it (up to a limit)
// until it succeeds. Uses spawn + channel rendezvous (deterministic, no timing).
// Oracle: the worker fails on attempts 0 and 1, succeeds on attempt 2, so the
// supervisor recovers after EXACTLY 2 restarts with the success payload.
// (Scope: restart-on-signaled-failure — the supervision/restart pillar. True OS-crash
//  isolation across processes is the deeper Track-8 ownership-model work.)
fn main()
    let result_ch = channel()
    let attempt = 0
    let max_restarts = 5
    let done = 0
    let payload = 0
    while done == 0 and attempt <= max_restarts
        let a = attempt
        spawn fn()
            if a < 2
                send(result_ch, 0)          // 0 = worker failed
            else
                send(result_ch, 100 + a)    // success payload
        let r = receive(result_ch)
        if r == 0
            print("worker failed on attempt {attempt} — supervisor restarting")
            attempt = attempt + 1
        else
            payload = r
            done = 1
    assert_eq(done, 1)
    assert_eq(attempt, 2)
    assert_eq(payload, 102)
    print("supervisor test passed: recovered after {attempt} restarts (payload {payload})")
