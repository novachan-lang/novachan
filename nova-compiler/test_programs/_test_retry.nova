@retry
fn fetch_default() -> string
    return "data"

@retry("5")
fn fetch_custom() -> string
    return "custom"

fn main()
    assert(fetch_default__max_retries() == 3, "default retries")
    assert(fetch_default__is_retryable() == 1, "is retryable")

    assert(fetch_custom__max_retries() == 5, "custom retries")
    assert(fetch_custom__is_retryable() == 1, "custom is retryable")

    let r1 = fetch_default()
    assert(r1 == "data", "fn still works")

    let r2 = fetch_custom()
    assert(r2 == "custom", "custom fn works")

    print("RETRY ANNOTATION TEST PASS")
