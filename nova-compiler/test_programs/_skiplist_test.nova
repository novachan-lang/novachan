// KAT test for std/collections/skiplist
import std/collections/skiplist

fn cki(got, want, label)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(got, want, label)
    if got != want
        print("FAIL " + label + ": got " + got + " want " + want)
        exit(1)

fn main()
    let t = sk_new()

    // Insert: 3,1,4,1,5,9,2,6  — duplicate 1 should be silently ignored
    sk_insert(t, 3)
    sk_insert(t, 1)
    sk_insert(t, 4)
    sk_insert(t, 1)
    sk_insert(t, 5)
    sk_insert(t, 9)
    sk_insert(t, 2)
    sk_insert(t, 6)

    // KAT 1: size should be 7 (duplicate 1 not counted)
    cki(sk_size(t), 7, "size after insert")

    // KAT 2: ascending order via sk_to_list
    let lst = sk_to_list(t)
    cki(len(lst), 7, "list len")
    cki(lst[0], 1, "list[0]")
    cki(lst[1], 2, "list[1]")
    cki(lst[2], 3, "list[2]")
    cki(lst[3], 4, "list[3]")
    cki(lst[4], 5, "list[4]")
    cki(lst[5], 6, "list[5]")
    cki(lst[6], 9, "list[6]")

    // KAT 3: membership
    cki(sk_contains(t, 4), 1, "contains 4")
    cki(sk_contains(t, 7), 0, "not contains 7")

    // KAT 4: min and max
    cki(sk_min(t), 1, "min")
    cki(sk_max(t), 9, "max")

    // KAT 5: delete 4, then verify
    sk_delete(t, 4)
    cki(sk_contains(t, 4), 0, "contains 4 after delete")
    cki(sk_size(t), 6, "size after delete")

    // KAT 6: to_list after delete
    let lst2 = sk_to_list(t)
    cki(len(lst2), 6, "list2 len")
    cki(lst2[0], 1, "list2[0]")
    cki(lst2[1], 2, "list2[1]")
    cki(lst2[2], 3, "list2[2]")
    cki(lst2[3], 5, "list2[3]")
    cki(lst2[4], 6, "list2[4]")
    cki(lst2[5], 9, "list2[5]")

    print("_skiplist_test passed")
