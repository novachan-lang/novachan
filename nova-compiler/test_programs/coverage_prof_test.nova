// Phase 9/14: LCOV coverage export, flamegraph export, ABI version stamp

fn do_work(n: int) -> int
    let result = 0
    let i = 0
    while i < n
        result = result + i
        i = i + 1
    result

fn main()
    // Exercise profiler
    let tid = prof_start("do_work")
    let r = do_work(100)
    prof_stop(tid)
    assert_eq(r, 4950)

    // Flamegraph export — writes a collapsed-stack file when profiler has data
    let flame_path = "test_flame.txt"
    let flame_rc = prof_export_flame(flame_path)
    if flame_rc == 0
        let flame_content = read_file(flame_path)
        assert_eq(len(flame_content) > 0, true)
        assert_eq(contains(flame_content, "do_work"), true)
    else
        // flame_rc == -1 means no profiler data: acceptable if prof_start wasn't active
        assert_eq(flame_rc, -1)

    // ABI version — must be 1.0.0 = (1<<16)|(0<<8)|0 = 65536
    let v = abi_version()
    assert_eq(v, 65536)

    // Coverage export runs at process exit (atexit hook), but we can call
    // cov_export_lcov explicitly on any path recorded so far.
    // With --cov the compiler injects cov_hit calls; without it the table
    // is empty and the export writes nothing (returns -1). Either is valid.
    let lcov_rc = cov_export_lcov("test_coverage.lcov")
    if lcov_rc == 0
        let lcov_content = read_file("test_coverage.lcov")
        if len(lcov_content) > 0
            assert_eq(contains(lcov_content, "SF:"), true)
            assert_eq(contains(lcov_content, "end_of_record"), true)

    print("coverage_prof_test passed")
