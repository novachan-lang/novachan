import forge_orm
type BR
    id: int
    label: string
    n: int
fn main()
    let db = unwrap(orm_open_with_pool("postgres://postgres:root@127.0.0.1:5432/postgres", 2))
    _ = orm_exec(db, "DROP TABLE IF EXISTS bdiag", [])
    _ = orm_exec(db, "CREATE TABLE bdiag (id int, label text, n int)", [])
    // small batch, 3 rows
    let rows = [BR(i, "r{i}", i * 2) for i in 0..200]
    let r = orm_insert_many(db, "bdiag", rows)
    print("batch result: is_ok={is_ok(r)}")
    if is_ok(r)
        print("  affected reported = {str(unwrap(r))}")
    else
        print("  ERR = {unwrap_err(r)}")
    let cnt = orm_count(db, "bdiag", "", [])
    print("actual row count = {cnt}")
    let got = orm_all(db, "SELECT id, label, n FROM bdiag ORDER BY id", [])
    print("rows returned = {len(got)}")
    if len(got) > 0
        print("  first={str(got[0]["id"])} last={str(got[len(got)-1]["id"])}")
    _ = orm_exec(db, "DROP TABLE IF EXISTS bdiag", [])
    orm_close(db)
