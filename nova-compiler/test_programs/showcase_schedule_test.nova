// showcase_schedule_test.nova
// A recurring-event scheduler exercising datetime arithmetic, month rollover,
// and — critically — negative-epoch round-trip for pre-1970 dates.
//
// BUG-HUNT FOCUS: floor-div / floor-mod on negative epochs.
// If dt_from_epoch(-604800) gives wrong Y/M/D that is the floor-div bug.

import std/time/datetime
import std/time/duration

fn _fail(label, got, expected)
    print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
    exit(1)

fn _fail_s(label, got, expected)
    print("FAIL " + label + ": got " + got + " expected " + expected)
    exit(1)

fn _assert_eq(label, got, expected)
    if got != expected
        _fail(label, got, expected)

fn _assert_eq_s(label, got, expected)
    if got != expected
        _fail_s(label, got, expected)

fn main()
    // ── 1. Duration round-trip ────────────────────────────────────────────────
    // dur_parse / dur_format must be inverses on canonical strings.
    let week_secs = 7 * 86400     // 604800
    _assert_eq("dur/week_secs", week_secs, 604800)

    let parsed_week = dur_parse("7d")
    _assert_eq("dur/parse_7d", parsed_week, 604800)

    let formatted = dur_format(604800)
    _assert_eq_s("dur/format_604800", formatted, "7d")

    // Unknown unit "w" must return -1
    let bad_unit = dur_parse("1w")
    _assert_eq("dur/bad_unit_w", bad_unit, -1)

    // "garbage" must return -1
    let bad_garbage = dur_parse("garbage")
    _assert_eq("dur/garbage", bad_garbage, -1)

    // Mixed units
    let mixed = dur_parse("1d12h")
    _assert_eq("dur/1d12h", mixed, 129600)

    let mixed_fmt = dur_format(93784)
    _assert_eq_s("dur/fmt_93784", mixed_fmt, "1d2h3m4s")

    // ── 2. Epoch for base date: 2026-01-31T12:00:00Z ─────────────────────────
    // Hand-calculate:
    //   Days from 1970-01-01 to 2026-01-31
    //   Leap years 1970..2025: 1972,1976,1980,1984,1988,1992,1996,2000,2004,2008,2012,2016,2020,2024 = 14 leaps
    //   Years 1970-2025 = 56 years -> 56*365 + 14 = 20454 days to 2026-01-01
    //   + 30 more days (Jan has 31 days; Jan 31 = day 31 = 30 past Jan 1) = 20484 total days
    //   20484 * 86400 = 1769817600, + 12*3600 = +43200 -> 1769860800
    //   Verified via PowerShell [DateTimeOffset]::new(2026,1,31,12,0,0,Zero).ToUnixTimeSeconds()
    let base_epoch = dt_parse_iso("2026-01-31T12:00:00Z")
    _assert_eq("parse/base_epoch", base_epoch, 1769860800)

    // Verify round-trip via dt_format_iso
    let base_iso = dt_format_iso(base_epoch)
    _assert_eq_s("format/base_iso", base_iso, "2026-01-31T12:00:00Z")



    // ── 3. Weekly schedule: 5 occurrences ────────────────────────────────────
    // Jan 31 + 7d = Feb  7
    // Feb  7 + 7d = Feb 14
    // Feb 14 + 7d = Feb 21
    // Feb 21 + 7d = Feb 28
    // Feb 28 + 7d = Mar  7   (2026 is not a leap year)

    let expected_years = [2026, 2026, 2026, 2026, 2026]
    let expected_months = [2, 2, 2, 2, 3]
    let expected_days = [7, 14, 21, 28, 7]
    let expected_isos = ["2026-02-07T12:00:00Z", "2026-02-14T12:00:00Z", "2026-02-21T12:00:00Z", "2026-02-28T12:00:00Z", "2026-03-07T12:00:00Z"]

    let ep = base_epoch
    let i = 0
    while i < 5
        ep = dt_add_days(ep, 7)
        let dt = dt_from_epoch(ep)

        let yr = dt["year"]
        let mo = dt["month"]
        let dy = dt["day"]
        let iso = dt_format_iso(ep)

        let label_base = "occ[" + str(i) + "]"
        _assert_eq(label_base + "/year", yr, expected_years[i])
        _assert_eq(label_base + "/month", mo, expected_months[i])
        _assert_eq(label_base + "/day", dy, expected_days[i])
        _assert_eq_s(label_base + "/iso", iso, expected_isos[i])
        i = i + 1

    // ── 4. dt_to_epoch / dt_from_epoch consistency on base ───────────────────
    let ep2 = dt_to_epoch(2026, 1, 31, 12, 0, 0)
    _assert_eq("to_epoch/base", ep2, 1769860800)

    let dt2 = dt_from_epoch(ep2)
    _assert_eq("from_epoch/year",  dt2["year"],    2026)
    _assert_eq("from_epoch/month", dt2["month"],   1)
    _assert_eq("from_epoch/day",   dt2["day"],     31)
    _assert_eq("from_epoch/hour",  dt2["hour"],    12)
    _assert_eq("from_epoch/min",   dt2["min"],     0)
    _assert_eq("from_epoch/sec",   dt2["sec"],     0)

    // Weekday: 2026-01-31 is a Saturday (6).
    // 1970-01-01 = Thursday = 4.  days = 20484.
    // 20484 mod 7 = 20484 / 7 = 2926*7 = 20482 rem 2 → (2 + 4) mod 7 = 6 = Sat. ✓
    _assert_eq("from_epoch/weekday", dt2["weekday"], 6)

    // ── 5. Pre-1970 negative-epoch round-trip: THE KEY BUG-HUNT TEST ─────────
    // 1969-12-25T00:00:00Z = Christmas Day 1969.
    // Days from 1970-01-01: it is 7 days BEFORE, so days = -7.
    // epoch = -7 * 86400 = -604800.
    let xmas_epoch = dt_parse_iso("1969-12-25T00:00:00Z")
    _assert_eq("neg_epoch/parse", xmas_epoch, -604800)

    // Round-trip: dt_from_epoch(-604800) must give 1969-12-25.
    // This is where floor-div bugs surface: if the runtime uses C truncation
    // instead of floor-div, days = -604800 / 86400 = -6 (trunc), not -7 (floor).
    // That pushes the date to 1969-12-26 instead of 1969-12-25 — a real defect.
    let xmas_dt = dt_from_epoch(xmas_epoch)
    _assert_eq("neg_epoch/year",  xmas_dt["year"],  1969)
    _assert_eq("neg_epoch/month", xmas_dt["month"], 12)
    _assert_eq("neg_epoch/day",   xmas_dt["day"],   25)
    _assert_eq("neg_epoch/hour",  xmas_dt["hour"],  0)
    _assert_eq("neg_epoch/min",   xmas_dt["min"],   0)
    _assert_eq("neg_epoch/sec",   xmas_dt["sec"],   0)

    // Weekday: 1969-12-25 is a Thursday = 4.
    // days = -7.  floor-mod: ((-7 mod 7) + 4 + 7) mod 7 = (0 + 4 + 7) mod 7 = 11 mod 7 = 4. ✓
    _assert_eq("neg_epoch/weekday", xmas_dt["weekday"], 4)

    // Format round-trip
    let xmas_iso = dt_format_iso(xmas_epoch)
    _assert_eq_s("neg_epoch/iso", xmas_iso, "1969-12-25T00:00:00Z")

    // ── 6. An EARLIER pre-1970 date: 1969-01-01T00:00:00Z ────────────────────
    // 1969-01-01 is 365 days before 1970-01-01 (1969 not a leap year).
    // epoch = -365 * 86400 = -31536000.
    let ny1969_epoch = dt_to_epoch(1969, 1, 1, 0, 0, 0)
    _assert_eq("neg2/epoch", ny1969_epoch, -31536000)

    let ny1969_dt = dt_from_epoch(ny1969_epoch)
    _assert_eq("neg2/year",  ny1969_dt["year"],  1969)
    _assert_eq("neg2/month", ny1969_dt["month"], 1)
    _assert_eq("neg2/day",   ny1969_dt["day"],   1)

    // 1969-01-01 yday should be 1
    _assert_eq("neg2/yday", ny1969_dt["yday"], 1)

    // ── 7. Midnight boundary: 1970-01-01T00:00:00Z ───────────────────────────
    let epoch0 = dt_to_epoch(1970, 1, 1, 0, 0, 0)
    _assert_eq("epoch0/val", epoch0, 0)

    let dt0 = dt_from_epoch(0)
    _assert_eq("epoch0/year",  dt0["year"],  1970)
    _assert_eq("epoch0/month", dt0["month"], 1)
    _assert_eq("epoch0/day",   dt0["day"],   1)
    _assert_eq("epoch0/weekday", dt0["weekday"], 4)  // Thursday

    // ── 8. One second before epoch: 1969-12-31T23:59:59Z ────────────────────
    // epoch = -1.  This tests the hour/min/sec decomposition for negatives.
    // _fmod(-1, 86400) must be 86399, not -1.
    let minus1 = dt_from_epoch(-1)
    _assert_eq("minus1/year",  minus1["year"],  1969)
    _assert_eq("minus1/month", minus1["month"], 12)
    _assert_eq("minus1/day",   minus1["day"],   31)
    _assert_eq("minus1/hour",  minus1["hour"],  23)
    _assert_eq("minus1/min",   minus1["min"],   59)
    _assert_eq("minus1/sec",   minus1["sec"],   59)

    // ── 9. Add-seconds on negative epoch ─────────────────────────────────────
    // Start from -604800 (1969-12-25 midnight), add 3661 seconds (1h1m1s).
    // Result should be 1969-12-25T01:01:01Z.
    let xmas_plus = dt_add_seconds(xmas_epoch, 3661)
    let xmas_plus_dt = dt_from_epoch(xmas_plus)
    _assert_eq("add_secs/hour", xmas_plus_dt["hour"], 1)
    _assert_eq("add_secs/min",  xmas_plus_dt["min"],  1)
    _assert_eq("add_secs/sec",  xmas_plus_dt["sec"],  1)

    // ── 10. Duration of the weekly schedule span ─────────────────────────────
    // 5 weekly events = 35 days = 3024000 seconds.
    let span = 35 * 86400
    _assert_eq("span/secs", span, 3024000)
    let span_fmt = dur_format(span)
    _assert_eq_s("span/fmt", span_fmt, "35d")

    // Parse it back
    let span_parsed = dur_parse("35d")
    _assert_eq("span/parsed", span_parsed, 3024000)

    print("showcase_schedule_test passed")
