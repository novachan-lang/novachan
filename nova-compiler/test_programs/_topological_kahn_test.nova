import std/graph/topological_kahn

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn ckl(label, got, want)
    if len(got) != len(want)
        print("FAIL " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // KAT: 0->1->2 chain
    let adj1 = []
    let a1r0 = []
    a1r0.push(1)
    adj1.push(a1r0)
    let a1r1 = []
    a1r1.push(2)
    adj1.push(a1r1)
    let a1r2 = []
    adj1.push(a1r2)

    let want1 = []
    want1.push(0)
    want1.push(1)
    want1.push(2)
    ckl("kat1_chain_order", topological_kahn.tk_order(adj1, 3), want1)
    ckb("kat2_chain_is_dag", topological_kahn.tk_is_dag(adj1, 3), true)
    cki("kat3_chain_count", topological_kahn.tk_count_orderings(adj1, 3), 1)

    // KAT: 0->1, 0->2, no edge between 1 and 2
    let adj2 = []
    let a2r0 = []
    a2r0.push(1)
    a2r0.push(2)
    adj2.push(a2r0)
    let a2r1 = []
    adj2.push(a2r1)
    let a2r2 = []
    adj2.push(a2r2)

    let want2 = []
    want2.push(0)
    want2.push(1)
    want2.push(2)
    ckl("kat4_fork_order", topological_kahn.tk_order(adj2, 3), want2)
    cki("kat5_fork_count", topological_kahn.tk_count_orderings(adj2, 3), 2)

    // KAT: cycle 0->1->2->0
    let adj3 = []
    let a3r0 = []
    a3r0.push(1)
    adj3.push(a3r0)
    let a3r1 = []
    a3r1.push(2)
    adj3.push(a3r1)
    let a3r2 = []
    a3r2.push(0)
    adj3.push(a3r2)

    ckb("kat6_cycle_not_dag", topological_kahn.tk_is_dag(adj3, 3), false)
    let cycleorder = topological_kahn.tk_order(adj3, 3)
    cki("kat7_cycle_order_empty", len(cycleorder), 0)
    cki("kat8_cycle_count", topological_kahn.tk_count_orderings(adj3, 3), 0)

    // KAT: diamond 0->{1,2}->3 (two paths meet)
    // adj[0]=[1,2], adj[1]=[3], adj[2]=[3], adj[3]=[]
    let adj4 = []
    let a4r0 = []
    a4r0.push(1)
    a4r0.push(2)
    adj4.push(a4r0)
    let a4r1 = []
    a4r1.push(3)
    adj4.push(a4r1)
    let a4r2 = []
    a4r2.push(3)
    adj4.push(a4r2)
    let a4r3 = []
    adj4.push(a4r3)
    ckb("kat9_diamond_dag", topological_kahn.tk_is_dag(adj4, 4), true)
    // orderings: 0 must come first, 3 last; 1 and 2 can swap -> 2 orderings
    cki("kat10_diamond_count", topological_kahn.tk_count_orderings(adj4, 4), 2)

    // KAT: tk_count_orderings([[2],[2],[]], 3) = 2 (from spec)
    // adj[0]=[2], adj[1]=[2], adj[2]=[]  (0 and 1 both point to 2, 0 and 1 independent)
    let adj5 = []
    let a5r0 = []
    a5r0.push(2)
    adj5.push(a5r0)
    let a5r1 = []
    a5r1.push(2)
    adj5.push(a5r1)
    let a5r2 = []
    adj5.push(a5r2)
    cki("kat11_spec_count2", topological_kahn.tk_count_orderings(adj5, 3), 2)

    // KAT: isolated nodes only
    let adj6 = []
    adj6.push([])
    adj6.push([])
    adj6.push([])
    ckb("kat12_isolated_dag", topological_kahn.tk_is_dag(adj6, 3), true)
    // 3 isolated nodes: 3! = 6 orderings... but smallest-id tie-break only fixes one.
    // count_orderings counts ALL valid orderings = 3! = 6
    cki("kat13_isolated_count", topological_kahn.tk_count_orderings(adj6, 3), 6)

    // KAT: n=0
    let adj0 = []
    ckb("kat14_empty_dag", topological_kahn.tk_is_dag(adj0, 0), true)
    cki("kat15_empty_count", topological_kahn.tk_count_orderings(adj0, 0), 1)

    print("PASS _topological_kahn_test")

main()
