// KAT for std/testing/coverage
// Tests the manual line/branch coverage recorder.
import std/testing/coverage

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + got + " want " + want)
        exit(1)

fn ckb(label, got, want)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got " + gs + " want " + ws)
        exit(1)

fn main()
    let c = cov_new()

    // Hit "a" twice and "b" once
    cov_hit(c, "a")
    cov_hit(c, "a")
    cov_hit(c, "b")

    // KAT 1: cov_count("a") == 2
    cki("count_a", cov_count(c, "a"), 2)

    // KAT 2: cov_count("z") == 0 (never hit)
    cki("count_z", cov_count(c, "z"), 0)

    // KAT 3: cov_hit_labels returns ["a","b"] sorted
    let labels = cov_hit_labels(c)
    cki("hit_labels_len", len(labels), 2)
    cks("hit_labels_0", labels[0], "a")
    cks("hit_labels_1", labels[1], "b")

    // KAT 4: cov_percent over ["a","b","c","d"] == 50 (2 of 4 hit)
    let all4 = ["a", "b", "c", "d"]
    cki("percent_50", cov_percent(c, all4), 50)

    // KAT 5: cov_percent over empty list == 0
    let empty = []
    cki("percent_empty", cov_percent(c, empty), 0)

    // KAT 6: cov_report over ["a","b","c"]
    let all3 = ["a", "b", "c"]
    let rep = cov_report(c, all3)
    cki("report_hit", rep["hit"], 2)
    cki("report_total", rep["total"], 3)
    cki("report_percent", rep["percent"], 66)
    let missed = rep["missed"]
    cki("report_missed_len", len(missed), 1)
    cks("report_missed_0", missed[0], "c")

    // KAT 7: cov_report with all hit -> missed is empty
    let all2 = ["a", "b"]
    let rep2 = cov_report(c, all2)
    cki("report_all_hit", rep2["hit"], 2)
    cki("report_all_missed_len", len(rep2["missed"]), 0)

    // KAT 8: cov_count after additional hits
    cov_hit(c, "b")
    cki("count_b_after", cov_count(c, "b"), 2)

    print("_coverage_test passed")
