import forge_query_builder

fn main()
    let q = qb_new("users")
    q = qb_select(q, "id")
    q = qb_select(q, "name")
    q = qb_where(q, "age", ">", "18")
    q = qb_where(q, "status", "=", "active")
    q = qb_order(q, "name")
    q = qb_limit(q, 10)

    let sql = qb_build(q)
    assert(is_ok(sql), "build ok")
    let result = unwrap(sql)
    assert(contains(result, "SELECT") == true, "has SELECT")
    assert(contains(result, "users") == true, "has table")
    assert(contains(result, "WHERE") == true, "has WHERE")
    assert(contains(result, "ORDER BY") == true, "has ORDER BY")
    assert(contains(result, "LIMIT") == true, "has LIMIT")

    let empty = qb_new("t")
    let r2 = qb_build(empty)
    assert(is_err(r2), "no columns is err")

    print("QUERY-BUILDER KAT PASS")
