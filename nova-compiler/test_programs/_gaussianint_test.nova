import std/numeric/gaussianint

// Helpers
fn cki(label, got, expected)
    if got == expected
        return 0
    print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
    exit(1)

fn cks(label, got, expected)
    if got == expected
        return 0
    print("FAIL " + label + ": got [" + got + "] expected [" + expected + "]")
    exit(1)

fn ckb(label, got, expected)
    if got == expected
        return 0
    print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
    exit(1)

// KAT 1: (1+i)*(1+i) = 0+2i
let g1 = gi_new(1, 1)
let g2 = gi_new(1, 1)
let prod = gi_mul(g1, g2)
let expect12 = gi_new(0, 2)
ckb("mul_(1+i)*(1+i)==0+2i", gi_eq(prod, expect12), 1)

// KAT 2: norm(3+4i) = 25
let g34 = gi_new(3, 4)
cki("norm_3+4i", gi_norm(g34), 25)

// KAT 3: add (1+2i)+(3+4i) = 4+6i
let sum = gi_add(gi_new(1, 2), gi_new(3, 4))
ckb("add_(1+2i)+(3+4i)==4+6i", gi_eq(sum, gi_new(4, 6)), 1)

// KAT 4: conj(3+4i) = 3-4i
let conj34 = gi_conj(gi_new(3, 4))
ckb("conj_3+4i==3-4i", gi_eq(conj34, gi_new(3, 0 - 4)), 1)

// KAT 5: str(3-4i) == "3-4i"
cks("str_3-4i", gi_str(gi_new(3, 0 - 4)), "3-4i")

// KAT 6: str(0+1i) == "i"
cks("str_0+1i", gi_str(gi_new(0, 1)), "i")

// KAT 7: norm(0+0i) == 0
cki("norm_0+0i", gi_norm(gi_new(0, 0)), 0)

// KAT 8: sub (5+6i)-(2+3i) = 3+3i
let diff = gi_sub(gi_new(5, 6), gi_new(2, 3))
ckb("sub_(5+6i)-(2+3i)==3+3i", gi_eq(diff, gi_new(3, 3)), 1)

// KAT 9: str(5+0i) == "5"
cks("str_5+0i", gi_str(gi_new(5, 0)), "5")

// KAT 10: str(0-3i) == "-3i"
cks("str_0-3i", gi_str(gi_new(0, 0 - 3)), "-3i")

// KAT 11: gi_eq with non-equal values returns false
ckb("neq_check", gi_eq(gi_new(1, 2), gi_new(1, 3)), 0)

// KAT 12: str(3+4i) == "3+4i"
cks("str_3+4i", gi_str(gi_new(3, 4)), "3+4i")

print("_gaussianint_test passed")
