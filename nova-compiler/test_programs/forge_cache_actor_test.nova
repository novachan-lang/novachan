// functional: actor-backed keyed cache (distinct name from the HTTP cache-control test)
import forge_cache

fn main()
    let c = cache_new()
    if is_ok(cache_get(c, "k")) != false
        print("FAIL miss should be err")
        exit(1)
    cache_put(c, "k", "v")
    let hit = cache_get(c, "k")
    if is_ok(hit) != true
        print("FAIL hit")
        exit(1)
    if unwrap(hit) != "v"
        print("FAIL val = " + unwrap(hit))
        exit(1)
    cache_delete(c, "k")
    if is_ok(cache_get(c, "k")) != false
        print("FAIL after delete")
        exit(1)
    if cache_get_or(c, "k2", "def") != "def"
        print("FAIL get_or")
        exit(1)
    cache_stop(c)
    print("PASS forge_cache_actor")
