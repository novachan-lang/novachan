// Forge crypto: Ed25519, gated against RFC 8032 Sec 7.1 TEST 1 (verify a real signature) + tamper
// rejection + a sign/verify round-trip (validates sign + pubkey self-consistently).
import forge_crypto

fn main()
    let pk = hex_to_blist("d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a")
    let sig = hex_to_blist("e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b")
    let emptymsg = []

    if ed25519_verify(pk, emptymsg, sig) != 1
        print("FAIL: Ed25519 verify RFC 8032 TEST 1")
        exit(1)

    let bad = []
    let i = 0
    while i < 64
        push(bad, sig[i])
        i = i + 1
    bad[10] = bad[10] ^ 1
    if ed25519_verify(pk, emptymsg, bad) != 0
        print("FAIL: Ed25519 tampered signature not rejected")
        exit(1)

    let sk = hex_to_blist("0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20")
    let msg = str_to_blist("NOVA")
    let mysig = ed25519_sign(sk, msg)
    let mypk = ed25519_publickey(sk)
    if ed25519_verify(mypk, msg, mysig) != 1
        print("FAIL: Ed25519 sign/verify round-trip")
        exit(1)

    print("PASS forge_crypto_ed25519 (RFC 8032 verify KAT + tamper + sign/verify round-trip)")
