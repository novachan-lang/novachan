import forge_request_throttle

fn main()
    let t = rt_new(3, 1000)

    let r1 = rt_request(t, "client-a", 100)
    t = r1["t"]
    assert(r1["allowed"] == 1, "first request ok")
    assert(rt_client_usage(t, "client-a") == 1, "1 usage")

    let r2 = rt_request(t, "client-a", 200)
    t = r2["t"]
    assert(r2["allowed"] == 1, "2nd ok")

    let r3 = rt_request(t, "client-a", 300)
    t = r3["t"]
    assert(r3["allowed"] == 1, "3rd ok")

    let r4 = rt_request(t, "client-a", 400)
    t = r4["t"]
    assert(r4["allowed"] == 0, "4th denied (max 3)")

    let r5 = rt_request(t, "client-b", 400)
    t = r5["t"]
    assert(r5["allowed"] == 1, "different client ok")

    let r6 = rt_request(t, "client-a", 1200)
    t = r6["t"]
    assert(r6["allowed"] == 1, "window reset at 1200")
    assert(rt_client_usage(t, "client-a") == 1, "reset to 1")

    assert(rt_deny_rate(t) == 16, "16% deny")

    print("REQUEST-THROTTLE KAT PASS")
