// KAT for std/graph/tarjan — Tarjan strongly-connected components.
//
// Example graph (directed, unweighted):
//   A -> B
//   B -> C
//   C -> A, D
//   D -> E
//   E -> D
//
// Hand-computed SCCs:
//   {A,B,C} — mutual cycle A->B->C->A
//   {D,E}   — mutual cycle D->E->D
//
// tj_scc returns components sorted (internally) and the outer list sorted
// by each component's smallest member:
//   index 0 = ["A","B","C"]  (smallest="A")
//   index 1 = ["D","E"]      (smallest="D")
import std/graph/tarjan

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // ── Build the 5-node directed graph ──────────────────────────────────────
    let adj = {}
    let na  = []
    na.push("B")
    adj["A"] = na
    let nb = []
    nb.push("C")
    adj["B"] = nb
    let nc = []
    nc.push("A")
    nc.push("D")
    adj["C"] = nc
    let nd = []
    nd.push("E")
    adj["D"] = nd
    let ne = []
    ne.push("D")
    adj["E"] = ne

    let nodes = []
    nodes.push("A")
    nodes.push("B")
    nodes.push("C")
    nodes.push("D")
    nodes.push("E")

    // ── KAT 1: count ─────────────────────────────────────────────────────────
    cki("count_5node", tarjan.tj_count(adj, nodes), 2)

    // ── KAT 2: same SCC — A and C (both in {A,B,C}) ─────────────────────────
    cki("same_AC", tarjan.tj_same_scc(adj, nodes, "A", "C"), 1)

    // ── KAT 3: different SCC — A and D ───────────────────────────────────────
    cki("diff_AD", tarjan.tj_same_scc(adj, nodes, "A", "D"), 0)

    // ── KAT 4: same SCC — D and E ────────────────────────────────────────────
    cki("same_DE", tarjan.tj_same_scc(adj, nodes, "D", "E"), 1)

    // ── KAT 5: structure of tj_scc — first component is ["A","B","C"] ────────
    let sccs = tarjan.tj_scc(adj, nodes)
    cki("scc_outer_len", len(sccs), 2)
    let comp0 = sccs[0]
    cki("comp0_len", len(comp0), 3)
    cks("comp0_0", comp0[0], "A")
    cks("comp0_1", comp0[1], "B")
    cks("comp0_2", comp0[2], "C")

    // ── KAT 6: second component is ["D","E"] ─────────────────────────────────
    let comp1 = sccs[1]
    cki("comp1_len", len(comp1), 2)
    cks("comp1_0", comp1[0], "D")
    cks("comp1_1", comp1[1], "E")

    // ── KAT 7: DAG A->B->C has 3 singleton SCCs ──────────────────────────────
    let dag = {}
    let dna = []
    dna.push("B")
    dag["A"] = dna
    let dnb = []
    dnb.push("C")
    dag["B"] = dnb
    let dag_nodes = []
    dag_nodes.push("A")
    dag_nodes.push("B")
    dag_nodes.push("C")
    cki("dag_count", tarjan.tj_count(dag, dag_nodes), 3)

    // ── KAT 8: single node, no edges ─────────────────────────────────────────
    let solo  = {}
    let snodes = []
    snodes.push("X")
    cki("solo_count", tarjan.tj_count(solo, snodes), 1)
    let solo_sccs = tarjan.tj_scc(solo, snodes)
    let solo_comp = solo_sccs[0]
    cki("solo_comp_len", len(solo_comp), 1)
    cks("solo_comp_0", solo_comp[0], "X")

    // ── KAT 9: self-loop counts as trivial SCC of 1 for isolated node ─────────
    // (Same SCC with self: trivially true since node appears once)
    cki("same_self", tarjan.tj_same_scc(adj, nodes, "A", "A"), 1)

    // ── KAT 10: same_scc B and E (different components) ──────────────────────
    cki("diff_BE", tarjan.tj_same_scc(adj, nodes, "B", "E"), 0)

    print("_tarjan_test passed")
