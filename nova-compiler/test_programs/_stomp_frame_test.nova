// KAT for std/net/stomp_frame — STOMP 1.2 frame parser.
import std/net/stomp_frame

// ── Assert helpers ───────────────────────────────────────────────────────────

fn assert_s(label: string, got: string, want: string)
    if got != want
        print("FAIL stomp_frame " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn assert_i(label: string, got: int, want: int)
    if got != want
        print("FAIL stomp_frame " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ── Build a CONNECT frame byte-list: CONNECT LF host:x LF LF NUL ─────────────
// ASCII: C=67 O=79 N=78 N=78 E=69 C=67 T=84 LF=10
//        h=104 o=111 s=115 t=116 :=58 x=120 LF=10
//        LF=10  NUL=0

fn make_connect_frame() -> list
    let frame = []
    // "CONNECT" LF
    push(frame, 67)
    push(frame, 79)
    push(frame, 78)
    push(frame, 78)
    push(frame, 69)
    push(frame, 67)
    push(frame, 84)
    push(frame, 10)
    // "host:x" LF
    push(frame, 104)
    push(frame, 111)
    push(frame, 115)
    push(frame, 116)
    push(frame, 58)
    push(frame, 120)
    push(frame, 10)
    // blank LF (end of headers)
    push(frame, 10)
    // NUL (no body)
    push(frame, 0)
    frame

// ── Build a SEND frame with body "hello": SEND LF dest:/q LF LF hello NUL ────
// "SEND" = 83,69,78,68
// "destination:/queue/test" header
// body = "hello" = 104,101,108,108,111

fn make_send_frame() -> list
    let frame = []
    // "SEND" LF
    push(frame, 83)
    push(frame, 69)
    push(frame, 78)
    push(frame, 68)
    push(frame, 10)
    // "destination:/queue/test" LF
    push(frame, 100)
    push(frame, 101)
    push(frame, 115)
    push(frame, 116)
    push(frame, 105)
    push(frame, 110)
    push(frame, 97)
    push(frame, 116)
    push(frame, 105)
    push(frame, 111)
    push(frame, 110)
    push(frame, 58)
    push(frame, 47)
    push(frame, 113)
    push(frame, 117)
    push(frame, 101)
    push(frame, 117)
    push(frame, 101)
    push(frame, 47)
    push(frame, 116)
    push(frame, 101)
    push(frame, 115)
    push(frame, 116)
    push(frame, 10)
    // blank LF
    push(frame, 10)
    // body "hello" = 104,101,108,108,111
    push(frame, 104)
    push(frame, 101)
    push(frame, 108)
    push(frame, 108)
    push(frame, 111)
    // NUL
    push(frame, 0)
    frame

fn main()
    // ── KAT 1: CONNECT frame with host header, no body ───────────────────────
    let cf = make_connect_frame()
    let r1 = stomp_frame_parse(cf)
    assert_s("connect-command", r1["command"], "CONNECT")
    let r1h = r1["headers"]
    assert_s("connect-host", r1h["host"], "x")
    assert_s("connect-body", r1["body"], "")

    // ── KAT 2: SEND frame with destination header and body "hello" ────────────
    let sf = make_send_frame()
    let r2 = stomp_frame_parse(sf)
    assert_s("send-command", r2["command"], "SEND")
    let r2h = r2["headers"]
    assert_s("send-dest", r2h["destination"], "/queue/test")
    assert_s("send-body", r2["body"], "hello")

    // ── KAT 3: empty frame returns empty strings ───────────────────────────────
    let empty_frame = []
    let r3 = stomp_frame_parse(empty_frame)
    assert_s("empty-command", r3["command"], "")
    assert_s("empty-body", r3["body"], "")

    // ── KAT 4: frame with multiple headers ───────────────────────────────────
    // "MESSAGE" LF "subscription:0" LF "message-id:1" LF LF "data" NUL
    let mf = []
    // "MESSAGE" = 77,69,83,83,65,71,69
    push(mf, 77)
    push(mf, 69)
    push(mf, 83)
    push(mf, 83)
    push(mf, 65)
    push(mf, 71)
    push(mf, 69)
    push(mf, 10)
    // "subscription:0" LF
    push(mf, 115)
    push(mf, 117)
    push(mf, 98)
    push(mf, 115)
    push(mf, 99)
    push(mf, 114)
    push(mf, 105)
    push(mf, 112)
    push(mf, 116)
    push(mf, 105)
    push(mf, 111)
    push(mf, 110)
    push(mf, 58)
    push(mf, 48)
    push(mf, 10)
    // "message-id:1" LF
    push(mf, 109)
    push(mf, 101)
    push(mf, 115)
    push(mf, 115)
    push(mf, 97)
    push(mf, 103)
    push(mf, 101)
    push(mf, 45)
    push(mf, 105)
    push(mf, 100)
    push(mf, 58)
    push(mf, 49)
    push(mf, 10)
    // blank LF
    push(mf, 10)
    // body "data" = 100,97,116,97
    push(mf, 100)
    push(mf, 97)
    push(mf, 116)
    push(mf, 97)
    // NUL
    push(mf, 0)
    let r4 = stomp_frame_parse(mf)
    assert_s("multi-command", r4["command"], "MESSAGE")
    let r4h = r4["headers"]
    assert_s("multi-subscription", r4h["subscription"], "0")
    assert_s("multi-message-id", r4h["message-id"], "1")
    assert_s("multi-body", r4["body"], "data")

    print("PASS _stomp_frame_test")
