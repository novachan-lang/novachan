import std/permutation/perm_cycles

// cki — check integer equality
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb — check bool equality
fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

// list_str — render int list as "[a,b,c]"
fn list_str(xs) -> string
    let s = "["
    let i = 0
    while i < len(xs)
        if i > 0
            s = s + ","
        s = s + str(xs[i])
        i = i + 1
    s + "]"

// ckl — check list equality element-wise
fn ckl(label: string, got, want)
    if len(got) != len(want)
        print("FAIL " + label + ": got=" + list_str(got) + " want=" + list_str(want))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL " + label + ": got=" + list_str(got) + " want=" + list_str(want))
            exit(1)
        i = i + 1

// cknest — check list-of-lists: compare cycle i against want list
fn cknest(label: string, cycles, ci: int, want)
    if ci >= len(cycles)
        print("FAIL " + label + ": not enough cycles, got " + str(len(cycles)))
        exit(1)
    let got = cycles[ci]
    if len(got) != len(want)
        print("FAIL " + label + ": cycle " + str(ci) + " got=" + list_str(got) + " want=" + list_str(want))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL " + label + ": cycle " + str(ci) + " got=" + list_str(got) + " want=" + list_str(want))
            exit(1)
        i = i + 1

fn main()
    // KAT: pcy_cycles([1,2,0,4,3]) = [[0,1,2],[3,4]]
    let p1 = [1, 2, 0, 4, 3]
    let cy1 = pcy_cycles(p1)
    cki("cycles_5_count", len(cy1), 2)
    cknest("cycles_5_cy0", cy1, 0, [0, 1, 2])
    cknest("cycles_5_cy1", cy1, 1, [3, 4])

    // KAT: pcy_cycle_count([1,2,0,4,3]) = 2
    cki("cycle_count_5", pcy_cycle_count(p1), 2)

    // KAT: pcy_cycle_lengths([1,2,0,4,3]) = [3,2]
    let cl1 = pcy_cycle_lengths(p1)
    ckl("cycle_lengths_5", cl1, [3, 2])

    // KAT: pcy_cycles([0,1,2]) = [[0],[1],[2]]
    let p2 = [0, 1, 2]
    let cy2 = pcy_cycles(p2)
    cki("cycles_id3_count", len(cy2), 3)
    cknest("cycles_id3_cy0", cy2, 0, [0])
    cknest("cycles_id3_cy1", cy2, 1, [1])
    cknest("cycles_id3_cy2", cy2, 2, [2])

    // KAT: pcy_cycle_count([0,1,2]) = 3
    cki("cycle_count_id3", pcy_cycle_count(p2), 3)

    // KAT: pcy_cycle_type([1,2,0,4,3]) = [2,3]  (sorted ascending)
    let ct1 = pcy_cycle_type(p1)
    ckl("cycle_type_5", ct1, [2, 3])

    // Additional: empty permutation
    let p0 = []
    let cy0 = pcy_cycles(p0)
    cki("cycles_empty", len(cy0), 0)
    cki("cycle_count_empty", pcy_cycle_count(p0), 0)
    cki("cycle_lengths_empty_len", len(pcy_cycle_lengths(p0)), 0)
    cki("cycle_type_empty_len", len(pcy_cycle_type(p0)), 0)

    // Single element (fixed point)
    let p_n1 = [0]
    let cy_n1 = pcy_cycles(p_n1)
    cki("cycles_n1_count", len(cy_n1), 1)
    cknest("cycles_n1_cy0", cy_n1, 0, [0])
    cki("cycle_type_n1_len", len(pcy_cycle_type(p_n1)), 1)
    cki("cycle_type_n1_v0", pcy_cycle_type(p_n1)[0], 1)

    // Full cycle of length 4: [1,2,3,0]
    // Trace: 0->1->2->3->0, min=0, rotated=[0,1,2,3]
    let p4 = [1, 2, 3, 0]
    let cy4 = pcy_cycles(p4)
    cki("cycles_4cyc_count", len(cy4), 1)
    cknest("cycles_4cyc_cy0", cy4, 0, [0, 1, 2, 3])
    ckl("cycle_type_4cyc", pcy_cycle_type(p4), [4])

    // Cycle with non-zero start of minimum: [2,3,0,1]
    // Trace from 0: 0->2->0 (cycle {0,2}, min=0, rotated=[0,2])
    // Trace from 1: 1->3->1 (cycle {1,3}, min=1, rotated=[1,3])
    let p5 = [2, 3, 0, 1]
    let cy5 = pcy_cycles(p5)
    cki("cycles_2swap_count", len(cy5), 2)
    cknest("cycles_2swap_cy0", cy5, 0, [0, 2])
    cknest("cycles_2swap_cy1", cy5, 1, [1, 3])
    ckl("cycle_type_2swap", pcy_cycle_type(p5), [2, 2])

    // Mixed: [1,0,2,4,3] — one transposition, one fixed, one transposition
    // Trace 0: 0->1->0 cycle {0,1} min=0 rotated=[0,1]
    // Trace 2: 2->2     cycle {2}   min=2 rotated=[2]
    // Trace 3: 3->4->3  cycle {3,4} min=3 rotated=[3,4]
    let p6 = [1, 0, 2, 4, 3]
    let cy6 = pcy_cycles(p6)
    cki("cycles_mixed_count", len(cy6), 3)
    cknest("cycles_mixed_cy0", cy6, 0, [0, 1])
    cknest("cycles_mixed_cy1", cy6, 1, [2])
    cknest("cycles_mixed_cy2", cy6, 2, [3, 4])
    ckl("cycle_type_mixed", pcy_cycle_type(p6), [1, 2, 2])
    ckl("cycle_lengths_mixed", pcy_cycle_lengths(p6), [2, 1, 2])

    print("PASS _perm_cycles_test")
