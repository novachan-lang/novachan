import std/finance/npv

// Helper: check float within epsilon, print FAIL and exit(1) on mismatch.
fn _npv_check(label: string, got: float, want: float, eps: float)
    let d = got - want
    let ad = d
    if ad < 0.0
        ad = 0.0 - ad
    if ad > eps
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // KAT 1: standard 5-period NPV at 10%
    // [-1000, 500, 400, 300, 100] @10% = 78.82
    let cf1 = [-1000.0, 500.0, 400.0, 300.0, 100.0]
    let r1 = npv_compute(0.1, cf1)
    _npv_check("npv_compute_10pct", r1, 78.82, 0.01)

    // KAT 2: zero-rate NPV = simple sum
    // [-100, 50, 60] @0% = 10.0
    let cf2 = [-100.0, 50.0, 60.0]
    let r2 = npv_compute(0.0, cf2)
    _npv_check("npv_compute_zero_rate", r2, 10.0, 0.01)

    // KAT 3: single element at t=0 — no discounting
    // [100] @10% = 100.0
    let cf3 = [100.0]
    let r3 = npv_compute(0.1, cf3)
    _npv_check("npv_compute_single", r3, 100.0, 0.01)

    // KAT 4: npv_with_initial separates initial cost from future flows
    // -1000 initial, [500,400,300,100] future @10% == same 78.82
    let cf4 = [500.0, 400.0, 300.0, 100.0]
    let r4 = npv_with_initial(0.1, 1000.0, cf4)
    _npv_check("npv_with_initial", r4, 78.82, 0.01)

    // KAT 5: one-period bond: 0 now + 105 in one year @5% = 100.0
    let cf5 = [0.0, 105.0]
    let r5 = npv_compute(0.05, cf5)
    _npv_check("npv_compute_bond", r5, 100.0, 0.01)

    // KAT 6: profitability index
    // flows [500,400,300,100] @10%, initial=1000 -> PI = 78.82/1000 = 0.0788..
    // but spec says npv_compute(rate, cashflows)/initial where cashflows
    // is the full list; we test with all-positive future flows.
    // npv_compute(0.1, [500,400,300,100]) =
    //   500/1 + 400/1.1 + 300/1.21 + 100/1.331
    //   = 500 + 363.636 + 247.934 + 75.131 = 1186.70
    // PI = 1186.70 / 1000 = 1.1867
    let cf6 = [500.0, 400.0, 300.0, 100.0]
    let r6 = npv_profitability_index(0.1, 1000.0, cf6)
    _npv_check("npv_profitability_index", r6, 1.1867, 0.01)

    // KAT 7: empty cashflows -> NPV is 0.0
    let cf7 = []
    let r7 = npv_compute(0.1, cf7)
    _npv_check("npv_compute_empty", r7, 0.0, 0.001)

    // KAT 8: zero initial in profitability_index returns 0.0 (no divide-by-zero)
    let cf8 = [100.0, 200.0]
    let r8 = npv_profitability_index(0.1, 0.0, cf8)
    _npv_check("npv_pi_zero_initial", r8, 0.0, 0.001)

    print("_npv_test passed")
