import forge_hilbert

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn absd(a: int, b: int) -> int
    let d = a - b
    if d < 0
        d = 0 - d
    d

fn main()
    let fails = 0

    // order-2 Hilbert (first order U-shape): d 0->(0,0) 1->(0,1) 2->(1,1) 3->(1,0)
    let p0 = hilbert_d2xy(2, 0)
    let p1 = hilbert_d2xy(2, 1)
    let p2 = hilbert_d2xy(2, 2)
    let p3 = hilbert_d2xy(2, 3)
    fails = fails + expect("d0", str(p0[0]) + str(p0[1]), "00")
    fails = fails + expect("d1", str(p1[0]) + str(p1[1]), "01")
    fails = fails + expect("d2", str(p2[0]) + str(p2[1]), "11")
    fails = fails + expect("d3", str(p3[0]) + str(p3[1]), "10")

    // xy2d is the inverse
    fails = fails + expect("xy2d_00", str(hilbert_xy2d(2, 0, 0)), "0")
    fails = fails + expect("xy2d_11", str(hilbert_xy2d(2, 1, 1)), "2")
    fails = fails + expect("xy2d_10", str(hilbert_xy2d(2, 1, 0)), "3")

    // roundtrip over an 8x8 grid: xy2d(d2xy(d)) == d for all d
    let rt_ok = true
    let d = 0
    while d < 64
        let p = hilbert_d2xy(8, d)
        if hilbert_xy2d(8, p[0], p[1]) != d
            rt_ok = false
        d = d + 1
    fails = fails + expect_true("roundtrip_8x8", rt_ok)

    // the defining property: consecutive distances are ALWAYS adjacent cells (Manhattan distance 1)
    let adj_ok = true
    let i = 1
    while i < 64
        let a = hilbert_d2xy(8, i - 1)
        let b = hilbert_d2xy(8, i)
        if absd(a[0], b[0]) + absd(a[1], b[1]) != 1
            adj_ok = false
        i = i + 1
    fails = fails + expect_true("always_adjacent", adj_ok)

    // covers every cell of the 4x4 grid exactly once (16 distinct)
    let seen = {}
    let k = 0
    while k < 16
        let p = hilbert_d2xy(4, k)
        seen[str(p[0]) + "," + str(p[1])] = 1
        k = k + 1
    fails = fails + expect("covers_all_16", str(len(keys(seen))), "16")

    if fails == 0
        print("forge_hilbert: all passed")
    else
        print("forge_hilbert: " + str(fails) + " FAILED")
