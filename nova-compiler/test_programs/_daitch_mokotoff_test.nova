import std/phonetic/daitch_mokotoff

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL daitch_mokotoff " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL daitch_mokotoff " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ---- dm_encode_primary reference vectors ----
    // Peters: P(7) E(reset) T(before-E=3) E(reset) R(9) S(4) -> 739400
    cks("Peters",     dm_encode_primary("Peters"),     "739400")
    // Moskowitz: M(6) O(reset) S(4) K(before-O=5) O(reset) W(before-I=7) I(reset) TZ(4) -> 645740
    cks("Moskowitz",  dm_encode_primary("Moskowitz"),  "645740")
    // Auerbach: A(0) U(reset) E(reset) R(9) B(before-A=7) A(reset) CH(5 primary) -> 097500
    cks("Auerbach",   dm_encode_primary("Auerbach"),   "097500")
    // Miller: M(6) I(reset) L(8) L(before-E=8,dup->skip) E(reset) R(9) -> 689000
    cks("Miller",     dm_encode_primary("Miller"),     "689000")

    // ---- dm_encode returns a list ----
    // Peters should produce exactly "739400" in the list.
    let p_codes = dm_encode("Peters")
    cki("Peters_is_list", len(p_codes) >= 1, 1)
    cks("Peters_list_0", p_codes[0], "739400")

    // Each code must be exactly 6 digits.
    cki("Peters_len6",    len(p_codes[0]), 6)
    cki("Miller_len6",    len(dm_encode_primary("Miller")), 6)
    cki("Auerbach_len6",  len(dm_encode_primary("Auerbach")), 6)

    // Auerbach produces two codes (CH is ambiguous: 5 and 4).
    let a_codes = dm_encode("Auerbach")
    cki("Auerbach_two_codes", len(a_codes) >= 2, 1)
    // Primary must be 097500
    cks("Auerbach_primary", a_codes[0], "097500")

    // ---- dm_normalize ----
    cks("norm_lower", dm_normalize("peter"), "PETER")
    cks("norm_spaces", dm_normalize("van der Berg"), "VANDERBERG")

    // ---- empty input ----
    cks("empty", dm_encode_primary(""), "000000")
    cki("empty_list_len", len(dm_encode("")), 1)

    print("PASS _daitch_mokotoff_test")
