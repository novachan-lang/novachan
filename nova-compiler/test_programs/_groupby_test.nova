// KAT test for std/data/groupby
import std/data/groupby

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + got + " expected " + expected)
        exit(1)

fn main()
    // Build the canonical test rows
    let r0 = {}
    r0["cat"] = "x"
    r0["n"] = "3"
    let r1 = {}
    r1["cat"] = "y"
    r1["n"] = "1"
    let r2 = {}
    r2["cat"] = "x"
    r2["n"] = "4"
    let rows = []
    rows.push(r0)
    rows.push(r1)
    rows.push(r2)

    // KAT 1: gb_by_key groups correctly — "x" bucket has 2 rows
    let g = gb_by_key(rows, "cat")
    let gx = g["x"]
    cki("gb_by_key x count", len(gx), 2)

    // KAT 2: "y" bucket has 1 row
    let gy = g["y"]
    cki("gb_by_key y count", len(gy), 1)

    // KAT 3: gb_count["x"] == 2
    let cnt = gb_count(rows, "cat")
    cki("gb_count x", cnt["x"], 2)

    // KAT 4: gb_count["y"] == 1
    cki("gb_count y", cnt["y"], 1)

    // KAT 5: gb_aggregate sums n-values for "x": 3+4=7
    let agg = gb_aggregate(rows, "cat", "n")
    cki("gb_aggregate x sum", agg["x"], 7)

    // KAT 6: gb_aggregate sums n-values for "y": 1
    cki("gb_aggregate y sum", agg["y"], 1)

    // KAT 7: gb_keys returns sorted list of group values
    let gkeys = gb_keys(g)
    cks("gb_keys[0]", gkeys[0], "x")
    cks("gb_keys[1]", gkeys[1], "y")
    cki("gb_keys len", len(gkeys), 2)

    // KAT 8: row identity — rows in "x" group actually have cat=="x"
    let row_x0 = gx[0]
    cks("x group row0 cat", row_x0["cat"], "x")

    // KAT 9: gb_by_key skips rows missing the key gracefully
    let sparse = []
    let s0 = {}
    s0["cat"] = "a"
    s0["n"] = "10"
    let s1 = {}
    s1["n"] = "99"
    sparse.push(s0)
    sparse.push(s1)
    let sg = gb_by_key(sparse, "cat")
    cki("gb_by_key skip missing key", len(sg["a"]), 1)

    // KAT 10: gb_count with a single group
    let sc = gb_count(sparse, "cat")
    cki("gb_count single group", sc["a"], 1)

    print("_groupby_test passed")
