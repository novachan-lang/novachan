fn double(x: int) -> int
    x * 2

fn add_three(a: int, b: int, c: int) -> int
    a + b + c

fn greet(name: string) -> string
    "hello " + name

fn make_list_of(n: int) -> list
    let result = []
    let i = 0
    while i < n
        push(result, i)
        i = i + 1
    return result

fn sum_list(lst: list) -> int
    let total = 0
    let i = 0
    while i < len(lst)
        total = total + lst[i]
        i = i + 1
    return total

let x = double(21)
let y = add_three(1, 2, 3)
let z = double(y) + x
let msg = greet("world")
let nums = make_list_of(5)
let total = sum_list(nums)

print("double(21) = " + str(x))
print("add_three(1,2,3) = " + str(y))
print("z = " + str(z))
print("greet = " + msg)
print("sum(0..5) = " + str(total))

if x == 42 and y == 6 and z == 54 and msg == "hello world" and total == 10
    print("PASS")
else
    print("FAIL")
