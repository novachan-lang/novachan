import forge_feature_registry

fn main()
    let fr = fr_new()
    fr = fr_register(fr, "dark_mode", "alice", "beta")
    fr = fr_register(fr, "ai_chat", "bob", "alpha")
    fr = fr_register(fr, "export", "carol", "ga")
    assert(fr_feature_count(fr) == 3, "3 features")
    assert(fr_has_feature(fr, "dark_mode") == 1, "has dark_mode")

    let st = fr_status(fr, "dark_mode")
    assert(unwrap(st) == "registered", "registered initially")

    let e1 = fr_enable(fr, "dark_mode")
    fr = unwrap(e1)
    let e2 = fr_enable(fr, "export")
    fr = unwrap(e2)
    assert(fr_enabled_count(fr) == 2, "2 enabled")

    let st2 = fr_status(fr, "dark_mode")
    assert(unwrap(st2) == "enabled", "enabled status")

    let dup = fr_enable(fr, "dark_mode")
    assert(is_err(dup), "already enabled")

    let d1 = fr_deprecate(fr, "dark_mode")
    fr = unwrap(d1)
    assert(fr_deprecated_count(fr) == 1, "1 deprecated")
    assert(fr_enabled_count(fr) == 1, "1 enabled after deprecate")

    let ow = fr_owner(fr, "ai_chat")
    assert(unwrap(ow) == "bob", "bob owns ai_chat")
    let ph = fr_phase(fr, "ai_chat")
    assert(unwrap(ph) == "alpha", "alpha phase")

    let bad = fr_status(fr, "nope")
    assert(is_err(bad), "unknown feature")

    print("FEATURE-REGISTRY KAT PASS")
