import std/vector/vec_angle

fn ckb(label: string, got: bool, want: bool)
    if got == want
        return
    print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
    exit(1)

fn ckl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + ": len " + str(len(got)) + " != " + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // van_cos_sq([1,0],[1,1]) = 1^2/(1*2) = [1,2]
    ckl("cos_sq_1", van_cos_sq([1, 0], [1, 1]), [1, 2])
    // van_cos_sq([1,0],[1,0]) = 1^2/(1*1) = [1,1]
    ckl("cos_sq_2", van_cos_sq([1, 0], [1, 0]), [1, 1])
    // van_cos_sq([1,0],[0,1]) = 0/(1*1) = [0,1]
    ckl("cos_sq_3", van_cos_sq([1, 0], [0, 1]), [0, 1])
    // van_is_orthogonal([1,0],[0,1]) = true
    ckb("orth_1", van_is_orthogonal([1, 0], [0, 1]), true)
    // van_is_parallel([1,2],[2,4]) = true
    ckb("par_1", van_is_parallel([1, 2], [2, 4]), true)
    // van_is_acute([1,1],[1,0]) = true  (dot=1 > 0)
    ckb("acute_1", van_is_acute([1, 1], [1, 0]), true)
    // van_is_obtuse([1,0],[-1,1]) = true  (dot=-1 < 0)
    ckb("obtuse_1", van_is_obtuse([1, 0], [-1, 1]), true)
    // anti-parallel: [1,0] and [-1,0] -> parallel (cos^2==1)
    ckb("par_anti", van_is_parallel([1, 0], [-1, 0]), true)
    // right angle: neither acute nor obtuse
    ckb("acute_no", van_is_acute([1, 0], [0, 1]), false)
    ckb("obtuse_no", van_is_obtuse([1, 0], [0, 1]), false)
    // 3D orthogonal pair
    ckb("orth_3d", van_is_orthogonal([1, 0, 0], [0, 0, 1]), true)
    // [2,4] dot [1,1]=6; |[2,4]|^2=20; |[1,1]|^2=2; cos_sq=36/40=[9,10]
    ckl("cos_sq_reduced", van_cos_sq([2, 4], [1, 1]), [9, 10])
    // zero vector returns [0,0]
    ckl("cos_sq_zero", van_cos_sq([0, 0], [1, 0]), [0, 0])
    print("PASS _vec_angle_test")
