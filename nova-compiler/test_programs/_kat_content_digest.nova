import forge_content_digest

fn tf(b: bool) -> string
    if b
        return "T"
    "F"

fn main()
    // SHA-256("hello world") base64 = uU0nuZNNPgilLlLX2n2r+sSE7+N6U4DukIj3rOLvzek= (independently computed)
    let want = "sha-256=:uU0nuZNNPgilLlLX2n2r+sSE7+N6U4DukIj3rOLvzek=:"
    let got = content_digest_sha256("hello world")
    print("digest_exact=" + tf(got == want))
    print("verify_ok=" + tf(content_digest_verify("hello world", want)))
    print("verify_tampered=" + tf(content_digest_verify("hello worlx", want)))
    // empty body: SHA-256("") base64 = 47DEQpj8HBSa+/TImW+5JCeuQeRkm5NMpJWZG3hSuFU=
    let wantE = "sha-256=:47DEQpj8HBSa+/TImW+5JCeuQeRkm5NMpJWZG3hSuFU=:"
    print("digest_empty=" + tf(content_digest_sha256("") == wantE))
