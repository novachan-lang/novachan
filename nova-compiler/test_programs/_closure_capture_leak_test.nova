// _closure_capture_leak_test.nova -- pins the CLOSURE half of CORE_GAP 0.8 (see
// NOVA_DESIGN/CORE_GAPS_2026_07_03.md). Closures share rc_free's dead STRUCT free path, so a
// closure's captured HEAP values are never released on the closure's death. Distinct from struct
// fields: make_closure (nova_compiler.nova ~16947) stores captures RAW (no rc_inc) AND marks each
// captured local's slot ESCAPED (~16954) so W5b does NOT drop that local (prevents a dangling
// capture). Net: the captured heap value leaks GUARANTEED (even a sibling local that would otherwise
// be dropped). Memory-SAFE (no dangling), just leaky -- and arena-masked (Forge safe).
// The type-directed fix (rc_inc managed captures on build + managed-slot bitmap dec on free) closes
// this together with the struct-field half. Run under NOVA_T8_FULLRC=1.

fn _clo_make(seed: int) -> int
    let data = [seed, seed + 1, seed + 2]   // heap local, captured by the closure below
    let f = fn() len(data)
    return f()

fn main()
    // (A) sibling-local capture, churned non-arena: capture leaks ~1/iter (escape-marking suppresses
    //     the local's drop; the closure never dec's it). Baseline ~2001.
    let b0 = live_count()
    let i = 0
    while i < 2000
        let data = [i, i + 1, i + 2]
        let f = fn() len(data)
        let _u = f()
        i = i + 1
    let sibling_delta = live_count() - b0

    // (B) closure-frame churn (non-arena function locals): ~2/iter. Baseline ~4000.
    let b1 = live_count()
    let j = 0
    let acc = 0
    while j < 2000
        acc = acc + _clo_make(j)
        j = j + 1
    let frame_delta = live_count() - b1

    print("closure_capture_leak sibling=" + str(sibling_delta) + " frame=" + str(frame_delta) + " acc=" + str(acc))

    // Correctness invariant: closures still COMPUTE correctly despite the leak (acc = sum of len==3).
    if acc != 6000
        print("closure_capture_leak_test FAILED: closure computed wrong result acc=" + str(acc))
        exit(1)

    // Guard: the KNOWN leak must not get WORSE. When the type-directed fix lands both -> ~O(1).
    let LB_CLO_SIBLING_MAX = 3000
    let LB_CLO_FRAME_MAX = 6000
    if sibling_delta > LB_CLO_SIBLING_MAX or frame_delta > LB_CLO_FRAME_MAX
        print("closure_capture_leak_test FAILED: capture leak got WORSE than baseline")
        exit(1)

    if sibling_delta <= 10 and frame_delta <= 10
        print("closure_capture_leak_test: CAPTURE LEAK CLOSED -- tighten this test + update CORE_GAPS 0.8")
    print("closure_capture_leak_test passed (closures correct; capture leak pinned at known baseline)")
