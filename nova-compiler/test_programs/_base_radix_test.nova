import std/numeral/base_radix

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL base_radix " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL base_radix " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gs = "false"
    if got
        gs = "true"
    let ws = "false"
    if want
        ws = "true"
    if got != want
        print("FAIL base_radix " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn main()
    // br_to_base KAT
    cks("to_base(255,16)",  br_to_base(255,16),  "FF")
    cks("to_base(10,2)",    br_to_base(10,2),    "1010")
    cks("to_base(0,2)",     br_to_base(0,2),     "0")
    cks("to_base(35,36)",   br_to_base(35,36),   "Z")
    cks("to_base(1000,16)", br_to_base(1000,16), "3E8")
    cks("to_base(-255,16)", br_to_base(-255,16), "-FF")
    cks("to_base(0,16)",    br_to_base(0,16),    "0")
    cks("to_base(1,2)",     br_to_base(1,2),     "1")
    cks("to_base(255,8)",   br_to_base(255,8),   "377")
    cks("to_base(36,36)",   br_to_base(36,36),   "10")

    // br_from_base KAT
    cki("from_base(FF,16)",   br_from_base("FF",16),   255)
    cki("from_base(1010,2)",  br_from_base("1010",2),  10)
    cki("from_base(z,36)",    br_from_base("z",36),    35)
    cki("from_base(3e8,16)",  br_from_base("3e8",16),  1000)
    cki("from_base(0,10)",    br_from_base("0",10),    0)
    cki("from_base(-FF,16)",  br_from_base("-FF",16),  -255)
    cki("from_base(377,8)",   br_from_base("377",8),   255)
    cki("from_base(10,36)",   br_from_base("10",36),   36)

    // br_is_valid KAT
    ckb("valid(FF,16)",   br_is_valid("FF",16),   true)
    ckb("valid(1010,2)",  br_is_valid("1010",2),  true)
    ckb("valid(z,36)",    br_is_valid("z",36),    true)
    ckb("valid(,16)",     br_is_valid("",16),     false)
    ckb("valid(-,16)",    br_is_valid("-",16),    false)
    ckb("valid(GG,16)",   br_is_valid("GG",16),  false)
    ckb("valid(2,2)",     br_is_valid("2",2),    false)
    ckb("valid(-FF,16)",  br_is_valid("-FF",16), true)

    // Round-trip: br_from_base(br_to_base(n, base), base) == n
    cki("roundtrip(123456,16)", br_from_base(br_to_base(123456,16),16), 123456)
    cki("roundtrip(0,2)",       br_from_base(br_to_base(0,2),2),       0)
    cki("roundtrip(-99,10)",    br_from_base(br_to_base(-99,10),10),   -99)
    cki("roundtrip(255,8)",     br_from_base(br_to_base(255,8),8),     255)
    cki("roundtrip(1000000,36)", br_from_base(br_to_base(1000000,36),36), 1000000)

    print("PASS _base_radix_test")
