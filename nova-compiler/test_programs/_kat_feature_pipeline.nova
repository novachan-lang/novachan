import forge_feature_pipeline

fn main()
    let p = fp_new()
    assert(fp_feature_count(p) == 0, "0 features initially")
    assert(fp_total_records(p) == 0, "0 records initially")

    let p1 = fp_add_feature(p, "age", "numeric")
    let p2 = fp_add_feature(p1, "city", "categorical")
    let p3 = fp_add_feature(p2, "bio", "text")
    assert(fp_feature_count(p3) == 3, "3 features registered")

    let r1 = fp_record(p3, "age", 25)
    assert(is_ok(r1), "record age 25 ok")
    let r2 = fp_record(p3, "age", 35)
    assert(is_ok(r2), "record age 35 ok")
    let r3 = fp_record(p3, "age", 45)
    assert(is_ok(r3), "record age 45 ok")

    assert(fp_total_records(p3) == 3, "3 total records")

    let cnt = fp_count(p3, "age")
    assert(is_ok(cnt), "count ok")
    assert(unwrap(cnt) == 3, "3 age values recorded")

    let mean = fp_mean(p3, "age")
    assert(is_ok(mean), "mean ok")
    assert(unwrap(mean) == 35, "mean of 25,35,45 is 35")

    let mn = fp_min(p3, "age")
    assert(is_ok(mn), "min ok")
    assert(unwrap(mn) == 25, "min is 25")

    let mx = fp_max(p3, "age")
    assert(is_ok(mx), "max ok")
    assert(unwrap(mx) == 45, "max is 45")

    let rc = fp_record(p3, "city", 1)
    assert(is_ok(rc), "record city ok")
    let cc = fp_count(p3, "city")
    assert(unwrap(cc) == 1, "1 city value recorded")
    assert(is_err(fp_mean(p3, "city")), "mean on categorical errors")

    assert(is_err(fp_record(p3, "unknown_feature", 1)), "record unknown feature errors")
    assert(is_err(fp_mean(p3, "unknown_feature")), "mean unknown feature errors")

    let p4 = fp_add_feature(p3, "empty_feat", "numeric")
    assert(is_err(fp_mean(p4, "empty_feat")), "mean with no values errors")

    assert(fp_total_records(p3) == 4, "4 total records after city")

    print("FEATURE-PIPELINE KAT PASS")
