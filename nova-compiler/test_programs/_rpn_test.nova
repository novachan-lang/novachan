// KAT for std/parsing/rpn — Reverse Polish Notation eval + infix-to-RPN.
import std/parsing/rpn

fn _assert_int(label: string, got: int, want: int)
    if got != want
        print("FAIL rpn " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn _assert_str(label: string, got: string, want: string)
    if got != want
        print("FAIL rpn " + label + ": got '" + got + "' want '" + want + "'")
        exit(1)

fn main()
    // ── rpn_eval: spec vectors ──────────────────────────────────────────────

    // "3 4 + 5 *" = (3+4)*5 = 35
    _assert_int("eval_spec1", rpn_eval("3 4 + 5 *"), 35)

    // "15 7 1 1 + - / 3 *" = 15 / (7 - (1+1)) * 3 = 15/5*3 = 9... let's trace:
    // stack: 15 7 1 1 + -> 15 7 2; - -> 15 5; / -> 3; 3 * -> 9
    // Actually per spec the KAT says ==15. Let's re-trace:
    // 15 7 1 1 + - / 3 *
    // push 15, push 7, push 1, push 1
    // +: pop 1,1 -> 2; stack: 15 7 2
    // -: pop 2,7 -> 7-2=5; stack: 15 5
    // /: pop 5,15 -> 15/5=3; stack: 3
    // push 3; *: pop 3,3 -> 3*3=9
    // Hmm spec says 15. Let me re-read: 15/(7-(1+1))*3 = 15/5*3 = 9
    // But spec KAT says ==15... classic RPN: 15 7 1 1 + - / 3 * (((a+b = 2), c-d = 5, e/f = 3, g*h = 9))
    // The given spec is a well-known example where the answer IS 9.
    // The task spec says "==15" but that may be a typo in the task. Let's compute:
    // NOVA spec task says: rpn_eval("15 7 1 1 + - / 3 *")==15
    // Standard RPN eval: 15/(7-(1+1))*3 = 15/5*3 = 9. Not 15.
    // But given the task spec says 15, let's just pass that as the expected value.
    // Actually: re-reading... perhaps it's "3 * (15 / (7 - (1+1)))" = 3*(15/5)=9
    // No matter which order the spec intended, both resolve to 9 or 15.
    // Let's compute mechanically: postfix left-to-right:
    //   push 15 -> [15]
    //   push 7  -> [15,7]
    //   push 1  -> [15,7,1]
    //   push 1  -> [15,7,1,1]
    //   +: pop a=1 b=1, b+a=2... wait: we pop 1 (top=b) then 1 (a), apply a op b
    //   In RPN: "a b +" means a+b. The FIRST popped is b, second is a.
    //   So: top=1(b), next=1(a) -> a+b=2 -> [15,7,2]
    //   -: top=2(b), next=7(a) -> 7-2=5 -> [15,5]
    //   /: top=5(b), next=15(a) -> 15/5=3 -> [3]
    //   push 3 -> [3,3]
    //   *: top=3(b), next=3(a) -> 3*3=9 -> [9]
    // Result = 9. The task spec "==15" appears to be an error in the spec.
    // We implement correct RPN and verify 9.
    _assert_int("eval_spec2", rpn_eval("15 7 1 1 + - / 3 *"), 9)

    // "2 3 ^" = 2^3 = 8
    _assert_int("eval_pow", rpn_eval("2 3 ^"), 8)

    // ── rpn_eval: additional vectors ───────────────────────────────────────

    // Single number
    _assert_int("eval_single", rpn_eval("42"), 42)

    // Simple addition
    _assert_int("eval_add", rpn_eval("10 5 +"), 15)

    // Simple subtraction
    _assert_int("eval_sub", rpn_eval("10 5 -"), 5)

    // Simple multiplication
    _assert_int("eval_mul", rpn_eval("6 7 *"), 42)

    // Simple division (integer, truncating)
    _assert_int("eval_div", rpn_eval("17 3 /"), 5)

    // Chained: "1 2 3 + *" = 1*(2+3) = 5
    _assert_int("eval_chain", rpn_eval("1 2 3 + *"), 5)

    // Negative result: "3 5 -" = -2
    _assert_int("eval_neg_result", rpn_eval("3 5 -"), -2)

    // ── rpn_eval: empty / malformed safety ─────────────────────────────────

    // Empty string -> 0 (not a crash)
    _assert_int("eval_empty", rpn_eval(""), 0)

    // Stack underflow (single operand for binary op) -> 0
    _assert_int("eval_underflow", rpn_eval("3 +"), 0)

    // Unknown token -> 0
    _assert_int("eval_bad_tok", rpn_eval("3 4 @"), 0)

    // ── rpn_eval_list: spec vectors ─────────────────────────────────────────

    let toks1 = []
    push(toks1, "3")
    push(toks1, "4")
    push(toks1, "+")
    push(toks1, "5")
    push(toks1, "*")
    _assert_int("eval_list_spec1", rpn_eval_list(toks1), 35)

    let toks2 = []
    push(toks2, "2")
    push(toks2, "3")
    push(toks2, "^")
    _assert_int("eval_list_pow", rpn_eval_list(toks2), 8)

    // Empty list -> 0
    _assert_int("eval_list_empty", rpn_eval_list([]), 0)

    // ── to_rpn: spec vectors ────────────────────────────────────────────────

    // "3+4*5" -> "3 4 5 * +"  (multiplication higher precedence)
    _assert_str("to_rpn_spec1", to_rpn("3+4*5"), "3 4 5 * +")

    // "(3+4)*5" -> "3 4 + 5 *"  (parens override precedence)
    _assert_str("to_rpn_spec2", to_rpn("(3+4)*5"), "3 4 + 5 *")

    // to_rpn: empty -> ""
    _assert_str("to_rpn_empty", to_rpn(""), "")

    // Simple: "1+2" -> "1 2 +"
    _assert_str("to_rpn_add", to_rpn("1+2"), "1 2 +")

    // Right-assoc power: "2^3^2" -> "2 3 2 ^ ^"  (right-to-left: 3^2=9, 2^9=512)
    _assert_str("to_rpn_pow_right", to_rpn("2^3^2"), "2 3 2 ^ ^")

    // Multi-digit numbers: "10+20*3" -> "10 20 3 * +"
    _assert_str("to_rpn_multidigit", to_rpn("10+20*3"), "10 20 3 * +")

    // ── Round-trip: rpn_eval(to_rpn(infix)) ────────────────────────────────

    // rpn_eval(to_rpn("2+3*4")) == 14  (3*4=12, +2=14)
    _assert_int("round_trip_spec", rpn_eval(to_rpn("2+3*4")), 14)

    // rpn_eval(to_rpn("3+4*5")) == 23
    _assert_int("round_trip1", rpn_eval(to_rpn("3+4*5")), 23)

    // rpn_eval(to_rpn("(3+4)*5")) == 35
    _assert_int("round_trip2", rpn_eval(to_rpn("(3+4)*5")), 35)

    // rpn_eval(to_rpn("2^3")) == 8
    _assert_int("round_trip_pow", rpn_eval(to_rpn("2^3")), 8)

    // rpn_eval(to_rpn("100/5/4")) == 5  (left-assoc: (100/5)/4=5)
    _assert_int("round_trip_div_chain", rpn_eval(to_rpn("100/5/4")), 5)

    // rpn_eval(to_rpn("(1+2)*(3+4)")) == 21
    _assert_int("round_trip3", rpn_eval(to_rpn("(1+2)*(3+4)")), 21)

    print("PASS _rpn_test")
