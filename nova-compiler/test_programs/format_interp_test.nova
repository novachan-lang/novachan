fn main()
    let n = 42

    let r1 = "{n:04d}"
    assert_eq(r1, "0042")

    let r2 = "{n:x}"
    assert_eq(r2, "2a")

    let r3 = "{n:b}"
    assert_eq(r3, "101010")

    let r4 = "{n:o}"
    assert_eq(r4, "52")

    let r5 = "{n:>8d}"
    assert_eq(r5, "      42")

    let r6 = "{n:08d}"
    assert_eq(r6, "00000042")

    let name = "NOVA"
    let r7 = "{name:>10s}"
    assert_eq(r7, "      NOVA")

    let r8 = "{name:<10s}"
    assert_eq(r8, "NOVA      ")

    let r9 = "{name:^10s}"
    assert_eq(r9, "   NOVA   ")

    let r10 = "Value={n:04d}, Name={name:>8s}"
    assert_eq(r10, "Value=0042, Name=    NOVA")

    let no_spec = "Hello {name}!"
    assert_eq(no_spec, "Hello NOVA!")

    let r11 = "{n:06d} done"
    assert_eq(r11, "000042 done")

    let items = [10, 20, 30]
    let r12 = "{items[1]:05d}"
    assert_eq(r12, "00020")

    let r13 = "{n + 8:04d}"
    assert_eq(r13, "0050")

    let r14 = "hex={255:x}"
    assert_eq(r14, "hex=ff")

    let r15 = "{name:*^10s}"
    assert_eq(r15, "***NOVA***")

    let r16 = "{name:-<10s}"
    assert_eq(r16, "NOVA------")

    print("format_interp_test: all passed")
