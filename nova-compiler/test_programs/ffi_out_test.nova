// out<T> FFI param: NOVA variable's slot address is passed to C; C writes
// through; NOVA reads the new value via subsequent slot loads. Mirrors the
// sqlite3_open(path, &db_out) pattern without the SQLite dependency.
extern fn c_test_set42(out_val: out<int>) -> int

fn main()
    let x = 0
    assert_eq(x, 0)
    let rc = unsafe c_test_set42(x)
    assert_eq(rc, 0)
    assert_eq(x, 42)  // C wrote 42 through the slot pointer
    print("out<T> test passed: C wrote through &x, NOVA sees the new value (42)")
