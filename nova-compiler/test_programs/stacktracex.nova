fn trace_new()
  let t = {}
  t["frames"] = []
  t["start_ms"] = time_ms()
  t

fn trace_push(t, name)
  let frame = {}
  frame["name"] = name
  frame["enter_ms"] = time_ms()
  frame["exit_ms"] = 0
  push(t["frames"], frame)

fn trace_pop(t)
  let frames = t["frames"]
  let i = len(frames) - 1
  while i >= 0
    if frames[i]["exit_ms"] == 0
      frames[i]["exit_ms"] = time_ms()
      return frames[i]["name"]
    i = i - 1
  ""

fn trace_depth(t)
  let depth = 0
  for f in t["frames"]
    if f["exit_ms"] == 0
      depth = depth + 1
  depth

fn trace_elapsed(t)
  time_ms() - t["start_ms"]

fn trace_dump(t)
  let lines = []
  for f in t["frames"]
    let dur = f["exit_ms"] - f["enter_ms"]
    if f["exit_ms"] == 0
      dur = time_ms() - f["enter_ms"]
    push(lines, f["name"] + " (" + str(dur) + "ms)")
  join(lines, "\n")

fn main()
  let t = trace_new()
  assert(trace_depth(t) == 0, "empty depth")

  trace_push(t, "main")
  assert(trace_depth(t) == 1, "depth 1")

  trace_push(t, "process")
  assert(trace_depth(t) == 2, "depth 2")

  sleep(10)
  let popped = trace_pop(t)
  assert(popped == "process", "popped process")
  assert(trace_depth(t) == 1, "depth back to 1")

  let _p2 = trace_pop(t)
  assert(trace_depth(t) == 0, "depth 0")

  let dump = trace_dump(t)
  assert(contains(dump, "main"), "dump has main")
  assert(contains(dump, "process"), "dump has process")
  assert(contains(dump, "ms"), "dump has timing")

  assert(trace_elapsed(t) >= 10, "elapsed >= 10ms")

  print("stacktracex: all passed")
