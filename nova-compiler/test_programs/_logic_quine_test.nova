import std/logic/logic_quine

// cki — integer known-answer check.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// ckb — boolean known-answer check.
fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got " + gs + " want " + ws)
        exit(1)

// ckl — integer-list known-answer check.
fn ckl(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// _cube_eq — compare two cubes of the same length.
fn _cube_eq(a, b)
    let n = len(a)
    if len(b) != n
        return false
    let i = 0
    while i < n
        if a[i] != b[i]
            return false
        i = i + 1
    true

// _sop_contains — check if a list of cubes contains a specific cube.
fn _sop_contains(sop, cube)
    let nc = len(sop)
    let i = 0
    while i < nc
        if _cube_eq(sop[i], cube)
            return true
        i = i + 1
    false

fn main()
    // --- lqm_cube_covers ---
    // cube [1,2]: x0 must be 1, x1 don't-care.
    // i=3=0b11: x0=(3>>0)&1=1 matches, x1=dc => covers=true
    ckb("cube_covers([1,2],3)=true", lqm_cube_covers([1,2], 3), true)
    // i=0=0b00: x0=0 != 1 => false
    ckb("cube_covers([1,2],0)=false", lqm_cube_covers([1,2], 0), false)
    // i=1=0b01: x0=1 matches => true
    ckb("cube_covers([1,2],1)=true", lqm_cube_covers([1,2], 1), true)
    // i=2=0b10: x0=0 != 1 => false
    ckb("cube_covers([1,2],2)=false", lqm_cube_covers([1,2], 2), false)
    // all don't-care cube covers everything
    ckb("cube_covers([2,2],0)=true", lqm_cube_covers([2,2], 0), true)
    ckb("cube_covers([2,2],3)=true", lqm_cube_covers([2,2], 3), true)
    // exact cube [0,0]: only covers i=0
    ckb("cube_covers([0,0],0)=true", lqm_cube_covers([0,0], 0), true)
    ckb("cube_covers([0,0],1)=false", lqm_cube_covers([0,0], 1), false)

    // --- lqm_sop_to_tt ---
    // SOP for OR n=2: [[1,2],[2,1]] => minterms 1,3 from [1,2] and 2,3 from [2,1] => T=14
    cki("sop_to_tt([[1,2],[2,1]],2)=14", lqm_sop_to_tt([[1,2],[2,1]], 2), 14)
    // SOP for AND n=2: [[1,1]] => only minterm 3 => T=8
    cki("sop_to_tt([[1,1]],2)=8", lqm_sop_to_tt([[1,1]], 2), 8)
    // Empty SOP => T=0
    cki("sop_to_tt([],2)=0", lqm_sop_to_tt([], 2), 0)
    // All-don't-care SOP => T=15 (tautology for n=2)
    cki("sop_to_tt([[2,2]],2)=15", lqm_sop_to_tt([[2,2]], 2), 15)

    // --- lqm_prime_implicants ---
    // OR n=2 (T=14): prime implicants are [1,2] (x0=1) and [2,1] (x1=1); exactly 2
    let pi_or = lqm_prime_implicants(14, 2)
    cki("pi_implicants(14,2) count=2", len(pi_or), 2)
    ckb("pi_or contains [1,2]", _sop_contains(pi_or, [1,2]), true)
    ckb("pi_or contains [2,1]", _sop_contains(pi_or, [2,1]), true)
    // AND n=2 (T=8): only minterm 3=[1,1], no merges possible => PI = [[1,1]]
    let pi_and = lqm_prime_implicants(8, 2)
    cki("pi_implicants(8,2) count=1", len(pi_and), 1)
    ckb("pi_and contains [1,1]", _sop_contains(pi_and, [1,1]), true)
    // Constant-0 function: no PIs
    let pi_zero = lqm_prime_implicants(0, 2)
    cki("pi_implicants(0,2) count=0", len(pi_zero), 0)
    // Tautology n=2 (T=15): single all-DC PI
    let pi_taut = lqm_prime_implicants(15, 2)
    cki("pi_implicants(15,2) count=1", len(pi_taut), 1)
    ckb("pi_taut contains [2,2]", _sop_contains(pi_taut, [2,2]), true)
    // pi coverage must reproduce T: lqm_sop_to_tt(pi, n) == T
    cki("pi_covers_or: sop_to_tt==14", lqm_sop_to_tt(pi_or, 2), 14)
    cki("pi_covers_and: sop_to_tt==8", lqm_sop_to_tt(pi_and, 2), 8)
    cki("pi_covers_taut: sop_to_tt==15", lqm_sop_to_tt(pi_taut, 2), 15)

    // --- lqm_minimize ---
    // AND n=2 (T=8): minimal SOP = [[1,1]]
    let min_and = lqm_minimize(8, 2)
    cki("minimize(8,2) count=1", len(min_and), 1)
    ckb("minimize(8,2) contains [1,1]", _sop_contains(min_and, [1,1]), true)
    cki("minimize(8,2) reproduces T", lqm_sop_to_tt(min_and, 2), 8)

    // OR n=2 (T=14): minimal SOP = 2 PIs
    let min_or = lqm_minimize(14, 2)
    cki("minimize(14,2) reproduces T", lqm_sop_to_tt(min_or, 2), 14)

    // XOR n=2 (T=6): minterms {1,2}, PIs are [1,0] and [0,1] (can't merge), minimal = 2 PIs
    let min_xor = lqm_minimize(6, 2)
    cki("minimize(6,2) reproduces T", lqm_sop_to_tt(min_xor, 2), 6)

    // T=1 n=2: only minterm 0, PI=[0,0], minimal=[[0,0]]
    let min_t1 = lqm_minimize(1, 2)
    cki("minimize(1,2) reproduces T", lqm_sop_to_tt(min_t1, 2), 1)

    // T=7 n=2: minterms {0,1,2}, PIs: {0,1}->[2,0], {0,2}->[0,2]... let's just check reproduction
    let min_t7 = lqm_minimize(7, 2)
    cki("minimize(7,2) reproduces T", lqm_sop_to_tt(min_t7, 2), 7)

    // Constant-0 n=2: empty cover
    let min_0 = lqm_minimize(0, 2)
    cki("minimize(0,2) count=0", len(min_0), 0)

    // Tautology n=2 (T=15): single [[2,2]]
    let min_taut = lqm_minimize(15, 2)
    cki("minimize(15,2) reproduces T", lqm_sop_to_tt(min_taut, 2), 15)
    cki("minimize(15,2) count=1", len(min_taut), 1)

    // n=3 tests: AND3 T = only minterm 7 (all-ones) = bit 7 = 128
    let t_and3 = 128
    let min_and3 = lqm_minimize(t_and3, 3)
    cki("minimize(128,3) reproduces T", lqm_sop_to_tt(min_and3, 3), t_and3)
    cki("minimize(128,3) count=1", len(min_and3), 1)

    // n=3 OR3: minterms = all except 0 = 0b11111110 = 254
    let t_or3 = 254
    let min_or3 = lqm_minimize(t_or3, 3)
    cki("minimize(254,3) reproduces T", lqm_sop_to_tt(min_or3, 3), t_or3)

    // KEY GATE: enumeration cross-check for n=2 values: minimize then sop_to_tt must equal T
    let check_vals = [8, 14, 6, 1, 7]
    let cv = 0
    while cv < len(check_vals)
        let tv = check_vals[cv]
        let cover = lqm_minimize(tv, 2)
        let got = lqm_sop_to_tt(cover, 2)
        if got != tv
            print("FAIL minimize_enumerate n=2 T=" + str(tv) + " got=" + str(got))
            exit(1)
        cv = cv + 1

    // n=3 enumeration: test all 256 possible 3-var functions
    let t3 = 0
    while t3 < 256
        let cover3 = lqm_minimize(t3, 3)
        let got3 = lqm_sop_to_tt(cover3, 3)
        if got3 != t3
            print("FAIL minimize_all_n3 T=" + str(t3) + " got=" + str(got3))
            exit(1)
        // Also verify pi coverage reproduces T.
        let pis3 = lqm_prime_implicants(t3, 3)
        let got_pi3 = lqm_sop_to_tt(pis3, 3)
        if got_pi3 != t3
            print("FAIL pi_all_n3 T=" + str(t3) + " got=" + str(got_pi3))
            exit(1)
        t3 = t3 + 1

    print("PASS _logic_quine_test")
