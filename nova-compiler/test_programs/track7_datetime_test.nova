import datetime

fn main()
    // Create a known date: 2024-01-15 10:30:00
    let dt = datetime.dt_from_parts(2024, 1, 15, 10, 30, 0)
    assert_eq(dt["year"], 2024)
    assert_eq(dt["month"], 1)
    assert_eq(dt["day"], 15)
    assert_eq(dt["hour"], 10)
    assert_eq(dt["min"], 30)

    // ISO format
    let iso = datetime.dt_format_iso(dt)
    if find(iso, "2024") < 0
        print("FAIL: dt_format_iso missing year")
        exit(1)

    // Date format
    let date_str = datetime.dt_format_date(dt)
    if find(date_str, "2024") < 0
        print("FAIL: dt_format_date missing year")
        exit(1)

    // Leap year
    assert_eq(datetime.dt_is_leap_year(2024), true)
    assert_eq(datetime.dt_is_leap_year(2023), false)
    assert_eq(datetime.dt_is_leap_year(1900), false)
    assert_eq(datetime.dt_is_leap_year(2000), true)

    // Days in month
    assert_eq(datetime.dt_days_in_month(2024, 2), 29)
    assert_eq(datetime.dt_days_in_month(2023, 2), 28)
    assert_eq(datetime.dt_days_in_month(2024, 1), 31)

    // Add seconds
    let dt2 = datetime.dt_add_seconds(dt, 3600)
    assert_eq(dt2["hour"], 11)

    // Add days
    let dt3 = datetime.dt_add_days(dt, 1)
    assert_eq(dt3["day"], 16)

    // Diff
    let diff = datetime.dt_diff_ms(dt3, dt)
    if diff < 86000000 or diff > 87000000
        print("FAIL: dt_diff_ms not ~86400000")
        exit(1)

    // Day of week
    let dow = datetime.dt_day_of_week(dt)
    if dow < 0 or dow > 6
        print("FAIL: dt_day_of_week out of range")
        exit(1)
    let day_name = datetime.dt_day_name(dow)
    if len(day_name) < 3
        print("FAIL: dt_day_name too short")
        exit(1)

    // Month name
    let mname = datetime.dt_month_name(1)
    assert_eq(mname, "January")

    print("TRACK 7 DATETIME TEST PASSED")
