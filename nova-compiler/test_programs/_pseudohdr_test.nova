import std/net/pseudohdr

fn main()
    // ── KAT 1: pseudo4 structure check ──────────────────────────────────────
    // pseudo4(0xC0A80001, 0xC0A800C7, 6, 20) => 12 bytes:
    //   C0 A8 00 01  C0 A8 00 C7  00 06  00 14
    let p4 = pseudo4(0xC0A80001, 0xC0A800C7, 6, 20)

    let p4len = bytes_len(p4)
    if p4len != 12
        print("FAIL pseudohdr pseudo4 length: got " + str(p4len) + " want 12")
        exit(1)

    // src u32 at bytes 0-3: 0xC0A80001
    let p4_src = ((bytes_get(p4, 0) << 24) | (bytes_get(p4, 1) << 16) | (bytes_get(p4, 2) << 8) | bytes_get(p4, 3)) & 0xFFFFFFFF
    if p4_src != 0xC0A80001
        print("FAIL pseudohdr pseudo4 src: got " + str(p4_src) + " want 3232235521")
        exit(1)

    // dst u32 at bytes 4-7: 0xC0A800C7
    let p4_dst = ((bytes_get(p4, 4) << 24) | (bytes_get(p4, 5) << 16) | (bytes_get(p4, 6) << 8) | bytes_get(p4, 7)) & 0xFFFFFFFF
    if p4_dst != 0xC0A800C7
        print("FAIL pseudohdr pseudo4 dst: got " + str(p4_dst) + " want 3232235719")
        exit(1)

    // byte 8 must be zero
    let p4_zero = bytes_get(p4, 8)
    if p4_zero != 0
        print("FAIL pseudohdr pseudo4 zero_byte: got " + str(p4_zero) + " want 0")
        exit(1)

    // byte 9 = protocol = 6
    let p4_proto = bytes_get(p4, 9)
    if p4_proto != 6
        print("FAIL pseudohdr pseudo4 protocol: got " + str(p4_proto) + " want 6")
        exit(1)

    // bytes 10-11 = length = 20 = 0x0014
    let p4_len_hi = bytes_get(p4, 10)
    let p4_len_lo = bytes_get(p4, 11)
    if p4_len_hi != 0
        print("FAIL pseudohdr pseudo4 length_hi: got " + str(p4_len_hi) + " want 0")
        exit(1)
    if p4_len_lo != 20
        print("FAIL pseudohdr pseudo4 length_lo: got " + str(p4_len_lo) + " want 20")
        exit(1)

    // ── KAT 2: pseudo6 structure check ──────────────────────────────────────
    // pseudo6(src16, dst16, 6, 20) => 40 bytes
    //   bytes 0-15  : src (16 zero bytes in this test)
    //   bytes 16-31 : dst (16 zero bytes in this test)
    //   bytes 32-35 : length u32 BE = 0x00000014
    //   bytes 36-38 : 0x00 0x00 0x00
    //   byte  39    : next_header = 6
    let src16 = bytes(16)
    let dst16 = bytes(16)
    let p6 = pseudo6(src16, dst16, 6, 20)

    let p6len = bytes_len(p6)
    if p6len != 40
        print("FAIL pseudohdr pseudo6 length: got " + str(p6len) + " want 40")
        exit(1)

    // length field at bytes 32-35: 0x00000014
    let p6_ul32 = ((bytes_get(p6, 32) << 24) | (bytes_get(p6, 33) << 16) | (bytes_get(p6, 34) << 8) | bytes_get(p6, 35)) & 0xFFFFFFFF
    if p6_ul32 != 20
        print("FAIL pseudohdr pseudo6 upper_layer_length: got " + str(p6_ul32) + " want 20")
        exit(1)

    // zero bytes at 36-38
    let p6_z0 = bytes_get(p6, 36)
    let p6_z1 = bytes_get(p6, 37)
    let p6_z2 = bytes_get(p6, 38)
    if p6_z0 != 0
        print("FAIL pseudohdr pseudo6 zero36: got " + str(p6_z0) + " want 0")
        exit(1)
    if p6_z1 != 0
        print("FAIL pseudohdr pseudo6 zero37: got " + str(p6_z1) + " want 0")
        exit(1)
    if p6_z2 != 0
        print("FAIL pseudohdr pseudo6 zero38: got " + str(p6_z2) + " want 0")
        exit(1)

    // next_header at byte 39 = 6
    let p6_nh = bytes_get(p6, 39)
    if p6_nh != 6
        print("FAIL pseudohdr pseudo6 next_header: got " + str(p6_nh) + " want 6")
        exit(1)

    // ── KAT 3: pseudo6 non-zero address propagation ──────────────────────────
    // src IPv6 = fe80::1 = FE 80 00..00 00 01 (16 bytes)
    let src6 = bytes(16)
    bytes_set(src6, 0, 0xFE)
    bytes_set(src6, 1, 0x80)
    bytes_set(src6, 15, 0x01)
    let dst6 = bytes(16)
    bytes_set(dst6, 0, 0xFF)
    bytes_set(dst6, 1, 0x02)
    bytes_set(dst6, 15, 0x01)
    let p6b = pseudo6(src6, dst6, 17, 0x1234)

    let p6b_s0 = bytes_get(p6b, 0)
    if p6b_s0 != 0xFE
        print("FAIL pseudohdr pseudo6 src[0]: got " + str(p6b_s0) + " want 254")
        exit(1)
    let p6b_d0 = bytes_get(p6b, 16)
    if p6b_d0 != 0xFF
        print("FAIL pseudohdr pseudo6 dst[0]: got " + str(p6b_d0) + " want 255")
        exit(1)
    let p6b_nh = bytes_get(p6b, 39)
    if p6b_nh != 17
        print("FAIL pseudohdr pseudo6 next_header UDP: got " + str(p6b_nh) + " want 17")
        exit(1)
    // length 0x1234 = 4660
    let p6b_ul = ((bytes_get(p6b, 32) << 24) | (bytes_get(p6b, 33) << 16) | (bytes_get(p6b, 34) << 8) | bytes_get(p6b, 35)) & 0xFFFFFFFF
    if p6b_ul != 0x1234
        print("FAIL pseudohdr pseudo6 length 0x1234: got " + str(p6b_ul) + " want 4660")
        exit(1)

    // ── KAT 4: l4_checksum encode + verify round-trip ───────────────────────
    // Use pseudo4(0xC0A80001, 0xC0A800C7, 6, 20) + 20-byte zeroed TCP header.
    // Expected csum = 0x7DCC (precomputed from RFC 1071 ones-complement).
    // Verification: after inserting csum at TCP bytes 16-17, l4_checksum == 0.
    //
    // Derivation:
    //   pseudo4 words (BE u16): C0A8 0001 C0A8 00C7 0006 0014
    //   sum = 0xC0A8+0x0001+0xC0A8+0x00C7+0x0006+0x0014 = 0x18232
    //   carry-fold: 0x8232 + 0x1 = 0x8233
    //   complement: ~0x8233 & 0xFFFF = 0x7DCC
    let tcp20 = bytes(20)
    let p4b = pseudo4(0xC0A80001, 0xC0A800C7, 6, 20)
    let csum = l4_checksum(p4b, tcp20)
    if csum != 0x7DCC
        print("FAIL pseudohdr l4_checksum expected: got " + str(csum) + " want 32204")
        exit(1)

    // Insert checksum into TCP bytes 16-17 and verify: result must be 0
    bytes_set(tcp20, 16, (csum >> 8) & 0xFF)
    bytes_set(tcp20, 17, csum & 0xFF)
    let p4c = pseudo4(0xC0A80001, 0xC0A800C7, 6, 20)
    let verify_csum = l4_checksum(p4c, tcp20)
    if verify_csum != 0
        print("FAIL pseudohdr l4_checksum verify: got " + str(verify_csum) + " want 0")
        exit(1)

    // ── KAT 5: short / empty safety (l4_checksum with empty l4) ─────────────
    // pseudo4 alone, no L4 data; should still return a folded 16-bit value
    let p4d = pseudo4(0x01020304, 0x05060708, 17, 0)
    let empty_l4 = bytes(0)
    let csum_empty = l4_checksum(p4d, empty_l4)
    // Just verify it's a valid 16-bit value (no crash / no negative)
    if csum_empty < 0
        print("FAIL pseudohdr l4_checksum empty l4 negative: got " + str(csum_empty))
        exit(1)
    if csum_empty > 0xFFFF
        print("FAIL pseudohdr l4_checksum empty l4 overflow: got " + str(csum_empty))
        exit(1)

    print("PASS _pseudohdr_test")
