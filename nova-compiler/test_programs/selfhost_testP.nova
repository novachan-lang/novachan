// Test: file I/O + full pipeline test
// Read a source file, tokenize it, count tokens

fn count_tokens(source: string) -> int
    let count = 0
    let i = 0
    let in_word = false
    while i < len(source)
        let ch = source[i]
        if ch == " " or ch == "\n" or ch == "\t"
            if in_word
                count = count + 1
                in_word = false
        else
            in_word = true
        i = i + 1
    if in_word
        count = count + 1
    return count

// Test with inline string
let code = "fn hello(x)\n    return x + 1\n\nlet y = hello(42)\nprint(y)"
let words = count_tokens(code)
print(words)

// Test string operations
let parts = split(code, "\n")
print(len(parts))
for line in parts
    if len(line) > 0
        print(line)
