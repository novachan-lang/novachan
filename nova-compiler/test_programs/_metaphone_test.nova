import std/text/metaphone

// Known-answer tests for meta().
// All expected values are hand-traced from the algorithm.

fn cks(label: string, got: string, expected: string)
    if got != expected
        print("FAIL " + label + ": got=" + got + " expected=" + expected)
        exit(1)

// KAT 1: empty string -> ""
cks("empty", meta(""), "")

// KAT 2: all vowels -> only initial vowel kept
cks("aeiou", meta("aeiou"), "A")

// KAT 3: PH->F, vowel dropped, NE->N
// phone: PHONE -> PH->F, O not initial->drop, N->N, E->drop -> "FN"
cks("phone", meta("phone"), "FN")

// KAT 4: leading KN -> silent K, so knife: KNIFE -> N, I->drop, F->F, E->drop -> "NF"
cks("knife", meta("knife"), "NF")

// KAT 5: Thompson -> THOMPSON -> TH->T, O->drop, M->M, P->P, S->S, O->drop, N->N -> "TMPSN"
cks("Thompson", meta("Thompson"), "TMPSN")

// KAT 6: Wikipedia -> WIKIPEDIA -> W+I(vowel)->W, I->drop, K->K, I->drop, P->P, E->drop, D(no GE)->T, I->drop, A->drop -> "WKPT"
cks("Wikipedia", meta("Wikipedia"), "WKPT")

// KAT 7: Smith -> SMITH -> S->S, M->M, I->drop, TH->T -> "SMT"
cks("Smith", meta("Smith"), "SMT")

// KAT 8: gnome -> leading GN->drop G, NOME -> N->N, O->drop, M->M, E->drop -> "NM"
cks("gnome", meta("gnome"), "NM")

// KAT 9: single consonant
// "b" -> B -> "B"
cks("b", meta("b"), "B")

// KAT 10: duplicate adjacent code collapse
// "bb" -> BB -> first B emitted, second B same as prev -> collapsed -> "B"
cks("bb", meta("bb"), "B")

print("_metaphone_test passed")
