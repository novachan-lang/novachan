// KAT test for std/data/jsonstream
import std/data/jsonstream

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn _jst_lists_eq(a: list, b: list) -> int
    let result = 1
    if len(a) != len(b)
        result = 0
    else
        let i = 0
        let m = len(a)
        while i < m
            if a[i] != b[i]
                result = 0
            i = i + 1
    return result

fn main()
    let dq = chr(34)
    let lb = chr(123)
    let rb = chr(125)

    // KAT 1: js_kinds("[1,2]") == ["lbracket","number","comma","number","rbracket"]
    let k1 = js_kinds("[1,2]")
    let e1 = ["lbracket","number","comma","number","rbracket"]
    if _jst_lists_eq(k1, e1) != 1
        print("FAIL KAT1: js_kinds wrong")
        exit(1)
    print("KAT 1 PASS")

    // KAT 2: js_token_count("{}") == 2
    let emptyobj = lb + rb
    let c2 = js_token_count(emptyobj)
    cki("KAT2", c2, 2)
    print("KAT 2 PASS")

    // KAT 3+4: tokens of "[42]"
    let t3 = js_tokens("[42]")
    let t3_1 = t3[1]
    let t3_1t = t3_1["t"]
    let t3_1v = t3_1["v"]
    cks("KAT3-t", t3_1t, "number")
    print("KAT 3 PASS")
    cks("KAT4-v", t3_1v, "42")
    print("KAT 4 PASS")

    // KAT 5: js_kinds('"hi"') == ["string"]
    let k5 = js_kinds(dq + "hi" + dq)
    let e5 = ["string"]
    if _jst_lists_eq(k5, e5) != 1
        print("FAIL KAT5: js_kinds string wrong")
        exit(1)
    print("KAT 5 PASS")

    // KAT 6: js_kinds("true") == ["true"]
    let k6 = js_kinds("true")
    let e6 = ["true"]
    if _jst_lists_eq(k6, e6) != 1
        print("FAIL KAT6: js_kinds true wrong")
        exit(1)
    print("KAT 6 PASS")

    // KAT 7: js_kinds('{"a":1}') == ["lbrace","string","colon","number","rbrace"]
    let obj_a1 = lb + dq + "a" + dq + ":1" + rb
    let k7 = js_kinds(obj_a1)
    let e7 = ["lbrace","string","colon","number","rbrace"]
    if _jst_lists_eq(k7, e7) != 1
        print("FAIL KAT7: js_kinds obj wrong")
        exit(1)
    print("KAT 7 PASS")

    // KAT 8: js_token_count("[1,2,3]") == 7
    let c8 = js_token_count("[1,2,3]")
    cki("KAT8", c8, 7)
    print("KAT 8 PASS")

    // bonus1: string token value
    let ts = js_tokens(dq + "hello" + dq)
    let ts0 = ts[0]
    let ts0v = ts0["v"]
    cks("bonus1-v", ts0v, "hello")
    print("BONUS 1 PASS")

    // bonus2: false token
    let kf = js_kinds("false")
    let ef = ["false"]
    if _jst_lists_eq(kf, ef) != 1
        print("FAIL bonus2: false wrong")
        exit(1)
    print("BONUS 2 PASS")

    // bonus3: null token
    let kn = js_kinds("null")
    let en = ["null"]
    if _jst_lists_eq(kn, en) != 1
        print("FAIL bonus3: null wrong")
        exit(1)
    print("BONUS 3 PASS")

    // bonus4: negative float number
    let tn = js_tokens("[-3.14]")
    let tn1 = tn[1]
    let tn1t = tn1["t"]
    let tn1v = tn1["v"]
    cks("bonus4-t", tn1t, "number")
    cks("bonus4-v", tn1v, "-3.14")
    print("BONUS 4 PASS")

    print("_jsonstream_test passed")
