// KAT test for std/util/logging
import std/util/logging

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got [" + got + "] want [" + want + "]")
        exit(1)

fn ckb(label, got, want)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got " + gs + " want " + ws)
        exit(1)

// ── lg_level_num ─────────────────────────────────────────────────────────────
cki("level_DEBUG",  lg_level_num("DEBUG"),  0)
cki("level_INFO",   lg_level_num("INFO"),   1)
cki("level_WARN",   lg_level_num("WARN"),   2)
cki("level_ERROR",  lg_level_num("ERROR"),  3)
cki("level_xxx",    lg_level_num("xxx"),   -1)
cki("level_empty",  lg_level_num(""),      -1)

// ── lg_should_log ─────────────────────────────────────────────────────────────
ckb("should_INFO_DEBUG",  lg_should_log("INFO", "DEBUG"),  false)
ckb("should_INFO_INFO",   lg_should_log("INFO", "INFO"),   true)
ckb("should_INFO_WARN",   lg_should_log("INFO", "WARN"),   true)
ckb("should_DEBUG_DEBUG", lg_should_log("DEBUG", "DEBUG"), true)
ckb("should_ERROR_WARN",  lg_should_log("ERROR", "WARN"),  false)
ckb("should_unknown_cfg", lg_should_log("TRACE", "DEBUG"), false)
ckb("should_unknown_msg", lg_should_log("DEBUG", "TRACE"), false)

// ── lg_format ────────────────────────────────────────────────────────────────
cks("fmt_INFO_hi",    lg_format("INFO",  "hi"),    "[INFO] hi")
cks("fmt_ERROR_boom", lg_format("ERROR", "boom"),  "[ERROR] boom")
cks("fmt_WARN_alert", lg_format("WARN",  "alert"), "[WARN] alert")
cks("fmt_DEBUG_x",    lg_format("DEBUG", "x"),     "[DEBUG] x")

// ── lg_format_ts ─────────────────────────────────────────────────────────────
// epoch 0 = 1970-01-01T00:00:00Z
cks("fmt_ts_epoch0", lg_format_ts("INFO", "boot", 0), "[INFO] 1970-01-01T00:00:00Z boot")

// epoch 1000000000 = 2001-09-09T01:46:40Z  (verified: python utcfromtimestamp)
cks("fmt_ts_1e9", lg_format_ts("ERROR", "crash", 1000000000), "[ERROR] 2001-09-09T01:46:40Z crash")

print("_logging_test passed")
