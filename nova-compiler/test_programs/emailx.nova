fn email_parse(addr)
  let at = -1
  let i = 0
  while i < len(addr)
    if slice(addr, i, i + 1) == "@"
      at = i
      i = len(addr)
    i = i + 1
  if at <= 0 or at >= len(addr) - 1
    return err("invalid email: missing @")
  let local = slice(addr, 0, at)
  let domain = slice(addr, at + 1, len(addr))
  if len(local) == 0 or len(domain) < 3
    return err("invalid email: empty local or domain")
  if not contains(domain, ".")
    return err("invalid email: domain needs a dot")
  ok({"local": local, "domain": domain, "full": addr})

fn email_valid(addr)
  is_ok(email_parse(addr))

fn email_domain(addr)
  let r = email_parse(addr)
  if is_err(r)
    return ""
  unwrap(r)["domain"]

fn email_normalize(addr)
  lower(trim(addr))

fn email_mask(addr)
  let r = email_parse(addr)
  if is_err(r)
    return addr
  let parsed = unwrap(r)
  let local = parsed["local"]
  let masked = slice(local, 0, 1)
  let k = 1
  while k < len(local)
    masked = masked + "*"
    k = k + 1
  masked + "@" + parsed["domain"]

fn main()
  let r = email_parse("user@example.com")
  assert(is_ok(r), "valid parse")
  let e = unwrap(r)
  assert(e["local"] == "user", "local part")
  assert(e["domain"] == "example.com", "domain")

  assert(email_valid("a@b.co") == 1, "valid short")
  assert(email_valid("user.name+tag@domain.org") == 1, "valid complex")
  assert(email_valid("missing-at.com") == 0, "no @")
  assert(email_valid("@domain.com") == 0, "empty local")
  assert(email_valid("user@") == 0, "empty domain")
  assert(email_valid("user@nodot") == 0, "no dot in domain")

  assert(email_domain("test@gmail.com") == "gmail.com", "domain extract")
  assert(email_domain("bad") == "", "bad = empty domain")

  assert(email_normalize("  User@Example.COM  ") == "user@example.com", "normalize")

  assert(email_mask("alice@example.com") == "a****@example.com", "mask")

  print("emailx: all passed")
