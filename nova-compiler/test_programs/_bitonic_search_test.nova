import std/search/bitonic_search

fn cki(name: string, got: int, want: int)
    if got != want
        print("FAIL " + name + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(name: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + name + ": got " + gs + " want " + ws)
        exit(1)

// KAT: bt_find_peak([1,3,8,12,4,2])=3
let a1 = [1, 3, 8, 12, 4, 2]
cki("peak_basic", bt_find_peak(a1), 3)

// KAT: bt_max([1,3,8,12,4,2])=12
cki("max_basic", bt_max(a1), 12)

// KAT: bt_search([1,3,8,12,4,2],4)=4
cki("search_descend_4", bt_search(a1, 4), 4)

// KAT: bt_search([1,3,8,12,4,2],3)=1
cki("search_ascend_3", bt_search(a1, 3), 1)

// KAT: bt_search([1,3,8,12,4,2],5)=-1
cki("search_absent_5", bt_search(a1, 5), -1)

// KAT: bt_find_peak([1,2,3])=2
let a2 = [1, 2, 3]
cki("peak_all_asc", bt_find_peak(a2), 2)

// edge: single element
let a3 = [7]
cki("peak_single", bt_find_peak(a3), 0)
cki("max_single", bt_max(a3), 7)
cki("search_single_found", bt_search(a3, 7), 0)
cki("search_single_miss", bt_search(a3, 5), -1)

// edge: two elements ascending
let a4 = [1, 5]
cki("peak_two_asc", bt_find_peak(a4), 1)
cki("search_two_found_peak", bt_search(a4, 5), 1)
cki("search_two_found_asc", bt_search(a4, 1), 0)
cki("search_two_miss", bt_search(a4, 3), -1)

// edge: two elements descending
let a5 = [5, 1]
cki("peak_two_desc", bt_find_peak(a5), 0)
cki("search_two_desc_found", bt_search(a5, 1), 1)

// peak is the target itself
cki("search_peak_itself", bt_search(a1, 12), 3)

// element at index 0 (ascending side)
cki("search_first_elem", bt_search(a1, 1), 0)

// element at last index (descending side)
cki("search_last_elem", bt_search(a1, 2), 5)

// longer array: peak in middle
let a6 = [2, 5, 10, 20, 15, 8, 3, 1]
cki("peak_long", bt_find_peak(a6), 3)
cki("max_long", bt_max(a6), 20)
cki("search_long_asc", bt_search(a6, 5), 1)
cki("search_long_desc", bt_search(a6, 8), 5)
cki("search_long_miss", bt_search(a6, 100), -1)

print("PASS _bitonic_search_test")
