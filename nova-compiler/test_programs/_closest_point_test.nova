// _closest_point_test.nova — KAT for std/geo/closest_point
// Known-answer tests for intermediate_point (great-circle interpolation).
import std/geo/closest_point

fn approx(a: float, b: float, tol: float) -> int
    let d = a - b
    let ad = d
    if d < 0.0
        ad = 0.0 - d
    if ad < tol
        return 1
    return 0

fn main()
    // KAT 1: intermediate_point(0,0, 0,2, 0.5) -> lon ≈ 1.0 (midpoint on equator)
    let pt1 = intermediate_point(0.0, 0.0, 0.0, 2.0, 0.5)
    let lat1 = pt1[0]
    let lon1 = pt1[1]
    let ok1 = approx(lon1, 1.0, 0.02)
    if ok1 != 1
        print("FAIL closest_point midpoint lon: " + str(lon1) + " expected ~1.0")
        exit(1)
    let ok1b = approx(lat1, 0.0, 0.02)
    if ok1b != 1
        print("FAIL closest_point midpoint lat: " + str(lat1) + " expected ~0.0")
        exit(1)

    // KAT 2: fraction=0.0 returns the start point
    let pt2 = intermediate_point(0.0, 0.0, 0.0, 2.0, 0.0)
    let lat2 = pt2[0]
    let lon2 = pt2[1]
    let ok2a = approx(lat2, 0.0, 0.01)
    let ok2b = approx(lon2, 0.0, 0.01)
    if ok2a != 1
        print("FAIL closest_point fraction=0 lat: " + str(lat2))
        exit(1)
    if ok2b != 1
        print("FAIL closest_point fraction=0 lon: " + str(lon2))
        exit(1)

    // KAT 3: fraction=1.0 returns the end point
    let pt3 = intermediate_point(0.0, 0.0, 0.0, 2.0, 1.0)
    let lat3 = pt3[0]
    let lon3 = pt3[1]
    let ok3a = approx(lat3, 0.0, 0.01)
    let ok3b = approx(lon3, 2.0, 0.01)
    if ok3a != 1
        print("FAIL closest_point fraction=1 lat: " + str(lat3))
        exit(1)
    if ok3b != 1
        print("FAIL closest_point fraction=1 lon: " + str(lon3))
        exit(1)

    // KAT 4: Non-equator path: (0,0)->(10,10), fraction=0.5 should be near (5,5)
    let pt4 = intermediate_point(0.0, 0.0, 10.0, 10.0, 0.5)
    let lat4 = pt4[0]
    let lon4 = pt4[1]
    let ok4a = approx(lat4, 5.0, 0.2)
    let ok4b = approx(lon4, 5.0, 0.2)
    if ok4a != 1
        print("FAIL closest_point diagonal lat: " + str(lat4) + " expected ~5.0")
        exit(1)
    if ok4b != 1
        print("FAIL closest_point diagonal lon: " + str(lon4) + " expected ~5.0")
        exit(1)

    // KAT 5: fraction=0.25 on equator path (0,0)->(0,4) → lon ≈ 1.0
    let pt5 = intermediate_point(0.0, 0.0, 0.0, 4.0, 0.25)
    let lat5 = pt5[0]
    let lon5 = pt5[1]
    let ok5 = approx(lon5, 1.0, 0.02)
    if ok5 != 1
        print("FAIL closest_point quarter lon: " + str(lon5) + " expected ~1.0")
        exit(1)
    let ok5b = approx(lat5, 0.0, 0.02)
    if ok5b != 1
        print("FAIL closest_point quarter lat: " + str(lat5) + " expected ~0.0")
        exit(1)

    print("PASS _closest_point_test")
