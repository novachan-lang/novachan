let items = [1, 3, 5, 7, 9]
let found = false
for x in items
    if x == 5
        found = true
        break
else
    found = false
assert(found == true, "for/else with break")

let flag = false
for x in [1, 2, 3]
    if x == 10
        flag = true
        break
else
    flag = true
assert(flag == true, "for/else without break runs else")

fn find_index(items: list, target: int) -> int
    for i in range(len(items))
        if items[i] == target
            return i
    return -1

assert(find_index([10, 20, 30], 20) == 1, "find_index found")
assert(find_index([10, 20, 30], 99) == -1, "find_index not found")

let count = 0
for x in [2, 4, 6]
    count += 1
else
    count += 100
assert(count == 103, "for/else count with else body")

print("all for/else tests passed")
