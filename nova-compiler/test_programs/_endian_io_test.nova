import std/os/endian_io

fn ck_int(label: string, got: int, want: int)
    if got != want
        print("FAIL endian_io " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck_list2(label: string, got: any, w0: int, w1: int)
    let g0 = got[0]
    let g1 = got[1]
    if g0 != w0 or g1 != w1
        print("FAIL endian_io " + label + ": got=[" + str(g0) + "," + str(g1) + "] want=[" + str(w0) + "," + str(w1) + "]")
        exit(1)

fn ck_list4(label: string, got: any, w0: int, w1: int, w2: int, w3: int)
    let g0 = got[0]
    let g1 = got[1]
    let g2 = got[2]
    let g3 = got[3]
    if g0 != w0 or g1 != w1 or g2 != w2 or g3 != w3
        print("FAIL endian_io " + label + ": got=[" + str(g0) + "," + str(g1) + "," + str(g2) + "," + str(g3) + "] want=[" + str(w0) + "," + str(w1) + "," + str(w2) + "," + str(w3) + "]")
        exit(1)

fn main()
    // KAT: write_u16_le(258) == [2, 1]   (258 = 0x0102, LE: 02 01)
    let r1 = write_u16_le(258)
    ck_list2("write_u16_le_258", r1, 2, 1)

    // KAT: write_u16_be(258) == [1, 2]   (258 = 0x0102, BE: 01 02)
    let r2 = write_u16_be(258)
    ck_list2("write_u16_be_258", r2, 1, 2)

    // KAT: read_u16_le([2,1], 0) == 258
    let buf1 = [2, 1]
    ck_int("read_u16_le_258", read_u16_le(buf1, 0), 258)

    // KAT: read_u16_be([1,2], 0) == 258
    let buf2 = [1, 2]
    ck_int("read_u16_be_258", read_u16_be(buf2, 0), 258)

    // KAT: write_u32_le(1) == [1, 0, 0, 0]
    let r3 = write_u32_le(1)
    ck_list4("write_u32_le_1", r3, 1, 0, 0, 0)

    // KAT: read_i16_le([0, 128], 0) == -32768   (0x8000 = 32768 unsigned = -32768 signed)
    let buf3 = [0, 128]
    ck_int("read_i16_le_neg32768", read_i16_le(buf3, 0), -32768)

    // Extra: write_u32_be(1) == [0, 0, 0, 1]
    let r4 = write_u32_be(1)
    ck_list4("write_u32_be_1", r4, 0, 0, 0, 1)

    // Extra: read_u32_le([1,0,0,0], 0) == 1
    let buf4 = [1, 0, 0, 0]
    ck_int("read_u32_le_1", read_u32_le(buf4, 0), 1)

    // Extra: read_u32_le with larger value — 0x01020304 in LE = [4,3,2,1]
    let buf5 = [4, 3, 2, 1]
    ck_int("read_u32_le_0x01020304", read_u32_le(buf5, 0), 16909060)

    // Extra: read_i16_le positive: [5, 0] => 5
    let buf6 = [5, 0]
    ck_int("read_i16_le_pos5", read_i16_le(buf6, 0), 5)

    // Extra: read_i16_le([255, 255], 0) => -1
    let buf7 = [255, 255]
    ck_int("read_i16_le_neg1", read_i16_le(buf7, 0), -1)

    // Extra: write/read roundtrip u16_le for 0
    let r5 = write_u16_le(0)
    ck_int("roundtrip_u16_le_0", read_u16_le(r5, 0), 0)

    // Extra: write/read roundtrip u32_le for 65535
    let r6 = write_u32_le(65535)
    ck_int("roundtrip_u32_le_65535", read_u32_le(r6, 0), 65535)

    print("PASS _endian_io_test")
