import std/core/opt

fn main() -> int
    let fails = 0
    let a = some(5)
    let b = none()
    if not opt_is_some(a)
        print("FAIL is_some a")
        fails = fails + 1
    if opt_is_some(b)
        print("FAIL is_some b")
        fails = fails + 1
    if not opt_is_none(b)
        print("FAIL is_none b")
        fails = fails + 1
    if opt_is_none(a)
        print("FAIL is_none a")
        fails = fails + 1
    if opt_unwrap_or(a, 0) != 5
        print("FAIL unwrap a")
        fails = fails + 1
    if opt_unwrap_or(b, 9) != 9
        print("FAIL unwrap b")
        fails = fails + 1
    match opt_map(a, fn(x) x * 2)
        Some(v) =>
            if v != 10
                print("FAIL map v=" + str(v))
                fails = fails + 1
        None =>
            print("FAIL map got None")
            fails = fails + 1
    match opt_map(b, fn(x) x * 2)
        Some(v) =>
            print("FAIL map None should stay None")
            fails = fails + 1
        None =>
            print("ok: map None stays None")
    match opt_filter(a, fn(x) x > 10)
        Some(v) =>
            print("FAIL filter should drop")
            fails = fails + 1
        None =>
            print("ok: filter dropped")
    match opt_filter(a, fn(x) x > 0)
        Some(v) =>
            if v != 5
                print("FAIL filter keep")
                fails = fails + 1
        None =>
            print("FAIL filter should keep")
            fails = fails + 1
    if fails == 0
        print("PASS _kat_opt")
    else
        print("FAILED _kat_opt")
    return 0
