type Point
    x: float
    y: float

fn dot_unann(a, b)
    a.x * b.x + a.y * b.y

fn dot_typed(a: Point, b: Point) -> float
    a.x * b.x + a.y * b.y

type IPoint
    x: int
    y: int

fn idot(a: IPoint, b: IPoint) -> int
    a.x * b.x + a.y * b.y

fn main()
    let p = Point(3.0, 4.0)
    let q = Point(1.0, 2.0)
    print(str(dot_typed(p, q)))
    print(str(dot_unann(p, q)))
    let ip = IPoint(3, 4)
    let iq = IPoint(1, 2)
    print(str(idot(ip, iq)))
