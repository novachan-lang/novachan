import std/config/layered

// KAT for std/config/layered.nova
// All expected values are hand-computed from the spec.

fn cks(label, got, expected)
    if got == expected
        return
    print("FAIL " + label + ": got=" + got + " expected=" + expected)
    exit(1)

fn cki(label, got, expected)
    if got == expected
        return
    print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
    exit(1)

fn main()
    // Build config with two layers:
    //   layer 0 (low)  = {"a":"1","b":"2"}
    //   layer 1 (high) = {"b":"20","c":"30"}
    // Precedence rule: later layer wins on overlap.
    let c = layered.cfg_new()
    let l0 = {}
    l0["a"] = "1"
    l0["b"] = "2"
    layered.cfg_add_layer(c, l0)
    let l1 = {}
    l1["b"] = "20"
    l1["c"] = "30"
    layered.cfg_add_layer(c, l1)

    // KAT 1: key only in low layer -> low value
    cks("get a", layered.cfg_get(c, "a", ""), "1")

    // KAT 2: key in both layers -> high layer wins
    cks("get b overridden", layered.cfg_get(c, "b", ""), "20")

    // KAT 3: key only in high layer -> high value
    cks("get c", layered.cfg_get(c, "c", ""), "30")

    // KAT 4: absent key -> dflt returned
    cks("get absent dflt", layered.cfg_get(c, "z", "def"), "def")

    // KAT 5: cfg_has on present key -> 1
    cki("has a", layered.cfg_has(c, "a"), 1)

    // KAT 6: cfg_has on absent key -> 0
    cki("has z absent", layered.cfg_has(c, "z"), 0)

    // KAT 7: cfg_get_int parses string to int
    cki("get_int c", layered.cfg_get_int(c, "c", 0), 30)

    // KAT 8: cfg_get_int absent key -> default returned as int
    cki("get_int absent", layered.cfg_get_int(c, "z", 99), 99)

    // KAT 9: cfg_merged flattens; b must be "20" (high layer wins)
    let m = layered.cfg_merged(c)
    cks("merged b", m["b"], "20")

    // KAT 10: cfg_merged contains low-layer-only key a = "1"
    cks("merged a", m["a"], "1")

    // KAT 11: cfg_merged contains high-layer-only key c = "30"
    cks("merged c", m["c"], "30")

    // KAT 12: cfg_keys returns sorted union of all keys = ["a","b","c"]
    let ks = layered.cfg_keys(c)
    cki("keys count", len(ks), 3)
    cks("keys[0]", ks[0], "a")
    cks("keys[1]", ks[1], "b")
    cks("keys[2]", ks[2], "c")

    // KAT 13: empty config returns empty keys list
    let e = layered.cfg_new()
    let eks = layered.cfg_keys(e)
    cki("empty keys count", len(eks), 0)

    // KAT 14: empty config cfg_get returns dflt
    cks("empty cfg_get", layered.cfg_get(e, "x", "none"), "none")

    // KAT 15: three layers — middle is shadowed by top but not bottom
    //   layer 0: x=base
    //   layer 1: x=mid, y=mid
    //   layer 2: x=top
    // cfg_get(x) = top; cfg_get(y) = mid
    let c3 = layered.cfg_new()
    let la = {}
    la["x"] = "base"
    layered.cfg_add_layer(c3, la)
    let lb = {}
    lb["x"] = "mid"
    lb["y"] = "mid"
    layered.cfg_add_layer(c3, lb)
    let lc = {}
    lc["x"] = "top"
    layered.cfg_add_layer(c3, lc)
    cks("3layer x", layered.cfg_get(c3, "x", ""), "top")
    cks("3layer y mid", layered.cfg_get(c3, "y", ""), "mid")

    print("_layered_test passed")
