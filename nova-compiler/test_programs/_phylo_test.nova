import std/bio/phylo

// approx: check two floats are within tolerance.
fn approx(a, b, tol) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < tol
        return true
    return false

fn fail(label, got, want)
    print("FAIL phylo " + label + ": got=" + str(got) + " want=" + str(want))
    exit(1)

fn fail_b(label, got, want)
    let gs = "false"
    if got
        gs = "true"
    let ws = "false"
    if want
        ws = "true"
    print("FAIL phylo " + label + ": got=" + gs + " want=" + ws)
    exit(1)

fn main()
    // KAT 1: p_distance of identical sequences == 0.0
    let d1 = p_distance("AAAA", "AAAA")
    if not approx(d1, 0.0, 0.0001)
        fail("p_distance identical", d1, 0.0)

    // KAT 2: p_distance 'AAAA' vs 'AATT' == 0.5
    let d2 = p_distance("AAAA", "AATT")
    if not approx(d2, 0.5, 0.0001)
        fail("p_distance 0.5", d2, 0.5)

    // KAT 3: hamming
    let h1 = hamming("AAAA", "AAAA")
    if h1 != 0
        print("FAIL phylo hamming_same: got=" + str(h1) + " want=0")
        exit(1)

    let h2 = hamming("AAAA", "AATT")
    if h2 != 2
        print("FAIL phylo hamming_diff: got=" + str(h2) + " want=2")
        exit(1)

    // KAT 4: transitions — A->G is a transition (purine<->purine)
    // "AAAA" vs "GGAA": positions 0,1 are A->G (transition), positions 2,3 are same
    let ti1 = transitions("AAAA", "GGAA")
    if ti1 != 2
        print("FAIL phylo transitions: got=" + str(ti1) + " want=2")
        exit(1)

    // KAT 5: transversions — A->T is a transversion (purine<->pyrimidine)
    // "AAAA" vs "TTAA": positions 0,1 are A->T (transversion), positions 2,3 same
    let tv1 = transversions("AAAA", "TTAA")
    if tv1 != 2
        print("FAIL phylo transversions: got=" + str(tv1) + " want=2")
        exit(1)

    // KAT 6: jukes_cantor on identical sequences == 0.0
    let jc1 = jukes_cantor("AAAA", "AAAA")
    if not approx(jc1, 0.0, 0.0001)
        fail("jukes_cantor_ident", jc1, 0.0)

    // KAT 7: jukes_cantor on p>=0.75 returns 10.0
    // "AAAA" vs "TTTT" => p=1.0 => should return 10.0
    let jc2 = jukes_cantor("AAAA", "TTTT")
    if not approx(jc2, 10.0, 0.0001)
        fail("jukes_cantor_limit", jc2, 10.0)

    // KAT 8: jukes_cantor on p=0.5 => -0.75*ln(1 - (4/3)*0.5) = -0.75*ln(1/3) = -0.75*(-1.0986) ~ 0.8240
    let jc3 = jukes_cantor("AAAA", "AATT")
    let jc3_expected = 0.8240
    if not approx(jc3, jc3_expected, 0.01)
        fail("jukes_cantor_0.5", jc3, jc3_expected)

    // KAT 9: is_transition checks
    let it1 = is_transition("A", "G")
    if not it1
        fail_b("is_transition AG", it1, true)

    let it2 = is_transition("C", "T")
    if not it2
        fail_b("is_transition CT", it2, true)

    let it3 = is_transition("A", "T")
    if it3
        fail_b("is_transition AT should be false", it3, false)

    let it4 = is_transition("A", "A")
    if it4
        fail_b("is_transition AA same should be false", it4, false)

    // KAT 10: newick_join produces string containing both names
    let nw = newick_join("A", "B", 1.0)
    let has_a = contains(nw, "A")
    let has_b = contains(nw, "B")
    if not has_a
        print("FAIL phylo newick_join missing A: " + nw)
        exit(1)
    if not has_b
        print("FAIL phylo newick_join missing B: " + nw)
        exit(1)
    if len(nw) == 0
        print("FAIL phylo newick_join empty string")
        exit(1)

    // KAT 11: dist_matrix — 3 identical seqs => all zeros
    let seqs3 = ["AAA", "AAA", "AAA"]
    let mat3 = dist_matrix(seqs3)
    let m00 = mat3[0]
    if not approx(m00, 0.0, 0.0001)
        fail("dist_matrix diagonal", m00, 0.0)

    // KAT 12: dist_matrix — 2 seqs with p_distance 0.5
    let seqs2 = ["AAAA", "AATT"]
    let mat2 = dist_matrix(seqs2)
    let m01 = mat2[1]
    if not approx(m01, 0.5, 0.0001)
        fail("dist_matrix offdiag", m01, 0.5)

    // KAT 13: upgma on 3 sequences returns a list of merge steps
    let seqs_u = ["AAAA", "AATT", "TTTT"]
    let steps = upgma(seqs_u)
    let nsteps = len(steps)
    if nsteps != 2
        print("FAIL phylo upgma step count: got=" + str(nsteps) + " want=2")
        exit(1)

    // KAT 14: tree_to_newick returns non-empty string with sequence labels
    let names = ["Alpha", "Beta", "Gamma"]
    let seqs_n = ["AAAA", "AATT", "TTTT"]
    let steps2 = upgma(seqs_n)
    let newick = tree_to_newick(steps2, names)
    if len(newick) == 0
        print("FAIL phylo tree_to_newick empty")
        exit(1)

    // KAT 15: newick_leaf just returns the name
    let lf = newick_leaf("MySeq")
    if lf != "MySeq"
        print("FAIL phylo newick_leaf: got=" + lf + " want=MySeq")
        exit(1)

    // KAT 16: kimura2p on identical seqs == 0.0
    let k2p1 = kimura2p("AAAA", "AAAA")
    if not approx(k2p1, 0.0, 0.0001)
        fail("kimura2p_identical", k2p1, 0.0)

    print("PASS _phylo_test")
