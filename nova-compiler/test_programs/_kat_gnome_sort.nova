import std/algo/gnome_sort as gnm

fn main()
    assert_eq(gnm.gnm_sort([5,3,4,1,2]), [1,2,3,4,5])
    assert_eq(gnm.gnm_sort([4,3,2,1]), [1,2,3,4])
    assert_eq(gnm.gnm_sort([]), [])
    assert_eq(gnm.gnm_sort([7]), [7])
    assert_eq(gnm.gnm_sort_desc([1,4,2]), [4,2,1])
    assert_eq(gnm.gnm_swap_count([3,2,1]), 3)
    assert_eq(gnm.gnm_swap_count([1,2,3]), 0)
    assert_eq(gnm.gnm_swap_count([5,3,4,1,2]), 8)
    assert_true(gnm.gnm_is_sorted([1,2,3]))
    assert_true(not gnm.gnm_is_sorted([2,1,3]))
    assert_eq(gnm.gnm_sort(["banana","apple","cherry"]), ["apple","banana","cherry"])
    print("ALL OK")
