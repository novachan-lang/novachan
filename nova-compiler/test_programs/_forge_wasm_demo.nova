// Full-stack: Forge (NOVA backend) serves the NOVA-compiled wasm FRONTEND. GET / -> counter HTML (text),
// GET /counter.wasm -> the wasm bytes (binary, NUL-safe via forge.file -> read_bytes + resp_bytes). ONE
// language, front AND back. (`html` is a forge short fn name -> don't use it as a local var.)
import forge
fn home_h(req: Request) -> Response
    forge.file("_wasm_counter.html")
fn wasm_h(req: Request) -> Response
    forge.file("_counter.wasm")
fn _client(port: int, rch)
    sleep(60)
    let s1 = tcp_connect("127.0.0.1", port)
    tcp_send(s1, "GET / HTTP/1.0\r\n\r\n")
    let r_home = tcp_recv(s1)
    tcp_close(s1)
    let s2 = tcp_connect("127.0.0.1", port)
    tcp_send(s2, "GET /counter.wasm HTTP/1.0\r\n\r\n")
    let r_wasm = tcp_recv(s2)
    tcp_close(s2)
    let ok = find(r_home, "NOVA") >= 0 and find(r_wasm, "application/wasm") >= 0
    if ok
        print("PASS forge_wasm_demo: Forge serves the NOVA wasm frontend (html + application/wasm)")
    else
        print("FAIL forge_wasm_demo home=" + str(find(r_home, "NOVA")) + " wasmct=" + str(find(r_wasm, "application/wasm")))
    send(rch, 1)
fn main()
    let app = forge.app()
    forge.get(app, "/", home_h)
    forge.get(app, "/counter.wasm", wasm_h)
    let port = 19613
    let ap = app
    let pp = port
    let results = channel()
    let rc = results
    let p2 = port
    sched_spawn(fn(z) forge.serve_req_n(ap, pp, 2))
    sleep(30)
    sched_spawn(fn(z) _client(p2, rc))
    let r = recv(results)
    print("done " + str(r))
