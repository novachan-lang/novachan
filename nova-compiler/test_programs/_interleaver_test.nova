import std/coding/interleaver

// ── helpers ──────────────────────────────────────────────────────────────────

fn list_eq(a, b) -> bool
    let na = len(a)
    let nb = len(b)
    if na != nb
        return false
    let i = 0
    while i < na
        if a[i] != b[i]
            return false
        i = i + 1
    true

fn fail_list(label, got, want)
    let gs = ""
    let ws = ""
    let i = 0
    while i < len(got)
        gs = gs + str(got[i])
        if i + 1 < len(got)
            gs = gs + ","
        i = i + 1
    let j = 0
    while j < len(want)
        ws = ws + str(want[j])
        if j + 1 < len(want)
            ws = ws + ","
        j = j + 1
    print("FAIL interleaver " + label + ": got=[" + gs + "] want=[" + ws + "]")
    exit(1)

fn fail_int(label, got, want)
    print("FAIL interleaver " + label + ": got=" + str(got) + " want=" + str(want))
    exit(1)

fn main()
    // ── KAT: il_block_interleave 2x3 ─────────────────────────────────────────
    // Input [1,2,3,4,5,6] written into 2x3 matrix row-major:
    //   row0: [1, 2, 3]
    //   row1: [4, 5, 6]
    // Read column-major: col0=[1,4], col1=[2,5], col2=[3,6] -> [1,4,2,5,3,6]
    let data6 = []
    push(data6, 1)
    push(data6, 2)
    push(data6, 3)
    push(data6, 4)
    push(data6, 5)
    push(data6, 6)
    let want_il23 = []
    push(want_il23, 1)
    push(want_il23, 4)
    push(want_il23, 2)
    push(want_il23, 5)
    push(want_il23, 3)
    push(want_il23, 6)
    let got_il23 = il_block_interleave(data6, 2, 3)
    if not list_eq(got_il23, want_il23)
        fail_list("block_interleave([1..6],2,3)", got_il23, want_il23)

    // ── KAT: il_block_deinterleave 2x3 ───────────────────────────────────────
    // Inverse of above: [1,4,2,5,3,6] -> [1,2,3,4,5,6]
    let got_deil23 = il_block_deinterleave(want_il23, 2, 3)
    if not list_eq(got_deil23, data6)
        fail_list("block_deinterleave([1,4,2,5,3,6],2,3)", got_deil23, data6)

    // ── KAT: il_block_interleave 2x2 ─────────────────────────────────────────
    // Input [1,2,3,4] written into 2x2:
    //   row0: [1, 2]
    //   row1: [3, 4]
    // Read col-major: col0=[1,3], col1=[2,4] -> [1,3,2,4]
    let data4 = []
    push(data4, 1)
    push(data4, 2)
    push(data4, 3)
    push(data4, 4)
    let want_il22 = []
    push(want_il22, 1)
    push(want_il22, 3)
    push(want_il22, 2)
    push(want_il22, 4)
    let got_il22 = il_block_interleave(data4, 2, 2)
    if not list_eq(got_il22, want_il22)
        fail_list("block_interleave([1,2,3,4],2,2)", got_il22, want_il22)

    // ── KAT: round-trip 2x2 ──────────────────────────────────────────────────
    let rt22 = il_block_deinterleave(got_il22, 2, 2)
    if not list_eq(rt22, data4)
        fail_list("roundtrip_2x2", rt22, data4)

    // ── KAT: round-trip 2x3 ──────────────────────────────────────────────────
    let rt23 = il_block_deinterleave(il_block_interleave(data6, 2, 3), 2, 3)
    if not list_eq(rt23, data6)
        fail_list("roundtrip_2x3", rt23, data6)

    // ── KAT: round-trip 3x4 ──────────────────────────────────────────────────
    let data12 = []
    push(data12, 1)
    push(data12, 2)
    push(data12, 3)
    push(data12, 4)
    push(data12, 5)
    push(data12, 6)
    push(data12, 7)
    push(data12, 8)
    push(data12, 9)
    push(data12, 10)
    push(data12, 11)
    push(data12, 12)
    let rt34 = il_block_deinterleave(il_block_interleave(data12, 3, 4), 3, 4)
    if not list_eq(rt34, data12)
        fail_list("roundtrip_3x4", rt34, data12)

    // ── KAT: il_pad ──────────────────────────────────────────────────────────
    let data3 = []
    push(data3, 1)
    push(data3, 2)
    push(data3, 3)
    let padded = il_pad(data3, 4)
    let want_pad = []
    push(want_pad, 1)
    push(want_pad, 2)
    push(want_pad, 3)
    push(want_pad, 0)
    if not list_eq(padded, want_pad)
        fail_list("pad([1,2,3],4)", padded, want_pad)
    // Already aligned: no padding needed
    let padded_aligned = il_pad(data4, 2)
    if not list_eq(padded_aligned, data4)
        fail_list("pad([1,2,3,4],2)", padded_aligned, data4)

    // ── KAT: il_matrix_interleave (depth=2) ──────────────────────────────────
    // Same as block interleave with rows=2, cols=3
    let mat_il = il_matrix_interleave(data6, 2)
    if not list_eq(mat_il, want_il23)
        fail_list("matrix_interleave([1..6],2)", mat_il, want_il23)

    // ── KAT: il_matrix_deinterleave (depth=2) ────────────────────────────────
    let mat_deil = il_matrix_deinterleave(mat_il, 2)
    if not list_eq(mat_deil, data6)
        fail_list("matrix_deinterleave(mat_il,2)", mat_deil, data6)

    // ── KAT: il_spread ───────────────────────────────────────────────────────
    // il_spread([0,1,2,3,4], 2): output[i] = input[(i*2) mod 5]
    //   i=0: 0 -> data[0]=0
    //   i=1: 2 -> data[2]=2
    //   i=2: 4 -> data[4]=4
    //   i=3: 6%5=1 -> data[1]=1
    //   i=4: 8%5=3 -> data[3]=3
    // Result: [0, 2, 4, 1, 3]
    let data5 = []
    push(data5, 0)
    push(data5, 1)
    push(data5, 2)
    push(data5, 3)
    push(data5, 4)
    let want_spread = []
    push(want_spread, 0)
    push(want_spread, 2)
    push(want_spread, 4)
    push(want_spread, 1)
    push(want_spread, 3)
    let got_spread = il_spread(data5, 2)
    if not list_eq(got_spread, want_spread)
        fail_list("spread([0,1,2,3,4],2)", got_spread, want_spread)

    // ── KAT: il_gather (inverse of il_spread) ────────────────────────────────
    // il_gather([0,2,4,1,3], 2) should recover [0,1,2,3,4]
    // step_inv of 2 mod 5 = 3 (since 2*3=6 ≡ 1 mod 5)
    // gathered[j] = spread_data[(j*3) mod 5]
    //   j=0: 0 -> spread[0]=0
    //   j=1: 3 -> spread[3]=1
    //   j=2: 6%5=1 -> spread[1]=2
    //   j=3: 9%5=4 -> spread[4]=3
    //   j=4: 12%5=2 -> spread[2]=4
    // Result: [0,1,2,3,4] ✓
    let got_gather = il_gather(want_spread, 2)
    if not list_eq(got_gather, data5)
        fail_list("gather(spread([0..4],2),2)", got_gather, data5)

    // ── KAT: spread/gather round-trip with various step values ───────────────
    // step=1: identity (gcd(1,5)=1)
    let sp1 = il_spread(data5, 1)
    let ga1 = il_gather(sp1, 1)
    if not list_eq(ga1, data5)
        fail_list("spread_gather_step1", ga1, data5)
    // step=3 on data5 (gcd(3,5)=1)
    let sp3 = il_spread(data5, 3)
    let ga3 = il_gather(sp3, 3)
    if not list_eq(ga3, data5)
        fail_list("spread_gather_step3", ga3, data5)
    // step=2 on data4 (gcd(2,4)=2: not coprime, gather is best-effort but spread+gather identity)
    // Use step=3 on data4 (gcd(3,4)=1: coprime)
    let sp3_4 = il_spread(data4, 3)
    let ga3_4 = il_gather(sp3_4, 3)
    if not list_eq(ga3_4, data4)
        fail_list("spread_gather_step3_len4", ga3_4, data4)

    // ── KAT: spread is a permutation (distinct elements) ─────────────────────
    // Check that il_spread([0,1,2,3,4], 2) contains each of 0..4 exactly once
    let spcheck = il_spread(data5, 2)
    let seen = {}
    let ci = 0
    while ci < len(spcheck)
        seen[str(spcheck[ci])] = 1
        ci = ci + 1
    if len(seen) != 5
        print("FAIL interleaver spread_permutation: not a bijection")
        exit(1)

    // ── KAT: il_block_deinterleave known vector ───────────────────────────────
    // [1,4,2,5,3,6] de-interleaved with 2 rows 3 cols -> [1,2,3,4,5,6]
    let known_deil = il_block_deinterleave(want_il23, 2, 3)
    if not list_eq(known_deil, data6)
        fail_list("block_deinterleave_known", known_deil, data6)

    print("PASS _interleaver_test")
