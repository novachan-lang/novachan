// D8 seedable deterministic PRNG (xoshiro256**): rng_new/rng_next/rng_int/rng_float.
fn main()
    let r = rng_new(42)
    let r2 = rng_new(42)
    // determinism: same seed -> same first value
    let a1 = rng_next(r)
    let b1 = rng_next(r2)
    if a1 != b1
        print("FAIL determinism")
        exit(1)
    print("ok determinism")
    // seed independence: seed 43 differs (near-certain)
    let r3 = rng_new(43)
    if rng_next(r3) == a1
        print("FAIL seed independence")
        exit(1)
    print("ok seed independence")
    // rng_int range [0, n)
    let i = 0
    while i < 2000
        let v = rng_int(r, 6)
        if v < 0 or v >= 6
            print("FAIL rng_int range: " + str(v))
            exit(1)
        i = i + 1
    print("ok rng_int range")
    // rng_float range [0, 1)
    i = 0
    while i < 2000
        let f = rng_float(r)
        if f < 0.0 or f >= 1.0
            print("FAIL rng_float range: " + str(f))
            exit(1)
        i = i + 1
    print("ok rng_float range")
    // reproducibility: two fresh streams seeded 7 produce identical 200-value sequences
    let ra = rng_new(7)
    let rb = rng_new(7)
    i = 0
    while i < 200
        if rng_next(ra) != rng_next(rb)
            print("FAIL reproducibility at " + str(i))
            exit(1)
        i = i + 1
    print("ok reproducibility(200)")
    print("_d8_rng_test passed")
