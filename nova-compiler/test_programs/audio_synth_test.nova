// Audio synthesis (the compute substrate of audio) in NOVA: generate one period of a
// sine wave as 8 samples and verify against the analytical sine. sample[i]=sin(2*pi*i/8).
// (Sample generation is pure compute + verifiable; actual device PLAYBACK needs audio
//  hardware, which is the honest boundary.)
fn main()
    let pi = 3.141592653589793
    let n = 8
    let samples = []
    let i = 0
    while i < n
        let t = (2.0 * pi * int_to_float(i)) / 8.0
        samples.push(sin(t))
        i = i + 1
    assert_near(samples[0], 0.0, 0.001)    // sin(0)
    assert_near(samples[2], 1.0, 0.001)    // sin(pi/2)
    assert_near(samples[4], 0.0, 0.001)    // sin(pi)
    assert_near(samples[6], -1.0, 0.001)   // sin(3pi/2)
    print("audio synthesis test passed: 8 sine samples match analytical")
