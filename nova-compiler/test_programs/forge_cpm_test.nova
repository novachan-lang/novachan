import forge_cpm

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // tasks A(3) B(2) C(4) D(1); deps A->C, B->C, C->D
    // A ef=3, B ef=2, C starts at max(3,2)=3 ef=7, D starts 7 ef=8 -> critical path 8
    let dur = {}
    dur["A"] = 3
    dur["B"] = 2
    dur["C"] = 4
    dur["D"] = 1
    let deps = [["A", "C"], ["B", "C"], ["C", "D"]]
    fails = fails + expect("cpl", str(critical_path_length(deps, dur)), "8")
    let ef = earliest_finish(deps, dur)
    fails = fails + expect("ef_A", str(ef["A"]), "3")
    fails = fails + expect("ef_C", str(ef["C"]), "7")
    fails = fails + expect("ef_D", str(ef["D"]), "8")

    // linear chain A->B->C: durations 2,3,4 -> ef sums to 9
    let d2 = {}
    d2["A"] = 2
    d2["B"] = 3
    d2["C"] = 4
    fails = fails + expect("chain", str(critical_path_length([["A", "B"], ["B", "C"]], d2)), "9")

    // no dependencies: critical path = max single duration
    let d3 = {}
    d3["A"] = 5
    d3["B"] = 3
    d3["C"] = 8
    fails = fails + expect("no_deps", str(critical_path_length([], d3)), "8")

    // parallel then join: A(2),B(4) both -> C(1). C starts max(2,4)=4, ef 5
    let d4 = {}
    d4["A"] = 2
    d4["B"] = 4
    d4["C"] = 1
    fails = fails + expect("parallel_join", str(critical_path_length([["A", "C"], ["B", "C"]], d4)), "5")

    // cycle -> -1
    let d5 = {}
    d5["A"] = 1
    d5["B"] = 1
    fails = fails + expect("cycle", str(critical_path_length([["A", "B"], ["B", "A"]], d5)), "-1")

    // single task
    let d6 = {}
    d6["only"] = 7
    fails = fails + expect("single", str(critical_path_length([], d6)), "7")

    if fails == 0
        print("forge_cpm: all passed")
    else
        print("forge_cpm: " + str(fails) + " FAILED")
