// Canonical KAT test for std/text/casefold (Unicode case-insensitive fold). UTF-8 source. Verified vectors.
import std/text/casefold

fn ok_t(name: string, cond: bool)
    if not cond
        print("FAIL " + name)
        exit(1)
    print("ok " + name)

fn main()
    ok_t("Hello==hello", str_eq_ci("Hello", "hello"))
    ok_t("HELLO==hello", str_eq_ci("HELLO", "hello"))
    ok_t("Hello!=world", not str_eq_ci("Hello", "world"))
    ok_t("casefold HELLO", casefold("HELLO") == "hello")
    ok_t("Latin-1 HÉLLO==héllo", str_eq_ci("HÉLLO", "héllo"))
    ok_t("Latin-1 CAFÉ==café", str_eq_ci("CAFÉ", "café"))
    ok_t("Greek ΑΒΓ==αβγ", str_eq_ci("ΑΒΓ", "αβγ"))
    ok_t("Cyrillic ПРИВЕТ==привет", str_eq_ci("ПРИВЕТ", "привет"))
    ok_t("ss-scope straße!=STRASSE", not str_eq_ci("straße", "STRASSE"))
    ok_t("contains_ci quick", str_contains_ci("The Quick Brown", "quick"))
    ok_t("café bytes preserved", casefold("café") == "café")
    print("_casefold_test passed")
