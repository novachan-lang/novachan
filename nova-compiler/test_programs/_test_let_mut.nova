fn main()
    let mut x = 10
    x = x + 5
    assert(x == 15, "mut reassign works")

    let mut name = "hello"
    name = name + " world"
    assert(name == "hello world", "mut string reassign")

    let y = 42
    assert(y == 42, "immutable let still works")

    let mut counter = 0
    let i = 0
    while i < 5
        counter = counter + 1
        i = i + 1
    assert(counter == 5, "mut in loop")

    let mut_var = 99
    assert(mut_var == 99, "variable named mut_var works")

    print("LET-MUT TEST PASS")
