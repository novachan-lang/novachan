import forge_json_patch

fn main()
    let p = jp_new()
    p = jp_add(p, "name", "Alice")
    p = jp_add(p, "age", "30")
    p = jp_replace(p, "name", "Bob")
    p = jp_remove(p, "age")
    assert(jp_op_count(p) == 4, "4 ops")
    assert(jp_op_type(p, 0) == "add", "op 0 = add")
    assert(jp_op_path(p, 0) == "name", "path 0 = name")

    let target = {}
    target["name"] = "Original"
    target["city"] = "NYC"
    let result = jp_apply(p, target)

    assert(result["name"] == "Bob", "name replaced to Bob")
    assert(result["age"] == "", "age removed (empty)")
    assert(result["city"] == "NYC", "city unchanged")

    print("JSON-PATCH KAT PASS")
