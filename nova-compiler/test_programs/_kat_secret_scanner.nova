import forge_secret_scanner

fn main()
    let sc = ss_new()
    ss_add_pattern(sc, "aws_key", "AKIA", 20)
    ss_add_pattern(sc, "slack_token", "xoxb-", 10)
    ss_add_pattern(sc, "generic_key", "sk_live_", 10)

    assert(ss_pattern_count(sc) == 3, "3 patterns registered")
    assert(ss_has_pattern(sc, "aws_key") == 1, "has aws_key")
    assert(ss_has_pattern(sc, "nonexistent") == 0, "no nonexistent pattern")

    let text1 = "config: aws_access_key_id=AKIAIOSFODNN7EXAMPLE region=us-east-1"
    let r1 = ss_scan(sc, text1)
    assert(r1 == 1, "1 finding in text1")
    assert(ss_findings(sc) == "aws_key", "text1 matched aws_key")

    let text2 = "hello world, no secrets here"
    let r2 = ss_scan(sc, text2)
    assert(r2 == 0, "0 findings in text2")
    assert(ss_findings(sc) == "", "text2 findings empty")

    let text3 = "token=xoxb-1234567890-abc and key sk_live_51H8xyzTESTKEY123"
    let r3 = ss_scan(sc, text3)
    assert(r3 == 2, "2 findings in text3")
    assert(ss_findings(sc) == "slack_token,generic_key", "text3 matched slack_token,generic_key")

    assert(ss_total_scans(sc) == 3, "3 scans performed")
    assert(ss_total_findings(sc) == 3, "3 total findings across all scans")

    print("SECRET-SCANNER KAT PASS")
