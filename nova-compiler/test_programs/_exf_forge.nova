import forge

fn main()
    // redirect() -- the interpolated template; also exercises _status_line + _safe_header
    for c in [301, 302, 303, 307, 308, 599]
        print("[" + redirect(c, "/next") + "]")
    print("[" + redirect(302, "/a/b?x=1&y=2") + "]")
    print("[" + redirect(302, "") + "]")
    print("[" + redirect(302, "/x\r\nInjected: 1") + "]")

    // finalize() -> _finalize2: header ordering, Content-Length, Connection, Server, body
    print("[" + finalize(resp_text(200, "hi")) + "]")
    print("[" + finalize(resp_text(200, "")) + "]")
    print("[" + finalize(resp_html(500, "<b>x</b>")) + "]")
    print("[" + finalize(resp_error(404, "nope")) + "]")
    print("[" + finalize(resp_text(204, "")) + "]")

    // a response carrying custom headers -- exercises the filtered header comprehension,
    // including the reserved names that must be DROPPED and re-derived
    let r = resp_text(200, "body")
    r.headers["X-Custom"] = "v1"
    r.headers["content-length"] = "999"
    r.headers["Connection"] = "upgrade"
    r.headers["SERVER"] = "evil"
    print("[" + finalize(r) + "]")

    print("EXERCISE-DONE")
