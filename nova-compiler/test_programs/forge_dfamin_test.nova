import forge_dfamin as dm

fn check(cond: bool, label: str)
    if cond == false
        print("FAIL: " + label)

// TEST 1: DFA with redundant states that should collapse.
// Alphabet {0,1}. Language: strings ending in accepting. Build a DFA where two states are equivalent.
// States: 0 (start, non-acc), 1 (acc), 2 (acc, duplicate of 1)
// trans: 0 --0--> 1, 0 --1--> 2 ; 1 --0--> 1, 1 --1--> 2 ; 2 --0--> 1, 2 --1--> 2
// States 1 and 2 are both accepting and have identical transition behavior -> should merge.
let trans1 = [[1, 2], [1, 2], [1, 2]]
let acc1 = [0, 1, 1]
let res1 = dm.dfa_minimize(3, 2, trans1, acc1, 0)
check(res1[0] == 2, "3-state DFA with 2 equiv states minimizes to 2")

// TEST 2: already-minimal DFA stays the same size.
// Language: even number of 1s. 2 states: 0 (even, acc), 1 (odd, non-acc).
let trans2 = [[0, 1], [1, 0]]
let acc2 = [1, 0]
let res2 = dm.dfa_minimize(2, 2, trans2, acc2, 0)
check(res2[0] == 2, "even-1s DFA already minimal (2 states)")

// TEST 3: unreachable states are removed.
// State 2 unreachable from start 0.
let trans3 = [[0, 1], [1, 0], [2, 2]]
let acc3 = [1, 0, 1]
let res3 = dm.dfa_minimize(3, 2, trans3, acc3, 0)
check(res3[0] == 2, "unreachable state removed -> 2 states")

// TEST 4: all states equivalent (accept everything) -> collapses to 1
// 3 states, all accepting, all transitions stay within
let trans4 = [[1, 2], [2, 0], [0, 1]]
let acc4 = [1, 1, 1]
let res4 = dm.dfa_minimize(3, 2, trans4, acc4, 0)
check(res4[0] == 1, "accept-all DFA minimizes to 1 state")

// TEST 5: minimized DFA accepts the SAME language (equivalence check)
// minimize trans1 and confirm equivalence with original
let mn = res1[0]
let mt = res1[1]
let ma = res1[2]
let ms = res1[3]
check(dm.dfa_equivalent(3, 2, trans1, acc1, 0, mn, 2, mt, ma, ms), "minimized DFA equivalent to original (test1)")

// minimize trans3 and check equivalence
let mn3 = res3[0]
let mt3 = res3[1]
let ma3 = res3[2]
let ms3 = res3[3]
check(dm.dfa_equivalent(3, 2, trans3, acc3, 0, mn3, 2, mt3, ma3, ms3), "minimized DFA equivalent (test3)")

// TEST 6: two DIFFERENT languages are NOT equivalent
// DFA A: even 1s (accept even). DFA B: odd 1s (accept odd).
let transA = [[0, 1], [1, 0]]
let accA = [1, 0]
let transB = [[0, 1], [1, 0]]
let accB = [0, 1]
check(dm.dfa_equivalent(2, 2, transA, accA, 0, 2, 2, transB, accB, 0) == false, "even-1s != odd-1s")

// TEST 7: DECISIVE - build random small DFAs, minimize, verify:
//   (a) minimal DFA accepts the same language (equivalence bounded test)
//   (b) minimal state count <= original state count
//   (c) minimizing again is idempotent (already minimal)
let ok = true
let seed = 555
let tc = 0
while tc < 25
    seed = (seed * 1103515245 + 12345) % 2147483648
    let n = seed % 5 + 2  // 2..6 states
    let m = 2
    // random transitions
    let trans = []
    let s = 0
    while s < n
        let row = []
        let c = 0
        while c < m
            seed = (seed * 1103515245 + 12345) % 2147483648
            push(row, seed % n)
            c = c + 1
        push(trans, row)
        s = s + 1
    let acc = []
    let a = 0
    while a < n
        seed = (seed * 1103515245 + 12345) % 2147483648
        push(acc, seed % 2)
        a = a + 1
    let res = dm.dfa_minimize(n, m, trans, acc, 0)
    let mn_states = res[0]
    let mtr = res[1]
    let macc = res[2]
    let mst = res[3]
    // (b) fewer or equal
    if mn_states > n
        ok = false
        print("MORE STATES tc=" + str(tc) + " min=" + str(mn_states) + " orig=" + str(n))
    // (a) equivalent
    if dm.dfa_equivalent(n, m, trans, acc, 0, mn_states, m, mtr, macc, mst) == false
        ok = false
        print("NOT EQUIVALENT tc=" + str(tc))
    // (c) idempotent
    let res2b = dm.dfa_minimize(mn_states, m, mtr, macc, mst)
    if res2b[0] != mn_states
        ok = false
        print("NOT IDEMPOTENT tc=" + str(tc) + " first=" + str(mn_states) + " second=" + str(res2b[0]))
    tc = tc + 1
check(ok, "DECISIVE: 25 random DFAs minimize to <=n states, stay language-equivalent, and are idempotent")

print("forge_dfamin: KAT done")
