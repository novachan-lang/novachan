import forge_polymod as pm

fn check(cond: bool, label: string)
    if cond == false
        print("FAIL: " + label)

fn lcg(state: int) -> int
    (state * 1103515245 + 12345) % 2147483648

// build a random polynomial of degree < maxdeg with coeffs in [0,prime)
fn rand_poly(maxlen: int, prime: int, seed: int) -> list
    let out = []
    let s = seed
    let i = 0
    while i < maxlen
        s = lcg(s)
        push(out, s % prime)
        i = i + 1
    out

fn main()
    let P = 97

    // ---- add / mul basic ----
    // (1 + x) + (2 + 3x) = 3 + 4x
    let s = pm.pm_add([1, 1], [2, 3], P)
    check(pm.pm_equal(s, [3, 4], P), "add (1+x)+(2+3x)")
    // (1 + x)(1 + x) = 1 + 2x + x^2
    let m = pm.pm_mul([1, 1], [1, 1], P)
    check(pm.pm_equal(m, [1, 2, 1], P), "(1+x)^2")
    // (1+x)(1-x) = 1 - x^2  -> mod 97: [1, 0, 96]
    let m2 = pm.pm_mul([1, 1], [1, P - 1], P)
    check(pm.pm_equal(m2, [1, 0, P - 1], P), "(1+x)(1-x)")

    // ---- degree ----
    check(pm.pm_degree([0, 0, 5], P) == 2, "degree 2")
    check(pm.pm_degree([0], P) == 0 - 1, "degree of zero == -1")
    check(pm.pm_degree([3, 0, 0], P) == 0, "degree 0 (constant)")

    // ---- eval ----
    // (1 + 2x + 3x^2) at x=2 = 1 + 4 + 12 = 17
    check(pm.pm_eval([1, 2, 3], 2, P) == 17, "eval at 2")

    // ---- divmod: x^2 - 1 divided by x - 1 = x + 1, remainder 0 ----
    let dm = pm.pm_divmod([P - 1, 0, 1], [P - 1, 1], P)   // (x^2 - 1) / (x - 1)
    check(pm.pm_equal(dm[0], [1, 1], P), "div quotient x+1")
    check(pm.pm_degree(dm[1], P) == 0 - 1, "div remainder 0")

    // ---- gcd: gcd(x^2-1, x^2-3x+2) over rationals is (x-1); here mod 97 monic ----
    // x^2 - 1 = [96,0,1] ; x^2 - 3x + 2 = [2, 94, 1]
    let g = pm.pm_gcd([P - 1, 0, 1], [2, P - 3, 1], P)
    check(pm.pm_equal(g, [P - 1, 1], P), "gcd == x - 1 (monic)")

    // ---- BIG self-checks over random polynomials ----
    let st = 555555
    let trial = 0
    while trial < 60
        st = lcg(st)
        let la = 1 + (st % 6)
        st = lcg(st)
        let lb = 1 + (st % 5)
        let a = rand_poly(la, P, st + 1)
        let b = rand_poly(lb, P, st + 999)
        // ensure b is nonzero
        if pm.pm_degree(b, P) < 0
            b = [1]

        // (1) division identity: a == q*b + r  and deg(r) < deg(b)
        let qr = pm.pm_divmod(a, b, P)
        let recomposed = pm.pm_add(pm.pm_mul(qr[0], b, P), qr[1], P)
        check(pm.pm_equal(recomposed, a, P), "trial " + str(trial) + " a==q*b+r")
        check(pm.pm_degree(qr[1], P) < pm.pm_degree(b, P), "trial " + str(trial) + " deg(r)<deg(b)")

        // (2) eval homomorphism: eval(a*b, x) == eval(a,x)*eval(b,x)
        let prod = pm.pm_mul(a, b, P)
        let xv = (st % P)
        let lhs = pm.pm_eval(prod, xv, P)
        let rhs = (pm.pm_eval(a, xv, P) * pm.pm_eval(b, xv, P)) % P
        check(lhs == rhs, "trial " + str(trial) + " eval homomorphism")

        // (3) gcd divides both a and b (remainder zero)
        let gg = pm.pm_gcd(a, b, P)
        let ra = pm.pm_divmod(a, gg, P)
        let rb = pm.pm_divmod(b, gg, P)
        check(pm.pm_degree(ra[1], P) < 0, "trial " + str(trial) + " gcd divides a")
        check(pm.pm_degree(rb[1], P) < 0, "trial " + str(trial) + " gcd divides b")
        trial = trial + 1

    print("forge_polymod: all passed")
