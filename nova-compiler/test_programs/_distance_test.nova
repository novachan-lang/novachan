// KAT for std/text/distance — d_hamming / d_levenshtein / d_lcs_len / d_jaro
import std/text/distance

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckf(label: string, got: float, want: float, eps: float)
    let diff = got - want
    if diff < 0.0
        diff = 0.0 - diff
    if diff > eps
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // ── d_hamming ──────────────────────────────────────────────────────────────
    // "karolin" vs "kathrin": positions 3,4,5 differ (r/t, o/h, l/r) = 3
    cki("hamming-karolin-kathrin", d_hamming("karolin", "kathrin"), 3)
    // identical strings -> 0
    cki("hamming-same", d_hamming("hello", "hello"), 0)
    // every byte differs -> full length
    cki("hamming-all-diff", d_hamming("abc", "xyz"), 3)
    // unequal lengths -> -1
    cki("hamming-unequal", d_hamming("ab", "abc"), -1)

    // ── d_levenshtein ──────────────────────────────────────────────────────────
    // "kitten" -> "sitting": k->s, e->i, append g = 3 changes
    cki("lev-kitten-sitting", d_levenshtein("kitten", "sitting"), 3)
    // empty string to "abc" = 3 insertions
    cki("lev-empty-abc", d_levenshtein("", "abc"), 3)
    // same string = 0
    cki("lev-same", d_levenshtein("nova", "nova"), 0)
    // single insertion: "cat" -> "cart" = 1
    cki("lev-insert", d_levenshtein("cat", "cart"), 1)
    // symmetry: levenshtein is symmetric
    cki("lev-sym", d_levenshtein("abc", ""), 3)

    // ── d_lcs_len ─────────────────────────────────────────────────────────────
    // LCS("ABCBDAB","BDCAB") = 4 (e.g. "BCAB" or "BDAB")
    cki("lcs-ABCBDAB-BDCAB", d_lcs_len("ABCBDAB", "BDCAB"), 4)
    // identical strings -> full length
    cki("lcs-same", d_lcs_len("hello", "hello"), 5)
    // no common characters -> 0
    cki("lcs-disjoint", d_lcs_len("abc", "xyz"), 0)
    // one string empty -> 0
    cki("lcs-empty", d_lcs_len("", "abc"), 0)
    // single shared char
    cki("lcs-one", d_lcs_len("a", "bab"), 1)

    // ── d_jaro ────────────────────────────────────────────────────────────────
    // d_jaro("MARTHA","MARHTA") = 17/18 ≈ 0.94444
    ckf("jaro-MARTHA-MARHTA", d_jaro("MARTHA", "MARHTA"), 0.9444, 0.001)
    // identical -> 1.0
    ckf("jaro-same", d_jaro("hello", "hello"), 1.0, 0.0001)
    // both empty -> 1.0
    ckf("jaro-both-empty", d_jaro("", ""), 1.0, 0.0001)
    // one empty -> 0.0
    ckf("jaro-one-empty", d_jaro("abc", ""), 0.0, 0.0001)
    // completely different short strings -> 0.0
    ckf("jaro-no-match", d_jaro("abc", "xyz"), 0.0, 0.0001)

    print("_distance_test passed")
