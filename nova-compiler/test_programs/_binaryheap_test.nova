import std/collections/binaryheap

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + got + " expected " + expected)
        exit(1)

fn list_eq(a, b)
    if len(a) != len(b)
        return 0
    let i = 0
    while i < len(a)
        if a[i] != b[i]
            return 0
        i = i + 1
    return 1

fn main()
    // KAT 1: push several values and verify peek returns minimum
    let h = bh_new()
    bh_push(h, 5)
    bh_push(h, 2)
    bh_push(h, 8)
    bh_push(h, 1)
    cki("peek_min", bh_peek(h), 1)

    // KAT 2: pop returns minimum and removes it
    let p1 = bh_pop(h)
    cki("pop_first", p1, 1)

    // KAT 3: next pop returns new minimum
    let p2 = bh_pop(h)
    cki("pop_second", p2, 2)

    // KAT 4: size reflects removals (started with 4, popped 2)
    cki("size_after_pops", bh_size(h), 2)

    // KAT 5: heapsort [5,2,8,1,9,3] -> [1,2,3,5,8,9]
    let sorted = bh_sort([5, 2, 8, 1, 9, 3])
    let expected = [1, 2, 3, 5, 8, 9]
    if list_eq(sorted, expected) == 0
        print("FAIL sort_6: got wrong order")
        exit(1)

    // KAT 6: heapsort empty list -> []
    let sorted_empty = bh_sort([])
    cki("sort_empty_len", len(sorted_empty), 0)

    // KAT 7: heapify then pop gives minimum
    let h2 = bh_heapify([4, 1, 7])
    let p3 = bh_pop(h2)
    cki("heapify_pop_min", p3, 1)

    // KAT 8: after heapify pop, next pop gives second smallest
    let p4 = bh_pop(h2)
    cki("heapify_pop_second", p4, 4)

    // KAT 9: empty heap pop returns null
    let h3 = bh_new()
    let pnull = bh_pop(h3)
    if pnull != null
        print("FAIL empty_pop_null: expected null")
        exit(1)

    // KAT 10: size of empty heap
    cki("empty_size", bh_size(h3), 0)

    print("_binaryheap_test passed")
