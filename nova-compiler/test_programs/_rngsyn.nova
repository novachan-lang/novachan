fn main()
    let n = 5
    let xs = [10, 20, 30, 40, 50]
    // compound bound in parens -- what the transformer emits
    let a = []
    for i in 0..(n - 1)
        push(a, i)
    print(a)
    // nested arithmetic
    let b = []
    for i in 0..(len(xs) - 2)
        push(b, i)
    print(b)
    // multiplication
    let c = []
    for i in 0..(2 * 3)
        push(c, i)
    print(c)
    // non-zero start
    let d = []
    for i in 1..n
        push(d, i)
    print(d)
    // compound bound that goes NEGATIVE must run zero times, like the while did
    let e = []
    for i in 0..(0 - 3)
        push(e, i)
    print(e)
    let f = []
    for i in 0..(len([]) - 1)
        push(f, i)
    print(f)
    print("RANGE-SYN-OK")
