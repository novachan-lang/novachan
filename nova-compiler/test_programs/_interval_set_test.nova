import std/interval/interval_set

fn iv_eq(a, b) -> bool
    let na = len(a)
    let nb = len(b)
    if na != nb
        return false
    let i = 0
    while i < na
        let ai = a[i]
        let bi = b[i]
        if ai[0] != bi[0]
            return false
        if ai[1] != bi[1]
            return false
        i = i + 1
    return true

fn ckiv(got, expected, label)
    if not iv_eq(got, expected)
        print("FAIL interval_set " + label + ": mismatch")
        exit(1)

fn ckb(got, expected, label)
    if got != expected
        let gs = "false"
        if got
            gs = "true"
        let es = "false"
        if expected
            es = "true"
        print("FAIL interval_set " + label + ": got=" + gs + " want=" + es)
        exit(1)

fn ckf(got, expected, label)
    let diff = got - expected
    if diff < 0.0
        diff = 0.0 - diff
    if diff > 0.001
        print("FAIL interval_set " + label + ": got=" + str(got) + " want=" + str(expected))
        exit(1)

fn main()
    // --- KAT: is_union ---
    let u1 = interval_set.is_union([[1,3]], [[2,4]])
    ckiv(u1, [[1,4]], "union [[1,3]],[[2,4]]")

    let u2 = interval_set.is_union([[1,2]], [[4,5]])
    ckiv(u2, [[1,2],[4,5]], "union disjoint [[1,2]],[[4,5]]")

    let u3 = interval_set.is_union([], [[1,2]])
    ckiv(u3, [[1,2]], "union [],[[1,2]]")

    // --- KAT: is_intersect ---
    let i1 = interval_set.is_intersect([[1,5]], [[2,3],[4,6]])
    ckiv(i1, [[2,3],[4,5]], "intersect [[1,5]],[[2,3],[4,6]]")

    let i2 = interval_set.is_intersect([[1,2]], [[5,6]])
    ckiv(i2, [], "intersect disjoint [[1,2]],[[5,6]]")

    let i3 = interval_set.is_intersect([[1,5]], [[1,5]])
    ckiv(i3, [[1,5]], "intersect self [[1,5]]")

    let i4 = interval_set.is_intersect([[1,10]], [[2,4],[6,8]])
    ckiv(i4, [[2,4],[6,8]], "intersect [[1,10]] with [[2,4],[6,8]]")

    // --- KAT: is_difference ---
    let d1 = interval_set.is_difference([[1,10]], [[3,5]])
    ckiv(d1, [[1,3],[5,10]], "diff [[1,10]]-[[3,5]]")

    let d2 = interval_set.is_difference([[1,5]], [[1,5]])
    ckiv(d2, [], "diff [[1,5]]-[[1,5]]")

    let d3 = interval_set.is_difference([[1,5]], [[6,8]])
    ckiv(d3, [[1,5]], "diff [[1,5]]-[[6,8]] (no overlap)")

    let d4 = interval_set.is_difference([[1,10]], [[2,4],[6,8]])
    ckiv(d4, [[1,2],[4,6],[8,10]], "diff [[1,10]]-[[2,4],[6,8]]")

    // --- KAT: is_complement ---
    let c1 = interval_set.is_complement([[2,4]], 0, 10)
    ckiv(c1, [[0,2],[4,10]], "complement [[2,4]] in [0,10]")

    let c2 = interval_set.is_complement([], 0, 5)
    ckiv(c2, [[0,5]], "complement [] in [0,5]")

    let c3 = interval_set.is_complement([[0,5]], 0, 5)
    ckiv(c3, [], "complement [[0,5]] in [0,5]")

    // --- KAT: is_contains_point ---
    let cp1 = interval_set.is_contains_point([[1,3],[5,7]], 6)
    ckb(cp1, true, "contains_point 6 in [[1,3],[5,7]]")

    let cp2 = interval_set.is_contains_point([[1,3],[5,7]], 4)
    ckb(cp2, false, "contains_point 4 not in [[1,3],[5,7]]")

    let cp3 = interval_set.is_contains_point([[1,3]], 1)
    ckb(cp3, true, "contains_point 1 (lo endpoint)")

    let cp4 = interval_set.is_contains_point([[1,3]], 3)
    ckb(cp4, true, "contains_point 3 (hi endpoint)")

    let cp5 = interval_set.is_contains_point([], 0)
    ckb(cp5, false, "contains_point in empty set")

    // --- KAT: is_measure ---
    let m1 = interval_set.is_measure([[1,3],[5,8]])
    ckf(m1, 5.0, "measure [[1,3],[5,8]]==5.0")

    let m2 = interval_set.is_measure([[1,3],[2,4]])
    ckf(m2, 3.0, "measure overlapping [[1,3],[2,4]] (merged [1,4])==3.0")

    let m3 = interval_set.is_measure([])
    ckf(m3, 0.0, "measure []==0.0")

    // --- KAT: is_is_empty ---
    ckb(interval_set.is_is_empty([]), true, "is_empty []")
    ckb(interval_set.is_is_empty([[1,3]]), false, "is_empty [[1,3]]")

    // --- KAT: is_normalize ---
    let n1 = interval_set.is_normalize([[3,5],[1,2],[2,4]])
    ckiv(n1, [[1,5]], "normalize [[3,5],[1,2],[2,4]]")

    // --- KAT: is_symmetric_difference ---
    let sd1 = interval_set.is_symmetric_difference([[1,3]], [[2,4]])
    ckiv(sd1, [[1,2],[3,4]], "sym_diff [[1,3]],[[2,4]]")

    let sd2 = interval_set.is_symmetric_difference([[1,5]], [[1,5]])
    ckiv(sd2, [], "sym_diff [[1,5]],[[1,5]]")

    // --- KAT: is_equal ---
    ckb(interval_set.is_equal([[1,3]], [[1,3]]), true, "equal [[1,3]]==[[1,3]]")
    ckb(interval_set.is_equal([[1,3],[2,4]], [[1,4]]), true, "equal overlapping==merged")
    ckb(interval_set.is_equal([[1,3]], [[1,4]]), false, "not equal [[1,3]]!=[[1,4]]")
    ckb(interval_set.is_equal([], []), true, "equal []==[]")

    print("PASS _interval_set_test")

main()
