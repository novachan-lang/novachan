import forge_subarray

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // classic Kadane: [-2,1,-3,4,-1,2,1,-5,4] -> 6 (subarray [4,-1,2,1] at indices 3..6)
    let arr = [0 - 2, 1, 0 - 3, 4, 0 - 1, 2, 1, 0 - 5, 4]
    fails = fails + expect("kadane", str(max_subarray_sum(arr)), "6")
    let ms = max_subarray(arr)
    fails = fails + expect("kadane_idx", str(ms[0]) + "@" + str(ms[1]) + ".." + str(ms[2]), "6@3..6")

    // all negative -> the largest single element
    fails = fails + expect("all_neg", str(max_subarray_sum([0 - 3, 0 - 1, 0 - 2])), "-1")
    // all positive -> whole array
    fails = fails + expect("all_pos", str(max_subarray_sum([1, 2, 3, 4])), "10")
    // single element
    fails = fails + expect("single", str(max_subarray_sum([5])), "5")
    // empty
    fails = fails + expect("empty", str(max_subarray_sum([])), "0")

    // max product: [2,3,-2,4] -> 6 ([2,3])
    fails = fails + expect("prod1", str(max_product_subarray([2, 3, 0 - 2, 4])), "6")
    // two negatives flip: [-2,-3,-4] -> 12 ([-3,-4]... actually -2*-3=6, then *-4=-24; best is -3*-4=12)
    fails = fails + expect("prod_negs", str(max_product_subarray([0 - 2, 0 - 3, 0 - 4])), "12")
    // zero resets: [-2,0,-1] -> 0
    fails = fails + expect("prod_zero", str(max_product_subarray([0 - 2, 0, 0 - 1])), "0")
    // [2,-5,-2,-4,3] -> 24 (-2*-4*3=24 ... let's see: -5,-2,-4 = -40; -2,-4=8; -2*-4*3=24)
    fails = fails + expect("prod_big", str(max_product_subarray([2, 0 - 5, 0 - 2, 0 - 4, 3])), "24")

    // best buy/sell: [7,1,5,3,6,4] -> 5 (buy 1 sell 6)
    fails = fails + expect("buysell", str(best_buy_sell([7, 1, 5, 3, 6, 4])), "5")
    // only falling -> 0
    fails = fails + expect("buysell_fall", str(best_buy_sell([7, 6, 4, 3, 1])), "0")
    // rising -> last-first
    fails = fails + expect("buysell_rise", str(best_buy_sell([1, 2, 3, 4, 5])), "4")

    if fails == 0
        print("forge_subarray: all passed")
    else
        print("forge_subarray: " + str(fails) + " FAILED")
