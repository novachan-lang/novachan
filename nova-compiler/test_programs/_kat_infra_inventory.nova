import forge_infra_inventory

fn main()
    let s = inv_new()
    s = inv_add(s, "i-001", "ec2", "us-east-1")
    s = inv_add(s, "i-002", "ec2", "us-west-2")
    s = inv_add(s, "db-001", "rds", "us-east-1")
    s = inv_add(s, "b-001", "s3", "us-east-1")

    assert(inv_resource_count(s) == 4, "4 resources")

    let t = inv_get_type(s, "i-001")
    assert(is_ok(t), "get type ok")
    assert(unwrap(t) == "ec2", "i-001 is ec2")

    let r = inv_get_region(s, "db-001")
    assert(is_ok(r), "get region ok")
    assert(unwrap(r) == "us-east-1", "db-001 in us-east-1")

    assert(inv_by_type(s, "ec2") == 2, "2 ec2 resources")
    assert(inv_by_type(s, "rds") == 1, "1 rds resource")
    assert(inv_by_region(s, "us-east-1") == 3, "3 resources in us-east-1")
    assert(inv_by_region(s, "us-west-2") == 1, "1 resource in us-west-2")

    assert(inv_has(s, "i-001") == 1, "i-001 exists")
    assert(inv_has(s, "nope") == 0, "nope does not exist")

    let removed = inv_remove(s, "i-002")
    assert(is_ok(removed), "remove ok")
    assert(inv_resource_count(s) == 3, "3 resources after remove")
    assert(inv_has(s, "i-002") == 0, "i-002 gone after remove")
    assert(inv_by_type(s, "ec2") == 1, "1 ec2 resource left")

    assert(is_err(inv_remove(s, "i-002")), "double remove errors")
    assert(is_err(inv_get_type(s, "i-002")), "get removed resource errors")
    assert(is_err(inv_get_type(s, "ghost")), "get unknown resource errors")

    let types = inv_type_list(s)
    assert(contains(types, "ec2") == true, "type list has ec2")
    assert(contains(types, "rds") == true, "type list has rds")
    assert(contains(types, "s3") == true, "type list has s3")

    print("INFRA-INVENTORY KAT PASS")
