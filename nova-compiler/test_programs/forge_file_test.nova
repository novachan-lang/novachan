// forge_file_test -- master plan Phase 1.6: forge.file(path) serves a handler-chosen file as a
// Response (content-type by extension; 404 if missing).
import forge

fn serve_css(req: Request) -> Response
    forge.file("_static_fixture/style.css")

fn serve_missing(req: Request) -> Response
    forge.file("_static_fixture/does_not_exist.css")

fn main()
    let a = forge.app()
    forge.get(a, "/style", serve_css)
    forge.get(a, "/missing", serve_missing)

    let r: Response = forge.dispatch_req(a, forge.build_request("GET /style HTTP/1.1\r\n\r\n", 0))
    assert(r.status == 200, "file -> 200")
    assert(r.headers["Content-Type"] == "text/css; charset=utf-8", "content-type by extension")
    assert(find(r.body, "color") >= 0, "file body served")
    print("PASS: forge.file serves a file")

    let m: Response = forge.dispatch_req(a, forge.build_request("GET /missing HTTP/1.1\r\n\r\n", 0))
    assert(m.status == 404, "missing file -> 404")
    print("PASS: missing file -> 404")
    print("forge_file_test passed")
