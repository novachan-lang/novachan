// KAT: std/data/feed_item
import std/data/feed_item

fn cki(label, got, want)
    if got != want
        print("FAIL feed_item " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL feed_item " + label + ": got=[" + got + "] want=[" + want + "]")
        exit(1)

// ── Test 1: normalize an RSS-style item ─────────────────────────────────────
// Spec: normalize {title:"A",link:"L",pubDate:"D",description:"S"}
//       -> {title:"A",link:"L",date:"D",summary:"S"}
let rss_item = {}
rss_item["title"]       = "A"
rss_item["link"]        = "L"
rss_item["pubDate"]     = "D"
rss_item["description"] = "S"

let norm1 = normalize_item(rss_item)
cks("rss_norm_title",   norm1["title"],   "A")
cks("rss_norm_link",    norm1["link"],    "L")
cks("rss_norm_date",    norm1["date"],    "D")
cks("rss_norm_summary", norm1["summary"], "S")

// ── Test 2: accessors on the RSS item ────────────────────────────────────────
cks("rss_item_title",   item_title(rss_item),   "A")
cks("rss_item_link",    item_link(rss_item),    "L")
cks("rss_item_date",    item_date(rss_item),    "D")
cks("rss_item_summary", item_summary(rss_item), "S")

// ── Test 3: Atom-style item (updated instead of pubDate) ─────────────────────
let atom_item = {}
atom_item["title"]   = "E1"
atom_item["link"]    = "http://x/1"
atom_item["id"]      = "1"
atom_item["updated"] = "2024-01-01"

let norm2 = normalize_item(atom_item)
cks("atom_norm_title",   norm2["title"],   "E1")
cks("atom_norm_link",    norm2["link"],    "http://x/1")
cks("atom_norm_date",    norm2["date"],    "2024-01-01")
cks("atom_norm_summary", norm2["summary"], "")

cks("atom_item_title",   item_title(atom_item),   "E1")
cks("atom_item_link",    item_link(atom_item),    "http://x/1")
cks("atom_item_date",    item_date(atom_item),    "2024-01-01")
cks("atom_item_summary", item_summary(atom_item), "")

// ── Test 4: Atom item with summary field ─────────────────────────────────────
let atom_item2 = {}
atom_item2["title"]   = "T2"
atom_item2["link"]    = "http://x/2"
atom_item2["updated"] = "2024-02-01"
atom_item2["summary"] = "Brief text"

cks("atom_summary",      item_summary(atom_item2), "Brief text")
let norm3 = normalize_item(atom_item2)
cks("atom_norm2_summary", norm3["summary"], "Brief text")

// ── Test 5: item with no date fields -> date returns "" ──────────────────────
let bare_item = {}
bare_item["title"] = "Bare"
bare_item["link"]  = "http://bare"
cks("bare_date",    item_date(bare_item), "")
cks("bare_summary", item_summary(bare_item), "")
let norm4 = normalize_item(bare_item)
cks("bare_norm_date",    norm4["date"],    "")
cks("bare_norm_summary", norm4["summary"], "")

// ── Test 6: pubDate takes priority over updated when both present ─────────────
let both_item = {}
both_item["title"]   = "Both"
both_item["pubDate"] = "rss-date"
both_item["updated"] = "atom-date"
cks("both_date", item_date(both_item), "rss-date")

// ── Test 7: description takes priority over summary when both present ─────────
let both_body = {}
both_body["title"]       = "Body"
both_body["description"] = "rss-body"
both_body["summary"]     = "atom-body"
cks("both_summary", item_summary(both_body), "rss-body")

print("PASS _feed_item_test")
