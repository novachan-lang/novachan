// REGRESSION TEST for a CONFIRMED NOVA defect: an UNESCAPED `{...}` in a string literal swallows
// its entire contents, so two textually-DIFFERENT literals become the SAME value and compare EQUAL.
//
// MEASURED (gen3_test.exe, 2026-09-04):
//   let a = "\{\"total\":19.99\}" written WITHOUT the escapes  ->  a = "total"
//   let b = "\{\"total\":42.00\}" written WITHOUT the escapes  ->  b = "total"
//   a == b  ->  TRUE
//
// This is the same root cause as _interp_undef_test.nova (interpolation bypasses identifier
// resolution) but a far more alarming manifestation: not "yields 0" but SILENT DATA LOSS plus
// FALSE EQUALITY. Every hand-built JSON payload literal in NOVA source is affected, and any
// dedup/comparison/caching logic keyed on such a string will silently treat distinct payloads as
// identical. Found while building prism/app/prism_wire.nova, where it made a
// "resubmitting a different payload is rejected" test pass a mismatch through as a match.
//
// Escaping the braces (`\{` / `\}`) produces the correct string -- asserted below as the control,
// so this test cannot pass vacuously if literals stop working altogether.
fn main()
    let a = "{\"total\":19.99}"
    let b = "{\"total\":42.00}"
    print("a=[{a}]")
    print("b=[{b}]")
    print("a == b  -> {a == b}   (must be false)")
    // Escaped-brace controls: these must be distinct.
    let c = "\{\"total\":19.99\}"
    let d = "\{\"total\":42.00\}"
    print("c=[{c}]")
    print("d=[{d}]")
    print("c == d  -> {c == d}   (must be false)")
    if a == b
        print("FAIL assert: two textually-different brace literals compare EQUAL (both collapsed to '{a}')")
        exit(1)
    if c == d
        print("FAIL assert: escaped-brace control collapsed too -- literals are broken outright")
        exit(1)
    print("ok brace literals stay distinct")
