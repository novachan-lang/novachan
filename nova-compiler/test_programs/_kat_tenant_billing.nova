import forge_tenant_billing

fn main()
    let b = bill_new()
    b = bill_create_tenant(b, "t1", "pro", 1000)
    b = bill_create_tenant(b, "t2", "basic", 500)

    b = bill_record_usage(b, "t1", 300)
    b = bill_record_usage(b, "t1", 200)
    assert(bill_get_usage(b, "t1") == 500, "t1 usage=500")
    assert(bill_is_over_limit(b, "t1") == false, "t1 under limit")
    assert(bill_overage(b, "t1") == 0, "t1 no overage")

    b = bill_record_usage(b, "t2", 600)
    assert(bill_is_over_limit(b, "t2") == true, "t2 over limit")
    assert(bill_overage(b, "t2") == 100, "t2 overage=100")

    b = bill_generate_invoice(b, "t1", "2026-07", 50)
    assert(bill_invoice_count(b) == 1, "1 invoice")
    let inv1 = bill_last_invoice(b)
    assert(inv1["total"] == 50, "t1 total=50 (no overage)")

    b = bill_generate_invoice(b, "t2", "2026-07", 30)
    let inv2 = bill_last_invoice(b)
    assert(inv2["total"] == 130, "t2 total=130 (30+100 overage)")
    assert(inv2["overage_cost"] == 100, "t2 overage cost")

    b = bill_reset_usage(b, "t1")
    assert(bill_get_usage(b, "t1") == 0, "t1 reset")

    assert(bill_invoice_count(b) == 2, "2 invoices")

    print("TENANT-BILLING KAT PASS")
