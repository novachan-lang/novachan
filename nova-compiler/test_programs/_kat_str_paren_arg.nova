// Regression: a string literal whose value is exactly ")" (or "(") passed as a CALL ARGUMENT
// must parse. The arg-list loop used to terminate on any token VALUED ")" (including a STR token),
// so print(")") parsed as an empty call and orphaned the real ')' -> bogus "inconsistent
// indentation". Fixed: the loop terminates only on a real DELIM ')'.
fn use_it(s: string) -> string
    s

fn main() -> int
    let ok = true
    let a = use_it(")")
    if a != ")"
        print("  FAIL lone-rparen arg got " + a)
        ok = false
    let b = use_it("(")
    if b != "("
        print("  FAIL lone-lparen arg")
        ok = false
    let c = use_it("x")
    if c != "x"
        print("  FAIL normal arg")
        ok = false
    let d = use_it("a)b(c")
    if d != "a)b(c"
        print("  FAIL mixed-paren arg")
        ok = false
    print(")")
    print("(")
    if ok
        print("STR-PAREN-ARG KAT PASS")
        return 0
    print("STR-PAREN-ARG KAT FAIL")
    1
