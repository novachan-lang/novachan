fn safe_div(a: int, b: int)
    if b == 0
        return err("division by zero")
    ok(a / b)

fn main()
    with x <- safe_div(100, 5), y <- safe_div(x, 2)
        assert_eq(y, 10)
    else e
        assert_eq(false, true)

    let failed = false
    with a <- safe_div(10, 2), b <- safe_div(a, 0)
        assert_eq(false, true)
    else e
        failed = true
    assert_eq(failed, true)

    print("with_probe: all passed")
