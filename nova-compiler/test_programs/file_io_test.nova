// File I/O completeness test — exercises every new filesystem builtin with
// real round-trips and assertions. Cleans up everything it creates.

fn main()
    let base = "_fio_test_dir"
    // Fresh start: make a working directory.
    mkdir_p(base)
    assert_eq(is_dir(base), true)
    assert_eq(is_file(base), false)

    // write_file + is_file + file_size
    let f1 = path_join(base, "a.txt")
    write_file(f1, "hello world")
    assert_eq(is_file(f1), true)
    assert_eq(is_dir(f1), false)
    assert_eq(file_size(f1), 11)
    assert_eq(read_file(f1), "hello world")

    // file_mtime is a positive unix timestamp for an existing file, -1 for absent
    let mt = file_mtime(f1)
    assert_eq(mt > 0, true)
    assert_eq(file_mtime(path_join(base, "does_not_exist.txt")), -1)
    assert_eq(file_size(path_join(base, "does_not_exist.txt")), -1)

    // copy_file → identical contents, both exist
    let f2 = path_join(base, "b.txt")
    assert_eq(copy_file(f1, f2), 1)
    assert_eq(is_file(f2), true)
    assert_eq(read_file(f2), "hello world")
    assert_eq(file_size(f2), 11)

    // rename_path → old gone, new present with same contents
    let f3 = path_join(base, "c.txt")
    assert_eq(rename_path(f2, f3), 1)
    assert_eq(is_file(f2), false)
    assert_eq(is_file(f3), true)
    assert_eq(read_file(f3), "hello world")

    // write_bytes / read_bytes round-trip (binary-safe, includes a NUL byte)
    let f4 = path_join(base, "data.bin")
    let buf = str_to_bytes("AB")
    assert_eq(write_bytes(f4, buf), 0)
    let rb = read_bytes(f4)
    assert_eq(bytes_len(rb), 2)
    assert_eq(bytes_get(rb, 0), 65)
    assert_eq(bytes_get(rb, 1), 66)

    // read_lines — split on \n, strip trailing \r, no empty trailing element
    let f5 = path_join(base, "lines.txt")
    write_file(f5, "alpha\nbeta\ngamma\n")
    let lines = read_lines(f5)
    assert_eq(len(lines), 3)
    assert_eq(lines[0], "alpha")
    assert_eq(lines[1], "beta")
    assert_eq(lines[2], "gamma")

    // read_lines on a file with no trailing newline
    write_file(f5, "one\ntwo")
    let l2 = read_lines(f5)
    assert_eq(len(l2), 2)
    assert_eq(l2[0], "one")
    assert_eq(l2[1], "two")

    // temp_dir returns a non-empty path
    let td = temp_dir()
    assert_eq(len(td) > 0, true)

    // remove_file → file gone
    assert_eq(remove_file(f1), 1)
    assert_eq(is_file(f1), false)
    remove_file(f3)
    remove_file(f4)
    remove_file(f5)

    // remove_dir → empty directory gone
    assert_eq(remove_dir(base), 1)
    assert_eq(is_dir(base), false)

    print("file_io_test passed")
