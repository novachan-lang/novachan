// _cc_test.nova — KAT for std/midi/cc
//
// Known-answer tests for MIDI CC number/name mapping and 14-bit CC helpers.
//
// HAND-VERIFIED VECTORS:
//   cc_name(1)  == "Modulation"          (standard CC 1)
//   cc_name(7)  == "Volume"              (standard CC 7)
//   cc_name(10) == "Pan"                 (standard CC 10)
//   cc_name(64) == "Sustain"             (standard CC 64)
//   cc_name(200) == "Undefined"          (out-of-range/unknown)
//   cc_number("Pan")    == 10
//   cc_number("Volume") == 7
//   cc_number("Unknown") == -1
//
//   cc14_split(0x2000) == [64, 0]
//     0x2000 = 8192; msb=(8192>>7)&0x7F=64; lsb=8192&0x7F=0
//
//   cc14_combine(64, 0) == 0x2000 (= 8192)
//     (64<<7)|0 = 8192
//
//   cc_is_switch(64) == true   (Sustain pedal — range 64..69)
//   cc_is_switch(69) == true   (Hold 2       — upper boundary)
//   cc_is_switch(7)  == false  (Volume — not a switch)
//   cc_is_switch(63) == false  (just below switch range)
//   cc_is_switch(70) == false  (just above switch range)

import std/midi/cc

// ── helpers ───────────────────────────────────────────────────────────────────

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL cc " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL cc " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL cc " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn main()
    // ── KAT 1: cc_name — named CCs ───────────────────────────────────────────
    cks("cc_name(1)",   cc_name(1),   "Modulation")
    cks("cc_name(7)",   cc_name(7),   "Volume")
    cks("cc_name(10)",  cc_name(10),  "Pan")
    cks("cc_name(11)",  cc_name(11),  "Expression")
    cks("cc_name(64)",  cc_name(64),  "Sustain")
    cks("cc_name(71)",  cc_name(71),  "Resonance")
    cks("cc_name(74)",  cc_name(74),  "Cutoff")
    cks("cc_name(91)",  cc_name(91),  "Reverb")
    cks("cc_name(93)",  cc_name(93),  "Chorus")
    cks("cc_name(120)", cc_name(120), "AllSoundOff")
    cks("cc_name(121)", cc_name(121), "ResetAllControllers")
    cks("cc_name(123)", cc_name(123), "AllNotesOff")

    // ── KAT 2: cc_name — undefined/out-of-range ───────────────────────────────
    cks("cc_name(200)",  cc_name(200),  "Undefined")
    cks("cc_name(3)",    cc_name(3),    "Undefined")
    cks("cc_name(9)",    cc_name(9),    "Undefined")
    cks("cc_name(0)",    cc_name(0),    "Bank Select MSB")
    cks("cc_name(127)",  cc_name(127),  "Poly On")

    // ── KAT 3: cc_number — forward round-trip ────────────────────────────────
    cki("cc_number(Pan)",    cc_number("Pan"),    10)
    cki("cc_number(Volume)", cc_number("Volume"), 7)
    cki("cc_number(Sustain)", cc_number("Sustain"), 64)
    cki("cc_number(Modulation)", cc_number("Modulation"), 1)
    cki("cc_number(Chorus)", cc_number("Chorus"), 93)
    cki("cc_number(Reverb)", cc_number("Reverb"), 91)
    cki("cc_number(Resonance)", cc_number("Resonance"), 71)
    cki("cc_number(Cutoff)", cc_number("Cutoff"), 74)
    cki("cc_number(AllSoundOff)", cc_number("AllSoundOff"), 120)
    cki("cc_number(ResetAllControllers)", cc_number("ResetAllControllers"), 121)
    cki("cc_number(AllNotesOff)", cc_number("AllNotesOff"), 123)

    // ── KAT 4: cc_number — not-found cases ───────────────────────────────────
    cki("cc_number(Unknown)",    cc_number("Unknown"),    -1)
    cki("cc_number(empty)",      cc_number(""),           -1)
    cki("cc_number(modulation)", cc_number("modulation"), -1)

    // ── KAT 5: cc14_split — known vectors ────────────────────────────────────
    // 0x2000 = 8192: msb=64, lsb=0
    let s1 = cc14_split(0x2000)
    cki("cc14_split(0x2000)[0]", s1[0], 64)
    cki("cc14_split(0x2000)[1]", s1[1], 0)

    // 0x0000 = 0: msb=0, lsb=0
    let s2 = cc14_split(0)
    cki("cc14_split(0)[0]", s2[0], 0)
    cki("cc14_split(0)[1]", s2[1], 0)

    // 0x3FFF = 16383 (max 14-bit): msb=127, lsb=127
    let s3 = cc14_split(0x3FFF)
    cki("cc14_split(0x3FFF)[0]", s3[0], 127)
    cki("cc14_split(0x3FFF)[1]", s3[1], 127)

    // 0x007F = 127: msb=0, lsb=127
    let s4 = cc14_split(127)
    cki("cc14_split(127)[0]", s4[0], 0)
    cki("cc14_split(127)[1]", s4[1], 127)

    // 0x0100 = 256: msb=2, lsb=0
    let s5 = cc14_split(256)
    cki("cc14_split(256)[0]", s5[0], 2)
    cki("cc14_split(256)[1]", s5[1], 0)

    // ── KAT 6: cc14_combine — known vectors ───────────────────────────────────
    cki("cc14_combine(64,0)",   cc14_combine(64, 0),   0x2000)
    cki("cc14_combine(0,0)",    cc14_combine(0, 0),    0)
    cki("cc14_combine(127,127)",cc14_combine(127, 127),0x3FFF)
    cki("cc14_combine(0,127)",  cc14_combine(0, 127),  127)
    cki("cc14_combine(2,0)",    cc14_combine(2, 0),    256)

    // ── KAT 7: round-trip split/combine ───────────────────────────────────────
    let vals = [0, 1, 64, 127, 128, 255, 1000, 8192, 16383]
    let vi = 0
    for v in vals
        let spl = cc14_split(v)
        let rt = cc14_combine(spl[0], spl[1])
        if rt != v
            print("FAIL cc round-trip v=" + str(v) + ": got=" + str(rt))
            exit(1)
        vi = vi + 1

    // ── KAT 8: cc_is_switch — switch range 64..69 ────────────────────────────
    ckb("cc_is_switch(64)", cc_is_switch(64), true)
    ckb("cc_is_switch(65)", cc_is_switch(65), true)
    ckb("cc_is_switch(66)", cc_is_switch(66), true)
    ckb("cc_is_switch(67)", cc_is_switch(67), true)
    ckb("cc_is_switch(68)", cc_is_switch(68), true)
    ckb("cc_is_switch(69)", cc_is_switch(69), true)

    // ── KAT 9: cc_is_switch — non-switch CCs ─────────────────────────────────
    ckb("cc_is_switch(7)",  cc_is_switch(7),  false)
    ckb("cc_is_switch(63)", cc_is_switch(63), false)
    ckb("cc_is_switch(70)", cc_is_switch(70), false)
    ckb("cc_is_switch(0)",  cc_is_switch(0),  false)
    ckb("cc_is_switch(127)",cc_is_switch(127),false)

    print("PASS _cc_test")
