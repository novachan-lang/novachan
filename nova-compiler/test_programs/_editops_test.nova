// KAT for std/text/editops — eo_distance / eo_ops / eo_apply
import std/text/editops

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got [" + got + "] want [" + want + "]")
        exit(1)

fn main()
    // ── KAT 1: distance "kitten" -> "sitting" = 3 ────────────────────────────
    cki("dist-kitten-sitting", eo_distance("kitten", "sitting"), 3)

    // ── KAT 2: apply ops "kitten" -> "sitting" reconstructs "sitting" ─────────
    let ops1 = eo_ops("kitten", "sitting")
    let r1 = eo_apply("kitten", ops1)
    cks("apply-kitten-sitting", r1, "sitting")

    // ── KAT 3: distance "abc" -> "abc" = 0 (identical) ───────────────────────
    cki("dist-abc-abc", eo_distance("abc", "abc"), 0)

    // ── KAT 4: apply ops "abc" -> "abd" reconstructs "abd" ───────────────────
    let ops2 = eo_ops("abc", "abd")
    let r2 = eo_apply("abc", ops2)
    cks("apply-abc-abd", r2, "abd")

    // ── KAT 5: distance "" -> "abc" = 3 (three insertions) ───────────────────
    cki("dist-empty-abc", eo_distance("", "abc"), 3)

    // ── KAT 6: apply ops "" -> "abc" reconstructs "abc" ──────────────────────
    let ops3 = eo_ops("", "abc")
    let r3 = eo_apply("", ops3)
    cks("apply-empty-abc", r3, "abc")

    // ── KAT 7: distance "flaw" -> "lawn" = 2 ─────────────────────────────────
    cki("dist-flaw-lawn", eo_distance("flaw", "lawn"), 2)

    // ── KAT 8: apply ops "flaw" -> "lawn" reconstructs "lawn" ────────────────
    let ops4 = eo_ops("flaw", "lawn")
    let r4 = eo_apply("flaw", ops4)
    cks("apply-flaw-lawn", r4, "lawn")

    // ── KAT 9: delete all — "abc" -> "" = 3 ──────────────────────────────────
    cki("dist-abc-empty", eo_distance("abc", ""), 3)
    let ops5 = eo_ops("abc", "")
    let r5 = eo_apply("abc", ops5)
    cks("apply-abc-empty", r5, "")

    // ── KAT 10: single char sub "a" -> "b" = 1 ───────────────────────────────
    cki("dist-a-b", eo_distance("a", "b"), 1)
    let ops6 = eo_ops("a", "b")
    let r6 = eo_apply("a", ops6)
    cks("apply-a-b", r6, "b")

    print("_editops_test passed")
