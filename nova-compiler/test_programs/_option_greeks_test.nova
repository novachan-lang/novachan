// KAT for std/finance/option_greeks — Black-Scholes option Greeks.
// Reference: standard BS Greeks formulas with known-answer checks.
import std/finance/option_greeks

fn approx(a: float, b: float, tol: float) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < tol
        return 1
    return 0

fn check(label: string, got: float, want: float, tol: float)
    let ok = approx(got, want, tol)
    if ok == 0
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ATM parameters: S=100, K=100, T=1, r=0.05, sigma=0.2
    // d1 = (0 + (0.05+0.02)*1)/(0.2*1) = 0.07/0.2 = 0.35
    // d2 = 0.35 - 0.2 = 0.15
    // N(d1) ~ 0.6368, N(d2) ~ 0.5596

    // KAT 1: delta_call ATM — should be around 0.5..0.65
    let dc1 = delta_call(100.0, 100.0, 1.0, 0.05, 0.2)
    check("delta_call_atm_range", dc1, 0.6368, 0.02)

    // KAT 2: delta_call deep ITM (S=150, K=100) — should be close to 1.0
    let dc2 = delta_call(150.0, 100.0, 1.0, 0.05, 0.2)
    let ok2 = approx(dc2, 1.0, 0.08)
    if ok2 == 0
        print("FAIL delta_call_deep_itm: got=" + str(dc2) + " (expected ~1)")
        exit(1)

    // KAT 3: delta_call deep OTM (S=50, K=100) — should be close to 0
    let dc3 = delta_call(50.0, 100.0, 1.0, 0.05, 0.2)
    let ok3 = approx(dc3, 0.0, 0.08)
    if ok3 == 0
        print("FAIL delta_call_deep_otm: got=" + str(dc3) + " (expected ~0)")
        exit(1)

    // KAT 4: delta_put ATM — should be around -0.37 (= N(d1)-1)
    let dp1 = delta_put(100.0, 100.0, 1.0, 0.05, 0.2)
    check("delta_put_atm", dp1, 0.0 - 0.3632, 0.02)

    // KAT 5: delta_call + |delta_put| ~ 1 (put-call delta parity)
    let sum = dc1 + (0.0 - dp1)
    check("delta_parity", sum, 1.0, 0.001)

    // KAT 6: gamma > 0 (always positive for both calls and puts)
    let g1 = gamma(100.0, 100.0, 1.0, 0.05, 0.2)
    if g1 < 0.0
        print("FAIL gamma_positive: got=" + str(g1))
        exit(1)
    // ATM gamma for these params ~ 0.0188
    check("gamma_atm", g1, 0.0188, 0.005)

    // KAT 7: gamma is highest near ATM
    let g_itm = gamma(130.0, 100.0, 1.0, 0.05, 0.2)
    if g1 < g_itm
        print("FAIL gamma_atm_highest_vs_itm: atm=" + str(g1) + " itm=" + str(g_itm))
        exit(1)

    // KAT 8: vega > 0 (always positive — higher vol = higher option price)
    let v1 = vega(100.0, 100.0, 1.0, 0.05, 0.2)
    if v1 < 0.0
        print("FAIL vega_positive: got=" + str(v1))
        exit(1)
    // ATM vega ~ 37.52 (S*phi(d1)*sqrt(T) = 100*0.3752*1)
    check("vega_atm", v1, 37.52, 1.0)

    // KAT 9: theta_call < 0 (time decay costs the holder)
    let th1 = theta_call(100.0, 100.0, 1.0, 0.05, 0.2)
    if th1 > 0.0
        print("FAIL theta_negative: got=" + str(th1))
        exit(1)

    // KAT 10: rho_call > 0 (higher rates benefit call holders)
    let rh1 = rho_call(100.0, 100.0, 1.0, 0.05, 0.2)
    if rh1 < 0.0
        print("FAIL rho_positive: got=" + str(rh1))
        exit(1)

    // KAT 11: vega increases with time to expiry (longer options more sensitive to vol)
    let v_short = vega(100.0, 100.0, 0.25, 0.05, 0.2)
    let v_long = vega(100.0, 100.0, 2.0, 0.05, 0.2)
    if v_long < v_short
        print("FAIL vega_time: longer expiry should have higher vega")
        exit(1)

    print("PASS _option_greeks_test")
