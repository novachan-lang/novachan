import forge_response_transformer

fn main()
    let r = rt_new()
    assert(rt_transform_count(r) == 0, "no transforms")

    r = rt_add_header(r, "X-Frame-Options", "DENY")
    r = rt_add_header(r, "X-Content-Type", "nosniff")
    assert(rt_transform_count(r) == 2, "2 transforms")

    let res = rt_apply(r, "hello world")
    r = res["r"]
    assert(res["body"] == "hello world", "body unchanged")
    assert(res["header_count"] == 2, "2 headers added")
    assert(rt_total_applied(r) == 2, "2 applied")

    let res2 = rt_apply(r, "another")
    r = res2["r"]
    assert(rt_total_applied(r) == 4, "4 total applied")

    print("RESPONSE-TRANSFORMER KAT PASS")
