import forge_domain_validator

fn main()
    let d = dv_new()

    let r1 = dv_validate(d, "example.com")
    assert(is_ok(r1), "valid domain")

    let r2 = dv_validate(d, "")
    assert(is_err(r2), "empty domain")

    let r3 = dv_validate(d, ".example.com")
    assert(is_err(r3), "starts with dot")

    let r4 = dv_validate(d, "-example.com")
    assert(is_err(r4), "starts with hyphen")

    let r5 = dv_validate(d, "localhost")
    assert(is_err(r5), "no dots")

    let r6 = dv_validate(d, "sub.domain.example.com")
    assert(is_ok(r6), "multi-level ok")

    assert(dv_total_validations(d) == 6, "6 validations")
    assert(dv_pass_count(d) == 2, "2 passes")
    assert(dv_fail_count(d) == 4, "4 failures")

    print("DOMAIN-VALIDATOR KAT PASS")
