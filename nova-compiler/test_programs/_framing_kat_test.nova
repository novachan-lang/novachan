import std/framing/bytestuff
import std/framing/cobs
import std/framing/crc_frame
import std/framing/delimiter
import std/framing/escaping
import std/framing/hdlc
import std/framing/kiss
import std/framing/lenprefix
import std/framing/ppp_frame
import std/framing/reassembly
import std/framing/slip
import std/framing/stxetx

fn assert_eq(label: string, got: any, want: any)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
    else
        print("ok " + label)

fn list_eq(a: list, b: list) -> bool
    if len(a) != len(b)
        return false
    for i in 0..len(a)
        if a[i] != b[i]
            return false
    true

fn main()
    // bytestuff
    let data = [1, 126, 2, 125, 3]
    let stuffed = bs_stuff(data, 126, 125)
    let unstuffed = bs_unstuff(stuffed, 125)
    assert_eq("bytestuff roundtrip", list_eq(unstuffed, data), true)
    assert_eq("bytestuff count_specials", bs_count_specials([1, 126, 2, 126, 3], [126]), 2)
    assert_eq("bytestuff overhead", bs_overhead([1, 126, 2, 126, 3], [126]), 2)
    let stuffed_set = bs_stuff_set(data, [126, 2], 125)
    let unstuffed_set = bs_unstuff_set(stuffed_set, 125)
    assert_eq("bytestuff_set roundtrip", list_eq(unstuffed_set, data), true)

    // cobs — canonical vectors
    assert_eq("cobs empty", list_eq(cobs_encode([]), [1]), true)
    assert_eq("cobs single zero", list_eq(cobs_encode([0]), [1, 1]), true)
    let cobs_v = cobs_encode([0x11, 0x22, 0x00, 0x33])
    assert_eq("cobs vector", list_eq(cobs_v, [3, 0x11, 0x22, 2, 0x33]), true)
    let cobs_rt = cobs_decode(cobs_v)
    assert_eq("cobs roundtrip", list_eq(cobs_rt, [0x11, 0x22, 0x00, 0x33]), true)

    // crc_frame — "123456789" check values
    let ascii = [0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37, 0x38, 0x39]
    assert_eq("crc16 check", cf_crc16(ascii), 0x29B1)
    assert_eq("crc32 check", cf_crc32(ascii), 0xCBF43926)
    let f16 = cf_frame16(ascii)
    assert_eq("crc16 verify", cf_verify16(f16), 1)
    let f32 = cf_frame32(ascii)
    assert_eq("crc32 verify", cf_verify32(f32), 1)
    let de16 = cf_deframe16(f16)
    assert_eq("crc16 deframe data", list_eq(de16["data"], ascii), true)
    assert_eq("crc16 deframe ok", de16["crc_ok"], 1)

    // delimiter
    let stream = [104, 105, 10, 98, 121, 101, 10]
    let frames = delim_frames(stream, 10)
    assert_eq("delim frames count", len(frames), 2)
    assert_eq("delim frame0", list_eq(frames[0], [104, 105]), true)
    let ff = delim_first_frame(stream, 10)
    assert_eq("delim first_frame", list_eq(ff["frame"], [104, 105]), true)
    assert_eq("delim count", delim_count(stream, 10), 2)
    let cr_stripped = delim_strip_cr([104, 105, 13])
    assert_eq("delim strip_cr", list_eq(cr_stripped, [104, 105]), true)
    let cr_empty = delim_strip_cr([])
    assert_eq("delim strip_cr empty", list_eq(cr_empty, []), true)

    // escaping
    let esc_data = [1, 27, 2, 3]
    let esc_out = esc_simple(esc_data, 27, [3])
    let esc_back = esc_unsimple(esc_out, 27)
    assert_eq("esc_simple roundtrip", list_eq(esc_back, esc_data), true)
    assert_eq("esc_needs_escaping true", esc_needs_escaping(3, [3, 4]), true)
    assert_eq("esc_needs_escaping false", esc_needs_escaping(9, [3, 4]), false)
    assert_eq("esc_count", esc_count([3, 5, 4, 9], [3, 4]), 2)
    assert_eq("esc_c_style", esc_c_style(chr(10) + "a" + chr(9)), chr(92) + "n" + "a" + chr(92) + "t")
    assert_eq("esc_hex_dump_escape", esc_hex_dump_escape([65, 1]), "A\\x01")

    // hdlc
    let hframe = hdlc_frame([1, 0x7E, 2, 0x7D, 3])
    let hback = hdlc_deframe(hframe)
    assert_eq("hdlc roundtrip", list_eq(hback, [1, 0x7E, 2, 0x7D, 3]), true)
    assert_eq("hdlc is_flag true", hdlc_is_flag(0x7E), 1)
    assert_eq("hdlc is_flag false", hdlc_is_flag(5), 0)

    // kiss
    let kframe = kiss_frame(3, 0, [1, 0xC0, 2, 0xDB, 3])
    let kback = kiss_deframe(kframe)
    assert_eq("kiss port", kback["port"], 3)
    assert_eq("kiss cmd", kback["cmd"], 0)
    assert_eq("kiss data roundtrip", list_eq(kback["data"], [1, 0xC0, 2, 0xDB, 3]), true)

    // lenprefix
    let lp8 = lp_frame_u8([9, 9, 9])
    let de8 = lp_deframe_u8(lp8, 0)
    assert_eq("lp_u8 roundtrip", list_eq(de8["data"], [9, 9, 9]), true)
    let lp16 = lp_frame_u16be([5, 6, 7])
    let de16b = lp_deframe_u16be(lp16, 0)
    assert_eq("lp_u16be roundtrip", list_eq(de16b["data"], [5, 6, 7]), true)
    let lp32 = lp_frame_u32be([8])
    let de32 = lp_deframe_u32be(lp32, 0)
    assert_eq("lp_u32be roundtrip", list_eq(de32["data"], [8]), true)

    // ppp_frame
    let pframe = ppp_frame([1, 0x7E, 2, 0x7D, 3])
    let pback = ppp_deframe(pframe)
    assert_eq("ppp roundtrip data", list_eq(pback["data"], [1, 0x7E, 2, 0x7D, 3]), true)
    assert_eq("ppp fcs_ok", pback["fcs_ok"], 1)

    // reassembly
    let rst = reasm_new_delim(10)
    let out1 = reasm_feed_delim(rst, [104, 105, 10, 98])
    assert_eq("reasm delim frame1", len(out1), 1)
    assert_eq("reasm delim frame1 data", list_eq(out1[0], [104, 105]), true)
    let out2 = reasm_feed_delim(rst, [121, 101, 10])
    assert_eq("reasm delim frame2 data", list_eq(out2[0], [98, 121, 101]), true)

    let lst = reasm_new_lenprefix()
    let lp_stream = lp_frame_u16be([1, 2, 3])
    let lout = reasm_feed_lenprefix(lst, lp_stream)
    assert_eq("reasm lenprefix frame", list_eq(lout[0], [1, 2, 3]), true)

    // slip
    let sframe = slip_frame([1, 0xC0, 2, 0xDB, 3])
    let sback = slip_deframe(sframe)
    assert_eq("slip roundtrip", list_eq(sback, [1, 0xC0, 2, 0xDB, 3]), true)

    // stxetx
    let xframe = sx_frame([1, 2, 3])
    let xback = sx_deframe(xframe)
    assert_eq("stxetx roundtrip", list_eq(xback, [1, 2, 3]), true)
    let xlrc = sx_frame_lrc([1, 2, 3])
    let xlrcback = sx_deframe_lrc(xlrc)
    assert_eq("stxetx lrc data", list_eq(xlrcback["data"], [1, 2, 3]), true)
    assert_eq("stxetx lrc ok", xlrcback["lrc_ok"], true)
    let xdle = sx_frame_dle([1, 5, 2, 3])
    let xdleback = sx_deframe_dle(xdle)
    assert_eq("stxetx dle ok", xdleback["ok"], true)
    assert_eq("stxetx dle data roundtrip", list_eq(xdleback["data"], [1, 5, 2, 3]), true)
    assert_eq("stxetx is_framed true", sx_is_framed(xframe), true)
    assert_eq("stxetx is_framed false", sx_is_framed([1, 2, 3]), false)

    print("_framing_kat_test passed")
