import forge_time_series

fn main()
    let t = ts_new()
    t = ts_add(t, 100, 10)
    t = ts_add(t, 200, 20)
    t = ts_add(t, 300, 30)
    t = ts_add(t, 400, 15)
    assert(ts_count(t) == 4, "4 points")

    let v = ts_get(t, 1)
    assert(is_ok(v), "get ok")
    assert(unwrap(v) == 20, "idx 1 = 20")

    let bad = ts_get(t, 99)
    assert(is_err(bad), "out of range is err")

    assert(ts_range_sum(t, 200, 400) == 65, "sum 200..400 = 65")
    assert(ts_range_count(t, 200, 300) == 2, "count 200..300 = 2")

    let latest = ts_latest(t)
    assert(unwrap(latest) == 15, "latest=15")

    let mn = ts_min(t)
    assert(unwrap(mn) == 10, "min=10")

    let mx = ts_max(t)
    assert(unwrap(mx) == 30, "max=30")

    let empty = ts_new()
    let no_data = ts_latest(empty)
    assert(is_err(no_data), "empty is err")

    print("TIME-SERIES KAT PASS")
