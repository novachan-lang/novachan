import std/quantum/quantum_state
import std/quantum/quantum_circuit

// cki — integer known-answer check.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _quantum_circuit_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // Bell state: h(0), cnot(0,1) on |00> -> (|00>+|11>)/sqrt(2).
    let c = qcr_new()
    qcr_h(c, 0)
    qcr_cnot(c, 0, 1)
    let s = qcr_run(c, 2)
    cki("bell prob0", qst_prob_x1000(s, 0), 500)
    cki("bell prob1", qst_prob_x1000(s, 1), 0)
    cki("bell prob2", qst_prob_x1000(s, 2), 0)
    cki("bell prob3", qst_prob_x1000(s, 3), 500)

    // gate_count for the Bell circuit == 2.
    cki("bell gate_count", qcr_gate_count(c), 2)

    // depth: Bell circuit (h(0) then cnot(0,1), sequential dependency) == 2.
    cki("bell depth", qcr_depth(c), 2)

    // H*H identity: two Hadamards on the same qubit cancel out.
    let c2 = qcr_new()
    qcr_h(c2, 0)
    qcr_h(c2, 0)
    let s2 = qcr_run(c2, 1)
    cki("hh prob0", qst_prob_x1000(s2, 0), 1000)

    // GHZ state: h(0), cnot(0,1), cnot(1,2) on |000> -> (|000>+|111>)/sqrt(2).
    let c3 = qcr_new()
    qcr_h(c3, 0)
    qcr_cnot(c3, 0, 1)
    qcr_cnot(c3, 1, 2)
    let s3 = qcr_run(c3, 3)
    cki("ghz prob0", qst_prob_x1000(s3, 0), 500)
    cki("ghz prob7", qst_prob_x1000(s3, 7), 500)

    // depth: two parallel H's on different qubits -> depth 1 (independent).
    let c4 = qcr_new()
    qcr_h(c4, 0)
    qcr_h(c4, 1)
    cki("parallel h depth", qcr_depth(c4), 1)

    // depth: empty circuit -> 0.
    let c5 = qcr_new()
    cki("empty depth", qcr_depth(c5), 0)

    // qcr_run_from directly on a pre-built state: apply cnot to |10> -> |11>.
    let c6 = qcr_new()
    qcr_cnot(c6, 0, 1)
    let s6 = qcr_run_from(c6, qst_basis(2, 2))
    cki("run_from cnot prob3", qst_prob_x1000(s6, 3), 1000)

    // qcr_toffoli, qcr_cz, qcr_swap, qcr_x, qcr_y, qcr_z, qcr_s, qcr_t all
    // wire through qcr_run_from correctly (sanity smoke, not full re-derivation
    // since qg1/qg2 already have their own KATs).
    let c7 = qcr_new()
    qcr_x(c7, 0)
    qcr_x(c7, 1)
    qcr_toffoli(c7, 0, 1, 2)
    let s7 = qcr_run(c7, 3)
    cki("toffoli via circuit prob7", qst_prob_x1000(s7, 7), 1000)

    let c8 = qcr_new()
    qcr_x(c8, 0)
    qcr_x(c8, 1)
    qcr_cz(c8, 0, 1)
    let s8 = qcr_run(c8, 2)
    cki("cz via circuit prob3", qst_prob_x1000(s8, 3), 1000)

    let c9 = qcr_new()
    qcr_x(c9, 0)
    qcr_swap(c9, 0, 1)
    let s9 = qcr_run(c9, 2)
    cki("swap via circuit prob1", qst_prob_x1000(s9, 1), 1000)

    // qcr_qubits_of exposes 1/2/3-qubit ops correctly.
    let op1 = []
    push(op1, "h")
    push(op1, 5)
    cki("qubits_of h len", len(qcr_qubits_of(op1)), 1)

    let op3 = []
    push(op3, "toffoli")
    push(op3, 0)
    push(op3, 1)
    push(op3, 2)
    cki("qubits_of toffoli len", len(qcr_qubits_of(op3)), 3)

    print("PASS _quantum_circuit_test")
