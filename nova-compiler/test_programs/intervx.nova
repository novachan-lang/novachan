fn interval(lo, hi)
  [lo, hi]

fn iv_overlaps(a, b)
  a[0] < b[1] and b[0] < a[1]

fn iv_contains(iv, point)
  point >= iv[0] and point < iv[1]

fn iv_merge(a, b)
  if not iv_overlaps(a, b)
    return [a, b]
  let lo = a[0]
  if b[0] < lo
    lo = b[0]
  let hi = a[1]
  if b[1] > hi
    hi = b[1]
  [[lo, hi]]

fn iv_intersect(a, b)
  if not iv_overlaps(a, b)
    return []
  let lo = a[0]
  if b[0] > lo
    lo = b[0]
  let hi = a[1]
  if b[1] < hi
    hi = b[1]
  [lo, hi]

fn iv_length(iv)
  iv[1] - iv[0]

fn _iv_sort(intervals)
  let sorted = []
  for iv in intervals
    push(sorted, iv)
  let i = 1
  while i < len(sorted)
    let key = sorted[i]
    let j = i - 1
    while j >= 0 and sorted[j][0] > key[0]
      sorted[j + 1] = sorted[j]
      j = j - 1
    sorted[j + 1] = key
    i = i + 1
  sorted

fn iv_merge_all(intervals)
  if len(intervals) == 0
    return []
  let sorted = _iv_sort(intervals)
  let merged = [sorted[0]]
  let i = 1
  while i < len(sorted)
    let last = merged[len(merged) - 1]
    let curr = sorted[i]
    if curr[0] <= last[1]
      merged[len(merged) - 1] = [last[0], curr[1]]
      if last[1] > curr[1]
        merged[len(merged) - 1] = [last[0], last[1]]
    else
      push(merged, curr)
    i = i + 1
  merged

fn iv_gaps(intervals)
  let m = iv_merge_all(intervals)
  let gaps = []
  let i = 1
  while i < len(m)
    push(gaps, [m[i - 1][1], m[i][0]])
    i = i + 1
  gaps

fn main()
  let a = interval(1, 5)
  let b = interval(3, 8)
  let c = interval(10, 15)

  assert(iv_overlaps(a, b) == 1, "a,b overlap")
  assert(iv_overlaps(a, c) == 0, "a,c no overlap")
  assert(iv_overlaps(b, c) == 0, "b,c no overlap")

  assert(iv_contains(a, 3) == 1, "3 in [1,5)")
  assert(iv_contains(a, 5) == 0, "5 not in [1,5)")
  assert(iv_contains(a, 0) == 0, "0 not in [1,5)")

  assert(iv_length(a) == 4, "length [1,5) = 4")
  assert(iv_length(c) == 5, "length [10,15) = 5")

  let isect = iv_intersect(a, b)
  assert(isect[0] == 3, "intersect lo = 3")
  assert(isect[1] == 5, "intersect hi = 5")

  let no_isect = iv_intersect(a, c)
  assert(len(no_isect) == 0, "no intersection")

  let m = iv_merge(a, b)
  assert(len(m) == 1, "merge overlapping = 1 interval")
  assert(m[0][0] == 1, "merged lo = 1")
  assert(m[0][1] == 8, "merged hi = 8")

  let m2 = iv_merge(a, c)
  assert(len(m2) == 2, "merge non-overlapping = 2 intervals")

  let all = iv_merge_all([[1, 3], [2, 6], [8, 10], [9, 12]])
  assert(len(all) == 2, "merge_all = 2 groups")
  assert(all[0][0] == 1, "group1 lo")
  assert(all[0][1] == 6, "group1 hi")
  assert(all[1][0] == 8, "group2 lo")
  assert(all[1][1] == 12, "group2 hi")

  let g = iv_gaps([[1, 3], [5, 7], [10, 12]])
  assert(len(g) == 2, "2 gaps")
  assert(g[0][0] == 3, "gap1 start")
  assert(g[0][1] == 5, "gap1 end")

  print("intervx: all passed")
