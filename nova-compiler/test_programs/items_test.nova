fn main()
    let d = {"x": 10, "y": 20, "z": 30}
    let it = items(d)
    assert_eq(len(it), 3)

    let found_keys = []
    let found_vals = []
    for pair in it
        push(found_keys, pair[0])
        push(found_vals, pair[1])
    assert_eq(len(found_keys), 3)
    assert_eq(len(found_vals), 3)

    assert(contains(found_keys, "x"), "missing x")
    assert(contains(found_keys, "y"), "missing y")
    assert(contains(found_keys, "z"), "missing z")
    assert(contains(found_vals, 10), "missing 10")
    assert(contains(found_vals, 20), "missing 20")
    assert(contains(found_vals, 30), "missing 30")

    let empty = {}
    let eit = items(empty)
    assert_eq(len(eit), 0)

    let single = {"only": 42}
    let sit = items(single)
    assert_eq(len(sit), 1)
    assert_eq(sit[0][0], "only")
    assert_eq(sit[0][1], 42)

    let sum = 0
    for pair in items(d)
        sum = sum + pair[1]
    assert_eq(sum, 60)

    print("items_test: all passed")
