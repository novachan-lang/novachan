// Test closures in the IR pipeline

// Test 1: Basic closure with capture
fn makeAdder(n)
    x => x + n

let add5 = makeAdder(5)
let add10 = makeAdder(10)
print(add5(3))
print(add10(3))
print(add5(add10(1)))

// Test 2: Higher-order functions with function references
fn apply(f, x)
    f(x)

fn double(n)
    n * 2

fn square(n)
    n * n

print(apply(double, 5))
print(apply(square, 4))
print(apply(double, 0))

// Test 3: Lambda with no captures
let add3 = x => x + 3
print(apply(add3, 10))

// Test 4: Lambda with capture from local scope
let multiplier = 5
let times5 = x => x * multiplier
print(apply(times5, 7))

// Test 5: Escaping closures
fn getDoubler()
    x => x * 2

fn getTripler()
    x => x * 3

let d = getDoubler()
let t = getTripler()
print(d(5))
print(t(5))
print(d(t(4)))

// Test 6: Compose with closures
fn compose(f, g, x)
    f(g(x))

print(compose(double, square, 3))
print(compose(square, double, 3))

// Test 7: Closure over closure
let add20 = makeAdder(20)
print(apply(add20, 100))

// Test 8: Multiple captures
fn makeLinear(a, b)
    x => a * x + b

let f1 = makeLinear(2, 3)
let f2 = makeLinear(5, 1)
print(f1(10))
print(f2(10))
