fn main()
  let lines = []
  let f = {}
  f["name"] = "main"
  f["enter_ms"] = time_ms()
  f["exit_ms"] = time_ms()
  let dur = f["exit_ms"] - f["enter_ms"]
  push(lines, f["name"] + " (" + str(dur) + "ms)")
  let out = join(lines, "\n")
  assert(contains(out, "main"), "has main")
  print("r3 ok: " + out)
