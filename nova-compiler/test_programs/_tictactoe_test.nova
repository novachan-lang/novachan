import std/game/tictactoe

fn chk_int(name: string, got: int, want: int)
    if got != want
        print("FAIL tictactoe " + name + ": got " + str(got) + " want " + str(want))
        exit(1)

fn chk_bool(name: string, got: bool, want: bool)
    let gs = "false"
    if got
        gs = "true"
    let ws = "false"
    if want
        ws = "true"
    if got != want
        print("FAIL tictactoe " + name + ": got " + gs + " want " + ws)
        exit(1)

// Helper: build a 9-cell board from 9 ints.
fn mk_board(a0: int, a1: int, a2: int, a3: int, a4: int, a5: int, a6: int, a7: int, a8: int) -> list
    let b = []
    push(b, a0)
    push(b, a1)
    push(b, a2)
    push(b, a3)
    push(b, a4)
    push(b, a5)
    push(b, a6)
    push(b, a7)
    push(b, a8)
    b

fn test_winner_top_row_x()
    // X wins: top row cells 0,1,2 = 1
    // 1 1 1
    // 2 2 0
    // 0 0 0
    let b = mk_board(1, 1, 1, 2, 2, 0, 0, 0, 0)
    chk_int("top_row_X winner", ttt_winner(b), 1)

fn test_winner_diagonal_o()
    // O wins: diagonal 0,4,8 = 2
    // 2 1 1
    // 1 2 0
    // 0 1 2
    let b = mk_board(2, 1, 1, 1, 2, 0, 0, 1, 2)
    chk_int("diag_O winner", ttt_winner(b), 2)

fn test_no_winner()
    // No winner yet
    // 1 2 1
    // 2 2 1
    // 0 0 0
    let b = mk_board(1, 2, 1, 2, 2, 1, 0, 0, 0)
    chk_int("no winner", ttt_winner(b), 0)

fn test_is_draw()
    // Draw: full board, no winner
    // 1 2 1
    // 1 1 2
    // 2 1 2
    let b = mk_board(1, 2, 1, 1, 1, 2, 2, 1, 2)
    chk_bool("is_draw true", ttt_is_draw(b), true)

fn test_not_draw()
    // X wins, not a draw
    let b = mk_board(1, 1, 1, 2, 2, 0, 0, 0, 0)
    chk_bool("not_draw X wins", ttt_is_draw(b), false)

fn test_best_move_take_win()
    // X can win immediately at cell 2 (top row: 1,1,_)
    // board: 1 1 0  2 2 0  0 0 0
    // X should pick cell 2 to win.
    let b = mk_board(1, 1, 0, 2, 2, 0, 0, 0, 0)
    let m = ttt_best_move(b, 1)
    chk_int("take_win cell2", m, 2)

fn test_best_move_block()
    // O (player 2) must block X from winning.
    // Board: X has 0,1 — X will win at 2 if not blocked.
    // 1 1 0
    // 0 2 0
    // 0 0 0
    // O should pick cell 2 to block.
    let b = mk_board(1, 1, 0, 0, 2, 0, 0, 0, 0)
    let m = ttt_best_move(b, 2)
    chk_int("block_x cell2", m, 2)

fn main()
    test_winner_top_row_x()
    test_winner_diagonal_o()
    test_no_winner()
    test_is_draw()
    test_not_draw()
    test_best_move_take_win()
    test_best_move_block()
    print("PASS _tictactoe_test")
