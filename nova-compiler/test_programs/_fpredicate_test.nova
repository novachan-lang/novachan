// KAT for std/functional/fpredicate — predicate combinators
import std/functional/fpredicate

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn is_even(x)
    x % 2 == 0

fn is_pos(x)
    x > 0

fn main()
    // --- fpr_all ---
    ckb("all pos [1,2,3]", fpr_all(is_pos, [1, 2, 3]), true)
    ckb("all pos [1,-2,3]", fpr_all(is_pos, [1, -2, 3]), false)
    ckb("all pos [] empty", fpr_all(is_pos, []), true)
    ckb("all even [2,4,6]", fpr_all(is_even, [2, 4, 6]), true)
    ckb("all even [2,3,6]", fpr_all(is_even, [2, 3, 6]), false)

    // --- fpr_any ---
    ckb("any even [1,3,5,6]", fpr_any(is_even, [1, 3, 5, 6]), true)
    ckb("any even [1,3,5]", fpr_any(is_even, [1, 3, 5]), false)
    ckb("any even [] empty", fpr_any(is_even, []), false)
    ckb("any pos [-1,0,1]", fpr_any(is_pos, [-1, 0, 1]), true)
    ckb("any pos [-1,-2]", fpr_any(is_pos, [-1, -2]), false)

    // --- fpr_none ---
    ckb("none even [1,3,5]", fpr_none(is_even, [1, 3, 5]), true)
    ckb("none even [1,2,3]", fpr_none(is_even, [1, 2, 3]), false)
    ckb("none even [] empty", fpr_none(is_even, []), true)
    ckb("none pos [-1,-2,-3]", fpr_none(is_pos, [-1, -2, -3]), true)
    ckb("none pos [-1,0,1]", fpr_none(is_pos, [-1, 0, 1]), false)

    // --- fpr_count ---
    cki("count even [1,2,3,4,5,6]", fpr_count(is_even, [1, 2, 3, 4, 5, 6]), 3)
    cki("count even [1,3,5]", fpr_count(is_even, [1, 3, 5]), 0)
    cki("count even [2,4,6]", fpr_count(is_even, [2, 4, 6]), 3)
    cki("count even [] empty", fpr_count(is_even, []), 0)
    cki("count pos [1,-1,2,-2]", fpr_count(is_pos, [1, -1, 2, -2]), 2)

    // --- fpr_find_index ---
    cki("find_index even [1,3,4,5]", fpr_find_index(is_even, [1, 3, 4, 5]), 2)
    cki("find_index even [2,3,4]", fpr_find_index(is_even, [2, 3, 4]), 0)
    cki("find_index even [1,3,5]", fpr_find_index(is_even, [1, 3, 5]), -1)
    cki("find_index even [] empty", fpr_find_index(is_even, []), -1)
    cki("find_index pos [-1,0,3]", fpr_find_index(is_pos, [-1, 0, 3]), 2)

    print("PASS _fpredicate_test")

main()
