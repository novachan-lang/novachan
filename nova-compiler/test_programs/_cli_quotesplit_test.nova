// KAT for std/cli/cli_quotesplit — command-line tokeniser with quote handling.
import std/cli/cli_quotesplit

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let g = "false"
        if got
            g = "true"
        let w = "false"
        if want
            w = "true"
        print("FAIL " + label + ": got=" + g + " want=" + w)
        exit(1)

fn ckl(label: string, got: list, want: list)
    cki(label + "_len", len(got), len(want))
    let i = 0
    while i < len(want)
        cks(label + "_" + str(i), got[i], want[i])
        i = i + 1

fn main()
    // ── KAT: spec cases ────────────────────────────────────────────────────
    // clq_split('echo hello world') = ['echo','hello','world']
    let r1 = clq_split("echo hello world")
    let w1 = ["echo", "hello", "world"]
    ckl("split_basic", r1, w1)

    // clq_split("echo 'hello world'") = ['echo','hello world']
    let r2 = clq_split("echo 'hello world'")
    let w2 = ["echo", "hello world"]
    ckl("split_single_quote", r2, w2)

    // clq_split('a "b c" d') = ['a','b c','d']
    let r3 = clq_split("a \"b c\" d")
    let w3 = ["a", "b c", "d"]
    ckl("split_double_quote", r3, w3)

    // clq_needs_quoting('b c') = true
    ckb("needs_quoting_space", clq_needs_quoting("b c"), true)

    // clq_needs_quoting('bc') = false
    ckb("needs_quoting_plain", clq_needs_quoting("bc"), false)

    // clq_join(['a','b c']) = 'a "b c"'
    let j1 = clq_join(["a", "b c"])
    cks("join_basic", j1, "a \"b c\"")

    // ── Additional edge cases ───────────────────────────────────────────────
    // empty string → empty list
    let r4 = clq_split("")
    cki("split_empty_len", len(r4), 0)

    // only spaces → empty list
    let r5 = clq_split("   ")
    cki("split_spaces_only", len(r5), 0)

    // single token, no spaces
    let r6 = clq_split("hello")
    let w6 = ["hello"]
    ckl("split_single_token", r6, w6)

    // clq_needs_quoting('') = true (empty string)
    ckb("needs_quoting_empty", clq_needs_quoting(""), true)

    // clq_needs_quoting with tab
    ckb("needs_quoting_tab", clq_needs_quoting("a\tb"), true)

    // clq_join with empty arg gets quoted
    let j2 = clq_join(["x", "", "y"])
    cks("join_empty_arg", j2, "x \"\" y")

    // clq_join with all plain args
    let j3 = clq_join(["ls", "-la"])
    cks("join_all_plain", j3, "ls -la")

    // clq_join with empty list
    let j4 = clq_join([])
    cks("join_empty_list", j4, "")

    // double-quoted region with internal spaces
    let r7 = clq_split("cmd \"a b c\" end")
    let w7 = ["cmd", "a b c", "end"]
    ckl("split_double_multi_space", r7, w7)

    // adjacent tokens, no separator needed
    let r8 = clq_split("a b c d")
    let w8 = ["a", "b", "c", "d"]
    ckl("split_four_tokens", r8, w8)

    print("PASS _cli_quotesplit_test")
