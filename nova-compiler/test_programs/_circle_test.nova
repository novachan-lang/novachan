// KAT for std/geometry/circle
// Tests: cr_area, cr_circumference, cr_contains, cr_intersect, cr_from_3points
import std/geometry/circle

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckf(label, got, want)
    let hi = want + 0.001
    let lo = want - 0.001
    if got > hi
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)
    if got < lo
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    let goti = 0
    if got
        let goti = 1
    let wanti = 0
    if want
        let wanti = 1
    if goti != wanti
        print("FAIL " + label + ": got=" + str(goti) + " want=" + str(wanti))
        exit(1)

fn main()
    // KAT 1: cr_area(1.0) == pi ~ 3.14159
    let a1 = cr_area(1.0)
    ckf("cr_area(1.0)", a1, 3.14159)

    // KAT 2: cr_circumference(1.0) == 2*pi ~ 6.28319
    let c1 = cr_circumference(1.0)
    ckf("cr_circumference(1.0)", c1, 6.28319)

    // KAT 3: cr_contains(0,0,5,3,4) == true
    // distance^2 = 9+16 = 25, r^2 = 25 -> on the circle -> true
    let inside1 = cr_contains(0, 0, 5, 3, 4)
    ckb("cr_contains(0,0,5,3,4)", inside1, true)

    // KAT 4: cr_contains(0,0,5,4,4) == false
    // distance^2 = 16+16 = 32, r^2 = 25 -> outside -> false
    let inside2 = cr_contains(0, 0, 5, 4, 4)
    ckb("cr_contains(0,0,5,4,4)", inside2, false)

    // KAT 5: cr_intersect([0,0,2],[3,0,2]) == true
    // centres 3 apart, sum of radii = 4 -> 3 <= 4 -> overlap -> true
    let i1 = [0, 0, 2]
    let i2 = [3, 0, 2]
    let isect1 = cr_intersect(i1, i2)
    ckb("cr_intersect([0,0,2],[3,0,2])", isect1, true)

    // KAT 6: cr_intersect([0,0,1],[5,0,1]) == false
    // centres 5 apart, sum of radii = 2 -> 5 > 2 -> no overlap -> false
    let i3 = [0, 0, 1]
    let i4 = [5, 0, 1]
    let isect2 = cr_intersect(i3, i4)
    ckb("cr_intersect([0,0,1],[5,0,1])", isect2, false)

    // KAT 7+8: cr_from_3points([0,0],[2,0],[0,2])
    // Circumcenter = (1,1), r = sqrt(2) ~ 1.41421
    let c = cr_from_3points([0, 0], [2, 0], [0, 2])
    let ccx = c[0]
    let ccy = c[1]
    let ccr = c[2]
    ckf("cr_from_3points cx", ccx, 1.0)
    ckf("cr_from_3points cy", ccy, 1.0)
    ckf("cr_from_3points r", ccr, 1.41421)

    // KAT 9: cr_area(2.0) == 4*pi ~ 12.56637
    let a2 = cr_area(2.0)
    ckf("cr_area(2.0)", a2, 12.56637)

    // KAT 10: cr_circumference(3.0) == 6*pi ~ 18.84956
    let c3 = cr_circumference(3.0)
    ckf("cr_circumference(3.0)", c3, 18.84956)

    // KAT 11: cr_contains(2,3,1,2,3) == true (center point is inside)
    let inside3 = cr_contains(2, 3, 1, 2, 3)
    ckb("cr_contains center point", inside3, true)

    // KAT 12: touching circles cr_intersect([0,0,3],[5,0,2]) == true (d=5 == r1+r2)
    let i5 = [0, 0, 3]
    let i6 = [5, 0, 2]
    let isect3 = cr_intersect(i5, i6)
    ckb("cr_intersect touching", isect3, true)

    print("_circle_test passed")
