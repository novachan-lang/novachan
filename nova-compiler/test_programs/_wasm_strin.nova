// WASM frontend IN-direction: JS writes a string into wasm linear memory (via the exported wasm_alloc), then a
// NOVA fn receives it as a `string` and processes it with the value-model -- echo_len returns its length,
// echo_upper sends an UPPERCASED copy back out via host_emit. Round-trip JS->NOVA->JS (event/form-input path).
extern fn host_emit(s: string)
fn echo_len(s: string) -> int
    len(s)
fn echo_upper(s: string)
    unsafe host_emit(upper(s))
fn main()
    let n = echo_len("ab")
    echo_upper("cd")
    print(n)
