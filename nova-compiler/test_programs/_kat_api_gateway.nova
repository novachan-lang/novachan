import forge_api_gateway

fn main()
    let gw = gw_new("my-gateway")
    gw = gw_add_upstream(gw, "users-svc", ["http://user1:8080", "http://user2:8080"])
    gw = gw_add_upstream(gw, "orders-svc", ["http://order1:8080"])
    gw = gw_add_route(gw, "/api/users", "users-svc")
    gw = gw_add_route_methods(gw, "/api/orders", "orders-svc", ["GET", "POST"])
    gw = gw_set_strip_prefix(gw, "/api/users", true)
    gw = gw_set_timeout(gw, "/api/orders", 5000)

    let route = gw_match_route(gw, "/api/users/123", "GET")
    assert(route["path"] == "/api/users", "matched users route")
    assert(route["upstream"] == "users-svc", "upstream users-svc")

    let order_route = gw_match_route(gw, "/api/orders/456", "POST")
    assert(order_route["upstream"] == "orders-svc", "order route")
    assert(order_route["timeout_ms"] == 5000, "custom timeout")

    let no_match = gw_match_route(gw, "/api/products", "GET")
    assert(no_match["path"] == "", "no match")

    let no_method = gw_match_route(gw, "/api/orders/1", "DELETE")
    assert(no_method["path"] == "", "method not allowed")

    let t1 = gw_next_target(gw, "users-svc")
    assert(t1 == "http://user1:8080", "first target")
    let t2 = gw_next_target(gw, "users-svc")
    assert(t2 == "http://user2:8080", "round robin")
    let t3 = gw_next_target(gw, "users-svc")
    assert(t3 == "http://user1:8080", "wraps around")

    let single = gw_next_target(gw, "orders-svc")
    assert(single == "http://order1:8080", "single target")

    let missing = gw_next_target(gw, "nope")
    assert(missing == "", "missing upstream")

    gw = gw_add_middleware(gw, "auth")
    gw = gw_add_middleware(gw, "rate_limit")
    let desc = gw_describe(gw)
    assert(contains(desc, "my-gateway"), "desc has name")
    assert(contains(desc, "/api/users"), "desc has route")

    print("API-GATEWAY KAT PASS")
