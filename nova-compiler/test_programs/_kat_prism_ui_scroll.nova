// KAT for prism/ui/prism_ui_scroll.nova
//
// Proves, against concrete expected values:
//   1. prism_sc_scroll: has_more=true appends a "Load more" press button; has_more=false
//      appends a "-- End --" label. Both preserve the original items in order.
//   2. prism_sc_virtual: windows [offset, offset+visible_count) out of all_items, clamps the
//      window end to the list length, and appends an accurate "Showing X-Y of Z" info label.
//   3. prism_sc_top_button: a single press node wrapping a "Top" label.
//   4. prism_sc_paginated: items followed by a nav band [prev press, page-info label, next
//      press], with the info text tracking page/total_pages exactly.
//   5. Every documented error path in all four functions.
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1):
//   ./gen3_test.exe _kat_prism_ui_scroll.nova
//   clang -O2 -o _kat_prism_ui_scroll.exe _kat_prism_ui_scroll.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_ui_scroll.exe

import prism_ui_scroll
import prism_node
import prism_content

fn _check(label: string, cond: bool) -> bool
    if cond
        print("PASS " + label)
        return true
    print("FAIL " + label)
    false

fn main()
    let mut total = 0
    let mut passed = 0

    let i1 = unwrap(prism_content.prism_label("Item 1"))
    let i2 = unwrap(prism_content.prism_label("Item 2"))
    let i3 = unwrap(prism_content.prism_label("Item 3"))
    let i4 = unwrap(prism_content.prism_label("Item 4"))
    let i5 = unwrap(prism_content.prism_label("Item 5"))

    // ── 1. prism_sc_scroll: has_more=true ────────────────────────────────────────────────
    let r1 = prism_ui_scroll.prism_sc_scroll([i1, i2, i3], true)
    total = total + 1
    if _check("scroll has_more=true is_ok", is_ok(r1))
        passed = passed + 1

    let n1 = unwrap(r1)
    total = total + 1
    if _check("scroll has_more=true kind_str == stack", prism_node.prism_node_kind_str(n1) == "stack")
        passed = passed + 1

    let c1 = prism_node.prism_node_children(n1)
    total = total + 1
    if _check("scroll has_more=true children count == 4", len(c1) == 4)
        passed = passed + 1

    total = total + 1
    if _check("scroll has_more=true child0 text == Item 1", prism_node.prism_node_attr_str(c1[0], "text", "??") == "Item 1")
        passed = passed + 1
    total = total + 1
    if _check("scroll has_more=true child2 text == Item 3", prism_node.prism_node_attr_str(c1[2], "text", "??") == "Item 3")
        passed = passed + 1

    total = total + 1
    if _check("scroll has_more=true child3 kind_str == press", prism_node.prism_node_kind_str(c1[3]) == "press")
        passed = passed + 1

    let btn_children = prism_node.prism_node_children(c1[3])
    total = total + 1
    if _check("scroll has_more=true button has 1 child", len(btn_children) == 1)
        passed = passed + 1
    total = total + 1
    if _check("scroll has_more=true button label == Load more", prism_node.prism_node_attr_str(btn_children[0], "text", "??") == "Load more")
        passed = passed + 1

    // ── 2. prism_sc_scroll: has_more=false ───────────────────────────────────────────────
    let r2 = prism_ui_scroll.prism_sc_scroll([i1], false)
    total = total + 1
    if _check("scroll has_more=false is_ok", is_ok(r2))
        passed = passed + 1

    let n2 = unwrap(r2)
    let c2 = prism_node.prism_node_children(n2)
    total = total + 1
    if _check("scroll has_more=false children count == 2", len(c2) == 2)
        passed = passed + 1
    total = total + 1
    if _check("scroll has_more=false child1 kind_str == label", prism_node.prism_node_kind_str(c2[1]) == "label")
        passed = passed + 1
    total = total + 1
    if _check("scroll has_more=false child1 text == -- End --", prism_node.prism_node_attr_str(c2[1], "text", "??") == "-- End --")
        passed = passed + 1

    // ── 3. prism_sc_scroll: error paths ──────────────────────────────────────────────────
    let e1 = prism_ui_scroll.prism_sc_scroll([], true)
    total = total + 1
    if _check("scroll empty items is_err", is_err(e1))
        passed = passed + 1
    total = total + 1
    if _check("scroll empty items message", unwrap_err(e1) == "prism_sc_scroll: items must not be empty")
        passed = passed + 1

    let e2 = prism_ui_scroll.prism_sc_scroll([i1, 42], true)
    total = total + 1
    if _check("scroll non-PrismNode item is_err", is_err(e2))
        passed = passed + 1
    total = total + 1
    if _check("scroll non-PrismNode item message mentions index+type", contains(unwrap_err(e2), "is not a PrismNode"))
        passed = passed + 1

    // ── 4. prism_sc_virtual: basic window ────────────────────────────────────────────────
    let all_items = [i1, i2, i3, i4, i5]

    let r3 = prism_ui_scroll.prism_sc_virtual(all_items, 0, 3)
    total = total + 1
    if _check("virtual window ok", is_ok(r3))
        passed = passed + 1

    let n3 = unwrap(r3)
    total = total + 1
    if _check("virtual window kind_str == stack", prism_node.prism_node_kind_str(n3) == "stack")
        passed = passed + 1

    let c3 = prism_node.prism_node_children(n3)
    total = total + 1
    if _check("virtual window children count == 4", len(c3) == 4)
        passed = passed + 1
    total = total + 1
    if _check("virtual window child0 text == Item 1", prism_node.prism_node_attr_str(c3[0], "text", "??") == "Item 1")
        passed = passed + 1
    total = total + 1
    if _check("virtual window child2 text == Item 3", prism_node.prism_node_attr_str(c3[2], "text", "??") == "Item 3")
        passed = passed + 1
    total = total + 1
    if _check("virtual window info text == Showing 1-3 of 5", prism_node.prism_node_attr_str(c3[3], "text", "??") == "Showing 1-3 of 5")
        passed = passed + 1

    // ── 5. prism_sc_virtual: clamped window at tail ──────────────────────────────────────
    let r4 = prism_ui_scroll.prism_sc_virtual(all_items, 3, 3)
    total = total + 1
    if _check("virtual clamped ok", is_ok(r4))
        passed = passed + 1

    let n4 = unwrap(r4)
    let c4 = prism_node.prism_node_children(n4)
    total = total + 1
    if _check("virtual clamped children count == 3", len(c4) == 3)
        passed = passed + 1
    total = total + 1
    if _check("virtual clamped child0 text == Item 4", prism_node.prism_node_attr_str(c4[0], "text", "??") == "Item 4")
        passed = passed + 1
    total = total + 1
    if _check("virtual clamped child1 text == Item 5", prism_node.prism_node_attr_str(c4[1], "text", "??") == "Item 5")
        passed = passed + 1
    total = total + 1
    if _check("virtual clamped info text == Showing 4-5 of 5", prism_node.prism_node_attr_str(c4[2], "text", "??") == "Showing 4-5 of 5")
        passed = passed + 1

    // ── 6. prism_sc_virtual: error paths ─────────────────────────────────────────────────
    let e3 = prism_ui_scroll.prism_sc_virtual([], 0, 1)
    total = total + 1
    if _check("virtual empty all_items is_err", is_err(e3))
        passed = passed + 1
    total = total + 1
    if _check("virtual empty all_items message", unwrap_err(e3) == "prism_sc_virtual: all_items must not be empty")
        passed = passed + 1

    let e4 = prism_ui_scroll.prism_sc_virtual(all_items, -1, 1)
    total = total + 1
    if _check("virtual negative offset is_err", is_err(e4))
        passed = passed + 1
    total = total + 1
    if _check("virtual negative offset message", unwrap_err(e4) == "prism_sc_virtual: offset must be >= 0")
        passed = passed + 1

    let e5 = prism_ui_scroll.prism_sc_virtual(all_items, 0, 0)
    total = total + 1
    if _check("virtual zero visible_count is_err", is_err(e5))
        passed = passed + 1
    total = total + 1
    if _check("virtual zero visible_count message", unwrap_err(e5) == "prism_sc_virtual: visible_count must be > 0")
        passed = passed + 1

    let e6 = prism_ui_scroll.prism_sc_virtual(all_items, 0, -2)
    total = total + 1
    if _check("virtual negative visible_count is_err", is_err(e6))
        passed = passed + 1
    total = total + 1
    if _check("virtual negative visible_count message", unwrap_err(e6) == "prism_sc_virtual: visible_count must be > 0")
        passed = passed + 1

    let e7 = prism_ui_scroll.prism_sc_virtual(all_items, 5, 1)
    total = total + 1
    if _check("virtual offset == total is_err", is_err(e7))
        passed = passed + 1
    total = total + 1
    if _check("virtual offset == total message", unwrap_err(e7) == "prism_sc_virtual: offset 5 >= total 5")
        passed = passed + 1

    let e8 = prism_ui_scroll.prism_sc_virtual(all_items, 10, 1)
    total = total + 1
    if _check("virtual offset > total is_err", is_err(e8))
        passed = passed + 1
    total = total + 1
    if _check("virtual offset > total message", unwrap_err(e8) == "prism_sc_virtual: offset 10 >= total 5")
        passed = passed + 1

    let mixed_items = [i1, 99, i3]
    let e9 = prism_ui_scroll.prism_sc_virtual(mixed_items, 0, 2)
    total = total + 1
    if _check("virtual non-PrismNode item is_err", is_err(e9))
        passed = passed + 1
    total = total + 1
    if _check("virtual non-PrismNode item message mentions index+type", contains(unwrap_err(e9), "is not a PrismNode"))
        passed = passed + 1

    // ── 7. prism_sc_top_button ────────────────────────────────────────────────────────────
    let r5 = prism_ui_scroll.prism_sc_top_button()
    total = total + 1
    if _check("top_button is_ok", is_ok(r5))
        passed = passed + 1

    let n5 = unwrap(r5)
    total = total + 1
    if _check("top_button kind_str == press", prism_node.prism_node_kind_str(n5) == "press")
        passed = passed + 1

    let c5 = prism_node.prism_node_children(n5)
    total = total + 1
    if _check("top_button has 1 child", len(c5) == 1)
        passed = passed + 1
    total = total + 1
    if _check("top_button child kind_str == label", prism_node.prism_node_kind_str(c5[0]) == "label")
        passed = passed + 1
    total = total + 1
    if _check("top_button child text == Top", prism_node.prism_node_attr_str(c5[0], "text", "??") == "Top")
        passed = passed + 1

    // ── 8. prism_sc_paginated: basic case ────────────────────────────────────────────────
    let r6 = prism_ui_scroll.prism_sc_paginated([i1, i2], 1, 3)
    total = total + 1
    if _check("paginated ok", is_ok(r6))
        passed = passed + 1

    let n6 = unwrap(r6)
    total = total + 1
    if _check("paginated kind_str == stack", prism_node.prism_node_kind_str(n6) == "stack")
        passed = passed + 1

    let c6 = prism_node.prism_node_children(n6)
    total = total + 1
    if _check("paginated children count == 3", len(c6) == 3)
        passed = passed + 1
    total = total + 1
    if _check("paginated child0 text == Item 1", prism_node.prism_node_attr_str(c6[0], "text", "??") == "Item 1")
        passed = passed + 1
    total = total + 1
    if _check("paginated child1 text == Item 2", prism_node.prism_node_attr_str(c6[1], "text", "??") == "Item 2")
        passed = passed + 1

    total = total + 1
    if _check("paginated nav kind_str == band", prism_node.prism_node_kind_str(c6[2]) == "band")
        passed = passed + 1

    let nav = prism_node.prism_node_children(c6[2])
    total = total + 1
    if _check("paginated nav has 3 children", len(nav) == 3)
        passed = passed + 1

    total = total + 1
    if _check("paginated nav prev kind_str == press", prism_node.prism_node_kind_str(nav[0]) == "press")
        passed = passed + 1
    let prev_children = prism_node.prism_node_children(nav[0])
    total = total + 1
    if _check("paginated nav prev label == < Prev", prism_node.prism_node_attr_str(prev_children[0], "text", "??") == "< Prev")
        passed = passed + 1

    total = total + 1
    if _check("paginated nav info kind_str == label", prism_node.prism_node_kind_str(nav[1]) == "label")
        passed = passed + 1
    total = total + 1
    if _check("paginated nav info text == Page 1 of 3", prism_node.prism_node_attr_str(nav[1], "text", "??") == "Page 1 of 3")
        passed = passed + 1

    total = total + 1
    if _check("paginated nav next kind_str == press", prism_node.prism_node_kind_str(nav[2]) == "press")
        passed = passed + 1
    let next_children = prism_node.prism_node_children(nav[2])
    total = total + 1
    if _check("paginated nav next label == Next >", prism_node.prism_node_attr_str(next_children[0], "text", "??") == "Next >")
        passed = passed + 1

    // ── 9. prism_sc_paginated: page info text tracks page/total_pages ───────────────────
    let r7 = prism_ui_scroll.prism_sc_paginated([i1], 2, 5)
    let n7 = unwrap(r7)
    let c7 = prism_node.prism_node_children(n7)
    let nav7 = prism_node.prism_node_children(c7[1])
    total = total + 1
    if _check("paginated page 2 of 5 info text", prism_node.prism_node_attr_str(nav7[1], "text", "??") == "Page 2 of 5")
        passed = passed + 1

    // ── 10. prism_sc_paginated: error paths ──────────────────────────────────────────────
    let e10 = prism_ui_scroll.prism_sc_paginated([], 1, 1)
    total = total + 1
    if _check("paginated empty items is_err", is_err(e10))
        passed = passed + 1
    total = total + 1
    if _check("paginated empty items message", unwrap_err(e10) == "prism_sc_paginated: items must not be empty")
        passed = passed + 1

    let e11 = prism_ui_scroll.prism_sc_paginated([i1], 0, 3)
    total = total + 1
    if _check("paginated page<1 (zero) is_err", is_err(e11))
        passed = passed + 1
    total = total + 1
    if _check("paginated page<1 (zero) message", unwrap_err(e11) == "prism_sc_paginated: page must be >= 1")
        passed = passed + 1

    let e12 = prism_ui_scroll.prism_sc_paginated([i1], -1, 3)
    total = total + 1
    if _check("paginated page<1 (negative) is_err", is_err(e12))
        passed = passed + 1
    total = total + 1
    if _check("paginated page<1 (negative) message", unwrap_err(e12) == "prism_sc_paginated: page must be >= 1")
        passed = passed + 1

    let e13 = prism_ui_scroll.prism_sc_paginated([i1], 1, 0)
    total = total + 1
    if _check("paginated total_pages<1 is_err", is_err(e13))
        passed = passed + 1
    total = total + 1
    if _check("paginated total_pages<1 message", unwrap_err(e13) == "prism_sc_paginated: total_pages must be >= 1")
        passed = passed + 1

    let e14 = prism_ui_scroll.prism_sc_paginated([i1], 5, 3)
    total = total + 1
    if _check("paginated page > total_pages is_err", is_err(e14))
        passed = passed + 1
    total = total + 1
    if _check("paginated page > total_pages message", unwrap_err(e14) == "prism_sc_paginated: page 5 > total_pages 3")
        passed = passed + 1

    let mixed_items2 = [i1, "not a node"]
    let e15 = prism_ui_scroll.prism_sc_paginated(mixed_items2, 1, 1)
    total = total + 1
    if _check("paginated non-PrismNode item is_err", is_err(e15))
        passed = passed + 1
    total = total + 1
    if _check("paginated non-PrismNode item message mentions index+type", contains(unwrap_err(e15), "is not a PrismNode"))
        passed = passed + 1

    print("== " + str(passed) + "/" + str(total) + " assertions passed ==")
    if passed != total
        print("FAIL: KAT summary -- not all assertions passed")
