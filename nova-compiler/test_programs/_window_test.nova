// KAT test for std/dsp/window — window functions for DSP.
// All KATs are hand-computed and adversarially verified.
import std/dsp/window

// Compare two float lists element-wise within eps=0.001.
fn ckf(name: string, got: list, want: list)
    let ng = len(got)
    let nw = len(want)
    if ng != nw
        print("FAIL " + name + ": length got=" + str(ng) + " want=" + str(nw))
        exit(1)
    let i = 0
    while i < ng
        let gv = got[i] * 1.0
        let wv = want[i] * 1.0
        let d = gv - wv
        if d < 0.0
            d = 0.0 - d
        if d >= 0.001
            print("FAIL " + name + "[" + str(i) + "]: got " + str(gv) + " want " + str(wv))
            exit(1)
        i = i + 1
    print("ok " + name)

// Compare a single float within eps=0.001.
fn ckf1(name: string, got: float, want: float)
    let d = got - want
    if d < 0.0
        d = 0.0 - d
    if d >= 0.001
        print("FAIL " + name + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("ok " + name)

fn main()
    // KAT 1: win_rectangular(3) == [1.0, 1.0, 1.0]
    let rect3 = win_rectangular(3)
    let want_rect3 = [1.0, 1.0, 1.0]
    ckf("win_rectangular_3", rect3, want_rect3)

    // KAT 2: win_hann(3) == [0.0, 1.0, 0.0]
    // w[0]=0.5-0.5*cos(0)=0.0, w[1]=0.5-0.5*cos(pi)=1.0, w[2]=0.5-0.5*cos(2pi)=0.0
    let hann3 = win_hann(3)
    let want_hann3 = [0.0, 1.0, 0.0]
    ckf("win_hann_3", hann3, want_hann3)

    // KAT 3: win_hann(5)[2] == 1.0 (center sample)
    // phase = 2*pi*2/4 = pi => cos(pi)=-1 => 0.5-0.5*(-1)=1.0
    let hann5 = win_hann(5)
    let hann5_center = hann5[2] * 1.0
    ckf1("win_hann_5_center", hann5_center, 1.0)

    // KAT 4: win_hamming(3) == [0.08, 1.0, 0.08]
    // w[0]=0.54-0.46*cos(0)=0.08, w[1]=0.54-0.46*cos(pi)=1.0, w[2]=0.08
    let hamm3 = win_hamming(3)
    let want_hamm3 = [0.08, 1.0, 0.08]
    ckf("win_hamming_3", hamm3, want_hamm3)

    // KAT 5: win_triangular(3) Bartlett zero-endpoint == [0.0, 1.0, 0.0]
    // w[i]=1-|2i/(n-1)-1|: w[0]=1-1=0, w[1]=1-0=1, w[2]=1-1=0
    let tri3 = win_triangular(3)
    let want_tri3 = [0.0, 1.0, 0.0]
    ckf("win_triangular_3", tri3, want_tri3)

    // KAT 6: win_apply([2.0,2.0,2.0], win_rectangular(3)) == [2.0,2.0,2.0]
    let sig = [2.0, 2.0, 2.0]
    let applied = win_apply(sig, rect3)
    let want_applied = [2.0, 2.0, 2.0]
    ckf("win_apply_rect", applied, want_applied)

    // KAT 7: len(win_blackman(8)) == 8
    let bk8 = win_blackman(8)
    let bk8len = len(bk8)
    if bk8len != 8
        print("FAIL win_blackman_8_len: got " + str(bk8len) + " want 8")
        exit(1)
    print("ok win_blackman_8_len")

    // KAT 8: win_blackman(1) == [1.0] (degenerate case)
    let bk1 = win_blackman(1)
    let want_bk1 = [1.0]
    ckf("win_blackman_1", bk1, want_bk1)

    print("_window_test passed")
