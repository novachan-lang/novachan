import std/httphdr/http_auth

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let g = "false"
        if got
            g = "true"
        let w = "false"
        if want
            w = "true"
        print("FAIL " + label + ": got=" + g + " want=" + w)
        exit(1)

fn ckl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL " + label + "[" + str(i) + "]: got='" + got[i] + "' want='" + want[i] + "'")
            exit(1)
        i = i + 1

fn main()
    // ── KAT vectors from the spec ────────────────────────────────────────────
    cks("scheme-bearer", hau_scheme("Bearer abc123"), "Bearer")
    cks("bearer-token", hau_bearer_token("Bearer abc123"), "abc123")
    cks("scheme-basic", hau_scheme("Basic dXNlcjpwYXNz"), "Basic")
    cks("credentials-basic", hau_credentials("Basic dXNlcjpwYXNz"), "dXNlcjpwYXNz")
    // base64 'dXNlcjpwYXNz' decodes to 'user:pass'
    ckl("parse-basic", hau_parse_basic("Basic dXNlcjpwYXNz"), ["user", "pass"])

    // ── hau_scheme edge cases ────────────────────────────────────────────────
    cks("scheme-empty", hau_scheme(""), "")
    cks("scheme-no-creds", hau_scheme("Bearer"), "Bearer")
    cks("scheme-digest", hau_scheme("Digest username=foo"), "Digest")
    cks("scheme-trim", hau_scheme("  Bearer token  "), "Bearer")

    // ── hau_credentials edge cases ───────────────────────────────────────────
    cks("creds-empty", hau_credentials(""), "")
    cks("creds-no-space", hau_credentials("Bearer"), "")
    cks("creds-digest", hau_credentials("Digest username=foo, realm=bar"), "username=foo, realm=bar")
    cks("creds-trim", hau_credentials("  Bearer   mytoken  "), "mytoken")

    // ── hau_bearer_token edge cases ──────────────────────────────────────────
    cks("bearer-empty", hau_bearer_token(""), "")
    cks("bearer-wrong-scheme", hau_bearer_token("Basic abc"), "")
    cks("bearer-case-insensitive", hau_bearer_token("bearer TOKEN"), "TOKEN")
    cks("bearer-just-bearer", hau_bearer_token("Bearer"), "")

    // ── hau_parse_basic edge cases ───────────────────────────────────────────
    // base64("admin:secret") = "YWRtaW46c2VjcmV0"
    ckl("parse-basic-admin", hau_parse_basic("Basic YWRtaW46c2VjcmV0"), ["admin", "secret"])
    // wrong scheme
    ckl("parse-basic-bad-scheme", hau_parse_basic("Bearer abc"), ["", ""])
    // empty
    ckl("parse-basic-empty", hau_parse_basic(""), ["", ""])
    // base64("user:") = "dXNlcjo=" -> user with empty password
    ckl("parse-basic-no-pass", hau_parse_basic("Basic dXNlcjo="), ["user", ""])
    // base64("a:b:c") = "YTpiOmM=" -> user=a, pass=b:c (split on first colon)
    ckl("parse-basic-colon-pass", hau_parse_basic("Basic YTpiOmM="), ["a", "b:c"])

    print("PASS _http_auth_test")
