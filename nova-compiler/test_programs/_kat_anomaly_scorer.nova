import forge_anomaly_scorer

fn main()
    let as_state = as_new(10)
    as_state = as_add_metric(as_state, "cpu")
    as_state = as_add_metric(as_state, "mem")
    assert(as_metric_count(as_state) == 2, "2 metrics")

    let r1 = as_record(as_state, "cpu", 50)
    as_state = unwrap(r1)
    let r2 = as_record(as_state, "cpu", 60)
    as_state = unwrap(r2)
    let r3 = as_record(as_state, "cpu", 55)
    as_state = unwrap(r3)
    assert(as_point_count(as_state) == 3, "3 points")

    let avg = as_metric_avg(as_state, "cpu")
    assert(unwrap(avg) == 55, "avg 55")

    let rng = as_metric_range(as_state, "cpu")
    assert(unwrap(rng) == 10, "range 10")

    let s1 = as_score(as_state, "cpu", 55)
    assert(unwrap(s1) == 0, "score 0 for avg")

    let s2 = as_score(as_state, "cpu", 70)
    assert(unwrap(s2) == 100, "score 100 far outside")

    let a1 = as_is_anomaly(as_state, "cpu", 70, 80)
    assert(unwrap(a1) == 1, "anomaly above threshold")

    let a2 = as_is_anomaly(as_state, "cpu", 56, 80)
    assert(unwrap(a2) == 0, "not anomaly below threshold")

    let f1 = as_flag_anomaly(as_state, "cpu")
    as_state = unwrap(f1)
    assert(as_anomaly_count(as_state) == 1, "1 anomaly flagged")

    let bad = as_record(as_state, "nope", 42)
    assert(is_err(bad), "unknown metric")

    let bad2 = as_metric_avg(as_state, "nope")
    assert(is_err(bad2), "unknown avg")

    print("ANOMALY-SCORER KAT PASS")
