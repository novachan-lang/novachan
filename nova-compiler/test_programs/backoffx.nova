// backoffx.nova — exponential backoff retry schedules (resilience).
//
// Computes how long to wait before each retry of a flaky operation (network
// call, lock acquisition, remote queue) so retries spread out instead of
// hammering — exponential growth base*2^attempt, capped at a maximum. The
// backbone of robust clients and distributed systems (NOVA's "robust" pillar).
// Deterministic; full-jitter variant included for thundering-herd avoidance.

fn backoff_delay(attempt, base, cap)
  let d = base
  let i = 0
  while i < attempt
    d = d * 2
    if d >= cap
      return cap
    i = i + 1
  if d > cap
    return cap
  d

// the delays for the first n attempts.
fn backoff_schedule(base, cap, n)
  let out = []
  let a = 0
  while a < n
    push(out, backoff_delay(a, base, cap))
    a = a + 1
  out

// total time spent waiting across n retries.
fn backoff_total(base, cap, n)
  let s = 0
  for d in backoff_schedule(base, cap, n)
    s = s + d
  s

// "full jitter": a deterministic pseudo-random delay in [0, backoff_delay] given
// a seed (AWS-style; spreads a herd of clients). Uses an LCG for reproducibility.
fn backoff_jitter(attempt, base, cap, seed)
  let ceil = backoff_delay(attempt, base, cap)
  if ceil <= 0
    return 0
  let r = (seed * 1103515245 + 12345) % 2147483648
  if r < 0
    r = r + 2147483648
  r % (ceil + 1)

// ── Tests ────────────────────────────────────────────────────────────

assert(backoff_delay(0, 100, 5000) == 100, "attempt 0 = base")
assert(backoff_delay(1, 100, 5000) == 200, "attempt 1 = 200")
assert(backoff_delay(2, 100, 5000) == 400, "attempt 2 = 400")
assert(backoff_delay(3, 100, 5000) == 800, "attempt 3 = 800")
assert(backoff_delay(10, 100, 5000) == 5000, "attempt 10 capped at 5000")
print("PASS: exponential growth + cap")

let sched = backoff_schedule(100, 5000, 8)
assert(len(sched) == 8, "8 delays")
assert(sched[0] == 100 and sched[1] == 200 and sched[2] == 400, "start 100,200,400")
assert(sched[6] == 5000 and sched[7] == 5000, "tail is capped at 5000")
print("PASS: schedule")

// 100+200+400+800+1600+3200+5000+5000 = 16300
assert(backoff_total(100, 5000, 8) == 16300, "total wait = 16300")
print("PASS: total wait")

// jitter stays within [0, delay] and is deterministic per seed
let j = backoff_jitter(3, 100, 5000, 42)
assert(j >= 0 and j <= 800, "jitter within [0, 800] for attempt 3")
assert(j == backoff_jitter(3, 100, 5000, 42), "deterministic per seed")
print("PASS: full jitter bounded + deterministic")

print("ALL PASS: backoffx — exponential backoff schedules")
