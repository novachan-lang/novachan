import std/semver/semver_sort

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let g = 0
    if got
        g = 1
    let w = 0
    if want
        w = 1
    if g != w
        print("FAIL " + label + ": got=" + str(g) + " want=" + str(w))
        exit(1)

fn main()
    // -- svso_sort: specified KAT vector ---------------------------------------
    let v1 = []
    push(v1, "1.2.0")
    push(v1, "1.0.0")
    push(v1, "1.10.0")
    push(v1, "1.2.0-alpha")
    let s1 = svso_sort(v1)
    cks("sort[0]", s1[0], "1.0.0")
    cks("sort[1]", s1[1], "1.2.0-alpha")
    cks("sort[2]", s1[2], "1.2.0")
    cks("sort[3]", s1[3], "1.10.0")
    cki("sort len", len(s1), 4)

    // -- svso_max / svso_min: specified KAT vectors ----------------------------
    let v2 = []
    push(v2, "1.0.0")
    push(v2, "2.0.0")
    push(v2, "1.5.0")
    cks("max", svso_max(v2), "2.0.0")
    cks("min", svso_min(v2), "1.0.0")

    // -- svso_rsort: specified KAT vector --------------------------------------
    let v3 = []
    push(v3, "1.0.0")
    push(v3, "2.0.0")
    push(v3, "1.5.0")
    let rs = svso_rsort(v3)
    cks("rsort[0]", rs[0], "2.0.0")
    cks("rsort[1]", rs[1], "1.5.0")
    cks("rsort[2]", rs[2], "1.0.0")

    // -- svso_max with numeric minor: specified KAT vector ---------------------
    let v4 = []
    push(v4, "1.10.0")
    push(v4, "1.9.0")
    cks("max_minor", svso_max(v4), "1.10.0")

    // -- Additional coverage ---------------------------------------------------

    // empty input
    let empty = []
    cks("max_empty", svso_max(empty), "")
    cks("min_empty", svso_min(empty), "")
    cki("sort_empty_len", len(svso_sort(empty)), 0)

    // singleton
    let single = []
    push(single, "3.0.0")
    cks("sort_single", svso_sort(single)[0], "3.0.0")
    cks("max_single",  svso_max(single), "3.0.0")
    cks("min_single",  svso_min(single), "3.0.0")

    // prerelease ordering: alpha < beta < rc < release
    let pre = []
    push(pre, "1.0.0")
    push(pre, "1.0.0-rc.1")
    push(pre, "1.0.0-alpha")
    push(pre, "1.0.0-beta.2")
    let sp = svso_sort(pre)
    cks("pre_sort[0]", sp[0], "1.0.0-alpha")
    cks("pre_sort[1]", sp[1], "1.0.0-beta.2")
    cks("pre_sort[2]", sp[2], "1.0.0-rc.1")
    cks("pre_sort[3]", sp[3], "1.0.0")

    // numeric prerelease: alpha.1 < alpha.2 < alpha.10
    let npre = []
    push(npre, "2.0.0-alpha.10")
    push(npre, "2.0.0-alpha.2")
    push(npre, "2.0.0-alpha.1")
    let snp = svso_sort(npre)
    cks("npre[0]", snp[0], "2.0.0-alpha.1")
    cks("npre[1]", snp[1], "2.0.0-alpha.2")
    cks("npre[2]", snp[2], "2.0.0-alpha.10")

    // rsort ordering
    let v5 = []
    push(v5, "1.0.0")
    push(v5, "1.0.0-alpha")
    push(v5, "2.0.0")
    let rs2 = svso_rsort(v5)
    cks("rsort2[0]", rs2[0], "2.0.0")
    cks("rsort2[1]", rs2[1], "1.0.0")
    cks("rsort2[2]", rs2[2], "1.0.0-alpha")

    // input not mutated by svso_sort
    let orig = []
    push(orig, "3.0.0")
    push(orig, "1.0.0")
    push(orig, "2.0.0")
    let sorted = svso_sort(orig)
    cks("orig[0] unmutated", orig[0], "3.0.0")
    cks("sorted[0]", sorted[0], "1.0.0")

    print("PASS _semver_sort_test")
