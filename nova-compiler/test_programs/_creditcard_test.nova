// _creditcard_test.nova — KAT for std/validation/creditcard
import std/validation/creditcard

fn ckb(label: string, got: bool, expected: bool)
    if got != expected
        let gs = "false"
        if got
            gs = "true"
        let es = "false"
        if expected
            es = "true"
        print("FAIL " + label + ": got " + gs + " expected " + es)
        exit(1)

fn cks(label: string, got: string, expected: string)
    if got != expected
        print("FAIL " + label + ": got [" + got + "] expected [" + expected + "]")
        exit(1)

fn main()
    // KAT 1: known-valid Visa 16-digit — Luhn passes
    ckb("visa_valid_16", vcc_is_valid("4532015112830366"), true)

    // KAT 2: same number with last digit flipped — Luhn fails
    ckb("visa_invalid_luhn", vcc_is_valid("4532015112830367"), false)

    // KAT 3: Visa with spaces — stripped to 16 digits, Luhn passes
    ckb("visa_with_spaces", vcc_is_valid("4111 1111 1111 1111"), true)

    // KAT 4: brand for canonical 16-digit Visa
    cks("brand_visa", vcc_brand("4111111111111111"), "visa")

    // KAT 5: brand for Mastercard 51-55 range (5500005555555559 is a known test number)
    cks("brand_mastercard", vcc_brand("5500005555555559"), "mastercard")

    // KAT 6: brand for Amex (starts 34 or 37, length 15; 340000000000009)
    cks("brand_amex", vcc_brand("340000000000009"), "amex")

    // KAT 7: brand for Discover (starts 6011, length 16)
    cks("brand_discover", vcc_brand("6011000000000004"), "discover")

    // KAT 8: mask replaces all but last 4 with '*'
    cks("mask_16", vcc_mask("4111111111111111"), "************1111")

    // KAT 9: mask with spaces in input (stripped first)
    cks("mask_spaces", vcc_mask("4111 1111 1111 1111"), "************1111")

    // KAT 10: too short (12 digits) — invalid
    ckb("too_short_12", vcc_is_valid("411111111111"), false)

    // KAT 11: too long (20 digits) — invalid
    ckb("too_long_20", vcc_is_valid("41111111111111111111"), false)

    // KAT 12: empty string — invalid
    ckb("empty", vcc_is_valid(""), false)

    // KAT 13: Amex is_valid check (340000000000009 — known Amex test number)
    ckb("amex_valid", vcc_is_valid("340000000000009"), true)

    // KAT 14: Discover is_valid check
    ckb("discover_valid", vcc_is_valid("6011000000000004"), true)

    // KAT 15: Mastercard is_valid check
    ckb("mastercard_valid", vcc_is_valid("5500005555555559"), true)

    // KAT 16: unknown brand (random digits not matching any prefix pattern)
    cks("brand_unknown", vcc_brand("9999999999999999"), "unknown")

    print("_creditcard_test passed")
