import forge_input_sanitizer

fn main()
    let s = san_new()
    s = san_set_max_length(s, 20)

    let r1 = san_sanitize(s, "hello world")
    s = r1["s"]
    assert(r1["output"] == "hello world", "clean input unchanged")
    assert(r1["stripped"] == 0, "not stripped")
    assert(r1["truncated"] == 0, "not truncated")

    let r2 = san_sanitize(s, "abcdefghijklmnopqrstuvwxyz")
    s = r2["s"]
    assert(len(r2["output"]) == 20, "truncated to 20")
    assert(r2["truncated"] == 1, "was truncated")

    let lt = chr(60)
    let gt = chr(62)
    let tagged = "a" + lt + "b" + gt + "c"
    let r3 = san_sanitize(s, tagged)
    s = r3["s"]
    assert(r3["output"] == "abc", "tags stripped")
    assert(r3["stripped"] == 1, "was stripped")

    assert(san_total_sanitized(s) == 3, "3 total")
    assert(san_total_truncated(s) == 1, "1 truncated")
    assert(san_total_stripped(s) == 1, "1 stripped")

    print("INPUT-SANITIZER KAT PASS")
