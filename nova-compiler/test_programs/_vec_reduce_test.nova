import std/vector/vec_reduce

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn ckl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + ": length mismatch got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL " + label + ": index " + str(i) + " got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // KAT 1: vr_gcd([4,6,8]) = 2
    let a1 = [4, 6, 8]
    cki("gcd_4_6_8", vr_gcd(a1), 2)

    // KAT 2: vr_primitive([4,6,8]) = [2,3,4]
    let a2 = [4, 6, 8]
    let r2 = vr_primitive(a2)
    ckl("primitive_4_6_8", r2, [2, 3, 4])

    // KAT 3: vr_is_primitive([2,3]) = true
    let a3 = [2, 3]
    ckb("is_primitive_2_3", vr_is_primitive(a3), true)

    // KAT 4: vr_is_primitive([2,4]) = false
    let a4 = [2, 4]
    ckb("is_primitive_2_4", vr_is_primitive(a4), false)

    // KAT 5: vr_gcd([0,0]) = 0
    let a5 = [0, 0]
    cki("gcd_0_0", vr_gcd(a5), 0)

    // KAT 6: vr_primitive([-6,9]) = [-2,3]
    let a6 = [-6, 9]
    let r6 = vr_primitive(a6)
    ckl("primitive_neg6_9", r6, [-2, 3])

    // KAT 7: vr_gcd([0,0]) primitive = [0,0]
    let a7 = [0, 0]
    let r7 = vr_primitive(a7)
    ckl("primitive_zero_vec", r7, [0, 0])

    // KAT 8: vr_gcd([3,3,3]) = 3
    let a8 = [3, 3, 3]
    cki("gcd_3_3_3", vr_gcd(a8), 3)

    // KAT 9: vr_is_primitive([1,0]) = true (gcd(1,0)=1)
    let a9 = [1, 0]
    ckb("is_primitive_1_0", vr_is_primitive(a9), true)

    // KAT 10: vr_gcd([12]) = 12
    let a10 = [12]
    cki("gcd_single_12", vr_gcd(a10), 12)

    // KAT 11: vr_primitive([-3,-6]) = [-1,-2]
    let a11 = [-3, -6]
    let r11 = vr_primitive(a11)
    ckl("primitive_neg3_neg6", r11, [-1, -2])

    print("PASS _vec_reduce_test")
