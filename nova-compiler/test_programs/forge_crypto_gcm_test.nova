// Forge crypto: AES-128-GCM, gated against the NIST GCM KATs (empty + single-block) + decrypt round-trip
// + tamper detection. Authenticated encryption -- the real prize. Socketless, deterministic.
import forge_crypto

fn _zeros(n: int) -> list
    let o = []
    let i = 0
    while i < n
        push(o, 0)
        i = i + 1
    o

fn main()
    let key = _zeros(16)
    let iv = _zeros(12)

    // (a) empty plaintext, empty AAD -> tag only
    let r0 = aes_gcm_encrypt(key, iv, [], [])
    if hex_of(r0[1]) != "58e2fccefa7e3061367f1d57a4e7455a"
        print("FAIL: GCM empty tag -> " + hex_of(r0[1]))
        exit(1)

    // (b) single zero block, empty AAD
    let r1 = aes_gcm_encrypt(key, iv, _zeros(16), [])
    if hex_of(r1[0]) != "0388dace60b6a392f328c2b971b2fe78"
        print("FAIL: GCM ct -> " + hex_of(r1[0]))
        exit(1)
    if hex_of(r1[1]) != "ab6e47d42cec13bdf53a67b21257bddf"
        print("FAIL: GCM tag -> " + hex_of(r1[1]))
        exit(1)

    // decrypt round-trip verifies the tag and recovers the plaintext
    let dec = aes_gcm_decrypt(key, iv, r1[0], [], r1[1])
    if dec[0] != true or hex_of(dec[1]) != hex_of(_zeros(16))
        print("FAIL: GCM decrypt round-trip")
        exit(1)

    // tamper: flip a tag byte -> auth must FAIL
    let badtag = []
    let i = 0
    while i < 16
        push(badtag, r1[1][i])
        i = i + 1
    badtag[0] = badtag[0] ^ 1
    let dec2 = aes_gcm_decrypt(key, iv, r1[0], [], badtag)
    if dec2[0] != false
        print("FAIL: GCM tamper must be rejected")
        exit(1)

    print("PASS forge_crypto_gcm (NIST GCM KATs + decrypt round-trip + tamper rejection)")
