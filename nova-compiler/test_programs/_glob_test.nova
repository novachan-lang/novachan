let counter = {}

fn inc(key: string)
    if contains(counter, key)
        counter[key] = counter[key] + 1
    else
        counter[key] = 1

fn get(key: string) -> int
    if contains(counter, key)
        counter[key]
    else
        0

fn main()
    inc("a")
    inc("a")
    inc("b")
    assert_eq(get("a"), 2)
    assert_eq(get("b"), 1)
    print("glob_test: all passed")
