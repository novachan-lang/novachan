import std/parsing/glob

fn main()
    // --- glob_match basic ---
    let r1 = glob_match("*.txt", "a.txt")
    if r1 == false
        print("FAIL glob r1: got false want true")
        exit(1)

    let r2 = glob_match("*.txt", "a.md")
    if r2 == true
        print("FAIL glob r2: got true want false")
        exit(1)

    let r3 = glob_match("a?c", "abc")
    if r3 == false
        print("FAIL glob r3: got false want true")
        exit(1)

    let r4 = glob_match("a?c", "ac")
    if r4 == true
        print("FAIL glob r4: got true want false")
        exit(1)

    // --- character class ---
    let r5 = glob_match("[a-c]x", "bx")
    if r5 == false
        print("FAIL glob r5: got false want true")
        exit(1)

    let r6 = glob_match("[a-c]x", "dx")
    if r6 == true
        print("FAIL glob r6: got true want false")
        exit(1)

    // --- negated class [!a] ---
    let r7 = glob_match("[!a]x", "bx")
    if r7 == false
        print("FAIL glob r7: got false want true")
        exit(1)

    let r8 = glob_match("[!a]x", "ax")
    if r8 == true
        print("FAIL glob r8: got true want false")
        exit(1)

    // --- ** path matching ---
    let r9 = glob_match("src/**/x", "src/a/b/x")
    if r9 == false
        print("FAIL glob r9 (src/**/x vs src/a/b/x): got false want true")
        exit(1)

    let r10 = glob_match("src/**/x", "src/x")
    if r10 == false
        print("FAIL glob r10 (src/**/x vs src/x): got false want true")
        exit(1)

    // * should NOT cross /
    let r11 = glob_match("src/*/x", "src/a/b/x")
    if r11 == true
        print("FAIL glob r11 (src/*/x vs src/a/b/x): got true want false")
        exit(1)

    let r12 = glob_match("src/*/x", "src/a/x")
    if r12 == false
        print("FAIL glob r12 (src/*/x vs src/a/x): got false want true")
        exit(1)

    // --- brace expansion ---
    // Build patterns using chr(123)='{' chr(125)='}'
    let lb = chr(123)
    let rb = chr(125)
    let be1pat = lb + "a,b" + rb + ".txt"
    let be1 = brace_expand(be1pat)
    let be1n = len(be1)
    if be1n != 2
        print("FAIL glob brace expand len: got " + str(be1n) + " want 2")
        exit(1)
    if be1[0] != "a.txt"
        print("FAIL glob brace expand [0]: got " + be1[0] + " want a.txt")
        exit(1)
    if be1[1] != "b.txt"
        print("FAIL glob brace expand [1]: got " + be1[1] + " want b.txt")
        exit(1)

    // brace expand with three alts
    let be2pat = lb + "x,y,z" + rb
    let be2 = brace_expand(be2pat)
    let be2n = len(be2)
    if be2n != 3
        print("FAIL glob brace3 len: got " + str(be2n) + " want 3")
        exit(1)

    // brace expand -- no braces
    let be3 = brace_expand("hello")
    if be3[0] != "hello"
        print("FAIL glob no-brace: got " + be3[0] + " want hello")
        exit(1)

    // brace match: {cat,dog}.txt
    let bmpat = lb + "cat,dog" + rb + ".txt"
    let rb1 = glob_match(bmpat, "cat.txt")
    if rb1 == false
        print("FAIL glob brace match cat: got false want true")
        exit(1)
    let rb2 = glob_match(bmpat, "dog.txt")
    if rb2 == false
        print("FAIL glob brace match dog: got false want true")
        exit(1)
    let rb3 = glob_match(bmpat, "bird.txt")
    if rb3 == true
        print("FAIL glob brace match bird: got true want false")
        exit(1)

    // --- glob_to_regex ---
    let re1 = glob_to_regex("*.txt")
    // Must contain ".*"
    let has_dotstar = 0
    let rlen = len(re1)
    let ri = 0
    while ri + 1 < rlen
        if slice(re1, ri, ri + 2) == ".*"
            has_dotstar = 1
        ri = ri + 1
    if has_dotstar == 0
        print("FAIL glob_to_regex *.txt missing .*: got " + re1)
        exit(1)

    // Must be anchored with ^
    if slice(re1, 0, 1) != "^"
        print("FAIL glob_to_regex missing ^ anchor: got " + re1)
        exit(1)

    // glob_to_regex for ** should produce .*
    let re2 = glob_to_regex("src/**/x")
    let has_dotstar2 = 0
    let rlen2 = len(re2)
    let ri2 = 0
    while ri2 + 1 < rlen2
        if slice(re2, ri2, ri2 + 2) == ".*"
            has_dotstar2 = 1
        ri2 = ri2 + 1
    if has_dotstar2 == 0
        print("FAIL glob_to_regex src/**/x missing .*: got " + re2)
        exit(1)

    // --- edge cases ---
    // empty pattern matches empty string
    let e1 = glob_match("", "")
    if e1 == false
        print("FAIL glob empty-empty: got false want true")
        exit(1)

    // empty pattern does not match non-empty
    let e2 = glob_match("", "a")
    if e2 == true
        print("FAIL glob empty-nonempty: got true want false")
        exit(1)

    // exact match
    let e3 = glob_match("hello", "hello")
    if e3 == false
        print("FAIL glob exact: got false want true")
        exit(1)

    // * matches empty suffix
    let e4 = glob_match("a*", "a")
    if e4 == false
        print("FAIL glob star-empty: got false want true")
        exit(1)

    print("PASS _glob_test")
