// _thermochem_test.nova — KAT for std/chem/thermochem
//
// Known-answer tests:
//   tc_heat_q(100.0, 4.18, 10.0)       = 100 * 4.18 * 10 = 4180.0 J
//   tc_enthalpy_change(-100.0, -50.0)   = -100 - (-50)   = -50.0 kJ/mol
//   tc_hess_sum([-100.0, 50.0, -25.0])  = -100 + 50 - 25 = -75.0 kJ/mol
//   tc_bond_energy_change(400.0, 500.0) = 400 - 500       = -100.0 kJ/mol (exothermic)

import std/chem/thermochem

fn approx(a: float, b: float) -> int
    let d = a - b
    let ad = d
    if d < 0.0
        ad = 0.0 - d
    let tol = 0.001
    if ad < tol
        return 1
    return 0

fn approx_rel(a: float, b: float, tol: float) -> int
    let d = a - b
    let ad = d
    if d < 0.0
        ad = 0.0 - d
    if ad < tol
        return 1
    return 0

fn main()
    // KAT 1: heat_q — q = m*c*dT = 100 * 4.18 * 10 = 4180.0
    let q1 = tc_heat_q(100.0, 4.18, 10.0)
    if approx_rel(q1, 4180.0, 0.01) == 0
        print("FAIL thermochem heat_q: got " + str(q1) + " expected 4180.0")
        exit(1)

    // KAT 2: enthalpy_change — products_h=-100, reactants_h=-50 -> delta=-50
    let dh1 = tc_enthalpy_change(-100.0, -50.0)
    if approx(dh1, -50.0) == 0
        print("FAIL thermochem enthalpy_change: got " + str(dh1) + " expected -50.0")
        exit(1)

    // KAT 3: hess_sum — [-100.0, 50.0, -25.0] = -75.0
    let hlist = [-100.0, 50.0, -25.0]
    let hs1 = tc_hess_sum(hlist)
    if approx(hs1, -75.0) == 0
        print("FAIL thermochem hess_sum: got " + str(hs1) + " expected -75.0")
        exit(1)

    // KAT 4: bond_energy_change — broken=400, formed=500 -> -100 (exothermic)
    let be1 = tc_bond_energy_change(400.0, 500.0)
    if approx(be1, -100.0) == 0
        print("FAIL thermochem bond_energy_change: got " + str(be1) + " expected -100.0")
        exit(1)

    // KAT 5: hess_sum with single element
    let hlist2 = [-200.0]
    let hs2 = tc_hess_sum(hlist2)
    if approx(hs2, -200.0) == 0
        print("FAIL thermochem hess_sum_single: got " + str(hs2) + " expected -200.0")
        exit(1)

    // KAT 6: enthalpy_change positive (endothermic)
    let dh2 = tc_enthalpy_change(50.0, -50.0)
    if approx(dh2, 100.0) == 0
        print("FAIL thermochem enthalpy_endothermic: got " + str(dh2) + " expected 100.0")
        exit(1)

    print("PASS _thermochem_test")
