// collatex -- human-friendly Unicode collation. The naive sort() orders strings by raw
// codepoint, so accented + non-ASCII letters sort in the wrong place (e-acute U+00E9 sorts
// AFTER z U+007A). collatex produces a PRIMARY collation key that (a) decomposes via NFD so a
// precomposed accent becomes base-letter + combining mark, (b) DROPS the combining marks, and
// (c) case-folds the base letter -- so e-acute sorts NEXT TO e and case is ignored at the
// primary level. Ties at the primary level break by original codepoint order, giving a stable,
// deterministic TOTAL order.
//
// COVERAGE: ASCII, Latin-1 / Latin-Extended accented forms (NFD decomposes them to base +
// combining mark), Greek, Cyrillic -- their primary weight is the case-folded, accent-stripped
// base letter. German sharp s folds to s at the primary level.
// DEFERRED (documented; an uncovered codepoint falls back to its own codepoint value -- a stable
// order, never a crash, just not human-collated): full UCA/DUCET multi-level weights, contractions
// (e.g. traditional Spanish "ll"), ligature expansion, and LOCALE tailoring. Those need the real
// UCD collation tables and are a follow-on.

// Combining Diacritical Marks U+0300..U+036F -- the accents NFD splits off Latin/Greek/Cyrillic.
fn _is_combining(c)
    c >= 768 and c <= 879

// Primary weight of a single (already accent-stripped) codepoint: fold case so upper and lower
// collate together. After NFD the input is a base letter, so only case folding is needed.
fn _fold_primary(c)
    if c >= 65 and c <= 90               // A-Z -> a-z
        return c + 32
    if c == 223                          // sharp s -> s (primary weight near s)
        return 115
    if c >= 913 and c <= 937 and c != 930 // Greek capitals -> smalls (skip the U+03A2 hole)
        return c + 32
    if c == 962                          // Greek final sigma -> sigma
        return 963
    if c >= 1040 and c <= 1071           // Cyrillic U+0410..U+042F caps -> smalls
        return c + 32
    if c >= 1024 and c <= 1039           // Cyrillic U+0400..U+040F caps -> U+0450..U+045F
        return c + 80
    return c

// collation_key(s): the primary sort key. Two strings have the same key iff they are equal
// ignoring case and diacritics. Compare keys with < / > for primary collation order.
fn collation_key(s)
    let d = normalize_nfd(s)
    let cps = code_points(d)
    let out = ""
    for c in cps
        if not _is_combining(c)
            out = out + from_codepoint(_fold_primary(c))
    out

// collate(a, b) -> -1 / 0 / 1 : human-friendly order. Primary by collation_key; ties break by
// original codepoint order so the result is a stable, deterministic total order.
fn collate(a, b)
    let ka = collation_key(a)
    let kb = collation_key(b)
    if ka < kb
        return -1
    if ka > kb
        return 1
    if a < b
        return -1
    if a > b
        return 1
    return 0

fn _merge(left, right)
    let out = []
    let i = 0
    let j = 0
    while i < len(left) and j < len(right)
        if collate(left[i], right[j]) <= 0
            push(out, left[i])
            i = i + 1
        else
            push(out, right[j])
            j = j + 1
    while i < len(left)
        push(out, left[i])
        i = i + 1
    while j < len(right)
        push(out, right[j])
        j = j + 1
    out

// collate_sort(xs): a stable merge sort of a list of strings in human-friendly collation order.
fn collate_sort(xs)
    if len(xs) <= 1
        return xs
    let mid = len(xs) / 2
    let left = []
    let right = []
    let i = 0
    while i < len(xs)
        if i < mid
            push(left, xs[i])
        else
            push(right, xs[i])
        i = i + 1
    _merge(collate_sort(left), collate_sort(right))
