import std/collections/setops
fn main()
    // negatives, zero, duplicates, empty string, long lists -- the constructible cases
    print(set_union([0, 0 - 5, 3], [3, 0 - 5, 9]))
    print(set_intersection([0, 0 - 5, 3], [3, 0 - 5, 9]))
    print(set_difference([0, 0 - 5, 3], [3, 0 - 5, 9]))
    print(set_symdiff([0, 0 - 5, 3], [3, 0 - 5, 9]))
    print(set_union(["", "a"], ["a", ""]))
    print(set_difference(["", "a"], [""]))
    print(is_subset([0], [0]))
    print(is_subset([0], []))
    print(set_equal([0, 0], [0]))
    // scale: this is where the old O(n^2) actually bit
    let big = [i % 500 for i in 0..4000]
    print(len(set_union(big, big)))
    print(len(set_intersection(big, big)))
    print(len(set_difference(big, big)))
    print(is_subset(big, big))
    print("PROBE-DONE")
