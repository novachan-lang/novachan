// KAT test for std/parsing/cli — command-line argument parser.
//
// Covers: long flags, short flags, --opt=value, --opt value, -o value,
// positionals (required + optional), defaults, required options, unknown
// option/flag errors, missing-required errors, subcommands, "--" separator,
// cli_help() formatting, and the accessor helpers.

import std/parsing/cli

fn main()
    let _c = [0, 0]   // [pass, fail]

    // ---- schema 1: a "build tool" style CLI --------------------------------
    // flags:   --verbose/-v
    // options: --output/-o (default "a.out"), --mode/-m (REQUIRED, no default)
    // positionals: <input> (required), [extra] (optional)
    let s1 = cli_schema()
    s1 = cli_flag(s1, "verbose", "v", "verbose output")
    s1 = cli_option(s1, "output", "o", "output path", "a.out")
    s1 = cli_option(s1, "mode", "m", "build mode", null)
    s1 = cli_positional(s1, "input", "input file", 1)
    s1 = cli_positional(s1, "extra", "extra file", 0)

    // check 1: long flag + long option=value + option value + positional
    let args1 = ["--verbose", "--mode=release", "-o", "out.bin", "main.nova"]
    let r1 = cli_parse(s1, args1)
    if is_ok(r1) == 1
        let p1 = unwrap(r1)
        if cli_get(p1, "verbose") == 1
            if cli_get(p1, "mode") == "release"
                if cli_get(p1, "output") == "out.bin"
                    if cli_get(p1, "input") == "main.nova"
                        _c[0] = _c[0] + 1
                        print("ok check1_flags_options_positional")
                    else
                        _c[1] = _c[1] + 1
                        print("FAIL check1: input")
                else
                    _c[1] = _c[1] + 1
                    print("FAIL check1: output")
            else
                _c[1] = _c[1] + 1
                print("FAIL check1: mode")
        else
            _c[1] = _c[1] + 1
            print("FAIL check1: verbose")
    else
        _c[1] = _c[1] + 1
        print("FAIL check1: expected ok, got err: " + unwrap_err(r1))

    // check 2: default value used when option absent; verbose absent -> 0
    let args2 = ["--mode=debug", "main.nova"]
    let r2 = cli_parse(s1, args2)
    if is_ok(r2) == 1
        let p2 = unwrap(r2)
        if cli_get(p2, "output") == "a.out"
            if cli_get(p2, "verbose") == 0
                _c[0] = _c[0] + 1
                print("ok check2_default_and_unset_flag")
            else
                _c[1] = _c[1] + 1
                print("FAIL check2: verbose should default to 0")
        else
            _c[1] = _c[1] + 1
            print("FAIL check2: output default wrong: " + str(cli_get(p2, "output")))
    else
        _c[1] = _c[1] + 1
        print("FAIL check2: expected ok, got err: " + unwrap_err(r2))

    // check 3: missing required option (mode) -> err
    let args3 = ["main.nova"]
    let r3 = cli_parse(s1, args3)
    if is_err(r3) == 1
        _c[0] = _c[0] + 1
        print("ok check3_missing_required_option")
    else
        _c[1] = _c[1] + 1
        print("FAIL check3: expected err for missing --mode")

    // check 4: missing required positional (input) -> err
    let args4 = ["--mode=debug"]
    let r4 = cli_parse(s1, args4)
    if is_err(r4) == 1
        _c[0] = _c[0] + 1
        print("ok check4_missing_required_positional")
    else
        _c[1] = _c[1] + 1
        print("FAIL check4: expected err for missing input")

    // check 5: unknown long option -> err
    let args5 = ["--mode=debug", "--bogus", "main.nova"]
    let r5 = cli_parse(s1, args5)
    if is_err(r5) == 1
        _c[0] = _c[0] + 1
        print("ok check5_unknown_long_option")
    else
        _c[1] = _c[1] + 1
        print("FAIL check5: expected err for --bogus")

    // check 6: unknown short flag -> err
    let args6 = ["--mode=debug", "-z", "main.nova"]
    let r6 = cli_parse(s1, args6)
    if is_err(r6) == 1
        _c[0] = _c[0] + 1
        print("ok check6_unknown_short_option")
    else
        _c[1] = _c[1] + 1
        print("FAIL check6: expected err for -z")

    // check 7: short flag -v combined with positionals; optional 'extra' filled
    let args7 = ["-v", "--mode=release", "main.nova", "readme.txt"]
    let r7 = cli_parse(s1, args7)
    if is_ok(r7) == 1
        let p7 = unwrap(r7)
        if cli_get(p7, "extra") == "readme.txt"
            if cli_has(p7, "extra") == 1
                _c[0] = _c[0] + 1
                print("ok check7_short_flag_and_extra_positional")
            else
                _c[1] = _c[1] + 1
                print("FAIL check7: cli_has extra")
        else
            _c[1] = _c[1] + 1
            print("FAIL check7: extra positional wrong")
    else
        _c[1] = _c[1] + 1
        print("FAIL check7: expected ok, got err: " + unwrap_err(r7))

    // check 8: cli_has is false for an optional positional never supplied
    let args8 = ["--mode=debug", "main.nova"]
    let r8 = cli_parse(s1, args8)
    if is_ok(r8) == 1
        let p8 = unwrap(r8)
        if cli_has(p8, "extra") == 0
            _c[0] = _c[0] + 1
            print("ok check8_has_false_for_unsupplied_optional")
        else
            _c[1] = _c[1] + 1
            print("FAIL check8: cli_has should be 0 for unsupplied extra")
    else
        _c[1] = _c[1] + 1
        print("FAIL check8: expected ok, got err: " + unwrap_err(r8))

    // check 9: cli_get_or returns fallback for a name never in the schema/values
    let p8b = unwrap(cli_parse(s1, args8))
    let got9 = cli_get_or(p8b, "nonexistent", "fallback")
    if got9 == "fallback"
        _c[0] = _c[0] + 1
        print("ok check9_get_or_fallback")
    else
        _c[1] = _c[1] + 1
        print("FAIL check9: cli_get_or fallback wrong: " + str(got9))

    // check 10: "--" separator — everything after it is positional/rest,
    // even things that look like flags.
    let args10 = ["--mode=debug", "main.nova", "extra.txt", "--", "-v", "--weird"]
    let r10 = cli_parse(s1, args10)
    if is_ok(r10) == 1
        let p10 = unwrap(r10)
        let rest10 = cli_rest(p10)
        if len(rest10) == 2
            if rest10[0] == "-v"
                if rest10[1] == "--weird"
                    _c[0] = _c[0] + 1
                    print("ok check10_separator_rest_verbatim")
                else
                    _c[1] = _c[1] + 1
                    print("FAIL check10: rest[1]")
            else
                _c[1] = _c[1] + 1
                print("FAIL check10: rest[0]")
        else
            _c[1] = _c[1] + 1
            print("FAIL check10: rest length " + str(len(rest10)))
    else
        _c[1] = _c[1] + 1
        print("FAIL check10: expected ok, got err: " + unwrap_err(r10))

    // check 11: extra positionals beyond declared ones land in cli_rest
    let args11 = ["--mode=debug", "main.nova", "extra.txt", "surplus1", "surplus2"]
    let r11 = cli_parse(s1, args11)
    if is_ok(r11) == 1
        let p11 = unwrap(r11)
        let rest11 = cli_rest(p11)
        if len(rest11) == 2
            if rest11[0] == "surplus1"
                if rest11[1] == "surplus2"
                    _c[0] = _c[0] + 1
                    print("ok check11_surplus_positionals_to_rest")
                else
                    _c[1] = _c[1] + 1
                    print("FAIL check11: rest[1]")
            else
                _c[1] = _c[1] + 1
                print("FAIL check11: rest[0]")
        else
            _c[1] = _c[1] + 1
            print("FAIL check11: rest length " + str(len(rest11)))
    else
        _c[1] = _c[1] + 1
        print("FAIL check11: expected ok, got err: " + unwrap_err(r11))

    // ---- schema 2: subcommands ---------------------------------------------
    let s2 = cli_schema()
    s2 = cli_subcommand(s2, "start", "start the service")
    s2 = cli_subcommand(s2, "stop", "stop the service")
    s2 = cli_flag(s2, "force", "f", "force the action")
    s2 = cli_positional(s2, "target", "target name", 1)

    // check 12: subcommand recognized, remaining args parsed against schema
    let args12 = ["start", "-f", "worker1"]
    let r12 = cli_parse(s2, args12)
    if is_ok(r12) == 1
        let p12 = unwrap(r12)
        if cli_sub(p12) == "start"
            if cli_get(p12, "force") == 1
                if cli_get(p12, "target") == "worker1"
                    _c[0] = _c[0] + 1
                    print("ok check12_subcommand_parsing")
                else
                    _c[1] = _c[1] + 1
                    print("FAIL check12: target")
            else
                _c[1] = _c[1] + 1
                print("FAIL check12: force flag")
        else
            _c[1] = _c[1] + 1
            print("FAIL check12: sub name got '" + cli_sub(p12) + "'")
    else
        _c[1] = _c[1] + 1
        print("FAIL check12: expected ok, got err: " + unwrap_err(r12))

    // check 13: first arg not a declared subcommand -> sub is "" and the arg
    // itself is treated as the positional
    let args13 = ["worker2"]
    let r13 = cli_parse(s2, args13)
    if is_ok(r13) == 1
        let p13 = unwrap(r13)
        if cli_sub(p13) == ""
            if cli_get(p13, "target") == "worker2"
                _c[0] = _c[0] + 1
                print("ok check13_no_subcommand_matched")
            else
                _c[1] = _c[1] + 1
                print("FAIL check13: target")
        else
            _c[1] = _c[1] + 1
            print("FAIL check13: expected empty sub, got '" + cli_sub(p13) + "'")
    else
        _c[1] = _c[1] + 1
        print("FAIL check13: expected ok, got err: " + unwrap_err(r13))

    // ---- cli_help ------------------------------------------------------------
    // check 14: help text mentions every flag/option/positional/subcommand name
    let help2 = cli_help(s2)
    if contains(help2, "start") == 1
        if contains(help2, "stop") == 1
            if contains(help2, "force the action") == 1
                if contains(help2, "target name") == 1
                    _c[0] = _c[0] + 1
                    print("ok check14_help_contains_all_fields")
                else
                    _c[1] = _c[1] + 1
                    print("FAIL check14: missing positional help")
            else
                _c[1] = _c[1] + 1
                print("FAIL check14: missing flag help")
        else
            _c[1] = _c[1] + 1
            print("FAIL check14: missing 'stop'")
    else
        _c[1] = _c[1] + 1
        print("FAIL check14: missing 'start'")

    // check 15: help text marks a required option as "required" and shows a
    // concrete default for one that has one.
    let help1 = cli_help(s1)
    if contains(help1, "required") == 1
        if contains(help1, "default: a.out") == 1
            _c[0] = _c[0] + 1
            print("ok check15_help_required_and_default")
        else
            _c[1] = _c[1] + 1
            print("FAIL check15: missing default annotation")
    else
        _c[1] = _c[1] + 1
        print("FAIL check15: missing required annotation")

    // check 16: --opt requires a value at end of args -> err
    let args16 = ["--mode=debug", "main.nova", "--output"]
    let r16 = cli_parse(s1, args16)
    if is_err(r16) == 1
        _c[0] = _c[0] + 1
        print("ok check16_option_requires_value")
    else
        _c[1] = _c[1] + 1
        print("FAIL check16: expected err for trailing --output with no value")

    // check 17: a flag given "=value" is rejected (flags take no value)
    let args17 = ["--mode=debug", "--verbose=1", "main.nova"]
    let r17 = cli_parse(s1, args17)
    if is_err(r17) == 1
        _c[0] = _c[0] + 1
        print("ok check17_flag_rejects_inline_value")
    else
        _c[1] = _c[1] + 1
        print("FAIL check17: expected err for --verbose=1")

    print("")
    print("PASS=" + str(_c[0]) + " FAIL=" + str(_c[1]))
    if _c[1] == 0
        print("ALL PASSED")
    else
        print("SOME FAILED")
        exit(1)
