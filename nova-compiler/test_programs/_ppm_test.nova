// KAT for std/media/ppm — Netpbm PPM (P6 binary + P3 ASCII) codec.
// Asserts: magic/header bytes, exact encode output, and encode->decode round-trips.
import std/media/ppm

fn _ck_int(label: string, got: int, want: int)
    if got != want
        print("FAIL ppm " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn _ck_str(label: string, got: string, want: string)
    if got != want
        print("FAIL ppm " + label + ": got '" + got + "' want '" + want + "'")
        exit(1)

fn main()
    // ── P6 encode: 1x1 pixel [10, 20, 30] ───────────────────────────────────
    // Expected: "P6\n1 1\n255\n" (11 bytes) then [10, 20, 30] (3 bytes) = 14 total
    let px1 = [10, 20, 30]
    let enc1 = ppm_p6_encode(1, 1, px1)

    // (a) exact byte-length == 14
    _ck_int("p6_1x1_len", bytes_len(enc1), 14)

    // (b) first 11 bytes as string == "P6\n1 1\n255\n"
    // Build expected from bytes to avoid NUL-truncation (no NUL here, but use bytes for safety)
    let hdr = ""
    let i = 0
    while i < 11
        hdr = hdr + chr(bytes_get(enc1, i))
        i = i + 1
    _ck_str("p6_1x1_header", hdr, "P6\n1 1\n255\n")

    // (c) pixel bytes at offsets 11, 12, 13
    _ck_int("p6_1x1_R", bytes_get(enc1, 11), 10)
    _ck_int("p6_1x1_G", bytes_get(enc1, 12), 20)
    _ck_int("p6_1x1_B", bytes_get(enc1, 13), 30)

    // ── P6 decode: round-trip on 1x1 ────────────────────────────────────────
    let dec1 = ppm_p6_decode(enc1)
    _ck_int("p6_rt_w", dec1["w"], 1)
    _ck_int("p6_rt_h", dec1["h"], 1)
    let dpx1 = dec1["px"]
    _ck_int("p6_rt_R", dpx1[0], 10)
    _ck_int("p6_rt_G", dpx1[1], 20)
    _ck_int("p6_rt_B", dpx1[2], 30)

    // ── P6 encode: 2x1 (two pixels) round-trip ──────────────────────────────
    // px: [255, 0, 0, 0, 255, 128]  (red pixel, green-ish pixel)
    let px2 = [255, 0, 0, 0, 255, 128]
    let enc2 = ppm_p6_encode(2, 1, px2)
    // header "P6\n2 1\n255\n" = 11 bytes + 6 pixel bytes = 17 total
    _ck_int("p6_2x1_len", bytes_len(enc2), 17)
    let dec2 = ppm_p6_decode(enc2)
    _ck_int("p6_2x1_w", dec2["w"], 2)
    _ck_int("p6_2x1_h", dec2["h"], 1)
    let dpx2 = dec2["px"]
    _ck_int("p6_2x1_R0", dpx2[0], 255)
    _ck_int("p6_2x1_G0", dpx2[1], 0)
    _ck_int("p6_2x1_B0", dpx2[2], 0)
    _ck_int("p6_2x1_R1", dpx2[3], 0)
    _ck_int("p6_2x1_G1", dpx2[4], 255)
    _ck_int("p6_2x1_B1", dpx2[5], 128)

    // ── P6 decode: malformed input returns empty dict ────────────────────────
    let bad = bytes(0)
    bad = bytes_append(bad, 80)
    bad = bytes_append(bad, 51)   // "P3" magic (wrong for P6)
    bad = bytes_append(bad, 10)
    let badec = ppm_p6_decode(bad)
    let bad_has_w = contains(badec, "w")
    _ck_int("p6_bad_magic_empty", bad_has_w, 0)

    // ── P3 round-trip: 2x1 pixel ────────────────────────────────────────────
    let px3 = [100, 150, 200, 50, 25, 0]
    let enc3 = ppm_p3_encode(2, 1, px3)
    // Must start with "P3\n"
    let hdr3 = ""
    let j = 0
    while j < 3
        hdr3 = hdr3 + char_at(enc3, j)
        j = j + 1
    _ck_str("p3_magic", hdr3, "P3\n")
    // Decode back
    let dec3 = ppm_p3_decode(enc3)
    _ck_int("p3_rt_w", dec3["w"], 2)
    _ck_int("p3_rt_h", dec3["h"], 1)
    let dpx3 = dec3["px"]
    _ck_int("p3_rt_R0", dpx3[0], 100)
    _ck_int("p3_rt_G0", dpx3[1], 150)
    _ck_int("p3_rt_B0", dpx3[2], 200)
    _ck_int("p3_rt_R1", dpx3[3], 50)
    _ck_int("p3_rt_G1", dpx3[4], 25)
    _ck_int("p3_rt_B1", dpx3[5], 0)

    // ── P3 decode: bad magic returns empty dict ──────────────────────────────
    let baddec3 = ppm_p3_decode("P6\n1 1\n255\n0 0 0\n")
    let bad3_has_w = contains(baddec3, "w")
    _ck_int("p3_bad_magic_empty", bad3_has_w, 0)

    // ── P3 decode: 1x1 known P3 string ──────────────────────────────────────
    let p3s = "P3\n1 1\n255\n10 20 30\n"
    let dec4 = ppm_p3_decode(p3s)
    _ck_int("p3_known_w", dec4["w"], 1)
    _ck_int("p3_known_h", dec4["h"], 1)
    let dpx4 = dec4["px"]
    _ck_int("p3_known_R", dpx4[0], 10)
    _ck_int("p3_known_G", dpx4[1], 20)
    _ck_int("p3_known_B", dpx4[2], 30)

    print("PASS _ppm_test")
