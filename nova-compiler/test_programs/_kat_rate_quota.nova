import forge_rate_quota

fn main()
    let rq = rq_new()
    rq = rq_set_quota(rq, "api:tenant1", 5, 60)
    rq = rq_set_quota(rq, "api:tenant2", 10, 60)

    assert(rq_is_allowed(rq, "api:tenant1") == 1, "initially allowed")
    assert(rq_remaining(rq, "api:tenant1") == 5, "5 remaining")

    rq = rq_record(rq, "api:tenant1", 100)
    rq = rq_record(rq, "api:tenant1", 101)
    rq = rq_record(rq, "api:tenant1", 102)
    assert(rq_usage(rq, "api:tenant1") == 3, "3 used")
    assert(rq_remaining(rq, "api:tenant1") == 2, "2 remaining")
    assert(rq_is_allowed(rq, "api:tenant1") == 1, "still allowed")

    rq = rq_record(rq, "api:tenant1", 103)
    rq = rq_record(rq, "api:tenant1", 104)
    assert(rq_is_allowed(rq, "api:tenant1") == 0, "at limit")
    assert(rq_remaining(rq, "api:tenant1") == 0, "0 remaining")

    rq = rq_record(rq, "api:tenant1", 105)
    assert(rq_violation_count(rq) == 1, "1 violation")
    let v = rq_violations(rq)
    assert(v[0]["key"] == "api:tenant1", "violation key")
    assert(v[0]["limit"] == 5, "violation limit")

    rq = rq_record(rq, "api:tenant1", 200)
    assert(rq_usage(rq, "api:tenant1") == 1, "window reset at 200")
    assert(rq_is_allowed(rq, "api:tenant1") == 1, "allowed after reset")
    assert(rq_remaining(rq, "api:tenant1") == 4, "4 remaining after reset")

    assert(rq_is_allowed(rq, "unknown_key") == 1, "unknown=allowed")
    assert(rq_remaining(rq, "unknown_key") == 0, "unknown=0 remaining")

    rq = rq_record(rq, "api:tenant2", 100)
    rq = rq_record(rq, "api:tenant2", 101)
    assert(rq_usage(rq, "api:tenant2") == 2, "tenant2 2 used")

    rq = rq_reset(rq, "api:tenant2")
    assert(rq_usage(rq, "api:tenant2") == 0, "tenant2 reset")

    print("RATE-QUOTA KAT PASS")
