fn main()
    let pi = 3.14
    let r1 = pi + 1
    let r2 = pi * 2
    let r3 = pi - 1
    let r4 = pi / 2
    let r5 = 10 - pi
    let r6 = 100 / pi
    assert(r1 > 4.0, "pi+1 should be > 4")
    assert(r1 < 4.2, "pi+1 should be < 4.2")
    assert(r2 > 6.2, "pi*2 should be > 6.2")
    assert(r2 < 6.3, "pi*2 should be < 6.3")
    assert(r3 > 2.1, "pi-1 should be > 2.1")
    assert(r3 < 2.2, "pi-1 should be < 2.2")
    assert(r4 > 1.5, "pi/2 should be > 1.5")
    assert(r4 < 1.6, "pi/2 should be < 1.6")
    assert(r5 > 6.8, "10-pi should be > 6.8")
    assert(r5 < 6.9, "10-pi should be < 6.9")
    assert(r6 > 31.0, "100/pi should be > 31")
    assert(r6 < 32.0, "100/pi should be < 32")
    // str() on float results
    let s = str(r1)
    assert(contains(s, "4.1"), "str(pi+1) should contain 4.1")
    // Comparison operators with mixed types
    assert(pi > 3, "pi > 3")
    assert(pi < 4, "pi < 4")
    assert(5 > pi, "5 > pi")
    assert(2 < pi, "2 < pi")
    assert(pi >= 3, "pi >= 3")
    assert(pi <= 4, "pi <= 4")
    // Type cascading through variables
    let doubled = pi * 2
    let tripled = doubled + pi
    assert(tripled > 9.4, "tripled > 9.4")
    assert(tripled < 9.5, "tripled < 9.5")
    print("mixed_arith_test: all passed")
