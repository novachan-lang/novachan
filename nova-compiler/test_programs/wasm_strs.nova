// WASM string test: reverse a string char-by-char, concatenate in a loop, print results.
// Expected output (deterministic):
//   dlrow olleh
//   aaaaa
//   12345
//   5
fn main()
    // 1. Reverse "hello world" char by char
    let s = "hello world"
    let rev = ""
    let i = len(s) - 1
    while i >= 0
        rev = rev + s[i]
        i = i - 1
    print(rev)

    // 2. Build a string by repeated concatenation
    let acc = ""
    let j = 0
    while j < 5
        acc = acc + "a"
        j = j + 1
    print(acc)

    // 3. Convert integers to string and concatenate
    let nums = ""
    let k = 1
    while k <= 5
        nums = nums + str(k)
        k = k + 1
    print(nums)

    // 4. Print the length of a string
    print(str(len("hello")))
