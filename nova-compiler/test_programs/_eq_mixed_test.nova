// _eq_mixed_test.nova -- pins the eq/neq soundness fix: comparing a DYNAMIC value (any/val) that
// holds a NON-string against a string with == / != must NOT crash. Before the fix, the eq/neq
// lowering took the raw strcmp path whenever EITHER operand was str (`str OR str`), so a dynamic
// operand holding an int (e.g. dict["missing"] -> 0) was inttoptr'd and strcmp'd -> segfault. The fix
// (`str AND str`) routes str-vs-dynamic to the box-aware nova_rt_eq/nova_rt_neq, which tag-checks
// (a small-int operand is simply not-equal to a string). This is an extremely common pattern:
// any looked-up header/query/config/JSON value compared to a string literal.
fn main()
    let d = {}
    d["k"] = "hello"

    // (1) missing key -> int 0 (dynamic), compared to a string: must be unequal, no crash.
    let miss = d["missing"]
    assert(miss != "hello", "any(0) != str is true")
    assert(not (miss == "hello"), "any(0) == str is false")

    // (2) present key -> string held in a dynamic slot, compared to strings: correct equality.
    let hit = d["k"]
    assert(hit == "hello", "any(str) == matching str")
    assert(hit != "world", "any(str) != different str")

    // (3) nested-dict value (dynamic) vs string.
    let cfg = {}
    cfg["mode"] = "prod"
    let m = cfg["mode"]
    assert(m == "prod", "any(str) == prod")
    let absent = cfg["debug"]
    assert(absent != "true", "absent config any(0) != 'true', no crash")

    // (4) list element (dynamic) vs string.
    let xs = ["a", "b"]
    assert(xs[0] == "a", "list any(str) == a")
    assert(xs[1] != "a", "list any(str) != a")

    // (5) plain typed strings still use the fast path and stay correct.
    let s = "secret"
    assert(s == "secret", "str == str")
    assert(s != "other", "str != other")

    print("eq_mixed_test passed (any-vs-string == / != is box-aware, no deref crash)")
