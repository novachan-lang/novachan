// Fan-out / fan-in: spawn N workers, each doing independent work,
// collect all results. Demonstrates NOVA's Erlang-style concurrency —
// process isolation + channels = safe parallelism without locks.

fn is_prime(n)
    if n < 2
        return 0
    let d = 2
    while d * d <= n
        if n % d == 0
            return 0
        d = d + 1
    return 1

fn find_primes(start, end, result_ch)
    let primes = []
    let n = start
    while n <= end
        if is_prime(n) == 1
            push(primes, n)
        n = n + 1
    send(result_ch, primes)

fn main()
    let ch = channel()

    // Fan out: 5 workers each search a range for primes
    spawn find_primes(2, 20, ch)
    spawn find_primes(21, 40, ch)
    spawn find_primes(41, 60, ch)
    spawn find_primes(61, 80, ch)
    spawn find_primes(81, 100, ch)

    // Fan in: collect all prime lists
    let all_primes = []
    let i = 0
    while i < 5
        let batch = receive(ch)
        let j = 0
        while j < len(batch)
            push(all_primes, batch[j])
            j = j + 1
        i = i + 1

    sort(all_primes)
    print("primes up to 100: " + str(all_primes))
    assert(len(all_primes) == 25, "there are 25 primes <= 100, got " + str(len(all_primes)))
    assert(all_primes[0] == 2, "first prime")
    assert(all_primes[24] == 97, "last prime")

    print("mt_fanout_test: PASSED — 5 workers found " + str(len(all_primes)) + " primes concurrently")
