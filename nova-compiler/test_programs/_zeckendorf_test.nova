import std/numeral/zeckendorf

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL zeckendorf " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL zeckendorf " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL zeckendorf " + label + " len: got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL zeckendorf " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // zk_encode KAT
    let e0 = zk_encode(0)
    ckl("encode(0)", e0, [])

    let e1 = zk_encode(1)
    let w1 = []
    w1.push(1)
    ckl("encode(1)", e1, w1)

    let e4 = zk_encode(4)
    let w4 = []
    w4.push(3)
    w4.push(1)
    ckl("encode(4)", e4, w4)

    let e10 = zk_encode(10)
    let w10 = []
    w10.push(8)
    w10.push(2)
    ckl("encode(10)", e10, w10)

    let e100 = zk_encode(100)
    let w100 = []
    w100.push(89)
    w100.push(8)
    w100.push(3)
    ckl("encode(100)", e100, w100)

    // zk_decode KAT
    let d100 = []
    d100.push(89)
    d100.push(8)
    d100.push(3)
    cki("decode([89,8,3])", zk_decode(d100), 100)

    // Round-trip: zk_decode(zk_encode(1000)) == 1000
    cki("roundtrip(1000)", zk_decode(zk_encode(1000)), 1000)

    // Additional round-trips
    cki("roundtrip(1)", zk_decode(zk_encode(1)), 1)
    cki("roundtrip(2)", zk_decode(zk_encode(2)), 2)
    cki("roundtrip(7)", zk_decode(zk_encode(7)), 7)
    cki("roundtrip(500)", zk_decode(zk_encode(500)), 500)
    cki("roundtrip(9999)", zk_decode(zk_encode(9999)), 9999)

    // zk_is_valid KAT
    let valid1 = []
    valid1.push(89)
    valid1.push(8)
    valid1.push(3)
    if not zk_is_valid(valid1)
        print("FAIL zeckendorf is_valid([89,8,3]): got=false want=true")
        exit(1)

    let invalid1 = []
    invalid1.push(8)
    invalid1.push(5)
    if zk_is_valid(invalid1)
        print("FAIL zeckendorf is_valid([8,5]): got=true want=false")
        exit(1)

    // Empty list is valid (represents 0)
    if not zk_is_valid([])
        print("FAIL zeckendorf is_valid([]): got=false want=true")
        exit(1)

    // Non-Fibonacci number -> invalid
    let invalid2 = []
    invalid2.push(10)
    if zk_is_valid(invalid2)
        print("FAIL zeckendorf is_valid([10]): got=true want=false")
        exit(1)

    // Not descending -> invalid
    let invalid3 = []
    invalid3.push(3)
    invalid3.push(8)
    if zk_is_valid(invalid3)
        print("FAIL zeckendorf is_valid([3,8] ascending): got=true want=false")
        exit(1)

    // [3,1] is valid (indices differ by 2: index of 3 is 2, index of 1 is 0)
    let valid2 = []
    valid2.push(3)
    valid2.push(1)
    if not zk_is_valid(valid2)
        print("FAIL zeckendorf is_valid([3,1]): got=false want=true")
        exit(1)

    // [2,1] is invalid: 2 and 1 are consecutive Fibonacci (indices 1 and 0)
    let invalid4 = []
    invalid4.push(2)
    invalid4.push(1)
    if zk_is_valid(invalid4)
        print("FAIL zeckendorf is_valid([2,1]): got=true want=false")
        exit(1)

    // All encoded values up to 100 should be valid
    let n = 1
    while n <= 100
        let enc = zk_encode(n)
        if not zk_is_valid(enc)
            print("FAIL zeckendorf is_valid(zk_encode(" + str(n) + ")): got=false want=true")
            exit(1)
        n = n + 1

    print("PASS _zeckendorf_test")
