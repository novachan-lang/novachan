// KAT test for std/data/tabular
import std/data/tabular

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got [" + got + "] expected [" + expected + "]")
        exit(1)

fn main()
    // Canonical rows from spec
    let rows = [{"n":"a","v":"3"},{"n":"b","v":"1"},{"n":"a","v":"2"}]

    // KAT 1: tb_columns returns sorted union of keys
    let cols = tb_columns(rows)
    cki("columns_len", len(cols), 2)
    cks("columns_0", cols[0], "n")
    cks("columns_1", cols[1], "v")

    // KAT 2: tb_filter by "n"=="a" returns 2 rows
    let filtered = tb_filter(rows, "n", "a")
    cki("filter_count", len(filtered), 2)

    // KAT 3: tb_select projects to only listed columns
    let sel_cols = ["n"]
    let selected = tb_select(rows, sel_cols)
    // First row should have "n"=="a" and no "v" key
    let sel_row0 = selected[0]
    cks("select_n_val", sel_row0["n"], "a")
    cki("select_no_v", contains(sel_row0, "v"), 0)

    // KAT 4: tb_group_count groups by "n"
    let gc = tb_group_count(rows, "n")
    cki("group_a", gc["a"], 2)
    cki("group_b", gc["b"], 1)

    // KAT 5: tb_sort_by "v" ascending — "1" < "2" < "3" (string compare)
    let sorted = tb_sort_by(rows, "v")
    cks("sort_first_v", sorted[0]["v"], "1")
    cks("sort_last_v", sorted[2]["v"], "3")

    // KAT 6: tb_to_matrix with cols ["a","b"]
    let mat_rows = [{"a":"1","b":"2"}]
    let mat_cols = ["a","b"]
    let matrix = tb_to_matrix(mat_rows, mat_cols)
    cki("matrix_rows", len(matrix), 1)
    let mat_row0 = matrix[0]
    cki("matrix_cols", len(mat_row0), 2)
    cks("matrix_0_0", mat_row0[0], "1")
    cks("matrix_0_1", mat_row0[1], "2")

    // KAT 7: tb_to_matrix with missing column fills ""
    let sparse_rows = [{"a":"x"}]
    let mat_cols2 = ["a","b"]
    let sparse_matrix = tb_to_matrix(sparse_rows, mat_cols2)
    let sparse_row0 = sparse_matrix[0]
    cks("matrix_missing", sparse_row0[1], "")

    // KAT 8: tb_filter on nonexistent key returns empty list
    let no_match = tb_filter(rows, "z", "foo")
    cki("filter_no_key", len(no_match), 0)

    // KAT 9: tb_columns on empty list returns empty list
    let empty_rows = []
    let empty_cols = tb_columns(empty_rows)
    cki("columns_empty", len(empty_cols), 0)

    // KAT 10: tb_sort_by rows with missing key — missing rows sort last
    let mixed_rows = [{"k":"b"},{"k":"a"},{}]
    let mixed_sorted = tb_sort_by(mixed_rows, "k")
    cks("sort_missing_last_0", mixed_sorted[0]["k"], "a")
    cks("sort_missing_last_1", mixed_sorted[1]["k"], "b")
    cki("sort_missing_last_2_no_k", contains(mixed_sorted[2], "k"), 0)

    print("_tabular_test passed")
