import std/text/worddiff

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + got + " expected=" + expected)
        exit(1)

fn ckl(label, got, expected)
    // Compare two lists of strings by checking length then each element.
    if len(got) != len(expected)
        print("FAIL " + label + ": length got=" + str(len(got)) + " expected=" + str(len(expected)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != expected[i]
            print("FAIL " + label + "[" + str(i) + "]: got=" + got[i] + " expected=" + expected[i])
            exit(1)
        i = i + 1

fn main()
    // ── wd_words ─────────────────────────────────────────────────────────────

    // KAT 1: basic split
    let w1 = wd_words("hello world foo")
    let e1 = ["hello", "world", "foo"]
    ckl("wd_words basic", w1, e1)

    // KAT 2: single word (no spaces)
    let w2 = wd_words("alone")
    let e2 = ["alone"]
    ckl("wd_words single", w2, e2)

    // KAT 3: empty string -> empty list
    let w3 = wd_words("")
    let e3 = []
    ckl("wd_words empty", w3, e3)

    // ── wd_diff ──────────────────────────────────────────────────────────────

    // KAT 4: spec example — one substitution in the middle
    let d4 = wd_diff("the quick fox", "the slow fox")
    let e4 = [" the", "-quick", "+slow", " fox"]
    ckl("wd_diff quick->slow", d4, e4)

    // KAT 5: identical strings — all common
    let d5 = wd_diff("a b", "a b")
    let e5 = [" a", " b"]
    ckl("wd_diff identical", d5, e5)

    // KAT 6: empty a, non-empty b — all additions
    let d6 = wd_diff("", "x")
    let e6 = ["+x"]
    ckl("wd_diff empty->x", d6, e6)

    // KAT 7: non-empty a, empty b — all deletions
    let d7 = wd_diff("x", "")
    let e7 = ["-x"]
    ckl("wd_diff x->empty", d7, e7)

    // KAT 8: deletion of middle word
    let d8 = wd_diff("a b c", "a c")
    let e8 = [" a", "-b", " c"]
    ckl("wd_diff delete middle", d8, e8)

    // KAT 9: both empty — empty result
    let d9 = wd_diff("", "")
    let e9 = []
    ckl("wd_diff both empty", d9, e9)

    // KAT 10: pure insertion — all words added
    let d10 = wd_diff("", "one two three")
    let e10 = ["+one", "+two", "+three"]
    ckl("wd_diff pure insert", d10, e10)

    // KAT 11: pure deletion — all words removed
    let d11 = wd_diff("one two three", "")
    let e11 = ["-one", "-two", "-three"]
    ckl("wd_diff pure delete", d11, e11)

    print("_worddiff_test passed")
