import std/math/ts_ewma

fn approx(a: float, b: float, tol: float) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < tol
        return 1
    return 0

fn check_list(label: str, got: list, want: list, tol: float)
    if len(got) != len(want)
        print("FAIL " + label + " len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        let g = got[i] * 1.0
        let w = want[i] * 1.0
        if approx(g, w, tol) == 0
            print("FAIL " + label + "[" + str(i) + "] got=" + str(g) + " want=" + str(w))
            exit(1)
        i = i + 1

fn main()
    // KAT 1: ts_ewma([1,2,3], 0.5)
    // y[0]=1.0, y[1]=0.5*2+0.5*1=1.5, y[2]=0.5*3+0.5*1.5=2.25
    let d1 = [1.0, 2.0, 3.0]
    let r1 = ts_ewma(d1, 0.5)
    let want1 = [1.0, 1.5, 2.25]
    check_list("ts_ewma alpha=0.5", r1, want1, 0.0001)

    // KAT 2: alpha=1.0 -> output equals input
    let d2 = [3.0, 1.0, 4.0, 1.0, 5.0]
    let r2 = ts_ewma(d2, 1.0)
    let want2 = [3.0, 1.0, 4.0, 1.0, 5.0]
    check_list("ts_ewma alpha=1.0", r2, want2, 0.0001)

    // KAT 3: alpha=0.0 -> constant first value
    let d3 = [7.0, 2.0, 9.0]
    let r3 = ts_ewma(d3, 0.0)
    let want3 = [7.0, 7.0, 7.0]
    check_list("ts_ewma alpha=0.0", r3, want3, 0.0001)

    // KAT 4: empty list -> []
    let d4 = []
    let r4 = ts_ewma(d4, 0.5)
    if len(r4) != 0
        print("FAIL ts_ewma empty len=" + str(len(r4)))
        exit(1)

    // KAT 5: single element -> same element
    let d5 = [42.0]
    let r5 = ts_ewma(d5, 0.5)
    let want5 = [42.0]
    check_list("ts_ewma single", r5, want5, 0.0001)

    // KAT 6: alpha=0.3 longer series — verify accumulation
    // d=[10,20,30], y[0]=10, y[1]=0.3*20+0.7*10=6+7=13, y[2]=0.3*30+0.7*13=9+9.1=18.1
    let d6 = [10.0, 20.0, 30.0]
    let r6 = ts_ewma(d6, 0.3)
    let want6 = [10.0, 13.0, 18.1]
    check_list("ts_ewma alpha=0.3", r6, want6, 0.0001)

    print("PASS _ts_ewma_test")
