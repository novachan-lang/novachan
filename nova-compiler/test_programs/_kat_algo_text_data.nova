// _kat_algo_text_data — combined KAT for 6 new pure-NOVA stdlib modules.
//
// NOTE ON THE ORIGINAL TASK SPEC: the originally requested modules
// (dijkstra, astar, diff, ringbuffer, levenshtein, bloom_filter) ALL turned
// out to be pre-existing duplicates (std/graph/dijkstra.nova,
// std/graph/astar.nova, std/text/diff*.nova + worddiff.nova,
// std/collections/ring_buffer.nova + circularbuf.nova,
// std/text/distance.nova's d_levenshtein + strx.nova's levenshtein,
// std/collections/bloomfilter.nova). Per the mandatory pre-build duplicate
// survey, each was substituted with a genuinely new, non-overlapping module:
//
//   std/algo/wordladder.nova        (new)  prefix wl_    substitutes dijkstra
//   std/statistics/tdigest.nova     (new)  prefix td_    substitutes astar
//   std/text/rollinghash.nova       (new)  prefix rh_    substitutes diff
//   std/collections/cuckoohash.nova (new)  prefix ckh_   substitutes ringbuffer
//   std/collections/dsu_rollback.nova (new) prefix dsur_ substitutes levenshtein
//   std/cache/ttlcache.nova         (new)  prefix ttlc_  substitutes bloom_filter

import std/algo/wordladder
import std/statistics/tdigest
import std/text/rollinghash
import std/collections/cuckoohash
import std/collections/dsu_rollback
import std/cache/ttlcache

fn ck(name, got, want)
    if str(got) != str(want)
        print("FAIL " + name + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("ok " + name)

// ckf: tolerance-based float check (avoids exact-string-match flakiness on
// floating point formatting).
fn ckf(name, got, want, tol)
    let d = got - want
    if d < 0.0
        d = 0.0 - d
    if d > tol
        print("FAIL " + name + ": got " + str(got) + " want " + str(want) + " tol " + str(tol))
        exit(1)
    print("ok " + name)

fn main()
    // ================================================================
    // std/algo/wordladder  (prefix wl_)
    // ================================================================
    let dict1 = ["hot", "dot", "dog", "lot", "log", "cog"]

    ck("wl_is_neighbor hot/dot", wl_is_neighbor("hot", "dot"), true)
    ck("wl_is_neighbor hot/dog", wl_is_neighbor("hot", "dog"), false)
    ck("wl_is_neighbor diff length", wl_is_neighbor("cat", "cats"), false)
    ck("wl_is_neighbor identical", wl_is_neighbor("dog", "dog"), false)

    let dog_nbrs = wl_neighbors("dog", dict1)
    ck("wl_neighbors dog", str(dog_nbrs), str(["dot", "log", "cog"]))

    let hot_nbrs = wl_neighbors("hot", dict1)
    ck("wl_neighbors hot", str(hot_nbrs), str(["dot", "lot"]))

    let ladder1 = wl_shortest("hit", "cog", dict1)
    ck("wl_shortest hit->cog path", str(ladder1), str(["hit", "hot", "dot", "dog", "cog"]))
    ck("wl_length hit->cog", wl_length("hit", "cog", dict1), 5)

    ck("wl_shortest same word", str(wl_shortest("hit", "hit", dict1)), str(["hit"]))
    ck("wl_length same word", wl_length("hit", "hit", dict1), 1)

    let ladder_none = wl_shortest("aaa", "bbb", ["aaa"])
    ck("wl_shortest unreachable", str(ladder_none), str([]))
    ck("wl_length unreachable", wl_length("aaa", "bbb", ["aaa"]), 0)

    // ================================================================
    // std/statistics/tdigest  (prefix td_)
    // ================================================================
    let td1 = td_new(1)
    td1 = td_add(td1, 10)
    td1 = td_add(td1, 20)
    td1 = td_add(td1, 30)
    ck("td1 count", td_count(td1), 3)
    ck("td1 centroid_count", td_centroid_count(td1), 2)
    ckf("td1 quantile 0.0", td_quantile(td1, 0.0), 10.0, 0.01)
    ckf("td1 quantile 1.0", td_quantile(td1, 1.0), 25.0, 0.01)
    ckf("td1 quantile 0.5", td_quantile(td1, 0.5), 20.0, 0.01)
    ckf("td1 cdf 25", td_cdf(td1, 25), 1.0, 0.001)
    ckf("td1 cdf 10", td_cdf(td1, 10), 0.3333, 0.01)
    ckf("td1 cdf 5", td_cdf(td1, 5), 0.0, 0.001)

    let td2 = td_new(1)
    td2 = td_add(td2, 100)
    td2 = td_add(td2, 200)
    td2 = td_add(td2, 300)
    ck("td2 count", td_count(td2), 3)
    ck("td2 centroid_count", td_centroid_count(td2), 2)

    let tdm = td_merge(td1, td2)
    ck("tdm count", td_count(tdm), 6)
    ck("tdm centroid_count", td_centroid_count(tdm), 2)
    ckf("tdm quantile 0.0", td_quantile(tdm, 0.0), 10.0, 0.01)
    ckf("tdm quantile 1.0", td_quantile(tdm, 1.0), 130.0, 0.01)

    let td3 = td_new(1000)
    td3 = td_add(td3, 5)
    td3 = td_add(td3, 3)
    td3 = td_add(td3, 1)
    td3 = td_add(td3, 4)
    td3 = td_add(td3, 2)
    ck("td3 count", td_count(td3), 5)
    ck("td3 centroid_count high-compression", td_centroid_count(td3), 5)
    ckf("td3 quantile 0.0 (min)", td_quantile(td3, 0.0), 1.0, 0.01)
    ckf("td3 quantile 1.0 (max)", td_quantile(td3, 1.0), 5.0, 0.01)
    ckf("td3 quantile 0.5 (median)", td_quantile(td3, 0.5), 3.0, 0.01)

    // ================================================================
    // std/text/rollinghash  (prefix rh_)
    // ================================================================
    let h1 = rh_build("abcabcabc")
    ck("rh_len", rh_len(h1), 9)
    ck("rh_hash abc@0 == abc@3", rh_hash(h1, 0, 3) == rh_hash(h1, 3, 6), true)
    ck("rh_hash abc@0 == abc@6", rh_hash(h1, 0, 3) == rh_hash(h1, 6, 9), true)
    ck("rh_equal abc@0,abc@3", rh_equal(h1, 0, 3, 3, 6), true)
    ck("rh_equal abc@0,abc@6", rh_equal(h1, 0, 3, 6, 9), true)
    ck("rh_equal abc@0 != bca@1", rh_equal(h1, 0, 3, 1, 4), false)
    ck("rh_equal ab@0,ab@3", rh_equal(h1, 0, 2, 3, 5), true)
    ck("rh_equal different lengths", rh_equal(h1, 0, 3, 0, 2), false)

    ck("rh_find abc", str(rh_find(h1, "abc")), str([0, 3, 6]))
    ck("rh_find bc", str(rh_find(h1, "bc")), str([1, 4, 7]))
    ck("rh_find xyz (absent)", str(rh_find(h1, "xyz")), str([]))
    ck("rh_find empty pattern", str(rh_find(h1, "")), str([]))
    ck("rh_find pattern longer than text", str(rh_find(h1, "abcabcabcabc")), str([]))

    ck("rh_lcp(0,3)", rh_lcp(h1, 0, 3), 6)
    ck("rh_lcp(0,6)", rh_lcp(h1, 0, 6), 3)
    ck("rh_lcp(1,4)", rh_lcp(h1, 1, 4), 5)
    ck("rh_lcp(0,1) no match", rh_lcp(h1, 0, 1), 0)

    let h2 = rh_build("banana")
    ck("rh_hash an@1 == an@3", rh_hash(h2, 1, 3) == rh_hash(h2, 3, 5), true)
    ck("rh_find ana", str(rh_find(h2, "ana")), str([1, 3]))
    ck("rh_find na", str(rh_find(h2, "na")), str([2, 4]))

    // ================================================================
    // std/collections/cuckoohash  (prefix ckh_)
    // ================================================================
    let m1 = ckh_new(8)
    ck("ckh_size empty", ckh_size(m1), 0)
    ck("ckh_capacity at least 8", ckh_capacity(m1) >= 8, true)
    ck("ckh_contains miss on empty", ckh_contains(m1, "a"), false)

    m1 = ckh_put(m1, "a", 1)
    m1 = ckh_put(m1, "b", 2)
    m1 = ckh_put(m1, "c", 3)
    ck("ckh_get a", str(ckh_get(m1, "a")), str([1, 1]))
    ck("ckh_get b", str(ckh_get(m1, "b")), str([1, 2]))
    ck("ckh_get miss z", ckh_get(m1, "z")[0], 0)
    ck("ckh_contains c", ckh_contains(m1, "c"), true)
    ck("ckh_size after 3 puts", ckh_size(m1), 3)

    m1 = ckh_put(m1, "a", 99)
    ck("ckh_get a after update", str(ckh_get(m1, "a")), str([1, 99]))
    ck("ckh_size unchanged after update", ckh_size(m1), 3)

    ck("ckh_remove b", ckh_remove(m1, "b"), true)
    ck("ckh_contains b after remove", ckh_contains(m1, "b"), false)
    ck("ckh_size after remove", ckh_size(m1), 2)
    ck("ckh_remove nonexistent", ckh_remove(m1, "nonexistent"), false)

    let m2 = ckh_new(4)
    let ci = 0
    while ci < 30
        m2 = ckh_put(m2, "k" + str(ci), ci * 10)
        ci = ci + 1
    ck("ckh bulk size after 30 puts (forces resize)", ckh_size(m2), 30)

    let bulk_ok = true
    let cj = 0
    while cj < 30
        let r = ckh_get(m2, "k" + str(cj))
        if r[0] != 1 or r[1] != cj * 10
            bulk_ok = false
        cj = cj + 1
    ck("ckh bulk retrieval all correct", bulk_ok, true)
    ck("ckh_keys length matches size", len(ckh_keys(m2)), 30)

    // string values specifically (regression: ckh_get must not corrupt
    // pointer-typed values — see the codegen-defect note in cuckoohash.nova)
    let m3 = ckh_new(8)
    m3 = ckh_put(m3, "fruit", "apple")
    m3 = ckh_put(m3, "veg", "carrot")
    ck("ckh_get string value", str(ckh_get(m3, "fruit")), str([1, "apple"]))
    ck("ckh_get second string value", str(ckh_get(m3, "veg")), str([1, "carrot"]))
    ck("ckh_get string miss", ckh_get(m3, "meat")[0], 0)

    // ================================================================
    // std/collections/dsu_rollback  (prefix dsur_)
    // ================================================================
    let d = dsur_new(6)
    ck("dsur_count initial", dsur_count(d), 6)
    ck("dsur_connected 0,1 before union", dsur_connected(d, 0, 1), false)

    ck("dsur_union 0,1", dsur_union(d, 0, 1), true)
    ck("dsur_connected 0,1 after union", dsur_connected(d, 0, 1), true)
    ck("dsur_count after 1 union", dsur_count(d), 5)

    let cp1 = dsur_snapshot(d)

    ck("dsur_union 2,3", dsur_union(d, 2, 3), true)
    ck("dsur_union 4,5", dsur_union(d, 4, 5), true)
    ck("dsur_count after 3 unions", dsur_count(d), 3)

    ck("dsur_union 0,2 (merge two pairs)", dsur_union(d, 0, 2), true)
    ck("dsur_count after 4 unions", dsur_count(d), 2)
    ck("dsur_connected 1,3 (transitive)", dsur_connected(d, 1, 3), true)
    ck("dsur_component_size of merged pair", dsur_component_size(d, 1), 4)

    let cp2 = dsur_snapshot(d)

    ck("dsur_union 0,4 (merge everything)", dsur_union(d, 0, 4), true)
    ck("dsur_count fully merged", dsur_count(d), 1)
    ck("dsur_component_size of everything", dsur_component_size(d, 5), 6)

    d = dsur_rollback(d, cp2)
    ck("dsur_count after rollback to cp2", dsur_count(d), 2)
    ck("dsur_connected 0,4 after rollback", dsur_connected(d, 0, 4), false)
    ck("dsur_component_size of merged pair restored", dsur_component_size(d, 1), 4)

    d = dsur_rollback(d, cp1)
    ck("dsur_count after rollback to cp1", dsur_count(d), 5)
    ck("dsur_connected 0,1 still merged", dsur_connected(d, 0, 1), true)
    ck("dsur_connected 2,3 undone", dsur_connected(d, 2, 3), false)
    ck("dsur_connected 4,5 undone", dsur_connected(d, 4, 5), false)
    ck("dsur_union 0,1 now a no-op", dsur_union(d, 0, 1), false)

    // ================================================================
    // std/cache/ttlcache  (prefix ttlc_)
    // ================================================================
    let c = ttlc_new()
    ck("ttlc_contains on empty", ttlc_contains(c, "a", 1000), false)

    c = ttlc_set(c, "a", "apple", 1000, 500)
    c = ttlc_set(c, "b", "banana", 1000, 0)
    c = ttlc_set(c, "cc", "cherry", 1000, 100)

    ck("ttlc_size all live", ttlc_size(c, 1000), 3)
    ck("ttlc_get a", str(ttlc_get(c, "a", 1000)), str([1, "apple"]))
    ck("ttlc_ttl_remaining a", ttlc_ttl_remaining(c, "a", 1000), 500)
    ck("ttlc_ttl_remaining b (never expires)", ttlc_ttl_remaining(c, "b", 1000), -1)
    ck("ttlc_ttl_remaining absent key", ttlc_ttl_remaining(c, "zz", 1000), -2)
    ck("ttlc_size before cc expiry", ttlc_size(c, 1050), 3)

    ck("ttlc_contains cc at expiry (lazy evict)", ttlc_contains(c, "cc", 1100), false)
    ck("ttlc_size after lazy evict of cc", ttlc_size(c, 1100), 2)
    ck("ttlc_get cc after eviction is a plain miss", str(ttlc_get(c, "cc", 1100)), str([0, 0]))

    ck("ttlc_purge_expired removes a", ttlc_purge_expired(c, 1500), 1)
    ck("ttlc_size after purge", ttlc_size(c, 1500), 1)
    ck("ttlc_contains b never expires", ttlc_contains(c, "b", 999999), true)

    c = ttlc_delete(c, "b")
    ck("ttlc_contains b after delete", ttlc_contains(c, "b", 1500), false)
    ck("ttlc_size after delete", ttlc_size(c, 1500), 0)

    c = ttlc_set(c, "y", "Y1", 3000, 100)
    ck("ttlc_get y v1", str(ttlc_get(c, "y", 3000)), str([1, "Y1"]))
    c = ttlc_set(c, "y", "Y2", 3000, 1000)
    ck("ttlc_get y v2 after overwrite", str(ttlc_get(c, "y", 3050)), str([1, "Y2"]))
    ck("ttlc_contains y past old-ttl but within new-ttl", ttlc_contains(c, "y", 3150), true)
    ck("ttlc_size not double-counted on overwrite", ttlc_size(c, 3050), 1)

    c = ttlc_clear(c)
    ck("ttlc_size after clear", ttlc_size(c, 4000), 0)
    ck("ttlc_contains after clear", ttlc_contains(c, "y", 4000), false)

    print("ALL PASS")
