import forge_data_pipeline

fn main()
    let p = dp_new("etl-users")
    p = dp_add_stage(p, "extract", "source")
    p = dp_add_stage(p, "transform", "map")
    p = dp_add_stage(p, "load", "sink")
    assert(dp_stage_count(p) == 3, "3 stages")

    let r1 = {}
    r1["name"] = "Alice"
    r1["age"] = 30
    r1["role"] = "admin"
    let r2 = {}
    r2["name"] = "Bob"
    r2["age"] = 25
    r2["role"] = "user"
    let r3 = {}
    r3["name"] = "Charlie"
    r3["age"] = 35
    r3["role"] = "admin"
    let data = [r1, r2, r3]
    p = dp_set_data(p, data)
    assert(dp_count(p) == 3, "3 rows")
    p = dp_mark_stage(p, 0, "done")

    p = dp_filter(p, "role", "admin")
    assert(dp_count(p) == 2, "2 admins")
    p = dp_mark_stage(p, 1, "done")

    p = dp_add_field(p, "source", "etl")
    let result = dp_get_data(p)
    assert(result[0]["source"] == "etl", "field added")

    p = dp_transform_field(p, "name", "user_")
    let result2 = dp_get_data(p)
    assert(result2[0]["name"] == "user_Alice", "transformed")

    p = dp_mark_stage(p, 2, "done")
    p = dp_set_status(p, "complete")
    assert(dp_run_status(p) == "complete", "complete")
    assert(dp_error_count(p) == 0, "no errors")

    p = dp_add_error(p, "test error")
    assert(dp_error_count(p) == 1, "1 error")

    print("DATA-PIPELINE KAT PASS")
