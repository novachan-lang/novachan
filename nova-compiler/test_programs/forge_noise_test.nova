import forge_noise

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn absf(x: float) -> float
    let v = x
    if x < 0.0
        v = 0.0 - x
    v

fn main()
    let fails = 0

    // deterministic: same (x, seed) -> same value
    fails = fails + expect_true("determ_1d", value_noise_1d(3.7, 42) == value_noise_1d(3.7, 42))
    fails = fails + expect_true("determ_2d", value_noise_2d(1.5, 2.5, 7) == value_noise_2d(1.5, 2.5, 7))

    // range [0,1)
    fails = fails + expect_true("range_1d", value_noise_1d(3.7, 42) >= 0.0 and value_noise_1d(3.7, 42) < 1.0)
    fails = fails + expect_true("range_2d", value_noise_2d(1.5, 2.5, 7) >= 0.0 and value_noise_2d(1.5, 2.5, 7) < 1.0)
    fails = fails + expect_true("range_neg", value_noise_1d(0 - 5.3, 9) >= 0.0 and value_noise_1d(0 - 5.3, 9) < 1.0)

    // continuity: nearby x -> nearby value (smooth)
    let d = absf(value_noise_1d(2.0, 1) - value_noise_1d(2.001, 1))
    fails = fails + expect_true("continuity", d < 0.01)

    // different seeds -> (very likely) different values
    fails = fails + expect_true("seed_varies", value_noise_1d(3.7, 1) != value_noise_1d(3.7, 999))

    // at an integer coordinate, the fractional part is 0 so smoothstep u=0 -> value = lattice hash (stable)
    fails = fails + expect_true("integer_stable", value_noise_1d(4.0, 5) == value_noise_1d(4.0, 5))
    // and moving to the next integer generally changes it
    fails = fails + expect_true("integer_changes", value_noise_1d(4.0, 5) != value_noise_1d(5.0, 5))

    // fractal noise in range, deterministic
    let f = fractal_noise_1d(2.5, 3, 4)
    fails = fails + expect_true("fractal_range", f >= 0.0 and f < 1.0)
    fails = fails + expect_true("fractal_determ", fractal_noise_1d(2.5, 3, 4) == fractal_noise_1d(2.5, 3, 4))

    // 2D varies across space
    fails = fails + expect_true("2d_varies", value_noise_2d(0.5, 0.5, 1) != value_noise_2d(5.5, 5.5, 1))

    if fails == 0
        print("forge_noise: all passed")
    else
        print("forge_noise: " + str(fails) + " FAILED")
