// KAT test for std/os/envexpand
import std/os/envexpand

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // KAT 1: bare $NAME substitution — $HOME/bin
    let dollar = chr(36)
    let obrace = chr(123)
    let cbrace = chr(125)
    let env1 = {"HOME": "/u"}
    let r1 = ev_expand(dollar + "HOME/bin", env1)
    cks("bare_subst", r1, "/u/bin")

    // KAT 2: two braced ${A}${B} forms
    let env2 = {"A": "x", "B": "y"}
    let s2 = dollar + obrace + "A" + cbrace + dollar + obrace + "B" + cbrace
    let r2 = ev_expand(s2, env2)
    cks("two_braced", r2, "xy")

    // KAT 3: missing key becomes empty string
    let env3 = {}
    let r3 = ev_expand(dollar + "MISSING", env3)
    cks("missing_key", r3, "")

    // KAT 4: literal text with no $ is returned unchanged
    let r4 = ev_expand("literal text", env3)
    cks("literal_text", r4, "literal text")

    // KAT 5: ev_vars deduplicates and preserves first-occurrence order
    let svars = dollar + "A/" + dollar + "B/" + dollar + "A"
    let got_vars = ev_vars(svars)
    cki("ev_vars_len", len(got_vars), 2)
    cks("ev_vars_0", got_vars[0], "A")
    cks("ev_vars_1", got_vars[1], "B")

    // KAT 6: ev_expand_default — missing key, uses fallback
    let s6 = dollar + obrace + "X:-def" + cbrace
    let r6 = ev_expand_default(s6, {})
    cks("default_missing", r6, "def")

    // KAT 7: ev_expand_default — present key, uses value not fallback
    let r7 = ev_expand_default(s6, {"X": "val"})
    cks("default_present", r7, "val")

    // KAT 8: ev_expand does NOT treat :-default syntax specially (braced missing -> empty)
    let r8 = ev_expand(s6, {})
    cks("no_default_in_expand", r8, "")

    // KAT 9: ev_expand_default with empty fallback string
    let s9 = dollar + obrace + "NOPE:-" + cbrace
    let r9 = ev_expand_default(s9, {})
    cks("empty_fallback", r9, "")

    // KAT 10: multiple bare vars with surrounding text
    let env10 = {"USER": "alice", "HOST": "box"}
    let s10 = "Hello " + dollar + "USER" + " at " + dollar + "HOST" + "!"
    let r10 = ev_expand(s10, env10)
    cks("multi_bare", r10, "Hello alice at box!")

    // KAT 11: ev_vars on braced references — deduped across both forms
    let s11 = dollar + obrace + "FOO" + cbrace + dollar + "BAR" + dollar + obrace + "FOO" + cbrace
    let gv11 = ev_vars(s11)
    cki("ev_vars_brace_len", len(gv11), 2)
    cks("ev_vars_brace_0", gv11[0], "FOO")
    cks("ev_vars_brace_1", gv11[1], "BAR")

    // KAT 12: $ at end of string passes through literally
    let r12 = ev_expand("end" + dollar, {})
    cks("dollar_at_end", r12, "end" + dollar)

    // KAT 13: $ followed by digit (non-id-start) passes through literally
    let r13 = ev_expand(dollar + "1abc", {})
    cks("dollar_digit", r13, dollar + "1abc")

    print("_envexpand_test passed")
