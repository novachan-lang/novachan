// _ormbench -- measure the PostgreSQL read path. The dominant cost being tested is per-VALUE row
// decoding, which used to allocate one NOVA string per BYTE and join a list of them; wide text
// columns are where that shows up. Also exercises the coalesced single-write query path.

import forge_orm

fn main()
    let url = "postgres://postgres:root@127.0.0.1:5432/postgres"
    let dr = orm_open_with_pool(url, 4)
    if is_err(dr)
        print("open failed: {unwrap_err(dr)}")
        return
    let db = unwrap(dr)

    _ = orm_exec(db, "DROP TABLE IF EXISTS bench_rows", [])
    _ = orm_exec(db, "CREATE TABLE bench_rows (id int, payload text)", [])

    // 400-char payload per row: representative of a real text column, and the case the per-byte
    // decoder handled worst.
    let chunk = "abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    let payload = chunk + chunk + chunk + chunk + chunk + chunk + chunk
    print("payload chars = {len(payload)}")

    let t_ins0 = time_ms()
    for i in 0..300
        _ = orm_exec(db, "INSERT INTO bench_rows (id, payload) VALUES (?, ?)", [i, payload])
    let t_ins = time_ms() - t_ins0

    // 40 full-table scans of 300 rows = 12000 decoded values
    let t_sel0 = time_ms()
    let total = 0
    for r in 0..40
        let rows = orm_all(db, "SELECT id, payload FROM bench_rows ORDER BY id", [])
        total += len(rows)
    let t_sel = time_ms() - t_sel0

    // exists: O(1) LIMIT 1 probe vs a full count(*)
    let t_ex0 = time_ms()
    for r in 0..200
        orm_exists(db, "bench_rows", "id = ?", [150])
    let t_ex = time_ms() - t_ex0

    print("INSERT  300 rows           : {t_ins} ms")
    print("SELECT  40 x 300 rows      : {t_sel} ms   (rows decoded = {total})")
    print("EXISTS  200 probes         : {t_ex} ms")

    _ = orm_exec(db, "DROP TABLE IF EXISTS bench_rows", [])
    orm_close(db)
