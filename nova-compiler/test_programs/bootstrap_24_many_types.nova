// Bootstrap test 24: many struct types + nested matching
// The self-hosted compiler has 19 struct types with deep matching

type Token
    kind: string
    value: string
    line: int
    col: int

type Expr
    tag: string
    value: string
    num: int
    children: list

type Stmt
    tag: string
    name: string
    expr: Expr
    body: list

type Param
    name: string
    type_ann: string

fn make_token(k: string, v: string) -> Token
    return Token(k, v, 0, 0)

fn make_expr(t: string, v: string, n: int) -> Expr
    return Expr(t, v, n, [])

fn make_stmt(t: string, n: string, e: Expr) -> Stmt
    return Stmt(t, n, e, [])

// Create instances of each type
let tok = make_token("IDENT", "hello")
let expr = make_expr("int", "42", 42)
let stmt = make_stmt("assign", "x", expr)
let param = Param("n", "int")

// Nested matching: match a Stmt, then match its Expr
fn describe_stmt(s: Stmt) -> string
    match s
        Stmt(tag, name, expr, body) =>
            match expr
                Expr(etag, eval, ecount, ech) =>
                    return f"{tag} {name} = {etag}({eval})"
    return "unknown"

print(describe_stmt(stmt))

// Match a Token
fn token_str(t: Token) -> string
    match t
        Token(k, v, line, col) =>
            return f"{k}:{v}"
    return "?"

print(token_str(tok))

// List of mixed struct types
let tokens = [make_token("KW", "fn"), make_token("IDENT", "main"), make_token("DELIM", "(")]
let i = 0
while i < len(tokens)
    print(token_str(tokens[i]))
    i = i + 1

// Param matching
match param
    Param(n, t) =>
        print(f"{n}: {t}")
