// @repr(C): a NOVA struct that's C-layout-compatible. The struct handle is
// the heap data pointer; C reads/writes the fields at offsets 0,8,16 via
// the same pointer. NOVA's existing field access works after the call —
// fields are loaded fresh from memory, not cached.
@repr(C)
type Triple
    a: int
    b: int
    c: int

extern fn c_test_fill_triple(t: Triple) -> int

fn main()
    let t = Triple(0, 0, 0)
    assert_eq(t.a, 0)
    assert_eq(t.b, 0)
    assert_eq(t.c, 0)

    let rc = unsafe c_test_fill_triple(t)
    assert_eq(rc, 0)

    // C wrote 1,2,3 through the struct pointer; NOVA reads them back.
    assert_eq(t.a, 1)
    assert_eq(t.b, 2)
    assert_eq(t.c, 3)

    print("@repr(C) test passed: NOVA struct round-trip through C — fields written by C are read back by NOVA via the same heap data pointer")
