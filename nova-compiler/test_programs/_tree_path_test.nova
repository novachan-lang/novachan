import std/tree/tree_path

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn ckl(label, got, expected)
    if len(got) != len(expected)
        print("FAIL " + label + ": len got " + str(len(got)) + " expected " + str(len(expected)))
        exit(1)
    let i = 0
    while i < len(expected)
        if got[i] != expected[i]
            print("FAIL " + label + "[" + str(i) + "]: got " + str(got[i]) + " expected " + str(expected[i]))
            exit(1)
        i = i + 1

fn main()
    // Tree: 0-{1,2}, 1-{3,4}  (n=5)
    // adj = [[1,2],[0,3,4],[0],[1],[1]]
    let adj5 = [[1,2],[0,3,4],[0],[1],[1]]

    // KAT 1: tpath_distance — node 3 to node 2 = 3 (3->1->0->2)
    cki("dist_3_2", tpath_distance(adj5, 5, 3, 2), 3)

    // KAT 2: tpath_distance — node 3 to node 4 = 2 (3->1->4)
    cki("dist_3_4", tpath_distance(adj5, 5, 3, 4), 2)

    // KAT 3: tpath_distance — same node = 0
    cki("dist_self", tpath_distance(adj5, 5, 2, 2), 0)

    // KAT 4: tpath_between on a path graph 0-1-2-3
    let adjp = [[1],[0,2],[1,3],[2]]
    let path03 = tpath_between(adjp, 4, 0, 3)
    ckl("between_0_3", path03, [0,1,2,3])

    // KAT 5: tpath_between single node (u==v)
    let ps = tpath_between(adj5, 5, 2, 2)
    ckl("between_self", ps, [2])

    // KAT 6: tpath_lca — root=0, lca(3,4)=1
    cki("lca_3_4", tpath_lca(adj5, 5, 0, 3, 4), 1)

    // KAT 7: tpath_lca — root=0, lca(3,2)=0
    cki("lca_3_2", tpath_lca(adj5, 5, 0, 3, 2), 0)

    // KAT 8: tpath_lca — root=0, lca(1,4)=1 (4 is child of 1)
    cki("lca_1_4", tpath_lca(adj5, 5, 0, 1, 4), 1)

    // KAT 9: tpath_lca — root=0, lca(0,4)=0
    cki("lca_0_4", tpath_lca(adj5, 5, 0, 0, 4), 0)

    // KAT 10: n=1 single-node tree
    let adj1 = [[]]
    cki("dist_n1", tpath_distance(adj1, 1, 0, 0), 0)
    let p1 = tpath_between(adj1, 1, 0, 0)
    ckl("between_n1", p1, [0])

    print("PASS _tree_path_test")
