import forge_morse

fn ck(label: string, got: string, want: string)
    let ok = "FAIL"
    if got == want
        ok = "ok"
    print(label + "=" + ok + " [" + got + "]")

fn main()
    ck("sos", morse_encode("SOS"), "... --- ...")
    ck("hello", morse_encode("HELLO"), ".... . .-.. .-.. ---")
    ck("lower", morse_encode("sos"), "... --- ...")
    ck("digits", morse_encode("123"), ".---- ..--- ...--")
    ck("words", morse_encode("HI YOU"), ".... .. / -.-- --- ..-")
    ck("dec_sos", morse_decode("... --- ..."), "SOS")
    ck("dec_words", morse_decode(".... .. / -.-- --- ..-"), "HI YOU")
    ck("roundtrip", morse_decode(morse_encode("NOVA LANG")), "NOVA LANG")
