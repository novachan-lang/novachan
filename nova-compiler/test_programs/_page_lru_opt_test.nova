import std/scheduling/page_lru_opt

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL page_lru_opt " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // KAT refs = [1,2,3,4,1,2,5,1,2,3,4,5]
    let refs = []
    push(refs, 1)
    push(refs, 2)
    push(refs, 3)
    push(refs, 4)
    push(refs, 1)
    push(refs, 2)
    push(refs, 5)
    push(refs, 1)
    push(refs, 2)
    push(refs, 3)
    push(refs, 4)
    push(refs, 5)

    // pl_lru_faults(refs, 3) = 10
    let lru3 = pl_lru_faults(refs, 3)
    cki("lru_3frames", lru3, 10)

    // pl_optimal_faults(refs, 3) = 7
    let opt3 = pl_optimal_faults(refs, 3)
    cki("optimal_3frames", opt3, 7)

    // pl_optimal_faults(refs, 4) = 6
    let opt4 = pl_optimal_faults(refs, 4)
    cki("optimal_4frames", opt4, 6)

    // pl_lru_faults([7,0,1,2,0,3,0,4], 3) = 6
    let refs2 = []
    push(refs2, 7)
    push(refs2, 0)
    push(refs2, 1)
    push(refs2, 2)
    push(refs2, 0)
    push(refs2, 3)
    push(refs2, 0)
    push(refs2, 4)
    let lru2 = pl_lru_faults(refs2, 3)
    cki("lru_70120304_3frames", lru2, 6)

    // edge: empty refs
    let empty = []
    cki("lru_empty", pl_lru_faults(empty, 3), 0)
    cki("opt_empty", pl_optimal_faults(empty, 3), 0)

    print("PASS _page_lru_opt_test")
