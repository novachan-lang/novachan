// _antimeridian_test.nova — KAT for std/geo/antimeridian
import std/geo/antimeridian

fn ckf(label, got, expected, eps)
    let diff = got - expected
    if diff < 0.0
        diff = 0.0 - diff
    if diff > eps
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(expected))
        exit(1)

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(expected))
        exit(1)

fn ckb(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(expected))
        exit(1)

fn main()
    // KAT 1: am_normalize_lon(190.0) == -170.0
    let n1 = am_normalize_lon(190.0)
    ckf("normalize 190", n1, 0.0 - 170.0, 0.0001)

    // KAT 2: am_normalize_lon(-190.0) == 170.0
    let n2 = am_normalize_lon(0.0 - 190.0)
    ckf("normalize -190", n2, 170.0, 0.0001)

    // KAT 3: am_normalize_lon(180.0) stays 180.0 (or -180; both acceptable — we keep 180)
    let n3 = am_normalize_lon(180.0)
    ckf("normalize 180", n3, 180.0, 0.0001)

    // KAT 4: am_normalize_lon(45.0) == 45.0 (in range already)
    let n4 = am_normalize_lon(45.0)
    ckf("normalize 45", n4, 45.0, 0.0001)

    // KAT 5: am_normalize_lon(0.0) == 0.0
    let n5 = am_normalize_lon(0.0)
    ckf("normalize 0", n5, 0.0, 0.0001)

    // KAT 6: am_normalize_lon(360.0) == 0.0
    let n6 = am_normalize_lon(360.0)
    ckf("normalize 360", n6, 0.0, 0.0001)

    // KAT 7: am_normalize_lon(-360.0) == 0.0
    let n7 = am_normalize_lon(0.0 - 360.0)
    ckf("normalize -360", n7, 0.0, 0.0001)

    // KAT 8: am_crosses(170.0, -170.0) == true (|340| > 180)
    ckb("crosses 170 -170", am_crosses(170.0, 0.0 - 170.0), true)

    // KAT 9: am_crosses(10.0, 20.0) == false
    ckb("crosses 10 20", am_crosses(10.0, 20.0), false)

    // KAT 10: am_crosses(-170.0, 170.0) == true
    ckb("crosses -170 170", am_crosses(0.0 - 170.0, 170.0), true)

    // KAT 11: am_lon_distance(170.0, -170.0) == 20.0
    let d1 = am_lon_distance(170.0, 0.0 - 170.0)
    ckf("lon_distance 170 -170", d1, 20.0, 0.0001)

    // KAT 12: am_lon_distance(0.0, 90.0) == 90.0
    let d2 = am_lon_distance(0.0, 90.0)
    ckf("lon_distance 0 90", d2, 90.0, 0.0001)

    // KAT 13: am_lon_distance(-90.0, 90.0) == 180.0
    let d3 = am_lon_distance(0.0 - 90.0, 90.0)
    ckf("lon_distance -90 90", d3, 180.0, 0.0001)

    // KAT 14: am_normalize_lat(95.0) == 90.0
    let la1 = am_normalize_lat(95.0)
    ckf("normalize_lat 95", la1, 90.0, 0.0001)

    // KAT 15: am_normalize_lat(-100.0) == -90.0
    let la2 = am_normalize_lat(0.0 - 100.0)
    ckf("normalize_lat -100", la2, 0.0 - 90.0, 0.0001)

    // KAT 16: am_normalize_lat(45.0) == 45.0
    let la3 = am_normalize_lat(45.0)
    ckf("normalize_lat 45", la3, 45.0, 0.0001)

    // KAT 17: am_midpoint_lon(170.0, -170.0) == 180.0 (or -180; both valid)
    // The midpoint of the shorter arc crossing the antimeridian
    let mp1 = am_midpoint_lon(170.0, 0.0 - 170.0)
    // Accept either 180 or -180
    let mp1_ok = 0
    if mp1 > 179.9999 and mp1 <= 180.0001
        mp1_ok = 1
    if mp1 > 0.0 - 180.0001 and mp1 < 0.0 - 179.9999
        mp1_ok = 1
    if mp1_ok == 0
        print("FAIL midpoint_lon 170 -170: got=" + str(mp1) + " want=180 or -180")
        exit(1)

    // KAT 18: am_midpoint_lon(0.0, 90.0) == 45.0 (simple case)
    let mp2 = am_midpoint_lon(0.0, 90.0)
    ckf("midpoint_lon 0 90", mp2, 45.0, 0.0001)

    // KAT 19: am_midpoint_lon(-90.0, 90.0) == 0.0
    let mp3 = am_midpoint_lon(0.0 - 90.0, 90.0)
    ckf("midpoint_lon -90 90", mp3, 0.0, 0.0001)

    // KAT 20: am_split_bbox — no crossing
    let bbox1 = []
    bbox1.push(0.0)
    bbox1.push(10.0)
    bbox1.push(20.0)
    bbox1.push(30.0)
    let sp1 = am_split_bbox(bbox1)
    cki("split no-cross count", len(sp1), 1)

    // KAT 21: am_split_bbox — crossing (min_lon > max_lon)
    let bbox2 = []
    bbox2.push(0.0)
    bbox2.push(170.0)
    bbox2.push(20.0)
    bbox2.push(0.0 - 170.0)
    let sp2 = am_split_bbox(bbox2)
    cki("split cross count", len(sp2), 2)
    // West part: min_lon=170, max_lon=180
    let west = sp2[0]
    let west_mn_lon = west[1] * 1.0
    let west_mx_lon = west[3] * 1.0
    ckf("split west min_lon", west_mn_lon, 170.0, 0.0001)
    ckf("split west max_lon", west_mx_lon, 180.0, 0.0001)
    // East part: min_lon=-180, max_lon=-170
    let east = sp2[1]
    let east_mn_lon = east[1] * 1.0
    let east_mx_lon = east[3] * 1.0
    ckf("split east min_lon", east_mn_lon, 0.0 - 180.0, 0.0001)
    ckf("split east max_lon", east_mx_lon, 0.0 - 170.0, 0.0001)

    // KAT 22: am_unwrap — no crossing
    let lons1 = []
    lons1.push(10.0)
    lons1.push(20.0)
    lons1.push(30.0)
    let uw1 = am_unwrap(lons1)
    cki("unwrap no-cross len", len(uw1), 3)
    let uw1_0 = uw1[0] * 1.0
    let uw1_2 = uw1[2] * 1.0
    ckf("unwrap[0]", uw1_0, 10.0, 0.0001)
    ckf("unwrap[2]", uw1_2, 30.0, 0.0001)

    // KAT 23: am_unwrap — crossing: 170, -170 should unwrap to 170, 190
    let lons2 = []
    lons2.push(170.0)
    lons2.push(0.0 - 170.0)
    let uw2 = am_unwrap(lons2)
    let uw2_0 = uw2[0] * 1.0
    let uw2_1 = uw2[1] * 1.0
    ckf("unwrap cross[0]", uw2_0, 170.0, 0.0001)
    ckf("unwrap cross[1]", uw2_1, 190.0, 0.0001)

    // KAT 24: am_normalize_lon — large positive wrap (540 = 360+180 = antimeridian; -180 or 180 both valid)
    let n8 = am_normalize_lon(540.0)
    let n8_ok = 0
    if n8 > 179.9999 and n8 <= 180.0001
        n8_ok = 1
    if n8 > 0.0 - 180.0001 and n8 < 0.0 - 179.9999
        n8_ok = 1
    if n8_ok == 0
        print("FAIL normalize 540: got=" + str(n8) + " want=180 or -180")
        exit(1)

    print("PASS _antimeridian_test")
