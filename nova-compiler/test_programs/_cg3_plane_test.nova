import std/geometry3d/cg3_plane

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn ckl(label: string, got: list, want: list)
    let ok = true
    if len(got) != len(want)
        ok = false
    if ok
        let i = 0
        while i < len(want)
            if got[i] != want[i]
                ok = false
            i = i + 1
    if not ok
        print("FAIL " + label + ": mismatch")
        exit(1)

fn main()
    // cgp3_from_points([0,0,0],[1,0,0],[0,1,0]) = [0,0,1,0]
    // n = (1,0,0)x(0,1,0) = (0,0,1), d = 0
    let fp1 = cgp3_from_points([0, 0, 0], [1, 0, 0], [0, 1, 0])
    ckl("from_pts_xy", fp1, [0, 0, 1, 0])

    // cgp3_from_points([0,0,0],[2,0,0],[0,3,0]) = [0,0,6,0]
    // n = (2,0,0)x(0,3,0) = (0,0,6), d = 0
    let fp2 = cgp3_from_points([0, 0, 0], [2, 0, 0], [0, 3, 0])
    ckl("from_pts_scaled", fp2, [0, 0, 6, 0])

    // cgp3_side([0,0,1,0],[0,0,5]) = 1  (above z=0 plane)
    let pl1 = [0, 0, 1, 0]
    cki("side_above", cgp3_side(pl1, [0, 0, 5]), 1)

    // cgp3_side([0,0,1,0],[0,0,-2]) = -1 (below z=0 plane)
    cki("side_below", cgp3_side(pl1, [0, 0, -2]), -1)

    // cgp3_dist_sq([0,0,1,0],[0,0,3]) = [9,1]
    let dr = cgp3_dist_sq(pl1, [0, 0, 3])
    ckl("dist_sq_3", dr, [9, 1])

    // cgp3_contains([0,0,1,0],[5,7,0]) = true  (z=0 => on plane)
    ckb("contains_on", cgp3_contains(pl1, [5, 7, 0]), true)

    // cgp3_contains([0,0,1,0],[5,7,1]) = false  (z=1 => not on plane)
    ckb("contains_off", cgp3_contains(pl1, [5, 7, 1]), false)

    // cgp3_side([0,0,1,0],[5,7,0]) = 0  (on the plane)
    cki("side_on", cgp3_side(pl1, [5, 7, 0]), 0)

    // dist_sq for a point on the plane must be [0,1]
    let dr0 = cgp3_dist_sq(pl1, [5, 7, 0])
    ckl("dist_sq_on_plane", dr0, [0, 1])

    // Degenerate: all three points identical => zero normal => degenerate plane
    let fp3 = cgp3_from_points([1, 2, 3], [1, 2, 3], [1, 2, 3])
    // n = [0,0,0], d = 0
    ckl("from_pts_degenerate", fp3, [0, 0, 0, 0])

    print("PASS _cg3_plane_test")
