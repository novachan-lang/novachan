// KAT for std/physics/energy — work, energy, and power.
import std/physics/energy

// approx — float equality within 0.0001 tolerance.
fn approx(a, b)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < 0.0001

// approx_rel — relative tolerance for larger magnitudes.
fn approx_rel(a, b)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    let ref = a
    if ref < 0.0
        ref = 0.0 - ref
    if ref < 1.0
        return d < 0.0001
    let rel = d / ref
    return rel < 0.0001

fn ckf(label, got, want)
    if not approx_rel(got, want)
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // kinetic: KE = 0.5 * m * v^2
    // m=2, v=3 -> KE=0.5*2*9=9
    ckf("kinetic(2,3)", kinetic(2.0, 3.0), 9.0)
    // m=1, v=0 -> KE=0
    ckf("kinetic(1,0)", kinetic(1.0, 0.0), 0.0)
    // m=4, v=5 -> KE=0.5*4*25=50
    ckf("kinetic(4,5)", kinetic(4.0, 5.0), 50.0)

    // potential: PE = m * g * h  (g=9.81)
    // m=1, h=10 -> PE=98.1
    ckf("potential(1,10)", potential(1.0, 10.0), 98.1)
    // m=2, h=5 -> PE=2*9.81*5=98.1
    ckf("potential(2,5)", potential(2.0, 5.0), 98.1)
    // m=0, h=100 -> PE=0
    ckf("potential(0,100)", potential(0.0, 100.0), 0.0)

    // work: W = F * d
    ckf("work(5,4)", work(5.0, 4.0), 20.0)
    ckf("work(10,10)", work(10.0, 10.0), 100.0)
    ckf("work(0,5)", work(0.0, 5.0), 0.0)

    // power: P = W / t
    ckf("power(100,4)", power(100.0, 4.0), 25.0)
    ckf("power(50,10)", power(50.0, 10.0), 5.0)
    ckf("power(1000,5)", power(1000.0, 5.0), 200.0)

    // work_energy_theorem: net_work = 0.5*m*(v2^2 - v1^2)
    // m=2, v1=0, v2=3 -> 0.5*2*(9-0)=9
    ckf("work_energy_theorem(2,0,3)", work_energy_theorem(2.0, 0.0, 3.0), 9.0)
    // m=1, v1=2, v2=4 -> 0.5*1*(16-4)=6
    ckf("work_energy_theorem(1,2,4)", work_energy_theorem(1.0, 2.0, 4.0), 6.0)

    print("PASS _energy_test")
