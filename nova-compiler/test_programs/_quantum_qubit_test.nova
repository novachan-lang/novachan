import std/quantum/quantum_qubit

// cki — integer known-answer check.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _quantum_qubit_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// _round1000 — local test helper: round x*1000 to nearest int (handles negative x).
fn _round1000(x: float) -> int
    if x < 0.0
        let neg = 0.0 - x
        let scaled = neg * 1000.0 + 0.5
        let r = float_to_int(scaled)
        return 0 - r
    let scaled = x * 1000.0 + 0.5
    float_to_int(scaled)

fn main()
    let z = qbt_zero()
    cki("prob0(zero)", qbt_prob0_x1000(z), 1000)
    cki("prob1(zero)", qbt_prob1_x1000(z), 0)

    let o = qbt_one()
    cki("prob0(one)", qbt_prob0_x1000(o), 0)
    cki("prob1(one)", qbt_prob1_x1000(o), 1000)

    let p = qbt_plus()
    cki("prob0(plus)", qbt_prob0_x1000(p), 500)
    cki("prob1(plus)", qbt_prob1_x1000(p), 500)
    cki("normalized(plus)", qbt_is_normalized_x1000(p), 1)

    let m = qbt_minus()
    cki("prob0(minus)", qbt_prob0_x1000(m), 500)
    cki("prob1(minus)", qbt_prob1_x1000(m), 500)
    cki("normalized(minus)", qbt_is_normalized_x1000(m), 1)

    let qpi = qbt_plus_i()
    cki("normalized(plus_i)", qbt_is_normalized_x1000(qpi), 1)

    let qmi = qbt_minus_i()
    cki("normalized(minus_i)", qbt_is_normalized_x1000(qmi), 1)

    // qbt_amp0 / qbt_amp1 accessors: plus amplitudes ~ 1/sqrt(2) ~ 0.70710678
    let a0 = qbt_amp0(p)
    let a1 = qbt_amp1(p)
    cki("amp0(plus) re", _round1000(a0[0]), 707)
    cki("amp0(plus) im", _round1000(a0[1]), 0)
    cki("amp1(plus) re", _round1000(a1[0]), 707)
    cki("amp1(plus) im", _round1000(a1[1]), 0)

    // qbt_make / qbt_normalize
    let raw = qbt_make(3.0, 0.0, 4.0, 0.0)
    let n = qbt_normalize(raw)
    cki("normalize prob0", qbt_prob0_x1000(n), 360)
    cki("normalize prob1", qbt_prob1_x1000(n), 640)
    cki("normalize is_normalized", qbt_is_normalized_x1000(n), 1)

    print("PASS _quantum_qubit_test")
