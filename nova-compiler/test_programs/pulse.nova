// NOVA PULSE — minimal data-processing framework.
// Stage 2b adoption-engine #3 per FRAMEWORK_ECOSYSTEM_STRATEGY.md.
// Same process model as Forge + Cortex — a pipeline that reads CSV, filters,
// groups, and aggregates compiles as ONE function in NOVA (compiler advantage).
//
// Public API (v0.1, list-of-rows where each row is list<string>):
//   pulse.read_csv(path)           -> list<row>, row = list<string>
//   pulse.filter_rows(rows, pred)  -> list<row> where pred(row) is true
//   pulse.col_as_float(rows, i)    -> list<float>
//   pulse.sum_floats(xs)           -> float
//   pulse.count_rows(rows)         -> int
//   pulse.group_by(rows, key_col)  -> dict<string, list<row>>
//   pulse.agg_sum(groups, col_idx) -> dict<string, float>  (sum per group)

fn read_csv(path: string) -> list
    let content = read_file(path)
    if len(content) == 0
        return []
    let lines = split(content, "\n")
    let out = []
    for line in lines
        let trimmed = trim(line)
        if len(trimmed) > 0
            let cells = split(trimmed, ",")
            let row = []
            for c in cells
                row.push(trim(c))
            out.push(row)
    out

fn filter_rows(rows: list, pred) -> list
    let out = []
    for row in rows
        if pred(row)
            out.push(row)
    out

fn col_as_float(rows: list, idx: int) -> list
    let out = []
    for row in rows
        if idx < len(row)
            out.push(parse_float(row[idx]))
    out

fn sum_floats(xs: list) -> float
    let total = 0.0
    for x in xs
        total = total + x
    total

fn count_rows(rows: list) -> int
    len(rows)

// Group rows by the value of a column. Returns dict<string, list<row>>.
fn group_by(rows: list, key_col: int)
    let groups = {}
    for row in rows
        if key_col < len(row)
            let k = row[key_col]
            if contains(groups, k)
                groups[k].push(row)
            else
                groups[k] = [row]
    groups

// Sum a column across each group. Returns dict<string, float>.
fn agg_sum(groups, col_idx: int)
    let out = {}
    for k in keys(groups)
        let group_rows = groups[k]
        let vals = col_as_float(group_rows, col_idx)
        out[k] = sum_floats(vals)
    out

// ── v0.2 additions ───────────────────────────────────────────────────────

// Mean of a numeric column per group.
fn agg_mean(groups, col_idx: int)
    let out = {}
    for k in keys(groups)
        let group_rows = groups[k]
        let vals = col_as_float(group_rows, col_idx)
        let n = len(vals)
        if n == 0
            out[k] = 0.0
        else
            out[k] = sum_floats(vals) / float(n)
    out

// Min and max of a column per group as [min, max].
fn agg_min_max(groups, col_idx: int)
    let out = {}
    for k in keys(groups)
        let group_rows = groups[k]
        let vals = col_as_float(group_rows, col_idx)
        if len(vals) == 0
            out[k] = [0.0, 0.0]
        else
            let lo = vals[0]
            let hi = vals[0]
            let i = 1
            while i < len(vals)
                if vals[i] < lo
                    lo = vals[i]
                if vals[i] > hi
                    hi = vals[i]
                i = i + 1
            let pair = []
            pair.push(lo)
            pair.push(hi)
            out[k] = pair
    out

// Unique values in a column (preserves first-seen order).
fn distinct(rows: list, col_idx: int) -> list
    let seen = {}
    let out = []
    for row in rows
        if col_idx < len(row)
            let v = row[col_idx]
            if not contains(seen, v)
                seen[v] = 1
                out.push(v)
    out

// Inner join on a single column.
// Returns list<row> where each output row is left ++ right (excluding
// the duplicate join key from the right side).
fn join_on(left: list, right: list, lkey_col: int, rkey_col: int) -> list
    let index = {}
    for r in right
        if rkey_col < len(r)
            let k = r[rkey_col]
            if not contains(index, k)
                index[k] = []
            index[k].push(r)
    let out = []
    for l in left
        if lkey_col < len(l)
            let k = l[lkey_col]
            if contains(index, k)
                for r in index[k]
                    let merged = []
                    for v in l
                        merged.push(v)
                    let ri = 0
                    while ri < len(r)
                        if ri != rkey_col
                            merged.push(r[ri])
                        ri = ri + 1
                    out.push(merged)
    out

// Sort rows by a column ascending.
fn sort_by_col(rows: list, col_idx: int) -> list
    let n = len(rows)
    let out = []
    for r in rows
        out.push(r)
    let outer = 0
    while outer < n
        let inner = 0
        while inner < n - 1
            let a = out[inner]
            let b = out[inner + 1]
            if col_idx < len(a) and col_idx < len(b)
                if a[col_idx] > b[col_idx]
                    out[inner] = b
                    out[inner + 1] = a
            inner = inner + 1
        outer = outer + 1
    out
