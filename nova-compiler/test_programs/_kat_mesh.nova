import forge_mesh

fn main()
    let c = mesh_cluster("test-cluster", ["node-1", "node-2", "node-3"])
    assert(len(c["nodes"]) == 3, "3 nodes")
    assert(c["name"] == "test-cluster", "cluster name")

    // locate returns a node for any key
    let owner = mesh_locate(c, "user:42")
    assert(owner != "", "locate returns a node")

    // partition distributes keys
    let part = mesh_partition(c, ["k1", "k2", "k3", "k4", "k5", "k6"])
    let total_keys = 0
    let pk = keys(part)
    let i = 0
    while i < len(pk)
        total_keys = total_keys + len(part[pk[i]])
        i = i + 1
    assert(total_keys == 6, "partition covers all 6 keys")

    // add node + rebalance
    let c2 = mesh_cluster("test-cluster", ["node-1", "node-2", "node-3"])
    let c3 = mesh_cluster("test-cluster", ["node-1", "node-2", "node-3", "node-4"])
    let plan = mesh_rebalance_plan(c2, c3, ["k1", "k2", "k3", "k4", "k5", "k6", "k7", "k8"])
    // some keys should move to node-4
    let moved = len(plan)
    assert(moved >= 0, "rebalance plan is a list")

    // health check
    let statuses = {"node-1": "up", "node-2": "up", "node-3": "down"}
    let h = mesh_health(c, statuses)
    assert(len(h["healthy"]) == 2, "2 healthy")
    assert(len(h["unhealthy"]) == 1, "1 unhealthy")

    // quorum
    assert(mesh_quorum(c) == 2, "quorum of 3 = 2")

    // replicas
    let reps = mesh_replicas(c, "user:42", 2)
    assert(len(reps) >= 1, "at least 1 replica")
    assert(len(reps) <= 2, "at most 2 replicas requested")

    // remove node
    let c4 = mesh_remove_node(mesh_cluster("x", ["a", "b", "c"]), "b")
    assert(len(c4["nodes"]) == 2, "after remove: 2 nodes")

    print("FORGE-MESH KAT PASS")
