import std/proof/proof_fitch

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _proof_fitch_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL _proof_fitch_test " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL _proof_fitch_test " + label + ": got=" + got + " want=" + want)
        exit(1)

// --- Inline truth-table oracle for cross-checking ---

fn _local_vars_collect(f, acc)
    let tag = f[0]
    if tag == "var"
        let nm = f[1]
        let found = false
        let i = 0
        while i < len(acc)
            if acc[i] == nm
                found = true
            i = i + 1
        if not found
            push(acc, nm)
        return null
    if tag == "not"
        _local_vars_collect(f[1], acc)
        return null
    if tag == "and"
        _local_vars_collect(f[1], acc)
        _local_vars_collect(f[2], acc)
        return null
    if tag == "or"
        _local_vars_collect(f[1], acc)
        _local_vars_collect(f[2], acc)
        return null
    if tag == "imp"
        _local_vars_collect(f[1], acc)
        _local_vars_collect(f[2], acc)
        return null
    null

fn _local_eval(f, env) -> int
    let tag = f[0]
    if tag == "top"
        return 1
    if tag == "bot"
        return 0
    if tag == "var"
        let nm = f[1]
        let i = 0
        while i < len(env)
            if env[i][0] == nm
                return env[i][1]
            i = i + 1
        return 0
    if tag == "not"
        let v = _local_eval(f[1], env)
        if v == 1
            return 0
        return 1
    if tag == "and"
        let va = _local_eval(f[1], env)
        let vb = _local_eval(f[2], env)
        if va == 1 and vb == 1
            return 1
        return 0
    if tag == "or"
        let va = _local_eval(f[1], env)
        let vb = _local_eval(f[2], env)
        if va == 1
            return 1
        if vb == 1
            return 1
        return 0
    if tag == "imp"
        let va = _local_eval(f[1], env)
        let vb = _local_eval(f[2], env)
        if va == 0
            return 1
        return vb
    0

fn _local_is_taut(f) -> bool
    let vars = []
    _local_vars_collect(f, vars)
    let nv = len(vars)
    let total = 1 << nv
    let i = 0
    while i < total
        let env = []
        let k = 0
        while k < nv
            let pair = [vars[k], (i >> k) & 1]
            push(env, pair)
            k = k + 1
        let v = _local_eval(f, env)
        if v == 0
            return false
        i = i + 1
    true

fn main()
    let fA = ["var", "A"]
    let fB = ["var", "B"]
    let fAB = ["and", fA, fB]
    let fAiA = ["imp", fA, fA]
    let fAiB = ["imp", fA, fB]

    // --- KAT 1: Fitch proof of A->A ---
    // Line 0: [1, fA, "assume"]      — assume A at depth 1
    // Line 1: [0, fAiA, ["impi",0,0]] — A->A at depth 0 by impi from line 0 to line 0
    let proof_AtoA = [[1, fA, "assume"], [0, fAiA, ["impi", 0, 0]]]
    ckb("A->A check", pfit_check(proof_AtoA), true)
    let concAtoA = pfit_conclusion(proof_AtoA)
    ckb("A->A concl not FAIL", concAtoA != "FAIL", true)
    ckb("A->A concl tag=imp", concAtoA[0] == "imp", true)
    // Cross-check: the conclusion A->A is a tautology
    ckb("A->A is tautology", _local_is_taut(concAtoA), true)

    // --- KAT 2: valid MP chain: A->B premise, A premise => B ---
    // Line 0: [0, fAiB, "premise"]
    // Line 1: [0, fA,   "premise"]
    // Line 2: [0, fB,   ["mp", 0, 1]]
    let proof_mp = [[0, fAiB, "premise"], [0, fA, "premise"], [0, fB, ["mp", 0, 1]]]
    ckb("mp chain check", pfit_check(proof_mp), true)
    ckb("mp chain concl=B", pfit_conclusion(proof_mp) != "FAIL", true)

    // --- KAT 3: and-intro + and-elim ---
    // Line 0: [0, fA, "premise"]
    // Line 1: [0, fB, "premise"]
    // Line 2: [0, fAB, ["andi", 0, 1]]
    // Line 3: [0, fA,  ["ande1", 2]]
    // Line 4: [0, fB,  ["ande2", 2]]
    let proof_and = [[0, fA, "premise"], [0, fB, "premise"], [0, fAB, ["andi", 0, 1]], [0, fA, ["ande1", 2]], [0, fB, ["ande2", 2]]]
    ckb("and proof check", pfit_check(proof_and), true)

    // --- KAT 4: reiteration ---
    // Line 0: [0, fA, "premise"]
    // Line 1: [1, fA, "assume"]   — open subproof
    // Line 2: [1, fA, ["reit",0]] — reiterate line 0 into subproof
    // Line 3: [0, fAiA, ["impi",1,2]]
    let proof_reit = [[0, fA, "premise"], [1, fA, "assume"], [1, fA, ["reit", 0]], [0, fAiA, ["impi", 1, 2]]]
    ckb("reit proof check", pfit_check(proof_reit), true)
    ckb("reit proof concl tag=imp", pfit_conclusion(proof_reit)[0] == "imp", true)

    // --- KAT 5: REJECT — citing a line inside a closed subproof (accessibility violation) ---
    // Line 0: [1, fA, "assume"]     — subproof opens
    // Line 1: [0, fAiA, ["impi",0,0]] — subproof closes here
    // Line 2: [0, fA, ["reit", 0]]  — tries to cite line 0 which is now in a closed subproof
    // Line 0 has depth 1; line 2 has depth 0. Between line 0 and line 2 is line 1 with depth 0.
    // Since depth[1]=0 < depth[0]=1, line 0 is not accessible from line 2.
    let proof_bad = [[1, fA, "assume"], [0, fAiA, ["impi", 0, 0]], [0, fA, ["reit", 0]]]
    ckb("closed subproof cite REJECTED", pfit_check(proof_bad), false)

    // --- KAT 6: REJECT — mp with wrong types ---
    // Line 0: [0, fA, "premise"]
    // Line 1: [0, fB, "premise"]
    // Line 2: [0, fB, ["mp", 0, 1]]  — line 0 is A (not A->B), so mp should fail
    let proof_bad_mp = [[0, fA, "premise"], [0, fB, "premise"], [0, fB, ["mp", 0, 1]]]
    ckb("bad mp REJECTED", pfit_check(proof_bad_mp), false)

    // --- KAT 7: REJECT — ande1 of non-conjunction ---
    // Line 0: [0, fA, "premise"]
    // Line 1: [0, fA, ["ande1", 0]]  — line 0 is A (not A/\B)
    let proof_bad_ande = [[0, fA, "premise"], [0, fA, ["ande1", 0]]]
    ckb("bad ande1 REJECTED", pfit_check(proof_bad_ande), false)

    // --- KAT 8: proof of (A/\B)->A ---
    // Line 0: [1, fAB, "assume"]
    // Line 1: [1, fA,  ["ande1", 0]]
    // Line 2: [0, ["imp", fAB, fA], ["impi", 0, 1]]
    let fABtoA = ["imp", fAB, fA]
    let proof_ABtoA = [[1, fAB, "assume"], [1, fA, ["ande1", 0]], [0, fABtoA, ["impi", 0, 1]]]
    ckb("(A/\\B)->A check", pfit_check(proof_ABtoA), true)
    ckb("(A/\\B)->A concl=imp(A/\\B,A)", pfit_conclusion(proof_ABtoA)[0] == "imp", true)
    // Cross-check: conclusion is a tautology
    ckb("(A/\\B)->A is tautology", _local_is_taut(pfit_conclusion(proof_ABtoA)), true)

    // --- KAT 9: nested subproofs — (A->B)->(A->B) ---
    // Line 0: [1, fAiB, "assume"]
    // Line 1: [0, ["imp",fAiB,fAiB], ["impi",0,0]]
    let fAiBtoAiB = ["imp", fAiB, fAiB]
    let proof_nested = [[1, fAiB, "assume"], [0, fAiBtoAiB, ["impi", 0, 0]]]
    ckb("(A->B)->(A->B) check", pfit_check(proof_nested), true)
    ckb("(A->B)->(A->B) is tautology", _local_is_taut(pfit_conclusion(proof_nested)), true)

    // --- KAT 10: CROSS-CHECK: all checked depth-0 conclusions are tautologies ---
    ckb("xcheck A->A taut", _local_is_taut(pfit_conclusion(proof_AtoA)), true)
    ckb("xcheck (A/\\B)->A taut", _local_is_taut(pfit_conclusion(proof_ABtoA)), true)
    ckb("xcheck (A->B)->(A->B) taut", _local_is_taut(pfit_conclusion(proof_nested)), true)

    print("PASS _proof_fitch_test")
