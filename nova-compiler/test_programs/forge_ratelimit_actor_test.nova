// functional: per-key token-bucket rate limiter (MY forge_ratelimit actor, distinct from forge_limits)
import forge_ratelimit

fn main()
    let rl = ratelimit_new(3, 10)
    if ratelimit_allow(rl, "ip") != 1
        print("FAIL a1")
        exit(1)
    if ratelimit_allow(rl, "ip") != 1
        print("FAIL a2")
        exit(1)
    if ratelimit_allow(rl, "ip") != 1
        print("FAIL a3")
        exit(1)
    if ratelimit_allow(rl, "ip") != 0
        print("FAIL a4 should deny")
        exit(1)
    if ratelimit_allow(rl, "other") != 1
        print("FAIL independent key")
        exit(1)
    sleep(200)
    if ratelimit_allow(rl, "ip") != 1
        print("FAIL refill after 200ms")
        exit(1)
    ratelimit_stop(rl)
    print("PASS forge_ratelimit_actor")
