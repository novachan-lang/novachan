// ══════════════════════════════════════════════════════════════════════════════
// NOVA Package Manager — `nova get`, `nova publish`, `nova update`
// Local registry, semver resolution, lockfile management.
// ══════════════════════════════════════════════════════════════════════════════

// ── Semver ───────────────────────────────────────────────────────────────────

fn semver_parse(s: string) -> dict
    let result = {"major": 0, "minor": 0, "patch": 0, "pre": "", "valid": 1}
    let parts = split(s, ".")
    if len(parts) < 2
        result["valid"] = 0
        return result
    let major_str = parts[0]
    if starts_with(major_str, "v")
        major_str = slice(major_str, 1, len(major_str))
    result["major"] = int(major_str)
    result["minor"] = int(parts[1])
    if len(parts) >= 3
        let patch_str = parts[2]
        let dash = find(patch_str, "-")
        if dash >= 0
            result["patch"] = int(slice(patch_str, 0, dash))
            result["pre"] = slice(patch_str, dash + 1, len(patch_str))
        else
            result["patch"] = int(patch_str)
    result

fn semver_cmp(a: dict, b: dict) -> int
    if a["major"] != b["major"]
        if a["major"] < b["major"]
            return -1
        return 1
    if a["minor"] != b["minor"]
        if a["minor"] < b["minor"]
            return -1
        return 1
    if a["patch"] != b["patch"]
        if a["patch"] < b["patch"]
            return -1
        return 1
    let a_pre = a["pre"]
    let b_pre = b["pre"]
    if a_pre == "" and b_pre == ""
        return 0
    if a_pre != "" and b_pre == ""
        return -1
    if a_pre == "" and b_pre != ""
        return 1
    if a_pre < b_pre
        return -1
    if a_pre > b_pre
        return 1
    0

fn semver_to_str(v: dict) -> string
    let s = str(v["major"]) + "." + str(v["minor"]) + "." + str(v["patch"])
    if v["pre"] != ""
        s = s + "-" + v["pre"]
    s

fn semver_compatible_caret(version: dict, constraint: dict) -> int
    if version["major"] != constraint["major"]
        return 0
    if semver_cmp(version, constraint) < 0
        return 0
    1

fn semver_compatible_tilde(version: dict, constraint: dict) -> int
    if version["major"] != constraint["major"]
        return 0
    if version["minor"] != constraint["minor"]
        return 0
    if semver_cmp(version, constraint) < 0
        return 0
    1

fn semver_satisfies(version: dict, constraint_str: string) -> int
    if constraint_str == "*"
        return 1
    if starts_with(constraint_str, "^")
        let c = semver_parse(slice(constraint_str, 1, len(constraint_str)))
        return semver_compatible_caret(version, c)
    if starts_with(constraint_str, "~")
        let c = semver_parse(slice(constraint_str, 1, len(constraint_str)))
        return semver_compatible_tilde(version, c)
    if starts_with(constraint_str, ">=")
        let c = semver_parse(slice(constraint_str, 2, len(constraint_str)))
        return semver_cmp(version, c) >= 0
    if starts_with(constraint_str, "=")
        let c = semver_parse(slice(constraint_str, 1, len(constraint_str)))
        return semver_cmp(version, c) == 0
    let c = semver_parse(constraint_str)
    semver_cmp(version, c) == 0

// ── Path helpers ─────────────────────────────────────────────────────────────

fn path_join(a: string, b: string) -> string
    if len(a) == 0
        return b
    if a == "."
        return b
    if ends_with(a, "/") or ends_with(a, "\\")
        return a + b
    a + "/" + b

fn home_dir() -> string
    let h = env("USERPROFILE")
    if len(h) == 0
        h = env("HOME")
    h

fn registry_dir() -> string
    // NOVA_REGISTRY lets a project (or test, or CI) point at an isolated registry
    // instead of the shared per-user one. Empty/unset -> the default ~/.nova/registry.
    let override = env("NOVA_REGISTRY")
    if len(override) > 0
        return override
    path_join(home_dir(), ".nova/registry")

fn registry_index_dir() -> string
    path_join(registry_dir(), "index")

fn registry_crates_dir() -> string
    path_join(registry_dir(), "crates")

// ── TOML-subset parser (reuse from nova_build) ───────────────────────────────

fn toml_parse(text: string) -> dict
    let result = {}
    let current_section = ""
    let lines = split(text, "\n")
    let i = 0
    while i < len(lines)
        let line = trim(lines[i])
        if len(line) == 0 or starts_with(line, "#")
            i = i + 1
            continue
        if starts_with(line, "[")
            let end_bracket = find(line, "]")
            if end_bracket > 0
                current_section = slice(line, 1, end_bracket)
                if not contains(result, current_section)
                    result[current_section] = {}
            i = i + 1
            continue
        let eq = find(line, "=")
        if eq > 0
            let key = trim(slice(line, 0, eq))
            let val = trim(slice(line, eq + 1, len(line)))
            if starts_with(val, "\"") and ends_with(val, "\"")
                val = slice(val, 1, len(val) - 1)
            if current_section != ""
                let sec = result[current_section]
                sec[key] = val
                result[current_section] = sec
            else
                result[key] = val
        i = i + 1
    result

fn get_field(manifest: dict, section: string, key: string, default_val: string) -> string
    if not contains(manifest, section)
        return default_val
    let sec = manifest[section]
    if contains(sec, key)
        return sec[key]
    default_val

// ── Package metadata ─────────────────────────────────────────────────────────

fn pkg_metadata_path(name: string, version: string) -> string
    path_join(registry_index_dir(), name + "/" + version + ".json")

fn pkg_tarball_path(name: string, version: string) -> string
    path_join(registry_crates_dir(), name + "-" + version + ".tar")

// ── ABI contract (#38) ─────────────────────────────────────────────────────────
//
// A precompiled package is only safe to load under a runtime whose struct/RTTI
// layout matches the one it was built against. This is the SONAME pattern: the
// runtime exposes a single integer ABI version; a package records the ABI it was
// published against; install/update refuses (or warns on) a mismatch instead of
// silently loading a layout-incompatible artifact. BUMP pkg_abi_version() whenever a
// nova_runtime struct/RTTI-slot layout changes in a way that breaks precompiled code.
fn pkg_abi_version() -> int
    1

// the abi recorded in a published package's metadata (0 = legacy/unknown)
fn pkg_meta_abi(name: string, version: string) -> int
    let p = pkg_metadata_path(name, version)
    if not file_exists(p)
        return 0
    let meta = toml_parse(read_file(p))
    int(get_field(meta, "package", "abi", "0"))

// 1 = safe to load: same ABI, or legacy (0) which we allow-with-warning elsewhere.
fn pkg_abi_compatible(name: string, version: string) -> int
    let a = pkg_meta_abi(name, version)
    if a == 0
        return 1
    if a == pkg_abi_version()
        return 1
    0

fn load_manifest(dir: string) -> dict
    let path = path_join(dir, "nova.toml")
    if not file_exists(path)
        print("error: no nova.toml found in " + dir)
        exit(1)
    toml_parse(read_file(path))

// ── Registry operations ──────────────────────────────────────────────────────

fn ensure_registry()
    mkdir_p(registry_dir())
    mkdir_p(registry_index_dir())
    mkdir_p(registry_crates_dir())

fn list_versions(name: string) -> list
    let idx_dir = path_join(registry_index_dir(), name)
    let files = list_dir(idx_dir)
    let versions = []
    for f in files
        if ends_with(f, ".json")
            let ver = slice(f, 0, len(f) - 5)
            push(versions, ver)
    versions

fn _list_has_str(xs: list, s: string) -> int
    for x in xs
        if x == s
            return 1
    0

// Highest published version of `name` that satisfies EVERY constraint in `cons`
// (constraint intersection). "" if none qualifies. Single-constraint callers go
// through best_version, which is just the 1-element case.
fn best_version_multi(name: string, cons: list) -> string
    let versions = list_versions(name)
    let best = ""
    let best_sv = {}
    for v in versions
        let sv = semver_parse(v)
        if sv["valid"] == 0
            continue
        let ok = 1
        for c in cons
            if semver_satisfies(sv, c) == 0
                ok = 0
        if ok == 0
            continue
        if best == "" or semver_cmp(sv, best_sv) > 0
            best = v
            best_sv = sv
    best

fn best_version(name: string, constraint: string) -> string
    best_version_multi(name, [constraint])

// ── Dependency resolution (full transitive closure + constraint intersection) ──
//
// The previous resolver was a greedy 2-level "nearest wins": it walked direct deps
// and their direct deps ONLY (a dep three levels down was silently dropped), kept
// the FIRST version chosen for a transitive package (a later, tighter constraint was
// ignored — the resolved version might not satisfy every consumer), and could not
// report a genuine conflict (two incompatible exact pins quietly mis-resolved).
//
// resolve_graph is a fixpoint worklist over the WHOLE dependency graph:
//   - every requirement (name, constraint) discovered anywhere is recorded,
//   - each package is pinned to the HIGHEST version satisfying ALL its constraints
//     (intersection); when a newly discovered constraint lowers that choice, the
//     package is re-expanded so its (possibly different) deps are re-walked,
//   - constraints only ever accumulate and the chosen version only ever decreases
//     over a finite version set, so the fixpoint terminates; cycles (a->b->a) are
//     absorbed because a repeated (name,constraint) re-pins to the same version and
//     stops expanding,
//   - if no version satisfies the accumulated constraints, it's a real conflict.
//
// Returns {"ok":1,"resolved":{name->version}} or
//         {"ok":0,"pkg":name,"error":msg}. The CLI wrapper resolve_deps turns a
// conflict into a clear error+exit; tests call resolve_graph directly and assert.
fn resolve_graph(manifest: dict) -> dict
    let constraints = {}    // name -> list of every constraint string seen for it
    let resolved = {}       // name -> currently-chosen version
    let q_names = []        // FIFO of pending requirements (index-pointer queue)
    let q_cons = []
    if contains(manifest, "dependencies")
        let deps = manifest["dependencies"]
        for name in keys(deps)
            push(q_names, name)
            push(q_cons, deps[name])
    let head = 0
    let guard = 0
    while head < len(q_names)
        guard = guard + 1
        if guard > 1000000
            return {"ok": 0, "pkg": "", "error": "dependency resolution did not converge"}
        let name = q_names[head]
        let constraint = q_cons[head]
        head = head + 1
        let clist = []
        if contains(constraints, name)
            clist = constraints[name]
        if not _list_has_str(clist, constraint)
            push(clist, constraint)
        constraints[name] = clist
        let chosen = best_version_multi(name, clist)
        if chosen == ""
            return {"ok": 0, "pkg": name, "error": "no version of '" + name + "' satisfies all constraints: " + join(clist, ", ")}
        let prev = ""
        if contains(resolved, name)
            prev = resolved[name]
        if chosen == prev
            continue
        resolved[name] = chosen
        let meta_path = pkg_metadata_path(name, chosen)
        if file_exists(meta_path)
            let meta = toml_parse(read_file(meta_path))
            if contains(meta, "dependencies")
                let tdeps = meta["dependencies"]
                for tn in keys(tdeps)
                    push(q_names, tn)
                    push(q_cons, tdeps[tn])
    {"ok": 1, "resolved": resolved}

fn resolve_deps(manifest: dict) -> dict
    let r = resolve_graph(manifest)
    if r["ok"] == 0
        print("error: cannot resolve dependencies: " + r["error"])
        if r["pkg"] != ""
            print("  Available versions of '" + r["pkg"] + "': " + str(list_versions(r["pkg"])))
        exit(1)
    r["resolved"]

// ── Lockfile + content integrity ─────────────────────────────────────────────
//
// "sha256:<hex>" over the canonical, deterministic serialization of a published
// package's files (sorted by name; each entry = name, byte-length, then bytes — the
// length pins the boundary so no concat collision can forge a match). This is what
// makes a build REPRODUCIBLE (same lock -> provably same sources) and tamper-evident
// (a republished/mutated registry crate no longer matches the locked hash). "" means
// the crate's files aren't present to hash.
fn pkg_content_hash(name: string, version: string) -> string
    let crate_dir = path_join(registry_crates_dir(), name + "-" + version)
    let files = sort(list_dir(crate_dir))
    if len(files) == 0
        return ""
    let acc = ""
    for f in files
        let body = read_file(path_join(crate_dir, f))
        acc = acc + f + "\n" + str(len(body)) + "\n" + body + "\n"
    "sha256:" + sha256(acc)

// The lockfile is two TOML sections: [dependencies] name="ver" and [integrity]
// name="sha256:...". Both are emitted so a checkout can verify sources without the
// registry. read_lockfile returns ONLY the version map (shape unchanged for callers);
// read_lockfile_integrity returns the hash map. Section-aware parsing also accepts a
// LEGACY flat lockfile (no section headers) as the dependencies section.
fn write_lockfile(dir: string, resolved: dict)
    let names = sort(keys(resolved))
    let content = "# nova.lock - auto-generated, do not edit\n"
    content = content + "# Generated by nova-pkg\n\n"
    content = content + "[dependencies]\n"
    for name in names
        content = content + name + " = \"" + resolved[name] + "\"\n"
    content = content + "\n[integrity]\n"
    for name in names
        let h = pkg_content_hash(name, resolved[name])
        if h != ""
            content = content + name + " = \"" + h + "\"\n"
    write_file(path_join(dir, "nova.lock"), content)
    print("  Written nova.lock")

fn _read_lock_section(dir: string, want: string) -> dict
    let path = path_join(dir, "nova.lock")
    if not file_exists(path)
        return {}
    let text = read_file(path)
    let result = {}
    let section = ""
    let lines = split(text, "\n")
    for line in lines
        let trimmed = trim(line)
        if len(trimmed) == 0 or starts_with(trimmed, "#")
            continue
        if starts_with(trimmed, "[")
            let rb = find(trimmed, "]")
            if rb > 0
                section = slice(trimmed, 1, rb)
            continue
        let eq = find(trimmed, "=")
        if eq > 0
            // legacy flat lockfile (no [section]) counts as the dependencies section
            let in_section = section == want or (want == "dependencies" and section == "")
            if in_section
                let key = trim(slice(trimmed, 0, eq))
                let val = trim(slice(trimmed, eq + 1, len(trimmed)))
                if starts_with(val, "\"") and ends_with(val, "\"")
                    val = slice(val, 1, len(val) - 1)
                result[key] = val
    result

fn read_lockfile(dir: string) -> dict
    _read_lock_section(dir, "dependencies")

fn read_lockfile_integrity(dir: string) -> dict
    _read_lock_section(dir, "integrity")

// ── Publish command ──────────────────────────────────────────────────────────

fn cmd_publish(args: list)
    let dir = "."
    if len(args) > 0
        dir = args[0]
    let manifest = load_manifest(dir)
    let name = get_field(manifest, "package", "name", "")
    let version = get_field(manifest, "package", "version", "")
    if name == "" or version == ""
        print("error: nova.toml must have [package] name and version")
        exit(1)
    ensure_registry()
    let pkg_dir = path_join(registry_index_dir(), name)
    mkdir_p(pkg_dir)
    let meta_content = "[package]\nname = \"" + name + "\"\nversion = \"" + version + "\"\nabi = \"" + str(pkg_abi_version()) + "\"\n"
    if contains(manifest, "dependencies")
        meta_content = meta_content + "\n[dependencies]\n"
        let deps = manifest["dependencies"]
        let dep_names = keys(deps)
        for dn in dep_names
            meta_content = meta_content + dn + " = \"" + deps[dn] + "\"\n"
    write_file(pkg_metadata_path(name, version), meta_content)
    let src_dir = path_join(dir, get_field(manifest, "package", "src", "src"))
    let tar_dir = path_join(registry_crates_dir(), name + "-" + version)
    mkdir_p(tar_dir)
    let src_files = list_dir(src_dir)
    for f in src_files
        if ends_with(f, ".nova")
            let content = read_file(path_join(src_dir, f))
            write_file(path_join(tar_dir, f), content)
    let toml_content = read_file(path_join(dir, "nova.toml"))
    write_file(path_join(tar_dir, "nova.toml"), toml_content)
    print("Published " + name + " v" + version + " to local registry")

// ── Install command (nova get) ───────────────────────────────────────────────

fn cmd_get(args: list)
    if len(args) == 0
        print("Usage: nova-pkg get <package> [version]")
        exit(1)
    let pkg_name = args[0]
    // Default to "*" (latest available) when no version is requested. A caret
    // default like "^0.0.0" would reject every real release whose major > 0.
    let constraint = "*"
    if len(args) > 1
        constraint = args[1]
    else
        let at = find(pkg_name, "@")
        if at > 0
            constraint = "^" + slice(pkg_name, at + 1, len(pkg_name))
            pkg_name = slice(pkg_name, 0, at)
    let version = best_version(pkg_name, constraint)
    if version == ""
        print("error: package '" + pkg_name + "' not found in registry")
        print("  Available: " + str(list_versions(pkg_name)))
        exit(1)
    let manifest_path = "nova.toml"
    if not file_exists(manifest_path)
        print("error: no nova.toml in current directory. Run 'nova-build init' first.")
        exit(1)
    let text = read_file(manifest_path)
    if not contains(text, "[dependencies]")
        text = text + "\n[dependencies]\n"
    text = text + pkg_name + " = \"^" + version + "\"\n"
    write_file(manifest_path, text)
    let dep_src = path_join(registry_crates_dir(), pkg_name + "-" + version)
    let local_deps = "deps/" + pkg_name
    mkdir_p("deps")
    mkdir_p(local_deps)
    let dep_files = list_dir(dep_src)
    for f in dep_files
        let content = read_file(path_join(dep_src, f))
        write_file(path_join(local_deps, f), content)
    print("Installed " + pkg_name + " v" + version)
    print("  Added to nova.toml [dependencies]")
    print("  Source in deps/" + pkg_name + "/")

// ── Update command ───────────────────────────────────────────────────────────

fn cmd_update(args: list)
    let manifest = load_manifest(".")
    let resolved = resolve_deps(manifest)
    // Reproducibility check: if a prior lock recorded integrity hashes, a registry
    // crate whose content no longer matches its locked hash is flagged loudly (a
    // republished or tampered package) before we overwrite the lock.
    let prior = read_lockfile_integrity(".")
    let mismatches = 0
    let abi_bad = 0
    for pn in keys(resolved)
        if contains(prior, pn)
            let cur = pkg_content_hash(pn, resolved[pn])
            if cur != "" and prior[pn] != "" and prior[pn] != cur
                print("  WARNING: integrity mismatch for " + pn + " v" + resolved[pn] + " (registry content changed since lock)")
                mismatches = mismatches + 1
        if pkg_abi_compatible(pn, resolved[pn]) == 0
            print("  WARNING: ABI mismatch for " + pn + " v" + resolved[pn] + " (built for ABI " + str(pkg_meta_abi(pn, resolved[pn])) + ", runtime is ABI " + str(pkg_abi_version()) + ") -- recompile required")
            abi_bad = abi_bad + 1
    if mismatches > 0
        print("  " + str(mismatches) + " package(s) failed integrity check.")
    if abi_bad > 0
        print("  " + str(abi_bad) + " package(s) ABI-incompatible with this runtime.")
    write_lockfile(".", resolved)
    let names = keys(resolved)
    mkdir_p("deps")
    for name in names
        let version = resolved[name]
        let dep_src = path_join(registry_crates_dir(), name + "-" + version)
        let local_deps = "deps/" + name
        mkdir_p(local_deps)
        let upd_files = list_dir(dep_src)
        for f in upd_files
            let content = read_file(path_join(dep_src, f))
            write_file(path_join(local_deps, f), content)
        print("  " + name + " v" + version)
    print("Updated " + str(len(names)) + " dependencies.")

// ── Remove command ───────────────────────────────────────────────────────────

fn cmd_remove(args: list)
    if len(args) == 0
        print("Usage: nova-pkg remove <package>")
        exit(1)
    let pkg_name = args[0]
    let text = read_file("nova.toml")
    let lines = split(text, "\n")
    let result = []
    for line in lines
        if not starts_with(trim(line), pkg_name + " =") and not starts_with(trim(line), pkg_name + "=")
            push(result, line)
    write_file("nova.toml", join(result, "\n"))
    print("Removed " + pkg_name + " from nova.toml")

// ── List command ─────────────────────────────────────────────────────────────

fn cmd_list(args: list)
    let manifest = load_manifest(".")
    if not contains(manifest, "dependencies")
        print("No dependencies.")
        return 0
    let deps = manifest["dependencies"]
    let names = keys(deps)
    if len(names) == 0
        print("No dependencies.")
        return 0
    print("Dependencies:")
    for name in names
        let constraint = deps[name]
        let lock = read_lockfile(".")
        let locked_ver = ""
        if contains(lock, name)
            locked_ver = " (locked: " + lock[name] + ")"
        print("  " + name + " " + constraint + locked_ver)
    0

// ── Search command ───────────────────────────────────────────────────────────

fn cmd_search(args: list)
    if len(args) == 0
        print("Usage: nova-pkg search <query>")
        exit(1)
    let query = args[0]
    let idx = registry_index_dir()
    let packages = list_dir(idx)
    if len(packages) == 0
        print("Registry empty. No packages published yet.")
        return 0
    let found = 0
    for pkg in packages
        if contains(pkg, query)
            let versions = list_versions(pkg)
            print("  " + pkg + " (" + str(len(versions)) + " versions)")
            found = found + 1
    if found == 0
        print("No packages matching '" + query + "'")
    else
        print(str(found) + " package(s) found.")
    0

// ── Info command ─────────────────────────────────────────────────────────────

fn cmd_info(args: list)
    if len(args) == 0
        print("Usage: nova-pkg info <package>")
        exit(1)
    let name = args[0]
    let versions = list_versions(name)
    if len(versions) == 0
        print("Package '" + name + "' not found.")
        exit(1)
    print("Package: " + name)
    print("Versions: " + str(len(versions)))
    for v in versions
        let meta_path = pkg_metadata_path(name, v)
        if file_exists(meta_path)
            let meta = toml_parse(read_file(meta_path))
            let deps_str = ""
            if contains(meta, "dependencies")
                let d = meta["dependencies"]
                deps_str = " [deps: " + str(len(keys(d))) + "]"
            print("  " + v + deps_str)
        else
            print("  " + v)

// ── Selftest (resolver correctness, isolated registry) ──────────────────────────

fn _publish_fixture(name: string, version: string, deps: dict)
    ensure_registry()
    mkdir_p(path_join(registry_index_dir(), name))
    let meta = "[package]\nname = \"" + name + "\"\nversion = \"" + version + "\"\nabi = \"" + str(pkg_abi_version()) + "\"\n"
    if len(keys(deps)) > 0
        meta = meta + "\n[dependencies]\n"
        for dn in keys(deps)
            meta = meta + dn + " = \"" + deps[dn] + "\"\n"
    write_file(pkg_metadata_path(name, version), meta)
    // also drop real crate files so content-hashing has something to hash
    let crate_dir = path_join(registry_crates_dir(), name + "-" + version)
    mkdir_p(crate_dir)
    write_file(path_join(crate_dir, "lib.nova"), "// " + name + " v" + version + "\nfn _id() -> string\n    \"" + name + "@" + version + "\"\n")
    write_file(path_join(crate_dir, "nova.toml"), meta)

// Run with NOVA_REGISTRY pointed at a throwaway dir (the harness does this) so the
// shared registry is never touched. Exercises the four properties the old greedy
// resolver got wrong: deep transitivity, constraint intersection, conflict, cycles.
fn cmd_selftest(args: list)
    // c: a package with several versions across two majors
    _publish_fixture("c", "1.0.0", {})
    _publish_fixture("c", "1.1.0", {})
    _publish_fixture("c", "1.2.0", {})
    _publish_fixture("c", "2.0.0", {})
    // a needs c ^1.0, b needs c ^1.1 -> intersection must be 1.x AND >=1.1 -> 1.2.0
    _publish_fixture("a", "1.0.0", {"c": "^1.0.0"})
    _publish_fixture("b", "1.0.0", {"c": "^1.1.0"})
    // deep chain d -> e -> f (3 levels; the old 2-level resolver dropped f)
    _publish_fixture("f", "3.0.0", {})
    _publish_fixture("e", "2.0.0", {"f": "^3.0.0"})
    _publish_fixture("d", "1.0.0", {"e": "^2.0.0"})

    // 1) Diamond + constraint intersection
    let r1 = resolve_graph({"dependencies": {"a": "^1.0.0", "b": "^1.0.0"}})
    assert(r1["ok"] == 1, "diamond resolves")
    let res1 = r1["resolved"]
    assert(res1["a"] == "1.0.0", "a pinned")
    assert(res1["b"] == "1.0.0", "b pinned")
    assert(res1["c"] == "1.2.0", "c intersected: highest 1.x satisfying ^1.0 AND ^1.1")
    assert(len(keys(res1)) == 3, "diamond deduped to a,b,c")

    // 2) Deep transitive closure (3 levels)
    let r2 = resolve_graph({"dependencies": {"d": "^1.0.0"}})
    assert(r2["ok"] == 1, "deep chain resolves")
    let res2 = r2["resolved"]
    assert(res2["d"] == "1.0.0", "depth-1 d")
    assert(res2["e"] == "2.0.0", "depth-2 e")
    assert(res2["f"] == "3.0.0", "depth-3 f (old resolver missed this)")

    // 3) Genuine conflict (incompatible exact pins on c)
    _publish_fixture("g", "1.0.0", {"c": "=1.0.0"})
    _publish_fixture("h", "1.0.0", {"c": "=2.0.0"})
    let r3 = resolve_graph({"dependencies": {"g": "^1.0.0", "h": "^1.0.0"}})
    assert(r3["ok"] == 0, "conflict detected (old resolver silently mis-picked)")
    assert(r3["pkg"] == "c", "conflict reported on c")

    // 4) Cycle safety (x <-> y) must terminate, not hang
    _publish_fixture("x", "1.0.0", {"y": "^1.0.0"})
    _publish_fixture("y", "1.0.0", {"x": "^1.0.0"})
    let r4 = resolve_graph({"dependencies": {"x": "^1.0.0"}})
    assert(r4["ok"] == 1, "cycle resolves without hang")
    let res4 = r4["resolved"]
    assert(res4["x"] == "1.0.0", "cycle x")
    assert(res4["y"] == "1.0.0", "cycle y")

    // 5) Content integrity: deterministic, version-distinguishing, lockfile round-trip
    let h1 = pkg_content_hash("c", "1.2.0")
    assert(starts_with(h1, "sha256:"), "content hash is sha256-tagged")
    assert(len(h1) == 71, "sha256: + 64 hex chars")
    assert(h1 == pkg_content_hash("c", "1.2.0"), "content hash is deterministic")
    assert(h1 != pkg_content_hash("c", "1.1.0"), "different versions hash differently")
    let scratch = env("NOVA_REGISTRY")
    write_lockfile(scratch, {"a": "1.0.0", "c": "1.2.0"})
    assert(read_lockfile(scratch)["c"] == "1.2.0", "lockfile version round-trips")
    assert(read_lockfile_integrity(scratch)["c"] == h1, "lockfile integrity round-trips + matches recomputed hash")

    // 6) Tamper detection: mutating a published file changes its content hash
    _publish_fixture("c", "1.2.0", {})
    write_file(path_join(path_join(registry_crates_dir(), "c-1.2.0"), "lib.nova"), "// tampered\nfn evil() -> int\n    1\n")
    assert(pkg_content_hash("c", "1.2.0") != h1, "tampered crate hashes differently (reproducibility breach detected)")

    // 7) ABI contract (#38): fixtures publish at the current ABI -> compatible; a
    // package tagged with a different ABI is flagged incompatible (not silently loaded).
    assert(pkg_meta_abi("a", "1.0.0") == pkg_abi_version(), "fixture recorded current ABI")
    assert(pkg_abi_compatible("a", "1.0.0") == 1, "current-ABI package is compatible")
    // simulate a package built for a future/incompatible runtime ABI
    mkdir_p(path_join(registry_index_dir(), "oldpkg"))
    write_file(pkg_metadata_path("oldpkg", "1.0.0"), "[package]\nname = \"oldpkg\"\nversion = \"1.0.0\"\nabi = \"999\"\n")
    assert(pkg_meta_abi("oldpkg", "1.0.0") == 999, "reads recorded abi 999")
    assert(pkg_abi_compatible("oldpkg", "1.0.0") == 0, "ABI 999 incompatible with runtime ABI 1")
    // a legacy package with no abi field (0) is allowed (compat, warn elsewhere)
    mkdir_p(path_join(registry_index_dir(), "legacy"))
    write_file(pkg_metadata_path("legacy", "1.0.0"), "[package]\nname = \"legacy\"\nversion = \"1.0.0\"\n")
    assert(pkg_meta_abi("legacy", "1.0.0") == 0, "no abi field -> 0 (legacy)")
    assert(pkg_abi_compatible("legacy", "1.0.0") == 1, "legacy abi allowed")

    print("pkg-resolver: all passed")

// ── Main entry point ─────────────────────────────────────────────────────────

fn main()
    let argv = args()
    if len(argv) < 2
        print("nova-pkg: NOVA package manager")
        print("")
        print("Commands:")
        print("  get <pkg>[@ver]   Install a package")
        print("  publish [dir]     Publish to local registry")
        print("  update            Update all deps to latest compatible")
        print("  remove <pkg>      Remove a dependency")
        print("  list              List current dependencies")
        print("  search <query>    Search registry")
        print("  info <pkg>        Show package details")
        print("  selftest          Run resolver correctness tests")
        print("  version           Show version")
        print("")
        print("Usage: nova-pkg <command> [args...]")
        exit(0)
    let cmd = argv[1]
    let rest = []
    let ri = 2
    while ri < len(argv)
        push(rest, argv[ri])
        ri = ri + 1
    if cmd == "get"
        cmd_get(rest)
    else if cmd == "publish"
        cmd_publish(rest)
    else if cmd == "update"
        cmd_update(rest)
    else if cmd == "remove"
        cmd_remove(rest)
    else if cmd == "list"
        cmd_list(rest)
    else if cmd == "search"
        cmd_search(rest)
    else if cmd == "info"
        cmd_info(rest)
    else if cmd == "selftest"
        cmd_selftest(rest)
    else if cmd == "version"
        print("nova-pkg 0.1.0")
        print("NOVA Package Manager")
    else
        print("Unknown command: " + cmd)
        print("Run 'nova-pkg' without arguments for help.")
        exit(1)
