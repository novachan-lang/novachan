// topox.nova — topological sort with cycle detection (Kahn's algorithm).
//
// Orders the nodes of a dependency graph so every edge points "forward" — the
// foundation of build systems, task schedulers, package/dependency resolution,
// and spreadsheet recompute. Detects cycles (an impossible ordering). The graph
// is an adjacency dict {node: [nodes it must come BEFORE]}.

fn topo_sort(adj)
  // in-degree of every node (incl. nodes that only appear as successors).
  let indeg = {}
  for node in keys(adj)
    if not contains(indeg, node)
      indeg[node] = 0
    for succ in adj[node]
      if not contains(indeg, succ)
        indeg[succ] = 0
      indeg[succ] = indeg[succ] + 1
  // start from every node with no prerequisites.
  let queue = []
  for node in keys(indeg)
    if indeg[node] == 0
      push(queue, node)
  let order = []
  let qi = 0
  while qi < len(queue)
    let n = queue[qi]
    qi = qi + 1
    push(order, n)
    if contains(adj, n)
      for succ in adj[n]
        indeg[succ] = indeg[succ] - 1
        if indeg[succ] == 0
          push(queue, succ)
  let result = {}
  result["order"] = order
  let cyclic = 0
  if len(order) != len(keys(indeg))
    cyclic = 1                 // some nodes never hit in-degree 0 => a cycle
  result["cyclic"] = cyclic
  result

// position of `node` in an ordering list (-1 if absent).
fn _pos(order, node)
  let i = 0
  while i < len(order)
    if order[i] == node
      return i
    i = i + 1
  0 - 1

// ── Tests ────────────────────────────────────────────────────────────

// a diamond DAG:  a -> b, a -> c, b -> d, c -> d
let g = {}
g["a"] = ["b", "c"]
g["b"] = ["d"]
g["c"] = ["d"]
g["d"] = []
let r = topo_sort(g)
assert(r["cyclic"] == 0, "DAG has no cycle")
let ord = r["order"]
assert(len(ord) == 4, "all 4 nodes ordered")
assert(_pos(ord, "a") < _pos(ord, "b"), "a before b")
assert(_pos(ord, "a") < _pos(ord, "c"), "a before c")
assert(_pos(ord, "b") < _pos(ord, "d"), "b before d")
assert(_pos(ord, "c") < _pos(ord, "d"), "c before d")
assert(_pos(ord, "a") == 0, "a (no deps) is first")
assert(_pos(ord, "d") == 3, "d (depends on all) is last")
print("PASS: diamond DAG ordering")

// a longer chain: compile -> link -> test
let build = {}
build["compile"] = ["link"]
build["link"] = ["test"]
build["test"] = []
let rb = topo_sort(build)
assert(rb["cyclic"] == 0, "build chain acyclic")
let bo = rb["order"]
assert(bo[0] == "compile", "compile first")
assert(bo[1] == "link", "then link")
assert(bo[2] == "test", "then test")
print("PASS: build chain")

// a cycle:  x -> y -> x
let cyc = {}
cyc["x"] = ["y"]
cyc["y"] = ["x"]
let rc = topo_sort(cyc)
assert(rc["cyclic"] == 1, "x<->y cycle detected")
print("PASS: cycle detection")

// independent nodes (no edges) all come out.
let ind = {}
ind["p"] = []
ind["q"] = []
ind["r"] = []
let ri = topo_sort(ind)
assert(ri["cyclic"] == 0, "no edges, no cycle")
assert(len(ri["order"]) == 3, "all independent nodes ordered")
print("PASS: independent nodes")

print("ALL PASS: topox — topological sort + cycle detection")
