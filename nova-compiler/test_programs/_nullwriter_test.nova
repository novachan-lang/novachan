// KAT test for std/io/nullwriter
import std/io/nullwriter

fn main()
    // ── KAT 1: fresh writer starts at zero ────────────────────────────────────
    let w = nw_new()
    let k1_bytes = nw_bytes(w)
    let k1_writes = nw_writes(w)
    if k1_bytes != 0
        print("FAIL: nw_new bytes expected 0 got " + str(k1_bytes))
        exit(1)
    if k1_writes != 0
        print("FAIL: nw_new writes expected 0 got " + str(k1_writes))
        exit(1)

    // ── KAT 2: nw_write("abc") -> bytes=3, writes=1 ───────────────────────────
    nw_write(w, "abc")
    let k2_bytes = nw_bytes(w)
    let k2_writes = nw_writes(w)
    if k2_bytes != 3
        print("FAIL: after write(abc) bytes expected 3 got " + str(k2_bytes))
        exit(1)
    if k2_writes != 1
        print("FAIL: after write(abc) writes expected 1 got " + str(k2_writes))
        exit(1)

    // ── KAT 3: nw_write("de") -> bytes=5, writes=2 ────────────────────────────
    nw_write(w, "de")
    let k3_bytes = nw_bytes(w)
    let k3_writes = nw_writes(w)
    if k3_bytes != 5
        print("FAIL: after write(de) bytes expected 5 got " + str(k3_bytes))
        exit(1)
    if k3_writes != 2
        print("FAIL: after write(de) writes expected 2 got " + str(k3_writes))
        exit(1)

    // ── KAT 4: nw_writeln("x") -> bytes=7 (+len("x")+1=2), writes=3 ──────────
    nw_writeln(w, "x")
    let k4_bytes = nw_bytes(w)
    let k4_writes = nw_writes(w)
    if k4_bytes != 7
        print("FAIL: after writeln(x) bytes expected 7 got " + str(k4_bytes))
        exit(1)
    if k4_writes != 3
        print("FAIL: after writeln(x) writes expected 3 got " + str(k4_writes))
        exit(1)

    // ── KAT 5: nw_reset resets both counters to zero ──────────────────────────
    nw_reset(w)
    let k5_bytes = nw_bytes(w)
    let k5_writes = nw_writes(w)
    if k5_bytes != 0
        print("FAIL: after reset bytes expected 0 got " + str(k5_bytes))
        exit(1)
    if k5_writes != 0
        print("FAIL: after reset writes expected 0 got " + str(k5_writes))
        exit(1)

    // ── KAT 6: nw_writeln with empty string counts 1 byte (the newline) ───────
    nw_writeln(w, "")
    let k6_bytes = nw_bytes(w)
    let k6_writes = nw_writes(w)
    if k6_bytes != 1
        print("FAIL: writeln() bytes expected 1 got " + str(k6_bytes))
        exit(1)
    if k6_writes != 1
        print("FAIL: writeln() writes expected 1 got " + str(k6_writes))
        exit(1)

    // ── KAT 7: nw_write with empty string counts 0 bytes, 1 write ─────────────
    nw_write(w, "")
    let k7_bytes = nw_bytes(w)
    let k7_writes = nw_writes(w)
    if k7_bytes != 1
        print("FAIL: write() bytes expected 1 got " + str(k7_bytes))
        exit(1)
    if k7_writes != 2
        print("FAIL: write() writes expected 2 got " + str(k7_writes))
        exit(1)

    // ── KAT 8: independent writers do not share state ─────────────────────────
    let w2 = nw_new()
    nw_write(w2, "hello world")
    let k8_w1_bytes = nw_bytes(w)
    let k8_w2_bytes = nw_bytes(w2)
    if k8_w1_bytes != 1
        print("FAIL: w1 bytes should still be 1 got " + str(k8_w1_bytes))
        exit(1)
    if k8_w2_bytes != 11
        print("FAIL: w2 bytes expected 11 got " + str(k8_w2_bytes))
        exit(1)

    print("_nullwriter_test passed")
