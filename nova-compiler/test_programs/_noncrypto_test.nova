// _noncrypto_test.nova — KAT test for std/hash/noncrypto
// Covers h_fnv1a32, h_djb2, h_sdbm, h_crc32 with >= 6 known-answer assertions.
// All reference values hand-computed and cross-verified against authoritative
// reference implementations (Python's binascii.crc32, standard FNV-1a vectors, etc.)

import std/hash/noncrypto

fn cki(label: str, got: int, want: int)
    if got == want
        return
    print("FAIL " + label + ": got " + str(got) + " want " + str(want))
    exit(1)

fn main()
    // --- FNV-1a 32-bit ---
    // Empty string: just the offset basis (2166136261 = 0x811c9dc5)
    cki("fnv1a32_empty",  h_fnv1a32(""),          2166136261)
    // "a" = (2166136261 ^ 97) * 16777619 & 0xFFFFFFFF = 3826002220
    cki("fnv1a32_a",      h_fnv1a32("a"),          3826002220)
    // "hello" = 1335831723 (standard FNV-1a vector)
    cki("fnv1a32_hello",  h_fnv1a32("hello"),      1335831723)

    // --- DJB2 ---
    // Empty string: init value = 5381
    cki("djb2_empty",     h_djb2(""),              5381)
    // "hello" = 261238937
    cki("djb2_hello",     h_djb2("hello"),         261238937)
    // "test" = 2090756197
    cki("djb2_test",      h_djb2("test"),          2090756197)

    // --- SDBM ---
    // Empty string: init value = 0
    cki("sdbm_empty",     h_sdbm(""),              0)
    // "hello" = 684824882
    cki("sdbm_hello",     h_sdbm("hello"),         684824882)
    // "test" = 1195757874
    cki("sdbm_test",      h_sdbm("test"),          1195757874)

    // --- CRC-32/ISO-HDLC ---
    // Standard check value: CRC-32 of "123456789" = 3421780262 (0xCBF43926)
    // This is the authoritative ISO-HDLC / zlib CRC-32 check value.
    cki("crc32_check",    h_crc32("123456789"),    3421780262)
    // Empty string: CRC of empty = 0 (0xFFFFFFFF XOR 0xFFFFFFFF = 0)
    cki("crc32_empty",    h_crc32(""),             0)
    // "a" = 3904355907 (0xE8B7BE43)
    cki("crc32_a",        h_crc32("a"),            3904355907)
    // "hello" = 907060870 (0x3610A686)
    cki("crc32_hello",    h_crc32("hello"),        907060870)

    print("_noncrypto_test passed")
