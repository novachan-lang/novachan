// KAT for std/control/trajectory -- polynomial trajectory generation.
import std/control/trajectory

fn approx(a: float, b: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    d < 0.0001

fn ckf(label: string, got: float, want: float)
    if not approx(got, want)
        print("FAIL trajectory " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // -- cubic rest-to-rest: q0=0, qf=10, tf=2 --
    let cb = traj_cubic(0.0, 10.0, 2.0)
    // q(0) = 0
    ckf("cubic_pos t=0", traj_cubic_pos(cb, 0.0), 0.0)
    // q(2) = 10
    ckf("cubic_pos t=tf", traj_cubic_pos(cb, 2.0), 10.0)
    // q(1) = 5 (symmetric midpoint for rest-to-rest cubic)
    ckf("cubic_pos t=tf/2", traj_cubic_pos(cb, 1.0), 5.0)
    // v(0) = 0 (rest start)
    ckf("cubic_vel t=0", traj_cubic_vel(cb, 0.0), 0.0)
    // v(tf) = 0 (rest end)
    ckf("cubic_vel t=tf", traj_cubic_vel(cb, 2.0), 0.0)

    // -- linear --
    ckf("linear t=1", traj_linear(0.0, 10.0, 2.0, 1.0), 5.0)

    // -- lerp --
    ckf("lerp 0.5", traj_lerp(2.0, 4.0, 0.5), 3.0)

    // -- quintic: q0=0, qf=1, tf=1 --
    let qn = traj_quintic(0.0, 1.0, 1.0)
    ckf("quintic_pos t=0", traj_quintic_pos(qn, 0.0), 0.0)
    ckf("quintic_pos t=1", traj_quintic_pos(qn, 1.0), 1.0)
    ckf("quintic_vel t=0", traj_quintic_vel(qn, 0.0), 0.0)
    ckf("quintic_vel t=1", traj_quintic_vel(qn, 1.0), 0.0)

    // -- traj_duration --
    ckf("duration cubic", traj_duration(cb), 2.0)
    ckf("duration quintic", traj_duration(qn), 1.0)

    // -- traj_eval dispatches on order --
    ckf("eval cubic t=0", traj_eval(cb, 0.0), 0.0)
    ckf("eval quintic t=0", traj_eval(qn, 0.0), 0.0)

    // -- via_points piecewise linear --
    let vpts = [0.0, 5.0, 10.0]
    let vtms = [0.0, 1.0, 2.0]
    ckf("via_points t=0", traj_via_points(vpts, vtms, 0.0), 0.0)
    ckf("via_points t=0.5", traj_via_points(vpts, vtms, 0.5), 2.5)
    ckf("via_points t=1.5", traj_via_points(vpts, vtms, 1.5), 7.5)
    ckf("via_points t=2", traj_via_points(vpts, vtms, 2.0), 10.0)

    // -- multi_cubic endpoints --
    let mpts = [0.0, 10.0]
    let mtms = [0.0, 2.0]
    ckf("multi_cubic t=0", traj_multi_cubic(mpts, mtms, 0.0), 0.0)
    ckf("multi_cubic t=2", traj_multi_cubic(mpts, mtms, 2.0), 10.0)

    print("PASS _trajectory_test")
