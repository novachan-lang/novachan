import std/permutation/perm_sign

// cki — check integer equality
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _perm_sign_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb — check bool equality
fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL _perm_sign_test " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn main()
    // --- ps_sign ---
    // [1,0,2]: (0,1) + (2) -> 2 cycles, n=3, exp=1 -> odd -> -1
    cki("sign_102", ps_sign([1, 0, 2]), -1)

    // [1,2,0]: (0,1,2) -> 1 cycle, n=3, exp=2 -> even -> +1
    cki("sign_120", ps_sign([1, 2, 0]), 1)

    // [0,1,2]: 3 fixed points -> 3 cycles, n=3, exp=0 -> even -> +1
    cki("sign_identity", ps_sign([0, 1, 2]), 1)

    // [1,2,0,4,3]: (0,1,2) + (3,4) -> 2 cycles, n=5, exp=3 -> odd -> -1
    cki("sign_120_43", ps_sign([1, 2, 0, 4, 3]), -1)

    // [2,1,0]: (0,2)+(1) -> 2 cycles, n=3, exp=1 -> odd -> -1
    cki("sign_210", ps_sign([2, 1, 0]), -1)

    // empty perm -> +1 (even by convention)
    cki("sign_empty", ps_sign([]), 1)

    // single fixed point -> 1 cycle, n=1, exp=0 -> even -> +1
    cki("sign_single", ps_sign([0]), 1)

    // [1,0]: transposition -> 1 cycle of len 2, n=2, exp=1 -> odd -> -1
    cki("sign_transpos", ps_sign([1, 0]), -1)

    // [1,2,3,0]: single 4-cycle -> n=4, c=1, exp=3 -> odd -> -1
    cki("sign_4cycle", ps_sign([1, 2, 3, 0]), -1)

    // [2,0,1,5,3,4]: two 3-cycles -> n=6, c=2, exp=4 -> even -> +1
    cki("sign_two3cycles", ps_sign([2, 0, 1, 5, 3, 4]), 1)

    // [3,2,1,0]: (0,3)(1,2) -> 2 cycles, n=4, exp=2 -> even -> +1
    cki("sign_two_transpos", ps_sign([3, 2, 1, 0]), 1)

    // --- ps_parity ---
    // [2,1,0]: odd -> parity=1
    cki("parity_210", ps_parity([2, 1, 0]), 1)

    // [1,2,0]: even -> parity=0
    cki("parity_120", ps_parity([1, 2, 0]), 0)

    // identity -> even -> parity=0
    cki("parity_id", ps_parity([0, 1, 2]), 0)

    // [1,0]: odd -> parity=1
    cki("parity_transpos", ps_parity([1, 0]), 1)

    // --- ps_is_even ---
    // [1,2,0]: even -> true
    ckb("is_even_120", ps_is_even([1, 2, 0]), true)

    // [1,0,2]: odd -> false
    ckb("is_even_102", ps_is_even([1, 0, 2]), false)

    // identity -> even -> true
    ckb("is_even_id", ps_is_even([0, 1, 2]), true)

    // [1,0]: odd -> false
    ckb("is_even_transpos", ps_is_even([1, 0]), false)

    // [3,2,1,0]: even (two transpositions) -> true
    ckb("is_even_two_transpos", ps_is_even([3, 2, 1, 0]), true)

    // single 4-cycle [1,2,3,0]: odd -> false
    ckb("is_even_4cycle", ps_is_even([1, 2, 3, 0]), false)

    print("PASS _perm_sign_test")
