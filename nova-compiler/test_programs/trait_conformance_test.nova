// Trait conformance test — Square missing name() should error

trait Shape
    fn area(self) -> float
    fn name(self) -> string

type Circle : Shape
    radius: float

fn Circle.area() -> float
    3.14159 * self.radius * self.radius

fn Circle.name() -> string
    "circle"

type Square : Shape
    side: float

fn Square.area() -> float
    self.side * self.side

fn main()
    let c = Circle(5.0)
    print(c.name())
    print(str(c.area()))
