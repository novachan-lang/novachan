// Concurrency test server: serves 2 connections. Paired with _forge_https_concurrent_one.sh, which opens a
// STALLED connection (connects, sends nothing) then a FAST curl -- the fast client must be served despite
// the stall, which is only possible if each connection is handled in its own spawned task.
import forge
import forge_https

fn app_hello(req)
    text(200, "CONCURRENT-OK")

fn main()
    let a = app()
    get(a, "/hello", app_hello)
    forge_serve_tls_app_n(a, 44336, 2)
    print("CONC-DONE")
