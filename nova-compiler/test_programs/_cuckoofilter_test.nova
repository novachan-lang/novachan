import std/sketch/cuckoofilter

fn check_true(label: string, got: bool)
    if got == false
        print("FAIL " + label + ": got=false want=true")
        exit(1)

fn check_false(label: string, got: bool)
    if got == true
        print("FAIL " + label + ": got=true want=false")
        exit(1)

fn eq(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // --- KAT 1: basic structure ---
    let cf = cf_new(16, 4)
    eq("count_init", cf_count(cf), 0)

    // --- KAT 2: NO FALSE NEGATIVES — add x, y, z; all must be found ---
    let ok_x = cf_add(cf, "x")
    let ok_y = cf_add(cf, "y")
    let ok_z = cf_add(cf, "z")
    check_true("add_x", ok_x)
    check_true("add_y", ok_y)
    check_true("add_z", ok_z)
    check_true("contains_x", cf_contains(cf, "x"))
    check_true("contains_y", cf_contains(cf, "y"))
    check_true("contains_z", cf_contains(cf, "z"))
    eq("count_3", cf_count(cf), 3)

    // --- KAT 3: "nope" was never added — may be a false positive but we don't assert strongly.
    // We only assert the three added items remain found. (FP assertion skipped per spec.)

    // --- KAT 4: delete y; y must not be found; x and z must still be found ---
    let del_y = cf_delete(cf, "y")
    check_true("delete_y", del_y)
    check_false("y_gone", cf_contains(cf, "y"))
    check_true("x_after_del", cf_contains(cf, "x"))
    check_true("z_after_del", cf_contains(cf, "z"))
    eq("count_after_del", cf_count(cf), 2)

    // --- KAT 5: delete non-existent returns false ---
    let del_nope = cf_delete(cf, "never-added")
    check_false("del_nonexistent", del_nope)

    // --- KAT 6: larger filter — insert 20 items, all must be found ---
    let big = cf_new(64, 4)
    let i = 0
    while i < 20
        let inserted = cf_add(big, "item" + str(i))
        check_true("add_item" + str(i), inserted)
        i = i + 1
    let j = 0
    while j < 20
        check_true("find_item" + str(j), cf_contains(big, "item" + str(j)))
        j = j + 1
    eq("count_20", cf_count(big), 20)

    // --- KAT 7: delete half, remaining half still found ---
    let k = 0
    while k < 10
        cf_delete(big, "item" + str(k))
        k = k + 1
    let m = 0
    while m < 10
        check_false("deleted_item" + str(m), cf_contains(big, "item" + str(m)))
        m = m + 1
    let n = 10
    while n < 20
        check_true("kept_item" + str(n), cf_contains(big, "item" + str(n)))
        n = n + 1
    eq("count_10", cf_count(big), 10)

    // --- KAT 8: determinism — fingerprint is stable ---
    let fp1 = cf_fingerprint("hello")
    let fp2 = cf_fingerprint("hello")
    eq("fingerprint_det", fp1, fp2)

    print("PASS _cuckoofilter_test")

main()
