// T2.1 (Phase 0c): let-site typed-wrapper rewrites. body_as -> <T>__from_json_safe;
// query_as -> <T>__from_dict (the arg IS the dict); db_find -> <T>__from_dict(RESULT row).
// Self-validating: exits 1 on any mismatch so the regression suite guards it.
// (db.all<T> list-mapping is a separate follow-up — IR-injected lambda lacks ti typing.)
type WUser
    name: string
    age: int
type WFilter
    min: int
    active: bool

fn body_as(s: string) -> any
    let r: any = s
    r
fn query_as(d: dict) -> any
    let r: any = d
    r
fn db_find(pool: int, table: string, id: int) -> any
    let r = {}
    r["name"] = "bob"
    r["age"] = "40"
    let ra: any = r
    ra

fn main()
    let lb = chr(123)
    let rb = chr(125)
    let json = lb + "\"name\":\"ada\",\"age\":36" + rb
    let u: Result<WUser> = body_as(json)
    match u
        Ok(usr) =>
            if usr.name != "ada" or usr.age != 36
                print("FAIL body_as got " + usr.name + ":" + str(usr.age))
                exit(1)
        Err(e) =>
            print("FAIL body_as_err:" + e)
            exit(1)
    let q = {}
    q["min"] = "10"
    q["active"] = "true"
    let f: Result<WFilter> = query_as(q)
    match f
        Ok(flt) =>
            if flt.min != 10
                print("FAIL query_as min=" + str(flt.min))
                exit(1)
        Err(e) =>
            print("FAIL query_as_err:" + e)
            exit(1)
    let one: Result<WUser> = db_find(0, "users", 1)
    match one
        Ok(o) =>
            if o.name != "bob"
                print("FAIL db_find name=" + o.name)
                exit(1)
        Err(e) =>
            print("FAIL db_find_err:" + e)
            exit(1)
    print("PASS forge_typed_wrapper (body_as/query_as/db_find)")
