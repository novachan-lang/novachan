// T2.1+T2.4: let-site typed-wrapper rewrites. body_as -> <T>__from_json_safe; query_as/db_find
// -> <T>__from_dict; db_all -> <T>__from_dict_list (typed loop, REAL handles). Self-validating.
type WUser
    name: string
    age: int
type WFilter
    min: int
    active: bool

fn body_as(s: string) -> any
    let r: any = s
    r
fn query_as(d: dict) -> any
    let r: any = d
    r
fn db_find(pool: int, table: string, id: int) -> any
    let r = {}
    r["name"] = "bob"
    r["age"] = "40"
    let ra: any = r
    ra
fn db_all(pool: int, table: string) -> list
    let rows = []
    let r1 = {}
    r1["name"] = "ada"
    r1["age"] = "36"
    push(rows, r1)
    let r2 = {}
    r2["name"] = "cal"
    r2["age"] = "50"
    push(rows, r2)
    rows

fn main()
    let lb = chr(123)
    let rb = chr(125)
    let json = lb + "\"name\":\"ada\",\"age\":36" + rb
    let u: Result<WUser> = body_as(json)
    match u
        Ok(usr) =>
            if usr.name != "ada" or usr.age != 36
                print("FAIL body_as " + usr.name + ":" + str(usr.age))
                exit(1)
        Err(e) =>
            print("FAIL body_as_err:" + e)
            exit(1)
    let q = {}
    q["min"] = "10"
    q["active"] = "true"
    let f: Result<WFilter> = query_as(q)
    match f
        Ok(flt) =>
            if flt.min != 10
                print("FAIL query_as " + str(flt.min))
                exit(1)
        Err(e) =>
            print("FAIL query_as_err:" + e)
            exit(1)
    let one: Result<WUser> = db_find(0, "users", 1)
    match one
        Ok(o) =>
            if o.name != "bob"
                print("FAIL db_find " + o.name)
                exit(1)
        Err(e) =>
            print("FAIL db_find_err:" + e)
            exit(1)
    let xs: list<WUser> = db_all(0, "users")
    let cnt = 0
    for x in xs
        if x.name != "ada" and x.name != "cal"
            print("FAIL db_all name=" + x.name)
            exit(1)
        if x.name == "ada" and x.age != 36
            print("FAIL db_all ada age=" + str(x.age))
            exit(1)
        cnt = cnt + 1
    if cnt != 2
        print("FAIL db_all count=" + str(cnt))
        exit(1)
    print("PASS forge_typed_wrapper (body_as/query_as/db_find/db_all)")
