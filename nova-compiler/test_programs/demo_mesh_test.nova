// NOVA Mesh v0.1 demo. Demonstrates the parallel_sum primitive on a
// real workload: compute sum(i^2) for i in 1..100. Verified against the
// closed-form n*(n+1)*(2n+1)/6 = 338350 for n=100.
import mesh

fn square(x: int) -> int
    x * x

fn main()
    let xs = []
    let i = 1
    while i <= 100
        xs.push(i)
        i = i + 1
    let total = mesh.parallel_sum_int(xs, square)
    assert_eq(total, 338350)

    let bigs = []
    let j = 1
    while j <= 10
        bigs.push(j)
        j = j + 1
    let sum_cubes = mesh.parallel_sum_int(bigs, fn(x) x * x * x)
    // 1+8+27+64+125+216+343+512+729+1000 = 3025
    assert_eq(sum_cubes, 3025)

    print("MESH v0.1 demo passed: parallel_sum over 100 items (sum of squares) and 10 items (sum of cubes) both match closed-form oracle")
