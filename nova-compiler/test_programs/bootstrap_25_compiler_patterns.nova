// Bootstrap test 25: patterns from the actual self-hosted compiler
// Tests the specific coding patterns used throughout nova_compiler.nova

// Pattern 1: keyword lookup with chained or
fn is_keyword(word: string) -> bool
    if word == "fn" or word == "return" or word == "if" or word == "else" or word == "while" or word == "for"
        return true
    return false

print(is_keyword("fn"))
print(is_keyword("hello"))

// Pattern 2: token stream processing with index + conditionals
fn tk(tokens: list, pos: int) -> string
    if pos >= len(tokens)
        return "EOF"
    return tokens[pos]

let toks = ["fn", "main", "(", ")", "return", "0"]
print(tk(toks, 0))
print(tk(toks, 100))

// Pattern 3: building strings with concatenation in a loop
fn join_items(items: list, sep: string) -> string
    let result = ""
    let i = 0
    while i < len(items)
        if i > 0
            result = result + sep
        result = result + str(items[i])
        i = i + 1
    return result

print(join_items([1, 2, 3], ", "))

// Pattern 4: recursive descent with counter
fn count_nested(items: list) -> int
    let total = 0
    for item in items
        total = total + 1
    return total

print(count_nested([10, 20, 30, 40]))

// Pattern 5: dict-based dispatch (used in codegen)
let handlers = {}
handlers["add"] = "nova_rt_add"
handlers["sub"] = "nova_rt_sub"
handlers["mul"] = "nova_rt_mul"

fn resolve(op: string) -> string
    if contains(handlers, op)
        return handlers[op]
    return op

print(resolve("add"))
print(resolve("unknown"))

// Pattern 6: nested if with early return (used everywhere)
fn process(tag: string, value: string) -> string
    if tag == "int"
        return "integer: " + value
    else if tag == "str"
        return "string: " + value
    else if tag == "bool"
        if value == "true"
            return "boolean: yes"
        else
            return "boolean: no"
    return "other: " + tag

print(process("int", "42"))
print(process("str", "hello"))
print(process("bool", "true"))
print(process("unknown", ""))

// Pattern 7: list accumulation with push (used in parser)
fn collect_names(items: list) -> list
    let names = []
    for item in items
        if len(item) > 3
            push(names, item)
    return names

let result = collect_names(["fn", "main", "return", "if", "while"])
print(len(result))
print(result[0])
print(result[1])
