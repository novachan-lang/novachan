// KAT test for std/numeric/euler — Euler's method for ODEs dy/dt = f(t, y).
//
// ODE test cases:
//   fconst: dy/dt = 2  =>  exact solution y(t) = y0 + 2t  (Euler is EXACT for linear)
//   fexp:   dy/dt = y  =>  exact solution y(t) = y0 * e^t  (Euler approximates e)
//
// KAT assertions:
//   1. eu_final(fconst, 0.0, 0.0, 0.1, 10) == 2.0   [y=2t, y(1)=2.0, exact]
//   2. eu_final(fconst, 0.0, 5.0, 0.5,  4) == 9.0   [y=5+2t, y(2)=9.0, exact]
//   3. eu_final(fexp,   0.0, 1.0, 0.01,100) ~= 2.70  [e ~2.7048 with h=0.01, eps=0.05]
//   4. len(eu_solve(fconst, 0.0, 0.0, 0.1, 10)) == 11  [steps+1 pairs]
//   5. eu_solve first pair t-value == t0
//   6. eu_solve last  pair y-value matches eu_final
//   7. eu_final(fconst, 0.0, 0.0, 0.01, 1000) == 20.0 [y(10)=20, stress-steps]
import std/numeric/euler

// Named top-level ODEs — no closures.

// dy/dt = 2  (constant slope)
fn fconst(t, y) -> float
    return 2.0

// dy/dt = y  (exponential growth)
fn fexp(t, y) -> float
    return y

// Float-close check
fn ckf(label: string, got: float, want: float, eps: float)
    let d = got - want
    if d < 0.0
        d = 0.0 - d
    if d > eps
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("ok " + label)

fn main()
    // KAT 1: dy/dt=2, y(0)=0, h=0.1, 10 steps => y(1)=2.0 (exact for linear)
    let r1 = eu_final(fconst, 0.0, 0.0, 0.1, 10)
    ckf("fconst y(1)=2.0", r1, 2.0, 0.0001)

    // KAT 2: dy/dt=2, y(0)=5, h=0.5, 4 steps => y(2)=9.0 (5+2*2, exact)
    let r2 = eu_final(fconst, 0.0, 5.0, 0.5, 4)
    ckf("fconst y(2)=9.0", r2, 9.0, 0.0001)

    // KAT 3: dy/dt=y, y(0)=1, h=0.01, 100 steps => approx e^1 ~2.7048 (eps=0.05)
    let r3 = eu_final(fexp, 0.0, 1.0, 0.01, 100)
    ckf("fexp y(1)~e", r3, 2.70, 0.05)

    // KAT 4: eu_solve returns steps+1 entries
    let traj = eu_solve(fconst, 0.0, 0.0, 0.1, 10)
    let n = len(traj)
    if n != 11
        print("FAIL traj length: got " + str(n) + " want 11")
        exit(1)
    print("ok traj length==11")

    // KAT 5: first pair t-value == t0 (should be 0.0)
    let first_pair = traj[0]
    let t0_got = first_pair[0]
    ckf("traj[0].t==0.0", t0_got, 0.0, 0.0001)

    // KAT 6: last pair y-value matches eu_final result
    let last_pair = traj[10]
    let y_last = last_pair[1]
    ckf("traj[10].y==eu_final", y_last, r1, 0.0001)

    // KAT 7: stress — 1000 steps, y(10)=20.0 (exact for linear)
    let r7 = eu_final(fconst, 0.0, 0.0, 0.01, 1000)
    ckf("fconst y(10)=20.0", r7, 20.0, 0.0001)

    print("_euler_test passed")
