import std/proof/proof_natded

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _proof_natded_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL _proof_natded_test " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL _proof_natded_test " + label + ": got=" + got + " want=" + want)
        exit(1)

// --- Inline truth-table oracle ---

fn _local_vars_collect(f, acc)
    let tag = f[0]
    if tag == "var"
        let nm = f[1]
        let found = false
        let i = 0
        while i < len(acc)
            if acc[i] == nm
                found = true
            i = i + 1
        if not found
            push(acc, nm)
        return null
    if tag == "not"
        _local_vars_collect(f[1], acc)
        return null
    if tag == "and"
        _local_vars_collect(f[1], acc)
        _local_vars_collect(f[2], acc)
        return null
    if tag == "or"
        _local_vars_collect(f[1], acc)
        _local_vars_collect(f[2], acc)
        return null
    if tag == "imp"
        _local_vars_collect(f[1], acc)
        _local_vars_collect(f[2], acc)
        return null
    null

fn _local_eval(f, env) -> int
    let tag = f[0]
    if tag == "top"
        return 1
    if tag == "bot"
        return 0
    if tag == "var"
        let nm = f[1]
        let i = 0
        while i < len(env)
            if env[i][0] == nm
                return env[i][1]
            i = i + 1
        return 0
    if tag == "not"
        let v = _local_eval(f[1], env)
        if v == 1
            return 0
        return 1
    if tag == "and"
        let va = _local_eval(f[1], env)
        let vb = _local_eval(f[2], env)
        if va == 1 and vb == 1
            return 1
        return 0
    if tag == "or"
        let va = _local_eval(f[1], env)
        let vb = _local_eval(f[2], env)
        if va == 1
            return 1
        if vb == 1
            return 1
        return 0
    if tag == "imp"
        let va = _local_eval(f[1], env)
        let vb = _local_eval(f[2], env)
        if va == 0
            return 1
        return vb
    0

fn _local_is_taut(f) -> bool
    let vars = []
    _local_vars_collect(f, vars)
    let nv = len(vars)
    let total = 1 << nv
    let i = 0
    while i < total
        let env = []
        let k = 0
        while k < nv
            let pair = [vars[k], (i >> k) & 1]
            push(env, pair)
            k = k + 1
        let v = _local_eval(f, env)
        if v == 0
            return false
        i = i + 1
    true

fn _local_feq(a, b) -> bool
    if len(a) != len(b)
        return false
    if a[0] != b[0]
        return false
    let tag = a[0]
    if tag == "bot"
        return true
    if tag == "top"
        return true
    if tag == "var"
        return a[1] == b[1]
    if tag == "not"
        return _local_feq(a[1], b[1])
    if tag == "and"
        if not _local_feq(a[1], b[1])
            return false
        return _local_feq(a[2], b[2])
    if tag == "or"
        if not _local_feq(a[1], b[1])
            return false
        return _local_feq(a[2], b[2])
    if tag == "imp"
        if not _local_feq(a[1], b[1])
            return false
        return _local_feq(a[2], b[2])
    false

fn main()
    // --- Formulas ---
    let fA = ["var", "A"]
    let fB = ["var", "B"]
    let fC = ["var", "C"]
    let fAB = ["and", fA, fB]
    let fAiB = ["imp", fA, fB]

    // --- KAT 1: proof of A->A = imp_i(A, assume A) ---
    let pAA = ["imp_i", fA, ["assume", fA]]
    let concAA = pnd_conclusion(pAA)
    ckb("imp_i check", pnd_check(pAA), true)
    ckb("imp_i closed", pnd_is_closed(pAA), true)
    cki("imp_i open len=0", len(pnd_open(pAA)), 0)
    ckb("imp_i conclusion not FAIL", concAA != "FAIL", true)
    // concAA should be ["imp", fA, fA]
    ckb("imp_i concl tag=imp", concAA[0] == "imp", true)
    ckb("imp_i concl[1]=A", _local_feq(concAA[1], fA), true)
    ckb("imp_i concl[2]=A", _local_feq(concAA[2], fA), true)

    // --- CROSS-CHECK: closed proof of A->A; conclusion must be a tautology ---
    ckb("cross: A->A taut", _local_is_taut(concAA), true)

    // --- KAT 2: and_e1(and_i(assume A, assume B)) conclusion=A, open=[A,B] ---
    let pAndI = ["and_i", ["assume", fA], ["assume", fB]]
    let pAndE1 = ["and_e1", pAndI]
    ckb("and_e1 check", pnd_check(pAndE1), true)
    let concE1 = pnd_conclusion(pAndE1)
    ckb("and_e1 concl=A", _local_feq(concE1, fA), true)
    let openE1 = pnd_open(pAndE1)
    cki("and_e1 open len=2", len(openE1), 2)
    ckb("and_e1 open[0]=A", _local_feq(openE1[0], fA), true)
    ckb("and_e1 open[1]=B", _local_feq(openE1[1], fB), true)

    // --- KAT 3: and_e2 ---
    let pAndE2 = ["and_e2", pAndI]
    ckb("and_e2 check", pnd_check(pAndE2), true)
    ckb("and_e2 concl=B", _local_feq(pnd_conclusion(pAndE2), fB), true)

    // --- KAT 4: imp_e(assume imp(A,B), assume A) concludes B ---
    let pImpE = ["imp_e", ["assume", fAiB], ["assume", fA]]
    ckb("imp_e check", pnd_check(pImpE), true)
    ckb("imp_e concl=B", _local_feq(pnd_conclusion(pImpE), fB), true)
    let openImpE = pnd_open(pImpE)
    cki("imp_e open len=2", len(openImpE), 2)
    ckb("imp_e open[0]=A->B", _local_feq(openImpE[0], fAiB), true)
    ckb("imp_e open[1]=A", _local_feq(openImpE[1], fA), true)

    // --- KAT 5: or_i1(B, assume A) => A|B ---
    let pOrI1 = ["or_i1", fB, ["assume", fA]]
    ckb("or_i1 check", pnd_check(pOrI1), true)
    let concOrI1 = pnd_conclusion(pOrI1)
    let expectedOrAB = ["or", fA, fB]
    ckb("or_i1 concl=A|B", _local_feq(concOrI1, expectedOrAB), true)

    // --- KAT 6: or_i2(A, assume B) => A|B ---
    let pOrI2 = ["or_i2", fA, ["assume", fB]]
    ckb("or_i2 check", pnd_check(pOrI2), true)
    ckb("or_i2 concl=A|B", _local_feq(pnd_conclusion(pOrI2), expectedOrAB), true)

    // --- KAT 7: not_i — assume A, derive bot via not_e, get not(A) ---
    let fNotA = ["not", fA]
    let pNotE = ["not_e", ["assume", fNotA], ["assume", fA]]
    let pNotI = ["not_i", fA, pNotE]
    ckb("not_i check", pnd_check(pNotI), true)
    ckb("not_i concl=not(A)", _local_feq(pnd_conclusion(pNotI), fNotA), true)
    let openNotI = pnd_open(pNotI)
    // not_i discharges A from pNotE; pNotE has open [not(A), A]; after discharge: [not(A)]
    cki("not_i open len=1", len(openNotI), 1)
    ckb("not_i open[0]=not(A)", _local_feq(openNotI[0], fNotA), true)

    // --- KAT 8: bot_e from bot derive C ---
    let pBotE = ["bot_e", fC, ["assume", ["bot"]]]
    ckb("bot_e check", pnd_check(pBotE), true)
    ckb("bot_e concl=C", _local_feq(pnd_conclusion(pBotE), fC), true)

    // --- KAT 9: invalid — and_e1 of non-and assumption => FAIL ---
    let pBadE1 = ["and_e1", ["assume", fA]]
    ckb("bad and_e1 rejected", pnd_check(pBadE1), false)
    let concBad = pnd_conclusion(pBadE1)
    cks("bad and_e1 FAIL str", concBad, "FAIL")

    // --- KAT 10: invalid imp_e type mismatch => FAIL ---
    // imp_e(assume(A->B), assume B) — right premise should be A, not B
    let pBadImpE = ["imp_e", ["assume", fAiB], ["assume", fB]]
    ckb("bad imp_e rejected", pnd_check(pBadImpE), false)

    // --- KAT 11: (A/\B)->A closed proof with tautology cross-check ---
    let pHypAB = ["assume", fAB]
    let pE1AB = ["and_e1", pHypAB]
    let pImpABtoA = ["imp_i", fAB, pE1AB]
    ckb("(A/\\B)->A check", pnd_check(pImpABtoA), true)
    ckb("(A/\\B)->A closed", pnd_is_closed(pImpABtoA), true)
    let concABtoA = pnd_conclusion(pImpABtoA)
    ckb("(A/\\B)->A is taut", _local_is_taut(concABtoA), true)

    // --- KAT 12: or_e proof of A\/A -> A ---
    let fOrAA = ["or", fA, fA]
    let pOrE = ["or_e", ["assume", fOrAA], fA, ["assume", fA], fA, ["assume", fA]]
    let pImpOrAA = ["imp_i", fOrAA, pOrE]
    ckb("A\\/A->A check", pnd_check(pImpOrAA), true)
    ckb("A\\/A->A closed", pnd_is_closed(pImpOrAA), true)
    ckb("A\\/A->A is taut", _local_is_taut(pnd_conclusion(pImpOrAA)), true)

    // --- KAT 13: not_e invalid (types mismatched) ---
    // not_e(assume not(A), assume B) — the negated formula is A, minor premise should be A not B
    let pBadNotE = ["not_e", ["assume", fNotA], ["assume", fB]]
    ckb("bad not_e rejected", pnd_check(pBadNotE), false)

    // --- CROSS-CHECKS: soundness — closed proofs produce tautologies ---
    // A->A
    ckb("xcheck A->A taut", _local_is_taut(pnd_conclusion(["imp_i", fA, ["assume", fA]])), true)
    // (A/\B)->A
    ckb("xcheck (A/\\B)->A taut", _local_is_taut(pnd_conclusion(pImpABtoA)), true)
    // A\/A -> A
    ckb("xcheck A\\/A->A taut", _local_is_taut(pnd_conclusion(pImpOrAA)), true)

    print("PASS _proof_natded_test")
