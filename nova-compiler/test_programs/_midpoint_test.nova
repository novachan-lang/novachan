// _midpoint_test.nova — KAT for std/geo/midpoint
import std/geo/midpoint

fn approx(a: float, b: float, tol: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < tol

fn main()
    // midpoint(0,0, 0,2) -> equator midpoint at lon=1
    let mp1 = midpoint(0.0, 0.0, 0.0, 2.0)
    let mp1_lat = mp1[0] * 1.0
    let mp1_lon = mp1[1] * 1.0
    if not approx(mp1_lat, 0.0, 0.02)
        print("FAIL midpoint equator lon-mid lat: got " + str(mp1_lat))
        exit(1)
    if not approx(mp1_lon, 1.0, 0.02)
        print("FAIL midpoint equator lon-mid lon: got " + str(mp1_lon))
        exit(1)

    // midpoint(0,0, 2,0) -> north midpoint at lat=1
    let mp2 = midpoint(0.0, 0.0, 2.0, 0.0)
    let mp2_lat = mp2[0] * 1.0
    let mp2_lon = mp2[1] * 1.0
    if not approx(mp2_lat, 1.0, 0.02)
        print("FAIL midpoint meridian lat: got " + str(mp2_lat))
        exit(1)
    if not approx(mp2_lon, 0.0, 0.02)
        print("FAIL midpoint meridian lon: got " + str(mp2_lon))
        exit(1)

    // midpoint(0,0, 0,0) -> same point
    let mp3 = midpoint(0.0, 0.0, 0.0, 0.0)
    let mp3_lat = mp3[0] * 1.0
    let mp3_lon = mp3[1] * 1.0
    if not approx(mp3_lat, 0.0, 0.02)
        print("FAIL midpoint same point lat: got " + str(mp3_lat))
        exit(1)
    if not approx(mp3_lon, 0.0, 0.02)
        print("FAIL midpoint same point lon: got " + str(mp3_lon))
        exit(1)

    // midpoint(10,20, 10,40) -> (10,30) roughly (great circle deviates slightly at lat)
    let mp4 = midpoint(10.0, 20.0, 10.0, 40.0)
    let mp4_lat = mp4[0] * 1.0
    let mp4_lon = mp4[1] * 1.0
    // lat should be slightly above 10 (great circle bulges north), lon at 30
    if not approx(mp4_lon, 30.0, 0.5)
        print("FAIL midpoint (10,20)-(10,40) lon: got " + str(mp4_lon))
        exit(1)
    // lat >= 10 always holds; check in range [10, 11]
    if mp4_lat < 10.0
        print("FAIL midpoint (10,20)-(10,40) lat too low: got " + str(mp4_lat))
        exit(1)

    print("PASS _midpoint_test")
