// Guard for the cross-struct field-slot fix: `typedList[i].field` must resolve `field` PER-STRUCT (via the
// list's element type), not via a global slot for that field name. A and B both have a `title` field at
// DIFFERENT indices; before the fix the typed-let element type was clobbered to "" and the read fell back
// to the ambiguous global slot -> wrong/garbage for whichever struct's slot didn't match.
type A
    x: int
    title: string

type B
    title: string
    y: int

fn orm_all(db, sql: string, params) -> list
    [{"title": "BB", "y": "5"}]

fn orm_where(db, table: string, cond: string, params) -> list
    [{"x": "9", "title": "AA"}]

fn main()
    let bs: list<B> = orm_all(0, "", [])
    let as2: list<A> = orm_where(0, "", "", [])
    assert_eq(bs[0].title, "BB")
    assert_eq(bs[0].y, 5)
    assert_eq(as2[0].title, "AA")
    assert_eq(as2[0].x, 9)
    print("typedlist_field_slot_test passed")
