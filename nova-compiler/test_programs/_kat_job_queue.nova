import forge_job_queue

fn main()
    let j = jq_new(3)
    j = jq_enqueue(j, "send-email", "user@test.com")
    j = jq_enqueue(j, "gen-report", "monthly")
    assert(jq_pending_count(j) == 2, "2 pending")

    let r1 = jq_dequeue(j)
    j = r1["j"]
    assert(r1["found"] == 1, "found job")
    assert(r1["name"] == "send-email", "email job")
    let idx1 = r1["idx"]

    j = jq_complete(j, idx1)
    assert(jq_total_completed(j) == 1, "1 completed")

    let r2 = jq_dequeue(j)
    j = r2["j"]
    let idx2 = r2["idx"]

    j = jq_fail(j, idx2)
    assert(jq_pending_count(j) == 1, "retry = pending again")

    j = jq_fail(j, idx2)
    j = jq_fail(j, idx2)
    assert(jq_total_failed(j) == 1, "permanent fail after 3")
    assert(jq_pending_count(j) == 0, "0 pending")

    assert(jq_success_rate(j) == 50, "50% success")

    let r3 = jq_dequeue(j)
    j = r3["j"]
    assert(r3["found"] == 0, "empty queue")

    print("JOB-QUEUE KAT PASS")
