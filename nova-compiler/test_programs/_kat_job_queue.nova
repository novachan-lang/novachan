import forge_job_queue

fn main()
    let q = jq_new()
    q = jq_enqueue(q, "j1", "send_email", 1)
    q = jq_enqueue(q, "j2", "process_payment", 10)
    q = jq_enqueue(q, "j3", "generate_report", 5)
    assert(jq_total_count(q) == 3, "3 jobs")

    let d = jq_dequeue(q)
    assert(is_ok(d), "dequeue ok")
    assert(unwrap(d) == "j2", "highest priority first")

    let c = jq_complete(q, "j2")
    assert(is_ok(c), "complete ok")
    q = unwrap(c)
    assert(jq_processed_count(q) == 1, "1 processed")

    let d2 = jq_dequeue(q)
    assert(is_ok(d2), "dequeue ok 2")
    assert(unwrap(d2) == "j3", "j3 next")

    let f = jq_fail_job(q, "j3")
    assert(is_ok(f), "fail ok")
    q = unwrap(f)

    assert(jq_success_rate(q) == 50, "50% success")
    assert(jq_queued_count(q) == 1, "1 still queued")

    let bad = jq_complete(q, "nope")
    assert(is_err(bad), "unknown job")

    print("JOB-QUEUE KAT PASS")
