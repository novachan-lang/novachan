import std/compress/lzw

// ── Helpers ───────────────────────────────────────────────────────────────────

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ── KAT-1: round-trip empty string ───────────────────────────────────────────
let rt_empty_codes = lzw_compress("")
let rt_empty = lzw_decompress(rt_empty_codes)
cks("rt_empty", rt_empty, "")

// ── KAT-2: round-trip single character ───────────────────────────────────────
let rt_a_codes = lzw_compress("a")
let rt_a = lzw_decompress(rt_a_codes)
cks("rt_single_a", rt_a, "a")

// ── KAT-3: round-trip classic LZW example (TOBEORNOTTOBEORTOBEORNOT) ─────────
let tobeor = "TOBEORNOTTOBEORTOBEORNOT"
let tobeor_codes = lzw_compress(tobeor)
let tobeor_rt = lzw_decompress(tobeor_codes)
cks("rt_tobeor", tobeor_rt, tobeor)

// ── KAT-4: round-trip all-same character (aaaa) ───────────────────────────────
let aaaa = "aaaaaa"
let aaaa_codes = lzw_compress(aaaa)
let aaaa_rt = lzw_decompress(aaaa_codes)
cks("rt_aaaa", aaaa_rt, aaaa)

// ── KAT-5: round-trip alternating (ababababab) ─────────────────────────────────
let abab = "ababababab"
let abab_codes = lzw_compress(abab)
let abab_rt = lzw_decompress(abab_codes)
cks("rt_abab", abab_rt, abab)

// ── KAT-6: round-trip sentence ────────────────────────────────────────────────
let fox = "the quick brown fox"
let fox_codes = lzw_compress(fox)
let fox_rt = lzw_decompress(fox_codes)
cks("rt_fox", fox_rt, fox)

// ── KAT-7: compression ratio — "aaaa" compresses to fewer than 4 codes ────────
// "aaaa" has 4 characters. LZW should compress repeated runs to fewer codes.
let aaaa4 = "aaaa"
let aaaa4_codes = lzw_compress(aaaa4)
let aaaa4_len = len(aaaa4_codes)
if aaaa4_len >= 4
    print("FAIL compress_ratio: got " + str(aaaa4_len) + " codes for aaaa, want <4")
    exit(1)

// ── KAT-8: first code equals ord of first character ───────────────────────────
// For any non-empty input, codes[0] must equal ord(s[0]).
let first_a = lzw_compress("a")
cki("first_code_a", first_a[0], ord("a"))

let first_T = lzw_compress("TOBEORNOTTOBEORTOBEORNOT")
cki("first_code_T", first_T[0], ord("T"))

let first_fox = lzw_compress("the quick brown fox")
cki("first_code_fox", first_fox[0], ord("t"))

// ── KAT-9: lzw_compress_ascii is identical to lzw_compress ──────────────────
let ascii_codes = lzw_compress_ascii("hello world")
let plain_codes = lzw_compress("hello world")
cki("ascii_same_len", len(ascii_codes), len(plain_codes))
// Spot-check first and last codes
cki("ascii_first", ascii_codes[0], plain_codes[0])
cki("ascii_last",  ascii_codes[len(ascii_codes)-1], plain_codes[len(plain_codes)-1])

// ── KAT-10: decompress of lzw_compress_ascii round-trips ─────────────────────
let hw = "hello world"
let hw_codes = lzw_compress_ascii(hw)
let hw_rt = lzw_decompress(hw_codes)
cks("rt_helloworld", hw_rt, hw)

// ── KAT-11: KwKwK edge case — repeated block triggers KwKwK in decompressor ──
// "aaaa..." long enough to guarantee a KwKwK code is emitted (code = next_code
// at time of decompression). lzw_compress("aaaaaaaaaa") emits codes where at
// some point the decompressor will see a code it hasn't stored yet.
let kwkwk_in = "aaaaaaaaaa"
let kwkwk_codes = lzw_compress(kwkwk_in)
let kwkwk_out = lzw_decompress(kwkwk_codes)
cks("kwkwk_roundtrip", kwkwk_out, kwkwk_in)

print("_lzw_test passed")
