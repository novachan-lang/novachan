// KAT for std/compress/lzw — LZW dictionary compression (byte-list API)
import std/compress/lzw

// Helper: convert string to byte-list
fn str_to_bytes(s) -> list
    let n = len(s)
    let out = []
    let i = 0
    while i < n
        push(out, ord(s[i]))
        i = i + 1
    out

// Helper: convert byte-list to string
fn bytes_to_str(bytes) -> string
    let n = len(bytes)
    let out = ""
    let i = 0
    while i < n
        out = out + chr(bytes[i])
        i = i + 1
    out

// Helper: check byte-list equality
fn bytes_eq(a, b) -> int
    let na = len(a)
    let nb = len(b)
    if na != nb
        return 0
    let i = 0
    while i < na
        if a[i] != b[i]
            return 0
        i = i + 1
    1

// Round-trip check for a string input
fn ckrt_str(label, s)
    let input = str_to_bytes(s)
    let compressed = lzw_compress(input)
    let recovered  = lzw_decompress(compressed)
    if bytes_eq(input, recovered) == 0
        print("FAIL lzw " + label + ": round-trip mismatch")
        print("  input len=" + str(len(input)) + " recovered len=" + str(len(recovered)))
        exit(1)

// Round-trip check for a raw byte-list
fn ckrt_bytes(label, input)
    let compressed = lzw_compress(input)
    let recovered  = lzw_decompress(compressed)
    if bytes_eq(input, recovered) == 0
        print("FAIL lzw " + label + ": round-trip mismatch")
        exit(1)

fn main()
    // KAT 1: empty input
    let empty = []
    let ec = lzw_compress(empty)
    let ed = lzw_decompress(ec)
    if len(ed) != 0
        print("FAIL lzw empty: expected 0 bytes, got " + str(len(ed)))
        exit(1)

    // KAT 2: single byte
    ckrt_str("single_a", "a")

    // KAT 3: classic TOBEORNOT example
    ckrt_str("tobeornot", "TOBEORNOTTOBEORTOBEORNOT")

    // KAT 4: repetitive "aaaaaa"
    ckrt_str("aaaa", "aaaaaa")

    // KAT 5: alternating pattern
    ckrt_str("ababab", "ababababab")

    // KAT 6: longer sentence
    ckrt_str("fox", "the quick brown fox jumps over the lazy dog")

    // KAT 7: compression ratio — repeated input compresses to fewer codes
    let rep_in = str_to_bytes("aaaaaaaaaa")
    let rep_c  = lzw_compress(rep_in)
    if len(rep_c) >= len(rep_in)
        print("FAIL lzw compress_ratio: " + str(len(rep_c)) + " codes >= " + str(len(rep_in)) + " bytes")
        exit(1)

    // KAT 8: first code equals first byte value
    let first_in = str_to_bytes("TOBEORNOTTOBEORTOBEORNOT")
    let first_c  = lzw_compress(first_in)
    if first_c[0] != ord("T")
        print("FAIL lzw first_code: got " + str(first_c[0]) + " want " + str(ord("T")))
        exit(1)

    // KAT 9: KwKwK edge case
    // "aaaaaaaaaa" (10 a's): decompressor will encounter code == next_code
    let kw_in = str_to_bytes("aaaaaaaaaa")
    let kw_c  = lzw_compress(kw_in)
    let kw_d  = lzw_decompress(kw_c)
    if bytes_eq(kw_in, kw_d) == 0
        print("FAIL lzw kwkwk: round-trip failed")
        exit(1)

    // KAT 10: bytes with NUL (0x00)
    let nul_in = []
    push(nul_in, 65)
    push(nul_in, 0)
    push(nul_in, 66)
    push(nul_in, 0)
    push(nul_in, 67)
    ckrt_bytes("with_nul", nul_in)

    // KAT 11: all 256 byte values — stress test the initial dict
    let all_in = []
    let ai = 0
    while ai < 256
        push(all_in, ai)
        ai = ai + 1
    ckrt_bytes("all_256", all_in)

    // KAT 12: mixed bytes
    let mixed = []
    let mi = 0
    while mi < 60
        push(mixed, mi * 7 - (mi * 7 / 256) * 256)
        mi = mi + 1
    ckrt_bytes("mixed", mixed)

    print("PASS _lzw_test")
