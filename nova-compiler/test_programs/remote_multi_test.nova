// Multi-client distributed server: main binds once, accepts 2 clients (green-aware),
// echoes v*2 to each. Proves remote_bind/remote_accept (one node, many peers).
fn client(port, val)
    let ch = remote_connect("127.0.0.1", port)
    remote_send(ch, val)
    let reply = remote_recv(ch)
    assert_eq(reply, val * 2)
    remote_close(ch)

fn main()
    let port = 19922
    let l = remote_bind(port)
    spawn client(port, 10)
    spawn client(port, 20)
    let total = 0
    let i = 0
    while i < 2
        let c = remote_accept(l)
        let v = remote_recv(c)
        remote_send(c, v * 2)
        remote_close(c)
        total = total + v
        i = i + 1
    remote_close(l)
    assert_eq(total, 30)
    print("remote_multi_test passed: 1 node served 2 clients, total=" + str(total))
