fn self_sub(x: int) -> int
    x - x

fn self_xor(x: int) -> int
    x ^ x

fn self_and(x: int) -> int
    x & x

fn self_or(x: int) -> int
    x | x

assert(self_sub(42) == 0, "x - x == 0")
assert(self_sub(-7) == 0, "neg - neg == 0")
assert(self_sub(0) == 0, "0 - 0 == 0")
assert(self_xor(255) == 0, "x ^ x == 0")
assert(self_xor(-1) == 0, "-1 ^ -1 == 0")
assert(self_xor(0) == 0, "0 ^ 0 == 0")
assert(self_and(42) == 42, "x & x == x")
assert(self_and(-1) == -1, "-1 & -1 == -1")
assert(self_and(0) == 0, "0 & 0 == 0")
assert(self_or(42) == 42, "x | x == x")
assert(self_or(-1) == -1, "-1 | -1 == -1")
assert(self_or(0) == 0, "0 | 0 == 0")

fn compound_algebra(x: int) -> int
    let a = x - x
    let b = x ^ x
    let c = x & x
    let d = x | x
    a + b + c + d

assert(compound_algebra(99) == 198, "compound: 0+0+99+99")

print("all algebraic identity tests passed")
