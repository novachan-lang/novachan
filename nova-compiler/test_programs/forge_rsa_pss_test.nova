// Forge RSA-PSS: RSASSA-PSS SHA-256 verify, gated against a computed+double-verified RSA-2048 vector
// (cryptography lib PSS + an independent from-scratch EMSA-PSS-VERIFY). message "NOVA forge pss".
import forge_rsa
import forge_crypto

fn main()
    let n = hex_to_blist("")
    let sig = hex_to_blist("")
    let h = hex_to_blist("13679ef8de15f1b4da8df9cc69918dcca2ac75d4ef3bef75ed0c7ee66e9f5c96")

    if hex_of(sha256_bytes(str_to_blist("NOVA forge pss"))) != "13679ef8de15f1b4da8df9cc69918dcca2ac75d4ef3bef75ed0c7ee66e9f5c96"
        print("FAIL: sha256 of message")
        exit(1)

    if rsa_pss_sha256_verify(n, h, sig) != 1
        print("FAIL: RSA-PSS verify")
        exit(1)

    let bad = []
    let i = 0
    while i < 256
        push(bad, sig[i])
        i = i + 1
    bad[100] = bad[100] ^ 1
    if rsa_pss_sha256_verify(n, h, bad) != 0
        print("FAIL: tampered PSS signature not rejected")
        exit(1)

    print("PASS forge_rsa_pss (RSA-2048 RSASSA-PSS SHA-256 verify KAT + tamper)")
