import forge_pub_sub_broker

fn main()
    let b = psb_new()
    b = psb_subscribe(b, "orders", "handler-a")
    b = psb_subscribe(b, "orders", "handler-b")
    b = psb_subscribe(b, "payments", "handler-c")
    assert(psb_sub_count_for(b, "orders") == 2, "2 order subs")
    assert(psb_sub_count_for(b, "payments") == 1, "1 payment sub")

    b = psb_publish(b, "orders", "order-123")
    assert(psb_total_published(b) == 1, "1 published")
    assert(psb_total_delivered(b) == 2, "2 delivered (fan-out)")
    assert(psb_pending_count(b) == 2, "2 pending msgs")

    assert(psb_msg_payload(b, 0) == "order-123", "msg 0 payload")
    assert(psb_msg_subscriber(b, 0) == "handler-a", "msg 0 sub")
    assert(psb_msg_subscriber(b, 1) == "handler-b", "msg 1 sub")

    b = psb_publish(b, "payments", "pay-456")
    assert(psb_total_published(b) == 2, "2 published")
    assert(psb_total_delivered(b) == 3, "3 delivered")

    b = psb_publish(b, "unknown", "data")
    assert(psb_total_delivered(b) == 3, "no subs = 0 delivered")

    print("PUB-SUB-BROKER KAT PASS")
