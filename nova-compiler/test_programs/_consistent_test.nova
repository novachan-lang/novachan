// KAT test for std/hash/consistent — consistent hashing ring.
// All expected values were computed by running the module and hand-verified
// against the FNV-1a 32-bit algorithm.
import std/hash/consistent

// Helper: assert int equality
fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// Helper: assert string equality
fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got [" + got + "] expected [" + expected + "]")
        exit(1)

fn main()
    // -----------------------------------------------------------------------
    // KAT 1 — nodes list is sorted after adding a, b, c in order
    // -----------------------------------------------------------------------
    let ch = ch_new(50)
    ch_add(ch, "a")
    ch_add(ch, "b")
    ch_add(ch, "c")

    let ns = ch_nodes(ch)
    cki("nodes_len", len(ns), 3)
    cks("nodes[0]", ns[0], "a")
    cks("nodes[1]", ns[1], "b")
    cks("nodes[2]", ns[2], "c")

    // -----------------------------------------------------------------------
    // KAT 2 — nodes list is sorted even when added out of alphabetical order
    // -----------------------------------------------------------------------
    let ch2 = ch_new(50)
    ch_add(ch2, "c")
    ch_add(ch2, "a")
    ch_add(ch2, "b")

    let ns2 = ch_nodes(ch2)
    cki("nodes_len_reorder", len(ns2), 3)
    cks("nodes[0]_reorder", ns2[0], "a")
    cks("nodes[1]_reorder", ns2[1], "b")
    cks("nodes[2]_reorder", ns2[2], "c")

    // -----------------------------------------------------------------------
    // KAT 3 — concrete key->node mappings (FNV-1a deterministic, probe-verified)
    // -----------------------------------------------------------------------
    // user-42  -> b  (probe output: ch_get user-42=b)
    cks("user-42", ch_get(ch, "user-42"), "b")
    // hello    -> a  (probe output: ch_get hello=a)
    cks("hello", ch_get(ch, "hello"), "a")
    // world    -> c  (probe output: ch_get world=c)
    cks("world", ch_get(ch, "world"), "c")
    // user-99  -> b  (probe output: ch_get user-99=b)
    cks("user-99", ch_get(ch, "user-99"), "b")

    // -----------------------------------------------------------------------
    // KAT 4 — stability: same key always maps to same node (call twice)
    // -----------------------------------------------------------------------
    let r1 = ch_get(ch, "user-42")
    let r2 = ch_get(ch, "user-42")
    cks("stable_user-42", r1, r2)

    let r3 = ch_get(ch, "hello")
    let r4 = ch_get(ch, "hello")
    cks("stable_hello", r3, r4)

    // -----------------------------------------------------------------------
    // KAT 5 — after ch_remove("a"): no key ever returns "a"
    //          nodes list becomes ["b", "c"]
    // -----------------------------------------------------------------------
    ch_remove(ch, "a")

    let after_ns = ch_nodes(ch)
    cki("after_remove_len", len(after_ns), 2)
    cks("after_remove_nodes[0]", after_ns[0], "b")
    cks("after_remove_nodes[1]", after_ns[1], "c")

    // All previously tested keys must now return b or c
    let keys_to_check = ["user-42", "user-99", "hello", "world", "test-key-123"]
    let ki = 0
    while ki < len(keys_to_check)
        let k = keys_to_check[ki]
        let got = ch_get(ch, k)
        if got == "a"
            print("FAIL after_remove_no_a: key " + k + " still maps to a")
            exit(1)
        if got != "b"
            if got != "c"
                print("FAIL after_remove_valid: key " + k + " maps to unknown node [" + got + "]")
                exit(1)
        ki = ki + 1

    // Concrete stable values after removal (probe-verified)
    // user-42 -> b, world -> c
    cks("after_remove_user-42", ch_get(ch, "user-42"), "b")
    cks("after_remove_world", ch_get(ch, "world"), "c")

    // -----------------------------------------------------------------------
    // KAT 6 — empty ring returns ""
    // -----------------------------------------------------------------------
    ch_remove(ch, "b")
    ch_remove(ch, "c")
    cks("empty_ring", ch_get(ch, "anything"), "")
    cks("empty_ring_user", ch_get(ch, "user-42"), "")

    // -----------------------------------------------------------------------
    // KAT 7 — ring with 1 replica per node: all keys map to the single node
    // -----------------------------------------------------------------------
    let ch3 = ch_new(1)
    ch_add(ch3, "solo")
    let s1 = ch_get(ch3, "key1")
    let s2 = ch_get(ch3, "key2")
    let s3 = ch_get(ch3, "key3")
    cks("single_node_key1", s1, "solo")
    cks("single_node_key2", s2, "solo")
    cks("single_node_key3", s3, "solo")

    // After removing the only node: empty ring
    ch_remove(ch3, "solo")
    cks("single_node_removed", ch_get(ch3, "key1"), "")

    // -----------------------------------------------------------------------
    // KAT 8 — ch_nodes() on fresh ring is empty
    // -----------------------------------------------------------------------
    let ch4 = ch_new(100)
    cki("fresh_nodes_len", len(ch_nodes(ch4)), 0)

    print("_consistent_test passed")
