// _kat_strkit.nova — KAT probe for std/text/strkit
import std/text/strkit

// ── KAT 1: sk_words — whitespace-run split, no empty tokens ────────────────
let r1 = sk_words("  a  b c ")
if r1 != ["a", "b", "c"]
    print("FAIL KAT1: sk_words expected [a,b,c] got: " + str(r1))
    exit(1)
print("OK KAT1: sk_words")

// ── KAT 2: sk_title_case ─────────────────────────────────────────────────────
let r2 = sk_title_case("hello world")
if r2 != "Hello World"
    print("FAIL KAT2: sk_title_case expected 'Hello World' got: " + r2)
    exit(1)
print("OK KAT2: sk_title_case")

// ── KAT 3: sk_count — non-overlapping ───────────────────────────────────────
let r3 = sk_count("aaaa", "aa")
if r3 != 2
    print("FAIL KAT3: sk_count expected 2 got: " + str(r3))
    exit(1)
print("OK KAT3: sk_count")

// ── KAT 4: sk_replace_all — non-overlapping global replace ──────────────────
let r4a = sk_replace_all("a.b.c", ".", "-")
if r4a != "a-b-c"
    print("FAIL KAT4a: sk_replace_all expected 'a-b-c' got: " + r4a)
    exit(1)
let r4b = sk_replace_all("aaaa", "aa", "b")
if r4b != "bb"
    print("FAIL KAT4b: sk_replace_all expected 'bb' got: " + r4b)
    exit(1)
print("OK KAT4: sk_replace_all")

// ── KAT 5: sk_pad_left / sk_pad_right ────────────────────────────────────────
let r5a = sk_pad_left("7", 3, "0")
if r5a != "007"
    print("FAIL KAT5a: sk_pad_left expected '007' got: " + r5a)
    exit(1)
let r5b = sk_pad_right("7", 3, "0")
if r5b != "700"
    print("FAIL KAT5b: sk_pad_right expected '700' got: " + r5b)
    exit(1)
let r5c = sk_pad_left("hello", 3, "0")
if r5c != "hello"
    print("FAIL KAT5c: sk_pad_left no-op expected 'hello' got: " + r5c)
    exit(1)
print("OK KAT5: sk_pad_left/sk_pad_right")

// ── KAT 6: sk_truncate — documented rule: keep = n - len(ellipsis) ──────────
let r6a = sk_truncate("hello", 4, "..")
if r6a != "he.."
    print("FAIL KAT6a: sk_truncate expected 'he..' got: " + r6a)
    exit(1)
let r6b = sk_truncate("hi", 10, "..")
if r6b != "hi"
    print("FAIL KAT6b: sk_truncate no-op expected 'hi' got: " + r6b)
    exit(1)
print("OK KAT6: sk_truncate")

// ── KAT 7: sk_common_prefix ──────────────────────────────────────────────────
let r7a = sk_common_prefix(["flower", "flow", "flight"])
if r7a != "fl"
    print("FAIL KAT7a: sk_common_prefix expected 'fl' got: " + r7a)
    exit(1)
let r7b = sk_common_prefix(["dog", "cat"])
if r7b != ""
    print("FAIL KAT7b: sk_common_prefix expected '' got: " + r7b)
    exit(1)
let r7c = sk_common_prefix([])
if r7c != ""
    print("FAIL KAT7c: sk_common_prefix empty-list expected '' got: " + r7c)
    exit(1)
print("OK KAT7: sk_common_prefix")

// ── KAT 8: sk_lines ──────────────────────────────────────────────────────────
let r8 = sk_lines("a\nb\nc")
if r8 != ["a", "b", "c"]
    print("FAIL KAT8: sk_lines expected [a,b,c] got: " + str(r8))
    exit(1)
print("OK KAT8: sk_lines")

// ── KAT 9: sk_indent — non-empty lines get the prefix, blank lines don't ────
let r9 = sk_indent("a\n\nb", 2)
if r9 != "  a\n\n  b"
    print("FAIL KAT9: sk_indent got: " + r9)
    exit(1)
print("OK KAT9: sk_indent")

// ── KAT 10: sk_is_blank ──────────────────────────────────────────────────────
if not sk_is_blank("   ")
    print("FAIL KAT10a: sk_is_blank('   ') should be true")
    exit(1)
if sk_is_blank("x")
    print("FAIL KAT10b: sk_is_blank('x') should be false")
    exit(1)
if not sk_is_blank("")
    print("FAIL KAT10c: sk_is_blank('') should be true")
    exit(1)
print("OK KAT10: sk_is_blank")

print("STRKIT KAT PASS")
