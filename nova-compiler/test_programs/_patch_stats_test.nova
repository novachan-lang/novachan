// KAT for std/text/patch_stats
// Vectors:
//   1. script_stats([["=","a"],["+","x"],["+","y"],["-","b"]]) == {keep:1,insert:2,delete:1}
//   2. patch_stats of a unified diff with 2 added + 1 removed -> additions==2, deletions==1, hunks==1
//   3. diffstat_line contains "2 insertions(+)" and "1 deletion(-)"
//   4. empty diff -> all zero
import std/text/patch_stats

fn main()
    // ── KAT 1: script_stats basic vector ─────────────────────────────────────
    let op1 = []
    op1.push("=")
    op1.push("a")
    let op2 = []
    op2.push("+")
    op2.push("x")
    let op3 = []
    op3.push("+")
    op3.push("y")
    let op4 = []
    op4.push("-")
    op4.push("b")
    let sc = []
    sc.push(op1)
    sc.push(op2)
    sc.push(op3)
    sc.push(op4)
    let ss = script_stats(sc)
    if ss["keep"] != 1
        print("FAIL patch_stats script_stats keep: got " + str(ss["keep"]) + " want 1")
        exit(1)
    if ss["insert"] != 2
        print("FAIL patch_stats script_stats insert: got " + str(ss["insert"]) + " want 2")
        exit(1)
    if ss["delete"] != 1
        print("FAIL patch_stats script_stats delete: got " + str(ss["delete"]) + " want 1")
        exit(1)

    // ── KAT 2: patch_stats on a minimal unified diff ──────────────────────────
    // Unified diff: 1 hunk, 2 additions, 1 deletion.
    let nl = chr(10)
    let udiff = "--- a/foo.txt" + nl
    udiff = udiff + "+++ b/foo.txt" + nl
    udiff = udiff + "@@ -1,3 +1,4 @@" + nl
    udiff = udiff + " context line" + nl
    udiff = udiff + "-removed line" + nl
    udiff = udiff + "+added line one" + nl
    udiff = udiff + "+added line two" + nl
    udiff = udiff + " context end" + nl
    let ps = patch_stats(udiff)
    if ps["additions"] != 2
        print("FAIL patch_stats additions: got " + str(ps["additions"]) + " want 2")
        exit(1)
    if ps["deletions"] != 1
        print("FAIL patch_stats deletions: got " + str(ps["deletions"]) + " want 1")
        exit(1)
    if ps["hunks"] != 1
        print("FAIL patch_stats hunks: got " + str(ps["hunks"]) + " want 1")
        exit(1)

    // ── KAT 3: diffstat_line contains expected substrings ────────────────────
    let dl = diffstat_line(udiff)
    // Must contain "2 insertions(+)"
    let found_ins = 0
    let want_ins = "2 insertions(+)"
    let dl_len = len(dl)
    let wi_len = len(want_ins)
    let ki = 0
    while ki <= dl_len - wi_len
        if slice(dl, ki, ki + wi_len) == want_ins
            found_ins = 1
        ki = ki + 1
    if found_ins == 0
        print("FAIL patch_stats diffstat_line missing insertions substr: got=" + dl)
        exit(1)
    // Must contain "1 deletion(-)"
    let found_del = 0
    let want_del = "1 deletion(-)"
    let wd_len = len(want_del)
    let kd = 0
    while kd <= dl_len - wd_len
        if slice(dl, kd, kd + wd_len) == want_del
            found_del = 1
        kd = kd + 1
    if found_del == 0
        print("FAIL patch_stats diffstat_line missing deletion substr: got=" + dl)
        exit(1)

    // ── KAT 4: empty diff -> all zero ────────────────────────────────────────
    let ps_empty = patch_stats("")
    if ps_empty["additions"] != 0
        print("FAIL patch_stats empty additions: got " + str(ps_empty["additions"]) + " want 0")
        exit(1)
    if ps_empty["deletions"] != 0
        print("FAIL patch_stats empty deletions: got " + str(ps_empty["deletions"]) + " want 0")
        exit(1)
    if ps_empty["hunks"] != 0
        print("FAIL patch_stats empty hunks: got " + str(ps_empty["hunks"]) + " want 0")
        exit(1)

    // ── KAT 5: script_stats empty script ─────────────────────────────────────
    let sc_empty = []
    let ss_empty = script_stats(sc_empty)
    if ss_empty["keep"] != 0
        print("FAIL patch_stats script_stats empty keep: got " + str(ss_empty["keep"]) + " want 0")
        exit(1)
    if ss_empty["insert"] != 0
        print("FAIL patch_stats script_stats empty insert: got " + str(ss_empty["insert"]) + " want 0")
        exit(1)
    if ss_empty["delete"] != 0
        print("FAIL patch_stats script_stats empty delete: got " + str(ss_empty["delete"]) + " want 0")
        exit(1)

    // ── KAT 6: multi-hunk diff ────────────────────────────────────────────────
    let udiff2 = "--- a/bar.txt" + nl
    udiff2 = udiff2 + "+++ b/bar.txt" + nl
    udiff2 = udiff2 + "@@ -1,2 +1,3 @@" + nl
    udiff2 = udiff2 + "+new line" + nl
    udiff2 = udiff2 + " keep" + nl
    udiff2 = udiff2 + "@@ -10,2 +11,1 @@" + nl
    udiff2 = udiff2 + "-old line" + nl
    udiff2 = udiff2 + " keep2" + nl
    let ps2 = patch_stats(udiff2)
    if ps2["hunks"] != 2
        print("FAIL patch_stats multi-hunk count: got " + str(ps2["hunks"]) + " want 2")
        exit(1)
    if ps2["additions"] != 1
        print("FAIL patch_stats multi-hunk additions: got " + str(ps2["additions"]) + " want 1")
        exit(1)
    if ps2["deletions"] != 1
        print("FAIL patch_stats multi-hunk deletions: got " + str(ps2["deletions"]) + " want 1")
        exit(1)

    print("PASS _patch_stats_test")
