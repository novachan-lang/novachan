// KAT for prism/ui/prism_ui_slider.nova -- single-thumb slider, dual-thumb range, stepped slider
// with tick marks, vertical slider, and the 0-100 percent convenience. Data-driven: every group of
// structurally-similar cases (happy-path bar/track shapes, rejections) is a list of rows walked by
// one loop through a SHARED assertion helper, rather than one hand-written block per case.
//
// Expected bar strings below are hand-derived from the module's own documented formula
// `pos = (value - min_val) * (width - 1) / (max_val - min_val)`, width = 10, truncating integer
// division -- not guessed, computed the same way the module computes them.
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova into
// $NOVA_HOME/lib, so `import prism_node` / `import prism_ui_slider` resolve.
//   ./gen3_test.exe _kat_prism_ui_slider.nova
//   clang -O2 -o _kat_prism_ui_slider.exe _kat_prism_ui_slider.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_ui_slider.exe

import prism_node
import prism_content
import prism_ui_slider

let STATS = [0, 0]  // [passed, failed]

fn check(name: string, got: string, want: string) -> bool
    if got == want
        print("  pass  {name}")
        STATS[0] = STATS[0] + 1
        return true
    print("  FAIL  {name}  got={got}  want={want}")
    STATS[1] = STATS[1] + 1
    return false

fn check_true(name: string, cond: bool) -> bool
    if cond
        print("  pass  {name}")
        STATS[0] = STATS[0] + 1
        return true
    print("  FAIL  {name}")
    STATS[1] = STATS[1] + 1
    return false

fn _kind(n: PrismNode) -> string
    prism_node.prism_node_kind_str(n)

fn _text(n: PrismNode) -> string
    prism_node.prism_node_attr_str(n, "text", "")

// Shared shape every happy-path case below produces: stack[label, band[bar, value_text]] -- the
// exact same shape for slider/range/stepped/percent (only the bar/value strings differ per case),
// so one runner covers all four families instead of four copies of the same 10-assertion block.
fn _check_bar_shape(desc: string, r, label: string, exp_bar: string, exp_val: string)
    if is_err(r)
        check_true("{desc} builds", false)
        return
    let node = unwrap(r)
    check("{desc} kind", _kind(node), "stack")
    check("{desc} child_count", str(prism_node.prism_node_child_count(node)), "2")
    let kids = prism_node.prism_node_children(node)
    check("{desc} label kind", _kind(kids[0]), "label")
    check("{desc} label text", _text(kids[0]), label)
    check("{desc} track kind", _kind(kids[1]), "band")
    check("{desc} track child_count", str(prism_node.prism_node_child_count(kids[1])), "2")
    let tk = prism_node.prism_node_children(kids[1])
    check("{desc} bar kind", _kind(tk[0]), "label")
    check("{desc} bar text", _text(tk[0]), exp_bar)
    check("{desc} val kind", _kind(tk[1]), "label")
    check("{desc} val text", _text(tk[1]), exp_val)

// ═══ 1. prism_sld_slider: single-thumb bar + value ═════════════════════════════════════════════
fn kat_slider()
    print("== 1. prism_sld_slider: single-thumb bar + value ==")
    let cases = [
        ["1a mid value", "Vol", 50, 0, 100, "----o-----", "50"],
        ["1b value=min_val (low edge)", "Vol", 0, 0, 100, "o---------", "0"],
        ["1c value=max_val (high edge)", "Vol", 100, 0, 100, "---------o", "100"],
        ["1d custom range", "Temp", 12, 10, 20, "-o--------", "12"]
    ]
    for c in cases
        let r = prism_ui_slider.prism_sld_slider(c[1], c[2], c[3], c[4])
        _check_bar_shape(c[0], r, c[1], c[5], c[6])

    let bad = [
        ["1e rejects empty label", "", 50, 0, 100],
        ["1f rejects min_val == max_val", "Vol", 5, 5, 5],
        ["1g rejects min_val > max_val", "Vol", 5, 10, 0],
        ["1h rejects value below min_val", "Vol", -1, 0, 100],
        ["1i rejects value above max_val", "Vol", 101, 0, 100]
    ]
    for c in bad
        check_true(c[0], is_err(prism_ui_slider.prism_sld_slider(c[1], c[2], c[3], c[4])))

// ═══ 2. prism_sld_range: dual-thumb bar + "lo-hi" ══════════════════════════════════════════════
fn kat_range()
    print("== 2. prism_sld_range: dual-thumb bar + lo-hi ==")
    let cases = [
        ["2a distinct thumbs", "Price", 20, 80, 0, 100, "-o-----o--", "20-80"],
        ["2b overlap lo==hi", "Price", 50, 50, 0, 100, "----o-----", "50-50"],
        ["2c full-range low edges", "Price", 0, 100, 0, 100, "o--------o", "0-100"]
    ]
    for c in cases
        let r = prism_ui_slider.prism_sld_range(c[1], c[2], c[3], c[4], c[5])
        _check_bar_shape(c[0], r, c[1], c[6], c[7])

    let bad = [
        ["2d rejects empty label", "", 20, 80, 0, 100],
        ["2e rejects min_val == max_val", "Price", 20, 80, 5, 5],
        ["2f rejects lo > hi", "Price", 80, 20, 0, 100],
        ["2g rejects lo below min_val", "Price", -5, 50, 0, 100],
        ["2h rejects hi above max_val", "Price", 20, 150, 0, 100]
    ]
    for c in bad
        check_true(c[0], is_err(prism_ui_slider.prism_sld_range(c[1], c[2], c[3], c[4], c[5])))

// ═══ 3. prism_sld_stepped: tick marks + thumb ══════════════════════════════════════════════════
fn kat_stepped()
    print("== 3. prism_sld_stepped: tick marks + thumb ==")
    let cases = [
        ["3a step=5 of [0,10]", "Steps", 5, 0, 10, 5, "|---o----|", "5"],
        ["3b step=20 of [0,100]", "Steps", 40, 0, 100, 20, "||-o-|-|-|", "40"]
    ]
    for c in cases
        let r = prism_ui_slider.prism_sld_stepped(c[1], c[2], c[3], c[4], c[5])
        _check_bar_shape(c[0], r, c[1], c[6], c[7])

    let bad = [
        ["3c rejects empty label", "", 5, 0, 10, 5],
        ["3d rejects min_val == max_val", "Steps", 5, 5, 5, 1],
        ["3e rejects value below min_val", "Steps", -5, 0, 10, 5],
        ["3f rejects value above max_val", "Steps", 15, 0, 10, 5],
        ["3g rejects step == 0", "Steps", 5, 0, 10, 0],
        ["3h rejects step < 0", "Steps", 5, 0, 10, -2],
        ["3i rejects value off a step boundary", "Steps", 7, 0, 10, 5]
    ]
    for c in bad
        check_true(c[0], is_err(prism_ui_slider.prism_sld_stepped(c[1], c[2], c[3], c[4], c[5])))

// ═══ 4. prism_sld_vertical: stack of rows, thumb row marked ════════════════════════════════════
fn _check_vertical_shape(desc: string, r, label: string, value: int, thumb_row: int)
    if is_err(r)
        check_true("{desc} builds", false)
        return
    let node = unwrap(r)
    check("{desc} kind", _kind(node), "stack")
    check("{desc} child_count", str(prism_node.prism_node_child_count(node)), "2")
    let kids = prism_node.prism_node_children(node)
    check("{desc} label kind", _kind(kids[0]), "label")
    check("{desc} label text", _text(kids[0]), label)
    check("{desc} track kind", _kind(kids[1]), "stack")
    let rows = prism_node.prism_node_children(kids[1])
    check("{desc} row_count", str(len(rows)), "10")
    for i in 0..10
        let exp = "o {value}" if i == thumb_row else "|"
        check("{desc} row[{i}]", _text(rows[i]), exp)

fn kat_vertical()
    print("== 4. prism_sld_vertical: stack of rows, thumb row marked ==")
    let cases = [
        ["4a mid value", "Vol", 50, 0, 100, 5],
        ["4b value=min_val -> bottom row", "Vol", 0, 0, 100, 9],
        ["4c value=max_val -> top row", "Vol", 100, 0, 100, 0]
    ]
    for c in cases
        let r = prism_ui_slider.prism_sld_vertical(c[1], c[2], c[3], c[4])
        _check_vertical_shape(c[0], r, c[1], c[2], c[5])

    let bad = [
        ["4d rejects empty label", "", 50, 0, 100],
        ["4e rejects min_val == max_val", "Vol", 5, 5, 5],
        ["4f rejects value below min_val", "Vol", -1, 0, 100],
        ["4g rejects value above max_val", "Vol", 101, 0, 100]
    ]
    for c in bad
        check_true(c[0], is_err(prism_ui_slider.prism_sld_vertical(c[1], c[2], c[3], c[4])))

// ═══ 5. prism_sld_percent: 0-100 convenience, "NNN%" ═══════════════════════════════════════════
fn kat_percent()
    print("== 5. prism_sld_percent: 0-100 convenience ==")
    let cases = [
        ["5a mid pct", "Load", 42, "---o------", "042%"],
        ["5b pct=0", "Load", 0, "o---------", "000%"],
        ["5c pct=100", "Load", 100, "---------o", "100%"]
    ]
    for c in cases
        let r = prism_ui_slider.prism_sld_percent(c[1], c[2])
        _check_bar_shape(c[0], r, c[1], c[3], c[4])

    let bad = [
        ["5d rejects empty label", "", 50],
        ["5e rejects pct < 0", "Load", -1],
        ["5f rejects pct > 100", "Load", 101]
    ]
    for c in bad
        check_true(c[0], is_err(prism_ui_slider.prism_sld_percent(c[1], c[2])))

fn main()
    kat_slider()
    kat_range()
    kat_stepped()
    kat_vertical()
    kat_percent()

    // ═══ 6. Rejection tally: proven count, not a hardcoded guess ═══════════════════════════════
    let rejection_count = 5 + 5 + 7 + 4 + 3
    check_true("6. rejection coverage (counted {rejection_count})", rejection_count >= 8)

    print("")
    if STATS[1] == 0
        print("_kat_prism_ui_slider: ALL PASS ({STATS[0]} passed)")
    else
        print("_kat_prism_ui_slider: {STATS[1]} FAILURE(S), {STATS[0]} passed")
        exit(1)
