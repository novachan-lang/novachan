import std/collections/radixheap

fn cki(got, want, label)
    if got != want
        print("FAIL radixheap " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(got, want, label)
    if got != want
        print("FAIL radixheap " + label + ": got " + got + " want " + want)
        exit(1)

fn main()
    // KAT 1: empty heap returns null for extract_min and peek_min
    let eh = rh_new()
    let enull = rh_extract_min(eh)
    if enull != null
        print("FAIL radixheap empty_extract: expected null")
        exit(1)
    let pnull = rh_peek_min(eh)
    if pnull != null
        print("FAIL radixheap empty_peek: expected null")
        exit(1)
    cki(rh_size(eh), 0, "empty size == 0")

    // KAT 2: single element insert + extract
    let sh = rh_new()
    rh_insert(sh, 42, "sole")
    cki(rh_size(sh), 1, "single size == 1")
    cki(rh_peek_min(sh), 42, "single peek == 42")
    let sr = rh_extract_min(sh)
    cki(sr[0], 42, "single extract key == 42")
    cks(sr[1], "sole", "single extract val == sole")
    cki(rh_size(sh), 0, "single size after extract == 0")
    let sr2 = rh_extract_min(sh)
    if sr2 != null
        print("FAIL radixheap single_empty_extract: expected null")
        exit(1)

    // KAT 3: main behavioral vector — insert (3,c),(1,a),(5,e),(2,b)
    // extract_min sequence keys must be [1, 2, 3, 5]; values must follow.
    let h = rh_new()
    rh_insert(h, 3, "c")
    rh_insert(h, 1, "a")
    rh_insert(h, 5, "e")
    rh_insert(h, 2, "b")
    cki(rh_size(h), 4, "main vec size == 4")
    cki(rh_peek_min(h), 1, "main vec peek == 1")

    // Extract 1
    let r1 = rh_extract_min(h)
    cki(r1[0], 1, "extract1 key == 1")
    cks(r1[1], "a", "extract1 val == a")
    cki(rh_size(h), 3, "size after extract1 == 3")

    // peek after first extract must be 2
    cki(rh_peek_min(h), 2, "peek_min after extract1 == 2")

    // Extract 2
    let r2 = rh_extract_min(h)
    cki(r2[0], 2, "extract2 key == 2")
    cks(r2[1], "b", "extract2 val == b")

    // Extract 3
    let r3 = rh_extract_min(h)
    cki(r3[0], 3, "extract3 key == 3")
    cks(r3[1], "c", "extract3 val == c")

    // Extract 5
    let r4 = rh_extract_min(h)
    cki(r4[0], 5, "extract4 key == 5")
    cks(r4[1], "e", "extract4 val == e")

    cki(rh_size(h), 0, "size after all extracts == 0")
    let rfinal = rh_extract_min(h)
    if rfinal != null
        print("FAIL radixheap final_extract_null: expected null")
        exit(1)

    // KAT 4: monotone re-insert (keys >= last extracted min) works.
    // Last extracted was 5. Insert 5, 7, 6 — all >= 5.
    let mh = rh_new()
    rh_insert(mh, 10, "ten")
    rh_insert(mh, 20, "twenty")
    let mx1 = rh_extract_min(mh)
    cki(mx1[0], 10, "mono extract1 key == 10")
    // Now re-insert with keys >= 10
    rh_insert(mh, 15, "fifteen")
    rh_insert(mh, 10, "ten2")
    let mx2 = rh_extract_min(mh)
    cki(mx2[0], 10, "mono extract2 key == 10")
    cks(mx2[1], "ten2", "mono extract2 val == ten2")
    let mx3 = rh_extract_min(mh)
    cki(mx3[0], 15, "mono extract3 key == 15")
    let mx4 = rh_extract_min(mh)
    cki(mx4[0], 20, "mono extract4 key == 20")
    cki(rh_size(mh), 0, "mono final size == 0")

    // KAT 5: duplicates — multiple items with the same key
    let dh = rh_new()
    rh_insert(dh, 5, "p")
    rh_insert(dh, 5, "q")
    rh_insert(dh, 5, "r")
    cki(rh_size(dh), 3, "dup size == 3")
    cki(rh_peek_min(dh), 5, "dup peek == 5")
    let d1 = rh_extract_min(dh)
    cki(d1[0], 5, "dup extract1 key == 5")
    let d2 = rh_extract_min(dh)
    cki(d2[0], 5, "dup extract2 key == 5")
    let d3 = rh_extract_min(dh)
    cki(d3[0], 5, "dup extract3 key == 5")
    cki(rh_size(dh), 0, "dup final size == 0")

    // KAT 6: large-range keys (tests bucket-spread across many buckets)
    let lh = rh_new()
    rh_insert(lh, 0, "zero")
    rh_insert(lh, 1000000, "million")
    rh_insert(lh, 500, "fiveh")
    rh_insert(lh, 1, "one")
    cki(rh_peek_min(lh), 0, "large range peek == 0")
    let l1 = rh_extract_min(lh)
    cki(l1[0], 0, "large extract1 == 0")
    let l2 = rh_extract_min(lh)
    cki(l2[0], 1, "large extract2 == 1")
    let l3 = rh_extract_min(lh)
    cki(l3[0], 500, "large extract3 == 500")
    let l4 = rh_extract_min(lh)
    cki(l4[0], 1000000, "large extract4 == 1000000")

    print("PASS _radixheap_test")

main()
