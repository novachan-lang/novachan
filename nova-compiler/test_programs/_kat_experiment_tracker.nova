import forge_experiment_tracker

fn main()
    let t = et_new()
    assert(et_experiment_count(t) == 0, "0 experiments initially")
    assert(et_completed_count(t) == 0, "0 completed initially")

    let t1 = et_start(t, "run_a", "lr=0.01,epochs=10")
    assert(et_experiment_count(t1) == 1, "1 experiment after start")

    let st1 = et_status(t1, "run_a")
    assert(is_ok(st1), "status ok")
    assert(unwrap(st1) == "running", "run_a is running")

    let pr1 = et_params(t1, "run_a")
    assert(is_ok(pr1), "params ok")
    assert(unwrap(pr1) == "lr=0.01,epochs=10", "params match")

    let lm1 = et_log_metric(t1, "run_a", "accuracy", 90)
    assert(is_ok(lm1), "log metric ok")
    let lm2 = et_log_metric(t1, "run_a", "loss", 5)
    assert(is_ok(lm2), "log metric loss ok")

    let am = et_metric(t1, "run_a", "accuracy")
    assert(is_ok(am), "get metric ok")
    assert(unwrap(am) == 90, "accuracy is 90")

    assert(is_err(et_log_metric(t1, "unknown_run", "accuracy", 1)), "log metric unknown run errors")
    assert(is_err(et_metric(t1, "run_a", "unknown_metric")), "get unknown metric errors")

    let t2 = et_start(t1, "run_b", "lr=0.05,epochs=20")
    assert(et_experiment_count(t2) == 2, "2 experiments now")
    let lm3 = et_log_metric(t2, "run_b", "accuracy", 95)
    assert(is_ok(lm3), "log run_b accuracy ok")

    let comp1 = et_complete(t2, "run_a")
    assert(is_ok(comp1), "complete run_a ok")
    assert(et_completed_count(t2) == 1, "1 completed")

    let st2 = et_status(t2, "run_a")
    assert(unwrap(st2) == "completed", "run_a now completed")

    assert(is_err(et_complete(t2, "run_a")), "double complete errors")
    assert(is_err(et_complete(t2, "unknown_run")), "complete unknown errors")
    assert(is_err(et_status(t2, "unknown_run")), "status unknown errors")
    assert(is_err(et_params(t2, "unknown_run")), "params unknown errors")

    let best = et_best(t2, "accuracy")
    assert(is_ok(best), "best ok")
    assert(unwrap(best) == "run_b", "run_b has the highest accuracy")

    assert(is_err(et_best(t2, "unknown_metric")), "best on unknown metric errors")

    print("EXPERIMENT-TRACKER KAT PASS")
