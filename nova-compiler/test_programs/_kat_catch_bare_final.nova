// KAT: CLUSTER C remainder — a BARE multi-line `catch` as a function's implicit-return
// FINAL statement must not swallow the next `fn` declaration.
//
// The multi-line catch handler loop skips newlines while scanning for its next handler
// statement, so on exit the cursor sits DIRECTLY on the following token instead of on a
// NEWLINE (every other statement leaves it on the NEWLINE). The bare-expression path then
// handed that adjacent `fn` to the trailing-lambda parser, which ate the next function
// ("expected '(' but found 'g'"). Guarded by _tf_is_trailing: a trailing fn must be
// indented PAST the statement column.

fn bare_multi(path: string) -> string
    read_file(path) catch e
        "MISSING_BARE"

fn survives_after_bare() -> string
    "NEXT_FN_ALIVE"

fn bare_then_bare(path: string) -> int
    parse_int(read_file(path)) catch e
        -1

fn also_survives() -> int
    99

fn main() -> int
    assert(bare_multi("nope_zzz_9137.txt") == "MISSING_BARE", "bare multi-line catch value")
    assert(survives_after_bare() == "NEXT_FN_ALIVE", "fn after bare catch survives")
    assert(bare_then_bare("nope_zzz_9137.txt") == -1, "second bare catch value")
    assert(also_survives() == 99, "second following fn survives")
    print("PASS _kat_catch_bare_final")
    return 0

main()
