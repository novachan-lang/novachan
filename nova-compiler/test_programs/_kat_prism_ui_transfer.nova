// KAT for prism/ui/prism_ui_transfer.nova (the `ui/` composition layer's dual-list transfer /
// assignment picker: item, transfer render, move_right, move_left).
//
// Proves, against concrete expected values (every depth/count is hand-computed from
// prism_node.nova's own `depth = max(child depths) + 1`, `count = 1 + sum(child counts)` rule,
// never guessed -- same discipline _kat_prism_ui_token.nova's own header commits to):
//   1. Item: the wrapper + all 3 accessors round-trip key/label/disabled exactly.
//   2. Transfer render: exact band(d=4,c=13)[left stack(d=2,c=4), buttons stack(d=3,c=5), right
//      stack(d=2,c=3)] over items=[Alpha, Beta, Gamma(disabled)] with right_keys=["b"] -- left has
//      [title, Alpha, "Gamma (disabled)"], right has [title, Beta], each button's accessible text
//      is a full sentence and its visual child is the ">>"/"<<" glyph (not the sentence itself).
//   3. Rejections: a non-PrismTransferItem element, a duplicate item key, an unknown right_keys
//      entry, and both an empty left_title and an empty right_title.
//   4. Mutation, pure (no input list is ever observed to mutate): move_right adds a left-panel
//      selection, skips a disabled one, and rejects an unknown or already-right key; move_left is
//      the mirror image -- removes a right-panel selection, skips a disabled ("locked") one, and
//      rejects an unknown or not-yet-right key.
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova into
// $NOVA_HOME/lib, so `import prism_node` / `import prism_ui_transfer` resolve.
//   ./gen3_test.exe _kat_prism_ui_transfer.nova
//   clang -O2 -o _kat_prism_ui_transfer.exe _kat_prism_ui_transfer.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_ui_transfer.exe

import prism_node
import prism_ui_transfer as xf

let FAILED = [0]

fn _check(label: string, got: string, want: string)
    if got == want
        print("  pass  " + label)
    else
        print("  FAIL  " + label + "  got=" + got + "  want=" + want)
        FAILED[0] = FAILED[0] + 1

fn _check_true(label: string, cond: bool)
    if cond
        print("  pass  " + label)
    else
        print("  FAIL  " + label)
        FAILED[0] = FAILED[0] + 1

// Canonical comma-joined rendering of a `list<string>`, so a list-valued Result can be compared
// with `_check` the same way every scalar accessor is -- an empty list renders as "".
fn _join(xs: list) -> string
    let mut out = ""
    let mut first = true
    for x in xs
        if first
            out = x
            first = false
        else
            out = out + "," + x
    out

fn _items() -> list
    [xf.prism_xf_item("a", "Alpha", false), xf.prism_xf_item("b", "Beta", false), xf.prism_xf_item("c", "Gamma", true)]

fn main()
    let items = _items()

    // ── 1. Item: wrapper + accessors round-trip exactly ─────────────────────────────────────
    let alpha = xf.prism_xf_item("a", "Alpha", false)
    _check("item accessor: key", xf.prism_xf_item_key(alpha), "a")
    _check("item accessor: label", xf.prism_xf_item_label(alpha), "Alpha")
    _check_true("item accessor: disabled is false", not xf.prism_xf_item_disabled(alpha))
    let gamma = xf.prism_xf_item("c", "Gamma", true)
    _check("item accessor: key (disabled item)", xf.prism_xf_item_key(gamma), "c")
    _check_true("item accessor: disabled is true", xf.prism_xf_item_disabled(gamma))
    print("")

    // ── 2. Transfer render: exact band(d=4,c=13)[stack(d=2,c=4), stack(d=3,c=5), stack(d=2,c=3)] ──
    let right_keys = ["b"]
    let t_r = xf.prism_xf_transfer(items, right_keys, "Available", "Assigned")
    _check_true("transfer constructs", is_ok(t_r))
    let root = unwrap(t_r)
    _check("root kind_str", prism_node.prism_node_kind_str(root), "band")
    _check("root depth", str(prism_node.prism_node_depth(root)), "4")
    _check("root count", str(prism_node.prism_node_count(root)), "13")
    _check("root child count", str(prism_node.prism_node_child_count(root)), "3")
    let root_kids = prism_node.prism_node_children(root)

    // Left panel: title + Alpha + "Gamma (disabled)" (Beta excluded -- it is in right_keys)
    let left_panel = root_kids[0]
    _check("left panel kind_str", prism_node.prism_node_kind_str(left_panel), "stack")
    _check("left panel depth", str(prism_node.prism_node_depth(left_panel)), "2")
    _check("left panel count", str(prism_node.prism_node_count(left_panel)), "4")
    _check("left panel child count", str(prism_node.prism_node_child_count(left_panel)), "3")
    let left_kids = prism_node.prism_node_children(left_panel)
    _check("left panel title kind_str", prism_node.prism_node_kind_str(left_kids[0]), "label")
    _check("left panel title text", prism_node.prism_node_attr_str(left_kids[0], "text", ""), "Available")
    _check("left panel has Alpha", prism_node.prism_node_attr_str(left_kids[1], "text", ""), "Alpha")
    _check("left panel has Gamma with disabled suffix", prism_node.prism_node_attr_str(left_kids[2], "text", ""), "Gamma (disabled)")
    _check_true("disabled suffix present (substring check)", contains(prism_node.prism_node_attr_str(left_kids[2], "text", ""), "(disabled)"))

    // Button column: ">>" / "<<" glyph as visual content, a full sentence as accessible text
    let buttons = root_kids[1]
    _check("buttons kind_str", prism_node.prism_node_kind_str(buttons), "stack")
    _check("buttons depth", str(prism_node.prism_node_depth(buttons)), "3")
    _check("buttons count", str(prism_node.prism_node_count(buttons)), "5")
    _check("buttons child count", str(prism_node.prism_node_child_count(buttons)), "2")
    let button_kids = prism_node.prism_node_children(buttons)
    _check("move-right button kind_str", prism_node.prism_node_kind_str(button_kids[0]), "press")
    _check("move-right button accessible text", prism_node.prism_node_attr_str(button_kids[0], "text", ""), "Move selected to right panel")
    let right_btn_kids = prism_node.prism_node_children(button_kids[0])
    _check("move-right button child count", str(len(right_btn_kids)), "1")
    _check("move-right button visual content", prism_node.prism_node_attr_str(right_btn_kids[0], "text", ""), ">>")
    _check("move-left button kind_str", prism_node.prism_node_kind_str(button_kids[1]), "press")
    _check("move-left button accessible text", prism_node.prism_node_attr_str(button_kids[1], "text", ""), "Move selected to left panel")
    let left_btn_kids = prism_node.prism_node_children(button_kids[1])
    _check("move-left button child count", str(len(left_btn_kids)), "1")
    _check("move-left button visual content", prism_node.prism_node_attr_str(left_btn_kids[0], "text", ""), "<<")

    // Right panel: title + Beta only
    let right_panel = root_kids[2]
    _check("right panel kind_str", prism_node.prism_node_kind_str(right_panel), "stack")
    _check("right panel depth", str(prism_node.prism_node_depth(right_panel)), "2")
    _check("right panel count", str(prism_node.prism_node_count(right_panel)), "3")
    _check("right panel child count", str(prism_node.prism_node_child_count(right_panel)), "2")
    let right_kids = prism_node.prism_node_children(right_panel)
    _check("right panel title text", prism_node.prism_node_attr_str(right_kids[0], "text", ""), "Assigned")
    _check("right panel has Beta", prism_node.prism_node_attr_str(right_kids[1], "text", ""), "Beta")
    print("")

    // ── 3. Rejections ─────────────────────────────────────────────────────────────────────────
    let bad_elem_r = xf.prism_xf_transfer([42], [], "Available", "Assigned")
    _check_true("transfer rejects a non-PrismTransferItem element", is_err(bad_elem_r))

    let dup_items = [xf.prism_xf_item("a", "Alpha", false), xf.prism_xf_item("a", "Alpha2", false)]
    let dup_r = xf.prism_xf_transfer(dup_items, [], "Available", "Assigned")
    _check_true("transfer rejects a duplicate item key", is_err(dup_r))

    let unknown_key_r = xf.prism_xf_transfer(items, ["zzz"], "Available", "Assigned")
    _check_true("transfer rejects an unknown right_keys entry", is_err(unknown_key_r))

    let empty_left_title_r = xf.prism_xf_transfer(items, right_keys, "", "Assigned")
    _check_true("transfer rejects an empty left_title", is_err(empty_left_title_r))
    let empty_right_title_r = xf.prism_xf_transfer(items, right_keys, "Available", "")
    _check_true("transfer rejects an empty right_title", is_err(empty_right_title_r))
    print("")

    // ── 4. Mutation: move_right ───────────────────────────────────────────────────────────────
    let mr_ok = xf.prism_xf_move_right(items, right_keys, ["a"])
    _check_true("move_right (a: left, enabled) succeeds", is_ok(mr_ok))
    _check("move_right works", _join(unwrap(mr_ok)), "b,a")

    let mr_disabled = xf.prism_xf_move_right(items, right_keys, ["c"])
    _check_true("move_right (c: left, disabled) succeeds", is_ok(mr_disabled))
    _check("move_right skips disabled", _join(unwrap(mr_disabled)), "b")

    let mr_unknown = xf.prism_xf_move_right(items, right_keys, ["zzz"])
    _check_true("move_right rejects an unknown selected key", is_err(mr_unknown))
    let mr_already_right = xf.prism_xf_move_right(items, right_keys, ["b"])
    _check_true("move_right rejects a key already in the right panel", is_err(mr_already_right))
    print("")

    // ── 5. Mutation: move_left ────────────────────────────────────────────────────────────────
    let ml_ok = xf.prism_xf_move_left(items, right_keys, ["b"])
    _check_true("move_left (b: right, enabled) succeeds", is_ok(ml_ok))
    _check("move_left works", _join(unwrap(ml_ok)), "")

    let right_keys_locked = ["b", "c"]
    let ml_disabled = xf.prism_xf_move_left(items, right_keys_locked, ["c"])
    _check_true("move_left (c: right, disabled/locked) succeeds", is_ok(ml_disabled))
    _check("move_left skips disabled", _join(unwrap(ml_disabled)), "b,c")

    let ml_unknown = xf.prism_xf_move_left(items, right_keys, ["zzz"])
    _check_true("move_left rejects an unknown selected key", is_err(ml_unknown))
    let ml_not_right = xf.prism_xf_move_left(items, right_keys, ["a"])
    _check_true("move_left rejects a key not in the right panel", is_err(ml_not_right))
    print("")

    if FAILED[0] == 0
        print("")
        print("_kat_prism_ui_transfer: ALL PASS")
    else
        print("")
        print("_kat_prism_ui_transfer: " + str(FAILED[0]) + " FAILURE(S)")
        exit(1)
