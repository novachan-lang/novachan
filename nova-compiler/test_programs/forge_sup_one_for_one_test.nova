// Forge T4.2: one_for_one supervision. A TRANSIENT child that CRASHES (panics) on its first two runs
// and SUCCEEDS on the third is respawned exactly twice by the supervisor, then retires on normal exit.
// Socketless (spawn/monitor/atomic/channel) -> deterministic, kill-on-timeout safe. Exits 1 on mismatch.
import forge_otp

// The child body (a top-level fn so the start_fn can be a single-line capturing lambda). Increments a
// SHARED attempt counter (atomics + channels are shared across spawn, not deep-copied), panics on runs
// 1 and 2 (-> the supervisor sees a crash and restarts a transient child), and on run 3 signals success
// and exits normally (-> a transient child retires).
fn flaky_run(attempts, done)
    let n = atomic_add(attempts, 1)
    if n < 3
        panic("forced crash on run " + str(n))
    send(done, n)

fn main()
    let attempts = atomic_new(0)
    let done = channel()
    let child = fn() flaky_run(attempts, done)
    let sup = sup_new("one_for_one", 5, 10)
    child_add(sup, "flaky", child, "transient", 5000)
    if sup_child_count(sup) != 1
        print("FAIL: child_count should be 1")
        exit(1)
    sup_start(sup)
    let r = receive(done)
    if r != 3
        print("FAIL: child should succeed on run 3, got " + str(r))
        exit(1)
    if atomic_get(attempts) != 3
        print("FAIL: child should have RUN 3 times (respawned twice); attempts=" + str(atomic_get(attempts)))
        exit(1)
    print("PASS forge_sup_one_for_one (transient child crashed x2, respawned x2, succeeded on run 3)")
