import forge_linkcut as lc

fn check(cond: bool, label: str)
    if cond == false
        print("FAIL: " + label)

// Reference model: a dynamic forest with parent pointers (values fixed).
// We maintain parent[] where parent[root] = -1 and answer connectivity/path-sum by walking.
fn ref_connected(parent: list, u: int, v: int) -> bool
    // find root of u
    let ru = u
    while parent[ru] >= 0
        ru = parent[ru]
    let rv = v
    while parent[rv] >= 0
        rv = parent[rv]
    return ru == rv

fn ref_path_sum(parent: list, values: list, u: int, v: int) -> int
    // find path u..v via LCA using ancestor sets
    let anc = {}
    let cu = u
    anc[str(cu)] = 1
    while parent[cu] >= 0
        cu = parent[cu]
        anc[str(cu)] = 1
    let cv = v
    while get(anc, str(cv), 0) == 0
        cv = parent[cv]
    let lca = cv
    let total = values[lca]
    let a = u
    while a != lca
        total = total + values[a]
        a = parent[a]
    let b = v
    while b != lca
        total = total + values[b]
        b = parent[b]
    return total

// TEST 1: basic link / connected / cut
let vals = [1, 2, 3, 4, 5]
let t = lc.lc_new(5, vals)
check(lc.lc_connected(t, 0, 1) == false, "initially 0,1 disconnected")
lc.lc_link(t, 0, 1)  // 0 under 1
check(lc.lc_connected(t, 0, 1), "after link 0,1 connected")
lc.lc_link(t, 2, 1)  // 2 under 1
check(lc.lc_connected(t, 0, 2), "0,2 connected via 1")
check(lc.lc_connected(t, 0, 3) == false, "0,3 still disconnected")
lc.lc_link(t, 3, 2)  // 3 under 2
check(lc.lc_connected(t, 0, 3), "0,3 connected now")

// path sum 0..3: 0-1-2-3 -> vals 1+2+3+4 = 10
check(lc.lc_path_sum(t, 0, 3) == 10, "path 0..3 sum = 10")
// path 3..3 = 4
check(lc.lc_path_sum(t, 3, 3) == 4, "path 3..3 = 4")
// path 0..2: 0-1-2 -> 1+2+3 = 6
check(lc.lc_path_sum(t, 0, 2) == 6, "path 0..2 = 6")

// TEST 2: cut splits the tree
lc.lc_cut(t, 3, 2)  // remove edge 3-2
check(lc.lc_connected(t, 3, 0) == false, "after cut 3,0 disconnected")
check(lc.lc_connected(t, 0, 2), "0,2 still connected after cut")

// TEST 3: relink
lc.lc_link(t, 3, 0)  // 3 under 0 now
check(lc.lc_connected(t, 3, 2), "relink 3->0 reconnects to 2")
// path 3..2: 3-0-1-2 -> 4+1+2+3 = 10
check(lc.lc_path_sum(t, 3, 2) == 10, "path 3..2 after relink = 10")

// TEST 4: set_val updates path sums
lc.lc_set_val(t, 0, 100)  // was 1, now 100
check(lc.lc_path_sum(t, 3, 2) == 4 + 100 + 2 + 3, "path 3..2 after set_val(0,100) = 109")

// TEST 5: DECISIVE cross-check against a reference forest with random link/cut/query ops
let n = 12
let values = []
let ref_parent = []
let i = 0
while i < n
    push(values, i + 1)
    push(ref_parent, 0 - 1)
    i = i + 1
let lct = lc.lc_new(n, values)

let ok = true
let seed = 20260707
let step = 0
while step < 300
    seed = (seed * 1103515245 + 12345) % 2147483648
    let op = seed % 4
    seed = (seed * 1103515245 + 12345) % 2147483648
    let u = seed % n
    seed = (seed * 1103515245 + 12345) % 2147483648
    let v = seed % n
    if op == 0
        // link: only valid if u is a root and u,v not connected
        if ref_parent[u] < 0 and ref_connected(ref_parent, u, v) == false and u != v
            lc.lc_link(lct, u, v)
            ref_parent[u] = v
    else
        if op == 1
            // cut edge (u -> its parent) if u has a parent
            if ref_parent[u] >= 0
                let p = ref_parent[u]
                lc.lc_cut(lct, u, p)
                ref_parent[u] = 0 - 1
        else
            if op == 2
                // connectivity query
                let exp = ref_connected(ref_parent, u, v)
                let got = lc.lc_connected(lct, u, v)
                if exp != got
                    ok = false
                    print("CONN MISMATCH step=" + str(step) + " u=" + str(u) + " v=" + str(v) + " exp=" + str(exp) + " got=" + str(got))
            else
                // path sum query (only if connected)
                if ref_connected(ref_parent, u, v)
                    let exp = ref_path_sum(ref_parent, values, u, v)
                    let got = lc.lc_path_sum(lct, u, v)
                    if exp != got
                        ok = false
                        print("PATHSUM MISMATCH step=" + str(step) + " u=" + str(u) + " v=" + str(v) + " exp=" + str(exp) + " got=" + str(got))
    step = step + 1
check(ok, "DECISIVE: 300 random link/cut/connected/path-sum ops match reference forest")

print("forge_linkcut: KAT done")
