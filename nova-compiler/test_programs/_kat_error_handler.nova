import forge_error_handler

fn main()
    let eh = eh_new()
    assert(eh_total(eh) == 0, "empty")

    eh = eh_report(eh, "db", "connection timeout", "pg_pool")
    eh = eh_report(eh, "db", "connection timeout", "pg_pool")
    eh = eh_report(eh, "db", "connection timeout", "pg_pool")
    eh = eh_report(eh, "http", "404 not found", "router")
    eh = eh_report(eh, "http", "500 internal", "handler")
    eh = eh_report(eh, "auth", "invalid token", "middleware")

    assert(eh_total(eh) == 6, "6 total")
    assert(eh_unique_count(eh) == 4, "4 unique (db deduped)")

    assert(eh_category_count(eh, "db") == 3, "3 db errors")
    assert(eh_category_count(eh, "http") == 2, "2 http errors")
    assert(eh_category_count(eh, "auth") == 1, "1 auth error")
    assert(eh_category_count(eh, "missing") == 0, "0 missing")

    let db_errs = eh_by_category(eh, "db")
    assert(len(db_errs) == 1, "1 unique db error (deduped)")
    assert(db_errs[0]["count"] == 3, "3 occurrences")

    let top = eh_top_errors(eh, 2)
    assert(len(top) == 2, "top 2")
    assert(top[0]["count"] == 3, "most frequent=3")
    assert(top[0]["message"] == "connection timeout", "top=timeout")

    let cats = eh_categories(eh)
    assert(len(cats) == 3, "3 categories")

    print("ERROR-HANDLER KAT PASS")
