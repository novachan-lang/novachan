import forge_setops

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn joinl(xs: list) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + ","
        out = out + str(xs[i])
        i = i + 1
    out

fn main()
    let fails = 0

    // unique (first-seen order)
    fails = fails + expect("uniq", joinl(unique([3, 1, 3, 2, 1, 4])), "3,1,2,4")
    fails = fails + expect("uniq_none", joinl(unique([1, 2, 3])), "1,2,3")
    fails = fails + expect("uniq_empty", str(len(unique([]))), "0")

    // union
    fails = fails + expect("union", joinl(list_union([1, 2, 3], [2, 3, 4])), "1,2,3,4")
    fails = fails + expect("union_disjoint", joinl(list_union([1, 2], [3, 4])), "1,2,3,4")
    fails = fails + expect("union_dups", joinl(list_union([1, 1, 2], [2, 2, 3])), "1,2,3")

    // intersection
    fails = fails + expect("inter", joinl(list_intersection([1, 2, 3, 4], [2, 4, 6])), "2,4")
    fails = fails + expect("inter_none", str(len(list_intersection([1, 2], [3, 4]))), "0")
    fails = fails + expect("inter_order", joinl(list_intersection([5, 3, 1], [1, 3, 5])), "5,3,1")

    // difference
    fails = fails + expect("diff", joinl(list_difference([1, 2, 3, 4], [2, 4])), "1,3")
    fails = fails + expect("diff_all", joinl(list_difference([1, 2, 3], [])), "1,2,3")
    fails = fails + expect("diff_none", str(len(list_difference([1, 2], [1, 2, 3]))), "0")

    // symmetric difference
    fails = fails + expect("symdiff", joinl(symmetric_difference([1, 2, 3], [2, 3, 4])), "1,4")
    fails = fails + expect("symdiff2", joinl(symmetric_difference([1, 2], [3, 4])), "1,2,3,4")
    fails = fails + expect("symdiff_same", str(len(symmetric_difference([1, 2, 3], [3, 2, 1]))), "0")

    if fails == 0
        print("forge_setops: all passed")
    else
        print("forge_setops: " + str(fails) + " FAILED")
