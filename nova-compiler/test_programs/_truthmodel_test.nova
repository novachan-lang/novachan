// CORE_GAP 0.7 regression guard: boxed-float truthiness must be value-correct.
// A boxed 0.0 (non-null pointer) must be FALSY; a nonzero boxed float TRUTHY.
// Self-asserting: exit(1) on any wrong branch so the CI gate catches a regression.
fn main()
    let fs = [0.0, 2.5]
    // bare `if` on a boxed float element
    if fs[0]
        print("FAIL: if boxed-0.0 took true branch")
        exit(1)
    if fs[1]
        // correct: 2.5 is truthy
        print("ok")
    else
        print("FAIL: if boxed-2.5 took false branch")
        exit(1)
    // `not` on a boxed float
    if not fs[0]
        print("ok")
    else
        print("FAIL: not boxed-0.0 was false")
        exit(1)
    if not fs[1]
        print("FAIL: not boxed-2.5 was true")
        exit(1)
    // dict-boxed float
    let d = {}
    d["z"] = 0.0
    d["n"] = 7.0
    if d["z"]
        print("FAIL: if dict boxed-0.0 took true branch")
        exit(1)
    if not d["n"]
        print("FAIL: not dict boxed-7.0 was true")
        exit(1)
    // and / or on boxed floats (non-short-circuit inst form)
    if fs[0] and fs[1]
        print("FAIL: (0.0 and 2.5) truthy")
        exit(1)
    if fs[1] or fs[0]
        print("ok")
    else
        print("FAIL: (2.5 or 0.0) falsy")
        exit(1)
    print("PASS truthmodel")
