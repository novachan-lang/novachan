// KAT test for std/config/envschema
import std/config/envschema

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + got + " expected " + expected)
        exit(1)

fn ckf(label, got, expected)
    let diff = got - expected
    if diff < 0.0
        diff = 0.0 - diff
    if diff > 0.001
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn main()
    // -----------------------------------------------------------------------
    // KAT 1-4: basic schema with PORT (int), DEBUG (bool), RATE (float)
    // -----------------------------------------------------------------------
    let s = es_new()
    es_field(s, "PORT",  "int",   "8080",  false)
    es_field(s, "DEBUG", "bool",  "false", false)
    es_field(s, "RATE",  "float", "1.5",   false)

    let env1 = {}
    env1["PORT"]  = "3000"
    env1["DEBUG"] = "true"
    let cfg = es_load(s, env1)

    // PORT should be coerced to int 3000
    cki("PORT from env",   cfg["PORT"],  3000)

    // DEBUG "true" -> int 1
    cki("DEBUG true->1",   cfg["DEBUG"], 1)

    // RATE not in env -> default "1.5" -> float 1.5
    ckf("RATE default",    cfg["RATE"],  1.5)

    // -----------------------------------------------------------------------
    // KAT 5-6: empty envdict -> all defaults
    // -----------------------------------------------------------------------
    let cfg2 = es_load(s, {})

    // PORT default "8080" -> 8080
    cki("PORT default 8080", cfg2["PORT"],  8080)

    // DEBUG default "false" -> 0
    cki("DEBUG default 0",   cfg2["DEBUG"], 0)

    // -----------------------------------------------------------------------
    // KAT 7: es_errors — required field missing
    // -----------------------------------------------------------------------
    let s2 = es_new()
    es_field(s2, "KEY", "string", "", true)

    let errs1 = es_errors(s2, {})
    cki("errors missing KEY", len(errs1), 1)

    // -----------------------------------------------------------------------
    // KAT 8: es_errors — required field present
    // -----------------------------------------------------------------------
    let env2 = {}
    env2["KEY"] = "x"
    let errs2 = es_errors(s2, env2)
    cki("errors KEY present", len(errs2), 0)

    // -----------------------------------------------------------------------
    // KAT 9: bool coercions — "1", "yes", "on", "anything"
    // -----------------------------------------------------------------------
    let sb = es_new()
    es_field(sb, "A", "bool", "0", false)
    es_field(sb, "B", "bool", "0", false)
    es_field(sb, "C", "bool", "0", false)
    es_field(sb, "D", "bool", "0", false)

    let eb = {}
    eb["A"] = "1"
    eb["B"] = "yes"
    eb["C"] = "on"
    eb["D"] = "nope"
    let cfgb = es_load(sb, eb)

    cki("bool 1",    cfgb["A"], 1)
    cki("bool yes",  cfgb["B"], 1)
    cki("bool on",   cfgb["C"], 1)
    cki("bool nope", cfgb["D"], 0)

    // -----------------------------------------------------------------------
    // KAT 10: negative int and float parsing
    // -----------------------------------------------------------------------
    let sn = es_new()
    es_field(sn, "OFFSET", "int",   "-42",  false)
    es_field(sn, "DELTA",  "float", "-3.14", false)

    let cfgn = es_load(sn, {})
    cki("neg int default",   cfgn["OFFSET"], -42)
    ckf("neg float default", cfgn["DELTA"],  -3.14)

    // -----------------------------------------------------------------------
    // KAT 11: string type passes value through unchanged
    // -----------------------------------------------------------------------
    let ss = es_new()
    es_field(ss, "NAME", "string", "world", false)

    let cfgs = es_load(ss, {})
    cks("string default", cfgs["NAME"], "world")

    let es2 = {}
    es2["NAME"] = "nova"
    let cfgs2 = es_load(ss, es2)
    cks("string from env", cfgs2["NAME"], "nova")

    // -----------------------------------------------------------------------
    // KAT 12: multiple required fields, partial presence
    // -----------------------------------------------------------------------
    let sm = es_new()
    es_field(sm, "HOST", "string", "", true)
    es_field(sm, "PORT", "int",    "", true)
    es_field(sm, "MODE", "string", "prod", false)

    let em = {}
    em["HOST"] = "localhost"
    let errsm = es_errors(sm, em)
    // HOST present, PORT missing -> 1 error
    cki("partial required errors", len(errsm), 1)

    print("_envschema_test passed")
