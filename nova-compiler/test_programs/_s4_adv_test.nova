// S4 typed-array adversarial suite (covers the 12-attack devils-advocate review).
// Self-checking via assert(). On the INERT elem_kind foundation all pass (kind 0 = current boxed
// behavior). After the behavioral S4 changes (deopt + raw float storage + guarded native load) they
// MUST STILL pass -> the permanent guard that the runtime-authoritative deopt design holds. Every
// case is a path where a naive typed-array optimization would corrupt (type confusion / UAF / wrong
// answer): aliasing, polymorphic helper, struct field, dict value, realloc-during-iteration,
// empty-then-heterogeneous, any-read egress, negative floats.

type Box
    items: list

fn pushfloat(lst)
    push(lst, 9.5)

fn sumread(lst)
    let s = 0.0
    let i = 0
    while i < len(lst)
        s = s + lst[i]
        i = i + 1
    s

fn main()
    // 1. ALIASING: ys aliases the same object; a heterogeneous push via the alias must be observed
    //    when reading through xs (runtime deopt; a per-variable compile proof would miss this).
    let xs = [1.0, 2.0, 3.0]
    let ys = xs
    push(ys, "str")
    assert(xs[0] == 1.0, "alias: float preserved")
    assert(xs[3] == "str", "alias: hetero append visible through xs")

    // 2. POLYMORPHIC HELPER: same body sees a float push; called with a float-list AND a string-list.
    let fl = [1.0, 2.0]
    let sl = ["a", "b"]
    pushfloat(fl)
    assert(fl[2] == 9.5, "poly: float push")
    assert(sl[0] == "a", "poly: string list intact")

    // 3. READ-ONLY ESCAPE: the common fast case — a float array passed to a pure consumer.
    let ra = [1.0, 2.0, 3.0, 4.0]
    assert(sumread(ra) == 10.0, "readonly escape sum")

    // 4. STRUCT FIELD holding a list, then heterogeneous mutation through the field.
    let b = Box([1.0, 2.0])
    push(b.items, "x")
    assert(b.items[0] == 1.0, "struct field: float")
    assert(b.items[2] == "x", "struct field: hetero")

    // 5. DICT VALUE list, element read back through an any-typed binding.
    let d = {"v": [1.0, 2.0]}
    let v = d["v"]
    assert(v[1] == 2.0, "dict value list read")

    // 6. REALLOC DURING ITERATION: grow the list inside a loop that also reads it.
    let g = [1.0]
    let k = 0
    while k < 20
        push(g, str(k))
        k = k + 1
    assert(g[0] == 1.0, "realloc: float head intact")
    assert(g[20] == "19", "realloc: tail")

    // 7. EMPTY-THEN-HETEROGENEOUS: a float list, reassigned empty, then a string pushed.
    let e = [1.0, 2.0]
    e = []
    push(e, "now")
    assert(e[0] == "now", "empty then hetero")

    // 8. ANY-READ MIX: a float list element flows into an any container (dict) and back out.
    let mix = [1.5, 2.5]
    let holder = {}
    holder["f"] = mix[0]
    assert(holder["f"] == 1.5, "any-read egress boxes correctly")

    // 9. NEGATIVE FLOATS round-trip (sort-comparator / sign-bit hazard surface).
    let neg = [-5.0, -1.0, -3.0]
    assert(neg[0] == -5.0, "neg head")
    assert(neg[2] == -3.0, "neg tail")

    print("S4_ADV_OK")
