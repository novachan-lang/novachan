import std/bits/bitrotate

// cki — integer known-answer check.
fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL bitrotate " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // --- rot_rotl ---
    // rotl(1, 1, 8): 0b00000001 left by 1 -> 0b00000010 = 2
    cki("rotl(1,1,8)", rot_rotl(1, 1, 8), 2)
    // rotl(128, 1, 8): 0b10000000 left by 1 -> high bit wraps to bit0 -> 0b00000001 = 1
    cki("rotl(128,1,8)", rot_rotl(128, 1, 8), 1)
    // rotl(240, 4, 8): 0b11110000 left by 4 -> low nibble becomes high, high becomes low
    // 0b11110000 -> hi=(240<<4)&0xFF=0, lo=240>>4=15 -> result=15
    cki("rotl(240,4,8)", rot_rotl(240, 4, 8), 15)
    // rotl(1, 8, 8): k%width = 0 -> full rotation = identity
    cki("rotl(1,8,8)", rot_rotl(1, 8, 8), 1)
    // rotl(0x1234, 4, 16): 0x1234 left by 4 within 16 bits
    // hi=(0x1234<<4)&0xFFFF=0x2340, lo=0x1234>>12=0x0001 -> 0x2341=9025
    cki("rotl(0x1234,4,16)", rot_rotl(0x1234, 4, 16), 0x2341)
    // rotl(0, 3, 8): rotating zero always gives zero
    cki("rotl(0,3,8)", rot_rotl(0, 3, 8), 0)
    // rotl(0xFF, 1, 8): 0xFF left by 1 -> hi=0xFE, lo=1 -> 0xFF = 255 (all bits stay set)
    cki("rotl(0xFF,1,8)", rot_rotl(0xFF, 1, 8), 255)

    // --- rot_rotr ---
    // rotr(1, 1, 8): bit0 rotates right to bit7 -> 0b10000000 = 128
    cki("rotr(1,1,8)", rot_rotr(1, 1, 8), 128)
    // rotr(18, 4, 8): 18=0b00010010, rotr by 4
    // lo=18>>4=1, hi=(18<<4)&0xFF=32 -> result=33
    cki("rotr(18,4,8)", rot_rotr(18, 4, 8), 33)
    // rotr(128, 1, 8): 0b10000000 right by 1 -> 0b01000000 = 64
    cki("rotr(128,1,8)", rot_rotr(128, 1, 8), 64)
    // rotr(0, 5, 8): rotating zero always gives zero
    cki("rotr(0,5,8)", rot_rotr(0, 5, 8), 0)

    // --- ROUND-TRIP: rotr(rotl(x, k, w), k, w) == x ---
    // 0xAB = 171, k=3, width=8
    let v1 = rot_rotl(0xAB, 3, 8)
    let v2 = rot_rotr(v1, 3, 8)
    cki("round_trip(0xAB,3,8)", v2, 0xAB)
    // Additional round-trips at 16-bit width
    let v3 = rot_rotl(0x1234, 7, 16)
    let v4 = rot_rotr(v3, 7, 16)
    cki("round_trip(0x1234,7,16)", v4, 0x1234)
    // 32-bit round-trip
    let v5 = rot_rotl(0xDEAD, 13, 32)
    let v6 = rot_rotr(v5, 13, 32)
    cki("round_trip(0xDEAD,13,32)", v6, 0xDEAD)

    print("PASS _bitrotate_test")
