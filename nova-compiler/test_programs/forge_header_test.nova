// forge_header_test -- header_get matches header names CASE-INSENSITIVELY (HTTP names are case-insensitive),
// anchored to a header-line boundary (a suffix like "Key" must not match "X-Api-Key"), preserves the value's
// case, and returns "" when absent. Pure string parsing.
import forge

fn main()
    let req = "GET / HTTP/1.1\r\nHost: example.com\r\nX-Api-Key: Secret123\r\nContent-Type: text/html\r\n\r\nbody"

    // exact and differently-cased lookups all find the header
    if forge.header_get(req, "Host") != "example.com"
        print("FAIL: exact Host")
        exit(1)
    if forge.header_get(req, "host") != "example.com"
        print("FAIL: lowercase host lookup")
        exit(1)
    if forge.header_get(req, "CONTENT-TYPE") != "text/html"
        print("FAIL: uppercase Content-Type lookup")
        exit(1)

    // client sends a lowercase header; a Title-Case lookup must still find it (the bypass case)
    let req2 = "GET / HTTP/1.1\r\nx-api-key: tok\r\n\r\n"
    if forge.header_get(req2, "X-Api-Key") != "tok"
        print("FAIL: client lowercase header missed by Title-Case lookup")
        exit(1)

    // the value's own case is preserved (only the NAME match is case-insensitive)
    if forge.header_get(req, "x-api-key") != "Secret123"
        print("FAIL: value case not preserved -> " + forge.header_get(req, "x-api-key"))
        exit(1)

    // anchored: asking for a name SUFFIX must not match a longer header
    if forge.header_get(req, "Key") != ""
        print("FAIL: suffix 'Key' wrongly matched 'X-Api-Key'")
        exit(1)
    // absent header
    if forge.header_get(req, "Authorization") != ""
        print("FAIL: absent header should be empty")
        exit(1)

    print("PASS forge_header (header_get case-insensitive name, value-case preserved, anchored, absent)")
