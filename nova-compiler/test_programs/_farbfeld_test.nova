// KAT test for std/media/farbfeld
// Covers:
//   (a) Exact magic bytes "farbfeld" at offset 0..7
//   (b) u32 BE width/height at offsets 8 and 12
//   (c) Byte-exact encode of 1x1 pixel [0x1234,0x5678,0x9ABC,0xDEF0]
//   (d) Total length check (16 header + 8 bytes/pixel)
//   (e) Full encode->decode round-trip equality check (1x1 and 2x2)
//   (f) Malformed input decode returns empty/zero
//   (g) 16-bit channel boundary: 0x0000 and 0xFFFF preserved exactly
import std/media/farbfeld

// ── Helper: check int equality ────────────────────────────────────────────────
fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── KAT 1: 1x1 encode — total length = 16 + 1*8 = 24 bytes ─────────────
    let px1 = [0x1234, 0x5678, 0x9ABC, 0xDEF0]
    let enc1 = ff_encode(1, 1, px1)
    cki("encode_1x1_len", bytes_len(enc1), 24)

    // ── KAT 2: magic bytes[0..7] = "farbfeld" ───────────────────────────────
    // 'f'=102 'a'=97 'r'=114 'b'=98 'f'=102 'e'=101 'l'=108 'd'=100
    cki("magic_0", bytes_get(enc1, 0), 102)
    cki("magic_1", bytes_get(enc1, 1), 97)
    cki("magic_2", bytes_get(enc1, 2), 114)
    cki("magic_3", bytes_get(enc1, 3), 98)
    cki("magic_4", bytes_get(enc1, 4), 102)
    cki("magic_5", bytes_get(enc1, 5), 101)
    cki("magic_6", bytes_get(enc1, 6), 108)
    cki("magic_7", bytes_get(enc1, 7), 100)

    // ── KAT 3: width u32 BE @ offset 8 = 1 ─────────────────────────────────
    let w_val = ((bytes_get(enc1, 8) << 24) | (bytes_get(enc1, 9) << 16) | (bytes_get(enc1, 10) << 8) | bytes_get(enc1, 11)) & 0xFFFFFFFF
    cki("width_u32be", w_val, 1)

    // ── KAT 4: height u32 BE @ offset 12 = 1 ───────────────────────────────
    let h_val = ((bytes_get(enc1, 12) << 24) | (bytes_get(enc1, 13) << 16) | (bytes_get(enc1, 14) << 8) | bytes_get(enc1, 15)) & 0xFFFFFFFF
    cki("height_u32be", h_val, 1)

    // ── KAT 5: pixel bytes[16..23] for RGBA=[0x1234,0x5678,0x9ABC,0xDEF0] ──
    // R=0x1234 -> 0x12,0x34
    cki("px_R_hi", bytes_get(enc1, 16), 0x12)
    cki("px_R_lo", bytes_get(enc1, 17), 0x34)
    // G=0x5678 -> 0x56,0x78
    cki("px_G_hi", bytes_get(enc1, 18), 0x56)
    cki("px_G_lo", bytes_get(enc1, 19), 0x78)
    // B=0x9ABC -> 0x9A,0xBC
    cki("px_B_hi", bytes_get(enc1, 20), 0x9A)
    cki("px_B_lo", bytes_get(enc1, 21), 0xBC)
    // A=0xDEF0 -> 0xDE,0xF0
    cki("px_A_hi", bytes_get(enc1, 22), 0xDE)
    cki("px_A_lo", bytes_get(enc1, 23), 0xF0)

    // ── KAT 6: round-trip 1x1 ───────────────────────────────────────────────
    let dec1 = ff_decode(enc1)
    cki("rt1_w", dec1["w"], 1)
    cki("rt1_h", dec1["h"], 1)
    let rt1_px = dec1["px"]
    cki("rt1_px_len", len(rt1_px), 4)
    cki("rt1_R", rt1_px[0], 0x1234)
    cki("rt1_G", rt1_px[1], 0x5678)
    cki("rt1_B", rt1_px[2], 0x9ABC)
    cki("rt1_A", rt1_px[3], 0xDEF0)

    // ── KAT 7: 2x2 encode — total length = 16 + 4*8 = 48 bytes ─────────────
    // 4 pixels: (0xFFFF,0,0,0xFFFF), (0,0xFFFF,0,0xFFFF), (0,0,0xFFFF,0xFFFF), (0x8000,0x8000,0x8000,0xFFFF)
    let px2 = [0xFFFF, 0, 0, 0xFFFF, 0, 0xFFFF, 0, 0xFFFF, 0, 0, 0xFFFF, 0xFFFF, 0x8000, 0x8000, 0x8000, 0xFFFF]
    let enc2 = ff_encode(2, 2, px2)
    cki("encode_2x2_len", bytes_len(enc2), 48)

    // Magic still valid
    cki("2x2_magic_0", bytes_get(enc2, 0), 102)
    cki("2x2_magic_7", bytes_get(enc2, 7), 100)

    // Width=2, Height=2 as u32 BE
    let w2 = ((bytes_get(enc2, 8) << 24) | (bytes_get(enc2, 9) << 16) | (bytes_get(enc2, 10) << 8) | bytes_get(enc2, 11)) & 0xFFFFFFFF
    let h2 = ((bytes_get(enc2, 12) << 24) | (bytes_get(enc2, 13) << 16) | (bytes_get(enc2, 14) << 8) | bytes_get(enc2, 15)) & 0xFFFFFFFF
    cki("2x2_w", w2, 2)
    cki("2x2_h", h2, 2)

    // Pixel 0: R=0xFFFF -> bytes 16,17 = 0xFF,0xFF
    cki("2x2_p0_R_hi", bytes_get(enc2, 16), 0xFF)
    cki("2x2_p0_R_lo", bytes_get(enc2, 17), 0xFF)
    // G=0 -> bytes 18,19 = 0,0
    cki("2x2_p0_G_hi", bytes_get(enc2, 18), 0)
    cki("2x2_p0_G_lo", bytes_get(enc2, 19), 0)

    // ── KAT 8: round-trip 2x2 ───────────────────────────────────────────────
    let dec2 = ff_decode(enc2)
    cki("rt2_w", dec2["w"], 2)
    cki("rt2_h", dec2["h"], 2)
    let rt2_px = dec2["px"]
    cki("rt2_px_len", len(rt2_px), 16)
    cki("rt2_p0_R", rt2_px[0], 0xFFFF)
    cki("rt2_p0_G", rt2_px[1], 0)
    cki("rt2_p0_B", rt2_px[2], 0)
    cki("rt2_p0_A", rt2_px[3], 0xFFFF)
    cki("rt2_p1_R", rt2_px[4], 0)
    cki("rt2_p1_G", rt2_px[5], 0xFFFF)
    cki("rt2_p1_B", rt2_px[6], 0)
    cki("rt2_p1_A", rt2_px[7], 0xFFFF)
    cki("rt2_p2_R", rt2_px[8], 0)
    cki("rt2_p2_G", rt2_px[9], 0)
    cki("rt2_p2_B", rt2_px[10], 0xFFFF)
    cki("rt2_p2_A", rt2_px[11], 0xFFFF)
    cki("rt2_p3_R", rt2_px[12], 0x8000)
    cki("rt2_p3_G", rt2_px[13], 0x8000)
    cki("rt2_p3_B", rt2_px[14], 0x8000)
    cki("rt2_p3_A", rt2_px[15], 0xFFFF)

    // ── KAT 9: 16-bit channel boundaries: 0x0000 and 0xFFFF preserved ───────
    let px_bounds = [0, 0xFFFF, 0x0001, 0xFFFE]
    let enc_bounds = ff_encode(1, 1, px_bounds)
    // R=0x0000 -> 0x00,0x00
    cki("bounds_R_hi", bytes_get(enc_bounds, 16), 0)
    cki("bounds_R_lo", bytes_get(enc_bounds, 17), 0)
    // G=0xFFFF -> 0xFF,0xFF
    cki("bounds_G_hi", bytes_get(enc_bounds, 18), 0xFF)
    cki("bounds_G_lo", bytes_get(enc_bounds, 19), 0xFF)
    // B=0x0001 -> 0x00,0x01
    cki("bounds_B_hi", bytes_get(enc_bounds, 20), 0)
    cki("bounds_B_lo", bytes_get(enc_bounds, 21), 1)
    // A=0xFFFE -> 0xFF,0xFE
    cki("bounds_A_hi", bytes_get(enc_bounds, 22), 0xFF)
    cki("bounds_A_lo", bytes_get(enc_bounds, 23), 0xFE)

    // Round-trip boundaries
    let dec_bounds = ff_decode(enc_bounds)
    let rt_bounds_px = dec_bounds["px"]
    cki("rt_bounds_R", rt_bounds_px[0], 0)
    cki("rt_bounds_G", rt_bounds_px[1], 0xFFFF)
    cki("rt_bounds_B", rt_bounds_px[2], 1)
    cki("rt_bounds_A", rt_bounds_px[3], 0xFFFE)

    // ── KAT 10: malformed decode — too short ─────────────────────────────────
    let bad1 = bytes(5)
    let dec_bad1 = ff_decode(bad1)
    cki("bad_short_w", dec_bad1["w"], 0)
    cki("bad_short_h", dec_bad1["h"], 0)

    // ── KAT 11: malformed decode — wrong magic ───────────────────────────────
    // Build 16 bytes with "FARBFELD" (uppercase — wrong magic)
    let bad2 = bytes(0)
    bad2 = bytes_append(bad2, 70)
    bad2 = bytes_append(bad2, 65)
    bad2 = bytes_append(bad2, 82)
    bad2 = bytes_append(bad2, 66)
    bad2 = bytes_append(bad2, 70)
    bad2 = bytes_append(bad2, 69)
    bad2 = bytes_append(bad2, 76)
    bad2 = bytes_append(bad2, 68)
    bad2 = bytes_append(bad2, 0)
    bad2 = bytes_append(bad2, 0)
    bad2 = bytes_append(bad2, 0)
    bad2 = bytes_append(bad2, 1)
    bad2 = bytes_append(bad2, 0)
    bad2 = bytes_append(bad2, 0)
    bad2 = bytes_append(bad2, 0)
    bad2 = bytes_append(bad2, 1)
    let dec_bad2 = ff_decode(bad2)
    cki("bad_magic_w", dec_bad2["w"], 0)

    // ── KAT 12: malformed decode — truncated pixel data ──────────────────────
    // Valid header for 2x2 but only 24 bytes total (need 48 = 16 + 32)
    let bad3 = bytes(0)
    bad3 = bytes_append(bad3, 102)
    bad3 = bytes_append(bad3, 97)
    bad3 = bytes_append(bad3, 114)
    bad3 = bytes_append(bad3, 98)
    bad3 = bytes_append(bad3, 102)
    bad3 = bytes_append(bad3, 101)
    bad3 = bytes_append(bad3, 108)
    bad3 = bytes_append(bad3, 100)
    bad3 = bytes_append(bad3, 0)
    bad3 = bytes_append(bad3, 0)
    bad3 = bytes_append(bad3, 0)
    bad3 = bytes_append(bad3, 2)
    bad3 = bytes_append(bad3, 0)
    bad3 = bytes_append(bad3, 0)
    bad3 = bytes_append(bad3, 0)
    bad3 = bytes_append(bad3, 2)
    let dec_bad3 = ff_decode(bad3)
    cki("bad_trunc_w", dec_bad3["w"], 0)

    print("PASS _farbfeld_test")
