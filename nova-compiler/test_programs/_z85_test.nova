// KAT for std/encoding/z85 — ZeroMQ Z85 / RFC 32 (binary-safe; input multiple of 4 bytes).
import std/encoding/z85

fn _push(b: any, v: int) -> any
    return bytes_append(b, v)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": '" + got + "' != '" + want + "'")
        exit(1)

fn main()
    // RFC 32 reference: 0x864FD26F 0xB559F75B -> "HelloWorld"
    let v = bytes(0)
    v = _push(v, 134)
    v = _push(v, 79)
    v = _push(v, 210)
    v = _push(v, 111)
    v = _push(v, 181)
    v = _push(v, 89)
    v = _push(v, 247)
    v = _push(v, 91)
    cks("hello", z85_encode(v), "HelloWorld")
    let d = z85_decode("HelloWorld")
    if bytes_len(d) != 8
        print("FAIL decode len " + str(bytes_len(d)))
        exit(1)
    if bytes_get(d, 0) != 134 or bytes_get(d, 7) != 91 or bytes_get(d, 3) != 111
        print("FAIL decode content")
        exit(1)
    // zeros + max (big-endian order)
    let z = bytes(0)
    z = _push(z, 0)
    z = _push(z, 0)
    z = _push(z, 0)
    z = _push(z, 0)
    cks("zeros", z85_encode(z), "00000")
    let mx = bytes(0)
    mx = _push(mx, 255)
    mx = _push(mx, 255)
    mx = _push(mx, 255)
    mx = _push(mx, 255)
    cks("max", z85_encode(mx), "%nSc0")
    print("_z85_test passed")
