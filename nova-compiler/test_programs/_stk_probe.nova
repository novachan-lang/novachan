type Point
    x: float
    y: float

fn dot(a, b)
    a.x * b.x + a.y * b.y

type Box
    data: list

fn make_pt() -> Point
    let z = Point(5.0, 6.0)
    z

fn main()
    let p = Point(1.0, 2.0)
    let q = Point(3.0, 4.0)
    print(str(dot(p, q)))
    let bx = Box([1, 2])
    print(str(len(bx.data)))
    let kept = make_pt()
    print(str(kept.x))
