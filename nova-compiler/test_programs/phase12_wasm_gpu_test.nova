// Phase 12: WASM + GPU API test
// Tests the WASM module loader and GPU buffer/kernel stub APIs

fn test_wasm_api()
    // Missing file should return -1 (graceful fail, no crash)
    let h = wasm_compile("nonexistent_totally_missing.wasm")
    assert_eq(h, -1)
    // A file that exists but is NOT valid WASM loads (bytes read) but fails to run.
    let h2 = wasm_compile("phase12_wasm_gpu_test.nova")
    assert_eq(h2 >= 0, true)
    // The real interpreter rejects non-WASM bytes (bad magic) with -1.
    let r = wasm_run(h2)
    assert_eq(r, -1)
    // wasm_free should succeed silently
    let freed = wasm_free(h2)
    assert_eq(freed, 0)
    print("WASM API test passed (real interpreter: non-WASM rejected)")

fn test_gpu_alloc()
    // Allocate a 256-byte GPU buffer
    let buf = gpu_alloc(256)
    assert_eq(buf >= 0, true)
    // Write a value and read it back
    let w = gpu_write(buf, 0, 42)
    assert_eq(w, 0)
    let v = gpu_read(buf, 0)
    assert_eq(v, 42)
    // Write at offset 8
    let w2 = gpu_write(buf, 8, 999)
    assert_eq(w2, 0)
    let v2 = gpu_read(buf, 8)
    assert_eq(v2, 999)
    // Free the buffer
    let freed = gpu_free(buf)
    assert_eq(freed, 0)
    print("GPU alloc/write/read test passed")

fn test_gpu_kernel()
    let buf = gpu_alloc(512)
    assert_eq(buf >= 0, true)
    gpu_write(buf, 0, 5)
    gpu_write(buf, 8, 10)
    // Real elementwise kernel: add1 over 2 elements -> [6, 11]
    let ret = gpu_kernel_run("add1", buf, 2, 1)
    assert_eq(ret, 0)
    let s = gpu_sync()
    assert_eq(s, 0)
    assert_eq(gpu_read(buf, 0), 6)
    assert_eq(gpu_read(buf, 8), 11)
    gpu_free(buf)
    print("GPU kernel dispatch test passed")

fn test_gpu_invalid()
    // Handle -1 should fail gracefully
    let v = gpu_read(-1, 0)
    assert_eq(v, 0)
    let w = gpu_write(-1, 0, 1)
    assert_eq(w, -1)
    let k = gpu_kernel_run("x", -1, 1, 1)
    assert_eq(k, -1)
    print("GPU invalid-handle test passed")

fn main()
    test_wasm_api()
    test_gpu_alloc()
    test_gpu_kernel()
    test_gpu_invalid()
    print("All Phase 12 WASM+GPU tests passed!")
