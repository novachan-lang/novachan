import std/rational/rfrac_convert

// ckr — check rational equality element-wise
fn ckr(label, got, wn, wd)
    if got[0] != wn or got[1] != wd
        print("FAIL rfrac_convert " + label + ": got=" + str(got[0]) + "/" + str(got[1]) + " want=" + str(wn) + "/" + str(wd))
        exit(1)

// cki — check integer equality
fn cki(label, got, want)
    if got != want
        print("FAIL rfrac_convert " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckf — check float equality within tolerance 1e-7
fn ckf(label, got, want)
    let diff = got - want
    if diff < 0.0
        diff = 0.0 - diff
    if diff > 0.0000001
        print("FAIL rfrac_convert " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// helper: build rational [n, d]
fn rat(n, d)
    let r = []
    r.push(n)
    r.push(d)
    r

// --- rfv_to_float ---
let f1 = rfv_to_float(rat(1, 2))
ckf("to_float_half", f1, 0.5)

let f2 = rfv_to_float(rat(3, 4))
ckf("to_float_3_4", f2, 0.75)

// --- rfv_from_float ---
let r1 = rfv_from_float(0.5, 1000)
ckr("from_float_0.5", r1, 1, 2)

let r2 = rfv_from_float(0.75, 1000)
ckr("from_float_0.75", r2, 3, 4)

let r3 = rfv_from_float(0.125, 1000)
ckr("from_float_0.125", r3, 1, 8)

let r4 = rfv_from_float(2.5, 1000)
ckr("from_float_2.5", r4, 5, 2)

// --- rfv_floor ---
// floor(7/2) = 3
cki("floor_7_2", rfv_floor(rat(7, 2)), 3)
// floor(-7/2) = -4
cki("floor_neg7_2", rfv_floor(rat(0 - 7, 2)), 0 - 4)
// floor(4/2) = 2 (exact)
cki("floor_4_2", rfv_floor(rat(4, 2)), 2)
// floor(1/3) = 0
cki("floor_1_3", rfv_floor(rat(1, 3)), 0)

// --- rfv_ceil ---
// ceil(7/2) = 4
cki("ceil_7_2", rfv_ceil(rat(7, 2)), 4)
// ceil(4/2) = 2 (exact)
cki("ceil_exact", rfv_ceil(rat(4, 2)), 2)
// ceil(1/3) = 1
cki("ceil_1_3", rfv_ceil(rat(1, 3)), 1)
// ceil(-7/2) = -3
cki("ceil_neg7_2", rfv_ceil(rat(0 - 7, 2)), 0 - 3)

// --- rfv_round (half away from zero) ---
// round(7/2) = 4
cki("round_7_2", rfv_round(rat(7, 2)), 4)
// round(5/2) = 3
cki("round_5_2", rfv_round(rat(5, 2)), 3)
// round(1/3) = 0
cki("round_1_3", rfv_round(rat(1, 3)), 0)
// round(2/3) = 1
cki("round_2_3", rfv_round(rat(2, 3)), 1)

// --- rfv_trunc ---
// trunc(-7/2) = -3
cki("trunc_neg7_2", rfv_trunc(rat(0 - 7, 2)), 0 - 3)
// trunc(7/2) = 3
cki("trunc_7_2", rfv_trunc(rat(7, 2)), 3)
// trunc(4/2) = 2
cki("trunc_4_2", rfv_trunc(rat(4, 2)), 2)

// --- rfv_fractional_part ---
// frac(7/2) = 1/2
ckr("frac_part_7_2", rfv_fractional_part(rat(7, 2)), 1, 2)
// frac(-7/2) = 1/2  (floor(-3.5)=-4; -7/2 - (-4) = 1/2)
ckr("frac_part_neg7_2", rfv_fractional_part(rat(0 - 7, 2)), 1, 2)
// frac(4/2) = 0
ckr("frac_part_exact", rfv_fractional_part(rat(4, 2)), 0, 1)
// frac(1/3) = 1/3
ckr("frac_part_1_3", rfv_fractional_part(rat(1, 3)), 1, 3)

print("PASS _rfrac_convert_test")
