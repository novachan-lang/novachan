// showcase_vm -- a small stack + register bytecode VM in pure NOVA, with control flow (conditional
// and unconditional jumps -> real loops). An INTERPRETER: program as parallel (op, arg) lists, an
// operand stack, 4 registers, and a program counter. Runs two loop programs (iterative factorial and
// a counting sum) and verifies the results. Demonstrates NOVA can host a language.

fn emit(prog: list, args: list, op: string, a: int)
    push(prog, op)
    push(args, a)

fn run_vm(prog: list, args: list) -> int
    let stack = []
    let regs = [0, 0, 0, 0]
    let pc = 0
    let result = 0
    let steps = 0
    while pc < len(prog) and steps < 100000
        steps = steps + 1
        let op = prog[pc]
        let arg = args[pc]
        let jumped = 0
        if op == "PUSH"
            push(stack, arg)
        else if op == "LOAD"
            push(stack, regs[arg])
        else if op == "STORE"
            regs[arg] = pop(stack)
        else if op == "ADD"
            let b = pop(stack)
            let a = pop(stack)
            push(stack, a + b)
        else if op == "SUB"
            let b = pop(stack)
            let a = pop(stack)
            push(stack, a - b)
        else if op == "MUL"
            let b = pop(stack)
            let a = pop(stack)
            push(stack, a * b)
        else if op == "JZ"
            let x = pop(stack)
            if x == 0
                pc = arg
                jumped = 1
        else if op == "JMP"
            pc = arg
            jumped = 1
        else if op == "RET"
            result = pop(stack)
        if jumped == 0
            pc = pc + 1
    return result

fn main()
    // Iterative factorial 5! = 120, hand-assembled with a back-jump loop. regs: r0=acc, r1=n
    let p = []
    let a = []
    emit(p, a, "PUSH", 1)      // 0
    emit(p, a, "STORE", 0)     // 1  acc=1
    emit(p, a, "PUSH", 5)      // 2
    emit(p, a, "STORE", 1)     // 3  n=5
    emit(p, a, "LOAD", 1)      // 4  LOOP: push n
    emit(p, a, "JZ", 15)       // 5  if n==0 goto 15 (RET)
    emit(p, a, "LOAD", 0)      // 6  push acc
    emit(p, a, "LOAD", 1)      // 7  push n
    emit(p, a, "MUL", 0)       // 8  acc*n
    emit(p, a, "STORE", 0)     // 9  acc = acc*n
    emit(p, a, "LOAD", 1)      // 10 push n
    emit(p, a, "PUSH", 1)      // 11
    emit(p, a, "SUB", 0)       // 12 n-1
    emit(p, a, "STORE", 1)     // 13 n = n-1
    emit(p, a, "JMP", 4)       // 14 back to LOOP
    emit(p, a, "LOAD", 0)      // 15 push acc
    emit(p, a, "RET", 0)       // 16 result = acc
    let fact5 = run_vm(p, a)
    print("VM factorial(5) = " + str(fact5) + " (want 120)")
    assert(fact5 == 120, "VM computes 5! = 120 via a loop")

    // Sum 1..10 = 55, another loop program. regs: r0=sum, r1=i
    let q = []
    let b = []
    emit(q, b, "PUSH", 0)      // 0
    emit(q, b, "STORE", 0)     // 1  sum=0
    emit(q, b, "PUSH", 10)     // 2
    emit(q, b, "STORE", 1)     // 3  i=10
    emit(q, b, "LOAD", 1)      // 4  LOOP: push i
    emit(q, b, "JZ", 15)       // 5  if i==0 goto 15 (RET)
    emit(q, b, "LOAD", 0)      // 6  push sum
    emit(q, b, "LOAD", 1)      // 7  push i
    emit(q, b, "ADD", 0)       // 8  sum+i
    emit(q, b, "STORE", 0)     // 9  sum = sum+i
    emit(q, b, "LOAD", 1)      // 10 push i
    emit(q, b, "PUSH", 1)      // 11
    emit(q, b, "SUB", 0)       // 12 i-1
    emit(q, b, "STORE", 1)     // 13 i = i-1
    emit(q, b, "JMP", 4)       // 14 back to LOOP
    emit(q, b, "LOAD", 0)      // 15 push sum
    emit(q, b, "RET", 0)       // 16
    let sum10 = run_vm(q, b)
    print("VM sum(1..10) = " + str(sum10) + " (want 55)")
    assert(sum10 == 55, "VM computes sum 1..10 = 55 via a loop")

    print("showcase_vm_test passed -- stack+register bytecode VM with jumps/loops, pure NOVA")
