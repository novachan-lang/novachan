// KAT for std/framing/ppp_frame — PPP async HDLC framing (RFC 1662).
import std/framing/ppp_frame

// ── Private list equality helper ──────────────────────────────────────────────

fn list_eq(a: list, b: list) -> int
    if len(a) != len(b)
        return 0
    let i = 0
    let ok = 1
    while i < len(a) and ok == 1
        if a[i] != b[i]
            ok = 0
        i = i + 1
    ok

// ── Assert helpers ─────────────────────────────────────────────────────────────

fn ck_list(label: string, got: list, want: list)
    let eq = list_eq(got, want)
    if eq != 1
        let gs = "["
        let i = 0
        while i < len(got)
            if i > 0
                gs = gs + ","
            gs = gs + str(got[i])
            i = i + 1
        gs = gs + "]"
        let wi = "["
        let j = 0
        while j < len(want)
            if j > 0
                wi = wi + ","
            wi = wi + str(want[j])
            j = j + 1
        wi = wi + "]"
        print("FAIL ppp_frame " + label + ": got=" + gs + " want=" + wi)
        exit(1)

fn ck_int(label: string, got: int, want: int)
    if got != want
        print("FAIL ppp_frame " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ── KAT 1: ppp_stuff([0x7E]) == [0x7D, 0x5E] ─────────────────────────────────

fn main()
    let d1 = []
    push(d1, 0x7E)
    let r1 = ppp_stuff(d1)
    let w1 = []
    push(w1, 0x7D)
    push(w1, 0x5E)
    ck_list("stuff-flag-byte", r1, w1)

    // ── KAT 2: ppp_stuff([0x7D]) == [0x7D, 0x5D] ────────────────────────────
    let d2 = []
    push(d2, 0x7D)
    let r2 = ppp_stuff(d2)
    let w2 = []
    push(w2, 0x7D)
    push(w2, 0x5D)
    ck_list("stuff-esc-byte", r2, w2)

    // ── KAT 3: ppp_fcs16_update is deterministic (spot check) ────────────────
    // FCS16 update(0xFFFF, 0x00): deterministic, just ensure it changes.
    let fcs0 = ppp_fcs16_update(0xFFFF, 0)
    let fcs0b = ppp_fcs16_update(0xFFFF, 0)
    ck_int("fcs-update-deterministic", fcs0, fcs0b)

    // ── KAT 4: ppp_fcs16 on a known short vector ─────────────────────────────
    // ppp_fcs16([0xFF, 0x03]) is deterministic and stable; just verify stability.
    let fa = []
    push(fa, 0xFF)
    push(fa, 0x03)
    let fcs_a = ppp_fcs16(fa)
    let fcs_a2 = ppp_fcs16(fa)
    ck_int("fcs16-stable", fcs_a, fcs_a2)

    // ── ROUND-TRIP tests ──────────────────────────────────────────────────────

    // RT 1: [1,2,3] — plain bytes
    let rt1_in = []
    push(rt1_in, 1)
    push(rt1_in, 2)
    push(rt1_in, 3)
    let rt1_frame = ppp_frame(rt1_in)
    let rt1_dec = ppp_deframe(rt1_frame)
    let rt1_data = rt1_dec["data"]
    let rt1_ok = rt1_dec["fcs_ok"]
    ck_list("rt-plain-data", rt1_data, rt1_in)
    ck_int("rt-plain-fcs_ok", rt1_ok, 1)

    // RT 2: [0x7E, 0x7D] — bytes that need stuffing
    let rt2_in = []
    push(rt2_in, 0x7E)
    push(rt2_in, 0x7D)
    let rt2_frame = ppp_frame(rt2_in)
    let rt2_dec = ppp_deframe(rt2_frame)
    let rt2_data = rt2_dec["data"]
    let rt2_ok = rt2_dec["fcs_ok"]
    ck_list("rt-special-data", rt2_data, rt2_in)
    ck_int("rt-special-fcs_ok", rt2_ok, 1)

    // RT 3: empty payload
    let rt3_in = []
    let rt3_frame = ppp_frame(rt3_in)
    let rt3_dec = ppp_deframe(rt3_frame)
    let rt3_data = rt3_dec["data"]
    let rt3_ok = rt3_dec["fcs_ok"]
    ck_list("rt-empty-data", rt3_data, rt3_in)
    ck_int("rt-empty-fcs_ok", rt3_ok, 1)

    // RT 4: all 0x7E bytes
    let rt4_in = []
    push(rt4_in, 0x7E)
    push(rt4_in, 0x7E)
    push(rt4_in, 0x7E)
    let rt4_frame = ppp_frame(rt4_in)
    let rt4_dec = ppp_deframe(rt4_frame)
    let rt4_data = rt4_dec["data"]
    let rt4_ok = rt4_dec["fcs_ok"]
    ck_list("rt-all-flag-data", rt4_data, rt4_in)
    ck_int("rt-all-flag-fcs_ok", rt4_ok, 1)

    // RT 5: null byte
    let rt5_in = []
    push(rt5_in, 0x00)
    let rt5_frame = ppp_frame(rt5_in)
    let rt5_dec = ppp_deframe(rt5_frame)
    let rt5_data = rt5_dec["data"]
    let rt5_ok = rt5_dec["fcs_ok"]
    ck_list("rt-null-data", rt5_data, rt5_in)
    ck_int("rt-null-fcs_ok", rt5_ok, 1)

    // ── Tamper test: flipping a byte makes fcs_ok == 0 ───────────────────────
    // Frame [1,2,3], then flip byte at index 1 (inside the stuffed payload).
    let tamper_in = []
    push(tamper_in, 1)
    push(tamper_in, 2)
    push(tamper_in, 3)
    let tamper_frame = ppp_frame(tamper_in)
    // Flip a data byte inside the frame (index 1 is after the leading FLAG).
    // Build a tampered copy.
    let tf = []
    let ti = 0
    while ti < len(tamper_frame)
        push(tf, tamper_frame[ti])
        ti = ti + 1
    // tamper the second byte (index 1, which is inside the stuffed data)
    tf[1] = tf[1] ^ 0xFF
    let tamper_dec = ppp_deframe(tf)
    let tamper_ok = tamper_dec["fcs_ok"]
    ck_int("tamper-fcs-fail", tamper_ok, 0)

    // ── ppp_unstuff round-trip ────────────────────────────────────────────────
    let us_in = []
    push(us_in, 0x7E)
    push(us_in, 0x7D)
    push(us_in, 5)
    let us_stuffed = ppp_stuff(us_in)
    let us_out = ppp_unstuff(us_stuffed)
    ck_list("unstuff-rt", us_out, us_in)

    print("PASS _ppp_frame_test")
