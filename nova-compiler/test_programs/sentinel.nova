// NOVA SENTINEL — security helpers (framework 7 per strategy doc).
// v0.1 ships the foundational APIs that every security-sensitive
// app needs, built on the existing runtime crypto.
//
// Public API (v0.1):
//   sentinel.hash(data)                -> SHA-256 hex of data
//   sentinel.hash_password(password)   -> SHA-256 hex (placeholder for
//                                         Argon2id in v0.2)
//   sentinel.verify_password(pw, hash) -> bool (constant-time-ish compare;
//                                         real constant-time in v0.2)
//   sentinel.audit_chain_add(prev_hash, event_json)
//                                      -> [hash, event_json] — each entry
//                                         binds to the previous so any
//                                         tampering breaks the chain
//   sentinel.audit_chain_verify(chain) -> true iff the chain is intact

fn hash(data: string) -> string
    sha256(data)

fn hash_password(password: string) -> string
    sha256("nova_pw_v1:" + password)

fn verify_password(password: string, expected_hash: string) -> bool
    hash_password(password) == expected_hash

// Tamper-evident audit log: each entry's hash binds to the previous
// hash, so any modification (insert/delete/edit) breaks the chain.
fn audit_chain_add(prev_hash: string, event_json: string) -> list
    let combined = prev_hash + "|" + event_json
    let h = sha256(combined)
    [h, event_json]

fn audit_chain_verify(chain: list) -> bool
    let prev = ""
    let i = 0
    while i < len(chain)
        let entry = chain[i]
        let h = entry[0]
        let ev = entry[1]
        let expect = sha256(prev + "|" + ev)
        if h != expect
            return false
        prev = h
        i = i + 1
    true
