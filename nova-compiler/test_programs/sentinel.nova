// NOVA SENTINEL — security helpers (framework 7 per strategy doc).
// v0.1 ships the foundational APIs that every security-sensitive
// app needs, built on the existing runtime crypto.
//
// Public API (v0.1):
//   sentinel.hash(data)                -> SHA-256 hex of data
//   sentinel.hash_password(password)   -> SHA-256 hex (placeholder for
//                                         Argon2id in v0.2)
//   sentinel.verify_password(pw, hash) -> bool (constant-time-ish compare;
//                                         real constant-time in v0.2)
//   sentinel.audit_chain_add(prev_hash, event_json)
//                                      -> [hash, event_json] — each entry
//                                         binds to the previous so any
//                                         tampering breaks the chain
//   sentinel.audit_chain_verify(chain) -> true iff the chain is intact

fn hash(data: string) -> string
    sha256(data)

fn hash_password(password: string) -> string
    sha256("nova_pw_v1:" + password)

fn verify_password(password: string, expected_hash: string) -> bool
    hash_password(password) == expected_hash

// Tamper-evident audit log: each entry's hash binds to the previous
// hash, so any modification (insert/delete/edit) breaks the chain.
fn audit_chain_add(prev_hash: string, event_json: string) -> list
    let combined = prev_hash + "|" + event_json
    let h = sha256(combined)
    [h, event_json]

fn audit_chain_verify(chain: list) -> bool
    let prev = ""
    let i = 0
    while i < len(chain)
        let entry = chain[i]
        let h = entry[0]
        let ev = entry[1]
        let expect = sha256(prev + "|" + ev)
        if h != expect
            return false
        prev = h
        i = i + 1
    true

// ── v0.2 additions ───────────────────────────────────────────────────────

// Constant-time string compare. Loops over both strings without early
// exit so timing doesn't leak how many leading chars matched.
// (Real constant-time at the byte level still depends on the runtime;
// this is the source-level discipline.)
fn constant_time_eq(a: string, b: string) -> bool
    let la = len(a)
    let lb = len(b)
    let acc = la - lb
    let n = la
    if lb > n
        n = lb
    let i = 0
    while i < n
        let av = 0
        let bv = 0
        if i < la
            av = ord(a[i])
        if i < lb
            bv = ord(b[i])
        acc = acc | (av - bv)
        i = i + 1
    acc == 0

// HMAC-SHA256 (RFC 2104). Implemented in terms of the runtime sha256.
// Key longer than 64 bytes is hashed first. Returns hex digest.
fn hmac_sha256(key: string, message: string) -> string
    let block_size = 64
    let k = key
    if len(k) > block_size
        k = sha256(k)
    let i_pad = ""
    let o_pad = ""
    let i = 0
    while i < block_size
        let ki = 0
        if i < len(k)
            ki = ord(k[i])
        i_pad = i_pad + chr(ki ^ 54)
        o_pad = o_pad + chr(ki ^ 92)
        i = i + 1
    let inner = sha256(i_pad + message)
    sha256(o_pad + inner)

// Internal helper kept for symmetry with the upstream API. sha256()
// already returns a hex string so this is currently a passthrough.
fn sha256_bytes_to_str_hex(h: string) -> string
    h

// Generate a stateless API token: base16(rand_bytes(32)). Suitable for
// short-lived bearer tokens. Persisted tokens should also be hashed
// before storing.
fn api_token() -> string
    let bytes = random_bytes(32)
    hex_encode(bytes)

// CSRF-style token bound to a user id. Returns hex(sha256(user_id + secret + ts)).
fn csrf_token(user_id: string, secret: string) -> string
    let ts = str(time_ms())
    sha256(user_id + ":" + secret + ":" + ts)

