// KAT for std/geometry/triangle — triangle geometry with exact integer arithmetic.
// All expected values are hand-computed from the spec.
import std/geometry/triangle

// cki — check int equality; FAIL+exit(1) on mismatch.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// ckf — check float equality within eps=0.001; FAIL+exit(1) on mismatch.
fn ckf(label: string, got: float, want: float)
    let diff = got - want
    let adiff = 0.0
    if diff < 0.0
        adiff = 0.0 - diff
    else
        adiff = diff
    if adiff > 0.001
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// ckb — check bool equality; FAIL+exit(1) on mismatch.
fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got " + str(gi) + " want " + str(wi))
        exit(1)

fn main()
    // KAT 1: tr_area2([0,0],[4,0],[0,3]) == 12
    // cross = (4-0)*(3-0) - (0-0)*(0-0) = 12 - 0 = 12
    let a1 = [0, 0]
    let b1 = [4, 0]
    let c1 = [0, 3]
    let area2_1 = tr_area2(a1, b1, c1)
    cki("tr_area2 3-4-5-like", area2_1, 12)

    // KAT 2: tr_area([0,0],[4,0],[0,3]) == 6.0
    // area = 12 / 2 = 6.0
    let area_2 = tr_area(a1, b1, c1)
    ckf("tr_area 3-4-5-like", area_2, 6.0)

    // KAT 3: tr_is_right([0,0],[3,0],[3,4]) == true
    // AB² = 9, BC² = 16, CA² = 25 -> 25 = 9 + 16  ✓
    let a3 = [0, 0]
    let b3 = [3, 0]
    let c3 = [3, 4]
    let right3 = tr_is_right(a3, b3, c3)
    ckb("tr_is_right 3-4-5", right3, true)

    // KAT 4: tr_centroid([0,0],[3,0],[0,3]) == [1.0, 1.0]
    // cx = (0+3+0)/3 = 1.0,  cy = (0+0+3)/3 = 1.0
    let a4 = [0, 0]
    let b4 = [3, 0]
    let c4 = [0, 3]
    let cen4 = tr_centroid(a4, b4, c4)
    ckf("tr_centroid x", cen4[0], 1.0)
    ckf("tr_centroid y", cen4[1], 1.0)

    // KAT 5: tr_perimeter([0,0],[3,0],[3,4]) == 12.0
    // AB = 3, BC = 4, CA = 5  -> 3 + 4 + 5 = 12.0
    let a5 = [0, 0]
    let b5 = [3, 0]
    let c5 = [3, 4]
    let perim5 = tr_perimeter(a5, b5, c5)
    ckf("tr_perimeter 3-4-5", perim5, 12.0)

    // KAT 6: tr_is_degenerate([0,0],[1,1],[2,2]) == true
    // Collinear; area2 = (1-0)*(2-0) - (1-0)*(2-0) = 2 - 2 = 0
    let a6 = [0, 0]
    let b6 = [1, 1]
    let c6 = [2, 2]
    let degen6 = tr_is_degenerate(a6, b6, c6)
    ckb("tr_is_degenerate collinear", degen6, true)

    // KAT 7: tr_is_equilateral([0,0],[2,0],[1,2]) == false
    // AB² = 4, BC² = (1-2)²+(2-0)² = 1+4 = 5, CA² = 1+4 = 5  -> not all equal
    let a7 = [0, 0]
    let b7 = [2, 0]
    let c7 = [1, 2]
    let equil7 = tr_is_equilateral(a7, b7, c7)
    ckb("tr_is_equilateral false", equil7, false)

    // KAT 8: tr_is_degenerate([0,0],[1,0],[2,0]) == true (horizontal collinear)
    let a8 = [0, 0]
    let b8 = [1, 0]
    let c8 = [2, 0]
    let degen8 = tr_is_degenerate(a8, b8, c8)
    ckb("tr_is_degenerate horizontal", degen8, true)

    // KAT 9: tr_is_right([0,0],[1,0],[0,1]) == true  (unit right triangle)
    // AB² = 1, BC² = 2, CA² = 1  -> max=BC²=2, AB²+CA²=1+1=2 ✓
    let a9 = [0, 0]
    let b9 = [1, 0]
    let c9 = [0, 1]
    let right9 = tr_is_right(a9, b9, c9)
    ckb("tr_is_right unit", right9, true)

    // KAT 10: tr_is_right([0,0],[1,0],[2,0]) == false (degenerate / collinear)
    // AB²=1, BC²=1, CA²=4  -> 4 != 1+1=2
    let a10 = [0, 0]
    let b10 = [1, 0]
    let c10 = [2, 0]
    let right10 = tr_is_right(a10, b10, c10)
    ckb("tr_is_right degenerate", right10, false)

    // KAT 11: tr_area2 with negative orientation still gives positive result
    // [0,0],[0,3],[4,0]: cross = (0-0)*(0-0)-(3-0)*(4-0) = 0 - 12 = -12 -> abs = 12
    let a11 = [0, 0]
    let b11 = [0, 3]
    let c11 = [4, 0]
    let area2_11 = tr_area2(a11, b11, c11)
    cki("tr_area2 reversed orientation", area2_11, 12)

    // KAT 12: tr_is_equilateral with genuinely equilateral — squared sides all equal
    // [0,0],[2,0],[1,0] -> AB²=4, BC²=1+(0)=1, not equilateral
    // True equilateral example: [0,0],[4,0],[2,4] -> AB²=16, BC²=4+16=20, not exact int equilateral
    // Use: [0,0],[2,0],[1,0] is not equil; check [0,0],[4,0],[2,0] area2=0 degenerate skip.
    // Instead: 3-4-5 is NOT equilateral (check false case already done);
    // verify a non-right triangle is not right: [0,0],[4,0],[2,3]
    // AB²=16, BC²=4+9=13, CA²=4+9=13 -> max=16 != 13+13=26 -> false; also not equilateral
    let a12 = [0, 0]
    let b12 = [4, 0]
    let c12 = [2, 3]
    let right12 = tr_is_right(a12, b12, c12)
    ckb("tr_is_right isoceles non-right", right12, false)
    let equil12 = tr_is_equilateral(a12, b12, c12)
    ckb("tr_is_equilateral isoceles non-equil", equil12, false)

    print("_triangle_test passed")
