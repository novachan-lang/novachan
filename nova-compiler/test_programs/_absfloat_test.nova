// Pins the abs(float) type bug: abs of an any-typed float must return the correct float value,
// not a boxed-float pointer mistyped as int (the register-type pass used to force nova_rt_abs -> int).
// Also guards that int abs and any-typed int abs stay correct.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": " + str(got) + " != " + str(want))
        exit(1)

fn ckf(label: string, got: float, want: float)
    let d = got - want
    if d < 0.0
        d = 0.0 - d
    if d > 0.001
        print("FAIL " + label + ": " + str(got) + " != " + str(want))
        exit(1)

fn main()
    // int abs (regression: must stay integer-correct)
    cki("int_neg", abs(0 - 5), 5)
    cki("int_pos", abs(7), 7)

    // statically-float abs (already worked via the fabs route)
    let f = 0.0 - 2.5
    ckf("stat_float", abs(f), 2.5)

    // any-typed values (dict reads are 'any'): the fix types abs's result 'any' so a boxed-float
    // result is handled correctly (before the fix, abs(d["x"]) came back mistyped as int -> garbage).
    let d = {}
    d["x"] = 0.0 - 7.5
    ckf("any_float_neg", abs(d["x"]) * 1.0, 7.5)
    d["y"] = 3.25
    ckf("any_float_pos", abs(d["y"]) * 1.0, 3.25)

    // any-typed int abs must still be integer-correct
    d["n"] = 0 - 9
    cki("any_int", abs(d["n"]), 9)

    print("_absfloat_test passed")
