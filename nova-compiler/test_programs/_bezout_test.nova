import std/math/bezout

fn cki(label: str, got: int, want: int) -> int
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)
    0

fn main()
    // KAT 1+2: bz_egcd(30, 20) -> g=10, bezout identity holds
    let e1 = bz_egcd(30, 20)
    cki("egcd(30,20).g", e1[0], 10)
    let chk1 = 30 * e1[1] + 20 * e1[2]
    cki("egcd(30,20) bezout", chk1, 10)

    // KAT 3: bz_gcd(48, 36) == 12
    cki("gcd(48,36)", bz_gcd(48, 36), 12)

    // KAT 4+5: bz_egcd(35, 15) -> g=5, bezout identity holds
    let f = bz_egcd(35, 15)
    cki("egcd(35,15).g", f[0], 5)
    let chk2 = 35 * f[1] + 15 * f[2]
    cki("egcd(35,15) bezout", chk2, 5)

    // KAT 6: bz_mod_inverse(3, 11) == 4  (3*4=12 ≡ 1 mod 11)
    cki("mod_inverse(3,11)", bz_mod_inverse(3, 11), 4)

    // KAT 7: bz_mod_inverse(2, 4) == -1  (gcd(2,4)=2, no inverse)
    cki("mod_inverse(2,4)", bz_mod_inverse(2, 4), -1)

    // KAT 8: bz_lcm(4, 6) == 12
    cki("lcm(4,6)", bz_lcm(4, 6), 12)

    print("_bezout_test passed")
