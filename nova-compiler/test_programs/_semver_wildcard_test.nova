import std/semver/semver_wildcard

fn ckb(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got '" + got + "' want '" + want + "'")
        exit(1)

// --- svw_satisfies KAT vectors (from spec) ---
ckb("svw_satisfies_1", svw_satisfies("1.2.5", "1.2.x"), 1)
ckb("svw_satisfies_2", svw_satisfies("1.3.0", "1.2.x"), 0)
ckb("svw_satisfies_3", svw_satisfies("1.5.0", "1.x"), 1)
ckb("svw_satisfies_4", svw_satisfies("2.0.0", "1.x"), 0)
ckb("svw_satisfies_5", svw_satisfies("9.9.9", "*"), 1)
ckb("svw_satisfies_6", svw_satisfies("1.2.0", "1.2.*"), 1)

// --- additional boundary tests ---
// lower bound of 1.2.x: 1.2.0 should pass, nothing below
ckb("svw_satisfies_lo_eq", svw_satisfies("1.2.0", "1.2.x"), 1)
ckb("svw_satisfies_lo_below", svw_satisfies("1.1.9", "1.2.x"), 0)
// upper bound of 1.2.x: 1.2.999 passes, 1.3.0 fails
ckb("svw_satisfies_hi_at", svw_satisfies("1.2.999", "1.2.x"), 1)
ckb("svw_satisfies_hi_over", svw_satisfies("1.3.0", "1.2.x"), 0)
// 1.x: 1.0.0 passes, 2.0.0 fails
ckb("svw_satisfies_1x_lo", svw_satisfies("1.0.0", "1.x"), 1)
ckb("svw_satisfies_1x_hi", svw_satisfies("2.0.0", "1.x"), 0)
// X alone (uppercase)
ckb("svw_satisfies_X_alone", svw_satisfies("0.0.1", "X"), 1)
// 1.2.X uppercase
ckb("svw_satisfies_X_patch", svw_satisfies("1.2.7", "1.2.X"), 1)

// --- svw_lower ---
cks("svw_lower_patch", svw_lower("1.2.x"), "1.2.0")
cks("svw_lower_minor", svw_lower("1.x"), "1.0.0")
cks("svw_lower_star", svw_lower("*"), "")
cks("svw_lower_star_patch", svw_lower("1.2.*"), "1.2.0")

// --- svw_upper ---
cks("svw_upper_patch", svw_upper("1.2.x"), "1.3.0")
cks("svw_upper_minor", svw_upper("1.x"), "2.0.0")
cks("svw_upper_star", svw_upper("*"), "")
cks("svw_upper_star_patch", svw_upper("1.2.*"), "1.3.0")
cks("svw_upper_9minor", svw_upper("0.x"), "1.0.0")

print("PASS _semver_wildcard_test")
