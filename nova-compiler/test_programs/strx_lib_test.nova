import std/text/strx

// Validation test for the strx module's public functions.
// Each asserted result is computed by hand from strx.nova's source.
fn main()
    // case transforms (ASCII; non-letters pass through unchanged)
    assert(strx.str_upper_ascii("hello") == "HELLO", "upper basic")
    assert(strx.str_upper_ascii("abc123XYZ") == "ABC123XYZ", "upper digits pass through")
    assert(strx.str_lower_ascii("HELLO") == "hello", "lower basic")
    assert(strx.str_lower_ascii("A-B-C") == "a-b-c", "lower punctuation kept")

    // capitalize: first letter upper, rest lower
    assert(strx.capitalize("heLLO") == "Hello", "capitalize mixed case")
    assert(strx.capitalize("hello") == "Hello", "capitalize all lower")
    assert(strx.capitalize("") == "", "capitalize empty")

    // count_substr: non-overlapping occurrences
    assert(strx.count_substr("aaaa", "aa") == 2, "count_substr non-overlap")
    assert(strx.count_substr("abababab", "ab") == 4, "count_substr repeated")
    assert(strx.count_substr("hello", "z") == 0, "count_substr absent")

    // replace_all: non-overlapping left-to-right
    assert(strx.replace_all("a.b.c", ".", "-") == "a-b-c", "replace_all dots")
    assert(strx.replace_all("aaa", "a", "bb") == "bbbbbb", "replace_all expanding")
    assert(strx.replace_all("hello", "z", "Z") == "hello", "replace_all no match")

    // levenshtein edit distance
    assert(strx.levenshtein("kitten", "sitting") == 3, "levenshtein classic")
    assert(strx.levenshtein("abc", "abc") == 0, "levenshtein equal")
    assert(strx.levenshtein("", "abc") == 3, "levenshtein empty to len")
    assert(strx.levenshtein("abc", "abd") == 1, "levenshtein one substitution")

    // str_count_char: single-byte occurrences
    assert(strx.str_count_char("hello", "l") == 2, "count_char l")
    assert(strx.str_count_char("hello", "ll") == 0, "count_char non-single-byte -> 0")

    print("strx_lib_test passed")
