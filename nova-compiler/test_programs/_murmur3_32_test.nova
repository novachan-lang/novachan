import std/hash/murmur3_32

fn main()
    // KAT 1: empty bytes, seed 0 -> 0x00000000
    let h1 = h_murmur3_32(bytes(0), 0)
    let want1 = 0
    if h1 != want1
        print("FAIL murmur3_32 empty-seed0: got " + str(h1) + " want " + str(want1))
        exit(1)

    // KAT 2: empty bytes, seed 1 -> 0x514E28B7 = 1364076727
    let h2 = h_murmur3_32(bytes(0), 1)
    let want2 = 1364076727
    if h2 != want2
        print("FAIL murmur3_32 empty-seed1: got " + str(h2) + " want " + str(want2))
        exit(1)

    // KAT 3: "test" (4 bytes, exactly 1 block), seed 0 -> 0xBA6BD213 = 3127628307
    let h3 = h_murmur3_32(str_to_bytes("test"), 0)
    let want3 = 3127628307
    if h3 != want3
        print("FAIL murmur3_32 test-seed0: got " + str(h3) + " want " + str(want3))
        exit(1)

    // KAT 4: "Hello, world!" (13 bytes = 3 blocks + 1 tail), seed 0 -> 0xC0363E43 = 3224780355
    let h4 = h_murmur3_32(str_to_bytes("Hello, world!"), 0)
    let want4 = 3224780355
    if h4 != want4
        print("FAIL murmur3_32 hello-seed0: got " + str(h4) + " want " + str(want4))
        exit(1)

    print("PASS _murmur3_32_test")
