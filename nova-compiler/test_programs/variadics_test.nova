// variadics_test — type-safe variadic functions: a trailing `name: T...` rest param
// collects the extra call arguments into a list<T>. Element type is unified across
// all trailing args (no printf format-string class of bug).

fn sum_all(xs: int...) -> int
    let total = 0
    for x in xs
        total = total + x
    return total

fn greet(prefix: string, names: string...) -> string
    let out = prefix
    for n in names
        out = out + " " + n
    return out

fn main()
    assert_eq(sum_all(), 0)
    assert_eq(sum_all(5), 5)
    assert_eq(sum_all(1, 2, 3, 4), 10)

    assert_eq(greet("hi"), "hi")
    assert_eq(greet("hi", "a"), "hi a")
    assert_eq(greet("hi", "a", "b", "c"), "hi a b c")

    print("variadics_test passed")
