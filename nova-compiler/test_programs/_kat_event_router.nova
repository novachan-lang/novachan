import forge_event_router

fn main()
    let r = er_new()
    assert(er_route_count(r) == 0, "no routes")

    r = er_add_route(r, "user.created", "handle_user")
    r = er_add_route(r, "order.placed", "handle_order")
    r = er_add_route(r, "payment.done", "handle_payment")
    assert(er_route_count(r) == 3, "3 routes")
    assert(er_has_route(r, "user.created") == 1, "has user.created")

    let res1 = er_route(r, "user.created")
    r = res1["r"]
    assert(res1["found"] == 1, "found user route")
    assert(res1["handler"] == "handle_user", "handler match")

    let res2 = er_route(r, "unknown.event")
    r = res2["r"]
    assert(res2["found"] == 0, "not found unknown")
    assert(er_total_routed(r) == 1, "1 routed")
    assert(er_total_unrouted(r) == 1, "1 unrouted")
    assert(er_route_rate(r) == 50, "50% rate")

    r = er_remove_route(r, "order.placed")
    assert(er_has_route(r, "order.placed") == 0, "removed")
    assert(er_route_count(r) == 2, "2 routes left")

    print("EVENT-ROUTER KAT PASS")
