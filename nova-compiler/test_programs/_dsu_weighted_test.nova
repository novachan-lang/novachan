import std/collections/dsu_weighted

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn ckb(label, got, expected)
    let eg = 0
    if got
        eg = 1
    let ee = 0
    if expected
        ee = 1
    if eg != ee
        print("FAIL " + label + ": got " + str(eg) + " expected " + str(ee))
        exit(1)

fn main()
    // KAT: make(5); union(0,1,3); union(1,2,2)
    // phi(1)-phi(0)=3; phi(2)-phi(1)=2 => phi(2)-phi(0)=5
    let d = wds_make(5)

    // Union 0->1 with weight 3: phi(1)-phi(0)=3
    ckb("union(0,1,3)", wds_union(d, 0, 1, 3), true)

    // Union 1->2 with weight 2: phi(2)-phi(1)=2
    ckb("union(1,2,2)", wds_union(d, 1, 2, 2), true)

    // diff(0,2) = phi(2)-phi(0) = 5
    cki("diff(0,2)", wds_diff(d, 0, 2), 5)

    // diff(0,1) = phi(1)-phi(0) = 3
    cki("diff(0,1)", wds_diff(d, 0, 1), 3)

    // connected(0,2) = true
    ckb("connected(0,2)", wds_connected(d, 0, 2), true)

    // connected(0,3) = false (3 is still a singleton)
    ckb("connected(0,3)", wds_connected(d, 0, 3), false)

    // diff(0,3) = sentinel 1000000000 (not connected)
    cki("diff(0,3)", wds_diff(d, 0, 3), 1000000000)

    // union(0,2,99) should FAIL (contradicts existing phi(2)-phi(0)=5)
    ckb("union(0,2,99)=false", wds_union(d, 0, 2, 99), false)

    // Verify state is still consistent after rejected union
    cki("diff(0,2) after reject", wds_diff(d, 0, 2), 5)

    // Additional: diff reversed
    cki("diff(2,0)", wds_diff(d, 2, 0), -5)
    cki("diff(1,0)", wds_diff(d, 1, 0), -3)

    // Connect 3 and 4: phi(4)-phi(3)=7
    ckb("union(3,4,7)", wds_union(d, 3, 4, 7), true)
    cki("diff(3,4)", wds_diff(d, 3, 4), 7)
    ckb("connected(3,4)", wds_connected(d, 3, 4), true)
    ckb("connected(0,4)", wds_connected(d, 0, 4), false)

    // Consistent self-union: phi(0)-phi(0)=0
    ckb("union(0,0,0)", wds_union(d, 0, 0, 0), true)
    // Contradictory self-union
    ckb("union(0,0,1)=false", wds_union(d, 0, 0, 1), false)

    print("PASS _dsu_weighted_test")
