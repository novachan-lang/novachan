import std/quantum/quantum_state
import std/quantum/quantum_algo

// cki — integer known-answer check.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _quantum_algo_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // qal_parity
    cki("parity(3)", qal_parity(3), 0)
    cki("parity(1)", qal_parity(1), 1)
    cki("parity(7)", qal_parity(7), 1)
    cki("parity(0)", qal_parity(0), 0)
    cki("parity(6)", qal_parity(6), 0)

    // qal_is_constant / qal_is_balanced
    let c1 = []
    push(c1, 1)
    push(c1, 1)
    push(c1, 1)
    push(c1, 1)
    cki("is_constant([1,1,1,1])", qal_is_constant(c1), 1)

    let c2 = []
    push(c2, 0)
    push(c2, 1)
    cki("is_constant([0,1])", qal_is_constant(c2), 0)

    let b1 = []
    push(b1, 0)
    push(b1, 0)
    push(b1, 1)
    push(b1, 1)
    cki("is_balanced([0,0,1,1])", qal_is_balanced(b1), 1)

    let b2 = []
    push(b2, 0)
    push(b2, 0)
    push(b2, 0)
    push(b2, 1)
    cki("is_balanced([0,0,0,1])", qal_is_balanced(b2), 0)

    // qal_deutsch — all 4 truth tables of a 1-bit function
    cki("deutsch(0,0)", qal_deutsch(0, 0), 0)
    cki("deutsch(1,1)", qal_deutsch(1, 1), 0)
    cki("deutsch(0,1)", qal_deutsch(0, 1), 1)
    cki("deutsch(1,0)", qal_deutsch(1, 0), 1)

    // qal_deutsch_jozsa — constant cases
    let dj_c0 = []
    push(dj_c0, 0)
    push(dj_c0, 0)
    push(dj_c0, 0)
    push(dj_c0, 0)
    cki("dj([0,0,0,0])", qal_deutsch_jozsa(dj_c0), 0)

    let dj_c1 = []
    push(dj_c1, 1)
    push(dj_c1, 1)
    push(dj_c1, 1)
    push(dj_c1, 1)
    cki("dj([1,1,1,1])", qal_deutsch_jozsa(dj_c1), 0)

    // qal_deutsch_jozsa — balanced cases
    let dj_b0 = []
    push(dj_b0, 0)
    push(dj_b0, 1)
    push(dj_b0, 0)
    push(dj_b0, 1)
    cki("dj([0,1,0,1])", qal_deutsch_jozsa(dj_b0), 1)

    let dj_b1 = []
    push(dj_b1, 0)
    push(dj_b1, 0)
    push(dj_b1, 1)
    push(dj_b1, 1)
    cki("dj([0,0,1,1])", qal_deutsch_jozsa(dj_b1), 1)

    // qal_bernstein_vazirani — n=2 exhaustive over all s
    cki("bv(0,2)", qal_bernstein_vazirani(0, 2), 0)
    cki("bv(1,2)", qal_bernstein_vazirani(1, 2), 1)
    cki("bv(2,2)", qal_bernstein_vazirani(2, 2), 2)
    cki("bv(3,2)", qal_bernstein_vazirani(3, 2), 3)

    // qal_bernstein_vazirani — n=3
    cki("bv(5,3)", qal_bernstein_vazirani(5, 3), 5)
    cki("bv(0,3)", qal_bernstein_vazirani(0, 3), 0)
    cki("bv(7,3)", qal_bernstein_vazirani(7, 3), 7)
    cki("bv(1,3)", qal_bernstein_vazirani(1, 3), 1)

    print("PASS _quantum_algo_test")
