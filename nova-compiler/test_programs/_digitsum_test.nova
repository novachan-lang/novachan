import std/math/digitsum

// cki — check integer known answer
fn cki(label: str, got: int, expected: int)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn main()
    // --- ds_sum KATs ---
    // ds_sum(1234) == 1+2+3+4 == 10
    cki("ds_sum(1234)", ds_sum(1234), 10)

    // ds_sum(0) == 0  (loop body never executes; sum stays 0)
    cki("ds_sum(0)", ds_sum(0), 0)

    // ds_sum(9) == 9  (single digit)
    cki("ds_sum(9)", ds_sum(9), 9)

    // ds_sum(100) == 1+0+0 == 1
    cki("ds_sum(100)", ds_sum(100), 1)

    // ds_sum(999) == 9+9+9 == 27
    cki("ds_sum(999)", ds_sum(999), 27)

    // --- ds_count KATs ---
    // ds_count(1234) == 4
    cki("ds_count(1234)", ds_count(1234), 4)

    // ds_count(0) == 1  (convention: zero has one digit)
    cki("ds_count(0)", ds_count(0), 1)

    // ds_count(9) == 1
    cki("ds_count(9)", ds_count(9), 1)

    // ds_count(10) == 2
    cki("ds_count(10)", ds_count(10), 2)

    // ds_count(1000000) == 7
    cki("ds_count(1000000)", ds_count(1000000), 7)

    // --- ds_reverse KATs ---
    // ds_reverse(1234) == 4321
    cki("ds_reverse(1234)", ds_reverse(1234), 4321)

    // ds_reverse(0) == 0  (loop never runs; r stays 0)
    cki("ds_reverse(0)", ds_reverse(0), 0)

    // ds_reverse(100) == 1  (trailing zeros in n become leading zeros in reverse)
    cki("ds_reverse(100)", ds_reverse(100), 1)

    // ds_reverse(9) == 9
    cki("ds_reverse(9)", ds_reverse(9), 9)

    // ds_reverse(12) == 21
    cki("ds_reverse(12)", ds_reverse(12), 21)

    // --- ds_sum_base KATs ---
    // ds_sum_base(255, 16) == 15+15 == 30
    // 255 in hex = FF; digit F = 15; 15+15 = 30
    cki("ds_sum_base(255,16)", ds_sum_base(255, 16), 30)

    // ds_sum_base(8, 2) == 1  (8 in binary = 1000; digits sum = 1)
    cki("ds_sum_base(8,2)", ds_sum_base(8, 2), 1)

    // ds_sum_base(7, 2) == 3  (7 in binary = 111; digits sum = 1+1+1 = 3)
    cki("ds_sum_base(7,2)", ds_sum_base(7, 2), 3)

    // ds_sum_base(0, 16) == 0  (zero has no digits in loop)
    cki("ds_sum_base(0,16)", ds_sum_base(0, 16), 0)

    // ds_sum_base(256, 16) == 1  (256 = 0x100; digits 1+0+0 = 1)
    cki("ds_sum_base(256,16)", ds_sum_base(256, 16), 1)

    // --- ds_persistence KATs ---
    // ds_persistence(9875) == 3
    // 9875 -> 9+8+7+5=29 -> 2+9=11 -> 1+1=2  (3 steps)
    cki("ds_persistence(9875)", ds_persistence(9875), 3)

    // ds_persistence(5) == 0  (already single digit)
    cki("ds_persistence(5)", ds_persistence(5), 0)

    // ds_persistence(0) == 0  (0 < 10; already one digit)
    cki("ds_persistence(0)", ds_persistence(0), 0)

    // ds_persistence(199) == 3
    // 199 -> 1+9+9=19 -> 1+9=10 -> 1+0=1  (3 steps)
    cki("ds_persistence(199)", ds_persistence(199), 3)

    // ds_persistence(10) == 1
    // 10 -> 1+0=1  (1 step)
    cki("ds_persistence(10)", ds_persistence(10), 1)

    print("_digitsum_test passed")
