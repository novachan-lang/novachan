import forge_traffic_mirror

fn main()
    let tm = tm_new()
    tm = tm_add_rule(tm, "/api/", 50, "shadow-api:8081")
    tm = tm_add_rule(tm, "/web/", 100, "shadow-web:8082")
    assert(tm_rule_count(tm) == 2, "2 rules")

    let r1 = tm_should_mirror(tm, "/api/users", 10)
    assert(r1["mirror"] == 1, "10%50 mirror")
    assert(r1["target"] == "shadow-api:8081", "correct target")

    let r2 = tm_should_mirror(tm, "/api/orders", 75)
    assert(r2["mirror"] == 0, "75%50 no mirror")

    let r3 = tm_should_mirror(tm, "/web/home", 99)
    assert(r3["mirror"] == 1, "100% always mirror")

    assert(tm_total_mirrored(tm) == 2, "2 mirrored")
    assert(tm_total_skipped(tm) == 1, "1 skipped")
    assert(tm_rule_mirror_count(tm, "/api/") == 1, "api mirrored 1x")
    assert(tm_rule_mirror_count(tm, "/web/") == 1, "web mirrored 1x")

    tm = tm_record_mismatch(tm)
    tm = tm_record_mismatch(tm)
    assert(tm_total_mismatches(tm) == 2, "2 mismatches")

    tm = tm_disable_rule(tm, "/api/")
    let r4 = tm_should_mirror(tm, "/api/data", 10)
    assert(r4["mirror"] == 0, "disabled = no mirror")

    let r5 = tm_should_mirror(tm, "/other/path", 10)
    assert(r5["mirror"] == 0, "no matching rule")

    assert(tm_rule_mirror_count(tm, "nonexistent") == 0, "no rule = 0")

    print("TRAFFIC-MIRROR KAT PASS")
