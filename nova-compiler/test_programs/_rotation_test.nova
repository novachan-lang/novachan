import std/physics/rotation

fn approx(a: float, b: float) -> int
    let d = a - b
    let ad = 0.0
    if d < 0.0
        ad = 0.0 - d
    else
        ad = d
    if ad < 0.0001
        return 1
    return 0

fn main()
    // torque(10.0, 2.0) = 20.0
    let v1 = torque(10.0, 2.0)
    if approx(v1, 20.0) == 0
        print("FAIL torque_basic: got " + str(v1))
        exit(1)

    // angular_velocity(6.28318, 1.0) ~ 6.28318 (one full revolution in 1 second)
    let v2 = angular_velocity(6.28318, 1.0)
    if approx(v2, 6.28318) == 0
        print("FAIL angular_velocity_basic: got " + str(v2))
        exit(1)

    // centripetal_accel(4.0, 2.0) = 16/2 = 8.0
    let v3 = centripetal_accel(4.0, 2.0)
    if approx(v3, 8.0) == 0
        print("FAIL centripetal_accel_basic: got " + str(v3))
        exit(1)

    // moment_of_inertia_disk(2.0, 1.0) = 0.5*2*1 = 1.0
    let v4 = moment_of_inertia_disk(2.0, 1.0)
    if approx(v4, 1.0) == 0
        print("FAIL moment_of_inertia_disk_basic: got " + str(v4))
        exit(1)

    // moment_of_inertia_disk(4.0, 3.0) = 0.5*4*9 = 18.0
    let v5 = moment_of_inertia_disk(4.0, 3.0)
    if approx(v5, 18.0) == 0
        print("FAIL moment_of_inertia_disk_r3: got " + str(v5))
        exit(1)

    // angular_momentum(2.0, 5.0) = 10.0
    let v6 = angular_momentum(2.0, 5.0)
    if approx(v6, 10.0) == 0
        print("FAIL angular_momentum_basic: got " + str(v6))
        exit(1)

    // angular_velocity: theta=3.14159, t=2.0 => 1.570795
    let v7 = angular_velocity(3.14159, 2.0)
    if approx(v7, 1.570795) == 0
        print("FAIL angular_velocity_half_pi: got " + str(v7))
        exit(1)

    print("PASS _rotation_test")
