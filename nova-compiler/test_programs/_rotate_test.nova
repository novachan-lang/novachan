// KAT for std/geometry/rotate — 2D affine transforms (floats).
// All expected values hand-computed.
// Float comparisons use eps=0.001 component-wise.
import std/geometry/rotate

// ckf — check float equality within eps=0.001; FAIL+exit(1) on mismatch.
fn ckf(label: string, got: float, want: float)
    let diff = got - want
    let adiff = 0.0
    if diff < 0.0
        adiff = 0.0 - diff
    else
        adiff = diff
    if adiff > 0.001
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// cki — check int equality; FAIL+exit(1) on mismatch.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // KAT 1: ro_rotate(1.0, 0.0, pi()/2) should give [~0.0, ~1.0]
    // Rotating unit x-axis CCW 90 degrees gives the unit y-axis.
    let half_pi = pi() / 2.0
    let r1 = ro_rotate(1.0, 0.0, half_pi)
    ckf("rotate90 x", r1[0], 0.0)
    ckf("rotate90 y", r1[1], 1.0)

    // KAT 2: ro_rotate(1.0, 0.0, pi()) should give [-1.0, ~0.0]
    // Rotating unit x-axis by 180 degrees gives the negative x-axis.
    let pi_val = pi()
    let r2 = ro_rotate(1.0, 0.0, pi_val)
    ckf("rotate180 x", r2[0], 0.0 - 1.0)
    ckf("rotate180 y", r2[1], 0.0)

    // KAT 3: ro_translate(1.0, 2.0, 3.0, 4.0) == [4.0, 6.0]
    let t3 = ro_translate(1.0, 2.0, 3.0, 4.0)
    ckf("translate x", t3[0], 4.0)
    ckf("translate y", t3[1], 6.0)

    // KAT 4: ro_scale(2.0, 3.0, 2.0, 2.0) == [4.0, 6.0]
    let s4 = ro_scale(2.0, 3.0, 2.0, 2.0)
    ckf("scale x", s4[0], 4.0)
    ckf("scale y", s4[1], 6.0)

    // KAT 5: ro_rotate_about(2.0, 1.0, 1.0, 1.0, pi()/2)
    // Rotate point (2,1) about centre (1,1) by 90 degrees CCW.
    // Translate to origin: (1, 0); rotate 90 CCW: (0, 1); translate back: (1, 2).
    let half_pi2 = pi() / 2.0
    let r5 = ro_rotate_about(2.0, 1.0, 1.0, 1.0, half_pi2)
    ckf("rotate_about x", r5[0], 1.0)
    ckf("rotate_about y", r5[1], 2.0)

    // KAT 6: ro_rotate_points([[1.0,0.0],[0.0,1.0]], pi()/2)
    // Rotating two unit-axis points 90 degrees CCW:
    //   (1,0) -> (0,1)   and   (0,1) -> (-1,0)
    let half_pi3 = pi() / 2.0
    let pts6 = [[1.0, 0.0], [0.0, 1.0]]
    let rpts6 = ro_rotate_points(pts6, half_pi3)
    cki("rotate_points len", len(rpts6), 2)
    let rp0 = rpts6[0]
    let rp1 = rpts6[1]
    ckf("rotate_points[0] x", rp0[0], 0.0)
    ckf("rotate_points[0] y", rp0[1], 1.0)
    ckf("rotate_points[1] x", rp1[0], 0.0 - 1.0)
    ckf("rotate_points[1] y", rp1[1], 0.0)

    // KAT 7: ro_rotate(0.0, 1.0, 0.0 - pi()/2.0) — rotate -90 degrees (CW)
    // (0,1) rotated CW 90 degrees -> (1,0)
    let neg_half_pi = 0.0 - pi() / 2.0
    let r7 = ro_rotate(0.0, 1.0, neg_half_pi)
    ckf("rotate_neg90 x", r7[0], 1.0)
    ckf("rotate_neg90 y", r7[1], 0.0)

    // KAT 8: ro_translate with zero offset -> identity
    let t8 = ro_translate(5.0, 7.0, 0.0, 0.0)
    ckf("translate_zero x", t8[0], 5.0)
    ckf("translate_zero y", t8[1], 7.0)

    // KAT 9: ro_scale(3.0, 4.0, 0.5, 0.5) == [1.5, 2.0]
    let s9 = ro_scale(3.0, 4.0, 0.5, 0.5)
    ckf("scale_half x", s9[0], 1.5)
    ckf("scale_half y", s9[1], 2.0)

    print("_rotate_test passed")
