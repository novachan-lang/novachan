import std/math/schroeder

let s0 = sh_large(0)
if s0 != 1
    print("FAIL sh_large(0): expected 1 got " + str(s0))
    exit(1)

let s1 = sh_large(1)
if s1 != 2
    print("FAIL sh_large(1): expected 2 got " + str(s1))
    exit(1)

let s2 = sh_large(2)
if s2 != 6
    print("FAIL sh_large(2): expected 6 got " + str(s2))
    exit(1)

let s3 = sh_large(3)
if s3 != 22
    print("FAIL sh_large(3): expected 22 got " + str(s3))
    exit(1)

let s4 = sh_large(4)
if s4 != 90
    print("FAIL sh_large(4): expected 90 got " + str(s4))
    exit(1)

let s5 = sh_large(5)
if s5 != 394
    print("FAIL sh_large(5): expected 394 got " + str(s5))
    exit(1)

let sm0 = sh_small(0)
if sm0 != 1
    print("FAIL sh_small(0): expected 1 got " + str(sm0))
    exit(1)

let sm3 = sh_small(3)
if sm3 != 11
    print("FAIL sh_small(3): expected 11 got " + str(sm3))
    exit(1)

let sm4 = sh_small(4)
if sm4 != 45
    print("FAIL sh_small(4): expected 45 got " + str(sm4))
    exit(1)

let lst = sh_list(5)
let llen = len(lst)
if llen != 5
    print("FAIL sh_list(5) length: expected 5 got " + str(llen))
    exit(1)

let e0 = lst[0]
if e0 != 1
    print("FAIL sh_list(5)[0]: expected 1 got " + str(e0))
    exit(1)

let e1 = lst[1]
if e1 != 2
    print("FAIL sh_list(5)[1]: expected 2 got " + str(e1))
    exit(1)

let e2 = lst[2]
if e2 != 6
    print("FAIL sh_list(5)[2]: expected 6 got " + str(e2))
    exit(1)

let e3 = lst[3]
if e3 != 22
    print("FAIL sh_list(5)[3]: expected 22 got " + str(e3))
    exit(1)

let e4 = lst[4]
if e4 != 90
    print("FAIL sh_list(5)[4]: expected 90 got " + str(e4))
    exit(1)

print("_schroeder_test passed")
