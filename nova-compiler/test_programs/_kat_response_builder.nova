import forge_response_builder

fn main()
    let r = rb_new(200)
    assert(rb_status(r) == 200, "status 200")
    assert(rb_body(r) == "", "empty body")
    assert(rb_header_count(r) == 0, "no headers")

    r = rb_set_header(r, "X-Request-Id", "abc123")
    assert(rb_header_count(r) == 1, "1 header")
    let rh = rb_get_header(r, "X-Request-Id")
    assert(is_ok(rh), "get header ok")
    assert(unwrap(rh) == "abc123", "header value abc123")

    r = rb_set_header(r, "X-Request-Id", "override")
    assert(rb_header_count(r) == 1, "still 1 header after overwrite")
    let rh2 = rb_get_header(r, "X-Request-Id")
    assert(unwrap(rh2) == "override", "header overwritten")

    let rmiss = rb_get_header(r, "Nope")
    assert(is_err(rmiss), "missing header is err")

    r = rb_set_body(r, "hello world")
    assert(rb_body(r) == "hello world", "body set")

    r = rb_set_content_type(r, "text/plain")
    assert(rb_header_count(r) == 2, "2 headers after content-type")
    let rct = rb_get_header(r, "Content-Type")
    assert(unwrap(rct) == "text/plain", "content-type text/plain")

    let built = rb_build(r)
    assert(find(built, "HTTP/1.1 200 OK") == 0, "status line at start")
    assert(find(built, "X-Request-Id: override") >= 0, "header present in build")
    assert(find(built, "Content-Type: text/plain") >= 0, "content-type present in build")
    assert(find(built, "hello world") >= 0, "body present in build")

    let j = rb_new(201)
    j = rb_json(j, "{\"ok\":true}")
    assert(rb_status(j) == 201, "json status 201")
    assert(rb_body(j) == "{\"ok\":true}", "json body")
    let jct = rb_get_header(j, "Content-Type")
    assert(unwrap(jct) == "application/json", "json content-type")

    let red = rb_redirect("/login", 302)
    assert(rb_status(red) == 302, "redirect status 302")
    let loc = rb_get_header(red, "Location")
    assert(is_ok(loc), "redirect has location")
    assert(unwrap(loc) == "/login", "location == /login")
    let redbuilt = rb_build(red)
    assert(find(redbuilt, "HTTP/1.1 302 Found") == 0, "redirect status line")
    assert(find(redbuilt, "Location: /login") >= 0, "redirect location line")

    let unk = rb_new(499)
    let unkbuilt = rb_build(unk)
    assert(find(unkbuilt, "HTTP/1.1 499 Unknown") == 0, "unknown status text")

    print("RESPONSE-BUILDER KAT PASS")
