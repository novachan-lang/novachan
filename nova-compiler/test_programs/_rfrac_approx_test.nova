import std/rational/rfrac_approx

fn ckr(label: string, got: list, wn: int, wd: int)
    if got[0] != wn or got[1] != wd
        print("FAIL rfrac_approx " + label + ": got=" + str(got[0]) + "/" + str(got[1]) + " want=" + str(wn) + "/" + str(wd))
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL rfrac_approx " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // --- rfx_best_within ---
    // Closest to 1/3 with den<=2 is 1/2 (|1/2-1/3|=1/6 < |0/1-1/3|=1/3 < |1/1-1/3|=2/3)
    ckr("best_within(1,3,2)", rfx_best_within(1, 3, 2), 1, 2)

    // 314/100 = 3.14; best with den<=10 is 22/7
    ckr("best_within(314,100,10)", rfx_best_within(314, 100, 10), 22, 7)

    // Exact value 22/7 with den<=100 -> 22/7
    ckr("best_within(22,7,100)", rfx_best_within(22, 7, 100), 22, 7)

    // den<=1: floor(1/3)=0, ceil=1; both at dist 1/3 and 2/3; 0/1 is closer
    ckr("best_within(1,3,1)", rfx_best_within(1, 3, 1), 0, 1)

    // Negative: -1/3 with den<=2 -> -1/2
    ckr("best_within(-1,3,2)", rfx_best_within(-1, 3, 2), -1, 2)

    // Exact fraction fits in maxden
    ckr("best_within(3,4,4)", rfx_best_within(3, 4, 4), 3, 4)

    // --- rfx_simplest_between ---
    // Between 1/3 and 1/2: simplest is 2/5
    ckr("simplest_between(1/3,1/2)", rfx_simplest_between([1, 3], [1, 2]), 2, 5)

    // Between 0 and 1: simplest is 1/2
    ckr("simplest_between(0,1)", rfx_simplest_between([0, 1], [1, 1]), 1, 2)

    // Between 3/10 and 7/10: simplest is 1/2
    ckr("simplest_between(3/10,7/10)", rfx_simplest_between([3, 10], [7, 10]), 1, 2)

    // Between 1/4 and 1/3: simplest is 2/7
    ckr("simplest_between(1/4,1/3)", rfx_simplest_between([1, 4], [1, 3]), 2, 7)

    // Between 2/5 and 3/5: simplest is 1/2
    ckr("simplest_between(2/5,3/5)", rfx_simplest_between([2, 5], [3, 5]), 1, 2)

    // --- rfx_best_tol ---
    // 1/3 within 1/6: interval [1/6, 1/2]; simplest = 1/2 or 1/3 (1/3 has den=3, 1/2 has den=2)
    // Actually 1/2 has smaller den, but 1/3 is also in range. 1/2 is simpler.
    ckr("best_tol(1,3,1,6)", rfx_best_tol(1, 3, 1, 6), 1, 2)

    // 22/7 within 1/100: should return 22/7 itself or something simpler — 22/7 is exact
    ckr("best_tol(22,7,1,100)", rfx_best_tol(22, 7, 1, 100), 22, 7)

    // 0/1 within 1/4: interval [-1/4, 1/4]; contains integer 0
    ckr("best_tol(0,1,1,4)", rfx_best_tol(0, 1, 1, 4), 0, 1)

    print("PASS _rfrac_approx_test")
