// KAT test for std/numeric/polyfit.nova
// Tests: polyfit (degree 0, 1, 2), pf_linear, pf_predict, pf_correlation
import std/numeric/polyfit

fn approx(a, b, tol) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < tol
        return 1
    return 0

fn ckf(label, got, expected, tol)
    if approx(got, expected, tol) == 0
        print("FAIL: " + label + " got=" + str(got) + " expected=" + str(expected))
        exit(1)

fn ckfl(label, coeffs, idx, expected, tol)
    let got = coeffs[idx] * 1.0
    ckf(label, got, expected, tol)

fn main()
    let eps = 0.001

    // KAT 1: degree-1 linear: y = 2x + 1 on [0,1,2]
    // polyfit([0,1,2],[1,3,5],1) -> [1.0, 2.0] (intercept first, slope second)
    let xs1 = [0.0, 1.0, 2.0]
    let ys1 = [1.0, 3.0, 5.0]
    let c1 = polyfit.polyfit(xs1, ys1, 1)
    ckfl("kat1 intercept", c1, 0, 1.0, eps)
    ckfl("kat1 slope", c1, 1, 2.0, eps)

    // KAT 2: degree-0 constant fit -> [mean(ys)]
    // ys=[2,4,6], mean=4.0
    let xs2 = [0.0, 1.0, 2.0]
    let ys2 = [2.0, 4.0, 6.0]
    let c2 = polyfit.polyfit(xs2, ys2, 0)
    ckfl("kat2 degree0 mean", c2, 0, 4.0, eps)

    // KAT 3: degree-2 quadratic: y = x^2 exactly on [0,1,2,3]
    // y = 0 + 0*x + 1*x^2  -> coeffs = [0.0, 0.0, 1.0]
    let xs3 = [0.0, 1.0, 2.0, 3.0]
    let ys3 = [0.0, 1.0, 4.0, 9.0]
    let c3 = polyfit.polyfit(xs3, ys3, 2)
    ckfl("kat3 quad c0", c3, 0, 0.0, eps)
    ckfl("kat3 quad c1", c3, 1, 0.0, eps)
    ckfl("kat3 quad c2", c3, 2, 1.0, eps)

    // KAT 4: pf_predict with degree-1 coefficients
    // coeffs=[1.0, 2.0], x=3 -> 1 + 2*3 = 7
    let coeffs4 = [1.0, 2.0]
    let p4 = polyfit.pf_predict(coeffs4, 3.0)
    ckf("kat4 pf_predict 7.0", p4, 7.0, eps)

    // KAT 5: pf_correlation perfect positive
    let xs5 = [0.0, 1.0, 2.0]
    let ys5 = [0.0, 1.0, 2.0]
    let r5 = polyfit.pf_correlation(xs5, ys5)
    ckf("kat5 correlation +1", r5, 1.0, eps)

    // KAT 6: pf_correlation perfect negative
    let xs6 = [0.0, 1.0, 2.0]
    let ys6 = [2.0, 1.0, 0.0]
    let r6 = polyfit.pf_correlation(xs6, ys6)
    ckf("kat6 correlation -1", r6, 0.0 - 1.0, eps)

    // KAT 7: pf_linear convenience alias (degree-1)
    // y = 3x + 2 on [0,1,2,3]
    let xs7 = [0.0, 1.0, 2.0, 3.0]
    let ys7 = [2.0, 5.0, 8.0, 11.0]
    let c7 = polyfit.pf_linear(xs7, ys7)
    ckfl("kat7 pf_linear intercept", c7, 0, 2.0, eps)
    ckfl("kat7 pf_linear slope", c7, 1, 3.0, eps)

    // KAT 8: degree-2 quadratic fit with exact quadratic points
    // y = 1 + 2x + 3x^2 at x=0,1,2 -> y=1,6,17
    let xs8 = [0.0, 1.0, 2.0]
    let ys8 = [1.0, 6.0, 17.0]
    let c8 = polyfit.polyfit(xs8, ys8, 2)
    ckfl("kat8 quad2 c0", c8, 0, 1.0, eps)
    ckfl("kat8 quad2 c1", c8, 1, 2.0, eps)
    ckfl("kat8 quad2 c2", c8, 2, 3.0, eps)

    print("PASS _polyfit_test")
