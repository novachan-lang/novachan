import forge_cors

fn tf(b: bool) -> string
    "T" if b else "F"

fn main()
    let ok = 1

    // Wildcard origin: any Origin is allowed, response echoes "*", no Vary header.
    let wild = ["*"]
    let h1 = cors_headers("https://example.com", wild, [], [], 600)
    print("wild_origin=" + get(h1, "Access-Control-Allow-Origin", "MISSING"))
    print("wild_vary=" + tf(contains(h1, "Vary")))
    print("wild_methods=" + get(h1, "Access-Control-Allow-Methods", "MISSING"))
    if h1["Access-Control-Allow-Origin"] != "*" then ok = 0
    if contains(h1, "Vary") then ok = 0
    if h1["Access-Control-Allow-Methods"] != "GET, POST, OPTIONS" then ok = 0

    // Specific origin match: header echoes the exact origin, Vary: Origin is present.
    let specific = ["https://app.example.com", "https://other.example.com"]
    let h2 = cors_headers("https://app.example.com", specific, [], [], 600)
    print("specific_origin=" + get(h2, "Access-Control-Allow-Origin", "MISSING"))
    print("specific_vary=" + get(h2, "Vary", "MISSING"))
    if h2["Access-Control-Allow-Origin"] != "https://app.example.com" then ok = 0
    if h2["Vary"] != "Origin" then ok = 0

    // Origin not in the allow-list: no CORS headers at all.
    let h3 = cors_headers("https://evil.example.com", specific, [], [], 600)
    print("not_allowed_empty=" + tf(len(h3) == 0))
    if len(h3) != 0 then ok = 0
    print("not_allowed_check=" + tf(cors_is_allowed("https://evil.example.com", specific) == 1))
    if cors_is_allowed("https://evil.example.com", specific) == 1 then ok = 0

    // cors_is_allowed direct checks.
    print("is_allowed_wild=" + tf(cors_is_allowed("https://anything.example.com", wild) == 1))
    if cors_is_allowed("https://anything.example.com", wild) != 1 then ok = 0
    print("is_allowed_specific=" + tf(cors_is_allowed("https://app.example.com", specific) == 1))
    if cors_is_allowed("https://app.example.com", specific) != 1 then ok = 0

    // Preflight with custom methods/headers/max-age.
    let methods = ["GET", "PUT", "DELETE"]
    let headers = ["X-Custom-Header", "Content-Type"]
    let h4 = cors_preflight("https://app.example.com", specific, methods, headers, 3600)
    print("pf_origin=" + get(h4, "Access-Control-Allow-Origin", "MISSING"))
    print("pf_methods=" + get(h4, "Access-Control-Allow-Methods", "MISSING"))
    print("pf_headers=" + get(h4, "Access-Control-Allow-Headers", "MISSING"))
    print("pf_maxage=" + get(h4, "Access-Control-Max-Age", "MISSING"))
    if h4["Access-Control-Allow-Origin"] != "https://app.example.com" then ok = 0
    if h4["Access-Control-Allow-Methods"] != "GET, PUT, DELETE" then ok = 0
    if h4["Access-Control-Allow-Headers"] != "X-Custom-Header, Content-Type" then ok = 0
    if h4["Access-Control-Max-Age"] != "3600" then ok = 0

    // Preflight for a disallowed origin: still empty.
    let h5 = cors_preflight("https://evil.example.com", specific, methods, headers, 3600)
    print("pf_not_allowed_empty=" + tf(len(h5) == 0))
    if len(h5) != 0 then ok = 0

    // Preflight with defaults (empty methods/headers) falls back to the documented defaults.
    let h6 = cors_preflight("https://app.example.com", specific, [], [], 60)
    print("pf_default_headers=" + get(h6, "Access-Control-Allow-Headers", "MISSING"))
    if h6["Access-Control-Allow-Headers"] != "Content-Type, Authorization" then ok = 0

    // Vary header constant.
    print("vary_const=" + cors_vary_header())
    if cors_vary_header() != "Origin" then ok = 0

    if ok == 1
        print("FORGE-CORS KAT PASS")
    else
        print("FORGE-CORS KAT FAIL")
