import forge_canary_deployer

fn main()
    let c = canary_new()
    c = canary_deploy(c, "v1.0", 90)
    c = canary_deploy(c, "v1.1", 10)
    assert(canary_deploy_count(c) == 2, "2 deploys")

    let ver = canary_version(c, 0)
    assert(is_ok(ver), "ver ok")
    assert(unwrap(ver) == "v1.0", "v1.0")

    let wt = canary_weight(c, 1)
    assert(is_ok(wt), "weight ok")
    assert(unwrap(wt) == 10, "10%")

    let st = canary_status(c, 0)
    assert(is_ok(st), "status ok")
    assert(unwrap(st) == "active", "active")

    let p = canary_promote(c, 1)
    assert(is_ok(p), "promote ok")
    c = unwrap(p)
    assert(canary_promotion_count(c) == 1, "1 promotion")

    let st2 = canary_status(c, 1)
    assert(unwrap(st2) == "promoted", "promoted")

    let wt2 = canary_weight(c, 1)
    assert(unwrap(wt2) == 100, "100% after promote")

    let rb = canary_rollback(c, 0)
    assert(is_ok(rb), "rollback ok")
    c = unwrap(rb)
    assert(canary_rollback_count(c) == 1, "1 rollback")

    let bad = canary_promote(c, 0)
    assert(is_err(bad), "already rolled back")

    print("CANARY-DEPLOYER KAT PASS")
