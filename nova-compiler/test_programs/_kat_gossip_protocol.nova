import forge_gossip_protocol

fn main()
    let gp = gp_new()
    gp = gp_add_node(gp, "node-1")
    gp = gp_add_node(gp, "node-2")
    gp = gp_add_node(gp, "node-3")
    assert(gp_node_count(gp) == 3, "3 nodes")
    assert(gp_alive_count(gp) == 3, "3 alive")

    gp = gp_set_state(gp, "node-1", "role", "leader")
    gp = gp_set_state(gp, "node-1", "version", "v2.0")
    assert(gp_get_state(gp, "node-1", "role") == "leader", "node-1 role")
    assert(gp_generation(gp, "node-1") == 2, "gen 2 after 2 sets")

    gp = gp_gossip(gp, "node-1", "node-2")
    assert(gp_get_state(gp, "node-2", "role") == "leader", "gossip spread role")
    assert(gp_get_state(gp, "node-2", "version") == "v2.0", "gossip spread version")
    assert(gp_gossip_rounds(gp) == 1, "1 round")

    gp = gp_gossip(gp, "node-2", "node-3")
    assert(gp_get_state(gp, "node-3", "role") == "leader", "transitive gossip")

    gp = gp_mark_dead(gp, "node-3")
    assert(gp_alive_count(gp) == 2, "2 alive after dead")

    assert(gp_get_state(gp, "missing", "key") == "", "missing node")
    assert(gp_generation(gp, "missing") == 0, "missing gen")

    print("GOSSIP-PROTOCOL KAT PASS")
