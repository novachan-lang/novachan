import std/net/pop3_reply

// ── Assert helpers ────────────────────────────────────────────────────────────

fn assert_i(label, got, want)
    if got != want
        print("FAIL pop3_reply " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn assert_s(label, got, want)
    if got != want
        print("FAIL pop3_reply " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn main()
    let crlf = chr(13) + chr(10)

    // ── KAT 1: +OK single-line parse ─────────────────────────────────────────
    let r1 = pop3_reply_parse("+OK 2 messages")
    let r1_ok = r1["ok"]
    assert_i("ok-single-ok", r1_ok, 1)
    let r1_text = r1["text"]
    assert_s("ok-single-text", r1_text, "2 messages")
    let r1_lines = r1["lines"]
    assert_i("ok-single-lines-len", len(r1_lines), 0)
    print("PASS pop3_reply ok-single-line")

    // ── KAT 2: -ERR parse ────────────────────────────────────────────────────
    let r2 = pop3_reply_parse("-ERR bad")
    let r2_ok = r2["ok"]
    assert_i("err-ok", r2_ok, 0)
    let r2_text = r2["text"]
    assert_s("err-text", r2_text, "bad")
    print("PASS pop3_reply err-reply")

    // ── KAT 3: pop3_command with argument ────────────────────────────────────
    let cmd1 = pop3_command("USER", "bob")
    assert_s("cmd-user-bob", cmd1, "USER bob" + crlf)
    print("PASS pop3_reply cmd-user")

    // ── KAT 4: pop3_command without argument ─────────────────────────────────
    let cmd2 = pop3_command("QUIT", "")
    assert_s("cmd-quit", cmd2, "QUIT" + crlf)
    print("PASS pop3_reply cmd-quit")

    // ── KAT 5: multiline "+OK\r\nline1\r\n.\r\n" -> lines==["line1"] ─────────
    let multi1 = "+OK" + crlf + "line1" + crlf + "." + crlf
    let r5 = pop3_reply_parse(multi1)
    assert_i("multi-ok", r5["ok"], 1)
    let r5_lines = r5["lines"]
    assert_i("multi-lines-len", len(r5_lines), 1)
    let r5_line0 = r5_lines[0]
    assert_s("multi-line0", r5_line0, "line1")
    print("PASS pop3_reply multiline-basic")

    // ── KAT 6: multiline with multiple lines ─────────────────────────────────
    let multi2 = "+OK maildrop" + crlf + "1 512" + crlf + "2 1024" + crlf + "." + crlf
    let r6 = pop3_reply_parse(multi2)
    assert_i("multi2-ok", r6["ok"], 1)
    assert_s("multi2-text", r6["text"], "maildrop")
    let r6_lines = r6["lines"]
    assert_i("multi2-lines-len", len(r6_lines), 2)
    assert_s("multi2-line0", r6_lines[0], "1 512")
    assert_s("multi2-line1", r6_lines[1], "2 1024")
    print("PASS pop3_reply multiline-multiple")

    // ── KAT 7: dot-stuffing — a line beginning with ".." -> "." ──────────────
    // A body line that is ".." in the wire should be unstuffed to "."
    let multi3 = "+OK test" + crlf + "..dotted" + crlf + "." + crlf
    let r7 = pop3_reply_parse(multi3)
    let r7_lines = r7["lines"]
    assert_i("dot-lines-len", len(r7_lines), 1)
    assert_s("dot-line0", r7_lines[0], ".dotted")
    print("PASS pop3_reply dot-unstuff")

    // ── KAT 8: pop3_stat_parse ───────────────────────────────────────────────
    let stat1 = pop3_stat_parse("+OK 2 320")
    assert_i("stat-count", stat1[0], 2)
    assert_i("stat-size", stat1[1], 320)
    print("PASS pop3_reply stat-parse")

    // ── KAT 9: pop3_stat_parse without +OK prefix ────────────────────────────
    let stat2 = pop3_stat_parse("5 1024")
    assert_i("stat2-count", stat2[0], 5)
    assert_i("stat2-size", stat2[1], 1024)
    print("PASS pop3_reply stat-parse-raw")

    // ── KAT 10: command RETR with message number ──────────────────────────────
    let cmd3 = pop3_command("RETR", "1")
    assert_s("cmd-retr", cmd3, "RETR 1" + crlf)
    print("PASS pop3_reply cmd-retr")

    // ── KAT 11: +OK with no text ─────────────────────────────────────────────
    let r11 = pop3_reply_parse("+OK")
    assert_i("ok-no-text-ok", r11["ok"], 1)
    assert_s("ok-no-text-text", r11["text"], "")
    print("PASS pop3_reply ok-no-text")

    // ── KAT 12: multiline no trailing CRLF after terminator ──────────────────
    let multi4 = "+OK" + crlf + "hello" + crlf + "."
    let r12 = pop3_reply_parse(multi4)
    assert_i("multi-notrlcrlf-ok", r12["ok"], 1)
    let r12_lines = r12["lines"]
    assert_i("multi-notrlcrlf-len", len(r12_lines), 1)
    assert_s("multi-notrlcrlf-line0", r12_lines[0], "hello")
    print("PASS pop3_reply multiline-no-trailing-crlf")

    print("PASS _pop3_reply_test")
