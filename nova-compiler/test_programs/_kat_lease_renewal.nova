import forge_lease_renewal

fn main()
    let l = lr_new()
    l = lr_acquire(l, "db_lock", 100)
    l = lr_acquire(l, "cache_lock", 50)
    assert(lr_lease_count(l) == 2, "2 leases")
    assert(lr_is_active(l, "db_lock") == 1, "db active")

    let rem = lr_remaining(l, "db_lock")
    assert(is_ok(rem), "remaining ok")
    assert(unwrap(rem) == 100, "100 remaining")

    let t1 = lr_tick(l, "db_lock", 30)
    assert(is_ok(t1), "tick ok")
    l = unwrap(t1)
    let rem2 = lr_remaining(l, "db_lock")
    assert(unwrap(rem2) == 70, "70 remaining")

    let ren = lr_renew(l, "db_lock")
    assert(is_ok(ren), "renew ok")
    l = unwrap(ren)
    let rem3 = lr_remaining(l, "db_lock")
    assert(unwrap(rem3) == 100, "renewed to 100")
    assert(lr_renewal_count(l) == 1, "1 renewal")

    let t2 = lr_tick(l, "cache_lock", 60)
    assert(is_ok(t2), "tick cache ok")
    l = unwrap(t2)
    assert(lr_is_active(l, "cache_lock") == 0, "cache expired")
    assert(lr_expiration_count(l) == 1, "1 expiration")

    let bad = lr_renew(l, "cache_lock")
    assert(is_err(bad), "expired cannot renew")

    let bad2 = lr_remaining(l, "nope")
    assert(is_err(bad2), "not found")

    print("LEASE-RENEWAL KAT PASS")
