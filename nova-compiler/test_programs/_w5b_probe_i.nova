// list_append_no_rc-then-escape (iter-82): append a local list `inner` into a local list `nc`
// (routes to list_append_no_rc since nc is local), then RETURN nc -- nc escapes, so inner is
// still reachable and must NOT be dropped by the W5b return-drop. This corrupted before iter-82
// (the minimal pvecx structural-sharing pattern). Run under NOVA_T8_DROP=1.
fn mk() -> list
    let nc = []
    let inner = [1, 2, 3]
    push(nc, inner)
    return nc
fn main()
    let o = mk()
    let got = o[0]
    push(got, 99)
    assert_eq(len(got), 4)
    print("probe_i passed: list_append_no_rc element survived nc escape")
