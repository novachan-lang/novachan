import std/httphdr/http_content_disposition

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got=[" + got + "] want=[" + want + "]")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn ckl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)

fn main()
    // KAT — specified vectors
    cks("kat-type-1", hcd_type("attachment; filename=\"report.pdf\""), "attachment")
    cks("kat-filename-1", hcd_filename("attachment; filename=\"report.pdf\""), "report.pdf")
    cks("kat-filename-2", hcd_filename("inline; filename=a.txt"), "a.txt")
    cks("kat-name-1", hcd_name("form-data; name=\"field1\""), "field1")
    cks("kat-type-case", hcd_type("INLINE"), "inline")
    cks("kat-filename-absent", hcd_filename("attachment"), "")

    // Additional robustness tests

    // Type with trailing spaces
    cks("type-spaces", hcd_type("  attachment  ; filename=\"x.pdf\""), "attachment")

    // filename with no quotes (bare token)
    cks("filename-bare", hcd_filename("attachment; filename=hello.txt"), "hello.txt")

    // name absent
    cks("name-absent", hcd_name("attachment; filename=\"x\""), "")

    // Multiple params — filename before name
    cks("multi-fn-first", hcd_filename("form-data; filename=\"x.csv\"; name=\"file\""), "x.csv")
    cks("multi-nm-second", hcd_name("form-data; filename=\"x.csv\"; name=\"file\""), "file")

    // Case-insensitive parameter name
    cks("param-case-fn", hcd_filename("attachment; FILENAME=\"ci.pdf\""), "ci.pdf")
    cks("param-case-nm", hcd_name("form-data; Name=\"field2\""), "field2")

    // Empty input
    cks("empty-type", hcd_type(""), "")
    cks("empty-fn", hcd_filename(""), "")
    cks("empty-nm", hcd_name(""), "")

    // inline type
    cks("inline-type", hcd_type("inline"), "inline")

    // form-data type
    cks("formdata-type", hcd_type("form-data; name=\"x\""), "form-data")

    print("PASS _http_content_disposition_test")
