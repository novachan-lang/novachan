// _destination_test.nova — KAT for std/geo/destination
import std/geo/destination

fn check(label, got, expected, tol)
    let d = got - expected
    let ad = d
    if d < 0.0
        ad = 0.0 - d
    if ad > tol
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn main()
    // destination(0,0, east 90deg, 111195 m) -> [~0, ~1]
    let r1 = destination(0.0, 0.0, 90.0, 111195.0)
    let r1lat = r1[0] * 1.0
    let r1lon = r1[1] * 1.0
    check("destination east lat", r1lat, 0.0, 0.02)
    check("destination east lon", r1lon, 1.0, 0.02)

    // destination(0,0, north 0deg, 111195 m) -> [~1, ~0]
    let r2 = destination(0.0, 0.0, 0.0, 111195.0)
    let r2lat = r2[0] * 1.0
    let r2lon = r2[1] * 1.0
    check("destination north lat", r2lat, 1.0, 0.02)
    check("destination north lon", r2lon, 0.0, 0.02)

    print("PASS _destination_test")
