// forge_h2_test -- HTTP/2 frame codec (RFC 7540 §4.1): 9-octet header round-trips, big-endian length +
// 31-bit stream id, SETTINGS/WINDOW_UPDATE builders, and a multi-frame byte stream parse.
import forge_h2

fn main()
    // ── HEADERS frame round-trip (payload = some HPACK bytes) ────────────────────────────────────────
    let hpack = [130, 134, 132]
    let fr = forge_h2.h2_frame(forge_h2.h2_HEADERS(), forge_h2.h2_END_HEADERS() | forge_h2.h2_END_STREAM(), 1, hpack)
    assert(len(fr) == 9 + 3, "frame = 9-octet header + 3 payload")
    assert(fr[2] == 3, "length octet == 3")
    assert(fr[3] == 1, "type == HEADERS(1)")
    assert(fr[4] == 5, "flags == END_HEADERS|END_STREAM (0x05)")
    assert(fr[8] == 1, "stream id low octet == 1")
    let p = forge_h2.h2_frame_parse(fr, 0)
    assert(p[0] == 1 and p[1] == 5 and p[2] == 1, "parse: type HEADERS, flags 5, stream 1")
    assert(p[4] == 3 and p[5] == 12, "parse: payload_len 3, next_off 12")
    let pay = forge_h2.h2_payload(fr, p)
    assert(pay[0] == 130 and pay[1] == 134 and pay[2] == 132, "payload round-trips")
    print("PASS: h2 HEADERS frame header encode/parse + payload")

    // ── big length (300) + big stream id (2^30) survive the 24/31-bit fields ─────────────────────────
    let big = []
    let i = 0
    while i < 300
        push(big, 65)
        i = i + 1
    let bf = forge_h2.h2_frame(forge_h2.h2_DATA(), 0, 1073741824, big)   // stream 2^30
    let bp = forge_h2.h2_frame_parse(bf, 0)
    assert(bp[4] == 300, "24-bit length 300 round-trips (got " + str(bp[4]) + ")")
    assert(bp[2] == 1073741824, "31-bit stream id 2^30 round-trips (got " + str(bp[2]) + ")")
    print("PASS: h2 24-bit length + 31-bit stream id round-trip")

    // ── SETTINGS + WINDOW_UPDATE builders ────────────────────────────────────────────────────────────
    let s = forge_h2.h2_settings([[3, 100], [4, 65535]])   // MAX_CONCURRENT_STREAMS=100, INITIAL_WINDOW=65535
    let sp = forge_h2.h2_frame_parse(s, 0)
    assert(sp[0] == 4 and sp[2] == 0 and sp[4] == 12, "SETTINGS: type 4, stream 0, 2 pairs = 12 bytes")
    let wu = forge_h2.h2_window_update(1, 65535)
    let wp = forge_h2.h2_frame_parse(wu, 0)
    assert(wp[0] == 8 and wp[2] == 1 and wp[4] == 4, "WINDOW_UPDATE: type 8, stream 1, 4-byte payload")
    print("PASS: h2 SETTINGS + WINDOW_UPDATE builders")

    // ── a multi-frame stream parses frame-by-frame via next_off ──────────────────────────────────────
    let stream = []
    let a = 0
    while a < len(s)
        push(stream, s[a])
        a = a + 1
    let b = 0
    while b < len(fr)
        push(stream, fr[b])
        b = b + 1
    let f1 = forge_h2.h2_frame_parse(stream, 0)
    assert(f1[0] == 4, "stream frame 1 = SETTINGS")
    let f2 = forge_h2.h2_frame_parse(stream, f1[5])
    assert(f2[0] == 1 and f2[2] == 1, "stream frame 2 = HEADERS on stream 1 (via next_off)")
    print("PASS: h2 multi-frame stream parse")

    // preface constant is exactly the RFC 7540 client connection preface
    assert(forge_h2.h2_preface() == "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n", "h2 preface constant")
    print("PASS: h2 connection preface")

    print("forge_h2_test passed")
