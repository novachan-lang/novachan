import std/image/img_quantize

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL img_quantize " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // ── KAT 1: img_quantize([0,85,170,255], 2) -> [0,0,255,255] ─────────────
    // levels=2: palette is [0, 255].
    // 0   -> nearest(0,255) to 0   -> 0
    // 85  -> nearest(0,255) to 85  -> 0   (distance to 0 is 85; to 255 is 170)
    // 170 -> nearest(0,255) to 170 -> 255 (distance to 0 is 170; to 255 is 85)
    // 255 -> nearest(0,255) to 255 -> 255
    let px1 = []
    px1.push(0)
    px1.push(85)
    px1.push(170)
    px1.push(255)
    let res1 = img_quantize(px1, 2)
    cki("q2_0",   res1[0], 0)
    cki("q2_85",  res1[1], 0)
    cki("q2_170", res1[2], 255)
    cki("q2_255", res1[3], 255)

    // ── KAT 2: img_quantize([200], 4) -> [170] ───────────────────────────────
    // levels=4: palette is [0, 85, 170, 255].
    // 200 -> closest to 170 (dist=30) vs 255 (dist=55) -> 170
    let px2 = []
    px2.push(200)
    let res2 = img_quantize(px2, 4)
    cki("q4_200", res2[0], 170)

    // ── KAT 3: img_posterize([100], 1) -> [0] ────────────────────────────────
    // bits=1 -> 2 levels: [0, 255].
    // 100 -> closer to 0 (dist=100) than 255 (dist=155) -> 0
    let px3 = []
    px3.push(100)
    let res3 = img_posterize(px3, 1)
    cki("posterize1_100", res3[0], 0)

    // ── KAT 4: posterize with bits=1 is only 0 or 255 ───────────────────────
    let px4 = []
    px4.push(0)
    px4.push(50)
    px4.push(127)
    px4.push(128)
    px4.push(200)
    px4.push(255)
    let res4 = img_posterize(px4, 1)
    let pi = 0
    while pi < 6
        let pv = res4[pi]
        let valid = 0
        if pv == 0
            valid = 1
        if pv == 255
            valid = 1
        cki("posterize1_valid_" + str(pi), valid, 1)
        pi = pi + 1

    // ── KAT 5: quantize levels=1 -> all 0 ────────────────────────────────────
    let px5 = []
    px5.push(0)
    px5.push(128)
    px5.push(255)
    let res5 = img_quantize(px5, 1)
    cki("q1_0",   res5[0], 0)
    cki("q1_128", res5[1], 0)
    cki("q1_255", res5[2], 0)

    // ── KAT 6: quantize levels=256 is identity (0..255 intact) ───────────────
    let px6 = []
    px6.push(0)
    px6.push(127)
    px6.push(200)
    px6.push(255)
    let res6 = img_quantize(px6, 256)
    cki("q256_0",   res6[0], 0)
    cki("q256_127", res6[1], 127)
    cki("q256_200", res6[2], 200)
    cki("q256_255", res6[3], 255)

    // ── KAT 7: posterize bits=2 -> 4 levels (0,85,170,255) ───────────────────
    let px7 = []
    px7.push(0)
    px7.push(85)
    px7.push(170)
    px7.push(255)
    let res7 = img_posterize(px7, 2)
    cki("post2_0",   res7[0], 0)
    cki("post2_85",  res7[1], 85)
    cki("post2_170", res7[2], 170)
    cki("post2_255", res7[3], 255)

    print("PASS _img_quantize_test")
