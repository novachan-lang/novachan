fn permutations(items)
  if len(items) <= 1
    return [items]
  let result = []
  let i = 0
  while i < len(items)
    let rest = []
    let j = 0
    while j < len(items)
      if j != i
        push(rest, items[j])
      j = j + 1
    let sub_perms = permutations(rest)
    for sp in sub_perms
      let perm = [items[i]]
      for x in sp
        push(perm, x)
      push(result, perm)
    i = i + 1
  result

fn combinations(items, k)
  if k == 0
    return [[]]
  if k > len(items)
    return []
  let result = []
  let i = 0
  while i < len(items)
    let rest = []
    let j = i + 1
    while j < len(items)
      push(rest, items[j])
      j = j + 1
    let sub = combinations(rest, k - 1)
    for s in sub
      let combo = [items[i]]
      for x in s
        push(combo, x)
      push(result, combo)
    i = i + 1
  result

fn power_set(items)
  let result = [[]]
  for item in items
    let new_sets = []
    for existing in result
      let with_item = []
      for x in existing
        push(with_item, x)
      push(with_item, item)
      push(new_sets, with_item)
    for ns in new_sets
      push(result, ns)
  result

fn main()
  let perms = permutations([1, 2, 3])
  assert(len(perms) == 6, "3! = 6 permutations")
  assert(perms[0][0] == 1, "first perm starts with 1")

  let perms1 = permutations([1])
  assert(len(perms1) == 1, "1! = 1")

  let combs = combinations([1, 2, 3, 4], 2)
  assert(len(combs) == 6, "C(4,2) = 6")

  let combs3 = combinations([1, 2, 3, 4], 3)
  assert(len(combs3) == 4, "C(4,3) = 4")

  let combs0 = combinations([1, 2], 0)
  assert(len(combs0) == 1, "C(n,0) = 1 (empty set)")

  let ps = power_set([1, 2, 3])
  assert(len(ps) == 8, "2^3 = 8 subsets")

  let ps0 = power_set([])
  assert(len(ps0) == 1, "power set of empty = 1")

  print("permutx: all passed")
