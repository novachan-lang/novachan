// searchx — binary search + sorted-list utilities (pure NOVA) over an ascending
// int list. binary_search (exact), lower_bound/upper_bound (first >= / first >),
// binary_insert_pos (where to insert keeping sorted), is_sorted, contains_sorted.
// O(log n); strengthens the generic-algorithm-library row.

fn binary_search(xs, key) -> int
    let lo = 0
    let hi = len(xs) - 1
    while lo <= hi
        let mid = lo + (hi - lo) / 2
        if xs[mid] == key
            return mid
        if xs[mid] < key
            lo = mid + 1
        else
            hi = mid - 1
    return -1

fn lower_bound(xs, key) -> int
    let lo = 0
    let hi = len(xs)
    while lo < hi
        let mid = lo + (hi - lo) / 2
        if xs[mid] < key
            lo = mid + 1
        else
            hi = mid
    return lo

fn upper_bound(xs, key) -> int
    let lo = 0
    let hi = len(xs)
    while lo < hi
        let mid = lo + (hi - lo) / 2
        if xs[mid] <= key
            lo = mid + 1
        else
            hi = mid
    return lo

fn binary_insert_pos(xs, key) -> int
    return lower_bound(xs, key)

fn contains_sorted(xs, key) -> bool
    return binary_search(xs, key) >= 0

fn is_sorted(xs) -> bool
    let i = 1
    while i < len(xs)
        if xs[i] < xs[i - 1]
            return false
        i = i + 1
    return true

fn main()
    let xs = [1, 3, 5, 7, 9, 11]
    assert_eq(binary_search(xs, 7), 3)
    assert_eq(binary_search(xs, 1), 0)
    assert_eq(binary_search(xs, 11), 5)
    assert_eq(binary_search(xs, 4), -1)
    assert_eq(binary_search([], 4), -1)

    let dup = [1, 2, 2, 2, 3]
    assert_eq(lower_bound(dup, 2), 1)
    assert_eq(upper_bound(dup, 2), 4)
    assert_eq(lower_bound(dup, 0), 0)
    assert_eq(upper_bound(dup, 3), 5)

    assert_eq(binary_insert_pos([1, 3, 5], 4), 2)
    assert_eq(binary_insert_pos([1, 3, 5], 0), 0)
    assert_eq(binary_insert_pos([1, 3, 5], 9), 3)

    assert(contains_sorted(xs, 9), "9 present")
    assert(not contains_sorted(xs, 8), "8 absent")
    assert(is_sorted([1, 2, 2, 3]), "sorted")
    assert(not is_sorted([1, 3, 2]), "unsorted")

    print("searchx passed")
