import forge_compliance

fn main()
    let c = comp_new("SOC2")
    c = comp_add_control(c, "CC1.1", "Access Control", "high")
    c = comp_add_control(c, "CC2.1", "Encryption at Rest", "high")
    c = comp_add_control(c, "CC3.1", "Logging", "medium")
    c = comp_add_control(c, "CC4.1", "Incident Response", "high")
    assert(comp_control_count(c) == 4, "4 controls")

    c = comp_mark_compliant(c, "CC1.1")
    c = comp_mark_compliant(c, "CC3.1")
    c = comp_mark_non_compliant(c, "CC2.1", "No encryption configured")
    assert(comp_compliant_count(c) == 2, "2 compliant")
    assert(comp_compliance_pct(c) == 50, "50% compliant")

    assert(comp_finding_count(c) == 1, "1 finding")
    let findings = comp_open_findings(c)
    assert(findings[0]["control"] == "CC2.1", "finding for CC2.1")
    assert(findings[0]["reason"] == "No encryption configured", "finding reason")

    c = comp_add_evidence(c, "CC1.1", "audit_log", "MFA enabled for all users")
    c = comp_add_evidence(c, "CC1.1", "screenshot", "IAM policy review")

    let high = comp_by_severity(c, "high")
    assert(len(high) == 3, "3 high severity")

    let medium = comp_by_severity(c, "medium")
    assert(len(medium) == 1, "1 medium severity")

    c = comp_mark_compliant(c, "CC2.1")
    c = comp_mark_compliant(c, "CC4.1")
    assert(comp_compliance_pct(c) == 100, "100% compliant")

    print("COMPLIANCE KAT PASS")
