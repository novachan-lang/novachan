import std/units/pressure

// approx — float equality within tolerance.
fn approx(a, b, tol)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < tol

fn ckf(label, got, want, tol)
    if not approx(got, want, tol)
        print("FAIL pressure " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // KAT 1: 1 bar -> Pa = 100000
    let r1 = pressure_convert(1.0, "bar", "pa")
    ckf("bar->pa", r1, 100000.0, 0.01)

    // KAT 2: 1 atm -> Pa = 101325
    let r2 = pressure_convert(1.0, "atm", "pa")
    ckf("atm->pa", r2, 101325.0, 0.01)

    // KAT 3: 1 atm -> kPa ≈ 101.325
    let r3 = pressure_convert(1.0, "atm", "kpa")
    ckf("atm->kpa", r3, 101.325, 0.01)

    // KAT 4: 1 psi -> Pa ≈ 6894.757
    let r4 = pressure_convert(1.0, "psi", "pa")
    ckf("psi->pa", r4, 6894.757, 0.01)

    // KAT 5: round-trip bar->mbar->bar
    let v5 = 1.0
    let rt5 = pressure_convert(pressure_convert(v5, "bar", "mbar"), "mbar", "bar")
    ckf("roundtrip-bar-mbar", rt5, v5, 0.0001)

    // KAT 6: round-trip atm->mmhg->atm
    let v6 = 1.0
    let rt6 = pressure_convert(pressure_convert(v6, "atm", "mmhg"), "mmhg", "atm")
    ckf("roundtrip-atm-mmhg", rt6, v6, 0.0001)

    // KAT 7: hpa == mbar (same factor 100 Pa)
    let r7a = pressure_convert(1013.25, "hpa", "pa")
    let r7b = pressure_convert(1013.25, "mbar", "pa")
    ckf("hpa-eq-mbar", r7a, r7b, 0.001)

    // KAT 8: 1 inhg -> Pa ≈ 3386.389
    let r8 = pressure_convert(1.0, "inhg", "pa")
    ckf("inhg->pa", r8, 3386.389, 0.01)

    // KAT 9: pressure_is_supported
    let s1 = pressure_is_supported("atm")
    if s1 != 1
        print("FAIL pressure is_supported atm")
        exit(1)
    let s2 = pressure_is_supported("unknown")
    if s2 != 0
        print("FAIL pressure is_supported unknown")
        exit(1)

    // KAT 10: round-trip psi->kpa->psi
    let v10 = 14.696
    let rt10 = pressure_convert(pressure_convert(v10, "psi", "kpa"), "kpa", "psi")
    ckf("roundtrip-psi-kpa", rt10, v10, 0.001)

    print("PASS _pressure_test")
