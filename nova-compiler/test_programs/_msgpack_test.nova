// _msgpack_test.nova — KAT for std/data/msgpack
// Known-answer tests against published MessagePack spec vectors.
// Each failure prints "FAIL: <description>" and exits with code 1.
import std/data/msgpack

fn cki(got, expected, label)
    if got != expected
        print("FAIL: " + label + " expected " + str(expected) + " got " + str(got))
        exit(1)

fn cks(got, expected, label)
    if got != expected
        print("FAIL: " + label + " expected [" + expected + "] got [" + got + "]")
        exit(1)

fn main()
    // ── KAT 1: positive fixint 1 → first byte == 1 ──────────────────────────
    let enc1 = mp_encode(1)
    cki(bytes_get(enc1, 0), 1, "mp_encode(1) first byte == 1 (positive fixint)")

    // ── KAT 2: positive fixint 127 → first byte == 127 ──────────────────────
    let enc127 = mp_encode(127)
    cki(bytes_get(enc127, 0), 127, "mp_encode(127) first byte == 127 (fixint upper edge)")

    // ── KAT 3: negative fixint -1 → first byte == 255 (0xff) ────────────────
    let encm1 = mp_encode(-1)
    cki(bytes_get(encm1, 0), 255, "mp_encode(-1) first byte == 255 (0xff negative fixint)")

    // ── KAT 4: string "a" → bytes [161, 97] ─────────────────────────────────
    // 161 = 0xa1 = 0xa0 | 1 (fixstr len=1), 97 = ord('a')
    let enc_a = mp_encode("a")
    cki(bytes_len(enc_a), 2, "mp_encode('a') length == 2")
    cki(bytes_get(enc_a, 0), 161, "mp_encode('a') byte[0] == 161 (fixstr tag)")
    cki(bytes_get(enc_a, 1), 97,  "mp_encode('a') byte[1] == 97 ('a')")

    // ── KAT 5: list [1,2,3] → bytes [147, 1, 2, 3] ──────────────────────────
    // 147 = 0x93 = 0x90 | 3 (fixarray len=3)
    let lst123 = []
    lst123.push(1)
    lst123.push(2)
    lst123.push(3)
    let enc_lst = mp_encode(lst123)
    cki(bytes_len(enc_lst), 4, "mp_encode([1,2,3]) length == 4")
    cki(bytes_get(enc_lst, 0), 147, "mp_encode([1,2,3]) byte[0] == 147 (fixarray)")
    cki(bytes_get(enc_lst, 1), 1,   "mp_encode([1,2,3]) byte[1] == 1")
    cki(bytes_get(enc_lst, 2), 2,   "mp_encode([1,2,3]) byte[2] == 2")
    cki(bytes_get(enc_lst, 3), 3,   "mp_encode([1,2,3]) byte[3] == 3")

    // ── KAT 6: string round-trip mp_decode(mp_encode("hello")) == "hello" ────
    let enc_hello = mp_encode("hello")
    let dec_hello = mp_decode(enc_hello)
    cks(dec_hello, "hello", "mp_decode(mp_encode('hello')) == 'hello'")

    // ── KAT 7: list round-trip mp_decode(mp_encode([1,2,3])) == [1,2,3] ──────
    let lst_rt = []
    lst_rt.push(1)
    lst_rt.push(2)
    lst_rt.push(3)
    let enc_lst_rt = mp_encode(lst_rt)
    let dec_lst = mp_decode(enc_lst_rt)
    cki(len(dec_lst), 3, "mp_decode(mp_encode([1,2,3])) len == 3")
    cki(dec_lst[0], 1, "mp_decode(mp_encode([1,2,3]))[0] == 1")
    cki(dec_lst[1], 2, "mp_decode(mp_encode([1,2,3]))[1] == 2")
    cki(dec_lst[2], 3, "mp_decode(mp_encode([1,2,3]))[2] == 3")

    // ── KAT 8: dict round-trip d["x"]=1 survives encode/decode ──────────────
    let d = {}
    d["x"] = 1
    let enc_d = mp_encode(d)
    let dec_d = mp_decode(enc_d)
    cki(dec_d["x"], 1, "mp_decode(mp_encode(d))['x'] == 1")

    // ── KAT 9: null encodes to single byte 0xc0 ──────────────────────────────
    let enc_null = mp_encode(null)
    cki(bytes_len(enc_null), 1, "mp_encode(null) length == 1")
    cki(bytes_get(enc_null, 0), 192, "mp_encode(null) byte[0] == 192 (0xc0)")

    // ── KAT 10: null round-trip ───────────────────────────────────────────────
    let dec_null = mp_decode(enc_null)
    if dec_null != null
        print("FAIL: mp_decode(mp_encode(null)) != null")
        exit(1)

    // ── KAT 11: uint8 range (e.g. 200) encodes as 0xcc + 1 byte ─────────────
    let enc200 = mp_encode(200)
    cki(bytes_len(enc200), 2, "mp_encode(200) length == 2 (uint8)")
    cki(bytes_get(enc200, 0), 204, "mp_encode(200) byte[0] == 204 (0xcc)")
    cki(bytes_get(enc200, 1), 200, "mp_encode(200) byte[1] == 200")
    let dec200 = mp_decode(enc200)
    cki(dec200, 200, "mp_decode(mp_encode(200)) == 200")

    // ── KAT 12: mp_decode_at returns [value, next_pos] ───────────────────────
    let pair = mp_decode_at(enc_a, 0)
    cks(pair[0], "a", "mp_decode_at(['a' bytes], 0)[0] == 'a'")
    cki(pair[1], 2,   "mp_decode_at(['a' bytes], 0)[1] == 2 (next pos)")

    // ── KAT 13: negative fixint -32 → 0xe0 ───────────────────────────────────
    let encm32 = mp_encode(-32)
    cki(bytes_get(encm32, 0), 224, "mp_encode(-32) byte[0] == 224 (0xe0)")
    let decm32 = mp_decode(encm32)
    cki(decm32, -32, "mp_decode(mp_encode(-32)) == -32")

    // ── KAT 14: str8 for longer string (len >= 32) ───────────────────────────
    let long_s = "abcdefghijklmnopqrstuvwxyzabcdef"
    let enc_long = mp_encode(long_s)
    cki(bytes_get(enc_long, 0), 217, "mp_encode(32-char str) byte[0] == 217 (0xd9 str8)")
    cki(bytes_get(enc_long, 1), 32,  "mp_encode(32-char str) byte[1] == 32 (len)")
    let dec_long = mp_decode(enc_long)
    cks(dec_long, long_s, "mp_decode(mp_encode(32-char str)) round-trips")

    print("_msgpack_test passed")
