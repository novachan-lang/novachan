// _code93_test.nova — KAT for std/barcode/code93
//
// Code 93 known-answer tests:
//   - character validity
//   - character values (0..46 mapping)
//   - two mod-47 check checksums (C and K)
//   - determinism

import std/barcode/code93

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    if got != want
        let gs = "false"
        let ws = "false"
        if got
            gs = "true"
        if want
            ws = "true"
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn main()
    // ── KAT 1: character values ────────────────────────────────────────────────
    // 0-9 at indices 0..9
    cki("val_0", code93_charvalue("0"), 0)
    cki("val_1", code93_charvalue("1"), 1)
    cki("val_9", code93_charvalue("9"), 9)
    // A-Z at indices 10..35
    cki("val_A", code93_charvalue("A"), 10)
    cki("val_B", code93_charvalue("B"), 11)
    cki("val_Z", code93_charvalue("Z"), 35)
    cki("val_M", code93_charvalue("M"), 22)
    // specials
    cki("val_dash",   code93_charvalue("-"), 36)
    cki("val_dot",    code93_charvalue("."), 37)
    cki("val_space",  code93_charvalue(" "), 38)
    cki("val_dollar", code93_charvalue("$"), 39)
    cki("val_slash",  code93_charvalue("/"), 40)
    cki("val_plus",   code93_charvalue("+"), 41)
    cki("val_pct",    code93_charvalue("%"), 42)
    // invalid
    cki("val_invalid_a",   code93_charvalue("a"),  -1)
    cki("val_invalid_star",code93_charvalue("*"),  -1)
    cki("val_invalid_at",  code93_charvalue("@"),  -1)

    // ── KAT 2: valid char check ────────────────────────────────────────────────
    cki("valid_A",     code93_valid_char("A"), 1)
    cki("valid_0",     code93_valid_char("0"), 1)
    cki("valid_pct",   code93_valid_char("%"), 1)
    cki("invalid_a",   code93_valid_char("a"), 0)
    cki("invalid_star",code93_valid_char("*"), 0)

    // ── KAT 3: checksums for "0" (single char, value=0) ───────────────────────
    // C: csum = 0*1 = 0 → C=0
    // K: vals=[0,0], ksum = 0*1 + 0*2 = 0 → K=0
    let chk0 = code93_checksums("0")
    cki("checksums_0_len",  len(chk0), 2)
    cki("checksums_0_C",    chk0[0],   0)
    cki("checksums_0_K",    chk0[1],   0)

    // ── KAT 4: checksums for "A" (value=10) ───────────────────────────────────
    // C: csum = 10*1 = 10 → C=10
    // K: vals=[10,10], ksum = 10*1 + 10*2 = 30 → K=30
    let chkA = code93_checksums("A")
    cki("checksums_A_C", chkA[0], 10)
    cki("checksums_A_K", chkA[1], 30)

    // ── KAT 5: checksums for "CODE93" (multi-char) ────────────────────────────
    // C=12, O=24, D=13, E=14, 9=9, 3=3 → values [12,24,13,14,9,3], n=6
    // C checksum (rightmost first, weights 1,2,3,4,5,6):
    //   3*1 + 9*2 + 14*3 + 13*4 + 24*5 + 12*6
    //   = 3 + 18 + 42 + 52 + 120 + 72 = 307; 307 mod 47 = 25
    // K checksum: append 25 → [12,24,13,14,9,3,25], n2=7
    //   weights cycling 1..15, rightmost first:
    //   25*1 + 3*2 + 9*3 + 14*4 + 13*5 + 24*6 + 12*7
    //   = 25 + 6 + 27 + 56 + 65 + 144 + 84 = 407; 407 mod 47 = 31
    let chk6 = code93_checksums("CODE93")
    cki("checksums_CODE93_C", chk6[0], 25)
    cki("checksums_CODE93_K", chk6[1], 31)

    // ── KAT 6: result values are always in 0..46 ──────────────────────────────
    let chkx = code93_checksums("HELLO")
    let cv = chkx[0]
    let kv = chkx[1]
    if cv < 0 or cv > 46
        print("FAIL range_C: " + str(cv) + " out of 0..46")
        exit(1)
    if kv < 0 or kv > 46
        print("FAIL range_K: " + str(kv) + " out of 0..46")
        exit(1)

    // ── KAT 7: determinism ────────────────────────────────────────────────────
    let d1 = code93_checksums("TEST")
    let d2 = code93_checksums("TEST")
    cki("determinism_C", d1[0], d2[0])
    cki("determinism_K", d1[1], d2[1])

    // ── KAT 8: empty string returns [0, 0] ────────────────────────────────────
    // No values → C sum=0 → C=0; K: one value [0], ksum=0*1=0 → K=0
    let chk_empty = code93_checksums("")
    cki("checksums_empty_C", chk_empty[0], 0)
    cki("checksums_empty_K", chk_empty[1], 0)

    // ── KAT 9: checksums for "1" (value=1) ────────────────────────────────────
    // C: 1*1 = 1 → C=1
    // K: vals=[1,1], ksum=1*1+1*2=3 → K=3
    let chk1 = code93_checksums("1")
    cki("checksums_1_C", chk1[0], 1)
    cki("checksums_1_K", chk1[1], 3)

    print("PASS _code93_test")
