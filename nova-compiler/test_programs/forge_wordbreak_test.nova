import forge_wordbreak

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn joinl(xs: list) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + " "
        out = out + xs[i]
        i = i + 1
    out

fn main()
    let fails = 0

    // can_break
    fails = fails + expect("cb_leet", str(can_break("leetcode", ["leet", "code"])), "true")
    fails = fails + expect("cb_apple", str(can_break("applepenapple", ["apple", "pen"])), "true")
    fails = fails + expect("cb_no", str(can_break("catsandog", ["cats", "dog", "sand", "and", "cat"])), "false")
    fails = fails + expect("cb_empty", str(can_break("", ["a"])), "true")
    fails = fails + expect("cb_single", str(can_break("a", ["a"])), "true")
    fails = fails + expect("cb_partial", str(can_break("abc", ["a", "b"])), "false")

    // word_break reconstruction
    fails = fails + expect("wb_leet", joinl(word_break("leetcode", ["leet", "code"])), "leet code")
    fails = fails + expect("wb_apple", joinl(word_break("applepenapple", ["apple", "pen"])), "apple pen apple")
    fails = fails + expect("wb_hashtag", joinl(word_break("thisisahashtag", ["this", "is", "a", "hashtag"])), "this is a hashtag")
    fails = fails + expect("wb_none", str(len(word_break("catsandog", ["cats", "dog", "sand"]))), "0")

    // reconstruction is a valid decomposition (concatenation equals the input)
    let seg = word_break("aaaaaaa", ["a", "aa", "aaa"])
    let joined = ""
    let i = 0
    while i < len(seg)
        joined = joined + seg[i]
        i = i + 1
    fails = fails + expect("wb_valid", joined, "aaaaaaa")

    // domain-splitting style
    let dseg = word_break("bestbuy", ["best", "buy"])
    let dj = ""
    let di = 0
    while di < len(dseg)
        dj = dj + dseg[di]
        di = di + 1
    fails = fails + expect("wb_domain", dj, "bestbuy")

    if fails == 0
        print("forge_wordbreak: all passed")
    else
        print("forge_wordbreak: " + str(fails) + " FAILED")
