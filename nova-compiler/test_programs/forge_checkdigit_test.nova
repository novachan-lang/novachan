import forge_checkdigit

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn expect_false(name: string, cond: bool) -> int
    if cond
        print("FAIL " + name + ": expected false")
        return 1
    0

fn main()
    let fails = 0

    // DAMM: Wikipedia example - check digit for 572 is 4
    fails = fails + expect("damm_572", str(damm_generate("572")), "4")
    fails = fails + expect_true("damm_valid", damm_validate("5724"))
    fails = fails + expect_false("damm_bad_check", damm_validate("5720"))
    // single-digit error detected
    fails = fails + expect_false("damm_typo", damm_validate("5824"))
    // adjacent transposition detected (57 -> 75)
    fails = fails + expect_false("damm_transpose", damm_validate("7524"))
    // generate then validate roundtrip for a longer number
    let dn = "43881234567"
    let dcheck = damm_generate(dn)
    fails = fails + expect_true("damm_roundtrip", damm_validate(dn + str(dcheck)))

    // VERHOEFF: Wikipedia example - check digit for 236 is 3
    fails = fails + expect("verh_236", str(verhoeff_generate("236")), "3")
    fails = fails + expect_true("verh_valid", verhoeff_validate("2363"))
    fails = fails + expect_false("verh_bad_check", verhoeff_validate("2364"))
    // classic Verhoeff example 12345 -> check 1
    fails = fails + expect("verh_12345", str(verhoeff_generate("12345")), "1")
    fails = fails + expect_true("verh_123451", verhoeff_validate("123451"))
    // single-digit error detected
    fails = fails + expect_false("verh_typo", verhoeff_validate("124451"))
    // adjacent transposition detected (23 -> 32)
    fails = fails + expect_false("verh_transpose", verhoeff_validate("3263"))
    // roundtrip
    let vn = "7992739871"
    let vcheck = verhoeff_generate(vn)
    fails = fails + expect_true("verh_roundtrip", verhoeff_validate(vn + str(vcheck)))

    if fails == 0
        print("forge_checkdigit: all passed")
    else
        print("forge_checkdigit: " + str(fails) + " FAILED")
