// Real WASM execution oracle: run a hand-crafted .wasm module from bytecode.
// The module is `(func (export "main") (result i32) i32.const 40 i32.const 2 i32.add)`.
// Oracle: wasm_run must return 42 — only possible if the bytecode is really executed
// (the old stub returned 0).
fn main()
    let m = wasm_compile("add.wasm")
    assert_eq(m >= 0, true)
    let result = wasm_run(m)
    print("wasm_run(add.wasm) = {result}")
    assert_eq(result, 42)
    wasm_free(m)
    print("WASM interpreter test passed: executed 40 + 2 = 42 from bytecode")
