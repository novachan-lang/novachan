// _arena_demo.nova -- NOVA-level proof that per-request memory is FLAT via arena scopes.
//
// Each "request" enters an arena scope, allocates lists + dicts + strings (and a
// reference CYCLE that plain reference counting could never reclaim), then exits the
// scope -- which frees the whole request's heap WHOLESALE. Over 1000 requests the
// live-object count must stay flat. This is the framework-readiness property a
// long-running server needs.

fn build_request_data(n)
    // Simulate a request handler building a response model.
    let items = []
    let i = 0
    while i < n
        let d = {}
        d["id"] = i
        d["name"] = "item-" + str(i)        // arena string
        d["tags"] = [i, i + 1, i + 2]       // arena list
        push(items, d)                       // arena dict into arena list
        i = i + 1
    // A reference CYCLE: a context dict that holds itself. RC can never free this;
    // the arena reclaims it wholesale at scope exit.
    let ctx = {}
    ctx["items"] = items
    ctx["self"] = ctx
    len(items)

fn main()
    let base = live_count()
    let acc = 0
    let r = 0
    while r < 1000
        let prev = arena_enter()             // open the per-request arena
        acc = acc + build_request_data(50)   // everything here lands in the arena
        arena_exit(prev)                     // free the whole request heap wholesale
        r = r + 1
    let delta = live_count() - base
    print("arena_demo: 1000 requests x (50 dicts + lists + strings + a cycle); processed=" + str(acc) + " live_count delta=" + str(delta))
    if delta > 16
        print("ARENA DEMO FAIL: per-request memory is NOT flat (delta=" + str(delta) + ")")
        exit(1)
    print("ARENA DEMO PASS: per-request memory is FLAT (delta=" + str(delta) + ") -- including a reference cycle")
