import prism_ui_skeleton
import prism_node

fn main()
    print("== KAT prism_ui_skeleton ==")
    let mut passed = 0
    let mut failed = 0

    // 1. line happy
    let r1 = prism_ui_skeleton.prism_sk_line(5)
    if is_ok(r1)
        let n = unwrap(r1)
        if prism_node.prism_node_kind_str(n) == "label"
            print("  ok  line_is_label")
            passed += 1
        else
            print("FAIL line_is_label")
            failed += 1
        if prism_node.prism_node_attr_str(n, "text", "") == "_____"
            print("  ok  line_text_5")
            passed += 1
        else
            print("FAIL line_text_5: got '" + prism_node.prism_node_attr_str(n, "text", "") + "'")
            failed += 1
    else
        print("FAIL line_ok: " + unwrap_err(r1))
        failed += 2

    // 2. line width 1
    let r1b = prism_ui_skeleton.prism_sk_line(1)
    if is_ok(r1b)
        if prism_node.prism_node_attr_str(unwrap(r1b), "text", "") == "_"
            print("  ok  line_width_1")
            passed += 1
        else
            print("FAIL line_width_1")
            failed += 1
    else
        print("FAIL line_width_1: " + unwrap_err(r1b))
        failed += 1

    // 3. line error zero
    let r2 = prism_ui_skeleton.prism_sk_line(0)
    if is_err(r2)
        print("  ok  line_err_zero")
        passed += 1
    else
        print("FAIL line_err_zero")
        failed += 1

    // 4. line error negative
    let r3 = prism_ui_skeleton.prism_sk_line(-3)
    if is_err(r3)
        print("  ok  line_err_neg")
        passed += 1
    else
        print("FAIL line_err_neg")
        failed += 1

    // 5. paragraph happy
    let r4 = prism_ui_skeleton.prism_sk_paragraph(3, 10)
    if is_ok(r4)
        let n4 = unwrap(r4)
        if prism_node.prism_node_kind_str(n4) == "stack"
            print("  ok  para_is_stack")
            passed += 1
        else
            print("FAIL para_is_stack")
            failed += 1
        let ch4 = prism_node.prism_node_children(n4)
        if len(ch4) == 3
            print("  ok  para_3_lines")
            passed += 1
        else
            print("FAIL para_3_lines: got " + str(len(ch4)))
            failed += 1
    else
        print("FAIL para_ok: " + unwrap_err(r4))
        failed += 2

    // 6. paragraph errors
    let r5 = prism_ui_skeleton.prism_sk_paragraph(0, 10)
    if is_err(r5)
        print("  ok  para_err_zero_lines")
        passed += 1
    else
        print("FAIL para_err_zero_lines")
        failed += 1

    let r6 = prism_ui_skeleton.prism_sk_paragraph(3, 0)
    if is_err(r6)
        print("  ok  para_err_zero_width")
        passed += 1
    else
        print("FAIL para_err_zero_width")
        failed += 1

    // 7. card happy
    let r7 = prism_ui_skeleton.prism_sk_card(2)
    if is_ok(r7)
        let n7 = unwrap(r7)
        if prism_node.prism_node_kind_str(n7) == "band"
            print("  ok  card_is_band")
            passed += 1
        else
            print("FAIL card_is_band")
            failed += 1
        let ch7 = prism_node.prism_node_children(n7)
        if len(ch7) == 2
            print("  ok  card_2_children")
            passed += 1
        else
            print("FAIL card_2_children: got " + str(len(ch7)))
            failed += 1
        // first is circle placeholder
        if prism_node.prism_node_attr_str(ch7[0], "text", "") == "[O]"
            print("  ok  card_circle_text")
            passed += 1
        else
            print("FAIL card_circle_text")
            failed += 1
        // second is stack of lines
        if prism_node.prism_node_kind_str(ch7[1]) == "stack"
            print("  ok  card_body_is_stack")
            passed += 1
        else
            print("FAIL card_body_is_stack")
            failed += 1
    else
        print("FAIL card_ok: " + unwrap_err(r7))
        failed += 4

    // 8. card error
    let r8 = prism_ui_skeleton.prism_sk_card(0)
    if is_err(r8)
        print("  ok  card_err_zero")
        passed += 1
    else
        print("FAIL card_err_zero")
        failed += 1

    // 9. list happy
    let r9 = prism_ui_skeleton.prism_sk_list(4, 15)
    if is_ok(r9)
        let n9 = unwrap(r9)
        if prism_node.prism_node_kind_str(n9) == "stack"
            print("  ok  list_is_stack")
            passed += 1
        else
            print("FAIL list_is_stack")
            failed += 1
        let ch9 = prism_node.prism_node_children(n9)
        if len(ch9) == 4
            print("  ok  list_4_items")
            passed += 1
        else
            print("FAIL list_4_items: got " + str(len(ch9)))
            failed += 1
    else
        print("FAIL list_ok: " + unwrap_err(r9))
        failed += 2

    // 10. list errors
    let r10 = prism_ui_skeleton.prism_sk_list(0, 10)
    if is_err(r10)
        print("  ok  list_err_zero_count")
        passed += 1
    else
        print("FAIL list_err_zero_count")
        failed += 1

    let r11 = prism_ui_skeleton.prism_sk_list(3, 0)
    if is_err(r11)
        print("  ok  list_err_zero_width")
        passed += 1
    else
        print("FAIL list_err_zero_width")
        failed += 1

    print("== " + str(passed) + " passed, " + str(failed) + " failed ==")
    if failed > 0
        exit(1)
