// KAT test for std/data/csvschema
import std/data/csvschema

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + got + " expected " + expected)
        exit(1)

fn main()
    // Build the CSV text using chr(10) for newlines.
    let nl = chr(10)
    let s = "id,name,score,active" + nl + "1,alice,9.5,true" + nl + "2,bob,8.0,false"

    let sch = cs_infer(s)

    // KAT 1: numeric id column -> int
    cks("id_type", sch["id"], "int")

    // KAT 2: name column with strings -> string
    cks("name_type", sch["name"], "string")

    // KAT 3: score column with floats (9.5, 8.0) -> float
    cks("score_type", sch["score"], "float")

    // KAT 4: active column (true/false) -> bool
    cks("active_type", sch["active"], "bool")

    // KAT 5: cs_is_int("42") -> 1
    cki("is_int_42", cs_is_int("42"), 1)

    // KAT 6: cs_is_int("4.2") -> 0
    cki("is_int_4.2", cs_is_int("4.2"), 0)

    // KAT 7: cs_is_float("4.2") -> 1
    cki("is_float_4.2", cs_is_float("4.2"), 1)

    // KAT 8: cs_coerce("42","int") -> 42
    let coerced = cs_coerce("42", "int")
    cki("coerce_int", coerced, 42)

    // KAT 9: cs_is_int with negative integer
    cki("is_int_neg", cs_is_int("-7"), 1)

    // KAT 10: cs_is_float with plain integer is also float-valid
    cki("is_float_int", cs_is_float("100"), 1)

    // KAT 11: cs_is_float rejects non-numeric
    cki("is_float_str", cs_is_float("abc"), 0)

    // KAT 12: bool column with yes/no
    let nl2 = chr(10)
    let s2 = "flag" + nl2 + "yes" + nl2 + "no" + nl2 + "yes"
    let sch2 = cs_infer(s2)
    cks("bool_yes_no", sch2["flag"], "bool")

    // KAT 13: all-int column stays int, not bool (0/1 are ints, not bool words)
    let s3 = "bits" + nl2 + "0" + nl2 + "1" + nl2 + "0"
    let sch3 = cs_infer(s3)
    cks("bits_int_not_bool", sch3["bits"], "int")

    // KAT 14: mixed int and float -> float
    let s4 = "val" + nl2 + "3" + nl2 + "3.14" + nl2 + "2"
    let sch4 = cs_infer(s4)
    cks("mixed_float", sch4["val"], "float")

    print("_csvschema_test passed")
