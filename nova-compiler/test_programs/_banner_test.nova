import std/text/banner

fn main()
    // KAT 1: ban_repeat_line basic
    let r1 = ban_repeat_line("=", 5)
    if r1 != "====="
        print("FAIL ban_repeat_line('=',5): got " + r1)
        exit(1)

    // KAT 2: ban_repeat_line zero
    let r2 = ban_repeat_line("*", 0)
    if r2 != ""
        print("FAIL ban_repeat_line('*',0): got " + r2)
        exit(1)

    // KAT 3: ban_border produces 3 lines
    let b = ban_border("hi")
    let lines = split(b, chr(10))
    if len(lines) != 3
        print("FAIL ban_border line count: got " + str(len(lines)))
        exit(1)

    // KAT 4: ban_border line1 == "======" (len("hi")+4 = 6)
    let line1 = lines[0]
    if line1 != "======"
        print("FAIL ban_border line1: got " + line1)
        exit(1)

    // KAT 5: ban_border line2 == "= hi ="
    let line2 = lines[1]
    if line2 != "= hi ="
        print("FAIL ban_border line2: got " + line2)
        exit(1)

    // KAT 6: ban_border line3 == line1
    let line3 = lines[2]
    if line3 != line1
        print("FAIL ban_border line3 != line1: got " + line3)
        exit(1)

    // KAT 7: ban_center even padding
    let c1 = ban_center("hi", 6, " ")
    if c1 != "  hi  "
        print("FAIL ban_center('hi',6,' '): got '" + c1 + "'")
        exit(1)

    // KAT 8: ban_center with fill char, odd total -> extra on right
    let c2 = ban_center("abc", 5, "*")
    if c2 != "*abc*"
        print("FAIL ban_center('abc',5,'*'): got '" + c2 + "'")
        exit(1)

    // KAT 9: ban_center no-op when text >= width
    let c3 = ban_center("hello", 3, "-")
    if c3 != "hello"
        print("FAIL ban_center no-op: got '" + c3 + "'")
        exit(1)

    // KAT 10: ban_center odd padding (extra goes right)
    let c4 = ban_center("x", 4, "-")
    if c4 != "-x--"
        print("FAIL ban_center('x',4,'-'): got '" + c4 + "'")
        exit(1)

    print("_banner_test passed")
