import std/text/bbcode_validate

fn main()
    // KAT 1: simple valid nesting
    let v1 = bval_validate("[b]hi[/b]")
    if v1 != 1
        print("FAIL bbcode_validate KAT1: expected valid, got " + str(v1))
        exit(1)
    let e1 = bval_errors("[b]hi[/b]")
    if len(e1) != 0
        print("FAIL bbcode_validate KAT1b: expected no errors, got " + str(len(e1)))
        exit(1)

    // KAT 2: unclosed tag -> "unclosed [b] at position 5"
    let v2 = bval_validate("hello[b]")
    if v2 != 0
        print("FAIL bbcode_validate KAT2: expected invalid, got " + str(v2))
        exit(1)
    let e2 = bval_errors("hello[b]")
    if len(e2) != 1
        print("FAIL bbcode_validate KAT2b: expected 1 error, got " + str(len(e2)))
        exit(1)
    if e2[0] != "unclosed [b] at position 5"
        print("FAIL bbcode_validate KAT2c: got [" + e2[0] + "]")
        exit(1)

    // KAT 3: crossing/mismatched close tags
    let v3 = bval_validate("[b][i]text[/b][/i]")
    if v3 != 0
        print("FAIL bbcode_validate KAT3: expected invalid, got " + str(v3))
        exit(1)
    let e3 = bval_errors("[b][i]text[/b][/i]")
    if len(e3) != 2
        print("FAIL bbcode_validate KAT3b: expected 2 errors, got " + str(len(e3)))
        exit(1)
    if e3[0] != "unclosed [i] at position 3"
        print("FAIL bbcode_validate KAT3c: got [" + e3[0] + "]")
        exit(1)
    if e3[1] != "unexpected [/i] at position 14"
        print("FAIL bbcode_validate KAT3d: got [" + e3[1] + "]")
        exit(1)

    // KAT 4: [*] is self-closing — a well-formed list is valid without [/*]
    let v4 = bval_validate("[list][*]a[*]b[/list]")
    if v4 != 1
        print("FAIL bbcode_validate KAT4: expected valid, got " + str(v4))
        exit(1)

    // KAT 5: empty input is valid
    let v5 = bval_validate("")
    if v5 != 1
        print("FAIL bbcode_validate KAT5: expected valid, got " + str(v5))
        exit(1)

    // KAT 6: plain text with no tags at all is valid
    let v6 = bval_validate("plain text no tags")
    if v6 != 1
        print("FAIL bbcode_validate KAT6: expected valid, got " + str(v6))
        exit(1)

    // KAT 7: a lone unmatched closing tag
    let v7 = bval_validate("[/b]")
    if v7 != 0
        print("FAIL bbcode_validate KAT7: expected invalid, got " + str(v7))
        exit(1)
    let e7 = bval_errors("[/b]")
    if len(e7) != 1
        print("FAIL bbcode_validate KAT7b: expected 1 error, got " + str(len(e7)))
        exit(1)
    if e7[0] != "unexpected [/b] at position 0"
        print("FAIL bbcode_validate KAT7c: got [" + e7[0] + "]")
        exit(1)

    // KAT 8: an unterminated '[' with no ']' anywhere is not a tag -> valid
    let v8 = bval_validate("abc [not closed at all")
    if v8 != 1
        print("FAIL bbcode_validate KAT8: expected valid, got " + str(v8))
        exit(1)

    // KAT 9: properly nested different tag types
    let v9 = bval_validate("[quote][b]hi[/b]bye[/quote]")
    if v9 != 1
        print("FAIL bbcode_validate KAT9: expected valid, got " + str(v9))
        exit(1)

    // KAT 10: unclosed parameterized tag preserves the raw "[name=value]" text
    let v10 = bval_validate("[color=red]x")
    if v10 != 0
        print("FAIL bbcode_validate KAT10: expected invalid, got " + str(v10))
        exit(1)
    let e10 = bval_errors("[color=red]x")
    if len(e10) != 1
        print("FAIL bbcode_validate KAT10b: expected 1 error, got " + str(len(e10)))
        exit(1)
    if e10[0] != "unclosed [color=red] at position 0"
        print("FAIL bbcode_validate KAT10c: got [" + e10[0] + "]")
        exit(1)

    // KAT 11: tag names are matched case-insensitively
    let v11 = bval_validate("[B]hi[/b]")
    if v11 != 1
        print("FAIL bbcode_validate KAT11: expected valid, got " + str(v11))
        exit(1)

    print("PASS _bbcode_validate_test")
