fn might_fail(flag)
    if flag == 0
        return err("something went wrong")
    return ok(flag * 10)

fn middle(flag)
    let v = might_fail(flag)?
    return ok(v + 1)

fn outer(flag)
    let n = middle(flag)?
    return ok("got " + str(n))

fn main()
    let r1 = outer(5)
    match r1
        Ok(msg) => assert_eq(msg, "got 51")
        Err(e) => print("FAIL: expected Ok, got Err: " + e)
    print("ok path: " + str(r1))

    let r2 = outer(0)
    match r2
        Ok(msg) => print("FAIL: expected Err, got Ok: " + msg)
        Err(e) =>
            print("err msg: " + e)
            assert_eq(contains(e, "something went wrong"), true)
            assert_eq(contains(e, "middle"), true)
            assert_eq(contains(e, "outer"), true)

    let direct = might_fail(0)
    match direct
        Ok(v) => print("FAIL: expected Err")
        Err(e) => assert_eq(e, "something went wrong")
    print("direct err (no context wrapping): " + str(direct))

    print("ALL ERROR CONTEXT TESTS PASSED")
