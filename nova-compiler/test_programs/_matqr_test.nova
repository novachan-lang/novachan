import std/matrix/matqr

// Float tolerance check.
fn _ckf(label: string, got: float, want: float, tol: float)
    let diff = got - want
    if diff < 0.0
        diff = 0.0 - diff
    if diff > tol
        print("FAIL matqr " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// Bool check.
fn _ckb(label: string, got: bool, want: bool)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL matqr " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

// Build a 2x2 float matrix from four values.
fn _mat2(a: float, b: float, c: float, d: float) -> dict
    let data = []
    push(data, a)
    push(data, b)
    push(data, c)
    push(data, d)
    mqr_make(2, 2, data)

// Build a 3x3 float matrix from nine values (row-major).
fn _mat3(a00: float, a01: float, a02: float, a10: float, a11: float, a12: float, a20: float, a21: float, a22: float) -> dict
    let data = []
    push(data, a00)
    push(data, a01)
    push(data, a02)
    push(data, a10)
    push(data, a11)
    push(data, a12)
    push(data, a20)
    push(data, a21)
    push(data, a22)
    mqr_make(3, 3, data)

// Build a 3x2 float matrix (3 rows, 2 cols) row-major.
fn _mat32(a00: float, a01: float, a10: float, a11: float, a20: float, a21: float) -> dict
    let data = []
    push(data, a00)
    push(data, a01)
    push(data, a10)
    push(data, a11)
    push(data, a20)
    push(data, a21)
    mqr_make(3, 2, data)

fn main()
    let tol = 0.0001

    // ── 2x2 test: A = [[1,1],[1,0]] ───────────────────────────────────────────
    let a2 = _mat2(1.0, 1.0, 1.0, 0.0)
    let qr2 = mqr_decompose(a2)
    let Q2 = mqr_q(qr2)
    let R2 = mqr_r(qr2)

    // Q*R == A.
    let ok_qr2 = mqr_verify(a2, tol)
    _ckb("verify_2x2", ok_qr2, true)

    // Q^T * Q == I (orthonormal columns).
    let ok_orth2 = mqr_is_orthogonal(Q2, tol)
    _ckb("orth_2x2", ok_orth2, true)

    // R must be upper-triangular: R[1][0] == 0.
    let r10 = mqr_get(R2, 1, 0)
    _ckf("R_upper_tri", r10, 0.0, tol)

    // R diagonal must be non-negative (convention of QR).
    // (Just check R[0][0] > 0 and R[1][1] > 0.)
    let r00 = mqr_get(R2, 0, 0)
    let r11 = mqr_get(R2, 1, 1)
    if r00 < 0.0 - tol
        print("FAIL matqr R00_positive: " + str(r00))
        exit(1)
    if r11 < 0.0 - tol
        print("FAIL matqr R11_positive: " + str(r11))
        exit(1)

    // mqr_reconstruct gives back A.
    let rec2 = mqr_reconstruct(qr2)
    _ckf("recon_00", mqr_get(rec2, 0, 0), 1.0, tol)
    _ckf("recon_01", mqr_get(rec2, 0, 1), 1.0, tol)
    _ckf("recon_10", mqr_get(rec2, 1, 0), 1.0, tol)
    _ckf("recon_11", mqr_get(rec2, 1, 1), 0.0, tol)

    // ── 3x3 test: A = [[1,2,3],[0,1,4],[5,6,0]] ──────────────────────────────
    let a3 = _mat3(1.0, 2.0, 3.0, 0.0, 1.0, 4.0, 5.0, 6.0, 0.0)
    let qr3 = mqr_decompose(a3)
    let Q3 = mqr_q(qr3)

    // Q*R == A.
    let ok_qr3 = mqr_verify(a3, tol)
    _ckb("verify_3x3", ok_qr3, true)

    // Q^T * Q == I.
    let ok_orth3 = mqr_is_orthogonal(Q3, tol)
    _ckb("orth_3x3", ok_orth3, true)

    // R upper-triangular.
    let R3 = mqr_r(qr3)
    _ckf("R3_10", mqr_get(R3, 1, 0), 0.0, tol)
    _ckf("R3_20", mqr_get(R3, 2, 0), 0.0, tol)
    _ckf("R3_21", mqr_get(R3, 2, 1), 0.0, tol)

    // ── 3x2 overdetermined test ───────────────────────────────────────────────
    // A = [[1,1],[1,0],[0,1]]: 3 rows, 2 cols.
    let a32 = _mat32(1.0, 1.0, 1.0, 0.0, 0.0, 1.0)
    let qr32 = mqr_decompose(a32)

    // Q*R == A (round-trip).
    let ok_qr32 = mqr_verify(a32, tol)
    _ckb("verify_3x2", ok_qr32, true)

    // Q32 columns orthonormal.
    let Q32 = mqr_q(qr32)
    let ok_orth32 = mqr_is_orthogonal(Q32, tol)
    _ckb("orth_3x2", ok_orth32, true)

    // R32 upper-triangular.
    let R32 = mqr_r(qr32)
    _ckf("R32_10", mqr_get(R32, 1, 0), 0.0, tol)

    // ── mqr_solve: A x = b for 2x2 square ────────────────────────────────────
    // A = [[4,3],[6,3]], b = [10,12] -> x = [1,2]
    let a_sq = _mat2(4.0, 3.0, 6.0, 3.0)
    let b_sq = []
    push(b_sq, 10.0)
    push(b_sq, 12.0)
    let x_sq = mqr_solve(a_sq, b_sq)
    _ckf("solve_x0", x_sq[0] * 1.0, 1.0, tol)
    _ckf("solve_x1", x_sq[1] * 1.0, 2.0, tol)

    // ── mqr_gram_schmidt: orthonormalize [[1,0],[1,0]] (dependent) ────────────
    let v1 = []
    push(v1, 1.0)
    push(v1, 0.0)
    let v2 = []
    push(v2, 1.0)
    push(v2, 0.0)
    let vecs = []
    push(vecs, v1)
    push(vecs, v2)
    let gs = mqr_gram_schmidt(vecs)
    // First vector must be normalized.
    let gs0 = gs[0]
    let n0 = 0.0
    let gi = 0
    while gi < len(gs0)
        let val = gs0[gi] * 1.0
        n0 = n0 + val * val
        gi = gi + 1
    let len0 = sqrt(n0)
    _ckf("gs_norm0", len0, 1.0, tol)
    // Second vector must be zero (linearly dependent).
    let gs1 = gs[1]
    let n1 = 0.0
    let gi2 = 0
    while gi2 < len(gs1)
        let val2 = gs1[gi2] * 1.0
        n1 = n1 + val2 * val2
        gi2 = gi2 + 1
    _ckf("gs_dep_zero", n1, 0.0, tol)

    // ── mqr_gram_schmidt: orthonormalize two independent 2-vectors ─────────────
    let u1 = []
    push(u1, 3.0)
    push(u1, 4.0)
    let u2 = []
    push(u2, 1.0)
    push(u2, 0.0)
    let uvecs = []
    push(uvecs, u1)
    push(uvecs, u2)
    let gs2 = mqr_gram_schmidt(uvecs)
    // Both output vectors must be unit length.
    let gs2_0 = gs2[0]
    let gn0 = 0.0
    let gi3 = 0
    while gi3 < len(gs2_0)
        let val3 = gs2_0[gi3] * 1.0
        gn0 = gn0 + val3 * val3
        gi3 = gi3 + 1
    let gln0 = sqrt(gn0)
    _ckf("gs2_norm0", gln0, 1.0, tol)
    let gs2_1 = gs2[1]
    let gn1 = 0.0
    let gi4 = 0
    while gi4 < len(gs2_1)
        let val4 = gs2_1[gi4] * 1.0
        gn1 = gn1 + val4 * val4
        gi4 = gi4 + 1
    let gln1 = sqrt(gn1)
    _ckf("gs2_norm1", gln1, 1.0, tol)
    // Outputs must be orthogonal.
    let gorth = 0.0
    let gi5 = 0
    while gi5 < len(gs2_0)
        gorth = gorth + gs2_0[gi5] * 1.0 * (gs2_1[gi5] * 1.0)
        gi5 = gi5 + 1
    _ckf("gs2_orth", gorth, 0.0, tol)

    print("PASS _matqr_test")
