import std/geometry/cg_rotating_calipers

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + ": length mismatch")
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL " + label + ": index " + str(i) + " got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // KAT 1: square [0,0],[2,0],[2,2],[0,2] — diagonal is sqrt(8), so diameter_sq=8
    let sq = [[0, 0], [2, 0], [2, 2], [0, 2]]
    cki("diameter_sq(square)", cgr_diameter_sq(sq), 8)

    // KAT 2: 3-4-5 right triangle — hypotenuse sq = 3^2+4^2 = 25
    let tri = [[0, 0], [3, 0], [0, 4]]
    cki("diameter_sq(3-4-5)", cgr_diameter_sq(tri), 25)

    // KAT 3: two-point segment
    let seg = [[0, 0], [5, 0]]
    cki("diameter_sq(segment)", cgr_diameter_sq(seg), 25)

    // KAT 4: closest pair of square corners — adjacent = dist^2 4
    cki("closest_pair_sq(square)", cgr_closest_pair_sq(sq), 4)

    // KAT 5: farthest pair of square — should be a diagonal pair (dist^2 = 8)
    let fp = cgr_farthest_pair(sq)
    // Verify the indices give distance^2 == 8
    let pi = sq[fp[0]]
    let pj = sq[fp[1]]
    let dx = pi[0] - pj[0]
    let dy = pi[1] - pj[1]
    cki("farthest_pair(square) dist^2", dx * dx + dy * dy, 8)

    // KAT 6: farthest pair indices are distinct and ordered i < j
    ckb("farthest_pair i<j", fp[0] < fp[1], true)

    // KAT 7: single point — diameter 0
    let single = [[3, 7]]
    cki("diameter_sq(single)", cgr_diameter_sq(single), 0)

    // KAT 8: empty poly — diameter 0
    let empty = []
    cki("diameter_sq(empty)", cgr_diameter_sq(empty), 0)

    // KAT 9: closest pair on the 3-4-5 triangle
    // edges: (0,0)-(3,0)=9, (0,0)-(0,4)=16, (3,0)-(0,4)=25 -> closest=9
    cki("closest_pair_sq(3-4-5)", cgr_closest_pair_sq(tri), 9)

    // KAT 10: collinear three points — closest sq = 1
    let col = [[0, 0], [1, 0], [3, 0]]
    cki("closest_pair_sq(collinear)", cgr_closest_pair_sq(col), 1)

    // KAT 11: farthest pair on segment [0,0],[5,0] = [0,1]
    let fp2 = cgr_farthest_pair(seg)
    let ax = seg[fp2[0]]
    let bx = seg[fp2[1]]
    let ddx = ax[0] - bx[0]
    let ddy = ax[1] - bx[1]
    cki("farthest_pair(seg) dist^2", ddx * ddx + ddy * ddy, 25)

    print("PASS _cg_rotating_calipers_test")
