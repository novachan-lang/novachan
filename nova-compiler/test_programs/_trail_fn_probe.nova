fn apply(items: list, f) -> list
    let out = []
    for x in items
        push(out, f(x))
    out

fn each(items: list, f)
    for x in items
        f(x)

fn fold(items: list, init: int, f) -> int
    let acc = init
    for x in items
        acc = f(acc, x)
    acc

fn main()
    let data = [1, 2, 3, 4, 5]

    let doubled = apply(data) fn(x)
        x * 2
    assert_eq(doubled, [2, 4, 6, 8, 10])

    let total = fold(data, 0) fn(acc, x)
        acc + x
    assert_eq(total, 15)

    let squares = apply([10, 20, 30]) fn(n)
        let sq = n * n
        sq
    assert_eq(squares, [100, 400, 900])

    let factor = 3
    let scaled = apply(data) fn(x)
        x * factor
    assert_eq(scaled, [3, 6, 9, 12, 15])

    let offset = 100
    let transformed = apply(data) fn(x)
        let base = x * 10
        base + offset
    assert_eq(transformed, [110, 120, 130, 140, 150])

    let product = fold([2, 3, 4], 1) fn(acc, x)
        let step = acc * x
        step
    assert_eq(product, 24)

    let result = apply(["hello", "world"]) fn(s)
        upper(s)
    assert_eq(result, ["HELLO", "WORLD"])

    print("trail_fn_probe: all passed")
