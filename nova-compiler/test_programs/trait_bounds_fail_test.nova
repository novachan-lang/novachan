// This should fail: Color does not implement Printable

trait Printable
    fn show(self) -> string

type Point : Printable
    x: int
    y: int

fn Point__show(self: Point) -> string
    return "(" + str(self.x) + ", " + str(self.y) + ")"

type Color
    r: int
    g: int
    b: int

fn<T: Printable> display(item: T) -> string
    return "shown"

fn main()
    let c = Color(255, 0, 0)
    let s = display(c)
    print(s)
