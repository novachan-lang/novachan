// GAP 5 concurrency path: a top-level `let hub = channel()` is baked, and a spawned
// task reaches it. This is the exact shape that RACED before the capture-exclusion fix:
// a lambda that captured a baked var slot_load'd a non-existent slot (garbage) and
// make_closure ref-counted that garbage -> heap corruption / hang. Now the closure
// loads hub via const_get and never captures it. Tests BOTH a named-fn spawn and a
// lambda spawn.

let hub = channel()
let hub2 = channel()

fn producer()
    send(hub, 7)

fn main() -> int
    let fails = 0

    // named-function spawn reads the baked channel (const_get, no capture)
    spawn producer()
    let got = receive(hub)
    if got != 7
        print("FAIL named-fn spawn got=" + str(got))
        fails = fails + 1

    // lambda spawn CAPTURES nothing for hub2 (baked) -> loads via const_get, no garbage
    spawn fn()
        send(hub2, 9)
    let got2 = receive(hub2)
    if got2 != 9
        print("FAIL lambda spawn got=" + str(got2))
        fails = fails + 1

    if fails == 0
        print("PASS _kat_module_chan")
    else
        print("FAILED _kat_module_chan")
    return 0
