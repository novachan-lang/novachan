// yamlx.nova — YAML parser (subset: mappings, sequences, scalars, nested blocks)
// Returns dict<string, any> — nested dicts for mappings, lists for sequences.

fn _yaml_is_ws(c: string) -> int
    return c == " " or c == "\t"

fn _yaml_indent(line: string) -> int
    let i = 0
    while i < len(line) and _yaml_is_ws(line[i:i + 1])
        i = i + 1
    return i

fn _yaml_trim(s: string) -> string
    return trim(s)

fn _yaml_strip_comment(line: string) -> string
    let in_str = 0
    let i = 0
    while i < len(line)
        let c = line[i:i + 1]
        if c == chr(34) or c == "'"
            in_str = 1 - in_str
        if c == "#" and in_str == 0
            return trim(line[0:i])
        i = i + 1
    return line

fn _yaml_parse_scalar(s: string)
    let v = _yaml_trim(s)
    let box = []
    if v == "true" or v == "True" or v == "TRUE"
        push(box, 1)
        return box[0]
    if v == "false" or v == "False" or v == "FALSE"
        push(box, 0)
        return box[0]
    if v == "null" or v == "Null" or v == "NULL" or v == "~"
        push(box, "")
        return box[0]
    let dq = chr(34)
    if len(v) >= 2 and v[0:1] == dq and v[len(v) - 1:len(v)] == dq
        push(box, v[1:len(v) - 1])
        return box[0]
    if len(v) >= 2 and v[0:1] == "'" and v[len(v) - 1:len(v)] == "'"
        push(box, v[1:len(v) - 1])
        return box[0]
    let is_num = 1
    let has_dot = 0
    let ni = 0
    if len(v) > 0 and (v[0:1] == "-" or v[0:1] == "+")
        ni = 1
    while ni < len(v)
        let nc = v[ni:ni + 1]
        if nc == "."
            has_dot = 1
        else if ord(nc) < 48 or ord(nc) > 57
            is_num = 0
        ni = ni + 1
    if is_num and len(v) > 0 and (ni > 0 or v[0:1] != "-")
        if has_dot
            push(box, float(v))
            return box[0]
        push(box, int(v))
        return box[0]
    push(box, v)
    return box[0]

fn parse_yaml(text: string) -> dict
    let result = {}
    let lines = split(text, "\n")
    let n = len(lines)
    let i = 0
    while i < n
        let line = _yaml_strip_comment(lines[i])
        let indent = _yaml_indent(line)
        let content = _yaml_trim(line)
        if content == "" or content[0:1] == "#" or content == "---" or content == "..."
            i = i + 1
            continue
        // key: value
        let colon = 0
        let found_colon = 0
        while colon < len(content) and found_colon == 0
            if content[colon:colon + 1] == ":"
                if colon + 1 >= len(content) or content[colon + 1:colon + 2] == " "
                    found_colon = 1
                else
                    colon = colon + 1
            else
                colon = colon + 1
        if found_colon
            let key = _yaml_trim(content[0:colon])
            let val_str = ""
            if colon + 1 < len(content)
                val_str = _yaml_trim(content[colon + 1:len(content)])
            if val_str == ""
                // Possible nested block — check next lines for sequence or mapping
                let sub_lines = []
                let j = i + 1
                while j < n
                    let sl = lines[j]
                    let si = _yaml_indent(sl)
                    let sc = _yaml_trim(sl)
                    if sc == "" or sc[0:1] == "#"
                        j = j + 1
                        continue
                    if si <= indent
                        break
                    push(sub_lines, sl)
                    j = j + 1
                if len(sub_lines) > 0 and _yaml_trim(sub_lines[0])[0:1] == "-"
                    // Sequence
                    let seq = []
                    for sl in sub_lines
                        let sc = _yaml_trim(sl)
                        if sc[0:1] == "-"
                            push(seq, _yaml_parse_scalar(sc[1:len(sc)]))
                    result[key] = seq
                else if len(sub_lines) > 0
                    // Nested mapping — flatten with dot notation
                    let sub_text = join(sub_lines, "\n")
                    let sub = parse_yaml(sub_text)
                    for sk in keys(sub)
                        result[key + "." + sk] = sub[sk]
                else
                    result[key] = ""
                i = j
                continue
            else if val_str[0:1] == "[" and val_str[len(val_str) - 1:len(val_str)] == "]"
                // Flow sequence
                let inner = val_str[1:len(val_str) - 1]
                let items = split(inner, ",")
                let seq = []
                for item in items
                    push(seq, _yaml_parse_scalar(item))
                result[key] = seq
            else
                result[key] = _yaml_parse_scalar(val_str)
        i = i + 1
    result

fn yaml_get(d: dict, key: string)
    if contains(d, key)
        return d[key]
    return ""

// ── Tests ──────────────────────────────────────────────────────────────────

fn main()
    let dq = chr(34)

    // Basic key-value
    let t1 = parse_yaml("name: NOVA\nversion: 1")
    assert(yaml_get(t1, "name") == "NOVA", "basic string")
    assert(yaml_get(t1, "version") == 1, "basic int")

    // Booleans
    let t2 = parse_yaml("debug: true\nverbose: false")
    assert(yaml_get(t2, "debug") == 1, "bool true")
    assert(yaml_get(t2, "verbose") == 0, "bool false")

    // Null
    let t3 = parse_yaml("empty: null\ntilde: ~")
    assert(yaml_get(t3, "empty") == "", "null")
    assert(yaml_get(t3, "tilde") == "", "tilde null")

    // Quoted strings
    let t4 = parse_yaml("msg: " + dq + "hello world" + dq)
    assert(yaml_get(t4, "msg") == "hello world", "quoted string")

    // Float
    let t5 = parse_yaml("pi: 3.14")
    assert(yaml_get(t5, "pi") == 3.14, "float")

    // Negative int
    let t6 = parse_yaml("offset: -42")
    assert(yaml_get(t6, "offset") == -42, "negative int")

    // Comments
    let t7 = parse_yaml("key: value # comment\n# full line comment\nkey2: 42")
    assert(yaml_get(t7, "key") == "value", "strip comment")
    assert(yaml_get(t7, "key2") == 42, "skip comment line")

    // Flow sequence
    let t8 = parse_yaml("ports: [80, 443, 8080]")
    let ports = yaml_get(t8, "ports")
    assert(len(ports) == 3, "flow seq len")
    assert(ports[0] == 80, "flow seq 0")
    assert(ports[2] == 8080, "flow seq 2")

    // Block sequence
    let t9 = parse_yaml("items:\n  - one\n  - two\n  - three")
    let items = yaml_get(t9, "items")
    assert(len(items) == 3, "block seq len")
    assert(items[0] == "one", "block seq 0")
    assert(items[1] == "two", "block seq 1")
    assert(items[2] == "three", "block seq 2")

    // Nested mapping (flattened with dots)
    let t10 = parse_yaml("server:\n  host: localhost\n  port: 8080")
    assert(yaml_get(t10, "server.host") == "localhost", "nested host")
    assert(yaml_get(t10, "server.port") == 8080, "nested port")

    // Document markers
    let t11 = parse_yaml("---\nkey: val\n...")
    assert(yaml_get(t11, "key") == "val", "doc markers")

    // Empty lines
    let t12 = parse_yaml("\n\nkey: val\n\n")
    assert(yaml_get(t12, "key") == "val", "empty lines")

    print("yamlx: all passed")
