// Wave-C #7: PG CommandComplete row-count parse (libpq PQcmdTuples equivalent). Offline pure-fn KAT.
import forge_pg

fn main()
    if pg_cmd_affected("INSERT 0 5") != 5
        print("FAIL insert: " + str(pg_cmd_affected("INSERT 0 5")))
        exit(1)
    if pg_cmd_affected("UPDATE 3") != 3
        print("FAIL update")
        exit(1)
    if pg_cmd_affected("DELETE 2") != 2
        print("FAIL delete")
        exit(1)
    if pg_cmd_affected("SELECT 10") != 10
        print("FAIL select")
        exit(1)
    if pg_cmd_affected("INSERT 0 1") != 1
        print("FAIL insert1")
        exit(1)
    if pg_cmd_affected("MOVE 7") != 7
        print("FAIL move")
        exit(1)
    if pg_cmd_affected("CREATE TABLE") != 0
        print("FAIL ddl-create")
        exit(1)
    if pg_cmd_affected("BEGIN") != 0
        print("FAIL begin")
        exit(1)
    if pg_cmd_affected("DELETE 0") != 0
        print("FAIL delete0")
        exit(1)
    print("PASS _pg_affected_test")
