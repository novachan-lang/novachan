import std/net/stun
import std/net/ip

fn main()
    // ── Vector 1: Binding Request header, RFC 5769 §2.1 sample txn-id ─────────
    // 00 01 00 00 21 12 A4 42 B7 E7 A7 01 BC 34 D6 86 FA 87 DF AE
    let txn_id = bytes(12)
    bytes_set(txn_id, 0, 0xB7)
    bytes_set(txn_id, 1, 0xE7)
    bytes_set(txn_id, 2, 0xA7)
    bytes_set(txn_id, 3, 0x01)
    bytes_set(txn_id, 4, 0xBC)
    bytes_set(txn_id, 5, 0x34)
    bytes_set(txn_id, 6, 0xD6)
    bytes_set(txn_id, 7, 0x86)
    bytes_set(txn_id, 8, 0xFA)
    bytes_set(txn_id, 9, 0x87)
    bytes_set(txn_id, 10, 0xDF)
    bytes_set(txn_id, 11, 0xAE)

    let hdr = stun_encode(STUN_BINDING_REQUEST(), txn_id, [])
    if bytes_len(hdr) != 20
        print("FAIL v1 hdr len: got "+str(bytes_len(hdr))+" want 20")
        exit(1)
    let want_hdr_hex = [0x00, 0x01, 0x00, 0x00, 0x21, 0x12, 0xA4, 0x42, 0xB7, 0xE7, 0xA7, 0x01, 0xBC, 0x34, 0xD6, 0x86, 0xFA, 0x87, 0xDF, 0xAE]
    let i1 = 0
    while i1 < 20
        let got_b = bytes_get(hdr, i1)
        let want_b = want_hdr_hex[i1]
        if got_b != want_b
            print("FAIL v1 hdr byte["+str(i1)+"]: got "+str(got_b)+" want "+str(want_b))
            exit(1)
        i1 = i1 + 1

    // Message-Type constants sanity
    if STUN_BINDING_REQUEST() != 0x0001
        print("FAIL const BINDING_REQUEST")
        exit(1)
    if STUN_BINDING_SUCCESS_RESPONSE() != 0x0101
        print("FAIL const BINDING_SUCCESS_RESPONSE")
        exit(1)
    if STUN_MAGIC_COOKIE() != 0x2112A442
        print("FAIL const MAGIC_COOKIE")
        exit(1)

    // ── Vector 2: XOR-MAPPED-ADDRESS for 192.168.1.1:32853 ─────────────────────
    // port 32853 = 0x8055; 0x8055 XOR 0x2112 = 0xA147
    // addr 192.168.1.1 = 0xC0A80101; 0xC0A80101 XOR 0x2112A442 = 0xE1BAA543
    let addr_v2 = ipv4_parse("192.168.1.1")
    if addr_v2 != 0xC0A80101
        print("FAIL v2 ipv4_parse: got "+str(addr_v2)+" want "+str(0xC0A80101))
        exit(1)
    let xma = stun_attr_xor_mapped_address_encode(32853, addr_v2)
    if bytes_len(xma) != 8
        print("FAIL v2 xma len: got "+str(bytes_len(xma))+" want 8")
        exit(1)
    let want_xma = [0x00, 0x01, 0xA1, 0x47, 0xE1, 0xBA, 0xA5, 0x43]
    let i2 = 0
    while i2 < 8
        let got2 = bytes_get(xma, i2)
        let want2 = want_xma[i2]
        if got2 != want2
            print("FAIL v2 xma byte["+str(i2)+"]: got "+str(got2)+" want "+str(want2))
            exit(1)
        i2 = i2 + 1

    // Decode it back: must recover port=32853, ip="192.168.1.1"
    let dec_xma = stun_attr_xor_mapped_address_decode(xma)
    if contains(dec_xma, "port") == false
        print("FAIL v2 decode: missing port key")
        exit(1)
    let got_port2 = dec_xma["port"]
    if got_port2 != 32853
        print("FAIL v2 decode port: got "+str(got_port2)+" want 32853")
        exit(1)
    let got_ip2 = dec_xma["ip"]
    if got_ip2 != "192.168.1.1"
        print("FAIL v2 decode ip: got "+got_ip2+" want 192.168.1.1")
        exit(1)
    let got_fam2 = dec_xma["family"]
    if got_fam2 != 0x01
        print("FAIL v2 decode family: got "+str(got_fam2)+" want 1")
        exit(1)

    // XOR-MAPPED-ADDRESS decode on too-short value returns {}
    let short_xma = bytes(4)
    let dec_short_xma = stun_attr_xor_mapped_address_decode(short_xma)
    if contains(dec_short_xma, "port")
        print("FAIL v2 short xma decode: expected empty dict")
        exit(1)

    // ── Vector 3: MAPPED-ADDRESS round-trip ────────────────────────────────────
    let addr_v3 = ipv4_parse("10.20.30.40")
    let ma = stun_attr_mapped_address_encode(4500, addr_v3)
    if bytes_len(ma) != 8
        print("FAIL v3 ma len: got "+str(bytes_len(ma))+" want 8")
        exit(1)
    let dec_ma = stun_attr_mapped_address_decode(ma)
    let got_port3 = dec_ma["port"]
    if got_port3 != 4500
        print("FAIL v3 ma decode port: got "+str(got_port3)+" want 4500")
        exit(1)
    let got_ip3 = dec_ma["ip"]
    if got_ip3 != "10.20.30.40"
        print("FAIL v3 ma decode ip: got "+got_ip3+" want 10.20.30.40")
        exit(1)
    // MAPPED-ADDRESS decode on too-short value returns {}
    let short_ma = bytes(2)
    let dec_short_ma = stun_attr_mapped_address_decode(short_ma)
    if contains(dec_short_ma, "port")
        print("FAIL v3 short ma decode: expected empty dict")
        exit(1)

    // ── Vector 4: full message with XOR-MAPPED-ADDRESS attribute, encode+decode ─
    let attrs4 = [[STUN_ATTR_XOR_MAPPED_ADDRESS(), xma]]
    let msg4 = stun_encode(STUN_BINDING_SUCCESS_RESPONSE(), txn_id, attrs4)
    // header(20) + type(2)+len(2)+value(8) = 32, no padding needed (8 % 4 == 0)
    if bytes_len(msg4) != 32
        print("FAIL v4 msg len: got "+str(bytes_len(msg4))+" want 32")
        exit(1)
    let dec4 = stun_decode(msg4)
    if contains(dec4, "type") == false
        print("FAIL v4 decode: missing type key (decode failed)")
        exit(1)
    let got_type4 = dec4["type"]
    if got_type4 != STUN_BINDING_SUCCESS_RESPONSE()
        print("FAIL v4 decode type: got "+str(got_type4)+" want "+str(STUN_BINDING_SUCCESS_RESPONSE()))
        exit(1)
    let got_len4 = dec4["length"]
    if got_len4 != 12
        print("FAIL v4 decode length: got "+str(got_len4)+" want 12")
        exit(1)
    let got_cookie4 = dec4["cookie"]
    if got_cookie4 != 0x2112A442
        print("FAIL v4 decode cookie: got "+str(got_cookie4)+" want "+str(0x2112A442))
        exit(1)
    let got_txn4 = dec4["txn_id"]
    if bytes_len(got_txn4) != 12
        print("FAIL v4 decode txn_id len: got "+str(bytes_len(got_txn4))+" want 12")
        exit(1)
    if bytes_get(got_txn4, 0) != 0xB7
        print("FAIL v4 decode txn_id[0]: got "+str(bytes_get(got_txn4, 0))+" want 183")
        exit(1)
    let attrs_out4 = dec4["attrs"]
    if len(attrs_out4) != 1
        print("FAIL v4 attrs count: got "+str(len(attrs_out4))+" want 1")
        exit(1)
    let a4 = attrs_out4[0]
    if a4[0] != STUN_ATTR_XOR_MAPPED_ADDRESS()
        print("FAIL v4 attr type: got "+str(a4[0])+" want "+str(STUN_ATTR_XOR_MAPPED_ADDRESS()))
        exit(1)
    let redec4 = stun_attr_xor_mapped_address_decode(a4[1])
    let got_ip4 = redec4["ip"]
    if got_ip4 != "192.168.1.1"
        print("FAIL v4 round-trip ip: got "+got_ip4+" want 192.168.1.1")
        exit(1)
    // stun_find_attr utility
    let found4 = stun_find_attr(attrs_out4, STUN_ATTR_XOR_MAPPED_ADDRESS())
    if bytes_len(found4) != 8
        print("FAIL v4 find_attr len: got "+str(bytes_len(found4))+" want 8")
        exit(1)
    let notfound4 = stun_find_attr(attrs_out4, STUN_ATTR_MAPPED_ADDRESS())
    if bytes_len(notfound4) != 0
        print("FAIL v4 find_attr not-found: got len "+str(bytes_len(notfound4))+" want 0")
        exit(1)

    // ── Vector 5: attribute 4-byte padding for an odd-length value (3 bytes) ───
    let val5 = bytes(0)
    val5 = bytes_append(val5, 0xAA)
    val5 = bytes_append(val5, 0xBB)
    val5 = bytes_append(val5, 0xCC)
    let attrs5 = [[0x9999, val5]]
    let msg5 = stun_encode(STUN_BINDING_REQUEST(), txn_id, attrs5)
    // header(20) + type(2)+len(2)+value(3)+pad(1) = 28
    if bytes_len(msg5) != 28
        print("FAIL v5 msg len: got "+str(bytes_len(msg5))+" want 28")
        exit(1)
    // byte 22-23 = declared length = 3 (before padding)
    let got_alen5 = ((bytes_get(msg5, 22) << 8) | bytes_get(msg5, 23)) & 0xFFFF
    if got_alen5 != 3
        print("FAIL v5 attr declared length: got "+str(got_alen5)+" want 3")
        exit(1)
    // byte 27 (the pad byte) must be zero
    let got_pad5 = bytes_get(msg5, 27)
    if got_pad5 != 0
        print("FAIL v5 pad byte: got "+str(got_pad5)+" want 0")
        exit(1)
    // Message-Length header field = 8 (padded total, multiple of 4)
    let got_mlen5 = ((bytes_get(msg5, 2) << 8) | bytes_get(msg5, 3)) & 0xFFFF
    if got_mlen5 != 8
        print("FAIL v5 message-length: got "+str(got_mlen5)+" want 8")
        exit(1)
    // Decode round-trips: value length still reported as 3 (unpadded)
    let dec5 = stun_decode(msg5)
    let attrs_out5 = dec5["attrs"]
    let a5 = attrs_out5[0]
    if bytes_len(a5[1]) != 3
        print("FAIL v5 decode value len: got "+str(bytes_len(a5[1]))+" want 3")
        exit(1)
    if bytes_get(a5[1], 2) != 0xCC
        print("FAIL v5 decode value[2]: got "+str(bytes_get(a5[1], 2))+" want 204")
        exit(1)

    // ── Vector 6: Message-Length overrunning the buffer -> error, no over-read ─
    let bad6 = bytes(0)
    bad6 = bytes_append(bad6, 0x00)
    bad6 = bytes_append(bad6, 0x01)
    bad6 = bytes_append(bad6, 0x03)
    bad6 = bytes_append(bad6, 0xE8) // Message-Length = 0x03E8 = 1000 (way past buffer)
    let k6 = 0
    while k6 < 16
        bad6 = bytes_append(bad6, 0)
        k6 = k6 + 1
    // bad6 is now 20 bytes total (header only, no attribute bytes) but claims
    // 1000 bytes of attributes follow -> must be rejected, not over-read.
    if bytes_len(bad6) != 20
        print("FAIL v6 setup: got len "+str(bytes_len(bad6))+" want 20")
        exit(1)
    let dec6 = stun_decode(bad6)
    if contains(dec6, "type")
        print("FAIL v6: overrunning Message-Length was NOT rejected")
        exit(1)

    // ── Vector 7: attribute length overrunning its own window -> error ────────
    // Take the valid msg5 (28 bytes, one attribute) and corrupt the attribute's
    // own declared length (bytes 22-23) from 3 to 255 so its value+pad would
    // spill past the message's declared 8-byte attribute window.
    let bad7 = bytes(0)
    let j7 = 0
    while j7 < 28
        bad7 = bytes_append(bad7, bytes_get(msg5, j7))
        j7 = j7 + 1
    bytes_set(bad7, 23, 0xFF) // attr length lo byte -> 255
    let dec7 = stun_decode(bad7)
    if contains(dec7, "type")
        print("FAIL v7: attribute over-length was NOT rejected")
        exit(1)

    // ── Vector 8: buffer shorter than 20-byte header -> error, no crash ───────
    let short8 = bytes(19)
    let dec8 = stun_decode(short8)
    if contains(dec8, "type")
        print("FAIL v8: short header was NOT rejected")
        exit(1)
    let empty8 = bytes(0)
    let dec8b = stun_decode(empty8)
    if contains(dec8b, "type")
        print("FAIL v8b: empty buffer was NOT rejected")
        exit(1)

    // ── Vector 9: stun_encode with wrong-length txn_id -> error sentinel ──────
    let bad_txn9 = bytes(10)
    let enc9 = stun_encode(STUN_BINDING_REQUEST(), bad_txn9, [])
    if bytes_len(enc9) != 0
        print("FAIL v9: bad txn_id length did not yield empty bytes sentinel")
        exit(1)

    // ── Vector 10: zero-attribute Binding Success Response round-trips ────────
    let msg10 = stun_encode(STUN_BINDING_SUCCESS_RESPONSE(), txn_id, [])
    let dec10 = stun_decode(msg10)
    let got_type10 = dec10["type"]
    if got_type10 != 0x0101
        print("FAIL v10 type: got "+str(got_type10)+" want "+str(0x0101))
        exit(1)
    let got_attrs10 = dec10["attrs"]
    if len(got_attrs10) != 0
        print("FAIL v10 attrs: got "+str(len(got_attrs10))+" want 0")
        exit(1)

    print("PASS _stun_kat_test")
