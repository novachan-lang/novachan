// KAT for std/geometry/closestpair — Closest pair of points.
// Integer checks use cki; float checks use ckf (eps 0.001).
import std/geometry/closestpair

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckf(label: string, got: float, want: float)
    let d = got - want
    if d < 0.0
        d = 0.0 - d
    if d > 0.001
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── KAT 1: from spec — [[0,0],[3,4],[1,1]] — closest pair is (0,0)-(1,1), dist^2=2
    let pts1 = [[0, 0], [3, 4], [1, 1]]
    cki("closest_sq(pts1)", cp_closest_sq(pts1), 2)

    // ── KAT 2: from spec — [[0,0],[3,0]] — distance = 3.0
    let pts2 = [[0, 0], [3, 0]]
    ckf("closest(pts2)", cp_closest(pts2), 3.0)

    // ── KAT 3: from spec — square corners + interior (1,1) — closest pair is (0,0)-(1,1), dist^2=2
    let pts3 = [[0, 0], [10, 0], [10, 10], [0, 10], [1, 1]]
    cki("closest_sq(pts3)", cp_closest_sq(pts3), 2)

    // ── KAT 4: from spec — only two points far apart, dist^2=50
    let pts4 = [[0, 0], [5, 5]]
    cki("closest_sq(pts4)", cp_closest_sq(pts4), 50)

    // ── KAT 5: from spec — [[0,0],[1,1]] — distance = sqrt(2) ≈ 1.41421
    let pts5 = [[0, 0], [1, 1]]
    ckf("closest(pts5)", cp_closest(pts5), 1.41421)

    // ── KAT 6: from spec — [[2,2],[2,5],[8,2]] — closest is (2,2)-(2,5), dist^2=9
    let pts6 = [[2, 2], [2, 5], [8, 2]]
    cki("closest_sq(pts6)", cp_closest_sq(pts6), 9)

    // ── KAT 7: cp_pair returns a valid closest pair for pts1
    let pair1 = cp_pair(pts1)
    // The pair must have squared distance == 2
    let px = pair1[0]
    let py = pair1[1]
    let dx = px[0] - py[0]
    let dy = px[1] - py[1]
    cki("cp_pair(pts1) dist^2", dx * dx + dy * dy, 2)

    // ── KAT 8: cp_pair for two-point set returns both points in some order
    let pair2 = cp_pair(pts2)
    let ax = pair2[0]
    let bx = pair2[1]
    let ddx = ax[0] - bx[0]
    let ddy = ax[1] - bx[1]
    cki("cp_pair(pts2) dist^2", ddx * ddx + ddy * ddy, 9)

    // ── KAT 9: collinear points — [[0,0],[1,0],[2,0]] — closest sq=1
    let pts9 = [[0, 0], [1, 0], [2, 0]]
    cki("closest_sq(collinear)", cp_closest_sq(pts9), 1)

    // ── KAT 10: negative coordinates — [[-1,-1],[0,0]] dist^2=2
    let pts10 = [[-1, -1], [0, 0]]
    cki("closest_sq(neg)", cp_closest_sq(pts10), 2)

    print("_closestpair_test passed")
