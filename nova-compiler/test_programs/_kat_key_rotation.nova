import forge_key_rotation

fn main()
    let kr = kr_new()
    kr = kr_add_key(kr, "key-v1", 1000)
    assert(kr_active_key(kr) == "key-v1", "v1 active")
    assert(kr_key_count(kr) == 1, "1 key")
    assert(kr_active_count(kr) == 1, "1 active")

    kr = kr_rotate(kr, "key-v2", 2000)
    assert(kr_active_key(kr) == "key-v2", "v2 active after rotate")
    assert(kr_key_status(kr, "key-v1") == "rotated", "v1 rotated")
    assert(kr_key_status(kr, "key-v2") == "active", "v2 active")
    assert(kr_key_count(kr) == 2, "2 keys")
    assert(kr_rotation_count(kr) == 1, "1 rotation")

    kr = kr_rotate(kr, "key-v3", 3000)
    assert(kr_active_key(kr) == "key-v3", "v3 active")
    assert(kr_rotation_count(kr) == 2, "2 rotations")

    kr = kr_expire(kr, "key-v1")
    assert(kr_key_status(kr, "key-v1") == "expired", "v1 expired")
    assert(kr_active_count(kr) == 1, "1 active after expire")

    assert(kr_key_status(kr, "nonexistent") == "", "missing = empty")

    print("KEY-ROTATION KAT PASS")
