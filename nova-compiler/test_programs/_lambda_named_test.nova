import std/lambda/lambda_named

// Integer check.
fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// Bool check.
fn ckb(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// Structural term equality check (de Bruijn terms).
fn db_eq(a, b) -> int
    let ta = a[0]
    let tb = b[0]
    if ta != tb
        return 0
    if ta == "var"
        if a[1] == b[1]
            return 1
        return 0
    if ta == "fvar"
        if a[1] == b[1]
            return 1
        return 0
    if ta == "lam"
        return db_eq(a[1], b[1])
    if ta == "app"
        if db_eq(a[1], b[1]) == 0
            return 0
        return db_eq(a[2], b[2])
    return 0

fn ckt(label, a, b)
    if db_eq(a, b) == 0
        print("FAIL " + label + ": terms not equal")
        exit(1)

fn main()
    // KAT 1: to_debruijn(lam x. x) == lam var(0)
    let id_named = lambda_named.lnm_nlam("x", lambda_named.lnm_nvar("x"))
    let id_db = lambda_named.lnm_to_debruijn(id_named)
    let inner0 = []
    push(inner0, "var")
    push(inner0, 0)
    let lam_var0 = []
    push(lam_var0, "lam")
    push(lam_var0, inner0)
    ckt("to_db_id", id_db, lam_var0)

    // KAT 2: to_debruijn(lam x. lam y. x) == lam lam var(1)
    let kterm = lambda_named.lnm_nlam("x", lambda_named.lnm_nlam("y", lambda_named.lnm_nvar("x")))
    let k_db = lambda_named.lnm_to_debruijn(kterm)
    let inner1 = []
    push(inner1, "var")
    push(inner1, 1)
    let lam_inner1 = []
    push(lam_inner1, "lam")
    push(lam_inner1, inner1)
    let lam_lam_v1 = []
    push(lam_lam_v1, "lam")
    push(lam_lam_v1, lam_inner1)
    ckt("to_db_K", k_db, lam_lam_v1)

    // KAT 3: alpha_equal(lam x. x, lam y. y) = true
    let idx = lambda_named.lnm_nlam("x", lambda_named.lnm_nvar("x"))
    let idy = lambda_named.lnm_nlam("y", lambda_named.lnm_nvar("y"))
    cki("alpha_eq_id", lambda_named.lnm_alpha_equal(idx, idy), 1)

    // KAT 4: alpha_equal(lam x. x, lam x. z) = false
    let id2 = lambda_named.lnm_nlam("x", lambda_named.lnm_nvar("x"))
    let bad = lambda_named.lnm_nlam("x", lambda_named.lnm_nvar("z"))
    cki("alpha_neq", lambda_named.lnm_alpha_equal(id2, bad), 0)

    // KAT 5: free_names(lam x. (x y)) = ["y"]
    let body_app = lambda_named.lnm_napp(lambda_named.lnm_nvar("x"), lambda_named.lnm_nvar("y"))
    let lam_x_xy = lambda_named.lnm_nlam("x", body_app)
    let fnames = lambda_named.lnm_free_names(lam_x_xy)
    if len(fnames) != 1
        print("FAIL free_names len: got " + str(len(fnames)) + " expected 1")
        exit(1)
    if fnames[0] != "y"
        print("FAIL free_names[0]: got " + fnames[0] + " expected y")
        exit(1)

    // KAT 6: free_names(lam x. x) = [] (no free names)
    let closed = lambda_named.lnm_nlam("x", lambda_named.lnm_nvar("x"))
    let fnames2 = lambda_named.lnm_free_names(closed)
    if len(fnames2) != 0
        print("FAIL free_names_closed: got " + str(len(fnames2)) + " expected 0")
        exit(1)

    // KAT 7: from_debruijn round-trip on identity
    let db_id = lambda_named.lnm_to_debruijn(lambda_named.lnm_nlam("x", lambda_named.lnm_nvar("x")))
    let back = lambda_named.lnm_from_debruijn(db_id)
    // Result should be alpha-equal to identity
    let ref_id = lambda_named.lnm_nlam("x", lambda_named.lnm_nvar("x"))
    cki("roundtrip_id", lambda_named.lnm_alpha_equal(back, ref_id), 1)

    print("PASS _lambda_named_test")

main()
