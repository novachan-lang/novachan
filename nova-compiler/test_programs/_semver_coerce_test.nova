import std/semver/semver_coerce

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let g = 0
    if got
        g = 1
    let w = 0
    if want
        w = 1
    if g != w
        print("FAIL " + label + ": got=" + str(g) + " want=" + str(w))
        exit(1)

fn main()
    // -- svco_coerce: specified KAT vectors ------------------------------------
    cks("coerce_v12",    svco_coerce("v1.2"),    "1.2.0")
    cks("coerce_1",      svco_coerce("1"),        "1.0.0")
    cks("coerce_123",    svco_coerce("1.2.3"),    "1.2.3")
    cks("coerce_eq_v",   svco_coerce("=v1.2.3"), "1.2.3")
    cks("coerce_1234",   svco_coerce("1.2.3.4"), "1.2.3")

    // -- svco_clean: specified KAT vector --------------------------------------
    cks("clean_spaces_v",  svco_clean("  v1.0.0  "), "1.0.0")

    // -- svco_is_valid_loose: specified KAT vector -----------------------------
    ckb("valid_loose_12",  svco_is_valid_loose("1.2"), true)

    // -- svco_coerce: additional coverage --------------------------------------
    // leading zeros are parsed as decimal (not octal)
    cks("coerce_leading0", svco_coerce("01.02.03"), "1.2.3")
    // spaces around version
    cks("coerce_spaces", svco_coerce("  2.0.0  "), "2.0.0")
    // single integer
    cks("coerce_zero",   svco_coerce("0"), "0.0.0")
    // two parts
    cks("coerce_2parts", svco_coerce("3.5"), "3.5.0")
    // 'v' prefix with three parts
    cks("coerce_v123", svco_coerce("v1.2.3"), "1.2.3")
    // '=' prefix alone
    cks("coerce_eq123", svco_coerce("=1.0.0"), "1.0.0")
    // more than 3 parts: take first 3
    cks("coerce_4parts", svco_coerce("10.20.30.40"), "10.20.30")
    // prerelease stripped (only first 3 numeric components kept)
    cks("coerce_pre", svco_coerce("1.2.3-alpha"), "1.2.3")

    // -- svco_clean: additional coverage ---------------------------------------
    cks("clean_bare",   svco_clean("1.2.3"),    "1.2.3")
    cks("clean_v",      svco_clean("v2.0.0"),   "2.0.0")
    cks("clean_empty",  svco_clean(""),          "")
    cks("clean_nodigs", svco_clean("xyz"),       "")
    // spaces only
    cks("clean_spaces_only", svco_clean("   "), "")

    // -- svco_is_valid_loose: additional coverage ------------------------------
    ckb("valid_1",     svco_is_valid_loose("1"),       true)
    ckb("valid_1.2.3", svco_is_valid_loose("1.2.3"),   true)
    ckb("valid_v1",    svco_is_valid_loose("v1"),       true)
    ckb("valid_eq1",   svco_is_valid_loose("=1.0.0"),  true)
    ckb("invalid_abc", svco_is_valid_loose("abc"),      false)
    ckb("invalid_emp", svco_is_valid_loose(""),         false)

    print("PASS _semver_coerce_test")
