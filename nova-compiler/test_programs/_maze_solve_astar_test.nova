import std/game/maze_solve_astar

// ── BFS helper for comparison and path validation ─────────────────────────────

// _bfs_shortest: BFS shortest path from start to end in links. Returns path length
// (number of edges), or -1 if unreachable.  Bounds: each cell enqueued at most once.
fn _bfs_shortest(links, total, start, end)
    let visited = []
    let dist = []
    let i = 0
    while i < total
        push(visited, 0)
        push(dist, -1)
        i = i + 1
    visited[start] = 1
    dist[start] = 0
    let queue = []
    push(queue, start)
    let head = 0
    while head < len(queue)
        let cur = queue[head]
        head = head + 1
        let nbrs = links[cur]
        let j = 0
        let nlen = len(nbrs)
        while j < nlen
            let nb = nbrs[j]
            if visited[nb] == 0
                visited[nb] = 1
                dist[nb] = dist[cur] + 1
                push(queue, nb)
            j = j + 1
    return dist[end]

// _path_valid: check that path is a valid walk in the maze links.
// Returns 1 if valid (each consecutive pair is linked), 0 otherwise.
fn _path_valid(links, path)
    let plen = len(path)
    if plen == 0
        return 1
    let i = 0
    while i < plen - 1
        let a = path[i]
        let b = path[i + 1]
        // Check b in links[a]
        let nbrs = links[a]
        let nlen = len(nbrs)
        let found = 0
        let j = 0
        while j < nlen
            if nbrs[j] == b
                found = 1
            j = j + 1
        if found == 0
            return 0
        i = i + 1
    return 1

// _make_3x3_maze: hand-build a 3x3 maze.
//
//   Grid layout (w=3):
//     0-1-2
//     |
//     3-4-5
//           |
//     6-7-8
//
//   Edges: 0-1, 1-2, 0-3, 3-4, 4-5, 5-8, 6-7, 7-8
//   Shortest path 0->8: 0-3-4-5-8  (cost 4)
//
fn _make_3x3_maze()
    let links = []
    let i = 0
    while i < 9
        let cell_links = []
        push(links, cell_links)
        i = i + 1
    // 0-1
    push(links[0], 1)
    push(links[1], 0)
    // 1-2
    push(links[1], 2)
    push(links[2], 1)
    // 0-3
    push(links[0], 3)
    push(links[3], 0)
    // 3-4
    push(links[3], 4)
    push(links[4], 3)
    // 4-5
    push(links[4], 5)
    push(links[5], 4)
    // 5-8
    push(links[5], 8)
    push(links[8], 5)
    // 6-7
    push(links[6], 7)
    push(links[7], 6)
    // 7-8
    push(links[7], 8)
    push(links[8], 7)
    return links

// _make_disconnected_maze: a maze where cell 0 and cell 4 are in different components.
//   Component A: {0,1,2,3} — 0-1, 0-2, 0-3
//   Component B: {4,5,6,7,8} — 4-5, 4-6, 5-7, 6-8
//   Total=9, w=3, h=3.
fn _make_disconnected_maze()
    let links = []
    let i = 0
    while i < 9
        let cell_links = []
        push(links, cell_links)
        i = i + 1
    // Component A
    push(links[0], 1)
    push(links[1], 0)
    push(links[0], 2)
    push(links[2], 0)
    push(links[0], 3)
    push(links[3], 0)
    // Component B
    push(links[4], 5)
    push(links[5], 4)
    push(links[4], 6)
    push(links[6], 4)
    push(links[5], 7)
    push(links[7], 5)
    push(links[6], 8)
    push(links[8], 6)
    return links

fn main()
    // Test 1: manhattan(0, 8, 3)
    // Cell 0 = (row=0, col=0); cell 8 in w=3 grid: row=8/3=2, col=8%3=2.
    // Manhattan = |0-2| + |0-2| = 4.
    let md = manhattan(0, 8, 3)
    if md != 4
        print("FAIL maze_solve_astar manhattan(0,8,3): got " + str(md) + " want 4")
        exit(1)

    // Test 2: manhattan sanity — same cell -> 0.
    let md2 = manhattan(5, 5, 3)
    if md2 != 0
        print("FAIL maze_solve_astar manhattan(5,5,3): got " + str(md2) + " want 0")
        exit(1)

    // Test 3: manhattan(1, 7, 3): cell 1=(0,1) cell 7=(2,1) -> distance=2.
    let md3 = manhattan(1, 7, 3)
    if md3 != 2
        print("FAIL maze_solve_astar manhattan(1,7,3): got " + str(md3) + " want 2")
        exit(1)

    // Test 4: solve_astar on hand-built 3x3 maze, start=0 end=8.
    // Expected path includes 0 at front, 8 at back, each step linked.
    let maze1 = _make_3x3_maze()
    let path1 = solve_astar(maze1, 3, 3, 0, 8)
    let plen1 = len(path1)
    if plen1 == 0
        print("FAIL maze_solve_astar solve_astar 3x3: returned empty path")
        exit(1)
    if path1[0] != 0
        print("FAIL maze_solve_astar solve_astar 3x3: path start " + str(path1[0]) + " want 0")
        exit(1)
    if path1[plen1 - 1] != 8
        print("FAIL maze_solve_astar solve_astar 3x3: path end " + str(path1[plen1 - 1]) + " want 8")
        exit(1)
    let valid1 = _path_valid(maze1, path1)
    if valid1 == 0
        print("FAIL maze_solve_astar solve_astar 3x3: path has unlinked step")
        exit(1)

    // Test 5: A* path length equals BFS shortest path on same maze.
    let bfs_cost1 = _bfs_shortest(maze1, 9, 0, 8)
    let astar_cost1 = astar_cost(maze1, 3, 3, 0, 8)
    if astar_cost1 != bfs_cost1
        print("FAIL maze_solve_astar astar_cost vs bfs on 3x3: astar=" + str(astar_cost1) + " bfs=" + str(bfs_cost1))
        exit(1)
    // Verify the known cost: shortest is 0-3-4-5-8 = 4 edges.
    if astar_cost1 != 4
        print("FAIL maze_solve_astar known cost 0->8: got " + str(astar_cost1) + " want 4")
        exit(1)

    // Test 6: start == end -> path of length 1, cost 0.
    let path_same = solve_astar(maze1, 3, 3, 4, 4)
    let plen_same = len(path_same)
    if plen_same != 1
        print("FAIL maze_solve_astar start==end path length: got " + str(plen_same) + " want 1")
        exit(1)
    if path_same[0] != 4
        print("FAIL maze_solve_astar start==end path[0]: got " + str(path_same[0]) + " want 4")
        exit(1)
    let cost_same = astar_cost(maze1, 3, 3, 4, 4)
    if cost_same != 0
        print("FAIL maze_solve_astar start==end cost: got " + str(cost_same) + " want 0")
        exit(1)

    // Test 7: unreachable -> solve_astar returns [], astar_cost returns -1.
    let maze2 = _make_disconnected_maze()
    let path_unreach = solve_astar(maze2, 3, 3, 0, 8)
    let plen_unreach = len(path_unreach)
    if plen_unreach != 0
        print("FAIL maze_solve_astar unreachable: expected [] got length " + str(plen_unreach))
        exit(1)
    let cost_unreach = astar_cost(maze2, 3, 3, 0, 8)
    if cost_unreach != -1
        print("FAIL maze_solve_astar unreachable cost: got " + str(cost_unreach) + " want -1")
        exit(1)

    // Test 8: path from within component B (4->8) should work.
    let path_b = solve_astar(maze2, 3, 3, 4, 8)
    let plen_b = len(path_b)
    if plen_b == 0
        print("FAIL maze_solve_astar component B 4->8: returned empty")
        exit(1)
    if path_b[0] != 4
        print("FAIL maze_solve_astar component B path start: got " + str(path_b[0]) + " want 4")
        exit(1)
    if path_b[plen_b - 1] != 8
        print("FAIL maze_solve_astar component B path end: got " + str(path_b[plen_b - 1]) + " want 8")
        exit(1)
    let valid_b = _path_valid(maze2, path_b)
    if valid_b == 0
        print("FAIL maze_solve_astar component B path invalid steps")
        exit(1)
    let bfs_cost_b = _bfs_shortest(maze2, 9, 4, 8)
    let astar_cost_b = astar_cost(maze2, 3, 3, 4, 8)
    if astar_cost_b != bfs_cost_b
        print("FAIL maze_solve_astar component B cost: astar=" + str(astar_cost_b) + " bfs=" + str(bfs_cost_b))
        exit(1)

    print("PASS _maze_solve_astar_test")
