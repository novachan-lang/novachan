fn main()
    let xs = [1, 2, 3, 4]
    print("int comp:     " + str(sum([x * 2 for x in xs])))
    print("int literal:  " + str(sum([2, 4, 6, 8])))
    print("identity comp:" + str(sum([x for x in xs])))
    let c = [x * 2 for x in xs]
    print("bound comp:   " + str(sum(c)))
    let fs = [1.5, 2.5]
    print("float literal:" + str(sum(fs)))
    print("float comp:   " + str(sum([f * 2.0 for f in fs])))
    print("empty comp:   " + str(sum([x for x in []])))
