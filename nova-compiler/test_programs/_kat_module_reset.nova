// GAP 5 usability: a reset function that BARE-reassigns a module var without reading it
// after must compile (not trip E1000 "assigned but never read") — it is a real side
// effect on shared module state, not a dead store. Also proves clear() actually resets
// the shared handle (const_set), visible to every other function.

let cache = {}

fn put(k: string, v: int)
    cache[k] = v

fn clear()
    cache = {}

fn size() -> int
    return len(cache)

fn main() -> int
    let fails = 0
    put("a", 1)
    put("b", 2)
    if size() != 2
        print("FAIL size=" + str(size()))
        fails = fails + 1
    clear()
    if size() != 0
        print("FAIL size after clear=" + str(size()))
        fails = fails + 1
    put("c", 3)
    if size() != 1
        print("FAIL size after re-put=" + str(size()))
        fails = fails + 1
    if fails == 0
        print("PASS _kat_module_reset")
    else
        print("FAILED _kat_module_reset")
    return 0
