import forge_anagram

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

// does group containing `w` also contain `other`?
fn same_group(groups: list, w: string, other: string) -> int
    let gi = 0
    while gi < len(groups)
        let g = groups[gi]
        let hasw = 0
        let haso = 0
        let j = 0
        while j < len(g)
            if g[j] == w
                hasw = 1
            if g[j] == other
                haso = 1
            j = j + 1
        if hasw == 1
            if haso == 1
                return 1
            return 0
        gi = gi + 1
    0

fn main()
    let fails = 0

    // is_anagram
    fails = fails + expect("a1", str(is_anagram("listen", "silent")), "true")
    fails = fails + expect("a2", str(is_anagram("hello", "world")), "false")
    fails = fails + expect("a_empty", str(is_anagram("", "")), "true")
    fails = fails + expect("a_len", str(is_anagram("a", "ab")), "false")
    fails = fails + expect("a_same", str(is_anagram("abc", "abc")), "true")
    fails = fails + expect("a_rearranged", str(is_anagram("dormitory", "dirtyroom")), "true")

    // signature
    fails = fails + expect("sig", anagram_signature("cba"), "abc")
    fails = fails + expect("sig2", anagram_signature("aabbcc"), "aabbcc")
    fails = fails + expect("sig3", anagram_signature("dcba"), "abcd")

    // group anagrams
    let g = group_anagrams(["eat", "tea", "tan", "ate", "nat", "bat"])
    fails = fails + expect("group_count", str(len(g)), "3")
    fails = fails + expect("eat_tea", str(same_group(g, "eat", "tea")), "1")
    fails = fails + expect("eat_ate", str(same_group(g, "eat", "ate")), "1")
    fails = fails + expect("tan_nat", str(same_group(g, "tan", "nat")), "1")
    fails = fails + expect("eat_bat", str(same_group(g, "eat", "bat")), "0")

    // no anagrams -> each word its own group
    let g2 = group_anagrams(["abc", "def", "ghi"])
    fails = fails + expect("no_ana", str(len(g2)), "3")

    if fails == 0
        print("forge_anagram: all passed")
    else
        print("forge_anagram: " + str(fails) + " FAILED")
