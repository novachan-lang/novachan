import std/combinatorics/lyndon

// cki — check int equality.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb — check bool equality.
fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
        exit(1)

// int_list_to_str — flatten int list to "[a,b,...]".
fn int_list_to_str(xs: list) -> string
    let s = "["
    let i = 0
    let n = len(xs)
    while i < n
        if i > 0
            s = s + ","
        s = s + str(xs[i])
        i = i + 1
    s + "]"

// lists_equal — true iff two int lists are equal.
fn lists_equal(a: list, b: list) -> bool
    if len(a) != len(b)
        return false
    let i = 0
    while i < len(a)
        if a[i] != b[i]
            return false
        i = i + 1
    true

// outer_contains — true iff list-of-lists contains a list equal to target.
fn outer_contains(out: list, target: list) -> bool
    let i = 0
    while i < len(out)
        if lists_equal(out[i], target)
            return true
        i = i + 1
    false

// concat_all — flatten list-of-lists to one list.
fn concat_all(parts: list) -> list
    let out = []
    let i = 0
    while i < len(parts)
        let w = parts[i]
        let j = 0
        while j < len(w)
            push(out, w[j])
            j = j + 1
        i = i + 1
    out

fn main()
    // --- ly_is_lyndon ---
    let w01 = []
    push(w01, 0)
    push(w01, 1)
    ckb("is_lyndon_[0,1]", ly_is_lyndon(w01), true)

    let w10 = []
    push(w10, 1)
    push(w10, 0)
    ckb("is_lyndon_[1,0]", ly_is_lyndon(w10), false)

    let w00 = []
    push(w00, 0)
    push(w00, 0)
    ckb("is_lyndon_[0,0]", ly_is_lyndon(w00), false)

    let w0 = []
    push(w0, 0)
    ckb("is_lyndon_[0]", ly_is_lyndon(w0), true)

    let w001 = []
    push(w001, 0)
    push(w001, 0)
    push(w001, 1)
    ckb("is_lyndon_[0,0,1]", ly_is_lyndon(w001), true)

    let w011 = []
    push(w011, 0)
    push(w011, 1)
    push(w011, 1)
    ckb("is_lyndon_[0,1,1]", ly_is_lyndon(w011), true)

    let w010 = []
    push(w010, 0)
    push(w010, 1)
    push(w010, 0)
    ckb("is_lyndon_[0,1,0]", ly_is_lyndon(w010), false)

    let w111 = []
    push(w111, 1)
    push(w111, 1)
    push(w111, 1)
    ckb("is_lyndon_[1,1,1]", ly_is_lyndon(w111), false)

    // --- ly_count ---
    cki("ly_count(2,1)", ly_count(2, 1), 2)
    cki("ly_count(2,2)", ly_count(2, 2), 1)
    cki("ly_count(2,3)", ly_count(2, 3), 2)
    cki("ly_count(2,4)", ly_count(2, 4), 3)
    cki("ly_count(2,5)", ly_count(2, 5), 6)
    cki("ly_count(3,1)", ly_count(3, 1), 3)
    cki("ly_count(3,2)", ly_count(3, 2), 3)

    // --- ly_all(2,3) ---
    let all23 = ly_all(2, 3)
    cki("ly_all(2,3)_len", len(all23), 2)
    ckb("ly_all(2,3)_has_[0,0,1]", outer_contains(all23, w001), true)
    ckb("ly_all(2,3)_has_[0,1,1]", outer_contains(all23, w011), true)

    // --- ly_all(2,1) ---
    let all21 = ly_all(2, 1)
    cki("ly_all(2,1)_len", len(all21), 2)

    // --- ly_all(2,2) ---
    let all22 = ly_all(2, 2)
    cki("ly_all(2,2)_len", len(all22), 1)
    let w01_2 = []
    push(w01_2, 0)
    push(w01_2, 1)
    ckb("ly_all(2,2)_has_[0,1]", outer_contains(all22, w01_2), true)

    // --- ly_necklace_count ---
    cki("necklace(2,1)", ly_necklace_count(2, 1), 2)
    cki("necklace(2,2)", ly_necklace_count(2, 2), 3)
    cki("necklace(2,3)", ly_necklace_count(2, 3), 4)
    cki("necklace(2,4)", ly_necklace_count(2, 4), 6)
    cki("necklace(3,1)", ly_necklace_count(3, 1), 3)
    cki("necklace(3,2)", ly_necklace_count(3, 2), 6)

    // --- ly_least_rotation ---
    let w201 = []
    push(w201, 2)
    push(w201, 0)
    push(w201, 1)
    let lr201 = ly_least_rotation(w201)
    // rotations of [2,0,1]: [2,0,1], [0,1,2], [1,2,0] -> least is [0,1,2]
    let expect012 = []
    push(expect012, 0)
    push(expect012, 1)
    push(expect012, 2)
    ckb("least_rot_[2,0,1]", lists_equal(lr201, expect012), true)

    let w012 = []
    push(w012, 0)
    push(w012, 1)
    push(w012, 2)
    let lr012 = ly_least_rotation(w012)
    ckb("least_rot_[0,1,2]", lists_equal(lr012, w012), true)

    let w100 = []
    push(w100, 1)
    push(w100, 0)
    push(w100, 0)
    let lr100 = ly_least_rotation(w100)
    // rotations of [1,0,0]: [1,0,0],[0,0,1],[0,1,0] -> least is [0,0,1]
    let expect001 = []
    push(expect001, 0)
    push(expect001, 0)
    push(expect001, 1)
    ckb("least_rot_[1,0,0]", lists_equal(lr100, expect001), true)

    // --- ly_factorize ---
    // [0,1] is Lyndon, so factorization = [[0,1]]
    let f01 = ly_factorize(w01)
    cki("factorize_[0,1]_len", len(f01), 1)
    ckb("factorize_[0,1]_factor0", lists_equal(f01[0], w01), true)

    // [1,0,0]: Chen-Fox-Lyndon decomposition
    // [1] is Lyndon, [0] is Lyndon, [0] is Lyndon -> [1],[0],[0]
    let f100 = ly_factorize(w100)
    // concatenation must reconstruct original
    let cat100 = concat_all(f100)
    ckb("factorize_[1,0,0]_concat", lists_equal(cat100, w100), true)
    // each factor is Lyndon
    let fi = 0
    while fi < len(f100)
        ckb("factorize_[1,0,0]_factor" + str(fi) + "_is_lyndon", ly_is_lyndon(f100[fi]), true)
        fi = fi + 1
    // factors must be non-increasing (each <= its predecessor)
    let gi = 1
    while gi < len(f100)
        let prev_f = f100[gi - 1]
        let cur_f = f100[gi]
        // cur <= prev means: NOT (cur > prev); a Lyndon factor [0] <= [1] lex
        // check: prev_f[0] >= cur_f[0] (simplified: since each is [0] or [1])
        ckb("factorize_[1,0,0]_nonincr_" + str(gi), prev_f[0] >= cur_f[0], true)
        gi = gi + 1

    // [0,0,1,0,1,1]: Duval should give [0,0,1],[0,1,1] or similar
    let w001011 = []
    push(w001011, 0)
    push(w001011, 0)
    push(w001011, 1)
    push(w001011, 0)
    push(w001011, 1)
    push(w001011, 1)
    let f001011 = ly_factorize(w001011)
    let cat001011 = concat_all(f001011)
    ckb("factorize_001011_concat", lists_equal(cat001011, w001011), true)
    let fii = 0
    while fii < len(f001011)
        ckb("factorize_001011_factor" + str(fii) + "_lyndon", ly_is_lyndon(f001011[fii]), true)
        fii = fii + 1

    // --- ly_rotations ---
    let rot01 = ly_rotations(w01)
    cki("rotations_[0,1]_len", len(rot01), 2)

    let rot001 = ly_rotations(w001)
    cki("rotations_[0,0,1]_len", len(rot001), 3)

    // --- ly_de_bruijn(2,3) ---
    // B(2,3) has length 2^3=8
    let db23 = ly_de_bruijn(2, 3)
    cki("de_bruijn(2,3)_len", len(db23), 8)
    // all values in {0,1}
    let dbi = 0
    while dbi < len(db23)
        let v = db23[dbi]
        ckb("de_bruijn(2,3)_val_" + str(dbi) + "_in_01", v >= 0 and v <= 1, true)
        dbi = dbi + 1

    // B(2,2) has length 4
    let db22 = ly_de_bruijn(2, 2)
    cki("de_bruijn(2,2)_len", len(db22), 4)

    // B(2,1) has length 2
    let db21 = ly_de_bruijn(2, 1)
    cki("de_bruijn(2,1)_len", len(db21), 2)

    print("PASS _lyndon_test")
