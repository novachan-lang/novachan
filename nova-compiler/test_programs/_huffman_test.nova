// _huffman_test.nova — KAT for std/compress/huffman
//
// Tests:
//   1. Round-trip: hf_decode(hf_encode(s)[0], hf_encode(s)[1]) == s
//      for "", "a", "aaabbbccd", "mississippi", "the quick brown fox"
//   2. hf_build_codes("aaabbbccd"): most-frequent char "a" (3 occurrences)
//      gets a code no longer than the least-frequent char "d" (1 occurrence).
//   3. Single distinct char "aaaa": round-trip works.
//   4. hf_encoded_bits("aaaa") < 8*4 (compression achieved vs naive 8 bits/char).
//
// HAND-TRACE for "aaabbbccd":
//   freqs: a=3, b=3, c=2, d=1
//   Sorted leaves by (freq asc, char_ord asc):
//     d(1), c(2), a(3), b(3)
//   Heap merges (standard Huffman):
//     pop d(1,ord=100), pop c(2,ord=99) -> internal I1(3, tb=1000)
//     pop a(3,ord=97),  pop b(3,ord=98) -> internal I2(6, tb=1001)
//       (a before b since ord(a)=97 < ord(b)=98)
//     pop I1(3,tb=1000), pop I2(6,tb=1001) -> root R(9, tb=1002)
//   Tree:
//         R(9)
//        /    \
//      I1(3)  I2(6)
//      / \    / \
//     d   c  a   b
//   Codes: d="00", c="01", a="10", b="11"
//   len(codes["a"]) = 2 <= len(codes["d"]) = 2  ✓

import std/compress/huffman

// cks: check string equality.
fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

// cki: check int equality.
fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckle: check got <= want (int).
fn ckle(label, got, want)
    if got > want
        print("FAIL " + label + ": got=" + str(got) + " not <= " + str(want))
        exit(1)

// cklt: check got < want (int).
fn cklt(label, got, want)
    if got >= want
        print("FAIL " + label + ": got=" + str(got) + " not < " + str(want))
        exit(1)

// round_trip: encode then decode s, assert result == s.
fn round_trip(label, s)
    let encoded = hf_encode(s)
    let bits = encoded[0]
    let codes = encoded[1]
    let decoded = hf_decode(bits, codes)
    cks(label, decoded, s)

fn main()
    // ── KAT 1: empty string round-trip ───────────────────────────────────────
    round_trip("rt_empty", "")

    // ── KAT 2: single char string "a" round-trip ─────────────────────────────
    round_trip("rt_single_a", "a")

    // ── KAT 3: "aaabbbccd" round-trip ────────────────────────────────────────
    round_trip("rt_aaabbbccd", "aaabbbccd")

    // ── KAT 4: "mississippi" round-trip ──────────────────────────────────────
    round_trip("rt_mississippi", "mississippi")

    // ── KAT 5: "the quick brown fox" round-trip ───────────────────────────────
    round_trip("rt_foxsentence", "the quick brown fox")

    // ── KAT 6: most-frequent char gets shortest (or equal) code ──────────────
    // "aaabbbccd": a=3, b=3, c=2, d=1
    // Codes (from hand-trace): a="10"(2), b="11"(2), c="01"(2), d="00"(2)
    // len(codes["a"]) <= len(codes["d"]) must hold.
    let codes9 = hf_build_codes("aaabbbccd")
    let len_a = len(codes9["a"])
    let len_d = len(codes9["d"])
    ckle("freq_order_aaabbbccd", len_a, len_d)

    // ── KAT 7: single distinct char "aaaa" round-trip ────────────────────────
    round_trip("rt_aaaa", "aaaa")

    // ── KAT 8: hf_encoded_bits("aaaa") < 8*4 (4 chars * 8 bits naive) ────────
    // "aaaa" has one distinct char, code "0", so encoded = "0000" = 4 bits < 32.
    let bits_aaaa = hf_encoded_bits("aaaa")
    cklt("compression_aaaa", bits_aaaa, 32)

    // ── KAT 9: hf_encoded_bits matches actual bitstring length ───────────────
    let enc_fox = hf_encode("the quick brown fox")
    let fox_bits = enc_fox[0]
    cki("bits_match_fox", hf_encoded_bits("the quick brown fox"), len(fox_bits))

    // ── KAT 10: codes dict has entry for each distinct char ──────────────────
    let codes_miss = hf_build_codes("mississippi")
    // mississippi has chars: m, i, s, p
    // all four must be present in codes
    if contains(codes_miss, "m") == 0
        print("FAIL codes_miss_m: missing m")
        exit(1)
    if contains(codes_miss, "i") == 0
        print("FAIL codes_miss_i: missing i")
        exit(1)
    if contains(codes_miss, "s") == 0
        print("FAIL codes_miss_s: missing s")
        exit(1)
    if contains(codes_miss, "p") == 0
        print("FAIL codes_miss_p: missing p")
        exit(1)

    print("_huffman_test passed")
