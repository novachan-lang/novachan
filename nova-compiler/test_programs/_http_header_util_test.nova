import std/httphdr/http_header_util

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let g = "false"
        if got
            g = "true"
        let w = "false"
        if want
            w = "true"
        print("FAIL " + label + ": got=" + g + " want=" + w)
        exit(1)

fn ckl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL " + label + "[" + str(i) + "]: got='" + str(got[i]) + "' want='" + want[i] + "'")
            exit(1)
        i = i + 1

// Check a [[k,v],...] list-of-pairs result
fn ckpairs(label: string, got: list, wkeys: list, wvals: list)
    if len(got) != len(wkeys)
        print("FAIL " + label + ": len got=" + str(len(got)) + " want=" + str(len(wkeys)))
        exit(1)
    let i = 0
    while i < len(wkeys)
        let pair = got[i]
        if pair[0] != wkeys[i]
            print("FAIL " + label + "[" + str(i) + "].key: got='" + pair[0] + "' want='" + wkeys[i] + "'")
            exit(1)
        if pair[1] != wvals[i]
            print("FAIL " + label + "[" + str(i) + "].val: got='" + pair[1] + "' want='" + wvals[i] + "'")
            exit(1)
        i = i + 1

fn main()
    // ── KAT vectors from the spec ────────────────────────────────────────────
    ckl("split-abc", hhu_split_list("a, b, c"), ["a", "b", "c"])
    ckl("split-quoted", hhu_split_list("\"x,y\", z"), ["\"x,y\"", "z"])
    cks("unquote-hello", hhu_unquote("\"hello\""), "hello")
    cks("token-value", hhu_token_value("text/html; charset=utf-8"), "text/html")
    ckpairs("parse-params", hhu_parse_params("; charset=utf-8; boundary=x"), ["charset", "boundary"], ["utf-8", "x"])

    // ── hhu_split_list edge cases ────────────────────────────────────────────
    ckl("split-empty", hhu_split_list(""), [])
    ckl("split-single", hhu_split_list("text/html"), ["text/html"])
    ckl("split-trim", hhu_split_list("  a  ,  b  "), ["a", "b"])
    // quoted comma: the comma inside quotes must NOT split
    ckl("split-quoted-comma", hhu_split_list("\"a,b\",c"), ["\"a,b\"", "c"])
    // Accept header style
    ckl("split-accept", hhu_split_list("text/html, application/json, */*"), ["text/html", "application/json", "*/*"])

    // ── hhu_unquote edge cases ───────────────────────────────────────────────
    cks("unquote-noq", hhu_unquote("hello"), "hello")
    cks("unquote-empty", hhu_unquote(""), "")
    cks("unquote-emptyq", hhu_unquote("\"\""), "")
    cks("unquote-inner-quote", hhu_unquote("\"he said \\\"hi\\\"\""), "he said \"hi\"")
    cks("unquote-trim", hhu_unquote("  \"world\"  "), "world")

    // ── hhu_token_value edge cases ───────────────────────────────────────────
    cks("token-nosemi", hhu_token_value("application/json"), "application/json")
    cks("token-empty", hhu_token_value(""), "")
    cks("token-trim", hhu_token_value("  multipart/form-data ; boundary=x"), "multipart/form-data")
    cks("token-only-semi", hhu_token_value("; charset=utf-8"), "")

    // ── hhu_parse_params edge cases ──────────────────────────────────────────
    // no params
    let p_empty = hhu_parse_params("text/html")
    cki("params-nosemi-len", len(p_empty), 0)
    // single param
    ckpairs("params-single", hhu_parse_params("text/html; charset=utf-8"), ["charset"], ["utf-8"])
    // multiple params
    ckpairs("params-multi", hhu_parse_params("form-data; name=file; filename=foo.txt"), ["name", "filename"], ["file", "foo.txt"])
    // quoted value
    ckpairs("params-quoted", hhu_parse_params("; name=\"file name\""), ["name"], ["file name"])
    // key lowercased
    ckpairs("params-upper", hhu_parse_params("; Charset=UTF-8"), ["charset"], ["UTF-8"])

    print("PASS _http_header_util_test")
