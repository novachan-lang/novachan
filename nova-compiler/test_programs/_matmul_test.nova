// _matmul_test.nova — KAT for std/matrix/matmul
import std/matrix/matmul

// Helper: convert a 2D list-of-lists (rows × cols of int/float) to a matrix dict.
fn from2d(rows: list) -> any
    let r = len(rows)
    let row0 = rows[0]
    let c = len(row0)
    let d = []
    let i = 0
    while i < r
        let row = rows[i]
        let j = 0
        while j < c
            let v = row[j] * 1.0
            push(d, v)
            j = j + 1
        i = i + 1
    mm_make(r, c, d)

// Helper: check two floats are within tol.
fn approx(a: float, b: float, tol: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    d < tol

// Helper: fail with label.
fn fail(label: string)
    print("FAIL _matmul_test " + label)
    exit(1)

fn main()
    // ── KAT 1: mm_mul [[1,2],[3,4]] x [[5,6],[7,8]] == [[19,22],[43,50]] ────
    let r1 = []
    push(r1, 1)
    push(r1, 2)
    let r2 = []
    push(r2, 3)
    push(r2, 4)
    let a22 = []
    push(a22, r1)
    push(a22, r2)
    let A = from2d(a22)

    let r3 = []
    push(r3, 5)
    push(r3, 6)
    let r4 = []
    push(r4, 7)
    push(r4, 8)
    let b22 = []
    push(b22, r3)
    push(b22, r4)
    let B = from2d(b22)

    let C = mm_mul(A, B)
    if not approx(mm_get(C, 0, 0), 19.0, 0.0001)
        fail("mul[0,0]")
    if not approx(mm_get(C, 0, 1), 22.0, 0.0001)
        fail("mul[0,1]")
    if not approx(mm_get(C, 1, 0), 43.0, 0.0001)
        fail("mul[1,0]")
    if not approx(mm_get(C, 1, 1), 50.0, 0.0001)
        fail("mul[1,1]")

    // ── KAT 2: mm_matvec [[1,2],[3,4]] x [5,6] == [17, 39] ──────────────────
    let v = []
    push(v, 5)
    push(v, 6)
    let mv = mm_matvec(A, v)
    if not approx(mv[0] * 1.0, 17.0, 0.0001)
        fail("matvec[0]")
    if not approx(mv[1] * 1.0, 39.0, 0.0001)
        fail("matvec[1]")

    // ── KAT 3: mm_mul(A, mm_identity(2)) == A ───────────────────────────────
    let I2 = mm_identity(2)
    let AI = mm_mul(A, I2)
    if not mm_equal(AI, A, 0.0001)
        fail("mul_identity")

    // ── KAT 4: mm_add [[1,2]] + [[3,4]] == [[4,6]] ──────────────────────────
    let da1 = []
    push(da1, 1.0)
    push(da1, 2.0)
    let A1 = mm_make(1, 2, da1)
    let da2 = []
    push(da2, 3.0)
    push(da2, 4.0)
    let B1 = mm_make(1, 2, da2)
    let S = mm_add(A1, B1)
    if not approx(mm_get(S, 0, 0), 4.0, 0.0001)
        fail("add[0,0]")
    if not approx(mm_get(S, 0, 1), 6.0, 0.0001)
        fail("add[0,1]")

    // ── KAT 5: mm_scale [[1,2]] by 3.0 == [[3,6]] ───────────────────────────
    let Sc = mm_scale(A1, 3.0)
    if not approx(mm_get(Sc, 0, 0), 3.0, 0.0001)
        fail("scale[0,0]")
    if not approx(mm_get(Sc, 0, 1), 6.0, 0.0001)
        fail("scale[0,1]")

    // ── KAT 6: mm_power([[2,0],[0,3]], 2) == [[4,0],[0,9]] ──────────────────
    let dp = []
    push(dp, 2.0)
    push(dp, 0.0)
    push(dp, 0.0)
    push(dp, 3.0)
    let P = mm_make(2, 2, dp)
    let P2 = mm_power(P, 2)
    if not approx(mm_get(P2, 0, 0), 4.0, 0.0001)
        fail("power2[0,0]")
    if not approx(mm_get(P2, 0, 1), 0.0, 0.0001)
        fail("power2[0,1]")
    if not approx(mm_get(P2, 1, 0), 0.0, 0.0001)
        fail("power2[1,0]")
    if not approx(mm_get(P2, 1, 1), 9.0, 0.0001)
        fail("power2[1,1]")

    // ── KAT 7: mm_power(A, 0) == identity ───────────────────────────────────
    let A0 = mm_power(A, 0)
    let I2b = mm_identity(2)
    if not mm_equal(A0, I2b, 0.0001)
        fail("power0")

    // ── KAT 8: mm_dims of a 2x3 == [2, 3] ───────────────────────────────────
    let dd = []
    push(dd, 1.0)
    push(dd, 2.0)
    push(dd, 3.0)
    push(dd, 4.0)
    push(dd, 5.0)
    push(dd, 6.0)
    let M23 = mm_make(2, 3, dd)
    let dims = mm_dims(M23)
    if dims[0] != 2
        fail("dims[0]")
    if dims[1] != 3
        fail("dims[1]")

    // ── KAT 9: mm_sub ────────────────────────────────────────────────────────
    let Sub = mm_sub(B1, A1)
    if not approx(mm_get(Sub, 0, 0), 2.0, 0.0001)
        fail("sub[0,0]")
    if not approx(mm_get(Sub, 0, 1), 2.0, 0.0001)
        fail("sub[0,1]")

    // ── KAT 10: mm_hadamard [[1,2],[3,4]] o [[5,6],[7,8]] == [[5,12],[21,32]]
    let H = mm_hadamard(A, B)
    if not approx(mm_get(H, 0, 0), 5.0, 0.0001)
        fail("hadamard[0,0]")
    if not approx(mm_get(H, 0, 1), 12.0, 0.0001)
        fail("hadamard[0,1]")
    if not approx(mm_get(H, 1, 0), 21.0, 0.0001)
        fail("hadamard[1,0]")
    if not approx(mm_get(H, 1, 1), 32.0, 0.0001)
        fail("hadamard[1,1]")

    print("PASS _matmul_test")
