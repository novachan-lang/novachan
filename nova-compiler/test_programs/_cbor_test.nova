// _cbor_test — KAT for std/data/cbor (RFC 8949 encode/decode).
// Vectors from RFC 8949 Appendix A and the spec description.
import std/data/cbor

// cki: check int equality; prints FAIL and exits 1 on mismatch.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// cks: check string equality; prints FAIL and exits 1 on mismatch.
fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got " + got + " want " + want)
        exit(1)

// ckb: check that a bytes value matches an expected list of ints byte-by-byte.
fn ckb(label: string, b: any, expected: list)
    let blen = bytes_len(b)
    let elen = len(expected)
    cki(label + "_len", blen, elen)
    let i = 0
    while i < elen
        cki(label + "_b" + str(i), bytes_get(b, i), expected[i])
        i = i + 1

fn main()
    // ── KAT 1: cb_encode(1) -> bytes == [1] ─────────────────────────────────
    let enc1 = cb_encode(1)
    let exp1 = [1]
    ckb("encode_1", enc1, exp1)

    // ── KAT 2: cb_encode(10) -> bytes == [10] ────────────────────────────────
    let enc10 = cb_encode(10)
    let exp10 = [10]
    ckb("encode_10", enc10, exp10)

    // ── KAT 3: cb_encode(100) -> bytes == [24, 100] ──────────────────────────
    let enc100 = cb_encode(100)
    let exp100 = [24, 100]
    ckb("encode_100", enc100, exp100)

    // ── KAT 4: cb_encode(1000) -> bytes == [25, 3, 232] ──────────────────────
    // 1000 = 0x03E8; head = 0x19 (major 0, info 25), then 0x03, 0xe8
    let enc1000 = cb_encode(1000)
    let exp1000 = [25, 3, 232]
    ckb("encode_1000", enc1000, exp1000)

    // ── KAT 5: cb_encode("a") -> bytes == [97, 97] ───────────────────────────
    // 0x61 = 0x60 | 1 (text, len=1), then 0x61 = ord('a')
    let enca = cb_encode("a")
    let expa = [97, 97]
    ckb("encode_a", enca, expa)

    // ── KAT 6: cb_encode([1,2,3]) -> bytes == [131,1,2,3] ────────────────────
    // 0x83 = 0x80 | 3 (array, len=3), then 0x01 0x02 0x03
    let encarr = cb_encode([1, 2, 3])
    let exparr = [131, 1, 2, 3]
    ckb("encode_arr123", encarr, exparr)

    // ── KAT 7: round-trip string "hello" ─────────────────────────────────────
    let hello_enc = cb_encode("hello")
    let hello_dec = cb_decode(hello_enc)
    cks("rt_hello", hello_dec, "hello")

    // ── KAT 8: round-trip list [1,2,3] ───────────────────────────────────────
    let list_enc = cb_encode([1, 2, 3])
    let list_dec = cb_decode(list_enc)
    // Verify element by element
    cki("rt_list_len", len(list_dec), 3)
    cki("rt_list_0", list_dec[0], 1)
    cki("rt_list_1", list_dec[1], 2)
    cki("rt_list_2", list_dec[2], 3)

    // ── Additional RFC vector: unsigned 0 -> [0x00] ──────────────────────────
    let enc0 = cb_encode(0)
    let exp0 = [0]
    ckb("encode_0", enc0, exp0)

    // ── Additional RFC vector: unsigned 23 -> [0x17] ─────────────────────────
    let enc23 = cb_encode(23)
    let exp23 = [23]
    ckb("encode_23", enc23, exp23)

    // ── Additional RFC vector: unsigned 24 -> [0x18, 0x18] ───────────────────
    let enc24 = cb_encode(24)
    let exp24 = [24, 24]
    ckb("encode_24", enc24, exp24)

    // ── Additional RFC vector: negative -1 -> [0x20] ─────────────────────────
    let encneg1 = cb_encode(0 - 1)
    let expneg1 = [32]
    ckb("encode_neg1", encneg1, expneg1)

    // ── Additional RFC vector: negative -100 -> [0x38, 0x63] ─────────────────
    let encneg100 = cb_encode(0 - 100)
    let expneg100 = [56, 99]
    ckb("encode_neg100", encneg100, expneg100)

    // ── cb_decode_at returns [value, next_pos] ────────────────────────────────
    let pair = cb_decode_at(enc1000, 0)
    cki("decode_at_val", pair[0], 1000)
    cki("decode_at_pos", pair[1], 3)

    // ── cb_encode_bool: true->0xf5, false->0xf4 ──────────────────────────────
    let bt = cb_encode_bool(1)
    ckb("bool_true", bt, [245])
    let bf = cb_encode_bool(0)
    ckb("bool_false", bf, [244])

    // ── cb_encode_null: 0xf6 ─────────────────────────────────────────────────
    let bn = cb_encode_null()
    ckb("cbor_null", bn, [246])

    // ── round-trip "IETF" (RFC Appendix A vector) ────────────────────────────
    let ietf_enc = cb_encode("IETF")
    let ietf_dec = cb_decode(ietf_enc)
    cks("rt_IETF", ietf_dec, "IETF")

    // ── nested array round-trip: [1, [2,3], [4,5]] ───────────────────────────
    let nested = [1, [2, 3], [4, 5]]
    let nested_enc = cb_encode(nested)
    let nested_dec = cb_decode(nested_enc)
    cki("nested_len", len(nested_dec), 3)
    cki("nested_0", nested_dec[0], 1)
    let sub1 = nested_dec[1]
    cki("nested_1_0", sub1[0], 2)
    cki("nested_1_1", sub1[1], 3)
    let sub2 = nested_dec[2]
    cki("nested_2_0", sub2[0], 4)
    cki("nested_2_1", sub2[1], 5)

    print("_cbor_test passed")
