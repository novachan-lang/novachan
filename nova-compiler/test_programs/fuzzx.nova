// fuzzx.nova — fuzzy string matching: Levenshtein edit distance + closest-match.
//
// The building block for spell-check, "did you mean?", fuzzy search, and typo
// tolerance. edit_distance is the classic Levenshtein DP (rolling rows, O(m*n)
// time, O(n) space), codepoint-correct so accented/multibyte text counts by
// characters, not bytes.

fn edit_distance(a_str, b_str)
  let a = code_points(a_str)
  let b = code_points(b_str)
  let m = len(a)
  let n = len(b)
  // prev[j] = distance of "" (empty a-prefix) vs b[0..j]
  let prev = []
  let j = 0
  while j <= n
    push(prev, j)
    j = j + 1
  let i = 1
  while i <= m
    let cur = []
    push(cur, i)                 // cur[0] = i deletions
    let k = 1
    while k <= n
      push(cur, 0)
      k = k + 1
    let jj = 1
    while jj <= n
      let cost = 1
      if a[i - 1] == b[jj - 1]
        cost = 0
      let del = prev[jj] + 1
      let ins = cur[jj - 1] + 1
      let sub = prev[jj - 1] + cost
      let best = del
      if ins < best
        best = ins
      if sub < best
        best = sub
      cur[jj] = best
      jj = jj + 1
    prev = cur
    i = i + 1
  prev[n]

// the candidate closest (smallest edit distance) to `target`.
fn closest(target, candidates)
  if len(candidates) == 0
    return ""
  let best = candidates[0]
  let best_d = edit_distance(target, best)
  let i = 1
  while i < len(candidates)
    let d = edit_distance(target, candidates[i])
    if d < best_d
      best_d = d
      best = candidates[i]
    i = i + 1
  best

// candidates within `max_dist` of target, in input order.
fn within(target, candidates, max_dist)
  let out = []
  for c in candidates
    if edit_distance(target, c) <= max_dist
      push(out, c)
  out

fn similar(a, b, max_dist)
  if edit_distance(a, b) <= max_dist
    return 1
  0

// ── Tests ────────────────────────────────────────────────────────────

assert(edit_distance("kitten", "sitting") == 3, "classic kitten->sitting = 3")
assert(edit_distance("abc", "abc") == 0, "identical = 0")
assert(edit_distance("", "abc") == 3, "empty to abc = 3 inserts")
assert(edit_distance("abc", "") == 3, "abc to empty = 3 deletes")
assert(edit_distance("flaw", "lawn") == 2, "flaw->lawn = 2")
assert(edit_distance("color", "colour") == 1, "one insertion")
print("PASS: edit_distance")

let cands = ["hello", "world", "help", "shell"]
assert(closest("helo", cands) == "hello", "helo -> hello (dist 1)")
assert(closest("wrld", cands) == "world", "wrld -> world")
assert(closest("shel", cands) == "shell", "shel -> shell")
print("PASS: closest (did-you-mean)")

let near = within("help", ["hello", "help", "helm", "world"], 1)
assert(len(near) == 2, "help, helm within distance 1")
assert(near[0] == "help", "exact match included")
assert(near[1] == "helm", "helm within 1")
print("PASS: within threshold")

assert(similar("color", "colour", 1) == 1, "color~colour within 1")
assert(similar("cat", "dog", 1) == 0, "cat not similar to dog")
print("PASS: similar")

print("ALL PASS: fuzzx — Levenshtein edit distance + fuzzy matching")
