import forge_audit_logger

fn main()
    let a = al_new()
    a = al_log(a, "admin", "create", "user:1", 1000)
    a = al_log(a, "admin", "update", "user:1", 2000)
    a = al_log(a, "bob", "delete", "doc:5", 3000)

    assert(al_entry_count(a) == 3, "3 entries")
    assert(al_entry_actor(a, 0) == "admin", "actor 0")
    assert(al_entry_action(a, 1) == "update", "action 1")
    assert(al_entry_resource(a, 2) == "doc:5", "resource 2")

    assert(al_verify_chain(a) == 1, "chain valid")

    let h = al_current_hash(a)
    assert(h > 0, "hash positive")

    print("AUDIT-LOGGER KAT PASS")
