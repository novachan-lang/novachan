// KAT test for std/data/plist — Apple XML property-list parser
import "std/data/plist"

// KAT 1: dict with string and integer values
let x = "<dict><key>name</key><string>nova</string><key>version</key><integer>2</integer></dict>"
let d = plst_parse(x)
if d["name"] != "nova"
    print("FAIL KAT1a: d[name] expected nova got " + str(d["name"]))
    exit(1)
if d["version"] != 2
    print("FAIL KAT1b: d[version] expected 2 got " + str(d["version"]))
    exit(1)

// KAT 2: array of integers
let a = plst_parse("<array><integer>1</integer><integer>2</integer></array>")
if len(a) != 2
    print("FAIL KAT2a: array len expected 2 got " + str(len(a)))
    exit(1)
if a[0] != 1
    print("FAIL KAT2b: a[0] expected 1 got " + str(a[0]))
    exit(1)
if a[1] != 2
    print("FAIL KAT2c: a[1] expected 2 got " + str(a[1]))
    exit(1)

// KAT 3: bare integer
let iv = plst_parse("<integer>42</integer>")
if iv != 42
    print("FAIL KAT3: integer expected 42 got " + str(iv))
    exit(1)

// KAT 4: bare string
let sv = plst_parse("<string>hi</string>")
if sv != "hi"
    print("FAIL KAT4: string expected hi got " + str(sv))
    exit(1)

// KAT 5: plst_get existing key
let g1 = plst_get(d, "name", "")
if g1 != "nova"
    print("FAIL KAT5: plst_get name expected nova got " + str(g1))
    exit(1)

// KAT 6: plst_get missing key returns default
let g2 = plst_get(d, "missing", "x")
if g2 != "x"
    print("FAIL KAT6: plst_get missing expected x got " + str(g2))
    exit(1)

// KAT 7: true and false self-closing tags
let tv = plst_parse("<true/>")
if tv != 1
    print("FAIL KAT7a: true/ expected 1 got " + str(tv))
    exit(1)
let fv = plst_parse("<false/>")
if fv != 0
    print("FAIL KAT7b: false/ expected 0 got " + str(fv))
    exit(1)

// KAT 8: plist wrapper stripping
let wrapped = "<?xml version=" + chr(34) + "1.0" + chr(34) + "?><plist version=" + chr(34) + "1.0" + chr(34) + "><string>wrapped</string></plist>"
let wv = plst_parse(wrapped)
if wv != "wrapped"
    print("FAIL KAT8: wrapped plist expected wrapped got " + str(wv))
    exit(1)

// KAT 9: nested dict inside array
let nested = "<array><dict><key>x</key><integer>7</integer></dict></array>"
let na = plst_parse(nested)
if len(na) != 1
    print("FAIL KAT9a: nested array len expected 1 got " + str(len(na)))
    exit(1)
let nd = na[0]
if nd["x"] != 7
    print("FAIL KAT9b: nested dict x expected 7 got " + str(nd["x"]))
    exit(1)

// KAT 10: XML entity unescaping in string
let esc = "<string>a&lt;b&amp;c</string>"
let ev = plst_parse(esc)
if ev != "a<b&c"
    print("FAIL KAT10: entity unescape expected a<b&c got " + str(ev))
    exit(1)

print("_plist_test passed")
