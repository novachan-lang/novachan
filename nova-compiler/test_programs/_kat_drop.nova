// KAT L10 Drop: a type's `drop` method runs when the object is RELEASED, and can still
// read its fields (drop runs BEFORE the fields are freed -- the same order Rust uses).
//
// SCOPE, stated honestly: this fires wherever the refcount actually reaches zero --
// reassignment, container destruction, explicit release. It does NOT yet fire at SCOPE
// EXIT, because NOVA does not release locals when a function returns. That is a separate
// RC feature (scope-exit release), previously attempted and reverted as unsound. So this
// gives destructors, not yet RAII.
let log = []

type Res
    r_name: string
    r_id: int

fn Res.drop(self)
    push(log, "dropped:" + self.r_name + "#" + str(self.r_id))

fn main()
    let ok = 0
    let fail = 0

    // reassignment releases the previous value -> drop must fire, and must still see fields
    let x = Res("alpha", 1)
    if x.r_name == "alpha"
        ok = ok + 1
    x = Res("beta", 2)
    if contains(join(log, "|"), "dropped:alpha#1")
        ok = ok + 1
        print("ok: drop ran on reassignment and read its fields")
    else
        fail = fail + 1
        print("FAIL drop did not run on reassignment (log=" + join(log, "|") + ")")

    // the live object must NOT have been dropped
    if contains(join(log, "|"), "dropped:beta#2") == false and x.r_name == "beta"
        ok = ok + 1
        print("ok: the live object was not dropped")
    else
        fail = fail + 1
        print("FAIL the live object was dropped early")

    // a type WITHOUT a drop method must still be destroyed normally (no crash, no hook)
    let plain = [1, 2, 3]
    plain = []
    if len(plain) == 0
        ok = ok + 1
        print("ok: types without drop are unaffected")

    print("ok=" + str(ok) + " fail=" + str(fail))
    if fail == 0
        print("KAT drop PASS")
    else
        print("KAT drop FAIL")
