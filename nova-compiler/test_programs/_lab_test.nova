// KAT for std/color/lab — CIE L*a*b* color science.
// Known-answer values computed from the CIE 1976 L*a*b* standard
// using D65 white point (Xn=95.047, Yn=100.0, Zn=108.883).
import std/color/lab

// ckf — check float within epsilon; print FAIL + exit(1) on mismatch.
fn ckf(label: str, got: float, want: float, eps: float)
    let diff = got - want
    let adiff = diff
    if diff < 0.0
        let neg = 0.0 - diff
        adiff = neg
    if adiff > eps
        print("FAIL " + label + ": got " + str(got) + " want " + str(want) + " eps " + str(eps))
        exit(1)

// cki — check int equality; print FAIL + exit(1) on mismatch.
fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// ckiclose — check int within tolerance; print FAIL + exit(1) on mismatch.
fn ckiclose(label: str, got: int, want: int, tol: int)
    let diff = got - want
    let adiff = diff
    if diff < 0
        adiff = 0 - diff
    if adiff > tol
        print("FAIL " + label + ": got " + str(got) + " want " + str(want) + " tol " + str(tol))
        exit(1)

fn main()
    // KAT 1: lab_from_rgb([255,255,255])[0] == 100.0 (L of white)
    // White maps to XYZ=[95.047,100,108.883], f(1.0)=1.0, L=116*1-16=100.
    let white = [255, 255, 255]
    let lab_white = lab_from_rgb(white)
    let L_white = lab_white[0]
    ckf("lab_from_rgb_white_L", L_white, 100.0, 0.5)

    // KAT 2: lab_from_rgb([0,0,0])[0] == 0.0 (L of black)
    // Black maps to XYZ=[0,0,0], f(0)=4/29*... -> L=0.
    let black = [0, 0, 0]
    let lab_black = lab_from_rgb(black)
    let L_black = lab_black[0]
    ckf("lab_from_rgb_black_L", L_black, 0.0, 0.5)

    // KAT 3: lab_delta_e([255,255,255],[255,255,255]) == 0.0
    // Same color, distance is zero.
    let de_same_white = lab_delta_e(white, white)
    ckf("lab_delta_e_same_white", de_same_white, 0.0, 0.5)

    // KAT 4: lab_delta_e([255,0,0],[255,0,0]) == 0.0
    // Same red color, distance is zero.
    let red = [255, 0, 0]
    let de_same_red = lab_delta_e(red, red)
    ckf("lab_delta_e_same_red", de_same_red, 0.0, 0.5)

    // KAT 5: lab_delta_e([0,0,0],[255,255,255]) == 100.0 (ckf eps 0.5)
    // Black lab=[0,0,0], white lab=[100,0,0], distance=sqrt(100^2)=100.
    let de_bw = lab_delta_e(black, white)
    ckf("lab_delta_e_black_white", de_bw, 100.0, 0.5)

    // KAT 6: round-trip lab_to_rgb(lab_from_rgb([120,80,200])) within +/-4 per channel.
    let purple = [120, 80, 200]
    let purple_lab = lab_from_rgb(purple)
    let Lp = purple_lab[0]
    let ap = purple_lab[1]
    let bp = purple_lab[2]
    let purple_rt = lab_to_rgb(Lp, ap, bp)
    let pr = purple_rt[0]
    let pg = purple_rt[1]
    let pb = purple_rt[2]
    ckiclose("lab_roundtrip_r", pr, 120, 4)
    ckiclose("lab_roundtrip_g", pg, 80, 4)
    ckiclose("lab_roundtrip_b", pb, 200, 4)

    // KAT 7: lab_from_rgb white a* and b* channels are near 0
    // White is achromatic: a*~0, b*~0
    let a_white = lab_white[1]
    let b_white = lab_white[2]
    ckf("lab_from_rgb_white_a", a_white, 0.0, 0.5)
    ckf("lab_from_rgb_white_b", b_white, 0.0, 0.5)

    print("_lab_test passed")
