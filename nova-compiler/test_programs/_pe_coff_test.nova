import std/os/pe_coff

fn ck_bool(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL _pe_coff_test " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn ck_int(label: string, got: int, want: int)
    if got != want
        print("FAIL _pe_coff_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck_str(label: string, got: string, want: string)
    if got != want
        print("FAIL _pe_coff_test " + label + ": got=" + got + " want=" + want)
        exit(1)

fn _pad(buf: any, n: int)
    while len(buf) < n
        push(buf, 0)

// Build a minimal PE32+ AMD64 buffer
// DOS header: MZ at 0, e_lfanew=128 at offset 60
let buf = []
push(buf, 77)
push(buf, 90)
_pad(buf, 60)
// e_lfanew = 128 as u32le: 128,0,0,0
push(buf, 128)
push(buf, 0)
push(buf, 0)
push(buf, 0)
// Pad from 64 to 128
_pad(buf, 128)
// PE signature at offset 128: 'P','E',0,0
push(buf, 80)
push(buf, 69)
push(buf, 0)
push(buf, 0)
// COFF: Machine = 0x8664 (AMD64) u16le at lfanew+4 = offset 132
// 0x8664 = 34404; low=0x64=100, high=0x86=134
push(buf, 100)
push(buf, 134)
// NumberOfSections = 3 u16le at lfanew+6 = offset 134
push(buf, 3)
push(buf, 0)
// Pad to at least 160
_pad(buf, 160)

ck_bool("dos_check", pe_dos_check(buf), true)
ck_int("e_lfanew", pe_e_lfanew(buf), 128)
ck_bool("nt_sig", pe_nt_signature_check(buf), true)
ck_int("machine", pe_machine(buf), 34404)
ck_str("machine_name", pe_machine_name(buf), "x86-64")
ck_int("num_sections", pe_num_sections(buf), 3)
ck_bool("is_valid", pe_is_valid(buf), true)

// Negative: buffer with wrong magic
let bad = [0, 0, 0, 0]
ck_bool("bad_dos", pe_dos_check(bad), false)
ck_bool("bad_valid", pe_is_valid(bad), false)

// Empty buffer
let empty = []
ck_bool("empty_dos", pe_dos_check(empty), false)

print("PASS _pe_coff_test")
