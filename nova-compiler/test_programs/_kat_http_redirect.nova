// #16: HTTP client follows redirects. A spawned loopback server answers the first request with a
// 302 -> Location /final, the second (the follow) with 200 "arrived". http_get_follow must chase
// the redirect and return the FINAL body. Self-contained (no external network).
import forge
import forge_http_client

fn main()
    let port = 18091
    spawn fn()
        let sock = http_listen(port)
        let c1 = http_accept_raw(sock)
        if len(c1) > 0
            // RELATIVE Location -> must resolve against the request origin (tests resolve_location)
            http_send_raw(c1[0], "HTTP/1.1 302 Found\r\nLocation: /final\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
        let c2 = http_accept_raw(sock)
        if len(c2) > 0
            http_send_raw(c2[0], "HTTP/1.1 200 OK\r\nContent-Length: 7\r\nConnection: close\r\n\r\narrived")
    sleep(800)
    match forge_http_client.http_get_follow("http://127.0.0.1:{port}/start", 5)
        Ok(resp) =>
            if resp.status == 200 and resp.body == "arrived"
                print("PASS _kat_http_redirect")
            else
                print("FAIL status={resp.status} body=[{resp.body}]")
        Err(e) =>
            print("FAIL err={e}")
