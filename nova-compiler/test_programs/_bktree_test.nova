// KAT for std/collections/bktree
import std/collections/bktree

fn main()
    let t = bk_new()
    bk_insert(t, "book")
    bk_insert(t, "books")
    bk_insert(t, "cake")
    bk_insert(t, "boo")
    bk_insert(t, "cape")
    bk_insert(t, "boon")
    bk_insert(t, "cook")

    // KAT 1: size == 7
    let sz = bk_size(t)
    if sz != 7
        print("FAIL: bk_size expected 7 got " + str(sz))
        exit(1)

    // KAT 2: bk_query(t,"book",0) == ["book"]
    let q0 = bk_query(t, "book", 0)
    if len(q0) != 1
        print("FAIL: query maxdist=0 expected 1 result got " + str(len(q0)))
        exit(1)
    if q0[0] != "book"
        print("FAIL: query maxdist=0 expected book got " + q0[0])
        exit(1)

    // KAT 3: bk_query(t,"book",1) sorted == ["boo","book","boon","books","cook"]
    // Levenshtein distances from "book":
    //   book->boo  = 1, book->book = 0, book->boon = 1, book->books = 1, book->cook = 1
    //   book->cake = 4, book->cape = 4  (excluded)
    let q1 = bk_query(t, "book", 1)
    if len(q1) != 5
        print("FAIL: query maxdist=1 expected 5 results got " + str(len(q1)))
        exit(1)
    if q1[0] != "boo"
        print("FAIL: q1[0] expected boo got " + q1[0])
        exit(1)
    if q1[1] != "book"
        print("FAIL: q1[1] expected book got " + q1[1])
        exit(1)
    if q1[2] != "books"
        print("FAIL: q1[2] expected books got " + q1[2])
        exit(1)
    if q1[3] != "boon"
        print("FAIL: q1[3] expected boon got " + q1[3])
        exit(1)
    if q1[4] != "cook"
        print("FAIL: q1[4] expected cook got " + q1[4])
        exit(1)

    // KAT 4: bk_contains(t,"cake") == true (1)
    let c1 = bk_contains(t, "cake")
    if c1 != 1
        print("FAIL: bk_contains cake expected 1 got " + str(c1))
        exit(1)

    // KAT 5: bk_contains(t,"xyz") == false (0)
    let c2 = bk_contains(t, "xyz")
    if c2 != 0
        print("FAIL: bk_contains xyz expected 0 got " + str(c2))
        exit(1)

    // KAT 6: duplicate insert does not grow size
    bk_insert(t, "book")
    let sz2 = bk_size(t)
    if sz2 != 7
        print("FAIL: duplicate insert changed size to " + str(sz2))
        exit(1)

    print("_bktree_test passed")
