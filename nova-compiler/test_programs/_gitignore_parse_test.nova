import std/devtool/gitignore_parse

fn main()
    // --- gip_is_blank ---
    if gip_is_blank("") != 1
        print("FAIL gip_is_blank-empty")
        exit(1)
    if gip_is_blank("foo") != 0
        print("FAIL gip_is_blank-nonempty")
        exit(1)
    if gip_is_blank("  ") != 1
        print("FAIL gip_is_blank-spaces")
        exit(1)

    // --- gip_is_comment ---
    if gip_is_comment("# hello") != 1
        print("FAIL gip_is_comment-plain")
        exit(1)
    if gip_is_comment("foo") != 0
        print("FAIL gip_is_comment-not")
        exit(1)
    if gip_is_comment("  # x") != 1
        print("FAIL gip_is_comment-leading-space")
        exit(1)

    // --- gip_strip_trailing_spaces ---
    let s1 = gip_strip_trailing_spaces("foo  ")
    if s1 != "foo"
        print("FAIL gip_strip_trailing_spaces-plain: got '" + s1 + "'")
        exit(1)

    let bslash = chr(92)
    let s2 = gip_strip_trailing_spaces("foo" + bslash + " ")
    let want2 = "foo" + bslash + " "
    if s2 != want2
        print("FAIL gip_strip_trailing_spaces-escaped: got '" + s2 + "'")
        exit(1)

    let s3 = gip_strip_trailing_spaces("noSpaces")
    if s3 != "noSpaces"
        print("FAIL gip_strip_trailing_spaces-none")
        exit(1)

    // --- gip_parse_line ---
    let r1 = gip_parse_line("*.log", 1)
    if len(r1) != 1
        print("FAIL gip_parse_line-star-count: got " + str(len(r1)))
        exit(1)
    let rec1 = r1[0]
    if rec1[0] != "*.log" or rec1[1] != 0 or rec1[2] != 0 or rec1[3] != 0 or rec1[4] != 1
        print("FAIL gip_parse_line-star: got " + str(rec1))
        exit(1)

    let r2 = gip_parse_line("!important.log", 2)
    if len(r2) != 1
        print("FAIL gip_parse_line-negated-count")
        exit(1)
    let rec2 = r2[0]
    if rec2[0] != "important.log" or rec2[1] != 1 or rec2[2] != 0 or rec2[3] != 0 or rec2[4] != 2
        print("FAIL gip_parse_line-negated: got " + str(rec2))
        exit(1)

    let r3 = gip_parse_line("build/", 3)
    if len(r3) != 1
        print("FAIL gip_parse_line-dir-count")
        exit(1)
    let rec3 = r3[0]
    if rec3[0] != "build" or rec3[1] != 0 or rec3[2] != 1 or rec3[3] != 0 or rec3[4] != 3
        print("FAIL gip_parse_line-dir: got " + str(rec3))
        exit(1)

    let r4 = gip_parse_line("src/main.rs", 4)
    if len(r4) != 1
        print("FAIL gip_parse_line-anchored-count")
        exit(1)
    let rec4 = r4[0]
    if rec4[0] != "src/main.rs" or rec4[1] != 0 or rec4[2] != 0 or rec4[3] != 1 or rec4[4] != 4
        print("FAIL gip_parse_line-anchored: got " + str(rec4))
        exit(1)

    let r5 = gip_parse_line("# comment", 5)
    if len(r5) != 0
        print("FAIL gip_parse_line-comment: got len " + str(len(r5)))
        exit(1)

    let r6 = gip_parse_line("", 6)
    if len(r6) != 0
        print("FAIL gip_parse_line-blank: got len " + str(len(r6)))
        exit(1)

    // leading "/" should strip but still mark anchored
    let r7 = gip_parse_line("/root.txt", 7)
    let rec7 = r7[0]
    if rec7[0] != "root.txt" or rec7[3] != 1
        print("FAIL gip_parse_line-leading-slash: got " + str(rec7))
        exit(1)

    // --- gip_parse ---
    let text = "*.log\n# comment\n!keep.log\nbuild/\n"
    let recs = gip_parse(text)
    if len(recs) != 3
        print("FAIL gip_parse-count: got " + str(len(recs)))
        exit(1)
    if recs[0][0] != "*.log"
        print("FAIL gip_parse-rec0")
        exit(1)
    if recs[1][0] != "keep.log" or recs[1][1] != 1
        print("FAIL gip_parse-rec1")
        exit(1)
    if recs[2][0] != "build" or recs[2][2] != 1
        print("FAIL gip_parse-rec2")
        exit(1)

    print("PASS _gitignore_parse_test")
