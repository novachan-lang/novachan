// Runtime type identity (RTTI): type_name(v) reports the runtime kind of an
// Any-typed value as a string -- NOVA's safe answer to a downcast. Lets you
// inspect heterogeneous data (json, generic containers) without static types.

type Point
    x: int
    y: int

fn describe(v: any) -> string
    // dispatch on the runtime kind of an Any value
    let k = type_name(v)
    if k == "list"
        return "a list"
    if k == "dict"
        return "a dict"
    if k == "string"
        return "a string"
    if k == "int"
        return "an int"
    if k == "float"
        return "a float"
    if k == "bool"
        return "a bool"
    if k == "struct"
        return "a struct"
    return "unknown"

fn main()
    // direct value kinds -- the rock-solid cases
    assert_eq(type_name(42), "int")
    assert_eq(type_name("hello"), "string")
    assert_eq(type_name([1, 2, 3]), "list")
    assert_eq(type_name({"a": 1}), "dict")
    assert_eq(type_name(Point(1, 2)), "struct")

    // A float that arrives *boxed* -- e.g. straight out of json_decode or any
    // Any-returning API -- reports "float". (Numeric-subtype residual: an UNBOXED
    // scalar float, and a bool -- which is a raw 0/1 indistinguishable from an int
    // by representation -- report "int". This is the same value-model residual
    // tracked for the int/float boxing fix, not specific to type_name.)
    let f = json_decode("3.14")
    assert_eq(type_name(f), "float")

    // a heterogeneous list inspected element-by-element via type_name
    let mixed = [1, "two", [3]]
    assert_eq(type_name(mixed[0]), "int")
    assert_eq(type_name(mixed[1]), "string")
    assert_eq(type_name(mixed[2]), "list")

    // the RTTI use case: runtime dispatch on an Any
    assert_eq(describe([1]), "a list")
    assert_eq(describe("x"), "a string")
    assert_eq(describe(Point(0, 0)), "a struct")

    print("typename passed")
