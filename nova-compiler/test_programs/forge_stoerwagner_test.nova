import forge_stoerwagner

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

// brute-force global min cut: min over all partitions (vertex 0 fixed in A, B non-empty)
fn brute(graph: list, n: int) -> int
    let best = 1000000000
    let total = 1 << (n - 1)
    let mask = 1
    while mask < total
        let cut = 0
        let i = 0
        while i < n
            let j = i + 1
            while j < n
                let bi = 0
                if i > 0
                    bi = (mask >> (i - 1)) & 1
                let bj = 0
                if j > 0
                    bj = (mask >> (j - 1)) & 1
                if bi != bj
                    cut = cut + graph[i][j]
                j = j + 1
            i = i + 1
        if cut < best
            best = cut
        mask = mask + 1
    best

fn main()
    let fails = 0

    // 4-node weighted graph, known global min cut = 5 (isolate vertex 0)
    let g = []
    push(g, [0, 2, 3, 0])
    push(g, [2, 0, 1, 4])
    push(g, [3, 1, 0, 5])
    push(g, [0, 4, 5, 0])
    fails = fails + expect("g_cut", str(min_cut(g)), "5")
    fails = fails + expect("g_brute", str(min_cut(g)), str(brute(g, 4)))

    // 4-cycle, unit weights -> min cut 2
    let cyc = []
    push(cyc, [0, 1, 0, 1])
    push(cyc, [1, 0, 1, 0])
    push(cyc, [0, 1, 0, 1])
    push(cyc, [1, 0, 1, 0])
    fails = fails + expect("cycle", str(min_cut(cyc)), "2")

    // two triangles joined by a single bridge of weight 1 -> min cut 1
    let br = []
    push(br, [0, 3, 3, 0, 0, 0])
    push(br, [3, 0, 3, 0, 0, 0])
    push(br, [3, 3, 0, 1, 0, 0])
    push(br, [0, 0, 1, 0, 3, 3])
    push(br, [0, 0, 0, 3, 0, 3])
    push(br, [0, 0, 0, 3, 3, 0])
    fails = fails + expect("bridge", str(min_cut(br)), "1")
    fails = fails + expect("bridge_brute", str(min_cut(br)), str(brute(br, 6)))

    // 2 nodes
    let two = []
    push(two, [0, 7])
    push(two, [7, 0])
    fails = fails + expect("two", str(min_cut(two)), "7")

    // star: center connected to 3 leaves weight 2 each -> min cut 2 (isolate a leaf)
    let star = []
    push(star, [0, 2, 2, 2])
    push(star, [2, 0, 0, 0])
    push(star, [2, 0, 0, 0])
    push(star, [2, 0, 0, 0])
    fails = fails + expect("star", str(min_cut(star)), "2")

    if fails == 0
        print("forge_stoerwagner: all passed")
    else
        print("forge_stoerwagner: " + str(fails) + " FAILED")
