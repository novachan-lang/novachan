// _kat_fleet8.nova — combined KAT for 6 new stdlib modules:
//   std/algo/pancake_sort, std/algo/cycle_sort, std/collections/sparse_vector,
//   std/math/lucas_theorem, std/math/tonelli_shanks, std/crypto/discrete_log
import std/algo/pancake_sort
import std/algo/cycle_sort
import std/collections/sparse_vector
import std/math/lucas_theorem
import std/math/tonelli_shanks
import std/crypto/discrete_log

// _lst_to_str — comma-joined string rendering of a list (int or float
// elements), used since to_json is not available as a bare builtin here.
fn _lst_to_str(lst)
    let out = []
    let i = 0
    let n = len(lst)
    while i < n
        push(out, str(lst[i]))
        i = i + 1
    return join(out, ",")

fn main()
    let fails = 0
    let checks = 0

    // ===== pancake_sort (pcs_) =====
    let pf1 = pcs_flip([1, 2, 3, 4], 2)
    if pf1[0] == 3 and pf1[1] == 2 and pf1[2] == 1 and pf1[3] == 4
        print("ok pcs_flip_basic")
    else
        print("FAIL pcs_flip_basic got=" + _lst_to_str(pf1))
        fails = fails + 1
    checks = checks + 1

    let pf2 = pcs_flip([5], 0)
    if pf2[0] == 5
        print("ok pcs_flip_single")
    else
        print("FAIL pcs_flip_single got=" + _lst_to_str(pf2))
        fails = fails + 1
    checks = checks + 1

    let pmi = pcs_max_idx([3, 1, 4, 1, 5, 9, 2, 6], 8)
    if pmi == 5
        print("ok pcs_max_idx")
    else
        print("FAIL pcs_max_idx got=" + str(pmi))
        fails = fails + 1
    checks = checks + 1

    let pmi2 = pcs_max_idx([1], 1)
    if pmi2 == 0
        print("ok pcs_max_idx_single")
    else
        print("FAIL pcs_max_idx_single got=" + str(pmi2))
        fails = fails + 1
    checks = checks + 1

    let ps1 = pcs_sort([5, 3, 4, 1, 2])
    if _lst_to_str(ps1) == "1,2,3,4,5"
        print("ok pcs_sort_basic")
    else
        print("FAIL pcs_sort_basic got=" + _lst_to_str(ps1))
        fails = fails + 1
    checks = checks + 1

    let ps2 = pcs_sort([1])
    if _lst_to_str(ps2) == "1"
        print("ok pcs_sort_singleton")
    else
        print("FAIL pcs_sort_singleton got=" + _lst_to_str(ps2))
        fails = fails + 1
    checks = checks + 1

    let ps3 = pcs_sort([])
    if len(ps3) == 0
        print("ok pcs_sort_empty")
    else
        print("FAIL pcs_sort_empty got=" + _lst_to_str(ps3))
        fails = fails + 1
    checks = checks + 1

    let ps4 = pcs_sort([2, 2, 2])
    if _lst_to_str(ps4) == "2,2,2"
        print("ok pcs_sort_dups")
    else
        print("FAIL pcs_sort_dups got=" + _lst_to_str(ps4))
        fails = fails + 1
    checks = checks + 1

    let ps5 = pcs_sort([-3, 5, 0, -1])
    if _lst_to_str(ps5) == "-3,-1,0,5"
        print("ok pcs_sort_negatives")
    else
        print("FAIL pcs_sort_negatives got=" + _lst_to_str(ps5))
        fails = fails + 1
    checks = checks + 1

    if pcs_is_sorted([1, 2, 3])
        print("ok pcs_is_sorted_true")
    else
        print("FAIL pcs_is_sorted_true")
        fails = fails + 1
    checks = checks + 1

    if not pcs_is_sorted([3, 2, 1])
        print("ok pcs_is_sorted_false")
    else
        print("FAIL pcs_is_sorted_false")
        fails = fails + 1
    checks = checks + 1

    let psd = pcs_sort_desc([1, 4, 2])
    if _lst_to_str(psd) == "4,2,1"
        print("ok pcs_sort_desc")
    else
        print("FAIL pcs_sort_desc got=" + _lst_to_str(psd))
        fails = fails + 1
    checks = checks + 1

    let pfc1 = pcs_flip_count([5, 3, 4, 1, 2])
    if pfc1 == 4
        print("ok pcs_flip_count_basic")
    else
        print("FAIL pcs_flip_count_basic got=" + str(pfc1))
        fails = fails + 1
    checks = checks + 1

    let pfc2 = pcs_flip_count([1, 2, 3])
    if pfc2 == 0
        print("ok pcs_flip_count_sorted")
    else
        print("FAIL pcs_flip_count_sorted got=" + str(pfc2))
        fails = fails + 1
    checks = checks + 1

    let pfc3 = pcs_flip_count([2, 1])
    if pfc3 == 1
        print("ok pcs_flip_count_pair")
    else
        print("FAIL pcs_flip_count_pair got=" + str(pfc3))
        fails = fails + 1
    checks = checks + 1

    // ===== cycle_sort (cys_) =====
    let cs1 = cys_sort([4, 3, 2, 1])
    if _lst_to_str(cs1) == "1,2,3,4"
        print("ok cys_sort_basic")
    else
        print("FAIL cys_sort_basic got=" + _lst_to_str(cs1))
        fails = fails + 1
    checks = checks + 1

    let cs2 = cys_sort([5, 1, 4, 2, 8, 0, 2])
    if _lst_to_str(cs2) == "0,1,2,2,4,5,8"
        print("ok cys_sort_with_dups")
    else
        print("FAIL cys_sort_with_dups got=" + _lst_to_str(cs2))
        fails = fails + 1
    checks = checks + 1

    let cs3 = cys_sort([])
    if len(cs3) == 0
        print("ok cys_sort_empty")
    else
        print("FAIL cys_sort_empty got=" + _lst_to_str(cs3))
        fails = fails + 1
    checks = checks + 1

    let cs4 = cys_sort([7])
    if _lst_to_str(cs4) == "7"
        print("ok cys_sort_singleton")
    else
        print("FAIL cys_sort_singleton got=" + _lst_to_str(cs4))
        fails = fails + 1
    checks = checks + 1

    let cs5 = cys_sort([2, 2, 2])
    if _lst_to_str(cs5) == "2,2,2"
        print("ok cys_sort_all_dups")
    else
        print("FAIL cys_sort_all_dups got=" + _lst_to_str(cs5))
        fails = fails + 1
    checks = checks + 1

    let cs6 = cys_sort([3, 3, 1, 2])
    if _lst_to_str(cs6) == "1,2,3,3"
        print("ok cys_sort_mixed_dups")
    else
        print("FAIL cys_sort_mixed_dups got=" + _lst_to_str(cs6))
        fails = fails + 1
    checks = checks + 1

    let csd = cys_sort_desc([1, 3, 2])
    if _lst_to_str(csd) == "3,2,1"
        print("ok cys_sort_desc")
    else
        print("FAIL cys_sort_desc got=" + _lst_to_str(csd))
        fails = fails + 1
    checks = checks + 1

    if cys_is_sorted([1, 2, 3])
        print("ok cys_is_sorted_true")
    else
        print("FAIL cys_is_sorted_true")
        fails = fails + 1
    checks = checks + 1

    if not cys_is_sorted([2, 1])
        print("ok cys_is_sorted_false")
    else
        print("FAIL cys_is_sorted_false")
        fails = fails + 1
    checks = checks + 1

    let cwc1 = cys_write_count([1, 2, 3, 4, 5])
    if cwc1 == 0
        print("ok cys_write_count_sorted")
    else
        print("FAIL cys_write_count_sorted got=" + str(cwc1))
        fails = fails + 1
    checks = checks + 1

    let cwc2 = cys_write_count([1, 3, 2])
    if cwc2 == 2
        print("ok cys_write_count_cycle")
    else
        print("FAIL cys_write_count_cycle got=" + str(cwc2))
        fails = fails + 1
    checks = checks + 1

    // ===== sparse_vector (spv_) =====
    let v1 = spv_from_dense([0.0, 3.0, 0.0, 5.0, 0.0, 2.0])
    let v1idx = v1["idx"]
    let v1val = v1["val"]
    if _lst_to_str(v1idx) == "1.0,3.0,5.0" and _lst_to_str(v1val) == "3.0,5.0,2.0"
        print("ok spv_from_dense_v1")
    else
        print("FAIL spv_from_dense_v1 idx=" + _lst_to_str(v1idx) + " val=" + _lst_to_str(v1val))
        fails = fails + 1
    checks = checks + 1

    let v2 = spv_from_dense([1.0, 0.0, 0.0, 2.0, 0.0, 4.0])

    let spnnz = spv_nnz(v1)
    if spnnz == 3
        print("ok spv_nnz")
    else
        print("FAIL spv_nnz got=" + str(spnnz))
        fails = fails + 1
    checks = checks + 1

    let spg1 = spv_get(v1, 3)
    if spg1 == 5.0
        print("ok spv_get_present")
    else
        print("FAIL spv_get_present got=" + str(spg1))
        fails = fails + 1
    checks = checks + 1

    let spg2 = spv_get(v1, 2)
    if spg2 == 0.0
        print("ok spv_get_absent")
    else
        print("FAIL spv_get_absent got=" + str(spg2))
        fails = fails + 1
    checks = checks + 1

    let dense1 = spv_to_dense(v1, 6)
    if _lst_to_str(dense1) == "0.0,3.0,0.0,5.0,0.0,2.0"
        print("ok spv_to_dense")
    else
        print("FAIL spv_to_dense got=" + _lst_to_str(dense1))
        fails = fails + 1
    checks = checks + 1

    let vadd = spv_add(v1, v2)
    let vaddidx = vadd["idx"]
    let vaddval = vadd["val"]
    if _lst_to_str(vaddidx) == "0.0,1.0,3.0,5.0" and _lst_to_str(vaddval) == "1.0,3.0,7.0,6.0"
        print("ok spv_add")
    else
        print("FAIL spv_add idx=" + _lst_to_str(vaddidx) + " val=" + _lst_to_str(vaddval))
        fails = fails + 1
    checks = checks + 1

    let vsub = spv_sub(v1, v2)
    let vsubidx = vsub["idx"]
    let vsubval = vsub["val"]
    if _lst_to_str(vsubidx) == "0.0,1.0,3.0,5.0" and _lst_to_str(vsubval) == "-1.0,3.0,3.0,-2.0"
        print("ok spv_sub")
    else
        print("FAIL spv_sub idx=" + _lst_to_str(vsubidx) + " val=" + _lst_to_str(vsubval))
        fails = fails + 1
    checks = checks + 1

    let vscale = spv_scale(v1, 2.0)
    let vscaleval = vscale["val"]
    if _lst_to_str(vscaleval) == "6.0,10.0,4.0"
        print("ok spv_scale")
    else
        print("FAIL spv_scale got=" + _lst_to_str(vscaleval))
        fails = fails + 1
    checks = checks + 1

    let vneg = spv_negate(v1)
    let vnegval = vneg["val"]
    if _lst_to_str(vnegval) == "-3.0,-5.0,-2.0"
        print("ok spv_negate")
    else
        print("FAIL spv_negate got=" + _lst_to_str(vnegval))
        fails = fails + 1
    checks = checks + 1

    let vdot = spv_dot(v1, v2)
    if vdot == 18.0
        print("ok spv_dot")
    else
        print("FAIL spv_dot got=" + str(vdot))
        fails = fails + 1
    checks = checks + 1

    let vn1 = spv_norm1(v1)
    if vn1 == 10.0
        print("ok spv_norm1")
    else
        print("FAIL spv_norm1 got=" + str(vn1))
        fails = fails + 1
    checks = checks + 1

    let v3 = spv_from_dense([3.0, 4.0])
    let vn2 = spv_norm2(v3)
    if vn2 == 5.0
        print("ok spv_norm2")
    else
        print("FAIL spv_norm2 got=" + str(vn2))
        fails = fails + 1
    checks = checks + 1

    if spv_equal(v1, v1)
        print("ok spv_equal_true")
    else
        print("FAIL spv_equal_true")
        fails = fails + 1
    checks = checks + 1

    if not spv_equal(v1, v2)
        print("ok spv_equal_false")
    else
        print("FAIL spv_equal_false")
        fails = fails + 1
    checks = checks + 1

    let vzero = spv_from_dense([0.0, 0.0, 0.0])
    if spv_is_zero(vzero)
        print("ok spv_is_zero_true")
    else
        print("FAIL spv_is_zero_true")
        fails = fails + 1
    checks = checks + 1

    if not spv_is_zero(v1)
        print("ok spv_is_zero_false")
    else
        print("FAIL spv_is_zero_false")
        fails = fails + 1
    checks = checks + 1

    // ===== lucas_theorem (luct_) =====
    let ld1 = luct_digits(11, 2)
    if _lst_to_str(ld1) == "1,1,0,1"
        print("ok luct_digits_11_2")
    else
        print("FAIL luct_digits_11_2 got=" + _lst_to_str(ld1))
        fails = fails + 1
    checks = checks + 1

    let ld2 = luct_digits(100, 10)
    if _lst_to_str(ld2) == "0,0,1"
        print("ok luct_digits_100_10")
    else
        print("FAIL luct_digits_100_10 got=" + _lst_to_str(ld2))
        fails = fails + 1
    checks = checks + 1

    let lsb1 = luct_small_binom(5, 2)
    if lsb1 == 10
        print("ok luct_small_binom_5_2")
    else
        print("FAIL luct_small_binom_5_2 got=" + str(lsb1))
        fails = fails + 1
    checks = checks + 1

    let lsb2 = luct_small_binom(6, 3)
    if lsb2 == 20
        print("ok luct_small_binom_6_3")
    else
        print("FAIL luct_small_binom_6_3 got=" + str(lsb2))
        fails = fails + 1
    checks = checks + 1

    let lsb3 = luct_small_binom(3, 5)
    if lsb3 == 0
        print("ok luct_small_binom_k_gt_n")
    else
        print("FAIL luct_small_binom_k_gt_n got=" + str(lsb3))
        fails = fails + 1
    checks = checks + 1

    let lsb4 = luct_small_binom(0, 0)
    if lsb4 == 1
        print("ok luct_small_binom_0_0")
    else
        print("FAIL luct_small_binom_0_0 got=" + str(lsb4))
        fails = fails + 1
    checks = checks + 1

    let lbm1 = luct_binom_mod(10, 3, 3)
    if lbm1 == 0
        print("ok luct_binom_mod_10_3_3")
    else
        print("FAIL luct_binom_mod_10_3_3 got=" + str(lbm1))
        fails = fails + 1
    checks = checks + 1

    let lbm2 = luct_binom_mod(5, 2, 3)
    if lbm2 == 1
        print("ok luct_binom_mod_5_2_3")
    else
        print("FAIL luct_binom_mod_5_2_3 got=" + str(lbm2))
        fails = fails + 1
    checks = checks + 1

    let lbm3 = luct_binom_mod(7, 4, 5)
    if lbm3 == 0
        print("ok luct_binom_mod_7_4_5")
    else
        print("FAIL luct_binom_mod_7_4_5 got=" + str(lbm3))
        fails = fails + 1
    checks = checks + 1

    let lbm4 = luct_binom_mod(6, 2, 5)
    if lbm4 == 0
        print("ok luct_binom_mod_6_2_5")
    else
        print("FAIL luct_binom_mod_6_2_5 got=" + str(lbm4))
        fails = fails + 1
    checks = checks + 1

    let lbm5 = luct_binom_mod(13, 5, 7)
    if lbm5 == 6
        print("ok luct_binom_mod_13_5_7")
    else
        print("FAIL luct_binom_mod_13_5_7 got=" + str(lbm5))
        fails = fails + 1
    checks = checks + 1

    if luct_verify(20, 7, 11)
        print("ok luct_verify_20_7_11")
    else
        print("FAIL luct_verify_20_7_11")
        fails = fails + 1
    checks = checks + 1

    if luct_verify(13, 5, 7)
        print("ok luct_verify_13_5_7")
    else
        print("FAIL luct_verify_13_5_7")
        fails = fails + 1
    checks = checks + 1

    // ===== discrete_log (dlog_) =====
    let dpm1 = dlog_pow_mod(2, 10, 1000)
    if dpm1 == 24
        print("ok dlog_pow_mod_basic")
    else
        print("FAIL dlog_pow_mod_basic got=" + str(dpm1))
        fails = fails + 1
    checks = checks + 1

    let dpm2 = dlog_pow_mod(3, 0, 7)
    if dpm2 == 1
        print("ok dlog_pow_mod_exp0")
    else
        print("FAIL dlog_pow_mod_exp0 got=" + str(dpm2))
        fails = fails + 1
    checks = checks + 1

    let dmi1 = dlog_mod_inverse(3, 7)
    if dmi1 == 5
        print("ok dlog_mod_inverse_basic")
    else
        print("FAIL dlog_mod_inverse_basic got=" + str(dmi1))
        fails = fails + 1
    checks = checks + 1

    let dmi2 = dlog_mod_inverse(1, 13)
    if dmi2 == 1
        print("ok dlog_mod_inverse_one")
    else
        print("FAIL dlog_mod_inverse_one got=" + str(dmi2))
        fails = fails + 1
    checks = checks + 1

    let dbs1 = dlog_bsgs(5, 8, 23)
    if dbs1 == 6
        print("ok dlog_bsgs_found")
    else
        print("FAIL dlog_bsgs_found got=" + str(dbs1))
        fails = fails + 1
    checks = checks + 1

    let dbs2 = dlog_bsgs(2, 3, 7)
    if dbs2 == -1
        print("ok dlog_bsgs_not_found")
    else
        print("FAIL dlog_bsgs_not_found got=" + str(dbs2))
        fails = fails + 1
    checks = checks + 1

    if dlog_verify(5, 6, 8, 23)
        print("ok dlog_verify_true")
    else
        print("FAIL dlog_verify_true")
        fails = fails + 1
    checks = checks + 1

    if not dlog_verify(5, 5, 8, 23)
        print("ok dlog_verify_false")
    else
        print("FAIL dlog_verify_false")
        fails = fails + 1
    checks = checks + 1

    // ===== tonelli_shanks (tsh_) =====
    let tl1 = tsh_legendre(2, 41)
    if tl1 == 1
        print("ok tsh_legendre_residue")
    else
        print("FAIL tsh_legendre_residue got=" + str(tl1))
        fails = fails + 1
    checks = checks + 1

    let tl2 = tsh_legendre(3, 41)
    if tl2 == -1
        print("ok tsh_legendre_nonresidue")
    else
        print("FAIL tsh_legendre_nonresidue got=" + str(tl2))
        fails = fails + 1
    checks = checks + 1

    let tl3 = tsh_legendre(0, 7)
    if tl3 == 0
        print("ok tsh_legendre_zero")
    else
        print("FAIL tsh_legendre_zero got=" + str(tl3))
        fails = fails + 1
    checks = checks + 1

    if tsh_is_residue(2, 7)
        print("ok tsh_is_residue_true")
    else
        print("FAIL tsh_is_residue_true")
        fails = fails + 1
    checks = checks + 1

    if not tsh_is_residue(3, 7)
        print("ok tsh_is_residue_false")
    else
        print("FAIL tsh_is_residue_false")
        fails = fails + 1
    checks = checks + 1

    let ts1 = tsh_sqrt(2, 7)
    if ts1 == 4
        print("ok tsh_sqrt_p3mod4")
    else
        print("FAIL tsh_sqrt_p3mod4 got=" + str(ts1))
        fails = fails + 1
    checks = checks + 1

    let ts2 = tsh_sqrt(3, 11)
    if ts2 == 5
        print("ok tsh_sqrt_p3mod4_b")
    else
        print("FAIL tsh_sqrt_p3mod4_b got=" + str(ts2))
        fails = fails + 1
    checks = checks + 1

    let ts3 = tsh_sqrt(3, 7)
    if ts3 == -1
        print("ok tsh_sqrt_nonresidue")
    else
        print("FAIL tsh_sqrt_nonresidue got=" + str(ts3))
        fails = fails + 1
    checks = checks + 1

    let ts4 = tsh_sqrt(10, 41)
    if ts4 == 16
        print("ok tsh_sqrt_general_case")
    else
        print("FAIL tsh_sqrt_general_case got=" + str(ts4))
        fails = fails + 1
    checks = checks + 1

    if tsh_verify(4, 2, 7)
        print("ok tsh_verify_true")
    else
        print("FAIL tsh_verify_true")
        fails = fails + 1
    checks = checks + 1

    if not tsh_verify(5, 3, 7)
        print("ok tsh_verify_false")
    else
        print("FAIL tsh_verify_false")
        fails = fails + 1
    checks = checks + 1

    if tsh_verify(ts4, 10, 41)
        print("ok tsh_verify_general_case")
    else
        print("FAIL tsh_verify_general_case")
        fails = fails + 1
    checks = checks + 1

    print(str(checks) + " checks run, " + str(fails) + " failures")
    if fails == 0
        print("ALL PASS")
    else
        print("SOME FAILED")
        exit(1)
