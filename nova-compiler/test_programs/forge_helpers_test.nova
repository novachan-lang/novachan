// functional: forge.nova helpers — CSV, NDJSON, W3C trace context, media-type negotiation
import forge

fn main()
    if forge.csv_row(["a", "b"]) != "a,b"
        print("FAIL csv_row")
        exit(1)
    let q = chr(34)
    if forge.csv_row(["a,b", "c"]) != q + "a,b" + q + ",c"
        print("FAIL csv quote = " + forge.csv_row(["a,b", "c"]))
        exit(1)
    let items = []
    let d1 = {}
    d1["x"] = 1
    push(items, d1)
    let d2 = {}
    d2["x"] = 2
    push(items, d2)
    if find(forge.ndjson_of(items), chr(10)) < 0
        print("FAIL ndjson newline")
        exit(1)
    let tp = forge.trace_start(true)
    let p = forge.trace_parse(tp)
    if p["valid"] != true
        print("FAIL trace valid")
        exit(1)
    if p["sampled"] != true
        print("FAIL trace sampled")
        exit(1)
    if len(p["trace_id"]) != 32
        print("FAIL trace_id len = " + str(len(p["trace_id"])))
        exit(1)
    let pc = forge.trace_parse(forge.trace_child(tp))
    if pc["trace_id"] != p["trace_id"]
        print("FAIL child trace_id")
        exit(1)
    if pc["span_id"] == p["span_id"]
        print("FAIL child span same")
        exit(1)
    if forge.trace_parse(forge.trace_child("garbage"))["valid"] != true
        print("FAIL fresh from garbage")
        exit(1)
    let req = forge.build_request("GET /x HTTP/1.1\r\nAccept: text/html;q=0.5, application/json\r\n\r\n", 0)
    if forge.negotiate_type(req, ["application/json", "text/html"]) != "application/json"
        print("FAIL negotiate = " + forge.negotiate_type(req, ["application/json", "text/html"]))
        exit(1)
    print("PASS forge_helpers")
