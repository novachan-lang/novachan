import forge_compensator

fn main()
    let c = comp_new()
    c = comp_add_step(c, "reserve", "reserve_inventory", "release_inventory")
    c = comp_add_step(c, "charge", "charge_card", "refund_card")
    c = comp_add_step(c, "ship", "create_shipment", "cancel_shipment")
    assert(comp_status(c) == "pending", "pending")

    c = comp_complete_step(c, 0)
    c = comp_complete_step(c, 1)
    assert(comp_completed_count(c) == 2, "2 completed")

    c = comp_fail_at(c, 2)
    assert(comp_status(c) == "compensated", "compensated")
    assert(comp_compensated_count(c) == 2, "2 compensated")
    assert(comp_is_undone(c, 0) == 1, "reserve undone")
    assert(comp_is_undone(c, 1) == 1, "charge undone")

    assert(comp_step_name(c, 0) == "reserve", "name 0")
    assert(comp_step_undo(c, 1) == "refund_card", "undo 1")

    print("COMPENSATOR KAT PASS")
