fn sumList(nums, n)
    total = 0
    i = 0
    while i < n
        total += nums[i]
        i += 1
    total

fn maxInList(nums, n)
    best = nums[0]
    i = 1
    while i < n
        if nums[i] > best
            best = nums[i]
        i += 1
    best

nums = [10, 20, 30, 40, 50]
print(nums[0])
print(nums[2])
print(nums[4])
print(len(nums))
print(sumList(nums, 5))
print(maxInList(nums, 5))

primes = [2, 3, 5, 7, 11, 13]
print(primes[0])
print(primes[5])
print(len(primes))
print(sumList(primes, 6))
