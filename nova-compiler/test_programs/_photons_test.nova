// KAT for std/physics/photons — photon / quantum optics formulas.
import std/physics/photons

// approx — float equality within 0.001 absolute tolerance.
fn approx(a, b)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < 0.001

// approx_rel — relative tolerance: |a-b|/|b| < tol  (or |a-b|<tol if b~0).
fn approx_rel(a, b, tol)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    // normalize by b if b != 0
    let ref_b = b
    if ref_b < 0.0
        ref_b = 0.0 - ref_b
    if ref_b > 0.0
        let rel = d / ref_b
        return rel < tol
    return d < tol

fn ck_true(label, val)
    if not val
        print("FAIL " + label)
        exit(1)

fn main()
    // photon_energy(freq) = h() * freq
    // photon_energy(1.0) should equal h() exactly (freq=1 Hz)
    // ratio photon_energy(1.0) / h() must be ~1.0
    let e1 = photon_energy(1.0)
    let hval = h()
    let ratio_e1 = e1 / hval
    ck_true("photon_energy(1.0)/h()~1", approx(ratio_e1, 1.0))

    // photon_energy(2.998e8) = h() * c() (freq = c, corresponding to 1m wavelength)
    let cval = c()
    let e_at_c = photon_energy(cval)
    let hc = hval * cval
    let ratio_ec = e_at_c / hc
    ck_true("photon_energy(c)/hc~1", approx(ratio_ec, 1.0))

    // ev_to_joules(1.0) = 1.602e-19 J
    // ratio ev_to_joules(1.0) / 1.602e-19 must be ~1.0
    let j1 = ev_to_joules(1.0)
    let j_ref = 1.602 * pow(10.0, -19.0)
    let ratio_j = j1 / j_ref
    ck_true("ev_to_joules(1)/ref~1", approx(ratio_j, 1.0))

    // ev_to_joules(2.0) = 2 * ev_to_joules(1.0)
    let j2 = ev_to_joules(2.0)
    let ratio_j2 = j2 / j1
    ck_true("ev_to_joules(2)/ev_to_joules(1)~2", approx(ratio_j2, 2.0))

    // photon_wavelength(photon_energy(c())) round-trip
    // photon_energy(c()) = h()*c()
    // photon_wavelength(h()*c()) = h()*c() / (h()*c()) = 1.0
    let e_cval = photon_energy(cval)
    let lam = photon_wavelength(e_cval)
    ck_true("wavelength(energy(c))~1", approx(lam, 1.0))

    // photon_wavelength is inverse of photon_energy wrt freq:
    // photon_wavelength(photon_energy(f)) = h()*c() / (h()*f) = c()/f
    // at f=c() that = 1.0 (already tested)
    // at f=2*c() -> wavelength = c()/(2*c()) = 0.5
    let e2c = photon_energy(2.0 * cval)
    let lam2 = photon_wavelength(e2c)
    ck_true("wavelength(energy(2c))~0.5", approx(lam2, 0.5))

    // speed of light constant sanity: c ~ 2.998e8
    let c_ratio = cval / (2.998 * pow(10.0, 8.0))
    ck_true("c()/2.998e8~1", approx(c_ratio, 1.0))

    print("PASS _photons_test")
