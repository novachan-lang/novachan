// multiclause_test — Erlang/Elixir-style multi-clause function heads with guards.
// Same-name/arity heads with `when <guard>` fuse into one fn (guard if/else chain);
// last unguarded head is the catch-all.

fn classify(n) when n < 0
    return "negative"
fn classify(n) when n == 0
    return "zero"
fn classify(n)
    return "positive"

fn sign(n) when n > 0
    return 1
fn sign(n) when n < 0
    return 0 - 1
fn sign(n)
    return 0

// guard referencing a computed condition
fn bucket(x) when x >= 100
    return "big"
fn bucket(x) when x >= 10
    return "medium"
fn bucket(x)
    return "small"

// a normal single-head fn (no guards) must be unaffected
fn double(x)
    return x * 2

fn main()
    assert_eq(classify(-5), "negative")
    assert_eq(classify(0), "zero")
    assert_eq(classify(7), "positive")

    assert_eq(sign(3), 1)
    assert_eq(sign(-3), -1)
    assert_eq(sign(0), 0)

    assert_eq(bucket(250), "big")
    assert_eq(bucket(42), "medium")
    assert_eq(bucket(3), "small")

    assert_eq(double(5), 10)

    print("multiclause_test passed")
