// _bwt_test.nova — KAT for std/compress/bwt
//
// PRIMARY KATs: round-trip bwt_inverse(bwt_transform(s)[0], bwt_transform(s)[1]) == s
// SECONDARY KATs: known transform vectors + permutation property + EOF sentinel.
//
// Hand-computed vectors:
//
//   "banana" (n=6):
//     Rotations (start indices): 0=banana 1=ananab 2=nanaba 3=abanan 4=nabana 5=anaban
//     Sorted:  abanan(1) anaban(3) ananab(5) banana(0) nabana(4) nanaba(2)
//     Wait — corrected indices where rotation starts:
//       rot[0] -> start 0 -> "banana"
//       rot[1] -> start 1 -> "ananab"
//       rot[2] -> start 2 -> "nanaba"
//       rot[3] -> start 3 -> "anaban"
//       rot[4] -> start 4 -> "nabana"
//       rot[5] -> start 5 -> "abanan"
//     Sorted order: "abanan"(5) "anaban"(3) "ananab"(1) "banana"(0) "nabana"(4) "nanaba"(2)
//     Last chars (pos = (start+5) mod 6):
//       (5+5)%6=4 -> s[4]='n'
//       (3+5)%6=2 -> s[2]='n'
//       (1+5)%6=0 -> s[0]='b'
//       (0+5)%6=5 -> s[5]='a'
//       (4+5)%6=3 -> s[3]='a'
//       (2+5)%6=1 -> s[1]='a'
//     Transformed = "nnbaaa", primaryIndex = 3 (row where start==0, i.e. row 3)
//
//   "aaaa" (n=4):
//     All rotations identical; insertion sort stable -> order preserved [0,1,2,3].
//     last chars: (0+3)%4=3->a, (1+3)%4=0->a, (2+3)%4=1->a, (3+3)%4=2->a
//     Transformed = "aaaa", primaryIndex = 0.
//
//   "the" (n=3):
//     rot 0="the" 1="het" 2="eth"
//     sorted: "eth"(2) "het"(1) "the"(0)
//     last chars: (2+2)%3=1->h, (1+2)%3=0->t, (0+2)%3=2->e
//     Transformed = "hte", primaryIndex = 2.

import std/compress/bwt

// String known-answer check
fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got [" + got + "] want [" + want + "]")
        exit(1)

// Integer known-answer check
fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// Sort a string's characters and return sorted string.
// Used to verify the permutation property: sort(transform) == sort(original).
fn sort_string(s) -> string
    let n = len(s)
    if n == 0
        return ""
    let chars = []
    let i = 0
    while i < n
        push(chars, s[i])
        i = i + 1
    chars = sort(chars)
    let out = ""
    let j = 0
    while j < n
        out = out + chars[j]
        j = j + 1
    out

fn main()
    // ── KAT 1: empty string round-trip ──────────────────────────────────────
    let r1 = bwt_transform("")
    let t1 = r1[0]
    let p1 = r1[1]
    cks("empty-transform", t1, "")
    cki("empty-primary", p1, 0)
    cks("empty-roundtrip", bwt_inverse(t1, p1), "")

    // ── KAT 2: "banana" — known vector + round-trip ─────────────────────────
    let r2 = bwt_transform("banana")
    let t2 = r2[0]
    let p2 = r2[1]
    cks("banana-transform", t2, "nnbaaa")
    cki("banana-primary", p2, 3)
    cks("banana-roundtrip", bwt_inverse(t2, p2), "banana")

    // ── KAT 3: "abracadabra" round-trip ─────────────────────────────────────
    let r3 = bwt_transform("abracadabra")
    let t3 = r3[0]
    let p3 = r3[1]
    cks("abracadabra-roundtrip", bwt_inverse(t3, p3), "abracadabra")

    // ── KAT 4: "mississippi" round-trip ─────────────────────────────────────
    let r4 = bwt_transform("mississippi")
    let t4 = r4[0]
    let p4 = r4[1]
    cks("mississippi-roundtrip", bwt_inverse(t4, p4), "mississippi")

    // ── KAT 5: "aaaa" — known vector (all rotations identical) + round-trip ─
    let r5 = bwt_transform("aaaa")
    let t5 = r5[0]
    let p5 = r5[1]
    cks("aaaa-transform", t5, "aaaa")
    cki("aaaa-primary", p5, 0)
    cks("aaaa-roundtrip", bwt_inverse(t5, p5), "aaaa")

    // ── KAT 6: "the" — known vector + round-trip ────────────────────────────
    let r6 = bwt_transform("the")
    let t6 = r6[0]
    let p6 = r6[1]
    cks("the-transform", t6, "hte")
    cki("the-primary", p6, 2)
    cks("the-roundtrip", bwt_inverse(t6, p6), "the")

    // ── KAT 7: permutation property — sort(bwt(s)) == sort(s) ───────────────
    // The BWT is a permutation: it rearranges the same multiset of characters.
    cks("permutation-banana", sort_string(t2), sort_string("banana"))
    cks("permutation-abracadabra", sort_string(t3), sort_string("abracadabra"))
    cks("permutation-mississippi", sort_string(t4), sort_string("mississippi"))

    // ── KAT 8: bwt_transform_eof — output is permutation of input+sentinel ──
    // bwt_transform_eof("banana") returns 7 chars, same multiset as "banana"+chr(1)
    let eof_banana = bwt_transform_eof("banana")
    cki("eof-banana-len", len(eof_banana), 7)
    cks("eof-banana-permutation", sort_string(eof_banana), sort_string("banana" + chr(1)))

    // bwt_transform_eof("") returns 1 char: chr(1) (only the sentinel)
    let eof_empty = bwt_transform_eof("")
    cki("eof-empty-len", len(eof_empty), 1)
    cks("eof-empty-val", eof_empty, chr(1))

    // ── KAT 9: single character round-trip ──────────────────────────────────
    let r9 = bwt_transform("a")
    cks("single-a-roundtrip", bwt_inverse(r9[0], r9[1]), "a")
    let r9z = bwt_transform("z")
    cks("single-z-roundtrip", bwt_inverse(r9z[0], r9z[1]), "z")

    // ── KAT 10: longer sentence round-trip ──────────────────────────────────
    let sentence = "the quick brown fox"
    let r10 = bwt_transform(sentence)
    cks("sentence-roundtrip", bwt_inverse(r10[0], r10[1]), sentence)

    print("_bwt_test passed")
