// NOVA STDLIB — datetime module
// UTC date/time utilities built on epoch milliseconds.
//
// Public API:
//   dt_now_ms()                          -> int    (current UTC time in ms since epoch)
//   dt_from_parts(y, mo, d, h, mi, s)   -> dict   (build datetime from components)
//   dt_to_parts(epoch_ms)               -> dict   (epoch ms -> {year,month,day,hour,min,sec,ms})
//   dt_format_iso(dt)                   -> string ("2026-05-31T10:23:45Z")
//   dt_format_date(dt)                  -> string ("2026-05-31")
//   dt_format_time(dt)                  -> string ("10:23:45")
//   dt_format_human(dt)                 -> string ("May 31, 2026 10:23:45 UTC")
//   dt_diff_ms(a, b)                    -> int    (a.epoch_ms - b.epoch_ms)
//   dt_add_seconds(dt, seconds)         -> dict   (new datetime shifted by seconds)
//   dt_add_days(dt, days)               -> dict   (new datetime shifted by days)
//   dt_day_of_week(dt)                  -> int    (0=Mon .. 6=Sun)
//   dt_day_name(dow)                    -> string ("Monday" .. "Sunday")
//   dt_month_name(m)                    -> string ("January" .. "December")
//   dt_is_leap_year(year)               -> bool
//   dt_days_in_month(year, month)       -> int
//
// Internal:
//   _dt_pad2(n)  -> string  (zero-pad integer to 2 digits)
//   _dt_pad4(n)  -> string  (zero-pad integer to 4 digits)
//
// Datetime dict shape:
//   {"year": int, "month": int, "day": int,
//    "hour": int, "min": int, "sec": int,
//    "ms": int, "epoch_ms": int}

// Constants as functions to avoid module-level let (gen3 limitation)
fn _MS_PER_SEC() -> int
    1000
fn _MS_PER_MIN() -> int
    60000
fn _MS_PER_HOUR() -> int
    3600000
fn _MS_PER_DAY() -> int
    86400000

// ── Internal helpers ─────────────────────────────────────────────────────

fn _dt_pad2(n) -> string
    if n < 0
        return _dt_pad2(0 - n)
    if n < 10
        return "0" + str(n)
    str(n)

fn _dt_pad4(n) -> string
    if n < 0
        return _dt_pad4(0 - n)
    if n < 10
        return "000" + str(n)
    if n < 100
        return "00" + str(n)
    if n < 1000
        return "0" + str(n)
    str(n)

// ── Leap year / days-in-month ────────────────────────────────────────────

fn dt_is_leap_year(year) -> bool
    if year % 400 == 0
        return true
    if year % 100 == 0
        return false
    year % 4 == 0

fn dt_days_in_month(year, month) -> int
    // month: 1-12
    if month == 2
        if dt_is_leap_year(year)
            return 29
        return 28
    if month == 4 or month == 6 or month == 9 or month == 11
        return 30
    31

// ── Epoch <-> parts conversion ───────────────────────────────────────────

// Convert calendar date parts to epoch milliseconds.
// Uses the forward algorithm: count days from 1970-01-01 to the target date.
fn _dt_parts_to_epoch_ms(year, month, day, hour, min, sec, ms) -> int
    // Count total days from 1970-01-01 to year-month-day
    let days = 0

    // Add full years from 1970 to year-1
    if year > 1970
        let y = 1970
        while y < year
            if dt_is_leap_year(y)
                days = days + 366
            else
                days = days + 365
            y = y + 1
    else if year < 1970
        let y = year
        while y < 1970
            if dt_is_leap_year(y)
                days = days - 366
            else
                days = days - 365
            y = y + 1

    // Add full months in the target year
    let m = 1
    while m < month
        days = days + dt_days_in_month(year, m)
        m = m + 1

    // Add remaining days (day is 1-based, so subtract 1)
    days = days + day - 1

    // Convert to milliseconds and add time components
    days * _MS_PER_DAY() + hour * _MS_PER_HOUR() + min * _MS_PER_MIN() + sec * _MS_PER_SEC() + ms

// Convert epoch milliseconds to calendar date parts (UTC).
// Classic civil-date-from-days algorithm.
fn dt_to_parts(epoch_ms) -> dict
    // Handle the millisecond remainder
    let total_ms = epoch_ms
    let negative = total_ms < 0

    // Extract time-of-day from the epoch
    // We need to floor-divide for negative values
    let day_ms = total_ms % _MS_PER_DAY()
    let total_days = (total_ms - day_ms) / _MS_PER_DAY()

    // Normalize negative remainder: day_ms should be in [0, MS_PER_DAY)
    if day_ms < 0
        day_ms = day_ms + _MS_PER_DAY()
        total_days = total_days - 1

    let hour = day_ms / _MS_PER_HOUR()
    let rem = day_ms % _MS_PER_HOUR()
    let min = rem / _MS_PER_MIN()
    rem = rem % _MS_PER_MIN()
    let sec = rem / _MS_PER_SEC()
    let ms = rem % _MS_PER_SEC()

    // Convert total_days (from 1970-01-01) to year/month/day
    let year = 1970
    if total_days >= 0
        while true
            let year_days = 365
            if dt_is_leap_year(year)
                year_days = 366
            if total_days < year_days
                break
            total_days = total_days - year_days
            year = year + 1
    else
        while total_days < 0
            year = year - 1
            let year_days = 365
            if dt_is_leap_year(year)
                year_days = 366
            total_days = total_days + year_days

    // total_days is now day-of-year (0-based)
    let month = 1
    while month <= 12
        let dim = dt_days_in_month(year, month)
        if total_days < dim
            break
        total_days = total_days - dim
        month = month + 1

    let day = total_days + 1

    let dt = {}
    dt["year"] = year
    dt["month"] = month
    dt["day"] = day
    dt["hour"] = hour
    dt["min"] = min
    dt["sec"] = sec
    dt["ms"] = ms
    dt["epoch_ms"] = epoch_ms
    dt

// ── Constructors ─────────────────────────────────────────────────────────

fn dt_now_ms() -> int
    time_ms()

fn dt_from_parts(year, month, day, hour, min, sec) -> dict
    let epoch = _dt_parts_to_epoch_ms(year, month, day, hour, min, sec, 0)
    let dt = {}
    dt["year"] = year
    dt["month"] = month
    dt["day"] = day
    dt["hour"] = hour
    dt["min"] = min
    dt["sec"] = sec
    dt["ms"] = 0
    dt["epoch_ms"] = epoch
    dt

// ── Formatting ───────────────────────────────────────────────────────────

fn dt_format_iso(dt) -> string
    // "2026-05-31T10:23:45Z"
    let y = _dt_pad4(dt["year"])
    let mo = _dt_pad2(dt["month"])
    let d = _dt_pad2(dt["day"])
    let h = _dt_pad2(dt["hour"])
    let mi = _dt_pad2(dt["min"])
    let s = _dt_pad2(dt["sec"])
    y + "-" + mo + "-" + d + "T" + h + ":" + mi + ":" + s + "Z"

fn dt_format_date(dt) -> string
    // "2026-05-31"
    let y = _dt_pad4(dt["year"])
    let mo = _dt_pad2(dt["month"])
    let d = _dt_pad2(dt["day"])
    y + "-" + mo + "-" + d

fn dt_format_time(dt) -> string
    // "10:23:45"
    let h = _dt_pad2(dt["hour"])
    let mi = _dt_pad2(dt["min"])
    let s = _dt_pad2(dt["sec"])
    h + ":" + mi + ":" + s

fn dt_format_human(dt) -> string
    // "May 31, 2026 10:23:45 UTC"
    let mname = dt_month_name(dt["month"])
    let d = str(dt["day"])
    let y = str(dt["year"])
    let t = dt_format_time(dt)
    mname + " " + d + ", " + y + " " + t + " UTC"

// ── Arithmetic ───────────────────────────────────────────────────────────

fn dt_diff_ms(a, b) -> int
    a["epoch_ms"] - b["epoch_ms"]

fn dt_add_seconds(dt, seconds) -> dict
    let new_epoch = dt["epoch_ms"] + seconds * _MS_PER_SEC()
    dt_to_parts(new_epoch)

fn dt_add_days(dt, days) -> dict
    let new_epoch = dt["epoch_ms"] + days * _MS_PER_DAY()
    dt_to_parts(new_epoch)

// ── Day-of-week ──────────────────────────────────────────────────────────

// Tomohiko Sakamoto's algorithm: returns 0=Sun..6=Sat,
// then we remap to 0=Mon..6=Sun for ISO 8601 convention.
fn dt_day_of_week(dt) -> int
    let y = dt["year"]
    let m = dt["month"]
    let d = dt["day"]

    // Sakamoto's lookup table: month offsets
    let t = [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4]

    if m < 3
        y = y - 1

    // Sakamoto: (y + y/4 - y/100 + y/400 + t[m-1] + d) % 7
    // Result: 0=Sun, 1=Mon, ..., 6=Sat
    let dow_sun = (y + y / 4 - y / 100 + y / 400 + t[m - 1] + d) % 7

    // Remap to ISO: 0=Mon .. 6=Sun
    // Sun(0)->6, Mon(1)->0, Tue(2)->1, ..., Sat(6)->5
    if dow_sun == 0
        return 6
    dow_sun - 1

fn dt_day_name(dow) -> string
    // dow: 0=Mon .. 6=Sun
    if dow == 0
        return "Monday"
    if dow == 1
        return "Tuesday"
    if dow == 2
        return "Wednesday"
    if dow == 3
        return "Thursday"
    if dow == 4
        return "Friday"
    if dow == 5
        return "Saturday"
    if dow == 6
        return "Sunday"
    "Unknown"

fn dt_month_name(m) -> string
    // m: 1-12
    if m == 1
        return "January"
    if m == 2
        return "February"
    if m == 3
        return "March"
    if m == 4
        return "April"
    if m == 5
        return "May"
    if m == 6
        return "June"
    if m == 7
        return "July"
    if m == 8
        return "August"
    if m == 9
        return "September"
    if m == 10
        return "October"
    if m == 11
        return "November"
    if m == 12
        return "December"
    "Unknown"

// ── Self-test ────────────────────────────────────────────────────────────

fn _dt_run_tests()
    // Test leap year
    assert(dt_is_leap_year(2000), "2000 is leap")
    assert(not dt_is_leap_year(1900), "1900 is not leap")
    assert(dt_is_leap_year(2024), "2024 is leap")
    assert(not dt_is_leap_year(2023), "2023 is not leap")
    assert(dt_is_leap_year(2400), "2400 is leap")
    assert(not dt_is_leap_year(2100), "2100 is not leap")

    // Test days in month
    assert(dt_days_in_month(2026, 1) == 31, "jan 31")
    assert(dt_days_in_month(2026, 2) == 28, "feb 28 non-leap")
    assert(dt_days_in_month(2024, 2) == 29, "feb 29 leap")
    assert(dt_days_in_month(2026, 4) == 30, "apr 30")
    assert(dt_days_in_month(2026, 12) == 31, "dec 31")

    // Test epoch: 1970-01-01 00:00:00 UTC = epoch 0
    let epoch_zero = dt_from_parts(1970, 1, 1, 0, 0, 0)
    assert(epoch_zero["epoch_ms"] == 0, "epoch zero")

    // Test known date: 2026-05-31 10:23:45 UTC
    let dt1 = dt_from_parts(2026, 5, 31, 10, 23, 45)
    assert(dt1["year"] == 2026, "year")
    assert(dt1["month"] == 5, "month")
    assert(dt1["day"] == 31, "day")
    assert(dt1["hour"] == 10, "hour")
    assert(dt1["min"] == 23, "min")
    assert(dt1["sec"] == 45, "sec")

    // Round-trip: from_parts -> epoch_ms -> to_parts
    let rt = dt_to_parts(dt1["epoch_ms"])
    assert(rt["year"] == 2026, "rt year")
    assert(rt["month"] == 5, "rt month")
    assert(rt["day"] == 31, "rt day")
    assert(rt["hour"] == 10, "rt hour")
    assert(rt["min"] == 23, "rt min")
    assert(rt["sec"] == 45, "rt sec")

    // Test well-known epoch: 2000-01-01 00:00:00 = 946684800000 ms
    let y2k = dt_from_parts(2000, 1, 1, 0, 0, 0)
    assert(y2k["epoch_ms"] == 946684800000, "y2k epoch")

    // Round-trip y2k
    let y2k_rt = dt_to_parts(946684800000)
    assert(y2k_rt["year"] == 2000, "y2k rt year")
    assert(y2k_rt["month"] == 1, "y2k rt month")
    assert(y2k_rt["day"] == 1, "y2k rt day")

    // Test 1 day after epoch
    let day1 = dt_to_parts(86400000)
    assert(day1["year"] == 1970, "day1 year")
    assert(day1["month"] == 1, "day1 month")
    assert(day1["day"] == 2, "day1 day")

    // Test formatting
    let iso = dt_format_iso(dt1)
    assert(iso == "2026-05-31T10:23:45Z", "iso format")

    let date_str = dt_format_date(dt1)
    assert(date_str == "2026-05-31", "date format")

    let time_str = dt_format_time(dt1)
    assert(time_str == "10:23:45", "time format")

    let human = dt_format_human(dt1)
    assert(human == "May 31, 2026 10:23:45 UTC", "human format")

    // Test padding edge cases
    let dt_small = dt_from_parts(2026, 1, 5, 3, 7, 9)
    let iso_small = dt_format_iso(dt_small)
    assert(iso_small == "2026-01-05T03:07:09Z", "iso padded")

    // Test diff
    let dt2 = dt_from_parts(2026, 5, 31, 11, 23, 45)
    let diff = dt_diff_ms(dt2, dt1)
    assert(diff == 3600000, "diff 1 hour")

    // Test add_seconds
    let dt_plus = dt_add_seconds(dt1, 3600)
    assert(dt_plus["hour"] == 11, "add 1 hour")
    assert(dt_plus["min"] == 23, "add keeps min")

    // Test add_days
    let dt_next = dt_add_days(dt1, 1)
    assert(dt_next["day"] == 1, "june 1")
    assert(dt_next["month"] == 6, "june")

    // Test add_days across year boundary
    let nye = dt_from_parts(2026, 12, 31, 23, 59, 0)
    let new_year = dt_add_days(nye, 1)
    assert(new_year["year"] == 2027, "new year")
    assert(new_year["month"] == 1, "jan")
    assert(new_year["day"] == 1, "first")

    // Test day_of_week
    // 2026-05-31 is a Sunday
    let dow = dt_day_of_week(dt1)
    assert(dow == 6, "2026-05-31 is Sunday (6)")

    // 1970-01-01 was a Thursday
    let dow_epoch = dt_day_of_week(epoch_zero)
    assert(dow_epoch == 3, "1970-01-01 is Thursday (3)")

    // 2024-02-29 was a Thursday (leap day)
    let leap_day = dt_from_parts(2024, 2, 29, 0, 0, 0)
    let dow_leap = dt_day_of_week(leap_day)
    assert(dow_leap == 3, "2024-02-29 is Thursday (3)")

    // Test day/month names
    assert(dt_day_name(0) == "Monday", "Monday")
    assert(dt_day_name(6) == "Sunday", "Sunday")
    assert(dt_month_name(1) == "January", "January")
    assert(dt_month_name(12) == "December", "December")

    // Test dt_now_ms returns something reasonable (after year 2020)
    let now = dt_now_ms()
    assert(now > 1577836800000, "now after 2020")

    print("datetime: ALL PASSED")

_dt_run_tests()
