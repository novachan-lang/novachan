type NType
    kind: string
    name: string
    params: list
    id: int

fn nt_var(vid: int) -> NType
    NType("var", "", [], vid)

fn nt_unit() -> NType
    NType("unit", "", [], 0)

fn nt_int() -> NType
    NType("int", "", [], 0)

fn main()
    let t1 = nt_unit()
    match t1
        NType(k, n, p, i) =>
            print("t1 kind=" + k + " id=" + str(i))
    let t2 = nt_int()
    match t2
        NType(k, n, p, i) =>
            print("t2 kind=" + k + " id=" + str(i))
    let t3 = nt_var(-1)
    match t3
        NType(k, n, p, i) =>
            print("t3 kind=" + k + " id=" + str(i))
    let t4 = nt_var(42)
    match t4
        NType(k, n, p, i) =>
            print("t4 kind=" + k + " id=" + str(i))
    let t5 = NType("var", "", [], -1)
    match t5
        NType(k, n, p, i) =>
            print("t5 kind=" + k + " id=" + str(i))
    print("done")
