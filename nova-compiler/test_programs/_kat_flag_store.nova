import forge_flag_store

fn main()
    let f = fs_new()
    f = fs_create(f, "dark_mode", 1)
    f = fs_create(f, "new_ui", 0)
    assert(fs_flag_count(f) == 2, "2 flags")

    assert(fs_is_enabled(f, "dark_mode", 50) == 1, "dark mode on")
    assert(fs_is_enabled(f, "new_ui", 50) == 0, "new ui off")
    assert(fs_is_enabled(f, "nope", 50) == 0, "unknown flag off")

    let sr = fs_set_rollout(f, "dark_mode", 25)
    assert(is_ok(sr), "set rollout ok")
    f = unwrap(sr)
    assert(fs_is_enabled(f, "dark_mode", 10) == 1, "10 in 25% rollout")
    assert(fs_is_enabled(f, "dark_mode", 50) == 0, "50 not in 25% rollout")

    let t = fs_toggle(f, "new_ui")
    assert(is_ok(t), "toggle ok")
    f = unwrap(t)
    assert(fs_is_enabled(f, "new_ui", 50) == 1, "new ui now on")

    assert(fs_check_count(f) == 6, "6 checks")

    let bad = fs_toggle(f, "nope")
    assert(is_err(bad), "toggle unknown")

    print("FLAG-STORE KAT PASS")
