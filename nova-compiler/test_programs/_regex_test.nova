// KAT test for std/automata/regex
import std/automata/regex

fn main()
    // KAT 1: a*b matches "aaab"
    let r1 = rgx_match("a*b", "aaab")
    if r1 != 1
        print("FAIL KAT1: rgx_match(a*b,aaab) expected 1 got " + str(r1))
        exit(1)

    // KAT 2: a*b matches "b" (zero a's)
    let r2 = rgx_match("a*b", "b")
    if r2 != 1
        print("FAIL KAT2: rgx_match(a*b,b) expected 1 got " + str(r2))
        exit(1)

    // KAT 3: a+b does NOT match "b"
    let r3 = rgx_match("a+b", "b")
    if r3 != 0
        print("FAIL KAT3: rgx_match(a+b,b) expected 0 got " + str(r3))
        exit(1)

    // KAT 4: colou?r matches "color"
    let r4 = rgx_match("colou?r", "color")
    if r4 != 1
        print("FAIL KAT4: rgx_match(colou?r,color) expected 1 got " + str(r4))
        exit(1)

    // KAT 5: colou?r matches "colour"
    let r5 = rgx_match("colou?r", "colour")
    if r5 != 1
        print("FAIL KAT5: rgx_match(colou?r,colour) expected 1 got " + str(r5))
        exit(1)

    // KAT 6: (ab)+ matches "abab"
    let r6 = rgx_match("(ab)+", "abab")
    if r6 != 1
        print("FAIL KAT6: rgx_match((ab)+,abab) expected 1 got " + str(r6))
        exit(1)

    // KAT 7: [a-c]+ matches "abcabc"
    let r7 = rgx_match("[a-c]+", "abcabc")
    if r7 != 1
        print("FAIL KAT7: rgx_match([a-c]+,abcabc) expected 1 got " + str(r7))
        exit(1)

    // KAT 8: [^0-9]+ matches "abc"
    let r8 = rgx_match("[^0-9]+", "abc")
    if r8 != 1
        print("FAIL KAT8: rgx_match([^0-9]+,abc) expected 1 got " + str(r8))
        exit(1)

    // KAT 9: rgx_search("b","aaba") is true (b found at position 2)
    let r9 = rgx_search("b", "aaba")
    if r9 != 1
        print("FAIL KAT9: rgx_search(b,aaba) expected 1 got " + str(r9))
        exit(1)

    // KAT 10: a.c matches "axc" (dot matches any)
    let r10 = rgx_match("a.c", "axc")
    if r10 != 1
        print("FAIL KAT10: rgx_match(a.c,axc) expected 1 got " + str(r10))
        exit(1)

    // KAT 11: cat|dog matches "dog"
    let r11 = rgx_match("cat|dog", "dog")
    if r11 != 1
        print("FAIL KAT11: rgx_match(cat|dog,dog) expected 1 got " + str(r11))
        exit(1)

    // KAT 12: a*b does NOT match "c" (no b)
    let r12 = rgx_match("a*b", "c")
    if r12 != 0
        print("FAIL KAT12: rgx_match(a*b,c) expected 0 got " + str(r12))
        exit(1)

    // KAT 13: rgx_test is alias for rgx_search
    let r13 = rgx_test("b", "aaba")
    if r13 != 1
        print("FAIL KAT13: rgx_test(b,aaba) expected 1 got " + str(r13))
        exit(1)

    // KAT 14: [^0-9]+ does NOT match "123"
    let r14 = rgx_match("[^0-9]+", "123")
    if r14 != 0
        print("FAIL KAT14: rgx_match([^0-9]+,123) expected 0 got " + str(r14))
        exit(1)

    // KAT 15: alternation cat|dog does NOT match "fish"
    let r15 = rgx_match("cat|dog", "fish")
    if r15 != 0
        print("FAIL KAT15: rgx_match(cat|dog,fish) expected 0 got " + str(r15))
        exit(1)

    print("_regex_test passed")
