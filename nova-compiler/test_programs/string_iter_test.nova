let word = "NOVA"
let result = ""
for ch in word
    result = result + ch + "-"
print(result)

let count = 0
for c in "hello"
    count = count + 1
print(str(count))

let vowels = ""
for c in "programming"
    if c == "a" or c == "e" or c == "i" or c == "o" or c == "u"
        vowels = vowels + c
print(vowels)
