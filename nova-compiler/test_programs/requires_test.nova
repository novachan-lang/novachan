// Design-by-contract preconditions: `fn f(...) requires <expr>` injects an assert at
// function entry (zero ceremony). Params are in scope, so the precondition reads the
// arguments. When it holds the call runs normally; when violated it aborts with
// "precondition failed in '<fn>'". (Postconditions `ensures` are a tracked follow-up.)

fn safe_div(a: int, b: int) -> int requires b != 0
    a / b

fn clamp_pos(x: int) -> int requires x >= 0
    x

fn between(v: int, lo: int, hi: int) -> int requires v >= lo requires v <= hi
    v

fn main()
    assert_eq(safe_div(10, 2), 5)
    assert_eq(safe_div(9, 3), 3)
    assert_eq(clamp_pos(7), 7)
    assert_eq(clamp_pos(0), 0)
    // multiple `requires` clauses both hold
    assert_eq(between(5, 0, 10), 5)
    assert_eq(between(0, 0, 10), 0)
    assert_eq(between(10, 0, 10), 10)
    print("requires passed")
