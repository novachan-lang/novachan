// Design-by-contract: `requires <expr>` (preconditions, asserted at entry) and
// `ensures <expr>` (postconditions, where `result` is the return value, asserted on
// every return path). Both are contextual, repeatable, in any order. Holds -> the call
// runs normally; violated -> aborts with "pre/postcondition failed in '<fn>'". NOVA
// gives design-by-contract built in (Eiffel/Ada territory), zero ceremony.

fn safe_div(a: int, b: int) -> int requires b != 0
    a / b

fn clamp_pos(x: int) -> int requires x >= 0
    x

fn between(v: int, lo: int, hi: int) -> int requires v >= lo requires v <= hi
    v

// ensures: the result is checked after the body runs, on every return path
fn abs_val(x: int) -> int ensures result >= 0
    if x < 0
        return 0 - x
    x

fn doubled(x: int) -> int requires x >= 0 ensures result >= x
    x * 2

fn main()
    assert_eq(safe_div(10, 2), 5)
    assert_eq(safe_div(9, 3), 3)
    assert_eq(clamp_pos(7), 7)
    assert_eq(between(5, 0, 10), 5)
    assert_eq(between(0, 0, 10), 0)
    assert_eq(between(10, 0, 10), 10)
    // ensures holds for both branches (early return and fall-through)
    assert_eq(abs_val(-5), 5)
    assert_eq(abs_val(5), 5)
    assert_eq(abs_val(0), 0)
    // requires + ensures together
    assert_eq(doubled(3), 6)
    assert_eq(doubled(0), 0)
    print("requires passed")
