import std/os/signalname

fn main()
    // ── KAT 1: sig_name(9) == "SIGKILL" ──────────────────────────────────────
    let kat1 = sig_name(9)
    if kat1 != "SIGKILL"
        print("FAIL KAT1: sig_name(9) expected SIGKILL got " + kat1)
        exit(1)

    // ── KAT 2: sig_name(15) == "SIGTERM" ─────────────────────────────────────
    let kat2 = sig_name(15)
    if kat2 != "SIGTERM"
        print("FAIL KAT2: sig_name(15) expected SIGTERM got " + kat2)
        exit(1)

    // ── KAT 3: sig_name(2) == "SIGINT" ───────────────────────────────────────
    let kat3 = sig_name(2)
    if kat3 != "SIGINT"
        print("FAIL KAT3: sig_name(2) expected SIGINT got " + kat3)
        exit(1)

    // ── KAT 4: sig_name(11) == "SIGSEGV" ─────────────────────────────────────
    let kat4 = sig_name(11)
    if kat4 != "SIGSEGV"
        print("FAIL KAT4: sig_name(11) expected SIGSEGV got " + kat4)
        exit(1)

    // ── KAT 5: sig_number("SIGKILL") == 9 ────────────────────────────────────
    let kat5 = sig_number("SIGKILL")
    if kat5 != 9
        print("FAIL KAT5: sig_number(SIGKILL) expected 9 got " + str(kat5))
        exit(1)

    // ── KAT 6: sig_number("SIGTERM") == 15 ───────────────────────────────────
    let kat6 = sig_number("SIGTERM")
    if kat6 != 15
        print("FAIL KAT6: sig_number(SIGTERM) expected 15 got " + str(kat6))
        exit(1)

    // ── KAT 7: sig_number("SIGHUP") == 1 ─────────────────────────────────────
    let kat7 = sig_number("SIGHUP")
    if kat7 != 1
        print("FAIL KAT7: sig_number(SIGHUP) expected 1 got " + str(kat7))
        exit(1)

    // ── KAT 8: sig_number("KILL") == 9 (bare name, no SIG prefix) ────────────
    let kat8 = sig_number("KILL")
    if kat8 != 9
        print("FAIL KAT8: sig_number(KILL) expected 9 got " + str(kat8))
        exit(1)

    // ── KAT 9: sig_number("BOGUS") == -1 (unknown) ───────────────────────────
    let kat9 = sig_number("BOGUS")
    if kat9 != -1
        print("FAIL KAT9: sig_number(BOGUS) expected -1 got " + str(kat9))
        exit(1)

    // ── KAT 10: sig_name(999) == "SIG?" (unknown number) ─────────────────────
    let kat10 = sig_name(999)
    if kat10 != "SIG?"
        print("FAIL KAT10: sig_name(999) expected SIG? got " + kat10)
        exit(1)

    // ── KAT 11: sig_is_fatal_default(9) == true (SIGKILL always fatal) ────────
    let kat11 = sig_is_fatal_default(9)
    if kat11 != 1
        print("FAIL KAT11: sig_is_fatal_default(9) expected true")
        exit(1)

    // ── KAT 12: sig_is_fatal_default(17) == false (SIGCHLD default=ignore) ────
    let kat12 = sig_is_fatal_default(17)
    if kat12 != 0
        print("FAIL KAT12: sig_is_fatal_default(17) expected false")
        exit(1)

    // ── KAT 13: sig_is_fatal_default(19) == false (SIGSTOP default=stop) ──────
    let kat13 = sig_is_fatal_default(19)
    if kat13 != 0
        print("FAIL KAT13: sig_is_fatal_default(19) expected false")
        exit(1)

    // ── KAT 14: sig_is_fatal_default(15) == true (SIGTERM) ───────────────────
    let kat14 = sig_is_fatal_default(15)
    if kat14 != 1
        print("FAIL KAT14: sig_is_fatal_default(15) expected true")
        exit(1)

    // ── KAT 15: sig_list() contains "SIGKILL" and "SIGTERM" ──────────────────
    let lst = sig_list()
    let found_kill = 0
    let found_term = 0
    let li = 0
    let llen = len(lst)
    while li < llen
        let entry = lst[li]
        if entry == "SIGKILL"
            found_kill = 1
        if entry == "SIGTERM"
            found_term = 1
        li = li + 1
    if found_kill != 1
        print("FAIL KAT15a: sig_list() missing SIGKILL")
        exit(1)
    if found_term != 1
        print("FAIL KAT15b: sig_list() missing SIGTERM")
        exit(1)

    // ── KAT 16: sig_list() length == 31 (one entry per signal 1-31) ──────────
    let list_len = len(sig_list())
    if list_len != 31
        print("FAIL KAT16: sig_list() length expected 31 got " + str(list_len))
        exit(1)

    // ── KAT 17: sig_number("sigkill") == 9 (lowercase bare prefix-less) ──────
    let kat17 = sig_number("sigkill")
    if kat17 != 9
        print("FAIL KAT17: sig_number(sigkill lowercase) expected 9 got " + str(kat17))
        exit(1)

    // ── KAT 18: round-trip: sig_number(sig_name(n)) == n for key signals ──────
    let rt1 = sig_number(sig_name(1))
    if rt1 != 1
        print("FAIL KAT18a: round-trip sig 1 failed got " + str(rt1))
        exit(1)
    let rt6 = sig_number(sig_name(6))
    if rt6 != 6
        print("FAIL KAT18b: round-trip sig 6 failed got " + str(rt6))
        exit(1)
    let rt13 = sig_number(sig_name(13))
    if rt13 != 13
        print("FAIL KAT18c: round-trip sig 13 failed got " + str(rt13))
        exit(1)

    print("_signalname_test passed")
