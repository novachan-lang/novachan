import forge_service_registry

fn main()
    let r = sr_new()
    r = sr_register(r, "auth-service", "10.0.1.1", 8080)
    let id1 = sr_last_id(r)
    r = sr_register(r, "auth-service", "10.0.1.2", 8080)
    let id2 = sr_last_id(r)
    r = sr_register(r, "user-service", "10.0.2.1", 9090)
    let id3 = sr_last_id(r)

    assert(sr_count(r) == 3, "3 services")

    let auth = sr_lookup(r, "auth-service")
    assert(len(auth) == 2, "2 auth instances")

    let user = sr_lookup(r, "user-service")
    assert(len(user) == 1, "1 user instance")

    r = sr_set_health(r, id1, false)
    let auth2 = sr_lookup(r, "auth-service")
    assert(len(auth2) == 1, "1 healthy auth")

    r = sr_set_health(r, id1, true)
    let auth3 = sr_lookup(r, "auth-service")
    assert(len(auth3) == 2, "2 healthy auth again")

    r = sr_tag(r, id1, "primary")
    r = sr_tag(r, id2, "secondary")
    r = sr_tag(r, id3, "primary")

    let primaries = sr_lookup_tag(r, "primary")
    assert(len(primaries) == 2, "2 primaries")

    r = sr_deregister(r, id2)
    assert(sr_count(r) == 2, "2 after deregister")

    r = sr_set_meta(r, id3, "version", "2.0")
    assert(r["services"][str(id3)]["metadata"]["version"] == "2.0", "meta set")

    let all = sr_all_healthy(r)
    assert(len(all) == 2, "2 healthy total")

    print("SERVICE-REGISTRY KAT PASS")
