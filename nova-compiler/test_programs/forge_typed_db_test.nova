// S1 typed-DB round-trip: db_insert (skip id PK), db_all<Todo>, db_find<Todo>, db_delete.
import forge_db
type Todo
    id: int
    title: string
    done: int

fn main()
    let pool = pool_open(":memory:", 1)
    pool_exec(pool, "CREATE TABLE todos (id INTEGER PRIMARY KEY, title TEXT, done INTEGER)")
    let id1 = db_insert(pool, "todos", Todo(0, "milk", 0))
    let id2 = db_insert(pool, "todos", Todo(0, "code", 1))
    if id1 != 1 or id2 != 2
        print("FAIL insert ids " + str(id1) + " " + str(id2))
        exit(1)
    let all: list<Todo> = db_all(pool, "todos")
    if len(all) != 2
        print("FAIL db_all count " + str(len(all)))
        exit(1)
    let first = all[0]
    if first.title != "milk" or first.id != 1
        print("FAIL db_all[0] title=" + first.title + " id=" + str(first.id))
        exit(1)
    let one: Result<Todo> = db_find(pool, "todos", 2)
    match one
        Ok(t) =>
            if t.title != "code" or t.done != 1
                print("FAIL db_find title=" + t.title + " done=" + str(t.done))
                exit(1)
        Err(e) =>
            print("FAIL db_find_err " + e)
            exit(1)
    let n = db_delete(pool, "todos", 1)
    if n != 1
        print("FAIL db_delete count " + str(n))
        exit(1)
    let after: list<Todo> = db_all(pool, "todos")
    if len(after) != 1
        print("FAIL after-delete count " + str(len(after)))
        exit(1)
    print("PASS forge_typed_db (insert/all/find/delete round-trip)")
