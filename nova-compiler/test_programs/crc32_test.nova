// CRC-32/ISO-HDLC correctness test — standard vectors + collision check

fn main()
    // Standard test vector: crc32("123456789") == 0xCBF43926 == 3421780262
    assert_eq(crc32("123456789"), 3421780262)

    // crc32("") == 0
    assert_eq(crc32(""), 0)

    // Known vector: crc32("The quick brown fox jumps over the lazy dog") == 0x414FA339 == 1095738169
    assert_eq(crc32("The quick brown fox jumps over the lazy dog"), 1095738169)

    // Single-char-change must NOT collide (the old truncated table had this collision)
    let a = crc32("hello world")
    let b = crc32("hello worle")
    if a == b
        print("FAIL: crc32 collision on hello world/worle")
        assert_eq(1, 0)

    // Determinism: same input -> same output
    assert_eq(crc32("nova"), crc32("nova"))

    // Different inputs differ
    if crc32("foo") == crc32("bar")
        print("FAIL: crc32 foo/bar collide")
        assert_eq(1, 0)

    print("crc32_test passed")
