// forge_pctdecode_test -- percent-decoding of query params, form bodies, and the static path.
// Query/form values were returned RAW (Jos%C3%A9, %20, +); now decoded. And encoded traversal
// (%2e%2e%2f) in the static path is normalised then blocked by the segment whitelist.
import forge

fn main()
    // query params: %20 -> space, + -> space, %C3%A9 -> the raw UTF-8 bytes of 'é'
    let req: Request = forge.build_request("GET /s?q=hello+world&name=Jos%C3%A9&city=New%20York HTTP/1.1\r\n\r\n", 0)
    assert(forge.req_query(req, "q") == "hello world", "query + -> space")
    assert(forge.req_query(req, "city") == "New York", "query %20 -> space")
    // 'é' UTF-8 = bytes 0xC3 0xA9 -> chr(195)+chr(169)
    assert(forge.req_query(req, "name") == "Jos" + chr(195) + chr(169), "query %C3%A9 -> raw UTF-8 bytes")
    print("PASS: query percent-decode")

    // form body decode (application/x-www-form-urlencoded)
    let f = forge.form_decode("user=a%40b.com&msg=hi+there")
    assert(f["user"] == "a@b.com", "form %40 -> @")
    assert(f["msg"] == "hi there", "form + -> space")
    print("PASS: form percent-decode")

    // encoded traversal in the static path is blocked (decode-then-whitelist)
    let a = forge.app()
    forge.static(a, "/assets", "_static_fixture")
    let trav: Response = forge.dispatch_req(a, forge.build_request("GET /assets/%2e%2e%2fforge.nova HTTP/1.1\r\n\r\n", 0))
    assert(trav.status == 404, "encoded ..%2f traversal blocked (404)")
    assert(find(trav.body, "import forge") < 0, "encoded traversal did not leak source")
    // a normal encoded space in a filename still resolves the real file
    let css: Response = forge.dispatch_req(a, forge.build_request("GET /assets/style.css HTTP/1.1\r\n\r\n", 0))
    assert(css.status == 200, "normal static file still served")
    print("PASS: encoded traversal blocked, normal serve intact")
    print("forge_pctdecode_test passed")
