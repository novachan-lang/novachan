// ── Edit distance for 'did you mean?' ────────────────────────────────────────

fn edit_distance(a: string, b: string) -> int
    let la = len(a)
    let lb = len(b)
    if la == 0
        return lb
    if lb == 0
        return la
    let prev = []
    let j = 0
    while j <= lb
        push(prev, j)
        j = j + 1
    let i = 1
    while i <= la
        let curr = [i]
        let j2 = 1
        while j2 <= lb
            let cost = 1
            if a[i - 1] == b[j2 - 1]
                cost = 0
            let del_cost = prev[j2] + 1
            let ins_cost = curr[j2 - 1] + 1
            let sub_cost = prev[j2 - 1] + cost
            let best = del_cost
            if ins_cost < best
                best = ins_cost
            if sub_cost < best
                best = sub_cost
            push(curr, best)
            j2 = j2 + 1
        prev = curr
        i = i + 1
    prev[lb]

fn ti_suggest_name(st: TiState, vname: string) -> string
    let best = ""
    let best_dist = 999
    let max_dist = 3
    if len(vname) <= 3
        max_dist = 1
    else if len(vname) <= 6
        max_dist = 2
    let scope = st.ti_scope
    let si = len(scope) - 1
    while si >= 0
        let frame = scope[si]
        for k in keys(frame)
            let d = edit_distance(vname, k)
            if d < best_dist and d <= max_dist and d > 0
                best_dist = d
                best = k
        si = si - 1
    for k in keys(st.ti_stdlib)
        let d = edit_distance(vname, k)
        if d < best_dist and d <= max_dist and d > 0
            best_dist = d
            best = k
    best

// ── Scope lookup ─────────────────────────────────────────────────────────────

fn ti_lookup(st: TiState, vname: string, line: int) -> NType
    let scope = st.ti_scope
    let i = len(scope) - 1
    while i >= 0
        let frame = scope[i]
        if contains(frame, vname)
            return ti_instantiate(st, frame[vname])
        i = i - 1
    let stdlib = st.ti_stdlib
    if contains(stdlib, vname)
        let scheme = stdlib[vname]
        return ti_instantiate(st, scheme)
    let suggestion = ti_suggest_name(st, vname)
    let msg = "unknown identifier '" + vname + "'"
    if suggestion != ""
        msg = msg + "; did you mean '" + suggestion + "'?"
    ti_error(st, msg, line)
    nt_any()

// ── Source type annotation to NType ──────────────────────────────────────────

fn ti_ann_to_type(ann: string) -> NType
    if ann == "int"
        return nt_int()
    if ann == "string" or ann == "str"
        return nt_string()
    if ann == "float"
        return nt_float()
    if ann == "bool"
        return nt_bool()
    if ann == "list"
        return nt_list(nt_any())
    if ann == "dict"
        return nt_dict(nt_string(), nt_any())
    nt_any()

// ── Expression inference ─────────────────────────────────────────────────────

fn ti_infer_expr(st: TiState, expr: Expr) -> NType
    ti_infer_expr_inner(st, expr)

fn ti_infer_expr_inner(st: TiState, expr: Expr) -> NType
    match expr
        Expr(tag, value, num, children, fields, eline) =>
            if tag == "int"
                return nt_int()
            if tag == "float"
                return nt_float()
            if tag == "str" or tag == "str_interp"
                return nt_string()
            if tag == "bool"
                return nt_bool()
            if tag == "null"
                return nt_any()
            if tag == "ident"
                return ti_lookup(st, value, eline)
            if tag == "call"
                let fn_t = ti_lookup(st, value, eline)
                let arg_types = []
                let ai = 0
                while ai < len(children)
                    push(arg_types, ti_infer_expr(st, children[ai]))
                    ai = ai + 1
                let ret_var = ti_fresh(st)
                let expected_fn = nt_fn(arg_types, ret_var)
                ti_constrain(st, fn_t, expected_fn, eline)
                return ret_var
            if tag == "method_call" or tag == "dyn_call"
                let ai = 0
                while ai < len(children)
                    ti_infer_expr(st, children[ai])
                    ai = ai + 1
                return nt_any()
            if tag == "binop"
                let left = ti_infer_expr(st, children[0])
                let right = ti_infer_expr(st, children[1])
                if value == "+" or value == "-" or value == "*" or value == "/" or value == "%" or value == "**"
                    ti_constrain(st, left, right, eline)
                    return left
                if value == "==" or value == "!=" or value == "<" or value == ">" or value == "<=" or value == ">="
                    ti_constrain(st, left, right, eline)
                    return nt_bool()
                if value == "and" or value == "or"
                    ti_constrain(st, left, nt_bool(), eline)
                    ti_constrain(st, right, nt_bool(), eline)
                    return nt_bool()
                if value == "&" or value == "|" or value == "^" or value == "<<" or value == ">>"
                    ti_constrain(st, left, nt_int(), eline)
                    ti_constrain(st, right, nt_int(), eline)
                    return nt_int()
                return left
            if tag == "unary"
                let operand = ti_infer_expr(st, children[0])
                if value == "not"
                    ti_constrain(st, operand, nt_bool(), eline)
                    return nt_bool()
                return operand
            if tag == "list"
                if len(children) == 0
                    return nt_list(ti_fresh(st))
                let elem_t = ti_infer_expr(st, children[0])
                let ci = 1
                while ci < len(children)
                    let ct = ti_infer_expr(st, children[ci])
                    ti_constrain(st, elem_t, ct, eline)
                    ci = ci + 1
                return nt_list(elem_t)
            if tag == "dict"
                return nt_dict(nt_string(), nt_any())
            if tag == "tuple"
                let elem_types = []
                for c in children
                    push(elem_types, ti_infer_expr(st, c))
                return nt_tuple(elem_types)
            if tag == "index"
                let container = ti_infer_expr(st, children[0])
                ti_infer_expr(st, children[1])
                return nt_any()
            if tag == "member"
                if len(children) > 0
                    ti_infer_expr(st, children[0])
                return nt_any()
            if tag == "if"
                let cond = ti_infer_expr(st, children[0])
                ti_constrain(st, cond, nt_bool(), eline)
                if len(children) > 1
                    let then_t = ti_infer_expr(st, children[1])
                    if len(children) > 2
                        let else_t = ti_infer_expr(st, children[2])
                        ti_constrain(st, then_t, else_t, eline)
                    return then_t
                return nt_any()
            if tag == "lambda"
                return nt_any()
            if tag == "match"
                return nt_any()
            if tag == "for"
                return nt_any()
            if tag == "try" or tag == "catch"
                return nt_any()
            if tag == "pair"
                if len(children) > 1
                    return ti_infer_expr(st, children[1])
                return nt_any()
            return nt_any()
    nt_any()

// ── Statement inference ──────────────────────────────────────────────────────

fn ti_infer_stmt(st: TiState, stmt: Stmt) -> NType
    ti_infer_stmt_inner(st, stmt)

fn ti_infer_stmt_inner(st: TiState, stmt: Stmt) -> NType
    match stmt
        Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
            if tag == "fn"
                let saved_fn = st.ti_in_fn
                st.ti_in_fn = name
                let param_types = []
                for p in params
                    match p
                        Param(pname, ptype, pdefault) =>
                            let pt = ti_fresh(st)
                            if ptype != "" and ptype != "any"
                                pt = ti_ann_to_type(ptype)
                            push(param_types, pt)
                let ret_var = ti_fresh(st)
                let fn_type = nt_fn(param_types, ret_var)
                let fn_name = name
                if fn_name == "main"
                    fn_name = "nova_user_main"
                let fn_scheme = ti_mono(fn_type)
                ti_define(st, name, fn_scheme)
                let saved_ret = st.ti_ret_var
                st.ti_ret_var = ret_var
                ti_push_scope(st)
                let pi = 0
                for p in params
                    match p
                        Param(pname, ptype, pdefault) =>
                            ti_define(st, pname, ti_mono(param_types[pi]))
                            pi = pi + 1
                let last_t = nt_unit()
                for s in body
                    last_t = ti_infer_stmt(st, s)
                let is_nothing = false
                match last_t
                    NType(lk, ln, lp, li) =>
                        if lk == "nothing"
                            is_nothing = true
                if not is_nothing
                    ti_constrain(st, ret_var, last_t, sline)
                ti_pop_scope(st)
                st.ti_ret_var = saved_ret
                ti_solve(st)
                let resolved = ti_apply(st, fn_type)
                ti_define(st, name, ti_generalize(st, resolved))
                st.ti_fn_types[fn_name] = ti_to_ir_kind(ti_apply(st, ret_var))
                st.ti_in_fn = saved_fn
                return nt_unit()
            if tag == "type"
                let field_map = {}
                for p in params
                    match p
                        Param(pname, ptype, pdefault) =>
                            field_map[pname] = ti_ann_to_type(ptype)
                st.ti_structs[name] = field_map
                let field_types = []
                for p in params
                    match p
                        Param(pname, ptype, pdefault) =>
                            push(field_types, ti_ann_to_type(ptype))
                let ctor_type = nt_fn(field_types, nt_struct(name))
                ti_define(st, name, ti_mono(ctor_type))
                return nt_unit()
            if tag == "assign"
                let rhs = ti_infer_expr(st, expr)
                if name != ""
                    let in_local = false
                    for frame in st.ti_scope
                        if contains(frame, name)
                            in_local = true
                    if not in_local
                        ti_define(st, name, ti_mono(rhs))
                    else
                        let existing = ti_lookup(st, name, sline)
                        let we = ti_walk(st, existing)
                        let we_is_unbound_any = false
                        match we
                            NType(wk, wn, wp, wi_id) =>
                                if wk == "any" and wn == ""
                                    we_is_unbound_any = true
                        if we_is_unbound_any
                            ti_define(st, name, ti_mono(rhs))
                        else
                            ti_constrain(st, existing, rhs, sline)
                    return nt_unit()
                else if len(annotations) > 0
                    let lhs_expr = annotations[0]
                    let lhs_is_ident = false
                    let lhs_ident_name = ""
                    match lhs_expr
                        Expr(et, ev, en, ec, ef, eln) =>
                            if et == "ident"
                                lhs_is_ident = true
                                lhs_ident_name = ev
                    if lhs_is_ident
                        let in_local = false
                        for frame in st.ti_scope
                            if contains(frame, lhs_ident_name)
                                in_local = true
                        if not in_local
                            ti_define(st, lhs_ident_name, ti_mono(rhs))
                        else
                            let existing = ti_lookup(st, lhs_ident_name, sline)
                            let we = ti_walk(st, existing)
                            let we_is_unbound_any = false
                            match we
                                NType(wk, wn, wp, wi_id) =>
                                    if wk == "any" and wn == ""
                                        we_is_unbound_any = true
                            if we_is_unbound_any
                                ti_define(st, lhs_ident_name, ti_mono(rhs))
                            else
                                ti_constrain(st, existing, rhs, sline)
                    else
                        let lhs = ti_infer_expr(st, lhs_expr)
                        ti_constrain(st, lhs, rhs, sline)
                return nt_unit()
            if tag == "compound_assign"
                let rhs = ti_infer_expr(st, expr)
                if len(annotations) > 0
                    let lhs = ti_infer_expr(st, annotations[0])
                    ti_constrain(st, lhs, rhs, sline)
                return nt_unit()
            if tag == "expr"
                return ti_infer_expr(st, expr)
            if tag == "return"
                match expr
                    Expr(et, ev, en, ec, ef, eln) =>
                        if et != "null" or ev != "" or en != 0
                            let rt = ti_infer_expr(st, expr)
                            ti_constrain(st, st.ti_ret_var, rt, sline)
                            return nt_nothing()
                return nt_nothing()
            if tag == "yield"
                ti_infer_expr(st, expr)
                return nt_unit()
            if tag == "break" or tag == "continue"
                return nt_unit()
            if tag == "if"
                let cond = ti_infer_expr(st, expr)
                ti_constrain(st, cond, nt_bool(), sline)
                ti_push_scope(st)
                let last_t = nt_unit()
                for s in body
                    last_t = ti_infer_stmt(st, s)
                ti_pop_scope(st)
                if len(else_body) > 0
                    ti_push_scope(st)
                    for s in else_body
                        ti_infer_stmt(st, s)
                    ti_pop_scope(st)
                return nt_unit()
            if tag == "while"
                let cond = ti_infer_expr(st, expr)
                ti_constrain(st, cond, nt_bool(), sline)
                ti_push_scope(st)
                for s in body
                    ti_infer_stmt(st, s)
                ti_pop_scope(st)
                return nt_unit()
            if tag == "for"
                let iter_t = ti_infer_expr(st, expr)
                let elem_var = ti_fresh(st)
                let wi = ti_walk(st, iter_t)
                match wi
                    NType(wk, wn, wp, wi_id) =>
                        if wk == "list" and len(wp) > 0
                            ti_constrain(st, elem_var, wp[0], sline)
                        else if wk == "range"
                            ti_constrain(st, elem_var, nt_int(), sline)
                        else if wk == "string"
                            ti_constrain(st, elem_var, nt_string(), sline)
                        else if wk == "dict" and len(wp) > 0
                            ti_constrain(st, elem_var, wp[0], sline)
                ti_push_scope(st)
                ti_define(st, name, ti_mono(elem_var))
                for s in body
                    ti_infer_stmt(st, s)
                ti_pop_scope(st)
                return nt_unit()
            if tag == "match"
                let subj = ti_infer_expr(st, expr)
                for arm in body
                    match arm
                        Stmt(at, an, ae, abody, ap, aeb, aann, asln) =>
                            if at == "arm"
                                ti_push_scope(st)
                                ti_infer_pattern(st, ae, subj)
                                for s in abody
                                    ti_infer_stmt(st, s)
                                ti_pop_scope(st)
                return nt_unit()
            if tag == "import"
                return nt_unit()
            if tag == "block"
                ti_push_scope(st)
                let last_t = nt_unit()
                for s in body
                    last_t = ti_infer_stmt(st, s)
                ti_pop_scope(st)
                return last_t
            return nt_unit()
    nt_unit()

// ── Pattern inference (match arms) ───────────────────────────────────────────

fn ti_infer_pattern(st: TiState, pat: Expr, expected: NType)
    match pat
        Expr(tag, value, num, children, fields, eline) =>
            if tag == "pat_var"
                ti_define(st, value, ti_mono(expected))
            else if tag == "pat_wild"
                return
            else if tag == "pat_lit"
                ti_constrain(st, expected, nt_int(), eline)
            else if tag == "pat_str"
                ti_constrain(st, expected, nt_string(), eline)
            else if tag == "pat_ctor"
                for child in children
                    match child
                        Expr(ct, cv, cn, cc, cf, cln) =>
                            if ct == "pat_var"
                                ti_define(st, cv, ti_mono(ti_fresh(st)))

// ── Resolved type to IR type kind ────────────────────────────────────────────

fn ti_to_ir_kind(t: NType) -> string
    match t
        NType(kind, name, params, id) =>
            if kind == "int" or kind == "bool"
                return "int"
            if kind == "float"
                return "int"
            if kind == "string"
                return "str"
            if kind == "list"
                return "list"
            if kind == "dict"
                return "dict"
            if kind == "struct"
                return "struct"
    "any"

// ── Main entry point: infer types for a parsed program ───────────────────────

fn ti_infer_program(stmts: list, source_lines: list) -> TiState
    let st = ti_new(source_lines)
    let si = 0
    while si < len(stmts)
        match stmts[si]
            Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
                if tag == "fn"
                    let param_types = []
                    for p in params
                        push(param_types, ti_fresh(st))
                    let ret_var = ti_fresh(st)
                    ti_define(st, name, ti_mono(nt_fn(param_types, ret_var)))
        si = si + 1
    si = 0
    while si < len(stmts)
        ti_infer_stmt(st, stmts[si])
        si = si + 1
    st

// ── IR Type Inference ────────────────────────────────────────────────────────

fn ir_reg_type(reg_types: dict, reg: string) -> string
    if contains(reg_types, reg)
        return reg_types[reg]
    "any"

fn ir_infer_one(rt: dict, st: dict, frt: dict, inst: IrInst) -> IrInst
    match inst
        IrInst(op, dest, typ, args, value, num, effect) =>
            if op == "const_int"
                rt[dest] = "int"
                return IrInst(op, dest, ir_type_int(), args, value, num, effect)
            else if op == "const_str"
                rt[dest] = "str"
                return IrInst(op, dest, ir_type_str(), args, value, num, effect)
            else if op == "add"
                let lt = ir_reg_type(rt, args[0])
                let rty = ir_reg_type(rt, args[1])
                if lt == "int" and rty == "int"
                    rt[dest] = "int"
                    return IrInst(op, dest, ir_type_int(), args, value, num, effect)
                else if lt == "str" or rty == "str"
                    rt[dest] = "str"
                    return IrInst(op, dest, ir_type_str(), args, value, num, effect)
                else if lt == "list" or rty == "list"
                    rt[dest] = "list"
                    return IrInst("call", dest, ir_type_any(), args, "nova_rt_list_concat", num, effect)
                rt[dest] = "any"
                return inst
            else if op == "sub" or op == "mul" or op == "div" or op == "mod" or op == "neg"
                rt[dest] = "int"
                return IrInst(op, dest, ir_type_int(), args, value, num, effect)
            else if op == "eq" or op == "neq"
                let lt = ir_reg_type(rt, args[0])
                let rty = ir_reg_type(rt, args[1])
                let itype = ir_type_any()
                if lt == "int" and rty == "int"
                    itype = ir_type_int()
                else if lt == "str" or rty == "str"
                    itype = ir_type_str()
                rt[dest] = "int"
                return IrInst(op, dest, itype, args, value, num, effect)
            else if op == "lt" or op == "le" or op == "gt" or op == "ge"
                rt[dest] = "int"
                return IrInst(op, dest, ir_type_int(), args, value, num, effect)
            else if op == "not" or op == "and" or op == "or"
                rt[dest] = "int"
                return IrInst(op, dest, ir_type_int(), args, value, num, effect)
            else if op == "slot_load"
                let stype = "any"
                if contains(st, value)
                    stype = st[value]
                rt[dest] = stype
                return IrInst(op, dest, IrType(stype, "", [], 0), args, value, num, effect)
            else if op == "slot_store"
                let val_type = ir_reg_type(rt, args[0])
                if contains(st, value)
                    if st[value] != val_type
                        st[value] = "any"
                else
                    st[value] = val_type
                return inst
            else if op == "call"
                if value == "nova_rt_print_any" and len(args) == 1
                    let arg_type = ir_reg_type(rt, args[0])
                    if arg_type == "bool"
                        if dest != ""
                            rt[dest] = "int"
                        return IrInst(op, dest, typ, args, "nova_rt_print_bool", num, effect)
                if dest != ""
                    let rtype = "any"
                    if value == "nova_rt_len" or value == "nova_rt_len_any" or value == "nova_rt_ord" or value == "nova_rt_parse_int" or value == "nova_rt_system"
                        rtype = "int"
                    else if value == "nova_rt_contains" or value == "nova_rt_starts_with" or value == "nova_rt_ends_with"
                        rtype = "bool"
                    else if value == "nova_rt_str_concat" or value == "nova_rt_int_to_str" or value == "nova_rt_any_to_str" or value == "nova_rt_chr" or value == "nova_rt_exec"
                        rtype = "str"
                    else if value == "nova_rt_list_create" or value == "nova_rt_list_append" or value == "nova_rt_list_concat" or value == "nova_rt_chars" or value == "nova_rt_range" or value == "nova_rt_list_sort" or value == "nova_rt_list_reverse" or value == "nova_rt_list_map" or value == "nova_rt_list_filter" or value == "nova_rt_list_slice" or value == "nova_rt_dict_keys" or value == "nova_rt_dict_values" or value == "nova_rt_dict_items" or value == "nova_rt_args"
                        rtype = "list"
                    else if value == "nova_rt_dict_create"
                        rtype = "dict"
                    else if contains(frt, value)
                        rtype = frt[value]
                    rt[dest] = rtype
                return inst
            else if op == "make_struct"
                if dest != ""
                    rt[dest] = "struct"
                return inst
            else if op == "make_list"
                if dest != ""
                    rt[dest] = "list"
                return inst
            else if op == "make_dict"
                if dest != ""
                    rt[dest] = "dict"
                return inst
            else if op == "index_get"
                if dest != ""
                    rt[dest] = "any"
                return inst
            else if op == "field_get"
                if dest != ""
                    if value == "__type_hash"
                        rt[dest] = "int"
                    else
                        rt[dest] = "any"
                return inst
            else if op == "is_error"
                if dest != ""
                    rt[dest] = "int"
                return IrInst(op, dest, ir_type_int(), args, value, num, effect)
            else if op == "set_error"
                if dest != ""
                    rt[dest] = "any"
                return inst
            else if op == "load_error_msg"
                if dest != ""
                    rt[dest] = "str"
                return IrInst(op, dest, ir_type_str(), args, value, num, effect)
            else if op == "raise_error"
                return inst
            return inst

fn ir_infer_block(rt: dict, st: dict, frt: dict, block: IrBlock) -> IrBlock
    match block
        IrBlock(label, insts, terminator) =>
            let new_insts = []
            for inst in insts
                push(new_insts, ir_infer_one(rt, st, frt, inst))
            IrBlock(label, new_insts, terminator)

fn ir_infer_types(func: IrFunction, frt: dict) -> IrFunction
    match func
        IrFunction(name, params, ret_type, blocks, type_params, is_extern) =>
            if is_extern == 1
                return func
            let st = {}
            for p in params
                match p
                    IrParam(pname, ptype) =>
                        match ptype
                            IrType(tk, tn, tp, tid) =>
                                if tk == "int" or tk == "str" or tk == "list" or tk == "dict"
                                    st[pname] = tk
                                else
                                    st[pname] = "any"
            let pass_n = 0
            let new_blocks = []
            let converged = false
            while not converged and pass_n < 3
                pass_n = pass_n + 1
                let old_keys = keys(st)
                let old_vals = []
                for k in old_keys
                    push(old_vals, st[k])
                let rt = {}
                new_blocks = []
                for block in blocks
                    push(new_blocks, ir_infer_block(rt, st, frt, block))
                converged = true
                let i = 0
                while i < len(old_keys)
                    if contains(st, old_keys[i])
                        if st[old_keys[i]] != old_vals[i]
                            converged = false
                    i = i + 1
            IrFunction(name, params, ret_type, new_blocks, type_params, is_extern)

fn ir_analyze_return_type(func: IrFunction, frt: dict) -> string
    match func
        IrFunction(name, params, ret_type, blocks, type_params, is_extern) =>
            let rt = {}
            let st = {}
            for p in params
                match p
                    IrParam(pname, ptype) =>
                        match ptype
                            IrType(tk, tn, tp, tid) =>
                                if tk == "int" or tk == "str" or tk == "list" or tk == "dict"
                                    st[pname] = tk
                                else
                                    st[pname] = "any"
            let pass_n = 0
            while pass_n < 3
                pass_n = pass_n + 1
                rt = {}
                for block in blocks
                    ir_infer_block(rt, st, frt, block)
            for block in blocks
                match block
                    IrBlock(label, insts, terminator) =>
                        match terminator
                            IrInst(top, tdest, ttyp, targs, tval, tnum, teff) =>
                                if top == "return" and len(targs) > 0
                                    let rv = targs[0]
                                    if rv != "0" and contains(rt, rv)
                                        return rt[rv]
            "any"

// ── IR → LLVM Emission ───────────────────────────────────────────────────────

type IrEmitter
    ire_out: list
    ire_strs: list
    ire_smap: dict
    ire_sc: int
    ire_reg_types: dict
    ire_tc: int

fn new_ir_emitter() -> IrEmitter
    IrEmitter([], [], {}, 0, {}, 0)

fn ire_fresh_tmp(e: IrEmitter, prefix: string) -> string
    let name = "%" + prefix + str(e.ire_tc)
    e.ire_tc = e.ire_tc + 1
    name

fn ire_line(e: IrEmitter, line: string)
    push(e.ire_out, line)

fn ire_indent(e: IrEmitter, line: string)
    push(e.ire_out, "  " + line)

fn ire_intern_string(e: IrEmitter, s: string) -> string
    if contains(e.ire_smap, s)
        return e.ire_smap[s]
    let escaped = llvm_escape_string(s)
    let name = "@.str." + str(e.ire_sc)
    e.ire_sc = e.ire_sc + 1
    let byte_len = len(s) + 1
    push(e.ire_strs, name + " = private unnamed_addr constant [" + str(byte_len) + " x i8] c\"" + escaped + "\\00\"")
    e.ire_smap[s] = name
    name

fn ire_emit_inst(e: IrEmitter, inst: IrInst)
    match inst
        IrInst(op, dest, typ, args, value, num, effect) =>
            if op == "const_int"
                ire_indent(e, dest + " = add i64 " + str(num) + ", 0")
            else if op == "const_str"
                let str_name = ire_intern_string(e, value)
                let byte_len = len(value) + 1
                let ptr_reg = dest + ".p"
                ire_indent(e, ptr_reg + " = getelementptr inbounds [" + str(byte_len) + " x i8], ptr " + str_name + ", i64 0, i64 0")
                ire_indent(e, dest + " = ptrtoint ptr " + ptr_reg + " to i64")
            else if op == "add"
                match typ
                    IrType(tk, tn, tp, tid) =>
                        if tk == "int"
                            ire_indent(e, dest + " = add i64 " + args[0] + ", " + args[1])
                        else if tk == "str"
                            ire_indent(e, dest + " = call i64 @nova_rt_str_concat(i64 " + args[0] + ", i64 " + args[1] + ")")
                        else
                            ire_indent(e, dest + " = call i64 @nova_rt_add(i64 " + args[0] + ", i64 " + args[1] + ")")
            else if op == "sub"
                // sub is always integer (no string subtraction)
                ire_indent(e, dest + " = sub i64 " + args[0] + ", " + args[1])
            else if op == "mul"
                // mul is always integer
                ire_indent(e, dest + " = mul i64 " + args[0] + ", " + args[1])
            else if op == "div"
                // div is always integer
                ire_indent(e, dest + " = sdiv i64 " + args[0] + ", " + args[1])
            else if op == "mod"
                ire_indent(e, dest + " = srem i64 " + args[0] + ", " + args[1])
            else if op == "neg"
                ire_indent(e, dest + " = sub i64 0, " + args[0])
            else if op == "eq"
                match typ
                    IrType(tk, tn, tp, tid) =>
                        if tk == "int"
                            let tmp = dest + ".cmp"
                            ire_indent(e, tmp + " = icmp eq i64 " + args[0] + ", " + args[1])
                            ire_indent(e, dest + " = zext i1 " + tmp + " to i64")
                        else if tk == "str"
                            let p0 = dest + ".p0"
                            let p1 = dest + ".p1"
                            let cmp = dest + ".sc"
                            let tmp = dest + ".cmp"
                            ire_indent(e, p0 + " = inttoptr i64 " + args[0] + " to ptr")
                            ire_indent(e, p1 + " = inttoptr i64 " + args[1] + " to ptr")
                            ire_indent(e, cmp + " = call i32 @strcmp(ptr " + p0 + ", ptr " + p1 + ")")
                            ire_indent(e, tmp + " = icmp eq i32 " + cmp + ", 0")
                            ire_indent(e, dest + " = zext i1 " + tmp + " to i64")
                        else
                            ire_indent(e, dest + " = call i64 @nova_rt_eq(i64 " + args[0] + ", i64 " + args[1] + ")")
            else if op == "neq"
                match typ
                    IrType(tk, tn, tp, tid) =>
                        if tk == "int"
                            let tmp = dest + ".cmp"
                            ire_indent(e, tmp + " = icmp ne i64 " + args[0] + ", " + args[1])
                            ire_indent(e, dest + " = zext i1 " + tmp + " to i64")
                        else if tk == "str"
                            let p0 = dest + ".p0"
                            let p1 = dest + ".p1"
                            let cmp = dest + ".sc"
                            let tmp = dest + ".cmp"
                            ire_indent(e, p0 + " = inttoptr i64 " + args[0] + " to ptr")
                            ire_indent(e, p1 + " = inttoptr i64 " + args[1] + " to ptr")
                            ire_indent(e, cmp + " = call i32 @strcmp(ptr " + p0 + ", ptr " + p1 + ")")
                            ire_indent(e, tmp + " = icmp ne i32 " + cmp + ", 0")
                            ire_indent(e, dest + " = zext i1 " + tmp + " to i64")
                        else
                            ire_indent(e, dest + " = call i64 @nova_rt_neq(i64 " + args[0] + ", i64 " + args[1] + ")")
            else if op == "lt"
                let tmp = dest + ".cmp"
                ire_indent(e, tmp + " = icmp slt i64 " + args[0] + ", " + args[1])
                ire_indent(e, dest + " = zext i1 " + tmp + " to i64")
            else if op == "le"
                let tmp = dest + ".cmp"
                ire_indent(e, tmp + " = icmp sle i64 " + args[0] + ", " + args[1])
                ire_indent(e, dest + " = zext i1 " + tmp + " to i64")
            else if op == "gt"
                let tmp = dest + ".cmp"
                ire_indent(e, tmp + " = icmp sgt i64 " + args[0] + ", " + args[1])
                ire_indent(e, dest + " = zext i1 " + tmp + " to i64")
            else if op == "ge"
                let tmp = dest + ".cmp"
                ire_indent(e, tmp + " = icmp sge i64 " + args[0] + ", " + args[1])
                ire_indent(e, dest + " = zext i1 " + tmp + " to i64")
            else if op == "not"
                let tmp = dest + ".cmp"
                ire_indent(e, tmp + " = icmp eq i64 " + args[0] + ", 0")
                ire_indent(e, dest + " = zext i1 " + tmp + " to i64")
            else if op == "and"
                let tmp = dest + ".cmp"
                ire_indent(e, tmp + " = icmp ne i64 " + args[0] + ", 0")
                let tmp2 = dest + ".cmp2"
                ire_indent(e, tmp2 + " = icmp ne i64 " + args[1] + ", 0")
                let tmp3 = dest + ".and"
                ire_indent(e, tmp3 + " = and i1 " + tmp + ", " + tmp2)
                ire_indent(e, dest + " = zext i1 " + tmp3 + " to i64")
            else if op == "or"
                let tmp = dest + ".cmp"
                ire_indent(e, tmp + " = icmp ne i64 " + args[0] + ", 0")
                let tmp2 = dest + ".cmp2"
                ire_indent(e, tmp2 + " = icmp ne i64 " + args[1] + ", 0")
                let tmp3 = dest + ".or"
                ire_indent(e, tmp3 + " = or i1 " + tmp + ", " + tmp2)
                ire_indent(e, dest + " = zext i1 " + tmp3 + " to i64")
            else if op == "slot_load"
                ire_indent(e, dest + " = load i64, ptr %slot." + value + ", align 8")
                let slot_key = "slot." + value
                if contains(e.ire_reg_types, slot_key)
                    e.ire_reg_types[dest] = e.ire_reg_types[slot_key]
            else if op == "slot_store"
                ire_indent(e, "store i64 " + args[0] + ", ptr %slot." + value + ", align 8")
                if contains(e.ire_reg_types, args[0])
                    e.ire_reg_types["slot." + value] = e.ire_reg_types[args[0]]
            else if op == "call"
                let call_inlined = false
                if value == "nova_rt_index_set" and len(args) == 3
                    let tgt_kind = ""
                    if contains(e.ire_reg_types, args[0])
                        tgt_kind = e.ire_reg_types[args[0]]
                    if tgt_kind == "list"
                        let lp = ire_fresh_tmp(e, "_iset.lp")
                        let dp = ire_fresh_tmp(e, "_iset.dp")
                        let ep = ire_fresh_tmp(e, "_iset.ep")
                        ire_indent(e, lp + " = inttoptr i64 " + args[0] + " to ptr")
                        ire_indent(e, dp + " = load ptr, ptr " + lp + ", align 8, !tbaa !2")
                        ire_indent(e, ep + " = getelementptr i64, ptr " + dp + ", i64 " + args[1])
                        ire_indent(e, "store i64 " + args[2] + ", ptr " + ep + ", align 8, !tbaa !4")
                        call_inlined = true
                if value == "nova_rt_index_get" and len(args) == 2
                    let tgt_kind = ""
                    if contains(e.ire_reg_types, args[0])
                        tgt_kind = e.ire_reg_types[args[0]]
                    if tgt_kind == "list"
                        let lp = dest + ".lp"
                        let dp = dest + ".dp"
                        let ep = dest + ".ep"
                        ire_indent(e, lp + " = inttoptr i64 " + args[0] + " to ptr")
                        ire_indent(e, dp + " = load ptr, ptr " + lp + ", align 8, !tbaa !2")
                        ire_indent(e, ep + " = getelementptr i64, ptr " + dp + ", i64 " + args[1])
                        ire_indent(e, dest + " = load i64, ptr " + ep + ", align 8, !tbaa !4")
                        call_inlined = true
                if value == "nova_rt_list_create" and dest != ""
                    e.ire_reg_types[dest] = "list"
                if value == "nova_rt_dict_create" and dest != ""
                    e.ire_reg_types[dest] = "dict"
                if not call_inlined
                    let call_str = "call i64 @" + value + "("
                    let i = 0
                    while i < len(args)
                        if i > 0
                            call_str = call_str + ", "
                        call_str = call_str + "i64 " + args[i]
                        i = i + 1
                    call_str = call_str + ")"
                    if dest != ""
                        ire_indent(e, dest + " = " + call_str)
                    else
                        ire_indent(e, call_str)
            else if op == "make_struct"
                let size = (num + 1) * 8
                ire_indent(e, dest + ".ptr = call ptr @nova_rt_struct_alloc(i64 " + str(size) + ")")
                let hash_val = type_name_hash(value)
                let hash_gep = dest + ".thash"
                ire_indent(e, hash_gep + " = getelementptr i64, ptr " + dest + ".ptr, i64 0")
                ire_indent(e, "store i64 " + str(hash_val) + ", ptr " + hash_gep + ", align 8")
                let fi = 0
                while fi < len(args)
                    let gep = dest + ".f" + str(fi)
                    ire_indent(e, gep + " = getelementptr i64, ptr " + dest + ".ptr, i64 " + str(fi + 1))
                    ire_indent(e, "store i64 " + args[fi] + ", ptr " + gep + ", align 8")
                    fi = fi + 1
                ire_indent(e, dest + " = ptrtoint ptr " + dest + ".ptr to i64")
            else if op == "make_list"
                ire_indent(e, dest + " = call i64 @nova_rt_list_create()")
                let i = 0
                while i < len(args)
                    ire_indent(e, "call i64 @nova_rt_list_append(i64 " + dest + ", i64 " + args[i] + ")")
                    i = i + 1
                e.ire_reg_types[dest] = "list"
            else if op == "make_dict"
                ire_indent(e, dest + " = call i64 @nova_rt_dict_create()")
                e.ire_reg_types[dest] = "dict"
            else if op == "index_get"
                let target_kind = ""
                if contains(e.ire_reg_types, args[0])
                    target_kind = e.ire_reg_types[args[0]]
                if target_kind == "list"
                    let lp = dest + ".lp"
                    let dp = dest + ".dp"
                    let ep = dest + ".ep"
                    ire_indent(e, lp + " = inttoptr i64 " + args[0] + " to ptr")
                    ire_indent(e, dp + " = load ptr, ptr " + lp + ", align 8, !tbaa !2")
                    ire_indent(e, ep + " = getelementptr i64, ptr " + dp + ", i64 " + args[1])
                    ire_indent(e, dest + " = load i64, ptr " + ep + ", align 8, !tbaa !4")
                else if target_kind == "dict"
                    ire_indent(e, dest + " = call i64 @nova_rt_dict_get(i64 " + args[0] + ", i64 " + args[1] + ")")
                else
                    ire_indent(e, dest + " = call i64 @nova_rt_index_get(i64 " + args[0] + ", i64 " + args[1] + ")")
            else if op == "field_get"
                let ptr_name = dest + ".ptr"
                ire_indent(e, ptr_name + " = inttoptr i64 " + args[0] + " to ptr")
                let gep = dest + ".gep"
                ire_indent(e, gep + " = getelementptr i64, ptr " + ptr_name + ", i64 " + str(num))
                ire_indent(e, dest + " = load i64, ptr " + gep + ", align 8")
            else if op == "field_set"
                let ptr_name = dest + ".ptr"
                ire_indent(e, ptr_name + " = inttoptr i64 " + args[0] + " to ptr")
                let gep = dest + ".gep"
                ire_indent(e, gep + " = getelementptr i64, ptr " + ptr_name + ", i64 " + str(num))
                ire_indent(e, "store i64 " + args[1] + ", ptr " + gep + ", align 8")
            else if op == "make_closure"
                // Allocate closure record: [trampoline_ptr, cap0, cap1, ...]
                let record_size = (1 + num) * 8
                ire_indent(e, dest + ".ptr = call ptr @nova_rt_struct_alloc(i64 " + str(record_size) + ")")
                // Store trampoline function pointer at slot 0
                let tramp_gep = dest + ".tgep"
                ire_indent(e, tramp_gep + " = getelementptr i64, ptr " + dest + ".ptr, i64 0")
                let tramp_val = dest + ".tfn"
                ire_indent(e, tramp_val + " = ptrtoint ptr @" + value + " to i64")
                ire_indent(e, "store i64 " + tramp_val + ", ptr " + tramp_gep + ", align 8")
                // Store captures at slots 1, 2, ...
                let ci = 0
                while ci < len(args)
                    let cap_gep = dest + ".c" + str(ci)
                    ire_indent(e, cap_gep + " = getelementptr i64, ptr " + dest + ".ptr, i64 " + str(ci + 1))
                    ire_indent(e, "store i64 " + args[ci] + ", ptr " + cap_gep + ", align 8")
                    ci = ci + 1
                ire_indent(e, dest + " = ptrtoint ptr " + dest + ".ptr to i64")
            else if op == "dyn_call"
                // Dynamic closure call: args[0] = closure record, args[1..] = call arguments
                // num = number of actual arguments (excluding closure record)
                let rec_ptr = dest + ".rec"
                ire_indent(e, rec_ptr + " = inttoptr i64 " + args[0] + " to ptr")
                let fn_raw = dest + ".fnraw"
                ire_indent(e, fn_raw + " = load i64, ptr " + rec_ptr + ", align 8")
                let fn_ptr = dest + ".fnptr"
                ire_indent(e, fn_ptr + " = inttoptr i64 " + fn_raw + " to ptr")
                // Build call: fn_ptr(closure_record, arg0, arg1, ...)
                let call_str = "call i64 " + fn_ptr + "(i64 " + args[0]
                let ai = 1
                while ai < len(args)
                    call_str = call_str + ", i64 " + args[ai]
                    ai = ai + 1
                call_str = call_str + ")"
                if dest != ""
                    ire_indent(e, dest + " = " + call_str)
                else
                    ire_indent(e, call_str)
            else if op == "set_error"
                ire_indent(e, "store i64 1, ptr @__nova_error_flag")
                if len(args) > 0
                    ire_indent(e, "store i64 " + args[0] + ", ptr @__nova_error_msg")
                if dest != ""
                    ire_indent(e, dest + " = add i64 0, 0")
            else if op == "is_error"
                let flag_tmp = dest + ".fl"
                let cmp_tmp = dest + ".cmp"
                ire_indent(e, flag_tmp + " = load i64, ptr @__nova_error_flag")
                ire_indent(e, "store i64 0, ptr @__nova_error_flag")
                ire_indent(e, cmp_tmp + " = icmp ne i64 " + flag_tmp + ", 0")
                ire_indent(e, dest + " = zext i1 " + cmp_tmp + " to i64")
            else if op == "load_error_msg"
                let msg_tmp = dest + ".raw"
                ire_indent(e, msg_tmp + " = load i64, ptr @__nova_error_msg")
                ire_indent(e, "store i64 0, ptr @__nova_error_msg")
                ire_indent(e, dest + " = add i64 " + msg_tmp + ", 0")
            else if op == "raise_error"
                ire_indent(e, "store i64 1, ptr @__nova_error_flag")

fn ire_is_loop_header(label: string) -> int
    if contains(label, "for_body") or contains(label, "while_body")
        return 1
    return 0

fn ire_is_backedge(label: string) -> int
    if contains(label, "for_hdr") or contains(label, "while_hdr")
        return 1
    return 0

fn ire_emit_terminator(e: IrEmitter, term: IrInst)
    match term
        IrInst(op, dest, typ, args, value, num, effect) =>
            if op == "return"
                if len(args) > 0
                    ire_indent(e, "ret i64 " + args[0])
                else
                    ire_indent(e, "ret i64 0")
            else if op == "goto"
                if ire_is_backedge(value) == 1
                    ire_indent(e, "br label %" + value + ", !llvm.loop !91")
                else
                    ire_indent(e, "br label %" + value)
            else if op == "branch"
                let cond_cmp = dest + ".br"
                let prof_hint = ""
                if ire_is_loop_header(value) == 1
                    prof_hint = ", !prof !90"
                if cond_cmp == ".br"
                    let cond_cmp2 = "%br_" + value
                    ire_indent(e, cond_cmp2 + " = icmp ne i64 " + args[0] + ", 0")
                    ire_indent(e, "br i1 " + cond_cmp2 + ", label %" + value + ", label %" + args[1] + prof_hint)
                else
                    ire_indent(e, cond_cmp + " = icmp ne i64 " + args[0] + ", 0")
                    ire_indent(e, "br i1 " + cond_cmp + ", label %" + value + ", label %" + args[1] + prof_hint)

fn ire_collect_slots(blocks: list, param_names: list) -> list
    let slots = []
    for block in blocks
        match block
            IrBlock(label, insts, terminator) =>
                for inst in insts
                    match inst
                        IrInst(op, dest, typ, args, value, num, effect) =>
                            if (op == "slot_store" or op == "slot_load") and value != ""
                                if not list_contains(slots, value) and not list_contains(param_names, value)
                                    push(slots, value)
    slots

fn ire_emit_function(e: IrEmitter, func: IrFunction)
    // Reset per-function state
    e.ire_reg_types = {}
    e.ire_tc = 0
    match func
        IrFunction(name, params, ret_type, blocks, type_params, is_extern) =>
            if is_extern == 1
                let decl = "declare i64 @" + name + "("
                let i = 0
                while i < len(params)
                    if i > 0
                        decl = decl + ", "
                    decl = decl + "i64"
                    i = i + 1
                decl = decl + ") nounwind"
                ire_line(e, decl)
                return 0
            let header = "define i64 @" + name + "("
            let i = 0
            while i < len(params)
                if i > 0
                    header = header + ", "
                header = header + "i64 %p" + str(i)
                i = i + 1
            header = header + ") nounwind \{"
            ire_line(e, header)
            // Collect param names for alloca exclusion
            let param_names = []
            let pi = 0
            while pi < len(params)
                match params[pi]
                    IrParam(pname, ptype) =>
                        push(param_names, pname)
                pi = pi + 1
            // Collect all local slot names (excluding params)
            let local_slots = ire_collect_slots(blocks, param_names)
            for block in blocks
                match block
                    IrBlock(label, insts, terminator) =>
                        ire_line(e, label + ":")
                        if label == "entry"
                            // Allocate param slots
                            let pi2 = 0
                            while pi2 < len(params)
                                match params[pi2]
                                    IrParam(pname, ptype) =>
                                        ire_indent(e, "%slot." + pname + " = alloca i64, align 8")
                                        ire_indent(e, "store i64 %p" + str(pi2) + ", ptr %slot." + pname + ", align 8")
                                pi2 = pi2 + 1
                            // Allocate local variable slots
                            for slot_name in local_slots
                                ire_indent(e, "%slot." + slot_name + " = alloca i64, align 8")
                                ire_indent(e, "store i64 0, ptr %slot." + slot_name + ", align 8")
                        for inst in insts
                            ire_emit_inst(e, inst)
                        ire_emit_terminator(e, terminator)
            ire_line(e, "}")
            ire_line(e, "")

// ── Main Compiler Pipeline ───────────────────────────────────────────────────

fn compile(source: string) -> string
    let tokens = tokenize(source)
    let stmts = parse_program(tokens)
    let cg = new_codegen()

    // Separate functions from top-level statements
    let functions = []
    let top_stmts = []
    for s in stmts
        match s
            Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
                if tag == "fn"
                    push(functions, s)
                    push(cg.fn_names, name)
                else if tag == "type"
                    // Register struct fields and build field→index map
                    cg.struct_defs[name] = params
                    let fi = 0
                    for p in params
                        match p
                            Param(pname, ptype, pdefault) =>
                                cg.field_map[pname] = fi
                        fi = fi + 1
                else if tag != "import"
                    push(top_stmts, s)

    // Pass 1: Generate all string constants (by doing a dry-run or pre-scan)
    // For now, strings are interned during codegen

    // Emit module
    emit_module_header(cg)
    emit_runtime_declarations(cg)

    // Emit user functions
    for fn_stmt in functions
        emit_function(cg, fn_stmt)

    // Emit main
    emit_nova_main(cg, top_stmts)
    emit_main_entry(cg)

    // Emit string constants (at end, so we know all of them)
    emit_string_constants(cg)

    join(cg.output, "\n")

// ── IR-Based Compiler Pipeline ───────────────────────────────────────────────

fn compile_ir_core(source: string, base_dir: string) -> string
    let tokens = tokenize(source)
    let stmts = parse_program(tokens)

    // Split source into lines for error display
    let source_lines = split(source, "\n")

    // AST-level type inference (Hindley-Milner)
    let ti_state = ti_infer_program(stmts, source_lines)
    if len(ti_state.ti_errors) > 0
        for err in ti_state.ti_errors
            print(err)

    let b = new_ir_builder()
    let e = new_ir_emitter()

    // Resolve and compile imported modules
    let import_ir_fns = resolve_and_compile_imports(b, stmts, base_dir)

    // Separate functions, types, and top-level statements
    let functions = []
    let top_stmts = []
    for s in stmts
        match s
            Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
                if tag == "fn"
                    push(functions, s)
                    let fn_name = name
                    if fn_name == "main"
                        fn_name = "nova_user_main"
                    push(b.ir_fnames, fn_name)
                    b.ir_fn_arity[fn_name] = len(params)
                else if tag == "type"
                    b.ir_sdefs[name] = params
                    let fi = 1
                    for p in params
                        match p
                            Param(pname, ptype, pdefault) =>
                                b.ir_fmap[pname] = fi
                        fi = fi + 1
                else if tag != "import"
                    push(top_stmts, s)

    // Emit module header
    ire_line(e, "; NOVA IR-Pipeline Compiler Output")
    ire_line(e, "target datalayout = \"e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128\"")
    ire_line(e, "")
    ire_line(e, "@__nova_error_flag = thread_local global i64 0")
    ire_line(e, "@__nova_error_msg = thread_local global i64 0")
    ire_line(e, "")

    // Emit runtime declarations (same as original)
    ire_line(e, "; Runtime declarations")
    ire_line(e, "declare i32 @puts(ptr) nounwind")
    ire_line(e, "declare i32 @printf(ptr, ...) nounwind")
    ire_line(e, "declare i32 @strcmp(ptr, ptr) nounwind")
    ire_line(e, "declare i64 @nova_rt_list_create() nounwind")
    ire_line(e, "declare i64 @nova_rt_list_append(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_list_get(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_list_len(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_dict_create() nounwind")
    ire_line(e, "declare i64 @nova_rt_dict_set(i64, i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_dict_get(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_dict_contains(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_str_concat(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_int_to_str(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_parse_int(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_len(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_len_any(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_ord(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_chr(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_contains(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_index_get(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_index_set(i64, i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_add(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_sub(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_mul(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_div(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_eq(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_neq(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_any_to_str(i64) nounwind")
    ire_line(e, "declare void @nova_rt_assert(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_read_file(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_write_file(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_args() nounwind")
    ire_line(e, "declare void @nova_rt_exit(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_split(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_join(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_upper(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_lower(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_trim(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_replace(i64, i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_starts_with(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_ends_with(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_print_any(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_print_bool(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_float_bits(i64) nounwind")
    ire_line(e, "declare ptr @nova_rt_struct_alloc(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_slice(i64, i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_repeat(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_chars(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_time_ms() nounwind")
    ire_line(e, "declare i64 @nova_rt_sleep_ms(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_clock_ns() nounwind")
    ire_line(e, "declare i64 @nova_rt_type_of(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_range(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_range_from_to(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_dict_keys(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_dict_values(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_dict_items(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_dict_has(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_dict_del(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_system(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_exec(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_create_string(ptr) nounwind")
    ire_line(e, "declare void @nova_rt_init_args(i64, i64) nounwind")
    ire_line(e, "declare void @nova_rt_wait_all() nounwind")
    ire_line(e, "declare void @nova_rt_cleanup() nounwind")
    ire_line(e, "declare i64 @nova_rt_parse_float(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_read_line() nounwind")
    ire_line(e, "declare i64 @nova_rt_append_file(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_file_exists(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_find(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_list_concat(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_list_reverse(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_list_sort(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_list_slice(i64, i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_http_get(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_http_post(i64, i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_mkdir(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_mkdir_p(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_path_join(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_path_exists(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_path_parent(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_path_name(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_read_bytes(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_write_raw(i64) nounwind")
    ire_line(e, "")

    // Pass 1: Lower all functions to IR (start with imported module functions)
    let ir_fns = []
    for imp_fn in import_ir_fns
        push(ir_fns, imp_fn)
    for fn_stmt in functions
        let ir_fn = ir_lower_function(b, fn_stmt)
        push(ir_fns, ir_fn)

    // Include lambdas generated during function lowering
    for lam_fn in b.ir_lambdas
        push(ir_fns, lam_fn)
    let lambdas_before_main = len(b.ir_lambdas)

    // Pass 2: Analyze return types (inter-procedural)
    // Seed frt with AST-level type inference results (more accurate)
    let frt = {}
    for ti_fname in keys(ti_state.ti_fn_types)
        frt[ti_fname] = ti_state.ti_fn_types[ti_fname]
    // Refine with IR-level heuristic analysis (catches cases AST missed)
    let changed = true
    let pass_count = 0
    while changed and pass_count < 4
        changed = false
        pass_count = pass_count + 1
        for ir_fn in ir_fns
            match ir_fn
                IrFunction(fname, fp, fret, fblocks, ftp, fex) =>
                    let old_type = "any"
                    if contains(frt, fname)
                        old_type = frt[fname]
                    let new_type = ir_analyze_return_type(ir_fn, frt)
                    if new_type != old_type and new_type != "any"
                        frt[fname] = new_type
                        changed = true

    // Pass 3: Infer types with inter-procedural info and emit
    for ir_fn in ir_fns
        let typed_fn = ir_infer_types(ir_fn, frt)
        ire_emit_function(e, typed_fn)

    // Lower, infer types, and emit nova_main (top-level statements)
    b.ir_insts = []
    b.ir_blocks = []
    b.ir_clabel = "entry"
    b.ir_rc = 0
    b.ir_locals = {}
    for s in top_stmts
        ir_lower_stmt(b, s)
    if list_contains(b.ir_fnames, "nova_user_main")
        let umr = ir_fresh_reg(b)
        ir_emit_side(b, "call", umr, ir_type_any(), [], "nova_user_main", 0)
    ir_flush_pending_block(b)
    if len(b.ir_blocks) == 0
        ir_finish_block(b, IrInst("return", "", ir_type_void(), ["0"], "", 0, "pure"))
    let main_fn = IrFunction("nova_main", [], ir_type_any(), b.ir_blocks, [], 0)
    let typed_main = ir_infer_types(main_fn, frt)
    ire_emit_function(e, typed_main)

    // Emit any lambdas generated during nova_main lowering
    let mi = lambdas_before_main
    while mi < len(b.ir_lambdas)
        let lam_fn = b.ir_lambdas[mi]
        let typed_lam = ir_infer_types(lam_fn, frt)
        ire_emit_function(e, typed_lam)
        mi = mi + 1

    // Emit trampolines
    for spec in b.ir_tramps
        let tname = spec[0]
        let target = spec[1]
        let ncap = spec[2]
        let npar = spec[3]
        let hdr = "define i64 @" + tname + "(i64 %record"
        let pi = 0
        while pi < npar
            hdr = hdr + ", i64 %p" + str(pi)
            pi = pi + 1
        hdr = hdr + ") nounwind \{"
        ire_line(e, hdr)
        ire_line(e, "entry:")
        if ncap > 0
            ire_indent(e, "%rec_ptr = inttoptr i64 %record to ptr")
            let ci = 0
            while ci < ncap
                let gep_name = "%cap" + str(ci) + "_ptr"
                ire_indent(e, gep_name + " = getelementptr i64, ptr %rec_ptr, i64 " + str(ci + 1))
                ire_indent(e, "%cap" + str(ci) + " = load i64, ptr " + gep_name + ", align 8")
                ci = ci + 1
        let call_str = "call i64 @" + target + "("
        let first_arg = 1
        let ci2 = 0
        while ci2 < ncap
            if first_arg == 0
                call_str = call_str + ", "
            call_str = call_str + "i64 %cap" + str(ci2)
            first_arg = 0
            ci2 = ci2 + 1
        let pi2 = 0
        while pi2 < npar
            if first_arg == 0
                call_str = call_str + ", "
            call_str = call_str + "i64 %p" + str(pi2)
            first_arg = 0
            pi2 = pi2 + 1
        call_str = call_str + ")"
        ire_indent(e, "%result = " + call_str)
        ire_indent(e, "ret i64 %result")
        ire_line(e, "}")
        ire_line(e, "")

    // Emit main entry point
    ire_line(e, "define i32 @main(i32 %argc, ptr %argv) nounwind \{")
    ire_line(e, "entry:")
    ire_indent(e, "%argc64 = sext i32 %argc to i64")
    ire_indent(e, "%argv64 = ptrtoint ptr %argv to i64")
    ire_indent(e, "call void @nova_rt_init_args(i64 %argc64, i64 %argv64)")
    ire_indent(e, "call i64 @nova_main()")
    ire_indent(e, "call void @nova_rt_wait_all()")
    ire_indent(e, "call void @nova_rt_cleanup()")
    ire_indent(e, "ret i32 0")
    ire_line(e, "}")
    ire_line(e, "")

    // Emit string constants
    if len(e.ire_strs) > 0
        ire_line(e, "; String constants")
        for sc in e.ire_strs
            ire_line(e, sc)
        ire_line(e, "")

    // Emit TBAA and loop metadata
    let dq = chr(34)
    let lb = chr(123)
    let rb = chr(125)
    ire_line(e, "; TBAA metadata")
    ire_line(e, "!0 = !" + lb + "!" + dq + "NOVA TBAA" + dq + rb)
    ire_line(e, "!1 = !" + lb + "!" + dq + "list_data_ptr" + dq + ", !0" + rb)
    ire_line(e, "!2 = !" + lb + "!1, !1, i64 0" + rb)
    ire_line(e, "!3 = !" + lb + "!" + dq + "list_elem" + dq + ", !0" + rb)
    ire_line(e, "!4 = !" + lb + "!3, !3, i64 0" + rb)
    ire_line(e, "!5 = !" + lb + "!" + dq + "list_size" + dq + ", !0" + rb)
    ire_line(e, "!6 = !" + lb + "!5, !5, i64 0" + rb)
    ire_line(e, "!90 = !" + lb + "!" + dq + "branch_weights" + dq + ", i32 2000, i32 1" + rb)
    ire_line(e, "!91 = distinct !" + lb + "!91, !92, !93" + rb)
    ire_line(e, "!92 = !" + lb + "!" + dq + "llvm.loop.unroll.enable" + dq + rb)
    ire_line(e, "!93 = !" + lb + "!" + dq + "llvm.loop.vectorize.enable" + dq + ", i1 true" + rb)
    ire_line(e, "")

    join(e.ire_out, "\n")

fn compile_ir(source: string) -> string
    compile_ir_core(source, "")

// ── Entry Point ──────────────────────────────────────────────────────────────

fn path_dir(path: string) -> string
    let last_sep = -1
    let i = 0
    while i < len(path)
        if path[i] == "/" or path[i] == "\\"
            last_sep = i
        i = i + 1
    if last_sep < 0
        return ""
    slice(path, 0, last_sep + 1)

fn resolve_module_file(name: string, base_dir: string) -> string
    let sep = "/"
    if contains(base_dir, "\\")
        sep = "\\"
    let candidate = base_dir + name + ".nova"
    let content = read_file(candidate)
    if len(content) > 0
        return candidate
    candidate = name + ".nova"
    content = read_file(candidate)
    if len(content) > 0
        return candidate
    candidate = path_join(path_join("nova_packages", name), name + ".nova")
    content = read_file(candidate)
    if len(content) > 0
        return candidate
    candidate = path_join("nova_packages", name + ".nova")
    content = read_file(candidate)
    if len(content) > 0
        return candidate
    return ""

fn compile_module_ir(b: IrBuilder, mod_source: string, mod_name: string, visited: dict) -> list
    let tokens = tokenize(mod_source)
    let stmts = parse_program(tokens)
    let mod_fns = []
    let exported = []
    for s in stmts
        match s
            Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
                if tag == "fn"
                    push(mod_fns, s)
                    push(b.ir_fnames, name)
                    b.ir_fn_arity[name] = len(params)
                    if len(name) > 0 and name[0] != "_"
                        push(exported, name)
                else if tag == "type"
                    b.ir_sdefs[name] = params
                    let fi = 1
                    for p in params
                        match p
                            Param(pname, ptype, pdefault) =>
                                b.ir_fmap[pname] = fi
                        fi = fi + 1
    let ir_fns = []
    for fn_stmt in mod_fns
        let ir_fn = ir_lower_function(b, fn_stmt)
        push(ir_fns, ir_fn)
    for lam_fn in b.ir_lambdas
        push(ir_fns, lam_fn)
    b.ir_lambdas = []
    b.ir_modules[mod_name] = exported
    ir_fns

fn resolve_and_compile_imports(b: IrBuilder, stmts: list, base_dir: string) -> list
    let all_ir_fns = []
    let visited = {}
    for s in stmts
        match s
            Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
                if tag == "import"
                    let mod_name = name
                    let alias = mod_name
                    if len(annotations) > 0
                        alias = annotations[0]
                    if not contains(visited, mod_name)
                        visited[mod_name] = 1
                        let mod_path = resolve_module_file(mod_name, base_dir)
                        if mod_path == ""
                            print("error: cannot find module '" + mod_name + "'")
                            exit(1)
                        let mod_source = read_file(mod_path)
                        let mod_fns = compile_module_ir(b, mod_source, alias, visited)
                        for mf in mod_fns
                            push(all_ir_fns, mf)
    all_ir_fns

fn nova_replace_ext(path: string, old_ext: string, new_ext: string) -> string
    if ends_with(path, old_ext)
        return slice(path, 0, len(path) - len(old_ext)) + new_ext
    return path + new_ext

fn nova_compile_file(input_path: string, output_path: string, use_ir: int) -> string
    let source = read_file(input_path)
    if len(source) == 0
        print("error: cannot read '" + input_path + "'")
        exit(1)
    let base_dir = path_dir(input_path)
    let llvm_ir = if use_ir == 1
        compile_ir_core(source, base_dir)
    else
        compile(source)
    write_file(output_path, llvm_ir)
    return output_path

fn nova_find_runtime() -> string
    let candidates = ["output/nova_runtime.c", "test_programs/output/nova_runtime.c", "nova_runtime.c"]
    for c in candidates
        let content = read_file(c)
        if contains(content, "nova_rt_system")
            return c
    for c in candidates
        let content = read_file(c)
        if len(content) > 100
            return c
    return "nova_runtime.c"

fn nova_link(ll_path: string, exe_path: string, opt_level: string) -> int
    let rt = nova_find_runtime()
    let cmd = "clang " + opt_level + " -w \"" + ll_path + "\" \"" + rt + "\" -o \"" + exe_path + "\" -lws2_32 -lwinhttp 2>&1"
    let ret = system(cmd)
    return ret

// ── Package Manager ─────────────────────────────────────────────────────────

fn nova_toml_default(name: string) -> string
    let content = "[package]\n"
    content = content + "name = \"" + name + "\"\n"
    content = content + "version = \"0.1.0\"\n"
    content = content + "description = \"\"\n"
    content = content + "author = \"\"\n"
    content = content + "\n"
    content = content + "[dependencies]\n"
    content

fn nova_pkg_init()
    let existing = read_file("nova.toml")
    if len(existing) > 0
        print("nova.toml already exists")
        return 0
    let content = nova_toml_default("my-project")
    write_file("nova.toml", content)
    print("Created nova.toml")

fn nova_parse_toml_deps(content: string) -> dict
    let deps = {}
    let lines = split(content, "\n")
    let in_deps = 0
    let idx = 0
    while idx < len(lines)
        let trimmed = trim(lines[idx])
        if trimmed == "[dependencies]"
            in_deps = 1
        else if len(trimmed) > 0
            let first_ch = slice(trimmed, 0, 1)
            if first_ch == "["
                in_deps = 0
            else if in_deps == 1 and first_ch != "#"
                let eq_pos = find(trimmed, "=")
                if eq_pos >= 0
                    let key = trim(slice(trimmed, 0, eq_pos))
                    let val = trim(slice(trimmed, eq_pos + 1, len(trimmed)))
                    if len(val) >= 2
                        let vfirst = slice(val, 0, 1)
                        if vfirst == "\""
                            val = slice(val, 1, len(val) - 1)
                    deps[key] = val
        idx = idx + 1
    deps

fn nova_registry_url() -> string
    "https://raw.githubusercontent.com/nova-lang/packages/main/registry/"

fn nova_pkg_is_valid_source(content: string) -> int
    if len(content) == 0
        return 0
    let t = trim(content)
    if starts_with(t, "<") or starts_with(t, "<!") or starts_with(t, "404")
        return 0
    if starts_with(t, "fn ") or starts_with(t, "//") or starts_with(t, "let ") or starts_with(t, "type ") or starts_with(t, "import ") or starts_with(t, "enum ")
        return 1
    if find(t, "fn ") >= 0
        return 1
    return 0

fn nova_pkg_download(pkg_name: string, pkg_version: string) -> int
    let pkg_dir = path_join("nova_packages", pkg_name)
    let marker = path_join(pkg_dir, pkg_name + ".nova")
    if path_exists(marker) == 1
        return 1
    mkdir_p(path_join("nova_packages", pkg_name))
    let registry = nova_registry_url()
    let index_url = registry + pkg_name + "/index.toml"
    let index_content = http_get(index_url)
    if len(index_content) > 0 and nova_pkg_is_valid_source(index_content) == 0
        let lines = split(index_content, "\n")
        let src_url = ""
        for line in lines
            let trimmed = trim(line)
            if starts_with(trimmed, "source")
                let eq = find(trimmed, "=")
                if eq >= 0
                    src_url = trim(slice(trimmed, eq + 1, len(trimmed)))
                    if len(src_url) >= 2 and slice(src_url, 0, 1) == "\""
                        src_url = slice(src_url, 1, len(src_url) - 1)
        if len(src_url) > 0
            let content = http_get(src_url)
            if nova_pkg_is_valid_source(content) == 1
                write_file(marker, content)
                print("  Downloaded " + pkg_name)
                return 1
            else
                print("  warning: " + pkg_name + " source URL returned invalid content")
    let gh_url = "https://raw.githubusercontent.com/nova-lang/pkg-" + pkg_name + "/main/" + pkg_name + ".nova"
    let content = http_get(gh_url)
    if nova_pkg_is_valid_source(content) == 1
        write_file(marker, content)
        print("  Downloaded " + pkg_name + " (github)")
        return 1
    print("  error: could not download " + pkg_name + " — package not found in registry or github")
    print("  Place " + pkg_name + ".nova in nova_packages/" + pkg_name + "/ manually")
    return 0

fn nova_pkg_install()
    let toml = read_file("nova.toml")
    if len(toml) == 0
        print("error: no nova.toml found. Run nova init first")
        exit(1)
    let deps = nova_parse_toml_deps(toml)
    let dep_keys = keys(deps)
    if len(dep_keys) == 0
        print("No dependencies to install")
        return 0
    print("Installing " + str(len(dep_keys)) + " package(s)...")
    let installed = 0
    for pkg_name in dep_keys
        let version = deps[pkg_name]
        let ok = nova_pkg_download(pkg_name, version)
        if ok == 1
            installed = installed + 1
    print("Installed " + str(installed) + "/" + str(len(dep_keys)) + " packages")

fn nova_pkg_get(pkg_spec: string)
    let pkg_name = pkg_spec
    let pkg_version = "*"
    let at_pos = find(pkg_spec, "@")
    if at_pos >= 0
        pkg_name = slice(pkg_spec, 0, at_pos)
        pkg_version = slice(pkg_spec, at_pos + 1, len(pkg_spec))
    let toml = read_file("nova.toml")
    if len(toml) == 0
        print("error: no nova.toml found. Run nova init first")
        exit(1)
    let deps = nova_parse_toml_deps(toml)
    if contains(deps, pkg_name)
        print("Package " + pkg_name + " already in dependencies")
        return 0
    let dep_line = pkg_name + " = " + chr(34) + pkg_version + chr(34) + "\n"
    let new_toml = toml + dep_line
    write_file("nova.toml", new_toml)
    print("Added " + pkg_name + "@" + pkg_version + " to nova.toml")
    nova_pkg_download(pkg_name, pkg_version)

fn compiler_main()
    let arguments = args()
    if len(arguments) < 2
        print("NOVA Programming Language v0.1.0")
        print("Usage: nova <command> [options] <file.nova>")
        print("Commands:")
        print("  run <file.nova>       Compile and run")
        print("  build <file.nova>     Compile to executable")
        print("  compile <file.nova>   Compile to LLVM IR")
        print("  version               Show version")
        print("  self-test             Run compiler self-test")
        print("  init                  Create nova.toml in current directory")
        print("  get <package>         Add a dependency")
        print("  install               Download all dependencies from nova.toml")
        print("Legacy: nova <file.nova> [output.ll]")
        exit(0)
    let cmd = arguments[1]
    if cmd == "version" or cmd == "--version"
        print("NOVA v0.1.0 (self-hosted, IR pipeline)")
        exit(0)
    if cmd == "self-test"
        run_self_test()
        exit(0)
    if cmd == "init"
        nova_pkg_init()
        exit(0)
    if cmd == "get"
        if len(arguments) < 3
            print("Usage: nova get <package>[@version]")
            exit(1)
        nova_pkg_get(arguments[2])
        exit(0)
    if cmd == "install"
        nova_pkg_install()
        exit(0)
    // Parse: nova run/build/compile [--old] [-O0] [-o out] <file>
    if cmd == "run" or cmd == "build" or cmd == "compile"
        let use_ir = 1
        let opt_level = "-O2"
        let output_file = ""
        let input_file = ""
        let i = 2
        while i < len(arguments)
            let a = arguments[i]
            if a == "--old"
                use_ir = 0
            else if a == "-O0"
                opt_level = "-O0"
            else if a == "-o"
                i = i + 1
                if i < len(arguments)
                    output_file = arguments[i]
            else
                input_file = a
            i = i + 1
        if input_file == ""
            print("error: no input file")
            exit(1)
        if cmd == "compile"
            let ll = if output_file != ""
                output_file
            else
                nova_replace_ext(input_file, ".nova", ".ll")
            nova_compile_file(input_file, ll, use_ir)
            print("Compiled: " + input_file + " -> " + ll)
        else if cmd == "build"
            let ll = nova_replace_ext(input_file, ".nova", ".ll")
            let exe = if output_file != ""
                output_file
            else
                nova_replace_ext(input_file, ".nova", ".exe")
            nova_compile_file(input_file, ll, use_ir)
            let ret = nova_link(ll, exe, opt_level)
            if ret == 0
                print("Built: " + exe)
            else
                print("error: linking failed (exit " + str(ret) + ")")
                exit(1)
        else if cmd == "run"
            let ll = nova_replace_ext(input_file, ".nova", ".ll")
            let exe = nova_replace_ext(input_file, ".nova", ".exe")
            nova_compile_file(input_file, ll, use_ir)
            let ret = nova_link(ll, exe, opt_level)
            if ret != 0
                print("error: linking failed (exit " + str(ret) + ")")
                exit(1)
            let run_ret = system("\".\\" + exe + "\"")
            exit(run_ret)
        exit(0)
    // Legacy mode: nova <file.nova> [output.ll]
    let use_ir = 1
    let file_idx = 1
    if arguments[1] == "--old"
        use_ir = 0
        file_idx = 2
    else if arguments[1] == "--ir"
        file_idx = 2
    if file_idx >= len(arguments)
        print("error: no input file")
        exit(1)
    let input_path = arguments[file_idx]
    let output_path = if file_idx + 1 < len(arguments)
        arguments[file_idx + 1]
    else
        nova_replace_ext(input_path, ".nova", ".ll")
    nova_compile_file(input_path, output_path, use_ir)
    if use_ir == 1
        print("Compiled (IR): " + input_path + " -> " + output_path)
    else
        print("Compiled: " + input_path + " -> " + output_path)

// ── Self-Test ────────────────────────────────────────────────────────────────

fn run_self_test()
    let tokens = tokenize("let x = 42 + 3")
    let non_nl = []
    for t in tokens
        match t
            Token(kind, value, line, col) =>
                if kind != "NEWLINE" and kind != "EOF"
                    push(non_nl, t)
    assert(len(non_nl) == 6, "lexer: expected 6 tokens, got " + str(len(non_nl)))
    match non_nl[0]
        Token(k, v, l, c) => assert(k == "KW" and v == "let", "lexer: t0 " + k + ":" + v)
    match non_nl[1]
        Token(k, v, l, c) => assert(k == "IDENT" and v == "x", "lexer: t1 " + k + ":" + v)
    match non_nl[2]
        Token(k, v, l, c) => assert(k == "ASSIGN" and v == "=", "lexer: t2 " + k + ":" + v)
    match non_nl[3]
        Token(k, v, l, c) => assert(k == "INT" and v == "42", "lexer: t3 " + k + ":" + v)
    match non_nl[4]
        Token(k, v, l, c) => assert(k == "OP" and v == "+", "lexer: t4 " + k + ":" + v)
    match non_nl[5]
        Token(k, v, l, c) => assert(k == "INT" and v == "3", "lexer: t5 " + k + ":" + v)

    let tokens2 = tokenize("x = 10\ny = x + 5\nprint(y)")
    let stmts = parse_program(tokens2)
    assert(len(stmts) == 3, "parser: expected 3 stmts, got " + str(len(stmts)))

    let source = "x = 42\nprint(x)"
    let result = compile(source)
    assert(contains(result, "define i64 @nova_main"), "codegen: has nova_main")
    assert(contains(result, "nova_rt_print_any"), "codegen: has print call")

    // Test function compilation
    let fn_source = "fn add(a, b)\n    return a + b\nresult = add(3, 4)\nprint(result)"
    let fn_result = compile(fn_source)
    assert(contains(fn_result, "define i64 @add"), "codegen: has user function")

    // Test string literal compilation (full pipeline)
    let str_source = "x = \"hello\"\nprint(x)"
    let str_result = compile(str_source)
    assert(contains(str_result, "@.str."), "codegen: has string constant")
    assert(contains(str_result, "nova_rt_print_any"), "codegen: string print call")

    print("NOVA Self-Hosting Compiler: ALL TESTS PASSED")

compiler_main()
