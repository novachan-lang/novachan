// ══════════════════════════════════════════════════════════════════════════════
// NOVA Self-Hosting Compiler — Phase 7
// Compiles NOVA source → LLVM IR text → native binary (via clang)
//
// Architecture: Source → Lexer → Parser → LLVM Codegen → .ll file
// All values are i64 (matching the Kotlin compiler's convention).
// Links against nova_runtime.c for string/list/dict/IO operations.
// ══════════════════════════════════════════════════════════════════════════════

// ── Data Types ───────────────────────────────────────────────────────────────

type Token
    kind: string
    value: string
    line: int
    col: int

type Expr
    tag: string
    value: string
    num: int
    children: list
    fields: list
    eline: int

type Stmt
    tag: string
    name: string
    expr: Expr
    body: list
    params: list
    else_body: list
    annotations: list
    sline: int

type Param
    name: string
    type_ann: string
    default_val: Expr

type ParseResult
    expr: Expr
    pos: int

type StmtParseResult
    stmt: Stmt
    pos: int

// ── IR Types ─────────────────────────────────────────────────────────────────

type IrType
    kind: string
    name: string
    params: list
    id: int

type IrInst
    op: string
    dest: string
    type: IrType
    args: list
    value: string
    num: int
    effect: string

type IrBlock
    label: string
    insts: list
    terminator: IrInst

type IrParam
    name: string
    type: IrType

type IrFunction
    name: string
    params: list
    ret_type: IrType
    blocks: list
    type_params: list
    is_extern: int

type IrModule
    functions: list
    structs: list
    globals: list
    string_constants: list

// ── Lexer ────────────────────────────────────────────────────────────────────

fn is_alpha(ch: string) -> bool
    let c = ord(ch)
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or ch == "_"

fn is_digit(ch: string) -> bool
    let c = ord(ch)
    c >= 48 and c <= 57

fn is_alnum(ch: string) -> bool
    is_alpha(ch) or is_digit(ch)

fn is_ws(ch: string) -> bool
    ch == " " or ch == "\t" or ch == "\r"

fn is_keyword(word: string) -> bool
    (word == "fn" or word == "return" or word == "if" or word == "else" or word == "for" or word == "while" or word == "match" or word == "break" or word == "continue" or word == "type" or word == "enum" or word == "spawn" or word == "send" or word == "receive" or word == "channel" or word == "or" or word == "and" or word == "not" or word == "copy" or word == "import" or word == "true" or word == "false" or word == "null" or word == "in" or word == "as" or word == "select" or word == "try" or word == "catch" or word == "trait" or word == "matches" or word == "yield" or word == "let")

fn tokenize(source: string) -> list
    let tokens = []
    let pos = 0
    let line = 1
    let col = 1
    let length = len(source)

    while pos < length
        let ch = source[pos]

        if ch == "\n"
            push(tokens, Token("NEWLINE", "\\n", line, col))
            line = line + 1
            col = 1
            pos = pos + 1
        else if is_ws(ch)
            while pos < length and is_ws(source[pos])
                pos = pos + 1
                col = col + 1
        else if ch == "/" and pos + 1 < length and source[pos + 1] == "/"
            while pos < length and source[pos] != "\n"
                pos = pos + 1
                col = col + 1
        else if ch == "@"
            push(tokens, Token("AT", "@", line, col))
            pos = pos + 1
            col = col + 1
        else if is_alpha(ch)
            let start_col = col
            let word = ""
            while pos < length and is_alnum(source[pos])
                word = word + source[pos]
                pos = pos + 1
                col = col + 1
            if word == "f" and pos < length and source[pos] == "\""
                pos = pos + 1
                col = col + 1
                let fstr = ""
                let has_interp = false
                while pos < length and source[pos] != "\""
                    if source[pos] == "\\" and pos + 1 < length
                        let esc = source[pos + 1]
                        if esc == "\{"
                            fstr = fstr + "\{"
                            pos = pos + 2
                            col = col + 2
                        else if esc == "\}"
                            fstr = fstr + "\}"
                            pos = pos + 2
                            col = col + 2
                        else if esc == "n"
                            fstr = fstr + "\n"
                            pos = pos + 2
                            col = col + 2
                        else if esc == "t"
                            fstr = fstr + "\t"
                            pos = pos + 2
                            col = col + 2
                        else if esc == "r"
                            fstr = fstr + "\r"
                            pos = pos + 2
                            col = col + 2
                        else if esc == "\\"
                            fstr = fstr + "\\"
                            pos = pos + 2
                            col = col + 2
                        else if esc == "\""
                            fstr = fstr + "\""
                            pos = pos + 2
                            col = col + 2
                        else
                            fstr = fstr + source[pos]
                            pos = pos + 1
                            col = col + 1
                    else if source[pos] == "\{"
                        if not has_interp
                            push(tokens, Token("INTERP_START", fstr, line, start_col))
                        else
                            push(tokens, Token("INTERP_MID", fstr, line, col))
                        fstr = ""
                        has_interp = true
                        pos = pos + 1
                        col = col + 1
                        let depth = 1
                        let interp_src = ""
                        while pos < length and depth > 0
                            if source[pos] == "\{"
                                depth = depth + 1
                                interp_src = interp_src + source[pos]
                            else if source[pos] == "\}"
                                depth = depth - 1
                                if depth > 0
                                    interp_src = interp_src + source[pos]
                            else if source[pos] == "\\" and pos + 1 < length and source[pos + 1] == "\""
                                interp_src = interp_src + "\""
                                pos = pos + 1
                                col = col + 1
                            else
                                interp_src = interp_src + source[pos]
                            if depth > 0
                                pos = pos + 1
                                col = col + 1
                        pos = pos + 1
                        col = col + 1
                        let inner_tokens = tokenize(interp_src)
                        for itk in inner_tokens
                            match itk
                                Token(ik, iv, il, ic) =>
                                    if ik != "EOF"
                                        push(tokens, Token(ik, iv, line, ic))
                    else
                        fstr = fstr + source[pos]
                        pos = pos + 1
                        col = col + 1
                if pos < length
                    pos = pos + 1
                    col = col + 1
                if has_interp
                    push(tokens, Token("INTERP_END", fstr, line, col))
                else
                    push(tokens, Token("STR", fstr, line, start_col))
            else if is_keyword(word)
                push(tokens, Token("KW", word, line, start_col))
            else
                push(tokens, Token("IDENT", word, line, start_col))
        else if is_digit(ch)
            let start_col = col
            let num = ""
            let is_float = false
            while pos < length and (is_digit(source[pos]) or source[pos] == "." or source[pos] == "_" or source[pos] == "e" or source[pos] == "E")
                if source[pos] == "." or source[pos] == "e" or source[pos] == "E"
                    is_float = true
                if source[pos] != "_"
                    num = num + source[pos]
                pos = pos + 1
                col = col + 1
            if is_float
                push(tokens, Token("FLOAT", num, line, start_col))
            else
                push(tokens, Token("INT", num, line, start_col))
        else if ch == "\""
            let start_col = col
            pos = pos + 1
            col = col + 1
            let fstr = ""
            let has_interp = false
            while pos < length and source[pos] != "\""
                if source[pos] == "\\" and pos + 1 < length
                    let esc = source[pos + 1]
                    if esc == "\{"
                        fstr = fstr + "\{"
                        pos = pos + 2
                        col = col + 2
                    else if esc == "\}"
                        fstr = fstr + "\}"
                        pos = pos + 2
                        col = col + 2
                    else if esc == "n"
                        fstr = fstr + "\n"
                        pos = pos + 2
                        col = col + 2
                    else if esc == "t"
                        fstr = fstr + "\t"
                        pos = pos + 2
                        col = col + 2
                    else if esc == "r"
                        fstr = fstr + "\r"
                        pos = pos + 2
                        col = col + 2
                    else if esc == "\\"
                        fstr = fstr + "\\"
                        pos = pos + 2
                        col = col + 2
                    else if esc == "\""
                        fstr = fstr + "\""
                        pos = pos + 2
                        col = col + 2
                    else if esc == "0"
                        fstr = fstr + "\0"
                        pos = pos + 2
                        col = col + 2
                    else
                        fstr = fstr + source[pos]
                        pos = pos + 1
                        col = col + 1
                else if source[pos] == "\{"
                    if not has_interp
                        push(tokens, Token("INTERP_START", fstr, line, start_col))
                    else
                        push(tokens, Token("INTERP_MID", fstr, line, col))
                    fstr = ""
                    has_interp = true
                    pos = pos + 1
                    col = col + 1
                    let depth = 1
                    let interp_src = ""
                    while pos < length and depth > 0
                        if source[pos] == "\{"
                            depth = depth + 1
                            interp_src = interp_src + source[pos]
                        else if source[pos] == "\}"
                            depth = depth - 1
                            if depth > 0
                                interp_src = interp_src + source[pos]
                        else if source[pos] == "\\" and pos + 1 < length and source[pos + 1] == "\""
                            interp_src = interp_src + "\""
                            pos = pos + 1
                            col = col + 1
                        else
                            interp_src = interp_src + source[pos]
                        if depth > 0
                            pos = pos + 1
                            col = col + 1
                    pos = pos + 1
                    col = col + 1
                    let inner_tokens = tokenize(interp_src)
                    for itk in inner_tokens
                        match itk
                            Token(ik, iv, il, ic) =>
                                if ik != "EOF"
                                    push(tokens, Token(ik, iv, line, ic))
                else
                    fstr = fstr + source[pos]
                    pos = pos + 1
                    col = col + 1
            if pos < length
                pos = pos + 1
                col = col + 1
            if has_interp
                push(tokens, Token("INTERP_END", fstr, line, col))
            else
                push(tokens, Token("STR", fstr, line, start_col))
        else if ch == "`"
            let start_col = col
            pos = pos + 1
            col = col + 1
            let raw = ""
            while pos < length and source[pos] != "`"
                raw = raw + source[pos]
                pos = pos + 1
                col = col + 1
            if pos < length
                pos = pos + 1
                col = col + 1
            push(tokens, Token("RAW_STR", raw, line, start_col))
        else if ch == "(" or ch == ")" or ch == "[" or ch == "]" or ch == "\{" or ch == "\}"
            push(tokens, Token("DELIM", ch, line, col))
            pos = pos + 1
            col = col + 1
        else if ch == ","
            push(tokens, Token("COMMA", ",", line, col))
            pos = pos + 1
            col = col + 1
        else if ch == ":"
            push(tokens, Token("COLON", ":", line, col))
            pos = pos + 1
            col = col + 1
        else if ch == "."
            if pos + 1 < length and source[pos + 1] == "."
                push(tokens, Token("DOTDOT", "..", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("DOT", ".", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == "+"
            if pos + 1 < length and source[pos + 1] == "="
                push(tokens, Token("OP", "+=", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("OP", "+", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == "-"
            if pos + 1 < length and source[pos + 1] == ">"
                push(tokens, Token("ARROW", "->", line, col))
                pos = pos + 2
                col = col + 2
            else if pos + 1 < length and source[pos + 1] == "="
                push(tokens, Token("OP", "-=", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("OP", "-", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == "*"
            if pos + 1 < length and source[pos + 1] == "*"
                push(tokens, Token("OP", "**", line, col))
                pos = pos + 2
                col = col + 2
            else if pos + 1 < length and source[pos + 1] == "="
                push(tokens, Token("OP", "*=", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("OP", "*", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == "/"
            if pos + 1 < length and source[pos + 1] == "="
                push(tokens, Token("OP", "/=", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("OP", "/", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == "%"
            if pos + 1 < length and source[pos + 1] == "="
                push(tokens, Token("OP", "%=", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("OP", "%", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == "="
            if pos + 1 < length and source[pos + 1] == "="
                push(tokens, Token("OP", "==", line, col))
                pos = pos + 2
                col = col + 2
            else if pos + 1 < length and source[pos + 1] == ">"
                push(tokens, Token("FAT_ARROW", "=>", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("ASSIGN", "=", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == "!"
            if pos + 1 < length and source[pos + 1] == "="
                push(tokens, Token("OP", "!=", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("OP", "!", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == "<"
            if pos + 1 < length and source[pos + 1] == "="
                push(tokens, Token("OP", "<=", line, col))
                pos = pos + 2
                col = col + 2
            else if pos + 1 < length and source[pos + 1] == "<"
                push(tokens, Token("OP", "<<", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("OP", "<", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == ">"
            if pos + 1 < length and source[pos + 1] == "="
                push(tokens, Token("OP", ">=", line, col))
                pos = pos + 2
                col = col + 2
            else if pos + 1 < length and source[pos + 1] == ">"
                push(tokens, Token("OP", ">>", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("OP", ">", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == "&"
            push(tokens, Token("OP", "&", line, col))
            pos = pos + 1
            col = col + 1
        else if ch == "|"
            if pos + 1 < length and source[pos + 1] == ">"
                push(tokens, Token("PIPE_GT", "|>", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("OP", "|", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == "^"
            push(tokens, Token("OP", "^", line, col))
            pos = pos + 1
            col = col + 1
        else if ch == "~"
            push(tokens, Token("OP", "~", line, col))
            pos = pos + 1
            col = col + 1
        else if ch == "?"
            push(tokens, Token("QUESTION", "?", line, col))
            pos = pos + 1
            col = col + 1
        else
            pos = pos + 1
            col = col + 1

    push(tokens, Token("EOF", "", line, col))
    tokens

// ── Parser Utilities ─────────────────────────────────────────────────────────

fn tok_at(tokens: list, pos: int) -> Token
    tokens[pos]

fn tk(tokens: list, pos: int) -> string
    match tokens[pos]
        Token(kind, value, line, col) => kind

fn tv(tokens: list, pos: int) -> string
    match tokens[pos]
        Token(kind, value, line, col) => value

fn tl(tokens: list, pos: int) -> int
    match tokens[pos]
        Token(kind, value, line, col) => line

fn skip_nl(tokens: list, pos: int) -> int
    while tk(tokens, pos) == "NEWLINE"
        pos = pos + 1
    pos

fn tok_line(tokens: list, pos: int) -> int
    match tokens[pos]
        Token(kind, value, line, col) => line

fn tok_col(tokens: list, pos: int) -> int
    match tokens[pos]
        Token(kind, value, line, col) => col

fn expect(tokens: list, pos: int, expected_val: string) -> int
    assert(tv(tokens, pos) == expected_val, "expected '" + expected_val + "' got '" + tv(tokens, pos) + "' at line " + str(tok_line(tokens, pos)))
    pos + 1

// ── Operator Precedence (Pratt Parser) ───────────────────────────────────────

fn prefix_bp(op: string) -> int
    if op == "-" or op == "not" or op == "~"
        27
    else
        0

fn infix_bp(op: string) -> list
    if op == "catch"
        [2, 3]
    else if op == "or"
        [3, 4]
    else if op == "and"
        [5, 6]
    else if op == "|"
        [7, 8]
    else if op == "^"
        [9, 10]
    else if op == "&"
        [11, 12]
    else if op == "==" or op == "!=" or op == "matches"
        [13, 14]
    else if op == "<" or op == ">" or op == "<=" or op == ">=" or op == "in"
        [15, 16]
    else if op == "<<" or op == ">>"
        [17, 18]
    else if op == "+" or op == "-"
        [19, 20]
    else if op == "*" or op == "/" or op == "%"
        [21, 22]
    else if op == "**"
        [24, 23]
    else
        [0, 0]

fn is_infix_op(tokens: list, pos: int) -> bool
    let kind = tk(tokens, pos)
    let val = tv(tokens, pos)
    if kind == "OP"
        let bp = infix_bp(val)
        bp[0] > 0
    else if kind == "KW" and (val == "and" or val == "or" or val == "in" or val == "matches" or val == "catch")
        true
    else
        false

fn get_infix_op(tokens: list, pos: int) -> string
    tv(tokens, pos)

// ── Expression Parser ────────────────────────────────────────────────────────

fn null_expr() -> Expr
    Expr("null", "", 0, [], [], 0)

fn parse_expr(tokens: list, pos: int, min_bp: int) -> ParseResult
    let ln = tl(tokens, pos)
    let left_r = parse_prefix(tokens, pos)
    let left = left_r.expr
    let cur = left_r.pos

    while cur < len(tokens) and tk(tokens, cur) != "EOF" and tk(tokens, cur) != "NEWLINE"
        // Check for postfix operations: function call, index, member access
        if tk(tokens, cur) == "DELIM" and tv(tokens, cur) == "("
            let call_r = parse_call_args(tokens, cur, left)
            left = call_r.expr
            cur = call_r.pos
        else if tk(tokens, cur) == "DELIM" and tv(tokens, cur) == "["
            let idx_r = parse_index(tokens, cur, left)
            left = idx_r.expr
            cur = idx_r.pos
        else if tk(tokens, cur) == "DOT"
            cur = cur + 1
            let member_name = tv(tokens, cur)
            cur = cur + 1
            // Check for method call: obj.method(args)
            if cur < len(tokens) and tk(tokens, cur) == "DELIM" and tv(tokens, cur) == "("
                let method_r = parse_call_args(tokens, cur, Expr("member", member_name, 0, [left], [], ln))
                left = method_r.expr
                cur = method_r.pos
            else
                left = Expr("member", member_name, 0, [left], [], ln)
        else if tk(tokens, cur) == "FAT_ARROW" and min_bp <= 1
            // Lambda: left => body (lowest precedence)
            cur = cur + 1
            let body_r = parse_expr(tokens, cur, 0)
            match left
                Expr(ltag, lval, lnum, lchildren, lfields, lln) =>
                    if ltag == "ident"
                        left = Expr("lambda", "", 0, [body_r.expr], [left], ln)
                    else if ltag == "tuple"
                        left = Expr("lambda", "", 0, [body_r.expr], lchildren, ln)
                    else
                        left = Expr("lambda", "", 0, [body_r.expr], [left], ln)
            cur = body_r.pos
        else if is_infix_op(tokens, cur)
            let op = get_infix_op(tokens, cur)
            let bp = infix_bp(op)
            let lbp = bp[0]
            let rbp = bp[1]
            if lbp < min_bp
                break
            cur = cur + 1
            if op == "catch"
                let err_var = tv(tokens, cur)
                cur = cur + 1
                let pre_nl = cur
                cur = skip_nl(tokens, cur)
                if pre_nl != cur and tk(tokens, cur) != "EOF"
                    let body_col = tok_col(tokens, cur)
                    let body_stmts = []
                    while tk(tokens, cur) != "EOF" and tok_col(tokens, cur) >= body_col
                        let sr = parse_stmt(tokens, cur)
                        push(body_stmts, sr.stmt)
                        cur = skip_nl(tokens, sr.pos)
                    if len(body_stmts) > 1
                        left = Expr("catch", err_var, len(body_stmts), [left], body_stmts, ln)
                    else if len(body_stmts) == 1
                        match body_stmts[0]
                            Stmt(stag, sname, sexpr, sbody, sparams, selse, sanns, ssln) =>
                                left = Expr("catch", err_var, 0, [left, sexpr], [], ln)
                    else
                        left = Expr("catch", err_var, 0, [left, null_expr()], [], ln)
                else
                    let handler_r = parse_expr(tokens, cur, 0)
                    left = Expr("catch", err_var, 0, [left, handler_r.expr], [], ln)
                    cur = handler_r.pos
            else
                let right_r = parse_expr(tokens, cur, rbp)
                left = Expr("binop", op, 0, [left, right_r.expr], [], ln)
                cur = right_r.pos
        else
            break

    ParseResult(left, cur)

fn parse_prefix(tokens: list, pos: int) -> ParseResult
    let ln = tl(tokens, pos)
    let kind = tk(tokens, pos)
    let val = tv(tokens, pos)

    if kind == "INT"
        ParseResult(Expr("int", val, int(val), [], [], ln), pos + 1)
    else if kind == "FLOAT"
        ParseResult(Expr("float", val, 0, [], [], ln), pos + 1)
    else if kind == "STR"
        ParseResult(Expr("str", val, 0, [], [], ln), pos + 1)
    else if kind == "RAW_STR"
        ParseResult(Expr("str", val, 0, [], [], ln), pos + 1)
    else if kind == "KW" and val == "true"
        ParseResult(Expr("bool", "true", 1, [], [], ln), pos + 1)
    else if kind == "KW" and val == "false"
        ParseResult(Expr("bool", "false", 0, [], [], ln), pos + 1)
    else if kind == "KW" and val == "null"
        ParseResult(Expr("null", "", 0, [], [], ln), pos + 1)
    else if kind == "IDENT"
        ParseResult(Expr("ident", val, 0, [], [], ln), pos + 1)
    else if kind == "OP" and val == "-"
        let rbp = prefix_bp("-")
        let operand_r = parse_expr(tokens, pos + 1, rbp)
        ParseResult(Expr("unary", "-", 0, [operand_r.expr], [], ln), operand_r.pos)
    else if kind == "KW" and val == "not"
        let rbp = prefix_bp("not")
        let operand_r = parse_expr(tokens, pos + 1, rbp)
        ParseResult(Expr("unary", "not", 0, [operand_r.expr], [], ln), operand_r.pos)
    else if kind == "OP" and val == "~"
        let rbp = prefix_bp("~")
        let operand_r = parse_expr(tokens, pos + 1, rbp)
        ParseResult(Expr("unary", "~", 0, [operand_r.expr], [], ln), operand_r.pos)
    else if kind == "DELIM" and val == "("
        // Grouped expression or tuple
        let inner_r = parse_expr(tokens, pos + 1, 0)
        if tk(tokens, inner_r.pos) == "COMMA"
            // Tuple literal
            let elements = [inner_r.expr]
            let p = inner_r.pos
            while tv(tokens, p) == ","
                p = p + 1
                let elem_r = parse_expr(tokens, p, 0)
                push(elements, elem_r.expr)
                p = elem_r.pos
            p = expect(tokens, p, ")")
            ParseResult(Expr("tuple", "", 0, elements, [], ln), p)
        else
            let p2 = expect(tokens, inner_r.pos, ")")
            ParseResult(inner_r.expr, p2)
    else if kind == "DELIM" and val == "["
        // List literal
        let elements = []
        let p = pos + 1
        while tv(tokens, p) != "]"
            if len(elements) > 0
                p = expect(tokens, p, ",")
            let elem_r = parse_expr(tokens, p, 0)
            push(elements, elem_r.expr)
            p = elem_r.pos
        p = expect(tokens, p, "]")
        ParseResult(Expr("list", "", 0, elements, [], ln), p)
    else if kind == "DELIM" and val == "\{"
        // Dict literal
        let entries = []
        let p = pos + 1
        while tv(tokens, p) != "\}"
            if len(entries) > 0
                p = expect(tokens, p, ",")
                if tv(tokens, p) == "\}"
                    break
            let key_r = parse_expr(tokens, p, 0)
            p = expect(tokens, key_r.pos, ":")
            let val_r = parse_expr(tokens, p, 0)
            push(entries, Expr("pair", "", 0, [key_r.expr, val_r.expr], [], ln))
            p = val_r.pos
        p = expect(tokens, p, "\}")
        ParseResult(Expr("dict", "", 0, entries, [], ln), p)
    else if kind == "INTERP_START"
        let parts = []
        push(parts, Expr("str", val, 0, [], [], ln))
        let p = pos + 1
        let interp_expr_r = parse_expr(tokens, p, 0)
        push(parts, interp_expr_r.expr)
        p = interp_expr_r.pos
        while p < len(tokens) and tk(tokens, p) == "INTERP_MID"
            push(parts, Expr("str", tv(tokens, p), 0, [], [], ln))
            p = p + 1
            let next_r = parse_expr(tokens, p, 0)
            push(parts, next_r.expr)
            p = next_r.pos
        if p < len(tokens) and tk(tokens, p) == "INTERP_END"
            push(parts, Expr("str", tv(tokens, p), 0, [], [], ln))
            p = p + 1
        ParseResult(Expr("str_interp", "", 0, parts, [], ln), p)
    else if kind == "KW" and val == "try"
        let inner_r = parse_expr(tokens, pos + 1, 5)
        ParseResult(Expr("try", "", 0, [inner_r.expr], [], ln), inner_r.pos)
    else if kind == "KW" and val == "if"
        parse_if_expr(tokens, pos)
    else if kind == "KW" and val == "match"
        parse_match_expr(tokens, pos)
    else if kind == "KW" and val == "for"
        parse_for_expr(tokens, pos)
    else
        assert(false, "unexpected token in expression: " + kind + "(" + val + ") at line " + str(tok_line(tokens, pos)))
        ParseResult(null_expr(), pos)

fn parse_call_args(tokens: list, pos: int, callee: Expr) -> ParseResult
    let ln = tl(tokens, pos)
    let p = pos + 1
    let cargs = []
    while tv(tokens, p) != ")"
        if len(cargs) > 0
            p = expect(tokens, p, ",")
        let arg_r = parse_expr(tokens, p, 0)
        push(cargs, arg_r.expr)
        p = arg_r.pos
    p = expect(tokens, p, ")")
    // Determine call name from callee
    match callee
        Expr(tag, value, num, children, fields, eline) =>
            if tag == "ident"
                ParseResult(Expr("call", value, 0, cargs, [], ln), p)
            else if tag == "member"
                // Method call: children[0] is receiver
                let all_args = [children[0]]
                for a in cargs
                    push(all_args, a)
                ParseResult(Expr("method_call", value, 0, all_args, [], ln), p)
            else
                ParseResult(Expr("dyn_call", "", 0, [callee] + cargs, [], ln), p)

fn parse_index(tokens: list, pos: int, target: Expr) -> ParseResult
    let ln = tl(tokens, pos)
    let p = pos + 1
    let idx_r = parse_expr(tokens, p, 0)
    p = expect(tokens, idx_r.pos, "]")
    ParseResult(Expr("index", "", 0, [target, idx_r.expr], [], ln), p)

fn parse_if_expr(tokens: list, pos: int) -> ParseResult
    let ln = tl(tokens, pos)
    let p = pos + 1
    let cond_r = parse_expr(tokens, p, 0)
    let p2 = skip_nl(tokens, cond_r.pos)
    let then_r = parse_expr(tokens, p2, 0)
    let p3 = skip_nl(tokens, then_r.pos)
    if tk(tokens, p3) == "KW" and tv(tokens, p3) == "else"
        let p4 = skip_nl(tokens, p3 + 1)
        let else_r = parse_expr(tokens, p4, 0)
        ParseResult(Expr("if", "", 0, [cond_r.expr, then_r.expr, else_r.expr], [], ln), else_r.pos)
    else
        ParseResult(Expr("if", "", 0, [cond_r.expr, then_r.expr], [], ln), p3)

fn parse_match_expr(tokens: list, pos: int) -> ParseResult
    let ln = tl(tokens, pos)
    let p = pos + 1
    let subject_r = parse_expr(tokens, p, 0)
    let p2 = skip_nl(tokens, subject_r.pos)
    let arms = []
    while tk(tokens, p2) != "EOF" and tk(tokens, p2) != "NEWLINE"
        // Parse pattern => body
        let pat_r = parse_pattern(tokens, p2)
        p2 = skip_nl(tokens, pat_r.pos)
        p2 = expect(tokens, p2, "=>")
        p2 = skip_nl(tokens, p2)
        let body_r = parse_expr(tokens, p2, 0)
        push(arms, Expr("arm", "", 0, [pat_r.expr, body_r.expr], [], ln))
        p2 = skip_nl(tokens, body_r.pos)
    ParseResult(Expr("match", "", 0, [subject_r.expr] + arms, [], ln), p2)

fn parse_pattern(tokens: list, pos: int) -> ParseResult
    let ln = tl(tokens, pos)
    let kind = tk(tokens, pos)
    let val = tv(tokens, pos)
    if kind == "IDENT"
        if pos + 1 < len(tokens) and tv(tokens, pos + 1) == "("
            // Constructor pattern: Name(field1, field2, ...)
            let name = val
            let p = pos + 2
            let fields = []
            while tv(tokens, p) != ")"
                if len(fields) > 0
                    p = expect(tokens, p, ",")
                push(fields, Expr("pat_var", tv(tokens, p), 0, [], [], ln))
                p = p + 1
            p = expect(tokens, p, ")")
            ParseResult(Expr("pat_ctor", name, 0, fields, [], ln), p)
        else if val == "_"
            ParseResult(Expr("pat_wild", "_", 0, [], [], ln), pos + 1)
        else
            ParseResult(Expr("pat_var", val, 0, [], [], ln), pos + 1)
    else if kind == "INT"
        ParseResult(Expr("pat_lit", val, int(val), [], [], ln), pos + 1)
    else if kind == "STR"
        ParseResult(Expr("pat_str", val, 0, [], [], ln), pos + 1)
    else
        ParseResult(Expr("pat_wild", "_", 0, [], [], ln), pos)

fn parse_for_expr(tokens: list, pos: int) -> ParseResult
    let ln = tl(tokens, pos)
    let p = pos + 1
    let var_name = tv(tokens, p)
    p = p + 1
    p = skip_nl(tokens, p)
    if tk(tokens, p) == "KW" and tv(tokens, p) == "in"
        p = p + 1
    let iter_r = parse_expr(tokens, p, 0)
    let p2 = skip_nl(tokens, iter_r.pos)
    let body_r = parse_expr(tokens, p2, 0)
    ParseResult(Expr("for", var_name, 0, [iter_r.expr, body_r.expr], [], ln), body_r.pos)

// ── Statement Parser ─────────────────────────────────────────────────────────

fn parse_block(tokens: list, pos: int) -> StmtParseResult
    let ln = tl(tokens, pos)
    let stmts = []
    let p = skip_nl(tokens, pos)
    while tk(tokens, p) != "EOF" and tk(tokens, p) != "KW"
        let sr = parse_stmt(tokens, p)
        push(stmts, sr.stmt)
        p = skip_nl(tokens, sr.pos)
        // Heuristic: stop block at dedent (no explicit INDENT/DEDENT in this tokenizer)
        // For now: parse one statement per block-line
        break
    StmtParseResult(Stmt("block", "", null_expr(), stmts, [], [], [], ln), p)

fn parse_stmt(tokens: list, pos: int) -> StmtParseResult
    let ln = tl(tokens, pos)
    let kind = tk(tokens, pos)
    let val = tv(tokens, pos)

    if kind == "AT"
        // Annotation: @name followed by statement
        let ann_name = tv(tokens, pos + 1)
        let p = skip_nl(tokens, pos + 2)
        let inner_r = parse_stmt(tokens, p)
        match inner_r.stmt
            Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
                let new_anns = [ann_name]
                for a in annotations
                    push(new_anns, a)
                StmtParseResult(Stmt(tag, name, expr, body, params, else_body, new_anns, sline), inner_r.pos)
    else if kind == "KW" and val == "fn"
        parse_fn_decl(tokens, pos)
    else if kind == "KW" and val == "type"
        parse_type_decl(tokens, pos)
    else if kind == "KW" and val == "if"
        parse_if_stmt(tokens, pos)
    else if kind == "KW" and val == "while"
        parse_while_stmt(tokens, pos)
    else if kind == "KW" and val == "for"
        parse_for_stmt(tokens, pos)
    else if kind == "KW" and val == "return"
        let p = pos + 1
        if tk(tokens, p) == "NEWLINE" or tk(tokens, p) == "EOF"
            StmtParseResult(Stmt("return", "", null_expr(), [], [], [], [], ln), p)
        else
            let expr_r = parse_expr(tokens, p, 0)
            StmtParseResult(Stmt("return", "", expr_r.expr, [], [], [], [], ln), expr_r.pos)
    else if kind == "KW" and val == "yield"
        let expr_r = parse_expr(tokens, pos + 1, 0)
        StmtParseResult(Stmt("yield", "", expr_r.expr, [], [], [], [], ln), expr_r.pos)
    else if kind == "KW" and val == "break"
        StmtParseResult(Stmt("break", "", null_expr(), [], [], [], [], ln), pos + 1)
    else if kind == "KW" and val == "continue"
        StmtParseResult(Stmt("continue", "", null_expr(), [], [], [], [], ln), pos + 1)
    else if kind == "KW" and val == "import"
        parse_import_stmt(tokens, pos)
    else if kind == "KW" and val == "match"
        parse_match_stmt(tokens, pos)
    else if kind == "KW" and val == "let"
        // let name = expr
        let name = tv(tokens, pos + 1)
        let p = pos + 2
        if tk(tokens, p) == "ASSIGN"
            p = p + 1
            let expr_r = parse_expr(tokens, p, 0)
            StmtParseResult(Stmt("assign", name, expr_r.expr, [], [], [], [], ln), expr_r.pos)
        else
            StmtParseResult(Stmt("assign", name, null_expr(), [], [], [], [], ln), p)
    else if kind == "IDENT"
        // Assignment or expression statement
        let expr_r = parse_expr(tokens, pos, 0)
        let p = expr_r.pos
        if tk(tokens, p) == "ASSIGN"
            p = p + 1
            let rhs_r = parse_expr(tokens, p, 0)
            StmtParseResult(Stmt("assign", "", rhs_r.expr, [], [], [], [expr_r.expr], ln), rhs_r.pos)
        else if tk(tokens, p) == "OP" and (tv(tokens, p) == "+=" or tv(tokens, p) == "-=" or tv(tokens, p) == "*=" or tv(tokens, p) == "/=")
            let op = tv(tokens, p)
            p = p + 1
            let rhs_r = parse_expr(tokens, p, 0)
            StmtParseResult(Stmt("compound_assign", op, rhs_r.expr, [], [], [], [expr_r.expr], ln), rhs_r.pos)
        else
            StmtParseResult(Stmt("expr", "", expr_r.expr, [], [], [], [], ln), p)
    else
        let expr_r = parse_expr(tokens, pos, 0)
        StmtParseResult(Stmt("expr", "", expr_r.expr, [], [], [], [], ln), expr_r.pos)

fn parse_fn_decl(tokens: list, pos: int) -> StmtParseResult
    let ln = tl(tokens, pos)
    let p = pos + 1
    let name = tv(tokens, p)
    p = p + 1
    p = expect(tokens, p, "(")
    let params = []
    while tv(tokens, p) != ")"
        if len(params) > 0
            p = expect(tokens, p, ",")
        let param_name = tv(tokens, p)
        p = p + 1
        let type_ann = ""
        let default_val = null_expr()
        if tk(tokens, p) == "COLON"
            p = p + 1
            type_ann = tv(tokens, p)
            p = p + 1
        if tk(tokens, p) == "ASSIGN"
            p = p + 1
            let def_r = parse_expr(tokens, p, 0)
            default_val = def_r.expr
            p = def_r.pos
        push(params, Param(param_name, type_ann, default_val))
    p = expect(tokens, p, ")")
    // Skip return type annotation
    if tk(tokens, p) == "ARROW"
        p = p + 1
        // Skip type name
        while tk(tokens, p) == "IDENT" or tk(tokens, p) == "DELIM"
            p = p + 1
    let fn_col = 1
    let fn_tok = tokens[pos]
    match fn_tok
        Token(fk, fv, fline, fcol) =>
            fn_col = fcol
    let p2 = skip_nl(tokens, p)
    let body = []
    while tk(tokens, p2) != "EOF"
        let cur_tok = tokens[p2]
        match cur_tok
            Token(k, v, line, col) =>
                if col <= fn_col
                    break
        let sr = parse_stmt(tokens, p2)
        push(body, sr.stmt)
        p2 = skip_nl(tokens, sr.pos)
    StmtParseResult(Stmt("fn", name, null_expr(), body, params, [], [], ln), p2)

fn parse_type_decl(tokens: list, pos: int) -> StmtParseResult
    let ln = tl(tokens, pos)
    let p = pos + 1
    let name = tv(tokens, p)
    p = p + 1
    let p2 = skip_nl(tokens, p)
    let fields = []
    // Parse fields until next top-level construct
    while tk(tokens, p2) != "EOF"
        let cur_tok = tokens[p2]
        match cur_tok
            Token(k, v, line, col) =>
                if col <= 1 and k != "IDENT"
                    break
                if col <= 1 and k == "IDENT"
                    // Check if it looks like a field (name: type)
                    if p2 + 1 < len(tokens) and tk(tokens, p2 + 1) == "COLON"
                        // It's a field
                        let fname = tv(tokens, p2)
                        p2 = p2 + 2
                        let ftype = tv(tokens, p2)
                        p2 = p2 + 1
                        push(fields, Param(fname, ftype, null_expr()))
                        p2 = skip_nl(tokens, p2)
                    else
                        break
                else if k == "IDENT"
                    let fname = tv(tokens, p2)
                    p2 = p2 + 1
                    if tk(tokens, p2) == "COLON"
                        p2 = p2 + 1
                        let ftype = tv(tokens, p2)
                        p2 = p2 + 1
                        push(fields, Param(fname, ftype, null_expr()))
                    p2 = skip_nl(tokens, p2)
                else
                    break
    StmtParseResult(Stmt("type", name, null_expr(), [], fields, [], [], ln), p2)

fn parse_if_chain(tokens: list, pos: int, base_col: int) -> StmtParseResult
    let ln = tl(tokens, pos)
    let p = pos + 1
    let cond_r = parse_expr(tokens, p, 0)
    let p2 = skip_nl(tokens, cond_r.pos)
    let then_body = []
    while tk(tokens, p2) != "EOF"
        if tok_col(tokens, p2) <= base_col
            break
        let sr = parse_stmt(tokens, p2)
        push(then_body, sr.stmt)
        p2 = skip_nl(tokens, sr.pos)
    let else_body = []
    if tk(tokens, p2) == "KW" and tv(tokens, p2) == "else" and tok_col(tokens, p2) == base_col
        p2 = p2 + 1
        p2 = skip_nl(tokens, p2)
        if tk(tokens, p2) == "KW" and tv(tokens, p2) == "if"
            let nested_r = parse_if_chain(tokens, p2, base_col)
            push(else_body, nested_r.stmt)
            p2 = nested_r.pos
        else
            while tk(tokens, p2) != "EOF"
                if tok_col(tokens, p2) <= base_col
                    break
                let sr = parse_stmt(tokens, p2)
                push(else_body, sr.stmt)
                p2 = skip_nl(tokens, sr.pos)
    StmtParseResult(Stmt("if", "", cond_r.expr, then_body, [], else_body, [], ln), p2)

fn parse_if_stmt(tokens: list, pos: int) -> StmtParseResult
    let ln = tl(tokens, pos)
    parse_if_chain(tokens, pos, tok_col(tokens, pos))

fn parse_while_stmt(tokens: list, pos: int) -> StmtParseResult
    let ln = tl(tokens, pos)
    let kw_col = tok_col(tokens, pos)
    let p = pos + 1
    let cond_r = parse_expr(tokens, p, 0)
    let p2 = skip_nl(tokens, cond_r.pos)
    let body = []
    while tk(tokens, p2) != "EOF"
        if tok_col(tokens, p2) <= kw_col
            break
        let sr = parse_stmt(tokens, p2)
        push(body, sr.stmt)
        p2 = skip_nl(tokens, sr.pos)
    StmtParseResult(Stmt("while", "", cond_r.expr, body, [], [], [], ln), p2)

fn parse_for_stmt(tokens: list, pos: int) -> StmtParseResult
    let ln = tl(tokens, pos)
    let kw_col = tok_col(tokens, pos)
    let p = pos + 1
    let var_name = tv(tokens, p)
    p = p + 1
    if tk(tokens, p) == "KW" and tv(tokens, p) == "in"
        p = p + 1
    let iter_r = parse_expr(tokens, p, 0)
    let p2 = skip_nl(tokens, iter_r.pos)
    let body = []
    while tk(tokens, p2) != "EOF"
        if tok_col(tokens, p2) <= kw_col
            break
        let sr = parse_stmt(tokens, p2)
        push(body, sr.stmt)
        p2 = skip_nl(tokens, sr.pos)
    StmtParseResult(Stmt("for", var_name, iter_r.expr, body, [], [], [], ln), p2)

fn parse_match_stmt(tokens: list, pos: int) -> StmtParseResult
    let ln = tl(tokens, pos)
    let kw_col = tok_col(tokens, pos)
    let p = pos + 1
    let subject_r = parse_expr(tokens, p, 0)
    let p2 = skip_nl(tokens, subject_r.pos)
    let arms = []
    while tk(tokens, p2) != "EOF"
        if tok_col(tokens, p2) <= kw_col
            break
        let pat_r = parse_pattern(tokens, p2)
        let arm_col = tok_col(tokens, p2)
        p2 = pat_r.pos
        if tk(tokens, p2) == "FAT_ARROW"
            p2 = p2 + 1
        p2 = skip_nl(tokens, p2)
        let arm_body = []
        while tk(tokens, p2) != "EOF"
            if tok_col(tokens, p2) <= arm_col
                break
            let sr = parse_stmt(tokens, p2)
            push(arm_body, sr.stmt)
            p2 = skip_nl(tokens, sr.pos)
        push(arms, Stmt("arm", "", pat_r.expr, arm_body, [], [], [], ln))
    StmtParseResult(Stmt("match", "", subject_r.expr, arms, [], [], [], ln), p2)

fn parse_import_stmt(tokens: list, pos: int) -> StmtParseResult
    let ln = tl(tokens, pos)
    let p = pos + 1
    let module_name = tv(tokens, p)
    p = p + 1
    let alias = module_name
    if tk(tokens, p) == "KW" and tv(tokens, p) == "as"
        p = p + 1
        alias = tv(tokens, p)
        p = p + 1
    StmtParseResult(Stmt("import", module_name, null_expr(), [], [], [], [alias], ln), p)

fn parse_program(tokens: list) -> list
    let stmts = []
    let pos = skip_nl(tokens, 0)
    while tk(tokens, pos) != "EOF"
        let sr = parse_stmt(tokens, pos)
        push(stmts, sr.stmt)
        pos = skip_nl(tokens, sr.pos)
    stmts

// ── LLVM IR Code Generator ───────────────────────────────────────────────────

type CodeGen
    output: list
    strings: list
    str_map: dict
    reg_count: int
    label_count: int
    fn_names: list
    current_slots: dict
    current_fn: string
    struct_defs: dict
    indent: string
    loop_hdr: string
    loop_exit: string
    field_map: dict

fn new_codegen() -> CodeGen
    CodeGen([], [], {}, 0, 0, [], {}, "", {}, "  ", "", "", {})

fn fresh_reg(cg: CodeGen) -> string
    let r = "%r" + str(cg.reg_count)
    cg.reg_count = cg.reg_count + 1
    r

fn fresh_tmp(cg: CodeGen) -> string
    let t = "%t" + str(cg.reg_count)
    cg.reg_count = cg.reg_count + 1
    t

fn fresh_label(cg: CodeGen, prefix: string) -> string
    let l = prefix + str(cg.label_count)
    cg.label_count = cg.label_count + 1
    l

fn intern_string(cg: CodeGen, s: string) -> int
    if contains(cg.str_map, s)
        return cg.str_map[s]
    let idx = len(cg.strings)
    push(cg.strings, s)
    cg.str_map[s] = idx
    idx

fn emit(cg: CodeGen, line: string)
    push(cg.output, line)

fn emit_indent(cg: CodeGen, line: string)
    push(cg.output, cg.indent + line)

// Get or create a stack slot for a variable
fn get_slot(cg: CodeGen, name: string) -> string
    let slots = cg.current_slots
    if contains(slots, name)
        return slots[name]
    let slot = "%slot." + name
    slots[name] = slot
    slot

// ── LLVM Codegen: Expressions ────────────────────────────────────────────────

fn codegen_expr(cg: CodeGen, expr: Expr) -> string
    match expr
        Expr(tag, value, num, children, fields, eline) =>
            if tag == "int"
                str(num)
            else if tag == "bool"
                str(num)
            else if tag == "null"
                "0"
            else if tag == "float"
                let bits = float_bits(value)
                str(bits)
            else if tag == "str"
                let idx = intern_string(cg, value)
                let r = fresh_reg(cg)
                let slen = len(value) + 1
                emit_indent(cg, r + " = getelementptr inbounds [" + str(slen) + " x i8], ptr @.str." + str(idx) + ", i64 0, i64 0")
                let r2 = fresh_reg(cg)
                emit_indent(cg, r2 + " = ptrtoint ptr " + r + " to i64")
                r2
            else if tag == "str_interp"
                let acc = ""
                let si = 0
                while si < len(children)
                    let part = children[si]
                    match part
                        Expr(ptag, pval, pnum, pch, pf, pln) =>
                            if ptag == "str"
                                let sidx = intern_string(cg, pval)
                                let sr = fresh_reg(cg)
                                let sl = len(pval) + 1
                                emit_indent(cg, sr + " = getelementptr inbounds [" + str(sl) + " x i8], ptr @.str." + str(sidx) + ", i64 0, i64 0")
                                let sr2 = fresh_reg(cg)
                                emit_indent(cg, sr2 + " = ptrtoint ptr " + sr + " to i64")
                                if acc == ""
                                    acc = sr2
                                else
                                    let cat = fresh_reg(cg)
                                    emit_indent(cg, cat + " = call i64 @nova_rt_str_concat(i64 " + acc + ", i64 " + sr2 + ")")
                                    acc = cat
                            else
                                let val_r = codegen_expr(cg, part)
                                let str_r = fresh_reg(cg)
                                emit_indent(cg, str_r + " = call i64 @nova_rt_any_to_str(i64 " + val_r + ")")
                                if acc == ""
                                    acc = str_r
                                else
                                    let cat = fresh_reg(cg)
                                    emit_indent(cg, cat + " = call i64 @nova_rt_str_concat(i64 " + acc + ", i64 " + str_r + ")")
                                    acc = cat
                    si = si + 1
                if acc == ""
                    let eidx = intern_string(cg, "")
                    let er = fresh_reg(cg)
                    emit_indent(cg, er + " = getelementptr inbounds [1 x i8], ptr @.str." + str(eidx) + ", i64 0, i64 0")
                    let er2 = fresh_reg(cg)
                    emit_indent(cg, er2 + " = ptrtoint ptr " + er + " to i64")
                    er2
                else
                    acc
            else if tag == "ident"
                let slot = get_slot(cg, value)
                let r = fresh_reg(cg)
                emit_indent(cg, r + " = load i64, ptr " + slot + ", align 8")
                r
            else if tag == "binop"
                codegen_binop(cg, value, children[0], children[1])
            else if tag == "unary"
                codegen_unary(cg, value, children[0])
            else if tag == "call"
                codegen_call(cg, value, children)
            else if tag == "method_call"
                codegen_method_call(cg, value, children)
            else if tag == "index"
                let target_r = codegen_expr(cg, children[0])
                let idx_r = codegen_expr(cg, children[1])
                let r = fresh_reg(cg)
                emit_indent(cg, r + " = call i64 @nova_rt_index_get(i64 " + target_r + ", i64 " + idx_r + ")")
                r
            else if tag == "member"
                let target_r = codegen_expr(cg, children[0])
                // Member access: field name is in 'value'
                // Lookup struct field index from struct_defs
                let field_idx = get_field_index(cg, value)
                let r = fresh_reg(cg)
                let ptr = fresh_tmp(cg)
                emit_indent(cg, ptr + " = inttoptr i64 " + target_r + " to ptr")
                let gep = fresh_tmp(cg)
                emit_indent(cg, gep + " = getelementptr i64, ptr " + ptr + ", i64 " + str(field_idx))
                emit_indent(cg, r + " = load i64, ptr " + gep + ", align 8")
                r
            else if tag == "list"
                let r = fresh_reg(cg)
                emit_indent(cg, r + " = call i64 @nova_rt_list_create()")
                for elem in children
                    let elem_r = codegen_expr(cg, elem)
                    let tmp = fresh_tmp(cg)
                    emit_indent(cg, tmp + " = call i64 @nova_rt_list_append(i64 " + r + ", i64 " + elem_r + ")")
                r
            else if tag == "dict"
                let r = fresh_reg(cg)
                emit_indent(cg, r + " = call i64 @nova_rt_dict_create()")
                for entry in children
                    match entry
                        Expr(et, ev, en, ec, ef, eln) =>
                            let key_r = codegen_expr(cg, ec[0])
                            let val_r = codegen_expr(cg, ec[1])
                            let tmp = fresh_tmp(cg)
                            emit_indent(cg, tmp + " = call i64 @nova_rt_dict_set(i64 " + r + ", i64 " + key_r + ", i64 " + val_r + ")")
                r
            else if tag == "if"
                codegen_if_expr(cg, children)
            else
                "0"

fn codegen_binop(cg: CodeGen, op: string, left: Expr, right: Expr) -> string
    let l = codegen_expr(cg, left)
    let r_val = codegen_expr(cg, right)
    let result = fresh_reg(cg)
    if op == "+"
        emit_indent(cg, result + " = call i64 @nova_rt_add(i64 " + l + ", i64 " + r_val + ")")
    else if op == "-"
        emit_indent(cg, result + " = sub i64 " + l + ", " + r_val)
    else if op == "*"
        emit_indent(cg, result + " = mul i64 " + l + ", " + r_val)
    else if op == "/"
        emit_indent(cg, result + " = sdiv i64 " + l + ", " + r_val)
    else if op == "%"
        emit_indent(cg, result + " = srem i64 " + l + ", " + r_val)
    else if op == "=="
        let cmp = fresh_tmp(cg)
        emit_indent(cg, cmp + " = call i64 @nova_rt_eq(i64 " + l + ", i64 " + r_val + ")")
        emit_indent(cg, result + " = and i64 " + cmp + ", 1")
        // Use result directly (already i64 0 or 1)
        return cmp
    else if op == "!="
        let cmp = fresh_tmp(cg)
        emit_indent(cg, cmp + " = call i64 @nova_rt_neq(i64 " + l + ", i64 " + r_val + ")")
        return cmp
    else if op == "<"
        let cmp = fresh_tmp(cg)
        emit_indent(cg, cmp + " = icmp slt i64 " + l + ", " + r_val)
        emit_indent(cg, result + " = zext i1 " + cmp + " to i64")
    else if op == ">"
        let cmp = fresh_tmp(cg)
        emit_indent(cg, cmp + " = icmp sgt i64 " + l + ", " + r_val)
        emit_indent(cg, result + " = zext i1 " + cmp + " to i64")
    else if op == "<="
        let cmp = fresh_tmp(cg)
        emit_indent(cg, cmp + " = icmp sle i64 " + l + ", " + r_val)
        emit_indent(cg, result + " = zext i1 " + cmp + " to i64")
    else if op == ">="
        let cmp = fresh_tmp(cg)
        emit_indent(cg, cmp + " = icmp sge i64 " + l + ", " + r_val)
        emit_indent(cg, result + " = zext i1 " + cmp + " to i64")
    else if op == "and"
        let lbl_entry = fresh_label(cg, "and_entry")
        emit_indent(cg, "br label %" + lbl_entry)
        emit(cg, lbl_entry + ":")
        let cmp = fresh_tmp(cg)
        emit_indent(cg, cmp + " = icmp ne i64 " + l + ", 0")
        let lbl_rhs = fresh_label(cg, "and_rhs")
        let lbl_end = fresh_label(cg, "and_end")
        emit_indent(cg, "br i1 " + cmp + ", label %" + lbl_rhs + ", label %" + lbl_end)
        emit(cg, lbl_rhs + ":")
        let r2 = codegen_expr(cg, right)
        let lbl_rhs_done = fresh_label(cg, "and_done")
        emit_indent(cg, "br label %" + lbl_rhs_done)
        emit(cg, lbl_rhs_done + ":")
        emit_indent(cg, "br label %" + lbl_end)
        emit(cg, lbl_end + ":")
        emit_indent(cg, result + " = phi i64 [0, %" + lbl_entry + "], [" + r2 + ", %" + lbl_rhs_done + "]")
        return result
    else if op == "or"
        let lbl_entry = fresh_label(cg, "or_entry")
        emit_indent(cg, "br label %" + lbl_entry)
        emit(cg, lbl_entry + ":")
        let cmp = fresh_tmp(cg)
        emit_indent(cg, cmp + " = icmp ne i64 " + l + ", 0")
        let lbl_rhs = fresh_label(cg, "or_rhs")
        let lbl_end = fresh_label(cg, "or_end")
        emit_indent(cg, "br i1 " + cmp + ", label %" + lbl_end + ", label %" + lbl_rhs)
        emit(cg, lbl_rhs + ":")
        let r2 = codegen_expr(cg, right)
        let lbl_rhs_done = fresh_label(cg, "or_done")
        emit_indent(cg, "br label %" + lbl_rhs_done)
        emit(cg, lbl_rhs_done + ":")
        emit_indent(cg, "br label %" + lbl_end)
        emit(cg, lbl_end + ":")
        emit_indent(cg, result + " = phi i64 [" + l + ", %" + lbl_entry + "], [" + r2 + ", %" + lbl_rhs_done + "]")
        return result
    else if op == "<<" or op == ">>" or op == "&" or op == "|" or op == "^"
        let llvm_op = if op == "<<"
            "shl"
        else if op == ">>"
            "ashr"
        else if op == "&"
            "and"
        else if op == "|"
            "or"
        else
            "xor"
        emit_indent(cg, result + " = " + llvm_op + " i64 " + l + ", " + r_val)
    else
        emit_indent(cg, result + " = add i64 " + l + ", " + r_val)
    result

fn codegen_unary(cg: CodeGen, op: string, operand: Expr) -> string
    let val = codegen_expr(cg, operand)
    let result = fresh_reg(cg)
    if op == "-"
        emit_indent(cg, result + " = sub i64 0, " + val)
    else if op == "not"
        let cmp = fresh_tmp(cg)
        emit_indent(cg, cmp + " = icmp eq i64 " + val + ", 0")
        emit_indent(cg, result + " = zext i1 " + cmp + " to i64")
    else if op == "~"
        emit_indent(cg, result + " = xor i64 " + val + ", -1")
    else
        return val
    result

fn codegen_call(cg: CodeGen, name: string, args: list) -> string
    // Check if this is a struct constructor
    if contains(cg.struct_defs, name)
        let num_fields = len(args)
        let alloc_size = num_fields * 8
        let ptr = fresh_reg(cg)
        emit_indent(cg, ptr + " = call ptr @nova_rt_struct_alloc(i64 " + str(alloc_size) + ")")
        let fi = 0
        for arg in args
            let arg_r = codegen_expr(cg, arg)
            let gep = fresh_tmp(cg)
            emit_indent(cg, gep + " = getelementptr i64, ptr " + ptr + ", i64 " + str(fi))
            emit_indent(cg, "store i64 " + arg_r + ", ptr " + gep + ", align 8")
            fi = fi + 1
        let result = fresh_reg(cg)
        emit_indent(cg, result + " = ptrtoint ptr " + ptr + " to i64")
        return result
    // Map NOVA stdlib names to runtime functions
    let rt_name = resolve_runtime_fn(name)
    let arg_strs = []
    for arg in args
        let a = codegen_expr(cg, arg)
        push(arg_strs, "i64 " + a)
    let result = fresh_reg(cg)
    let args_str = join(arg_strs, ", ")
    emit_indent(cg, result + " = call i64 @" + rt_name + "(" + args_str + ")")
    result

fn codegen_method_call(cg: CodeGen, method: string, args: list) -> string
    // args[0] is receiver, rest are method args
    let rt_name = resolve_method_fn(method)
    let arg_strs = []
    for arg in args
        let a = codegen_expr(cg, arg)
        push(arg_strs, "i64 " + a)
    let result = fresh_reg(cg)
    let args_str = join(arg_strs, ", ")
    emit_indent(cg, result + " = call i64 @" + rt_name + "(" + args_str + ")")
    result

fn codegen_if_expr(cg: CodeGen, parts: list) -> string
    let cond_r = codegen_expr(cg, parts[0])
    let cmp = fresh_tmp(cg)
    emit_indent(cg, cmp + " = icmp ne i64 " + cond_r + ", 0")
    let lbl_then = fresh_label(cg, "if_then")
    let lbl_else = fresh_label(cg, "if_else")
    let lbl_merge = fresh_label(cg, "if_merge")
    emit_indent(cg, "br i1 " + cmp + ", label %" + lbl_then + ", label %" + lbl_else)
    emit(cg, lbl_then + ":")
    let then_r = codegen_expr(cg, parts[1])
    let lbl_then_done = fresh_label(cg, "if_then_done")
    emit_indent(cg, "br label %" + lbl_then_done)
    emit(cg, lbl_then_done + ":")
    emit_indent(cg, "br label %" + lbl_merge)
    emit(cg, lbl_else + ":")
    let else_r = if len(parts) > 2
        codegen_expr(cg, parts[2])
    else
        "0"
    let lbl_else_done = fresh_label(cg, "if_else_done")
    emit_indent(cg, "br label %" + lbl_else_done)
    emit(cg, lbl_else_done + ":")
    emit_indent(cg, "br label %" + lbl_merge)
    emit(cg, lbl_merge + ":")
    let result = fresh_reg(cg)
    emit_indent(cg, result + " = phi i64 [" + then_r + ", %" + lbl_then_done + "], [" + else_r + ", %" + lbl_else_done + "]")
    result

// ── LLVM Codegen: Statements ─────────────────────────────────────────────────

fn codegen_stmt(cg: CodeGen, stmt: Stmt)
    match stmt
        Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
            if tag == "assign"
                let val_r = codegen_expr(cg, expr)
                if name != ""
                    let slot = get_slot(cg, name)
                    emit_indent(cg, "store i64 " + val_r + ", ptr " + slot + ", align 8")
                else if len(annotations) > 0
                    let lhs = annotations[0]
                    let lhs_is_ident = false
                    let lhs_ident_nm = ""
                    match lhs
                        Expr(et, ev, en, ec, ef, eln) =>
                            if et == "ident"
                                lhs_is_ident = true
                                lhs_ident_nm = ev
                    if lhs_is_ident
                        let slot = get_slot(cg, lhs_ident_nm)
                        emit_indent(cg, "store i64 " + val_r + ", ptr " + slot + ", align 8")
                    else
                        codegen_assign_target(cg, lhs, val_r)
            else if tag == "compound_assign"
                let lhs = annotations[0]
                let lhs_val = codegen_expr(cg, lhs)
                let rhs_val = codegen_expr(cg, expr)
                let result = fresh_reg(cg)
                if name == "+=" or name == "+"
                    emit_indent(cg, result + " = call i64 @nova_rt_add(i64 " + lhs_val + ", i64 " + rhs_val + ")")
                else if name == "-=" or name == "-"
                    emit_indent(cg, result + " = sub i64 " + lhs_val + ", " + rhs_val)
                else if name == "*=" or name == "*"
                    emit_indent(cg, result + " = mul i64 " + lhs_val + ", " + rhs_val)
                else
                    emit_indent(cg, result + " = sdiv i64 " + lhs_val + ", " + rhs_val)
                codegen_assign_target(cg, lhs, result)
            else if tag == "expr"
                let _discard = codegen_expr(cg, expr)
            else if tag == "return"
                let val_r = codegen_expr(cg, expr)
                emit_indent(cg, "ret i64 " + val_r)
            else if tag == "if"
                codegen_if_stmt(cg, stmt)
            else if tag == "while"
                codegen_while_stmt(cg, stmt)
            else if tag == "for"
                codegen_for_stmt(cg, stmt)
            else if tag == "match"
                codegen_match_stmt(cg, stmt)
            else if tag == "break"
                emit_indent(cg, "br label %" + cg.loop_exit)
            else if tag == "continue"
                emit_indent(cg, "br label %" + cg.loop_hdr)

fn codegen_assign_target(cg: CodeGen, target: Expr, val_reg: string)
    match target
        Expr(tag, value, num, children, fields, eline) =>
            if tag == "ident"
                let slot = get_slot(cg, value)
                emit_indent(cg, "store i64 " + val_reg + ", ptr " + slot + ", align 8")
            else if tag == "index"
                let target_r = codegen_expr(cg, children[0])
                let idx_r = codegen_expr(cg, children[1])
                let tmp = fresh_tmp(cg)
                emit_indent(cg, tmp + " = call i64 @nova_rt_index_set(i64 " + target_r + ", i64 " + idx_r + ", i64 " + val_reg + ")")
            else if tag == "member"
                let target_r = codegen_expr(cg, children[0])
                let field_idx = get_field_index(cg, value)
                let ptr = fresh_tmp(cg)
                emit_indent(cg, ptr + " = inttoptr i64 " + target_r + " to ptr")
                let gep = fresh_tmp(cg)
                emit_indent(cg, gep + " = getelementptr i64, ptr " + ptr + ", i64 " + str(field_idx))
                emit_indent(cg, "store i64 " + val_reg + ", ptr " + gep + ", align 8")

fn codegen_if_stmt(cg: CodeGen, stmt: Stmt)
    match stmt
        Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
            let cond_r = codegen_expr(cg, expr)
            let cmp = fresh_tmp(cg)
            emit_indent(cg, cmp + " = icmp ne i64 " + cond_r + ", 0")
            let lbl_then = fresh_label(cg, "then")
            let lbl_else = fresh_label(cg, "else")
            let lbl_merge = fresh_label(cg, "merge")
            emit_indent(cg, "br i1 " + cmp + ", label %" + lbl_then + ", label %" + lbl_else)
            emit(cg, lbl_then + ":")
            for s in body
                codegen_stmt(cg, s)
            emit_indent(cg, "br label %" + lbl_merge)
            emit(cg, lbl_else + ":")
            for s in else_body
                codegen_stmt(cg, s)
            emit_indent(cg, "br label %" + lbl_merge)
            emit(cg, lbl_merge + ":")

fn codegen_while_stmt(cg: CodeGen, stmt: Stmt)
    match stmt
        Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
            let prev_hdr = cg.loop_hdr
            let prev_exit = cg.loop_exit
            let lbl_hdr = fresh_label(cg, "while_hdr")
            let lbl_body = fresh_label(cg, "while_body")
            let lbl_exit = fresh_label(cg, "while_exit")
            cg.loop_hdr = lbl_hdr
            cg.loop_exit = lbl_exit
            emit_indent(cg, "br label %" + lbl_hdr)
            emit(cg, lbl_hdr + ":")
            let cond_r = codegen_expr(cg, expr)
            let cmp = fresh_tmp(cg)
            emit_indent(cg, cmp + " = icmp ne i64 " + cond_r + ", 0")
            emit_indent(cg, "br i1 " + cmp + ", label %" + lbl_body + ", label %" + lbl_exit)
            emit(cg, lbl_body + ":")
            for s in body
                codegen_stmt(cg, s)
            emit_indent(cg, "br label %" + lbl_hdr)
            emit(cg, lbl_exit + ":")
            cg.loop_hdr = prev_hdr
            cg.loop_exit = prev_exit

fn codegen_for_stmt(cg: CodeGen, stmt: Stmt)
    match stmt
        Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
            let prev_hdr = cg.loop_hdr
            let prev_exit = cg.loop_exit
            let iter_r = codegen_expr(cg, expr)
            let len_r = fresh_reg(cg)
            emit_indent(cg, len_r + " = call i64 @nova_rt_len_any(i64 " + iter_r + ")")
            let idx_name = "__for_idx_" + str(cg.label_count)
            let idx_slot = get_slot(cg, idx_name)
            emit_indent(cg, idx_slot + " = alloca i64, align 8")
            emit_indent(cg, "store i64 0, ptr " + idx_slot + ", align 8")
            let lbl_hdr = fresh_label(cg, "for_hdr")
            let lbl_body = fresh_label(cg, "for_body")
            let lbl_exit = fresh_label(cg, "for_exit")
            cg.loop_hdr = lbl_hdr
            cg.loop_exit = lbl_exit
            emit_indent(cg, "br label %" + lbl_hdr)
            emit(cg, lbl_hdr + ":")
            let idx_r = fresh_reg(cg)
            emit_indent(cg, idx_r + " = load i64, ptr " + idx_slot + ", align 8")
            let cmp = fresh_tmp(cg)
            emit_indent(cg, cmp + " = icmp slt i64 " + idx_r + ", " + len_r)
            emit_indent(cg, "br i1 " + cmp + ", label %" + lbl_body + ", label %" + lbl_exit)
            emit(cg, lbl_body + ":")
            // Load current element
            let elem_r = fresh_reg(cg)
            emit_indent(cg, elem_r + " = call i64 @nova_rt_index_get(i64 " + iter_r + ", i64 " + idx_r + ")")
            let var_slot = get_slot(cg, name)
            emit_indent(cg, "store i64 " + elem_r + ", ptr " + var_slot + ", align 8")
            for s in body
                codegen_stmt(cg, s)
            // Increment index
            let new_idx = fresh_reg(cg)
            let cur_idx = fresh_reg(cg)
            emit_indent(cg, cur_idx + " = load i64, ptr " + idx_slot + ", align 8")
            emit_indent(cg, new_idx + " = add i64 " + cur_idx + ", 1")
            emit_indent(cg, "store i64 " + new_idx + ", ptr " + idx_slot + ", align 8")
            emit_indent(cg, "br label %" + lbl_hdr)
            emit(cg, lbl_exit + ":")
            cg.loop_hdr = prev_hdr
            cg.loop_exit = prev_exit

fn codegen_match_stmt(cg: CodeGen, stmt: Stmt)
    match stmt
        Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
            let subject_r = codegen_expr(cg, expr)
            // For struct destructuring: load fields into variables
            for arm in body
                match arm
                    Stmt(at, an, pattern, arm_body, ap, ae, aa, _aln) =>
                        match pattern
                            Expr(pt, pv, pn, pchildren, pf, pln2) =>
                                if pt == "pat_ctor"
                                    // Destructure: load each field
                                    let ptr = fresh_tmp(cg)
                                    emit_indent(cg, ptr + " = inttoptr i64 " + subject_r + " to ptr")
                                    let fi = 0
                                    for field_pat in pchildren
                                        match field_pat
                                            Expr(fpt, fpv, fpn, fpc, fpf, fpln) =>
                                                if fpv != "_"
                                                    let gep = fresh_tmp(cg)
                                                    emit_indent(cg, gep + " = getelementptr i64, ptr " + ptr + ", i64 " + str(fi))
                                                    let fval = fresh_reg(cg)
                                                    emit_indent(cg, fval + " = load i64, ptr " + gep + ", align 8")
                                                    let fslot = get_slot(cg, fpv)
                                                    emit_indent(cg, "store i64 " + fval + ", ptr " + fslot + ", align 8")
                                        fi = fi + 1
                                for s in arm_body
                                    codegen_stmt(cg, s)

// ── Runtime Function Resolution ──────────────────────────────────────────────

fn resolve_runtime_fn(name: string) -> string
    if name == "print"
        "nova_rt_print_any"
    else if name == "len"
        "nova_rt_len_any"
    else if name == "str"
        "nova_rt_int_to_str"
    else if name == "int"
        "nova_rt_parse_int"
    else if name == "push"
        "nova_rt_list_append"
    else if name == "ord"
        "nova_rt_ord"
    else if name == "chr"
        "nova_rt_chr"
    else if name == "assert"
        "nova_rt_assert"
    else if name == "contains"
        "nova_rt_contains"
    else if name == "read_file"
        "nova_rt_read_file"
    else if name == "write_file"
        "nova_rt_write_file"
    else if name == "args"
        "nova_rt_args"
    else if name == "exit"
        "nova_rt_exit"
    else if name == "split"
        "nova_rt_split"
    else if name == "join"
        "nova_rt_join"
    else if name == "upper"
        "nova_rt_upper"
    else if name == "lower"
        "nova_rt_lower"
    else if name == "trim"
        "nova_rt_trim"
    else if name == "replace"
        "nova_rt_replace"
    else if name == "starts_with"
        "nova_rt_starts_with"
    else if name == "ends_with"
        "nova_rt_ends_with"
    else if name == "filter"
        "nova_rt_list_filter"
    else if name == "map"
        "nova_rt_list_map"
    else if name == "float_bits"
        "nova_rt_float_bits"
    else if name == "slice"
        "nova_rt_slice"
    else if name == "repeat"
        "nova_rt_repeat"
    else if name == "chars"
        "nova_rt_chars"
    else if name == "time_ms"
        "nova_rt_time_ms"
    else if name == "sleep"
        "nova_rt_sleep_ms"
    else if name == "clock_ns"
        "nova_rt_clock_ns"
    else if name == "type_of"
        "nova_rt_type_of"
    else if name == "range"
        "nova_rt_range"
    else if name == "sort"
        "nova_rt_list_sort"
    else if name == "keys"
        "nova_rt_dict_keys"
    else if name == "values"
        "nova_rt_dict_values"
    else if name == "system"
        "nova_rt_system"
    else if name == "exec"
        "nova_rt_exec"
    else if name == "parse_int"
        "nova_rt_parse_int"
    else if name == "parse_float"
        "nova_rt_parse_float"
    else if name == "dict_keys"
        "nova_rt_dict_keys"
    else if name == "dict_values"
        "nova_rt_dict_values"
    else if name == "dict_items"
        "nova_rt_dict_items"
    else if name == "any_to_str"
        "nova_rt_any_to_str"
    else if name == "read_line"
        "nova_rt_read_line"
    else if name == "append_file"
        "nova_rt_append_file"
    else if name == "file_exists"
        "nova_rt_file_exists"
    else if name == "find"
        "nova_rt_find"
    else if name == "list_concat"
        "nova_rt_list_concat"
    else if name == "list_reverse"
        "nova_rt_list_reverse"
    else if name == "list_sort"
        "nova_rt_list_sort"
    else if name == "list_slice"
        "nova_rt_list_slice"
    else if name == "http_get"
        "nova_rt_http_get"
    else if name == "http_post"
        "nova_rt_http_post"
    else if name == "mkdir"
        "nova_rt_mkdir"
    else if name == "mkdir_p"
        "nova_rt_mkdir_p"
    else if name == "path_join"
        "nova_rt_path_join"
    else if name == "path_exists"
        "nova_rt_path_exists"
    else if name == "path_parent"
        "nova_rt_path_parent"
    else if name == "path_name"
        "nova_rt_path_name"
    else if name == "read_bytes"
        "nova_rt_read_bytes"
    else if name == "write_raw"
        "nova_rt_write_raw"
    else
        name

fn resolve_method_fn(name: string) -> string
    if name == "push"
        "nova_rt_list_append"
    else if name == "len"
        "nova_rt_len_any"
    else if name == "keys"
        "nova_rt_dict_keys"
    else if name == "values"
        "nova_rt_dict_values"
    else if name == "items"
        "nova_rt_dict_items"
    else if name == "has"
        "nova_rt_dict_has"
    else if name == "del"
        "nova_rt_dict_del"
    else if name == "reverse"
        "nova_rt_list_reverse"
    else if name == "sort"
        "nova_rt_list_sort"
    else if name == "map"
        "nova_rt_list_map"
    else if name == "filter"
        "nova_rt_list_filter"
    else if name == "concat"
        "nova_rt_list_concat"
    else if name == "print"
        "nova_rt_print_any"
    else if name == "str"
        "nova_rt_any_to_str"
    else
        "nova_rt_" + name

fn get_field_index(cg: CodeGen, field_name: string) -> int
    if contains(cg.field_map, field_name)
        return cg.field_map[field_name]
    return 0

// ── LLVM Module Emission ─────────────────────────────────────────────────────

fn emit_module_header(cg: CodeGen)
    emit(cg, "; NOVA Self-Hosted Compiler Output")
    emit(cg, "target datalayout = \"e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128\"")
    emit(cg, "")
    emit(cg, "@__nova_error_flag = thread_local global i64 0")
    emit(cg, "@__nova_error_msg = thread_local global i64 0")
    emit(cg, "")

fn emit_runtime_declarations(cg: CodeGen)
    emit(cg, "; Runtime declarations")
    emit(cg, "declare i32 @puts(ptr) nounwind")
    emit(cg, "declare i32 @printf(ptr, ...) nounwind")
    emit(cg, "declare i64 @nova_rt_list_create() nounwind")
    emit(cg, "declare i64 @nova_rt_list_append(i64, i64) nounwind")
    emit(cg, "declare i64 @nova_rt_list_get(i64, i64) nounwind")
    emit(cg, "declare i64 @nova_rt_list_len(i64) nounwind")
    emit(cg, "declare i64 @nova_rt_dict_create() nounwind")
    emit(cg, "declare i64 @nova_rt_dict_set(i64, i64, i64) nounwind")
    emit(cg, "declare i64 @nova_rt_dict_get(i64, i64) nounwind")
    emit(cg, "declare i64 @nova_rt_dict_contains(i64, i64) nounwind")
    emit(cg, "declare i64 @nova_rt_str_concat(i64, i64) nounwind")
    emit(cg, "declare i64 @nova_rt_int_to_str(i64) nounwind")
    emit(cg, "declare i64 @nova_rt_parse_int(i64) nounwind")
    emit(cg, "declare i64 @nova_rt_len(i64) nounwind")
    emit(cg, "declare i64 @nova_rt_len_any(i64) nounwind")
    emit(cg, "declare i64 @nova_rt_ord(i64) nounwind")
    emit(cg, "declare i64 @nova_rt_chr(i64) nounwind")
    emit(cg, "declare i64 @nova_rt_contains(i64, i64) nounwind")
    emit(cg, "declare i64 @nova_rt_index_get(i64, i64) nounwind")
