// _struct_arena_masked_test.nova -- PROVES CORE_GAP 0.8's blast-radius boundary: the struct-field
// leak is fully MASKED inside an arena scope (so Forge's per-request-arena path is unaffected). Same
// leaking ListBox churn as _struct_field_leak_test, but wrapped in arena_enter()..arena_exit(): every
// struct + its heap field is arena-owned (ARENA_BIT -> rc_dec no-op) and freed WHOLESALE on exit.
// If arena-masking holds, live_delta -> ~0 across many arena cycles. This is the empirical basis for
// "0.8 does NOT affect Forge" (request handlers run inside forge.serve_n_arena's per-request scope).
type ListBox
    v: list

fn churn_in_arena(rounds: int) -> int
    let prev = arena_enter()      // per-request-style scope
    let acc = 0
    let i = 0
    while i < rounds
        let y = ListBox([i, i + 1, i + 2])
        acc = acc + len(y.v)
        i = i + 1
    arena_exit(prev)              // frees the struct AND its field lists wholesale
    return acc

fn main()
    let b0 = live_count()
    let acc = 0
    let k = 0
    while k < 500
        acc = acc + churn_in_arena(200)   // 500 arena cycles x 200 struct-with-field allocs each
        k = k + 1
    let delta = live_count() - b0
    print("struct_arena_masked delta=" + str(delta) + " acc=" + str(acc))
    // With arena masking, all 100k struct+field allocs are reclaimed wholesale -> delta ~0.
    if delta > 50
        print("struct_arena_masked_test FAILED: arena did NOT mask the struct-field leak (delta=" + str(delta) + ") -- 0.8 blast radius is WIDER than believed (Forge affected!)")
        exit(1)
    print("struct_arena_masked_test passed: 0.8 leak fully masked by arenas (Forge per-request path safe), delta=" + str(delta))
