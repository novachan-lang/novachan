import forge_audit_chain

fn main()
    let a = ac_new()
    a = ac_append(a, "create_user", "admin")
    a = ac_append(a, "delete_file", "alice")
    a = ac_append(a, "update_config", "bob")
    assert(ac_count(a) == 3, "3 entries")

    let r1 = ac_get(a, 0)
    assert(is_ok(r1), "get 0 ok")
    assert(unwrap(r1) == "admin:create_user", "first entry")

    let r2 = ac_actor_at(a, 1)
    assert(is_ok(r2), "actor ok")
    assert(unwrap(r2) == "alice", "alice at 1")

    let r3 = ac_action_at(a, 2)
    assert(is_ok(r3), "action ok")
    assert(unwrap(r3) == "update_config", "correct action")

    assert(ac_verify(a, 0) == 1, "verify 0")
    assert(ac_verify(a, 2) == 1, "verify 2")
    assert(ac_verify(a, 99) == 0, "verify out of range")

    let bad = ac_get(a, 99)
    assert(is_err(bad), "out of range")

    print("AUDIT-CHAIN KAT PASS")
