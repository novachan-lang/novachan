import forge_metric_store

fn main()
    let s = ms_new()
    assert(ms_metric_count(s) == 0, "0 metrics")
    assert(ms_total_records(s) == 0, "0 records")
    assert(ms_metric_list(s) == "", "empty list")

    let miss1 = ms_latest(s, "cpu")
    assert(is_err(miss1), "latest on missing errs")
    let miss2 = ms_count(s, "cpu")
    assert(is_err(miss2), "count on missing errs")

    s = ms_record(s, "cpu", 10, 1000)
    s = ms_record(s, "cpu", 20, 1010)
    s = ms_record(s, "cpu", 30, 1020)
    s = ms_record(s, "mem", 500, 1005)

    assert(ms_metric_count(s) == 2, "2 metrics")
    assert(ms_total_records(s) == 4, "4 records")

    let lat1 = ms_latest(s, "cpu")
    assert(is_ok(lat1), "latest cpu ok")
    assert(unwrap(lat1) == 30, "latest cpu is 30")

    let lt1 = ms_latest_time(s, "cpu")
    assert(is_ok(lt1), "latest time ok")
    assert(unwrap(lt1) == 1020, "latest cpu time is 1020")

    let cnt1 = ms_count(s, "cpu")
    assert(is_ok(cnt1), "count cpu ok")
    assert(unwrap(cnt1) == 3, "cpu recorded 3 times")

    let sum1 = ms_sum(s, "cpu")
    assert(is_ok(sum1), "sum cpu ok")
    assert(unwrap(sum1) == 60, "cpu sum is 60")

    let mean1 = ms_mean(s, "cpu")
    assert(is_ok(mean1), "mean cpu ok")
    assert(unwrap(mean1) == 20, "cpu mean is 20")

    let lat2 = ms_latest(s, "mem")
    assert(unwrap(lat2) == 500, "mem latest 500")
    let cnt2 = ms_count(s, "mem")
    assert(unwrap(cnt2) == 1, "mem count 1")
    let mean2 = ms_mean(s, "mem")
    assert(unwrap(mean2) == 500, "mem mean 500")

    let list1 = ms_metric_list(s)
    assert(list1 == "cpu,mem", "metric list cpu,mem")

    let sumbad = ms_sum(s, "disk")
    assert(is_err(sumbad), "sum on missing errs")
    let meanbad = ms_mean(s, "disk")
    assert(is_err(meanbad), "mean on missing errs")
    let timebad = ms_latest_time(s, "disk")
    assert(is_err(timebad), "latest_time on missing errs")

    print("METRIC-STORE KAT PASS")
