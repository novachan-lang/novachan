import std/gametheory/staircase_nim

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _staircase_nim_test " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gs = "false"
    if got
        gs = "true"
    let ws = "false"
    if want
        ws = "true"
    if got != want
        print("FAIL _staircase_nim_test " + label + ": got " + gs + " want " + ws)
        exit(1)

fn ckl(label: string, got: list, want: list)
    let n = len(want)
    if len(got) != n
        print("FAIL _staircase_nim_test " + label + ": len got " + str(len(got)) + " want " + str(n))
        exit(1)
    let i = 0
    while i < n
        if got[i] != want[i]
            print("FAIL _staircase_nim_test " + label + "[" + str(i) + "]: got " + str(got[i]) + " want " + str(want[i]))
            exit(1)
        i = i + 1

fn mk_steps(a: int, b: int, c: int, d: int) -> list
    let xs = []
    push(xs, a)
    push(xs, b)
    push(xs, c)
    push(xs, d)
    xs

fn mk3(a: int, b: int, c: int) -> list
    let xs = []
    push(xs, a)
    push(xs, b)
    push(xs, c)
    xs

fn mk1(a: int) -> list
    let xs = []
    push(xs, a)
    xs

fn main()
    // stn_nim_value([1,2,3,4]) = index1=2 XOR index3=4 = 6
    cki("nim_val_1234", stn_nim_value(mk_steps(1,2,3,4)), 6)

    // stn_is_winning([1,2,3,4]) = true
    ckb("winning_1234", stn_is_winning(mk_steps(1,2,3,4)), true)

    // stn_nim_value([5,3,5,3]) = 3 XOR 3 = 0
    cki("nim_val_5353", stn_nim_value(mk_steps(5,3,5,3)), 0)

    // stn_is_winning([5,3,5,3]) = false
    ckb("winning_5353", stn_is_winning(mk_steps(5,3,5,3)), false)

    // stn_odd_heaps([1,2,3,4]) = [2,4]
    let want_oh = []
    push(want_oh, 2)
    push(want_oh, 4)
    ckl("odd_heaps_1234", stn_odd_heaps(mk_steps(1,2,3,4)), want_oh)

    // stn_nim_value([9]) = 0 (no odd index in length-1 list)
    cki("nim_val_9", stn_nim_value(mk1(9)), 0)

    // stn_is_winning([9]) = false
    ckb("winning_9", stn_is_winning(mk1(9)), false)

    // Empty steps: nim_value = 0, not winning
    let empty = []
    cki("nim_val_empty", stn_nim_value(empty), 0)
    ckb("winning_empty", stn_is_winning(empty), false)

    // stn_odd_heaps([5,3,5,3]) = [3,3]
    let want_oh2 = []
    push(want_oh2, 3)
    push(want_oh2, 3)
    ckl("odd_heaps_5353", stn_odd_heaps(mk_steps(5,3,5,3)), want_oh2)

    // Three steps [0,7,0]: odd index 1 has 7. nim_value=7, winning
    let s3 = mk3(0, 7, 0)
    cki("nim_val_070", stn_nim_value(s3), 7)
    ckb("winning_070", stn_is_winning(s3), true)

    print("PASS _staircase_nim_test")
