import std/text/graphemex

// _ck_i — check integer equality.
fn _ck_i(label: string, got: int, want: int)
    if got != want
        print("FAIL graphemex " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// _ck_s — check string equality.
fn _ck_s(label: string, got: string, want: string)
    if got != want
        print("FAIL graphemex " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn main()
    // ---- plain ASCII: one grapheme per byte, grapheme_count == length ----
    _ck_i("ascii_count", grapheme_count("hello"), 5)
    let g_ascii = graphemes("hello")
    _ck_i("ascii_cluster_list_len", len(g_ascii), 5)
    _ck_s("ascii_first_cluster", g_ascii[0], "h")

    // ---- base letter + combining acute accent (U+0065 U+0301) ----
    // 2 codepoints, but ONE user-perceived grapheme.
    let combo = from_codepoint(101) + from_codepoint(769)
    _ck_i("combo_codepoint_count", char_count(combo), 2)
    _ck_i("combo_grapheme_count", grapheme_count(combo), 1)
    let g_combo = graphemes(combo)
    _ck_i("combo_cluster_list_len", len(g_combo), 1)
    _ck_i("combo_cluster_holds_both_cps", char_count(g_combo[0]), 2)

    // ---- combining mark mid-string: "a" + e-acute + "c" ----
    let word = "a" + from_codepoint(101) + from_codepoint(769) + "c"
    _ck_i("word_codepoint_count", char_count(word), 4)
    _ck_i("word_grapheme_count", grapheme_count(word), 3)
    _ck_s("word_middle_grapheme", grapheme_at(word, 1), combo)

    // ---- grapheme-aware reverse keeps the accent attached to its base ----
    let rev = grapheme_reverse(word)
    let expect_rev = "c" + combo + "a"
    _ck_s("reverse_keeps_accent", rev, expect_rev)
    _ck_i("reverse_grapheme_count", grapheme_count(rev), 3)

    // ---- CR LF stays a single grapheme (GB3) ----
    let crlf = from_codepoint(13) + from_codepoint(10)
    _ck_i("crlf_codepoint_count", char_count(crlf), 2)
    _ck_i("crlf_grapheme_count", grapheme_count(crlf), 1)

    // ---- regional-indicator pair (flag) = one grapheme ----
    let flag = from_codepoint(127482) + from_codepoint(127480) // US
    _ck_i("flag_codepoint_count", char_count(flag), 2)
    _ck_i("flag_grapheme_count", grapheme_count(flag), 1)

    print("PASS _graphemex_test")
