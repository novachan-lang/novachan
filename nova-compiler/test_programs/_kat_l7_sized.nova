// KAT: LOCK-4 inc3a — sized/unsigned int TYPES carry their width (u8..i64/usize) and the HM inferrer
// tracks it. A bare literal / plain int (width "") is compatible with any sized context (adopts it);
// two DIFFERENT explicit widths are a compile error (see _negty for that). Values still compute as
// i64 here (wrapping arithmetic is inc3b) — this KAT verifies the TYPES propagate + basics run.
fn take_u8(x: u8) -> u8
    return x
fn take_i32(n: i32) -> i32
    return n + n
fn main() -> int
    let a: u8 = 255u8
    assert(a == 255, "u8 literal value")
    let b: u8 = 5           // bare literal 5 adopts u8
    assert(b == 5, "bare literal adopts sized annotation")
    assert(take_u8(200u8) == 200, "sized fn param/return")
    assert(take_i32(1000i32) == 2000, "i32 fn arithmetic")
    let big: u64 = 1000000u64
    assert(big == 1000000, "u64 value")
    let neg: i16 = 0 - 100
    assert(neg == 0 - 100, "i16 negative")
    print("PASS _kat_l7_sized")
    return 0
main()
