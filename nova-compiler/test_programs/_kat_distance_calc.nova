import forge_distance_calc

fn main()
    assert(dc_manhattan(0, 0, 3, 4) == 7, "manhattan 7")
    assert(dc_chebyshev(0, 0, 3, 4) == 4, "chebyshev 4")
    assert(dc_squared(0, 0, 3, 4) == 25, "squared 25")
    assert(dc_within_radius(0, 0, 3, 4, 5) == 1, "within r=5")
    assert(dc_within_radius(0, 0, 3, 4, 4) == 0, "outside r=4")

    let pts = {}
    pts["0_name"] = "A"
    pts["0_x"] = 1
    pts["0_y"] = 1
    pts["1_name"] = "B"
    pts["1_x"] = 10
    pts["1_y"] = 10
    pts["2_name"] = "C"
    pts["2_x"] = 2
    pts["2_y"] = 3
    let n = dc_nearest(0, 0, pts, 3)
    assert(is_ok(n), "nearest ok")
    assert(unwrap(n) == "A", "A is nearest")

    let empty_n = dc_nearest(0, 0, pts, 0)
    assert(is_err(empty_n), "no points is err")

    print("DISTANCE-CALC KAT PASS")
