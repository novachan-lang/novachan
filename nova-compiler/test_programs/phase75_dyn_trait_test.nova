// Phase 7.5: Dynamic trait dispatch test
// Tests dyn Trait using vtable-based dispatch

trait Shape
    fn area() -> float
    fn name() -> string

type Circle
    radius: float

fn Circle.area() -> float
    3.14159 * self.radius * self.radius

fn Circle.name() -> string
    "circle"

type Rect
    w: float
    h: float

fn Rect.area() -> float
    self.w * self.h

fn Rect.name() -> string
    "rect"

// Test direct dispatch still works
let c = Circle(5.0)
assert(c.name() == "circle", "circle name")

let r = Rect(3.0, 4.0)
assert(r.name() == "rect", "rect name")
assert(r.area() == 12.0, "rect area")

// Test calling trait methods via generic function
fn describe_shape(s) -> string
    s.name() + " has area " + str(s.area())

let cd = describe_shape(c)
assert(cd == "circle has area 78.53975", "circle describe")

let rd = describe_shape(r)
assert(rd == "rect has area 12.0", "rect describe")

// Test with list of mixed shapes
fn total_area(shapes: list) -> float
    let total = 0.0
    for s in shapes
        total = total + s.area()
    total

let shapes = [Circle(1.0), Rect(2.0, 3.0), Circle(2.0)]
let ta = total_area(shapes)
// 3.14159 + 6.0 + 12.56636 = 21.70795
assert(ta > 21.7, "total area lower")
assert(ta < 21.8, "total area upper")

print("PHASE 7.5 DYN TRAIT TEST PASSED")
