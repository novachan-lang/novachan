import std/geometry/cg_polygon_simple

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn main()
    // Square — no self-intersections.
    let sq = [[0,0],[2,0],[2,2],[0,2]]
    ckb("is_simple(square)", cgm_is_simple(sq), true)
    ckb("has_si(square)", cgm_has_self_intersection(sq), false)
    cki("edge_count(square)", cgm_edge_count(sq), 4)

    // Bowtie — self-intersecting.
    let bt = [[0,0],[2,2],[2,0],[0,2]]
    ckb("is_simple(bowtie)", cgm_is_simple(bt), false)
    ckb("has_si(bowtie)", cgm_has_self_intersection(bt), true)

    // Triangle — always simple.
    let tri = [[0,0],[4,0],[0,3]]
    ckb("is_simple(triangle)", cgm_is_simple(tri), true)

    // Pentagon — convex, simple.
    let penta = [[0,0],[4,0],[4,4],[2,5],[0,4]]
    ckb("is_simple(pentagon)", cgm_is_simple(penta), true)

    // Degenerate: fewer than 3 points.
    let tiny = [[0,0],[1,1]]
    ckb("is_simple(2pts)", cgm_is_simple(tiny), true)

    print("PASS _cg_polygon_simple_test")
