import std/cli/cli_kvparse

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn ckl(label: string, got: list, want: list)
    cki(label + "_len", len(got), len(want))
    let i = 0
    while i < len(want)
        cks(label + "[" + str(i) + "]", got[i], want[i])
        i = i + 1

fn main()
    // KAT 1: clk_parse basic key=value pairs
    let p1 = clk_parse(["a=1", "b=2"])
    cki("parse_len", len(p1), 2)
    cks("parse_0_key", p1[0][0], "a")
    cks("parse_0_val", p1[0][1], "1")
    cks("parse_1_key", p1[1][0], "b")
    cks("parse_1_val", p1[1][1], "2")

    // KAT 2: token with no '=' becomes [token, '']
    let p2 = clk_parse(["flag"])
    cki("parse_flag_len", len(p2), 1)
    cks("parse_flag_key", p2[0][0], "flag")
    cks("parse_flag_val", p2[0][1], "")

    // KAT 3: clk_get existing key
    let pairs3 = ["host=localhost", "port=8080"]
    cks("get_port", clk_get(pairs3, "port"), "8080")
    cks("get_host", clk_get(pairs3, "host"), "localhost")

    // KAT 4: clk_get missing key returns ""
    cks("get_missing", clk_get(["a=1"], "z"), "")

    // KAT 5: clk_has present key
    ckb("has_present", clk_has(["a=1"], "a"), true)

    // KAT 6: clk_has absent key
    ckb("has_absent", clk_has(["a=1"], "b"), false)

    // KAT 7: clk_keys returns list of keys in order
    let keys7 = clk_keys(["a=1", "b=2"])
    ckl("keys", keys7, ["a", "b"])

    // KAT 8: empty input
    let p8 = clk_parse([])
    cki("empty_parse_len", len(p8), 0)
    cks("empty_get", clk_get([], "x"), "")
    ckb("empty_has", clk_has([], "x"), false)
    let k8 = clk_keys([])
    cki("empty_keys_len", len(k8), 0)

    // KAT 9: value containing '=' (only first '=' splits)
    let p9 = clk_parse(["url=http://x?a=1"])
    cks("eq_in_val_key", p9[0][0], "url")
    cks("eq_in_val_val", p9[0][1], "http://x?a=1")

    print("PASS _cli_kvparse_test")
