import std/game/card

fn assert_str(label: string, got: string, want: string)
    if got != want
        print("FAIL card " + label + ": got " + got + " want " + want)
        exit(1)

fn assert_int(label: string, got: int, want: int)
    if got != want
        print("FAIL card " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn assert_bool(label: string, got: bool, want: bool)
    let gs = "false"
    if got
        gs = "true"
    let ws = "false"
    if want
        ws = "true"
    if gs != ws
        print("FAIL card " + label + ": got " + gs + " want " + ws)
        exit(1)

fn assert_card(label: string, got: list, want_rank: int, want_suit: int)
    let gr = got[0]
    let gs2 = got[1]
    if gr != want_rank or gs2 != want_suit
        print("FAIL card " + label + ": got [" + str(gr) + "," + str(gs2) + "] want [" + str(want_rank) + "," + str(want_suit) + "]")
        exit(1)

fn main()
    // card_name tests
    let as_card = card(14, 3)
    let as_name = card_name(as_card)
    assert_str("card_name_AS", as_name, "AS")

    let th_card = card(10, 2)
    let th_name = card_name(th_card)
    assert_str("card_name_TH", th_name, "TH")

    let twoc_card = card(2, 0)
    let twoc_name = card_name(twoc_card)
    assert_str("card_name_2C", twoc_name, "2C")

    // card_parse tests
    let parsed_as = card_parse("AS")
    assert_card("card_parse_AS", parsed_as, 14, 3)

    let parsed_th = card_parse("TH")
    assert_card("card_parse_TH", parsed_th, 10, 2)

    let parsed_kd = card_parse("KD")
    assert_card("card_parse_KD", parsed_kd, 13, 1)

    // rank_name tests
    let rn_j = rank_name(11)
    assert_str("rank_name_J", rn_j, "J")

    let rn_a = rank_name(14)
    assert_str("rank_name_A", rn_a, "A")

    // suit_name test
    let sn_s = suit_name(3)
    assert_str("suit_name_S", sn_s, "S")

    // card_rank test
    let kd = card(13, 1)
    let kr = card_rank(kd)
    assert_int("card_rank_KD", kr, 13)

    // card_eq test
    let c1 = card(14, 3)
    let c2 = card(14, 3)
    let ceq = card_eq(c1, c2)
    assert_bool("card_eq_true", ceq, true)

    let c3 = card(14, 3)
    let c4 = card(13, 3)
    let cneq = card_eq(c3, c4)
    assert_bool("card_eq_false", cneq, false)

    // card_suit test
    let cs_card = card(13, 1)
    let cs = card_suit(cs_card)
    assert_int("card_suit_KD", cs, 1)

    print("PASS _card_test")
