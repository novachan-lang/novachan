// KAT for std/game/suit — suit/rank utilities.
// Deterministic vectors verified by hand against the spec.
import std/game/suit

// cks — check string equality; print FAIL and exit(1) on mismatch.
fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL suit " + label + ": got " + got + " want " + want)
        exit(1)

// cki — check int equality; print FAIL and exit(1) on mismatch.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL suit " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// ckcard — check card at index i of a list equals [r,s].
fn ckcard(label: string, card: list, r: int, s: int)
    let gr = card[0]
    let gs = card[1]
    if gr != r or gs != s
        print("FAIL suit " + label + ": got [" + str(gr) + "," + str(gs) + "] want [" + str(r) + "," + str(s) + "]")
        exit(1)

fn main()
    // --- suit_symbol ---
    cks("suit_symbol_0", suit_symbol(0), "C")
    cks("suit_symbol_1", suit_symbol(1), "D")
    cks("suit_symbol_2", suit_symbol(2), "H")
    cks("suit_symbol_3", suit_symbol(3), "S")

    // --- suit_color ---
    cks("suit_color_0_black", suit_color(0), "black")
    cks("suit_color_1_red",   suit_color(1), "red")
    cks("suit_color_2_red",   suit_color(2), "red")
    cks("suit_color_3_black", suit_color(3), "black")

    // --- rank_char ---
    cks("rank_char_14", rank_char(14), "A")
    cks("rank_char_13", rank_char(13), "K")
    cks("rank_char_12", rank_char(12), "Q")
    cks("rank_char_11", rank_char(11), "J")
    cks("rank_char_10", rank_char(10), "T")
    cks("rank_char_9",  rank_char(9),  "9")
    cks("rank_char_2",  rank_char(2),  "2")

    // --- sort_by_rank ---
    // Input: [[10,0],[2,0],[14,0]] -> sorted: [[2,0],[10,0],[14,0]]
    let unsorted1 = []
    let c10c = [10, 0]
    let c2c  = [2, 0]
    let c14c = [14, 0]
    push(unsorted1, c10c)
    push(unsorted1, c2c)
    push(unsorted1, c14c)
    let sorted1 = sort_by_rank(unsorted1)
    cki("sort_by_rank len", len(sorted1), 3)
    ckcard("sort_by_rank[0]", sorted1[0], 2, 0)
    ckcard("sort_by_rank[1]", sorted1[1], 10, 0)
    ckcard("sort_by_rank[2]", sorted1[2], 14, 0)

    // Verify sort_by_rank does NOT mutate original
    ckcard("sort_by_rank_orig[0]", unsorted1[0], 10, 0)

    // --- sort_by_rank stability: two cards with same rank keep original order ---
    // [7,1] then [7,0] should remain [7,1],[7,0] (both rank 7)
    let same_rank = []
    let c71 = [7, 1]
    let c70 = [7, 0]
    push(same_rank, c71)
    push(same_rank, c70)
    let sr_stable = sort_by_rank(same_rank)
    ckcard("sort_by_rank_stable[0]", sr_stable[0], 7, 1)
    ckcard("sort_by_rank_stable[1]", sr_stable[1], 7, 0)

    // --- sort_by_suit ---
    // Input: [[5,3],[5,0]] -> suit 0 before suit 3 -> [[5,0],[5,3]]
    let mixed_suits = []
    let c5s = [5, 3]
    let c5c = [5, 0]
    push(mixed_suits, c5s)
    push(mixed_suits, c5c)
    let by_suit = sort_by_suit(mixed_suits)
    cki("sort_by_suit len", len(by_suit), 2)
    ckcard("sort_by_suit[0]", by_suit[0], 5, 0)
    ckcard("sort_by_suit[1]", by_suit[1], 5, 3)

    // clubs before spades in a 3-card hand
    let hand3 = []
    let h3a = [7, 3]
    let h3b = [5, 0]
    let h3c = [9, 0]
    push(hand3, h3a)
    push(hand3, h3b)
    push(hand3, h3c)
    let by_suit3 = sort_by_suit(hand3)
    // [5,0],[9,0],[7,3] — clubs first by rank, then spades
    ckcard("sort_by_suit3[0]", by_suit3[0], 5, 0)
    ckcard("sort_by_suit3[1]", by_suit3[1], 9, 0)
    ckcard("sort_by_suit3[2]", by_suit3[2], 7, 3)

    // --- group_by_suit ---
    // Input: [[5,0],[7,2],[3,0]] -> clubs=[5c,3c], hearts=[7h], diams=[], spades=[]
    let grp_input = []
    let gi1 = [5, 0]
    let gi2 = [7, 2]
    let gi3 = [3, 0]
    push(grp_input, gi1)
    push(grp_input, gi2)
    push(grp_input, gi3)
    let groups = group_by_suit(grp_input)
    cki("group_by_suit len", len(groups), 4)
    let g_clubs    = groups[0]
    let g_diamonds = groups[1]
    let g_hearts   = groups[2]
    let g_spades   = groups[3]
    // clubs should have 2 cards: [5,0] then [3,0] (original order)
    cki("group clubs len", len(g_clubs), 2)
    ckcard("group clubs[0]", g_clubs[0], 5, 0)
    ckcard("group clubs[1]", g_clubs[1], 3, 0)
    // diamonds: empty
    cki("group diamonds len", len(g_diamonds), 0)
    // hearts: [7,2]
    cki("group hearts len", len(g_hearts), 1)
    ckcard("group hearts[0]", g_hearts[0], 7, 2)
    // spades: empty
    cki("group spades len", len(g_spades), 0)

    print("PASS _suit_test")
