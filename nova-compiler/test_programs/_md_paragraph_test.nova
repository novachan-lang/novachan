// KAT for std/text/md_paragraph
import std/text/md_paragraph

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL md_paragraph " + label + ": got [" + got + "]")
        exit(1)

fn main()
    let nl = chr(10)

    // spec KAT #1: single block
    cks("single", md_paragraph("Hello world"), "<p>Hello world</p>")

    // spec KAT #2: two paragraphs separated by blank line
    cks("two_paras", md_paragraph("A" + nl + nl + "B"), "<p>A</p>" + nl + "<p>B</p>")

    // multi-line single paragraph (no blank line = one block)
    let ml_in = "line one" + nl + "line two"
    let ml_want = "<p>line one" + nl + "line two</p>"
    cks("multiline", md_paragraph(ml_in), ml_want)

    // three paragraphs
    let three_in = "A" + nl + nl + "B" + nl + nl + "C"
    let three_want = "<p>A</p>" + nl + "<p>B</p>" + nl + "<p>C</p>"
    cks("three", md_paragraph(three_in), three_want)

    // leading/trailing blank lines ignored
    cks("leading_blank", md_paragraph(nl + "Hello" + nl), "<p>Hello</p>")

    // empty string -> empty output
    cks("empty", md_paragraph(""), "")

    print("PASS _md_paragraph_test")
