import std/search/search_matrix

fn cki(name: string, got: int, want: int)
    if got != want
        print("FAIL " + name + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(name: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + name + ": got " + gs + " want " + ws)
        exit(1)

fn ckl(name: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + name + ": length got " + str(len(got)) + " want " + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL " + name + ": index " + str(i) + " got " + str(got[i]) + " want " + str(want[i]))
            exit(1)
        i = i + 1

// KAT: sm_search_row_col_sorted([[1,4,7],[2,5,8],[3,6,9]],5)=true
let mat1 = [[1, 4, 7], [2, 5, 8], [3, 6, 9]]
ckb("rc_sorted_found_5", sm_search_row_col_sorted(mat1, 5), true)

// KAT: sm_search_row_col_sorted([[1,4,7],[2,5,8],[3,6,9]],10)=false
ckb("rc_sorted_missing_10", sm_search_row_col_sorted(mat1, 10), false)

// edge: first element
ckb("rc_sorted_first", sm_search_row_col_sorted(mat1, 1), true)

// edge: last element
ckb("rc_sorted_last", sm_search_row_col_sorted(mat1, 9), true)

// edge: empty matrix
let empty_mat = []
ckb("rc_sorted_empty", sm_search_row_col_sorted(empty_mat, 5), false)

// edge: single element matrix found
let single_mat = [[42]]
ckb("rc_sorted_single_found", sm_search_row_col_sorted(single_mat, 42), true)

// edge: single element matrix missing
ckb("rc_sorted_single_miss", sm_search_row_col_sorted(single_mat, 0), false)

// KAT: sm_find_position([[1,4,7],[2,5,8],[3,6,9]],8)=[1,2]
let pos1 = sm_find_position(mat1, 8)
let want_pos = [1, 2]
ckl("find_position_8", pos1, want_pos)

// find_position: element not found -> [-1,-1]
let pos_miss = sm_find_position(mat1, 10)
let want_miss = [-1, -1]
ckl("find_position_miss", pos_miss, want_miss)

// find_position: top-right corner element
let pos_tr = sm_find_position(mat1, 7)
let want_tr = [0, 2]
ckl("find_position_tr", pos_tr, want_tr)

// find_position: bottom-left corner element
let pos_bl = sm_find_position(mat1, 3)
let want_bl = [2, 0]
ckl("find_position_bl", pos_bl, want_bl)

// find_position: empty matrix
let pos_empty = sm_find_position(empty_mat, 5)
let want_empty = [-1, -1]
ckl("find_position_empty", pos_empty, want_empty)

// KAT: sm_search_fully_sorted([[1,3,5],[7,9,11]],9)=true
let fmat = [[1, 3, 5], [7, 9, 11]]
ckb("fully_sorted_found_9", sm_search_fully_sorted(fmat, 9), true)

// KAT: sm_search_fully_sorted([[1,3,5],[7,9,11]],4)=false
ckb("fully_sorted_miss_4", sm_search_fully_sorted(fmat, 4), false)

// fully sorted: first element
ckb("fully_sorted_first", sm_search_fully_sorted(fmat, 1), true)

// fully sorted: last element
ckb("fully_sorted_last", sm_search_fully_sorted(fmat, 11), true)

// fully sorted: empty
ckb("fully_sorted_empty", sm_search_fully_sorted(empty_mat, 5), false)

// fully sorted: single element found
ckb("fully_sorted_single_found", sm_search_fully_sorted(single_mat, 42), true)

// fully sorted: single element missing
ckb("fully_sorted_single_miss", sm_search_fully_sorted(single_mat, 1), false)

print("PASS _search_matrix_test")
