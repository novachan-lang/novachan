// Regression: index-set `x[i]=v` must dispatch on the RUNTIME container kind, not a
// stale STATIC slot type. A slot reassigned across container kinds (its static kind
// becomes wrong) and then index-set used to mis-specialize the runtime fn and segfault
// (nova_rt_dict_set on a list, or the inline list store on a dict). The codegen now
// clears a slot's tracked kind when an untyped value is stored into it -> sound dispatch.

fn _fetch(container, key)
    return container[key]

// cur is `any` (obj is an unannotated param), but at a dict call site the codegen
// used to track its slot kind as "dict"; reassigning to a LIST (untyped call return)
// left that stale, so `cur[idx]=val` mis-specialized to nova_rt_dict_set on a list and
// segfaulted. Now the slot kind is cleared on the untyped store -> sound dispatch.
fn set_into_reassigned_list(obj, key, idx, val)
    let cur = obj
    cur = _fetch(cur, key)
    cur[idx] = val
    return obj

fn main()
    // dict-slot -> list value -> int index-set (the crash repro)
    let d = {}
    d["arr"] = [10, 20, 30]
    set_into_reassigned_list(d, "arr", 1, 200)
    assert_eq(d["arr"][1], 200)
    assert_eq(d["arr"][0], 10)             // siblings intact (no memory corruption)
    assert_eq(d["arr"][2], 30)

    // a deeper nested structure, same reassignment shape
    let cfg = {}
    let nums = [1, 2, 3, 4, 5]
    cfg["nums"] = nums
    set_into_reassigned_list(cfg, "nums", 4, 50)
    assert_eq(cfg["nums"][4], 50)
    assert_eq(cfg["nums"][0], 1)

    // hot-path sanity: a genuinely-typed list keeps the fast path and works
    let xs = [0, 0, 0, 0]
    let i = 0
    while i < 4
        xs[i] = i * i
        i = i + 1
    assert_eq(xs[3], 9)
    assert_eq(xs[0], 0)

    print("idx_set_soundness_test passed")
