import forge_2sat
fn main()
    // satisfiable: (x1 v x2) ^ (~x1 v x2) ^ (~x2 v x3)
    let c1 = [[1, 2], [0 - 1, 2], [0 - 2, 3]]
    let r1 = two_sat(3, c1)
    print("sat1=" + str(r1[0]) + " assign=" + str(r1[1]))
    // unsatisfiable: x1 ^ ~x1
    let c2 = [[1, 1], [0 - 1, 0 - 1]]
    print("unsat1=" + str(two_sat(1, c2)))
    // unsatisfiable classic
    let c3 = [[1, 2], [0 - 1, 2], [1, 0 - 2], [0 - 1, 0 - 2]]
    print("unsat2=" + str(two_sat(2, c3)))
    // satisfiable chain over 4 vars
    let c4 = [[1, 2], [0 - 2, 3], [0 - 3, 4], [0 - 1, 4]]
    let r4 = two_sat(4, c4)
    print("sat4=" + str(r4[0]) + " assign=" + str(r4[1]))
    // edge cases
    print("no clauses n=0: " + str(two_sat(0, [])))
    print("no clauses n=3: " + str(two_sat(3, [])))
    print("single var forced true:  " + str(two_sat(1, [[1, 1]])))
    print("single var forced false: " + str(two_sat(1, [[0 - 1, 0 - 1]])))
    print("EXERCISE-DONE")
