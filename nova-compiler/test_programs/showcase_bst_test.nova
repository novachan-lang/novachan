// showcase_bst -- a binary search tree in pure NOVA using recursive STRUCT nodes. A TENTH angle:
// heap-allocated struct nodes with mutable child links, recursive insert/search/traversal, and
// null handling for empty subtrees. Structs are by-reference (mutation persists). Self-verifying:
// inserting a shuffled set and reading in-order yields the sorted set.
type Node
    val: int
    left: Node
    right: Node

fn insert(root: Node, v: int) -> Node
    if root == null
        return Node(v, null, null)
    if v < root.val
        root.left = insert(root.left, v)
    else if v > root.val
        root.right = insert(root.right, v)
    return root

fn contains_v(root: Node, v: int) -> int
    if root == null
        return 0
    if v == root.val
        return 1
    if v < root.val
        return contains_v(root.left, v)
    return contains_v(root.right, v)

fn inorder(root: Node, out: list)
    if root == null
        return
    inorder(root.left, out)
    push(out, root.val)
    inorder(root.right, out)

fn height(root: Node) -> int
    if root == null
        return 0
    let lh = height(root.left)
    let rh = height(root.right)
    if lh > rh
        return lh + 1
    return rh + 1

fn main()
    let vals = [5, 3, 8, 1, 4, 7, 9, 2, 6]
    let root = null
    for v in vals
        root = insert(root, v)

    let sorted = []
    inorder(root, sorted)
    let line = "in-order: "
    let i = 0
    while i < len(sorted)
        line = line + str(sorted[i])
        if i < len(sorted) - 1
            line = line + " "
        i = i + 1
    print(line)

    // in-order traversal of a BST is sorted
    assert(len(sorted) == 9, "all 9 values present")
    let j = 0
    while j < len(sorted)
        assert(sorted[j] == j + 1, "sorted[" + str(j) + "] == " + str(j + 1))
        j = j + 1

    // search hits and misses
    assert(contains_v(root, 7) == 1, "7 is present")
    assert(contains_v(root, 4) == 1, "4 is present")
    assert(contains_v(root, 10) == 0, "10 is absent")
    assert(contains_v(root, 0) == 0, "0 is absent")

    // duplicate insert is a no-op (BST ignores equal keys here)
    root = insert(root, 5)
    let s2 = []
    inorder(root, s2)
    assert(len(s2) == 9, "duplicate insert did not add a node")

    print("BST height = " + str(height(root)))
    print("showcase_bst_test passed -- recursive struct BST: insert/search/in-order, pure NOVA")
