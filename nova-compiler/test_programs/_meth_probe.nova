fn greet(name: string, greeting: string = "Hello") -> string
    "{greeting}, {name}!"

fn create(x: int, y: int, label: string = "point") -> string
    "{label}({x},{y})"

fn main()
    assert_eq(greet(name: "Alice"), "Hello, Alice!")
    assert_eq(greet(name: "Bob", greeting: "Hi"), "Hi, Bob!")
    assert_eq(greet(greeting: "Hey", name: "Eve"), "Hey, Eve!")
    assert_eq(create(x: 3, y: 4), "point(3,4)")
    assert_eq(create(y: 10, x: 5, label: "vec"), "vec(5,10)")

    print("named_args: all passed")
