// NOVA tensor demo: matrix ops + a tiny neural-net forward pass.
// Shows the AI/ML foundation.

fn main()
    print("=== Tensor smoke test ===")

    // 2x3 matrix A
    let a = tensor_from_list([1, 2, 3, 4, 5, 6], [2, 3])
    print("A shape:")
    print(tensor_shape(a))

    // 3x2 matrix B
    let b = tensor_from_list([1, 2, 3, 4, 5, 6], [3, 2])
    print("B shape:")
    print(tensor_shape(b))

    // C = A @ B (2x3 @ 3x2 = 2x2)
    // A=[[1,2,3],[4,5,6]] B=[[1,2],[3,4],[5,6]]
    // C[0][0] = 1*1+2*3+3*5 = 22
    // C[0][1] = 1*2+2*4+3*6 = 28
    // C[1][0] = 4*1+5*3+6*5 = 49
    // C[1][1] = 4*2+5*4+6*6 = 64
    let c = tensor_matmul(a, b)
    print("C = A @ B, shape:")
    print(tensor_shape(c))
    print("C as list:")
    print(tensor_to_list(c))

    // Element-wise: D = A + A
    let d = tensor_add(a, a)
    print("D = A + A:")
    print(tensor_to_list(d))

    // Scale: E = A * 10
    let e = tensor_scale(a, 10)
    print("E = A * 10:")
    print(tensor_to_list(e))

    // Reduce: sum of all elements in A = 1+2+3+4+5+6 = 21
    let s = tensor_sum(a)
    print("sum(A) bits (as float):")
    print(s)

    print("")
    print("=== Tiny neural net forward pass ===")
    // Input x: 1x3 vector
    let x = tensor_from_list([1, 2, 3], [1, 3])
    // Weight matrix W1: 3x4
    let w1 = tensor_from_list([1, 0, 1, 0, 0, 1, 0, 1, 1, 1, 1, 1], [3, 4])
    // Bias b1: 1x4
    let b1 = tensor_from_list([0, 0, 0, 0], [1, 4])

    // Layer 1: h = relu(x @ W1 + b1)
    let z1 = tensor_matmul(x, w1)
    let h_raw = tensor_add(z1, b1)
    let h = tensor_relu(h_raw)
    print("hidden activations (1x4):")
    print(tensor_to_list(h))
    // x@W1 = [1*1+2*0+3*1, 1*0+2*1+3*1, 1*1+2*0+3*1, 1*0+2*1+3*1] = [4, 5, 4, 5]
    // After relu: same since all positive
    // Expected: [4, 5, 4, 5]

    print("")
    print("Tensor demo complete.")
