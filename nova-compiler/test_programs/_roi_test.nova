// _roi_test.nova — KAT tests for std/finance/roi
import std/finance/roi

// Helper: float absolute value (abs() returns int in NOVA).
fn float_abs(x: float) -> float
    let result = if x < 0.0
        0.0 - x
    else
        x
    result

// Helper: check two floats within epsilon.
fn ckf(got: float, expected: float, eps: float) -> int
    let diff = got - expected
    let adiff = float_abs(diff)
    let ok = if adiff <= eps
        1
    else
        0
    ok

// KAT 1: roi_simple(1500.0, 1000.0) == 0.5
let v1 = roi_simple(1500.0, 1000.0)
if ckf(v1, 0.5, 0.0001) == 0
    print("FAIL roi_simple(1500,1000): got " + str(v1) + " expected 0.5")
    exit(1)

// KAT 2: roi_cagr(1000.0, 2000.0, 10.0) == 0.0718 (approx)
let v2 = roi_cagr(1000.0, 2000.0, 10.0)
if ckf(v2, 0.0718, 0.0001) == 0
    print("FAIL roi_cagr(1000,2000,10): got " + str(v2) + " expected ~0.0718")
    exit(1)

// KAT 3: roi_cagr(100.0, 100.0, 5.0) == 0.0 (no growth)
let v3 = roi_cagr(100.0, 100.0, 5.0)
if ckf(v3, 0.0, 0.0001) == 0
    print("FAIL roi_cagr(100,100,5): got " + str(v3) + " expected 0.0")
    exit(1)

// KAT 4: roi_payback_period(10000.0, 2500.0) == 4.0
let v4 = roi_payback_period(10000.0, 2500.0)
if ckf(v4, 4.0, 0.0001) == 0
    print("FAIL roi_payback_period(10000,2500): got " + str(v4) + " expected 4.0")
    exit(1)

// KAT 5: roi_annualized(0.5, 3.0) == 0.1447 (approx)
// (1.5)^(1/3) - 1 = 1.14471... - 1 = 0.14471
let v5 = roi_annualized(0.5, 3.0)
if ckf(v5, 0.1447, 0.0001) == 0
    print("FAIL roi_annualized(0.5,3): got " + str(v5) + " expected ~0.1447")
    exit(1)

// KAT 6: roi_simple(900.0, 1000.0) == -0.1 (loss)
// (900 - 1000) / 1000 = -100/1000 = -0.1
let v6 = roi_simple(900.0, 1000.0)
let neg_tenth = 0.0 - 0.1
if ckf(v6, neg_tenth, 0.0001) == 0
    print("FAIL roi_simple(900,1000): got " + str(v6) + " expected -0.1")
    exit(1)

print("_roi_test passed")
