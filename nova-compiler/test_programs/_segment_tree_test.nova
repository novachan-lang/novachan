import std/collections/segment_tree

fn cki(got, expected, label)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn ckb(got, expected, label)
    let gi = 0
    let ei = 0
    if got
        gi = 1
    if expected
        ei = 1
    if gi != ei
        print("FAIL " + label + ": got " + str(gi) + " expected " + str(ei))
        exit(1)

fn main()
    // --- KAT: spec scenario: arr=[1,2,3,4,5] ---
    let arr = []
    arr.push(1)
    arr.push(2)
    arr.push(3)
    arr.push(4)
    arr.push(5)
    let t = seg_build(arr)
    cki(seg_query(t, 0, 4), 15, "query(0,4)=15")
    cki(seg_query(t, 1, 3), 9,  "query(1,3)=9")
    seg_update(t, 2, 10)
    cki(seg_query(t, 0, 4), 22, "after update(2,10): query(0,4)=22")
    cki(seg_query(t, 1, 3), 16, "after update(2,10): query(1,3)=16")
    cki(seg_query(t, 2, 2), 10, "query(2,2)=10")
    cki(seg_query_all(t), 22, "query_all=22")

    // --- single element tree ---
    let a1 = []
    a1.push(7)
    let t1 = seg_build(a1)
    cki(seg_query(t1, 0, 0), 7, "single: query(0,0)=7")
    cki(seg_query_all(t1), 7, "single: query_all=7")
    seg_update(t1, 0, 3)
    cki(seg_query_all(t1), 3, "single: after update(0,3) query_all=3")

    // --- all zeros ---
    let a0 = []
    a0.push(0)
    a0.push(0)
    a0.push(0)
    let t0 = seg_build(a0)
    cki(seg_query_all(t0), 0, "zeros: query_all=0")
    seg_update(t0, 1, 5)
    cki(seg_query_all(t0), 5, "zeros: after update(1,5) query_all=5")
    cki(seg_query(t0, 0, 0), 0, "zeros: query(0,0)=0")
    cki(seg_query(t0, 1, 1), 5, "zeros: query(1,1)=5")

    // --- larger scale correctness ---
    let big = []
    let i = 0
    while i < 8
        big.push(i + 1)
        i = i + 1
    let tb = seg_build(big)
    cki(seg_query_all(tb), 36, "big: sum 1..8=36")
    cki(seg_query(tb, 0, 3), 10, "big: query(0,3)=10")
    cki(seg_query(tb, 4, 7), 26, "big: query(4,7)=26")
    seg_update(tb, 0, 10)
    cki(seg_query_all(tb), 45, "big: after update(0,10) sum=45")
    cki(seg_query(tb, 0, 0), 10, "big: query(0,0)=10 after update")

    print("PASS _segment_tree_test")

main()
