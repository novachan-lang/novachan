import std/math/ts_rolling_min

fn approx(a: float, b: float, tol: float) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < tol
        return 1
    return 0

fn ck_list(label: str, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + " len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        let g = got[i] * 1.0
        let w = want[i] * 1.0
        if approx(g, w, 0.0001) == 0
            print("FAIL " + label + " idx=" + str(i) + " got=" + str(g) + " want=" + str(w))
            exit(1)
        i = i + 1

fn main()
    // KAT 1: basic window=2 on [3.0,1.0,2.0,5.0] -> [1.0,1.0,2.0]
    let d1 = [3.0, 1.0, 2.0, 5.0]
    let r1 = ts_rolling_min(d1, 2)
    let w1 = [1.0, 1.0, 2.0]
    ck_list("rolling_min window2", r1, w1)

    // KAT 2: window == len -> [overall min]
    let d2 = [3.0, 1.0, 2.0, 5.0]
    let r2 = ts_rolling_min(d2, 4)
    let w2 = [1.0]
    ck_list("rolling_min window_eq_len", r2, w2)

    // KAT 3: window == 1 -> data unchanged
    let d3 = [3.0, 1.0, 2.0, 5.0]
    let r3 = ts_rolling_min(d3, 1)
    let w3 = [3.0, 1.0, 2.0, 5.0]
    ck_list("rolling_min window1", r3, w3)

    // KAT 4: window > len -> []
    let d4 = [1.0, 2.0]
    let r4 = ts_rolling_min(d4, 5)
    ck_list("rolling_min window_too_large", r4, [])

    // KAT 5: all equal values
    let d5 = [4.0, 4.0, 4.0]
    let r5 = ts_rolling_min(d5, 2)
    let w5 = [4.0, 4.0]
    ck_list("rolling_min all_equal", r5, w5)

    // KAT 6: descending sequence window=3
    let d6 = [5.0, 4.0, 3.0, 2.0, 1.0]
    let r6 = ts_rolling_min(d6, 3)
    let w6 = [3.0, 2.0, 1.0]
    ck_list("rolling_min descending_w3", r6, w6)

    print("PASS _ts_rolling_min_test")
