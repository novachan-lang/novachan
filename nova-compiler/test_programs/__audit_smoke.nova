type Point
    x: float
    y: float

fn dist2(a: Point, b: Point) -> float
    let dx = a.x - b.x
    let dy = a.y - b.y
    return dx*dx + dy*dy

fn main()
    let p = Point { x: 1.0, y: 2.0 }
    let q = Point { x: 4.0, y: 6.0 }
    print("dist2=" + str(dist2(p, q)))
    let xs = [1, 2, 3, 4, 5]
    let total = 0
    for v in xs
        total = total + v
    print("sum=" + str(total))
