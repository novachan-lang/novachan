// jsonfloat_rt_test — JSON float round-trip + arithmetic on decoded floats.
// json_decode now boxes decoded floats (NovaBox), so json_stringify reads the box
// (was: leaked raw IEEE bits rendered as a giant integer), dict/list reads unbox,
// and the box-aware dynamic add/sub/mul/div compute correctly. Large ints stay int.

fn main()
    let q = chr(34)
    let lb = chr(123)
    let rb = chr(125)

    // scalar + array float round-trip
    assert_eq(json_stringify(json_decode("1.5")), "1.5")
    assert_eq(json_stringify(json_decode("[1.5, 2.5, 3]")), "[1.5,2.5,3]")

    // arithmetic on a decoded (boxed) float
    assert_near(json_decode("1.5") + 1.0, 2.5, 0.0001)
    assert_near(json_decode("2.0") * 3.0, 6.0, 0.0001)

    // object float round-trip
    let obj = lb + q + "pi" + q + ":1.5" + rb
    assert_eq(json_stringify(json_decode(obj)), obj)

    // large integers in JSON stay exact integers (boxing floats must not affect them)
    assert_eq(json_stringify(json_decode("1000000000000000000")), "1000000000000000000")
    assert_eq(json_stringify(json_decode("[1, 2, 3]")), "[1,2,3]")

    print("jsonfloat_rt_test passed")
