import forge_csp

fn main()
    // Single directive
    let d = csp_directive("script-src", ["'self'", "cdn.example.com"])
    assert(d == "script-src 'self' cdn.example.com", "directive format")

    // Build from multiple directives
    let policy = csp_build([["default-src", ["'self'"]], ["script-src", ["'self'", "'nonce-abc'"]]])
    assert(find(policy, "default-src 'self'") >= 0, "has default")
    assert(find(policy, "script-src") >= 0, "has script")
    assert(find(policy, "; ") >= 0, "semicolon separated")

    // Strict preset
    let strict = csp_strict()
    assert(find(strict, "default-src 'self'") >= 0, "strict has default")
    assert(find(strict, "object-src 'none'") >= 0, "strict blocks objects")
    assert(find(strict, "frame-ancestors 'none'") >= 0, "strict blocks framing")

    print("CSP KAT PASS")
