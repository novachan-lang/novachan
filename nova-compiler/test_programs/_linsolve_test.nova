// KAT test for std/numeric/linsolve.nova
// Tests: ls_solve, ls_determinant, ls_is_singular
import std/numeric/linsolve

// ckf — check a float is within eps of expected; FAIL+exit(1) if not
fn ckf(label, got, expected, eps)
    let diff = got - expected
    let adiff = diff
    if diff < 0.0
        let adiff = 0.0 - diff
    if adiff > eps
        print("FAIL: " + label + " got=" + str(got) + " expected=" + str(expected) + " eps=" + str(eps))
        exit(1)

// ckfl — check a float list element is within eps of expected
fn ckfl(label, x, idx, expected, eps)
    let got = x[idx] * 1.0
    let diff = got - expected
    let adiff = diff
    if diff < 0.0
        let adiff = 0.0 - diff
    if adiff > eps
        print("FAIL: " + label + "[" + str(idx) + "] got=" + str(got) + " expected=" + str(expected) + " eps=" + str(eps))
        exit(1)

fn main()
    let eps = 0.001

    // KAT 1: ls_solve([[2,1],[1,3]], [3,5]) = [0.8, 1.4]
    // 2x + y = 3, x + 3y = 5 => x=0.8, y=1.4
    let A1 = [[2.0, 1.0], [1.0, 3.0]]
    let b1 = [3.0, 5.0]
    let x1 = linsolve.ls_solve(A1, b1)
    ckfl("kat1 x[0]", x1, 0, 0.8, eps)
    ckfl("kat1 x[1]", x1, 1, 1.4, eps)

    // KAT 2: ls_solve([[1,0],[0,1]], [3,4]) = [3, 4]  (identity matrix)
    let A2 = [[1.0, 0.0], [0.0, 1.0]]
    let b2 = [3.0, 4.0]
    let x2 = linsolve.ls_solve(A2, b2)
    ckfl("kat2 x[0]", x2, 0, 3.0, eps)
    ckfl("kat2 x[1]", x2, 1, 4.0, eps)

    // KAT 3: ls_determinant([[2,1],[1,3]]) = 2*3 - 1*1 = 5
    let d3 = linsolve.ls_determinant([[2.0, 1.0], [1.0, 3.0]])
    ckf("kat3 det 5.0", d3, 5.0, eps)

    // KAT 4: ls_determinant([[1,2],[2,4]]) = 1*4 - 2*2 = 0  (singular)
    let d4 = linsolve.ls_determinant([[1.0, 2.0], [2.0, 4.0]])
    ckf("kat4 det 0.0", d4, 0.0, eps)

    // KAT 5: ls_is_singular([[1,2],[2,4]]) = true (1)
    let s5 = linsolve.ls_is_singular([[1.0, 2.0], [2.0, 4.0]])
    if s5 != 1
        print("FAIL: kat5 ls_is_singular expected 1 got " + str(s5))
        exit(1)

    // KAT 6: ls_solve 3x3 — [[1,1,1],[0,2,5],[2,5,-1]], b=[6,-4,27] => [5,3,-2]
    let A6 = [[1.0, 1.0, 1.0], [0.0, 2.0, 5.0], [2.0, 5.0, -1.0]]
    let b6 = [6.0, -4.0, 27.0]
    let x6 = linsolve.ls_solve(A6, b6)
    ckfl("kat6 x[0]", x6, 0, 5.0, eps)
    ckfl("kat6 x[1]", x6, 1, 3.0, eps)
    ckfl("kat6 x[2]", x6, 2, -2.0, eps)

    // KAT 7: ls_is_singular on non-singular matrix should return 0
    let s7 = linsolve.ls_is_singular([[2.0, 1.0], [1.0, 3.0]])
    if s7 != 0
        print("FAIL: kat7 ls_is_singular([[2,1],[1,3]]) expected 0 got " + str(s7))
        exit(1)

    // KAT 8: ls_determinant([[3,0],[0,7]]) = 21.0  (diagonal matrix)
    let d8 = linsolve.ls_determinant([[3.0, 0.0], [0.0, 7.0]])
    ckf("kat8 det diagonal 21.0", d8, 21.0, eps)

    print("_linsolve_test passed")
