// forge_jwt_test -- HS256 jwt_encode/jwt_verify (raw-byte sig, B6 fix) + mw_require_auth.
// Tests: roundtrip, wrong-secret, tampered, expired, missing-exp, mw_require_auth, and
// the standard HS256 KAT verifying the signature is base64url NOT hex.
import forge
import forge_crypto

fn me(req: Request) -> string
    let u = req.state["user"]
    u["sub"]

fn main()
    let secret = "topsecret-key"

    // encode -> verify roundtrip
    let claims = {}
    claims["sub"] = "u1"
    claims["role"] = "admin"
    claims["exp"] = 9999999999
    let tok = forge.jwt_encode(claims, secret)
    match forge.jwt_verify(tok, secret)
        Ok(c) =>
            assert(c["sub"] == "u1", "sub claim preserved")
            assert(c["role"] == "admin", "role claim preserved")
            print("PASS: encode/verify roundtrip (sub=" + c["sub"] + ")")
        Err(e) =>
            assert(false, "valid token must verify, got err: " + e)

    // wrong secret -> Err
    match forge.jwt_verify(tok, "other")
        Ok(c2) =>
            assert(false, "wrong secret must not verify")
        Err(e2) =>
            print("PASS: wrong secret -> Err (" + e2 + ")")

    // tampered payload -> Err (signature mismatch)
    let parts = split(tok, ".")
    let tampered = parts[0] + "." + parts[1] + "X" + "." + parts[2]
    match forge.jwt_verify(tampered, secret)
        Ok(c3) =>
            assert(false, "tampered must not verify")
        Err(e3) =>
            print("PASS: tampered -> Err")

    // expired -> Err (use a realistic past timestamp, above the year-2000 plausibility floor)
    let ec = {}
    ec["sub"] = "u1"
    ec["exp"] = 1000000000
    match forge.jwt_verify(forge.jwt_encode(ec, secret), secret)
        Ok(c4) =>
            assert(false, "expired must not verify")
        Err(e4) =>
            assert(e4 == "token expired", "expired reason (" + e4 + ")")
            print("PASS: expired -> Err")

    // missing exp -> Err by default (non-expiring bearer credential is rejected)
    let nc = {}
    nc["sub"] = "u1"
    match forge.jwt_verify(forge.jwt_encode(nc, secret), secret)
        Ok(c5) =>
            assert(false, "missing-exp token must be rejected by default")
        Err(e5) =>
            assert(e5 == "missing exp", "missing-exp reason (" + e5 + ")")
            print("PASS: missing exp -> Err")

    // mw_require_auth guard: valid Bearer -> 200; missing -> 401; bad -> 401
    let a = forge.app()
    forge.use(a, forge.mw_require_auth(secret))
    forge.get(a, "/me", fn(req) me(req))
    let ok = forge.dispatch_test(a, forge.build_request("GET /me HTTP/1.1\r\nAuthorization: Bearer " + tok + "\r\n\r\n", 0))
    assert(forge.status_of(ok) == 200, "valid bearer -> 200 (got " + str(forge.status_of(ok)) + ")")
    assert(forge.body_of(ok) == "u1", "handler body=[" + forge.body_of(ok) + "]")
    let no = forge.dispatch_test(a, forge.mock_request("GET", "/me", ""))
    assert(forge.status_of(no) == 401, "no bearer -> 401")
    let bd = forge.dispatch_test(a, forge.build_request("GET /me HTTP/1.1\r\nAuthorization: Bearer not.a.jwt\r\n\r\n", 0))
    assert(forge.status_of(bd) == 401, "bad bearer -> 401")
    print("PASS: mw_require_auth (200 / 401 / 401)")

    // ── KAT: standard HS256 interop (jwt.io reference vector) ──────────────────────────────────────
    // The jwt.io example token uses:
    //   secret = "your-256-bit-secret"
    //   header = {"alg":"HS256","typ":"JWT"}  -> eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9
    //   payload = {"sub":"1234567890","name":"John Doe","iat":1516239022}
    //             -> eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ
    //   signing_input = header_b64url + "." + payload_b64url
    //   expected sig  = SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c
    //
    // We test the HMAC directly so we are independent of NOVA's json_stringify key order.
    let kat_secret = "your-256-bit-secret"
    let kat_signing_input = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ"
    let kat_expected_sig = "SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c"
    let kat_mac = hmac_sha256_bytes(str_to_blist(kat_secret), str_to_blist(kat_signing_input))
    // b64url of the 32-byte MAC: base64(bytes), then +->- /_-> _, strip =
    let kat_b64 = b64_encode_blist(kat_mac)
    let kat_sig = ""
    let ki = 0
    while ki < len(kat_b64)
        let kch = kat_b64[ki]
        if kch == "+"
            kat_sig = kat_sig + "-"
        else if kch == "/"
            kat_sig = kat_sig + "_"
        else if kch != "="
            kat_sig = kat_sig + kch
        ki = ki + 1
    assert(kat_sig == kat_expected_sig, "KAT sig mismatch: got [" + kat_sig + "] expected [" + kat_expected_sig + "]")
    print("PASS: HS256 KAT sig matches jwt.io reference (" + kat_sig + ")")

    // Also verify the token is NOT hex (a 64-char hex sig would be exactly 64 chars; base64url of 32 bytes
    // is always 43 chars without padding). Confirm we get 43-char segments.
    let tok_parts = split(tok, ".")
    assert(len(tok_parts[2]) == 43, "sig segment must be 43 chars (base64url 32 bytes), got " + str(len(tok_parts[2])))
    print("PASS: sig segment is 43 chars (raw-bytes base64url, not 64-char hex)")

    // Verify a hand-constructed standard token (the jwt.io one, which has a past iat and NO exp) verifies
    // with _jwt_verify_opts(require_exp=false). We call jwt_verify on it but it WILL fail because the
    // standard token has no exp. Instead, test that only the signature check passes by verifying a
    // standard token structure: build it ourselves with exp far in future.
    // (We do not call jwt.io's exact token because it has no exp and require_exp=true by default.)
    // The KAT above already proves the signature bytes are correct; roundtrip is proven above.
    print("PASS: KAT complete")

    print("forge_jwt_test passed")
