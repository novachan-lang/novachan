import std/game/handrank

fn chk(name: string, got: string, want: string)
    if got != want
        print("FAIL handrank " + name + ": got " + got + " want " + want)
        exit(1)

fn main()
    // Royal flush: A K Q J T spades
    let royal = []
    push(royal, [14, 3])
    push(royal, [13, 3])
    push(royal, [12, 3])
    push(royal, [11, 3])
    push(royal, [10, 3])
    chk("royal_flush", classify_poker(royal), "royal_flush")

    // Straight flush: 9 8 7 6 5 spades
    let sf = []
    push(sf, [9, 3])
    push(sf, [8, 3])
    push(sf, [7, 3])
    push(sf, [6, 3])
    push(sf, [5, 3])
    chk("straight_flush", classify_poker(sf), "straight_flush")

    // Four of a kind: 7 7 7 7 2
    let fk = []
    push(fk, [7, 0])
    push(fk, [7, 1])
    push(fk, [7, 2])
    push(fk, [7, 3])
    push(fk, [2, 0])
    chk("four_kind", classify_poker(fk), "four_kind")

    // Full house: 7 7 7 2 2
    let fh = []
    push(fh, [7, 0])
    push(fh, [7, 1])
    push(fh, [7, 2])
    push(fh, [2, 0])
    push(fh, [2, 1])
    chk("full_house", classify_poker(fh), "full_house")

    // Flush: A 9 5 3 2 all spades (non-straight)
    let fl = []
    push(fl, [14, 3])
    push(fl, [5, 3])
    push(fl, [3, 3])
    push(fl, [2, 3])
    push(fl, [9, 3])
    chk("flush", classify_poker(fl), "flush")

    // Straight (wheel): A 2 3 4 5 mixed suits
    let wh = []
    push(wh, [5, 0])
    push(wh, [4, 1])
    push(wh, [3, 2])
    push(wh, [2, 3])
    push(wh, [14, 0])
    chk("straight_wheel", classify_poker(wh), "straight")

    // Three of a kind: 7 7 7 3 2
    let tk = []
    push(tk, [7, 0])
    push(tk, [7, 1])
    push(tk, [7, 2])
    push(tk, [3, 0])
    push(tk, [2, 0])
    chk("three_kind", classify_poker(tk), "three_kind")

    // Two pair: 7 7 2 2 5
    let tp = []
    push(tp, [7, 0])
    push(tp, [7, 1])
    push(tp, [2, 0])
    push(tp, [2, 1])
    push(tp, [5, 0])
    chk("two_pair", classify_poker(tp), "two_pair")

    // Pair: 7 7 3 2 5
    let pr = []
    push(pr, [7, 0])
    push(pr, [7, 1])
    push(pr, [3, 0])
    push(pr, [2, 0])
    push(pr, [5, 0])
    chk("pair", classify_poker(pr), "pair")

    // High card: A 10 7 3 2 mixed suits
    let hc = []
    push(hc, [14, 0])
    push(hc, [10, 1])
    push(hc, [7, 2])
    push(hc, [3, 3])
    push(hc, [2, 0])
    chk("high_card", classify_poker(hc), "high_card")

    // is_flush and is_straight helpers
    if not is_flush(royal)
        print("FAIL handrank is_flush royal: expected true")
        exit(1)
    if is_flush(fk)
        print("FAIL handrank is_flush fk: expected false")
        exit(1)
    if not is_straight(royal)
        print("FAIL handrank is_straight royal: expected true")
        exit(1)
    if not is_straight(wh)
        print("FAIL handrank is_straight wheel: expected true")
        exit(1)
    if is_straight(fk)
        print("FAIL handrank is_straight fk: expected false")
        exit(1)

    print("PASS _handrank_test")
