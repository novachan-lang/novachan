// ============================================================================
// NOVA Standard Library — validate module
// ============================================================================
// A pure-NOVA data-validation toolkit. Every validator inspects a value
// against ONE rule and returns an error string. The convention is:
//
//     ""        -> the value is VALID for this rule
//     "message" -> the value is INVALID; the string is a human error message
//
// This "empty-string-means-ok" convention lets callers chain validators and
// collect the first failure with validate_all(), without exceptions, options,
// or result types — staying within NOVA's current surface while reading like
// plain English.
//
// Regex-based validators use the builtin regex_match(text, pattern) which
// returns 1 on (substring) match and 0 otherwise. The engine supports
// char classes [a-z], +, ., ^, $ and escaped literals like \. (a literal
// dot). It is CASE-SENSITIVE and does NOT support {n} repetition counts, so
// the email pattern is written without {n} and uses lowercase classes.
//
// Public API:
//   v_required, v_min_len, v_max_len, v_int_range,
//   v_pattern, v_email, v_one_of, validate_all

// ── presence ────────────────────────────────────────────────────────────────
// Valid when the value is "present". A value is ABSENT (-> "required") when it
// is null, the empty string "", or — owing to NOVA's value model — the integer
// 0 / boolean false, which share null's all-zero representation and so cannot
// be distinguished from null. This gives v_required JS/PHP-style "truthiness":
// null, "", 0 and false are blank; any non-zero int, any non-empty string, and
// any list/dict/struct are present.
//
// IMPORTANT (NOVA value-model limitation): null == 0 == false at the bit level
// (is_null(x) is literally x == 0), so there is NO way to treat the integer 0
// as present while treating null as absent — they are identical values.
//
// We guard the empty-string check behind type_of(value) == "string" because
// comparing a NON-zero int directly to "" (e.g. 42 == "") DEREFERENCES the int
// as a string pointer and SEGFAULTS. Checking the type first keeps it sound.

fn v_required(value) -> str
    if is_null(value)
        return "required"
    if type_of(value) == "string"
        if value == ""
            return "required"
    ""

// ── string length ────────────────────────────────────────────────────────────
// Inclusive bounds. v_min_len requires len(s) >= n; v_max_len requires
// len(s) <= n. Both assume s is a string (the documented contract).

fn v_min_len(s, n) -> str
    if len(s) < n
        return "too short"
    ""

fn v_max_len(s, n) -> str
    if len(s) > n
        return "too long"
    ""

// ── integer range ─────────────────────────────────────────────────────────────
// Inclusive: valid when lo <= n <= hi.

fn v_int_range(n, lo, hi) -> str
    if n < lo
        return "out of range"
    if n > hi
        return "out of range"
    ""

// ── regex pattern ─────────────────────────────────────────────────────────────
// Valid when the pattern matches (regex_match returns 1). Note the engine
// does substring matching, so anchor with ^...$ in the pattern when a full
// match is required (as v_email does).

fn v_pattern(s, regex_pattern) -> str
    if regex_match(s, regex_pattern) == 1
        return ""
    "pattern mismatch"

// ── email ──────────────────────────────────────────────────────────────────────
// A deliberately BASIC, anchored email check: one-or-more local-part chars,
// an '@', a domain, a literal '.', and a one-or-more-char TLD. This rejects
// "nope" (no @) and "a@bco" (no dot) while accepting "a@b.co". It is
// case-sensitive (lowercase classes) by design — full RFC 5321 validation is
// out of scope for a "basic" check.

fn v_email(s) -> str
    let pat = "^[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]+$"
    let err = v_pattern(s, pat)
    if err == ""
        return ""
    "invalid email"

// ── membership ─────────────────────────────────────────────────────────────────
// Valid when s equals one of the entries in options_list (by ==). The value
// and the options must be the SAME kind (all strings, or all ints): comparing
// a string to an int via == is unsound in NOVA and would crash, so callers
// must keep the candidate and the options homogeneous.

fn v_one_of(s, options_list) -> str
    let i = 0
    while i < len(options_list)
        if options_list[i] == s
            return ""
        i = i + 1
    "not allowed"

// ── aggregation ────────────────────────────────────────────────────────────────
// Given a list of already-computed error strings, return the FIRST non-empty
// one (fail-fast), or "" when every check passed.

fn validate_all(checks_list) -> str
    let i = 0
    while i < len(checks_list)
        let e = checks_list[i]
        if e != ""
            return e
        i = i + 1
    ""

// ── tests ────────────────────────────────────────────────────────────────────

fn main()
    // ---- v_required ----
    assert_eq(v_required(""), "required")
    assert_eq(v_required("x"), "")
    assert_eq(v_required("hello"), "")
    assert_eq(v_required(null), "required")
    // NOVA value-model: 0 / false / null are the SAME all-zero value, so 0 is
    // treated as absent (truthiness semantics). Non-zero ints are present.
    assert_eq(v_required(0), "required")
    assert_eq(v_required(42), "")
    assert_eq(v_required(-1), "")

    // ---- v_min_len ----
    assert_eq(v_min_len("ab", 3), "too short")
    assert_eq(v_min_len("abc", 3), "")
    assert_eq(v_min_len("abcd", 3), "")
    assert_eq(v_min_len("", 1), "too short")
    assert_eq(v_min_len("", 0), "")

    // ---- v_max_len ----
    assert_eq(v_max_len("abcd", 3), "too long")
    assert_eq(v_max_len("abc", 3), "")
    assert_eq(v_max_len("ab", 3), "")
    assert_eq(v_max_len("", 0), "")

    // ---- v_int_range ----
    assert_eq(v_int_range(5, 1, 10), "")
    assert_eq(v_int_range(1, 1, 10), "")
    assert_eq(v_int_range(10, 1, 10), "")
    assert_eq(v_int_range(0, 1, 10), "out of range")
    assert_eq(v_int_range(11, 1, 10), "out of range")
    assert_eq(v_int_range(-5, -10, -1), "")
    assert_eq(v_int_range(-11, -10, -1), "out of range")

    // ---- v_pattern ----
    assert_eq(v_pattern("abc123", "[0-9]+"), "")
    assert_eq(v_pattern("abcdef", "[0-9]+"), "pattern mismatch")
    assert_eq(v_pattern("hello", "^hello$"), "")
    assert_eq(v_pattern("hello world", "^hello$"), "pattern mismatch")

    // ---- v_email ----
    assert_eq(v_email("a@b.co"), "")
    assert_eq(v_email("user.name+tag@example.com"), "")
    assert_eq(v_email("nope"), "invalid email")
    assert_eq(v_email("a@bco"), "invalid email")
    assert_eq(v_email(""), "invalid email")
    assert_eq(v_email("@b.co"), "invalid email")
    assert_eq(v_email("a@.co"), "invalid email")

    // ---- v_one_of ----
    let opts = ["red", "green", "blue"]
    assert_eq(v_one_of("red", opts), "")
    assert_eq(v_one_of("green", opts), "")
    assert_eq(v_one_of("blue", opts), "")
    assert_eq(v_one_of("yellow", opts), "not allowed")
    assert_eq(v_one_of("", opts), "not allowed")
    // integer membership works too (== over a mixed list)
    let nums = [1, 2, 3]
    assert_eq(v_one_of(2, nums), "")
    assert_eq(v_one_of(9, nums), "not allowed")

    // ---- validate_all ----
    // all pass -> ""
    let ok = [v_required("Ada"), v_min_len("Ada", 2), v_max_len("Ada", 10)]
    assert_eq(validate_all(ok), "")
    // first failure is returned (fail-fast), later failures ignored
    let bad = [v_required("Ada"), v_min_len("Ada", 5), v_max_len("Ada", 2)]
    assert_eq(validate_all(bad), "too short")
    // empty list -> "" (vacuously valid)
    let none = []
    assert_eq(validate_all(none), "")
    // a single leading failure short-circuits
    let lead = [v_required(""), v_min_len("x", 1)]
    assert_eq(validate_all(lead), "required")

    // ---- realistic form: validate a username + age + role ----
    let username = "alice"
    let age = 30
    let role = "admin"
    let roles = ["admin", "user", "guest"]
    let form = [v_required(username), v_min_len(username, 3), v_max_len(username, 20), v_int_range(age, 13, 120), v_one_of(role, roles)]
    assert_eq(validate_all(form), "")
    // now break the age and confirm it surfaces
    let bad_age = 200
    let form2 = [v_required(username), v_min_len(username, 3), v_int_range(bad_age, 13, 120), v_one_of(role, roles)]
    assert_eq(validate_all(form2), "out of range")

    print("validate ok")
