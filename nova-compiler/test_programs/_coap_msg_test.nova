// KAT for std/net/coap_msg — RFC 7252 CoAP header + token codec.
import std/net/coap_msg

fn cki(label, got, want)
    if got != want
        print("FAIL coap_msg " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── Vector 1: coap_msg(1,0,1,0x1234,[]) ─────────────────────────────────
    // ver=1, type=CON(0), code=1(GET), msg_id=0x1234, token=[]
    // byte0 = (1<<6)|(0<<4)|0 = 0x40
    // byte1 = 1
    // byte2 = 0x12
    // byte3 = 0x34
    let tok0 = []
    let enc1 = coap_msg(1, 0, 1, 0x1234, tok0)
    cki("v1_len",  len(enc1), 4)
    cki("v1_b0",   enc1[0],   0x40)
    cki("v1_b1",   enc1[1],   1)
    cki("v1_b2",   enc1[2],   0x12)
    cki("v1_b3",   enc1[3],   0x34)

    // ── Vector 2: coap_msg(1,0,1,5,[0xAB]) ──────────────────────────────────
    // ver=1, type=CON(0), code=1(GET), msg_id=5, token=[0xAB]
    // byte0 = (1<<6)|(0<<4)|1 = 0x41
    // byte1 = 1
    // byte2 = 0x00 (5>>8 = 0)
    // byte3 = 0x05
    // byte4 = 0xAB (token)
    let tok1 = [0xAB]
    let enc2 = coap_msg(1, 0, 1, 5, tok1)
    cki("v2_len",  len(enc2), 5)
    cki("v2_b0",   enc2[0],   0x41)
    cki("v2_b1",   enc2[1],   1)
    cki("v2_b2",   enc2[2],   0x00)
    cki("v2_b3",   enc2[3],   0x05)
    cki("v2_b4",   enc2[4],   0xAB)

    // ── Vector 3: NON message (type=1) with 2-byte token ────────────────────
    // ver=1, type=NON(1), code=2(POST), msg_id=0xABCD, token=[0x11,0x22]
    // byte0 = (1<<6)|(1<<4)|2 = 0x40|0x10|0x02 = 0x52
    let tok2 = [0x11, 0x22]
    let enc3 = coap_msg(1, 1, 2, 0xABCD, tok2)
    cki("v3_len",  len(enc3), 6)
    cki("v3_b0",   enc3[0],   0x52)
    cki("v3_b1",   enc3[1],   2)
    cki("v3_b2",   enc3[2],   0xAB)
    cki("v3_b3",   enc3[3],   0xCD)
    cki("v3_b4",   enc3[4],   0x11)
    cki("v3_b5",   enc3[5],   0x22)

    // ── Vector 4: ACK message (type=2) ──────────────────────────────────────
    // ver=1, type=ACK(2), code=0x45 (2.05 Content), msg_id=0x0001, no token
    // byte0 = (1<<6)|(2<<4)|0 = 0x40|0x20|0x00 = 0x60
    let tok3 = []
    let enc4 = coap_msg(1, 2, 0x45, 1, tok3)
    cki("v4_len",  len(enc4), 4)
    cki("v4_b0",   enc4[0],   0x60)
    cki("v4_b1",   enc4[1],   0x45)
    cki("v4_b2",   enc4[2],   0x00)
    cki("v4_b3",   enc4[3],   0x01)

    // ── Round-trip decode: encode then decode, verify all fields ─────────────
    // Use vector 2: ver=1,type=0,code=1,msg_id=5,token=[0xAB]
    let tok1b = [0xAB]
    let enc5 = coap_msg(1, 0, 1, 5, tok1b)
    let dec5 = coap_msg_decode(enc5)
    cki("rt_ver",   dec5["ver"],    1)
    cki("rt_type",  dec5["type"],   0)
    cki("rt_code",  dec5["code"],   1)
    cki("rt_mid",   dec5["msg_id"], 5)
    let dt = dec5["token"]
    cki("rt_tkl",   len(dt),        1)
    cki("rt_tok0",  dt[0],          0xAB)

    // ── Round-trip decode: vector 3 ──────────────────────────────────────────
    let tok2b = [0x11, 0x22]
    let enc6 = coap_msg(1, 1, 2, 0xABCD, tok2b)
    let dec6 = coap_msg_decode(enc6)
    cki("rt3_ver",  dec6["ver"],    1)
    cki("rt3_type", dec6["type"],   1)
    cki("rt3_code", dec6["code"],   2)
    cki("rt3_mid",  dec6["msg_id"], 0xABCD)
    let dt3 = dec6["token"]
    cki("rt3_tkl",  len(dt3),       2)
    cki("rt3_tok0", dt3[0],         0x11)
    cki("rt3_tok1", dt3[1],         0x22)

    // ── Short input decode returns empty dict (no crash) ─────────────────────
    let short_bl = [0x40, 0x01]
    let dec_short = coap_msg_decode(short_bl)
    // Should return {} — verify doesn't contain "ver": missing key = 0
    // A valid ver is always 1, so 0 means the key was absent (empty dict)
    cki("short_ver_absent", dec_short["ver"], 0)

    // ── RST message (type=3) ─────────────────────────────────────────────────
    // ver=1, type=RST(3), code=0, msg_id=0xFFFF, no token
    // byte0 = (1<<6)|(3<<4)|0 = 0x40|0x30 = 0x70
    let tok4 = []
    let enc7 = coap_msg(1, 3, 0, 0xFFFF, tok4)
    cki("v7_len",  len(enc7), 4)
    cki("v7_b0",   enc7[0],   0x70)
    cki("v7_b1",   enc7[1],   0x00)
    cki("v7_b2",   enc7[2],   0xFF)
    cki("v7_b3",   enc7[3],   0xFF)

    print("PASS _coap_msg_test")
