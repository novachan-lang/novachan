import forge_hammingcode

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn joinl(xs: list) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        out = out + str(xs[i])
        i = i + 1
    out

fn main()
    let fails = 0

    // encode a known value
    fails = fails + expect("enc_1011", joinl(ham_encode([1, 0, 1, 1])), "0110011")

    // clean round-trip for ALL 16 data patterns
    let allok = 1
    let n = 0
    while n < 16
        let d = []
        push(d, (n >> 3) & 1)
        push(d, (n >> 2) & 1)
        push(d, (n >> 1) & 1)
        push(d, n & 1)
        let code = ham_encode(d)
        let dec = ham_decode(code)
        if joinl(dec[0]) != joinl(d)
            allok = 0
        if dec[1] != 0
            allok = 0
        n = n + 1
    fails = fails + expect("roundtrip_all16", str(allok), "1")

    // single-error correction at EVERY position for one codeword
    let data = [1, 0, 1, 1]
    let code = ham_encode(data)
    let correctok = 1
    let pos = 0
    while pos < 7
        // corrupt bit at pos
        let corrupt = []
        let k = 0
        while k < 7
            if k == pos
                push(corrupt, code[k] ^ 1)
            else
                push(corrupt, code[k])
            k = k + 1
        let dec = ham_decode(corrupt)
        // data must be recovered, and error position reported = pos+1
        if joinl(dec[0]) != joinl(data)
            correctok = 0
        if dec[1] != pos + 1
            correctok = 0
        pos = pos + 1
    fails = fails + expect("correct_all_positions", str(correctok), "1")

    // clean decode reports error position 0
    let dec0 = ham_decode(ham_encode([0, 1, 1, 0]))
    fails = fails + expect("clean_syndrome", str(dec0[1]), "0")
    fails = fails + expect("clean_data", joinl(dec0[0]), "0110")

    // ham_data convenience
    fails = fails + expect("ham_data", joinl(ham_data(ham_encode([1, 1, 0, 1]))), "1101")

    // single error in a specific position (5) recovers
    let c5 = ham_encode([1, 0, 1, 1])
    c5[4] = c5[4] ^ 1
    let d5 = ham_decode(c5)
    fails = fails + expect("err_pos5", str(d5[1]), "5")
    fails = fails + expect("err_pos5_data", joinl(d5[0]), "1011")

    if fails == 0
        print("forge_hammingcode: all passed")
    else
        print("forge_hammingcode: " + str(fails) + " FAILED")
