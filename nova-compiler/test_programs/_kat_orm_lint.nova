// Positive test for the compile-time SQL portability lint (W2001).
// A local orm_all stub avoids needing a real DB connection -- the lint fires purely off the
// literal SQL string text passed to a typed orm_all/orm_rows/orm_row/orm_one call, matched
// by function name, so a same-named local stub still triggers it (see typedlist_field_slot_test.nova
// for the same shadowing pattern).
fn orm_all(db, sql: string, params) -> list
    []

type Wl
    id: int
    name: string

fn main()
    let xs: list<Wl> = orm_all(0, "SELECT id, name FROM Wl WHERE name ILIKE 'a'", [])
    print("compiled ok: {len(xs)}")
