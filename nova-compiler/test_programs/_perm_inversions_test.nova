import std/permutation/perm_inversions

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got " + gs + " want " + ws)
        exit(1)

fn ckl(label: string, got, want)
    let ng = len(got)
    let nw = len(want)
    if ng != nw
        print("FAIL " + label + ": length " + str(ng) + " want " + str(nw))
        exit(1)
    let i = 0
    while i < ng
        if got[i] != want[i]
            print("FAIL " + label + "[" + str(i) + "]: got " + str(got[i]) + " want " + str(want[i]))
            exit(1)
        i = i + 1

fn cknest(label: string, got, want)
    let ng = len(got)
    let nw = len(want)
    if ng != nw
        print("FAIL " + label + ": outer length " + str(ng) + " want " + str(nw))
        exit(1)
    let i = 0
    while i < ng
        let gi = got[i]
        let wi = want[i]
        if len(gi) != len(wi)
            print("FAIL " + label + "[" + str(i) + "]: inner length " + str(len(gi)) + " want " + str(len(wi)))
            exit(1)
        let j = 0
        while j < len(gi)
            if gi[j] != wi[j]
                print("FAIL " + label + "[" + str(i) + "][" + str(j) + "]: got " + str(gi[j]) + " want " + str(wi[j]))
                exit(1)
            j = j + 1
        i = i + 1

fn main()
    // pinv_count tests
    cki("count([2,0,1])", pinv_count([2, 0, 1]), 2)
    cki("count([0,1,2])", pinv_count([0, 1, 2]), 0)
    cki("count([2,1,0])", pinv_count([2, 1, 0]), 3)
    cki("count([1,0,3,2])", pinv_count([1, 0, 3, 2]), 2)

    // pinv_is_sorted tests
    ckb("sorted([0,1,2,3])", pinv_is_sorted([0, 1, 2, 3]), true)
    ckb("sorted([1,0])", pinv_is_sorted([1, 0]), false)
    ckb("sorted([0,1,2])", pinv_is_sorted([0, 1, 2]), true)
    ckb("sorted([2,1,0])", pinv_is_sorted([2, 1, 0]), false)

    // pinv_list: [2,0,1] inversions: (0,1) p[0]=2>p[1]=0; (0,2) p[0]=2>p[2]=1 -> [[0,1],[0,2]]
    let p201 = [2, 0, 1]
    let pairs201 = pinv_list(p201)
    let exp201 = []
    let p01 = []
    push(p01, 0)
    push(p01, 1)
    push(exp201, p01)
    let p02 = []
    push(p02, 0)
    push(p02, 2)
    push(exp201, p02)
    cknest("list([2,0,1])", pairs201, exp201)

    // [0,1,2]: no inversions -> []
    let p012 = [0, 1, 2]
    let pairs012 = pinv_list(p012)
    let exp012 = []
    cknest("list([0,1,2])", pairs012, exp012)

    // [2,1,0]: inversions (0,1),(0,2),(1,2)
    let p210 = [2, 1, 0]
    let pairs210 = pinv_list(p210)
    let exp210 = []
    let pa = []
    push(pa, 0)
    push(pa, 1)
    push(exp210, pa)
    let pb = []
    push(pb, 0)
    push(pb, 2)
    push(exp210, pb)
    let pc = []
    push(pc, 1)
    push(pc, 2)
    push(exp210, pc)
    cknest("list([2,1,0])", pairs210, exp210)

    print("PASS _perm_inversions_test")
