import forge_data_catalog

fn main()
    let dc = dc_new()
    dc = dc_register(dc, "users", "team-a", "User profiles")
    dc = dc_register(dc, "orders", "team-b", "Purchase orders")
    assert(dc_dataset_count(dc) == 2, "2 datasets")

    dc = dc_add_tag(dc, "users", "pii")
    dc = dc_add_tag(dc, "users", "core")
    dc = dc_add_tag(dc, "orders", "financial")
    dc = dc_add_tag(dc, "orders", "core")

    dc = dc_add_column(dc, "users", "id", "int")
    dc = dc_add_column(dc, "users", "email", "string")
    dc = dc_add_column(dc, "users", "name", "string")
    assert(dc_column_count(dc, "users") == 3, "3 columns")

    dc = dc_add_lineage(dc, "orders", "users")
    let ds = dc_get(dc, "orders")
    assert(ds["owner"] == "team-b", "orders owner")
    assert(len(ds["lineage"]) == 1, "1 lineage source")

    let pii = dc_search_tag(dc, "pii")
    assert(len(pii) == 1, "1 pii dataset")

    let core = dc_search_tag(dc, "core")
    assert(len(core) == 2, "2 core datasets")

    let missing = dc_get(dc, "nonexistent")
    assert(missing["owner"] == "", "missing = empty")
    assert(dc_column_count(dc, "nonexistent") == 0, "no columns")

    print("DATA-CATALOG KAT PASS")
