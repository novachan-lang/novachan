// Self-test for the deflatex library (moved out of deflatex.nova when it became a pure
// importable module). Exercises deflate/inflate roundtrip, gzip, and the dynamic-Huffman
// inflate of a REAL .gz produced by .NET GZipStream (BTYPE=2).
import deflatex

fn roundtrip(s)
    return deflatex.byte_list_to_str(deflatex.inflate(deflatex.deflate(deflatex.str_to_byte_list(s))))

fn main()
    let msg = "the quick brown fox jumps over the lazy dog. the quick brown fox."
    assert_eq(roundtrip(msg), msg)
    let rep = "abcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabc"
    assert_eq(roundtrip(rep), rep)
    let comp = deflatex.deflate(deflatex.str_to_byte_list(rep))
    let shrank = 0
    if len(comp) < len(rep)
        shrank = 1
    assert_eq(shrank, 1)
    assert_eq(roundtrip("aaaaaaaaaaaaaaaaaaaaaaaa"), "aaaaaaaaaaaaaaaaaaaaaaaa")
    assert_eq(roundtrip(""), "")
    assert_eq(roundtrip("x"), "x")
    assert_eq(roundtrip("ab"), "ab")
    let txt = "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Lorem ipsum dolor."
    assert_eq(roundtrip(txt), txt)
    let gz = deflatex.gzip_compress(deflatex.str_to_byte_list(msg))
    assert_eq(gz[0], 31)
    assert_eq(gz[1], 139)
    assert_eq(gz[2], 8)
    assert_eq(deflatex.byte_list_to_str(deflatex.gzip_decompress(gz)), msg)
    let isz = gz[len(gz) - 4] + gz[len(gz) - 3] * 256 + gz[len(gz) - 2] * 65536 + gz[len(gz) - 1] * 16777216
    assert_eq(isz, len(msg))
    let grep = deflatex.gzip_compress(deflatex.str_to_byte_list(rep))
    assert_eq(deflatex.byte_list_to_str(deflatex.gzip_decompress(grep)), rep)
    // DYNAMIC-Huffman inflate: a REAL .gz from .NET GZipStream (BTYPE=2 -- what real gzip/zlib
    // emit). The pre-iter-69 fixed-only inflate could NOT decode this.
    let dyn_expected = "The quick brown fox jumps over the lazy dog. Pack my box with five dozen liquor jugs. How vexingly quick daft zebras jump! Sphinx of black quartz, judge my vow. The five boxing wizards jump quickly. Compression of varied English text forces a dynamic Huffman block."
    let dyn_gz = [31,139,8,0,0,0,0,0,4,0,45,143,75,110,195,48,12,68,175,50,221,23,186,68,81,32,203,0,205,5,100,139,178,213,72,162,173,159,45,157,190,116,210,245,12,223,27,62,86,194,94,221,252,196,148,248,136,176,124,226,183,134,45,131,27,37,20,137,189,30,29,134,23,133,187,150,94,232,152,164,116,184,178,194,186,70,18,13,138,240,110,175,156,228,118,201,10,55,62,208,232,116,113,241,253,31,111,180,45,24,52,37,157,95,130,15,252,108,171,139,39,216,98,242,23,120,175,58,149,241,41,169,89,232,210,52,62,20,30,178,224,165,17,169,240,196,59,116,50,111,198,27,237,187,194,23,135,45,81,206,142,227,5,108,58,57,50,248,22,191,203,43,10,157,69,62,75,51,101,104,152,30,117,112,51,110,213,218,160,163,216,121,126,170,63,104,116,248,197,9,1,0,0]
    assert_eq(deflatex.byte_list_to_str(deflatex.gzip_decompress(dyn_gz)), dyn_expected)
    print("deflatex_test passed (roundtrip + gzip + dynamic-Huffman inflate; library import ok)")
