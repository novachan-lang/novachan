// KAT for std/physics/circuits_dc — Ohm's law, power, series/parallel resistance.
import std/physics/circuits_dc

// approx — float equality within 0.001 tolerance.
fn approx(a, b)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < 0.001

fn main()
    // KAT 1: ohms_v(2.0, 5.0) = 10.0
    let v = ohms_v(2.0, 5.0)
    if not approx(v, 10.0)
        print("FAIL circuits_dc ohms_v(2,5): got=" + str(v) + " want=10.0")
        exit(1)

    // KAT 2: ohms_v(0.0, 100.0) = 0.0
    let v0 = ohms_v(0.0, 100.0)
    if not approx(v0, 0.0)
        print("FAIL circuits_dc ohms_v(0,100): got=" + str(v0) + " want=0.0")
        exit(1)

    // KAT 3: ohms_i(10.0, 5.0) = 2.0
    let cur = ohms_i(10.0, 5.0)
    if not approx(cur, 2.0)
        print("FAIL circuits_dc ohms_i(10,5): got=" + str(cur) + " want=2.0")
        exit(1)

    // KAT 4: ohms_i(12.0, 4.0) = 3.0
    let cur2 = ohms_i(12.0, 4.0)
    if not approx(cur2, 3.0)
        print("FAIL circuits_dc ohms_i(12,4): got=" + str(cur2) + " want=3.0")
        exit(1)

    // KAT 5: power_vi(10.0, 2.0) = 20.0
    let p = power_vi(10.0, 2.0)
    if not approx(p, 20.0)
        print("FAIL circuits_dc power_vi(10,2): got=" + str(p) + " want=20.0")
        exit(1)

    // KAT 6: power_vi(5.0, 3.0) = 15.0
    let p2 = power_vi(5.0, 3.0)
    if not approx(p2, 15.0)
        print("FAIL circuits_dc power_vi(5,3): got=" + str(p2) + " want=15.0")
        exit(1)

    // KAT 7: series_resistance([1.0, 2.0, 3.0]) = 6.0
    let rs = [1.0, 2.0, 3.0]
    let sr = series_resistance(rs)
    if not approx(sr, 6.0)
        print("FAIL circuits_dc series_resistance([1,2,3]): got=" + str(sr) + " want=6.0")
        exit(1)

    // KAT 8: series_resistance([10.0, 20.0, 30.0, 40.0]) = 100.0
    let rs2 = [10.0, 20.0, 30.0, 40.0]
    let sr2 = series_resistance(rs2)
    if not approx(sr2, 100.0)
        print("FAIL circuits_dc series_resistance([10,20,30,40]): got=" + str(sr2) + " want=100.0")
        exit(1)

    // KAT 9: parallel_two(2.0, 2.0) = 1.0
    let pt = parallel_two(2.0, 2.0)
    if not approx(pt, 1.0)
        print("FAIL circuits_dc parallel_two(2,2): got=" + str(pt) + " want=1.0")
        exit(1)

    // KAT 10: parallel_two(4.0, 4.0) = 2.0
    let pt2 = parallel_two(4.0, 4.0)
    if not approx(pt2, 2.0)
        print("FAIL circuits_dc parallel_two(4,4): got=" + str(pt2) + " want=2.0")
        exit(1)

    // KAT 11: parallel_two(6.0, 3.0) = 2.0
    let pt3 = parallel_two(6.0, 3.0)
    if not approx(pt3, 2.0)
        print("FAIL circuits_dc parallel_two(6,3): got=" + str(pt3) + " want=2.0")
        exit(1)

    // KAT 12: Ohm's law round-trip: ohms_i(ohms_v(I,R), R) == I
    let i_orig = 3.5
    let r_orig = 7.0
    let v_rt = ohms_v(i_orig, r_orig)
    let i_rt = ohms_i(v_rt, r_orig)
    if not approx(i_rt, i_orig)
        print("FAIL circuits_dc Ohm round-trip: got=" + str(i_rt) + " want=" + str(i_orig))
        exit(1)

    print("PASS _circuits_dc_test")
