import forge_bignum

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // add
    fails = fails + expect("add_carry", big_add("999", "1"), "1000")
    fails = fails + expect("add_zero", big_add("0", "0"), "0")
    fails = fails + expect("add_diff_len", big_add("12345678901234567890", "9876543210"), "12345678911111111100")
    fails = fails + expect("add_norm", big_add("007", "003"), "10")

    // subtract (a >= b)
    fails = fails + expect("sub_borrow", big_sub("1000", "1"), "999")
    fails = fails + expect("sub_eq", big_sub("100", "100"), "0")
    fails = fails + expect("sub_big", big_sub("10000000000000000000", "1"), "9999999999999999999")

    // compare
    fails = fails + expect("cmp_gt", str(big_cmp("100", "99")), "1")
    fails = fails + expect("cmp_lt", str(big_cmp("99", "100")), "-1")
    fails = fails + expect("cmp_eq", str(big_cmp("50", "50")), "0")
    fails = fails + expect("cmp_normeq", str(big_cmp("0050", "50")), "0")
    fails = fails + expect("cmp_samelen", str(big_cmp("523", "531")), "-1")

    // multiply
    fails = fails + expect("mul_basic", big_mul("123", "456"), "56088")
    fails = fails + expect("mul_zero", big_mul("999999", "0"), "0")
    fails = fails + expect("mul_one", big_mul("123456789", "1"), "123456789")
    // 20 nines squared -> overflows i64 easily
    fails = fails + expect("mul_bignines", big_mul("99999999999999999999", "99999999999999999999"), "9999999999999999999800000000000000000001")

    // factorial (exact, beyond i64 for n>20)
    fails = fails + expect("fact_20", big_factorial(20), "2432902008176640000")
    fails = fails + expect("fact_25", big_factorial(25), "15511210043330985984000000")
    fails = fails + expect("fact_0", big_factorial(0), "1")
    fails = fails + expect("fact_50", big_factorial(50), "30414093201713378043612608166064768844377641568960512000000000000")

    // power (fast exponentiation)
    fails = fails + expect("pow_2_100", big_pow("2", 100), "1267650600228229401496703205376")
    fails = fails + expect("pow_2_0", big_pow("2", 0), "1")
    fails = fails + expect("pow_10_20", big_pow("10", 20), "100000000000000000000")
    fails = fails + expect("pow_3_40", big_pow("3", 40), "12157665459056928801")

    // cross-check: (10^20) computed two ways agrees
    fails = fails + expect("crosscheck", str(big_cmp(big_pow("10", 20), big_add("99999999999999999999", "1"))), "0")

    if fails == 0
        print("forge_bignum: all passed")
    else
        print("forge_bignum: " + str(fails) + " FAILED")
