fn build_strings(n: int) -> int
    let xs = []
    let i = 0
    while i < n
        xs.push("element_" + str(i))
        i = i + 1
    len(xs)

fn main()
    set_arena_mode(1)
    let total = 0
    let k = 0
    while k < 50
        total = total + build_strings(100)
        k = k + 1
    print(total)
    rc_stats_dump()
