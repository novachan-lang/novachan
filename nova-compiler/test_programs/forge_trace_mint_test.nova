// Forge T8.8 (mint): mint_trace_id produces a fresh 32-hex correlation id when a request has no
// inbound traceparent; it round-trips through parse_traceparent. Socketless, deterministic.
import forge_obs

fn main()
    let id1 = mint_trace_id()
    let id2 = mint_trace_id()
    if len(id1) != 32 or len(id2) != 32
        print("FAIL: minted ids must be 32 hex, got " + str(len(id1)) + "," + str(len(id2)))
        exit(1)
    if id1 == id2
        print("FAIL: two minted ids should differ (uniqueness)")
        exit(1)
    // a minted id is a valid trace_id: build a traceparent with it and parse it back
    let header = "00-" + id1 + "-b7ad6b7169203331-01"
    if parse_traceparent(header) != id1
        print("FAIL: minted id should round-trip through parse_traceparent, got " + parse_traceparent(header))
        exit(1)
    print("PASS forge_trace_mint (32-hex unique trace_id; round-trips through parse_traceparent)")
