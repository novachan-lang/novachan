// starts_with / ends_with
path = "/usr/bin/nova"
print(path.starts_with("/usr"))
print(path.starts_with("/etc"))
print(path.ends_with("nova"))
print(path.ends_with(".exe"))

// find
msg = "hello world"
print(msg.find("world"))
print(msg.find("xyz"))

// chars
word = "NOVA"
letters = word.chars()
for ch in letters
    print(ch)

// join
parts = ["hello", "beautiful", "world"]
print(parts.join(" "))
print(parts.join("-"))

// combined: split then join
csv = "a,b,c,d"
items = csv.split(",")
print(items.join(" | "))
