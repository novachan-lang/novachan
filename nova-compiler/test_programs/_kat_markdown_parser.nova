import forge_markdown_parser

fn main()
    let m = md_new()
    m = md_add_heading(m, 1, "Title")
    m = md_add_paragraph(m, "Some text here.")
    m = md_add_heading(m, 2, "Section")
    m = md_add_code(m, "nova", "let x = 42")
    assert(md_block_count(m) == 4, "4 blocks")
    assert(md_heading_count(m) == 2, "2 headings")

    let t0 = md_block_type(m, 0)
    assert(is_ok(t0), "type ok")
    assert(unwrap(t0) == "heading", "block 0=heading")

    let t1 = md_block_text(m, 1)
    assert(unwrap(t1) == "Some text here.", "paragraph text")

    let t3 = md_block_type(m, 3)
    assert(unwrap(t3) == "code", "block 3=code")

    let bad = md_block_type(m, 99)
    assert(is_err(bad), "out of range is err")

    print("MARKDOWN-PARSER KAT PASS")
