import std/game/nim

fn chk_int(name: string, got: int, want: int)
    if got != want
        print("FAIL nim " + name + ": got " + str(got) + " want " + str(want))
        exit(1)

fn chk_bool(name: string, got: bool, want: bool)
    let gs = "false"
    if got
        gs = "true"
    let ws = "false"
    if want
        ws = "true"
    if got != want
        print("FAIL nim " + name + ": got " + gs + " want " + ws)
        exit(1)

fn mk_heaps(a: int, b: int, c: int) -> list
    let h = []
    push(h, a)
    push(h, b)
    push(h, c)
    h

fn test_nim_xor_zero()
    // 1 XOR 2 XOR 3 = 0
    let h = mk_heaps(1, 2, 3)
    chk_int("xor_123", nim_xor(h), 0)

fn test_nim_xor_nonzero()
    // 1 XOR 2 XOR 4 = 7
    let h = mk_heaps(1, 2, 4)
    chk_int("xor_124", nim_xor(h), 7)

fn test_nim_is_winning_false()
    // nim-sum == 0 -> losing position
    let h = mk_heaps(1, 2, 3)
    chk_bool("is_winning_123", nim_is_winning(h), false)

fn test_nim_is_winning_true()
    // nim-sum != 0 -> winning position
    let h = mk_heaps(1, 2, 4)
    chk_bool("is_winning_124", nim_is_winning(h), true)

fn test_nim_winning_move_none()
    // Already a losing position; should return [-1, 0]
    let h = mk_heaps(1, 2, 3)
    let m = nim_winning_move(h)
    chk_int("no_move_idx", m[0], -1)
    chk_int("no_move_cnt", m[1], 0)

fn test_nim_winning_move_valid()
    // [1, 2, 4]: nim_xor = 7. Winning move leaves nim-sum 0.
    // heap[2]=4, 4 XOR 7 = 3 < 4, so remove 1 from heap[2] -> [1,2,3] with xor 0.
    let h = mk_heaps(1, 2, 4)
    let m = nim_winning_move(h)
    let hi = m[0]
    let rc = m[1]
    // verify move is valid (heap index in range, remove >= 1)
    if hi < 0
        print("FAIL nim winning_move valid: got idx " + str(hi))
        exit(1)
    if rc < 1
        print("FAIL nim winning_move valid: got remove " + str(rc))
        exit(1)
    // verify the resulting nim-sum is 0
    let h2 = mk_heaps(1, 2, 4)
    h2[hi] = h2[hi] - rc
    let x2 = nim_xor(h2)
    chk_int("winning_move_leaves_zero", x2, 0)
    // specifically it should pick heap index 2, remove 1
    chk_int("winning_move_idx", hi, 2)
    chk_int("winning_move_cnt", rc, 1)

fn test_single_heap()
    // [5] -> nim_xor=5, winning: take all 5.
    let h = []
    push(h, 5)
    chk_int("single_xor", nim_xor(h), 5)
    chk_bool("single_winning", nim_is_winning(h), true)
    let m = nim_winning_move(h)
    chk_int("single_move_idx", m[0], 0)
    chk_int("single_move_cnt", m[1], 5)

fn main()
    test_nim_xor_zero()
    test_nim_xor_nonzero()
    test_nim_is_winning_false()
    test_nim_is_winning_true()
    test_nim_winning_move_none()
    test_nim_winning_move_valid()
    test_single_heap()
    print("PASS _nim_test")
