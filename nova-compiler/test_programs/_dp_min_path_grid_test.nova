import std/dp/dp_min_path_grid

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn ckl(label, got, want)
    let lg = len(got)
    let lw = len(want)
    if lg != lw
        print("FAIL " + label + " len: got=" + str(lg) + " want=" + str(lw))
        exit(1)
    let k = 0
    while k < lw
        if got[k] != want[k]
            print("FAIL " + label + "[" + str(k) + "]: got=" + str(got[k]) + " want=" + str(want[k]))
            exit(1)
        k = k + 1

fn main()
    // KAT 1: mp_min_sum([[1,3,1],[1,5,1],[4,2,1]]) == 7
    // Path: (0,0)=1 -> (0,1)=3 -> (0,2)=1 -> (1,2)=1 -> (2,2)=1 => sum=7
    let g1 = []
    let r1a = []
    push(r1a, 1)
    push(r1a, 3)
    push(r1a, 1)
    push(g1, r1a)
    let r1b = []
    push(r1b, 1)
    push(r1b, 5)
    push(r1b, 1)
    push(g1, r1b)
    let r1c = []
    push(r1c, 4)
    push(r1c, 2)
    push(r1c, 1)
    push(g1, r1c)
    cki("mp_min_sum 3x3", mp_min_sum(g1), 7)

    // KAT 2: mp_max_sum([[1,2],[3,4]]) == 8
    // Path: (0,0)=1 -> (1,0)=3 -> (1,1)=4 => sum=8
    let g2 = []
    let r2a = []
    push(r2a, 1)
    push(r2a, 2)
    push(g2, r2a)
    let r2b = []
    push(r2b, 3)
    push(r2b, 4)
    push(g2, r2b)
    cki("mp_max_sum 2x2", mp_max_sum(g2), 8)

    // KAT 3: mp_path_count(3,3) == 6  (C(4,2)=6)
    cki("mp_path_count(3,3)", mp_path_count(3, 3), 6)

    // KAT 4: mp_path_count(3,7) == 28  (C(8,2)=28)
    cki("mp_path_count(3,7)", mp_path_count(3, 7), 28)

    // KAT 5: mp_path_count(1,1) == 1
    cki("mp_path_count(1,1)", mp_path_count(1, 1), 1)

    // KAT 6: mp_min_sum([[5]]) == 5  (single cell)
    let g3 = []
    let r3a = []
    push(r3a, 5)
    push(g3, r3a)
    cki("mp_min_sum 1x1", mp_min_sum(g3), 5)

    // KAT 7: mp_max_sum on single-cell grid
    let g4 = []
    let r4a = []
    push(r4a, 9)
    push(g4, r4a)
    cki("mp_max_sum 1x1", mp_max_sum(g4), 9)

    // KAT 8: mp_path_count(1,5) == 1 (only one row, must go all right)
    cki("mp_path_count(1,5)", mp_path_count(1, 5), 1)

    // KAT 9: mp_path_count(5,1) == 1 (only one col, must go all down)
    cki("mp_path_count(5,1)", mp_path_count(5, 1), 1)

    // KAT 10: mp_min_sum on 1x3 grid == sum of all (only one path)
    let g5 = []
    let r5a = []
    push(r5a, 2)
    push(r5a, 3)
    push(r5a, 4)
    push(g5, r5a)
    cki("mp_min_sum 1x3", mp_min_sum(g5), 9)

    print("PASS _dp_min_path_grid_test")
