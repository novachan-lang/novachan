import std/typesystem/type_alpha

// --- check helpers ---

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn ckb(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + got + " expected " + expected)
        exit(1)

// ckt: check two types are structurally equal
fn ckt(label, a, b)
    let eq = type_alpha.talp_type_eq(a, b)
    if eq == 0
        print("FAIL " + label + ": types not equal")
        exit(1)

fn main()
    let int_ty = type_alpha.tyc_int()
    let bool_ty = type_alpha.tyc_bool()

    // --- KAT 1: talp_canonical(arr(tvar(5), tvar(3))) == arr(tvar(0), tvar(1)) ---
    let t1 = type_alpha.tyc_arr(type_alpha.tyc_tvar(5), type_alpha.tyc_tvar(3))
    let c1 = type_alpha.talp_canonical(t1)
    let exp1 = type_alpha.tyc_arr(type_alpha.tyc_tvar(0), type_alpha.tyc_tvar(1))
    ckt("canonical_5_3_becomes_0_1", c1, exp1)

    // --- KAT 2: talp_canonical(arr(tvar(9), tvar(9))) == arr(tvar(0), tvar(0)) ---
    let t2 = type_alpha.tyc_arr(type_alpha.tyc_tvar(9), type_alpha.tyc_tvar(9))
    let c2 = type_alpha.talp_canonical(t2)
    let exp2 = type_alpha.tyc_arr(type_alpha.tyc_tvar(0), type_alpha.tyc_tvar(0))
    ckt("canonical_9_9_becomes_0_0", c2, exp2)

    // --- KAT 3: talp_alpha_equal(arr(tvar(1),tvar(2)), arr(tvar(7),tvar(8))) == true ---
    let a3 = type_alpha.tyc_arr(type_alpha.tyc_tvar(1), type_alpha.tyc_tvar(2))
    let b3 = type_alpha.tyc_arr(type_alpha.tyc_tvar(7), type_alpha.tyc_tvar(8))
    cki("alpha_equal_1_2_vs_7_8_true", type_alpha.talp_alpha_equal(a3, b3), 1)

    // --- KAT 4: talp_alpha_equal(arr(tvar(1),tvar(1)), arr(tvar(7),tvar(8))) == false ---
    let a4 = type_alpha.tyc_arr(type_alpha.tyc_tvar(1), type_alpha.tyc_tvar(1))
    let b4 = type_alpha.tyc_arr(type_alpha.tyc_tvar(7), type_alpha.tyc_tvar(8))
    cki("alpha_equal_1_1_vs_7_8_false", type_alpha.talp_alpha_equal(a4, b4), 0)

    // --- KAT 5: base types are self-equal ---
    cki("alpha_equal_int_int", type_alpha.talp_alpha_equal(int_ty, int_ty), 1)
    cki("alpha_equal_int_bool_false", type_alpha.talp_alpha_equal(int_ty, bool_ty), 0)

    // --- KAT 6: talp_canonical on base type is identity ---
    let ci = type_alpha.talp_canonical(int_ty)
    ckt("canonical_int_id", ci, int_ty)

    // --- KAT 7: talp_canonical on a con type with tvar args ---
    // con "pair" [tvar(3), tvar(7)] -> con "pair" [tvar(0), tvar(1)]
    let t7 = type_alpha.tyc_pair(type_alpha.tyc_tvar(3), type_alpha.tyc_tvar(7))
    let c7 = type_alpha.talp_canonical(t7)
    let exp7 = type_alpha.tyc_pair(type_alpha.tyc_tvar(0), type_alpha.tyc_tvar(1))
    ckt("canonical_pair_tvars", c7, exp7)

    // --- KAT 8: talp_rename basic ---
    // rename tvar(5)->tvar(0), tvar(3)->tvar(1) in arr(tvar(5),tvar(3))
    let mapping8 = []
    let p80 = []
    push(p80, 5)
    push(p80, 0)
    push(mapping8, p80)
    let p81 = []
    push(p81, 3)
    push(p81, 1)
    push(mapping8, p81)
    let r8 = type_alpha.talp_rename(t1, mapping8)
    ckt("rename_5to0_3to1", r8, exp1)

    // --- KAT 9: talp_rename leaves unmapped tvars alone ---
    let mapping9 = []
    let p9 = []
    push(p9, 5)
    push(p9, 99)
    push(mapping9, p9)
    let r9 = type_alpha.talp_rename(t1, mapping9)
    // arr(tvar(5),tvar(3)) with 5->99, 3 unmapped -> arr(tvar(99), tvar(3))
    let exp9 = type_alpha.tyc_arr(type_alpha.tyc_tvar(99), type_alpha.tyc_tvar(3))
    ckt("rename_partial", r9, exp9)

    // --- KAT 10: alpha_equal via con types ---
    // con "list" [tvar(2)] alpha-equal to con "list" [tvar(5)]
    let la = type_alpha.tyc_list(type_alpha.tyc_tvar(2))
    let lb = type_alpha.tyc_list(type_alpha.tyc_tvar(5))
    cki("alpha_equal_list_tvar", type_alpha.talp_alpha_equal(la, lb), 1)

    // --- KAT 11: alpha_equal different structure -> false ---
    // arr(tvar(0), int) vs arr(tvar(0), bool)
    let xa = type_alpha.tyc_arr(type_alpha.tyc_tvar(0), int_ty)
    let xb = type_alpha.tyc_arr(type_alpha.tyc_tvar(0), bool_ty)
    cki("alpha_equal_diff_con_false", type_alpha.talp_alpha_equal(xa, xb), 0)

    // --- KAT 12: talp_canonical tvar(0) already canonical ---
    let t12 = type_alpha.tyc_tvar(0)
    let c12 = type_alpha.talp_canonical(t12)
    ckt("canonical_tvar0", c12, t12)

    print("PASS _type_alpha_test")

main()
