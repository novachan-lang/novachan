// _grammar_derive_test — KAT for std/grammar/grammar_derive.nova
// Grammar: S -> a S b | epsilon  (generates a^n b^n for n >= 0)
// Productions:
//   S -> a S b
//   S -> (epsilon / empty rhs)
//
// grdv_recognize tests:
//   []       -> true  (S derives epsilon)
//   ["a","b"]     -> true  (S -> a S b -> a b)
//   ["a","a","b","b"] -> true  (S -> aSb -> aaSbb -> aabb)
//   ["a","b","b"] -> false  (unbalanced)
//   ["a"]         -> false  (no derivation)
//
// grdv_generate(prods, "S", 4):
//   length 0: ""
//   length 2: "a b"
//   length 4: "a a b b"
//   Sorted: ["", "a a b b", "a b"]

import std/grammar/grammar_derive

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckl(label, got, want)
    if len(got) != len(want)
        print("FAIL " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL " + label + ": got[" + str(i) + "]=" + got[i] + " want=" + want[i])
            exit(1)
        i = i + 1

fn build_anbn_grammar()
    // S -> a S b
    let p1 = ["S", ["a", "S", "b"]]
    // S -> epsilon
    let p2 = ["S", []]
    let prods = []
    prods.push(p1)
    prods.push(p2)
    return prods

fn main()
    let prods = build_anbn_grammar()

    // KAT 1: [] -> true (epsilon derivable)
    let t0 = []
    cki("recognize_empty", grdv_recognize(prods, "S", t0), 1)

    // KAT 2: ["a","b"] -> true (n=1)
    let t1 = ["a", "b"]
    cki("recognize_ab", grdv_recognize(prods, "S", t1), 1)

    // KAT 3: ["a","a","b","b"] -> true (n=2)
    let t2 = ["a", "a", "b", "b"]
    cki("recognize_aabb", grdv_recognize(prods, "S", t2), 1)

    // KAT 4: ["a","b","b"] -> false (unbalanced)
    let t3 = ["a", "b", "b"]
    cki("recognize_abb_false", grdv_recognize(prods, "S", t3), 0)

    // KAT 5: ["a"] -> false (no derivation of just 'a')
    let t4 = ["a"]
    cki("recognize_a_false", grdv_recognize(prods, "S", t4), 0)

    // KAT 6: grdv_derivable same as grdv_recognize
    let t5 = ["a", "b"]
    cki("derivable_ab", grdv_derivable(prods, "S", t5), 1)

    // KAT 7: generate with max_len=4 -> ["", "a a b b", "a b"]
    let gen = grdv_generate(prods, "S", 4)
    let want_gen = ["", "a a b b", "a b"]
    ckl("generate_4", gen, want_gen)

    // KAT 8: generate with max_len=0 -> [""] (only epsilon)
    let gen0 = grdv_generate(prods, "S", 0)
    let want_gen0 = [""]
    ckl("generate_0", gen0, want_gen0)

    // KAT 9: generate with max_len=2 -> ["", "a b"]
    let gen2 = grdv_generate(prods, "S", 2)
    let want_gen2 = ["", "a b"]
    ckl("generate_2", gen2, want_gen2)

    // KAT 10: test with a simple grammar: A -> x | y
    let pa1 = ["A", ["x"]]
    let pa2 = ["A", ["y"]]
    let pa3 = ["A", ["x", "x"]]
    let prods2 = []
    prods2.push(pa1)
    prods2.push(pa2)
    prods2.push(pa3)
    let ta1 = ["x"]
    cki("simple_x", grdv_recognize(prods2, "A", ta1), 1)
    let ta2 = ["y"]
    cki("simple_y", grdv_recognize(prods2, "A", ta2), 1)
    let ta3 = ["x", "x"]
    cki("simple_xx", grdv_recognize(prods2, "A", ta3), 1)
    let ta4 = ["z"]
    cki("simple_z_false", grdv_recognize(prods2, "A", ta4), 0)

    print("PASS _grammar_derive_test")

main()
