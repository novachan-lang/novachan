// utctime.nova — timezone-INDEPENDENT UTC date/time arithmetic, the NOVA way.
//
// The built-in nova_rt_datetime_* accessors use the OS's ambient localtime(),
// so the same timestamp yields different y/m/d depending on the machine's TZ —
// a silent correctness bug for servers, logs, and cross-node messaging. This
// module computes calendar fields directly from a Unix timestamp with PURE
// INTEGER ARITHMETIC (Howard Hinnant's days<->civil algorithms), so the result
// is the SAME on every machine in every timezone. Fixed-offset zones are an
// explicit second argument — no hidden ambient state. (Valid for ts >= 0.)

// days since 1970-01-01 for a proleptic-Gregorian y/m/d.
fn days_from_civil(y0, m, d)
  let y = y0
  if m <= 2
    y = y - 1
  let era = y / 400
  let yoe = y - era * 400
  let mp = m + 9
  if m > 2
    mp = m - 3
  let doy = (153 * mp + 2) / 5 + d - 1
  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
  era * 146097 + doe - 719468

// civil y/m/d from days since 1970-01-01 -> [year, month, day].
fn civil_from_days(z0)
  let z = z0 + 719468
  let era = z / 146097
  let doe = z - era * 146097
  let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  let y = yoe + era * 400
  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  let mp = (5 * doy + 2) / 153
  let d = doy - (153 * mp + 2) / 5 + 1
  let m = mp + 3
  if mp >= 10
    m = mp - 9
  if m <= 2
    y = y + 1
  [y, m, d]

fn is_leap(y)
  if y % 4 != 0
    return 0
  if y % 100 != 0
    return 1
  if y % 400 != 0
    return 0
  1

fn days_in_month(y, m)
  if m == 2
    if is_leap(y) == 1
      return 29
    return 28
  if m == 4 or m == 6 or m == 9 or m == 11
    return 30
  31

// 0=Sunday .. 6=Saturday for a Unix timestamp (UTC). 1970-01-01 was a Thursday.
fn utc_weekday(ts)
  let days = ts / 86400
  (days % 7 + 4) % 7

// Calendar components of a Unix timestamp in UTC (or in a fixed offset zone) ->
// dict {year, month, day, hour, minute, second, weekday}.
fn at_offset(ts, offset_seconds)
  let t = ts + offset_seconds
  let days = t / 86400
  let secs = t % 86400
  let ymd = civil_from_days(days)
  let comp = {}
  comp["year"] = ymd[0]
  comp["month"] = ymd[1]
  comp["day"] = ymd[2]
  comp["hour"] = secs / 3600
  comp["minute"] = (secs % 3600) / 60
  comp["second"] = secs % 60
  comp["weekday"] = (days % 7 + 4) % 7
  comp

fn utc_components(ts)
  at_offset(ts, 0)

// Inverse: build a Unix timestamp from UTC calendar fields.
fn make_timestamp(y, m, d, h, mi, s)
  days_from_civil(y, m, d) * 86400 + h * 3600 + mi * 60 + s

fn _pad2(n)
  if n < 10
    return "0" + str(n)
  str(n)

// ISO 8601 in UTC: "YYYY-MM-DDTHH:MM:SSZ".
fn iso8601(ts)
  let c = utc_components(ts)
  str(c["year"]) + "-" + _pad2(c["month"]) + "-" + _pad2(c["day"]) + "T" + _pad2(c["hour"]) + ":" + _pad2(c["minute"]) + ":" + _pad2(c["second"]) + "Z"

// ── Tests ────────────────────────────────────────────────────────────

// Test 1: the epoch.
let e = utc_components(0)
assert(e["year"] == 1970, "epoch year")
assert(e["month"] == 1, "epoch month")
assert(e["day"] == 1, "epoch day")
assert(e["hour"] == 0, "epoch hour")
assert(e["weekday"] == 4, "1970-01-01 was a Thursday (4)")
assert(iso8601(0) == "1970-01-01T00:00:00Z", "epoch iso")
print("PASS: epoch")

// Test 2: a known timestamp — 1234567890 = 2009-02-13T23:31:30Z (Friday).
let c = utc_components(1234567890)
assert(c["year"] == 2009, "year 2009")
assert(c["month"] == 2, "feb")
assert(c["day"] == 13, "13th")
assert(c["hour"] == 23, "23h")
assert(c["minute"] == 31, "31m")
assert(c["second"] == 30, "30s")
assert(c["weekday"] == 5, "Friday")
assert(iso8601(1234567890) == "2009-02-13T23:31:30Z", "famous iso")
print("PASS: 1234567890 = 2009-02-13T23:31:30Z")

// Test 3: round-trip make_timestamp <-> components.
let ts = make_timestamp(2021, 7, 4, 12, 30, 45)
let rt = utc_components(ts)
assert(rt["year"] == 2021, "rt year")
assert(rt["month"] == 7, "rt month")
assert(rt["day"] == 4, "rt day")
assert(rt["hour"] == 12, "rt hour")
assert(rt["minute"] == 30, "rt min")
assert(rt["second"] == 45, "rt sec")
assert(make_timestamp(1970, 1, 1, 0, 0, 0) == 0, "epoch round-trip")
print("PASS: make_timestamp round-trip")

// Test 4: leap day — 2020-02-29 is valid and round-trips.
let leap_ts = make_timestamp(2020, 2, 29, 0, 0, 0)
let leap_c = utc_components(leap_ts)
assert(leap_c["year"] == 2020, "leap year")
assert(leap_c["month"] == 2, "leap feb")
assert(leap_c["day"] == 29, "leap 29th")
assert(is_leap(2020) == 1, "2020 is leap")
assert(is_leap(2021) == 0, "2021 not leap")
assert(is_leap(1900) == 0, "1900 not leap (century)")
assert(is_leap(2000) == 1, "2000 is leap (400)")
assert(days_in_month(2020, 2) == 29, "feb 2020 = 29 days")
assert(days_in_month(2021, 2) == 28, "feb 2021 = 28 days")
print("PASS: leap year handling")

// Test 5: fixed-offset timezone — same instant, shifted local clock.
// 2021-01-01T00:00:00Z at +05:30 (IST) = 05:30 local, still 2021-01-01.
let ist = at_offset(1609459200, 5 * 3600 + 30 * 60)
assert(ist["hour"] == 5, "IST hour 5")
assert(ist["minute"] == 30, "IST minute 30")
assert(ist["day"] == 1, "still the 1st")
// at -08:00 (PST), 2021-01-01T00:00Z = 2020-12-31 16:00 local (day rolls back)
let pst = at_offset(1609459200, 0 - 8 * 3600)
assert(pst["year"] == 2020, "PST rolls to 2020")
assert(pst["month"] == 12, "PST december")
assert(pst["day"] == 31, "PST 31st")
assert(pst["hour"] == 16, "PST 16h")
print("PASS: fixed-offset timezones")

// Test 6: month-end + day-of-month boundaries across a year.
let nye = make_timestamp(2023, 12, 31, 23, 59, 59)
let nye_c = utc_components(nye)
assert(nye_c["month"] == 12 and nye_c["day"] == 31, "NYE date")
let newyear = utc_components(nye + 1)
assert(newyear["year"] == 2024, "rolls to 2024")
assert(newyear["month"] == 1 and newyear["day"] == 1, "Jan 1")
print("PASS: year boundary")

print("ALL PASS: utctime — timezone-independent UTC date arithmetic")
