import forge_pwstrength

fn ck(label: string, got: int, want: int)
    let ok = "FAIL"
    if got == want
        ok = "ok"
    print(label + "=" + ok + "(" + str(got) + ")")

fn main()
    ck("short", password_strength("abc"), 0)
    ck("allsame", password_strength("aaaaaaaa"), 0)
    ck("lower6", password_strength("abcdef"), 1)
    ck("two_class10", password_strength("abcdefgh12"), 2)
    ck("three_class10", password_strength("Abcdefg123"), 3)
    ck("strong12", password_strength("P@ssw0rd!23X"), 4)
    // ordering: strong beats weak
    let strong = password_strength("P@ssw0rd!23X")
    let weak = password_strength("abcdef")
    if strong > weak
        print("ordering=ok")
    else
        print("ordering=FAIL")
    print("label=" + password_strength_label("P@ssw0rd!23X"))
    print("label_weak=" + password_strength_label("abcdef"))
