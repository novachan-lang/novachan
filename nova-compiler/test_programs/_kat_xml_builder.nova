import forge_xml_builder

fn main()
    let x = xb_new("doc")
    x = xb_add_elem(x, "name", "Alice")
    x = xb_add_elem(x, "age", "30")
    x = xb_add_elem_attr(x, "item", "phone", "id", "1")
    assert(xb_elem_count(x) == 3, "3 elements")

    assert(xb_elem_tag(x, 0) == "name", "tag 0")
    assert(xb_elem_text(x, 0) == "Alice", "text 0")

    let lt = chr(60)
    let gt = chr(62)
    let r0 = xb_render_elem(x, 0)
    assert(r0 == lt + "name" + gt + "Alice" + lt + "/name" + gt, "render elem 0")

    let r2 = xb_render_elem(x, 2)
    assert(r2 == lt + "item id=\"1\"" + gt + "phone" + lt + "/item" + gt, "render attr elem")

    let full = xb_render(x)
    let expected_start = lt + "doc" + gt
    assert(slice(full, 0, 5) == expected_start, "starts with doc tag")

    print("XML-BUILDER KAT PASS")
