import forge_map_reduce

fn main()
    let m = mr_new()
    m = mr_add_input(m, "sales", 100)
    m = mr_add_input(m, "sales", 200)
    m = mr_add_input(m, "costs", 50)
    m = mr_add_input(m, "sales", 150)
    m = mr_add_input(m, "costs", 75)
    assert(mr_input_count(m) == 5, "5 inputs")
    assert(mr_phase(m) == "input", "input phase")

    m = mr_map_identity(m)
    assert(mr_phase(m) == "mapped", "mapped phase")

    m = mr_reduce_sum(m)
    assert(mr_phase(m) == "reduced", "reduced phase")
    assert(mr_result(m, "sales") == 450, "sales 450")
    assert(mr_result(m, "costs") == 125, "costs 125")
    assert(mr_result(m, "unknown") == 0, "unknown 0")
    assert(mr_result_count(m) == 2, "2 result keys")

    print("MAP-REDUCE KAT PASS")
