// KAT for std/text/bbcode_color
import std/text/bbcode_color

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got [" + got + "] want [" + want + "]")
        exit(1)

fn main()
    // KAT-1: named color, lowercase
    cki("valid-red", bcol_is_valid_color("red"), 1)

    // KAT-2: named color, uppercase (case-insensitive)
    cki("valid-RED-upper", bcol_is_valid_color("RED"), 1)

    // KAT-3: 6-digit hex
    cki("valid-hex6", bcol_is_valid_color("#FF0000"), 1)

    // KAT-4: 3-digit hex
    cki("valid-hex3", bcol_is_valid_color("#f00"), 1)

    // KAT-5: bad hex digits rejected
    cki("invalid-hex-zz", bcol_is_valid_color("#zz0000"), 0)

    // KAT-6: unknown named color rejected
    cki("invalid-unknown-name", bcol_is_valid_color("chartreuse"), 0)

    // KAT-7: empty string rejected
    cki("invalid-empty", bcol_is_valid_color(""), 0)

    // KAT-8: normalize uppercases-lowers a named color
    cks("normalize-named", bcol_normalize("RED"), "red")

    // KAT-9: normalize expands 3-digit hex to 6-digit
    cks("normalize-hex3", bcol_normalize("#ABC"), "#aabbcc")

    // KAT-10: normalize lowercases a 6-digit hex unchanged in length
    cks("normalize-hex6", bcol_normalize("#AABBCC"), "#aabbcc")

    // KAT-11: extract two color values from a BBCode string, tag case-insensitive
    let vals = bcol_extract("[color=red]hi[/color] and [COLOR=#00FF00]bye[/color]")
    cki("extract-count", len(vals), 2)
    cks("extract-first", vals[0], "red")
    cks("extract-second", vals[1], "#00FF00")

    // KAT-12: named_to_hex known name
    cks("named-to-hex-blue", bcol_named_to_hex("blue"), "#0000FF")

    // KAT-13: named_to_hex unknown name returns ""
    cks("named-to-hex-unknown", bcol_named_to_hex("nonexistent"), "")

    print("PASS _bbcode_color_test")
