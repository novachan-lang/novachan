// from_json_safe<T> -- the VALIDATING typed extractor. `let r: Result<T> = from_json_safe(s)`
// returns ok(struct) ONLY for a well-formed JSON object; non-object / empty / garbage -> Err.
// This is the inbound "return your type" moat: typed, zero-annotation, and SOUND (no silent
// default, no wild-deref). The slot stays Result-typed so the Ok/Err match dispatches.
type User
    id: int
    name: string
    active: bool

fn extract(s: string) -> string
    let r: Result<User> = from_json_safe(s)
    match r
        Ok(u) =>
            return "ok:" + str(u.id) + ":" + u.name
        Err(e) =>
            return "err:" + e

fn main()
    let q = chr(34)

    // well-formed object -> Ok(struct), fields intact
    let good = "\{" + q + "id" + q + ":7," + q + "name" + q + ":" + q + "ada" + q + "," + q + "active" + q + ":true\}"
    let g = extract(good)
    assert(g == "ok:7:ada", "well-formed -> Ok with fields (" + g + ")")
    print("PASS: well-formed -> " + g)

    // non-dict JSON -> Err (NOT a silently-defaulted struct, NOT a crash)
    assert(extract("42")[0:3] == "err", "bare int -> Err")
    assert(extract("[1,2,3]")[0:3] == "err", "array -> Err")
    assert(extract(q + "hi" + q)[0:3] == "err", "string -> Err")
    assert(extract("true")[0:3] == "err", "bool -> Err")
    assert(extract("")[0:3] == "err", "empty -> Err")
    assert(extract("not json at all")[0:3] == "err", "garbage -> Err")
    print("PASS: non-dict / empty / garbage -> Err (validated, no crash)")

    // missing fields on a REAL object still parse (Ok with defaults) -- a present object is valid;
    // field-level requiredness is a separate concern (form_as_safe, future). Soundness: no crash.
    let partial = "\{" + q + "id" + q + ":3\}"
    let p = extract(partial)
    assert(p == "ok:3:", "partial object -> Ok with defaulted name")
    print("PASS: partial object -> " + p)

    print("from_json_safe_test passed")
