import std/devtool/semver

let _c = [0, 0]

fn chk(label, got, expected)
    if got == expected
        _c[0] = _c[0] + 1
    else
        _c[1] = _c[1] + 1
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))

fn chk_list(label, got: list, expected: list)
    if len(got) != len(expected)
        _c[1] = _c[1] + 1
        print("FAIL " + label + " length: got " + str(len(got)) + " expected " + str(len(expected)))
        return 0
    let i = 0
    while i < len(got)
        chk(label + "[" + str(i) + "]", got[i], expected[i])
        i = i + 1
    0

// ── sv_parse: valid ──────────────────────────────────────────────────────
let p1 = sv_parse("1.2.3")
chk("parse_ok", is_ok(p1), true)
let d1 = unwrap(p1)
chk("parse_major", d1["major"], 1)
chk("parse_minor", d1["minor"], 2)
chk("parse_patch", d1["patch"], 3)
chk("parse_pre_empty", d1["pre"], "")
chk("parse_build_empty", d1["build"], "")

let p2 = sv_parse("1.2.3-alpha.1+build.5")
chk("parse_full_ok", is_ok(p2), true)
let d2 = unwrap(p2)
chk("parse_full_pre", d2["pre"], "alpha.1")
chk("parse_full_build", d2["build"], "build.5")
chk("parse_full_roundtrip", sv_to_string(d2), "1.2.3-alpha.1+build.5")

// ── sv_parse: invalid ────────────────────────────────────────────────────
chk("parse_bad_too_few_parts", is_err(sv_parse("1.2")), true)
chk("parse_bad_leading_zero", is_err(sv_parse("01.2.3")), true)
chk("parse_bad_nondigit", is_err(sv_parse("1.2.x")), true)
chk("parse_bad_empty", is_err(sv_parse("")), true)
chk("parse_bad_pre_leading_zero", is_err(sv_parse("1.2.3-01")), true)
chk("parse_bad_empty_pre", is_err(sv_parse("1.2.3-")), true)

// ── sv_valid ─────────────────────────────────────────────────────────────
chk("valid_true", sv_valid("1.0.0"), true)
chk("valid_false", sv_valid("1.0"), false)
chk("valid_true_pre", sv_valid("1.0.0-rc.1"), true)

// ── sv_to_string ─────────────────────────────────────────────────────────
chk("to_string_plain", sv_to_string(unwrap(sv_parse("2.4.6"))), "2.4.6")

// ── sv_compare / gt / gte / lt / lte (spec precedence examples) ──────────
chk("cmp_major", sv_compare("2.0.0", "1.9.9"), 1)
chk("cmp_minor", sv_compare("1.2.0", "1.10.0"), -1)
chk("cmp_patch_eq", sv_compare("1.2.3", "1.2.3"), 0)
chk("cmp_pre_lt_release", sv_compare("1.0.0-alpha", "1.0.0"), -1)
chk("cmp_numeric_pre", sv_compare("1.0.0-alpha.1", "1.0.0-alpha.2"), -1)
chk("cmp_numeric_vs_alpha_pre", sv_compare("1.0.0-1", "1.0.0-alpha"), -1)
chk("cmp_pre_len", sv_compare("1.0.0-alpha", "1.0.0-alpha.1"), -1)
chk("cmp_pre_lex", sv_compare("1.0.0-alpha", "1.0.0-beta"), -1)
chk("cmp_pre_numeric_big", sv_compare("1.0.0-9", "1.0.0-10"), -1)
chk("gt_true", sv_gt("2.0.0", "1.0.0"), true)
chk("gte_eq", sv_gte("1.0.0", "1.0.0"), true)
chk("lt_true", sv_lt("1.0.0", "2.0.0"), true)
chk("lte_eq", sv_lte("1.0.0", "1.0.0"), true)

// ── sv_bump_major / minor / patch ────────────────────────────────────────
chk("bump_major", sv_bump_major("1.2.3"), "2.0.0")
chk("bump_minor", sv_bump_minor("1.2.3"), "1.3.0")
chk("bump_patch", sv_bump_patch("1.2.3"), "1.2.4")
chk("bump_clears_pre", sv_bump_patch("1.2.3-rc.1"), "1.2.4")
chk("bump_invalid_passthrough", sv_bump_major("nope"), "nope")

// ── sv_diff ──────────────────────────────────────────────────────────────
chk("diff_major", sv_diff("2.0.0", "1.0.0"), "major")
chk("diff_minor", sv_diff("1.3.0", "1.2.0"), "minor")
chk("diff_patch", sv_diff("1.2.4", "1.2.3"), "patch")
chk("diff_pre", sv_diff("1.2.3-a", "1.2.3-b"), "pre")
chk("diff_none", sv_diff("1.2.3", "1.2.3"), "none")

// ── sv_satisfies ─────────────────────────────────────────────────────────
chk("sat_star", sv_satisfies("5.6.7", "*"), true)
chk("sat_gte_true", sv_satisfies("1.5.0", ">=1.0.0"), true)
chk("sat_gte_false", sv_satisfies("0.9.0", ">=1.0.0"), false)
chk("sat_xrange_true", sv_satisfies("1.2.9", "1.2.x"), true)
chk("sat_xrange_false", sv_satisfies("1.3.0", "1.2.x"), false)
chk("sat_tilde_true", sv_satisfies("1.2.9", "~1.2.3"), true)
chk("sat_tilde_false_minor", sv_satisfies("1.3.0", "~1.2.3"), false)
chk("sat_caret_true", sv_satisfies("1.9.0", "^1.2.3"), true)
chk("sat_caret_false_major", sv_satisfies("2.0.0", "^1.2.3"), false)
chk("sat_caret_zero_major", sv_satisfies("0.2.9", "^0.2.3"), true)
chk("sat_caret_zero_major_minor_bump", sv_satisfies("0.3.0", "^0.2.3"), false)
chk("sat_caret_zero_zero", sv_satisfies("0.0.3", "^0.0.3"), true)
chk("sat_caret_zero_zero_bump", sv_satisfies("0.0.4", "^0.0.3"), false)
chk("sat_exact_true", sv_satisfies("1.2.3", "1.2.3"), true)
chk("sat_exact_false", sv_satisfies("1.2.4", "1.2.3"), false)

// ── sv_max_satisfying ────────────────────────────────────────────────────
let versions = ["1.0.0", "1.5.0", "2.0.0", "1.9.9", "0.5.0"]
let ms = sv_max_satisfying(versions, "^1.0.0")
chk("max_satisfying_ok", is_ok(ms), true)
chk("max_satisfying_val", unwrap(ms), "1.9.9")
let ms_none = sv_max_satisfying(versions, "^5.0.0")
chk("max_satisfying_none", is_err(ms_none), true)

// ── sv_sort ──────────────────────────────────────────────────────────────
let unsorted = ["1.10.0", "1.2.0", "1.1.0", "2.0.0", "1.2.0-alpha"]
let sorted = sv_sort(unsorted)
chk_list("sort", sorted, ["1.1.0", "1.2.0-alpha", "1.2.0", "1.10.0", "2.0.0"])
chk_list("sort_input_untouched", unsorted, ["1.10.0", "1.2.0", "1.1.0", "2.0.0", "1.2.0-alpha"])

// ── sv_coerce ────────────────────────────────────────────────────────────
let c1 = sv_coerce("v1.2")
chk("coerce_v_minor_ok", is_ok(c1), true)
let dc1 = unwrap(c1)
chk("coerce_v_minor_major", dc1["major"], 1)
chk("coerce_v_minor_minor", dc1["minor"], 2)
chk("coerce_v_minor_patch", dc1["patch"], 0)

let c2 = sv_coerce("1")
chk("coerce_single_ok", is_ok(c2), true)
let dc2 = unwrap(c2)
chk("coerce_single_major", dc2["major"], 1)
chk("coerce_single_minor", dc2["minor"], 0)
chk("coerce_single_patch", dc2["patch"], 0)

let c3 = sv_coerce("1.2.3")
chk("coerce_strict_still_works", is_ok(c3), true)
chk("coerce_strict_val", sv_to_string(unwrap(c3)), "1.2.3")

let c4 = sv_coerce("=v2.5.1")
chk("coerce_prefix_junk", is_ok(c4), true)
chk("coerce_prefix_junk_str", sv_to_string(unwrap(c4)), "2.5.1")

chk("coerce_no_digits", is_err(sv_coerce("abc")), true)

print("semver_kat: " + str(_c[0]) + " passed, " + str(_c[1]) + " failed")
if _c[1] > 0
    exit(1)
