import forge_semver

fn main()
    let v = sv_new(1, 2, 3)
    assert(sv_major(v) == 1, "major 1")
    assert(sv_minor(v) == 2, "minor 2")
    assert(sv_patch(v) == 3, "patch 3")
    assert(sv_to_string(v) == "1.2.3", "to_string")

    let v2 = sv_bump_patch(v)
    assert(sv_to_string(v2) == "1.2.4", "bump patch")

    let v3 = sv_bump_minor(v)
    assert(sv_to_string(v3) == "1.3.0", "bump minor resets patch")

    let v4 = sv_bump_major(v)
    assert(sv_to_string(v4) == "2.0.0", "bump major resets all")

    let a = sv_new(1, 0, 0)
    let b = sv_new(2, 0, 0)
    assert(sv_compare(a, b) == -1, "1.0.0 < 2.0.0")
    assert(sv_compare(b, a) == 1, "2.0.0 > 1.0.0")
    assert(sv_compare(a, a) == 0, "equal")

    assert(sv_is_compatible(a, sv_new(1, 5, 0)) == 1, "compatible")
    assert(sv_is_compatible(a, b) == 0, "not compatible")

    print("SEMVER KAT PASS")
