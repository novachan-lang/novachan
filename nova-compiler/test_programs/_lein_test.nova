import std/phonetic/lein

fn cks(label, got, want)
    if got != want
        print("FAIL lein " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL lein " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── le_digit: LEIN digit-table mappings ──────────────────────────────────
    cki("digit_D", le_digit("D"), 1)
    cki("digit_T", le_digit("T"), 1)
    cki("digit_M", le_digit("M"), 2)
    cki("digit_N", le_digit("N"), 2)
    cki("digit_L", le_digit("L"), 3)
    cki("digit_R", le_digit("R"), 3)
    cki("digit_B", le_digit("B"), 4)
    cki("digit_F", le_digit("F"), 4)
    cki("digit_P", le_digit("P"), 4)
    cki("digit_V", le_digit("V"), 4)
    cki("digit_C", le_digit("C"), 5)
    cki("digit_G", le_digit("G"), 5)
    cki("digit_J", le_digit("J"), 5)
    cki("digit_K", le_digit("K"), 5)
    cki("digit_Q", le_digit("Q"), 5)
    cki("digit_S", le_digit("S"), 5)
    cki("digit_X", le_digit("X"), 5)
    cki("digit_Z", le_digit("Z"), 5)
    // Vowels and H/W/Y map to 0.
    cki("digit_A", le_digit("A"), 0)
    cki("digit_E", le_digit("E"), 0)
    cki("digit_H", le_digit("H"), 0)
    cki("digit_W", le_digit("W"), 0)
    cki("digit_Y", le_digit("Y"), 0)

    // ── le_encode: canonical KAT vectors (hand-traced) ────────────────────────
    // Smith: S + [M->2, I(skip), T->1, H(skip)] -> digits=21 pad->2100 -> S2100
    cks("smith", le_encode("Smith"), "S2100")

    // Robert: R + [O(skip), B->4, E(skip), R->3, T->1] -> digits=431 pad->4310 -> R4310
    cks("robert", le_encode("Robert"), "R4310")

    // Rupert: R + [U(skip), P->4, E(skip), R->3, T->1] -> digits=431 pad->4310 -> R4310
    cks("rupert", le_encode("Rupert"), "R4310")

    // Robert and Rupert must produce the same LEIN code.
    cks("robert_rupert_match", le_encode("Robert"), le_encode("Rupert"))

    // Johnson: J + [O(skip), H(skip), N->2, S->5, O(skip), N->2] -> digits=252 pad->2520 -> J2520
    // Collapse: N(2),S(5),N(2) -> no consecutive dups -> 252 -> J2520
    cks("johnson", le_encode("Johnson"), "J2520")

    // Williams: W + [I(skip), L->3, L->3(dup collapse), I(skip), A(skip), M->2, S->5]
    // digits: 3(L), 3(dup skip), 2(M), 5(S) -> 325 pad->3250 -> W3250
    cks("williams", le_encode("Williams"), "W3250")

    // ── Format invariant: always letter + exactly 4 digits ───────────────────
    let names = ["Smith", "Robert", "Rupert", "Johnson", "Williams", "Brown"]
    let ni = 0
    while ni < len(names)
        let code = le_encode(names[ni])
        // Total length must be 5.
        cki("len5_" + names[ni], len(code), 5)
        // First char: letter A-Z.
        let fo = ord(char_at(code, 0))
        let is_letter = 0
        if fo >= 65 and fo <= 90
            is_letter = 1
        cki("firstletter_" + names[ni], is_letter, 1)
        // Chars 1..4: digits 0-9.
        let di = 1
        while di <= 4
            let dord = ord(char_at(code, di))
            let is_digit = 0
            if dord >= 48 and dord <= 57
                is_digit = 1
            cki("digit_pos" + str(di) + "_" + names[ni], is_digit, 1)
            di = di + 1
        ni = ni + 1

    // ── Edge cases ───────────────────────────────────────────────────────────
    // Empty input -> "".
    cks("empty", le_encode(""), "")

    // Single letter -> letter + 4 zeros.
    cks("single_a", le_encode("A"), "A0000")

    // Non-alpha stripped.
    cks("nonalpha", le_encode("O'Brien"), le_encode("OBrien"))

    // Lowercase same as uppercase.
    cks("case", le_encode("smith"), le_encode("Smith"))

    print("PASS _lein_test")
