import collections

fn main()
    // Set
    let s = collections.set_new()
    collections.set_add(s, "apple")
    collections.set_add(s, "banana")
    collections.set_add(s, "apple")
    assert_eq(collections.set_size(s), 2)
    assert_eq(collections.set_contains(s, "apple"), true)
    assert_eq(collections.set_contains(s, "cherry"), false)
    collections.set_remove(s, "banana")
    assert_eq(collections.set_size(s), 1)

    let s2 = collections.set_new()
    collections.set_add(s2, "apple")
    collections.set_add(s2, "cherry")
    let u = collections.set_union(s, s2)
    assert_eq(collections.set_size(u), 2)
    let inter = collections.set_intersection(s, s2)
    assert_eq(collections.set_size(inter), 1)
    let diff = collections.set_difference(s2, s)
    assert_eq(collections.set_size(diff), 1)

    // Deque
    let dq = collections.deque_new()
    collections.deque_push_back(dq, 10)
    collections.deque_push_back(dq, 20)
    collections.deque_push_front(dq, 5)
    assert_eq(collections.deque_size(dq), 3)
    assert_eq(collections.deque_peek_front(dq), 5)
    assert_eq(collections.deque_peek_back(dq), 20)
    let pf = collections.deque_pop_front(dq)
    assert_eq(pf, 5)
    let pb = collections.deque_pop_back(dq)
    assert_eq(pb, 20)
    assert_eq(collections.deque_size(dq), 1)

    // Priority Queue
    let pq = collections.pq_new()
    collections.pq_push(pq, 3, "low")
    collections.pq_push(pq, 1, "high")
    collections.pq_push(pq, 2, "mid")
    assert_eq(collections.pq_size(pq), 3)
    let top = collections.pq_peek(pq)
    assert_eq(top[1], "high")
    let p1 = collections.pq_pop(pq)
    assert_eq(p1[1], "high")
    let p2 = collections.pq_pop(pq)
    assert_eq(p2[1], "mid")

    // Counter
    let cnt = collections.counter_new()
    collections.counter_add(cnt, "x")
    collections.counter_add(cnt, "y")
    collections.counter_add(cnt, "x")
    collections.counter_add(cnt, "x")
    assert_eq(collections.counter_count(cnt, "x"), 3)
    assert_eq(collections.counter_count(cnt, "y"), 1)
    assert_eq(collections.counter_total(cnt), 4)
    let mc = collections.counter_most_common(cnt, 1)
    assert_eq(len(mc), 1)

    // LRU Cache
    let lru = collections.lru_new(2)
    collections.lru_put(lru, "a", 100)
    collections.lru_put(lru, "b", 200)
    assert_eq(collections.lru_get(lru, "a"), 100)
    collections.lru_put(lru, "c", 300)
    assert_eq(collections.lru_size(lru), 2)

    print("TRACK 7 COLLECTIONS LIB TEST PASSED")
