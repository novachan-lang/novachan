import std/net/http_status

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let g = "false"
        if got
            g = "true"
        let w = "false"
        if want
            w = "true"
        print("FAIL " + label + ": got=" + g + " want=" + w)
        exit(1)

fn main()
    // KAT: reason phrases
    cks("reason(200)", hs_reason(200), "OK")
    cks("reason(404)", hs_reason(404), "Not Found")
    cks("reason(201)", hs_reason(201), "Created")
    cks("reason(301)", hs_reason(301), "Moved Permanently")
    cks("reason(503)", hs_reason(503), "Service Unavailable")
    cks("reason(999)", hs_reason(999), "")

    // KAT: boolean classifiers
    ckb("is_success(204)", hs_is_success(204), true)
    ckb("is_success(404)", hs_is_success(404), false)
    ckb("is_client_error(404)", hs_is_client_error(404), true)
    ckb("is_client_error(200)", hs_is_client_error(200), false)
    ckb("is_server_error(500)", hs_is_server_error(500), true)
    ckb("is_server_error(200)", hs_is_server_error(200), false)
    ckb("is_informational(100)", hs_is_informational(100), true)
    ckb("is_informational(200)", hs_is_informational(200), false)
    ckb("is_redirect(302)", hs_is_redirect(302), true)
    ckb("is_redirect(200)", hs_is_redirect(200), false)

    // KAT: category
    cks("category(302)", hs_category(302), "redirection")
    cks("category(999)", hs_category(999), "unknown")
    cks("category(100)", hs_category(100), "informational")
    cks("category(200)", hs_category(200), "success")
    cks("category(400)", hs_category(400), "client_error")
    cks("category(500)", hs_category(500), "server_error")

    // Additional boundary checks
    cks("reason(500)", hs_reason(500), "Internal Server Error")
    cks("reason(101)", hs_reason(101), "Switching Protocols")
    cks("reason(418)", hs_reason(418), "I'm a Teapot")
    ckb("is_redirect(399)", hs_is_redirect(399), true)
    ckb("is_redirect(400)", hs_is_redirect(400), false)

    print("_http_status_test passed")
