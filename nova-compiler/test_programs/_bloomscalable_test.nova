import std/sketch/bloomscalable

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn main()
    // --- KAT 1: sbf_new creates one sub-filter ---
    let st = sbf_new(64, 3)
    cki("initial_filters", sbf_num_filters(st), 1)
    cki("initial_count", sbf_count_added(st), 0)

    // --- KAT 2: add 200 items; filter MUST GROW (sbf_num_filters > 1) ---
    let i = 0
    while i < 200
        sbf_add(st, "k" + str(i))
        i = i + 1
    cki("count_added", sbf_count_added(st), 200)
    let nf = sbf_num_filters(st)
    if nf <= 1
        print("FAIL must_grow: sbf_num_filters=" + str(nf) + " want>1")
        exit(1)

    // --- KAT 3: NO FALSE NEGATIVES — every added item must be found ---
    let j = 0
    while j < 200
        let item = "k" + str(j)
        if sbf_contains(st, item) == false
            print("FAIL false_negative: item=" + item + " not found after add")
            exit(1)
        j = j + 1

    // --- KAT 4: clear resets to one empty filter ---
    sbf_clear(st)
    cki("clear_filters", sbf_num_filters(st), 1)
    cki("clear_count", sbf_count_added(st), 0)
    // After clear, a previously-added item should NOT be found
    ckb("clear_miss", sbf_contains(st, "k0"), false)

    // --- KAT 5: fresh single-item (before threshold) does not grow ---
    let st2 = sbf_new(64, 3)
    sbf_add(st2, "hello")
    cki("no_premature_grow", sbf_num_filters(st2), 1)
    ckb("single_item_found", sbf_contains(st2, "hello"), true)
    ckb("single_item_miss", sbf_contains(st2, "world"), false)

    // --- KAT 6: capacity >= init_size ---
    let cap = sbf_capacity(st2)
    if cap < 64
        print("FAIL capacity: got=" + str(cap) + " want>=64")
        exit(1)

    // --- KAT 7: re-add after grow — items still found across sub-filters ---
    let st3 = sbf_new(16, 2)
    let k2 = 0
    while k2 < 100
        sbf_add(st3, "item" + str(k2))
        k2 = k2 + 1
    cki("k7_count", sbf_count_added(st3), 100)
    let nf3 = sbf_num_filters(st3)
    if nf3 <= 1
        print("FAIL k7_must_grow: filters=" + str(nf3))
        exit(1)
    let k3 = 0
    while k3 < 100
        let it = "item" + str(k3)
        if sbf_contains(st3, it) == false
            print("FAIL k7_no_fn: item=" + it)
            exit(1)
        k3 = k3 + 1

    print("PASS _bloomscalable_test")

main()
