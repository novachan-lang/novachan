import forge_gameoflife

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn rm(g: list) -> string
    let out = ""
    let i = 0
    while i < len(g)
        if i > 0
            out = out + "|"
        let j = 0
        while j < len(g[i])
            out = out + str(g[i][j])
            j = j + 1
        i = i + 1
    out

fn main()
    let fails = 0

    // blinker (period-2 oscillator): horizontal -> vertical -> horizontal
    let blinker = []
    push(blinker, [0, 0, 0])
    push(blinker, [1, 1, 1])
    push(blinker, [0, 0, 0])
    let gen1 = next_generation(blinker)
    fails = fails + expect("blinker_v", rm(gen1), "010|010|010")
    let gen2 = next_generation(gen1)
    fails = fails + expect("blinker_h", rm(gen2), "000|111|000")
    // run 2 steps returns to start
    fails = fails + expect("blinker_period", rm(life_run(blinker, 2)), rm(blinker))

    // block (still life) -> unchanged
    let block = []
    push(block, [1, 1])
    push(block, [1, 1])
    fails = fails + expect("block", rm(next_generation(block)), "11|11")

    // single cell dies (0 neighbors)
    let single = []
    push(single, [0, 0, 0])
    push(single, [0, 1, 0])
    push(single, [0, 0, 0])
    fails = fails + expect("single_dies", rm(next_generation(single)), "000|000|000")

    // population counting
    fails = fails + expect("pop_blinker", str(life_population(blinker)), "3")
    fails = fails + expect("pop_block", str(life_population(block)), "4")

    // a dead cell with exactly 3 neighbors is born (L-tromino corner fills in to a block)
    let ltri = []
    push(ltri, [1, 1, 0])
    push(ltri, [1, 0, 0])
    push(ltri, [0, 0, 0])
    fails = fails + expect("birth", rm(next_generation(ltri)), "110|110|000")

    if fails == 0
        print("forge_gameoflife: all passed")
    else
        print("forge_gameoflife: " + str(fails) + " FAILED")
