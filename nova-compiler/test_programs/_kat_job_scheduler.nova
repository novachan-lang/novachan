import forge_job_scheduler

fn main()
    let js = js_new()
    js = js_add_job(js, "cleanup", 3600)
    js = js_add_job(js, "report", 86400)
    js = js_add_job(js, "healthcheck", 60)
    assert(js_job_count(js) == 3, "3 jobs")

    assert(js_is_due(js, "cleanup", 3600) == 1, "cleanup due at 3600")
    assert(js_is_due(js, "cleanup", 1000) == 0, "cleanup not due at 1000")
    assert(js_is_due(js, "healthcheck", 60) == 1, "healthcheck due at 60")

    js = js_mark_run(js, "cleanup", 3600, "success")
    assert(js_run_count(js, "cleanup") == 1, "cleanup ran once")
    assert(js_is_due(js, "cleanup", 5000) == 0, "not due yet after run")
    assert(js_is_due(js, "cleanup", 7200) == 1, "due again at 7200")

    js = js_mark_run(js, "healthcheck", 60, "success")
    js = js_mark_run(js, "healthcheck", 120, "success")
    assert(js_run_count(js, "healthcheck") == 2, "healthcheck ran 2x")

    js = js_disable(js, "report")
    assert(js_is_due(js, "report", 100000) == 0, "disabled not due")
    js = js_enable(js, "report")
    assert(js_is_due(js, "report", 100000) == 1, "re-enabled and due")

    assert(js_run_count(js, "missing") == 0, "missing job=0")
    assert(js_is_due(js, "missing", 100) == 0, "missing=not due")

    let hist = js_history(js)
    assert(len(hist) == 3, "3 history entries")
    assert(hist[0]["job"] == "cleanup", "first=cleanup")
    assert(hist[0]["status"] == "success", "success")

    print("JOB-SCHEDULER KAT PASS")
