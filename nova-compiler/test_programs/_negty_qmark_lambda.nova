// NEGATIVE: `?` inside a lambda MUST be rejected (WEAPON_PARITY_PLAN 1.5).
//
// `?` lowers to a `return` of the wrapped error. Inside a lambda that lowering is
// lifted into a separate function, so the `return` leaves the LAMBDA, not the
// enclosing fn -- `map` then treats the error as an ordinary element and pushes it
// into the list. The result compiled clean, ran, and produced a list with an error
// struct silently embedded in it. Fail CLOSED instead: reject, and name the
// alternatives.
//
// The diagnostic exists (ti_infer_expr, `tag == "lambda"`) but nothing gated it,
// so a refactor of the lambda inference path could have silently removed it and no
// test would have noticed.

fn leaf(x: int) -> Result
    if x < 0
        return err("negative")
    ok(x * 2)

fn main()
    let xs = [1, 2, 0 - 3]
    // MUST be rejected: the `?` here cannot propagate to main().
    let doubled = map(xs, fn(x) leaf(x)?)
    print(str(len(doubled)))
