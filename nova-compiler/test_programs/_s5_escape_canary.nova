// _s5_escape_canary.nova — escaping struct ANTI-REGRESSION canary
// The SAME all-scalar struct type is used in BOTH escaping and non-escaping
// contexts. Functions that receive an escaping struct must NOT be
// scalarized. Output must be identical flag-ON vs OFF.

type Pt
    x: float
    y: float

// Non-escaping leaf (could be eligible for by-value if all callers agree)
fn add_pts(a: Pt, b: Pt) -> float
    a.x + b.x + a.y + b.y

// This function makes the struct ESCAPE: stores in a list
fn escape_to_list(p: Pt) -> list
    let result = [p]
    result

// This function makes the struct ESCAPE: returns it
fn escape_return(p: Pt) -> Pt
    p

// This function makes the struct ESCAPE: passes to str (any-typed)
fn escape_to_str(p: Pt) -> string
    str(p)

fn main()
    let a = Pt(1.0, 2.0)
    let b = Pt(3.0, 4.0)

    // Non-escaping path (may be scalarized)
    let s = add_pts(a, b)
    print(s)

    // Escaping path: store in list
    let lst = escape_to_list(a)
    print(len(lst))

    // Escaping path: return struct
    let r = escape_return(b)
    print(r.x)
    print(r.y)

    // Escaping path: to_str
    let sv = escape_to_str(a)
    print(sv)

    // Mix: use same struct in both paths
    let c = Pt(5.0, 6.0)
    let mixed = add_pts(c, a)
    print(mixed)

    print("escape_canary_done")
