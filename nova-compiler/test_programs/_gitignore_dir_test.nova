import std/devtool/gitignore_dir

fn main()
    // --- gid_is_dir_only ---
    let r1 = gid_is_dir_only("build/")
    if r1 != 1
        print("FAIL gid_is_dir_only-slash: got " + str(r1) + " want 1")
        exit(1)

    let r2 = gid_is_dir_only("build")
    if r2 != 0
        print("FAIL gid_is_dir_only-noslash: got " + str(r2) + " want 0")
        exit(1)

    let r3 = gid_is_dir_only("")
    if r3 != 0
        print("FAIL gid_is_dir_only-empty: got " + str(r3) + " want 0")
        exit(1)

    let r4 = gid_is_dir_only("/")
    if r4 != 1
        print("FAIL gid_is_dir_only-lone-slash: got " + str(r4) + " want 1")
        exit(1)

    // --- gid_strip_trailing_slash ---
    let r5 = gid_strip_trailing_slash("build/")
    if r5 != "build"
        print("FAIL gid_strip_trailing_slash-slash: got " + r5 + " want build")
        exit(1)

    let r6 = gid_strip_trailing_slash("build")
    if r6 != "build"
        print("FAIL gid_strip_trailing_slash-noslash: got " + r6 + " want build")
        exit(1)

    let r7 = gid_strip_trailing_slash("")
    if r7 != ""
        print("FAIL gid_strip_trailing_slash-empty: got '" + r7 + "' want ''")
        exit(1)

    // --- gid_should_check ---
    let r8 = gid_should_check("build/", 1)
    if r8 != 1
        print("FAIL gid_should_check-dironly-isdir: got " + str(r8) + " want 1")
        exit(1)

    let r9 = gid_should_check("build/", 0)
    if r9 != 0
        print("FAIL gid_should_check-dironly-notdir: got " + str(r9) + " want 0")
        exit(1)

    let r10 = gid_should_check("*.log", 0)
    if r10 != 1
        print("FAIL gid_should_check-universal-file: got " + str(r10) + " want 1")
        exit(1)

    let r11 = gid_should_check("*.log", 1)
    if r11 != 1
        print("FAIL gid_should_check-universal-dir: got " + str(r11) + " want 1")
        exit(1)

    // --- gid_classify ---
    let patterns = []
    push(patterns, "*.log")
    push(patterns, "build/")
    push(patterns, "")
    push(patterns, "# a comment")
    push(patterns, "node_modules/")
    push(patterns, "!keep.log")
    push(patterns, "   ")

    let classified = gid_classify(patterns)
    let dir_only = classified[0]
    let universal = classified[1]

    if len(dir_only) != 2
        print("FAIL gid_classify-dironly-len: got " + str(len(dir_only)) + " want 2")
        exit(1)
    if dir_only[0] != "build/" or dir_only[1] != "node_modules/"
        print("FAIL gid_classify-dironly-content: got " + dir_only[0] + "," + dir_only[1])
        exit(1)

    if len(universal) != 2
        print("FAIL gid_classify-universal-len: got " + str(len(universal)) + " want 2")
        exit(1)
    if universal[0] != "*.log" or universal[1] != "!keep.log"
        print("FAIL gid_classify-universal-content: got " + universal[0] + "," + universal[1])
        exit(1)

    // --- gid_classify: all-blank/comment input yields two empty lists ---
    let empties = []
    push(empties, "")
    push(empties, "# nothing here")
    push(empties, "   ")
    let classified2 = gid_classify(empties)
    if len(classified2[0]) != 0 or len(classified2[1]) != 0
        print("FAIL gid_classify-allblank: got dironly=" + str(len(classified2[0])) + " universal=" + str(len(classified2[1])))
        exit(1)

    print("PASS _gitignore_dir_test")
