// Self-contained regression test for std/os/glob: builds its own on-disk tree with make_dir+write_file,
// exercises * ? ** (at 3 depths, no dupes, files+dirs), then cleans up. Uses only committed + this-batch
// builtins (make_dir/write_file/remove_file/remove_dir).
import std/os/glob

fn _has(xs: any, x: string) -> bool
    for e in xs
        if e == x
            return true
    return false

fn _expect(label: string, got: any, want: int)
    if len(got) != want
        print("FAIL " + label + ": got " + str(len(got)) + " want " + str(want))
        let i = 0
        while i < len(got)
            print("   - " + got[i])
            i = i + 1
        exit(1)

fn main()
    let base = "_globtree"
    // tear down any stale tree first (best-effort)
    remove_file(base + "/a.nova")
    remove_file(base + "/b.txt")
    remove_file(base + "/sub/c.nova")
    remove_file(base + "/sub/deep/d.nova")
    remove_file(base + "/sub2/e.txt")
    remove_dir(base + "/sub/deep")
    remove_dir(base + "/sub")
    remove_dir(base + "/sub2")
    remove_dir(base)

    // build the tree
    make_dir(base)
    make_dir(base + "/sub")
    make_dir(base + "/sub/deep")
    make_dir(base + "/sub2")
    write_file(base + "/a.nova", "")
    write_file(base + "/b.txt", "")
    write_file(base + "/sub/c.nova", "")
    write_file(base + "/sub/deep/d.nova", "")
    write_file(base + "/sub2/e.txt", "")

    let a = glob(base + "/*.nova")
    _expect("*.nova", a, 1)
    if not _has(a, base + "/a.nova")
        print("FAIL *.nova membership")
        exit(1)

    let star = glob(base + "/*")
    _expect("* (files+dirs)", star, 4)

    let q = glob(base + "/?.nova")
    _expect("?.nova", q, 1)

    let recn = glob(base + "/**/*.nova")
    _expect("**/*.nova", recn, 3)
    if not _has(recn, base + "/a.nova")
        print("FAIL ** zero-segment (a.nova)")
        exit(1)
    if not _has(recn, base + "/sub/c.nova")
        print("FAIL ** one-segment (sub/c.nova)")
        exit(1)
    if not _has(recn, base + "/sub/deep/d.nova")
        print("FAIL ** two-segment (sub/deep/d.nova)")
        exit(1)

    let rect = glob(base + "/**/*.txt")
    _expect("**/*.txt", rect, 2)

    let sub = glob(base + "/sub/*.nova")
    _expect("sub/*.nova", sub, 1)

    let none = glob(base + "/nomatch*")
    _expect("no-match -> empty", none, 0)

    // clean up
    remove_file(base + "/a.nova")
    remove_file(base + "/b.txt")
    remove_file(base + "/sub/c.nova")
    remove_file(base + "/sub/deep/d.nova")
    remove_file(base + "/sub2/e.txt")
    remove_dir(base + "/sub/deep")
    remove_dir(base + "/sub")
    remove_dir(base + "/sub2")
    remove_dir(base)

    print("ok glob probe: * ? ** all correct (7 patterns), self-contained tree")
