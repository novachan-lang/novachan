import std/tensor/tsr_reduce

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL " + label + " got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: str, got: int, want: int)
    if got != want
        print("FAIL " + label + " got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(label: str, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + " len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL " + label + "[" + str(i) + "] got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn ckt(label: str, t: list, want_flat: list, want_shape: list)
    let flat = t[0]
    let shape = t[1]
    if len(flat) != len(want_flat)
        print("FAIL " + label + " flat len got=" + str(len(flat)) + " want=" + str(len(want_flat)))
        exit(1)
    let i = 0
    while i < len(flat)
        if flat[i] != want_flat[i]
            print("FAIL " + label + " flat[" + str(i) + "] got=" + str(flat[i]) + " want=" + str(want_flat[i]))
            exit(1)
        i = i + 1
    if len(shape) != len(want_shape)
        print("FAIL " + label + " shape len got=" + str(len(shape)) + " want=" + str(len(want_shape)))
        exit(1)
    let j = 0
    while j < len(shape)
        if shape[j] != want_shape[j]
            print("FAIL " + label + " shape[" + str(j) + "] got=" + str(shape[j]) + " want=" + str(want_shape[j]))
            exit(1)
        j = j + 1

fn main()
    // Build test tensors
    // 2x2 matrix: [[1,2],[3,4]] -> flat=[1,2,3,4] shape=[2,2]
    let flat22 = []
    push(flat22, 1)
    push(flat22, 2)
    push(flat22, 3)
    push(flat22, 4)
    let shape22 = []
    push(shape22, 2)
    push(shape22, 2)
    let t22 = []
    push(t22, flat22)
    push(t22, shape22)

    // 1-D vector [1,2,3] -> flat=[1,2,3] shape=[3]
    let flat1d = []
    push(flat1d, 3)
    push(flat1d, 1)
    push(flat1d, 2)
    let shape1d = []
    push(shape1d, 3)
    let t1d = []
    push(t1d, flat1d)
    push(t1d, shape1d)

    // 1-D vector [1,5,3] -> flat=[1,5,3] shape=[3]
    let flatam = []
    push(flatam, 1)
    push(flatam, 5)
    push(flatam, 3)
    let shapeam = []
    push(shapeam, 3)
    let tam = []
    push(tam, flatam)
    push(tam, shapeam)

    // KAT: td_sum([[1,2,3,4],[2,2]])=10
    cki("td_sum 2x2", td_sum(t22), 10)

    // KAT: td_prod([[1,2,3,4],[2,2]])=24
    cki("td_prod 2x2", td_prod(t22), 24)

    // KAT: td_max([[1,2,3,4],[2,2]])=4
    cki("td_max 2x2", td_max(t22), 4)

    // KAT: td_min([[3,1,2],[3]])=1  (note: t1d is [3,1,2])
    cki("td_min 1d", td_min(t1d), 1)

    // KAT: td_argmax([[1,5,3],[3]])=1
    cki("td_argmax 1d", td_argmax(tam), 1)

    // KAT: td_sum_axis([[1,2,3,4],[2,2]],0) -> flat=[4,6] shape=[2]
    let sa0 = td_sum_axis(t22, 0)
    let wf0 = []
    push(wf0, 4)
    push(wf0, 6)
    let ws0 = []
    push(ws0, 2)
    ckt("td_sum_axis axis0", sa0, wf0, ws0)

    // KAT: td_sum_axis([[1,2,3,4],[2,2]],1) -> flat=[3,7] shape=[2]
    let sa1 = td_sum_axis(t22, 1)
    let wf1 = []
    push(wf1, 3)
    push(wf1, 7)
    let ws1 = []
    push(ws1, 2)
    ckt("td_sum_axis axis1", sa1, wf1, ws1)

    // KAT: td_mean_floor([[1,2,3,4],[2,2]])=2  (10/4=2)
    cki("td_mean_floor 2x2", td_mean_floor(t22), 2)

    // Extra: scalar tensor [[7],[]] sum=7, prod=7, max=7, min=7, argmax=0
    let flatsc = []
    push(flatsc, 7)
    let shapesc = []
    let tsc = []
    push(tsc, flatsc)
    push(tsc, shapesc)
    cki("td_sum scalar", td_sum(tsc), 7)
    cki("td_prod scalar", td_prod(tsc), 7)
    cki("td_max scalar", td_max(tsc), 7)
    cki("td_min scalar", td_min(tsc), 7)
    cki("td_argmax scalar", td_argmax(tsc), 0)
    cki("td_mean_floor scalar", td_mean_floor(tsc), 7)

    // Extra: empty tensor [[],[]] sum=0, prod=1, max=0, min=0, argmax=0, mean=0
    let flatem = []
    let shapeem = []
    push(shapeem, 0)
    let tem = []
    push(tem, flatem)
    push(tem, shapeem)
    cki("td_sum empty", td_sum(tem), 0)
    cki("td_prod empty", td_prod(tem), 1)
    cki("td_max empty", td_max(tem), 0)
    cki("td_min empty", td_min(tem), 0)
    cki("td_argmax empty", td_argmax(tem), 0)
    cki("td_mean_floor empty", td_mean_floor(tem), 0)

    print("PASS _tsr_reduce_test")
