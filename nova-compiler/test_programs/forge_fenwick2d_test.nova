import forge_fenwick2d

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    let bit = fw2_new(4, 4)
    fw2_update(bit, 0, 0, 1)
    fw2_update(bit, 1, 1, 5)
    fw2_update(bit, 2, 3, 3)

    fails = fails + expect("q00", str(fw2_query(bit, 0, 0)), "1")
    fails = fails + expect("q11", str(fw2_query(bit, 1, 1)), "6")
    fails = fails + expect("q33", str(fw2_query(bit, 3, 3)), "9")
    fails = fails + expect("rect_1123", str(fw2_rect_sum(bit, 1, 1, 2, 3)), "8")
    fails = fails + expect("rect_cell", str(fw2_rect_sum(bit, 0, 0, 0, 0)), "1")
    fails = fails + expect("rect_empty", str(fw2_rect_sum(bit, 3, 3, 3, 3)), "0")

    // updates accumulate + can be negative
    fw2_update(bit, 1, 1, 0 - 2)
    fails = fails + expect("after_dec", str(fw2_rect_sum(bit, 1, 1, 1, 1)), "3")

    // full brute-force cross-check: maintain a naive grid, do random-ish updates, compare all rectangle sums
    let R = 6
    let C = 7
    let bit2 = fw2_new(R, C)
    let grid = []
    let g = 0
    while g < R * C
        push(grid, 0)
        g = g + 1
    // apply a sequence of updates
    let ups = []
    push(ups, [0, 0, 3])
    push(ups, [5, 6, 7])
    push(ups, [2, 3, 4])
    push(ups, [2, 3, 1])
    push(ups, [4, 1, 0 - 2])
    push(ups, [3, 5, 9])
    push(ups, [0, 6, 6])
    let u = 0
    while u < len(ups)
        let ru = ups[u][0]
        let cu = ups[u][1]
        let dv = ups[u][2]
        fw2_update(bit2, ru, cu, dv)
        grid[ru * C + cu] = grid[ru * C + cu] + dv
        u = u + 1
    // check EVERY rectangle sum against brute force
    let ok = 1
    let r1 = 0
    while r1 < R
        let c1 = 0
        while c1 < C
            let r2 = r1
            while r2 < R
                let c2 = c1
                while c2 < C
                    // brute sum
                    let bsum = 0
                    let a = r1
                    while a <= r2
                        let b = c1
                        while b <= c2
                            bsum = bsum + grid[a * C + b]
                            b = b + 1
                        a = a + 1
                    if fw2_rect_sum(bit2, r1, c1, r2, c2) != bsum
                        ok = 0
                    c2 = c2 + 1
                r2 = r2 + 1
            c1 = c1 + 1
        r1 = r1 + 1
    fails = fails + expect("brute_all_rects", str(ok), "1")

    if fails == 0
        print("forge_fenwick2d: all passed")
    else
        print("forge_fenwick2d: " + str(fails) + " FAILED")
