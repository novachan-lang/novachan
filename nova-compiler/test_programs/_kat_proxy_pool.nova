import forge_proxy_pool

fn main()
    let p = pp_new()
    p = pp_add_proxy(p, "proxy1:8080")
    p = pp_add_proxy(p, "proxy2:8080")
    p = pp_add_proxy(p, "proxy3:8080")
    assert(pp_proxy_count(p) == 3, "3 proxies")

    let r1 = pp_next(p)
    assert(is_ok(r1), "next ok")
    let addr1 = unwrap(r1)
    assert(addr1 == "proxy1:8080", "first proxy")

    let r2 = pp_next(p)
    assert(unwrap(r2) == "proxy2:8080", "second proxy")

    let f = pp_mark_failed(p, 2)
    assert(is_ok(f), "mark failed ok")
    p = unwrap(f)
    assert(pp_failure_count(p) == 1, "1 failure")

    let r3 = pp_next(p)
    assert(unwrap(r3) == "proxy1:8080", "skipped failed")

    assert(pp_total_requests(p) == 3, "3 total")

    let bad = pp_mark_failed(p, 10)
    assert(is_err(bad), "out of range")

    print("PROXY-POOL KAT PASS")
