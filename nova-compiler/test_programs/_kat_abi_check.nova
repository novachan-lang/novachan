import forge_abi_check

fn main()
    let s = abi_new()
    s = abi_add_fn(s, "auth", "login", "string,string", "Result")
    s = abi_add_fn(s, "auth", "logout", "string", "int")
    s = abi_add_fn(s, "auth", "refresh", "string", "Result")
    assert(abi_fn_count(s) == 3, "3 fns tracked")
    assert(abi_has_fn(s, "auth", "login") == 1, "login tracked")
    assert(abi_has_fn(s, "auth", "nope") == 0, "nope not tracked")

    let gp = abi_get_params(s, "auth", "login")
    assert(is_ok(gp), "get params ok")
    assert(unwrap(gp) == "string,string", "login params")

    let gr = abi_get_ret(s, "auth", "logout")
    assert(is_ok(gr), "get ret ok")
    assert(unwrap(gr) == "int", "logout ret")

    // step 2: snapshot
    s = abi_snapshot(s)
    assert(abi_snap_count(s) == 1, "1 snapshot taken")

    // no drift yet -> compatible
    let c0 = abi_compare(s)
    assert(is_ok(c0), "compare0 ok")
    assert(unwrap(c0) == "compatible", "no drift yet")
    assert(abi_break_count(s) == 0, "0 breaks pre-drift")

    // step 3: remove logout -> BREAKING
    let rm = abi_remove_fn(s, "auth", "logout")
    assert(is_ok(rm), "remove ok")
    s = unwrap(rm)
    assert(abi_fn_count(s) == 2, "2 fns after remove")

    let c1 = abi_compare(s)
    assert(is_ok(c1), "compare1 ok")
    assert(abi_break_count(s) == 1, "1 break after removal")
    assert(contains(abi_breaking_changes(s), "removed:auth.logout") == true, "removal reported")

    // step 4: change params on refresh -> BREAKING (cumulative with the removal)
    let ch = abi_change_fn(s, "auth", "refresh", "string,int", "Result")
    assert(is_ok(ch), "change ok")
    s = unwrap(ch)

    let c2 = abi_compare(s)
    assert(is_ok(c2), "compare2 ok")
    assert(abi_break_count(s) == 2, "2 breaks after param change")
    assert(contains(abi_breaking_changes(s), "params-changed:auth.refresh") == true, "param change reported")
    assert(contains(abi_breaking_changes(s), "removed:auth.logout") == true, "removal still reported")

    // step 5: add a brand new function -> additive/COMPATIBLE, does not raise break_count
    s = abi_add_fn(s, "auth", "revoke", "string", "int")
    assert(abi_fn_count(s) == 3, "3 fns after addition")

    let c3 = abi_compare(s)
    assert(is_ok(c3), "compare3 ok")
    assert(abi_break_count(s) == 2, "still 2 breaks (addition is compatible)")
    assert(contains(abi_breaking_changes(s), "revoke") == false, "new fn not in break list")

    // change on return type alone is also breaking
    let chr = abi_change_fn(s, "auth", "login", "string,string", "int")
    assert(is_ok(chr), "ret change ok")
    s = unwrap(chr)
    let c4 = abi_compare(s)
    assert(is_ok(c4), "compare4 ok")
    assert(abi_break_count(s) == 3, "3 breaks after ret-type change")
    assert(contains(abi_breaking_changes(s), "ret-changed:auth.login") == true, "ret change reported")

    // missing-fn errors
    let bad1 = abi_get_params(s, "auth", "ghost")
    assert(is_err(bad1), "ghost params err")
    let bad2 = abi_remove_fn(s, "auth", "ghost")
    assert(is_err(bad2), "ghost remove err")
    let bad3 = abi_change_fn(s, "auth", "ghost", "x", "y")
    assert(is_err(bad3), "ghost change err")

    print("ABI-CHECK KAT PASS")
