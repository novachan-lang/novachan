// leak_baseline_test.nova -- Stage 0 oracle for NOVA_DESIGN/RC_COMPLETENESS.md.
// NOVA's RC is currently a PARTIAL count: reassigning / loop-rebinding a heap local does NOT
// rc_dec the old value (slot_store is a bare store), so heap loop-locals leak ~1 struct per
// iteration -- for list, dict, AND channel alike (NOT channel-specific). This guard PINS that
// baseline: it FAILS if the per-iteration leak gets WORSE (a regression adding per-iter heap that
// also leaks, e.g. an extra per-call channel), and prints the actual deltas so that when total
// reference counting (NOVA_T8_FULLRC, Stage 3) lands, the drop toward ~0 is visible (tighten then).
fn main()
    let b0 = live_count()
    let i = 0
    while i < 2000
        let x = [i, i + 1, i + 2]
        let _u = len(x)
        i = i + 1
    let list_delta = live_count() - b0
    let b1 = live_count()
    let j = 0
    while j < 2000
        let d = {"a": j}
        let _v = len(d)
        j = j + 1
    let dict_delta = live_count() - b1
    let b2 = live_count()
    let k = 0
    while k < 2000
        let c = channel()
        send(c, 1)
        let _w = receive(c)
        k = k + 1
    let chan_delta = live_count() - b2
    print("leak_baseline list=" + str(list_delta) + " dict=" + str(dict_delta) + " chan=" + str(chan_delta))
    // Guard: FULLRC is default-ON (cfcd085+c4da4aa), so list/dict/chan reassignment drops fire.
    // Expected: list=1 dict=1 chan=1 (the single allocation surviving the last loop iteration).
    // Fail if any delta exceeds 10 (regression would mean drops stopped firing).
    if list_delta > 10 or dict_delta > 10 or chan_delta > 10
        print("leak_baseline_test FAILED: FULLRC drops not firing (expected ~1, got list=" + str(list_delta) + " dict=" + str(dict_delta) + " chan=" + str(chan_delta) + ")")
        exit(1)
    print("leak_baseline_test passed (baseline pinned; see NOVA_DESIGN/RC_COMPLETENESS.md)")
