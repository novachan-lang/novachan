// KAT for std/physics/optics_wave — wave optics formulas.
import std/physics/optics_wave

// approx — absolute tolerance 0.001 for normal magnitudes.
fn approx(a, b)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < 0.001

// approx_rel — relative tolerance for very small/large values.
fn approx_rel(a, b, tol)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    let ref = b
    if ref < 0.0
        ref = 0.0 - ref
    if ref < 0.000000001
        return d < tol
    let ratio = d / ref
    return ratio < tol

fn ck(label, got, want)
    if not approx(got, want)
        print("FAIL optics_wave " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // double_slit_fringe: y = lambda * L / d
    // lambda=5e-7m, L=1m, d=1e-3m -> y=5e-4=0.0005
    // Encoded without scientific notation:
    // lambda = 0.0000005, d = 0.001
    let lam = 0.0000005
    let d = 0.001
    let y = double_slit_fringe(lam, 1.0, d)
    if not approx_rel(y, 0.0005, 0.001)
        print("FAIL optics_wave double_slit_fringe: got " + str(y) + " want 0.0005")
        exit(1)
    // lambda=600e-9=0.0000006, L=2.0, d=0.0002 -> y=0.006
    let y2 = double_slit_fringe(0.0000006, 2.0, 0.0002)
    if not approx_rel(y2, 0.006, 0.001)
        print("FAIL optics_wave double_slit_fringe(600nm,2m,0.2mm): got " + str(y2) + " want 0.006")
        exit(1)

    // critical_angle_sin: sin(tc) = n2/n1
    // n1=1.5, n2=1.0 -> 1.0/1.5 = 0.6667
    let ca = critical_angle_sin(1.5, 1.0)
    if not approx_rel(ca, 0.6667, 0.001)
        print("FAIL optics_wave critical_angle_sin(1.5,1.0): got " + str(ca) + " want ~0.6667")
        exit(1)
    // n1=2.0, n2=1.0 -> 0.5
    ck("critical_angle_sin(2.0,1.0)", critical_angle_sin(2.0, 1.0), 0.5)
    // n1=1.3, n2=1.0 -> 1/1.3 = 0.7692
    let ca2 = critical_angle_sin(1.3, 1.0)
    if not approx_rel(ca2, 0.7692, 0.001)
        print("FAIL optics_wave critical_angle_sin(1.3,1.0): got " + str(ca2) + " want ~0.7692")
        exit(1)

    // grating_angle_sin: sin(t) = m*lambda/d
    // order=1, lambda=500e-9=0.0000005, spacing=0.000001 -> sin=0.5
    let ga = grating_angle_sin(1.0, 0.0000005, 0.000001)
    ck("grating_angle_sin(1,500nm,1um)", ga, 0.5)
    // order=2, lambda=0.0000005, spacing=0.000002 -> sin=2*5e-7/2e-6=0.5
    let ga2 = grating_angle_sin(2.0, 0.0000005, 0.000002)
    ck("grating_angle_sin(2,500nm,2um)", ga2, 0.5)
    // order=1, lambda=0.0000006, spacing=0.000001 -> sin=0.6
    let ga3 = grating_angle_sin(1.0, 0.0000006, 0.000001)
    ck("grating_angle_sin(1,600nm,1um)", ga3, 0.6)

    print("PASS _optics_wave_test")
