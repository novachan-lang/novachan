// Does a TYPED read silently DROP any PostgreSQL row containing a NULL?
import forge_orm
type NRow
    id: int
    label: string
    bn: int
fn main()
    let db = unwrap(orm_open_with_pool("postgres://postgres:root@127.0.0.1:5432/postgres", 2))
    _ = orm_exec(db, "DROP TABLE IF EXISTS nulldrop", [])
    _ = orm_exec(db, "CREATE TABLE nulldrop (id int, label text, bn int)", [])
    // 3 fully-populated rows, then one row with a NULL id, then one with a NULL text
    _ = orm_exec(db, "INSERT INTO nulldrop (id,label,bn) VALUES (1,'a',10)", [])
    _ = orm_exec(db, "INSERT INTO nulldrop (id,label,bn) VALUES (2,'b',20)", [])
    _ = orm_exec(db, "INSERT INTO nulldrop (id,label,bn) VALUES (3,'c',30)", [])
    _ = orm_exec(db, "INSERT INTO nulldrop (label,bn) VALUES ('nullid',40)", [])
    _ = orm_exec(db, "INSERT INTO nulldrop (id,bn) VALUES (5,50)", [])
    let cnt = orm_count(db, "nulldrop", "", [])
    let untyped = orm_all(db, "SELECT id,label,bn FROM nulldrop ORDER BY bn", [])
    let typed: list<NRow> = orm_all(db, "SELECT id,label,bn FROM nulldrop ORDER BY bn", [])
    print("orm_count      = {cnt}   (5 rows inserted)")
    print("untyped read   = {len(untyped)}")
    print("TYPED read     = {len(typed)}")
    print("--- untyped rows ---")
    for r in untyped
        print("  id={str(r["id"])} label={str(r["label"])} bn={str(r["bn"])}")
    print("--- typed rows ---")
    for t in typed
        print("  id={t.id} label={t.label} bn={t.bn}")
    _ = orm_exec(db, "DROP TABLE IF EXISTS nulldrop", [])
    orm_close(db)
