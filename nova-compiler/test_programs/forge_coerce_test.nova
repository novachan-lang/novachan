// forge_coerce_test -- Phase 1 incr-6: "return your type, get a Response".
// A handler may return a bare string, a domain struct, a list, OR an explicit Response.
// dispatch_req runs the result through _coerce: Response -> passthrough; string -> 200 text;
// anything else (struct/list/dict/scalar) -> 200 JSON via the RTTI keystone. Zero ceremony --
// no framework in the comparison set lets a handler return its own domain type and get correct
// JSON without an explicit serializer call or annotation.
import forge

type Note
    id: int
    text: string

fn h_str(req: Request) -> string
    "hello-bare-string"

fn h_note(req: Request) -> Note
    Note(1, "buy milk")

fn h_list(req: Request) -> list
    [1, 2, 3]

fn h_resp(req: Request) -> Response
    forge.resp_text(201, "explicit")

fn main()
    let q = chr(34)
    let a = forge.app()
    forge.get(a, "/str", h_str)
    forge.get(a, "/note", h_note)
    forge.get(a, "/list", h_list)
    forge.get(a, "/resp", h_resp)

    // bare string -> 200 text/plain, body passthrough
    let rs: Response = forge.dispatch_req(a, forge.build_request("GET /str HTTP/1.1\r\n\r\n", 0))
    assert(rs.status == 200, "string -> 200")
    assert(rs.body == "hello-bare-string", "string body passthrough")
    print("PASS: bare string -> 200 text")

    // bare struct -> 200 JSON object (RTTI keystone recovers field names through `any`)
    let rn: Response = forge.dispatch_req(a, forge.build_request("GET /note HTTP/1.1\r\n\r\n", 0))
    assert(rn.status == 200, "struct -> 200")
    assert(find(rn.body, q + "id" + q + ":1") >= 0, "struct json id")
    assert(find(rn.body, q + "text" + q + ":" + q + "buy milk" + q) >= 0, "struct json text")
    print("PASS: bare struct -> 200 JSON")

    // bare list -> 200 JSON array
    let rl: Response = forge.dispatch_req(a, forge.build_request("GET /list HTTP/1.1\r\n\r\n", 0))
    assert(rl.status == 200, "list -> 200")
    assert(find(rl.body, "[1,2,3]") >= 0, "list json array")
    print("PASS: bare list -> 200 JSON array")

    // explicit Response -> passthrough (status + body preserved, not re-wrapped)
    let rr: Response = forge.dispatch_req(a, forge.build_request("GET /resp HTTP/1.1\r\n\r\n", 0))
    assert(rr.status == 201, "Response passthrough -> 201")
    assert(rr.body == "explicit", "Response body passthrough")
    print("PASS: explicit Response passthrough")
    print("forge_coerce_test passed")
