import forge_bwt

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn roundtrip(s: string) -> string
    let t = bwt_transform(s)
    bwt_inverse(t[0], t[1])

fn main()
    let fails = 0

    // exact forward transform for the canonical "banana" example
    let bt = bwt_transform("banana")
    fails = fails + expect("banana_col", bt[0], "nnbaaa")
    fails = fails + expect("banana_primary", str(bt[1]), "3")

    // inverse recovers original
    fails = fails + expect("banana_inv", bwt_inverse("nnbaaa", 3), "banana")

    // round-trips over varied inputs
    fails = fails + expect("rt_banana", roundtrip("banana"), "banana")
    fails = fails + expect("rt_miss", roundtrip("mississippi"), "mississippi")
    fails = fails + expect("rt_abra", roundtrip("abracadabra"), "abracadabra")
    fails = fails + expect("rt_hello", roundtrip("hello world"), "hello world")
    fails = fails + expect("rt_single", roundtrip("Q"), "Q")
    fails = fails + expect("rt_same", roundtrip("aaaaaa"), "aaaaaa")
    fails = fails + expect("rt_empty", roundtrip(""), "")
    fails = fails + expect("rt_rev", roundtrip("dcba"), "dcba")
    fails = fails + expect("rt_mixed", roundtrip("The quick brown fox!"), "The quick brown fox!")
    fails = fails + expect("rt_digits", roundtrip("3141592653589"), "3141592653589")

    // clustering effect: BWT of a string with repeated context groups like chars together.
    // "^BANANA^" style -- verify the transform of a repetitive string has more runs than the original.
    // Simple demonstrable case: transform groups the a's in banana ("nnbaaa" has a run of 3 a's)
    fails = fails + expect("cluster_run", bwt_transform("banana")[0], "nnbaaa")

    if fails == 0
        print("forge_bwt: all passed")
    else
        print("forge_bwt: " + str(fails) + " FAILED")
