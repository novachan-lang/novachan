// _code128_test.nova — KAT for std/barcode/code128
//
// Code 128 known-answer tests:
//   - Code Set B character values (ord - 32)
//   - valid text detection
//   - checksum computation for known symbol sequences
//   - determinism

import std/barcode/code128

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── KAT 1: Code Set B character values ────────────────────────────────────
    // space (ASCII 32) -> value 0
    cki("b_value_space", code128b_value(chr(32)), 0)
    // '!' (33) -> 1
    cki("b_value_bang",  code128b_value("!"), 1)
    // 'A' (65) -> 33
    cki("b_value_A",     code128b_value("A"), 33)
    // 'B' (66) -> 34
    cki("b_value_B",     code128b_value("B"), 34)
    // 'Z' (90) -> 58
    cki("b_value_Z",     code128b_value("Z"), 58)
    // 'a' (97) -> 65
    cki("b_value_a",     code128b_value("a"), 65)
    // 'z' (122) -> 90
    cki("b_value_z",     code128b_value("z"), 90)
    // '0' (48) -> 16
    cki("b_value_0",     code128b_value("0"), 16)
    // '9' (57) -> 25
    cki("b_value_9",     code128b_value("9"), 25)
    // '~' (126) -> 94
    cki("b_value_tilde", code128b_value("~"), 94)

    // ── KAT 2: code128_valid ──────────────────────────────────────────────────
    cki("valid_Hello",   code128_valid("Hello"), 1)
    cki("valid_space",   code128_valid(" "),     1)
    cki("valid_tilde",   code128_valid("~"),     1)
    cki("valid_bang",    code128_valid("!"),     1)
    cki("valid_mixed",   code128_valid("ABC 123 xyz!"), 1)
    // empty string is invalid
    cki("valid_empty",   code128_valid(""),      0)
    // DEL (127) is out of range
    cki("valid_DEL",     code128_valid(chr(127)),0)
    // control char (newline, 10) is out of range
    cki("valid_newline", code128_valid(chr(10)), 0)

    // ── KAT 3: checksum for [104, 33, 34] (Start-B, 'A', 'B') ────────────────
    // = (104 + 1*33 + 2*34) mod 103
    // = (104 + 33 + 68) mod 103
    // = 205 mod 103 = 102
    let vals1 = []
    push(vals1, 104)
    push(vals1, 33)
    push(vals1, 34)
    cki("checksum_AB_startB", code128_checksum(vals1), 102)

    // ── KAT 4: checksum for [104] (Start-B only, no data) ────────────────────
    // = 104 mod 103 = 1
    let vals2 = []
    push(vals2, 104)
    cki("checksum_startB_only", code128_checksum(vals2), 1)

    // ── KAT 5: checksum for [103] (Start-A) ──────────────────────────────────
    // = 103 mod 103 = 0
    let vals3 = []
    push(vals3, 103)
    cki("checksum_startA_only", code128_checksum(vals3), 0)

    // ── KAT 6: checksum for [104, 16] (Start-B, '0') ─────────────────────────
    // '0' in Code Set B = ord('0') - 32 = 16
    // = (104 + 1*16) mod 103 = 120 mod 103 = 17
    let vals4 = []
    push(vals4, 104)
    push(vals4, 16)
    cki("checksum_0", code128_checksum(vals4), 17)

    // ── KAT 7: checksum for [104, 33, 34, 35] (Start-B, 'A', 'B', 'C') ───────
    // = (104 + 1*33 + 2*34 + 3*35) mod 103
    // = (104 + 33 + 68 + 105) mod 103
    // = 310 mod 103 = 310 - 3*103 = 310 - 309 = 1
    let vals5 = []
    push(vals5, 104)
    push(vals5, 33)
    push(vals5, 34)
    push(vals5, 35)
    cki("checksum_ABC", code128_checksum(vals5), 1)

    // ── KAT 8: result is always in 0..102 ─────────────────────────────────────
    let vals6 = []
    push(vals6, 104)
    push(vals6, 65)
    push(vals6, 90)
    push(vals6, 16)
    let cs = code128_checksum(vals6)
    if cs < 0 or cs > 102
        print("FAIL range: " + str(cs) + " out of 0..102")
        exit(1)

    // ── KAT 9: empty list returns 0 ───────────────────────────────────────────
    let vals7 = []
    cki("checksum_empty", code128_checksum(vals7), 0)

    // ── KAT 10: determinism ───────────────────────────────────────────────────
    let vals8 = []
    push(vals8, 104)
    push(vals8, 33)
    push(vals8, 34)
    let cs1 = code128_checksum(vals8)
    let vals9 = []
    push(vals9, 104)
    push(vals9, 33)
    push(vals9, 34)
    let cs2 = code128_checksum(vals9)
    cki("determinism", cs1, cs2)

    // ── KAT 11: 'Hello' valid, and b_value of 'H' is correct ─────────────────
    // 'H' = 72, Code Set B value = 72 - 32 = 40
    cki("b_value_H", code128b_value("H"), 40)
    cki("valid_Hello2", code128_valid("Hello"), 1)

    print("PASS _code128_test")
