@observable
type UserState
    name: string
    score: int
    active: int

@observable
type Counter
    value: int

fn main()
    assert(UserState__is_observable() == 1, "is observable")
    assert(UserState__observable_fields() == "name, score, active", "fields")

    assert(Counter__is_observable() == 1, "counter observable")
    assert(Counter__observable_fields() == "value", "counter fields")

    let u = UserState("Alice", 100, 1)
    assert(u.name == "Alice", "struct works")

    print("OBSERVABLE ANNOTATION TEST PASS")
