import forge_config_snapshot

fn main()
    let c = csn_new()
    c = csn_set(c, "db_host", "localhost")
    c = csn_set(c, "db_port", "5432")
    assert(csn_key_count(c) == 2, "2 keys")

    c = csn_snapshot(c, "initial")
    assert(csn_snap_count(c) == 1, "1 snapshot")

    c = csn_set(c, "db_host", "prod.example.com")
    c = csn_snapshot(c, "prod")
    assert(csn_snap_count(c) == 2, "2 snapshots")

    let r1 = csn_get(c, "db_host")
    assert(is_ok(r1), "get ok")
    assert(unwrap(r1) == "prod.example.com", "prod host")

    let l1 = csn_label(c, 0)
    assert(is_ok(l1), "label ok")
    assert(unwrap(l1) == "initial", "initial label")

    let l2 = csn_label(c, 1)
    assert(unwrap(l2) == "prod", "prod label")

    let bad = csn_get(c, "nope")
    assert(is_err(bad), "not found")

    let bad2 = csn_label(c, 5)
    assert(is_err(bad2), "out of range")

    print("CONFIG-SNAPSHOT KAT PASS")
