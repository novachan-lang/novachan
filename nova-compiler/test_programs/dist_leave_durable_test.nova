// Proves the leave-durability tombstone: a node that gracefully LEFT must stay down even if a stray gossip
// (touch) for it arrives afterwards; only an explicit rejoin revives it. White-box via the manager cmd_ch.
import clusterx

fn main()
    let info = cluster_start(19960, [])
    sleep(200)
    let ch = info["cmd_ch"]
    let fake = "127.0.0.1:39999"
    // add `fake` as a member
    let r1 = channel()
    send(ch, {"cmd": "merge_get", "members": [fake], "reply": r1})
    receive(r1)
    // it leaves (tombstone), then a STRAY gossip-touch arrives -> must NOT revive it
    send(ch, {"cmd": "mark_left", "addr": fake})
    send(ch, {"cmd": "touch", "addr": fake})
    sleep(50)
    let alive = cluster_alive(info)
    if contains(alive, fake)
        print("FAIL dist_leave_durable: tombstoned node revived by a stray touch")
        exit(1)
    // an explicit rejoin DOES revive it
    send(ch, {"cmd": "rejoin", "addr": fake})
    sleep(50)
    let alive2 = cluster_alive(info)
    if contains(alive2, fake)
        print("PASS dist_leave_durable (tombstone holds vs gossip; explicit rejoin revives)")
    else
        print("FAIL dist_leave_durable: rejoin did not revive")
        exit(1)
    exit(0)
