// _lowbits_test.nova — KAT for std/bits/lowbits
//
// Known-answer tests with hand-verified reference values.
// All bit arithmetic operates on i64 two's-complement patterns.
//
// Hand-traces:
//   lb_isolate_lowest(12): 12=0b1100; 0-12=-12 (two's comp); 12 & -12 = 0b0100 = 4
//   lb_clear_lowest(12):   12 & 11 = 0b1100 & 0b1011 = 0b1000 = 8
//   lb_mask_to_lowest(12): 12 ^ 11 = 0b1100 ^ 0b1011 = 0b0111 = 7
//   lb_lowest_index(12):   lowest bit = 4 = 2^2, index = 2
//   lb_set_lowest_clear(5): 5=0b101; 5|6=0b101|0b110=0b111=7
//   lb_trailing_ones(7):   0b111 → 3 trailing 1s
//   lb_trailing_ones(6):   0b110 → 0 trailing 1s (low bit is 0)

import std/bits/lowbits

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL lowbits " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: str, got: bool, want: bool)
    if got != want
        print("FAIL lowbits " + label + ": bool mismatch")
        exit(1)

fn main()
    // --- lb_isolate_lowest ---
    cki("isolate_lowest_12",   lb_isolate_lowest(12), 4)
    cki("isolate_lowest_0",    lb_isolate_lowest(0),  0)
    cki("isolate_lowest_1",    lb_isolate_lowest(1),  1)
    cki("isolate_lowest_8",    lb_isolate_lowest(8),  8)
    // 6 = 0b110; lowest bit = 0b010 = 2
    cki("isolate_lowest_6",    lb_isolate_lowest(6),  2)
    // negative: -4 = ...11100; lowest bit = 4
    cki("isolate_lowest_neg4", lb_isolate_lowest(0 - 4), 4)

    // --- lb_clear_lowest ---
    cki("clear_lowest_12",  lb_clear_lowest(12), 8)
    cki("clear_lowest_0",   lb_clear_lowest(0),  0)
    // 8 = 0b1000; 8 & 7 = 0
    cki("clear_lowest_8",   lb_clear_lowest(8),  0)
    // 7 = 0b111; 7 & 6 = 6
    cki("clear_lowest_7",   lb_clear_lowest(7),  6)
    // 1 → 0
    cki("clear_lowest_1",   lb_clear_lowest(1),  0)

    // --- lb_lowest_index ---
    cki("lowest_index_12",  lb_lowest_index(12), 2)
    cki("lowest_index_0",   lb_lowest_index(0),  -1)
    cki("lowest_index_1",   lb_lowest_index(1),  0)
    cki("lowest_index_8",   lb_lowest_index(8),  3)
    cki("lowest_index_16",  lb_lowest_index(16), 4)
    // 6 = 0b110; lowest bit index = 1
    cki("lowest_index_6",   lb_lowest_index(6),  1)

    // --- lb_set_lowest_clear ---
    cki("set_lowest_clear_5",  lb_set_lowest_clear(5), 7)
    // 0 = 0b0; lowest 0 bit is bit0; 0|1=1
    cki("set_lowest_clear_0",  lb_set_lowest_clear(0), 1)
    // 6 = 0b110; lowest 0 is bit0; 6|7=7
    cki("set_lowest_clear_6",  lb_set_lowest_clear(6), 7)
    // 7 = 0b111; lowest 0 is bit3; 7|8=15
    cki("set_lowest_clear_7",  lb_set_lowest_clear(7), 15)

    // --- lb_trailing_ones ---
    cki("trailing_ones_7",  lb_trailing_ones(7), 3)
    cki("trailing_ones_6",  lb_trailing_ones(6), 0)
    cki("trailing_ones_0",  lb_trailing_ones(0), 0)
    cki("trailing_ones_1",  lb_trailing_ones(1), 1)
    // 5 = 0b101; trailing 1s = 1 (low bit only)
    cki("trailing_ones_5",  lb_trailing_ones(5), 1)
    // 15 = 0b1111; 4 trailing 1s
    cki("trailing_ones_15", lb_trailing_ones(15), 4)

    // --- lb_mask_to_lowest ---
    cki("mask_to_lowest_12", lb_mask_to_lowest(12), 7)
    // 1 ^ 0 = 1
    cki("mask_to_lowest_1",  lb_mask_to_lowest(1),  1)
    // 4 = 0b100; 4^3 = 0b111 = 7
    cki("mask_to_lowest_4",  lb_mask_to_lowest(4),  7)
    // 8 = 0b1000; 8^7 = 0b1111 = 15
    cki("mask_to_lowest_8",  lb_mask_to_lowest(8),  15)
    // 0 ^ -1: NOVA i64 arithmetic: 0 ^ (0-1) = 0 ^ -1 = -1 (all ones)
    cki("mask_to_lowest_0",  lb_mask_to_lowest(0),  0 - 1)

    print("PASS _lowbits_test")
