// KAT test for std/graph/articulation_bridges.
import std/graph/articulation_bridges

fn cki(name, got, want)
    if got != want
        print("FAIL " + name + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("ok " + name)

fn ckb(name, got, want)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + name + ": got " + str(gi) + " want " + str(wi))
        exit(1)
    print("ok " + name)

fn ckl(name, got, want)
    if len(got) != len(want)
        print("FAIL " + name + ": len got " + str(len(got)) + " want " + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL " + name + ": got[" + str(i) + "]=" + str(got[i]) + " want " + str(want[i]))
            exit(1)
        i = i + 1
    print("ok " + name)

fn ckl2(name, got, want)
    if len(got) != len(want)
        print("FAIL " + name + ": len got " + str(len(got)) + " want " + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        let ge = got[i]
        let we = want[i]
        if ge[0] != we[0]
            print("FAIL " + name + ": edge[" + str(i) + "][0] got " + str(ge[0]) + " want " + str(we[0]))
            exit(1)
        if ge[1] != we[1]
            print("FAIL " + name + ": edge[" + str(i) + "][1] got " + str(ge[1]) + " want " + str(we[1]))
            exit(1)
        i = i + 1
    print("ok " + name)

fn main()
    // -- Test 1: path graph 0-1-2 (two bridges, one AP)
    // adj: 0=[1], 1=[0,2], 2=[1]
    let adj1 = []
    let row1_0 = []
    row1_0.push(1)
    adj1.push(row1_0)
    let row1_1 = []
    row1_1.push(0)
    row1_1.push(2)
    adj1.push(row1_1)
    let row1_2 = []
    row1_2.push(1)
    adj1.push(row1_2)

    cki("path3 count_bridges", ab_count_bridges(adj1, 3), 2)

    let ap1 = ab_articulation_points(adj1, 3)
    ckl("path3 ap", ap1, [1])

    let br1 = ab_bridges(adj1, 3)
    ckl2("path3 bridges", br1, [[0,1],[1,2]])

    // -- Test 2: triangle 0-1-2 (no bridges, no APs)
    let adj2 = []
    let row2_0 = []
    row2_0.push(1)
    row2_0.push(2)
    adj2.push(row2_0)
    let row2_1 = []
    row2_1.push(0)
    row2_1.push(2)
    adj2.push(row2_1)
    let row2_2 = []
    row2_2.push(0)
    row2_2.push(1)
    adj2.push(row2_2)

    cki("triangle count_bridges", ab_count_bridges(adj2, 3), 0)
    ckl("triangle ap", ab_articulation_points(adj2, 3), [])

    // -- Test 3: star graph 0 connected to 1,2,3 (3 bridges, node 0 is AP)
    // adj: 0=[1,2,3], 1=[0], 2=[0], 3=[0]
    let adj3 = []
    let row3_0 = []
    row3_0.push(1)
    row3_0.push(2)
    row3_0.push(3)
    adj3.push(row3_0)
    let row3_1 = []
    row3_1.push(0)
    adj3.push(row3_1)
    let row3_2 = []
    row3_2.push(0)
    adj3.push(row3_2)
    let row3_3 = []
    row3_3.push(0)
    adj3.push(row3_3)

    cki("star4 count_bridges", ab_count_bridges(adj3, 4), 3)
    ckl("star4 ap", ab_articulation_points(adj3, 4), [0])

    // -- Test 4: two triangles joined by a bridge
    // 0-1-2-0 (triangle), 3-4-5-3 (triangle), bridge 2-3
    // adj: 0=[1,2], 1=[0,2], 2=[0,1,3], 3=[2,4,5], 4=[3,5], 5=[3,4]
    let adj4 = []
    let r4_0 = []
    r4_0.push(1)
    r4_0.push(2)
    adj4.push(r4_0)
    let r4_1 = []
    r4_1.push(0)
    r4_1.push(2)
    adj4.push(r4_1)
    let r4_2 = []
    r4_2.push(0)
    r4_2.push(1)
    r4_2.push(3)
    adj4.push(r4_2)
    let r4_3 = []
    r4_3.push(2)
    r4_3.push(4)
    r4_3.push(5)
    adj4.push(r4_3)
    let r4_4 = []
    r4_4.push(3)
    r4_4.push(5)
    adj4.push(r4_4)
    let r4_5 = []
    r4_5.push(3)
    r4_5.push(4)
    adj4.push(r4_5)

    cki("bowtie count_bridges", ab_count_bridges(adj4, 6), 1)
    let ap4 = ab_articulation_points(adj4, 6)
    cki("bowtie ap len", len(ap4), 2)
    cki("bowtie ap[0]", ap4[0], 2)
    cki("bowtie ap[1]", ap4[1], 3)
    let br4 = ab_bridges(adj4, 6)
    ckl2("bowtie bridge", br4, [[2,3]])

    // -- Test 5: single node (no bridges, no AP)
    let adj5 = []
    let r5_0 = []
    adj5.push(r5_0)
    cki("single node bridges", ab_count_bridges(adj5, 1), 0)
    ckl("single node ap", ab_articulation_points(adj5, 1), [])

    // -- Test 6: empty graph (n=0)
    let adj6 = []
    cki("empty bridges", ab_count_bridges(adj6, 0), 0)
    ckl("empty ap", ab_articulation_points(adj6, 0), [])

    print("PASS _articulation_bridges_test")
