// ══════════════════════════════════════════════════════════════════════════════
// NOVA IR Integration Test
//
// Tests the full pipeline: Source → Lexer → Parser → AST→IR → IR→LLVM
// This proves the typed IR architecture works end-to-end with the real parser.
// Once validated, this IR layer will be merged into nova_compiler.nova.
// ══════════════════════════════════════════════════════════════════════════════

// ── Compiler Types (from nova_compiler.nova) ─────────────────────────────────

type Token
    kind: string
    value: string
    line: int
    col: int

type Expr
    tag: string
    value: string
    num: int
    children: list
    fields: list

type Stmt
    tag: string
    name: string
    expr: Expr
    body: list
    params: list
    else_body: list
    annotations: list

type Param
    name: string
    type_ann: string
    default_val: Expr

type ParseResult
    expr: Expr
    pos: int

type StmtParseResult
    stmt: Stmt
    pos: int

// ── IR Types ─────────────────────────────────────────────────────────────────

type IrType
    kind: string
    name: string
    params: list
    id: int

type IrInst
    op: string
    dest: string
    type: IrType
    args: list
    value: string
    num: int
    effect: string

type IrBlock
    label: string
    insts: list
    terminator: IrInst

type IrParam
    name: string
    type: IrType

type IrFunction
    name: string
    params: list
    ret_type: IrType
    blocks: list
    type_params: list
    is_extern: int

type IrModule
    functions: list
    structs: list
    globals: list
    string_constants: list

// ── IR Type Constructors ─────────────────────────────────────────────────────

fn ir_type_int() -> IrType
    IrType("int", "", [], 0)

fn ir_type_str() -> IrType
    IrType("str", "", [], 0)

fn ir_type_any() -> IrType
    IrType("any", "", [], 0)

fn ir_type_void() -> IrType
    IrType("void", "", [], 0)

// ── IR Builder State ─────────────────────────────────────────────────────────

type IrBuilder
    insts: list
    reg_count: int
    blocks: list
    current_label: string
    slots: dict
    string_lits: list
    str_map: dict

fn new_ir_builder() -> IrBuilder
    IrBuilder([], 0, [], "entry", {}, [], {})

fn ir_fresh_reg(b: IrBuilder) -> string
    let r = "%r" + str(b.reg_count)
    b.reg_count = b.reg_count + 1
    r

fn ir_emit(b: IrBuilder, op: string, dest: string, typ: IrType, args: list, value: string, num: int)
    push(b.insts, IrInst(op, dest, typ, args, value, num, "pure"))

fn ir_emit_effect(b: IrBuilder, op: string, dest: string, typ: IrType, args: list, value: string, num: int)
    push(b.insts, IrInst(op, dest, typ, args, value, num, "side_effect"))

fn ir_finish_block(b: IrBuilder, terminator: IrInst)
    let block = IrBlock(b.current_label, b.insts, terminator)
    push(b.blocks, block)
    b.insts = []

fn ir_start_block(b: IrBuilder, label: string)
    b.current_label = label

// ── AST → IR Lowering ────────────────────────────────────────────────────────
// Converts parsed Expr/Stmt into typed IR instructions.
// For now, all values are typed as "any" (same as current compiler).
// Type inference (Priority 3) will refine these types later.

fn ir_lower_expr(b: IrBuilder, expr: Expr) -> string
    match expr
        Expr(tag, value, num, children, fields) =>
            if tag == "int"
                let dest = ir_fresh_reg(b)
                ir_emit(b, "const_int", dest, ir_type_int(), [], str(num), num)
                return dest
            else if tag == "str"
                let dest = ir_fresh_reg(b)
                // Intern the string
                if not contains(b.str_map, value)
                    push(b.string_lits, value)
                    b.str_map[value] = len(b.string_lits) - 1
                ir_emit(b, "const_str", dest, ir_type_str(), [], value, 0)
                return dest
            else if tag == "ident"
                let dest = ir_fresh_reg(b)
                ir_emit(b, "slot_load", dest, ir_type_any(), [], value, 0)
                return dest
            else if tag == "binop"
                let left = ir_lower_expr(b, children[0])
                let right = ir_lower_expr(b, children[1])
                let dest = ir_fresh_reg(b)
                // Map binary operators to IR ops
                if value == "+"
                    ir_emit(b, "add", dest, ir_type_any(), [left, right], "+", 0)
                else if value == "-"
                    ir_emit(b, "sub", dest, ir_type_any(), [left, right], "-", 0)
                else if value == "*"
                    ir_emit(b, "mul", dest, ir_type_any(), [left, right], "*", 0)
                else if value == "/"
                    ir_emit(b, "div", dest, ir_type_any(), [left, right], "/", 0)
                else if value == "%"
                    ir_emit(b, "mod", dest, ir_type_any(), [left, right], "%", 0)
                else if value == "=="
                    ir_emit(b, "eq", dest, ir_type_any(), [left, right], "==", 0)
                else if value == "!="
                    ir_emit(b, "neq", dest, ir_type_any(), [left, right], "!=", 0)
                else if value == "<"
                    ir_emit(b, "lt", dest, ir_type_any(), [left, right], "<", 0)
                else if value == "<="
                    ir_emit(b, "le", dest, ir_type_any(), [left, right], "<=", 0)
                else if value == ">"
                    ir_emit(b, "gt", dest, ir_type_any(), [left, right], ">", 0)
                else if value == ">="
                    ir_emit(b, "ge", dest, ir_type_any(), [left, right], ">=", 0)
                else
                    ir_emit(b, "call", dest, ir_type_any(), [left, right], "nova_rt_binop", 0)
                return dest
            else if tag == "unary"
                let operand = ir_lower_expr(b, children[0])
                let dest = ir_fresh_reg(b)
                if value == "-"
                    ir_emit(b, "neg", dest, ir_type_any(), [operand], "-", 0)
                else if value == "not"
                    ir_emit(b, "not", dest, ir_type_any(), [operand], "not", 0)
                return dest
            else if tag == "call"
                let fn_name = value
                let arg_regs = []
                for child in children
                    push(arg_regs, ir_lower_expr(b, child))
                let dest = ir_fresh_reg(b)
                ir_emit_effect(b, "call", dest, ir_type_any(), arg_regs, fn_name, 0)
                return dest
            else if tag == "list"
                let dest = ir_fresh_reg(b)
                let elem_regs = []
                for child in children
                    push(elem_regs, ir_lower_expr(b, child))
                ir_emit(b, "make_list", dest, ir_type_any(), elem_regs, "", len(children))
                return dest
            else if tag == "index"
                let obj = ir_lower_expr(b, children[0])
                let idx = ir_lower_expr(b, children[1])
                let dest = ir_fresh_reg(b)
                ir_emit(b, "index_get", dest, ir_type_any(), [obj, idx], "", 0)
                return dest
            else if tag == "field"
                let obj = ir_lower_expr(b, children[0])
                let dest = ir_fresh_reg(b)
                ir_emit(b, "field_get", dest, ir_type_any(), [obj], value, 0)
                return dest
            // Fallback: unknown expression tag
            let dest = ir_fresh_reg(b)
            ir_emit(b, "const_int", dest, ir_type_any(), [], "0", 0)
            return dest

fn ir_lower_stmt(b: IrBuilder, stmt: Stmt)
    match stmt
        Stmt(tag, name, expr, body, params, else_body, annotations) =>
            if tag == "expr"
                ir_lower_expr(b, expr)
            else if tag == "let" or tag == "assign"
                let val = ir_lower_expr(b, expr)
                ir_emit(b, "slot_store", "", ir_type_void(), [val], name, 0)
            else if tag == "return"
                let val = ir_lower_expr(b, expr)
                ir_finish_block(b, IrInst("return", "", ir_type_void(), [val], "", 0, "pure"))
            else if tag == "print"
                let val = ir_lower_expr(b, expr)
                ir_emit_effect(b, "call", "", ir_type_void(), [val], "nova_rt_print_any", 0)

fn ir_lower_function(b: IrBuilder, stmt: Stmt) -> IrFunction
    match stmt
        Stmt(tag, name, expr, body, params, else_body, annotations) =>
            let ir_params = []
            for p in params
                match p
                    Param(pname, ptype, pdefault) =>
                        push(ir_params, IrParam(pname, ir_type_any()))
            // Lower body statements
            b.insts = []
            b.blocks = []
            b.current_label = "entry"
            b.reg_count = 0
            b.slots = {}
            for s in body
                ir_lower_stmt(b, s)
            // If there are remaining instructions not yet in a block, finish with implicit return 0
            if len(b.insts) > 0
                ir_finish_block(b, IrInst("return", "", ir_type_void(), ["0"], "", 0, "pure"))
            else if len(b.blocks) == 0
                // Empty function — emit a return 0
                ir_finish_block(b, IrInst("return", "", ir_type_void(), ["0"], "", 0, "pure"))
            IrFunction(name, ir_params, ir_type_any(), b.blocks, [], 0)

// ── IR → LLVM Emitter ────────────────────────────────────────────────────────

type LlvmEmitter
    output: list
    strings: list
    str_map: dict
    str_count: int

fn new_emitter() -> LlvmEmitter
    LlvmEmitter([], [], {}, 0)

fn emit_line(e: LlvmEmitter, line: string)
    push(e.output, line)

fn emit_indent_line(e: LlvmEmitter, line: string)
    push(e.output, "  " + line)

fn llvm_escape(s: string) -> string
    let result = ""
    let i = 0
    while i < len(s)
        let ch = s[i]
        if ch == "\n"
            result = result + "\\0A"
        else if ch == "\r"
            result = result + "\\0D"
        else if ch == "\t"
            result = result + "\\09"
        else if ch == "\0"
            result = result + "\\00"
        else if ch == "\\"
            result = result + "\\\\"
        else if ch == "\""
            result = result + "\\22"
        else
            result = result + ch
        i = i + 1
    result

fn intern_string_lit(e: LlvmEmitter, s: string) -> string
    if contains(e.str_map, s)
        return e.str_map[s]
    let escaped = llvm_escape(s)
    let name = "@.str." + str(e.str_count)
    e.str_count = e.str_count + 1
    let byte_len = len(s) + 1
    push(e.strings, name + " = private unnamed_addr constant [" + str(byte_len) + " x i8] c\"" + escaped + "\\00\"")
    e.str_map[s] = name
    name

fn emit_ir_inst(e: LlvmEmitter, inst: IrInst)
    match inst
        IrInst(op, dest, typ, args, value, num, effect) =>
            if op == "const_int"
                // Integer constants are inlined in LLVM IR
                // Store the constant in a temp so later instructions can reference it
                emit_indent_line(e, dest + " = add i64 " + str(num) + ", 0")
            else if op == "const_str"
                let str_name = intern_string_lit(e, value)
                let byte_len = len(value) + 1
                let ptr_reg = dest + ".p"
                emit_indent_line(e, ptr_reg + " = getelementptr inbounds [" + str(byte_len) + " x i8], ptr " + str_name + ", i64 0, i64 0")
                emit_indent_line(e, dest + " = call i64 @nova_rt_create_string(ptr " + ptr_reg + ")")
            else if op == "add"
                match typ
                    IrType(tk, tn, tp, tid) =>
                        if tk == "int"
                            emit_indent_line(e, dest + " = add i64 " + args[0] + ", " + args[1])
                        else if tk == "str"
                            emit_indent_line(e, dest + " = call i64 @nova_rt_str_concat(i64 " + args[0] + ", i64 " + args[1] + ")")
                        else
                            emit_indent_line(e, dest + " = call i64 @nova_rt_add(i64 " + args[0] + ", i64 " + args[1] + ")")
            else if op == "sub"
                match typ
                    IrType(tk, tn, tp, tid) =>
                        if tk == "int"
                            emit_indent_line(e, dest + " = sub i64 " + args[0] + ", " + args[1])
                        else
                            emit_indent_line(e, dest + " = call i64 @nova_rt_sub(i64 " + args[0] + ", i64 " + args[1] + ")")
            else if op == "mul"
                match typ
                    IrType(tk, tn, tp, tid) =>
                        if tk == "int"
                            emit_indent_line(e, dest + " = mul i64 " + args[0] + ", " + args[1])
                        else
                            emit_indent_line(e, dest + " = call i64 @nova_rt_mul(i64 " + args[0] + ", i64 " + args[1] + ")")
            else if op == "div"
                match typ
                    IrType(tk, tn, tp, tid) =>
                        if tk == "int"
                            emit_indent_line(e, dest + " = sdiv i64 " + args[0] + ", " + args[1])
                        else
                            emit_indent_line(e, dest + " = call i64 @nova_rt_div(i64 " + args[0] + ", i64 " + args[1] + ")")
            else if op == "mod"
                emit_indent_line(e, dest + " = srem i64 " + args[0] + ", " + args[1])
            else if op == "neg"
                emit_indent_line(e, dest + " = sub i64 0, " + args[0])
            else if op == "eq"
                let tmp = dest + ".cmp"
                emit_indent_line(e, tmp + " = icmp eq i64 " + args[0] + ", " + args[1])
                emit_indent_line(e, dest + " = zext i1 " + tmp + " to i64")
            else if op == "neq"
                let tmp = dest + ".cmp"
                emit_indent_line(e, tmp + " = icmp ne i64 " + args[0] + ", " + args[1])
                emit_indent_line(e, dest + " = zext i1 " + tmp + " to i64")
            else if op == "lt"
                let tmp = dest + ".cmp"
                emit_indent_line(e, tmp + " = icmp slt i64 " + args[0] + ", " + args[1])
                emit_indent_line(e, dest + " = zext i1 " + tmp + " to i64")
            else if op == "le"
                let tmp = dest + ".cmp"
                emit_indent_line(e, tmp + " = icmp sle i64 " + args[0] + ", " + args[1])
                emit_indent_line(e, dest + " = zext i1 " + tmp + " to i64")
            else if op == "gt"
                let tmp = dest + ".cmp"
                emit_indent_line(e, tmp + " = icmp sgt i64 " + args[0] + ", " + args[1])
                emit_indent_line(e, dest + " = zext i1 " + tmp + " to i64")
            else if op == "ge"
                let tmp = dest + ".cmp"
                emit_indent_line(e, tmp + " = icmp sge i64 " + args[0] + ", " + args[1])
                emit_indent_line(e, dest + " = zext i1 " + tmp + " to i64")
            else if op == "not"
                let tmp = dest + ".cmp"
                emit_indent_line(e, tmp + " = icmp eq i64 " + args[0] + ", 0")
                emit_indent_line(e, dest + " = zext i1 " + tmp + " to i64")
            else if op == "slot_load"
                emit_indent_line(e, dest + " = load i64, ptr %slot." + value + ", align 8")
            else if op == "slot_store"
                emit_indent_line(e, "store i64 " + args[0] + ", ptr %slot." + value + ", align 8")
            else if op == "call"
                let call_str = "call i64 @" + value + "("
                let i = 0
                while i < len(args)
                    if i > 0
                        call_str = call_str + ", "
                    call_str = call_str + "i64 " + args[i]
                    i = i + 1
                call_str = call_str + ")"
                if dest != ""
                    emit_indent_line(e, dest + " = " + call_str)
                else
                    emit_indent_line(e, call_str)
            else if op == "make_list"
                emit_indent_line(e, dest + " = call i64 @nova_rt_list_create()")
                let i = 0
                while i < len(args)
                    emit_indent_line(e, "call i64 @nova_rt_list_append(i64 " + dest + ", i64 " + args[i] + ")")
                    i = i + 1
            else if op == "index_get"
                emit_indent_line(e, dest + " = call i64 @nova_rt_index_get(i64 " + args[0] + ", i64 " + args[1] + ")")
            else if op == "field_get"
                // For now, use runtime field access (will be optimized with struct type info)
                emit_indent_line(e, dest + " = call i64 @nova_rt_field_get(i64 " + args[0] + ", i64 " + value + ")")

fn emit_ir_terminator(e: LlvmEmitter, term: IrInst)
    match term
        IrInst(op, dest, typ, args, value, num, effect) =>
            if op == "return"
                if len(args) > 0
                    emit_indent_line(e, "ret i64 " + args[0])
                else
                    emit_indent_line(e, "ret i64 0")
            else if op == "goto"
                emit_indent_line(e, "br label %" + value)
            else if op == "branch"
                let cond_cmp = dest + ".br"
                emit_indent_line(e, cond_cmp + " = icmp ne i64 " + args[0] + ", 0")
                emit_indent_line(e, "br i1 " + cond_cmp + ", label %" + value + ", label %" + args[1])

fn emit_ir_function(e: LlvmEmitter, func: IrFunction)
    match func
        IrFunction(name, params, ret_type, blocks, type_params, is_extern) =>
            if is_extern == 1
                let decl = "declare i64 @" + name + "("
                let i = 0
                while i < len(params)
                    if i > 0
                        decl = decl + ", "
                    decl = decl + "i64"
                    i = i + 1
                decl = decl + ") nounwind"
                emit_line(e, decl)
                return 0
            let header = "define i64 @" + name + "("
            let i = 0
            while i < len(params)
                if i > 0
                    header = header + ", "
                header = header + "i64 %p" + str(i)
                i = i + 1
            header = header + ") nounwind {"
            emit_line(e, header)
            for block in blocks
                match block
                    IrBlock(label, insts, terminator) =>
                        emit_line(e, label + ":")
                        if label == "entry"
                            let pi = 0
                            while pi < len(params)
                                match params[pi]
                                    IrParam(pname, ptype) =>
                                        emit_indent_line(e, "%slot." + pname + " = alloca i64, align 8")
                                        emit_indent_line(e, "store i64 %p" + str(pi) + ", ptr %slot." + pname + ", align 8")
                                pi = pi + 1
                        for inst in insts
                            emit_ir_inst(e, inst)
                        emit_ir_terminator(e, terminator)
            emit_line(e, "}")
            emit_line(e, "")

// ── Minimal Lexer (just enough for testing) ──────────────────────────────────

fn is_alpha(ch: string) -> bool
    let c = ord(ch)
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or ch == "_"

fn is_digit(ch: string) -> bool
    let c = ord(ch)
    c >= 48 and c <= 57

fn is_alnum(ch: string) -> bool
    is_alpha(ch) or is_digit(ch)

fn tokenize_mini(source: string) -> list
    let tokens = []
    let i = 0
    let line = 1
    while i < len(source)
        let ch = source[i]
        if ch == " " or ch == "\t" or ch == "\r"
            i = i + 1
        else if ch == "\n"
            push(tokens, Token("NEWLINE", "\n", line, 0))
            line = line + 1
            i = i + 1
        else if ch == "#"
            while i < len(source) and source[i] != "\n"
                i = i + 1
        else if is_digit(ch)
            let start = i
            while i < len(source) and is_digit(source[i])
                i = i + 1
            push(tokens, Token("INT", slice(source, start, i), line, start))
        else if ch == "\""
            i = i + 1
            let s = ""
            while i < len(source) and source[i] != "\""
                if source[i] == "\\"
                    i = i + 1
                    if i < len(source)
                        let esc = source[i]
                        if esc == "n"
                            s = s + "\n"
                        else if esc == "t"
                            s = s + "\t"
                        else if esc == "\\"
                            s = s + "\\"
                        else if esc == "\""
                            s = s + "\""
                        else
                            s = s + esc
                else
                    s = s + source[i]
                i = i + 1
            i = i + 1
            push(tokens, Token("STR", s, line, 0))
        else if is_alpha(ch)
            let start = i
            while i < len(source) and is_alnum(source[i])
                i = i + 1
            let word = slice(source, start, i)
            if word == "fn" or word == "let" or word == "return" or word == "if" or word == "else" or word == "while" or word == "for" or word == "in" or word == "and" or word == "or" or word == "not" or word == "true" or word == "false"
                push(tokens, Token("KW", word, line, start))
            else
                push(tokens, Token("IDENT", word, line, start))
        else if ch == "+" or ch == "-" or ch == "*" or ch == "/"  or ch == "%"
            push(tokens, Token("OP", ch, line, i))
            i = i + 1
        else if ch == "=" and i + 1 < len(source) and source[i+1] == "="
            push(tokens, Token("OP", "==", line, i))
            i = i + 2
        else if ch == "!" and i + 1 < len(source) and source[i+1] == "="
            push(tokens, Token("OP", "!=", line, i))
            i = i + 2
        else if ch == "<" and i + 1 < len(source) and source[i+1] == "="
            push(tokens, Token("OP", "<=", line, i))
            i = i + 2
        else if ch == ">" and i + 1 < len(source) and source[i+1] == "="
            push(tokens, Token("OP", ">=", line, i))
            i = i + 2
        else if ch == "<"
            push(tokens, Token("OP", "<", line, i))
            i = i + 1
        else if ch == ">"
            push(tokens, Token("OP", ">", line, i))
            i = i + 1
        else if ch == "="
            push(tokens, Token("ASSIGN", "=", line, i))
            i = i + 1
        else if ch == "("
            push(tokens, Token("LPAREN", "(", line, i))
            i = i + 1
        else if ch == ")"
            push(tokens, Token("RPAREN", ")", line, i))
            i = i + 1
        else if ch == ","
            push(tokens, Token("COMMA", ",", line, i))
            i = i + 1
        else if ch == ":"
            push(tokens, Token("COLON", ":", line, i))
            i = i + 1
        else if ch == "["
            push(tokens, Token("LBRACKET", "[", line, i))
            i = i + 1
        else if ch == "]"
            push(tokens, Token("RBRACKET", "]", line, i))
            i = i + 1
        else
            i = i + 1
    push(tokens, Token("EOF", "", line, i))
    tokens

// ── Minimal Parser (for testing) ─────────────────────────────────────────────
// Parses: fn name(params)\n    body
// Parses: let x = expr / x = expr / return expr / expr (call)

fn skip_nl_mini(tokens: list, pos: int) -> int
    while pos < len(tokens)
        match tokens[pos]
            Token(k, v, l, c) =>
                if k != "NEWLINE"
                    return pos
        pos = pos + 1
    pos

fn parse_expr_mini(tokens: list, pos: int) -> ParseResult
    // Simple expression parser: handles int, string, ident, call, binop
    let left = parse_atom_mini(tokens, pos)
    let lpos = left.pos
    // Check for binary operator
    if lpos < len(tokens)
        match tokens[lpos]
            Token(k, v, l, c) =>
                if k == "OP"
                    let right = parse_atom_mini(tokens, lpos + 1)
                    return ParseResult(Expr("binop", v, 0, [left.expr, right.expr], []), right.pos)
    left

fn parse_atom_mini(tokens: list, pos: int) -> ParseResult
    match tokens[pos]
        Token(k, v, l, c) =>
            if k == "INT"
                return ParseResult(Expr("int", v, int(v), [], []), pos + 1)
            else if k == "STR"
                return ParseResult(Expr("str", v, 0, [], []), pos + 1)
            else if k == "IDENT"
                // Check if it's a call
                if pos + 1 < len(tokens)
                    match tokens[pos + 1]
                        Token(k2, v2, l2, c2) =>
                            if k2 == "LPAREN"
                                let args = []
                                let ap = pos + 2
                                while ap < len(tokens)
                                    match tokens[ap]
                                        Token(ka, va, la, ca) =>
                                            if ka == "RPAREN"
                                                return ParseResult(Expr("call", v, 0, args, []), ap + 1)
                                    let arg = parse_expr_mini(tokens, ap)
                                    push(args, arg.expr)
                                    ap = arg.pos
                                    if ap < len(tokens)
                                        match tokens[ap]
                                            Token(ka2, va2, la2, ca2) =>
                                                if ka2 == "COMMA"
                                                    ap = ap + 1
                                return ParseResult(Expr("call", v, 0, args, []), ap + 1)
                return ParseResult(Expr("ident", v, 0, [], []), pos + 1)
            else if k == "KW" and (v == "true" or v == "false")
                let bval = if v == "true"
                    1
                else
                    0
                return ParseResult(Expr("int", v, bval, [], []), pos + 1)
    ParseResult(Expr("int", "0", 0, [], []), pos + 1)

fn parse_stmt_mini(tokens: list, pos: int) -> StmtParseResult
    match tokens[pos]
        Token(k, v, l, c) =>
            if k == "KW" and v == "let"
                // let name = expr
                match tokens[pos + 1]
                    Token(k2, name, l2, c2) =>
                        let ep = parse_expr_mini(tokens, pos + 3)
                        return StmtParseResult(Stmt("let", name, ep.expr, [], [], [], []), ep.pos)
            else if k == "KW" and v == "return"
                let ep = parse_expr_mini(tokens, pos + 1)
                return StmtParseResult(Stmt("return", "", ep.expr, [], [], [], []), ep.pos)
            else if k == "IDENT"
                // Check for assignment: name = expr
                if pos + 1 < len(tokens)
                    match tokens[pos + 1]
                        Token(k2, v2, l2, c2) =>
                            if k2 == "ASSIGN"
                                let ep = parse_expr_mini(tokens, pos + 2)
                                return StmtParseResult(Stmt("assign", v, ep.expr, [], [], [], []), ep.pos)
                // Otherwise it's an expression statement (call)
                let ep = parse_expr_mini(tokens, pos)
                return StmtParseResult(Stmt("expr", "", ep.expr, [], [], [], []), ep.pos)
    StmtParseResult(Stmt("expr", "", Expr("int", "0", 0, [], []), [], [], [], []), pos + 1)

fn parse_fn_mini(tokens: list, pos: int) -> StmtParseResult
    // fn name(params)\n    body...
    // pos is at "fn"
    match tokens[pos + 1]
        Token(k, name, l, c) =>
            let pp = pos + 3  // skip past LPAREN
            let params = []
            while pp < len(tokens)
                match tokens[pp]
                    Token(k2, v2, l2, c2) =>
                        if k2 == "RPAREN"
                            pp = pp + 1
                            // Skip newlines to get to body
                            pp = skip_nl_mini(tokens, pp)
                            // Parse body statements (indented)
                            let body = []
                            while pp < len(tokens)
                                match tokens[pp]
                                    Token(kb, vb, lb, cb) =>
                                        if kb == "EOF" or kb == "KW" and vb == "fn"
                                            return StmtParseResult(Stmt("fn", name, Expr("int", "0", 0, [], []), body, params, [], []), pp)
                                        if kb == "NEWLINE"
                                            pp = pp + 1
                                        else
                                            let sr = parse_stmt_mini(tokens, pp)
                                            push(body, sr.stmt)
                                            pp = skip_nl_mini(tokens, sr.pos)
                            return StmtParseResult(Stmt("fn", name, Expr("int", "0", 0, [], []), body, params, [], []), pp)
                        else if k2 == "COMMA"
                            pp = pp + 1
                        else if k2 == "IDENT"
                            push(params, Param(v2, "", Expr("int", "0", 0, [], [])))
                            pp = pp + 1
                            // Skip type annotation if present
                            if pp < len(tokens)
                                match tokens[pp]
                                    Token(k3, v3, l3, c3) =>
                                        if k3 == "COLON"
                                            pp = pp + 1
                                            pp = pp + 1  // skip type name
                        else
                            pp = pp + 1
    StmtParseResult(Stmt("fn", "", Expr("int", "0", 0, [], []), [], [], [], []), pos)

// ── Test: End-to-End Pipeline ────────────────────────────────────────────────

fn test_pipeline()
    print("=== IR Integration Test ===")

    // Test 1: Simple function with arithmetic
    print("")
    print("Test 1: fn add(a, b) -> a + b")
    let b = new_ir_builder()
    let params = [Param("a", "", Expr("int", "0", 0, [], [])), Param("b", "", Expr("int", "0", 0, [], []))]
    let body = [Stmt("return", "", Expr("binop", "+", 0, [Expr("ident", "a", 0, [], []), Expr("ident", "b", 0, [], [])], []), [], [], [], [])]
    let fn_stmt = Stmt("fn", "add", Expr("int", "0", 0, [], []), body, params, [], [])
    let ir_fn = ir_lower_function(b, fn_stmt)

    let e = new_emitter()
    emit_ir_function(e, ir_fn)
    for line in e.output
        print(line)

    // Verify: should have slot_load, slot_load, add (with "any" type → runtime call), return
    let has_call_add = false
    let has_ret = false
    for line in e.output
        if contains(line, "nova_rt_add")
            has_call_add = true
        if contains(line, "ret i64")
            has_ret = true
    if has_call_add and has_ret
        print("PASS: Generic add generates runtime call (type = any)")
    else
        print("FAIL: Missing expected output")

    // Test 2: Known-int arithmetic (simulating type refinement)
    print("")
    print("Test 2: Manually typed int add (simulating type inference)")
    let b2 = new_ir_builder()
    b2.insts = []
    b2.blocks = []
    b2.current_label = "entry"
    b2.reg_count = 0
    // Manually build IR with int types (what type inference would produce)
    ir_emit(b2, "slot_load", "%r0", ir_type_int(), [], "a", 0)
    ir_emit(b2, "slot_load", "%r1", ir_type_int(), [], "b", 0)
    ir_emit(b2, "add", "%r2", ir_type_int(), ["%r0", "%r1"], "+", 0)
    ir_finish_block(b2, IrInst("return", "", ir_type_void(), ["%r2"], "", 0, "pure"))
    let typed_fn = IrFunction("add_int", [IrParam("a", ir_type_int()), IrParam("b", ir_type_int())], ir_type_int(), b2.blocks, [], 0)

    let e2 = new_emitter()
    emit_ir_function(e2, typed_fn)
    for line in e2.output
        print(line)

    let has_direct_add = false
    let has_no_rt_call = true
    for line in e2.output
        if contains(line, "add i64 %r0, %r1")
            has_direct_add = true
        if contains(line, "nova_rt_add")
            has_no_rt_call = false
    if has_direct_add and has_no_rt_call
        print("PASS: Typed int add → direct 'add i64' (ZERO overhead)")
    else
        print("FAIL: Type-directed emission didn't produce direct add")

    // Test 3: Parse real source → IR → LLVM
    print("")
    print("Test 3: Full pipeline - source → lex → parse → IR → LLVM")
    let source = "fn double(x)\n    return x + x\n"
    let tokens = tokenize_mini(source)
    // Find fn token
    let pos = 0
    while pos < len(tokens)
        match tokens[pos]
            Token(k, v, l, c) =>
                if k == "KW" and v == "fn"
                    let sr = parse_fn_mini(tokens, pos)
                    let b3 = new_ir_builder()
                    let ir_fn3 = ir_lower_function(b3, sr.stmt)
                    let e3 = new_emitter()
                    emit_ir_function(e3, ir_fn3)
                    for line in e3.output
                        print(line)
                    // Verify it's valid LLVM-like output
                    let has_define = false
                    let has_entry = false
                    for line in e3.output
                        if contains(line, "define i64 @double")
                            has_define = true
                        if contains(line, "entry:")
                            has_entry = true
                    if has_define and has_entry
                        print("PASS: Full pipeline produced valid LLVM function")
                    else
                        print("FAIL: Pipeline output malformed")
                    pos = len(tokens)  // break
                else
                    pos = pos + 1
        pos = pos + 1

    print("")
    print("=== All IR Integration Tests Complete ===")

test_pipeline()
