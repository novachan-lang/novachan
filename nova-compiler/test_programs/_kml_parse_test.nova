// KAT: std/data/kml_parse
import std/data/kml_parse

fn approx(a, b, tol) -> int
    kml_approx(a, b, tol)

fn ck_i(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck_s(label, got, want)
    if got != want
        print("FAIL " + label + ": got=[" + got + "] want=[" + want + "]")
        exit(1)

fn ck_f(label, got, want)
    if approx(got, want, 0.0001) == 0
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ── Test 1: basic two-point KML ─────────────────────────────────────────────
let kml1 = "<kml><Document><Placemark><Point><coordinates>1.0,2.0,0 3.0,4.0,0</coordinates></Point></Placemark></Document></kml>"
let pts1 = kml_parse(kml1)
ck_i("basic_len", len(pts1), 2)
let p10 = pts1[0]
let p11 = pts1[1]
ck_f("basic_p0_lon", p10[0], 1.0)
ck_f("basic_p0_lat", p10[1], 2.0)
ck_f("basic_p1_lon", p11[0], 3.0)
ck_f("basic_p1_lat", p11[1], 4.0)

// ── Test 2: single point without altitude ───────────────────────────────────
let kml2 = "<coordinates>-122.4194,37.7749</coordinates>"
let pts2 = kml_parse(kml2)
ck_i("noalt_len", len(pts2), 1)
let p20 = pts2[0]
ck_f("noalt_lon", p20[0], -122.4194)
ck_f("noalt_lat", p20[1], 37.7749)

// ── Test 3: altitude is dropped (only 2 elements per pair) ──────────────────
let kml3 = "<coordinates>10.5,20.5,500.0</coordinates>"
let pts3 = kml_parse(kml3)
ck_i("alt_drop_len",   len(pts3),    1)
ck_i("alt_drop_pairs", len(pts3[0]), 2)
let p30 = pts3[0]
ck_f("alt_drop_lon", p30[0], 10.5)
ck_f("alt_drop_lat", p30[1], 20.5)

// ── Test 4: whitespace-separated (newlines between tuples) ──────────────────
let kml4 = "<coordinates>" + chr(10) + "0.0,1.0,0" + chr(10) + "2.0,3.0,0" + chr(10) + "4.0,5.0,0" + chr(10) + "</coordinates>"
let pts4 = kml_parse(kml4)
ck_i("newline_len", len(pts4), 3)
let p41 = pts4[1]
ck_f("newline_p1_lon", p41[0], 2.0)
ck_f("newline_p1_lat", p41[1], 3.0)

// ── Test 5: no coordinates tag returns empty list ────────────────────────────
let kml5 = "<kml><Document></Document></kml>"
let pts5 = kml_parse(kml5)
ck_i("no_coords_len", len(pts5), 0)

// ── Test 6: negative and fractional coordinates ──────────────────────────────
let kml6 = "<coordinates>-73.9857,40.7484,10.5</coordinates>"
let pts6 = kml_parse(kml6)
ck_i("neg_len", len(pts6), 1)
let p60 = pts6[0]
ck_f("neg_lon", p60[0], -73.9857)
ck_f("neg_lat", p60[1], 40.7484)

// ── Test 7: kml_coords_text extracts raw text ────────────────────────────────
let kml7 = "<kml><coordinates>1.0,2.0</coordinates></kml>"
let raw7 = kml_coords_text(kml7)
ck_i("raw_text_nonempty", len(raw7) > 0, 1)

// ── Test 8: tabs as whitespace between tuples ────────────────────────────────
let kml8 = "<coordinates>5.0,6.0,0" + chr(9) + "7.0,8.0,0</coordinates>"
let pts8 = kml_parse(kml8)
ck_i("tab_sep_len", len(pts8), 2)
let p80 = pts8[0]
let p81 = pts8[1]
ck_f("tab_p0_lon", p80[0], 5.0)
ck_f("tab_p1_lon", p81[0], 7.0)

print("PASS _kml_parse_test")
