// Phase 8: Build system, formatter, cross-compile test

fn test_target_info()
    let triple = target_current()
    assert_eq(len(triple) > 0, true)
    let arch = target_arch(triple)
    assert_eq(len(arch) > 0, true)
    let targets = target_list()
    assert_eq(len(targets) >= 6, true)
    let is_wasm = target_is_wasm("wasm32-unknown-unknown")
    assert_eq(is_wasm, true)
    let is_not_wasm = target_is_wasm(triple)
    assert_eq(is_not_wasm, false)
    print("Target info test passed: " + triple)

fn test_file_mtime()
    // nova_compiler.nova should exist and have a valid mtime (it lives in ../compiler/ now)
    let mtime = build_file_mtime("../compiler/nova_compiler.nova")
    assert_eq(mtime > 0, true)
    // Non-existent file returns -1
    let bad = build_file_mtime("__nonexistent_file_xyz__.nova")
    assert_eq(bad, -1)
    print("File mtime test passed")

fn test_needs_rebuild()
    // nova_compiler.nova vs. itself: same mtime, should not need rebuild
    // (or src newer if nova_compiler.nova changed recently)
    let needs = build_needs_rebuild("../compiler/nova_compiler.nova", "../compiler/nova_compiler.nova")
    // Either 0 or 1 is valid here (depends on mtime comparison)
    assert_eq(needs == 0 or needs == 1, true)
    // Missing output always needs rebuild
    let needs2 = build_needs_rebuild("../compiler/nova_compiler.nova", "__missing__.ll")
    assert_eq(needs2, true)
    print("Needs-rebuild test passed")

fn test_get_sources()
    // Get .nova sources in the compiler source dir (where nova_compiler.nova lives)
    let sources = build_get_sources("../compiler")
    assert_eq(len(sources) > 0, true)
    // All items should end with .nova
    let found_main = false
    let i = 0
    while i < len(sources)
        let s = sources[i]
        assert_eq(ends_with(s, ".nova"), true)
        if ends_with(s, "nova_compiler.nova")
            let found_main = true
        i = i + 1
    assert_eq(found_main, true)
    print("Get sources test passed: " + str(len(sources)) + " sources")

fn test_fmt_format()
    // Well-formatted source should be returned (idempotent)
    let src = "fn main()\n    print(\"hello\")\n"
    let formatted = fmt_format(src)
    assert_eq(len(formatted) > 0, true)
    // Check that it's already clean (idempotent)
    let check = fmt_check(src)
    assert_eq(check, true)
    // Badly indented source with inconsistent spaces
    let bad = "fn foo()\n  print(\"hi\")\n"
    let fixed = fmt_format(bad)
    assert_eq(len(fixed) > 0, true)
    print("Formatter test passed")

fn test_toml_parse()
    // Write a temp nova.toml and parse it
    write_file("_test_nova.toml", "[package]\nname = \"myapp\"\nversion = \"1.0.0\"\n\n[dependencies]\nnova-http = \">=1.0\"\n")
    let config = build_toml_parse("_test_nova.toml")
    let name = config["name"]
    assert_eq(name, "myapp")
    let version = config["version"]
    assert_eq(version, "1.0.0")
    print("TOML parse test passed")

fn main()
    test_target_info()
    test_file_mtime()
    test_needs_rebuild()
    test_get_sources()
    test_fmt_format()
    test_toml_parse()
    print("All Phase 8 build system tests passed!")
