import std/poly/polymodp

fn cki(label, got, want)
    if got != want
        print("FAIL polymodp " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    if got != want
        print("FAIL polymodp " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // KAT 1: pmp_add([1,1],[1,1],2) == [0,0]
    // (1+x)+(1+x) = 2+2x ≡ 0 mod 2
    let a1 = [1, 1]
    let b1 = [1, 1]
    let r1 = pmp_add(a1, b1, 2)
    // All zero → normalizes to [0]
    cki("add_mod2_len", len(r1), 1)
    cki("add_mod2_c0", r1[0], 0)

    // KAT 2: pmp_mul([1,1],[1,1],2) == [1,0,1]
    // (1+x)^2 = 1+2x+x^2 ≡ 1+x^2 mod 2 → [1,0,1]
    let a2 = [1, 1]
    let b2 = [1, 1]
    let r2 = pmp_mul(a2, b2, 2)
    cki("mul_mod2_len", len(r2), 3)
    cki("mul_mod2_c0", r2[0], 1)
    cki("mul_mod2_c1", r2[1], 0)
    cki("mul_mod2_c2", r2[2], 1)

    // KAT 3: pmp_mod_coeffs([5,-1,7], 3) == [2,2,1]
    // 5 mod 3=2; -1 mod 3=2; 7 mod 3=1
    let p3 = [5, 0 - 1, 7]
    let r3 = pmp_mod_coeffs(p3, 3)
    cki("mod_coeffs_len", len(r3), 3)
    cki("mod_coeffs_c0", r3[0], 2)
    cki("mod_coeffs_c1", r3[1], 2)
    cki("mod_coeffs_c2", r3[2], 1)

    // KAT 4: pmp_eval([1,1,1], 2, 3) == 1
    // 1 + 1*2 + 1*4 = 7 ≡ 1 mod 3
    let p4 = [1, 1, 1]
    let r4 = pmp_eval(p4, 2, 3)
    cki("eval_mod3", r4, 1)

    // KAT 5: pmp_inverse_coeff(2, 5) == 3  (2*3=6≡1 mod 5)
    let inv5 = pmp_inverse_coeff(2, 5)
    cki("inverse_2_5", inv5, 3)

    // KAT 6: pmp_inverse_coeff(3, 7) == 5  (3*5=15≡1 mod 7)
    let inv6 = pmp_inverse_coeff(3, 7)
    cki("inverse_3_7", inv6, 5)

    // KAT 7: pmp_scale([1,2,3], 2, 5) == [2,4,1]
    // 1*2=2; 2*2=4; 3*2=6≡1 mod 5
    let p7 = [1, 2, 3]
    let r7 = pmp_scale(p7, 2, 5)
    cki("scale_len", len(r7), 3)
    cki("scale_c0", r7[0], 2)
    cki("scale_c1", r7[1], 4)
    cki("scale_c2", r7[2], 1)

    // KAT 8: pmp_sub([3,2],[1,3],5) == [2,4]
    // (3-1)=2; (2-3)=-1≡4 mod 5
    let a8 = [3, 2]
    let b8 = [1, 3]
    let r8 = pmp_sub(a8, b8, 5)
    cki("sub_len", len(r8), 2)
    cki("sub_c0", r8[0], 2)
    cki("sub_c1", r8[1], 4)

    // KAT 9: pmp_is_zero([0,0,0], 5) == true
    let z9 = [0, 0, 0]
    let iz9 = pmp_is_zero(z9, 5)
    ckb("is_zero_true", iz9, true)

    // KAT 10: pmp_is_zero([1,0], 5) == false
    let nz10 = [1, 0]
    let inz10 = pmp_is_zero(nz10, 5)
    ckb("is_zero_false", inz10, false)

    // KAT 11: pmp_divmod([1,0,1],[1,1],2) — (1+x^2) / (1+x) over GF(2)
    // (1+x^2) = (1+x)(1+x) - 0 over GF(2): (1+x)^2 = 1+x^2 so quotient=(1+x), remainder=0
    let da11 = [1, 0, 1]
    let db11 = [1, 1]
    let dm11 = pmp_divmod(da11, db11, 2)
    let q11 = dm11[0]
    let rem11 = dm11[1]
    cki("divmod_q_len", len(q11), 2)
    cki("divmod_q_c0", q11[0], 1)
    cki("divmod_q_c1", q11[1], 1)
    cki("divmod_r_val", rem11[0], 0)

    // KAT 12: round-trip pmp_divmod — (q * b + r) mod p == a mod p
    let da12 = [2, 1, 3, 1]
    let db12 = [1, 1]
    let dm12 = pmp_divmod(da12, db12, 5)
    let q12 = dm12[0]
    let r12 = dm12[1]
    // Reconstruct q*b+r
    let qb12 = pmp_mul(q12, db12, 5)
    let rec12 = pmp_add(qb12, r12, 5)
    let orig12 = pmp_mod_coeffs(da12, 5)
    cki("roundtrip_len", len(rec12), len(orig12))
    let ci12 = 0
    while ci12 < len(orig12)
        cki("roundtrip_c" + str(ci12), rec12[ci12], orig12[ci12])
        ci12 = ci12 + 1

    // KAT 13: pmp_eval([1,0,0,1], 1, 2) = 1+0+0+1 = 2 ≡ 0 mod 2
    let p13 = [1, 0, 0, 1]
    let r13 = pmp_eval(p13, 1, 2)
    cki("eval_x3plus1_at1_mod2", r13, 0)

    // KAT 14: pmp_inverse_coeff(1, 7) == 1
    let inv14 = pmp_inverse_coeff(1, 7)
    cki("inverse_1_7", inv14, 1)

    // KAT 15: pmp_inverse_coeff(0, 5) == 0 (no inverse)
    let inv15 = pmp_inverse_coeff(0, 5)
    cki("inverse_0_5", inv15, 0)

    print("PASS _polymodp_test")
