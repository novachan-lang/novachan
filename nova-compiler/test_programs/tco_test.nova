// Test tail call optimization
// A tail-recursive factorial that would overflow the stack without TCO

fn factorial(n: int, acc: int) -> int
    if n <= 1
        return acc
    return factorial(n - 1, acc * n)

fn sum_to(n: int, acc: int) -> int
    if n <= 0
        return acc
    return sum_to(n - 1, acc + n)

fn count_down(n: int) -> int
    if n <= 0
        return 0
    return count_down(n - 1)

fn main()
    // Basic correctness
    print(factorial(10, 1))
    print(factorial(20, 1))
    print(sum_to(100, 0))
    print(sum_to(1000, 0))

    // Deep recursion — would stack overflow without TCO
    print(count_down(100000))

    print("TCO OK")
