type Point
    x: Int
    y: Int

type Rect
    x: Int
    y: Int
    w: Int
    h: Int

fn Point.translate(dx, dy)
    Point { x: self.x + dx, y: self.y + dy }

fn Point.manhattan()
    abs(self.x) + abs(self.y)

fn Point.scale(factor)
    Point { x: self.x * factor, y: self.y * factor }

fn Point.eq(other)
    self.x == other.x and self.y == other.y

fn Point.to_string()
    "(" + str(self.x) + ", " + str(self.y) + ")"

fn Rect.area()
    self.w * self.h

fn Rect.contains(px, py)
    px >= self.x and px < self.x + self.w and py >= self.y and py < self.y + self.h

// Basic field access
p = Point { x: 3, y: 4 }
print(p.x)
print(p.y)

// Simple method calls
print(p.manhattan())

// Method returning struct
p2 = p.translate(1, 2)
print(p2.x)
print(p2.y)

// Method with multiplication
p3 = p.scale(2)
print(p3.x)
print(p3.y)

// Method returning bool
print(p.eq(Point { x: 3, y: 4 }))
print(p.eq(Point { x: 0, y: 0 }))

// Method returning string
print(p.to_string())

// Method chaining
print(p.translate(10, 20).manhattan())
print(p.scale(3).translate(1, 1).manhattan())

// Second struct type
r = Rect { x: 0, y: 0, w: 10, h: 5 }
print(r.area())
print(r.contains(5, 3))
print(r.contains(15, 3))
