import forge_crypto

fn main()
    // ---- RFC 4648 base64 vectors: exercises rem = 0, 1 and 2 tails ----
    print("[" + b64_encode_blist(str_to_blist("")) + "]")
    print("[" + b64_encode_blist(str_to_blist("f")) + "]")
    print("[" + b64_encode_blist(str_to_blist("fo")) + "]")
    print("[" + b64_encode_blist(str_to_blist("foo")) + "]")
    print("[" + b64_encode_blist(str_to_blist("foob")) + "]")
    print("[" + b64_encode_blist(str_to_blist("fooba")) + "]")
    print("[" + b64_encode_blist(str_to_blist("foobar")) + "]")
    // round trip, including all three tail shapes
    print("[" + hex_of(b64_decode_blist("Zg==")) + "]")
    print("[" + hex_of(b64_decode_blist("Zm8=")) + "]")
    print("[" + hex_of(b64_decode_blist("Zm9v")) + "]")
    print("[" + hex_of(b64_decode_blist("Zm9vYmFy")) + "]")
    print("[" + hex_of(b64_decode_blist("")) + "]")
    // malformed / padding-only / stray characters
    print("[" + hex_of(b64_decode_blist("=")) + "]")
    print("[" + hex_of(b64_decode_blist("Zm9v=extra")) + "]")
    print("[" + hex_of(b64_decode_blist("Zm 9v")) + "]")
    print("[" + b64_encode_blist([255, 255, 255]) + "]")
    print("[" + b64_encode_blist([0, 0, 0]) + "]")
    print("[" + b64_encode_blist([251, 255, 190]) + "]")

    // ---- SHA-256 known answers (covers str_to_blist + hex_of downstream) ----
    print("[" + sha256_hex("") + "]")
    print("[" + sha256_hex("abc") + "]")
    print("[" + sha256_hex("The quick brown fox jumps over the lazy dog") + "]")
    // a payload longer than one 64-byte block, to exercise padding
    print("[" + sha256_hex("abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz") + "]")

    // ---- MD5 known answers ----
    print("[" + md5_hex("") + "]")
    print("[" + md5_hex("abc") + "]")

    // ---- hex_of / hex_to_blist round trip + edge cases ----
    print("[" + hex_of([]) + "]")
    print("[" + hex_of([0]) + "]")
    print("[" + hex_of([255]) + "]")
    print("[" + hex_of([0, 15, 16, 128, 255]) + "]")
    print(hex_to_blist(""))
    print(hex_to_blist("00"))
    print(hex_to_blist("ff"))
    print(hex_to_blist("000f1080ff"))
    print(hex_to_blist("ABCDEF"))
    print(hex_to_blist("abc"))          // odd length -- trailing nibble ignored
    print(hex_to_blist("a"))            // single char
    print("[" + hex_of(hex_to_blist("deadbeef")) + "]")

    // ---- str_to_blist edge cases ----
    print(str_to_blist(""))
    print(str_to_blist("A"))
    print(str_to_blist("hello"))

    // ---- HMAC / PBKDF2 / AES-GCM / ChaCha20 must be untouched ----
    print("[" + hex_of(hmac_sha256_bytes(str_to_blist("key"), str_to_blist("The quick brown fox jumps over the lazy dog"))) + "]")
    print("[" + hex_of(hmac_sha1_bytes(str_to_blist("key"), str_to_blist("msg"))) + "]")
    print("[" + hex_of(pbkdf2_sha256(str_to_blist("password"), str_to_blist("salt"), 1, 32)) + "]")
    print("[" + hex_of(aes_encrypt_block(hex_to_blist("000102030405060708090a0b0c0d0e0f"), hex_to_blist("000102030405060708090a0b0c0d0e0f"))) + "]")
    print("[" + hex_of(chacha20(hex_to_blist("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"), hex_to_blist("000000090000004a00000000"), 1, str_to_blist("hi"))) + "]")
    print("[" + hex_of(poly1305_mac(hex_to_blist("85d6be7857556d337f4452fe42d506a80103808afb0db2fd4abff6af4149f51b"), str_to_blist("Cryptographic Forum Research Group"))) + "]")
    print("[" + hex_of(hkdf(str_to_blist("salt"), str_to_blist("ikm"), str_to_blist("info"), 32)) + "]")
    print("EXERCISE-DONE")
