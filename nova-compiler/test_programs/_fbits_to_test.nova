// float_to_bits: EXACT float64 -> raw 64-bit IEEE-754 pattern (no %.15g lossiness), the inverse of
// float_from_bits. Needed for bit-exact float serialization (msgpack/CBOR float64, binary pack).
fn main()
    let x = 3.14159265358979
    let bits = float_to_bits(x)
    let back = float_from_bits(bits)
    if back != x                                  // exact round-trip
        print("FAIL roundtrip: " + str(back))
        exit(1)
    if float_to_bits(1.5) != 4609434218613702656  // 1.5 == 0x3FF8000000000000
        print("FAIL 1.5 bits: " + str(float_to_bits(1.5)))
        exit(1)
    if float_to_bits(0.0) != 0                     // +0.0 == all-zero bits
        print("FAIL 0.0 bits: " + str(float_to_bits(0.0)))
        exit(1)
    // exact bits survive a list round-trip (boxed-float path -- the msgpack use case)
    let xs = [2.5, 1.5]
    if float_to_bits(xs[0]) != 4612811918334230528  // 2.5 == 0x4004000000000000
        print("FAIL boxed 2.5 bits: " + str(float_to_bits(xs[0])))
        exit(1)
    print("PASS _fbits_to_test")
