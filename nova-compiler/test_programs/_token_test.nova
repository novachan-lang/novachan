// KAT test for std/random/token
// All expected values computed by simulating the exact same LCG in Python.
// LCG: state = (state * 6364136223846793005 + 1442695040888963407) & 0x7FFFFFFFFFFFFFFF
// byte = state % 256, hex: hi=(byte/16)%16, lo=byte%16
// alnum: charset "0-9A-Za-z" (62 chars), idx=state%62
// numeric: digit = state%10
// urlsafe: charset "A-Za-z0-9-_" (64 chars), idx=state%64

import std/random/token

// ── test helpers ─────────────────────────────────────────────────────────────

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got '" + got + "' want '" + want + "'")
        exit(1)

// Check every character in s is contained in charset
fn all_chars_in(s: string, charset: string) -> int
    let i = 0
    while i < len(s)
        let c = char_at(s, i)
        let found = 0
        let j = 0
        while j < len(charset)
            if char_at(charset, j) == c
                found = 1
            j = j + 1
        if found == 0
            return 0
        i = i + 1
    1

// ═════════════════════════════════════════════════════════════════════════════
// KAT 1: tk_hex(16, 1) has length 32 (2*nbytes)
// ═════════════════════════════════════════════════════════════════════════════
let hex16 = tk_hex(16, 1)
cki("kat1_hex16_len", len(hex16), 32)

// ═════════════════════════════════════════════════════════════════════════════
// KAT 2: tk_alnum(10, 2) has length 10
// ═════════════════════════════════════════════════════════════════════════════
let alnum10 = tk_alnum(10, 2)
cki("kat2_alnum10_len", len(alnum10), 10)

// ═════════════════════════════════════════════════════════════════════════════
// KAT 3: tk_numeric(6, 3) has length 6
// ═════════════════════════════════════════════════════════════════════════════
let num6 = tk_numeric(6, 3)
cki("kat3_numeric6_len", len(num6), 6)

// ═════════════════════════════════════════════════════════════════════════════
// KAT 4: tk_hex(8, 5) == tk_hex(8, 5)  [deterministic — same seed same output]
// ═════════════════════════════════════════════════════════════════════════════
let hex8a = tk_hex(8, 5)
let hex8b = tk_hex(8, 5)
cks("kat4_deterministic", hex8a, hex8b)

// ═════════════════════════════════════════════════════════════════════════════
// KAT 5: every character of tk_hex(8, 5) is a valid hex character
// ═════════════════════════════════════════════════════════════════════════════
let hex_charset = "0123456789abcdef"
let hex8_ok = all_chars_in(hex8a, hex_charset)
cki("kat5_hex_chars_valid", hex8_ok, 1)

// ═════════════════════════════════════════════════════════════════════════════
// KAT 6: every character of tk_numeric(6, 3) is a decimal digit
// ═════════════════════════════════════════════════════════════════════════════
let digit_charset = "0123456789"
let num6_ok = all_chars_in(num6, digit_charset)
cki("kat6_numeric_chars_valid", num6_ok, 1)

// ═════════════════════════════════════════════════════════════════════════════
// KAT 7: tk_alnum(20, 7) all characters are alphanumeric (0-9 A-Z a-z)
// ═════════════════════════════════════════════════════════════════════════════
let alnum_charset = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
let alnum20 = tk_alnum(20, 7)
let alnum20_ok = all_chars_in(alnum20, alnum_charset)
cki("kat7_alnum_chars_valid", alnum20_ok, 1)

// ═════════════════════════════════════════════════════════════════════════════
// KAT 8: tk_hex(4, 1) != tk_hex(4, 2)  [different seeds produce different output]
// ═════════════════════════════════════════════════════════════════════════════
let h4_seed1 = tk_hex(4, 1)
let h4_seed2 = tk_hex(4, 2)
// Python verified: "7c1b0ec5" vs "a90403d6" -- must differ
let seeds_differ = 0
if h4_seed1 != h4_seed2
    seeds_differ = 1
cki("kat8_diff_seeds_differ", seeds_differ, 1)

// ═════════════════════════════════════════════════════════════════════════════
// KAT 9: concrete tk_hex(16, 1) == Python-computed value
// ═════════════════════════════════════════════════════════════════════════════
cks("kat9_hex16_concrete", hex16, "7c1b0ec5f07fa2c9a423760d98078a91")

// ═════════════════════════════════════════════════════════════════════════════
// KAT 10: concrete tk_numeric(6, 3) == Python-computed value
// ═════════════════════════════════════════════════════════════════════════════
cks("kat10_numeric6_concrete", num6, "696709")

// ═════════════════════════════════════════════════════════════════════════════
// KAT 11: tk_urlsafe(8, 9) has length 8
// ═════════════════════════════════════════════════════════════════════════════
let url8 = tk_urlsafe(8, 9)
cki("kat11_urlsafe_len", len(url8), 8)

// ═════════════════════════════════════════════════════════════════════════════
// KAT 12: every char of tk_urlsafe(8, 9) is in the base64url charset
// ═════════════════════════════════════════════════════════════════════════════
let urlsafe_charset = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
let url8_ok = all_chars_in(url8, urlsafe_charset)
cki("kat12_urlsafe_chars_valid", url8_ok, 1)

// ═════════════════════════════════════════════════════════════════════════════
// KAT 13: concrete tk_urlsafe(8, 9) == Python-computed value
// ═════════════════════════════════════════════════════════════════════════════
cks("kat13_urlsafe8_concrete", url8, "kj2NYHKR")

// ═════════════════════════════════════════════════════════════════════════════
// KAT 14: concrete tk_alnum(10, 2) == Python-computed value
// ═════════════════════════════════════════════════════════════════════════════
cks("kat14_alnum10_concrete", alnum10, "5YBgdOtS9Q")

print("_token_test passed")
