import std/tensor/tsr_slice

// cki: assert integer equality
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _tsr_slice_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb: assert boolean equality
fn ckb(label: string, got: bool, want: bool)
    if got != want
        print("FAIL _tsr_slice_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckl: assert flat int list equality element-wise
fn ckl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL _tsr_slice_test " + label + " len: got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL _tsr_slice_test " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

// ckt: assert tensor [flat, shape] equality
fn ckt(label: string, t: list, want_flat: list, want_shape: list)
    let got_flat = t[0]
    let got_shape = t[1]
    ckl(label + "_shape", got_shape, want_shape)
    ckl(label + "_flat", got_flat, want_flat)

// Build want lists inline using push.
fn mk2(a: int, b: int) -> list
    let r = []
    push(r, a)
    push(r, b)
    r

fn mk3(a: int, b: int, c: int) -> list
    let r = []
    push(r, a)
    push(r, b)
    push(r, c)
    r

fn mk4(a: int, b: int, c: int, d: int) -> list
    let r = []
    push(r, a)
    push(r, b)
    push(r, c)
    push(r, d)
    r

fn mk6(a: int, b: int, c: int, d: int, e: int, f: int) -> list
    let r = []
    push(r, a)
    push(r, b)
    push(r, c)
    push(r, d)
    push(r, e)
    push(r, f)
    r

fn mk9(a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int, ii: int) -> list
    let r = []
    push(r, a)
    push(r, b)
    push(r, c)
    push(r, d)
    push(r, e)
    push(r, f)
    push(r, g)
    push(r, h)
    push(r, ii)
    r

// ---- ts_slice ----
// 3x3 matrix [[1,2,3],[4,5,6],[7,8,9]], rows [0,2), cols [1,3)
// -> 2x2 sub-block: rows 0..1, cols 1..2 -> [[2,3],[5,6]] -> flat [2,3,5,6], shape [2,2]
let flat33 = mk9(1,2,3,4,5,6,7,8,9)
let shape33 = mk2(3,3)
let t33 = []
push(t33, flat33)
push(t33, shape33)
let sl1 = ts_slice(t33, mk2(0,1), mk2(2,3))
ckt("slice_3x3_r0_2_c1_3", sl1, mk4(2,3,5,6), mk2(2,2))

// 1-D: [10,20,30,40,50], slice [1,4) -> [20,30,40]
let flat1d = []
push(flat1d, 10)
push(flat1d, 20)
push(flat1d, 30)
push(flat1d, 40)
push(flat1d, 50)
let shape1d = []
push(shape1d, 5)
let t1d = []
push(t1d, flat1d)
push(t1d, shape1d)
let sl2_want = []
push(sl2_want, 20)
push(sl2_want, 30)
push(sl2_want, 40)
let sl2_want_shape = []
push(sl2_want_shape, 3)
let sl2 = ts_slice(t1d, mk2(1,0), mk2(4,0))
// Note: for 1-D we only have 1 dim, pass length-1 starts/stops
let sl2b_starts = []
push(sl2b_starts, 1)
let sl2b_stops = []
push(sl2b_stops, 4)
let sl2b = ts_slice(t1d, sl2b_starts, sl2b_stops)
ckt("slice_1d_1_4", sl2b, sl2_want, sl2_want_shape)

// ---- ts_row ----
// 2x3 [[1,2,3],[4,5,6]], row 1 -> [4,5,6], shape [3]
let flat23 = mk6(1,2,3,4,5,6)
let shape23 = mk2(2,3)
let t23 = []
push(t23, flat23)
push(t23, shape23)
let row1 = ts_row(t23, 1)
let want_row1 = mk3(4,5,6)
let want_row1_shape = mk3(3,0,0)
// shape should be [3], build it properly
let ws1 = []
push(ws1, 3)
ckt("row_2x3_row1", row1, want_row1, ws1)

// row 0 -> [1,2,3]
let row0 = ts_row(t23, 0)
let want_row0 = mk3(1,2,3)
let ws0 = []
push(ws0, 3)
ckt("row_2x3_row0", row0, want_row0, ws0)

// ---- ts_col ----
// 3x3, column 2 -> [3,6,9], shape [3]
let col2 = ts_col(t33, 2)
let want_col2 = mk3(3,6,9)
let wsc2 = []
push(wsc2, 3)
ckt("col_3x3_col2", col2, want_col2, wsc2)

// 2x3, column 0 -> [1,4], shape [2]
let col0_23 = ts_col(t23, 0)
let want_col0 = mk2(1,4)
let wsc0 = []
push(wsc0, 2)
ckt("col_2x3_col0", col0_23, want_col0, wsc0)

// ---- ts_diagonal ----
// 3x3: diagonal -> [1,5,9], shape [3]
let diag33 = ts_diagonal(t33)
let want_diag = mk3(1,5,9)
let wsd = []
push(wsd, 3)
ckt("diagonal_3x3", diag33, want_diag, wsd)

// 2x3: diagonal -> min(2,3)=2 elements -> [1,5], shape [2]
let diag23 = ts_diagonal(t23)
let want_diag23 = mk2(1,5)
let wsd23 = []
push(wsd23, 2)
ckt("diagonal_2x3", diag23, want_diag23, wsd23)

// ---- ts_take ----
// 3x2 [[1,2],[3,4],[5,6]], take rows [0,2] -> [[1,2],[5,6]], flat [1,2,5,6], shape [2,2]
let flat32 = mk6(1,2,3,4,5,6)
let shape32 = mk2(3,2)
let t32 = []
push(t32, flat32)
push(t32, shape32)
let idx_flat = mk2(0,2)
let idx_shape = mk2(2,0)
// indices tensor: [[0,2],[2]]
let idx_shape_1d = []
push(idx_shape_1d, 2)
let idx_t = []
push(idx_t, idx_flat)
push(idx_t, idx_shape_1d)
let taken = ts_take(t32, idx_t, 0)
let want_taken_flat = mk4(1,2,5,6)
let want_taken_shape = mk2(2,2)
ckt("take_3x2_rows_0_2", taken, want_taken_flat, want_taken_shape)

print("PASS _tsr_slice_test")
