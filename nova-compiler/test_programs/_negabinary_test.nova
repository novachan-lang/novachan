import std/numeral/negabinary

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL negabinary " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL negabinary " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // nb_encode KAT
    cks("encode(0)", nb_encode(0), "0")
    cks("encode(1)", nb_encode(1), "1")
    cks("encode(2)", nb_encode(2), "110")
    cks("encode(3)", nb_encode(3), "111")
    cks("encode(6)", nb_encode(6), "11010")
    cks("encode(-1)", nb_encode(-1), "11")

    // nb_decode KAT
    cki("decode('0')", nb_decode("0"), 0)
    cki("decode('1')", nb_decode("1"), 1)
    cki("decode('110')", nb_decode("110"), 2)
    cki("decode('111')", nb_decode("111"), 3)
    cki("decode('11010')", nb_decode("11010"), 6)
    cki("decode('11')", nb_decode("11"), -1)

    // Round-trip: nb_decode(nb_encode(n)) == n
    cki("roundtrip(500)", nb_decode(nb_encode(500)), 500)
    cki("roundtrip(-500)", nb_decode(nb_encode(-500)), -500)

    // Additional round-trips
    cki("roundtrip(0)", nb_decode(nb_encode(0)), 0)
    cki("roundtrip(4)", nb_decode(nb_encode(4)), 4)
    cki("roundtrip(7)", nb_decode(nb_encode(7)), 7)
    cki("roundtrip(-2)", nb_decode(nb_encode(-2)), -2)
    cki("roundtrip(-3)", nb_decode(nb_encode(-3)), -3)
    cki("roundtrip(-6)", nb_decode(nb_encode(-6)), -6)
    cki("roundtrip(100)", nb_decode(nb_encode(100)), 100)
    cki("roundtrip(-100)", nb_decode(nb_encode(-100)), -100)
    cki("roundtrip(1000)", nb_decode(nb_encode(1000)), 1000)
    cki("roundtrip(-1000)", nb_decode(nb_encode(-1000)), -1000)

    // Sweep round-trip n = -30..30
    let k = -30
    while k <= 30
        cki("sweep(" + str(k) + ")", nb_decode(nb_encode(k)), k)
        k = k + 1

    print("PASS _negabinary_test")
