import std/text/whitespace

// ── helpers ──────────────────────────────────────────────────────────────────
fn cks(label, got, exp)
    if got != exp
        print("FAIL " + label + ": got=" + got + " expected=" + exp)
        exit(1)

fn ckb(label, got, exp)
    if got != exp
        let gs = "false"
        if got
            gs = "true"
        let es = "false"
        if exp
            es = "true"
        print("FAIL " + label + ": got=" + gs + " expected=" + es)
        exit(1)

// ── ws_trim ──────────────────────────────────────────────────────────────────
cks("trim basic",          ws_trim("  hi  "),          "hi")
cks("trim tab+nl",         ws_trim(chr(9)+"x"+chr(10)), "x")
cks("trim already clean",  ws_trim("hello"),            "hello")
cks("trim empty",          ws_trim(""),                 "")
cks("trim all ws",         ws_trim("   "),              "")

// ── ws_collapse ───────────────────────────────────────────────────────────────
cks("collapse spaces",     ws_collapse("  a   b  "),            "a b")
cks("collapse mixed ws",   ws_collapse("a"+chr(9)+"b"+chr(10)+"c"), "a b c")
cks("collapse clean",      ws_collapse("hello world"),          "hello world")
cks("collapse empty",      ws_collapse(""),                     "")
cks("collapse all ws",     ws_collapse("   "),                  "")
cks("collapse multi word", ws_collapse("  foo   bar   baz  "), "foo bar baz")

// ── ws_squeeze ────────────────────────────────────────────────────────────────
// squeeze: internal runs collapsed but DOES NOT trim (preserves outer single space)
cks("squeeze internal",    ws_squeeze("a   b   c"),   "a b c")
cks("squeeze leading",     ws_squeeze("  hi"),        " hi")
cks("squeeze trailing",    ws_squeeze("hi  "),        "hi ")
cks("squeeze empty",       ws_squeeze(""),            "")
cks("squeeze single sp",   ws_squeeze("a b"),         "a b")

// ── ws_strip_all ──────────────────────────────────────────────────────────────
cks("strip_all basic",     ws_strip_all("a b c"),    "abc")
cks("strip_all tabs",      ws_strip_all("a"+chr(9)+"b"+chr(9)+"c"), "abc")
cks("strip_all mixed",     ws_strip_all("  a  b  "), "ab")
cks("strip_all empty",     ws_strip_all(""),          "")
cks("strip_all all ws",    ws_strip_all("   "),       "")

// ── ws_is_blank ───────────────────────────────────────────────────────────────
ckb("blank spaces",        ws_is_blank("   "),       true)
ckb("blank empty",         ws_is_blank(""),          true)
ckb("blank not x",         ws_is_blank("x"),         false)
ckb("blank tab+nl",        ws_is_blank(chr(9)+chr(10)+chr(13)), true)
ckb("blank space+x",       ws_is_blank(" x "),       false)

print("_whitespace_test passed")
