// KAT test for std/text/keyword
import std/text/keyword

fn ckb(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn ckgt(label, got, threshold)
    if got <= threshold
        print("FAIL " + label + ": got " + str(got) + " expected > " + str(threshold))
        exit(1)

fn main()
    // 1. kw_is_stop: known stopwords
    ckb("is_stop_the",    kw_is_stop("the"),    true)
    ckb("is_stop_and",    kw_is_stop("and"),    true)
    ckb("is_stop_is",     kw_is_stop("is"),     true)
    ckb("is_stop_rocket", kw_is_stop("rocket"), false)
    ckb("is_stop_engine", kw_is_stop("engine"), false)
    ckb("is_stop_cat",    kw_is_stop("cat"),    false)

    // 2. kw_is_stop is case-insensitive
    ckb("is_stop_THE_upper", kw_is_stop("THE"), true)
    ckb("is_stop_And_mixed", kw_is_stop("And"), true)

    // 3. kw_stopwords returns a non-empty list
    let stops = kw_stopwords()
    if len(stops) < 10
        print("FAIL stopwords_count: too few stopwords, got " + str(len(stops)))
        exit(1)

    // 4. kw_normalize lowercases
    let norm = kw_normalize("Hello WORLD")
    if norm != "hello world"
        print("FAIL normalize: got '" + norm + "' expected 'hello world'")
        exit(1)

    // 5. kw_candidate_phrases: split at stopwords
    // 'the rocket engine and the rocket fuel system'
    // stopwords: the, and, the => phrases: [rocket,engine], [rocket,fuel,system]
    let text = "the rocket engine and the rocket fuel system"
    let phrases = kw_candidate_phrases(text)
    if len(phrases) < 2
        print("FAIL candidate_phrases_count: got " + str(len(phrases)) + " expected >= 2")
        exit(1)

    // check each phrase contains only non-stop words
    let p0 = phrases[0]
    let p1 = phrases[1]
    // p0 should be ['rocket','engine']
    cki("phrase0_len", len(p0), 2)
    if p0[0] != "rocket"
        print("FAIL phrase0_word0: got '" + p0[0] + "' expected 'rocket'")
        exit(1)
    if p0[1] != "engine"
        print("FAIL phrase0_word1: got '" + p0[1] + "' expected 'engine'")
        exit(1)

    // p1 should be ['rocket','fuel','system']
    cki("phrase1_len", len(p1), 3)
    if p1[0] != "rocket"
        print("FAIL phrase1_word0: got '" + p1[0] + "' expected 'rocket'")
        exit(1)

    // 6. kw_word_freq: 'rocket' appears in 2 phrases, each phrase has 1 'rocket' => freq=2
    let freq = kw_word_freq(phrases)
    if contains(freq, "rocket") == 0
        print("FAIL freq_has_rocket: key 'rocket' missing")
        exit(1)
    cki("freq_rocket", freq["rocket"], 2)
    cki("freq_engine", freq["engine"], 1)

    // 7. kw_word_degree: rocket in phrase of len 2 + phrase of len 3 => deg=5
    let deg = kw_word_degree(phrases)
    cki("deg_rocket", deg["rocket"], 5)
    // engine in phrase of len 2 => deg=2
    cki("deg_engine", deg["engine"], 2)

    // 8. kw_word_score: rocket = 5/2 = 2.5, engine = 2/1 = 2.0
    let ws = kw_word_score(phrases)
    let rs = ws["rocket"]
    let es = ws["engine"]
    if rs < 2.4 or rs > 2.6
        print("FAIL word_score_rocket: got " + str(rs) + " expected ~2.5")
        exit(1)
    if es < 1.9 or es > 2.1
        print("FAIL word_score_engine: got " + str(es) + " expected ~2.0")
        exit(1)

    // 9. kw_phrase_score: 'rocket fuel system' scores sum of rocket+fuel+system scores
    //    All three have degree 3 / freq 1 = 3.0 except rocket (2.5)
    //    So sum >= rocket_score(2.5) meaning phrase_score > single word score for 'engine'(2.0)
    let phrase_system = p1
    let ps = kw_phrase_score(phrase_system, ws)
    // phrase_score(['rocket','fuel','system']) should be > phrase_score(['rocket','engine'])
    let phrase_engine = p0
    let pe = kw_phrase_score(phrase_engine, ws)
    if ps <= pe
        print("FAIL phrase_score_longer_gt: system-phrase=" + str(ps) + " engine-phrase=" + str(pe))
        exit(1)

    // 10. kw_rake_top returns top phrase containing 'rocket'
    let top = kw_rake_top(text, 1)
    cki("rake_top_count", len(top), 1)
    let top_phrase = top[0]
    if len(top_phrase) == 0
        print("FAIL rake_top_nonempty: got empty string")
        exit(1)
    // The top phrase should contain 'rocket'
    // We check by checking the string contains 'rocket' as a substring
    let found_rocket = false
    let tp_len = len(top_phrase)
    let ri = 0
    while ri <= tp_len - 6
        if slice(top_phrase, ri, ri + 6) == "rocket"
            found_rocket = true
        ri = ri + 1
    if found_rocket == false
        print("FAIL rake_top_has_rocket: got '" + top_phrase + "' — expected 'rocket' in top phrase")
        exit(1)

    // 11. kw_rake returns all candidate phrases
    let all_ranked = kw_rake(text)
    if len(all_ranked) < 2
        print("FAIL rake_count: got " + str(len(all_ranked)) + " expected >= 2")
        exit(1)

    // 12. longer phrase scores >= shorter phrase (system phrase > engine phrase)
    let r0 = all_ranked[0]
    let r0score = r0["score"]
    ckgt("rake_top_score_positive", r0score, 0.0)

    // 13. kw_dedup: no duplicates in candidate_phrases for this text
    let deduped = kw_dedup(phrases)
    cki("dedup_same_count", len(deduped), len(phrases))

    // 14. kw_score for the top-ranked phrase > 0.0
    let top_str = top[0]
    let top_score = kw_score(text, top_str)
    ckgt("kw_score_positive", top_score, 0.0)

    // 15. empty text safety
    let empty_phrases = kw_candidate_phrases("")
    cki("empty_phrases", len(empty_phrases), 0)
    let empty_ranked = kw_rake("")
    cki("empty_rake", len(empty_ranked), 0)

    print("PASS _keyword_test")
