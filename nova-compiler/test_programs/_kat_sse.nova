// KAT probe for forge_sse -- Server-Sent Events formatting/parsing.
import forge_sse

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // KAT 1: basic event
    let e1 = sse_event("hello")
    cks("kat1-basic", e1, "data: hello\n\n")
    print("KAT 1 PASS: sse_event basic format")

    // KAT 2: named event
    let e2 = sse_event_named("update", "42")
    cks("kat2-named", e2, "event: update\ndata: 42\n\n")
    print("KAT 2 PASS: sse_event_named format")

    // KAT 3: event with id
    let e3 = sse_event_id("101", "tick", "payload")
    cks("kat3-id", e3, "id: 101\nevent: tick\ndata: payload\n\n")
    print("KAT 3 PASS: sse_event_id format")

    // KAT 4: comment
    let e4 = sse_comment("keep-alive")
    cks("kat4-comment", e4, ": keep-alive\n")
    print("KAT 4 PASS: sse_comment format")

    // KAT 5: retry
    let e5 = sse_retry(3000)
    cks("kat5-retry", e5, "retry: 3000\n\n")
    print("KAT 5 PASS: sse_retry format")

    // KAT 6: multiline data
    let e6 = sse_multiline("line one\nline two\nline three")
    cks("kat6-multiline", e6, "data: line one\ndata: line two\ndata: line three\n\n")
    print("KAT 6 PASS: sse_multiline splits and prefixes each line")

    // KAT 6b: multiline data with a single line (no embedded newline)
    let e6b = sse_multiline("solo")
    cks("kat6b-multiline-single", e6b, "data: solo\n\n")
    print("KAT 6b PASS: sse_multiline handles single-line data")

    // KAT 7: headers dict
    let h = sse_headers()
    cks("kat7-content-type", h["Content-Type"], "text/event-stream")
    cks("kat7-cache-control", h["Cache-Control"], "no-cache")
    cks("kat7-connection", h["Connection"], "keep-alive")
    print("KAT 7 PASS: sse_headers returns required response headers")

    // KAT 8: parse round-trip -- single named+id event
    let raw8 = sse_event_id("7", "greet", "hi there")
    let parsed8 = sse_parse(raw8)
    cki("kat8-len", len(parsed8), 1)
    let p8 = parsed8[0]
    cks("kat8-event", p8["event"], "greet")
    cks("kat8-data", p8["data"], "hi there")
    cks("kat8-id", p8["id"], "7")
    cki("kat8-retry-default", p8["retry"], -1)
    print("KAT 8 PASS: sse_parse round-trips sse_event_id output")

    // KAT 9: parse a basic event -- default event name is "message", default id is ""
    let raw9 = sse_event("just data")
    let parsed9 = sse_parse(raw9)
    cki("kat9-len", len(parsed9), 1)
    let p9 = parsed9[0]
    cks("kat9-event-default", p9["event"], "message")
    cks("kat9-data", p9["data"], "just data")
    cks("kat9-id-default", p9["id"], "")
    print("KAT 9 PASS: sse_parse fills SSE defaults (event=message, id='')")

    // KAT 10: parse multiline data -- multiple "data:" lines concatenate with \n
    let raw10 = sse_multiline("alpha\nbeta\ngamma")
    let parsed10 = sse_parse(raw10)
    cki("kat10-len", len(parsed10), 1)
    cks("kat10-data-joined", parsed10[0]["data"], "alpha\nbeta\ngamma")
    print("KAT 10 PASS: sse_parse concatenates multi-line data fields")

    // KAT 11: parse multiple records separated by blank lines, plus a comment line and a retry field
    let raw11 = sse_comment("ping") + sse_event_named("a", "1") + sse_retry(5000) + sse_event_named("b", "2")
    let parsed11 = sse_parse(raw11)
    // the lone comment line + blank has no data field so it forms no standalone record (blank-trimmed away
    // only if the whole block is blank); the comment is folded into the "a" record's preceding text since
    // there is no blank line directly after it -- verify at least both real events parse correctly.
    let found_a = false
    let found_b = false
    let found_retry = false
    for rec in parsed11
        if rec["event"] == "a" and rec["data"] == "1"
            found_a = true
        if rec["event"] == "b" and rec["data"] == "2"
            found_b = true
        if rec["retry"] == 5000
            found_retry = true
    if not found_a
        print("FAIL kat11: event 'a' record not found")
        exit(1)
    if not found_b
        print("FAIL kat11: event 'b' record not found")
        exit(1)
    if not found_retry
        print("FAIL kat11: retry=5000 record not found")
        exit(1)
    print("KAT 11 PASS: sse_parse handles multiple records with comments and retry")

    // KAT 12: parse with explicit retry field alone
    let raw12 = "retry: 2500\ndata: reconnect-hint\n\n"
    let parsed12 = sse_parse(raw12)
    cki("kat12-len", len(parsed12), 1)
    cki("kat12-retry", parsed12[0]["retry"], 2500)
    cks("kat12-data", parsed12[0]["data"], "reconnect-hint")
    print("KAT 12 PASS: sse_parse extracts retry field as int")

    // KAT 13: empty input -> no records
    let parsed13 = sse_parse("")
    cki("kat13-empty", len(parsed13), 0)
    print("KAT 13 PASS: sse_parse('') == []")

    print("FORGE-SSE KAT PASS")
