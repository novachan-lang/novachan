// _forge_router_test.nova -- Forge v0.3 increment 1: the router spine.
// Validates method + :param routing, 404/405, query-stripping, via the PURE dispatch
// path (deterministic, no socket), then proves it end-to-end over a REAL socket through
// serve_app_n. (serve_app_n uses the correct non-arena serve_n: the arena-scoped variant
// corrupts split() inside the scope -- a tracked arena bug found this iter, see forge.nova.)
import forge

fn h_index(req)
    forge.json_obj(200, [["msg", "welcome"]])

fn h_user(req)
    forge.json_obj(200, [["id", req["params"]["id"]]])

fn h_echo(req)
    forge.text(200, "echo:" + req["body"])

fn _run_server(port)
    let a = forge.app()
    forge.get(a, "/", fn(req) h_index(req))
    forge.get(a, "/users/:id", fn(req) h_user(req))
    forge.serve_app_n(a, port, 2)

fn main()
    // ── pure dispatch (no socket): the deterministic core ──
    let a = forge.app()
    forge.get(a, "/", fn(req) h_index(req))
    forge.get(a, "/users/:id", fn(req) h_user(req))
    forge.post(a, "/echo", fn(req) h_echo(req))

    let r1 = forge.dispatch(a, "GET", "/", "")
    assert(find(r1, "welcome") >= 0, "index routed")
    let r2 = forge.dispatch(a, "GET", "/users/42", "")
    assert(find(r2, "\"id\":\"42\"") >= 0, "path param extracted")
    let r3 = forge.dispatch(a, "POST", "/echo", "hi-body")
    assert(find(r3, "echo:hi-body") >= 0, "post body seen by handler")
    let r4 = forge.dispatch(a, "GET", "/nope/x", "")
    assert(find(r4, "404") >= 0, "404 on no route")
    let r5 = forge.dispatch(a, "POST", "/users/42", "")
    assert(find(r5, "405") >= 0, "405 on method mismatch (path exists, wrong method)")
    let r6 = forge.dispatch(a, "GET", "/users/7?tab=x", "")
    assert(find(r6, "\"id\":\"7\"") >= 0, "query string stripped before match")
    print("PASS: forge_router pure dispatch (routing, params, 404, 405, query-strip)")

    // ── socket round-trip: serve_app_n routes end-to-end, arena-scoped ──
    let port = 18941
    spawn fn() _run_server(port)
    sleep(300)
    let base = "http://127.0.0.1:" + str(port)
    let g1 = http_get(base + "/")
    assert(find(g1, "welcome") >= 0, "socket: index routed")
    let g2 = http_get(base + "/users/99")
    assert(find(g2, "\"id\":\"99\"") >= 0, "socket: path param routed end-to-end")
    print("PASS: forge_router socket round-trip (real TCP via serve_app_n -> serve_n)")
    print("ALL PASS: forge_router")
