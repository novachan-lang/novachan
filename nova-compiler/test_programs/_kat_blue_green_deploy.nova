import forge_blue_green_deploy

fn main()
    let b = bg_new()
    assert(bg_active_slot(b) == "blue", "starts blue")

    let d1 = bg_deploy(b, "blue", "v1.0")
    assert(is_ok(d1), "deploy blue ok")
    b = unwrap(d1)
    let d2 = bg_deploy(b, "green", "v2.0")
    assert(is_ok(d2), "deploy green ok")
    b = unwrap(d2)
    assert(bg_deploy_count(b) == 2, "2 deploys")

    let av = bg_active_version(b)
    assert(is_ok(av), "active ver ok")
    assert(unwrap(av) == "v1.0", "active=v1.0")

    assert(bg_inactive_slot(b) == "green", "inactive=green")
    let iv = bg_inactive_version(b)
    assert(is_ok(iv), "inactive ver ok")
    assert(unwrap(iv) == "v2.0", "inactive=v2.0")

    b = bg_switch(b)
    assert(bg_active_slot(b) == "green", "now green")
    assert(bg_switch_count(b) == 1, "1 switch")

    let av2 = bg_active_version(b)
    assert(unwrap(av2) == "v2.0", "active now v2.0")

    let bad = bg_deploy(b, "red", "v3.0")
    assert(is_err(bad), "invalid slot")

    print("BLUE-GREEN-DEPLOY KAT PASS")
