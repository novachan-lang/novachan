import std/game/swiss_pair

fn chk_int(name: string, got: int, want: int)
    if got != want
        print("FAIL swiss_pair " + name + ": got " + str(got) + " want " + str(want))
        exit(1)

fn chk_bool(name: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL swiss_pair " + name + ": got " + gs + " want " + ws)
        exit(1)

fn make_player(id: int, score: int) -> any
    let p = []
    push(p, id)
    push(p, score)
    p

fn test_even()
    // [[1,2],[2,2],[3,1],[4,0]] -> [[1,2],[3,4]]
    let players = []
    push(players, make_player(1, 2))
    push(players, make_player(2, 2))
    push(players, make_player(3, 1))
    push(players, make_player(4, 0))
    let pairs = swiss_pair(players)
    chk_int("even len", len(pairs), 2)
    let p0 = pairs[0]
    chk_int("pair0 idA", p0[0], 1)
    chk_int("pair0 idB", p0[1], 2)
    let p1 = pairs[1]
    chk_int("pair1 idA", p1[0], 3)
    chk_int("pair1 idB", p1[1], 4)

fn test_odd()
    // 3 players: [[1,3],[2,2],[3,1]] -> [[1,2],[3,-1]]
    let players = []
    push(players, make_player(1, 3))
    push(players, make_player(2, 2))
    push(players, make_player(3, 1))
    let pairs = swiss_pair(players)
    chk_int("odd len", len(pairs), 2)
    let p0 = pairs[0]
    chk_int("odd pair0 idA", p0[0], 1)
    chk_int("odd pair0 idB", p0[1], 2)
    let bye = pairs[1]
    chk_int("bye id", bye[0], 3)
    chk_int("bye marker", bye[1], -1)

fn test_one()
    // 1 player: gets a bye
    let players = []
    push(players, make_player(5, 0))
    let pairs = swiss_pair(players)
    chk_int("one len", len(pairs), 1)
    let p0 = pairs[0]
    chk_int("one bye id", p0[0], 5)
    chk_int("one bye marker", p0[1], -1)

fn test_two()
    // 2 players: one pair
    let players = []
    push(players, make_player(10, 5))
    push(players, make_player(20, 3))
    let pairs = swiss_pair(players)
    chk_int("two len", len(pairs), 1)
    let p0 = pairs[0]
    chk_int("two idA", p0[0], 10)
    chk_int("two idB", p0[1], 20)

fn main()
    test_even()
    test_odd()
    test_one()
    test_two()
    print("PASS _swiss_pair_test")
