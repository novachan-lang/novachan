fn fib(n: int) -> int
    if n < 2
        return n
    return fib(n - 1) + fib(n - 2)

fn fact(n: int) -> int
    let acc = 1
    let i = 1
    while i <= n
        acc = acc * i
        i = i + 1
    return acc

fn is_big(n: int) -> bool
    return n > 100

const GLOBAL_K = 7
fn uses_global(n: int) -> int
    return n + GLOBAL_K

const FIB20 = fib(20)
const FACT10 = fact(10)
const FLAG = is_big(50)
const USES = uses_global(3)

fn main()
    let r1 = fib(20)
    let r2 = fact(10)
    print(str(FIB20))
    print(str(FACT10))
    // fold==runtime oracle
    if FIB20 == r1
        print("FIB20_OK")
    else
        print("FIB20_MISMATCH")
    if FACT10 == r2
        print("FACT10_OK")
    else
        print("FACT10_MISMATCH")
    // bool-returning const must NOT be folded as int (must print "false", not "0")
    print(str(FLAG))
    // const fn referencing a global -> unknown ident -> fail-closed -> runtime
    if USES == 10
        print("USES_OK")
    else
        print("USES_MISMATCH")
