import forge_network_simulator

fn main()
    let n = ns_new()
    n = ns_add_link(n, "A", "B", 10, 20)
    n = ns_add_link(n, "B", "C", 5, 0)

    let r1 = ns_send(n, "A", "B", 50)
    n = r1["n"]
    assert(r1["delivered"] == 1, "50 > 20 = delivered")
    assert(r1["latency"] == 10, "10ms latency")

    let r2 = ns_send(n, "A", "B", 10)
    n = r2["n"]
    assert(r2["delivered"] == 0, "10 < 20 = dropped")

    let r3 = ns_send(n, "B", "C", 50)
    n = r3["n"]
    assert(r3["delivered"] == 1, "0% loss = always deliver")

    let r4 = ns_send(n, "X", "Y", 50)
    n = r4["n"]
    assert(r4["delivered"] == 0, "no link")
    assert(r4["reason"] == "no_link", "no_link reason")

    assert(ns_total_sent(n) == 4, "4 sent")
    assert(ns_total_dropped(n) == 1, "1 dropped")
    assert(ns_delivery_rate(n) == 75, "75% delivery")

    print("NETWORK-SIMULATOR KAT PASS")
