// KAT test for std/numeric/bisection.nova
// Tests bisection root-finding: bs_root, bs_root_iters, bs_has_root
import std/numeric/bisection

// fsq: f(x) = x^2 - 2, root at x = sqrt(2) ~= 1.41421
fn fsq(x) -> float
    let v = x * x - 2.0
    return v

// flin: f(x) = 2x - 6, root at x = 3.0
fn flin(x) -> float
    let v = 2.0 * x - 6.0
    return v

// fcube: f(x) = x^3 - 27, root at x = 3.0
fn fcube(x) -> float
    let v = x * x * x - 27.0
    return v

fn ckf(label, got, expected, eps)
    let diff = got - expected
    let adiff = diff
    if diff < 0.0
        let adiff = 0.0 - diff
    if adiff > eps
        print("FAIL: " + label + " got=" + str(got) + " expected=" + str(expected) + " eps=" + str(eps))
        exit(1)

fn main()
    let eps = 0.01

    // KAT 1: bs_root(fsq, 0, 2, 0.0001) ~= sqrt(2) ~= 1.41421
    let r1 = bisection.bs_root(fsq, 0.0, 2.0, 0.0001)
    ckf("bs_root fsq sqrt2", r1, 1.41421, eps)

    // KAT 2: bs_root(flin, 0, 10, 0.0001) = 3.0  (2x-6=0 => x=3)
    let r2 = bisection.bs_root(flin, 0.0, 10.0, 0.0001)
    ckf("bs_root flin 3.0", r2, 3.0, eps)

    // KAT 3: bs_root(fcube, 0, 5, 0.0001) = 3.0  (x^3-27=0 => x=3)
    let r3 = bisection.bs_root(fcube, 0.0, 5.0, 0.0001)
    ckf("bs_root fcube 3.0", r3, 3.0, eps)

    // KAT 4: bs_has_root(fsq, 0, 2) = true  (fsq(0)=-2 <0, fsq(2)=2 >0)
    let h4 = bisection.bs_has_root(fsq, 0.0, 2.0)
    if h4 != 1
        print("FAIL: bs_has_root(fsq,0,2) expected true got " + str(h4))
        exit(1)

    // KAT 5: bs_has_root(fsq, 2, 3) = false  (fsq(2)=2>0, fsq(3)=7>0, same sign)
    let h5 = bisection.bs_has_root(fsq, 2.0, 3.0)
    if h5 != 0
        print("FAIL: bs_has_root(fsq,2,3) expected false got " + str(h5))
        exit(1)

    // KAT 6: bs_root_iters(flin, 0, 10, 50) should converge to 3.0
    let r6 = bisection.bs_root_iters(flin, 0.0, 10.0, 50)
    ckf("bs_root_iters flin 50iter", r6, 3.0, eps)

    // KAT 7: bs_has_root(flin, 0, 10) = true  (flin(0)=-6<0, flin(10)=14>0)
    let h7 = bisection.bs_has_root(flin, 0.0, 10.0)
    if h7 != 1
        print("FAIL: bs_has_root(flin,0,10) expected true got " + str(h7))
        exit(1)

    // KAT 8: bs_root_iters(fcube, 0, 5, 60) should converge to 3.0
    let r8 = bisection.bs_root_iters(fcube, 0.0, 5.0, 60)
    ckf("bs_root_iters fcube 60iter", r8, 3.0, eps)

    print("_bisection_test passed")
