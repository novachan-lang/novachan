import std/geometry/cg_lattice

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + ": length mismatch")
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL " + label + ": index " + str(i) + " got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // KAT 1: gcd(12,8)=4
    cki("gcd(12,8)", cgll_gcd(12, 8), 4)

    // KAT 2: gcd(0,5)=5
    cki("gcd(0,5)", cgll_gcd(0, 5), 5)

    // KAT 3: gcd(7,7)=7
    cki("gcd(7,7)", cgll_gcd(7, 7), 7)

    // KAT 4: gcd(1,1)=1
    cki("gcd(1,1)", cgll_gcd(1, 1), 1)

    // KAT 5: boundary_points of unit square [0,0],[2,0],[2,2],[0,2]
    // Edges: (0,0)-(2,0): gcd(2,0)=2; (2,0)-(2,2): gcd(0,2)=2; (2,2)-(0,2): gcd(2,0)=2; (0,2)-(0,0): gcd(0,2)=2 => 8
    let sq = [[0, 0], [2, 0], [2, 2], [0, 2]]
    cki("boundary_points(sq)", cgll_boundary_points(sq), 8)

    // KAT 6: interior_points of 2x2 square = Pick: A=4, B=8, I=(8-8+2)/2=1
    cki("interior_points(sq)", cgll_interior_points(sq), 1)

    // KAT 7: boundary_points of [0,0],[4,0],[0,4]
    // Edges: (0,0)-(4,0): gcd(4,0)=4; (4,0)-(0,4): gcd(4,4)=4; (0,4)-(0,0): gcd(0,4)=4 => 12
    let tri = [[0, 0], [4, 0], [0, 4]]
    cki("boundary_points(tri4)", cgll_boundary_points(tri), 12)

    // KAT 8: interior_points of [0,0],[4,0],[0,4]
    // area_2x = |0*0-4*0 + 4*4-0*0 + 0*0-0*4| ... use shoelace: 0*(0-4)+4*(4-0)+0*(0-0)=0+16+0=16 -> a2=16
    // I = (16 - 12 + 2)/2 = 6/2 = 3
    cki("interior_points(tri4)", cgll_interior_points(tri), 3)

    // KAT 9: boundary_points of [0,0],[3,0],[3,3],[0,3]
    // Edges: gcd(3,0)=3, gcd(0,3)=3, gcd(3,0)=3, gcd(0,3)=3 => 12
    let sq3 = [[0, 0], [3, 0], [3, 3], [0, 3]]
    cki("boundary_points(sq3)", cgll_boundary_points(sq3), 12)

    // KAT 10: interior_points of 3x3 square
    // area=9, a2=18, B=12, I=(18-12+2)/2=8/2=4
    cki("interior_points(sq3)", cgll_interior_points(sq3), 4)

    // KAT 11: area_2x of the 2x2 square
    cki("area_2x(sq)", cgll_area_2x(sq), 8)

    // KAT 12: area_2x of the right triangle [0,0],[4,0],[0,4] (CCW) = 16
    cki("area_2x(tri4)", cgll_area_2x(tri), 16)

    // KAT 13: degenerate — 2 points
    let line = [[0, 0], [3, 0]]
    cki("interior_points(line)", cgll_interior_points(line), 0)

    // KAT 14: unit triangle [0,0],[1,0],[0,1]
    // boundary: gcd(1,0)=1, gcd(1,1)=1, gcd(0,1)=1 => B=3
    // area_2x = 1, I = (1-3+2)/2 = 0
    let unit_tri = [[0, 0], [1, 0], [0, 1]]
    cki("boundary_points(unit_tri)", cgll_boundary_points(unit_tri), 3)
    cki("interior_points(unit_tri)", cgll_interior_points(unit_tri), 0)

    print("PASS _cg_lattice_test")
