// Forge S5 LiveView: the per-connection driver (live_conn), socketless. A spawned counter connection
// emits the MOUNT frame first (statics + d:["0"]), then a PATCH frame per state-changing event. We drive
// it with two channels (events in, frames out) -- exactly what the WS runner will wire to the socket.
// Asserts mount-then-patch ordering + correct contents; a no-op event emits nothing. kill-on-timeout.
import forge_live

fn counter_view(state)
    [str(state["count"])]

fn counter_update(state, ev)
    let ns = {}
    if ev == "inc"
        ns["count"] = state["count"] + 1
    else
        ns["count"] = state["count"]
    ns

fn main()
    let q = chr(34)
    let events = channel()
    let out = channel()
    let s0 = {}
    s0["count"] = 0
    spawn live_conn(["<p>n=", "</p>"], counter_view, counter_update, s0, events, out)

    // first frame is the MOUNT (statics + initial dynamics "0")
    let mount = receive(out)
    if find(mount, q + "s" + q + ":[") < 0 or find(mount, q + "d" + q + ":[" + q + "0" + q) < 0
        print("FAIL: first frame should be the mount with d:[\"0\"] -> " + mount)
        exit(1)

    // an "inc" -> one patch frame, slot 0 -> "1"
    send(events, "inc")
    let p1 = receive(out)
    if find(p1, q + "v" + q + ":" + q + "1" + q) < 0
        print("FAIL: inc should emit a patch with v:\"1\" -> " + p1)
        exit(1)

    // a no-op emits nothing; the next inc -> "2" (if noop had emitted, this would read "1")
    send(events, "noop")
    send(events, "inc")
    let p2 = receive(out)
    if find(p2, q + "v" + q + ":" + q + "2" + q) < 0
        print("FAIL: noop must emit nothing; next inc -> v:\"2\" -> " + p2)
        exit(1)

    send(events, "__stop__")
    print("PASS forge_live_conn (driver: mount frame first, patch per change, no-op silent, state persists)")
