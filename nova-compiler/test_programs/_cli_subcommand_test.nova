import std/cli/cli_subcommand

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL _cli_subcommand_test " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL _cli_subcommand_test " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _cli_subcommand_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL _cli_subcommand_test " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL _cli_subcommand_test " + label + "[" + str(i) + "]: got='" + got[i] + "' want='" + want[i] + "'")
            exit(1)
        i = i + 1

fn main()
    // KAT spec: cls_subcommand(['build','--target','x'])='build'
    let a1 = []
    push(a1, "build")
    push(a1, "--target")
    push(a1, "x")
    cks("spec1_subcommand", cls_subcommand(a1), "build")

    // KAT spec: cls_subcommand(['-v','build'])='build'
    let a2 = []
    push(a2, "-v")
    push(a2, "build")
    cks("spec2_subcommand_after_flag", cls_subcommand(a2), "build")

    // KAT spec: cls_subcommand(['-v'])=''
    let a3 = []
    push(a3, "-v")
    cks("spec3_no_subcommand", cls_subcommand(a3), "")

    // KAT spec: cls_rest(['build','--target','x'])=['--target','x']
    let want_rest = []
    push(want_rest, "--target")
    push(want_rest, "x")
    ckl("spec4_rest", cls_rest(a1), want_rest)

    // KAT spec: cls_is(['build'],'build')=true
    let a5 = []
    push(a5, "build")
    ckb("spec5_is_build", cls_is(a5, "build"), true)

    // KAT spec: cls_is(['-v','test'],'test')=true
    let a6 = []
    push(a6, "-v")
    push(a6, "test")
    ckb("spec6_is_test", cls_is(a6, "test"), true)

    // Edge: empty argv
    let empty = []
    cks("empty_subcommand", cls_subcommand(empty), "")
    let empty_rest = cls_rest(empty)
    cki("empty_rest_len", len(empty_rest), 0)
    ckb("empty_is", cls_is(empty, "build"), false)

    // Edge: all flags, no subcommand
    let all_flags = []
    push(all_flags, "--verbose")
    push(all_flags, "--debug")
    cks("all_flags_subcommand", cls_subcommand(all_flags), "")
    let all_flags_rest = cls_rest(all_flags)
    cki("all_flags_rest_len", len(all_flags_rest), 0)

    // Edge: subcommand first, then flags
    let sub_first = []
    push(sub_first, "deploy")
    push(sub_first, "--env")
    push(sub_first, "prod")
    cks("sub_first_name", cls_subcommand(sub_first), "deploy")
    let want_sub_first_rest = []
    push(want_sub_first_rest, "--env")
    push(want_sub_first_rest, "prod")
    ckl("sub_first_rest", cls_rest(sub_first), want_sub_first_rest)
    ckb("sub_first_is_deploy", cls_is(sub_first, "deploy"), true)
    ckb("sub_first_is_build", cls_is(sub_first, "build"), false)

    // Edge: multiple non-option tokens — cls_subcommand picks the FIRST
    let multi_pos = []
    push(multi_pos, "-v")
    push(multi_pos, "run")
    push(multi_pos, "myapp")
    cks("multi_pos_subcommand", cls_subcommand(multi_pos), "run")
    let want_multi_rest = []
    push(want_multi_rest, "myapp")
    ckl("multi_pos_rest", cls_rest(multi_pos), want_multi_rest)

    print("PASS _cli_subcommand_test")
