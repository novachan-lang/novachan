import forge_request_id

fn main()
    let r = rid_new("REQ")
    let id1 = rid_generate(r)
    assert(id1 == "REQ-1", "first id")
    let id2 = rid_generate(r)
    assert(id2 == "REQ-2", "second id")

    let id3 = rid_generate_with_context(r, "login-flow")
    assert(id3 == "REQ-3", "third id")

    let ctx = rid_context(r, "REQ-3")
    assert(is_ok(ctx), "ctx ok")
    assert(unwrap(ctx) == "login-flow", "login-flow ctx")

    let bad = rid_context(r, "REQ-1")
    assert(is_err(bad), "no ctx for REQ-1")

    assert(rid_total_issued(r) == 3, "3 issued")
    assert(rid_next_sequence(r) == 4, "next=4")

    print("REQUEST-ID KAT PASS")
