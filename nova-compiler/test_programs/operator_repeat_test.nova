fn main()
    let s = "abc" * 3
    assert_eq(s, "abcabcabc")

    let s2 = "hi" * 1
    assert_eq(s2, "hi")

    let s3 = "x" * 0
    assert_eq(s3, "")

    let n = 4
    let s4 = "-" * n
    assert_eq(s4, "----")

    let xs = [1, 2, 3] * 2
    assert_eq(len(xs), 6)
    assert_eq(xs[0], 1)
    assert_eq(xs[1], 2)
    assert_eq(xs[2], 3)
    assert_eq(xs[3], 1)
    assert_eq(xs[4], 2)
    assert_eq(xs[5], 3)

    let ys = [10, 20] * 0
    assert_eq(len(ys), 0)

    let zs = [42] * 5
    assert_eq(len(zs), 5)
    assert_eq(zs[4], 42)

    let combo = "=" * 20
    assert_eq(len(combo), 20)

    print("operator_repeat_test: all passed")
