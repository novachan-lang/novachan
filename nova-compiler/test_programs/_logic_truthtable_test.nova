import std/logic/logic_truthtable

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _logic_truthtable_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL _logic_truthtable_test " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn ckl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL _logic_truthtable_test " + label + ": length got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL _logic_truthtable_test " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // === Spec KAT vectors ===
    cki("ltt_var(2,0)", ltt_var(2, 0), 10)
    cki("ltt_var(2,1)", ltt_var(2, 1), 12)
    cki("ltt_const(2,1)", ltt_const(2, 1), 15)
    cki("ltt_const(2,0)", ltt_const(2, 0), 0)
    cki("ltt_eval(10,3)", ltt_eval(10, 3), 1)
    cki("ltt_eval(10,2)", ltt_eval(10, 2), 0)
    cki("ltt_from_values([0,1,0,1])", ltt_from_values([0, 1, 0, 1]), 10)
    let vals_ref = [0, 1, 0, 1]
    ckl("ltt_to_values(10,2)", ltt_to_values(10, 2), vals_ref)
    ckb("ltt_is_tautology(15,2)", ltt_is_tautology(15, 2), true)
    ckb("ltt_is_contradiction(0,2)", ltt_is_contradiction(0, 2), true)
    ckb("ltt_is_satisfiable(10,2)", ltt_is_satisfiable(10, 2), true)
    cki("ltt_count_true(10,2)", ltt_count_true(10, 2), 2)
    cki("ltt_count_true(14,2)", ltt_count_true(14, 2), 3)

    // === Additional edge cases ===
    // n=1: only 2 assignments
    cki("ltt_var(1,0)", ltt_var(1, 0), 2)
    cki("ltt_const(1,1)", ltt_const(1, 1), 3)
    cki("ltt_const(1,0)", ltt_const(1, 0), 0)
    ckb("ltt_is_tautology(3,1)", ltt_is_tautology(3, 1), true)
    ckb("ltt_is_contradiction(0,1)", ltt_is_contradiction(0, 1), true)
    ckb("ltt_is_satisfiable(0,1)", ltt_is_satisfiable(0, 1), false)
    cki("ltt_count_true(3,1)", ltt_count_true(3, 1), 2)
    cki("ltt_count_true(0,1)", ltt_count_true(0, 1), 0)

    // n=3: 8 assignments; ltt_var(3,0) = 10101010=170, ltt_var(3,1)=11001100=204, ltt_var(3,2)=11110000=240
    cki("ltt_var(3,0)", ltt_var(3, 0), 170)
    cki("ltt_var(3,1)", ltt_var(3, 1), 204)
    cki("ltt_var(3,2)", ltt_var(3, 2), 240)
    cki("ltt_const(3,1)", ltt_const(3, 1), 255)
    ckb("ltt_is_tautology(255,3)", ltt_is_tautology(255, 3), true)
    ckb("ltt_is_contradiction(0,3)", ltt_is_contradiction(0, 3), true)
    cki("ltt_count_true(255,3)", ltt_count_true(255, 3), 8)
    cki("ltt_count_true(170,3)", ltt_count_true(170, 3), 4)

    // === ENUMERATION CROSS-CHECK: ltt_var correctness by definition ===
    // For n=2, k=0: x0 true iff bit 0 of assignment is 1 => assignments 1,3 => T must have bits 1,3 set
    let x0 = ltt_var(2, 0)
    let i = 0
    while i < 4
        let bit_k = (i >> 0) & 1
        let bit_T = (x0 >> i) & 1
        if bit_T != bit_k
            print("FAIL _logic_truthtable_test enum_var2_0[" + str(i) + "]: got=" + str(bit_T) + " want=" + str(bit_k))
            exit(1)
        i = i + 1

    // For n=2, k=1: x1 true iff bit 1 of assignment is 1 => assignments 2,3 => T has bits 2,3 set
    let x1 = ltt_var(2, 1)
    i = 0
    while i < 4
        let bit_k = (i >> 1) & 1
        let bit_T = (x1 >> i) & 1
        if bit_T != bit_k
            print("FAIL _logic_truthtable_test enum_var2_1[" + str(i) + "]: got=" + str(bit_T) + " want=" + str(bit_k))
            exit(1)
        i = i + 1

    // Enumerate n=3: all 3 variables, all 8 assignments
    let n3 = 3
    let size3 = 8
    let k3 = 0
    while k3 < n3
        let Tk = ltt_var(n3, k3)
        let j = 0
        while j < size3
            let expected = (j >> k3) & 1
            let actual = (Tk >> j) & 1
            if actual != expected
                print("FAIL _logic_truthtable_test enum_var3_k" + str(k3) + "[" + str(j) + "]")
                exit(1)
            j = j + 1
        k3 = k3 + 1

    // === ROUND-TRIP: from_values(to_values(T,n)) == T for all T in 0..15 (n=2) ===
    let T = 0
    while T < 16
        let got = ltt_from_values(ltt_to_values(T, 2))
        if got != T
            print("FAIL _logic_truthtable_test rt_fv_tv[" + str(T) + "]: got=" + str(got))
            exit(1)
        T = T + 1

    // === ROUND-TRIP: to_values(from_values(vals),2) == vals for all 16 val-lists ===
    let tv = 0
    while tv < 16
        let v0 = (tv >> 0) & 1
        let v1 = (tv >> 1) & 1
        let v2 = (tv >> 2) & 1
        let v3 = (tv >> 3) & 1
        let vlist = [v0, v1, v2, v3]
        let Tbuilt = ltt_from_values(vlist)
        let back = ltt_to_values(Tbuilt, 2)
        let q = 0
        while q < 4
            if back[q] != vlist[q]
                print("FAIL _logic_truthtable_test rt_tv_fv tv=" + str(tv) + " q=" + str(q))
                exit(1)
            q = q + 1
        tv = tv + 1

    // === ENUMERATION: ltt_count_true correctness for all T in 0..15 (n=2) ===
    let Tc = 0
    while Tc < 16
        let cnt = ltt_count_true(Tc, 2)
        // Brute force
        let expected_cnt = 0
        let bi = 0
        while bi < 4
            expected_cnt = expected_cnt + ((Tc >> bi) & 1)
            bi = bi + 1
        if cnt != expected_cnt
            print("FAIL _logic_truthtable_test count_true[" + str(Tc) + "]: got=" + str(cnt) + " want=" + str(expected_cnt))
            exit(1)
        Tc = Tc + 1

    // === is_tautology / is_contradiction / is_satisfiable for all n=2 T ===
    let Ts = 0
    while Ts < 16
        let is_taut = ltt_is_tautology(Ts, 2)
        let is_contra = ltt_is_contradiction(Ts, 2)
        let is_sat = ltt_is_satisfiable(Ts, 2)
        // tautology iff T==15
        let want_taut = Ts == 15
        if is_taut != want_taut
            print("FAIL _logic_truthtable_test tautology[" + str(Ts) + "]")
            exit(1)
        // contradiction iff T==0
        let want_contra = Ts == 0
        if is_contra != want_contra
            print("FAIL _logic_truthtable_test contradiction[" + str(Ts) + "]")
            exit(1)
        // satisfiable iff T!=0
        let want_sat = Ts != 0
        if is_sat != want_sat
            print("FAIL _logic_truthtable_test satisfiable[" + str(Ts) + "]")
            exit(1)
        Ts = Ts + 1

    print("PASS _logic_truthtable_test")
