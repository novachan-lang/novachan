import std/relation/relation_equiv

// cki — integer known-answer check.
fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb — boolean known-answer check (1=true, 0=false).
fn ckb(label, got, want)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

// ckl — integer-list known-answer check.
fn ckl(label, got, want)
    if len(got) != len(want)
        print("FAIL " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL " + label + ": idx=" + str(i) + " got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

// ckm — matrix known-answer check.
fn ckm(label, A, B)
    let n = len(A)
    if len(B) != n
        print("FAIL " + label + ": row count got=" + str(n) + " want=" + str(len(B)))
        exit(1)
    let i = 0
    while i < n
        let j = 0
        while j < len(A[i])
            if A[i][j] != B[i][j]
                print("FAIL " + label + ": [" + str(i) + "][" + str(j) + "] got=" + str(A[i][j]) + " want=" + str(B[i][j]))
                exit(1)
            j = j + 1
        i = i + 1

fn main()
    // ── KAT 1: M = {(0,0),(1,1),(2,2),(0,1),(1,0)} on n=3 ─────────────────────
    // is_equivalence = true; classes = [[0,1],[2]]
    let M1 = []
    let r1a = []
    r1a.push(1)
    r1a.push(1)
    r1a.push(0)
    M1.push(r1a)
    let r1b = []
    r1b.push(1)
    r1b.push(1)
    r1b.push(0)
    M1.push(r1b)
    let r1c = []
    r1c.push(0)
    r1c.push(0)
    r1c.push(1)
    M1.push(r1c)
    cki("m1_is_equiv", req_is_equivalence(M1, 3), 1)
    let cls1 = req_classes(M1, 3)
    cki("m1_classes_count", len(cls1), 2)
    ckl("m1_class0", cls1[0], [0, 1])
    ckl("m1_class1", cls1[1], [2])

    // ── KAT 2: identity(3) classes == [[0],[1],[2]] ─────────────────────────────
    let I3 = []
    let ia = []
    ia.push(1)
    ia.push(0)
    ia.push(0)
    I3.push(ia)
    let ib = []
    ib.push(0)
    ib.push(1)
    ib.push(0)
    I3.push(ib)
    let ic = []
    ic.push(0)
    ic.push(0)
    ic.push(1)
    I3.push(ic)
    cki("id3_is_equiv", req_is_equivalence(I3, 3), 1)
    let clsI = req_classes(I3, 3)
    cki("id3_classes_count", len(clsI), 3)
    ckl("id3_class0", clsI[0], [0])
    ckl("id3_class1", clsI[1], [1])
    ckl("id3_class2", clsI[2], [2])

    // ── KAT 3: universal(3) classes == [[0,1,2]] ───────────────────────────────
    let U3 = []
    let ua = []
    ua.push(1)
    ua.push(1)
    ua.push(1)
    U3.push(ua)
    let ub = []
    ub.push(1)
    ub.push(1)
    ub.push(1)
    U3.push(ub)
    let uc = []
    uc.push(1)
    uc.push(1)
    uc.push(1)
    U3.push(uc)
    cki("univ3_is_equiv", req_is_equivalence(U3, 3), 1)
    let clsU = req_classes(U3, 3)
    cki("univ3_classes_count", len(clsU), 1)
    ckl("univ3_class0", clsU[0], [0, 1, 2])

    // ── KAT 4: {(0,1)} alone is NOT an equivalence relation ────────────────────
    let M4 = []
    let r4a = []
    r4a.push(0)
    r4a.push(1)
    r4a.push(0)
    M4.push(r4a)
    let r4b = []
    r4b.push(0)
    r4b.push(0)
    r4b.push(0)
    M4.push(r4b)
    let r4c = []
    r4c.push(0)
    r4c.push(0)
    r4c.push(0)
    M4.push(r4c)
    cki("single_pair_not_equiv", req_is_equivalence(M4, 3), 0)

    // ── KAT 5: round-trip req_relation_from_partition -> req_classes ────────────
    // partition [[0,1],[2]] on n=3
    let parts5 = []
    let p5a = []
    p5a.push(0)
    p5a.push(1)
    parts5.push(p5a)
    let p5b = []
    p5b.push(2)
    parts5.push(p5b)
    let M5 = req_relation_from_partition(parts5, 3)
    cki("rfp_is_equiv", req_is_equivalence(M5, 3), 1)
    let cls5 = req_classes(M5, 3)
    cki("rfp_round_trip_count", len(cls5), 2)
    ckl("rfp_round_trip_0", cls5[0], [0, 1])
    ckl("rfp_round_trip_1", cls5[1], [2])

    // ── KAT 6: req_are_equivalent ──────────────────────────────────────────────
    cki("are_equiv_01_true", req_are_equivalent(M1, 0, 1), 1)
    cki("are_equiv_02_false", req_are_equivalent(M1, 0, 2), 0)
    cki("are_equiv_12_false", req_are_equivalent(M1, 1, 2), 0)
    cki("are_equiv_00_true", req_are_equivalent(M1, 0, 0), 1)

    // ── KAT 7: partition with 3 classes on n=4 ─────────────────────────────────
    // parts = [[0,3],[1],[2]] on n=4
    let parts7 = []
    let p7a = []
    p7a.push(0)
    p7a.push(3)
    parts7.push(p7a)
    let p7b = []
    p7b.push(1)
    parts7.push(p7b)
    let p7c = []
    p7c.push(2)
    parts7.push(p7c)
    let M7 = req_relation_from_partition(parts7, 4)
    cki("rfp4_is_equiv", req_is_equivalence(M7, 4), 1)
    let cls7 = req_classes(M7, 4)
    cki("rfp4_count", len(cls7), 3)
    ckl("rfp4_class0", cls7[0], [0, 3])
    ckl("rfp4_class1", cls7[1], [1])
    ckl("rfp4_class2", cls7[2], [2])
    // 0 and 3 are equivalent; 1 and 2 are not
    cki("rfp4_03_equiv", req_are_equivalent(M7, 0, 3), 1)
    cki("rfp4_01_not", req_are_equivalent(M7, 0, 1), 0)
    cki("rfp4_12_not", req_are_equivalent(M7, 1, 2), 0)

    // ── KAT 8: n=0 edge case ───────────────────────────────────────────────────
    let M0 = []
    cki("n0_is_equiv", req_is_equivalence(M0, 0), 1)
    let cls0 = req_classes(M0, 0)
    cki("n0_classes_count", len(cls0), 0)

    // ── KAT 9: n=1 single element ──────────────────────────────────────────────
    let M9 = []
    let r9a = []
    r9a.push(1)
    M9.push(r9a)
    cki("n1_is_equiv", req_is_equivalence(M9, 1), 1)
    let cls9 = req_classes(M9, 1)
    cki("n1_classes_count", len(cls9), 1)
    ckl("n1_class0", cls9[0], [0])

    // ── KAT 10: partition_from_relation = req_classes (alias check) ─────────────
    let cls1b = req_partition_from_relation(M1, 3)
    cki("pfr_count", len(cls1b), 2)
    ckl("pfr_class0", cls1b[0], [0, 1])
    ckl("pfr_class1", cls1b[1], [2])

    // ── KAT 11: req_relation_from_partition on identity partition ───────────────
    let partsId = []
    let pid0 = []
    pid0.push(0)
    partsId.push(pid0)
    let pid1 = []
    pid1.push(1)
    partsId.push(pid1)
    let pid2 = []
    pid2.push(2)
    partsId.push(pid2)
    let MId = req_relation_from_partition(partsId, 3)
    ckm("rfp_identity", MId, I3)

    print("PASS _relation_equiv_test")

main()
