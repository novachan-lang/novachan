// NOVA REPL — interactive shell.
// Maintains a session of accumulated definitions (let/fn/type) and evaluates
// each new line by writing the session + line to a temp file, compiling, and
// running. Slower than a true JIT but uses the same compiler as production.

fn print_prompt(s: string)
    stdout_write(s)

fn read_input_line() -> string
    let line = ""
    let done = 0
    let eof = 0
    while done == 0
        let c = stdin_read_n(1)
        if len(c) == 0
            done = 1
            eof = 1
        else if c == "\n"
            done = 1
        else if c == "\r"
            line = line
        else
            line = line + c
    if eof == 1 and len(line) == 0
        return ":quit"
    return line

// Heuristic: does this line start with a definition (let/fn/type/enum/trait/import)?
// Definitions accumulate into the session; everything else is treated as an
// expression to print.
fn is_definition_line(trimmed: string) -> int
    if starts_with(trimmed, "let ")
        return 1
    if starts_with(trimmed, "fn ")
        return 1
    if starts_with(trimmed, "fn<")
        return 1
    if starts_with(trimmed, "type ")
        return 1
    if starts_with(trimmed, "enum ")
        return 1
    if starts_with(trimmed, "trait ")
        return 1
    if starts_with(trimmed, "import ")
        return 1
    if starts_with(trimmed, "extern ")
        return 1
    return 0

// Does this opener expect a multi-line indented body?
fn expects_multiline_body(trimmed: string) -> int
    if starts_with(trimmed, "fn ")
        return 1
    if starts_with(trimmed, "fn<")
        return 1
    if starts_with(trimmed, "type ")
        return 1
    if starts_with(trimmed, "enum ")
        return 1
    if starts_with(trimmed, "trait ")
        return 1
    if starts_with(trimmed, "extern fn ")
        return 0
    return 0

// Read continuation lines until a blank line. Strips trailing whitespace per line.
fn read_continuation() -> string
    let body = ""
    let done = 0
    while done == 0
        print_prompt(".. ")
        let cont = read_input_line()
        let t = trim(cont)
        if len(t) == 0
            done = 1
        else
            body = body + "\n" + cont
    body

// Build the temp source. Top-level `fn`/`type`/`enum` go above main;
// everything else (let, expression) goes inside main so locals propagate.
// Extract the bound name from a `let NAME = ...` or `let NAME: type = ...` line.
// The line must be trimmed and start with "let ". Returns "" if malformed.
fn extract_let_name(line: string) -> string
    if not starts_with(line, "let ")
        return ""
    let after = trim(slice(line, 4, len(line)))
    let eq = find(after, "=")
    let head = after
    if eq >= 0
        head = slice(after, 0, eq)
    let colon = find(head, ":")
    if colon >= 0
        head = slice(head, 0, colon)
    return trim(head)

fn build_temp_source(session: list, new_line: string, is_expr: int) -> string
    let top_decls = ""
    let main_body = ""
    let names = []
    for s in session
        let st = trim(s)
        if starts_with(st, "fn ") or starts_with(st, "fn<") or starts_with(st, "type ") or starts_with(st, "enum ") or starts_with(st, "trait ") or starts_with(st, "import ") or starts_with(st, "extern ")
            top_decls = top_decls + s + "\n"
        else
            main_body = main_body + "    " + s + "\n"
            let nm = extract_let_name(st)
            if len(nm) > 0
                push(names, nm)
    let new_st = trim(new_line)
    let new_is_topdecl = 0
    if is_expr == 0
        if starts_with(new_st, "fn ") or starts_with(new_st, "fn<") or starts_with(new_st, "type ") or starts_with(new_st, "enum ") or starts_with(new_st, "trait ") or starts_with(new_st, "import ") or starts_with(new_st, "extern ")
            new_is_topdecl = 1
    let echo_name = ""
    if new_is_topdecl == 1
        top_decls = top_decls + new_line + "\n"
    else
        if is_expr == 0
            main_body = main_body + "    " + new_line + "\n"
            echo_name = extract_let_name(new_st)
    // Silence the unused-variable lint (E1000) for every REPLAYED session binding:
    // `_ = NAME` counts as reading NAME, and `_` itself is exempt from the lint. Without
    // this, a session `let x = 5` that no later line references trips E1000 -> the line
    // never compiles "OK" -> it is never re-added to the session -> the REPL loses state.
    for nm in names
        main_body = main_body + "    _ = " + nm + "\n"
    // Final visible statement: echo an expression's value, or echo the new binding.
    if is_expr == 1
        main_body = main_body + "    print(" + new_line + ")\n"
    else
        if len(echo_name) > 0
            main_body = main_body + "    print(" + echo_name + ")\n"
    let out = top_decls + "fn main()\n"
    if len(main_body) == 0
        out = out + "    0\n"
    else
        out = out + main_body + "    0\n"
    out

// Resolve nova_runtime.c robustly. The runtime moved to compiler/ (was output/), so a hardcoded
// path silently broke the REPL link. NOVA_RUNTIME overrides; otherwise the first existing candidate.
fn resolve_runtime() -> string
    let rt_env = env("NOVA_RUNTIME")
    if len(rt_env) > 0
        return rt_env
    let cands = ["../compiler/nova_runtime.c", "compiler/nova_runtime.c", "output/nova_runtime.c", "nova_runtime.c"]
    for c in cands
        if file_exists(c)
            return c
    return "../compiler/nova_runtime.c"

fn run_session(source: string) -> string
    write_file("repl_session.nova", source)
    // Compile each REPL line with the live bootstrap compiler. gen2_move.exe is the
    // banned legacy binary (absent + truncates if-else chains); gen3_test.exe is the
    // current self-hosted compiler. Using the wrong/absent binary silently failed every line.
    let compile_out = exec(".\\gen3_test.exe repl_session.nova")
    if find(compile_out, "error[") >= 0 or find(compile_out, "compilation failed") >= 0
        return "COMPILE_ERROR\n" + compile_out
    if not file_exists("repl_session.ll")
        return "COMPILE_ERROR\nno .ll produced"
    // Full link flags: the runtime needs bcrypt + advapi32 (crypto/RNG) alongside ws2_32
    // (sockets); -lws2_32 alone left unresolved symbols -> no exe -> a silent LINK_ERROR.
    // -w + _CRT_SECURE_NO_WARNINGS silence the (non-fatal) MSVC deprecation noise.
    let rt = resolve_runtime()
    let link_out = exec("clang -O0 -o repl_session.exe repl_session.ll {rt} -lws2_32 -lbcrypt -ladvapi32 -D_CRT_SECURE_NO_WARNINGS -w 2>&1")
    if not file_exists("repl_session.exe")
        return "LINK_ERROR\n" + link_out
    let run_out = exec(".\\repl_session.exe")
    return "OK\n" + run_out

fn main()
    print("NOVA REPL v0.1 — type ':quit' to exit, ':reset' to clear session")
    print("")
    let session = []
    let running = 1
    while running == 1
        print_prompt(">> ")
        let raw = read_input_line()
        let line = trim(raw)
        if line == ":quit" or line == ":q"
            running = 0
        else if line == ":reset"
            session = []
            print("(session cleared)")
        else if line == ":session"
            print("--- session ---")
            for s in session
                print(s)
            print("--- end ---")
        else if len(line) == 0
            running = running
        else
            let full_line = raw
            if expects_multiline_body(line) == 1
                let body = read_continuation()
                full_line = raw + body
            let is_def = is_definition_line(line)
            let source = build_temp_source(session, full_line, 1 - is_def)
            let result = run_session(source)
            if starts_with(result, "OK\n")
                let out = slice(result, 3, len(result))
                stdout_write(out)
                if is_def == 1
                    push(session, full_line)
            else
                stdout_write(result + "\n")
    print("Bye!")
