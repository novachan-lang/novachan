import std/net/url

// Helper: check string equality; print FAIL and exit on mismatch.
fn cks(label: string, got: string, expected: string)
    if got != expected
        print("FAIL " + label + ": got [" + got + "] expected [" + expected + "]")
        exit(1)

// ── KAT 1: Full URL with all components ──────────────────────────────────────
// Hand-computed:
//   scheme   = "https"
//   host     = "example.com"
//   port     = "8080"
//   path     = "/a/b"
//   query    = "x=1&y=2"
//   fragment = "top"
let full = "https://example.com:8080/a/b?x=1&y=2#top"
let p1 = url_parse(full)
cks("full.scheme",   p1["scheme"],   "https")
cks("full.host",     p1["host"],     "example.com")
cks("full.port",     p1["port"],     "8080")
cks("full.path",     p1["path"],     "/a/b")
cks("full.query",    p1["query"],    "x=1&y=2")
cks("full.fragment", p1["fragment"], "top")

// ── KAT 2: Minimal URL — no port, no query, no fragment ──────────────────────
// Hand-computed:
//   scheme = "http", host = "h", port = "", path = "/p", query = "", fragment = ""
let p2 = url_parse("http://h/p")
cks("minimal.scheme",   p2["scheme"],   "http")
cks("minimal.host",     p2["host"],     "h")
cks("minimal.port",     p2["port"],     "")
cks("minimal.path",     p2["path"],     "/p")
cks("minimal.query",    p2["query"],    "")
cks("minimal.fragment", p2["fragment"], "")

// ── KAT 3: FTP URL — no path at all ──────────────────────────────────────────
// Hand-computed:
//   scheme = "ftp", host = "f", port = "", path = "", query = "", fragment = ""
let p3 = url_parse("ftp://f")
cks("ftp.scheme", p3["scheme"], "ftp")
cks("ftp.host",   p3["host"],   "f")
cks("ftp.port",   p3["port"],   "")
cks("ftp.path",   p3["path"],   "")

// ── KAT 4: Round-trip url_build(url_parse(u)) == u ────────────────────────────
let rebuilt = url_build(p1)
cks("roundtrip", rebuilt, full)

// ── KAT 5: Convenience helpers ───────────────────────────────────────────────
// url_host("https://example.com:8080/path") -> "example.com"
let h = url_host("https://example.com:8080/path")
cks("url_host", h, "example.com")

// url_path("https://example.com/a/b?q=1") -> "/a/b"
let pt = url_path("https://example.com/a/b?q=1")
cks("url_path", pt, "/a/b")

// ── KAT 6: URL with query but no fragment ────────────────────────────────────
// Hand-computed for "http://api.example.com/v1/search?q=hello+world&limit=10":
//   scheme = "http", host = "api.example.com", port = ""
//   path = "/v1/search", query = "q=hello+world&limit=10", fragment = ""
let p4 = url_parse("http://api.example.com/v1/search?q=hello+world&limit=10")
cks("api.scheme", p4["scheme"], "http")
cks("api.host",   p4["host"],   "api.example.com")
cks("api.port",   p4["port"],   "")
cks("api.path",   p4["path"],   "/v1/search")
cks("api.query",  p4["query"],  "q=hello+world&limit=10")
cks("api.fragment", p4["fragment"], "")

// ── KAT 7: url_build from scratch (no url_parse) ─────────────────────────────
// Build "https://nova-lang.org/docs#install" from parts:
let parts = {}
parts["scheme"] = "https"
parts["host"] = "nova-lang.org"
parts["port"] = ""
parts["path"] = "/docs"
parts["query"] = ""
parts["fragment"] = "install"
let built = url_build(parts)
cks("build_from_parts", built, "https://nova-lang.org/docs#install")

print("_url_test passed")
