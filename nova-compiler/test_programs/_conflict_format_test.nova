// KAT for std/text/conflict_format
// Tests: conflict_wrap structure, conflict_has, conflict_take_mine,
//        conflict_take_theirs, conflict_parse round-trip, no-conflict passthrough.
import std/text/conflict_format

// ── helpers ──────────────────────────────────────────────────────────────────

fn list_eq(a, b)
    if len(a) != len(b)
        return 0
    let i = 0
    while i < len(a)
        if a[i] != b[i]
            return 0
        i = i + 1
    return 1

fn list_str(xs)
    let s = "["
    let i = 0
    while i < len(xs)
        if i > 0
            s = s + ","
        s = s + xs[i]
        i = i + 1
    s = s + "]"
    s

fn main()
    // ── Build the canonical test block ──────────────────────────────────────
    let mine1 = []
    mine1.push("X")
    let theirs1 = []
    theirs1.push("Y")
    let wrapped = conflict_wrap(mine1, theirs1, "ours", "theirs")

    // ── KAT 1: first line is "<<<<<<< ours" ─────────────────────────────────
    let want_open = "<<<<<<< ours"
    let got_open = wrapped[0]
    if got_open != want_open
        print("FAIL conflict_format open: got=" + got_open + " want=" + want_open)
        exit(1)

    // ── KAT 2: wrapped has exactly 5 lines ──────────────────────────────────
    let want_len = 5
    let got_len = len(wrapped)
    if got_len != want_len
        print("FAIL conflict_format len: got=" + str(got_len) + " want=" + str(want_len))
        exit(1)

    // ── KAT 3: separator is "=======" ───────────────────────────────────────
    let want_sep = "======="
    let got_sep = wrapped[2]
    if got_sep != want_sep
        print("FAIL conflict_format sep: got=" + got_sep + " want=" + want_sep)
        exit(1)

    // ── KAT 4: last line is ">>>>>>> theirs" ────────────────────────────────
    let want_close = ">>>>>>> theirs"
    let got_close = wrapped[4]
    if got_close != want_close
        print("FAIL conflict_format close: got=" + got_close + " want=" + want_close)
        exit(1)

    // ── KAT 5: conflict_has(wrapped) == true ────────────────────────────────
    let got_has = conflict_has(wrapped)
    if got_has != 1
        print("FAIL conflict_format has: got=" + str(got_has) + " want=1")
        exit(1)

    // ── KAT 6: conflict_take_mine returns ["X"] ─────────────────────────────
    let got_mine = conflict_take_mine(wrapped)
    let want_mine = []
    want_mine.push("X")
    if list_eq(got_mine, want_mine) == 0
        print("FAIL conflict_format take_mine: got=" + list_str(got_mine) + " want=" + list_str(want_mine))
        exit(1)

    // ── KAT 7: conflict_take_theirs returns ["Y"] ───────────────────────────
    let got_theirs = conflict_take_theirs(wrapped)
    let want_theirs = []
    want_theirs.push("Y")
    if list_eq(got_theirs, want_theirs) == 0
        print("FAIL conflict_format take_theirs: got=" + list_str(got_theirs) + " want=" + list_str(want_theirs))
        exit(1)

    // ── KAT 8: conflict_has(["plain"]) == false ─────────────────────────────
    let plain = []
    plain.push("plain")
    let got_no_has = conflict_has(plain)
    if got_no_has != 0
        print("FAIL conflict_format no_has: got=" + str(got_no_has) + " want=0")
        exit(1)

    // ── KAT 9: conflict_parse round-trip mine=["X"] theirs=["Y"] ────────────
    let parsed = conflict_parse(wrapped)
    let got_parse_len = len(parsed)
    if got_parse_len != 1
        print("FAIL conflict_format parse len: got=" + str(got_parse_len) + " want=1")
        exit(1)
    let reg = parsed[0]
    let parsed_mine = reg["mine"]
    let parsed_theirs = reg["theirs"]
    if list_eq(parsed_mine, mine1) == 0
        print("FAIL conflict_format parse mine: got=" + list_str(parsed_mine) + " want=" + list_str(mine1))
        exit(1)
    if list_eq(parsed_theirs, theirs1) == 0
        print("FAIL conflict_format parse theirs: got=" + list_str(parsed_theirs) + " want=" + list_str(theirs1))
        exit(1)

    // ── KAT 10: empty mine/theirs ────────────────────────────────────────────
    let empty_mine = []
    let empty_theirs = []
    let empty_wrapped = conflict_wrap(empty_mine, empty_theirs, "a", "b")
    let got_em_len = len(empty_wrapped)
    if got_em_len != 3
        print("FAIL conflict_format empty wrap len: got=" + str(got_em_len) + " want=3")
        exit(1)
    let got_em_mine = conflict_take_mine(empty_wrapped)
    if len(got_em_mine) != 0
        print("FAIL conflict_format empty take_mine: got=" + str(len(got_em_mine)) + " want=0")
        exit(1)
    let got_em_theirs = conflict_take_theirs(empty_wrapped)
    if len(got_em_theirs) != 0
        print("FAIL conflict_format empty take_theirs: got=" + str(len(got_em_theirs)) + " want=0")
        exit(1)

    // ── KAT 11: non-conflict lines pass through take_mine / take_theirs ─────
    let mixed = []
    mixed.push("before")
    mixed.push("<<<<<<< A")
    mixed.push("mine-line")
    mixed.push("=======")
    mixed.push("their-line")
    mixed.push(">>>>>>> B")
    mixed.push("after")
    let got_mixed_mine = conflict_take_mine(mixed)
    let want_mixed_mine = []
    want_mixed_mine.push("before")
    want_mixed_mine.push("mine-line")
    want_mixed_mine.push("after")
    if list_eq(got_mixed_mine, want_mixed_mine) == 0
        print("FAIL conflict_format mixed take_mine: got=" + list_str(got_mixed_mine) + " want=" + list_str(want_mixed_mine))
        exit(1)
    let got_mixed_theirs = conflict_take_theirs(mixed)
    let want_mixed_theirs = []
    want_mixed_theirs.push("before")
    want_mixed_theirs.push("their-line")
    want_mixed_theirs.push("after")
    if list_eq(got_mixed_theirs, want_mixed_theirs) == 0
        print("FAIL conflict_format mixed take_theirs: got=" + list_str(got_mixed_theirs) + " want=" + list_str(want_mixed_theirs))
        exit(1)

    // ── KAT 12: multiple regions in conflict_parse ───────────────────────────
    let multi = []
    multi.push("<<<<<<< X")
    multi.push("m1")
    multi.push("=======")
    multi.push("t1")
    multi.push(">>>>>>> Y")
    multi.push("gap")
    multi.push("<<<<<<< X")
    multi.push("m2")
    multi.push("=======")
    multi.push("t2")
    multi.push(">>>>>>> Y")
    let multi_parsed = conflict_parse(multi)
    let got_multi_len = len(multi_parsed)
    if got_multi_len != 2
        print("FAIL conflict_format multi parse len: got=" + str(got_multi_len) + " want=2")
        exit(1)
    let reg0 = multi_parsed[0]
    let reg1 = multi_parsed[1]
    let m1_list = reg0["mine"]
    let t1_list = reg0["theirs"]
    let m2_list = reg1["mine"]
    let t2_list = reg1["theirs"]
    if m1_list[0] != "m1"
        print("FAIL conflict_format multi reg0 mine: got=" + m1_list[0])
        exit(1)
    if t1_list[0] != "t1"
        print("FAIL conflict_format multi reg0 theirs: got=" + t1_list[0])
        exit(1)
    if m2_list[0] != "m2"
        print("FAIL conflict_format multi reg1 mine: got=" + m2_list[0])
        exit(1)
    if t2_list[0] != "t2"
        print("FAIL conflict_format multi reg1 theirs: got=" + t2_list[0])
        exit(1)

    print("PASS _conflict_format_test")
