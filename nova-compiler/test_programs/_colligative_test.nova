// KAT for std/chem/colligative — colligative property formulas.
import std/chem/colligative

// approx — float equality within tolerance.
fn approx(a, b, tol)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < tol

fn ckf(label, got, want, tol)
    if not approx(got, want, tol)
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // boiling_point_elevation: dTb = Kb * m * i
    // water Kb=0.512, m=1.0, i=1 (sugar) -> 0.512
    ckf("boiling_point_elevation(0.512,1.0,1.0)", boiling_point_elevation(0.512, 1.0, 1.0), 0.512, 0.001)
    // NaCl i=2
    ckf("boiling_point_elevation(0.512,1.0,2.0)", boiling_point_elevation(0.512, 1.0, 2.0), 1.024, 0.001)
    // zero molality
    ckf("boiling_point_elevation(0.512,0.0,1.0)", boiling_point_elevation(0.512, 0.0, 1.0), 0.0, 0.001)

    // freezing_point_depression: dTf = Kf * m * i
    // water Kf=1.86, m=1.0, i=2 (NaCl) -> 3.72
    ckf("freezing_point_depression(1.86,1.0,2.0)", freezing_point_depression(1.86, 1.0, 2.0), 3.72, 0.001)
    // i=1 (glucose)
    ckf("freezing_point_depression(1.86,1.0,1.0)", freezing_point_depression(1.86, 1.0, 1.0), 1.86, 0.001)
    // double molality
    ckf("freezing_point_depression(1.86,2.0,1.0)", freezing_point_depression(1.86, 2.0, 1.0), 3.72, 0.001)

    // osmotic_pressure: pi = M * 0.0821 * T
    // m=1.0, T=273 -> 1.0 * 0.0821 * 273 = 22.4133
    ckf("osmotic_pressure(1.0,273.0)", osmotic_pressure(1.0, 273.0), 22.41, 0.1)
    // m=0 -> 0
    ckf("osmotic_pressure(0.0,273.0)", osmotic_pressure(0.0, 273.0), 0.0, 0.001)

    // new_boiling_point: bp + elevation
    ckf("new_boiling_point(100.0,0.512)", new_boiling_point(100.0, 0.512), 100.512, 0.001)
    ckf("new_boiling_point(100.0,0.0)", new_boiling_point(100.0, 0.0), 100.0, 0.001)

    print("PASS _colligative_test")
