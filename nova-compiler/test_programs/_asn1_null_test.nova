// _asn1_null_test — KAT for std/data/asn1_null
//
// Verifies byte-exact DER encoding per X.690:
//   KAT 1: asn1_null_encode() == [0x05, 0x00]
//   KAT 2: asn1_null_decode([0x05,0x00], 0) == 2
//   KAT 3: asn1_null_decode([0x02,0x01,0x00], 0) == -1 (wrong tag)
//   KAT 4: asn1_null_decode(empty, 0) == -1 (truncated)
//   KAT 5: asn1_tlv(0x04, [0x01,0x02,0x03]) == [0x04,0x03,0x01,0x02,0x03]
//   KAT 6: asn1_tlv(0x04, 200-byte value) starts with [0x04,0x81,0xC8]
//   KAT 7: round-trip encode->decode returns pos+2
//   KAT 8: asn1_null_decode rejects non-zero length byte

import std/data/asn1_null

fn ckb(label, got, want)
    if got != want
        print("FAIL asn1_null " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // ── KAT 1: asn1_null_encode() == [0x05, 0x00] ───────────────────────────
    let enc = asn1_null_encode()
    ckb("encode len",    bytes_len(enc), 2)
    ckb("encode byte0",  bytes_get(enc, 0), 5)
    ckb("encode byte1",  bytes_get(enc, 1), 0)
    print("KAT 1 passed: asn1_null_encode == [0x05,0x00]")

    // ── KAT 2: asn1_null_decode([0x05,0x00], 0) == 2 ────────────────────────
    let buf2 = bytes(2)
    bytes_set(buf2, 0, 5)
    bytes_set(buf2, 1, 0)
    let pos2 = asn1_null_decode(buf2, 0)
    ckb("decode valid pos", pos2, 2)
    print("KAT 2 passed: asn1_null_decode([0x05,0x00],0) == 2")

    // ── KAT 3: asn1_null_decode([0x02,0x01,0x00], 0) == -1 (wrong tag) ─────
    let buf3 = bytes(3)
    bytes_set(buf3, 0, 2)
    bytes_set(buf3, 1, 1)
    bytes_set(buf3, 2, 0)
    let pos3 = asn1_null_decode(buf3, 0)
    ckb("decode wrong tag", pos3, -1)
    print("KAT 3 passed: asn1_null_decode wrong tag == -1")

    // ── KAT 4: asn1_null_decode(empty, 0) == -1 (truncated) ─────────────────
    let buf4 = bytes(0)
    let pos4 = asn1_null_decode(buf4, 0)
    ckb("decode empty buf", pos4, -1)
    print("KAT 4 passed: asn1_null_decode empty buffer == -1")

    // ── KAT 5: asn1_tlv(0x04, [0x01,0x02,0x03]) == [0x04,0x03,0x01,0x02,0x03]
    let content5 = bytes(3)
    bytes_set(content5, 0, 1)
    bytes_set(content5, 1, 2)
    bytes_set(content5, 2, 3)
    let tlv5 = asn1_tlv(4, content5)
    ckb("tlv5 total len",  bytes_len(tlv5), 5)
    ckb("tlv5 tag",        bytes_get(tlv5, 0), 4)
    ckb("tlv5 len byte",   bytes_get(tlv5, 1), 3)
    ckb("tlv5 val[0]",     bytes_get(tlv5, 2), 1)
    ckb("tlv5 val[1]",     bytes_get(tlv5, 3), 2)
    ckb("tlv5 val[2]",     bytes_get(tlv5, 4), 3)
    print("KAT 5 passed: asn1_tlv(0x04,[1,2,3]) == [0x04,0x03,0x01,0x02,0x03]")

    // ── KAT 6: asn1_tlv(0x04, 200-byte value) starts with [0x04,0x81,0xC8] ─
    // 200 == 0xC8.  Long form: 0x81 prefix then 0xC8.
    let content6 = bytes(200)
    let tlv6 = asn1_tlv(4, content6)
    ckb("tlv6 total len",  bytes_len(tlv6), 203)
    ckb("tlv6 tag",        bytes_get(tlv6, 0), 4)
    ckb("tlv6 len hdr",    bytes_get(tlv6, 1), 129)
    ckb("tlv6 len byte",   bytes_get(tlv6, 2), 200)
    print("KAT 6 passed: asn1_tlv(0x04, 200-byte) starts [0x04,0x81,0xC8]")

    // ── KAT 7: round-trip encode then decode at offset 0 ────────────────────
    let rt_enc = asn1_null_encode()
    let rt_pos = asn1_null_decode(rt_enc, 0)
    ckb("roundtrip pos", rt_pos, 2)
    print("KAT 7 passed: encode->decode round-trip pos == 2")

    // ── KAT 8: asn1_null_decode rejects non-zero length byte ─────────────────
    // Build [0x05, 0x01, 0x00] — tag is NULL but length != 0 (malformed DER)
    let buf8 = bytes(3)
    bytes_set(buf8, 0, 5)
    bytes_set(buf8, 1, 1)
    bytes_set(buf8, 2, 0)
    let pos8 = asn1_null_decode(buf8, 0)
    ckb("decode nonzero len", pos8, -1)
    print("KAT 8 passed: asn1_null_decode rejects non-zero length")

    print("PASS _asn1_null_test")
