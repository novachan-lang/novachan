import prism_node
import prism_content
import prism_ui_accordion

fn main()
    let mut total = 0
    let mut failed = 0

    // ── prism_ac_panel: expanded ─────────────────────────────────────────
    let body1 = unwrap(prism_content.prism_label("body one"))
    let body2 = unwrap(prism_content.prism_label("body two"))
    let panel_exp = prism_ui_accordion.prism_ac_panel("Section A", [body1, body2], true)

    total += 1
    if is_ok(panel_exp)
        total = total
    else
        print("FAIL: panel_exp should be ok")
        failed += 1

    let pe = unwrap(panel_exp)

    total += 1
    if prism_node.prism_node_kind_str(pe) == "stack"
        total = total
    else
        print("FAIL: panel_exp kind should be stack")
        failed += 1

    let pe_kids = prism_node.prism_node_children(pe)
    total += 1
    if len(pe_kids) == 2
        total = total
    else
        print("FAIL: panel_exp should have 2 children (header + body)")
        failed += 1

    let pe_header = pe_kids[0]
    total += 1
    if prism_node.prism_node_kind_str(pe_header) == "press"
        total = total
    else
        print("FAIL: panel_exp child0 (header) should be press")
        failed += 1

    let pe_body = pe_kids[1]
    total += 1
    if prism_node.prism_node_kind_str(pe_body) == "stack"
        total = total
    else
        print("FAIL: panel_exp child1 (body) should be stack")
        failed += 1

    let pe_body_kids = prism_node.prism_node_children(pe_body)
    total += 1
    if len(pe_body_kids) == 2
        total = total
    else
        print("FAIL: panel_exp body should carry through both content items")
        failed += 1

    let pe_header_kids = prism_node.prism_node_children(pe_header)
    total += 1
    if len(pe_header_kids) == 1
        total = total
    else
        print("FAIL: panel_exp header should have 1 child (band)")
        failed += 1

    let pe_band = pe_header_kids[0]
    total += 1
    if prism_node.prism_node_kind_str(pe_band) == "band"
        total = total
    else
        print("FAIL: panel_exp header child should be a band")
        failed += 1

    let pe_band_kids = prism_node.prism_node_children(pe_band)
    total += 1
    if len(pe_band_kids) == 2
        total = total
    else
        print("FAIL: panel_exp band should have 2 children (icon + title)")
        failed += 1

    let pe_icon = pe_band_kids[0]
    total += 1
    if prism_node.prism_node_kind_str(pe_icon) == "label"
        total = total
    else
        print("FAIL: panel_exp band child0 (icon) should be a label")
        failed += 1

    total += 1
    if prism_node.prism_node_attr_str(pe_icon, "text", "<none>") == "v "
        total = total
    else
        print("FAIL: panel_exp expanded icon text should be 'v '")
        failed += 1

    let pe_title = pe_band_kids[1]
    total += 1
    if prism_node.prism_node_attr_str(pe_title, "text", "<none>") == "Section A"
        total = total
    else
        print("FAIL: panel_exp title label text should be 'Section A'")
        failed += 1

    // ── prism_ac_panel: collapsed ────────────────────────────────────────
    let panel_col = prism_ui_accordion.prism_ac_panel("Section B", [body1], false)

    total += 1
    if is_ok(panel_col)
        total = total
    else
        print("FAIL: panel_col should be ok")
        failed += 1

    let pc = unwrap(panel_col)

    total += 1
    if prism_node.prism_node_kind_str(pc) == "stack"
        total = total
    else
        print("FAIL: panel_col kind should be stack")
        failed += 1

    let pc_kids = prism_node.prism_node_children(pc)
    total += 1
    if len(pc_kids) == 1
        total = total
    else
        print("FAIL: panel_col should have exactly 1 child (header only, no body)")
        failed += 1

    total += 1
    if prism_node.prism_node_kind_str(pc_kids[0]) == "press"
        total = total
    else
        print("FAIL: panel_col only child should be the press header")
        failed += 1

    let pc_band = prism_node.prism_node_children(pc_kids[0])[0]
    let pc_icon = prism_node.prism_node_children(pc_band)[0]
    total += 1
    if prism_node.prism_node_attr_str(pc_icon, "text", "<none>") == "> "
        total = total
    else
        print("FAIL: panel_col collapsed icon text should be '> '")
        failed += 1

    // ── prism_ac_panel: error paths ──────────────────────────────────────
    let err_title = prism_ui_accordion.prism_ac_panel("", [body1], true)
    total += 1
    if is_err(err_title)
        total = total
    else
        print("FAIL: empty title should error")
        failed += 1
    total += 1
    if contains(unwrap_err(err_title), "title must not be empty")
        total = total
    else
        print("FAIL: empty title error message wrong")
        failed += 1

    let err_content = prism_ui_accordion.prism_ac_panel("T", [], true)
    total += 1
    if is_err(err_content)
        total = total
    else
        print("FAIL: empty content should error")
        failed += 1
    total += 1
    if contains(unwrap_err(err_content), "content must not be empty")
        total = total
    else
        print("FAIL: empty content error message wrong")
        failed += 1

    let bad_first = [42]
    let err_child0 = prism_ui_accordion.prism_ac_panel("T", bad_first, true)
    total += 1
    if is_err(err_child0)
        total = total
    else
        print("FAIL: non-PrismNode child (idx 0) should error")
        failed += 1
    total += 1
    if contains(unwrap_err(err_child0), "child 0 is not a PrismNode (got int)")
        total = total
    else
        print("FAIL: non-PrismNode child0 error message wrong")
        failed += 1

    let bad_second = [body1, 9]
    let err_child1 = prism_ui_accordion.prism_ac_panel("T", bad_second, true)
    total += 1
    if is_err(err_child1)
        total = total
    else
        print("FAIL: non-PrismNode child (idx 1) should error")
        failed += 1
    total += 1
    if contains(unwrap_err(err_child1), "child 1 is not a PrismNode (got int)")
        total = total
    else
        print("FAIL: non-PrismNode child1 error message wrong")
        failed += 1

    // ── prism_ac_group ────────────────────────────────────────────────────
    let panel_c = unwrap(prism_ui_accordion.prism_ac_panel("Section C", [body1], false))
    let group3 = prism_ui_accordion.prism_ac_group([pe, pc, panel_c], 12)

    total += 1
    if is_ok(group3)
        total = total
    else
        print("FAIL: group3 should be ok")
        failed += 1

    let g3 = unwrap(group3)
    total += 1
    if prism_node.prism_node_kind_str(g3) == "stack"
        total = total
    else
        print("FAIL: group3 kind should be stack")
        failed += 1

    let g3_kids = prism_node.prism_node_children(g3)
    total += 1
    if len(g3_kids) == 5
        total = total
    else
        print("FAIL: group3 should have 5 children (3 panels + 2 gaps)")
        failed += 1

    total += 1
    if prism_node.prism_node_kind_str(g3_kids[0]) == "stack"
        total = total
    else
        print("FAIL: group3 child0 should be the first panel (stack)")
        failed += 1

    total += 1
    if prism_node.prism_node_kind_str(g3_kids[1]) == "gap"
        total = total
    else
        print("FAIL: group3 child1 should be a gap")
        failed += 1

    total += 1
    if prism_node.prism_node_kind_str(g3_kids[2]) == "stack"
        total = total
    else
        print("FAIL: group3 child2 should be the second panel (stack)")
        failed += 1

    total += 1
    if prism_node.prism_node_kind_str(g3_kids[3]) == "gap"
        total = total
    else
        print("FAIL: group3 child3 should be a gap")
        failed += 1

    total += 1
    if prism_node.prism_node_kind_str(g3_kids[4]) == "stack"
        total = total
    else
        print("FAIL: group3 child4 should be the third panel (stack)")
        failed += 1

    // single-panel group: no gaps needed
    let group1 = prism_ui_accordion.prism_ac_group([pe], 8)
    total += 1
    if is_ok(group1)
        total = total
    else
        print("FAIL: single-panel group should be ok")
        failed += 1
    total += 1
    if len(prism_node.prism_node_children(unwrap(group1))) == 1
        total = total
    else
        print("FAIL: single-panel group should have exactly 1 child (no gap)")
        failed += 1

    // ── prism_ac_group: error paths ──────────────────────────────────────
    let err_panels_empty = prism_ui_accordion.prism_ac_group([], 8)
    total += 1
    if is_err(err_panels_empty)
        total = total
    else
        print("FAIL: empty panels list should error")
        failed += 1
    total += 1
    if contains(unwrap_err(err_panels_empty), "panels must not be empty")
        total = total
    else
        print("FAIL: empty panels error message wrong")
        failed += 1

    let err_gap_zero = prism_ui_accordion.prism_ac_group([pe], 0)
    total += 1
    if is_err(err_gap_zero)
        total = total
    else
        print("FAIL: gap_px == 0 should error")
        failed += 1
    total += 1
    if contains(unwrap_err(err_gap_zero), "gap_px must be > 0")
        total = total
    else
        print("FAIL: gap_px == 0 error message wrong")
        failed += 1

    let err_gap_neg = prism_ui_accordion.prism_ac_group([pe], -5)
    total += 1
    if is_err(err_gap_neg)
        total = total
    else
        print("FAIL: negative gap_px should error")
        failed += 1

    let bad_panel_list = [7]
    let err_bad_panel = prism_ui_accordion.prism_ac_group(bad_panel_list, 8)
    total += 1
    if is_err(err_bad_panel)
        total = total
    else
        print("FAIL: non-PrismNode panel should error")
        failed += 1
    total += 1
    if contains(unwrap_err(err_bad_panel), "panel 0 is not a PrismNode (got int)")
        total = total
    else
        print("FAIL: non-PrismNode panel error message wrong")
        failed += 1

    // ── prism_ac_text ────────────────────────────────────────────────────
    let text_exp = prism_ui_accordion.prism_ac_text("Notes", "hello world", true)
    total += 1
    if is_ok(text_exp)
        total = total
    else
        print("FAIL: prism_ac_text should be ok")
        failed += 1

    let te = unwrap(text_exp)
    total += 1
    if prism_node.prism_node_kind_str(te) == "stack"
        total = total
    else
        print("FAIL: prism_ac_text kind should be stack (delegates to panel)")
        failed += 1

    let te_kids = prism_node.prism_node_children(te)
    total += 1
    if len(te_kids) == 2
        total = total
    else
        print("FAIL: prism_ac_text expanded should have header + body")
        failed += 1

    let te_body_kids = prism_node.prism_node_children(te_kids[1])
    total += 1
    if len(te_body_kids) == 1
        total = total
    else
        print("FAIL: prism_ac_text body should carry exactly 1 label")
        failed += 1

    total += 1
    if prism_node.prism_node_attr_str(te_body_kids[0], "text", "<none>") == "hello world"
        total = total
    else
        print("FAIL: prism_ac_text body label text should be 'hello world'")
        failed += 1

    let text_col = prism_ui_accordion.prism_ac_text("Notes", "hidden text", false)
    total += 1
    if len(prism_node.prism_node_children(unwrap(text_col))) == 1
        total = total
    else
        print("FAIL: prism_ac_text collapsed should have just the header")
        failed += 1

    // prism_ac_text: error paths
    let err_text_title = prism_ui_accordion.prism_ac_text("", "x", true)
    total += 1
    if is_err(err_text_title)
        total = total
    else
        print("FAIL: prism_ac_text empty title should error")
        failed += 1
    total += 1
    if contains(unwrap_err(err_text_title), "prism_ac_text: title must not be empty")
        total = total
    else
        print("FAIL: prism_ac_text empty title error message wrong")
        failed += 1

    let err_text_body = prism_ui_accordion.prism_ac_text("T", "", true)
    total += 1
    if is_err(err_text_body)
        total = total
    else
        print("FAIL: prism_ac_text empty text should error")
        failed += 1
    total += 1
    if contains(unwrap_err(err_text_body), "prism_ac_text: text must not be empty")
        total = total
    else
        print("FAIL: prism_ac_text empty text error message wrong")
        failed += 1

    // ── prism_ac_faq ─────────────────────────────────────────────────────
    let faq_col = prism_ui_accordion.prism_ac_faq("Is NOVA fast?", "Yes, C-class.", false)
    total += 1
    if is_ok(faq_col)
        total = total
    else
        print("FAIL: prism_ac_faq should be ok")
        failed += 1

    let fc = unwrap(faq_col)
    total += 1
    if prism_node.prism_node_kind_str(fc) == "stack"
        total = total
    else
        print("FAIL: prism_ac_faq kind should be stack")
        failed += 1

    let fc_kids = prism_node.prism_node_children(fc)
    total += 1
    if len(fc_kids) == 2
        total = total
    else
        print("FAIL: prism_ac_faq should have 2 children (question + answer panel)")
        failed += 1

    total += 1
    if prism_node.prism_node_kind_str(fc_kids[0]) == "label"
        total = total
    else
        print("FAIL: prism_ac_faq child0 should be the question label")
        failed += 1

    total += 1
    if prism_node.prism_node_attr_str(fc_kids[0], "text", "<none>") == "Q: Is NOVA fast?"
        total = total
    else
        print("FAIL: prism_ac_faq question text should be prefixed with 'Q: '")
        failed += 1

    total += 1
    if prism_node.prism_node_kind_str(fc_kids[1]) == "stack"
        total = total
    else
        print("FAIL: prism_ac_faq child1 (answer panel) should be a stack")
        failed += 1

    let fc_answer_kids = prism_node.prism_node_children(fc_kids[1])
    total += 1
    if len(fc_answer_kids) == 1
        total = total
    else
        print("FAIL: prism_ac_faq collapsed answer panel should have header only")
        failed += 1

    let fc_answer_band = prism_node.prism_node_children(fc_answer_kids[0])[0]
    let fc_answer_labels = prism_node.prism_node_children(fc_answer_band)
    total += 1
    if prism_node.prism_node_attr_str(fc_answer_labels[1], "text", "<none>") == "Answer"
        total = total
    else
        print("FAIL: prism_ac_faq answer panel title should be 'Answer'")
        failed += 1

    let faq_exp = prism_ui_accordion.prism_ac_faq("Q2", "A2 body text", true)
    let fe = unwrap(faq_exp)
    let fe_kids = prism_node.prism_node_children(fe)
    let fe_answer_kids = prism_node.prism_node_children(fe_kids[1])
    total += 1
    if len(fe_answer_kids) == 2
        total = total
    else
        print("FAIL: prism_ac_faq expanded answer panel should have header + body")
        failed += 1

    let fe_answer_body_kids = prism_node.prism_node_children(fe_answer_kids[1])
    total += 1
    if prism_node.prism_node_attr_str(fe_answer_body_kids[0], "text", "<none>") == "A: A2 body text"
        total = total
    else
        print("FAIL: prism_ac_faq expanded answer body text should be prefixed with 'A: '")
        failed += 1

    // prism_ac_faq: error paths
    let err_faq_q = prism_ui_accordion.prism_ac_faq("", "answer", true)
    total += 1
    if is_err(err_faq_q)
        total = total
    else
        print("FAIL: prism_ac_faq empty question should error")
        failed += 1
    total += 1
    if contains(unwrap_err(err_faq_q), "question must not be empty")
        total = total
    else
        print("FAIL: prism_ac_faq empty question error message wrong")
        failed += 1

    let err_faq_a = prism_ui_accordion.prism_ac_faq("question", "", true)
    total += 1
    if is_err(err_faq_a)
        total = total
    else
        print("FAIL: prism_ac_faq empty answer should error")
        failed += 1
    total += 1
    if contains(unwrap_err(err_faq_a), "answer must not be empty")
        total = total
    else
        print("FAIL: prism_ac_faq empty answer error message wrong")
        failed += 1

    // ── summary ──────────────────────────────────────────────────────────
    let passed = total - failed
    if failed == 0
        print("PASS: " + str(passed) + "/" + str(total) + " assertions passed (prism_ui_accordion)")
    else
        print("FAIL: " + str(failed) + "/" + str(total) + " assertions failed (prism_ui_accordion)")
