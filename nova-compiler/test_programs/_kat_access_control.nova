import forge_access_control

fn main()
    let a = ac_new()
    a = ac_add_role(a, "admin")
    a = ac_add_role(a, "viewer")
    assert(ac_role_count(a) == 2, "2 roles")

    let r1 = ac_grant_permission(a, "admin", "write")
    assert(is_ok(r1), "grant ok")
    a = unwrap(r1)
    let r2 = ac_grant_permission(a, "admin", "read")
    a = unwrap(r2)
    let r3 = ac_grant_permission(a, "viewer", "read")
    a = unwrap(r3)

    let r4 = ac_assign_role(a, "alice", "admin")
    a = unwrap(r4)
    let r5 = ac_assign_role(a, "bob", "viewer")
    a = unwrap(r5)

    let c1 = ac_check(a, "alice", "write")
    assert(is_ok(c1), "alice can write")

    let c2 = ac_check(a, "bob", "write")
    assert(is_err(c2), "bob cannot write")

    let c3 = ac_check(a, "unknown", "read")
    assert(is_err(c3), "unknown user denied")

    let role = ac_user_role(a, "alice")
    assert(unwrap(role) == "admin", "alice=admin")

    let bad = ac_grant_permission(a, "fake", "x")
    assert(is_err(bad), "unknown role is err")

    print("ACCESS-CONTROL KAT PASS")
