// Regression test for the networking last-mile builtins: udp_recv_from (peer address) + socket_option
// (string-keyed setsockopt). Loopback only; self-contained. (S6 unix sockets deferred — see runtime note.)

fn main()
    // ── udp_recv_from: [data, host, port] ──────────────────────────────────
    let server = udp_bind(47654)
    if server < 0
        print("FAIL udp_bind server")
        exit(1)
    let client = udp_bind(0)
    if client < 0
        print("FAIL udp_bind client")
        exit(1)
    udp_send(client, "127.0.0.1", 47654, "hello-peer")
    let got = udp_recv_from(server)
    if len(got) != 3
        print("FAIL udp_recv_from arity: " + str(len(got)))
        exit(1)
    if got[0] != "hello-peer"
        print("FAIL udp_recv_from data: " + got[0])
        exit(1)
    if got[1] != "127.0.0.1"
        print("FAIL udp_recv_from host: " + got[1])
        exit(1)
    if parse_int(got[2]) <= 0
        print("FAIL udp_recv_from port: " + got[2])
        exit(1)
    print("ok udp_recv_from: data=" + got[0] + " host=" + got[1] + " port=" + got[2])

    // ── socket_option: string-keyed, known keys succeed, unknown fails ─────
    if not socket_option(client, "broadcast", 1)
        print("FAIL socket_option broadcast")
        exit(1)
    if not socket_option(client, "rcvbuf", 65536)
        print("FAIL socket_option rcvbuf")
        exit(1)
    if not socket_option(client, "reuseaddr", 1)
        print("FAIL socket_option reuseaddr")
        exit(1)
    if socket_option(client, "bogus_option_xyz", 1)
        print("FAIL socket_option should reject unknown key")
        exit(1)
    let listener = tcp_listen(47655)
    if not socket_option(listener, "nodelay", 1)
        print("FAIL socket_option nodelay")
        exit(1)
    print("ok socket_option: broadcast/rcvbuf/reuseaddr/nodelay set, unknown rejected")
    tcp_close(listener)

    print("_net_probe passed")
