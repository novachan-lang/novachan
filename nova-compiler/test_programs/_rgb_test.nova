// KAT for std/color/rgb — RGB color model (channels 0..255).
// All known-answer values verified by hand against spec formulas.
import std/color/rgb

// cki — check int equality; print FAIL and exit(1) on mismatch.
fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// ckb — check bool equality; print FAIL and exit(1) on mismatch.
fn ckb(label: str, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got " + gs + " want " + ws)
        exit(1)

// ckc — check a [r,g,b] list matches expected r,g,b values.
fn ckc(label: str, got: list, wr: int, wg: int, wb: int)
    let gr = got[0]
    let gg = got[1]
    let gb = got[2]
    if gr != wr
        print("FAIL " + label + ".r: got " + str(gr) + " want " + str(wr))
        exit(1)
    if gg != wg
        print("FAIL " + label + ".g: got " + str(gg) + " want " + str(wg))
        exit(1)
    if gb != wb
        print("FAIL " + label + ".b: got " + str(gb) + " want " + str(wb))
        exit(1)

fn main()
    // KAT 1: rgb_new clamps out-of-range values: (300,-5,128) -> [255,0,128]
    let c1 = rgb_new(300, -5, 128)
    ckc("rgb_new_clamp", c1, 255, 0, 128)

    // KAT 2: rgb_r/rgb_g/rgb_b accessors
    cki("rgb_r", rgb_r(c1), 255)
    cki("rgb_g", rgb_g(c1), 0)
    cki("rgb_b", rgb_b(c1), 128)

    // KAT 3: rgb_invert([255,0,128]) == [0,255,127]
    let c2 = rgb_invert(c1)
    ckc("rgb_invert", c2, 0, 255, 127)

    // KAT 4: rgb_grayscale([255,255,255]) == 255
    // 0.299*255 + 0.587*255 + 0.114*255 = 255.0 -> 255
    let cwhite = rgb_new(255, 255, 255)
    cki("rgb_grayscale_white", rgb_grayscale(cwhite), 255)

    // KAT 5: rgb_grayscale([0,0,0]) == 0
    let cblack = rgb_new(0, 0, 0)
    cki("rgb_grayscale_black", rgb_grayscale(cblack), 0)

    // KAT 6: rgb_grayscale([255,0,0]) == 76
    // 0.299*255 = 76.245 -> rounded = 76
    let cred = rgb_new(255, 0, 0)
    cki("rgb_grayscale_red", rgb_grayscale(cred), 76)

    // KAT 7: rgb_lighten([100,100,100], 0.5) == [177,177,177]
    // 100 + 0.5*(255-100) = 100 + 77.5 = 177.5 -> float_to_int truncates = 177
    // Spec says 177. float_to_int truncates toward zero: 177.5 -> 177. Correct.
    let cmid = rgb_new(100, 100, 100)
    let clight = rgb_lighten(cmid, 0.5)
    ckc("rgb_lighten", clight, 177, 177, 177)

    // KAT 8: rgb_darken([200,200,200], 0.5) == [100,100,100]
    // 200 * (1 - 0.5) = 200 * 0.5 = 100.0 -> 100
    let cbright = rgb_new(200, 200, 200)
    let cdark = rgb_darken(cbright, 0.5)
    ckc("rgb_darken", cdark, 100, 100, 100)

    // KAT 9: rgb_equal — same color is equal
    let ca = rgb_new(10, 20, 30)
    let cb = rgb_new(10, 20, 30)
    ckb("rgb_equal_true", rgb_equal(ca, cb), true)

    // KAT 10: rgb_equal — different colors are not equal
    let cc = rgb_new(10, 20, 31)
    ckb("rgb_equal_false", rgb_equal(ca, cc), false)

    // KAT 11: rgb_clamp clamps each channel independently
    let raw = []
    raw.push(-10)
    raw.push(300)
    raw.push(128)
    let clamped = rgb_clamp(raw)
    ckc("rgb_clamp", clamped, 0, 255, 128)

    // KAT 12: rgb_invert then rgb_invert = identity
    let orig = rgb_new(50, 100, 200)
    let inv = rgb_invert(orig)
    let inv2 = rgb_invert(inv)
    ckc("rgb_invert_involution", inv2, 50, 100, 200)

    print("_rgb_test passed")
