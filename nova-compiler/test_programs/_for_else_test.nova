fn main()
    let found = false
    for x in [1, 2, 3, 4, 5]
        if x == 3
            found = true
            break
    else
        print("FAIL: else ran but break should have skipped it")

    assert(found, "should have found 3")

    let fell_through = false
    for x in [1, 2, 3]
        if x == 99
            break
    else
        fell_through = true

    assert(fell_through, "else should run when loop completes without break")

    let empty_else = false
    for x in []
        print("should not run")
    else
        empty_else = true

    assert(empty_else, "else should run for empty iteration")

    print("for_else_test: all passed")
