import forge_convexhull

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn near(a: float, b: float) -> bool
    let d = a - b
    d > -0.001 and d < 0.001

fn contains_pt(hull, x, y) -> bool
    let i = 0
    let found = false
    while i < len(hull)
        if hull[i][0] == x and hull[i][1] == y
            found = true
        i = i + 1
    found

fn main()
    let fails = 0

    // square with an interior point: hull = 4 corners, interior [1,1] excluded
    let sq = [[0, 0], [3, 0], [3, 3], [0, 3], [1, 1]]
    fails = fails + expect("square_size", str(hull_size(sq)), "4")
    let h = convex_hull(sq)
    fails = fails + expect_true("has_00", contains_pt(h, 0, 0))
    fails = fails + expect_true("has_33", contains_pt(h, 3, 3))
    fails = fails + expect_true("excludes_11", contains_pt(h, 1, 1) == false)
    fails = fails + expect_true("square_area", near(hull_area(sq), 9.0))

    // triangle + many interior points -> just the 3 corners
    let tri = [[0, 0], [6, 0], [3, 6], [3, 2], [2, 1], [4, 1], [3, 3]]
    fails = fails + expect("tri_size", str(hull_size(tri)), "3")
    fails = fails + expect_true("tri_area", near(hull_area(tri), 18.0))

    // collinear points on an edge are dropped: [0,0],[1,0],[2,0],[2,2],[0,2] -> 4 corners (mid-edge [1,0] out)
    let col = [[0, 0], [1, 0], [2, 0], [2, 2], [0, 2]]
    fails = fails + expect("collinear_size", str(hull_size(col)), "4")

    // fewer than 3 points -> returns them
    fails = fails + expect("two_pts", str(hull_size([[0, 0], [1, 1]])), "2")
    fails = fails + expect("one_pt", str(hull_size([[5, 5]])), "1")

    // all points on the hull (convex polygon already)
    let pentagon = [[0, 0], [4, 0], [5, 3], [2, 5], [0 - 1, 3]]
    fails = fails + expect("pentagon_all", str(hull_size(pentagon)), "5")

    // float coordinates
    let fpts = [[0.0, 0.0], [2.0, 0.0], [2.0, 2.0], [0.0, 2.0], [1.0, 1.0]]
    fails = fails + expect("float_size", str(hull_size(fpts)), "4")
    fails = fails + expect_true("float_area", near(hull_area(fpts), 4.0))

    if fails == 0
        print("forge_convexhull: all passed")
    else
        print("forge_convexhull: " + str(fails) + " FAILED")
