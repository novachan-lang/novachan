import forge_url_rewriter

fn main()
    let u = ur_new()
    u = ur_add_rule(u, "/old-page", "/new-page")
    u = ur_add_rule(u, "/legacy/api", "/v2/api")
    assert(ur_rule_count(u) == 2, "2 rules")

    let r1 = ur_rewrite(u, "/old-page")
    assert(is_ok(r1), "rewrite ok")
    assert(unwrap(r1) == "/new-page", "rewritten")

    let r2 = ur_rewrite(u, "/no-match")
    assert(is_ok(r2), "pass through ok")
    assert(unwrap(r2) == "/no-match", "unchanged")

    assert(ur_rewrite_count(u) == 1, "1 rewrite")
    assert(ur_miss_count(u) == 1, "1 miss")

    let ra = ur_rule_at(u, 0)
    assert(is_ok(ra), "rule at ok")

    let bad = ur_rule_at(u, 5)
    assert(is_err(bad), "out of range")

    print("URL-REWRITER KAT PASS")
