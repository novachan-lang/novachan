// KAT test for std/data/toml -- toml_parse (TOML v1.0 parser)
import std/data/toml

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + got + " expected " + expected)
        exit(1)

fn ckb(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// ── KAT 1: the exact doc from the task spec ─────────────────────────────────
let q = chr(34)
let nl = chr(10)
let doc1 = "title = " + q + "NOVA" + q + nl
doc1 = doc1 + "[db]" + nl
doc1 = doc1 + "port = 5432" + nl
doc1 = doc1 + "enabled = true" + nl
doc1 = doc1 + "tags = [" + q + "x" + q + "," + q + "y" + q + "]" + nl
doc1 = doc1 + "[[srv]]" + nl
doc1 = doc1 + "ip = " + q + "10.0.0.1" + q + nl
doc1 = doc1 + "[[srv]]" + nl
doc1 = doc1 + "ip = " + q + "10.0.0.2" + q

let r1 = toml_parse(doc1)
cks("title", r1["title"], "NOVA")
let db1 = r1["db"]
cki("db-port", db1["port"], 5432)
ckb("db-enabled", db1["enabled"], true)
let tags1 = db1["tags"]
cks("tags-1", tags1[1], "y")
let srv1 = r1["srv"]
cki("srv-len", len(srv1), 2)
cks("srv-1-ip", srv1[1]["ip"], "10.0.0.2")

// ── KAT 2: comments, floats, negative int, bool false, dotted key ──────────
let doc2 = "# leading comment" + nl
doc2 = doc2 + "name = " + q + "nova" + q + "  # trailing comment" + nl
doc2 = doc2 + "pi = 3.14" + nl
doc2 = doc2 + "neg = -7" + nl
doc2 = doc2 + "active = false" + nl
doc2 = doc2 + "server.host = " + q + "localhost" + q + nl
doc2 = doc2 + "server.port = 8080"

let r2 = toml_parse(doc2)
cks("name", r2["name"], "nova")
let pi2 = r2["pi"]
let pi_ok = 0
if pi2 > 3.13 and pi2 < 3.15
    pi_ok = 1
cki("pi-approx", pi_ok, 1)
cki("neg", r2["neg"], -7)
ckb("active-false", r2["active"], false)
let server2 = r2["server"]
cks("server-host", server2["host"], "localhost")
cki("server-port", server2["port"], 8080)

// ── KAT 3: multi-line array, trailing comma, string escapes ────────────────
let bs = chr(92)
let doc3 = "greeting = " + q + "hi" + bs + "nthere" + q + nl
doc3 = doc3 + "nums = [" + nl
doc3 = doc3 + "  1," + nl
doc3 = doc3 + "  2, # two" + nl
doc3 = doc3 + "  3," + nl
doc3 = doc3 + "]"

let r3 = toml_parse(doc3)
cks("escape-n", r3["greeting"], "hi" + nl + "there")
let nums3 = r3["nums"]
cki("nums-len", len(nums3), 3)
cki("nums-2", nums3[2], 3)

// ── KAT 4: nested array-of-tables with subtable via dotted header ──────────
let doc4 = "[[fruits]]" + nl
doc4 = doc4 + "name = " + q + "apple" + q + nl
doc4 = doc4 + "[fruits.physical]" + nl
doc4 = doc4 + "color = " + q + "red" + q + nl
doc4 = doc4 + "[[fruits]]" + nl
doc4 = doc4 + "name = " + q + "banana" + q

let r4 = toml_parse(doc4)
let fruits4 = r4["fruits"]
cki("fruits-len", len(fruits4), 2)
cks("fruit0-name", fruits4[0]["name"], "apple")
let phys4 = fruits4[0]["physical"]
cks("fruit0-color", phys4["color"], "red")
cks("fruit1-name", fruits4[1]["name"], "banana")

// ── KAT 5: literal string (no escapes) + toml_get ───────────────────────────
let sq = chr(39)
let doc5 = "path = " + sq + "C:" + bs + "temp" + bs + "x" + sq
let r5 = toml_parse(doc5)
cks("literal-string", r5["path"], "C:" + bs + "temp" + bs + "x")
cks("toml_get", toml_get(r2, "server.host"), "localhost")

print("PASS toml_test")
