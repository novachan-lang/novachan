fn agg_sum(items, key_fn)
  let total = 0
  for item in items
    total = total + key_fn(item)
  total

fn agg_avg(items, key_fn)
  if len(items) == 0
    return 0
  agg_sum(items, key_fn) / len(items)

fn agg_min_by(items, key_fn)
  if len(items) == 0
    return err("empty")
  let best = items[0]
  let best_val = key_fn(items[0])
  let i = 1
  while i < len(items)
    let v = key_fn(items[i])
    if v < best_val
      best_val = v
      best = items[i]
    i = i + 1
  ok(best)

fn agg_max_by(items, key_fn)
  if len(items) == 0
    return err("empty")
  let best = items[0]
  let best_val = key_fn(items[0])
  let i = 1
  while i < len(items)
    let v = key_fn(items[i])
    if v > best_val
      best_val = v
      best = items[i]
    i = i + 1
  ok(best)

fn agg_group_by(items, key_fn)
  let groups = {}
  for item in items
    let k = str(key_fn(item))
    if not contains(groups, k)
      groups[k] = []
    push(groups[k], item)
  groups

fn agg_count_by(items, key_fn)
  let counts = {}
  for item in items
    let k = str(key_fn(item))
    if not contains(counts, k)
      counts[k] = 0
    counts[k] = counts[k] + 1
  counts

fn _get_age(p)
  p["age"]

fn _get_dept(p)
  p["dept"]

fn main()
  let people = [{"name": "Alice", "age": 30, "dept": "eng"}, {"name": "Bob", "age": 25, "dept": "eng"}, {"name": "Carol", "age": 35, "dept": "sales"}, {"name": "Dave", "age": 28, "dept": "sales"}]

  assert(agg_sum(people, fn(z) _get_age(z)) == 118, "sum ages")
  assert(agg_avg(people, fn(z) _get_age(z)) == 29, "avg age 29")

  let youngest = agg_min_by(people, fn(z) _get_age(z))
  assert(unwrap(youngest)["name"] == "Bob", "youngest Bob")

  let oldest = agg_max_by(people, fn(z) _get_age(z))
  assert(unwrap(oldest)["name"] == "Carol", "oldest Carol")

  let groups = agg_group_by(people, fn(z) _get_dept(z))
  assert(len(groups["eng"]) == 2, "2 in eng")
  assert(len(groups["sales"]) == 2, "2 in sales")

  let counts = agg_count_by(people, fn(z) _get_dept(z))
  assert(counts["eng"] == 2, "eng count 2")
  assert(counts["sales"] == 2, "sales count 2")

  print("aggx: all passed")
