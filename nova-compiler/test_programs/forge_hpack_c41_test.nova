// functional: decode the RFC 7541 C.4.1 Huffman-coded first-request header block END-TO-END
// bytes: 82 86 84 41 8c f1e3c2e5f23a6ba0ab90f4ff  -> :method GET, :scheme http, :path /, :authority www.example.com
import forge_hpack

fn main()
    let buf = [130, 134, 132, 65, 140, 241, 227, 194, 229, 242, 58, 107, 160, 171, 144, 244, 255]
    let res = hpack_decode_header_block(buf, [])
    let headers = res[0]
    if len(headers) != 4
        print("FAIL count = " + str(len(headers)))
        exit(1)
    let auth = ""
    let meth = ""
    let sch = ""
    let path = ""
    let i = 0
    while i < len(headers)
        if headers[i][0] == ":authority"
            auth = headers[i][1]
        if headers[i][0] == ":method"
            meth = headers[i][1]
        if headers[i][0] == ":scheme"
            sch = headers[i][1]
        if headers[i][0] == ":path"
            path = headers[i][1]
        i = i + 1
    if meth != "GET"
        print("FAIL method = " + meth)
        exit(1)
    if sch != "http"
        print("FAIL scheme = " + sch)
        exit(1)
    if path != "/"
        print("FAIL path = " + path)
        exit(1)
    if auth != "www.example.com"
        print("FAIL authority = " + auth)
        exit(1)
    print("PASS forge_hpack_c41 (full HPACK+Huffman header block decode)")
