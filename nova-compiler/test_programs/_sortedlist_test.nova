import std/collections/sortedlist

fn cki(got, expected, label)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn main()
    // --- KAT 1: insort 5,1,3,2,4 into empty -> [1,2,3,4,5] ---
    let sl = sortedlist.sl_new()
    sortedlist.sl_insort(sl, 5)
    sortedlist.sl_insort(sl, 1)
    sortedlist.sl_insort(sl, 3)
    sortedlist.sl_insort(sl, 2)
    sortedlist.sl_insort(sl, 4)
    let lst = sortedlist.sl_to_list(sl)
    cki(lst[0], 1, "insort order [0]==1")
    cki(lst[1], 2, "insort order [1]==2")
    cki(lst[2], 3, "insort order [2]==3")
    cki(lst[3], 4, "insort order [3]==4")
    cki(lst[4], 5, "insort order [4]==5")
    cki(sortedlist.sl_len(sl), 5, "len==5 after 5 insorts")

    // --- KAT 2: bisect_left and bisect_right on [1,2,4] ---
    let sl2 = sortedlist.sl_new()
    sortedlist.sl_insort(sl2, 1)
    sortedlist.sl_insort(sl2, 2)
    sortedlist.sl_insort(sl2, 4)
    // bisect_left(3): 1<3, 2<3, 4>=3 -> index 2
    cki(sortedlist.sl_bisect_left(sl2, 3), 2, "bisect_left(3)==2")
    // bisect_right(2): 1<=2, 2<=2, 4>2 -> index 2
    cki(sortedlist.sl_bisect_right(sl2, 2), 2, "bisect_right(2)==2")
    // bisect_left(2): 1<2, 2>=2 -> index 1
    cki(sortedlist.sl_bisect_left(sl2, 1), 0, "bisect_left(1)==0")
    cki(sortedlist.sl_bisect_left(sl2, 2), 1, "bisect_left(2)==1")
    // bisect_left at boundary: value beyond end -> len
    cki(sortedlist.sl_bisect_left(sl2, 5), 3, "bisect_left(5)==3 (past end)")
    // bisect_right at boundary: value before start -> 0
    cki(sortedlist.sl_bisect_right(sl2, 0), 0, "bisect_right(0)==0 (before start)")

    // --- KAT 3: contains ---
    cki(sortedlist.sl_contains(sl2, 2), 1, "contains 2 in [1,2,4]")
    cki(sortedlist.sl_contains(sl2, 3), 0, "contains 3 absent in [1,2,4]")
    // insort 3 into [1,2,4] -> [1,2,3,4]
    sortedlist.sl_insort(sl2, 3)
    cki(sortedlist.sl_contains(sl2, 3), 1, "contains 3 after insort into [1,2,4]")
    cki(sortedlist.sl_len(sl2), 4, "len==4 after insort 3 into [1,2,4]")

    // --- KAT 4: index ---
    // sl2 is now [1,2,3,4]
    cki(sortedlist.sl_index(sl2, 4), 3, "index(4)==3 in [1,2,3,4]")
    cki(sortedlist.sl_index(sl2, 1), 0, "index(1)==0")
    cki(sortedlist.sl_index(sl2, 9), -1, "index(9)==-1 absent")

    // --- KAT 5: duplicates - insort 2 twice into [1,2,4] ---
    let sl3 = sortedlist.sl_new()
    sortedlist.sl_insort(sl3, 1)
    sortedlist.sl_insort(sl3, 2)
    sortedlist.sl_insort(sl3, 4)
    sortedlist.sl_insort(sl3, 2)
    // [1,2,2,4]
    let lst3 = sortedlist.sl_to_list(sl3)
    cki(lst3[0], 1, "dup [0]==1")
    cki(lst3[1], 2, "dup [1]==2")
    cki(lst3[2], 2, "dup [2]==2")
    cki(lst3[3], 4, "dup [3]==4")
    cki(sortedlist.sl_len(sl3), 4, "len==4 with dup")
    // bisect_right(2) on [1,2,2,4]: lo advances past both 2s -> index 3
    cki(sortedlist.sl_bisect_right(sl3, 2), 3, "bisect_right(2)==3 with dup")
    // bisect_left(2) on [1,2,2,4]: stops at first 2 -> index 1
    cki(sortedlist.sl_bisect_left(sl3, 2), 1, "bisect_left(2)==1 with dup")

    // --- KAT 6: empty list edge cases ---
    let sl4 = sortedlist.sl_new()
    cki(sortedlist.sl_len(sl4), 0, "empty len==0")
    cki(sortedlist.sl_contains(sl4, 0), 0, "empty contains 0 == 0")
    cki(sortedlist.sl_index(sl4, 1), -1, "empty index returns -1")
    cki(sortedlist.sl_bisect_left(sl4, 5), 0, "empty bisect_left==0")
    cki(sortedlist.sl_bisect_right(sl4, 5), 0, "empty bisect_right==0")

    print("_sortedlist_test passed")
