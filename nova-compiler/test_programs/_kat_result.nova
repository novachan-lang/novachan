import std/core/result

fn main() -> int
    let fails = 0
    let a = ok(42)
    let b = err("nope")
    if not result_is_ok(a)
        print("FAIL is_ok a")
        fails = fails + 1
    if result_is_ok(b)
        print("FAIL is_ok b")
        fails = fails + 1
    if not result_is_err(b)
        print("FAIL is_err b")
        fails = fails + 1
    if result_unwrap_or(a, 0) != 42
        print("FAIL unwrap a")
        fails = fails + 1
    if result_unwrap_or(b, 7) != 7
        print("FAIL unwrap b")
        fails = fails + 1
    if result_unwrap_or_else(a, fn(e) 0 - len(e)) != 42
        print("FAIL uoe a")
        fails = fails + 1
    if result_unwrap_or_else(b, fn(e) 0 - len(e)) != 0 - 4
        print("FAIL uoe b")
        fails = fails + 1
    // map: Ok transformed, called at TWO sites (a and b) — the fix under test
    match result_map(a, fn(x) x + 1)
        Ok(v) =>
            if v != 43
                print("FAIL map a v=" + str(v))
                fails = fails + 1
        Err(e) =>
            print("FAIL map a got Err")
            fails = fails + 1
    match result_map(b, fn(x) x + 1)
        Ok(v) =>
            print("FAIL map b should stay Err")
            fails = fails + 1
        Err(e) =>
            print("ok: map on Err stays Err")
    // and_then chaining
    match result_and_then(a, fn(x) ok(x * 2))
        Ok(v) =>
            if v != 84
                print("FAIL and_then v=" + str(v))
                fails = fails + 1
        Err(e) =>
            print("FAIL and_then got Err")
            fails = fails + 1
    if fails == 0
        print("PASS _kat_result")
    else
        print("FAILED _kat_result")
    return 0
