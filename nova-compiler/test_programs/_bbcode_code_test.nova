// KAT test for std/text/bbcode_code
import std/text/bbcode_code

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got [" + got + "] want [" + want + "]")
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    let nl = chr(10)

    // KAT 1: extract_blocks — single block
    let b1 = bcod_extract_blocks("before [code]let x = 1[/code] after")
    cki("extract_single_len", len(b1), 1)
    cks("extract_single_val", b1[0], "let x = 1")

    // KAT 2: extract_blocks — multiple blocks
    let b2 = bcod_extract_blocks("[code]aaa[/code] mid [code]bbb[/code]")
    cki("extract_multi_len", len(b2), 2)
    cks("extract_multi_0", b2[0], "aaa")
    cks("extract_multi_1", b2[1], "bbb")

    // KAT 3: extract_blocks — no blocks
    let b3 = bcod_extract_blocks("no code here")
    cki("extract_none_len", len(b3), 0)

    // KAT 4: build wraps code literally
    let built = bcod_build("print(1)")
    cks("build_basic", built, "[code]print(1)[/code]")

    // KAT 5: escape replaces brackets with numeric entities
    let esc = bcod_escape("[b]bold[/b]")
    cks("escape_brackets", esc, "&#91;b&#93;bold&#91;/b&#93;")

    // KAT 6: escape leaves plain text untouched
    let esc2 = bcod_escape("plain text")
    cks("escape_plain", esc2, "plain text")

    // KAT 7: count_blocks — two blocks
    cki("count_two", bcod_count_blocks("[code]a[/code][code]b[/code]"), 2)

    // KAT 8: count_blocks — zero blocks
    cki("count_zero", bcod_count_blocks("nothing"), 0)

    // KAT 9: strip_outside — joins multiple blocks with newline, drops other text
    let stripped = bcod_strip_outside("intro [code]line1[/code] middle [code]line2[/code] outro")
    cks("strip_outside_multi", stripped, "line1" + nl + "line2")

    // KAT 10: strip_outside — single block, no trailing newline
    let stripped1 = bcod_strip_outside("x [code]only[/code] y")
    cks("strip_outside_single", stripped1, "only")

    print("PASS _bbcode_code_test")
