// KAT 1.6 -- NULL IS ABSENCE. The two requirements that WEAPON_PARITY_PLAN recorded as
// irreconcilable must both hold in the SAME program:
//
//     let z = 0;  z == null        must be FALSE   (0 is a value)
//     h["never_set"] == null       must be TRUE    (absence)
//
// They are only irreconcilable if `==` is the only operation considered. The resolution is
// that absence keeps its own identity under `==` while COERCING to zero everywhere a number
// is wanted -- falsy, arithmetic-zero, order-as-zero. Section 3 below is the load-bearing
// half: the earlier attempt (2026-08-22) routed absent through the singleton WITHOUT those
// coercions, so `d["count"] + 1` computed on a heap pointer and -- the cause recorded as
// "still unidentified" for four days -- `while node` looped FOREVER, because nova_rt_truthy
// returned 1 for every non-float box. 11 tree/list tests timed out on exactly that.
//
// Compiled with NOVA_FIRSTCLASS_NULL=1 by the gate. Under the default (flag off) absence is
// raw 0 and sections 2/3/6 read differently -- which is why the gate sets the flag rather
// than this file assuming it.

fn ident(x: int) -> int
    x

// Both of these are declared `-> any` ON PURPOSE, and the KAT does not work without it.
// If the node type is allowed to settle as Dict, `while cur` becomes a type error --
// `expected bool, found Dict` -- because only an `any`-typed condition is routed through
// nova_rt_truthy. And nova_rt_truthy is exactly the function whose NOVA_BOX_NULL arm this
// test exists to pin. Annotating is not working around the checker here; it is the only way
// to reach the code path.
fn mk_node(v: int, nx: any) -> any
    let d = {}
    d["v"] = v
    d["next"] = nx
    d

// The TAIL deliberately never sets "next" at all. Storing an explicit null there would be a
// weaker test: the loop would terminate on a value that was written, not on ABSENCE, and
// absence is the half that was broken.
fn mk_tail(v: int) -> any
    let d = {}
    d["v"] = v
    d

fn nxt(node: any) -> any
    node["next"]

// A dict-as-node linked list, i.e. the exact shape of the 11 timeouts. Terminating on
// TRUTHINESS rather than on an explicit null test is the point: that is how the failing
// tests were written, and it is the idiom a falsy nil has to support.
fn chain_len(head: any) -> int
    let n = 0
    let cur = head
    while cur
        n = n + 1
        cur = nxt(cur)
    n

fn main()
    let ok = 0
    let fail = 0

    // ---- 1. a real ZERO is not absence -------------------------------------------
    let z = ident(0)
    if (z == null) == false and z == 0
        ok = ok + 1
    else
        fail = fail + 1
        print("FAIL 1: integer 0 compared equal to null")

    // ---- 2. absence IS null ------------------------------------------------------
    let h = {"a": 1}
    if h["never_set"] == null
        ok = ok + 1
    else
        fail = fail + 1
        print("FAIL 2: a missing dict key did not compare equal to null")

    // and a key that IS present, holding a genuine 0, must NOT read as absent. This is
    // the distinction the old raw-0 convention could not express at all.
    let hz = {"zero": 0}
    if hz["zero"] == 0 and (hz["zero"] == null) == false
        ok = ok + 1
    else
        fail = fail + 1
        print("FAIL 3: a stored 0 was indistinguishable from absence")

    // ---- 3. TRUTHINESS -- the timeout fix ----------------------------------------
    // Three nodes, the last one's "next" never set. If absence is truthy this loop
    // never returns and the test TIMES OUT rather than failing, which is precisely how
    // the original 11 failures presented.
    let n3 = mk_tail(3)
    let n2 = mk_node(2, n3)
    let n1 = mk_node(1, n2)
    if chain_len(n1) == 3
        ok = ok + 1
    else
        fail = fail + 1
        print("FAIL 4: chain_len was " + str(chain_len(n1)) + ", want 3")

    // the direct form of the same thing
    let miss = h["nope"]
    if not miss
        ok = ok + 1
    else
        fail = fail + 1
        print("FAIL 5: absence is truthy -- this is the infinite-loop bug")

    // ---- 4. ARITHMETIC -- absence coerces to zero --------------------------------
    // Without this, a missing key feeds a heap POINTER into the adder. `d["count"] + 1`
    // on an unset counter is the single most common absent-value expression there is.
    if h["count"] + 1 == 1
        ok = ok + 1
    else
        fail = fail + 1
        print("FAIL 6: absent + 1 was " + str(h["count"] + 1) + ", want 1")

    if h["x"] - 5 == -5 and h["x"] * 9 == 0
        ok = ok + 1
    else
        fail = fail + 1
        print("FAIL 7: absent did not coerce to zero under - and *")

    // ---- 5. ORDERING stays total -------------------------------------------------
    if h["q"] < 1 and (h["q"] > 1) == false
        ok = ok + 1
    else
        fail = fail + 1
        print("FAIL 8: absence did not order as zero")

    // ---- 6. an unknown FIELD is absence too --------------------------------------
    // Exercised through the by-name field reader, which is the path an un-inferrable
    // receiver takes.
    let nn = {"only": 7}
    if nn["other"] == null and nn["only"] == 7
        ok = ok + 1
    else
        fail = fail + 1
        print("FAIL 9: unknown key/field absence")

    // ---- 7. rendering ------------------------------------------------------------
    if str(null) == "null"
        ok = ok + 1
    else
        fail = fail + 1
        print("FAIL 10: str(null) was " + str(null) + ", want null")

    // ---- 8. null equals ONLY null ------------------------------------------------
    if null == null and (null == 1) == false and (null == "") == false
        ok = ok + 1
    else
        fail = fail + 1
        print("FAIL 11: null equality is not reflexive-and-exclusive")

    print("NULL_ABSENCE ok=" + str(ok) + " fail=" + str(fail))
    if fail == 0
        print("NULL_ABSENCE PASS")
    else
        print("NULL_ABSENCE FAIL")
