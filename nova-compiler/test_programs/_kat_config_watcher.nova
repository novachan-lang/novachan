import forge_config_watcher

fn main()
    let c = cw_new()
    c = cw_set(c, "db_host", "localhost")
    c = cw_set(c, "db_port", "5432")
    assert(cw_key_count(c) == 2, "2 keys")

    let r1 = cw_get(c, "db_host")
    assert(is_ok(r1), "get ok")
    assert(unwrap(r1) == "localhost", "localhost")

    assert(cw_has(c, "db_host") == 1, "has db_host")
    assert(cw_has(c, "nope") == 0, "no nope")

    c = cw_set(c, "db_host", "prod.db.example.com")
    assert(cw_change_count(c) == 1, "1 change")

    let r2 = cw_get(c, "db_host")
    assert(unwrap(r2) == "prod.db.example.com", "updated")

    c = cw_set(c, "db_host", "prod.db.example.com")
    assert(cw_change_count(c) == 1, "still 1 change (same value)")

    let bad = cw_get(c, "missing")
    assert(is_err(bad), "not found")

    assert(cw_watch_count(c) == 3, "3 watches")

    print("CONFIG-WATCHER KAT PASS")
