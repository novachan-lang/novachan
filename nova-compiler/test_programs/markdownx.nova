fn _md_escape_html(s)
  let out = ""
  let i = 0
  while i < len(s)
    let ch = slice(s, i, i + 1)
    if ch == "<"
      out = out + "&lt;"
    else if ch == ">"
      out = out + "&gt;"
    else if ch == "&"
      out = out + "&amp;"
    else
      out = out + ch
    i = i + 1
  out

fn _md_inline(text)
  let out = ""
  let i = 0
  let n = len(text)
  while i < n
    let ch = slice(text, i, i + 1)
    if ch == "*" and i + 1 < n and slice(text, i + 1, i + 2) == "*"
      let end_pos = i + 2
      while end_pos < n - 1
        if slice(text, end_pos, end_pos + 2) == "**"
          break
        end_pos = end_pos + 1
      if end_pos < n - 1
        let inner = slice(text, i + 2, end_pos)
        out = out + "<strong>" + _md_escape_html(inner) + "</strong>"
        i = end_pos + 2
        continue
    if ch == "*" and i + 1 < n and slice(text, i + 1, i + 2) != "*"
      let end_pos = i + 1
      while end_pos < n
        if slice(text, end_pos, end_pos + 1) == "*"
          break
        end_pos = end_pos + 1
      if end_pos < n
        let inner = slice(text, i + 1, end_pos)
        out = out + "<em>" + _md_escape_html(inner) + "</em>"
        i = end_pos + 1
        continue
    if ch == "`"
      let end_pos = i + 1
      while end_pos < n
        if slice(text, end_pos, end_pos + 1) == "`"
          break
        end_pos = end_pos + 1
      if end_pos < n
        let inner = slice(text, i + 1, end_pos)
        out = out + "<code>" + _md_escape_html(inner) + "</code>"
        i = end_pos + 1
        continue
    out = out + _md_escape_html(ch)
    i = i + 1
  out

fn md_to_html(markdown)
  let lines = split(markdown, "\n")
  let html_parts = []
  let in_list = 0
  for line in lines
    if starts_with(line, "### ")
      if in_list == 1
        push(html_parts, "</ul>")
        in_list = 0
      push(html_parts, "<h3>" + _md_inline(slice(line, 4, len(line))) + "</h3>")
    else if starts_with(line, "## ")
      if in_list == 1
        push(html_parts, "</ul>")
        in_list = 0
      push(html_parts, "<h2>" + _md_inline(slice(line, 3, len(line))) + "</h2>")
    else if starts_with(line, "# ")
      if in_list == 1
        push(html_parts, "</ul>")
        in_list = 0
      push(html_parts, "<h1>" + _md_inline(slice(line, 2, len(line))) + "</h1>")
    else if starts_with(line, "- ") or starts_with(line, "* ")
      if in_list == 0
        push(html_parts, "<ul>")
        in_list = 1
      push(html_parts, "<li>" + _md_inline(slice(line, 2, len(line))) + "</li>")
    else if starts_with(line, "---")
      if in_list == 1
        push(html_parts, "</ul>")
        in_list = 0
      push(html_parts, "<hr>")
    else if len(trim(line)) == 0
      if in_list == 1
        push(html_parts, "</ul>")
        in_list = 0
    else
      if in_list == 1
        push(html_parts, "</ul>")
        in_list = 0
      push(html_parts, "<p>" + _md_inline(line) + "</p>")
  if in_list == 1
    push(html_parts, "</ul>")
  join(html_parts, "\n")

fn main()
  let md1 = "# Hello World"
  assert(md_to_html(md1) == "<h1>Hello World</h1>", "h1")

  let md2 = "## Sub heading"
  assert(md_to_html(md2) == "<h2>Sub heading</h2>", "h2")

  let md3 = "This is **bold** and *italic* text."
  let html3 = md_to_html(md3)
  assert(contains(html3, "<strong>bold</strong>"), "bold")
  assert(contains(html3, "<em>italic</em>"), "italic")

  let md4 = "Use `code` here."
  assert(contains(md_to_html(md4), "<code>code</code>"), "inline code")

  let md5 = "- item 1\n- item 2\n- item 3"
  let html5 = md_to_html(md5)
  assert(contains(html5, "<ul>"), "list open")
  assert(contains(html5, "<li>item 1</li>"), "list item")
  assert(contains(html5, "</ul>"), "list close")

  let md6 = "---"
  assert(md_to_html(md6) == "<hr>", "horizontal rule")

  let md7 = "A & B < C > D"
  assert(contains(md_to_html(md7), "&amp;"), "html escape &")
  assert(contains(md_to_html(md7), "&lt;"), "html escape <")

  print("markdownx: all passed")
