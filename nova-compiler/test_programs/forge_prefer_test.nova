import forge_prefer

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn expect_false(name: string, cond: bool) -> int
    if cond
        print("FAIL " + name + ": expected false")
        return 1
    0

fn main()
    let fails = 0
    let h = "return=minimal, wait=10, respond-async, handling=lenient"

    // get values
    fails = fails + expect("get_return", prefer_get(h, "return", "representation"), "minimal")
    fails = fails + expect("get_handling", prefer_get(h, "handling", "strict"), "lenient")
    fails = fails + expect("get_default", prefer_get(h, "missing", "def"), "def")

    // case-insensitive lookup
    fails = fails + expect("get_ci", prefer_get(h, "RETURN", "x"), "minimal")

    // token presence
    fails = fails + expect_true("has_async", prefer_has(h, "respond-async"))
    fails = fails + expect_true("has_async_ci", prefer_has(h, "Respond-Async"))
    fails = fails + expect_true("has_return", prefer_has(h, "return"))
    fails = fails + expect_false("has_missing", prefer_has(h, "foo"))

    // token-only preference returns "" but IS present
    fails = fails + expect("async_val", prefer_get(h, "respond-async", "MISSING"), "")

    // wait as int
    fails = fails + expect("wait", str(prefer_wait(h)), "10")
    fails = fails + expect("wait_absent", str(prefer_wait("return=minimal")), "-1")

    // quoted value is unquoted
    let hq = "handling=" + chr(34) + "lenient" + chr(34)
    fails = fails + expect("quoted", prefer_get(hq, "handling", "x"), "lenient")

    // empty header
    fails = fails + expect("empty", prefer_get("", "return", "representation"), "representation")

    // Preference-Applied builder
    let applied = {}
    applied["return"] = "minimal"
    fails = fails + expect("applied", preference_applied(applied), "return=minimal")
    let applied2 = {}
    applied2["respond-async"] = ""
    fails = fails + expect("applied_token", preference_applied(applied2), "respond-async")

    if fails == 0
        print("forge_prefer: all passed")
    else
        print("forge_prefer: " + str(fails) + " FAILED")
