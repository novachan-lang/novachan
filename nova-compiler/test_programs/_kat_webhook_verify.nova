// KAT: forge_webhook_verify -- inbound HMAC webhook verification for GitHub/Stripe/Slack.
import forge_webhook_verify

fn main()
    let secret = "whsec_test123"
    let body = "event=payment.succeeded&amount=500&currency=usd"

    // GitHub: X-Hub-Signature-256 = "sha256=<hex>" over the raw body.
    let gh_sig = "sha256=" + hmac_sha256(secret, body)
    assert(github_webhook_verify(secret, body, gh_sig), "github accepts a correctly computed signature")
    assert(not github_webhook_verify(secret, body, "sha256=wrong"), "github rejects a wrong signature")

    // Stripe: Stripe-Signature = "t=<ts>,v1=<hex>", hex over "<ts>.<body>".
    let ts = 1700000000
    let stripe_v1 = hmac_sha256(secret, "{ts}." + body)
    let stripe_header = "t={ts},v1={stripe_v1}"
    assert(stripe_webhook_verify(secret, body, stripe_header, ts, 300), "stripe accepts valid sig within tolerance")
    assert(not stripe_webhook_verify(secret, body, "t={ts},v1=deadbeef", ts, 300), "stripe rejects a wrong v1 signature")
    assert(not stripe_webhook_verify(secret, body, stripe_header, ts + 1000, 60), "stripe rejects a replayed/stale timestamp beyond tolerance")

    // Slack: X-Slack-Signature = "v0=<hex>" over "v0:<timestamp>:<body>".
    let slack_secret = "slack_signing_secret"
    let slack_ts = "1700000000"
    let slack_sig = "v0=" + hmac_sha256(slack_secret, "v0:{slack_ts}:" + body)
    assert(slack_verify(slack_secret, slack_ts, body, slack_sig, 1700000000, 300), "slack accepts valid sig within tolerance")
    assert(not slack_verify(slack_secret, slack_ts, body, "v0=deadbeef", 1700000000, 300), "slack rejects a wrong signature")
    assert(not slack_verify(slack_secret, slack_ts, body, slack_sig, 1700005000, 300), "slack rejects a stale timestamp beyond tolerance")

    print("WEBHOOK-VERIFY KAT PASS")
