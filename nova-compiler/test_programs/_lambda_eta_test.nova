import std/lambda/lambda_eta

// cki: check int equality
fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// ckb: check bool (int) equality
fn ckb(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// term_eq: recursive structural equality of two terms (tagged lists).
fn term_eq(a, b) -> int
    if len(a) != len(b)
        return 0
    if a[0] != b[0]
        return 0
    let tag = a[0]
    if tag == "var"
        if int(a[1]) != int(b[1])
            return 0
        return 1
    if tag == "lam"
        return term_eq(a[1], b[1])
    // "app"
    if term_eq(a[1], b[1]) == 0
        return 0
    return term_eq(a[2], b[2])

// ckt: check term equality
fn ckt(label, a, b)
    if term_eq(a, b) == 0
        print("FAIL " + label + ": terms differ")
        exit(1)

fn main()
    // ── KAT 1: lta_is_eta_redex(["lam",["app",["var",1],["var",0]]]) = true
    // This represents lambda x. (y x) where y is a free variable (index 1 under binder).
    // f = ["var",1]; 0 is not free in ["var",1]; arg = ["var",0].  => valid eta-redex.
    let v1 = lambda_eta.lta_mk_var(1)
    let v0 = lambda_eta.lta_mk_var(0)
    let app1 = lambda_eta.lta_mk_app(v1, v0)
    let lam1 = lambda_eta.lta_mk_lam(app1)
    ckb("eta_redex_true", lambda_eta.lta_is_eta_redex(lam1), 1)

    // ── KAT 2: lta_eta_contract(lam1) == ["var",0]
    // shift(-1, 0, ["var",1]) = ["var",0]  (1 >= 0, so 1 + (-1) = 0)
    let contracted = lambda_eta.lta_eta_contract(lam1)
    let expected_v0 = lambda_eta.lta_mk_var(0)
    ckt("eta_contract_var0", contracted, expected_v0)

    // ── KAT 3: lta_is_eta_redex(["lam",["app",["var",0],["var",0]]]) = false
    // f = ["var",0]; 0 IS free in ["var",0] => NOT a valid eta-redex.
    let v0a = lambda_eta.lta_mk_var(0)
    let v0b = lambda_eta.lta_mk_var(0)
    let app2 = lambda_eta.lta_mk_app(v0a, v0b)
    let lam2 = lambda_eta.lta_mk_lam(app2)
    ckb("eta_redex_false_when_f_uses_binder", lambda_eta.lta_is_eta_redex(lam2), 0)

    // ── KAT 4: reduce inner eta-redex
    // ["lam",["app", ["lam",["app",["var",1],["var",0]]], ["var",0]]]
    // The inner lambda is an eta-redex: contracts to ["var",0].
    // After reduction: ["lam",["app",["var",0],["var",0]]].
    let inner_v1 = lambda_eta.lta_mk_var(1)
    let inner_v0 = lambda_eta.lta_mk_var(0)
    let inner_app = lambda_eta.lta_mk_app(inner_v1, inner_v0)
    let inner_lam = lambda_eta.lta_mk_lam(inner_app)
    let outer_v0 = lambda_eta.lta_mk_var(0)
    let outer_app = lambda_eta.lta_mk_app(inner_lam, outer_v0)
    let outer_lam = lambda_eta.lta_mk_lam(outer_app)
    let result = lambda_eta.lta_eta_reduce(outer_lam, 100)
    // expected: ["lam",["app",["var",0],["var",0]]]
    let ev0a = lambda_eta.lta_mk_var(0)
    let ev0b = lambda_eta.lta_mk_var(0)
    let exp_app = lambda_eta.lta_mk_app(ev0a, ev0b)
    let exp = lambda_eta.lta_mk_lam(exp_app)
    ckt("eta_reduce_inner", result, exp)

    // ── KAT 5: lta_eta_normal on a normal-form term (no eta-redex)
    let plain_var = lambda_eta.lta_mk_var(2)
    ckb("eta_normal_var", lambda_eta.lta_eta_normal(plain_var), 1)

    // ── KAT 6: lta_eta_normal on an eta-redex = false
    let fv = lambda_eta.lta_mk_var(1)
    let av = lambda_eta.lta_mk_var(0)
    let eth_app = lambda_eta.lta_mk_app(fv, av)
    let eth_lam = lambda_eta.lta_mk_lam(eth_app)
    ckb("eta_normal_redex_false", lambda_eta.lta_eta_normal(eth_lam), 0)

    print("PASS _lambda_eta_test")
