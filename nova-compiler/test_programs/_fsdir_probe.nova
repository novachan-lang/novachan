// Round-trip probe for the filesystem builtins: the two NEW ones (make_dir, file_chmod) exercised
// alongside the pre-existing dir ops (is_dir, list_dir, rename_path, remove_dir) to prove the deduped
// runtime + new registrations are all wired correctly. Self-contained; no imports.
fn main()
    let base = "_fsprobe_dir"
    // clean slate (best-effort; ignore status)
    remove_file(base + "/a.txt")
    remove_file(base + "/b.txt")
    remove_dir(base)

    if not make_dir(base)
        print("FAIL make_dir")
        exit(1)
    if not is_dir(base)
        print("FAIL is_dir after make_dir")
        exit(1)
    // make_dir on an existing dir must be idempotent (returns true, not an error)
    if not make_dir(base)
        print("FAIL make_dir idempotent")
        exit(1)

    write_file(base + "/a.txt", "hello")
    let entries = list_dir(base)
    if len(entries) != 1
        print("FAIL list_dir count " + str(len(entries)))
        exit(1)
    if entries[0] != "a.txt"
        print("FAIL list_dir entry: " + entries[0])
        exit(1)

    // chmod 0644 — sets owner-write, so returns true on both POSIX and Windows
    if not file_chmod(base + "/a.txt", 420)
        print("FAIL file_chmod")
        exit(1)

    rename_path(base + "/a.txt", base + "/b.txt")
    if not is_file(base + "/b.txt")
        print("FAIL rename_path (b.txt missing)")
        exit(1)
    if is_file(base + "/a.txt")
        print("FAIL rename_path (a.txt still present)")
        exit(1)

    remove_file(base + "/b.txt")
    remove_dir(base)
    if is_dir(base)
        print("FAIL remove_dir")
        exit(1)

    print("ok fsdir probe: make_dir + file_chmod + is_dir/list_dir/rename_path/remove_dir all correct")
