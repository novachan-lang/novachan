import std/interval/interval_map

// Helper: compare two string lists for equality
fn str_list_eq(a, b)
    if len(a) != len(b)
        return 0
    let i = 0
    while i < len(a)
        let ii = i
        if a[ii] != b[ii]
            return 0
        i = i + 1
    return 1

fn main()
    // Build: imap_put(imap_put(imap_new(),1,5,'a'),3,7,'b')
    let m = imap_put(imap_put(imap_new(), 1, 5, "a"), 3, 7, "b")

    // KAT 1: imap_get(m, 4) == ['a','b'] (4 in both [1,5] and [3,7])
    let r1 = imap_get(m, 4)
    let want1 = ["a", "b"]
    if str_list_eq(r1, want1) != 1
        print("FAIL imap_get_1: got len=" + str(len(r1)))
        exit(1)

    // KAT 2: imap_get(m, 2) == ['a'] (2 only in [1,5])
    let r2 = imap_get(m, 2)
    let want2 = ["a"]
    if str_list_eq(r2, want2) != 1
        print("FAIL imap_get_2: got len=" + str(len(r2)))
        exit(1)

    // KAT 3: imap_get(m, 6) == ['b'] (6 only in [3,7])
    let r3 = imap_get(m, 6)
    let want3 = ["b"]
    if str_list_eq(r3, want3) != 1
        print("FAIL imap_get_3: got len=" + str(len(r3)))
        exit(1)

    // KAT 4: imap_get(m, 9) == [] (9 not in any interval)
    let r4 = imap_get(m, 9)
    if len(r4) != 0
        print("FAIL imap_get_4: got len=" + str(len(r4)) + " want=0")
        exit(1)

    // KAT 5: imap_contains(m, 4) == true (1)
    let r5 = imap_contains(m, 4)
    if r5 != 1
        print("FAIL imap_contains_5: got=" + str(r5) + " want=1")
        exit(1)

    // KAT 6: imap_contains(m, 9) == false (0)
    let r6 = imap_contains(m, 9)
    if r6 != 0
        print("FAIL imap_contains_6: got=" + str(r6) + " want=0")
        exit(1)

    // KAT 7: imap_size(m) == 2
    let r7 = imap_size(m)
    if r7 != 2
        print("FAIL imap_size_7: got=" + str(r7) + " want=2")
        exit(1)

    // KAT 8: imap_values_in(m, 6, 8) == ['b'] (only [3,7] overlaps [6,8])
    let r8 = imap_values_in(m, 6, 8)
    let want8 = ["b"]
    if str_list_eq(r8, want8) != 1
        print("FAIL imap_values_in_8: got len=" + str(len(r8)))
        exit(1)

    // KAT 9: imap_keys returns list of [lo,hi] pairs
    let r9 = imap_keys(m)
    if len(r9) != 2
        print("FAIL imap_keys_9: got len=" + str(len(r9)) + " want=2")
        exit(1)
    let k0 = r9[0]
    let k1 = r9[1]
    if k0[0] != 1 or k0[1] != 5
        print("FAIL imap_keys_9_k0: " + str(k0[0]) + "," + str(k0[1]))
        exit(1)
    if k1[0] != 3 or k1[1] != 7
        print("FAIL imap_keys_9_k1: " + str(k1[0]) + "," + str(k1[1]))
        exit(1)

    // KAT 10: imap_get_first returns first covering value
    let rf = imap_get_first(m, 4)
    if rf != "a"
        print("FAIL imap_get_first_10: got=" + str(rf) + " want=a")
        exit(1)

    // KAT 11: imap_get_first returns null when no interval contains x
    let rf2 = imap_get_first(m, 9)
    if rf2 != null
        print("FAIL imap_get_first_11: got non-null want=null")
        exit(1)

    // KAT 12: imap_covering returns entries (3-element lists)
    let rc = imap_covering(m, 4)
    if len(rc) != 2
        print("FAIL imap_covering_12: got len=" + str(len(rc)) + " want=2")
        exit(1)
    let ce0 = rc[0]
    let ce1 = rc[1]
    if ce0[0] != 1 or ce0[1] != 5 or ce0[2] != "a"
        print("FAIL imap_covering_12_e0")
        exit(1)
    if ce1[0] != 3 or ce1[1] != 7 or ce1[2] != "b"
        print("FAIL imap_covering_12_e1")
        exit(1)

    // KAT 13: imap_remove_range removes entries fully contained in [1,5]
    // [1,5] is fully in [1,5]; [3,7] is NOT (7 > 5) -> only [1,5]->'a' removed
    let m2 = imap_remove_range(m, 1, 5)
    if imap_size(m2) != 1
        print("FAIL imap_remove_range_13: size=" + str(imap_size(m2)) + " want=1")
        exit(1)
    let rv = imap_get(m2, 6)
    if len(rv) != 1 or rv[0] != "b"
        print("FAIL imap_remove_range_13_val")
        exit(1)

    // KAT 14: imap_values_in covers boundary overlap (point of contact)
    // [1,5] and [6,8] share no point; [3,7] and [6,8] overlap at [6,7]
    let rvi2 = imap_values_in(m, 5, 5)
    // 5 in [1,5]: yes; 5 in [3,7]: yes (3<=5<=7)
    if len(rvi2) != 2
        print("FAIL imap_values_in_14: got len=" + str(len(rvi2)) + " want=2")
        exit(1)

    // KAT 15: empty map
    let em = imap_new()
    if imap_size(em) != 0
        print("FAIL imap_empty_size")
        exit(1)
    let eg = imap_get(em, 5)
    if len(eg) != 0
        print("FAIL imap_empty_get")
        exit(1)
    if imap_contains(em, 5) != 0
        print("FAIL imap_empty_contains")
        exit(1)

    print("PASS _interval_map_test")

main()
