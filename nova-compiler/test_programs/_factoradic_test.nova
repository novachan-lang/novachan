import std/numeral/factoradic

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL factoradic " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL factoradic " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// Join a list of ints as "a,b,c" for comparison.
fn ckl(label: string, got: list, want: list)
    let ng = len(got)
    let nw = len(want)
    if ng != nw
        let msg = "len " + str(ng) + " vs " + str(nw)
        print("FAIL factoradic " + label + ": " + msg)
        exit(1)
    let i = 0
    while i < ng
        if got[i] != want[i]
            let msg = "at[" + str(i) + "] got=" + str(got[i]) + " want=" + str(want[i])
            print("FAIL factoradic " + label + ": " + msg)
            exit(1)
        i = i + 1

fn main()
    // fac_to_factoradic KAT
    ckl("to_fac(463)", fac_to_factoradic(463), [3,4,1,0,1,0])
    ckl("to_fac(0)",   fac_to_factoradic(0),   [0])
    ckl("to_fac(1)",   fac_to_factoradic(1),   [1,0])
    ckl("to_fac(2)",   fac_to_factoradic(2),   [1,0,0])
    ckl("to_fac(6)",   fac_to_factoradic(6),   [1,0,0,0])
    ckl("to_fac(10)",  fac_to_factoradic(10),  [1,2,0,0])
    // 10: div by 1->0 rem, 10/1=10; div by 2->0 rem, 10/2=5; div by 3->2 rem, 5/3=1; div by 4->1 rem, 1/4=0
    // digits low-to-high = [0,0,2,1] -> reversed high-to-low = [1,2,0,0]
    // check: 1*3! + 2*2! + 0*1! + 0*0! = 6+4+0+0 = 10 ✓

    // fac_from_factoradic KAT
    cki("from_fac([3,4,1,0,1,0])", fac_from_factoradic([3,4,1,0,1,0]), 463)
    cki("from_fac([0])",           fac_from_factoradic([0]),           0)
    cki("from_fac([1,0])",         fac_from_factoradic([1,0]),         1)
    cki("from_fac([1,2,0,0])",     fac_from_factoradic([1,2,0,0]),     10)

    // Round-trip fac_from_factoradic(fac_to_factoradic(n)) == n
    cki("rt(0)",    fac_from_factoradic(fac_to_factoradic(0)),    0)
    cki("rt(1)",    fac_from_factoradic(fac_to_factoradic(1)),    1)
    cki("rt(463)",  fac_from_factoradic(fac_to_factoradic(463)),  463)
    cki("rt(2024)", fac_from_factoradic(fac_to_factoradic(2024)), 2024)
    cki("rt(720)",  fac_from_factoradic(fac_to_factoradic(720)),  720)
    cki("rt(5039)", fac_from_factoradic(fac_to_factoradic(5039)), 5039)

    // fac_to_permutation KAT
    ckl("perm(0,3)", fac_to_permutation(0,3), [0,1,2])
    ckl("perm(5,3)", fac_to_permutation(5,3), [2,1,0])
    ckl("perm(1,3)", fac_to_permutation(1,3), [0,2,1])
    ckl("perm(2,3)", fac_to_permutation(2,3), [1,0,2])
    ckl("perm(3,3)", fac_to_permutation(3,3), [1,2,0])
    ckl("perm(4,3)", fac_to_permutation(4,3), [2,0,1])
    ckl("perm(0,1)", fac_to_permutation(0,1), [0])
    ckl("perm(0,4)", fac_to_permutation(0,4), [0,1,2,3])
    ckl("perm(23,4)", fac_to_permutation(23,4), [3,2,1,0])

    // fac_permutation_rank KAT
    cki("rank([0,1,2])", fac_permutation_rank([0,1,2]), 0)
    cki("rank([2,1,0])", fac_permutation_rank([2,1,0]), 5)
    cki("rank([0,2,1])", fac_permutation_rank([0,2,1]), 1)
    cki("rank([1,0,2])", fac_permutation_rank([1,0,2]), 2)
    cki("rank([1,2,0])", fac_permutation_rank([1,2,0]), 3)
    cki("rank([2,0,1])", fac_permutation_rank([2,0,1]), 4)
    cki("rank([0])",     fac_permutation_rank([0]),     0)
    cki("rank([3,2,1,0])", fac_permutation_rank([3,2,1,0]), 23)

    // Round-trip: rank(perm(i,3)) == i for all 6 permutations of size 3
    let k = 0
    while k < 6
        let p = fac_to_permutation(k, 3)
        let r = fac_permutation_rank(p)
        if r != k
            print("FAIL factoradic roundtrip3[" + str(k) + "]: got=" + str(r) + " want=" + str(k))
            exit(1)
        k = k + 1

    // Round-trip: rank(perm(i,4)) == i for all 24 permutations of size 4
    let j = 0
    while j < 24
        let p4 = fac_to_permutation(j, 4)
        let r4 = fac_permutation_rank(p4)
        if r4 != j
            print("FAIL factoradic roundtrip4[" + str(j) + "]: got=" + str(r4) + " want=" + str(j))
            exit(1)
        j = j + 1

    print("PASS _factoradic_test")
