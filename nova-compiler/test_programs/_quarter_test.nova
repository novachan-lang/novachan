import std/time/quarter

fn main()
    // ── quarter_of ────────────────────────────────────────────────────────────
    let got1 = quarter_of(5)
    if got1 != 2
        print("FAIL quarter _quarter_test quarter_of(5): got "+str(got1)+" want 2")
        exit(1)

    let got2 = quarter_of(1)
    if got2 != 1
        print("FAIL quarter _quarter_test quarter_of(1): got "+str(got2)+" want 1")
        exit(1)

    let got3 = quarter_of(12)
    if got3 != 4
        print("FAIL quarter _quarter_test quarter_of(12): got "+str(got3)+" want 4")
        exit(1)

    // All 12 months exhaustively
    let got4 = quarter_of(3)
    if got4 != 1
        print("FAIL quarter _quarter_test quarter_of(3): got "+str(got4)+" want 1")
        exit(1)

    let got5 = quarter_of(4)
    if got5 != 2
        print("FAIL quarter _quarter_test quarter_of(4): got "+str(got5)+" want 2")
        exit(1)

    let got6 = quarter_of(6)
    if got6 != 2
        print("FAIL quarter _quarter_test quarter_of(6): got "+str(got6)+" want 2")
        exit(1)

    let got7 = quarter_of(7)
    if got7 != 3
        print("FAIL quarter _quarter_test quarter_of(7): got "+str(got7)+" want 3")
        exit(1)

    let got8 = quarter_of(9)
    if got8 != 3
        print("FAIL quarter _quarter_test quarter_of(9): got "+str(got8)+" want 3")
        exit(1)

    let got9 = quarter_of(10)
    if got9 != 4
        print("FAIL quarter _quarter_test quarter_of(10): got "+str(got9)+" want 4")
        exit(1)

    // ── quarter_start ─────────────────────────────────────────────────────────
    let qs24_2 = quarter_start(2024, 2)
    let qs24_2_y = qs24_2[0]
    let qs24_2_m = qs24_2[1]
    let qs24_2_d = qs24_2[2]
    if qs24_2_y != 2024
        print("FAIL quarter _quarter_test quarter_start(2024,2) year: got "+str(qs24_2_y)+" want 2024")
        exit(1)
    if qs24_2_m != 4
        print("FAIL quarter _quarter_test quarter_start(2024,2) month: got "+str(qs24_2_m)+" want 4")
        exit(1)
    if qs24_2_d != 1
        print("FAIL quarter _quarter_test quarter_start(2024,2) day: got "+str(qs24_2_d)+" want 1")
        exit(1)

    // quarter_start Q1 always Jan 1
    let qs24_1 = quarter_start(2024, 1)
    if qs24_1[1] != 1
        print("FAIL quarter _quarter_test quarter_start(2024,1) month: got "+str(qs24_1[1])+" want 1")
        exit(1)
    if qs24_1[2] != 1
        print("FAIL quarter _quarter_test quarter_start(2024,1) day: got "+str(qs24_1[2])+" want 1")
        exit(1)

    // quarter_start Q3
    let qs24_3 = quarter_start(2024, 3)
    if qs24_3[1] != 7
        print("FAIL quarter _quarter_test quarter_start(2024,3) month: got "+str(qs24_3[1])+" want 7")
        exit(1)

    // quarter_start Q4
    let qs24_4 = quarter_start(2024, 4)
    if qs24_4[1] != 10
        print("FAIL quarter _quarter_test quarter_start(2024,4) month: got "+str(qs24_4[1])+" want 10")
        exit(1)

    // ── quarter_end ───────────────────────────────────────────────────────────
    let qe24_1 = quarter_end(2024, 1)
    if qe24_1[0] != 2024
        print("FAIL quarter _quarter_test quarter_end(2024,1) year: got "+str(qe24_1[0])+" want 2024")
        exit(1)
    if qe24_1[1] != 3
        print("FAIL quarter _quarter_test quarter_end(2024,1) month: got "+str(qe24_1[1])+" want 3")
        exit(1)
    if qe24_1[2] != 31
        print("FAIL quarter _quarter_test quarter_end(2024,1) day: got "+str(qe24_1[2])+" want 31")
        exit(1)

    let qe24_4 = quarter_end(2024, 4)
    if qe24_4[1] != 12
        print("FAIL quarter _quarter_test quarter_end(2024,4) month: got "+str(qe24_4[1])+" want 12")
        exit(1)
    if qe24_4[2] != 31
        print("FAIL quarter _quarter_test quarter_end(2024,4) day: got "+str(qe24_4[2])+" want 31")
        exit(1)

    // Q2 ends June 30
    let qe24_2 = quarter_end(2024, 2)
    if qe24_2[1] != 6
        print("FAIL quarter _quarter_test quarter_end(2024,2) month: got "+str(qe24_2[1])+" want 6")
        exit(1)
    if qe24_2[2] != 30
        print("FAIL quarter _quarter_test quarter_end(2024,2) day: got "+str(qe24_2[2])+" want 30")
        exit(1)

    // Q3 ends Sep 30
    let qe24_3 = quarter_end(2024, 3)
    if qe24_3[1] != 9
        print("FAIL quarter _quarter_test quarter_end(2024,3) month: got "+str(qe24_3[1])+" want 9")
        exit(1)
    if qe24_3[2] != 30
        print("FAIL quarter _quarter_test quarter_end(2024,3) day: got "+str(qe24_3[2])+" want 30")
        exit(1)

    // Leap year: Q1 2024 ends Mar 31 (same as non-leap; leap affects Feb only in Q1 start)
    // Q1 2024 quarter_end day still 31 (March 31) — already checked above.

    // ── quarter_of_date ───────────────────────────────────────────────────────
    let qod = quarter_of_date(2024, 8, 15)
    if qod != 3
        print("FAIL quarter _quarter_test quarter_of_date(2024,8,15): got "+str(qod)+" want 3")
        exit(1)

    let qod2 = quarter_of_date(2024, 1, 1)
    if qod2 != 1
        print("FAIL quarter _quarter_test quarter_of_date(2024,1,1): got "+str(qod2)+" want 1")
        exit(1)

    let qod3 = quarter_of_date(2024, 12, 31)
    if qod3 != 4
        print("FAIL quarter _quarter_test quarter_of_date(2024,12,31): got "+str(qod3)+" want 4")
        exit(1)

    // ── fiscal_quarter ────────────────────────────────────────────────────────
    // fiscal_start_month=4 (April): Q1=Apr-Jun, Q2=Jul-Sep, Q3=Oct-Dec, Q4=Jan-Mar
    let fq1 = fiscal_quarter(4, 4)
    if fq1 != 1
        print("FAIL quarter _quarter_test fiscal_quarter(4,4): got "+str(fq1)+" want 1")
        exit(1)

    let fq2 = fiscal_quarter(3, 4)
    if fq2 != 4
        print("FAIL quarter _quarter_test fiscal_quarter(3,4): got "+str(fq2)+" want 4")
        exit(1)

    // More fiscal vectors with start=April
    let fq3 = fiscal_quarter(7, 4)
    if fq3 != 2
        print("FAIL quarter _quarter_test fiscal_quarter(7,4): got "+str(fq3)+" want 2")
        exit(1)

    let fq4 = fiscal_quarter(10, 4)
    if fq4 != 3
        print("FAIL quarter _quarter_test fiscal_quarter(10,4): got "+str(fq4)+" want 3")
        exit(1)

    let fq5 = fiscal_quarter(1, 4)
    if fq5 != 4
        print("FAIL quarter _quarter_test fiscal_quarter(1,4): got "+str(fq5)+" want 4")
        exit(1)

    // fiscal_start_month=1 (January) = same as calendar quarter
    let fq6 = fiscal_quarter(5, 1)
    if fq6 != 2
        print("FAIL quarter _quarter_test fiscal_quarter(5,1): got "+str(fq6)+" want 2")
        exit(1)

    let fq7 = fiscal_quarter(10, 1)
    if fq7 != 4
        print("FAIL quarter _quarter_test fiscal_quarter(10,1): got "+str(fq7)+" want 4")
        exit(1)

    // fiscal_start_month=7 (July): Q1=Jul-Sep, Q2=Oct-Dec, Q3=Jan-Mar, Q4=Apr-Jun
    let fq8 = fiscal_quarter(7, 7)
    if fq8 != 1
        print("FAIL quarter _quarter_test fiscal_quarter(7,7): got "+str(fq8)+" want 1")
        exit(1)

    let fq9 = fiscal_quarter(4, 7)
    if fq9 != 4
        print("FAIL quarter _quarter_test fiscal_quarter(4,7): got "+str(fq9)+" want 4")
        exit(1)

    // ── Round-trip: quarter_start -> quarter_of_date -> same quarter ──────────
    let rs1 = quarter_start(2024, 3)
    let ry1 = rs1[0]
    let rm1 = rs1[1]
    let rd1 = rs1[2]
    let rq1 = quarter_of_date(ry1, rm1, rd1)
    if rq1 != 3
        print("FAIL quarter _quarter_test round-trip start(2024,3): got "+str(rq1)+" want 3")
        exit(1)

    let re1 = quarter_end(2024, 3)
    let rey1 = re1[0]
    let rem1 = re1[1]
    let red1 = re1[2]
    let req1 = quarter_of_date(rey1, rem1, red1)
    if req1 != 3
        print("FAIL quarter _quarter_test round-trip end(2024,3): got "+str(req1)+" want 3")
        exit(1)

    print("PASS _quarter_test")
