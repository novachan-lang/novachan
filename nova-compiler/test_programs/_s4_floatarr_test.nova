// S4.2 kind=2 raw-double float-array guard: exercises every kind=2 path + the deopt fallbacks,
// asserting correctness. Build via append (append_fraw -> kind=2), index read (get_f), sum/min/max
// (kind=2-aware), for-in (deopt), to_str/eq (kind=2), sort (deopt), read-only escape (tainted ->
// generic), and a heterogeneous append (runtime deopt). All must be correct.

fn fsum(lst)
    let s = 0.0
    let i = 0
    while i < len(lst)
        s = s + lst[i]
        i = i + 1
    s

fn main()
    // append-built float list -> kind=2 raw storage
    let xs = []
    let i = 0
    while i < 100
        push(xs, 1.0 * i)
        i = i + 1
    assert(xs[0] == 0.0, "fa: head")
    assert(xs[99] == 99.0, "fa: tail")

    // index-loop sum (kind=2 get_f fast read) -- sum 0..99 = 4950
    let s = 0.0
    let j = 0
    while j < len(xs)
        s = s + xs[j]
        j = j + 1
    assert(s == 4950.0, "fa: index-sum")

    // builtins on a kind=2 list (kind=2-aware sum_f / min_f / max_f)
    assert(sum(xs) == 4950.0, "fa: sum builtin")
    assert(list_min(xs) == 0.0, "fa: min")
    assert(list_max(xs) == 99.0, "fa: max")

    // for-in (deopts the list, must still total correctly)
    let s2 = 0.0
    for v in xs
        s2 = s2 + v
    assert(s2 == 4950.0, "fa: for-in sum")

    // to_str (kind=2-aware) + eq (numeric)
    let a = []
    push(a, 1.5)
    push(a, 2.5)
    print("fa_str=" + str(a))
    let b = []
    push(b, 1.5)
    push(b, 2.5)
    assert(a == b, "fa: eq")

    // sort (deopts) on a fresh float list
    let u = []
    push(u, 3.0)
    push(u, 1.0)
    push(u, 2.0)
    let srt = sort(u)
    assert(srt[0] == 1.0, "fa: sort head")
    assert(srt[2] == 3.0, "fa: sort tail")

    // read-only escape to a function (tainted -> generic path, still correct)
    let e = []
    push(e, 10.0)
    push(e, 20.0)
    assert(fsum(e) == 30.0, "fa: escape-read sum")

    // heterogeneous append after floats -> runtime deopt -> still correct
    let h = []
    push(h, 1.0)
    push(h, 2.0)
    push(h, "tail")
    assert(h[0] == 1.0, "fa: deopt float head")
    assert(h[2] == "tail", "fa: deopt string elem")

    print("S4_FLOATARR_OK")
