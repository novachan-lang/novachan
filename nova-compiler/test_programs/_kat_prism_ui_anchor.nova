import prism_ui_anchor
import prism_node

fn main()
    let mut pass = 0
    let mut fail = 0

    // --- ctor + accessors ---
    let a1 = prism_ui_anchor.prism_an_anchor("Home", "https://example.com/")
    if prism_ui_anchor.prism_an_label(a1) == "Home"
        pass += 1
    else
        fail += 1
        print("FAIL: ctor label")

    if prism_ui_anchor.prism_an_url(a1) == "https://example.com/"
        pass += 1
    else
        fail += 1
        print("FAIL: ctor url")

    let a2 = prism_ui_anchor.prism_an_anchor("Docs", "https://example.com/docs")
    if prism_ui_anchor.prism_an_label(a2) == "Docs"
        pass += 1
    else
        fail += 1
        print("FAIL: ctor2 label")

    if prism_ui_anchor.prism_an_url(a2) == "https://example.com/docs"
        pass += 1
    else
        fail += 1
        print("FAIL: ctor2 url")

    let a3 = prism_ui_anchor.prism_an_anchor("About", "https://example.com/about")

    if type_name(a1) == "PrismAnchor"
        pass += 1
    else
        fail += 1
        print("FAIL: type_name")

    // --- render happy path ---
    let r1 = prism_ui_anchor.prism_an_render(a1)
    if is_ok(r1)
        pass += 1
    else
        fail += 1
        print("FAIL: render happy is_ok")

    let n1 = unwrap(r1)
    if prism_node.prism_node_kind_str(n1) == "link"
        pass += 1
    else
        fail += 1
        print("FAIL: render happy kind = " + prism_node.prism_node_kind_str(n1))

    if prism_node.prism_node_attr_str(n1, "href", "") == "https://example.com/"
        pass += 1
    else
        fail += 1
        print("FAIL: render happy href")

    let children1 = prism_node.prism_node_children(n1)
    if len(children1) == 0
        pass += 1
    else
        fail += 1
        print("FAIL: render happy children count (link is a leaf node)")

    if prism_node.prism_node_attr_str(n1, "text", "") == "Home"
        pass += 1
    else
        fail += 1
        print("FAIL: render happy text attr")

    // --- render error: empty label ---
    let bad_label = prism_ui_anchor.prism_an_anchor("", "https://example.com/")
    let r2 = prism_ui_anchor.prism_an_render(bad_label)
    if is_err(r2)
        pass += 1
    else
        fail += 1
        print("FAIL: render empty label should be err")

    if unwrap_err(r2) == "prism_an_render: label must not be empty"
        pass += 1
    else
        fail += 1
        print("FAIL: render empty label message = " + unwrap_err(r2))

    // --- render error: empty url ---
    let bad_url = prism_ui_anchor.prism_an_anchor("Home", "")
    let r3 = prism_ui_anchor.prism_an_render(bad_url)
    if is_err(r3)
        pass += 1
    else
        fail += 1
        print("FAIL: render empty url should be err")

    if unwrap_err(r3) == "prism_an_render: url must not be empty"
        pass += 1
    else
        fail += 1
        print("FAIL: render empty url message = " + unwrap_err(r3))

    // --- list happy path ---
    let list_items = [a1, a2, a3]
    let r4 = prism_ui_anchor.prism_an_list(list_items)
    if is_ok(r4)
        pass += 1
    else
        fail += 1
        print("FAIL: list happy is_ok")

    let n4 = unwrap(r4)
    if prism_node.prism_node_kind_str(n4) == "stack"
        pass += 1
    else
        fail += 1
        print("FAIL: list happy kind = " + prism_node.prism_node_kind_str(n4))

    let children4 = prism_node.prism_node_children(n4)
    if len(children4) == 3
        pass += 1
    else
        fail += 1
        print("FAIL: list happy children count")

    // --- list error: empty list ---
    let empty_list = []
    let r5 = prism_ui_anchor.prism_an_list(empty_list)
    if is_err(r5)
        pass += 1
    else
        fail += 1
        print("FAIL: list empty should be err")

    if unwrap_err(r5) == "prism_an_list: anchors list must not be empty"
        pass += 1
    else
        fail += 1
        print("FAIL: list empty message = " + unwrap_err(r5))

    // --- list error: wrong type ---
    let mixed_list = [a1, "not an anchor", a2]
    let r6 = prism_ui_anchor.prism_an_list(mixed_list)
    if is_err(r6)
        pass += 1
    else
        fail += 1
        print("FAIL: list wrong type should be err")

    if unwrap_err(r6) == "prism_an_list: element 1 is not a PrismAnchor (got string)"
        pass += 1
    else
        fail += 1
        print("FAIL: list wrong type message = " + unwrap_err(r6))

    // --- inline with separator ---
    let r7 = prism_ui_anchor.prism_an_inline(list_items, " | ")
    if is_ok(r7)
        pass += 1
    else
        fail += 1
        print("FAIL: inline sep is_ok")

    let n7 = unwrap(r7)
    if prism_node.prism_node_kind_str(n7) == "band"
        pass += 1
    else
        fail += 1
        print("FAIL: inline sep kind = " + prism_node.prism_node_kind_str(n7))

    let children7 = prism_node.prism_node_children(n7)
    // 3 anchors + 2 separators = 5
    if len(children7) == 5
        pass += 1
    else
        fail += 1
        print("FAIL: inline sep children count = " + str(len(children7)))

    // --- inline without separator ---
    let r8 = prism_ui_anchor.prism_an_inline(list_items, "")
    if is_ok(r8)
        pass += 1
    else
        fail += 1
        print("FAIL: inline no sep is_ok")

    let n8 = unwrap(r8)
    let children8 = prism_node.prism_node_children(n8)
    // 3 anchors, no separators
    if len(children8) == 3
        pass += 1
    else
        fail += 1
        print("FAIL: inline no sep children count = " + str(len(children8)))

    // --- inline error: empty list ---
    let r9 = prism_ui_anchor.prism_an_inline(empty_list, " | ")
    if is_err(r9)
        pass += 1
    else
        fail += 1
        print("FAIL: inline empty should be err")

    // --- inline error: wrong type ---
    let r10 = prism_ui_anchor.prism_an_inline(mixed_list, " | ")
    if is_err(r10)
        pass += 1
    else
        fail += 1
        print("FAIL: inline wrong type should be err")

    // --- breadcrumb ---
    let r11 = prism_ui_anchor.prism_an_breadcrumb(list_items)
    if is_ok(r11)
        pass += 1
    else
        fail += 1
        print("FAIL: breadcrumb is_ok")

    let n11 = unwrap(r11)
    if prism_node.prism_node_kind_str(n11) == "band"
        pass += 1
    else
        fail += 1
        print("FAIL: breadcrumb kind = " + prism_node.prism_node_kind_str(n11))

    let children11 = prism_node.prism_node_children(n11)
    // 3 anchors + 2 " > " separators = 5
    if len(children11) == 5
        pass += 1
    else
        fail += 1
        print("FAIL: breadcrumb children count = " + str(len(children11)))

    // --- breadcrumb error: empty list ---
    let r12 = prism_ui_anchor.prism_an_breadcrumb(empty_list)
    if is_err(r12)
        pass += 1
    else
        fail += 1
        print("FAIL: breadcrumb empty should be err")

    if unwrap_err(r12) == "prism_an_inline: anchors list must not be empty"
        pass += 1
    else
        fail += 1
        print("FAIL: breadcrumb empty message = " + unwrap_err(r12))

    print("prism_ui_anchor KAT: " + str(pass) + " passed, " + str(fail) + " failed")
