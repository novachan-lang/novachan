import std/finance/bond_yield

fn approx(a: float, b: float, tol: float) -> float
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < tol
        return 1.0
    return 0.0

fn main()
    // KAT 1: current_yield at par — 50/1000 == 0.05
    let cy1 = current_yield(50.0, 1000.0)
    let ok1 = approx(cy1, 0.05, 0.0001)
    if ok1 == 0.0
        print("FAIL bond_yield current_yield_par: got=" + str(cy1))
        exit(1)

    // KAT 2: current_yield at discount — 50/950 == 0.052631...
    let cy2 = current_yield(50.0, 950.0)
    let ok2 = approx(cy2, 0.05263, 0.0001)
    if ok2 == 0.0
        print("FAIL bond_yield current_yield_discount: got=" + str(cy2))
        exit(1)

    // KAT 3: current_yield premium bond — 60/1077.22 == 0.0557
    let cy3 = current_yield(60.0, 1077.22)
    let ok3 = approx(cy3, 0.0557, 0.0001)
    if ok3 == 0.0
        print("FAIL bond_yield current_yield_premium: got=" + str(cy3))
        exit(1)

    // KAT 4: current_yield zero guard — should return 0.0 when price==0
    let cy4 = current_yield(50.0, 0.0)
    let ok4 = approx(cy4, 0.0, 0.0001)
    if ok4 == 0.0
        print("FAIL bond_yield current_yield_zero_price: got=" + str(cy4))
        exit(1)

    // KAT 5: approximate_ytm of par bond == coupon rate
    // approximate_ytm(1000.0, 0.05, 1000.0, 10)
    // C=50, (F-P)/n=0, num=50, denom=1000 => YTM=0.05
    let ytm5 = approximate_ytm(1000.0, 0.05, 1000.0, 10)
    let ok5 = approx(ytm5, 0.05, 0.0001)
    if ok5 == 0.0
        print("FAIL bond_yield approx_ytm_par: got=" + str(ytm5))
        exit(1)

    // KAT 6: approximate_ytm of discount bond > coupon rate
    // approximate_ytm(1000.0, 0.05, 900.0, 10)
    // C=50, gain=(1000-900)/10=10, num=60, denom=(1000+900)/2=950 => YTM=60/950=0.06316
    let ytm6 = approximate_ytm(1000.0, 0.05, 900.0, 10)
    if ytm6 <= 0.05
        print("FAIL bond_yield approx_ytm_discount not above coupon: got=" + str(ytm6))
        exit(1)
    let ok6 = approx(ytm6, 0.06316, 0.001)
    if ok6 == 0.0
        print("FAIL bond_yield approx_ytm_discount value: got=" + str(ytm6))
        exit(1)

    // KAT 7: approximate_ytm of premium bond < coupon rate
    // approximate_ytm(1000.0, 0.06, 1077.22, 10)
    // C=60, gain=(1000-1077.22)/10=-7.722, num=52.278, denom=1038.61 => ~0.05034
    let ytm7 = approximate_ytm(1000.0, 0.06, 1077.22, 10)
    if ytm7 >= 0.06
        print("FAIL bond_yield approx_ytm_premium not below coupon: got=" + str(ytm7))
        exit(1)
    let ok7 = approx(ytm7, 0.0503, 0.002)
    if ok7 == 0.0
        print("FAIL bond_yield approx_ytm_premium value: got=" + str(ytm7))
        exit(1)

    print("PASS _bond_yield_test")
