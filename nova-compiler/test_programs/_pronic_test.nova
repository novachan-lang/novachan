// _pronic_test.nova — KAT for std/math/pronic
import std/math/pronic

fn main()
    // --- pro_n ---
    // pro_n(0) == 0
    let v0 = pro_n(0)
    if v0 != 0
        print("FAIL pro_n(0): expected 0 got " + str(v0))
        exit(1)

    // pro_n(1) == 2
    let v1 = pro_n(1)
    if v1 != 2
        print("FAIL pro_n(1): expected 2 got " + str(v1))
        exit(1)

    // pro_n(3) == 12
    let v3 = pro_n(3)
    if v3 != 12
        print("FAIL pro_n(3): expected 12 got " + str(v3))
        exit(1)

    // pro_n(5) == 30
    let v5 = pro_n(5)
    if v5 != 30
        print("FAIL pro_n(5): expected 30 got " + str(v5))
        exit(1)

    // --- pro_is ---
    // pro_is(12) == true
    let b12 = pro_is(12)
    if b12 != true
        print("FAIL pro_is(12): expected true got " + str(b12))
        exit(1)

    // pro_is(13) == false
    let b13 = pro_is(13)
    if b13 != false
        print("FAIL pro_is(13): expected false got " + str(b13))
        exit(1)

    // pro_is(0) == true (0 = 0*1)
    let b0 = pro_is(0)
    if b0 != true
        print("FAIL pro_is(0): expected true got " + str(b0))
        exit(1)

    // pro_is(2) == true (2 = 1*2)
    let b2 = pro_is(2)
    if b2 != true
        print("FAIL pro_is(2): expected true got " + str(b2))
        exit(1)

    // pro_is(1) == false
    let b1 = pro_is(1)
    if b1 != false
        print("FAIL pro_is(1): expected false got " + str(b1))
        exit(1)

    // --- pro_index ---
    // pro_index(30) == 5
    let idx30 = pro_index(30)
    if idx30 != 5
        print("FAIL pro_index(30): expected 5 got " + str(idx30))
        exit(1)

    // pro_index(12) == 3
    let idx12 = pro_index(12)
    if idx12 != 3
        print("FAIL pro_index(12): expected 3 got " + str(idx12))
        exit(1)

    // pro_index(0) == 0
    let idx0 = pro_index(0)
    if idx0 != 0
        print("FAIL pro_index(0): expected 0 got " + str(idx0))
        exit(1)

    // pro_index(13) == -1
    let idxm = pro_index(13)
    if idxm != -1
        print("FAIL pro_index(13): expected -1 got " + str(idxm))
        exit(1)

    // --- pro_list ---
    // pro_list(4) == [0, 2, 6, 12]
    let lst4 = pro_list(4)
    if len(lst4) != 4
        print("FAIL pro_list(4) len: expected 4 got " + str(len(lst4)))
        exit(1)
    let e0 = lst4[0]
    if e0 != 0
        print("FAIL pro_list(4)[0]: expected 0 got " + str(e0))
        exit(1)
    let e1 = lst4[1]
    if e1 != 2
        print("FAIL pro_list(4)[1]: expected 2 got " + str(e1))
        exit(1)
    let e2 = lst4[2]
    if e2 != 6
        print("FAIL pro_list(4)[2]: expected 6 got " + str(e2))
        exit(1)
    let e3 = lst4[3]
    if e3 != 12
        print("FAIL pro_list(4)[3]: expected 12 got " + str(e3))
        exit(1)

    // pro_list(0) == []
    let lst0 = pro_list(0)
    if len(lst0) != 0
        print("FAIL pro_list(0) len: expected 0 got " + str(len(lst0)))
        exit(1)

    // pro_list(1) == [0]
    let lst1 = pro_list(1)
    if len(lst1) != 1
        print("FAIL pro_list(1) len: expected 1 got " + str(len(lst1)))
        exit(1)
    let f0 = lst1[0]
    if f0 != 0
        print("FAIL pro_list(1)[0]: expected 0 got " + str(f0))
        exit(1)

    print("_pronic_test passed")
