fn classify(n)
    match n
        1..5 => "small"
        6..10 => "medium"
        11..100 => "large"
        x => "other: " + str(x)

fn grade(score)
    match score
        0..59 => "F"
        60..69 => "D"
        70..79 => "C"
        80..89 => "B"
        90..100 => "A"
        _ => "invalid"

fn main()
    assert(classify(1) == "small", "range 1")
    assert(classify(3) == "small", "range 3")
    assert(classify(5) == "small", "range 5")
    assert(classify(6) == "medium", "range 6")
    assert(classify(10) == "medium", "range 10")
    assert(classify(11) == "large", "range 11")
    assert(classify(50) == "large", "range 50")
    assert(classify(100) == "large", "range 100")
    assert(classify(0) == "other: 0", "range 0")
    assert(classify(101) == "other: 101", "range 101")

    assert(grade(95) == "A", "grade A")
    assert(grade(85) == "B", "grade B")
    assert(grade(75) == "C", "grade C")
    assert(grade(65) == "D", "grade D")
    assert(grade(55) == "F", "grade F")
    assert(grade(0) == "F", "grade 0")
    assert(grade(100) == "A", "grade 100")
    assert(grade(101) == "invalid", "grade overflow")

    // Statement-match form
    let msg = ""
    let v = 42
    match v
        1..10 =>
            msg = "low"
        11..50 =>
            msg = "mid"
        _ =>
            msg = "high"
    assert(msg == "mid", "stmt match range")

    print("range_pat_test: all passed")
