// _kat_stdlib_depth — combined KAT for 4 new + 2 extended stdlib modules:
//   std/adt/validated.nova       (new)  prefix vda_
//   std/adt/either.nova          (new)  prefix ei_
//   std/collections/deque.nova   (new)  prefix dq_
//   std/text/template_engine.nova(new)  prefix tme_
//   std/collections/sortedlist.nova (extended: sl_insert/sl_remove/sl_min/sl_max/sl_range)
//   std/collections/multimap.nova   (extended: mm_put/mm_remove/mm_remove_all/mm_contains)

import std/adt/validated
import std/adt/either
import std/collections/deque
import std/text/template_engine
import std/collections/sortedlist
import std/collections/multimap

fn ck(name, got, want)
    if str(got) != str(want)
        print("FAIL " + name + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("ok " + name)

fn double_it(x)
    return x * 2

fn add_ints(a, b)
    return a + b

fn is_even(x)
    return x % 2 == 0

fn describe_either(v)
    return "num:" + str(v)

fn describe_str(v)
    return "str:" + v

fn main()
    // ---------------- validated ----------------
    let v_ok = vda_ok(10)
    ck("vda_is_ok true", vda_is_ok(v_ok), 1)
    ck("vda_is_err false", vda_is_err(v_ok), 0)
    ck("vda_unwrap_or ok", vda_unwrap_or(v_ok, -1), 10)

    let v_err = vda_err("bad field")
    ck("vda_is_ok false", vda_is_ok(v_err), 0)
    ck("vda_is_err true", vda_is_err(v_err), 1)
    ck("vda_unwrap_or err", vda_unwrap_or(v_err, -1), -1)
    ck("vda_errors count", len(vda_errors(v_err)), 1)

    let v_mapped = vda_map(v_ok, double_it)
    ck("vda_map ok", vda_unwrap_or(v_mapped, -1), 20)
    let v_mapped_err = vda_map(v_err, double_it)
    ck("vda_map err passthrough", vda_is_err(v_mapped_err), 1)

    let v_a = vda_err("field a bad")
    let v_b = vda_err("field b bad")
    let v_combined = vda_map2(v_a, v_b, add_ints)
    ck("vda_map2 accumulates both errs", len(vda_errors(v_combined)), 2)

    let v_ok2 = vda_ok(5)
    let v_both_ok = vda_map2(v_ok, v_ok2, add_ints)
    ck("vda_map2 both ok", vda_unwrap_or(v_both_ok, -1), 15)

    let items = [vda_ok(1), vda_err("bad1"), vda_ok(3), vda_err("bad2")]
    let combined = vda_combine(items)
    ck("vda_combine is_err", vda_is_err(combined), 1)
    ck("vda_combine err count", len(vda_errors(combined)), 2)

    let all_ok_items = [vda_ok(1), vda_ok(2), vda_ok(3)]
    let combined_ok = vda_combine(all_ok_items)
    ck("vda_combine all ok", vda_is_ok(combined_ok), 1)
    ck("vda_combine values", str(vda_unwrap_or(combined_ok, [])), str([1, 2, 3]))

    // ---------------- either ----------------
    let el = ei_left("oops")
    let er = ei_right(42)
    ck("ei_is_left true", ei_is_left(el), 1)
    ck("ei_is_right false on left", ei_is_right(el), 0)
    ck("ei_is_right true", ei_is_right(er), 1)
    ck("ei_unwrap_left", ei_unwrap_left(el), "oops")
    ck("ei_unwrap_right", ei_unwrap_right(er), 42)

    let er_mapped = ei_map_right(er, double_it)
    ck("ei_map_right", ei_unwrap_right(er_mapped), 84)
    let el_mapped = ei_map_right(el, double_it)
    ck("ei_map_right passthrough on left", ei_is_left(el_mapped), 1)

    let el_mapped_left = ei_map_left(el, describe_str)
    ck("ei_map_left", ei_unwrap_left(el_mapped_left), "str:oops")

    let folded_r = ei_fold(er, describe_str, describe_either)
    ck("ei_fold right", folded_r, "num:42")
    let folded_l = ei_fold(el, describe_str, describe_either)
    ck("ei_fold left", folded_l, "str:oops")

    // ---------------- deque ----------------
    let dq = dq_new()
    ck("dq_is_empty new", dq_is_empty(dq), 1)
    dq_push_back(dq, 2)
    dq_push_back(dq, 3)
    dq_push_front(dq, 1)
    ck("dq_len after 3 pushes", dq_len(dq), 3)
    ck("dq_to_list order", str(dq_to_list(dq)), str([1, 2, 3]))
    ck("dq_peek_front", dq_peek_front(dq), 1)
    ck("dq_peek_back", dq_peek_back(dq), 3)
    ck("dq_pop_front", dq_pop_front(dq), 1)
    ck("dq_pop_back", dq_pop_back(dq), 3)
    ck("dq_len after pops", dq_len(dq), 1)
    ck("dq_to_list remaining", str(dq_to_list(dq)), str([2]))
    dq_pop_front(dq)
    ck("dq_is_empty after drain", dq_is_empty(dq), 1)
    ck("dq_pop_front on empty", dq_pop_front(dq), null)

    // ---------------- template_engine ----------------
    let ctx1 = {}
    ctx1["name"] = "NOVA"
    ctx1["count"] = 3
    let r1 = tme_render("Hello, \{\{name\}\}! You have \{\{count\}\} items.", ctx1)
    ck("tme_render vars", r1, "Hello, NOVA! You have 3 items.")

    let r_missing = tme_render("Value: \{\{missing\}\}.", ctx1)
    ck("tme_render missing key", r_missing, "Value: .")

    let ctx2 = {}
    ctx2["show"] = 1
    let r2 = tme_render("A\{\{#show\}\}B\{\{/show\}\}C", ctx2)
    ck("tme_render section truthy", r2, "ABC")

    let ctx3 = {}
    ctx3["show"] = 0
    let r3 = tme_render("A\{\{#show\}\}B\{\{/show\}\}C", ctx3)
    ck("tme_render section falsy", r3, "AC")

    let ctx4 = {}
    ctx4["hide"] = 0
    let r4 = tme_render("A\{\{^hide\}\}B\{\{/hide\}\}C", ctx4)
    ck("tme_render inverted falsy renders", r4, "ABC")

    let ctx5 = {}
    ctx5["hide"] = 1
    let r5 = tme_render("A\{\{^hide\}\}B\{\{/hide\}\}C", ctx5)
    ck("tme_render inverted truthy skips", r5, "AC")

    let ctx6 = {}
    ctx6["outer"] = 1
    ctx6["inner"] = 1
    let r6 = tme_render("[\{\{#outer\}\}X\{\{#inner\}\}Y\{\{/inner\}\}Z\{\{/outer\}\}]", ctx6)
    ck("tme_render nested sections", r6, "[XYZ]")

    // ---------------- sortedlist extensions ----------------
    let sl = sl_new()
    sl_insert(sl, 5)
    sl_insert(sl, 1)
    sl_insert(sl, 3)
    sl_insert(sl, 3)
    ck("sl_to_list after inserts", str(sl_to_list(sl)), str([1, 3, 3, 5]))
    ck("sl_min", sl_min(sl), 1)
    ck("sl_max", sl_max(sl), 5)
    ck("sl_range 2..4", str(sl_range(sl, 2, 4)), str([3, 3]))
    let removed = sl_remove(sl, 3)
    ck("sl_remove returns 1", removed, 1)
    ck("sl_to_list after remove", str(sl_to_list(sl)), str([1, 3, 5]))
    let removed_absent = sl_remove(sl, 99)
    ck("sl_remove absent returns 0", removed_absent, 0)
    ck("sl_contains still works", sl_contains(sl, 5), 1)

    // ---------------- multimap extensions ----------------
    let mm = mm_new()
    mm_put(mm, "fruit", "apple")
    mm_put(mm, "fruit", "banana")
    mm_put(mm, "veg", "carrot")
    ck("mm_get fruit len", len(mm_get(mm, "fruit")), 2)
    ck("mm_contains apple", mm_contains(mm, "fruit", "apple"), 1)
    ck("mm_contains missing", mm_contains(mm, "fruit", "kiwi"), 0)
    ck("mm_count fruit", mm_count(mm, "fruit"), 2)
    ck("mm_total", mm_total(mm), 3)
    let rm1 = mm_remove(mm, "fruit", "apple")
    ck("mm_remove returns 1", rm1, 1)
    ck("mm_get fruit after remove", str(mm_get(mm, "fruit")), str(["banana"]))
    let rm2 = mm_remove(mm, "fruit", "does-not-exist")
    ck("mm_remove absent returns 0", rm2, 0)
    mm_remove_all(mm, "veg")
    ck("mm_get veg after remove_all", str(mm_get(mm, "veg")), str([]))
    ck("mm_contains veg after remove_all", mm_contains(mm, "veg", "carrot"), 0)

    print("ALL PASS")
