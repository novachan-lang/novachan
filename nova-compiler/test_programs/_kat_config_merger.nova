import forge_config_merger

fn main()
    let cm = cm_new()
    cm = cm_set_default(cm, "port", "8080")
    cm = cm_set_default(cm, "host", "localhost")
    cm = cm_set_env(cm, "port", "9090")
    cm = cm_set_override(cm, "host", "0.0.0.0")

    assert(cm_get(cm, "port") == "9090", "env overrides default")
    assert(cm_get(cm, "host") == "0.0.0.0", "override wins")
    assert(cm_get(cm, "missing") == "", "missing = empty")
    assert(cm_has(cm, "port") == 1, "has port")
    assert(cm_has(cm, "missing") == 0, "no missing")

    assert(cm_source(cm, "port") == "env", "port from env")
    assert(cm_source(cm, "host") == "override", "host from override")
    assert(cm_source(cm, "missing") == "none", "missing = none")

    cm = cm_set_default(cm, "db", "sqlite")
    assert(cm_source(cm, "db") == "default", "db from default")
    assert(cm_get(cm, "db") == "sqlite", "db value")

    let all = cm_all_keys(cm)
    assert(len(keys(all)) == 3, "3 unique keys")

    print("CONFIG-MERGER KAT PASS")
