// KAT for std/text/diff_myers
// Tests: round-trip (diff_apply(a, diff_lines(a,b)) == b), identical (all "="),
// empty-a (all "+"), empty-b (all "-"), delete-from-middle (one "-"), plus extra round-trips.
import std/text/diff_myers

// ── helpers ──────────────────────────────────────────────────────────────────

fn list_eq(a, b)
    if len(a) != len(b)
        return 0
    let i = 0
    while i < len(a)
        if a[i] != b[i]
            return 0
        i = i + 1
    return 1

fn list_str(xs)
    let s = "["
    let i = 0
    while i < len(xs)
        if i > 0
            s = s + ","
        s = s + xs[i]
        i = i + 1
    s = s + "]"
    s

fn op_list_str(ops)
    let s = "["
    let i = 0
    while i < len(ops)
        if i > 0
            s = s + ","
        let op = ops[i]
        s = s + op[0] + ":" + op[1]
        i = i + 1
    s = s + "]"
    s

fn ck_roundtrip(label, a_lines, b_lines)
    let script = diff_lines(a_lines, b_lines)
    let got = diff_apply(a_lines, script)
    if list_eq(got, b_lines) == 0
        print("FAIL round-trip " + label + ": got=" + list_str(got) + " want=" + list_str(b_lines))
        print("  script=" + op_list_str(script))
        exit(1)

fn count_tag(script, tag)
    let cnt = 0
    let i = 0
    while i < len(script)
        if script[i][0] == tag
            cnt = cnt + 1
        i = i + 1
    cnt

fn main()
    // ── KAT 1: round-trip ["a","b","c"] -> ["a","x","c"] ────────────────────
    let a1 = []
    a1.push("a")
    a1.push("b")
    a1.push("c")
    let b1 = []
    b1.push("a")
    b1.push("x")
    b1.push("c")
    let script1 = diff_lines(a1, b1)
    let got1 = diff_apply(a1, script1)
    let want1 = b1
    if list_eq(got1, want1) == 0
        print("FAIL KAT1 round-trip a-b-c->a-x-c: got=" + list_str(got1) + " want=" + list_str(want1))
        print("  script=" + op_list_str(script1))
        exit(1)

    // ── KAT 2: identical ["a","b"] -> all "=" ops ────────────────────────────
    let a2 = []
    a2.push("a")
    a2.push("b")
    let script2 = diff_lines(a2, a2)
    let i2 = 0
    while i2 < len(script2)
        if script2[i2][0] != "="
            print("FAIL KAT2 identical all=: got op " + script2[i2][0] + " in " + op_list_str(script2))
            exit(1)
        i2 = i2 + 1

    // ── KAT 3: empty a, ["x"] -> one "+" op ─────────────────────────────────
    let empty3 = []
    let b3 = []
    b3.push("x")
    let script3 = diff_lines(empty3, b3)
    if len(script3) != 1
        print("FAIL KAT3 empty-a len: got " + str(len(script3)) + " want 1; script=" + op_list_str(script3))
        exit(1)
    if script3[0][0] != "+"
        print("FAIL KAT3 empty-a tag: got " + script3[0][0] + " want +")
        exit(1)
    if script3[0][1] != "x"
        print("FAIL KAT3 empty-a line: got " + script3[0][1] + " want x")
        exit(1)

    // ── KAT 4: ["x"], empty b -> one "-" op ─────────────────────────────────
    let a4 = []
    a4.push("x")
    let empty4 = []
    let script4 = diff_lines(a4, empty4)
    if len(script4) != 1
        print("FAIL KAT4 empty-b len: got " + str(len(script4)) + " want 1; script=" + op_list_str(script4))
        exit(1)
    if script4[0][0] != "-"
        print("FAIL KAT4 empty-b tag: got " + script4[0][0] + " want -")
        exit(1)

    // ── KAT 5: ["1","2","3"] vs ["1","3"] — exactly one "-" for "2" ─────────
    let a5 = []
    a5.push("1")
    a5.push("2")
    a5.push("3")
    let b5 = []
    b5.push("1")
    b5.push("3")
    let script5 = diff_lines(a5, b5)
    let minus5 = count_tag(script5, "-")
    if minus5 != 1
        print("FAIL KAT5 delete-middle minus count: got " + str(minus5) + " want 1; script=" + op_list_str(script5))
        exit(1)
    // Verify the deleted line is "2".
    let found5 = 0
    let k5 = 0
    while k5 < len(script5)
        if script5[k5][0] == "-" and script5[k5][1] == "2"
            found5 = 1
        k5 = k5 + 1
    if found5 == 0
        print("FAIL KAT5 delete-middle wrong line: script=" + op_list_str(script5))
        exit(1)
    // Round-trip.
    ck_roundtrip("KAT5-delete-middle", a5, b5)

    // ── KAT 6: round-trip middle substitution ["a","b","c"] -> ["a","x","c"] ─
    ck_roundtrip("KAT6-mid-sub", a1, b1)

    // ── KAT 7: round-trip insert at start ───────────────────────────────────
    let a7 = []
    a7.push("b")
    a7.push("c")
    let b7 = []
    b7.push("a")
    b7.push("b")
    b7.push("c")
    ck_roundtrip("KAT7-insert-start", a7, b7)

    // ── KAT 8: round-trip full replacement ──────────────────────────────────
    let a8 = []
    a8.push("one")
    a8.push("two")
    let b8 = []
    b8.push("three")
    b8.push("four")
    ck_roundtrip("KAT8-full-replace", a8, b8)

    // ── KAT 9: round-trip both empty ────────────────────────────────────────
    let empty9 = []
    ck_roundtrip("KAT9-both-empty", empty9, empty9)

    // ── KAT 10: round-trip longer code-like diff ─────────────────────────────
    let a10 = []
    a10.push("fn foo()")
    a10.push("    let x = 1")
    a10.push("    let y = 2")
    a10.push("    return x + y")
    let b10 = []
    b10.push("fn foo()")
    b10.push("    let x = 10")
    b10.push("    let z = 3")
    b10.push("    let y = 2")
    b10.push("    return x + y + z")
    ck_roundtrip("KAT10-code-like", a10, b10)

    // ── KAT 11: round-trip insert at end ────────────────────────────────────
    let a11 = []
    a11.push("a")
    a11.push("b")
    let b11 = []
    b11.push("a")
    b11.push("b")
    b11.push("c")
    ck_roundtrip("KAT11-insert-end", a11, b11)

    // ── KAT 12: diff_text round-trip ────────────────────────────────────────
    let nl = chr(10)
    let at12 = "hello" + nl + "world"
    let bt12 = "hello" + nl + "nova"
    let script12 = diff_text(at12, bt12)
    let a12lines = []
    a12lines.push("hello")
    a12lines.push("world")
    let b12lines = []
    b12lines.push("hello")
    b12lines.push("nova")
    let got12 = diff_apply(a12lines, script12)
    if list_eq(got12, b12lines) == 0
        print("FAIL KAT12 diff_text round-trip: got=" + list_str(got12) + " want=" + list_str(b12lines))
        exit(1)

    // ── KAT 13: round-trip repeated lines ───────────────────────────────────
    let a13 = []
    a13.push("x")
    a13.push("x")
    a13.push("y")
    let b13 = []
    b13.push("x")
    b13.push("y")
    b13.push("y")
    ck_roundtrip("KAT13-repeated", a13, b13)

    print("PASS _diff_myers_test")
