import std/data/jsonmerge

// Helper assertions ──────────────────────────────────────────────────────────

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + got + " want " + want)
        exit(1)

// Build test fixtures ─────────────────────────────────────────────────────────
//
// d1 = {"a":1, "b":{"x":1, "y":2}}
// d2 = {"b":{"y":9, "z":3}, "c":4}

fn make_d1() -> dict
    let d = {}
    d["a"] = 1
    let inner = {}
    inner["x"] = 1
    inner["y"] = 2
    d["b"] = inner
    d

fn make_d2() -> dict
    let d = {}
    let inner = {}
    inner["y"] = 9
    inner["z"] = 3
    d["b"] = inner
    d["c"] = 4
    d

// ── Test 1: deep merge of two dicts ─────────────────────────────────────────
let d1 = make_d1()
let d2 = make_d2()
let m = jm_merge(d1, d2)

// Top-level key from a only — must be kept.
cki("m[a]", m["a"], 1)

// Top-level key from b only — must be added.
cki("m[c]", m["c"], 4)

// Nested: x is only in d1.b — must survive deep merge.
cki("m[b][x]", m["b"]["x"], 1)

// Nested: y exists in both — b's value (9) must win.
cki("m[b][y]", m["b"]["y"], 9)

// Nested: z is only in d2.b — must be added.
cki("m[b][z]", m["b"]["z"], 3)

// ── Test 2: jm_get_path ──────────────────────────────────────────────────────
// m["b"]["y"] == 9
let path1 = ["b", "y"]
let v1 = jm_get_path(m, path1)
cki("get_path b/y", v1, 9)

// m["b"]["z"] == 3
let path2 = ["b", "z"]
let v2 = jm_get_path(m, path2)
cki("get_path b/z", v2, 3)

// m["a"] == 1
let path3 = ["a"]
let v3 = jm_get_path(m, path3)
cki("get_path a", v3, 1)

// Missing key -> null
let path4 = ["b", "w"]
let v4 = jm_get_path(m, path4)
cki("get_path missing", v4, null)

// Empty path -> root (type should be "dict")
let path5 = []
let v5 = jm_get_path(m, path5)
cks("get_path empty", type_of(v5), "dict")

// ── Test 3: scalar-vs-scalar — b wins ────────────────────────────────────────
let s_result = jm_merge(1, 2)
cki("scalar merge", s_result, 2)

// ── Test 4: dict-vs-scalar — b wins ──────────────────────────────────────────
let d1b = make_d1()
let ds_result = jm_merge(d1b, 5)
cki("dict vs scalar", ds_result, 5)

// ── Test 5: scalar-vs-dict — b wins (result is a dict) ───────────────────────
let d2b = make_d2()
let sd_result = jm_merge(42, d2b)
cks("scalar vs dict", type_of(sd_result), "dict")

// ── Test 6: both empty dicts ─────────────────────────────────────────────────
let empty1 = {}
let empty2 = {}
let em = jm_merge(empty1, empty2)
cks("empty merge", type_of(em), "dict")

print("_jsonmerge_test passed")
