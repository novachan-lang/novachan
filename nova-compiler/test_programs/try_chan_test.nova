// Non-blocking channel ops: try_recv (never blocks) + try_send (never blocks).
// try_recv(ch) -> [got, value] (got=1 if a value was dequeued, else [0,0]).
// try_send(ch, v) -> 1 if sent, 0 if full/closed.

// 1) try_recv on an EMPTY channel -> [0, _], must NOT block.
ch = channel()
r0 = try_recv(ch)
if r0[0] != 0
    print("FAIL empty try_recv got=" + str(r0[0]))
    exit(1)

// 2) try_send to an UNBOUNDED channel -> 1, then try_recv -> [1, value].
s1 = try_send(ch, 42)
if s1 != 1
    print("FAIL try_send unbounded returned " + str(s1))
    exit(1)
r1 = try_recv(ch)
if r1[0] != 1 or r1[1] != 42
    print("FAIL try_recv after send got=" + str(r1[0]) + " val=" + str(r1[1]))
    exit(1)

// 3) drained -> try_recv empty again -> [0, _].
r2 = try_recv(ch)
if r2[0] != 0
    print("FAIL try_recv drained got=" + str(r2[0]))
    exit(1)

// 4) BOUNDED channel full -> try_send returns 0 (no block).
bc = channel_bounded(1)
b1 = try_send(bc, 7)
b2 = try_send(bc, 8)
if b1 != 1 or b2 != 0
    print("FAIL bounded try_send b1=" + str(b1) + " b2=" + str(b2))
    exit(1)
rb = try_recv(bc)
if rb[0] != 1 or rb[1] != 7
    print("FAIL bounded recv got=" + str(rb[0]) + " val=" + str(rb[1]))
    exit(1)
// after draining the bounded channel, a send fits again
b3 = try_send(bc, 9)
if b3 != 1
    print("FAIL bounded re-send b3=" + str(b3))
    exit(1)

// 5) UFCS method forms: ch.try_send(v) / ch.try_recv()
ch2 = channel()
su = ch2.try_send(99)
if su != 1
    print("FAIL UFCS try_send " + str(su))
    exit(1)
ru = ch2.try_recv()
if ru[0] != 1 or ru[1] != 99
    print("FAIL UFCS try_recv got=" + str(ru[0]) + " val=" + str(ru[1]))
    exit(1)

// 6) multi: send 3, drain until empty via the [got,value] loop -> sum 6.
mc = channel()
try_send(mc, 1)
try_send(mc, 2)
try_send(mc, 3)
sum = 0
got = try_recv(mc)
while got[0] == 1
    sum = sum + got[1]
    got = try_recv(mc)
if sum != 6
    print("FAIL multi sum=" + str(sum))
    exit(1)

print("try_chan PASS")
