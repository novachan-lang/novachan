@builder
type Config
    host: string
    port: int

fn main()
    let b = Config__builder()
    b = Config__set_host(b, "localhost")
    b = Config__set_port(b, 8080)
    let cfg = Config__build(b)
    assert(cfg.host == "localhost", "host set")
    assert(cfg.port == 8080, "port set")

    let b2 = Config__builder()
    b2 = Config__set_host(b2, "0.0.0.0")
    b2 = Config__set_port(b2, 3000)
    let cfg2 = Config__build(b2)
    assert(cfg2.host == "0.0.0.0", "host2")
    assert(cfg2.port == 3000, "port2")

    print("BUILDER ANNOTATION TEST PASS")
