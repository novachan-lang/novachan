// KAT: tuple patterns in match arms. Tuples already existed everywhere else (literal,
// index, `let (a,b) =` destructure); only match arms lacked them, which is what stopped
// GATE 1's FizzBuzz -- `match (i % 3, i % 5)` -- from compiling.
fn fizzbuzz(n: int) -> string
    match (n % 3, n % 5)
        (0, 0) => "FizzBuzz"
        (0, _) => "Fizz"
        (_, 0) => "Buzz"
        _ => str(n)

fn classify(a: int, b: int) -> string
    match (a, b)
        (0, 0) => "both zero"
        (x, 0) => "second zero, first=" + str(x)
        (0, y) => "first zero, second=" + str(y)
        (x, y) => "neither: " + str(x + y)

let side = []
fn bump() -> int
    push(side, 1)
    2

// statement-form match; the subject calls bump(), which appends to `side`
fn once_check() -> string
    match (bump(), 9)
        (2, 9) => return "hit"
        _ => return "miss"
    return "miss"

fn main()
    let ok = 0
    let fail = 0
    if fizzbuzz(15) == "FizzBuzz" and fizzbuzz(9) == "Fizz" and fizzbuzz(10) == "Buzz" and fizzbuzz(7) == "7"
        ok = ok + 1
        print("ok: FizzBuzz via tuple patterns")
    else
        fail = fail + 1
        print("FAIL fizzbuzz: 15=" + fizzbuzz(15) + " 9=" + fizzbuzz(9) + " 10=" + fizzbuzz(10) + " 7=" + fizzbuzz(7))

    if classify(0, 0) == "both zero"
        ok = ok + 1
    else
        fail = fail + 1
        print("FAIL classify(0,0) = " + classify(0, 0))
    if classify(5, 0) == "second zero, first=5"
        ok = ok + 1
        print("ok: binder in a tuple pattern binds the element")
    else
        fail = fail + 1
        print("FAIL classify(5,0) = " + classify(5, 0))
    if classify(3, 4) == "neither: 7"
        ok = ok + 1
        print("ok: multiple binders in one tuple pattern")
    else
        fail = fail + 1
        print("FAIL classify(3,4) = " + classify(3, 4))

    // the SUBJECT must be evaluated exactly once, even though several arms test it
    let r = once_check()
    if r == "hit" and len(side) == 1
        ok = ok + 1
        print("ok: subject evaluated exactly once (side effects = " + str(len(side)) + ")")
    else
        fail = fail + 1
        print("FAIL subject re-evaluated: r=" + r + " side=" + str(len(side)))

    print("ok=" + str(ok) + " fail=" + str(fail))
    if fail == 0
        print("KAT tuple_match PASS")
    else
        print("KAT tuple_match FAIL")
