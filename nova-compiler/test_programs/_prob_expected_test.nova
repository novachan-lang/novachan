import std/probability/prob_expected

fn ckr(label: string, got: list, wn: int, wd: int)
    if got[0] != wn or got[1] != wd
        print("FAIL " + label + ": got=" + str(got[0]) + "/" + str(got[1]) + " want=" + str(wn) + "/" + str(wd))
        exit(1)

fn main()
    // pe_expected([1,2,3],[1,1,1]) = (1+2+3)/3 = 6/3 = 2/1
    let v1 = [1, 2, 3]
    let w1 = [1, 1, 1]
    ckr("expected [1,2,3] uniform", pe_expected(v1, w1), 2, 1)

    // pe_mean_uniform([1,2,3,4,5,6]) = 21/6 = 7/2
    let v2 = [1, 2, 3, 4, 5, 6]
    ckr("mean_uniform [1..6]", pe_mean_uniform(v2), 7, 2)

    // pe_expected([0,10],[1,3]) = (0*1+10*3)/(1+3) = 30/4 = 15/2
    let v3 = [0, 10]
    let w3 = [1, 3]
    ckr("expected [0,10] w=[1,3]", pe_expected(v3, w3), 15, 2)

    // pe_variance([1,2,3],[1,1,1]) = E[X^2]-E[X]^2 = 14/3 - 4 = 2/3
    let v4 = [1, 2, 3]
    let w4 = [1, 1, 1]
    ckr("variance [1,2,3] uniform", pe_variance(v4, w4), 2, 3)

    // pe_expected([1,2,3,4,5,6],[1,1,1,1,1,1]) = 21/6 = 7/2
    let v5 = [1, 2, 3, 4, 5, 6]
    let w5 = [1, 1, 1, 1, 1, 1]
    ckr("expected [1..6] uniform", pe_expected(v5, w5), 7, 2)

    // Edge: empty list => [0,1]
    let ve = []
    let we = []
    ckr("expected empty", pe_expected(ve, we), 0, 1)
    ckr("variance empty", pe_variance(ve, we), 0, 1)
    ckr("mean_uniform empty", pe_mean_uniform(ve), 0, 1)

    // pe_variance([2,2],[1,1]) = E[X^2]-E[X]^2 = 4 - 4 = 0/1
    let v6 = [2, 2]
    let w6 = [1, 1]
    ckr("variance const", pe_variance(v6, w6), 0, 1)

    // pe_mean_uniform([5]) = 5/1
    let v7 = [5]
    ckr("mean_uniform single", pe_mean_uniform(v7), 5, 1)

    print("PASS _prob_expected_test")
