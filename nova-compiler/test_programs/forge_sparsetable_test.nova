import forge_sparsetable

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    let arr = [1, 3, 2, 7, 9, 11, 3, 5, 6]
    let mn = sparse_build_min(arr)
    let mx = sparse_build_max(arr)

    // min queries
    fails = fails + expect("min_full", str(sparse_query_min(mn, 0, 8)), "1")
    fails = fails + expect("min_3_5", str(sparse_query_min(mn, 3, 5)), "7")
    fails = fails + expect("min_6_8", str(sparse_query_min(mn, 6, 8)), "3")
    fails = fails + expect("min_1_3", str(sparse_query_min(mn, 1, 3)), "2")
    fails = fails + expect("min_single0", str(sparse_query_min(mn, 0, 0)), "1")
    fails = fails + expect("min_single2", str(sparse_query_min(mn, 2, 2)), "2")
    fails = fails + expect("min_4_5", str(sparse_query_min(mn, 4, 5)), "9")

    // max queries
    fails = fails + expect("max_full", str(sparse_query_max(mx, 0, 8)), "11")
    fails = fails + expect("max_3_5", str(sparse_query_max(mx, 3, 5)), "11")
    fails = fails + expect("max_6_8", str(sparse_query_max(mx, 6, 8)), "6")
    fails = fails + expect("max_0_2", str(sparse_query_max(mx, 0, 2)), "3")
    fails = fails + expect("max_single", str(sparse_query_max(mx, 0, 0)), "1")

    // brute-force cross-check every [l,r] against a linear min/max scan
    let n = len(arr)
    let l = 0
    let mismatches = 0
    while l < n
        let r = l
        while r < n
            // linear reference
            let bmin = arr[l]
            let bmax = arr[l]
            let t = l + 1
            while t <= r
                if arr[t] < bmin
                    bmin = arr[t]
                if arr[t] > bmax
                    bmax = arr[t]
                t = t + 1
            if sparse_query_min(mn, l, r) != bmin
                mismatches = mismatches + 1
            if sparse_query_max(mx, l, r) != bmax
                mismatches = mismatches + 1
            r = r + 1
        l = l + 1
    fails = fails + expect("bruteforce_all", str(mismatches), "0")

    if fails == 0
        print("forge_sparsetable: all passed")
    else
        print("forge_sparsetable: " + str(fails) + " FAILED")
