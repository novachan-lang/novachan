import std/interval/interval_bound

// iv_eq2: compare two 2-element interval lists for exact equality.
fn iv_eq2(a, b) -> bool
    if len(a) != 2
        return false
    if len(b) != 2
        return false
    if a[0] != b[0]
        return false
    if a[1] != b[1]
        return false
    return true

fn ck(label: string, got, want)
    if iv_eq2(got, want) == false
        print("FAIL " + label + ": got=[" + str(got[0]) + "," + str(got[1]) + "] want=[" + str(want[0]) + "," + str(want[1]) + "]")
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckf(label: string, got: float, want: float)
    let diff = got - want
    if diff < 0.0
        diff = 0.0 - diff
    if diff > 0.0001
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ib_width([1,4]) == 3.0
    ckf("width", ib_width([1, 4]), 3.0)

    // ib_midpoint([2,6]) == 4.0
    ckf("midpoint", ib_midpoint([2, 6]), 4.0)

    // ib_contains_point([1,5],3) == true
    ckb("cp-mid", ib_contains_point([1, 5], 3), true)

    // ib_contains_point([1,5],6) == false
    ckb("cp-out", ib_contains_point([1, 5], 6), false)

    // ib_contains_point([1,5],1) == true (boundary)
    ckb("cp-lo", ib_contains_point([1, 5], 1), true)

    // ib_contains_point([1,5],5) == true (boundary)
    ckb("cp-hi", ib_contains_point([1, 5], 5), true)

    // ib_contains_interval([1,10],[3,7]) == true
    ckb("ci-yes", ib_contains_interval([1, 10], [3, 7]), true)

    // ib_contains_interval([1,5],[3,7]) == false
    ckb("ci-no", ib_contains_interval([1, 5], [3, 7]), false)

    // ib_clamp(7,[1,5]) == 5.0
    ckf("clamp-hi", ib_clamp(7, [1, 5]), 5.0)

    // ib_clamp(-2,[1,5]) == 1.0
    ckf("clamp-lo", ib_clamp(-2, [1, 5]), 1.0)

    // ib_clamp(3,[1,5]) == 3.0
    ckf("clamp-mid", ib_clamp(3, [1, 5]), 3.0)

    // ib_is_empty([3,1]) == true
    ckb("empty-yes", ib_is_empty([3, 1]), true)

    // ib_is_empty([1,3]) == false
    ckb("empty-no", ib_is_empty([1, 3]), false)

    // ib_is_point([3,3]) == true
    ckb("point-yes", ib_is_point([3, 3]), true)

    // ib_is_point([1,3]) == false
    ckb("point-no", ib_is_point([1, 3]), false)

    // ib_expand([2,4],1) == [1,5]
    let r1 = ib_expand([2, 4], 1)
    ck("expand", r1, [1, 5])

    // ib_shrink([2,6],1) == [3,5]
    let r2 = ib_shrink([2, 6], 1)
    ck("shrink", r2, [3, 5])

    // ib_hull([1,3],[5,8]) == [1,8]
    let r3 = ib_hull([1, 3], [5, 8])
    ck("hull", r3, [1, 8])

    // ib_hull([2,5],[1,4]) == [1,5]
    let r4 = ib_hull([2, 5], [1, 4])
    ck("hull2", r4, [1, 5])

    // ib_shift([1,2],3) == [4,5]
    let r5 = ib_shift([1, 2], 3)
    ck("shift", r5, [4, 5])

    // ib_shift([3,7],-1) == [2,6]
    let r6 = ib_shift([3, 7], -1)
    ck("shift-neg", r6, [2, 6])

    print("PASS _interval_bound_test")
