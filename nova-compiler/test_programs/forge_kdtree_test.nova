import forge_kdtree

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

// brute-force nearest squared distance
fn brute_d2(points: list, qx: int, qy: int) -> int
    let best = 4611686018427387904
    let i = 0
    while i < len(points)
        let dx = qx - points[i][0]
        let dy = qy - points[i][1]
        let d = dx * dx + dy * dy
        if d < best
            best = d
        i = i + 1
    best

fn main()
    let fails = 0

    let pts = []
    push(pts, [2, 3])
    push(pts, [5, 4])
    push(pts, [9, 6])
    push(pts, [4, 7])
    push(pts, [8, 1])
    push(pts, [7, 2])
    let tree = kd_build(pts)

    // nearest to (9,2) is (8,1): d2 = 1+1 = 2
    fails = fails + expect("nn_92", str(kd_nearest_dist2(tree, 9, 2)), "2")
    // nearest to a stored point is itself (d2=0)
    fails = fails + expect("nn_self", str(kd_nearest_dist2(tree, 5, 4)), "0")
    fails = fails + expect("nn_self_idx", str(kd_nearest(tree, 5, 4)), "1")
    // nearest to (0,0) is (2,3): d2 = 4+9 = 13
    fails = fails + expect("nn_00", str(kd_nearest_dist2(tree, 0, 0)), "13")
    // nearest to (6,5): candidates (5,4)=2, (4,7)=8, (9,6)=10, (7,2)=10 -> (5,4) d2=2
    fails = fails + expect("nn_65", str(kd_nearest_dist2(tree, 6, 5)), "2")

    // brute-force cross-check over a grid of queries
    let ok = 1
    let qx = 0 - 2
    while qx <= 12
        let qy = 0 - 2
        while qy <= 10
            if kd_nearest_dist2(tree, qx, qy) != brute_d2(pts, qx, qy)
                ok = 0
            qy = qy + 1
        qx = qx + 1
    fails = fails + expect("brute_grid", str(ok), "1")

    // larger random-ish point set, cross-check
    let big = []
    push(big, [3, 7])
    push(big, [1, 2])
    push(big, [8, 4])
    push(big, [5, 5])
    push(big, [9, 1])
    push(big, [2, 9])
    push(big, [6, 6])
    push(big, [4, 3])
    push(big, [7, 8])
    push(big, [0, 0])
    push(big, [5, 4])
    push(big, [10, 10])
    push(big, [3, 3])
    let bt = kd_build(big)
    let ok2 = 1
    let a = 0
    while a <= 11
        let b = 0
        while b <= 11
            if kd_nearest_dist2(bt, a, b) != brute_d2(big, a, b)
                ok2 = 0
            b = b + 1
        a = a + 1
    fails = fails + expect("brute_grid2", str(ok2), "1")

    // single point
    let sp = []
    push(sp, [3, 4])
    let st = kd_build(sp)
    fails = fails + expect("single", str(kd_nearest_dist2(st, 0, 0)), "25")

    if fails == 0
        print("forge_kdtree: all passed")
    else
        print("forge_kdtree: " + str(fails) + " FAILED")
