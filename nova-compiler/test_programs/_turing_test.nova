// KAT test for std/automata/turing
// Tests: flip-bits TM, unary-increment TM, never-halts TM,
//        immediate-halt (start==halt), tm_accepts true/false.

import std/automata/turing

// cks: check string equality.
fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + got + " expected=" + expected)
        exit(1)

// cki: check int equality.
fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

fn main()
    // ── KAT 1: flip-bits TM on "010" → tape output "101" ──────────────────
    // States: "scan" (start), "halt" (halt).
    // Transitions:
    //   (scan, '0') → write '1', move R, stay scan
    //   (scan, '1') → write '0', move R, stay scan
    //   (scan, '_') → write '_', stay S, go halt
    let m1 = tm_new("scan", "_")
    tm_set_halt(m1, "halt")
    tm_add(m1, "scan", "0", "1", "R", "scan")
    tm_add(m1, "scan", "1", "0", "R", "scan")
    tm_add(m1, "scan", "_", "_", "S", "halt")

    let r1 = tm_run(m1, "010", 100)
    cks("KAT1 flip tape", r1[0], "101")
    cki("KAT1 halted", r1[1], 1)

    // ── KAT 2: tm_accepts returns true for same flip-bits TM ───────────────
    let acc1 = tm_accepts(m1, "010", 100)
    cki("KAT2 tm_accepts flip", acc1, 1)

    // ── KAT 3: flip-bits TM on empty string halts immediately ──────────────
    // Empty input → tape = ['_'], head=0, scan reads '_' → goes to halt.
    let r3 = tm_run(m1, "", 100)
    cki("KAT3 halted on empty", r3[1], 1)
    // Tape should be empty after trimming the one blank written.
    cks("KAT3 tape on empty", r3[0], "")

    // ── KAT 4: flip-bits TM on "1111" → tape "0000" ───────────────────────
    let r4 = tm_run(m1, "1111", 100)
    cks("KAT4 flip 1111", r4[0], "0000")

    // ── KAT 5: unary increment — append one '1' to a unary string ──────────
    // States: "go" (start), "halt" (halt).
    // Transitions:
    //   (go, '1') → write '1', move R, stay go   (scan past existing 1s)
    //   (go, '_') → write '1', move S, go halt    (write the extra 1, stop)
    let m2 = tm_new("go", "_")
    tm_set_halt(m2, "halt")
    tm_add(m2, "go", "1", "1", "R", "go")
    tm_add(m2, "go", "_", "1", "S", "halt")

    // "11" (two 1s) → "111" (three 1s).
    let r5 = tm_run(m2, "11", 100)
    cks("KAT5 unary incr tape", r5[0], "111")
    cki("KAT5 unary incr halted", r5[1], 1)

    // ── KAT 6: tm_accepts on unary TM with "0" still halts (reads '0', no rule → implicit halt) ──
    // '0' has no transition → machine implicitly halts (halted=1 only via halt states).
    // Wait: the machine only marks "halt" as a halt state; an implicit halt via
    // "no rule" does NOT reach a halt state — so tm_accepts should return 0.
    // SPEC CLARIFICATION: "reached a halt state" = explicit halt state reached.
    // An implicit halt (no transition) should return halted=1 but we use tm_set_halt.
    // Let's test explicitly: build a TM that reaches "halt" for input "0":
    //   (go, '0') → write '0', move S, go halt
    let m6 = tm_new("go", "_")
    tm_set_halt(m6, "halt")
    tm_add(m6, "go", "0", "0", "S", "halt")

    let acc6 = tm_accepts(m6, "0", 100)
    cki("KAT6 tm_accepts true on 0", acc6, 1)

    // ── KAT 7: never-halting TM returns halted=0 after maxSteps ────────────
    // States: "go" (start, NOT a halt state).
    // Transition: (go, '0') → write '0', move R, stay go
    //             (go, '_') → write '_', move R, stay go
    // Infinite rightward scan — never halts.
    let m7 = tm_new("go", "_")
    tm_add(m7, "go", "0", "0", "R", "go")
    tm_add(m7, "go", "_", "_", "R", "go")

    let r7 = tm_run(m7, "0", 10)
    cki("KAT7 never-halts halted=0", r7[1], 0)
    cki("KAT7 never-halts steps=maxSteps", r7[2], 10)
    let acc7 = tm_accepts(m7, "0", 10)
    cki("KAT7 tm_accepts false", acc7, 0)

    // ── KAT 8: start state IS a halt state → halts immediately (0 steps) ───
    let m8 = tm_new("halt", "_")
    tm_set_halt(m8, "halt")
    // No transitions needed; machine halts before any step.

    let r8 = tm_run(m8, "", 100)
    cki("KAT8 start-is-halt halted=1", r8[1], 1)
    cki("KAT8 start-is-halt steps=0", r8[2], 0)

    // ── KAT 9: step count is correct ───────────────────────────────────────
    // flip-bits TM on "010": reads 3 chars then 1 blank = 4 steps to halt.
    let r9 = tm_run(m1, "010", 100)
    cki("KAT9 flip step count", r9[2], 4)

    // ── KAT 10: flip "10" → "01" (tests L not needed, just 2-char flip) ────
    let r10 = tm_run(m1, "10", 100)
    cks("KAT10 flip 10", r10[0], "01")

    print("_turing_test passed")
