// Forge crypto: AES block cipher, gated against the FIPS-197 Known-Answer Tests (Appendix C.1 AES-128 +
// C.3 AES-256). Avalanche => matching the exact ciphertext proves the S-box, key schedule, and all round
// transforms are correct. Socketless, deterministic.
import forge_crypto

fn _seq(n: int) -> list
    let o = []
    let i = 0
    while i < n
        push(o, i)
        i = i + 1
    o

fn _pt() -> list
    [0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88, 0x99, 0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff]

fn main()
    // AES-128: key 000102..0f, pt 0011..ff
    let ct128 = aes_encrypt_block(_pt(), _seq(16))
    if hex_of(ct128) != "69c4e0d86a7b0430d8cdb78070b4c55a"
        print("FAIL: AES-128 -> " + hex_of(ct128))
        exit(1)

    // AES-256: key 000102..1f, same pt
    let ct256 = aes_encrypt_block(_pt(), _seq(32))
    if hex_of(ct256) != "8ea2b7ca516745bfeafc49904b496089"
        print("FAIL: AES-256 -> " + hex_of(ct256))
        exit(1)

    print("PASS forge_crypto_aes (FIPS-197 AES-128 + AES-256 block encrypt)")
