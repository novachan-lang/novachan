import forge_network_partition

fn main()
    let n = np_new()
    n = np_add_node(n, "node-a", 1)
    n = np_add_node(n, "node-b", 1)
    n = np_add_node(n, "node-c", 2)
    n = np_add_node(n, "node-d", 2)
    assert(np_node_count(n) == 4, "4 nodes")

    assert(np_can_reach(n, "node-a", "node-b") == 1, "same group")
    assert(np_can_reach(n, "node-a", "node-c") == 1, "no partition yet")

    n = np_partition(n, 1, 2)
    assert(np_active_partitions(n) == 1, "1 partition")
    assert(np_can_reach(n, "node-a", "node-c") == 0, "partitioned")
    assert(np_can_reach(n, "node-c", "node-a") == 0, "partitioned reverse")
    assert(np_can_reach(n, "node-a", "node-b") == 1, "same group ok")

    n = np_heal(n, 0)
    assert(np_active_partitions(n) == 0, "healed")
    assert(np_can_reach(n, "node-a", "node-c") == 1, "reachable again")

    print("NETWORK-PARTITION KAT PASS")
