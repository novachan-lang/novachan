import forge_data_lineage

fn main()
    let s = dl_new()
    assert(dl_dataset_count(s) == 0, "0 datasets")
    assert(dl_dependency_count(s) == 0, "0 deps")
    assert(dl_has_dataset(s, "raw_events") == 0, "raw_events absent")

    s = dl_add_dataset(s, "raw_events", "raw")
    s = dl_add_dataset(s, "raw_users", "raw")
    s = dl_add_dataset(s, "joined", "derived")
    s = dl_add_dataset(s, "report", "derived")
    assert(dl_dataset_count(s) == 4, "4 datasets")
    assert(dl_has_dataset(s, "raw_events") == 1, "raw_events present")

    let src1 = dl_get_source(s, "raw_events")
    assert(is_ok(src1), "src ok")
    assert(unwrap(src1) == "raw", "raw_events is raw")

    let src2 = dl_get_source(s, "missing")
    assert(is_err(src2), "missing source err")

    let d1 = dl_add_dependency(s, "joined", "raw_events")
    assert(is_ok(d1), "dep1 ok")
    s = unwrap(d1)
    let d2 = dl_add_dependency(s, "joined", "raw_users")
    assert(is_ok(d2), "dep2 ok")
    s = unwrap(d2)
    let d3 = dl_add_dependency(s, "report", "joined")
    assert(is_ok(d3), "dep3 ok")
    s = unwrap(d3)

    assert(dl_dependency_count(s) == 3, "3 deps")

    let pc1 = dl_parent_count(s, "joined")
    assert(is_ok(pc1), "pc joined ok")
    assert(unwrap(pc1) == 2, "joined has 2 parents")

    let pc2 = dl_parent_count(s, "raw_events")
    assert(unwrap(pc2) == 0, "raw_events has 0 parents")

    let cc1 = dl_child_count(s, "raw_events")
    assert(is_ok(cc1), "cc raw_events ok")
    assert(unwrap(cc1) == 1, "raw_events has 1 child")

    let cc2 = dl_child_count(s, "report")
    assert(unwrap(cc2) == 0, "report has 0 children")

    let root1 = dl_is_root(s, "raw_events")
    assert(is_ok(root1), "root check ok")
    assert(unwrap(root1) == 1, "raw_events is root")

    let root2 = dl_is_root(s, "joined")
    assert(unwrap(root2) == 0, "joined is not root")

    // duplicate dependency is a no-op on dep_count
    let d4 = dl_add_dependency(s, "joined", "raw_events")
    assert(is_ok(d4), "dup dep ok")
    s = unwrap(d4)
    assert(dl_dependency_count(s) == 3, "still 3 deps after dup")

    // re-adding an existing dataset is a no-op
    s = dl_add_dataset(s, "raw_events", "external")
    assert(dl_dataset_count(s) == 4, "still 4 datasets")
    let src3 = dl_get_source(s, "raw_events")
    assert(unwrap(src3) == "raw", "source unchanged on re-add")

    let bad = dl_add_dependency(s, "nope", "raw_events")
    assert(is_err(bad), "unknown child errs")
    let bad2 = dl_add_dependency(s, "raw_events", "nope")
    assert(is_err(bad2), "unknown parent errs")

    let pcbad = dl_parent_count(s, "nope")
    assert(is_err(pcbad), "parent count on missing errs")
    let ccbad = dl_child_count(s, "nope")
    assert(is_err(ccbad), "child count on missing errs")
    let rootbad = dl_is_root(s, "nope")
    assert(is_err(rootbad), "is_root on missing errs")

    print("DATA-LINEAGE KAT PASS")
