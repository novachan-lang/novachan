// Test automatic __fields method generation for structs

type Point
    x: int
    y: int

type Person
    name: string
    age: int
    active: int

fn main()
    let p = Point(1, 2)
    let fs = Point__fields(p)
    assert(len(fs) == 2, "Point should have 2 fields")
    assert(fs[0] == "x", "first field should be x")
    assert(fs[1] == "y", "second field should be y")

    let per = Person("Alice", 30, 1)
    let pfs = Person__fields(per)
    assert(len(pfs) == 3, "Person should have 3 fields")
    assert(pfs[0] == "name", "first field should be name")
    assert(pfs[1] == "age", "second field should be age")
    assert(pfs[2] == "active", "third field should be active")

    // Fields are strings — usable for logging, serialization, etc.
    let out = ""
    for f in pfs
        if len(out) > 0
            out = out + ", "
        out = out + f
    assert(out == "name, age, active", "joined fields")

    print("reflect_fields: all passed")
