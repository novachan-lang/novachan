// KAT for std/game2d/collision_resolve -- AABB collision response.
import std/game2d/collision_resolve

// approx: tolerance-based float equality.
fn approx(a: float, b: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    d < 0.0001

fn ckf(label: string, got: float, want: float)
    if not approx(got, want)
        print("FAIL collision_resolve " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// vec_approx: check 2-element float list.
fn vec_approx(label: string, got: any, wx: float, wy: float)
    let gx = got[0] * 1.0
    let gy = got[1] * 1.0
    if not approx(gx, wx)
        print("FAIL collision_resolve " + label + ": got[0]=" + str(gx) + " want=" + str(wx))
        exit(1)
    if not approx(gy, wy)
        print("FAIL collision_resolve " + label + ": got[1]=" + str(gy) + " want=" + str(wy))
        exit(1)

fn main()
    // cr_reflect_velocity(1,-1, 0,1)==[1,1]: bounce off floor (normal up = [0,1])
    // dot = 1*0 + (-1)*1 = -1; v' = [1 - 2*(-1)*0, -1 - 2*(-1)*1] = [1, 1]
    let rv1 = cr_reflect_velocity(1.0, 0.0 - 1.0, 0.0, 1.0)
    vec_approx("reflect_floor", rv1, 1.0, 1.0)

    // cr_reflect_velocity(3,4, 1,0)==[-3,4]: bounce off vertical wall (normal=[1,0])
    // dot = 3*1 + 4*0 = 3; v' = [3 - 2*3*1, 4 - 2*3*0] = [-3, 4]
    let rv2 = cr_reflect_velocity(3.0, 4.0, 1.0, 0.0)
    vec_approx("reflect_wall", rv2, 0.0 - 3.0, 4.0)

    // cr_bounce(0,-10, 0,1, 0.5)==[0,5]
    // reflect: dot=-10; v'=[0, -10-2*(-10)*1]=[0,10]; * 0.5 = [0, 5]
    let bo = cr_bounce(0.0, 0.0 - 10.0, 0.0, 1.0, 0.5)
    vec_approx("bounce_restitution", bo, 0.0, 5.0)

    // cr_slide(3,-4, 0,1)==[3,0]: remove downward component, slide horizontally
    // dot = 3*0 + (-4)*1 = -4; v' = [3 - (-4)*0, -4 - (-4)*1] = [3, 0]
    let sl = cr_slide(3.0, 0.0 - 4.0, 0.0, 1.0)
    vec_approx("slide_floor", sl, 3.0, 0.0)

    // cr_impulse_1d(2,-2, 1,1, 1)==[-2,2]: equal masses elastic -> velocities swap
    // momentum = 1*2 + 1*(-2) = 0; rel_v = 2-(-2)=4; impulse=4
    // nv1 = (0 - 1*4)/2 = -2; nv2 = (0 + 1*4)/2 = 2
    let imp = cr_impulse_1d(2.0, 0.0 - 2.0, 1.0, 1.0, 1.0)
    let imp0 = imp[0] * 1.0
    let imp1 = imp[1] * 1.0
    ckf("impulse_1d_v1", imp0, 0.0 - 2.0)
    ckf("impulse_1d_v2", imp1, 2.0)

    // cr_resolve_aabb([1,0,2,2],[0,0,2,2]) -> a pushed to x=2
    // a: x=1,y=0,w=2,h=2  right=3, bottom=2
    // b: x=0,y=0,w=2,h=2  right=2, bottom=2
    // ox1 = ar-bx = 3-0=3; ox2=br-ax=2-1=1  -> min x-overlap = ox2=1 in +x dir
    // oy1 = ab-by = 2-0=2; oy2=bb-ay=2-0=2  -> min y-overlap = 2
    // ox(1) < oy(2) -> push along x: ax=1+1=2
    let ra = cr_resolve_aabb([1, 0, 2, 2], [0, 0, 2, 2])
    let rax = ra[0] * 1.0
    let ray = ra[1] * 1.0
    ckf("resolve_aabb_x", rax, 2.0)
    ckf("resolve_aabb_y", ray, 0.0)

    // cr_resolve_aabb no overlap: a and b don't overlap -> [x,y] unchanged
    let ra_no = cr_resolve_aabb([10, 0, 2, 2], [0, 0, 2, 2])
    let ra_no_x = ra_no[0] * 1.0
    ckf("resolve_aabb_no_overlap", ra_no_x, 10.0)

    // cr_separate([1,0,2,2],[0,0,2,2]) -> both pushed by half
    // MTV = [1,0] (as above); half=[0.5,0]; a-> [1.5,0]; b-> [-0.5,0]
    let sep = cr_separate([1, 0, 2, 2], [0, 0, 2, 2])
    let sax = sep[0] * 1.0
    let say = sep[1] * 1.0
    let sbx = sep[2] * 1.0
    let sby = sep[3] * 1.0
    ckf("separate_ax", sax, 1.5)
    ckf("separate_ay", say, 0.0)
    ckf("separate_bx", sbx, 0.0 - 0.5)
    ckf("separate_by", sby, 0.0)

    // cr_penetration_mtv: same as above
    let mtv = cr_penetration_mtv([1, 0, 2, 2], [0, 0, 2, 2])
    let mtvx = mtv[0] * 1.0
    let mtvy = mtv[1] * 1.0
    ckf("mtv_x", mtvx, 1.0)
    ckf("mtv_y", mtvy, 0.0)

    // cr_penetration_mtv no overlap
    let mtv_no = cr_penetration_mtv([10, 0, 2, 2], [0, 0, 2, 2])
    let mtv_no_x = mtv_no[0] * 1.0
    let mtv_no_y = mtv_no[1] * 1.0
    ckf("mtv_no_overlap_x", mtv_no_x, 0.0)
    ckf("mtv_no_overlap_y", mtv_no_y, 0.0)

    print("PASS _collision_resolve_test")
