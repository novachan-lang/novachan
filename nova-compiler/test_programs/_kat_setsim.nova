import forge_setsim

fn ap(a: float, b: float) -> string
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < 0.0001
        return "ok"
    "FAIL(" + str(a) + ")"

fn main()
    // {a,b,c} vs {b,c,d}: inter=2, union=4 -> jaccard 0.5
    print("jac=" + ap(jaccard(["a", "b", "c"], ["b", "c", "d"]), 0.5))
    print("jac_ident=" + ap(jaccard(["a", "b"], ["a", "b"]), 1.0))
    print("jac_disjoint=" + ap(jaccard(["a", "b"], ["c", "d"]), 0.0))
    // dice: 2*2/(3+3) = 0.6667
    print("dice=" + ap(dice_coef(["a", "b", "c"], ["b", "c", "d"]), 0.66666667))
    print("dice_ident=" + ap(dice_coef(["a", "b"], ["a", "b"]), 1.0))
    // overlap: {a,b} subset of {a,b,c,d} -> inter=2, min=2 -> 1.0
    print("overlap_subset=" + ap(overlap_coef(["a", "b"], ["a", "b", "c", "d"]), 1.0))
    print("overlap_half=" + ap(overlap_coef(["a", "b", "x", "y"], ["a", "c", "d", "e"]), 0.25))
    // duplicates collapse to set: {a,a,b} == {a,b}
    print("dup=" + ap(jaccard(["a", "a", "b"], ["a", "b"]), 1.0))
    // empty
    print("empty=" + ap(jaccard([], []), 0.0))
