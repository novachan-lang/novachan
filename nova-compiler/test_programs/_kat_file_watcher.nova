import forge_file_watcher

fn main()
    let w = fw_new()
    w = fw_watch(w, "app.nova")
    w = fw_watch(w, "lib.nova")
    assert(fw_watch_count(w) == 2, "2 watched")
    assert(fw_is_watching(w, "app.nova") == 1, "watching app")

    let u1 = fw_update(w, "app.nova", 12345)
    assert(is_ok(u1), "update ok")
    assert(unwrap(u1) == "changed", "detected change")
    assert(fw_change_count(w) == 1, "1 change")

    let u2 = fw_update(w, "app.nova", 12345)
    assert(is_ok(u2), "update same hash")
    assert(unwrap(u2) == "unchanged", "no change")
    assert(fw_change_count(w) == 1, "still 1 change")

    let u3 = fw_update(w, "app.nova", 67890)
    assert(is_ok(u3), "update new hash")
    assert(unwrap(u3) == "changed", "change detected")
    assert(fw_change_count(w) == 2, "2 changes")

    let bad = fw_update(w, "nope.nova", 1)
    assert(is_err(bad), "not watching")

    let uw = fw_unwatch(w, "lib.nova")
    assert(is_ok(uw), "unwatch ok")
    w = unwrap(uw)
    assert(fw_watch_count(w) == 1, "1 after unwatch")

    print("FILE-WATCHER KAT PASS")
