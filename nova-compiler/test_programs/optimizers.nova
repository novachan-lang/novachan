// ══════════════════════════════════════════════════════════════════════════════
// optimizers — gradient-descent optimizers for NOVA (numeric/AI spine)
//
// Pairs with autograd: autograd gives you the gradient vector, an optimizer turns it
// into a parameter step. Params and grads are float vectors (lists) of equal length.
//   - opt_sgd is stateless: params' = opt_sgd(params, grads, lr)
//   - momentum/adam carry state (a dict of running buffers); make it once with
//     opt_*_new(n), then call opt_*_step(state, params, grads, ...) each iteration.
//
//   st = opt_adam_new(len(params))
//   loop: params = opt_adam_step(st, params, grads, 0.01)
// ══════════════════════════════════════════════════════════════════════════════

fn opt_sgd(params: list, grads: list, lr: float) -> list
    let out = []
    let i = 0
    while i < len(params)
        push(out, params[i] - lr * grads[i])
        i = i + 1
    out

// ── Momentum (heavy ball): v = mu*v - lr*g ; x = x + v ─────────────────────────

fn opt_momentum_new(n: int) -> dict
    let v = []
    let i = 0
    while i < n
        push(v, 0.0)
        i = i + 1
    {"v": v}

fn opt_momentum_step(state: dict, params: list, grads: list, lr: float, mu: float) -> list
    let v = state["v"]
    let out = []
    let i = 0
    while i < len(params)
        let nv = mu * v[i] - lr * grads[i]
        v[i] = nv
        push(out, params[i] + nv)
        i = i + 1
    state["v"] = v
    out

// ── Adam: bias-corrected first/second moment estimates ─────────────────────────
// b1t/b2t hold the running beta^t powers (multiplied each step) for bias correction,
// avoiding a pow() call.

fn opt_adam_new(n: int) -> dict
    let m = []
    let v = []
    let i = 0
    while i < n
        push(m, 0.0)
        push(v, 0.0)
        i = i + 1
    {"m": m, "v": v, "b1t": 1.0, "b2t": 1.0}

fn opt_adam_step(state: dict, params: list, grads: list, lr: float) -> list
    let b1 = 0.9
    let b2 = 0.999
    let eps = 0.00000001
    let b1t = state["b1t"] * b1
    let b2t = state["b2t"] * b2
    state["b1t"] = b1t
    state["b2t"] = b2t
    let m = state["m"]
    let v = state["v"]
    let out = []
    let i = 0
    while i < len(params)
        let g = grads[i]
        let mi = b1 * m[i] + (1.0 - b1) * g
        let vi = b2 * v[i] + (1.0 - b2) * g * g
        m[i] = mi
        v[i] = vi
        let mhat = mi / (1.0 - b1t)
        let vhat = vi / (1.0 - b2t)
        push(out, params[i] - lr * mhat / (sqrt(vhat) + eps))
        i = i + 1
    state["m"] = m
    state["v"] = v
    out

fn main()
    let params = [1.0, 2.0]
    let grads = [0.1, 0.2]
    let updated = opt_sgd(params, grads, 1.0)
    assert(updated[0] == 0.9, "sgd p0")
    assert(updated[1] == 1.8, "sgd p1")
    print("optimizers: passed")
