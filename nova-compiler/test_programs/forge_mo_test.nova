import forge_mo as mo

fn check(cond: bool, label: str)
    if cond == false
        print("FAIL: " + label)

// Brute-force distinct count in a[l..r]
fn brute_distinct(arr: list, l: int, r: int) -> int
    let seen = {}
    let cnt = 0
    let i = l
    while i <= r
        let key = str(arr[i])
        if get(seen, key, 0) == 0
            cnt = cnt + 1
            seen[key] = 1
        i = i + 1
    return cnt

// TEST 1: basic
let arr = [1, 2, 1, 3, 2, 1, 4]
let queries = [[0, 2], [0, 6], [3, 5], [1, 4], [6, 6]]
let ans = mo.mo_distinct(arr, queries)
check(len(ans) == 5, "5 answers")
// [0,2] = {1,2,1} -> 2 distinct
check(ans[0] == 2, "q0 [0,2] distinct=2")
// [0,6] = {1,2,1,3,2,1,4} -> {1,2,3,4} = 4
check(ans[1] == 4, "q1 [0,6] distinct=4")
// [3,5] = {3,2,1} -> 3
check(ans[2] == 3, "q2 [3,5] distinct=3")
// [1,4] = {2,1,3,2} -> {1,2,3} = 3
check(ans[3] == 3, "q3 [1,4] distinct=3")
// [6,6] = {4} -> 1
check(ans[4] == 1, "q4 [6,6] distinct=1")

// TEST 2: block size
check(mo.mo_block_size(9) == 3, "block size sqrt(9)=3")
check(mo.mo_block_size(16) == 4, "block size sqrt(16)=4")
check(mo.mo_block_size(1) == 1, "block size 1")
check(mo.mo_block_size(10) == 4, "block size ceil-ish sqrt(10)=4")

// TEST 3: single element array
let arr3 = [7]
let q3 = [[0, 0]]
let ans3 = mo.mo_distinct(arr3, q3)
check(ans3[0] == 1, "single element distinct=1")

// TEST 4: all same values
let arr4 = [5, 5, 5, 5, 5]
let q4 = [[0, 4], [1, 3], [2, 2]]
let ans4 = mo.mo_distinct(arr4, q4)
check(ans4[0] == 1, "all-same full distinct=1")
check(ans4[1] == 1, "all-same mid distinct=1")
check(ans4[2] == 1, "all-same single distinct=1")

// TEST 5: all distinct values
let arr5 = [10, 20, 30, 40, 50]
let q5 = [[0, 4], [1, 3], [0, 0]]
let ans5 = mo.mo_distinct(arr5, q5)
check(ans5[0] == 5, "all-distinct full=5")
check(ans5[1] == 3, "all-distinct [1,3]=3")
check(ans5[2] == 1, "all-distinct single=1")

// TEST 6: DECISIVE brute-force cross-check on a bigger array with MANY queries
// Build array of size 60 with values in [0,9], and all O(n^2) sub-range queries
let big = []
let seed = 999
let i = 0
while i < 60
    seed = (seed * 1103515245 + 12345) % 2147483648
    push(big, seed % 10)
    i = i + 1

// Generate all queries [l, r] for l<=r
let allq = []
let l = 0
while l < 60
    let r = l
    while r < 60
        push(allq, [l, r])
        r = r + 1
    l = l + 1

let mo_ans = mo.mo_distinct(big, allq)
let ok = true
let k = 0
while k < len(allq)
    let ql = allq[k][0]
    let qr = allq[k][1]
    let expected = brute_distinct(big, ql, qr)
    if mo_ans[k] != expected
        ok = false
        print("MISMATCH q=" + str(k) + " [" + str(ql) + "," + str(qr) + "] exp=" + str(expected) + " got=" + str(mo_ans[k]))
    k = k + 1
check(ok, "DECISIVE: Mo's distinct matches brute force for ALL sub-ranges of a 60-elem array")

// TEST 7: queries in scrambled order still return correct answers in original order
let arr7 = [3, 1, 4, 1, 5, 9, 2, 6, 5, 3]
let q7 = [[5, 9], [0, 0], [2, 7], [0, 9], [8, 9], [1, 1]]
let ans7 = mo.mo_distinct(arr7, q7)
let ok7 = true
let m = 0
while m < len(q7)
    let expected = brute_distinct(arr7, q7[m][0], q7[m][1])
    if ans7[m] != expected
        ok7 = false
        print("SCRAMBLE MISMATCH m=" + str(m))
    m = m + 1
check(ok7, "scrambled queries answered in original order correctly")

print("forge_mo: KAT done")
