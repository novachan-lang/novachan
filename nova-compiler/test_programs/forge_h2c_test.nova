// forge_h2c_test -- a REAL cleartext HTTP/2 (h2c) request/response end-to-end over a loopback socket, using
// the full stack built this session: connection preface + SETTINGS + HPACK-encoded HEADERS -> serve_h2c
// decodes + routes through the EXISTING router -> HEADERS+DATA response -> client decodes. Imports only
// forge + forge_h2_server (no diamond). Bounded (serve_h2c accepts 1 conn) + kill-on-timeout via _fdb_one.
import forge
import forge_h2_server

fn _ping(req: Request) -> string
    "pong-over-h2c"

fn _server(port: int)
    let a = forge.app()
    forge.get(a, "/ping", _ping)
    forge_h2_server.serve_h2c(a, port, 1)

fn _client(port: int, rch)
    sleep(80)
    let sock = tcp_connect("127.0.0.1", port)
    tcp_send_bytes(sock, forge_h2_server.list_to_bytes(forge_h2_server.h2_client_request_frames("GET", "/ping")))
    // Read until the RESPONSE STREAM is complete, not until the socket closes. HTTP/2
    // connections are multiplexed and long-lived, so a real h2 client terminates on
    // END_STREAM; waiting for EOF is a protocol error even when it happens to work.
    // It is also what made this test hang indefinitely: every assertion it makes had
    // already succeeded (server decodes the preface, parses SETTINGS+HEADERS, routes
    // through forge.dispatch_safe, sends 63 bytes of HEADERS+DATA and closes; the client
    // receives the complete 72-byte response) -- and then blocked forever in one extra
    // tcp_recv_bytes that never observed the peer's close. h2_decode_response reports
    // status 0 until a :status header has been decoded, so it doubles as the completeness
    // test. The read budget bounds the loop if the response never arrives at all.
    let resp = bytes(0)
    let dec = [0, ""]
    let reads = 0
    while dec[0] == 0 and reads < 64
        let more = tcp_recv_bytes(sock)
        if bytes_len(more) == 0
            reads = 64
        else
            resp = bytes_concat(resp, more)
            dec = forge_h2_server.h2_decode_response(forge_h2_server.bytes_to_list(resp))
            reads = reads + 1
    tcp_close(sock)
    send(rch, dec)

fn main()
    let port = 19457
    let p = port
    spawn fn()
        _server(p)
    sleep(300)
    let rc = channel()
    let pp = port
    let rcc = rc
    spawn fn()
        _client(pp, rcc)
    let dr = recv(rc)
    assert(dr[0] == 200, "h2c GET /ping -> :status 200 (got " + str(dr[0]) + ")")
    assert(dr[1] == "pong-over-h2c", "h2c response DATA body routed through the existing router [" + dr[1] + "]")
    print("PASS: cleartext HTTP/2 request/response end-to-end (preface+SETTINGS+HEADERS -> route -> HEADERS+DATA)")
    print("forge_h2c_test passed")
