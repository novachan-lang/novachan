// KAT for std/compress/lz77_lazy — LZ77 with lazy matching
import std/compress/lz77_lazy

// ── helpers ──────────────────────────────────────────────────────────────────

fn bytes_eq(a, b) -> int
    let na = len(a)
    let nb = len(b)
    if na != nb
        return 0
    let i = 0
    let ok = 1
    while i < na
        if a[i] != b[i]
            ok = 0
        i = i + 1
    ok

fn str_to_bytes(s) -> list
    let out = []
    let i = 0
    let n = len(s)
    while i < n
        push(out, ord(s[i]))
        i = i + 1
    out

fn ck_rt(label, bytes)
    let tokens = lz77l_compress(bytes, 255)
    let got = lz77l_decompress(tokens)
    if bytes_eq(got, bytes) == 0
        print("FAIL round-trip " + label + ": len got=" + str(len(got)) + " want=" + str(len(bytes)))
        exit(1)

fn ck_rt_str(label, s)
    let bs = str_to_bytes(s)
    ck_rt(label, bs)

fn main()
    // ── KAT 1: empty input ───────────────────────────────────────────────────
    let et = lz77l_compress([], 255)
    if len(et) != 0
        print("FAIL empty: expected 0 tokens, got " + str(len(et)))
        exit(1)
    let ed = lz77l_decompress([])
    if len(ed) != 0
        print("FAIL empty decompress: expected 0 bytes")
        exit(1)

    // ── KAT 2: single byte ───────────────────────────────────────────────────
    ck_rt("single 65", [65])
    ck_rt("single 0", [0])
    ck_rt("single 255", [255])

    // ── KAT 3: two different bytes ────────────────────────────────────────────
    ck_rt("two diff", [10, 20])

    // ── KAT 4: repetitive "aaaaaaa" → back-references ─────────────────────────
    let rep = str_to_bytes("aaaaaaa")
    let enc_rep = lz77l_compress(rep, 255)
    let dec_rep = lz77l_decompress(enc_rep)
    if bytes_eq(dec_rep, rep) == 0
        print("FAIL repetitive rt")
        exit(1)
    // Should have fewer tokens than 7 (at least one back-reference)
    if len(enc_rep) >= 7
        print("FAIL repetitive compression: " + str(len(enc_rep)) + " tokens, expected < 7")
        exit(1)
    // Verify a back-reference token exists (offset > 0)
    let found_ref = 0
    let ki = 0
    while ki < len(enc_rep)
        let tok = enc_rep[ki]
        if tok[0] > 0
            found_ref = 1
        ki = ki + 1
    if found_ref == 0
        print("FAIL repetitive: no back-reference token found")
        exit(1)

    // ── KAT 5: TOBEORNOTTOBEORTOBEORNOT ─────────────────────────────────────
    ck_rt_str("TOBEORNOT", "TOBEORNOTTOBEORTOBEORNOT")

    // ── KAT 6: classic test — abcabcabc ──────────────────────────────────────
    let abc = str_to_bytes("abcabcabc")
    let enc_abc = lz77l_compress(abc, 255)
    let dec_abc = lz77l_decompress(enc_abc)
    if bytes_eq(dec_abc, abc) == 0
        print("FAIL abcabcabc rt")
        exit(1)
    // Should compress: 9 chars, expect fewer than 9 tokens
    if len(enc_abc) >= 9
        print("FAIL abcabcabc: " + str(len(enc_abc)) + " tokens, expected < 9")
        exit(1)

    // ── KAT 7: mississippi ────────────────────────────────────────────────────
    ck_rt_str("mississippi", "mississippi")

    // ── KAT 8: longer text ────────────────────────────────────────────────────
    ck_rt_str("pangram", "the quick brown fox jumps over the lazy dog")

    // ── KAT 9: mixed bytes ────────────────────────────────────────────────────
    ck_rt("mixed bytes", [0, 127, 255, 1, 200, 50, 100, 0, 1, 2])

    // ── KAT 10: all same bytes ────────────────────────────────────────────────
    let same = [42, 42, 42, 42, 42, 42, 42, 42, 42, 42]
    ck_rt("all same 42", same)

    // ── KAT 11: lz77l_compress_default == lz77l_compress(b,255) ─────────────
    let s11 = str_to_bytes("mississippi")
    let t1 = lz77l_compress(s11, 255)
    let t2 = lz77l_compress_default(s11)
    if len(t1) != len(t2)
        print("FAIL compress_default: len differ " + str(len(t1)) + " vs " + str(len(t2)))
        exit(1)
    let ii = 0
    while ii < len(t1)
        let a = t1[ii]
        let b = t2[ii]
        if a[0] != b[0] or a[1] != b[1]
            print("FAIL compress_default: token " + str(ii) + " differs")
            exit(1)
        ii = ii + 1

    // ── KAT 12: literal token structure ──────────────────────────────────────
    // "x" → 1 token, [0, 120]
    let sx = str_to_bytes("x")
    let tx = lz77l_compress(sx, 255)
    if len(tx) != 1
        print("FAIL single x: expected 1 token, got " + str(len(tx)))
        exit(1)
    let tok0 = tx[0]
    if tok0[0] != 0
        print("FAIL single x: offset should be 0, got " + str(tok0[0]))
        exit(1)
    if tok0[1] != 120
        print("FAIL single x: value should be 120, got " + str(tok0[1]))
        exit(1)

    // ── KAT 13: overlapping match round-trip ──────────────────────────────────
    // "aaaa" compressed: first literal 'a' then a back-ref to extend it.
    // Decompressor must handle overlapping copy correctly.
    let aaaa = [97, 97, 97, 97]
    ck_rt("overlapping aaaa", aaaa)

    // ── KAT 14: binary data with repeating pattern ────────────────────────────
    let binpat = [0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2]
    ck_rt("binary repeat", binpat)

    // ── KAT 15: lazy matching improvement check ────────────────────────────────
    // "abcbc": greedy at pos 2 finds "bc" (len 2, offset 2 from start);
    // lazy checks pos 3 — finds "bc" from pos 1 (len 2 too, no improvement).
    // Either way the round-trip must work.
    ck_rt_str("abcbc", "abcbc")

    print("PASS _lz77_lazy_test")
