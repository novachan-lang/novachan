import std/quantum/quantum_state
import std/quantum/quantum_measure
import std/quantum/quantum_grover

// cki — integer known-answer check.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _quantum_grover_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// cgt — integer greater-than check (got > min).
fn cgt(label: string, got: int, min: int)
    if got <= min
        print("FAIL _quantum_grover_test " + label + ": got=" + str(got) + " want > " + str(min))
        exit(1)

// _round1000 — round x*1000 to the nearest int, handling negative x correctly
// (test-local; mirrors the signed-rounding pattern each std/quantum module carries).
fn _round1000(x: float) -> int
    if x < 0.0
        let neg = 0.0 - x
        let scaled = neg * 1000.0 + 0.5
        let r = float_to_int(scaled)
        return 0 - r
    let scaled = x * 1000.0 + 0.5
    float_to_int(scaled)

fn main()
    // qgr_uniform(2): equal superposition, each of 4 amplitudes has prob 250/1000.
    let u2 = qgr_uniform(2)
    cki("uniform2 prob0", qst_prob_x1000(u2, 0), 250)
    cki("uniform2 prob1", qst_prob_x1000(u2, 1), 250)
    cki("uniform2 prob2", qst_prob_x1000(u2, 2), 250)
    cki("uniform2 prob3", qst_prob_x1000(u2, 3), 250)

    // qgr_optimal_iterations
    cki("optimal_iterations(2)", qgr_optimal_iterations(2), 1)
    cki("optimal_iterations(3)", qgr_optimal_iterations(3), 2)

    // qgr_oracle: amp[3].re becomes negative on the uniform superposition;
    // every other amplitude is unchanged.
    let marked = qgr_oracle(qgr_uniform(2), 3)
    let a3 = qst_amp(marked, 3)
    cki("oracle marks amp3 re", _round1000(a3[0]), 0 - 500)
    cki("oracle amp0 unchanged", qst_prob_x1000(marked, 0), 250)

    // qgr_search(2, target): n=2 is exact — 1 Grover iteration gives certainty.
    // Hand-derived: uniform 4-state superposition [.5,.5,.5,.5]; the oracle flips
    // the marked amplitude to -.5; diffusion's new_amp=2*mean-amp then drives
    // every unmarked amplitude to 0 and the marked amplitude to 1 — probability
    // exactly 1000/1000.
    let s3 = qgr_search(2, 3)
    cki("search(2,3) prob3", qst_prob_x1000(s3, 3), 1000)
    cki("search_result(2,3)", qgr_search_result(2, 3), 3)

    let s0 = qgr_search(2, 0)
    cki("search(2,0) prob0", qst_prob_x1000(s0, 0), 1000)
    cki("search_result(2,0)", qgr_search_result(2, 0), 0)

    let s1 = qgr_search(2, 1)
    cki("search(2,1) prob1", qst_prob_x1000(s1, 1), 1000)
    cki("search_result(2,1)", qgr_search_result(2, 1), 1)

    let s2 = qgr_search(2, 2)
    cki("search(2,2) prob2", qst_prob_x1000(s2, 2), 1000)
    cki("search_result(2,2)", qgr_search_result(2, 2), 2)

    // qgr_search(3, 5): n=3 is approximate — 2 iterations amplify but don't reach
    // certainty (8 basis states, 1 marked item). Assert the most-likely outcome
    // is 5 and its probability is high (>900/1000), not exact certainty.
    let s35 = qgr_search(3, 5)
    cki("search(3,5) most_likely", qms_most_likely(s35), 5)
    cki("search_result(3,5)", qgr_search_result(3, 5), 5)
    cgt("search(3,5) prob5 > 900", qms_prob_outcome_x1000(s35, 5), 900)

    print("PASS _quantum_grover_test")
