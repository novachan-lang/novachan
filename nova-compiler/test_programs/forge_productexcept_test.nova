import forge_productexcept

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn joinl(xs: list) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + ","
        out = out + str(xs[i])
        i = i + 1
    out

// brute-force product except self
fn brute(arr: list) -> list
    let out = []
    let i = 0
    while i < len(arr)
        let p = 1
        let j = 0
        while j < len(arr)
            if j != i
                p = p * arr[j]
            j = j + 1
        push(out, p)
        i = i + 1
    out

fn main()
    let fails = 0

    fails = fails + expect("basic", joinl(product_except_self([1, 2, 3, 4])), "24,12,8,6")
    fails = fails + expect("ex2", joinl(product_except_self([2, 3, 4, 5])), "60,40,30,24")
    fails = fails + expect("one_zero", joinl(product_except_self([1, 0, 3, 4])), "0,12,0,0")
    fails = fails + expect("two_zeros", joinl(product_except_self([0, 0, 3])), "0,0,0")
    fails = fails + expect("single", joinl(product_except_self([5])), "1")
    fails = fails + expect("empty", joinl(product_except_self([])), "")
    fails = fails + expect("negatives", joinl(product_except_self([0 - 1, 2, 0 - 3, 4])), "-24,12,-8,6")
    fails = fails + expect("with_one", joinl(product_except_self([1, 1, 1])), "1,1,1")

    // brute-force cross-check
    let ok = 1
    let arrs = []
    push(arrs, [3, 1, 4, 1, 5])
    push(arrs, [2, 0, 2, 2])
    push(arrs, [0 - 2, 3, 0 - 4])
    push(arrs, [7])
    let t = 0
    while t < len(arrs)
        if joinl(product_except_self(arrs[t])) != joinl(brute(arrs[t]))
            ok = 0
        t = t + 1
    fails = fails + expect("brute_cross", str(ok), "1")

    if fails == 0
        print("forge_productexcept: all passed")
    else
        print("forge_productexcept: " + str(fails) + " FAILED")
