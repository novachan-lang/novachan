import forge_bitops

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // bit_length
    fails = fails + expect("bl_0", str(bit_length(0)), "0")
    fails = fails + expect("bl_1", str(bit_length(1)), "1")
    fails = fails + expect("bl_255", str(bit_length(255)), "8")
    fails = fails + expect("bl_256", str(bit_length(256)), "9")

    // is_power_of_two
    fails = fails + expect("p2_1", str(is_power_of_two(1)), "true")
    fails = fails + expect("p2_16", str(is_power_of_two(16)), "true")
    fails = fails + expect("p2_17", str(is_power_of_two(17)), "false")
    fails = fails + expect("p2_0", str(is_power_of_two(0)), "false")

    // next / prev power of two
    fails = fails + expect("np_5", str(next_power_of_two(5)), "8")
    fails = fails + expect("np_8", str(next_power_of_two(8)), "8")
    fails = fails + expect("np_1", str(next_power_of_two(1)), "1")
    fails = fails + expect("np_0", str(next_power_of_two(0)), "1")
    fails = fails + expect("np_1000", str(next_power_of_two(1000)), "1024")
    fails = fails + expect("pp_5", str(prev_power_of_two(5)), "4")
    fails = fails + expect("pp_8", str(prev_power_of_two(8)), "8")
    fails = fails + expect("pp_1000", str(prev_power_of_two(1000)), "512")

    // count trailing zeros
    fails = fails + expect("ctz_8", str(count_trailing_zeros(8)), "3")
    fails = fails + expect("ctz_12", str(count_trailing_zeros(12)), "2")
    fails = fails + expect("ctz_1", str(count_trailing_zeros(1)), "0")
    fails = fails + expect("ctz_0", str(count_trailing_zeros(0)), "-1")

    // count leading zeros within width
    fails = fails + expect("clz_1_8", str(count_leading_zeros(1, 8)), "7")
    fails = fails + expect("clz_255_8", str(count_leading_zeros(255, 8)), "0")
    fails = fails + expect("clz_0_8", str(count_leading_zeros(0, 8)), "8")
    fails = fails + expect("clz_16_8", str(count_leading_zeros(16, 8)), "3")

    // reverse bits
    fails = fails + expect("rev_1_8", str(reverse_bits(1, 8)), "128")
    fails = fails + expect("rev_11_4", str(reverse_bits(11, 4)), "13")
    fails = fails + expect("rev_128_8", str(reverse_bits(128, 8)), "1")
    fails = fails + expect("rev_0_8", str(reverse_bits(0, 8)), "0")

    // rotate
    fails = fails + expect("rl_1_1_4", str(rotate_left(1, 1, 4)), "2")
    fails = fails + expect("rl_8_1_4", str(rotate_left(8, 1, 4)), "1")
    fails = fails + expect("rl_0k", str(rotate_left(5, 0, 4)), "5")
    fails = fails + expect("rr_1_1_4", str(rotate_right(1, 1, 4)), "8")
    fails = fails + expect("rr_8_1_4", str(rotate_right(8, 1, 4)), "4")
    fails = fails + expect("rl_wrap", str(rotate_left(5, 4, 4)), "5")

    // parity
    fails = fails + expect("par_0", str(parity(0)), "0")
    fails = fails + expect("par_1", str(parity(1)), "1")
    fails = fails + expect("par_3", str(parity(3)), "0")
    fails = fails + expect("par_7", str(parity(7)), "1")

    if fails == 0
        print("forge_bitops: all passed")
    else
        print("forge_bitops: " + str(fails) + " FAILED")
