// KAT for std/units/temperature.nova
import std/units/temperature

fn approx(a: float, b: float, tol: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < tol

fn ckf(label: string, got: float, want: float, tol: float)
    if not approx(got, want, tol)
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    let tol = 0.001

    // KAT 1: 0 C -> 32 F
    let r1 = c_to_f(0.0)
    ckf("c_to_f_0", r1, 32.0, tol)

    // KAT 2: 100 C -> 212 F
    let r2 = c_to_f(100.0)
    ckf("c_to_f_100", r2, 212.0, tol)

    // KAT 3: 32 F -> 0 C
    let r3 = f_to_c(32.0)
    ckf("f_to_c_32", r3, 0.0, tol)

    // KAT 4: 212 F -> 100 C
    let r4 = f_to_c(212.0)
    ckf("f_to_c_212", r4, 100.0, tol)

    // KAT 5: 0 C -> 273.15 K
    let r5 = c_to_k(0.0)
    ckf("c_to_k_0", r5, 273.15, tol)

    // KAT 6: 273.15 K -> 0 C
    let r6 = k_to_c(273.15)
    ckf("k_to_c_273_15", r6, 0.0, tol)

    // KAT 7: temperature_convert 100 C -> F = 212
    let r7 = temperature_convert(100.0, "c", "f")
    ckf("tc_100c_f", r7, 212.0, tol)

    // KAT 8: temperature_convert 32 F -> K = 273.15
    let r8 = temperature_convert(32.0, "f", "k")
    ckf("tc_32f_k", r8, 273.15, tol)

    // KAT 9: -40 C == -40 F (the unique crossover)
    let r9 = c_to_f(-40.0)
    ckf("c_to_f_neg40", r9, -40.0, tol)

    // KAT 10: f_to_k 212F -> 373.15 K
    let r10 = f_to_k(212.0)
    ckf("f_to_k_212", r10, 373.15, tol)

    // KAT 11: k_to_f 373.15 K -> 212 F
    let r11 = k_to_f(373.15)
    ckf("k_to_f_373_15", r11, 212.0, tol)

    // KAT 12: temperature_convert same unit is identity
    let r12 = temperature_convert(100.0, "c", "c")
    ckf("tc_identity_c", r12, 100.0, tol)

    // KAT 13: temperature_convert K -> C round-trip
    let r13 = temperature_convert(0.0, "c", "k")
    let r13b = temperature_convert(r13, "k", "c")
    ckf("tc_roundtrip_c_k", r13b, 0.0, tol)

    // KAT 14: temperature_is_supported
    let s1 = temperature_is_supported("c")
    cki("supported_c", s1, 1)
    let s2 = temperature_is_supported("f")
    cki("supported_f", s2, 1)
    let s3 = temperature_is_supported("k")
    cki("supported_k", s3, 1)
    let s4 = temperature_is_supported("r")
    cki("unsupported_r", s4, 0)

    // KAT 15: temperature_units returns 3 entries
    let us = temperature_units()
    cki("units_len", len(us), 3)

    print("PASS _temperature_test")
