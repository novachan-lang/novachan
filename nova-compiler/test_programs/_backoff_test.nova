// KAT test for std/util/backoff
import std/util/backoff

// Helper: compare two lists for equality.
fn _bo_lists_eq(a: list, b: list) -> int
    if len(a) != len(b)
        return 0
    let i = 0
    while i < len(a)
        if a[i] != b[i]
            return 0
        i = i + 1
    1

fn main()
    // ── KAT 1: bo_delay(0,100,10000) == 100 ─────────────────────────────────
    let d0 = bo_delay(0, 100, 10000)
    if d0 != 100
        print("FAIL bo_delay(0,100,10000): expected 100 got " + str(d0))
        exit(1)

    // ── KAT 2: bo_delay(1,100,10000) == 200 ─────────────────────────────────
    let d1 = bo_delay(1, 100, 10000)
    if d1 != 200
        print("FAIL bo_delay(1,100,10000): expected 200 got " + str(d1))
        exit(1)

    // ── KAT 3: bo_delay(3,100,10000) == 800 ─────────────────────────────────
    let d3 = bo_delay(3, 100, 10000)
    if d3 != 800
        print("FAIL bo_delay(3,100,10000): expected 800 got " + str(d3))
        exit(1)

    // ── KAT 4: bo_delay(10,100,10000) == 10000  (capped) ────────────────────
    let d10 = bo_delay(10, 100, 10000)
    if d10 != 10000
        print("FAIL bo_delay(10,100,10000): expected 10000 got " + str(d10))
        exit(1)

    // ── KAT 5: bo_sequence(4,100,10000) == [100,200,400,800] ────────────────
    let seq4 = bo_sequence(4, 100, 10000)
    let exp4 = [100, 200, 400, 800]
    if _bo_lists_eq(seq4, exp4) != 1
        print("FAIL bo_sequence(4,100,10000): got " + str(seq4))
        exit(1)

    // ── KAT 6: bo_delay(0,50,1000) == 50 ────────────────────────────────────
    let d50 = bo_delay(0, 50, 1000)
    if d50 != 50
        print("FAIL bo_delay(0,50,1000): expected 50 got " + str(d50))
        exit(1)

    // ── KAT 7+8: bo_delay_jittered(3,100,10000,42) in [0,800] ──────────────
    let j = bo_delay_jittered(3, 100, 10000, 42)
    if j < 0
        print("FAIL bo_delay_jittered: j negative: " + str(j))
        exit(1)
    if j > 800
        print("FAIL bo_delay_jittered: j > 800: " + str(j))
        exit(1)

    // ── extra: bo_total(4,100,10000) == 100+200+400+800 = 1500 ──────────────
    let tot4 = bo_total(4, 100, 10000)
    if tot4 != 1500
        print("FAIL bo_total(4,100,10000): expected 1500 got " + str(tot4))
        exit(1)

    // ── extra: cap kicks in correctly ────────────────────────────────────────
    let d20 = bo_delay(20, 100, 10000)
    if d20 != 10000
        print("FAIL bo_delay(20,100,10000): expected 10000 got " + str(d20))
        exit(1)

    // ── extra: attempt 2, base 100 -> 400 ────────────────────────────────────
    let d2 = bo_delay(2, 100, 10000)
    if d2 != 400
        print("FAIL bo_delay(2,100,10000): expected 400 got " + str(d2))
        exit(1)

    // ── extra: bo_sequence(1,...) == [100] ───────────────────────────────────
    let seq1 = bo_sequence(1, 100, 10000)
    let exp1 = [100]
    if _bo_lists_eq(seq1, exp1) != 1
        print("FAIL bo_sequence(1,100,10000): got " + str(seq1))
        exit(1)

    // ── extra: jitter is deterministic (same seed -> same value) ─────────────
    let j2 = bo_delay_jittered(3, 100, 10000, 42)
    if j != j2
        print("FAIL bo_delay_jittered not deterministic: " + str(j) + " vs " + str(j2))
        exit(1)

    print("_backoff_test passed")
