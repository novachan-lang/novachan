// _bell_test.nova — KAT for std/math/bell
import std/math/bell

// cki — assert int equality
fn cki(label: string, got: int, expected: int)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// cks — assert string equality
fn cks(label: string, got: string, expected: string)
    if got != expected
        print("FAIL " + label + ": got " + got + " expected " + expected)
        exit(1)

// --- KAT: bell(n) ---

// bell(0) = 1  (one way to partition empty set: the empty partition)
cki("bell(0)", bell(0), 1)

// bell(1) = 1  (one way to partition a 1-element set: {{a}})
cki("bell(1)", bell(1), 1)

// bell(2) = 2  ({{a,b}} or {{a},{b}})
cki("bell(2)", bell(2), 2)

// bell(3) = 5
cki("bell(3)", bell(3), 5)

// bell(4) = 15
cki("bell(4)", bell(4), 15)

// bell(5) = 52
cki("bell(5)", bell(5), 52)

// bell(6) = 203
cki("bell(6)", bell(6), 203)

// bell(7) = 877
cki("bell(7)", bell(7), 877)

// --- KAT: bell_list(n) ---

// bell_list(0) = []
let bl0 = bell_list(0)
cki("bell_list(0) len", len(bl0), 0)

// bell_list(1) = [1]
let bl1 = bell_list(1)
cki("bell_list(1) len", len(bl1), 1)
cki("bell_list(1)[0]", bl1[0], 1)

// bell_list(5) = [1,1,2,5,15]
let bl5 = bell_list(5)
cki("bell_list(5) len", len(bl5), 5)
cki("bell_list(5)[0]", bl5[0], 1)
cki("bell_list(5)[1]", bl5[1], 1)
cki("bell_list(5)[2]", bl5[2], 2)
cki("bell_list(5)[3]", bl5[3], 5)
cki("bell_list(5)[4]", bl5[4], 15)

// bell_list(7) = [1,1,2,5,15,52,203]
let bl7 = bell_list(7)
cki("bell_list(7) len", len(bl7), 7)
cki("bell_list(7)[6]", bl7[6], 203)

// --- KAT: bell_triangle(n) ---

// bell_triangle(0) = []
let t0 = bell_triangle(0)
cki("bell_triangle(0) len", len(t0), 0)

// bell_triangle(1) = [[1]]
let t1 = bell_triangle(1)
cki("bell_triangle(1) len", len(t1), 1)
let t1r0 = t1[0]
cki("bell_triangle(1)[0][0]", t1r0[0], 1)

// bell_triangle(3) = [[1],[1,2],[2,3,5]]
let t3 = bell_triangle(3)
cki("bell_triangle(3) len", len(t3), 3)
let t3r0 = t3[0]
let t3r1 = t3[1]
let t3r2 = t3[2]
cki("bell_triangle(3)[0][0]", t3r0[0], 1)
cki("bell_triangle(3)[1] len", len(t3r1), 2)
cki("bell_triangle(3)[1][0]", t3r1[0], 1)
cki("bell_triangle(3)[1][1]", t3r1[1], 2)
cki("bell_triangle(3)[2] len", len(t3r2), 3)
cki("bell_triangle(3)[2][0]", t3r2[0], 2)
cki("bell_triangle(3)[2][1]", t3r2[1], 3)
cki("bell_triangle(3)[2][2]", t3r2[2], 5)

// bell_triangle(5): row 4 = [15,20,27,37,52]
let t5 = bell_triangle(5)
cki("bell_triangle(5) len", len(t5), 5)
let t5r4 = t5[4]
cki("bell_triangle(5)[4][0]", t5r4[0], 15)
cki("bell_triangle(5)[4][4]", t5r4[4], 52)

print("_bell_test passed")
