fn progress_bar(current, total, width)
  if total <= 0
    return "[" + repeat_char(" ", width) + "] 0%"
  let pct = current * 100 / total
  let filled = current * width / total
  if filled > width
    filled = width
  let bar = ""
  let i = 0
  while i < filled
    bar = bar + "#"
    i = i + 1
  while i < width
    bar = bar + " "
    i = i + 1
  "[" + bar + "] " + str(pct) + "%"

fn repeat_char(ch, n)
  let out = ""
  let i = 0
  while i < n
    out = out + ch
    i = i + 1
  out

fn spinner_frame(tick)
  let frames = ["|", "/", "-", "\\"]
  frames[tick % 4]

fn eta_str(elapsed_ms, current, total)
  if current <= 0
    return "calculating..."
  let rate = elapsed_ms / current
  let remaining = (total - current) * rate / 1000
  if remaining < 60
    return str(remaining) + "s"
  if remaining < 3600
    return str(remaining / 60) + "m"
  str(remaining / 3600) + "h"

fn main()
  let bar0 = progress_bar(0, 100, 20)
  assert(contains(bar0, "0%"), "0%")
  assert(contains(bar0, "["), "has bracket")

  let bar50 = progress_bar(50, 100, 20)
  assert(contains(bar50, "50%"), "50%")
  assert(contains(bar50, "##########"), "10 filled")

  let bar100 = progress_bar(100, 100, 20)
  assert(contains(bar100, "100%"), "100%")

  assert(spinner_frame(0) == "|", "spin 0")
  assert(spinner_frame(1) == "/", "spin 1")
  assert(spinner_frame(4) == "|", "spin wraps")

  let eta = eta_str(5000, 50, 100)
  assert(len(eta) > 0, "eta non-empty")

  print("progressx: all passed")
