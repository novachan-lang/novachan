// KAT for std/image/img_grayscale — RGB<->grayscale conversion.
import std/image/img_grayscale

fn chk_int(label: str, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn chk_list(label: str, got: list, want: list)
    let ng = len(got)
    let nw = len(want)
    if ng != nw
        print("FAIL " + label + " len: got " + str(ng) + " want " + str(nw))
        exit(1)
    let i = 0
    while i < nw
        let gv = got[i]
        let wv = want[i]
        if gv != wv
            print("FAIL " + label + "[" + str(i) + "]: got " + str(gv) + " want " + str(wv))
            exit(1)
        i = i + 1

fn main()
    // KAT 1: white pixel -> 255
    // (255*299 + 255*587 + 255*114)/1000 = 255*1000/1000 = 255
    let rgb1 = []
    rgb1.push(255)
    rgb1.push(255)
    rgb1.push(255)
    let g1 = rgb_to_gray(rgb1, 1, 1)
    chk_int("rgb_to_gray_white_len", len(g1), 1)
    chk_int("rgb_to_gray_white_val", g1[0], 255)

    // KAT 2: pure red -> 76
    // (255*299 + 0*587 + 0*114)/1000 = 76245/1000 = 76
    let rgb2 = []
    rgb2.push(255)
    rgb2.push(0)
    rgb2.push(0)
    let g2 = rgb_to_gray(rgb2, 1, 1)
    chk_int("rgb_to_gray_red_val", g2[0], 76)

    // KAT 3: black pixel -> 0
    let rgb3 = []
    rgb3.push(0)
    rgb3.push(0)
    rgb3.push(0)
    let g3 = rgb_to_gray(rgb3, 1, 1)
    chk_int("rgb_to_gray_black_val", g3[0], 0)

    // KAT 4: gray_to_rgb([128]) -> [128,128,128]
    let gray4 = []
    gray4.push(128)
    let rgb4 = gray_to_rgb(gray4)
    let want4 = []
    want4.push(128)
    want4.push(128)
    want4.push(128)
    chk_list("gray_to_rgb_128", rgb4, want4)

    // KAT 5: 2-pixel grayscale round-trip check on length
    // rgb_to_gray on 2 pixels => list of 2 grays
    let rgb5 = []
    rgb5.push(100)
    rgb5.push(150)
    rgb5.push(200)
    rgb5.push(0)
    rgb5.push(0)
    rgb5.push(0)
    let g5 = rgb_to_gray(rgb5, 2, 1)
    chk_int("rgb_to_gray_2px_len", len(g5), 2)
    // (100*299 + 150*587 + 200*114)/1000 = (29900+88050+22800)/1000 = 140750/1000 = 140
    chk_int("rgb_to_gray_2px_0", g5[0], 140)
    // black pixel
    chk_int("rgb_to_gray_2px_1", g5[1], 0)

    // KAT 6: gray_to_rgb on 2-pixel gray -> 6 channel list
    let gray6 = []
    gray6.push(0)
    gray6.push(255)
    let rgb6 = gray_to_rgb(gray6)
    chk_int("gray_to_rgb_2px_len", len(rgb6), 6)
    chk_int("gray_to_rgb_2px_r0", rgb6[0], 0)
    chk_int("gray_to_rgb_2px_g0", rgb6[1], 0)
    chk_int("gray_to_rgb_2px_b0", rgb6[2], 0)
    chk_int("gray_to_rgb_2px_r1", rgb6[3], 255)
    chk_int("gray_to_rgb_2px_g1", rgb6[4], 255)
    chk_int("gray_to_rgb_2px_b1", rgb6[5], 255)

    print("PASS _img_grayscale_test")
