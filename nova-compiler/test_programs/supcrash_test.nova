// True "let it crash" supervision: restart a child that HARD-CRASHES (panics), not
// merely one that signals failure — only possible now that crash isolation contains a
// panic into exit_status=1. Full Erlang-class stack: crash isolation + monitor + restart.
// The shared attempt-gate is captured by the SPAWN BODY (atomics are shared across the
// process boundary), so it persists across restarts.

fn maybe_crash(gate)
    let n = atomic_add(gate, 1)        // 1,2,3,... shared across restarts
    if n < 3
        panic("attempt failed")         // hard crash -> contained -> restart
    // n >= 3: clean success (exit_status 0)

fn supervise(maxr)
    let gate = atomic_new(0)
    let recovered = 0
    let restarts = 0
    while recovered == 0 and restarts <= maxr
        p = spawn fn()
            maybe_crash(gate)
        m = monitor(p)
        if receive(m) == 0
            recovered = 1
        else
            restarts = restarts + 1
    return [recovered, restarts]

r = supervise(5)
assert_eq(r[0], 1)        // recovered
assert_eq(r[1], 2)        // after exactly 2 crashes, success on the 3rd attempt
print("supcrash passed")
