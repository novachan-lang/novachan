// Dict comprehensions {k: v for ...} — the "into dict" form, desugared to
// dict_from_pairs(<list-comprehension of [k,v] pairs>). Keys are strings (as all
// NOVA dict keys). Supports filters and multiple generators, like list comprehensions.

fn main()
    // basic
    let squares = {"k" + str(n): n * n for n in [1, 2, 3]}
    assert_eq(squares["k2"], 4)
    assert_eq(squares["k3"], 9)
    assert_eq(len(squares), 3)

    // with filter
    let evens = {str(n): n for n in [1, 2, 3, 4] if n % 2 == 0}
    assert_eq(len(evens), 2)
    assert_eq(evens["4"], 4)

    // float values (boxing through the pair list + dict)
    let halves = {str(n): n / 2.0 for n in [2, 4]}
    assert_eq(halves["2"], 1.0)
    assert_eq(halves["4"], 2.0)

    // multi-generator dict comprehension (last write wins on key collision)
    let grid = {str(x) + "," + str(y): x * y for x in [1, 2] for y in [3, 4]}
    assert_eq(grid["2,4"], 8)
    assert_eq(len(grid), 4)

    // normal dict literal still works
    let d = {"a": 1, "b": 2}
    assert_eq(d["a"], 1)
    assert_eq(d["b"], 2)

    // empty dict
    let e = {}
    assert_eq(len(e), 0)

    print("dictcomp passed")
