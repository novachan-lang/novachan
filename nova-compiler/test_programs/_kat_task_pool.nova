import forge_task_pool

fn main()
    let t = tp_new()
    t = tp_submit(t, "build", "src/")
    t = tp_submit(t, "test", "test/")
    t = tp_submit(t, "deploy", "prod")
    assert(tp_pending_count(t) == 3, "3 pending")

    t = tp_start(t, 0)
    assert(tp_status(t, 0) == "running", "0 running")
    assert(tp_pending_count(t) == 2, "2 pending")

    t = tp_complete(t, 0)
    assert(tp_status(t, 0) == "completed", "0 completed")
    assert(tp_completion_rate(t) == 33, "33% complete")

    t = tp_start(t, 1)
    t = tp_fail(t, 1)
    assert(tp_status(t, 1) == "failed", "1 failed")
    assert(tp_failure_rate(t) == 50, "50% fail rate")

    t = tp_start(t, 2)
    t = tp_complete(t, 2)
    assert(tp_pending_count(t) == 0, "0 pending")
    assert(tp_completion_rate(t) == 66, "66% complete")

    print("TASK-POOL KAT PASS")
