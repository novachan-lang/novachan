import forge_incident_tracker

fn main()
    let s = it_new()
    let id1 = it_open(s, "API down", 1)
    let id2 = it_open(s, "Slow queries", 3)
    let id3 = it_open(s, "Disk almost full", 2)

    assert(id1 == 1, "first incident id is 1")
    assert(id2 == 2, "second incident id is 2")
    assert(id3 == 3, "third incident id is 3")

    assert(it_total_count(s) == 3, "3 total incidents")
    assert(it_open_count(s) == 3, "3 open incidents")
    assert(it_resolved_count(s) == 0, "0 resolved incidents")
    assert(it_critical_count(s) == 1, "1 critical incident")

    let title = it_get_title(s, id1)
    assert(is_ok(title), "get title ok")
    assert(unwrap(title) == "API down", "title matches")

    let sev = it_get_severity(s, id2)
    assert(is_ok(sev), "get severity ok")
    assert(unwrap(sev) == 3, "severity matches")

    let status = it_get_status(s, id1)
    assert(is_ok(status), "get status ok")
    assert(unwrap(status) == "open", "status is open")

    let resolved = it_resolve(s, id1)
    assert(is_ok(resolved), "resolve ok")
    assert(it_open_count(s) == 2, "2 open after resolve")
    assert(it_resolved_count(s) == 1, "1 resolved after resolve")
    assert(it_total_count(s) == 3, "total unchanged after resolve")

    let status2 = it_get_status(s, id1)
    assert(is_ok(status2), "get status after resolve ok")
    assert(unwrap(status2) == "resolved", "status is resolved")

    assert(is_err(it_resolve(s, id1)), "double resolve errors")
    assert(is_err(it_resolve(s, 999)), "resolve unknown errors")
    assert(is_err(it_get_title(s, 999)), "get title unknown errors")

    print("INCIDENT-TRACKER KAT PASS")
