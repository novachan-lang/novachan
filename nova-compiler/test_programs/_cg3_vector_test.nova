import std/geometry3d/cg3_vector

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn ckl(label: string, got: list, want: list)
    let ok = true
    if len(got) != len(want)
        ok = false
    if ok
        let i = 0
        while i < len(want)
            if got[i] != want[i]
                ok = false
            i = i + 1
    if not ok
        print("FAIL " + label + ": mismatch")
        exit(1)

fn main()
    // cgv3_cross([1,0,0],[0,1,0]) = [0,0,1]
    let a1 = [1, 0, 0]
    let b1 = [0, 1, 0]
    let c1 = cgv3_cross(a1, b1)
    ckl("cross_x_y", c1, [0, 0, 1])

    // cgv3_cross([0,1,0],[0,0,1]) = [1,0,0]
    let a2 = [0, 1, 0]
    let b2 = [0, 0, 1]
    let c2 = cgv3_cross(a2, b2)
    ckl("cross_y_z", c2, [1, 0, 0])

    // cgv3_dot([1,2,3],[4,5,6]) = 4+10+18 = 32
    let d1 = [1, 2, 3]
    let d2 = [4, 5, 6]
    cki("dot_123_456", cgv3_dot(d1, d2), 32)

    // cgv3_norm_sq([1,2,2]) = 1+4+4 = 9
    let n1 = [1, 2, 2]
    cki("norm_sq_122", cgv3_norm_sq(n1), 9)

    // cgv3_sub([5,5,5],[1,2,3]) = [4,3,2]
    let s1 = [5, 5, 5]
    let s2 = [1, 2, 3]
    let sr = cgv3_sub(s1, s2)
    ckl("sub_555_123", sr, [4, 3, 2])

    // cgv3_scale([1,2,3],2) = [2,4,6]
    let sc1 = [1, 2, 3]
    let scr = cgv3_scale(sc1, 2)
    ckl("scale_123_2", scr, [2, 4, 6])

    print("PASS _cg3_vector_test")
