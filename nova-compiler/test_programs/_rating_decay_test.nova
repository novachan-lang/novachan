import std/game/rating_decay

fn approx(a: float, b: float, tol: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    d < tol

fn assert_approx(label: string, a: float, b: float, tol: float)
    let ok = approx(a, b, tol)
    if not ok
        print("FAIL rating_decay " + label + ": got " + str(a) + " want ~" + str(b))
        exit(1)

fn assert_true(label: string, cond: bool)
    if not cond
        print("FAIL rating_decay " + label)
        exit(1)

fn main()
    // Zero weeks inactive: no decay
    let r0 = inactivity_decay(1600.0, 0, 1000.0)
    assert_approx("no_decay_at_0_weeks", r0, 1600.0, 0.0001)

    // 10 weeks inactive: should be less than 1600
    let r10 = inactivity_decay(1600.0, 10, 1000.0)
    assert_true("decays_after_10_weeks", r10 < 1600.0)
    // 10 * 2.0 = 20 points decay -> 1580.0
    assert_approx("decay_10_weeks_value", r10, 1580.0, 0.0001)

    // Floor clamp: 1050 with 1000 weeks inactive, floor=1000 -> should be 1000.0
    let r_floor = inactivity_decay(1050.0, 1000, 1000.0)
    assert_approx("floor_clamped", r_floor, 1000.0, 0.0001)

    // Floor clamp: never goes below floor even with extreme decay
    let r_extreme = inactivity_decay(1200.0, 10000, 800.0)
    assert_approx("extreme_decay_at_floor", r_extreme, 800.0, 0.0001)

    // Floor clamp: rating already at floor -> stays there with any decay
    let r_at_floor = inactivity_decay(1000.0, 5, 1000.0)
    assert_approx("already_at_floor", r_at_floor, 1000.0, 0.0001)

    // 1 week: small decay
    let r1 = inactivity_decay(1500.0, 1, 0.0)
    assert_approx("one_week_decay", r1, 1498.0, 0.0001)

    // Monotone: more weeks = lower rating (when not at floor)
    let r5 = inactivity_decay(2000.0, 5, 0.0)
    let r20 = inactivity_decay(2000.0, 20, 0.0)
    assert_true("monotone_more_weeks_lower", r20 < r5)

    // provisional_bonus: 0 games -> max bonus (100)
    let pb0 = provisional_bonus(1500.0, 0)
    assert_approx("bonus_0_games", pb0, 1600.0, 0.0001)

    // provisional_bonus: 10 games -> half bonus (50)
    let pb10 = provisional_bonus(1500.0, 10)
    assert_approx("bonus_10_games", pb10, 1550.0, 0.0001)

    // provisional_bonus: 20 games -> no bonus
    let pb20 = provisional_bonus(1500.0, 20)
    assert_approx("bonus_20_games", pb20, 1500.0, 0.0001)

    // provisional_bonus: 30+ games -> still no bonus (clamped at 0)
    let pb30 = provisional_bonus(1500.0, 30)
    assert_approx("bonus_30_games_no_extra", pb30, 1500.0, 0.0001)

    print("PASS _rating_decay_test")
