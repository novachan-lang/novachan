// C FFI test — calling external C functions via @extern

@extern
fn c_add(a, b)
    return 0

@extern
fn c_multiply(a, b)
    return 0

@extern
fn c_strlen_nova(s)
    return 0

@extern
fn c_to_upper(s)
    return ""

// Test integer operations
assert(c_add(10, 20) == 30, "ffi add")
assert(c_add(-5, 5) == 0, "ffi add negative")
assert(c_multiply(6, 7) == 42, "ffi multiply")
assert(c_multiply(0, 100) == 0, "ffi multiply zero")

// Test string operations
assert(c_strlen_nova("hello") == 5, "ffi strlen")
assert(c_strlen_nova("") == 0, "ffi strlen empty")

upper = c_to_upper("hello nova")
assert(upper == "HELLO NOVA", "ffi to_upper")

print("FFI: ALL PASSED")
