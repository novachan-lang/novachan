// FFI test: declare extern C functions and call them

extern fn my_c_add(a: int, b: int) -> int
extern fn my_c_mul(a: int, b: int) -> int
extern fn my_c_factorial(n: int) -> int

fn main()
    let s = my_c_add(40, 2)
    print(s)
    let p = my_c_mul(7, 6)
    print(p)
    let f = my_c_factorial(5)
    print(f)
