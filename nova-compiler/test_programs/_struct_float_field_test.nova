// _struct_float_field_test.nova -- CORE_GAP 0.8 FLOAT-SLOT safety probe.
// A struct FLOAT field holds RAW IEEE-754 double bits inline (narrowed via @sfkinds@). Feeding those
// bits to rc_dec is the exact unsoundness that makes kind=2 float-lists skip the dec loop (double bit
// patterns collide with the heap-pointer range and can pass find_tag -> wild deref / crash). The
// managed-slot bitmap MUST exclude float (and int) slots and dec ONLY the pointer slots.
// FMix is HEAP (it has a `data` list field) so it actually reaches rc_free's struct path -- an all-scalar
// struct would be SROA-stackable and never hit the free path. rc_free must dec `data` but SKIP `x`
// (float) and `y` (int). If the bitmap wrongly includes the float slot, this churn crashes under ASAN.

type FMix
    data: list
    x: float
    y: int

fn main()
    let n = 0.0
    let count = 0
    let i = 0
    while i < 5000
        let fi = (i + 1) * 1.0
        let m = FMix([i, i + 1, i + 2], 2.5 * fi, i)
        n = n + m.x
        count = count + len(m.data)
        i = i + 1
    // churn fresh allocations to reuse any wrongly-freed slot memory.
    let junk = []
    let k = 0
    while k < 500
        push(junk, [k])
        k = k + 1
    print("struct_float_field count=" + str(count) + " n_ok=" + str(n > 0.0))
    // 5000 iters * 3 elems = 15000 ; float slot must be intact (no crash, positive sum).
    if count != 15000
        print("struct_float_field_test FAILED: list field corrupted count=" + str(count))
        exit(1)
    if n <= 0.0
        print("struct_float_field_test FAILED: float slot corrupted (dec'd raw bits?) n>0 was false")
        exit(1)
    print("struct_float_field_test passed (float+int slots never dec'd; list slot correctly freed)")
