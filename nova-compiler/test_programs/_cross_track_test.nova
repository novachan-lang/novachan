// _cross_track_test.nova — KAT for std/geo/cross_track
// Known-answer tests for the signed cross-track distance function.
import std/geo/cross_track

fn approx(a: float, b: float, tol: float) -> int
    let d = a - b
    let ad = d
    if d < 0.0
        ad = 0.0 - d
    if ad < tol
        return 1
    return 0

fn main()
    // KAT 1: A point ON the equator east-west path should have cross-track ~0.
    // Path: (0,0) -> (0,10) along equator. Point: (0,5) on the path.
    let ct1 = cross_track(0.0, 5.0, 0.0, 0.0, 0.0, 10.0)
    let ok1 = approx(ct1, 0.0, 1000.0)
    if ok1 != 1
        print("FAIL cross_track on-path not near 0: " + str(ct1))
        exit(1)

    // KAT 2: A point 1 degree north of the equator path has magnitude ~111195 m.
    // Path: (0,0) -> (0,10). Point: (1,5) — 1 degree north.
    // 1 degree of latitude = ~111195 m. Allow ±5000 m tolerance.
    let ct2 = cross_track(1.0, 5.0, 0.0, 0.0, 0.0, 10.0)
    let ct2_abs = ct2
    if ct2 < 0.0
        ct2_abs = 0.0 - ct2
    let ok2 = approx(ct2_abs, 111195.0, 5000.0)
    if ok2 != 1
        print("FAIL cross_track 1-deg-north magnitude: " + str(ct2_abs) + " expected ~111195")
        exit(1)

    // KAT 3: Symmetry check — point 1 degree south should have same magnitude.
    let ct3 = cross_track(-1.0, 5.0, 0.0, 0.0, 0.0, 10.0)
    let ct3_abs = ct3
    if ct3 < 0.0
        ct3_abs = 0.0 - ct3
    let ok3 = approx(ct3_abs, 111195.0, 5000.0)
    if ok3 != 1
        print("FAIL cross_track 1-deg-south magnitude: " + str(ct3_abs) + " expected ~111195")
        exit(1)

    // KAT 4: Sign check — point to the right of the path direction should be negative
    // (NOVA's formula: positive means right of direction, but conventional sign can vary).
    // We only check magnitude here; sign convention is consistent with cross_track formula.
    // North should be left (positive) when going east, south should be negative.
    // Verify north vs south are opposite sign.
    let ct2_sign = ct2
    let ct3_sign = ct3
    // If north is positive, south is negative (or vice versa) — they must differ in sign.
    let product = ct2_sign * ct3_sign
    if product > 0.0
        print("FAIL cross_track north and south should have opposite signs: " + str(ct2) + " " + str(ct3))
        exit(1)

    print("PASS _cross_track_test")
