import forge_geo_ip

fn main()
    let g = geo_new()
    g = geo_add(g, "192.168.", "US", "New York")
    g = geo_add(g, "10.0.", "DE", "Berlin")
    g = geo_add(g, "172.16.", "JP", "Tokyo")
    assert(geo_entry_count(g) == 3, "3 entries")

    let r1 = geo_lookup(g, "192.168.1.1")
    assert(is_ok(r1), "lookup ok")
    assert(unwrap(r1) == "US", "US")

    let c1 = geo_city(g, "10.0.0.5")
    assert(is_ok(c1), "city ok")
    assert(unwrap(c1) == "Berlin", "Berlin")

    let r2 = geo_lookup(g, "8.8.8.8")
    assert(is_err(r2), "no data")

    assert(geo_total_lookups(g) == 2, "2 lookups")
    assert(geo_hit_count(g) == 1, "1 hit")

    print("GEO-IP KAT PASS")
