fn double(x: int) -> int
    x * 2

fn greet(name: string) -> string
    "Hello, " + name + "!"

fn add(a: int, b: int) -> int
    a + b

fn negate(x: int) -> int
    0 - x

fn square(x: int) -> int
    x * x

fn main()
    let r1 = 5.double()
    assert(r1 == 10, "UFCS: 5.double() == 10")

    let r2 = "World".greet()
    assert(r2 == "Hello, World!", "UFCS: greet on string")

    let r3 = 3.add(7)
    assert(r3 == 10, "UFCS: 3.add(7) == 10")

    let r4 = 5.negate()
    assert(r4 == -5, "UFCS: negate")

    let r5 = 4.square()
    assert(r5 == 16, "UFCS: square")

    let r6 = 3.double().double()
    assert(r6 == 12, "UFCS: chain double.double")

    let nums = [1, 2, 3]
    let doubled = nums.map(fn(x) x * 2)
    assert(doubled[0] == 2, "method: map")
    assert(doubled[1] == 4, "method: map")

    let evens = [1, 2, 3, 4, 5].filter(fn(x) x % 2 == 0)
    assert(len(evens) == 2, "UFCS: filter")
    assert(evens[0] == 2, "UFCS: filter[0]")

    let s = str(42)
    assert(s == "42", "builtin: str")

    let n = len("hello")
    assert(n == 5, "builtin: len")

    let parts = "a,b,c".split(",")
    assert(len(parts) == 3, "UFCS: split")

    let t = "  hi  ".trim()
    assert(t == "hi", "UFCS: trim")

    let u = "hello".upper()
    assert(u == "HELLO", "UFCS: upper")

    print("ufcs_test: all passed")
