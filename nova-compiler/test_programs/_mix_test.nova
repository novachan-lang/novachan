// KAT test for std/audio/mix.nova
//
// Hand-computed reference values:
//   mix_two(1.0, 0.0, 0.5)          = 0.5    (50% blend)
//   mix_two(0.0, 1.0, 0.25)         = 0.25   (25% toward b)
//   mix_two(1.0, 0.0, 0.0)          = 1.0    (full a)
//   mix_two(0.0, 1.0, 1.0)          = 1.0    (full b)
//   mix_two(0.2, 0.8, 0.5)          = 0.5    (midpoint)
//   average([1.0, 2.0, 3.0])        = 2.0
//   average([])                      = 0.0
//   sum_gain([1.0, 2.0], 0.5)       = [0.5, 1.0]

import std/audio/mix

// approx: true if |a-b| < tol
fn approx(a: float, b: float, tol: float) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < tol
        return 1
    return 0

fn ckf(label: string, got: float, want: float)
    let ok = approx(got, want, 0.0001)
    if ok == 0
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckf_list(label: string, got: list, want: list)
    let ng = len(got)
    let nw = len(want)
    if ng != nw
        print("FAIL " + label + " length: got " + str(ng) + " want " + str(nw))
        exit(1)
    let i = 0
    while i < nw
        let gv = got[i] * 1.0
        let wv = want[i] * 1.0
        let ok = approx(gv, wv, 0.0001)
        if ok == 0
            print("FAIL " + label + "[" + str(i) + "]: got " + str(gv) + " want " + str(wv))
            exit(1)
        i = i + 1

fn main()
    // ── KAT 1: mix_two(1.0, 0.0, 0.5) == 0.5 ───────────────────────────────
    let r1 = mix_two(1.0, 0.0, 0.5)
    ckf("mix_two_half", r1, 0.5)

    // ── KAT 2: mix_two(0.0, 1.0, 0.25) == 0.25 ─────────────────────────────
    let r2 = mix_two(0.0, 1.0, 0.25)
    ckf("mix_two_quarter", r2, 0.25)

    // ── KAT 3: mix_two(1.0, 0.0, 0.0) == 1.0 (full a) ──────────────────────
    let r3 = mix_two(1.0, 0.0, 0.0)
    ckf("mix_two_full_a", r3, 1.0)

    // ── KAT 4: mix_two(0.0, 1.0, 1.0) == 1.0 (full b) ──────────────────────
    let r4 = mix_two(0.0, 1.0, 1.0)
    ckf("mix_two_full_b", r4, 1.0)

    // ── KAT 5: mix_two(0.2, 0.8, 0.5) == 0.5 (midpoint) ────────────────────
    let r5 = mix_two(0.2, 0.8, 0.5)
    ckf("mix_two_midpoint", r5, 0.5)

    // ── KAT 6: average([1.0, 2.0, 3.0]) == 2.0 ─────────────────────────────
    let s6 = []
    push(s6, 1.0)
    push(s6, 2.0)
    push(s6, 3.0)
    let r6 = average(s6)
    ckf("average_123", r6, 2.0)

    // ── KAT 7: average([]) == 0.0 ───────────────────────────────────────────
    let s7 = []
    let r7 = average(s7)
    ckf("average_empty", r7, 0.0)

    // ── KAT 8: average([5.0]) == 5.0 (single element) ───────────────────────
    let s8 = []
    push(s8, 5.0)
    let r8 = average(s8)
    ckf("average_single", r8, 5.0)

    // ── KAT 9: sum_gain([1.0, 2.0], 0.5) == [0.5, 1.0] ─────────────────────
    let s9 = []
    push(s9, 1.0)
    push(s9, 2.0)
    let want9 = []
    push(want9, 0.5)
    push(want9, 1.0)
    let r9 = sum_gain(s9, 0.5)
    ckf_list("sum_gain_half", r9, want9)

    // ── KAT 10: sum_gain([0.5, 1.0], 2.0) == [1.0, 2.0] ────────────────────
    let s10 = []
    push(s10, 0.5)
    push(s10, 1.0)
    let want10 = []
    push(want10, 1.0)
    push(want10, 2.0)
    let r10 = sum_gain(s10, 2.0)
    ckf_list("sum_gain_double", r10, want10)

    // ── KAT 11: sum_gain([], 3.0) == [] (empty input) ───────────────────────
    let s11 = []
    let r11 = sum_gain(s11, 3.0)
    cki("sum_gain_empty_len", len(r11), 0)

    // ── KAT 12: average([4.0, 4.0, 4.0]) == 4.0 (uniform) ──────────────────
    let s12 = []
    push(s12, 4.0)
    push(s12, 4.0)
    push(s12, 4.0)
    let r12 = average(s12)
    ckf("average_uniform", r12, 4.0)

    print("PASS _mix_test")
