fn _cle_argv_val(argv, name) -> string
    let n = len(argv)
    let nlen = len(name)
    let i = 0
    while i < n
        let tok = argv[i]
        if tok == name
            if i + 1 < n
                return argv[i+1]
            return ""
        if len(tok) > nlen
            if slice(tok, 0, nlen) == name
                if slice(tok, nlen, nlen+1) == "="
                    return slice(tok, nlen+1, len(tok))
        i = i + 1
    return ""

fn main()
    let a1 = ["--port", "9"]
    let v = _cle_argv_val(a1, "--port")
    print("val='" + v + "' len=" + str(len(v)))
