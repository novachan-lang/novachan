// REGRESSION TEST for a CONFIRMED NOVA codegen defect: binding an if-expression whose branches
// produce DIFFERENT ENUM PAYLOAD SHAPES to a single `let` corrupts the resulting value.
//
// MEASURED (gen3_test.exe, 2026-09-04):
//   let r = if c            -> reading pb_tag (a string field) yields  0
//       mk_a(...)           -> the same value via an EARLY RETURN per branch reads correctly
//   else
//       mk_b(...)
//
// Found while debugging prism/app/prism_form.nova, where `_prism_fm_apply_raw` merged seven
// constructor branches (text/email/password/number/range/choice/toggle -- each a different
// PrismFormFieldKind payload) into one `let fresh_r = if ...`. The corrupted field did not fail
// where it was built: it faulted LATER with an ACCESS VIOLATION when the rebuilt field was read
// back, which is why it presented as a crash in an unrelated function.
//
// The fix is structural: EARLY RETURN per branch, with any shared tail factored into a helper.
// This test FAILS while the defect is live.
enum BmKind
    BmA(bm_s: string)
    BmB(bm_n: int, bm_m: int)

type BmBox
    bm_kind: BmKind
    bm_tag: string

fn bm_mk_a(s: string) -> Result<BmBox>
    ok(BmBox(BmA(s), "a"))

fn bm_mk_b(n: int, m: int) -> Result<BmBox>
    ok(BmBox(BmB(n, m), "b"))

fn bm_merged(which: string) -> Result<BmBox>
    let r = if which == "a"
        bm_mk_a("hello")
    else
        bm_mk_b(1, 2)
    ok(r?)

fn bm_early(which: string) -> Result<BmBox>
    if which == "a"
        return ok(bm_mk_a("hello")?)
    ok(bm_mk_b(1, 2)?)

fn main()
    // Control: the early-return form must be correct, or this test proves nothing.
    let e = unwrap(bm_early("a"))
    if e.bm_tag != "a"
        print("FAIL assert: even the EARLY-RETURN form is wrong (got '{e.bm_tag}') -- this test's control is broken")
        exit(1)
    let m = unwrap(bm_merged("a"))
    if m.bm_tag != "a"
        print("FAIL assert: merging heterogeneous enum-payload branches through one `let` corrupted a string field (got '{m.bm_tag}', want 'a')")
        exit(1)
    print("ok branch-merge preserves struct fields")
