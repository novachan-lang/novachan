// _kat_uritemplate.nova — KAT probe for std/net/uritemplate (RFC 6570)
// Brace chars are built via chr(123)/chr(125) — a literal '{' in a NOVA
// string literal starts interpolation, so template strings are assembled
// from these instead of written as literal "{...}" source text.
import std/net/uritemplate

let OB = chr(123)
let CB = chr(125)

fn _br(inner) -> string
    chr(123) + inner + chr(125)

let _c = [0, 0]

fn _check(name: string, got: string, want: string, c: list)
    if got == want
        c[0] = c[0] + 1
        print("OK " + name)
    else
        c[1] = c[1] + 1
        print("FAIL " + name + ": want [" + want + "] got [" + got + "]")

// ── KAT 1-8: single-variable operator expanders (RFC 6570 sec 1.2/3.2) ────
_check("simple-var", ut_simple("var", "value"), "value", _c)
_check("simple-hello", ut_simple("hello", "Hello World!"), "Hello%20World%21", _c)
_check("reserved-var", ut_reserved("var", "value"), "value", _c)
_check("reserved-hello", ut_reserved("hello", "Hello World!"), "Hello%20World!", _c)
_check("fragment-var", ut_fragment("var", "value"), "#value", _c)
_check("fragment-hello", ut_fragment("hello", "Hello World!"), "#Hello%20World!", _c)
_check("label", ut_label("who", "fred"), ".fred", _c)
_check("path", ut_path("who", "fred"), "/fred", _c)

// ── KAT 9-13: named operators + the empty-value rule (";" omits "=") ──────
_check("query", ut_query("who", "fred"), "?who=fred", _c)
_check("form", ut_form("who", "fred"), "&who=fred", _c)
_check("matrix", ut_matrix("who", "fred"), ";who=fred", _c)
_check("matrix-empty", ut_matrix("empty", ""), ";empty", _c)
_check("query-empty", ut_query("empty", ""), "?empty=", _c)

// ── KAT 14: Level 4 explode on a plain array (== non-explode comma-join) ──
let colors = ["red", "green", "blue"]
_check("explode-list", ut_explode("list", colors), "red,green,blue", _c)

// ── KAT 15-16: ut_vars — name extraction, dedup, first-occurrence order ───
let t_vars1 = "http://ex.com/~" + _br("user") + "/"
let vars1 = ut_vars(t_vars1)
if len(vars1) == 1 and vars1[0] == "user"
    _c[0] = _c[0] + 1
    print("OK vars-single")
else
    _c[1] = _c[1] + 1
    print("FAIL vars-single: got len=" + str(len(vars1)))

let t_vars2 = _br("x,y") + _br("x")
let vars2 = ut_vars(t_vars2)
if len(vars2) == 2 and vars2[0] == "x" and vars2[1] == "y"
    _c[0] = _c[0] + 1
    print("OK vars-multi-dedup")
else
    _c[1] = _c[1] + 1
    print("FAIL vars-multi-dedup: got len=" + str(len(vars2)))

// ── KAT 17: ut_parse — unterminated expression is Err ─────────────────────
let bad = OB + "unterminated"
let pr_bad = ut_parse(bad)
if is_err(pr_bad)
    _c[0] = _c[0] + 1
    print("OK parse-unterminated-err")
else
    _c[1] = _c[1] + 1
    print("FAIL parse-unterminated-err: expected Err")

// ── KAT 18: ut_parse — well-formed template segment count ─────────────────
let t_ok = "a" + _br("b") + "c"
let pr_ok = ut_parse(t_ok)
if is_ok(pr_ok)
    let parsed_ok = unwrap(pr_ok)
    let ks = parsed_ok["kinds"]
    let txs = parsed_ok["texts"]
    if len(ks) == 3 and ks[0] == "lit" and ks[1] == "expr" and ks[2] == "lit" and txs[0] == "a" and txs[1] == "b" and txs[2] == "c"
        _c[0] = _c[0] + 1
        print("OK parse-segments")
    else
        _c[1] = _c[1] + 1
        print("FAIL parse-segments: unexpected structure")
else
    _c[1] = _c[1] + 1
    print("FAIL parse-segments: expected Ok")

// ── KAT 19-27: ut_expand against RFC 6570's own worked examples ───────────
let v = {}
v["var"] = "value"
v["hello"] = "Hello World!"
v["path"] = "/foo/bar"
v["who"] = "fred"
v["x"] = "1024"
v["y"] = "768"
v["empty"] = ""

_check("expand-simple", ut_expand(_br("var"), v), "value", _c)
_check("expand-reserved-path", ut_expand(_br("+path") + "/here", v), "/foo/bar/here", _c)
_check("expand-fragment", ut_expand(_br("#var"), v), "#value", _c)
_check("expand-label", ut_expand(_br(".who"), v), ".fred", _c)
_check("expand-path", ut_expand(_br("/who"), v), "/fred", _c)
_check("expand-matrix", ut_expand(_br(";who"), v), ";who=fred", _c)
_check("expand-query", ut_expand(_br("?who"), v), "?who=fred", _c)
_check("expand-form", ut_expand(_br("&who"), v), "&who=fred", _c)
_check("expand-query-multi", ut_expand(_br("?x,y"), v), "?x=1024&y=768", _c)
_check("expand-default-multi", ut_expand("map?" + _br("x,y"), v), "map?1024,768", _c)

// ── KAT 28: prefix-length modifier {var:3} ─────────────────────────────────
_check("expand-prefix-trunc", ut_expand(_br("var:3"), v), "val", _c)

// ── KAT 29: undefined variable in a single-var expression -> "" ───────────
_check("expand-undefined", ut_expand(_br("/who"), {}), "", _c)

// ── KAT 30: one defined + one undefined in a multi-var expression ─────────
let v_partial = {}
v_partial["x"] = "1024"
_check("expand-partial-defined", ut_expand(_br("?x,y"), v_partial), "?x=1024", _c)

print("")
print("PASS=" + str(_c[0]) + " FAIL=" + str(_c[1]))
if _c[1] == 0
    print("ALL PASSED")
else
    exit(1)
