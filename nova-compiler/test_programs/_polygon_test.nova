// KAT for std/geometry/polygon
// Tests: pg_area2, pg_area, pg_perimeter, pg_centroid, pg_contains, pg_is_convex.
import std/geometry/polygon

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckf(label, got, want)
    let hi = want + 0.001
    let lo = want - 0.001
    if got > hi
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)
    if got < lo
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    let goti = 0
    if got
        goti = 1
    let wanti = 0
    if want
        wanti = 1
    if goti != wanti
        print("FAIL " + label + ": got=" + str(goti) + " want=" + str(wanti))
        exit(1)

fn main()
    // Square: (0,0),(4,0),(4,4),(0,4) CCW winding
    let sq = [[0,0],[4,0],[4,4],[0,4]]

    // KAT 1: pg_area2 — 2x signed area via shoelace = 32
    let a2 = pg_area2(sq)
    cki("pg_area2(sq)", a2, 32)

    // KAT 2: pg_area — absolute area = 16.0
    let a = pg_area(sq)
    ckf("pg_area(sq)", a, 16.0)

    // KAT 3: pg_perimeter — 4 sides of length 4 each = 16.0
    let p = pg_perimeter(sq)
    ckf("pg_perimeter(sq)", p, 16.0)

    // KAT 4: pg_contains — interior point (2,2) is inside
    let c1 = pg_contains(sq, 2, 2)
    ckb("pg_contains(sq,2,2)", c1, true)

    // KAT 5: pg_contains — exterior point (5,5) is outside
    let c2 = pg_contains(sq, 5, 5)
    ckb("pg_contains(sq,5,5)", c2, false)

    // KAT 6: pg_is_convex square — must be convex
    let cv1 = pg_is_convex(sq)
    ckb("pg_is_convex(sq)", cv1, true)

    // KAT 7: pg_is_convex non-convex — vertex (1,1) dents inward
    let nonconvex = [[0,0],[4,0],[1,1],[4,4],[0,4]]
    let cv2 = pg_is_convex(nonconvex)
    ckb("pg_is_convex(nonconvex)", cv2, false)

    // KAT 8: pg_centroid — centroid of square = [2.0, 2.0]
    let cen = pg_centroid(sq)
    let cenx = cen[0]
    let ceny = cen[1]
    ckf("pg_centroid(sq).x", cenx, 2.0)
    ckf("pg_centroid(sq).y", ceny, 2.0)

    // KAT 9: pg_area2 of triangle (0,0),(4,0),(0,3) = 12
    let tri = [[0,0],[4,0],[0,3]]
    let ta2 = pg_area2(tri)
    cki("pg_area2(tri)", ta2, 12)

    // KAT 10: pg_contains — point clearly to the left, outside
    let c3 = pg_contains(sq, 6, 2)
    ckb("pg_contains(sq,6,2)", c3, false)

    // KAT 11: pg_perimeter of 3-4-5 right triangle = 12.0
    let rtri = [[0,0],[3,0],[0,4]]
    let rp = pg_perimeter(rtri)
    ckf("pg_perimeter(rtri)", rp, 12.0)

    // KAT 12: pg_is_convex triangle — always convex
    let cv3 = pg_is_convex(tri)
    ckb("pg_is_convex(tri)", cv3, true)

    print("_polygon_test passed")
