import std/graph/connected

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // =========================================================================
    // PRIMARY EXAMPLE: 3 components
    //   {A,B}, {C,D}, {E}
    //   A-B, C-D, E isolated
    // =========================================================================
    let g = {}
    g["A"] = ["B"]
    g["B"] = ["A"]
    g["C"] = ["D"]
    g["D"] = ["C"]
    g["E"] = []
    let nodes = ["A", "B", "C", "D", "E"]

    // KAT 1: cc_count == 3
    cki("kat1_cc_count", connected.cc_count(g, nodes), 3)

    // KAT 2: cc_is_connected == false (3 components)
    let is_conn = connected.cc_is_connected(g, nodes)
    if is_conn == true
        print("FAIL kat2_is_connected: expected false")
        exit(1)

    // KAT 3: cc_component_of A == ["A","B"]
    let comp_a = connected.cc_component_of(g, nodes, "A")
    cki("kat3_comp_a_len", len(comp_a), 2)
    cks("kat3_comp_a_0", comp_a[0], "A")
    cks("kat3_comp_a_1", comp_a[1], "B")

    // KAT 4: cc_component_of E == ["E"]
    let comp_e = connected.cc_component_of(g, nodes, "E")
    cki("kat4_comp_e_len", len(comp_e), 1)
    cks("kat4_comp_e_0", comp_e[0], "E")

    // KAT 5: cc_components returns 3 components, first component is ["A","B"]
    let comps = connected.cc_components(g, nodes)
    cki("kat5_comps_len", len(comps), 3)
    // first component (sorted by smallest member = "A") -> ["A","B"]
    let c0 = comps[0]
    cki("kat5_c0_len", len(c0), 2)
    cks("kat5_c0_0", c0[0], "A")
    cks("kat5_c0_1", c0[1], "B")

    // KAT 6: second component is ["C","D"]
    let c1 = comps[1]
    cki("kat6_c1_len", len(c1), 2)
    cks("kat6_c1_0", c1[0], "C")
    cks("kat6_c1_1", c1[1], "D")

    // KAT 7: third component is ["E"]
    let c2 = comps[2]
    cki("kat7_c2_len", len(c2), 1)
    cks("kat7_c2_0", c2[0], "E")

    // =========================================================================
    // SECONDARY EXAMPLE: fully connected graph A-B-C (path)
    //   cc_count == 1; cc_is_connected == true
    // =========================================================================
    let g2 = {}
    g2["A"] = ["B"]
    g2["B"] = ["A", "C"]
    g2["C"] = ["B"]
    let nodes2 = ["A", "B", "C"]

    // KAT 8: cc_count == 1
    cki("kat8_connected_count", connected.cc_count(g2, nodes2), 1)

    // KAT 9: cc_is_connected == true
    let is_conn2 = connected.cc_is_connected(g2, nodes2)
    if is_conn2 == false
        print("FAIL kat9_is_connected2: expected true")
        exit(1)

    // KAT 10: cc_component_of any node gives all 3 (sorted: A,B,C)
    let comp_b = connected.cc_component_of(g2, nodes2, "B")
    cki("kat10_comp_b_len", len(comp_b), 3)
    cks("kat10_comp_b_0", comp_b[0], "A")
    cks("kat10_comp_b_1", comp_b[1], "B")
    cks("kat10_comp_b_2", comp_b[2], "C")

    // =========================================================================
    // EDGE CASE: single isolated node
    // =========================================================================
    let g3 = {}
    g3["X"] = []
    let nodes3 = ["X"]
    cki("kat11_single_count", connected.cc_count(g3, nodes3), 1)
    let is_conn3 = connected.cc_is_connected(g3, nodes3)
    if is_conn3 == false
        print("FAIL kat11_single_connected: expected true")
        exit(1)

    print("_connected_test passed")

main()
