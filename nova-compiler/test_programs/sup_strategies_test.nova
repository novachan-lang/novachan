// Erlang-class supervision STRATEGIES, the NOVA way — pure stdlib over spawn + channel.
// Erlang's one_for_all/rest_for_one terminate healthy children and restart a set; NOVA
// has no preemptive kill (let-it-crash, no forced termination), so the honest model is:
// a child is a RESTARTABLE unit, and a strategy decides WHICH children to re-run when one
// fails. This covers the real supervision use case (restartable workers/servers) with no
// runtime change. Strategies:
//   one_for_one  — re-run only the failed child
//   one_for_all  — any failure re-runs ALL children (incl. healthy ones)
//   rest_for_one — re-run the failed child and every child started after it
//
// child spec = fn(attempt) -> [ok, payload]   (ok=1 success, 0 failure; deterministic per attempt)
// supervise_all(specs, strategy, max_restarts) -> [all_ok, total_restarts, runs_per_child, payloads]

fn supervise_all(specs, strategy, max_restarts)
    let n = len(specs)
    let ok = []
    let payload = []
    let attempt = []
    let runs = []
    let i = 0
    while i < n
        push(ok, 0)
        push(payload, 0)
        push(attempt, 0)
        push(runs, 0)
        i = i + 1
    let total_restarts = 0
    let rounds = 0
    let all_ok = 0
    while all_ok == 0 and rounds <= max_restarts
        // Spawn every not-yet-succeeded child concurrently with its current attempt count.
        let ch = channel()
        let pending = 0
        let j = 0
        while j < n
            if ok[j] == 0
                let jj = j
                let aa = attempt[j]
                let sp = specs[j]
                runs[j] = runs[j] + 1
                spawn fn()
                    let r = sp(aa)
                    send(ch, [jj, r[0], r[1]])
                pending = pending + 1
            j = j + 1
        // Collect this round's results; track the lowest-index failure for rest_for_one.
        let got = 0
        let failed_min = n
        while got < pending
            let m = receive(ch)
            let cid = m[0]
            ok[cid] = m[1]
            payload[cid] = m[2]
            if m[1] == 0 and cid < failed_min
                failed_min = cid
            got = got + 1
        // Did everyone succeed?
        all_ok = 1
        let k = 0
        while k < n
            if ok[k] == 0
                all_ok = 0
            k = k + 1
        if all_ok == 0 and rounds < max_restarts
            // A restart only happens when there is budget for another round; the final
            // failed round gives up (it is not counted as a restart).
            total_restarts = total_restarts + 1
            // Apply the strategy: which children get terminated + restarted next round.
            let s = 0
            while s < n
                let restart = 0
                if strategy == "one_for_one"
                    if ok[s] == 0
                        restart = 1
                else if strategy == "one_for_all"
                    restart = 1
                else if strategy == "rest_for_one"
                    if s >= failed_min
                        restart = 1
                if restart == 1
                    ok[s] = 0
                    attempt[s] = attempt[s] + 1
                s = s + 1
        rounds = rounds + 1
    return [all_ok, total_restarts, runs, payload]

// ── Test children (deterministic per attempt) ───────────────────────────────
fn c_ok0(attempt)
    [1, 10]                 // always succeeds
fn c_flaky1(attempt)
    if attempt < 1
        [0, 0]              // fails first attempt
    else
        [1, 21]             // succeeds on restart
fn c_ok2(attempt)
    [1, 32]

fn main()
    let specs = [c_ok0, c_flaky1, c_ok2]

    // one_for_one: only c1 (the failure) restarts. c0,c2 run once; c1 runs twice.
    let r1 = supervise_all(specs, "one_for_one", 5)
    assert_eq(r1[0], 1)                 // all eventually ok
    assert_eq(r1[1], 1)                 // exactly one restart round
    assert_eq(r1[2], [1, 2, 1])         // runs per child
    assert_eq(r1[3], [10, 21, 32])      // payloads

    // one_for_all: c1's failure restarts ALL — every child runs twice.
    let r2 = supervise_all(specs, "one_for_all", 5)
    assert_eq(r2[0], 1)
    assert_eq(r2[1], 1)
    assert_eq(r2[2], [2, 2, 2])         // all re-run
    assert_eq(r2[3], [10, 21, 32])

    // rest_for_one: c1 (index 1) fails -> restart index 1 and 2. c0 runs once.
    let r3 = supervise_all(specs, "rest_for_one", 5)
    assert_eq(r3[0], 1)
    assert_eq(r3[1], 1)
    assert_eq(r3[2], [1, 2, 2])         // c0 once; c1,c2 twice
    assert_eq(r3[3], [10, 21, 32])

    // exhaustion: a permanently-failing child gives up after max_restarts (one_for_all).
    let always_fail = fn(attempt) [0, 0]
    let r4 = supervise_all([c_ok0, always_fail], "one_for_all", 3)
    assert_eq(r4[0], 0)                 // never fully recovered
    assert_eq(r4[1], 3)                 // restarted exactly max_restarts times

    print("sup_strategies_test passed")
