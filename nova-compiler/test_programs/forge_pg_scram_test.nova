// Forge S9: PostgreSQL SCRAM-SHA-256 client, gated against the RFC 7677 worked example (user "user",
// password "pencil", 4096 iterations). Asserts the ClientProof and the ServerSignature exactly. Pure
// crypto + string math, no PG server. NOTE 4096 PBKDF2 iterations -> ~8k SHA-256 calls (may run a few s).
import forge_pg

fn main()
    let user = "user"
    let password = "pencil"
    let cnonce = "rOprNGfwEbeRWgbNEkqO"

    // client-first
    let cf = pg_scram_client_first(user, cnonce)
    if cf != "n,,n=user,r=rOprNGfwEbeRWgbNEkqO"
        print("FAIL: client-first -> " + cf)
        exit(1)

    // server-first (as PG would send) -> compute client-final + server signature
    let server_first = "r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096"
    let res = pg_scram_finish(user, password, cnonce, server_first)

    let want_final = "c=biws,r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,p=dHzbZapWIk4jUhN+Ute9ytag9zjfMHgsqmmiz7AndVQ="
    if res[0] != want_final
        print("FAIL: client-final -> " + res[0])
        exit(1)
    if res[1] != "6rriTRBi23WpRR/wtup+mMhUZUn/dB5nLTJRsjl95G4="
        print("FAIL: server-signature -> " + res[1])
        exit(1)

    // RFC 5802 nonce binding: a server-first whose nonce does NOT begin with our client nonce must be
    // rejected (return []) -- a server/MITM cannot substitute its own nonce.
    let evil_sf = "r=EVILnonceDoesNotStartWithOurs,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096"
    let evil = pg_scram_finish(user, password, cnonce, evil_sf)
    if len(evil) != 0
        print("FAIL: server nonce not extending client nonce must be rejected")
        exit(1)

    // a server nonce equal to (not extending) the client nonce is also rejected
    let noext_sf = "r=" + cnonce + ",s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096"
    if len(pg_scram_finish(user, password, cnonce, noext_sf)) != 0
        print("FAIL: non-extending server nonce must be rejected")
        exit(1)

    // a non-positive iteration count must be rejected
    let badi_sf = "r=" + cnonce + "SERVERPART,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=0"
    if len(pg_scram_finish(user, password, cnonce, badi_sf)) != 0
        print("FAIL: zero iteration count must be rejected")
        exit(1)

    print("PASS forge_pg_scram (RFC 7677 ClientProof + ServerSignature + RFC 5802 nonce-binding + iter guard)")
