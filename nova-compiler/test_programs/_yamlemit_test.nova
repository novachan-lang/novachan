// KAT probe for std/data/yamlemit — YAML block + flow emitter.
//
// All expected values are hand-computed against YAML 1.2 spec and the
// module spec.  Newlines represented as chr(10); braces via chr(123)/chr(125).
import std/data/yamlemit

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got=|" + got + "| want=|" + want + "|")
        exit(1)

fn main()
    let nl = chr(10)
    let lb = chr(123)
    let rb = chr(125)

    // ── KAT 1: dict with string + int values, keys sorted ────────────────────
    // ye_emit({"name":"nova","version":1}) == "name: nova\nversion: 1\n"
    let d1 = {}
    d1["name"] = "nova"
    d1["version"] = 1
    let r1 = ye_emit(d1)
    let want1 = "name: nova" + nl + "version: 1" + nl
    cks("kat1-dict-sorted", r1, want1)
    print("KAT 1 PASS: dict with string+int, sorted keys")

    // ── KAT 2: list of strings ────────────────────────────────────────────────
    // ye_emit(["a","b"]) == "- a\n- b\n"
    let lst2 = []
    lst2.push("a")
    lst2.push("b")
    let r2 = ye_emit(lst2)
    let want2 = "- a" + nl + "- b" + nl
    cks("kat2-list-strings", r2, want2)
    print("KAT 2 PASS: list of strings")

    // ── KAT 3: nested dict (one level deep) ───────────────────────────────────
    // ye_emit({"a":{"b":1}}) == "a:\n  b: 1\n"
    let inner3 = {}
    inner3["b"] = 1
    let d3 = {}
    d3["a"] = inner3
    let r3 = ye_emit(d3)
    let want3 = "a:" + nl + "  b: 1" + nl
    cks("kat3-nested-dict", r3, want3)
    print("KAT 3 PASS: nested dict with 2-space indent")

    // ── KAT 4: flow dict ──────────────────────────────────────────────────────
    // ye_emit_flow({"a":1}) == "{a: 1}"
    let d4 = {}
    d4["a"] = 1
    let r4 = ye_emit_flow(d4)
    let want4 = lb + "a: 1" + rb
    cks("kat4-flow-dict", r4, want4)
    print("KAT 4 PASS: flow dict {a: 1}")

    // ── KAT 5: flow list ──────────────────────────────────────────────────────
    // ye_emit_flow([1,2,3]) == "[1, 2, 3]"
    let lst5 = []
    lst5.push(1)
    lst5.push(2)
    lst5.push(3)
    let r5 = ye_emit_flow(lst5)
    cks("kat5-flow-list", r5, "[1, 2, 3]")
    print("KAT 5 PASS: flow list [1, 2, 3]")

    // ── KAT 6: string that needs quoting (contains colon) ─────────────────────
    // ye_emit({"k":"a: b"}) — value "a: b" must be double-quoted
    let d6 = {}
    d6["k"] = "a: b"
    let r6 = ye_emit(d6)
    let dq = chr(34)
    // value "a: b" contains ':' -> must be quoted -> "a: b"
    let want6 = "k: " + dq + "a: b" + dq + nl
    cks("kat6-quoting-colon", r6, want6)
    print("KAT 6 PASS: string with colon is double-quoted")

    // ── KAT 7: string that needs quoting (YAML keyword "true") ───────────────
    // ye_emit({"flag":"true"}) — string "true" must be quoted to stay a string
    let d7 = {}
    d7["flag"] = "true"
    let r7 = ye_emit(d7)
    let want7 = "flag: " + dq + "true" + dq + nl
    cks("kat7-quoting-bool-keyword", r7, want7)
    print("KAT 7 PASS: string 'true' is double-quoted")

    // ── KAT 8: flow dict with two keys, sorted ────────────────────────────────
    // ye_emit_flow({"b":2,"a":1}) == "{a: 1, b: 2}"
    let d8 = {}
    d8["b"] = 2
    d8["a"] = 1
    let r8 = ye_emit_flow(d8)
    let want8 = lb + "a: 1, b: 2" + rb
    cks("kat8-flow-dict-sorted", r8, want8)
    print("KAT 8 PASS: flow dict with two keys sorted")

    // ── KAT 9: empty list ────────────────────────────────────────────────────
    // ye_emit([]) == ""  (empty collection = empty string)
    let lst9 = []
    let r9 = ye_emit(lst9)
    cks("kat9-empty-list", r9, "")
    print("KAT 9 PASS: empty list -> empty string")

    // ── KAT 10: list of ints ─────────────────────────────────────────────────
    // ye_emit([10, 20, 30]) == "- 10\n- 20\n- 30\n"
    let lst10 = []
    lst10.push(10)
    lst10.push(20)
    lst10.push(30)
    let r10 = ye_emit(lst10)
    let want10 = "- 10" + nl + "- 20" + nl + "- 30" + nl
    cks("kat10-list-ints", r10, want10)
    print("KAT 10 PASS: list of ints")

    // ── KAT 11: round-trip check (flow) — nested dict ─────────────────────────
    // ye_emit_flow({"x":{"y":2}}) == "{x: {y: 2}}"
    let inner11 = {}
    inner11["y"] = 2
    let d11 = {}
    d11["x"] = inner11
    let r11 = ye_emit_flow(d11)
    let want11 = lb + "x: " + lb + "y: 2" + rb + rb
    cks("kat11-flow-nested-dict", r11, want11)
    print("KAT 11 PASS: flow nested dict")

    // ── KAT 12: bare string (no quoting needed) ───────────────────────────────
    // ye_emit({"lang":"nova_lang"}) == "lang: nova_lang\n"
    let d12 = {}
    d12["lang"] = "nova_lang"
    let r12 = ye_emit(d12)
    let want12 = "lang: nova_lang" + nl
    cks("kat12-bare-string", r12, want12)
    print("KAT 12 PASS: bare string without quoting")

    print("_yamlemit_test passed")
