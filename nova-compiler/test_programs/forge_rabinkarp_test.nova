import forge_rabinkarp

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn map_str(xs: list) -> list
    let out = []
    let i = 0
    while i < len(xs)
        push(out, str(xs[i]))
        i = i + 1
    out

fn join_str(xs: list, sep: string) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + sep
        out = out + xs[i]
        i = i + 1
    out

fn main()
    let fails = 0

    // exact hash values (all < modulus, so deterministic)
    fails = fails + expect("hash_A", str(rk_hash("A")), "65")
    fails = fails + expect("hash_AB", str(rk_hash("AB")), "16706")
    fails = fails + expect("hash_ABC", str(rk_hash("ABC")), "4276803")
    fails = fails + expect("hash_empty", str(rk_hash("")), "0")
    // equal strings hash equal
    fails = fails + expect("hash_eq", str(rk_hash("hello") == rk_hash("hello")), "true")

    // search (first index) -- must match KMP/Z results
    fails = fails + expect("s_basic", str(rk_search("abxabcabcaby", "abcaby")), "6")
    fails = fails + expect("s_absent", str(rk_search("hello world", "xyz")), "-1")
    fails = fails + expect("s_at0", str(rk_search("abcdef", "abc")), "0")
    fails = fails + expect("s_atend", str(rk_search("abcdef", "def")), "3")
    fails = fails + expect("s_empty", str(rk_search("abc", "")), "0")
    fails = fails + expect("s_full", str(rk_search("abc", "abc")), "0")
    fails = fails + expect("s_longer", str(rk_search("abc", "abcd")), "-1")
    fails = fails + expect("s_single", str(rk_search("aaaaa", "a")), "0")

    // find all (overlapping)
    fails = fails + expect("all_aa", join_str(map_str(rk_find_all("aaaa", "aa")), ","), "0,1,2")
    fails = fails + expect("all_ana", join_str(map_str(rk_find_all("banana", "ana")), ","), "1,3")
    fails = fails + expect("all_abc", join_str(map_str(rk_find_all("abcabcabc", "abc")), ","), "0,3,6")
    fails = fails + expect("count_aa", str(rk_count("aaaa", "aa")), "3")
    fails = fails + expect("count_none", str(rk_count("abcabc", "xy")), "0")

    // stress: long repetitive text (worst case for naive), verify correctness
    let big = ""
    let k = 0
    while k < 50
        big = big + "ab"
        k = k + 1
    // "abab...ab" (100 chars), pattern "abab" occurs at 0,2,4,...,96 -> 49 times
    fails = fails + expect("stress_count", str(rk_count(big, "abab")), "49")

    if fails == 0
        print("forge_rabinkarp: all passed")
    else
        print("forge_rabinkarp: " + str(fails) + " FAILED")
