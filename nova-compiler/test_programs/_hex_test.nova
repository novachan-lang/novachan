// KAT probe for std/encoding/hex — binary-safe hex codec.
// All KATs from spec: encode "abc" bytes, round-trips, 0x00/0xFF safety.
import std/encoding/hex

// ── Helpers ───────────────────────────────────────────────────────────────────

// Build a bytes value from an ASCII string (no 0x00 chars in args here).
fn _b_from_str(s: string) -> any
    let out = bytes(0)
    let i = 0
    while i < len(s)
        out = bytes_append(out, ord(char_at(s, i)))
        i = i + 1
    return out

fn ck_str(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn ck_int(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck_byte(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ── KAT 1: hex_encode of ASCII bytes of "abc" == "616263" ────────────────────
fn kat1()
    let data = _b_from_str("abc")
    let enc = hex_encode(data)
    ck_str("kat1-encode-abc", enc, "616263")
    print("KAT 1 PASS: hex_encode('abc' bytes) == '616263'")

// ── KAT 2: hex_decode("616263") -> [0x61,0x62,0x63] ─────────────────────────
fn kat2()
    let dec = hex_decode("616263")
    ck_int("kat2-len", bytes_len(dec), 3)
    ck_byte("kat2-b0", bytes_get(dec, 0), 0x61)
    ck_byte("kat2-b1", bytes_get(dec, 1), 0x62)
    ck_byte("kat2-b2", bytes_get(dec, 2), 0x63)
    print("KAT 2 PASS: hex_decode('616263') == [0x61,0x62,0x63]")

// ── KAT 3: hex_decode("00FF") upper-case -> [0x00,0xFF] ──────────────────────
fn kat3()
    let dec = hex_decode("00FF")
    ck_int("kat3-len", bytes_len(dec), 2)
    ck_byte("kat3-b0", bytes_get(dec, 0), 0x00)
    ck_byte("kat3-b1", bytes_get(dec, 1), 0xFF)
    print("KAT 3 PASS: hex_decode('00FF') == [0x00,0xFF] (case-insensitive)")

// ── KAT 4: hex_encode([0x00,0xFF,0x10]) == "00ff10" (binary-safe) ────────────
fn kat4()
    let data = bytes(0)
    data = bytes_append(data, 0x00)
    data = bytes_append(data, 0xFF)
    data = bytes_append(data, 0x10)
    let enc = hex_encode(data)
    ck_str("kat4-encode-binary", enc, "00ff10")
    print("KAT 4 PASS: hex_encode([0x00,0xFF,0x10]) == '00ff10'")

// ── KAT 5: round-trip hex_decode(hex_encode(x)) == x for binary payload ──────
fn kat5()
    let payload = bytes(0)
    payload = bytes_append(payload, 0x00)
    payload = bytes_append(payload, 0x01)
    payload = bytes_append(payload, 0xFE)
    payload = bytes_append(payload, 0xFF)
    let enc = hex_encode(payload)
    // enc must be "0001feff" — lowercase, zero-padded
    ck_str("kat5-encoded", enc, "0001feff")
    let dec = hex_decode(enc)
    ck_int("kat5-rt-len", bytes_len(dec), 4)
    ck_byte("kat5-rt-b0", bytes_get(dec, 0), 0x00)
    ck_byte("kat5-rt-b1", bytes_get(dec, 1), 0x01)
    ck_byte("kat5-rt-b2", bytes_get(dec, 2), 0xFE)
    ck_byte("kat5-rt-b3", bytes_get(dec, 3), 0xFF)
    print("KAT 5 PASS: round-trip [0x00,0x01,0xFE,0xFF] byte-identical")

// ── KAT 6: whitespace stripping in hex_decode ─────────────────────────────────
fn kat6()
    let dec = hex_decode("  616263  ")
    ck_int("kat6-len", bytes_len(dec), 3)
    ck_byte("kat6-b0", bytes_get(dec, 0), 0x61)
    ck_byte("kat6-b1", bytes_get(dec, 1), 0x62)
    ck_byte("kat6-b2", bytes_get(dec, 2), 0x63)
    print("KAT 6 PASS: hex_decode strips surrounding whitespace")

// ── KAT 7: odd-length input -> bytes(0) (error) ───────────────────────────────
fn kat7()
    let dec = hex_decode("616")
    ck_int("kat7-odd-len", bytes_len(dec), 0)
    print("KAT 7 PASS: odd-length hex_decode -> bytes(0)")

// ── KAT 8: bad nibble input -> bytes(0) (error) ───────────────────────────────
fn kat8()
    let dec = hex_decode("6162GG")
    ck_int("kat8-badchar-len", bytes_len(dec), 0)
    print("KAT 8 PASS: bad nibble in hex_decode -> bytes(0)")

// ── KAT 9: empty input round-trip ─────────────────────────────────────────────
fn kat9()
    let empty = bytes(0)
    let enc = hex_encode(empty)
    ck_str("kat9-empty-enc", enc, "")
    let dec = hex_decode("")
    ck_int("kat9-empty-dec-len", bytes_len(dec), 0)
    print("KAT 9 PASS: empty bytes encode/decode")

// ── KAT 10: lowercase decode (as spec shows "616263" lowercase) ───────────────
fn kat10()
    let dec = hex_decode("616263")
    ck_int("kat10-len", bytes_len(dec), 3)
    ck_byte("kat10-b0", bytes_get(dec, 0), 0x61)
    ck_byte("kat10-b1", bytes_get(dec, 1), 0x62)
    ck_byte("kat10-b2", bytes_get(dec, 2), 0x63)
    print("KAT 10 PASS: hex_decode('616263') lowercase works")

fn main()
    kat1()
    kat2()
    kat3()
    kat4()
    kat5()
    kat6()
    kat7()
    kat8()
    kat9()
    kat10()
    print("ALL KATs PASSED — std/encoding/hex binary-safe hex codec OK")
