import forge_floodfill

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn grid_str(g) -> string
    let rows = []
    let r = 0
    while r < len(g)
        let row = ""
        let c = 0
        while c < len(g[r])
            row = row + str(g[r][c])
            c = c + 1
        push(rows, row)
        r = r + 1
    join(rows, "/")

fn main()
    let fails = 0

    // flood fill a connected region of 1s with 9
    let g = [[1, 1, 0], [1, 0, 0], [0, 0, 1]]
    let n = flood_fill(g, 0, 0, 9)
    fails = fails + expect("fill_count", str(n), "3")
    // the connected 1-region (0,0),(0,1),(1,0) becomes 9; the isolated (2,2) stays 1
    fails = fails + expect("fill_grid", grid_str(g), "990/900/001")

    // fill target == newval -> no-op
    let g2 = [[5, 5], [5, 5]]
    fails = fails + expect("noop", str(flood_fill(g2, 0, 0, 5)), "0")

    // whole grid one region
    let g3 = [[2, 2], [2, 2]]
    fails = fails + expect("whole", str(flood_fill(g3, 1, 1, 0)), "4")

    // region_size (non-destructive)
    let g4 = [[1, 1, 0, 1], [1, 0, 0, 1], [0, 0, 1, 1]]
    fails = fails + expect("region_size", str(region_size(g4, 0, 0)), "3")
    // grid unchanged after region_size
    fails = fails + expect("size_nondestructive", grid_str(g4), "1101/1001/0011")

    // count_regions of value 1: top-left blob (3), right column blob (4) = 2 regions
    fails = fails + expect("count_1s", str(count_regions(g4, 1)), "2")
    // count regions of 0
    fails = fails + expect("count_0s", str(count_regions(g4, 0)), "1")

    // out of bounds start -> 0
    fails = fails + expect("oob", str(flood_fill(g, 10, 10, 3)), "0")

    // single cell
    let g5 = [[7]]
    fails = fails + expect("single", str(flood_fill(g5, 0, 0, 8)), "1")

    if fails == 0
        print("forge_floodfill: all passed")
    else
        print("forge_floodfill: " + str(fails) + " FAILED")
