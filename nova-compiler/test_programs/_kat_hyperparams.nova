import forge_hyperparams

fn main()
    let s = hp_new()
    assert(hp_count(s) == 0, "0 params")
    assert(hp_has(s, "lr") == 0, "lr absent")

    let g0 = hp_get(s, "lr")
    assert(is_err(g0), "get missing errs")
    let r0 = hp_remove(s, "lr")
    assert(is_err(r0), "remove missing errs")

    s = hp_set(s, "lr", "0.01")
    s = hp_set(s, "batch_size", "32")
    s = hp_set(s, "layers", "3")
    assert(hp_count(s) == 3, "3 params")
    assert(hp_has(s, "lr") == 1, "lr present")

    let g1 = hp_get(s, "lr")
    assert(is_ok(g1), "get lr ok")
    assert(unwrap(g1) == "0.01", "lr is 0.01")

    let list1 = hp_param_list(s)
    assert(list1 == "lr,batch_size,layers", "param list order")

    // overwrite existing value, count unchanged
    s = hp_set(s, "lr", "0.02")
    assert(hp_count(s) == 3, "still 3 params after overwrite")
    let g2 = hp_get(s, "lr")
    assert(unwrap(g2) == "0.02", "lr updated to 0.02")

    s = hp_set_range(s, "lr", 0.0, 1.0)
    let v1 = hp_validate(s, "lr", "0.5")
    assert(is_ok(v1), "validate ok")
    assert(unwrap(v1) == 1, "0.5 in range")

    let v2 = hp_validate(s, "lr", "1.5")
    assert(unwrap(v2) == 0, "1.5 out of range")

    let v3 = hp_validate(s, "lr", "0.0")
    assert(unwrap(v3) == 1, "0.0 is in range (inclusive)")

    let v4 = hp_validate(s, "lr", "1.0")
    assert(unwrap(v4) == 1, "1.0 is in range (inclusive)")

    let v5 = hp_validate(s, "lr", "-0.1")
    assert(unwrap(v5) == 0, "-0.1 out of range")

    let vbad = hp_validate(s, "batch_size", "32")
    assert(is_err(vbad), "no range defined for batch_size")

    let def1 = hp_defaults(s)
    assert(def1 == "lr=0.02,batch_size=32,layers=3", "defaults dump")

    let rm1 = hp_remove(s, "batch_size")
    assert(is_ok(rm1), "remove ok")
    s = unwrap(rm1)
    assert(hp_count(s) == 2, "2 params after remove")
    assert(hp_has(s, "batch_size") == 0, "batch_size gone")

    let list2 = hp_param_list(s)
    assert(list2 == "lr,layers", "param list after removal")

    // re-set a removed param brings it back
    s = hp_set(s, "batch_size", "64")
    assert(hp_count(s) == 3, "3 params after re-add")
    assert(hp_has(s, "batch_size") == 1, "batch_size back")
    let g3 = hp_get(s, "batch_size")
    assert(unwrap(g3) == "64", "batch_size is 64")

    print("HYPERPARAMS KAT PASS")
