fn main()
    let pass = true

    // trim
    if trim("  hello  ") != "hello"
        print("FAIL: trim")
        pass = false

    // upper / lower
    if upper("hello") != "HELLO"
        print("FAIL: upper")
        pass = false
    if lower("HELLO") != "hello"
        print("FAIL: lower")
        pass = false

    // starts_with / ends_with
    if not starts_with("hello world", "hello")
        print("FAIL: starts_with")
        pass = false
    if not ends_with("hello world", "world")
        print("FAIL: ends_with")
        pass = false

    // replace
    if replace("aabbcc", "bb", "XX") != "aaXXcc"
        print("FAIL: replace")
        pass = false

    // find
    if find("hello world", "world") != 6
        print("FAIL: find")
        pass = false
    if find("hello", "xyz") != -1
        print("FAIL: find miss")
        pass = false

    // split / join
    let parts = split("a,b,c", ",")
    if len(parts) != 3
        print("FAIL: split len")
        pass = false
    if parts[0] != "a" or parts[1] != "b" or parts[2] != "c"
        print("FAIL: split vals")
        pass = false
    if join(parts, "-") != "a-b-c"
        print("FAIL: join")
        pass = false

    // slice
    if slice("hello", 1, 3) != "el"
        print("FAIL: slice")
        pass = false

    // str_count
    if str_count("banana", "an") != 2
        print("FAIL: str_count")
        pass = false

    // contains (string)
    if not contains("hello world", "lo wo")
        print("FAIL: contains str")
        pass = false

    // splitlines
    let lines = splitlines("a\nb\nc")
    if len(lines) != 3
        print("FAIL: splitlines")
        pass = false

    // partition
    let prt = partition("hello=world", "=")
    if len(prt) != 3
        print("FAIL: partition len")
        pass = false
    if prt[0] != "hello" or prt[1] != "=" or prt[2] != "world"
        print("FAIL: partition vals")
        pass = false

    // Empty / edge cases
    if trim("") != ""
        print("FAIL: trim empty")
        pass = false
    if upper("") != ""
        print("FAIL: upper empty")
        pass = false
    if split("", ",") != [""]
        print("FAIL: split empty")
        pass = false
    if find("", "x") != -1
        print("FAIL: find empty")
        pass = false

    if pass
        print("PASS _kat_string_builtins")
    else
        print("FAIL _kat_string_builtins")
