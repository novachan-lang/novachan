// KAT: std/data/sub_timecode
import std/data/sub_timecode

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=[" + got + "] want=[" + want + "]")
        exit(1)

// ── srt_tc_parse ─────────────────────────────────────────────────────────────
cki("srt_parse_spec",   srt_tc_parse("00:01:23,456"), 83456)
cki("srt_parse_zero",   srt_tc_parse("00:00:00,000"), 0)
cki("srt_parse_1h",     srt_tc_parse("01:00:00,000"), 3600000)
cki("srt_parse_mixed",  srt_tc_parse("01:02:03,004"), 3723004)

// ── srt_tc_format ────────────────────────────────────────────────────────────
cks("srt_format_spec",  srt_tc_format(83456),  "00:01:23,456")
cks("srt_format_zero",  srt_tc_format(0),      "00:00:00,000")
cks("srt_format_1h",    srt_tc_format(3600000),"01:00:00,000")
cks("srt_format_mixed", srt_tc_format(3723004),"01:02:03,004")

// ── srt round-trip ───────────────────────────────────────────────────────────
let srt_vals = []
srt_vals.push(0)
srt_vals.push(83456)
srt_vals.push(3600000)
srt_vals.push(3723004)
srt_vals.push(59999)
let si = 0
while si < len(srt_vals)
    let v = srt_vals[si]
    let rt = srt_tc_parse(srt_tc_format(v))
    cki("srt_rt_" + str(si), rt, v)
    si = si + 1

// ── vtt_tc_parse (HH:MM:SS.mmm) ─────────────────────────────────────────────
cki("vtt_parse_spec",   vtt_tc_parse("00:01:23.456"), 83456)
cki("vtt_parse_zero",   vtt_tc_parse("00:00:00.000"), 0)
cki("vtt_parse_1h",     vtt_tc_parse("01:00:00.000"), 3600000)

// ── vtt_tc_parse (MM:SS.mmm) ─────────────────────────────────────────────────
cki("vtt_parse_short",  vtt_tc_parse("01:23.456"), 83456)
cki("vtt_parse_short0", vtt_tc_parse("00:00.000"), 0)
cki("vtt_parse_short2", vtt_tc_parse("02:03.004"), 123004)

// ── vtt_tc_format ────────────────────────────────────────────────────────────
cks("vtt_format_spec",  vtt_tc_format(83456),  "00:01:23.456")
cks("vtt_format_zero",  vtt_tc_format(0),      "00:00:00.000")
cks("vtt_format_1h",    vtt_tc_format(3600000),"01:00:00.000")

// ── vtt round-trip (format -> parse HH form) ─────────────────────────────────
let vtt_vals = []
vtt_vals.push(0)
vtt_vals.push(83456)
vtt_vals.push(3600000)
let vi = 0
while vi < len(vtt_vals)
    let v = vtt_vals[vi]
    let rt = vtt_tc_parse(vtt_tc_format(v))
    cki("vtt_rt_" + str(vi), rt, v)
    vi = vi + 1

// ── ms_to_hms ────────────────────────────────────────────────────────────────
let hms = ms_to_hms(83456)
cki("hms_h",      hms[0], 0)
cki("hms_m",      hms[1], 1)
cki("hms_s",      hms[2], 23)
cki("hms_millis", hms[3], 456)

let hms2 = ms_to_hms(3723004)
cki("hms2_h",      hms2[0], 1)
cki("hms2_m",      hms2[1], 2)
cki("hms2_s",      hms2[2], 3)
cki("hms2_millis", hms2[3], 4)

let hms0 = ms_to_hms(0)
cki("hms0_h",      hms0[0], 0)
cki("hms0_m",      hms0[1], 0)
cki("hms0_s",      hms0[2], 0)
cki("hms0_millis", hms0[3], 0)

print("PASS _sub_timecode_test")
