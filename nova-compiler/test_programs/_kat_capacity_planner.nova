import forge_capacity_planner

fn main()
    let c = cp_new(100)
    assert(cp_total_capacity(c) == 100, "total 100")
    assert(cp_available(c) == 100, "100 available")

    let r1 = cp_reserve(c, "service-a", 40)
    c = r1["c"]
    assert(r1["ok"] == 1, "reserve 40 ok")
    assert(cp_available(c) == 60, "60 available")
    assert(cp_utilization(c) == 40, "40% util")

    let r2 = cp_reserve(c, "service-b", 30)
    c = r2["c"]
    assert(r2["ok"] == 1, "reserve 30 ok")
    assert(cp_reservation_count(c) == 2, "2 reservations")

    let r3 = cp_reserve(c, "service-c", 50)
    c = r3["c"]
    assert(r3["ok"] == 0, "50 exceeds available 30")

    assert(cp_peak_utilization(c) == 70, "peak 70%")

    c = cp_release(c, "service-a")
    assert(cp_available(c) == 70, "70 after release")
    assert(cp_reservation_count(c) == 1, "1 reservation")
    assert(cp_peak_utilization(c) == 70, "peak unchanged")

    print("CAPACITY-PLANNER KAT PASS")
