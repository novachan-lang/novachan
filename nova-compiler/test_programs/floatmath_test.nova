// floatmath_test — scalar max/min/abs on floats + exact-int aggregates over
// non-literal int lists. Guards two real silent-correctness bugs:
//  (A) max/min compared float args as raw i64 bits (wrong for negatives) and
//      abs used integer abs; all also mistyped the result as int.
//  (D) sum/min/max of range()/reverse(intlist) were mis-routed to the
//      double-accumulating float path, yielding a float (spurious .0).

fn main()
    // (A) float max/min — correct value AND float type
    assert_near(max(1.5, 2.7), 2.7, 0.0001)
    assert_near(min(1.5, 2.7), 1.5, 0.0001)
    assert_near(max(-2.0, -8.0), -2.0, 0.0001)   // negatives: bit-compare inverted these
    assert_near(min(-2.0, -8.0), -8.0, 0.0001)
    assert_near(abs(-3.14), 3.14, 0.0001)
    assert_near(abs(2.5), 2.5, 0.0001)
    // result is genuinely float — usable in downstream float arithmetic
    assert_near(max(1.5, 2.7) + 1.0, 3.7, 0.0001)

    // int max/min/abs stay exact integers (unchanged path)
    assert_eq(max(3, 7), 7)
    assert_eq(min(9, 2), 2)
    assert_eq(abs(-42), 42)

    // (D) exact-int aggregates over non-literal int lists (no spurious .0)
    assert_eq(sum(range(5)), 10)                 // range -> intlist
    assert_eq(sum(reverse([1, 2, 3])), 6)        // reverse(intlist) -> intlist
    assert_eq(sum([0, 1, 2, 3, 4]), 10)          // literal control

    // float-list aggregate is still float
    assert_near(sum([1.5, 2.5]), 4.0, 0.0001)

    print("floatmath_test passed")
