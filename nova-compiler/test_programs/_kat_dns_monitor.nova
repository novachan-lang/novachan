import forge_dns_monitor

fn main()
    let dm = dm_new()
    dm = dm_add_record(dm, "example.com", "A", "93.184.216.34")
    dm = dm_add_record(dm, "example.com", "MX", "mail.example.com")
    dm = dm_add_record(dm, "api.example.com", "A", "10.0.0.1")
    assert(dm_record_count(dm) == 3, "3 records")

    let c1 = dm_check(dm, "example.com", "A", "93.184.216.34")
    dm = unwrap(c1)
    let s1 = dm_status(dm, "example.com", "A")
    assert(unwrap(s1) == "healthy", "healthy match")

    let c2 = dm_check(dm, "example.com", "MX", "wrong.server.com")
    dm = unwrap(c2)
    let s2 = dm_status(dm, "example.com", "MX")
    assert(unwrap(s2) == "degraded", "degraded mismatch")

    assert(dm_check_count(dm) == 2, "2 checks")
    assert(dm_failure_count(dm) == 1, "1 failure")
    assert(dm_healthy_count(dm) == 1, "1 healthy")
    assert(dm_degraded_count(dm) == 1, "1 degraded")

    let lc = dm_last_checked(dm)
    assert(unwrap(lc) == "example.com", "last checked")

    let bad = dm_check(dm, "nope.com", "A", "1.2.3.4")
    assert(is_err(bad), "unknown record")

    let bad2 = dm_status(dm, "nope.com", "A")
    assert(is_err(bad2), "unknown status")

    print("DNS-MONITOR KAT PASS")
