fn main()
    let xs = [5, 3, 8, 1, 9, 2]
    let last = xs[-1]
    print(last)
    
    let evens = [x * x for x in range(10) if x % 2 == 0]
    print(evens)
    
    let d = {"name": "NOVA", "version": "1.0"}
    for (k, v) in d
        print(k + " = " + str(v))
    
    let words = "hello world foo bar"
    let caps = [upper(w) for w in split(words, " ")]
    print(caps)
    
    match len(xs)
        6 => print("six elements")
        _ => print("other")
