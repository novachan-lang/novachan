import forge_primality

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // tiny
    fails = fails + expect("p_0", str(is_prime("0")), "false")
    fails = fails + expect("p_1", str(is_prime("1")), "false")
    fails = fails + expect("p_2", str(is_prime("2")), "true")
    fails = fails + expect("p_3", str(is_prime("3")), "true")
    fails = fails + expect("p_4", str(is_prime("4")), "false")
    fails = fails + expect("p_17", str(is_prime("17")), "true")
    fails = fails + expect("p_97", str(is_prime("97")), "true")
    fails = fails + expect("p_100", str(is_prime("100")), "false")

    // Carmichael numbers -- composite but fool the Fermat test (the key Miller-Rabin correctness check)
    fails = fails + expect("carmichael_561", str(is_prime("561")), "false")
    fails = fails + expect("carmichael_1105", str(is_prime("1105")), "false")
    fails = fails + expect("carmichael_1729", str(is_prime("1729")), "false")

    // larger primes
    fails = fails + expect("p_7919", str(is_prime("7919")), "true")
    fails = fails + expect("p_104729", str(is_prime("104729")), "true")
    fails = fails + expect("p_1e9_7", str(is_prime("1000000007")), "true")
    fails = fails + expect("c_1e9_11", str(is_prime("1000000011")), "false")
    fails = fails + expect("mersenne_31", str(is_prime("2147483647")), "true")

    // next_prime
    fails = fails + expect("np_14", next_prime("14"), "17")
    fails = fails + expect("np_100", next_prime("100"), "101")
    fails = fails + expect("np_0", next_prime("0"), "2")
    fails = fails + expect("np_prime", next_prime("13"), "13")

    if fails == 0
        print("forge_primality: all passed")
    else
        print("forge_primality: " + str(fails) + " FAILED")
