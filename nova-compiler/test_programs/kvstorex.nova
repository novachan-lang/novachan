fn kvstore_new()
  let kv = {}
  kv["data"] = {}
  kv["ttls"] = {}
  kv

fn kv_set(store, key, value)
  store["data"][key] = value
  store["ttls"][key] = 0

fn kv_set_ttl(store, key, value, ttl_ms)
  store["data"][key] = value
  store["ttls"][key] = time_ms() + ttl_ms

fn kv_get(store, key)
  if not contains(store["data"], key)
    return err("key not found: " + key)
  let ttl = store["ttls"][key]
  if ttl > 0 and time_ms() >= ttl
    let _d = store["data"]
    let _t = store["ttls"]
    return err("key expired: " + key)
  ok(store["data"][key])

fn kv_has(store, key)
  if not contains(store["data"], key)
    return 0
  let ttl = store["ttls"][key]
  if ttl > 0 and time_ms() >= ttl
    return 0
  1

fn kv_delete(store, key)
  if contains(store["data"], key)
    store["ttls"][key] = 1

fn kv_keys(store)
  let result = []
  let all = keys(store["data"])
  for k in all
    if kv_has(store, k) == 1
      push(result, k)
  result

fn kv_size(store)
  len(kv_keys(store))

fn main()
  let store = kvstore_new()
  kv_set(store, "name", "Alice")
  kv_set(store, "age", 30)

  assert(is_ok(kv_get(store, "name")), "get ok")
  assert(unwrap(kv_get(store, "name")) == "Alice", "get value")
  assert(kv_has(store, "name") == 1, "has name")
  assert(kv_has(store, "missing") == 0, "has missing")
  assert(kv_size(store) == 2, "size 2")

  kv_delete(store, "age")
  assert(kv_size(store) == 1, "size after delete")

  kv_set_ttl(store, "session", "abc123", 100)
  assert(kv_has(store, "session") == 1, "ttl not expired")
  assert(unwrap(kv_get(store, "session")) == "abc123", "ttl value")

  sleep(110)
  assert(kv_has(store, "session") == 0, "ttl expired")
  assert(is_err(kv_get(store, "session")), "get expired = err")

  assert(is_err(kv_get(store, "nonexistent")), "get missing = err")

  print("kvstorex: all passed")
