import forge_error_tracker

fn main()
    let e = et_new()
    e = et_record(e, "timeout", "connection timed out")
    e = et_record(e, "timeout", "read timed out")
    e = et_record(e, "auth", "invalid token")
    assert(et_total(e) == 3, "3 total")
    assert(et_unique_count(e) == 2, "2 unique types")

    let c = et_count_for(e, "timeout")
    assert(is_ok(c), "count ok")
    assert(unwrap(c) == 2, "2 timeouts")

    let m = et_message_for(e, "auth")
    assert(is_ok(m), "message ok")
    assert(unwrap(m) == "invalid token", "correct msg")

    let last = et_last_error(e)
    assert(is_ok(last), "last ok")
    assert(unwrap(last) == "auth: invalid token", "last error correct")

    let rate = et_error_rate(e, "timeout", 100)
    assert(is_ok(rate), "rate ok")
    assert(unwrap(rate) == 2, "2% error rate")

    let bad = et_count_for(e, "nope")
    assert(is_err(bad), "unknown type")

    let empty = et_new()
    assert(is_err(et_last_error(empty)), "no errors")

    print("ERROR-TRACKER KAT PASS")
