// KAT test for std/data/opml_build — OPML builder
import std/data/opml_build
import std/data/opml_parse

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn assert_contains(label: string, s: string, sub: string)
    if contains(s, sub) == 0
        print("FAIL " + label + ": string does not contain '" + sub + "'")
        print("  Got: " + s)
        exit(1)

fn main()
    let dq = chr(34)

    // ── KAT 1: build with one outline having xmlUrl ───────────────────────────
    let doc1 = {}
    doc1["title"] = "My Feeds"
    let outlines1 = []
    let o1 = {}
    o1["text"] = "NOVA News"
    o1["xmlUrl"] = "http://nova.example/feed"
    o1["children"] = []
    push(outlines1, o1)
    doc1["outlines"] = outlines1
    let xml1 = opml_build(doc1)
    // check required content
    assert_contains("kat1-opml-tag", xml1, "<opml")
    assert_contains("kat1-title-tag", xml1, "<title>My Feeds</title>")
    assert_contains("kat1-text-attr", xml1, "text=" + dq + "NOVA News" + dq)
    assert_contains("kat1-xmlurl-attr", xml1, "xmlUrl=" + dq + "http://nova.example/feed" + dq)
    print("KAT 1 PASS: build with xmlUrl")

    // ── KAT 2: round-trip — build then parse ──────────────────────────────────
    let doc2 = {}
    doc2["title"] = "Round Trip"
    let outlines2 = []
    let outer = {}
    outer["text"] = "Tech"
    outer["xmlUrl"] = ""
    let inner_list = []
    let inner_o = {}
    inner_o["text"] = "NOVA"
    inner_o["xmlUrl"] = "http://x/f"
    inner_o["children"] = []
    push(inner_list, inner_o)
    outer["children"] = inner_list
    push(outlines2, outer)
    doc2["outlines"] = outlines2
    let xml2 = opml_build(doc2)
    // parse back
    let doc2p = opml_parse(xml2)
    cks("kat2-title", doc2p["title"], "Round Trip")
    let tops2 = doc2p["outlines"]
    cki("kat2-top-count", len(tops2), 1)
    cks("kat2-tech-text", tops2[0]["text"], "Tech")
    let techkids = tops2[0]["children"]
    cki("kat2-child-count", len(techkids), 1)
    cks("kat2-nova-text", techkids[0]["text"], "NOVA")
    cks("kat2-nova-xmlUrl", techkids[0]["xmlUrl"], "http://x/f")
    print("KAT 2 PASS: round-trip title + nested outline text/xmlUrl + nesting")

    // ── KAT 3: multiple top-level outlines ────────────────────────────────────
    let doc3 = {}
    doc3["title"] = "Multi"
    let outlines3 = []
    let oa = {}
    oa["text"] = "Alpha"
    oa["xmlUrl"] = "http://a"
    oa["children"] = []
    let ob = {}
    ob["text"] = "Beta"
    ob["xmlUrl"] = "http://b"
    ob["children"] = []
    push(outlines3, oa)
    push(outlines3, ob)
    doc3["outlines"] = outlines3
    let xml3 = opml_build(doc3)
    let doc3p = opml_parse(xml3)
    cks("kat3-title", doc3p["title"], "Multi")
    cki("kat3-count", len(doc3p["outlines"]), 2)
    cks("kat3-alpha", doc3p["outlines"][0]["text"], "Alpha")
    cks("kat3-beta", doc3p["outlines"][1]["text"], "Beta")
    print("KAT 3 PASS: multiple top-level outlines round-trip")

    // ── KAT 4: empty doc ──────────────────────────────────────────────────────
    let doc4 = {}
    doc4["title"] = "Empty"
    doc4["outlines"] = []
    let xml4 = opml_build(doc4)
    assert_contains("kat4-opml", xml4, "<opml")
    assert_contains("kat4-title", xml4, "<title>Empty</title>")
    let doc4p = opml_parse(xml4)
    cks("kat4-rtitle", doc4p["title"], "Empty")
    cki("kat4-rcount", len(doc4p["outlines"]), 0)
    print("KAT 4 PASS: empty doc round-trip")

    print("PASS _opml_build_test")
