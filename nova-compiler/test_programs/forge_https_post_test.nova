// Proves HTTP request REASSEMBLY across TLS records: a POST whose body is larger than one ~16KB TLS record
// must be fully reassembled before dispatch. The handler echoes the received body length; the harness POSTs
// a 40000-byte body (~3 records) and checks the server saw all 40000 bytes (not just the first record).
import forge
import forge_https

fn app_echo_len(req)
    text(200, "len=" + str(len(req["body"])))

fn main()
    let a = app()
    post(a, "/echolen", app_echo_len)
    forge_serve_tls_app_n(a, 44333, 1)
    print("HTTPS-POST-DONE")
