import std/collections/cartesian_tree

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn main()
    // KAT array: [3,1,4,1,5]
    // min value=1 appears at indices 1 and 3; earliest=1 is the root.
    // Expected crt_root([3,1,4,1,5]) = 1
    let arr1 = []
    arr1.push(3)
    arr1.push(1)
    arr1.push(4)
    arr1.push(1)
    arr1.push(5)

    cki("root([3,1,4,1,5])", crt_root(arr1), 1)

    // crt_build([3,1,4,1,5]): index 0's parent should be 1 (the root is min=1 at idx 1)
    let p1 = crt_build(arr1)
    cki("parent[0]", p1[0], 1)
    // Root (index 1) has parent -1
    cki("parent[1]=-1", p1[1], -1)

    // crt_rmq_index([3,1,4,1,5], 2, 4): range [2..4]=[4,1,5], min=1 at index 3
    cki("rmq([3,1,4,1,5],2,4)", crt_rmq_index(arr1, 2, 4), 3)

    // crt_rmq_index([3,1,4,1,5], 0, 4): full range, min=1 at index 1 (earliest)
    cki("rmq([3,1,4,1,5],0,4)", crt_rmq_index(arr1, 0, 4), 1)

    // KAT array: [5,4,3,2,1] — strictly decreasing, root=4 (min=1)
    let arr2 = []
    arr2.push(5)
    arr2.push(4)
    arr2.push(3)
    arr2.push(2)
    arr2.push(1)
    cki("root([5,4,3,2,1])", crt_root(arr2), 4)
    cki("rmq([5,4,3,2,1],0,4)", crt_rmq_index(arr2, 0, 4), 4)

    // KAT array: [2,2,2] — all equal, min=2, earliest index=0 is root
    let arr3 = []
    arr3.push(2)
    arr3.push(2)
    arr3.push(2)
    cki("root([2,2,2])", crt_root(arr3), 0)

    // RMQ on [2,2,2]: all queries return earliest index in range
    cki("rmq([2,2,2],0,2)", crt_rmq_index(arr3, 0, 2), 0)
    cki("rmq([2,2,2],1,2)", crt_rmq_index(arr3, 1, 2), 1)
    cki("rmq([2,2,2],2,2)", crt_rmq_index(arr3, 2, 2), 2)

    // Singleton array
    let arr4 = []
    arr4.push(42)
    cki("root([42])", crt_root(arr4), 0)
    cki("rmq([42],0,0)", crt_rmq_index(arr4, 0, 0), 0)
    let p4 = crt_build(arr4)
    cki("build([42]) root parent", p4[0], -1)

    // Ascending array [1,2,3,4,5]: root = 0
    let arr5 = []
    arr5.push(1)
    arr5.push(2)
    arr5.push(3)
    arr5.push(4)
    arr5.push(5)
    cki("root([1,2,3,4,5])", crt_root(arr5), 0)
    cki("rmq([1,2,3,4,5],1,4)", crt_rmq_index(arr5, 1, 4), 1)
    cki("rmq([1,2,3,4,5],3,4)", crt_rmq_index(arr5, 3, 4), 3)

    // Build check on [5,4,3,2,1]: right-leaning spine; parent[3]=4 (4 is right child of 3? No.)
    // Actually in [5,4,3,2,1] each new element is smaller, so it becomes the new root.
    // Stack build: each pops all prev. parent[0]=1, parent[1]=2, parent[2]=3, parent[3]=4, parent[4]=-1
    let p2 = crt_build(arr2)
    cki("build([5,4,3,2,1]) p[0]", p2[0], 1)
    cki("build([5,4,3,2,1]) p[1]", p2[1], 2)
    cki("build([5,4,3,2,1]) p[4]", p2[4], -1)

    print("PASS _cartesian_tree_test")
