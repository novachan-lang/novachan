// KAT test suite for std/compress/delta
// Tests: dlt_encode, dlt_decode, dlt_encode_zigzag, dlt_decode_zigzag,
//        dlt_encode_bytes, and round-trips.

import std/compress/delta

// ── helper: compare two int lists for equality ────────────────────────────────

fn _dlt_lists_eq(a, b) -> int
    let na = len(a)
    let nb = len(b)
    if na != nb
        return 0
    let i = 0
    let ok = 1
    while i < na
        if a[i] != b[i]
            ok = 0
        i = i + 1
    ok

// ── helper: check a list is all non-negative ──────────────────────────────────

fn _dlt_all_nonneg(xs) -> int
    let n = len(xs)
    let i = 0
    let ok = 1
    while i < n
        if xs[i] < 0
            ok = 0
        i = i + 1
    ok

// ── KAT 1: dlt_encode published vector ───────────────────────────────────────

let enc1 = dlt_encode([10, 12, 15, 11])
let exp1 = [10, 2, 3, -4]
if _dlt_lists_eq(enc1, exp1) == 0
    print("FAIL KAT1: dlt_encode([10,12,15,11]) wrong")
    exit(1)

// ── KAT 2: dlt_decode published vector ───────────────────────────────────────

let dec2 = dlt_decode([10, 2, 3, -4])
let exp2 = [10, 12, 15, 11]
if _dlt_lists_eq(dec2, exp2) == 0
    print("FAIL KAT2: dlt_decode([10,2,3,-4]) wrong")
    exit(1)

// ── KAT 3: round-trip on empty list ──────────────────────────────────────────

let rt_empty = dlt_decode(dlt_encode([]))
if _dlt_lists_eq(rt_empty, []) == 0
    print("FAIL KAT3: round-trip [] failed")
    exit(1)

// ── KAT 4: round-trip on singleton ───────────────────────────────────────────

let rt_single = dlt_decode(dlt_encode([5]))
let exp4 = [5]
if _dlt_lists_eq(rt_single, exp4) == 0
    print("FAIL KAT4: round-trip [5] failed")
    exit(1)

// ── KAT 5: round-trip on ascending sequence ───────────────────────────────────

let xs5 = [1, 2, 3, 4, 5]
let rt5 = dlt_decode(dlt_encode(xs5))
if _dlt_lists_eq(rt5, xs5) == 0
    print("FAIL KAT5: round-trip [1,2,3,4,5] failed")
    exit(1)

// ── KAT 6: round-trip on descending sequence ─────────────────────────────────

let xs6 = [100, 90, 80]
let rt6 = dlt_decode(dlt_encode(xs6))
if _dlt_lists_eq(rt6, xs6) == 0
    print("FAIL KAT6: round-trip [100,90,80] failed")
    exit(1)

// ── KAT 7: dlt_encode_zigzag — all values non-negative ───────────────────────

let zz7 = dlt_encode_zigzag([10, 12, 9])
if _dlt_all_nonneg(zz7) == 0
    print("FAIL KAT7: dlt_encode_zigzag([10,12,9]) produced negative values")
    exit(1)

// ── KAT 8: dlt_encode_zigzag published vector ────────────────────────────────
// dlt_encode([10,12,9]) = [10, 2, -3]
// zigzag: 10->20, 2->4, -3->5

let exp8 = [20, 4, 5]
if _dlt_lists_eq(zz7, exp8) == 0
    print("FAIL KAT8: dlt_encode_zigzag([10,12,9]) wrong values")
    exit(1)

// ── KAT 9: dlt_decode_zigzag round-trip ──────────────────────────────────────

let xs9 = [10, 12, 9]
let rt9 = dlt_decode_zigzag(dlt_encode_zigzag(xs9))
if _dlt_lists_eq(rt9, xs9) == 0
    print("FAIL KAT9: dlt_decode_zigzag(dlt_encode_zigzag([10,12,9])) failed")
    exit(1)

// ── KAT 10: dlt_decode_zigzag round-trip on empty ────────────────────────────

let rt10 = dlt_decode_zigzag(dlt_encode_zigzag([]))
if _dlt_lists_eq(rt10, []) == 0
    print("FAIL KAT10: zigzag round-trip [] failed")
    exit(1)

// ── KAT 11: dlt_encode_bytes on ASCII string ─────────────────────────────────
// "ABC": A=65, B=66, C=67 -> deltas = [65, 1, 1]

let benc11 = dlt_encode_bytes("ABC")
let exp11 = [65, 1, 1]
if _dlt_lists_eq(benc11, exp11) == 0
    print("FAIL KAT11: dlt_encode_bytes(ABC) wrong")
    exit(1)

// ── KAT 12: dlt_encode_bytes empty string ────────────────────────────────────

let benc12 = dlt_encode_bytes("")
if _dlt_lists_eq(benc12, []) == 0
    print("FAIL KAT12: dlt_encode_bytes() wrong")
    exit(1)

print("_delta_test passed")
