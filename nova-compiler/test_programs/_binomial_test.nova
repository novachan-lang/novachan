// _binomial_test.nova — KAT tests for std/math/binomial.nova
import std/math/binomial

// Helper: check integer equality
fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// Helper: check string equality (for list representation)
fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + got + " expected " + expected)
        exit(1)

// Helper: list of ints to a comparable string "[a,b,c]"
fn list_to_str(xs)
    let n = len(xs)
    let s = "["
    let i = 0
    while i < n
        if i > 0
            s = s + ","
        s = s + str(xs[i])
        i = i + 1
    s = s + "]"
    s

// KAT 1: bino_coeff(5,2) == 10
cki("bino_coeff(5,2)", bino_coeff(5, 2), 10)

// KAT 2: bino_coeff(10,0) == 1
cki("bino_coeff(10,0)", bino_coeff(10, 0), 1)

// KAT 3: bino_coeff(10,10) == 1
cki("bino_coeff(10,10)", bino_coeff(10, 10), 1)

// KAT 4: bino_coeff(6,3) == 20
cki("bino_coeff(6,3)", bino_coeff(6, 3), 20)

// KAT 5: bino_coeff(5,6) == 0  (k > n)
cki("bino_coeff(5,6)", bino_coeff(5, 6), 0)

// KAT 6: bino_pascal_row(4) == [1,4,6,4,1]
let row4 = bino_pascal_row(4)
cks("bino_pascal_row(4)", list_to_str(row4), "[1,4,6,4,1]")

// KAT 7: bino_multinomial([2,1,1]) == 12
let counts = []
counts.push(2)
counts.push(1)
counts.push(1)
cki("bino_multinomial([2,1,1])", bino_multinomial(counts), 12)

// KAT 8: bino_central(3) == 20  (C(6,3))
cki("bino_central(3)", bino_central(3), 20)

// Extra coverage: symmetry C(8,3) == C(8,5)
cki("bino_coeff symmetry C(8,3)==C(8,5)", bino_coeff(8, 3), bino_coeff(8, 5))

// Extra: pascal_row(0) == [1]
let row0 = bino_pascal_row(0)
cks("bino_pascal_row(0)", list_to_str(row0), "[1]")

// Extra: multinomial([n]) == 1  (only one group)
let single = []
single.push(5)
cki("bino_multinomial([5])", bino_multinomial(single), 1)

print("_binomial_test passed")
