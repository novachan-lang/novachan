import std/backtracking/bt_combinations_k

// cki — check integer equality
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL bt_combinations_k " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb — check bool equality
fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL bt_combinations_k " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

// list_to_str — convert int list to string
fn list_to_str(xs) -> string
    let s = "["
    let i = 0
    let n = len(xs)
    while i < n
        if i > 0
            s = s + ","
        s = s + str(xs[i])
        i = i + 1
    s = s + "]"
    s

// cks — check string equality
fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL bt_combinations_k " + label + ": got=" + got + " want=" + want)
        exit(1)

// list_eq — true if two int lists are equal element-wise
fn list_eq(a, b) -> bool
    if len(a) != len(b)
        return false
    let i = 0
    while i < len(a)
        if a[i] != b[i]
            return false
        i = i + 1
    true

// contains_comb — true if xss contains a sublist equal to target
fn contains_comb(xss, target) -> bool
    let i = 0
    while i < len(xss)
        if list_eq(xss[i], target)
            return true
        i = i + 1
    false

// cknest — check that result has expected length
fn cknest(label: string, xss, wlen: int)
    if len(xss) != wlen
        print("FAIL bt_combinations_k " + label + "_len: got=" + str(len(xss)) + " want=" + str(wlen))
        exit(1)

fn main()
    // --- ck_count ---
    cki("count_4_2", ck_count(4, 2), 6)
    cki("count_5_3", ck_count(5, 3), 10)
    cki("count_4_0", ck_count(4, 0), 1)
    cki("count_3_4", ck_count(3, 4), 0)
    cki("count_5_5", ck_count(5, 5), 1)
    cki("count_0_0", ck_count(0, 0), 1)
    cki("count_5_1", ck_count(5, 1), 5)
    cki("count_6_3", ck_count(6, 3), 20)
    cki("count_neg_k", ck_count(5, -1), 0)

    // --- ck_solve(4, 0) = [[]] ---
    let s40 = ck_solve(4, 0)
    cki("solve_4_0_len", len(s40), 1)
    let emptylist = []
    ckb("solve_4_0_has_empty", contains_comb(s40, emptylist), true)
    cks("solve_4_0_0", list_to_str(s40[0]), "[]")

    // --- ck_solve(3, 4) = [] (impossible) ---
    let s34 = ck_solve(3, 4)
    cki("solve_3_4_len", len(s34), 0)

    // --- ck_solve(5, 5) = [[1,2,3,4,5]] ---
    let s55 = ck_solve(5, 5)
    cki("solve_5_5_len", len(s55), 1)
    let want_12345 = [1, 2, 3, 4, 5]
    ckb("solve_5_5_has_12345", contains_comb(s55, want_12345), true)
    cks("solve_5_5_0", list_to_str(s55[0]), "[1,2,3,4,5]")

    // --- ck_solve(4, 2) has 6 combinations ---
    let s42 = ck_solve(4, 2)
    cknest("solve_4_2", s42, 6)

    let w12 = [1, 2]
    let w13 = [1, 3]
    let w14 = [1, 4]
    let w23 = [2, 3]
    let w24 = [2, 4]
    let w34 = [3, 4]
    ckb("solve_4_2_has_12", contains_comb(s42, w12), true)
    ckb("solve_4_2_has_13", contains_comb(s42, w13), true)
    ckb("solve_4_2_has_14", contains_comb(s42, w14), true)
    ckb("solve_4_2_has_23", contains_comb(s42, w23), true)
    ckb("solve_4_2_has_24", contains_comb(s42, w24), true)
    ckb("solve_4_2_has_34", contains_comb(s42, w34), true)

    // lex order: [1,2] is first, [3,4] is last
    cks("solve_4_2_first", list_to_str(s42[0]), "[1,2]")
    cks("solve_4_2_last", list_to_str(s42[5]), "[3,4]")

    // --- ck_solve(5, 3) has 10 combinations ---
    let s53 = ck_solve(5, 3)
    cknest("solve_5_3", s53, 10)
    // first = [1,2,3], last = [3,4,5]
    cks("solve_5_3_first", list_to_str(s53[0]), "[1,2,3]")
    cks("solve_5_3_last", list_to_str(s53[9]), "[3,4,5]")

    // --- ck_solve(5, 1) = [[1],[2],[3],[4],[5]] ---
    let s51 = ck_solve(5, 1)
    cki("solve_5_1_len", len(s51), 5)
    cks("solve_5_1_0", list_to_str(s51[0]), "[1]")
    cks("solve_5_1_4", list_to_str(s51[4]), "[5]")

    // --- ck_solve(0, 0) = [[]] ---
    let s00 = ck_solve(0, 0)
    cki("solve_0_0_len", len(s00), 1)
    cks("solve_0_0_0", list_to_str(s00[0]), "[]")

    // --- negative k ---
    let sneg = ck_solve(5, -1)
    cki("solve_neg_k_len", len(sneg), 0)

    print("PASS _bt_combinations_k_test")
