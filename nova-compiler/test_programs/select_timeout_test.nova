// select_timeout_test.nova -- select with a deadline (closes Go select+time.After / Erlang
// receive...after). select_timeout(ch.., timeout_ms) returns [index, value] of the first ready
// channel, or [-1, 0] if none becomes ready within timeout_ms. Green-task safe (yields, no hang).
fn _producer(ch)
    sleep(200)
    send(ch, 42)

fn main()
    // (a) a value arrives before the timeout -> [0, 42]
    let ch1 = channel()
    spawn _producer(ch1)
    let r1 = select_timeout(ch1, 2000)
    if r1[0] != 0 or r1[1] != 42
        print("select_timeout_test FAILED a: got " + str(r1[0]) + "," + str(r1[1]))
        exit(1)
    // (b) nothing arrives -> the deadline fires -> [-1, 0], and it does NOT hang
    let ch2 = channel()
    let t0 = time_ms()
    let r2 = select_timeout(ch2, 300)
    let dt = time_ms() - t0
    if r2[0] != -1
        print("select_timeout_test FAILED b: expected [-1,..] got " + str(r2[0]))
        exit(1)
    if dt < 250 or dt > 5000
        print("select_timeout_test FAILED b timing: " + str(dt) + "ms (expected ~300; generous upper bound tolerates parallel-load scheduling)")
        exit(1)
    // (c) two channels, the SECOND becomes ready -> [1, 42]
    let ch3 = channel()
    let ch4 = channel()
    spawn _producer(ch4)
    let r3 = select_timeout(ch3, ch4, 2000)
    if r3[0] != 1 or r3[1] != 42
        print("select_timeout_test FAILED c: got " + str(r3[0]) + "," + str(r3[1]))
        exit(1)
    print("select_timeout_test passed")
