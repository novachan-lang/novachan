// KAT for std/framing/slip — SLIP (RFC 1055) serial line framing.
// Canonical vectors from the spec + round-trip tests.
import std/framing/slip

// ── Helpers ───────────────────────────────────────────────────────────────────

fn list_eq(a, b) -> int
    let la = len(a)
    let lb = len(b)
    if la != lb
        return 0
    let i = 0
    while i < la
        if a[i] != b[i]
            return 0
        i = i + 1
    1

fn ck_list(label, got, want)
    if list_eq(got, want) == 0
        let gs = "["
        let i = 0
        while i < len(got)
            gs = gs + str(got[i])
            if i + 1 < len(got)
                gs = gs + ","
            i = i + 1
        gs = gs + "]"
        let ws = "["
        let j = 0
        while j < len(want)
            ws = ws + str(want[j])
            if j + 1 < len(want)
                ws = ws + ","
            j = j + 1
        ws = ws + "]"
        print("FAIL slip " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn ck_int(label, got, want)
    if got != want
        print("FAIL slip " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ── KAT 1: slip_escape([0xC0]) == [0xDB, 0xDC] ───────────────────────────────
fn kat1()
    let esc = slip_escape([192])
    ck_list("escape-END", esc, [219, 220])
    print("KAT 1 PASS: slip_escape([0xC0]) == [0xDB,0xDC]")

// ── KAT 2: slip_escape([0xDB]) == [0xDB, 0xDD] ───────────────────────────────
fn kat2()
    let esc = slip_escape([219])
    ck_list("escape-ESC", esc, [219, 221])
    print("KAT 2 PASS: slip_escape([0xDB]) == [0xDB,0xDD]")

// ── KAT 3: slip_escape([1,2,3]) == [1,2,3] ───────────────────────────────────
fn kat3()
    let esc = slip_escape([1, 2, 3])
    ck_list("escape-passthrough", esc, [1, 2, 3])
    print("KAT 3 PASS: slip_escape([1,2,3]) == [1,2,3]")

// ── KAT 4: slip_frame([1,2,3]) == [0xC0,1,2,3,0xC0] ─────────────────────────
fn kat4()
    let framed = slip_frame([1, 2, 3])
    ck_list("frame-simple", framed, [192, 1, 2, 3, 192])
    print("KAT 4 PASS: slip_frame([1,2,3]) == [0xC0,1,2,3,0xC0]")

// ── KAT 5: slip_frame([0xC0]) == [0xC0,0xDB,0xDC,0xC0] ──────────────────────
fn kat5()
    let framed = slip_frame([192])
    ck_list("frame-END-in-data", framed, [192, 219, 220, 192])
    print("KAT 5 PASS: slip_frame([0xC0]) == [0xC0,0xDB,0xDC,0xC0]")

// ── KAT 6: round-trip slip_decode(slip_encode(x))==x for [1,2,3] ─────────────
fn kat6()
    let data = [1, 2, 3]
    let rt = slip_decode(slip_encode(data))
    ck_list("rt-simple", rt, data)
    print("KAT 6 PASS: round-trip [1,2,3] OK")

// ── KAT 7: round-trip for [0xC0,0xDB] ────────────────────────────────────────
fn kat7()
    let data = [192, 219]
    let rt = slip_decode(slip_encode(data))
    ck_list("rt-END-ESC", rt, data)
    print("KAT 7 PASS: round-trip [0xC0,0xDB] OK")

// ── KAT 8: round-trip for [0x00,0xC0,0xDB,0xDC] ─────────────────────────────
fn kat8()
    let data = [0, 192, 219, 220]
    let rt = slip_decode(slip_encode(data))
    ck_list("rt-mixed-specials", rt, data)
    print("KAT 8 PASS: round-trip [0x00,0xC0,0xDB,0xDC] OK")

// ── KAT 9: round-trip for [] (empty) ─────────────────────────────────────────
fn kat9()
    let rt = slip_decode(slip_encode([]))
    ck_list("rt-empty", rt, [])
    print("KAT 9 PASS: round-trip [] OK")

// ── KAT 10: slip_unescape(slip_escape(x))==x ─────────────────────────────────
fn kat10()
    let d1 = [192, 219, 1, 2, 3]
    let rt1 = slip_unescape(slip_escape(d1))
    ck_list("unescape-rt-mixed", rt1, d1)
    // All-special bytes
    let d2 = [192, 219, 192, 219]
    let rt2 = slip_unescape(slip_escape(d2))
    ck_list("unescape-rt-all-special", rt2, d2)
    // Empty
    let rt3 = slip_unescape(slip_escape([]))
    ck_list("unescape-rt-empty", rt3, [])
    print("KAT 10 PASS: slip_unescape(slip_escape(x))==x for all test cases")

// ── KAT 11: slip_split splits on END bytes ────────────────────────────────────
fn kat11()
    // [0xC0, 1, 2, 0xC0, 3, 4, 0xC0] -> [[],[1,2],[3,4],[]]
    // The leading END creates an empty segment before it; trailing END creates
    // an empty segment after. This matches Python's str.split(sep) behaviour.
    let stream = [192, 1, 2, 192, 3, 4, 192]
    let frames = slip_split(stream)
    ck_int("split-count", len(frames), 4)
    ck_list("split-f0", frames[0], [])
    ck_list("split-f1", frames[1], [1, 2])
    ck_list("split-f2", frames[2], [3, 4])
    ck_list("split-f3", frames[3], [])
    // Also test a simple two-packet stream with no leading END: [1,2,0xC0,3,4]
    let stream2 = [1, 2, 192, 3, 4]
    let frames2 = slip_split(stream2)
    ck_int("split2-count", len(frames2), 2)
    ck_list("split2-f0", frames2[0], [1, 2])
    ck_list("split2-f1", frames2[1], [3, 4])
    print("KAT 11 PASS: slip_split OK")

// ── KAT 12: round-trip a payload of all 0xFF bytes ────────────────────────────
fn kat12()
    let data = []
    let i = 0
    while i < 10
        push(data, 255)
        i = i + 1
    let rt = slip_decode(slip_encode(data))
    ck_list("rt-all-FF", rt, data)
    print("KAT 12 PASS: round-trip 10× 0xFF OK")

fn main()
    kat1()
    kat2()
    kat3()
    kat4()
    kat5()
    kat6()
    kat7()
    kat8()
    kat9()
    kat10()
    kat11()
    kat12()
    print("PASS _slip_test")
