// Regression: a user 'extern fn' for a name already auto-declared by the
// runtime (puts/printf/strcmp) must compile cleanly. Before the dedupe fix,
// the compiler emitted two conflicting declares for strcmp and LLVM rejected
// the IR. This proves the dedupe path; the strcmp signature here matches the
// runtime's (i32 return, two ptr args via NOVA's i32/string annotations).
extern fn strcmp(a: string, b: string) -> i32

fn main()
    let eq = unsafe strcmp("hello", "hello")
    assert_eq(eq, 0)
    let lt = unsafe strcmp("apple", "banana")
    if lt >= 0
        print("FAIL: expected strcmp(apple, banana) < 0, got " + str(lt))
        exit(1)
    let gt = unsafe strcmp("banana", "apple")
    if gt <= 0
        print("FAIL: expected strcmp(banana, apple) > 0, got " + str(gt))
        exit(1)
    print("ffi dedupe test passed: user 'extern fn strcmp' coexists with runtime auto-declare")
