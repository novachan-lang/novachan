import forge_introots

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // iroot
    fails = fails + expect("sqrt100", str(iroot(100, 2)), "10")
    fails = fails + expect("sqrt99", str(iroot(99, 2)), "9")
    fails = fails + expect("cbrt27", str(iroot(27, 3)), "3")
    fails = fails + expect("cbrt26", str(iroot(26, 3)), "2")
    fails = fails + expect("cbrt28", str(iroot(28, 3)), "3")
    fails = fails + expect("root4_16", str(iroot(16, 4)), "2")
    fails = fails + expect("root5_1", str(iroot(1, 5)), "1")
    fails = fails + expect("root_0", str(iroot(0, 3)), "0")
    fails = fails + expect("cbrt1000", str(iroot(1000, 3)), "10")
    // large, overflow-safe
    fails = fails + expect("sqrt_1e12", str(iroot(1000000000000, 2)), "1000000")
    fails = fails + expect("cbrt_1e18", str(iroot(1000000000000000000, 3)), "1000000")

    // perfect square / cube
    fails = fails + expect("psq_144", str(is_perfect_square(144)), "true")
    fails = fails + expect("psq_145", str(is_perfect_square(145)), "false")
    fails = fails + expect("psq_0", str(is_perfect_square(0)), "true")
    fails = fails + expect("pcube_27", str(is_perfect_cube(27)), "true")
    fails = fails + expect("pcube_28", str(is_perfect_cube(28)), "false")
    fails = fails + expect("pcube_1000", str(is_perfect_cube(1000)), "true")

    // perfect power
    let p64 = is_perfect_power(64)
    fails = fails + expect("pp64", str(p64[0]) + "," + str(p64[1]) + "," + str(p64[2]), "1,2,6")
    let p100 = is_perfect_power(100)
    fails = fails + expect("pp100", str(p100[0]) + "," + str(p100[1]) + "," + str(p100[2]), "1,10,2")
    let p1000 = is_perfect_power(1000)
    fails = fails + expect("pp1000", str(p1000[0]) + "," + str(p1000[1]) + "," + str(p1000[2]), "1,10,3")
    let p7 = is_perfect_power(7)
    fails = fails + expect("pp7", str(p7[0]), "0")
    let p2 = is_perfect_power(2)
    fails = fails + expect("pp2", str(p2[0]), "0")
    let p81 = is_perfect_power(81)
    fails = fails + expect("pp81", str(p81[0]) + "," + str(p81[1]) + "," + str(p81[2]), "1,3,4")

    if fails == 0
        print("forge_introots: all passed")
    else
        print("forge_introots: " + str(fails) + " FAILED")
