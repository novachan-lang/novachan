// Stage 0C guard (run with NOVA_CARRIERS>1): concurrent FLOAT BOXING across carriers stresses
// nova_box_track (the g_box_lo/g_box_hi monotonic-CAS write race) and the box-bounds reader. A
// clobbered box bound => a boxed float misclassified on unbox => wrong value or crash. Each worker
// boxes floats into an any-typed dict and reads them back; asserts the exact float sum.

fn worker(reps)
    let acc = 0.0
    let i = 0
    while i < reps
        let d = {}
        d["a"] = 1.5            // boxed float (any-typed dict value) -> nova_box_track (CAS at N>1)
        d["b"] = 0.25           // boxed float
        let x = d["a"]          // unbox through `any` (box-bounds reader)
        let y = d["b"]
        acc = acc + x + y       // float arithmetic on the unboxed values
        i = i + 1
    acc

fn main() -> int
    let workers = 8
    let reps = 3000
    let hub = channel()
    let w = 0
    while w < workers
        spawn fn()
            send(hub, worker(reps))
        w = w + 1
    let total = 0.0
    let got = 0
    while got < workers
        total = total + receive(hub)
        got = got + 1
    // per worker = reps * (1.5 + 0.25) = reps * 1.75 ; total = 8 * 3000 * 1.75 = 42000.0
    assert_near(total, 42000.0, 1.0)
    print("PASS n1_box (8 workers x3000 boxed-float+dispatch)")
    return 0
