// KAT: std/core/result_ext — Result / Option combinators (map/and_then/collect).
import std/core/result_ext

// helper for r_and_then chaining tests: halve if even, else fail.
fn half_if_even(x: int) -> Result
    if x % 2 == 0
        return ok(x / 2)
    return err("odd")

// helper for o_and_then chaining tests: halve if even, else None.
fn half_if_even_opt(x: int) -> Option
    if x % 2 == 0
        return some(x / 2)
    return none()

fn main() -> int
    let fails = 0

    // r_is_ok
    if r_is_ok(ok(1)) != true
        print("FAIL r_is_ok(ok)=" + str(r_is_ok(ok(1))))
        fails = fails + 1
    if r_is_ok(err("e")) != false
        print("FAIL r_is_ok(err)=" + str(r_is_ok(err("e"))))
        fails = fails + 1

    // r_map — Ok maps, Err passes through unchanged
    if r_map(ok(3), fn(x) x * 2) != ok(6)
        print("FAIL r_map ok=" + str(r_map(ok(3), fn(x) x * 2)))
        fails = fails + 1
    if r_map(err("boom"), fn(x) x * 2) != err("boom")
        print("FAIL r_map err=" + str(r_map(err("boom"), fn(x) x * 2)))
        fails = fails + 1

    // r_map_err — Err maps, Ok passes through unchanged. Destructured via
    // match rather than `!= err(4)`: comparing a Result whose Err type
    // CHANGED (string -> int) against a literal of the new type does not
    // type-check for a bare-`Result`-typed function (a real, isolated
    // compiler gap — see the module header's GENERICS note and
    // compiler_findings; `result_map_err` in std/core/result.nova has the
    // identical limitation, so this is pre-existing, not new).
    let me1 = r_map_err(err("boom"), fn(e) len(e))
    match me1
        Ok(v) =>
            print("FAIL r_map_err err= got Ok " + str(v))
            fails = fails + 1
        Err(e) =>
            if str(e) != "4"
                print("FAIL r_map_err err=" + str(e))
                fails = fails + 1
    if r_map_err(ok(9), fn(e) len(e)) != ok(9)
        print("FAIL r_map_err ok=" + str(r_map_err(ok(9), fn(e) len(e))))
        fails = fails + 1

    // r_and_then — chained validation: parse-like step then a positivity check
    let chained = r_and_then(r_and_then(ok(20), half_if_even), half_if_even)
    if chained != ok(5)
        print("FAIL r_and_then chain=" + str(chained))
        fails = fails + 1

    let chained_fail = r_and_then(r_and_then(ok(20), half_if_even), fn(x) err("stop"))
    if chained_fail != err("stop")
        print("FAIL r_and_then short-circuit=" + str(chained_fail))
        fails = fails + 1

    // r_or_else — recover from Err; Ok passes through
    if r_or_else(err("bad"), fn(e) ok(0)) != ok(0)
        print("FAIL r_or_else recover=" + str(r_or_else(err("bad"), fn(e) ok(0))))
        fails = fails + 1
    if r_or_else(ok(42), fn(e) ok(0)) != ok(42)
        print("FAIL r_or_else passthrough=" + str(r_or_else(ok(42), fn(e) ok(0))))
        fails = fails + 1

    // r_unwrap_or
    if r_unwrap_or(err("nope"), 9) != 9
        print("FAIL r_unwrap_or err=" + str(r_unwrap_or(err("nope"), 9)))
        fails = fails + 1
    if r_unwrap_or(ok(5), 9) != 5
        print("FAIL r_unwrap_or ok=" + str(r_unwrap_or(ok(5), 9)))
        fails = fails + 1

    // r_ok_option — drop the error, project to Option
    if r_ok_option(ok(7)) != some(7)
        print("FAIL r_ok_option ok=" + str(r_ok_option(ok(7))))
        fails = fails + 1
    if r_ok_option(err("x")) != none()
        print("FAIL r_ok_option err=" + str(r_ok_option(err("x"))))
        fails = fails + 1

    // o_map — Some maps, None passes through
    if o_map(some(21), fn(x) x * 2) != some(42)
        print("FAIL o_map some=" + str(o_map(some(21), fn(x) x * 2)))
        fails = fails + 1
    if o_map(none(), fn(x) x * 2) != none()
        print("FAIL o_map none=" + str(o_map(none(), fn(x) x * 2)))
        fails = fails + 1

    // o_and_then — chained lookup-like step
    if o_and_then(some(10), half_if_even_opt) != some(5)
        print("FAIL o_and_then some=" + str(o_and_then(some(10), half_if_even_opt)))
        fails = fails + 1
    if o_and_then(some(7), half_if_even_opt) != none()
        print("FAIL o_and_then none=" + str(o_and_then(some(7), half_if_even_opt)))
        fails = fails + 1

    // o_unwrap_or
    if o_unwrap_or(none(), 99) != 99
        print("FAIL o_unwrap_or none=" + str(o_unwrap_or(none(), 99)))
        fails = fails + 1
    if o_unwrap_or(some(3), 99) != 3
        print("FAIL o_unwrap_or some=" + str(o_unwrap_or(some(3), 99)))
        fails = fails + 1

    // o_filter
    if o_filter(some(4), fn(x) x % 2 == 0) != some(4)
        print("FAIL o_filter keep=" + str(o_filter(some(4), fn(x) x % 2 == 0)))
        fails = fails + 1
    if o_filter(some(5), fn(x) x % 2 == 0) != none()
        print("FAIL o_filter drop=" + str(o_filter(some(5), fn(x) x % 2 == 0)))
        fails = fails + 1
    if o_filter(none(), fn(x) x % 2 == 0) != none()
        print("FAIL o_filter none=" + str(o_filter(none(), fn(x) x % 2 == 0)))
        fails = fails + 1

    // o_ok_or — attach an error to a missing value
    if o_ok_or(some(8), "missing") != ok(8)
        print("FAIL o_ok_or some=" + str(o_ok_or(some(8), "missing")))
        fails = fails + 1
    if o_ok_or(none(), "missing") != err("missing")
        print("FAIL o_ok_or none=" + str(o_ok_or(none(), "missing")))
        fails = fails + 1

    // collect_results — all-Ok collapses to Ok(list); first Err short-circuits
    let all_ok = collect_results([ok(1), ok(2), ok(3)])
    if all_ok != ok([1, 2, 3])
        print("FAIL collect_results all_ok=" + str(all_ok))
        fails = fails + 1

    let with_err = collect_results([ok(1), err("bad"), ok(3)])
    if with_err != err("bad")
        print("FAIL collect_results with_err=" + str(with_err))
        fails = fails + 1

    // collect_results short-circuits: a later Err ("second") must never surface
    // if an earlier Err ("first") already fired.
    let two_errs = collect_results([ok(1), err("first"), err("second")])
    if two_errs != err("first")
        print("FAIL collect_results short-circuit=" + str(two_errs))
        fails = fails + 1

    let empty_ok = collect_results([])
    if empty_ok != ok([])
        print("FAIL collect_results empty=" + str(empty_ok))
        fails = fails + 1

    // partition_results — no short-circuit, both lists in original order
    let part = partition_results([ok(1), err("a"), ok(2), err("b"), ok(3)])
    if part != [[1, 2, 3], ["a", "b"]]
        print("FAIL partition_results=" + str(part))
        fails = fails + 1

    if fails == 0
        print("RESULT_EXT KAT PASS")
    else
        print("RESULT_EXT KAT FAILED (" + str(fails) + ")")
    return 0
