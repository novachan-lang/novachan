import forge_ota_manager

fn main()
    let s = ota_new()
    s = ota_register(s, "dev-1", "1.0.0")
    s = ota_register(s, "dev-2", "1.0.0")
    s = ota_register(s, "dev-3", "0.9.0")

    assert(ota_device_count(s) == 3, "3 devices registered")

    // before any release: nothing pending, nothing "updated"
    assert(ota_pending_count(s) == 0, "0 pending before release")
    assert(ota_updated_count(s) == 0, "0 updated before release")
    assert(is_err(ota_latest_version(s)), "no latest version before publish")

    let c0 = ota_check(s, "dev-1")
    assert(is_ok(c0), "check dev-1 ok")
    assert(unwrap(c0) == "up_to_date", "dev-1 up to date pre-release")

    s = ota_publish(s, "2.0.0", "bugfixes and perf")

    let lv = ota_latest_version(s)
    assert(is_ok(lv), "latest version ok after publish")
    assert(unwrap(lv) == "2.0.0", "latest is 2.0.0")

    let c1 = ota_check(s, "dev-1")
    assert(is_ok(c1), "check dev-1 ok")
    assert(unwrap(c1) == "available", "dev-1 update available")

    assert(ota_pending_count(s) == 3, "3 pending after publish")
    assert(ota_updated_count(s) == 0, "0 updated right after publish")

    let ap = ota_apply(s, "dev-1")
    assert(is_ok(ap), "apply dev-1 ok")
    assert(unwrap(ap) == "2.0.0", "dev-1 applied to 2.0.0")

    let st1 = ota_status(s, "dev-1")
    assert(is_ok(st1), "status dev-1 ok")
    assert(unwrap(st1) == "2.0.0", "dev-1 status is 2.0.0")

    let c2 = ota_check(s, "dev-1")
    assert(unwrap(c2) == "up_to_date", "dev-1 up to date after apply")

    assert(ota_pending_count(s) == 2, "2 pending after one apply")
    assert(ota_updated_count(s) == 1, "1 updated after one apply")

    assert(is_err(ota_check(s, "ghost")), "check unknown device errors")
    assert(is_err(ota_apply(s, "ghost")), "apply unknown device errors")
    assert(is_err(ota_status(s, "ghost")), "status unknown device errors")

    // re-registering an existing device should not double count
    s = ota_register(s, "dev-2", "1.0.0")
    assert(ota_device_count(s) == 3, "still 3 devices after re-register")

    print("OTA-MANAGER KAT PASS")
