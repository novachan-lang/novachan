// Generality check for FFI: call several distinct libc functions with
// different signatures (int->int, str->str, str,str->int) — proves the
// wrapper machinery generalizes beyond strlen.
extern fn abs(x: int) -> int
// strchr returns 'const char*' — opaque pointer; we hold it as int (a handle).
extern fn strchr(s: string, c: int) -> int
// tolower: int->int conversion through the wrapper, exercises a different shape.
extern fn tolower(c: int) -> int

fn main()
    assert_eq(unsafe abs(-42), 42)
    assert_eq(unsafe abs(0), 0)
    assert_eq(unsafe abs(7), 7)

    // strchr("hello", 'l') returns pointer to first 'l'; non-null means found.
    let found = unsafe strchr("hello", 108)
    if found == 0
        print("FAIL strchr: expected non-null pointer for 'l' in 'hello'")
        exit(1)
    let missing = unsafe strchr("hello", 122)
    if missing != 0
        print("FAIL strchr: expected null pointer for 'z' in 'hello'")
        exit(1)

    assert_eq(unsafe tolower(65), 97)
    assert_eq(unsafe tolower(90), 122)
    assert_eq(unsafe tolower(48), 48)

    print("ffi libc test passed: abs, strchr, tolower all dispatched correctly through nova_ffi wrappers")
