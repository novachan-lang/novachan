import std/probability/prob_hypergeometric

fn ckr(label: string, got: list, wn: int, wd: int)
    if got[0] != wn or got[1] != wd
        print("FAIL " + label + ": got=" + str(got[0]) + "/" + str(got[1]) + " want=" + str(wn) + "/" + str(wd))
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ph_pmf(4,2,2,1) = C(2,1)*C(2,1)/C(4,2) = 2*2/6 = 4/6 = 2/3
    ckr("pmf(4,2,2,1)", ph_pmf(4, 2, 2, 1), 2, 3)

    // ph_pmf(4,2,2,2) = C(2,2)*C(2,0)/C(4,2) = 1*1/6 = 1/6
    ckr("pmf(4,2,2,2)", ph_pmf(4, 2, 2, 2), 1, 6)

    // ph_pmf(4,2,2,0) = C(2,0)*C(2,2)/C(4,2) = 1*1/6 = 1/6
    ckr("pmf(4,2,2,0)", ph_pmf(4, 2, 2, 0), 1, 6)

    // ph_pmf(5,3,2,2) = C(3,2)*C(2,0)/C(5,2) = 3*1/10 = 3/10
    ckr("pmf(5,3,2,2)", ph_pmf(5, 3, 2, 2), 3, 10)

    // ph_mean(4,2,2) = 2*2/4 = 4/4 = 1/1
    ckr("mean(4,2,2)", ph_mean(4, 2, 2), 1, 1)

    // Edge: k > K => 0
    ckr("pmf k>K", ph_pmf(4, 2, 2, 3), 0, 1)

    // Edge: k < 0 => 0
    ckr("pmf k<0", ph_pmf(4, 2, 2, -1), 0, 1)

    // Edge: n-k > N-K (impossible draw) => 0
    // ph_pmf(5,2,4,0): n-k=4 > N-K=3 => 0
    ckr("pmf impossible", ph_pmf(5, 2, 4, 0), 0, 1)

    // ph_at_least(4,2,2,1) = P(X=1)+P(X=2) = 2/3+1/6 = 4/6+1/6 = 5/6
    ckr("at_least(4,2,2,1)", ph_at_least(4, 2, 2, 1), 5, 6)

    // ph_at_least(4,2,2,0) = P(X=0)+P(X=1)+P(X=2) = 1/6+2/3+1/6 = 1
    ckr("at_least(4,2,2,0)", ph_at_least(4, 2, 2, 0), 1, 1)

    // ph_at_least(4,2,2,2) = P(X=2) = 1/6
    ckr("at_least(4,2,2,2)", ph_at_least(4, 2, 2, 2), 1, 6)

    // ph_at_least(4,2,2,3) = 0 (k>min(K,n)=2)
    ckr("at_least(4,2,2,3)", ph_at_least(4, 2, 2, 3), 0, 1)

    // ph_mean when N=0 => 0/1
    ckr("mean N=0", ph_mean(0, 0, 0), 0, 1)

    print("PASS _prob_hypergeometric_test")
