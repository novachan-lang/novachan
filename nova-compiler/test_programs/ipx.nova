fn ip_parse(s)
  let parts = split(s, ".")
  if len(parts) != 4
    return err("invalid IPv4: need 4 octets")
  let octets = []
  for p in parts
    let r = parse_int_safe(p)
    if is_err(r)
      return err("invalid octet: " + p)
    let v = unwrap(r)
    if v < 0 or v > 255
      return err("octet out of range: " + str(v))
    push(octets, v)
  ok(octets)

fn ip_str(octets)
  str(octets[0]) + "." + str(octets[1]) + "." + str(octets[2]) + "." + str(octets[3])

fn ip_is_private(octets)
  let a = octets[0]
  let b = octets[1]
  if a == 10
    return 1
  if a == 172 and b >= 16 and b <= 31
    return 1
  if a == 192 and b == 168
    return 1
  0

fn ip_is_loopback(octets)
  octets[0] == 127

fn ip_in_cidr(ip_octets, network_octets, prefix_len)
  let ip_int = ip_octets[0] * 16777216 + ip_octets[1] * 65536 + ip_octets[2] * 256 + ip_octets[3]
  let net_int = network_octets[0] * 16777216 + network_octets[1] * 65536 + network_octets[2] * 256 + network_octets[3]
  let mask = 0
  if prefix_len > 0
    mask = ((1 << prefix_len) - 1) << (32 - prefix_len)
  (ip_int & mask) == (net_int & mask)

fn main()
  let parsed = ip_parse("192.168.1.100")
  assert(is_ok(parsed), "parse ok")
  let ip = unwrap(parsed)
  assert(ip[0] == 192, "first octet")
  assert(ip[3] == 100, "last octet")

  assert(ip_str(ip) == "192.168.1.100", "to string")

  assert(ip_is_private(ip) == 1, "192.168 is private")
  assert(ip_is_private(unwrap(ip_parse("10.0.0.1"))) == 1, "10.x is private")
  assert(ip_is_private(unwrap(ip_parse("8.8.8.8"))) == 0, "8.8.8.8 is public")
  assert(ip_is_loopback(unwrap(ip_parse("127.0.0.1"))) == 1, "loopback")
  assert(ip_is_loopback(ip) == 0, "not loopback")

  assert(is_err(ip_parse("256.0.0.1")), "octet > 255")
  assert(is_err(ip_parse("1.2.3")), "only 3 octets")
  assert(is_err(ip_parse("abc.def.ghi.jkl")), "non-numeric")

  let _net = unwrap(ip_parse("192.168.1.0"))
  assert(ip_in_cidr(ip, _net, 24) == 1, "in /24")
  let _other = unwrap(ip_parse("192.168.2.1"))
  assert(ip_in_cidr(_other, _net, 24) == 0, "not in /24")

  print("ipx: all passed")
