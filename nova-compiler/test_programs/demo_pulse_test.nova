// NOVA Pulse v0.1 demo: read CSV, filter, group_by, aggregate sums.
// All in pure NOVA, single binary.
import pulse

fn amount_over_100(row: list) -> bool
    parse_float(row[2]) > 100.0

fn main()
    // Set up a sales.csv fixture
    let csv = "region,product,amount\n"
    csv = csv + "west,apple,50\n"
    csv = csv + "west,banana,150\n"
    csv = csv + "east,apple,75\n"
    csv = csv + "east,banana,225\n"
    csv = csv + "west,cherry,300\n"
    csv = csv + "east,cherry,125\n"
    write_file("sales.csv", csv)

    let rows = pulse.read_csv("sales.csv")
    // header + 6 data rows
    assert_eq(pulse.count_rows(rows), 7)

    // Skip header by filtering: header row's col 2 is "amount", which
    // parse_float treats as 0.0 → < 100 → excluded. Then we keep rows
    // where amount > 100.
    let big = pulse.filter_rows(rows, amount_over_100)
    // big should be: [west,banana,150], [east,banana,225], [west,cherry,300], [east,cherry,125]
    assert_eq(pulse.count_rows(big), 4)

    // Group by region (col 0)
    let by_region = pulse.group_by(big, 0)
    // west: [banana 150, cherry 300] -> sum 450
    // east: [banana 225, cherry 125] -> sum 350
    let totals = pulse.agg_sum(by_region, 2)

    let west = totals["west"]
    let east = totals["east"]
    assert_near(west, 450.0, 0.001)
    assert_near(east, 350.0, 0.001)

    print("PULSE v0.1 demo passed: CSV → filter > 100 → group_by region → sum amount; west=450, east=350 — pure-NOVA data pipeline")
