import std/statistics/stat_rank

fn ckf(label: string, got: float, want: float)
    let d = got - want
    if d < 0.0
        d = 0.0 - d
    if d > 0.001
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + ": length mismatch " + str(len(got)) + " != " + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        let g = got[i] * 1.0
        let w = want[i] * 1.0
        let d = g - w
        if d < 0.0
            d = 0.0 - d
        if d > 0.001
            print("FAIL " + label + "[" + str(i) + "]: got=" + str(g) + " want=" + str(w))
            exit(1)
        i = i + 1

fn main()
    let r1 = sr_rankings([10, 30, 20])
    ckl("rankings_basic", r1, [1.0, 3.0, 2.0])
    let r2 = sr_rankings([10, 10, 20])
    ckl("rankings_tie", r2, [1.5, 1.5, 3.0])
    ckf("spearman_pos1", sr_spearman([1, 2, 3], [2, 4, 6]), 1.0)
    ckf("spearman_neg1", sr_spearman([1, 2, 3], [6, 4, 2]), -1.0)
    ckf("spearman_partial", sr_spearman([1, 2, 3, 4], [1, 3, 2, 4]), 0.8)
    let em = []
    let er = sr_rankings(em)
    ckl("rankings_empty", er, [])
    ckf("spearman_empty", sr_spearman(em, em), 0.0)
    let r3 = sr_rankings([5, 5, 5])
    ckl("rankings_all_tie", r3, [2.0, 2.0, 2.0])
    print("PASS _stat_rank_test")
