import forge_static_server

fn main()
    let s = sf_new("/var/www")
    assert(sf_get_index(s) == "index.html", "default index")
    assert(sf_get_cache_ttl(s) == 0, "default ttl 0")
    assert(sf_mime_count(s) == 0, "no mime mappings")

    s = sf_add_mime(s, ".html", "text/html")
    s = sf_add_mime(s, ".css", "text/css")
    s = sf_add_mime(s, ".js", "application/javascript")
    assert(sf_mime_count(s) == 3, "3 mime mappings")
    assert(sf_has_mime(s, ".html") == 1, "has .html")
    assert(sf_has_mime(s, ".png") == 0, "no .png")

    let mh = sf_get_mime(s, ".css")
    assert(is_ok(mh), "get_mime ok")
    assert(unwrap(mh) == "text/css", "css mime")

    let mmiss = sf_get_mime(s, ".png")
    assert(is_err(mmiss), "missing mime err")

    s = sf_add_mime(s, ".css", "text/css; charset=utf-8")
    assert(sf_mime_count(s) == 3, "still 3 after overwrite")
    let mh2 = sf_get_mime(s, ".css")
    assert(unwrap(mh2) == "text/css; charset=utf-8", "css mime overwritten")

    let r1 = sf_resolve(s, "/style.css")
    assert(is_ok(r1), "resolve ok")
    assert(unwrap(r1) == "/var/www/style.css", "resolved plain path")

    let r2 = sf_resolve(s, "/")
    assert(is_ok(r2), "resolve root ok")
    assert(unwrap(r2) == "/var/www/index.html", "resolved root -> index")

    let r3 = sf_resolve(s, "")
    assert(is_ok(r3), "resolve empty ok")
    assert(unwrap(r3) == "/var/www/index.html", "resolved empty -> index")

    let r4 = sf_resolve(s, "assets/logo.png")
    assert(is_ok(r4), "resolve relative ok")
    assert(unwrap(r4) == "/var/www/assets/logo.png", "leading slash added")

    let bad1 = sf_resolve(s, "/../../etc/passwd")
    assert(is_err(bad1), "traversal rejected 1")

    let bad2 = sf_resolve(s, "/a/../../b")
    assert(is_err(bad2), "traversal rejected 2")

    let bad3 = sf_resolve(s, "..")
    assert(is_err(bad3), "traversal rejected 3 bare ..")

    s = sf_set_index(s, "home.html")
    assert(sf_get_index(s) == "home.html", "index changed")
    let r5 = sf_resolve(s, "/")
    assert(unwrap(r5) == "/var/www/home.html", "resolved root uses new index")

    s = sf_set_cache_ttl(s, 3600)
    assert(sf_get_cache_ttl(s) == 3600, "ttl set to 3600")

    print("STATIC-SERVER KAT PASS")
