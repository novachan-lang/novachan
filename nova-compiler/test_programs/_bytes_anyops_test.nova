// _bytes_anyops_test -- Stage-0b: bytes routed through the ADJACENT any-dispatch ops the suite never
// exercised (index []/slice [a:b]/for-in/index-set []=/type_of). bytes() returns `any`, so these lower to
// nova_rt_index_get / slice_any / for_iter_init / index_set / type_of -- which pre-Stage-0b had NO BYTES
// arm and wild-read/overread the NovaBytes struct as a list/string. This is the adversarial coverage the
// review (wmy6zzoae) found missing. Embedded NULs verify the ops are size-based, not strlen/int64-strided.
fn main()
    let b = bytes(5)
    bytes_set(b, 0, 65)
    bytes_set(b, 1, 0)
    bytes_set(b, 2, 66)
    bytes_set(b, 3, 0)
    bytes_set(b, 4, 67)

    // index via [] -> nova_rt_index_get (was: str_char_at -> strlen wild-read)
    assert(b[0] == 65, "any-index [0] == 65")
    assert(b[1] == 0, "any-index [1] == 0 (NUL, not a terminator)")
    assert(b[4] == 67, "any-index [4] == 67")

    // index-set via []= -> nova_rt_index_set (was: silent no-op)
    b[0] = 88
    assert(b[0] == 88, "any-index-set [0] = 88 took effect")
    bytes_set(b, 0, 65)

    // slice via [a:b] -> nova_rt_slice_any (was: nova_rt_slice -> strlen wild-read)
    let sl = b[1:4]
    assert(type_name(sl) == "bytes", "slice of bytes is bytes")
    assert(bytes_len(sl) == 3, "slice len 3")
    assert(bytes_get(sl, 0) == 0, "slice[0] == 0 (NUL copied from b[1])")
    assert(bytes_get(sl, 1) == 66, "slice[1] == 66")

    // for-in -> nova_rt_for_iter_init (was: int64-strided overread past the buffer)
    let total = 0
    for x in b
        total = total + x
    assert(total == 198, "for-in sums byte values (65+0+66+0+67), no overread")

    // type dispatch consistency (was: type_of/type_hash said "string"/"int")
    assert(type_of(b) == "bytes", "type_of(bytes) == bytes, consistent with type_name")

    print("PASS: any-erased bytes ops (index/slice/for/index-set/type_of) sound + correct")
    print("_bytes_anyops_test passed")
