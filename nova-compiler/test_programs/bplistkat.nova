// Canonical KAT for std/encoding/plist (Apple bplist00 binary property list).
// Byte-exact vectors for the task's own worked examples (int 42, "hi",
// bool true, dict {"a":1} with a verified offset table + trailer), plus
// round-trip, boundary, overflow-count, injection, and adversarial-input
// coverage.
import std/encoding/plist
import std/encoding/pack

fn _hex(b) -> string
    let digs = "0123456789abcdef"
    let out = ""
    let n = bytes_len(b)
    let i = 0
    while i < n
        let v = bytes_get(b, i)
        out = out + char_at(digs, (v >> 4) & 15) + char_at(digs, v & 15)
        i = i + 1
    return out

fn eq_s(name: string, got: string, want: string)
    if got != want
        print("FAIL " + name + ": got '" + got + "' want '" + want + "'")
        exit(1)
    print("ok " + name)

fn eq_i(name: string, got: int, want: int)
    if got != want
        print("FAIL " + name + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("ok " + name)

fn eq_f(name: string, got: float, want: float)
    let d = got - want
    if d < 0.0
        d = 0.0 - d
    if d > 0.0000001
        print("FAIL " + name + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("ok " + name)

fn main()
    // ── 1) int 42: byte-exact marker + value, full file structure ────────
    let e42 = plist_encode(42)
    eq_i("int42 file length", bytes_len(e42), 43)
    eq_s("int42 header", bytes_to_str(bytes_slice(e42, 0, 8)), "bplist00")
    eq_s("int42 marker+value", _hex(bytes_slice(e42, 8, 10)), "102a")
    eq_s("int42 offset table", _hex(bytes_slice(e42, 10, 11)), "08")
    eq_i("int42 trailer offset-int-size", bytes_get(e42, 17), 1)
    eq_i("int42 trailer object-ref-size", bytes_get(e42, 18), 1)
    eq_i("int42 trailer num-objects", unpack_u64_be(e42, 19), 1)
    eq_i("int42 trailer top-object", unpack_u64_be(e42, 27), 0)
    eq_i("int42 trailer offset-table-start", unpack_u64_be(e42, 35), 10)
    eq_i("int42 roundtrip", plist_decode(e42), 42)

    // ── 2) ASCII string "hi": byte-exact marker + payload ────────────────
    let ehi = plist_encode("hi")
    eq_s("hi header", bytes_to_str(bytes_slice(ehi, 0, 8)), "bplist00")
    eq_s("hi marker+bytes", _hex(bytes_slice(ehi, 8, 11)), "526869")
    eq_s("hi roundtrip", plist_decode(ehi), "hi")

    // ── 3) bool true/false via plist_bool() ───────────────────────────────
    let etrue = plist_encode(plist_bool(true))
    eq_s("bool true marker", _hex(bytes_slice(etrue, 8, 9)), "09")
    eq_i("bool true roundtrip", plist_decode(etrue), 1)
    let efalse = plist_encode(plist_bool(false))
    eq_s("bool false marker", _hex(bytes_slice(efalse, 8, 9)), "08")
    eq_i("bool false roundtrip", plist_decode(efalse), 0)

    // ── 4) explicit null marker via plist_null() ──────────────────────────
    let enull = plist_encode(plist_null())
    eq_s("null marker", _hex(bytes_slice(enull, 8, 9)), "00")

    // ── 5) dict {"a":1}: byte-exact body + offset table + trailer ────────
    let da1 = {}
    da1["a"] = 1
    let ed = plist_encode(da1)
    eq_i("dict file length", bytes_len(ed), 50)
    eq_s("dict header", bytes_to_str(bytes_slice(ed, 0, 8)), "bplist00")
    eq_s("dict body (dict+key+int objects)", _hex(bytes_slice(ed, 8, 15)), "d1010251611001")
    eq_s("dict offset table (3 entries)", _hex(bytes_slice(ed, 15, 18)), "080b0d")
    eq_i("dict trailer offset-int-size", bytes_get(ed, 24), 1)
    eq_i("dict trailer object-ref-size", bytes_get(ed, 25), 1)
    eq_i("dict trailer num-objects", unpack_u64_be(ed, 26), 3)
    eq_i("dict trailer top-object", unpack_u64_be(ed, 34), 0)
    eq_i("dict trailer offset-table-start", unpack_u64_be(ed, 42), 15)
    let dd = plist_decode(ed)
    eq_i("dict roundtrip value", dd["a"], 1)
    eq_i("dict roundtrip key count", len(keys(dd)), 1)

    // ── 6) int width boundaries + markers ─────────────────────────────────
    eq_s("marker int 127 (1 byte)", _hex(bytes_slice(plist_encode(127), 8, 9)), "10")
    eq_s("marker int 128 (2 bytes)", _hex(bytes_slice(plist_encode(128), 8, 9)), "11")
    eq_s("marker int 32768 (4 bytes)", _hex(bytes_slice(plist_encode(32768), 8, 9)), "12")
    eq_s("marker int 2147483648 (8 bytes)", _hex(bytes_slice(plist_encode(2147483648), 8, 9)), "13")
    eq_s("marker int -1 (always 8 bytes)", _hex(bytes_slice(plist_encode(0 - 1), 8, 9)), "13")

    eq_i("rt int 127", plist_decode(plist_encode(127)), 127)
    eq_i("rt int 128", plist_decode(plist_encode(128)), 128)
    eq_i("rt int 255", plist_decode(plist_encode(255)), 255)
    eq_i("rt int 256", plist_decode(plist_encode(256)), 256)
    eq_i("rt int 32767", plist_decode(plist_encode(32767)), 32767)
    eq_i("rt int 32768", plist_decode(plist_encode(32768)), 32768)
    eq_i("rt int 2147483647", plist_decode(plist_encode(2147483647)), 2147483647)
    eq_i("rt int 2147483648", plist_decode(plist_encode(2147483648)), 2147483648)
    eq_i("rt int -1", plist_decode(plist_encode(0 - 1)), 0 - 1)
    eq_i("rt int -128", plist_decode(plist_encode(0 - 128)), 0 - 128)
    eq_i("rt int -129", plist_decode(plist_encode(0 - 129)), 0 - 129)
    eq_i("rt int -2147483648", plist_decode(plist_encode(0 - 2147483648)), 0 - 2147483648)
    eq_i("rt int i64 max", plist_decode(plist_encode(9223372036854775807)), 9223372036854775807)
    eq_i("rt int i64 near-min", plist_decode(plist_encode(0 - 9223372036854775807)), 0 - 9223372036854775807)

    // ── 7) float ──────────────────────────────────────────────────────────
    eq_s("marker float (always 8-byte double)", _hex(bytes_slice(plist_encode(2.5), 8, 9)), "23")
    eq_f("rt float pi-ish", plist_decode(plist_encode(3.14159265358979)), 3.14159265358979)
    eq_f("rt float zero", plist_decode(plist_encode(0.0)), 0.0)
    eq_f("rt float negative", plist_decode(plist_encode(0.0 - 2.5)), 0.0 - 2.5)

    // ── 8) empty containers ─────────────────────────────────────────────
    eq_i("rt empty list len", len(plist_decode(plist_encode([]))), 0)
    let ed0 = {}
    eq_i("rt empty dict key count", len(keys(plist_decode(plist_encode(ed0)))), 0)
    eq_i("rt empty bytes len", bytes_len(plist_decode(plist_encode(bytes_create(0)))), 0)
    eq_s("rt empty string", plist_decode(plist_encode("")), "")

    // ── 9) UTF-16BE strings (BMP + surrogate-pair non-BMP) ────────────────
    let uc = from_codepoint(0x00E9) + "b"
    let euc = plist_encode(uc)
    eq_i("utf16 marker family (BMP)", bytes_get(euc, 8) & 0xF0, 0x60)
    eq_s("rt utf16 BMP string", plist_decode(euc), uc)

    let uemoji = from_codepoint(0x1F600)
    let euemoji = plist_encode(uemoji)
    eq_i("utf16 marker family (surrogate pair)", bytes_get(euemoji, 8) & 0xF0, 0x60)
    eq_i("utf16 surrogate pair unit count", bytes_get(euemoji, 8) & 0x0F, 2)
    eq_s("rt utf16 surrogate-pair string", plist_decode(euemoji), uemoji)

    // ── 10) data (bytes), including an embedded 0x00 byte ─────────────────
    let bd = bytes_create(3)
    bytes_set(bd, 0, 0)
    bytes_set(bd, 1, 255)
    bytes_set(bd, 2, 65)
    let ebd = plist_encode(bd)
    eq_i("data marker family", bytes_get(ebd, 8) & 0xF0, 0x40)
    eq_i("data marker count", bytes_get(ebd, 8) & 0x0F, 3)
    let dbd = plist_decode(ebd)
    eq_i("rt data len", bytes_len(dbd), 3)
    eq_i("rt data byte0 (0x00 preserved)", bytes_get(dbd, 0), 0)
    eq_i("rt data byte1", bytes_get(dbd, 1), 255)
    eq_i("rt data byte2", bytes_get(dbd, 2), 65)

    // ── 11) nested array/dict roundtrip ────────────────────────────────────
    let inner = {}
    inner["x"] = 1
    inner["y"] = 2
    let midlist = [inner, 42, "z"]
    let outer = {}
    outer["items"] = midlist
    outer["count"] = 3
    let eouter = plist_encode(outer)
    let douter = plist_decode(eouter)
    eq_i("nested outer.count", douter["count"], 3)
    let ditems = douter["items"]
    eq_i("nested items length", len(ditems), 3)
    let dinner = ditems[0]
    eq_i("nested inner.x", dinner["x"], 1)
    eq_i("nested inner.y", dinner["y"], 2)
    eq_i("nested items[1]", ditems[1], 42)
    eq_s("nested items[2]", ditems[2], "z")

    // ── 12) count-overflow (>=15) framing: array/string/dict ─────────────
    let arr20 = []
    let iidx = 0
    while iidx < 20
        push(arr20, iidx)
        iidx = iidx + 1
    let earr20 = plist_encode(arr20)
    eq_i("array20 overflow low-nibble", bytes_get(earr20, 8) & 0x0F, 0x0F)
    eq_i("array20 marker family", bytes_get(earr20, 8) & 0xF0, 0xA0)
    let darr20 = plist_decode(earr20)
    eq_i("rt array20 length", len(darr20), 20)
    let chkidx = 0
    let arrok = 1
    while chkidx < 20
        if darr20[chkidx] != chkidx
            arrok = 0
        chkidx = chkidx + 1
    eq_i("rt array20 values", arrok, 1)

    let s20 = "xxxxxxxxxxxxxxxxxxxx"
    let es20 = plist_encode(s20)
    eq_i("string20 overflow low-nibble", bytes_get(es20, 8) & 0x0F, 0x0F)
    eq_s("rt string20", plist_decode(es20), s20)

    let d15 = {}
    let dk = 0
    while dk < 15
        d15["k" + str(dk)] = dk
        dk = dk + 1
    let ed15 = plist_encode(d15)
    eq_i("dict15 overflow low-nibble", bytes_get(ed15, 8) & 0x0F, 0x0F)
    let dd15 = plist_decode(ed15)
    eq_i("rt dict15 key count", len(keys(dd15)), 15)
    let dcheck = 0
    let dok = 1
    while dcheck < 15
        if dd15["k" + str(dcheck)] != dcheck
            dok = 0
        dcheck = dcheck + 1
    eq_i("rt dict15 values", dok, 1)

    // ── 13) injection safety: marker-mimicking bytes inside a data blob
    // never corrupt sibling key/value framing (length+ref indexed, never
    // delimiter-scanned) ───────────────────────────────────────────────
    let binj = bytes_create(4)
    bytes_set(binj, 0, 0xD0)
    bytes_set(binj, 1, 0xA0)
    bytes_set(binj, 2, 0x00)
    bytes_set(binj, 3, 0xFF)
    let dinj = {}
    dinj["blob"] = binj
    dinj["after"] = "safe"
    let einj = plist_encode(dinj)
    let dinjd = plist_decode(einj)
    eq_i("injection blob length", bytes_len(dinjd["blob"]), 4)
    eq_i("injection blob byte0 (0xD0 preserved raw)", bytes_get(dinjd["blob"], 0), 0xD0)
    eq_s("injection sibling key survives intact", dinjd["after"], "safe")

    // ── 14) adversarial decode: malformed/truncated/hostile input never
    // crashes and never hangs; always an in-band plist_error(...) ────────
    let tiny = bytes_create(5)
    let rtiny = plist_decode(tiny)
    eq_i("too-short buffer rejected in-band", plist_is_error(rtiny), 1)
    if len(plist_error_message(rtiny)) == 0
        print("FAIL: empty error message for too-short buffer")
        exit(1)
    print("ok too-short error message nonempty")

    let badhdr = plist_encode(42)
    bytes_set(badhdr, 0, 0x58)
    eq_i("bad header rejected in-band", plist_is_error(plist_decode(badhdr)), 1)

    let badw = plist_encode(42)
    bytes_set(badw, 17, 0)
    eq_i("invalid offset-int-size rejected in-band", plist_is_error(plist_decode(badw)), 1)

    let badw2 = plist_encode(42)
    bytes_set(badw2, 18, 200)
    eq_i("invalid object-ref-size rejected in-band", plist_is_error(plist_decode(badw2)), 1)

    let badn = plist_encode(42)
    bytes_set(badn, 19, 0x7F)
    eq_i("implausible num-objects rejected in-band", plist_is_error(plist_decode(badn)), 1)

    let badt = plist_encode(42)
    bytes_set(badt, 27, 99)
    eq_i("out-of-range top-object rejected in-band", plist_is_error(plist_decode(badt)), 1)

    let emptybuf = bytes_create(0)
    eq_i("empty buffer rejected in-band (no crash)", plist_is_error(plist_decode(emptybuf)), 1)

    eq_i("plist_is_error false for a real value", plist_is_error(42), 0)
    eq_s("plist_error_message empty for a real value", plist_error_message(42), "")

    // ── 15) sentinel-key collision safety: an ordinary user dict whose
    // sole key equals the module's internal sentinel key name (built
    // directly, NOT via plist_bool()/plist_null()) must still encode as a
    // REAL bplist dict, never get silently misencoded as the special
    // bool/null type — see SENTINEL-KEY COLLISION SAFETY in plist.nova ────
    let dcoll = {}
    dcoll["$plistBool"] = 1
    let ecoll = plist_encode(dcoll)
    eq_i("sentinel-collision (bool key) marker family is dict", bytes_get(ecoll, 8) & 0xF0, 0xD0)
    let dcolld = plist_decode(ecoll)
    eq_s("sentinel-collision (bool key) decode type", type_of(dcolld), "dict")
    eq_i("sentinel-collision (bool key) key count", len(keys(dcolld)), 1)
    eq_i("sentinel-collision (bool key) value preserved", dcolld["$plistBool"], 1)

    let dcoll2 = {}
    dcoll2["$plistNull"] = 1
    let ecoll2 = plist_encode(dcoll2)
    eq_i("sentinel-collision (null key) marker family is dict", bytes_get(ecoll2, 8) & 0xF0, 0xD0)
    let dcoll2d = plist_decode(ecoll2)
    eq_s("sentinel-collision (null key) decode type", type_of(dcoll2d), "dict")
    eq_i("sentinel-collision (null key) key count", len(keys(dcoll2d)), 1)
    eq_i("sentinel-collision (null key) value preserved", dcoll2d["$plistNull"], 1)

    // Harder case: the exact 2-key SHAPE the wrapper uses (both key names
    // present) but the magic value does NOT match — must still fall
    // through to a plain 2-entry dict, proving the fix checks the magic
    // VALUE, not merely the key names / shape.
    let dcoll3 = {}
    dcoll3["$plistBool"] = 1
    dcoll3["$plistBoolMagic"] = 12345
    let ecoll3 = plist_encode(dcoll3)
    eq_i("sentinel-collision (2-key wrong magic) marker family is dict", bytes_get(ecoll3, 8) & 0xF0, 0xD0)
    let dcoll3d = plist_decode(ecoll3)
    eq_s("sentinel-collision (2-key wrong magic) decode type", type_of(dcoll3d), "dict")
    eq_i("sentinel-collision (2-key wrong magic) key count", len(keys(dcoll3d)), 2)
    eq_i("sentinel-collision (2-key wrong magic) bool-key value", dcoll3d["$plistBool"], 1)
    eq_i("sentinel-collision (2-key wrong magic) magic-key value", dcoll3d["$plistBoolMagic"], 12345)

    print("PASS bplistkat")
