import forge_rs as rs
import forge_rsdecode as rd

fn check(cond: bool, label: string)
    if cond == false
        print("FAIL: " + label)

fn lcg(state: int) -> int
    (state * 1103515245 + 12345) % 2147483648

fn eq(a: list, b: list) -> bool
    let out = len(a) == len(b)
    if out
        let i = 0
        while i < len(a)
            if a[i] != b[i]
                out = false
            i = i + 1
    out

fn main()
    // ---- no errors: decode returns the codeword unchanged ----
    let msg0 = [10, 20, 30, 40, 50]
    let cw0 = rs.rs_encode(msg0, 6)
    check(eq(rd.rs_correct(cw0, 6), cw0), "clean codeword decodes to itself")

    // ---- single-error correction ----
    let cw1 = rs.rs_encode([1, 2, 3, 4, 5, 6, 7, 8], 6)
    let cor1 = []
    let a = 0
    while a < len(cw1)
        push(cor1, cw1[a])
        a = a + 1
    cor1[3] = cor1[3] ^ 0x9A
    check(eq(rd.rs_correct(cor1, 6), cw1), "single error corrected")

    // ---- exactly t errors (t = nsym/2) ----
    let cw2 = rs.rs_encode([100, 101, 102, 103, 104, 105], 8)   // t = 4
    let cor2 = []
    let b = 0
    while b < len(cw2)
        push(cor2, cw2[b])
        b = b + 1
    cor2[0] = cor2[0] ^ 0x11
    cor2[5] = cor2[5] ^ 0x22
    cor2[9] = cor2[9] ^ 0x33
    cor2[13] = cor2[13] ^ 0x44
    check(eq(rd.rs_correct(cor2, 8), cw2), "4 errors (=t) corrected")

    // ---- too many errors (t+1) -> failure (empty), never wrong data ----
    let cw3 = rs.rs_encode([7, 7, 7, 7, 7, 7], 6)   // t = 3
    let cor3 = []
    let c = 0
    while c < len(cw3)
        push(cor3, cw3[c])
        c = c + 1
    cor3[0] = cor3[0] ^ 0x01
    cor3[2] = cor3[2] ^ 0x02
    cor3[4] = cor3[4] ^ 0x03
    cor3[6] = cor3[6] ^ 0x04
    let r3 = rd.rs_correct(cor3, 6)
    // either empty (declared uncorrectable) or, if it "corrects", it must be a valid codeword (never garbage)
    check(len(r3) == 0 or eq(r3, cw3), "too many errors -> failure, never wrong data")

    // ---- BIG randomized round-trip: for e = 0..t errors at random positions/values, decode == original ----
    let st = 13131313
    let trial = 0
    while trial < 200
        st = lcg(st)
        let k = 3 + (st % 12)          // message length 3..14
        st = lcg(st)
        let nsym = 4 + 2 * (st % 5)    // nsym 4,6,8,10,12  (even -> t = nsym/2)
        let t = nsym / 2
        // random message
        let msg = []
        let i = 0
        while i < k
            st = lcg(st)
            push(msg, st % 256)
            i = i + 1
        let cw = rs.rs_encode(msg, nsym)
        let nlen = len(cw)
        // choose e in 0..t errors at DISTINCT positions
        st = lcg(st)
        let e = st % (t + 1)
        // corrupt
        let corrupt = []
        let ci = 0
        while ci < nlen
            push(corrupt, cw[ci])
            ci = ci + 1
        // pick e distinct positions via a used-marker
        let used = []
        let ui = 0
        while ui < nlen
            push(used, 0)
            ui = ui + 1
        let placed = 0
        let guard = 0
        while placed < e and guard < 1000
            st = lcg(st)
            let pos = st % nlen
            if used[pos] == 0
                used[pos] = 1
                st = lcg(st)
                let delta = 1 + (st % 255)   // nonzero change
                corrupt[pos] = corrupt[pos] ^ delta
                placed = placed + 1
            guard = guard + 1
        let fixed = rd.rs_correct(corrupt, nsym)
        check(eq(fixed, cw), "round-trip trial " + str(trial) + " e=" + str(e))
        trial = trial + 1

    print("forge_rsdecode: all passed")
