// form_as<T> -- NAME-KEYED typed extraction from a {string:string} dict (form body / DB row) into a
// validated struct. `let r: Result<T> = form_as(d)` -> ok(T) when every present field coerces, else
// err("field '<f>': <reason>"). Zero annotation on the binding logic, SOUND (no silent corruption):
// bad value -> Err with the field name; missing key / empty value -> type-correct default (NULL-safe).
// FLOAT fields must round-trip via str()/arithmetic (the match-Ok keystone), not just to_json.
type Signup
    name: string
    age: int
    score: float
    admin: bool

fn main()
    // all fields present + coercible
    let d = {}
    d["name"] = "ada"
    d["age"] = "30"
    d["score"] = "9.5"
    d["admin"] = "true"
    let r: Result<Signup> = form_as(d)
    match r
        Ok(s) =>
            assert(s.name == "ada", "name")
            assert(s.age == 30, "age coerced to int")
            assert(str(s.score) == "9.5", "float field via str() (got " + str(s.score) + ")")
            assert(s.score * 2.0 > 18.9 and s.score * 2.0 < 19.1, "float field arithmetic")
            assert(s.admin == 1, "bool true coerced")
            print("PASS: form_as Ok (name=" + s.name + " age=" + str(s.age) + " score=" + str(s.score) + ")")
        Err(e) =>
            assert(false, "unexpected err: " + e)

    // non-coercible int -> Err naming the field (NOT a silent 0)
    let bad = {}
    bad["name"] = "x"
    bad["age"] = "abc"
    let rb: Result<Signup> = form_as(bad)
    match rb
        Ok(s2) =>
            assert(false, "should have erred on age=abc")
        Err(e2) =>
            assert(find(e2, "age") >= 0, "err names the offending field (" + e2 + ")")
            print("PASS: bad int -> Err (" + e2 + ")")

    // missing keys -> type-correct defaults (total, no crash)
    let part = {}
    part["name"] = "only"
    let rp: Result<Signup> = form_as(part)
    match rp
        Ok(s3) =>
            assert(s3.name == "only", "present field kept")
            assert(s3.age == 0, "missing int -> 0")
            assert(s3.admin == 0, "missing bool -> false")
            print("PASS: missing -> defaults")
        Err(e3) =>
            assert(false, "partial should default, not err: " + e3)

    // empty value for a non-string field -> default (NULL column / blank form field), NOT Err
    let emp = {}
    emp["name"] = "e"
    emp["age"] = ""
    emp["score"] = ""
    let re: Result<Signup> = form_as(emp)
    match re
        Ok(s4) =>
            assert(s4.age == 0, "empty int -> default 0 (NULL-safe)")
            assert(s4.score > -0.001 and s4.score < 0.001, "empty float -> default 0.0")
            print("PASS: empty non-string -> default (NULL-safe)")
        Err(e4) =>
            assert(false, "empty should default, not err: " + e4)

    print("form_as_test passed")
