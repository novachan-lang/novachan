// _kat_algo_text_5.nova — KAT for 6 new pure-NOVA stdlib modules.
//
// NOTE ON MODULE SUBSTITUTIONS: the original assignment named these six
// slots: interval_merge, reservoir_sampling, longest_common_subseq,
// soundex_refined, continued_fraction, fixed_width. A pre-flight duplicate
// survey (mandatory per this repo's quality-standards.md) found that FOUR
// of those six already exist essentially verbatim:
//   - interval_merge      == std/interval/interval_merge.nova (im_)
//   - reservoir_sampling  == std/sketch/reservoir.nova (rs_, incl. weighted)
//                            + std/random/sample.nova (rs_reservoir/rs_weighted)
//   - longest_common_subseq == std/text/lcs.nova (lcs_) + std/text/diff_lcs.nova
//   - fixed_width         == std/data/fixedwidth.nova (fxw_, SAME prefix)
// Those four slots were replaced with genuinely new, non-duplicate modules
// in the same spirit/domain (see each module's DUPLICATE-SURVEY NOTE
// header for the full reasoning):
//   1. std/algo/skyline.nova (sky_)                    — was interval_merge
//   2. std/algo/systematic_sampling.nova (ssm_)         — was reservoir_sampling
//   3. std/algo/longest_palindromic_subseq.nova (lps_)  — was longest_common_subseq
//   4. std/text/soundex_refined.nova (rsx_)             — kept as assigned (genuine gap)
//   5. std/math/continued_fraction.nova (cfr_)          — kept as assigned, pivoted
//                                                          to float/irrational CF
//                                                          (rational CF already exists)
//   6. std/io/chunked_reader.nova (chk_)                — was fixed_width

import std/algo/skyline
import std/algo/systematic_sampling
import std/algo/longest_palindromic_subseq
import std/text/soundex_refined
import std/math/continued_fraction
import std/io/chunked_reader

let g_fails = 0

fn _kchk(desc: string, cond: bool) -> int
    if cond
        print("ok " + desc)
        return 1
    print("FAIL " + desc)
    return 0

fn _flt_close(a, b, eps) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < eps

fn _int_list_eq(a, b) -> bool
    let n = len(a)
    if n != len(b)
        return false
    let i = 0
    while i < n
        if a[i] != b[i]
            return false
        i = i + 1
    return true

fn main()
    let fails = 0

    // ======================================================================
    // 1. std/algo/skyline.nova (sky_)
    // ======================================================================
    let bldgs = [[2, 9, 10], [3, 7, 15], [5, 12, 12], [15, 20, 10], [19, 24, 8]]
    let sky = sky_compute(bldgs)
    let want_sky = [[2, 10], [3, 15], [7, 12], [12, 0], [15, 10], [20, 8], [24, 0]]
    fails = fails + (1 - _kchk("sky_compute classic LC218 example", sky == want_sky))
    fails = fails + (1 - _kchk("sky_max_height classic example == 15", sky_max_height(bldgs) == 15))
    fails = fails + (1 - _kchk("sky_area classic example == 212", sky_area(sky) == 212))
    fails = fails + (1 - _kchk("sky_at x=4 -> 15", sky_at(sky, 4) == 15))
    fails = fails + (1 - _kchk("sky_at x=10 -> 12", sky_at(sky, 10) == 12))
    fails = fails + (1 - _kchk("sky_at x=13 -> 0 (in the 12-15 gap)", sky_at(sky, 13) == 0))
    fails = fails + (1 - _kchk("sky_at x=25 -> 0 (past end)", sky_at(sky, 25) == 0))
    fails = fails + (1 - _kchk("sky_at x=1 -> 0 (before start)", sky_at(sky, 1) == 0))
    fails = fails + (1 - _kchk("sky_at x=2 -> 10 (inclusive start)", sky_at(sky, 2) == 10))

    let bldg_single = [[1, 5, 3]]
    let sky_single = sky_compute(bldg_single)
    fails = fails + (1 - _kchk("sky_compute single building", sky_single == [[1, 3], [5, 0]]))
    fails = fails + (1 - _kchk("sky_area single building == 12", sky_area(sky_single) == 12))

    let bldg_gap = [[1, 3, 5], [4, 6, 7]]
    let sky_gap = sky_compute(bldg_gap)
    fails = fails + (1 - _kchk("sky_compute non-overlapping with gap", sky_gap == [[1, 5], [3, 0], [4, 7], [6, 0]]))
    fails = fails + (1 - _kchk("sky_area non-overlapping with gap == 24", sky_area(sky_gap) == 24))

    let merged_direct = sky_merge([[0, 5], [10, 0]], [[0, 3], [10, 0]])
    fails = fails + (1 - _kchk("sky_merge two same-span skylines", merged_direct == [[0, 5], [10, 0]]))

    // ======================================================================
    // 2. std/algo/systematic_sampling.nova (ssm_)
    // ======================================================================
    fails = fails + (1 - _kchk("ssm_interval(10,3) == 3", ssm_interval(10, 3) == 3))
    fails = fails + (1 - _kchk("ssm_interval(9,3) == 3", ssm_interval(9, 3) == 3))
    fails = fails + (1 - _kchk("ssm_interval(5,10) == 1 (clamped)", ssm_interval(5, 10) == 1))
    fails = fails + (1 - _kchk("ssm_interval(0,5) == 1", ssm_interval(0, 5) == 1))
    fails = fails + (1 - _kchk("ssm_interval(5,0) == 1", ssm_interval(5, 0) == 1))

    fails = fails + (1 - _kchk("ssm_sample(10,3,0) == [0,3,6]", _int_list_eq(ssm_sample(10, 3, 0), [0, 3, 6])))
    fails = fails + (1 - _kchk("ssm_sample(10,3,1) == [1,4,7]", _int_list_eq(ssm_sample(10, 3, 1), [1, 4, 7])))
    fails = fails + (1 - _kchk("ssm_sample(10,3,5) == [2,5,8]", _int_list_eq(ssm_sample(10, 3, 5), [2, 5, 8])))

    let vals = ["a", "b", "c", "d", "e", "f", "g", "h", "i", "j"]
    let sampled_vals = ssm_sample_values(vals, 3, 0)
    fails = fails + (1 - _kchk("ssm_sample_values -> a,d,g", sampled_vals == ["a", "d", "g"]))

    let groups = ssm_group_by(["x", "y", "x", "z", "y", "x"])
    fails = fails + (1 - _kchk("ssm_group_by x -> [0,2,5]", _int_list_eq(groups["x"], [0, 2, 5])))
    fails = fails + (1 - _kchk("ssm_group_by y -> [1,4]", _int_list_eq(groups["y"], [1, 4])))
    fails = fails + (1 - _kchk("ssm_group_by z -> [3]", _int_list_eq(groups["z"], [3])))

    let strat = ssm_stratified_sample(["x", "y", "x", "z", "y", "x"], 2)
    fails = fails + (1 - _kchk("ssm_stratified_sample == [0,1,2,3,4]", _int_list_eq(strat, [0, 1, 2, 3, 4])))

    // ======================================================================
    // 3. std/algo/longest_palindromic_subseq.nova (lps_)
    // ======================================================================
    fails = fails + (1 - _kchk("lps_length(bbbab) == 4", lps_length("bbbab") == 4))
    fails = fails + (1 - _kchk("lps_length(cbbd) == 2", lps_length("cbbd") == 2))
    fails = fails + (1 - _kchk("lps_length(a) == 1", lps_length("a") == 1))
    fails = fails + (1 - _kchk("lps_length(empty) == 0", lps_length("") == 0))
    fails = fails + (1 - _kchk("lps_length(abcde) == 1", lps_length("abcde") == 1))
    fails = fails + (1 - _kchk("lps_length(racecar) == 7", lps_length("racecar") == 7))
    fails = fails + (1 - _kchk("lps_length(aab) == 2", lps_length("aab") == 2))

    fails = fails + (1 - _kchk("lps_string(bbbab) == bbbb", lps_string("bbbab") == "bbbb"))
    fails = fails + (1 - _kchk("lps_string(cbbd) == bb", lps_string("cbbd") == "bb"))

    fails = fails + (1 - _kchk("lps_is_palindrome(racecar) true", lps_is_palindrome("racecar") == true))
    fails = fails + (1 - _kchk("lps_is_palindrome(hello) false", lps_is_palindrome("hello") == false))
    fails = fails + (1 - _kchk("lps_is_palindrome(empty) true", lps_is_palindrome("") == true))
    fails = fails + (1 - _kchk("lps_is_palindrome(a) true", lps_is_palindrome("a") == true))

    fails = fails + (1 - _kchk("lps_min_insertions(bbbab) == 1", lps_min_insertions_to_palindrome("bbbab") == 1))
    fails = fails + (1 - _kchk("lps_min_insertions(cbbd) == 2", lps_min_insertions_to_palindrome("cbbd") == 2))
    fails = fails + (1 - _kchk("lps_min_insertions(racecar) == 0", lps_min_insertions_to_palindrome("racecar") == 0))
    fails = fails + (1 - _kchk("lps_min_insertions(empty) == 0", lps_min_insertions_to_palindrome("") == 0))

    // ======================================================================
    // 4. std/text/soundex_refined.nova (rsx_)
    // ======================================================================
    fails = fails + (1 - _kchk("rsx_encode(The) == T60", rsx_encode("The") == "T60"))
    fails = fails + (1 - _kchk("rsx_encode(Dog) == D604", rsx_encode("Dog") == "D604"))
    fails = fails + (1 - _kchk("rsx_encode(Quick) == Q503", rsx_encode("Quick") == "Q503"))
    fails = fails + (1 - _kchk("rsx_encode(Brown) == B1908", rsx_encode("Brown") == "B1908"))
    fails = fails + (1 - _kchk("rsx_encode(Fox) == F205", rsx_encode("Fox") == "F205"))
    fails = fails + (1 - _kchk("rsx_encode(Lazy) == L7050", rsx_encode("Lazy") == "L7050"))
    fails = fails + (1 - _kchk("rsx_encode(Testing) == T6036084", rsx_encode("Testing") == "T6036084"))
    fails = fails + (1 - _kchk("rsx_encode(Cat) == C306", rsx_encode("Cat") == "C306"))
    fails = fails + (1 - _kchk("rsx_encode(empty) == empty", rsx_encode("") == ""))

    fails = fails + (1 - _kchk("rsx_code_of(B) == 1", rsx_code_of("B") == 1))
    fails = fails + (1 - _kchk("rsx_code_of(R) == 9", rsx_code_of("R") == 9))
    fails = fails + (1 - _kchk("rsx_code_of(A) == 0", rsx_code_of("A") == 0))
    fails = fails + (1 - _kchk("rsx_code_of(Z) == 5", rsx_code_of("Z") == 5))

    fails = fails + (1 - _kchk("rsx_compare(Robert,Rupert) true", rsx_compare("Robert", "Rupert") == true))
    fails = fails + (1 - _kchk("rsx_compare(Cat,Dog) false", rsx_compare("Cat", "Dog") == false))
    fails = fails + (1 - _kchk("rsx_similarity(Cat,Cats) == 4", rsx_similarity("Cat", "Cats") == 4))

    // ======================================================================
    // 5. std/math/continued_fraction.nova (cfr_)
    // ======================================================================
    fails = fails + (1 - _kchk("cfr_from_float(1.5,30) == [1,2]", _int_list_eq(cfr_from_float(1.5, 30), [1, 2])))
    fails = fails + (1 - _kchk("cfr_from_float(2.0,5) == [2]", _int_list_eq(cfr_from_float(2.0, 5), [2])))

    let ev = cfr_evaluate([1, 2])
    fails = fails + (1 - _kchk("cfr_evaluate([1,2]) approx 1.5", _flt_close(ev, 1.5, 0.0000001)))

    fails = fails + (1 - _kchk("cfr_convergent([1,2],0) == [1,1]", _int_list_eq(cfr_convergent([1, 2], 0), [1, 1])))
    fails = fails + (1 - _kchk("cfr_convergent([1,2],1) == [3,2]", _int_list_eq(cfr_convergent([1, 2], 1), [3, 2])))

    let convs = cfr_convergents([1, 2])
    fails = fails + (1 - _kchk("cfr_convergents([1,2]) == [[1,1],[3,2]]", convs == [[1, 1], [3, 2]]))

    let sq23 = cfr_sqrt_periodic(23)
    fails = fails + (1 - _kchk("cfr_sqrt_periodic(23) == [4,[1,3,1,8]]", sq23[0] == 4 and _int_list_eq(sq23[1], [1, 3, 1, 8])))
    let sq2 = cfr_sqrt_periodic(2)
    fails = fails + (1 - _kchk("cfr_sqrt_periodic(2) == [1,[2]]", sq2[0] == 1 and _int_list_eq(sq2[1], [2])))
    let sq3 = cfr_sqrt_periodic(3)
    fails = fails + (1 - _kchk("cfr_sqrt_periodic(3) == [1,[1,2]]", sq3[0] == 1 and _int_list_eq(sq3[1], [1, 2])))
    let sq16 = cfr_sqrt_periodic(16)
    fails = fails + (1 - _kchk("cfr_sqrt_periodic(16) == [4,[]] (perfect square)", sq16[0] == 4 and len(sq16[1]) == 0))

    fails = fails + (1 - _kchk("cfr_best_approx(pi,7) == [22,7]", _int_list_eq(cfr_best_approx(3.14159265358979, 7), [22, 7])))
    fails = fails + (1 - _kchk("cfr_best_approx(1.5,10) == [3,2]", _int_list_eq(cfr_best_approx(1.5, 10), [3, 2])))
    fails = fails + (1 - _kchk("cfr_best_approx(0.5,10) == [1,2]", _int_list_eq(cfr_best_approx(0.5, 10), [1, 2])))

    let roundtrip = cfr_evaluate(cfr_from_float(3.14159265358979, 10))
    fails = fails + (1 - _kchk("cfr roundtrip pi within 1e-4", _flt_close(roundtrip, 3.14159265358979, 0.0001)))

    // ======================================================================
    // 6. std/io/chunked_reader.nova (chk_)
    // ======================================================================
    let ctext = "0123456789ABCDEFGHIJ"
    let chunks = chk_split(ctext, 6)
    fails = fails + (1 - _kchk("chk_split size6 == 4 chunks", chunks == ["012345", "6789AB", "CDEFGH", "IJ"]))
    fails = fails + (1 - _kchk("chk_count_chunks(20,6) == 4", chk_count_chunks(ctext, 6) == 4))
    fails = fails + (1 - _kchk("chk_count_chunks(20,5) == 4", chk_count_chunks(ctext, 5) == 4))
    fails = fails + (1 - _kchk("chk_count_chunks(20,20) == 1", chk_count_chunks(ctext, 20) == 1))
    fails = fails + (1 - _kchk("chk_count_chunks(empty,5) == 0", chk_count_chunks("", 5) == 0))

    let r = chk_new(ctext, 6)
    fails = fails + (1 - _kchk("chk_has_more initial true", chk_has_more(r) == true))
    fails = fails + (1 - _kchk("chk_next call1 == 012345", chk_next(r) == "012345"))
    fails = fails + (1 - _kchk("chk_next call2 == 6789AB", chk_next(r) == "6789AB"))
    fails = fails + (1 - _kchk("chk_remaining after call2 == 8", chk_remaining(r) == 8))
    fails = fails + (1 - _kchk("chk_next call3 == CDEFGH", chk_next(r) == "CDEFGH"))
    fails = fails + (1 - _kchk("chk_next call4 == IJ", chk_next(r) == "IJ"))
    fails = fails + (1 - _kchk("chk_has_more after exhaustion false", chk_has_more(r) == false))
    fails = fails + (1 - _kchk("chk_next after exhaustion == empty", chk_next(r) == ""))
    chk_reset(r)
    fails = fails + (1 - _kchk("chk_has_more after reset true", chk_has_more(r) == true))
    fails = fails + (1 - _kchk("chk_next after reset == 012345", chk_next(r) == "012345"))

    let text2 = "alpha,beta,,gamma"
    let r2 = chk_new(text2, 100)
    fails = fails + (1 - _kchk("chk_next_delim call1 == alpha", chk_next_delim(r2, ",") == "alpha"))
    fails = fails + (1 - _kchk("chk_next_delim call2 == beta", chk_next_delim(r2, ",") == "beta"))
    fails = fails + (1 - _kchk("chk_next_delim call3 == empty (double delim)", chk_next_delim(r2, ",") == ""))
    fails = fails + (1 - _kchk("chk_next_delim call4 == gamma", chk_next_delim(r2, ",") == "gamma"))
    fails = fails + (1 - _kchk("chk_has_more false after delim exhaustion", chk_has_more(r2) == false))

    let r3 = chk_new("noDelimiterHere", 100)
    fails = fails + (1 - _kchk("chk_next_delim not-found returns whole text", chk_next_delim(r3, ",") == "noDelimiterHere"))
    fails = fails + (1 - _kchk("chk_has_more false after not-found delim read", chk_has_more(r3) == false))

    // ======================================================================
    print("total checks run, failures = " + str(fails))
    if fails == 0
        print("ALL PASS")
    else
        print("SOME FAILED: " + str(fails))
