// _png_test.nova — KAT for std/media/png
//
// PNG chunk-level known-answer test.
//
// KNOWN ANSWER VECTORS:
//   (a) CRC32 standard vector: crc32(str_to_bytes("123456789")) == 0xCBF43926
//   (b) png_signature(): length==8, byte[0]==137
//   (c) png_ihdr(1,1,8,2): length==13, u32@0==1, byte[8]==8, byte[9]==2
//   (d) png_write_chunk("IHDR", png_ihdr(1,1,8,2)):
//       bytes_len == 4+4+13+4 == 25
//       bytes[0..3] == u32BE(13) == 0,0,0,13
//       bytes[4..7] == "IHDR" == 73,72,68,82
//   (e) Full encode->decode round-trip via png_write_chunk + png_read_chunks.
//
// CRC32 of IHDR chunk type+data for 1x1 RGB8 image:
//   type bytes: 73,72,68,82  ("IHDR")
//   data bytes: 0,0,0,1, 0,0,0,1, 8, 2, 0, 0, 0  (width=1,height=1,bd=8,ct=2,0,0,0)
//   CRC32 of those 17 bytes = 0x9A768270 (hand-computed)
//
// Round-trip test:
//   Build a minimal PNG = signature + IHDR chunk + IEND chunk.
//   Then png_read_chunks returns 2 chunks: type=="IHDR" and type=="IEND".
//   Check IHDR data round-trips exactly.

import std/media/png

// ── helpers ──────────────────────────────────────────────────────────────────

fn cki(label, got, want)
    if got != want
        print("FAIL png " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, b, offset, want)
    let got = bytes_get(b, offset)
    if got != want
        print("FAIL png " + label + " byte[" + str(offset) + "]: got=" + str(got) + " want=" + str(want))
        exit(1)

// Read big-endian u32 from bytes b at offset pos.
fn rd_u32be(b, pos)
    let b0 = bytes_get(b, pos)
    let b1 = bytes_get(b, pos + 1)
    let b2 = bytes_get(b, pos + 2)
    let b3 = bytes_get(b, pos + 3)
    (b0 * 16777216) + (b1 * 65536) + (b2 * 256) + b3

fn main()
    // ── KAT 1: CRC32 standard vector ─────────────────────────────────────────
    // crc32("123456789") == 0xCBF43926
    let crc_input = str_to_bytes("123456789")
    let crc_val = crc32(crc_input)
    cki("crc32_standard", crc_val, 0xCBF43926)

    // ── KAT 2: CRC32 of empty bytes ──────────────────────────────────────────
    // crc32("") == 0x00000000 xor 0xFFFFFFFF == 0xFFFFFFFF
    let crc_empty = crc32(bytes(0))
    cki("crc32_empty", crc_empty, 0x00000000)

    // ── KAT 3: png_signature ──────────────────────────────────────────────────
    let sig = png_signature()
    cki("sig_len", bytes_len(sig), 8)
    ckb("sig[0]", sig, 0, 137)
    ckb("sig[1]", sig, 1, 80)
    ckb("sig[2]", sig, 2, 78)
    ckb("sig[3]", sig, 3, 71)
    ckb("sig[4]", sig, 4, 13)
    ckb("sig[5]", sig, 5, 10)
    ckb("sig[6]", sig, 6, 26)
    ckb("sig[7]", sig, 7, 10)

    // ── KAT 4: png_ihdr ───────────────────────────────────────────────────────
    // png_ihdr(1,1,8,2): 13 bytes
    //   [0..3] = u32BE(1) = 0,0,0,1   (width)
    //   [4..7] = u32BE(1) = 0,0,0,1   (height)
    //   [8]    = 8                      (bit depth)
    //   [9]    = 2                      (color type = RGB)
    //   [10]   = 0                      (compression)
    //   [11]   = 0                      (filter)
    //   [12]   = 0                      (interlace)
    let ihdr_data = png_ihdr(1, 1, 8, 2)
    cki("ihdr_len", bytes_len(ihdr_data), 13)
    // width = 1 as u32BE
    cki("ihdr_w", rd_u32be(ihdr_data, 0), 1)
    // height = 1 as u32BE
    cki("ihdr_h", rd_u32be(ihdr_data, 4), 1)
    // bit depth
    ckb("ihdr_bitdepth", ihdr_data, 8, 8)
    // color type
    ckb("ihdr_colortype", ihdr_data, 9, 2)
    // compression, filter, interlace all 0
    ckb("ihdr_compression", ihdr_data, 10, 0)
    ckb("ihdr_filter", ihdr_data, 11, 0)
    ckb("ihdr_interlace", ihdr_data, 12, 0)

    // ── KAT 4b: png_ihdr for 640x480 ─────────────────────────────────────────
    let ihdr2 = png_ihdr(640, 480, 8, 2)
    cki("ihdr2_len", bytes_len(ihdr2), 13)
    cki("ihdr2_w", rd_u32be(ihdr2, 0), 640)
    cki("ihdr2_h", rd_u32be(ihdr2, 4), 480)
    ckb("ihdr2_bitdepth", ihdr2, 8, 8)
    ckb("ihdr2_colortype", ihdr2, 9, 2)

    // ── KAT 5: png_write_chunk — structure check ──────────────────────────────
    // png_write_chunk("IHDR", ihdr_data) should produce 25 bytes:
    //   4 (length field) + 4 (type) + 13 (data) + 4 (crc) = 25
    let ihdr_chunk = png_write_chunk("IHDR", ihdr_data)
    cki("chunk_len", bytes_len(ihdr_chunk), 25)
    // Length field (first 4 bytes) = u32BE(13)
    ckb("chunk_lenfield[0]", ihdr_chunk, 0, 0)
    ckb("chunk_lenfield[1]", ihdr_chunk, 1, 0)
    ckb("chunk_lenfield[2]", ihdr_chunk, 2, 0)
    ckb("chunk_lenfield[3]", ihdr_chunk, 3, 13)
    // Type field (bytes 4..7) = 'I'=73,'H'=72,'D'=68,'R'=82
    ckb("chunk_type[0]", ihdr_chunk, 4, 73)
    ckb("chunk_type[1]", ihdr_chunk, 5, 72)
    ckb("chunk_type[2]", ihdr_chunk, 6, 68)
    ckb("chunk_type[3]", ihdr_chunk, 7, 82)
    // Data bytes 8..20 must match ihdr_data exactly.
    let di = 0
    while di < 13
        let got_byte = bytes_get(ihdr_chunk, 8 + di)
        let want_byte = bytes_get(ihdr_data, di)
        if got_byte != want_byte
            print("FAIL png chunk_data[" + str(di) + "]: got=" + str(got_byte) + " want=" + str(want_byte))
            exit(1)
        di = di + 1

    // ── KAT 6: CRC of the IHDR chunk (bytes 21..24) ──────────────────────────
    // Recompute: crc32(type_bytes ++ ihdr_data)
    let type_and_data = bytes(0)
    type_and_data = bytes_append(type_and_data, 73)
    type_and_data = bytes_append(type_and_data, 72)
    type_and_data = bytes_append(type_and_data, 68)
    type_and_data = bytes_append(type_and_data, 82)
    type_and_data = bytes_concat(type_and_data, ihdr_data)
    let expected_crc = crc32(type_and_data)
    let actual_crc = rd_u32be(ihdr_chunk, 21)
    cki("chunk_crc", actual_crc, expected_crc)

    // ── KAT 7: IEND chunk ────────────────────────────────────────────────────
    // IEND has empty data, so:
    //   length = 0  -> 4 bytes u32BE(0) = 0,0,0,0
    //   type   = "IEND"  = 73,69,78,68
    //   data   = (empty)
    //   crc    = crc32("IEND" as bytes) = 0xAE426082
    let iend_empty = bytes(0)
    let iend_chunk = png_write_chunk("IEND", iend_empty)
    cki("iend_len", bytes_len(iend_chunk), 12)
    ckb("iend_lenfield[3]", iend_chunk, 3, 0)
    // type 'I'=73,'E'=69,'N'=78,'D'=68
    ckb("iend_type[0]", iend_chunk, 4, 73)
    ckb("iend_type[1]", iend_chunk, 5, 69)
    ckb("iend_type[2]", iend_chunk, 6, 78)
    ckb("iend_type[3]", iend_chunk, 7, 68)
    // CRC of "IEND" with no data = crc32(str_to_bytes("IEND")) = 0xAE426082
    let iend_crc_expected = crc32(str_to_bytes("IEND"))
    let iend_crc_actual = rd_u32be(iend_chunk, 8)
    cki("iend_crc", iend_crc_actual, iend_crc_expected)

    // ── KAT 8: png_read_chunks round-trip ────────────────────────────────────
    // Build a minimal valid PNG: signature + IHDR chunk + IEND chunk.
    let png_bytes = png_signature()
    png_bytes = bytes_concat(png_bytes, ihdr_chunk)
    png_bytes = bytes_concat(png_bytes, iend_chunk)
    // Total = 8 + 25 + 12 = 45 bytes.
    cki("png_total_len", bytes_len(png_bytes), 45)
    // Parse it back.
    let chunks = png_read_chunks(png_bytes)
    cki("chunk_count", len(chunks), 2)
    // First chunk: type=="IHDR"
    let c0 = chunks[0]
    cki("chunk0_type", c0["type"], "IHDR")
    // IHDR data must round-trip: 13 bytes matching ihdr_data.
    let c0data = c0["data"]
    cki("chunk0_data_len", bytes_len(c0data), 13)
    let ci = 0
    while ci < 13
        let got_rt = bytes_get(c0data, ci)
        let want_rt = bytes_get(ihdr_data, ci)
        if got_rt != want_rt
            print("FAIL png rt_data[" + str(ci) + "]: got=" + str(got_rt) + " want=" + str(want_rt))
            exit(1)
        ci = ci + 1
    // Width and height from round-tripped IHDR data.
    cki("rt_ihdr_w", rd_u32be(c0data, 0), 1)
    cki("rt_ihdr_h", rd_u32be(c0data, 4), 1)
    cki("rt_ihdr_bitdepth", bytes_get(c0data, 8), 8)
    cki("rt_ihdr_colortype", bytes_get(c0data, 9), 2)
    // Second chunk: type=="IEND"
    let c1 = chunks[1]
    cki("chunk1_type", c1["type"], "IEND")
    cki("chunk1_data_len", bytes_len(c1["data"]), 0)

    // ── KAT 9: bad signature -> empty list ───────────────────────────────────
    let bad_sig = bytes(8)
    bytes_set(bad_sig, 0, 0)
    let bad_chunks = png_read_chunks(bad_sig)
    cki("bad_sig_count", len(bad_chunks), 0)

    // ── KAT 10: empty input -> empty list ────────────────────────────────────
    let empty_chunks = png_read_chunks(bytes(0))
    cki("empty_count", len(empty_chunks), 0)

    // ── KAT 11: larger IHDR (e.g. 256x256 grey+alpha, 8bpp) ─────────────────
    let ihdr3 = png_ihdr(256, 256, 8, 4)
    cki("ihdr3_len", bytes_len(ihdr3), 13)
    cki("ihdr3_w", rd_u32be(ihdr3, 0), 256)
    cki("ihdr3_h", rd_u32be(ihdr3, 4), 256)
    ckb("ihdr3_colortype", ihdr3, 9, 4)
    // Write a chunk for it and parse back.
    let ihdr3_chunk = png_write_chunk("IHDR", ihdr3)
    let png2 = png_signature()
    png2 = bytes_concat(png2, ihdr3_chunk)
    let iend2 = png_write_chunk("IEND", bytes(0))
    png2 = bytes_concat(png2, iend2)
    let chunks2 = png_read_chunks(png2)
    cki("png2_chunk_count", len(chunks2), 2)
    let c2_0 = chunks2[0]
    let c2_data = c2_0["data"]
    cki("png2_w", rd_u32be(c2_data, 0), 256)
    cki("png2_h", rd_u32be(c2_data, 4), 256)
    ckb("png2_colortype", c2_data, 9, 4)

    print("PASS _png_test")
