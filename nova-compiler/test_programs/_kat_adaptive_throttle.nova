import forge_adaptive_throttle

fn main()
    let at = at_new(10, 2, 50)
    assert(at_current_rate(at) == 10, "starts at 10")

    let i = 0
    while i < 10
        let ok = at_request(at)
        assert(ok == 1, "allowed within rate")
        i = i + 1
    let rejected = at_request(at)
    assert(rejected == 0, "rejected over rate")
    assert(at_total_allowed(at) == 10, "10 allowed")
    assert(at_total_rejected(at) == 1, "1 rejected")

    at = at_adjust(at)
    assert(at_current_rate(at) == 12, "rate increased (low errors)")

    at = at_record_error(at)
    at = at_record_error(at)
    at = at_record_error(at)
    at = at_record_error(at)
    at = at_record_error(at)
    at = at_record_error(at)
    assert(at_error_rate(at) == 60, "60% error rate")

    at = at_adjust(at)
    assert(at_current_rate(at) == 6, "rate halved (high errors)")

    at = at_reset_window(at)
    let ok2 = at_request(at)
    assert(ok2 == 1, "allowed after reset")

    print("ADAPTIVE-THROTTLE KAT PASS")
