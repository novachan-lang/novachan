import forge_permission_cache

fn main()
    let p = pc_new(60)
    p = pc_set(p, "alice", "write", 1, 100)
    p = pc_set(p, "bob", "read", 1, 100)

    let r1 = pc_check(p, "alice", "write", 120)
    assert(is_ok(r1), "cache hit")
    assert(unwrap(r1) == 1, "allowed")

    let r2 = pc_check(p, "alice", "write", 200)
    assert(is_err(r2), "cache expired")

    let r3 = pc_check(p, "carol", "read", 100)
    assert(is_err(r3), "cache miss")

    p = pc_invalidate(p, "bob", "read")
    let r4 = pc_check(p, "bob", "read", 105)
    assert(is_err(r4), "invalidated entry expired")

    assert(pc_hit_rate(p) == 25, "25% hit rate")
    assert(pc_total_lookups(p) == 4, "4 lookups")

    print("PERMISSION-CACHE KAT PASS")
