// Cooperative yield: a green task calls reschedule() in a loop to give other
// runnable green tasks a turn, then resumes where it left off. Proves the
// re-enqueue/yield/resume cycle is correct (task completes with the right value
// after many voluntary yields) — the v1 cooperation primitive for CPU-bound tasks.

fn counter(out, iters)
    let i = 0
    let acc = 0
    while i < iters
        acc = acc + 1
        reschedule()        // voluntarily yield the carrier, then resume
        i = i + 1
    send(out, acc)

let out = channel()
spawn fn()
    counter(out, 200)
spawn fn()
    counter(out, 200)
spawn fn()
    counter(out, 200)

let a = receive(out)
let b = receive(out)
let c = receive(out)
assert(a == 200, "task A completed after 200 yields")
assert(b == 200, "task B completed after 200 yields")
assert(c == 200, "task C completed after 200 yields")
assert(a + b + c == 600, "all three cooperative tasks finished")
print("reschedule cooperative yield: 3 tasks x 200 yields all completed")

// reschedule() from the (green) main task: yields + resumes, harmless
reschedule()
print("reschedule from main: OK")

print("ALL PASS: cooperative reschedule()")
