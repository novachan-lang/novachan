// KAT probe for std/data/xmlbuild — programmatic XML string builder.
//
// All expected values are hand-computed against the spec.
import std/data/xmlbuild

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn main()
    let dq = chr(34)
    let lt = chr(60)
    let gt = chr(62)

    // ── KAT 1: self-closing element with no attrs ─────────────────────────────
    // xb_element("br", {}, "") == "<br/>"
    let br = xb_element("br", {}, "")
    cks("kat1-br", br, lt + "br/" + gt)
    print("KAT 1 PASS: <br/> self-closing")

    // ── KAT 2: element with text content ─────────────────────────────────────
    // xb_element("p", {}, "hi") == "<p>hi</p>"
    let p = xb_element("p", {}, "hi")
    cks("kat2-p", p, lt + "p" + gt + "hi" + lt + "/p" + gt)
    print("KAT 2 PASS: <p>hi</p>")

    // ── KAT 3: xb_text_escape handles & < > ──────────────────────────────────
    // xb_text_escape("a<b>&c") == "a&lt;b&gt;&amp;c"
    let esc1 = xb_text_escape("a<b>&c")
    cks("kat3-escape-ltgtamp", esc1, "a&lt;b&gt;&amp;c")
    print("KAT 3 PASS: escape < > &")

    // ── KAT 4: xb_text_escape handles double-quote ───────────────────────────
    // xb_text_escape(chr(34)) == "&quot;"
    let esc2 = xb_text_escape(chr(34))
    cks("kat4-escape-quot", esc2, "&quot;")
    print("KAT 4 PASS: escape double-quote -> &quot;")

    // ── KAT 5: element with one attribute ────────────────────────────────────
    // xb_element("a", {"href":"x"}, "link") must contain href="x"
    let a_attrs = {}
    a_attrs["href"] = "x"
    let a = xb_element("a", a_attrs, "link")
    // Must contain: href="x"
    let href_kv = "href=" + dq + "x" + dq
    let found5 = contains(a, href_kv)
    if found5 == 0
        print("FAIL kat5-href: '" + a + "' does not contain '" + href_kv + "'")
        exit(1)
    // Must also have the inner text and correct structure
    let want_a = lt + "a href=" + dq + "x" + dq + gt + "link" + lt + "/a" + gt
    cks("kat5-a-full", a, want_a)
    print("KAT 5 PASS: <a href=\"x\">link</a>")

    // ── KAT 6: two attributes are sorted lexicographically ───────────────────
    // attrs {"z":"1","a":"2"} -> attrs appear as: a="2" z="1" (sorted)
    let two_attrs = {}
    two_attrs["z"] = "1"
    two_attrs["a"] = "2"
    let span = xb_element("span", two_attrs, "t")
    // a must appear before z in the output — use find() for string position
    let pos_a = find(span, " a=")
    let pos_z = find(span, " z=")
    if pos_a < 0
        print("FAIL kat6-sort: attr 'a' missing in: " + span)
        exit(1)
    if pos_z < 0
        print("FAIL kat6-sort: attr 'z' missing in: " + span)
        exit(1)
    if pos_a >= pos_z
        print("FAIL kat6-sort: 'a' not before 'z' in: " + span)
        exit(1)
    print("KAT 6 PASS: two attrs sorted (a before z)")

    // ── KAT 7: xb_text_escape handles single-quote ───────────────────────────
    // xb_text_escape("'") == "&apos;"
    let esc3 = xb_text_escape("'")
    cks("kat7-escape-apos", esc3, "&apos;")
    print("KAT 7 PASS: escape single-quote -> &apos;")

    // ── KAT 8: nested elements compose correctly ──────────────────────────────
    // xb_element("ul", {}, xb_element("li", {}, "item")) == "<ul><li>item</li></ul>"
    let li = xb_element("li", {}, "item")
    let ul = xb_element("ul", {}, li)
    let want_ul = lt + "ul" + gt + lt + "li" + gt + "item" + lt + "/li" + gt + lt + "/ul" + gt
    cks("kat8-nested", ul, want_ul)
    print("KAT 8 PASS: nested elements compose")

    print("_xmlbuild_test passed")
