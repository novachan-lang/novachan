// Test mutual recursion type inference
// is_even calls is_odd, is_odd calls is_even

fn is_even(n: int) -> bool
    if n == 0
        return true
    return is_odd(n - 1)

fn is_odd(n: int) -> bool
    if n == 0
        return false
    return is_even(n - 1)

fn main()
    assert(is_even(0) == true, "0 is even")
    assert(is_even(1) == false, "1 is not even")
    assert(is_even(4) == true, "4 is even")
    assert(is_odd(3) == true, "3 is odd")
    assert(is_odd(6) == false, "6 is not odd")
    print("mutual_recur: all passed")
