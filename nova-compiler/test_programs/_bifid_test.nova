// KAT test for std/cipher/bifid
// Tests: known vector, round-trip (full period), round-trip (period=5), edge cases.
import std/cipher/bifid

fn main() -> int
    // Reference key from Wikipedia Bifid cipher article
    let wikikey = "BGWKZQPNDSIOAXEFCLUMTHYVR"

    // ── KAT 1: KNOWN VECTOR (Wikipedia reference) ──────────────────────────────
    // bifid_encrypt("FLEEATONCE", wikikey) == "UAEOLWRINS"
    // Square: B G W K Z / Q P N D S / I O A X E / F C L U M / T H Y V R
    let kv1 = bifid_encrypt("FLEEATONCE", wikikey)
    if kv1 != "UAEOLWRINS"
        print("FAIL KAT1 known_vector_enc: got " + kv1 + " want UAEOLWRINS")
        exit(1)

    // ── KAT 2: KNOWN VECTOR DECRYPT ────────────────────────────────────────────
    let kv2 = bifid_decrypt("UAEOLWRINS", wikikey)
    if kv2 != "FLEEATONCE"
        print("FAIL KAT2 known_vector_dec: got " + kv2 + " want FLEEATONCE")
        exit(1)

    // ── KAT 3: ROUND-TRIP full period, empty key (standard ABCDEFGHIKL... square)
    let pt3 = "HELLOWORLD"
    let enc3 = bifid_encrypt(pt3, "")
    let dec3 = bifid_decrypt(enc3, "")
    if dec3 != pt3
        print("FAIL KAT3 roundtrip_empty_key: enc=" + enc3 + " dec=" + dec3 + " want " + pt3)
        exit(1)

    // ── KAT 4: ROUND-TRIP full period, non-empty key ───────────────────────────
    let pt4 = "ATTACKATDAWN"
    let enc4 = bifid_encrypt(pt4, "KEYWORD")
    let dec4 = bifid_decrypt(enc4, "KEYWORD")
    if dec4 != pt4
        print("FAIL KAT4 roundtrip_keyword: enc=" + enc4 + " dec=" + dec4 + " want " + pt4)
        exit(1)

    // ── KAT 5: ROUND-TRIP period=5 with wikikey ────────────────────────────────
    let pt5 = "FLEEATONCE"
    let enc5 = bifid_encrypt_period(pt5, wikikey, 5)
    let dec5 = bifid_decrypt_period(enc5, wikikey, 5)
    if dec5 != pt5
        print("FAIL KAT5 roundtrip_period5: enc=" + enc5 + " dec=" + dec5 + " want " + pt5)
        exit(1)

    // ── KAT 6: J normalised to I — "JOTA" and "IOTA" encrypt identically ───────
    let encI = bifid_encrypt("IOTA", "KEYWORD")
    let encJJ = bifid_encrypt("JOTA", "KEYWORD")
    if encI != encJJ
        print("FAIL KAT6 J_maps_to_I: encI=" + encI + " encJJ=" + encJJ)
        exit(1)

    // ── KAT 7: lowercase input normalised to same result as uppercase ───────────
    let enc7a = bifid_encrypt("hello", "")
    let enc7b = bifid_encrypt("HELLO", "")
    if enc7a != enc7b
        print("FAIL KAT7 lowercase_norm: enc7a=" + enc7a + " enc7b=" + enc7b)
        exit(1)

    // ── KAT 8: non-letters dropped — "HELLO WORLD!" same as "HELLOWORLD" ───────
    let enc8a = bifid_encrypt("HELLO WORLD!", "")
    let enc8b = bifid_encrypt("HELLOWORLD", "")
    if enc8a != enc8b
        print("FAIL KAT8 nonletter_drop: enc8a=" + enc8a + " enc8b=" + enc8b)
        exit(1)

    // ── KAT 9: empty input ─────────────────────────────────────────────────────
    let enc9 = bifid_encrypt("", "KEYWORD")
    if enc9 != ""
        print("FAIL KAT9 empty_enc: got " + enc9)
        exit(1)
    let dec9 = bifid_decrypt("", "KEYWORD")
    if dec9 != ""
        print("FAIL KAT9 empty_dec: got " + dec9)
        exit(1)

    // ── KAT 10: single letter round-trip ───────────────────────────────────────
    // With period=1 (single letter chunk): combined=[r,c] pairs=1 -> sq[r*5+c]=same letter
    // So encrypt(single_letter) == that letter (identity for period=1 chunks)
    let enc10 = bifid_encrypt("A", "")
    let dec10 = bifid_decrypt(enc10, "")
    if dec10 != "A"
        print("FAIL KAT10 single_letter: enc=" + enc10 + " dec=" + dec10)
        exit(1)

    // ── KAT 11: ROUND-TRIP period=5 with KEYWORD key ───────────────────────────
    let pt11 = "HELLOWORLD"
    let enc11 = bifid_encrypt_period(pt11, "KEYWORD", 5)
    let dec11 = bifid_decrypt_period(enc11, "KEYWORD", 5)
    if dec11 != pt11
        print("FAIL KAT11 period5_key: enc=" + enc11 + " dec=" + dec11 + " want " + pt11)
        exit(1)

    // ── KAT 12: period=1 is identity after normalisation ───────────────────────
    // Each chunk is 1 letter: combined=[r,c] -> pair=(r,c) -> sq[r*5+c] = same letter
    let pt12 = "ABCDE"
    let enc12 = bifid_encrypt_period(pt12, "", 1)
    if enc12 != pt12
        print("FAIL KAT12 period1_identity: enc=" + enc12 + " want " + pt12)
        exit(1)

    // ── KAT 13: LONG message round-trip ────────────────────────────────────────
    let pt13 = "THEQUICKBROWNFOXIUMPSOVERTHELAZYDOG"
    let enc13 = bifid_encrypt(pt13, "SECRETKEY")
    let dec13 = bifid_decrypt(enc13, "SECRETKEY")
    if dec13 != pt13
        print("FAIL KAT13 long_msg: dec=" + dec13 + " want " + pt13)
        exit(1)

    // ── KAT 14: period=3 round-trip ────────────────────────────────────────────
    let pt14 = "DEFENDTHECASTLE"
    let enc14 = bifid_encrypt_period(pt14, "PALACE", 3)
    let dec14 = bifid_decrypt_period(enc14, "PALACE", 3)
    if dec14 != pt14
        print("FAIL KAT14 period3: enc=" + enc14 + " dec=" + dec14 + " want " + pt14)
        exit(1)

    print("PASS _bifid_test")
    0
