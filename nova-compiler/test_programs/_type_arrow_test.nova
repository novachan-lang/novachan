import std/typesystem/type_arrow

// --- check helpers ---

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn ckb(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + got + " expected " + expected)
        exit(1)

// ckt: check two types are structurally equal
fn ckt(label, a, b)
    let eq = type_arrow.tarr_type_eq(a, b)
    if eq == 0
        print("FAIL " + label + ": types not equal")
        exit(1)

// ckfail: check that result is "FAIL"
fn ckfail(label, got)
    if type_of(got) != "string"
        print("FAIL " + label + ": expected FAIL string, got a type")
        exit(1)
    if got != "FAIL"
        print("FAIL " + label + ": expected FAIL, got " + got)
        exit(1)

fn main()
    // Build a->b->c = int -> bool -> int
    let int_ty = type_arrow.tyc_int()
    let bool_ty = type_arrow.tyc_bool()
    let abc = type_arrow.tyc_arr(int_ty, type_arrow.tyc_arr(bool_ty, int_ty))

    // --- KAT 1: tarr_arity(int->bool->int) == 2 ---
    cki("arity_2", type_arrow.tarr_arity(abc), 2)

    // --- KAT 2: tarr_arity(int->bool) == 1 ---
    let ab = type_arrow.tyc_arr(int_ty, bool_ty)
    cki("arity_1", type_arrow.tarr_arity(ab), 1)

    // --- KAT 3: tarr_arity(int) == 0 ---
    cki("arity_0", type_arrow.tarr_arity(int_ty), 0)

    // --- KAT 4: tarr_arg_types(int->bool->int) == [int, bool] ---
    let args4 = type_arrow.tarr_arg_types(abc)
    cki("arg_types_len", len(args4), 2)
    ckt("arg_types_0_int", args4[0], int_ty)
    ckt("arg_types_1_bool", args4[1], bool_ty)

    // --- KAT 5: tarr_arg_types(int) == [] ---
    let args5 = type_arrow.tarr_arg_types(int_ty)
    cki("arg_types_base_empty", len(args5), 0)

    // --- KAT 6: tarr_result_type(int->bool->int) == int ---
    let res6 = type_arrow.tarr_result_type(abc)
    ckt("result_type_abc", res6, int_ty)

    // --- KAT 7: tarr_result_type(int) == int ---
    let res7 = type_arrow.tarr_result_type(int_ty)
    ckt("result_type_base", res7, int_ty)

    // --- KAT 8: tarr_build([int, bool], int) == int->bool->int ---
    let buildargs = []
    push(buildargs, int_ty)
    push(buildargs, bool_ty)
    let built = type_arrow.tarr_build(buildargs, int_ty)
    ckt("tarr_build_abc", built, abc)

    // --- KAT 9: tarr_build([], int) == int ---
    let emptyargs = []
    let built9 = type_arrow.tarr_build(emptyargs, int_ty)
    ckt("tarr_build_empty", built9, int_ty)

    // --- KAT 10: tarr_uncurry(int->bool->int) == pair(int,bool)->int ---
    let uncurried = type_arrow.tarr_uncurry(abc)
    let expected_uc = type_arrow.tyc_arr(type_arrow.tyc_pair(int_ty, bool_ty), int_ty)
    ckt("tarr_uncurry", uncurried, expected_uc)

    // --- KAT 11: tarr_curry(pair(int,bool)->int) == int->bool->int ---
    let curried = type_arrow.tarr_curry(expected_uc)
    ckt("tarr_curry", curried, abc)

    // --- KAT 12: tarr_uncurry of non-nested-arrow -> FAIL ---
    let bad_uc = type_arrow.tarr_uncurry(ab)
    ckfail("tarr_uncurry_single_FAIL", bad_uc)

    // --- KAT 13: tarr_curry of non-pair-domain -> FAIL ---
    let bad_curry = type_arrow.tarr_curry(ab)
    ckfail("tarr_curry_nonpair_FAIL", bad_curry)

    // --- KAT 14: tarr_build([int], bool) == int->bool ---
    let args14 = []
    push(args14, int_ty)
    let built14 = type_arrow.tarr_build(args14, bool_ty)
    ckt("tarr_build_single", built14, ab)

    print("PASS _type_arrow_test")

main()
