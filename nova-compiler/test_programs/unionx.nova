// unionx.nova — union-find (disjoint-set) with path compression + union by rank.
//
// The classic near-O(1)-amortized structure for DYNAMIC CONNECTIVITY: group
// elements into disjoint sets, merge sets (union), and ask "are a and b in the
// same set?" (connected). Powers Kruskal's MST, connected-components, clustering,
// cycle detection, and percolation. Elements are integers 0..n-1.

fn uf_new(n)
  let parent = []
  let rank = []
  let i = 0
  while i < n
    push(parent, i)        // each element is its own root
    push(rank, 0)
    i = i + 1
  let uf = {}
  uf["parent"] = parent
  uf["rank"] = rank
  uf

fn uf_find(uf, x)
  let parent = uf["parent"]
  let root = x
  while parent[root] != root
    root = parent[root]
  // path compression: point everyone on the path straight at the root
  let cur = x
  while parent[cur] != root
    let nxt = parent[cur]
    parent[cur] = root
    cur = nxt
  root

// merge the sets of a and b; returns 1 if they were separate, 0 if already joined.
fn uf_union(uf, a, b)
  let ra = uf_find(uf, a)
  let rb = uf_find(uf, b)
  if ra == rb
    return 0
  let rank = uf["rank"]
  let parent = uf["parent"]
  if rank[ra] < rank[rb]
    parent[ra] = rb
  else if rank[ra] > rank[rb]
    parent[rb] = ra
  else
    parent[rb] = ra
    rank[ra] = rank[ra] + 1
  1

fn uf_connected(uf, a, b)
  if uf_find(uf, a) == uf_find(uf, b)
    return 1
  0

// number of distinct components.
fn uf_count(uf)
  let parent = uf["parent"]
  let c = 0
  let i = 0
  while i < len(parent)
    if uf_find(uf, i) == i
      c = c + 1
    i = i + 1
  c

// ── Tests ────────────────────────────────────────────────────────────

let uf = uf_new(6)
assert(uf_count(uf) == 6, "6 singletons")
assert(uf_connected(uf, 0, 1) == 0, "initially disconnected")
print("PASS: fresh sets")

assert(uf_union(uf, 0, 1) == 1, "0-1 newly joined")
assert(uf_union(uf, 2, 3) == 1, "2-3 newly joined")
assert(uf_connected(uf, 0, 1) == 1, "0 and 1 connected")
assert(uf_connected(uf, 0, 2) == 0, "0 and 2 still separate")
assert(uf_count(uf) == 4, "components: {01}{23}{4}{5} = 4")
print("PASS: union + connected")

// chain the {01} and {23} sets together
assert(uf_union(uf, 1, 2) == 1, "1-2 merges the two pairs")
assert(uf_connected(uf, 0, 3) == 1, "transitive: 0 connected to 3")
assert(uf_count(uf) == 3, "now {0123}{4}{5} = 3")
print("PASS: transitive merge")

// re-uniting already-connected nodes is a no-op
assert(uf_union(uf, 0, 3) == 0, "0-3 already connected")
assert(uf_count(uf) == 3, "count unchanged")
print("PASS: idempotent union")

// connect everything
uf_union(uf, 3, 4)
uf_union(uf, 4, 5)
assert(uf_count(uf) == 1, "all 6 in one component")
assert(uf_connected(uf, 0, 5) == 1, "0 connected to 5")
print("PASS: full connectivity")

print("ALL PASS: unionx — union-find / disjoint set")
