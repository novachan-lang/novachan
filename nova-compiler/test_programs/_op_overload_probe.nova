type Vec2
    x: float
    y: float

fn Vec2.add(self, other: Vec2) -> Vec2
    Vec2 { x: self.x + other.x, y: self.y + other.y }

fn Vec2.sub(self, other: Vec2) -> Vec2
    Vec2 { x: self.x - other.x, y: self.y - other.y }

fn Vec2.mul(self, other: Vec2) -> Vec2
    Vec2 { x: self.x * other.x, y: self.y * other.y }

fn Vec2.eq(self, other: Vec2) -> bool
    self.x == other.x and self.y == other.y

fn Vec2.neg(self) -> Vec2
    Vec2 { x: 0.0 - self.x, y: 0.0 - self.y }

fn Vec2.length_sq(self) -> float
    self.x * self.x + self.y * self.y

fn Vec2.length(self) -> float
    (self.x * self.x + self.y * self.y) ** 0.5

fn Vec2.scale(self, factor: float) -> Vec2
    Vec2 { x: self.x * factor, y: self.y * factor }

fn Vec2.show(self) -> str
    "Vec2(" + str(self.x) + ", " + str(self.y) + ")"

fn Vec2.dot(self, other: Vec2) -> float
    self.x * other.x + self.y * other.y

fn main()
    let a = Vec2 { x: 1.0, y: 2.0 }
    let b = Vec2 { x: 3.0, y: 4.0 }

    let c = a + b
    assert(c.x == 4.0, "add x")
    assert(c.y == 6.0, "add y")

    let d = b - a
    assert(d.x == 2.0, "sub x")
    assert(d.y == 2.0, "sub y")

    let e = a * b
    assert(e.x == 3.0, "mul x")
    assert(e.y == 8.0, "mul y")

    assert(a == Vec2 { x: 1.0, y: 2.0 }, "eq true")
    assert(a != b, "neq")

    let n = -a
    assert(n.x == -1.0, "neg x")
    assert(n.y == -2.0, "neg y")

    let chain = a + b + Vec2 { x: 10.0, y: 20.0 }
    assert(chain.x == 14.0, "chain x")
    assert(chain.y == 26.0, "chain y")

    let s = a.scale(3.0)
    assert(s.x == 3.0, "scale x")
    assert(s.y == 6.0, "scale y")

    let msg = str(a)
    assert(msg == "Vec2(1.0, 2.0)", "show via str()")

    let dp = a.dot(b)
    assert(dp == 11.0, "dot product")

    let lsq = a.length_sq()
    assert(lsq == 5.0, "length squared")

    let len_a = a.length()
    assert_near(len_a, 2.236, 0.001)

    let p345 = Vec2 { x: 3.0, y: 4.0 }
    assert(p345.length() == 5.0, "3-4-5 triangle")

    print("op_overload_probe: all passed")
