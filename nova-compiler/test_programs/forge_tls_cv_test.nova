// Forge TLS 1.3 CertificateVerify: from the RFC 8448 §3 server flight, extract the leaf certificate,
// parse its RSA modulus, rebuild the signed content from the transcript-through-Certificate, and verify
// the real server rsa_pss_rsae_sha256 signature. This is end-to-end TLS 1.3 server authentication.
import forge_tls
import forge_crypto
import forge_x509

fn main()
    let ch = hex_to_blist("")
    let sh = hex_to_blist("020000560303a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e2692800130100002e00330024001d0020c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f002b00020304")
    let key = hex_to_blist("3fce516009c21727d0f2e4e86ee403bc")
    let iv = hex_to_blist("5d313eb2671276ee13000b30")
    let rec = hex_to_blist("")

    let content = tls13_record_open(key, iv, 0, rec)[1]
    let m1 = tls13_hs_header(content, 0)
    let m2 = tls13_hs_header(content, m1[3])
    let m3 = tls13_hs_header(content, m2[3])

    // Certificate message body -> leaf cert DER -> RSA modulus
    let cert_body = []
    let a = m2[2]
    while a < m2[3]
        push(cert_body, content[a])
        a = a + 1
    let leaf = tls13_cert_leaf_der(cert_body)
    let spki = x509_parse_cert(leaf)
    let n = tls13_rsa_pubkey_n(spki[2])
    if hex_of(n) != "b4bb498f8279303d980836399b36c6988c0c68de55e1bdb826d3901a2461eafd2de49a91d015abbc9a95137ace6c1af19eaa6af98c7ced43120998e187a80ee0ccb0524b1b018c3e0b63264d449a6d38e22a5fda430846748030530ef0461c8ca9d9efbfae8ea6d1d03e2bd193eff0ab9a8002c47428a6d35a8d88d79f7f1e3f"
        print("FAIL: leaf RSA modulus -> " + hex_of(n))
        exit(1)

    // transcript through Certificate = SHA-256(CH || SH || EncryptedExtensions || Certificate)
    let tctx = []
    let p = 0
    while p < len(ch)
        push(tctx, ch[p])
        p = p + 1
    let q = 0
    while q < len(sh)
        push(tctx, sh[q])
        q = q + 1
    let r = 0
    while r < m2[3]
        push(tctx, content[r])
        r = r + 1
    let th = sha256_bytes(tctx)
    if hex_of(th) != "764d6632b3c35c3f3205e3499ac3edbaabb88295fba751461d3678e2e5ea0687"
        print("FAIL: transcript through certificate -> " + hex_of(th))
        exit(1)

    let cvcontent = tls13_certverify_content("TLS 1.3, server CertificateVerify", th)

    // CertificateVerify message body -> [scheme, sig]
    let cv_body = []
    let b = m3[2]
    while b < m3[3]
        push(cv_body, content[b])
        b = b + 1
    let cvp = tls13_certverify_parse(cv_body)
    if cvp[0] != 2052
        print("FAIL: CV scheme not rsa_pss_rsae_sha256")
        exit(1)
    if tls13_verify_cert_signature(cvp[0], spki[2], cvcontent, cvp[1]) != 1
        print("FAIL: server CertificateVerify did not verify")
        exit(1)

    // tamper the signature -> must fail
    let bad = []
    let c = 0
    while c < len(cvp[1])
        push(bad, cvp[1][c])
        c = c + 1
    bad[5] = bad[5] ^ 1
    if tls13_verify_cert_signature(cvp[0], spki[2], cvcontent, bad) != 0
        print("FAIL: tampered CertificateVerify not rejected")
        exit(1)

    print("PASS forge_tls_cv (RFC 8448 server CertificateVerify: leaf parse + transcript + RSA-PSS verify + tamper)")
