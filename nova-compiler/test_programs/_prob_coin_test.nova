// _prob_coin_test.nova — KAT for std/probability/prob_coin
import std/probability/prob_coin

// ckr — assert fraction [num, den] equals (wn, wd)
fn ckr(label: string, got: list, wn: int, wd: int)
    if got[0] != wn or got[1] != wd
        print("FAIL " + label + ": got=[" + str(got[0]) + "," + str(got[1]) + "] want=[" + str(wn) + "," + str(wd) + "]")
        exit(1)

// cki — assert int equality
fn cki(label: string, got: int, expected: int)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(expected))
        exit(1)

// --- pc_ways_exactly ---
cki("ways_5_2", pc_ways_exactly(5, 2), 10)
cki("ways_5_0", pc_ways_exactly(5, 0), 1)
cki("ways_5_5", pc_ways_exactly(5, 5), 1)
cki("ways_4_2", pc_ways_exactly(4, 2), 6)
cki("ways_3_1", pc_ways_exactly(3, 1), 3)
// edge: k > n
cki("ways_3_4", pc_ways_exactly(3, 4), 0)
// edge: k < 0
cki("ways_neg", pc_ways_exactly(5, -1), 0)

// --- pc_total ---
cki("total_5",  pc_total(5),  32)
cki("total_4",  pc_total(4),  16)
cki("total_3",  pc_total(3),  8)
cki("total_0",  pc_total(0),  1)
cki("total_10", pc_total(10), 1024)

// --- pc_prob_exactly ---
// pc_prob_exactly(5,2) = 10/32 = 5/16
let pe52 = pc_prob_exactly(5, 2)
ckr("pe_5_2", pe52, 5, 16)

// pc_prob_exactly(4,2) = 6/16 = 3/8
let pe42 = pc_prob_exactly(4, 2)
ckr("pe_4_2", pe42, 3, 8)

// pc_prob_exactly(3,3) = 1/8
let pe33 = pc_prob_exactly(3, 3)
ckr("pe_3_3", pe33, 1, 8)

// pc_prob_exactly(5,0) = 1/32
let pe50 = pc_prob_exactly(5, 0)
ckr("pe_5_0", pe50, 1, 32)

// pc_prob_exactly(1,1) = 1/2
let pe11 = pc_prob_exactly(1, 1)
ckr("pe_1_1", pe11, 1, 2)

// edge: k > n => 0/1
let pe_ov = pc_prob_exactly(3, 4)
ckr("pe_over", pe_ov, 0, 1)

// --- pc_prob_at_least ---
// pc_prob_at_least(2,1) = (C(2,1)+C(2,2))/4 = (2+1)/4 = 3/4
let pal21 = pc_prob_at_least(2, 1)
ckr("pal_2_1", pal21, 3, 4)

// pc_prob_at_least(3,3) = C(3,3)/8 = 1/8
let pal33 = pc_prob_at_least(3, 3)
ckr("pal_3_3", pal33, 1, 8)

// pc_prob_at_least(5,5) = 1/32
let pal55 = pc_prob_at_least(5, 5)
ckr("pal_5_5", pal55, 1, 32)

// pc_prob_at_least(3,0) = 1/1
let pal30 = pc_prob_at_least(3, 0)
ckr("pal_3_0", pal30, 1, 1)

// pc_prob_at_least(3,4) = 0 (k > n)
let pal34 = pc_prob_at_least(3, 4)
ckr("pal_3_4", pal34, 0, 1)

print("PASS _prob_coin_test")
