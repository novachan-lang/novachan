import std/httphdr/http_qvalue

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got=[" + got + "] want=[" + want + "]")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn ckl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        let gp = got[i]
        let wp = want[i]
        if gp[0] != wp[0] or gp[1] != wp[1]
            print("FAIL " + label + "[" + str(i) + "]: got=[" + str(gp[0]) + "," + str(gp[1]) + "] want=[" + str(wp[0]) + "," + str(wp[1]) + "]")
            exit(1)
        i = i + 1

fn main()
    // ── KAT spec: hqv_best picks highest q ───────────────────────────────────
    let off1 = ["gzip", "br"]
    cks("spec-best-br", hqv_best("gzip;q=0.5, br;q=1.0", off1), "br")

    // ── KAT spec: hqv_acceptable q=0 -> false ────────────────────────────────
    ckb("spec-acceptable-q0-false", hqv_acceptable("gzip;q=0", "gzip"), false)

    // ── KAT spec: hqv_acceptable default q=1 -> true ─────────────────────────
    ckb("spec-acceptable-default-true", hqv_acceptable("gzip", "gzip"), true)

    // ── KAT spec: hqv_parse en-US and en;q=0.9 ───────────────────────────────
    let p1 = hqv_parse("en-US, en;q=0.9")
    cki("spec-parse-len", len(p1), 2)
    let e0 = p1[0]
    let e1 = p1[1]
    cks("spec-parse-0-val", e0[0], "en-us")
    cki("spec-parse-0-q", e0[1], 1000)
    cks("spec-parse-1-val", e1[0], "en")
    cki("spec-parse-1-q", e1[1], 900)

    // ── KAT spec: hqv_best deflate > gzip ────────────────────────────────────
    let off2 = ["gzip", "deflate"]
    cks("spec-best-deflate", hqv_best("deflate, gzip;q=0.8", off2), "deflate")

    // ── hqv_parse: empty -> [] ────────────────────────────────────────────────
    let p0 = hqv_parse("")
    cki("parse-empty", len(p0), 0)

    // ── hqv_parse: single value default q ─────────────────────────────────────
    let p2 = hqv_parse("gzip")
    cki("parse-single-len", len(p2), 1)
    cks("parse-single-val", p2[0][0], "gzip")
    cki("parse-single-q", p2[0][1], 1000)

    // ── hqv_parse: q=0.5 -> 500 ──────────────────────────────────────────────
    let p3 = hqv_parse("gzip;q=0.5")
    cki("parse-q05", p3[0][1], 500)

    // ── hqv_parse: multiple sorted ────────────────────────────────────────────
    let p4 = hqv_parse("a;q=0.3, b;q=0.9, c")
    cki("parse-multi-len", len(p4), 3)
    cks("parse-multi-0", p4[0][0], "c")
    cki("parse-multi-0-q", p4[0][1], 1000)
    cks("parse-multi-1", p4[1][0], "b")
    cki("parse-multi-1-q", p4[1][1], 900)
    cks("parse-multi-2", p4[2][0], "a")
    cki("parse-multi-2-q", p4[2][1], 300)

    // ── hqv_parse: ties preserve input order ─────────────────────────────────
    let p5 = hqv_parse("x, y, z")
    cks("parse-ties-0", p5[0][0], "x")
    cks("parse-ties-1", p5[1][0], "y")
    cks("parse-ties-2", p5[2][0], "z")

    // ── hqv_best: no match -> "" ──────────────────────────────────────────────
    let off3 = ["br"]
    cks("best-no-match", hqv_best("gzip", off3), "")

    // ── hqv_best: empty offered -> "" ─────────────────────────────────────────
    let empty_off = []
    cks("best-empty-offered", hqv_best("gzip", empty_off), "")

    // ── hqv_best: all q=0 -> "" ───────────────────────────────────────────────
    let off4 = ["gzip"]
    cks("best-all-q0", hqv_best("gzip;q=0", off4), "")

    // ── hqv_acceptable: absent from header -> false ───────────────────────────
    ckb("acceptable-absent", hqv_acceptable("gzip", "br"), false)

    // ── hqv_acceptable: empty header -> false ────────────────────────────────
    ckb("acceptable-empty", hqv_acceptable("", "gzip"), false)

    // ── hqv_acceptable: case-insensitive ─────────────────────────────────────
    ckb("acceptable-case", hqv_acceptable("GZIP", "gzip"), true)

    // ── hqv_parse: case-lowercased ────────────────────────────────────────────
    let p6 = hqv_parse("GZIP")
    cks("parse-lower", p6[0][0], "gzip")

    // ── hqv_best: case-insensitive (offered capitalized) ─────────────────────
    let off5 = ["GZIP"]
    cks("best-case", hqv_best("gzip", off5), "GZIP")

    // ── hqv_parse: q=1.0 -> 1000 ─────────────────────────────────────────────
    let p7 = hqv_parse("br;q=1.0")
    cki("parse-q10", p7[0][1], 1000)

    // ── hqv_parse: q=0.001 -> 1 ──────────────────────────────────────────────
    let p8 = hqv_parse("br;q=0.001")
    cki("parse-q001", p8[0][1], 1)

    print("PASS _http_qvalue_test")
