// KAT for std/bits/pow2 — power-of-two queries, rounding, and logarithms.
// All expected values hand-computed and cross-checked.
import std/bits/pow2

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL pow2 " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL pow2 " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn main()
    // --- p2_is_pow2 ---
    ckb("p2_is_pow2(1)", p2_is_pow2(1), true)
    ckb("p2_is_pow2(2)", p2_is_pow2(2), true)
    ckb("p2_is_pow2(4)", p2_is_pow2(4), true)
    ckb("p2_is_pow2(8)", p2_is_pow2(8), true)
    ckb("p2_is_pow2(16)", p2_is_pow2(16), true)
    ckb("p2_is_pow2(1024)", p2_is_pow2(1024), true)
    ckb("p2_is_pow2(0)", p2_is_pow2(0), false)
    ckb("p2_is_pow2(3)", p2_is_pow2(3), false)
    ckb("p2_is_pow2(5)", p2_is_pow2(5), false)
    ckb("p2_is_pow2(6)", p2_is_pow2(6), false)
    ckb("p2_is_pow2(7)", p2_is_pow2(7), false)
    ckb("p2_is_pow2(100)", p2_is_pow2(100), false)

    // --- p2_log2_floor ---
    // 1 -> 0, 2 -> 1, 4 -> 2, 8 -> 3, 16 -> 4
    cki("p2_log2_floor(1)", p2_log2_floor(1), 0)
    cki("p2_log2_floor(2)", p2_log2_floor(2), 1)
    cki("p2_log2_floor(3)", p2_log2_floor(3), 1)
    cki("p2_log2_floor(4)", p2_log2_floor(4), 2)
    cki("p2_log2_floor(7)", p2_log2_floor(7), 2)
    cki("p2_log2_floor(8)", p2_log2_floor(8), 3)
    cki("p2_log2_floor(9)", p2_log2_floor(9), 3)
    cki("p2_log2_floor(15)", p2_log2_floor(15), 3)
    cki("p2_log2_floor(16)", p2_log2_floor(16), 4)
    cki("p2_log2_floor(100)", p2_log2_floor(100), 6)
    cki("p2_log2_floor(1024)", p2_log2_floor(1024), 10)

    // --- p2_log2_ceil ---
    cki("p2_log2_ceil(1)", p2_log2_ceil(1), 0)
    cki("p2_log2_ceil(2)", p2_log2_ceil(2), 1)
    cki("p2_log2_ceil(3)", p2_log2_ceil(3), 2)
    cki("p2_log2_ceil(4)", p2_log2_ceil(4), 2)
    cki("p2_log2_ceil(5)", p2_log2_ceil(5), 3)
    cki("p2_log2_ceil(7)", p2_log2_ceil(7), 3)
    cki("p2_log2_ceil(8)", p2_log2_ceil(8), 3)
    cki("p2_log2_ceil(9)", p2_log2_ceil(9), 4)
    cki("p2_log2_ceil(16)", p2_log2_ceil(16), 4)
    cki("p2_log2_ceil(17)", p2_log2_ceil(17), 5)
    cki("p2_log2_ceil(1024)", p2_log2_ceil(1024), 10)
    cki("p2_log2_ceil(1025)", p2_log2_ceil(1025), 11)

    // --- p2_next_pow2 ---
    cki("p2_next_pow2(0)", p2_next_pow2(0), 1)
    cki("p2_next_pow2(1)", p2_next_pow2(1), 1)
    cki("p2_next_pow2(2)", p2_next_pow2(2), 2)
    cki("p2_next_pow2(3)", p2_next_pow2(3), 4)
    cki("p2_next_pow2(4)", p2_next_pow2(4), 4)
    cki("p2_next_pow2(5)", p2_next_pow2(5), 8)
    cki("p2_next_pow2(7)", p2_next_pow2(7), 8)
    cki("p2_next_pow2(8)", p2_next_pow2(8), 8)
    cki("p2_next_pow2(9)", p2_next_pow2(9), 16)
    cki("p2_next_pow2(100)", p2_next_pow2(100), 128)
    cki("p2_next_pow2(128)", p2_next_pow2(128), 128)
    cki("p2_next_pow2(129)", p2_next_pow2(129), 256)
    cki("p2_next_pow2(1000)", p2_next_pow2(1000), 1024)
    cki("p2_next_pow2(1024)", p2_next_pow2(1024), 1024)

    // --- p2_prev_pow2 ---
    cki("p2_prev_pow2(1)", p2_prev_pow2(1), 1)
    cki("p2_prev_pow2(2)", p2_prev_pow2(2), 2)
    cki("p2_prev_pow2(3)", p2_prev_pow2(3), 2)
    cki("p2_prev_pow2(4)", p2_prev_pow2(4), 4)
    cki("p2_prev_pow2(5)", p2_prev_pow2(5), 4)
    cki("p2_prev_pow2(7)", p2_prev_pow2(7), 4)
    cki("p2_prev_pow2(8)", p2_prev_pow2(8), 8)
    cki("p2_prev_pow2(9)", p2_prev_pow2(9), 8)
    cki("p2_prev_pow2(100)", p2_prev_pow2(100), 64)
    cki("p2_prev_pow2(1024)", p2_prev_pow2(1024), 1024)
    cki("p2_prev_pow2(1025)", p2_prev_pow2(1025), 1024)

    // --- p2_round_up_multiple ---
    cki("p2_rum(13,8)", p2_round_up_multiple(13, 8), 16)
    // multiples of 8: 0,8,16,24
    cki("p2_rum(0,8)", p2_round_up_multiple(0, 8), 0)
    cki("p2_rum(8,8)", p2_round_up_multiple(8, 8), 8)
    cki("p2_rum(9,8)", p2_round_up_multiple(9, 8), 16)
    cki("p2_rum(16,8)", p2_round_up_multiple(16, 8), 16)
    // multiples of 1 = x itself
    cki("p2_rum(13,1)", p2_round_up_multiple(13, 1), 13)
    // multiples of 7
    cki("p2_rum(7,7)", p2_round_up_multiple(7, 7), 7)
    cki("p2_rum(8,7)", p2_round_up_multiple(8, 7), 14)
    cki("p2_rum(14,7)", p2_round_up_multiple(14, 7), 14)
    cki("p2_rum(15,7)", p2_round_up_multiple(15, 7), 21)
    // power-of-2 multiple (=alignment): round 100 up to 64 alignment
    cki("p2_rum(100,64)", p2_round_up_multiple(100, 64), 128)
    cki("p2_rum(128,64)", p2_round_up_multiple(128, 64), 128)

    // --- ROUND-TRIP: next/prev are inverses on powers of 2 ---
    // for a power of 2 p: next_pow2(p) == p and prev_pow2(p) == p
    cki("rt-next-is-identity(64)", p2_next_pow2(64), 64)
    cki("rt-prev-is-identity(64)", p2_prev_pow2(64), 64)
    cki("rt-next-is-identity(256)", p2_next_pow2(256), 256)
    cki("rt-prev-is-identity(256)", p2_prev_pow2(256), 256)

    // --- ROUND-TRIP: log2_floor / log2_ceil consistency ---
    // for power of 2: floor == ceil
    cki("rt-log2-pow2(8)", p2_log2_floor(8), p2_log2_ceil(8))
    cki("rt-log2-pow2(64)", p2_log2_floor(64), p2_log2_ceil(64))
    cki("rt-log2-pow2(1024)", p2_log2_floor(1024), p2_log2_ceil(1024))
    // for non-power-of-2: ceil == floor + 1
    cki("rt-log2-nonpow2(5)", p2_log2_ceil(5) - p2_log2_floor(5), 1)
    cki("rt-log2-nonpow2(100)", p2_log2_ceil(100) - p2_log2_floor(100), 1)

    // --- ROUND-TRIP: is_pow2 on next_pow2 result ---
    // next_pow2 always returns a power of 2
    ckb("rt-is-pow2(next_pow2(13))", p2_is_pow2(p2_next_pow2(13)), true)
    ckb("rt-is-pow2(next_pow2(99))", p2_is_pow2(p2_next_pow2(99)), true)
    ckb("rt-is-pow2(prev_pow2(99))", p2_is_pow2(p2_prev_pow2(99)), true)

    print("PASS _pow2_test")

main()
