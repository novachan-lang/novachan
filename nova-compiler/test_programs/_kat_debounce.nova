import forge_debounce

fn main()
    let d = deb_new(100)
    assert(deb_total_events(d) == 0, "starts 0")

    let r1 = deb_event(d, 100)
    d = r1["d"]
    assert(r1["fire"] == 1, "first fires")
    assert(deb_total_fired(d) == 1, "1 fired")
    assert(deb_last_fired(d) == 100, "last at 100")

    let r2 = deb_event(d, 150)
    d = r2["d"]
    assert(r2["fire"] == 0, "too soon suppressed")
    assert(deb_total_suppressed(d) == 1, "1 suppressed")

    let r3 = deb_event(d, 199)
    d = r3["d"]
    assert(r3["fire"] == 0, "still too soon")

    let r4 = deb_event(d, 200)
    d = r4["d"]
    assert(r4["fire"] == 1, "exactly at cooldown fires")
    assert(deb_total_fired(d) == 2, "2 fired")

    let r5 = deb_event(d, 500)
    d = r5["d"]
    assert(r5["fire"] == 1, "well past cooldown fires")

    assert(deb_total_events(d) == 5, "5 total events")
    assert(deb_total_fired(d) == 3, "3 total fired")
    assert(deb_total_suppressed(d) == 2, "2 total suppressed")
    assert(deb_suppression_rate(d) == 40, "40% suppressed")

    print("DEBOUNCE KAT PASS")
