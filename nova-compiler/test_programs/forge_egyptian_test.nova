import forge_egyptian as eg

fn check(cond: bool, label: string)
    if cond == false
        print("FAIL: " + label)

fn my_gcd(a: int, b: int) -> int
    let x = a
    let y = b
    while y != 0
        let t = x % y
        x = y
        y = t
    if x < 0
        x = 0 - x
    x

fn main()
    // ---- known decompositions ----
    let e23 = eg.egyptian_fraction(2, 3)
    check(len(e23) == 2 and e23[0] == 2 and e23[1] == 6, "2/3 -> [2,6]")
    let e34 = eg.egyptian_fraction(3, 4)
    check(len(e34) == 2 and e34[0] == 2 and e34[1] == 4, "3/4 -> [2,4]")
    let e56 = eg.egyptian_fraction(5, 6)
    check(len(e56) == 2 and e56[0] == 2 and e56[1] == 3, "5/6 -> [2,3]")
    let e413 = eg.egyptian_fraction(4, 13)
    check(len(e413) == 3 and e413[0] == 4 and e413[1] == 18 and e413[2] == 468, "4/13 -> [4,18,468]")

    // unit fraction already: 1/5 -> [5]
    let e15 = eg.egyptian_fraction(1, 5)
    check(len(e15) == 1 and e15[0] == 5, "1/5 -> [5]")

    // ---- improper / invalid inputs -> empty ----
    check(len(eg.egyptian_fraction(5, 3)) == 0, "improper 5/3 -> empty")
    check(len(eg.egyptian_fraction(0, 5)) == 0, "0/5 -> empty")
    check(len(eg.egyptian_fraction(3, 3)) == 0, "3/3 -> empty")

    // ---- egyptian_check on the known ones ----
    check(eg.egyptian_check(e23, 2, 3), "check 2/3")
    check(eg.egyptian_check(e34, 3, 4), "check 3/4")
    check(eg.egyptian_check(e413, 4, 13), "check 4/13")
    // a deliberately wrong decomposition must fail
    check(eg.egyptian_check([2, 5], 2, 3) == false, "wrong decomposition fails")

    // ---- EXHAUSTIVE self-check: for every proper reduced a/b with b<=40, greedy must ----
    //   (1) sum back exactly, (2) be strictly increasing / distinct, (3) all denominators >= 2
    let b = 2
    while b <= 40
        let a = 1
        while a < b
            if my_gcd(a, b) == 1
                let dec = eg.egyptian_fraction(a, b)
                check(len(dec) > 0, "decomp nonempty " + str(a) + "/" + str(b))
                check(eg.egyptian_check(dec, a, b), "sums back " + str(a) + "/" + str(b))
                check(eg.all_distinct(dec), "distinct " + str(a) + "/" + str(b))
                // strictly increasing and all >= 2
                let prev = 0
                let k = 0
                let mono = true
                while k < len(dec)
                    if dec[k] <= prev
                        mono = false
                    if dec[k] < 2
                        mono = false
                    prev = dec[k]
                    k = k + 1
                check(mono, "increasing & >=2 " + str(a) + "/" + str(b))
            a = a + 1
        b = b + 1

    print("forge_egyptian: all passed")
