fn _basic_helper(log: list)
  push(log, "start")
  defer push(log, "deferred")
  push(log, "end")

fn test_basic_defer()
  let log = []
  _basic_helper(log)
  assert(len(log) == 3, "basic defer ran: " + str(len(log)))
  assert(log[0] == "start", "start first")
  assert(log[1] == "end", "end second")
  assert(log[2] == "deferred", "deferred last: " + str(log))

fn _multi_helper(log: list)
  defer push(log, "first")
  defer push(log, "second")
  defer push(log, "third")

fn test_multi_defer()
  let log = []
  _multi_helper(log)
  assert(len(log) == 3, "all defers ran: " + str(len(log)))
  assert(log[0] == "third", "LIFO: third first")
  assert(log[1] == "second", "LIFO: second next")
  assert(log[2] == "first", "LIFO: first last")

fn _early_return_helper(log: list, early: bool) -> int
  defer push(log, "cleanup")
  push(log, "body")
  if early
    return 1
  push(log, "late")
  0

fn test_defer_with_early_return()
  let log = []
  let _r = _early_return_helper(log, true)
  assert(len(log) == 2, "defer ran on early return: " + str(len(log)))
  assert(log[0] == "body", "body first")
  assert(log[1] == "cleanup", "cleanup second")
  let log2 = []
  let _r2 = _early_return_helper(log2, false)
  assert(len(log2) == 3, "defer ran on normal return: " + str(len(log2)))
  assert(log2[0] == "body", "body first (normal)")
  assert(log2[1] == "late", "late second (normal)")
  assert(log2[2] == "cleanup", "cleanup third (normal)")

fn _file_helper()
  let handle = file_open("__defer_test_tmp.txt", "w")
  defer file_close(handle)
  file_write(handle, "hello defer")

fn test_defer_file_close()
  _file_helper()
  let content = read_file("__defer_test_tmp.txt")
  assert(contains(content, "hello defer"), "file written and closed via defer")
  remove_file("__defer_test_tmp.txt")

fn _do_inc(count: list)
  count[0] = count[0] + 1

fn _counter_helper(count: list)
  defer _do_inc(count)
  defer _do_inc(count)
  defer _do_inc(count)

fn test_defer_counter()
  let count = [0]
  _counter_helper(count)
  assert(count[0] == 3, "deferred increments ran: " + str(count[0]))

fn main()
  test_basic_defer()
  test_multi_defer()
  test_defer_with_early_return()
  test_defer_file_close()
  test_defer_counter()
  print("defer_test: all passed")
