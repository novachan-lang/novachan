import std/physics/relativity

fn approx(a, b)
    let d = a - b
    let ad = 0.0
    if d < 0.0
        ad = 0.0 - d
    else
        ad = d
    let result = false
    if ad < 0.0001
        result = true
    result

// relative tolerance: |a-b|/|b| < 1e-6
fn approx_rel(a, b)
    let d = a - b
    let ad = 0.0
    if d < 0.0
        ad = 0.0 - d
    else
        ad = d
    let ab = 0.0
    if b < 0.0
        ab = 0.0 - b
    else
        ab = b
    let result = false
    if ab > 0.0
        let rel = ad / ab
        if rel < 0.000001
            result = true
    result

fn main()
    // lorentz_factor(0.0) = 1.0
    let v1 = lorentz_factor(0.0)
    if approx(v1, 1.0)
        print("lorentz_factor(0) OK: " + str(v1))
    else
        print("FAIL relativity lorentz_factor(0): got " + str(v1) + " expected 1.0")
        exit(1)

    // lorentz_factor(v) > 1.0 for v > 0
    // Use v = 0.1 * C() — a significant fraction of c
    let c_val = C()
    let v_test = c_val * 0.1
    let gamma_test = lorentz_factor(v_test)
    let ok2 = false
    if gamma_test > 1.0
        ok2 = true
    if ok2
        print("lorentz_factor(v>0)>1 OK: " + str(gamma_test))
    else
        print("FAIL relativity lorentz_factor(v>0)>1: got " + str(gamma_test))
        exit(1)

    // mass_energy(1.0) = c^2 = 8.987551787e16
    // Use relative tolerance since the number is ~9e16
    let v3 = mass_energy(1.0)
    let expected_e = 8.987551787e16
    if approx_rel(v3, expected_e)
        print("mass_energy(1) OK: " + str(v3))
    else
        print("FAIL relativity mass_energy(1): got " + str(v3) + " expected ~8.987e16")
        exit(1)

    // length_contraction: l' < l for v > 0
    let l_orig = 100.0
    let l_contracted = length_contraction(l_orig, v_test)
    let ok4 = false
    if l_contracted < l_orig
        ok4 = true
    if ok4
        print("length_contraction OK: " + str(l_contracted) + " < " + str(l_orig))
    else
        print("FAIL relativity length_contraction: got " + str(l_contracted) + " not < " + str(l_orig))
        exit(1)

    // time_dilation: t' > t for v > 0
    let t_orig = 1.0
    let t_dilated = time_dilation(t_orig, v_test)
    let ok5 = false
    if t_dilated > t_orig
        ok5 = true
    if ok5
        print("time_dilation OK: " + str(t_dilated) + " > " + str(t_orig))
    else
        print("FAIL relativity time_dilation: got " + str(t_dilated) + " not > " + str(t_orig))
        exit(1)

    print("PASS _relativity_test")
