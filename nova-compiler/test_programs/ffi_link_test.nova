// @link("libname") annotation: declares which C library to link against.
// On Windows + clang, libm/libc are auto-linked, so we test with libm where
// the annotation is a no-op on Windows but correct + necessary on Linux.
// The build script picks up '; LINK_LIB:' comments emitted by the compiler
// and passes them to clang as -l flags.
@link("m")
extern fn sqrt(x: float) -> float

fn main()
    let s4 = unsafe sqrt(4.0)
    assert_near(s4, 2.0, 0.001)
    let s9 = unsafe sqrt(9.0)
    assert_near(s9, 3.0, 0.001)
    let s2 = unsafe sqrt(2.0)
    assert_near(s2, 1.4142135, 0.001)
    print("@link test passed: extern fn sqrt from libm called via @link annotation, returned correct values")
