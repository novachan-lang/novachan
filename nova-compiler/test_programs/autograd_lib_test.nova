import autograd

// Validation: every gradient below is computed by hand from elementary calculus.
fn _near(a: float, b: float) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < 0.0001
        return 1
    0

fn main()
    // f = x*y + x*x ; x=3, y=2 -> f=15, df/dx = y + 2x = 8, df/dy = x = 3
    let t = autograd.ad_tape()
    let x = autograd.ad_leaf(t, 3.0)
    let y = autograd.ad_leaf(t, 2.0)
    let f = autograd.ad_add(t, autograd.ad_mul(t, x, y), autograd.ad_mul(t, x, x))
    assert(_near(autograd.ad_value(t, f), 15.0), "f=15")
    autograd.ad_backward(t, f)
    assert(_near(autograd.ad_grad(t, x), 8.0), "df/dx=8")
    assert(_near(autograd.ad_grad(t, y), 3.0), "df/dy=3")

    // q = x / y ; x=3, y=2 -> q=1.5, dq/dx = 1/y = 0.5, dq/dy = -x/y^2 = -0.75
    let t2 = autograd.ad_tape()
    let x2 = autograd.ad_leaf(t2, 3.0)
    let y2 = autograd.ad_leaf(t2, 2.0)
    let q = autograd.ad_div(t2, x2, y2)
    assert(_near(autograd.ad_value(t2, q), 1.5), "q=1.5")
    autograd.ad_backward(t2, q)
    assert(_near(autograd.ad_grad(t2, x2), 0.5), "dq/dx=0.5")
    assert(_near(autograd.ad_grad(t2, y2), -0.75), "dq/dy=-0.75")

    // relu active: relu(x), x=3 -> 3, grad 1
    let t3 = autograd.ad_tape()
    let x3 = autograd.ad_leaf(t3, 3.0)
    let s = autograd.ad_relu(t3, x3)
    assert(_near(autograd.ad_value(t3, s), 3.0), "relu(3)=3")
    autograd.ad_backward(t3, s)
    assert(_near(autograd.ad_grad(t3, x3), 1.0), "drelu/dx=1 active")

    // relu inactive: relu(x), x=-2 -> 0, grad 0
    let t4 = autograd.ad_tape()
    let x4 = autograd.ad_leaf(t4, -2.0)
    let s4 = autograd.ad_relu(t4, x4)
    assert(_near(autograd.ad_value(t4, s4), 0.0), "relu(-2)=0")
    autograd.ad_backward(t4, s4)
    assert(_near(autograd.ad_grad(t4, x4), 0.0), "drelu/dx=0 inactive")

    // exp: e = exp(x), x=1 -> de/dx = exp(x) = e itself
    let t5 = autograd.ad_tape()
    let x5 = autograd.ad_leaf(t5, 1.0)
    let e = autograd.ad_exp(t5, x5)
    autograd.ad_backward(t5, e)
    assert(_near(autograd.ad_grad(t5, x5), autograd.ad_value(t5, e)), "dexp/dx=exp(x)")

    // KEY reverse-mode test: shared subexpression must ACCUMULATE.
    // g = (x+y)*(x+y), x=3, y=2 -> 25; dg/dx = 2(x+y) = 10, dg/dy = 10
    let t6 = autograd.ad_tape()
    let x6 = autograd.ad_leaf(t6, 3.0)
    let y6 = autograd.ad_leaf(t6, 2.0)
    let sm = autograd.ad_add(t6, x6, y6)
    let g6 = autograd.ad_mul(t6, sm, sm)
    assert(_near(autograd.ad_value(t6, g6), 25.0), "g=25")
    autograd.ad_backward(t6, g6)
    assert(_near(autograd.ad_grad(t6, x6), 10.0), "dg/dx=10 (shared subexpr accumulates)")
    assert(_near(autograd.ad_grad(t6, y6), 10.0), "dg/dy=10")

    // log: L = log(x), x=4 -> dL/dx = 1/x = 0.25
    let t7 = autograd.ad_tape()
    let x7 = autograd.ad_leaf(t7, 4.0)
    let lg = autograd.ad_log(t7, x7)
    autograd.ad_backward(t7, lg)
    assert(_near(autograd.ad_grad(t7, x7), 0.25), "dlog/dx=1/x=0.25")

    print("autograd_lib_test: all passed")
