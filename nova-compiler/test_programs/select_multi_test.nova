// Select with 5 channels — stress test fan-in via select
ch1 = channel()
ch2 = channel()
ch3 = channel()
ch4 = channel()
ch5 = channel()

spawn fn()
    send(ch1, 100)

spawn fn()
    send(ch2, 200)

spawn fn()
    send(ch3, 300)

spawn fn()
    send(ch4, 400)

spawn fn()
    send(ch5, 500)

// Collect all 5 values using select — order is non-deterministic but sum = 1500
total = 0
r1 = select(ch1, ch2, ch3, ch4, ch5)
total = total + r1[1]
r2 = select(ch1, ch2, ch3, ch4, ch5)
total = total + r2[1]
r3 = select(ch1, ch2, ch3, ch4, ch5)
total = total + r3[1]
r4 = select(ch1, ch2, ch3, ch4, ch5)
total = total + r4[1]
r5 = select(ch1, ch2, ch3, ch4, ch5)
total = total + r5[1]
print(total)
