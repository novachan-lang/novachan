fn main()
    let xs = [1, 2, 3, 4, 5]
    let evens = [x for x in xs if x % 2 == 0]
    print(evens)

    let d = {"a": 1, "b": 2, "c": 3}
    let has_a = "a" in d
    print(has_a)

    let has_z = "z" in d
    print(has_z)

    let sum_all = sum(xs)
    print(sum_all)

    let mn = min(xs)
    let mx = max(xs)
    print(mn)
    print(mx)

    print("probe done")
