import std/complex/complex_two_squares

// cki — assert integer equality
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _complex_two_squares_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb — assert bool equality
fn ckb(label: string, got: bool, want: bool)
    if got != want
        print("FAIL _complex_two_squares_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckl — assert list equality (two-element [a,b])
fn ckl(label: string, got: list, wa: int, wb: int)
    if got[0] != wa or got[1] != wb
        print("FAIL _complex_two_squares_test " + label + ": got=[" + str(got[0]) + "," + str(got[1]) + "] want=[" + str(wa) + "," + str(wb) + "]")
        exit(1)

// cks — assert string equality
fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL _complex_two_squares_test " + label + ": got=" + got + " want=" + want)
        exit(1)

// cx2_can(25) = true (0^2+5^2 or 3^2+4^2)
ckb("can_25", cx2_can(25), true)

// cx2_represent(25) = [0,5] (smallest a is 0)
let r25 = cx2_represent(25)
ckl("repr_25", r25, 0, 5)

// cx2_represent(5) = [1,2]
let r5 = cx2_represent(5)
ckl("repr_5", r5, 1, 2)

// cx2_can(3) = false (3 ≡ 3 mod 4, appears to odd power)
ckb("can_3", cx2_can(3), false)

// cx2_can(2) = true (1^2+1^2)
ckb("can_2", cx2_can(2), true)

// cx2_represent(2) = [1,1]
let r2 = cx2_represent(2)
ckl("repr_2", r2, 1, 1)

// cx2_count_representations(25) = 2 ([0,5] and [3,4])
cki("count_25", cx2_count_representations(25), 2)

// cx2_can(50) = true (1^2+7^2 or 5^2+5^2)
ckb("can_50", cx2_can(50), true)

// extra: cx2_can(0) = true
ckb("can_0", cx2_can(0), true)

// cx2_represent(0) = [0,0]
let r0 = cx2_represent(0)
ckl("repr_0", r0, 0, 0)

// cx2_can(1) = true (0^2+1^2)
ckb("can_1", cx2_can(1), true)

// cx2_represent(1) = [0,1]
let r1 = cx2_represent(1)
ckl("repr_1", r1, 0, 1)

// cx2_can(7) = false
ckb("can_7", cx2_can(7), false)

// cx2_count_representations(2) = 1
cki("count_2", cx2_count_representations(2), 1)

// cx2_count_representations(50) = 2 ([1,7] and [5,5])
cki("count_50", cx2_count_representations(50), 2)

print("PASS _complex_two_squares_test")
