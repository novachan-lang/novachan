import std/collections/intervalheap

fn cki(label, got, want)
    if got != want
        print("FAIL intervalheap " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // KAT 1: empty heap returns null
    let h0 = ivh_new()
    cki("empty_size", ivh_size(h0), 0)
    if ivh_min(h0) != null
        print("FAIL intervalheap empty_min: expected null")
        exit(1)
    if ivh_max(h0) != null
        print("FAIL intervalheap empty_max: expected null")
        exit(1)
    if ivh_pop_min(h0) != null
        print("FAIL intervalheap empty_pop_min: expected null")
        exit(1)
    if ivh_pop_max(h0) != null
        print("FAIL intervalheap empty_pop_max: expected null")
        exit(1)

    // KAT 2: single element
    let h1 = ivh_new()
    ivh_push(h1, 42)
    cki("single_size", ivh_size(h1), 1)
    cki("single_min", ivh_min(h1), 42)
    cki("single_max", ivh_max(h1), 42)

    // KAT 3: two elements
    let h2 = ivh_new()
    ivh_push(h2, 10)
    ivh_push(h2, 5)
    cki("two_min", ivh_min(h2), 5)
    cki("two_max", ivh_max(h2), 10)
    cki("two_size", ivh_size(h2), 2)

    // KAT 4: push 5,3,8,1,9,2,7 — peek min/max
    let h = ivh_new()
    ivh_push(h, 5)
    ivh_push(h, 3)
    ivh_push(h, 8)
    ivh_push(h, 1)
    ivh_push(h, 9)
    ivh_push(h, 2)
    ivh_push(h, 7)
    cki("seven_size", ivh_size(h), 7)
    cki("seven_min", ivh_min(h), 1)
    cki("seven_max", ivh_max(h), 9)

    // KAT 5: pop_min gives ascending order [1,2,3,5,7,8,9]
    let h3 = ivh_new()
    ivh_push(h3, 5)
    ivh_push(h3, 3)
    ivh_push(h3, 8)
    ivh_push(h3, 1)
    ivh_push(h3, 9)
    ivh_push(h3, 2)
    ivh_push(h3, 7)
    let pm0 = ivh_pop_min(h3)
    cki("pop_min_0", pm0, 1)
    let pm1 = ivh_pop_min(h3)
    cki("pop_min_1", pm1, 2)
    let pm2 = ivh_pop_min(h3)
    cki("pop_min_2", pm2, 3)
    let pm3 = ivh_pop_min(h3)
    cki("pop_min_3", pm3, 5)
    let pm4 = ivh_pop_min(h3)
    cki("pop_min_4", pm4, 7)
    let pm5 = ivh_pop_min(h3)
    cki("pop_min_5", pm5, 8)
    let pm6 = ivh_pop_min(h3)
    cki("pop_min_6", pm6, 9)
    cki("after_pop_min_all_size", ivh_size(h3), 0)

    // KAT 6: pop_max gives descending order [9,8,7,5,3,2,1]
    let h4 = ivh_new()
    ivh_push(h4, 5)
    ivh_push(h4, 3)
    ivh_push(h4, 8)
    ivh_push(h4, 1)
    ivh_push(h4, 9)
    ivh_push(h4, 2)
    ivh_push(h4, 7)
    let px0 = ivh_pop_max(h4)
    cki("pop_max_0", px0, 9)
    let px1 = ivh_pop_max(h4)
    cki("pop_max_1", px1, 8)
    let px2 = ivh_pop_max(h4)
    cki("pop_max_2", px2, 7)
    let px3 = ivh_pop_max(h4)
    cki("pop_max_3", px3, 5)
    let px4 = ivh_pop_max(h4)
    cki("pop_max_4", px4, 3)
    let px5 = ivh_pop_max(h4)
    cki("pop_max_5", px5, 2)
    let px6 = ivh_pop_max(h4)
    cki("pop_max_6", px6, 1)
    cki("after_pop_max_all_size", ivh_size(h4), 0)

    // KAT 7: duplicates [4,4,4] min==max==4
    let h5 = ivh_new()
    ivh_push(h5, 4)
    ivh_push(h5, 4)
    ivh_push(h5, 4)
    cki("dup_min", ivh_min(h5), 4)
    cki("dup_max", ivh_max(h5), 4)
    cki("dup_size", ivh_size(h5), 3)
    let dp0 = ivh_pop_min(h5)
    cki("dup_pop0", dp0, 4)
    let dp1 = ivh_pop_min(h5)
    cki("dup_pop1", dp1, 4)
    let dp2 = ivh_pop_min(h5)
    cki("dup_pop2", dp2, 4)
    cki("dup_empty", ivh_size(h5), 0)

    // KAT 8: odd count (5 elements) — pop all via min
    let h6 = ivh_new()
    ivh_push(h6, 10)
    ivh_push(h6, 3)
    ivh_push(h6, 7)
    ivh_push(h6, 1)
    ivh_push(h6, 5)
    let o0 = ivh_pop_min(h6)
    cki("odd_pop0", o0, 1)
    let o1 = ivh_pop_min(h6)
    cki("odd_pop1", o1, 3)
    let o2 = ivh_pop_min(h6)
    cki("odd_pop2", o2, 5)
    let o3 = ivh_pop_min(h6)
    cki("odd_pop3", o3, 7)
    let o4 = ivh_pop_min(h6)
    cki("odd_pop4", o4, 10)

    // KAT 9: interleaved pop_min and pop_max
    let h7 = ivh_new()
    ivh_push(h7, 6)
    ivh_push(h7, 1)
    ivh_push(h7, 8)
    ivh_push(h7, 3)
    let r0 = ivh_pop_max(h7)
    cki("interleaved_max0", r0, 8)
    let r1 = ivh_pop_min(h7)
    cki("interleaved_min1", r1, 1)
    let r2 = ivh_pop_max(h7)
    cki("interleaved_max2", r2, 6)
    let r3 = ivh_pop_min(h7)
    cki("interleaved_min3", r3, 3)

    print("PASS _intervalheap_test")
