import std/interval/allen

fn ckb(got, expected, label)
    let gs = "false"
    if got
        gs = "true"
    let es = "false"
    if expected
        es = "true"
    if got != expected
        print("FAIL allen " + label + ": got=" + gs + " want=" + es)
        exit(1)

fn cks(got, expected, label)
    if got != expected
        print("FAIL allen " + label + ": got=" + got + " want=" + expected)
        exit(1)

fn main()
    // --- KAT: al_before ---
    ckb(allen.al_before([1,2],[3,4]), true, "before [1,2],[3,4]")
    ckb(allen.al_before([1,2],[2,3]), false, "before [1,2],[2,3] false (meets)")
    ckb(allen.al_before([1,3],[2,4]), false, "before [1,3],[2,4] false (overlaps)")

    // --- KAT: al_meets ---
    ckb(allen.al_meets([1,2],[2,3]), true, "meets [1,2],[2,3]")
    ckb(allen.al_meets([1,2],[3,4]), false, "meets [1,2],[3,4] false (before)")
    ckb(allen.al_meets([1,3],[2,4]), false, "meets [1,3],[2,4] false (overlaps)")

    // --- KAT: al_overlaps ---
    ckb(allen.al_overlaps([1,3],[2,4]), true, "overlaps [1,3],[2,4]")
    ckb(allen.al_overlaps([1,2],[3,4]), false, "overlaps [1,2],[3,4] false (before)")
    ckb(allen.al_overlaps([1,5],[2,4]), false, "overlaps [1,5],[2,4] false (contains)")

    // --- KAT: al_starts ---
    ckb(allen.al_starts([1,2],[1,4]), true, "starts [1,2],[1,4]")
    ckb(allen.al_starts([1,4],[1,4]), false, "starts [1,4],[1,4] false (equals)")
    ckb(allen.al_starts([1,5],[1,3]), false, "starts [1,5],[1,3] false (started_by)")

    // --- KAT: al_during ---
    ckb(allen.al_during([2,3],[1,5]), true, "during [2,3],[1,5]")
    ckb(allen.al_during([1,5],[2,3]), false, "during [1,5],[2,3] false (contains)")
    ckb(allen.al_during([1,3],[1,5]), false, "during [1,3],[1,5] false (starts)")

    // --- KAT: al_finishes ---
    ckb(allen.al_finishes([3,4],[1,4]), true, "finishes [3,4],[1,4]")
    ckb(allen.al_finishes([1,4],[1,4]), false, "finishes [1,4],[1,4] false (equals)")
    ckb(allen.al_finishes([1,4],[3,4]), false, "finishes [1,4],[3,4] false (finished_by)")

    // --- KAT: al_equals ---
    ckb(allen.al_equals([1,3],[1,3]), true, "equals [1,3],[1,3]")
    ckb(allen.al_equals([1,3],[1,4]), false, "equals [1,3],[1,4] false")
    ckb(allen.al_equals([1,3],[2,3]), false, "equals [1,3],[2,3] false")

    // --- KAT: inverses ---
    ckb(allen.al_after([3,4],[1,2]), true, "after [3,4],[1,2]")
    ckb(allen.al_met_by([2,3],[1,2]), true, "met_by [2,3],[1,2]")
    ckb(allen.al_overlapped_by([2,4],[1,3]), true, "overlapped_by [2,4],[1,3]")
    ckb(allen.al_started_by([1,4],[1,2]), true, "started_by [1,4],[1,2]")
    ckb(allen.al_contains([1,5],[2,3]), true, "contains [1,5],[2,3]")
    ckb(allen.al_finished_by([1,4],[3,4]), true, "finished_by [1,4],[3,4]")

    // --- KAT: al_relation ---
    cks(allen.al_relation([1,2],[3,4]), "before", "relation before")
    cks(allen.al_relation([3,4],[1,2]), "after", "relation after")
    cks(allen.al_relation([1,2],[2,3]), "meets", "relation meets")
    cks(allen.al_relation([2,3],[1,2]), "met_by", "relation met_by")
    cks(allen.al_relation([1,3],[2,4]), "overlaps", "relation overlaps")
    cks(allen.al_relation([2,4],[1,3]), "overlapped_by", "relation overlapped_by")
    cks(allen.al_relation([1,2],[1,4]), "starts", "relation starts")
    cks(allen.al_relation([1,4],[1,2]), "started_by", "relation started_by")
    cks(allen.al_relation([2,3],[1,5]), "during", "relation during")
    cks(allen.al_relation([1,5],[2,3]), "contains", "relation contains")
    cks(allen.al_relation([3,5],[1,5]), "finishes", "relation finishes")
    cks(allen.al_relation([1,5],[3,5]), "finished_by", "relation finished_by")
    cks(allen.al_relation([1,3],[1,3]), "equals", "relation equals")

    print("PASS _allen_test")

main()
