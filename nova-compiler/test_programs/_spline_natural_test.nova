// KAT test for std/numeric/spline_natural — natural cubic spline second-derivative solve.
// Known-answer tests verified by hand and mathematical properties.
import std/numeric/spline_natural

fn approx(a: float, b: float, tol: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < tol

fn is_finite(v: float) -> bool
    // A finite float satisfies v - v == 0; NaN and Inf do not
    let diff = v - v
    if diff < 0.0
        return false
    if diff > 0.0
        return false
    return true

fn chk(label: string, cond: bool)
    if not cond
        print("FAIL spline_natural " + label)
        exit(1)
    print("ok " + label)

fn main()
    // KAT 1: Three-point symmetric arch (0,0),(1,1),(2,0)
    //   Natural BC: M[0]=0, M[2]=0
    //   Unique interior M[1] can be solved exactly.
    let xs1 = [0.0, 1.0, 2.0]
    let ys1 = [0.0, 1.0, 0.0]
    let m1 = spline_coeffs(xs1, ys1)

    // Must have length 3
    chk("arch_len", len(m1) == 3)

    // Natural boundary: endpoints must be 0.0
    chk("arch_M0_zero", approx(m1[0], 0.0, 0.0001))
    chk("arch_M2_zero", approx(m1[2], 0.0, 0.0001))

    // All coefficients must be finite
    let v0 = m1[0]
    let v1 = m1[1]
    let v2 = m1[2]
    chk("arch_finite_M0", is_finite(v0))
    chk("arch_finite_M1", is_finite(v1))
    chk("arch_finite_M2", is_finite(v2))

    // For the arch (0,0),(1,1),(2,0), the exact second derivative at x=1
    // from the natural cubic spline equation is M[1] = -6.0 * ...
    // The tridiagonal for one interior node:
    //   2*(h0+h1)*M[1] = 6*((y2-y1)/h1 - (y1-y0)/h0)
    //   4 * M[1] = 6 * ((0-1)/1 - (1-0)/1) = 6*(-2) = -12 -> M[1] = -3
    chk("arch_M1_exact", approx(v1, -3.0, 0.001))

    // KAT 2: Straight-line dataset -> all second derivatives must be 0
    let xs2 = [0.0, 1.0, 2.0, 3.0]
    let ys2 = [0.0, 2.0, 4.0, 6.0]
    let m2 = spline_coeffs(xs2, ys2)

    chk("line_len", len(m2) == 4)
    let lm0 = m2[0]
    let lm1 = m2[1]
    let lm2 = m2[2]
    let lm3 = m2[3]
    chk("line_M0_zero", approx(lm0, 0.0, 0.0001))
    chk("line_M1_zero", approx(lm1, 0.0, 0.0001))
    chk("line_M2_zero", approx(lm2, 0.0, 0.0001))
    chk("line_M3_zero", approx(lm3, 0.0, 0.0001))

    // KAT 3: Two-point degenerate case -> all M = 0
    let xs3 = [0.0, 1.0]
    let ys3 = [0.0, 1.0]
    let m3 = spline_coeffs(xs3, ys3)
    chk("two_pt_len", len(m3) == 2)
    let tm0 = m3[0]
    let tm1 = m3[1]
    chk("two_pt_M0", approx(tm0, 0.0, 0.0001))
    chk("two_pt_M1", approx(tm1, 0.0, 0.0001))

    print("PASS _spline_natural_test")
