import std/scheduling/sched_priority

fn cki(name: string, got: int, want: int)
    if got != want
        print("FAIL sched_priority " + name + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(name: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL sched_priority " + name + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL sched_priority " + name + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // KAT 1: canonical non-preemptive priority example
    // procs: [arr=0,burst,priority]: P0(10,3), P1(1,1), P2(2,4), P3(1,5), P4(5,2)
    // Priority order (lower=higher): P1(1) -> P4(2) -> P0(3) -> P2(4) -> P3(5)
    // t=0: P1 runs, comp=1. P4 runs, comp=6. P0 runs, comp=16. P2 runs, comp=18. P3 runs, comp=19.
    // completions = [16, 1, 18, 19, 6]
    // waiting = [16-0-10, 1-0-1, 18-0-2, 19-0-1, 6-0-5] = [6, 0, 16, 18, 1]
    let p1 = [[0,10,3],[0,1,1],[0,2,4],[0,1,5],[0,5,2]]
    let ct_want = []
    push(ct_want, 16)
    push(ct_want, 1)
    push(ct_want, 18)
    push(ct_want, 19)
    push(ct_want, 6)
    let wt_want = []
    push(wt_want, 6)
    push(wt_want, 0)
    push(wt_want, 16)
    push(wt_want, 18)
    push(wt_want, 1)
    let ct1 = pr_completion_times_np(p1)
    ckl("np_completion_times", ct1, ct_want)
    let wt1 = pr_waiting_times_np(p1)
    ckl("np_waiting_times", wt1, wt_want)

    // KAT 2: single process non-preemptive
    let p2 = [[0,5,1]]
    let ct2 = pr_completion_times_np(p2)
    cki("np_single_ct", ct2[0], 5)
    let wt2 = pr_waiting_times_np(p2)
    cki("np_single_wt", wt2[0], 0)

    // KAT 3: tie-breaking by PID (lower PID wins)
    // Two processes arrive at 0 with same priority=1, bursts 3,2
    // P0 (pid=0) should run first: comp[0]=3, comp[1]=5
    let p3 = [[0,3,1],[0,2,1]]
    let ct3 = pr_completion_times_np(p3)
    cki("np_tie_ct[0]", ct3[0], 3)
    cki("np_tie_ct[1]", ct3[1], 5)

    // KAT 4: idle gap — P0 arrives at 5, P1 arrives at 10
    // P0(burst=3,pri=1) runs 5-8. P1(burst=2,pri=1) runs 10-12.
    let p4 = [[5,3,1],[10,2,1]]
    let ct4 = pr_completion_times_np(p4)
    cki("np_idle_ct[0]", ct4[0], 8)
    cki("np_idle_ct[1]", ct4[1], 12)

    // KAT 5: preemptive — same canonical procs (all arrive 0)
    // Preemptive with all-at-0 is identical to non-preemptive (no new arrivals to preempt)
    let ct5 = pr_completion_times_p(p1)
    ckl("p_completion_times_allzero", ct5, ct_want)

    // KAT 6: preemptive — P0(arr=0,burst=10,pri=3), P1(arr=5,burst=1,pri=1)
    // t=0: P0 starts (only one available). t=5: P1 arrives pri=1 < 3, preempts P0.
    // P0 has run 5 units (rem=5). P1(burst=1) runs 5-6 (comp=6).
    // P0 resumes (only one left) runs 6-11 (comp=11).
    let p6 = [[0,10,3],[5,1,1]]
    let ct6 = pr_completion_times_p(p6)
    cki("p_preempt_ct[0]", ct6[0], 11)
    cki("p_preempt_ct[1]", ct6[1], 6)

    print("PASS _sched_priority_test")
