// The Erlang/Elixir gen_server MODEL, composed from NOVA primitives -- NO framework, just the
// language: a process owns private state and serves cast (fire-and-forget) + call (request/reply)
// messages in a receive loop, with an idle `after` timeout. State lives in the process; the only
// way in is a message (process isolation IS the encapsulation). Proves mailbox + selective receive
// + timeout + spawn compose into OTP's flagship behaviour.
//
// Message = [op, from, n]:  op 1 = cast incr(+n)   op 2 = call get(reply to `from`)   op 3 = stop.
fn counter_server(parent)
    let count = 0
    let running = true
    while running
        receive
            m =>
                let op = m[0]
                if op == 1
                    count = count + m[2]
                else if op == 2
                    send_msg(m[1], count)
                else
                    running = false
        after 30000
            running = false           // idle safety timeout (not reached in this test)
    send_msg(parent, count)           // report the final state when the server stops

fn main()
    let me = self_pid()
    let s = spawn counter_server(me)
    let sb = mailbox_of(s)
    // 100 cast incr(+1) -- fire-and-forget, buffered in the server's mailbox, processed FIFO
    let i = 0
    while i < 100
        send_msg(sb, [1, me, 1])
        i = i + 1
    // a call: get -- the server replies with the current count to our mailbox
    send_msg(sb, [2, me, 0])
    let got = recv_msg()
    assert(got == 100, "gen_server served 100 casts then a call -> count 100")
    // stop: the server breaks its loop and reports the final state
    send_msg(sb, [3, me, 0])
    let final_count = recv_msg()
    assert(final_count == 100, "final state on stop is 100")
    print("GEN_SERVER_OK")
