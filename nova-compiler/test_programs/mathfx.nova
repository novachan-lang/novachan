fn lerp(a, b, t)
  a + (b - a) * t

fn clamp(val, lo, hi)
  if val < lo
    return lo
  if val > hi
    return hi
  val

fn remap(val, in_lo, in_hi, out_lo, out_hi)
  let t = (val - in_lo) * 1.0 / (in_hi - in_lo)
  lerp(out_lo, out_hi, t)

fn sign(x)
  if x > 0
    return 1
  if x < 0
    return -1
  0

fn wrap(val, lo, hi)
  let range = hi - lo
  if range <= 0
    return lo
  let result = val
  while result >= hi
    result = result - range
  while result < lo
    result = result + range
  result

fn deg_to_rad(deg)
  deg * 3.14159265 / 180.0

fn rad_to_deg(rad)
  rad * 180.0 / 3.14159265

fn distance_2d(x1, y1, x2, y2)
  let dx = x2 - x1
  let dy = y2 - y1
  sqrt(dx * dx + dy * dy)

fn main()
  assert(lerp(0.0, 10.0, 0.5) == 5.0, "lerp midpoint")
  assert(lerp(0.0, 10.0, 0.0) == 0.0, "lerp start")
  assert(lerp(0.0, 10.0, 1.0) == 10.0, "lerp end")

  assert(clamp(5, 0, 10) == 5, "clamp in range")
  assert(clamp(-5, 0, 10) == 0, "clamp below")
  assert(clamp(15, 0, 10) == 10, "clamp above")

  let remapped = remap(50, 0, 100, 0.0, 1.0)
  assert(remapped == 0.5, "remap 50% = 0.5")

  assert(sign(42) == 1, "sign positive")
  assert(sign(-7) == -1, "sign negative")
  assert(sign(0) == 0, "sign zero")

  assert(wrap(5, 0, 10) == 5, "wrap in range")
  assert(wrap(12, 0, 10) == 2, "wrap over")
  assert(wrap(-3, 0, 10) == 7, "wrap under")

  let rad = deg_to_rad(180.0)
  assert(rad > 3.14 and rad < 3.15, "deg to rad ~pi")

  let deg = rad_to_deg(3.14159265)
  assert(deg > 179.9 and deg < 180.1, "rad to deg ~180")

  let d = distance_2d(0.0, 0.0, 3.0, 4.0)
  assert(d == 5.0, "3-4-5 triangle")

  print("mathfx: all passed")
