import std/time/age

fn main()
    // ── age_years KAT vectors ─────────────────────────────────────────────────

    // Exactly 24 years: birthday reached
    let got1 = age_years(2000, 1, 1, 2024, 1, 1)
    if got1 != 24
        print("FAIL age _age_test age_years #1: got " + str(got1) + " want 24")
        exit(1)

    // 23 years: birthday on Jun 1, now is Jan 1 — not yet reached
    let got2 = age_years(2000, 6, 1, 2024, 1, 1)
    if got2 != 23
        print("FAIL age _age_test age_years #2: got " + str(got2) + " want 23")
        exit(1)

    // Exactly 24 years: birthday Jun 1, now is Jun 1 — reached today
    let got3 = age_years(2000, 6, 1, 2024, 6, 1)
    if got3 != 24
        print("FAIL age _age_test age_years #3: got " + str(got3) + " want 24")
        exit(1)

    // ── age_next_birthday KAT vectors ────────────────────────────────────────

    // Birthday Jun 15, now Jan 1 — next birthday is this year Jun 15
    let nb1 = age_next_birthday(2000, 6, 15, 2024, 1, 1)
    let nb1_y = nb1[0]
    let nb1_m = nb1[1]
    let nb1_d = nb1[2]
    if nb1_y != 2024
        print("FAIL age _age_test next_birthday #1 year: got " + str(nb1_y) + " want 2024")
        exit(1)
    if nb1_m != 6
        print("FAIL age _age_test next_birthday #1 month: got " + str(nb1_m) + " want 6")
        exit(1)
    if nb1_d != 15
        print("FAIL age _age_test next_birthday #1 day: got " + str(nb1_d) + " want 15")
        exit(1)

    // Birthday Jun 15, now Jul 1 — birthday already passed, next is 2025
    let nb2 = age_next_birthday(2000, 6, 15, 2024, 7, 1)
    let nb2_y = nb2[0]
    let nb2_m = nb2[1]
    let nb2_d = nb2[2]
    if nb2_y != 2025
        print("FAIL age _age_test next_birthday #2 year: got " + str(nb2_y) + " want 2025")
        exit(1)
    if nb2_m != 6
        print("FAIL age _age_test next_birthday #2 month: got " + str(nb2_m) + " want 6")
        exit(1)
    if nb2_d != 15
        print("FAIL age _age_test next_birthday #2 day: got " + str(nb2_d) + " want 15")
        exit(1)

    // Round-trip: today IS the birthday
    let nb3 = age_next_birthday(1990, 3, 15, 2024, 3, 15)
    let nb3_y = nb3[0]
    let nb3_m = nb3[1]
    let nb3_d = nb3[2]
    if nb3_y != 2024
        print("FAIL age _age_test next_birthday #3 year: got " + str(nb3_y) + " want 2024")
        exit(1)
    if nb3_m != 3
        print("FAIL age _age_test next_birthday #3 month: got " + str(nb3_m) + " want 3")
        exit(1)
    if nb3_d != 15
        print("FAIL age _age_test next_birthday #3 day: got " + str(nb3_d) + " want 15")
        exit(1)

    // ── age_days_until_birthday KAT vectors ──────────────────────────────────

    // Birthday Jan 1 2025, now Jan 1 2025 — 0 days
    let du1 = age_days_until_birthday(2000, 1, 1, 2025, 1, 1)
    if du1 != 0
        print("FAIL age _age_test days_until #1: got " + str(du1) + " want 0")
        exit(1)

    // Birthday Jun 1, now Jan 1 — 151 days in 2024 (leap year: Jan31+Feb29+Mar31+Apr30+May31=152? let's verify)
    // Jan=31, Feb=29(2024 leap), Mar=31, Apr=30, May=31 → 152 days from Jan1 to Jun1
    let du2 = age_days_until_birthday(2000, 6, 1, 2024, 1, 1)
    if du2 != 152
        print("FAIL age _age_test days_until #2: got " + str(du2) + " want 152")
        exit(1)

    // ── Leap-day birthday handling ────────────────────────────────────────────
    // Born Feb 29, 2000. In 2023 (non-leap), anniversary should be Feb 28.
    let age_leap = age_years(2000, 2, 29, 2023, 2, 28)
    if age_leap != 23
        print("FAIL age _age_test leap_birthday age: got " + str(age_leap) + " want 23")
        exit(1)

    let nb_leap = age_next_birthday(2000, 2, 29, 2023, 2, 1)
    let nb_leap_m = nb_leap[1]
    let nb_leap_d = nb_leap[2]
    if nb_leap_m != 2
        print("FAIL age _age_test leap_bday month: got " + str(nb_leap_m) + " want 2")
        exit(1)
    if nb_leap_d != 28
        print("FAIL age _age_test leap_bday day: got " + str(nb_leap_d) + " want 28")
        exit(1)

    // ── age_zodiac KAT vectors ────────────────────────────────────────────────

    // Gemini: May 21 – Jun 20; Jun 15 = Gemini
    let z1 = age_zodiac(6, 15)
    if z1 != "Gemini"
        print("FAIL age _age_test zodiac #1: got " + z1 + " want Gemini")
        exit(1)

    // Capricorn: Dec 22 – Jan 19; Dec 25 = Capricorn
    let z2 = age_zodiac(12, 25)
    if z2 != "Capricorn"
        print("FAIL age _age_test zodiac #2: got " + z2 + " want Capricorn")
        exit(1)

    // Aries boundary: Mar 21 = Aries, Mar 20 = Pisces
    let z3 = age_zodiac(3, 21)
    if z3 != "Aries"
        print("FAIL age _age_test zodiac #3: got " + z3 + " want Aries")
        exit(1)

    let z4 = age_zodiac(3, 20)
    if z4 != "Pisces"
        print("FAIL age _age_test zodiac #4: got " + z4 + " want Pisces")
        exit(1)

    // Capricorn wrap-around: Jan 15 = Capricorn
    let z5 = age_zodiac(1, 15)
    if z5 != "Capricorn"
        print("FAIL age _age_test zodiac #5: got " + z5 + " want Capricorn")
        exit(1)

    // Aquarius: Jan 20 = Aquarius
    let z6 = age_zodiac(1, 20)
    if z6 != "Aquarius"
        print("FAIL age _age_test zodiac #6: got " + z6 + " want Aquarius")
        exit(1)

    // Pisces: Feb 20 = Pisces
    let z7 = age_zodiac(2, 20)
    if z7 != "Pisces"
        print("FAIL age _age_test zodiac #7: got " + z7 + " want Pisces")
        exit(1)

    // Scorpio: Nov 1 = Scorpio
    let z8 = age_zodiac(11, 1)
    if z8 != "Scorpio"
        print("FAIL age _age_test zodiac #8: got " + z8 + " want Scorpio")
        exit(1)

    // Invalid input
    let z_inv = age_zodiac(0, 1)
    if z_inv != "Unknown"
        print("FAIL age _age_test zodiac invalid: got " + z_inv + " want Unknown")
        exit(1)

    print("PASS _age_test")
