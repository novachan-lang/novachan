import forge_request_logger

fn main()
    let r = rl_new(100)
    r = rl_log(r, "GET", "/api/users", 200, 50)
    r = rl_log(r, "POST", "/api/users", 201, 120)
    r = rl_log(r, "GET", "/api/missing", 404, 30)
    assert(rl_total_count(r) == 3, "3 entries")

    let e = rl_get(r, 0)
    assert(is_ok(e), "get ok")
    assert(unwrap(e) == "GET /api/users 200", "entry 0")

    let bad = rl_get(r, 99)
    assert(is_err(bad), "out of range is err")

    assert(rl_error_rate(r) == 33, "33% error rate")
    assert(rl_avg_duration(r) == 66, "avg 66ms")

    print("REQUEST-LOGGER KAT PASS")
