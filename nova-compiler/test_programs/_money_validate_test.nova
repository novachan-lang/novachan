import std/money/validate
fn _b(l, g, w)
    if g != w
        print("FAIL validate " + l)
        exit(1)
fn main()
    _b("r1", mvalid_range(500, 0, 1000), true)
    _b("r2", mvalid_range(1500, 0, 1000), false)
    _b("p1", mvalid_positive(100), true)
    _b("sc", mvalid_same_currency("USD", "EUR"), false)
    _b("c1", mvalid_cents_in_range(34, 2), true)
    _b("c2", mvalid_cents_in_range(100, 2), false)
    _b("ov", mvalid_no_overflow_mul(1000, 1000, 10000000), true)
    print("PASS _money_validate_test")
