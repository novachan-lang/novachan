import std/interval/interval_partition

// _ip_iv_eq: compare two intervals [lo,hi] by value
fn _ip_iv_eq(a: list, b: list) -> bool
    if len(a) != len(b)
        return false
    if a[0] != b[0]
        return false
    if a[1] != b[1]
        return false
    return true

// _ip_list_eq: compare two lists of intervals (order-sensitive)
fn _ip_list_eq(a: list, b: list) -> bool
    if len(a) != len(b)
        return false
    let i = 0
    while i < len(a)
        if not _ip_iv_eq(a[i], b[i])
            return false
        i = i + 1
    return true

// _ip_flat_eq: compare two flat lists element-by-element
fn _ip_flat_eq(a: list, b: list) -> bool
    if len(a) != len(b)
        return false
    let i = 0
    while i < len(a)
        if a[i] != b[i]
            return false
        i = i + 1
    return true

fn _fail(label: string, msg: string)
    print("FAIL ip_" + label + ": " + msg)
    exit(1)

fn main()
    // KAT 1: ip_endpoints([[1,3],[2,4]]) == [1,2,3,4]
    let ivs1 = []
    let a1 = []
    push(a1, 1)
    push(a1, 3)
    push(ivs1, a1)
    let b1 = []
    push(b1, 2)
    push(b1, 4)
    push(ivs1, b1)
    let eps1 = ip_endpoints(ivs1)
    let want_eps1 = []
    push(want_eps1, 1)
    push(want_eps1, 2)
    push(want_eps1, 3)
    push(want_eps1, 4)
    if not _ip_flat_eq(eps1, want_eps1)
        _fail("endpoints1", "got=" + str(eps1) + " want=[1,2,3,4]")

    // KAT 2: ip_endpoints([[1,3],[2,4]]) length == 4
    if len(eps1) != 4
        _fail("endpoints1_len", "got=" + str(len(eps1)) + " want=4")

    // KAT 3: ip_endpoints([[1,5],[1,5]]) deduplicated == [1,5]
    let ivs3 = []
    let iv3a = []
    push(iv3a, 1)
    push(iv3a, 5)
    push(ivs3, iv3a)
    let iv3b = []
    push(iv3b, 1)
    push(iv3b, 5)
    push(ivs3, iv3b)
    let eps3 = ip_endpoints(ivs3)
    if len(eps3) != 2
        _fail("endpoints_dedup", "got=" + str(eps3) + " want=[1,5]")
    if eps3[0] != 1
        _fail("endpoints_dedup[0]", "got=" + str(eps3[0]))
    if eps3[1] != 5
        _fail("endpoints_dedup[1]", "got=" + str(eps3[1]))

    // KAT 4: ip_atoms([[1,3],[2,4]]) => [[1,2],[2,3],[3,4]]
    let atoms4 = ip_atoms(ivs1)
    if len(atoms4) != 3
        _fail("atoms4_len", "got=" + str(len(atoms4)) + " want=3")
    let exp_atom40 = []
    push(exp_atom40, 1)
    push(exp_atom40, 2)
    let exp_atom41 = []
    push(exp_atom41, 2)
    push(exp_atom41, 3)
    let exp_atom42 = []
    push(exp_atom42, 3)
    push(exp_atom42, 4)
    if not _ip_iv_eq(atoms4[0], exp_atom40)
        _fail("atoms4[0]", "got=" + str(atoms4[0]) + " want=[1,2]")
    if not _ip_iv_eq(atoms4[1], exp_atom41)
        _fail("atoms4[1]", "got=" + str(atoms4[1]) + " want=[2,3]")
    if not _ip_iv_eq(atoms4[2], exp_atom42)
        _fail("atoms4[2]", "got=" + str(atoms4[2]) + " want=[3,4]")

    // KAT 5: ip_max_coverage([[1,3],[2,4],[2,5]]) == 3
    let ivs5 = []
    let iv5a = []
    push(iv5a, 1)
    push(iv5a, 3)
    push(ivs5, iv5a)
    let iv5b = []
    push(iv5b, 2)
    push(iv5b, 4)
    push(ivs5, iv5b)
    let iv5c = []
    push(iv5c, 2)
    push(iv5c, 5)
    push(ivs5, iv5c)
    let cov5 = ip_max_coverage(ivs5)
    if cov5 != 3
        _fail("max_coverage5", "got=" + str(cov5) + " want=3")

    // KAT 6: ip_max_coverage([[1,2],[3,4]]) == 1
    let ivs6 = []
    let iv6a = []
    push(iv6a, 1)
    push(iv6a, 2)
    push(ivs6, iv6a)
    let iv6b = []
    push(iv6b, 3)
    push(iv6b, 4)
    push(ivs6, iv6b)
    let cov6 = ip_max_coverage(ivs6)
    if cov6 != 1
        _fail("max_coverage6", "got=" + str(cov6) + " want=1")

    // KAT 7: ip_layers([[1,4],[2,5],[3,6]]) == 3
    let ivs7 = []
    let iv7a = []
    push(iv7a, 1)
    push(iv7a, 4)
    push(ivs7, iv7a)
    let iv7b = []
    push(iv7b, 2)
    push(iv7b, 5)
    push(ivs7, iv7b)
    let iv7c = []
    push(iv7c, 3)
    push(iv7c, 6)
    push(ivs7, iv7c)
    let layers7 = ip_layers(ivs7)
    if layers7 != 3
        _fail("layers7", "got=" + str(layers7) + " want=3")

    // KAT 8: ip_stab_intervals([[1,3],[2,4],[5,6]], 2) == [[1,3],[2,4]]
    let ivs8 = []
    let iv8a = []
    push(iv8a, 1)
    push(iv8a, 3)
    push(ivs8, iv8a)
    let iv8b = []
    push(iv8b, 2)
    push(iv8b, 4)
    push(ivs8, iv8b)
    let iv8c = []
    push(iv8c, 5)
    push(iv8c, 6)
    push(ivs8, iv8c)
    let stab8 = ip_stab_intervals(ivs8, 2)
    if len(stab8) != 2
        _fail("stab8_len", "got=" + str(len(stab8)) + " want=2")
    if not _ip_iv_eq(stab8[0], iv8a)
        _fail("stab8[0]", "got=" + str(stab8[0]) + " want=[1,3]")
    if not _ip_iv_eq(stab8[1], iv8b)
        _fail("stab8[1]", "got=" + str(stab8[1]) + " want=[2,4]")

    // KAT 9: ip_stab_intervals on endpoint boundary (x=3, [1,3] covers 3)
    let stab9 = ip_stab_intervals(ivs8, 3)
    // [1,3] and [2,4] both cover 3; [5,6] does not
    if len(stab9) != 2
        _fail("stab9_len", "got=" + str(len(stab9)) + " want=2")

    // KAT 10: ip_stab_intervals with x outside all intervals => empty
    let stab10 = ip_stab_intervals(ivs8, 4)
    // only [2,4] covers 4
    if len(stab10) != 1
        _fail("stab10_len", "got=" + str(len(stab10)) + " want=1")

    // KAT 11: ip_atoms empty => []
    let atoms_empty = ip_atoms([])
    if len(atoms_empty) != 0
        _fail("atoms_empty", "got len=" + str(len(atoms_empty)))

    // KAT 12: ip_max_coverage empty => 0
    let cov_empty = ip_max_coverage([])
    if cov_empty != 0
        _fail("cov_empty", "got=" + str(cov_empty))

    // KAT 13: ip_coverage_count([[1,3],[2,4]]) - atom [2,3] has count 2
    let cc13 = ip_coverage_count(ivs1)
    // atoms: [1,2],[2,3],[3,4]
    // [1,2]: covered by [1,3] only => 1
    // [2,3]: covered by [1,3] and [2,4] => 2
    // [3,4]: covered by [2,4] only => 1
    if len(cc13) != 3
        _fail("cc13_len", "got=" + str(len(cc13)) + " want=3")
    let entry_mid = cc13[1]
    let cnt_mid = entry_mid[1]
    if cnt_mid != 2
        _fail("cc13_mid_count", "got=" + str(cnt_mid) + " want=2")

    // KAT 14: ip_refine == ip_atoms
    let ref14 = ip_refine(ivs1)
    if len(ref14) != 3
        _fail("refine14_len", "got=" + str(len(ref14)) + " want=3")

    // KAT 15: ip_partition_points == ip_endpoints
    let pp15 = ip_partition_points(ivs1)
    if not _ip_flat_eq(pp15, want_eps1)
        _fail("partition_points15", "got=" + str(pp15) + " want=[1,2,3,4]")

    print("PASS _interval_partition_test")
