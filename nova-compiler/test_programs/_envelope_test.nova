// KAT test for std/dsp/envelope.nova
//
// Hand-computed reference values:
//   env_abs([1.0,-2.0,3.0,-4.0])          == [1.0,2.0,3.0,4.0]
//   env_abs([0.0,-0.0,5.0])               == [0.0,0.0,5.0]
//   env_peak([1.0,-3.0,2.0,1.0], 2)       == [3.0,3.0,2.0]
//     windows of 2: max(|1|,|-3|)=3, max(|-3|,|2|)=3, max(|2|,|1|)=2
//   env_peak([1.0,2.0,3.0,4.0], 2) length == 3  (4-2+1=3)
//   env_rms([3.0,4.0], 2)                 == [3.5355]
//     sqrt((9+16)/2) = sqrt(12.5) = 3.53553...
//   env_hilbert_approx([0.0,4.0,-2.0])    == [0.0,2.0,2.0]
//     rect=[0.0,4.0,2.0]; EMA alpha=0.5:
//     [0.0, 0.5*4+0.5*0=2.0, 0.5*2+0.5*2=2.0]

import std/dsp/envelope

// ckf: compare two floats within eps 0.001
fn ckf(label: string, got: float, want: float)
    let diff = got - want
    if diff < 0.0
        diff = 0.0 - diff
    if diff > 0.001
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// ckf_list: compare two float lists element-wise within eps 0.001
fn ckf_list(label: string, got: list, want: list)
    let ng = len(got)
    let nw = len(want)
    if ng != nw
        print("FAIL " + label + " length: got " + str(ng) + " want " + str(nw))
        exit(1)
    let i = 0
    while i < nw
        let gv = got[i] * 1.0
        let wv = want[i] * 1.0
        let diff = gv - wv
        if diff < 0.0
            diff = 0.0 - diff
        if diff > 0.001
            print("FAIL " + label + "[" + str(i) + "]: got " + str(gv) + " want " + str(wv))
            exit(1)
        i = i + 1

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // ── KAT 1: env_abs([1.0,-2.0,3.0,-4.0]) == [1.0,2.0,3.0,4.0] ─────────────
    let xs1 = []
    push(xs1, 1.0)
    push(xs1, 0.0 - 2.0)
    push(xs1, 3.0)
    push(xs1, 0.0 - 4.0)
    let want1 = []
    push(want1, 1.0)
    push(want1, 2.0)
    push(want1, 3.0)
    push(want1, 4.0)
    let r1 = env_abs(xs1)
    ckf_list("abs_basic", r1, want1)

    // ── KAT 2: env_abs([0.0,-0.0,5.0]) == [0.0,0.0,5.0] ─────────────────────
    // -0.0 in float is still 0.0; abs returns 0.0
    let xs2 = []
    push(xs2, 0.0)
    push(xs2, 0.0 - 0.0)
    push(xs2, 5.0)
    let want2 = []
    push(want2, 0.0)
    push(want2, 0.0)
    push(want2, 5.0)
    let r2 = env_abs(xs2)
    ckf_list("abs_zeros", r2, want2)

    // ── KAT 3: env_peak([1.0,-3.0,2.0,1.0], 2) == [3.0,3.0,2.0] ────────────
    // windows of width 2 over abs:
    //   [|1|,|-3|] -> max(1,3)=3
    //   [|-3|,|2|] -> max(3,2)=3
    //   [|2|,|1|]  -> max(2,1)=2
    let xs3 = []
    push(xs3, 1.0)
    push(xs3, 0.0 - 3.0)
    push(xs3, 2.0)
    push(xs3, 1.0)
    let want3 = []
    push(want3, 3.0)
    push(want3, 3.0)
    push(want3, 2.0)
    let r3 = env_peak(xs3, 2)
    ckf_list("peak_4_w2", r3, want3)

    // ── KAT 4: len(env_peak([1.0,2.0,3.0,4.0], 2)) == 3 ─────────────────────
    let xs4 = []
    push(xs4, 1.0)
    push(xs4, 2.0)
    push(xs4, 3.0)
    push(xs4, 4.0)
    let r4 = env_peak(xs4, 2)
    cki("peak_len_4_w2", len(r4), 3)

    // ── KAT 5: env_rms([3.0,4.0], 2) == [3.5355] ─────────────────────────────
    // sqrt((3^2+4^2)/2) = sqrt((9+16)/2) = sqrt(25/2) = sqrt(12.5) = 3.53553...
    let xs5 = []
    push(xs5, 3.0)
    push(xs5, 4.0)
    let want5 = []
    push(want5, 3.5355)
    let r5 = env_rms(xs5, 2)
    ckf_list("rms_34_w2", r5, want5)

    // ── KAT 6: env_hilbert_approx([0.0,4.0,-2.0]) == [0.0,2.0,2.0] ──────────
    // rect = [0.0,4.0,2.0]
    // EMA alpha=0.5: [0.0, 0.5*4+0.5*0=2.0, 0.5*2+0.5*2=2.0]
    let xs6 = []
    push(xs6, 0.0)
    push(xs6, 4.0)
    push(xs6, 0.0 - 2.0)
    let want6 = []
    push(want6, 0.0)
    push(want6, 2.0)
    push(want6, 2.0)
    let r6 = env_hilbert_approx(xs6)
    ckf_list("hilbert_basic", r6, want6)

    // ── KAT 7: env_rms single window == |x| ──────────────────────────────────
    // env_rms([-5.0], 1) = sqrt(25/1) = 5.0
    let xs7 = []
    push(xs7, 0.0 - 5.0)
    let r7 = env_rms(xs7, 1)
    cki("rms_single_len", len(r7), 1)
    let v7 = r7[0] * 1.0
    ckf("rms_single_val", v7, 5.0)

    // ── KAT 8: env_peak window=1 == env_abs ──────────────────────────────────
    // env_peak([2.0,-3.0,1.0], 1) = [2.0,3.0,1.0]
    let xs8 = []
    push(xs8, 2.0)
    push(xs8, 0.0 - 3.0)
    push(xs8, 1.0)
    let want8 = []
    push(want8, 2.0)
    push(want8, 3.0)
    push(want8, 1.0)
    let r8 = env_peak(xs8, 1)
    ckf_list("peak_w1_eq_abs", r8, want8)

    // ── KAT 9: env_abs all-positive is identity ───────────────────────────────
    let xs9 = []
    push(xs9, 0.5)
    push(xs9, 1.5)
    push(xs9, 2.5)
    let r9 = env_abs(xs9)
    ckf_list("abs_positive", r9, xs9)

    // ── KAT 10: env_rms([1.0,1.0,1.0], 3) == [1.0] ───────────────────────────
    // sqrt((1+1+1)/3) = sqrt(1) = 1.0
    let xs10 = []
    push(xs10, 1.0)
    push(xs10, 1.0)
    push(xs10, 1.0)
    let r10 = env_rms(xs10, 3)
    cki("rms_ones_len", len(r10), 1)
    let v10 = r10[0] * 1.0
    ckf("rms_ones_val", v10, 1.0)

    print("_envelope_test passed")
