import forge_centroid as ce

fn check(cond: bool, label: str)
    if cond == false
        print("FAIL: " + label)

// Brute-force all-pairs shortest path (edge count) via BFS from each node.
fn brute_count_pairs(n: int, edges: list, k: int) -> int
    // build adjacency
    let adj = []
    let i = 0
    while i < n
        push(adj, [])
        i = i + 1
    let e = 0
    while e < len(edges)
        push(adj[edges[e][0]], edges[e][1])
        push(adj[edges[e][1]], edges[e][0])
        e = e + 1
    let count = 0
    let s = 0
    while s < n
        // BFS distances from s
        let dist = []
        let z = 0
        while z < n
            push(dist, 0 - 1)
            z = z + 1
        dist[s] = 0
        let queue = [s]
        let qi = 0
        while qi < len(queue)
            let node = queue[qi]
            qi = qi + 1
            let nbrs = adj[node]
            let j = 0
            while j < len(nbrs)
                let w = nbrs[j]
                if dist[w] < 0
                    dist[w] = dist[node] + 1
                    push(queue, w)
                j = j + 1
        // count t > s with dist == k
        let t = s + 1
        while t < n
            if dist[t] == k
                count = count + 1
            t = t + 1
        s = s + 1
    return count

// Validate the centroid tree: height O(log n) and it is a valid tree (one root, all reachable).
fn centroid_height(cparent: list) -> int
    let n = len(cparent)
    let maxh = 0
    let i = 0
    while i < n
        let h = 0
        let cur = i
        while cparent[cur] >= 0
            cur = cparent[cur]
            h = h + 1
        if h > maxh
            maxh = h
        i = i + 1
    return maxh

// TEST 1: path graph 0-1-2-3-4
let edges1 = [[0, 1], [1, 2], [2, 3], [3, 4]]
let cp1 = ce.centroid_tree_parent(5, edges1)
// exactly one root (-1)
let roots1 = 0
let i = 0
while i < 5
    if cp1[i] == 0 - 1
        roots1 = roots1 + 1
    i = i + 1
check(roots1 == 1, "path graph centroid tree has 1 root")
// centroid of a 5-path is node 2
check(cp1[2] == 0 - 1, "centroid of 5-path is node 2 (root)")

// TEST 2: count pairs at distance k on path 0-1-2-3-4
// distance 1: (0,1),(1,2),(2,3),(3,4) = 4
check(ce.count_pairs_at_distance(5, edges1, 1) == 4, "path: 4 pairs at dist 1")
// distance 2: (0,2),(1,3),(2,4) = 3
check(ce.count_pairs_at_distance(5, edges1, 2) == 3, "path: 3 pairs at dist 2")
// distance 3: (0,3),(1,4) = 2
check(ce.count_pairs_at_distance(5, edges1, 3) == 2, "path: 2 pairs at dist 3")
// distance 4: (0,4) = 1
check(ce.count_pairs_at_distance(5, edges1, 4) == 1, "path: 1 pair at dist 4")

// TEST 3: star graph (center 0, leaves 1,2,3,4)
let edges2 = [[0, 1], [0, 2], [0, 3], [0, 4]]
// distance 1: 4 (center to each leaf); distance 2: C(4,2)=6 (leaf to leaf)
check(ce.count_pairs_at_distance(5, edges2, 1) == 4, "star: 4 pairs at dist 1")
check(ce.count_pairs_at_distance(5, edges2, 2) == 6, "star: 6 pairs at dist 2")
check(ce.count_pairs_at_distance(5, edges2, 3) == 0, "star: 0 pairs at dist 3")
// centroid of a star is the center 0
let cp2 = ce.centroid_tree_parent(5, edges2)
check(cp2[0] == 0 - 1, "centroid of star is center 0")

// TEST 4: centroid tree height is O(log n) for a path (should be ~log2(n))
check(centroid_height(cp1) <= 3, "path-5 centroid height <= 3")

// TEST 5: DECISIVE brute-force cross-check on random trees for all distances
let ok = true
let seed = 987654
let tc = 0
while tc < 15
    seed = (seed * 1103515245 + 12345) % 2147483648
    let n = seed % 12 + 3  // 3..14 nodes
    // random tree: node i (i>=1) attaches to random earlier node
    let edges = []
    let v = 1
    while v < n
        seed = (seed * 1103515245 + 12345) % 2147483648
        let p = seed % v
        push(edges, [p, v])
        v = v + 1
    // check every distance k from 1 to n-1
    let k = 1
    while k < n
        let exp = brute_count_pairs(n, edges, k)
        let got = ce.count_pairs_at_distance(n, edges, k)
        if exp != got
            ok = false
            print("MISMATCH tc=" + str(tc) + " n=" + str(n) + " k=" + str(k) + " exp=" + str(exp) + " got=" + str(got))
        k = k + 1
    // centroid tree validity: exactly one root, height <= 2*log2(n)+2
    let cp = ce.centroid_tree_parent(n, edges)
    let roots = 0
    let m = 0
    while m < n
        if cp[m] == 0 - 1
            roots = roots + 1
        m = m + 1
    if roots != 1
        ok = false
        print("BAD ROOT COUNT tc=" + str(tc) + " roots=" + str(roots))
    tc = tc + 1
check(ok, "DECISIVE: count_pairs_at_distance matches brute for ALL k over 15 random trees; centroid tree valid")

print("forge_centroid: KAT done")
