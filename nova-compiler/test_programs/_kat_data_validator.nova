import forge_data_validator

fn main()
    let s = dqv_new()
    assert(dqv_rule_count(s) == 0, "no rules yet")
    assert(dqv_field_count(s) == 0, "no fields yet")

    s = dqv_add_rule(s, "age", "required", "")
    s = dqv_add_rule(s, "age", "min", "18")
    s = dqv_add_rule(s, "age", "max", "120")
    s = dqv_add_rule(s, "role", "enum", "admin|editor|viewer")
    s = dqv_add_rule(s, "email", "pattern", "@")
    assert(dqv_rule_count(s) == 5, "5 rules")
    assert(dqv_field_count(s) == 3, "3 fields")

    let r1 = dqv_validate(s, "age", "25")
    assert(is_ok(r1), "age 25 valid")
    assert(unwrap(r1) == "valid", "valid message")

    let r2 = dqv_validate(s, "age", "5")
    assert(is_err(r2), "age 5 below minimum")

    let r3 = dqv_validate(s, "age", "999")
    assert(is_err(r3), "age 999 above maximum")

    let r4 = dqv_validate(s, "age", "")
    assert(is_err(r4), "age empty is required")

    let r5 = dqv_validate(s, "role", "editor")
    assert(is_ok(r5), "role editor valid")

    let r6 = dqv_validate(s, "role", "superuser")
    assert(is_err(r6), "role superuser not allowed")

    let r7 = dqv_validate(s, "email", "alice@example.com")
    assert(is_ok(r7), "email with @ valid")

    let r8 = dqv_validate(s, "email", "not-an-email")
    assert(is_err(r8), "email without @ invalid")

    let r9 = dqv_validate(s, "unconstrained_field", "anything")
    assert(is_ok(r9), "field with no rules always passes")

    assert(dqv_pass_count(s) == 4, "4 passes so far")
    assert(dqv_fail_count(s) == 5, "5 fails so far")

    let rate = dqv_pass_rate(s)
    assert(is_ok(rate), "pass rate ok")
    assert(unwrap(rate) == 44, "44 percent pass rate")

    let sall = dqv_new()
    sall = dqv_add_rule(sall, "name", "required", "")
    sall = dqv_add_rule(sall, "age", "min", "0")
    let all_ok = dqv_validate_all(sall, "name=Bob,age=30")
    assert(is_ok(all_ok), "batch all valid")

    let all_bad = dqv_validate_all(sall, "name=,age=30")
    assert(is_err(all_bad), "batch catches missing required field")

    // ---- added by the adversarial verification pass, 2026-08-05 ----
    // Up to here this KAT covered ONLY the pre-raise API: it never touched dqv_rule_types,
    // dqv_is_rule_type or dqv_add_rule_checked, so the entire raise was ungated.

    // The dispatch table is the SINGLE AUTHORITY for the rule-type set. Pin the set and its ORDER --
    // the order is embedded in the error message dqv_add_rule_checked shows a caller, and the table is
    // rebuilt on every call, so a nondeterministic keys() would make that message flap.
    assert(join(dqv_rule_types(), "|") == "required|min|max|pattern|enum", "the published rule-type set and order")
    assert(len(dqv_rule_types()) == 5, "5 rule types")
    assert(join(dqv_rule_types(), "|") == join(dqv_rule_types(), "|"), "rule-type order is stable across calls")

    // is_rule_type must agree with the table in both directions
    assert(all_match(dqv_rule_types(), (t) => dqv_is_rule_type(t)), "every published type is a rule type")
    assert(not dqv_is_rule_type("minimum"), "a typo is not a rule type")
    assert(not dqv_is_rule_type(""), "the empty string is not a rule type")
    assert(not dqv_is_rule_type("MIN"), "rule types are case-sensitive")
    assert(not dqv_is_rule_type("NoRule"), "the fallback ADT arm is not a public rule type")

    // AUTHORITY, the part that matters: every name the table publishes must map to a rule that can
    // actually REJECT something. A name accepted by dqv_is_rule_type whose ADT arm is missing from
    // _dqv_check would pass everything -- the same silent hole the raise closed, just relocated.
    assert(is_err(dqv_validate(dqv_add_rule(dqv_new(), "f", "required", ""), "f", "")), "required can reject")
    assert(is_err(dqv_validate(dqv_add_rule(dqv_new(), "f", "min", "5"), "f", "4")), "min can reject")
    assert(is_err(dqv_validate(dqv_add_rule(dqv_new(), "f", "max", "5"), "f", "6")), "max can reject")
    assert(is_err(dqv_validate(dqv_add_rule(dqv_new(), "f", "pattern", "zz"), "f", "ab")), "pattern can reject")
    assert(is_err(dqv_validate(dqv_add_rule(dqv_new(), "f", "enum", "a|b"), "f", "c")), "enum can reject")

    // THE STRICT DOOR. dqv_add_rule_checked must refuse a typo -- the permissive dqv_add_rule accepts
    // it, registers a rule that constrains nothing, and then reports the field as passing forever.
    let strict = dqv_new()
    let typo = dqv_add_rule_checked(strict, "age", "minimum", "18")
    assert(is_err(typo), "the strict door refuses an unknown rule type")
    assert(unwrap_err(typo) == "unknown rule type 'minimum' (expected one of: required, min, max, pattern, enum)", "the refusal names the legal set")
    assert(is_err(dqv_add_rule_checked(strict, "age", "", "18")), "empty rule type refused")
    assert(is_err(dqv_add_rule_checked(strict, "age", "MIN", "18")), "wrong case refused")
    // a REFUSED registration must not have mutated the validator
    assert(dqv_rule_count(strict) == 0, "a refused rule is not registered")
    assert(dqv_field_count(strict) == 0, "a refused rule does not bind its field")
    // and the accepted path must register exactly one rule that really constrains
    let good = dqv_add_rule_checked(dqv_new(), "age", "min", "18")
    assert(is_ok(good), "a legal rule type is accepted")
    let gs = unwrap(good)
    assert(dqv_rule_count(gs) == 1, "the accepted rule is registered")
    assert(dqv_field_count(gs) == 1, "the accepted rule binds its field")
    assert(is_err(dqv_validate(gs, "age", "17")), "the accepted rule actually constrains")
    assert(is_ok(dqv_validate(gs, "age", "18")), "the accepted rule passes at the boundary")

    // the PERMISSIVE contract is deliberately preserved -- pin it so it cannot drift silently either
    let perm = dqv_add_rule(dqv_new(), "age", "minimum", "18")
    assert(dqv_rule_count(perm) == 1, "permissive add still registers an unknown type")
    assert(is_ok(dqv_validate(perm, "age", "1")), "an unknown rule type imposes no constraint")

    print("DATA-VALIDATOR KAT PASS")
