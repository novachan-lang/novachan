// ══════════════════════════════════════════════════════════════════════════════
// linalg — dense linear algebra for NOVA (numeric/AI spine, full-parity item)
//
// Complements matrixx (basic int matrix add/mul/transpose) and stats (1-D), adding
// the linear-system machinery ML needs: solve, determinant, inverse, least squares.
//
// Representation: a matrix is a row-major list of rows (each a list); a vector is a
// list. EVERYTHING MUST BE FLOAT. NOVA's `/` is integer division on int operands
// (5/2 == 2), which would silently corrupt Gaussian elimination — so callers pass
// float matrices (e.g. [[2.0, 1.0], [1.0, 3.0]]). Inner rows alias when fetched, so
// solve/inverse/determinant deep-copy their inputs and never mutate the arguments.
//
// v1 is correctness-first (partial-pivot Gaussian elimination / Gauss-Jordan, O(n^3),
// the textbook-stable choice). Blocked-/SIMD-/double[] kernels are the Stage-4 perf
// endgame and change the representation, not this API.
// ══════════════════════════════════════════════════════════════════════════════

fn _abs(x: float) -> float
    if x < 0.0
        return 0.0 - x
    x

fn _row_copy(r: list) -> list
    let out = []
    for x in r
        push(out, x)
    out

fn mat_copy(m: list) -> list
    let out = []
    for r in m
        push(out, _row_copy(r))
    out

fn mat_nrows(m: list) -> int
    len(m)

fn mat_ncols(m: list) -> int
    if len(m) == 0
        return 0
    len(m[0])

// ── Vector ops ─────────────────────────────────────────────────────────────────

fn vec_dot(a: list, b: list) -> float
    let s = 0.0
    let i = 0
    while i < len(a)
        s = s + a[i] * b[i]
        i = i + 1
    s

fn vec_norm(a: list) -> float
    sqrt(vec_dot(a, a))

fn vec_scale(a: list, s: float) -> list
    let out = []
    for x in a
        push(out, x * s)
    out

fn vec_add(a: list, b: list) -> list
    let out = []
    let i = 0
    while i < len(a)
        push(out, a[i] + b[i])
        i = i + 1
    out

fn vec_sub(a: list, b: list) -> list
    let out = []
    let i = 0
    while i < len(a)
        push(out, a[i] - b[i])
        i = i + 1
    out

// ── Matrix ops ───────────────────────────────────────────────────────────────

fn mat_identity(n: int) -> list
    let out = []
    let i = 0
    while i < n
        let row = []
        let j = 0
        while j < n
            if i == j
                push(row, 1.0)
            else
                push(row, 0.0)
            j = j + 1
        push(out, row)
        i = i + 1
    out

fn mat_transpose(m: list) -> list
    let r = mat_nrows(m)
    let c = mat_ncols(m)
    let out = []
    let j = 0
    while j < c
        let row = []
        let i = 0
        while i < r
            push(row, m[i][j])
            i = i + 1
        push(out, row)
        j = j + 1
    out

fn mat_matmul(a: list, b: list) -> list
    let ar = mat_nrows(a)
    let ac = mat_ncols(a)
    let bc = mat_ncols(b)
    let out = []
    let i = 0
    while i < ar
        let row = []
        let j = 0
        while j < bc
            let s = 0.0
            let k = 0
            while k < ac
                s = s + a[i][k] * b[k][j]
                k = k + 1
            push(row, s)
            j = j + 1
        push(out, row)
        i = i + 1
    out

fn mat_vec(m: list, v: list) -> list
    let out = []
    for row in m
        push(out, vec_dot(row, v))
    out

fn mat_scale(m: list, s: float) -> list
    let out = []
    for row in m
        push(out, vec_scale(row, s))
    out

// ── Solve / determinant / inverse (partial-pivot elimination) ──────────────────

// Solve A x = b for x. Returns [] if A is singular. A is square (n x n), b length n.
fn solve(a_in: list, b_in: list) -> list
    let n = mat_nrows(a_in)
    let a = mat_copy(a_in)
    let b = _row_copy(b_in)
    let i = 0
    while i < n
        let piv = i
        let best = _abs(a[i][i])
        let r = i + 1
        while r < n
            let av = _abs(a[r][i])
            if av > best
                best = av
                piv = r
            r = r + 1
        if best < 0.000000000001
            return []
        if piv != i
            let trow = a[i]
            a[i] = a[piv]
            a[piv] = trow
            let tb = b[i]
            b[i] = b[piv]
            b[piv] = tb
        let rr = i + 1
        while rr < n
            let factor = a[rr][i] / a[i][i]
            let c = i
            while c < n
                a[rr][c] = a[rr][c] - factor * a[i][c]
                c = c + 1
            b[rr] = b[rr] - factor * b[i]
            rr = rr + 1
        i = i + 1
    let x = []
    let k = 0
    while k < n
        push(x, 0.0)
        k = k + 1
    let row = n - 1
    while row >= 0
        let s = b[row]
        let col = row + 1
        while col < n
            s = s - a[row][col] * x[col]
            col = col + 1
        x[row] = s / a[row][row]
        row = row - 1
    x

fn determinant(a_in: list) -> float
    let n = mat_nrows(a_in)
    let a = mat_copy(a_in)
    let det = 1.0
    let i = 0
    while i < n
        let piv = i
        let best = _abs(a[i][i])
        let r = i + 1
        while r < n
            let av = _abs(a[r][i])
            if av > best
                best = av
                piv = r
            r = r + 1
        if best < 0.000000000001
            return 0.0
        if piv != i
            let trow = a[i]
            a[i] = a[piv]
            a[piv] = trow
            det = 0.0 - det
        det = det * a[i][i]
        let rr = i + 1
        while rr < n
            let factor = a[rr][i] / a[i][i]
            let c = i
            while c < n
                a[rr][c] = a[rr][c] - factor * a[i][c]
                c = c + 1
            rr = rr + 1
        i = i + 1
    det

// Inverse via Gauss-Jordan on [A | I]. Returns [] if A is singular.
fn inverse(a_in: list) -> list
    let n = mat_nrows(a_in)
    let m = []
    let i = 0
    while i < n
        let row = _row_copy(a_in[i])
        let j = 0
        while j < n
            if j == i
                push(row, 1.0)
            else
                push(row, 0.0)
            j = j + 1
        push(m, row)
        i = i + 1
    let w = 2 * n
    let col = 0
    while col < n
        let piv = col
        let best = _abs(m[col][col])
        let r = col + 1
        while r < n
            let av = _abs(m[r][col])
            if av > best
                best = av
                piv = r
            r = r + 1
        if best < 0.000000000001
            return []
        if piv != col
            let trow = m[col]
            m[col] = m[piv]
            m[piv] = trow
        let pivval = m[col][col]
        let c = 0
        while c < w
            m[col][c] = m[col][c] / pivval
            c = c + 1
        let rr = 0
        while rr < n
            if rr != col
                let factor = m[rr][col]
                let cc = 0
                while cc < w
                    m[rr][cc] = m[rr][cc] - factor * m[col][cc]
                    cc = cc + 1
            rr = rr + 1
        col = col + 1
    let inv = []
    let ii = 0
    while ii < n
        let row = []
        let jj = n
        while jj < w
            push(row, m[ii][jj])
            jj = jj + 1
        push(inv, row)
        ii = ii + 1
    inv

// Least squares: minimize ||A x - b|| via the normal equations (A^T A) x = A^T b.
fn lstsq(a: list, b: list) -> list
    let at = mat_transpose(a)
    let ata = mat_matmul(at, a)
    let atb = mat_vec(at, b)
    solve(ata, atb)

fn main()
    let a = [[1.0, 0.0], [0.0, 1.0]]
    let b = [3.0, 7.0]
    let x = solve(a, b)
    assert(len(x) == 2, "solve length")
    assert(x[0] == 3.0, "solve x0")
    assert(x[1] == 7.0, "solve x1")
    print("linalg: passed")
