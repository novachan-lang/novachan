import forge_polyline

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn near(a: float, b: float) -> bool
    let d = a - b
    d > -0.00002 and d < 0.00002

fn main()
    let fails = 0
    let canonical = "_p~iF~ps|U_ulLnnqC_mqNvxq`@"

    // ENCODE the canonical Google example
    let pts = [[38.5, -120.2], [40.7, -120.95], [43.252, -126.453]]
    fails = fails + expect("encode_canonical", polyline_encode(pts), canonical)

    // DECODE it back to coordinates
    let dec = polyline_decode(canonical)
    fails = fails + expect("decode_count", str(len(dec)), "3")
    fails = fails + expect_true("dec_lat0", near(dec[0][0], 38.5))
    fails = fails + expect_true("dec_lng0", near(dec[0][1], -120.2))
    fails = fails + expect_true("dec_lat1", near(dec[1][0], 40.7))
    fails = fails + expect_true("dec_lng1", near(dec[1][1], -120.95))
    fails = fails + expect_true("dec_lat2", near(dec[2][0], 43.252))
    fails = fails + expect_true("dec_lng2", near(dec[2][1], -126.453))

    // ROUNDTRIP: encode(decode(x)) == x
    fails = fails + expect("roundtrip", polyline_encode(polyline_decode(canonical)), canonical)

    // single point
    let one = polyline_encode([[38.5, -120.2]])
    let oneDec = polyline_decode(one)
    fails = fails + expect_true("single_lat", near(oneDec[0][0], 38.5))
    fails = fails + expect_true("single_lng", near(oneDec[0][1], -120.2))

    // empty
    fails = fails + expect("empty_enc", polyline_encode([]), "")
    fails = fails + expect("empty_dec", str(len(polyline_decode(""))), "0")

    // a small near-origin track roundtrips
    let track = [[0.0, 0.0], [0.001, 0.001], [0.002, -0.001]]
    fails = fails + expect("track_roundtrip", polyline_encode(polyline_decode(polyline_encode(track))), polyline_encode(track))

    if fails == 0
        print("forge_polyline: all passed")
    else
        print("forge_polyline: " + str(fails) + " FAILED")
