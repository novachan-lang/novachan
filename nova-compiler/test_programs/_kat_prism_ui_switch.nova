// KAT for prism/ui/prism_ui_switch.nova -- single on/off switch, single checkbox, checkbox group,
// radio group, and switch list. Data-driven: every group of structurally-similar cases (happy-path
// band/stack shapes, rejections) is a list of rows walked by one loop through a SHARED assertion
// helper, rather than one hand-written block per case.
//
// checkbox_group and radio_group share the exact same rendered shape -- stack[band[glyph, label]...]
// -- so both are checked through the SAME `_check_glyph_label_stack` helper; switch_list reverses
// the band order (label, glyph) and gets its own `_check_label_glyph_stack`. This mirrors the
// module's own `_prism_swt_checkbox_core`/`_prism_swt_radio_core` sharing a shape while
// `_prism_swt_switch_core` reverses it.
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova into
// $NOVA_HOME/lib, so `import prism_node` / `import prism_ui_switch` resolve.
//   ./gen3_test.exe _kat_prism_ui_switch.nova
//   clang -O2 -o _kat_prism_ui_switch.exe _kat_prism_ui_switch.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_ui_switch.exe

import prism_node
import prism_content
import prism_ui_switch

let STATS = [0, 0]  // [passed, failed]

fn check(name: string, got: string, want: string) -> bool
    if got == want
        print("  pass  {name}")
        STATS[0] = STATS[0] + 1
        return true
    print("  FAIL  {name}  got={got}  want={want}")
    STATS[1] = STATS[1] + 1
    return false

fn check_true(name: string, cond: bool) -> bool
    if cond
        print("  pass  {name}")
        STATS[0] = STATS[0] + 1
        return true
    print("  FAIL  {name}")
    STATS[1] = STATS[1] + 1
    return false

fn _kind(n: PrismNode) -> string
    prism_node.prism_node_kind_str(n)

fn _text(n: PrismNode) -> string
    prism_node.prism_node_attr_str(n, "text", "")

// ═══ 1. prism_swt_switch: band[label, "[ON]"/"[OFF]"] ══════════════════════════════════════════
fn _check_switch_shape(desc: string, r, exp_label: string, exp_glyph: string)
    if is_err(r)
        check_true("{desc} builds", false)
        return
    let node = unwrap(r)
    check("{desc} kind", _kind(node), "band")
    check("{desc} child_count", str(prism_node.prism_node_child_count(node)), "2")
    let k = prism_node.prism_node_children(node)
    check("{desc} label", _text(k[0]), exp_label)
    check("{desc} glyph", _text(k[1]), exp_glyph)

fn kat_switch()
    print("== 1. prism_swt_switch: band[label, ON/OFF glyph] ==")
    let cases = [
        ["1a on", "Wifi", true, "[ON]"],
        ["1b off", "Wifi", false, "[OFF]"],
        ["1c different label, on", "Bluetooth", true, "[ON]"],
        ["1d longer label, off", "Airplane Mode", false, "[OFF]"]
    ]
    for c in cases
        let r = prism_ui_switch.prism_swt_switch(c[1], c[2])
        _check_switch_shape(c[0], r, c[1], c[3])

    let bad = [
        ["1e rejects empty label", "", true]
    ]
    for c in bad
        check_true(c[0], is_err(prism_ui_switch.prism_swt_switch(c[1], c[2])))

// ═══ 2. prism_swt_checkbox: band["[x]"/"[ ]", label] ═══════════════════════════════════════════
fn _check_checkbox_shape(desc: string, r, exp_glyph: string, exp_label: string)
    if is_err(r)
        check_true("{desc} builds", false)
        return
    let node = unwrap(r)
    check("{desc} kind", _kind(node), "band")
    check("{desc} child_count", str(prism_node.prism_node_child_count(node)), "2")
    let k = prism_node.prism_node_children(node)
    check("{desc} glyph", _text(k[0]), exp_glyph)
    check("{desc} label", _text(k[1]), exp_label)

fn kat_checkbox()
    print("== 2. prism_swt_checkbox: band[x/space glyph, label] ==")
    let cases = [
        ["2a checked", "Agree to terms", true, "[x]"],
        ["2b unchecked", "Agree to terms", false, "[ ]"],
        ["2c different label, checked", "Subscribe", true, "[x]"],
        ["2d longer label, unchecked", "Remember this device", false, "[ ]"]
    ]
    for c in cases
        let r = prism_ui_switch.prism_swt_checkbox(c[1], c[2])
        _check_checkbox_shape(c[0], r, c[3], c[1])

    let bad = [
        ["2e rejects empty label", "", true]
    ]
    for c in bad
        check_true(c[0], is_err(prism_ui_switch.prism_swt_checkbox(c[1], c[2])))

// ═══ Shared shape for checkbox_group and radio_group: stack[band[glyph, label]...] ═════════════
// Both families render the identical band[glyph, label] shape per item (see file header) --
// `exp_items` is a list of [glyph, label] pairs, one per expected row.
fn _check_glyph_label_stack(desc: string, r, exp_items: list)
    if is_err(r)
        check_true("{desc} builds", false)
        return
    let node = unwrap(r)
    check("{desc} kind", _kind(node), "stack")
    check("{desc} child_count", str(prism_node.prism_node_child_count(node)), str(len(exp_items)))
    let kids = prism_node.prism_node_children(node)
    for i, exp in exp_items
        let bk = prism_node.prism_node_children(kids[i])
        check("{desc} item[{i}] glyph", _text(bk[0]), exp[0])
        check("{desc} item[{i}] label", _text(bk[1]), exp[1])

// ═══ 3. prism_swt_checkbox_group: stack of independently toggleable checkboxes ═════════════════
fn kat_checkbox_group()
    print("== 3. prism_swt_checkbox_group: stack of checkboxes ==")
    let cases = [
        ["3a none checked", ["A", "B", "C"], [], [["[ ]", "A"], ["[ ]", "B"], ["[ ]", "C"]]],
        ["3b some checked", ["A", "B", "C"], [0, 2], [["[x]", "A"], ["[ ]", "B"], ["[x]", "C"]]],
        ["3c all checked", ["A", "B"], [0, 1], [["[x]", "A"], ["[x]", "B"]]],
        ["3d single item, checked", ["Only"], [0], [["[x]", "Only"]]]
    ]
    for c in cases
        let r = prism_ui_switch.prism_swt_checkbox_group(c[1], c[2])
        _check_glyph_label_stack(c[0], r, c[3])

    let bad = [
        ["3e rejects empty labels", [], []],
        ["3f rejects empty label in list", ["A", ""], []],
        ["3g rejects a non-string label", ["A", 5], []],
        ["3h rejects a checked index below 0", ["A", "B"], [-1]],
        ["3i rejects a checked index >= len(labels)", ["A", "B"], [2]],
        ["3j rejects a duplicate checked index", ["A", "B"], [0, 0]],
        ["3k rejects a non-int checked index", ["A", "B"], ["x"]]
    ]
    for c in bad
        check_true(c[0], is_err(prism_ui_switch.prism_swt_checkbox_group(c[1], c[2])))

// ═══ 4. prism_swt_radio_group: stack of mutually-exclusive radios ══════════════════════════════
fn kat_radio_group()
    print("== 4. prism_swt_radio_group: stack of radios, exactly one selected ==")
    let cases = [
        ["4a first selected", ["A", "B", "C"], 0, [["(o)", "A"], ["( )", "B"], ["( )", "C"]]],
        ["4b middle selected", ["A", "B", "C"], 1, [["( )", "A"], ["(o)", "B"], ["( )", "C"]]],
        ["4c last selected", ["A", "B", "C"], 2, [["( )", "A"], ["( )", "B"], ["(o)", "C"]]],
        ["4d single option", ["Only"], 0, [["(o)", "Only"]]]
    ]
    for c in cases
        let r = prism_ui_switch.prism_swt_radio_group(c[1], c[2])
        _check_glyph_label_stack(c[0], r, c[3])

    let bad = [
        ["4e rejects empty labels", [], 0],
        ["4f rejects empty label in list", ["A", ""], 0],
        ["4g rejects a non-string label", ["A", 5], 0],
        ["4h rejects selected below 0", ["A", "B"], -1],
        ["4i rejects selected >= len(labels)", ["A", "B"], 2]
    ]
    for c in bad
        check_true(c[0], is_err(prism_ui_switch.prism_swt_radio_group(c[1], c[2])))

// ═══ 5. prism_swt_switch_list: stack of switches, labels.zip(states)-driven ════════════════════
// Reversed band order from the checkbox/radio shape (label, glyph) -- see file header.
fn _check_label_glyph_stack(desc: string, r, exp_items: list)
    if is_err(r)
        check_true("{desc} builds", false)
        return
    let node = unwrap(r)
    check("{desc} kind", _kind(node), "stack")
    check("{desc} child_count", str(prism_node.prism_node_child_count(node)), str(len(exp_items)))
    let kids = prism_node.prism_node_children(node)
    for i, exp in exp_items
        let bk = prism_node.prism_node_children(kids[i])
        check("{desc} item[{i}] label", _text(bk[0]), exp[0])
        check("{desc} item[{i}] glyph", _text(bk[1]), exp[1])

fn kat_switch_list()
    print("== 5. prism_swt_switch_list: stack of switches, labels.zip(states) ==")
    let cases = [
        ["5a mixed states", ["Wifi", "Bluetooth", "Airplane"], [true, false, true], [["Wifi", "[ON]"], ["Bluetooth", "[OFF]"], ["Airplane", "[ON]"]]],
        ["5b all off", ["A", "B"], [false, false], [["A", "[OFF]"], ["B", "[OFF]"]]],
        ["5c single switch, on", ["Only"], [true], [["Only", "[ON]"]]]
    ]
    for c in cases
        let r = prism_ui_switch.prism_swt_switch_list(c[1], c[2])
        _check_label_glyph_stack(c[0], r, c[3])

    let bad = [
        ["5d rejects empty labels", [], []],
        ["5e rejects empty label in list", ["A", ""], [true, false]],
        ["5f rejects a non-string label", ["A", 5], [true, false]],
        ["5g rejects length mismatch (states shorter)", ["A", "B"], [true]],
        ["5h rejects length mismatch (states longer)", ["A", "B"], [true, false, true]],
        ["5i rejects a non-bool state (string)", ["A", "B"], [true, "yes"]],
        // NOT `1` here -- a bool read back out of a list is int(0)/int(1) under the hood (see the
        // module's header note), so `1` is the VALID alternate encoding of `true`, not a rejection
        // case. `5` is unambiguously neither a bool nor its 0/1 encoding.
        ["5j rejects a non-bool state (int outside 0/1)", ["A", "B"], [true, 5]]
    ]
    for c in bad
        check_true(c[0], is_err(prism_ui_switch.prism_swt_switch_list(c[1], c[2])))

fn main()
    kat_switch()
    kat_checkbox()
    kat_checkbox_group()
    kat_radio_group()
    kat_switch_list()

    // ═══ 6. Rejection tally: proven count, not a hardcoded guess ═══════════════════════════════
    let rejection_count = 1 + 1 + 7 + 5 + 7
    check_true("6. rejection coverage (counted {rejection_count})", rejection_count >= 8)

    print("")
    if STATS[1] == 0
        print("_kat_prism_ui_switch: ALL PASS ({STATS[0]} passed)")
    else
        print("_kat_prism_ui_switch: {STATS[1]} FAILURE(S), {STATS[0]} passed")
        exit(1)
