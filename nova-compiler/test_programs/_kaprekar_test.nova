// _kaprekar_test.nova — KAT for std/math/kaprekar
//
// Hand-traced KAT vectors:
//
//   kap_is(1)  = true   (conventional exception: 1*1=1, special-cased)
//   kap_is(9)  = true   9^2=81  d=1 pw=10  right=1 left=8   8+1=9
//   kap_is(45) = true   45^2=2025 d=2 pw=100 right=25 left=20  20+25=45
//   kap_is(55) = true   55^2=3025 d=2 pw=100 right=25 left=30  30+25=55
//   kap_is(99) = true   99^2=9801 d=2 pw=100 right=1  left=98  98+1=99
//   kap_is(297)= true   297^2=88209 d=3 pw=1000 right=209 left=88  88+209=297
//   kap_is(10) = false  10^2=100  d=2 pw=100 right=0  (right==0 disqualifies)
//
//   kap_routine_6174(3524):
//     iter1: digits=[2,3,4,5] desc=5432 asc=2345  diff=3087
//     iter2: digits=[0,3,7,8] desc=8730 asc=0378=378 diff=8352
//     iter3: digits=[2,3,5,8] desc=8532 asc=2358  diff=6174  -> 3 iters
//
//   kap_upto(100): list contains 45 (verified above) and 55 (verified above)

import std/math/kaprekar

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got " + gs + " want " + ws)
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // --- kap_is: true cases ---
    ckb("kap_is(1)",   kap_is(1),   true)    // conventional exception
    ckb("kap_is(9)",   kap_is(9),   true)    // 81 -> 8+1=9
    ckb("kap_is(45)",  kap_is(45),  true)    // 2025 -> 20+25=45
    ckb("kap_is(297)", kap_is(297), true)    // 88209 -> 88+209=297
    ckb("kap_is(99)",  kap_is(99),  true)    // 9801 -> 98+01=99

    // --- kap_is: false cases ---
    ckb("kap_is(10)",  kap_is(10),  false)   // right=0 disqualifies

    // --- kap_is: 55 (will also appear in kap_upto) ---
    ckb("kap_is(55)",  kap_is(55),  true)    // 3025 -> 30+25=55

    // --- kap_is: extra boundary checks ---
    ckb("kap_is(0)",   kap_is(0),   false)   // n<=0 always false
    ckb("kap_is(2)",   kap_is(2),   false)   // 4 -> right=4 left=0 (left==0 disqualifies)
    ckb("kap_is(3)",   kap_is(3),   false)   // 9 -> right=9 left=0 (left==0 disqualifies)

    // --- kap_routine_6174 ---
    let r3524 = kap_routine_6174(3524)
    // must be 3 (hand-traced) and in range [0,7]
    cki("kap_routine_6174(3524)", r3524, 3)

    // 6174 itself is already the fixed point: 0 iterations
    cki("kap_routine_6174(6174)", kap_routine_6174(6174), 0)

    // repdigit -> -1
    cki("kap_routine_6174(1111)", kap_routine_6174(1111), -1)
    cki("kap_routine_6174(9999)", kap_routine_6174(9999), -1)

    // another known: 1234 -> 5 steps (OEIS / Kaprekar routine table)
    // hand-trace:
    //   [1,2,3,4] desc=4321 asc=1234 diff=3087  iter1
    //   [0,3,7,8] desc=8730 asc=0378=378 diff=8352  iter2
    //   [2,3,5,8] desc=8532 asc=2358 diff=6174  iter3
    // -> 3 steps
    cki("kap_routine_6174(1234)", kap_routine_6174(1234), 3)

    // --- kap_upto(100) ---
    let list100 = kap_upto(100)
    // list must contain 45
    let found45 = false
    let i45 = 0
    while i45 < len(list100)
        if list100[i45] == 45
            found45 = true
        i45 = i45 + 1
    ckb("kap_upto(100) contains 45", found45, true)

    // list must contain 55
    let found55 = false
    let i55 = 0
    while i55 < len(list100)
        if list100[i55] == 55
            found55 = true
        i55 = i55 + 1
    ckb("kap_upto(100) contains 55", found55, true)

    // list must also contain 1, 9, 99
    let found1 = false
    let i1 = 0
    while i1 < len(list100)
        if list100[i1] == 1
            found1 = true
        i1 = i1 + 1
    ckb("kap_upto(100) contains 1", found1, true)

    let found9 = false
    let i9 = 0
    while i9 < len(list100)
        if list100[i9] == 9
            found9 = true
        i9 = i9 + 1
    ckb("kap_upto(100) contains 9", found9, true)

    // 10 must NOT be in the list
    let found10 = false
    let i10 = 0
    while i10 < len(list100)
        if list100[i10] == 10
            found10 = true
        i10 = i10 + 1
    ckb("kap_upto(100) does not contain 10", found10, false)

    print("_kaprekar_test passed")
