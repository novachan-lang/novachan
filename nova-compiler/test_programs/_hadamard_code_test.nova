import std/coding/hadamard_code

fn cki(label, got, want)
    if got != want
        print("FAIL hadamard_code " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    if got != want
        let gs = "false"
        let ws = "false"
        if got
            gs = "true"
        if want
            ws = "true"
        print("FAIL hadamard_code " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn list_eq(a, b) -> bool
    let na = len(a)
    let nb = len(b)
    if na != nb
        return false
    let i = 0
    while i < na
        if a[i] != b[i]
            return false
        i = i + 1
    true

fn ckl(label, got, want)
    if not list_eq(got, want)
        print("FAIL hadamard_code " + label + ": lists differ")
        exit(1)

fn main()
    // KAT 1: block length
    cki("hc_length_3", hc_length(3), 8)
    cki("hc_length_2", hc_length(2), 4)
    cki("hc_length_1", hc_length(1), 2)

    // KAT 2: minimum distance
    cki("hc_min_distance_3", hc_min_distance(3), 4)
    cki("hc_min_distance_2", hc_min_distance(2), 2)

    // KAT 3: hc_bit — parity of popcount(i AND j)
    // hc_bit(3, 5): 3 & 5 = 1, popcount(1)=1, parity=1
    cki("hc_bit_3_5", hc_bit(3, 5), 1)
    // hc_bit(0, 7): 0 & 7 = 0, popcount(0)=0, parity=0
    cki("hc_bit_0_7", hc_bit(0, 7), 0)
    // hc_bit(6, 5): 6 & 5 = 4, popcount(4)=1, parity=1
    cki("hc_bit_6_5", hc_bit(6, 5), 1)
    // hc_bit(7, 7): 7 & 7 = 7 = 0b111, popcount=3, parity=1
    cki("hc_bit_7_7", hc_bit(7, 7), 1)
    // hc_bit(6, 6): 6 & 6 = 6 = 0b110, popcount=2, parity=0
    cki("hc_bit_6_6", hc_bit(6, 6), 0)

    // KAT 4: hc_encode(0, 3) == [0,0,0,0,0,0,0,0]  (row 0 = all zeros)
    let zero_code = hc_encode(0, 3)
    let want_zero = []
    want_zero.push(0)
    want_zero.push(0)
    want_zero.push(0)
    want_zero.push(0)
    want_zero.push(0)
    want_zero.push(0)
    want_zero.push(0)
    want_zero.push(0)
    ckl("hc_encode_0_3", zero_code, want_zero)

    // KAT 5: hc_encode(1, 2) == [0,1,0,1]
    // j=0: parity(1&0=0)=0; j=1: parity(1&1=1)=1; j=2: parity(1&2=0)=0; j=3: parity(1&3=1)=1
    let c12 = hc_encode(1, 2)
    let want_12 = []
    want_12.push(0)
    want_12.push(1)
    want_12.push(0)
    want_12.push(1)
    ckl("hc_encode_1_2", c12, want_12)

    // KAT 6: zero message round-trip (index 0)
    let c0 = hc_encode(0, 3)
    let d0 = hc_decode(c0, 3)
    cki("hc_roundtrip_0", d0, 0)

    // KAT 7: round-trip for index 5
    let c5 = hc_encode(5, 3)
    let d5 = hc_decode(c5, 3)
    cki("hc_roundtrip_5", d5, 5)

    // KAT 8: round-trip for index 5 with 1 bit error (corrects 1 error; t=1 for k=3)
    let c5e = hc_encode(5, 3)
    // Flip bit 0
    if c5e[0] == 0
        c5e[0] = 1
    else
        c5e[0] = 0
    let d5e = hc_decode(c5e, 3)
    cki("hc_roundtrip_5_1err", d5e, 5)

    // KAT 9: round-trip for all indices k=2 (n=4)
    let idx = 0
    while idx < 4
        let cw = hc_encode(idx, 2)
        let dw = hc_decode(cw, 2)
        cki("hc_roundtrip_k2_" + str(idx), dw, idx)
        idx = idx + 1

    // KAT 10: round-trip for all indices k=3 (n=8)
    let idx2 = 0
    while idx2 < 8
        let cw2 = hc_encode(idx2, 3)
        let dw2 = hc_decode(cw2, 3)
        cki("hc_roundtrip_k3_" + str(idx2), dw2, idx2)
        idx2 = idx2 + 1

    // KAT 11: hc_matrix rows match hc_encode
    let mat = hc_matrix(2)
    let row0 = mat[0]
    let row1 = mat[1]
    let enc0 = hc_encode(0, 2)
    let enc1 = hc_encode(1, 2)
    ckb("hc_matrix_row0", list_eq(row0, enc0), true)
    ckb("hc_matrix_row1", list_eq(row1, enc1), true)

    print("PASS _hadamard_code_test")
