import forge_feature_gate

fn main()
    let fg = fg_new()
    fg = fg_add_gate(fg, "new-ui", "boolean")
    fg = fg_add_gate(fg, "beta-api", "user")
    fg = fg_add_gate(fg, "staging-only", "environment")
    assert(fg_gate_count(fg) == 3, "3 gates")

    assert(fg_evaluate(fg, "new-ui", "any-user", "prod") == 1, "boolean always passes")

    fg = fg_add_user(fg, "beta-api", "user-1")
    fg = fg_add_user(fg, "beta-api", "user-2")
    assert(fg_evaluate(fg, "beta-api", "user-1", "prod") == 1, "user-1 passes")
    assert(fg_evaluate(fg, "beta-api", "user-3", "prod") == 0, "user-3 fails")

    fg = fg_add_env(fg, "staging-only", "staging")
    assert(fg_evaluate(fg, "staging-only", "anyone", "staging") == 1, "staging passes")
    assert(fg_evaluate(fg, "staging-only", "anyone", "prod") == 0, "prod fails")

    assert(fg_evaluations(fg, "beta-api") == 2, "2 evaluations")
    assert(fg_pass_rate(fg, "beta-api") == 50, "50% pass rate")

    fg = fg_disable(fg, "new-ui")
    assert(fg_evaluate(fg, "new-ui", "any", "any") == 0, "disabled = fail")

    assert(fg_evaluate(fg, "nonexistent", "u", "e") == 0, "missing gate = 0")

    print("FEATURE-GATE KAT PASS")
