// functional: LiveView on_info — client event + SERVER-push both re-render and emit correct patches
import forge_live

fn _init() -> dict
    let s = {}
    s["n"] = 0
    s["msg"] = ""
    s

fn _view(state) -> list
    [str(state["n"]), state["msg"]]

fn _upd(state, ev) -> dict
    let s = {}
    s["n"] = state["n"] + 1
    s["msg"] = state["msg"]
    s

fn _info(state, msg) -> dict
    let s = {}
    s["n"] = state["n"]
    s["msg"] = msg
    s

fn main()
    let lv = live_view_info(_view, _upd, _info, _init())
    live_send_ev(lv, "click")
    let c1 = live_recv(lv)["changed"]
    if len(c1) != 1
        print("FAIL ev patch len = " + str(len(c1)))
        exit(1)
    if c1[0]["i"] != 0
        print("FAIL ev slot")
        exit(1)
    if c1[0]["val"] != "1"
        print("FAIL ev val = " + str(c1[0]["val"]))
        exit(1)
    live_send_info(lv, "hello")
    let c2 = live_recv(lv)["changed"]
    if len(c2) != 1
        print("FAIL info patch len")
        exit(1)
    if c2[0]["i"] != 1
        print("FAIL info slot = " + str(c2[0]["i"]))
        exit(1)
    if c2[0]["val"] != "hello"
        print("FAIL info val = " + str(c2[0]["val"]))
        exit(1)
    print("PASS forge_live_oninfo")
