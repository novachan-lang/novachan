// KAT for std/net/stomp_heartbeat — STOMP 1.2 heart-beat negotiation.
import std/net/stomp_heartbeat

// ── Assert helpers ───────────────────────────────────────────────────────────

fn assert_s(label: string, got: string, want: string)
    if got != want
        print("FAIL stomp_heartbeat " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn assert_i(label: string, got: int, want: int)
    if got != want
        print("FAIL stomp_heartbeat " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── KAT 1: stomp_heartbeat_parse("500,1000") -> [500, 1000] ──────────────
    let r1 = stomp_heartbeat_parse("500,1000")
    assert_i("parse-500-cx", r1[0], 500)
    assert_i("parse-1000-cy", r1[1], 1000)

    // ── KAT 2: stomp_heartbeat_format(0, 10000) -> "0,10000" ─────────────────
    let f1 = stomp_heartbeat_format(0, 10000)
    assert_s("format-0-10000", f1, "0,10000")

    // ── KAT 3: stomp_newline_frame() -> [10] ─────────────────────────────────
    let nf = stomp_newline_frame()
    assert_i("newline-len", len(nf), 1)
    assert_i("newline-byte", nf[0], 10)

    // ── KAT 4: parse("0,0") -> [0, 0] ────────────────────────────────────────
    let r4 = stomp_heartbeat_parse("0,0")
    assert_i("parse-0-cx", r4[0], 0)
    assert_i("parse-0-cy", r4[1], 0)

    // ── KAT 5: stomp_heartbeat_format(500, 1000) -> "500,1000" ───────────────
    let f2 = stomp_heartbeat_format(500, 1000)
    assert_s("format-500-1000", f2, "500,1000")

    // ── KAT 6: stomp_heartbeat_format(0, 0) -> "0,0" ─────────────────────────
    let f3 = stomp_heartbeat_format(0, 0)
    assert_s("format-0-0", f3, "0,0")

    // ── KAT 7: parse("10000,5000") -> [10000, 5000] ──────────────────────────
    let r7 = stomp_heartbeat_parse("10000,5000")
    assert_i("parse-10000-cx", r7[0], 10000)
    assert_i("parse-5000-cy", r7[1], 5000)

    // ── KAT 8: parse malformed (no comma) -> [0, 0] ───────────────────────────
    let r8 = stomp_heartbeat_parse("12345")
    assert_i("malformed-cx", r8[0], 0)
    assert_i("malformed-cy", r8[1], 0)

    // ── KAT 9: stomp_heartbeat_format(1, 1) -> "1,1" ─────────────────────────
    let f4 = stomp_heartbeat_format(1, 1)
    assert_s("format-1-1", f4, "1,1")

    // ── KAT 10: round-trip format then parse ─────────────────────────────────
    let frt = stomp_heartbeat_format(250, 3000)
    let rrt = stomp_heartbeat_parse(frt)
    assert_i("rt-cx", rrt[0], 250)
    assert_i("rt-cy", rrt[1], 3000)

    print("PASS _stomp_heartbeat_test")
