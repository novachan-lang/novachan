// Bootstrap test 14: multiple return paths, nested if/while
fn classify(n)
    if n < 0
        return "negative"
    if n == 0
        return "zero"
    if n < 10
        return "small"
    return "big"

print(classify(-5))
print(classify(0))
print(classify(7))
print(classify(100))

// Nested while with break
fn find_first_over(items, threshold)
    let i = 0
    while i < len(items)
        if items[i] > threshold
            return items[i]
        i = i + 1
    return -1

let nums = [3, 7, 2, 15, 8]
print(find_first_over(nums, 10))
print(find_first_over(nums, 100))
