// KAT for std/net/sip — RFC 3261 SIP message codec.
import std/net/sip

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL sip " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL sip " + label + ": got=[" + got + "] want=[" + want + "]")
        exit(1)

fn _b2i(b: bool) -> int
    if b
        return 1
    0

fn _str_bytes(s: string) -> bytes
    let b = bytes_create(0)
    b = bytes_append_str(b, s)
    b

fn main()
    let crlf = chr(13) + chr(10)

    // ══════════════════════════════════════════════════════════════════════
    // 1. Byte-exact REGISTER request build (RFC 3261 §10.2 style example)
    // ══════════════════════════════════════════════════════════════════════
    let reg_headers = [
        ["Via", "SIP/2.0/UDP pc33.atlanta.com;branch=z9hG4bK776asdhds"],
        ["Max-Forwards", "70"],
        ["To", "Bob <sip:bob@biloxi.com>"],
        ["From", "Bob <sip:bob@biloxi.com>;tag=456248"],
        ["Call-ID", "843817637684230@998sundhcv23"],
        ["CSeq", "1826 REGISTER"],
        ["Contact", "<sip:bob@192.0.2.4>"],
        ["Expires", "7200"],
        ["Content-Length", "0"]]
    let reg = sip_build_request("REGISTER", "sip:registrar.biloxi.com", reg_headers, bytes_create(0))
    cki("reg_ok", reg["ok"], 1)
    let expected_reg = "REGISTER sip:registrar.biloxi.com SIP/2.0" + crlf
    expected_reg = expected_reg + "Via: SIP/2.0/UDP pc33.atlanta.com;branch=z9hG4bK776asdhds" + crlf
    expected_reg = expected_reg + "Max-Forwards: 70" + crlf
    expected_reg = expected_reg + "To: Bob <sip:bob@biloxi.com>" + crlf
    expected_reg = expected_reg + "From: Bob <sip:bob@biloxi.com>;tag=456248" + crlf
    expected_reg = expected_reg + "Call-ID: 843817637684230@998sundhcv23" + crlf
    expected_reg = expected_reg + "CSeq: 1826 REGISTER" + crlf
    expected_reg = expected_reg + "Contact: <sip:bob@192.0.2.4>" + crlf
    expected_reg = expected_reg + "Expires: 7200" + crlf
    expected_reg = expected_reg + "Content-Length: 0" + crlf
    expected_reg = expected_reg + crlf
    cks("reg_bytes_exact", bytes_to_str(reg["bytes"]), expected_reg)
    cki("reg_bytes_len", bytes_len(reg["bytes"]), len(expected_reg))

    // Build-side validation: empty method / uri rejected in-band, never crash
    let bad1 = sip_build_request("", "sip:x@y.com", [], bytes_create(0))
    cki("build_empty_method_rejected", bad1["ok"], 0)
    cki("build_empty_method_empty_bytes", bytes_len(bad1["bytes"]), 0)
    let bad2 = sip_build_request("INVITE", "", [], bytes_create(0))
    cki("build_empty_uri_rejected", bad2["ok"], 0)

    // ══════════════════════════════════════════════════════════════════════
    // 2. Parse a 200 OK response, incl. TWO Via headers (round-trip order)
    // ══════════════════════════════════════════════════════════════════════
    let ok_msg_text = "SIP/2.0 200 OK" + crlf
    ok_msg_text = ok_msg_text + "Via: SIP/2.0/UDP pc33.atlanta.com;branch=z9hG4bK776asdhds" + crlf
    ok_msg_text = ok_msg_text + "Via: SIP/2.0/UDP bigbox3.site3.atlanta.com;branch=z9hG4bK77ef4c2312983.1" + crlf
    ok_msg_text = ok_msg_text + "To: Bob <sip:bob@biloxi.com>;tag=2493k59kd" + crlf
    ok_msg_text = ok_msg_text + "From: Bob <sip:bob@biloxi.com>;tag=456248" + crlf
    ok_msg_text = ok_msg_text + "Call-ID: 843817637684230@998sundhcv23" + crlf
    ok_msg_text = ok_msg_text + "CSeq: 314159 INVITE" + crlf
    ok_msg_text = ok_msg_text + "Contact: <sip:bob@192.0.2.4>" + crlf
    ok_msg_text = ok_msg_text + "Content-Type: application/sdp" + crlf
    ok_msg_text = ok_msg_text + "Content-Length: 4" + crlf
    ok_msg_text = ok_msg_text + crlf
    ok_msg_text = ok_msg_text + "BODY"
    let p = sip_parse(_str_bytes(ok_msg_text))
    cki("ok_parse_ok", p["ok"], 1)
    cki("ok_is_request", _b2i(p["is_request"]), 0)
    cki("ok_status", p["status"], 200)
    cks("ok_reason", p["reason"], "OK")
    cki("ok_headers_count", len(p["headers"]), 9)
    cks("ok_body", bytes_to_str(p["body"]), "BODY")
    cki("ok_cl_header", p["content_length_header"], 4)
    cki("ok_cl_body", p["content_length_body"], 4)
    cki("ok_cl_match", _b2i(p["content_length_match"]), 1)

    // Multiple Via preserved, IN ORDER (this is the whole point of list-of-pairs headers)
    let vias = sip_header_get_all(p["headers"], "Via")
    cki("ok_via_count", len(vias), 2)
    cks("ok_via0", vias[0], "SIP/2.0/UDP pc33.atlanta.com;branch=z9hG4bK776asdhds")
    cks("ok_via1", vias[1], "SIP/2.0/UDP bigbox3.site3.atlanta.com;branch=z9hG4bK77ef4c2312983.1")
    // sip_header_get returns the FIRST Via
    cks("ok_via_first_via_get", sip_header_get(p["headers"], "Via"), vias[0])
    // compact form "v" resolves to the same values as "Via"
    let vias_compact = sip_header_get_all(p["headers"], "v")
    cki("ok_via_compact_count", len(vias_compact), 2)
    cks("ok_via_compact0", vias_compact[0], vias[0])

    // CSeq sub-parse
    let cseq = sip_parse_cseq(sip_header_get(p["headers"], "CSeq"))
    cki("ok_cseq_ok", cseq["ok"], 1)
    cki("ok_cseq_number", cseq["number"], 314159)
    cks("ok_cseq_method", cseq["method"], "INVITE")
    cks("ok_cseq_build_roundtrip", sip_build_cseq(cseq["number"], cseq["method"]), "314159 INVITE")

    // Via sub-parse (transport + host + branch)
    let via0 = sip_parse_via(vias[0])
    cki("ok_via0_ok", via0["ok"], 1)
    cks("ok_via0_transport", via0["transport"], "UDP")
    cks("ok_via0_host", via0["host"], "pc33.atlanta.com")
    cki("ok_via0_port", via0["port"], -1)
    cks("ok_via0_branch", via0["branch"], "z9hG4bK776asdhds")

    // ══════════════════════════════════════════════════════════════════════
    // 3. Full round-trip: rebuild the response from parsed fields, reparse
    // ══════════════════════════════════════════════════════════════════════
    let rebuilt = sip_build_response(p["status"], p["reason"], p["headers"], p["body"])
    cki("rebuilt_ok", rebuilt["ok"], 1)
    let p2 = sip_parse(rebuilt["bytes"])
    cki("rt_ok", p2["ok"], 1)
    cki("rt_status", p2["status"], 200)
    cks("rt_reason", p2["reason"], "OK")
    cki("rt_headers_count", len(p2["headers"]), len(p["headers"]))
    let vias2 = sip_header_get_all(p2["headers"], "Via")
    cki("rt_via_count", len(vias2), 2)
    cks("rt_via0", vias2[0], vias[0])
    cks("rt_via1", vias2[1], vias[1])
    cks("rt_body", bytes_to_str(p2["body"]), "BODY")

    // Also round-trip the REGISTER request itself (parse what we built in §1)
    let preg = sip_parse(reg["bytes"])
    cki("preg_ok", preg["ok"], 1)
    cki("preg_is_request", _b2i(preg["is_request"]), 1)
    cks("preg_method", preg["method"], "REGISTER")
    cks("preg_uri", preg["uri"], "sip:registrar.biloxi.com")
    cki("preg_headers_count", len(preg["headers"]), 9)
    cki("preg_cl_match", _b2i(preg["content_length_match"]), 1)
    cki("preg_body_len", bytes_len(preg["body"]), 0)

    // ══════════════════════════════════════════════════════════════════════
    // 4. Content-Length mismatch — flagged, never a crash / over-read
    // ══════════════════════════════════════════════════════════════════════
    // Declared (100) vastly exceeds actual bytes present (2) — body must be
    // bounded to what's actually in the buffer, never read past it.
    let overrun_text = "SIP/2.0 200 OK" + crlf + "Content-Length: 100" + crlf + crlf + "Hi"
    let po = sip_parse(_str_bytes(overrun_text))
    cki("overrun_ok", po["ok"], 1)
    cki("overrun_cl_header", po["content_length_header"], 100)
    cki("overrun_cl_body", po["content_length_body"], 2)
    cks("overrun_body", bytes_to_str(po["body"]), "Hi")
    cki("overrun_cl_match", _b2i(po["content_length_match"]), 0)

    // Declared length exceeds an EMPTY remaining buffer entirely.
    let overrun2_text = "SIP/2.0 200 OK" + crlf + "Content-Length: 5" + crlf + crlf
    let po2 = sip_parse(_str_bytes(overrun2_text))
    cki("overrun2_ok", po2["ok"], 1)
    cki("overrun2_cl_body", po2["content_length_body"], 0)
    cki("overrun2_body_len", bytes_len(po2["body"]), 0)
    cki("overrun2_cl_match", _b2i(po2["content_length_match"]), 0)

    // Declared length UNDER actual buffer (trailing/pipelined data) is
    // honored (body framed exactly at the declared length), match flagged.
    let under_text = "SIP/2.0 200 OK" + crlf + "Content-Length: 2" + crlf + crlf + "HelloExtra"
    let pu = sip_parse(_str_bytes(under_text))
    cki("under_ok", pu["ok"], 1)
    cki("under_cl_body", pu["content_length_body"], 2)
    cks("under_body", bytes_to_str(pu["body"]), "He")
    cki("under_cl_match", _b2i(pu["content_length_match"]), 0)

    // Overlong (overflow-prone) Content-Length digit string is rejected as
    // invalid rather than silently wrapping into a small/negative i64.
    let huge_text = "SIP/2.0 200 OK" + crlf + "Content-Length: 999999999999999999999999" + crlf + crlf + "xyz"
    let ph = sip_parse(_str_bytes(huge_text))
    cki("huge_ok", ph["ok"], 1)
    cki("huge_cl_header", ph["content_length_header"], -1)
    cks("huge_body_fallback", bytes_to_str(ph["body"]), "xyz")
    cki("huge_cl_match", _b2i(ph["content_length_match"]), 0)

    // Missing Content-Length entirely: whole remainder becomes the body.
    let nocl_text = "SIP/2.0 200 OK" + crlf + "To: <sip:a@b>" + crlf + crlf + "rest-of-buffer"
    let pn = sip_parse(_str_bytes(nocl_text))
    cki("nocl_ok", pn["ok"], 1)
    cki("nocl_cl_header", pn["content_length_header"], -1)
    cks("nocl_body", bytes_to_str(pn["body"]), "rest-of-buffer")
    cki("nocl_cl_match", _b2i(pn["content_length_match"]), 0)

    // ══════════════════════════════════════════════════════════════════════
    // 5. Header line without a colon — rejected in-band, not a crash
    // ══════════════════════════════════════════════════════════════════════
    let badcolon_text = "SIP/2.0 200 OK" + crlf + "BadHeaderNoColon" + crlf + crlf
    let pb = sip_parse(_str_bytes(badcolon_text))
    cki("badcolon_rejected", pb["ok"], 0)
    cki("badcolon_headers_empty", len(pb["headers"]), 0)
    cki("badcolon_body_empty", bytes_len(pb["body"]), 0)

    // ══════════════════════════════════════════════════════════════════════
    // 6. CRLF injection into a header value — rejected on build, never
    //    silently smuggled into the wire bytes.
    // ══════════════════════════════════════════════════════════════════════
    let evil_value = "abc" + crlf + "Evil-Header: injected"
    let inj = sip_build_request("INVITE", "sip:x@y.com", [["X-Test", evil_value]], bytes_create(0))
    cki("injection_rejected", inj["ok"], 0)
    cki("injection_empty_bytes", bytes_len(inj["bytes"]), 0)

    // Same defense on the response builder + on the header NAME + on the reason phrase.
    let inj2 = sip_build_response(200, "OK", [["X" + crlf + "Y", "z"]], bytes_create(0))
    cki("injection_name_rejected", inj2["ok"], 0)
    let inj3 = sip_build_response(200, "OK" + crlf + "Evil: 1", [], bytes_create(0))
    cki("injection_reason_rejected", inj3["ok"], 0)
    let inj4 = sip_build_request("INVITE" + crlf + "X", "sip:x@y.com", [], bytes_create(0))
    cki("injection_method_rejected", inj4["ok"], 0)

    // Confirm a message CANNOT be forged this way even if a caller tried to
    // "hide" a second header/blank-line inside a legitimate-looking value:
    // the builder simply refuses to produce ANY bytes (checked above via
    // injection_rejected / injection_empty_bytes), so nothing reaches a wire
    // parser that could misinterpret it as two messages.

    // ══════════════════════════════════════════════════════════════════════
    // 7. Compact header forms round-trip (v/f/t/i/m/l — RFC 3261 §20 Table 2)
    // ══════════════════════════════════════════════════════════════════════
    let compact_text = "REGISTER sip:example.com SIP/2.0" + crlf
    compact_text = compact_text + "v: SIP/2.0/UDP host.example.com;branch=z9hG4bKcompact" + crlf
    compact_text = compact_text + "f: <sip:a@example.com>" + crlf
    compact_text = compact_text + "t: <sip:b@example.com>" + crlf
    compact_text = compact_text + "i: callid-compact-123" + crlf
    compact_text = compact_text + "CSeq: 1 REGISTER" + crlf
    compact_text = compact_text + "m: <sip:a@192.0.2.1>" + crlf
    compact_text = compact_text + "l: 0" + crlf
    compact_text = compact_text + crlf
    let pc = sip_parse(_str_bytes(compact_text))
    cki("compact_ok", pc["ok"], 1)
    cks("compact_via_via", sip_header_get(pc["headers"], "Via"), "SIP/2.0/UDP host.example.com;branch=z9hG4bKcompact")
    cks("compact_from_from", sip_header_get(pc["headers"], "From"), "<sip:a@example.com>")
    cks("compact_to_to", sip_header_get(pc["headers"], "To"), "<sip:b@example.com>")
    cks("compact_callid_callid", sip_header_get(pc["headers"], "Call-ID"), "callid-compact-123")
    cks("compact_contact_contact", sip_header_get(pc["headers"], "Contact"), "<sip:a@192.0.2.1>")
    cki("compact_cl_via_int", sip_header_get_int(pc["headers"], "l"), 0)
    cks("compact_canon_v", sip_canonical_header_name("v"), "Via")
    cks("compact_canon_i", sip_canonical_header_name("i"), "Call-ID")
    cks("compact_canon_unknown", sip_canonical_header_name("X-Custom"), "X-Custom")

    // ══════════════════════════════════════════════════════════════════════
    // 8. Binary body (embedded NUL) preserved exactly — never string-truncated
    // ══════════════════════════════════════════════════════════════════════
    let bin_body = bytes_create(0)
    bin_body = bytes_append(bin_body, 0x53)   // 'S'
    bin_body = bytes_append(bin_body, 0x00)   // NUL — would truncate a C-string
    bin_body = bytes_append(bin_body, 0xFF)
    bin_body = bytes_append(bin_body, 0x44)   // 'D'
    let bin_headers = [["Content-Length", "4"]]
    let bin_msg = sip_build_response(200, "OK", bin_headers, bin_body)
    cki("bin_build_ok", bin_msg["ok"], 1)
    let pbin = sip_parse(bin_msg["bytes"])
    cki("bin_parse_ok", pbin["ok"], 1)
    cki("bin_body_len", bytes_len(pbin["body"]), 4)
    cki("bin_body_b0", bytes_get(pbin["body"], 0), 0x53)
    cki("bin_body_b1", bytes_get(pbin["body"], 1), 0x00)
    cki("bin_body_b2", bytes_get(pbin["body"], 2), 0xFF)
    cki("bin_body_b3", bytes_get(pbin["body"], 3), 0x44)
    cki("bin_cl_match", _b2i(pbin["content_length_match"]), 1)

    // ══════════════════════════════════════════════════════════════════════
    // 9. Empty / missing / malformed — never a crash, always in-band
    // ══════════════════════════════════════════════════════════════════════
    let pe1 = sip_parse(bytes_create(0))
    cki("empty_msg_rejected", pe1["ok"], 0)
    let pe2 = sip_parse(_str_bytes("garbage with no separator at all"))
    cki("no_sep_rejected", pe2["ok"], 0)
    let pe3 = sip_parse(_str_bytes(crlf + crlf))
    cki("blank_only_rejected", pe3["ok"], 0)

    cks("get_on_empty_headers", sip_header_get([], "Via"), "")
    cki("get_all_on_empty_headers", len(sip_header_get_all([], "Via")), 0)
    cki("has_on_empty_headers", _b2i(sip_header_has([], "Via")), 0)
    cki("get_int_on_empty_headers", sip_header_get_int([], "Content-Length"), -1)

    let vfail = sip_parse_via("")
    cki("via_empty_rejected", vfail["ok"], 0)
    let vfail2 = sip_parse_via("not a via value")
    cki("via_garbage_rejected", vfail2["ok"], 0)
    let cfail = sip_parse_cseq("")
    cki("cseq_empty_rejected", cfail["ok"], 0)
    let cfail2 = sip_parse_cseq("NOTANUMBER INVITE")
    cki("cseq_nonnumeric_rejected", cfail2["ok"], 0)

    // Bad status code range on build
    let bad_status = sip_build_response(99, "Too Low", [], bytes_create(0))
    cki("status_too_low_rejected", bad_status["ok"], 0)
    let bad_status2 = sip_build_response(700, "Too High", [], bytes_create(0))
    cki("status_too_high_rejected", bad_status2["ok"], 0)
    // Bad status line on parse
    let pbadstatus = sip_parse(_str_bytes("SIP/2.0 abc Bad" + crlf + crlf))
    cki("parse_bad_status_rejected", pbadstatus["ok"], 0)
    // Wrong SIP version on parse
    let pbadver = sip_parse(_str_bytes("INVITE sip:x@y.com SIP/1.0" + crlf + crlf))
    cki("parse_bad_version_rejected", pbadver["ok"], 0)
    // Malformed request line (no SIP version token at all)
    let pbadreq = sip_parse(_str_bytes("INVITE sip:x@y.com" + crlf + crlf))
    cki("parse_missing_version_rejected", pbadreq["ok"], 0)

    // ══════════════════════════════════════════════════════════════════════
    // 10. Header folding (RFC 2822-style continuation)
    // ══════════════════════════════════════════════════════════════════════
    let fold_text = "SIP/2.0 200 OK" + crlf
    fold_text = fold_text + "Subject:   Line one" + crlf
    fold_text = fold_text + " continued line two" + crlf
    fold_text = fold_text + crlf
    let pf = sip_parse(_str_bytes(fold_text))
    cki("fold_ok", pf["ok"], 1)
    cks("fold_value", sip_header_get(pf["headers"], "Subject"), "Line one continued line two")
    // A continuation line with NO preceding header is rejected, not silently dropped.
    let foldbad_text = "SIP/2.0 200 OK" + crlf + " orphan continuation" + crlf + crlf
    let pfb = sip_parse(_str_bytes(foldbad_text))
    cki("fold_orphan_rejected", pfb["ok"], 0)

    // ══════════════════════════════════════════════════════════════════════
    // 11. Via with IPv6 sent-by + extra params (rport bare flag)
    // ══════════════════════════════════════════════════════════════════════
    let via_v6 = sip_parse_via("SIP/2.0/TCP [::1]:5060;branch=z9hG4bK1;rport")
    cki("via_v6_ok", via_v6["ok"], 1)
    cks("via_v6_transport", via_v6["transport"], "TCP")
    cks("via_v6_host", via_v6["host"], "[::1]")
    cki("via_v6_port", via_v6["port"], 5060)
    cks("via_v6_branch", via_v6["branch"], "z9hG4bK1")
    cki("via_v6_has_rport", _b2i(contains(via_v6["params"], "rport")), 1)

    let via_rt = sip_build_via("UDP", "pc33.atlanta.com", "z9hG4bK776asdhds")
    cks("build_via_roundtrip", via_rt, "SIP/2.0/UDP pc33.atlanta.com;branch=z9hG4bK776asdhds")
    cks("build_via_no_branch", sip_build_via("UDP", "host.example.com", ""), "SIP/2.0/UDP host.example.com")

    // ══════════════════════════════════════════════════════════════════════
    // 12. FIX: raw SPACE in method / Request-URI rejected in-band (was
    // previously accepted with ok=1, producing wire bytes that then FAILED
    // to re-parse as the same method/URI — a framing-ambiguous "success").
    // ══════════════════════════════════════════════════════════════════════
    let sp_method = sip_build_request("IN VITE", "sip:x@y.com", [], bytes_create(0))
    cki("space_method_rejected", sp_method["ok"], 0)
    cki("space_method_empty_bytes", bytes_len(sp_method["bytes"]), 0)
    let sp_uri = sip_build_request("INVITE", "sip:x y@z.com", [], bytes_create(0))
    cki("space_uri_rejected", sp_uri["ok"], 0)
    cki("space_uri_empty_bytes", bytes_len(sp_uri["bytes"]), 0)
    // A tab (CTL-adjacent whitespace) and a separator char are likewise not
    // a valid RFC3261 method token.
    let tab_method = sip_build_request("IN" + chr(9) + "VITE", "sip:x@y.com", [], bytes_create(0))
    cki("tab_method_rejected", tab_method["ok"], 0)
    let sep_method = sip_build_request("IN<VITE", "sip:x@y.com", [], bytes_create(0))
    cki("separator_char_method_rejected", sep_method["ok"], 0)
    // A normal token-only method with no separators still builds fine.
    let ok_method = sip_build_request("X-CUSTOM_METHOD.1", "sip:x@y.com", [], bytes_create(0))
    cki("token_method_accepted", ok_method["ok"], 1)

    // ══════════════════════════════════════════════════════════════════════
    // 13. FIX: a bare LF (not preceded by CR) sitting inside what would
    // otherwise look like header-block content does NOT prematurely
    // terminate the header block when the buffer is CRLF-framed elsewhere —
    // the header AFTER the bare "\n\n" must still be parsed, not silently
    // swallowed into the body.
    // ══════════════════════════════════════════════════════════════════════
    let lf_char = chr(10)
    let smuggle_text = "INVITE sip:bob@biloxi.com SIP/2.0" + crlf
    smuggle_text = smuggle_text + "X-Foo: bar" + lf_char + lf_char
    smuggle_text = smuggle_text + "Call-ID: real-header-must-survive" + crlf + crlf
    let psmug = sip_parse(_str_bytes(smuggle_text))
    cki("bare_lf_no_swallow_ok", psmug["ok"], 1)
    cki("bare_lf_no_swallow_header_count", len(psmug["headers"]), 2)
    cks("bare_lf_no_swallow_callid_survives", sip_header_get(psmug["headers"], "Call-ID"), "real-header-must-survive")
    cks("bare_lf_no_swallow_xfoo", sip_header_get(psmug["headers"], "X-Foo"), "bar")
    cki("bare_lf_no_swallow_body_empty", bytes_len(psmug["body"]), 0)

    // A message that is PURELY bare-LF-terminated throughout (no CR
    // anywhere) still uses the bare-LFLF terminator as intended (interop
    // tolerance is preserved for genuinely bare-LF senders).
    let pure_lf_text = "SIP/2.0 200 OK" + lf_char + "Content-Length: 0" + lf_char + lf_char
    let ppure = sip_parse(_str_bytes(pure_lf_text))
    cki("pure_bare_lf_still_tolerated_ok", ppure["ok"], 1)
    cki("pure_bare_lf_still_tolerated_headers", len(ppure["headers"]), 1)

    print("PASS _sip_test")
