// Oracle for the json_encode(float) fix (FINDING #1, top-level float).
// Previously json_encode(3.14) printed the raw float bits as a huge integer.
// Now the compiler routes a float arg to nova_rt_json_encode_float -> correct number.
fn main()
    assert_eq(json_encode(3.14), "3.14")
    assert_eq(json_encode(2.5), "2.5")
    assert_eq(json_encode(0.5), "0.5")
    print("JSON float encode oracle passed")
