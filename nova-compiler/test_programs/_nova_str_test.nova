fn main()
    let bs = chr(92)
    let s1 = "\n"
    let s2 = "\t"
    print("len_bsn=" + str(len("\n")))
    print("len_bst=" + str(len("\t")))
    print("char0_bsn=" + str(ord(s1[0])))
    print("char0_bst=" + str(ord(s2[0])))
    let nl_literal = bs + "n"
    print("nl_literal_len=" + str(len(nl_literal)))
    print("char0_nl_literal=" + str(ord(nl_literal[0])))
