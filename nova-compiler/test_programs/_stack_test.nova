import std/collections/stack

// KAT: hand-computed assertions for the LIFO stack.

fn main()
    // Build a stack and push 1, 2, 3.
    let s = st_new()
    st_push(s, 1)
    st_push(s, 2)
    st_push(s, 3)

    // KAT 1: size after three pushes must be 3.
    if st_size(s) != 3
        print("FAIL: st_size after 3 pushes expected 3 got " + str(st_size(s)))
        exit(1)

    // KAT 2: peek returns top (3) without removing.
    if st_peek(s) != 3
        print("FAIL: st_peek expected 3 got " + str(st_peek(s)))
        exit(1)

    // KAT 3: first pop returns 3.
    let v3 = st_pop(s)
    if v3 != 3
        print("FAIL: st_pop expected 3 got " + str(v3))
        exit(1)

    // KAT 4: second pop returns 2.
    let v2 = st_pop(s)
    if v2 != 2
        print("FAIL: st_pop expected 2 got " + str(v2))
        exit(1)

    // KAT 5: size is now 1.
    if st_size(s) != 1
        print("FAIL: st_size after 2 pops expected 1 got " + str(st_size(s)))
        exit(1)

    // KAT 6: stack is not empty (still has 1 element).
    if st_is_empty(s) != 0
        print("FAIL: st_is_empty expected 0 (not empty) got " + str(st_is_empty(s)))
        exit(1)

    // KAT 7: third pop returns 1.
    let v1 = st_pop(s)
    if v1 != 1
        print("FAIL: st_pop expected 1 got " + str(v1))
        exit(1)

    // KAT 8: stack is now empty.
    if st_is_empty(s) != 1
        print("FAIL: st_is_empty expected 1 (empty) got " + str(st_is_empty(s)))
        exit(1)

    // KAT 9: st_to_list preserves bottom-to-top order.
    let s2 = st_new()
    st_push(s2, 10)
    st_push(s2, 20)
    st_push(s2, 30)
    let lst = st_to_list(s2)
    if len(lst) != 3
        print("FAIL: st_to_list len expected 3 got " + str(len(lst)))
        exit(1)
    if lst[0] != 10
        print("FAIL: st_to_list[0] expected 10 got " + str(lst[0]))
        exit(1)
    if lst[2] != 30
        print("FAIL: st_to_list[2] expected 30 got " + str(lst[2]))
        exit(1)

    // KAT 10: st_clear empties the stack; pop on empty returns null.
    st_clear(s2)
    if st_size(s2) != 0
        print("FAIL: st_size after clear expected 0 got " + str(st_size(s2)))
        exit(1)
    let vn = st_pop(s2)
    if vn != null
        print("FAIL: st_pop on empty expected null got " + str(vn))
        exit(1)

    print("_stack_test passed")

main()
