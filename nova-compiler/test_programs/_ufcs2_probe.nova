fn double(x: int) -> int
    x * 2

fn add_suffix(s: string, suffix: string) -> string
    s + suffix

fn main()
    let n = 5
    let d = n.double()
    assert_eq(d, 10)

    let greeting = "Hello"
    let full = greeting.add_suffix("!")
    assert_eq(full, "Hello!")

    let result = 3.double().double()
    assert_eq(result, 12)

    print("ufcs2_probe: all passed")
