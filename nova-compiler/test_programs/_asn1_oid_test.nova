// _asn1_oid_test — KAT for std/data/asn1_oid (ASN.1 DER OID encoder/decoder)
//
// KAT vectors (X.690 / RFC 5280 verified):
//   KAT1: asn1_oid_encode([1,2,840,113549]) == [06 06 2A 86 48 86 F7 0D]
//   KAT2: asn1_oid_encode([2,5,4,3])        == [06 03 55 04 03]
//   KAT3: asn1_oid_encode([1,2,3])          == [06 02 2A 03]
//   KAT4: asn1_oid_encode([2,100,3])        == [06 03 81 34 03]  (first=180)
//   KAT5-8: round-trip decode all four vectors back to original arcs

import std/data/asn1_oid

// Helper: compare two bytes values byte-by-byte, print diagnostic on mismatch.
fn _bytes_eq(a: any, b: any) -> int
    let la = bytes_len(a)
    let lb = bytes_len(b)
    let ok = 1
    if la != lb
        ok = 0
    else
        let i = 0
        while i < la
            if bytes_get(a, i) != bytes_get(b, i)
                ok = 0
            i = i + 1
    ok

// Helper: compare two int lists element-by-element.
fn _list_eq(a: list, b: list) -> int
    let la = len(a)
    let lb = len(b)
    let ok = 1
    if la != lb
        ok = 0
    else
        let i = 0
        while i < la
            if a[i] != b[i]
                ok = 0
            i = i + 1
    ok

// ── KAT1: [1,2,840,113549] == 06 06 2A 86 48 86 F7 0D ──────────────────────
let arcs1 = [1, 2, 840, 113549]
let r1 = asn1_oid_encode(arcs1)
let want1 = bytes(8)
bytes_set(want1, 0, 6)
bytes_set(want1, 1, 6)
bytes_set(want1, 2, 42)
bytes_set(want1, 3, 134)
bytes_set(want1, 4, 72)
bytes_set(want1, 5, 134)
bytes_set(want1, 6, 247)
bytes_set(want1, 7, 13)
if _bytes_eq(r1, want1) == 0
    print("FAIL asn1_oid KAT1: encode([1,2,840,113549]) mismatch")
    exit(1)
print("PASS KAT1: asn1_oid_encode([1,2,840,113549])")

// ── KAT2: [2,5,4,3] == 06 03 55 04 03 ──────────────────────────────────────
let arcs2 = [2, 5, 4, 3]
let r2 = asn1_oid_encode(arcs2)
let want2 = bytes(5)
bytes_set(want2, 0, 6)
bytes_set(want2, 1, 3)
bytes_set(want2, 2, 85)
bytes_set(want2, 3, 4)
bytes_set(want2, 4, 3)
if _bytes_eq(r2, want2) == 0
    print("FAIL asn1_oid KAT2: encode([2,5,4,3]) mismatch")
    exit(1)
print("PASS KAT2: asn1_oid_encode([2,5,4,3])")

// ── KAT3: [1,2,3] == 06 02 2A 03 ───────────────────────────────────────────
let arcs3 = [1, 2, 3]
let r3 = asn1_oid_encode(arcs3)
let want3 = bytes(4)
bytes_set(want3, 0, 6)
bytes_set(want3, 1, 2)
bytes_set(want3, 2, 42)
bytes_set(want3, 3, 3)
if _bytes_eq(r3, want3) == 0
    print("FAIL asn1_oid KAT3: encode([1,2,3]) mismatch")
    exit(1)
print("PASS KAT3: asn1_oid_encode([1,2,3])")

// ── KAT4: [2,100,3] == 06 03 81 34 03  (first_val=180 -> [0x81,0x34]) ──────
let arcs4 = [2, 100, 3]
let r4 = asn1_oid_encode(arcs4)
let want4 = bytes(5)
bytes_set(want4, 0, 6)
bytes_set(want4, 1, 3)
bytes_set(want4, 2, 129)
bytes_set(want4, 3, 52)
bytes_set(want4, 4, 3)
if _bytes_eq(r4, want4) == 0
    print("FAIL asn1_oid KAT4: encode([2,100,3]) mismatch")
    exit(1)
print("PASS KAT4: asn1_oid_encode([2,100,3])")

// ── KAT5: round-trip decode [1,2,840,113549] ────────────────────────────────
let dec1 = asn1_oid_decode(r1, 0)
let arcs1d = dec1[0]
let next1 = dec1[1]
if next1 != 8
    print("FAIL asn1_oid KAT5: decode next_pos != 8")
    exit(1)
if _list_eq(arcs1d, arcs1) == 0
    print("FAIL asn1_oid KAT5: decoded arcs mismatch for [1,2,840,113549]")
    exit(1)
print("PASS KAT5: round-trip [1,2,840,113549]")

// ── KAT6: round-trip decode [2,5,4,3] ───────────────────────────────────────
let dec2 = asn1_oid_decode(r2, 0)
let arcs2d = dec2[0]
let next2 = dec2[1]
if next2 != 5
    print("FAIL asn1_oid KAT6: decode next_pos != 5")
    exit(1)
if _list_eq(arcs2d, arcs2) == 0
    print("FAIL asn1_oid KAT6: decoded arcs mismatch for [2,5,4,3]")
    exit(1)
print("PASS KAT6: round-trip [2,5,4,3]")

// ── KAT7: round-trip decode [1,2,3] ─────────────────────────────────────────
let dec3 = asn1_oid_decode(r3, 0)
let arcs3d = dec3[0]
let next3 = dec3[1]
if next3 != 4
    print("FAIL asn1_oid KAT7: decode next_pos != 4")
    exit(1)
if _list_eq(arcs3d, arcs3) == 0
    print("FAIL asn1_oid KAT7: decoded arcs mismatch for [1,2,3]")
    exit(1)
print("PASS KAT7: round-trip [1,2,3]")

// ── KAT8: round-trip decode [2,100,3] ───────────────────────────────────────
let dec4 = asn1_oid_decode(r4, 0)
let arcs4d = dec4[0]
let next4 = dec4[1]
if next4 != 5
    print("FAIL asn1_oid KAT8: decode next_pos != 5")
    exit(1)
if _list_eq(arcs4d, arcs4) == 0
    print("FAIL asn1_oid KAT8: decoded arcs mismatch for [2,100,3]")
    exit(1)
print("PASS KAT8: round-trip [2,100,3]")

// ── KAT9: wrong-tag decode returns safe empty ────────────────────────────────
let bad_tag = bytes(3)
bytes_set(bad_tag, 0, 2)
bytes_set(bad_tag, 1, 1)
bytes_set(bad_tag, 2, 0)
let dec_bad = asn1_oid_decode(bad_tag, 0)
let arcs_bad = dec_bad[0]
if len(arcs_bad) != 0
    print("FAIL asn1_oid KAT9: wrong-tag should return empty arcs")
    exit(1)
print("PASS KAT9: wrong-tag decode returns empty")

// ── KAT10: long-form length (long OID with 200-byte-ish content) ─────────────
// We encode [1,2] followed by 45 arcs each = 3 (trivially 1 byte each).
// That gives first_byte=42 + 45 bytes = 46 content bytes (< 128, short form).
// For a long-form test: build arcs list with many large-value arcs so content > 127.
// 19 arcs of value 268435455 (0x0FFFFFFF) each base-128 encode to 4 bytes.
// Content = 1 + 19*4 = 77 bytes -- still short form. Use 32 large arcs = 1+32*4=129 bytes.
let big_arcs = [1, 2]
let bi = 0
while bi < 32
    push(big_arcs, 268435455)
    bi = bi + 1
let big_enc = asn1_oid_encode(big_arcs)
// Verify tag=6, length uses long form 0x81 0x81 (129 content bytes)
if bytes_get(big_enc, 0) != 6
    print("FAIL asn1_oid KAT10: tag != 6")
    exit(1)
if bytes_get(big_enc, 1) != 129
    print("FAIL asn1_oid KAT10: long-form marker byte != 129 (0x81)")
    exit(1)
if bytes_get(big_enc, 2) != 129
    print("FAIL asn1_oid KAT10: long-form length byte != 129")
    exit(1)
// Round-trip the big OID
let dec_big = asn1_oid_decode(big_enc, 0)
let arcs_big_d = dec_big[0]
if _list_eq(arcs_big_d, big_arcs) == 0
    print("FAIL asn1_oid KAT10: big-OID round-trip failed")
    exit(1)
print("PASS KAT10: long-form length OID round-trip")

print("PASS _asn1_oid_test")
