// Forge T1.4 (closes B2): route :param and catch-all are PERCENT-DECODED before binding.
// "/u/:id" vs "/u/a%20b" binds id="a b"; "/files/*p" vs "/files/x%2Fy" binds p="x/y". Plain
// (unencoded) segments are unchanged (no regression). Socketless dispatch -> kill-on-timeout safe.
import forge

fn echo_id(req: Request) -> string
    req.params["id"]

fn echo_path(req: Request) -> string
    req.params["p"]

fn main()
    let a = forge.app()
    forge.get(a, "/u/:id", echo_id)
    forge.get(a, "/files/*p", echo_path)

    // :param percent-decoded: %20 -> space.
    let r1: Response = forge.dispatch_req(a, forge.build_request("GET /u/a%20b HTTP/1.1\r\n\r\n", 0))
    assert(r1.status == 200, ":param route matches")
    assert(find(forge.finalize(r1), "a b") >= 0, ":param '%20' decoded to space (a b)")
    print("PASS: :param percent-decode")

    // catch-all percent-decoded: %2F -> '/' (so the decoded segment can itself contain a slash).
    let r2: Response = forge.dispatch_req(a, forge.build_request("GET /files/x%2Fy HTTP/1.1\r\n\r\n", 0))
    assert(r2.status == 200, "catch-all route matches")
    assert(find(forge.finalize(r2), "x/y") >= 0, "catch-all '%2F' decoded to '/' (x/y)")
    print("PASS: catch-all percent-decode")

    // Regression: a plain unencoded segment is unchanged.
    let r3: Response = forge.dispatch_req(a, forge.build_request("GET /u/42 HTTP/1.1\r\n\r\n", 0))
    assert(r3.status == 200, "plain param route matches")
    assert(find(forge.finalize(r3), "42") >= 0, "plain param unchanged")
    print("PASS: plain param unchanged (no regression)")
    print("forge_param_decode_test passed")
