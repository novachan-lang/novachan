// S4 adversarial: deep_copy of a float list across a task boundary (devils-advocate attack 5).
// A channel send deep_copies the value into the receiver's ownership. For a raw double[] list this
// must copy the buffer correctly (memcpy), NOT find_tag/recurse on raw double bits (the int/pointer
// CVE class). On the inert foundation (boxed floats) this works; after raw-float storage it must
// STILL produce 10.0 -> the guard that deep_copy/channel-send is mode-aware and sound.

fn consumer(inbox, done)
    let lst = recv(inbox)
    let s = 0.0
    let i = 0
    while i < len(lst)
        s = s + lst[i]
        i = i + 1
    send(done, s)

fn main()
    let inbox = channel()
    let done = channel()
    spawn fn() consumer(inbox, done)
    let data = [1.0, 2.0, 3.0, 4.0]
    send(inbox, data)
    let result = recv(done)
    assert(result == 10.0, "deep_copy of float list across channel sums to 10.0")
    print("S4_CHAN_OK")
