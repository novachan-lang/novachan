import forge_pipeline_builder

fn main()
    let pb = pb_new("etl-pipeline")
    pb = pb_add_stage(pb, "parse", "transform")
    pb = pb_add_stage(pb, "validate", "filter")
    pb = pb_add_stage(pb, "enrich", "transform")
    pb = pb_add_stage(pb, "dedup", "filter")
    assert(pb_stage_count(pb) == 4, "4 stages")

    pb = pb_run(pb, 100)
    assert(pb_total_runs(pb) == 1, "1 run")
    assert(pb_total_in(pb) == 100, "100 in")
    assert(pb_stage_processed(pb, "parse") == 100, "parse got 100")
    assert(pb_stage_dropped(pb, "validate") == 25, "validate dropped 25")
    assert(pb_stage_processed(pb, "enrich") == 75, "enrich got 75")
    assert(pb_stage_dropped(pb, "dedup") == 18, "dedup dropped 18")

    let out = pb_total_out(pb)
    assert(out == 57, "57 out")
    assert(pb_throughput_pct(pb) == 57, "57% throughput")

    pb = pb_run(pb, 200)
    assert(pb_total_runs(pb) == 2, "2 runs")
    assert(pb_total_in(pb) == 300, "300 total in")

    assert(pb_stage_processed(pb, "nonexistent") == 0, "missing stage = 0")

    print("PIPELINE-BUILDER KAT PASS")
