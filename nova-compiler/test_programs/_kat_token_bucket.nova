import forge_token_bucket

fn main()
    let tb = tb_new(10, 2)
    assert(tb_available(tb) == 10, "full bucket")

    let r1 = tb_consume(tb, 3, 0)
    tb = r1["tb"]
    assert(r1["allowed"] == 1, "consumed 3")
    assert(r1["remaining"] == 7, "7 remaining")

    let r2 = tb_consume(tb, 5, 0)
    tb = r2["tb"]
    assert(r2["allowed"] == 1, "consumed 5")
    assert(r2["remaining"] == 2, "2 remaining")

    let r3 = tb_consume(tb, 5, 0)
    tb = r3["tb"]
    assert(r3["allowed"] == 0, "rejected (need 5, have 2)")

    let r4 = tb_consume(tb, 1, 2)
    tb = r4["tb"]
    assert(r4["allowed"] == 1, "allowed after refill (2sec * 2/sec = +4)")

    let r5 = tb_try_consume(tb, 2)
    tb = r5["tb"]
    assert(r5["allowed"] == 1, "try_consume ok")

    let tb2 = tb_new(5, 1)
    let rc1 = tb_consume(tb2, 5, 0)
    tb2 = rc1["tb"]
    assert(tb_available(tb2) == 0, "empty")

    let rc2 = tb_consume(tb2, 1, 100)
    tb2 = rc2["tb"]
    assert(rc2["allowed"] == 1, "refilled after 100sec")
    assert(rc2["remaining"] == 4, "capped at capacity 5, consumed 1 = 4")

    let stats = tb_stats(tb2)
    assert(stats["capacity"] == 5, "cap=5")
    assert(stats["refill_rate"] == 1, "rate=1")

    print("TOKEN-BUCKET KAT PASS")
