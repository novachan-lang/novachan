import forge_token_bucket

fn main()
    let b = tb_new(10, 1)
    assert(tb_tokens(b) == 10, "initial 10")
    assert(tb_capacity(b) == 10, "capacity 10")

    let r1 = tb_consume(b, 3, 0)
    assert(is_ok(r1), "consume 3")
    b = unwrap(r1)
    assert(tb_tokens(b) == 7, "7 left")

    let r2 = tb_consume(b, 8, 0)
    assert(is_err(r2), "insufficient")
    assert(tb_total_denied(b) == 1, "1 denied")

    b = tb_refill(b, 5)
    assert(tb_tokens(b) == 10, "refilled to cap")

    assert(tb_allow_rate(b) == 50, "50% allow")
    assert(tb_total_allowed(b) == 1, "1 allowed")

    print("TOKEN-BUCKET KAT PASS")
