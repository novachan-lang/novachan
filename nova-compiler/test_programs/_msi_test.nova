// KAT probe for std/barcode/msi — MSI Plessey barcode.
import std/barcode/msi

fn ck_int(label: string, got: int, want: int)
    if got != want
        print("FAIL msi " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck_str(label: string, got: string, want: string)
    if got != want
        print("FAIL msi " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn ck_starts(label: string, s: string, prefix: string)
    let ok = true
    let pl = len(prefix)
    let sl = len(s)
    if sl < pl
        ok = false
    else
        let i = 0
        while i < pl
            let sc = char_at(s, i)
            let pc = char_at(prefix, i)
            if sc != pc
                ok = false
            i = i + 1
    if not ok
        print("FAIL msi " + label + ": '" + s + "' does not start with '" + prefix + "'")
        exit(1)

fn ck_ends(label: string, s: string, suffix: string)
    let sl = len(s)
    let el = len(suffix)
    let ok = true
    if sl < el
        ok = false
    else
        let offset = sl - el
        let i = 0
        while i < el
            let sc = char_at(s, offset + i)
            let ec = char_at(suffix, i)
            if sc != ec
                ok = false
            i = i + 1
    if not ok
        print("FAIL msi " + label + ": '" + s + "' does not end with '" + suffix + "'")
        exit(1)

fn ck_nonempty(label: string, s: string)
    if len(s) == 0
        print("FAIL msi " + label + ": got empty string")
        exit(1)

fn kat_mod10()
    // msi_check_mod10("1234567") == 4
    // Even-indexed (0,2,4,6): 1,3,5,7 -> 1357 * 2 = 2714 -> digit_sum=14
    // Odd-indexed (1,3,5): 2,4,6 -> sum=12
    // total=26, rem=6, check=4
    let c = msi_check_mod10("1234567")
    ck_int("mod10-1234567", c, 4)
    print("KAT mod10-1234567 PASS: msi_check_mod10('1234567')==4")

    // msi_check_mod10("0") == 0
    // Even-indexed: 0 -> odd_num=0, doubled=0, digit_sum=0
    // Odd-indexed: none
    // total=0, rem=0, check=0
    let c0 = msi_check_mod10("0")
    ck_int("mod10-0", c0, 0)
    print("KAT mod10-0 PASS: msi_check_mod10('0')==0")

    // msi_check_mod10("1") == 8
    // Even: 1 -> odd_num=1, doubled=2, digit_sum=2
    // Odd: none
    // total=2, rem=2, check=8
    let c1 = msi_check_mod10("1")
    ck_int("mod10-1", c1, 8)
    print("KAT mod10-1 PASS: msi_check_mod10('1')==8")

    // msi_check_mod10("12") == 6
    // Even: 1 -> odd_num=1, doubled=2, digit_sum=2
    // Odd: 2
    // total=4, rem=4, check=6
    let c12 = msi_check_mod10("12")
    ck_int("mod10-12", c12, 6)
    print("KAT mod10-12 PASS: msi_check_mod10('12')==6")

fn kat_mod11()
    // msi_check_mod11("1234567") == 4
    // Weights R-to-L: 2,3,4,5,6,7,2 on digits 7,6,5,4,3,2,1
    // 7*2+6*3+5*4+4*5+3*6+2*7+1*2 = 14+18+20+20+18+14+2 = 106
    // 106 mod 11 = 7, check = 11-7 = 4
    let c = msi_check_mod11("1234567")
    ck_int("mod11-1234567", c, 4)
    print("KAT mod11-1234567 PASS: msi_check_mod11('1234567')==4")

    // msi_check_mod11("0") == 0
    // 0*2=0, total=0, rem=0, check=0
    let c0 = msi_check_mod11("0")
    ck_int("mod11-0", c0, 0)
    print("KAT mod11-0 PASS: msi_check_mod11('0')==0")

    // msi_check_mod11("1") == 9
    // 1*2=2, total=2, rem=2, check=11-2=9
    let c1 = msi_check_mod11("1")
    ck_int("mod11-1", c1, 9)
    print("KAT mod11-1 PASS: msi_check_mod11('1')==9")

    // Result must be in 0..10 (valid range for mod-11 check)
    let c9 = msi_check_mod11("9")
    let range_ok = 0
    if c9 >= 0 and c9 <= 10
        range_ok = 1
    ck_int("mod11-9-range", range_ok, 1)
    print("KAT mod11-9-range PASS: msi_check_mod11('9') in 0..10")

fn kat_encode()
    // msi_encode("0"): start + digit_0_pattern + stop
    // digit 0: BCD 0000 -> "100100100100" (12 chars)
    // total: "110" + "100100100100" + "1001" = 3+12+4 = 19 chars
    let enc0 = msi_encode("0")
    ck_nonempty("encode-0-nonempty", enc0)
    ck_int("encode-0-length", len(enc0), 19)
    ck_str("encode-0-exact", enc0, "1101001001001001001")
    print("KAT encode-0 PASS: length=19 exact match")

    // msi_encode("1"): digit 1: BCD 0001 -> "100100100110"
    // total: "110" + "100100100110" + "1001" = 19 chars
    let enc1 = msi_encode("1")
    ck_int("encode-1-length", len(enc1), 19)
    ck_str("encode-1-exact", enc1, "1101001001001101001")
    print("KAT encode-1 PASS")

    // msi_encode("9"): digit 9: BCD 1001 -> "110100100110"
    // total: "110" + "110100100110" + "1001" = 19 chars
    let enc9 = msi_encode("9")
    ck_int("encode-9-length", len(enc9), 19)
    ck_str("encode-9-exact", enc9, "1101101001001101001")
    print("KAT encode-9 PASS")

    // msi_encode("1234567"): 7 digits
    // start(3) + 7*12 + stop(4) = 3+84+4 = 91 chars
    let enc7 = msi_encode("1234567")
    ck_nonempty("encode-1234567-nonempty", enc7)
    ck_int("encode-1234567-length", len(enc7), 91)
    // Must start with "110" (start pattern)
    ck_starts("encode-1234567-start", enc7, "110")
    // Must end with "1001" (stop pattern)
    ck_ends("encode-1234567-stop", enc7, "1001")
    print("KAT encode-1234567 PASS: length=91 start/stop correct")

    // msi_encode("") returns ""
    ck_str("encode-empty", msi_encode(""), "")
    print("KAT encode-empty PASS")

    // msi_encode with non-digit returns ""
    ck_str("encode-nondigit", msi_encode("12A"), "")
    print("KAT encode-nondigit PASS")

fn kat_known_mod10_values()
    // Additional known-value tests for Mod-10
    // msi_check_mod10("123") == 0
    // Even: 1,3 -> odd_num=13, doubled=26, digit_sum=8
    // Odd: 2
    // total=10, rem=0, check=0
    let c123 = msi_check_mod10("123")
    ck_int("mod10-123", c123, 0)
    print("KAT mod10-123 PASS: msi_check_mod10('123')==0")

    // msi_check_mod10("5") == 0
    // Even: 5 -> odd_num=5, doubled=10, digit_sum=1
    // Odd: none -> sum=0
    // total=1, rem=1, check=9
    let c5 = msi_check_mod10("5")
    ck_int("mod10-5", c5, 9)
    print("KAT mod10-5 PASS: msi_check_mod10('5')==9")

fn main()
    kat_mod10()
    kat_mod11()
    kat_encode()
    kat_known_mod10_values()
    print("PASS _msi_test")
