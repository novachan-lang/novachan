import std/os/exitcodes

fn main()
    // KAT 1: ec_ok() == 0
    let v1 = ec_ok()
    if v1 != 0
        print("FAIL: ec_ok() expected 0 got " + str(v1))
        exit(1)

    // KAT 2: ec_usage() == 64
    let v2 = ec_usage()
    if v2 != 64
        print("FAIL: ec_usage() expected 64 got " + str(v2))
        exit(1)

    // KAT 3: ec_software() == 70
    let v3 = ec_software()
    if v3 != 70
        print("FAIL: ec_software() expected 70 got " + str(v3))
        exit(1)

    // KAT 4: ec_tempfail() == 75
    let v4 = ec_tempfail()
    if v4 != 75
        print("FAIL: ec_tempfail() expected 75 got " + str(v4))
        exit(1)

    // KAT 5: ec_config() == 78
    let v5 = ec_config()
    if v5 != 78
        print("FAIL: ec_config() expected 78 got " + str(v5))
        exit(1)

    // KAT 6: ec_name(64) == "EX_USAGE"
    let n64 = ec_name(64)
    if n64 != "EX_USAGE"
        print("FAIL: ec_name(64) expected EX_USAGE got " + n64)
        exit(1)

    // KAT 7: ec_name(0) == "EX_OK"
    let n0 = ec_name(0)
    if n0 != "EX_OK"
        print("FAIL: ec_name(0) expected EX_OK got " + n0)
        exit(1)

    // KAT 8: ec_name(70) == "EX_SOFTWARE"
    let n70 = ec_name(70)
    if n70 != "EX_SOFTWARE"
        print("FAIL: ec_name(70) expected EX_SOFTWARE got " + n70)
        exit(1)

    // KAT 9: ec_is_success(0) == true (1)
    let s0 = ec_is_success(0)
    if s0 != 1
        print("FAIL: ec_is_success(0) expected 1 got " + str(s0))
        exit(1)

    // KAT 10: ec_is_success(1) == false (0)
    let s1 = ec_is_success(1)
    if s1 != 0
        print("FAIL: ec_is_success(1) expected 0 got " + str(s1))
        exit(1)

    // Extra: remaining constants
    let v_general = ec_general()
    if v_general != 1
        print("FAIL: ec_general() expected 1 got " + str(v_general))
        exit(1)

    let v_dataerr = ec_dataerr()
    if v_dataerr != 65
        print("FAIL: ec_dataerr() expected 65 got " + str(v_dataerr))
        exit(1)

    let v_noinput = ec_noinput()
    if v_noinput != 66
        print("FAIL: ec_noinput() expected 66 got " + str(v_noinput))
        exit(1)

    let v_nouser = ec_nouser()
    if v_nouser != 67
        print("FAIL: ec_nouser() expected 67 got " + str(v_nouser))
        exit(1)

    let v_nohost = ec_nohost()
    if v_nohost != 68
        print("FAIL: ec_nohost() expected 68 got " + str(v_nohost))
        exit(1)

    let v_unavailable = ec_unavailable()
    if v_unavailable != 69
        print("FAIL: ec_unavailable() expected 69 got " + str(v_unavailable))
        exit(1)

    let v_oserr = ec_oserr()
    if v_oserr != 71
        print("FAIL: ec_oserr() expected 71 got " + str(v_oserr))
        exit(1)

    let v_cantcreat = ec_cantcreat()
    if v_cantcreat != 73
        print("FAIL: ec_cantcreat() expected 73 got " + str(v_cantcreat))
        exit(1)

    let v_ioerr = ec_ioerr()
    if v_ioerr != 74
        print("FAIL: ec_ioerr() expected 74 got " + str(v_ioerr))
        exit(1)

    let v_protocol = ec_protocol()
    if v_protocol != 76
        print("FAIL: ec_protocol() expected 76 got " + str(v_protocol))
        exit(1)

    let v_noperm = ec_noperm()
    if v_noperm != 77
        print("FAIL: ec_noperm() expected 77 got " + str(v_noperm))
        exit(1)

    // ec_name for unknown code
    let nunk = ec_name(999)
    if nunk != "EX_UNKNOWN"
        print("FAIL: ec_name(999) expected EX_UNKNOWN got " + nunk)
        exit(1)

    // ec_is_success for failure codes
    let s64 = ec_is_success(64)
    if s64 != 0
        print("FAIL: ec_is_success(64) expected 0 got " + str(s64))
        exit(1)

    let s78 = ec_is_success(78)
    if s78 != 0
        print("FAIL: ec_is_success(78) expected 0 got " + str(s78))
        exit(1)

    print("_exitcodes_test passed")
