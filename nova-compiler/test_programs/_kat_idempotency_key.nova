import forge_idempotency_key

fn main()
    let ik = ik_new(3)
    assert(ik_size(ik) == 0, "starts empty")

    let r1 = ik_check(ik, "req-001")
    ik = r1["ik"]
    assert(r1["duplicate"] == 0, "first check = new")

    ik = ik_store(ik, "req-001", "ok-created")
    assert(ik_size(ik) == 1, "1 stored")

    let r2 = ik_check(ik, "req-001")
    ik = r2["ik"]
    assert(r2["duplicate"] == 1, "second check = dup")
    assert(r2["response"] == "ok-created", "cached response")

    ik = ik_store(ik, "req-002", "ok-updated")
    ik = ik_store(ik, "req-003", "ok-deleted")
    assert(ik_size(ik) == 3, "3 stored")

    ik = ik_store(ik, "req-004", "ok-fourth")
    assert(ik_size(ik) == 3, "evicted oldest, still 3")

    let r3 = ik_check(ik, "req-001")
    ik = r3["ik"]
    assert(r3["duplicate"] == 0, "req-001 evicted")

    assert(ik_total_checks(ik) == 3, "3 checks total")
    assert(ik_hit_rate(ik) > 0, "hit rate > 0")

    print("IDEMPOTENCY-KEY KAT PASS")
