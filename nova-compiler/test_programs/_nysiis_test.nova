import std/phonetic/nysiis

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL nysiis " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // ---- KAT: Standard NYSIIS reference vectors ----
    // MAC prefix rule: MAC -> MCC
    cks("MACINTOSH", ny_encode("MACINTOSH"), "MCANTAS")
    // KN prefix rule: KN -> NN; trailing H stripped
    cks("KNUTH", ny_encode("KNUTH"), "NAT")
    // K prefix rule: K -> C; H adjacent to vowel -> prev char; collapse
    cks("KOEHN", ny_encode("KOEHN"), "CAN")
    // PH prefix: PH -> FF; vowels -> A; collapse
    cks("PHILLIPSON", ny_encode("PHILLIPSON"), "FALAPSAN")
    // KN mid-word rule: K -> C; trailing S stripped
    cks("WATKINS", ny_encode("WATKINS"), "WATCAN")
    // Empty input
    cks("empty", ny_encode(""), "")

    // ---- Additional soundness checks ----
    // lowercase input: should work the same
    cks("lower_knuth", ny_encode("knuth"), "NAT")
    cks("lower_watkins", ny_encode("watkins"), "WATCAN")

    // ny_encode_len truncation
    cks("len_5", ny_encode_len("PHILLIPSON", 5), "FALAP")
    cks("len_0", ny_encode_len("WATKINS", 0), "")
    cks("len_large", ny_encode_len("KNUTH", 100), "NAT")

    // ny_first_char
    cks("first_M", ny_first_char("MACINTOSH"), "M")
    cks("first_N", ny_first_char("KNUTH"), "N")
    cks("first_empty", ny_first_char(""), "")

    // ---- ny_translate_char: single-position rules honor the 'next' lookahead ----
    cks("tc_ev",  ny_translate_char("S", "E", "V"), "AF")
    cks("tc_ph",  ny_translate_char("",  "P", "H"), "FF")
    cks("tc_kn",  ny_translate_char("",  "K", "N"), "N")
    cks("tc_k",   ny_translate_char("",  "K", "X"), "C")
    cks("tc_q",   ny_translate_char("",  "Q", ""),  "G")
    cks("tc_z",   ny_translate_char("",  "Z", ""),  "S")
    cks("tc_m",   ny_translate_char("",  "M", ""),  "N")
    cks("tc_vowel", ny_translate_char("", "A", "B"), "A")
    // H between vowels -> previous char; H with no vowel neighbor stays H.
    cks("tc_h_vowel", ny_translate_char("A", "H", "E"), "A")
    cks("tc_h_plain", ny_translate_char("B", "H", "T"), "H")
    // W after vowel -> previous char; otherwise stays W.
    cks("tc_w_vowel", ny_translate_char("A", "W", "T"), "A")
    cks("tc_w_plain", ny_translate_char("B", "W", "T"), "W")
    cks("tc_default", ny_translate_char("", "B", "A"), "B")

    print("PASS _nysiis_test")
