// A struct with no `id` field cannot be addressed by primary key. orm_remove/orm_modify must return err()
// with a clear message rather than building `WHERE id = ?` against a non-existent column (which would
// affect the wrong rows or fail opaquely at the driver). Before the fix these silently misbehaved.
import forge_orm

type Widget
    name: string
    qty: int

fn main()
    let sr = orm_open("sqlite://_orm_noid.db")
    match sr
        Ok(db) =>
            orm_drop_table(db, "Widget")
            orm_ensure(db, Widget("", 0))
            orm_save(db, Widget("bolt", 5))
            let rr = orm_remove(db, Widget("bolt", 5))
            match rr
                Ok(n) =>
                    print("FAIL: orm_remove returned Ok(" + str(n) + ") for a no-id struct")
                    exit(1)
                Err(e) =>
                    let mr = orm_modify(db, Widget("bolt", 9))
                    match mr
                        Ok(n2) =>
                            print("FAIL: orm_modify returned Ok(" + str(n2) + ") for a no-id struct")
                            exit(1)
                        Err(e2) =>
                            orm_close(db)
                            print("PASS _orm_noid_test")
        Err(e) =>
            print("FAIL open: " + e)
            exit(1)
