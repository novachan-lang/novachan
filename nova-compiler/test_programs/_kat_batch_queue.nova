import forge_batch_queue

fn main()
    let q = bq_new(3)
    q = bq_add(q, "item1")
    q = bq_add(q, "item2")
    assert(bq_pending(q) == 2, "2 pending")
    assert(bq_should_flush(q) == 0, "not ready")

    q = bq_add(q, "item3")
    assert(bq_should_flush(q) == 1, "ready to flush")

    let f1 = bq_flush(q)
    assert(is_ok(f1), "flush ok")
    q = unwrap(f1)
    assert(bq_pending(q) == 0, "0 pending after flush")
    assert(bq_total_flushed(q) == 3, "3 flushed")
    assert(bq_flush_count(q) == 1, "1 flush")

    let bad = bq_flush(q)
    assert(is_err(bad), "nothing to flush")

    q = bq_add(q, "a")
    q = bq_add(q, "b")
    let f2 = bq_flush(q)
    assert(is_ok(f2), "flush partial")
    q = unwrap(f2)
    assert(bq_total_flushed(q) == 5, "5 total flushed")

    print("BATCH-QUEUE KAT PASS")
