fn main()
    print("A. literal string \"0\":  type_name={type_name("0")}")
    let d = {}
    d["k"] = "0"
    print("B. dict round-trip \"0\": type_name={type_name(d["k"])} str={str(d["k"])}")
    d["k2"] = "1"
    print("C. dict round-trip \"1\": type_name={type_name(d["k2"])}")
    // exactly what the mysql decoder does
    let b = bytes_from_list([48])          // ascii '0'
    let s0 = bytes_to_str(b)
    print("D. bytes_to_str([48]):  type_name={type_name(s0)} str={s0} len={len(s0)}")
    let b1 = bytes_from_list([49])         // ascii '1'
    let s1 = bytes_to_str(b1)
    print("E. bytes_to_str([49]):  type_name={type_name(s1)} str={s1}")
    let d2 = {}
    d2["c"] = s0
    print("F. dict(bytes_to_str '0'): type_name={type_name(d2["c"])} str={str(d2["c"])}")
    print("G. missing key default:  type_name={type_name(d2["nope"])} str={str(d2["nope"])}")
