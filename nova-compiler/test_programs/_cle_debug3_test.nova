fn _cle_argv_val(argv, name) -> string
    let n = len(argv)
    let nlen = len(name)
    let i = 0
    while i < n
        let tok = argv[i]
        print("tok='" + tok + "' name='" + name + "' eq=" + str(tok == name))
        if tok == name
            print("match! i=" + str(i) + " n=" + str(n))
            if i + 1 < n
                let r = argv[i+1]
                print("returning r='" + r + "' len=" + str(len(r)))
                return r
            return ""
        if len(tok) > nlen
            if slice(tok, 0, nlen) == name
                if slice(tok, nlen, nlen+1) == "="
                    return slice(tok, nlen+1, len(tok))
        i = i + 1
    return ""

fn main()
    let a1 = ["--port", "9"]
    let v = _cle_argv_val(a1, "--port")
    print("final v='" + v + "' len=" + str(len(v)))
