// KAT test for std/term/progress.nova
// Tests: bar, bar_chars, pct_str, gauge

import std/term/progress

fn _assert_eq(label: string, got: string, want: string)
    if got == want
        print("  ok  " + label)
    else
        print("FAIL progress " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        print("     got  [" + got + "]")
        print("     want [" + want + "]")
        exit(1)

fn main()
    // bar: 50% of 10 -> 5 filled, 5 empty
    _assert_eq("bar(50,10)", bar(50, 10), "[#####-----]")

    // bar: 0% of 4 -> 0 filled, 4 empty
    _assert_eq("bar(0,4)", bar(0, 4), "[----]")

    // bar: 100% of 4 -> 4 filled, 0 empty
    _assert_eq("bar(100,4)", bar(100, 4), "[####]")

    // bar_chars: 50% of 4 -> 2 filled, 2 empty
    _assert_eq("bar_chars(50,4,=,.)", bar_chars(50, 4, "=", "."), "[==..]")

    // pct_str: 3/4 = 75%
    _assert_eq("pct_str(3,4)", pct_str(3, 4), "75%")

    // pct_str: 1/3 = 33 (integer floor)
    _assert_eq("pct_str(1,3)", pct_str(1, 3), "33%")

    // pct_str: 0/0 = guard div-by-zero -> 0%
    _assert_eq("pct_str(0,0)", pct_str(0, 0), "0%")

    // gauge: 5/10 across width 10 -> same as bar(50,10)
    _assert_eq("gauge(5,10,10)", gauge(5, 10, 10), "[#####-----]")

    // gauge: max<=0 -> empty bar
    _assert_eq("gauge(5,0,4)", gauge(5, 0, 4), "[----]")

    // bar: clamp percent > 100
    _assert_eq("bar(150,4)", bar(150, 4), "[####]")

    // bar: clamp percent < 0
    _assert_eq("bar(-5,4)", bar(-5, 4), "[----]")

    // bar_chars: 25% of 8 -> 2 filled, 6 empty
    _assert_eq("bar_chars(25,8,#,-)", bar_chars(25, 8, "#", "-"), "[##------]")

    // pct_str: 0/5 = 0%
    _assert_eq("pct_str(0,5)", pct_str(0, 5), "0%")

    // pct_str: 5/5 = 100%
    _assert_eq("pct_str(5,5)", pct_str(5, 5), "100%")

    // width clamped to 1 minimum — 50%*1 = 0 filled (integer floor), so empty char
    _assert_eq("bar(50,0)", bar(50, 0), "[-]")

    print("PASS _progress_test")
