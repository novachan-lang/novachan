// KAT test for std/util/progress.nova
// Tests: prog_percent, prog_bar, prog_spinner

import std/util/progress

// Count occurrences of single char c in string s
fn _prog_count_char(s, c) -> int
    let n = len(s)
    let i = 0
    let total = 0
    while i < n
        let ch = slice(s, i, i+1)
        if ch == c
            total = total + 1
        i = i + 1
    total

// Check if haystack contains needle
fn _prog_contains(haystack, needle) -> int
    let hlen = len(haystack)
    let nlen = len(needle)
    let i = 0
    let found = 0
    while i <= hlen - nlen
        let seg = slice(haystack, i, i+nlen)
        if seg == needle
            found = 1
        i = i + 1
    found

fn main()
    // KAT 1: prog_percent(50,100) == 50
    let r1 = prog_percent(50, 100)
    if r1 != 50
        print("FAIL KAT1: prog_percent(50,100) expected 50 got " + str(r1))
        exit(1)

    // KAT 2: prog_percent(1,3) == 33
    let r2 = prog_percent(1, 3)
    if r2 != 33
        print("FAIL KAT2: prog_percent(1,3) expected 33 got " + str(r2))
        exit(1)

    // KAT 3: prog_percent(0,10) == 0
    let r3 = prog_percent(0, 10)
    if r3 != 0
        print("FAIL KAT3: prog_percent(0,10) expected 0 got " + str(r3))
        exit(1)

    // KAT 4: prog_percent(10,10) == 100
    let r4 = prog_percent(10, 10)
    if r4 != 100
        print("FAIL KAT4: prog_percent(10,10) expected 100 got " + str(r4))
        exit(1)

    // KAT 5: prog_bar(5,10,10) contains "50%"
    let b5 = prog_bar(5, 10, 10)
    let f5 = _prog_contains(b5, "50%")
    if f5 != 1
        print("FAIL KAT5: prog_bar(5,10,10) should contain 50% got: " + b5)
        exit(1)

    // KAT 6: fill portion of prog_bar(5,10,10) has exactly 5 "#" chars
    let b6 = prog_bar(5, 10, 10)
    let h6 = _prog_count_char(b6, "#")
    if h6 != 5
        print("FAIL KAT6: expected 5 '#' chars got " + str(h6) + " in: " + b6)
        exit(1)

    // KAT 7: prog_bar(0,10,10) contains "0%"
    let b7 = prog_bar(0, 10, 10)
    let f7 = _prog_contains(b7, "0%")
    if f7 != 1
        print("FAIL KAT7: prog_bar(0,10,10) should contain 0% got: " + b7)
        exit(1)

    // KAT 8: prog_bar(10,10,10) contains "100%"
    let b8 = prog_bar(10, 10, 10)
    let f8 = _prog_contains(b8, "100%")
    if f8 != 1
        print("FAIL KAT8: prog_bar(10,10,10) should contain 100% got: " + b8)
        exit(1)

    // KAT 9: prog_spinner(0) == "|"
    let s9 = prog_spinner(0)
    if s9 != "|"
        print("FAIL KAT9: prog_spinner(0) expected | got " + s9)
        exit(1)

    // KAT 10: prog_spinner(4) == "|"  (cycles mod 4)
    let s10 = prog_spinner(4)
    if s10 != "|"
        print("FAIL KAT10: prog_spinner(4) expected | got " + s10)
        exit(1)

    print("_progress_test passed")
