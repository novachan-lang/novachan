import forge_webhook_manager

fn main()
    let wm = whm_new()
    let evts1 = ["order.created", "order.updated"]
    wm = whm_register(wm, "https://hook.example.com/orders", evts1)
    let id1 = whm_last_id(wm)
    let evts2 = ["*"]
    wm = whm_register(wm, "https://hook.example.com/all", evts2)
    let id2 = whm_last_id(wm)

    let eps = whm_list_endpoints(wm)
    assert(id2 > 0, "id2 valid")
    assert(len(eps) == 2, "2 endpoints")

    wm = whm_dispatch(wm, "order.created", "order-123")
    assert(whm_delivery_count(wm) == 2, "2 deliveries (both match)")

    wm = whm_dispatch(wm, "user.signup", "user-456")
    assert(whm_delivery_count(wm) == 3, "3 total (wildcard only)")

    assert(whm_pending_count(wm) == 3, "3 pending")

    wm = whm_mark_delivered(wm, 0)
    assert(whm_pending_count(wm) == 2, "2 pending after deliver")

    wm = whm_mark_failed(wm, 1)
    assert(wm["deliveries"][1]["status"] == "failed", "marked failed")

    wm = whm_deactivate(wm, id1)
    wm = whm_dispatch(wm, "order.created", "order-789")
    assert(whm_delivery_count(wm) == 4, "4 total (only wildcard)")

    print("WEBHOOK-MANAGER KAT PASS")
