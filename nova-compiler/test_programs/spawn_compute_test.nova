// Parallel computation: two workers compute partial sums
ch1 = channel()
ch2 = channel()

spawn fn()
    sum = 0
    i = 1
    while i <= 50
        sum = sum + i
        i = i + 1
    send(ch1, sum)

spawn fn()
    sum = 0
    i = 51
    while i <= 100
        sum = sum + i
        i = i + 1
    send(ch2, sum)

a = receive(ch1)
b = receive(ch2)
print(a + b)
