// json_ctrl_escape_test -- json_stringify must escape ALL control chars U+0000..U+001F (RFC 8259), so a
// string carrying a control byte (e.g. user data with a form-feed/SOH) produces VALID JSON that a strict
// parser accepts -- not a raw control byte that JSON.parse rejects. Structural escapes (quote/backslash/
// newline) must still hold (no injection).
fn main()
    let d = {}
    d["k"] = "a" + chr(1) + chr(11) + chr(31) + "b"     // SOH (0x01) + VT (0x0b) + US (0x1f): no short form
    let j = json_stringify(d)
    if find(j, "\\u0001") < 0
        print("FAIL: SOH (0x01) not escaped -> " + j)
        exit(1)
    if find(j, "\\u000b") < 0
        print("FAIL: VT (0x0b) not escaped -> " + j)
        exit(1)
    if find(j, "\\u001f") < 0
        print("FAIL: US (0x1f) not escaped -> " + j)
        exit(1)

    // backspace + form-feed short forms
    let d2 = {}
    d2["k"] = chr(8) + chr(12)
    let j2 = json_stringify(d2)
    if find(j2, "\\b") < 0 or find(j2, "\\f") < 0
        print("FAIL: \\b/\\f not escaped -> " + j2)
        exit(1)

    // structural + whitespace escapes still hold (no injection / regression)
    let d3 = {}
    d3["k"] = "say \"hi\"\n\tx\\y"
    let j3 = json_stringify(d3)
    if find(j3, "\\\"") < 0 or find(j3, "\\n") < 0 or find(j3, "\\t") < 0 or find(j3, "\\\\") < 0
        print("FAIL: structural/whitespace escaping regressed -> " + j3)
        exit(1)

    // a plain ASCII value is unchanged -- no spurious escaping. (Check by content; a literal '{' in an
    // expected string would be INTERPOLATED by NOVA, so avoid it.)
    let d4 = {}
    d4["k"] = "hello world"
    let j4 = json_stringify(d4)
    if find(j4, "hello world") < 0
        print("FAIL: plain text mangled -> " + j4)
        exit(1)
    if find(j4, "\\u") >= 0
        print("FAIL: plain ASCII wrongly escaped -> " + j4)
        exit(1)

    print("PASS json_ctrl_escape (control chars 0x00-0x1F -> \\u00XX / \\b \\f; quotes/newlines/backslash intact)")
