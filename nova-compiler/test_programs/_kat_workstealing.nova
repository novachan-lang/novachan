// KAT: work-stealing scheduler (ws_spawn) - proves tasks actually EXECUTE on the
// stealing worker pool, and that ws_spawn is usable WITHOUT an explicit pool init
// (it used to be an integer division-by-zero: ws_init was never exposed to NOVA).
let ch = channel()

fn worker()
    send(ch, 7)

fn main()
    let n = 24
    let i = 0
    while i < n
        ws_spawn(worker)
        i = i + 1

    let total = 0
    let got = 0
    while got < n
        total = total + recv(ch)
        got = got + 1

    print("received=" + str(got))
    print("total=" + str(total))
    if got == n and total == n * 7
        print("KAT ws PASS")
    else
        print("KAT ws FAIL")
