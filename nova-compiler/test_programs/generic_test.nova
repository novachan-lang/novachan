fn identity(x)
    x

fn first_of(xs)
    xs[0]

fn apply_twice(f, v)
    f(f(v))

fn inc(n)
    n + 1

fn pair_sum(a, b)
    a + b

let n = identity(42)
let s = identity("hello")
print(n)
print(s)

let nums = [10, 20, 30]
print(first_of(nums))

let words = ["alpha", "beta", "gamma"]
print(first_of(words))

print(apply_twice(inc, 5))
print(pair_sum(3, 4))
print(identity(n) + 1)
