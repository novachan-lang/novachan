// KAT test for std/data/po_build
import std/data/po_build
import std/data/po_parse

fn cks(label, got, expected)
    if got != expected
        print("FAIL po_build " + label + ": got=[" + got + "] expected=[" + expected + "]")
        exit(1)

fn cki(label, got, expected)
    if got != expected
        print("FAIL po_build " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

fn check_contains(label, haystack, needle)
    let found = 0
    let hlen = len(haystack)
    let nlen = len(needle)
    let i = 0
    while i + nlen <= hlen
        let frag = slice(haystack, i, i + nlen)
        if frag == needle
            found = 1
        i = i + 1
    if found == 0
        print("FAIL po_build " + label + ": [" + haystack + "] does not contain [" + needle + "]")
        exit(1)

let lf = chr(10)
let dq = chr(34)

// ── KAT 1: basic single entry (no comments) ───────────────────────────────────
let e1 = {}
e1["msgid"]    = "hello"
e1["msgstr"]   = "bonjour"
e1["comments"] = []
let out1 = po_build([e1])

// Must contain the quoted forms
check_contains("k1_msgid",  out1, "msgid " + dq + "hello" + dq)
check_contains("k1_msgstr", out1, "msgstr " + dq + "bonjour" + dq)

// ── KAT 2: entry with a comment ───────────────────────────────────────────────
let e2 = {}
e2["msgid"]    = "world"
e2["msgstr"]   = "monde"
let coms2 = ["translator note"]
e2["comments"] = coms2
let out2 = po_build([e2])
check_contains("k2_comment",  out2, "# translator note")
check_contains("k2_msgid",   out2, "msgid " + dq + "world" + dq)
check_contains("k2_msgstr",  out2, "msgstr " + dq + "monde" + dq)

// ── KAT 3: quote escaping ─────────────────────────────────────────────────────
let e3 = {}
e3["msgid"]    = "say \"hi\""
e3["msgstr"]   = "dites \"salut\""
e3["comments"] = []
let out3 = po_build([e3])
// The escaped form must appear
check_contains("k3_escape_mid",  out3, "msgid " + dq + "say \\\"hi\\\"" + dq)
check_contains("k3_escape_str",  out3, "msgstr " + dq + "dites \\\"salut\\\"" + dq)

// ── KAT 4: round-trip through po_parse ───────────────────────────────────────
let entries_rt = []
let rt1 = {}
rt1["msgid"]    = "alpha"
rt1["msgstr"]   = "alfa"
rt1["comments"] = []
push(entries_rt, rt1)
let rt2 = {}
rt2["msgid"]    = "beta"
rt2["msgstr"]   = "bete"
let rt2c = ["note for beta"]
rt2["comments"] = rt2c
push(entries_rt, rt2)

let built = po_build(entries_rt)
let parsed = po_parse(built)

cki("rt_count",   len(parsed),           2)
cks("rt_mid0",    parsed[0]["msgid"],    "alpha")
cks("rt_str0",    parsed[0]["msgstr"],   "alfa")
cks("rt_mid1",    parsed[1]["msgid"],    "beta")
cks("rt_str1",    parsed[1]["msgstr"],   "bete")

// ── KAT 5: round-trip preserves escaped quote ─────────────────────────────────
let entries_q = []
let qe = {}
qe["msgid"]    = "q"
qe["msgstr"]   = "say \"hi\""
qe["comments"] = []
push(entries_q, qe)
let built_q = po_build(entries_q)
let parsed_q = po_parse(built_q)
cki("q_count",  len(parsed_q),             1)
cks("q_msgstr", parsed_q[0]["msgstr"],     "say \"hi\"")

// ── KAT 6: newline escape round-trip ─────────────────────────────────────────
let entries_nl = []
let nle = {}
nle["msgid"]    = "nl"
nle["msgstr"]   = "line1" + lf + "line2"
nle["comments"] = []
push(entries_nl, nle)
let built_nl = po_build(entries_nl)
check_contains("nl_escape", built_nl, "\\n")
let parsed_nl = po_parse(built_nl)
cki("nl_count",  len(parsed_nl),           1)
cks("nl_msgstr", parsed_nl[0]["msgstr"],   "line1" + lf + "line2")

// ── KAT 7: empty entries list ────────────────────────────────────────────────
let out7 = po_build([])
cks("empty_build", out7, "")

print("PASS _po_build_test")
