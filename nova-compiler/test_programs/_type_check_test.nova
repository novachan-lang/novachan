import std/typesystem/type_check

// --- check helpers ---

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn ckb(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + got + " expected " + expected)
        exit(1)

// ckt: check two types are structurally equal
fn ckt(label, a, b)
    let eq = type_check.tchk_type_eq(a, b)
    if eq == 0
        print("FAIL " + label + ": types not equal")
        exit(1)

// ckfail: check that result is "FAIL"
fn ckfail(label, got)
    if type_of(got) != "string"
        print("FAIL " + label + ": expected FAIL string, got a type")
        exit(1)
    if got != "FAIL"
        print("FAIL " + label + ": expected FAIL, got " + got)
        exit(1)

fn main()
    // --- KAT 1: tchk_infer_st([], lamA "x" int (var "x")) == int -> int ---
    let term_id = []
    push(term_id, "lamA")
    push(term_id, "x")
    push(term_id, type_check.tyc_int())
    let body_x = []
    push(body_x, "var")
    push(body_x, "x")
    push(term_id, body_x)
    let env0 = []
    let result1 = type_check.tchk_infer_st(env0, term_id)
    let expected1 = type_check.tyc_arr(type_check.tyc_int(), type_check.tyc_int())
    ckt("infer_id_int", result1, expected1)

    // --- KAT 2: app of (int->bool) to int gives bool ---
    // Build: lamA "x" int (ann (var "x") bool)  -- NO: that would fail because x:int != bool
    // Instead: put (int->bool) fn in env, apply to int var
    // env = [["f", int->bool], ["n", int]]
    // term = app (var "f") (var "n")
    let ty_int_to_bool = type_check.tyc_arr(type_check.tyc_int(), type_check.tyc_bool())
    let env2 = []
    let pair_f = []
    push(pair_f, "f")
    push(pair_f, ty_int_to_bool)
    push(env2, pair_f)
    let pair_n = []
    push(pair_n, "n")
    push(pair_n, type_check.tyc_int())
    push(env2, pair_n)
    let term2 = []
    push(term2, "app")
    let var_f = []
    push(var_f, "var")
    push(var_f, "f")
    push(term2, var_f)
    let var_n = []
    push(var_n, "var")
    push(var_n, "n")
    push(term2, var_n)
    let result2 = type_check.tchk_infer_st(env2, term2)
    ckt("app_int_bool_gives_bool", result2, type_check.tyc_bool())

    // --- KAT 3: app of (int->bool) to bool == FAIL ---
    let env3 = []
    let pf3 = []
    push(pf3, "f")
    push(pf3, ty_int_to_bool)
    push(env3, pf3)
    let pb3 = []
    push(pb3, "b")
    push(pb3, type_check.tyc_bool())
    push(env3, pb3)
    let term3 = []
    push(term3, "app")
    let vf3 = []
    push(vf3, "var")
    push(vf3, "f")
    push(term3, vf3)
    let vb3 = []
    push(vb3, "var")
    push(vb3, "b")
    push(term3, vb3)
    let result3 = type_check.tchk_infer_st(env3, term3)
    ckfail("app_int_bool_to_bool_FAIL", result3)

    // --- KAT 4: tchk_check for identity function ---
    let check4 = type_check.tchk_check(env0, term_id, type_check.tyc_arr(type_check.tyc_int(), type_check.tyc_int()))
    cki("check_id_int_true", check4, 1)

    // --- KAT 5: wrong annotation -> check returns false ---
    let check5 = type_check.tchk_check(env0, term_id, type_check.tyc_arr(type_check.tyc_bool(), type_check.tyc_bool()))
    cki("check_id_wrong_type_false", check5, 0)

    // --- KAT 6: nested lamA gives curried arrow: lamA "x" int (lamA "y" bool (var "x")) -> int->bool->int ---
    let inner_body = []
    push(inner_body, "var")
    push(inner_body, "x")
    let inner_lam = []
    push(inner_lam, "lamA")
    push(inner_lam, "y")
    push(inner_lam, type_check.tyc_bool())
    push(inner_lam, inner_body)
    let outer_lam = []
    push(outer_lam, "lamA")
    push(outer_lam, "x")
    push(outer_lam, type_check.tyc_int())
    push(outer_lam, inner_lam)
    let result6 = type_check.tchk_infer_st(env0, outer_lam)
    let expected6 = type_check.tyc_arr(type_check.tyc_int(), type_check.tyc_arr(type_check.tyc_bool(), type_check.tyc_int()))
    ckt("nested_lamA_curried_arrow", result6, expected6)

    // --- KAT 7: var not in env -> FAIL ---
    let term7 = []
    push(term7, "var")
    push(term7, "z")
    let result7 = type_check.tchk_infer_st(env0, term7)
    ckfail("var_not_in_env_FAIL", result7)

    // --- KAT 8: ann term with correct type passes ---
    let ann_term = []
    push(ann_term, "ann")
    let var_x_ann = []
    push(var_x_ann, "var")
    push(var_x_ann, "x")
    push(ann_term, var_x_ann)
    push(ann_term, type_check.tyc_int())
    let env8 = []
    let p8 = []
    push(p8, "x")
    push(p8, type_check.tyc_int())
    push(env8, p8)
    let result8 = type_check.tchk_infer_st(env8, ann_term)
    ckt("ann_correct_type", result8, type_check.tyc_int())

    // --- KAT 9: ann term with wrong type -> FAIL ---
    let ann_term9 = []
    push(ann_term9, "ann")
    let var_x9 = []
    push(var_x9, "var")
    push(var_x9, "x")
    push(ann_term9, var_x9)
    push(ann_term9, type_check.tyc_bool())
    let result9 = type_check.tchk_infer_st(env8, ann_term9)
    ckfail("ann_wrong_type_FAIL", result9)

    // --- KAT 10: lexical SHADOWING regression. lamA x:bool.(lamA x:int. x) must be
    // bool -> (int -> int) — the inner x:int shadows the outer x:bool. (Env lookup
    // must scan newest-first; the previous forward scan returned bool for the inner x.)
    let sh_inner = ["lamA", "x", type_check.tyc_int(), ["var", "x"]]
    let sh_outer = ["lamA", "x", type_check.tyc_bool(), sh_inner]
    let sh_got = type_check.tchk_infer_st([], sh_outer)
    let sh_want = type_check.tyc_arr(type_check.tyc_bool(), type_check.tyc_arr(type_check.tyc_int(), type_check.tyc_int()))
    ckt("shadow_inner_wins", sh_got, sh_want)

    print("PASS _type_check_test")

main()
