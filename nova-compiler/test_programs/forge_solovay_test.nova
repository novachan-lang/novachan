import forge_solovay as ss

fn check(cond: bool, label: str)
    if cond == false
        print("FAIL: " + label)

// TEST 1: Small known primes
check(ss.solovay_is_prime(2), "2 prime")
check(ss.solovay_is_prime(3), "3 prime")
check(ss.solovay_is_prime(5), "5 prime")
check(ss.solovay_is_prime(7), "7 prime")
check(ss.solovay_is_prime(11), "11 prime")
check(ss.solovay_is_prime(13), "13 prime")
check(ss.solovay_is_prime(97), "97 prime")
check(ss.solovay_is_prime(101), "101 prime")
check(ss.solovay_is_prime(1000000007), "1e9+7 prime")

// TEST 2: Small composites
check(ss.solovay_is_prime(1) == false, "1 not prime")
check(ss.solovay_is_prime(4) == false, "4 not prime")
check(ss.solovay_is_prime(9) == false, "9 not prime")
check(ss.solovay_is_prime(15) == false, "15 not prime")
check(ss.solovay_is_prime(100) == false, "100 not prime")

// TEST 3: Carmichael numbers (fools Fermat test but NOT Solovay-Strassen)
// 561 = 3*11*17, 1105 = 5*13*17, 1729 = 7*13*19
check(ss.solovay_is_prime(561) == false, "561 Carmichael not prime")
check(ss.solovay_is_prime(1105) == false, "1105 Carmichael not prime")
check(ss.solovay_is_prime(1729) == false, "1729 Carmichael not prime")
check(ss.solovay_is_prime(8911) == false, "8911 Carmichael not prime")

// TEST 4: Euler witness test directly
// For n=561 (Carmichael), witness a=2: 2^280 mod 561 should != jacobi(2,561)
check(ss.is_euler_witness(2, 7), "a=2 witness of 7 passes")
// For a prime, all valid witnesses pass
check(ss.is_euler_witness(2, 11), "a=2 witness of 11 passes")
check(ss.is_euler_witness(3, 11), "a=3 witness of 11 passes")

// TEST 5: solovay_strassen with explicit witness list
let w1 = [2, 3, 5, 7]
check(ss.solovay_strassen(97, w1), "97 prime via witnesses")
check(ss.solovay_strassen(100, w1) == false, "100 composite via witnesses")

// TEST 6: DECISIVE cross-check - agree with trial division on all n in [2, 300]
fn is_prime_trial(n: int) -> bool
    if n < 2
        return false
    let d = 2
    while d * d <= n
        if n % d == 0
            return false
        d = d + 1
    return true

let mismatches = 0
let n = 2
while n <= 300
    let expected = is_prime_trial(n)
    let got = ss.solovay_is_prime(n)
    if expected != got
        print("MISMATCH at n=" + str(n) + " expected=" + str(expected) + " got=" + str(got))
        mismatches = mismatches + 1
    n = n + 1
check(mismatches == 0, "Solovay agrees with trial division for all n<=300")

// TEST 7: Large semi-prime (product of two large primes) is correctly composite
// 104729 * 104723 = known composite of two distinct primes
let big_composite = 104729 * 104723
check(ss.solovay_is_prime(big_composite) == false, "product of two primes is composite")

// TEST 8: Mersenne primes known from lucas_lehmer test
check(ss.solovay_is_prime(7), "M_3=7 prime")
check(ss.solovay_is_prime(31), "M_5=31 prime")
check(ss.solovay_is_prime(127), "M_7=127 prime")
check(ss.solovay_is_prime(8191), "M_13=8191 prime")

print("forge_solovay: KAT done")
