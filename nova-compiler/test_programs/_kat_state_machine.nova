import forge_state_machine

fn main()
    let m = fsm_new("idle")
    m = fsm_add_transition(m, "idle", "start", "running")
    m = fsm_add_transition(m, "running", "pause", "paused")
    m = fsm_add_transition(m, "paused", "resume", "running")
    m = fsm_add_transition(m, "running", "stop", "idle")
    assert(fsm_transition_count(m) == 4, "4 transitions")
    assert(fsm_current(m) == "idle", "starts idle")

    assert(fsm_can_send(m, "start") == 1, "can start")
    assert(fsm_can_send(m, "pause") == 0, "cant pause from idle")

    let r1 = fsm_send(m, "start")
    assert(is_ok(r1), "start ok")
    m = unwrap(r1)
    assert(fsm_current(m) == "running", "now running")

    let r2 = fsm_send(m, "pause")
    assert(is_ok(r2), "pause ok")
    m = unwrap(r2)
    assert(fsm_current(m) == "paused", "now paused")
    assert(fsm_total_transitions(m) == 2, "2 transitions taken")

    let bad = fsm_send(m, "stop")
    assert(is_err(bad), "cant stop from paused")

    print("STATE-MACHINE KAT PASS")
