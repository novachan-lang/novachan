import forge_state_machine

fn main()
    let sm = fsm_new("idle")
    sm = fsm_add_transition(sm, "idle", "start", "running")
    sm = fsm_add_transition(sm, "running", "pause", "paused")
    sm = fsm_add_transition(sm, "paused", "resume", "running")
    sm = fsm_add_transition(sm, "running", "stop", "idle")
    assert(fsm_transition_count(sm) == 4, "4 transitions")
    assert(fsm_current(sm) == "idle", "starts idle")

    assert(fsm_can_send(sm, "start") == 1, "can start")
    assert(fsm_can_send(sm, "pause") == 0, "cant pause from idle")

    sm = fsm_send(sm, "start")
    assert(fsm_current(sm) == "running", "now running")

    sm = fsm_send(sm, "pause")
    assert(fsm_current(sm) == "paused", "now paused")

    sm = fsm_send(sm, "resume")
    assert(fsm_current(sm) == "running", "resumed")

    let avail = fsm_available_events(sm)
    assert(len(avail) == 2, "2 events from running")

    sm = fsm_send(sm, "invalid")
    assert(fsm_current(sm) == "running", "invalid event = no change")

    let hist = fsm_history(sm)
    assert(fsm_history_count(sm) == 4, "4 history entries")
    assert(hist[0] == "idle", "history starts idle")
    assert(hist[3] == "running", "history ends running")

    sm = fsm_reset(sm)
    assert(fsm_current(sm) == "idle", "reset to idle")
    assert(fsm_history_count(sm) == 1, "history reset")

    print("STATE-MACHINE KAT PASS")
