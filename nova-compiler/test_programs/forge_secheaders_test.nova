// forge_secheaders_test -- mw_security_headers adds the standard defense-in-depth headers to
// every response (nosniff / X-Frame-Options / Referrer-Policy), and the handler's body is intact.
import forge

type Msg
    ok: bool

fn h(req: Request) -> Msg
    Msg(true)

fn main()
    let q = chr(34)
    let a = forge.app()
    forge.use(a, forge.mw_security_headers())
    forge.get(a, "/x", h)

    let r: Response = forge.dispatch_req(a, forge.build_request("GET /x HTTP/1.1\r\n\r\n", 0))
    assert(r.status == 200, "200")
    assert(r.headers["X-Content-Type-Options"] == "nosniff", "nosniff")
    assert(r.headers["X-Frame-Options"] == "SAMEORIGIN", "frame-options SAMEORIGIN")
    assert(r.headers["Referrer-Policy"] == "no-referrer", "referrer-policy")
    assert(find(r.body, q + "ok" + q + ":true") >= 0, "handler body intact through middleware")
    print("PASS: security headers added + body intact")
    print("forge_secheaders_test passed")
