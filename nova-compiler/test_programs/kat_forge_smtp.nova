// KAT for forge_smtp -- known-answer tests for SMTP command builders, reply parser, and AUTH LOGIN
// base64 framing. Pure-function coverage only (no live SMTP server in this harness).
import forge_smtp

fn main()
    let crlf = chr(13) + chr(10)

    // EHLO "mail.x.com" -> "EHLO mail.x.com\r\n"
    let c1 = smtp_cmd_ehlo("mail.x.com")
    if c1 != "EHLO mail.x.com" + crlf
        print("FAIL ehlo: " + c1)
        exit(1)

    // MAIL FROM "a@b.com" -> "MAIL FROM:<a@b.com>\r\n"
    let c2 = smtp_cmd_mail_from("a@b.com")
    if c2 != "MAIL FROM:<a@b.com>" + crlf
        print("FAIL mail_from: " + c2)
        exit(1)

    // RCPT TO "c@d.com" -> "RCPT TO:<c@d.com>\r\n"
    let c3 = smtp_cmd_rcpt_to("c@d.com")
    if c3 != "RCPT TO:<c@d.com>" + crlf
        print("FAIL rcpt_to: " + c3)
        exit(1)

    // DATA -> "DATA\r\n"
    let c4 = smtp_cmd_data()
    if c4 != "DATA" + crlf
        print("FAIL data: " + c4)
        exit(1)

    // end-of-data "." -> ".\r\n"
    let c5 = smtp_cmd_dot()
    if c5 != "." + crlf
        print("FAIL dot: " + c5)
        exit(1)

    // QUIT -> "QUIT\r\n"
    let c6 = smtp_cmd_quit()
    if c6 != "QUIT" + crlf
        print("FAIL quit: " + c6)
        exit(1)

    // STARTTLS -> "STARTTLS\r\n"
    let c7 = smtp_cmd_starttls()
    if c7 != "STARTTLS" + crlf
        print("FAIL starttls: " + c7)
        exit(1)

    // AUTH LOGIN -> "AUTH LOGIN\r\n"
    let c8 = smtp_cmd_auth_login()
    if c8 != "AUTH LOGIN" + crlf
        print("FAIL auth_login: " + c8)
        exit(1)

    // HELO fallback -> "HELO mail.x.com\r\n"
    let c9 = smtp_cmd_helo("mail.x.com")
    if c9 != "HELO mail.x.com" + crlf
        print("FAIL helo: " + c9)
        exit(1)

    // RSET -> "RSET\r\n"
    let c10 = smtp_cmd_rset()
    if c10 != "RSET" + crlf
        print("FAIL rset: " + c10)
        exit(1)

    // AUTH LOGIN base64 framing: base64("user") == "dXNlcg==" then CRLF.
    let ub = smtp_auth_b64_line("user")
    if ub != "dXNlcg==" + crlf
        print("FAIL auth_b64 user: " + ub)
        exit(1)

    // parse multi-line "250-mail\r\n250-PIPELINING\r\n250 AUTH\r\n" -> code 250, 3 lines, complete=1.
    let block = "250-mail" + crlf + "250-PIPELINING" + crlf + "250 AUTH" + crlf
    let r1 = smtp_parse_reply(block)
    if r1["code"] != 250
        print("FAIL parse code: " + str(r1["code"]))
        exit(1)
    if len(r1["lines"]) != 3
        print("FAIL parse lines count: " + str(len(r1["lines"])))
        exit(1)
    if r1["lines"][0] != "mail" or r1["lines"][1] != "PIPELINING" or r1["lines"][2] != "AUTH"
        print("FAIL parse lines content")
        exit(1)
    if r1["complete"] != 1
        print("FAIL parse complete flag")
        exit(1)
    if smtp_reply_ok(r1) != 1
        print("FAIL parse reply_ok")
        exit(1)

    // parse "250-first\r\n" alone -> complete=false.
    let partial = "250-first" + crlf
    let r2 = smtp_parse_reply(partial)
    if r2["complete"] != 0
        print("FAIL partial complete flag: " + str(r2["complete"]))
        exit(1)
    if r2["code"] != 250
        print("FAIL partial code: " + str(r2["code"]))
        exit(1)

    // smtp_ehlo_caps_from on a full EHLO reply: greeting line skipped, capabilities returned.
    let ehlo_block = "250-mail.x.com" + crlf + "250-PIPELINING" + crlf + "250 SIZE 10240000" + crlf
    let r3 = smtp_parse_reply(ehlo_block)
    let caps = smtp_ehlo_caps_from(r3)
    if len(caps) != 2
        print("FAIL ehlo caps count: " + str(len(caps)))
        exit(1)
    if caps[0] != "PIPELINING" or caps[1] != "SIZE 10240000"
        print("FAIL ehlo caps content")
        exit(1)

    // Negative reply (550) is not positive.
    let neg = smtp_parse_reply("550 mailbox unavailable" + crlf)
    if smtp_reply_ok(neg) != 0
        print("FAIL neg reply_ok should be 0")
        exit(1)

    // RFC 5321 4.5.2 dot-stuffing: a body line consisting of a lone "." must be doubled
    // to ".." on the wire so it is never mistaken for the "\r\n.\r\n" end-of-data marker.
    let body_dot = "Hi" + crlf + "." + crlf + "Bye"
    let stuffed_dot = smtp_dot_stuff(body_dot)
    let expect_dot = "Hi" + crlf + ".." + crlf + "Bye"
    if stuffed_dot != expect_dot
        print("FAIL dot_stuff lone dot: " + stuffed_dot)
        exit(1)

    // A line already starting with ".." must gain exactly one extra leading dot -> "...x".
    let body_dotdot = "..x" + crlf + "y"
    let stuffed_dotdot = smtp_dot_stuff(body_dotdot)
    let expect_dotdot = "..." + "x" + crlf + "y"
    if stuffed_dotdot != expect_dotdot
        print("FAIL dot_stuff double dot: " + stuffed_dotdot)
        exit(1)

    // A dot in the middle of a line (not line-initial) must NOT be touched.
    let body_mid = "a.b.c" + crlf + "d"
    let stuffed_mid = smtp_dot_stuff(body_mid)
    if stuffed_mid != body_mid
        print("FAIL dot_stuff mid-line dot should be untouched: " + stuffed_mid)
        exit(1)

    // Line-initial dot with no other content and no trailing CRLF (end of buffer) is still stuffed.
    let stuffed_bare = smtp_dot_stuff(".")
    if stuffed_bare != ".."
        print("FAIL dot_stuff bare single dot: " + stuffed_bare)
        exit(1)

    print("PASS forge_smtp")

main()
