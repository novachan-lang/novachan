// LOCK-4 inc3c-part1a KAT — straight-line sized VARIABLES (literal-initialised) wrap at width.
// inc3b made direct-expression sized arithmetic wrap; inc3c-part1a flows the width through a
// const-initialised let-binding (const-fold forwards the load, carrying the width) so
// `let x = 255u8; x + 1 == 0`. LIMITATIONS (= inc3c-part2, deferred): a sized var reassigned
// in a LOOP does not yet wrap (slot re-load width flow crashed a downstream loop/SSA pass —
// needs focused debugging); annotation-typed sized vars `let x: u8 = 255` need the TiState→IR
// width bridge. Both are unshipped-feature gaps, not regressions (default int is byte-identical).
fn check(name: string, got: int, want: int) -> bool
    if got == want
        print("  ok " + name + " = " + str(got))
        return true
    print("  FAIL " + name + " got " + str(got) + " want " + str(want))
    false

fn main() -> int
    let ok = true
    // single literal-init var
    let x = 255u8
    if not check("x=255u8; x+1", x + 1, 0)
        ok = false
    // two vars, both sized
    let y = 200u8
    let z = 100u8
    if not check("y=200u8,z=100u8; y+z", y + z, 44)
        ok = false
    // var reused in a mul
    let a = 100u8
    if not check("a=100u8; a*3", a * 3, 44)
        ok = false
    // signed var
    let s = 127i8
    if not check("s=127i8; s+1", s + 1, 0 - 128)
        ok = false
    // u16 var
    let w = 65535u16
    if not check("w=65535u16; w+1", w + 1, 0)
        ok = false
    // default int var UNCHANGED (no wrap)
    let d = 255
    if not check("d=255; d+1", d + 1, 256)
        ok = false
    if ok
        print("L7-VAR KAT PASS")
        return 0
    print("L7-VAR KAT FAIL")
    1
