import std/physics/gravitation

// Relative tolerance for very small numbers (like G ~ 6.674e-11)
fn approx_rel(a: float, b: float) -> int
    let d = a - b
    let ad = 0.0
    if d < 0.0
        ad = 0.0 - d
    else
        ad = d
    // relative tolerance: |a-b| / |b| < 0.0001
    let ab = 0.0
    if b < 0.0
        ab = 0.0 - b
    else
        ab = b
    // avoid division by zero: if b~0, fall back to absolute
    if ab < 1e-300
        if ad < 0.0001
            return 1
        return 0
    let rel = ad / ab
    if rel < 0.0001
        return 1
    return 0

fn approx(a: float, b: float) -> int
    let d = a - b
    let ad = 0.0
    if d < 0.0
        ad = 0.0 - d
    else
        ad = d
    if ad < 0.0001
        return 1
    return 0

fn main()
    // G() ~ 6.674e-11
    let g_val = G()
    let g_ref = 6.674 / pow(10.0, 11.0)
    if approx_rel(g_val, g_ref) == 0
        print("FAIL G_constant: got " + str(g_val))
        exit(1)

    // grav_force(1.0, 1.0, 1.0) = G * 1 * 1 / 1 = G ~ 6.674e-11
    let f1 = grav_force(1.0, 1.0, 1.0)
    if approx_rel(f1, g_ref) == 0
        print("FAIL grav_force_unit: got " + str(f1))
        exit(1)

    // grav_force scales with 1/r^2: grav_force(1,1,2) = G/4
    let f2 = grav_force(1.0, 1.0, 2.0)
    let f2_ref = g_ref / 4.0
    if approx_rel(f2, f2_ref) == 0
        print("FAIL grav_force_r2: got " + str(f2))
        exit(1)

    // escape_velocity > orbital_velocity for same m,r
    // write 5.972e24 as 5.972 * pow(10,24)
    let m_val = 5.972 * pow(10.0, 24.0)
    let r_val = 6.371 * pow(10.0, 6.0)
    let v_orb = orbital_velocity(m_val, r_val)
    let v_esc = escape_velocity(m_val, r_val)

    if v_esc <= v_orb
        print("FAIL escape_gt_orbital: esc=" + str(v_esc) + " orb=" + str(v_orb))
        exit(1)

    // escape_velocity = sqrt(2) * orbital_velocity
    // ratio should be ~ 1.41421
    let ratio = v_esc / v_orb
    if approx(ratio, 1.41421) == 0
        print("FAIL escape_orbital_ratio: got " + str(ratio))
        exit(1)

    // orbital_velocity(m_val, r_val) ~ 7909 m/s for Earth
    // just verify it's in a sane range: between 7000 and 9000
    if v_orb < 7000.0
        print("FAIL orbital_too_low: got " + str(v_orb))
        exit(1)
    if v_orb > 9000.0
        print("FAIL orbital_too_high: got " + str(v_orb))
        exit(1)

    print("PASS _gravitation_test")
