// Forge X.509: DER TLV round-trip + SPKI key extraction + an end-to-end self-signed Ed25519 certificate
// (built with der_enc + ed25519_sign, then parsed back and ed25519_verify'd). Socketless.
import forge_x509
import forge_crypto

fn main()
    // (a) parse SEQUENCE { INTEGER 0x0102, OCTET STRING "ab" }
    let der1 = hex_to_blist("30080202010204026162")
    let outer = der_tlv(der1, 0)
    if outer[0] != 48 or outer[1] != 8
        print("FAIL: TLV outer")
        exit(1)
    let c1 = der_tlv(der1, outer[2])
    let c2 = der_tlv(der1, c1[3])
    if c1[0] != 2 or hex_of(der_slice(der1, c1[2], c1[3])) != "0102"
        print("FAIL: TLV integer")
        exit(1)
    if c2[0] != 4 or hex_of(der_slice(der1, c2[2], c2[3])) != "6162"
        print("FAIL: TLV octetstring")
        exit(1)

    // (b) extract the key from a known Ed25519 SubjectPublicKeyInfo
    let pkhex = "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"
    let spki = x_cat(hex_to_blist("302a300506032b6570032100"), hex_to_blist(pkhex))
    let sk2 = x509_spki_key(spki)
    if hex_of(sk2[0]) != "2b6570"
        print("FAIL: SPKI alg oid -> " + hex_of(sk2[0]))
        exit(1)
    if hex_of(sk2[1]) != pkhex
        print("FAIL: SPKI key -> " + hex_of(sk2[1]))
        exit(1)

    // (c) build a self-signed Ed25519 cert, parse it, verify the signature over tbsCertificate
    let sk = hex_to_blist("0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20")
    let pubkey = ed25519_publickey(sk)
    let oid = hex_to_blist("2b6570")
    let alg = der_enc(48, der_enc(6, oid))
    let keybits = der_enc(3, x_cat(hex_to_blist("00"), pubkey))
    let spki_c = der_enc(48, x_cat(alg, keybits))
    let version = der_enc(160, der_enc(2, hex_to_blist("02")))
    let serial = der_enc(2, hex_to_blist("012a"))
    let issuer = der_enc(48, [])
    let validity = der_enc(48, x_cat(der_enc(23, str_to_blist("250101000000Z")), der_enc(23, str_to_blist("350101000000Z"))))
    let subject = der_enc(48, [])
    let tbsval = x_cat(x_cat(x_cat(x_cat(x_cat(x_cat(version, serial), alg), issuer), validity), subject), spki_c)
    let tbs = der_enc(48, tbsval)
    let sig = ed25519_sign(sk, tbs)
    let sigval = der_enc(3, x_cat(hex_to_blist("00"), sig))
    let cert = der_enc(48, x_cat(x_cat(tbs, alg), sigval))

    let parsed = x509_parse_cert(cert)
    if hex_of(parsed[2]) != hex_of(pubkey)
        print("FAIL: parsed SPKI key mismatch")
        exit(1)
    if ed25519_verify(parsed[2], parsed[0], parsed[1]) != 1
        print("FAIL: cert self-signature did not verify")
        exit(1)

    print("PASS forge_x509 (DER TLV + SPKI extraction + self-signed Ed25519 cert parse+verify)")
