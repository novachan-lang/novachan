// Live TLS 1.3 client L1 vs openssl s_server: connect, ClientHello/ServerHello, ECDHE, derive handshake
// keys, decrypt the server's encrypted flight. Requires openssl s_server -tls1_3 on 127.0.0.1:44330.
import forge_tls_client
import forge_tls
import forge_crypto

fn main()
    let r = tls13_client_l1("127.0.0.1", 44330)
    if r[0] != 1
        print("FAIL: live handshake flight not complete (no server, or decrypt failed)")
        exit(1)
    let flight = r[1]
    let m1 = tls13_hs_header(flight, 0)
    if m1[0] != 8
        print("FAIL: first flight message is not EncryptedExtensions")
        exit(1)
    let p = 0
    let has_cert = 0
    let has_fin = 0
    while p + 4 <= len(flight)
        let t = flight[p]
        let hlen = (flight[p + 1] << 16) | (flight[p + 2] << 8) | flight[p + 3]
        if t == 11
            has_cert = 1
        if t == 20
            has_fin = 1
        p = p + 4 + hlen
    if has_cert != 1
        print("FAIL: no Certificate in decrypted flight")
        exit(1)
    if has_fin != 1
        print("FAIL: no Finished in decrypted flight")
        exit(1)
    print("PASS forge_tls_client_l1 (live TLS 1.3 vs openssl: ECDHE + handshake keys + flight decrypted)")
