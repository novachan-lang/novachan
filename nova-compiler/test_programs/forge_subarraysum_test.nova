import forge_subarraysum

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

// brute-force count of subarrays summing to k
fn brute(arr: list, k: int) -> int
    let c = 0
    let i = 0
    while i < len(arr)
        let s = 0
        let j = i
        while j < len(arr)
            s = s + arr[j]
            if s == k
                c = c + 1
            j = j + 1
        i = i + 1
    c

fn main()
    let fails = 0

    // count
    fails = fails + expect("c1", str(subarray_sum_count([1, 1, 1], 2)), "2")
    fails = fails + expect("c2", str(subarray_sum_count([1, 2, 3], 3)), "2")
    fails = fails + expect("c_neg", str(subarray_sum_count([1, 0 - 1, 0], 0)), "3")
    fails = fails + expect("c_classic", str(subarray_sum_count([3, 4, 7, 2, 0 - 3, 1, 4, 2], 7)), "4")
    fails = fails + expect("c_none", str(subarray_sum_count([1, 2, 3], 100)), "0")
    fails = fails + expect("c_all_zero", str(subarray_sum_count([0, 0, 0], 0)), "6")

    // exists
    fails = fails + expect("e_yes", str(subarray_sum_exists([1, 2, 3], 5)), "true")
    fails = fails + expect("e_no", str(subarray_sum_exists([1, 2, 3], 100)), "false")
    fails = fails + expect("e_neg", str(subarray_sum_exists([1, 2, 0 - 3, 4], 0)), "true")

    // indices sum to k
    let idx = subarray_sum_indices([1, 2, 3, 4], 9)
    let s = 0
    let a = idx[0]
    while a <= idx[1]
        s = s + [1, 2, 3, 4][a]
        a = a + 1
    fails = fails + expect("idx_sum", str(s), "9")
    let idx2 = subarray_sum_indices([1, 2, 3], 100)
    fails = fails + expect("idx_none", str(idx2[0]), "-1")

    // brute-force cross-check with negatives
    let ok = 1
    let arrs = []
    push(arrs, [1, 0 - 1, 2, 0 - 2, 3])
    push(arrs, [5, 5, 5, 5])
    push(arrs, [0 - 2, 0 - 1, 0 - 3, 4, 0 - 1])
    let ks = [0, 10, 0]
    let t = 0
    while t < len(arrs)
        if subarray_sum_count(arrs[t], ks[t]) != brute(arrs[t], ks[t])
            ok = 0
        t = t + 1
    fails = fails + expect("brute_cross", str(ok), "1")

    if fails == 0
        print("forge_subarraysum: all passed")
    else
        print("forge_subarraysum: " + str(fails) + " FAILED")
