// KAT test for std/data/m3u_build
import std/data/m3u_build
import std/data/m3u_parse

fn cki(label, got, expected)
    if got != expected
        print("FAIL m3u_build " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL m3u_build " + label + ": got=" + got + " expected=" + expected)
        exit(1)

fn ck_contains(label, haystack, needle)
    let found = 0
    let hlen = len(haystack)
    let nlen = len(needle)
    let i = 0
    while i <= hlen - nlen
        if slice(haystack, i, i+nlen) == needle
            found = 1
        i = i + 1
    if found == 0
        print("FAIL m3u_build " + label + ": <" + haystack + "> does not contain <" + needle + ">")
        exit(1)

fn ck_starts(label, s, prefix)
    let plen = len(prefix)
    let ok = 0
    if len(s) >= plen
        if slice(s, 0, plen) == prefix
            ok = 1
    if ok == 0
        print("FAIL m3u_build " + label + ": <" + s + "> does not start with <" + prefix + ">")
        exit(1)

// ── KAT from spec: single entry with EXTINF ──────────────────────────────────
let lf = chr(10)
let e1 = {}
e1["duration"] = 123
e1["title"] = "A"
e1["url"] = "http://x/a"
let entries1 = [e1]
let out1 = m3u_build(entries1)
ck_starts("starts_extm3u", out1, "#EXTM3U")
ck_contains("has_extinf", out1, "#EXTINF:123,A")
ck_contains("has_url", out1, "http://x/a")

// ── KAT: round-trip via m3u_parse ────────────────────────────────────────────
let parsed1 = m3u_parse(out1)
cki("rt_len", len(parsed1), 1)
cki("rt_dur", parsed1[0]["duration"], 123)
cks("rt_title", parsed1[0]["title"], "A")
cks("rt_url", parsed1[0]["url"], "http://x/a")

// ── KAT: plain URL entry (duration < 0, empty title) — no EXTINF emitted ────
let e2 = {}
e2["duration"] = -1
e2["title"] = ""
e2["url"] = "http://x/b.mp3"
let out2 = m3u_build([e2])
ck_starts("plain_starts", out2, "#EXTM3U")
// Should NOT contain EXTINF
let has_extinf = 0
let hlen2 = len(out2)
let tag = "#EXTINF"
let tlen = len(tag)
let ix = 0
while ix <= hlen2 - tlen
    if slice(out2, ix, ix+tlen) == tag
        has_extinf = 1
    ix = ix + 1
if has_extinf == 1
    print("FAIL m3u_build plain_no_extinf: EXTINF present but should be absent")
    exit(1)
ck_contains("plain_url", out2, "http://x/b.mp3")

// ── KAT: round-trip plain entry ──────────────────────────────────────────────
let parsed2 = m3u_parse(out2)
cki("rt2_len", len(parsed2), 1)
cki("rt2_dur", parsed2[0]["duration"], -1)
cks("rt2_url", parsed2[0]["url"], "http://x/b.mp3")

// ── KAT: multiple entries round-trip ─────────────────────────────────────────
let ea = {}
ea["duration"] = 60
ea["title"] = "Track 1"
ea["url"] = "http://a/1.mp3"
let eb = {}
eb["duration"] = -1
eb["title"] = ""
eb["url"] = "http://a/2.mp3"
let out3 = m3u_build([ea, eb])
let parsed3 = m3u_parse(out3)
cki("multi_len", len(parsed3), 2)
cki("multi_e0_dur", parsed3[0]["duration"], 60)
cks("multi_e0_title", parsed3[0]["title"], "Track 1")
cki("multi_e1_dur", parsed3[1]["duration"], -1)
cks("multi_e1_url", parsed3[1]["url"], "http://a/2.mp3")

// ── KAT: empty entries list ───────────────────────────────────────────────────
let out4 = m3u_build([])
ck_starts("empty_starts", out4, "#EXTM3U")
let parsed4 = m3u_parse(out4)
cki("empty_len", len(parsed4), 0)

print("PASS _m3u_build_test")
