// Multithreaded list processing: spawn workers that each compute a portion
// of work and send results back via channels. Demonstrates NOVA's concurrency
// model: spawn + channels = all you need.

fn compute_squares(start, count, result_ch)
    let squares = []
    let i = start
    while i < start + count
        push(squares, i * i)
        i = i + 1
    send(result_ch, squares)

fn main()
    let ch = channel()
    let num_workers = 4
    let items_per_worker = 5

    // Spawn 4 workers, each computing squares for a range
    let w = 0
    while w < num_workers
        let start = w * items_per_worker + 1
        spawn compute_squares(start, items_per_worker, ch)
        w = w + 1

    // Collect results from all workers
    let all_squares = []
    let collected = 0
    while collected < num_workers
        let partial = receive(ch)
        let j = 0
        while j < len(partial)
            push(all_squares, partial[j])
            j = j + 1
        collected = collected + 1

    // Sort and verify: should have squares of 1..20
    sort(all_squares)
    assert(len(all_squares) == 20, "expected 20 squares, got " + str(len(all_squares)))
    assert(all_squares[0] == 1, "1^2 = 1")
    assert(all_squares[1] == 4, "2^2 = 4")
    assert(all_squares[2] == 9, "3^2 = 9")
    assert(all_squares[19] == 400, "20^2 = 400")

    print("squares: " + str(all_squares))
    print("mt_list_test: PASSED — 4 workers computed 20 squares concurrently")
