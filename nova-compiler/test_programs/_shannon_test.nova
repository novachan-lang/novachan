// _shannon_test.nova — KAT for std/compress/shannon
//
// Tests:
//   1. Round-trip: shf_decode(shf_encode(s)[0], shf_encode(s)[1]) == s
//      for "", "a", "aaabbbccd", "hello world", and a sentence.
//   2. shf_entropy("aaaa") == 0.0  (single distinct character).
//   3. shf_entropy("ab")   == 1.0  (two equiprobable symbols).
//   4. Prefix-free property: no code in shf_build_codes("hello") is a prefix
//      of another code (pairwise check).
//   5. shf_encode("") returns ["", {}].
//   6. shf_build_codes("a") contains "a" mapped to "0".
//
// HAND-TRACE for shf_entropy("ab"):
//   p(a)=0.5, p(b)=0.5
//   H = -(0.5*log2(0.5) + 0.5*log2(0.5))
//     = -(0.5*(-1) + 0.5*(-1))
//     = -(-1) = 1.0 bits/symbol  ✓
//
// HAND-TRACE for shf_entropy("aaaa"):
//   Only one distinct character; nk==1 → return 0.0  ✓

import std/compress/shannon

// ── Assertion helpers ─────────────────────────────────────────────────────────

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckf_near: check float within epsilon.
fn ckf_near(label, got, want, eps)
    let diff = got - want
    if diff < 0.0
        diff = want - got
    if diff > eps
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want) + " eps=" + str(eps))
        exit(1)

// ── Round-trip helper ─────────────────────────────────────────────────────────

fn round_trip(label, s)
    let encoded = shf_encode(s)
    let bits = encoded[0]
    let codes = encoded[1]
    let decoded = shf_decode(bits, codes)
    cks(label, decoded, s)

// ── Prefix-free checker ───────────────────────────────────────────────────────

// prefix_free_check: returns 1 if no code in codes_list is a prefix of another.
// codes_list is a list of bitstrings.
fn prefix_free_check(codes_list) -> int
    let n = len(codes_list)
    let i = 0
    while i < n
        let ci = codes_list[i]
        let li = len(ci)
        let j = 0
        while j < n
            if j != i
                let cj = codes_list[j]
                let lj = len(cj)
                // Check if ci is a prefix of cj: lj > li and cj[0..li] == ci.
                if lj > li
                    // Extract the first li chars of cj by slicing.
                    let prefix = slice(cj, 0, li)
                    if prefix == ci
                        return 0
            j = j + 1
        i = i + 1
    return 1

fn main()
    // ── KAT 1: empty string round-trip ───────────────────────────────────────
    round_trip("rt_empty", "")

    // ── KAT 2: single char "a" round-trip ────────────────────────────────────
    round_trip("rt_single_a", "a")

    // ── KAT 3: "aaabbbccd" round-trip ────────────────────────────────────────
    round_trip("rt_aaabbbccd", "aaabbbccd")

    // ── KAT 4: "hello world" round-trip ──────────────────────────────────────
    round_trip("rt_hello_world", "hello world")

    // ── KAT 5: sentence round-trip ───────────────────────────────────────────
    round_trip("rt_sentence", "the quick brown fox jumps over the lazy dog")

    // ── KAT 6: shf_entropy("aaaa") == 0.0 ───────────────────────────────────
    let ent_aaaa = shf_entropy("aaaa")
    ckf_near("entropy_aaaa_zero", ent_aaaa, 0.0, 0.0000001)

    // ── KAT 7: shf_entropy("ab") == 1.0 ─────────────────────────────────────
    let ent_ab = shf_entropy("ab")
    ckf_near("entropy_ab_one", ent_ab, 1.0, 0.0000001)

    // ── KAT 8: empty string encode returns ["", {}] ───────────────────────────
    let enc_empty = shf_encode("")
    let empty_bits = enc_empty[0]
    cks("encode_empty_bits", empty_bits, "")
    // Verify empty codes dict: keys should be empty list.
    let empty_codes = enc_empty[1]
    let empty_keys = keys(empty_codes)
    cki("encode_empty_codes_len", len(empty_keys), 0)

    // ── KAT 9: single distinct char "aaaa" -> code "0" ───────────────────────
    let codes_aaaa = shf_build_codes("aaaa")
    cks("single_char_code", codes_aaaa["a"], "0")

    // ── KAT 10: prefix-free property on "hello" ───────────────────────────────
    // "hello" has chars: h(1), e(1), l(2), o(1) — 4 distinct chars, 4 codes.
    // After Shannon-Fano coding they must be prefix-free.
    let codes_hello = shf_build_codes("hello")
    let code_list = []
    let hello_keys = keys(codes_hello)
    let nk = len(hello_keys)
    let ki = 0
    while ki < nk
        let code_val = codes_hello[hello_keys[ki]]
        code_list.push(code_val)
        ki = ki + 1
    let pf = prefix_free_check(code_list)
    cki("prefix_free_hello", pf, 1)

    // ── KAT 11: shf_entropy("aabb") == 1.0 ───────────────────────────────────
    // p(a)=0.5, p(b)=0.5  ->  H=1.0 (same as "ab" case)
    let ent_aabb = shf_entropy("aabb")
    ckf_near("entropy_aabb_one", ent_aabb, 1.0, 0.0000001)

    // ── KAT 12: all codes present in codes dict for "hello" ──────────────────
    cki("hello_distinct_count", len(hello_keys), 4)

    print("_shannon_test passed")
