// forge_redirect_safe_test -- is_local_redirect / redirect_local are the OPEN-REDIRECT guard for the
// "?next=..." return-to pattern: a safe target is a single-"/" local path; protocol-relative (//host),
// backslash-bypass (/\host), absolute (http://), scheme (javascript:), host-relative, empty, and CR/LF
// targets are all rejected so a crafted `next` can never send the browser off-site.
import forge

fn main()
    // safe local paths -> 1
    if forge.is_local_redirect("/dashboard") != 1
        print("FAIL: /dashboard should be local")
        exit(1)
    if forge.is_local_redirect("/") != 1
        print("FAIL: / should be local")
        exit(1)
    if forge.is_local_redirect("/a/b?x=1&y=2") != 1
        print("FAIL: /a/b?... should be local")
        exit(1)

    // open-redirect vectors -> 0
    if forge.is_local_redirect("//evil.com") != 0
        print("FAIL: protocol-relative //evil.com must be rejected")
        exit(1)
    if forge.is_local_redirect("/\\evil.com") != 0
        print("FAIL: backslash-bypass /\\evil.com must be rejected")
        exit(1)
    if forge.is_local_redirect("http://evil.com") != 0
        print("FAIL: absolute http://evil.com must be rejected")
        exit(1)
    if forge.is_local_redirect("javascript:alert(1)") != 0
        print("FAIL: javascript: scheme must be rejected")
        exit(1)
    if forge.is_local_redirect("evil.com") != 0
        print("FAIL: host-relative (no leading /) must be rejected")
        exit(1)
    if forge.is_local_redirect("") != 0
        print("FAIL: empty must be rejected")
        exit(1)
    if forge.is_local_redirect("/path\\x") != 0
        print("FAIL: a backslash anywhere must be rejected")
        exit(1)
    if forge.is_local_redirect("/a\r\nSet-Cookie: x=1") != 0
        print("FAIL: CR/LF in target must be rejected")
        exit(1)

    // redirect_local: a safe target is honored; an unsafe one falls back (never goes off-site)
    let goodr = forge.redirect_local(303, "/dashboard", "/")
    if find(goodr, "Location: /dashboard") < 0
        print("FAIL: safe target not honored -> " + goodr)
        exit(1)
    let badr = forge.redirect_local(303, "//evil.com", "/")
    if find(badr, "Location: /\r\n") < 0
        print("FAIL: unsafe target should fall back to /")
        exit(1)
    if find(badr, "evil.com") >= 0
        print("FAIL: open-redirect target leaked into the response")
        exit(1)

    print("PASS forge_redirect_safe (is_local_redirect + redirect_local open-redirect guard)")
