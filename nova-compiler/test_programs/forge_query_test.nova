// forge_query_test -- query_get must match a parameter key EXACTLY (split on '&'), so a param whose name
// ends with or contains the key cannot shadow/hide the real one (the old substring-find false-matched and
// silently returned "" -- a parameter-parsing confusion). Pure string parsing.
import forge

fn main()
    // the shadowing bug: "notadmin=1" must NOT hide "admin=5"
    if forge.query_get("GET /p?notadmin=1&admin=5 HTTP/1.1\r\n\r\n", "admin") != "5"
        print("FAIL: admin shadowed by notadmin -> " + forge.query_get("GET /p?notadmin=1&admin=5 HTTP/1.1\r\n\r\n", "admin"))
        exit(1)
    // a prefix param must not match either
    if forge.query_get("GET /p?keyx=1&key=2 HTTP/1.1\r\n\r\n", "key") != "2"
        print("FAIL: keyx should not match key")
        exit(1)
    // basic positional
    if forge.query_get("GET /p?a=1&b=2&c=3 HTTP/1.1\r\n\r\n", "b") != "2"
        print("FAIL: basic b")
        exit(1)
    // first match wins on duplicate keys
    if forge.query_get("GET /p?k=first&k=second HTTP/1.1\r\n\r\n", "k") != "first"
        print("FAIL: duplicate key should take first")
        exit(1)
    // a valueless flag before the key must be skipped
    if forge.query_get("GET /p?flag&key=v HTTP/1.1\r\n\r\n", "key") != "v"
        print("FAIL: valueless flag then key")
        exit(1)
    // absent key / no query string
    if forge.query_get("GET /p?a=1 HTTP/1.1\r\n\r\n", "z") != ""
        print("FAIL: absent key should be empty")
        exit(1)
    if forge.query_get("GET /p HTTP/1.1\r\n\r\n", "a") != ""
        print("FAIL: no query string should be empty")
        exit(1)

    print("PASS forge_query (query_get exact-key match: no substring shadowing, prefix-safe, first-wins, absent)")
