// functional: composable SQL DSL
import forge_query

fn main()
    if q_select(["id", "name"]) != "SELECT id, name"
        print("FAIL select")
        exit(1)
    if q_where_all(["a = ?"]) != " WHERE a = ?"
        print("FAIL where")
        exit(1)
    if q_where_all([]) != ""
        print("FAIL where empty")
        exit(1)
    if q_in("id", 3) != "id IN (?, ?, ?)"
        print("FAIL in = " + q_in("id", 3))
        exit(1)
    if str(q_eq_conds(["a", "b"])) != str(["a = ?", "b = ?"])
        print("FAIL eq_conds")
        exit(1)
    let built = q_build(q_qualify("u", ["id", "name"]), "users u", q_eq_conds(["u.active"]), ["u.name"], 20)
    if built != "SELECT u.id, u.name FROM users u WHERE u.active = ? ORDER BY u.name LIMIT 20"
        print("FAIL build = " + built)
        exit(1)
    print("PASS forge_query")
