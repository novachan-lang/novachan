// KAT test for std/dsp/movingavg.nova
//
// Hand-computed reference values:
//   mav_sma([1,2,3,4,5], 3) = [2.0, 3.0, 4.0]      (windows of 3: avg(1,2,3)=2, avg(2,3,4)=3, avg(3,4,5)=4)
//   mav_sma([2,4,6], 2)     = [3.0, 5.0]             (avg(2,4)=3, avg(4,6)=5)
//   mav_ema([1,2,3], 0.5)   = [1.0, 1.5, 2.25]       (seed=1; 0.5*2+0.5*1=1.5; 0.5*3+0.5*1.5=2.25)
//   mav_cumulative([2,4,6]) = [2.0, 3.0, 4.0]        (2/1=2, 6/2=3, 12/3=4)
//   mav_wma([1,2,3], 3)     = [2.3333]               ((1*1+2*2+3*3)/6 = 14/6 = 2.3333)
//   len(mav_sma([1,2,3,4],2)) = 3                    (4-2+1=3)

import std/dsp/movingavg

// ckf: compare two floats within eps 0.001
fn ckf(label: string, got: float, want: float)
    let diff = got - want
    if diff < 0.0
        diff = 0.0 - diff
    if diff > 0.001
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// ckf_list: compare two float lists element-wise within eps 0.001
fn ckf_list(label: string, got: list, want: list)
    let ng = len(got)
    let nw = len(want)
    if ng != nw
        print("FAIL " + label + " length: got " + str(ng) + " want " + str(nw))
        exit(1)
    let i = 0
    while i < nw
        let gv = got[i] * 1.0
        let wv = want[i] * 1.0
        let diff = gv - wv
        if diff < 0.0
            diff = 0.0 - diff
        if diff > 0.001
            print("FAIL " + label + "[" + str(i) + "]: got " + str(gv) + " want " + str(wv))
            exit(1)
        i = i + 1

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // ── KAT 1: mav_sma([1,2,3,4,5], window=3) == [2.0, 3.0, 4.0] ────────────
    let xs1 = []
    push(xs1, 1.0)
    push(xs1, 2.0)
    push(xs1, 3.0)
    push(xs1, 4.0)
    push(xs1, 5.0)
    let want1 = []
    push(want1, 2.0)
    push(want1, 3.0)
    push(want1, 4.0)
    let r1 = mav_sma(xs1, 3)
    ckf_list("sma_5_w3", r1, want1)

    // ── KAT 2: mav_sma([2,4,6], window=2) == [3.0, 5.0] ────────────────────
    let xs2 = []
    push(xs2, 2.0)
    push(xs2, 4.0)
    push(xs2, 6.0)
    let want2 = []
    push(want2, 3.0)
    push(want2, 5.0)
    let r2 = mav_sma(xs2, 2)
    ckf_list("sma_3_w2", r2, want2)

    // ── KAT 3: mav_ema([1,2,3], alpha=0.5) == [1.0, 1.5, 2.25] ────────────
    let xs3 = []
    push(xs3, 1.0)
    push(xs3, 2.0)
    push(xs3, 3.0)
    let want3 = []
    push(want3, 1.0)
    push(want3, 1.5)
    push(want3, 2.25)
    let r3 = mav_ema(xs3, 0.5)
    ckf_list("ema_0.5", r3, want3)

    // ── KAT 4: mav_cumulative([2,4,6]) == [2.0, 3.0, 4.0] ──────────────────
    let xs4 = []
    push(xs4, 2.0)
    push(xs4, 4.0)
    push(xs4, 6.0)
    let want4 = []
    push(want4, 2.0)
    push(want4, 3.0)
    push(want4, 4.0)
    let r4 = mav_cumulative(xs4)
    ckf_list("cumulative_246", r4, want4)

    // ── KAT 5: mav_wma([1,2,3], window=3) == [2.3333] ───────────────────────
    // weights: 1,2,3  weight_sum=6  (1*1+2*2+3*3)/6 = (1+4+9)/6 = 14/6 = 2.3333
    let xs5 = []
    push(xs5, 1.0)
    push(xs5, 2.0)
    push(xs5, 3.0)
    let want5 = []
    push(want5, 2.3333)
    let r5 = mav_wma(xs5, 3)
    ckf_list("wma_123_w3", r5, want5)

    // ── KAT 6: len(mav_sma([1,2,3,4], window=2)) == 3 ──────────────────────
    let xs6 = []
    push(xs6, 1.0)
    push(xs6, 2.0)
    push(xs6, 3.0)
    push(xs6, 4.0)
    let r6 = mav_sma(xs6, 2)
    cki("sma_len_4_w2", len(r6), 3)

    // ── KAT 7: mav_ema single-element stays as-is ───────────────────────────
    let xs7 = []
    push(xs7, 5.0)
    let r7 = mav_ema(xs7, 0.3)
    cki("ema_single_len", len(r7), 1)
    let v7 = r7[0] * 1.0
    ckf("ema_single_val", v7, 5.0)

    // ── KAT 8: mav_cumulative single element ────────────────────────────────
    let xs8 = []
    push(xs8, 7.0)
    let r8 = mav_cumulative(xs8)
    cki("cum_single_len", len(r8), 1)
    let v8 = r8[0] * 1.0
    ckf("cum_single_val", v8, 7.0)

    // ── KAT 9: mav_wma with window=2 on [3,5,7] ────────────────────────────
    // windows: [3,5] -> (1*3+2*5)/3=13/3=4.333; [5,7] -> (1*5+2*7)/3=19/3=6.333
    let xs9 = []
    push(xs9, 3.0)
    push(xs9, 5.0)
    push(xs9, 7.0)
    let want9 = []
    push(want9, 4.3333)
    push(want9, 6.3333)
    let r9 = mav_wma(xs9, 2)
    ckf_list("wma_357_w2", r9, want9)

    // ── KAT 10: mav_sma window==len returns single average ──────────────────
    let xs10 = []
    push(xs10, 4.0)
    push(xs10, 8.0)
    push(xs10, 12.0)
    let r10 = mav_sma(xs10, 3)
    cki("sma_full_len", len(r10), 1)
    let v10 = r10[0] * 1.0
    ckf("sma_full_val", v10, 8.0)

    print("_movingavg_test passed")
