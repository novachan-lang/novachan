import std/backtracking/bt_subsets_dup

// cki — check integer equality
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL bt_subsets_dup " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb — check bool equality
fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL bt_subsets_dup " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

// list_to_str — convert int list to string
fn list_to_str(xs) -> string
    let s = "["
    let i = 0
    let n = len(xs)
    while i < n
        if i > 0
            s = s + ","
        s = s + str(xs[i])
        i = i + 1
    s = s + "]"
    s

// cks — check string equality
fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL bt_subsets_dup " + label + ": got=" + got + " want=" + want)
        exit(1)

// list_eq — true if two int lists are equal element-wise
fn list_eq(a, b) -> bool
    if len(a) != len(b)
        return false
    let i = 0
    while i < len(a)
        if a[i] != b[i]
            return false
        i = i + 1
    true

// contains_sub — true if xss contains a sublist equal to target
fn contains_sub(xss, target) -> bool
    let i = 0
    while i < len(xss)
        if list_eq(xss[i], target)
            return true
        i = i + 1
    false

// cknest — check outer len then check each expected sub is present
fn cknest(label: string, xss, wlen: int)
    if len(xss) != wlen
        print("FAIL bt_subsets_dup " + label + "_len: got=" + str(len(xss)) + " want=" + str(wlen))
        exit(1)

fn main()
    // --- sd_count basic cases ---
    let e = []
    cki("count_empty", sd_count(e), 1)

    let a1 = [1]
    cki("count_1", sd_count(a1), 2)

    let a122 = [1, 2, 2]
    cki("count_122", sd_count(a122), 6)

    let a123 = [1, 2, 3]
    cki("count_123", sd_count(a123), 8)

    let a222 = [2, 2, 2]
    cki("count_222", sd_count(a222), 4)

    // --- sd_solve([]) = [[]] ---
    let se = sd_solve(e)
    cki("solve_empty_len", len(se), 1)
    let emptylist = []
    ckb("solve_empty_has_empty", contains_sub(se, emptylist), true)

    // --- sd_solve([1,2,2]) has 6 subsets ---
    let s122 = sd_solve(a122)
    cknest("solve_122", s122, 6)

    // must contain [] and [1,2,2]
    let want_empty = []
    let want_122 = [1, 2, 2]
    let want_1 = [1]
    let want_2 = [2]
    let want_12 = [1, 2]
    let want_22 = [2, 2]
    ckb("solve_122_has_empty", contains_sub(s122, want_empty), true)
    ckb("solve_122_has_122", contains_sub(s122, want_122), true)
    ckb("solve_122_has_1", contains_sub(s122, want_1), true)
    ckb("solve_122_has_2", contains_sub(s122, want_2), true)
    ckb("solve_122_has_12", contains_sub(s122, want_12), true)
    ckb("solve_122_has_22", contains_sub(s122, want_22), true)

    // --- sd_solve([1,2,3]) has 8 subsets ---
    let s123 = sd_solve(a123)
    cknest("solve_123", s123, 8)
    let want_123 = [1, 2, 3]
    let want_13 = [1, 3]
    let want_23 = [2, 3]
    let want_3 = [3]
    ckb("solve_123_has_empty", contains_sub(s123, want_empty), true)
    ckb("solve_123_has_1", contains_sub(s123, want_1), true)
    ckb("solve_123_has_2", contains_sub(s123, want_2), true)
    ckb("solve_123_has_3", contains_sub(s123, want_3), true)
    ckb("solve_123_has_12", contains_sub(s123, want_12), true)
    ckb("solve_123_has_13", contains_sub(s123, want_13), true)
    ckb("solve_123_has_23", contains_sub(s123, want_23), true)
    ckb("solve_123_has_123", contains_sub(s123, want_123), true)

    // --- sd_solve([2,2,2]) has 4 subsets: [], [2], [2,2], [2,2,2] ---
    let s222 = sd_solve(a222)
    cknest("solve_222", s222, 4)
    let want_22a = [2, 2]
    let want_222 = [2, 2, 2]
    ckb("solve_222_has_empty", contains_sub(s222, want_empty), true)
    ckb("solve_222_has_2", contains_sub(s222, want_2), true)
    ckb("solve_222_has_22", contains_sub(s222, want_22a), true)
    ckb("solve_222_has_222", contains_sub(s222, want_222), true)

    // order check: first element of sd_solve([1,2,2]) must be [] (empty subset first)
    cks("solve_122_first", list_to_str(s122[0]), "[]")

    // --- larger: [1,1,2,2] should have C=9: [],[1],[11],[2],[12],[112],[22],[122],[1122] ---
    let a1122 = [1, 1, 2, 2]
    cki("count_1122", sd_count(a1122), 9)

    print("PASS _bt_subsets_dup_test")
