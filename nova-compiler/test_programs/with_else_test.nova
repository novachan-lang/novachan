// with/else happy-path chaining (Elixir-style): run a chain of fallible steps;
// on the first Err, bind it and run the else block. Desugars to nested Ok/Err
// match over the typed Result — reuses the match-on-Result machinery, no new IR.

// multi-bind, return-based: returns the sum, or -1 if any parse fails
fn sum2(s1: string, s2: string) -> int
    with a <- parse_int_safe(s1), b <- parse_int_safe(s2)
        return a + b
    else err
        return -1

// single-bind, side-effect form that uses the bound error value
fn classify2(s: string) -> string
    let result = "?"
    with n <- parse_int_safe(s)
        result = "ok:" + str(n)
    else err
        result = "err:" + err
    return result

// three-bind chain
fn sum3(a: string, b: string, c: string) -> int
    with x <- parse_int_safe(a), y <- parse_int_safe(b), z <- parse_int_safe(c)
        return x + y + z
    else err
        return -999

fn main()
    // all steps succeed
    assert_eq(sum2("3", "4"), 7)
    assert_eq(sum2("100", "23"), 123)
    // first / second step fails -> else
    assert_eq(sum2("x", "4"), -1)
    assert_eq(sum2("3", "y"), -1)
    assert_eq(sum2("bad", "bad"), -1)

    // side-effect form + error value binding
    assert_eq(classify2("42"), "ok:42")
    assert_eq(classify2("-7"), "ok:-7")
    assert_eq(classify2("abc"), "err:not an integer")

    // three-bind
    assert_eq(sum3("1", "2", "3"), 6)
    assert_eq(sum3("1", "x", "3"), -999)
    assert_eq(sum3("1", "2", "z"), -999)

    print("with_else_test passed")
