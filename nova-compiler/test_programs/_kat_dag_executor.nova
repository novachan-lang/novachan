import forge_dag_executor

fn main()
    let d = dag_new()
    d = dag_add_task(d, "compile")
    d = dag_add_task(d, "link")
    d = dag_add_task(d, "test")
    assert(dag_task_count(d) == 3, "3 tasks")

    let r1 = dag_add_dep(d, "link", "compile")
    assert(is_ok(r1), "dep ok")
    d = unwrap(r1)
    let r2 = dag_add_dep(d, "test", "link")
    assert(is_ok(r2), "dep2 ok")
    d = unwrap(r2)

    assert(dag_is_ready(d, "compile") == 1, "compile ready")
    assert(dag_is_ready(d, "link") == 0, "link not ready")
    assert(dag_is_ready(d, "test") == 0, "test not ready")

    let e1 = dag_execute(d, "compile")
    assert(is_ok(e1), "exec compile ok")
    d = unwrap(e1)
    assert(dag_is_done(d, "compile") == 1, "compile done")

    assert(dag_is_ready(d, "link") == 1, "link now ready")
    let e2 = dag_execute(d, "link")
    assert(is_ok(e2), "exec link ok")
    d = unwrap(e2)

    let e3 = dag_execute(d, "test")
    assert(is_ok(e3), "exec test ok")
    d = unwrap(e3)
    assert(dag_is_complete(d) == 1, "all complete")
    assert(dag_executed_count(d) == 3, "3 executed")

    let bad = dag_execute(d, "nope")
    assert(is_err(bad), "bad task err")

    let bd = dag_add_dep(d, "nope", "compile")
    assert(is_err(bd), "bad dep err")

    print("DAG-EXECUTOR KAT PASS")
