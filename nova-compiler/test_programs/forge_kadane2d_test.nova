import forge_kadane2d

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

// brute force: max sum over all rectangles
fn brute(m: list) -> int
    let r = len(m)
    let c = len(m[0])
    let best = m[0][0]
    let t = 0
    while t < r
        let b = t
        while b < r
            let l = 0
            while l < c
                let rr = l
                while rr < c
                    let s = 0
                    let i = t
                    while i <= b
                        let j = l
                        while j <= rr
                            s = s + m[i][j]
                            j = j + 1
                        i = i + 1
                    if s > best
                        best = s
                    rr = rr + 1
                l = l + 1
            b = b + 1
        t = t + 1
    best

fn main()
    let fails = 0

    // classic GfG example -> 29
    let m1 = []
    push(m1, [1, 2, 0 - 1, 0 - 4, 0 - 20])
    push(m1, [0 - 8, 0 - 3, 4, 2, 1])
    push(m1, [3, 8, 10, 1, 3])
    push(m1, [0 - 4, 0 - 1, 1, 7, 0 - 6])
    fails = fails + expect("gfg", str(max_submatrix_sum(m1)), "29")

    // whole matrix is the answer
    let m2 = []
    push(m2, [1, 2])
    push(m2, [3, 4])
    fails = fails + expect("all_pos", str(max_submatrix_sum(m2)), "10")

    // all negative -> single largest element
    let m3 = []
    push(m3, [0 - 1, 0 - 2])
    push(m3, [0 - 3, 0 - 4])
    fails = fails + expect("all_neg", str(max_submatrix_sum(m3)), "-1")

    // single cell
    let m4 = []
    push(m4, [42])
    fails = fails + expect("single", str(max_submatrix_sum(m4)), "42")

    // rectangle corners sum to the reported max
    let rect = max_submatrix_rect(m1)
    let s = 0
    let i = rect[0]
    while i <= rect[2]
        let j = rect[1]
        while j <= rect[3]
            s = s + m1[i][j]
            j = j + 1
        i = i + 1
    fails = fails + expect("rect_sum", str(s), "29")

    // brute-force cross-check on several matrices
    let m5 = []
    push(m5, [2, 0 - 1, 3])
    push(m5, [0 - 4, 5, 0 - 2])
    push(m5, [1, 0 - 3, 6])
    fails = fails + expect("cross1", str(max_submatrix_sum(m5)), str(brute(m5)))

    let m6 = []
    push(m6, [0 - 2, 1, 0 - 3, 4])
    push(m6, [5, 0 - 1, 2, 0 - 6])
    push(m6, [3, 0 - 4, 1, 8])
    fails = fails + expect("cross2", str(max_submatrix_sum(m6)), str(brute(m6)))

    if fails == 0
        print("forge_kadane2d: all passed")
    else
        print("forge_kadane2d: " + str(fails) + " FAILED")
