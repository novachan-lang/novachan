import forge_message_bus

fn main()
    let b = bus_new()
    b = bus_create_topic(b, "orders")
    b = bus_create_topic(b, "events")

    let topics = bus_list_topics(b)
    assert(len(topics) == 2, "2 topics")

    b = bus_subscribe(b, "orders", "fulfillment")
    b = bus_subscribe(b, "orders", "analytics")
    b = bus_subscribe(b, "events", "logger")

    let subs = bus_get_subscribers(b, "orders")
    assert(len(subs) == 2, "2 order subscribers")

    b = bus_publish(b, "orders", "order-001")
    b = bus_publish(b, "orders", "order-002")
    b = bus_publish(b, "events", "user-login")

    assert(bus_message_count(b, "orders") == 2, "2 order messages")
    assert(bus_message_count(b, "events") == 1, "1 event message")
    assert(bus_total_messages(b) == 3, "3 total messages")

    let msgs = bus_get_messages(b, "orders")
    assert(msgs[0]["payload"] == "order-001", "first order")
    assert(msgs[0]["seq"] == 1, "seq=1")
    assert(msgs[1]["seq"] == 2, "seq=2")

    b = bus_publish(b, "orders", "order-003")
    let replay = bus_replay_since(b, "orders", 1)
    assert(len(replay) == 2, "2 messages since seq 1")
    assert(replay[0]["payload"] == "order-002", "replay first")

    b = bus_publish(b, "new_topic", "auto-create")
    assert(bus_message_count(b, "new_topic") == 1, "auto-created topic")

    print("MESSAGE-BUS KAT PASS")
