// KAT for std/grammar/grammar_earley
// Tests: ambiguous grammar E->E+E|id and unambiguous S->aSb|epsilon
import std/grammar/grammar_earley

fn cki(label, got, want)
    if got != want
        print("FAIL _grammar_earley_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    if got != want
        print("FAIL _grammar_earley_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ─── Grammar 1: ambiguous  E -> E "+" E | "id" ───────────────────────────
    let ep1 = ["E", ["E", "+", "E"]]
    let ep2 = ["E", ["id"]]
    let eprods = []
    push(eprods, ep1)
    push(eprods, ep2)

    // KAT 1: gre_recognize("id") = true
    let tok_id = ["id"]
    ckb("e_recognize_id", gre_recognize(eprods, "E", tok_id), 1)

    // KAT 2: gre_recognize("id+id") = true
    let tok_id_p_id = ["id", "+", "id"]
    ckb("e_recognize_id_plus_id", gre_recognize(eprods, "E", tok_id_p_id), 1)

    // KAT 3: gre_recognize("id+id+id") = true
    let tok3 = ["id", "+", "id", "+", "id"]
    ckb("e_recognize_triple", gre_recognize(eprods, "E", tok3), 1)

    // KAT 4: gre_recognize("+id") = false
    let tok_bad1 = ["+", "id"]
    ckb("e_recognize_bad1", gre_recognize(eprods, "E", tok_bad1), 0)

    // KAT 5: gre_recognize("id+") = false
    let tok_bad2 = ["id", "+"]
    ckb("e_recognize_bad2", gre_recognize(eprods, "E", tok_bad2), 0)

    // KAT 6: gre_recognize([]) = false (empty tokens, no epsilon production)
    let tok_empty = []
    ckb("e_recognize_empty", gre_recognize(eprods, "E", tok_empty), 0)

    // KAT 7: gre_parse_count("id") = 1 (only one parse)
    cki("e_count_id", gre_parse_count(eprods, "E", tok_id), 1)

    // KAT 8: gre_parse_count("id+id") = 1 (only one parse for two operands)
    cki("e_count_id_plus_id", gre_parse_count(eprods, "E", tok_id_p_id), 1)

    // KAT 9: gre_parse_count("id+id+id") = 2 (two parses: (id+id)+id and id+(id+id))
    cki("e_count_triple", gre_parse_count(eprods, "E", tok3), 2)

    // KAT 10: gre_is_ambiguous_upto(prods,"E",5) = true
    ckb("e_is_ambiguous_upto5", gre_is_ambiguous_upto(eprods, "E", 5), 1)

    // ─── Grammar 2: unambiguous  S -> a S b | epsilon ────────────────────────
    let sp1 = ["S", ["a", "S", "b"]]
    let sp2 = ["S", []]
    let sprods = []
    push(sprods, sp1)
    push(sprods, sp2)

    // KAT 11: gre_recognize("aabb") = true  (a^2 b^2)
    let tok_aabb = ["a", "a", "b", "b"]
    ckb("s_recognize_aabb", gre_recognize(sprods, "S", tok_aabb), 1)

    // KAT 12: gre_recognize([]) = true (epsilon)
    ckb("s_recognize_eps", gre_recognize(sprods, "S", tok_empty), 1)

    // KAT 13: gre_recognize("ab") = true
    let tok_ab = ["a", "b"]
    ckb("s_recognize_ab", gre_recognize(sprods, "S", tok_ab), 1)

    // KAT 14: gre_recognize("abb") = false
    let tok_abb = ["a", "b", "b"]
    ckb("s_recognize_abb", gre_recognize(sprods, "S", tok_abb), 0)

    // KAT 15: gre_recognize("aab") = false
    let tok_aab = ["a", "a", "b"]
    ckb("s_recognize_aab", gre_recognize(sprods, "S", tok_aab), 0)

    // KAT 16: gre_recognize("ba") = false
    let tok_ba = ["b", "a"]
    ckb("s_recognize_ba", gre_recognize(sprods, "S", tok_ba), 0)

    // KAT 17: gre_is_ambiguous_upto(sprods,"S",6) = false (S->aSb|eps is unambiguous)
    ckb("s_not_ambiguous_upto6", gre_is_ambiguous_upto(sprods, "S", 6), 0)

    // KAT 18: gre_parse_count("aabb") = 1 (unique parse)
    cki("s_count_aabb", gre_parse_count(sprods, "S", tok_aabb), 1)

    // KAT 19: gre_parse_count(eps) = 1 (unique parse: S->epsilon)
    cki("s_count_eps", gre_parse_count(sprods, "S", tok_empty), 1)

    // ─── Grammar 3: simple A->a (single terminal) ─────────────────────────────
    let ap1 = ["A", ["a"]]
    let aprods = []
    push(aprods, ap1)

    // KAT 20: gre_recognize(["a"]) = true
    let tok_a = ["a"]
    ckb("a_recognize_a", gre_recognize(aprods, "A", tok_a), 1)

    // KAT 21: gre_recognize(["b"]) = false
    let tok_b = ["b"]
    ckb("a_recognize_b", gre_recognize(aprods, "A", tok_b), 0)

    // KAT 22: gre_recognize([]) = false
    ckb("a_recognize_empty", gre_recognize(aprods, "A", tok_empty), 0)

    print("PASS _grammar_earley_test")
