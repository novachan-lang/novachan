import forge_dependency_graph

fn main()
    let g = dg_new()
    let r1 = dg_add_node(g, "A")
    assert(is_ok(r1), "add A")
    g = unwrap(r1)
    let r2 = dg_add_node(g, "B")
    assert(is_ok(r2), "add B")
    g = unwrap(r2)
    assert(dg_node_count(g) == 2, "2 nodes")

    let dup = dg_add_node(g, "A")
    assert(is_err(dup), "duplicate node")

    let r3 = dg_add_edge(g, "A", "B")
    assert(is_ok(r3), "add edge A->B")
    g = unwrap(r3)
    assert(dg_edge_count(g) == 1, "1 edge")
    assert(dg_has_edge(g, "A", "B") == 1, "has A->B")
    assert(dg_has_edge(g, "B", "A") == 0, "no B->A")

    let r4 = dg_add_edge(g, "B", "A")
    assert(is_ok(r4), "add edge B->A")
    g = unwrap(r4)
    assert(dg_has_cycle_pair(g, "A", "B") == 1, "cycle detected")

    let bad = dg_add_edge(g, "A", "Z")
    assert(is_err(bad), "unknown node Z")

    print("DEPENDENCY-GRAPH KAT PASS")
