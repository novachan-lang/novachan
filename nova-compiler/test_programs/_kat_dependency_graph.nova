import forge_dependency_graph

fn main()
    let dg = dg_new()
    dg = dg_add_node(dg, "app")
    dg = dg_add_node(dg, "auth")
    dg = dg_add_node(dg, "db")
    dg = dg_add_node(dg, "cache")
    dg = dg_add_node(dg, "config")

    dg = dg_add_edge(dg, "app", "auth")
    dg = dg_add_edge(dg, "app", "db")
    dg = dg_add_edge(dg, "auth", "db")
    dg = dg_add_edge(dg, "auth", "cache")
    dg = dg_add_edge(dg, "db", "config")
    dg = dg_add_edge(dg, "cache", "config")

    assert(dg_node_count(dg) == 5, "5 nodes")
    assert(dg_edge_count(dg) == 6, "6 edges")

    let app_deps = dg_dependencies(dg, "app")
    assert(len(app_deps) == 2, "app has 2 deps")

    let db_users = dg_dependents(dg, "db")
    assert(len(db_users) == 2, "db has 2 dependents")

    let roots = dg_roots(dg)
    assert(len(roots) == 1, "1 root")
    assert(roots[0] == "app", "root=app")

    let leaves = dg_leaves(dg)
    assert(len(leaves) == 1, "1 leaf")
    assert(leaves[0] == "config", "leaf=config")

    let sorted = dg_topo_sort(dg)
    assert(len(sorted) == 5, "5 in topo order")
    assert(sorted[0] == "app", "topo first=app")

    let impact = dg_impact(dg, "config")
    assert(len(impact) >= 2, "config impacts >=2 nodes")

    print("DEPENDENCY-GRAPH KAT PASS")
