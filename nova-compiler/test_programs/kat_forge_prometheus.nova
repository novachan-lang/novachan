// KAT: forge_prometheus -- Prometheus text exposition (0.0.4) formatter. Byte-exact checks for a
// counter, a gauge, a histogram (buckets 0.1/0.5/1/+Inf), label-value escaping (backslash, quote,
// newline), and the empty/missing edge cases (no labels, empty series list).
import forge_prometheus

fn main()
    let q = chr(34)
    let nl = chr(10)
    let bs = chr(92)
    let lb = chr(123)
    let rb = chr(125)

    // ── 1. Counter: http_requests_total{method="GET"} 5, with HELP+TYPE ────────────────────────
    let counter_series = [{"labels": [["method", "GET"]], "value": 5}]
    let counter_text = prom_counter("http_requests_total", "Total HTTP requests", counter_series)
    let counter_want = "# HELP http_requests_total Total HTTP requests" + nl
    counter_want = counter_want + "# TYPE http_requests_total counter" + nl
    counter_want = counter_want + "http_requests_total" + lb + "method=" + q + "GET" + q + rb + " 5" + nl
    if counter_text != counter_want
        print("FAIL counter:\nGOT:  " + counter_text + "\nWANT: " + counter_want)
        exit(1)

    // Counter with multiple labels + multiple series (label ORDER preserved, not alphabetized).
    let counter2_series = [{"labels": [["method", "GET"], ["code", "200"]], "value": 12}, {"labels": [["method", "POST"], ["code", "500"]], "value": 3}]
    let counter2_text = prom_counter("api_calls_total", "API calls", counter2_series)
    let counter2_want = "# HELP api_calls_total API calls" + nl + "# TYPE api_calls_total counter" + nl
    counter2_want = counter2_want + "api_calls_total" + lb + "method=" + q + "GET" + q + ",code=" + q + "200" + q + rb + " 12" + nl
    counter2_want = counter2_want + "api_calls_total" + lb + "method=" + q + "POST" + q + ",code=" + q + "500" + q + rb + " 3" + nl
    if counter2_text != counter2_want
        print("FAIL counter2:\nGOT:  " + counter2_text + "\nWANT: " + counter2_want)
        exit(1)

    // ── 2. Gauge: unlabeled + labeled, int and float values ────────────────────────────────────
    let gauge_series = [{"labels": [], "value": 42}]
    let gauge_text = prom_gauge("queue_depth", "Items waiting", gauge_series)
    let gauge_want = "# HELP queue_depth Items waiting" + nl + "# TYPE queue_depth gauge" + nl + "queue_depth 42" + nl
    if gauge_text != gauge_want
        print("FAIL gauge:\nGOT:  " + gauge_text + "\nWANT: " + gauge_want)
        exit(1)

    let gauge2_series = [{"labels": [["region", "us-east"]], "value": 23.5}]
    let gauge2_text = prom_gauge("temperature_celsius", "Current temperature", gauge2_series)
    let gauge2_want = "# HELP temperature_celsius Current temperature" + nl + "# TYPE temperature_celsius gauge" + nl
    gauge2_want = gauge2_want + "temperature_celsius" + lb + "region=" + q + "us-east" + q + rb + " 23.5" + nl
    if gauge2_text != gauge2_want
        print("FAIL gauge2:\nGOT:  " + gauge2_text + "\nWANT: " + gauge2_want)
        exit(1)

    // ── 3. Histogram: buckets 0.1/0.5/1/+Inf -> exact _bucket/_sum/_count lines ────────────────
    let hist_series = [{"labels": [], "buckets": [["0.1", 5], ["0.5", 9], ["1", 9], ["+Inf", 10]], "sum": 3.5, "count": 10}]
    let hist_text = prom_histogram("http_request_duration_seconds", "Request duration", hist_series)
    let hist_want = "# HELP http_request_duration_seconds Request duration" + nl + "# TYPE http_request_duration_seconds histogram" + nl
    hist_want = hist_want + "http_request_duration_seconds_bucket" + lb + "le=" + q + "0.1" + q + rb + " 5" + nl
    hist_want = hist_want + "http_request_duration_seconds_bucket" + lb + "le=" + q + "0.5" + q + rb + " 9" + nl
    hist_want = hist_want + "http_request_duration_seconds_bucket" + lb + "le=" + q + "1" + q + rb + " 9" + nl
    hist_want = hist_want + "http_request_duration_seconds_bucket" + lb + "le=" + q + "+Inf" + q + rb + " 10" + nl
    hist_want = hist_want + "http_request_duration_seconds_sum 3.5" + nl
    hist_want = hist_want + "http_request_duration_seconds_count 10" + nl
    if hist_text != hist_want
        print("FAIL histogram:\nGOT:  " + hist_text + "\nWANT: " + hist_want)
        exit(1)

    // Histogram WITH extra labels: "le" must be appended without mutating the series's shared
    // labels list (checked by rendering the SAME series struct twice in a row below and comparing).
    let hist2_series = [{"labels": [["path", "/api"]], "buckets": [["0.1", 2], ["+Inf", 4]], "sum": 1.2, "count": 4}]
    let hist2_text_a = prom_histogram("route_duration_seconds", "Per-route duration", hist2_series)
    let hist2_text_b = prom_histogram("route_duration_seconds", "Per-route duration", hist2_series)
    if hist2_text_a != hist2_text_b
        print("FAIL histogram2 not idempotent (labels list mutated):\nA: " + hist2_text_a + "\nB: " + hist2_text_b)
        exit(1)
    let hist2_want = "# HELP route_duration_seconds Per-route duration" + nl + "# TYPE route_duration_seconds histogram" + nl
    hist2_want = hist2_want + "route_duration_seconds_bucket" + lb + "path=" + q + "/api" + q + ",le=" + q + "0.1" + q + rb + " 2" + nl
    hist2_want = hist2_want + "route_duration_seconds_bucket" + lb + "path=" + q + "/api" + q + ",le=" + q + "+Inf" + q + rb + " 4" + nl
    hist2_want = hist2_want + "route_duration_seconds_sum" + lb + "path=" + q + "/api" + q + rb + " 1.2" + nl
    hist2_want = hist2_want + "route_duration_seconds_count" + lb + "path=" + q + "/api" + q + rb + " 4" + nl
    if hist2_text_a != hist2_want
        print("FAIL histogram2:\nGOT:  " + hist2_text_a + "\nWANT: " + hist2_want)
        exit(1)

    // ── 4. Label-value escaping: backslash, double-quote, newline (all three in one value) ─────
    let raw = "line1" + nl + "line2 " + q + "quoted" + q + " back" + bs + "slash"
    let escaped = prom_escape_label(raw)
    let escaped_want = "line1" + bs + "n" + "line2 " + bs + q + "quoted" + bs + q + " back" + bs + bs + "slash"
    if escaped != escaped_want
        print("FAIL escape:\nGOT:  " + escaped + "\nWANT: " + escaped_want)
        exit(1)
    // Round-trip through a full counter line: value renders as a single-line, well-formed series.
    let esc_series = [{"labels": [["msg", raw]], "value": 1}]
    let esc_text = prom_counter("weird_label_total", "Escaping check", esc_series)
    let esc_want = "# HELP weird_label_total Escaping check" + nl + "# TYPE weird_label_total counter" + nl
    esc_want = esc_want + "weird_label_total" + lb + "msg=" + q + escaped_want + q + rb + " 1" + nl
    if esc_text != esc_want
        print("FAIL escape-in-counter:\nGOT:  " + esc_text + "\nWANT: " + esc_want)
        exit(1)
    // A plain value (no special chars) must pass through unchanged.
    if prom_escape_label("plain-value_123") != "plain-value_123"
        print("FAIL escape plain passthrough")
        exit(1)
    // Empty value.
    if prom_escape_label("") != ""
        print("FAIL escape empty")
        exit(1)

    // ── 5. Empty / missing edge cases ───────────────────────────────────────────────────────────
    // Empty series list -> just the HELP/TYPE header, no series lines.
    let empty_text = prom_counter("nothing_total", "Never observed", [])
    let empty_want = "# HELP nothing_total Never observed" + nl + "# TYPE nothing_total counter" + nl
    if empty_text != empty_want
        print("FAIL empty series:\nGOT:  " + empty_text + "\nWANT: " + empty_want)
        exit(1)
    // Empty help text still renders a well-formed (if terse) header.
    let nohelp_text = prom_gauge("bare_metric", "", [{"labels": [], "value": 0}])
    let nohelp_want = "# HELP bare_metric " + nl + "# TYPE bare_metric gauge" + nl + "bare_metric 0" + nl
    if nohelp_text != nohelp_want
        print("FAIL empty help:\nGOT:  " + nohelp_text + "\nWANT: " + nohelp_want)
        exit(1)
    // Empty label list on prom_label_str directly -> "".
    if prom_label_str([]) != ""
        print("FAIL empty label_str")
        exit(1)
    // Histogram with zero buckets: still emits sum/count for the series.
    let hist0_series = [{"labels": [], "buckets": [], "sum": 0, "count": 0}]
    let hist0_text = prom_histogram("zero_hist", "No buckets", hist0_series)
    let hist0_want = "# HELP zero_hist No buckets" + nl + "# TYPE zero_hist histogram" + nl + "zero_hist_sum 0" + nl + "zero_hist_count 0" + nl
    if hist0_text != hist0_want
        print("FAIL zero-bucket histogram:\nGOT:  " + hist0_text + "\nWANT: " + hist0_want)
        exit(1)

    // ── 6. prom_cumulative: raw per-bucket tallies -> running-sum cumulative counts ─────────────
    let cum = prom_cumulative([5, 4, 0, 1])
    if len(cum) != 4 or cum[0] != 5 or cum[1] != 9 or cum[2] != 9 or cum[3] != 10
        print("FAIL prom_cumulative: " + str(cum))
        exit(1)
    if len(prom_cumulative([])) != 0
        print("FAIL prom_cumulative empty")
        exit(1)

    // ── 7. prom_document: concatenates rendered blocks in order, "" for empty input ─────────────
    let doc = prom_document([counter_text, gauge_text])
    if doc != counter_text + gauge_text
        print("FAIL prom_document concat")
        exit(1)
    if prom_document([]) != ""
        print("FAIL prom_document empty")
        exit(1)

    // ── 8. HELP-line escaping: backslash -> \\, newline -> \n (spec 0.0.4). Quote is NOT escaped in
    // a HELP line (unlike a label value) -- it is opaque prose, not inside a quoted string literal.
    let help_raw = "Docs with " + bs + "backslash and" + nl + "a newline, plus a " + q + "quote" + q + " left as-is"
    let help_escaped = prom_escape_help(help_raw)
    let help_escaped_want = "Docs with " + bs + bs + "backslash and" + bs + "n" + "a newline, plus a " + q + "quote" + q + " left as-is"
    if help_escaped != help_escaped_want
        print("FAIL escape-help direct:\nGOT:  " + help_escaped + "\nWANT: " + help_escaped_want)
        exit(1)
    // Round-trip through a full HELP/TYPE header: both escapes land in the actual rendered text.
    let help_text = prom_counter("help_escape_total", help_raw, [])
    let help_want = "# HELP help_escape_total " + help_escaped_want + nl + "# TYPE help_escape_total counter" + nl
    if help_text != help_want
        print("FAIL escape-help-in-counter:\nGOT:  " + help_text + "\nWANT: " + help_want)
        exit(1)
    // Plain help text (no special chars) passes through unchanged.
    if prom_escape_help("Total HTTP requests") != "Total HTTP requests"
        print("FAIL escape-help plain passthrough")
        exit(1)

    print("PASS forge_prometheus (counter/gauge/histogram byte-exact, escaping, HELP-line backslash/newline escaping, empty/zero-bucket edge cases, cumulative+document helpers)")
