import std/dp/dp_partition_equal

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn ckl(label, got, want)
    let lg = len(got)
    let lw = len(want)
    if lg != lw
        print("FAIL " + label + " len: got=" + str(lg) + " want=" + str(lw))
        exit(1)
    let k = 0
    while k < lw
        if got[k] != want[k]
            print("FAIL " + label + "[" + str(k) + "]: got=" + str(got[k]) + " want=" + str(want[k]))
            exit(1)
        k = k + 1

fn main()
    // KAT 1: pe_can_partition([1,5,11,5]) == true  (1+5+5=11)
    let a1 = []
    push(a1, 1)
    push(a1, 5)
    push(a1, 11)
    push(a1, 5)
    ckb("pe_can_partition [1,5,11,5]", pe_can_partition(a1), true)

    // KAT 2: pe_can_partition([1,2,3,5]) == false  (sum=11, odd)
    let a2 = []
    push(a2, 1)
    push(a2, 2)
    push(a2, 3)
    push(a2, 5)
    ckb("pe_can_partition [1,2,3,5]", pe_can_partition(a2), false)

    // KAT 3: pe_min_diff([1,6,11,5]) == 1
    // sum=23; best reachable half: 11 (6+5) -> diff=|23-22|=1
    let a3 = []
    push(a3, 1)
    push(a3, 6)
    push(a3, 11)
    push(a3, 5)
    cki("pe_min_diff [1,6,11,5]", pe_min_diff(a3), 1)

    // KAT 4: pe_min_diff([3,1,4,2,2]) == 0
    // sum=12; 3+1+2=6 or 4+2=6 -> diff=0
    let a4 = []
    push(a4, 3)
    push(a4, 1)
    push(a4, 4)
    push(a4, 2)
    push(a4, 2)
    cki("pe_min_diff [3,1,4,2,2]", pe_min_diff(a4), 0)

    // KAT 5: pe_can_partition([2,2,2,2]) == true  (2+2=4, sum=8)
    let a5 = []
    push(a5, 2)
    push(a5, 2)
    push(a5, 2)
    push(a5, 2)
    ckb("pe_can_partition [2,2,2,2]", pe_can_partition(a5), true)

    // KAT 6: pe_min_diff([1]) == 1  (one item, one subset gets 0, other gets 1)
    let a6 = []
    push(a6, 1)
    cki("pe_min_diff [1]", pe_min_diff(a6), 1)

    // KAT 7: pe_subset_for_half([1,5,11,5]) has sum == 11
    let a7 = []
    push(a7, 1)
    push(a7, 5)
    push(a7, 11)
    push(a7, 5)
    let sub7 = pe_subset_for_half(a7)
    let s7 = 0
    let k7 = 0
    while k7 < len(sub7)
        s7 = s7 + sub7[k7]
        k7 = k7 + 1
    cki("pe_subset_for_half sum", s7, 11)

    // KAT 8: pe_subset_for_half([1,2,3,5]) == [] (impossible)
    let a8 = []
    push(a8, 1)
    push(a8, 2)
    push(a8, 3)
    push(a8, 5)
    let sub8 = pe_subset_for_half(a8)
    cki("pe_subset_for_half impossible len", len(sub8), 0)

    // KAT 9: pe_can_partition([]) == true (empty: both subsets empty, sum=0=0)
    let a9 = []
    ckb("pe_can_partition []", pe_can_partition(a9), true)

    // KAT 10: pe_min_diff([]) == 0
    let a10 = []
    cki("pe_min_diff []", pe_min_diff(a10), 0)

    print("PASS _dp_partition_equal_test")
