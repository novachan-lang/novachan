import std/numeral/cardinal_en

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL cardinal_en " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // Boundary and spec cases
    cks("0",       car_cardinal(0),       "zero")
    cks("1",       car_cardinal(1),       "one")
    cks("7",       car_cardinal(7),       "seven")
    cks("13",      car_cardinal(13),      "thirteen")
    cks("19",      car_cardinal(19),      "nineteen")
    cks("20",      car_cardinal(20),      "twenty")
    cks("21",      car_cardinal(21),      "twenty-one")
    cks("42",      car_cardinal(42),      "forty-two")
    cks("99",      car_cardinal(99),      "ninety-nine")
    cks("100",     car_cardinal(100),     "one hundred")
    cks("101",     car_cardinal(101),     "one hundred one")
    cks("305",     car_cardinal(305),     "three hundred five")
    cks("999",     car_cardinal(999),     "nine hundred ninety-nine")
    cks("1000",    car_cardinal(1000),    "one thousand")
    cks("1001",    car_cardinal(1001),    "one thousand one")
    cks("1234",    car_cardinal(1234),    "one thousand two hundred thirty-four")
    cks("10000",   car_cardinal(10000),   "ten thousand")
    cks("11000",   car_cardinal(11000),   "eleven thousand")
    cks("20000",   car_cardinal(20000),   "twenty thousand")
    cks("100000",  car_cardinal(100000),  "one hundred thousand")
    cks("1000000", car_cardinal(1000000), "one million")
    cks("2000001", car_cardinal(2000001), "two million one")
    cks("-7",      car_cardinal(-7),      "negative seven")
    cks("-42",     car_cardinal(-42),     "negative forty-two")
    cks("-100",    car_cardinal(-100),    "negative one hundred")
    cks("1000000000",  car_cardinal(1000000000),  "one billion")
    cks("999999999999", car_cardinal(999999999999), "nine hundred ninety-nine billion nine hundred ninety-nine million nine hundred ninety-nine thousand nine hundred ninety-nine")

    print("PASS _cardinal_en_test")
