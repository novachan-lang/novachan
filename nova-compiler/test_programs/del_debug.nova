fn main()
    let d = {}
    d["a"] = "1"
    d["b"] = "2"
    print("before del: " + str(keys(d)))
    print("has a: " + str(contains(d, "a")))
    del(d, "a")
    print("after del a: " + str(keys(d)))
    print("has a: " + str(contains(d, "a")))
    print("has b: " + str(contains(d, "b")))
    print("del_debug: PASS")
