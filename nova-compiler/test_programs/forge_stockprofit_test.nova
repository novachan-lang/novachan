import forge_stockprofit

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // unlimited transactions
    fails = fails + expect("unl1", str(max_profit_unlimited([7, 1, 5, 3, 6, 4])), "7")
    fails = fails + expect("unl_asc", str(max_profit_unlimited([1, 2, 3, 4, 5])), "4")
    fails = fails + expect("unl_desc", str(max_profit_unlimited([7, 6, 4, 3, 1])), "0")
    fails = fails + expect("unl_single", str(max_profit_unlimited([5])), "0")

    // with fee
    fails = fails + expect("fee1", str(max_profit_with_fee([1, 3, 2, 8, 4, 9], 2)), "8")
    fails = fails + expect("fee_high", str(max_profit_with_fee([1, 3, 7, 5, 10, 3], 3)), "6")
    fails = fails + expect("fee_none_profit", str(max_profit_with_fee([1, 2], 5)), "0")

    // at most k transactions
    fails = fails + expect("k1", str(max_profit_k([2, 4, 1], 2)), "2")
    fails = fails + expect("k2", str(max_profit_k([3, 2, 6, 5, 0, 3], 2)), "7")
    fails = fails + expect("k_one", str(max_profit_k([7, 1, 5, 3, 6, 4], 1)), "5")
    fails = fails + expect("k_large", str(max_profit_k([1, 2, 3, 4, 5], 10)), "4")
    fails = fails + expect("k_zero", str(max_profit_k([1, 2, 3], 0)), "0")

    if fails == 0
        print("forge_stockprofit: all passed")
    else
        print("forge_stockprofit: " + str(fails) + " FAILED")
