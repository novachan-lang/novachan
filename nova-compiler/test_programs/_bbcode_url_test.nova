// KAT test for std/text/bbcode_url
import std/text/bbcode_url

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got [" + got + "] want [" + want + "]")
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // KAT 1: extract_urls — bare form [url]X[/url]
    let u1 = burl_extract_urls("[url]http://x.com[/url]")
    cki("extract_bare_len", len(u1), 1)
    cks("extract_bare_val", u1[0], "http://x.com")

    // KAT 2: extract_urls — attribute form [url=X]text[/url]
    let u2 = burl_extract_urls("[url=http://a.com]click[/url]")
    cki("extract_attr_len", len(u2), 1)
    cks("extract_attr_val", u2[0], "http://a.com")

    // KAT 3: extract_urls — multiple mixed occurrences
    let u3 = burl_extract_urls("[url]http://a.com[/url] and [url=http://b.com]b[/url]")
    cki("extract_multi_len", len(u3), 2)
    cks("extract_multi_0", u3[0], "http://a.com")
    cks("extract_multi_1", u3[1], "http://b.com")

    // KAT 4: extract_urls — no tags present
    let u4 = burl_extract_urls("just plain text, no tags here")
    cki("extract_none_len", len(u4), 0)

    // KAT 5: build with non-empty text uses attribute form
    let b1 = burl_build("http://x.com", "click here")
    cks("build_with_text", b1, "[url=http://x.com]click here[/url]")

    // KAT 6: build with empty text uses bare form
    let b2 = burl_build("http://x.com", "")
    cks("build_no_text", b2, "[url]http://x.com[/url]")

    // KAT 7: is_safe — http/https accepted, javascript:/data: rejected
    cki("safe_http", burl_is_safe("http://good.com"), 1)
    cki("safe_https", burl_is_safe("https://good.com"), 1)
    cki("unsafe_js", burl_is_safe("javascript:alert(1)"), 0)
    cki("unsafe_data", burl_is_safe("data:text/html,x"), 0)

    // KAT 8: count — two [url] tags of either form
    let c1 = burl_count("[url]http://a.com[/url] then [url=http://b.com]b[/url]")
    cki("count_two", c1, 2)

    // KAT 9: count — zero tags
    cki("count_zero", burl_count("nothing here"), 0)

    // KAT 10: replace_urls — bare form swaps content
    let r1 = burl_replace_urls("[url]http://old.com[/url]", "http://new.com")
    cks("replace_bare", r1, "[url]http://new.com[/url]")

    // KAT 11: replace_urls — attribute form keeps link text, swaps URL
    let r2 = burl_replace_urls("[url=http://old.com]my text[/url]", "http://new.com")
    cks("replace_attr", r2, "[url=http://new.com]my text[/url]")

    print("PASS _bbcode_url_test")
