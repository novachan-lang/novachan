import forge_diff_engine

fn main()
    let old_d = {}
    old_d["name"] = "Alice"
    old_d["age"] = "30"
    old_d["city"] = "NYC"

    let new_d = {}
    new_d["name"] = "Alice"
    new_d["age"] = "31"
    new_d["country"] = "US"

    let d = diff_compute(old_d, new_d)
    assert(diff_has_changes(d) == 1, "has changes")
    assert(diff_change_count(d) == 3, "3 changes")

    let t0 = diff_change_type(d, 0)
    assert(is_ok(t0), "type ok")

    let bad = diff_change_key(d, 99)
    assert(is_err(bad), "out of range is err")

    let same_a = {}
    same_a["x"] = "1"
    let same_b = {}
    same_b["x"] = "1"
    let d2 = diff_compute(same_a, same_b)
    assert(diff_has_changes(d2) == 0, "no changes")

    print("DIFF-ENGINE KAT PASS")
