import forge_intmatrix as mx

fn check(cond: bool, label: string)
    if cond == false
        print("FAIL: " + label)

// a tiny deterministic pseudo-random generator for building test matrices
fn lcg(state: int) -> int
    (state * 1103515245 + 12345) % 2147483648

fn main()
    // ---- fixed determinants ----
    check(mx.det([[5]]) == 5, "det 1x1")
    check(mx.det([[1, 2], [3, 4]]) == 0 - 2, "det 2x2 == -2")
    check(mx.det([[2, 0], [0, 3]]) == 6, "det diagonal 2x3")
    // classic 3x3: det = -306
    check(mx.det([[6, 1, 1], [4, -2, 5], [2, 8, 7]]) == 0 - 306, "det 3x3 == -306")
    // identity determinants
    check(mx.det(mx.mat_identity(4)) == 1, "det I4 == 1")
    check(mx.det(mx.mat_identity(6)) == 1, "det I6 == 1")
    // singular (rank-deficient: row3 = row1+row2)
    check(mx.det([[1, 2, 3], [4, 5, 6], [5, 7, 9]]) == 0, "singular det == 0")
    // upper triangular: det = product of diagonal = 2*3*4 = 24
    check(mx.det([[2, 5, 7], [0, 3, 1], [0, 0, 4]]) == 24, "triangular det == 24")

    // ---- Bareiss vs cofactor cross-check ----
    check(mx.det([[6, 1, 1], [4, -2, 5], [2, 8, 7]]) == mx.det_cofactor([[6, 1, 1], [4, -2, 5], [2, 8, 7]]), "bareiss==cofactor 3x3")

    // ---- mat_mul basics ----
    let prod = mx.mat_mul([[1, 2], [3, 4]], [[5, 6], [7, 8]])
    let pr0 = prod[0]
    let pr1 = prod[1]
    check(pr0[0] == 19 and pr0[1] == 22, "mat_mul row0")
    check(pr1[0] == 43 and pr1[1] == 50, "mat_mul row1")
    // A * I == A
    let ai = mx.mat_mul([[3, 5], [7, 9]], mx.mat_identity(2))
    let ai0 = ai[0]
    check(ai0[0] == 3 and ai0[1] == 5, "A*I == A")

    // ---- big cross-check: for many random integer matrices, Bareiss == cofactor, and det(A*B)==det(A)*det(B) ----
    let st = 987654321
    let trial = 0
    while trial < 40
        // pick size 2..4
        st = lcg(st)
        let n = 2 + (st % 3)
        // build A and B with small entries in [-4,4]
        let A = []
        let B = []
        let i = 0
        while i < n
            let ra = []
            let rb = []
            let j = 0
            while j < n
                st = lcg(st)
                push(ra, (st % 9) - 4)
                st = lcg(st)
                push(rb, (st % 9) - 4)
                j = j + 1
            push(A, ra)
            push(B, rb)
            i = i + 1
        let da = mx.det(A)
        let db = mx.det(B)
        // Bareiss vs cofactor must agree
        check(da == mx.det_cofactor(A), "trial " + str(trial) + " bareiss==cofactor A")
        check(db == mx.det_cofactor(B), "trial " + str(trial) + " bareiss==cofactor B")
        // multiplicativity: det(A*B) == det(A)*det(B)
        let AB = mx.mat_mul(A, B)
        check(mx.det(AB) == da * db, "trial " + str(trial) + " det(A*B)==detA*detB")
        trial = trial + 1

    print("forge_intmatrix: all passed")
