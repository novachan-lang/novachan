import std/tree/tree_rerooting

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn ckl(label, got, expected)
    if len(got) != len(expected)
        print("FAIL " + label + ": len got " + str(len(got)) + " expected " + str(len(expected)))
        exit(1)
    let i = 0
    while i < len(expected)
        if got[i] != expected[i]
            print("FAIL " + label + "[" + str(i) + "]: got " + str(got[i]) + " expected " + str(expected[i]))
            exit(1)
        i = i + 1

fn main()
    // KAT 1: 3-node path 0-1-2. tr_sum_distances=[3,2,3]
    let adjp3 = [[1],[0,2],[1]]
    let sd3 = tr_sum_distances(adjp3, 3)
    ckl("sum_dist_path3", sd3, [3,2,3])

    // KAT 2: 2-node tree. tr_sum_distances=[1,1]
    let adj2 = [[1],[0]]
    let sd2 = tr_sum_distances(adj2, 2)
    ckl("sum_dist_n2", sd2, [1,1])

    // KAT 3: single node. tr_sum_distances=[0]
    let adj1 = [[]]
    let sd1 = tr_sum_distances(adj1, 1)
    ckl("sum_dist_n1", sd1, [0])

    // KAT 4: 5-node tree, adj=[[1,2],[0,3,4],[0],[1],[1]]
    // BFS-verified: node0=6, node1=5, node2=9, node3=8, node4=8
    let adj5 = [[1,2],[0,3,4],[0],[1],[1]]
    let sd5 = tr_sum_distances(adj5, 5)
    ckl("sum_dist_5", sd5, [6,5,9,8,8])

    // KAT 5: 3-node path eccentricity. tr_max_distance=[2,1,2]
    let md3 = tr_max_distance(adjp3, 3)
    ckl("max_dist_path3", md3, [2,1,2])

    // KAT 6: single node eccentricity=[0]
    let md1 = tr_max_distance(adj1, 1)
    ckl("max_dist_n1", md1, [0])

    // KAT 7: 5-node tree eccentricity
    // BFS-verified: [2,2,3,3,3]
    let md5 = tr_max_distance(adj5, 5)
    ckl("max_dist_5", md5, [2,2,3,3,3])

    // KAT 8: 2-node tree eccentricity=[1,1]
    let md2 = tr_max_distance(adj2, 2)
    ckl("max_dist_n2", md2, [1,1])

    print("PASS _tree_rerooting_test")
