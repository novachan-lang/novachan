import std/rational/rfrac_farey

// ckr — check rational equality element-wise
fn ckr(label, got, wn, wd)
    if got[0] != wn or got[1] != wd
        print("FAIL rfrac_farey " + label + ": got=" + str(got[0]) + "/" + str(got[1]) + " want=" + str(wn) + "/" + str(wd))
        exit(1)

// cki — check integer equality
fn cki(label, got, want)
    if got != want
        print("FAIL rfrac_farey " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb — check bool equality
fn ckb(label, got, want)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL rfrac_farey " + label + ": got=" + gs + " want=" + ws)
        exit(1)

// helper: build rational [n, d]
fn rat(n, d)
    let r = []
    r.push(n)
    r.push(d)
    r

// --- rff_mediant ---
// mediant([1,2],[1,3]) = [2,5]  (1+1=2, 2+3=5; gcd(2,5)=1)
let med1 = rff_mediant(rat(1, 2), rat(1, 3))
ckr("mediant_1_2__1_3", med1, 2, 5)
// mediant([0,1],[1,1]) = [1,2]
let med2 = rff_mediant(rat(0, 1), rat(1, 1))
ckr("mediant_0_1__1_1", med2, 1, 2)
// mediant([1,3],[1,2]) = [2,5]
let med3 = rff_mediant(rat(1, 3), rat(1, 2))
ckr("mediant_1_3__1_2", med3, 2, 5)

// --- rff_farey_sequence(5) ---
// Expected 11 terms: [0,1],[1,5],[1,4],[1,3],[2,5],[1,2],[3,5],[2,3],[3,4],[4,5],[1,1]
let fs5 = rff_farey_sequence(5)
cki("farey_5_len", len(fs5), 11)
// Check specific elements
let fs5_0 = fs5[0]
ckr("farey_5_idx0", fs5_0, 0, 1)
let fs5_4 = fs5[4]
ckr("farey_5_idx4", fs5_4, 2, 5)
let fs5_5 = fs5[5]
ckr("farey_5_idx5", fs5_5, 1, 2)
let fs5_10 = fs5[10]
ckr("farey_5_idx10", fs5_10, 1, 1)

// Verify a few more: index1=[1,5], index2=[1,4], index3=[1,3]
let fs5_1 = fs5[1]
ckr("farey_5_idx1", fs5_1, 1, 5)
let fs5_2 = fs5[2]
ckr("farey_5_idx2", fs5_2, 1, 4)
let fs5_3 = fs5[3]
ckr("farey_5_idx3", fs5_3, 1, 3)

// --- rff_farey_sequence(1) ---
let fs1 = rff_farey_sequence(1)
cki("farey_1_len", len(fs1), 2)
let fs1_0 = fs1[0]
ckr("farey_1_idx0", fs1_0, 0, 1)
let fs1_1 = fs1[1]
ckr("farey_1_idx1", fs1_1, 1, 1)

// --- rff_farey_next ---
// rff_farey_next(0,1,1,5,5) = [1,4]
// k = (5+1)/5 = 1; next_n=1*1-0=1; next_d=1*5-1=4
let fn1 = rff_farey_next(0, 1, 1, 5, 5)
ckr("farey_next_0_1_1_5_5", fn1, 1, 4)
// rff_farey_next(1,5,1,4,5) = [1,3]
// k = (5+5)/4 = 2; next_n=2*1-1=1; next_d=2*4-5=3
let fn2 = rff_farey_next(1, 5, 1, 4, 5)
ckr("farey_next_1_5_1_4_5", fn2, 1, 3)

// --- rff_farey_length ---
cki("farey_length_5", rff_farey_length(5), 11)
cki("farey_length_1", rff_farey_length(1), 2)
cki("farey_length_2", rff_farey_length(2), 3)
cki("farey_length_3", rff_farey_length(3), 5)
cki("farey_length_4", rff_farey_length(4), 7)

// --- rff_is_farey_neighbor ---
// [1,3] and [1,2]: |1*2 - 1*3| = |-1| = 1 -> true
ckb("neighbor_1_3__1_2", rff_is_farey_neighbor(rat(1, 3), rat(1, 2)), true)
// [1,3] and [1,1]: |1*1 - 1*3| = |-2| = 2 -> false
ckb("neighbor_1_3__1_1", rff_is_farey_neighbor(rat(1, 3), rat(1, 1)), false)
// [0,1] and [1,5]: |0*5 - 1*1| = 1 -> true
ckb("neighbor_0_1__1_5", rff_is_farey_neighbor(rat(0, 1), rat(1, 5)), true)

print("PASS _rfrac_farey_test")
