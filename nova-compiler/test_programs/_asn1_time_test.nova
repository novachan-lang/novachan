// _asn1_time_test — KAT for std/data/asn1_time
//
// Verifies byte-exact DER encoding of UTCTime and GeneralizedTime (X.690),
// plus round-trip decode with 50-cutoff rule for UTCTime.
//
// KAT vectors:
//   asn1_utctime_encode(2024,3,9,12,34,56):
//     byte0 == 0x17, byte1 == 0x0D, content == "240309123456Z"
//   asn1_gentime_encode(2024,3,9,12,34,56):
//     byte0 == 0x18, byte1 == 0x0F, content == "20240309123456Z"
//   Round-trip UTCTime:  decode recovers year=2024 (50-cutoff: 24 -> 2024)
//   Round-trip GenTime:  decode recovers year=2024 exactly
//   50-cutoff boundary:  YY=49 -> 2049; YY=50 -> 1950; YY=99 -> 1999
//   Malformed:           wrong tag -> [null, 0]; truncated -> [null, 0]

import std/data/asn1_time

// ── KAT 1: asn1_utctime_encode structure ─────────────────────────────────
let utc1 = asn1_utctime_encode(2024, 3, 9, 12, 34, 56)
if bytes_len(utc1) != 15
    print("FAIL kat1: utctime length != 15, got " + str(bytes_len(utc1)))
    exit(1)
if bytes_get(utc1, 0) != 23
    print("FAIL kat1: tag != 0x17 (23), got " + str(bytes_get(utc1, 0)))
    exit(1)
if bytes_get(utc1, 1) != 13
    print("FAIL kat1: len byte != 0x0D (13), got " + str(bytes_get(utc1, 1)))
    exit(1)
print("PASS kat1: utctime_encode tag=0x17 len=0x0D total=15")

// ── KAT 2: UTCTime content bytes "240309123456Z" ─────────────────────────
// ASCII: '2'=50 '4'=52 '0'=48 '3'=51 '0'=48 '9'=57 '1'=49 '2'=50 '3'=51 '4'=52 '5'=53 '6'=54 'Z'=90
let exp_utc = [50, 52, 48, 51, 48, 57, 49, 50, 51, 52, 53, 54, 90]
let ci = 0
while ci < 13
    let got_b = bytes_get(utc1, 2 + ci)
    let want_b = exp_utc[ci]
    if got_b != want_b
        print("FAIL kat2: utctime content[" + str(ci) + "] got=" + str(got_b) + " want=" + str(want_b))
        exit(1)
    ci = ci + 1
print("PASS kat2: utctime content == ascii(240309123456Z)")

// ── KAT 3: asn1_gentime_encode structure ─────────────────────────────────
let gen1 = asn1_gentime_encode(2024, 3, 9, 12, 34, 56)
if bytes_len(gen1) != 17
    print("FAIL kat3: gentime length != 17, got " + str(bytes_len(gen1)))
    exit(1)
if bytes_get(gen1, 0) != 24
    print("FAIL kat3: tag != 0x18 (24), got " + str(bytes_get(gen1, 0)))
    exit(1)
if bytes_get(gen1, 1) != 15
    print("FAIL kat3: len byte != 0x0F (15), got " + str(bytes_get(gen1, 1)))
    exit(1)
print("PASS kat3: gentime_encode tag=0x18 len=0x0F total=17")

// ── KAT 4: GeneralizedTime content bytes "20240309123456Z" ───────────────
// ASCII: '2'=50 '0'=48 '2'=50 '4'=52 '0'=48 '3'=51 '0'=48 '9'=57 '1'=49 '2'=50 '3'=51 '4'=52 '5'=53 '6'=54 'Z'=90
let exp_gen = [50, 48, 50, 52, 48, 51, 48, 57, 49, 50, 51, 52, 53, 54, 90]
let gi = 0
while gi < 15
    let got_gb = bytes_get(gen1, 2 + gi)
    let want_gb = exp_gen[gi]
    if got_gb != want_gb
        print("FAIL kat4: gentime content[" + str(gi) + "] got=" + str(got_gb) + " want=" + str(want_gb))
        exit(1)
    gi = gi + 1
print("PASS kat4: gentime content == ascii(20240309123456Z)")

// ── KAT 5: Round-trip UTCTime decode ─────────────────────────────────────
let rt_utc = asn1_time_decode(utc1, 0)
let rt_utc_dict = rt_utc[0]
let rt_utc_next = rt_utc[1]
if rt_utc_dict == null
    print("FAIL kat5: utctime decode returned null")
    exit(1)
if rt_utc_next != 15
    print("FAIL kat5: utctime next_pos != 15, got " + str(rt_utc_next))
    exit(1)
if rt_utc_dict["tag"] != 23
    print("FAIL kat5: decoded tag != 23, got " + str(rt_utc_dict["tag"]))
    exit(1)
if rt_utc_dict["year"] != 2024
    print("FAIL kat5: decoded year != 2024, got " + str(rt_utc_dict["year"]))
    exit(1)
if rt_utc_dict["month"] != 3
    print("FAIL kat5: decoded month != 3, got " + str(rt_utc_dict["month"]))
    exit(1)
if rt_utc_dict["day"] != 9
    print("FAIL kat5: decoded day != 9, got " + str(rt_utc_dict["day"]))
    exit(1)
if rt_utc_dict["hour"] != 12
    print("FAIL kat5: decoded hour != 12, got " + str(rt_utc_dict["hour"]))
    exit(1)
if rt_utc_dict["min"] != 34
    print("FAIL kat5: decoded min != 34, got " + str(rt_utc_dict["min"]))
    exit(1)
if rt_utc_dict["sec"] != 56
    print("FAIL kat5: decoded sec != 56, got " + str(rt_utc_dict["sec"]))
    exit(1)
print("PASS kat5: utctime round-trip y=2024 mo=3 d=9 h=12 mi=34 s=56")

// ── KAT 6: Round-trip GeneralizedTime decode ─────────────────────────────
let rt_gen = asn1_time_decode(gen1, 0)
let rt_gen_dict = rt_gen[0]
let rt_gen_next = rt_gen[1]
if rt_gen_dict == null
    print("FAIL kat6: gentime decode returned null")
    exit(1)
if rt_gen_next != 17
    print("FAIL kat6: gentime next_pos != 17, got " + str(rt_gen_next))
    exit(1)
if rt_gen_dict["tag"] != 24
    print("FAIL kat6: decoded tag != 24, got " + str(rt_gen_dict["tag"]))
    exit(1)
if rt_gen_dict["year"] != 2024
    print("FAIL kat6: gentime decoded year != 2024, got " + str(rt_gen_dict["year"]))
    exit(1)
if rt_gen_dict["month"] != 3
    print("FAIL kat6: gentime decoded month != 3, got " + str(rt_gen_dict["month"]))
    exit(1)
if rt_gen_dict["day"] != 9
    print("FAIL kat6: gentime decoded day != 9, got " + str(rt_gen_dict["day"]))
    exit(1)
if rt_gen_dict["hour"] != 12
    print("FAIL kat6: gentime decoded hour != 12, got " + str(rt_gen_dict["hour"]))
    exit(1)
if rt_gen_dict["min"] != 34
    print("FAIL kat6: gentime decoded min != 34, got " + str(rt_gen_dict["min"]))
    exit(1)
if rt_gen_dict["sec"] != 56
    print("FAIL kat6: gentime decoded sec != 56, got " + str(rt_gen_dict["sec"]))
    exit(1)
print("PASS kat6: gentime round-trip y=2024 mo=3 d=9 h=12 mi=34 s=56")

// ── KAT 7: 50-cutoff rule — YY=49 -> year 2049 ───────────────────────────
let utc49 = asn1_utctime_encode(2049, 1, 1, 0, 0, 0)
let dec49 = asn1_time_decode(utc49, 0)
let d49 = dec49[0]
if d49 == null
    print("FAIL kat7: YY=49 decode returned null")
    exit(1)
if d49["year"] != 2049
    print("FAIL kat7: YY=49 expected 2049, got " + str(d49["year"]))
    exit(1)
print("PASS kat7: 50-cutoff YY=49 -> year 2049")

// ── KAT 8: 50-cutoff rule — YY=50 -> year 1950 ───────────────────────────
let utc50 = asn1_utctime_encode(1950, 6, 15, 8, 0, 0)
let dec50 = asn1_time_decode(utc50, 0)
let d50 = dec50[0]
if d50 == null
    print("FAIL kat8: YY=50 decode returned null")
    exit(1)
if d50["year"] != 1950
    print("FAIL kat8: YY=50 expected 1950, got " + str(d50["year"]))
    exit(1)
print("PASS kat8: 50-cutoff YY=50 -> year 1950")

// ── KAT 9: 50-cutoff rule — YY=99 -> year 1999 ───────────────────────────
let utc99 = asn1_utctime_encode(1999, 12, 31, 23, 59, 59)
let dec99 = asn1_time_decode(utc99, 0)
let d99 = dec99[0]
if d99 == null
    print("FAIL kat9: YY=99 decode returned null")
    exit(1)
if d99["year"] != 1999
    print("FAIL kat9: YY=99 expected 1999, got " + str(d99["year"]))
    exit(1)
print("PASS kat9: 50-cutoff YY=99 -> year 1999")

// ── KAT 10: 50-cutoff rule — YY=00 -> year 2000 ──────────────────────────
let utc00 = asn1_utctime_encode(2000, 1, 1, 0, 0, 0)
let dec00 = asn1_time_decode(utc00, 0)
let d00 = dec00[0]
if d00 == null
    print("FAIL kat10: YY=00 decode returned null")
    exit(1)
if d00["year"] != 2000
    print("FAIL kat10: YY=00 expected 2000, got " + str(d00["year"]))
    exit(1)
print("PASS kat10: 50-cutoff YY=00 -> year 2000")

// ── KAT 11: Malformed — wrong tag (0x02) -> [null, 0] ────────────────────
let bad_tag = bytes(3)
bytes_set(bad_tag, 0, 2)
bytes_set(bad_tag, 1, 13)
bytes_set(bad_tag, 2, 48)
let dec_bad = asn1_time_decode(bad_tag, 0)
if dec_bad[0] != null
    print("FAIL kat11: wrong tag should return null")
    exit(1)
if dec_bad[1] != 0
    print("FAIL kat11: wrong tag should return stall pos=0, got " + str(dec_bad[1]))
    exit(1)
print("PASS kat11: wrong tag -> [null, 0]")

// ── KAT 12: Malformed — truncated buffer -> [null, 0] ─────────────────────
let too_short = bytes(5)
bytes_set(too_short, 0, 23)
bytes_set(too_short, 1, 13)
bytes_set(too_short, 2, 50)
bytes_set(too_short, 3, 52)
bytes_set(too_short, 4, 48)
let dec_short = asn1_time_decode(too_short, 0)
if dec_short[0] != null
    print("FAIL kat12: truncated buffer should return null")
    exit(1)
if dec_short[1] != 0
    print("FAIL kat12: truncated buffer should stall at pos=0, got " + str(dec_short[1]))
    exit(1)
print("PASS kat12: truncated buffer -> [null, 0]")

// ── KAT 13: Malformed — missing Z terminator -> [null, 0] ────────────────
// Build a 15-byte buffer where tag=0x17, len=13, content ends in 'X' (not Z)
let no_z = bytes(15)
bytes_set(no_z, 0, 23)
bytes_set(no_z, 1, 13)
bytes_set(no_z, 2, 50)
bytes_set(no_z, 3, 52)
bytes_set(no_z, 4, 48)
bytes_set(no_z, 5, 51)
bytes_set(no_z, 6, 48)
bytes_set(no_z, 7, 57)
bytes_set(no_z, 8, 49)
bytes_set(no_z, 9, 50)
bytes_set(no_z, 10, 51)
bytes_set(no_z, 11, 52)
bytes_set(no_z, 12, 53)
bytes_set(no_z, 13, 54)
bytes_set(no_z, 14, 88)
let dec_noz = asn1_time_decode(no_z, 0)
if dec_noz[0] != null
    print("FAIL kat13: missing Z should return null")
    exit(1)
print("PASS kat13: non-Z terminator -> null (rejected)")

// ── KAT 14: GeneralizedTime with year 1970 (epoch) ───────────────────────
let gen70 = asn1_gentime_encode(1970, 1, 1, 0, 0, 0)
let dec70 = asn1_time_decode(gen70, 0)
let d70 = dec70[0]
if d70 == null
    print("FAIL kat14: 1970 gentime decode returned null")
    exit(1)
if d70["year"] != 1970
    print("FAIL kat14: expected year=1970, got " + str(d70["year"]))
    exit(1)
if d70["month"] != 1
    print("FAIL kat14: expected month=1, got " + str(d70["month"]))
    exit(1)
if d70["day"] != 1
    print("FAIL kat14: expected day=1, got " + str(d70["day"]))
    exit(1)
print("PASS kat14: gentime year=1970 round-trip")

// ── KAT 15: decode at non-zero offset ─────────────────────────────────────
// Prepend 5 garbage bytes before a valid UTCTime TLV
let prefix_len = 5
let utc_raw = asn1_utctime_encode(2024, 3, 9, 12, 34, 56)
let with_prefix = bytes(prefix_len)
let full_buf = bytes_concat(with_prefix, utc_raw)
let dec_off = asn1_time_decode(full_buf, prefix_len)
let d_off = dec_off[0]
let next_off = dec_off[1]
if d_off == null
    print("FAIL kat15: offset decode returned null")
    exit(1)
if next_off != prefix_len + 15
    print("FAIL kat15: offset next_pos != " + str(prefix_len + 15) + ", got " + str(next_off))
    exit(1)
if d_off["year"] != 2024
    print("FAIL kat15: offset decode year != 2024")
    exit(1)
print("PASS kat15: decode at non-zero offset")

print("PASS _asn1_time_test")
