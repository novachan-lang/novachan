// NOVA way (not Rust/Python): structs render AUTOMATICALLY — zero @derive, zero .show().
// The genius compiler derives a value's textual form from its STRUCTURE (innovation D1).
// str(p)/print(p) "just work"; nested structs render recursively. No annotation anywhere.
// (Brace literals in expected strings are escaped \{ \} because { is interpolation in NOVA.)

type Point
    x: int
    y: float

type Seg
    a: Point
    b: Point
    name: string

fn main()
    let p = Point { x: 3, y: 2.5 }
    // automatic: str() of a struct renders its structure, no annotation, no .show()
    assert_eq(str(p), "Point \{ x: 3, y: 2.5 \}")

    let p0 = Point { x: 0, y: 0.0 }
    assert_eq(str(p0), "Point \{ x: 0, y: 0.0 \}")

    // nested structs render recursively through the same derived path
    let s = Seg { a: Point { x: 1, y: 1.0 }, b: Point { x: 2, y: 4.5 }, name: "edge" }
    assert_eq(str(s), "Seg \{ a: Point \{ x: 1, y: 1.0 \}, b: Point \{ x: 2, y: 4.5 \}, name: edge \}")

    // print(p) just works too
    print(p)
    print("auto_show_test passed")
