// Repro for CORE_GAP 0.1: self-assign use-after-free in nova_rt_list_set / nova_rt_dict_set.
// The inner list/dict values are HEAP-allocated at runtime and held ONLY by the container, so their
// refcount is 1. `arr[i]=arr[i]` / `d[k]=d[k]` then does dec-before-inc: the buggy dec frees the
// element, the store writes the freed pointer back, and rc_inc WRITES to freed memory -> deterministic
// heap-use-after-free under ASAN (esp. NOVA_T8_FULLRC). After the fix (inc-before-dec) it is intact.
fn main()
    let arr = [[1, 2, 3, 4, 5]]
    arr[0] = arr[0]
    let d = {}
    d["k"] = [9, 8, 7, 6, 5]
    d["k"] = d["k"]
    // read the possibly-freed elements
    print(len(arr[0]))
    print(len(d["k"]))
    print("survived-self-assign")
