fn bitmap_new()
  0

fn bitmap_set(bm, bit)
  bm | (1 << bit)

fn bitmap_clear(bm, bit)
  if bitmap_test(bm, bit) == 1
    return bm ^ (1 << bit)
  bm

fn bitmap_test(bm, bit)
  (bm >> bit) & 1

fn bitmap_toggle(bm, bit)
  bm ^ (1 << bit)

fn bitmap_count(bm)
  let count = 0
  let v = bm
  while v > 0
    count = count + (v & 1)
    v = v >> 1
  count

fn bitmap_to_list(bm)
  let result = []
  let i = 0
  while i < 62
    if bitmap_test(bm, i) == 1
      push(result, i)
    i = i + 1
  result

fn bitmap_from_list(bits)
  let bm = 0
  for b in bits
    bm = bitmap_set(bm, b)
  bm

fn bitmap_union(a, b)
  a | b

fn bitmap_intersect(a, b)
  a & b

fn main()
  let bm = bitmap_new()
  assert(bm == 0, "new = 0")

  bm = bitmap_set(bm, 0)
  bm = bitmap_set(bm, 3)
  bm = bitmap_set(bm, 7)
  assert(bitmap_test(bm, 0) == 1, "bit 0 set")
  assert(bitmap_test(bm, 3) == 1, "bit 3 set")
  assert(bitmap_test(bm, 7) == 1, "bit 7 set")
  assert(bitmap_test(bm, 1) == 0, "bit 1 not set")

  assert(bitmap_count(bm) == 3, "3 bits set")

  bm = bitmap_clear(bm, 3)
  assert(bitmap_test(bm, 3) == 0, "bit 3 cleared")
  assert(bitmap_count(bm) == 2, "2 bits after clear")

  bm = bitmap_toggle(bm, 5)
  assert(bitmap_test(bm, 5) == 1, "toggle on")
  bm = bitmap_toggle(bm, 5)
  assert(bitmap_test(bm, 5) == 0, "toggle off")

  let bits = bitmap_to_list(bitmap_from_list([1, 4, 9]))
  assert(len(bits) == 3, "from/to list")
  assert(bits[0] == 1, "bit 1")
  assert(bits[1] == 4, "bit 4")
  assert(bits[2] == 9, "bit 9")

  let a = bitmap_from_list([1, 2, 3])
  let b = bitmap_from_list([2, 3, 4])
  let u = bitmap_union(a, b)
  assert(bitmap_count(u) == 4, "union 4 bits")
  let inter = bitmap_intersect(a, b)
  assert(bitmap_count(inter) == 2, "intersect 2 bits")

  print("bitmapx: all passed")
