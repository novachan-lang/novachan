// KAT test for std/data/geo_convert
import std/data/geo_convert

// ── Helpers ───────────────────────────────────────────────────────────────────

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + got + " expected=" + expected)
        exit(1)

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

fn approx(a, b, tol) -> int
    let diff = a - b
    let adiff = diff
    if diff < 0.0
        adiff = 0.0 - diff
    let ok = 1
    if adiff > tol
        ok = 0
    ok

fn ckf(label, got, expected, tol)
    let ok = approx(got, expected, tol)
    if ok == 0
        print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

// ── wkt_to_geojson_type ───────────────────────────────────────────────────────

cks("wkt2gj_point",   wkt_to_geojson_type("POINT"),      "Point")
cks("wkt2gj_ls",      wkt_to_geojson_type("LINESTRING"), "LineString")
cks("wkt2gj_poly",    wkt_to_geojson_type("POLYGON"),    "Polygon")
cks("wkt2gj_mpoint",  wkt_to_geojson_type("MULTIPOINT"), "MultiPoint")
cks("wkt2gj_unknown", wkt_to_geojson_type("CURVE"),      "CURVE")

// ── geojson_to_wkt_type ───────────────────────────────────────────────────────

cks("gj2wkt_point",   geojson_to_wkt_type("Point"),      "POINT")
cks("gj2wkt_ls",      geojson_to_wkt_type("LineString"), "LINESTRING")
cks("gj2wkt_poly",    geojson_to_wkt_type("Polygon"),    "POLYGON")
cks("gj2wkt_mp",      geojson_to_wkt_type("MultiPolygon"), "MULTIPOLYGON")
cks("gj2wkt_unknown", geojson_to_wkt_type("Curve"),      "Curve")

// ── Round-trip type names ─────────────────────────────────────────────────────

cks("rt_point", wkt_to_geojson_type(geojson_to_wkt_type("Point")), "Point")
cks("rt_ls", wkt_to_geojson_type(geojson_to_wkt_type("LineString")), "LineString")
cks("rt_poly", wkt_to_geojson_type(geojson_to_wkt_type("Polygon")), "Polygon")

// ── point_wkt_to_coords ───────────────────────────────────────────────────────

// Basic: "POINT(1 2)"
let c1 = point_wkt_to_coords("POINT(1 2)")
cki("pt_len_1", len(c1), 2)
let c1_lon = c1[0]
let c1_lat = c1[1]
ckf("pt_lon_1", c1_lon, 1.0, 0.0001)
ckf("pt_lat_1", c1_lat, 2.0, 0.0001)

// With space before paren: "POINT (3 4)"
let c2 = point_wkt_to_coords("POINT (3 4)")
cki("pt_len_2", len(c2), 2)
let c2_lon = c2[0]
let c2_lat = c2[1]
ckf("pt_lon_2", c2_lon, 3.0, 0.0001)
ckf("pt_lat_2", c2_lat, 4.0, 0.0001)

// Negative and decimal: "POINT(-122.4194 37.7749)"
let c3 = point_wkt_to_coords("POINT(-122.4194 37.7749)")
cki("pt_len_3", len(c3), 2)
let c3_lon = c3[0]
let c3_lat = c3[1]
ckf("pt_lon_3", c3_lon, -122.4194, 0.001)
ckf("pt_lat_3", c3_lat, 37.7749, 0.001)

// Zero coordinates: "POINT(0 0)"
let c4 = point_wkt_to_coords("POINT(0 0)")
cki("pt_len_4", len(c4), 2)
let c4_lon = c4[0]
let c4_lat = c4[1]
ckf("pt_lon_4", c4_lon, 0.0, 0.0001)
ckf("pt_lat_4", c4_lat, 0.0, 0.0001)

// Bad input: returns empty list
let c5 = point_wkt_to_coords("NOTAPOINT")
cki("pt_len_bad", len(c5), 0)

print("PASS _geo_convert_test")
