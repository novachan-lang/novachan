// _code39_test.nova — KAT for std/barcode/code39
//
// Code 39 (ISO/IEC 16388) known-answer tests:
//   - character validity
//   - numeric values (mod-43 positions)
//   - check character computation
//   - encoding structure: star wrapping, pattern length, determinism

import std/barcode/code39

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    if got != want
        let gs = "false"
        let ws = "false"
        if got
            gs = "true"
        if want
            ws = "true"
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn main()
    // ── KAT 1: valid chars (uppercase letters, digits, specials) ──────────────
    ckb("valid_A",     code39_valid_char("A"), true)
    ckb("valid_Z",     code39_valid_char("Z"), true)
    ckb("valid_0",     code39_valid_char("0"), true)
    ckb("valid_9",     code39_valid_char("9"), true)
    ckb("valid_dash",  code39_valid_char("-"), true)
    ckb("valid_dot",   code39_valid_char("."), true)
    ckb("valid_space", code39_valid_char(" "), true)
    ckb("valid_dollar",code39_valid_char("$"), true)
    ckb("valid_slash", code39_valid_char("/"), true)
    ckb("valid_plus",  code39_valid_char("+"), true)
    ckb("valid_pct",   code39_valid_char("%"), true)

    // ── KAT 2: invalid chars (lowercase, control chars, star) ─────────────────
    ckb("invalid_a",   code39_valid_char("a"), false)
    ckb("invalid_z",   code39_valid_char("z"), false)
    ckb("invalid_star",code39_valid_char("*"), false)
    ckb("invalid_bang",code39_valid_char("!"), false)
    ckb("invalid_at",  code39_valid_char("@"), false)

    // ── KAT 3: character values (position in 43-char alphabet) ────────────────
    // 0-9 at indices 0..9
    cki("val_0", code39_charvalue("0"), 0)
    cki("val_9", code39_charvalue("9"), 9)
    // A-Z at indices 10..35
    cki("val_A", code39_charvalue("A"), 10)
    cki("val_Z", code39_charvalue("Z"), 35)
    cki("val_M", code39_charvalue("M"), 22)
    // specials
    cki("val_dash",   code39_charvalue("-"), 36)
    cki("val_dot",    code39_charvalue("."), 37)
    cki("val_space",  code39_charvalue(" "), 38)
    cki("val_dollar", code39_charvalue("$"), 39)
    cki("val_slash",  code39_charvalue("/"), 40)
    cki("val_plus",   code39_charvalue("+"), 41)
    cki("val_pct",    code39_charvalue("%"), 42)
    // invalid returns -1
    cki("val_invalid_a", code39_charvalue("a"), -1)

    // ── KAT 4: check digit for "CODE39" ───────────────────────────────────────
    // C=12, O=24, D=13, E=14, 3=3, 9=9  => sum=75 => 75 mod 43 = 32 => 'W'
    let chk = code39_checkchar("CODE39")
    cks("checkchar_CODE39", chk, "W")

    // ── KAT 5: check digit is always in the 43-char set ──────────────────────
    ckb("checkchar_valid", code39_valid_char(chk), true)

    // ── KAT 6: single-char check digit ────────────────────────────────────────
    let chklen = len(chk)
    cki("checkchar_len", chklen, 1)

    // ── KAT 7: check digit for "A" = value 10 => 10 mod 43 = 10 => 'A' ───────
    cks("checkchar_A", code39_checkchar("A"), "A")

    // ── KAT 8: check digit for "0" = value 0 => 0 mod 43 = 0 => '0' ─────────
    cks("checkchar_0", code39_checkchar("0"), "0")

    // ── KAT 9: encoding contains start (*) at beginning ───────────────────────
    // * pattern = "010010100" (9 chars), then gap "0", then char pattern, gap, * stop
    let enc_A = code39_encode("A")
    // Start = "010010100" (9) + gap "0" (1) = 10 chars at position 0..9
    let start_pat = slice(enc_A, 0, 9)
    cks("encode_A_startpat", start_pat, "010010100")

    // ── KAT 10: encoding contains stop (*) at end ─────────────────────────────
    let enc_A_len = len(enc_A)
    // structure: star(9) + gap(1) + A_pat(9) + gap(1) + star(9) = 29 chars
    cki("encode_A_len", enc_A_len, 29)
    let stop_pat = slice(enc_A, enc_A_len - 9, enc_A_len)
    cks("encode_A_stoppat", stop_pat, "010010100")

    // ── KAT 11: A character pattern embedded correctly ────────────────────────
    // A pattern = "100001001" at position 10 in the encoding (after start+gap)
    let a_pat = slice(enc_A, 10, 19)
    cks("encode_A_charpat", a_pat, "100001001")

    // ── KAT 12: encoding length formula ───────────────────────────────────────
    // For n-character text: 9 + 1 + n*(9+1) + 9 = 9+1+10n+9 = 10n+19
    // n=1: 29, n=2: 39, n=3: 49
    let enc_AB = code39_encode("AB")
    cki("encode_AB_len", len(enc_AB), 39)

    let enc_ABC = code39_encode("ABC")
    cki("encode_ABC_len", len(enc_ABC), 49)

    // ── KAT 13: determinism — same input always same output ───────────────────
    cks("determinism", code39_encode("HELLO"), code39_encode("HELLO"))

    // ── KAT 14: digit 0 pattern check ─────────────────────────────────────────
    // "0" pattern = "000110100"
    let enc_0 = code39_encode("0")
    let zero_pat = slice(enc_0, 10, 19)
    cks("encode_0_charpat", zero_pat, "000110100")

    // ── KAT 15: space is a valid encodable character ───────────────────────────
    let enc_sp = code39_encode(" ")
    cki("encode_space_len", len(enc_sp), 29)
    let sp_pat = slice(enc_sp, 10, 19)
    cks("encode_space_charpat", sp_pat, "011000100")

    print("PASS _code39_test")
