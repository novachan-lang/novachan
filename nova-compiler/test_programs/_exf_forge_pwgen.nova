// Restricted to the ORIGINAL pre-raise API (pwgen / pwgen_alnum / pwgen_digits / passphrase) so it
// compiles against 68a937c8 too. Values are CSPRNG-random, so every assertion is on SHAPE and
// ALPHABET MEMBERSHIP -- never on content, which could never be diffed.
import forge_pwgen

fn main()
    for n in [0, 0 - 1, 0 - 3, 1, 2, 8, 32, 128]
        print(str(n) + "|" + str(len(pwgen(n))) + "|" + str(len(pwgen_alnum(n))) + "|" + str(len(pwgen_digits(n))))
    let alnum = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
    let full = alnum + "!@#$%^&*()-_=+[];:,.?"
    let d = pwgen_digits(500)
    print(str(len(d)) + "|" + str(all_match([char_at(d, i) for i in 0..len(d)], (c) => find("0123456789", c) >= 0)))
    let a = pwgen_alnum(500)
    print(str(len(a)) + "|" + str(all_match([char_at(a, i) for i in 0..len(a)], (c) => find(alnum, c) >= 0)))
    // an alnum password must never contain punctuation
    print("alnum_no_punct|" + str(all_match([char_at(a, i) for i in 0..len(a)], (c) => find("!@#$%^&*()-_=+[];:,.?", c) < 0)))
    let p = pwgen(500)
    print(str(len(p)) + "|" + str(all_match([char_at(p, i) for i in 0..len(p)], (c) => find(full, c) >= 0)))
    // no NUL-truncation: a 500-char request must yield exactly 500 chars every time
    print("no_trunc|" + str(len(pwgen(500)) == 500) + "|" + str(len(pwgen_alnum(500)) == 500) + "|" + str(len(pwgen_digits(500)) == 500))

    let w = ["alpha", "bravo", "charlie", "delta"]
    print("[" + str(len(split(passphrase(w, 4, "-"), "-"))) + "]")
    print("[" + str(len(split(passphrase(w, 1, "-"), "-"))) + "]")
    print("[" + str(len(split(passphrase(w, 12, "-"), "-"))) + "]")
    print("[" + str(len(split(passphrase(w, 4, " "), " "))) + "]")
    print("[" + str(len(split(passphrase(w, 4, "::"), "::"))) + "]")
    print("[" + passphrase([], 3, "-") + "]")
    print("[" + passphrase([], 0, "-") + "]")
    print("[" + passphrase(w, 0, "-") + "]")
    print("[" + passphrase(w, 0 - 1, "-") + "]")
    print("[" + str(len(passphrase(["x"], 3, ""))) + "]")
    print("[" + passphrase(["only"], 1, "-") + "]")
    // a single-word list must repeat that word exactly `count` times
    print("[" + passphrase(["z"], 4, ".") + "]")
    // every chosen word must come from the wordlist
    let ph = passphrase(w, 40, "-")
    print("words_from_list|" + str(all_match(split(ph, "-"), (x) => x in w)))
    print("EXERCISE-DONE")
