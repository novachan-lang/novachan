import forge_csv_builder

fn main()
    let c = csv_new()
    c = csv_set_headers(c, "name", "age", "city")
    c = csv_add_row(c, "Alice", "30", "NYC")
    c = csv_add_row(c, "Bob", "25", "LA")
    assert(csv_row_count(c) == 2, "2 rows")

    assert(csv_header(c, 0) == "name", "header 0")
    assert(csv_header(c, 2) == "city", "header 2")

    assert(csv_cell(c, 0, 0) == "Alice", "cell 0,0")
    assert(csv_cell(c, 1, 2) == "LA", "cell 1,2")

    let hdr = csv_render_header(c)
    assert(hdr == "name,age,city", "header rendered")

    let row0 = csv_render_row(c, 0)
    assert(row0 == "Alice,30,NYC", "row 0 rendered")

    let row1 = csv_render_row(c, 1)
    assert(row1 == "Bob,25,LA", "row 1 rendered")

    print("CSV-BUILDER KAT PASS")
