import std/game/win_probability

fn approx(a: float, b: float, tol: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    d < tol

fn assert_approx(label: string, a: float, b: float, tol: float)
    let ok = approx(a, b, tol)
    if not ok
        print("FAIL win_probability " + label + ": got " + str(a) + " want ~" + str(b))
        exit(1)

fn assert_true(label: string, cond: bool)
    if not cond
        print("FAIL win_probability " + label)
        exit(1)

fn main()
    // Equal ratings -> exactly 0.5 win probability
    let wp_equal = win_prob(1500.0, 1500.0)
    assert_approx("equal_ratings_half", wp_equal, 0.5, 0.0001)

    // match_expected_score: 1900 vs 1500 over 10 games
    // win_prob(1900, 1500) = 1/(1+10^((1500-1900)/400)) = 1/(1+10^-1) = 1/1.1 ~= 0.9091
    // expected = 10 * 0.9091 ~= 9.091
    let mes = match_expected_score(1900.0, 1500.0, 10.0)
    assert_approx("match_expected_score_1900v1500_10", mes, 9.091, 0.01)

    // upset_chance: underdog 1500 vs favorite 1900
    // = win_prob(1500, 1900) = 1/(1+10^((1900-1500)/400)) = 1/(1+10^1) = 1/11 ~= 0.0909
    let uc = upset_chance(1900.0, 1500.0)
    assert_true("upset_chance_under_0.1", uc < 0.1)
    assert_approx("upset_chance_value", uc, 0.0909, 0.001)

    // win_prob + upset_chance should sum to 1
    let wp_fav = win_prob(1900.0, 1500.0)
    let wp_und = win_prob(1500.0, 1900.0)
    let total = wp_fav + wp_und
    assert_approx("probabilities_sum_to_1", total, 1.0, 0.0001)

    // Higher-rated player should always have > 0.5 win probability
    let wp_higher = win_prob(1800.0, 1200.0)
    assert_true("higher_rated_favored", wp_higher > 0.5)

    // Lower-rated player should have < 0.5 win probability
    let wp_lower = win_prob(1200.0, 1800.0)
    assert_true("lower_rated_underdog", wp_lower < 0.5)

    // match_expected_score with equal ratings: n/2 expected
    let mes_equal = match_expected_score(1500.0, 1500.0, 10.0)
    assert_approx("equal_expected_5", mes_equal, 5.0, 0.0001)

    // Upset chance for equal = 0.5
    let uc_equal = upset_chance(1500.0, 1500.0)
    assert_approx("upset_equal_half", uc_equal, 0.5, 0.0001)

    // A very large rating gap -> win_prob should approach 1.0
    let wp_dominant = win_prob(2800.0, 1000.0)
    assert_true("dominant_near_1", wp_dominant > 0.99)

    // A very large gap the other way -> win_prob approaches 0.0
    let wp_weak = win_prob(1000.0, 2800.0)
    assert_true("weak_near_0", wp_weak < 0.01)

    print("PASS _win_probability_test")
