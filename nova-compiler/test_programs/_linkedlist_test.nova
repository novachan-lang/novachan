import std/collections/linkedlist

fn cki(label, got, expected)
    if got == expected
        return 0
    print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
    exit(1)

fn cks(label, got, expected)
    if got == expected
        return 0
    print("FAIL " + label + ": got " + got + " expected " + expected)
    exit(1)

fn main()
    // Build the primary list via push_back and push_front
    let l = ll_new()
    ll_push_back(l, 1)
    ll_push_back(l, 2)
    ll_push_front(l, 0)

    // KAT 1: ll_to_list == [0,1,2]
    let lst = ll_to_list(l)
    cki("to_list_len", len(lst), 3)
    cki("to_list_0", lst[0], 0)
    cki("to_list_1", lst[1], 1)
    cki("to_list_2", lst[2], 2)

    // KAT 2: ll_size == 3
    cki("size_3", ll_size(l), 3)

    // KAT 3: ll_pop_front == 0
    let pf = ll_pop_front(l)
    cki("pop_front", pf, 0)

    // KAT 4: ll_pop_back == 2
    let pb = ll_pop_back(l)
    cki("pop_back", pb, 2)

    // KAT 5: ll_to_list == [1] after pops
    let lst2 = ll_to_list(l)
    cki("after_pops_len", len(lst2), 1)
    cki("after_pops_0", lst2[0], 1)
    cki("size_after_pops", ll_size(l), 1)

    // KAT 6: ll_from_list + ll_get
    let fl = ll_from_list([5, 6, 7])
    cki("from_list_size", ll_size(fl), 3)
    cki("from_list_get_0", ll_get(fl, 0), 5)
    cki("from_list_get_1", ll_get(fl, 1), 6)
    cki("from_list_get_2", ll_get(fl, 2), 7)

    // KAT 7: ll_get out-of-range returns null
    let oob = ll_get(fl, 5)
    if oob != null
        print("FAIL get_oob: expected null")
        exit(1)

    // KAT 8: ll_reverse of [1,2,3] -> [3,2,1]
    let rl = ll_from_list([1, 2, 3])
    ll_reverse(rl)
    let rlst = ll_to_list(rl)
    cki("reverse_len", len(rlst), 3)
    cki("reverse_0", rlst[0], 3)
    cki("reverse_1", rlst[1], 2)
    cki("reverse_2", rlst[2], 1)

    // KAT 9: pop from single-element list leaves empty
    let sl = ll_new()
    ll_push_back(sl, 42)
    let sv = ll_pop_front(sl)
    cki("single_pop_val", sv, 42)
    cki("single_pop_size", ll_size(sl), 0)
    let slst = ll_to_list(sl)
    cki("single_pop_empty", len(slst), 0)

    // KAT 10: ll_reverse of single element is identity
    let sl2 = ll_from_list([99])
    ll_reverse(sl2)
    let slst2 = ll_to_list(sl2)
    cki("rev_single_len", len(slst2), 1)
    cki("rev_single_val", slst2[0], 99)

    // KAT 11: push_front builds in correct order
    let pfl = ll_new()
    ll_push_front(pfl, 3)
    ll_push_front(pfl, 2)
    ll_push_front(pfl, 1)
    let pflst = ll_to_list(pfl)
    cki("push_front_0", pflst[0], 1)
    cki("push_front_1", pflst[1], 2)
    cki("push_front_2", pflst[2], 3)

    // KAT 12: pop_back from empty returns null
    let el = ll_new()
    let ev = ll_pop_back(el)
    if ev != null
        print("FAIL pop_back_empty: expected null")
        exit(1)

    print("_linkedlist_test passed")
