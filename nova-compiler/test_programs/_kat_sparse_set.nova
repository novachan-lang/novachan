import forge_sparse_set

fn main()
    let s = ss_new(100)
    assert(ss_count(s) == 0, "empty")

    s = ss_add(s, 10)
    s = ss_add(s, 50)
    s = ss_add(s, 30)
    assert(ss_count(s) == 3, "3 items")
    assert(ss_contains(s, 10) == 1, "has 10")
    assert(ss_contains(s, 50) == 1, "has 50")
    assert(ss_contains(s, 99) == 0, "no 99")

    s = ss_add(s, 10)
    assert(ss_count(s) == 3, "no dup")

    s = ss_remove(s, 50)
    assert(ss_count(s) == 2, "2 after remove")
    assert(ss_contains(s, 50) == 0, "50 gone")
    assert(ss_contains(s, 10) == 1, "10 still there")
    assert(ss_contains(s, 30) == 1, "30 still there")

    s = ss_add(s, 200)
    assert(ss_count(s) == 2, "200 out of range")

    s = ss_clear(s)
    assert(ss_count(s) == 0, "cleared")

    print("SPARSE-SET KAT PASS")
