import forge_canary_deploy

fn main()
    let c = cd_new(10)
    c = cd_start(c, "v1.0", "v1.1")
    assert(cd_status(c) == "active", "active")

    let r1 = cd_route(c, 5)
    c = r1["c"]
    assert(r1["is_canary"] == 1, "canary route")
    assert(r1["version"] == "v1.1", "canary version")

    let r2 = cd_route(c, 50)
    c = r2["c"]
    assert(r2["is_canary"] == 0, "stable route")
    assert(r2["version"] == "v1.0", "stable version")

    c = cd_record_error(c, 1)
    assert(cd_canary_error_rate(c) == 100, "100% canary err")

    c = cd_rollback(c)
    assert(cd_status(c) == "rolled_back", "rolled back")

    let c2 = cd_new(20)
    c2 = cd_start(c2, "v2.0", "v2.1")
    let r3 = cd_route(c2, 10)
    c2 = r3["c"]
    c2 = cd_promote(c2)
    assert(cd_status(c2) == "promoted", "promoted")

    print("CANARY-DEPLOY KAT PASS")
