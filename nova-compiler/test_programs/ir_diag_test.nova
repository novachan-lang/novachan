// Diagnostic test: exercises patterns from the full compiler
type Token
    kind: string
    value: string
    line: int
    col: int

fn is_alpha(ch: string) -> bool
    let c = ord(ch)
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or ch == "_"

fn is_digit(ch: string) -> bool
    let c = ord(ch)
    c >= 48 and c <= 57

fn is_alnum(ch: string) -> bool
    is_alpha(ch) or is_digit(ch)

fn is_ws(ch: string) -> bool
    ch == " " or ch == "\t" or ch == "\r"

fn is_keyword(word: string) -> bool
    word == "let" or word == "if" or word == "else" or word == "fn" or word == "while" or word == "for" or word == "return" or word == "match" or word == "type" or word == "true" or word == "false" or word == "and" or word == "or" or word == "not" or word == "in" or word == "break" or word == "continue" or word == "import" or word == "as" or word == "from"

fn tokenize(source: string) -> list
    let tokens = []
    let pos = 0
    let line = 1
    let col = 1
    let length = len(source)
    while pos < length
        let ch = source[pos]
        if ch == "\n"
            push(tokens, Token("NEWLINE", "\\n", line, col))
            line = line + 1
            col = 1
            pos = pos + 1
        else if is_ws(ch)
            while pos < length and is_ws(source[pos])
                pos = pos + 1
                col = col + 1
        else if is_alpha(ch)
            let start_col = col
            let word = ""
            while pos < length and is_alnum(source[pos])
                word = word + source[pos]
                pos = pos + 1
                col = col + 1
            if is_keyword(word)
                push(tokens, Token("KW", word, line, start_col))
            else
                push(tokens, Token("IDENT", word, line, start_col))
        else if is_digit(ch)
            let start_col = col
            let num = ""
            while pos < length and is_digit(source[pos])
                num = num + source[pos]
                pos = pos + 1
                col = col + 1
            push(tokens, Token("INT", num, line, start_col))
        else if ch == "="
            push(tokens, Token("ASSIGN", "=", line, col))
            pos = pos + 1
            col = col + 1
        else if ch == "+"
            push(tokens, Token("OP", "+", line, col))
            pos = pos + 1
            col = col + 1
        else
            pos = pos + 1
            col = col + 1
    push(tokens, Token("EOF", "", line, col))
    return tokens

print("Starting diagnostic...")
let tokens = tokenize("let x = 42 + 3")
print("Tokenized: " + str(len(tokens)) + " tokens")
let non_nl = []
for t in tokens
    match t
        Token(kind, value, line, col) =>
            if kind != "NEWLINE" and kind != "EOF"
                push(non_nl, t)
            print(kind + ":" + value)
print("Non-NL count: " + str(len(non_nl)))
if len(non_nl) == 6
    print("PASS")
else
    print("FAIL: expected 6, got " + str(len(non_nl)))
