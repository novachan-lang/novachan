import forge_projection_builder

fn main()
    let p = proj_new("user-view")
    assert(proj_name(p) == "user-view", "name")
    assert(proj_size(p) == 0, "empty")
    assert(proj_processed(p) == 0, "0 processed")

    p = proj_apply(p, "set", "name", "alice", 1)
    p = proj_apply(p, "set", "email", "alice@test.com", 2)
    assert(proj_size(p) == 2, "2 keys")
    assert(proj_get(p, "name") == "alice", "name = alice")
    assert(proj_get(p, "email") == "alice@test.com", "email")
    assert(proj_processed(p) == 2, "2 processed")
    assert(proj_last_version(p) == 2, "last version 2")

    p = proj_apply(p, "set", "name", "alice-v2", 3)
    assert(proj_get(p, "name") == "alice-v2", "updated name")

    p = proj_apply(p, "set", "name", "stale", 1)
    assert(proj_get(p, "name") == "alice-v2", "stale event ignored")
    assert(proj_processed(p) == 3, "still 3 processed")

    p = proj_apply(p, "delete", "email", "", 4)
    assert(proj_has(p, "email") == 0, "email deleted")
    assert(proj_size(p) == 1, "1 key after delete")

    p = proj_apply(p, "unknown", "x", "y", 5)
    assert(proj_error_count(p) == 1, "1 error for unknown type")

    assert(proj_get(p, "missing") == "", "missing key empty")

    print("PROJECTION-BUILDER KAT PASS")
