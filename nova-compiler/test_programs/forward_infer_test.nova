// Test that type inference propagates across forward function calls.
// get_message is defined before make_greeting, but calls it.
// The string return type of make_greeting should propagate back.

fn get_greeting()
    return make_greeting("world")

fn make_greeting(name)
    return "hello " + name

fn get_number()
    return compute(10)

fn compute(x)
    return x * 2

fn main()
    let g = get_greeting()
    assert(g == "hello world", "greeting")
    let n = get_number()
    assert(n == 20, "number")
    print("forward_infer: all passed")
