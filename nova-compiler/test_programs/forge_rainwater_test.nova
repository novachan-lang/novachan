import forge_rainwater

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

// brute-force trapped water: sum over i of min(maxLeft,maxRight) - h[i]
fn brute(h: list) -> int
    let n = len(h)
    let w = 0
    let i = 0
    while i < n
        let lm = 0
        let l = 0
        while l <= i
            if h[l] > lm
                lm = h[l]
            l = l + 1
        let rm = 0
        let r = i
        while r < n
            if h[r] > rm
                rm = h[r]
            r = r + 1
        let level = lm
        if rm < level
            level = rm
        w = w + (level - h[i])
        i = i + 1
    w

fn main()
    let fails = 0

    // classic examples
    fails = fails + expect("classic", str(trapping_water([0, 1, 0, 2, 1, 0, 1, 3, 2, 1, 2, 1])), "6")
    fails = fails + expect("ex2", str(trapping_water([4, 2, 0, 3, 2, 5])), "9")
    fails = fails + expect("ex3", str(trapping_water([3, 0, 2, 0, 4])), "7")
    fails = fails + expect("mono_up", str(trapping_water([1, 2, 3, 4])), "0")
    fails = fails + expect("mono_down", str(trapping_water([4, 3, 2, 1])), "0")
    fails = fails + expect("flat", str(trapping_water([2, 2, 2])), "0")
    fails = fails + expect("small", str(trapping_water([5, 1])), "0")
    fails = fails + expect("empty", str(trapping_water([])), "0")

    // brute-force cross-check on several profiles
    let ok = 1
    let profiles = []
    push(profiles, [5, 4, 1, 2, 3, 4, 5])
    push(profiles, [0, 3, 0, 1, 0, 5, 0, 2])
    push(profiles, [2, 0, 2])
    push(profiles, [4, 2, 3])
    push(profiles, [1, 3, 2, 4, 1, 3, 1, 4, 5, 2, 3])
    let t = 0
    while t < len(profiles)
        if trapping_water(profiles[t]) != brute(profiles[t])
            ok = 0
        t = t + 1
    fails = fails + expect("brute_cross", str(ok), "1")

    // container with most water
    fails = fails + expect("container", str(max_container_area([1, 8, 6, 2, 5, 4, 8, 3, 7])), "49")
    fails = fails + expect("container2", str(max_container_area([1, 1])), "1")
    fails = fails + expect("container3", str(max_container_area([4, 3, 2, 1, 4])), "16")

    if fails == 0
        print("forge_rainwater: all passed")
    else
        print("forge_rainwater: " + str(fails) + " FAILED")
