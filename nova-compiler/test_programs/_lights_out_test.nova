import std/game/lights_out

fn chk_int(name: string, got: int, want: int)
    if got != want
        print("FAIL lights_out " + name + ": got " + str(got) + " want " + str(want))
        exit(1)

fn chk_bool(name: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL lights_out " + name + ": got " + gs + " want " + ws)
        exit(1)

// all_off — check that every cell in board is 0
fn all_off(board: list) -> bool
    let n = len(board)
    let i = 0
    let ok = true
    while i < n
        if board[i] != 0
            ok = false
        i = i + 1
    ok

fn main()
    // --- all-off board: solution should be all zeros (no presses needed) ---
    let off3 = []
    let i = 0
    while i < 9
        push(off3, 0)
        i = i + 1
    let sol_off = lights_out_solve(off3, 3)
    chk_int("all_off sol len", len(sol_off), 9)
    let ao = 0
    while ao < 9
        chk_int("all_off sol[" + str(ao) + "]", sol_off[ao], 0)
        ao = ao + 1
    // applying zero presses leaves it off
    let res_off = lights_out_apply(off3, 3, sol_off)
    chk_bool("all_off result", all_off(res_off), true)

    // --- all-on 3x3 board: a known solvable configuration ---
    // For the 3x3 all-on puzzle, the solution is known:
    // press center (cell 4) only gives: 4 toggles cells 1,3,4,5,7 => not all off
    // Use solve+apply and check result is all zeros.
    let on3 = []
    let j = 0
    while j < 9
        push(on3, 1)
        j = j + 1
    let sol_on = lights_out_solve(on3, 3)
    chk_int("all_on sol len", len(sol_on), 9)
    let res_on = lights_out_apply(on3, 3, sol_on)
    chk_bool("all_on solved", all_off(res_on), true)

    // --- single-cell boards ---
    // 1x1 all-on: press cell 0 (toggles only itself)
    let on1 = []
    push(on1, 1)
    let sol1 = lights_out_solve(on1, 1)
    chk_int("1x1_on sol[0]", sol1[0], 1)
    let res1 = lights_out_apply(on1, 1, sol1)
    chk_bool("1x1_on solved", all_off(res1), true)

    // 1x1 all-off: solution is press nothing
    let off1 = []
    push(off1, 0)
    let sol1off = lights_out_solve(off1, 1)
    chk_int("1x1_off sol[0]", sol1off[0], 0)

    // --- 2x2 all-on ---
    let on2 = []
    let k = 0
    while k < 4
        push(on2, 1)
        k = k + 1
    let sol2 = lights_out_solve(on2, 2)
    chk_int("2x2_on sol len", len(sol2), 4)
    let res2 = lights_out_apply(on2, 2, sol2)
    chk_bool("2x2_on solved", all_off(res2), true)

    // --- specific solvable 3x3: press cell 0 on empty board, then solve back ---
    // Start with all-off, press cell 0: toggles cells 0,1,3 => board=[1,1,0,1,0,0,0,0,0]
    let base = []
    let bi = 0
    while bi < 9
        push(base, 0)
        bi = bi + 1
    let press0 = []
    let pi = 0
    while pi < 9
        push(press0, 0)
        pi = pi + 1
    press0[0] = 1
    let created = lights_out_apply(base, 3, press0)
    chk_int("setup[0]", created[0], 1)
    chk_int("setup[1]", created[1], 1)
    chk_int("setup[3]", created[3], 1)
    chk_int("setup[4]", created[4], 0)
    // solve it back
    let sol_created = lights_out_solve(created, 3)
    let res_created = lights_out_apply(created, 3, sol_created)
    chk_bool("press0 solved", all_off(res_created), true)

    // --- 5x5 all-on board (the classic Lights Out puzzle) ---
    let on5 = []
    let m = 0
    while m < 25
        push(on5, 1)
        m = m + 1
    let sol5 = lights_out_solve(on5, 5)
    chk_int("5x5_on sol len", len(sol5), 25)
    let res5 = lights_out_apply(on5, 5, sol5)
    chk_bool("5x5_on solved", all_off(res5), true)

    // --- lights_out_apply correctness: press cell 4 (center) on all-off 3x3 ---
    // Toggles cells 1 (up), 3 (left), 4 (self), 5 (right), 7 (down)
    let pr4 = []
    let qi = 0
    while qi < 9
        push(pr4, 0)
        qi = qi + 1
    pr4[4] = 1
    let r4 = lights_out_apply(off3, 3, pr4)
    chk_int("press4[0]", r4[0], 0)
    chk_int("press4[1]", r4[1], 1)
    chk_int("press4[2]", r4[2], 0)
    chk_int("press4[3]", r4[3], 1)
    chk_int("press4[4]", r4[4], 1)
    chk_int("press4[5]", r4[5], 1)
    chk_int("press4[6]", r4[6], 0)
    chk_int("press4[7]", r4[7], 1)
    chk_int("press4[8]", r4[8], 0)

    print("PASS _lights_out_test")
