fn main()
    let r1 = ok(42)
    if let Ok(val) = r1
        assert_eq(val, 42)
        print("if-let Ok matched: " + str(val))
    else
        print("FAIL: should have matched Ok")

    let r2 = err("bad")
    if let Err(msg) = r2
        assert_eq(msg, "bad")
        print("if-let Err matched: " + msg)
    else
        print("FAIL: should have matched Err")

    if let Ok(v) = r2
        print("FAIL: should not match Ok on Err")
    else
        print("if-let else branch taken correctly")

    let items = [ok(1), err("skip"), ok(3), err("nope"), ok(5)]
    let goods = []
    for item in items
        if let Ok(n) = item
            push(goods, n)
    assert_eq(goods, [1, 3, 5])
    print("for+if-let filter: " + str(goods))

    let stream = [ok(10), ok(20), ok(30)]
    let idx = 0
    let total = 0
    while idx < len(stream)
        let cur = stream[idx]
        if let Ok(v) = cur
            total = total + v
        idx = idx + 1
    assert_eq(total, 60)
    print("while+if-let sum: " + str(total))

    if let Ok(a) = ok(100)
        if let Ok(b) = ok(200)
            assert_eq(a + b, 300)
            print("nested if-let: " + str(a + b))

    print("ALL IF-LET TESTS PASSED")
