// inix.nova — INI / config file parser + writer, the NOVA way.
//
// Practical config support: parse an INI text into {section: {key: value}} and
// serialize it back. Handles [sections], key = value, ; and # comments, blank
// lines, values containing '=', and surrounding whitespace. Keys before any
// section go in the default section "". Pure-NOVA over split/trim/slice/join.

// split a "key = value" line at the FIRST '=' -> [key, value] (value keeps any '=').
fn _ini_kv(line)
  let parts = split(line, "=")
  if len(parts) < 2
    return ["", ""]
  let key = trim(parts[0])
  let rest = []
  let i = 1
  while i < len(parts)
    push(rest, parts[i])
    i = i + 1
  let val = trim(join(rest, "="))
  [key, val]

fn ini_parse(text)
  let result = {}
  result[""] = {}
  let cur = ""
  let lines = split(text, "\n")
  for raw in lines
    let line = trim(raw)
    if len(line) == 0
      cur = cur
    else if starts_with(line, ";") or starts_with(line, "#")
      cur = cur
    else if starts_with(line, "[")
      // [section]
      let name = trim(slice(line, 1, len(line) - 1))
      cur = name
      if not contains(result, cur)
        result[cur] = {}
    else
      let kv = _ini_kv(line)
      if len(kv[0]) > 0
        let sect = result[cur]
        sect[kv[0]] = kv[1]
  result

// get a value from a section (or "" default), with a fallback.
fn ini_get(cfg, section, key, fallback)
  if not contains(cfg, section)
    return fallback
  let sect = cfg[section]
  if contains(sect, key)
    return sect[key]
  fallback

fn ini_has(cfg, section, key)
  if not contains(cfg, section)
    return 0
  let sect = cfg[section]
  if contains(sect, key)
    return 1
  0

// serialize back to INI text. The default section "" is written first, sectionless.
fn ini_write(cfg)
  let out = []
  // default section keys first (no header)
  if contains(cfg, "")
    let d = cfg[""]
    for k in keys(d)
      push(out, k + " = " + d[k])
  for section in keys(cfg)
    if len(section) > 0
      push(out, "[" + section + "]")
      let s = cfg[section]
      for k in keys(s)
        push(out, k + " = " + s[k])
  join(out, "\n")

// ── Tests ────────────────────────────────────────────────────────────

let text = "; a comment\nname = nova\n\n[server]\nhost = localhost\nport = 8080\n# inline note\n[db]\nurl = postgres://x=y\n"
let cfg = ini_parse(text)

assert(ini_get(cfg, "", "name", "?") == "nova", "top-level key in default section")
assert(ini_get(cfg, "server", "host", "?") == "localhost", "server.host")
assert(ini_get(cfg, "server", "port", "?") == "8080", "server.port")
assert(ini_get(cfg, "db", "url", "?") == "postgres://x=y", "value with '=' preserved")
print("PASS: parse sections + keys + comments")

assert(ini_get(cfg, "server", "missing", "default") == "default", "fallback for missing key")
assert(ini_get(cfg, "nosuch", "k", "fb") == "fb", "fallback for missing section")
assert(ini_has(cfg, "server", "host") == 1, "has server.host")
assert(ini_has(cfg, "server", "nope") == 0, "no server.nope")
print("PASS: get with fallback + has")

// round-trip: write then re-parse yields the same values
let written = ini_write(cfg)
let cfg2 = ini_parse(written)
assert(ini_get(cfg2, "server", "host", "?") == "localhost", "round-trip server.host")
assert(ini_get(cfg2, "db", "url", "?") == "postgres://x=y", "round-trip value with '='")
assert(ini_get(cfg2, "", "name", "?") == "nova", "round-trip default key")
print("PASS: write -> parse round-trip")

// edge: empty / whitespace-only input
let empty = ini_parse("\n  \n; only a comment\n")
assert(ini_get(empty, "", "x", "none") == "none", "empty config has no keys")
print("PASS: empty input")

print("ALL PASS: inix — INI config parser + writer")
