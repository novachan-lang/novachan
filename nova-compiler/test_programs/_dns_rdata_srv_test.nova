// KAT for std/net/dns_rdata_srv — SRV rdata encode/decode (RFC 2782).
import std/net/dns_rdata_srv

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL dns_rdata_srv " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL dns_rdata_srv " + label + ": got '" + got + "' want '" + want + "'")
        exit(1)

fn main()
    // ── Vector 1: byte-exact encode of dns_srv_encode(10, 20, 5060, "sip.example.com") ──
    //
    // Expected wire layout:
    //   [0] 0x00  [1] 0x0A  -> PRIORITY = 10
    //   [2] 0x00  [3] 0x14  -> WEIGHT   = 20
    //   [4] 0x13  [5] 0xC4  -> PORT     = 5060 (0x13C4)
    //   [6] 0x03             -> label len "sip" (3)
    //   [7..9]  's','i','p'
    //   [10] 0x07            -> label len "example" (7)
    //   [11..17] 'e','x','a','m','p','l','e'
    //   [18] 0x03            -> label len "com" (3)
    //   [19..21] 'c','o','m'
    //   [22] 0x00            -> root terminator
    //   Total = 23 bytes

    let enc = dns_srv_encode(10, 20, 5060, "sip.example.com")

    // Length check
    cki("enc_len", bytes_len(enc), 23)

    // PRIORITY = 10 = 0x000A
    cki("enc_b0_priority_hi", bytes_get(enc, 0), 0)
    cki("enc_b1_priority_lo", bytes_get(enc, 1), 10)

    // WEIGHT = 20 = 0x0014
    cki("enc_b2_weight_hi", bytes_get(enc, 2), 0)
    cki("enc_b3_weight_lo", bytes_get(enc, 3), 20)

    // PORT = 5060 = 0x13C4
    cki("enc_b4_port_hi", bytes_get(enc, 4), 0x13)
    cki("enc_b5_port_lo", bytes_get(enc, 5), 0xC4)

    // TARGET name bytes: "sip" label
    cki("enc_b6_sip_len", bytes_get(enc, 6), 3)
    cki("enc_b7_s",  bytes_get(enc, 7),  115)
    cki("enc_b8_i",  bytes_get(enc, 8),  105)
    cki("enc_b9_p",  bytes_get(enc, 9),  112)

    // "example" label
    cki("enc_b10_example_len", bytes_get(enc, 10), 7)
    cki("enc_b11_e", bytes_get(enc, 11), 101)
    cki("enc_b12_x", bytes_get(enc, 12), 120)
    cki("enc_b13_a", bytes_get(enc, 13), 97)
    cki("enc_b14_m", bytes_get(enc, 14), 109)
    cki("enc_b15_p", bytes_get(enc, 15), 112)
    cki("enc_b16_l", bytes_get(enc, 16), 108)
    cki("enc_b17_e", bytes_get(enc, 17), 101)

    // "com" label
    cki("enc_b18_com_len", bytes_get(enc, 18), 3)
    cki("enc_b19_c", bytes_get(enc, 19), 99)
    cki("enc_b20_o", bytes_get(enc, 20), 111)
    cki("enc_b21_m", bytes_get(enc, 21), 109)

    // Root terminator
    cki("enc_b22_root", bytes_get(enc, 22), 0)

    // ── Vector 2: round-trip decode ──────────────────────────────────────────
    //
    // dns_srv_decode(enc, 0) must return:
    //   [{"priority":10, "weight":20, "port":5060, "target":"sip.example.com"}, 23]

    let dec_result = dns_srv_decode(enc, 0)
    let rec = dec_result[0]
    let next_pos = dec_result[1]

    cki("dec_priority", rec["priority"], 10)
    cki("dec_weight",   rec["weight"],   20)
    cki("dec_port",     rec["port"],     5060)
    cks("dec_target",   rec["target"],   "sip.example.com")
    cki("dec_next_pos", next_pos, 23)

    // ── Vector 3: encode with zero fields / root target ───────────────────────
    //
    // dns_srv_encode(0, 0, 0, "") -> 7 bytes: [0,0, 0,0, 0,0, 0]
    // (6 header bytes + 1 root-only name byte)

    let enc_zero = dns_srv_encode(0, 0, 0, "")
    cki("enc_zero_len", bytes_len(enc_zero), 7)
    cki("enc_zero_b0", bytes_get(enc_zero, 0), 0)
    cki("enc_zero_b5", bytes_get(enc_zero, 5), 0)
    cki("enc_zero_b6_root", bytes_get(enc_zero, 6), 0)

    let dec_zero_result = dns_srv_decode(enc_zero, 0)
    let rec_zero = dec_zero_result[0]
    cki("dec_zero_priority", rec_zero["priority"], 0)
    cki("dec_zero_port",     rec_zero["port"],     0)
    cks("dec_zero_target",   rec_zero["target"],   "")

    // ── Vector 4: max values (65535, 65535, 65535) ────────────────────────────
    //
    // dns_srv_encode(65535, 65535, 65535, "a.b")
    // Bytes 0-5: FF FF FF FF FF FF
    // Then name "a.b" = [1,'a', 1,'b', 0] = 5 bytes
    // Total = 11 bytes

    let enc_max = dns_srv_encode(65535, 65535, 65535, "a.b")
    cki("enc_max_len", bytes_len(enc_max), 11)
    cki("enc_max_b0", bytes_get(enc_max, 0), 0xFF)
    cki("enc_max_b1", bytes_get(enc_max, 1), 0xFF)
    cki("enc_max_b4", bytes_get(enc_max, 4), 0xFF)
    cki("enc_max_b5", bytes_get(enc_max, 5), 0xFF)
    // Name bytes: [1, 97, 1, 98, 0]
    cki("enc_max_b6_a_len", bytes_get(enc_max, 6), 1)
    cki("enc_max_b7_a",     bytes_get(enc_max, 7), 97)
    cki("enc_max_b8_b_len", bytes_get(enc_max, 8), 1)
    cki("enc_max_b9_b",     bytes_get(enc_max, 9), 98)
    cki("enc_max_b10_root", bytes_get(enc_max, 10), 0)

    let dec_max_result = dns_srv_decode(enc_max, 0)
    let rec_max = dec_max_result[0]
    cki("dec_max_priority", rec_max["priority"], 65535)
    cki("dec_max_weight",   rec_max["weight"],   65535)
    cki("dec_max_port",     rec_max["port"],     65535)
    cks("dec_max_target",   rec_max["target"],   "a.b")

    // ── Vector 5: truncated input -> safe zero result ─────────────────────────
    //
    // Only 4 bytes -> can't read priority+weight+port (need 6) -> safe zero dict

    let short_msg = bytes(4)
    let dec_short = dns_srv_decode(short_msg, 0)
    let rec_short = dec_short[0]
    cki("dec_short_priority", rec_short["priority"], 0)
    cki("dec_short_port",     rec_short["port"],     0)
    cks("dec_short_target",   rec_short["target"],   "")

    print("PASS _dns_rdata_srv_test")
