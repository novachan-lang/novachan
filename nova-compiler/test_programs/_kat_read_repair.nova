import forge_read_repair

fn main()
    let rr = rr_new()
    rr = rr_add_store(rr, "east")
    rr = rr_add_store(rr, "west")
    rr = rr_add_store(rr, "central")
    assert(rr_store_count(rr) == 3, "3 stores")

    rr = rr_write(rr, "east", "user:1", "alice", 1)
    rr = rr_write(rr, "west", "user:1", "alice", 1)
    rr = rr_write(rr, "central", "user:1", "alice", 1)

    rr = rr_write(rr, "east", "user:1", "alice-v2", 2)

    let r1 = rr_read(rr, "user:1")
    assert(r1["value"] == "alice-v2", "got latest")
    assert(r1["version"] == 2, "version 2")
    assert(r1["stale_count"] == 2, "2 stale repaired")
    assert(rr_total_repairs(rr) == 2, "2 total repairs")
    assert(rr_total_reads(rr) == 1, "1 read")

    let r2 = rr_read(rr, "user:1")
    assert(r2["stale_count"] == 0, "0 stale after repair")
    assert(rr_total_reads(rr) == 2, "2 reads")

    rr = rr_write(rr, "east", "user:2", "bob", 1)
    let r3 = rr_read(rr, "user:2")
    assert(r3["value"] == "bob", "got bob")
    assert(r3["stale_count"] == 2, "2 stores missing user:2")
    assert(rr_total_repairs(rr) == 4, "4 total repairs")

    let r4 = rr_read(rr, "missing")
    assert(r4["value"] == "", "missing key = empty")
    assert(r4["version"] == 0, "missing version = 0")

    print("READ-REPAIR KAT PASS")
