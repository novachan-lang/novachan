import forge_blossom as bl

fn check(cond: bool, label: str)
    if cond == false
        print("FAIL: " + label)

// Brute-force maximum matching size via recursion over edges (exponential; only for small graphs).
// We iterate: pick the first unmatched vertex with an available edge, branch on matching it or skipping.
fn brute_match(n: int, adj: list, matched: list) -> int
    // find first unmatched vertex
    let v = 0 - 1
    let i = 0
    while i < n and v == 0 - 1
        if matched[i] == 0
            v = i
        i = i + 1
    if v == 0 - 1
        return 0
    // option A: leave v unmatched
    matched[v] = 1
    let best = brute_match(n, adj, matched)
    matched[v] = 0
    // option B: match v with any available neighbor
    let nbrs = adj[v]
    let j = 0
    while j < len(nbrs)
        let w = nbrs[j]
        if matched[w] == 0
            matched[v] = 1
            matched[w] = 1
            let cand = 1 + brute_match(n, adj, matched)
            if cand > best
                best = cand
            matched[v] = 0
            matched[w] = 0
        j = j + 1
    return best

fn build_adj(n: int, edges: list) -> list
    let adj = []
    let i = 0
    while i < n
        push(adj, [])
        i = i + 1
    let e = 0
    while e < len(edges)
        let a = edges[e][0]
        let b = edges[e][1]
        if a != b
            push(adj[a], b)
            push(adj[b], a)
        e = e + 1
    return adj

// Verify a returned match array is a VALID matching (symmetric, edges exist, no vertex reused).
fn is_valid_matching(n: int, edges: list, m: list) -> bool
    let i = 0
    while i < n
        if m[i] != 0 - 1
            // symmetric
            if m[m[i]] != i
                return false
            // edge exists
            let exists = false
            let e = 0
            while e < len(edges)
                let a = edges[e][0]
                let b = edges[e][1]
                if (a == i and b == m[i]) or (a == m[i] and b == i)
                    exists = true
                e = e + 1
            if exists == false
                return false
        i = i + 1
    return true

// TEST 1: triangle (odd cycle) - max matching = 1 (bipartite algorithms would struggle)
let tri = [[0, 1], [1, 2], [2, 0]]
check(bl.blossom_matching_size(3, tri) == 1, "triangle matching = 1")

// TEST 2: 5-cycle (odd) - max matching = 2
let c5 = [[0, 1], [1, 2], [2, 3], [3, 4], [4, 0]]
check(bl.blossom_matching_size(5, c5) == 2, "5-cycle matching = 2")

// TEST 3: single edge
check(bl.blossom_matching_size(2, [[0, 1]]) == 1, "single edge matching = 1")

// TEST 4: no edges
check(bl.blossom_matching_size(4, []) == 0, "no edges matching = 0")

// TEST 5: perfect matching on 4-cycle
let c4 = [[0, 1], [1, 2], [2, 3], [3, 0]]
check(bl.blossom_matching_size(4, c4) == 2, "4-cycle perfect matching = 2")

// TEST 6: the classic "flower" - triangle with a tail (tests blossom contraction + augment through it)
// vertices 0,1,2 form a triangle; 3-0 and 4-3 tails
// 0-1,1-2,2-0,0-3,3-4 -> max matching: {1-2, 0-3? then 4 free} or {0-1,3-4,2 free}=2, or {1-2,0-3,4 free}=2
// actual max = 2 (5 vertices, so at most 2)
let flower = [[0, 1], [1, 2], [2, 0], [0, 3], [3, 4]]
check(bl.blossom_matching_size(5, flower) == 2, "flower (triangle+tail) matching = 2")

// TEST 7: Petersen-like blossom stress: two triangles joined by an edge
// triangle A: 0,1,2 ; triangle B: 3,4,5 ; bridge 2-3
let two_tri = [[0, 1], [1, 2], [2, 0], [3, 4], [4, 5], [5, 3], [2, 3]]
// max matching: each triangle gives 1, bridge can promote to 3 total (0-1, 2-3, 4-5)
check(bl.blossom_matching_size(6, two_tri) == 3, "two triangles + bridge matching = 3")

// TEST 8: matching validity for above
let m7 = bl.blossom_max_matching(6, two_tri)
check(is_valid_matching(6, two_tri, m7), "two-triangle matching is valid")

// TEST 9: DECISIVE brute-force cross-check on many random GENERAL graphs (with odd cycles)
let ok = true
let ok_valid = true
let seed = 246810
let tc = 0
while tc < 60
    seed = (seed * 1103515245 + 12345) % 2147483648
    let n = seed % 7 + 2  // 2..8 vertices
    // random edges (general graph, may have odd cycles)
    let edges = []
    let a = 0
    while a < n
        let b = a + 1
        while b < n
            seed = (seed * 1103515245 + 12345) % 2147483648
            if seed % 100 < 45   // ~45% edge density
                push(edges, [a, b])
            b = b + 1
        a = a + 1
    let adj = build_adj(n, edges)
    // brute max matching
    let matched = []
    let z = 0
    while z < n
        push(matched, 0)
        z = z + 1
    let exp = brute_match(n, adj, matched)
    let got = bl.blossom_matching_size(n, edges)
    if got != exp
        ok = false
        print("SIZE MISMATCH tc=" + str(tc) + " n=" + str(n) + " exp=" + str(exp) + " got=" + str(got))
    // validity
    let m = bl.blossom_max_matching(n, edges)
    if is_valid_matching(n, edges, m) == false
        ok_valid = false
        print("INVALID MATCHING tc=" + str(tc))
    tc = tc + 1
check(ok, "DECISIVE: blossom matching size == brute-force max matching over 60 random general graphs")
check(ok_valid, "DECISIVE: all returned matchings are valid (symmetric, real edges, no reuse)")

print("forge_blossom: KAT done")
