import std/rational/rfrac_mixed

fn ckr(label: string, got: list, wn: int, wd: int)
    if got[0] != wn or got[1] != wd
        print("FAIL rfrac_mixed " + label + ": got=" + str(got[0]) + "/" + str(got[1]) + " want=" + str(wn) + "/" + str(wd))
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL rfrac_mixed " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL rfrac_mixed " + label + ": got=" + got + " want=" + want)
        exit(1)

fn ck_mixed(label: string, got: list, ww: int, wn: int, wd: int)
    if got[0] != ww or got[1] != wn or got[2] != wd
        print("FAIL rfrac_mixed " + label + ": got=[" + str(got[0]) + "," + str(got[1]) + "," + str(got[2]) + "] want=[" + str(ww) + "," + str(wn) + "," + str(wd) + "]")
        exit(1)

fn main()
    // rfm_to_mixed KAT vectors
    ck_mixed("to_mixed([7,4])", rfm_to_mixed([7, 4]), 1, 3, 4)
    ck_mixed("to_mixed([-7,4])", rfm_to_mixed([-7, 4]), -1, 3, 4)
    ck_mixed("to_mixed([3,4])", rfm_to_mixed([3, 4]), 0, 3, 4)
    ck_mixed("to_mixed([8,4])", rfm_to_mixed([8, 4]), 2, 0, 1)
    ck_mixed("to_mixed([0,1])", rfm_to_mixed([0, 1]), 0, 0, 1)
    ck_mixed("to_mixed([5,1])", rfm_to_mixed([5, 1]), 5, 0, 1)
    ck_mixed("to_mixed([-3,4])", rfm_to_mixed([-3, 4]), 0, 3, 4)
    ck_mixed("to_mixed([-8,4])", rfm_to_mixed([-8, 4]), -2, 0, 1)

    // rfm_from_mixed KAT vectors
    ckr("from_mixed(1,3,4)", rfm_from_mixed(1, 3, 4), 7, 4)
    ckr("from_mixed(-1,3,4)", rfm_from_mixed(-1, 3, 4), -7, 4)
    ckr("from_mixed(0,3,4)", rfm_from_mixed(0, 3, 4), 3, 4)
    ckr("from_mixed(2,0,1)", rfm_from_mixed(2, 0, 1), 2, 1)
    ckr("from_mixed(-2,1,2)", rfm_from_mixed(-2, 1, 2), -5, 2)

    // rfm_to_string KAT vectors
    cks("to_string([7,4])", rfm_to_string([7, 4]), "1 3/4")
    cks("to_string([5,1])", rfm_to_string([5, 1]), "5")
    cks("to_string([3,4])", rfm_to_string([3, 4]), "3/4")
    cks("to_string([-7,4])", rfm_to_string([-7, 4]), "-1 3/4")
    cks("to_string([0,1])", rfm_to_string([0, 1]), "0")
    cks("to_string([-3,4])", rfm_to_string([-3, 4]), "-3/4")
    cks("to_string([-4,1])", rfm_to_string([-4, 1]), "-4")

    // rfm_whole_part KAT
    cki("whole_part([7,4])", rfm_whole_part([7, 4]), 1)
    cki("whole_part([-7,4])", rfm_whole_part([-7, 4]), -1)
    cki("whole_part([3,4])", rfm_whole_part([3, 4]), 0)
    cki("whole_part([8,4])", rfm_whole_part([8, 4]), 2)
    cki("whole_part([-8,4])", rfm_whole_part([-8, 4]), -2)

    // rfm_proper_part KAT
    ckr("proper_part([7,4])", rfm_proper_part([7, 4]), 3, 4)
    ckr("proper_part([-7,4])", rfm_proper_part([-7, 4]), -3, 4)
    ckr("proper_part([3,4])", rfm_proper_part([3, 4]), 3, 4)
    ckr("proper_part([8,4])", rfm_proper_part([8, 4]), 0, 1)

    // Round-trip: from_mixed(to_mixed(r)) == r
    let m1 = rfm_to_mixed([7, 4])
    ckr("roundtrip([7,4])", rfm_from_mixed(m1[0], m1[1], m1[2]), 7, 4)
    let m2 = rfm_to_mixed([-7, 4])
    ckr("roundtrip([-7,4])", rfm_from_mixed(m2[0], m2[1], m2[2]), -7, 4)
    let m3 = rfm_to_mixed([3, 4])
    ckr("roundtrip([3,4])", rfm_from_mixed(m3[0], m3[1], m3[2]), 3, 4)

    print("PASS _rfrac_mixed_test")
