// KAT for prism/ui/prism_ui_activity.nova (the `ui/` composition layer's chronological
// event / activity feed: event node, feed, compact feed, grouped, latest-N).
//
// See prism_ui_activity.nova's own header for why this component is named `prism_ui_activity` /
// `prism_ac_*` / `PrismActivityEvent` / `ac_*` rather than the `prism_ui_timeline` /
// `prism_tl_*` / `PrismTimelineEvent` / `tl_*` names originally requested: that file's own name,
// its `prism_tl_timeline` function, and prism_ui_data.nova's `tl_` field prefix were all already
// claimed by the pre-existing, committed MB.15 timeline component.
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova into
// $NOVA_HOME/lib, so `import prism_node` / `import prism_ui_activity` resolve.
//   ./gen3_test.exe _kat_prism_ui_activity.nova
//   clang -O2 -o _kat_prism_ui_activity.exe _kat_prism_ui_activity.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_ui_activity.exe

import prism_ui_activity
import prism_node
import prism_arrange
import prism_content

fn main()
    print("== KAT prism_ui_activity ==")
    let mut passed = 0
    let mut failed = 0

    let e1 = prism_ui_activity.prism_ac_event("10:00", "Deploy started", "v2.3.1 rolling out")
    let e2 = prism_ui_activity.prism_ac_event("10:05", "Deploy finished", "")
    let e3 = prism_ui_activity.prism_ac_event("10:10", "Alert raised", "CPU > 90%")

    // ── Group A: constructor + accessors round-trip ──────────────────────────────────────────
    if prism_ui_activity.prism_ac_event_time(e1) == "10:00"
        print("  ok  ctor_time_e1")
        passed += 1
    else
        print("FAIL ctor_time_e1: got " + prism_ui_activity.prism_ac_event_time(e1))
        failed += 1

    if prism_ui_activity.prism_ac_event_title(e1) == "Deploy started"
        print("  ok  ctor_title_e1")
        passed += 1
    else
        print("FAIL ctor_title_e1: got " + prism_ui_activity.prism_ac_event_title(e1))
        failed += 1

    if prism_ui_activity.prism_ac_event_detail(e1) == "v2.3.1 rolling out"
        print("  ok  ctor_detail_e1")
        passed += 1
    else
        print("FAIL ctor_detail_e1: got " + prism_ui_activity.prism_ac_event_detail(e1))
        failed += 1

    if prism_ui_activity.prism_ac_event_detail(e2) == ""
        print("  ok  ctor_detail_e2_empty")
        passed += 1
    else
        print("FAIL ctor_detail_e2_empty: got " + prism_ui_activity.prism_ac_event_detail(e2))
        failed += 1

    // ── Group B: prism_ac_event_node happy path (e1, non-empty detail) ──────────────────────
    let r_en1 = prism_ui_activity.prism_ac_event_node(e1)
    if is_ok(r_en1)
        print("  ok  event_node_ok")
        passed += 1
        let n = unwrap(r_en1)
        if prism_node.prism_node_kind_str(n) == "band"
            print("  ok  event_node_is_band")
            passed += 1
        else
            print("FAIL event_node_is_band: got " + prism_node.prism_node_kind_str(n))
            failed += 1
        let ch = prism_node.prism_node_children(n)
        if len(ch) == 3
            print("  ok  event_node_3_children")
            passed += 1
        else
            print("FAIL event_node_3_children: got " + str(len(ch)))
            failed += 1
        if prism_node.prism_node_kind_str(ch[0]) == "label" and prism_node.prism_node_attr_str(ch[0], "text", "") == "10:00"
            print("  ok  event_node_time_label")
            passed += 1
        else
            print("FAIL event_node_time_label")
            failed += 1
        if prism_node.prism_node_kind_str(ch[1]) == "gap"
            print("  ok  event_node_middle_is_gap")
            passed += 1
        else
            print("FAIL event_node_middle_is_gap: got " + prism_node.prism_node_kind_str(ch[1]))
            failed += 1
        if not prism_arrange.prism_gap_is_flexible(ch[1])
            print("  ok  event_node_gap_fixed")
            passed += 1
        else
            print("FAIL event_node_gap_fixed")
            failed += 1
        if prism_arrange.prism_gap_size(ch[1], -1) == 8
            print("  ok  event_node_gap_size_8")
            passed += 1
        else
            print("FAIL event_node_gap_size_8: got " + str(prism_arrange.prism_gap_size(ch[1], -1)))
            failed += 1
        if prism_node.prism_node_kind_str(ch[2]) == "stack"
            print("  ok  event_node_body_is_stack")
            passed += 1
        else
            print("FAIL event_node_body_is_stack: got " + prism_node.prism_node_kind_str(ch[2]))
            failed += 1
        let bch = prism_node.prism_node_children(ch[2])
        if len(bch) == 2
            print("  ok  event_node_body_2_children")
            passed += 1
        else
            print("FAIL event_node_body_2_children: got " + str(len(bch)))
            failed += 1
        if prism_node.prism_node_attr_str(bch[0], "text", "") == "Deploy started"
            print("  ok  event_node_title_text")
            passed += 1
        else
            print("FAIL event_node_title_text")
            failed += 1
        if prism_node.prism_node_attr_str(bch[1], "text", "") == "v2.3.1 rolling out"
            print("  ok  event_node_detail_text")
            passed += 1
        else
            print("FAIL event_node_detail_text")
            failed += 1
    else
        print("FAIL event_node_ok: " + unwrap_err(r_en1))
        failed += 10

    // ── Group C: prism_ac_event_node with empty detail (e2) ─────────────────────────────────
    let r_en2 = prism_ui_activity.prism_ac_event_node(e2)
    if is_ok(r_en2)
        print("  ok  event_node_empty_detail_ok")
        passed += 1
        let n2 = unwrap(r_en2)
        let ch2 = prism_node.prism_node_children(n2)
        let bch2 = prism_node.prism_node_children(ch2[2])
        if prism_node.prism_node_attr_str(bch2[1], "text", "MISSING") == ""
            print("  ok  event_node_empty_detail_renders_blank")
            passed += 1
        else
            print("FAIL event_node_empty_detail_renders_blank")
            failed += 1
    else
        print("FAIL event_node_empty_detail_ok: " + unwrap_err(r_en2))
        failed += 2

    // ── Group D: prism_ac_event_node errors ──────────────────────────────────────────────────
    let e_bad_time = prism_ui_activity.prism_ac_event("", "Title", "Detail")
    if is_err(prism_ui_activity.prism_ac_event_node(e_bad_time))
        print("  ok  event_node_err_empty_time")
        passed += 1
    else
        print("FAIL event_node_err_empty_time")
        failed += 1

    let e_bad_title = prism_ui_activity.prism_ac_event("10:00", "", "Detail")
    if is_err(prism_ui_activity.prism_ac_event_node(e_bad_title))
        print("  ok  event_node_err_empty_title")
        passed += 1
    else
        print("FAIL event_node_err_empty_title")
        failed += 1

    // ── Group E: prism_ac_feed happy path ────────────────────────────────────────────────────
    let r_feed = prism_ui_activity.prism_ac_feed([e1, e2, e3])
    if is_ok(r_feed)
        print("  ok  feed_ok")
        passed += 1
        let nf = unwrap(r_feed)
        if prism_node.prism_node_kind_str(nf) == "stack"
            print("  ok  feed_is_stack")
            passed += 1
        else
            print("FAIL feed_is_stack: got " + prism_node.prism_node_kind_str(nf))
            failed += 1
        let fch = prism_node.prism_node_children(nf)
        if len(fch) == 3
            print("  ok  feed_3_children")
            passed += 1
        else
            print("FAIL feed_3_children: got " + str(len(fch)))
            failed += 1
        if prism_node.prism_node_kind_str(fch[0]) == "band"
            print("  ok  feed_child0_is_band")
            passed += 1
        else
            print("FAIL feed_child0_is_band: got " + prism_node.prism_node_kind_str(fch[0]))
            failed += 1
        let fch0_children = prism_node.prism_node_children(fch[0])
        if prism_node.prism_node_attr_str(fch0_children[0], "text", "") == "10:00"
            print("  ok  feed_child0_time")
            passed += 1
        else
            print("FAIL feed_child0_time")
            failed += 1
        let fch2_children = prism_node.prism_node_children(fch[2])
        if prism_node.prism_node_attr_str(fch2_children[0], "text", "") == "10:10"
            print("  ok  feed_child2_time")
            passed += 1
        else
            print("FAIL feed_child2_time")
            failed += 1
    else
        print("FAIL feed_ok: " + unwrap_err(r_feed))
        failed += 6

    // ── Group F: prism_ac_feed errors ────────────────────────────────────────────────────────
    if is_err(prism_ui_activity.prism_ac_feed([]))
        print("  ok  feed_err_empty")
        passed += 1
    else
        print("FAIL feed_err_empty")
        failed += 1

    if is_err(prism_ui_activity.prism_ac_feed([e1, "not_an_event"]))
        print("  ok  feed_err_bad_element")
        passed += 1
    else
        print("FAIL feed_err_bad_element")
        failed += 1

    // ── Group G: prism_ac_compact happy path ─────────────────────────────────────────────────
    let r_cmp = prism_ui_activity.prism_ac_compact([e1, e2, e3])
    if is_ok(r_cmp)
        print("  ok  compact_ok")
        passed += 1
        let nc = unwrap(r_cmp)
        if prism_node.prism_node_kind_str(nc) == "stack"
            print("  ok  compact_is_stack")
            passed += 1
        else
            print("FAIL compact_is_stack: got " + prism_node.prism_node_kind_str(nc))
            failed += 1
        let cch = prism_node.prism_node_children(nc)
        if len(cch) == 3
            print("  ok  compact_3_children")
            passed += 1
        else
            print("FAIL compact_3_children: got " + str(len(cch)))
            failed += 1
        if prism_node.prism_node_kind_str(cch[0]) == "band"
            print("  ok  compact_row0_is_band")
            passed += 1
        else
            print("FAIL compact_row0_is_band: got " + prism_node.prism_node_kind_str(cch[0]))
            failed += 1
        let row0 = prism_node.prism_node_children(cch[0])
        if len(row0) == 2
            print("  ok  compact_row0_2_children")
            passed += 1
        else
            print("FAIL compact_row0_2_children: got " + str(len(row0)))
            failed += 1
        if prism_node.prism_node_attr_str(row0[0], "text", "") == "10:00"
            print("  ok  compact_row0_time")
            passed += 1
        else
            print("FAIL compact_row0_time")
            failed += 1
        if prism_node.prism_node_attr_str(row0[1], "text", "") == "Deploy started"
            print("  ok  compact_row0_title")
            passed += 1
        else
            print("FAIL compact_row0_title")
            failed += 1
    else
        print("FAIL compact_ok: " + unwrap_err(r_cmp))
        failed += 7

    // ── Group H: prism_ac_compact errors ─────────────────────────────────────────────────────
    if is_err(prism_ui_activity.prism_ac_compact([]))
        print("  ok  compact_err_empty")
        passed += 1
    else
        print("FAIL compact_err_empty")
        failed += 1

    if is_err(prism_ui_activity.prism_ac_compact([42]))
        print("  ok  compact_err_bad_element")
        passed += 1
    else
        print("FAIL compact_err_bad_element")
        failed += 1

    // ── Group I: prism_ac_grouped happy path ─────────────────────────────────────────────────
    let r_grp = prism_ui_activity.prism_ac_grouped("Today", [e1, e2])
    if is_ok(r_grp)
        print("  ok  grouped_ok")
        passed += 1
        let ng = unwrap(r_grp)
        if prism_node.prism_node_kind_str(ng) == "stack"
            print("  ok  grouped_is_stack")
            passed += 1
        else
            print("FAIL grouped_is_stack: got " + prism_node.prism_node_kind_str(ng))
            failed += 1
        let gch = prism_node.prism_node_children(ng)
        if len(gch) == 2
            print("  ok  grouped_2_children")
            passed += 1
        else
            print("FAIL grouped_2_children: got " + str(len(gch)))
            failed += 1
        if prism_node.prism_node_kind_str(gch[0]) == "label" and prism_node.prism_node_attr_str(gch[0], "text", "") == "Today"
            print("  ok  grouped_header_text")
            passed += 1
        else
            print("FAIL grouped_header_text")
            failed += 1
        if prism_node.prism_node_kind_str(gch[1]) == "stack"
            print("  ok  grouped_feed_is_stack")
            passed += 1
        else
            print("FAIL grouped_feed_is_stack: got " + prism_node.prism_node_kind_str(gch[1]))
            failed += 1
        let gfeed_children = prism_node.prism_node_children(gch[1])
        if len(gfeed_children) == 2
            print("  ok  grouped_feed_2_events")
            passed += 1
        else
            print("FAIL grouped_feed_2_events: got " + str(len(gfeed_children)))
            failed += 1
    else
        print("FAIL grouped_ok: " + unwrap_err(r_grp))
        failed += 6

    // ── Group J: prism_ac_grouped errors ─────────────────────────────────────────────────────
    if is_err(prism_ui_activity.prism_ac_grouped("", [e1]))
        print("  ok  grouped_err_empty_label")
        passed += 1
    else
        print("FAIL grouped_err_empty_label")
        failed += 1

    if is_err(prism_ui_activity.prism_ac_grouped("Today", []))
        print("  ok  grouped_err_empty_events")
        passed += 1
    else
        print("FAIL grouped_err_empty_events")
        failed += 1

    if is_err(prism_ui_activity.prism_ac_grouped("Today", ["bogus"]))
        print("  ok  grouped_err_bad_element")
        passed += 1
    else
        print("FAIL grouped_err_bad_element")
        failed += 1

    // ── Group K: prism_ac_latest happy path, count < len ─────────────────────────────────────
    let r_lat1 = prism_ui_activity.prism_ac_latest([e1, e2, e3], 2)
    if is_ok(r_lat1)
        print("  ok  latest_partial_ok")
        passed += 1
        let nl1 = unwrap(r_lat1)
        if prism_node.prism_node_kind_str(nl1) == "stack"
            print("  ok  latest_partial_is_stack")
            passed += 1
        else
            print("FAIL latest_partial_is_stack: got " + prism_node.prism_node_kind_str(nl1))
            failed += 1
        let lch1 = prism_node.prism_node_children(nl1)
        if len(lch1) == 2
            print("  ok  latest_partial_2_children")
            passed += 1
        else
            print("FAIL latest_partial_2_children: got " + str(len(lch1)))
            failed += 1
        let lch1_first = prism_node.prism_node_children(lch1[0])
        if prism_node.prism_node_attr_str(lch1_first[0], "text", "") == "10:00"
            print("  ok  latest_partial_first_is_e1")
            passed += 1
        else
            print("FAIL latest_partial_first_is_e1")
            failed += 1
    else
        print("FAIL latest_partial_ok: " + unwrap_err(r_lat1))
        failed += 4

    // ── Group L: prism_ac_latest happy path, count >= len ────────────────────────────────────
    let r_lat2 = prism_ui_activity.prism_ac_latest([e1, e2, e3], 10)
    if is_ok(r_lat2)
        print("  ok  latest_overflow_ok")
        passed += 1
        let lch2 = prism_node.prism_node_children(unwrap(r_lat2))
        if len(lch2) == 3
            print("  ok  latest_overflow_all_3")
            passed += 1
        else
            print("FAIL latest_overflow_all_3: got " + str(len(lch2)))
            failed += 1
    else
        print("FAIL latest_overflow_ok: " + unwrap_err(r_lat2))
        failed += 2

    // ── Group M: prism_ac_latest errors ──────────────────────────────────────────────────────
    if is_err(prism_ui_activity.prism_ac_latest([e1, e2, e3], 0))
        print("  ok  latest_err_count_zero")
        passed += 1
    else
        print("FAIL latest_err_count_zero")
        failed += 1

    if is_err(prism_ui_activity.prism_ac_latest([e1, e2, e3], -1))
        print("  ok  latest_err_count_negative")
        passed += 1
    else
        print("FAIL latest_err_count_negative")
        failed += 1

    if is_err(prism_ui_activity.prism_ac_latest([], 3))
        print("  ok  latest_err_empty_events")
        passed += 1
    else
        print("FAIL latest_err_empty_events")
        failed += 1

    print("== " + str(passed) + " passed, " + str(failed) + " failed ==")
    if failed > 0
        exit(1)
