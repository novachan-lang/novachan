import std/coding/parity2d

// ── Helpers ───────────────────────────────────────────────────────────────────

fn list_eq(a, b) -> bool
    let la = len(a)
    let lb = len(b)
    if la != lb
        return 0
    let i = 0
    while i < la
        if a[i] != b[i]
            return 0
        i = i + 1
    1

fn list_str(a) -> any
    let s = "["
    let i = 0
    while i < len(a)
        if i > 0
            s = s + ","
        s = s + str(a[i])
        i = i + 1
    s = s + "]"
    s

fn cki(label, got, want)
    if got != want
        print("FAIL parity2d " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    if not list_eq(got, want)
        print("FAIL parity2d " + label + ": got=" + list_str(got) + " want=" + list_str(want))
        exit(1)

// ── Main ──────────────────────────────────────────────────────────────────────

fn main()
    // Data = [1,0,1,1] in a 2x2 grid (rows=2, cols=2)
    // Grid layout: row0=[1,0], row1=[1,1]
    // row parities: rp0=1^0=1, rp1=1^1=0
    // col parities: cp0=1^1=0, cp1=0^1=1
    // corner = 1^0=1 (XOR of row parities), or 1^0^1^1=1 (XOR of all data)
    // Codeword: [1,0,1,1, 1,0, 0,1, 1] (9 bits)

    let data = []
    push(data, 1)
    push(data, 0)
    push(data, 1)
    push(data, 1)

    // --- Row parity ---
    cki("p2_row_parity_r0", p2_row_parity(data, 0, 2), 1)
    cki("p2_row_parity_r1", p2_row_parity(data, 1, 2), 0)

    // p2_row_parity of [1,0] (a row with 1 and 0) = 1 (odd parity)
    let row10 = []
    push(row10, 1)
    push(row10, 0)
    cki("p2_row_parity_10", p2_row_parity(row10, 0, 2), 1)

    // --- Col parity ---
    cki("p2_col_parity_c0", p2_col_parity(data, 0, 2, 2), 0)
    cki("p2_col_parity_c1", p2_col_parity(data, 1, 2, 2), 1)

    // --- Encoding ---
    let code = p2_encode(data, 2, 2)
    cki("p2_encode_len", len(code), 9)

    // Verify data portion
    cki("p2_code_d0", code[0], 1)
    cki("p2_code_d1", code[1], 0)
    cki("p2_code_d2", code[2], 1)
    cki("p2_code_d3", code[3], 1)
    // Row parities at [4],[5]
    cki("p2_code_rp0", code[4], 1)
    cki("p2_code_rp1", code[5], 0)
    // Col parities at [6],[7]
    cki("p2_code_cp0", code[6], 0)
    cki("p2_code_cp1", code[7], 1)
    // Corner at [8]
    cki("p2_code_corner", code[8], 1)

    // --- p2_check on clean codeword ---
    cki("p2_check_clean", p2_check(code, 2, 2), 1)

    // --- p2_find_error on clean codeword: no error ---
    let loc_clean = p2_find_error(code, 2, 2)
    cki("p2_find_error_clean_r", loc_clean[0], 0 - 1)
    cki("p2_find_error_clean_c", loc_clean[1], 0 - 1)

    // --- Single-bit error correction: flip each data bit ---
    let dr = 0
    while dr < 2
        let dc = 0
        while dc < 2
            // Build corrupted codeword
            let corrupt = []
            let ki = 0
            while ki < 9
                push(corrupt, code[ki])
                ki = ki + 1
            let pos = dr * 2 + dc
            corrupt[pos] = (corrupt[pos] ^ 1) & 1

            // p2_check should detect error
            let chk_label = "p2_check_after_flip_" + str(dr) + "_" + str(dc)
            cki(chk_label, p2_check(corrupt, 2, 2), 0)

            // p2_find_error should locate it
            let loc = p2_find_error(corrupt, 2, 2)
            let row_label = "p2_find_error_row_" + str(dr) + "_" + str(dc)
            let col_label = "p2_find_error_col_" + str(dr) + "_" + str(dc)
            cki(row_label, loc[0], dr)
            cki(col_label, loc[1], dc)

            // p2_decode should recover original data
            let recovered = p2_decode(corrupt, 2, 2)
            let dec_label = "p2_decode_correct_" + str(dr) + "_" + str(dc)
            ckb(dec_label, recovered, data)

            dc = dc + 1
        dr = dr + 1

    // --- Round-trip: clean encode -> decode ---
    let dec_clean = p2_decode(code, 2, 2)
    ckb("p2_decode_clean", dec_clean, data)

    // --- All-zeros data ---
    let data_zero = []
    push(data_zero, 0)
    push(data_zero, 0)
    push(data_zero, 0)
    push(data_zero, 0)
    let code_zero = p2_encode(data_zero, 2, 2)
    cki("p2_check_zero", p2_check(code_zero, 2, 2), 1)
    ckb("p2_decode_zero", p2_decode(code_zero, 2, 2), data_zero)

    // --- All-ones data ---
    let data_ones = []
    push(data_ones, 1)
    push(data_ones, 1)
    push(data_ones, 1)
    push(data_ones, 1)
    let code_ones = p2_encode(data_ones, 2, 2)
    cki("p2_check_ones", p2_check(code_ones, 2, 2), 1)
    ckb("p2_decode_ones", p2_decode(code_ones, 2, 2), data_ones)

    // --- Larger grid: 3x3 = 9 data bits ---
    let data9 = []
    push(data9, 1)
    push(data9, 0)
    push(data9, 1)
    push(data9, 0)
    push(data9, 1)
    push(data9, 0)
    push(data9, 1)
    push(data9, 0)
    push(data9, 1)
    let code9 = p2_encode(data9, 3, 3)
    cki("p2_encode_3x3_len", len(code9), 16)
    cki("p2_check_3x3_clean", p2_check(code9, 3, 3), 1)

    // Flip data[4] (row=1, col=1) in 3x3 grid
    let corrupt9 = []
    let ki9 = 0
    while ki9 < 16
        push(corrupt9, code9[ki9])
        ki9 = ki9 + 1
    corrupt9[4] = (corrupt9[4] ^ 1) & 1

    let loc9 = p2_find_error(corrupt9, 3, 3)
    cki("p2_find_error_3x3_r", loc9[0], 1)
    cki("p2_find_error_3x3_c", loc9[1], 1)

    let rec9 = p2_decode(corrupt9, 3, 3)
    ckb("p2_decode_3x3_corrected", rec9, data9)

    // --- p2_syndrome on clean codeword: all zeros ---
    let syn = p2_syndrome(code, 2, 2)
    let rs = syn["row_syn"]
    let cs = syn["col_syn"]
    cki("p2_syndrome_clean_r0", rs[0], 0)
    cki("p2_syndrome_clean_r1", rs[1], 0)
    cki("p2_syndrome_clean_c0", cs[0], 0)
    cki("p2_syndrome_clean_c1", cs[1], 0)

    print("PASS _parity2d_test")
