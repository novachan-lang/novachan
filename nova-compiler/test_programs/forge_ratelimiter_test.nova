// Forge S0/T1.6 (rate-limit, the sound N>1-safe form): a single-owner rate-limiter ACTOR with per-key
// token buckets. Capacity 2, no refill: a key gets 2 requests then is limited; a different key has its
// own fresh bucket. Socketless (actor over a channel), kill-on-timeout safe.
import forge_limits

fn main()
    let lim = rate_limiter(2.0, 0.0)
    let a1 = rate_check(lim, "1.2.3.4", 0)   // allow (2 -> 1)
    let a2 = rate_check(lim, "1.2.3.4", 0)   // allow (1 -> 0)
    let a3 = rate_check(lim, "1.2.3.4", 0)   // LIMIT (bucket empty)
    let b1 = rate_check(lim, "5.6.7.8", 0)   // allow (separate key -> own fresh bucket)
    if a1 != 1 or a2 != 1 or a3 != 0 or b1 != 1
        print("FAIL: a1=" + str(a1) + " a2=" + str(a2) + " a3=" + str(a3) + " b1=" + str(b1))
        exit(1)
    print("PASS forge_ratelimiter (per-key bucket via N>1-safe actor: 2 allowed, 3rd limited, separate key fresh)")
