import std/relation/relation_order

// cki — integer known-answer check.
fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb — boolean known-answer check (1=true, 0=false).
fn ckb(label, got, want)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

// ckl — integer-list known-answer check.
fn ckl(label, got, want)
    if len(got) != len(want)
        print("FAIL " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL " + label + ": idx=" + str(i) + " got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

// ckm — matrix known-answer check.
fn ckm(label, A, B)
    let n = len(A)
    if len(B) != n
        print("FAIL " + label + ": row count got=" + str(n) + " want=" + str(len(B)))
        exit(1)
    let i = 0
    while i < n
        let j = 0
        while j < len(A[i])
            if A[i][j] != B[i][j]
                print("FAIL " + label + ": [" + str(i) + "][" + str(j) + "] got=" + str(A[i][j]) + " want=" + str(B[i][j]))
                exit(1)
            j = j + 1
        i = i + 1

fn main()
    // ── KAT 1: divisibility poset on {1,2,3,4} (indices 0..3) ──────────────────
    // M[i][j]=1 iff (i+1) divides (j+1).
    // Row 0 (1 divides 1,2,3,4): [1,1,1,1]
    // Row 1 (2 divides 2,4):     [0,1,0,1]
    // Row 2 (3 divides 3):       [0,0,1,0]
    // Row 3 (4 divides 4):       [0,0,0,1]
    let Mdiv = []
    let rd0 = []
    rd0.push(1)
    rd0.push(1)
    rd0.push(1)
    rd0.push(1)
    Mdiv.push(rd0)
    let rd1 = []
    rd1.push(0)
    rd1.push(1)
    rd1.push(0)
    rd1.push(1)
    Mdiv.push(rd1)
    let rd2 = []
    rd2.push(0)
    rd2.push(0)
    rd2.push(1)
    rd2.push(0)
    Mdiv.push(rd2)
    let rd3 = []
    rd3.push(0)
    rd3.push(0)
    rd3.push(0)
    rd3.push(1)
    Mdiv.push(rd3)

    cki("div_is_partial_order", rord_is_partial_order(Mdiv, 4), 1)

    // Minimal elements: only index 0 (value 1 divides everything, nothing divides 1 except itself)
    let mini = rord_minimal(Mdiv, 4)
    ckl("div_minimal", mini, [0])

    // Maximal elements: indices 2 and 3 (values 3 and 4; no element in the set is divisible by 3 or 4 above them)
    // Index 0: row [1,1,1,1] -> columns 1,2,3 nonzero outside diag -> not maximal
    // Index 1: row [0,1,0,1] -> column 3 nonzero -> not maximal
    // Index 2: row [0,0,1,0] -> no column outside diag is 1 -> MAXIMAL
    // Index 3: row [0,0,0,1] -> no column outside diag is 1 -> MAXIMAL
    let maxi = rord_maximal(Mdiv, 4)
    ckl("div_maximal", maxi, [2, 3])

    // Covering relation: excludes (0,3) because 0->1->3 is a chain (1 divides 2 divides 4)
    // Contains: (0,1) 1->2, (0,2) 1->3, (1,3) 2->4. NOT (0,3) 1->4.
    let Hasse = rord_covers(Mdiv, 4)
    cki("hasse_01_covers", Hasse[0][1], 1)
    cki("hasse_02_covers", Hasse[0][2], 1)
    cki("hasse_13_covers", Hasse[1][3], 1)
    cki("hasse_03_not_covers", Hasse[0][3], 0)
    // Self-loops are never covers (i==j excluded)
    cki("hasse_00_not", Hasse[0][0], 0)
    cki("hasse_11_not", Hasse[1][1], 0)
    // No reverse edges
    cki("hasse_10_not", Hasse[1][0], 0)
    cki("hasse_31_not", Hasse[3][1], 0)

    // ── KAT 2: divisibility poset is NOT a total order ──────────────────────────
    // 2 and 3 are incomparable (neither divides the other)
    cki("div_not_total", rord_is_total_order(Mdiv, 4), 0)

    // ── KAT 3: identity(3) is a partial order ───────────────────────────────────
    let I3 = []
    let ia = []
    ia.push(1)
    ia.push(0)
    ia.push(0)
    I3.push(ia)
    let ib = []
    ib.push(0)
    ib.push(1)
    ib.push(0)
    I3.push(ib)
    let ic = []
    ic.push(0)
    ic.push(0)
    ic.push(1)
    I3.push(ic)
    cki("id3_is_partial_order", rord_is_partial_order(I3, 3), 1)
    // All elements are both minimal and maximal in identity (discrete order)
    let mini3 = rord_minimal(I3, 3)
    ckl("id3_minimal", mini3, [0, 1, 2])
    let maxi3 = rord_maximal(I3, 3)
    ckl("id3_maximal", maxi3, [0, 1, 2])

    // ── KAT 4: total order (chain 0<=1<=2 reflexive) ────────────────────────────
    // M[i][j]=1 iff i<=j. Matrix: [[1,1,1],[0,1,1],[0,0,1]]
    let Mchain = []
    let mc0 = []
    mc0.push(1)
    mc0.push(1)
    mc0.push(1)
    Mchain.push(mc0)
    let mc1 = []
    mc1.push(0)
    mc1.push(1)
    mc1.push(1)
    Mchain.push(mc1)
    let mc2 = []
    mc2.push(0)
    mc2.push(0)
    mc2.push(1)
    Mchain.push(mc2)
    cki("chain3_is_partial_order", rord_is_partial_order(Mchain, 3), 1)
    cki("chain3_is_total_order", rord_is_total_order(Mchain, 3), 1)
    let miniC = rord_minimal(Mchain, 3)
    ckl("chain3_minimal", miniC, [0])
    let maxiC = rord_maximal(Mchain, 3)
    ckl("chain3_maximal", maxiC, [2])

    // ── KAT 5: strict order — irreflexive transitive relation ───────────────────
    // Strict version of chain: (i,j) iff i<j. Matrix: [[0,1,1],[0,0,1],[0,0,0]]
    let Mstrict = []
    let ms0 = []
    ms0.push(0)
    ms0.push(1)
    ms0.push(1)
    Mstrict.push(ms0)
    let ms1 = []
    ms1.push(0)
    ms1.push(0)
    ms1.push(1)
    Mstrict.push(ms1)
    let ms2 = []
    ms2.push(0)
    ms2.push(0)
    ms2.push(0)
    Mstrict.push(ms2)
    cki("strict_chain3_is_strict_order", rord_is_strict_order(Mstrict, 3), 1)
    // reflexive partial order is NOT a strict order (has self-loops)
    cki("chain3_not_strict", rord_is_strict_order(Mchain, 3), 0)

    // ── KAT 6: non-transitive relation is not a partial order ───────────────────
    // {(0,1),(1,2)} without (0,2) — not transitive
    let Mnt = []
    let nt0 = []
    nt0.push(1)
    nt0.push(1)
    nt0.push(0)
    Mnt.push(nt0)
    let nt1 = []
    nt1.push(0)
    nt1.push(1)
    nt1.push(1)
    Mnt.push(nt1)
    let nt2 = []
    nt2.push(0)
    nt2.push(0)
    nt2.push(1)
    Mnt.push(nt2)
    cki("nontransitive_not_partial_order", rord_is_partial_order(Mnt, 3), 0)

    // ── KAT 7: symmetric relation is not a partial order (antisymmetry fails) ───
    // M = {(0,1),(1,0)} plus identity — symmetric, reflexive, but antisymmetric fails
    let Msym = []
    let sy0 = []
    sy0.push(1)
    sy0.push(1)
    sy0.push(0)
    Msym.push(sy0)
    let sy1 = []
    sy1.push(1)
    sy1.push(1)
    sy1.push(0)
    Msym.push(sy1)
    let sy2 = []
    sy2.push(0)
    sy2.push(0)
    sy2.push(1)
    Msym.push(sy2)
    cki("sym_not_partial_order", rord_is_partial_order(Msym, 3), 0)

    // ── KAT 8: n=0 edge case ────────────────────────────────────────────────────
    let M0 = []
    cki("n0_is_partial_order", rord_is_partial_order(M0, 0), 1)
    cki("n0_is_total_order", rord_is_total_order(M0, 0), 1)
    cki("n0_is_strict_order", rord_is_strict_order(M0, 0), 1)
    let min0 = rord_minimal(M0, 0)
    cki("n0_minimal_len", len(min0), 0)
    let max0 = rord_maximal(M0, 0)
    cki("n0_maximal_len", len(max0), 0)
    let C0 = rord_covers(M0, 0)
    cki("n0_covers_len", len(C0), 0)

    // ── KAT 9: n=1 edge case ────────────────────────────────────────────────────
    let M1 = []
    let m1r = []
    m1r.push(1)
    M1.push(m1r)
    cki("n1_is_partial_order", rord_is_partial_order(M1, 1), 1)
    cki("n1_is_total_order", rord_is_total_order(M1, 1), 1)
    let min1 = rord_minimal(M1, 1)
    ckl("n1_minimal", min1, [0])
    let max1 = rord_maximal(M1, 1)
    ckl("n1_maximal", max1, [0])

    // ── KAT 10: covering of chain 0<=1<=2 (total order) ────────────────────────
    // Hasse of chain: (0,1) covers, (1,2) covers, (0,2) does NOT cover (goes through 1)
    let HasseC = rord_covers(Mchain, 3)
    cki("chain_hasse_01", HasseC[0][1], 1)
    cki("chain_hasse_12", HasseC[1][2], 1)
    cki("chain_hasse_02_not", HasseC[0][2], 0)
    cki("chain_hasse_00_not", HasseC[0][0], 0)

    // ── KAT 11: strict order with cycle is NOT a strict order ───────────────────
    // A cycle: {(0,1),(1,0)} — violates irreflexivity transitively? Let's test.
    // Actually {(0,1),(1,0)} alone: irreflexive (no self-loops), but transitive closure
    // adds (0,0) and (1,1) — so it's NOT transitively closed as a strict order.
    // Checking: M[0][1]=1, M[1][0]=1 => M[0][0] must be 1 for transitivity, but it's 0
    // => NOT transitive => NOT a strict order. Correct.
    let Mcyc = []
    let cyc0 = []
    cyc0.push(0)
    cyc0.push(1)
    Mcyc.push(cyc0)
    let cyc1 = []
    cyc1.push(1)
    cyc1.push(0)
    Mcyc.push(cyc1)
    cki("cycle_not_strict", rord_is_strict_order(Mcyc, 2), 0)

    print("PASS _relation_order_test")

main()
