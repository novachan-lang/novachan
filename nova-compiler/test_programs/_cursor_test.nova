import std/term/cursor

fn main()
    let ESC = chr(27)

    // ── KAT 1: cursor_up(3) == ESC+"[3A" ─────────────────────────────────────
    let want1 = ESC + "[3A"
    let got1 = cursor_up(3)
    if got1 != want1
        print("FAIL cursor up(3): len got=" + str(len(got1)) + " want=" + str(len(want1)))
        exit(1)

    // ── KAT 2: cursor_down(1) == ESC+"[1B" ───────────────────────────────────
    let want2 = ESC + "[1B"
    let got2 = cursor_down(1)
    if got2 != want2
        print("FAIL cursor down(1): len got=" + str(len(got2)) + " want=" + str(len(want2)))
        exit(1)

    // ── KAT 3: cursor_fwd(5) == ESC+"[5C" ────────────────────────────────────
    let want3 = ESC + "[5C"
    let got3 = cursor_fwd(5)
    if got3 != want3
        print("FAIL cursor fwd(5): len got=" + str(len(got3)) + " want=" + str(len(want3)))
        exit(1)

    // ── KAT 4: cursor_back(2) == ESC+"[2D" ───────────────────────────────────
    let want4 = ESC + "[2D"
    let got4 = cursor_back(2)
    if got4 != want4
        print("FAIL cursor back(2): len got=" + str(len(got4)) + " want=" + str(len(want4)))
        exit(1)

    // ── KAT 5: cursor_goto(5,10) == ESC+"[5;10H" ─────────────────────────────
    let want5 = ESC + "[5;10H"
    let got5 = cursor_goto(5, 10)
    if got5 != want5
        print("FAIL cursor goto(5,10): len got=" + str(len(got5)) + " want=" + str(len(want5)))
        exit(1)

    // ── KAT 6: cursor_col(1) == ESC+"[1G" ────────────────────────────────────
    let want6 = ESC + "[1G"
    let got6 = cursor_col(1)
    if got6 != want6
        print("FAIL cursor col(1): len got=" + str(len(got6)) + " want=" + str(len(want6)))
        exit(1)

    // ── KAT 7: cursor_save() == ESC+"[s" ─────────────────────────────────────
    let want7 = ESC + "[s"
    let got7 = cursor_save()
    if got7 != want7
        print("FAIL cursor save: len got=" + str(len(got7)) + " want=" + str(len(want7)))
        exit(1)

    // ── KAT 8: cursor_restore() == ESC+"[u" ──────────────────────────────────
    let want8 = ESC + "[u"
    let got8 = cursor_restore()
    if got8 != want8
        print("FAIL cursor restore: len got=" + str(len(got8)) + " want=" + str(len(want8)))
        exit(1)

    // ── KAT 9: cursor_hide() == ESC+"[?25l" ──────────────────────────────────
    let want9 = ESC + "[?25l"
    let got9 = cursor_hide()
    if got9 != want9
        print("FAIL cursor hide: len got=" + str(len(got9)) + " want=" + str(len(want9)))
        exit(1)

    // ── KAT 10: cursor_show() == ESC+"[?25h" ─────────────────────────────────
    let want10 = ESC + "[?25h"
    let got10 = cursor_show()
    if got10 != want10
        print("FAIL cursor show: len got=" + str(len(got10)) + " want=" + str(len(want10)))
        exit(1)

    // ── KAT 11: clamp — cursor_up(0) clamps to n=1 => ESC+"[1A" ─────────────
    let want11 = ESC + "[1A"
    let got11 = cursor_up(0)
    if got11 != want11
        print("FAIL cursor up(0) clamp: len got=" + str(len(got11)) + " want=" + str(len(want11)))
        exit(1)

    // ── KAT 12: clamp — cursor_goto(0,0) clamps to (1,1) => ESC+"[1;1H" ─────
    let want12 = ESC + "[1;1H"
    let got12 = cursor_goto(0, 0)
    if got12 != want12
        print("FAIL cursor goto(0,0) clamp: len got=" + str(len(got12)) + " want=" + str(len(want12)))
        exit(1)

    // ── KAT 13: length check for cursor_goto(5,10) = 7 bytes ─────────────────
    // ESC(1) + [(1) + 5(1) + ;(1) + 1(1) + 0(1) + H(1) = 7
    let gotlen13 = len(got5)
    if gotlen13 != 7
        print("FAIL cursor goto len: got=" + str(gotlen13) + " want=7")
        exit(1)

    // ── KAT 14: cursor_col(20) == ESC+"[20G" ─────────────────────────────────
    let want14 = ESC + "[20G"
    let got14 = cursor_col(20)
    if got14 != want14
        print("FAIL cursor col(20): len got=" + str(len(got14)) + " want=" + str(len(want14)))
        exit(1)

    print("PASS _cursor_test")
