// Exit hooks: at_exit(fn) registers cleanup that runs at program exit, in LIFO order
// (like C atexit / Go defer-at-program-scope), no matter how the program ends.

fn main()
    at_exit(fn() print("cleanup A (registered first, runs last)"))
    at_exit(fn() print("cleanup B (registered second, runs first)"))
    print("main body done")
