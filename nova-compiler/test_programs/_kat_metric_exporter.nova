import forge_metric_exporter

fn main()
    let m = me_new()
    m = me_counter(m, "requests")
    m = me_counter(m, "errors")
    m = me_gauge(m, "active_conns")
    assert(me_counter_count(m) == 2, "2 counters")
    assert(me_gauge_count(m) == 1, "1 gauge")

    let r1 = me_inc(m, "requests", 10)
    assert(is_ok(r1), "inc ok")
    m = unwrap(r1)
    let r2 = me_inc(m, "requests", 5)
    assert(is_ok(r2), "inc again")
    m = unwrap(r2)

    let c = me_get_counter(m, "requests")
    assert(is_ok(c), "get counter ok")
    assert(unwrap(c) == 15, "15 requests")

    let r3 = me_set_gauge(m, "active_conns", 42)
    assert(is_ok(r3), "set gauge ok")
    m = unwrap(r3)
    let g = me_get_gauge(m, "active_conns")
    assert(is_ok(g), "get gauge ok")
    assert(unwrap(g) == 42, "42 active")

    let bad = me_inc(m, "nope", 1)
    assert(is_err(bad), "unknown counter")

    print("METRIC-EXPORTER KAT PASS")
