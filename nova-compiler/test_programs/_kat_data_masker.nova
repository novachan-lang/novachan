import forge_data_masker

fn main()
    let d = dm_new()
    d = dm_add_rule(d, "email", "redact")
    d = dm_add_rule(d, "ssn", "partial")
    d = dm_add_rule(d, "name", "hash")
    assert(dm_rule_count(d) == 3, "3 rules")

    let data = {}
    data["email"] = "alice@example.com"
    data["ssn"] = "123456789"
    data["name"] = "Alice"
    data["age"] = "30"

    let masked = dm_mask(d, data)
    d = masked["_d"]
    assert(masked["email"] == "***REDACTED***", "email redacted")
    assert(masked["age"] == "30", "age passthrough")

    let ssn = masked["ssn"]
    assert(slice(ssn, 0, 2) == "12", "ssn partial start")
    assert(slice(ssn, 6, 8) == "89", "ssn partial end")

    let hashed = masked["name"]
    assert(slice(hashed, 0, 5) == "hash:", "name hashed prefix")

    assert(dm_total_masked(d) == 3, "3 masked")

    print("DATA-MASKER KAT PASS")
