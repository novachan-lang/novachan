fn test_store()
    let ivs = []
    push(ivs, [1,3])
    push(ivs, [5,8])
    push(ivs, [6,10])
    push(ivs, [15,20])
    let t = {}
    t["ivs"] = ivs
    t["n"] = 4
    return t

fn main()
    let t = test_store()
    let ivs = t["ivs"]
    let n = t["n"]
    print("n=" + str(n) + " len(ivs)=" + str(len(ivs)))
    let i = 0
    while i < n
        let ii = i
        let iv = ivs[ii]
        print("iv[" + str(ii) + "]=" + str(iv[0]) + "," + str(iv[1]))
        i = i + 1

main()
