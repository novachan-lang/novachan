import forge_connection_drain

fn main()
    let cd = cd_new(300)
    cd = cd_add_conn(cd, "conn-1", 1000)
    cd = cd_add_conn(cd, "conn-2", 1001)
    cd = cd_add_conn(cd, "conn-3", 1002)
    assert(cd_total_connections(cd) == 3, "3 connections")
    assert(cd_active_count(cd) == 3, "3 active")
    assert(cd_is_draining(cd) == 0, "not draining")

    cd = cd_close_conn(cd, "conn-1")
    assert(cd_active_count(cd) == 2, "2 active")
    assert(cd_total_completed(cd) == 1, "1 completed")

    cd = cd_start_drain(cd, 2000)
    assert(cd_is_draining(cd) == 1, "draining")
    assert(cd_is_drained(cd) == 0, "not drained yet")

    cd = cd_add_conn(cd, "conn-4", 2001)
    assert(cd_total_connections(cd) == 3, "reject new during drain")

    cd = cd_close_conn(cd, "conn-2")
    cd = cd_close_conn(cd, "conn-3")
    assert(cd_is_drained(cd) == 1, "fully drained")
    assert(cd_total_completed(cd) == 3, "3 completed")

    let cd2 = cd_new(100)
    cd2 = cd_add_conn(cd2, "slow-1", 500)
    cd2 = cd_add_conn(cd2, "slow-2", 500)
    cd2 = cd_start_drain(cd2, 1000)
    assert(cd_is_timed_out(cd2, 1050) == 0, "not timed out at 50")
    assert(cd_is_timed_out(cd2, 1100) == 1, "timed out at 100")

    cd2 = cd_force_close_all(cd2)
    assert(cd_active_count(cd2) == 0, "all force closed")
    assert(cd_total_timed_out(cd2) == 2, "2 timed out")

    print("CONNECTION-DRAIN KAT PASS")
