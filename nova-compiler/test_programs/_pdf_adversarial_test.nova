import std/encoding/pdf

// Independent adversarial verification of std/encoding/pdf.
// Rebuilds the EXPECT
// ED bytes from the PDF 1.4 spec by hand (a totally separate
// code path from pdf.nova's private helpers) and requires FULL byte-for-byte
// equality against pdf_page()'s output, not just structural substring checks.

fn cks(label, got, want)
    if got != want
        print("FAIL adv " + label + ": got_len=" + str(len(got)) + " want_len=" + str(len(want)))
        print("GOT : " + got)
        print("WANT: " + want)
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL adv " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckt(label, cond)
    if cond == 0
        print("FAIL adv " + label)
        exit(1)

// Independent zero-pad reimplementation (separate from pdf.nova's _pdf_zpad).
fn zp(n, width)
    let s = str(n)
    while len(s) < width
        s = "0" + s
    s

// Build the full expected PDF byte-for-byte from the spec, given the raw
// (already-escaped) content-stream text fragment that goes inside BT...Tj...ET.
fn build_expected(escaped_text)
    let header = "%PDF-1.4\n"
    let o1 = "1 0 obj\n<< /Type /Catalog /Pages 2 0 R >>\nendobj\n"
    let o2 = "2 0 obj\n<< /Type /Pages /Kids [3 0 R] /Count 1 >>\nendobj\n"
    let o3a = "3 0 obj\n<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] "
    let o3 = o3a + "/Resources << /Font << /F1 4 0 R >> >> /Contents 5 0 R >>\nendobj\n"
    let o4 = "4 0 obj\n<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>\nendobj\n"
    let content = "BT /F1 24 Tf 72 720 Td (" + escaped_text + ") Tj ET"
    let clen = len(content)
    let o5a = "5 0 obj\n<< /Length " + str(clen) + " >>\nstream\n"
    let o5 = o5a + content + "\nendstream\nendobj\n"

    let off1 = len(header)
    let off2 = off1 + len(o1)
    let off3 = off2 + len(o2)
    let off4 = off3 + len(o3)
    let off5 = off4 + len(o4)
    let xoff = off5 + len(o5)

    let xref = "xref\n0 6\n"
    xref = xref + "0000000000 65535 f \n"
    xref = xref + zp(off1, 10) + " 00000 n \n"
    xref = xref + zp(off2, 10) + " 00000 n \n"
    xref = xref + zp(off3, 10) + " 00000 n \n"
    xref = xref + zp(off4, 10) + " 00000 n \n"
    xref = xref + zp(off5, 10) + " 00000 n \n"
    xref = xref + "trailer\n<< /Size 6 /Root 1 0 R >>\nstartxref\n" + str(xoff) + "\n%%EOF"

    let full = header + o1 + o2 + o3 + o4 + o5 + xref
    full

// Independent escape reimplementation (separate from pdf.nova's _pdf_escape_text)
// using replace() as a totally different mechanism than the char-loop the
// builder used, to cross-check the escaping algorithm itself.
fn my_escape(text)
    let t = replace(text, "\\", "\\\\")
    t = replace(t, "(", "\\(")
    t = replace(t, ")", "\\)")
    t

fn check_case(label, text)
    let got_bytes = pdf_page(text)
    let got = bytes_to_str(got_bytes)
    // bytes_len must agree with the string length -- catches any silent
    // NUL-truncation or other byte-loss introduced by the bytes_to_str
    // conversion path itself (would otherwise mask a real corruption).
    cki(label + "_bytes_len_matches_str_len", bytes_len(got_bytes), len(got))
    let escaped = my_escape(text)
    let expected = build_expected(escaped)
    cks(label + "_full_bytes", got, expected)

    // Also re-verify xref internally on this independently-built string:
    // startxref value must equal the byte offset of the literal "N 0 obj"
    // for every object, re-derived from `got` directly (string search, not
    // arithmetic), for extra cross-checking independent of the arithmetic
    // path above.
    let j = 1
    while j <= 5
        let needle = str(j) + " 0 obj"
        let first_pos = find(got, needle)
        ckt(label + "_obj_" + str(j) + "_found", first_pos >= 0)
        j = j + 1

fn main()
    // Case 1: simple short ASCII text.
    check_case("hi", "Hi")

    // Case 2: empty text (degenerate edge case).
    check_case("empty", "")

    // Case 3: text with all three special chars, adjacent and repeated.
    check_case("special", "((a\\b))((c\\d))")

    // Case 4: long text (>256 bytes) to stress multi-hundred-byte offsets
    // (still < 10^10, but exercises the length arithmetic at real scale).
    let long_text = ""
    let k = 0
    while k < 40
        long_text = long_text + "0123456789"
        k = k + 1
    ckt("long_text_len_400", len(long_text) == 400)
    check_case("long", long_text)

    // Case 5: text that is only backslashes (worst case for escape doubling).
    check_case("backslashes", "\\\\\\\\\\")

    // Case 6: text containing a raw embedded newline byte -- PDF spec (7.3.4.2)
    // permits a literal EOL inside a string literal without escaping (it is
    // interpreted as LF), so the module is not required to escape it. Just
    // confirm no crash and the structure/xref stays internally consistent
    // (full exact-byte comparison still applies).
    check_case("embedded_newline", "line1\nline2")

    print("PASS _pdf_adversarial_test")
