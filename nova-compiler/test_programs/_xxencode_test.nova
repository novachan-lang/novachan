// KAT test for std/encoding/xxencode
// Tests: round-trip for empty / "Cat" / "hello world" / 7-byte sequence,
//        empty encode == "", 3-NUL-bytes encode == "++++",
//        alphabet spot-checks (value 0->'+', value 1->'-', value 12->'A').

import std/encoding/xxencode

// ── Helper: build a bytes value from a string's ASCII ordinals ─────────────

fn _bytes(s) -> any
    let b = bytes(0)
    let i = 0
    let n = len(s)
    while i < n
        b = bytes_append(b, ord(s[i]))
        i = i + 1
    b

// ── Helper: build a bytes value from a list of ints ───────────────────────

fn _bytes_from_list(lst) -> any
    let b = bytes(0)
    let i = 0
    let n = len(lst)
    while i < n
        b = bytes_append(b, lst[i])
        i = i + 1
    b

// ── Helper: compare two bytes values byte-by-byte ────────────────────────

fn _bytes_eq(a, b) -> int
    let la = bytes_len(a)
    let lb = bytes_len(b)
    if la != lb
        return 0
    let i = 0
    let ok = 1
    while i < la
        let va = bytes_get(a, i) & 0xFF
        let vb = bytes_get(b, i) & 0xFF
        if va != vb
            ok = 0
        i = i + 1
    ok

// ── KAT 1: xx_encode of empty bytes == "" ─────────────────────────────────

let empty_b = bytes(0)
let enc_empty = xx_encode(empty_b)
if enc_empty != ""
    print("FAIL KAT1: xx_encode(empty) expected '' got '" + enc_empty + "'")
    exit(1)

// ── KAT 2: 3 NUL bytes -> "++++", i.e. all 6-bit groups = 0 -> alphabet[0]='+' ──

let nul3 = bytes(0)
nul3 = bytes_append(nul3, 0)
nul3 = bytes_append(nul3, 0)
nul3 = bytes_append(nul3, 0)
let enc_nul3 = xx_encode(nul3)
if enc_nul3 != "++++"
    print("FAIL KAT2: xx_encode(3 NULs) expected '++++ ' got '" + enc_nul3 + "'")
    exit(1)

// ── KAT 3: round-trip for "Cat" ───────────────────────────────────────────

let cat_b = _bytes("Cat")
let rt_cat = xx_decode(xx_encode(cat_b))
if _bytes_eq(cat_b, rt_cat) != 1
    print("FAIL KAT3: round-trip of 'Cat' failed")
    exit(1)

// ── KAT 4: round-trip for "hello world" ──────────────────────────────────

let hw_b = _bytes("hello world")
let rt_hw = xx_decode(xx_encode(hw_b))
if _bytes_eq(hw_b, rt_hw) != 1
    print("FAIL KAT4: round-trip of 'hello world' failed")
    exit(1)

// ── KAT 5: round-trip for a 7-byte binary sequence ───────────────────────
// Bytes: [0x01, 0x23, 0x45, 0x67, 0x89, 0xAB, 0xCD]

let seven_list = [1, 35, 69, 103, 137, 171, 205]
let seven_b = _bytes_from_list(seven_list)
let rt_seven = xx_decode(xx_encode(seven_b))
if _bytes_eq(seven_b, rt_seven) != 1
    print("FAIL KAT5: round-trip of 7-byte sequence failed")
    exit(1)

// ── KAT 6: alphabet spot-check — alphabet[0]='+', alphabet[1]='-', alphabet[12]='A' ──
// Encode 3 bytes that produce known 6-bit groups:
//   To get 6-bit group = 0 ('+'), group = 1 ('-'), group = 0 ('+'), group = 12 ('A'):
//   24-bit value = (0<<18)|(1<<12)|(0<<6)|12 = 0x001000|0x00000C = 0x00100C = 4108
//   bytes: b0=(4108>>16)&0xFF=0, b1=(4108>>8)&0xFF=16, b2=4108&0xFF=12
//   So bytes [0, 16, 12] should encode to "+-+A"

let spot_lst = [0, 16, 12]
let spot_b = _bytes_from_list(spot_lst)
let spot_enc = xx_encode(spot_b)
if spot_enc != "+-+A"
    print("FAIL KAT6: alphabet spot-check, expected '+-+A' got '" + spot_enc + "'")
    exit(1)

// ── KAT 7: round-trip of single byte ─────────────────────────────────────
// Single byte 0xFF -> 2 chars; decode must recover exactly 1 byte = 0xFF.

let one_b = bytes(0)
one_b = bytes_append(one_b, 255)
let rt_one = xx_decode(xx_encode(one_b))
if _bytes_eq(one_b, rt_one) != 1
    print("FAIL KAT7: round-trip of single byte 0xFF failed")
    exit(1)

// ── KAT 8: round-trip of two bytes ──────────────────────────────────────
// Two bytes [0xDE, 0xAD] -> 3 chars; decode must recover exactly 2 bytes.

let two_lst = [222, 173]
let two_b = _bytes_from_list(two_lst)
let rt_two = xx_decode(xx_encode(two_b))
if _bytes_eq(two_b, rt_two) != 1
    print("FAIL KAT8: round-trip of two bytes 0xDE 0xAD failed")
    exit(1)

print("_xxencode_test passed")
