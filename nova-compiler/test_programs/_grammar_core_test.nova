import std/grammar/grammar_core

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn ckb(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + got + " expected " + expected)
        exit(1)

fn ckl(label, got, expected)
    if len(got) != len(expected)
        print("FAIL " + label + ": length " + str(len(got)) + " != " + str(len(expected)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != expected[i]
            print("FAIL " + label + "[" + str(i) + "]: " + got[i] + " != " + expected[i])
            exit(1)
        i = i + 1

fn main()
    // Build prods: S -> a S b | epsilon
    let prod1 = []
    let rhs1 = []
    push(rhs1, "a")
    push(rhs1, "S")
    push(rhs1, "b")
    push(prod1, "S")
    push(prod1, rhs1)

    let prod2 = []
    let rhs2 = []
    push(prod2, "S")
    push(prod2, rhs2)

    let prods = []
    push(prods, prod1)
    push(prods, prod2)

    // KAT 1: grc_is_nonterminal
    cki("is_nt_S", grammar_core.grc_is_nonterminal("S"), 1)
    cki("is_nt_a", grammar_core.grc_is_nonterminal("a"), 0)
    cki("is_nt_id", grammar_core.grc_is_nonterminal("id"), 0)
    cki("is_nt_Z", grammar_core.grc_is_nonterminal("Z"), 1)

    // KAT 2: grc_is_terminal
    cki("is_t_a", grammar_core.grc_is_terminal("a"), 1)
    cki("is_t_S", grammar_core.grc_is_terminal("S"), 0)
    cki("is_t_id", grammar_core.grc_is_terminal("id"), 1)

    // KAT 3: grc_nonterminals — should be ["S"]
    let nts = grammar_core.grc_nonterminals(prods)
    let exp_nts = []
    push(exp_nts, "S")
    ckl("nonterminals", nts, exp_nts)

    // KAT 4: grc_terminals — should be ["a","b"]
    let terms = grammar_core.grc_terminals(prods)
    let exp_terms = []
    push(exp_terms, "a")
    push(exp_terms, "b")
    ckl("terminals", terms, exp_terms)

    // KAT 5: grc_alt_count
    cki("alt_count_S", grammar_core.grc_alt_count(prods, "S"), 2)
    cki("alt_count_A", grammar_core.grc_alt_count(prods, "A"), 0)

    // KAT 6: grc_productions_for — should return 2 rhs lists: ["a","S","b"] and []
    let alts = grammar_core.grc_productions_for(prods, "S")
    cki("alts_len", len(alts), 2)
    let alt0 = alts[0]
    let exp_alt0 = []
    push(exp_alt0, "a")
    push(exp_alt0, "S")
    push(exp_alt0, "b")
    ckl("alt0", alt0, exp_alt0)
    let alt1 = alts[1]
    let exp_alt1 = []
    ckl("alt1_epsilon", alt1, exp_alt1)

    // KAT 7: grc_symbols — should be ["S","a","b"] sorted
    let syms = grammar_core.grc_symbols(prods)
    let exp_syms = []
    push(exp_syms, "S")
    push(exp_syms, "a")
    push(exp_syms, "b")
    ckl("symbols", syms, exp_syms)

    // KAT 8: multi-terminal grammar
    let prod3 = []
    let rhs3 = []
    push(rhs3, "c")
    push(prod3, "A")
    push(prod3, rhs3)
    let prods2 = []
    push(prods2, prod3)
    let terms2 = grammar_core.grc_terminals(prods2)
    let exp_terms2 = []
    push(exp_terms2, "c")
    ckl("terminals2", terms2, exp_terms2)

    print("PASS _grammar_core_test")
