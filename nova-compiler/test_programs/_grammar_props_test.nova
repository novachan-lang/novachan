// KAT for std/grammar/grammar_props
import std/grammar/grammar_props

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL grammar_props " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL grammar_props " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL grammar_props " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn main()
    // =========================================================
    // KAT 1: grp_is_cnf — S->AB, A->a, B->b  ==> true
    // =========================================================
    let cnf_prods = []
    let rhs_AB = []
    rhs_AB.push("A")
    rhs_AB.push("B")
    cnf_prods.push(["S", rhs_AB])
    let rhs_a = []
    rhs_a.push("a")
    cnf_prods.push(["A", rhs_a])
    let rhs_b = []
    rhs_b.push("b")
    cnf_prods.push(["B", rhs_b])

    ckb("cnf_true", grp_is_cnf(cnf_prods), true)

    // =========================================================
    // KAT 2: grp_is_cnf — S->aSb|epsilon  ==> false (len=3 and eps)
    // =========================================================
    let not_cnf = []
    let rhs_aSb = []
    rhs_aSb.push("a")
    rhs_aSb.push("S")
    rhs_aSb.push("b")
    not_cnf.push(["S", rhs_aSb])
    let rhs_eps = []
    not_cnf.push(["S", rhs_eps])

    ckb("cnf_false", grp_is_cnf(not_cnf), false)

    // =========================================================
    // KAT 3: grp_is_epsilon_free — S->a,B->b: no epsilon => true
    // =========================================================
    ckb("eps_free_true", grp_is_epsilon_free(cnf_prods, "S"), true)

    // KAT 4: S->aSb|eps => grp_is_epsilon_free(prods,"S") is true
    // (eps allowed for start symbol)
    ckb("eps_free_start", grp_is_epsilon_free(not_cnf, "S"), true)

    // KAT 5: grammar with A->[] where A is not start => epsilon_free false
    let ef_prods = []
    let rhs_sa = []
    rhs_sa.push("a")
    ef_prods.push(["S", rhs_sa])
    let rhs_Aeps = []
    ef_prods.push(["A", rhs_Aeps])
    ckb("eps_free_false", grp_is_epsilon_free(ef_prods, "S"), false)

    // =========================================================
    // KAT 6: grp_is_gnf — A->aB, B->b  ==> true
    // =========================================================
    let gnf_prods = []
    let rhs_aB = []
    rhs_aB.push("a")
    rhs_aB.push("B")
    gnf_prods.push(["A", rhs_aB])
    let rhs_b2 = []
    rhs_b2.push("b")
    gnf_prods.push(["B", rhs_b2])

    ckb("gnf_true", grp_is_gnf(gnf_prods), true)

    // KAT 7: S->AB is not GNF (starts with NT).
    ckb("gnf_false", grp_is_gnf(cnf_prods), false)

    // =========================================================
    // KAT 8: grp_chomsky_type — S->aS|b is regular (type 3)
    // =========================================================
    let reg_prods = []
    let rhs_aS = []
    rhs_aS.push("a")
    rhs_aS.push("S")
    reg_prods.push(["S", rhs_aS])
    let rhs_b3 = []
    rhs_b3.push("b")
    reg_prods.push(["S", rhs_b3])

    cki("type3", grp_chomsky_type(reg_prods), 3)

    // KAT 9: S->aSb|eps is CF but not regular (type 2)
    cki("type2", grp_chomsky_type(not_cnf), 2)

    // =========================================================
    // KAT 10: grp_symbol_counts — S->AB, A->a, B->b
    // NTs: S,A,B (3); Terminals: a,b (2)
    // =========================================================
    let sc = grp_symbol_counts(cnf_prods)
    cki("nt_count", sc[0], 3)
    cki("t_count", sc[1], 2)

    // =========================================================
    // KAT 11: grp_is_ambiguous_upto — E->E"+"E|"id" is ambiguous (up to len 5)
    // "id"+"id"+"id" has 2 parse trees under this grammar.
    // =========================================================
    let amb_prods = []
    let rhs_EpE = []
    rhs_EpE.push("E")
    rhs_EpE.push("+")
    rhs_EpE.push("E")
    amb_prods.push(["E", rhs_EpE])
    let rhs_id = []
    rhs_id.push("id")
    amb_prods.push(["E", rhs_id])

    ckb("amb_true", grp_is_ambiguous_upto(amb_prods, "E", 5), true)

    // =========================================================
    // KAT 12: grp_is_ambiguous_upto — S->aSb|epsilon is unambiguous up to len 6
    // (the Dyck language a^n b^n is unambiguous — unique parse for each string)
    // =========================================================
    ckb("unamb_false", grp_is_ambiguous_upto(not_cnf, "S", 6), false)

    // =========================================================
    // KAT 13: chomsky_type for left-linear grammar S->Sa|b => 3
    // =========================================================
    let ll_prods = []
    let rhs_Sa = []
    rhs_Sa.push("S")
    rhs_Sa.push("a")
    ll_prods.push(["S", rhs_Sa])
    let rhs_b4 = []
    rhs_b4.push("b")
    ll_prods.push(["S", rhs_b4])

    cki("ll_type3", grp_chomsky_type(ll_prods), 3)

    // =========================================================
    // KAT 14: symbol_counts for single production S->a
    // NTs: S (1), Terminals: a (1)
    // =========================================================
    let sp = []
    let rhs_sa2 = []
    rhs_sa2.push("a")
    sp.push(["S", rhs_sa2])
    let sc2 = grp_symbol_counts(sp)
    cki("single_nt", sc2[0], 1)
    cki("single_t", sc2[1], 1)

    // =========================================================
    // KAT 15: unambiguous grammar S->AB, A->a, B->b (each string parsed 1 way)
    // =========================================================
    ckb("cnf_unamb", grp_is_ambiguous_upto(cnf_prods, "S", 4), false)

    print("PASS _grammar_props_test")
