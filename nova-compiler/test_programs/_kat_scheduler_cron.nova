import forge_scheduler_cron

fn main()
    let sc = sc_new()
    sc = sc_add_job(sc, "backup", 60)
    sc = sc_add_job(sc, "healthcheck", 30)
    assert(sc_job_count(sc) == 2, "2 jobs")

    let r1 = sc_tick(sc, 0)
    sc = unwrap(r1)
    assert(sc_total_runs(sc) == 0, "none ran at t=0")

    let r2 = sc_tick(sc, 29)
    sc = unwrap(r2)
    assert(sc_total_runs(sc) == 0, "no new runs at t=29")

    let r3 = sc_tick(sc, 30)
    sc = unwrap(r3)
    assert(sc_total_runs(sc) == 1, "healthcheck at t=30")

    let rc1 = sc_run_count(sc, "healthcheck")
    assert(unwrap(rc1) == 1, "healthcheck ran 1")

    let r4 = sc_tick(sc, 60)
    sc = unwrap(r4)
    assert(sc_total_runs(sc) == 3, "both at t=60")

    let d1 = sc_disable(sc, "backup")
    sc = unwrap(d1)
    let r5 = sc_tick(sc, 120)
    sc = unwrap(r5)
    let rc3 = sc_run_count(sc, "backup")
    assert(unwrap(rc3) == 1, "backup still 1 after disable")

    let e1 = sc_enable(sc, "backup")
    sc = unwrap(e1)
    let en = sc_is_enabled(sc, "backup")
    assert(unwrap(en) == 1, "re-enabled")

    let bad = sc_run_count(sc, "nope")
    assert(is_err(bad), "unknown job")

    print("SCHEDULER-CRON KAT PASS")
