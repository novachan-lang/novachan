import std/game/word_search

fn main()
    // Grid:
    //   "CAT"
    //   "XOX"
    //   "DOG"
    let grid = []
    push(grid, "CAT")
    push(grid, "XOX")
    push(grid, "DOG")

    // Test 1: word_search(grid,"CAT") == true (horizontal right, row 0 col 0 dir 0)
    let r1 = word_search(grid, "CAT")
    if r1 != 1
        print("FAIL word_search CAT_horiz: got " + str(r1) + " want 1")
        exit(1)

    // Test 2: word_search_pos(grid,"CAT") -> [0,0,0]
    let p2 = word_search_pos(grid, "CAT")
    if p2[0] != 0 or p2[1] != 0 or p2[2] != 0
        print("FAIL word_search_pos CAT: got [" + str(p2[0]) + "," + str(p2[1]) + "," + str(p2[2]) + "] want [0,0,0]")
        exit(1)

    // Test 3: vertical word "COG" — col 2: C(0,2), O(1,?) no... let's check actual grid
    // grid[0]="CAT": C=0,A=1,T=2
    // grid[1]="XOX": X=0,O=1,X=2
    // grid[2]="DOG": D=0,O=1,G=2
    // Vertical down col 1: A,O,O -> "AOO" not helpful
    // Vertical down col 0: C,X,D -> "CXD"
    // Let's find "XOX" horizontally at row 1
    let r3 = word_search(grid, "XOX")
    if r3 != 1
        print("FAIL word_search XOX_horiz: got " + str(r3) + " want 1")
        exit(1)

    // Test 4: "DOG" horizontal at row 2
    let r4 = word_search(grid, "DOG")
    if r4 != 1
        print("FAIL word_search DOG_horiz: got " + str(r4) + " want 1")
        exit(1)

    // Test 5: missing word -> false
    let r5 = word_search(grid, "FOX")
    if r5 != 0
        print("FAIL word_search FOX_missing: got " + str(r5) + " want 0")
        exit(1)

    // Test 6: word_search_pos for missing word -> [-1,-1,-1]
    let p6 = word_search_pos(grid, "FOX")
    if p6[0] != -1 or p6[1] != -1 or p6[2] != -1
        print("FAIL word_search_pos FOX: got [" + str(p6[0]) + "," + str(p6[1]) + "," + str(p6[2]) + "] want [-1,-1,-1]")
        exit(1)

    // Test 7: diagonal word — build a grid with a diagonal
    // Grid:
    //   "ABC"
    //   "XBX"
    //   "XXC"
    // "ABC" diagonal down-right from (0,0): A(0,0) B(1,1) C(2,2) dir=4
    let dg = []
    push(dg, "ABC")
    push(dg, "XBX")
    push(dg, "XXC")
    let r7 = word_search(dg, "ABC")
    if r7 != 1
        print("FAIL word_search ABC_diagonal: got " + str(r7) + " want 1")
        exit(1)
    let p7 = word_search_pos(dg, "ABC")
    // Should find horizontal "ABC" at [0,0,0] first (right before diagonal)
    // dir 0 = right, so it finds [0,0,0]
    if p7[0] != 0 or p7[1] != 0
        print("FAIL word_search_pos ABC_diag pos: got [" + str(p7[0]) + "," + str(p7[1]) + "] want [0,0]")
        exit(1)

    // Test 8: vertical word — grid with vertical word
    // Grid:
    //   "AXX"
    //   "BXX"
    //   "CXX"
    // "ABC" vertical down from (0,0) dir=2
    let vg = []
    push(vg, "AXX")
    push(vg, "BXX")
    push(vg, "CXX")
    let r8 = word_search(vg, "ABC")
    if r8 != 1
        print("FAIL word_search ABC_vertical: got " + str(r8) + " want 1")
        exit(1)
    let p8 = word_search_pos(vg, "ABC")
    // vertical at (0,0) dir=2
    if p8[0] != 0 or p8[1] != 0 or p8[2] != 2
        print("FAIL word_search_pos ABC_vertical: got [" + str(p8[0]) + "," + str(p8[1]) + "," + str(p8[2]) + "] want [0,0,2]")
        exit(1)

    // Test 9: reverse (left direction) — "TAC" from (0,2) dir=1
    let r9 = word_search(grid, "TAC")
    if r9 != 1
        print("FAIL word_search TAC_reverse: got " + str(r9) + " want 1")
        exit(1)
    let p9 = word_search_pos(grid, "TAC")
    if p9[0] != 0 or p9[1] != 2 or p9[2] != 1
        print("FAIL word_search_pos TAC: got [" + str(p9[0]) + "," + str(p9[1]) + "," + str(p9[2]) + "] want [0,2,1]")
        exit(1)

    // Test 10: single char word
    let r10 = word_search(grid, "O")
    if r10 != 1
        print("FAIL word_search single_O: got " + str(r10) + " want 1")
        exit(1)

    print("PASS _word_search_test")
