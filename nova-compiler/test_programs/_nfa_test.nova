// KAT for std/automata/nfa
// Tests: NFA for (a|b)*abb (4-state, no epsilon), epsilon-only path.
// All expected values hand-computed from textbook subset construction.
import std/automata/nfa

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got " + got + " want " + want)
        exit(1)

fn main()
    // ── Build NFA for (a|b)*abb ──────────────────────────────────────────────
    // States: q0 (start), q1, q2, q3 (accept)
    // q0 -a-> q0  (loop)
    // q0 -b-> q0  (loop)
    // q0 -a-> q1  (branch into suffix)
    // q1 -b-> q2
    // q2 -b-> q3
    let m = nfa_new("q0")
    nfa_add(m, "q0", "a", "q0")
    nfa_add(m, "q0", "b", "q0")
    nfa_add(m, "q0", "a", "q1")
    nfa_add(m, "q1", "b", "q2")
    nfa_add(m, "q2", "b", "q3")
    nfa_set_accept(m, "q3")

    // KAT 1: "abb" accepted — shortest match
    let r1 = nfa_accept(m, "abb")
    if r1 == true
        cki("abb-accept", 1, 1)
    if r1 == false
        cki("abb-accept", 0, 1)

    // KAT 2: "aabb" accepted — extra 'a' before abb
    let r2 = nfa_accept(m, "aabb")
    if r2 == true
        cki("aabb-accept", 1, 1)
    if r2 == false
        cki("aabb-accept", 0, 1)

    // KAT 3: "babb" accepted — 'b' prefix then abb
    let r3 = nfa_accept(m, "babb")
    if r3 == true
        cki("babb-accept", 1, 1)
    if r3 == false
        cki("babb-accept", 0, 1)

    // KAT 4: "ab" rejected — incomplete suffix
    let r4 = nfa_accept(m, "ab")
    if r4 == false
        cki("ab-reject", 0, 0)
    if r4 == true
        cki("ab-reject", 1, 0)

    // KAT 5: "abba" rejected — extra 'a' after abb
    let r5 = nfa_accept(m, "abba")
    if r5 == false
        cki("abba-reject", 0, 0)
    if r5 == true
        cki("abba-reject", 1, 0)

    // ── KAT 6: epsilon-only path ─────────────────────────────────────────────
    // NFA m2: start "s0" -eps-> "q1" (accept).
    // The epsilon-closure of {s0} already includes q1 which is accepting,
    // so the empty string "" is accepted.
    let m2 = nfa_new("s0")
    nfa_add(m2, "s0", "", "q1")
    nfa_set_accept(m2, "q1")

    let r6 = nfa_accept(m2, "")
    if r6 == true
        cki("eps-empty-accept", 1, 1)
    if r6 == false
        cki("eps-empty-accept", 0, 1)

    // ── KAT 7: epsilon chain, non-empty input rejected ───────────────────────
    // Same m2: "a" should be rejected since q1 has no outgoing transitions.
    let r7 = nfa_accept(m2, "a")
    if r7 == false
        cki("eps-a-reject", 0, 0)
    if r7 == true
        cki("eps-a-reject", 1, 0)

    // ── KAT 8: empty string on (a|b)*abb NFA — rejected ─────────────────────
    // The only accepting state is q3; start is q0 (not accepting).
    let r8 = nfa_accept(m, "")
    if r8 == false
        cki("abb-nfa-empty-reject", 0, 0)
    if r8 == true
        cki("abb-nfa-empty-reject", 1, 0)

    print("_nfa_test passed")
