// Forge crypto: ChaCha20 stream cipher, gated against the RFC 8439 Sec 2.3.2 keystream-block KAT
// (encrypting a 64-byte zero block yields the keystream). Socketless, deterministic.
import forge_crypto

fn _zeros(n: int) -> list
    let o = []
    let i = 0
    while i < n
        push(o, 0)
        i = i + 1
    o

fn main()
    let key = hex_to_blist("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
    let nonce = hex_to_blist("000000090000004a00000000")
    // keystream = chacha20 over a 64-byte zero block at counter 1
    let ks = chacha20(key, nonce, 1, _zeros(64))
    let want = "10f1e7e4d13b5915500fdd1fa32071c4c7d1f4c733c068030422aa9ac3d46c4ed2826446079faa0914c2d705d98b02a2b5129cd1de164eb9cbd083e8a2503c4e"
    if hex_of(ks) != want
        print("FAIL: ChaCha20 block KAT -> " + hex_of(ks))
        exit(1)

    // self-inverse: re-running over the ciphertext recovers the input
    let pt = hex_to_blist("00112233445566778899aabbccddeeff")
    let ct = chacha20(key, nonce, 1, pt)
    if hex_of(chacha20(key, nonce, 1, ct)) != hex_of(pt)
        print("FAIL: ChaCha20 round-trip")
        exit(1)

    print("PASS forge_crypto_chacha (RFC 8439 ChaCha20 block KAT + round-trip)")
