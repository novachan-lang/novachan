import std/framing/delimiter

// ── Helpers ──────────────────────────────────────────────────────────────────

fn list_eq(a, b) -> bool
    let na = len(a)
    let nb = len(b)
    if na != nb
        return false
    let i = 0
    while i < na
        if (a[i] & 0xFF) != (b[i] & 0xFF)
            return false
        i = i + 1
    true

fn assert_list(label: string, got, want)
    if not list_eq(got, want)
        let gs = "len=" + str(len(got))
        let ws = "len=" + str(len(want))
        print("FAIL delimiter " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn assert_int(label: string, got: int, want: int)
    if got != want
        print("FAIL delimiter " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn assert_bool(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL delimiter " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn main()
    // ── KAT 1: delim_frames([1,2,0,3,4,0,5], 0) == [[1,2],[3,4],[5]] ─────────
    let s1 = []
    push(s1, 1)
    push(s1, 2)
    push(s1, 0)
    push(s1, 3)
    push(s1, 4)
    push(s1, 0)
    push(s1, 5)
    let r1 = delim_frames(s1, 0)
    assert_int("split3 count", len(r1), 3)
    let w1a = []
    push(w1a, 1)
    push(w1a, 2)
    assert_list("split3[0]", r1[0], w1a)
    let w1b = []
    push(w1b, 3)
    push(w1b, 4)
    assert_list("split3[1]", r1[1], w1b)
    let w1c = []
    push(w1c, 5)
    assert_list("split3[2]", r1[2], w1c)

    // ── KAT 2: delim_frames([1,2,0], 0) == [[1,2]] — trailing delimiter dropped
    let s2 = []
    push(s2, 1)
    push(s2, 2)
    push(s2, 0)
    let r2 = delim_frames(s2, 0)
    assert_int("trailing delim count", len(r2), 1)
    let w2 = []
    push(w2, 1)
    push(w2, 2)
    assert_list("trailing delim[0]", r2[0], w2)

    // ── KAT 3: delim_append([1,2], 0) == [1,2,0] ─────────────────────────────
    let f3 = []
    push(f3, 1)
    push(f3, 2)
    let r3 = delim_append(f3, 0)
    let w3 = []
    push(w3, 1)
    push(w3, 2)
    push(w3, 0)
    assert_list("append", r3, w3)

    // ── KAT 4: delim_count([1,0,2,0,3], 0) == 2 ─────────────────────────────
    let s4 = []
    push(s4, 1)
    push(s4, 0)
    push(s4, 2)
    push(s4, 0)
    push(s4, 3)
    let c4 = delim_count(s4, 0)
    assert_int("count", c4, 2)

    // ── KAT 5: delim_first_frame([1,2,0,3], 0) -> frame=[1,2], rest=[3] ──────
    let s5 = []
    push(s5, 1)
    push(s5, 2)
    push(s5, 0)
    push(s5, 3)
    let r5 = delim_first_frame(s5, 0)
    let wf5 = []
    push(wf5, 1)
    push(wf5, 2)
    assert_list("first_frame frame", r5["frame"], wf5)
    let wr5 = []
    push(wr5, 3)
    assert_list("first_frame rest", r5["rest"], wr5)

    // ── KAT 6: delim_line_frames([65,10,66,10]) == [[65],[66]] ───────────────
    let s6 = []
    push(s6, 65)
    push(s6, 10)
    push(s6, 66)
    push(s6, 10)
    let r6 = delim_line_frames(s6)
    assert_int("line_frames count", len(r6), 2)
    let w6a = []
    push(w6a, 65)
    assert_list("line_frames[0]", r6[0], w6a)
    let w6b = []
    push(w6b, 66)
    assert_list("line_frames[1]", r6[1], w6b)

    // ── KAT 7: delim_frames_seq([1,2,255,254,3,4,255,254],[255,254]) == [[1,2],[3,4]]
    let s7 = []
    push(s7, 1)
    push(s7, 2)
    push(s7, 255)
    push(s7, 254)
    push(s7, 3)
    push(s7, 4)
    push(s7, 255)
    push(s7, 254)
    let seq7 = []
    push(seq7, 255)
    push(seq7, 254)
    let r7 = delim_frames_seq(s7, seq7)
    assert_int("seq split count", len(r7), 2)
    let w7a = []
    push(w7a, 1)
    push(w7a, 2)
    assert_list("seq split[0]", r7[0], w7a)
    let w7b = []
    push(w7b, 3)
    push(w7b, 4)
    assert_list("seq split[1]", r7[1], w7b)

    // ── KAT 8: delim_has_complete ────────────────────────────────────────────
    let s8a = []
    push(s8a, 1)
    push(s8a, 0)
    push(s8a, 2)
    assert_bool("has_complete true", delim_has_complete(s8a, 0), true)
    let s8b = []
    push(s8b, 1)
    push(s8b, 2)
    assert_bool("has_complete false", delim_has_complete(s8b, 0), false)

    // ── KAT 9: delim_strip_cr removes trailing 0x0D ──────────────────────────
    let f9 = []
    push(f9, 65)
    push(f9, 66)
    push(f9, 13)
    let r9 = delim_strip_cr(f9)
    let w9 = []
    push(w9, 65)
    push(w9, 66)
    assert_list("strip_cr", r9, w9)

    // ── KAT 10: delim_strip_cr on frame without CR is identity ────────────────
    let f10 = []
    push(f10, 65)
    push(f10, 66)
    let r10 = delim_strip_cr(f10)
    assert_list("strip_cr no-op", r10, f10)

    // ── KAT 11: delim_strip_cr on empty list ─────────────────────────────────
    let empty11 = []
    let r11 = delim_strip_cr(empty11)
    assert_int("strip_cr empty", len(r11), 0)

    // ── KAT 12: all-delimiter stream returns empty frames between delimiters ──
    let s12 = []
    push(s12, 0)
    push(s12, 0)
    push(s12, 0)
    let r12 = delim_frames(s12, 0)
    // Three delimiters: 2 empty frames between them + trailing empty is dropped
    // [0,0,0] -> "" | "" | "" | "" but trailing empty dropped -> 3 empty frames
    // Actually: split [0,0,0] on 0 gives ["","","",""] minus trailing = ["","",""]
    assert_int("all-delim count", len(r12), 3)
    assert_int("all-delim frame[0] len", len(r12[0]), 0)
    assert_int("all-delim frame[1] len", len(r12[1]), 0)
    assert_int("all-delim frame[2] len", len(r12[2]), 0)

    // ── KAT 13: round-trip delim_append + delim_first_frame ──────────────────
    let payload13 = []
    push(payload13, 10)
    push(payload13, 20)
    push(payload13, 30)
    let framed13 = delim_append(payload13, 0)
    let dec13 = delim_first_frame(framed13, 0)
    assert_list("rt first_frame", dec13["frame"], payload13)
    assert_int("rt rest empty", len(dec13["rest"]), 0)

    // ── KAT 14: delim_first_frame no delimiter found ─────────────────────────
    let s14 = []
    push(s14, 1)
    push(s14, 2)
    push(s14, 3)
    let dec14 = delim_first_frame(s14, 0)
    assert_list("no-delim frame", dec14["frame"], s14)
    assert_int("no-delim rest", len(dec14["rest"]), 0)

    // ── KAT 15: empty stream edge cases ──────────────────────────────────────
    let empty15 = []
    let r15 = delim_frames(empty15, 0)
    assert_int("empty stream frames", len(r15), 0)
    let r15c = delim_count(empty15, 0)
    assert_int("empty stream count", r15c, 0)
    assert_bool("empty has_complete", delim_has_complete(empty15, 0), false)

    print("PASS _delimiter_test")
