// Forge T4.4: windowed restart intensity. More than max_restarts crashes WITHIN the window = a crash
// loop (exceeded -> the supervisor gives up); the same number SPREAD over time stays under the limit
// (each ages out of the window) and keeps restarting. Pure + deterministic (fake clock). Socketless.
import forge_otp

fn main()
    // 3 restarts within a 5000ms window (now=300), max 2 -> EXCEEDED (crash loop)
    if restart_intensity_exceeded([0, 100, 200], 300, 2, 5000) == false
        print("FAIL: 3 rapid restarts in-window should exceed max 2")
        exit(1)
    // exactly max (2) in-window -> NOT exceeded
    if restart_intensity_exceeded([0, 100], 200, 2, 5000)
        print("FAIL: exactly max should not exceed")
        exit(1)
    // 3 restarts SPREAD (10s apart); at now=20000 only the 20000 stamp is within 5s -> count 1 <= 2
    if restart_intensity_exceeded([0, 10000, 20000], 20000, 2, 5000)
        print("FAIL: spread-out restarts should NOT exceed (each ages out of the window)")
        exit(1)
    // empty history -> not exceeded
    if restart_intensity_exceeded([], 1000, 2, 5000)
        print("FAIL: no restarts should not exceed")
        exit(1)
    print("PASS forge_intensity (windowed: rapid crash-loop exceeds, spread-out crashes do not)")
