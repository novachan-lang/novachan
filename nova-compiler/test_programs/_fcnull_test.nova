// 1.6 FIRST-CLASS NULL — invariants that must hold in BOTH lowering modes.
//
// The runtime already had a distinct null (NOVA_BOX_NULL + a pinned singleton oddball,
// built for the JSON value model "so bool/null survive as first-class values distinct
// from integer 0/1"). The language-level `null` literal, however, lowered to a raw 0 --
// which is why `null` and `0` were indistinguishable. NOVA_FIRSTCLASS_NULL=1 points the
// literal at nova_rt_null() instead.
//
// This test deliberately asserts ONLY what is true under both settings. It does NOT
// assert `0 == null`, because that is exactly the value the flag changes:
//     flag off -> true   (the historical bug)
//     flag on  -> false  (correct)
// Asserting either would lock in one lowering and make the migration untestable, and
// asserting the `true` case would enshrine the bug.
//
// Two runtime changes here are flag-INDEPENDENT and apply immediately:
//   * nova_rt_is_null recognises the singleton as well as raw 0 (additive: it returns
//     1 for strictly more inputs, never fewer).
//   * nova_rt_eq tests null-boxness BEFORE unboxing. That order matters: the null
//     cell's payload is 0, so unboxing first turns `null` into `0` and makes
//     `null == 0` true -- the very hole being closed.

fn main()
    let n = null
    let z = 0

    // A null equals a null, under either lowering.
    assert(n == null, "null == null")
    assert(null == null, "literal null == literal null")

    // is_null recognises both the singleton and legacy raw zero.
    assert(is_null(n), "is_null(null)")
    assert(is_null(z), "is_null(0) -- legacy raw-zero null still recognised")

    // A non-zero integer is never null, under either lowering.
    assert(not is_null(7), "is_null(7) is false")
    assert(not (7 == null), "7 != null")

    // Strings and lists are never null.
    assert(not is_null("x"), "is_null(string) is false")
    assert(not ([1, 2] == null), "list != null")

    print("FCNULL_OK")
