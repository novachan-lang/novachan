// KAT for std/parsing/jsonpath
import std/parsing/jsonpath

fn main()
    // Build test value: {"store":{"book":[{"t":"A","p":10},{"t":"B","p":20}]}}
    let book0 = {}
    book0["t"] = "A"
    book0["p"] = 10
    let book1 = {}
    book1["t"] = "B"
    book1["p"] = 20
    let books = []
    push(books, book0)
    push(books, book1)
    let store = {}
    store["book"] = books
    let v = {}
    v["store"] = store

    // KAT 1: jp_first(v, "$.store.book[0].t") == "A"
    let r1 = jp_first(v, "$.store.book[0].t")
    if r1 != "A"
        print("FAIL jsonpath kat1 first-book0-t: got "+str(r1)+" want A")
        exit(1)

    // KAT 2: jp_first(v, "$.store.book[-1].p") == 20
    let r2 = jp_first(v, "$.store.book[-1].p")
    if r2 != 20
        print("FAIL jsonpath kat2 first-book-last-p: got "+str(r2)+" want 20")
        exit(1)

    // KAT 3: jp_query(v, "$.store.book[*].t") == ["A","B"]
    let r3 = jp_query(v, "$.store.book[*].t")
    if len(r3) != 2
        print("FAIL jsonpath kat3 wildcard-t len: got "+str(len(r3))+" want 2")
        exit(1)
    if r3[0] != "A"
        print("FAIL jsonpath kat3 wildcard-t[0]: got "+str(r3[0])+" want A")
        exit(1)
    if r3[1] != "B"
        print("FAIL jsonpath kat3 wildcard-t[1]: got "+str(r3[1])+" want B")
        exit(1)

    // KAT 4: jp_query(v, "$..t") == ["A","B"] (recursive descent)
    let r4 = jp_query(v, "$..t")
    if len(r4) != 2
        print("FAIL jsonpath kat4 recursive-t len: got "+str(len(r4))+" want 2")
        exit(1)
    if r4[0] != "A"
        print("FAIL jsonpath kat4 recursive-t[0]: got "+str(r4[0])+" want A")
        exit(1)
    if r4[1] != "B"
        print("FAIL jsonpath kat4 recursive-t[1]: got "+str(r4[1])+" want B")
        exit(1)

    // KAT 5: jp_first(v, "$.store.book[1].p") == 20
    let r5 = jp_first(v, "$.store.book[1].p")
    if r5 != 20
        print("FAIL jsonpath kat5 book1-p: got "+str(r5)+" want 20")
        exit(1)

    // KAT 6: jp_first(v, "$.missing") == null
    let r6 = jp_first(v, "$.missing")
    if r6 != null
        print("FAIL jsonpath kat6 missing-key: got "+str(r6)+" want null")
        exit(1)

    // KAT 7: empty path returns []
    let r7 = jp_query(v, "")
    if len(r7) != 0
        print("FAIL jsonpath kat7 empty-path: got "+str(len(r7))+" want 0")
        exit(1)

    // KAT 8: bracket key syntax ['store'] returns dict
    let r8 = jp_first(v, "$['store']")
    if type_of(r8) != "dict"
        print("FAIL jsonpath kat8 bracket-key: got "+str(type_of(r8))+" want dict")
        exit(1)

    // KAT 9: negative index -2 on 2-element list -> first element
    let r9 = jp_first(v, "$.store.book[-2].t")
    if r9 != "A"
        print("FAIL jsonpath kat9 neg-index-2: got "+str(r9)+" want A")
        exit(1)

    // KAT 10: jp_first on missing nested path
    let r10 = jp_first(v, "$.store.shelf[0].title")
    if r10 != null
        print("FAIL jsonpath kat10 missing-nested: got "+str(r10)+" want null")
        exit(1)

    print("PASS _jsonpath_test")
