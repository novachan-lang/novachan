// KAT for std/data/jsonpath
import std/data/jsonpath

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn ckb(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // Build: root = {"a": {"b": [10, 20, {"c": 99}]}}
    let inner = {"c": 99}
    let b_list = [10, 20, inner]
    let a_dict = {"b": b_list}
    let root = {"a": a_dict}

    // Test 1: jp_get(root, "a.b.0") == 10
    let v1 = jp_get(root, "a.b.0")
    cki("get a.b.0", v1, 10)

    // Test 2: jp_get(root, "a.b.2.c") == 99
    let v2 = jp_get(root, "a.b.2.c")
    cki("get a.b.2.c", v2, 99)

    // Test 3: jp_get(root, "a.x") == null
    let v3 = jp_get(root, "a.x")
    cki("get a.x null", v3 == null, 1)

    // Test 4: jp_get(root, "a.b.9") == null (out of bounds)
    let v4 = jp_get(root, "a.b.9")
    cki("get a.b.9 oob", v4 == null, 1)

    // Test 5: jp_exists(root, "a.b.1") == true
    let e1 = jp_exists(root, "a.b.1")
    ckb("exists a.b.1", e1, 1)

    // Test 6: jp_exists(root, "a.z") == false
    let e2 = jp_exists(root, "a.z")
    ckb("exists a.z", e2, 0)

    // Test 7: jp_get_or(root, "a.z", -1) == -1
    let g1 = jp_get_or(root, "a.z", -1)
    cki("get_or a.z default", g1, -1)

    // Test 8: jp_get_or(root, "a.b.1", -1) == 20
    let g2 = jp_get_or(root, "a.b.1", -1)
    cki("get_or a.b.1 present", g2, 20)

    // Test 9: empty path returns root
    let vr = jp_get(root, "")
    cki("empty path returns root (type check)", type_of(vr) == "dict", 1)

    // Test 10: jp_keys at "a" returns ["b"]
    let ks = jp_keys(root, "a")
    cki("keys a len", len(ks), 1)
    cks("keys a[0]", ks[0], "b")

    // Test 11: jp_keys on a list path returns []
    let ks2 = jp_keys(root, "a.b")
    cki("keys a.b is empty", len(ks2), 0)

    // Test 12: jp_keys on missing path returns []
    let ks3 = jp_keys(root, "a.z")
    cki("keys a.z missing is empty", len(ks3), 0)

    // Test 13: deep value via jp_get_or
    let g3 = jp_get_or(root, "a.b.2.c", 0)
    cki("get_or deep present", g3, 99)

    print("_jsonpath_test passed")
