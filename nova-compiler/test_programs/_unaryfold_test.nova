fn neg_const() -> int
    let x = 5
    -x

fn not_const() -> int
    let x = 0
    if not x
        return 1
    return 0

fn bitnot_const() -> int
    let x = 0
    ~x

assert(neg_const() == -5, "neg constant fold")
assert(not_const() == 1, "not 0 == 1")
assert(bitnot_const() == -1, "~0 == -1")
assert(-42 == 0 - 42, "neg literal")
assert(~5 == -6, "bitnot literal")
assert(~0 == -1, "bitnot zero")
assert(~(-1) == 0, "bitnot neg one")

fn double_neg(x: int) -> int
    -(-x)

assert(double_neg(7) == 7, "double neg")
assert(double_neg(-3) == -3, "double neg negative")

print("all unary fold tests passed")
