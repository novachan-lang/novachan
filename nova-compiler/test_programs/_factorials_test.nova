import std/math/factorials

// cki — check integer equality; print FAIL + exit(1) on mismatch.
fn cki(label: string, got: int, expected: int)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn main()
    // KAT 1: fac_factorial(5) = 120
    cki("fac_factorial(5)", fac_factorial(5), 120)

    // KAT 2: fac_factorial(0) = 1  (base case / empty product)
    cki("fac_factorial(0)", fac_factorial(0), 1)

    // KAT 3: fac_factorial(1) = 1
    cki("fac_factorial(1)", fac_factorial(1), 1)

    // KAT 4: fac_factorial(10) = 3628800
    cki("fac_factorial(10)", fac_factorial(10), 3628800)

    // KAT 5: fac_double(5) = 5*3*1 = 15
    cki("fac_double(5)", fac_double(5), 15)

    // KAT 6: fac_double(6) = 6*4*2 = 48
    cki("fac_double(6)", fac_double(6), 48)

    // KAT 7: fac_double(0) = 1  (convention)
    cki("fac_double(0)", fac_double(0), 1)

    // KAT 8: fac_double(-1) = 1  (convention)
    cki("fac_double(-1)", fac_double(-1), 1)

    // KAT 9: fac_double(1) = 1
    cki("fac_double(1)", fac_double(1), 1)

    // KAT 10: fac_double(2) = 2
    cki("fac_double(2)", fac_double(2), 2)

    // KAT 11: fac_subfactorial(4) = 9
    cki("fac_subfactorial(4)", fac_subfactorial(4), 9)

    // KAT 12: fac_subfactorial(0) = 1
    cki("fac_subfactorial(0)", fac_subfactorial(0), 1)

    // KAT 13: fac_subfactorial(1) = 0
    cki("fac_subfactorial(1)", fac_subfactorial(1), 0)

    // KAT 14: fac_subfactorial(2) = 1  ((2-1)*(0+1) = 1)
    cki("fac_subfactorial(2)", fac_subfactorial(2), 1)

    // KAT 15: fac_subfactorial(3) = 2  ((3-1)*(0+1) = 2)
    cki("fac_subfactorial(3)", fac_subfactorial(3), 2)

    // KAT 16: fac_rising(5, 2) = 5*6 = 30
    cki("fac_rising(5,2)", fac_rising(5, 2), 30)

    // KAT 17: fac_rising(3, 4) = 3*4*5*6 = 360
    cki("fac_rising(3,4)", fac_rising(3, 4), 360)

    // KAT 18: fac_rising(x, 0) = 1 (empty product)
    cki("fac_rising(5,0)", fac_rising(5, 0), 1)

    // KAT 19: fac_falling(5, 2) = 5*4 = 20
    cki("fac_falling(5,2)", fac_falling(5, 2), 20)

    // KAT 20: fac_falling(6, 3) = 6*5*4 = 120
    cki("fac_falling(6,3)", fac_falling(6, 3), 120)

    // KAT 21: fac_falling(x, 0) = 1 (empty product)
    cki("fac_falling(5,0)", fac_falling(5, 0), 1)

    // KAT 22: fac_falling(5, 1) = 5
    cki("fac_falling(5,1)", fac_falling(5, 1), 5)

    print("_factorials_test passed")
