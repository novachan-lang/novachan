@comptime
fn ct_max(a: int, b: int) -> int
    if a >= b
        return a
    return b

@comptime
fn ct_min(a: int, b: int) -> int
    if a <= b
        return a
    return b

@comptime
fn ct_abs(x: int) -> int
    if x < 0
        return 0 - x
    return x

@comptime
fn ct_clamp(x: int, lo: int, hi: int) -> int
    if x < lo
        return lo
    if x > hi
        return hi
    return x

@comptime
fn ct_sum_to(n: int) -> int
    let s = 0
    let i = 1
    while i <= n
        s = s + i
        i = i + 1
    return s

@comptime
fn ct_fact(n: int) -> int
    let r = 1
    let i = 2
    while i <= n
        r = r * i
        i = i + 1
    return r

@comptime
fn ct_strlen(s: string) -> int
    return len(s)

@comptime
fn ct_upper_first(s: string) -> string
    return upper(slice(s, 0, 1)) + slice(s, 1, len(s))

fn main()
    let mx = ct_max(10, 20)
    assert(mx == 20, "ct_max")

    let mn = ct_min(10, 20)
    assert(mn == 10, "ct_min")

    let ab = ct_abs(-5)
    assert(ab == 5, "ct_abs neg")

    let ab2 = ct_abs(7)
    assert(ab2 == 7, "ct_abs pos")

    let cl = ct_clamp(15, 0, 10)
    assert(cl == 10, "clamp hi")

    let cl2 = ct_clamp(-5, 0, 10)
    assert(cl2 == 0, "clamp lo")

    let cl3 = ct_clamp(5, 0, 10)
    assert(cl3 == 5, "clamp mid")

    let s = ct_sum_to(10)
    assert(s == 55, "sum 1..10")

    let f = ct_fact(6)
    assert(f == 720, "6!")

    let sl = ct_strlen("hello")
    assert(sl == 5, "strlen")

    let uf = ct_upper_first("hello")
    assert(uf == "Hello", "upper_first")

    print("COMPTIME PHASE2 TEST PASS")
