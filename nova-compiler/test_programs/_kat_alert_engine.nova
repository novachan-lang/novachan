import forge_alert_engine

fn main()
    let ae = ae_new()
    ae = ae_add_rule(ae, "high_cpu", "cpu", "gt", 90)
    ae = ae_add_rule(ae, "low_mem", "mem", "lt", 10)
    ae = ae_add_rule(ae, "exact_err", "errors", "eq", 0)
    assert(ae_rule_count(ae) == 3, "3 rules")

    let r1 = ae_check(ae, "cpu", 50)
    ae = unwrap(r1)
    assert(ae_alert_count(ae) == 0, "no alerts for cpu=50")

    let r2 = ae_check(ae, "cpu", 95)
    ae = unwrap(r2)
    assert(ae_alert_count(ae) == 1, "1 alert for cpu=95")

    let r3 = ae_check(ae, "mem", 5)
    ae = unwrap(r3)
    assert(ae_alert_count(ae) == 2, "2 alerts total")

    let r4 = ae_check(ae, "errors", 0)
    ae = unwrap(r4)
    assert(ae_alert_count(ae) == 3, "3 alerts total")

    assert(ae_check_count(ae) == 4, "4 checks")

    let ha = ae_rule_alerts(ae, "high_cpu")
    assert(unwrap(ha) == 1, "high_cpu 1 alert")

    let la = ae_rule_alerts(ae, "low_mem")
    assert(unwrap(la) == 1, "low_mem 1 alert")

    let lt = ae_last_triggered(ae)
    assert(is_ok(lt), "last triggered ok")

    let bad = ae_rule_alerts(ae, "nope")
    assert(is_err(bad), "unknown rule")

    let rn = ae_rule_names(ae)
    assert(find(rn, "high_cpu") >= 0, "has high_cpu")

    print("ALERT-ENGINE KAT PASS")
