// KAT: std/validation/url — vurl_ URL validator
import std/validation/url

fn ckb(name: string, got: bool, want: bool)
    if got != want
        print("FAIL " + name + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(name: string, got: string, want: string)
    if got != want
        print("FAIL " + name + ": got '" + got + "' want '" + want + "'")
        exit(1)

fn main()
    // ── vurl_is_valid ──────────────────────────────────────────────────────────
    // valid URLs
    ckb("https_example_com",         vurl_is_valid("https://example.com"),                  true)
    ckb("http_localhost_port_path",  vurl_is_valid("http://localhost:8080/path"),           true)
    ckb("ftp_dotted_path",           vurl_is_valid("ftp://files.example.org/a/b"),         true)
    ckb("http_deep_path",            vurl_is_valid("http://www.google.com/search"),         true)
    ckb("https_port_only",           vurl_is_valid("https://api.example.com:443"),          true)
    // invalid URLs
    ckb("no_scheme",                 vurl_is_valid("example.com"),                          false)
    ckb("empty_authority",           vurl_is_valid("http://"),                              false)
    ckb("not_a_url",                 vurl_is_valid("notaurl"),                              false)
    ckb("bad_scheme",                vurl_is_valid("ssh://example.com"),                    false)
    ckb("host_no_dot_no_localhost",  vurl_is_valid("http://myhost"),                        false)
    ckb("port_not_digits",           vurl_is_valid("http://example.com:abc/path"),          false)

    // ── vurl_scheme ───────────────────────────────────────────────────────────
    cks("scheme_https",   vurl_scheme("https://a.com"),       "https")
    cks("scheme_http",    vurl_scheme("http://x.org/path"),   "http")
    cks("scheme_ftp",     vurl_scheme("ftp://files.net"),     "ftp")
    cks("scheme_invalid", vurl_scheme("example.com"),         "")

    // ── vurl_host ─────────────────────────────────────────────────────────────
    cks("host_no_port",        vurl_host("https://a.com"),          "a.com")
    cks("host_with_port_path", vurl_host("https://a.com:9/x"),      "a.com")
    cks("host_localhost",      vurl_host("http://localhost:8080/"),  "localhost")
    cks("host_invalid",        vurl_host("notaurl"),                 "")

    // ── vurl_is_https ─────────────────────────────────────────────────────────
    ckb("is_https_true",    vurl_is_https("https://a.com"),  true)
    ckb("is_https_false",   vurl_is_https("http://a.com"),   false)
    ckb("is_https_ftp",     vurl_is_https("ftp://a.com"),    false)
    ckb("is_https_invalid", vurl_is_https("notaurl"),        false)

    print("_vurl_test passed")
