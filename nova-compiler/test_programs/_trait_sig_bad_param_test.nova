// LOCK-3 negative: impl's PARAM type disagrees with the trait (trait other: int, impl other: string).
// MUST be rejected at compile time (E1006 incompatible method signature).
trait Comparable
    fn cmp(self, other: int) -> int

type Num : Comparable
    v: int

fn Num.cmp(other: string) -> int
    self.v

fn main()
    let n = Num(3)
    print(str(n.cmp("x")))
