import std/geometry/cg_segment_intersect

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn main()
    // cgs_on_segment
    ckb("on_seg_mid", cgs_on_segment([1,1], [0,0], [2,2]), true)
    ckb("on_seg_end", cgs_on_segment([0,0], [0,0], [2,2]), true)
    ckb("on_seg_far_end", cgs_on_segment([2,2], [0,0], [2,2]), true)
    // off the segment (collinear but outside bbox)
    ckb("on_seg_outside", cgs_on_segment([3,3], [0,0], [2,2]), false)
    // not collinear
    ckb("on_seg_not_col", cgs_on_segment([1,2], [0,0], [2,2]), false)

    // cgs_intersects: proper crossing
    ckb("intersects_cross", cgs_intersects([0,0], [2,2], [0,2], [2,0]), true)
    // cgs_proper: same case
    ckb("proper_cross", cgs_proper([0,0], [2,2], [0,2], [2,0]), true)

    // endpoint touch: [0,0]-[2,0] and [2,0]-[4,0] share point [2,0]
    ckb("intersects_endpoint", cgs_intersects([0,0], [2,0], [2,0], [4,0]), true)
    // endpoint touch is NOT proper
    ckb("proper_endpoint", cgs_proper([0,0], [2,0], [2,0], [4,0]), false)

    // collinear overlap: [0,0]-[1,1] and [2,2]-[3,3] — no overlap, separated
    ckb("intersects_col_sep", cgs_intersects([0,0], [1,1], [2,2], [3,3]), false)

    // collinear overlap: [0,0]-[2,2] and [1,1]-[3,3] — overlap at [1,1]-[2,2]
    ckb("intersects_col_overlap", cgs_intersects([0,0], [2,2], [1,1], [3,3]), true)
    // overlapping collinear segments are NOT proper
    ckb("proper_col_overlap", cgs_proper([0,0], [2,2], [1,1], [3,3]), false)

    // parallel non-collinear segments — no intersection
    ckb("intersects_parallel", cgs_intersects([0,0], [2,0], [0,1], [2,1]), false)

    // T-junction: endpoint of one on interior of other
    ckb("intersects_T", cgs_intersects([0,0], [4,0], [2,0], [2,2]), true)
    // T-junction is NOT proper (endpoint of [2,0]-[2,2] is on the other segment)
    ckb("proper_T", cgs_proper([0,0], [4,0], [2,0], [2,2]), false)

    print("PASS _cg_segment_intersect_test")
