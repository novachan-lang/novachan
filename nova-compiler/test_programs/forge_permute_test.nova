import forge_permute

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn ints(lst) -> string
    let p = []
    let i = 0
    while i < len(lst)
        push(p, str(lst[i]))
        i = i + 1
    join(p, "")

// render a list of int-permutations as "123|132|..."
fn perms_str(pp) -> string
    let parts = []
    let i = 0
    while i < len(pp)
        push(parts, ints(pp[i]))
        i = i + 1
    join(parts, "|")

fn main()
    let fails = 0

    // next_permutation steps
    fails = fails + expect("next_123", ints(next_permutation([1, 2, 3])), "132")
    fails = fails + expect("next_132", ints(next_permutation([1, 3, 2])), "213")
    fails = fails + expect("next_231", ints(next_permutation([2, 3, 1])), "312")
    // last permutation -> empty
    fails = fails + expect_true("next_last", len(next_permutation([3, 2, 1])) == 0)

    // all permutations of [1,2,3] in lex order
    fails = fails + expect("all_123", perms_str(all_permutations([1, 2, 3])), "123|132|213|231|312|321")
    fails = fails + expect("count_3", str(permutation_count([1, 2, 3])), "6")
    fails = fails + expect("count_4", str(permutation_count([1, 2, 3, 4])), "24")

    // DISTINCT permutations with duplicates: [1,1,2] -> 3 not 6
    fails = fails + expect("distinct_dup", perms_str(all_permutations([1, 1, 2])), "112|121|211")
    fails = fails + expect("distinct_count", str(permutation_count([1, 1, 2])), "3")

    // starts from sorted regardless of input order
    fails = fails + expect("from_unsorted", perms_str(all_permutations([3, 1, 2])), "123|132|213|231|312|321")

    // single element + empty
    fails = fails + expect("single", str(permutation_count([5])), "1")
    fails = fails + expect("empty", str(permutation_count([])), "0")

    // string elements (anagrams), lexicographic
    let sp = all_permutations(["a", "b", "c"])
    fails = fails + expect_true("str_count", len(sp) == 6)
    fails = fails + expect("str_first", sp[0][0] + sp[0][1] + sp[0][2], "abc")
    fails = fails + expect("str_last", sp[5][0] + sp[5][1] + sp[5][2], "cba")

    if fails == 0
        print("forge_permute: all passed")
    else
        print("forge_permute: " + str(fails) + " FAILED")
