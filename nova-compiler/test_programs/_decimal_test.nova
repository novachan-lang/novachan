// Canonical KAT test for std/numeric/decimal (BigDecimal). Adversarially-verified vectors.
import std/numeric/decimal

fn eq_s(name: string, got: string, want: string)
    if got != want
        print("FAIL " + name + ": got '" + got + "' want '" + want + "'")
        exit(1)
    print("ok " + name)

fn main()
    eq_s("0.1+0.2", dec_str(dec_add(dec("0.1"), dec("0.2"))), "0.3")
    eq_s("1.1*1.1", dec_str(dec_mul(dec("1.1"), dec("1.1"))), "1.21")
    eq_s("10-0.001", dec_str(dec_sub(dec("10"), dec("0.001"))), "9.999")
    eq_s("-1.5+0.5", dec_str(dec_add(dec("-1.5"), dec("0.5"))), "-1")
    if dec_cmp(dec("1.10"), dec("1.1")) != 0
        print("FAIL cmp trailing-zero")
        exit(1)
    print("ok cmp trailing-zero")
    eq_s("banker 2.5", dec_str(dec_round(dec("2.5"), 0, "half_even")), "2")
    eq_s("banker 3.5", dec_str(dec_round(dec("3.5"), 0, "half_even")), "4")
    eq_s("banker -2.5", dec_str(dec_round(dec("-2.5"), 0, "half_even")), "-2")
    eq_s("half_up 2.5", dec_str(dec_round(dec("2.5"), 0, "half_up")), "3")
    eq_s("1/3 @5", dec_str(dec_div(dec("1"), dec("3"), 5, "half_even")), "0.33333")
    eq_s("1.005 half_up", dec_str(dec_round(dec("1.005"), 2, "half_up")), "1.01")
    print("_decimal_test passed")
