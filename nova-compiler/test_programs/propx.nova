// propx.nova — property-based testing WITH SHRINKING, the valuable part.
//
// Finding a random counterexample to a property is easy; the hard, useful part
// is SHRINKING it to the SMALLEST input that still fails, so you get a minimal
// reproducer (x = 100) instead of whatever huge value happened to fail
// (x = 987654). This module finds a failing case, then greedily shrinks it.
//
// A property is fn(x) -> 1 if it HOLDS, 0 if it FAILS.

// ── Int shrinking: candidates closer to 0 ────────────────────────────
fn _shrink_int(x)
  let cands = []
  if x == 0
    return cands
  push(cands, 0)
  let h = x / 2
  if h != x and h != 0
    push(cands, h)
  if x > 0
    push(cands, x - 1)
  else
    push(cands, x + 1)
  cands

// Find a failing int in [lo, hi] by scanning DOWNWARD (so we find a large
// failing case, like a random generator would), then shrink it to the minimum.
// Returns {ok, failing, shrunk, steps}.
fn prop_check_int(lo, hi, samples, prop)
  let step = (hi - lo) / samples
  if step < 1
    step = 1
  let x = hi
  let failing = 0
  let found = 0
  while x >= lo and found == 0
    if prop(x) == 0
      failing = x
      found = 1
    x = x - step
  let r = {}
  if found == 0
    r["ok"] = 1
    r["failing"] = 0
    r["shrunk"] = 0
    r["steps"] = 0
    return r
  // greedy shrink: repeatedly move to the smallest-magnitude failing candidate
  let cur = failing
  let steps = 0
  let improving = 1
  while improving == 1
    improving = 0
    let cands = _shrink_int(cur)
    let next = cur
    for c in cands
      if prop(c) == 0
        if abs(c) < abs(next)
          next = c
    if next != cur
      cur = next
      improving = 1
      steps = steps + 1
  r["ok"] = 0
  r["failing"] = failing
  r["shrunk"] = cur
  r["steps"] = steps
  r

// ── List shrinking: toward the empty / shorter list ──────────────────
fn _without_index(xs, idx)
  let out = []
  let i = 0
  while i < len(xs)
    if i != idx
      push(out, xs[i])
    i = i + 1
  out

// Shrink a known-failing list to a minimal failing sublist (remove elements
// while the property still fails). prop_list(xs) -> 1 holds / 0 fails.
fn shrink_list(failing_list, prop_list)
  let cur = failing_list
  let improving = 1
  while improving == 1
    improving = 0
    let i = 0
    while i < len(cur)
      let cand = _without_index(cur, i)
      if prop_list(cand) == 0
        cur = cand
        improving = 1
        i = len(cur)
      else
        i = i + 1
  cur

// ── Tests ────────────────────────────────────────────────────────────

// Property: x < 100. Fails for x >= 100; the MINIMAL failing case is 100.
fn p_under_100(x)
  if x < 100
    return 1
  0

let r1 = prop_check_int(0, 1000, 50, fn(x) p_under_100(x))
assert(r1["ok"] == 0, "property is violated in [0,1000]")
assert(r1["failing"] >= 100, "found a large failing case by scanning down")
assert(r1["shrunk"] == 100, "shrunk to the MINIMAL failing case (100), not the large one")
assert(r1["steps"] > 0, "shrinking actually reduced the counterexample")
print("PASS: int shrink found minimal failing case 100 (from " + str(r1["failing"]) + " in " + str(r1["steps"]) + " steps)")

// Property: x <= 250 (minimal failing = 251).
fn p_le_250(x)
  if x <= 250
    return 1
  0

let r2 = prop_check_int(0, 5000, 40, fn(x) p_le_250(x))
assert(r2["shrunk"] == 251, "shrunk to 251 (minimal failing of x<=250)")
print("PASS: int shrink to 251")

// A property that always holds -> ok, no counterexample.
fn p_always(x)
  1

let r3 = prop_check_int(0, 100, 20, fn(x) p_always(x))
assert(r3["ok"] == 1, "holding property reports ok")
print("PASS: holding property")

// List shrinking: property fails when the list contains any value > 10.
// A big failing list shrinks to the single offending element.
fn p_all_small(xs)
  let i = 0
  while i < len(xs)
    if xs[i] > 10
      return 0
    i = i + 1
  1

let big_fail = [1, 2, 3, 99, 4, 5, 6, 7]
assert(p_all_small(big_fail) == 0, "the big list fails the property")
let minimal = shrink_list(big_fail, fn(xs) p_all_small(xs))
assert(len(minimal) == 1, "shrunk to a single-element list")
assert(minimal[0] == 99, "the minimal failing list is just [99]")
print("PASS: list shrink to minimal [99] from 8 elements")

print("ALL PASS: propx — property testing with shrinking")
