import forge_counter

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn joinpairs(xs: list) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + ","
        out = out + xs[i][0] + ":" + str(xs[i][1])
        i = i + 1
    out

fn main()
    let fails = 0

    let c = counter_of(["a", "b", "a", "c", "a", "b"])
    // a=3, b=2, c=1
    fails = fails + expect("total", str(counter_total(c)), "6")
    fails = fails + expect("distinct", str(counter_distinct(c)), "3")

    // top-k ranking
    fails = fails + expect("top2", joinpairs(counter_top_k(c, 2)), "a:3,b:2")
    fails = fails + expect("top_all", joinpairs(counter_top_k(c, 10)), "a:3,b:2,c:1")

    // tie-break by key ascending: two keys with count 2
    let c2 = counter_new()
    counter_add_n(c2, "z", 2)
    counter_add_n(c2, "y", 2)
    counter_add_n(c2, "x", 5)
    fails = fails + expect("top_tie", joinpairs(counter_top_k(c2, 3)), "x:5,y:2,z:2")

    // subtract
    counter_subtract(c, "a", 1)
    fails = fails + expect("subtract", str(counter_get(c, "a")), "2")
    fails = fails + expect("total_after", str(counter_total(c)), "5")

    // merge
    let m1 = counter_of(["a", "a", "b"])
    let m2 = counter_of(["b", "c", "c"])
    let merged = counter_merge(m1, m2)
    fails = fails + expect("merge_a", str(counter_get(merged, "a")), "2")
    fails = fails + expect("merge_b", str(counter_get(merged, "b")), "2")
    fails = fails + expect("merge_c", str(counter_get(merged, "c")), "2")
    fails = fails + expect("merge_total", str(counter_total(merged)), "6")

    // empty
    fails = fails + expect("empty_total", str(counter_total(counter_new())), "0")

    if fails == 0
        print("forge_counter_ext: all passed")
    else
        print("forge_counter_ext: " + str(fails) + " FAILED")
