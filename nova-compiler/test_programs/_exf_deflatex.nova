import deflatex

fn rt(s: string) -> string
    deflatex.byte_list_to_str(deflatex.inflate(deflatex.deflate(deflatex.str_to_byte_list(s))))

fn main()
    // round trips -- empty, single, repetitive (LZ77 matches), incompressible, long
    for s in ["", "a", "ab", "aaa", "hello world", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"]
        print("[" + s + "|" + rt(s) + "|" + str(rt(s) == s) + "]")
    let rep = "The quick brown fox jumps over the lazy dog. "
    let big = rep + rep + rep + rep + rep + rep + rep + rep
    print("big rt ok: " + str(rt(big) == big))
    // the COMPRESSED BYTES must be byte-identical -- this is the bit-exactness test
    print("deflate(hello world) = " + str(deflatex.deflate(deflatex.str_to_byte_list("hello world"))))
    print("deflate(aaaa)        = " + str(deflatex.deflate(deflatex.str_to_byte_list("aaaa"))))
    print("deflate(empty)       = " + str(deflatex.deflate([])))
    print("deflate(big) len     = " + str(len(deflatex.deflate(deflatex.str_to_byte_list(big)))))
    // gzip wrapper + crc
    print("gzip(hi) = " + str(deflatex.gzip_compress(deflatex.str_to_byte_list("hi"))))
    print("gzip rt  = " + str(deflatex.byte_list_to_str(deflatex.gzip_decompress(deflatex.gzip_compress(deflatex.str_to_byte_list(big)))) == big))
    print("crc32    = " + str(deflatex.gzip_crc32(deflatex.str_to_byte_list("hello world"))))
    print("EXERCISE-DONE")
