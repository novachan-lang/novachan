fn main()
    let a = "\u{41}"
    assert(a == "A", "U+0041 = A")

    let z = "\u{5A}"
    assert(z == "Z", "U+005A = Z")

    let zero = "\u{30}"
    assert(zero == "0", "U+0030 = 0")

    let space = "\u{20}"
    assert(space == " ", "U+0020 = space")

    let tab = "\u{09}"
    assert(tab == "\t", "U+0009 = tab")

    let nl = "\u{0A}"
    assert(nl == "\n", "U+000A = newline")

    let combo = "\u{48}\u{69}"
    assert(combo == "Hi", "combo Hi")

    let mixed = "Hello \u{57}orld"
    assert(mixed == "Hello World", "mixed")

    print("UNICODE ESCAPE TEST PASS")
