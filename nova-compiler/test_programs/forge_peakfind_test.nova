import forge_peakfind

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

// is arr[i] a peak (>= neighbors)?
fn is_peak_at(arr: list, i: int) -> int
    let ok = 1
    if i > 0 and arr[i - 1] > arr[i]
        ok = 0
    if i + 1 < len(arr) and arr[i + 1] > arr[i]
        ok = 0
    ok

fn main()
    let fails = 0

    // find_peak specific results
    fails = fails + expect("mtn", str(find_peak([1, 3, 5, 4, 2])), "2")
    fails = fails + expect("up", str(find_peak([1, 2, 3])), "2")
    fails = fails + expect("down", str(find_peak([3, 2, 1])), "0")
    fails = fails + expect("single", str(find_peak([5])), "0")
    fails = fails + expect("two", str(find_peak([1, 2])), "1")
    fails = fails + expect("empty", str(find_peak([])), "-1")

    // find_peak always returns a valid peak on an unsorted array (verify property over many)
    let multi = [1, 2, 1, 3, 5, 6, 4]
    fails = fails + expect("multi_valid", str(is_peak_at(multi, find_peak(multi))), "1")
    let multi2 = [10, 20, 15, 2, 23, 90, 67]
    fails = fails + expect("multi2_valid", str(is_peak_at(multi2, find_peak(multi2))), "1")

    // find_valley
    fails = fails + expect("valley", str(find_valley([5, 3, 1, 2, 4])), "2")
    fails = fails + expect("valley_down", str(find_valley([5, 4, 3])), "2")
    fails = fails + expect("valley_up", str(find_valley([1, 2, 3])), "0")

    // is_mountain
    fails = fails + expect("m1", str(is_mountain([1, 3, 2])), "true")
    fails = fails + expect("m_up", str(is_mountain([1, 2, 3])), "false")
    fails = fails + expect("m_down", str(is_mountain([3, 2, 1])), "false")
    fails = fails + expect("m_plateau", str(is_mountain([1, 3, 3, 2])), "false")
    fails = fails + expect("m_good", str(is_mountain([0, 3, 2, 1])), "true")
    fails = fails + expect("m_short", str(is_mountain([1, 2])), "false")

    // mountain_peak
    fails = fails + expect("mp_ok", str(mountain_peak([1, 3, 5, 4, 2])), "2")
    fails = fails + expect("mp_bad", str(mountain_peak([1, 2, 3])), "-1")

    if fails == 0
        print("forge_peakfind: all passed")
    else
        print("forge_peakfind: " + str(fails) + " FAILED")
