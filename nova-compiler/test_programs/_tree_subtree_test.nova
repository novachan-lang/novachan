import std/tree/tree_subtree

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(label, got, want)
    if len(got) != len(want)
        print("FAIL " + label + " (len): got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // =========================================================================
    // T5: adj=[[1,2],[0,3,4],[0],[1],[1]] n=5 root=0
    // Subtree sizes: [5,3,1,1,1]
    // =========================================================================
    let adj5 = []
    let r0 = []
    push(r0, 1)
    push(r0, 2)
    push(adj5, r0)
    let r1 = []
    push(r1, 0)
    push(r1, 3)
    push(r1, 4)
    push(adj5, r1)
    let r2 = []
    push(r2, 0)
    push(adj5, r2)
    let r3 = []
    push(r3, 1)
    push(adj5, r3)
    let r4 = []
    push(r4, 1)
    push(adj5, r4)

    let sz5 = ts_sizes(adj5, 5, 0)
    let want_sz5 = []
    push(want_sz5, 5)
    push(want_sz5, 3)
    push(want_sz5, 1)
    push(want_sz5, 1)
    push(want_sz5, 1)
    ckl("sizes_T5", sz5, want_sz5)

    // ts_size(T5,5,0,1) = 3
    cki("size_T5_node1", ts_size(adj5, 5, 0, 1), 3)

    // ts_size(T5,5,0,0) = 5
    cki("size_T5_node0", ts_size(adj5, 5, 0, 0), 5)

    // ts_size(T5,5,0,2) = 1
    cki("size_T5_node2", ts_size(adj5, 5, 0, 2), 1)

    // ts_size(T5,5,0,3) = 1
    cki("size_T5_node3", ts_size(adj5, 5, 0, 3), 1)

    // ts_sum(T5,5,0,[1,1,1,1,1]) = 5
    let vals_ones = []
    push(vals_ones, 1)
    push(vals_ones, 1)
    push(vals_ones, 1)
    push(vals_ones, 1)
    push(vals_ones, 1)
    cki("sum_T5_ones", ts_sum(adj5, 5, 0, vals_ones), 5)

    // ts_sum with values [0,2,3,4,5]: sum=0+2+3+4+5=14
    let vals_mixed = []
    push(vals_mixed, 0)
    push(vals_mixed, 2)
    push(vals_mixed, 3)
    push(vals_mixed, 4)
    push(vals_mixed, 5)
    cki("sum_T5_mixed", ts_sum(adj5, 5, 0, vals_mixed), 14)

    // =========================================================================
    // 2-node path: adj=[[1],[0]] n=2 root=0
    // Subtree sizes: [2,1]
    // =========================================================================
    let adj2 = []
    let a0 = []
    push(a0, 1)
    push(adj2, a0)
    let a1 = []
    push(a1, 0)
    push(adj2, a1)

    let sz2 = ts_sizes(adj2, 2, 0)
    let want_sz2 = []
    push(want_sz2, 2)
    push(want_sz2, 1)
    ckl("sizes_2node", sz2, want_sz2)

    cki("size_2node_0", ts_size(adj2, 2, 0, 0), 2)
    cki("size_2node_1", ts_size(adj2, 2, 0, 1), 1)

    let vals2 = []
    push(vals2, 10)
    push(vals2, 20)
    cki("sum_2node", ts_sum(adj2, 2, 0, vals2), 30)

    // =========================================================================
    // Single node: adj=[[]] n=1 root=0
    // =========================================================================
    let adj1 = []
    let n1 = []
    push(adj1, n1)

    let sz1 = ts_sizes(adj1, 1, 0)
    cki("sizes_1node_len", len(sz1), 1)
    cki("sizes_1node_0", sz1[0], 1)

    cki("size_1node", ts_size(adj1, 1, 0, 0), 1)

    let vals1 = []
    push(vals1, 42)
    cki("sum_1node", ts_sum(adj1, 1, 0, vals1), 42)

    // =========================================================================
    // Star: [[1,2,3],[0],[0],[0]] n=4 root=0
    // Subtree sizes (rooted at 0): [4,1,1,1]
    // =========================================================================
    let adj_star = []
    let sc = []
    push(sc, 1)
    push(sc, 2)
    push(sc, 3)
    push(adj_star, sc)
    let sl1 = []
    push(sl1, 0)
    push(adj_star, sl1)
    let sl2 = []
    push(sl2, 0)
    push(adj_star, sl2)
    let sl3 = []
    push(sl3, 0)
    push(adj_star, sl3)

    let sz_star = ts_sizes(adj_star, 4, 0)
    let want_sz_star = []
    push(want_sz_star, 4)
    push(want_sz_star, 1)
    push(want_sz_star, 1)
    push(want_sz_star, 1)
    ckl("sizes_star4", sz_star, want_sz_star)

    cki("size_star4_center", ts_size(adj_star, 4, 0, 0), 4)
    cki("size_star4_leaf", ts_size(adj_star, 4, 0, 1), 1)

    // ts_sum(star,[1,1,1,1]) = 4
    let vals_star = []
    push(vals_star, 1)
    push(vals_star, 1)
    push(vals_star, 1)
    push(vals_star, 1)
    cki("sum_star4_ones", ts_sum(adj_star, 4, 0, vals_star), 4)

    // =========================================================================
    // Path 0-1-2-3: adj=[[1],[0,2],[1,3],[2]] n=4 root=0
    // Subtree sizes (rooted at 0): [4,3,2,1]
    // =========================================================================
    let adj_path = []
    let pp0 = []
    push(pp0, 1)
    push(adj_path, pp0)
    let pp1 = []
    push(pp1, 0)
    push(pp1, 2)
    push(adj_path, pp1)
    let pp2 = []
    push(pp2, 1)
    push(pp2, 3)
    push(adj_path, pp2)
    let pp3 = []
    push(pp3, 2)
    push(adj_path, pp3)

    let sz_path = ts_sizes(adj_path, 4, 0)
    let want_sz_path = []
    push(want_sz_path, 4)
    push(want_sz_path, 3)
    push(want_sz_path, 2)
    push(want_sz_path, 1)
    ckl("sizes_path4", sz_path, want_sz_path)

    let vals_path = []
    push(vals_path, 1)
    push(vals_path, 2)
    push(vals_path, 3)
    push(vals_path, 4)
    cki("sum_path4", ts_sum(adj_path, 4, 0, vals_path), 10)

    print("PASS _tree_subtree_test")

main()
