// FFI MVP: call libc strlen from NOVA. NOVA fat strings are null-terminated
// (nova_rt_cstr_of returns the same pointer), so passing a NOVA string to a
// C function expecting const char* is zero-cost — no marshaling allocation.
//
// The 'unsafe' keyword wraps the FFI call: C code is outside NOVA's safety
// envelope, so calls into it are gated by unsafe (philosophically; today the
// keyword is transparent until F004 enforces it).
extern fn strlen(s: string) -> int

fn main()
    let n1 = unsafe strlen("hello")
    assert_eq(n1, 5)
    let n2 = unsafe strlen("")
    assert_eq(n2, 0)
    let n3 = unsafe strlen("the quick brown fox jumps over the lazy dog")
    assert_eq(n3, 43)
    print("ffi strlen test passed: libc strlen called from NOVA, returned correct lengths")
