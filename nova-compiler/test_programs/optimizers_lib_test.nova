import optimizers

// Each optimizer should drive params to the minimizer of f(x) = sum (x_i - target_i)^2,
// whose gradient is 2*(x_i - target_i). Convergence to the targets is the assertion.
fn _near(a: float, b: float) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < 0.01
        return 1
    0

// gradient of sum (x_i - target_i)^2
fn _grad(x: list, target: list) -> list
    let out = []
    let i = 0
    while i < len(x)
        push(out, 2.0 * (x[i] - target[i]))
        i = i + 1
    out

fn main()
    let target = [3.0]

    // SGD
    let xs = [0.0]
    let s = 0
    while s < 200
        xs = optimizers.opt_sgd(xs, _grad(xs, target), 0.1)
        s = s + 1
    assert(_near(xs[0], 3.0), "SGD -> 3")

    // Momentum
    let xm = [0.0]
    let mom = optimizers.opt_momentum_new(1)
    let sm = 0
    while sm < 300
        xm = optimizers.opt_momentum_step(mom, xm, _grad(xm, target), 0.02, 0.9)
        sm = sm + 1
    assert(_near(xm[0], 3.0), "Momentum -> 3")

    // Adam
    let xa = [0.0]
    let ad = optimizers.opt_adam_new(1)
    let sa = 0
    while sa < 3000
        xa = optimizers.opt_adam_step(ad, xa, _grad(xa, target), 0.05)
        sa = sa + 1
    assert(_near(xa[0], 3.0), "Adam -> 3")

    // 2-D target via Adam: minimize (a-1)^2 + (b+2)^2 -> (1, -2)
    let t2 = [1.0, -2.0]
    let x2 = [0.0, 0.0]
    let ad2 = optimizers.opt_adam_new(2)
    let s2 = 0
    while s2 < 4000
        x2 = optimizers.opt_adam_step(ad2, x2, _grad(x2, t2), 0.05)
        s2 = s2 + 1
    assert(_near(x2[0], 1.0), "Adam 2D a -> 1")
    assert(_near(x2[1], -2.0), "Adam 2D b -> -2")

    print("optimizers_lib_test: all passed")
