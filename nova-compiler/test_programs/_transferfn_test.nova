import std/control/transferfn

// approx — float equality within tolerance.
fn approx(a, b, tol)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < tol

fn ckf(label, got, want)
    if not approx(got, want, 0.0001)
        print("FAIL transferfn " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL transferfn " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // poly_eval: [1,2,3] at x=2 => 1*4 + 2*2 + 3 = 11
    ckf("poly_eval_11", poly_eval([1.0, 2.0, 3.0], 2.0), 11.0)
    // poly_eval at x=0 => last coeff
    ckf("poly_eval_x0", poly_eval([1.0, 2.0, 3.0], 0.0), 3.0)
    // poly_eval at x=1 => sum
    ckf("poly_eval_x1", poly_eval([1.0, 2.0, 3.0], 1.0), 6.0)

    // poly_mul: (x+1)*(x+1) = x^2 + 2x + 1 => [1, 2, 1]
    let pm = poly_mul([1.0, 1.0], [1.0, 1.0])
    cki("poly_mul_len", len(pm), 3)
    ckf("poly_mul_0", pm[0] * 1.0, 1.0)
    ckf("poly_mul_1", pm[1] * 1.0, 2.0)
    ckf("poly_mul_2", pm[2] * 1.0, 1.0)

    // tf_dcgain: num=[1], den=[1,-0.5] => sum(num)/sum(den) = 1/(1-0.5) = 2.0
    let tf1 = tf_new([1.0], [1.0, 0.0 - 0.5])
    ckf("dcgain_2", tf_dcgain(tf1), 2.0)

    // tf_order: den=[1,-0.5,0.1] => order=2
    let tf2 = tf_new([1.0], [1.0, 0.0 - 0.5, 0.1])
    cki("order_2", tf_order(tf2), 2)
    cki("order_1", tf_order(tf1), 1)

    // tf_poles_real: den=[1,-0.5] => (z - 0.5) => root = 0.5
    let poles1 = tf_poles_real(tf1)
    cki("poles_len", len(poles1), 1)
    ckf("pole_0.5", poles1[0] * 1.0, 0.5)

    // tf_is_stable_discrete: pole=0.5 => true
    cki("stable_0.5", tf_is_stable_discrete(tf1), true)

    // tf_is_stable_discrete with pole 1.5
    let tf_unstable = tf_new([1.0], [1.0, 0.0 - 1.5])
    cki("unstable_1.5", tf_is_stable_discrete(tf_unstable), false)

    // tf_eval: tf1 at z=2 => 1 / (2 - 0.5) = 1/1.5 = 0.6667
    ckf("tf_eval_z2", tf_eval(tf1, 2.0), 1.0 / 1.5)

    // tf_zeros_real: num=[1,-2] => zero at z=2
    let tf3 = tf_new([1.0, 0.0 - 2.0], [1.0])
    let zeros3 = tf_zeros_real(tf3)
    cki("zeros_len", len(zeros3), 1)
    ckf("zero_2", zeros3[0] * 1.0, 2.0)

    // tf_series DC gain = product of individual DC gains
    let tf_a = tf_new([2.0], [1.0])
    let tf_b = tf_new([3.0], [1.0])
    ckf("series_dcgain", tf_dcgain_series(tf_a, tf_b), 6.0)

    // tf_series polynomial check: num=[2]*[3]=[6], den=[1]*[1]=[1]
    let tfs = tf_series(tf_a, tf_b)
    ckf("series_dcgain_2", tf_dcgain(tfs), 6.0)

    // tf_parallel: H_a + H_b = 2/1 + 3/1 = 5 at z=1
    let tfp = tf_parallel(tf_a, tf_b)
    ckf("parallel_dcgain", tf_dcgain(tfp), 5.0)

    // tf_gain_at == tf_eval
    ckf("gain_at", tf_gain_at(tf1, 1.0), tf_dcgain(tf1))

    // poly_mul: (x+2)*(x-1) = x^2 + x - 2 => [1, 1, -2]
    let pm2 = poly_mul([1.0, 2.0], [1.0, 0.0 - 1.0])
    ckf("pm2_0", pm2[0] * 1.0, 1.0)
    ckf("pm2_1", pm2[1] * 1.0, 1.0)
    ckf("pm2_2", pm2[2] * 1.0, 0.0 - 2.0)

    print("PASS _transferfn_test")
