// KAT for std/geometry/bbox
import std/geometry/bbox

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckf(label, got, want)
    let hi = want + 0.001
    let lo = want - 0.001
    if got > hi
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)
    if got < lo
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // KAT 1-4: bb_from_points => minx=0,miny=2,maxx=4,maxy=6
    let pts = [[1,2],[4,6],[0,3]]
    let b = bb_from_points(pts)

    let mnx = b["minx"]
    cki("minx", mnx, 0)

    let mxx = b["maxx"]
    cki("maxx", mxx, 4)

    let mny = b["miny"]
    cki("miny", mny, 2)

    let mxy = b["maxy"]
    cki("maxy", mxy, 6)

    // KAT 5: bb_area = 4*4 = 16
    let area = bb_area(b)
    cki("bb_area", area, 16)

    // KAT 6: bb_width = 4
    let w = bb_width(b)
    cki("bb_width", w, 4)

    // KAT 7: bb_height = 4
    let h = bb_height(b)
    cki("bb_height", h, 4)

    // KAT 8: bb_contains interior point (2,3) => true
    let c1 = bb_contains(b, 2, 3)
    if c1 == false
        print("FAIL bb_contains(2,3): expected true")
        exit(1)

    // KAT 9: bb_contains exterior point (5,5) => false
    let c2 = bb_contains(b, 5, 5)
    if c2 == true
        print("FAIL bb_contains(5,5): expected false")
        exit(1)

    // KAT 10: bb_intersects overlapping boxes
    let b2 = bb_from_points([[0,0],[2,2]])
    let b3 = bb_from_points([[1,1],[3,3]])
    let i1 = bb_intersects(b2, b3)
    if i1 == false
        print("FAIL bb_intersects(overlap): expected true")
        exit(1)

    // KAT 11: bb_intersects disjoint boxes
    let b4 = bb_from_points([[0,0],[1,1]])
    let b5 = bb_from_points([[5,5],[6,6]])
    let i2 = bb_intersects(b4, b5)
    if i2 == true
        print("FAIL bb_intersects(disjoint): expected false")
        exit(1)

    // KAT 12: bb_union of b2 and b3 => [0,0]->[3,3]
    let u = bb_union(b2, b3)
    let umnx = u["minx"]
    let umny = u["miny"]
    let umxx = u["maxx"]
    let umxy = u["maxy"]
    cki("bb_union.minx", umnx, 0)
    cki("bb_union.miny", umny, 0)
    cki("bb_union.maxx", umxx, 3)
    cki("bb_union.maxy", umxy, 3)

    // KAT 13: bb_center of [0,0]->[4,4] => [2.0, 2.0]
    let sq = bb_from_points([[0,0],[4,4]])
    let cen = bb_center(sq)
    let cenx = cen[0]
    let ceny = cen[1]
    ckf("bb_center.x", cenx, 2.0)
    ckf("bb_center.y", ceny, 2.0)

    // KAT 14: bb_contains on boundary => true
    let cb1 = bb_contains(b, 0, 2)
    if cb1 == false
        print("FAIL bb_contains(0,2) boundary: expected true")
        exit(1)

    // KAT 15: bb_intersects touching edge => true
    let b6 = bb_from_points([[1,0],[2,1]])
    let i3 = bb_intersects(b4, b6)
    if i3 == false
        print("FAIL bb_intersects(touching): expected true")
        exit(1)

    print("_bbox_test passed")
