fn main()
  let london = [51.5074, -0.1278]
  let ny = [40.7128, -74.006]
  let la = [33.9425, -118.408]

  let points = [ny, la, london]

  let min_lat = points[0][0]
  let max_lat = points[0][0]
  print("initial min_lat = " + str(min_lat))
  print("initial max_lat = " + str(max_lat))

  for p in points
    print("  p[0] = " + str(p[0]))
    if p[0] < min_lat
      min_lat = p[0]
      print("  -> new min_lat = " + str(min_lat))
    if p[0] > max_lat
      max_lat = p[0]
      print("  -> new max_lat = " + str(max_lat))

  print("final max_lat = " + str(max_lat))
  print("50.0 = " + str(50.0))
  let cmp = max_lat > 50.0
  print("max_lat > 50.0 = " + str(cmp))

  let bb = [[min_lat], [max_lat]]
  let extracted = bb[1][0]
  print("bb[1][0] = " + str(extracted))
  let cmp2 = extracted > 50.0
  print("bb[1][0] > 50.0 = " + str(cmp2))
