// json_list_test.nova -- top-level list-of-structs JSON serialization (Path A, iter 33).
// json_stringify on a list whose elements are all one struct must emit a JSON ARRAY of the
// per-element objects (not raw pointers). Covers literal + push-built lists, scalar/empty lists
// unchanged, AND the cross-function CVE scenario (same-named list locals of DIFFERENT types in
// two functions -- proves the per-function reset of ir_list_elem_stype: a leak would serialize
// list<int> via Point__to_json -> garbage/segfault). Expected JSON escapes { } " as \{ \} \".

type Point
    x: int
    y: int

fn _cve_a()
    let items = [Point { x: 1, y: 2 }]      // records items -> Point in _cve_a's scope
    let _s = json_stringify(items)

fn _cve_b()
    let items = [10, 20, 30]                 // SAME local name, but list<int>
    let s = json_stringify(items)            // must be the int list, NOT Point-misread
    if find(s, "x") >= 0
        print("json_list_test FAILED: cross-function leak -- list<int> serialized via Point: " + s)
        exit(1)

fn main()
    // literal list-of-structs
    let a = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }]
    let ja = json_stringify(a)
    if ja != "[\{\"x\":1,\"y\":2\},\{\"x\":3,\"y\":4\}]"
        print("json_list_test FAILED literal: " + ja)
        exit(1)
    // push-built list-of-structs (the dominant real-world pattern)
    let pb = []
    push(pb, Point { x: 5, y: 6 })
    push(pb, Point { x: 7, y: 8 })
    let jpb = json_stringify(pb)
    if jpb != "[\{\"x\":5,\"y\":6\},\{\"x\":7,\"y\":8\}]"
        print("json_list_test FAILED push-built: " + jpb)
        exit(1)
    // list<scalar> must be unchanged (generic encoder, no struct misread)
    let sc = json_stringify([1, 2, 3])
    if find(sc, "x") >= 0
        print("json_list_test FAILED: scalar list mangled: " + sc)
        exit(1)
    // empty list must not crash / not be treated as structs
    let em = json_stringify([])
    if find(em, "x") >= 0
        print("json_list_test FAILED: empty list mangled: " + em)
        exit(1)
    // cross-function CVE guard: same-named list locals of different types
    _cve_a()
    _cve_b()
    print("json_list_test passed: list-of-structs serialized; no cross-function mis-specialization")
