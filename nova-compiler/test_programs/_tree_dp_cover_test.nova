import std/tree/tree_dp_cover

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn ckl(label, got, want)
    if len(got) != len(want)
        print("FAIL " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL " + label + ": at " + str(i) + " got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

// Build path 0-1-2-3 (adj for 4 nodes)
fn make_path4() -> list
    let a0 = [1]
    let a1 = [0, 2]
    let a2 = [1, 3]
    let a3 = [2]
    let adj = []
    push(adj, a0)
    push(adj, a1)
    push(adj, a2)
    push(adj, a3)
    return adj

// Build star with center 0 and leaves 1,2,3
fn make_star4() -> list
    let a0 = [1, 2, 3]
    let a1 = [0]
    let a2 = [0]
    let a3 = [0]
    let adj = []
    push(adj, a0)
    push(adj, a1)
    push(adj, a2)
    push(adj, a3)
    return adj

// Build tree with 5 nodes: 0-1, 0-2, 1-3, 1-4
fn make_tree5() -> list
    let a0 = [1, 2]
    let a1 = [0, 3, 4]
    let a2 = [0]
    let a3 = [1]
    let a4 = [1]
    let adj = []
    push(adj, a0)
    push(adj, a1)
    push(adj, a2)
    push(adj, a3)
    push(adj, a4)
    return adj

// Single edge: n=2
fn make_edge2() -> list
    let a0 = [1]
    let a1 = [0]
    let adj = []
    push(adj, a0)
    push(adj, a1)
    return adj

fn main()
    // KAT 1: path 0-1-2-3: MVC = 2 (nodes 1,2)
    let adj1 = make_path4()
    cki("mvc_path4", tv_min_vertex_cover(adj1, 4), 2)

    // KAT 2: star with center 0: MVC = 1 (just the center)
    let adj2 = make_star4()
    cki("mvc_star4", tv_min_vertex_cover(adj2, 4), 1)

    // KAT 3: tree5 (0-1,0-2,1-3,1-4): MVC = 2
    let adj3 = make_tree5()
    cki("mvc_tree5", tv_min_vertex_cover(adj3, 5), 2)

    // KAT 4: max matching on path4 = 2
    cki("mm_path4", tv_max_matching(make_path4(), 4), 2)

    // KAT 5: single edge: MVC = 1
    cki("mvc_edge2", tv_min_vertex_cover(make_edge2(), 2), 1)

    // KAT 6: max matching star4 = 1
    cki("mm_star4", tv_max_matching(make_star4(), 4), 1)

    // KAT 7: cover_set on star4 should be [0] (the center)
    let cs7 = tv_cover_set(make_star4(), 4)
    let want7 = [0]
    ckl("cover_set_star4", cs7, want7)

    // KAT 8: cover_set on path4: any valid 2-cover; nodes 1,2 are the canonical min cover
    let cs8 = tv_cover_set(make_path4(), 4)
    cki("cover_set_path4_size", len(cs8), 2)
    // Verify it IS a valid vertex cover (every edge has at least one endpoint in cover)
    // Edge 0-1: at least one of 0,1 in cs8
    let ok01 = 0
    let ok12 = 0
    let ok23 = 0
    let ki = 0
    while ki < len(cs8)
        let v = cs8[ki]
        if v == 0 or v == 1
            ok01 = 1
        if v == 1 or v == 2
            ok12 = 1
        if v == 2 or v == 3
            ok23 = 1
        ki = ki + 1
    cki("cover_path4_edge01", ok01, 1)
    cki("cover_path4_edge12", ok12, 1)
    cki("cover_path4_edge23", ok23, 1)

    // KAT 9: single node
    let adj9 = [[]]
    cki("mvc_single", tv_min_vertex_cover(adj9, 1), 0)
    cki("mm_single", tv_max_matching(adj9, 1), 0)

    print("PASS _tree_dp_cover_test")
