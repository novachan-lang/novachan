import forge_permissions

fn main()
    let pm = perm_new()

    pm = perm_grant(pm, "alice", "documents", ["read", "write"])
    pm = perm_grant(pm, "bob", "documents", ["read"])
    pm = perm_grant(pm, "admin", "documents", ["*"])

    assert(perm_check(pm, "alice", "read", "documents") == true, "alice read")
    assert(perm_check(pm, "alice", "write", "documents") == true, "alice write")
    assert(perm_check(pm, "bob", "read", "documents") == true, "bob read")
    assert(perm_check(pm, "bob", "write", "documents") == false, "bob no write")
    assert(perm_check(pm, "admin", "delete", "documents") == true, "admin wildcard")

    pm = perm_add_policy(pm, "*", "read", "public", "allow")
    assert(perm_check(pm, "anyone", "read", "public") == true, "public read")
    assert(perm_check(pm, "anyone", "write", "public") == false, "public no write")

    assert(perm_policy_count(pm) == 1, "1 policy")

    pm = perm_revoke(pm, "bob", "documents")
    assert(perm_check(pm, "bob", "read", "documents") == false, "bob revoked")

    assert(perm_check(pm, "nobody", "read", "secret") == false, "no grant no policy")

    print("PERMISSIONS KAT PASS")
