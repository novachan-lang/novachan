// MUST COMPILE CLEANLY: every form here is legitimate and must not false-positive.
import forge_orm
type Wc
    id: int
    name: string
    qty: int
fn main()
    let db = unwrap(orm_open("sqlite://_ormcol.db"))
    let e = orm_ensure(db, Wc(0, "", 0))
    if is_err(e)
        print("ensure failed")
    // 1. SELECT * -> skipped
    let a: list<Wc> = orm_all(db, "SELECT * FROM Wc", [])
    // 2. exact columns -> fine
    let b: list<Wc> = orm_all(db, "SELECT id, name, qty FROM Wc", [])
    // 3. deliberate PROJECTION (a subset) -> legal, must not error
    let c: list<Wc> = orm_all(db, "SELECT id, name FROM Wc", [])
    // 4. an extra column unlike any field -> legal (silently ignored by the mapper)
    let d: list<Wc> = orm_all(db, "SELECT id, name, qty, created_at FROM Wc", [])
    // 5. aggregate + alias -> skipped (contains '(' and a space)
    let f = orm_all(db, "SELECT count(*) AS n FROM Wc", [])
    // 6. qualified + aliased columns -> skipped (contains '.')
    let g: list<Wc> = orm_all(db, "SELECT w.id, w.name, w.qty FROM Wc w", [])
    // 7. quoted identifiers -> skipped
    let h: list<Wc> = orm_all(db, "SELECT \"id\", \"name\", \"qty\" FROM Wc", [])
    // 8. non-literal SQL (interpolated) -> not knowable, skipped
    let t = orm_table_of(db, Wc(0, "", 0))
    let i: list<Wc> = orm_all(db, "SELECT id, name, qty FROM {t}", [])
    // 9. orm_one single-struct annotation
    let j: Result<Wc> = orm_one(db, "SELECT id, name, qty FROM Wc WHERE id = ?", [1])
    // 10. a non-struct annotation must be ignored entirely
    let k: list = orm_all(db, "SELECT id, nmae FROM Wc", [])
    print("{len(a)}{len(b)}{len(c)}{len(d)}{len(f)}{len(g)}{len(h)}{len(i)}{len(k)}")
    if is_err(j)
        print("no row")
    print("_ormcol_pos compiled")

// 11. a 2-char column unlike any field -> must stay SILENT (too short to guess safely)
fn extra(db)
    let m: list<Wc> = orm_all(db, "SELECT id, name, qty, ip FROM Wc", [])
    // 12. a genuinely different long column -> not close to any field -> silent
    let n: list<Wc> = orm_all(db, "SELECT id, name, qty, description FROM Wc", [])
    print("{len(m)}{len(n)}")
