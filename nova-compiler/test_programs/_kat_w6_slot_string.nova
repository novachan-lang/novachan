// Wave-B #6 part 2: a slot holding a FRESH STRING must drop the previous value when
// rebound in a loop. The FULLRC slot-drop pass proves a slot always-OWNED + never-escaped,
// but its owned-set was make_list/dict/struct/closure + channel_create only — fresh string
// allocations were NOT in it, so `let c = "row-" + str(n)` in a loop never dropped the
// previous iteration's string.
//
// n starts >= 10000 on purpose so str(n) is a REAL allocation, not the small-int cache
// (nova_rt_int_to_str returns a static cache entry for 0<=v<10000).
fn main()
    let b0 = live_count()
    let n = 100000
    let acc = 0
    while n < 101000
        let c = "row-" + str(n)
        acc = acc + len(c)
        n = n + 1
    let d = live_count() - b0
    print("slot-rebind string delta over 1000 iters = " + str(d))

    // ESCAPE GUARD: a slot whose value ESCAPES must NOT be dropped. Here the string is
    // pushed into a list that outlives the loop, so every element must still be readable.
    let keep = []
    let m = 200000
    while m < 200005
        let s = "keep-" + str(m)
        keep.push(s)
        m = m + 1
    print("escaped still readable: " + str(keep))
    print("escaped count: " + str(len(keep)))
