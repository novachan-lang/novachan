// _chord_test.nova — KAT for std/music/chord
//
// Known-answer tests for chord construction and identification.
//
// HAND-VERIFIED VECTORS
//   C major  root=60 (C4): 60 + [0,4,7]  = [60,64,67]
//   C minor  root=60:      60 + [0,3,7]  = [60,63,67]
//   C dom7   root=60:      60 + [0,4,7,10]= [60,64,67,70]
//   dim intervals:         [0,3,6]
//
//   Inversion 1 of [60,64,67]:
//     lowest=60 -> raise to 72 -> remove 60, append 72 -> [64,67,72]
//
//   identify_chord([60,64,67]):
//     pcs = {0,4,7}; rotation root=0: intervals [0,4,7] == major -> "major"

import std/music/chord

// ── check helpers ─────────────────────────────────────────────────────────────

fn cks(label, got, want)
    if got != want
        print("FAIL chord " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL chord " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck_list(label, got, want)
    let ok = 1
    if len(got) != len(want)
        ok = 0
    else
        let i = 0
        while i < len(got)
            if got[i] != want[i]
                ok = 0
            i = i + 1
    if ok == 0
        let gs = "["
        let i = 0
        while i < len(got)
            if i > 0
                gs = gs + ","
            gs = gs + str(got[i])
            i = i + 1
        gs = gs + "]"
        let ws = "["
        let i2 = 0
        while i2 < len(want)
            if i2 > 0
                ws = ws + ","
            ws = ws + str(want[i2])
            i2 = i2 + 1
        ws = ws + "]"
        print("FAIL chord " + label + ": got=" + gs + " want=" + ws)
        exit(1)

// ── main ─────────────────────────────────────────────────────────────────────

fn main()
    // ── chord_notes ───────────────────────────────────────────────────────────

    // KAT: chord_notes(60,"major") == [60,64,67]
    let major_c = []
    push(major_c, 60)
    push(major_c, 64)
    push(major_c, 67)
    ck_list("chord_notes(60,major)", chord_notes(60, "major"), major_c)

    // KAT: chord_notes(60,"minor") == [60,63,67]
    let minor_c = []
    push(minor_c, 60)
    push(minor_c, 63)
    push(minor_c, 67)
    ck_list("chord_notes(60,minor)", chord_notes(60, "minor"), minor_c)

    // KAT: chord_notes(60,"dom7") == [60,64,67,70]
    let dom7_c = []
    push(dom7_c, 60)
    push(dom7_c, 64)
    push(dom7_c, 67)
    push(dom7_c, 70)
    ck_list("chord_notes(60,dom7)", chord_notes(60, "dom7"), dom7_c)

    // Extra: dim on D4 (note 62): 62 + [0,3,6] = [62,65,68]
    let dim_d = []
    push(dim_d, 62)
    push(dim_d, 65)
    push(dim_d, 68)
    ck_list("chord_notes(62,dim)", chord_notes(62, "dim"), dim_d)

    // Extra: aug on E4 (note 64): 64 + [0,4,8] = [64,68,72]
    let aug_e = []
    push(aug_e, 64)
    push(aug_e, 68)
    push(aug_e, 72)
    ck_list("chord_notes(64,aug)", chord_notes(64, "aug"), aug_e)

    // Extra: sus2 on G4 (note 67): 67 + [0,2,7] = [67,69,74]
    let sus2_g = []
    push(sus2_g, 67)
    push(sus2_g, 69)
    push(sus2_g, 74)
    ck_list("chord_notes(67,sus2)", chord_notes(67, "sus2"), sus2_g)

    // Extra: maj7 on C4: 60 + [0,4,7,11] = [60,64,67,71]
    let maj7_c = []
    push(maj7_c, 60)
    push(maj7_c, 64)
    push(maj7_c, 67)
    push(maj7_c, 71)
    ck_list("chord_notes(60,maj7)", chord_notes(60, "maj7"), maj7_c)

    // Extra: min7 on A4 (note 69): 69 + [0,3,7,10] = [69,72,76,79]
    let min7_a = []
    push(min7_a, 69)
    push(min7_a, 72)
    push(min7_a, 76)
    push(min7_a, 79)
    ck_list("chord_notes(69,min7)", chord_notes(69, "min7"), min7_a)

    // Unknown quality returns empty list.
    let empty_q = chord_notes(60, "unknown_xyz")
    cki("chord_notes(unknown) len", len(empty_q), 0)

    // ── chord_intervals ───────────────────────────────────────────────────────

    // KAT: chord_intervals("dim") == [0,3,6]
    let dim_ivs = []
    push(dim_ivs, 0)
    push(dim_ivs, 3)
    push(dim_ivs, 6)
    ck_list("chord_intervals(dim)", chord_intervals("dim"), dim_ivs)

    // Extra spot-checks.
    let major_ivs = []
    push(major_ivs, 0)
    push(major_ivs, 4)
    push(major_ivs, 7)
    ck_list("chord_intervals(major)", chord_intervals("major"), major_ivs)

    let min7_ivs = []
    push(min7_ivs, 0)
    push(min7_ivs, 3)
    push(min7_ivs, 7)
    push(min7_ivs, 10)
    ck_list("chord_intervals(min7)", chord_intervals("min7"), min7_ivs)

    let dim7_ivs = []
    push(dim7_ivs, 0)
    push(dim7_ivs, 3)
    push(dim7_ivs, 6)
    push(dim7_ivs, 9)
    ck_list("chord_intervals(dim7)", chord_intervals("dim7"), dim7_ivs)

    // Unknown quality returns empty list.
    let unk_ivs = chord_intervals("bogus")
    cki("chord_intervals(bogus) len", len(unk_ivs), 0)

    // ── chord_invert ──────────────────────────────────────────────────────────

    // KAT: chord_invert([60,64,67], 1) == [64,67,72]
    let c_major_notes = []
    push(c_major_notes, 60)
    push(c_major_notes, 64)
    push(c_major_notes, 67)

    let inv1_want = []
    push(inv1_want, 64)
    push(inv1_want, 67)
    push(inv1_want, 72)
    ck_list("chord_invert([60,64,67],1)", chord_invert(c_major_notes, 1), inv1_want)

    // Inversion 0 == root position (no change).
    ck_list("chord_invert([60,64,67],0)", chord_invert(c_major_notes, 0), c_major_notes)

    // Second inversion of C major: take inv1=[64,67,72], min=64 -> 76, result=[67,72,76]
    let inv2_want = []
    push(inv2_want, 67)
    push(inv2_want, 72)
    push(inv2_want, 76)
    ck_list("chord_invert([60,64,67],2)", chord_invert(c_major_notes, 2), inv2_want)

    // Third inversion of a 7th chord: dom7 C4 = [60,64,67,70]
    // inv1: min=60->72 -> [64,67,70,72]
    // inv2: min=64->76 -> [67,70,72,76]
    // inv3: min=67->79 -> [70,72,76,79]
    let dom7_notes = []
    push(dom7_notes, 60)
    push(dom7_notes, 64)
    push(dom7_notes, 67)
    push(dom7_notes, 70)

    let inv3_want = []
    push(inv3_want, 70)
    push(inv3_want, 72)
    push(inv3_want, 76)
    push(inv3_want, 79)
    ck_list("chord_invert(dom7,3)", chord_invert(dom7_notes, 3), inv3_want)

    // ── identify_chord ────────────────────────────────────────────────────────

    // KAT: identify_chord([60,64,67]) == "major"
    let id_major_in = []
    push(id_major_in, 60)
    push(id_major_in, 64)
    push(id_major_in, 67)
    cks("identify_chord(C major)", identify_chord(id_major_in), "major")

    // Minor: [60,63,67] -> "minor"
    let id_minor_in = []
    push(id_minor_in, 60)
    push(id_minor_in, 63)
    push(id_minor_in, 67)
    cks("identify_chord(C minor)", identify_chord(id_minor_in), "minor")

    // dim7: [60,63,66,69] -> "dim7"
    let id_dim7_in = []
    push(id_dim7_in, 60)
    push(id_dim7_in, 63)
    push(id_dim7_in, 66)
    push(id_dim7_in, 69)
    cks("identify_chord(dim7)", identify_chord(id_dim7_in), "dim7")

    // maj7: [60,64,67,71] -> "maj7"
    let id_maj7_in = []
    push(id_maj7_in, 60)
    push(id_maj7_in, 64)
    push(id_maj7_in, 67)
    push(id_maj7_in, 71)
    cks("identify_chord(maj7)", identify_chord(id_maj7_in), "maj7")

    // dom7: [60,64,67,70] -> "dom7"
    let id_dom7_in = []
    push(id_dom7_in, 60)
    push(id_dom7_in, 64)
    push(id_dom7_in, 67)
    push(id_dom7_in, 70)
    cks("identify_chord(dom7)", identify_chord(id_dom7_in), "dom7")

    // aug: [60,64,68] -> "aug"
    let id_aug_in = []
    push(id_aug_in, 60)
    push(id_aug_in, 64)
    push(id_aug_in, 68)
    cks("identify_chord(aug)", identify_chord(id_aug_in), "aug")

    // sus4: [60,65,67] -> "sus4"
    let id_sus4_in = []
    push(id_sus4_in, 60)
    push(id_sus4_in, 65)
    push(id_sus4_in, 67)
    cks("identify_chord(sus4)", identify_chord(id_sus4_in), "sus4")

    // Inverted chord still identifies correctly: 1st inv of C major = [64,67,72]
    // pcs = {4,7,0} sorted = {0,4,7} -> "major"
    let id_inv1_in = []
    push(id_inv1_in, 64)
    push(id_inv1_in, 67)
    push(id_inv1_in, 72)
    cks("identify_chord(C major inv1)", identify_chord(id_inv1_in), "major")

    // Unknown: only 2 notes, no chord matches
    let id_unk_in = []
    push(id_unk_in, 60)
    push(id_unk_in, 64)
    cks("identify_chord(unknown)", identify_chord(id_unk_in), "unknown")

    print("PASS _chord_test")
