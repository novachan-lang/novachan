import forge_www_authenticate

fn tf(b: bool) -> string
    if b
        return "T"
    "F"

fn main()
    let q = chr(34)
    print("bearer=" + tf(bearer_challenge("api") == "Bearer realm=" + q + "api" + q))
    let full = bearer_error("api", "invalid_token", "The access token expired", "read")
    let want = "Bearer realm=" + q + "api" + q + ", error=" + q + "invalid_token" + q + ", error_description=" + q + "The access token expired" + q + ", scope=" + q + "read" + q
    print("full=" + tf(full == want))
    // omit empty optionals: only error, no desc/scope
    let partial = bearer_error("api", "insufficient_scope", "", "")
    print("partial=" + tf(partial == "Bearer realm=" + q + "api" + q + ", error=" + q + "insufficient_scope" + q))
    print("basic=" + tf(basic_challenge("secure area") == "Basic realm=" + q + "secure area" + q))
    // escaping: realm containing a quote
    let esc = bearer_challenge("a" + q + "b")
    print("escaped=" + tf(esc == "Bearer realm=" + q + "a" + chr(92) + q + "b" + q))
