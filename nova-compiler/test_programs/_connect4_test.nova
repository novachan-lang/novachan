import std/game/connect4

fn chk_int(name: string, got: int, want: int)
    if got != want
        print("FAIL connect4 " + name + ": got " + str(got) + " want " + str(want))
        exit(1)

// Build an empty 6x7 board (42 cells, all 0).
fn empty_board() -> list
    let b = []
    let i = 0
    while i < 42
        push(b, 0)
        i = i + 1
    b

fn test_vertical_win()
    // Drop player 1 in column 0 four times -> vertical win.
    let b = empty_board()
    b = c4_drop(b, 7, 6, 0, 1)
    b = c4_drop(b, 7, 6, 0, 1)
    b = c4_drop(b, 7, 6, 0, 1)
    b = c4_drop(b, 7, 6, 0, 1)
    chk_int("vertical_win p1", c4_winner(b, 7, 6), 1)

fn test_horizontal_win()
    // Player 2 places in columns 0,1,2,3 at the same row level.
    let b = empty_board()
    b = c4_drop(b, 7, 6, 0, 2)
    b = c4_drop(b, 7, 6, 1, 2)
    b = c4_drop(b, 7, 6, 2, 2)
    b = c4_drop(b, 7, 6, 3, 2)
    chk_int("horizontal_win p2", c4_winner(b, 7, 6), 2)

fn test_no_winner()
    // Just a few pieces, no winner.
    let b = empty_board()
    b = c4_drop(b, 7, 6, 0, 1)
    b = c4_drop(b, 7, 6, 1, 2)
    b = c4_drop(b, 7, 6, 2, 1)
    chk_int("no_winner", c4_winner(b, 7, 6), 0)

fn test_full_column_noop()
    // Fill column 3 (7 pieces in a 6-row board) — the 7th drop should be a no-op.
    let b = empty_board()
    b = c4_drop(b, 7, 6, 3, 1)
    b = c4_drop(b, 7, 6, 3, 2)
    b = c4_drop(b, 7, 6, 3, 1)
    b = c4_drop(b, 7, 6, 3, 2)
    b = c4_drop(b, 7, 6, 3, 1)
    b = c4_drop(b, 7, 6, 3, 2)
    // column is now full (6 rows filled)
    // count non-zero in column 3
    let count = 0
    let r = 0
    while r < 6
        let idx = r * 7 + 3
        if b[idx] != 0
            count = count + 1
        r = r + 1
    chk_int("full_col count before", count, 6)
    // Drop one more — should be no-op (board unchanged)
    let b2 = c4_drop(b, 7, 6, 3, 1)
    let count2 = 0
    r = 0
    while r < 6
        let idx2 = r * 7 + 3
        if b2[idx2] != 0
            count2 = count2 + 1
        r = r + 1
    chk_int("full_col noop count", count2, 6)

fn test_diagonal_win()
    // Build a diagonal for player 1: cells (5,0),(4,1),(3,2),(2,3).
    // To get piece at (row,col), we stack other pieces beneath it.
    // (5,0): drop p1 col0  -> goes to row5
    // (4,1): need row4 in col1. Drop p2 col1 (goes row5), then p1 col1 (goes row4).
    // (3,2): need row3 in col2. Drop p2 x2, then p1.
    // (2,3): need row2 in col3. Drop p2 x3, then p1.
    let b = empty_board()
    // col0: p1 at row5
    b = c4_drop(b, 7, 6, 0, 1)
    // col1: p2 at row5, p1 at row4
    b = c4_drop(b, 7, 6, 1, 2)
    b = c4_drop(b, 7, 6, 1, 1)
    // col2: p2 at row5, p2 at row4, p1 at row3
    b = c4_drop(b, 7, 6, 2, 2)
    b = c4_drop(b, 7, 6, 2, 2)
    b = c4_drop(b, 7, 6, 2, 1)
    // col3: p2 x3 then p1 at row2
    b = c4_drop(b, 7, 6, 3, 2)
    b = c4_drop(b, 7, 6, 3, 2)
    b = c4_drop(b, 7, 6, 3, 2)
    b = c4_drop(b, 7, 6, 3, 1)
    chk_int("diagonal_win p1", c4_winner(b, 7, 6), 1)

fn main()
    test_vertical_win()
    test_horizontal_win()
    test_no_winner()
    test_full_column_noop()
    test_diagonal_win()
    print("PASS _connect4_test")
