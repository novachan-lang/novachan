import "std/collections/leftistheap"

// cki: check integer equality; exit(1) on mismatch.
fn cki(got, want, label)
    if got != want
        print("FAIL leftistheap " + label + ": got " + str(got) + " want " + str(want))
        exit(1)
    return 0

// ---- KAT 1: empty heap safety ----
let empty = lh_empty()
let min_empty = lh_find_min(empty)
cki(min_empty == null, 1, "find_min on null == null")
let del_empty = lh_delete_min(empty)
cki(del_empty == null, 1, "delete_min on null == null")

// ---- KAT 2: single element ----
let s1 = lh_empty()
s1 = lh_insert(s1, 42)
cki(lh_find_min(s1), 42, "single elem find_min == 42")
s1 = lh_delete_min(s1)
let after_del = lh_find_min(s1)
cki(after_del == null, 1, "single elem empty after delete")

// ---- KAT 3: six inserts -> find_min -> to_sorted ----
// Insert 5,3,8,1,9,2  ->  min==1  ->  sorted==[1,2,3,5,8,9]
let h = lh_empty()
h = lh_insert(h, 5)
h = lh_insert(h, 3)
h = lh_insert(h, 8)
h = lh_insert(h, 1)
h = lh_insert(h, 9)
h = lh_insert(h, 2)
cki(lh_find_min(h), 1, "six inserts find_min == 1")

let sorted = lh_to_sorted(h)
cki(len(sorted), 6, "to_sorted length == 6")
cki(sorted[0], 1, "sorted[0] == 1")
cki(sorted[1], 2, "sorted[1] == 2")
cki(sorted[2], 3, "sorted[2] == 3")
cki(sorted[3], 5, "sorted[3] == 5")
cki(sorted[4], 8, "sorted[4] == 8")
cki(sorted[5], 9, "sorted[5] == 9")

// ---- KAT 4: lh_merge of two heaps ----
// Heap A: [3, 7]   Heap B: [1, 5]
// Merged to_sorted == [1, 3, 5, 7]
let ha = lh_empty()
ha = lh_insert(ha, 3)
ha = lh_insert(ha, 7)
let hb = lh_empty()
hb = lh_insert(hb, 1)
hb = lh_insert(hb, 5)
let hm = lh_merge(ha, hb)
cki(lh_find_min(hm), 1, "merged find_min == 1")
let msorted = lh_to_sorted(hm)
cki(len(msorted), 4, "merged to_sorted length == 4")
cki(msorted[0], 1, "msorted[0] == 1")
cki(msorted[1], 3, "msorted[1] == 3")
cki(msorted[2], 5, "msorted[2] == 5")
cki(msorted[3], 7, "msorted[3] == 7")

// ---- KAT 5: merge with null ----
let hn = lh_empty()
hn = lh_insert(hn, 10)
let hmerge_null = lh_merge(hn, null)
cki(lh_find_min(hmerge_null), 10, "merge with null right preserves heap")
let hmerge_null2 = lh_merge(null, hn)
cki(lh_find_min(hmerge_null2), 10, "merge with null left preserves heap")

// ---- KAT 6: duplicates ----
let hd = lh_empty()
hd = lh_insert(hd, 5)
hd = lh_insert(hd, 5)
hd = lh_insert(hd, 3)
hd = lh_insert(hd, 3)
cki(lh_find_min(hd), 3, "dup find_min == 3")
let dsorted = lh_to_sorted(hd)
cki(len(dsorted), 4, "dup to_sorted length == 4")
cki(dsorted[0], 3, "dup sorted[0] == 3")
cki(dsorted[1], 3, "dup sorted[1] == 3")
cki(dsorted[2], 5, "dup sorted[2] == 5")
cki(dsorted[3], 5, "dup sorted[3] == 5")

// ---- KAT 7: sequential delete_min extracts in order ----
let hseq = lh_empty()
hseq = lh_insert(hseq, 7)
hseq = lh_insert(hseq, 2)
hseq = lh_insert(hseq, 5)
hseq = lh_insert(hseq, 1)
hseq = lh_insert(hseq, 4)
let seq1 = lh_find_min(hseq)
cki(seq1, 1, "seq del min1 == 1")
hseq = lh_delete_min(hseq)
let seq2 = lh_find_min(hseq)
cki(seq2, 2, "seq del min2 == 2")
hseq = lh_delete_min(hseq)
let seq3 = lh_find_min(hseq)
cki(seq3, 4, "seq del min3 == 4")
hseq = lh_delete_min(hseq)
let seq4 = lh_find_min(hseq)
cki(seq4, 5, "seq del min4 == 5")
hseq = lh_delete_min(hseq)
let seq5 = lh_find_min(hseq)
cki(seq5, 7, "seq del min5 == 7")
hseq = lh_delete_min(hseq)
let seq_end = lh_find_min(hseq)
cki(seq_end == null, 1, "seq exhausted -> null")

// ---- KAT 8: rank (leftist property) — after merge, root always has a right ----
// spine length == rank; verify a heap of 4 elements has rank >= 1
let hr = lh_empty()
hr = lh_insert(hr, 10)
hr = lh_insert(hr, 20)
hr = lh_insert(hr, 30)
hr = lh_insert(hr, 40)
cki(hr["rank"] >= 1, 1, "rank >= 1 for 4-elem heap")

print("PASS _leftistheap_test")
