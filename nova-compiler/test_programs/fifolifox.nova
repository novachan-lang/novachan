fn fifo_new()
  let f = {}
  f["items"] = []
  f["head"] = 0
  f

fn fifo_push(f, val)
  push(f["items"], val)

fn fifo_pop(f)
  let h = f["head"]
  if h >= len(f["items"])
    return err("empty")
  f["head"] = h + 1
  ok(f["items"][h])

fn fifo_peek(f)
  let h = f["head"]
  if h >= len(f["items"])
    return err("empty")
  ok(f["items"][h])

fn fifo_size(f)
  len(f["items"]) - f["head"]

fn fifo_is_empty(f)
  fifo_size(f) == 0

fn lifo_new()
  []

fn lifo_push(s, val)
  push(s, val)

fn lifo_pop(s)
  if len(s) == 0
    return err("empty")
  let val = s[len(s) - 1]
  ok(val)

fn lifo_size(s)
  len(s)

fn main()
  let q = fifo_new()
  assert(fifo_is_empty(q) == 1, "fifo empty")

  fifo_push(q, "a")
  fifo_push(q, "b")
  fifo_push(q, "c")
  assert(fifo_size(q) == 3, "fifo size 3")
  assert(unwrap(fifo_peek(q)) == "a", "fifo peek")
  assert(unwrap(fifo_pop(q)) == "a", "fifo pop a")
  assert(unwrap(fifo_pop(q)) == "b", "fifo pop b")
  assert(fifo_size(q) == 1, "fifo size 1")

  let s = lifo_new()
  lifo_push(s, 1)
  lifo_push(s, 2)
  lifo_push(s, 3)
  assert(lifo_size(s) == 3, "lifo size 3")
  assert(unwrap(lifo_pop(s)) == 3, "lifo pop 3")

  print("fifolifox: all passed")
