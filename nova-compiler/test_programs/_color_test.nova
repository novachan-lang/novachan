import std/util/color

// ── check helpers ─────────────────────────────────────────────────────────────

fn cks(label: str, got: str, want: str)
    if got != want
        print("FAIL " + label + ": got [" + got + "] want [" + want + "]")
        exit(1)

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckf(label: str, got: float, want: float)
    let diff = got - want
    if diff < 0.0
        diff = 0.0 - diff
    if diff > 0.01
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // ── col_rgb_to_hex ───────────────────────────────────────────────────────
    // KAT: rgb(255,0,0) -> "#ff0000"
    cks("hex_red",   col_rgb_to_hex(255, 0, 0),   "#ff0000")
    // KAT: rgb(0,128,255) -> "#0080ff"
    cks("hex_blue",  col_rgb_to_hex(0, 128, 255),  "#0080ff")
    // extra: black
    cks("hex_black", col_rgb_to_hex(0, 0, 0),      "#000000")
    // extra: white
    cks("hex_white", col_rgb_to_hex(255, 255, 255), "#ffffff")
    // extra: mid grey (128 -> 0x80)
    cks("hex_grey",  col_rgb_to_hex(128, 128, 128), "#808080")

    // ── col_hex_to_rgb ───────────────────────────────────────────────────────
    // KAT: "#00ff00" -> [0,255,0]
    let rgb_g = col_hex_to_rgb("#00ff00")
    cki("hex2rgb_g_r", rgb_g[0], 0)
    cki("hex2rgb_g_g", rgb_g[1], 255)
    cki("hex2rgb_g_b", rgb_g[2], 0)
    // KAT: "ffffff" (no #) -> [255,255,255]
    let rgb_w = col_hex_to_rgb("ffffff")
    cki("hex2rgb_w_r", rgb_w[0], 255)
    cki("hex2rgb_w_g", rgb_w[1], 255)
    cki("hex2rgb_w_b", rgb_w[2], 255)
    // extra: "#000000"
    let rgb_k = col_hex_to_rgb("#000000")
    cki("hex2rgb_k_r", rgb_k[0], 0)
    cki("hex2rgb_k_g", rgb_k[1], 0)
    cki("hex2rgb_k_b", rgb_k[2], 0)
    // extra: "#ff0000"
    let rgb_r = col_hex_to_rgb("#ff0000")
    cki("hex2rgb_r_r", rgb_r[0], 255)
    cki("hex2rgb_r_g", rgb_r[1], 0)
    cki("hex2rgb_r_b", rgb_r[2], 0)

    // ── col_rgb_to_hsl ───────────────────────────────────────────────────────
    // KAT: rgb(255,0,0) -> h~=0, s~=1.0, l~=0.5
    let hsl_red = col_rgb_to_hsl(255, 0, 0)
    ckf("hsl_red_h", hsl_red[0], 0.0)
    ckf("hsl_red_s", hsl_red[1], 1.0)
    ckf("hsl_red_l", hsl_red[2], 0.5)
    // KAT: rgb(255,255,255) -> l~=1.0
    let hsl_white = col_rgb_to_hsl(255, 255, 255)
    ckf("hsl_white_l", hsl_white[2], 1.0)
    // extra: black -> l=0.0
    let hsl_black = col_rgb_to_hsl(0, 0, 0)
    ckf("hsl_black_l", hsl_black[2], 0.0)
    // extra: green (0,255,0) -> h~=120, s~=1.0, l~=0.5
    let hsl_grn = col_rgb_to_hsl(0, 255, 0)
    ckf("hsl_grn_h", hsl_grn[0], 120.0)
    ckf("hsl_grn_s", hsl_grn[1], 1.0)
    ckf("hsl_grn_l", hsl_grn[2], 0.5)
    // extra: blue (0,0,255) -> h~=240, s~=1.0, l~=0.5
    let hsl_blu = col_rgb_to_hsl(0, 0, 255)
    ckf("hsl_blu_h", hsl_blu[0], 240.0)
    ckf("hsl_blu_s", hsl_blu[1], 1.0)
    ckf("hsl_blu_l", hsl_blu[2], 0.5)

    // ── col_hsl_to_rgb ───────────────────────────────────────────────────────
    // KAT: hsl(0, 1.0, 0.5) -> [255,0,0]
    let rgb_hsl_red = col_hsl_to_rgb(0.0, 1.0, 0.5)
    cki("hsl2rgb_red_r", rgb_hsl_red[0], 255)
    cki("hsl2rgb_red_g", rgb_hsl_red[1], 0)
    cki("hsl2rgb_red_b", rgb_hsl_red[2], 0)
    // extra: hsl(120,1.0,0.5) -> [0,255,0]
    let rgb_hsl_grn = col_hsl_to_rgb(120.0, 1.0, 0.5)
    cki("hsl2rgb_grn_r", rgb_hsl_grn[0], 0)
    cki("hsl2rgb_grn_g", rgb_hsl_grn[1], 255)
    cki("hsl2rgb_grn_b", rgb_hsl_grn[2], 0)
    // extra: hsl(0,0,1) -> white
    let rgb_hsl_wht = col_hsl_to_rgb(0.0, 0.0, 1.0)
    cki("hsl2rgb_wht_r", rgb_hsl_wht[0], 255)
    cki("hsl2rgb_wht_g", rgb_hsl_wht[1], 255)
    cki("hsl2rgb_wht_b", rgb_hsl_wht[2], 255)
    // extra: hsl(0,0,0) -> black
    let rgb_hsl_blk = col_hsl_to_rgb(0.0, 0.0, 0.0)
    cki("hsl2rgb_blk_r", rgb_hsl_blk[0], 0)
    cki("hsl2rgb_blk_g", rgb_hsl_blk[1], 0)
    cki("hsl2rgb_blk_b", rgb_hsl_blk[2], 0)

    // ── col_luminance ────────────────────────────────────────────────────────
    // KAT: luminance(0,0,0) = 0.0
    ckf("lum_black", col_luminance(0, 0, 0), 0.0)
    // extra: white -> 1.0
    ckf("lum_white", col_luminance(255, 255, 255), 1.0)
    // extra: pure red -> 0.2126
    ckf("lum_red", col_luminance(255, 0, 0), 0.2126)
    // extra: pure green -> 0.7152
    ckf("lum_green", col_luminance(0, 255, 0), 0.7152)

    print("_color_test passed")
