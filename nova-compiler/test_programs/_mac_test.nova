// _mac_test.nova — KAT for std/net/mac
// Known-answer assertions covering all six spec KATs plus extra edge cases.
import std/net/mac

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn main()
    // KAT 1: hyphen-separated uppercase -> normalized colon lowercase
    cks("parse hyphen upper", mac_parse("AA-BB-CC-DD-EE-FF"), "aa:bb:cc:dd:ee:ff")

    // KAT 2: Cisco dotted lowercase -> normalized colon lowercase
    cks("parse cisco dot", mac_parse("aabb.ccdd.eeff"), "aa:bb:cc:dd:ee:ff")

    // KAT 3: colon-separated lowercase (identity)
    cks("parse colon lower", mac_parse("aa:bb:cc:dd:ee:ff"), "aa:bb:cc:dd:ee:ff")

    // KAT 4: is_valid good
    ckb("is_valid good", mac_is_valid("AA:BB:CC:DD:EE:FF"), true)

    // KAT 5: is_valid invalid hex char 'z'
    ckb("is_valid bad hex", mac_is_valid("zz:bb:cc:dd:ee:ff"), false)

    // KAT 6: is_valid too short
    ckb("is_valid too short", mac_is_valid("aa:bb"), false)

    // KAT 7: mac_format with "-" separator
    let b = mac_bytes("aa:bb:cc:dd:ee:ff")
    cks("mac_format hyphen", mac_format(b, "-"), "aa-bb-cc-dd-ee-ff")

    // Extra: mac_bytes length
    cki("mac_bytes len", bytes_len(b), 6)

    // Extra: mac_bytes individual byte values (aa=170, bb=187, cc=204, dd=221, ee=238, ff=255)
    cki("mac_bytes[0]", bytes_get(b, 0), 170)
    cki("mac_bytes[1]", bytes_get(b, 1), 187)
    cki("mac_bytes[2]", bytes_get(b, 2), 204)
    cki("mac_bytes[3]", bytes_get(b, 3), 221)
    cki("mac_bytes[4]", bytes_get(b, 4), 238)
    cki("mac_bytes[5]", bytes_get(b, 5), 255)

    // Extra: empty string is invalid
    ckb("is_valid empty", mac_is_valid(""), false)

    // Extra: parse invalid returns ""
    cks("parse invalid", mac_parse("not-a-mac"), "")

    // Extra: mac_bytes on invalid input returns empty bytes
    let bad = mac_bytes("zz:bb:cc:dd:ee:ff")
    cki("mac_bytes invalid len", bytes_len(bad), 0)

    // Extra: mac_format with ":" separator
    let b2 = mac_bytes("AA-BB-CC-DD-EE-FF")
    cks("mac_format colon", mac_format(b2, ":"), "aa:bb:cc:dd:ee:ff")

    // Extra: mac_format on wrong-size bytes returns ""
    let tiny = bytes(0)
    cks("mac_format wrong size", mac_format(tiny, ":"), "")

    // Extra: Cisco dotted with uppercase
    cks("parse cisco dot upper", mac_parse("AABB.CCDD.EEFF"), "aa:bb:cc:dd:ee:ff")

    // Extra: hyphen separated with all zeros
    cks("parse all zeros", mac_parse("00-00-00-00-00-00"), "00:00:00:00:00:00")

    // Extra: broadcast address ff:ff:ff:ff:ff:ff
    cks("parse broadcast", mac_parse("ff:ff:ff:ff:ff:ff"), "ff:ff:ff:ff:ff:ff")

    print("_mac_test passed")
