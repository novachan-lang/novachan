import forge_backpressure

fn main()
    let bp = bp_new(100, 20)
    assert(bp_level(bp) == 0, "starts at 0")
    assert(bp_is_paused(bp) == 0, "not paused")

    bp = bp_produce(bp, 50)
    assert(bp_level(bp) == 50, "level 50")
    assert(bp_is_paused(bp) == 0, "not paused at 50")
    assert(bp_utilization(bp) == 50, "50% util")

    bp = bp_produce(bp, 60)
    assert(bp_level(bp) == 110, "level 110")
    assert(bp_is_paused(bp) == 1, "paused at 110")
    assert(bp_pause_count(bp) == 1, "1 pause")

    bp = bp_consume(bp, 50)
    assert(bp_level(bp) == 60, "level 60 after consume")
    assert(bp_is_paused(bp) == 1, "still paused at 60")

    bp = bp_consume(bp, 50)
    assert(bp_level(bp) == 10, "level 10")
    assert(bp_is_paused(bp) == 0, "resumed at 10")
    assert(bp_resume_count(bp) == 1, "1 resume")

    bp = bp_consume(bp, 999)
    assert(bp_level(bp) == 0, "floor at 0")

    print("BACKPRESSURE KAT PASS")
