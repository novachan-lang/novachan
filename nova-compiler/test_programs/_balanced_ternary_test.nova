import std/numeral/balanced_ternary

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL balanced_ternary " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL balanced_ternary " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // bt_encode KAT
    cks("encode(0)", bt_encode(0), "0")
    cks("encode(1)", bt_encode(1), "1")
    cks("encode(2)", bt_encode(2), "1T")
    cks("encode(5)", bt_encode(5), "1TT")
    cks("encode(6)", bt_encode(6), "1T0")
    cks("encode(8)", bt_encode(8), "10T")
    cks("encode(-5)", bt_encode(-5), "T11")

    // bt_decode KAT
    cki("decode('1TT')", bt_decode("1TT"), 5)
    cki("decode('T11')", bt_decode("T11"), -5)
    cki("decode('0')", bt_decode("0"), 0)
    cki("decode('1')", bt_decode("1"), 1)
    cki("decode('1T')", bt_decode("1T"), 2)
    cki("decode('1T0')", bt_decode("1T0"), 6)
    cki("decode('10T')", bt_decode("10T"), 8)

    // Round-trip: bt_decode(bt_encode(n)) == n
    cki("roundtrip(1000)", bt_decode(bt_encode(1000)), 1000)
    cki("roundtrip(-1000)", bt_decode(bt_encode(-1000)), -1000)

    // Additional round-trips covering various magnitudes
    cki("roundtrip(0)", bt_decode(bt_encode(0)), 0)
    cki("roundtrip(3)", bt_decode(bt_encode(3)), 3)
    cki("roundtrip(9)", bt_decode(bt_encode(9)), 9)
    cki("roundtrip(27)", bt_decode(bt_encode(27)), 27)
    cki("roundtrip(-1)", bt_decode(bt_encode(-1)), -1)
    cki("roundtrip(-8)", bt_decode(bt_encode(-8)), -8)
    cki("roundtrip(-100)", bt_decode(bt_encode(-100)), -100)
    cki("roundtrip(9999)", bt_decode(bt_encode(9999)), 9999)
    cki("roundtrip(-9999)", bt_decode(bt_encode(-9999)), -9999)

    // Sweep round-trip n = -50..50
    let k = -50
    while k <= 50
        cki("sweep(" + str(k) + ")", bt_decode(bt_encode(k)), k)
        k = k + 1

    print("PASS _balanced_ternary_test")
