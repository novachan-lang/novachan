import forge_metric_counter

fn main()
    let m = mc_new()
    assert(mc_counter_count(m) == 0, "starts empty")
    assert(mc_get(m, "requests") == 0, "missing = 0")

    m = mc_inc(m, "requests")
    m = mc_inc(m, "requests")
    m = mc_inc(m, "requests")
    assert(mc_get(m, "requests") == 3, "3 requests")

    m = mc_add(m, "bytes", 1024)
    m = mc_add(m, "bytes", 2048)
    assert(mc_get(m, "bytes") == 3072, "3072 bytes")

    assert(mc_counter_count(m) == 2, "2 counters")
    assert(mc_total(m) == 3075, "total 3075")

    m = mc_reset(m, "requests")
    assert(mc_get(m, "requests") == 0, "reset to 0")
    assert(mc_total(m) == 3072, "total after reset")

    print("METRIC-COUNTER KAT PASS")
