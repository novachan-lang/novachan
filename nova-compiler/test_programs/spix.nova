// spix.nova — service/provider registry (SPI), the dynamic half, the NOVA way.
//
// A registry maps a service name to MANY providers (first-class functions),
// each with a priority. Consumers DISCOVER providers by name — get them all
// (priority-ordered), or just the best — without knowing who registered them.
// This is the plugin / dependency-injection pattern (Java ServiceLoader,
// Elixir/Clojure protocols). Pure-NOVA over dicts + lists + first-class fns.
// (Future zero-ceremony layer: the genius compiler auto-collecting every trait
// impl into the table so the `impl` IS the registration — delivered here is the
// runtime registry + ordered discovery.)

fn spi_new()
  {}

fn spi_register(reg, service, provider, priority)
  if not contains(reg, service)
    reg[service] = []
  push(reg[service], [priority, provider])
  reg

fn spi_count(reg, service)
  if contains(reg, service)
    return len(reg[service])
  0

fn spi_has(reg, service)
  if spi_count(reg, service) > 0
    return 1
  0

// insertion sort a COPY of the [priority, provider] entries by priority desc.
fn _spi_sort(entries)
  let arr = []
  for e in entries
    push(arr, e)
  let i = 1
  while i < len(arr)
    let key = arr[i]
    let j = i - 1
    while j >= 0 and arr[j][0] < key[0]
      arr[j + 1] = arr[j]
      j = j - 1
    arr[j + 1] = key
    i = i + 1
  arr

// all providers for a service, highest priority first.
fn spi_providers(reg, service)
  if not contains(reg, service)
    return []
  let sorted = _spi_sort(reg[service])
  let out = []
  for e in sorted
    push(out, e[1])
  out

// the single highest-priority provider (or 0 if none).
fn spi_best(reg, service)
  let ps = spi_providers(reg, service)
  if len(ps) > 0
    return ps[0]
  0

// ── Tests ────────────────────────────────────────────────────────────

fn json_codec(x)
  "json:" + str(x)

fn xml_codec(x)
  "xml:" + str(x)

fn fast_codec(x)
  "fast:" + str(x)

let reg = spi_new()
spi_register(reg, "codec", fn(x) json_codec(x), 10)
spi_register(reg, "codec", fn(x) xml_codec(x), 5)
spi_register(reg, "codec", fn(x) fast_codec(x), 20)

assert(spi_count(reg, "codec") == 3, "3 codec providers registered")
assert(spi_has(reg, "codec") == 1, "service codec is present")
assert(spi_has(reg, "missing") == 0, "unknown service not present")
print("PASS: register + count + has")

// discover all providers, priority-ordered (fast 20 > json 10 > xml 5)
let ps = spi_providers(reg, "codec")
assert(len(ps) == 3, "3 providers discovered")
assert(ps[0](1) == "fast:1", "highest priority first (fast)")
assert(ps[1](1) == "json:1", "then json")
assert(ps[2](1) == "xml:1", "then xml")
print("PASS: priority-ordered discovery")

// best provider = highest priority
let best = spi_best(reg, "codec")
assert(best(42) == "fast:42", "best is the highest-priority provider")
print("PASS: best provider")

// a second service is independent
spi_register(reg, "logger", fn(x) "log:" + str(x), 1)
assert(spi_count(reg, "logger") == 1, "logger has 1 provider")
assert(spi_count(reg, "codec") == 3, "codec still 3 (independent)")
let lg = spi_best(reg, "logger")
assert(lg(7) == "log:7", "logger provider works")
print("PASS: independent services")

// empty discovery is safe
let none = spi_providers(reg, "nope")
assert(len(none) == 0, "unknown service -> empty list")
print("PASS: empty discovery safe")

print("ALL PASS: spix — service/provider registry with ordered discovery")
