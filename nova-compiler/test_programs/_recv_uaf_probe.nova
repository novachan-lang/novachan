// Stage-1 selective-receive UAF probe (ASAN). Unlike _recv_heap_probe (literal patterns, body never
// reads the message), here each arm BINDS the matched message to `x` and USES its content (len(x))
// in the body. The strings arrive "ccc","bb","a" but are matched a,bb,ccc -> "ccc" and "bb" are
// deferred to the save-queue (HEAP objects) and pulled by later receives. commit() must keep the
// matched-from-save message alive for the body: if remove-at freed it prematurely, len(x) reads
// freed memory -> ASAN heap-use-after-free. Pure guards (== / len) per the selective-receive contract.
fn uworker(parent)
    receive
        x if x == "a" => send_msg(parent, len(x) + 10)
    receive
        y if y == "bb" => send_msg(parent, len(y) + 10)
    receive
        z if z == "ccc" => send_msg(parent, len(z) + 10)

fn main()
    let me = self_pid()
    let w = spawn uworker(me)
    let wb = mailbox_of(w)
    send_msg(wb, "ccc")        // deferred twice, matched + READ by the 3rd receive
    send_msg(wb, "bb")         // deferred once,  matched + READ by the 2nd receive (the key UAF case)
    send_msg(wb, "a")          // matched by the 1st receive
    let r1 = recv_msg()
    assert(r1 == 11, "len(a)+10 == 11")
    let r2 = recv_msg()
    assert(r2 == 12, "len(bb)+10 == 12  (bb pulled from save-queue and READ -> must not be freed)")
    let r3 = recv_msg()
    assert(r3 == 13, "len(ccc)+10 == 13 (ccc pulled from save-queue and READ)")
    print("RECV_UAF_OK")
