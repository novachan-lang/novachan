import std/os/structpack

fn ck_int(label: string, got: int, want: int)
    if got != want
        print("FAIL structpack " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck_list_eq(label: string, got: any, want: any)
    let gn = len(got)
    let wn = len(want)
    if gn != wn
        print("FAIL structpack " + label + " length: got=" + str(gn) + " want=" + str(wn))
        exit(1)
    let i = 0
    while i < gn
        let gv = got[i]
        let wv = want[i]
        if gv != wv
            print("FAIL structpack " + label + " at index " + str(i) + ": got=" + str(gv) + " want=" + str(wv))
            exit(1)
        i = i + 1

fn main()
    // KAT: struct_pack("<HH",[1,2]) == [1,0,2,0]
    let r1 = struct_pack("<HH", [1, 2])
    let want1 = [1, 0, 2, 0]
    ck_list_eq("pack_LE_HH_1_2", r1, want1)

    // KAT: struct_pack(">H",[258]) == [1,2]
    let r2 = struct_pack(">H", [258])
    let want2 = [1, 2]
    ck_list_eq("pack_BE_H_258", r2, want2)

    // KAT: struct_unpack("<HH",[1,0,2,0]) == [1,2]
    let buf1 = [1, 0, 2, 0]
    let r3 = struct_unpack("<HH", buf1)
    let want3 = [1, 2]
    ck_list_eq("unpack_LE_HH", r3, want3)

    // KAT: struct_size("<HBI") == 7
    ck_int("size_HBI", struct_size("<HBI"), 7)

    // KAT: struct_pack("<BI",[255,1]) == [255,1,0,0,0]
    let r4 = struct_pack("<BI", [255, 1])
    let want4 = [255, 1, 0, 0, 0]
    ck_list_eq("pack_LE_BI_255_1", r4, want4)

    // Extra: struct_size("<H") == 2
    ck_int("size_H", struct_size("<H"), 2)

    // Extra: struct_size("<B") == 1
    ck_int("size_B", struct_size("<B"), 1)

    // Extra: struct_size("<I") == 4
    ck_int("size_I", struct_size("<I"), 4)

    // Extra: pack/unpack roundtrip LE for u32
    let r5 = struct_pack("<I", [16909060])
    let u5 = struct_unpack("<I", r5)
    ck_int("roundtrip_LE_I", u5[0], 16909060)

    // Extra: pack/unpack roundtrip BE for u32
    let r6 = struct_pack(">I", [16909060])
    let u6 = struct_unpack(">I", r6)
    ck_int("roundtrip_BE_I", u6[0], 16909060)

    // Extra: BE u32 pack ordering: 0x01020304 = 16909060
    // BE: [1,2,3,4]
    let r7 = struct_pack(">I", [16909060])
    let want7 = [1, 2, 3, 4]
    ck_list_eq("pack_BE_I_0x01020304", r7, want7)

    // Extra: LE u32 pack ordering: 0x01020304 in LE = [4,3,2,1]
    let r8 = struct_pack("<I", [16909060])
    let want8 = [4, 3, 2, 1]
    ck_list_eq("pack_LE_I_0x01020304", r8, want8)

    // Extra: mixed format BE HBI
    let r9 = struct_pack(">HBI", [1000, 255, 1])
    let u9 = struct_unpack(">HBI", r9)
    ck_int("roundtrip_BE_HBI_H", u9[0], 1000)
    ck_int("roundtrip_BE_HBI_B", u9[1], 255)
    ck_int("roundtrip_BE_HBI_I", u9[2], 1)

    print("PASS _structpack_test")
