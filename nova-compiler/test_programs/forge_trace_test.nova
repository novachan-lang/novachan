// Forge T8.8: parse a W3C traceparent header to continue a distributed trace. Extracts the 32-hex
// trace_id from a well-formed header; returns "" for malformed/non-hex/all-zero. Pure, deterministic.
import forge_obs

fn main()
    let valid = "00-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331-01"
    if parse_traceparent(valid) != "0af7651916cd43dd8448eb211c80319c"
        print("FAIL: valid traceparent should yield its trace_id, got " + parse_traceparent(valid))
        exit(1)
    if parse_traceparent("00-abc-01") != ""
        print("FAIL: wrong part count should be rejected")
        exit(1)
    if parse_traceparent("00-0af7651916cd43dd8448eb211c8031zz-b7ad6b7169203331-01") != ""
        print("FAIL: non-hex trace_id should be rejected")
        exit(1)
    if parse_traceparent("00-00000000000000000000000000000000-b7ad6b7169203331-01") != ""
        print("FAIL: all-zero trace_id should be rejected")
        exit(1)
    print("PASS forge_trace (parse W3C traceparent: extract trace_id; reject malformed/non-hex/all-zero)")
