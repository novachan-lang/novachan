import std/numeric/trapezoid

// Named top-level test functions.
// NOVA HOF calling convention passes float args as raw i64 bit-patterns;
// pow(x, 1.0) normalizes via nova_float_arg (bit-reinterpret) so both direct
// and HOF call paths return correct doubles.
fn fx(x) -> float
    let xf = pow(x, 1.0)
    return xf

fn fsq(x) -> float
    let xf = pow(x, 1.0)
    let v = xf * xf
    return v

fn ckf(got, want, eps, label)
    let diff = got - want
    let adiff = diff
    if diff < 0.0
        adiff = diff * -1.0
    if adiff > eps
        print("FAIL " + label + " got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // KAT 1: integral of x from 0 to 4 = 8.0  (trapezoid is EXACT for linear)
    let r1 = tz_integrate(fx, 0.0, 4.0, 100)
    ckf(r1, 8.0, 0.01, "tz_integrate(fx,0,4,100)")

    // KAT 2: integral of x^2 from 0 to 3 = 9.0  (1000 steps -> O(h^2) err < 0.01)
    let r2 = tz_integrate(fsq, 0.0, 3.0, 1000)
    ckf(r2, 9.0, 0.01, "tz_integrate(fsq,0,3,1000)")

    // KAT 3: trapezoid over points [0,1,2] / [0,1,2] = 2.0
    let xs3 = [0.0, 1.0, 2.0]
    let ys3 = [0.0, 1.0, 2.0]
    let r3 = tz_integrate_points(xs3, ys3)
    ckf(r3, 2.0, 0.01, "tz_integrate_points([0,1,2],[0,1,2])")

    // KAT 4: trapezoid over points [0,2] / [3,3] = 6.0
    let xs4 = [0.0, 2.0]
    let ys4 = [3.0, 3.0]
    let r4 = tz_integrate_points(xs4, ys4)
    ckf(r4, 6.0, 0.01, "tz_integrate_points([0,2],[3,3])")

    // KAT 5: integral of x from 1 to 3 = 4.0  (exact for linear)
    let r5 = tz_integrate(fx, 1.0, 3.0, 10)
    ckf(r5, 4.0, 0.01, "tz_integrate(fx,1,3,10)")

    // KAT 6: integral of x^2 from 0 to 1 = 1/3 ~ 0.3333
    let r6 = tz_integrate(fsq, 0.0, 1.0, 500)
    ckf(r6, 0.3333, 0.01, "tz_integrate(fsq,0,1,500)")

    print("_trapezoid_test passed")
