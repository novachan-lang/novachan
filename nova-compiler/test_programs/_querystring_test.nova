// KAT for std/net/querystring — URL query-string parse/build/get.
import std/net/querystring

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── qs_parse basic key=value pairs ───────────────────────────────────────
    let p1 = qs_parse("a=1&b=2")
    cks("parse-a", qs_get(p1, "a"), "1")
    cks("parse-b", qs_get(p1, "b"), "2")

    // ── qs_parse percent-decode %20 -> space ─────────────────────────────────
    let p2 = qs_parse("q=hello%20world")
    cks("pct20", qs_get(p2, "q"), "hello world")

    // ── qs_parse '+' -> space (form encoding) ────────────────────────────────
    let p3 = qs_parse("q=a+b")
    cks("plus-space", qs_get(p3, "q"), "a b")

    // ── qs_parse %26 -> '&' (encoded ampersand in value) ────────────────────
    let p4 = qs_parse("x=a%26b")
    cks("pct26", qs_get(p4, "x"), "a&b")

    // ── qs_build: sorted deterministic output, plain values ──────────────────
    let d1 = {}
    d1["a"] = "1"
    d1["b"] = "2"
    cks("build-plain", qs_build(d1), "a=1&b=2")

    // ── qs_build: sorting (b before a alphabetically reversed) ───────────────
    // Insert in reverse order — sort must normalise to a=1&b=2
    let d2 = {}
    d2["b"] = "2"
    d2["a"] = "1"
    cks("build-sorted", qs_build(d2), "a=1&b=2")

    // ── qs_build: space in value -> %20 ──────────────────────────────────────
    let d3 = {}
    d3["q"] = "hello world"
    cks("build-space", qs_build(d3), "q=hello%20world")

    // ── qs_build: '&' in value -> %26 ────────────────────────────────────────
    let d4 = {}
    d4["x"] = "a&b"
    cks("build-amp", qs_build(d4), "x=a%26b")

    // ── qs_get: missing key returns "" ────────────────────────────────────────
    let p5 = qs_parse("a=1")
    cks("get-missing", qs_get(p5, "z"), "")
    cks("get-present", qs_get(p5, "a"), "1")

    // ── qs_parse: empty string -> empty dict, build returns "" ───────────────
    let p6 = qs_parse("")
    cks("empty-build", qs_build(p6), "")

    // ── qs_parse: leading '?' stripped ───────────────────────────────────────
    let p7 = qs_parse("?foo=bar")
    cks("leading-q", qs_get(p7, "foo"), "bar")

    // ── qs_build: '=' in value is encoded ────────────────────────────────────
    let d5 = {}
    d5["k"] = "a=b"
    cks("build-eq", qs_build(d5), "k=a%3Db")

    // ── qs_parse: multiple params, verify all decoded correctly ──────────────
    let p8 = qs_parse("name=hello%20world&count=42&flag=a%2Bb")
    cks("multi-name", qs_get(p8, "name"), "hello world")
    cks("multi-count", qs_get(p8, "count"), "42")
    // %2B = 0x2B = 43 = '+' char
    cks("multi-flag", qs_get(p8, "flag"), "a+b")

    // ── qs_parse: value with no '=' gets empty string value ─────────────────
    let p9 = qs_parse("bare")
    cks("bare-key", qs_get(p9, "bare"), "")

    print("_querystring_test passed")
