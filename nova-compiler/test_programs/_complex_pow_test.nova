import std/complex/complex_pow

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label, got, want)
    let gs = "false"
    if got
        gs = "true"
    let ws = "false"
    if want
        ws = "true"
    if gs != ws
        print("FAIL " + label + ": got " + gs + " want " + ws)
        exit(1)

fn ckl(label, got, want)
    if got[0] != want[0]
        print("FAIL " + label + "[0]: got " + str(got[0]) + " want " + str(want[0]))
        exit(1)
    if got[1] != want[1]
        print("FAIL " + label + "[1]: got " + str(got[1]) + " want " + str(want[1]))
        exit(1)

fn main()
    // i^2 = -1
    let i2 = cxp_power([0, 1], 2)
    ckl("i^2", i2, [0 - 1, 0])

    // i^4 = 1
    let i4 = cxp_power([0, 1], 4)
    ckl("i^4", i4, [1, 0])

    // (1+i)^2 = 2i
    let p2 = cxp_power([1, 1], 2)
    ckl("(1+i)^2", p2, [0, 2])

    // 2^3 = 8
    let p3 = cxp_power([2, 0], 3)
    ckl("2^3", p3, [8, 0])

    // n=0 always [1,0]
    let p0 = cxp_power([1, 2], 0)
    ckl("z^0", p0, [1, 0])

    // (1+i)^4 = -4
    let p4 = cxp_power([1, 1], 4)
    ckl("(1+i)^4", p4, [0 - 4, 0])

    // i^2 is real
    ckb("i^2 is real", cxp_is_real_power([0, 1], 2), true)

    // i^1 is NOT real
    ckb("i^1 not real", cxp_is_real_power([0, 1], 1), false)

    // (1+i)^4 is real (= -4)
    ckb("(1+i)^4 real", cxp_is_real_power([1, 1], 4), true)

    // 5^3 = [125,0] is real
    ckb("5^3 real", cxp_is_real_power([5, 0], 3), true)

    print("PASS _complex_pow_test")
