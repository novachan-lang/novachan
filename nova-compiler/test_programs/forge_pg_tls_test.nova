// forge_pg_tls_test -- LIVE PostgreSQL over TLS (Unit 2). Drives PG's SSLRequest negotiation, and on the
// server's 'S' go-ahead upgrades the socket to TLS (SChannel/OpenSSL, sslmode=require -- encrypt, no cert
// verify) and runs the SAME startup + SCRAM auth over the encrypted transport. Connection params from the
// standard PG env vars (PGHOST/PGPORT/PGUSER/PGDATABASE/PGPASSWORD), localhost/postgres defaults. The server
// being UP is required. This gates the LIVE TLS plumbing: a structured pg: error (TLS handshake / auth /
// 'server declined TLS' when ssl=off) still proves SSLRequest + tls_upgrade + the encrypted read-loop ran
// end to end. A hang would be caught by kill-on-timeout.
import forge_pg

fn _envor(name: string, dflt: string) -> string
    let v = env(name)
    if len(v) > 0
        return v
    dflt

fn main()
    let host = _envor("PGHOST", "127.0.0.1")
    let port = parse_int(_envor("PGPORT", "5432"))
    let user = _envor("PGUSER", "postgres")
    let db = _envor("PGDATABASE", "postgres")
    let password = _envor("PGPASSWORD", "postgres")
    print("connecting (TLS) to pg " + host + ":" + str(port) + " user=" + user + " db=" + db)
    let r = pg_connect_tls(host, port, user, db, password)
    match r
        Ok(conn) =>
            print("LIVE PG/TLS CONNECT OK (SSLRequest -> TLS upgrade -> auth all over the encrypted socket)")
            let q = pg_exec(conn, "SELECT 1 AS one, 'tls'::text AS via")
            match q
                Ok(rows) =>
                    if len(rows) < 1
                        print("FAIL: SELECT returned no rows")
                        exit(1)
                    let row = rows[0]
                    print("row: one=" + row["one"] + " via=" + row["via"])
                    assert_eq(row["one"], "1")
                    assert_eq(row["via"], "tls")
                    print("LIVE PG/TLS ROUND-TRIP OK (real SELECT over an encrypted socket)")
                Err(e) =>
                    print("FAIL: query error: " + e)
                    exit(1)
            pg_close(conn)
        Err(e) =>
            // Structured outcome proves the SSLRequest + (if 'S') tls_upgrade + encrypted read-loop ran.
            // Common: "server declined TLS" (ssl=off) or "password authentication failed" (TLS worked, wrong pw).
            print("PG/TLS connect returned a structured error: " + e)
            assert(starts_with(e, "pg:"), "error is a structured pg: error (live TLS plumbing reached the server)")
            print("LIVE PG/TLS PLUMBING OK (set PGPASSWORD + server ssl=on for the full encrypted round-trip)")
    print("forge_pg_tls_test passed")
