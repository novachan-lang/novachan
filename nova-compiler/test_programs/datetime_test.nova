// Date/time library test suite

fn main()
    let now = datetime_now()
    print("now: " + now)
    assert_true(len(now) > 10)

    let ts = datetime_timestamp()
    print("timestamp: " + str(ts))
    assert_true(ts > 1577836800)

    let year = datetime_year(ts)
    let month = datetime_month(ts)
    let day = datetime_day(ts)
    let hour = datetime_hour(ts)
    let minute = datetime_minute(ts)
    let second = datetime_second(ts)
    let weekday = datetime_weekday(ts)

    print("year: " + str(year))
    print("month: " + str(month))
    print("day: " + str(day))
    assert_true(year >= 2026)
    assert_true(month >= 1)
    assert_true(month <= 12)
    assert_true(day >= 1)
    assert_true(day <= 31)
    assert_true(hour >= 0)
    assert_true(hour <= 23)
    assert_true(minute >= 0)
    assert_true(minute <= 59)
    assert_true(second >= 0)
    assert_true(second <= 59)
    assert_true(weekday >= 0)
    assert_true(weekday <= 6)

    let formatted = datetime_format(ts, "%Y/%m/%d")
    print("formatted: " + formatted)
    assert_true(len(formatted) == 10)

    let parsed = datetime_parse("2025-06-15 12:30:00", "")
    print("parsed: " + str(parsed))
    assert_true(parsed > 0)
    assert_eq(datetime_year(parsed), 2025)
    assert_eq(datetime_month(parsed), 6)
    assert_eq(datetime_day(parsed), 15)
    assert_eq(datetime_hour(parsed), 12)
    assert_eq(datetime_minute(parsed), 30)

    let parsed2 = datetime_parse("2024-12-25T08:00:00", "")
    assert_eq(datetime_year(parsed2), 2024)
    assert_eq(datetime_month(parsed2), 12)
    assert_eq(datetime_day(parsed2), 25)

    let diff = datetime_diff(parsed, parsed2)
    print("diff seconds: " + str(diff))
    assert_true(diff > 0)

    let next_week = datetime_add_days(parsed, 7)
    assert_eq(datetime_day(next_week), 22)

    let later = datetime_add_hours(parsed, 3)
    assert_eq(datetime_hour(later), 15)

    test_summary()
