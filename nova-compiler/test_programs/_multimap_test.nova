import std/collections/multimap

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + got + " expected " + expected)
        exit(1)

fn main()
    // Build: a->1, a->2, b->3
    let mm = mm_new()
    mm_add(mm, "a", 1)
    mm_add(mm, "a", 2)
    mm_add(mm, "b", 3)

    // get("a") = [1, 2]
    let ga = mm_get(mm, "a")
    cki("get_a_len", len(ga), 2)
    cki("get_a_0", ga[0], 1)
    cki("get_a_1", ga[1], 2)

    // get_first("a") = 1
    cki("get_first_a", mm_get_first(mm, "a"), 1)

    // count("a") = 2
    cki("count_a", mm_count(mm, "a"), 2)

    // has("b") = true
    cki("has_b", mm_has(mm, "b"), 1)

    // has("z") = false
    cki("has_z", mm_has(mm, "z"), 0)

    // get("z") = []
    let gz = mm_get(mm, "z")
    cki("get_z_len", len(gz), 0)

    // total = 3
    cki("total", mm_total(mm), 3)

    // keys has "a" and "b"
    let ks = mm_keys(mm)
    cki("keys_len", len(ks), 2)
    // Check both keys present (order may vary)
    let found_a = 0
    let found_b = 0
    let ki = 0
    while ki < len(ks)
        if ks[ki] == "a"
            found_a = 1
        if ks[ki] == "b"
            found_b = 1
        ki = ki + 1
    cki("keys_has_a", found_a, 1)
    cki("keys_has_b", found_b, 1)

    // remove_key("a") -> has("a")=false, total=1
    mm_remove_key(mm, "a")
    cki("after_remove_has_a", mm_has(mm, "a"), 0)
    cki("after_remove_total", mm_total(mm), 1)

    // get_first on missing key -> null
    let gf_z = mm_get_first(mm, "z")
    cki("get_first_missing_is_null", gf_z == null, 1)

    // count on missing key -> 0
    cki("count_missing", mm_count(mm, "z"), 0)

    print("_multimap_test passed")

main()
