import forge_weighted_sampler

fn main()
    let w = ws_new()
    w = ws_add(w, "common", 70)
    w = ws_add(w, "rare", 20)
    w = ws_add(w, "legendary", 10)
    assert(ws_item_count(w) == 3, "3 items")
    assert(ws_total_weight(w) == 100, "total 100")

    let r1 = ws_sample(w, 30)
    assert(is_ok(r1), "sample ok")
    assert(unwrap(r1) == "common", "30 maps to common")

    let r2 = ws_sample(w, 75)
    assert(is_ok(r2), "sample 75 ok")
    assert(unwrap(r2) == "rare", "75 maps to rare")

    let r3 = ws_sample(w, 95)
    assert(is_ok(r3), "sample 95 ok")
    assert(unwrap(r3) == "legendary", "95 maps to legendary")

    let wt = ws_weight_at(w, 0)
    assert(is_ok(wt), "weight ok")
    assert(unwrap(wt) == 70, "first weight 70")

    let empty = ws_new()
    assert(is_err(ws_sample(empty, 0)), "empty sample err")

    print("WEIGHTED-SAMPLER KAT PASS")
