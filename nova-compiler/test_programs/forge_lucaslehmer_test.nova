import forge_lucaslehmer as ll

fn check(cond: bool, label: str)
    if cond == false
        print("FAIL: " + label)

// TEST 1: Known Mersenne primes up to p=61 (all known exponents <= 61)
// M_2=3, M_3=7, M_5=31, M_7=127, M_13=8191, M_17=131071, M_19=524287, M_31=2147483647, M_61=2305843009213693951
check(ll.lucas_lehmer(2), "M_2=3 prime")
check(ll.lucas_lehmer(3), "M_3=7 prime")
check(ll.lucas_lehmer(5), "M_5=31 prime")
check(ll.lucas_lehmer(7), "M_7=127 prime")
check(ll.lucas_lehmer(13), "M_13=8191 prime")
check(ll.lucas_lehmer(17), "M_17=131071 prime")
check(ll.lucas_lehmer(19), "M_19=524287 prime")
check(ll.lucas_lehmer(31), "M_31=2147483647 prime")
check(ll.lucas_lehmer(61), "M_61 prime")

// TEST 2: Known non-Mersenne composites (prime exponent but composite M_p)
check(ll.lucas_lehmer(11) == false, "M_11=2047=23*89 composite")
check(ll.lucas_lehmer(23) == false, "M_23=8388607=47*178481 composite")
check(ll.lucas_lehmer(29) == false, "M_29=536870911=233*1103*2089 composite")
check(ll.lucas_lehmer(37) == false, "M_37 composite")
check(ll.lucas_lehmer(41) == false, "M_41 composite")
check(ll.lucas_lehmer(43) == false, "M_43 composite")
check(ll.lucas_lehmer(47) == false, "M_47 composite")
check(ll.lucas_lehmer(53) == false, "M_53 composite")
check(ll.lucas_lehmer(59) == false, "M_59 composite")

// TEST 3: mersenne_primes_up_to finds all known primes <= 31
let small_list = ll.mersenne_primes_up_to(31)
check(len(small_list) == 8, "8 Mersenne primes with p<=31")
check(small_list[0] == 2, "first p=2")
check(small_list[1] == 3, "second p=3")
check(small_list[2] == 5, "third p=5")
check(small_list[3] == 7, "fourth p=7")
check(small_list[4] == 13, "fifth p=13")
check(small_list[5] == 17, "sixth p=17")
check(small_list[6] == 19, "seventh p=19")
check(small_list[7] == 31, "eighth p=31")

// TEST 4: mersenne_primes_up_to p<=61 includes M_61
let list61 = ll.mersenne_primes_up_to(61)
check(len(list61) == 9, "9 Mersenne primes with p<=61")
check(list61[8] == 61, "ninth p=61")

// TEST 5: Edge cases
check(ll.lucas_lehmer(1) == false, "p=1 not prime -> false")
check(ll.lucas_lehmer(0) == false, "p=0 -> false")

// TEST 6: Cross-check that M_p is actually prime (factor M_3=7, M_5=31, M_7=127)
// If lucas_lehmer(p)=true, verify M_p = 2^p - 1 has no small factors up to 100
fn has_small_factor(val: int) -> bool
    let d = 2
    while d <= 100
        if d < val
            if val % d == 0
                return true
        d = d + 1
    return false

let m3 = 7
let m5 = 31
let m7 = 127
check(has_small_factor(m3) == false, "M_3=7 no small factor")
check(has_small_factor(m5) == false, "M_5=31 no small factor")
check(has_small_factor(m7) == false, "M_7=127 no small factor")

// Cross-check M_11=2047=23*89 IS composite
check(has_small_factor(2047), "M_11=2047 has factor 23")

print("forge_lucaslehmer: KAT done")
