import std/statistics/stat_dispersion

fn ckf(label: string, got: float, want: float)
    let d = got - want
    if d < 0.0
        d = 0.0 - d
    if d > 0.0001
        print("FAIL " + label + " got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // sd_range: max - min
    let xs3 = [1, 5, 3]
    ckf("range_135", sd_range(xs3), 4.0)

    let single = [7]
    ckf("range_single", sd_range(single), 0.0)

    let empty = []
    ckf("range_empty", sd_range(empty), 0.0)

    // sd_mad_mean: mean abs deviation from mean
    // [1,2,3,4]: mean=2.5, devs=[1.5,0.5,0.5,1.5], avg=1.0
    let xs4 = [1, 2, 3, 4]
    ckf("mad_mean_1234", sd_mad_mean(xs4), 1.0)

    // [2,2,2]: mean=2.0, all devs=0.0
    let xs_const = [2, 2, 2]
    ckf("mad_mean_const", sd_mad_mean(xs_const), 0.0)

    // [1,2,3]: mean=2.0, devs=[1,0,1], avg=0.6666
    let xs_123 = [1, 2, 3]
    ckf("mad_mean_123", sd_mad_mean(xs_123), 0.6666)

    // sd_mad_median: mean abs deviation from median
    // [1,2,3,4]: sorted [1,2,3,4], median=(2+3)/2=2.5, devs=[1.5,0.5,0.5,1.5], avg=1.0
    ckf("mad_median_1234", sd_mad_median(xs4), 1.0)

    // [2,2,2]: median=2.0, all devs=0.0
    ckf("mad_median_const", sd_mad_median(xs_const), 0.0)

    // [1,3,5]: sorted [1,3,5], median=3.0, devs=[2,0,2], avg=4/3=1.3333
    let xs_135 = [1, 3, 5]
    ckf("mad_median_135", sd_mad_median(xs_135), 1.3333)

    // sd_cv: population stddev / mean
    // [2,4,4,4,5,5,7,9]: mean=5.0, pop_var=4.0, pop_std=2.0, cv=0.4
    let xs8 = [2, 4, 4, 4, 5, 5, 7, 9]
    ckf("cv_known", sd_cv(xs8), 0.4)

    // [10,10,10,10]: mean=10, stddev=0, cv=0
    let xs_flat = [10, 10, 10, 10]
    ckf("cv_flat", sd_cv(xs_flat), 0.0)

    // empty
    ckf("cv_empty", sd_cv(empty), 0.0)
    ckf("mad_mean_empty", sd_mad_mean(empty), 0.0)
    ckf("mad_median_empty", sd_mad_median(empty), 0.0)

    // [1,2]: range=1, mean=1.5, mad_mean=0.5, median=1.5, mad_median=0.5, cv=stddev/mean
    // pop_var for [1,2]: mean=1.5, devs=[-0.5,0.5], sq=[0.25,0.25], var=0.25, std=0.5, cv=0.5/1.5=0.3333
    let xs2 = [1, 2]
    ckf("range_12", sd_range(xs2), 1.0)
    ckf("mad_mean_12", sd_mad_mean(xs2), 0.5)
    ckf("mad_median_12", sd_mad_median(xs2), 0.5)
    ckf("cv_12", sd_cv(xs2), 0.3333)

    print("PASS _stat_dispersion_test")
