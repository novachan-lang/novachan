// _crc32c_test.nova — KAT for std/hash/crc32c (CRC-32C / Castagnoli).
//
// Canonical reference vectors from iSCSI spec (RFC 3720 Appendix B.4) and
// independent verification via Python crcmod:
//
//   import crcmod
//   crc32c_fn = crcmod.predefined.mkCrcFun('crc-32c')
//   crc32c_fn(b'123456789')    == 0xE3069283
//   crc32c_fn(b'')             == 0x00000000
//   crc32c_fn(b'The quick...')  == 0x22620404
//   crc32c_fn(b'a')            == 0xC1D04330  (3251651376)
//   crc32c_fn(b'abc')          == 0x364B3FB7  (910901175)

import std/hash/crc32c

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL _crc32c_test " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // KAT 1: empty bytes — init XOR final = 0xFFFFFFFF XOR 0xFFFFFFFF = 0
    cki("empty", h_crc32c(bytes(0)), 0)

    // KAT 2: "123456789" — the canonical iSCSI / RFC 3720 check value
    // Expected: 0xE3069283 = 3808858755
    cki("123456789", h_crc32c(str_to_bytes("123456789")), 3808858755)

    // KAT 3: pangram — expected 0x22620404 = 576848900
    cki("fox", h_crc32c(str_to_bytes("The quick brown fox jumps over the lazy dog")), 576848900)

    // KAT 4: single byte 'a' (0x61) — expected 0xC1D04330 = 3251651376
    cki("a", h_crc32c(str_to_bytes("a")), 3251651376)

    // KAT 5: "abc" — expected 0x364B3FB7 = 910901175
    cki("abc", h_crc32c(str_to_bytes("abc")), 910901175)

    // KAT 6: determinism — same input always gives same result
    cki("determinism", h_crc32c(str_to_bytes("hello")), h_crc32c(str_to_bytes("hello")))

    // KAT 7: single NUL byte (byte value 0) — bytes(1) gives one zero byte
    // Python: crc32c(b'\x00') == 0x527D5351 = 1383945041
    cki("nul_byte", h_crc32c(bytes(1)), 1383945041)

    print("PASS _crc32c_test")
