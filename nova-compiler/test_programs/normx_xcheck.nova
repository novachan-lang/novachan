fn hx(s)
    let cps = code_points(s)
    let out = []
    for c in cps
        push(out, c)
    out

fn main()
    let s0 = ""
    s0 = s0 + from_codepoint(99)
    s0 = s0 + from_codepoint(97)
    s0 = s0 + from_codepoint(102)
    s0 = s0 + from_codepoint(233)
    assert(str(hx(normalize_nfd(s0))) == str([99,97,102,101,769]), "nfd 0")
    assert(str(hx(normalize_nfc(s0))) == str([99,97,102,233]), "nfc 0")
    let s1 = ""
    s1 = s1 + from_codepoint(110)
    s1 = s1 + from_codepoint(97)
    s1 = s1 + from_codepoint(239)
    s1 = s1 + from_codepoint(118)
    s1 = s1 + from_codepoint(101)
    assert(str(hx(normalize_nfd(s1))) == str([110,97,105,776,118,101]), "nfd 1")
    assert(str(hx(normalize_nfc(s1))) == str([110,97,239,118,101]), "nfc 1")
    let s2 = ""
    s2 = s2 + from_codepoint(72)
    s2 = s2 + from_codepoint(228)
    s2 = s2 + from_codepoint(117)
    s2 = s2 + from_codepoint(115)
    s2 = s2 + from_codepoint(101)
    s2 = s2 + from_codepoint(114)
    assert(str(hx(normalize_nfd(s2))) == str([72,97,776,117,115,101,114]), "nfd 2")
    assert(str(hx(normalize_nfc(s2))) == str([72,228,117,115,101,114]), "nfc 2")
    let s3 = ""
    s3 = s3 + from_codepoint(83)
    s3 = s3 + from_codepoint(101)
    s3 = s3 + from_codepoint(241)
    s3 = s3 + from_codepoint(111)
    s3 = s3 + from_codepoint(114)
    assert(str(hx(normalize_nfd(s3))) == str([83,101,110,771,111,114]), "nfd 3")
    assert(str(hx(normalize_nfc(s3))) == str([83,101,241,111,114]), "nfc 3")
    let s4 = ""
    s4 = s4 + from_codepoint(209)
    s4 = s4 + from_codepoint(111)
    s4 = s4 + from_codepoint(241)
    s4 = s4 + from_codepoint(111)
    assert(str(hx(normalize_nfd(s4))) == str([78,771,111,110,771,111]), "nfd 4")
    assert(str(hx(normalize_nfc(s4))) == str([209,111,241,111]), "nfc 4")
    let s5 = ""
    s5 = s5 + from_codepoint(197)
    s5 = s5 + from_codepoint(110)
    s5 = s5 + from_codepoint(103)
    s5 = s5 + from_codepoint(115)
    s5 = s5 + from_codepoint(116)
    s5 = s5 + from_codepoint(114)
    s5 = s5 + from_codepoint(246)
    s5 = s5 + from_codepoint(109)
    assert(str(hx(normalize_nfd(s5))) == str([65,778,110,103,115,116,114,111,776,109]), "nfd 5")
    assert(str(hx(normalize_nfc(s5))) == str([197,110,103,115,116,114,246,109]), "nfc 5")
    let s6 = ""
    s6 = s6 + from_codepoint(54620)
    s6 = s6 + from_codepoint(44397)
    s6 = s6 + from_codepoint(50612)
    assert(str(hx(normalize_nfd(s6))) == str([4370,4449,4523,4352,4462,4520,4363,4453]), "nfd 6")
    assert(str(hx(normalize_nfc(s6))) == str([54620,44397,50612]), "nfc 6")
    let s7 = ""
    s7 = s7 + from_codepoint(44032)
    s7 = s7 + from_codepoint(45208)
    s7 = s7 + from_codepoint(45796)
    assert(str(hx(normalize_nfd(s7))) == str([4352,4449,4354,4449,4355,4449]), "nfd 7")
    assert(str(hx(normalize_nfc(s7))) == str([44032,45208,45796]), "nfc 7")
    let s8 = ""
    s8 = s8 + from_codepoint(937)
    assert(str(hx(normalize_nfd(s8))) == str([937]), "nfd 8")
    assert(str(hx(normalize_nfc(s8))) == str([937]), "nfc 8")
    let s9 = ""
    s9 = s9 + from_codepoint(64256)
    assert(str(hx(normalize_nfd(s9))) == str([64256]), "nfd 9")
    assert(str(hx(normalize_nfc(s9))) == str([64256]), "nfc 9")
    let s10 = ""
    s10 = s10 + from_codepoint(101)
    s10 = s10 + from_codepoint(769)
    s10 = s10 + from_codepoint(803)
    assert(str(hx(normalize_nfd(s10))) == str([101,803,769]), "nfd 10")
    assert(str(hx(normalize_nfc(s10))) == str([7865,769]), "nfc 10")
    let s11 = ""
    s11 = s11 + from_codepoint(7690)
    s11 = s11 + from_codepoint(97)
    assert(str(hx(normalize_nfd(s11))) == str([68,775,97]), "nfd 11")
    assert(str(hx(normalize_nfc(s11))) == str([7690,97]), "nfc 11")
    let s12 = ""
    s12 = s12 + from_codepoint(1047)
    s12 = s12 + from_codepoint(1076)
    s12 = s12 + from_codepoint(1088)
    s12 = s12 + from_codepoint(1072)
    s12 = s12 + from_codepoint(1074)
    s12 = s12 + from_codepoint(1089)
    s12 = s12 + from_codepoint(1090)
    s12 = s12 + from_codepoint(1074)
    s12 = s12 + from_codepoint(1091)
    s12 = s12 + from_codepoint(1081)
    s12 = s12 + from_codepoint(1090)
    s12 = s12 + from_codepoint(1077)
    assert(str(hx(normalize_nfd(s12))) == str([1047,1076,1088,1072,1074,1089,1090,1074,1091,1080,774,1090,1077]), "nfd 12")
    assert(str(hx(normalize_nfc(s12))) == str([1047,1076,1088,1072,1074,1089,1090,1074,1091,1081,1090,1077]), "nfc 12")
    let s13 = ""
    s13 = s13 + from_codepoint(197)
    s13 = s13 + from_codepoint(807)
    assert(str(hx(normalize_nfd(s13))) == str([65,807,778]), "nfd 13")
    assert(str(hx(normalize_nfc(s13))) == str([197,807]), "nfc 13")
    print("normx_xcheck ok 14 cases")
