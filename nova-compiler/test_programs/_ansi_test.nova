import std/text/ansi

fn main()
    let ESC = chr(27)

    // ── KAT 1: ansi_red("hi") == ESC+"[31m"+"hi"+ESC+"[0m" ──────────────────
    let expected_red = ESC + "[31m" + "hi" + ESC + "[0m"
    let got_red = ansi_red("hi")
    if got_red != expected_red
        print("FAIL KAT1: ansi_red got wrong result")
        exit(1)

    // ── KAT 2: ansi_bold("x") contains ESC+"[1m" ─────────────────────────────
    let bold_x = ansi_bold("x")
    let bold_intro = ESC + "[1m"
    if find(bold_x, bold_intro) < 0
        print("FAIL KAT2: ansi_bold does not contain ESC[1m")
        exit(1)

    // ── KAT 3: ansi_strip(ansi_red("hi")) == "hi" ────────────────────────────
    let stripped_red = ansi_strip(ansi_red("hi"))
    if stripped_red != "hi"
        print("FAIL KAT3: ansi_strip(ansi_red) should be 'hi'")
        exit(1)

    // ── KAT 4: ansi_strip("plain") == "plain" ────────────────────────────────
    let stripped_plain = ansi_strip("plain")
    if stripped_plain != "plain"
        print("FAIL KAT4: ansi_strip of plain text should be unchanged")
        exit(1)

    // ── KAT 5: ansi_strip(ansi_green(ansi_bold("z"))) == "z" ─────────────────
    let nested = ansi_green(ansi_bold("z"))
    let stripped_nested = ansi_strip(nested)
    if stripped_nested != "z"
        print("FAIL KAT5: ansi_strip of nested sequences should be 'z'")
        exit(1)

    // ── KAT 6: ansi_color("a",35) == ESC+"[35m"+"a"+ESC+"[0m" ───────────────
    let expected_35 = ESC + "[35m" + "a" + ESC + "[0m"
    let got_35 = ansi_color("a", 35)
    if got_35 != expected_35
        print("FAIL KAT6: ansi_color(a,35) got wrong result")
        exit(1)

    // ── KAT 7: ansi_yellow length check ──────────────────────────────────────
    // ESC[33m + "test" + ESC[0m = 1+1+3+1 + 4 + 1+1+2+1 = 9+4+5 = 18... let's count:
    // chr(27)="1 byte" + "[33m"=4 bytes + "test"=4 bytes + chr(27)=1 byte + "[0m"=3 bytes = 13 bytes
    let yellow_test = ansi_yellow("test")
    let expected_yellow_len = 13
    if len(yellow_test) != expected_yellow_len
        print("FAIL KAT7: ansi_yellow length wrong")
        exit(1)

    // ── KAT 8: ansi_strip("") == "" ──────────────────────────────────────────
    let stripped_empty = ansi_strip("")
    if stripped_empty != ""
        print("FAIL KAT8: ansi_strip of empty should be empty")
        exit(1)

    // ── KAT 9: ansi_underline produces ESC[4m ────────────────────────────────
    let ul = ansi_underline("u")
    let ul_intro = ESC + "[4m"
    if find(ul, ul_intro) < 0
        print("FAIL KAT9: ansi_underline does not contain ESC[4m")
        exit(1)

    // ── KAT 10: ansi_blue reset suffix is ESC[0m ─────────────────────────────
    let blue_s = ansi_blue("b")
    let reset_suffix = ESC + "[0m"
    if find(blue_s, reset_suffix) < 0
        print("FAIL KAT10: ansi_blue does not end with ESC[0m")
        exit(1)

    // ── KAT 11: ansi_strip on string with no ESC is unchanged ────────────────
    let no_esc = "hello, world! 123"
    if ansi_strip(no_esc) != no_esc
        print("FAIL KAT11: ansi_strip of no-ESC string should be identical")
        exit(1)

    // ── KAT 12: ansi_strip on double-wrapped is correct ──────────────────────
    // ansi_red(ansi_blue("AB")) -> ESC[31m + ESC[34mABESC[0m + ESC[0m
    // strip -> "AB"
    let double_wrap = ansi_red(ansi_blue("AB"))
    if ansi_strip(double_wrap) != "AB"
        print("FAIL KAT12: ansi_strip of double-wrapped should be 'AB'")
        exit(1)

    print("_ansi_test passed")
