// KAT: inline if-EXPRESSION in statement position -- `if a > b a else b`, the form
// GATE 1 program 3 uses for max(). It already worked after `=` and after `return`;
// a statement STARTING with `if` was parsed as an if STATEMENT, so the `a else b`
// tail gave "unexpected KW 'else' in expression".
fn mx(a: int, b: int) -> int
    if a > b a else b

fn label(n: int) -> string
    if n > 0 "pos" else "non-pos"

// the BLOCK form must still work exactly as before
fn classify(n: int) -> string
    if n > 100
        return "big"
    else
        return "small"

fn main()
    let ok = 0
    let fail = 0
    if mx(3, 7) == 7 and mx(9, 2) == 9
        ok = ok + 1
        print("ok: bare inline if-expression as a function body")
    else
        fail = fail + 1
        print("FAIL mx: " + str(mx(3,7)) + " " + str(mx(9,2)))
    if label(5) == "pos" and label(-1) == "non-pos"
        ok = ok + 1
        print("ok: inline if-expression returning strings")
    else
        fail = fail + 1
        print("FAIL label")
    if classify(500) == "big" and classify(2) == "small"
        ok = ok + 1
        print("ok: multi-line if/else block form unaffected")
    else
        fail = fail + 1
        print("FAIL block-form if regressed")
    let v = if 1 > 0 10 else 20
    if v == 10
        ok = ok + 1
        print("ok: inline if after = still works")
    else
        fail = fail + 1
    print("ok=" + str(ok) + " fail=" + str(fail))
    assert(fail == 0, "inline_if: all checks pass")
    assert(ok == 4, "inline_if: all 4 checks ran")
    print("KAT inline_if PASS")
