import std/dp/dp_coin_change

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _dp_coin_change_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── cc_min ───────────────────────────────────────────────────────────────
    // [1,5,10,25] amount 30: 25+5 = 2 coins
    cki("min_30",   cc_min([1, 5, 10, 25], 30),  2)
    // [1,5,10,25] amount 63: 25+25+10+1+1+1 = 6 coins
    cki("min_63",   cc_min([1, 5, 10, 25], 63),  6)
    // [3,7] amount 5: impossible
    cki("min_imp",  cc_min([3, 7], 5),           -1)
    // amount 0: always 0
    cki("min_0",    cc_min([1, 5, 10, 25], 0),    0)
    // classic: [1,2,5] amount 11 -> 3 coins (5+5+1)
    cki("min_11",   cc_min([1, 2, 5], 11),        3)
    // empty coins, amount>0: impossible
    cki("min_nocoin",cc_min([], 5),              -1)
    // exact denomination
    cki("min_exact", cc_min([5], 10),             2)

    // ── cc_ways ──────────────────────────────────────────────────────────────
    // [1,2,5] amount 5: {5},{1+2+2},{1+1+1+2},{1+1+1+1+1} = 4
    cki("ways_5",    cc_ways([1, 2, 5], 5),       4)
    // [2] amount 3: impossible (odd amount with only even coin)
    cki("ways_imp",  cc_ways([2], 3),             0)
    // amount 0: exactly 1 way (empty combination)
    cki("ways_0",    cc_ways([1, 2, 5], 0),       1)
    // [1,5,10,25] amount 30: known answer = 18
    cki("ways_30",   cc_ways([1, 5, 10, 25], 30), 18)

    // ── cc_greedy ────────────────────────────────────────────────────────────
    // [1,5,10,25] amount 30: 25+5 = 2 coins (greedy optimal here)
    cki("greedy_30", cc_greedy([1, 5, 10, 25], 30), 2)
    // [1,5,10,25] amount 63: 25+25+10+1+1+1 = 6 coins
    cki("greedy_63", cc_greedy([1, 5, 10, 25], 63), 6)
    // amount 0: 0 coins
    cki("greedy_0",  cc_greedy([1, 5, 10, 25], 0),  0)
    // single coin [5] amount 15: 3 coins
    cki("greedy_single", cc_greedy([5], 15),          3)

    print("PASS _dp_coin_change_test")
