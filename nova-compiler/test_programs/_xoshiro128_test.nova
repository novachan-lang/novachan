// KAT test for std/random/xoshiro128 (xoshiro128+)
//
// Reference values computed via Python reference implementation:
//   splitmix32 seeding from seed=7 -> state [588686121, 1916645059, 3821142705, 1976702228]
//   step 0: 2565388349
//   step 1: 2732052797
//   step 2: 2844382739
//   step 3: 2359221855
//
// KAT1:  Anchor -- xo128_next(xo128_seed(7)) first output == 2565388349
// KAT2:  Determinism -- two xo128_seed(7) generators produce identical first 8 outputs
// KAT3:  All outputs < 2^32 (stay in 32-bit range)
// KAT4:  All outputs >= 0
// KAT5:  xo128_next_range stays in [0, n)
// KAT6:  Different seeds produce different outputs (non-degenerate)
// KAT7:  Anchor -- second and third outputs match reference

import std/random/xoshiro128

fn main()
    // ── KAT1: concrete anchor value ──────────────────────────────────────────
    let rng1 = xo128_seed(7)
    let v0 = xo128_next(rng1)
    if v0 != 2565388349
        print("FAIL xoshiro128 KAT1 anchor: got " + str(v0) + " want 2565388349")
        exit(1)

    // ── KAT2: determinism -- fresh seed=7, compare first 8 values ────────────
    let ref0 = xo128_seed(7)
    let r0 = xo128_next(ref0)
    let r1 = xo128_next(ref0)
    let r2 = xo128_next(ref0)
    let r3 = xo128_next(ref0)
    let r4 = xo128_next(ref0)
    let r5 = xo128_next(ref0)
    let r6 = xo128_next(ref0)
    let r7 = xo128_next(ref0)

    let chk0 = xo128_seed(7)
    let c0 = xo128_next(chk0)
    let c1 = xo128_next(chk0)
    let c2 = xo128_next(chk0)
    let c3 = xo128_next(chk0)
    let c4 = xo128_next(chk0)
    let c5 = xo128_next(chk0)
    let c6 = xo128_next(chk0)
    let c7 = xo128_next(chk0)

    if c0 != r0
        print("FAIL xoshiro128 KAT2 determinism step0: " + str(c0) + " vs " + str(r0))
        exit(1)
    if c1 != r1
        print("FAIL xoshiro128 KAT2 determinism step1: " + str(c1) + " vs " + str(r1))
        exit(1)
    if c2 != r2
        print("FAIL xoshiro128 KAT2 determinism step2: " + str(c2) + " vs " + str(r2))
        exit(1)
    if c3 != r3
        print("FAIL xoshiro128 KAT2 determinism step3: " + str(c3) + " vs " + str(r3))
        exit(1)
    if c4 != r4
        print("FAIL xoshiro128 KAT2 determinism step4: " + str(c4) + " vs " + str(r4))
        exit(1)
    if c5 != r5
        print("FAIL xoshiro128 KAT2 determinism step5: " + str(c5) + " vs " + str(r5))
        exit(1)
    if c6 != r6
        print("FAIL xoshiro128 KAT2 determinism step6: " + str(c6) + " vs " + str(r6))
        exit(1)
    if c7 != r7
        print("FAIL xoshiro128 KAT2 determinism step7: " + str(c7) + " vs " + str(r7))
        exit(1)

    // ── KAT3 + KAT4: all outputs in [0, 2^32) ────────────────────────────────
    let rng3 = xo128_seed(13)
    let max32 = 4294967296
    let i = 0
    while i < 100
        let v = xo128_next(rng3)
        if v < 0
            print("FAIL xoshiro128 KAT4 negative output at step " + str(i) + ": " + str(v))
            exit(1)
        if v >= max32
            print("FAIL xoshiro128 KAT3 output >= 2^32 at step " + str(i) + ": " + str(v))
            exit(1)
        i = i + 1

    // ── KAT5: anchor steps 1 and 2 from seed=7 ───────────────────────────────
    // r1 and r2 already computed above from ref0
    if r1 != 2732052797
        print("FAIL xoshiro128 KAT5 anchor step1: got " + str(r1) + " want 2732052797")
        exit(1)
    if r2 != 2844382739
        print("FAIL xoshiro128 KAT5 anchor step2: got " + str(r2) + " want 2844382739")
        exit(1)

    // ── KAT6: xo128_next_range stays in [0, n) ───────────────────────────────
    let rng6 = xo128_seed(99)
    let j = 0
    while j < 200
        let rv = xo128_next_range(rng6, 17)
        if rv < 0
            print("FAIL xoshiro128 KAT6 range < 0 at step " + str(j))
            exit(1)
        if rv >= 17
            print("FAIL xoshiro128 KAT6 range >= 17 at step " + str(j) + ": " + str(rv))
            exit(1)
        j = j + 1

    // ── KAT7: different seed produces different output ────────────────────────
    let rng7 = xo128_seed(42)
    let v42 = xo128_next(rng7)
    if v42 == r0
        print("FAIL xoshiro128 KAT7 non-degenerate: seed=42 == seed=7 first output " + str(v42))
        exit(1)
    // Reference: seed=42 first output = 975160002
    if v42 != 975160002
        print("FAIL xoshiro128 KAT7 anchor seed=42: got " + str(v42) + " want 975160002")
        exit(1)

    print("PASS _xoshiro128_test")
