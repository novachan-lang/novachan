// Bootstrap test 21: lambda expressions
// Different from nested fn: uses => syntax for inline functions

fn apply(f, x)
    return f(x)

// Simple lambda
let double = x => x * 2
print(apply(double, 7))

// Lambda with capture
let offset = 100
let add_offset = x => x + offset
print(apply(add_offset, 5))

// Lambda used directly
print(apply(x => x + 1, 10))

// Lambda in higher-order patterns
fn map_list(items, f)
    let result = []
    for item in items
        push(result, f(item))
    return result

let nums = [1, 2, 3, 4, 5]
let doubled = map_list(nums, x => x * 2)
print(doubled[0])
print(doubled[4])

// Lambda with string operations
let greet = name => "hi " + name
print(greet("nova"))
