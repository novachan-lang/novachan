// Pure-NOVA HTTP server end-to-end. No FFI, no external library — uses
// NOVA's built-in TCP primitives (tcp_listen / accept / send / recv /
// close). Demonstrates the runtime's networking surface from NOVA code.
//
// The server spawns into a child process, listens on a fixed port, and
// answers a single GET with a tiny 200-OK + "Hello from NOVA" body. The
// main thread then http_get's the URL and asserts the body content.

fn build_response(body: string) -> string
    let resp = "HTTP/1.1 200 OK\r\n"
    resp = resp + "Content-Type: text/plain\r\n"
    resp = resp + "Content-Length: " + str(len(body)) + "\r\n"
    resp = resp + "Connection: close\r\n"
    resp = resp + "\r\n"
    resp = resp + body
    resp

fn http_server_once(port: int)
    let listener = tcp_listen(port)
    let conn = tcp_accept(listener)
    tcp_recv(conn)
    let body = "Hello from NOVA"
    let resp = build_response(body)
    tcp_send(conn, resp)
    tcp_close(conn)
    tcp_close(listener)

fn main()
    let port = 19876
    spawn fn()
        http_server_once(port)
    sleep(200)
    let url = "http://127.0.0.1:" + str(port) + "/"
    let resp = http_get(url)
    if find(resp, "Hello from NOVA") < 0
        print("FAIL: response did not contain expected body. resp=" + resp)
        exit(1)
    print("native HTTP server demo passed: served 'Hello from NOVA' over real TCP, fetched via http_get, body verified")
