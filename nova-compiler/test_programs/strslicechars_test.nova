// strslicechars_test — string negative slicing (Python-style, was clamped to 0)
// and chars() splitting by codepoint (was raw bytes, splitting multibyte UTF-8).

fn main()
    // negative slice indices count from the end
    assert_eq(slice("hello", -2, 5), "lo")
    assert_eq(slice("hello", 0, -1), "hell")
    assert_eq(slice("hello", -3, -1), "ll")
    assert_eq(slice("hello", -10, 2), "he")    // out-of-range negative clamps to 0
    assert_eq(slice("hello", 1, 3), "el")      // positive indices unchanged
    assert_eq(slice("hello", 2, 100), "llo")   // end clamps to len

    // chars() splits by codepoint, not byte
    assert_eq(chars("abc"), ["a", "b", "c"])
    assert_eq(len(chars("café")), 4)
    let cs = chars("café")
    assert_eq(cs[0], "c")
    assert_eq(cs[3], "é")
    assert_eq(len(chars("")), 0)
    assert_eq(len(chars("€")), 1)               // 3-byte codepoint -> 1 char

    print("strslicechars_test passed")
