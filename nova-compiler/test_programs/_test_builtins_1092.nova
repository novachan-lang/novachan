fn main()
    let checks = 0
    let fails = 0

    // str_byte_at
    let b = str_byte_at("ABC", 0)
    if b == 65
        print("ok str_byte_at A=65")
    else
        print("FAIL str_byte_at A=" + str(b))
        fails = fails + 1
    checks = checks + 1

    let b2 = str_byte_at("ABC", 2)
    if b2 == 67
        print("ok str_byte_at C=67")
    else
        print("FAIL str_byte_at C=" + str(b2))
        fails = fails + 1
    checks = checks + 1

    let b3 = str_byte_at("ABC", 5)
    if b3 == -1
        print("ok str_byte_at oob=-1")
    else
        print("FAIL str_byte_at oob=" + str(b3))
        fails = fails + 1
    checks = checks + 1

    // str_byte_len
    let bl = str_byte_len("hello")
    if bl == 5
        print("ok str_byte_len hello=5")
    else
        print("FAIL str_byte_len=" + str(bl))
        fails = fails + 1
    checks = checks + 1

    let bl2 = str_byte_len("")
    if bl2 == 0
        print("ok str_byte_len empty=0")
    else
        print("FAIL str_byte_len empty=" + str(bl2))
        fails = fails + 1
    checks = checks + 1

    // str_chars_list
    let cl = str_chars_list("abc")
    if len(cl) == 3 and cl[0] == "a" and cl[1] == "b" and cl[2] == "c"
        print("ok str_chars_list abc")
    else
        print("FAIL str_chars_list")
        fails = fails + 1
    checks = checks + 1

    // str_remove_char
    let rc = str_remove_char("hello world", 108)
    if rc == "heo word"
        print("ok str_remove_char l")
    else
        print("FAIL str_remove_char=" + rc)
        fails = fails + 1
    checks = checks + 1

    // list_cumsum
    let cs = list_cumsum([1, 2, 3, 4, 5])
    if len(cs) == 5 and cs[0] == 1 and cs[1] == 3 and cs[2] == 6 and cs[3] == 10 and cs[4] == 15
        print("ok list_cumsum")
    else
        print("FAIL list_cumsum")
        fails = fails + 1
    checks = checks + 1

    // list_reverse_copy
    let rv = list_reverse_copy([1, 2, 3])
    if len(rv) == 3 and rv[0] == 3 and rv[1] == 2 and rv[2] == 1
        print("ok list_reverse_copy")
    else
        print("FAIL list_reverse_copy")
        fails = fails + 1
    checks = checks + 1

    // list_repeat_val
    let rp = list_repeat_val(42, 4)
    if len(rp) == 4 and rp[0] == 42 and rp[3] == 42
        print("ok list_repeat_val")
    else
        print("FAIL list_repeat_val")
        fails = fails + 1
    checks = checks + 1

    // list_of_range
    let rng = list_of_range(3, 7)
    if len(rng) == 4 and rng[0] == 3 and rng[1] == 4 and rng[2] == 5 and rng[3] == 6
        print("ok list_of_range")
    else
        print("FAIL list_of_range")
        fails = fails + 1
    checks = checks + 1

    // list_adjacent_pairs
    let ap = list_adjacent_pairs([10, 20, 30, 40])
    if len(ap) == 3
        let p0 = ap[0]
        let p1 = ap[1]
        let p2 = ap[2]
        if p0[0] == 10 and p0[1] == 20 and p1[0] == 20 and p1[1] == 30 and p2[0] == 30 and p2[1] == 40
            print("ok list_adjacent_pairs")
        else
            print("FAIL list_adjacent_pairs values")
            fails = fails + 1
    else
        print("FAIL list_adjacent_pairs len=" + str(len(ap)))
        fails = fails + 1
    checks = checks + 1

    // dict_sorted_by_value
    let d = {"a": 3, "b": 1, "c": 2}
    let sv = dict_sorted_by_value(d)
    if len(sv) == 3 and sv[0] == "b" and sv[1] == "c" and sv[2] == "a"
        print("ok dict_sorted_by_value")
    else
        print("FAIL dict_sorted_by_value")
        fails = fails + 1
    checks = checks + 1

    print("checks=" + str(checks) + " fails=" + str(fails))
    if fails == 0
        print("ALL PASS")
    else
        print("SOME FAILED")
        exit(1)
