// Forge crypto: base64 (RFC 4648) byte-list encode/decode. Socketless, deterministic.
import forge_crypto

fn main()
    if b64_encode_blist([104, 101, 108, 108, 111]) != "aGVsbG8="
        print("FAIL: encode 'hello'")
        exit(1)
    if b64_encode_blist([1, 2, 3]) != "AQID"
        print("FAIL: encode no-pad")
        exit(1)
    if b64_encode_blist([255]) != "/w=="
        print("FAIL: encode 1-byte pad")
        exit(1)

    let dec = b64_decode_blist("aGVsbG8=")
    if len(dec) != 5 or dec[0] != 104 or dec[4] != 111
        print("FAIL: decode 'hello'")
        exit(1)

    // the RFC 7677 SCRAM salt decodes to 16 bytes
    if len(b64_decode_blist("W22ZaJ0SNY7soEsUEjb6gQ==")) != 16
        print("FAIL: RFC 7677 salt should decode to 16 bytes")
        exit(1)

    print("PASS forge_crypto_b64 (encode/decode + RFC 7677 salt)")
