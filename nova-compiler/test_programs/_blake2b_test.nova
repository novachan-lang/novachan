// Canonical KAT test for forge_blake2b (RFC 7693). Vectors recomputed vs Python hashlib in verification.
import forge_blake2b

fn eq_s(name: string, got: string, want: string)
    if got != want
        print("FAIL " + name + ": got '" + got + "' want '" + want + "'")
        exit(1)
    print("ok " + name)

fn main()
    eq_s("empty-512", blake2b_hex(str_to_bytes(""), 64), "786a02f742015903c6c6fd852552d272912f4740e15847618a86e217f71f5419d25e1031afee585313896444934eb04b903a685b1448b755d56f701afe9be2ce")
    eq_s("abc-512", blake2b_hex(str_to_bytes("abc"), 64), "ba80a53f981c4d0d6a2797b69f12f6e94c212f14685ac4b74b12bb6fdbffa2d17d87c5392aab792dc252d5de4533cc9518d38aa8dbf1925ab92386edd4009923")
    eq_s("empty-256", blake2b_hex(str_to_bytes(""), 32), "0e5751c026e543b2e8ab2eb06099daa1d1e5df47778f7787faab45cdf12fe3a8")
    // binary-safety: a payload with embedded 0x00 must not be truncated -> differs from empty
    let bb = bytes(0)
    bb = bytes_append(bb, 0)
    bb = bytes_append(bb, 1)
    bb = bytes_append(bb, 0)
    bb = bytes_append(bb, 2)
    if blake2b_hex(bb, 64) == blake2b_hex(str_to_bytes(""), 64)
        print("FAIL binary-safety: 0x00 payload hashed as empty")
        exit(1)
    print("ok binary-safety")
    print("_blake2b_test passed")
