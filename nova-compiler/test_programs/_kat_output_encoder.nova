import forge_output_encoder

fn main()
    let h1 = oe_html_encode("hello")
    assert(h1 == "hello", "plain unchanged")

    let h2 = oe_html_encode("a & b")
    assert(h2 == "a &amp; b", "amp encoded")

    let u1 = oe_url_encode("hello world")
    assert(u1 == "hello%20world", "space encoded")

    let u2 = oe_url_encode("a=1&b=2")
    assert(u2 == "a%3D1%26b%3D2", "eq and amp encoded")

    let j1 = oe_json_escape("hello")
    assert(j1 == "hello", "json plain")

    let c1 = oe_csv_escape("hello")
    assert(c1 == "hello", "csv plain")

    let c2 = oe_csv_escape("a,b")
    assert(c2 == "\"a,b\"", "csv comma quoted")

    print("OUTPUT-ENCODER KAT PASS")
