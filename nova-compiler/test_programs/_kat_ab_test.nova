import forge_ab_test

fn main()
    let ab = ab_new()
    let variants = ["control", "variant_a", "variant_b"]
    ab = ab_create(ab, "button_color", variants)

    assert(ab_is_active(ab, "button_color") == true, "active")

    let exps = ab_list_experiments(ab)
    assert(len(exps) == 1, "1 experiment")

    ab = ab_assign(ab, "button_color", "user1", "control")
    ab = ab_assign(ab, "button_color", "user2", "variant_a")
    ab = ab_assign(ab, "button_color", "user3", "variant_b")

    assert(ab_get_variant(ab, "button_color", "user1") == "control", "user1=control")
    assert(ab_get_variant(ab, "button_color", "user2") == "variant_a", "user2=variant_a")
    assert(ab_get_variant(ab, "button_color", "unknown") == "", "unknown user")

    ab = ab_record_impression(ab, "button_color", "control")
    ab = ab_record_impression(ab, "button_color", "control")
    ab = ab_record_impression(ab, "button_color", "variant_a")
    ab = ab_record_impression(ab, "button_color", "variant_a")
    ab = ab_record_impression(ab, "button_color", "variant_b")
    ab = ab_record_impression(ab, "button_color", "variant_b")

    ab = ab_record_conversion(ab, "button_color", "control")
    ab = ab_record_conversion(ab, "button_color", "variant_a")
    ab = ab_record_conversion(ab, "button_color", "variant_a")

    assert(ab_conversion_rate(ab, "button_color", "control") == 50, "control=50%")
    assert(ab_conversion_rate(ab, "button_color", "variant_a") == 100, "variant_a=100%")
    assert(ab_conversion_rate(ab, "button_color", "variant_b") == 0, "variant_b=0%")

    assert(ab_winner(ab, "button_color") == "variant_a", "winner=variant_a")

    ab = ab_deactivate(ab, "button_color")
    assert(ab_is_active(ab, "button_color") == false, "deactivated")

    print("AB-TEST KAT PASS")
