import forge_ab_test

fn main()
    let t = ab_new()
    let r1 = ab_create(t, "button_color", "red", "blue")
    assert(is_ok(r1), "create ok")
    t = unwrap(r1)
    assert(ab_experiment_count(t) == 1, "1 experiment")

    let r2 = ab_create(t, "button_color", "x", "y")
    assert(is_err(r2), "duplicate err")

    let a1 = ab_assign(t, "button_color", 0)
    assert(is_ok(a1), "assign hash 0")
    assert(unwrap(a1) == "a", "even hash -> a")

    let a2 = ab_assign(t, "button_color", 1)
    assert(is_ok(a2), "assign hash 1")
    assert(unwrap(a2) == "b", "odd hash -> b")

    assert(ab_total_impressions(t) == 2, "2 impressions")

    let c1 = ab_convert(t, "button_color", "a")
    assert(is_ok(c1), "convert a ok")
    t = unwrap(c1)

    let rate = ab_conversion_rate(t, "button_color", "a")
    assert(is_ok(rate), "rate ok")
    assert(unwrap(rate) == 100, "100% a conversion")

    let w = ab_winner(t, "button_color")
    assert(is_ok(w), "winner ok")
    assert(unwrap(w) == "a", "a wins")

    let bad = ab_assign(t, "nope", 0)
    assert(is_err(bad), "unknown experiment")

    print("AB-TEST KAT PASS")
