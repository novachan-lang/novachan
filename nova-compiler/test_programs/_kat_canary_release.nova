import forge_canary_release

fn main()
    let cr = cr_new("v2.1.0")
    assert(cr_status(cr) == "pending", "initial=pending")
    assert(cr_weight(cr) == 0, "weight=0")

    cr = cr_start(cr, 10)
    assert(cr_status(cr) == "active", "active")
    assert(cr_weight(cr) == 10, "weight=10")

    cr = cr_record_success(cr)
    cr = cr_record_success(cr)
    cr = cr_record_success(cr)
    cr = cr_record_success(cr)
    cr = cr_record_success(cr)
    cr = cr_record_success(cr)
    cr = cr_record_success(cr)
    cr = cr_record_success(cr)
    cr = cr_record_success(cr)
    cr = cr_record_error(cr)
    assert(cr_total_requests(cr) == 10, "10 total")
    assert(cr_error_rate(cr) == 10, "10% error rate")

    assert(cr_should_promote(cr, 10, 15) == 1, "should promote (10% < 15%)")
    assert(cr_should_promote(cr, 10, 5) == 0, "too many errors (10% > 5%)")
    assert(cr_should_promote(cr, 20, 15) == 0, "not enough requests")

    cr = cr_set_weight(cr, 50)
    assert(cr_weight(cr) == 50, "weight=50")

    cr = cr_promote(cr)
    assert(cr_status(cr) == "promoted", "promoted")
    assert(cr_weight(cr) == 100, "weight=100")

    let cr2 = cr_new("v2.2.0")
    cr2 = cr_start(cr2, 5)
    cr2 = cr_set_threshold(cr2, 3)
    cr2 = cr_record_error(cr2)
    cr2 = cr_record_error(cr2)
    assert(cr_status(cr2) == "active", "still active")
    cr2 = cr_record_error(cr2)
    assert(cr_status(cr2) == "failed", "auto-failed at threshold")

    cr2 = cr_rollback(cr2)
    assert(cr_status(cr2) == "rolled_back", "rolled back")
    assert(cr_weight(cr2) == 0, "weight=0 after rollback")

    print("CANARY-RELEASE KAT PASS")
