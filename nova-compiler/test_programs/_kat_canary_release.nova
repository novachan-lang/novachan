import forge_canary_release

fn main()
    let c = cr_new()
    c = cr_set_stable(c, "v1.0")

    let r1 = cr_start_canary(c, "v2.0", 10)
    assert(is_ok(r1), "start canary ok")
    c = unwrap(r1)
    assert(cr_is_canary_active(c) == 1, "canary active")

    assert(cr_route(c, 5) == "v2.0", "hash 5 -> canary (5 < 10)")
    assert(cr_route(c, 50) == "v1.0", "hash 50 -> stable")

    c = cr_record_canary(c, 1)
    c = cr_record_canary(c, 1)
    c = cr_record_canary(c, 0)
    assert(cr_canary_error_rate(c) == 33, "33% canary error")

    let r2 = cr_promote(c)
    assert(is_ok(r2), "promote ok")
    c = unwrap(r2)
    assert(cr_is_canary_active(c) == 0, "canary done")
    assert(cr_total_promoted(c) == 1, "1 promoted")

    let r3 = cr_abort(c)
    assert(is_err(r3), "nothing to abort")

    let bad = cr_start_canary(cr_new(), "v2", 10)
    assert(is_err(bad), "no stable err")

    print("CANARY-RELEASE KAT PASS")
