import forge_multgroup as mg

fn check(cond: bool, label: string)
    if cond == false
        print("FAIL: " + label)

fn main()
    // ---- mobius: fixed values ----
    check(mg.mobius(1) == 1, "mu 1")
    check(mg.mobius(2) == 0 - 1, "mu 2")
    check(mg.mobius(3) == 0 - 1, "mu 3")
    check(mg.mobius(4) == 0, "mu 4 (2^2)")
    check(mg.mobius(6) == 1, "mu 6 (2*3)")
    check(mg.mobius(7) == 0 - 1, "mu 7")
    check(mg.mobius(9) == 0, "mu 9 (3^2)")
    check(mg.mobius(12) == 0, "mu 12")
    check(mg.mobius(30) == 0 - 1, "mu 30 (2*3*5)")
    check(mg.mobius(210) == 1, "mu 210 (2*3*5*7)")
    check(mg.mobius(0) == 0, "mu 0")

    // ---- mobius: divisor-sum identity  sum_{d|n} mu(d) = [n==1] ----
    let n = 1
    while n <= 40
        let s = 0
        let d = 1
        while d <= n
            if n % d == 0
                s = s + mg.mobius(d)
            d = d + 1
        let want = 0
        if n == 1
            want = 1
        check(s == want, "mobius divisor-sum n=" + str(n))
        n = n + 1

    // ---- multiplicative_order: fixed ----
    check(mg.multiplicative_order(1, 7) == 1, "ord 1 mod7")
    check(mg.multiplicative_order(2, 7) == 3, "ord 2 mod7")   // 2,4,1
    check(mg.multiplicative_order(3, 7) == 6, "ord 3 mod7")   // primitive root
    check(mg.multiplicative_order(4, 7) == 3, "ord 4 mod7")   // 4,2,1
    check(mg.multiplicative_order(2, 5) == 4, "ord 2 mod5")   // 2,4,3,1
    check(mg.multiplicative_order(2, 9) == 6, "ord 2 mod9")   // 2,4,8,7,5,1
    check(mg.multiplicative_order(10, 7) == 6, "ord 10 mod7") // repeating decimal 1/7 period 6
    // non-coprime -> no order
    check(mg.multiplicative_order(2, 4) == 0 - 1, "ord 2 mod4 (gcd)")
    check(mg.multiplicative_order(3, 6) == 0 - 1, "ord 3 mod6 (gcd)")
    check(mg.multiplicative_order(6, 8) == 0 - 1, "ord 6 mod8 (gcd)")

    // ---- multiplicative_order self-check: a^order == 1 for all coprime a in a range ----
    let mods = [5, 7, 9, 11, 13, 16]
    let mi = 0
    while mi < len(mods)
        let mm = mods[mi]
        let a = 1
        while a < mm
            let ord = mg.multiplicative_order(a, mm)
            if ord > 0
                // verify a^ord mod mm == 1
                let val = 1
                let c = 0
                while c < ord
                    val = (val * a) % mm
                    c = c + 1
                check(val == 1, "a^ord==1 a=" + str(a) + " mod " + str(mm))
            a = a + 1
        mi = mi + 1

    // ---- primitive roots ----
    check(mg.primitive_root(2) == 1, "primroot 2")
    check(mg.primitive_root(3) == 2, "primroot 3")
    check(mg.primitive_root(5) == 2, "primroot 5")
    check(mg.primitive_root(7) == 3, "primroot 7")     // 2 fails, 3 is smallest
    check(mg.primitive_root(11) == 2, "primroot 11")
    check(mg.primitive_root(13) == 2, "primroot 13")
    check(mg.primitive_root(23) == 5, "primroot 23")   // smallest primitive root mod 23 is 5
    check(mg.primitive_root(101) == 2, "primroot 101")

    check(mg.is_primitive_root(3, 7), "is_primroot 3 mod7")
    check(mg.is_primitive_root(2, 7) == false, "is_primroot 2 mod7 false")
    check(mg.is_primitive_root(5, 7), "is_primroot 5 mod7")

    // ---- self-check: a primitive root g of p has order exactly p-1 ----
    let primes = [3, 5, 7, 11, 13, 23, 101]
    let pi = 0
    while pi < len(primes)
        let p = primes[pi]
        let g = mg.primitive_root(p)
        check(mg.multiplicative_order(g, p) == p - 1, "primroot has order p-1, p=" + str(p))
        pi = pi + 1

    print("forge_multgroup: all passed")
