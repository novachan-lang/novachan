// showcase_analytics_test.nova
// Descriptive-statistics analytics pipeline.
// Classic dataset: [2, 4, 4, 4, 5, 5, 7, 9] (textbook float-array stats).
// Self-checks every result against hand-computed expected values.

import std/math/stats

fn _abs_diff(a: float, b: float) -> float
    let d = a - b
    if d < 0.0
        let nd = 0.0 - d
        return nd
    d

fn _near(a: float, b: float) -> int
    let diff = _abs_diff(a, b)
    if diff < 0.0001
        return 1
    0

fn main()
    // --- Dataset 1: textbook set [2, 4, 4, 4, 5, 5, 7, 9] ---
    let xs = []
    xs.push(2.0)
    xs.push(4.0)
    xs.push(4.0)
    xs.push(4.0)
    xs.push(5.0)
    xs.push(5.0)
    xs.push(7.0)
    xs.push(9.0)

    // sum
    let got_sum = stats_sum(xs)
    if _near(got_sum, 40.0) == 0
        print("FAIL sum: expected 40.0 got " + str(got_sum))
        exit(1)

    // mean
    let got_mean = stats_mean(xs)
    if _near(got_mean, 5.0) == 0
        print("FAIL mean: expected 5.0 got " + str(got_mean))
        exit(1)

    // min
    let got_min = stats_min(xs)
    if _near(got_min, 2.0) == 0
        print("FAIL min: expected 2.0 got " + str(got_min))
        exit(1)

    // max
    let got_max = stats_max(xs)
    if _near(got_max, 9.0) == 0
        print("FAIL max: expected 9.0 got " + str(got_max))
        exit(1)

    // median: sorted=[2,4,4,4,5,5,7,9], n=8 even, (s[3]+s[4])/2 = (4+5)/2 = 4.5
    let got_median = stats_median(xs)
    if _near(got_median, 4.5) == 0
        print("FAIL median: expected 4.5 got " + str(got_median))
        exit(1)

    // variance (population): deviations^2 sum=32, /8 = 4.0
    let got_var = stats_variance(xs)
    if _near(got_var, 4.0) == 0
        print("FAIL variance: expected 4.0 got " + str(got_var))
        exit(1)

    // stddev: sqrt(4.0) = 2.0
    let got_sd = stats_stddev(xs)
    if _near(got_sd, 2.0) == 0
        print("FAIL stddev: expected 2.0 got " + str(got_sd))
        exit(1)

    // --- Histogram over range [2..9] with bucket width=1 ---
    // Bucket k covers [2+k, 2+k+1) for k=0..6 (7 buckets).
    // Values: 2->b0, 4->b2, 4->b2, 4->b2, 5->b3, 5->b3, 7->b5, 9 falls >=9 so clamp to last bucket.
    // Expected counts: b0=1, b1=0, b2=3, b3=2, b4=0, b5=1, b6=1 (9 goes to last bucket) -> sum=8
    let bucket_min = 2.0
    let bucket_width = 1.0
    let n_buckets = 7
    let buckets = []
    let bi = 0
    while bi < n_buckets
        buckets.push(0)
        bi = bi + 1

    // Count via integer loop — do NOT use floor() as an index
    let xi = 0
    while xi < len(xs)
        let v = xs[xi]
        // Determine bucket by counting from bucket_min in steps of bucket_width
        let bk = 0
        let boundary = bucket_min + bucket_width
        while bk < n_buckets - 1 and v >= boundary
            bk = bk + 1
            boundary = boundary + bucket_width
        buckets[bk] = buckets[bk] + 1
        xi = xi + 1

    // Assert bucket totals sum to dataset size (8)
    let bucket_total = 0
    let ci = 0
    while ci < n_buckets
        bucket_total = bucket_total + buckets[ci]
        ci = ci + 1

    if bucket_total != 8
        print("FAIL histogram total: expected 8 got " + str(bucket_total))
        exit(1)

    // Assert specific known bucket counts
    // b0 (2..3): 1 value (2.0)
    if buckets[0] != 1
        print("FAIL histogram b0: expected 1 got " + str(buckets[0]))
        exit(1)
    // b1 (3..4): 0 values
    if buckets[1] != 0
        print("FAIL histogram b1: expected 0 got " + str(buckets[1]))
        exit(1)
    // b2 (4..5): 3 values (4,4,4)
    if buckets[2] != 3
        print("FAIL histogram b2: expected 3 got " + str(buckets[2]))
        exit(1)
    // b3 (5..6): 2 values (5,5)
    if buckets[3] != 2
        print("FAIL histogram b3: expected 2 got " + str(buckets[3]))
        exit(1)
    // b4 (6..7): 0 values
    if buckets[4] != 0
        print("FAIL histogram b4: expected 0 got " + str(buckets[4]))
        exit(1)
    // b5 (7..8): 1 value (7)
    if buckets[5] != 1
        print("FAIL histogram b5: expected 1 got " + str(buckets[5]))
        exit(1)
    // b6 (8..): 1 value (9) — clamped to last
    if buckets[6] != 1
        print("FAIL histogram b6: expected 1 got " + str(buckets[6]))
        exit(1)

    // --- Percentile / IQR checks on main dataset ---
    // Q1 (p=25): rank = 0.25 * 7 = 1.75; lo=1,hi=2; s[1]=4, s[2]=4; result = 4 + 0.75*(4-4) = 4.0
    let got_q1 = stats_percentile(xs, 25)
    if _near(got_q1, 4.0) == 0
        print("FAIL Q1: expected 4.0 got " + str(got_q1))
        exit(1)

    // Q3 (p=75): rank = 0.75 * 7 = 5.25; lo=5,hi=6; s[5]=5, s[6]=7; result = 5 + 0.25*2 = 5.5
    let got_q3 = stats_percentile(xs, 75)
    if _near(got_q3, 5.5) == 0
        print("FAIL Q3: expected 5.5 got " + str(got_q3))
        exit(1)

    // p=0 must equal min
    let got_p0 = stats_percentile(xs, 0)
    if _near(got_p0, 2.0) == 0
        print("FAIL p0: expected 2.0 got " + str(got_p0))
        exit(1)

    // p=100 must equal max
    let got_p100 = stats_percentile(xs, 100)
    if _near(got_p100, 9.0) == 0
        print("FAIL p100: expected 9.0 got " + str(got_p100))
        exit(1)

    // p=50 must equal median = 4.5
    let got_p50 = stats_percentile(xs, 50)
    if _near(got_p50, 4.5) == 0
        print("FAIL p50: expected 4.5 got " + str(got_p50))
        exit(1)

    // --- IQR outlier detection on dataset with obvious outlier ---
    // Dataset: [1, 2, 3, 4, 5, 100]
    // Q1(p25): rank=0.25*5=1.25; lo=1,hi=2; s[1]=2,s[2]=3; 2+0.25*1=2.25
    // Q3(p75): rank=0.75*5=3.75; lo=3,hi=4; s[3]=4,s[4]=5; 4+0.75*1=4.75
    // IQR=2.5; upper_fence=4.75+1.5*2.5=4.75+3.75=8.5
    // 100 > 8.5 => flagged as outlier
    let ys = []
    ys.push(1.0)
    ys.push(2.0)
    ys.push(3.0)
    ys.push(4.0)
    ys.push(5.0)
    ys.push(100.0)

    let iq1 = stats_percentile(ys, 25)
    let iq3 = stats_percentile(ys, 75)

    if _near(iq1, 2.25) == 0
        print("FAIL outlier Q1: expected 2.25 got " + str(iq1))
        exit(1)
    if _near(iq3, 4.75) == 0
        print("FAIL outlier Q3: expected 4.75 got " + str(iq3))
        exit(1)

    let iqr = iq3 - iq1
    if _near(iqr, 2.5) == 0
        print("FAIL IQR: expected 2.5 got " + str(iqr))
        exit(1)

    let upper_fence = iq3 + iqr * 1.5
    if _near(upper_fence, 8.5) == 0
        print("FAIL upper_fence: expected 8.5 got " + str(upper_fence))
        exit(1)

    // Check that 100.0 is an outlier (above upper fence)
    if 100.0 <= upper_fence
        print("FAIL outlier detection: 100.0 should be above upper_fence " + str(upper_fence))
        exit(1)

    // Check that 5.0 is NOT an outlier
    if 5.0 > upper_fence
        print("FAIL outlier detection: 5.0 should be within fence " + str(upper_fence))
        exit(1)

    // Count outliers in ys
    let outlier_count = 0
    let oi = 0
    while oi < len(ys)
        let v = ys[oi]
        if v > upper_fence
            outlier_count = outlier_count + 1
        oi = oi + 1

    if outlier_count != 1
        print("FAIL outlier count: expected 1 got " + str(outlier_count))
        exit(1)

    print("showcase_analytics_test passed")
