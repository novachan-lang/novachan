import forge_wavelettree as wt

fn check(cond: bool, label: str)
    if cond == false
        print("FAIL: " + label)

// TEST 1: Simple array [1, 3, 2, 1, 3, 1]
// arr[0..5] = [1,3,2,1,3,1], max_val=3
let arr = [1, 3, 2, 1, 3, 1]
let tree = wt.wt_build(arr, 3)

// Frequency queries
check(wt.wt_freq(tree, 0, 5, 1) == 3, "freq(all, 1)=3")
check(wt.wt_freq(tree, 0, 5, 2) == 1, "freq(all, 2)=1")
check(wt.wt_freq(tree, 0, 5, 3) == 2, "freq(all, 3)=2")

// Range frequency
check(wt.wt_freq(tree, 1, 3, 1) == 1, "freq([1..3], 1)=1 (arr[1..3]=[3,2,1])")
check(wt.wt_freq(tree, 0, 2, 1) == 1, "freq([0..2], 1)=1 (arr[0..2]=[1,3,2])")

// kth smallest in full array [1,1,1,2,3,3] sorted = 1,1,1,2,3,3
check(wt.wt_kth(tree, 0, 5, 1) == 1, "kth(all,1)=1 (1st smallest)")
check(wt.wt_kth(tree, 0, 5, 2) == 1, "kth(all,2)=1 (2nd smallest)")
check(wt.wt_kth(tree, 0, 5, 3) == 1, "kth(all,3)=1 (3rd smallest)")
check(wt.wt_kth(tree, 0, 5, 4) == 2, "kth(all,4)=2 (4th smallest)")
check(wt.wt_kth(tree, 0, 5, 5) == 3, "kth(all,5)=3 (5th smallest)")
check(wt.wt_kth(tree, 0, 5, 6) == 3, "kth(all,6)=3 (6th smallest)")

// rank_less: count values < v in arr[l..r]
check(wt.wt_rank_less(tree, 0, 5, 3) == 4, "rank_less(all,<3)=4 (1,1,2,1 -> 4 values < 3)")
check(wt.wt_rank_less(tree, 0, 5, 2) == 3, "rank_less(all,<2)=3 (three 1s)")
check(wt.wt_rank_less(tree, 0, 5, 1) == 0, "rank_less(all,<1)=0")

// TEST 2: Range kth - arr[1..4] = [3,2,1,3], sorted = [1,2,3,3]
check(wt.wt_kth(tree, 1, 4, 1) == 1, "kth([1..4],1)=1")
check(wt.wt_kth(tree, 1, 4, 2) == 2, "kth([1..4],2)=2")
check(wt.wt_kth(tree, 1, 4, 3) == 3, "kth([1..4],3)=3")
check(wt.wt_kth(tree, 1, 4, 4) == 3, "kth([1..4],4)=3")

// TEST 3: Single element range
check(wt.wt_freq(tree, 2, 2, 2) == 1, "freq single elem arr[2]=2")
check(wt.wt_freq(tree, 2, 2, 1) == 0, "freq single elem arr[2]!=1")
check(wt.wt_kth(tree, 0, 0, 1) == 1, "kth single arr[0]=1")

// TEST 4: DECISIVE brute force cross-check
// Build random-ish array [2,0,3,1,0,2,3,1,2,0] max_val=3
let arr2 = [2, 0, 3, 1, 0, 2, 3, 1, 2, 0]
let tree2 = wt.wt_build(arr2, 3)

fn brute_freq(arr: list, l: int, r: int, v: int) -> int
    let cnt = 0
    let i = l
    while i <= r
        if arr[i] == v
            cnt = cnt + 1
        i = i + 1
    return cnt

fn brute_rank_less(arr: list, l: int, r: int, v: int) -> int
    let cnt = 0
    let i = l
    while i <= r
        if arr[i] < v
            cnt = cnt + 1
        i = i + 1
    return cnt

fn brute_kth(arr: list, l: int, r: int, k: int) -> int
    // Collect subarray, find k-th smallest via counting
    let sub = []
    let i = l
    while i <= r
        push(sub, arr[i])
        i = i + 1
    // Simple selection: for k-th smallest, count how many < min+delta
    let mn = sub[0]
    let ii = 1
    while ii < len(sub)
        if sub[ii] < mn
            mn = sub[ii]
        ii = ii + 1
    // Try each value from min up
    let v = mn
    let cnt = 0
    let jj = 0
    while jj < len(sub)
        if sub[jj] == v
            cnt = cnt + 1
        jj = jj + 1
    // k-th smallest: keep track
    let cumul = 0
    let vv = 0
    while vv <= 10
        let c2 = 0
        let jj2 = 0
        while jj2 < len(sub)
            if sub[jj2] == vv
                c2 = c2 + 1
            jj2 = jj2 + 1
        if cumul + c2 >= k
            return vv
        cumul = cumul + c2
        vv = vv + 1
    return -1

let n = len(arr2)
let ok_freq = true
let ok_rank = true
let ok_kth = true
let l = 0
while l < n
    let r = l
    while r < n
        let v = 0
        while v <= 3
            let expected_f = brute_freq(arr2, l, r, v)
            let got_f = wt.wt_freq(tree2, l, r, v)
            if expected_f != got_f
                ok_freq = false
                print("FREQ MISMATCH l=" + str(l) + " r=" + str(r) + " v=" + str(v) + " exp=" + str(expected_f) + " got=" + str(got_f))
            let expected_r = brute_rank_less(arr2, l, r, v)
            let got_r = wt.wt_rank_less(tree2, l, r, v)
            if expected_r != got_r
                ok_rank = false
                print("RANK MISMATCH l=" + str(l) + " r=" + str(r) + " v=" + str(v) + " exp=" + str(expected_r) + " got=" + str(got_r))
            v = v + 1
        // kth check
        let range_size = r - l + 1
        let kk = 1
        while kk <= range_size
            let exp_kth = brute_kth(arr2, l, r, kk)
            let got_kth = wt.wt_kth(tree2, l, r, kk)
            if exp_kth != got_kth
                ok_kth = false
                print("KTH MISMATCH l=" + str(l) + " r=" + str(r) + " k=" + str(kk) + " exp=" + str(exp_kth) + " got=" + str(got_kth))
            kk = kk + 1
        r = r + 1
    l = l + 1

check(ok_freq, "brute cross-check freq: all ranges x values correct")
check(ok_rank, "brute cross-check rank_less: all ranges x values correct")
check(ok_kth, "brute cross-check kth: all ranges x k correct")

print("forge_wavelettree: KAT done")
