import forge_telemetry_store

fn main()
    let s = ts_new()
    assert(ts_device_count(s) == 0, "0 devices")
    assert(ts_total_records(s) == 0, "0 records")

    s = ts_record(s, "d1", "temp", 23, 1000)
    s = ts_record(s, "d1", "temp", 24, 2000)
    s = ts_record(s, "d1", "humidity", 50, 1500)

    let lv = ts_latest(s, "d1", "temp")
    assert(is_ok(lv), "latest ok")
    assert(unwrap(lv) == 24, "latest temp 24")

    let lt = ts_latest_time(s, "d1", "temp")
    assert(is_ok(lt), "latest time ok")
    assert(unwrap(lt) == 2000, "latest time 2000")

    let ct = ts_count(s, "d1", "temp")
    assert(is_ok(ct), "count ok")
    assert(unwrap(ct) == 2, "count 2")

    let ch = ts_count(s, "d1", "humidity")
    assert(unwrap(ch) == 1, "humidity count 1")

    let ml = ts_metric_list(s, "d1")
    assert(is_ok(ml), "metric list ok")
    assert(unwrap(ml) == "temp,humidity", "metric list temp,humidity")

    assert(ts_device_count(s) == 1, "1 device")
    assert(ts_total_records(s) == 3, "3 records")

    s = ts_record(s, "d2", "temp", 10, 500)
    assert(ts_device_count(s) == 2, "2 devices")
    assert(ts_total_records(s) == 4, "4 records")

    let missing = ts_latest(s, "d3", "temp")
    assert(is_err(missing), "unknown device err")

    let missing2 = ts_metric_list(s, "d3")
    assert(is_err(missing2), "unknown device metric list err")

    print("TELEMETRY-STORE KAT PASS")
