import std/game/war

fn assert_int(label: string, got: int, want: int)
    if got != want
        print("FAIL war " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn assert_card(label: string, got: list, want_rank: int, want_suit: int)
    let gr = got[0]
    let gs = got[1]
    if gr != want_rank or gs != want_suit
        print("FAIL war " + label + ": got [" + str(gr) + "," + str(gs) + "] want [" + str(want_rank) + "," + str(want_suit) + "]")
        exit(1)

fn main()
    // war_battle: K of clubs vs Q of diamonds -> 1 (K > Q)
    let king_clubs = [13, 0]
    let queen_diamonds = [12, 1]
    let b1 = war_battle(king_clubs, queen_diamonds)
    assert_int("battle_K_beats_Q", b1, 1)

    // war_battle: 2 of clubs vs A of diamonds -> -1 (2 < A)
    let two_clubs = [2, 0]
    let ace_diamonds = [14, 1]
    let b2 = war_battle(two_clubs, ace_diamonds)
    assert_int("battle_2_loses_to_A", b2, -1)

    // war_battle: 7 of clubs vs 7 of spades -> 0 (tie, suit irrelevant)
    let seven_clubs = [7, 0]
    let seven_spades = [7, 3]
    let b3 = war_battle(seven_clubs, seven_spades)
    assert_int("battle_tie_7_7", b3, 0)

    // war_higher: [13,0] vs [12,0] -> [13,0]
    let kc = [13, 0]
    let qc = [12, 0]
    let h1 = war_higher(kc, qc)
    assert_card("higher_K_over_Q", h1, 13, 0)

    // war_higher: tie case -> a is returned
    let seven_c = [7, 0]
    let seven_s = [7, 3]
    let h2 = war_higher(seven_c, seven_s)
    assert_card("higher_tie_returns_a", h2, 7, 0)

    // war_higher: b wins
    let two_c = [2, 0]
    let ace_s = [14, 3]
    let h3 = war_higher(two_c, ace_s)
    assert_card("higher_A_over_2", h3, 14, 3)

    // war_round: [[10,0],[2,0]] vs [[9,0],[5,0]] -> 1 (10 > 9)
    let hand_a = [[10, 0], [2, 0]]
    let hand_b = [[9, 0], [5, 0]]
    let r1 = war_round(hand_a, hand_b)
    assert_int("round_10_beats_9", r1, 1)

    // war_round: tie on top card
    let hand_c = [[7, 0], [3, 0]]
    let hand_d = [[7, 1], [4, 0]]
    let r2 = war_round(hand_c, hand_d)
    assert_int("round_tie_7_7", r2, 0)

    // war_round: b hand wins
    let hand_e = [[3, 0], [8, 0]]
    let hand_f = [[14, 0], [2, 0]]
    let r3 = war_round(hand_e, hand_f)
    assert_int("round_A_beats_3", r3, -1)

    print("PASS _war_test")
