// Oracle for NOVA's own TLS SERVER (tls_listen/tls_accept) + TLS client (tls_connect),
// both via OpenSSL on Linux. A spawned NOVA TLS server (self-signed cert) accepts a
// connection, reads a request, and replies over TLS; the NOVA TLS client connects,
// sends "ping", and must receive "pong-tls" — proving a real end-to-end TLS handshake
// between NOVA's own server and client.
fn main()
    spawn fn()
        let srv = tls_listen(18443, "cert.pem", "key.pem")
        let conn = tls_accept(srv)
        tls_recv(conn, 1024)
        tls_send(conn, "pong-tls")
        tls_close(conn)
    sleep(1000)
    let c = tls_connect("127.0.0.1", 18443)
    tls_send(c, "ping")
    let resp = tls_recv(c, 1024)
    print("tls client got: [{resp}]")
    assert_eq(resp, "pong-tls")
    tls_close(c)
    print("tls server loopback test passed")
