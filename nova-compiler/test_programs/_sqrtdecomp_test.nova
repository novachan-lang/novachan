import std/collections/sqrtdecomp

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn main()
    // Build structure from [1,2,3,4,5,6,7,8,9]
    let arr = [1, 2, 3, 4, 5, 6, 7, 8, 9]
    let s = sqd_new(arr)

    // KAT 1: full range sum 0..8 = 1+2+3+4+5+6+7+8+9 = 45
    cki("range_sum(0,8)", sqd_range_sum(s, 0, 8), 45)

    // KAT 2: partial range sum 2..5 = 3+4+5+6 = 18
    cki("range_sum(2,5)", sqd_range_sum(s, 2, 5), 18)

    // KAT 3: single element at 0 = 1
    cki("range_sum(0,0)", sqd_range_sum(s, 0, 0), 1)

    // KAT 4: point query at 3 = 4
    cki("point(3) before update", sqd_point(s, 3), 4)

    // Update index 3: set to 10 (was 4, so 2..5 = 3+10+5+6 = 24)
    sqd_update(s, 3, 10)

    // KAT 5: range sum 2..5 after update = 3+10+5+6 = 24
    cki("range_sum(2,5) after update", sqd_range_sum(s, 2, 5), 24)

    // KAT 6: point query at 3 = 10
    cki("point(3) after update", sqd_point(s, 3), 10)

    // KAT 7: single element range 4..4 = 5
    cki("range_sum(4,4)", sqd_range_sum(s, 4, 4), 5)

    // KAT 8: full range sum after update = 45 - 4 + 10 = 51
    cki("range_sum(0,8) after update", sqd_range_sum(s, 0, 8), 51)

    // KAT 9: range crossing block boundaries, e.g. 1..7 = 2+3+10+5+6+7+8 = 41
    cki("range_sum(1,7)", sqd_range_sum(s, 1, 7), 41)

    print("_sqrtdecomp_test passed")
