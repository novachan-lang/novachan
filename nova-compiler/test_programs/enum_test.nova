enum Shape
    Circle(radius: Float)
    Rectangle(width: Float, height: Float)

fn area(s)
    match s
        Circle(r) => 3.14159 * r * r
        Rectangle(w, h) => w * h
        _ => 0.0

c = Circle(5.0)
r = Rectangle(4.0, 6.0)

print(area(c))
print(area(r))

c2 = Circle { radius: 3.0 }
print(area(c2))

enum Color
    Red()
    Green()
    Blue()

fn color_name(c)
    match c
        Red(_) => "red"
        Green(_) => "green"
        Blue(_) => "blue"
        _ => "unknown"

col = Green()
print(color_name(col))
