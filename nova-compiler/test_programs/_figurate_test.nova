import std/math/figurate

// cki — check integer equality; print FAIL+exit(1) on mismatch
fn cki(label: string, got: int, expected: int)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// ckb — check boolean equality; print FAIL+exit(1) on mismatch
fn ckb(label: string, got: bool, expected: bool)
    if got != expected
        let gs = "false"
        if got
            gs = "true"
        let es = "false"
        if expected
            es = "true"
        print("FAIL " + label + ": got " + gs + " expected " + es)
        exit(1)

fn main()
    // KAT 1: fg_triangular(1) = 1*(1+1)/2 = 1
    cki("fg_triangular(1)", fg_triangular(1), 1)

    // KAT 2: fg_triangular(4) = 4*5/2 = 10
    cki("fg_triangular(4)", fg_triangular(4), 10)

    // KAT 3: fg_triangular(10) = 10*11/2 = 55
    cki("fg_triangular(10)", fg_triangular(10), 55)

    // KAT 4: fg_square(5) = 5*5 = 25
    cki("fg_square(5)", fg_square(5), 25)

    // KAT 5: fg_pentagonal(3) = 3*(9-1)/2 = 3*8/2 = 12
    cki("fg_pentagonal(3)", fg_pentagonal(3), 12)

    // KAT 6: fg_hexagonal(3) = 3*(6-1) = 3*5 = 15
    cki("fg_hexagonal(3)", fg_hexagonal(3), 15)

    // KAT 7: fg_is_triangular(10) = true (k=4: 4*5/2=10; disc=81=9^2)
    ckb("fg_is_triangular(10)", fg_is_triangular(10), true)

    // KAT 8: fg_is_triangular(11) = false (8*11+1=89, not a perfect square)
    ckb("fg_is_triangular(11)", fg_is_triangular(11), false)

    // KAT 9: fg_triangular_index(55) = 10 (10*11/2=55)
    cki("fg_triangular_index(55)", fg_triangular_index(55), 10)

    // KAT 10: fg_pentagonal(1)=1, fg_pentagonal(2)=5, fg_pentagonal(4)=22
    cki("fg_pentagonal(1)", fg_pentagonal(1), 1)
    cki("fg_pentagonal(2)", fg_pentagonal(2), 5)
    cki("fg_pentagonal(4)", fg_pentagonal(4), 22)

    // KAT 11: fg_hexagonal(1)=1, fg_hexagonal(2)=6
    cki("fg_hexagonal(1)", fg_hexagonal(1), 1)
    cki("fg_hexagonal(2)", fg_hexagonal(2), 6)

    // KAT 12: fg_is_pentagonal(12)=true (k=3: 3*(9-1)/2=12; disc=24*12+1=289=17^2; (1+17)%6=0)
    ckb("fg_is_pentagonal(12)", fg_is_pentagonal(12), true)

    // KAT 13: fg_is_pentagonal(11)=false (24*11+1=265; sqrt(265)~16.27, not integer)
    ckb("fg_is_pentagonal(11)", fg_is_pentagonal(11), false)

    // KAT 14: fg_is_pentagonal(1)=true (k=1: 1*(3-1)/2=1)
    ckb("fg_is_pentagonal(1)", fg_is_pentagonal(1), true)

    // KAT 15: fg_triangular_index(1)=1, fg_triangular_index(10)=4
    cki("fg_triangular_index(1)", fg_triangular_index(1), 1)
    cki("fg_triangular_index(10)", fg_triangular_index(10), 4)

    // KAT 16: fg_triangular_index(11)=-1 (11 is not triangular)
    cki("fg_triangular_index(11)", fg_triangular_index(11), -1)

    // KAT 17: fg_square(0)=0, fg_square(1)=1, fg_square(10)=100
    cki("fg_square(0)", fg_square(0), 0)
    cki("fg_square(10)", fg_square(10), 100)

    // KAT 18: fg_is_triangular(0)=true (k=0: 0*1/2=0)
    ckb("fg_is_triangular(0)", fg_is_triangular(0), true)

    // KAT 19: fg_is_triangular(1)=true (k=1: 1*2/2=1)
    ckb("fg_is_triangular(1)", fg_is_triangular(1), true)

    // KAT 20: fg_triangular_index(0)=0
    cki("fg_triangular_index(0)", fg_triangular_index(0), 0)

    print("_figurate_test passed")
