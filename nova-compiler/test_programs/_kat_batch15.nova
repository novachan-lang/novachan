// KAT for batch 15 builtins (1199-1205)
let pass = 0
let fail = 0

// list_mean
let m1 = list_mean([10, 20, 30])
if m1 == 20
    pass = pass + 1
else
    print("FAIL list_mean: expected 20 got " + str(m1))
    fail = fail + 1

let m2 = list_mean([])
if m2 == 0
    pass = pass + 1
else
    print("FAIL list_mean empty: expected 0 got " + str(m2))
    fail = fail + 1

// str_remove_letters
let rl1 = str_remove_letters("abc123def")
if rl1 == "123"
    pass = pass + 1
else
    print("FAIL str_remove_letters: expected '123' got '" + rl1 + "'")
    fail = fail + 1

let rl2 = str_remove_letters("!@#$")
if rl2 == "!@#$"
    pass = pass + 1
else
    print("FAIL str_remove_letters no letters: expected '!@#$' got '" + rl2 + "'")
    fail = fail + 1

// list_accumulate
let ac1 = list_accumulate([1, 2, 3, 4])
if str(ac1) == "[1, 3, 6, 10]"
    pass = pass + 1
else
    print("FAIL list_accumulate: expected [1, 3, 6, 10] got " + str(ac1))
    fail = fail + 1

let ac2 = list_accumulate([])
if len(ac2) == 0
    pass = pass + 1
else
    print("FAIL list_accumulate empty: expected [] got " + str(ac2))
    fail = fail + 1

// str_is_sentence
let is1 = str_is_sentence("Hello world.")
if is1 == true
    pass = pass + 1
else
    print("FAIL str_is_sentence: expected true")
    fail = fail + 1

let is2 = str_is_sentence("hello world.")
if is2 == false
    pass = pass + 1
else
    print("FAIL str_is_sentence lowercase: expected false")
    fail = fail + 1

let is3 = str_is_sentence("Hello world")
if is3 == false
    pass = pass + 1
else
    print("FAIL str_is_sentence no punct: expected false")
    fail = fail + 1

// dict_values_max
let dvm_d = {"a": 10, "b": 30, "c": 20}
let dvm = dict_values_max(dvm_d)
if dvm == 30
    pass = pass + 1
else
    print("FAIL dict_values_max: expected 30 got " + str(dvm))
    fail = fail + 1

// list_span_indices
let si1 = list_span_indices([5, 3, 5, 7, 5], 5)
if str(si1) == "[0, 2, 4]"
    pass = pass + 1
else
    print("FAIL list_span_indices: expected [0, 2, 4] got " + str(si1))
    fail = fail + 1

let si2 = list_span_indices([1, 2, 3], 9)
if len(si2) == 0
    pass = pass + 1
else
    print("FAIL list_span_indices none: expected [] got " + str(si2))
    fail = fail + 1

// str_squeeze_char
let sq1 = str_squeeze_char("aaabbbccc", "b")
if sq1 == "aaabccc"
    pass = pass + 1
else
    print("FAIL str_squeeze_char: expected 'aaabccc' got '" + sq1 + "'")
    fail = fail + 1

let sq2 = str_squeeze_char("hello", "x")
if sq2 == "hello"
    pass = pass + 1
else
    print("FAIL str_squeeze_char no match: expected 'hello' got '" + sq2 + "'")
    fail = fail + 1

print("Batch 15 KAT: " + str(pass) + " passed, " + str(fail) + " failed")
