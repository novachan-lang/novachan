// Forge TLS 1.3 CertificateVerify dispatch: validate the ed25519 + ecdsa_secp256r1_sha256 routes by
// self-constructing CertificateVerify signatures and verifying them through tls13_verify_cert_signature.
import forge_tls
import forge_crypto
import forge_p256
import forge_x509

// DER INTEGER from a 32-byte big-endian field (strip leading zeros, prepend 0x00 if high bit set).
fn _der_int(b32) -> list
    let s = 0
    while s < 31 and b32[s] == 0
        s = s + 1
    let val = []
    if b32[s] >= 128
        push(val, 0)
    let i = s
    while i < 32
        push(val, b32[i])
        i = i + 1
    der_enc(2, val)

fn main()
    let th = sha256_bytes(str_to_blist("a fake transcript hash for the dispatch test only"))
    let content = tls13_certverify_content("TLS 1.3, client CertificateVerify", th)

    // ── Ed25519 route (0x0807): signs the content directly ──
    let sk = hex_to_blist("0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20")
    let edpub = ed25519_publickey(sk)
    let edsig = ed25519_sign(sk, content)
    if tls13_verify_cert_signature(2055, edpub, content, edsig) != 1
        print("FAIL: ed25519 CertVerify route")
        exit(1)
    let edbad = []
    let e = 0
    while e < len(edsig)
        push(edbad, edsig[e])
        e = e + 1
    edbad[5] = edbad[5] ^ 1
    if tls13_verify_cert_signature(2055, edpub, content, edbad) != 0
        print("FAIL: ed25519 tamper not rejected")
        exit(1)

    // ── ECDSA-P256 route (0x0403): DER-encoded sig over SHA-256(content) ──
    let d = hex_to_blist("c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721")
    let k = hex_to_blist("a6e3c57dd01abe90086538398355dd4c3b17aa873382b0f24d6129493d8aad60")
    let q = ecdsa_p256_pubkey(d)
    let echash = sha256_bytes(content)
    let rs = ecdsa_p256_sign(d, echash, k)
    let dersig = der_enc(48, x_cat(_der_int(rs[0]), _der_int(rs[1])))
    let ecpub = x_cat(x_cat(hex_to_blist("04"), q[0]), q[1])
    if tls13_verify_cert_signature(1027, ecpub, content, dersig) != 1
        print("FAIL: ecdsa_p256 CertVerify route")
        exit(1)
    let ecbad = []
    let c = 0
    while c < len(dersig)
        push(ecbad, dersig[c])
        c = c + 1
    ecbad[len(ecbad) - 1] = ecbad[len(ecbad) - 1] ^ 1
    if tls13_verify_cert_signature(1027, ecpub, content, ecbad) != 0
        print("FAIL: ecdsa tamper not rejected")
        exit(1)

    print("PASS forge_tls_cvd (CertificateVerify dispatch: ed25519 + ecdsa_p256 self-construct + tamper)")
