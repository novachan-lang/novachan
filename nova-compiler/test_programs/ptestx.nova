// ptestx — process-isolated parallel test execution.
//
// Each test runs in its OWN spawned Process: deep-copy isolation means one test's
// mutations can never corrupt another's data, and they run in parallel on the thread
// pool. Results are collected over a channel. A test is fn() -> int (1=pass, 0=fail);
// run_tests reports [passed, failed]. (Hard-crash isolation — a segfaulting test not
// taking down the runner — is the separate crash-isolation row; here value-level
// failures are fully isolated and parallelized, the NOVA way over spawn + channel.)

// helper: tf is a param (callable directly) so the spawn captures it cleanly.
fn _spawn_test(nm, tf, results)
    spawn fn()
        let ok = tf()
        send(results, [nm, ok])
    return 0

fn run_tests(tests)
    let results = channel()
    for t in tests
        _spawn_test(t[0], t[1], results)
    let passed = 0
    let failed = 0
    let i = 0
    let n = len(tests)
    while i < n
        let r = receive(results)
        if r[1] == 1
            passed = passed + 1
        else
            failed = failed + 1
        i = i + 1
    return [passed, failed]

fn t_pass()
    return 1
fn t_fail()
    return 0
fn t_compute()
    let s = 0
    let i = 0
    while i < 1000
        s = s + i
        i = i + 1
    if s == 499500
        return 1
    return 0
fn t_isolated()
    let xs = []
    let i = 0
    while i < 500
        push(xs, i * 2)
        i = i + 1
    if len(xs) == 500 and xs[499] == 998
        return 1
    return 0

fn main()
    let tests = [["pass", t_pass], ["fail", t_fail], ["compute", t_compute], ["isolated", t_isolated]]
    let r = run_tests(tests)
    assert_eq(r[0], 3)
    assert_eq(r[1], 1)
    print("ptestx passed")
