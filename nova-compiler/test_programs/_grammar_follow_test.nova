// _grammar_follow_test — KAT for std/grammar/grammar_follow.nova
// Uses the dragon-book LL(1) expression grammar:
//   E  -> T X
//   X  -> + T X
//   X  -> (epsilon)
//   T  -> F Y
//   Y  -> * F Y
//   Y  -> (epsilon)
//   F  -> ( E )
//   F  -> id
// Terminals: +  *  (  )  id
// Known FOLLOW sets (textbook):
//   FOLLOW(E) = FOLLOW(X) = { $ , ) }
//   FOLLOW(T) = FOLLOW(Y) = { + , $ , ) }
//   FOLLOW(F) = { * , + , $ , ) }
// Sorted lexicographically: "$" < ")" < "*" < "+"

import std/grammar/grammar_follow

fn ckl(label, got, want)
    if len(got) != len(want)
        print("FAIL " + label + ": len " + str(len(got)) + " != " + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL " + label + ": got[" + str(i) + "]=" + got[i] + " want=" + want[i])
            exit(1)
        i = i + 1

fn build_expr_grammar()
    // E -> T X
    let p1 = ["E", ["T", "X"]]
    // X -> + T X
    let p2 = ["X", ["+", "T", "X"]]
    // X -> epsilon
    let p3 = ["X", []]
    // T -> F Y
    let p4 = ["T", ["F", "Y"]]
    // Y -> * F Y
    let p5 = ["Y", ["*", "F", "Y"]]
    // Y -> epsilon
    let p6 = ["Y", []]
    // F -> ( E )
    let p7 = ["F", ["(", "E", ")"]]
    // F -> id
    let p8 = ["F", ["id"]]
    let prods = []
    prods.push(p1)
    prods.push(p2)
    prods.push(p3)
    prods.push(p4)
    prods.push(p5)
    prods.push(p6)
    prods.push(p7)
    prods.push(p8)
    return prods

fn main()
    let prods = build_expr_grammar()

    // FOLLOW(E) = ["$", ")"]
    let fe = grfo_follow(prods, "E", "E")
    let want_e = ["$", ")"]
    ckl("FOLLOW_E", fe, want_e)

    // FOLLOW(X) = ["$", ")"]   (same as FOLLOW(E))
    let fx = grfo_follow(prods, "E", "X")
    let want_x = ["$", ")"]
    ckl("FOLLOW_X", fx, want_x)

    // FOLLOW(T) = ["$", ")", "+"]
    let ft = grfo_follow(prods, "E", "T")
    let want_t = ["$", ")", "+"]
    ckl("FOLLOW_T", ft, want_t)

    // FOLLOW(Y) = ["$", ")", "+"]   (same as FOLLOW(T))
    let fy = grfo_follow(prods, "E", "Y")
    let want_y = ["$", ")", "+"]
    ckl("FOLLOW_Y", fy, want_y)

    // FOLLOW(F) = ["$", ")", "*", "+"]
    let ff = grfo_follow(prods, "E", "F")
    let want_f = ["$", ")", "*", "+"]
    ckl("FOLLOW_F", ff, want_f)

    print("PASS _grammar_follow_test")

main()
