fn main()
    let pair = (10, 20)
    let (a, b) = pair
    assert_eq(a, 10)
    assert_eq(b, 20)

    let (x, y, z) = (100, 200, 300)
    assert_eq(x, 100)
    assert_eq(y, 200)
    assert_eq(z, 300)

    let (_, second) = (999, 42)
    assert_eq(second, 42)

    let (first, _) = (77, 888)
    assert_eq(first, 77)

    let (_, mid, _) = (1, 2, 3)
    assert_eq(mid, 2)

    let items = [(1, "one"), (2, "two"), (3, "three")]
    let nums = []
    let names = []
    for (n, s) in items
        push(nums, n)
        push(names, s)
    assert_eq(nums, [1, 2, 3])
    assert_eq(names, ["one", "two", "three"])

    let nested = ((1, 2), (3, 4))
    let (inner1, inner2) = nested
    assert_eq(inner1, (1, 2))
    assert_eq(inner2, (3, 4))

    let result = []
    let pairs = [(10, 1), (20, 2), (30, 3)]
    for (val, idx) in pairs
        let (doubled, inc) = (val * 2, idx + 1)
        push(result, doubled + inc)
    assert_eq(result, [22, 43, 64])

    let (s1, s2) = ("hello", "world")
    assert_eq(s1, "hello")
    assert_eq(s2, "world")

    let data = get_pair()
    let (gp1, gp2) = data
    assert_eq(gp1, 42)
    assert_eq(gp2, 99)

    print("ALL LET DESTRUCTURING TESTS PASSED")

fn get_pair() -> list
    [42, 99]
