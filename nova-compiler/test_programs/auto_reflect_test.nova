// auto_reflect_test.nova -- locks in NOVA's AUTOMATIC structural identity (innovation D1):
// zero-annotation, compiler-derived to_json + structural == (flat AND nested) + copy + hashable-
// as-a-dict-key, for record structs. (json_stringify(struct) and from_json are already guarded by
// auto_json_test + from_json_test; this pins the rest, which were unguarded.) A codegen change that
// broke struct reflection would fail here. Expected JSON escapes { } " as \{ \} \" (NOVA interpolation).
type P
    x: int
    y: int

type W
    p: P
    tag: string

fn main()
    let a = P { x: 3, y: 4 }
    let b = P { x: 3, y: 4 }
    let c = P { x: 3, y: 9 }
    // automatic to_json on a struct -- derived from structure, zero annotation
    assert_eq(to_json(a), "\{\"x\":3,\"y\":4\}")
    // automatic structural == (flat): value equality, not identity
    assert_eq(str(a == b), "1")
    assert_eq(str(a == c), "0")
    // nested struct == recurses structurally
    let w1 = W { p: P { x: 1, y: 2 }, tag: "hi" }
    let w2 = W { p: P { x: 1, y: 2 }, tag: "hi" }
    let w3 = W { p: P { x: 1, y: 9 }, tag: "hi" }
    assert_eq(str(w1 == w2), "1")
    assert_eq(str(w1 == w3), "0")
    // nested to_json recurses into struct fields
    assert_eq(to_json(w1), "\{\"p\":\{\"x\":1,\"y\":2\},\"tag\":\"hi\"\}")
    // copy is a deep copy that stays structurally equal to the original
    assert_eq(str(copy(a) == a), "1")
    // a struct is a first-class value: usable as a dict key (automatic structural hashing) --
    // a structurally-equal struct retrieves the same entry
    let d = {}
    d[a] = "v"
    assert_eq(d[b], "v")
    print("auto_reflect_test passed")
