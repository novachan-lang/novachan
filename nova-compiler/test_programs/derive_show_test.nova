// Reflection Phase 1: @derive(Show) generates a compiler-synthesized `show` method
// rendering a struct as "TypeName { field: value, ... }". Verifies scalar int +
// float fields (float soundness), nested @derive(Show) recursion, and string fields.
// NOTE: expected-output literals escape braces as \{ \} because { in a NOVA string
// is interpolation; the escaped value is a literal brace, matching show()'s output.

@derive(Show)
type Point
    x: int
    y: float

@derive(Show)
type Seg
    a: Point
    b: Point
    name: string

fn main()
    let p = Point { x: 3, y: 2.5 }
    assert_eq(p.show(), "Point \{ x: 3, y: 2.5 \}")

    let p0 = Point { x: 0, y: 0.0 }
    assert_eq(p0.show(), "Point \{ x: 0, y: 0.0 \}")
    let p1 = Point { x: -7, y: 1.0 }
    assert_eq(p1.show(), "Point \{ x: -7, y: 1.0 \}")

    let s = Seg { a: Point { x: 1, y: 1.0 }, b: Point { x: 2, y: 4.5 }, name: "edge" }
    assert_eq(s.show(), "Seg \{ a: Point \{ x: 1, y: 1.0 \}, b: Point \{ x: 2, y: 4.5 \}, name: edge \}")

    print("derive_show_test passed")
