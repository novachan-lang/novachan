import std/semver/semver_caret

fn cks(label, got, want)
    if got != want
        print("FAIL _semver_caret_test " + label + ": got=" + got + " want=" + want)
        exit(1)

fn ckb(label, got, want)
    if got != want
        print("FAIL _semver_caret_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // --- svr_lower ---
    cks("lower_1.2.3",  svr_lower("^1.2.3"),  "1.2.3")
    cks("lower_0.2.3",  svr_lower("^0.2.3"),  "0.2.3")
    cks("lower_0.0.3",  svr_lower("^0.0.3"),  "0.0.3")
    cks("lower_no_hat", svr_lower("1.2.3"),    "1.2.3")

    // --- svr_upper ---
    cks("upper_1.2.3",  svr_upper("^1.2.3"),  "2.0.0")
    cks("upper_0.2.3",  svr_upper("^0.2.3"),  "0.3.0")
    cks("upper_0.0.3",  svr_upper("^0.0.3"),  "0.0.4")
    cks("upper_2.0.0",  svr_upper("^2.0.0"),  "3.0.0")
    cks("upper_0.0.0",  svr_upper("^0.0.0"),  "0.0.1")

    // --- svr_satisfies: ^1.2.3 -> [1.2.3, 2.0.0) ---
    ckb("sat_1.5.0_in",   svr_satisfies("1.5.0", "^1.2.3"), true)
    ckb("sat_2.0.0_out",  svr_satisfies("2.0.0", "^1.2.3"), false)
    ckb("sat_1.2.2_lo",   svr_satisfies("1.2.2", "^1.2.3"), false)
    ckb("sat_1.2.3_eq",   svr_satisfies("1.2.3", "^1.2.3"), true)
    ckb("sat_1.9.9_in",   svr_satisfies("1.9.9", "^1.2.3"), true)

    // --- svr_satisfies: ^0.2.3 -> [0.2.3, 0.3.0) ---
    ckb("sat_0.2.5_in",   svr_satisfies("0.2.5", "^0.2.3"), true)
    ckb("sat_0.3.0_out",  svr_satisfies("0.3.0", "^0.2.3"), false)
    ckb("sat_0.2.3_eq",   svr_satisfies("0.2.3", "^0.2.3"), true)
    ckb("sat_0.2.2_lo",   svr_satisfies("0.2.2", "^0.2.3"), false)

    // --- svr_satisfies: ^0.0.3 -> [0.0.3, 0.0.4) ---
    ckb("sat_0.0.3_eq",   svr_satisfies("0.0.3", "^0.0.3"), true)
    ckb("sat_0.0.4_out",  svr_satisfies("0.0.4", "^0.0.3"), false)
    ckb("sat_0.0.2_lo",   svr_satisfies("0.0.2", "^0.0.3"), false)

    // --- build metadata ignored in version string ---
    ckb("sat_build_meta", svr_satisfies("1.5.0+build.1", "^1.2.3"), true)

    print("PASS _semver_caret_test")
