// KAT for std/compress/lz78 — LZ78 dictionary compression
import std/compress/lz78

// Helper: convert string to byte-list
fn str_to_bytes(s) -> list
    let n = len(s)
    let out = []
    let i = 0
    while i < n
        push(out, ord(s[i]))
        i = i + 1
    out

// Helper: convert byte-list to string
fn bytes_to_str(bytes) -> string
    let n = len(bytes)
    let out = ""
    let i = 0
    while i < n
        out = out + chr(bytes[i])
        i = i + 1
    out

// Helper: check byte-list equality
fn bytes_eq(a, b) -> int
    let na = len(a)
    let nb = len(b)
    if na != nb
        return 0
    let i = 0
    while i < na
        if a[i] != b[i]
            return 0
        i = i + 1
    1

// Round-trip check for a string input
fn ckrt_str(label, s)
    let input = str_to_bytes(s)
    let compressed = lz78_compress(input)
    let recovered  = lz78_decompress(compressed)
    if bytes_eq(input, recovered) == 0
        print("FAIL lz78 " + label + ": round-trip mismatch")
        print("  input len=" + str(len(input)) + " recovered len=" + str(len(recovered)))
        exit(1)

// Round-trip check for a raw byte-list
fn ckrt_bytes(label, input)
    let compressed = lz78_compress(input)
    let recovered  = lz78_decompress(compressed)
    if bytes_eq(input, recovered) == 0
        print("FAIL lz78 " + label + ": round-trip mismatch")
        exit(1)

fn main()
    // KAT 1: empty input
    let empty = []
    let ec = lz78_compress(empty)
    let ed = lz78_decompress(ec)
    if len(ed) != 0
        print("FAIL lz78 empty: expected 0 bytes, got " + str(len(ed)))
        exit(1)

    // KAT 2: single byte
    ckrt_str("single_a", "a")

    // KAT 3: repetitive — "ababab"
    ckrt_str("ababab", "ababababab")

    // KAT 4: classic LZ example
    ckrt_str("tobeornot", "TOBEORNOTTOBEORTOBEORNOT")

    // KAT 5: verify "ababab" builds phrases
    // lz78_compress("ababab" as bytes) should return pairs that round-trip
    let ab_in = str_to_bytes("ababab")
    let ab_c  = lz78_compress(ab_in)
    let ab_d  = lz78_decompress(ab_c)
    if bytes_eq(ab_in, ab_d) == 0
        print("FAIL lz78 ababab phrase check: round-trip failed")
        exit(1)
    // Check that compressed has fewer pairs than original bytes (phrase growth)
    if len(ab_c) >= len(ab_in)
        print("FAIL lz78 ababab: no phrase growth (pairs=" + str(len(ab_c)) + " bytes=" + str(len(ab_in)) + ")")
        exit(1)

    // KAT 6: mixed bytes
    let mixed = []
    let mi = 0
    while mi < 50
        push(mixed, mi * 5 - (mi * 5 / 256) * 256)
        mi = mi + 1
    ckrt_bytes("mixed", mixed)

    // KAT 7: all same bytes
    let rep = []
    let ri = 0
    while ri < 80
        push(rep, 65)
        ri = ri + 1
    ckrt_bytes("repetitive_80", rep)

    // KAT 8: longer text
    ckrt_str("longer", "the quick brown fox jumps over the lazy dog")

    // KAT 9: all distinct bytes 0..127
    let distinct = []
    let di = 0
    while di < 128
        push(distinct, di)
        di = di + 1
    ckrt_bytes("distinct_128", distinct)

    // KAT 10: bytes with value 0 (NUL-safety check)
    let with_nul = []
    push(with_nul, 65)
    push(with_nul, 0)
    push(with_nul, 66)
    push(with_nul, 0)
    push(with_nul, 67)
    ckrt_bytes("with_nul", with_nul)

    print("PASS _lz78_test")
