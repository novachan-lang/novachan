import std/game/maze_grid

// --- helpers ---

fn chk_int(name: string, got: int, want: int)
    if got != want
        print("FAIL maze_grid " + name + ": got " + str(got) + " want " + str(want))
        exit(1)

fn chk_bool(name: string, got: bool, want: bool)
    let gs = "false"
    if got
        gs = "true"
    let ws = "false"
    if want
        ws = "true"
    if got != want
        print("FAIL maze_grid " + name + ": got " + gs + " want " + ws)
        exit(1)

// --- test make_links ---

fn test_make_links()
    let lk = make_links(3, 3)
    chk_int("make_links len", len(lk), 9)
    let i = 0
    while i < 9
        chk_int("make_links[" + str(i) + "] empty", len(lk[i]), 0)
        i = i + 1

// --- test neighbors ---

fn test_neighbors()
    // Corner cell 0 in 3x3: right=1, down=3. No up, no left.
    let nb0 = neighbors(0, 3, 3)
    chk_int("neighbors(0) len", len(nb0), 2)
    // The order is: up, down, left, right — so down=3 first, then right=1.
    // up is absent (c<w fails for c=0), down=3, left absent (c%w=0), right=1
    chk_int("neighbors(0)[0] down", nb0[0], 3)
    chk_int("neighbors(0)[1] right", nb0[1], 1)

    // Center cell 4 in 3x3: up=1, down=7, left=3, right=5
    let nb4 = neighbors(4, 3, 3)
    chk_int("neighbors(4) len", len(nb4), 4)
    chk_int("neighbors(4)[0] up", nb4[0], 1)
    chk_int("neighbors(4)[1] down", nb4[1], 7)
    chk_int("neighbors(4)[2] left", nb4[2], 3)
    chk_int("neighbors(4)[3] right", nb4[3], 5)

    // Right-edge cell 2 in 3x3: up absent, down=5, left=1, right absent
    let nb2 = neighbors(2, 3, 3)
    chk_int("neighbors(2) len", len(nb2), 2)
    chk_int("neighbors(2)[0] down", nb2[0], 5)
    chk_int("neighbors(2)[1] left", nb2[1], 1)

// --- test carve / linked ---

fn test_carve_linked()
    let lk = make_links(3, 3)
    // Before carve: not linked
    chk_bool("linked before carve", linked(lk, 0, 1), false)
    carve(lk, 0, 1)
    chk_bool("linked(0,1) after carve", linked(lk, 0, 1), true)
    chk_bool("linked(1,0) after carve", linked(lk, 1, 0), true)
    // Carve another passage
    carve(lk, 1, 2)
    chk_bool("linked(1,2)", linked(lk, 1, 2), true)
    chk_bool("linked(2,1)", linked(lk, 2, 1), true)
    // Unrelated cells still unlinked
    chk_bool("linked(0,2) still false", linked(lk, 0, 2), false)

// --- test edge_count ---

fn test_edge_count()
    let lk = make_links(3, 3)
    chk_int("edge_count empty", edge_count(lk), 0)
    carve(lk, 0, 1)
    chk_int("edge_count after 1 carve", edge_count(lk), 1)
    carve(lk, 1, 2)
    carve(lk, 2, 5)
    chk_int("edge_count after 3 carves", edge_count(lk), 3)

// --- test is_perfect_maze with a hand-built spanning tree on 3x3 ---
// Spanning tree (8 edges for 9 cells):
//   0-1, 1-2, 2-5, 5-8, 8-7, 7-6, 6-3, 3-4
// That's exactly 8 edges = 3*3-1 and forms a connected path visiting all cells.

fn test_perfect_maze()
    let lk = make_links(3, 3)
    carve(lk, 0, 1)
    carve(lk, 1, 2)
    carve(lk, 2, 5)
    carve(lk, 5, 8)
    carve(lk, 8, 7)
    carve(lk, 7, 6)
    carve(lk, 6, 3)
    carve(lk, 3, 4)
    chk_int("perfect 3x3 edge_count", edge_count(lk), 8)
    chk_bool("is_connected 3x3", is_connected(lk, 3, 3), true)
    chk_bool("is_perfect_maze 3x3", is_perfect_maze(lk, 3, 3), true)

// --- test disconnected maze -> is_perfect_maze false ---

fn test_disconnected()
    let lk = make_links(3, 3)
    // Only carve 7 edges — missing cell 4 => disconnected
    carve(lk, 0, 1)
    carve(lk, 1, 2)
    carve(lk, 2, 5)
    carve(lk, 5, 8)
    carve(lk, 8, 7)
    carve(lk, 7, 6)
    carve(lk, 6, 3)
    // cell 4 never connected
    chk_bool("disconnected is_connected", is_connected(lk, 3, 3), false)
    chk_bool("disconnected is_perfect", is_perfect_maze(lk, 3, 3), false)

// --- test looped maze (cycle) -> is_perfect_maze false (too many edges) ---

fn test_looped()
    let lk = make_links(3, 3)
    // Build the spanning tree (8 edges) then add one extra (loop)
    carve(lk, 0, 1)
    carve(lk, 1, 2)
    carve(lk, 2, 5)
    carve(lk, 5, 8)
    carve(lk, 8, 7)
    carve(lk, 7, 6)
    carve(lk, 6, 3)
    carve(lk, 3, 4)
    carve(lk, 4, 5)  // extra edge creates a cycle
    chk_int("looped edge_count", edge_count(lk), 9)
    chk_bool("looped is_perfect", is_perfect_maze(lk, 3, 3), false)

// --- test cell_rc ---

fn test_cell_rc()
    // 3-wide grid: cell 4 = row 1, col 1
    let rc4 = cell_rc(4, 3)
    chk_int("cell_rc(4,3) row", rc4[0], 1)
    chk_int("cell_rc(4,3) col", rc4[1], 1)
    // Cell 0 = row 0, col 0
    let rc0 = cell_rc(0, 3)
    chk_int("cell_rc(0,3) row", rc0[0], 0)
    chk_int("cell_rc(0,3) col", rc0[1], 0)
    // Cell 8 = row 2, col 2
    let rc8 = cell_rc(8, 3)
    chk_int("cell_rc(8,3) row", rc8[0], 2)
    chk_int("cell_rc(8,3) col", rc8[1], 2)

// --- test rc_cell ---

fn test_rc_cell()
    // (1,1) in width-3 = 1*3+1 = 4
    chk_int("rc_cell(1,1,3)", rc_cell(1, 1, 3), 4)
    // (0,0) = 0
    chk_int("rc_cell(0,0,3)", rc_cell(0, 0, 3), 0)
    // (2,2) in width-3 = 8
    chk_int("rc_cell(2,2,3)", rc_cell(2, 2, 3), 8)

// --- test non-square grid 5x3 (w=5, h=3, 15 cells, need 14 edges) ---

fn test_non_square()
    let w = 5
    let h = 3
    let lk = make_links(w, h)
    // Build a simple snake path: row by row
    // Row 0: 0-1-2-3-4
    carve(lk, 0, 1)
    carve(lk, 1, 2)
    carve(lk, 2, 3)
    carve(lk, 3, 4)
    // Down: 4->9
    carve(lk, 4, 9)
    // Row 1 backwards: 9-8-7-6-5
    carve(lk, 9, 8)
    carve(lk, 8, 7)
    carve(lk, 7, 6)
    carve(lk, 6, 5)
    // Down: 5->10
    carve(lk, 5, 10)
    // Row 2: 10-11-12-13-14
    carve(lk, 10, 11)
    carve(lk, 11, 12)
    carve(lk, 12, 13)
    carve(lk, 13, 14)
    chk_int("non_square edge_count", edge_count(lk), 14)
    chk_bool("non_square is_connected", is_connected(lk, w, h), true)
    chk_bool("non_square is_perfect", is_perfect_maze(lk, w, h), true)

// --- test 4x4 perfect maze ---

fn test_4x4()
    let w = 4
    let h = 4
    let lk = make_links(w, h)
    // Snake: 0-1-2-3, 3->7, 7-6-5-4, 4->8, 8-9-10-11, 11->15, 15-14-13-12
    carve(lk, 0, 1)
    carve(lk, 1, 2)
    carve(lk, 2, 3)
    carve(lk, 3, 7)
    carve(lk, 7, 6)
    carve(lk, 6, 5)
    carve(lk, 5, 4)
    carve(lk, 4, 8)
    carve(lk, 8, 9)
    carve(lk, 9, 10)
    carve(lk, 10, 11)
    carve(lk, 11, 15)
    carve(lk, 15, 14)
    carve(lk, 14, 13)
    carve(lk, 13, 12)
    chk_int("4x4 edge_count", edge_count(lk), 15)
    chk_bool("4x4 is_perfect", is_perfect_maze(lk, w, h), true)

fn main()
    test_make_links()
    test_neighbors()
    test_carve_linked()
    test_edge_count()
    test_perfect_maze()
    test_disconnected()
    test_looped()
    test_cell_rc()
    test_rc_cell()
    test_non_square()
    test_4x4()
    print("PASS _maze_grid_test")
