// Test mutual recursion with type inference (no annotations)
// The return types must be inferred across the mutual call boundary

fn count_down(n)
    if n <= 0
        return 0
    return count_up(n - 1)

fn count_up(n)
    if n <= 0
        return 0
    return count_down(n - 1)

fn collatz_even(n)
    if n <= 1
        return n
    return collatz_odd(n / 2)

fn collatz_odd(n)
    if n <= 1
        return n
    if n % 2 == 0
        return collatz_even(n)
    return collatz_even(n * 3 + 1)

fn main()
    assert(count_down(5) == 0, "count_down")
    assert(count_up(5) == 0, "count_up")
    assert(collatz_even(8) == 1, "collatz_even(8)")
    assert(collatz_odd(3) == 1, "collatz_odd(3)")
    print("mutual_infer: all passed")
