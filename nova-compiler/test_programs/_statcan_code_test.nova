import std/phonetic/statcan_code

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL statcan_code " + label + ": got=" + got + " want=" + want)
        exit(1)

// Reference vectors from task specification.
cks("encode_DAVID",      sc_encode("DAVID"),         "DVD")
cks("encode_ROBERT",     sc_encode("ROBERT"),        "RBRT")
cks("encode_SMITH",      sc_encode("SMITH"),         "SMT")
cks("encode_MCDONALD",   sc_encode("MCDONALD"),      "MCDNLD")
cks("remove_vowels_ROBERT", sc_remove_vowels("ROBERT"), "RBRT")
cks("dedupe_BOOKKEEPER", sc_dedupe("BOOKKEEPER"),    "BOKEPER")
cks("encode_empty",      sc_encode(""),              "")

// Additional sanity checks.
cks("encode_lower",      sc_encode("smith"),         "SMT")
cks("encode_single",     sc_encode("A"),             "A")
cks("encode_single_cons",sc_encode("B"),             "B")
cks("dedupe_none",       sc_dedupe("SMITH"),         "SMITH")
cks("dedupe_triple",     sc_dedupe("AAA"),           "A")
cks("remove_all_vowels", sc_remove_vowels("AEIOU"),  "")
cks("normalize",         sc_normalize("O Brien"),    "OBRIEN")

print("PASS _statcan_code_test")
