import std/gametheory/bulls_cows

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _bulls_cows_test " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gs = "false"
    if got
        gs = "true"
    let ws = "false"
    if want
        ws = "true"
    if got != want
        print("FAIL _bulls_cows_test " + label + ": got " + gs + " want " + ws)
        exit(1)

fn ckl(label: string, got: list, want: list)
    let n = len(want)
    if len(got) != n
        print("FAIL _bulls_cows_test " + label + ": len got " + str(len(got)) + " want " + str(n))
        exit(1)
    let i = 0
    while i < n
        if got[i] != want[i]
            print("FAIL _bulls_cows_test " + label + "[" + str(i) + "]: got " + str(got[i]) + " want " + str(want[i]))
            exit(1)
        i = i + 1

fn mk4(a: int, b: int, c: int, d: int) -> list
    let xs = []
    push(xs, a)
    push(xs, b)
    push(xs, c)
    push(xs, d)
    xs

fn mk3(a: int, b: int, c: int) -> list
    let xs = []
    push(xs, a)
    push(xs, b)
    push(xs, c)
    xs

fn main()
    // bc_bulls([1,2,3,4],[1,3,2,4]) = 2
    cki("bulls_1234_1324", bc_bulls(mk4(1,2,3,4), mk4(1,3,2,4)), 2)

    // bc_cows([1,2,3,4],[1,3,2,4]) = 2
    cki("cows_1234_1324", bc_cows(mk4(1,2,3,4), mk4(1,3,2,4)), 2)

    // bc_score([1,2,3,4],[1,3,2,4]) = [2,2]
    let want1 = []
    push(want1, 2)
    push(want1, 2)
    ckl("score_1234_1324", bc_score(mk4(1,2,3,4), mk4(1,3,2,4)), want1)

    // bc_score([1,2,3,4],[5,6,7,8]) = [0,0]
    let want2 = []
    push(want2, 0)
    push(want2, 0)
    ckl("score_1234_5678", bc_score(mk4(1,2,3,4), mk4(5,6,7,8)), want2)

    // bc_score([1,1,2,3],[1,2,1,4]) = [1,2]
    let want3 = []
    push(want3, 1)
    push(want3, 2)
    ckl("score_1123_1214", bc_score(mk4(1,1,2,3), mk4(1,2,1,4)), want3)

    // bc_score([1,2,3],[3,2,1]) = [1,2]
    let want4 = []
    push(want4, 1)
    push(want4, 2)
    ckl("score_123_321", bc_score(mk3(1,2,3), mk3(3,2,1)), want4)

    // Edge: perfect match — all bulls, no cows
    let want5 = []
    push(want5, 3)
    push(want5, 0)
    ckl("score_perfect", bc_score(mk3(7,8,9), mk3(7,8,9)), want5)

    print("PASS _bulls_cows_test")
