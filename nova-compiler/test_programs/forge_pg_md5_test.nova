// Forge S9: Postgres MD5 auth = "md5" + md5(md5(password+user) + salt). MD5 itself is RFC-1321 KAT-gated;
// this checks the PG composition (structure + a self-consistent re-derivation + determinism). Socketless.
import forge_pg
import forge_crypto

fn main()
    let user = "postgres"
    let pw = "secret"
    let salt = str_to_blist("ABCD")   // 4 ASCII bytes, so we can re-derive the outer md5 via md5_hex

    let got = pg_md5_auth(user, pw, salt)

    if len(got) != 35
        print("FAIL: pg_md5_auth should be 'md5' + 32 hex = 35 chars, got " + str(len(got)))
        exit(1)
    if slice(got, 0, 3) != "md5"
        print("FAIL: pg_md5_auth must start with 'md5'")
        exit(1)

    // self-consistent: "md5" + md5(md5(pw+user) + "ABCD")
    let expected = "md5" + md5_hex(md5_hex(pw + user) + "ABCD")
    if got != expected
        print("FAIL: composition -> " + got)
        exit(1)

    if pg_md5_auth(user, pw, salt) != got
        print("FAIL: not deterministic")
        exit(1)

    print("PASS forge_pg_md5 (md5(md5(pw+user)+salt): structure + composition + deterministic)")
