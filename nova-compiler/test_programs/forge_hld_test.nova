import forge_hld as hld

fn check(cond: bool, label: str)
    if cond == false
        print("FAIL: " + label)

// Brute-force path sum: walk from u and v up to their LCA via parent pointers.
fn brute_depth(parent: list, u: int) -> int
    let d = 0
    let cur = u
    while parent[cur] >= 0
        cur = parent[cur]
        d = d + 1
    return d

fn brute_lca(parent: list, u0: int, v0: int) -> int
    // collect ancestors of u
    let anc = {}
    let cur = u0
    anc[str(cur)] = 1
    while parent[cur] >= 0
        cur = parent[cur]
        anc[str(cur)] = 1
    // walk v up until in anc
    let cv = v0
    while get(anc, str(cv), 0) == 0
        cv = parent[cv]
    return cv

fn brute_path_sum(parent: list, values: list, u0: int, v0: int) -> int
    let lca = brute_lca(parent, u0, v0)
    let total = 0
    // sum from u up to lca (inclusive of u, exclusive of lca)
    let cu = u0
    while cu != lca
        total = total + values[cu]
        cu = parent[cu]
    // sum from v up to lca (exclusive of lca)
    let cv = v0
    while cv != lca
        total = total + values[cv]
        cv = parent[cv]
    // add lca once
    total = total + values[lca]
    return total

fn brute_subtree_sum(n: int, parent: list, values: list, u: int) -> int
    // node w is in subtree of u iff following parents from w reaches u
    let total = 0
    let w = 0
    while w < n
        let cur = w
        let inside = false
        let done = false
        while done == false
            if cur == u
                inside = true
                done = true
            else
                if parent[cur] < 0
                    done = true
                else
                    cur = parent[cur]
        if inside
            total = total + values[w]
        w = w + 1
    return total

// TEST 1: small tree
//        0
//       / \
//      1   2
//     / \   \
//    3   4   5
let parent1 = [0 - 1, 0, 0, 1, 1, 2]
let values1 = [10, 20, 30, 40, 50, 60]
let h1 = hld.hld_build(6, parent1, 0, values1)

// path 3..4: 3 -> 1 -> 4, sum = 40 + 20 + 50 = 110
check(hld.hld_path_sum(h1, 3, 4) == 110, "path 3..4 = 110")
// path 3..5: 3 -> 1 -> 0 -> 2 -> 5, sum = 40+20+10+30+60 = 160
check(hld.hld_path_sum(h1, 3, 5) == 160, "path 3..5 = 160")
// path 0..0 = 10
check(hld.hld_path_sum(h1, 0, 0) == 10, "path 0..0 = 10")
// path 5..5 = 60
check(hld.hld_path_sum(h1, 5, 5) == 60, "path 5..5 = 60")

// LCA
check(hld.hld_lca(h1, 3, 4) == 1, "lca(3,4)=1")
check(hld.hld_lca(h1, 3, 5) == 0, "lca(3,5)=0")
check(hld.hld_lca(h1, 4, 4) == 4, "lca(4,4)=4")
check(hld.hld_lca(h1, 5, 2) == 2, "lca(5,2)=2")

// subtree sum
check(hld.hld_subtree_sum(h1, 1) == 20 + 40 + 50, "subtree(1) = 110")
check(hld.hld_subtree_sum(h1, 0) == 10 + 20 + 30 + 40 + 50 + 60, "subtree(0) = 210")
check(hld.hld_subtree_sum(h1, 5) == 60, "subtree(5) = 60")

// TEST 2: update
hld.hld_update(h1, 3, 100)  // was 40, now 100
check(hld.hld_path_sum(h1, 3, 4) == 100 + 20 + 50, "path 3..4 after update = 170")
check(hld.hld_subtree_sum(h1, 1) == 20 + 100 + 50, "subtree(1) after update = 170")

// TEST 3: chain (degenerate path tree)
//  0 - 1 - 2 - 3 - 4  (each parent is previous)
let parent2 = [0 - 1, 0, 1, 2, 3]
let values2 = [1, 2, 3, 4, 5]
let h2 = hld.hld_build(5, parent2, 0, values2)
check(hld.hld_path_sum(h2, 0, 4) == 15, "chain path 0..4 = 15")
check(hld.hld_path_sum(h2, 1, 3) == 2 + 3 + 4, "chain path 1..3 = 9")
check(hld.hld_lca(h2, 2, 4) == 2, "chain lca(2,4)=2")

// TEST 4: DECISIVE brute-force cross-check on a random tree with updates
// Build random tree of n=25 nodes (each node's parent = random smaller index)
let n = 25
let parent = [0 - 1]
let values = [7]
let seed = 314159
let i = 1
while i < n
    seed = (seed * 1103515245 + 12345) % 2147483648
    let p = seed % i  // parent is some earlier node
    push(parent, p)
    seed = (seed * 1103515245 + 12345) % 2147483648
    push(values, seed % 100)
    i = i + 1

let h = hld.hld_build(n, parent, 0, values)

// verify all pairwise path sums, LCAs, and subtree sums
let ok = true
let u = 0
while u < n
    let v = 0
    while v < n
        let exp_path = brute_path_sum(parent, values, u, v)
        let got_path = hld.hld_path_sum(h, u, v)
        if exp_path != got_path
            ok = false
            print("PATH MISMATCH u=" + str(u) + " v=" + str(v) + " exp=" + str(exp_path) + " got=" + str(got_path))
        let exp_lca = brute_lca(parent, u, v)
        let got_lca = hld.hld_lca(h, u, v)
        if exp_lca != got_lca
            ok = false
            print("LCA MISMATCH u=" + str(u) + " v=" + str(v) + " exp=" + str(exp_lca) + " got=" + str(got_lca))
        v = v + 1
    let exp_sub = brute_subtree_sum(n, parent, values, u)
    let got_sub = hld.hld_subtree_sum(h, u)
    if exp_sub != got_sub
        ok = false
        print("SUBTREE MISMATCH u=" + str(u) + " exp=" + str(exp_sub) + " got=" + str(got_sub))
    u = u + 1
check(ok, "DECISIVE: path-sum + LCA + subtree-sum match brute over ALL pairs of a random 25-node tree")

// TEST 5: apply several updates then re-verify a batch of paths
let seed2 = 271828
let upd = 0
while upd < 10
    seed2 = (seed2 * 1103515245 + 12345) % 2147483648
    let node = seed2 % n
    seed2 = (seed2 * 1103515245 + 12345) % 2147483648
    let nv = seed2 % 200
    hld.hld_update(h, node, nv)
    values[node] = nv
    upd = upd + 1

let ok2 = true
let a = 0
while a < n
    let b = 0
    while b < n
        let exp_p = brute_path_sum(parent, values, a, b)
        let got_p = hld.hld_path_sum(h, a, b)
        if exp_p != got_p
            ok2 = false
            print("POST-UPDATE PATH MISMATCH a=" + str(a) + " b=" + str(b))
        b = b + 1
    a = a + 1
check(ok2, "DECISIVE: after 10 updates, ALL path sums still match brute")

print("forge_hld: KAT done")
