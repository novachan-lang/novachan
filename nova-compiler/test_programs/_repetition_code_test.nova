import std/coding/repetition_code

// ── Helpers ───────────────────────────────────────────────────────────────────

fn list_eq(a, b) -> bool
    let la = len(a)
    let lb = len(b)
    if la != lb
        return 0
    let i = 0
    while i < la
        if a[i] != b[i]
            return 0
        i = i + 1
    1

fn list_str(a) -> any
    let s = "["
    let i = 0
    while i < len(a)
        if i > 0
            s = s + ","
        s = s + str(a[i])
        i = i + 1
    s = s + "]"
    s

fn cki(label, got, want)
    if got != want
        print("FAIL repetition_code " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    if not list_eq(got, want)
        print("FAIL repetition_code " + label + ": got=" + list_str(got) + " want=" + list_str(want))
        exit(1)

// ── Main ──────────────────────────────────────────────────────────────────────

fn main()
    // --- Parameters ---
    cki("rep_min_distance_3",      rep_min_distance(3),      3)
    cki("rep_min_distance_5",      rep_min_distance(5),      5)
    cki("rep_min_distance_7",      rep_min_distance(7),      7)
    cki("rep_correct_capability_3", rep_correct_capability(3), 1)
    cki("rep_correct_capability_5", rep_correct_capability(5), 2)
    cki("rep_correct_capability_7", rep_correct_capability(7), 3)
    cki("rep_detects_3",           rep_detects(3),           2)
    cki("rep_detects_5",           rep_detects(5),           4)
    cki("rep_can_correct_3_1",     rep_can_correct(3, 1),    1)
    cki("rep_can_correct_3_2",     rep_can_correct(3, 2),    0)
    cki("rep_can_correct_5_2",     rep_can_correct(5, 2),    1)
    cki("rep_can_correct_5_3",     rep_can_correct(5, 3),    0)

    // --- Encoding ---
    let bits_10 = []
    push(bits_10, 1)
    push(bits_10, 0)

    let enc3 = rep_encode(bits_10, 3)
    let want_10_3 = []
    push(want_10_3, 1)
    push(want_10_3, 1)
    push(want_10_3, 1)
    push(want_10_3, 0)
    push(want_10_3, 0)
    push(want_10_3, 0)
    ckb("rep_encode_10_n3", enc3, want_10_3)

    let enc5 = rep_encode(bits_10, 5)
    let want_10_5 = []
    push(want_10_5, 1)
    push(want_10_5, 1)
    push(want_10_5, 1)
    push(want_10_5, 1)
    push(want_10_5, 1)
    push(want_10_5, 0)
    push(want_10_5, 0)
    push(want_10_5, 0)
    push(want_10_5, 0)
    push(want_10_5, 0)
    ckb("rep_encode_10_n5", enc5, want_10_5)

    // --- Decoding (clean) ---
    let dec_clean = rep_decode(enc3, 3)
    ckb("rep_decode_clean", dec_clean, bits_10)

    // All-zeros
    let bits_00 = []
    push(bits_00, 0)
    push(bits_00, 0)
    let enc_00_3 = rep_encode(bits_00, 3)
    ckb("rep_decode_zeros", rep_decode(enc_00_3, 3), bits_00)

    // Single bit
    let bits_1 = []
    push(bits_1, 1)
    let enc_1_3 = rep_encode(bits_1, 3)
    ckb("rep_decode_single_1", rep_decode(enc_1_3, 3), bits_1)

    let bits_0 = []
    push(bits_0, 0)
    let enc_0_3 = rep_encode(bits_0, 3)
    ckb("rep_decode_single_0", rep_decode(enc_0_3, 3), bits_0)

    // --- Decoding with 1 error per group: [1,0,1,0,1,0] (n=3) ---
    // Group 0 = [1,0,1] -> majority=1; Group 1 = [0,1,0] -> majority=0
    let noisy_10 = []
    push(noisy_10, 1)
    push(noisy_10, 0)
    push(noisy_10, 1)
    push(noisy_10, 0)
    push(noisy_10, 1)
    push(noisy_10, 0)
    ckb("rep_decode_noisy_n3", rep_decode(noisy_10, 3), bits_10)

    // --- rep_decode with all-zeros noisy ---
    let noisy_000 = []
    push(noisy_000, 0)
    push(noisy_000, 0)
    push(noisy_000, 0)
    ckb("rep_decode_block_zero", rep_decode(noisy_000, 3), bits_0)

    // --- rep_decode_block ---
    let g1 = []
    push(g1, 1)
    push(g1, 0)
    push(g1, 1)
    cki("rep_decode_block_101", rep_decode_block(g1), 1)

    let g2 = []
    push(g2, 0)
    push(g2, 1)
    push(g2, 0)
    cki("rep_decode_block_010", rep_decode_block(g2), 0)

    let g3 = []
    push(g3, 1)
    push(g3, 1)
    push(g3, 1)
    cki("rep_decode_block_111", rep_decode_block(g3), 1)

    let g4 = []
    push(g4, 0)
    push(g4, 0)
    push(g4, 0)
    cki("rep_decode_block_000", rep_decode_block(g4), 0)

    // --- n=5 round-trip with 2 errors ---
    // bits=[1]: encode -> [1,1,1,1,1]; flip positions 0 and 2 -> [0,1,0,1,1]
    // majority: 3 ones -> 1 ✓
    let noisy5 = []
    push(noisy5, 0)
    push(noisy5, 1)
    push(noisy5, 0)
    push(noisy5, 1)
    push(noisy5, 1)
    ckb("rep_decode_n5_2err", rep_decode(noisy5, 5), bits_1)

    // --- rep_encode_msg is alias for rep_encode ---
    ckb("rep_encode_msg_alias", rep_encode_msg(bits_10, 3), enc3)

    print("PASS _repetition_code_test")
