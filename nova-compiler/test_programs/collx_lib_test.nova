import collx

fn main()
    let a = [10, 20, 30, 40, 50]
    // take / drop
    assert(collx.take(a, 2) == [10, 20], "take first 2")
    assert(collx.drop(a, 2) == [30, 40, 50], "drop first 2")
    // unique preserves first-seen order
    assert(collx.unique([3, 1, 3, 2, 1, 3]) == [3, 1, 2], "unique keeps first-seen order")
    // count_elem
    assert(collx.count_elem([3, 1, 3, 2, 3], 3) == 3, "count of 3 is 3")
    // reverse_list
    assert(collx.reverse_list([1, 2, 3]) == [3, 2, 1], "reverse [1,2,3]")
    // sum_int
    assert(collx.sum_int([1, 2, 3, 4]) == 10, "sum 1..4 is 10")

    print("collx_lib_test passed")
