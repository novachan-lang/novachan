import std/text/graphemex

fn main()
    // plain ASCII: one grapheme cluster per character
    let g1 = graphemex.graphemes("hello")
    assert(len(g1) == 5, "hello has 5 grapheme clusters")
    assert(g1[0] == "h", "first cluster is h")
    assert(graphemex.grapheme_count("hello") == 5, "grapheme_count(hello) == 5")
    assert(graphemex.grapheme_at("hello", 1) == "e", "grapheme_at index 1 is e")

    // base 'e' (cp 101) + combining acute (cp 769) = 2 codepoints but ONE cluster
    let combo = from_codepoint(101) + from_codepoint(769)
    assert(char_count(combo) == 2, "e + combining acute is 2 codepoints")
    assert(graphemex.grapheme_count(combo) == 1, "but it is 1 grapheme cluster")

    // regional-indicator pair (U+1F1FA U+1F1F8 = US flag) = ONE cluster
    let flag = from_codepoint(127482) + from_codepoint(127480)
    assert(graphemex.grapheme_count(flag) == 1, "a regional-indicator pair is 1 flag grapheme")

    // grapheme-aware reverse keeps the accent attached to its base
    let word = "a" + combo + "c"
    assert(graphemex.grapheme_count(word) == 3, "word has 3 user-perceived chars")
    let rev = graphemex.grapheme_reverse(word)
    assert(rev == "c" + combo + "a", "grapheme reverse keeps the accent on its base")

    print("graphemex_lib_test passed")
