import forge_idgen

fn main()
    let g = idg_sequential("USR-", 1000)
    let r1 = idg_next(g)
    g = r1["gen"]
    assert(r1["id"] == "USR-1000", "first id")

    let r2 = idg_next(g)
    g = r2["gen"]
    assert(r2["id"] == "USR-1001", "second id")
    assert(idg_current(g) == 1002, "counter=1002")

    let r3 = idg_next_n(g, 3)
    g = r3["gen"]
    let ids = r3["ids"]
    assert(len(ids) == 3, "3 ids")
    assert(ids[0] == "USR-1002", "batch first")
    assert(ids[2] == "USR-1004", "batch last")

    let comp = idg_composite(["ORD", 2026, "A1"], "-")
    assert(comp == "ORD-2026-A1", "composite id")

    let padded = idg_padded("INV-", 42, 6)
    assert(padded == "INV-000042", "padded id")

    let padded2 = idg_padded("X", 1, 4)
    assert(padded2 == "X0001", "padded short")

    let parts = idg_from_parts(["ABC", 123, "XYZ"])
    assert(parts == "ABC123XYZ", "from parts")

    let ts_id = idg_with_timestamp("EVT-", 1719700000, 5)
    assert(ts_id == "EVT-1719700000-5", "timestamp id")

    assert(idg_validate_format("USR-1000", "USR-") == 1, "valid format")
    assert(idg_validate_format("ORD-1000", "USR-") == 0, "wrong prefix")
    assert(idg_validate_format("US", "USR-") == 0, "too short")

    print("IDGEN KAT PASS")
