// rchanx — transparent distributed messaging: a channel whose transport is the
// NETWORK instead of memory. NOVA's identity is "runs ANYWHERE" — channels are the
// universal comm primitive, so a cross-node channel is just send/receive over TCP with
// the Value serialized (json_stringify) on the wire and reconstructed (json_decode) on
// the far side. Same mental model as a local channel; the bytes travel between nodes.
//
// (tcp_recv drains to a 30ms idle, so one recv yields one complete message for the
//  request/reply rendezvous pattern — exactly how a channel rendezvous behaves.)

fn rchan_listen(port)
    return tcp_listen(port)

fn rchan_accept(listener)
    return tcp_accept(listener)

fn rchan_connect(host, port)
    return tcp_connect(host, port)

fn rchan_send(conn, value)
    return tcp_send(conn, json_stringify(value))    // Value -> JSON on the wire

fn rchan_recv(conn)
    return json_decode(tcp_recv(conn))              // JSON -> Value on arrival

fn rchan_close(conn)
    return tcp_close(conn)

fn main()
    let port = 19887
    let listener = rchan_listen(port)

    // a server NODE (here a Process; on a real cluster, a remote machine): accept a
    // connection, receive a request Value, reply with a transformed Value.
    spawn fn()
        let conn = rchan_accept(listener)
        let req = rchan_recv(conn)
        let n = req["n"]
        rchan_send(conn, {"result": n + 100, "echo": req["tag"]})
        rchan_close(conn)

    // a client NODE: connect, send a structured request, receive the reply.
    let c = rchan_connect("127.0.0.1", port)
    rchan_send(c, {"n": 42, "tag": "hello"})
    let reply = rchan_recv(c)
    assert_eq(reply["result"], 142)
    assert_eq(reply["echo"], "hello")
    rchan_close(c)

    print("rchanx passed")
