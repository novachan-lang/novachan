import forge_bisect

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn joinl(xs: list) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + ","
        out = out + str(xs[i])
        i = i + 1
    out

fn main()
    let fails = 0
    let xs = [1, 2, 4, 4, 4, 7, 9]

    // lower_bound
    fails = fails + expect("lb_4", str(lower_bound(xs, 4)), "2")
    fails = fails + expect("lb_5", str(lower_bound(xs, 5)), "5")
    fails = fails + expect("lb_0", str(lower_bound(xs, 0)), "0")
    fails = fails + expect("lb_10", str(lower_bound(xs, 10)), "7")
    fails = fails + expect("lb_7", str(lower_bound(xs, 7)), "5")
    fails = fails + expect("lb_9", str(lower_bound(xs, 9)), "6")

    // upper_bound
    fails = fails + expect("ub_4", str(upper_bound(xs, 4)), "5")
    fails = fails + expect("ub_1", str(upper_bound(xs, 1)), "1")
    fails = fails + expect("ub_9", str(upper_bound(xs, 9)), "7")
    fails = fails + expect("ub_0", str(upper_bound(xs, 0)), "0")

    // binary_search (first occurrence, -1 absent)
    fails = fails + expect("bs_4", str(binary_search(xs, 4)), "2")
    fails = fails + expect("bs_7", str(binary_search(xs, 7)), "5")
    fails = fails + expect("bs_1", str(binary_search(xs, 1)), "0")
    fails = fails + expect("bs_3", str(binary_search(xs, 3)), "-1")
    fails = fails + expect("bs_10", str(binary_search(xs, 10)), "-1")
    fails = fails + expect("bs_neg", str(binary_search(xs, 0)), "-1")

    // contains
    fails = fails + expect("has_4", str(bisect_contains(xs, 4)), "true")
    fails = fails + expect("has_3", str(bisect_contains(xs, 3)), "false")

    // count occurrences
    fails = fails + expect("cnt_4", str(count_sorted(xs, 4)), "3")
    fails = fails + expect("cnt_7", str(count_sorted(xs, 7)), "1")
    fails = fails + expect("cnt_3", str(count_sorted(xs, 3)), "0")

    // range count [lo, hi)
    fails = fails + expect("rng_2_8", str(count_range(xs, 2, 8)), "5")
    fails = fails + expect("rng_4_5", str(count_range(xs, 4, 5)), "3")
    fails = fails + expect("rng_all", str(count_range(xs, 0, 100)), "7")

    // insert sorted
    fails = fails + expect("ins_5", joinl(insert_sorted(xs, 5)), "1,2,4,4,4,5,7,9")
    fails = fails + expect("ins_0", joinl(insert_sorted(xs, 0)), "0,1,2,4,4,4,7,9")
    fails = fails + expect("ins_10", joinl(insert_sorted(xs, 10)), "1,2,4,4,4,7,9,10")
    fails = fails + expect("ins_4", joinl(insert_sorted(xs, 4)), "1,2,4,4,4,4,7,9")

    // closest
    fails = fails + expect("cl_6", str(closest(xs, 6)), "7")
    fails = fails + expect("cl_3", str(closest(xs, 3)), "2")
    fails = fails + expect("cl_8", str(closest(xs, 8)), "7")
    fails = fails + expect("cl_100", str(closest(xs, 100)), "9")
    fails = fails + expect("cl_neg", str(closest(xs, 0 - 5)), "1")

    if fails == 0
        print("forge_bisect: all passed")
    else
        print("forge_bisect: " + str(fails) + " FAILED")
