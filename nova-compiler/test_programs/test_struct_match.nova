// Test: struct pattern matching with type discrimination

type Dog
    name: string
    age: int

type Cat
    name: string
    lives: int

fn describe(animal) -> string
    match animal
        Dog(name, age) =>
            "Dog " + name + " age " + str(age)
        Cat(name, lives) =>
            "Cat " + name + " " + str(lives) + " lives"

let d = Dog("Rex", 5)
let c = Cat("Whiskers", 9)

// Test 1: Match Dog
print(describe(d))

// Test 2: Match Cat
print(describe(c))

// Test 3: Field access
match d
    Dog(n, a) =>
        print("name: " + n + " age: " + str(a))

// Test 4: Match Cat fields
match c
    Cat(n, l) =>
        print("name: " + n + " lives: " + str(l))

print("done")
