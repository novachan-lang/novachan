import forge_numwords

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    fails = fails + expect("zero", number_to_words(0), "zero")
    fails = fails + expect("five", number_to_words(5), "five")
    fails = fails + expect("ten", number_to_words(10), "ten")
    fails = fails + expect("nineteen", number_to_words(19), "nineteen")
    fails = fails + expect("twenty", number_to_words(20), "twenty")
    fails = fails + expect("fortytwo", number_to_words(42), "forty-two")
    fails = fails + expect("hundred", number_to_words(100), "one hundred")
    fails = fails + expect("305", number_to_words(305), "three hundred five")
    fails = fails + expect("123", number_to_words(123), "one hundred twenty-three")
    fails = fails + expect("999", number_to_words(999), "nine hundred ninety-nine")
    fails = fails + expect("thousand", number_to_words(1000), "one thousand")
    fails = fails + expect("1234", number_to_words(1234), "one thousand two hundred thirty-four")
    fails = fails + expect("million", number_to_words(1000000), "one million")
    fails = fails + expect("1234567", number_to_words(1234567), "one million two hundred thirty-four thousand five hundred sixty-seven")
    fails = fails + expect("billion", number_to_words(1000000000), "one billion")
    fails = fails + expect("trillion", number_to_words(1000000000000), "one trillion")
    fails = fails + expect("neg", number_to_words(0 - 42), "negative forty-two")
    fails = fails + expect("neg_big", number_to_words(0 - 1000000), "negative one million")
    // a value with internal zero groups
    fails = fails + expect("1000001", number_to_words(1000001), "one million one")
    fails = fails + expect("2000015", number_to_words(2000015), "two million fifteen")
    // classic check-writing amount
    fails = fails + expect("check", number_to_words(2547), "two thousand five hundred forty-seven")

    if fails == 0
        print("forge_numwords: all passed")
    else
        print("forge_numwords: " + str(fails) + " FAILED")
