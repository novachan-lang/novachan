import std/collections/splaytree

// Helper: check int equality
fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)
    return 0

// Helper: check string equality (used for list rendering)
fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got [" + got + "] expected [" + expected + "]")
        exit(1)
    return 0

// Helper: render a list of ints as a comma-separated string for comparison
fn list_str(lst)
    let s = ""
    let i = 0
    let n = len(lst)
    while i < n
        if i > 0
            s = s + ","
        s = s + str(lst[i])
        i = i + 1
    return s

// --- KAT 1: build tree, verify inorder ---
let t = spl_new()
spl_insert(t, 5)
spl_insert(t, 3)
spl_insert(t, 8)
spl_insert(t, 1)
spl_insert(t, 4)
spl_insert(t, 7)
spl_insert(t, 9)
spl_insert(t, 2)

let inord = spl_inorder(t)
cks("inorder_after_insert", list_str(inord), "1,2,3,4,5,7,8,9")

// --- KAT 2: contains present key ---
cki("contains_4", spl_contains(t, 4), 1)

// --- KAT 3: contains absent key ---
cki("contains_6", spl_contains(t, 6), 0)

// --- KAT 4: size ---
cki("size_8", spl_size(t), 8)

// --- KAT 5: min ---
cki("min_1", spl_min(t), 1)

// --- KAT 6: max ---
cki("max_9", spl_max(t), 9)

// --- KAT 7: delete and verify absence ---
spl_delete(t, 5)
cki("contains_5_after_delete", spl_contains(t, 5), 0)

// --- KAT 8: inorder after delete ---
let inord2 = spl_inorder(t)
cks("inorder_after_delete", list_str(inord2), "1,2,3,4,7,8,9")

// --- KAT 9: size after delete ---
cki("size_after_delete", spl_size(t), 7)

// --- KAT 10: delete non-existent (no-op, size unchanged) ---
spl_delete(t, 99)
cki("size_after_noop_delete", spl_size(t), 7)

// --- KAT 11: duplicate insert (no-op, size unchanged) ---
spl_insert(t, 3)
cki("size_after_dup_insert", spl_size(t), 7)

// --- KAT 12: empty tree contains returns 0 ---
let t2 = spl_new()
cki("empty_contains", spl_contains(t2, 1), 0)

// --- KAT 13: single element insert/delete cycle ---
let t3 = spl_new()
spl_insert(t3, 42)
cki("single_contains", spl_contains(t3, 42), 1)
spl_delete(t3, 42)
cki("single_after_delete", spl_contains(t3, 42), 0)
cki("single_size_zero", spl_size(t3), 0)

print("_splaytree_test passed")
