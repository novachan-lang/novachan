import forge_vec2

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn near(a: float, b: float) -> bool
    let d = a - b
    d > -0.001 and d < 0.001

fn vnear(name: string, v, x: float, y: float) -> int
    if near(v[0], x) and near(v[1], y)
        return 0
    print("FAIL " + name + ": got=" + str(v[0]) + "," + str(v[1]) + " want=" + str(x) + "," + str(y))
    1

fn main()
    let fails = 0

    fails = fails + vnear("add", vec2_add([1, 2], [3, 4]), 4.0, 6.0)
    fails = fails + vnear("sub", vec2_sub([5, 7], [2, 3]), 3.0, 4.0)
    fails = fails + vnear("scale", vec2_scale([1, 2], 3), 3.0, 6.0)
    fails = fails + vnear("negate", vec2_negate([3, 0 - 4]), 0 - 3.0, 4.0)

    fails = fails + expect_true("dot", near(vec2_dot([1, 2], [3, 4]), 11.0))
    fails = fails + expect_true("dot_perp", near(vec2_dot([1, 0], [0, 1]), 0.0))
    fails = fails + expect_true("cross", near(vec2_cross([1, 0], [0, 1]), 1.0))
    fails = fails + expect_true("cross_cw", near(vec2_cross([0, 1], [1, 0]), 0 - 1.0))

    fails = fails + expect_true("length_sq", near(vec2_length_sq([3, 4]), 25.0))
    fails = fails + expect_true("length", near(vec2_length([3, 4]), 5.0))
    fails = fails + expect_true("length0", near(vec2_length([0, 0]), 0.0))
    fails = fails + expect_true("distance", near(vec2_distance([0, 0], [3, 4]), 5.0))
    fails = fails + expect_true("distance2", near(vec2_distance([1, 1], [4, 5]), 5.0))

    fails = fails + vnear("normalize", vec2_normalize([3, 4]), 0.6, 0.8)
    fails = fails + vnear("normalize_zero", vec2_normalize([0, 0]), 0.0, 0.0)
    // normalized vector has length 1
    fails = fails + expect_true("normalize_unit", near(vec2_length(vec2_normalize([5, 12])), 1.0))

    fails = fails + vnear("lerp_mid", vec2_lerp([0, 0], [10, 20], 0.5), 5.0, 10.0)
    fails = fails + vnear("lerp_0", vec2_lerp([1, 2], [9, 9], 0.0), 1.0, 2.0)
    fails = fails + vnear("lerp_1", vec2_lerp([1, 2], [9, 8], 1.0), 9.0, 8.0)

    fails = fails + vnear("perp", vec2_perp([1, 0]), 0.0, 1.0)
    // perp is orthogonal to original (dot = 0)
    fails = fails + expect_true("perp_orthogonal", near(vec2_dot([3, 4], vec2_perp([3, 4])), 0.0))

    if fails == 0
        print("forge_vec2: all passed")
    else
        print("forge_vec2: " + str(fails) + " FAILED")
