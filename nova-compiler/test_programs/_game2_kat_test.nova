import std/game/elo_expected
import std/game/elo_kfactor
import std/game/elo_update
import std/game/glicko1
import std/game/rating_decay
import std/game/win_probability
import std/game/hanoi
import std/game/nim
import std/game/nqueens
import std/game/tictactoe

fn assert_eq(label: string, got: any, want: any)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
    else
        print("ok " + label)

fn approx_eq(a: float, b: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    d < 0.001

fn main()
    // elo
    assert_eq("elo_expected equal", approx_eq(elo_expected(1500.0, 1500.0), 0.5), true)
    assert_eq("kfactor provisional", kfactor(1500.0, 5), 40.0)
    assert_eq("kfactor established", kfactor(1500.0, 50), 20.0)
    assert_eq("kfactor high", kfactor(2500.0, 50), 10.0)
    let pair = elo_pair_update(1500.0, 1500.0, 1.0, 20.0)
    assert_eq("elo_pair_update ra up", pair[0] > 1500.0, true)
    assert_eq("elo_pair_update rb down", pair[1] < 1500.0, true)

    // glicko
    let g = glicko_update(1500.0, 200.0, 1500.0, 30.0, 1.0)
    assert_eq("glicko rating up", g[0] > 1500.0, true)
    assert_eq("glicko rd shrinks", g[1] < 200.0, true)

    // rating_decay
    assert_eq("inactivity_decay 0wk", inactivity_decay(1500.0, 0, 1000.0), 1500.0)
    assert_eq("inactivity_decay floor", inactivity_decay(1500.0, 1000, 1000.0), 1000.0)
    assert_eq("provisional_bonus 0games", provisional_bonus(1500.0, 0), 1600.0)
    assert_eq("provisional_bonus 20games", provisional_bonus(1500.0, 20), 1500.0)

    // win_probability
    assert_eq("win_prob equal", approx_eq(win_prob(1500.0, 1500.0), 0.5), true)
    assert_eq("upset_chance", approx_eq(upset_chance(2000.0, 1500.0), win_prob(1500.0, 2000.0)), true)

    // hanoi
    assert_eq("hanoi_count 3", hanoi_count(3), 7)
    let moves = hanoi_moves(3, 0, 2, 1)
    assert_eq("hanoi_moves count", len(moves), 7)
    assert_eq("hanoi first move", moves[0][0] == 0 and moves[0][1] == 2, true)

    // nim
    assert_eq("nim_xor", nim_xor([1, 2, 3]), 0)
    assert_eq("nim_is_winning false", nim_is_winning([1, 2, 3]), false)
    assert_eq("nim_is_winning true", nim_is_winning([1, 2, 4]), true)
    let wm = nim_winning_move([1, 2, 4])
    assert_eq("nim_winning_move exists", wm[0] >= 0, true)

    // nqueens
    assert_eq("nqueens_count 4", nqueens_count(4), 2)
    assert_eq("nqueens_count 6", nqueens_count(6), 4)
    assert_eq("nqueens_count 8", nqueens_count(8), 92)
    let first4 = nqueens_first(4)
    assert_eq("nqueens_first 4 len", len(first4), 4)

    // tictactoe
    let win_board = [1, 1, 1, 0, 2, 2, 0, 0, 0]
    assert_eq("ttt_winner row0", ttt_winner(win_board), 1)
    let diag_board = [1, 0, 0, 0, 1, 0, 0, 0, 1]
    assert_eq("ttt_winner diag", ttt_winner(diag_board), 1)
    let no_win = [1, 2, 1, 2, 1, 2, 2, 1, 2]
    assert_eq("ttt_winner none full", ttt_winner(no_win), 0)
    assert_eq("ttt_is_draw true", ttt_is_draw(no_win), true)
    let empty_board = [0, 0, 0, 0, 0, 0, 0, 0, 0]
    assert_eq("ttt_is_draw false empty", ttt_is_draw(empty_board), false)
    // X can win by taking the center-blocking move: X at 0,4 O at 1
    let near_win = [1, 2, 0, 0, 1, 0, 0, 0, 0]
    let best = ttt_best_move(near_win, 1)
    assert_eq("ttt_best_move wins", best, 8)

    print("_game2_kat_test passed")
