import forge_matrixtransform

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn rm(m: list) -> string
    let out = ""
    let i = 0
    while i < len(m)
        if i > 0
            out = out + "|"
        let j = 0
        while j < len(m[i])
            if j > 0
                out = out + ","
            out = out + str(m[i][j])
            j = j + 1
        i = i + 1
    out

fn joinl(xs: list) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + ","
        out = out + str(xs[i])
        i = i + 1
    out

fn main()
    let fails = 0

    let m = []
    push(m, [1, 2])
    push(m, [3, 4])

    fails = fails + expect("transpose", rm(transpose(m)), "1,3|2,4")
    fails = fails + expect("cw", rm(rotate_cw(m)), "3,1|4,2")
    fails = fails + expect("ccw", rm(rotate_ccw(m)), "2,4|1,3")
    fails = fails + expect("fliph", rm(flip_horizontal(m)), "2,1|4,3")
    fails = fails + expect("flipv", rm(flip_vertical(m)), "3,4|1,2")

    // two cw rotations = 180
    fails = fails + expect("cw_twice", rm(rotate_cw(rotate_cw(m))), "4,3|2,1")
    // cw then ccw = identity
    fails = fails + expect("cw_ccw", rm(rotate_ccw(rotate_cw(m))), "1,2|3,4")

    // non-square 2x3
    let m2 = []
    push(m2, [1, 2, 3])
    push(m2, [4, 5, 6])
    fails = fails + expect("nonsq_t", rm(transpose(m2)), "1,4|2,5|3,6")
    fails = fails + expect("nonsq_cw", rm(rotate_cw(m2)), "4,1|5,2|6,3")

    // spiral
    let m3 = []
    push(m3, [1, 2, 3])
    push(m3, [4, 5, 6])
    push(m3, [7, 8, 9])
    fails = fails + expect("spiral3", joinl(spiral(m3)), "1,2,3,6,9,8,7,4,5")
    fails = fails + expect("spiral_row", joinl(spiral(m2)), "1,2,3,6,5,4")
    let m4 = []
    push(m4, [1, 2, 3, 4])
    push(m4, [5, 6, 7, 8])
    push(m4, [9, 10, 11, 12])
    fails = fails + expect("spiral4", joinl(spiral(m4)), "1,2,3,4,8,12,11,10,9,5,6,7")

    if fails == 0
        print("forge_matrixtransform: all passed")
    else
        print("forge_matrixtransform: " + str(fails) + " FAILED")
