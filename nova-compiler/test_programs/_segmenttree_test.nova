import std/collections/segmenttree

fn cki(label, got, want)
    if got == want
        print(label + " ok")
    else
        print("FAIL " + label + " got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // --- sum tree: [1,2,3,4,5] ---
    let s5 = st_build([1, 2, 3, 4, 5], "sum")
    cki("sum_q1_3", st_query(s5, 1, 3), 9)
    cki("sum_q0_4", st_query(s5, 0, 4), 15)
    // after update(2, 10): [1,2,10,4,5], query(1,3)=2+10+4=16
    st_update(s5, 2, 10)
    cki("sum_upd_q1_3", st_query(s5, 1, 3), 16)

    // --- min tree: [5,2,8,1] ---
    let mn4 = st_build([5, 2, 8, 1], "min")
    cki("min_q0_3", st_query(mn4, 0, 3), 1)
    cki("min_q0_1", st_query(mn4, 0, 1), 2)

    // --- max tree: [5,2,8,1] ---
    let mx4 = st_build([5, 2, 8, 1], "max")
    cki("max_q0_3", st_query(mx4, 0, 3), 8)
    cki("max_q2_3", st_query(mx4, 2, 3), 8)

    print("_segmenttree_test passed")
