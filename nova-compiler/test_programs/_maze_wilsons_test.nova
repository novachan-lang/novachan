// KAT for std/game/maze_wilsons
// Validates: edge_count == w*h-1, full connectivity, determinism.
import std/game/maze_wilsons

// Count undirected edges: sum of all adjacency list lengths divided by 2.
fn edge_count(links, total)
    let s = 0
    let i = 0
    while i < total
        s = s + len(links[i])
        i = i + 1
    return s / 2

// BFS from cell 0; returns number of cells visited.
fn bfs_count(links, total)
    let visited = []
    let qi = 0
    while qi < total
        push(visited, 0)
        qi = qi + 1
    let queue = []
    push(queue, 0)
    visited[0] = 1
    let count = 1
    let head = 0
    while head < len(queue)
        let cur = queue[head]
        head = head + 1
        let nb = links[cur]
        let ni = 0
        while ni < len(nb)
            let nxt = nb[ni]
            if visited[nxt] == 0
                visited[nxt] = 1
                count = count + 1
                push(queue, nxt)
            ni = ni + 1
    return count

// Check that two link-lists are identical.
fn links_equal(a, b, total)
    let i = 0
    while i < total
        let ai = a[i]
        let bi = b[i]
        if len(ai) != len(bi)
            return 0
        // Check every element of ai is also in bi (both are small lists of neighbors)
        let j = 0
        while j < len(ai)
            let v = ai[j]
            let found = 0
            let k = 0
            while k < len(bi)
                if bi[k] == v
                    found = 1
                k = k + 1
            if found == 0
                return 0
            j = j + 1
        i = i + 1
    return 1

fn check_maze(label, w, h, seed)
    let total = w * h
    let links = gen(w, h, seed)
    let ec = edge_count(links, total)
    let want_ec = total - 1
    if ec != want_ec
        print("FAIL maze_wilsons " + label + " edge_count: got " + str(ec) + " want " + str(want_ec))
        exit(1)
    let visited = bfs_count(links, total)
    if visited != total
        print("FAIL maze_wilsons " + label + " connected: visited " + str(visited) + " of " + str(total))
        exit(1)
    // Determinism: call again with same seed
    let links2 = gen(w, h, seed)
    let det = links_equal(links, links2, total)
    if det == 0
        print("FAIL maze_wilsons " + label + " determinism")
        exit(1)

fn main()
    // Test 1: 4x4, seed 42 — expected edges = 15
    check_maze("4x4_s42", 4, 4, 42)

    // Test 2: 3x3, seed 3 — expected edges = 8
    check_maze("3x3_s3", 3, 3, 3)

    // Test 3: 4x3 (non-square), seed 5 — expected edges = 11
    check_maze("4x3_s5", 4, 3, 5)

    // Test 4: 6x6, seed 42 — expected edges = 35
    check_maze("6x6_s42", 6, 6, 42)

    // Test 5: 1x1 edge case — no edges, one cell
    let links1 = gen(1, 1, 7)
    let ec1 = edge_count(links1, 1)
    if ec1 != 0
        print("FAIL maze_wilsons 1x1 edge_count: got " + str(ec1) + " want 0")
        exit(1)

    // Test 6: 1xN strip
    check_maze("1x5_s1", 1, 5, 1)
    check_maze("5x1_s1", 5, 1, 1)

    print("PASS _maze_wilsons_test")

main()
