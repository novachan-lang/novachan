// GPU compute oracle (CPU-backed): real elementwise kernels over a buffer.
// Expected values are hand-computed.
fn main()
    let buf = gpu_alloc(32)   // 4 x int64
    assert_eq(buf >= 0, true)
    gpu_write(buf, 0, 1)
    gpu_write(buf, 8, 2)
    gpu_write(buf, 16, 3)
    gpu_write(buf, 24, 4)

    // square: [1,2,3,4] -> [1,4,9,16]
    assert_eq(gpu_kernel_run("square", buf, 4, 1), 0)
    gpu_sync()
    assert_eq(gpu_read(buf, 0), 1)
    assert_eq(gpu_read(buf, 8), 4)
    assert_eq(gpu_read(buf, 16), 9)
    assert_eq(gpu_read(buf, 24), 16)

    // scale2: [1,4,9,16] -> [2,8,18,32]
    assert_eq(gpu_kernel_run("scale2", buf, 4, 1), 0)
    assert_eq(gpu_read(buf, 0), 2)
    assert_eq(gpu_read(buf, 8), 8)
    assert_eq(gpu_read(buf, 16), 18)
    assert_eq(gpu_read(buf, 24), 32)

    // unknown kernel must fail cleanly
    assert_eq(gpu_kernel_run("nonexistent", buf, 4, 1), -1)

    gpu_free(buf)
    print("GPU compute (CPU-backed) oracle test passed")
