import forge_huffman

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn rt(s: string) -> string
    let codes = huffman_build(s)
    huffman_decode(huffman_encode(s, codes), codes)

fn main()
    let fails = 0

    // round-trips
    fails = fails + expect("rt_hello", rt("hello world"), "hello world")
    fails = fails + expect("rt_miss", rt("mississippi"), "mississippi")
    fails = fails + expect("rt_abra", rt("abracadabra"), "abracadabra")
    fails = fails + expect("rt_single", rt("aaaa"), "aaaa")
    fails = fails + expect("rt_one", rt("Z"), "Z")
    fails = fails + expect("rt_empty", rt(""), "")
    fails = fails + expect("rt_mixed", rt("The Quick Brown Fox 123!!"), "The Quick Brown Fox 123!!")
    fails = fails + expect("rt_long", rt("aaaaaaaabbbbccccddddeeee ffff gggg"), "aaaaaaaabbbbccccddddeeee ffff gggg")

    // single-distinct-char code is "0"
    let cs = huffman_build("aaaa")
    fails = fails + expect("single_code", cs["a"], "0")
    fails = fails + expect("single_enc", huffman_encode("aaaa", cs), "0000")

    // more frequent char gets a SHORTER (or equal) code: a=4,b=3,c=1
    let cf = huffman_build("aaaabbbc")
    fails = fails + expect("a_len1", str(len(cf["a"])), "1")
    fails = fails + expect("c_len2", str(len(cf["c"])), "2")
    fails = fails + expect("a_shorter_c", str(len(cf["a"]) < len(cf["c"])), "1")

    // prefix-free check: no code is a prefix of another (verified by full-length string round-trip above,
    // plus an explicit encode/decode of a tricky ambiguous-looking input)
    fails = fails + expect("prefixfree_rt", rt("abababcabcabc"), "abababcabcabc")

    // compression: repetitive data uses far fewer than 8 bits/char
    let bits = huffman_encoded_bits("aaaaaaaabbbbcccd")
    fails = fails + expect("compresses", str(bits < 128), "1")

    if fails == 0
        print("forge_huffman: all passed")
    else
        print("forge_huffman: " + str(fails) + " FAILED")
