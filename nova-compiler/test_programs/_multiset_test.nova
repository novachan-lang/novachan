import std/collections/multiset

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + got + " want " + want)
        exit(1)

fn main()
    // Build a multiset
    let m = ms_new()
    ms_add(m, "a")
    ms_add(m, "a")
    ms_add_n(m, "b", 3)

    // KAT 1: count of "a" == 2
    cki("count_a", ms_count(m, "a"), 2)

    // KAT 2: count of absent key == 0
    cki("count_z", ms_count(m, "z"), 0)

    // KAT 3: total == 5
    cki("total", ms_total(m), 5)

    // KAT 4: distinct == ["a","b"]
    let dist = ms_distinct(m)
    cki("distinct_len", len(dist), 2)
    cks("distinct_0", dist[0], "a")
    cks("distinct_1", dist[1], "b")

    // KAT 5: remove "a" once, count becomes 1
    ms_remove(m, "a")
    cki("count_a_after_remove", ms_count(m, "a"), 1)

    // KAT 6: ms_contains "b" == true (1)
    cki("contains_b", ms_contains(m, "b"), 1)

    // KAT 7: ms_contains absent key == false (0)
    cki("contains_z", ms_contains(m, "z"), 0)

    // KAT 8: ms_most_common(m, 1) == [["b", 3]]
    let mc = ms_most_common(m, 1)
    cki("most_common_len", len(mc), 1)
    let top = mc[0]
    cks("most_common_item", top[0], "b")
    cki("most_common_cnt", top[1], 3)

    // KAT 9: remove "a" again -> key should disappear (count -> 0 -> deleted)
    ms_remove(m, "a")
    cki("count_a_gone", ms_count(m, "a"), 0)
    cki("contains_a_gone", ms_contains(m, "a"), 0)

    // KAT 10: remove absent key is a no-op
    ms_remove(m, "z")
    cki("total_after_noop", ms_total(m), 3)

    // KAT 11: ms_most_common with k larger than distinct count returns all
    ms_add_n(m, "c", 2)
    let all_mc = ms_most_common(m, 10)
    cki("most_common_all_len", len(all_mc), 2)
    // sorted by count desc: b=3, c=2
    cks("mc_all_0_item", all_mc[0][0], "b")
    cki("mc_all_0_cnt", all_mc[0][1], 3)
    cks("mc_all_1_item", all_mc[1][0], "c")
    cki("mc_all_1_cnt", all_mc[1][1], 2)

    // KAT 12: tie-breaking by item asc
    let m2 = ms_new()
    ms_add_n(m2, "z", 5)
    ms_add_n(m2, "a", 5)
    ms_add_n(m2, "m", 5)
    let tmc = ms_most_common(m2, 3)
    cks("tie_0", tmc[0][0], "a")
    cks("tie_1", tmc[1][0], "m")
    cks("tie_2", tmc[2][0], "z")

    print("_multiset_test passed")
