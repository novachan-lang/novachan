import std/gametheory/sprague_grundy

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _sprague_grundy_test " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gs = "false"
    if got
        gs = "true"
    let ws = "false"
    if want
        ws = "true"
    if got != want
        print("FAIL _sprague_grundy_test " + label + ": got " + gs + " want " + ws)
        exit(1)

fn ckl(label: string, got, want)
    let gl = len(got)
    let wl = len(want)
    if gl != wl
        print("FAIL _sprague_grundy_test " + label + " len: got " + str(gl) + " want " + str(wl))
        exit(1)
    let i = 0
    while i < gl
        if got[i] != want[i]
            print("FAIL _sprague_grundy_test " + label + "[" + str(i) + "]: got " + str(got[i]) + " want " + str(want[i]))
            exit(1)
        i = i + 1

fn mk_list_1(a: int) -> list
    let xs = []
    push(xs, a)
    xs

fn mk_list_2(a: int, b: int) -> list
    let xs = []
    push(xs, a)
    push(xs, b)
    xs

fn mk_list_3(a: int, b: int, c: int) -> list
    let xs = []
    push(xs, a)
    push(xs, b)
    push(xs, c)
    xs

fn mk_list_4(a: int, b: int, c: int, d: int) -> list
    let xs = []
    push(xs, a)
    push(xs, b)
    push(xs, c)
    push(xs, d)
    xs

fn main()
    // KAT: spg_mex
    cki("mex([0,1,2])", spg_mex(mk_list_3(0, 1, 2)), 3)
    cki("mex([0,1,3])", spg_mex(mk_list_3(0, 1, 3)), 2)
    cki("mex([1,2])",   spg_mex(mk_list_2(1, 2)), 0)
    let empty = []
    cki("mex([])", spg_mex(empty), 0)

    // KAT: spg_nim_sum
    cki("nim_sum([1,2,3])", spg_nim_sum(mk_list_3(1, 2, 3)), 0)
    cki("nim_sum([1,2,4])", spg_nim_sum(mk_list_3(1, 2, 4)), 7)

    // KAT: spg_grundy_dag([[1,2],[3],[3],[]],0)=0
    // adj[0]=[1,2], adj[1]=[3], adj[2]=[3], adj[3]=[]
    // grundy(3)=mex{}=0; grundy(1)=mex{0}=1; grundy(2)=mex{0}=1; grundy(0)=mex{1,1}=0
    let adj = []
    push(adj, mk_list_2(1, 2))
    push(adj, mk_list_1(3))
    push(adj, mk_list_1(3))
    push(adj, empty)
    cki("grundy_dag(adj,0)", spg_grundy_dag(adj, 0), 0)

    // Additional: leaf node (empty children) has Grundy value 0
    let adj2 = []
    push(adj2, empty)
    cki("grundy_dag(single,0)", spg_grundy_dag(adj2, 0), 0)

    // Linear chain: 0->1->2 (2 is leaf)
    // grundy(2)=0; grundy(1)=mex{0}=1; grundy(0)=mex{1}=0
    let adj3 = []
    push(adj3, mk_list_1(1))
    push(adj3, mk_list_1(2))
    push(adj3, empty)
    cki("grundy_dag(chain 0->1->2, node 0)", spg_grundy_dag(adj3, 0), 0)
    cki("grundy_dag(chain 0->1->2, node 1)", spg_grundy_dag(adj3, 1), 1)

    // spg_nim_sum edge: single element
    cki("nim_sum([5])", spg_nim_sum(mk_list_1(5)), 5)
    cki("nim_sum([0])", spg_nim_sum(mk_list_1(0)), 0)

    print("PASS _sprague_grundy_test")
