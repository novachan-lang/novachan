// Concurrency benchmark: channel throughput (vs Go goroutines)
// Sends 10K messages through a channel between two processes
ch = channel()

spawn fn()
    i = 0
    while i < 10000
        send(ch, i)
        i = i + 1
    send(ch, -1)

total = 0
count = 0
running = 1
while running == 1
    val = receive(ch)
    if val == -1
        running = 0
    else
        total = total + val
        count = count + 1
print(total)
