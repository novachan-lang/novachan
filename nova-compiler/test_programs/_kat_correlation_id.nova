import forge_correlation_id

fn main()
    let c = cid_new()
    c = cid_issue(c, "login-request")
    c = cid_issue(c, "payment-request")
    assert(cid_total_issued(c) == 2, "2 issued")
    assert(cid_active_count(c) == 2, "2 active")

    let lid = cid_latest_id(c)
    assert(is_ok(lid), "latest ok")
    assert(unwrap(lid) == 1001, "latest=1001")

    let ctx = cid_context(c, 1000)
    assert(is_ok(ctx), "ctx ok")
    assert(unwrap(ctx) == "login-request", "ctx=login")

    assert(cid_is_active(c, 1000) == 1, "1000 active")

    let comp = cid_complete(c, 1000)
    assert(is_ok(comp), "complete ok")
    c = unwrap(comp)
    assert(cid_is_active(c, 1000) == 0, "1000 not active")
    assert(cid_active_count(c) == 1, "1 active")

    let bad = cid_complete(c, 1000)
    assert(is_err(bad), "already completed")

    let bad2 = cid_context(c, 9999)
    assert(is_err(bad2), "not found")

    print("CORRELATION-ID KAT PASS")
