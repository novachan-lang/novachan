// KAT for std/calendar/julian_day — Julian Day Number core.
// Reference values from Meeus "Astronomical Algorithms" + USNO + Wikipedia.
import std/calendar/julian_day

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // ── greg_to_jdn known anchors ────────────────────────────────────────────
    cki("greg_to_jdn J2000",      greg_to_jdn(2000,  1,  1), 2451545)
    cki("greg_to_jdn Unix",       greg_to_jdn(1970,  1,  1), 2440588)
    cki("greg_to_jdn 1858-11-17", greg_to_jdn(1858, 11, 17), 2400001)
    cki("greg_to_jdn 2024-02-29", greg_to_jdn(2024,  2, 29), 2460370)

    // ── jdn_to_greg known anchors ────────────────────────────────────────────
    let g1 = jdn_to_greg(2451545)
    cki("jdn_to_greg J2000 y", g1[0], 2000)
    cki("jdn_to_greg J2000 m", g1[1], 1)
    cki("jdn_to_greg J2000 d", g1[2], 1)

    let g2 = jdn_to_greg(2440588)
    cki("jdn_to_greg Unix  y", g2[0], 1970)
    cki("jdn_to_greg Unix  m", g2[1], 1)
    cki("jdn_to_greg Unix  d", g2[2], 1)

    let g3 = jdn_to_greg(2400001)
    cki("jdn_to_greg MJD0  y", g3[0], 1858)
    cki("jdn_to_greg MJD0  m", g3[1], 11)
    cki("jdn_to_greg MJD0  d", g3[2], 17)

    // ── round-trip via loop ───────────────────────────────────────────────────
    let dates_y = []
    push(dates_y, 2024)
    push(dates_y, 1900)
    push(dates_y, 2000)
    push(dates_y, 1600)
    let dates_m = []
    push(dates_m, 2)
    push(dates_m, 3)
    push(dates_m, 6)
    push(dates_m, 1)
    let dates_d = []
    push(dates_d, 29)
    push(dates_d, 1)
    push(dates_d, 15)
    push(dates_d, 1)
    let i = 0
    while i < len(dates_y)
        let y = dates_y[i]
        let m = dates_m[i]
        let d = dates_d[i]
        let jdn = greg_to_jdn(y, m, d)
        let back = jdn_to_greg(jdn)
        cki("round-trip y i=" + str(i), back[0], y)
        cki("round-trip m i=" + str(i), back[1], m)
        cki("round-trip d i=" + str(i), back[2], d)
        i = i + 1

    // ── jdn_weekday ──────────────────────────────────────────────────────────
    // 2000-01-01 = Saturday = ISO 5
    cki("weekday 2000-01-01 Sat", jdn_weekday(greg_to_jdn(2000, 1, 1)), 5)
    // 2000-01-03 = Monday = ISO 0
    cki("weekday 2000-01-03 Mon", jdn_weekday(greg_to_jdn(2000, 1, 3)), 0)
    // 2024-02-29 = Thursday = ISO 3
    cki("weekday 2024-02-29 Thu", jdn_weekday(greg_to_jdn(2024, 2, 29)), 3)
    // Direct JDN: 2451545 = Saturday
    cki("weekday jdn=2451545 Sat", jdn_weekday(2451545), 5)

    print("PASS _julian_day_test")
