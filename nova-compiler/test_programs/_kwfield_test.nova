// Guard: a struct with KEYWORD-named fields (type/match/as/in) must parse ALL fields
// and support by-name access. Before the fix, parse_type_decl truncated at the first
// keyword field, silently producing a short struct + mis-typed constructor.
type Event
    type: string
    match: int
    as: float
    data: string

fn main()
    let e = Event("click", 7, 1.5, "payload")
    assert(e.type == "click", "type field")
    assert(e.match == 7, "match field (keyword)")
    assert(e.data == "payload", "data field after keyword fields")
    let d = e.as - 0.5
    assert(d > 0.9 and d < 1.1, "as field (float, keyword)")
    print("kwfield_test: all passed")
