import forge_env_resolver

fn main()
    let e = er_new("prod")
    assert(er_profile(e) == "prod", "profile = prod")

    e = er_set(e, "default", "db_host", "localhost")
    e = er_set(e, "prod", "db_host", "db.prod.internal")
    e = er_set(e, "dev", "db_host", "localhost:5432")
    e = er_set(e, "default", "log_level", "info")

    assert(er_resolve(e, "db_host") == "db.prod.internal", "prod db_host")
    assert(er_resolve(e, "log_level") == "info", "fallback to default")
    assert(er_has(e, "db_host") == 1, "has db_host")
    assert(er_has(e, "missing") == 0, "no missing")
    assert(er_resolve(e, "missing") == "", "missing empty")

    e = er_switch_profile(e, "dev")
    assert(er_profile(e) == "dev", "switched to dev")
    assert(er_resolve(e, "db_host") == "localhost:5432", "dev db_host")
    assert(er_resolve(e, "log_level") == "info", "still default log_level")

    print("ENV-RESOLVER KAT PASS")
