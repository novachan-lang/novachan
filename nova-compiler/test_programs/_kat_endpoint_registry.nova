import forge_endpoint_registry

fn main()
    let e = er_new()
    e = er_register(e, "auth", "http://auth:8080")
    e = er_register(e, "payment", "http://payment:8081")
    assert(er_endpoint_count(e) == 2, "2 endpoints")

    let r1 = er_lookup(e, "auth")
    assert(is_ok(r1), "lookup ok")
    assert(unwrap(r1) == "http://auth:8080", "auth url")

    assert(er_is_healthy(e, "auth") == 1, "auth healthy")

    let m = er_mark_unhealthy(e, "auth")
    assert(is_ok(m), "mark ok")
    e = unwrap(m)
    assert(er_is_healthy(e, "auth") == 0, "auth unhealthy")

    let r2 = er_lookup(e, "auth")
    assert(is_err(r2), "unhealthy lookup fails")

    let h = er_mark_healthy(e, "auth")
    assert(is_ok(h), "heal ok")
    e = unwrap(h)
    let r3 = er_lookup(e, "auth")
    assert(is_ok(r3), "healthy again")

    let bad = er_lookup(e, "nope")
    assert(is_err(bad), "not found")

    assert(er_total_lookups(e) == 4, "4 lookups")

    print("ENDPOINT-REGISTRY KAT PASS")
