import std/phonetic/roman_soundex

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL roman_soundex " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL roman_soundex " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// Canonical NARA/Knuth reference vectors from the task specification.
cks("Robert",    rs_encode("Robert"),    "R163")
cks("Rupert",    rs_encode("Rupert"),    "R163")
cks("Rubin",     rs_encode("Rubin"),     "R150")
cks("Ashcraft",  rs_encode("Ashcraft"),  "A261")
cks("Ashcroft",  rs_encode("Ashcroft"),  "A261")
cks("Tymczak",   rs_encode("Tymczak"),   "T522")
cks("Pfister",   rs_encode("Pfister"),   "P236")
cks("Honeyman",  rs_encode("Honeyman"),  "H555")
cki("diff_Robert_Rupert", rs_difference("Robert", "Rupert"), 4)

// Additional sanity checks from known sources.
cks("Euler",     rs_encode("Euler"),     "E460")
cks("Lee",       rs_encode("Lee"),       "L000")
cks("Lloyd",     rs_encode("Lloyd"),     "L300")
cks("lower",     rs_encode("robert"),    "R163")
cks("single",    rs_encode("A"),         "A000")

// rs_digit spot checks.
cki("digit_B", rs_digit("B"), 1)
cki("digit_S", rs_digit("S"), 2)
cki("digit_D", rs_digit("D"), 3)
cki("digit_L", rs_digit("L"), 4)
cki("digit_N", rs_digit("N"), 5)
cki("digit_R", rs_digit("R"), 6)
cki("digit_A", rs_digit("A"), 0)
cki("digit_H", rs_digit("H"), 0)

// rs_encode_full: no truncation.
cks("full_Euler", rs_encode_full("Euler"), "E46")

// rs_difference edge cases.
cki("diff_same",  rs_difference("Smith", "Smith"),  4)
cki("diff_diff",  rs_difference("Robert", "Rubin"), 2)

print("PASS _roman_soundex_test")
