// Phase 14: Deployment config, semver, deprecation

fn test_deploy_config()
    let cfg = deploy_config("fly", "nova-app")
    assert_eq(len(cfg) >= 3, true)
    assert_eq(cfg["provider"], "fly")
    assert_eq(cfg["app"], "nova-app")
    assert_eq(cfg["status"], "configured")
    // Validate config
    let err = deploy_validate(cfg)
    assert_eq(err, "")
    print("Deploy config test passed")

fn test_semver_parse()
    let v = semver_parse("1.2.3")
    assert_eq(v[0], 1)
    assert_eq(v[1], 2)
    assert_eq(v[2], 3)
    let v2 = semver_parse("v2.0.0")
    assert_eq(v2[0], 2)
    assert_eq(v2[1], 0)
    print("Semver parse test passed")

fn test_semver_compare()
    assert_eq(semver_compare("1.0.0", "2.0.0"), -1)
    assert_eq(semver_compare("2.0.0", "1.0.0"), 1)
    assert_eq(semver_compare("1.2.3", "1.2.3"), 0)
    assert_eq(semver_compare("1.2.3", "1.2.4"), -1)
    assert_eq(semver_compare("1.3.0", "1.2.9"), 1)
    print("Semver compare test passed")

fn test_semver_compatible()
    assert_eq(semver_compatible("1.0.0", "1.5.3"), 1)
    assert_eq(semver_compatible("2.0.0", "1.5.3"), 0)
    assert_eq(semver_compatible("1.0.0", "2.0.0"), 0)
    assert_eq(semver_compatible("3.1.0", "3.9.99"), 1)
    print("Semver compatible test passed")

fn test_deprecated_warn()
    // deprecated_warn prints to stderr and returns 0
    let r = deprecated_warn("old_api", "use new_api instead")
    assert_eq(r, 0)
    print("Deprecated warn test passed")

fn main()
    test_deploy_config()
    test_semver_parse()
    test_semver_compare()
    test_semver_compatible()
    test_deprecated_warn()
    print("All Phase 14 stabilization tests passed!")
