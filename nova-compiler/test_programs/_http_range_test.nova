import std/httphdr/http_range

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got=[" + got + "] want=[" + want + "]")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn ckl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        let gp = got[i]
        let wp = want[i]
        if gp[0] != wp[0] or gp[1] != wp[1]
            print("FAIL " + label + "[" + str(i) + "]: got=[" + str(gp[0]) + "," + str(gp[1]) + "] want=[" + str(wp[0]) + "," + str(wp[1]) + "]")
            exit(1)
        i = i + 1

fn main()
    // ── KAT spec: normal range ────────────────────────────────────────────────
    let r1 = hrg_resolve("bytes=0-499", 1000)
    cki("spec-r1-len", len(r1), 1)
    cki("spec-r1-0-start", r1[0][0], 0)
    cki("spec-r1-0-end",   r1[0][1], 499)

    // ── KAT spec: open-ended "N-" ─────────────────────────────────────────────
    let r2 = hrg_resolve("bytes=500-", 1000)
    cki("spec-r2-len", len(r2), 1)
    cki("spec-r2-0-start", r2[0][0], 500)
    cki("spec-r2-0-end",   r2[0][1], 999)

    // ── KAT spec: suffix "-N" ─────────────────────────────────────────────────
    let r3 = hrg_resolve("bytes=-500", 1000)
    cki("spec-r3-len", len(r3), 1)
    cki("spec-r3-0-start", r3[0][0], 500)
    cki("spec-r3-0-end",   r3[0][1], 999)

    // ── KAT spec: hrg_is_valid bytes= ────────────────────────────────────────
    ckb("spec-valid-bytes",  hrg_is_valid("bytes=0-499"), true)
    ckb("spec-invalid-items", hrg_is_valid("items=0-5"), false)

    // ── KAT spec: multi-range "bytes=0-0,-1" ─────────────────────────────────
    let r4 = hrg_resolve("bytes=0-0,-1", 1000)
    cki("spec-r4-len", len(r4), 2)
    cki("spec-r4-0-start", r4[0][0], 0)
    cki("spec-r4-0-end",   r4[0][1], 0)
    cki("spec-r4-1-start", r4[1][0], 999)
    cki("spec-r4-1-end",   r4[1][1], 999)

    // ── hrg_parse: normal range raw ──────────────────────────────────────────
    let p1 = hrg_parse("bytes=100-200")
    cki("parse-normal-len", len(p1), 1)
    cki("parse-normal-start", p1[0][0], 100)
    cki("parse-normal-end",   p1[0][1], 200)

    // ── hrg_parse: open-ended ────────────────────────────────────────────────
    let p2 = hrg_parse("bytes=500-")
    cki("parse-open-start", p2[0][0], 500)
    cki("parse-open-end",   p2[0][1], -1)

    // ── hrg_parse: suffix ─────────────────────────────────────────────────────
    let p3 = hrg_parse("bytes=-200")
    cki("parse-suffix-start", p3[0][0], -1)
    cki("parse-suffix-end",   p3[0][1], 200)

    // ── hrg_parse: invalid unit -> [] ────────────────────────────────────────
    let p4 = hrg_parse("lines=0-10")
    cki("parse-invalid-unit", len(p4), 0)

    // ── hrg_parse: empty -> [] ────────────────────────────────────────────────
    let p5 = hrg_parse("")
    cki("parse-empty", len(p5), 0)

    // ── hrg_parse: multiple ranges ────────────────────────────────────────────
    let p6 = hrg_parse("bytes=0-99, 200-299")
    cki("parse-multi-len", len(p6), 2)
    cki("parse-multi-0-start", p6[0][0], 0)
    cki("parse-multi-0-end",   p6[0][1], 99)
    cki("parse-multi-1-start", p6[1][0], 200)
    cki("parse-multi-1-end",   p6[1][1], 299)

    // ── hrg_resolve: range clamped to end of file ─────────────────────────────
    let r5 = hrg_resolve("bytes=900-1100", 1000)
    cki("resolve-clamp-len", len(r5), 1)
    cki("resolve-clamp-start", r5[0][0], 900)
    cki("resolve-clamp-end",   r5[0][1], 999)

    // ── hrg_resolve: range beyond total -> dropped ────────────────────────────
    let r6 = hrg_resolve("bytes=1000-1100", 1000)
    cki("resolve-beyond", len(r6), 0)

    // ── hrg_resolve: suffix larger than file -> clamp to 0 ──────────────────
    let r7 = hrg_resolve("bytes=-2000", 1000)
    cki("resolve-suffix-clamp-start", r7[0][0], 0)
    cki("resolve-suffix-clamp-end",   r7[0][1], 999)

    // ── hrg_resolve: suffix of exactly total bytes ────────────────────────────
    let r8 = hrg_resolve("bytes=-1000", 1000)
    cki("resolve-suffix-full-start", r8[0][0], 0)
    cki("resolve-suffix-full-end",   r8[0][1], 999)

    // ── hrg_resolve: open-ended from 0 ───────────────────────────────────────
    let r9 = hrg_resolve("bytes=0-", 500)
    cki("resolve-open0-start", r9[0][0], 0)
    cki("resolve-open0-end",   r9[0][1], 499)

    // ── hrg_is_valid: case-insensitive bytes ──────────────────────────────────
    ckb("valid-upper", hrg_is_valid("BYTES=0-10"), true)

    // ── hrg_is_valid: empty -> false ─────────────────────────────────────────
    ckb("valid-empty", hrg_is_valid(""), false)

    // ── hrg_is_satisfiable: basic satisfiable ────────────────────────────────
    ckb("satisfiable-yes",  hrg_is_satisfiable("bytes=0-499", 1000), true)
    ckb("satisfiable-no",   hrg_is_satisfiable("bytes=1000-1100", 1000), false)
    ckb("satisfiable-last", hrg_is_satisfiable("bytes=-1", 1000), true)

    // ── hrg_is_satisfiable: invalid unit ─────────────────────────────────────
    ckb("satisfiable-invalid", hrg_is_satisfiable("lines=0-10", 1000), false)

    // ── hrg_parse: inverted range (start > end) dropped ──────────────────────
    let p7 = hrg_parse("bytes=200-100")
    cki("parse-inverted", len(p7), 0)

    // ── hrg_resolve: zero total -> [] ────────────────────────────────────────
    let r10 = hrg_resolve("bytes=0-499", 0)
    cki("resolve-zero-total", len(r10), 0)

    // ── hrg_resolve: single last byte ────────────────────────────────────────
    let r11 = hrg_resolve("bytes=-1", 1000)
    cki("resolve-last-start", r11[0][0], 999)
    cki("resolve-last-end",   r11[0][1], 999)

    print("PASS _http_range_test")
