import std/math/catalan

// cki — check integer equality, print FAIL+exit(1) on mismatch
fn cki(label: string, got: int, expected: int)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// ckb — check boolean equality
fn ckb(label: string, got: bool, expected: bool)
    if got != expected
        let gs = "false"
        if got
            gs = "true"
        let es = "false"
        if expected
            es = "true"
        print("FAIL " + label + ": got " + gs + " expected " + es)
        exit(1)

// list_to_str — flatten an int list to "[a,b,c]" for comparison
fn list_to_str(xs)
    let s = "["
    let i = 0
    let n = len(xs)
    while i < n
        if i > 0
            s = s + ","
        s = s + str(xs[i])
        i = i + 1
    s = s + "]"
    s

fn main()
    // KAT 1: cat_n(0) = 1  (base case)
    cki("cat_n(0)", cat_n(0), 1)

    // KAT 2: cat_n(1) = 1
    cki("cat_n(1)", cat_n(1), 1)

    // KAT 3: cat_n(2) = 2
    cki("cat_n(2)", cat_n(2), 2)

    // KAT 4: cat_n(3) = 5
    // C(3)=C(2)*2*(2*3-1)/(3+1) = 2*2*5/4 = 5
    cki("cat_n(3)", cat_n(3), 5)

    // KAT 5: cat_n(4) = 14
    // C(4)=C(3)*2*(2*4-1)/(4+1) = 5*2*7/5 = 14
    cki("cat_n(4)", cat_n(4), 14)

    // KAT 6: cat_n(5) = 42
    // C(5)=C(4)*2*(2*5-1)/(5+1) = 14*2*9/6 = 42
    cki("cat_n(5)", cat_n(5), 42)

    // KAT 7: cat_n(9) = 4862
    cki("cat_n(9)", cat_n(9), 4862)

    // KAT 8: cat_list(5) = [1,1,2,5,14]
    let cl5 = cat_list(5)
    cki("cat_list(5)_len", len(cl5), 5)
    let cl5s = list_to_str(cl5)
    if cl5s != "[1,1,2,5,14]"
        print("FAIL cat_list(5): got " + cl5s + " expected [1,1,2,5,14]")
        exit(1)

    // KAT 9: cat_list(0) = []
    let cl0 = cat_list(0)
    cki("cat_list(0)_len", len(cl0), 0)

    // KAT 10: cat_list(1) = [1]
    let cl1 = cat_list(1)
    cki("cat_list(1)_len", len(cl1), 1)
    cki("cat_list(1)[0]", cl1[0], 1)

    // KAT 11: cat_is(42) = true  (C(5)=42)
    ckb("cat_is(42)", cat_is(42), true)

    // KAT 12: cat_is(43) = false
    ckb("cat_is(43)", cat_is(43), false)

    // KAT 13: cat_is(1) = true  (C(0)=1 and C(1)=1)
    ckb("cat_is(1)", cat_is(1), true)

    // KAT 14: cat_is(0) = false  (0 is not a Catalan number)
    ckb("cat_is(0)", cat_is(0), false)

    // KAT 15: cat_is(14) = true  (C(4)=14)
    ckb("cat_is(14)", cat_is(14), true)

    // KAT 16: cat_is(4862) = true  (C(9)=4862)
    ckb("cat_is(4862)", cat_is(4862), true)

    // KAT 17: cat_is(4863) = false
    ckb("cat_is(4863)", cat_is(4863), false)

    print("_catalan_test passed")
