import std/backtracking/bt_partition_k

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _bt_partition_k_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL _bt_partition_k_test " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn main()
    // --- pk_subset_sum_target ---
    // [4,3,2,3,5,2,1] k=4: sum=20, 20/4=5
    let nums1 = [4, 3, 2, 3, 5, 2, 1]
    cki("target_4321k4", pk_subset_sum_target(nums1, 4), 5)

    // [1,2,3] k=2: sum=6, 6/2=3 (divisible!)
    let nums2 = [1, 2, 3]
    cki("target_123_k2", pk_subset_sum_target(nums2, 2), 3)

    // [1,2,3,4] k=3: sum=10, 10%3 != 0 => -1
    let nums3 = [1, 2, 3, 4]
    cki("target_1234_k3", pk_subset_sum_target(nums3, 3), -1)

    // [2,2,2,2] k=2: sum=8, 8/2=4
    let nums4 = [2, 2, 2, 2]
    cki("target_2222_k2", pk_subset_sum_target(nums4, 2), 4)

    // k=0 => -1
    cki("target_k0", pk_subset_sum_target(nums1, 0), -1)

    // --- pk_can_partition ---
    // [4,3,2,3,5,2,1] k=4 => true (sum=20, target=5; e.g. {5},{4,1},{3,2},{3,2})
    ckb("can_4321_k4", pk_can_partition(nums1, 4), true)

    // [1,2,3,4] k=3 => false (sum=10 not divisible by 3)
    ckb("can_1234_k3", pk_can_partition(nums3, 3), false)

    // [2,2,2,2] k=2 => true ({2,2},{2,2})
    ckb("can_2222_k2", pk_can_partition(nums4, 2), true)

    // [1,1,1,1] k=2 => true ({1,1},{1,1})
    let nums5 = [1, 1, 1, 1]
    ckb("can_1111_k2", pk_can_partition(nums5, 2), true)

    // k=1 always true
    ckb("can_k1", pk_can_partition(nums1, 1), true)

    // Single element k=1 => true
    let single = [7]
    ckb("can_single_k1", pk_can_partition(single, 1), true)

    // Single element k=2 => false (need 2 subsets but only 1 element)
    ckb("can_single_k2", pk_can_partition(single, 2), false)

    // Element larger than target => false
    let nums6 = [5, 1, 1, 1]
    // sum=8, k=4, target=2; but 5>2 => false
    ckb("can_elem_over_target", pk_can_partition(nums6, 4), false)

    // All same elements, k equals count => true (each subset has 1 element)
    let nums7 = [3, 3, 3, 3]
    ckb("can_3333_k4", pk_can_partition(nums7, 4), true)

    // [3,3,3,3] k=2 => true (sum=12, target=6; {3,3},{3,3})
    ckb("can_3333_k2", pk_can_partition(nums7, 2), true)

    // [1,2,3,4,5,6,7] k=3: sum=28, not div 3 => false
    let nums8 = [1, 2, 3, 4, 5, 6, 7]
    ckb("can_1to7_k3", pk_can_partition(nums8, 3), false)

    // [1,2,3,4,5,6] k=3: sum=21, target=7; {1,6},{2,5},{3,4} => true
    let nums9 = [1, 2, 3, 4, 5, 6]
    ckb("can_1to6_k3", pk_can_partition(nums9, 3), true)

    print("PASS _bt_partition_k_test")
