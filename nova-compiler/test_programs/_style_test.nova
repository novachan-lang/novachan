import std/term/style

fn main()
    // ── KAT: individual accessors ──────────────────────────────────────────────

    // bold() == ESC[1m
    let got_bold = bold()
    let want_bold = chr(27) + "[1m"
    if got_bold != want_bold
        print("FAIL style bold: len got=" + str(len(got_bold)) + " want=" + str(len(want_bold)))
        exit(1)

    // dim() == ESC[2m
    let got_dim = dim()
    let want_dim = chr(27) + "[2m"
    if got_dim != want_dim
        print("FAIL style dim: len got=" + str(len(got_dim)) + " want=" + str(len(want_dim)))
        exit(1)

    // italic() == ESC[3m
    let got_italic = italic()
    let want_italic = chr(27) + "[3m"
    if got_italic != want_italic
        print("FAIL style italic: len got=" + str(len(got_italic)) + " want=" + str(len(want_italic)))
        exit(1)

    // underline() == ESC[4m
    let got_ul = underline()
    let want_ul = chr(27) + "[4m"
    if got_ul != want_ul
        print("FAIL style underline: len got=" + str(len(got_ul)) + " want=" + str(len(want_ul)))
        exit(1)

    // blink() == ESC[5m
    let got_blink = blink()
    let want_blink = chr(27) + "[5m"
    if got_blink != want_blink
        print("FAIL style blink: len got=" + str(len(got_blink)) + " want=" + str(len(want_blink)))
        exit(1)

    // reverse() == ESC[7m
    let got_rev = reverse()
    let want_rev = chr(27) + "[7m"
    if got_rev != want_rev
        print("FAIL style reverse: len got=" + str(len(got_rev)) + " want=" + str(len(want_rev)))
        exit(1)

    // hidden() == ESC[8m
    let got_hidden = hidden()
    let want_hidden = chr(27) + "[8m"
    if got_hidden != want_hidden
        print("FAIL style hidden: len got=" + str(len(got_hidden)) + " want=" + str(len(want_hidden)))
        exit(1)

    // strike() == ESC[9m
    let got_strike = strike()
    let want_strike = chr(27) + "[9m"
    if got_strike != want_strike
        print("FAIL style strike: len got=" + str(len(got_strike)) + " want=" + str(len(want_strike)))
        exit(1)

    // reset() == ESC[0m
    let got_reset = reset()
    let want_reset = chr(27) + "[0m"
    if got_reset != want_reset
        print("FAIL style reset: len got=" + str(len(got_reset)) + " want=" + str(len(want_reset)))
        exit(1)

    // ── KAT: style(text, name) ────────────────────────────────────────────────

    // style("x","bold") == ESC[1m + "x" + ESC[0m
    let got_sb = style("x", "bold")
    let want_sb = chr(27) + "[1m" + "x" + chr(27) + "[0m"
    if got_sb != want_sb
        print("FAIL style style-bold: len got=" + str(len(got_sb)) + " want=" + str(len(want_sb)))
        exit(1)

    // style("x","italic") == ESC[3m + "x" + ESC[0m
    let got_si = style("x", "italic")
    let want_si = chr(27) + "[3m" + "x" + chr(27) + "[0m"
    if got_si != want_si
        print("FAIL style style-italic: len got=" + str(len(got_si)) + " want=" + str(len(want_si)))
        exit(1)

    // style("x","underline") == ESC[4m + "x" + ESC[0m
    let got_su = style("x", "underline")
    let want_su = chr(27) + "[4m" + "x" + chr(27) + "[0m"
    if got_su != want_su
        print("FAIL style style-underline: len got=" + str(len(got_su)) + " want=" + str(len(want_su)))
        exit(1)

    // style("x","strike") == ESC[9m + "x" + ESC[0m
    let got_ss = style("x", "strike")
    let want_ss = chr(27) + "[9m" + "x" + chr(27) + "[0m"
    if got_ss != want_ss
        print("FAIL style style-strike: len got=" + str(len(got_ss)) + " want=" + str(len(want_ss)))
        exit(1)

    // style("x","dim") == ESC[2m + "x" + ESC[0m
    let got_sd = style("x", "dim")
    let want_sd = chr(27) + "[2m" + "x" + chr(27) + "[0m"
    if got_sd != want_sd
        print("FAIL style style-dim: len got=" + str(len(got_sd)) + " want=" + str(len(want_sd)))
        exit(1)

    // Unknown name returns text unchanged
    let got_unk = style("hello", "unknown")
    if got_unk != "hello"
        print("FAIL style style-unknown: got=" + got_unk)
        exit(1)

    // Empty text with bold
    let got_empty = style("", "bold")
    let want_empty = chr(27) + "[1m" + chr(27) + "[0m"
    if got_empty != want_empty
        print("FAIL style style-empty: len got=" + str(len(got_empty)) + " want=" + str(len(want_empty)))
        exit(1)

    // Longer text
    let got_long = style("Hello, NOVA!", "reverse")
    let want_long = chr(27) + "[7m" + "Hello, NOVA!" + chr(27) + "[0m"
    if got_long != want_long
        print("FAIL style style-reverse-long: len got=" + str(len(got_long)) + " want=" + str(len(want_long)))
        exit(1)

    print("PASS _style_test")
