import forge_prng

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn joinl(xs: list) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + ","
        out = out + str(xs[i])
        i = i + 1
    out

fn main()
    let fails = 0

    // determinism: same seed -> identical stream
    let r1 = prng_new(123)
    let r2 = prng_new(123)
    let seq1 = []
    let seq2 = []
    let i = 0
    while i < 5
        push(seq1, prng_next(r1))
        push(seq2, prng_next(r2))
        i = i + 1
    fails = fails + expect("determinism", joinl(seq1), joinl(seq2))

    // different seeds -> different streams (very likely)
    let r3 = prng_new(999)
    fails = fails + expect("differ", str(prng_next(r3) != seq1[0]), "1")

    // range bounds
    let r4 = prng_new(7)
    let inrange = 1
    let n = 0
    while n < 200
        let v = prng_int(r4, 10, 20)
        if v < 10 or v > 20
            inrange = 0
        n = n + 1
    fails = fails + expect("range", str(inrange), "1")

    // coverage: prng_int(0,5) hits all 6 values over many draws
    let r5 = prng_new(55)
    let seen = []
    let z = 0
    while z < 6
        push(seen, 0)
        z = z + 1
    let d = 0
    while d < 600
        seen[prng_int(r5, 0, 5)] = 1
        d = d + 1
    let allhit = 1
    let s = 0
    while s < 6
        if seen[s] == 0
            allhit = 0
        s = s + 1
    fails = fails + expect("coverage", str(allhit), "1")

    // shuffle is a permutation (sorted multiset preserved)
    let r6 = prng_new(42)
    let sh = prng_shuffle(r6, [1, 2, 3, 4, 5])
    fails = fails + expect("shuffle_len", str(len(sh)), "5")
    // sort the shuffle to verify it's a permutation of 1..5
    let a = 1
    while a < len(sh)
        let key = sh[a]
        let b = a - 1
        while b >= 0 and sh[b] > key
            sh[b + 1] = sh[b]
            b = b - 1
        sh[b + 1] = key
        a = a + 1
    fails = fails + expect("shuffle_perm", joinl(sh), "1,2,3,4,5")

    // reproducible shuffle: same seed -> same shuffle
    let r7 = prng_new(42)
    let r8 = prng_new(42)
    fails = fails + expect("shuffle_repro", joinl(prng_shuffle(r7, [1, 2, 3, 4, 5])), joinl(prng_shuffle(r8, [1, 2, 3, 4, 5])))

    // sample: k distinct from the list
    let r9 = prng_new(11)
    let samp = prng_sample(r9, [10, 20, 30, 40, 50], 3)
    fails = fails + expect("sample_len", str(len(samp)), "3")
    // all sampled values are from the source
    let allfrom = 1
    let si = 0
    while si < len(samp)
        let found = 0
        if samp[si] == 10 or samp[si] == 20 or samp[si] == 30 or samp[si] == 40 or samp[si] == 50
            found = 1
        if found == 0
            allfrom = 0
        si = si + 1
    fails = fails + expect("sample_valid", str(allfrom), "1")

    // choice returns an element of the list
    let r10 = prng_new(88)
    let ch = prng_choice(r10, [100, 200, 300])
    fails = fails + expect("choice", str(ch == 100 or ch == 200 or ch == 300), "1")

    if fails == 0
        print("forge_prng: all passed")
    else
        print("forge_prng: " + str(fails) + " FAILED")
