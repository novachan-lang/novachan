import forge_command_bus

fn main()
    let bus = cmdb_new()
    bus = cmdb_register(bus, "CreateUser", "user_handler")
    bus = cmdb_register(bus, "DeleteUser", "user_handler")
    bus = cmdb_register(bus, "SendEmail", "email_handler")

    assert(cmdb_has_handler(bus, "CreateUser") == true, "has CreateUser")
    assert(cmdb_has_handler(bus, "Unknown") == false, "no Unknown")

    let cmds = cmdb_list_commands(bus)
    assert(len(cmds) == 3, "3 commands")

    bus = cmdb_add_middleware(bus, "logging")
    bus = cmdb_add_middleware(bus, "auth")

    bus = cmdb_dispatch(bus, "CreateUser", "alice")
    bus = cmdb_dispatch(bus, "SendEmail", "welcome")
    bus = cmdb_dispatch(bus, "Unknown", "test")

    assert(cmdb_history_count(bus) == 3, "3 dispatches")

    let hist = cmdb_history(bus)
    assert(hist[0]["type"] == "CreateUser", "first=CreateUser")
    assert(hist[0]["status"] == "dispatched", "dispatched")
    assert(hist[0]["handler"] == "user_handler", "handler")
    assert(hist[0]["middleware_applied"] == 2, "2 middleware")

    assert(hist[2]["status"] == "no_handler", "unknown no handler")

    let last = cmdb_last_dispatch(bus)
    assert(last["type"] == "Unknown", "last=Unknown")

    print("COMMAND-BUS KAT PASS")
