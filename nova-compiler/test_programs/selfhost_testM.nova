// Test: structs, match destructuring, nested data
type Token
    kind: string
    value: string

fn make_token(k: string, v: string) -> Token
    Token(k, v)

fn is_keyword(t: Token) -> bool
    match t
        Token(kind, value) =>
            if kind == "KW"
                return true
    return false

fn token_str(t: Token) -> string
    match t
        Token(kind, value) =>
            return kind + ":" + value
    return ""

let t1 = make_token("KW", "fn")
let t2 = make_token("IDENT", "hello")
let t3 = make_token("NUM", "42")

print(is_keyword(t1))
print(is_keyword(t2))
print(token_str(t1))
print(token_str(t2))
print(token_str(t3))
