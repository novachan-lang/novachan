// Value-model soundness: float() of an already-float value (and int() of an int) is
// identity. nova_rt_to_float assumes an int/string payload, so feeding it the raw float
// BITS of a float-typed value produced garbage; the compiler now recognizes the
// redundant cast at the IR level (arg statically float) and lowers it to a copy.
// float(int) still converts (int -> float) as before.

fn main()
    // float(float) is identity (was garbage)
    let x = 2.5
    let y = float(x)
    assert_near(y, 2.5, 0.0001)
    assert_near(float(x) + 1.0, 3.5, 0.0001)
    let w = float(x * 2.0)
    assert_near(w, 5.0, 0.0001)

    // int(int) is identity
    let n = 42
    assert_eq(int(n), 42)
    assert_eq(int(n) + 1, 43)

    // float(int) still converts correctly
    assert_near(float(5), 5.0, 0.0001)
    assert_near(float(n), 42.0, 0.0001)

    print("floatcast passed")
