// KAT for std/units/area.nova
import std/units/area

fn approx(a: float, b: float, tol: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < tol

fn ckf(label: string, got: float, want: float, tol: float)
    if not approx(got, want, tol)
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    let tol = 0.0001

    // KAT 1: 1 km2 -> 1000000 m2
    let r1 = area_convert(1.0, "km2", "m2")
    ckf("km2_to_m2", r1, 1000000.0, 0.001)

    // KAT 2: 1 ha -> 10000 m2
    let r2 = area_convert(1.0, "ha", "m2")
    ckf("ha_to_m2", r2, 10000.0, tol)

    // KAT 3: 1 acre -> 4046.8564224 m2
    let r3 = area_convert(1.0, "acre", "m2")
    ckf("acre_to_m2", r3, 4046.8564224, 0.001)

    // KAT 4: 1 ft2 -> 144 in2 (exact by definition)
    let r4 = area_convert(1.0, "ft2", "in2")
    ckf("ft2_to_in2", r4, 144.0, 0.01)

    // KAT 5: 1 m2 -> 1 m2 (identity)
    let r5 = area_convert(1.0, "m2", "m2")
    ckf("m2_identity", r5, 1.0, tol)

    // KAT 6: 1000000 m2 -> 1 km2
    let r6 = area_convert(1000000.0, "m2", "km2")
    ckf("m2_to_km2", r6, 1.0, tol)

    // KAT 7: round-trip acre
    let base7 = area_to_base(5.0, "acre")
    let rt7 = area_from_base(base7, "acre")
    ckf("roundtrip_acre", rt7, 5.0, tol)

    // KAT 8: round-trip ha
    let base8 = area_to_base(3.7, "ha")
    let rt8 = area_from_base(base8, "ha")
    ckf("roundtrip_ha", rt8, 3.7, tol)

    // KAT 9: area_factor for m2 == 1.0
    let f1 = area_factor("m2")
    ckf("factor_m2", f1, 1.0, tol)

    // KAT 10: area_factor for km2 == 1000000.0
    let f2 = area_factor("km2")
    ckf("factor_km2", f2, 1000000.0, 1.0)

    // KAT 11: area_factor unknown -> 0.0
    let fu = area_factor("xyz")
    ckf("factor_unknown", fu, 0.0, tol)

    // KAT 12: area_is_supported
    let s1 = area_is_supported("m2")
    cki("supported_m2", s1, 1)
    let s2 = area_is_supported("xyz")
    cki("unsupported_xyz", s2, 0)

    // KAT 13: area_units returns 10 entries
    let us = area_units()
    cki("units_len", len(us), 10)

    // KAT 14: 1 mi2 -> m2 (approx 2589988.11)
    let r14 = area_convert(1.0, "mi2", "m2")
    ckf("mi2_to_m2", r14, 2589988.110336, 1.0)

    // KAT 15: 1 yd2 -> ft2 (= 9 ft2 exactly)
    let r15 = area_convert(1.0, "yd2", "ft2")
    ckf("yd2_to_ft2", r15, 9.0, 0.0001)

    print("PASS _area_test")
