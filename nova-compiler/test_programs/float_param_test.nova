// #13 param-case guard: a float array passed to a function reads natively (via fpt
// call-site typing), AND a function used polymorphically (float list AND int list)
// must stay correct -- fpt conflict -> generic, never read an int as a double.

fn sumlist(xs)
    let s = 0.0
    let i = 0
    while i < len(xs)
        s = s + xs[i]
        i = i + 1
    s

fn firstplus(xs)
    xs[0] + 1

fn main()
    // float array as a parameter
    let fl = []
    push(fl, 1.5)
    push(fl, 2.5)
    push(fl, 4.0)
    assert(sumlist(fl) == 8.0, "float-array param sum = 8.0")

    // a pure-int array through the SAME signature -> intlist fast path, correct
    let il = []
    push(il, 10)
    push(il, 20)
    push(il, 30)
    assert(sumlist(il) == 60.0, "int-array param sum = 60.0")

    // POLYMORPHIC use: firstplus called with BOTH a float list and an int list.
    // fpt must NOT force the param to floatlist (would read 10 as a raw double).
    let f2 = []
    push(f2, 1.5)
    push(f2, 2.5)
    let i2 = []
    push(i2, 10)
    push(i2, 20)
    assert(firstplus(f2) == 2.5, "poly param float: 1.5+1 = 2.5")
    assert(firstplus(i2) == 11, "poly param int: 10+1 = 11 (NOT a misread double)")

    print("float_param_test: all passed")
