// #16 sub-cycle 2: HTTP client cookie jar. A loopback server sets a session cookie; http_get_session
// must absorb it into the jar so it is sent on the next request. Verifies absorption + Cookie-header
// build. Self-contained (no external network).
import forge
import forge_http_client

fn main()
    let port = 18093
    spawn fn()
        let sock = http_listen(port)
        let c1 = http_accept_raw(sock)
        if len(c1) > 0
            http_send_raw(c1[0], "HTTP/1.1 200 OK\r\nSet-Cookie: session=abc123; Path=/; HttpOnly\r\nContent-Length: 2\r\nConnection: close\r\n\r\nhi")
    sleep(800)
    let jar = {}
    match forge_http_client.http_get_session("http://127.0.0.1:{port}/login", jar, 5)
        Ok(resp) =>
            let stored = ""
            if contains(jar, "session")
                stored = jar["session"]
            let hdr = forge_http_client.cookie_header(jar)
            if stored == "abc123" and hdr == "session=abc123"
                print("PASS _kat_http_cookie")
            else
                print("FAIL stored=[{stored}] hdr=[{hdr}] status={resp.status}")
        Err(e) =>
            print("FAIL err={e}")
