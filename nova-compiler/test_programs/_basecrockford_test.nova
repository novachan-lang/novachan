// KAT test for std/encoding/basecrockford
// Crockford Base32: integer <-> string encoding with optional check symbol.

import std/encoding/basecrockford

// Integer equality check helper
fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// String equality check helper
fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got [" + got + "] expected [" + expected + "]")
        exit(1)

let x = 0

// ── bc_encode KATs ────────────────────────────────────────────────────────────

// bc_encode(0) == "0"  (Crockford: zero encodes as single "0")
cks("bc_encode(0)", bc_encode(0), "0")

// bc_encode(1) == "1"
cks("bc_encode(1)", bc_encode(1), "1")

// bc_encode(31) == "Z"  (max single-digit value, last symbol in alphabet)
cks("bc_encode(31)", bc_encode(31), "Z")

// bc_encode(32) == "10"  (32 = 1*32 + 0)
cks("bc_encode(32)", bc_encode(32), "10")

// bc_encode(1234) == "16J"
// Verify by hand: 1234 / 32 = 38 rem 18 → 'J'; 38/32=1 rem 6 → '6'; 1/32=0 rem 1 → '1'
// So digits (LSB-first): J, 6, 1 → reversed: "16J"
cks("bc_encode(1234)", bc_encode(1234), "16J")

// bc_encode(1000000) — value to round-trip below
// 1000000 in base 32: 1000000 / 32 = 31250 r 0 → '0'
//   31250 / 32 = 976 r 18 → 'J'; 976/32=30 r 16 → 'G'; 30/32=0 r 30 → 'V'
// Digits LSB-first: 0,J,G,V → reversed: "VGJO"  ... let bc_encode give the answer
// and we round-trip below.

// ── bc_decode KATs ────────────────────────────────────────────────────────────

// bc_decode("16J") == 1234
cki("bc_decode(16J)", bc_decode("16J"), 1234)

// bc_decode("16j") == 1234  (case-insensitive)
cki("bc_decode(16j)", bc_decode("16j"), 1234)

// bc_decode("O") == 0   (letter O substituted as 0)
cki("bc_decode(O)", bc_decode("O"), 0)

// bc_decode("I") == 1   (letter I substituted as 1)
cki("bc_decode(I)", bc_decode("I"), 1)

// bc_decode("L") == 1   (letter L substituted as 1)
cki("bc_decode(L)", bc_decode("L"), 1)

// bc_decode with hyphens (ignored): "16-J" == 1234
cki("bc_decode(16-J)", bc_decode("16-J"), 1234)

// bc_decode("0") == 0
cki("bc_decode(0)", bc_decode("0"), 0)

// bc_decode("Z") == 31
cki("bc_decode(Z)", bc_decode("Z"), 31)

// ── Round-trip KAT ────────────────────────────────────────────────────────────

// bc_decode(bc_encode(1000000)) == 1000000
let encoded_million = bc_encode(1000000)
let decoded_million = bc_decode(encoded_million)
cki("round-trip(1000000)", decoded_million, 1000000)

// Additional round-trips for coverage
let rt2 = bc_decode(bc_encode(0))
cki("round-trip(0)", rt2, 0)

let rt3 = bc_decode(bc_encode(32))
cki("round-trip(32)", rt3, 32)

let rt4 = bc_decode(bc_encode(999999999))
cki("round-trip(999999999)", rt4, 999999999)

// ── Check-symbol KATs ─────────────────────────────────────────────────────────

// bc_decode_check(bc_encode_check(1234)) == 1234
let enc_check = bc_encode_check(1234)
let dec_check = bc_decode_check(enc_check)
cki("bc_decode_check(bc_encode_check(1234))", dec_check, 1234)

// bc_encode_check(0): n=0, check = 0 mod 37 = 0 → check symbol '0'
// bc_encode(0)="0", appended check '0' → "00"
cks("bc_encode_check(0)", bc_encode_check(0), "00")

// bc_decode_check("00") == 0
cki("bc_decode_check(00)", bc_decode_check("00"), 0)

// Round-trip for larger value
let enc_check2 = bc_encode_check(1000000)
let dec_check2 = bc_decode_check(enc_check2)
cki("check-round-trip(1000000)", dec_check2, 1000000)

// Bad check symbol: should return -1
// "16K" decodes data "16"=38, check 'K' → _bck_char_to_val('K')=19
// bc_encode(1234)="16J", check for 1234 = 1234 mod 37 = 1234 - 33*37 = 1234-1221=13
// 13 maps to 'D' (digit 13 = 'D' in alphabet "0123456789ABCDEFGHJKMNPQRSTVWXYZ"
//  → index 13: 0123456789ABC[D] → yes 'D')
// So "16JX" has wrong check symbol → should return -1
let bad_check = bc_decode_check("16JX")
cki("bc_decode_check(bad-check)", bad_check, -1)

// Empty string: bc_decode_check("") == -1
let empty_check = bc_decode_check("")
cki("bc_decode_check(empty)", empty_check, -1)

print("_basecrockford_test passed")
