fn gz_flags_direct(buf: any) -> int
    if len(buf) < 4
        return 0
    return buf[3]

fn gz_flag_fname_direct(buf: any) -> bool
    if len(buf) < 4
        return false
    let f = buf[3]
    if (f & 8) == 8
        return true
    return false

fn gz_flag_fname_via_call(buf: any) -> bool
    let f = gz_flags_direct(buf)
    if (f & 8) == 8
        return true
    return false

fn main()
    let buf = []
    push(buf, 31)
    push(buf, 139)
    push(buf, 8)
    push(buf, 8)
    push(buf, 0)
    push(buf, 0)
    push(buf, 0)
    push(buf, 0)
    push(buf, 0)
    push(buf, 3)

    let direct = gz_flag_fname_direct(buf)
    print("direct=" + str(direct))
    
    let via_call = gz_flag_fname_via_call(buf)
    print("via_call=" + str(via_call))

    print("PASS _gzdbg3_test")
