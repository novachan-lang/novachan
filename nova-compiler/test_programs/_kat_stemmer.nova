import forge_stemmer

fn ck(w: string, want: string)
    let got = stem(w)
    let ok = "FAIL"
    if got == want
        ok = "ok"
    print(w + "->" + got + " [" + ok + "]")

fn main()
    ck("caresses", "caress")
    ck("ponies", "poni")
    ck("cats", "cat")
    ck("agreed", "agre")
    ck("plastered", "plaster")
    ck("motoring", "motor")
    ck("hopping", "hop")
    ck("sized", "size")
    ck("falling", "fall")
    ck("happy", "happi")
    ck("sky", "sky")
    ck("relational", "relat")
    ck("conditional", "condit")
    ck("digitizer", "digit")
    ck("operator", "oper")
    ck("hopeful", "hope")
    ck("goodness", "good")
    ck("formalize", "formal")
    ck("revival", "reviv")
    ck("allowance", "allow")
    ck("adjustable", "adjust")
    ck("dependent", "depend")
    ck("adoption", "adopt")
    ck("probate", "probat")
    ck("rate", "rate")
    ck("cease", "ceas")
    ck("controll", "control")
    ck("roll", "roll")
    ck("generalization", "gener")
