import std/probability/prob_derangement

// ckr — check fraction [num,den] matches expected wn/wd.
fn ckr(label: string, got, wn: int, wd: int)
    if got[0] != wn or got[1] != wd
        print("FAIL prob_derangement " + label + ": got=[" + str(got[0]) + "," + str(got[1]) + "] want=[" + str(wn) + "," + str(wd) + "]")
        exit(1)

// cki — check integer equality.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL prob_derangement " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // pdr_count KAT
    cki("pdr_count(0)", pdr_count(0), 1)
    cki("pdr_count(1)", pdr_count(1), 0)
    cki("pdr_count(2)", pdr_count(2), 1)
    cki("pdr_count(3)", pdr_count(3), 2)
    cki("pdr_count(4)", pdr_count(4), 9)
    cki("pdr_count(5)", pdr_count(5), 44)

    // pdr_prob(4) = 9/24 = 3/8 = [3,8]
    let r1 = pdr_prob(4)
    ckr("pdr_prob(4)", r1, 3, 8)

    // pdr_prob(3) = 2/6 = 1/3 = [1,3]
    let r2 = pdr_prob(3)
    ckr("pdr_prob(3)", r2, 1, 3)

    // pdr_at_least_one_fixed(4) = 1 - 3/8 = 5/8 = [5,8]
    let r3 = pdr_at_least_one_fixed(4)
    ckr("pdr_at_least_one_fixed(4)", r3, 5, 8)

    // Edge: pdr_prob(0) = D_0/0! = 1/1 = [1,1]
    let r4 = pdr_prob(0)
    ckr("pdr_prob(0)", r4, 1, 1)

    // Edge: pdr_prob(1) = D_1/1! = 0/1 = [0,1]
    let r5 = pdr_prob(1)
    ckr("pdr_prob(1)", r5, 0, 1)

    // pdr_prob(2) = D_2/2! = 1/2 = [1,2]
    let r6 = pdr_prob(2)
    ckr("pdr_prob(2)", r6, 1, 2)

    // pdr_at_least_one_fixed(3) = 1 - 1/3 = 2/3 = [2,3]
    let r7 = pdr_at_least_one_fixed(3)
    ckr("pdr_at_least_one_fixed(3)", r7, 2, 3)

    // pdr_at_least_one_fixed(1) = 1 - 0 = 1 = [1,1]
    let r8 = pdr_at_least_one_fixed(1)
    ckr("pdr_at_least_one_fixed(1)", r8, 1, 1)

    // pdr_count(6) = 5*(44+9) = 5*53 = 265
    cki("pdr_count(6)", pdr_count(6), 265)

    print("PASS _prob_derangement_test")
