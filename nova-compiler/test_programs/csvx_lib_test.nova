import csvx

// Validation test for the csvx module's public functions.
// Each asserted result is computed by hand from csvx.nova's source.
fn main()
    // parse_csv_line: split one record into fields
    let r = csvx.parse_csv_line("a,b,c")
    assert(len(r) == 3, "parse_csv_line field count")
    assert(r[0] == "a", "parse_csv_line field 0")
    assert(r[2] == "c", "parse_csv_line field 2")

    // empty fields preserved
    let r2 = csvx.parse_csv_line("a,,c")
    assert(len(r2) == 3, "parse_csv_line empty-field count")
    assert(r2[1] == "", "parse_csv_line empty middle field")

    // quoted field containing a comma (chr(34) is a double-quote)
    let r3 = csvx.parse_csv_line("a," + chr(34) + "b,c" + chr(34) + ",d")
    assert(len(r3) == 3, "parse_csv_line quoted-comma count")
    assert(r3[1] == "b,c", "parse_csv_line comma inside quotes")

    // parse_csv: whole document; CRLF stripped, blank lines skipped
    let doc = csvx.parse_csv("name,age\r\nAlice,30\nBob,25\n")
    assert(len(doc) == 3, "parse_csv row count")
    assert(doc[0][0] == "name", "parse_csv header cell")
    assert(doc[1][0] == "Alice", "parse_csv data cell")
    assert(doc[2][1] == "25", "parse_csv last cell")

    // csv_field: quote only when needed, doubling embedded quotes
    assert(csvx.csv_field("plain") == "plain", "csv_field no quoting needed")
    assert(csvx.csv_field("a,b") == chr(34) + "a,b" + chr(34), "csv_field quotes a comma field")

    // parse_config: key=value lines; comments and blanks ignored; values trimmed
    let cfg = csvx.parse_config("# comment\nhost = localhost\nport=8080\nname =  NOVA  \n")
    assert(cfg["host"] == "localhost", "parse_config trimmed value")
    assert(cfg["port"] == "8080", "parse_config no-space value")
    assert(cfg["name"] == "NOVA", "parse_config trims surrounding spaces")

    print("csvx_lib_test passed")
