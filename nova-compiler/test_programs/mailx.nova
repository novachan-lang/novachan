// mailx — selective receive, the NOVA way (route at send, don't scan at receive).
//
// Erlang's selective receive scans a single FIFO mailbox for a pattern that matches
// — O(n) per receive, and pathological when an unmatched message piles up. NOVA
// inverts it: a "mailbox" is a set of per-kind Channels, so the kind is decided when
// the message is SENT, and a consumer receives exactly the kind it wants by reading
// that kind's channel — O(1), no scan, and type-correct because each channel carries
// one kind. (deep_copy shares channels, so the tag->channel map works across
// processes: a producer in another Process routes to the same channels.)

fn mailbox(tags)
    let mb = {}
    for t in tags
        mb[t] = channel()
    return mb

fn mb_send(mb, tag, msg)
    send(mb[tag], msg)
    return 0

fn mb_recv(mb, tag)
    return receive(mb[tag])        // selective: take this kind, leave others queued

fn main()
    // control arrives AFTER data, but a consumer can still drain all control first —
    // that is selective receive (priority by kind), without scanning a mailbox.
    let mb = mailbox(["control", "data"])
    mb_send(mb, "data", 100)
    mb_send(mb, "control", 1)
    mb_send(mb, "data", 200)
    mb_send(mb, "control", 2)
    assert_eq(mb_recv(mb, "control"), 1)
    assert_eq(mb_recv(mb, "control"), 2)
    assert_eq(mb_recv(mb, "data"), 100)
    assert_eq(mb_recv(mb, "data"), 200)

    // cross-process: a producer Process routes mixed kinds; the consumer selectively
    // takes "urgent" before "normal" regardless of send order (channels are shared).
    let mb2 = mailbox(["urgent", "normal"])
    spawn fn()
        mb_send(mb2, "normal", 50)
        mb_send(mb2, "urgent", 9)
    assert_eq(mb_recv(mb2, "urgent"), 9)
    assert_eq(mb_recv(mb2, "normal"), 50)

    print("mailx passed")
