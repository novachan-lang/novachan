// Real WASM memory.grow oracle. grow.wasm (see _wasm_grow_gen.ps1) declares 1 page,
// then: memory.grow(1) -> prev pages (1); store 42 at mem[65536] (the FIRST byte of
// the newly grown 2nd page -- out of bounds before the grow); load it back; add.
// Result = 1 + 42 = 43. This is only reachable if memory.grow genuinely extended the
// linear memory, zeroed the new page, and returned the previous page count. Before
// this iteration memory.grow pushed -1 (unsupported), so the store would have been
// out of bounds and wasm_run would have returned -1.
fn main()
    let m = wasm_compile("grow.wasm")
    assert_eq(m >= 0, true)
    let r = wasm_run(m)
    print("wasm grow result = {r}")
    assert_eq(r, 43)
    wasm_free(m)
    print("WASM memory.grow test passed: grew + stored/loaded in new page (43)")
