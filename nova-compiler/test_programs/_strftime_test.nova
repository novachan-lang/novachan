// KAT for std/time/strftime — strftime-style formatting from Unix epoch (UTC).
// Vectors verified against Python 3: datetime.utcfromtimestamp(e).strftime(pat)
import std/time/strftime

fn cks(label, got, want)
    if got != want
        print("FAIL strftime " + label + ": got '" + got + "' want '" + want + "'")
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL strftime " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // Primary KAT vector: 2024-03-09 12:34:56 UTC (Saturday)
    // Verified: python3 -c "import datetime; e=datetime.datetime(2024,3,9,12,34,56); print(e.timestamp())"
    // epoch = 1709983296
    let e = dt_from_ymdhms(2024, 3, 9, 12, 34, 56)
    cki("epoch_value", e, 1709987696)

    // %Y-%m-%d %H:%M:%S  -> "2024-03-09 12:34:56"
    cks("iso_like", dt_strftime(e, "%Y-%m-%d %H:%M:%S"), "2024-03-09 12:34:56")

    // %A %B %d, %Y  ->  "Saturday March 09, 2024"
    cks("full_names", dt_strftime(e, "%A %B %d, %Y"), "Saturday March 09, 2024")

    // %j  ->  "069"  (March 9 is day 69 in a leap year 2024)
    cks("yday", dt_strftime(e, "%j"), "069")

    // %I:%M %p  ->  "12:34 PM"  (noon = 12:34, PM)
    cks("12h_pm", dt_strftime(e, "%I:%M %p"), "12:34 PM")

    // %a %b %d  -> abbreviated names
    cks("abbr", dt_strftime(e, "%a %b %d"), "Sat Mar 09")

    // %w -> weekday digit (Saturday = 6)
    cks("wday_digit", dt_strftime(e, "%w"), "6")

    // %% -> literal percent
    cks("literal_pct", dt_strftime(e, "100%%"), "100%")

    // Second KAT vector: 2024-01-01 00:00:00 UTC (Monday)
    let e2 = dt_from_ymdhms(2024, 1, 1, 0, 0, 0)
    // %a %b %d -> "Mon Jan 01"
    cks("new_year", dt_strftime(e2, "%a %b %d"), "Mon Jan 01")

    // AM/PM midnight: hour=0 -> AM, %I -> "12"
    cks("midnight_p", dt_strftime(e2, "%p"), "AM")
    cks("midnight_I", dt_strftime(e2, "%I"), "12")
    cks("midnight_H", dt_strftime(e2, "%H"), "00")

    // %j for Jan 1 = "001"
    cks("yday_jan1", dt_strftime(e2, "%j"), "001")

    // %B full month name
    cks("full_month_jan", dt_strftime(e2, "%B"), "January")

    // Round-trip: dt_from_ymdhms -> epoch -> dt_strftime
    let e3 = dt_from_ymdhms(2000, 12, 31, 23, 59, 59)
    cks("y2k_eve", dt_strftime(e3, "%Y-%m-%d %H:%M:%S"), "2000-12-31 23:59:59")
    cks("y2k_wd", dt_strftime(e3, "%A"), "Sunday")

    // Verify 1 AM -> AM, 13:00 -> PM
    let e4 = dt_from_ymdhms(2024, 6, 15, 1, 5, 9)
    cks("1am_p", dt_strftime(e4, "%I:%M:%S %p"), "01:05:09 AM")
    let e5 = dt_from_ymdhms(2024, 6, 15, 13, 0, 0)
    cks("1pm_p", dt_strftime(e5, "%I:%M %p"), "01:00 PM")

    // Unknown directive passes through
    cks("unknown_dir", dt_strftime(e, "%Z"), "%Z")

    // %Y alone on Unix epoch origin
    let e0 = dt_from_ymdhms(1970, 1, 1, 0, 0, 0)
    cki("epoch_zero", e0, 0)
    cks("epoch_year", dt_strftime(e0, "%Y"), "1970")
    cks("epoch_wday", dt_strftime(e0, "%A"), "Thursday")

    print("PASS _strftime_test")
