import forge_scheduler

fn main()
    let s = sched_new()
    s = sched_add(s, "cleanup", 60)
    s = sched_add(s, "backup", 3600)
    s = sched_add(s, "report", 300)

    let tasks = sched_list(s)
    assert(len(tasks) == 3, "3 tasks")

    let due0 = sched_due(s, 0)
    assert(len(due0) == 0, "nothing due at t=0 (just scheduled)")

    s = sched_mark_run(s, "cleanup", 0)
    s = sched_mark_run(s, "backup", 0)
    s = sched_mark_run(s, "report", 0)

    let due30 = sched_due(s, 30)
    assert(len(due30) == 0, "nothing due at t=30")

    let due60 = sched_due(s, 60)
    assert(len(due60) == 1, "cleanup due at t=60")
    assert(due60[0] == "cleanup", "cleanup name")

    let due300 = sched_due(s, 300)
    assert(len(due300) == 2, "cleanup+report due at t=300")

    s = sched_mark_run(s, "cleanup", 60)
    let next = sched_next_run(s, "cleanup")
    assert(next == 120, "next cleanup at 120")

    s = sched_disable(s, "report")
    let due_dis = sched_due(s, 600)
    let has_report = false
    let i = 0
    while i < len(due_dis)
        if due_dis[i] == "report"
            has_report = true
        i = i + 1
    assert(not has_report, "report disabled")

    s = sched_enable(s, "report")
    let due_en = sched_due(s, 600)
    let has_report2 = false
    i = 0
    while i < len(due_en)
        if due_en[i] == "report"
            has_report2 = true
        i = i + 1
    assert(has_report2, "report re-enabled")

    s = sched_remove(s, "backup")
    let tasks2 = sched_list(s)
    assert(len(tasks2) == 2, "2 tasks after remove")

    print("SCHEDULER KAT PASS")
