// Real ML activation functions written in NOVA over the real math stdlib.
// Oracle values are the known mathematical results, independently computed.

fn softmax(xs: list) -> list
    // max-subtraction for numerical stability
    let m = xs[0]
    for x in xs
        if x > m
            m = x
    let exps = xs.map(fn(x) exp(x - m))
    let total = 0.0
    for e in exps
        total = total + e
    exps.map(fn(e) e / total)

fn sigmoid(x: float) -> float
    1.0 / (1.0 + exp(0.0 - x))

fn main()
    // softmax([1,2,3]) = [0.09003, 0.24473, 0.66524]  (known result)
    let s = softmax([1.0, 2.0, 3.0])
    assert_near(s[0], 0.09003, 0.001)
    assert_near(s[1], 0.24473, 0.001)
    assert_near(s[2], 0.66524, 0.001)
    // softmax must sum to 1
    assert_near(s[0] + s[1] + s[2], 1.0, 0.001)

    // sigmoid(0)=0.5, sigmoid(2)=0.88080  (known result)
    assert_near(sigmoid(0.0), 0.5, 0.001)
    assert_near(sigmoid(2.0), 0.88080, 0.001)

    print("ML ops (softmax + sigmoid) oracle test passed")
