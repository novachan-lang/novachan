import getin

fn main()
    // build d = { "name":"NOVA", "meta":{"x":42}, "arr":[10,20,30] }
    let d = {}
    d["name"] = "NOVA"
    let inner = {}
    inner["x"] = 42
    d["meta"] = inner
    let arr = [10, 20, 30]
    d["arr"] = arr

    // get_in: top key, nested key, dict->list->index
    assert(getin.get_in(d, ["name"], "") == "NOVA", "top-level string key")
    assert(getin.get_in(d, ["meta", "x"], 0) == 42, "nested dict key")
    assert(getin.get_in(d, ["arr", 1], 0) == 20, "dict -> list -> index")
    // get_in: misses return the default
    assert(getin.get_in(d, ["missing"], "none") == "none", "missing key -> default")
    assert(getin.get_in(d, ["arr", 9], -1) == -1, "out-of-range index -> default")
    // has_in: full path resolves vs not
    assert(getin.has_in(d, ["meta", "x"]) == 1, "full path resolves")
    assert(getin.has_in(d, ["meta", "z"]) == 0, "missing leaf -> 0")

    print("getin_lib_test passed")
