import forge_api_mock

fn main()
    let m = mock_new()
    m = mock_add(m, "GET", "/api/users", 200, "[{\"id\":1}]")
    m = mock_add(m, "POST", "/api/users", 201, "{\"created\":true}")
    m = mock_add(m, "GET", "/health", 200, "ok")
    assert(mock_endpoint_count(m) == 3, "3 endpoints")

    let r1 = mock_handle(m, "GET", "/api/users")
    assert(r1["status"] == 200, "200 for GET users")
    assert(r1["matched"] == 1, "matched")

    let r2 = mock_handle(m, "POST", "/api/users")
    assert(r2["status"] == 201, "201 for POST users")

    let r3 = mock_handle(m, "GET", "/not-found")
    assert(r3["status"] == 404, "404 for unknown")
    assert(r3["matched"] == 0, "not matched")

    assert(mock_call_count(m, "GET", "/api/users") == 1, "GET users called 1x")
    assert(mock_verify_called(m, "GET", "/api/users") == 1, "verified called")
    assert(mock_verify_called(m, "DELETE", "/api/users") == 0, "delete not called")
    assert(mock_total_calls(m) == 3, "3 total calls")

    let r4 = mock_handle(m, "GET", "/api/users")
    assert(r4["matched"] == 1, "r4 matched")
    assert(mock_call_count(m, "GET", "/api/users") == 2, "GET users called 2x")

    m = mock_reset_counts(m)
    assert(mock_call_count(m, "GET", "/api/users") == 0, "reset to 0")
    assert(mock_total_calls(m) == 0, "total reset")

    print("API-MOCK KAT PASS")
