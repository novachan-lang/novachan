import forge_runlength

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // text-form encode/decode
    fails = fails + expect("enc_basic", rle_encode("aaabbc"), "3a2b1c")
    fails = fails + expect("enc_multidigit", rle_encode("wwwwwwwwwwww"), "12w")
    fails = fails + expect("enc_single", rle_encode("abc"), "1a1b1c")
    fails = fails + expect("enc_one", rle_encode("x"), "1x")
    fails = fails + expect("enc_empty", rle_encode(""), "")
    fails = fails + expect("dec_basic", rle_decode("3a2b1c"), "aaabbc")
    fails = fails + expect("dec_multidigit", rle_decode("12w"), "wwwwwwwwwwww")
    fails = fails + expect("dec_empty", rle_decode(""), "")

    // round trip (text form, non-digit alphabet)
    let rt = "aaaaabbbcccccccccccd"
    fails = fails + expect("roundtrip", rle_decode(rle_encode(rt)), rt)

    // pairs form (digit-safe, fully general)
    fails = fails + expect("pairs_rt_digits", rle_from_pairs(rle_pairs("11122")), "11122")
    fails = fails + expect("pairs_rt_text", rle_from_pairs(rle_pairs("aaab")), "aaab")
    fails = fails + expect("pairs_rt_mixed", rle_from_pairs(rle_pairs("a1a1bb99")), "a1a1bb99")
    fails = fails + expect("pairs_empty", rle_from_pairs(rle_pairs("")), "")

    // pair structure
    let p = rle_pairs("aaab")
    fails = fails + expect("pairs_len", str(len(p)), "2")
    fails = fails + expect("pairs_0char", str(p[0][0]), "a")
    fails = fails + expect("pairs_0count", str(p[0][1]), "3")
    fails = fails + expect("pairs_1char", str(p[1][0]), "b")
    fails = fails + expect("pairs_1count", str(p[1][1]), "1")

    // run count
    fails = fails + expect("runs_basic", str(run_count("aaabbc")), "3")
    fails = fails + expect("runs_alt", str(run_count("ababab")), "6")
    fails = fails + expect("runs_one", str(run_count("aaaaa")), "1")
    fails = fails + expect("runs_empty", str(run_count("")), "0")

    if fails == 0
        print("forge_runlength: all passed")
    else
        print("forge_runlength: " + str(fails) + " FAILED")
