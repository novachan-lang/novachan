import forge_schema_registry

fn main()
    let sr = sr_new()
    sr = sr_register(sr, "user-events", 1, "id:int,name:string")
    sr = sr_register(sr, "user-events", 2, "id:int,name:string,email:string")
    sr = sr_register(sr, "order-events", 1, "order_id:int,total:int")
    assert(sr_subject_count(sr) == 2, "2 subjects")
    assert(sr_version_count(sr, "user-events") == 2, "2 versions")

    let latest = sr_get_latest(sr, "user-events")
    assert(latest["version"] == 2, "latest is v2")
    assert(latest["schema"] == "id:int,name:string,email:string", "v2 schema")

    let v1 = sr_get_version(sr, "user-events", 1)
    assert(v1 == "id:int,name:string", "v1 schema")

    let missing = sr_get_version(sr, "user-events", 99)
    assert(missing == "", "missing version = empty")

    let no_subject = sr_get_latest(sr, "nonexistent")
    assert(no_subject["version"] == 0, "no subject = 0")

    sr = sr_deprecate(sr, "user-events", 1)
    let subs = sr_subjects(sr)
    assert(len(subs) == 2, "2 subjects listed")

    assert(sr_version_count(sr, "nonexistent") == 0, "no versions")

    print("SCHEMA-REGISTRY KAT PASS")
