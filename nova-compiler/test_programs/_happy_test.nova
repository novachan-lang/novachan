import std/math/happy

// KAT 1: hap_is(1) == true  (1 is trivially happy)
let r1 = hap_is(1)
if r1 == false
    print("FAIL KAT1: hap_is(1) expected true got false")
    exit(1)

// KAT 2: hap_is(7) == true  (7→49→97→130→10→1)
let r2 = hap_is(7)
if r2 == false
    print("FAIL KAT2: hap_is(7) expected true got false")
    exit(1)

// KAT 3: hap_is(4) == false  (4 enters the 4→16→37→58→89→145→42→20→4 cycle)
let r3 = hap_is(4)
if r3 == true
    print("FAIL KAT3: hap_is(4) expected false got true")
    exit(1)

// KAT 4: hap_is(19) == true  (19→82→68→100→1)
let r4 = hap_is(19)
if r4 == false
    print("FAIL KAT4: hap_is(19) expected true got false")
    exit(1)

// KAT 5: hap_is(2) == false  (2 unhappy)
let r5 = hap_is(2)
if r5 == true
    print("FAIL KAT5: hap_is(2) expected false got true")
    exit(1)

// KAT 6: hap_is(10) == true  (10→1+0=1)
let r6 = hap_is(10)
if r6 == false
    print("FAIL KAT6: hap_is(10) expected true got false")
    exit(1)

// KAT 7: hap_next(19) == 82  (1^2 + 9^2 = 1 + 81 = 82)
let r7 = hap_next(19)
if r7 != 82
    print("FAIL KAT7: hap_next(19) expected 82 got " + str(r7))
    exit(1)

// KAT 8: hap_upto(10) == [1, 7, 10]
let r8 = hap_upto(10)
if len(r8) != 3
    print("FAIL KAT8a: hap_upto(10) length expected 3 got " + str(len(r8)))
    exit(1)
if r8[0] != 1
    print("FAIL KAT8b: hap_upto(10)[0] expected 1 got " + str(r8[0]))
    exit(1)
if r8[1] != 7
    print("FAIL KAT8c: hap_upto(10)[1] expected 7 got " + str(r8[1]))
    exit(1)
if r8[2] != 10
    print("FAIL KAT8d: hap_upto(10)[2] expected 10 got " + str(r8[2]))
    exit(1)

// KAT 9: hap_next(1) == 1
let r9 = hap_next(1)
if r9 != 1
    print("FAIL KAT9: hap_next(1) expected 1 got " + str(r9))
    exit(1)

// KAT 10: hap_sequence(19) starts with 19 and ends with 1
let r10 = hap_sequence(19)
if len(r10) < 2
    print("FAIL KAT10a: hap_sequence(19) too short: " + str(len(r10)))
    exit(1)
if r10[0] != 19
    print("FAIL KAT10b: hap_sequence(19)[0] expected 19 got " + str(r10[0]))
    exit(1)
let r10last = r10[len(r10) - 1]
if r10last != 1
    print("FAIL KAT10c: hap_sequence(19) last expected 1 got " + str(r10last))
    exit(1)

// KAT 11: hap_sequence(1) == [1]
let r11 = hap_sequence(1)
if len(r11) != 1
    print("FAIL KAT11a: hap_sequence(1) length expected 1 got " + str(len(r11)))
    exit(1)
if r11[0] != 1
    print("FAIL KAT11b: hap_sequence(1)[0] expected 1 got " + str(r11[0]))
    exit(1)

// KAT 12: hap_upto(1) == [1]
let r12 = hap_upto(1)
if len(r12) != 1
    print("FAIL KAT12a: hap_upto(1) length expected 1 got " + str(len(r12)))
    exit(1)
if r12[0] != 1
    print("FAIL KAT12b: hap_upto(1)[0] expected 1 got " + str(r12[0]))
    exit(1)

print("_happy_test passed")
