// Does `defer` actually run when a task PANICS?
// After the crash-safe defer shadow stack: YES.  The compiler registers each defer site
// with the runtime, and the fiber trampoline drains the stack (fault-isolated) on panic.
// Both `defer` and `on_exit_send` must survive a panic without leaking the resource.

fn census(ch) -> int
    let taken = []
    let going = 1
    while going == 1
        let r = select_timeout(ch, 250)
        if r[0] == 0
            push(taken, r[1])
        else
            going = 0
    for t in taken
        send(ch, t)
    len(taken)

// A: defer-released resource, task panics mid-body
fn body_defer(pool)
    let c = recv(pool)
    defer send(pool, c)
    print("    [A] about to fault...")
    let boom = unwrap(err("forced panic A"))    // unwrap of an Err -> real panic
    print("    [A] NOT REACHED {boom}")

// B: on_exit_send-registered resource, same panic
fn body_registry(pool)
    let c = recv(pool)
    on_exit_send(pool, c)
    print("    [B] about to fault...")
    let boom = unwrap(err("forced panic B"))
    print("    [B] NOT REACHED {boom}")

fn main()
    let fails = 0

    let p1 = channel()
    send(p1, 101)
    print("A: defer + panic   (pool starts with 1)")
    spawn body_defer(p1)
    sleep(600)
    let c1 = census(p1)
    print("  pool after panic = {c1}   <- 1 means defer RAN on the crash path")
    if c1 != 1
        print("FAIL: defer did NOT return the resource after a panic (got {c1}, expected 1)")
        fails += 1
    else
        print("  PASS: crash-safe defer returned the resource")

    let p2 = channel()
    send(p2, 202)
    print("B: on_exit_send + panic   (pool starts with 1)")
    spawn body_registry(p2)
    sleep(600)
    let c2 = census(p2)
    print("  pool after panic = {c2}   <- 1 means the registry drained it")
    if c2 != 1
        print("FAIL: the crash-safe registry did NOT return the resource after a panic (got {c2})")
        fails += 1
    else
        print("  PASS: on_exit_send returned the resource")

    if fails == 0
        print("_kat_defer_panic passed (BOTH defer and on_exit_send survive panic)")
    else
        print("_kat_defer_panic FAILED ({fails})")
        exit(1)
