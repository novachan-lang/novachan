// Does `defer` actually run when a task PANICS? And does on_exit_send?
// Premise under test: defer inlines at function exit points, so a panic longjmps past it and the
// resource leaks; on_exit_send is drained by the trampoline on the fault path and does not leak.

fn census(ch) -> int
    let taken = []
    let going = 1
    while going == 1
        let r = select_timeout(ch, 250)
        if r[0] == 0
            push(taken, r[1])
        else
            going = 0
    for t in taken
        send(ch, t)
    len(taken)

// A: defer-released resource, task panics mid-body
fn body_defer(pool)
    let c = recv(pool)
    defer send(pool, c)
    print("    [A] about to fault...")
    let boom = unwrap(err("forced panic A"))    // unwrap of an Err -> real panic
    print("    [A] NOT REACHED {boom}")

// B: on_exit_send-registered resource, same panic
fn body_registry(pool)
    let c = recv(pool)
    on_exit_send(pool, c)
    print("    [B] about to fault...")
    let boom = unwrap(err("forced panic B"))
    print("    [B] NOT REACHED {boom}")

fn main()
    let p1 = channel()
    send(p1, 101)
    print("A: defer + panic   (pool starts with 1)")
    spawn body_defer(p1)
    sleep(600)
    print("  pool after panic = {census(p1)}   <- 1 means defer RAN, 0 means it LEAKED")

    let p2 = channel()
    send(p2, 202)
    print("B: on_exit_send + panic   (pool starts with 1)")
    spawn body_registry(p2)
    sleep(600)
    print("  pool after panic = {census(p2)}   <- 1 means the registry drained it")
    let fails = 0
    if census(p1) != 0
        print("  NOTE: defer now survives panic -- if intentional, this KAT should be revisited")
    if census(p2) != 1
        print("FAIL: the crash-safe registry did NOT return the resource after a panic")
        fails += 1
    if fails == 0
        print("_kat_defer_panic passed (registry survives panic; defer does not)")
    else
        print("_kat_defer_panic FAILED")
        exit(1)
