fn _ap_after_eq(s) -> string
    let i = 0
    while i < len(s)
        if slice(s, i, i+1) == "="
            return slice(s, i+1, len(s))
        i = i + 1
    return ""

fn get_next(xs, target) -> string
    let i = 0
    while i < len(xs)
        if xs[i] == target
            if i + 1 < len(xs)
                let v = xs[i+1]
                return v
            return ""
        i = i + 1
    return ""

fn main()
    let r1 = _ap_after_eq("--port=9090")
    print("after_eq='" + r1 + "' len=" + str(len(r1)))
    let r2 = get_next(["--port", "9"], "--port")
    print("get_next='" + r2 + "' len=" + str(len(r2)))
