import prism_ui_progress
import prism_node

fn _check(label: string, cond: bool) -> bool
    if cond
        print("PASS " + label)
        return true
    print("FAIL " + label)
    false

fn main()
    let mut total = 0
    let mut passed = 0

    // --- prism_pg_bar: basic proportions ---
    let r1 = prism_ui_progress.prism_pg_bar(5, 10, 10)
    total = total + 1
    if _check("prism_pg_bar(5,10,10) is_ok", is_ok(r1))
        passed = passed + 1
    let n1 = unwrap(r1)
    let c1 = prism_node.prism_node_children(n1)
    total = total + 1
    if _check("prism_pg_bar(5,10,10) children len==2", len(c1) == 2)
        passed = passed + 1
    total = total + 1
    if _check("prism_pg_bar(5,10,10) filled='====='", prism_node.prism_node_attr_str(c1[0], "text", "") == "=====")
        passed = passed + 1
    total = total + 1
    if _check("prism_pg_bar(5,10,10) empty='-----'", prism_node.prism_node_attr_str(c1[1], "text", "") == "-----")
        passed = passed + 1

    // --- prism_pg_bar: zero progress ---
    let r2 = prism_ui_progress.prism_pg_bar(0, 10, 10)
    let n2 = unwrap(r2)
    let c2 = prism_node.prism_node_children(n2)
    total = total + 1
    if _check("prism_pg_bar(0,10,10) filled=''", prism_node.prism_node_attr_str(c2[0], "text", "MISSING") == "")
        passed = passed + 1
    total = total + 1
    if _check("prism_pg_bar(0,10,10) empty='----------'", prism_node.prism_node_attr_str(c2[1], "text", "") == "----------")
        passed = passed + 1

    // --- prism_pg_bar: full progress ---
    let r3 = prism_ui_progress.prism_pg_bar(10, 10, 10)
    let n3 = unwrap(r3)
    let c3 = prism_node.prism_node_children(n3)
    total = total + 1
    if _check("prism_pg_bar(10,10,10) filled='=========='", prism_node.prism_node_attr_str(c3[0], "text", "") == "==========")
        passed = passed + 1
    total = total + 1
    if _check("prism_pg_bar(10,10,10) empty=''", prism_node.prism_node_attr_str(c3[1], "text", "MISSING") == "")
        passed = passed + 1

    // --- prism_pg_bar: current > total clamps ---
    let r4 = prism_ui_progress.prism_pg_bar(15, 10, 10)
    total = total + 1
    if _check("prism_pg_bar(15,10,10) is_ok (clamped)", is_ok(r4))
        passed = passed + 1
    let n4 = unwrap(r4)
    let c4 = prism_node.prism_node_children(n4)
    total = total + 1
    if _check("prism_pg_bar(15,10,10) filled clamps to full", prism_node.prism_node_attr_str(c4[0], "text", "") == "==========")
        passed = passed + 1

    // --- prism_pg_bar: non-trivial width/total ratio ---
    let r5 = prism_ui_progress.prism_pg_bar(3, 7, 14)
    let n5 = unwrap(r5)
    let c5 = prism_node.prism_node_children(n5)
    total = total + 1
    if _check("prism_pg_bar(3,7,14) filled='======' (6)", prism_node.prism_node_attr_str(c5[0], "text", "") == "======")
        passed = passed + 1
    total = total + 1
    if _check("prism_pg_bar(3,7,14) empty='--------' (8)", prism_node.prism_node_attr_str(c5[1], "text", "") == "--------")
        passed = passed + 1

    // --- prism_pg_bar: error paths ---
    let e1 = prism_ui_progress.prism_pg_bar(5, 0, 10)
    total = total + 1
    if _check("prism_pg_bar total=0 is_err", is_err(e1))
        passed = passed + 1
    total = total + 1
    if _check("prism_pg_bar total=0 message", unwrap_err(e1) == "prism_pg_bar: total must be > 0")
        passed = passed + 1

    let e2 = prism_ui_progress.prism_pg_bar(5, -3, 10)
    total = total + 1
    if _check("prism_pg_bar total=-3 is_err", is_err(e2))
        passed = passed + 1

    let e3 = prism_ui_progress.prism_pg_bar(-1, 10, 10)
    total = total + 1
    if _check("prism_pg_bar current=-1 is_err", is_err(e3))
        passed = passed + 1
    total = total + 1
    if _check("prism_pg_bar current=-1 message", unwrap_err(e3) == "prism_pg_bar: current must be >= 0")
        passed = passed + 1

    let e4 = prism_ui_progress.prism_pg_bar(5, 10, 0)
    total = total + 1
    if _check("prism_pg_bar width=0 is_err", is_err(e4))
        passed = passed + 1
    total = total + 1
    if _check("prism_pg_bar width=0 message", unwrap_err(e4) == "prism_pg_bar: width must be > 0")
        passed = passed + 1

    let e5 = prism_ui_progress.prism_pg_bar(5, 10, -2)
    total = total + 1
    if _check("prism_pg_bar width=-2 is_err", is_err(e5))
        passed = passed + 1

    // --- prism_pg_percent ---
    let p1 = prism_ui_progress.prism_pg_percent(42, 100)
    total = total + 1
    if _check("prism_pg_percent(42,100) is_ok", is_ok(p1))
        passed = passed + 1
    let pn1 = unwrap(p1)
    total = total + 1
    if _check("prism_pg_percent(42,100) text='42%'", prism_node.prism_node_attr_str(pn1, "text", "") == "42%")
        passed = passed + 1

    let p2 = prism_ui_progress.prism_pg_percent(0, 100)
    let pn2 = unwrap(p2)
    total = total + 1
    if _check("prism_pg_percent(0,100) text='0%'", prism_node.prism_node_attr_str(pn2, "text", "") == "0%")
        passed = passed + 1

    let p3 = prism_ui_progress.prism_pg_percent(100, 100)
    let pn3 = unwrap(p3)
    total = total + 1
    if _check("prism_pg_percent(100,100) text='100%'", prism_node.prism_node_attr_str(pn3, "text", "") == "100%")
        passed = passed + 1

    let p4 = prism_ui_progress.prism_pg_percent(150, 100)
    total = total + 1
    if _check("prism_pg_percent(150,100) is_ok (clamped)", is_ok(p4))
        passed = passed + 1
    let pn4 = unwrap(p4)
    total = total + 1
    if _check("prism_pg_percent(150,100) text='100%' (clamped)", prism_node.prism_node_attr_str(pn4, "text", "") == "100%")
        passed = passed + 1

    let p5 = prism_ui_progress.prism_pg_percent(1, 3)
    let pn5 = unwrap(p5)
    total = total + 1
    if _check("prism_pg_percent(1,3) text='33%'", prism_node.prism_node_attr_str(pn5, "text", "") == "33%")
        passed = passed + 1

    let pe1 = prism_ui_progress.prism_pg_percent(5, 0)
    total = total + 1
    if _check("prism_pg_percent total=0 is_err", is_err(pe1))
        passed = passed + 1
    total = total + 1
    if _check("prism_pg_percent total=0 message", unwrap_err(pe1) == "prism_pg_percent: total must be > 0")
        passed = passed + 1

    let pe2 = prism_ui_progress.prism_pg_percent(-1, 100)
    total = total + 1
    if _check("prism_pg_percent current=-1 is_err", is_err(pe2))
        passed = passed + 1
    total = total + 1
    if _check("prism_pg_percent current=-1 message", unwrap_err(pe2) == "prism_pg_percent: current must be >= 0")
        passed = passed + 1

    // --- prism_pg_labeled ---
    let l1 = prism_ui_progress.prism_pg_labeled("Upload", 5, 10, 10)
    total = total + 1
    if _check("prism_pg_labeled ok", is_ok(l1))
        passed = passed + 1
    let ln1 = unwrap(l1)
    let lc1 = prism_node.prism_node_children(ln1)
    total = total + 1
    if _check("prism_pg_labeled children len==3", len(lc1) == 3)
        passed = passed + 1
    total = total + 1
    if _check("prism_pg_labeled label text='Upload'", prism_node.prism_node_attr_str(lc1[0], "text", "") == "Upload")
        passed = passed + 1
    let lbar_children = prism_node.prism_node_children(lc1[1])
    total = total + 1
    if _check("prism_pg_labeled bar filled='====='", prism_node.prism_node_attr_str(lbar_children[0], "text", "") == "=====")
        passed = passed + 1
    total = total + 1
    if _check("prism_pg_labeled percent text='50%'", prism_node.prism_node_attr_str(lc1[2], "text", "") == "50%")
        passed = passed + 1

    let le1 = prism_ui_progress.prism_pg_labeled("", 5, 10, 10)
    total = total + 1
    if _check("prism_pg_labeled empty label is_err", is_err(le1))
        passed = passed + 1
    total = total + 1
    if _check("prism_pg_labeled empty label message", unwrap_err(le1) == "prism_pg_labeled: label must not be empty")
        passed = passed + 1

    let le2 = prism_ui_progress.prism_pg_labeled("X", 5, 0, 10)
    total = total + 1
    if _check("prism_pg_labeled propagates bar error is_err", is_err(le2))
        passed = passed + 1
    total = total + 1
    if _check("prism_pg_labeled propagated message", contains(unwrap_err(le2), "prism_pg_bar: total must be > 0"))
        passed = passed + 1

    // --- prism_pg_steps ---
    let steps = ["Cart", "Shipping", "Payment", "Confirm"]

    let s1 = prism_ui_progress.prism_pg_steps(steps, 0)
    total = total + 1
    if _check("prism_pg_steps(0) is_ok", is_ok(s1))
        passed = passed + 1
    let sn1 = unwrap(s1)
    let sc1 = prism_node.prism_node_children(sn1)
    total = total + 1
    if _check("prism_pg_steps(0) children len==4", len(sc1) == 4)
        passed = passed + 1
    total = total + 1
    if _check("prism_pg_steps(0) current marked '> Cart'", prism_node.prism_node_attr_str(sc1[0], "text", "") == "> Cart")
        passed = passed + 1
    total = total + 1
    if _check("prism_pg_steps(0) other unmarked '  Shipping'", prism_node.prism_node_attr_str(sc1[1], "text", "") == "  Shipping")
        passed = passed + 1

    let s2 = prism_ui_progress.prism_pg_steps(steps, 2)
    let sn2 = unwrap(s2)
    let sc2 = prism_node.prism_node_children(sn2)
    total = total + 1
    if _check("prism_pg_steps(2) current marked '> Payment'", prism_node.prism_node_attr_str(sc2[2], "text", "") == "> Payment")
        passed = passed + 1
    total = total + 1
    if _check("prism_pg_steps(2) first unmarked '  Cart'", prism_node.prism_node_attr_str(sc2[0], "text", "") == "  Cart")
        passed = passed + 1

    let s3 = prism_ui_progress.prism_pg_steps(steps, 3)
    let sn3 = unwrap(s3)
    let sc3 = prism_node.prism_node_children(sn3)
    total = total + 1
    if _check("prism_pg_steps(3) last marked '> Confirm'", prism_node.prism_node_attr_str(sc3[3], "text", "") == "> Confirm")
        passed = passed + 1

    let se1 = prism_ui_progress.prism_pg_steps([], 0)
    total = total + 1
    if _check("prism_pg_steps empty steps is_err", is_err(se1))
        passed = passed + 1
    total = total + 1
    if _check("prism_pg_steps empty steps message", unwrap_err(se1) == "prism_pg_steps: steps must not be empty")
        passed = passed + 1

    let se2 = prism_ui_progress.prism_pg_steps(steps, -1)
    total = total + 1
    if _check("prism_pg_steps current_step=-1 is_err", is_err(se2))
        passed = passed + 1

    let se3 = prism_ui_progress.prism_pg_steps(steps, 4)
    total = total + 1
    if _check("prism_pg_steps current_step=4 (==len) is_err", is_err(se3))
        passed = passed + 1
    total = total + 1
    if _check("prism_pg_steps current_step=4 message", unwrap_err(se3) == "prism_pg_steps: current_step 4 out of bounds (0..3)")
        passed = passed + 1

    let bad_steps = [1, 2, 3]
    let se4 = prism_ui_progress.prism_pg_steps(bad_steps, 0)
    total = total + 1
    if _check("prism_pg_steps non-string step is_err", is_err(se4))
        passed = passed + 1
    total = total + 1
    if _check("prism_pg_steps non-string step message", unwrap_err(se4) == "prism_pg_steps: step 0 is not a string (got int)")
        passed = passed + 1

    print("== " + str(passed) + "/" + str(total) + " assertions passed ==")
    if passed != total
        print("FAIL: KAT summary -- not all assertions passed")
