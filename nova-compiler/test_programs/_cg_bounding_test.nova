import std/geometry/cg_bounding

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + ": length mismatch got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL " + label + ": index " + str(i) + " got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // KAT 1: bbox of [[0,0],[3,4],[1,1]] = [0,0,3,4]
    let pts1 = [[0, 0], [3, 4], [1, 1]]
    let bb1 = cgb_bbox(pts1)
    ckl("bbox(pts1)", bb1, [0, 0, 3, 4])

    // KAT 2: bbox_area of pts1 = 3*4 = 12
    cki("bbox_area(pts1)", cgb_bbox_area(pts1), 12)

    // KAT 3: width of [[0,0],[3,4]] = 3
    let pts3 = [[0, 0], [3, 4]]
    cki("width(pts3)", cgb_width(pts3), 3)

    // KAT 4: height of [[0,0],[3,4]] = 4
    cki("height(pts3)", cgb_height(pts3), 4)

    // KAT 5: center_2x of [[0,0],[4,4]] = [4,4]
    let pts5 = [[0, 0], [4, 4]]
    let c5 = cgb_center_2x(pts5)
    ckl("center_2x(pts5)", c5, [4, 4])

    // KAT 6: single point bbox = [5,5,5,5]
    let pt6 = [[5, 5]]
    let bb6 = cgb_bbox(pt6)
    ckl("bbox(single)", bb6, [5, 5, 5, 5])

    // KAT 7: single point area = 0
    cki("bbox_area(single)", cgb_bbox_area(pt6), 0)

    // KAT 8: negative coordinates
    let pts8 = [[-3, -2], [1, 4]]
    let bb8 = cgb_bbox(pts8)
    ckl("bbox(neg)", bb8, [-3, -2, 1, 4])

    // KAT 9: width of pts8 = 1-(-3) = 4
    cki("width(neg)", cgb_width(pts8), 4)

    // KAT 10: center_2x of pts8: xmin=-3,xmax=1 -> 2cx=-2; ymin=-2,ymax=4 -> 2cy=2
    let c8 = cgb_center_2x(pts8)
    ckl("center_2x(neg)", c8, [-2, 2])

    // KAT 11: multiple points, unsorted
    let pts11 = [[5, 1], [2, 9], [8, 3], [1, 7]]
    let bb11 = cgb_bbox(pts11)
    ckl("bbox(multi)", bb11, [1, 1, 8, 9])
    cki("bbox_area(multi)", cgb_bbox_area(pts11), 56)

    // KAT 12: center_2x([[0,0],[3,4],[1,1]]) — bbox [0,0,3,4], center_2x=[3,4]
    let c12 = cgb_center_2x(pts1)
    ckl("center_2x(pts1)", c12, [3, 4])

    print("PASS _cg_bounding_test")
