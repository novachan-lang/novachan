import std/httphdr/http_cache_control

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got=[" + got + "] want=[" + want + "]")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn ckl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)

fn main()
    // KAT — specified vectors
    cki("kat-max-age-1", hcc_max_age("max-age=3600, public"), 3600)
    ckb("kat-has-no-cache", hcc_has("no-cache", "no-cache"), true)
    cki("kat-max-age-absent", hcc_max_age("no-cache"), -1)
    ckb("kat-is-cacheable-pub", hcc_is_cacheable("public, max-age=60"), true)
    ckb("kat-is-cacheable-ns", hcc_is_cacheable("no-store"), false)
    ckb("kat-has-case", hcc_has("Max-Age=5", "max-age"), true)

    // hcc_parse structural tests
    let p1 = hcc_parse("max-age=3600, public")
    ckl("parse-len", p1, [["max-age","3600"],["public",""]])
    let first = p1[0]
    cks("parse-first-dir", first[0], "max-age")
    cks("parse-first-val", first[1], "3600")
    let second = p1[1]
    cks("parse-second-dir", second[0], "public")
    cks("parse-second-val", second[1], "")

    // Quoted value unquoting
    let p2 = hcc_parse("no-cache=\"Set-Cookie\"")
    let pf = p2[0]
    cks("parse-quoted-dir", pf[0], "no-cache")
    cks("parse-quoted-val", pf[1], "Set-Cookie")

    // Empty input
    let p3 = hcc_parse("")
    ckl("parse-empty", p3, [])

    // hcc_has — absent directive
    ckb("has-absent", hcc_has("public, max-age=60", "no-store"), false)

    // hcc_is_cacheable — no-cache
    ckb("is-cacheable-nc", hcc_is_cacheable("no-cache, max-age=0"), false)

    // hcc_is_cacheable — private
    ckb("is-cacheable-priv", hcc_is_cacheable("private, max-age=600"), false)

    // hcc_max_age — zero value
    cki("max-age-zero", hcc_max_age("max-age=0"), 0)

    // Directive name case-insensitive in parse
    let p4 = hcc_parse("No-Cache, Max-Age=120")
    let pd1 = p4[0]
    cks("parse-ci-dir1", pd1[0], "no-cache")
    let pd2 = p4[1]
    cks("parse-ci-dir2", pd2[0], "max-age")

    print("PASS _http_cache_control_test")
