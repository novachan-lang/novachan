// KAT for std/time/isoweek — ISO 8601 week-date arithmetic.
import std/time/isoweek

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL isoweek " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ck_list2(label: string, got: list, want0: int, want1: int)
    if got[0] != want0 or got[1] != want1
        print("FAIL isoweek " + label + ": got [" + str(got[0]) + "," + str(got[1]) + "] want [" + str(want0) + "," + str(want1) + "]")
        exit(1)

fn ck_list3(label: string, got: list, want0: int, want1: int, want2: int)
    if got[0] != want0 or got[1] != want1 or got[2] != want2
        print("FAIL isoweek " + label + ": got [" + str(got[0]) + "," + str(got[1]) + "," + str(got[2]) + "] want [" + str(want0) + "," + str(want1) + "," + str(want2) + "]")
        exit(1)

fn main()
    // --- KAT vector 1: 2026-01-01 is Thursday → ISO [2026, 1] ---
    ck_list2("week_of 2026-01-01", iso_week_of(2026, 1, 1), 2026, 1)
    cki("week_year 2026-01-01", iso_week_year(2026, 1, 1), 2026)
    cki("week_num 2026-01-01", iso_week_num(2026, 1, 1), 1)

    // --- KAT vector 2: 2021-01-01 is Friday → belongs to 2020-W53 ---
    ck_list2("week_of 2021-01-01", iso_week_of(2021, 1, 1), 2020, 53)
    cki("week_year 2021-01-01", iso_week_year(2021, 1, 1), 2020)
    cki("week_num 2021-01-01", iso_week_num(2021, 1, 1), 53)

    // --- KAT vector 3: iso_weeks_in_year ---
    cki("weeks_in_year 2020", iso_weeks_in_year(2020), 53)
    cki("weeks_in_year 2021", iso_weeks_in_year(2021), 52)
    // 2015 had 53 weeks (Jan 1 2015 is Thursday)
    cki("weeks_in_year 2015", iso_weeks_in_year(2015), 53)
    // 2022 has 52 weeks (Jan 1 2022 is Saturday)
    cki("weeks_in_year 2022", iso_weeks_in_year(2022), 52)

    // --- KAT vector 4: iso_dow ---
    // 2024-03-09 is Saturday → iso_dow = 6
    cki("iso_dow 2024-03-09 Sat", iso_dow(2024, 3, 9), 6)
    // 2026-01-01 is Thursday → iso_dow = 4
    cki("iso_dow 2026-01-01 Thu", iso_dow(2026, 1, 1), 4)
    // 2021-01-04 is Monday → iso_dow = 1
    cki("iso_dow 2021-01-04 Mon", iso_dow(2021, 1, 4), 1)
    // 2021-01-10 is Sunday → iso_dow = 7
    cki("iso_dow 2021-01-10 Sun", iso_dow(2021, 1, 10), 7)

    // --- KAT vector 5: round-trip iso_week_to_date(2026,1,4) == [2026,1,1] ---
    // ISO W01 2026, Thursday (iso_dow=4) = 2026-01-01
    ck_list3("to_date 2026-W01-4", iso_week_to_date(2026, 1, 4), 2026, 1, 1)

    // --- Additional round-trips ---
    // 2020-W53-5 (Friday) = 2021-01-01
    ck_list3("to_date 2020-W53-5", iso_week_to_date(2020, 53, 5), 2021, 1, 1)
    // 2020-W53-1 (Monday) = 2020-12-28
    ck_list3("to_date 2020-W53-1", iso_week_to_date(2020, 53, 1), 2020, 12, 28)
    // 2015-W53-4 (Thursday) = 2015-12-31
    ck_list3("to_date 2015-W53-4", iso_week_to_date(2015, 53, 4), 2015, 12, 31)

    // --- Boundary: last week of 2019 (2020-W01 starts 2019-12-30 Mon) ---
    // 2019-12-30 → 2020-W01
    ck_list2("week_of 2019-12-30", iso_week_of(2019, 12, 30), 2020, 1)
    // 2019-12-29 → 2019-W52
    ck_list2("week_of 2019-12-29", iso_week_of(2019, 12, 29), 2019, 52)

    // --- Epoch anchor: 1970-01-01 is Thursday → 1970-W01 ---
    ck_list2("week_of 1970-01-01", iso_week_of(1970, 1, 1), 1970, 1)
    cki("iso_dow 1970-01-01 Thu", iso_dow(1970, 1, 1), 4)

    print("PASS _isoweek_test")
