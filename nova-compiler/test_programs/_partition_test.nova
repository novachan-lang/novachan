import std/math/partition

// Helper: check int equal
fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// Helper: no-op float check placeholder (not needed here but kept for consistency)

// KAT 1: pa_count(0) == 1
let r0 = pa_count(0)
cki("pa_count(0)", r0, 1)

// KAT 2: pa_count(1) == 1
let r1 = pa_count(1)
cki("pa_count(1)", r1, 1)

// KAT 3: pa_count(4) == 5
let r4 = pa_count(4)
cki("pa_count(4)", r4, 5)

// KAT 4: pa_count(5) == 7
let r5 = pa_count(5)
cki("pa_count(5)", r5, 7)

// KAT 5: pa_count(7) == 15
let r7 = pa_count(7)
cki("pa_count(7)", r7, 15)

// KAT 6: pa_count(10) == 42
let r10 = pa_count(10)
cki("pa_count(10)", r10, 42)

// KAT 7: pa_count_k(5,2) == 2  ({4,1} and {3,2})
let rk52 = pa_count_k(5, 2)
cki("pa_count_k(5,2)", rk52, 2)

// KAT 8: pa_count_max(5,3) == 5
let rm53 = pa_count_max(5, 3)
cki("pa_count_max(5,3)", rm53, 5)

// KAT 9: len(pa_list(4)) == 5
let lst4 = pa_list(4)
let llen = len(lst4)
cki("len(pa_list(4))", llen, 5)

// KAT 10: pa_list(0) has length 1 (the empty partition)
let lst0 = pa_list(0)
let llen0 = len(lst0)
cki("len(pa_list(0))", llen0, 1)

// KAT 11: pa_count_k(5,1) == 1  (only {5})
let rk51 = pa_count_k(5, 1)
cki("pa_count_k(5,1)", rk51, 1)

// KAT 12: pa_count_k(5,5) == 1  (only {1,1,1,1,1})
let rk55 = pa_count_k(5, 5)
cki("pa_count_k(5,5)", rk55, 1)

// KAT 13: pa_count_max(5,5) == 7 (no restriction, same as pa_count(5))
let rm55 = pa_count_max(5, 5)
cki("pa_count_max(5,5)", rm55, 7)

// KAT 14: pa_count_k(0,0) == 1 (empty partition)
let rk00 = pa_count_k(0, 0)
cki("pa_count_k(0,0)", rk00, 1)

print("_partition_test passed")
