import std/tensor/tsr_elementwise

// cki — check two ints are equal.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// ckb — check a bool.
fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got " + gs + " want " + ws)
        exit(1)

// ckl — check a flat int list element by element.
fn ckl(label: string, got: any, want: any)
    let ng = len(got)
    let nw = len(want)
    if ng != nw
        print("FAIL " + label + ": len got " + str(ng) + " want " + str(nw))
        exit(1)
    let i = 0
    while i < ng
        if got[i] != want[i]
            print("FAIL " + label + "[" + str(i) + "]: got " + str(got[i]) + " want " + str(want[i]))
            exit(1)
        i = i + 1

// ckt — check a tensor [flat, shape] against expected flat and shape.
fn ckt(label: string, t: any, want_flat: any, want_shape: any)
    ckl(label + ".flat", t[0], want_flat)
    ckl(label + ".shape", t[1], want_shape)

fn main()
    // ── te_add ─────────────────────────────────────────────────────────────
    // [[1,2,3,4],[2,2]] + [[5,6,7,8],[2,2]] = [[6,8,10,12],[2,2]]
    let a22 = [[1,2,3,4],[2,2]]
    let b22 = [[5,6,7,8],[2,2]]
    ckt("add_2x2", te_add(a22, b22), [6,8,10,12], [2,2])

    // te_add on 1-D
    ckt("add_1d", te_add([[1,2,3],[3]], [[10,20,30],[3]]), [11,22,33], [3])

    // te_add on scalar
    ckt("add_scalar", te_add([[5],[]], [[3],[]]), [8], [])

    // ── te_sub ─────────────────────────────────────────────────────────────
    // [[1,2,3,4],[2,2]] - [[5,6,7,8],[2,2]] = [[-4,-4,-4,-4],[2,2]]
    ckt("sub_2x2", te_sub(a22, b22), [0-4,0-4,0-4,0-4], [2,2])

    // te_sub on 1-D
    ckt("sub_1d", te_sub([[10,20,30],[3]], [[1,2,3],[3]]), [9,18,27], [3])

    // ── te_mul ─────────────────────────────────────────────────────────────
    // [[1,2,3,4],[2,2]] * [[5,6,7,8],[2,2]] = [[5,12,21,32],[2,2]]
    ckt("mul_2x2", te_mul(a22, b22), [5,12,21,32], [2,2])

    // te_mul on 1-D
    ckt("mul_1d", te_mul([[2,3,4],[3]], [[5,6,7],[3]]), [10,18,28], [3])

    // ── te_scale ───────────────────────────────────────────────────────────
    // [[1,2,3,4],[2,2]] * 3 = [[3,6,9,12],[2,2]]
    ckt("scale_2x2", te_scale([[1,2,3,4],[2,2]], 3), [3,6,9,12], [2,2])

    // te_scale by 0
    ckt("scale_zero", te_scale([[1,2,3],[3]], 0), [0,0,0], [3])

    // te_scale negative
    ckt("scale_neg", te_scale([[1,2,3],[3]], 0-2), [0-2,0-4,0-6], [3])

    // ── te_neg ─────────────────────────────────────────────────────────────
    // neg([1,-2,3]) = [-1,2,-3]
    ckt("neg_1d", te_neg([[1,0-2,3],[3]]), [0-1,2,0-3], [3])

    // te_neg of zeros
    ckt("neg_zeros", te_neg([[0,0],[2]]), [0,0], [2])

    // ── te_equal ───────────────────────────────────────────────────────────
    // same shape and data -> true
    ckb("equal_yes", te_equal([[1,2],[2]], [[1,2],[2]]), true)

    // different data -> false
    ckb("equal_data_diff", te_equal([[1,2],[2]], [[1,3],[2]]), false)

    // different shape -> false
    ckb("equal_shape_diff", te_equal([[1,2,3],[3]], [[1,2,3],[1,3]]), false)

    // ── shape mismatch guard: te_add returns first arg ────────────────────
    let mismatch = te_add([[1,2,3],[3]], [[1,2],[2]])
    ckl("add_mismatch_flat", mismatch[0], [1,2,3])
    ckl("add_mismatch_shape", mismatch[1], [3])

    // ── 2-D with negatives ────────────────────────────────────────────────
    // te_add [[0,-1],[2]] + [[2,3],[2]] = [[2,2],[2]]
    ckt("add_negatives", te_add([[0,0-1],[2]], [[2,3],[2]]), [2,2], [2])

    print("PASS _tsr_elementwise_test")
