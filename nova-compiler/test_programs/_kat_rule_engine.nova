import forge_rule_engine

fn main()
    let r = re_new()
    r = re_add_rule(r, "age_check", "age", "gt", "17")
    r = re_add_rule(r, "status_check", "status", "eq", "active")
    assert(re_rule_count(r) == 2, "2 rules")

    let data = {}
    data["age"] = "25"
    data["status"] = "active"
    let res = re_evaluate_all(r, data)
    r = res["r"]
    assert(res["passed"] == 2, "2 passed")
    assert(res["failed"] == 0, "0 failed")

    let data2 = {}
    data2["age"] = "25"
    data2["status"] = "inactive"
    let res2 = re_evaluate_all(r, data2)
    r = res2["r"]
    assert(res2["failed"] == 1, "1 failed")
    assert(res2["first_fail"] == "status_check", "status failed")

    assert(re_pass_rate(r) == 50, "50% pass rate")

    let single = re_eval_rule(r, 0, data)
    assert(is_ok(single), "single eval ok")
    assert(unwrap(single) == 1, "age passes")

    let bad = re_eval_rule(r, 99, data)
    assert(is_err(bad), "out of range is err")

    print("RULE-ENGINE KAT PASS")
