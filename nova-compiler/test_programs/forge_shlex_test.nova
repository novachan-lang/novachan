import forge_shlex

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn joinbar(xs: list) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + "|"
        out = out + xs[i]
        i = i + 1
    out

fn main()
    let fails = 0
    let dq = chr(34)
    let sq = chr(39)
    let bs = chr(92)

    // basic
    fails = fails + expect("basic", joinbar(shlex_split("hello world")), "hello|world")
    fails = fails + expect("extra_ws", joinbar(shlex_split("  foo   bar  ")), "foo|bar")
    fails = fails + expect("empty", str(len(shlex_split(""))), "0")
    fails = fails + expect("count", str(shlex_count("a b c d")), "4")

    // single quotes
    fails = fails + expect("single", joinbar(shlex_split(sq + "My Documents" + sq)), "My Documents")
    fails = fails + expect("empty_quoted", str(len(shlex_split(sq + sq))), "1")

    // double quotes
    fails = fails + expect("double", joinbar(shlex_split(dq + "hello world" + dq)), "hello world")
    fails = fails + expect("say", joinbar(shlex_split("say " + dq + "hello world" + dq + " now")), "say|hello world|now")

    // adjacent fusion
    fails = fails + expect("fuse", joinbar(shlex_split("foo" + sq + "bar" + sq + "baz")), "foobarbaz")

    // backslash escapes
    fails = fails + expect("esc_space", joinbar(shlex_split("a" + bs + " b")), "a b")
    // backslash-escaped double-quote inside double quotes -> literal "
    fails = fails + expect("esc_dq", joinbar(shlex_split(dq + "a" + bs + dq + "b" + dq)), "a" + dq + "b")

    // realistic command
    fails = fails + expect("cmd", joinbar(shlex_split("echo -n " + sq + "a b" + sq)), "echo|-n|a b")
    fails = fails + expect("rm", joinbar(shlex_split("rm -rf " + dq + "My Folder" + dq)), "rm|-rf|My Folder")

    // single quotes take backslash literally
    fails = fails + expect("sq_literal", joinbar(shlex_split(sq + "a" + bs + "b" + sq)), "a" + bs + "b")

    if fails == 0
        print("forge_shlex: all passed")
    else
        print("forge_shlex: " + str(fails) + " FAILED")
