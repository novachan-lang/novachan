// KAT test for std/text/rotations
import std/text/rotations

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got [" + got + "] expected [" + expected + "]")
        exit(1)

fn main()
    // ── rt_rotate ──────────────────────────────────────────────────────────
    // KAT: rt_rotate("abcde", 2) == "cdeab"
    cks("rotate_2",         rt_rotate("abcde", 2),  "cdeab")

    // KAT: rt_rotate("abcde", 0) == "abcde"
    cks("rotate_0",         rt_rotate("abcde", 0),  "abcde")

    // KAT: rt_rotate("abcde", 7) == "cdeab"  (7 % 5 == 2)
    cks("rotate_7",         rt_rotate("abcde", 7),  "cdeab")

    // Additional: rotate by full length returns original
    cks("rotate_full",      rt_rotate("abcde", 5),  "abcde")

    // Additional: rotate single char
    cks("rotate_single",    rt_rotate("x", 99),     "x")

    // Additional: rotate by 1
    cks("rotate_1",         rt_rotate("abcde", 1),  "bcdea")

    // ── rt_is_rotation ─────────────────────────────────────────────────────
    // KAT: rt_is_rotation("abcde", "cdeab") == true (1)
    cki("is_rot_true",      rt_is_rotation("abcde", "cdeab"),  1)

    // KAT: rt_is_rotation("abcde", "abced") == false (0)
    cki("is_rot_false",     rt_is_rotation("abcde", "abced"),  0)

    // Additional: identity is a rotation
    cki("is_rot_identity",  rt_is_rotation("abc", "abc"),      1)

    // Additional: different lengths
    cki("is_rot_difflen",   rt_is_rotation("ab", "abc"),       0)

    // ── rt_all ─────────────────────────────────────────────────────────────
    // KAT: len(rt_all("abc")) == 3
    let all3 = rt_all("abc")
    cki("all_len",          len(all3),  3)

    // KAT contents: rotation 0="abc", 1="bca", 2="cab"
    cks("all_0",            all3[0],    "abc")
    cks("all_1",            all3[1],    "bca")
    cks("all_2",            all3[2],    "cab")

    // Additional: all rotations of a 1-char string
    let all1 = rt_all("z")
    cki("all1_len",         len(all1),  1)
    cks("all1_0",           all1[0],    "z")

    // ── rt_least ───────────────────────────────────────────────────────────
    // KAT: rt_least("bca") == "abc"
    cks("least_bca",        rt_least("bca"),   "abc")

    // KAT: rt_least("cba") == "acb"
    cks("least_cba",        rt_least("cba"),   "acb")

    // Additional: already minimal
    cks("least_abc",        rt_least("abc"),   "abc")

    // Additional: single char
    cks("least_single",     rt_least("q"),     "q")

    // Additional: all same chars
    cks("least_aaa",        rt_least("aaa"),   "aaa")

    print("_rotations_test passed")
