import forge_boyermoore

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn map_str(xs: list) -> list
    let out = []
    let i = 0
    while i < len(xs)
        push(out, str(xs[i]))
        i = i + 1
    out

fn join_str(xs: list, sep: string) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + sep
        out = out + xs[i]
        i = i + 1
    out

fn main()
    let fails = 0

    // first index -- must match KMP/Z/Rabin-Karp
    fails = fails + expect("s_basic", str(bm_search("abxabcabcaby", "abcaby")), "6")
    fails = fails + expect("s_absent", str(bm_search("hello world", "xyz")), "-1")
    fails = fails + expect("s_at0", str(bm_search("abcdef", "abc")), "0")
    fails = fails + expect("s_atend", str(bm_search("abcdef", "def")), "3")
    fails = fails + expect("s_empty", str(bm_search("abc", "")), "0")
    fails = fails + expect("s_full", str(bm_search("abc", "abc")), "0")
    fails = fails + expect("s_single", str(bm_search("aaaaa", "a")), "0")
    fails = fails + expect("s_longer", str(bm_search("abc", "abcd")), "-1")
    // classic BM example with big skips
    fails = fails + expect("s_needle", str(bm_search("THIS IS A SIMPLE EXAMPLE", "EXAMPLE")), "17")
    fails = fails + expect("s_prose", str(bm_search("the quick brown fox jumps", "brown")), "10")

    // all occurrences (overlapping)
    fails = fails + expect("all_aa", join_str(map_str(bm_find_all("aaaa", "aa")), ","), "0,1,2")
    fails = fails + expect("all_ana", join_str(map_str(bm_find_all("banana", "ana")), ","), "1,3")
    fails = fails + expect("all_abc", join_str(map_str(bm_find_all("abcabcabc", "abc")), ","), "0,3,6")
    fails = fails + expect("all_none", join_str(map_str(bm_find_all("abcabc", "xy")), ","), "")
    fails = fails + expect("count_aa", str(bm_count("aaaa", "aa")), "3")

    // contains
    fails = fails + expect("has_yes", str(bm_contains("hello world", "world")), "true")
    fails = fails + expect("has_no", str(bm_contains("hello world", "World")), "false")

    if fails == 0
        print("forge_boyermoore: all passed")
    else
        print("forge_boyermoore: " + str(fails) + " FAILED")
