// Memory-mapped files: zero-copy, OS-paged read access. mmap_open maps a file,
// mmap_byte does bounds-checked reads, mmap_len gives the size, mmap_close releases.

fn main()
    write_file("mmap_probe.txt", "hello")
    let m = mmap_open("mmap_probe.txt")
    assert_eq(mmap_len(m), 5)
    // ASCII oracle: h=104 e=101 l=108 l=108 o=111
    assert_eq(mmap_byte(m, 0), 104)
    assert_eq(mmap_byte(m, 1), 101)
    assert_eq(mmap_byte(m, 2), 108)
    assert_eq(mmap_byte(m, 3), 108)
    assert_eq(mmap_byte(m, 4), 111)
    // out-of-bounds reads are safe (return -1, never UB)
    assert_eq(mmap_byte(m, 5), -1)
    assert_eq(mmap_byte(m, -1), -1)
    mmap_close(m)

    // reconstruct the string from mapped bytes
    let m2 = mmap_open("mmap_probe.txt")
    let s = ""
    let i = 0
    while i < mmap_len(m2)
        s = s + chr(mmap_byte(m2, i))
        i = i + 1
    assert_eq(s, "hello")
    mmap_close(m2)

    print("mmap passed")
