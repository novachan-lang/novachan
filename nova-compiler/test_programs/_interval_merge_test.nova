import std/interval/interval_merge

fn iv_eq(a, b) -> bool
    let na = len(a)
    let nb = len(b)
    if na != nb
        return false
    let i = 0
    while i < na
        let ai = a[i]
        let bi = b[i]
        if ai[0] != bi[0]
            return false
        if ai[1] != bi[1]
            return false
        i = i + 1
    return true

fn ckiv(got, expected, label)
    if not iv_eq(got, expected)
        print("FAIL interval_merge " + label + ": mismatch")
        exit(1)

fn ckb(got, expected, label)
    if got != expected
        let gs = "false"
        if got
            gs = "true"
        let es = "false"
        if expected
            es = "true"
        print("FAIL interval_merge " + label + ": got=" + gs + " want=" + es)
        exit(1)

fn ckf(got, expected, label)
    let diff = got - expected
    if diff < 0.0
        diff = 0.0 - diff
    if diff > 0.001
        print("FAIL interval_merge " + label + ": got=" + str(got) + " want=" + str(expected))
        exit(1)

fn cki(got, expected, label)
    if got != expected
        print("FAIL interval_merge " + label + ": got=" + str(got) + " want=" + str(expected))
        exit(1)

fn main()
    // --- KAT: im_merge basic overlap ---
    let r1 = interval_merge.im_merge([[1,3],[2,4],[6,8]])
    ckiv(r1, [[1,4],[6,8]], "merge [[1,3],[2,4],[6,8]]")

    // --- KAT: im_merge touching intervals merge ---
    let r2 = interval_merge.im_merge([[1,2],[2,3]])
    ckiv(r2, [[1,3]], "merge touching [[1,2],[2,3]]")

    // --- KAT: im_merge unsorted input ---
    let r3 = interval_merge.im_merge([[5,7],[1,3]])
    ckiv(r3, [[1,3],[5,7]], "merge unsorted [[5,7],[1,3]]")

    // --- KAT: im_merge empty ---
    let r4 = interval_merge.im_merge([])
    ckiv(r4, [], "merge []")

    // --- KAT: im_merge nested/absorbed ---
    let r5 = interval_merge.im_merge([[1,10],[2,3],[4,5]])
    ckiv(r5, [[1,10]], "merge nested [[1,10],[2,3],[4,5]]")

    // --- KAT: im_total_length ---
    let tl = interval_merge.im_total_length([[1,3],[2,4]])
    ckf(tl, 3.0, "total_length [[1,3],[2,4]]==3.0")

    // --- KAT: im_count_merged ---
    let cm = interval_merge.im_count_merged([[1,3],[2,4],[6,8]])
    cki(cm, 2, "count_merged [[1,3],[2,4],[6,8]]==2")

    // --- KAT: im_gaps ---
    let g = interval_merge.im_gaps([[1,3],[6,8]], 0, 10)
    ckiv(g, [[0,1],[3,6],[8,10]], "gaps [[1,3],[6,8]] in [0,10]")

    // --- KAT: im_insert ---
    let ins = interval_merge.im_insert([[1,3],[6,8]], [2,7])
    ckiv(ins, [[1,8]], "insert [2,7] into [[1,3],[6,8]]")

    // --- KAT: im_is_merged ---
    ckb(interval_merge.im_is_merged([[1,3],[5,7]]), true, "is_merged [[1,3],[5,7]]")
    ckb(interval_merge.im_is_merged([[1,3],[2,5]]), false, "is_merged [[1,3],[2,5]] false (overlap)")
    ckb(interval_merge.im_is_merged([[1,3],[3,5]]), false, "is_merged [[1,3],[3,5]] false (touching)")
    ckb(interval_merge.im_is_merged([]), true, "is_merged [] true")
    ckb(interval_merge.im_is_merged([[2,4],[1,3]]), false, "is_merged unsorted false")

    // --- KAT: im_add_point ---
    let ap = interval_merge.im_add_point([[1,3],[6,8]], 5)
    ckiv(ap, [[1,3],[5,5],[6,8]], "add_point 5 to [[1,3],[6,8]]")

    // --- KAT: im_sort_by_lo ---
    let sl = interval_merge.im_sort_by_lo([[5,7],[1,3],[3,4]])
    ckiv(sl, [[1,3],[3,4],[5,7]], "sort_by_lo [[5,7],[1,3],[3,4]]")

    // --- KAT: single interval ---
    let single = interval_merge.im_merge([[3,7]])
    ckiv(single, [[3,7]], "merge single [[3,7]]")

    print("PASS _interval_merge_test")

main()
