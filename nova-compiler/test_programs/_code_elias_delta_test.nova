// KAT test for std/compress/code_elias_delta
// PRIMARY gate: round-trip delta_decode(delta_encode(n), 0) == [n, len]
// SECONDARY gate: known bit-pattern vectors from the spec
import std/compress/code_elias_delta

// ── Helpers ───────────────────────────────────────────────────────────────────

fn fail_int(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn fail_str(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

// bits_to_str: convert list of 0/1 ints to a string like "[1,0,0]" for display
fn bits_to_str(bits) -> string
    let s = "["
    let n = len(bits)
    let i = 0
    while i < n
        let _d = 0
        if i > 0
            s = s + ","
        s = s + str(bits[i])
        i = i + 1
    s = s + "]"
    s

// bits_eq: compare two bit-lists element by element; return 1 if equal
fn bits_eq(a, b) -> int
    let na = len(a)
    let nb = len(b)
    if na != nb
        return 0
    let i = 0
    while i < na
        let _d = 0
        if a[i] != b[i]
            return 0
        i = i + 1
    1

fn check_bits(label, got, want)
    if bits_eq(got, want) == 0
        print("FAIL " + label + ": got=" + bits_to_str(got) + " want=" + bits_to_str(want))
        exit(1)

// make_bits: build a bit-list from individual arguments (one at a time)
fn mk1(b0) -> list
    let out = []
    push(out, b0)
    out

fn mk4(b0, b1, b2, b3) -> list
    let out = []
    push(out, b0)
    push(out, b1)
    push(out, b2)
    push(out, b3)
    out

fn mk5(b0, b1, b2, b3, b4) -> list
    let out = []
    push(out, b0)
    push(out, b1)
    push(out, b2)
    push(out, b3)
    push(out, b4)
    out

// ── KAT 1: known bit-pattern vectors from spec ────────────────────────────────
// delta_encode(1) == [1]
// delta_encode(2) == [0,1,0,0]
// delta_encode(3) == [0,1,0,1]
// delta_encode(4) == [0,1,1,0,0]

let enc1 = delta_encode(1)
check_bits("encode_1", enc1, mk1(1))

let enc2 = delta_encode(2)
check_bits("encode_2", enc2, mk4(0,1,0,0))

let enc3 = delta_encode(3)
check_bits("encode_3", enc3, mk4(0,1,0,1))

let enc4 = delta_encode(4)
check_bits("encode_4", enc4, mk5(0,1,1,0,0))

// n=5: k=2, N=3, gamma(3)=[0,1,1], low 2 bits of 5=01 -> [0,1,1,0,1]
let enc5 = delta_encode(5)
let want5 = []
push(want5, 0)
push(want5, 1)
push(want5, 1)
push(want5, 0)
push(want5, 1)
check_bits("encode_5", enc5, want5)

// n=9: k=3, N=4, gamma(4): j=floor(log2(4))=2 -> "00100" = [0,0,1,0,0]
//      low 3 bits of 9=001 -> [0,0,1,0,0,0,0,1]
let enc9 = delta_encode(9)
let want9 = []
push(want9, 0)
push(want9, 0)
push(want9, 1)
push(want9, 0)
push(want9, 0)
push(want9, 0)
push(want9, 0)
push(want9, 1)
check_bits("encode_9", enc9, want9)

// ── KAT 2: decode of known vectors ───────────────────────────────────────────

let d1 = delta_decode(enc1, 0)
fail_int("decode_1_val",     d1[0], 1)
fail_int("decode_1_nextpos", d1[1], 1)

let d2 = delta_decode(enc2, 0)
fail_int("decode_2_val",     d2[0], 2)
fail_int("decode_2_nextpos", d2[1], 4)

let d3 = delta_decode(enc3, 0)
fail_int("decode_3_val",     d3[0], 3)
fail_int("decode_3_nextpos", d3[1], 4)

let d4 = delta_decode(enc4, 0)
fail_int("decode_4_val",     d4[0], 4)
fail_int("decode_4_nextpos", d4[1], 5)

let d5 = delta_decode(enc5, 0)
fail_int("decode_5_val",     d5[0], 5)
fail_int("decode_5_nextpos", d5[1], 5)

let d9 = delta_decode(enc9, 0)
fail_int("decode_9_val",     d9[0], 9)
fail_int("decode_9_nextpos", d9[1], 8)

// ── KAT 3: round-trip 1..100 ─────────────────────────────────────────────────

let n = 1
while n <= 100
    let _d = 0
    let enc = delta_encode(n)
    let dec = delta_decode(enc, 0)
    let elen = len(enc)
    if dec[0] != n
        print("FAIL roundtrip_val n=" + str(n) + " got=" + str(dec[0]) + " want=" + str(n))
        exit(1)
    if dec[1] != elen
        print("FAIL roundtrip_pos n=" + str(n) + " got=" + str(dec[1]) + " want=" + str(elen))
        exit(1)
    n = n + 1

// ── KAT 4: sequence round-trip (concatenated codes, decode sequentially) ──────
// Encode [1, 2, 3, 4, 5, 9, 16, 50, 100] into one merged bit-list,
// then decode them back in order using next_pos chaining.

let seq_vals = []
push(seq_vals, 1)
push(seq_vals, 2)
push(seq_vals, 3)
push(seq_vals, 4)
push(seq_vals, 5)
push(seq_vals, 9)
push(seq_vals, 16)
push(seq_vals, 50)
push(seq_vals, 100)

// Build merged bit-list
let merged = []
let si = 0
while si < len(seq_vals)
    let _d = 0
    let part = delta_encode(seq_vals[si])
    let pi = 0
    while pi < len(part)
        let _d2 = 0
        push(merged, part[pi])
        pi = pi + 1
    si = si + 1

// Decode sequentially
let cur_pos = 0
let di = 0
while di < len(seq_vals)
    let _d = 0
    let want_v = seq_vals[di]
    let res = delta_decode(merged, cur_pos)
    let got_v = res[0]
    let nxt = res[1]
    if got_v != want_v
        print("FAIL seq_rt idx=" + str(di) + " got=" + str(got_v) + " want=" + str(want_v))
        exit(1)
    cur_pos = nxt
    di = di + 1

// ── KAT 5: pack_bits basic check ─────────────────────────────────────────────
// pack_bits([1,0,0,0,0,0,0,0]) -> [128]
// pack_bits([0,0,0,0,0,0,0,1]) -> [1]
// pack_bits([1,1,1,1,1,1,1,1]) -> [255]
// pack_bits([1,0]) -> [128]  (zero-padded: 1,0,0,0,0,0,0,0)

let pb_a = []
push(pb_a, 1)
push(pb_a, 0)
push(pb_a, 0)
push(pb_a, 0)
push(pb_a, 0)
push(pb_a, 0)
push(pb_a, 0)
push(pb_a, 0)
let packed_a = pack_bits(pb_a)
fail_int("pack_128", packed_a[0], 128)

let pb_b = []
push(pb_b, 0)
push(pb_b, 0)
push(pb_b, 0)
push(pb_b, 0)
push(pb_b, 0)
push(pb_b, 0)
push(pb_b, 0)
push(pb_b, 1)
let packed_b = pack_bits(pb_b)
fail_int("pack_1", packed_b[0], 1)

let pb_c = []
push(pb_c, 1)
push(pb_c, 1)
push(pb_c, 1)
push(pb_c, 1)
push(pb_c, 1)
push(pb_c, 1)
push(pb_c, 1)
push(pb_c, 1)
let packed_c = pack_bits(pb_c)
fail_int("pack_255", packed_c[0], 255)

let pb_d = []
push(pb_d, 1)
push(pb_d, 0)
let packed_d = pack_bits(pb_d)
fail_int("pack_pad_128", packed_d[0], 128)

// ── KAT 6: larger values round-trip ──────────────────────────────────────────
let big_vals = []
push(big_vals, 127)
push(big_vals, 128)
push(big_vals, 255)
push(big_vals, 256)
push(big_vals, 1000)

let bvi = 0
while bvi < len(big_vals)
    let _d = 0
    let bv = big_vals[bvi]
    let benc = delta_encode(bv)
    let bdec = delta_decode(benc, 0)
    if bdec[0] != bv
        print("FAIL big_rt n=" + str(bv) + " got=" + str(bdec[0]))
        exit(1)
    if bdec[1] != len(benc)
        print("FAIL big_rt_pos n=" + str(bv) + " got=" + str(bdec[1]) + " want=" + str(len(benc)))
        exit(1)
    bvi = bvi + 1

print("PASS _code_elias_delta_test")
