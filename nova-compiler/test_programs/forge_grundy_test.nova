import forge_grundy as gr

fn check(cond: bool, label: string)
    if cond == false
        print("FAIL: " + label)

fn main()
    // ---- mex ----
    check(gr.mex([]) == 0, "mex empty == 0")
    check(gr.mex([0, 1, 2]) == 3, "mex 0,1,2 == 3")
    check(gr.mex([1, 2, 3]) == 0, "mex 1,2,3 == 0")
    check(gr.mex([0, 2, 3]) == 1, "mex 0,2,3 == 1")
    check(gr.mex([0, 1, 3, 4]) == 2, "mex gap at 2")
    check(gr.mex([5, 5, 5]) == 0, "mex 5,5,5 == 0")

    // ---- Nim ----
    check(gr.nim_value([1, 2, 3]) == 0, "nim 1,2,3 == 0 (losing)")
    check(gr.nim_is_winning([1, 2, 3]) == false, "1,2,3 is a P-position")
    check(gr.nim_value([1, 2, 4]) == 7, "nim 1,2,4 == 7")
    check(gr.nim_is_winning([1, 2, 4]), "1,2,4 is a win")
    check(gr.nim_value([]) == 0, "empty nim losing")
    check(gr.nim_value([5]) == 5, "single pile 5 winning")
    // equal piles always cancel -> P-position
    let k = 0
    while k <= 30
        check(gr.nim_value([k, k]) == 0, "two equal piles k=" + str(k) + " losing")
        k = k + 1

    // ---- subtraction game {1,2,3}: closed form Grundy(i) = i mod 4 ----
    let g123 = gr.grundy_subtraction(40, [1, 2, 3])
    let i = 0
    while i <= 40
        check(g123[i] == i % 4, "grundy 123 at " + str(i) + " == i%4")
        i = i + 1

    // ---- subtraction game {1,2}: closed form Grundy(i) = i mod 3 ----
    let g12 = gr.grundy_subtraction(40, [1, 2])
    let j = 0
    while j <= 40
        check(g12[j] == j % 3, "grundy 12 at " + str(j) + " == i%3")
        j = j + 1

    // ---- subtraction game {2,3}: verify mex-consistency (g[i] = mex of reachable) ----
    let g23 = gr.grundy_subtraction(30, [2, 3])
    let a = 0
    while a <= 30
        // recompute mex of reachable and compare
        let reach = []
        if a >= 2
            push(reach, g23[a - 2])
        if a >= 3
            push(reach, g23[a - 3])
        check(g23[a] == gr.mex(reach), "grundy 23 self-consistent at " + str(a))
        a = a + 1

    // ---- Sprague-Grundy: sum of two {1,2,3}-piles is losing iff (a%4) XOR (b%4) == 0 ----
    let pa = 0
    while pa <= 12
        let pb = 0
        while pb <= 12
            let combined = gr.grundy_xor([g123[pa], g123[pb]])
            check(combined == ((pa % 4) ^ (pb % 4)), "SG sum a=" + str(pa) + " b=" + str(pb))
            // losing iff xor == 0
            let losing = combined == 0
            let expect_losing = ((pa % 4) ^ (pb % 4)) == 0
            check(losing == expect_losing, "SG losing-condition a=" + str(pa) + " b=" + str(pb))
            pb = pb + 1
        pa = pa + 1

    print("forge_grundy: all passed")
