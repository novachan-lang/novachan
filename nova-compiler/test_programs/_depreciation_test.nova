// KAT for std/finance/depreciation — asset depreciation methods.
import std/finance/depreciation

fn ckf(label: string, got: float, want: float)
    let d = got - want
    if d < 0.0
        d = 0.0 - d
    if d > 0.01
        print("FAIL " + label + ": " + str(got) + " != " + str(want))
        exit(1)

fn main()
    // 1. Straight-line: (10000-1000)/5 = 1800.0
    ckf("sl_basic", dep_straight_line(10000.0, 1000.0, 5), 1800.0)

    // 2. SYD year 1: 5/15 * 9000 = 3000.0
    ckf("syd_y1", dep_syd(10000.0, 1000.0, 5, 1), 3000.0)

    // 3. SYD year 5: 1/15 * 9000 = 600.0
    ckf("syd_y5", dep_syd(10000.0, 1000.0, 5, 5), 600.0)

    // 4. Declining balance year 1 factor=2: rate=0.4, 10000*0.4=4000.0
    ckf("db_y1", dep_declining_balance(10000.0, 1000.0, 5, 1, 2.0), 4000.0)

    // 5. Units of production: 9000/9000 * 900 = 900.0
    ckf("units", dep_units(10000.0, 1000.0, 9000, 900), 900.0)

    // 6. Book value SL after year 2: 10000 - 1800*2 = 6400.0
    ckf("bv_sl_y2", dep_book_value_sl(10000.0, 1000.0, 5, 2), 6400.0)

    // 7. SYD year 2: 4/15 * 9000 = 2400.0
    ckf("syd_y2", dep_syd(10000.0, 1000.0, 5, 2), 2400.0)

    // 8. Declining balance year 2 factor=2: bv_start=6000, dep=6000*0.4=2400.0
    ckf("db_y2", dep_declining_balance(10000.0, 1000.0, 5, 2, 2.0), 2400.0)

    // --- canonical-name alias KATs (task-spec) ---

    // KAT 9: straight_line(10000,1000,9) = (10000-1000)/9 = 1000.0
    let sl9 = straight_line(10000.0, 1000.0, 9)
    ckf("straight_line_9yr", sl9, 1000.0)

    // KAT 10: declining_balance decreases each year
    // cost=10000, rate=0.2, year 1: 10000*0.2=2000
    // year 2: 8000*0.2=1600  => y2 < y1
    let db1 = declining_balance(10000.0, 0.2, 1)
    let db2 = declining_balance(10000.0, 0.2, 2)
    let db3 = declining_balance(10000.0, 0.2, 3)
    if db2 >= db1
        print("FAIL declining_balance_decrease_y2_y1: " + str(db2) + " >= " + str(db1))
        exit(1)
    if db3 >= db2
        print("FAIL declining_balance_decrease_y3_y2: " + str(db3) + " >= " + str(db2))
        exit(1)
    // year 1 value: 10000*0.2 = 2000
    ckf("declining_balance_y1", db1, 2000.0)
    // year 2 value: 8000*0.2 = 1600
    ckf("declining_balance_y2", db2, 1600.0)

    // KAT 11: sum_of_years year-1 depreciation > year-2 (accelerated)
    let sy1 = sum_of_years(10000.0, 1000.0, 5, 1)
    let sy2 = sum_of_years(10000.0, 1000.0, 5, 2)
    if sy1 <= sy2
        print("FAIL sum_of_years_y1_gt_y2: " + str(sy1) + " <= " + str(sy2))
        exit(1)
    // year-1: 5/15 * 9000 = 3000
    ckf("sum_of_years_y1", sy1, 3000.0)
    // year-2: 4/15 * 9000 = 2400
    ckf("sum_of_years_y2", sy2, 2400.0)

    print("PASS _depreciation_test")
