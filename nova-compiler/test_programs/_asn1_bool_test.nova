// _asn1_bool_test — KAT for std/data/asn1_bool (ASN.1 DER BOOLEAN)
//
// Verifies byte-exact DER encoding per X.690 and BER-lenient decoding.
//
// KAT vectors:
//   1. asn1_bool_encode(1)  == [0x01, 0x01, 0xFF]   (true)
//   2. asn1_bool_encode(0)  == [0x01, 0x01, 0x00]   (false)
//   3. asn1_bool_decode([0x01,0x01,0xFF], 0) == [1, 3]
//   4. asn1_bool_decode([0x01,0x01,0x00], 0) == [0, 3]
//   5. Round-trip: encode(true) -> decode -> true; encode(false) -> decode -> false
//   6. BER-lenient: content byte 0x01 -> true (non-zero)
//   7. Malformed: wrong tag -> [0, 0] (safe stall)
//   8. Malformed: too short -> [0, 0] (safe stall)

import std/data/asn1_bool

// ── KAT 1: asn1_bool_encode(1) == [0x01, 0x01, 0xFF] ──────────────────────
let enc_true = asn1_bool_encode(1)
if bytes_len(enc_true) != 3
    print("FAIL kat1: wrong length")
    exit(1)
if bytes_get(enc_true, 0) != 1
    print("FAIL kat1: tag != 0x01")
    exit(1)
if bytes_get(enc_true, 1) != 1
    print("FAIL kat1: len byte != 0x01")
    exit(1)
if bytes_get(enc_true, 2) != 255
    print("FAIL kat1: value byte != 0xFF")
    exit(1)
print("PASS kat1: asn1_bool_encode(true) == [0x01,0x01,0xFF]")

// ── KAT 2: asn1_bool_encode(0) == [0x01, 0x01, 0x00] ─────────────────────
let enc_false = asn1_bool_encode(0)
if bytes_len(enc_false) != 3
    print("FAIL kat2: wrong length")
    exit(1)
if bytes_get(enc_false, 0) != 1
    print("FAIL kat2: tag != 0x01")
    exit(1)
if bytes_get(enc_false, 1) != 1
    print("FAIL kat2: len byte != 0x01")
    exit(1)
if bytes_get(enc_false, 2) != 0
    print("FAIL kat2: value byte != 0x00")
    exit(1)
print("PASS kat2: asn1_bool_encode(false) == [0x01,0x01,0x00]")

// ── KAT 3: asn1_bool_decode([0x01,0x01,0xFF], 0) == [1, 3] ───────────────
let b_true = bytes(3)
bytes_set(b_true, 0, 1)
bytes_set(b_true, 1, 1)
bytes_set(b_true, 2, 255)
let dec_true = asn1_bool_decode(b_true, 0)
if dec_true[0] != 1
    print("FAIL kat3: decoded value != 1 (true)")
    exit(1)
if dec_true[1] != 3
    print("FAIL kat3: next_pos != 3")
    exit(1)
print("PASS kat3: asn1_bool_decode([0x01,0x01,0xFF],0) == [1,3]")

// ── KAT 4: asn1_bool_decode([0x01,0x01,0x00], 0) == [0, 3] ───────────────
let b_false = bytes(3)
bytes_set(b_false, 0, 1)
bytes_set(b_false, 1, 1)
bytes_set(b_false, 2, 0)
let dec_false = asn1_bool_decode(b_false, 0)
if dec_false[0] != 0
    print("FAIL kat4: decoded value != 0 (false)")
    exit(1)
if dec_false[1] != 3
    print("FAIL kat4: next_pos != 3")
    exit(1)
print("PASS kat4: asn1_bool_decode([0x01,0x01,0x00],0) == [0,3]")

// ── KAT 5: Round-trip encode(true) -> decode -> true ──────────────────────
let rt_true = asn1_bool_decode(enc_true, 0)
if rt_true[0] != 1
    print("FAIL kat5: round-trip true failed")
    exit(1)
if rt_true[1] != 3
    print("FAIL kat5: round-trip true next_pos != 3")
    exit(1)
let rt_false = asn1_bool_decode(enc_false, 0)
if rt_false[0] != 0
    print("FAIL kat5: round-trip false failed")
    exit(1)
if rt_false[1] != 3
    print("FAIL kat5: round-trip false next_pos != 3")
    exit(1)
print("PASS kat5: round-trip encode->decode both values")

// ── KAT 6: BER-lenient: content 0x01 -> true (non-zero) ──────────────────
let b_ber = bytes(3)
bytes_set(b_ber, 0, 1)
bytes_set(b_ber, 1, 1)
bytes_set(b_ber, 2, 1)
let dec_ber = asn1_bool_decode(b_ber, 0)
if dec_ber[0] != 1
    print("FAIL kat6: BER 0x01 content should decode as true")
    exit(1)
if dec_ber[1] != 3
    print("FAIL kat6: next_pos != 3")
    exit(1)
print("PASS kat6: BER-lenient 0x01 content byte -> true")

// ── KAT 7: Malformed: wrong tag (0x02) -> safe stall [0, 0] ──────────────
let b_bad_tag = bytes(3)
bytes_set(b_bad_tag, 0, 2)
bytes_set(b_bad_tag, 1, 1)
bytes_set(b_bad_tag, 2, 255)
let dec_bad_tag = asn1_bool_decode(b_bad_tag, 0)
if dec_bad_tag[0] != 0
    print("FAIL kat7: wrong tag should return bval=0")
    exit(1)
if dec_bad_tag[1] != 0
    print("FAIL kat7: wrong tag should return stall pos=0")
    exit(1)
print("PASS kat7: malformed tag -> safe stall [0,0]")

// ── KAT 8: Malformed: too short (only 2 bytes) -> safe stall ─────────────
let b_short = bytes(2)
bytes_set(b_short, 0, 1)
bytes_set(b_short, 1, 1)
let dec_short = asn1_bool_decode(b_short, 0)
if dec_short[0] != 0
    print("FAIL kat8: too-short buffer should return bval=0")
    exit(1)
if dec_short[1] != 0
    print("FAIL kat8: too-short buffer should return stall pos=0")
    exit(1)
print("PASS kat8: too-short input -> safe stall [0,0]")

// ── KAT 9: decode at non-zero offset ─────────────────────────────────────
// Build a 6-byte buffer: 3 garbage bytes then [0x01,0x01,0xFF]
let b_offset = bytes(6)
bytes_set(b_offset, 0, 0)
bytes_set(b_offset, 1, 0)
bytes_set(b_offset, 2, 0)
bytes_set(b_offset, 3, 1)
bytes_set(b_offset, 4, 1)
bytes_set(b_offset, 5, 255)
let dec_offset = asn1_bool_decode(b_offset, 3)
if dec_offset[0] != 1
    print("FAIL kat9: offset decode value != 1")
    exit(1)
if dec_offset[1] != 6
    print("FAIL kat9: offset decode next_pos != 6")
    exit(1)
print("PASS kat9: decode at non-zero offset")

print("PASS _asn1_bool_test")
