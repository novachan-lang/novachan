// KAT for prism/ui/prism_ui_notice.nova (PRISM_ROADMAP.md milestone MB.19, the `ui/` composition
// layer's notification components: badge, dot, item, list, group).
//
// Every expected shape below is hand-computed from `prism_node.prism_node_new`'s own depth/count
// rule (leaf: depth=1, count=1; branch: depth=max(child depths)+1, count=1+sum(child counts)) --
// never taken on faith from the implementation. Proves, against concrete expected values:
//   1. Badge: count==0 hides (returns `content` unchanged); count>0 with no max shows the exact
//      decimal; count>max shows "{max}+" (the 99+ case); count==max EXACTLY does NOT get a "+"
//      (the off-by-one boundary a naive `>=` would get wrong); rejects count<0, max present <1.
//   2. Dot: visible shows layer[content, warning glyph]; not-visible returns `content` unchanged.
//   3. Item: exact stack/band shape with and without nt_time; a present-but-empty nt_time degrades
//      to the same shape as no time (tolerant-degrade, same class prism_fb_alert's detail uses);
//      nt_read attr round-trips true and false; rejects empty nt_title/nt_message.
//   4. List: empty items -> prism_ui_kit's empty state (exact band/glyph/label shape); non-empty
//      items -> stack(items) with exact depth/count; rejects an empty nt_empty_text EVEN WHEN
//      items is non-empty (proves the "validated unconditionally" design, see file header); rejects
//      a non-PrismNode element, named by index and actual type.
//   5. Group: exact stack[title, gap(8), stack(items)] shape, gap value verified via prism_arrange's
//      own typed accessors; rejects empty nt_title, empty items, non-PrismNode element.
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova into
// $NOVA_HOME/lib, so `import prism_node` / `import prism_ui_notice` resolve.
//   ./gen3_test.exe _kat_prism_ui_notice.nova
//   clang -O2 -o _kat_prism_ui_notice.exe _kat_prism_ui_notice.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_ui_notice.exe

import prism_node
import prism_content
import prism_arrange
import prism_ui_notice

let FAILED = [0]

fn _check(label: string, got: string, want: string)
    if got == want
        print("  pass  " + label)
    else
        print("  FAIL  " + label + "  got=" + got + "  want=" + want)
        FAILED[0] = FAILED[0] + 1

fn _check_true(label: string, cond: bool)
    if cond
        print("  pass  " + label)
    else
        print("  FAIL  " + label)
        FAILED[0] = FAILED[0] + 1

fn _lbl(s: string) -> PrismNode
    unwrap(prism_content.prism_label(s))

fn main()
    let content_node = _lbl("Inbox")

    // ── 1. Badge ──────────────────────────────────────────────────────────────────────────────
    print("== 1. badge ==")

    // count == 0 hides: returns `content` unchanged, no layer wrapper.
    let b0 = unwrap(prism_ui_notice.prism_nt_badge(0, none(), content_node))
    _check("badge(0, none) kind == label (content unchanged)", prism_node.prism_node_kind_str(b0), "label")
    _check("badge(0, none) depth", str(prism_node.prism_node_depth(b0)), "1")
    _check("badge(0, none) count", str(prism_node.prism_node_count(b0)), "1")
    _check("badge(0, none) text == Inbox (still the caller's content)", prism_node.prism_node_attr_str(b0, "text", ""), "Inbox")

    // count > 0, no max: exact decimal, layer[content, label(count)].
    let b5 = unwrap(prism_ui_notice.prism_nt_badge(5, none(), content_node))
    _check("badge(5, none) kind == layer", prism_node.prism_node_kind_str(b5), "layer")
    _check("badge(5, none) depth", str(prism_node.prism_node_depth(b5)), "2")
    _check("badge(5, none) count", str(prism_node.prism_node_count(b5)), "3")
    let b5_kids = prism_node.prism_node_children(b5)
    _check("badge(5, none) child 0 == content", prism_node.prism_node_attr_str(b5_kids[0], "text", ""), "Inbox")
    _check("badge(5, none) child 1 text == 5", prism_node.prism_node_attr_str(b5_kids[1], "text", ""), "5")

    // count > max: overflow renders "{max}+" (the 99+ case).
    let b100 = unwrap(prism_ui_notice.prism_nt_badge(100, some(99), content_node))
    _check("badge(100, max=99) kind == layer", prism_node.prism_node_kind_str(b100), "layer")
    let b100_kids = prism_node.prism_node_children(b100)
    _check("badge(100, max=99) text == 99+", prism_node.prism_node_attr_str(b100_kids[1], "text", ""), "99+")

    // count < max: exact decimal, no overflow marker.
    let b50 = unwrap(prism_ui_notice.prism_nt_badge(50, some(99), content_node))
    let b50_kids = prism_node.prism_node_children(b50)
    _check("badge(50, max=99) text == 50 (below max, no +)", prism_node.prism_node_attr_str(b50_kids[1], "text", ""), "50")

    // count == max EXACTLY: boundary must NOT get a "+" (a naive `>=` would get this wrong).
    let b99 = unwrap(prism_ui_notice.prism_nt_badge(99, some(99), content_node))
    let b99_kids = prism_node.prism_node_children(b99)
    _check("badge(99, max=99) text == 99 (== max, not >, no +)", prism_node.prism_node_attr_str(b99_kids[1], "text", ""), "99")

    // Rejections.
    let b_neg = prism_ui_notice.prism_nt_badge(-1, none(), content_node)
    _check_true("badge rejects nt_count < 0", is_err(b_neg))
    let b_max0 = prism_ui_notice.prism_nt_badge(5, some(0), content_node)
    _check_true("badge rejects nt_max == 0", is_err(b_max0))
    let b_max_neg = prism_ui_notice.prism_nt_badge(5, some(-3), content_node)
    _check_true("badge rejects nt_max < 0", is_err(b_max_neg))

    // ── 2. Dot ────────────────────────────────────────────────────────────────────────────────
    print("== 2. dot ==")

    let d_on = unwrap(prism_ui_notice.prism_nt_dot(true, content_node))
    _check("dot(true) kind == layer", prism_node.prism_node_kind_str(d_on), "layer")
    _check("dot(true) depth", str(prism_node.prism_node_depth(d_on)), "2")
    _check("dot(true) count", str(prism_node.prism_node_count(d_on)), "3")
    let d_on_kids = prism_node.prism_node_children(d_on)
    _check("dot(true) child 0 == content", prism_node.prism_node_attr_str(d_on_kids[0], "text", ""), "Inbox")
    _check("dot(true) child 1 kind == glyph", prism_node.prism_node_kind_str(d_on_kids[1]), "glyph")
    _check("dot(true) child 1 icon == warning", prism_node.prism_node_attr_str(d_on_kids[1], "icon", ""), "warning")

    let d_off = unwrap(prism_ui_notice.prism_nt_dot(false, content_node))
    _check("dot(false) kind == label (content unchanged)", prism_node.prism_node_kind_str(d_off), "label")
    _check("dot(false) count == 1 (no glyph attached)", str(prism_node.prism_node_count(d_off)), "1")

    // ── 3. Item ───────────────────────────────────────────────────────────────────────────────
    print("== 3. item ==")

    // No time, unread.
    let item1 = unwrap(prism_ui_notice.prism_nt_item("Order shipped", "Your order #123 has shipped.", none(), false))
    _check("item1 kind == stack", prism_node.prism_node_kind_str(item1), "stack")
    _check("item1 depth", str(prism_node.prism_node_depth(item1)), "3")
    _check("item1 count", str(prism_node.prism_node_count(item1)), "4")
    _check_true("item1 nt_read == false", prism_node.prism_node_attr_bool(item1, "nt_read", true) == false)
    let item1_kids = prism_node.prism_node_children(item1)
    _check("item1 head kind == band", prism_node.prism_node_kind_str(item1_kids[0]), "band")
    _check("item1 head child_count == 1 (no time)", str(prism_node.prism_node_child_count(item1_kids[0])), "1")
    _check("item1 title text", prism_node.prism_node_attr_str(prism_node.prism_node_children(item1_kids[0])[0], "text", ""), "Order shipped")
    _check("item1 message text", prism_node.prism_node_attr_str(item1_kids[1], "text", ""), "Your order #123 has shipped.")

    // With time, read.
    let item2 = unwrap(prism_ui_notice.prism_nt_item("New comment", "Alice commented on your post.", some("2 hours ago"), true))
    _check("item2 kind == stack", prism_node.prism_node_kind_str(item2), "stack")
    _check("item2 depth", str(prism_node.prism_node_depth(item2)), "3")
    _check("item2 count", str(prism_node.prism_node_count(item2)), "5")
    _check_true("item2 nt_read == true", prism_node.prism_node_attr_bool(item2, "nt_read", false) == true)
    let item2_kids = prism_node.prism_node_children(item2)
    _check("item2 head child_count == 2 (title + time)", str(prism_node.prism_node_child_count(item2_kids[0])), "2")
    let item2_head_kids = prism_node.prism_node_children(item2_kids[0])
    _check("item2 title text", prism_node.prism_node_attr_str(item2_head_kids[0], "text", ""), "New comment")
    _check("item2 time text", prism_node.prism_node_attr_str(item2_head_kids[1], "text", ""), "2 hours ago")

    // A present-but-empty nt_time degrades to the SAME shape as no time at all (tolerant-degrade).
    let item3 = unwrap(prism_ui_notice.prism_nt_item("T", "M", some(""), false))
    _check("item3 (blank Some(time)) head child_count == 1, degrades like None", str(prism_node.prism_node_child_count(prism_node.prism_node_children(item3)[0])), "1")

    // Rejections.
    let item_empty_title = prism_ui_notice.prism_nt_item("", "msg", none(), false)
    _check_true("item rejects empty nt_title", is_err(item_empty_title))
    let item_empty_msg = prism_ui_notice.prism_nt_item("Title", "", none(), false)
    _check_true("item rejects empty nt_message", is_err(item_empty_msg))

    // ── 4. List ───────────────────────────────────────────────────────────────────────────────
    print("== 4. list ==")

    // Empty items -> prism_ui_kit's empty state: band[glyph(info), label(message)].
    let list_empty = unwrap(prism_ui_notice.prism_nt_list([], "No notifications yet"))
    _check("list(empty) kind == band (empty state)", prism_node.prism_node_kind_str(list_empty), "band")
    _check("list(empty) depth", str(prism_node.prism_node_depth(list_empty)), "2")
    _check("list(empty) count", str(prism_node.prism_node_count(list_empty)), "3")
    let list_empty_kids = prism_node.prism_node_children(list_empty)
    _check("list(empty) child 0 kind == glyph", prism_node.prism_node_kind_str(list_empty_kids[0]), "glyph")
    _check("list(empty) child 0 icon == info", prism_node.prism_node_attr_str(list_empty_kids[0], "icon", ""), "info")
    _check("list(empty) child 1 text == nt_empty_text", prism_node.prism_node_attr_str(list_empty_kids[1], "text", ""), "No notifications yet")

    // Non-empty items -> stack(items), exact depth/count derived from item1 (d3,c4) + item2 (d3,c5).
    let list_full = unwrap(prism_ui_notice.prism_nt_list([item1, item2], "No notifications"))
    _check("list(2 items) kind == stack", prism_node.prism_node_kind_str(list_full), "stack")
    _check("list(2 items) depth", str(prism_node.prism_node_depth(list_full)), "4")
    _check("list(2 items) count", str(prism_node.prism_node_count(list_full)), "10")
    let list_full_kids = prism_node.prism_node_children(list_full)
    _check_true("list(2 items) child 0 is item1", list_full_kids[0].count == 4)
    _check_true("list(2 items) child 1 is item2", list_full_kids[1].count == 5)

    // Rejections. nt_empty_text is validated UNCONDITIONALLY -- even with non-empty items, an
    // empty nt_empty_text is still rejected (see file header for why).
    let list_bad_text_empty_items = prism_ui_notice.prism_nt_list([], "")
    _check_true("list rejects empty nt_empty_text (items also empty)", is_err(list_bad_text_empty_items))
    let list_bad_text_full_items = prism_ui_notice.prism_nt_list([item1], "")
    _check_true("list rejects empty nt_empty_text EVEN WHEN items is non-empty (unconditional validation)", is_err(list_bad_text_full_items))
    let list_bad_elem = prism_ui_notice.prism_nt_list([item1, "not a node"], "No notifications")
    _check_true("list rejects a non-PrismNode element", is_err(list_bad_elem))
    if is_err(list_bad_elem)
        _check_true("list's rejection names the offending index and type", find(unwrap_err(list_bad_elem), "1") >= 0 and find(unwrap_err(list_bad_elem), "string") >= 0)

    // ── 5. Group ──────────────────────────────────────────────────────────────────────────────
    print("== 5. group ==")

    let group1 = unwrap(prism_ui_notice.prism_nt_group("Today", [item1, item2]))
    _check("group kind == stack", prism_node.prism_node_kind_str(group1), "stack")
    _check("group depth", str(prism_node.prism_node_depth(group1)), "5")
    _check("group count", str(prism_node.prism_node_count(group1)), "13")
    let group1_kids = prism_node.prism_node_children(group1)
    _check("group child 0 kind == label", prism_node.prism_node_kind_str(group1_kids[0]), "label")
    _check("group title text", prism_node.prism_node_attr_str(group1_kids[0], "text", ""), "Today")
    _check("group child 1 kind == gap", prism_node.prism_node_kind_str(group1_kids[1]), "gap")
    _check_true("group gap is fixed (not flexible)", not prism_arrange.prism_gap_is_flexible(group1_kids[1]))
    _check("group gap size == 8", str(prism_arrange.prism_gap_size(group1_kids[1], -1)), "8")
    _check("group child 2 kind == stack (items)", prism_node.prism_node_kind_str(group1_kids[2]), "stack")
    _check("group items stack depth", str(prism_node.prism_node_depth(group1_kids[2])), "4")
    _check("group items stack count", str(prism_node.prism_node_count(group1_kids[2])), "10")

    // Rejections.
    let group_empty_title = prism_ui_notice.prism_nt_group("", [item1])
    _check_true("group rejects empty nt_title", is_err(group_empty_title))
    let group_empty_items = prism_ui_notice.prism_nt_group("Today", [])
    _check_true("group rejects empty items", is_err(group_empty_items))
    let group_bad_elem = prism_ui_notice.prism_nt_group("Today", [item1, 42])
    _check_true("group rejects a non-PrismNode element", is_err(group_bad_elem))
    if is_err(group_bad_elem)
        _check_true("group's rejection names the offending index and type", find(unwrap_err(group_bad_elem), "1") >= 0 and find(unwrap_err(group_bad_elem), "int") >= 0)

    // ── Summary ───────────────────────────────────────────────────────────────────────────────
    if FAILED[0] == 0
        print("")
        print("_kat_prism_ui_notice: ALL PASS")
    else
        print("")
        print("_kat_prism_ui_notice: " + str(FAILED[0]) + " FAILURE(S)")
        exit(1)
