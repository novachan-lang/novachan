// Soundness guard: a dict remains correct after being deep-copied across a spawn / channel boundary --
// including growth past the rehash thresholds, an initially-empty copy, and a map keyed by a
// channel-received string (the OTP-registry pattern). A prior note claimed "adding a new key to a
// spawn-deep-copied dict breaks contains/index"; this guard demonstrates that is NOT the case in the
// current runtime (4 variants), and keeps it from regressing. Socketless, deterministic, kill-on-timeout.

fn grow_child(d, reply)
    let i = 0
    while i < 60
        d["k" + str(i)] = i
        i = i + 1
    let ok = true
    let j = 0
    while j < 60
        if contains(d, "k" + str(j)) == false
            ok = false
        else if d["k" + str(j)] != j
            ok = false
        j = j + 1
    if contains(d, "a") == false or d["a"] != 1
        ok = false
    send(reply, ok)

fn relay_child(inp, reply)
    let d = receive(inp)
    d["new"] = "v"
    let ok = contains(d, "new")
    if ok
        if d["new"] != "v"
            ok = false
    if contains(d, "x") == false or d["x"] != "1"
        ok = false
    send(reply, ok)

fn empty_child(d, reply)
    let i = 0
    while i < 40
        d["e" + str(i)] = i * 2
        i = i + 1
    let ok = true
    let j = 0
    while j < 40
        if contains(d, "e" + str(j)) == false or d["e" + str(j)] != j * 2
            ok = false
        j = j + 1
    send(reply, ok)

fn reg_child(req, m, reply)
    let env = receive(req)
    m[env["key"]] = env["val"]
    let ok = contains(m, env["key"])
    if ok
        if m["alice"] != "42" or contains(m, "pre") == false
            ok = false
    send(reply, ok)

fn main()
    let d1 = {}
    d1["a"] = 1
    d1["b"] = 2
    let r1 = channel()
    spawn grow_child(d1, r1)
    if receive(r1) == false
        print("FAIL: grow on a spawn-copied dict broke contains/index")
        exit(1)

    let d2 = {}
    d2["x"] = "1"
    let inp = channel()
    let r2 = channel()
    spawn relay_child(inp, r2)
    send(inp, d2)
    if receive(r2) == false
        print("FAIL: channel-received dict broke on a new key")
        exit(1)

    let d3 = {}
    let r3 = channel()
    spawn empty_child(d3, r3)
    if receive(r3) == false
        print("FAIL: empty spawn-copied dict broke on growth")
        exit(1)

    let m = {}
    m["pre"] = "x"
    let req = channel()
    let r4 = channel()
    spawn reg_child(req, m, r4)
    let env = {}
    env["key"] = "alice"
    env["val"] = "42"
    send(req, env)
    if receive(r4) == false
        print("FAIL: registry map (spawn-copied, channel-string key) broke contains/index")
        exit(1)

    print("PASS dict_deepcopy_soundness (grow + channel + empty + registry-key all sound after deep-copy)")
