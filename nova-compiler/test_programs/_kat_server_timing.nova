import forge_server_timing

fn tf(b: bool) -> string
    if b
        return "T"
    "F"

fn main()
    let m1 = st_metric("db", 53)
    print("m1=" + tf(m1 == "db;dur=53"))
    let m2 = st_metric_desc("cache", 1, "Cache Read")
    print("m2=" + tf(m2 == "cache;dur=1;desc=" + chr(34) + "Cache Read" + chr(34)))
    let m3 = st_name("miss")
    print("m3=" + tf(m3 == "miss"))
    let hdr = st_header([m1, m2, m3])
    print("hdr=" + tf(hdr == "db;dur=53, cache;dur=1;desc=" + chr(34) + "Cache Read" + chr(34) + ", miss"))
    print("empty=" + tf(st_header([]) == ""))
    print("single=" + tf(st_header([m1]) == "db;dur=53"))
