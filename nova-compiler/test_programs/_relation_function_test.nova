import std/relation/relation_function

fn cki(label, got, want)
    if got != want
        print("FAIL _relation_function_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    if got != want
        print("FAIL _relation_function_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(label, got, want)
    if len(got) != len(want)
        print("FAIL _relation_function_test " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL _relation_function_test " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn ckm(label, A, B, n)
    let i = 0
    while i < n
        let j = 0
        while j < n
            if A[i][j] != B[i][j]
                print("FAIL _relation_function_test " + label + " at [" + str(i) + "][" + str(j) + "]: got=" + str(A[i][j]) + " want=" + str(B[i][j]))
                exit(1)
            j = j + 1
        i = i + 1

fn main()
    // ==========================================================================
    // KAT 1: Permutation 0->1, 1->2, 2->0 on n=3.
    // Matrix: M[0][1]=1, M[1][2]=1, M[2][0]=1
    // ==========================================================================
    let pr0 = []
    push(pr0, 0)
    push(pr0, 1)
    push(pr0, 0)
    let pr1 = []
    push(pr1, 0)
    push(pr1, 0)
    push(pr1, 1)
    let pr2 = []
    push(pr2, 1)
    push(pr2, 0)
    push(pr2, 0)
    let perm = []
    push(perm, pr0)
    push(perm, pr1)
    push(perm, pr2)

    cki("perm_is_function", rfn_is_function(perm, 3), 1)
    cki("perm_is_total", rfn_is_total_function(perm, 3), 1)
    cki("perm_is_injective", rfn_is_injective(perm, 3), 1)
    cki("perm_is_surjective", rfn_is_surjective(perm, 3), 1)
    cki("perm_is_bijective", rfn_is_bijective(perm, 3), 1)
    cki("perm_apply_0", rfn_apply(perm, 0), 1)
    cki("perm_apply_1", rfn_apply(perm, 1), 2)
    cki("perm_apply_2", rfn_apply(perm, 2), 0)

    // Inverse of the permutation: 0->2, 1->0, 2->1 (rotate other direction)
    let inv = rfn_inverse(perm, 3)
    cki("perm_inv_apply_0", rfn_apply(inv, 0), 2)
    cki("perm_inv_apply_1", rfn_apply(inv, 1), 0)
    cki("perm_inv_apply_2", rfn_apply(inv, 2), 1)
    // inverse of a bijection is bijective
    cki("perm_inv_is_bijective", rfn_is_bijective(inv, 3), 1)

    // ==========================================================================
    // KAT 2: Non-injective function: 0->0, 1->0 on n=2.
    // M[0][0]=1, M[1][0]=1
    // ==========================================================================
    let f0 = []
    push(f0, 1)
    push(f0, 0)
    let f1 = []
    push(f1, 1)
    push(f1, 0)
    let fold = []
    push(fold, f0)
    push(fold, f1)

    cki("fold_is_function", rfn_is_function(fold, 2), 1)
    cki("fold_is_total", rfn_is_total_function(fold, 2), 1)
    cki("fold_is_injective", rfn_is_injective(fold, 2), 0)
    cki("fold_is_surjective", rfn_is_surjective(fold, 2), 0)
    cki("fold_is_bijective", rfn_is_bijective(fold, 2), 0)
    cki("fold_apply_0", rfn_apply(fold, 0), 0)
    cki("fold_apply_1", rfn_apply(fold, 1), 0)

    // ==========================================================================
    // KAT 3: Composition. A: 0->1, 1->2 on n=3 (partial: 2 has no image).
    //        B: 1->0, 2->0 on n=3 (partial: 0 has no image).
    //        B∘A: 0->0 (A maps 0->1, B maps 1->0), 1->0 (A maps 1->2, B maps 2->0).
    //        Element 2 in A has no image => not in result.
    // ==========================================================================
    let a0 = []
    push(a0, 0)
    push(a0, 1)
    push(a0, 0)
    let a1 = []
    push(a1, 0)
    push(a1, 0)
    push(a1, 1)
    let a2 = []
    push(a2, 0)
    push(a2, 0)
    push(a2, 0)
    let A = []
    push(A, a0)
    push(A, a1)
    push(A, a2)

    let b0 = []
    push(b0, 0)
    push(b0, 0)
    push(b0, 0)
    let b1 = []
    push(b1, 1)
    push(b1, 0)
    push(b1, 0)
    let b2 = []
    push(b2, 1)
    push(b2, 0)
    push(b2, 0)
    let B = []
    push(B, b0)
    push(B, b1)
    push(B, b2)

    let comp = rfn_compose(A, B, 3)
    // comp[0][0]=1 (0->1->0), comp[1][0]=1 (1->2->0), comp[2][j]=0 (2->nothing)
    cki("comp_0_0", comp[0][0], 1)
    cki("comp_0_1", comp[0][1], 0)
    cki("comp_1_0", comp[1][0], 1)
    cki("comp_1_1", comp[1][1], 0)
    cki("comp_2_0", comp[2][0], 0)
    cki("comp_apply_0", rfn_apply(comp, 0), 0)
    cki("comp_apply_1", rfn_apply(comp, 1), 0)
    cki("comp_apply_2", rfn_apply(comp, 2), -1)

    // ==========================================================================
    // KAT 4: Partial function (not total) — element 1 has no image.
    // M: 0->0, 2->2 on n=3. M[0][0]=1, M[2][2]=1.
    // ==========================================================================
    let pf0 = []
    push(pf0, 1)
    push(pf0, 0)
    push(pf0, 0)
    let pf1 = []
    push(pf1, 0)
    push(pf1, 0)
    push(pf1, 0)
    let pf2 = []
    push(pf2, 0)
    push(pf2, 0)
    push(pf2, 1)
    let partial = []
    push(partial, pf0)
    push(partial, pf1)
    push(partial, pf2)

    cki("partial_is_function", rfn_is_function(partial, 3), 1)
    cki("partial_is_total", rfn_is_total_function(partial, 3), 0)
    cki("partial_apply_0", rfn_apply(partial, 0), 0)
    cki("partial_apply_1", rfn_apply(partial, 1), -1)
    cki("partial_apply_2", rfn_apply(partial, 2), 2)

    // ==========================================================================
    // KAT 5: Not a function — element 0 maps to both 0 and 1.
    // ==========================================================================
    let mf0 = []
    push(mf0, 1)
    push(mf0, 1)
    let mf1 = []
    push(mf1, 0)
    push(mf1, 1)
    let multi = []
    push(multi, mf0)
    push(multi, mf1)

    cki("multi_is_function", rfn_is_function(multi, 2), 0)
    // rfn_apply returns -1 for multi-image
    cki("multi_apply_0", rfn_apply(multi, 0), -1)

    // ==========================================================================
    // KAT 6: n=0 edge cases
    // ==========================================================================
    let empty = []
    cki("n0_is_function", rfn_is_function(empty, 0), 1)
    cki("n0_is_total", rfn_is_total_function(empty, 0), 1)
    cki("n0_is_injective", rfn_is_injective(empty, 0), 1)
    cki("n0_is_surjective", rfn_is_surjective(empty, 0), 1)
    cki("n0_is_bijective", rfn_is_bijective(empty, 0), 1)

    print("PASS _relation_function_test")
