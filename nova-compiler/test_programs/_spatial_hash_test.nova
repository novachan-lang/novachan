import std/game2d/spatial_hash

// cki: check integer/bool equality; exit 1 on mismatch.
fn cki(label: string, got: int, want: int) -> any
    if got != want
        print("FAIL spatial_hash " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)
    0

// cks: check string equality; exit 1 on mismatch.
fn cks(label: string, got: string, want: string) -> any
    if got != want
        print("FAIL spatial_hash " + label + ": got=" + got + " want=" + want)
        exit(1)
    0

// has_id: true if id appears in the ids list.
fn has_id(ids: list, target: string) -> bool
    let found = false
    let i = 0
    let n = len(ids)
    while i < n
        if ids[i] == target
            found = true
        i = i + 1
    found

fn main()
    // === KAT 1: sh_cell_coords ===
    // sh_cell_coords(10.0, 25.0, 5.0) -> [2, 0]
    let cc = sh_cell_coords(10.0, 25.0, 5.0)
    cki("cell_coords_x", cc[0], 2)
    cki("cell_coords_y", cc[1], 0)

    // sh_cell_coords(10.0, 0.0, 0.0) -> [0, 0]
    let cc2 = sh_cell_coords(10.0, 0.0, 0.0)
    cki("cell_coords_origin_x", cc2[0], 0)
    cki("cell_coords_origin_y", cc2[1], 0)

    // === KAT 2: sh_cell_key ===
    let sh_k = sh_new(10.0)
    let key1 = sh_cell_key(sh_k, 5.0, 5.0)
    cks("cell_key_0_0", key1, "0,0")
    let key2 = sh_cell_key(sh_k, 15.0, 5.0)
    cks("cell_key_1_0", key2, "1,0")

    // === KAT 3: insert and query_point ===
    // a at (5,5) -> cell (0,0); b at (15,5) -> cell (1,0); c at (6,6) -> cell (0,0)
    let sh = sh_new(10.0)
    sh_insert(sh, "a", 5.0, 5.0)
    sh_insert(sh, "b", 15.0, 5.0)
    sh_insert(sh, "c", 6.0, 6.0)

    // query_point at (5,5) = cell (0,0): should have 'a' and 'c' but NOT 'b'
    let q1 = sh_query_point(sh, 5.0, 5.0)
    if not has_id(q1, "a")
        print("FAIL spatial_hash query_point(0,0) missing a")
        exit(1)
    if not has_id(q1, "c")
        print("FAIL spatial_hash query_point(0,0) missing c")
        exit(1)
    if has_id(q1, "b")
        print("FAIL spatial_hash query_point(0,0) should not have b")
        exit(1)

    // query_point at (15,5) = cell (1,0): should have 'b' only
    let q2 = sh_query_point(sh, 15.0, 5.0)
    if not has_id(q2, "b")
        print("FAIL spatial_hash query_point(1,0) missing b")
        exit(1)
    if has_id(q2, "a")
        print("FAIL spatial_hash query_point(1,0) should not have a")
        exit(1)

    // === KAT 4: query_box ===
    // [0,0,10,10] spans x0..10 / y0..10 -> cells (0,0) and (1,0) (since 10/10=1)
    // cell(0,0)={a,c}, cell(1,0)={b} -> combined {a,b,c}
    let box1 = []
    push(box1, 0)
    push(box1, 0)
    push(box1, 10)
    push(box1, 10)
    let qb1 = sh_query_box(sh, box1)
    if not has_id(qb1, "a")
        print("FAIL spatial_hash query_box missing a")
        exit(1)
    if not has_id(qb1, "c")
        print("FAIL spatial_hash query_box missing c")
        exit(1)
    // Box [0,0,10,10]: x goes from 0 to 10, cell 1,0 is at x=10..20. floor(10/10)=1 so cell 1,0 IS included.
    // That means 'b' is included too.
    // This is correct: the box spans to x=10 which is the start of cell (1,0).

    // === KAT 5: sh_neighbors ===
    // neighbors of (5,5) = 3x3 around cell (0,0) = cells (-1,-1),(-1,0),(-1,1),(0,-1),(0,0),(0,1),(1,-1),(1,0),(1,1)
    // only (0,0) and (1,0) have data -> {a,c,b}
    let nb = sh_neighbors(sh, 5.0, 5.0)
    if not has_id(nb, "a")
        print("FAIL spatial_hash neighbors missing a")
        exit(1)
    if not has_id(nb, "c")
        print("FAIL spatial_hash neighbors missing c")
        exit(1)
    if not has_id(nb, "b")
        print("FAIL spatial_hash neighbors missing b (cell 1,0 is within 3x3)")
        exit(1)

    // === KAT 6: sh_remove ===
    // Remove 'a' from (5,5); query_point should no longer have 'a' but still have 'c'
    sh_remove(sh, "a", 5.0, 5.0)
    let q3 = sh_query_point(sh, 5.0, 5.0)
    if has_id(q3, "a")
        print("FAIL spatial_hash after remove 'a' still present")
        exit(1)
    if not has_id(q3, "c")
        print("FAIL spatial_hash after remove 'c' should still be present")
        exit(1)

    // === KAT 7: sh_insert_box ===
    let sh2 = sh_new(10.0)
    // Insert box covering [5,5,20,10] -> spans x=5..25 (cells 0,1,2) y=5..15 (cells 0,1)
    let bigbox = []
    push(bigbox, 5)
    push(bigbox, 5)
    push(bigbox, 20)
    push(bigbox, 10)
    sh_insert_box(sh2, "big", bigbox)
    // cell (0,0) should have 'big'
    let qb2 = sh_query_point(sh2, 5.0, 5.0)
    if not has_id(qb2, "big")
        print("FAIL spatial_hash insert_box missing big in cell(0,0)")
        exit(1)
    // cell (2,1) should also have 'big' (x=25/10=2, y=15/10=1)
    let qb3 = sh_query_point(sh2, 25.0, 15.0)
    if not has_id(qb3, "big")
        print("FAIL spatial_hash insert_box missing big in cell(2,1)")
        exit(1)

    // === KAT 8: sh_clear ===
    sh_clear(sh)
    let q4 = sh_query_point(sh, 5.0, 5.0)
    cki("after_clear_empty", len(q4), 0)

    // === KAT 9: deduplication in query_box ===
    // Insert same id 'x' into overlapping cells via two inserts
    let sh3 = sh_new(10.0)
    sh_insert(sh3, "x", 5.0, 5.0)
    sh_insert(sh3, "x", 6.0, 6.0)
    // Both in cell (0,0); query_box should return 'x' deduplicated (only once? No —
    // dedup is by string key str(id); two separate inserts of "x" should dedup to 1)
    let dbox = []
    push(dbox, 0)
    push(dbox, 0)
    push(dbox, 10)
    push(dbox, 10)
    let qddup = sh_query_box(sh3, dbox)
    // Count occurrences of "x"
    let cnt = 0
    let di = 0
    while di < len(qddup)
        if qddup[di] == "x"
            cnt = cnt + 1
        di = di + 1
    cki("dedup_count", cnt, 1)

    print("PASS _spatial_hash_test")

main()
