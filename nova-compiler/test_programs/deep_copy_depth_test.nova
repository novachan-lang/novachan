// iter-19: the deep_copy fiber guard is now calibrated to the real ~16MB fiber stack
// (was wrongly 64 for an assumed 32KB stack). A moderately-deep value now deep-copies
// fine on a green task; a pathological one is still a clean contained crash.

fn build_nested(depth)
    let v = [0]
    let i = 0
    while i < depth
        v = [v]
        i = i + 1
    v

fn deep_ok(ch, depth)
    let v = build_nested(depth)
    let w = copy(v)          // deep_copy on a green-task fiber (uses w so it can't be elided)
    send(ch, len(w))

fn deep_over(ch, depth)
    let v = build_nested(depth)
    let w = copy(v)          // > the 4096 fiber ceiling -> guard panics (contained)
    send(ch, len(w))

fn main()
    let ch = channel()
    let _t = spawn deep_ok(ch, 1000)        // 1000 > old limit 64, < new 4096 -> succeeds
    let r = receive(ch)
    assert(r == 1, "1000-deep deep_copy on a green task must succeed, got " + str(r))

    let sink = channel()
    let bad = spawn deep_over(sink, 50000)  // 50000 > 4096 -> contained crash
    let st = receive(monitor(bad))
    assert(st != 0, "50000-deep deep_copy must be a contained crash, got " + str(st))

    print("deep_copy_depth_test: 1000-deep OK, 50000-deep contained")
