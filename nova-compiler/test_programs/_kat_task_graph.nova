import forge_task_graph

fn main()
    let t = tg_new()
    t = tg_add_task(t, "compile", 10)
    t = tg_add_task(t, "link", 5)
    t = tg_add_task(t, "test", 8)
    assert(tg_task_count(t) == 3, "3 tasks")

    t = tg_add_edge(t, "compile", "link")
    t = tg_add_edge(t, "link", "test")
    assert(tg_edge_count(t) == 2, "2 edges")

    let w = tg_task_weight(t, "compile")
    assert(is_ok(w), "weight ok")
    assert(unwrap(w) == 10, "compile=10")

    assert(tg_has_dependency(t, "compile", "link") == 1, "compile->link")
    assert(tg_has_dependency(t, "test", "compile") == 0, "no test->compile")

    assert(tg_total_weight(t) == 23, "total=23")

    let bad = tg_task_weight(t, "nope")
    assert(is_err(bad), "not found")

    print("TASK-GRAPH KAT PASS")
