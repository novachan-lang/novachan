import forge_rational

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // construction + reduction + sign normalization
    fails = fails + expect("rat_2_4", rat_to_str(rat(2, 4)), "1/2")
    fails = fails + expect("rat_6_3", rat_to_str(rat(6, 3)), "2")
    fails = fails + expect("rat_neg", rat_to_str(rat(0 - 2, 4)), "-1/2")
    fails = fails + expect("rat_negden", rat_to_str(rat(2, 0 - 4)), "-1/2")
    fails = fails + expect("rat_zero", rat_to_str(rat(0, 5)), "0")

    // exact arithmetic that floats get wrong
    fails = fails + expect("add_third_sixth", rat_to_str(rat_add(rat(1, 3), rat(1, 6))), "1/2")
    fails = fails + expect("add_tenth", rat_to_str(rat_add(rat(1, 10), rat(2, 10))), "3/10")
    fails = fails + expect("add_to_one", rat_to_str(rat_add(rat(1, 2), rat(1, 2))), "1")
    fails = fails + expect("sub", rat_to_str(rat_sub(rat(3, 4), rat(1, 4))), "1/2")
    fails = fails + expect("mul", rat_to_str(rat_mul(rat(2, 3), rat(3, 4))), "1/2")
    fails = fails + expect("div", rat_to_str(rat_div(rat(1, 2), rat(3, 4))), "2/3")

    // 1/2 + 1/3 + 1/6 == 1 exactly
    let s = rat_add(rat_add(rat(1, 2), rat(1, 3)), rat(1, 6))
    fails = fails + expect("three_sum", rat_to_str(s), "1")

    // neg / abs / recip
    fails = fails + expect("neg", rat_to_str(rat_neg(rat(1, 2))), "-1/2")
    fails = fails + expect("abs", rat_to_str(rat_abs(rat(0 - 3, 4))), "3/4")
    fails = fails + expect("recip", rat_to_str(rat_recip(rat(2, 3))), "3/2")

    // comparison
    fails = fails + expect("cmp_lt", str(rat_cmp(rat(1, 3), rat(1, 2))), "-1")
    fails = fails + expect("cmp_eq", str(rat_cmp(rat(2, 4), rat(1, 2))), "0")
    fails = fails + expect("cmp_gt", str(rat_cmp(rat(3, 4), rat(1, 2))), "1")
    fails = fails + expect("eq_true", str(rat_eq(rat(2, 4), rat(1, 2))), "true")
    fails = fails + expect("eq_false", str(rat_eq(rat(1, 3), rat(1, 2))), "false")

    // accessors
    fails = fails + expect("num", str(rat_num(rat(3, 6))), "1")
    fails = fails + expect("den", str(rat_den(rat(3, 6))), "2")

    // harmonic sum 1 + 1/2 + 1/3 + 1/4 = 25/12
    let h = rat_add(rat_add(rat_add(rat(1, 1), rat(1, 2)), rat(1, 3)), rat(1, 4))
    fails = fails + expect("harmonic", rat_to_str(h), "25/12")

    if fails == 0
        print("forge_rational: all passed")
    else
        print("forge_rational: " + str(fails) + " FAILED")
