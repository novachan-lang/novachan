import std/hash/hashcombine

fn main()
    // --- h_combine_boost(0, 0) ---
    // seed=0: mixed = 0 + 0x9E3779B9 + 0 + 0 = 2654435769; result = 0 ^ 2654435769
    let want_cb00 = 2654435769
    let got_cb00 = h_combine_boost(0, 0)
    if got_cb00 != want_cb00
        print("FAIL hashcombine h_combine_boost(0,0): got "+str(got_cb00)+" want "+str(want_cb00))
        exit(1)

    // --- h_hash_range_boost([1,2,3]) deterministic anchor ---
    let lst123 = []
    push(lst123, 1)
    push(lst123, 2)
    push(lst123, 3)
    let want_r123 = 11093822460243
    let got_r123 = h_hash_range_boost(lst123)
    if got_r123 != want_r123
        print("FAIL hashcombine h_hash_range_boost([1,2,3]): got "+str(got_r123)+" want "+str(want_r123))
        exit(1)

    // --- order matters: [1,2] != [2,1] ---
    let lst12 = []
    push(lst12, 1)
    push(lst12, 2)
    let lst21 = []
    push(lst21, 2)
    push(lst21, 1)
    let r12 = h_hash_range_boost(lst12)
    let r21 = h_hash_range_boost(lst21)
    if r12 == r21
        print("FAIL hashcombine order: h_hash_range_boost([1,2]) == h_hash_range_boost([2,1])")
        exit(1)

    // --- h_combine_fnv(0, 1) = FNV-64-prime ---
    let want_fnv01 = 1099511628211
    let got_fnv01 = h_combine_fnv(0, 1)
    if got_fnv01 != want_fnv01
        print("FAIL hashcombine h_combine_fnv(0,1): got "+str(got_fnv01)+" want "+str(want_fnv01))
        exit(1)

    // --- h_combine_fnv(42, 7): (42 XOR 7) * prime = 45 * 1099511628211 ---
    let want_fnv42_7 = 49478023269495
    let got_fnv42_7 = h_combine_fnv(42, 7)
    if got_fnv42_7 != want_fnv42_7
        print("FAIL hashcombine h_combine_fnv(42,7): got "+str(got_fnv42_7)+" want "+str(want_fnv42_7))
        exit(1)

    // --- h_mix64(0): splitmix64 anchor = -2152535657050944081 ---
    let want_mix0 = -2152535657050944081
    let got_mix0 = h_mix64(0)
    if got_mix0 != want_mix0
        print("FAIL hashcombine h_mix64(0): got "+str(got_mix0)+" want "+str(want_mix0))
        exit(1)

    // --- h_mix64(1): deterministic ---
    let want_mix1 = -7995527694508729151
    let got_mix1 = h_mix64(1)
    if got_mix1 != want_mix1
        print("FAIL hashcombine h_mix64(1): got "+str(got_mix1)+" want "+str(want_mix1))
        exit(1)

    // --- h_mix64 is deterministic: calling twice gives same result ---
    let mix0a = h_mix64(42)
    let mix0b = h_mix64(42)
    if mix0a != mix0b
        print("FAIL hashcombine h_mix64 not deterministic")
        exit(1)

    print("PASS _hashcombine_test")
