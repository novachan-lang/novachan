fn chan_fan_out(source, destinations)
  let val = receive(source)
  for dest in destinations
    send(dest, val)
  val

fn chan_merge(sources, output)
  for src in sources
    let val = receive(src)
    send(output, val)

fn chan_pipe(input, transform, output)
  let val = receive(input)
  let result = transform(val)
  send(output, result)
  result

fn chan_collect(ch, count)
  let result = []
  let i = 0
  while i < count
    push(result, receive(ch))
    i = i + 1
  result

fn chan_send_all(ch, items)
  for item in items
    send(ch, item)

fn _doubler(x)
  x * 2

fn main()
  let ch = channel()
  send(ch, 42)
  let val = receive(ch)
  assert(val == 42, "basic send/recv")

  let src = channel()
  let d1 = channel()
  let d2 = channel()
  send(src, 100)
  let _fo = chan_fan_out(src, [d1, d2])
  assert(receive(d1) == 100, "fan-out d1")
  assert(receive(d2) == 100, "fan-out d2")

  let s1 = channel()
  let s2 = channel()
  let out = channel()
  send(s1, "a")
  send(s2, "b")
  chan_merge([s1, s2], out)
  let merged = chan_collect(out, 2)
  assert(len(merged) == 2, "merge 2")

  let inp = channel()
  let outp = channel()
  send(inp, 21)
  let _p = chan_pipe(inp, fn(z) _doubler(z), outp)
  assert(receive(outp) == 42, "pipe transform")

  let bulk = channel()
  chan_send_all(bulk, [1, 2, 3])
  let all = chan_collect(bulk, 3)
  assert(len(all) == 3, "send_all + collect")
  assert(all[0] == 1, "first")
  assert(all[2] == 3, "last")

  print("chanx: all passed")
