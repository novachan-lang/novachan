import forge_sidecar

fn main()
    let sc = sc_new()
    sc = sc_add_handler(sc, "auth-check", "auth", 1)
    sc = sc_add_handler(sc, "logger", "logging", 2)
    sc = sc_add_handler(sc, "metrics", "metrics", 3)
    assert(sc_handler_count(sc) == 3, "3 handlers")

    let r1 = sc_process(sc, "/api/users", "GET")
    assert(r1["allowed"] == 1, "allowed")
    assert(r1["handlers_run"] == 3, "3 handlers ran")
    assert(sc_total_requests(sc) == 1, "1 request")

    let r2 = sc_process(sc, "/api/orders", "POST")
    assert(r2["allowed"] == 1, "r2 allowed")
    assert(sc_total_requests(sc) == 2, "2 requests")

    assert(sc_handler_invocations(sc, "auth-check") == 2, "auth invoked 2x")
    assert(sc_handler_invocations(sc, "logger") == 2, "logger invoked 2x")
    assert(sc_log_count(sc) == 6, "6 log entries")

    sc = sc_disable_handler(sc, "metrics")
    let r3 = sc_process(sc, "/health", "GET")
    assert(r3["handlers_run"] == 2, "2 handlers after disable")
    assert(sc_handler_invocations(sc, "metrics") == 2, "metrics stayed at 2")

    sc = sc_enable_handler(sc, "metrics")
    let r4 = sc_process(sc, "/test", "GET")
    assert(r4["handlers_run"] == 3, "3 again after enable")

    sc = sc_block(sc)
    sc = sc_block(sc)
    assert(sc_total_blocked(sc) == 2, "2 blocked")

    assert(sc_handler_invocations(sc, "nonexistent") == 0, "no handler = 0")

    print("SIDECAR KAT PASS")
