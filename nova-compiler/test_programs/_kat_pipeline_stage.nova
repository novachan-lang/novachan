import forge_pipeline_stage

fn main()
    let p = pipe_new()
    p = pipe_add_stage(p, "extract")
    p = pipe_add_stage(p, "transform")
    p = pipe_add_stage(p, "load")
    assert(pipe_stage_count(p) == 3, "3 stages")

    let r1 = pipe_process(p, 0)
    assert(is_ok(r1), "process 0 ok")
    p = unwrap(r1)
    let r2 = pipe_process(p, 0)
    assert(is_ok(r2), "process 0 again ok")
    p = unwrap(r2)
    let r3 = pipe_process(p, 1)
    assert(is_ok(r3), "process 1 ok")
    p = unwrap(r3)

    assert(pipe_total_processed(p) == 3, "3 processed")

    let sc = pipe_stage_count_at(p, 0)
    assert(is_ok(sc), "stage count ok")
    assert(unwrap(sc) == 2, "extract=2")

    let sn = pipe_stage_name(p, 1)
    assert(is_ok(sn), "name ok")
    assert(unwrap(sn) == "transform", "transform")

    let f1 = pipe_fail(p, 2)
    assert(is_ok(f1), "fail ok")
    p = unwrap(f1)
    assert(pipe_total_failed(p) == 1, "1 failed")

    let bad = pipe_process(p, 5)
    assert(is_err(bad), "out of range")

    print("PIPELINE-STAGE KAT PASS")
