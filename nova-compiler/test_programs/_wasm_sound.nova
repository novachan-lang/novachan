// WASM soundness/correctness sweep: f64 arithmetic, a math host-import (sqrt), the integer div/mod identity,
// and an out-of-bounds read. Each returns an int; wasm results must match native exactly (oob must be the sound
// 0-guard, not a wild read).
fn float_ok() -> int
    let c = 3.0 * 7.0 + 100.0 / 4.0
    if c == 46.0
        1
    else
        0
fn sqrt_ok() -> int
    let s = sqrt(144.0)
    if s == 12.0
        1
    else
        0
fn divmod_ok() -> int
    let a = 1000000007
    let b = 9973
    let q = a / b
    let r = a - q * b
    if a == q * b + r and r >= 0 and r < b
        1
    else
        0
fn oob_index() -> int
    let xs = [10, 20, 30]
    xs[100]
fn main()
    print(str(float_ok()) + " " + str(sqrt_ok()) + " " + str(divmod_ok()) + " " + str(oob_index()))
