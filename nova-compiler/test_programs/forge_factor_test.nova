import forge_factor as f

fn check(cond: bool, label: string)
    if cond == false
        print("FAIL: " + label)

fn prod(xs: list) -> int
    let p = 1
    for v in xs
        p = p * v
    return p

fn lcg(state: int) -> int
    (state * 1103515245 + 12345) % 2147483648

fn main()
    check(prod(f.factorize(12)) == 12, "prod 12")
    let f12 = f.factorize(12)
    check(len(f12) == 3 and f12[0] == 2 and f12[1] == 2 and f12[2] == 3, "12 = 2*2*3")
    let f100 = f.factorize(100)
    check(len(f100) == 4 and f100[0] == 2 and f100[3] == 5, "100 = 2*2*5*5")
    check(len(f.factorize(97)) == 1 and f.factorize(97)[0] == 97, "97 prime")
    check(len(f.factorize(1)) == 0, "1 -> empty")
    check(len(f.factorize(2)) == 1, "2 -> [2]")
    check(f.is_prime_big(561) == 0, "561 composite (Carmichael)")
    let f561 = f.factorize(561)
    check(len(f561) == 3 and f561[0] == 3 and f561[1] == 11 and f561[2] == 17, "561 = 3*11*17")
    check(f.is_prime_big(1000000007) == 1, "1e9+7 prime")
    let big = 1000000007 * 1000000009
    check(f.is_prime_big(big) == 0, "big semiprime composite")
    let fb = f.factorize(big)
    check(len(fb) == 2 and fb[0] == 1000000007 and fb[1] == 1000000009, "big semiprime split")
    let st = 12345
    let ok = 0
    let i = 0
    while i < 60
        st = lcg(st)
        let n = 2 + (st % 5000000)
        let fs = f.factorize(n)
        let allprime = 1
        for pf in fs
            if f.is_prime_big(pf) == 0
                allprime = 0
        if prod(fs) == n and allprime == 1
            ok = ok + 1
        i = i + 1
    check(ok == 60, "60 random: product==n & all-prime (got " + str(ok) + ")")
    print("forge_factor: KAT done")
