fn rate_limiter(max_tokens, refill_rate_ms)
  let state = {}
  state["tokens"] = max_tokens
  state["max"] = max_tokens
  state["refill_ms"] = refill_rate_ms
  state["last_refill"] = time_ms()
  state

fn rate_refill(limiter)
  let now = time_ms()
  let elapsed = now - limiter["last_refill"]
  let refill_ms = limiter["refill_ms"]
  if elapsed >= refill_ms and refill_ms > 0
    let new_tokens = elapsed / refill_ms
    let current = limiter["tokens"]
    let max_t = limiter["max"]
    let updated = current + new_tokens
    if updated > max_t
      updated = max_t
    limiter["tokens"] = updated
    limiter["last_refill"] = now

fn rate_allow(limiter)
  rate_refill(limiter)
  if limiter["tokens"] > 0
    limiter["tokens"] = limiter["tokens"] - 1
    return 1
  0

fn rate_remaining(limiter)
  rate_refill(limiter)
  limiter["tokens"]

fn rate_reset(limiter)
  limiter["tokens"] = limiter["max"]
  limiter["last_refill"] = time_ms()

fn sliding_window(window_ms)
  let state = {}
  state["window_ms"] = window_ms
  state["timestamps"] = []
  state

fn sw_record(window)
  let now = time_ms()
  push(window["timestamps"], now)
  let cutoff = now - window["window_ms"]
  let ts = window["timestamps"]
  let new_ts = []
  for t in ts
    if t >= cutoff
      push(new_ts, t)
  window["timestamps"] = new_ts

fn sw_count(window)
  let now = time_ms()
  let cutoff = now - window["window_ms"]
  let ts = window["timestamps"]
  let count = 0
  for t in ts
    if t >= cutoff
      count = count + 1
  count

fn sw_allow(window, max_count)
  sw_record(window)
  sw_count(window) <= max_count

fn main()
  let rl = rate_limiter(3, 1000)
  assert(rate_remaining(rl) == 3, "initial tokens")
  assert(rate_allow(rl) == 1, "allow 1")
  assert(rate_allow(rl) == 1, "allow 2")
  assert(rate_allow(rl) == 1, "allow 3")
  assert(rate_allow(rl) == 0, "deny 4 (exhausted)")
  assert(rate_remaining(rl) == 0, "zero remaining")

  rate_reset(rl)
  assert(rate_remaining(rl) == 3, "reset to max")

  let sw = sliding_window(10000)
  assert(sw_allow(sw, 5) == 1, "sw allow 1")
  assert(sw_allow(sw, 5) == 1, "sw allow 2")
  assert(sw_count(sw) == 2, "sw count 2")

  print("ratex: all passed")
