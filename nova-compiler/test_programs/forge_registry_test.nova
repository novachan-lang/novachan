// Forge T4.14: a serialized name->pid registry. put/get by name; absent or dropped -> 0. Socketless.
import forge_otp

fn main()
    let reg = registry()
    reg_put(reg, "alice", 100)
    reg_put(reg, "bob", 200)
    let a = reg_get(reg, "alice")
    let b = reg_get(reg, "bob")
    let absent = reg_get(reg, "carol")
    if a != 100 or b != 200 or absent != 0
        print("FAIL: a=" + str(a) + " b=" + str(b) + " absent=" + str(absent))
        exit(1)
    reg_drop(reg, "alice")
    let a2 = reg_get(reg, "alice")
    if a2 != 0
        print("FAIL: dropped alice should be 0, got " + str(a2))
        exit(1)
    print("PASS forge_registry (alice=100 bob=200; absent=0; drop alice -> 0)")
