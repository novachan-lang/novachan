// _haversine_test.nova — KAT for std/geo/haversine
import std/geo/haversine

fn approx(a, b, tol)
    let d = a - b
    let ad = d
    if d < 0.0
        ad = 0.0 - d
    let r = ad < tol
    r

fn check(label, got, expected, tol)
    let d = got - expected
    let ad = d
    if d < 0.0
        ad = 0.0 - d
    if ad > tol
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn main()
    // Same point -> 0 distance
    let h0 = haversine(0.0, 0.0, 0.0, 0.0)
    check("haversine same-point", h0, 0.0, 0.01)

    // 1 degree longitude at equator -> ~111195 m
    let h1 = haversine(0.0, 0.0, 0.0, 1.0)
    check("haversine equator-1deg", h1, 111195.0, 200.0)

    // London (51.5074, -0.1278) -> Paris (48.8566, 2.3522) ~343 km
    let hlp = haversine(51.5074, -0.1278, 48.8566, 2.3522)
    check("haversine London-Paris", hlp, 343000.0, 5000.0)

    print("PASS _haversine_test")
