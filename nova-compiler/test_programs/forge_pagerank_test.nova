import forge_pagerank

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn near(a: float, b: float) -> bool
    let d = a - b
    d > -0.01 and d < 0.01

fn ranksum(r) -> float
    let s = 0.0
    let ks = keys(r)
    let i = 0
    while i < len(ks)
        s = s + r[ks[i]] * 1.0
        i = i + 1
    s

fn main()
    let fails = 0

    // symmetric cycle a->b->c->a : all equal ~0.333
    let cyc = [["a", "b"], ["b", "c"], ["c", "a"]]
    let rc = pagerank(cyc, 0.85, 40)
    fails = fails + expect_true("cyc_a", near(rc["a"], 0.33333))
    fails = fails + expect_true("cyc_b", near(rc["b"], 0.33333))
    fails = fails + expect_true("cyc_sum", near(ranksum(rc), 1.0))

    // hub: a->c, b->c, c->a. c has 2 incoming, should rank highest
    let hub = [["a", "c"], ["b", "c"], ["c", "a"]]
    let rh = pagerank(hub, 0.85, 40)
    fails = fails + expect_true("hub_top", rh["c"] > rh["a"] and rh["c"] > rh["b"])
    fails = fails + expect("hub_topfn", pagerank_top(hub, 0.85, 40), "c")
    fails = fails + expect_true("hub_sum", near(ranksum(rh), 1.0))

    // authority chain: everyone links to "star"
    let star = [["a", "star"], ["b", "star"], ["c", "star"], ["d", "star"]]
    let rs = pagerank(star, 0.85, 40)
    fails = fails + expect("star_top", pagerank_top(star, 0.85, 40), "star")
    fails = fails + expect_true("star_sum", near(ranksum(rs), 1.0))
    // star has no out-links (dangling) but still highest rank, and no rank leaks (sum=1)
    fails = fails + expect_true("star_highest", rs["star"] > rs["a"])

    // importance flows: quality matters. a<->b tight pair, c points to a
    // a->b, b->a, c->a : a gets link from b (which is high) AND c -> a highest
    let flow = [["a", "b"], ["b", "a"], ["c", "a"]]
    let rf = pagerank(flow, 0.85, 40)
    fails = fails + expect_true("flow_a_top", rf["a"] >= rf["b"] and rf["a"] > rf["c"])
    fails = fails + expect_true("flow_sum", near(ranksum(rf), 1.0))

    // empty graph
    let re = pagerank([], 0.85, 10)
    fails = fails + expect("empty", str(len(keys(re))), "0")

    if fails == 0
        print("forge_pagerank: all passed")
    else
        print("forge_pagerank: " + str(fails) + " FAILED")
