import std/statistics/stat_mode

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + " got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckf(label: string, got: float, want: float)
    let d = got - want
    if d < 0.0
        d = 0.0 - d
    if d > 0.0001
        print("FAIL " + label + " got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // smo_mode: most frequent; smallest on tie
    let xs1 = [1, 2, 2, 3, 3, 3]
    cki("mode_3", smo_mode(xs1), 3)

    let xs2 = [1, 1, 2, 2]
    cki("mode_tie_1", smo_mode(xs2), 1)

    // smo_modes: all values tied for most frequent, ascending
    let xs3 = [1, 1, 2, 2, 3]
    let modes3 = smo_modes(xs3)
    cki("modes3_len", len(modes3), 2)
    cki("modes3_0", modes3[0], 1)
    cki("modes3_1", modes3[1], 2)

    // single mode not in result (3 appears once, 1 and 2 appear twice)
    let xs4 = [1, 2, 2, 3]
    let modes4 = smo_modes(xs4)
    cki("modes4_len", len(modes4), 1)
    cki("modes4_0", modes4[0], 2)

    // smo_frequency: [value, count] pairs ascending by value
    let xs5 = [1, 2, 2]
    let freq5 = smo_frequency(xs5)
    cki("freq5_len", len(freq5), 2)
    let pair0 = freq5[0]
    let pair1 = freq5[1]
    cki("freq5_0_val", pair0[0], 1)
    cki("freq5_0_cnt", pair0[1], 1)
    cki("freq5_1_val", pair1[0], 2)
    cki("freq5_1_cnt", pair1[1], 2)

    // smo_is_multimodal
    let xs6 = [1, 1, 2, 2]
    cki("multimodal_true", smo_is_multimodal(xs6), 1)

    let xs7 = [1, 2, 2, 3]
    cki("multimodal_false", smo_is_multimodal(xs7), 0)

    // edge: single-element
    let xs8 = [7]
    cki("mode_single", smo_mode(xs8), 7)

    // edge: all distinct
    let xs9 = [3, 1, 2]
    cki("mode_all_distinct", smo_mode(xs9), 1)

    // edge: empty mode returns 0
    let empty = []
    cki("mode_empty", smo_mode(empty), 0)
    cki("modes_empty_len", len(smo_modes(empty)), 0)
    cki("freq_empty_len", len(smo_frequency(empty)), 0)
    cki("multimodal_empty", smo_is_multimodal(empty), 0)

    print("PASS _stat_mode_test")
