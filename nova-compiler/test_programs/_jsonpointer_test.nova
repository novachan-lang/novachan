// KAT probe for std/data/jsonpointer — RFC-6901 JSON Pointer
// All answers hand-computed from the JSON string:
//   {"a":{"b":[10,20,30]},"x":"hi","p~q":5}
import std/data/jsonpointer

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // Build JSON string using chr(34) for double-quotes to avoid interpolation.
    let q = chr(34)
    let lb = chr(123)
    let rb = chr(125)
    // JSON: {"a":{"b":[10,20,30]},"x":"hi","p~q":5}
    let json_str = lb + q + "a" + q + ":" + lb + q + "b" + q + ":[10,20,30]" + rb + "," + q + "x" + q + ":" + q + "hi" + q + "," + q + "p~q" + q + ":5" + rb
    let root = json_parse(json_str)

    // KAT 1: jp_get(root, "/a/b/1") == 20 (int)
    let v1 = jp_get(root, "/a/b/1")
    cki("kat1-a-b-1", v1, 20)
    print("KAT 1 PASS: jp_get('/a/b/1') == 20")

    // KAT 2: jp_get(root, "/a/b/0") == 10 (int)
    let v2 = jp_get(root, "/a/b/0")
    cki("kat2-a-b-0", v2, 10)
    print("KAT 2 PASS: jp_get('/a/b/0') == 10")

    // KAT 3: jp_get(root, "/x") == "hi" (string)
    let v3 = jp_get(root, "/x")
    cks("kat3-x", v3, "hi")
    print("KAT 3 PASS: jp_get('/x') == 'hi'")

    // KAT 4: jp_exists(root, "/a/b/2") == true  (index 2 = 30, in bounds)
    let e4 = jp_exists(root, "/a/b/2")
    ckb("kat4-exists-a-b-2", e4, true)
    print("KAT 4 PASS: jp_exists('/a/b/2') == true")

    // KAT 5: jp_exists(root, "/a/z") == false  (key 'z' absent)
    let e5 = jp_exists(root, "/a/z")
    ckb("kat5-notexists-a-z", e5, false)
    print("KAT 5 PASS: jp_exists('/a/z') == false")

    // KAT 6: jp_get(root, "") -> the whole root (assert type_of == "dict")
    // NOTE: is_dict() is a compile-time predicate; use type_of() for any-typed values.
    let v6 = jp_get(root, "")
    cks("kat6-root-is-dict", type_of(v6), "dict")
    print("KAT 6 PASS: jp_get('') returns root dict")

    // KAT 7: jp_get(root, "/p~0q") == 5  (token "p~0q" -> "p~q" after unescape)
    let v7 = jp_get(root, "/p~0q")
    cki("kat7-tilde-escape", v7, 5)
    print("KAT 7 PASS: jp_get('/p~0q') == 5 (tilde escape)")

    // KAT 8: jp_get(root, "/a/b/9") == null  (out of bounds)
    let v8 = jp_get(root, "/a/b/9")
    ckb("kat8-oob", v8 == null, true)
    print("KAT 8 PASS: jp_get('/a/b/9') == null (out of bounds)")

    // KAT 9: jp_get(root, "/a/b/2") == 30  (last element of array)
    let v9 = jp_get(root, "/a/b/2")
    cki("kat9-a-b-2", v9, 30)
    print("KAT 9 PASS: jp_get('/a/b/2') == 30")

    // KAT 10: jp_exists(root, "/a/b") == true  (the array itself exists)
    let e10 = jp_exists(root, "/a/b")
    ckb("kat10-exists-a-b", e10, true)
    print("KAT 10 PASS: jp_exists('/a/b') == true (array node)")

    print("_jsonpointer_test passed")
