// KAT for std/bits/bitreverse — bit-order and byte-order reversal.
// All expected values hand-computed and cross-checked.
import std/bits/bitreverse

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL bitreverse " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL bitreverse " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn main()
    // --- rev_reverse_bits ---
    // 1 in 8 bits = 0b00000001 -> reversed = 0b10000000 = 128
    cki("rev_reverse_bits(1,8)", rev_reverse_bits(1, 8), 128)
    // 180 = 0b10110100 -> reversed = 0b00101101 = 45
    cki("rev_reverse_bits(180,8)", rev_reverse_bits(180, 8), 45)
    // 1 in 16 bits -> reversed = bit 15 = 32768
    cki("rev_reverse_bits(1,16)", rev_reverse_bits(1, 16), 32768)
    // 0 in 8 bits -> 0
    cki("rev_reverse_bits(0,8)", rev_reverse_bits(0, 8), 0)
    // 0xFF in 8 bits -> 0xFF (palindrome of all ones)
    cki("rev_reverse_bits(255,8)", rev_reverse_bits(255, 8), 255)
    // 1 in 1 bit -> 1 (width=1, only bit 0, reversed is still bit 0)
    cki("rev_reverse_bits(1,1)", rev_reverse_bits(1, 1), 1)
    // 0b1000 in 4 bits = 8 -> reversed = 0b0001 = 1
    cki("rev_reverse_bits(8,4)", rev_reverse_bits(8, 4), 1)
    // 0b1010 in 4 bits = 10 -> reversed = 0b0101 = 5
    cki("rev_reverse_bits(10,4)", rev_reverse_bits(10, 4), 5)

    // --- rev_byteswap16 ---
    // 0x1234 -> 0x3412 = 13330
    cki("rev_byteswap16(0x1234)", rev_byteswap16(0x1234), 0x3412)
    // 0xABCD -> 0xCDAB
    cki("rev_byteswap16(0xABCD)", rev_byteswap16(0xABCD), 0xCDAB)
    // 0x0000 -> 0x0000
    cki("rev_byteswap16(0)", rev_byteswap16(0), 0)
    // 0xFFFF -> 0xFFFF
    cki("rev_byteswap16(0xFFFF)", rev_byteswap16(0xFFFF), 0xFFFF)
    // 0x0100 -> 0x0001
    cki("rev_byteswap16(0x0100)", rev_byteswap16(0x0100), 1)

    // --- rev_byteswap32 ---
    // 0x12345678 -> 0x78563412
    cki("rev_byteswap32(0x12345678)", rev_byteswap32(0x12345678), 0x78563412)
    // 0 -> 0
    cki("rev_byteswap32(0)", rev_byteswap32(0), 0)
    // 0x00000001 -> 0x01000000
    cki("rev_byteswap32(1)", rev_byteswap32(1), 0x01000000)
    // 0xFF000000 -> 0x000000FF = 255
    cki("rev_byteswap32(0xFF000000)", rev_byteswap32(0xFF000000), 255)
    // 0x01020304 -> 0x04030201
    cki("rev_byteswap32(0x01020304)", rev_byteswap32(0x01020304), 0x04030201)

    // --- rev_nibbleswap8 ---
    // 0x12 -> 0x21
    cki("rev_nibbleswap8(0x12)", rev_nibbleswap8(0x12), 0x21)
    // 0xAB -> 0xBA
    cki("rev_nibbleswap8(0xAB)", rev_nibbleswap8(0xAB), 0xBA)
    // 0x00 -> 0x00
    cki("rev_nibbleswap8(0)", rev_nibbleswap8(0), 0)
    // 0xFF -> 0xFF
    cki("rev_nibbleswap8(0xFF)", rev_nibbleswap8(0xFF), 0xFF)
    // 0x0F -> 0xF0 = 240
    cki("rev_nibbleswap8(0x0F)", rev_nibbleswap8(0x0F), 0xF0)

    // --- rev_reverse_byte ---
    // 128 = 0b10000000 -> 0b00000001 = 1
    cki("rev_reverse_byte(128)", rev_reverse_byte(128), 1)
    // 1 = 0b00000001 -> 0b10000000 = 128
    cki("rev_reverse_byte(1)", rev_reverse_byte(1), 128)
    // 0 -> 0
    cki("rev_reverse_byte(0)", rev_reverse_byte(0), 0)
    // 0xFF -> 0xFF
    cki("rev_reverse_byte(255)", rev_reverse_byte(255), 255)
    // 0xAA = 0b10101010 -> 0b01010101 = 0x55 = 85
    cki("rev_reverse_byte(0xAA)", rev_reverse_byte(0xAA), 0x55)
    // 0x55 = 0b01010101 -> 0b10101010 = 0xAA = 170
    cki("rev_reverse_byte(0x55)", rev_reverse_byte(0x55), 0xAA)
    // 0xF0 = 0b11110000 -> 0b00001111 = 0x0F = 15
    cki("rev_reverse_byte(0xF0)", rev_reverse_byte(0xF0), 0x0F)

    // --- ROUND-TRIP: rev_reverse_bits ---
    // double reversal must recover the original value
    cki("round-trip(0xB4,8)", rev_reverse_bits(rev_reverse_bits(0xB4, 8), 8), 0xB4)
    cki("round-trip(1,8)", rev_reverse_bits(rev_reverse_bits(1, 8), 8), 1)
    cki("round-trip(180,8)", rev_reverse_bits(rev_reverse_bits(180, 8), 8), 180)
    cki("round-trip(1,16)", rev_reverse_bits(rev_reverse_bits(1, 16), 16), 1)
    cki("round-trip(10,4)", rev_reverse_bits(rev_reverse_bits(10, 4), 4), 10)

    // --- ROUND-TRIP: rev_byteswap16 ---
    cki("round-trip-bs16(0x1234)", rev_byteswap16(rev_byteswap16(0x1234)), 0x1234)
    cki("round-trip-bs16(0xABCD)", rev_byteswap16(rev_byteswap16(0xABCD)), 0xABCD)

    // --- ROUND-TRIP: rev_byteswap32 ---
    cki("round-trip-bs32(0x12345678)", rev_byteswap32(rev_byteswap32(0x12345678)), 0x12345678)
    cki("round-trip-bs32(0x01020304)", rev_byteswap32(rev_byteswap32(0x01020304)), 0x01020304)

    // --- ROUND-TRIP: rev_nibbleswap8 ---
    cki("round-trip-ns8(0x12)", rev_nibbleswap8(rev_nibbleswap8(0x12)), 0x12)
    cki("round-trip-ns8(0xAB)", rev_nibbleswap8(rev_nibbleswap8(0xAB)), 0xAB)

    // --- ROUND-TRIP: rev_reverse_byte ---
    cki("round-trip-rb(128)", rev_reverse_byte(rev_reverse_byte(128)), 128)
    cki("round-trip-rb(0xAA)", rev_reverse_byte(rev_reverse_byte(0xAA)), 0xAA)

    print("PASS _bitreverse_test")

main()
