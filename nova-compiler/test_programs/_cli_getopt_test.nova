import std/cli/cli_getopt

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL _cli_getopt_test " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL _cli_getopt_test " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _cli_getopt_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL _cli_getopt_test " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL _cli_getopt_test " + label + "[" + str(i) + "]: got='" + got[i] + "' want='" + want[i] + "'")
            exit(1)
        i = i + 1

fn main()
    // KAT spec: clg_expand_clusters(['-abc','-d','file'])=['-a','-b','-c','-d','file']
    let a1 = []
    push(a1, "-abc")
    push(a1, "-d")
    push(a1, "file")
    let w1 = []
    push(w1, "-a")
    push(w1, "-b")
    push(w1, "-c")
    push(w1, "-d")
    push(w1, "file")
    ckl("spec1_expand", clg_expand_clusters(a1), w1)

    // KAT spec: clg_expand_clusters(['--long','x'])=['--long','x']
    let a2 = []
    push(a2, "--long")
    push(a2, "x")
    let w2 = []
    push(w2, "--long")
    push(w2, "x")
    ckl("spec2_long_passthrough", clg_expand_clusters(a2), w2)

    // KAT spec: clg_is_cluster('-abc')=true
    ckb("spec3_is_cluster_abc", clg_is_cluster("-abc"), true)

    // KAT spec: clg_is_cluster('-a')=false
    ckb("spec4_not_cluster_single", clg_is_cluster("-a"), false)

    // KAT spec: clg_is_cluster('--ab')=false
    ckb("spec5_not_cluster_long", clg_is_cluster("--ab"), false)

    // KAT spec: clg_split_attached('-ofile')=['-o','file']
    let sa = clg_split_attached("-ofile")
    let wsa = []
    push(wsa, "-o")
    push(wsa, "file")
    ckl("spec6_split_attached", sa, wsa)

    // Edge: clg_is_cluster on non-option
    ckb("non_option_not_cluster", clg_is_cluster("file"), false)

    // Edge: clg_is_cluster with '=' — NOT a cluster (has equals)
    ckb("with_eq_not_cluster", clg_is_cluster("-abc=d"), false)

    // Edge: clg_split_attached on '-a' (len==2, no attached value)
    let sa2 = clg_split_attached("-a")
    let wsa2 = []
    push(wsa2, "-a")
    ckl("split_short_alone", sa2, wsa2)

    // Edge: clg_split_attached on long option passes through unchanged
    let sa3 = clg_split_attached("--output")
    let wsa3 = []
    push(wsa3, "--output")
    ckl("split_long_passthrough", sa3, wsa3)

    // Edge: clg_split_attached on non-option passes through
    let sa4 = clg_split_attached("myfile")
    let wsa4 = []
    push(wsa4, "myfile")
    ckl("split_non_option", sa4, wsa4)

    // Edge: empty argv
    let empty = []
    let exp_empty = clg_expand_clusters(empty)
    cki("empty_expand_len", len(exp_empty), 0)

    // Edge: expand with mixed clusters, longs, and positionals
    let a3 = []
    push(a3, "-vx")
    push(a3, "--verbose")
    push(a3, "pos")
    push(a3, "-z")
    let w3 = []
    push(w3, "-v")
    push(w3, "-x")
    push(w3, "--verbose")
    push(w3, "pos")
    push(w3, "-z")
    ckl("mixed_expand", clg_expand_clusters(a3), w3)

    print("PASS _cli_getopt_test")
