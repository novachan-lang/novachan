import std/devtool/gitignore_match
import std/devtool/gitignore_validate

fn main()
    // ============================================================
    // SECTION A: gim_test adversarial edge cases
    // ============================================================

    // pattern "!" alone -> body is empty after stripping -> must NEVER match anything
    let a1 = gim_test("!", "anything", 1)
    if a1 != 0
        print("FAIL gim_test-bang-alone-dir: got " + str(a1) + " want 0")
        exit(1)
    let a2 = gim_test("!", "", 0)
    if a2 != 0
        print("FAIL gim_test-bang-alone-empty: got " + str(a2) + " want 0")
        exit(1)
    let a3 = gim_test("!", "foo/bar", 0)
    if a3 != 0
        print("FAIL gim_test-bang-alone-nested: got " + str(a3) + " want 0")
        exit(1)

    // bare "**" at top level: unanchored globstar-only body must match everything
    let a4 = gim_test("**", "foo", 0)
    if a4 != 1
        print("FAIL gim_test-globstar-bare-single: got " + str(a4) + " want 1")
        exit(1)
    let a5 = gim_test("**", "a/b/c", 0)
    if a5 != 1
        print("FAIL gim_test-globstar-bare-deep: got " + str(a5) + " want 1")
        exit(1)
    let a6 = gim_test("**", "", 0)
    if a6 != 1
        print("FAIL gim_test-globstar-bare-empty: got " + str(a6) + " want 1")
        exit(1)

    // empty pattern -> never matches
    let a7 = gim_test("", "foo", 0)
    if a7 != 0
        print("FAIL gim_test-empty-pattern: got " + str(a7) + " want 0")
        exit(1)

    // empty path against a real pattern -> no match
    let a8 = gim_test("*.log", "", 0)
    if a8 != 0
        print("FAIL gim_test-empty-path: got " + str(a8) + " want 0")
        exit(1)

    // pattern "/" alone -> matches nothing, regardless of is_dir
    let a9 = gim_test("/", "x", 1)
    if a9 != 0
        print("FAIL gim_test-slash-alone-dir: got " + str(a9) + " want 0")
        exit(1)
    let a10 = gim_test("/", "x", 0)
    if a10 != 0
        print("FAIL gim_test-slash-alone-file: got " + str(a10) + " want 0")
        exit(1)

    // dir_only with a nested anchored path: "foo/bar/" must gate on is_dir
    let a11 = gim_test("foo/bar/", "foo/bar", 1)
    if a11 != 1
        print("FAIL gim_test-dironly-nested-isdir: got " + str(a11) + " want 1")
        exit(1)
    let a12 = gim_test("foo/bar/", "foo/bar", 0)
    if a12 != 0
        print("FAIL gim_test-dironly-nested-notdir: got " + str(a12) + " want 0")
        exit(1)

    // dir_only unanchored: "bar/" must still glob-match at any depth, gated on is_dir
    let a13 = gim_test("bar/", "foo/bar", 1)
    if a13 != 1
        print("FAIL gim_test-dironly-unanchored-isdir: got " + str(a13) + " want 1")
        exit(1)
    let a14 = gim_test("bar/", "foo/bar", 0)
    if a14 != 0
        print("FAIL gim_test-dironly-unanchored-notdir: got " + str(a14) + " want 0")
        exit(1)

    // negated + dir_only combined: gim_test reports BODY match only (caller handles negation)
    let a15 = gim_test("!foo/", "foo", 1)
    if a15 != 1
        print("FAIL gim_test-negated-dironly-isdir: got " + str(a15) + " want 1")
        exit(1)
    let a16 = gim_test("!foo/", "foo", 0)
    if a16 != 0
        print("FAIL gim_test-negated-dironly-notdir: got " + str(a16) + " want 0")
        exit(1)

    // "[!a-z]" negated class: uppercase and digit are NOT in a-z -> negated class matches them
    let a17 = gim_test("[!a-z]og", "Dog", 0)
    if a17 != 1
        print("FAIL gim_test-negclass-upper: got " + str(a17) + " want 1")
        exit(1)
    let a18 = gim_test("[!a-z]og", "5og", 0)
    if a18 != 1
        print("FAIL gim_test-negclass-digit: got " + str(a18) + " want 1")
        exit(1)
    let a19 = gim_test("[!a-z]og", "dog", 0)
    if a19 != 0
        print("FAIL gim_test-negclass-lower-excluded: got " + str(a19) + " want 0")
        exit(1)

    // leading-slash root anchoring: "/*.txt" anchors to repo root even though after
    // stripping the leading "/" there is no further "/" in the body
    let a20 = gim_test("/*.txt", "a.txt", 0)
    if a20 != 1
        print("FAIL gim_test-rootanchor-match: got " + str(a20) + " want 1")
        exit(1)
    let a21 = gim_test("/*.txt", "dir/a.txt", 0)
    if a21 != 0
        print("FAIL gim_test-rootanchor-nomatch-nested: got " + str(a21) + " want 0")
        exit(1)

    // malformed character class (no closing "]") never matches
    let a22 = gim_test("[abc", "a", 0)
    if a22 != 0
        print("FAIL gim_test-malformed-class: got " + str(a22) + " want 0")
        exit(1)

    // ============================================================
    // SECTION B: gim_classify adversarial edge cases
    // ============================================================

    let b1 = gim_classify("!")
    if b1[0] != "" or b1[1] != 1 or b1[2] != 0 or b1[3] != 0
        print("FAIL gim_classify-bang-alone: got [" + b1[0] + "," + str(b1[1]) + "," + str(b1[2]) + "," + str(b1[3]) + "]")
        exit(1)

    let b2 = gim_classify("")
    if b2[0] != "" or b2[1] != 0 or b2[2] != 0 or b2[3] != 0
        print("FAIL gim_classify-empty: got [" + b2[0] + "," + str(b2[1]) + "," + str(b2[2]) + "," + str(b2[3]) + "]")
        exit(1)

    let b3 = gim_classify("**")
    if b3[0] != "**" or b3[1] != 0 or b3[2] != 0 or b3[3] != 0
        print("FAIL gim_classify-globstar-bare: got [" + b3[0] + "," + str(b3[1]) + "," + str(b3[2]) + "," + str(b3[3]) + "]")
        exit(1)

    let b4 = gim_classify("/")
    if b4[0] != "" or b4[1] != 0 or b4[2] != 1 or b4[3] != 0
        print("FAIL gim_classify-slash-alone: got [" + b4[0] + "," + str(b4[1]) + "," + str(b4[2]) + "," + str(b4[3]) + "]")
        exit(1)

    let b5 = gim_classify("/*.txt")
    if b5[0] != "/*.txt" or b5[1] != 0 or b5[2] != 0 or b5[3] != 1
        print("FAIL gim_classify-rootanchor: got [" + b5[0] + "," + str(b5[1]) + "," + str(b5[2]) + "," + str(b5[3]) + "]")
        exit(1)

    // ============================================================
    // SECTION C: gim_filter adversarial edge cases
    // ============================================================

    let empty_c = []
    let c1 = gim_filter(empty_c, "anything", 0)
    if c1 != 0
        print("FAIL gim_filter-empty-list: got " + str(c1) + " want 0")
        exit(1)

    // ALL-negated pattern list: nothing was ever ignored -> must stay 0
    let pats_negonly = []
    push(pats_negonly, "!*.log")
    let c2 = gim_filter(pats_negonly, "a.log", 0)
    if c2 != 0
        print("FAIL gim_filter-allneg-single: got " + str(c2) + " want 0")
        exit(1)

    let pats_negonly2 = []
    push(pats_negonly2, "!*.log")
    push(pats_negonly2, "!*.txt")
    let c3 = gim_filter(pats_negonly2, "a.log", 0)
    if c3 != 0
        print("FAIL gim_filter-allneg-multi: got " + str(c3) + " want 0")
        exit(1)

    // "!" as a no-op inside a real list must not disturb the ignored state
    let pats_bang = []
    push(pats_bang, "*.log")
    push(pats_bang, "!")
    let c4 = gim_filter(pats_bang, "a.log", 0)
    if c4 != 1
        print("FAIL gim_filter-bang-noop: got " + str(c4) + " want 1")
        exit(1)

    // dir_only negation gate: with is_dir=0 neither pattern ever applies -> stays 0
    let pats_dir = []
    push(pats_dir, "foo/")
    push(pats_dir, "!foo/")
    let c5 = gim_filter(pats_dir, "foo", 0)
    if c5 != 0
        print("FAIL gim_filter-dironly-gated-notdir: got " + str(c5) + " want 0")
        exit(1)
    let c6 = gim_filter(pats_dir, "foo", 1)
    if c6 != 0
        print("FAIL gim_filter-dironly-gated-isdir-negated: got " + str(c6) + " want 0")
        exit(1)

    // ============================================================
    // SECTION D: gim_matching_patterns adversarial edge cases
    // ============================================================

    let pats_d = []
    push(pats_d, "*.log")
    push(pats_d, "*.txt")
    push(pats_d, "*.log")
    let d1 = gim_matching_patterns(pats_d, "x.log", 0)
    if len(d1) != 2 or d1[0] != 0 or d1[1] != 2
        print("FAIL gim_matching_patterns-dup-indices: got len=" + str(len(d1)))
        exit(1)

    let pats_e = []
    push(pats_e, "*.foo")
    push(pats_e, "*.bar")
    let d2 = gim_matching_patterns(pats_e, "x.txt", 0)
    if len(d2) != 0
        print("FAIL gim_matching_patterns-none: got len=" + str(len(d2)))
        exit(1)

    // ============================================================
    // SECTION E: giv_check_pattern adversarial edge cases
    // ============================================================

    // pattern that is ONLY a single backslash
    let e1 = giv_check_pattern("\\")
    if len(e1) != 1 or e1[0][0] != "warning"
        print("FAIL giv_check_pattern-single-backslash: got len=" + str(len(e1)))
        exit(1)

    // pattern that is ONLY backslashes (two of them)
    let e2 = giv_check_pattern("\\\\")
    if len(e2) != 1 or e2[0][0] != "warning"
        print("FAIL giv_check_pattern-double-backslash: got len=" + str(len(e2)))
        exit(1)

    // pattern that is a lone tab character -- trailing-whitespace rule fires
    // (giv_check_pattern is context-free: it does NOT know this would be a blank line)
    let e3 = giv_check_pattern("\t")
    if len(e3) != 1 or e3[0][0] != "warning"
        print("FAIL giv_check_pattern-lone-tab: got len=" + str(len(e3)))
        exit(1)

    // tab in the MIDDLE (not trailing) must NOT trigger trailing-whitespace
    let e4 = giv_check_pattern("a\tb")
    if len(e4) != 0
        print("FAIL giv_check_pattern-mid-tab: got len=" + str(len(e4))+" issues")
        exit(1)

    // pattern ending in a tab -- trailing-whitespace rule must fire for tab too, not just space
    let e5 = giv_check_pattern("*.log\t")
    if len(e5) != 1 or e5[0][0] != "warning"
        print("FAIL giv_check_pattern-trailing-tab: got len=" + str(len(e5)))
        exit(1)

    // "!/" is NOT flagged as the lone-slash error (check_pattern does not strip "!")
    let e6 = giv_check_pattern("!/")
    if len(e6) != 0
        print("FAIL giv_check_pattern-bang-slash-not-error: got len=" + str(len(e6))+" issues")
        exit(1)

    // very long clean pattern -- must not crash and must report zero issues
    let long_body = ""
    let li = 0
    while li < 60
        long_body = long_body + "abcxy"
        li = li + 1
    let e7 = giv_check_pattern(long_body)
    if len(e7) != 0
        print("FAIL giv_check_pattern-long-clean: got len=" + str(len(e7)))
        exit(1)

    // the same long pattern used as a gim_test literal: self-match, and a mismatch on
    // a one-character difference (exercises deep segment recursion, no crash expected)
    let g_long1 = gim_test(long_body, long_body, 0)
    if g_long1 != 1
        print("FAIL gim_test-long-selfmatch: got " + str(g_long1) + " want 1")
        exit(1)
    let g_long2 = gim_test(long_body, long_body + "Z", 0)
    if g_long2 != 0
        print("FAIL gim_test-long-nomatch: got " + str(g_long2) + " want 0")
        exit(1)

    // ============================================================
    // SECTION F: giv_validate adversarial edge cases
    // ============================================================

    // empty text -> no issues
    let f1 = giv_validate("")
    if len(f1) != 0
        print("FAIL giv_validate-empty-text: got " + giv_format_issues(f1))
        exit(1)

    // only blank lines -> no issues
    let f2 = giv_validate("\n\n\n")
    if len(f2) != 0
        print("FAIL giv_validate-only-blanks: got " + giv_format_issues(f2))
        exit(1)

    // only comment lines -> no issues
    let f3 = giv_validate("# one\n# two\n#three\n")
    if len(f3) != 0
        print("FAIL giv_validate-only-comments: got " + giv_format_issues(f3))
        exit(1)

    // "!/" line: no "error" issue (check_pattern doesn't strip "!"), but exactly one
    // "negates ... never previously added" warning referencing body "/"
    let f4 = giv_validate("!/\n")
    if len(f4) != 1
        print("FAIL giv_validate-bang-slash-count: got " + giv_format_issues(f4))
        exit(1)
    if f4[0][1] != "warning" or find(f4[0][2], "negates") == -1
        print("FAIL giv_validate-bang-slash-content: got " + giv_format_issues(f4))
        exit(1)
    if giv_has_errors(f4) != 0
        print("FAIL giv_validate-bang-slash-not-error: got " + giv_format_issues(f4))
        exit(1)

    // off-by-one check: duplicate line number correct with NO trailing newline
    let f5 = giv_validate("*.log\n*.log")
    let found5 = 0
    let idx5 = 0
    let n5 = len(f5)
    while idx5 < n5
        if find(f5[idx5][2], "duplicate") != -1
            found5 = 1
            if f5[idx5][0] != 2
                print("FAIL giv_validate-notrailingnl-lineno: got " + str(f5[idx5][0]) + " want 2")
                exit(1)
        idx5 = idx5 + 1
    if found5 != 1
        print("FAIL giv_validate-notrailingnl-dupfound: got " + giv_format_issues(f5))
        exit(1)

    // exact-text duplicate detection does NOT treat "build/" and "build" as the same
    // pattern (documented limitation) -- "!build" after "build/" is still dangling
    let f6 = giv_validate("build/\n!build\n")
    let bad6 = 0
    let idx6 = 0
    let n6 = len(f6)
    while idx6 < n6
        if find(f6[idx6][2], "negates") != -1
            bad6 = 1
        idx6 = idx6 + 1
    if bad6 != 1
        print("FAIL giv_validate-exacttext-mismatch-should-warn: got " + giv_format_issues(f6))
        exit(1)

    // but an EXACT prior text match on a dir_only pattern correctly suppresses the warning
    let f7 = giv_validate("build/\n!build/\n")
    let bad7 = 0
    let idx7 = 0
    let n7 = len(f7)
    while idx7 < n7
        if find(f7[idx7][2], "negates") != -1
            bad7 = 1
        idx7 = idx7 + 1
    if bad7 != 0
        print("FAIL giv_validate-exacttext-match-falsepositive: got " + giv_format_issues(f7))
        exit(1)

    // ============================================================
    // SECTION G: giv_format_issues exact-string checks
    // ============================================================

    let g1 = giv_format_issues([])
    if g1 != "No issues found."
        print("FAIL giv_format_issues-empty-exact: got '" + g1 + "'")
        exit(1)

    let f8 = giv_validate("*\n")
    let g2 = giv_format_issues(f8)
    let expected_g2 = "1 issue(s) found:\n  line 1 [warning] pattern is bare \"*\" -- ignores everything; make sure this is intentional"
    if g2 != expected_g2
        print("FAIL giv_format_issues-barestar-exact: got '" + g2 + "'")
        exit(1)

    // giv_has_errors sanity on synthetic error-only and warning-only sets
    let f9 = giv_validate("/\n")
    if giv_has_errors(f9) != 1
        print("FAIL giv_has_errors-lone-slash: want 1")
        exit(1)

    print("PASS _adv_gitignore_mv_test")
