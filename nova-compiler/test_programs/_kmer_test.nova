// KAT for std/bio/kmer — k-mer extraction, counting, and analysis.
// All reference values verified by hand against the definitions.
import std/bio/kmer

// cks — check string equality.
fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

// cki — check int equality.
fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb — check bool equality.
fn ckb(label, got, want)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
        exit(1)

// ckf — check float within tolerance.
fn ckf(label, got, want, tol)
    let diff = got - want
    if diff < 0.0
        diff = 0.0 - diff
    if diff >= tol
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// list_contains_str: check that lst contains string val.
fn list_contains_str(lst, val)
    let i = 0
    let n = len(lst)
    let found = false
    while i < n and not found
        if lst[i] == val
            found = true
        i = i + 1
    return found

// lists_equal: check two string lists have the same elements in the same order.
fn lists_equal(a, b)
    let na = len(a)
    let nb = len(b)
    if na != nb
        return false
    let i = 0
    let eq = true
    while i < na and eq
        if a[i] != b[i]
            eq = false
        i = i + 1
    return eq

fn main()
    // ── kmer_total ───────────────────────────────────────────────────────────
    cki("total_3_of_6",  kmer_total("ATGATG", 3),   4)
    cki("total_1",       kmer_total("ATGATG", 1),   6)
    cki("total_too_big", kmer_total("AT", 3),        0)
    cki("total_empty",   kmer_total("", 3),           0)

    // ── kmer_extract ─────────────────────────────────────────────────────────
    let ex = kmer_extract("ATGATG", 3)
    cki("extract_len",  len(ex),   4)
    cks("extract_0",    ex[0],     "ATG")
    cks("extract_1",    ex[1],     "TGA")
    cks("extract_2",    ex[2],     "GAT")
    cks("extract_3",    ex[3],     "ATG")

    // ── kmer_count ───────────────────────────────────────────────────────────
    let cnt = kmer_count("ATGATG", 3)
    cki("count_ATG",  cnt["ATG"],  2)
    cki("count_TGA",  cnt["TGA"],  1)
    cki("count_GAT",  cnt["GAT"],  1)

    // ── kmer_unique ──────────────────────────────────────────────────────────
    cki("unique_ATGATG_3",  kmer_unique("ATGATG", 3),   3)
    cki("unique_AAAA_2",    kmer_unique("AAAA", 2),      1)

    // ── kmer_freq ────────────────────────────────────────────────────────────
    let freq = kmer_freq("ATGATG", 3)
    // ATG appears 2/4 = 0.5
    ckf("freq_ATG",  freq["ATG"],  0.5,  0.001)
    // TGA appears 1/4 = 0.25
    ckf("freq_TGA",  freq["TGA"],  0.25, 0.001)

    // ── kmer_canonical ────────────────────────────────────────────────────────
    // "AAT" vs revcomp("AAT")="ATT" -> "AAT" < "ATT" -> canonical = "AAT"
    cks("canonical_AAT",  kmer_canonical("AAT"),  "AAT")
    // "ATT" vs revcomp("ATT")="AAT" -> "AAT" < "ATT" -> canonical = "AAT"
    cks("canonical_ATT",  kmer_canonical("ATT"),  "AAT")
    // "ACG" vs revcomp("ACG")="CGT" -> "ACG" < "CGT" -> canonical = "ACG"
    cks("canonical_ACG",  kmer_canonical("ACG"),  "ACG")
    // palindrome "ATAT": revcomp = "ATAT" -> same -> canonical = "ATAT"
    cks("canonical_ATAT", kmer_canonical("ATAT"), "ATAT")

    // ── kmer_count_canonical ─────────────────────────────────────────────────
    // "ATGATG" 3-mers: ATG(2), TGA(1), GAT(1)
    // canonical(ATG)=? revcomp(ATG)=CAT, "ATG">"CAT" -> canonical=CAT
    // canonical(TGA)=? revcomp(TGA)=TCA, "TCA">"TGA" -> canonical=TCA
    // canonical(GAT)=? revcomp(GAT)=ATC, "ATC"<"GAT" -> canonical=ATC
    let cc = kmer_count_canonical("ATGATG", 3)
    // Just verify total counts sum to 4
    let cc_keys = keys(cc)
    let cc_total = 0
    let ci = 0
    while ci < len(cc_keys)
        cc_total = cc_total + cc[cc_keys[ci]]
        ci = ci + 1
    cki("canonical_total", cc_total, 4)

    // ── kmer_positions ────────────────────────────────────────────────────────
    let pos = kmer_positions("ATGATG", "ATG")
    cki("pos_count",  len(pos),  2)
    cki("pos_0",      pos[0],    0)
    cki("pos_1",      pos[1],    3)
    // Single occurrence
    let pos2 = kmer_positions("ATGATG", "TGA")
    cki("pos2_count", len(pos2), 1)
    cki("pos2_0",     pos2[0],   1)
    // Not found
    let pos3 = kmer_positions("ATGATG", "CCC")
    cki("pos3_count", len(pos3), 0)

    // ── kmer_contains ─────────────────────────────────────────────────────────
    ckb("contains_ATG",  kmer_contains("ATGATG", "ATG"),  true)
    ckb("contains_CCC",  kmer_contains("ATGATG", "CCC"),  false)
    ckb("contains_empty_s", kmer_contains("", "ATG"),     false)

    // ── kmer_spectrum ─────────────────────────────────────────────────────────
    // ATGATG 3-mers: {ATG, GAT, TGA} sorted lex -> [ATG, GAT, TGA]
    let spec = kmer_spectrum("ATGATG", 3)
    cki("spectrum_len",  len(spec),  3)
    cks("spectrum_0",    spec[0],    "ATG")
    cks("spectrum_1",    spec[1],    "GAT")
    cks("spectrum_2",    spec[2],    "TGA")

    // ── kmer_top ──────────────────────────────────────────────────────────────
    // "ATGATG" 3-mers: ATG=2, TGA=1, GAT=1 -> top-1 = ATG; top-2 = ATG + (GAT or TGA lex)
    let top1 = kmer_top("ATGATG", 3, 1)
    cki("top1_len",  len(top1),  1)
    cks("top1_0",    top1[0],    "ATG")
    // top-2: ATG=2, then GAT=1 and TGA=1 tied; lex ascending -> GAT before TGA
    let top2 = kmer_top("ATGATG", 3, 2)
    cki("top2_len",  len(top2),  2)
    cks("top2_0",    top2[0],    "ATG")
    cks("top2_1",    top2[1],    "GAT")
    // top-10 with only 3 distinct -> returns all 3
    let top10 = kmer_top("ATGATG", 3, 10)
    cki("top10_len", len(top10), 3)

    // ── kmer_jaccard ──────────────────────────────────────────────────────────
    // Same string -> Jaccard = 1.0
    ckf("jaccard_same",  kmer_jaccard("ATGC", "ATGC", 2),  1.0,  0.001)
    // Completely different 2-mers -> Jaccard = 0.0
    // "AAAA" 2-mers: {AA}; "CCCC" 2-mers: {CC} -> intersection=0, union=2 -> 0.0
    ckf("jaccard_diff",  kmer_jaccard("AAAA", "CCCC", 2),  0.0,  0.001)
    // "ATGC" vs "ATGC" with k=1 -> both {A,T,G,C} -> 1.0
    ckf("jaccard_k1",    kmer_jaccard("ATGC", "ATGC", 1),  1.0,  0.001)

    print("PASS _kmer_test")
