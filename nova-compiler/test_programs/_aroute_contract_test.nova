// A routed handler carrying an `ensures` contract must register EXACTLY ONE route (the wrapper), not two.
// Before the fix, inject_ensures copied @get onto BOTH h_ok and h_ok__ens_impl, and inject_routes
// registered both -- first-match-wins dispatch then hit the RAW impl, silently bypassing the postcondition.
// Now only the wrapper registers, so dispatch flows through the contract-checking wrapper.
import forge

@get("/ok")
fn h_ok(req) -> string ensures len(result) > 0
    "hello"

@get("/plain")
fn h_plain(req) -> string
    "world"

fn main()
    let a0 = app()
    let a = __nova_register_routes(a0)
    // Two handlers -> exactly two routes. Before the fix h_ok contributed TWO (impl + wrapper) -> 3.
    let nr = len(a["routes"])
    if nr != 2
        print("FAIL routes=" + str(nr) + " (expected 2; an impl duplicate means the contract is bypassed)")
        exit(1)
    let r1 = dispatch(a, "GET", "/ok", "")
    if not contains(r1, "hello")
        print("FAIL dispatch /ok: [" + r1 + "]")
        exit(1)
    let r2 = dispatch(a, "GET", "/plain", "")
    if not contains(r2, "world")
        print("FAIL dispatch /plain: [" + r2 + "]")
        exit(1)
    print("PASS _aroute_contract_test")
