fn worker(id: int, ch: channel) -> int
    let acc = 0
    let i = 0
    while i < 3000000
        acc = acc + (i % 7)
        i = i + 1
    send(ch, acc)
    return acc

fn main()
    let t0 = clock_ns()
    let ch = channel()
    let n = 0
    while n < 8
        spawn worker(n, ch)
        n = n + 1
    let total = 0
    let got = 0
    while got < 8
        total = total + receive(ch)
        got = got + 1
    print("total=" + str(total) + " ns=" + str(clock_ns() - t0))
