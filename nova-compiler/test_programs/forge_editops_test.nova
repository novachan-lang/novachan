import forge_editops

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn count_nonkeep(ops) -> int
    let c = 0
    let i = 0
    while i < len(ops)
        if starts_with(ops[i], "keep") == false
            c = c + 1
        i = i + 1
    c

fn main()
    let fails = 0

    // distance sanity
    fails = fails + expect("dist_kitten", str(edit_distance("kitten", "sitting")), "3")
    fails = fails + expect("dist_same", str(edit_distance("abc", "abc")), "0")
    fails = fails + expect("dist_empty", str(edit_distance("", "abc")), "3")

    // substitution: cat -> cut
    fails = fails + expect("sub", join(edit_operations("cat", "cut"), "|"), "keep c|sub a u|keep t")
    // insertion: cat -> cats
    fails = fails + expect("ins", join(edit_operations("cat", "cats"), "|"), "keep c|keep a|keep t|ins s")
    // deletion: cats -> cat
    fails = fails + expect("del", join(edit_operations("cats", "cat"), "|"), "keep c|keep a|keep t|del s")
    // from empty
    fails = fails + expect("from_empty", join(edit_operations("", "ab"), "|"), "ins a|ins b")
    // to empty
    fails = fails + expect("to_empty", join(edit_operations("ab", ""), "|"), "del a|del b")
    // identical -> all keeps
    fails = fails + expect("identical", join(edit_operations("abc", "abc"), "|"), "keep a|keep b|keep c")

    // the non-keep op count equals the edit distance
    let ops = edit_operations("kitten", "sitting")
    fails = fails + expect("nonkeep_eq_dist", str(count_nonkeep(ops)), "3")

    // applying the ops reconstructs b: build b from the op list
    let rebuilt = ""
    let k = 0
    while k < len(ops)
        let op = ops[k]
        if starts_with(op, "keep ")
            rebuilt = rebuilt + slice(op, 5, len(op))
        if starts_with(op, "ins ")
            rebuilt = rebuilt + slice(op, 4, len(op))
        if starts_with(op, "sub ")
            rebuilt = rebuilt + slice(op, len(op) - 1, len(op))
        k = k + 1
    fails = fails + expect("reconstruct", rebuilt, "sitting")

    if fails == 0
        print("forge_editops: all passed")
    else
        print("forge_editops: " + str(fails) + " FAILED")
