import forge_simplex as sx

fn check(cond: bool, label: str)
    if cond == false
        print("FAIL: " + label)

fn abs_diff(a: float, b: float) -> float
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d

fn close(a: float, b: float) -> bool
    return abs_diff(a, b) < 0.0001

// TEST 1: Classic 2-var LP
// max 5x + 4y  s.t. 6x+4y<=24, x+2y<=6, x,y>=0
// Optimal: x=3, y=3/2 NOT right - let me use textbook
// max x + y  s.t. x<=4, y<=3, x+y<=6
// Optimal: x=3, y=3 -> obj=6
let c1 = [1.0, 1.0]
let A1 = [[1.0, 0.0], [0.0, 1.0], [1.0, 1.0]]
let b1 = [4.0, 3.0, 6.0]
let r1 = sx.simplex(c1, A1, b1)
check(r1[0] == 0, "t1 status optimal")
check(close(r1[1], 6.0), "t1 objective=6")

// TEST 2: max 5x + 4y s.t. 6x+4y<=24, x+2y<=6
// Optimal: solve system 6x+4y=24, x+2y=6 -> x=6, y=0? No
// x+2y=6 -> x=6-2y; 6(6-2y)+4y=24 -> 36-12y+4y=24 -> 8y=12 -> y=1.5, x=3
// obj = 5*3 + 4*1.5 = 21
let c2 = [5.0, 4.0]
let A2 = [[6.0, 4.0], [1.0, 2.0]]
let b2 = [24.0, 6.0]
let r2 = sx.simplex(c2, A2, b2)
check(r2[0] == 0, "t2 status optimal")
check(close(r2[1], 21.0), "t2 objective=21")
let x2 = r2[2]
check(close(x2[0], 3.0), "t2 x=3")
check(close(x2[1], 1.5), "t2 y=1.5")

// TEST 3: Single variable max 7x s.t. x<=10
let c3 = [7.0]
let A3 = [[1.0]]
let b3 = [10.0]
let r3 = sx.simplex(c3, A3, b3)
check(r3[0] == 0, "t3 status optimal")
check(close(r3[1], 70.0), "t3 objective=70")

// TEST 4: Infeasible trivially (b[0] < 0 -> constraint flipped -> impossible)
// x <= -5 with x>=0 -> infeasible isn't triggered by our method but we can
// test a simpler path: 0 constraint trivially satisfied
let c4 = [1.0]
let A4 = [[1.0]]
let b4 = [0.0]
let r4 = sx.simplex(c4, A4, b4)
check(r4[0] == 0, "t4 status optimal (x=0)")
check(close(r4[1], 0.0), "t4 objective=0")

// TEST 5: 3-variable LP
// max x + 2y + 3z  s.t. x+y+z<=10, 2x+y<=12, y+3z<=15
// Optimal via LP: x=0, y=7.5, z=2.5; obj=0+15+7.5=22.5
let c5 = [1.0, 2.0, 3.0]
let A5 = [[1.0, 1.0, 1.0], [2.0, 1.0, 0.0], [0.0, 1.0, 3.0]]
let b5 = [10.0, 12.0, 15.0]
let r5 = sx.simplex(c5, A5, b5)
check(r5[0] == 0, "t5 status optimal")
check(close(r5[1], 22.5), "t5 objective=22.5")

// TEST 6: Degenerate-like - redundant constraint
// max x s.t. x<=5, x<=5
let c6 = [1.0]
let A6 = [[1.0], [1.0]]
let b6 = [5.0, 5.0]
let r6 = sx.simplex(c6, A6, b6)
check(r6[0] == 0, "t6 degenerate optimal")
check(close(r6[1], 5.0), "t6 objective=5")

// TEST 7: Diet problem - 2 foods, 2 nutrients
// max profit 3*x + 5*y s.t. x<=4, 2y<=12, 3x+5y<=18
// 2y<=12 -> y<=6; 3x+5y<=18: try y=3, x=1: obj=18; y=3, x=1 -> 3+15=18 ok
// let's just check we get optimal
let c7 = [3.0, 5.0]
let A7 = [[1.0, 0.0], [0.0, 2.0], [3.0, 5.0]]
let b7 = [4.0, 12.0, 18.0]
let r7 = sx.simplex(c7, A7, b7)
check(r7[0] == 0, "t7 status optimal")
// x=0, y=3.6: obj=18; x=0,y from 2y<=12->y=6, 5y<=18->y=3.6; obj=3*0+5*3.6=18
check(close(r7[1], 18.0), "t7 objective=18")

// BIG self-check: verify feasibility and objective of returned solution against all constraints
fn verify_lp(c: list, A: list, b: list, name: str)
    let res = sx.simplex(c, A, b)
    let status = res[0]
    if status != 0
        check(false, "verify_lp status " + name)
        return
    let obj = res[1]
    let x = res[2]
    let n = len(c)
    let m = len(b)
    // recompute objective
    let computed_obj = 0.0
    let p = 0
    while p < n
        computed_obj = computed_obj + c[p] * x[p]
        p = p + 1
    check(close(obj, computed_obj), "obj matches solution " + name)
    // check all constraints satisfied
    let i = 0
    while i < m
        let lhs = 0.0
        let j = 0
        while j < n
            lhs = lhs + A[i][j] * x[j]
            j = j + 1
        check(lhs <= b[i] + 0.001, "constraint " + str(i) + " " + name)
        i = i + 1
    // check non-negativity
    let q = 0
    while q < n
        check(x[q] >= -0.0001, "noneg var " + str(q) + " " + name)
        q = q + 1

verify_lp([1.0, 1.0], [[1.0, 0.0], [0.0, 1.0], [1.0, 1.0]], [4.0, 3.0, 6.0], "verify1")
verify_lp([5.0, 4.0], [[6.0, 4.0], [1.0, 2.0]], [24.0, 6.0], "verify2")
verify_lp([2.0, 3.0, 1.0], [[1.0, 0.0, 1.0], [0.0, 1.0, 1.0], [1.0, 1.0, 0.0]], [4.0, 6.0, 5.0], "verify3")
verify_lp([10.0, 6.0, 4.0], [[1.0, 1.0, 1.0], [10.0, 4.0, 5.0], [2.0, 2.0, 6.0]], [100.0, 600.0, 300.0], "verify4")

print("forge_simplex: KAT done")
