// Test retroactive protocol implementation on builtin types
// User defines fn int__method(self: int) -> T, calls as x.method()

fn int__double(x: int) -> int
    return x * 2

fn int__is_even(x: int) -> int
    return x % 2 == 0

fn string__upper_first(s: string) -> string
    if len(s) == 0
        return ""
    let first = s[0:1]
    // simple ASCII upper for a-z
    let c = ord(first)
    if c >= 97 and c <= 122
        return chr(c - 32) + s[1:len(s)]
    return s

fn string__repeat(s: string, n: int) -> string
    let out = ""
    let i = 0
    while i < n
        out = out + s
        i = i + 1
    return out

fn list__sum(xs: list) -> int
    let total = 0
    for x in xs
        total = total + x
    return total

fn main()
    // int methods
    let x = 10
    assert(x.double() == 20, "int.double")
    assert(42.double() == 84, "literal.double")
    assert(7.is_even() == 0, "odd.is_even")
    assert(8.is_even() == 1, "even.is_even")

    // string methods
    let s = "hello"
    assert(s.upper_first() == "Hello", "string.upper_first")
    assert("world".upper_first() == "World", "literal.upper_first")
    assert("ab".repeat(3) == "ababab", "string.repeat")

    // list methods
    let nums = [1, 2, 3, 4, 5]
    assert(nums.sum() == 15, "list.sum")

    // chaining: int.double().double()
    assert(5.double().double() == 20, "chain double")

    print("builtin_method: all passed")
