import std/complex/complex_arith

// cki — assert integer equality
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _complex_arith_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb — assert boolean equality
fn ckb(label: string, got: bool, want: bool)
    if got != want
        print("FAIL _complex_arith_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckl — assert list equality element-wise (2-element complex lists)
fn ckl(label: string, got: list, wr: int, wi: int)
    if got[0] != wr or got[1] != wi
        print("FAIL _complex_arith_test " + label + ": got=[" + str(got[0]) + "," + str(got[1]) + "] want=[" + str(wr) + "," + str(wi) + "]")
        exit(1)

// cks — assert string equality
fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL _complex_arith_test " + label + ": got=" + got + " want=" + want)
        exit(1)

// helper: build a complex list [re, im]
fn mk(re: int, im: int) -> list
    let c = []
    push(c, re)
    push(c, im)
    c

// --- cx_add ---
// (1+2i) + (3+4i) = 4+6i
let r1 = cx_add(mk(1, 2), mk(3, 4))
ckl("add_1_2__3_4", r1, 4, 6)

// (0+0i) + (5+7i) = 5+7i  (identity)
let r2 = cx_add(mk(0, 0), mk(5, 7))
ckl("add_zero_identity", r2, 5, 7)

// (3+(-4)i) + ((-3)+4i) = 0+0i  (cancellation)
let r3 = cx_add(mk(3, 0 - 4), mk(0 - 3, 4))
ckl("add_cancel", r3, 0, 0)

// --- cx_sub ---
// (5+5i) - (1+2i) = 4+3i
let s1 = cx_sub(mk(5, 5), mk(1, 2))
ckl("sub_5_5__1_2", s1, 4, 3)

// (3+4i) - (3+4i) = 0+0i
let s2 = cx_sub(mk(3, 4), mk(3, 4))
ckl("sub_self", s2, 0, 0)

// (1+2i) - (3+5i) = -2-3i
let s3 = cx_sub(mk(1, 2), mk(3, 5))
ckl("sub_neg_result", s3, 0 - 2, 0 - 3)

// --- cx_mul ---
// (1+2i)(3+4i) = 3+4i+6i+8i^2 = (3-8)+(4+6)i = -5+10i
let m1 = cx_mul(mk(1, 2), mk(3, 4))
ckl("mul_1_2__3_4", m1, 0 - 5, 10)

// i*i = -1  ([0,1]*[0,1]=[-1,0])
let m2 = cx_mul(mk(0, 1), mk(0, 1))
ckl("mul_i_times_i", m2, 0 - 1, 0)

// (1+0i)(3+4i) = 3+4i  (real times complex)
let m3 = cx_mul(mk(1, 0), mk(3, 4))
ckl("mul_real_1", m3, 3, 4)

// (2+0i)(3+4i) = 6+8i  (real scalar times complex)
let m4 = cx_mul(mk(2, 0), mk(3, 4))
ckl("mul_real_2", m4, 6, 8)

// (3+4i)(3-4i) = 9+16 = 25+0i  (norm product)
let m5 = cx_mul(mk(3, 4), mk(3, 0 - 4))
ckl("mul_norm_product", m5, 25, 0)

// --- cx_neg ---
// -(1+(-2)i) = -1+2i
let n1 = cx_neg(mk(1, 0 - 2))
ckl("neg_1_neg2", n1, 0 - 1, 2)

// -(0+0i) = 0+0i
let n2 = cx_neg(mk(0, 0))
ckl("neg_zero", n2, 0, 0)

// -(5+3i) = -5-3i
let n3 = cx_neg(mk(5, 3))
ckl("neg_5_3", n3, 0 - 5, 0 - 3)

// --- cx_conj ---
// conj(3+4i) = 3-4i
let cj1 = cx_conj(mk(3, 4))
ckl("conj_3_4", cj1, 3, 0 - 4)

// conj(5+0i) = 5+0i  (real is self-conjugate)
let cj2 = cx_conj(mk(5, 0))
ckl("conj_real", cj2, 5, 0)

// conj(0+1i) = 0-1i
let cj3 = cx_conj(mk(0, 1))
ckl("conj_pure_imag", cj3, 0, 0 - 1)

// --- cx_scale ---
// (2+3i) * 4 = 8+12i
let sc1 = cx_scale(mk(2, 3), 4)
ckl("scale_2_3__4", sc1, 8, 12)

// (2+3i) * 0 = 0+0i
let sc2 = cx_scale(mk(2, 3), 0)
ckl("scale_by_zero", sc2, 0, 0)

// (2+3i) * (-1) = -2-3i
let sc3 = cx_scale(mk(2, 3), 0 - 1)
ckl("scale_by_neg1", sc3, 0 - 2, 0 - 3)

// (1+0i) * 7 = 7+0i
let sc4 = cx_scale(mk(1, 0), 7)
ckl("scale_real_7", sc4, 7, 0)

print("PASS _complex_arith_test")
