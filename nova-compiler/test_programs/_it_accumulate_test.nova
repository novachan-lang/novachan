import std/itertools/it_accumulate

// cki — check a single int
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckflat — check a flat int list element-by-element
fn ckflat(label: string, got, want)
    cki(label + "_len", len(got), len(want))
    let i = 0
    while i < len(want)
        cki(label + "_" + str(i), got[i], want[i])
        i = i + 1

fn main()
    // ── ita_sums ──
    // sums([1,2,3,4]) = [1,3,6,10]
    ckflat("sums_basic", ita_sums([1, 2, 3, 4]), [1, 3, 6, 10])
    // sums([]) = []
    cki("sums_empty", len(ita_sums([])), 0)
    // sums([5]) = [5]
    ckflat("sums_single", ita_sums([5]), [5])
    // sums with negatives
    ckflat("sums_neg", ita_sums([3, -1, 2]), [3, 2, 4])

    // ── ita_products ──
    // products([1,2,3,4]) = [1,2,6,24]
    ckflat("products_basic", ita_products([1, 2, 3, 4]), [1, 2, 6, 24])
    // products([]) = []
    cki("products_empty", len(ita_products([])), 0)
    // products([7]) = [7]
    ckflat("products_single", ita_products([7]), [7])
    // products with zero
    ckflat("products_zero", ita_products([2, 3, 0, 5]), [2, 6, 0, 0])

    // ── ita_maxima ──
    // maxima([3,1,4,1,5]) = [3,3,4,4,5]
    ckflat("maxima_basic", ita_maxima([3, 1, 4, 1, 5]), [3, 3, 4, 4, 5])
    // maxima([]) = []
    cki("maxima_empty", len(ita_maxima([])), 0)
    // maxima([7]) = [7]
    ckflat("maxima_single", ita_maxima([7]), [7])
    // maxima already sorted
    ckflat("maxima_sorted", ita_maxima([1, 2, 3, 4]), [1, 2, 3, 4])
    // maxima reverse sorted
    ckflat("maxima_rev", ita_maxima([4, 3, 2, 1]), [4, 4, 4, 4])

    // ── ita_minima ──
    // minima([3,1,4,1,5]) = [3,1,1,1,1]
    ckflat("minima_basic", ita_minima([3, 1, 4, 1, 5]), [3, 1, 1, 1, 1])
    // minima([]) = []
    cki("minima_empty", len(ita_minima([])), 0)
    // minima([7]) = [7]
    ckflat("minima_single", ita_minima([7]), [7])
    // minima already sorted ascending
    ckflat("minima_sorted", ita_minima([1, 2, 3, 4]), [1, 1, 1, 1])
    // minima reverse sorted
    ckflat("minima_rev", ita_minima([4, 3, 2, 1]), [4, 3, 2, 1])

    // ── ita_diffs ──
    // diffs([1,3,6,10]) = [2,3,4]
    ckflat("diffs_basic", ita_diffs([1, 3, 6, 10]), [2, 3, 4])
    // diffs([]) = []
    cki("diffs_empty", len(ita_diffs([])), 0)
    // diffs([5]) = []
    cki("diffs_single", len(ita_diffs([5])), 0)
    // diffs([1,1,1]) = [0,0]
    ckflat("diffs_flat", ita_diffs([1, 1, 1]), [0, 0])
    // diffs with negatives
    ckflat("diffs_neg", ita_diffs([5, 3, 7]), [-2, 4])

    // ── ROUND-TRIP: sums then diffs recovers original tail ──
    // sums([2,3,5]) = [2,5,10]; diffs([2,5,10]) = [3,5]
    let rt_in = [2, 3, 5]
    let rt_sums = ita_sums(rt_in)
    let rt_diffs = ita_diffs(rt_sums)
    // rt_diffs should equal rt_in[1..] = [3,5]
    cki("roundtrip_len", len(rt_diffs), 2)
    cki("roundtrip_0", rt_diffs[0], 3)
    cki("roundtrip_1", rt_diffs[1], 5)

    print("PASS _it_accumulate_test")
