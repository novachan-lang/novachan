// _arpeggio_test.nova — KAT for std/music/arpeggio
//
// HAND-VERIFIED VECTORS
//   Input chord: C major triad in root position [60(C4), 64(E4), 67(G4)]
//
//   arp_up([60,64,67])     == [60,64,67]
//     sorted ascending = same order.
//
//   arp_down([60,64,67])   == [67,64,60]
//     sorted descending.
//
//   arp_updown([60,64,67]) == [60,64,67,64]
//     up=[60,64,67], down without top(67) and bottom(60) = [64]
//     result = [60,64,67,64]
//
//   arp_downup([60,64,67]) == [67,64,60,64]
//     down=[67,64,60], up without bottom(60) and top(67) = [64]
//     result = [67,64,60,64]
//
//   arp_pattern([60,64,67],[0,2,1]) == [60,67,64]
//     asc=[60,64,67]; idx 0->60, idx 2->67, idx 1->64
//
//   arp_octaves([60,64,67],2) == [60,64,67,72,76,79]
//     oct0=[60,64,67], oct1=[60+12,64+12,67+12]=[72,76,79]

import std/music/arpeggio

// ── check helpers ─────────────────────────────────────────────────────────────

fn ck_list(label, got, want)
    let ok = 1
    if len(got) != len(want)
        ok = 0
    else
        let i = 0
        while i < len(got)
            if got[i] != want[i]
                ok = 0
            i = i + 1
    if ok == 0
        let gs = "["
        let i = 0
        while i < len(got)
            if i > 0
                gs = gs + ","
            gs = gs + str(got[i])
            i = i + 1
        gs = gs + "]"
        let ws = "["
        let i2 = 0
        while i2 < len(want)
            if i2 > 0
                ws = ws + ","
            ws = ws + str(want[i2])
            i2 = i2 + 1
        ws = ws + "]"
        print("FAIL arpeggio " + label + ": got=" + gs + " want=" + ws)
        exit(1)

// ── main ──────────────────────────────────────────────────────────────────────

fn main()
    // Build input: [60, 64, 67]
    let notes = []
    push(notes, 60)
    push(notes, 64)
    push(notes, 67)

    // ── arp_up ────────────────────────────────────────────────────────────────

    // KAT: arp_up([60,64,67]) == [60,64,67]
    let want_up = []
    push(want_up, 60)
    push(want_up, 64)
    push(want_up, 67)
    ck_list("arp_up([60,64,67])", arp_up(notes), want_up)

    // arp_up on unsorted input: [67,60,64] -> [60,64,67]
    let unsorted = []
    push(unsorted, 67)
    push(unsorted, 60)
    push(unsorted, 64)
    ck_list("arp_up(unsorted)", arp_up(unsorted), want_up)

    // ── arp_down ──────────────────────────────────────────────────────────────

    // KAT: arp_down([60,64,67]) == [67,64,60]
    let want_down = []
    push(want_down, 67)
    push(want_down, 64)
    push(want_down, 60)
    ck_list("arp_down([60,64,67])", arp_down(notes), want_down)

    // ── arp_updown ────────────────────────────────────────────────────────────

    // KAT: arp_updown([60,64,67]) == [60,64,67,64]
    let want_updown = []
    push(want_updown, 60)
    push(want_updown, 64)
    push(want_updown, 67)
    push(want_updown, 64)
    ck_list("arp_updown([60,64,67])", arp_updown(notes), want_updown)

    // Edge: single note -> [n]
    let single = []
    push(single, 60)
    let want_single = []
    push(want_single, 60)
    ck_list("arp_updown(single)", arp_updown(single), want_single)

    // Edge: two notes [60,64] -> up=[60,64], down-without-top-and-bottom=[nothing between]
    // By the rule: up pass=[60,64], down inner (indices 1..n-2 = 1..-1, empty) -> [60,64]
    let two = []
    push(two, 60)
    push(two, 64)
    let want_two_ud = []
    push(want_two_ud, 60)
    push(want_two_ud, 64)
    ck_list("arp_updown(two)", arp_updown(two), want_two_ud)

    // 4-note chord: [60,64,67,71] -> [60,64,67,71,67,64]
    let four = []
    push(four, 60)
    push(four, 64)
    push(four, 67)
    push(four, 71)
    let want_four_ud = []
    push(want_four_ud, 60)
    push(want_four_ud, 64)
    push(want_four_ud, 67)
    push(want_four_ud, 71)
    push(want_four_ud, 67)
    push(want_four_ud, 64)
    ck_list("arp_updown(four)", arp_updown(four), want_four_ud)

    // ── arp_downup ────────────────────────────────────────────────────────────

    // KAT: arp_downup([60,64,67]) == [67,64,60,64]
    let want_downup = []
    push(want_downup, 67)
    push(want_downup, 64)
    push(want_downup, 60)
    push(want_downup, 64)
    ck_list("arp_downup([60,64,67])", arp_downup(notes), want_downup)

    // Edge: two notes [60,64] -> [64,60]  (inner of up pass is empty)
    let want_two_du = []
    push(want_two_du, 64)
    push(want_two_du, 60)
    ck_list("arp_downup(two)", arp_downup(two), want_two_du)

    // 4-note chord: [60,64,67,71] -> [71,67,64,60,64,67]
    let want_four_du = []
    push(want_four_du, 71)
    push(want_four_du, 67)
    push(want_four_du, 64)
    push(want_four_du, 60)
    push(want_four_du, 64)
    push(want_four_du, 67)
    ck_list("arp_downup(four)", arp_downup(four), want_four_du)

    // ── arp_pattern ───────────────────────────────────────────────────────────

    // KAT: arp_pattern([60,64,67],[0,2,1]) == [60,67,64]
    let pat = []
    push(pat, 0)
    push(pat, 2)
    push(pat, 1)
    let want_pat = []
    push(want_pat, 60)
    push(want_pat, 67)
    push(want_pat, 64)
    ck_list("arp_pattern([60,64,67],[0,2,1])", arp_pattern(notes, pat), want_pat)

    // Repeated index: [0,0,1,2,0] -> [60,60,64,67,60]
    let pat2 = []
    push(pat2, 0)
    push(pat2, 0)
    push(pat2, 1)
    push(pat2, 2)
    push(pat2, 0)
    let want_pat2 = []
    push(want_pat2, 60)
    push(want_pat2, 60)
    push(want_pat2, 64)
    push(want_pat2, 67)
    push(want_pat2, 60)
    ck_list("arp_pattern(repeated)", arp_pattern(notes, pat2), want_pat2)

    // ── arp_octaves ───────────────────────────────────────────────────────────

    // KAT: arp_octaves([60,64,67],2) == [60,64,67,72,76,79]
    let want_oct2 = []
    push(want_oct2, 60)
    push(want_oct2, 64)
    push(want_oct2, 67)
    push(want_oct2, 72)
    push(want_oct2, 76)
    push(want_oct2, 79)
    ck_list("arp_octaves([60,64,67],2)", arp_octaves(notes, 2), want_oct2)

    // 1 octave = just the base chord.
    ck_list("arp_octaves(1)", arp_octaves(notes, 1), want_up)

    // 3 octaves: [60,64,67, 72,76,79, 84,88,91]
    let want_oct3 = []
    push(want_oct3, 60)
    push(want_oct3, 64)
    push(want_oct3, 67)
    push(want_oct3, 72)
    push(want_oct3, 76)
    push(want_oct3, 79)
    push(want_oct3, 84)
    push(want_oct3, 88)
    push(want_oct3, 91)
    ck_list("arp_octaves(3)", arp_octaves(notes, 3), want_oct3)

    print("PASS _arpeggio_test")
