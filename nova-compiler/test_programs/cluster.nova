// ══════════════════════════════════════════════════════════════════════════════
// cluster — distributed name/PID registry for NOVA (#21), built on remote_* channels
//
// A registry NODE holds a name -> address map; other nodes register/look up over the
// network (TCP + the existing length-prefixed JSON wire). This is the "global PID/
// registry" piece of transparent distribution — name-based discovery across nodes,
// the distributed analog of the in-process otp.registry (#18).
//
//   spawn fn()                          // on the registry node:
//       registry_run("0.0.0.0"-ish port, n_requests)
//   reg_register(host, port, "worker", "10.0.0.5:7000")   // -> 1
//   reg_whereis(host, port, "worker")                     // -> "10.0.0.5:7000" or ""
//
// Protocol: a request is {"op": "register"|"whereis", "name": ..., "addr": ...}; the
// reply is 1 (register ok) or the address string ("" if absent).
// ══════════════════════════════════════════════════════════════════════════════

// Registry node: bind `port`, serve exactly `n` requests (bounded so callers/tests
// terminate deterministically), holding the name->addr map across connections.
fn registry_run(port: int, n: int)
    let l = remote_bind(port)
    let reg = {}
    let i = 0
    while i < n
        let c = remote_accept(l)
        let req = remote_recv(c)
        let op = req["op"]
        if op == "register"
            reg[req["name"]] = req["addr"]
            remote_send(c, 1)
        else
            if contains(reg, req["name"])
                remote_send(c, reg[req["name"]])
            else
                remote_send(c, "")
        remote_close(c)
        i = i + 1
    remote_close(l)

// register `name` -> `addr` with the registry at host:port. Returns 1 on success.
fn reg_register(host: string, port: int, name: string, addr: string) -> int
    let ch = remote_connect(host, port)
    remote_send(ch, {"op": "register", "name": name, "addr": addr})
    let r = remote_recv(ch)
    remote_close(ch)
    r

// look up `name` at the registry; returns its address, or "" if not registered.
fn reg_whereis(host: string, port: int, name: string) -> string
    let ch = remote_connect(host, port)
    remote_send(ch, {"op": "whereis", "name": name, "addr": ""})
    let r = remote_recv(ch)
    remote_close(ch)
    r

fn main()
    let port = 19876
    spawn fn()
        registry_run(port, 2)
    sleep(100)
    let r = reg_register("127.0.0.1", port, "svc", "10.0.0.1:80")
    assert(r == 1, "register ok")
    let addr = reg_whereis("127.0.0.1", port, "svc")
    assert(addr == "10.0.0.1:80", "whereis ok")
    print("cluster: passed")
