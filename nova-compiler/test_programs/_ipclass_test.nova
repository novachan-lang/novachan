import std/net/ipclass

fn cks(label: string, got: string, want: string)
    if got == want
        return
    print("FAIL " + label + ": got=" + got + " want=" + want)
    exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got == want
        return
    let gs = "false"
    if got
        gs = "true"
    let ws = "false"
    if want
        ws = "true"
    print("FAIL " + label + ": got=" + gs + " want=" + ws)
    exit(1)

fn main()
    // ic_class — RFC 791 class boundaries
    cks("class_A_10",       ic_class("10.0.0.1"),      "A")   // first octet 0..127
    cks("class_A_0",        ic_class("0.0.0.0"),       "A")   // boundary: 0
    cks("class_A_127",      ic_class("127.255.255.255"),"A")  // boundary: 127
    cks("class_B_172",      ic_class("172.16.0.1"),    "B")   // first octet 128..191
    cks("class_B_128",      ic_class("128.0.0.1"),     "B")   // boundary: 128
    cks("class_B_191",      ic_class("191.0.0.1"),     "B")   // boundary: 191
    cks("class_C_192",      ic_class("192.168.1.1"),   "C")   // first octet 192..223
    cks("class_C_223",      ic_class("223.255.255.255"),"C")  // boundary: 223
    cks("class_D_224",      ic_class("224.0.0.1"),     "D")   // multicast
    cks("class_D_239",      ic_class("239.1.1.1"),     "D")   // boundary: 239
    cks("class_E_240",      ic_class("240.0.0.1"),     "E")   // reserved
    cks("class_E_255",      ic_class("255.255.255.255"),"E")  // boundary: 255
    cks("class_bad",        ic_class("256.1.1.1"),     "")    // malformed
    cks("class_short",      ic_class("192.168.1"),     "")    // too few octets

    // ic_is_private — RFC 1918
    ckb("priv_10",          ic_is_private("10.1.2.3"),        true)
    ckb("priv_10_bcast",    ic_is_private("10.255.255.255"),   true)
    ckb("priv_172_16",      ic_is_private("172.16.5.5"),       true)
    ckb("priv_172_31",      ic_is_private("172.31.255.255"),   true)
    ckb("priv_172_32_out",  ic_is_private("172.32.0.1"),       false) // outside /12
    ckb("priv_172_15_out",  ic_is_private("172.15.0.1"),       false) // below 16
    ckb("priv_192_168",     ic_is_private("192.168.0.1"),      true)
    ckb("priv_192_168_hi",  ic_is_private("192.168.255.254"),  true)
    ckb("priv_192_169_out", ic_is_private("192.169.0.1"),      false)
    ckb("priv_8888",        ic_is_private("8.8.8.8"),          false)
    ckb("priv_bad",         ic_is_private("999.1.1.1"),        false)

    // ic_is_loopback — 127.0.0.0/8
    ckb("loop_127001",      ic_is_loopback("127.0.0.1"),       true)
    ckb("loop_127_hi",      ic_is_loopback("127.255.0.0"),     true)
    ckb("loop_128",         ic_is_loopback("128.0.0.1"),       false)
    ckb("loop_10",          ic_is_loopback("10.0.0.1"),        false)
    ckb("loop_bad",         ic_is_loopback("abc.def.ghi.jkl"), false)

    // ic_is_multicast — 224..239 first octet
    ckb("mcast_224",        ic_is_multicast("224.0.0.1"),      true)
    ckb("mcast_239",        ic_is_multicast("239.1.1.1"),      true)
    ckb("mcast_223_out",    ic_is_multicast("223.0.0.1"),      false)
    ckb("mcast_240_out",    ic_is_multicast("240.0.0.1"),      false)
    ckb("mcast_bad",        ic_is_multicast("bad"),            false)

    // ic_is_link_local — 169.254.0.0/16
    ckb("ll_169_254",       ic_is_link_local("169.254.1.1"),   true)
    ckb("ll_169_254_zero",  ic_is_link_local("169.254.0.0"),   true)
    ckb("ll_169_253_out",   ic_is_link_local("169.253.1.1"),   false)
    ckb("ll_170_254_out",   ic_is_link_local("170.254.1.1"),   false)
    ckb("ll_bad",           ic_is_link_local("169.254"),       false)

    print("_ipclass_test passed")
