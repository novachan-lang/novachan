// _spawn_arena_test -- a spawned task's captured heap environment must survive the SPAWNER's arena_exit.
// spawn deep-copies the captured env for task isolation; that copy is an ownership transfer to the new
// task, so it must land in the RC heap, NOT the spawner's active arena (which is freed at arena_exit while
// the task still holds the copy -> heap-use-after-free). This guards the fix in nova_rt_spawn (sibling to
// the channel-send-in-arena UAF fix). Without the fix this reads freed arena memory (garbage/crash).
fn _worker(captured: string, done)
    // runs AFTER the spawner's arena_exit -- must see an intact copy, not freed arena bytes
    send(done, "got:" + captured)

fn main()
    let done = channel()
    let prev = arena_enter()
    let payload = "payload-" + str(12345)   // arena-allocated heap string
    spawn fn()
        _worker(payload, done)               // payload captured -> deep-copied into the new task
    arena_exit(prev)                         // free the arena; the captured copy must NOT live here
    let r = recv(done)                       // parks main -> the worker runs now (arena already gone)
    assert(r == "got:payload-12345", "spawn-captured heap value survived the spawner's arena_exit (got '" + r + "')")
    print("PASS: spawn-in-arena -- captured env escapes to the RC heap, no UAF")
    print("_spawn_arena_test passed")
