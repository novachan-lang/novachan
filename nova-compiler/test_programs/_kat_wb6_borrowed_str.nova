// KAT: Wave-B #6 must NOT drop the result of str() on a value that is ALREADY a string.
// nova_rt_any_to_str returns its ARGUMENT unchanged for RAW/FAT_STR, so `str(d["k"])`
// hands back the CONTAINER'S own string. Dropping that as a "fresh temp" freed a value
// the dict still owned -- ASAN caught it in real_http_api as a heap-use-after-free
// (allocated by nova_rt_slice, freed by nova_rt_rc_drop_temp, then read by any_to_str).
// The symptom was a name coming back as a raw heap pointer rendered as an integer.
fn render(item) -> string
    // str() on an already-string field: the borrowed-return case
    return "id=" + str(item["id"]) + " name=" + str(item["name"])

fn main()
    let items = []
    let i = 0
    while i < 20
        // slice() so the stored string is a FRESH heap allocation, exactly like the
        // _json_field(...) path that originally exposed this
        let raw = "xxxxxxxxx" + "widget" + str(i) + "yyy"
        push(items, {"id": i, "name": slice(raw, 9, len(raw) - 3)})
        i = i + 1

    // First pass renders every item -- this is where the bogus drop happened
    let first = []
    for it in items
        push(first, render(it))

    // churn so any freed buffer would be reused with different content
    let j = 0
    let churned = 0
    while j < 3000
        let tmp = "churn" + str(j)
        churned = churned + len(tmp)
        j = j + 1

    // Second pass must produce identical output: the strings must still be alive
    let bad = 0
    let k = 0
    while k < 20
        if items[k]["name"] != "widget" + str(k)
            bad = bad + 1
        if render(items[k]) != first[k]
            bad = bad + 1
        k = k + 1

    print("churn=" + str(churned))
    print("corrupted: " + str(bad) + "/40")
    print("sample: " + str(items[0]["name"]))
    if bad == 0
        print("KAT wb6_borrowed_str PASS")
    else
        print("KAT wb6_borrowed_str FAIL")
