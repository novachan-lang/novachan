import forge_webhook_dispatcher

fn main()
    let w = wd_new()
    w = wd_register(w, "order.created", "https://hook1.example.com")
    w = wd_register(w, "order.created", "https://hook2.example.com")
    w = wd_register(w, "user.signup", "https://hook3.example.com")
    assert(wd_hook_count(w) == 3, "3 hooks")

    let sent = wd_dispatch(w, "order.created")
    assert(sent == 2, "2 dispatched")
    assert(wd_total_dispatches(w) == 2, "2 total")

    let sent2 = wd_dispatch(w, "user.signup")
    assert(sent2 == 1, "1 signup dispatched")

    let sent3 = wd_dispatch(w, "unknown.event")
    assert(sent3 == 0, "0 for unknown")

    let d = wd_disable(w, 0)
    assert(is_ok(d), "disable ok")
    w = unwrap(d)
    let sent4 = wd_dispatch(w, "order.created")
    assert(sent4 == 1, "1 after disable")

    let url = wd_url(w, 2)
    assert(is_ok(url), "url ok")
    assert(unwrap(url) == "https://hook3.example.com", "url match")

    let bad = wd_disable(w, 10)
    assert(is_err(bad), "out of range")

    print("WEBHOOK-DISPATCHER KAT PASS")
