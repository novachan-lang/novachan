// KAT for std/data/sub_filter
// Tests sub_in_range, sub_search, sub_at, sub_remove_range
import std/data/sub_filter

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got [" + got + "] expected [" + expected + "]")
        exit(1)

// _make_cue: build a cue dict
fn _make_cue(idx, start_ms, end_ms, txt)
    let c = {}
    c["index"] = idx
    c["start"] = start_ms
    c["end"] = end_ms
    c["text"] = txt
    return c

fn main()
    // Build 3 cues: 1000-4000, 5000-8000, 9000-12000
    let c0 = _make_cue(1, 1000, 4000, "Hello world")
    let c1 = _make_cue(2, 5000, 8000, "Goodbye world")
    let c2 = _make_cue(3, 9000, 12000, "Hello again")
    let cues = []
    push(cues, c0)
    push(cues, c1)
    push(cues, c2)

    // ── sub_at ──────────────────────────────────────────────────────────────
    // KAT 1: sub_at(cues, 6000) returns the 5000-8000 cue
    let at6 = sub_at(cues, 6000)
    cki("at6_start", at6["start"], 5000)
    cki("at6_end", at6["end"], 8000)
    cki("at6_index", at6["index"], 2)

    // KAT 2: sub_at(cues, 4500) returns empty dict (gap between cues)
    let at4500 = sub_at(cues, 4500)
    cki("at4500_empty", len(keys(at4500)), 0)

    // KAT 3: sub_at on exact start boundary — inclusive
    let at1000 = sub_at(cues, 1000)
    cki("at1000_start", at1000["start"], 1000)

    // KAT 4: sub_at on exact end boundary — exclusive (should be empty/next)
    let at4000 = sub_at(cues, 4000)
    cki("at4000_empty", len(keys(at4000)), 0)

    // ── sub_search ───────────────────────────────────────────────────────────
    // KAT 5: sub_search finds "Hello" in cues 1 and 3
    let found_hello = sub_search(cues, "Hello")
    cki("search_hello_count", len(found_hello), 2)

    // KAT 6: first match is cue 1
    let fh0 = found_hello[0]
    cki("search_hello_0_start", fh0["start"], 1000)

    // KAT 7: second match is cue 3
    let fh1 = found_hello[1]
    cki("search_hello_1_start", fh1["start"], 9000)

    // KAT 8: search for "world" finds 2 cues (cues 1 and 2)
    let found_world = sub_search(cues, "world")
    cki("search_world_count", len(found_world), 2)

    // KAT 9: search for absent text returns empty
    let found_xyz = sub_search(cues, "xyz")
    cki("search_xyz_count", len(found_xyz), 0)

    // KAT 10: search empty needle returns all cues
    let found_all = sub_search(cues, "")
    cki("search_empty_count", len(found_all), 3)

    // ── sub_in_range ─────────────────────────────────────────────────────────
    // KAT 11: window [4500,8500] overlaps cues 5000-8000 only
    let in_range1 = sub_in_range(cues, 4500, 8500)
    cki("in_range_4500_8500_count", len(in_range1), 1)
    let ir1c0 = in_range1[0]
    cki("in_range_4500_8500_start", ir1c0["start"], 5000)

    // KAT 12: window [0, 15000] covers all 3 cues
    let in_range_all = sub_in_range(cues, 0, 15000)
    cki("in_range_all_count", len(in_range_all), 3)

    // KAT 13: window [0, 500] covers nothing
    let in_range_none = sub_in_range(cues, 0, 500)
    cki("in_range_none_count", len(in_range_none), 0)

    // KAT 14: exact boundary — window ends at cue start: [0,1000] covers nothing
    // (cue.start < to_ms must be false: 1000 < 1000 is false)
    let in_range_boundary = sub_in_range(cues, 0, 1000)
    cki("in_range_boundary_count", len(in_range_boundary), 0)

    // ── sub_remove_range ─────────────────────────────────────────────────────
    // KAT 15: remove [5000,8000] leaves cues 1 and 3
    let removed = sub_remove_range(cues, 5000, 8000)
    cki("remove_5000_8000_count", len(removed), 2)
    let rm0 = removed[0]
    cki("remove_5000_8000_first_start", rm0["start"], 1000)
    let rm1 = removed[1]
    cki("remove_5000_8000_second_start", rm1["start"], 9000)

    // KAT 16: remove nothing — window [20000,30000] keeps all
    let removed_none = sub_remove_range(cues, 20000, 30000)
    cki("remove_none_count", len(removed_none), 3)

    // KAT 17: remove all — window [0,15000] removes all
    let removed_all = sub_remove_range(cues, 0, 15000)
    cki("remove_all_count", len(removed_all), 0)

    print("PASS _sub_filter_test")

main()
