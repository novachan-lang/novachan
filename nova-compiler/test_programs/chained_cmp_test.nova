fn classify(x: int) -> string
    if 0 <= x < 10
        "single"
    else if 10 <= x < 100
        "double"
    else if 100 <= x < 1000
        "triple"
    else
        "big"

fn main()
    // Basic chained: a < b < c
    assert_true(1 < 2 < 3)
    assert_true(not (1 < 2 < 2))
    assert_true(not (3 < 2 < 5))

    // Mixed operators
    assert_true(1 <= 1 < 2)
    assert_true(1 <= 2 <= 2)
    assert_true(not (1 < 1 <= 2))

    // Greater-than chains
    assert_true(5 > 3 > 1)
    assert_true(not (5 > 3 > 3))
    assert_true(10 >= 10 > 5)

    // Equality in chain
    assert_true(1 == 1 == 1)
    assert_true(not (1 == 1 == 2))

    // Three+ comparisons (a < b < c < d)
    assert_true(1 < 2 < 3 < 4)
    assert_true(not (1 < 2 < 3 < 3))
    assert_true(0 <= 1 <= 2 <= 3)

    // Real use: range check
    let x = 42
    assert_true(0 <= x < 100)
    assert_true(not (0 <= x < 10))

    // Use in function
    assert_eq(classify(5), "single")
    assert_eq(classify(42), "double")
    assert_eq(classify(999), "triple")
    assert_eq(classify(1000), "big")

    // Negative values
    assert_true(-10 < -5 < 0)
    assert_true(-5 <= 0 <= 5)

    // Variables on all sides
    let a = 1
    let b = 5
    let c = 10
    assert_true(a < b < c)
    assert_true(not (c < b < a))

    print("chained_cmp_test: all passed")
