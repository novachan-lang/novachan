import forge_request_tracer

fn main()
    let r = rt_new()
    r = rt_trace(r, "GET", "/api/users", 200, 50)
    r = rt_trace(r, "POST", "/api/orders", 201, 120)
    r = rt_trace(r, "GET", "/api/health", 200, 10)
    assert(rt_trace_count(r) == 3, "3 traces")

    let m = rt_get_method(r, 0)
    assert(is_ok(m), "method ok")
    assert(unwrap(m) == "GET", "GET")

    let p = rt_get_path(r, 1)
    assert(is_ok(p), "path ok")
    assert(unwrap(p) == "/api/orders", "orders path")

    let s = rt_get_status(r, 1)
    assert(is_ok(s), "status ok")
    assert(unwrap(s) == 201, "201")

    let d = rt_get_duration(r, 2)
    assert(is_ok(d), "dur ok")
    assert(unwrap(d) == 10, "10ms")

    let avg = rt_avg_duration(r)
    assert(is_ok(avg), "avg ok")
    assert(unwrap(avg) == 60, "avg=60")

    assert(rt_total_duration(r) == 180, "180ms total")

    let bad = rt_get_method(r, 5)
    assert(is_err(bad), "out of range")

    print("REQUEST-TRACER KAT PASS")
