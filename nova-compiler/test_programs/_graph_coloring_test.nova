import std/graph/graph_coloring

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn main()
    // KAT 1: gc_chromatic([[1,2],[0,2],[0,1]],3)=3
    // Triangle K3: chromatic number = 3
    let adj_tri = []
    push(adj_tri, [1, 2])
    push(adj_tri, [0, 2])
    push(adj_tri, [0, 1])
    cki("chromatic_k3", gc_chromatic(adj_tri, 3), 3)

    // KAT 2: gc_chromatic([[1],[0,2,3],[1],[1]],4)=2
    // Node 0 connects to 1; node 1 connects to 0,2,3; nodes 2,3 connect to 1 only
    // This is bipartite: {0,2,3} vs {1} => chromatic = 2
    let adj_bip = []
    push(adj_bip, [1])
    push(adj_bip, [0, 2, 3])
    push(adj_bip, [1])
    push(adj_bip, [1])
    cki("chromatic_bipartite", gc_chromatic(adj_bip, 4), 2)

    // KAT 3: gc_is_m_colorable([[1,2],[0,2],[0,1]],3,2)=false
    // Triangle cannot be 2-colored
    ckb("m_colorable_k3_2_false", gc_is_m_colorable(adj_tri, 3, 2), false)

    // KAT 4: gc_is_m_colorable([[1,2],[0,2],[0,1]],3,3)=true
    // Triangle can be 3-colored
    ckb("m_colorable_k3_3_true", gc_is_m_colorable(adj_tri, 3, 3), true)

    // KAT 5: gc_chromatic([[1],[0]],2)=2
    // Single edge: chromatic = 2
    let adj_edge = []
    push(adj_edge, [1])
    push(adj_edge, [0])
    cki("chromatic_single_edge", gc_chromatic(adj_edge, 2), 2)

    // KAT 6: gc_chromatic([[],[],[]],3)=1
    // Three isolated nodes: chromatic = 1
    let adj_iso = []
    push(adj_iso, [])
    push(adj_iso, [])
    push(adj_iso, [])
    cki("chromatic_isolated", gc_chromatic(adj_iso, 3), 1)

    // Additional: empty graph
    cki("chromatic_empty", gc_chromatic([], 0), 0)

    // Additional: K4 chromatic = 4
    let adj_k4 = []
    push(adj_k4, [1, 2, 3])
    push(adj_k4, [0, 2, 3])
    push(adj_k4, [0, 1, 3])
    push(adj_k4, [0, 1, 2])
    cki("chromatic_k4", gc_chromatic(adj_k4, 4), 4)

    // Additional: path 0-1-2-3 (bipartite): chromatic = 2
    let adj_path = []
    push(adj_path, [1])
    push(adj_path, [0, 2])
    push(adj_path, [1, 3])
    push(adj_path, [2])
    cki("chromatic_path4", gc_chromatic(adj_path, 4), 2)

    // Greedy on triangle: should use 3 colors
    cki("greedy_colors_k3", gc_num_colors_greedy(adj_tri, 3), 3)

    // Greedy on isolated nodes: should use 1 color
    cki("greedy_colors_iso", gc_num_colors_greedy(adj_iso, 3), 1)

    // Verify greedy coloring is valid for triangle (no two neighbors same color)
    let col = gc_greedy(adj_tri, 3)
    cki("greedy_k3_len", len(col), 3)
    // node 0 and node 1 must differ
    let ok01 = 1
    if col[0] == col[1]
        ok01 = 0
    cki("greedy_k3_01_diff", ok01, 1)
    // node 0 and node 2 must differ
    let ok02 = 1
    if col[0] == col[2]
        ok02 = 0
    cki("greedy_k3_02_diff", ok02, 1)
    // node 1 and node 2 must differ
    let ok12 = 1
    if col[1] == col[2]
        ok12 = 0
    cki("greedy_k3_12_diff", ok12, 1)

    print("PASS _graph_coloring_test")

main()
