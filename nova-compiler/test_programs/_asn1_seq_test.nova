// _asn1_seq_test — KAT for std/data/asn1_seq
//
// Verifies byte-exact DER encoding of SEQUENCE and SET, and round-trip
// decode for all canonical vectors from the module task.
//
// KAT vectors (X.690 / RFC 5280 verified):
//   i1 = [0x02,0x01,0x01], i2 = [0x02,0x01,0x02]
//   asn1_seq_encode([i1,i2]) == [0x30,0x06,0x02,0x01,0x01,0x02,0x01,0x02]
//   asn1_set_encode([i1])    == [0x31,0x03,0x02,0x01,0x01]
//   Nested seq:              == [0x30,0x05,0x30,0x03,0x02,0x01,0x01]
//   Decode two-int seq: child[0]==[0x02,0x01,0x01], child[1]==[0x02,0x01,0x02]
//   Long-length: 200-byte SEQUENCE content -> tag=0x30, len=[0x81,0xC8]

import std/data/asn1_seq

// ck_int: assert two ints equal; on mismatch print FAIL and exit(1)
fn ck_int(label, got, want)
    if got != want
        print("FAIL asn1_seq " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// ck_bytes: assert two bytes values are equal byte-by-byte
fn ck_bytes(label, got, want)
    let glen = bytes_len(got)
    let wlen = bytes_len(want)
    if glen != wlen
        print("FAIL asn1_seq " + label + ": len got " + str(glen) + " want " + str(wlen))
        exit(1)
    let i = 0
    while i < glen
        let gb = bytes_get(got, i)
        let wb = bytes_get(want, i)
        if gb != wb
            print("FAIL asn1_seq " + label + " byte[" + str(i) + "]: got " + str(gb) + " want " + str(wb))
            exit(1)
        i = i + 1

// build_bytes3: construct a 3-byte bytes value from three int values
fn build_bytes3(a, b, c) -> any
    let out = bytes(3)
    bytes_set(out, 0, a)
    bytes_set(out, 1, b)
    bytes_set(out, 2, c)
    out

fn main()
    // ── Setup: canonical child TLVs ──────────────────────────────────────────
    // i1 = INTEGER 1 = [0x02, 0x01, 0x01]
    // i2 = INTEGER 2 = [0x02, 0x01, 0x02]
    let i1 = build_bytes3(2, 1, 1)
    let i2 = build_bytes3(2, 1, 2)

    // ── KAT 1: asn1_seq_encode([i1,i2]) == [0x30,0x06,0x02,0x01,0x01,0x02,0x01,0x02] ──
    let want1 = bytes(8)
    bytes_set(want1, 0, 48)
    bytes_set(want1, 1, 6)
    bytes_set(want1, 2, 2)
    bytes_set(want1, 3, 1)
    bytes_set(want1, 4, 1)
    bytes_set(want1, 5, 2)
    bytes_set(want1, 6, 1)
    bytes_set(want1, 7, 2)
    let got1 = asn1_seq_encode([i1, i2])
    ck_bytes("seq_encode([i1,i2])", got1, want1)
    // spot-check key fields
    ck_int("seq_encode tag",  bytes_get(got1, 0), 48)
    ck_int("seq_encode clen", bytes_get(got1, 1), 6)
    ck_int("seq_encode total_len", bytes_len(got1), 8)
    print("PASS kat1: asn1_seq_encode([i1,i2])")

    // ── KAT 2: asn1_set_encode([i1]) == [0x31,0x03,0x02,0x01,0x01] ──────────
    let want2 = bytes(5)
    bytes_set(want2, 0, 49)
    bytes_set(want2, 1, 3)
    bytes_set(want2, 2, 2)
    bytes_set(want2, 3, 1)
    bytes_set(want2, 4, 1)
    let got2 = asn1_set_encode([i1])
    ck_bytes("set_encode([i1])", got2, want2)
    ck_int("set_encode tag",  bytes_get(got2, 0), 49)
    ck_int("set_encode clen", bytes_get(got2, 1), 3)
    ck_int("set_encode total_len", bytes_len(got2), 5)
    print("PASS kat2: asn1_set_encode([i1])")

    // ── KAT 3: nested SEQUENCE == [0x30,0x05,0x30,0x03,0x02,0x01,0x01] ──────
    // asn1_seq_encode([i1]) = [0x30,0x03,0x02,0x01,0x01] (inner)
    // asn1_seq_encode([inner]) = [0x30,0x05,0x30,0x03,0x02,0x01,0x01]
    let inner = asn1_seq_encode([i1])
    ck_int("inner tag",  bytes_get(inner, 0), 48)
    ck_int("inner clen", bytes_get(inner, 1), 3)
    ck_int("inner len",  bytes_len(inner), 5)
    let nested = asn1_seq_encode([inner])
    let want3 = bytes(7)
    bytes_set(want3, 0, 48)
    bytes_set(want3, 1, 5)
    bytes_set(want3, 2, 48)
    bytes_set(want3, 3, 3)
    bytes_set(want3, 4, 2)
    bytes_set(want3, 5, 1)
    bytes_set(want3, 6, 1)
    ck_bytes("nested_seq", nested, want3)
    ck_int("nested tag",  bytes_get(nested, 0), 48)
    ck_int("nested clen", bytes_get(nested, 1), 5)
    ck_int("nested len",  bytes_len(nested), 7)
    print("PASS kat3: nested asn1_seq_encode")

    // ── KAT 4: empty SEQUENCE == [0x30, 0x00] ────────────────────────────────
    let empty_seq = asn1_seq_encode([])
    ck_int("empty_seq tag",  bytes_get(empty_seq, 0), 48)
    ck_int("empty_seq clen", bytes_get(empty_seq, 1), 0)
    ck_int("empty_seq len",  bytes_len(empty_seq), 2)
    print("PASS kat4: asn1_seq_encode([]) empty sequence")

    // ── KAT 5: asn1_seq_decode round-trip on [i1,i2] ──────────────────────────
    // Decode got1 (the [i1,i2] sequence from KAT1)
    let dr = asn1_seq_decode(got1, 0)
    let kids = dr[0]
    let next_pos = dr[1]
    ck_int("decode next_pos", next_pos, 8)
    ck_int("decode num_children", len(kids), 2)
    // child 0 should be i1 = [0x02,0x01,0x01]
    let c0 = kids[0]
    ck_int("decode c0 len", bytes_len(c0), 3)
    ck_int("decode c0[0]",  bytes_get(c0, 0), 2)
    ck_int("decode c0[1]",  bytes_get(c0, 1), 1)
    ck_int("decode c0[2]",  bytes_get(c0, 2), 1)
    // child 1 should be i2 = [0x02,0x01,0x02]
    let c1 = kids[1]
    ck_int("decode c1 len", bytes_len(c1), 3)
    ck_int("decode c1[0]",  bytes_get(c1, 0), 2)
    ck_int("decode c1[1]",  bytes_get(c1, 1), 1)
    ck_int("decode c1[2]",  bytes_get(c1, 2), 2)
    print("PASS kat5: asn1_seq_decode round-trip [i1,i2]")

    // ── KAT 6: decode empty SEQUENCE → 0 children ─────────────────────────────
    let dr_empty = asn1_seq_decode(empty_seq, 0)
    ck_int("decode_empty next_pos",   dr_empty[1], 2)
    ck_int("decode_empty num_children", len(dr_empty[0]), 0)
    print("PASS kat6: asn1_seq_decode empty sequence")

    // ── KAT 7: decode nested SEQUENCE → 1 child which is itself a SEQUENCE ────
    let dr_nested = asn1_seq_decode(nested, 0)
    ck_int("nested_decode next_pos", dr_nested[1], 7)
    ck_int("nested_decode num_children", len(dr_nested[0]), 1)
    let nc0 = dr_nested[0][0]
    ck_int("nested_decode child tag",  bytes_get(nc0, 0), 48)
    ck_int("nested_decode child clen", bytes_get(nc0, 1), 3)
    ck_int("nested_decode child len",  bytes_len(nc0), 5)
    print("PASS kat7: asn1_seq_decode nested sequence")

    // ── KAT 8: decode at non-zero offset ──────────────────────────────────────
    // Prepend exactly 1 dummy byte (value 0xFF) before the sequence.
    // bytes(1) = one zero byte; we set it to 0xFF then concat got1.
    // Sequence starts at offset 1; next_pos = 1 + 8 = 9.
    let dummy1 = bytes(1)
    bytes_set(dummy1, 0, 255)
    let shifted = bytes_concat(dummy1, got1)
    let dr_off = asn1_seq_decode(shifted, 1)
    ck_int("offset decode next_pos", dr_off[1], 9)
    ck_int("offset decode num_children", len(dr_off[0]), 2)
    print("PASS kat8: asn1_seq_decode at non-zero offset")

    // ── KAT 9: long-form length — SEQUENCE whose content totals >=128 bytes ────
    // Build one child: OCTET STRING (tag 0x04) wrapping 200 zero bytes.
    // That child TLV = [0x04, 0x81, 0xC8, ...200 zeros...] = 203 bytes.
    // Then SEQUENCE wrapping that child has content length 203.
    // Outer SEQUENCE: [0x30, 0x82, 0x00, 0xCB, <203 bytes child>]
    // total = 1+3+203 = 207 bytes.
    //
    // But the spec says "200-byte value -> tag 81 C8 then 200 bytes" for the
    // length field.  We test the SEQUENCE whose own content is exactly 200 bytes.
    // A single OCTET STRING child of 197 bytes has TLV = [0x04, 0x81, 0xC5, ...197 bytes...]
    // = 200 bytes total.  The outer SEQUENCE content = 200 bytes → [0x30, 0x81, 0xC8, ...]
    //
    // Simplest: build a 197-byte OCTET STRING child.
    // Child TLV: tag=4, len=[0x81,0xC5], content=197 zeros => total child = 200 bytes.
    let os_content = bytes(197)
    // Build the OCTET STRING child manually (tag 0x04 + long-form length 197)
    let os_child = bytes(0)
    os_child = bytes_append(os_child, 4)
    os_child = bytes_append(os_child, 129)
    os_child = bytes_append(os_child, 197)
    os_child = bytes_concat(os_child, os_content)
    ck_int("os_child_len", bytes_len(os_child), 200)
    // Now wrap in SEQUENCE — content is exactly 200 bytes
    let big_seq = asn1_seq_encode([os_child])
    // Expected outer: [0x30, 0x81, 0xC8, ...200 bytes of os_child...]
    // total = 1 + 2 + 200 = 203
    ck_int("long_seq total_len", bytes_len(big_seq), 203)
    ck_int("long_seq tag",  bytes_get(big_seq, 0), 48)
    ck_int("long_seq len1", bytes_get(big_seq, 1), 129)
    ck_int("long_seq len2", bytes_get(big_seq, 2), 200)
    // Round-trip decode: 1 child = os_child
    let dr_big = asn1_seq_decode(big_seq, 0)
    ck_int("long_seq decode next_pos", dr_big[1], 203)
    ck_int("long_seq decode num_children", len(dr_big[0]), 1)
    let bc0 = dr_big[0][0]
    ck_int("long_seq decode child_len", bytes_len(bc0), 200)
    ck_bytes("long_seq decode child_bytes", bc0, os_child)
    print("PASS kat9: long-form length SEQUENCE with 200-byte content")

    // ── KAT 10: asn1_set_decode round-trip ───────────────────────────────────
    let dr_set = asn1_set_decode(got2, 0)
    ck_int("set_decode next_pos", dr_set[1], 5)
    ck_int("set_decode num_children", len(dr_set[0]), 1)
    let sc0 = dr_set[0][0]
    ck_bytes("set_decode child0", sc0, i1)
    print("PASS kat10: asn1_set_decode round-trip")

    // ── KAT 11: error handling — wrong tag ────────────────────────────────────
    // Try to seq_decode something with tag 0x02 (INTEGER)
    let bad_tag = build_bytes3(2, 1, 0)
    let dr_bad = asn1_seq_decode(bad_tag, 0)
    ck_int("bad_tag next_pos", dr_bad[1], -1)
    ck_int("bad_tag num_children", len(dr_bad[0]), 0)
    print("PASS kat11: asn1_seq_decode rejects wrong tag")

    // ── KAT 12: error handling — truncated content ─────────────────────────────
    // SEQUENCE claims content length 10 but only 2 bytes follow
    let trunc = bytes(4)
    bytes_set(trunc, 0, 48)
    bytes_set(trunc, 1, 10)
    bytes_set(trunc, 2, 2)
    bytes_set(trunc, 3, 1)
    let dr_trunc = asn1_seq_decode(trunc, 0)
    ck_int("trunc next_pos", dr_trunc[1], -1)
    ck_int("trunc num_children", len(dr_trunc[0]), 0)
    print("PASS kat12: asn1_seq_decode rejects truncated content")

    // ── KAT 13: full encode->decode round-trip matches original bytes ──────────
    // Build [i1, i2], encode, decode children, verify children match i1 and i2
    let enc = asn1_seq_encode([i1, i2])
    let dec = asn1_seq_decode(enc, 0)
    let ch = dec[0]
    ck_bytes("roundtrip child0", ch[0], i1)
    ck_bytes("roundtrip child1", ch[1], i2)
    print("PASS kat13: full encode->decode round-trip byte equality")

    print("PASS _asn1_seq_test")

main()
