import std/interval/interval_tree2

fn build_direct()
    let ivs = []
    push(ivs, [1,3])
    push(ivs, [5,8])
    push(ivs, [6,10])
    push(ivs, [15,20])
    let t = {}
    t["ivs"] = ivs
    t["n"] = 4
    return t

fn main()
    // Direct build (no sort)
    let t = build_direct()
    let all = it_all(t)
    let i = 0
    while i < len(all)
        let ii = i
        let iv = all[ii]
        print("direct[" + str(ii) + "]=" + str(iv[0]) + "," + str(iv[1]))
        i = i + 1

main()
