import std/statistics/stat_correlation

fn ckf(label: string, got: float, want: float)
    let d = got - want
    if d < 0.0
        d = 0.0 - d
    if d > 0.001
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    let xa = [1, 2, 3]
    let ya = [2, 4, 6]
    ckf("pearson_pos1", sc_pearson(xa, ya), 1.0)
    let yb = [6, 4, 2]
    ckf("pearson_neg1", sc_pearson(xa, yb), -1.0)
    ckf("cov_same", sc_covariance(xa, xa), 0.6667)
    let xb = [1, 2, 3, 4, 5]
    ckf("pearson_self", sc_pearson(xb, xb), 1.0)
    let yc = [4, 5, 6]
    ckf("cov_offset", sc_covariance(xa, yc), 0.6667)
    let em = []
    ckf("pearson_empty", sc_pearson(em, em), 0.0)
    ckf("cov_empty", sc_covariance(em, em), 0.0)
    ckf("variance_xs", sc_variance(xa), 0.6667)
    let cv = [3, 3, 3]
    ckf("variance_const", sc_variance(cv), 0.0)
    print("PASS _stat_correlation_test")
