// Test: nova test function discovery — no main() needed
// The test runner auto-generates a harness that calls each test_ function

fn test_addition()
    assert(1 + 1 == 2, "1+1 should be 2")
    assert(10 + 20 == 30, "10+20 should be 30")
    print("  addition ok")

fn test_strings()
    let s = "hello"
    assert(len(s) == 5, "len hello = 5")
    let s2 = upper(s)
    assert(s2 == "HELLO", "upper should work")
    print("  strings ok")

fn test_list_ops()
    let lst = [3, 1, 4, 1, 5]
    assert(len(lst) == 5, "list length")
    assert(sum(lst) == 14, "list sum")
    print("  list ops ok")

fn test_bool_logic()
    assert(1 == 1, "identity")
    assert(0 != 1, "inequality")
    assert(5 > 3, "greater")
    assert(2 < 7, "less")
    print("  bool logic ok")
