import std/os/platform

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn main()
    // KAT 1: pl_os() is non-empty
    let os = pl_os()
    if len(os) == 0
        print("FAIL pl_os() is empty")
        exit(1)

    // KAT 2: exactly one of is_windows/is_linux/is_macos is true (sum == 1)
    let win_i = 0
    if pl_is_windows()
        win_i = 1
    let lin_i = 0
    if pl_is_linux()
        lin_i = 1
    let mac_i = 0
    if pl_is_macos()
        mac_i = 1
    let os_sum = win_i + lin_i + mac_i
    cki("exactly_one_os", os_sum, 1)

    // KAT 3: pl_is_posix() == (is_linux OR is_macos)
    let posix_expected = false
    if pl_is_linux()
        posix_expected = true
    if pl_is_macos()
        posix_expected = true
    ckb("posix_eq_linux_or_mac", pl_is_posix(), posix_expected)

    // KAT 4: pl_path_sep() is "/" or backslash (chr(92)) — length 1, one of the two
    let sep = pl_path_sep()
    cki("path_sep_len", len(sep), 1)
    if sep != "/" and sep != chr(92)
        print("FAIL path_sep wrong value: " + sep)
        exit(1)

    // KAT 5: pl_line_sep() length is 1 (LF) or 2 (CRLF)
    let lsep = pl_line_sep()
    let lsep_len = len(lsep)
    if lsep_len != 1 and lsep_len != 2
        print("FAIL line_sep wrong length: " + str(lsep_len))
        exit(1)

    // KAT 6: posix and windows are mutually exclusive w.r.t. path_sep and line_sep
    if pl_is_posix()
        cks("posix_path_sep", pl_path_sep(), "/")
        cki("posix_line_sep_len", len(pl_line_sep()), 1)
    if pl_is_windows()
        cks("win_path_sep", pl_path_sep(), chr(92))
        cki("win_line_sep_len", len(pl_line_sep()), 2)

    print("_platform_test passed")
