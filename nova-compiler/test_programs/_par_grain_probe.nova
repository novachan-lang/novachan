// 4.2 DIAGNOSTIC: is the ~49% parallel efficiency at 4 carriers caused by UNEVEN
// INITIAL CLAIM rather than by the absence of work-stealing?
//
// Green tasks are pinned: a freshly-spawned task sits on the global injector with
// home_carrier = -1, and the FIRST carrier to pop it claims it permanently
// (commit 71a651d). There is no stealing afterwards. So if carriers race to claim
// and one grabs 4 of 8 tasks while another grabs 1, that imbalance is PERMANENT and
// wall-clock is set by the unluckiest carrier.
//
// The test: hold total work constant and vary the number of tasks it is split into.
//   - If speedup is roughly FLAT as task count rises, the loss is fixed overhead
//     (spawn/channel/scheduling) and work-stealing would not help much.
//   - If speedup IMPROVES with more, finer tasks, that is claim imbalance --
//     more tasks means the random claim distribution averages out. Then the cheap
//     fix is better initial distribution (round-robin the injector), not the
//     large, risky work-stealing rewrite.
//
// WORKERS is taken from the environment so one binary covers every grain size; the
// harness sweeps it. Total work is fixed, so each run does the same arithmetic.

let TOTAL = 24000000

fn crunch(seed: int, iters: int) -> int
    let acc = seed
    let i = 0
    while i < iters
        acc = acc + (i * 2654435761) % 1000003
        acc = acc % 4294967291
        i = i + 1
    acc

fn main()
    let wtxt = env("PAR_WORKERS")
    let workers = 8
    if len(wtxt) > 0
        workers = int(wtxt)
    if workers < 1
        workers = 1
    let per = TOTAL / workers

    let hub = channel()
    let w = 0
    while w < workers
        let my_seed = w + 1
        spawn fn()
            send(hub, crunch(my_seed, per))
        w = w + 1

    let total = 0
    let got = 0
    while got < workers
        total = total + receive(hub)
        got = got + 1

    // Proves the work actually ran (the 60ms/checksum=36 lesson). The value varies
    // with the split, so it is reported rather than asserted equal across runs.
    print("workers=" + str(workers) + " per=" + str(per) + " checksum=" + str(total))
    print("PAR_GRAIN_OK")
