import forge_rate_shield

fn main()
    let rs = rs_new(1000)
    rs_set_threshold(rs, "client1", 3)

    rs_request(rs, "client1", 0)
    rs_request(rs, "client1", 100)
    rs_request(rs, "client1", 200)
    assert(rs_is_blocked(rs, "client1") == 0, "under threshold, not blocked")

    rs_request(rs, "client1", 300)
    assert(rs_request_count(rs, "client1") == 4, "4 requests in window")
    assert(rs_is_blocked(rs, "client1") == 1, "auto-blocked after exceeding threshold")
    assert(rs_blocked_count(rs) == 1, "1 blocked client")

    // window rollover clears the auto-block and resets the per-window count
    rs_request(rs, "client1", 1500)
    assert(rs_is_blocked(rs, "client1") == 0, "auto-block cleared after window rollover")
    assert(rs_request_count(rs, "client1") == 1, "count reset by new window")
    assert(rs_blocked_count(rs) == 0, "0 blocked clients after rollover")

    // manual block/unblock, independent of the window mechanism
    let b = rs_block(rs, "client2")
    assert(is_ok(b), "manual block ok")
    assert(rs_is_blocked(rs, "client2") == 1, "client2 manually blocked")
    assert(rs_blocked_count(rs) == 1, "1 blocked client (client2)")

    let u = rs_unblock(rs, "client2")
    assert(is_ok(u), "manual unblock ok")
    assert(rs_is_blocked(rs, "client2") == 0, "client2 unblocked")
    assert(rs_blocked_count(rs) == 0, "0 blocked clients after unblock")

    rs_request(rs, "client3", 5000)
    assert(rs_request_count(rs, "client3") == 1, "client3's first request")
    assert(rs_total_requests(rs) == 6, "6 total requests across all clients")

    print("RATE-SHIELD KAT PASS")
