import std/scheduling/sched_metrics

fn cki(name: string, got: int, want: int)
    if got != want
        print("FAIL sched_metrics " + name + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(name: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL sched_metrics " + name + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL sched_metrics " + name + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // KAT 1: canonical example from spec
    // procs [[0,24],[0,3],[0,3]], completions [24,27,30]
    // waiting = [24-0-24, 27-0-3, 30-0-3] = [0, 24, 27]
    // turnaround = [24-0, 27-0, 30-0] = [24, 27, 30]
    // avg_waiting = (0+24+27)/3 = 51/3 = 17, x100 = 1700
    // makespan = max(24,27,30) - min(0,0,0) = 30
    // throughput_x1000 = 3*1000/30 = 100
    let procs1 = [[0,24],[0,3],[0,3]]
    let comp1 = []
    push(comp1, 24)
    push(comp1, 27)
    push(comp1, 30)

    let wt_want = []
    push(wt_want, 0)
    push(wt_want, 24)
    push(wt_want, 27)
    let wt1 = sm_waiting_times(procs1, comp1)
    ckl("waiting_times", wt1, wt_want)

    let ta_want = []
    push(ta_want, 24)
    push(ta_want, 27)
    push(ta_want, 30)
    let ta1 = sm_turnaround_times(procs1, comp1)
    ckl("turnaround_times", ta1, ta_want)

    cki("avg_waiting_x100", sm_avg_waiting_x100(procs1, comp1), 1700)
    cki("makespan", sm_makespan(procs1, comp1), 30)
    cki("throughput_x1000", sm_throughput_x1000(procs1, comp1), 100)

    // KAT 2: staggered arrivals
    // procs [[2,5],[4,3]], completions [7,10]
    // waiting = [7-2-5, 10-4-3] = [0, 3]
    // turnaround = [7-2, 10-4] = [5, 6]
    // avg_waiting = (0+3)/2 = 1, x100 = 150
    // makespan = max(7,10) - min(2,4) = 10-2 = 8
    // throughput_x1000 = 2*1000/8 = 250
    let procs2 = [[2,5],[4,3]]
    let comp2 = []
    push(comp2, 7)
    push(comp2, 10)

    let wt2_want = []
    push(wt2_want, 0)
    push(wt2_want, 3)
    let wt2 = sm_waiting_times(procs2, comp2)
    ckl("staggered_waiting", wt2, wt2_want)

    let ta2_want = []
    push(ta2_want, 5)
    push(ta2_want, 6)
    let ta2 = sm_turnaround_times(procs2, comp2)
    ckl("staggered_turnaround", ta2, ta2_want)

    cki("staggered_avg_waiting_x100", sm_avg_waiting_x100(procs2, comp2), 150)
    cki("staggered_makespan", sm_makespan(procs2, comp2), 8)
    cki("staggered_throughput_x1000", sm_throughput_x1000(procs2, comp2), 250)

    // KAT 3: single process — zero waiting, turnaround = burst
    // proc [0,10], completion [10]
    // waiting=0, turnaround=10, avg_waiting_x100=0, makespan=10, throughput=100
    let procs3 = [[0,10]]
    let comp3 = []
    push(comp3, 10)
    let wt3 = sm_waiting_times(procs3, comp3)
    cki("single_waiting", wt3[0], 0)
    let ta3 = sm_turnaround_times(procs3, comp3)
    cki("single_turnaround", ta3[0], 10)
    cki("single_avg_x100", sm_avg_waiting_x100(procs3, comp3), 0)
    cki("single_makespan", sm_makespan(procs3, comp3), 10)
    cki("single_throughput_x1000", sm_throughput_x1000(procs3, comp3), 100)

    // KAT 4: priority-scheduled example from sched_priority spec
    // procs (arr all 0): bursts 10,1,2,1,5. completions [16,1,18,19,6]
    // waiting = [6,0,16,18,1]. sum=41, avg=41/5=8, x100=820
    // makespan = 19-0=19. throughput=5*1000/19=263 (integer division)
    let procs4 = [[0,10,3],[0,1,1],[0,2,4],[0,1,5],[0,5,2]]
    let comp4 = []
    push(comp4, 16)
    push(comp4, 1)
    push(comp4, 18)
    push(comp4, 19)
    push(comp4, 6)
    cki("priority_avg_x100", sm_avg_waiting_x100(procs4, comp4), 820)
    cki("priority_makespan", sm_makespan(procs4, comp4), 19)
    cki("priority_throughput_x1000", sm_throughput_x1000(procs4, comp4), 263)

    print("PASS _sched_metrics_test")
