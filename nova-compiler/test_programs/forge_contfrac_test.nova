import forge_contfrac

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn joinl(xs: list) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + ","
        out = out + str(xs[i])
        i = i + 1
    out

fn joinpairs(xs: list) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + " "
        out = out + str(xs[i][0]) + "/" + str(xs[i][1])
        i = i + 1
    out

fn main()
    let fails = 0

    // expansion
    fails = fails + expect("exp_415", joinl(cf_expand(415, 93)), "4,2,6,7")
    fails = fails + expect("exp_22_7", joinl(cf_expand(22, 7)), "3,7")
    fails = fails + expect("exp_355", joinl(cf_expand(355, 113)), "3,7,16")
    fails = fails + expect("exp_int", joinl(cf_expand(5, 1)), "5")
    fails = fails + expect("exp_half", joinl(cf_expand(1, 2)), "0,2")

    // convergents of pi's approximation 355/113 -> 3, 22/7, 355/113
    fails = fails + expect("conv_pi", joinpairs(cf_convergents([3, 7, 16])), "3/1 22/7 355/113")
    fails = fails + expect("conv_415", joinpairs(cf_convergents([4, 2, 6, 7])), "4/1 9/2 58/13 415/93")

    // reconstruct
    let r = cf_to_rational([4, 2, 6, 7])
    fails = fails + expect("to_rat", str(r[0]) + "/" + str(r[1]), "415/93")
    let r2 = cf_to_rational([3, 7, 16])
    fails = fails + expect("to_rat_pi", str(r2[0]) + "/" + str(r2[1]), "355/113")

    // best approximations of 355/113 (a pi proxy) with fewer terms
    let b1 = cf_best_approx(355, 113, 1)
    fails = fails + expect("best_1", str(b1[0]) + "/" + str(b1[1]), "3/1")
    let b2 = cf_best_approx(355, 113, 2)
    fails = fails + expect("best_2", str(b2[0]) + "/" + str(b2[1]), "22/7")
    let b3 = cf_best_approx(355, 113, 3)
    fails = fails + expect("best_3", str(b3[0]) + "/" + str(b3[1]), "355/113")

    if fails == 0
        print("forge_contfrac: all passed")
    else
        print("forge_contfrac: " + str(fails) + " FAILED")
