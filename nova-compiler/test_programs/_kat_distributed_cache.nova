import forge_distributed_cache

fn main()
    let dc = dcache_new(4)
    dc = dcache_set(dc, "user:1", "alice", 100, 1000)
    dc = dcache_set(dc, "user:2", "bob", 100, 1000)
    dc = dcache_set(dc, "session:abc", "data123", 50, 1000)
    assert(dcache_total_keys(dc) == 3, "3 keys")

    let v1 = dcache_get(dc, "user:1", 1050)
    assert(v1 == "alice", "got alice")
    let v2 = dcache_get(dc, "user:2", 1050)
    assert(v2 == "bob", "got bob")

    let expired = dcache_get(dc, "session:abc", 1060)
    assert(expired == "", "expired at 1060")

    let miss = dcache_get(dc, "nonexistent", 1000)
    assert(miss == "", "miss = empty")

    assert(dcache_hit_rate(dc) == 50, "50% hit rate")

    dc = dcache_evict(dc, "user:1")
    let evicted = dcache_get(dc, "user:1", 1050)
    assert(evicted == "", "evicted = empty")
    assert(dcache_total_keys(dc) == 2, "2 after evict")

    print("DISTRIBUTED-CACHE KAT PASS")
