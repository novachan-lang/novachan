// LOCK-4 inc3c: assigning an f32 to an f64 binding is a WIDTH MISMATCH. Both float widths
// are explicit, so this is caught rather than silently widened -- the same rule that rejects
// u8 vs i32. The legal spelling is `let b: f64 = f64(a)`.
fn main() -> int
    let a: f32 = 1.5
    let b: f64 = a
    print(str(b))
    return 0
main()
