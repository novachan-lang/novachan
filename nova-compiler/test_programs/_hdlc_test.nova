// KAT for std/framing/hdlc — HDLC-style async byte framing.
// Canonical vectors from spec + round-trip tests.
import std/framing/hdlc

// ── Helpers ───────────────────────────────────────────────────────────────────

fn list_eq(a, b) -> int
    let la = len(a)
    let lb = len(b)
    if la != lb
        return 0
    let i = 0
    while i < la
        if a[i] != b[i]
            return 0
        i = i + 1
    1

fn ck_list(label, got, want)
    if list_eq(got, want) == 0
        let gs = "["
        let i = 0
        while i < len(got)
            gs = gs + str(got[i])
            if i + 1 < len(got)
                gs = gs + ","
            i = i + 1
        gs = gs + "]"
        let ws = "["
        let j = 0
        while j < len(want)
            ws = ws + str(want[j])
            if j + 1 < len(want)
                ws = ws + ","
            j = j + 1
        ws = ws + "]"
        print("FAIL hdlc " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn ck_int(label, got, want)
    if got != want
        print("FAIL hdlc " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ── KAT 1: hdlc_stuff([0x7E]) == [0x7D, 0x5E] ───────────────────────────────
fn kat1()
    let stuffed = hdlc_stuff([126])
    ck_list("stuff-FLAG", stuffed, [125, 94])
    print("KAT 1 PASS: hdlc_stuff([0x7E]) == [0x7D,0x5E]")

// ── KAT 2: hdlc_stuff([0x7D]) == [0x7D, 0x5D] ───────────────────────────────
fn kat2()
    let stuffed = hdlc_stuff([125])
    ck_list("stuff-ESC", stuffed, [125, 93])
    print("KAT 2 PASS: hdlc_stuff([0x7D]) == [0x7D,0x5D]")

// ── KAT 3: hdlc_stuff([1,2]) == [1,2] ────────────────────────────────────────
fn kat3()
    let stuffed = hdlc_stuff([1, 2])
    ck_list("stuff-passthrough", stuffed, [1, 2])
    print("KAT 3 PASS: hdlc_stuff([1,2]) == [1,2]")

// ── KAT 4: hdlc_frame([1,2,3]) == [0x7E,1,2,3,0x7E] ─────────────────────────
fn kat4()
    let framed = hdlc_frame([1, 2, 3])
    ck_list("frame-simple", framed, [126, 1, 2, 3, 126])
    print("KAT 4 PASS: hdlc_frame([1,2,3]) == [0x7E,1,2,3,0x7E]")

// ── KAT 5: hdlc_frame([0x7E]) == [0x7E,0x7D,0x5E,0x7E] ─────────────────────
fn kat5()
    let framed = hdlc_frame([126])
    ck_list("frame-FLAG-in-data", framed, [126, 125, 94, 126])
    print("KAT 5 PASS: hdlc_frame([0x7E]) == [0x7E,0x7D,0x5E,0x7E]")

// ── KAT 6: round-trip hdlc_decode(hdlc_encode(x))==x for [1,2,3] ─────────────
fn kat6()
    let data = [1, 2, 3]
    let rt = hdlc_decode(hdlc_encode(data))
    ck_list("rt-simple", rt, data)
    print("KAT 6 PASS: round-trip [1,2,3] OK")

// ── KAT 7: round-trip for [0x7E,0x7D] ───────────────────────────────────────
fn kat7()
    let data = [126, 125]
    let rt = hdlc_decode(hdlc_encode(data))
    ck_list("rt-FLAG-ESC", rt, data)
    print("KAT 7 PASS: round-trip [0x7E,0x7D] OK")

// ── KAT 8: round-trip for [0x00,0x7E,0x7D,0xFF] ─────────────────────────────
fn kat8()
    let data = [0, 126, 125, 255]
    let rt = hdlc_decode(hdlc_encode(data))
    ck_list("rt-mixed", rt, data)
    print("KAT 8 PASS: round-trip [0x00,0x7E,0x7D,0xFF] OK")

// ── KAT 9: round-trip for [] (empty) ─────────────────────────────────────────
fn kat9()
    let rt = hdlc_decode(hdlc_encode([]))
    ck_list("rt-empty", rt, [])
    print("KAT 9 PASS: round-trip [] OK")

// ── KAT 10: hdlc_unstuff(hdlc_stuff(x))==x ───────────────────────────────────
fn kat10()
    let d1 = [126, 125, 1, 2, 3]
    let rt1 = hdlc_unstuff(hdlc_stuff(d1))
    ck_list("unstuff-rt-mixed", rt1, d1)
    // All-special bytes
    let d2 = [126, 125, 126, 125]
    let rt2 = hdlc_unstuff(hdlc_stuff(d2))
    ck_list("unstuff-rt-all-special", rt2, d2)
    // Empty
    let rt3 = hdlc_unstuff(hdlc_stuff([]))
    ck_list("unstuff-rt-empty", rt3, [])
    print("KAT 10 PASS: hdlc_unstuff(hdlc_stuff(x))==x for all test cases")

// ── KAT 11: hdlc_is_flag ─────────────────────────────────────────────────────
fn kat11()
    ck_int("is_flag-126", hdlc_is_flag(126), 1)
    ck_int("is_flag-125", hdlc_is_flag(125), 0)
    ck_int("is_flag-0", hdlc_is_flag(0), 0)
    ck_int("is_flag-255", hdlc_is_flag(255), 0)
    print("KAT 11 PASS: hdlc_is_flag OK")

// ── KAT 12: round-trip a payload of all 0x7E bytes ────────────────────────────
fn kat12()
    let data = []
    let i = 0
    while i < 8
        push(data, 126)
        i = i + 1
    let rt = hdlc_decode(hdlc_encode(data))
    ck_list("rt-all-FLAG", rt, data)
    print("KAT 12 PASS: round-trip 8x 0x7E OK")

// ── KAT 13: round-trip a payload of all 0x7D bytes ────────────────────────────
fn kat13()
    let data = []
    let i = 0
    while i < 8
        push(data, 125)
        i = i + 1
    let rt = hdlc_decode(hdlc_encode(data))
    ck_list("rt-all-ESC", rt, data)
    print("KAT 13 PASS: round-trip 8x 0x7D OK")

// ── KAT 14: XOR value check (0x7E XOR 0x20 = 0x5E, 0x7D XOR 0x20 = 0x5D) ────
fn kat14()
    // 0x7E ^ 0x20 = 0x5E = 94
    let t1 = 126
    let t1x = t1 ^ 32
    ck_int("xor-FLAG", t1x, 94)
    // 0x7D ^ 0x20 = 0x5D = 93
    let t2 = 125
    let t2x = t2 ^ 32
    ck_int("xor-ESC", t2x, 93)
    // Verify unstuff recovers them: ESC 0x5E -> 0x7E
    let stuffed_flag = [125, 94]
    let us1 = hdlc_unstuff(stuffed_flag)
    ck_list("unstuff-0x5E", us1, [126])
    let stuffed_esc = [125, 93]
    let us2 = hdlc_unstuff(stuffed_esc)
    ck_list("unstuff-0x5D", us2, [125])
    print("KAT 14 PASS: XOR escape values and unstuff recovery OK")

fn main()
    kat1()
    kat2()
    kat3()
    kat4()
    kat5()
    kat6()
    kat7()
    kat8()
    kat9()
    kat10()
    kat11()
    kat12()
    kat13()
    kat14()
    print("PASS _hdlc_test")
