import forge_webhook_validator

fn main()
    let w = wv_new()
    w = wv_register(w, "github", "secret123")

    let sig = wv_compute_signature(w, "github", "push-event")
    assert(is_ok(sig), "compute ok")
    let sig_val = unwrap(sig)

    let r1 = wv_validate(w, "github", "push-event", sig_val)
    assert(is_ok(r1), "valid signature")
    w = unwrap(r1)
    assert(wv_validated_count(w) == 1, "1 validated")

    let r2 = wv_validate(w, "github", "push-event", 99999)
    assert(is_err(r2), "invalid signature")

    let r3 = wv_validate(w, "unknown", "x", 0)
    assert(is_err(r3), "unknown source")

    assert(wv_rejected_count(w) == 2, "2 rejected")

    print("WEBHOOK-VALIDATOR KAT PASS")
