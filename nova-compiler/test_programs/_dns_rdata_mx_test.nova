import std/net/dns_rdata_mx

// ── Helpers ───────────────────────────────────────────────────────────────────

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL dns_rdata_mx " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL dns_rdata_mx " + label + ": got=" + got + " want=" + want)
        exit(1)

fn ckb_byte(label: string, got: bytes, idx: int, want: int)
    let v = bytes_get(got, idx)
    if v != want
        print("FAIL dns_rdata_mx " + label + ": byte[" + str(idx) + "] got=" + str(v) + " want=" + str(want))
        exit(1)

// ── Build known-answer bytes for dns_mx_encode(10, "mail.example.com") ───────
// Wire:
//   [0]=0x00, [1]=0x0A           (preference=10, big-endian)
//   [2]=4, [3]=109,'a'=97,'i'=105,'l'=108  (label "mail")
//   [7]=7, [8..14]='e','x','a','m','p','l','e'  (label "example")
//   [15]=3, [16]='c'=99,'o'=111,'m'=109  (label "com")
//   [19]=0                        (root terminator)
// Total: 20 bytes

fn make_mx_known_bytes() -> bytes
    let w = bytes(0)
    // preference = 10 = 0x000A
    w = bytes_append(w, 0)
    w = bytes_append(w, 10)
    // label "mail" (4 bytes)
    w = bytes_append(w, 4)
    w = bytes_append(w, 109)
    w = bytes_append(w, 97)
    w = bytes_append(w, 105)
    w = bytes_append(w, 108)
    // label "example" (7 bytes)
    w = bytes_append(w, 7)
    w = bytes_append(w, 101)
    w = bytes_append(w, 120)
    w = bytes_append(w, 97)
    w = bytes_append(w, 109)
    w = bytes_append(w, 112)
    w = bytes_append(w, 108)
    w = bytes_append(w, 101)
    // label "com" (3 bytes)
    w = bytes_append(w, 3)
    w = bytes_append(w, 99)
    w = bytes_append(w, 111)
    w = bytes_append(w, 109)
    // terminator
    w = bytes_append(w, 0)
    w

// ── Build known-answer bytes for dns_name_rdata_encode("ns1.example.com") ────
// Wire:
//   [0]=3, [1]='n'=110, [2]='s'=115, [3]='1'=49   (label "ns1")
//   [4]=7, [5..11]='e','x','a','m','p','l','e'     (label "example")
//   [12]=3, [13]='c'=99, [14]='o'=111, [15]='m'=109  (label "com")
//   [16]=0                                          (root terminator)
// Total: 17 bytes

fn make_ns1_known_bytes() -> bytes
    let w = bytes(0)
    // label "ns1" (3 bytes)
    w = bytes_append(w, 3)
    w = bytes_append(w, 110)
    w = bytes_append(w, 115)
    w = bytes_append(w, 49)
    // label "example" (7 bytes)
    w = bytes_append(w, 7)
    w = bytes_append(w, 101)
    w = bytes_append(w, 120)
    w = bytes_append(w, 97)
    w = bytes_append(w, 109)
    w = bytes_append(w, 112)
    w = bytes_append(w, 108)
    w = bytes_append(w, 101)
    // label "com" (3 bytes)
    w = bytes_append(w, 3)
    w = bytes_append(w, 99)
    w = bytes_append(w, 111)
    w = bytes_append(w, 109)
    // terminator
    w = bytes_append(w, 0)
    w

fn main()
    // ── Test 1: dns_mx_encode(10, "mail.example.com") exact wire bytes ────────
    // Expected: 20 bytes; [0]=0x00, [1]=0x0A; then encoded name
    let enc_mx = dns_mx_encode(10, "mail.example.com")
    cki("mx_enc_len",  bytes_len(enc_mx), 20)
    ckb_byte("mx_enc_b0",  enc_mx, 0,  0)
    ckb_byte("mx_enc_b1",  enc_mx, 1,  10)
    // label "mail" length byte
    ckb_byte("mx_enc_b2",  enc_mx, 2,  4)
    // 'm' = 109
    ckb_byte("mx_enc_b3",  enc_mx, 3,  109)
    // 'a' = 97
    ckb_byte("mx_enc_b4",  enc_mx, 4,  97)
    // 'i' = 105
    ckb_byte("mx_enc_b5",  enc_mx, 5,  105)
    // 'l' = 108
    ckb_byte("mx_enc_b6",  enc_mx, 6,  108)
    // label "example" length byte
    ckb_byte("mx_enc_b7",  enc_mx, 7,  7)
    // 'e' = 101
    ckb_byte("mx_enc_b8",  enc_mx, 8,  101)
    // terminator byte [19]
    ckb_byte("mx_enc_b19", enc_mx, 19, 0)

    // Byte-for-byte comparison against known-answer
    let want_mx = make_mx_known_bytes()
    cki("mx_known_len", bytes_len(want_mx), 20)
    let ki = 0
    while ki < 20
        if bytes_get(enc_mx, ki) != bytes_get(want_mx, ki)
            print("FAIL dns_rdata_mx mx_known_cmp: byte[" + str(ki) + "] got=" + str(bytes_get(enc_mx, ki)) + " want=" + str(bytes_get(want_mx, ki)))
            exit(1)
        ki = ki + 1

    // ── Test 2: dns_mx_decode round-trip on the encoded bytes ─────────────────
    // rdlength = 18 (pref u16 = 2 bytes + name = 18 bytes; total = 20 bytes)
    // Actually rdlength covers the whole rdata = 20 bytes
    let dec_mx = dns_mx_decode(enc_mx, 0, 20)
    let mx_rec = dec_mx[0]
    let mx_next = dec_mx[1]
    cki("mx_dec_pref", mx_rec["pref"], 10)
    cks("mx_dec_exchange", mx_rec["exchange"], "mail.example.com")
    cki("mx_dec_next", mx_next, 20)

    // ── Test 3: dns_mx_encode with larger preference (0x0064 = 100) ──────────
    let enc_mx2 = dns_mx_encode(100, "mx2.example.com")
    // preference bytes: 0, 100
    ckb_byte("mx2_pref_hi", enc_mx2, 0, 0)
    ckb_byte("mx2_pref_lo", enc_mx2, 1, 100)
    // label "mx2" length = 3
    ckb_byte("mx2_lbl_len", enc_mx2, 2, 3)
    // 'm' = 109
    ckb_byte("mx2_lbl_m", enc_mx2, 3, 109)

    // Round-trip mx2
    let dec_mx2 = dns_mx_decode(enc_mx2, 0, bytes_len(enc_mx2))
    let mx2_rec = dec_mx2[0]
    cki("mx2_dec_pref", mx2_rec["pref"], 100)
    cks("mx2_dec_exchange", mx2_rec["exchange"], "mx2.example.com")

    // ── Test 4: dns_mx_encode with max-typical preference 0x7FFF (32767) ──────
    let enc_mx3 = dns_mx_encode(0x7FFF, "relay.net")
    ckb_byte("mx3_pref_hi", enc_mx3, 0, 0x7F)
    ckb_byte("mx3_pref_lo", enc_mx3, 1, 0xFF)
    let dec_mx3 = dns_mx_decode(enc_mx3, 0, bytes_len(enc_mx3))
    let mx3_rec = dec_mx3[0]
    cki("mx3_dec_pref", mx3_rec["pref"], 0x7FFF)
    cks("mx3_dec_exchange", mx3_rec["exchange"], "relay.net")

    // ── Test 5: dns_name_rdata_encode("ns1.example.com") exact wire bytes ─────
    // Expected: 17 bytes
    let enc_ns = dns_name_rdata_encode("ns1.example.com")
    cki("ns_enc_len",  bytes_len(enc_ns), 17)
    // label "ns1" length byte = 3
    ckb_byte("ns_enc_b0",  enc_ns, 0,  3)
    // 'n' = 110
    ckb_byte("ns_enc_b1",  enc_ns, 1,  110)
    // 's' = 115
    ckb_byte("ns_enc_b2",  enc_ns, 2,  115)
    // '1' = 49
    ckb_byte("ns_enc_b3",  enc_ns, 3,  49)
    // label "example" length byte = 7
    ckb_byte("ns_enc_b4",  enc_ns, 4,  7)
    // terminator byte [16]
    ckb_byte("ns_enc_b16", enc_ns, 16, 0)

    // Byte-for-byte comparison against known-answer
    let want_ns = make_ns1_known_bytes()
    cki("ns_known_len", bytes_len(want_ns), 17)
    let ni = 0
    while ni < 17
        if bytes_get(enc_ns, ni) != bytes_get(want_ns, ni)
            print("FAIL dns_rdata_mx ns_known_cmp: byte[" + str(ni) + "] got=" + str(bytes_get(enc_ns, ni)) + " want=" + str(bytes_get(want_ns, ni)))
            exit(1)
        ni = ni + 1

    // ── Test 6: dns_name_rdata_decode round-trip on encoded ns1 bytes ─────────
    let dec_ns = dns_name_rdata_decode(enc_ns, 0)
    cks("ns_dec_name", dec_ns[0], "ns1.example.com")
    cki("ns_dec_next", dec_ns[1], 17)

    // ── Test 7: dns_name_rdata_encode / decode round-trip for PTR-style name ──
    let enc_ptr = dns_name_rdata_encode("4.3.2.1.in-addr.arpa")
    let dec_ptr = dns_name_rdata_decode(enc_ptr, 0)
    cks("ptr_dec_name", dec_ptr[0], "4.3.2.1.in-addr.arpa")
    cki("ptr_dec_next", dec_ptr[1], bytes_len(enc_ptr))

    // ── Test 8: dns_name_rdata_encode / decode round-trip for CNAME ───────────
    let enc_cn = dns_name_rdata_encode("www.example.com")
    let dec_cn = dns_name_rdata_decode(enc_cn, 0)
    cks("cname_dec_name", dec_cn[0], "www.example.com")
    cki("cname_dec_next", dec_cn[1], bytes_len(enc_cn))

    // ── Test 9: compression pointer in name rdata decode ─────────────────────
    // Build a message: [0..12] = "example.com" wire, [13..14] = pointer 0xC0,0x00
    // Decode at pos=13 -> follows pointer to offset 0 -> "example.com"
    let pmsg = bytes(0)
    // "example.com" wire: [7,'e','x','a','m','p','l','e',3,'c','o','m',0]
    pmsg = bytes_append(pmsg, 7)
    pmsg = bytes_append(pmsg, 101)
    pmsg = bytes_append(pmsg, 120)
    pmsg = bytes_append(pmsg, 97)
    pmsg = bytes_append(pmsg, 109)
    pmsg = bytes_append(pmsg, 112)
    pmsg = bytes_append(pmsg, 108)
    pmsg = bytes_append(pmsg, 101)
    pmsg = bytes_append(pmsg, 3)
    pmsg = bytes_append(pmsg, 99)
    pmsg = bytes_append(pmsg, 111)
    pmsg = bytes_append(pmsg, 109)
    pmsg = bytes_append(pmsg, 0)
    // pointer: 0xC0 0x00 -> offset 0
    pmsg = bytes_append(pmsg, 192)
    pmsg = bytes_append(pmsg, 0)
    let dec_ptr2 = dns_name_rdata_decode(pmsg, 13)
    cks("ptr_follow_name", dec_ptr2[0], "example.com")
    cki("ptr_follow_next", dec_ptr2[1], 15)

    // ── Test 10: malformed inputs return safe empty results ───────────────────
    // Truncated MX rdata (rdlength < 3)
    let bad_mx = dns_mx_decode(enc_mx, 0, 2)
    let bad_mx_rec = bad_mx[0]
    cki("bad_mx_pref", bad_mx_rec["pref"], 0)
    cks("bad_mx_exchange", bad_mx_rec["exchange"], "")

    // Out-of-bounds pos for name decode
    let oob_nd = dns_name_rdata_decode(enc_ns, 100)
    cks("oob_name", oob_nd[0], "")
    cki("oob_pos", oob_nd[1], 100)

    // Empty exchange name (valid: root name, encoded as single 0x00)
    let enc_root_mx = dns_mx_encode(5, "")
    cki("root_mx_len", bytes_len(enc_root_mx), 3)
    ckb_byte("root_mx_pref_hi", enc_root_mx, 0, 0)
    ckb_byte("root_mx_pref_lo", enc_root_mx, 1, 5)
    ckb_byte("root_mx_term",    enc_root_mx, 2, 0)

    print("PASS _dns_rdata_mx_test")
