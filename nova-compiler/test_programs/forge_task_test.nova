// Forge T4.13: crash-safe async/await. async(f) runs f in a monitored task; await returns ok(value)
// on success or err on a PANIC -- a crashed task becomes an err instead of crashing the awaiter.
// Socketless (spawn/monitor/channel) -> kill-on-timeout safe.
import forge_otp

fn compute()
    (10 + 1) * 2      // 22

fn boom()
    panic("kaboom")

fn main()
    let f1 = async(compute)
    let r1: Result<any> = await(f1)
    match r1
        Ok(v) =>
            if v != 22
                print("FAIL: compute expected 22 got " + str(v))
                exit(1)
        Err(e) =>
            print("FAIL: compute should succeed, got err " + e)
            exit(1)

    let f2 = async(boom)
    let r2: Result<any> = await(f2)
    match r2
        Ok(v) =>
            print("FAIL: boom should crash, got ok " + str(v))
            exit(1)
        Err(e) =>
            print("ok crash-safe await -> " + e)
    print("PASS forge_task (async compute -> ok 22; async panic -> err, awaiter survived)")
