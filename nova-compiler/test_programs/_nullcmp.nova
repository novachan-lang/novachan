fn t(tag: string, v)
    print("  " + tag + ": ==null=" + str(v == null) + "  type=" + type_name(v))
fn main()
    print("what actually collides with null?")
    t("real null        ", null)
    t("integer 0        ", 0)
    t("integer 1        ", 1)
    t("empty string  \"\"  ", "")
    t("string \"0\"       ", "0")
    t("string \"t\"       ", "t")
    let b = bytes_from_list([])
    t("bytes_to_str([]) ", bytes_to_str(b))
    // the exact shape pg_typed_val receives from the wire
    let d = {}
    d["nullcol"] = null
    d["emptycol"] = bytes_to_str(bytes_from_list([]))
    d["zerocol"] = bytes_to_str(bytes_from_list([48]))
    t("dict null value  ", d["nullcol"])
    t("dict empty value ", d["emptycol"])
    t("dict \"0\" value   ", d["zerocol"])
