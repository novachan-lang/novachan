import forge_pad

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // pad_left
    fails = fails + expect("pl1", pad_left("42", 5, "0"), "00042")
    fails = fails + expect("pl_space", pad_left("hi", 5, " "), "   hi")
    fails = fails + expect("pl_exact", pad_left("hello", 5, "0"), "hello")
    fails = fails + expect("pl_over", pad_left("toolong", 3, "0"), "toolong")

    // pad_right
    fails = fails + expect("pr1", pad_right("hi", 5, "."), "hi...")
    fails = fails + expect("pr_exact", pad_right("hello", 5, "."), "hello")

    // center
    fails = fails + expect("c_even", center("hi", 6, "*"), "**hi**")
    fails = fails + expect("c_odd", center("hi", 5, "*"), "*hi**")
    fails = fails + expect("c_exact", center("abc", 3, "*"), "abc")
    fails = fails + expect("c_one", center("x", 5, "-"), "--x--")

    // zfill
    fails = fails + expect("z1", zfill("42", 4), "0042")
    fails = fails + expect("z_neg", zfill("-7", 4), "-007")
    fails = fails + expect("z_exact", zfill("1234", 4), "1234")
    fails = fails + expect("z_over", zfill("12345", 3), "12345")

    if fails == 0
        print("forge_pad: all passed")
    else
        print("forge_pad: " + str(fails) + " FAILED")
