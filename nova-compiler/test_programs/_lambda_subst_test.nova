import std/lambda/lambda_subst

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn ckb(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// _term_equal: recursive structural equality for terms.
fn _term_equal(a, b) -> int
    let ta = type_of(a)
    let tb = type_of(b)
    if ta != tb
        return 0
    if ta == "list"
        let na = len(a)
        let nb = len(b)
        if na != nb
            return 0
        let i = 0
        let ok = 1
        while i < na
            let sub = _term_equal(a[i], b[i])
            if sub == 0
                ok = 0
            i = i + 1
        return ok
    if ta == "int"
        if a == b
            return 1
        return 0
    if ta == "string"
        if a == b
            return 1
        return 0
    return 0

fn ckt(label, a, b)
    let eq = _term_equal(a, b)
    if eq == 0
        print("FAIL " + label + ": terms not equal")
        exit(1)

fn mk_var(k) -> list
    let t = []
    push(t, "var")
    push(t, k)
    return t

fn mk_lam(body) -> list
    let t = []
    push(t, "lam")
    push(t, body)
    return t

fn mk_app(f, a) -> list
    let t = []
    push(t, "app")
    push(t, f)
    push(t, a)
    return t

fn main()
    // KAT 1: lsb_subst(0, ["var",9], ["var",0]) == ["var",9]
    // Variable at index 0 matches j=0, so return s=["var",9]
    let r1 = lambda_subst.lsb_subst(0, mk_var(9), mk_var(0))
    ckt("subst_var0_hit", r1, mk_var(9))

    // KAT 2: lsb_subst(0, ["var",9], ["var",1]) == ["var",1]
    // Variable at index 1, j=0, no match — return unchanged
    let r2 = lambda_subst.lsb_subst(0, mk_var(9), mk_var(1))
    ckt("subst_var1_miss", r2, mk_var(1))

    // KAT 3: lsb_subst(0, ["var",9], ["lam",["var",0]]) == ["lam",["var",0]]
    // Under lam: j becomes j+1=1; var 0 != 1 => unchanged. The var 0 under lam is BOUND.
    let r3 = lambda_subst.lsb_subst(0, mk_var(9), mk_lam(mk_var(0)))
    ckt("subst_lam_var0_bound", r3, mk_lam(mk_var(0)))

    // KAT 4: lsb_subst(0, ["var",9], ["lam",["var",1]]) == ["lam",["var",10]]
    // Under lam: j becomes 1, s=["var",9] gets shifted to ["var",10]; var 1 matches j=1 => ["var",10]
    let r4 = lambda_subst.lsb_subst(0, mk_var(9), mk_lam(mk_var(1)))
    ckt("subst_lam_var1_free", r4, mk_lam(mk_var(10)))

    // KAT 5: lsb_subst_top(["var",5], ["var",0]) == ["var",5]
    // Beta-ready subst: shift(1,0,["var",5])=["var",6]; subst(0,["var",6],["var",0])=["var",6];
    // then shift(-1,0,["var",6])=["var",5]
    let r5 = lambda_subst.lsb_subst_top(mk_var(5), mk_var(0))
    ckt("subst_top_var5_var0", r5, mk_var(5))

    // Additional: lsb_subst in an application
    // subst(0, ["var",9], ["app",["var",0],["var",2]]) == ["app",["var",9],["var",2]]
    let app02 = mk_app(mk_var(0), mk_var(2))
    let r6 = lambda_subst.lsb_subst(0, mk_var(9), app02)
    ckt("subst_app", r6, mk_app(mk_var(9), mk_var(2)))

    // Additional: lsb_subst_top demonstrates beta reduction of identity application
    // (lam x.x) applied to (lam y.y) = (lam y.y)
    // The body of (lam x.x) is ["var",0]; s = (lam y.y) = ["lam",["var",0]]
    // subst_top(s, ["var",0]) should give s back
    let id_body = mk_var(0)
    let id_arg = mk_lam(mk_var(0))
    let r7 = lambda_subst.lsb_subst_top(id_arg, id_body)
    ckt("subst_top_id_applied", r7, mk_lam(mk_var(0)))

    // Additional: verify capture-avoidance under deeper nesting
    // subst(0, ["var",0], ["lam",["var",1]]) == ["lam",["var",1]]
    // Under lam: j=1, s=["var",0] shifted to ["var",1]; var 1 == j=1 => return ["var",1].
    // So result under lam is ["var",1], wrapped: ["lam",["var",1]]
    let r8 = lambda_subst.lsb_subst(0, mk_var(0), mk_lam(mk_var(1)))
    ckt("subst_lam_var1_with_var0", r8, mk_lam(mk_var(1)))

    // Additional: subst in nested application preserves non-matching vars
    // subst(1, ["var",9], ["app",["var",0],["var",1]]) == ["app",["var",0],["var",9]]
    let r9 = lambda_subst.lsb_subst(1, mk_var(9), mk_app(mk_var(0), mk_var(1)))
    ckt("subst_app_var1_hit", r9, mk_app(mk_var(0), mk_var(9)))

    // Additional: subst_top on non-variable body: (lam x.x x) applied to (var 3)
    // body = ["app",["var",0],["var",0]]; s = ["var",3]
    // shift(1,0,s) = ["var",4]; subst(0,["var",4],["app",["var",0],["var",0]]) = ["app",["var",4],["var",4]]
    // shift(-1,0,["app",["var",4],["var",4]]) = ["app",["var",3],["var",3]]
    let dup_body = mk_app(mk_var(0), mk_var(0))
    let r10 = lambda_subst.lsb_subst_top(mk_var(3), dup_body)
    ckt("subst_top_dup_body", r10, mk_app(mk_var(3), mk_var(3)))

    print("PASS _lambda_subst_test")

main()
