// KAT for std/collections/bitset — growable multi-word bitset (list-backed,
// immutable mutators: bs_set/bs_clear/bs_union/bs_intersect return NEW bitsets).
import std/collections/bitset

// cki — check int equality; print FAIL and exit(1) on mismatch.
fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // bitset_new(100): capacity stored ([nbits, word0, word1]), all bits clear.
    let a = bitset.bitset_new(100)
    cki("nbits", bitset.bs_nbits(a), 100)
    cki("new_len", len(a), 3)
    cki("new_count", bitset.bs_count(a), 0)
    cki("new_test5", bitset.bs_test(a, 5), 0)

    // set bits 5 (word 0) and 70 (word 1) -> count 2, test(5)==1, test(6)==0.
    let b = bitset.bs_set(a, 5)
    let c = bitset.bs_set(b, 70)
    cki("count_after_set", bitset.bs_count(c), 2)
    cki("test5_set", bitset.bs_test(c, 5), 1)
    cki("test6_unset", bitset.bs_test(c, 6), 0)
    cki("test70_set", bitset.bs_test(c, 70), 1)

    // immutability: original bitset `a` (and intermediate `b`) untouched.
    cki("orig_a_count", bitset.bs_count(a), 0)
    cki("orig_a_test5", bitset.bs_test(a, 5), 0)
    cki("orig_b_count", bitset.bs_count(b), 1)
    cki("orig_b_test70", bitset.bs_test(b, 70), 0)

    // setting an already-set bit is idempotent.
    let c2 = bitset.bs_set(c, 5)
    cki("idempotent_set_count", bitset.bs_count(c2), 2)

    // clear bit 5 -> count 1, bit 70 still set.
    let d = bitset.bs_clear(c, 5)
    cki("count_after_clear", bitset.bs_count(d), 1)
    cki("test5_cleared", bitset.bs_test(d, 5), 0)
    cki("test70_still_set", bitset.bs_test(d, 70), 1)

    // union of setX={1,5,70} and setY={5,70,99} -> count 4.
    let setX = bitset.bs_set(bitset.bs_set(bitset.bs_set(bitset.bitset_new(100), 1), 5), 70)
    let setY = bitset.bs_set(bitset.bs_set(bitset.bs_set(bitset.bitset_new(100), 5), 70), 99)
    cki("setX_count", bitset.bs_count(setX), 3)
    cki("setY_count", bitset.bs_count(setY), 3)
    let u = bitset.bs_union(setX, setY)
    cki("union_count", bitset.bs_count(u), 4)
    cki("union_test1", bitset.bs_test(u, 1), 1)
    cki("union_test5", bitset.bs_test(u, 5), 1)
    cki("union_test70", bitset.bs_test(u, 70), 1)
    cki("union_test99", bitset.bs_test(u, 99), 1)
    cki("union_test2", bitset.bs_test(u, 2), 0)
    cki("union_nbits", bitset.bs_nbits(u), 100)

    // intersect of setX and setY -> {5,70}, count 2.
    let x = bitset.bs_intersect(setX, setY)
    cki("intersect_count", bitset.bs_count(x), 2)
    cki("intersect_test5", bitset.bs_test(x, 5), 1)
    cki("intersect_test70", bitset.bs_test(x, 70), 1)
    cki("intersect_test1", bitset.bs_test(x, 1), 0)
    cki("intersect_test99", bitset.bs_test(x, 99), 0)

    // boundary bits: 63 (top of word 0) and 64 (bottom of word 1) don't alias.
    let f = bitset.bs_set(bitset.bitset_new(100), 63)
    cki("bit63_set", bitset.bs_test(f, 63), 1)
    cki("bit63_no_alias64", bitset.bs_test(f, 64), 0)
    let g = bitset.bs_set(bitset.bitset_new(100), 64)
    cki("bit64_set", bitset.bs_test(g, 64), 1)
    cki("bit64_no_alias63", bitset.bs_test(g, 63), 0)

    print("PASS _bitset_test")
