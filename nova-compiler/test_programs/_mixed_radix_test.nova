import std/numeral/mixed_radix

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL mixed_radix " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL mixed_radix " + label + " len: got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL mixed_radix " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // Build radices lists (radices=[24,60,60] for days/hours/min/sec).
    let r_hms = []
    r_hms.push(24)
    r_hms.push(60)
    r_hms.push(60)

    let r_ms = []
    r_ms.push(60)
    r_ms.push(60)

    // mr_to_digits KAT
    // 90061 seconds = 1 day, 1 hour, 1 min, 1 sec
    let w1 = []
    w1.push(1)
    w1.push(1)
    w1.push(1)
    w1.push(1)
    ckl("to_digits(90061,[24,60,60])", mr_to_digits(90061, r_hms), w1)

    // 59 seconds = 0 hours, 0 min, 59 sec
    let w2 = []
    w2.push(0)
    w2.push(0)
    w2.push(59)
    ckl("to_digits(59,[60,60])", mr_to_digits(59, r_ms), w2)

    // 3661 seconds = 1 hour, 1 min, 1 sec
    let w3 = []
    w3.push(1)
    w3.push(1)
    w3.push(1)
    ckl("to_digits(3661,[60,60])", mr_to_digits(3661, r_ms), w3)

    // mr_from_digits KAT
    let d1 = []
    d1.push(1)
    d1.push(1)
    d1.push(1)
    d1.push(1)
    cki("from_digits([1,1,1,1],[24,60,60])", mr_from_digits(d1, r_hms), 90061)

    let d2 = []
    d2.push(1)
    d2.push(1)
    d2.push(1)
    cki("from_digits([1,1,1],[60,60])", mr_from_digits(d2, r_ms), 3661)

    // Round-trip: mr_from_digits(mr_to_digits(n,radices),radices)==n
    cki("roundtrip(0)", mr_from_digits(mr_to_digits(0, r_hms), r_hms), 0)
    cki("roundtrip(123456)", mr_from_digits(mr_to_digits(123456, r_hms), r_hms), 123456)
    cki("roundtrip(86399)", mr_from_digits(mr_to_digits(86399, r_ms), r_ms), 86399)
    cki("roundtrip(3661)", mr_from_digits(mr_to_digits(3661, r_ms), r_ms), 3661)

    // Edge: n=0
    let w0 = []
    w0.push(0)
    w0.push(0)
    w0.push(0)
    w0.push(0)
    ckl("to_digits(0,[24,60,60])", mr_to_digits(0, r_hms), w0)

    // Edge: single radix
    let r1 = []
    r1.push(7)
    let d_r1 = mr_to_digits(22, r1)
    cki("to_digits(22,[7]) len", len(d_r1), 2)
    cki("to_digits(22,[7])[0]", d_r1[0], 3)
    cki("to_digits(22,[7])[1]", d_r1[1], 1)
    cki("roundtrip(22,[7])", mr_from_digits(d_r1, r1), 22)

    print("PASS _mixed_radix_test")
