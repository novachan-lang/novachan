import std/dp/dp_lis

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

fn ckb(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

fn ckl(label, got, expected)
    let gl = len(got)
    let el = len(expected)
    if gl != el
        print("FAIL " + label + " len: got=" + str(gl) + " expected=" + str(el))
        exit(1)
    let i = 0
    while i < gl
        if got[i] != expected[i]
            print("FAIL " + label + " [" + str(i) + "]: got=" + str(got[i]) + " expected=" + str(expected[i]))
            exit(1)
        i = i + 1

fn main()
    // KAT 1: [10,9,2,5,3,7,101,18] -> LIS length 4
    let a1 = [10, 9, 2, 5, 3, 7, 101, 18]
    cki("lis_length [10,9,2,5,3,7,101,18]", lis_length(a1), 4)

    // KAT 2: [0,1,0,3,2,3] -> LIS length 4
    let a2 = [0, 1, 0, 3, 2, 3]
    cki("lis_length [0,1,0,3,2,3]", lis_length(a2), 4)

    // KAT 3: [7,7,7] -> LIS length 1 (strictly increasing, so equal not counted)
    let a3 = [7, 7, 7]
    cki("lis_length [7,7,7]", lis_length(a3), 1)

    // KAT 4: empty -> 0
    let a4 = []
    cki("lis_length []", lis_length(a4), 0)

    // KAT 5: [1,2,3,4] -> LIS length 4
    let a5 = [1, 2, 3, 4]
    cki("lis_length [1,2,3,4]", lis_length(a5), 4)

    // KAT 6: lis_count([1,3,2,4]) = 2  ([1,3,4] and [1,2,4])
    let a6 = [1, 3, 2, 4]
    cki("lis_count [1,3,2,4]", lis_count(a6), 2)

    // KAT 7: lis_count single element = 1
    let a7 = [5]
    cki("lis_count [5]", lis_count(a7), 1)

    // KAT 8: lis_count descending = n (each single element is an LIS of length 1)
    let a8 = [3, 2, 1]
    cki("lis_count [3,2,1]", lis_count(a8), 3)

    // KAT 9: lis_one length matches lis_length for [10,9,2,5,3,7,101,18]
    let seq9 = lis_one(a1)
    cki("lis_one length [10,9,2,5,3,7,101,18]", len(seq9), 4)

    // KAT 10: lis_one is strictly increasing
    let valid = 1
    let i = 1
    while i < len(seq9)
        if seq9[i] <= seq9[i - 1]
            valid = 0
        i = i + 1
    cki("lis_one strictly increasing", valid, 1)

    // KAT 11: lis_one([1,2,3,4]) = [1,2,3,4]
    let seq11 = lis_one(a5)
    let e11 = [1, 2, 3, 4]
    ckl("lis_one [1,2,3,4]", seq11, e11)

    // KAT 12: lis_one([]) = []
    let seq12 = lis_one(a4)
    let e12 = []
    ckl("lis_one []", seq12, e12)

    // KAT 13: lis_count empty = 0
    cki("lis_count []", lis_count(a4), 0)

    // KAT 14: lis_count([1,2,3,4]) = 1 (only one strictly increasing sequence)
    cki("lis_count [1,2,3,4]", lis_count(a5), 1)

    print("PASS _dp_lis_test")
