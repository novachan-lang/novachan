import forge_string_builder

fn main()
    let s = sb_new()
    s = sb_append(s, "hello")
    s = sb_append(s, " ")
    s = sb_append(s, "world")
    assert(sb_count(s) == 3, "3 parts")
    assert(sb_total_length(s) == 11, "11 chars")

    let result = sb_build(s)
    assert(result == "hello world", "build ok")

    let csv = sb_new()
    csv = sb_append(csv, "a")
    csv = sb_append(csv, "b")
    csv = sb_append(csv, "c")
    let joined = sb_build_with_sep(csv, ",")
    assert(joined == "a,b,c", "join with comma")

    s = sb_clear(s)
    assert(sb_count(s) == 0, "cleared")
    assert(sb_build(s) == "", "empty build")

    print("STRING-BUILDER KAT PASS")
