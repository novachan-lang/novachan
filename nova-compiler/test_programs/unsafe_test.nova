// Phase 7.5 F016 foundation: 'unsafe' keyword parses and threads through
// the AST as a transparent wrapper. No operation requires unsafe YET — that
// comes when F005 raw pointers + F004 FFI land (those ops will then check
// for an enclosing unsafe). For now this proves the keyword is reserved
// and the AST node round-trips correctly through type inference + codegen.
fn main()
    let a = unsafe 42
    assert_eq(a, 42)
    let b = unsafe (1 + 2 + 3)
    assert_eq(b, 6)
    let xs = [10, 20, 30]
    let sum = unsafe (xs[0] + xs[1] + xs[2])
    assert_eq(sum, 60)
    print("unsafe keyword test passed: AST wrapper transparent, codegen + type inference intact")
