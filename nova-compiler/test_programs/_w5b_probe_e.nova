// E: return an ALIAS. returned_slot = s2 (the returned alias); s is NOT the
// returned slot -> W5b drops s, freeing the backing array SHARED with the
// returned s2. The caller then reads freed data. Predict ASAN use-after-free.
fn f() -> list
    let s = [10, 20, 30]
    let s2 = s
    return s2
fn main()
    let r = f()
    print(len(r))
    print("E_DONE")
