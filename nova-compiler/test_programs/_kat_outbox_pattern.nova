import forge_outbox_pattern

fn main()
    let o = ob_new()
    o = ob_add(o, "OrderCreated", "order-123")
    o = ob_add(o, "PaymentProcessed", "pay-456")
    o = ob_add(o, "ShipmentSent", "ship-789")
    assert(ob_total_count(o) == 3, "3 entries")
    assert(ob_pending_count(o) == 3, "3 pending")

    let t = ob_entry_type(o, 0)
    assert(is_ok(t), "type ok")
    assert(unwrap(t) == "OrderCreated", "type 0")

    let p = ob_entry_payload(o, 1)
    assert(unwrap(p) == "pay-456", "payload 1")

    let bad = ob_entry_type(o, 99)
    assert(is_err(bad), "out of range is err")

    let r1 = ob_mark_published(o, 0)
    assert(is_ok(r1), "publish ok")
    o = unwrap(r1)
    let r2 = ob_mark_published(o, 1)
    o = unwrap(r2)
    let r3 = ob_mark_failed(o, 2)
    o = unwrap(r3)

    assert(ob_pending_count(o) == 0, "0 pending")
    assert(ob_publish_rate(o) == 66, "66% published")

    print("OUTBOX-PATTERN KAT PASS")
