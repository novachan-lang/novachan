// _matnorm_test.nova — KAT for std/matrix/matnorm
import std/matrix/matnorm

// Helper: check two floats within tol.
fn approx(a: float, b: float, tol: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    d < tol

// Helper: fail with label.
fn fail(label: string)
    print("FAIL _matnorm_test " + label)
    exit(1)

fn main()
    // ── KAT 1: mn_frobenius([[3,4]]) == 5.0 ─────────────────────────────────
    let d1 = []
    push(d1, 3.0)
    push(d1, 4.0)
    let M1x2 = mn_make(1, 2, d1)
    let fro1 = mn_frobenius(M1x2)
    if not approx(fro1, 5.0, 0.0001)
        fail("frobenius_3_4")

    // ── KAT 2: mn_frobenius([[1,0],[0,1]]) == sqrt(2) ≈ 1.41421 ─────────────
    let d22id = []
    push(d22id, 1.0)
    push(d22id, 0.0)
    push(d22id, 0.0)
    push(d22id, 1.0)
    let I2 = mn_make(2, 2, d22id)
    let fro2 = mn_frobenius(I2)
    if not approx(fro2, 1.41421, 0.0001)
        fail("frobenius_identity2")

    // ── KAT 3: mn_one([[1,-2],[-3,4]]) == 6.0 ───────────────────────────────
    // Column sums: |1|+|-3|=4, |-2|+|4|=6 -> max=6
    let d22a = []
    push(d22a, 1.0)
    push(d22a, 0.0 - 2.0)
    push(d22a, 0.0 - 3.0)
    push(d22a, 4.0)
    let M22a = mn_make(2, 2, d22a)
    let n1 = mn_one(M22a)
    if not approx(n1, 6.0, 0.0001)
        fail("one_norm")

    // ── KAT 4: mn_inf([[1,-2],[-3,4]]) == 7.0 ───────────────────────────────
    // Row sums: |1|+|-2|=3, |-3|+|4|=7 -> max=7
    let ninf = mn_inf(M22a)
    if not approx(ninf, 7.0, 0.0001)
        fail("inf_norm")

    // ── KAT 5: mn_max([[1,-5],[3,2]]) == 5.0 ────────────────────────────────
    let dm = []
    push(dm, 1.0)
    push(dm, 0.0 - 5.0)
    push(dm, 3.0)
    push(dm, 2.0)
    let Mm = mn_make(2, 2, dm)
    let nmax = mn_max(Mm)
    if not approx(nmax, 5.0, 0.0001)
        fail("max_norm")

    // ── KAT 6: mn_vec_l2([3,4]) == 5.0 ──────────────────────────────────────
    let v1 = []
    push(v1, 3.0)
    push(v1, 4.0)
    let vl2 = mn_vec_l2(v1)
    if not approx(vl2, 5.0, 0.0001)
        fail("vec_l2")

    // ── KAT 7: mn_vec_l1([1,-2,3]) == 6.0 ───────────────────────────────────
    let v2 = []
    push(v2, 1.0)
    push(v2, 0.0 - 2.0)
    push(v2, 3.0)
    let vl1 = mn_vec_l1(v2)
    if not approx(vl1, 6.0, 0.0001)
        fail("vec_l1")

    // ── KAT 8: mn_vec_linf([1,-5,3]) == 5.0 ─────────────────────────────────
    let v3 = []
    push(v3, 1.0)
    push(v3, 0.0 - 5.0)
    push(v3, 3.0)
    let vlinf = mn_vec_linf(v3)
    if not approx(vlinf, 5.0, 0.0001)
        fail("vec_linf")

    // ── KAT 9: mn_dot([1,2,3],[4,5,6]) == 32.0 ──────────────────────────────
    let u = []
    push(u, 1.0)
    push(u, 2.0)
    push(u, 3.0)
    let v4 = []
    push(v4, 4.0)
    push(v4, 5.0)
    push(v4, 6.0)
    let dot = mn_dot(u, v4)
    if not approx(dot, 32.0, 0.0001)
        fail("dot")

    // ── KAT 10: mn_is_zero on a zero matrix == true ──────────────────────────
    let dz = []
    push(dz, 0.0)
    push(dz, 0.0)
    push(dz, 0.0)
    push(dz, 0.0)
    let Mz = mn_make(2, 2, dz)
    if not mn_is_zero(Mz, 0.0001)
        fail("is_zero_true")
    if mn_is_zero(M22a, 0.0001)
        fail("is_zero_false")

    // ── KAT 11: mn_normalize_frobenius: norm of result == 1.0 ────────────────
    let d_nn = []
    push(d_nn, 3.0)
    push(d_nn, 4.0)
    push(d_nn, 0.0)
    push(d_nn, 0.0)
    let Mnn = mn_make(2, 2, d_nn)
    let Mnorm = mn_normalize_frobenius(Mnn)
    let fro_n = mn_frobenius(Mnorm)
    if not approx(fro_n, 1.0, 0.0001)
        fail("normalize_frobenius")

    // ── KAT 12: mn_distance_frobenius(A, A) == 0.0 ───────────────────────────
    let dist0 = mn_distance_frobenius(M22a, M22a)
    if not approx(dist0, 0.0, 0.0001)
        fail("distance_same")

    // ── KAT 13: mn_trace_norm_hint on diagonal matrix == sum of |diag| ───────
    let dtrace = []
    push(dtrace, 3.0)
    push(dtrace, 0.0)
    push(dtrace, 0.0)
    push(dtrace, 0.0 - 4.0)
    let Mtrace = mn_make(2, 2, dtrace)
    let tn = mn_trace_norm_hint(Mtrace)
    if not approx(tn, 7.0, 0.0001)
        fail("trace_norm_hint")

    print("PASS _matnorm_test")
