import std/raster/thick_line

// cki — check int equality; FAIL+exit(1) on mismatch.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL thick_line " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb — check bool equality; FAIL+exit(1) on mismatch.
fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL thick_line " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

// pt_eq — true iff two [x,y] points are equal.
fn pt_eq(a: list, b: list) -> bool
    a[0] == b[0] and a[1] == b[1]

// pts_eq — true iff two point lists have identical length and element-wise equality.
fn pts_eq(a: list, b: list) -> bool
    let ok = true
    if len(a) != len(b)
        ok = false
    else
        let i = 0
        while i < len(a)
            if not pt_eq(a[i], b[i])
                ok = false
            i = i + 1
    ok

// pts_str — compact debug string.
fn pts_str(pp: list) -> string
    let parts = []
    let i = 0
    while i < len(pp)
        let p = pp[i]
        push(parts, "(" + str(p[0]) + "," + str(p[1]) + ")")
        i = i + 1
    join(parts, ",")

// pts_contains — true iff points list contains the given [x,y].
fn pts_contains(pp: list, x: int, y: int) -> bool
    let found = false
    let i = 0
    while i < len(pp)
        let p = pp[i]
        if p[0] == x and p[1] == y
            found = true
        i = i + 1
    found

// count_y — count how many distinct y values appear in the point list.
fn count_distinct_y(pp: list) -> int
    let seen = {}
    let i = 0
    while i < len(pp)
        let k = str(pp[i][1])
        seen[k] = 1
        i = i + 1
    len(seen)

fn main()
    // KAT 1: tl_line(0,0,3,0) == [[0,0],[1,0],[2,0],[3,0]]
    let want1 = [[0,0],[1,0],[2,0],[3,0]]
    let got1 = tl_line(0, 0, 3, 0)
    if not pts_eq(got1, want1)
        print("FAIL thick_line kat1_plain: got=" + pts_str(got1) + " want=" + pts_str(want1))
        exit(1)

    // KAT 2: tl_dashed(0,0,7,0,2,2) -> [[0,0],[1,0],[4,0],[5,0]]
    // period=4; idx 0->pos0<2 draw, idx1->pos1<2 draw, idx2->pos2>=2 skip, idx3->pos3>=2 skip
    // idx4->pos0<2 draw, idx5->pos1<2 draw, idx6->pos2>=2 skip, idx7->pos3>=2 skip
    let want2 = [[0,0],[1,0],[4,0],[5,0]]
    let got2 = tl_dashed(0, 0, 7, 0, 2, 2)
    if not pts_eq(got2, want2)
        print("FAIL thick_line kat2_dashed: got=" + pts_str(got2) + " want=" + pts_str(want2))
        exit(1)

    // KAT 3: tl_dotted(0,0,6,0,2) -> [[0,0],[2,0],[4,0],[6,0]]
    let want3 = [[0,0],[2,0],[4,0],[6,0]]
    let got3 = tl_dotted(0, 0, 6, 0, 2)
    if not pts_eq(got3, want3)
        print("FAIL thick_line kat3_dotted: got=" + pts_str(got3) + " want=" + pts_str(want3))
        exit(1)

    // KAT 4: tl_thick_horizontal(0,2,5,3)
    // x0=0,x1=2,y=5,width=3 -> half=1 -> rows y-1..y+1 = 4,5,6 for x=0,1,2
    let got4 = tl_thick_horizontal(0, 2, 5, 3)
    // contains center row pixels
    ckb("kat4_th_has_05", pts_contains(got4, 0, 5), true)
    ckb("kat4_th_has_15", pts_contains(got4, 1, 5), true)
    ckb("kat4_th_has_25", pts_contains(got4, 2, 5), true)
    // 3 distinct y values (rows 4, 5, 6)
    let dy4 = count_distinct_y(got4)
    cki("kat4_th_rows", dy4, 3)
    // total pixels = 3 cols * 3 rows = 9
    cki("kat4_th_total", len(got4), 9)

    // KAT 5: tl_thick(0,0,4,0,1) == plain tl_line(0,0,4,0)
    let want5 = tl_line(0, 0, 4, 0)
    let got5 = tl_thick(0, 0, 4, 0, 1)
    if not pts_eq(got5, want5)
        print("FAIL thick_line kat5_thick1: got=" + pts_str(got5) + " want=" + pts_str(want5))
        exit(1)

    // KAT 6: tl_thick(0,0,4,0,3) -> width 3 centered, 3 rows (y=-1,0,1) for horizontal line
    // psy=sign(4)=1, psx=-sign(0)=0 -> perp dir (0,1); half=1 offsets -1,0,1
    let got6 = tl_thick(0, 0, 4, 0, 3)
    ckb("kat6_thick3_has_0m1", pts_contains(got6, 0, -1), true)
    ckb("kat6_thick3_has_00", pts_contains(got6, 0, 0), true)
    ckb("kat6_thick3_has_01", pts_contains(got6, 0, 1), true)
    // at least 3 distinct y rows
    let dy6 = count_distinct_y(got6)
    cki("kat6_thick3_rows", dy6, 3)

    // KAT 7: tl_pattern — bits 0 and 2 set -> pixels at index 0 and 2 only (for short line)
    // pattern = 0b0101 = 5; line length 4 -> indices 0,1,2,3; bits: 0=1,1=0,2=1,3=0 -> draw 0 and 2
    let got7 = tl_pattern(0, 0, 3, 0, 5)
    cki("kat7_pattern_len", len(got7), 2)
    ckb("kat7_pattern_x0", pts_contains(got7, 0, 0), true)
    ckb("kat7_pattern_x2", pts_contains(got7, 2, 0), true)
    ckb("kat7_pattern_x1", pts_contains(got7, 1, 0), false)

    // KAT 8: tl_dashed single-on — on=1,off=3 for 8 points -> indices 0,4 drawn
    let got8 = tl_dashed(0, 0, 7, 0, 1, 3)
    cki("kat8_dash13_len", len(got8), 2)
    ckb("kat8_dash13_x0", pts_contains(got8, 0, 0), true)
    ckb("kat8_dash13_x4", pts_contains(got8, 4, 0), true)

    // KAT 9: tl_dotted gap=1 -> all points
    let got9 = tl_dotted(0, 0, 3, 0, 1)
    cki("kat9_dot1_len", len(got9), 4)

    // KAT 10: tl_pattern all bits set (pattern=-1 = all 1s) -> all points
    let got10 = tl_pattern(0, 0, 3, 0, -1)
    cki("kat10_pattern_all_len", len(got10), 4)

    print("PASS _thick_line_test")
