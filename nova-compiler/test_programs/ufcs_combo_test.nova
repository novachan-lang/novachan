type Rect
    x: Int
    y: Int
    w: Int
    h: Int

type Circle
    cx: Int
    cy: Int
    r: Int

fn Rect.contains(px, py)
    px >= self.x and px < self.x + self.w and py >= self.y and py < self.y + self.h

fn Rect.len()
    2 * (self.w + self.h)

fn Circle.contains(px, py)
    let dx = px - self.cx
    let dy = py - self.cy
    dx * dx + dy * dy <= self.r * self.r

fn main()
    let r = Rect { x: 0, y: 0, w: 10, h: 5 }
    print("1: rect contains")
    assert(r.contains(5, 3) == true, "rect inside")
    print("2: rect len")
    assert(r.len() == 30, "rect perimeter")
    print("3: list len")
    let lst = [10, 20, 30]
    assert(len(lst) == 3, "list len")
    print("4: circle contains")
    let c = Circle { cx: 0, cy: 0, r: 5 }
    assert(c.contains(3, 4) == true, "circle inside")
    print("ufcs_combo_test: all passed")
