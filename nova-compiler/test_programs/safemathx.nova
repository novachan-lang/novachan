fn safe_add(a, b)
  let result = a + b
  if a > 0 and b > 0 and result < 0
    return err("overflow")
  if a < 0 and b < 0 and result > 0
    return err("underflow")
  ok(result)

fn safe_mul(a, b)
  if a == 0 or b == 0
    return ok(0)
  let result = a * b
  if result / a != b
    return err("overflow")
  ok(result)

fn safe_div(a, b)
  if b == 0
    return err("division by zero")
  ok(a / b)

fn safe_mod(a, b)
  if b == 0
    return err("modulo by zero")
  ok(a % b)

fn safe_neg(a)
  if a == -9223372036854775807 - 1
    return err("overflow: cannot negate MIN_INT")
  ok(0 - a)

fn main()
  assert(unwrap(safe_add(1, 2)) == 3, "add ok")
  assert(unwrap(safe_mul(6, 7)) == 42, "mul ok")
  assert(unwrap(safe_div(10, 3)) == 3, "div ok")
  assert(unwrap(safe_mod(10, 3)) == 1, "mod ok")
  assert(unwrap(safe_neg(5)) == -5, "neg ok")

  assert(is_err(safe_div(1, 0)), "div by zero")
  assert(is_err(safe_mod(1, 0)), "mod by zero")

  let big = 4611686018427387903
  assert(is_ok(safe_add(big, 1)), "big add ok")
  assert(is_ok(safe_mul(1000000, 1000000)), "big mul ok")

  assert(unwrap(safe_add(0, 0)) == 0, "zero add")
  assert(unwrap(safe_mul(0, 999999)) == 0, "zero mul")

  print("safemathx: all passed")
