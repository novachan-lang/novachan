fn ret_any_float() -> any
    3.14

fn ret_any_bigint() -> any
    4613303441197561744

fn ret_any_negbig() -> any
    -4610549147222700502

fn takes_any(x: any) -> string
    str(x)

print("G1 ret_any_float: " + str(ret_any_float()))
print("G1 ret_any_bigint: " + str(ret_any_bigint()))
print("G1 ret_any_negbig: " + str(ret_any_negbig()))
print("G3 takes_any(float): " + takes_any(7.5))
print("G3 takes_any(bigint): " + takes_any(4613303441197561744))

let local_any: any = 9.75
print("G2 local_any: " + str(local_any))

let big_local: any = 4613303441197561744
