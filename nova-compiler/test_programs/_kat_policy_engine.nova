import forge_policy_engine

fn main()
    let pe = pe_new()
    pe = pe_add_rule(pe, "high-risk", "amount", "gt", 10000, "block")
    pe = pe_add_rule(pe, "blocked-country", "country", "eq", "XX", "deny")
    pe = pe_add_rule(pe, "low-value", "amount", "lt", 100, "auto-approve")

    assert(pe_rule_count(pe) == 3, "3 rules")

    let f1 = {}
    f1["amount"] = 50000
    f1["country"] = "US"
    let d1 = pe_evaluate(pe, f1)
    assert(d1 == "block", "high amount blocked")

    let f2 = {}
    f2["amount"] = 500
    f2["country"] = "XX"
    let d2 = pe_evaluate(pe, f2)
    assert(d2 == "deny", "blocked country denied")

    let f3 = {}
    f3["amount"] = 50
    f3["country"] = "US"
    let d3 = pe_evaluate(pe, f3)
    assert(d3 == "auto-approve", "low value auto-approved")

    let f4 = {}
    f4["amount"] = 5000
    f4["country"] = "US"
    let d4 = pe_evaluate(pe, f4)
    assert(d4 == "default", "no rule matches")

    pe = pe_disable_rule(pe, "high-risk")
    let f5 = {}
    f5["amount"] = 50000
    f5["country"] = "US"
    let d5 = pe_evaluate(pe, f5)
    assert(d5 == "default", "disabled rule skipped")

    let log = pe_decision_log(pe)
    assert(len(log) == 3, "3 decisions logged")
    assert(pe_last_decision(pe) == "auto-approve", "last=auto-approve")

    print("POLICY-ENGINE KAT PASS")
