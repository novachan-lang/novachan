import forge_error_registry

fn main()
    let e = ereg_new()
    e = ereg_register(e, "E001", "Not found", "warning")
    e = ereg_register(e, "E002", "Unauthorized", "critical")
    e = ereg_register(e, "E003", "Timeout", "warning")

    assert(ereg_message(e, "E001") == "Not found", "E001 msg")
    assert(ereg_severity(e, "E002") == "critical", "E002 severity")
    assert(ereg_is_critical(e, "E002") == 1, "E002 critical")
    assert(ereg_is_critical(e, "E001") == 0, "E001 not critical")

    e = ereg_raise(e, "E001")
    e = ereg_raise(e, "E001")
    e = ereg_raise(e, "E001")
    e = ereg_raise(e, "E002")
    assert(ereg_count(e, "E001") == 3, "E001 x3")
    assert(ereg_count(e, "E002") == 1, "E002 x1")
    assert(ereg_total(e) == 4, "4 total")
    assert(ereg_most_frequent(e) == "E001", "E001 most frequent")

    assert(ereg_message(e, "UNKNOWN") == "unknown error", "unknown msg")
    assert(ereg_count(e, "UNKNOWN") == 0, "unknown count 0")

    print("ERROR-REGISTRY KAT PASS")
