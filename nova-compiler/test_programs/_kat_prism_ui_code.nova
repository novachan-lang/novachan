// KAT for prism/ui/prism_ui_code.nova (milestone MB.24, the `ui/` composition layer's code/syntax
// display family: fenced code block, inline code, before/after diff, titled line-numbered
// snippet).
//
// Proves, against concrete expected values (every depth/count is hand-computed from
// prism_node.nova's own `depth = max(child depths) + 1`, `count = 1 + sum(child counts)` rule,
// never guessed):
//   1. prism_cd_block: exact stack(d=2,c=2) with no lang, stack(d=2,c=3) with a lang, blank
//      Some("") lang degrades to the no-lang shape (c=2); `"cd_lang"` attr is `""` for
//      None/blank and the literal string otherwise, in EVERY case (attr recorded independent of
//      whether a label was rendered); rejects an empty cd_code.
//   2. prism_cd_inline: exact label(d=1,c=1) with `"text"` = the code and `"cd_inline"` = `"true"`;
//      rejects an empty cd_code.
//   3. prism_cd_diff: exact band(d=2,c=3) bare with no label, stack(d=3,c=5) with a label, blank
//      Some("") label degrades to the bare-band shape (c=3), a before-only diff (empty cd_after)
//      and an after-only diff (empty cd_before) both succeed; rejects only the BOTH-empty case.
//   4. prism_cd_snippet: exact stack(d=2,c=3) with a bare-label header and unsplit whole-code body
//      (proving the un-numbered path does NOT split on "\n"), stack(d=3,c=5) with a lang in the
//      header, exact stack(d=4,c=12) with 3-line numbering starting at 10 (line numbers 10/11/12
//      read back exactly), a 1-line numbered case (d=4,c=6), a combined lang+numbering case
//      (d=4,c=11), and the exact runtime `split` trailing-newline behavior (a trailing "\n"
//      produces an extra blank final line, unmodified by this module); rejects an empty cd_title,
//      an empty cd_code, and cd_line_start < 1 (0 and -1 both checked).
//   5. Rejection tally: at least 4 distinct rejections proven above (8, counted explicitly).
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova into
// $NOVA_HOME/lib, so `import prism_node` / `import prism_ui_code` resolve.
//   ./gen3_test.exe _kat_prism_ui_code.nova
//   clang -O2 -o _kat_prism_ui_code.exe _kat_prism_ui_code.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_ui_code.exe

import prism_node
import prism_content
import prism_ui_code as cd

let FAILED = [0]

fn _check(label: string, got: string, want: string)
    if got == want
        print("  pass  " + label)
    else
        print("  FAIL  " + label + "  got=" + got + "  want=" + want)
        FAILED[0] = FAILED[0] + 1

fn _check_true(label: string, cond: bool)
    if cond
        print("  pass  " + label)
    else
        print("  FAIL  " + label)
        FAILED[0] = FAILED[0] + 1

fn main()
    // ── 1. prism_cd_block: exact stack(d=2,c=2)/(d=2,c=3), cd_lang attr always recorded, 1 reject ──
    let block_r = cd.prism_cd_block("print('hi')", none())
    _check_true("block (no lang) constructs", is_ok(block_r))
    let block_node = unwrap(block_r)
    _check("block(no lang) kind_str", prism_node.prism_node_kind_str(block_node), "stack")
    _check("block(no lang) depth", str(prism_node.prism_node_depth(block_node)), "2")
    _check("block(no lang) count", str(prism_node.prism_node_count(block_node)), "2")
    let b_kids = prism_node.prism_node_children(block_node)
    _check("block(no lang) child count", str(len(b_kids)), "1")
    _check("block(no lang) code text", prism_node.prism_node_attr_str(b_kids[0], "text", ""), "print('hi')")
    _check("block(no lang) cd_lang attr is empty", prism_node.prism_node_attr_str(block_node, "cd_lang", "MISSING"), "")

    let block2_r = cd.prism_cd_block("print('hi')", some("python"))
    _check_true("block (with lang) constructs", is_ok(block2_r))
    let block2_node = unwrap(block2_r)
    _check("block(with lang) depth", str(prism_node.prism_node_depth(block2_node)), "2")
    _check("block(with lang) count", str(prism_node.prism_node_count(block2_node)), "3")
    let b2_kids = prism_node.prism_node_children(block2_node)
    _check("block(with lang) child count", str(len(b2_kids)), "2")
    _check("block(with lang) lang label text", prism_node.prism_node_attr_str(b2_kids[0], "text", ""), "python")
    _check("block(with lang) code label text", prism_node.prism_node_attr_str(b2_kids[1], "text", ""), "print('hi')")
    _check("block(with lang) cd_lang attr", prism_node.prism_node_attr_str(block2_node, "cd_lang", "MISSING"), "python")

    // Present-but-blank lang degrades to the no-lang shape (c=2), and the attr is "" too.
    let block3_r = cd.prism_cd_block("print('hi')", some(""))
    _check_true("block (blank Some lang) constructs", is_ok(block3_r))
    let block3_node = unwrap(block3_r)
    _check("block(blank lang) count degrades to 2 (same as no-lang)", str(prism_node.prism_node_count(block3_node)), "2")
    _check("block(blank lang) child count degrades to 1", str(len(prism_node.prism_node_children(block3_node))), "1")
    _check("block(blank lang) cd_lang attr is empty", prism_node.prism_node_attr_str(block3_node, "cd_lang", "MISSING"), "")

    let block_empty_r = cd.prism_cd_block("", none())
    _check_true("block rejects an empty cd_code", is_err(block_empty_r))
    print("")

    // ── 2. prism_cd_inline: exact label(d=1,c=1), text + cd_inline attrs, 1 reject ────────────────
    let inline_r = cd.prism_cd_inline("let x = 5")
    _check_true("inline constructs", is_ok(inline_r))
    let inline_node = unwrap(inline_r)
    _check("inline kind_str", prism_node.prism_node_kind_str(inline_node), "label")
    _check("inline depth", str(prism_node.prism_node_depth(inline_node)), "1")
    _check("inline count", str(prism_node.prism_node_count(inline_node)), "1")
    _check("inline text", prism_node.prism_node_attr_str(inline_node, "text", ""), "let x = 5")
    _check("inline cd_inline attr", prism_node.prism_node_attr_str(inline_node, "cd_inline", ""), "true")
    _check("inline child count", str(len(prism_node.prism_node_children(inline_node))), "0")

    let inline_empty_r = cd.prism_cd_inline("")
    _check_true("inline rejects an empty cd_code", is_err(inline_empty_r))
    print("")

    // ── 3. prism_cd_diff: bare band(d=2,c=3), stack(d=3,c=5) with a label, one-sided diffs, 1 reject ──
    let diff_r = cd.prism_cd_diff("foo", "bar", none())
    _check_true("diff (no label) constructs", is_ok(diff_r))
    let diff_node = unwrap(diff_r)
    _check("diff(no label) kind_str (bare band, wrapper omitted)", prism_node.prism_node_kind_str(diff_node), "band")
    _check("diff(no label) depth", str(prism_node.prism_node_depth(diff_node)), "2")
    _check("diff(no label) count", str(prism_node.prism_node_count(diff_node)), "3")
    let d_kids = prism_node.prism_node_children(diff_node)
    _check("diff(no label) child count", str(len(d_kids)), "2")
    _check("diff(no label) before text", prism_node.prism_node_attr_str(d_kids[0], "text", ""), "foo")
    _check("diff(no label) after text", prism_node.prism_node_attr_str(d_kids[1], "text", ""), "bar")

    let diff2_r = cd.prism_cd_diff("foo", "bar", some("Changes"))
    _check_true("diff (with label) constructs", is_ok(diff2_r))
    let diff2_node = unwrap(diff2_r)
    _check("diff(with label) kind_str", prism_node.prism_node_kind_str(diff2_node), "stack")
    _check("diff(with label) depth", str(prism_node.prism_node_depth(diff2_node)), "3")
    _check("diff(with label) count", str(prism_node.prism_node_count(diff2_node)), "5")
    let d2_kids = prism_node.prism_node_children(diff2_node)
    _check("diff(with label) child count", str(len(d2_kids)), "2")
    _check("diff(with label) heading text", prism_node.prism_node_attr_str(d2_kids[0], "text", ""), "Changes")
    _check("diff(with label) band kind_str", prism_node.prism_node_kind_str(d2_kids[1]), "band")

    // Present-but-blank label degrades to the bare-band shape.
    let diff3_r = cd.prism_cd_diff("foo", "bar", some(""))
    _check_true("diff (blank Some label) constructs", is_ok(diff3_r))
    let diff3_node = unwrap(diff3_r)
    _check("diff(blank label) kind_str degrades to bare band", prism_node.prism_node_kind_str(diff3_node), "band")
    _check("diff(blank label) count degrades to 3", str(prism_node.prism_node_count(diff3_node)), "3")

    // One-sided diffs: a pure addition (empty before) and a pure deletion (empty after) both succeed.
    let diff_add_r = cd.prism_cd_diff("", "new line added", none())
    _check_true("diff (pure addition, empty before) constructs", is_ok(diff_add_r))
    let diff_add_node = unwrap(diff_add_r)
    let da_kids = prism_node.prism_node_children(diff_add_node)
    _check("diff(pure addition) before text is empty", prism_node.prism_node_attr_str(da_kids[0], "text", "MISSING"), "")
    _check("diff(pure addition) after text", prism_node.prism_node_attr_str(da_kids[1], "text", ""), "new line added")

    let diff_del_r = cd.prism_cd_diff("old line removed", "", none())
    _check_true("diff (pure deletion, empty after) constructs", is_ok(diff_del_r))
    let dd_kids = prism_node.prism_node_children(unwrap(diff_del_r))
    _check("diff(pure deletion) before text", prism_node.prism_node_attr_str(dd_kids[0], "text", ""), "old line removed")
    _check("diff(pure deletion) after text is empty", prism_node.prism_node_attr_str(dd_kids[1], "text", "MISSING"), "")

    let diff_both_empty_r = cd.prism_cd_diff("", "", none())
    _check_true("diff rejects both cd_before AND cd_after empty", is_err(diff_both_empty_r))
    print("")

    // ── 4. prism_cd_snippet: unsplit body, lang header, 3-line numbering, 1-line, combined, 4 rejects ──
    let snip_r = cd.prism_cd_snippet("main.py", "print(1)", none(), none())
    _check_true("snippet (no lang, no numbering) constructs", is_ok(snip_r))
    let snip_node = unwrap(snip_r)
    _check("snippet(bare) kind_str", prism_node.prism_node_kind_str(snip_node), "stack")
    _check("snippet(bare) depth", str(prism_node.prism_node_depth(snip_node)), "2")
    _check("snippet(bare) count", str(prism_node.prism_node_count(snip_node)), "3")
    let sn_kids = prism_node.prism_node_children(snip_node)
    _check("snippet(bare) child count", str(len(sn_kids)), "2")
    _check("snippet(bare) header kind_str (bare label, wrapper omitted)", prism_node.prism_node_kind_str(sn_kids[0]), "label")
    _check("snippet(bare) title text", prism_node.prism_node_attr_str(sn_kids[0], "text", ""), "main.py")
    _check("snippet(bare) code kind_str", prism_node.prism_node_kind_str(sn_kids[1]), "label")
    _check("snippet(bare) code text", prism_node.prism_node_attr_str(sn_kids[1], "text", ""), "print(1)")

    // Un-numbered path does NOT split on "\n" -- the whole multi-line string survives as ONE label.
    let snip_multi_r = cd.prism_cd_snippet("File", "a\nb", none(), none())
    _check_true("snippet (multi-line, no numbering) constructs", is_ok(snip_multi_r))
    let snip_multi_node = unwrap(snip_multi_r)
    let sm_kids = prism_node.prism_node_children(snip_multi_node)
    _check("snippet(multi-line, unsplit) code text is the RAW un-split string", prism_node.prism_node_attr_str(sm_kids[1], "text", ""), "a\nb")
    _check("snippet(multi-line, unsplit) depth stays 2 (one label, not a stack of lines)", str(prism_node.prism_node_depth(snip_multi_node)), "2")

    // Header WITH a lang: band(d=2,c=3), no numbering.
    let snip2_r = cd.prism_cd_snippet("main.py", "print(1)", some("python"), none())
    _check_true("snippet (with lang, no numbering) constructs", is_ok(snip2_r))
    let snip2_node = unwrap(snip2_r)
    _check("snippet(with lang) depth", str(prism_node.prism_node_depth(snip2_node)), "3")
    _check("snippet(with lang) count", str(prism_node.prism_node_count(snip2_node)), "5")
    let sn2_kids = prism_node.prism_node_children(snip2_node)
    _check("snippet(with lang) header kind_str", prism_node.prism_node_kind_str(sn2_kids[0]), "band")
    let sn2_header_kids = prism_node.prism_node_children(sn2_kids[0])
    _check("snippet(with lang) header title text", prism_node.prism_node_attr_str(sn2_header_kids[0], "text", ""), "main.py")
    _check("snippet(with lang) header lang text", prism_node.prism_node_attr_str(sn2_header_kids[1], "text", ""), "python")

    // Numbered, 3 lines, starting at 10: exact stack(d=4,c=12), rows 10/11/12 read back exactly.
    let snip3_r = cd.prism_cd_snippet("main.py", "a\nb\nc", none(), some(10))
    _check_true("snippet (numbered, 3 lines, start=10) constructs", is_ok(snip3_r))
    let snip3_node = unwrap(snip3_r)
    _check("snippet(numbered) kind_str", prism_node.prism_node_kind_str(snip3_node), "stack")
    _check("snippet(numbered) depth", str(prism_node.prism_node_depth(snip3_node)), "4")
    _check("snippet(numbered) count", str(prism_node.prism_node_count(snip3_node)), "12")
    let sn3_kids = prism_node.prism_node_children(snip3_node)
    _check("snippet(numbered) header kind_str (bare label, no lang)", prism_node.prism_node_kind_str(sn3_kids[0]), "label")
    _check("snippet(numbered) code block kind_str", prism_node.prism_node_kind_str(sn3_kids[1]), "stack")
    let sn3_rows = prism_node.prism_node_children(sn3_kids[1])
    _check("snippet(numbered) row count", str(len(sn3_rows)), "3")
    let row0_kids = prism_node.prism_node_children(sn3_rows[0])
    _check("snippet(numbered) row0 kind_str", prism_node.prism_node_kind_str(sn3_rows[0]), "band")
    _check("snippet(numbered) row0 line number (start=10)", prism_node.prism_node_attr_str(row0_kids[0], "text", ""), "10")
    _check("snippet(numbered) row0 line text", prism_node.prism_node_attr_str(row0_kids[1], "text", ""), "a")
    let row1_kids = prism_node.prism_node_children(sn3_rows[1])
    _check("snippet(numbered) row1 line number", prism_node.prism_node_attr_str(row1_kids[0], "text", ""), "11")
    _check("snippet(numbered) row1 line text", prism_node.prism_node_attr_str(row1_kids[1], "text", ""), "b")
    let row2_kids = prism_node.prism_node_children(sn3_rows[2])
    _check("snippet(numbered) row2 line number (last)", prism_node.prism_node_attr_str(row2_kids[0], "text", ""), "12")
    _check("snippet(numbered) row2 line text", prism_node.prism_node_attr_str(row2_kids[1], "text", ""), "c")

    // Numbered, 1 line, start=1: exact stack(d=4,c=6).
    let snip4_r = cd.prism_cd_snippet("T", "only", none(), some(1))
    _check_true("snippet (numbered, 1 line, start=1) constructs", is_ok(snip4_r))
    let snip4_node = unwrap(snip4_r)
    _check("snippet(1-line numbered) depth", str(prism_node.prism_node_depth(snip4_node)), "4")
    _check("snippet(1-line numbered) count", str(prism_node.prism_node_count(snip4_node)), "6")
    let sn4_code_kids = prism_node.prism_node_children(prism_node.prism_node_children(snip4_node)[1])
    _check("snippet(1-line numbered) exactly 1 row", str(len(sn4_code_kids)), "1")
    let sn4_row0_kids = prism_node.prism_node_children(sn4_code_kids[0])
    _check("snippet(1-line numbered) row0 line number", prism_node.prism_node_attr_str(sn4_row0_kids[0], "text", ""), "1")
    _check("snippet(1-line numbered) row0 line text", prism_node.prism_node_attr_str(sn4_row0_kids[1], "text", ""), "only")

    // Combined: lang header AND numbering both present -- exact stack(d=4,c=11).
    let snip5_r = cd.prism_cd_snippet("T", "x\ny", some("go"), some(1))
    _check_true("snippet (lang + numbering combined) constructs", is_ok(snip5_r))
    let snip5_node = unwrap(snip5_r)
    _check("snippet(combined) depth", str(prism_node.prism_node_depth(snip5_node)), "4")
    _check("snippet(combined) count", str(prism_node.prism_node_count(snip5_node)), "11")
    let sn5_kids = prism_node.prism_node_children(snip5_node)
    _check("snippet(combined) header kind_str (lang present)", prism_node.prism_node_kind_str(sn5_kids[0]), "band")
    _check("snippet(combined) code block row count", str(len(prism_node.prism_node_children(sn5_kids[1]))), "2")

    // Exact runtime `split` trailing-newline behavior: a trailing "\n" produces an extra blank
    // final line -- this module does not trim or special-case it, it reflects `split`'s own result.
    let snip6_r = cd.prism_cd_snippet("T", "a\n", none(), some(1))
    _check_true("snippet (trailing newline) constructs", is_ok(snip6_r))
    let sn6_rows = prism_node.prism_node_children(prism_node.prism_node_children(unwrap(snip6_r))[1])
    _check("snippet(trailing newline) produces 2 rows (a, then a blank line)", str(len(sn6_rows)), "2")
    let sn6_row0_kids = prism_node.prism_node_children(sn6_rows[0])
    _check("snippet(trailing newline) row0 text", prism_node.prism_node_attr_str(sn6_row0_kids[1], "text", "MISSING"), "a")
    let sn6_row1_kids = prism_node.prism_node_children(sn6_rows[1])
    _check("snippet(trailing newline) row1 line number", prism_node.prism_node_attr_str(sn6_row1_kids[0], "text", ""), "2")
    _check("snippet(trailing newline) row1 text is the blank trailing line", prism_node.prism_node_attr_str(sn6_row1_kids[1], "text", "MISSING"), "")

    let snip_empty_title_r = cd.prism_cd_snippet("", "code", none(), none())
    _check_true("snippet rejects an empty cd_title", is_err(snip_empty_title_r))
    let snip_empty_code_r = cd.prism_cd_snippet("T", "", none(), none())
    _check_true("snippet rejects an empty cd_code", is_err(snip_empty_code_r))
    let snip_zero_start_r = cd.prism_cd_snippet("T", "code", none(), some(0))
    _check_true("snippet rejects cd_line_start == 0", is_err(snip_zero_start_r))
    let snip_neg_start_r = cd.prism_cd_snippet("T", "code", none(), some(-1))
    _check_true("snippet rejects cd_line_start < 0", is_err(snip_neg_start_r))
    print("")

    // ── 5. Rejection tally: at least 4 distinct rejections proven above (8, counted here) ─────────
    // block: empty cd_code (1); inline: empty cd_code (1); diff: both empty (1);
    // snippet: empty title, empty code, line_start==0, line_start<0 (4)
    let rejection_count = 8
    _check_true("expected at least 4 rejection cases, counted " + str(rejection_count), rejection_count >= 4)

    if FAILED[0] == 0
        print("")
        print("_kat_prism_ui_code: ALL PASS")
    else
        print("")
        print("_kat_prism_ui_code: " + str(FAILED[0]) + " FAILURE(S)")
        exit(1)
