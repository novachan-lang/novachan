import std/net/syslog3164

// ── Helpers ───────────────────────────────────────────────────────────────────

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL syslog3164 " + label + ": got=[" + got + "] want=[" + want + "]")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL syslog3164 " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ── KAT 1: RFC3164 canonical example ─────────────────────────────────────────
// Input: "<34>Oct 11 22:14:15 mymachine su: 'su root' failed"
// PRI=34 -> facility=34/8=4, severity=34-(4*8)=2
// timestamp = "Oct 11 22:14:15"
// hostname  = "mymachine"
// tag       = "su"
// content   = "'su root' failed"

let rfc_line = "<34>Oct 11 22:14:15 mymachine su: " + chr(39) + "su root" + chr(39) + " failed"
let p1 = syslog3164_parse(rfc_line)
cks("k1.pri",       p1["pri"],       "34")
cks("k1.facility",  p1["facility"],  "4")
cks("k1.severity",  p1["severity"],  "2")
cks("k1.timestamp", p1["timestamp"], "Oct 11 22:14:15")
cks("k1.hostname",  p1["hostname"],  "mymachine")
cks("k1.tag",       p1["tag"],       "su")
cks("k1.content",   p1["content"],   chr(39) + "su root" + chr(39) + " failed")

// ── KAT 2: Tag with '[' bracket terminator (PID notation) ────────────────────
// "<13>Feb  5 17:32:12 10.0.0.99 myapp[1234]: Server started"
// PRI=13 -> facility=1, severity=5
// tag = "myapp" (stops at '[')

let bracket_line = "<13>Feb  5 17:32:12 10.0.0.99 myapp[1234]: Server started"
let p2 = syslog3164_parse(bracket_line)
cks("k2.pri",       p2["pri"],       "13")
cks("k2.facility",  p2["facility"],  "1")
cks("k2.severity",  p2["severity"],  "5")
cks("k2.timestamp", p2["timestamp"], "Feb  5 17:32:12")
cks("k2.hostname",  p2["hostname"],  "10.0.0.99")
cks("k2.tag",       p2["tag"],       "myapp")

// ── KAT 3: PRI=0 (kernel emergency), content with spaces ─────────────────────
// "<0>Jan  1 00:00:00 localhost kernel: Panic in module"
let p3 = syslog3164_parse("<0>Jan  1 00:00:00 localhost kernel: Panic in module")
cks("k3.pri",       p3["pri"],       "0")
cks("k3.facility",  p3["facility"],  "0")
cks("k3.severity",  p3["severity"],  "0")
cks("k3.timestamp", p3["timestamp"], "Jan  1 00:00:00")
cks("k3.hostname",  p3["hostname"],  "localhost")
cks("k3.tag",       p3["tag"],       "kernel")
cks("k3.content",   p3["content"],   "Panic in module")

// ── KAT 4: PRI=191 (max: facility=23, severity=7) ────────────────────────────
let p4 = syslog3164_parse("<191>Mar 15 08:30:00 srv1 test: hello")
cks("k4.pri",       p4["pri"],       "191")
cks("k4.facility",  p4["facility"],  "23")
cks("k4.severity",  p4["severity"],  "7")
cks("k4.tag",       p4["tag"],       "test")
cks("k4.content",   p4["content"],   "hello")

// ── KAT 5: Build then parse round-trip ───────────────────────────────────────
// Construct a fields dict, build a line, parse it back, check all fields match.
let fields = {}
fields["pri"]       = "34"
fields["timestamp"] = "Oct 11 22:14:15"
fields["hostname"]  = "mymachine"
fields["tag"]       = "su"
fields["content"]   = "hello world"

let built = syslog3164_build(fields)
let p5 = syslog3164_parse(built)
cks("rt.pri",       p5["pri"],       "34")
cks("rt.facility",  p5["facility"],  "4")
cks("rt.severity",  p5["severity"],  "2")
cks("rt.timestamp", p5["timestamp"], "Oct 11 22:14:15")
cks("rt.hostname",  p5["hostname"],  "mymachine")
cks("rt.tag",       p5["tag"],       "su")
cks("rt.content",   p5["content"],   "hello world")

// ── KAT 6: Error cases — malformed input returns empty dict ──────────────────
// No leading '<'
let bad1 = syslog3164_parse("Oct 11 22:14:15 host su: msg")
cks("bad1.pri", bad1["pri"], "")

// No closing '>'
let bad2 = syslog3164_parse("<34Oct 11 22:14:15 host su: msg")
cks("bad2.pri", bad2["pri"], "")

// Too short (less than 4 chars)
let bad3 = syslog3164_parse("<1>")
cks("bad3.pri", bad3["pri"], "")

// ── KAT 7: build() output format check ───────────────────────────────────────
// Verify the exact wire format: "<PRI>TIMESTAMP HOSTNAME TAG: CONTENT"
let f2 = {}
f2["pri"]       = "34"
f2["timestamp"] = "Oct 11 22:14:15"
f2["hostname"]  = "mymachine"
f2["tag"]       = "su"
f2["content"]   = "test message"
let built2 = syslog3164_build(f2)
cks("build.wire", built2, "<34>Oct 11 22:14:15 mymachine su: test message")

print("PASS _syslog3164_test")
