import std/search/binary_search

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL binary_search " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: str, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL binary_search " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn main()
    // --- bs_find ---
    // KAT: bs_find([1,3,5,7,9],5)=2
    let a1 = [1, 3, 5, 7, 9]
    cki("find([1,3,5,7,9],5)", bs_find(a1, 5), 2)
    // KAT: bs_find([1,3,5,7,9],4)=-1
    cki("find([1,3,5,7,9],4)", bs_find(a1, 4), -1)
    // KAT: bs_find([5],5)=0
    let a_single = [5]
    cki("find([5],5)", bs_find(a_single, 5), 0)
    // KAT: bs_find([],1)=-1
    let a_empty = []
    cki("find([],1)", bs_find(a_empty, 1), -1)
    // first element
    cki("find([1,3,5,7,9],1)", bs_find(a1, 1), 0)
    // last element
    cki("find([1,3,5,7,9],9)", bs_find(a1, 9), 4)
    // not found below range
    cki("find([1,3,5,7,9],0)", bs_find(a1, 0), -1)
    // not found above range
    cki("find([1,3,5,7,9],10)", bs_find(a1, 10), -1)

    // --- bs_first ---
    // KAT: bs_first([1,2,2,2,3],2)=1
    let a2 = [1, 2, 2, 2, 3]
    cki("first([1,2,2,2,3],2)", bs_first(a2, 2), 1)
    // first occurrence is also the only occurrence
    cki("first([1,2,2,2,3],1)", bs_first(a2, 1), 0)
    cki("first([1,2,2,2,3],3)", bs_first(a2, 3), 4)
    // not present
    cki("first([1,2,2,2,3],5)", bs_first(a2, 5), -1)
    // empty list
    cki("first([],2)", bs_first(a_empty, 2), -1)
    // single element found
    cki("first([5],5)", bs_first(a_single, 5), 0)
    // single element not found
    cki("first([5],3)", bs_first(a_single, 3), -1)

    // --- bs_last ---
    // KAT: bs_last([1,2,2,2,3],2)=3
    cki("last([1,2,2,2,3],2)", bs_last(a2, 2), 3)
    cki("last([1,2,2,2,3],1)", bs_last(a2, 1), 0)
    cki("last([1,2,2,2,3],3)", bs_last(a2, 3), 4)
    // not present
    cki("last([1,2,2,2,3],5)", bs_last(a2, 5), -1)
    // empty list
    cki("last([],2)", bs_last(a_empty, 2), -1)
    // single element
    cki("last([5],5)", bs_last(a_single, 5), 0)
    cki("last([5],3)", bs_last(a_single, 3), -1)

    // --- bs_contains ---
    // KAT: bs_contains([1,3,5],3)=true
    let a3 = [1, 3, 5]
    ckb("contains([1,3,5],3)", bs_contains(a3, 3), true)
    // KAT: bs_contains([1,3,5],2)=false
    ckb("contains([1,3,5],2)", bs_contains(a3, 2), false)
    // contains first
    ckb("contains([1,3,5],1)", bs_contains(a3, 1), true)
    // contains last
    ckb("contains([1,3,5],5)", bs_contains(a3, 5), true)
    // empty list
    ckb("contains([],1)", bs_contains(a_empty, 1), false)
    // single element found
    ckb("contains([5],5)", bs_contains(a_single, 5), true)
    // single element not found
    ckb("contains([5],3)", bs_contains(a_single, 3), false)

    print("PASS _binary_search_test")
