import std/numeral/ordinal_en

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL ordinal_en " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // ord_suffix KAT
    cks("suffix(1)",   ord_suffix(1),   "1st")
    cks("suffix(2)",   ord_suffix(2),   "2nd")
    cks("suffix(3)",   ord_suffix(3),   "3rd")
    cks("suffix(4)",   ord_suffix(4),   "4th")
    cks("suffix(10)",  ord_suffix(10),  "10th")
    cks("suffix(11)",  ord_suffix(11),  "11th")
    cks("suffix(12)",  ord_suffix(12),  "12th")
    cks("suffix(13)",  ord_suffix(13),  "13th")
    cks("suffix(20)",  ord_suffix(20),  "20th")
    cks("suffix(21)",  ord_suffix(21),  "21st")
    cks("suffix(22)",  ord_suffix(22),  "22nd")
    cks("suffix(23)",  ord_suffix(23),  "23rd")
    cks("suffix(100)", ord_suffix(100), "100th")
    cks("suffix(101)", ord_suffix(101), "101st")
    cks("suffix(111)", ord_suffix(111), "111th")
    cks("suffix(112)", ord_suffix(112), "112th")
    cks("suffix(113)", ord_suffix(113), "113th")
    cks("suffix(121)", ord_suffix(121), "121st")

    // ord_word KAT
    cks("word(0)",    ord_word(0),    "zeroth")
    cks("word(1)",    ord_word(1),    "first")
    cks("word(2)",    ord_word(2),    "second")
    cks("word(3)",    ord_word(3),    "third")
    cks("word(4)",    ord_word(4),    "fourth")
    cks("word(5)",    ord_word(5),    "fifth")
    cks("word(8)",    ord_word(8),    "eighth")
    cks("word(9)",    ord_word(9),    "ninth")
    cks("word(11)",   ord_word(11),   "eleventh")
    cks("word(12)",   ord_word(12),   "twelfth")
    cks("word(13)",   ord_word(13),   "thirteenth")
    cks("word(20)",   ord_word(20),   "twentieth")
    cks("word(21)",   ord_word(21),   "twenty-first")
    cks("word(22)",   ord_word(22),   "twenty-second")
    cks("word(30)",   ord_word(30),   "thirtieth")
    cks("word(40)",   ord_word(40),   "fortieth")
    cks("word(100)",  ord_word(100),  "one hundredth")
    cks("word(101)",  ord_word(101),  "one hundred first")
    cks("word(1000)", ord_word(1000), "one thousandth")
    cks("word(1001)", ord_word(1001), "one thousand first")
    cks("word(1021)", ord_word(1021), "one thousand twenty-first")

    print("PASS _ordinal_en_test")
