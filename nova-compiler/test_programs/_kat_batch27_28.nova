// KAT for batch 27 + 28 builtins (16 functions)
let pass = 0
let fail = 0

// ---- batch 27 ----

// str_remove_suffix_if
let r1 = str_remove_suffix_if("hello.txt", ".txt")
if r1 == "hello"
    pass = pass + 1
else
    print("FAIL str_remove_suffix_if: expected 'hello' got '" + r1 + "'")
    fail = fail + 1

let r2 = str_remove_suffix_if("hello.txt", ".md")
if r2 == "hello.txt"
    pass = pass + 1
else
    print("FAIL str_remove_suffix_if nomatch: expected 'hello.txt' got '" + r2 + "'")
    fail = fail + 1

let r3 = str_remove_suffix_if("ab", "abcd")
if r3 == "ab"
    pass = pass + 1
else
    print("FAIL str_remove_suffix_if longer: expected 'ab' got '" + r3 + "'")
    fail = fail + 1

// list_group_by_mod
let g1 = list_group_by_mod([1, 2, 3, 4, 5, 6], 3)
if str(g1["0"]) == "[3, 6]" and str(g1["1"]) == "[1, 4]" and str(g1["2"]) == "[2, 5]"
    pass = pass + 1
else
    print("FAIL list_group_by_mod: got " + str(g1))
    fail = fail + 1

let g2 = list_group_by_mod([], 3)
if len(g2) == 0
    pass = pass + 1
else
    print("FAIL list_group_by_mod empty: got " + str(g2))
    fail = fail + 1

// dict_keys_shortest
let ks_d = {"apple": 1, "fig": 2, "banana": 3}
let ks = dict_keys_shortest(ks_d)
if ks == "fig"
    pass = pass + 1
else
    print("FAIL dict_keys_shortest: expected 'fig' got '" + ks + "'")
    fail = fail + 1

// str_is_upper_only
if str_is_upper_only("ABC") == true
    pass = pass + 1
else
    print("FAIL str_is_upper_only ABC")
    fail = fail + 1

if str_is_upper_only("ABc") == false
    pass = pass + 1
else
    print("FAIL str_is_upper_only ABc")
    fail = fail + 1

if str_is_upper_only("") == false
    pass = pass + 1
else
    print("FAIL str_is_upper_only empty")
    fail = fail + 1

// list_running_avg
let ra = list_running_avg([10, 20, 30])
if str(ra) == "[10, 15, 20]"
    pass = pass + 1
else
    print("FAIL list_running_avg: expected [10, 15, 20] got " + str(ra))
    fail = fail + 1

let ra2 = list_running_avg([])
if len(ra2) == 0
    pass = pass + 1
else
    print("FAIL list_running_avg empty")
    fail = fail + 1

// dict_values_flat
let dvf_d = {"a": 1, "b": 2}
let dvf = dict_values_flat(dvf_d)
if len(dvf) == 2
    pass = pass + 1
else
    print("FAIL dict_values_flat: expected len 2 got " + str(len(dvf)))
    fail = fail + 1

// str_byte_count
if str_byte_count("hello") == 5
    pass = pass + 1
else
    print("FAIL str_byte_count hello")
    fail = fail + 1

if str_byte_count("") == 0
    pass = pass + 1
else
    print("FAIL str_byte_count empty")
    fail = fail + 1

// list_zip_map
let zm = list_zip_map(["x", "y"], [10, 20])
if zm["x"] == 10 and zm["y"] == 20
    pass = pass + 1
else
    print("FAIL list_zip_map: got " + str(zm))
    fail = fail + 1

// ---- batch 28 ----

// list_second_max
if list_second_max([1, 5, 3, 9, 7]) == 7
    pass = pass + 1
else
    print("FAIL list_second_max: expected 7 got " + str(list_second_max([1, 5, 3, 9, 7])))
    fail = fail + 1

if list_second_max([4, 4, 4]) == 4
    pass = pass + 1
else
    print("FAIL list_second_max all-equal: expected 4")
    fail = fail + 1

if list_second_max([]) == 0
    pass = pass + 1
else
    print("FAIL list_second_max empty")
    fail = fail + 1

// list_second_min
if list_second_min([5, 1, 3, 9]) == 3
    pass = pass + 1
else
    print("FAIL list_second_min: expected 3 got " + str(list_second_min([5, 1, 3, 9])))
    fail = fail + 1

if list_second_min([2, 2]) == 2
    pass = pass + 1
else
    print("FAIL list_second_min all-equal")
    fail = fail + 1

// str_count_vowels
if str_count_vowels("Hello World") == 3
    pass = pass + 1
else
    print("FAIL str_count_vowels: expected 3 got " + str(str_count_vowels("Hello World")))
    fail = fail + 1

if str_count_vowels("xyz") == 0
    pass = pass + 1
else
    print("FAIL str_count_vowels none")
    fail = fail + 1

// str_count_consonants
if str_count_consonants("Hello World") == 7
    pass = pass + 1
else
    print("FAIL str_count_consonants: expected 7 got " + str(str_count_consonants("Hello World")))
    fail = fail + 1

if str_count_consonants("aei123") == 0
    pass = pass + 1
else
    print("FAIL str_count_consonants none")
    fail = fail + 1

// dict_min_key / dict_max_key
let nk = {"10": 1, "3": 2, "27": 3}
if dict_min_key(nk) == 3
    pass = pass + 1
else
    print("FAIL dict_min_key: expected 3 got " + str(dict_min_key(nk)))
    fail = fail + 1

if dict_max_key(nk) == 27
    pass = pass + 1
else
    print("FAIL dict_max_key: expected 27 got " + str(dict_max_key(nk)))
    fail = fail + 1

// str_swap_case
let sc = str_swap_case("Hello World 123")
if sc == "hELLO wORLD 123"
    pass = pass + 1
else
    print("FAIL str_swap_case: expected 'hELLO wORLD 123' got '" + sc + "'")
    fail = fail + 1

// list_partition_even_odd
let pe = list_partition_even_odd([1, 2, 3, 4, 5])
if str(pe["even"]) == "[2, 4]" and str(pe["odd"]) == "[1, 3, 5]"
    pass = pass + 1
else
    print("FAIL list_partition_even_odd: got " + str(pe))
    fail = fail + 1

let pe2 = list_partition_even_odd([])
if len(pe2["even"]) == 0 and len(pe2["odd"]) == 0
    pass = pass + 1
else
    print("FAIL list_partition_even_odd empty")
    fail = fail + 1

print("Batch 27+28 KAT: " + str(pass) + " passed, " + str(fail) + " failed")
