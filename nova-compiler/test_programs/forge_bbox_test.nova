import forge_bbox

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn expect_false(name: string, cond: bool) -> int
    if cond
        print("FAIL " + name + ": expected false")
        return 1
    0

fn boxstr(b) -> string
    if b == null
        return "nil"
    str(b[0]) + "," + str(b[1]) + "," + str(b[2]) + "," + str(b[3])

fn main()
    let fails = 0

    // from_points
    let box = bbox_from_points([[1.0, 2.0], [5.0, 1.0], [3.0, 8.0], [-2.0, 4.0]])
    fails = fails + expect("from_points", boxstr(box), "-2.0,1.0,5.0,8.0")
    fails = fails + expect_true("empty_null", bbox_from_points([]) == null)

    // extend
    bbox_extend(box, 10.0, -5.0)
    fails = fails + expect("extend", boxstr(box), "-2.0,-5.0,10.0,8.0")

    // contains
    fails = fails + expect_true("contains_in", bbox_contains(box, 0.0, 0.0))
    fails = fails + expect_true("contains_edge", bbox_contains(box, -2.0, 8.0))
    fails = fails + expect_false("contains_out", bbox_contains(box, 20.0, 0.0))

    // intersects / union / intersection
    let a = [0.0, 0.0, 4.0, 4.0]
    let b = [2.0, 2.0, 6.0, 6.0]
    let c = [10.0, 10.0, 12.0, 12.0]
    fails = fails + expect_true("intersects_yes", bbox_intersects(a, b))
    fails = fails + expect_false("intersects_no", bbox_intersects(a, c))
    fails = fails + expect_true("intersects_touch", bbox_intersects([0.0, 0.0, 2.0, 2.0], [2.0, 2.0, 4.0, 4.0]))
    fails = fails + expect("union", boxstr(bbox_union(a, b)), "0.0,0.0,6.0,6.0")
    fails = fails + expect("intersection", boxstr(bbox_intersection(a, b)), "2.0,2.0,4.0,4.0")
    fails = fails + expect_true("intersection_null", bbox_intersection(a, c) == null)

    // center / width / height / area
    fails = fails + expect("center", boxstr2(bbox_center(a)), "2.0,2.0")
    fails = fails + expect("width", str(bbox_width(a)), "4.0")
    fails = fails + expect("height", str(bbox_height(a)), "4.0")
    fails = fails + expect("area", str(bbox_area(a)), "16.0")

    // integer inputs coerce fine
    let ibox = bbox_from_points([[1, 1], [3, 5]])
    fails = fails + expect("int_inputs", boxstr(ibox), "1.0,1.0,3.0,5.0")

    if fails == 0
        print("forge_bbox: all passed")
    else
        print("forge_bbox: " + str(fails) + " FAILED")

fn boxstr2(p) -> string
    str(p[0]) + "," + str(p[1])
