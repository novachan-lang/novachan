// Test compiler-derived reflection: __fields, __type_name, __field_types

type Point
    x: int
    y: int

type Config
    host: string
    port: int
    debug: int

fn main()
    let p = Point(1, 2)

    // __fields: list of field name strings
    let fs = Point__fields(p)
    assert(len(fs) == 2, "Point fields count")
    assert(fs[0] == "x", "Point field 0")
    assert(fs[1] == "y", "Point field 1")

    // __type_name: struct name as string
    let tn = Point__type_name(p)
    assert(tn == "Point", "Point type_name")

    // __field_types: list of field type name strings
    let ft = Point__field_types(p)
    assert(len(ft) == 2, "Point field_types count")
    assert(ft[0] == "int", "Point field type 0")
    assert(ft[1] == "int", "Point field type 1")

    // Config struct
    let c = Config("localhost", 8080, 1)
    assert(Config__type_name(c) == "Config", "Config type_name")
    let cfs = Config__fields(c)
    assert(len(cfs) == 3, "Config fields count")
    assert(cfs[0] == "host", "Config field 0")
    assert(cfs[1] == "port", "Config field 1")
    assert(cfs[2] == "debug", "Config field 2")
    let cft = Config__field_types(c)
    assert(cft[0] == "string", "Config field type 0")
    assert(cft[1] == "int", "Config field type 1")

    // Composable: build field->type mapping
    let fields = Config__fields(c)
    let types = Config__field_types(c)
    let mapping = {}
    let i = 0
    while i < len(fields)
        mapping[fields[i]] = types[i]
        i = i + 1
    assert(mapping["host"] == "string", "mapping host")
    assert(mapping["port"] == "int", "mapping port")

    print("reflect_full: all passed")
