fn main()
    // THE BUG: a local whose name collides with a builtin, used inside a comprehension
    let items = ["a", "b", "c"]
    print("items    : " + str([items[i] for i in 0..3]))
    let args = [10, 20, 30]
    print("args     : " + str([args[i] for i in 0..3]))
    let chars = ["x", "y"]
    print("chars    : " + str([chars[i] for i in 0..2]))
    let buffer = [1, 2]
    print("buffer   : " + str([buffer[i] for i in 0..2]))
    let fields = ["p", "q"]
    print("fields   : " + str([fields[i] for i in 0..2]))
    // a non-colliding name must still work
    let things = ["m", "n"]
    print("things   : " + str([things[i] for i in 0..2]))
    // builtins CALLED inside a lambda must still resolve to the builtin
    let nums = [3, 1, 2]
    print("sort call: " + str(sort(nums)))
    print("map call : " + str([str(v) for v in nums]))
    print("nested   : " + str([[items[i], things[0]] for i in 0..2]))
    // a lambda (not a comprehension) capturing a builtin-named local
    let f = (z) => items[z]
    print("lambda   : " + str(f(1)))
    print("CAPFIX-DONE")
