// _modint_test.nova — KAT for std/numeric/modint
import std/numeric/modint

fn cki(label: string, got: int, expected: int)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

fn main()
    // KAT 1: mi_add(5, 7, 10) == 2
    let r1 = mi_add(5, 7, 10)
    cki("mi_add_5_7_10", r1, 2)

    // KAT 2: mi_sub(3, 5, 7) == 5   (3 - 5 = -2 ≡ 5 mod 7)
    let r2 = mi_sub(3, 5, 7)
    cki("mi_sub_3_5_7", r2, 5)

    // KAT 3: mi_mul(4, 5, 7) == 6   (20 mod 7 = 6)
    let r3 = mi_mul(4, 5, 7)
    cki("mi_mul_4_5_7", r3, 6)

    // KAT 4: mi_pow(2, 10, 1000) == 24   (1024 mod 1000 = 24)
    let r4 = mi_pow(2, 10, 1000)
    cki("mi_pow_2_10_1000", r4, 24)

    // KAT 5: mi_pow(3, 4, 5) == 1   (81 mod 5 = 1)
    let r5 = mi_pow(3, 4, 5)
    cki("mi_pow_3_4_5", r5, 1)

    // KAT 6: mi_inv(3, 11) == 4   (3*4 = 12 ≡ 1 mod 11)
    let r6 = mi_inv(3, 11)
    cki("mi_inv_3_11", r6, 4)

    // KAT 7: mi_inv(2, 4) == -1   (gcd(2,4)=2 ≠ 1, no inverse)
    let r7 = mi_inv(2, 4)
    cki("mi_inv_2_4_no_inv", r7, -1)

    // KAT 8: mi_div(6, 3, 7) == 2   (inv(3,7)=5; 6*5=30≡2 mod 7)
    let r8 = mi_div(6, 3, 7)
    cki("mi_div_6_3_7", r8, 2)

    // KAT 9: mi_norm(-1, 5) == 4   ((-1 % 5 + 5) % 5 = 4)
    let r9 = mi_norm(-1, 5)
    cki("mi_norm_neg1_5", r9, 4)

    // KAT 10: mi_add with negative inputs: mi_add(-3, 1, 5) == 3  (-3≡2 mod5; 2+1=3)
    let r10 = mi_add(-3, 1, 5)
    cki("mi_add_neg3_1_5", r10, 3)

    // KAT 11: mi_pow(0, 0, 7) == 1  (0^0 = 1 by convention)
    let r11 = mi_pow(0, 0, 7)
    cki("mi_pow_0_0_7", r11, 1)

    // KAT 12: mi_div with no inverse: mi_div(1, 2, 4) == -1  (gcd(2,4)=2)
    let r12 = mi_div(1, 2, 4)
    cki("mi_div_no_inv", r12, -1)

    print("_modint_test passed")
