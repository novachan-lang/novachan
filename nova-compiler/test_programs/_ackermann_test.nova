// KAT for std/math/ackermann — Ackermann-Peter function.
// Published values verified against the canonical definition and Wikipedia/OEIS.
import std/math/ackermann

// cki — check int equality; print FAIL and exit(1) on mismatch.
fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// ckb — check bool equality; print FAIL and exit(1) on mismatch.
fn ckb(label, got, want)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got " + gs + " want " + ws)
        exit(1)

fn main()
    // Base row m=0: ack(0,n)=n+1
    cki("ack(0,0)", ack(0, 0), 1)
    cki("ack(0,5)", ack(0, 5), 6)

    // m=1: ack(1,n)=n+2
    cki("ack(1,1)", ack(1, 1), 3)
    cki("ack(1,10)", ack(1, 10), 12)

    // m=2: ack(2,n)=2n+3
    cki("ack(2,2)", ack(2, 2), 7)
    cki("ack(2,3)", ack(2, 3), 9)

    // m=3: published values from Wikipedia/Rosetta Code
    cki("ack(3,0)", ack(3, 0), 5)
    cki("ack(3,3)", ack(3, 3), 61)
    cki("ack(3,4)", ack(3, 4), 125)

    // ack_is_defined_small: m<=3 -> true, m>3 -> false
    ckb("ack_is_defined_small(0)", ack_is_defined_small(0), true)
    ckb("ack_is_defined_small(3)", ack_is_defined_small(3), true)
    ckb("ack_is_defined_small(4)", ack_is_defined_small(4), false)

    print("_ackermann_test passed")
