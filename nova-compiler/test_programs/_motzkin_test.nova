import std/math/motzkin

// KAT: hand-verified Motzkin numbers M(0)..M(7), plus mz_list(5)

let v0 = mz_motzkin(0)
if v0 != 1
    print("FAIL mz_motzkin(0): expected 1 got " + str(v0))
    exit(1)

let v1 = mz_motzkin(1)
if v1 != 1
    print("FAIL mz_motzkin(1): expected 1 got " + str(v1))
    exit(1)

let v2 = mz_motzkin(2)
if v2 != 2
    print("FAIL mz_motzkin(2): expected 2 got " + str(v2))
    exit(1)

let v3 = mz_motzkin(3)
if v3 != 4
    print("FAIL mz_motzkin(3): expected 4 got " + str(v3))
    exit(1)

let v4 = mz_motzkin(4)
if v4 != 9
    print("FAIL mz_motzkin(4): expected 9 got " + str(v4))
    exit(1)

let v5 = mz_motzkin(5)
if v5 != 21
    print("FAIL mz_motzkin(5): expected 21 got " + str(v5))
    exit(1)

let v6 = mz_motzkin(6)
if v6 != 51
    print("FAIL mz_motzkin(6): expected 51 got " + str(v6))
    exit(1)

let v7 = mz_motzkin(7)
if v7 != 127
    print("FAIL mz_motzkin(7): expected 127 got " + str(v7))
    exit(1)

// KAT: mz_list(5) == [1,1,2,4,9,21]  (indices 0..5, length 6)
let lst = mz_list(5)
let actual_len = len(lst)
if actual_len != 6
    print("FAIL mz_list(5) length: expected 6 got " + str(actual_len))
    exit(1)

let e0 = lst[0]
if e0 != 1
    print("FAIL mz_list(5)[0]: expected 1 got " + str(e0))
    exit(1)

let e1 = lst[1]
if e1 != 1
    print("FAIL mz_list(5)[1]: expected 1 got " + str(e1))
    exit(1)

let e2 = lst[2]
if e2 != 2
    print("FAIL mz_list(5)[2]: expected 2 got " + str(e2))
    exit(1)

let e3 = lst[3]
if e3 != 4
    print("FAIL mz_list(5)[3]: expected 4 got " + str(e3))
    exit(1)

let e4 = lst[4]
if e4 != 9
    print("FAIL mz_list(5)[4]: expected 9 got " + str(e4))
    exit(1)

let e5 = lst[5]
if e5 != 21
    print("FAIL mz_list(5)[5]: expected 21 got " + str(e5))
    exit(1)

print("_motzkin_test passed")
