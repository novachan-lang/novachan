import forge_reach

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn expect_false(name: string, cond: bool) -> int
    if cond
        print("FAIL " + name + ": expected false")
        return 1
    0

fn has(lst, x) -> bool
    let f = false
    let i = 0
    while i < len(lst)
        if lst[i] == x
            f = true
        i = i + 1
    f

fn main()
    let fails = 0

    // directed chain a->b->c->d
    let chain = [["a", "b"], ["b", "c"], ["c", "d"]]
    fails = fails + expect("chain_count", str(reachable_count(chain, "a")), "3")
    let rf = reachable_from(chain, "a")
    fails = fails + expect_true("chain_reaches_d", has(rf, "d"))
    fails = fails + expect_true("can_reach_ad", can_reach(chain, "a", "d"))
    // directed: d cannot reach a (arrows one way)
    fails = fails + expect_false("cannot_reach_da", can_reach(chain, "d", "a"))
    fails = fails + expect("d_reaches_none", str(reachable_count(chain, "d")), "0")

    // self-reach
    fails = fails + expect_true("self_reach", can_reach(chain, "b", "b"))

    // branching: a->b, a->c, b->d, c->d -> a reaches b,c,d (3)
    let branch = [["a", "b"], ["a", "c"], ["b", "d"], ["c", "d"]]
    fails = fails + expect("branch_count", str(reachable_count(branch, "a")), "3")
    fails = fails + expect_true("branch_ad", can_reach(branch, "a", "d"))
    // b reaches only d
    fails = fails + expect("b_reaches", str(reachable_count(branch, "b")), "1")

    // cycle a->b->c->a: from a reach b,c (2)
    let cyc = [["a", "b"], ["b", "c"], ["c", "a"]]
    fails = fails + expect("cycle_count", str(reachable_count(cyc, "a")), "2")
    fails = fails + expect_true("cycle_all_mutual", can_reach(cyc, "c", "b"))

    // disconnected: a->b, c->d ; a cannot reach c
    let disc = [["a", "b"], ["c", "d"]]
    fails = fails + expect_false("disc_no_reach", can_reach(disc, "a", "c"))
    fails = fails + expect_true("disc_reach_own", can_reach(disc, "a", "b"))

    // unknown node -> only itself
    fails = fails + expect("unknown", str(reachable_count(chain, "zzz")), "0")

    if fails == 0
        print("forge_reach: all passed")
    else
        print("forge_reach: " + str(fails) + " FAILED")
