import forge_ab_router
fn main()
    let a = ab_new(50)
    print(str(ab_total_traffic(a)) + " " + str(ab_a_rate(a)) + " " + str(ab_b_rate(a)) + " " + ab_winner(a))
    for p in [0, 25, 49, 50, 75, 99]
        let r = ab_route(a, p)
        print("pct=" + str(p) + " -> " + r["variant"])
    print("counts a=" + str(ab_a_count(a)) + " b=" + str(ab_b_count(a)) + " total=" + str(ab_total_traffic(a)))
    a = ab_convert(a, "A")
    a = ab_convert(a, "A")
    a = ab_convert(a, "B")
    print("rates a=" + str(ab_a_rate(a)) + " b=" + str(ab_b_rate(a)) + " winner=" + ab_winner(a))
    // the permissive hole, preserved: an unknown name credits B
    a = ab_convert(a, "typo")
    print("after typo: b_rate=" + str(ab_b_rate(a)))
    let z = ab_new(0)
    print("all-B split: " + ab_route(z, 0)["variant"] + " winner=" + ab_winner(z))
    let f = ab_new(100)
    print("all-A split: " + ab_route(f, 99)["variant"])
    print("EXERCISE-DONE")
