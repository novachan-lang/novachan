import std/game/blackjack

// Helper: build a card [rank, suit]
fn mkcard(rank: int, suit: int) -> any
    let c = []
    push(c, rank)
    push(c, suit)
    c

fn chk_int(name: string, got: int, want: int)
    if got != want
        print("FAIL blackjack " + name + ": got " + str(got) + " want " + str(want))
        exit(1)

fn chk_bool(name: string, got: bool, want: bool)
    let gs = "false"
    if got
        gs = "true"
    let ws = "false"
    if want
        ws = "true"
    if got != want
        print("FAIL blackjack " + name + ": got " + gs + " want " + ws)
        exit(1)

fn test_ak()
    // A + K = 11 + 10 = 21
    let hand = []
    push(hand, mkcard(14, 0))
    push(hand, mkcard(13, 0))
    chk_int("AK value", bj_value(hand), 21)
    chk_bool("AK blackjack", bj_is_blackjack(hand), true)

fn test_aa9()
    // A + A + 9 = 11+11+9=31 -> reduce one ace -> 21
    let hand = []
    push(hand, mkcard(14, 0))
    push(hand, mkcard(14, 1))
    push(hand, mkcard(9, 0))
    chk_int("AA9 value", bj_value(hand), 21)
    chk_bool("AA9 not blackjack", bj_is_blackjack(hand), false)

fn test_kq5()
    // K + Q + 5 = 10+10+5 = 25 (bust)
    let hand = []
    push(hand, mkcard(13, 0))
    push(hand, mkcard(12, 0))
    push(hand, mkcard(5, 0))
    chk_int("KQ5 value", bj_value(hand), 25)
    chk_bool("KQ5 bust", bj_is_bust(hand), true)

fn test_89()
    // 8 + 9 = 17
    let hand = []
    push(hand, mkcard(8, 0))
    push(hand, mkcard(9, 0))
    chk_int("89 value", bj_value(hand), 17)
    chk_bool("89 not soft", bj_is_soft(hand), false)

fn test_a6()
    // A + 6 = 11+6 = 17, soft
    let hand = []
    push(hand, mkcard(14, 0))
    push(hand, mkcard(6, 0))
    chk_int("A6 value", bj_value(hand), 17)
    chk_bool("A6 soft", bj_is_soft(hand), true)

fn test_a6k()
    // A + 6 + K = 11+6+10=27 -> reduce ace -> 17; not soft
    let hand = []
    push(hand, mkcard(14, 0))
    push(hand, mkcard(6, 0))
    push(hand, mkcard(13, 0))
    chk_int("A6K value", bj_value(hand), 17)
    chk_bool("A6K not soft", bj_is_soft(hand), false)

fn main()
    test_ak()
    test_aa9()
    test_kq5()
    test_89()
    test_a6()
    test_a6k()
    print("PASS _blackjack_test")
