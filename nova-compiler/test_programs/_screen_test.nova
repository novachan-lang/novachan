import std/term/screen

// Check helpers

fn cks(label: str, got: str, want: str)
    if got != want
        print("FAIL _screen_test " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL _screen_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    let esc = chr(27)

    // KAT: clear_screen() == ESC[2J
    let want_cs = esc + "[2J"
    let got_cs = clear_screen()
    cks("clear_screen", got_cs, want_cs)
    cki("clear_screen_len", len(got_cs), 4)

    // KAT: clear_screen_home() == ESC[2J + ESC[H
    let want_csh = esc + "[2J" + esc + "[H"
    let got_csh = clear_screen_home()
    cks("clear_screen_home", got_csh, want_csh)
    cki("clear_screen_home_len", len(got_csh), 7)

    // KAT: clear_line() == ESC[2K
    let want_cl = esc + "[2K"
    let got_cl = clear_line()
    cks("clear_line", got_cl, want_cl)
    cki("clear_line_len", len(got_cl), 4)

    // KAT: clear_to_eol() == ESC[0K
    let want_eol = esc + "[0K"
    let got_eol = clear_to_eol()
    cks("clear_to_eol", got_eol, want_eol)
    cki("clear_to_eol_len", len(got_eol), 4)

    // KAT: clear_to_eos() == ESC[0J
    let want_eos = esc + "[0J"
    let got_eos = clear_to_eos()
    cks("clear_to_eos", got_eos, want_eos)
    cki("clear_to_eos_len", len(got_eos), 4)

    // KAT: scroll_up(2) == ESC[2S
    let want_su2 = esc + "[2S"
    let got_su2 = scroll_up(2)
    cks("scroll_up_2", got_su2, want_su2)
    cki("scroll_up_2_len", len(got_su2), 4)

    // scroll_up(1) == ESC[1S
    let want_su1 = esc + "[1S"
    let got_su1 = scroll_up(1)
    cks("scroll_up_1", got_su1, want_su1)

    // scroll_up(0) clamped to 1 -> ESC[1S
    let got_su0 = scroll_up(0)
    cks("scroll_up_0_clamped", got_su0, want_su1)

    // scroll_up(10) -> ESC[10S (two-digit number)
    let want_su10 = esc + "[10S"
    let got_su10 = scroll_up(10)
    cks("scroll_up_10", got_su10, want_su10)
    cki("scroll_up_10_len", len(got_su10), 5)

    // KAT: scroll_down(3) == ESC[3T
    let want_sd3 = esc + "[3T"
    let got_sd3 = scroll_down(3)
    cks("scroll_down_3", got_sd3, want_sd3)

    // scroll_down(0) clamped to 1 -> ESC[1T
    let want_sd1 = esc + "[1T"
    let got_sd0 = scroll_down(0)
    cks("scroll_down_0_clamped", got_sd0, want_sd1)

    // scroll_down negative clamped to 1
    let got_sdneg = scroll_down(-5)
    cks("scroll_down_neg_clamped", got_sdneg, want_sd1)

    // KAT: alt_screen_on() == ESC[?1049h
    let want_ason = esc + "[?1049h"
    let got_ason = alt_screen_on()
    cks("alt_screen_on", got_ason, want_ason)
    cki("alt_screen_on_len", len(got_ason), 8)

    // alt_screen_off() == ESC[?1049l
    let want_asoff = esc + "[?1049l"
    let got_asoff = alt_screen_off()
    cks("alt_screen_off", got_asoff, want_asoff)
    cki("alt_screen_off_len", len(got_asoff), 8)

    print("PASS _screen_test")
