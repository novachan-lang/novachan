// Keep-alive throughput client (deep I/O scaling test). UNLIKE forge_load_client (connect-per-request,
// round-trip-bound), each task connects ONCE and pipelines M sequential requests on the SAME socket
// (HTTP/1.1 keep-alive, no "Connection: close"), so connection setup is amortized and the SERVER'S
// DISPATCH becomes the bottleneck -> N>1 scaling (or its ceiling) is measurable. A response is framed by
// reading until the accumulated buffer contains THIS request's delimited nonce token (which the server
// echoes at the body's end) -> robust without Content-Length parsing. M must stay under the server's
// keep-alive cap (_max_keepalive = 100); we use 80. Run client at NOVA_CARRIERS=8 vs the server's N.
fn env_or(name: string, def: string) -> string
    let v = env(name)
    if len(v) == 0
        def
    else
        v

fn ntok(n: int) -> string
    let s = str(n)
    while len(s) < 8
        s = "0" + s
    "N=" + s + ";"

fn ka_task(host: string, port: int, m: int, base_nonce: int, result_ch)
    let sock = tcp_connect(host, port)
    if sock < 0
        send(result_ch, [0, m])
        return
    let ok = 0
    let bad = 0
    let r = 0
    while r < m
        let nonce = base_nonce + r
        let req = "GET /ping/" + str(nonce) + " HTTP/1.1\r\nHost: x\r\n\r\n"
        tcp_send(sock, req)
        let tok = ntok(nonce)
        let resp = ""
        let state = 0          // 0 = reading, 1 = got full response, 2 = closed/error
        let guard = 0
        while state == 0 and guard < 200
            let chunk = tcp_recv(sock)
            if len(chunk) == 0
                state = 2
            else
                resp = resp + chunk
                if contains(resp, tok)
                    state = 1
            guard = guard + 1
        if state == 1
            ok = ok + 1
        else
            bad = bad + 1
        r = r + 1
    tcp_close(sock)
    send(result_ch, [ok, bad])

fn run_phase(host: string, port: int, kk: int, m: int, base_off: int) -> list
    let result_ch = channel()
    let i = 0
    while i < kk
        let base = base_off + i * m
        spawn fn()
            ka_task(host, port, m, base, result_ch)
        i = i + 1
    let ok = 0
    let bad = 0
    let g = 0
    while g < kk
        let res = receive(result_ch)
        ok = ok + res[0]
        bad = bad + res[1]
        g = g + 1
    [ok, bad]

fn main()
    let host = env_or("HOST", "127.0.0.1")
    let port = parse_int(env_or("PORT", "8080"))
    let kk = parse_int(env_or("K", "256"))
    let mm = parse_int(env_or("M", "80"))
    sleep(300)   // let the server bind + listen
    run_phase(host, port, kk, 20, 9000000)   // warmup (disjoint nonce range)
    let total = kk * mm
    let t0 = clock_ns()
    let res = run_phase(host, port, kk, mm, 0)
    let elapsed_ms = (clock_ns() - t0) / 1000000
    let ok = res[0]
    let bad = res[1]
    let rps = 0
    if elapsed_ms > 0
        rps = (ok * 1000) / elapsed_ms
    print("KA K=" + str(kk) + " M=" + str(mm) + " total=" + str(total) + " ok=" + str(ok) + " bad=" + str(bad) + " elapsed_ms=" + str(elapsed_ms) + " rps=" + str(rps))
