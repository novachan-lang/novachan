// _xpm_test.nova — KAT for std/media/xpm
//
// XPM (X PixMap) known-answer tests.
//
// KAT vectors:
//   Input: 2×2 image, 4 pixels, 2 unique colors:
//     px_rgb = [0,0,0, 255,255,255, 255,255,255, 0,0,0]
//     (top-left=black, top-right=white, bottom-left=white, bottom-right=black)
//
//   Expected XPM output:
//     - Contains "/* XPM */"
//     - Contains geometry token "2 2 2 1"
//     - Palette: 2 colors, chars ' ' and '.'
//       ' ' -> #000000 (black)
//       '.' -> #FFFFFF (white)
//     - Row 0: " ." (space dot)
//     - Row 1: ". " (dot space)
//
//   Round-trip: xpm_decode(xpm_encode(2,2,px)) -> w=2, h=2, px equal input
//
// Test plan:
//   KAT 1: output contains "/* XPM */"
//   KAT 2: output contains "2 2 2 1" (geometry line)
//   KAT 3: output contains " c #000000" (black color def)
//   KAT 4: output contains " c #FFFFFF" (white color def)
//   KAT 5: full round-trip — decoded w=2, h=2, px matches input exactly
//   KAT 6: malformed input -> w=0 h=0 px=[]
//   KAT 7: single-pixel 1×1 encode/decode round-trip
//   KAT 8: 1×1 white pixel round-trip

import std/media/xpm

fn cki(label, got, want)
    if got != want
        print("FAIL xpm " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL xpm " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn str_contains(s, sub) -> int
    let sn = len(s)
    let subn = len(sub)
    let found = 0
    let i = 0
    while i <= sn - subn and found == 0
        if slice(s, i, i + subn) == sub
            found = 1
        i = i + 1
    found

fn main()
    let px4 = [0, 0, 0, 255, 255, 255, 255, 255, 255, 0, 0, 0]
    let enc = xpm_encode(2, 2, px4)

    // ── KAT 1: magic header ───────────────────────────────────────────────────
    cki("magic-present", str_contains(enc, "/* XPM */"), 1)
    print("KAT 1 PASS: /* XPM */ present in output")

    // ── KAT 2: geometry line ──────────────────────────────────────────────────
    cki("geom-line", str_contains(enc, "2 2 2 1"), 1)
    print("KAT 2 PASS: geometry token '2 2 2 1' present")

    // ── KAT 3: black color definition ────────────────────────────────────────
    cki("black-color", str_contains(enc, "#000000"), 1)
    print("KAT 3 PASS: color #000000 (black) present")

    // ── KAT 4: white color definition ────────────────────────────────────────
    cki("white-color", str_contains(enc, "#FFFFFF"), 1)
    print("KAT 4 PASS: color #FFFFFF (white) present")

    // ── KAT 5: full round-trip ────────────────────────────────────────────────
    let dec = xpm_decode(enc)
    cki("rt-w", dec["w"], 2)
    cki("rt-h", dec["h"], 2)
    let pxr = dec["px"]
    cki("rt-px-len", len(pxr), 12)
    cki("rt-px-0", pxr[0], 0)
    cki("rt-px-1", pxr[1], 0)
    cki("rt-px-2", pxr[2], 0)
    cki("rt-px-3", pxr[3], 255)
    cki("rt-px-4", pxr[4], 255)
    cki("rt-px-5", pxr[5], 255)
    cki("rt-px-6", pxr[6], 255)
    cki("rt-px-7", pxr[7], 255)
    cki("rt-px-8", pxr[8], 255)
    cki("rt-px-9", pxr[9], 0)
    cki("rt-px-10", pxr[10], 0)
    cki("rt-px-11", pxr[11], 0)
    print("KAT 5 PASS: full round-trip 2x2 pixel-exact")

    // ── KAT 6: malformed input returns empty ─────────────────────────────────
    let bad = xpm_decode("not an xpm file at all")
    cki("bad-w", bad["w"], 0)
    cki("bad-h", bad["h"], 0)
    cki("bad-px-len", len(bad["px"]), 0)
    print("KAT 6 PASS: malformed input returns w=0 h=0 px=[]")

    // ── KAT 7: 1x1 black pixel round-trip ────────────────────────────────────
    let px1 = [0, 0, 0]
    let enc1 = xpm_encode(1, 1, px1)
    cki("1x1b-magic", str_contains(enc1, "/* XPM */"), 1)
    cki("1x1b-geom", str_contains(enc1, "1 1 1 1"), 1)
    let dec1 = xpm_decode(enc1)
    cki("1x1b-w", dec1["w"], 1)
    cki("1x1b-h", dec1["h"], 1)
    let pxr1 = dec1["px"]
    cki("1x1b-px-len", len(pxr1), 3)
    cki("1x1b-px-0", pxr1[0], 0)
    cki("1x1b-px-1", pxr1[1], 0)
    cki("1x1b-px-2", pxr1[2], 0)
    print("KAT 7 PASS: 1x1 black pixel round-trip")

    // ── KAT 8: 1x1 white pixel round-trip ────────────────────────────────────
    let px1w = [255, 255, 255]
    let enc1w = xpm_encode(1, 1, px1w)
    let dec1w = xpm_decode(enc1w)
    cki("1x1w-w", dec1w["w"], 1)
    cki("1x1w-h", dec1w["h"], 1)
    let pxr1w = dec1w["px"]
    cki("1x1w-px-len", len(pxr1w), 3)
    cki("1x1w-px-0", pxr1w[0], 255)
    cki("1x1w-px-1", pxr1w[1], 255)
    cki("1x1w-px-2", pxr1w[2], 255)
    print("KAT 8 PASS: 1x1 white pixel round-trip")

    print("PASS _xpm_test")
