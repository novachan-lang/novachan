fn main()
    let s1 = """hello world"""
    assert(s1 == "hello world", "single-line triple-quote")

    let s2 = """
    line one
    line two
    line three
    """
    assert(contains(s2, "line one"), "multi-line contains 1")
    assert(contains(s2, "line two"), "multi-line contains 2")
    assert(contains(s2, "line three"), "multi-line contains 3")

    let s3 = """no indent"""
    assert(s3 == "no indent", "no-indent triple-quote")

    let html = """
    <html>
      <body>
        <h1>Hello</h1>
      </body>
    </html>
    """
    assert(contains(html, "<h1>Hello</h1>"), "html content")
    assert(contains(html, "<html>"), "html open")

    // Verify embedded quotes work
    let json = """{"key": "value", "num": 42}"""
    assert(contains(json, "key"), "json key")
    assert(contains(json, "42"), "json num")

    print("triple_quote_test: all passed")
