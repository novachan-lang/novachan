import stdlib

fn is_pos(n: int) -> bool
    n > 0

fn print_it(n: int)
    print(str(n))

fn main()
    // clamp
    assert(clamp(5, 0, 10) == 5, "clamp inside")
    assert(clamp(-3, 0, 10) == 0, "clamp low")
    assert(clamp(99, 0, 10) == 10, "clamp high")
    print("PASS clamp")

    // count_where
    let nums = [-2, -1, 0, 1, 2, 3]
    assert(count_where(nums, is_pos) == 3, "count_where")
    print("PASS count_where")

    // unique
    let dups = [1, 2, 2, 3, 1, 4]
    let u = unique(dups)
    assert(len(u) == 4, "unique len")
    print("PASS unique")

    // take / drop
    let xs = [1, 2, 3, 4, 5]
    let t3 = take(xs, 3)
    assert(len(t3) == 3 and t3[0] == 1 and t3[2] == 3, "take")
    let d2 = drop(xs, 2)
    assert(len(d2) == 3 and d2[0] == 3, "drop")
    print("PASS take/drop")

    // flatten
    let nested = [[1, 2], [3], [4, 5, 6]]
    let flat = flatten(nested)
    assert(len(flat) == 6, "flatten len")
    assert(flat[0] == 1 and flat[5] == 6, "flatten values")
    print("PASS flatten")

    // partition
    let parts = partition(nums, is_pos)
    let pos = parts[0]
    let neg = parts[1]
    assert(len(pos) == 3, "partition pos")
    assert(len(neg) == 3, "partition neg")
    print("PASS partition")

    // str_pad_left / str_pad_right
    assert(str_pad_left("42", 5, "0") == "00042", "str_pad_left")
    assert(str_pad_right("hi", 5, ".") == "hi...", "str_pad_right")
    print("PASS pad")

    // char classification
    assert(is_digit_char("5"), "is_digit_char")
    assert(not is_digit_char("a"), "is_digit_char neg")
    assert(is_alpha_char("Z"), "is_alpha_char")
    assert(is_space_char(" "), "is_space_char")
    print("PASS char classification")

    // repeat_value
    let zeros = repeat_value(0, 5)
    assert(len(zeros) == 5 and zeros[0] == 0, "repeat_value")
    print("PASS repeat_value")

    // div_ceil
    assert(div_ceil(10, 3) == 4, "div_ceil")
    assert(div_ceil(9, 3) == 3, "div_ceil exact")
    print("PASS div_ceil")

    // gcd / lcm
    assert(gcd(12, 18) == 6, "gcd")
    assert(lcm(4, 6) == 12, "lcm")
    print("PASS gcd/lcm")

    // first / last
    assert(first(xs) == 1, "first")
    assert(last(xs) == 5, "last")
    print("PASS first/last")

    // range_step
    let r = range_step(0, 10, 2)
    assert(len(r) == 5 and r[0] == 0 and r[4] == 8, "range_step")
    print("PASS range_step")

    // every / some_match
    let all_pos = [1, 2, 3]
    assert(every(all_pos, is_pos), "every")
    assert(some_match([-1, -2, 3], is_pos), "some_match")
    assert(not every([-1, -2, 3], is_pos), "every neg")
    print("PASS every/some_match")

    // sum_ints / average
    assert(sum_ints([1, 2, 3, 4]) == 10, "sum_ints")
    assert(average([2, 4, 6]) == 4, "average")
    print("PASS sum/average")

    // for_each
    for_each([10, 20, 30], print_it)
    print("PASS for_each")

    print("=== All stdlib tests passed ===")
