// WASM value-model proof (S4 string/list/dict + S5 struct + control-flow + list-index). Each fn RETURNS an
// int the node harness reads (i64->BigInt). Linked against the FULL value-model runtime (nova_runtime_wasm.c).
type Point
    x: int
    y: int
fn strbuild() -> int
    let s = "a" + "b" + "c"
    len(s)
fn listlen() -> int
    let xs = [10, 20, 30, 40]
    len(xs)
fn dictlen() -> int
    let d = {"x": 1, "y": 2, "z": 3}
    len(d)
fn structfield() -> int
    let p = Point(7, 35)
    p.x + p.y
fn loopsum() -> int
    let total = 0
    let i = 1
    while i <= 5
        total = total + i * i
        i = i + 1
    total
fn listindex() -> int
    let xs = [1, 2, 3, 4, 5]
    let s = 0
    let i = 0
    while i < len(xs)
        s = s + xs[i]
        i = i + 1
    s
fn main()
    print(strbuild() + listlen() + dictlen() + structfield() + loopsum() + listindex())
