// S4 wasm value-model MILESTONE: build HEAP values (string concat, list, dict) in NOVA and measure them,
// linked against the FULL value-model runtime (nova_runtime_wasm.c). Proves strings AND lists AND dicts run
// in wasm -- beyond the minimal-string-runtime subset. The node harness calls these exported fns for the i64 len.
fn strbuild() -> int
    let s = "a" + "b" + "c"
    len(s)
fn listlen() -> int
    let xs = [10, 20, 30, 40]
    len(xs)
fn dictlen() -> int
    let d = {"x": 1, "y": 2, "z": 3}
    len(d)
fn main()
    print(strbuild() + listlen() + dictlen())
