// Phase 10: Documentation generator test

/// A documented function.
/// Returns the sum of two integers.
fn add_docs(a: int, b: int) -> int
    a + b

/// Another function for testing.
fn greet_docs(name: string) -> string
    "Hello, " + name + "!"

fn test_doc_extract()
    // Extract docs from this file itself
    let entries = doc_extract("phase10_doc_test.nova")
    let count = doc_entry_count(entries)
    assert_eq(count >= 2, true)
    print("doc_extract: found " + str(count) + " documented items")

fn test_doc_to_markdown()
    let entries = doc_extract("phase10_doc_test.nova")
    let md = doc_to_markdown(entries, "Phase 10 Test API")
    assert_eq(len(md) > 50, true)
    assert_eq(contains(md, "# Phase 10 Test API"), true)
    assert_eq(contains(md, "add_docs"), true)
    print("doc_to_markdown test passed")

fn test_doc_to_html()
    let entries = doc_extract("phase10_doc_test.nova")
    let html = doc_to_html(entries, "Phase 10 Test")
    assert_eq(len(html) > 100, true)
    assert_eq(contains(html, "<!DOCTYPE html>"), true)
    assert_eq(contains(html, "Phase 10 Test"), true)
    print("doc_to_html test passed")

fn main()
    test_doc_extract()
    test_doc_to_markdown()
    test_doc_to_html()
    print("All Phase 10 documentation tests passed!")
