// L8 iter loud-fail: `for x in a` on an unannotated struct param can't be statically dispatched -> must
// PANIC (previously it silently ran ZERO iterations over a real collection). Expect: prints "before",
// then aborts (non-zero exit, stderr mentions the for-in struct error), NEVER prints "after".
type Bag
    items: list

fn Bag.iter(self) -> list
    self.items

fn iter_unannotated(a) -> int      // param type inferred only from `for` usage -> unresolved -> loud fail
    let s = 0
    for x in a
        s = s + x
    s

fn main()
    let b = Bag([1, 2, 3])
    print("before")
    let s = iter_unannotated(b)
    print("after s=" + str(s))     // must NOT be reached
