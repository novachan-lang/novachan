// Triple-backtick raw text blocks with automatic dedent. Multi-line, raw (no escape
// or interpolation processing) — ideal for embedded SQL / HTML / JSON / regex.

fn main()
    let nl = chr(10)
    let bs = chr(92)

    // dedent: the common 8-space indent is stripped; leading/trailing fence lines drop.
    let sql = ```
        SELECT id, name
        FROM users
        WHERE active = 1
        ```
    assert_eq(sql, "SELECT id, name" + nl + "FROM users" + nl + "WHERE active = 1")

    // raw: backslashes are literal (no escape processing). Expected: \d+\.\d+
    let rx = ```
        \d+\.\d+
        ```
    assert_eq(rx, bs + "d+" + bs + "." + bs + "d+")

    // relative indentation is preserved (nested line keeps its extra 2 spaces)
    let html = ```
        <ul>
          <li>one</li>
        </ul>
        ```
    assert_eq(html, "<ul>" + nl + "  <li>one</li>" + nl + "</ul>")

    // single-backtick raw strings still work unchanged (raw: no\nescape literally)
    let one = `no\nescape`
    assert_eq(one, "no" + bs + "nescape")

    print("textblock passed")
