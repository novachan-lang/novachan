// Test: NOVA distributed computing — remote spawn protocol
// Tests the SPAWN message protocol: client sends function name + args,
// server receives and dispatches.

fn worker_node(port)
    let node = node_listen(port)
    let client = node_accept(node)

    // Receive spawn request. THE WIRE FORMAT IS A LIST, NOT A DICT: nova_rt_remote_spawn builds
    // `[name, args]` with list_append and sends that. This test used to read req["fn"] and
    // req["args"], which index a LIST with STRING keys -- both came back 0, so it printed
    // "fn=0, args=0", computed 0, and failed "remote add should be 42". The test's own comment
    // even said "remote_spawn sends [name, args]" while the code below it assumed a dict.
    // That is why it was excluded from the gate as "assumes a protocol node_recv does not
    // provide" -- the protocol was fine, the test was reading it wrong.
    let req = node_recv(client, 0)
    let fn_name = req[0]
    let args = req[1]
    print("node received spawn: fn={fn_name}, args={args}")

    // Execute the requested function locally
    let result = 0
    if fn_name == "add"
        result = args[0] + args[1]
    if fn_name == "multiply"
        result = args[0] * args[1]

    // Send result back
    remote_send(client, result)
    remote_close(client)
    node_close(node)      // node_stop was never implemented

fn main()
    let port = 19877

    // Start worker node
    spawn worker_node(port)
    sleep(100)

    // Connect and send spawn request
    let conn = node_connect("127.0.0.1", port)

    // Spawn "add" with args [15, 27]
    remote_spawn(conn, "add", [15, 27])

    // Get result
    let result = remote_recv(conn)
    print("remote add(15, 27) = {result}")
    assert(result == 42, "remote add should be 42")

    remote_close(conn)
    sleep(500)
    print("distributed spawn test passed")

// NO trailing `main()` call. The compiler AUTO-INVOKES `fn main()`, so an explicit call here runs
// the whole program TWICE -- which for this test means binding port 19877 a second time while the
// first listener may still hold it. A second, independent defect from the dict/list one above.
