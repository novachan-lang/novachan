// OS completeness test: set_env, env round-trip, getpid, chdir, which.

fn main()
    // set_env / env round-trip (set_env makes getenv-backed env() see it)
    assert_eq(set_env("NOVA_OS_TEST_VAR", "hello42"), 1)
    assert_eq(env("NOVA_OS_TEST_VAR"), "hello42")
    assert_eq(set_env("NOVA_OS_TEST_VAR", "changed"), 1)
    assert_eq(env("NOVA_OS_TEST_VAR"), "changed")

    // getpid is a positive process id
    assert_eq(getpid() > 0, true)

    // which: a definitely-nonexistent command resolves to "" (deterministic)
    assert_eq(which("__nova_no_such_cmd_xyz__"), "")

    // chdir round-trip (restore the original directory afterwards)
    let orig = cwd()
    mkdir_p("_os_test_d")
    assert_eq(chdir("_os_test_d"), 1)
    let here = cwd()
    assert_eq(ends_with(here, "_os_test_d"), true)
    assert_eq(chdir(orig), 1)
    remove_dir("_os_test_d")

    print("os_test passed")
