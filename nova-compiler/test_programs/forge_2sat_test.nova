import forge_2sat

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

// check an assignment satisfies every clause
fn satisfies(assign: list, clauses: list) -> int
    let ok = 1
    let i = 0
    while i < len(clauses)
        let a = clauses[i][0]
        let b = clauses[i][1]
        let clause_ok = 0
        // literal a
        let va = a
        if va < 0
            va = 0 - va
        if a > 0 and assign[va - 1] == 1
            clause_ok = 1
        if a < 0 and assign[va - 1] == 0
            clause_ok = 1
        let vb = b
        if vb < 0
            vb = 0 - vb
        if b > 0 and assign[vb - 1] == 1
            clause_ok = 1
        if b < 0 and assign[vb - 1] == 0
            clause_ok = 1
        if clause_ok == 0
            ok = 0
        i = i + 1
    ok

fn main()
    let fails = 0

    // satisfiable: (x1 v x2) ^ (~x1 v x2) ^ (~x2 v x3)
    let c1 = []
    push(c1, [1, 2])
    push(c1, [0 - 1, 2])
    push(c1, [0 - 2, 3])
    let r1 = two_sat(3, c1)
    fails = fails + expect("sat1", str(r1[0]), "1")
    fails = fails + expect("sat1_valid", str(satisfies(r1[1], c1)), "1")

    // unsatisfiable: (x1 v x1) ^ (~x1 v ~x1)  ==  x1 ^ ~x1
    let c2 = []
    push(c2, [1, 1])
    push(c2, [0 - 1, 0 - 1])
    let r2 = two_sat(1, c2)
    fails = fails + expect("unsat1", str(r2[0]), "0")

    // unsatisfiable classic: (x1 v x2)^(~x1 v x2)^(x1 v ~x2)^(~x1 v ~x2)
    let c3 = []
    push(c3, [1, 2])
    push(c3, [0 - 1, 2])
    push(c3, [1, 0 - 2])
    push(c3, [0 - 1, 0 - 2])
    let r3 = two_sat(2, c3)
    fails = fails + expect("unsat2", str(r3[0]), "0")

    // satisfiable bigger: 4 vars
    let c4 = []
    push(c4, [1, 0 - 2])
    push(c4, [2, 3])
    push(c4, [0 - 3, 4])
    push(c4, [0 - 1, 0 - 4])
    push(c4, [2, 4])
    let r4 = two_sat(4, c4)
    fails = fails + expect("sat4", str(r4[0]), "1")
    fails = fails + expect("sat4_valid", str(satisfies(r4[1], c4)), "1")

    // trivially satisfiable: single clause
    let c5 = []
    push(c5, [1, 2])
    let r5 = two_sat(2, c5)
    fails = fails + expect("sat5", str(r5[0]), "1")
    fails = fails + expect("sat5_valid", str(satisfies(r5[1], c5)), "1")

    // forcing: (x1)^(x2)^(~x1 v x2)   x1 must be true, x2 must be true
    let c6 = []
    push(c6, [1, 1])
    push(c6, [2, 2])
    push(c6, [0 - 1, 2])
    let r6 = two_sat(2, c6)
    fails = fails + expect("sat6", str(r6[0]), "1")
    fails = fails + expect("sat6_x1", str(r6[1][0]), "1")
    fails = fails + expect("sat6_x2", str(r6[1][1]), "1")

    if fails == 0
        print("forge_2sat: all passed")
    else
        print("forge_2sat: " + str(fails) + " FAILED")
