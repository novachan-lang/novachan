fn _bst_node(val, left, right)
  {"val": val, "left": left, "right": right, "empty": 0}

fn _bst_empty()
  {"empty": 1}

fn _bst_is_empty(n)
  n["empty"] == 1

fn bst_new()
  _bst_empty()

fn bst_insert(node, val)
  if _bst_is_empty(node)
    return _bst_node(val, _bst_empty(), _bst_empty())
  if val < node["val"]
    node["left"] = bst_insert(node["left"], val)
  else if val > node["val"]
    node["right"] = bst_insert(node["right"], val)
  node

fn bst_contains(node, val)
  if _bst_is_empty(node)
    return 0
  if val == node["val"]
    return 1
  if val < node["val"]
    return bst_contains(node["left"], val)
  bst_contains(node["right"], val)

fn bst_min(node)
  if _bst_is_empty(node)
    return err("empty tree")
  let current = node
  while not _bst_is_empty(current["left"])
    current = current["left"]
  ok(current["val"])

fn bst_max(node)
  if _bst_is_empty(node)
    return err("empty tree")
  let current = node
  while not _bst_is_empty(current["right"])
    current = current["right"]
  ok(current["val"])

fn bst_inorder(node)
  if _bst_is_empty(node)
    return []
  let left = bst_inorder(node["left"])
  let right = bst_inorder(node["right"])
  let result = []
  for l in left
    push(result, l)
  push(result, node["val"])
  for r in right
    push(result, r)
  result

fn bst_size(node)
  if _bst_is_empty(node)
    return 0
  1 + bst_size(node["left"]) + bst_size(node["right"])

fn main()
  let tree = bst_new()
  tree = bst_insert(tree, 5)
  tree = bst_insert(tree, 3)
  tree = bst_insert(tree, 7)
  tree = bst_insert(tree, 1)
  tree = bst_insert(tree, 4)

  assert(bst_contains(tree, 5) == 1, "contains 5")
  assert(bst_contains(tree, 3) == 1, "contains 3")
  assert(bst_contains(tree, 9) == 0, "not 9")

  assert(unwrap(bst_min(tree)) == 1, "min 1")
  assert(unwrap(bst_max(tree)) == 7, "max 7")

  let sorted = bst_inorder(tree)
  assert(len(sorted) == 5, "5 elements")
  assert(sorted[0] == 1, "sorted first")
  assert(sorted[4] == 7, "sorted last")

  assert(bst_size(tree) == 5, "size 5")
  assert(is_err(bst_min(bst_new())), "min empty")

  print("bstx: all passed")
