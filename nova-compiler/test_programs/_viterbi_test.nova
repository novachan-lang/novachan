import std/coding/viterbi

// ── helpers ──────────────────────────────────────────────────────────────────

fn list_eq(a, b) -> bool
    let na = len(a)
    let nb = len(b)
    if na != nb
        return false
    let i = 0
    while i < na
        if a[i] != b[i]
            return false
        i = i + 1
    true

fn fail_list(label, got, want)
    let gs = ""
    let ws = ""
    let i = 0
    while i < len(got)
        gs = gs + str(got[i])
        if i + 1 < len(got)
            gs = gs + ","
        i = i + 1
    let j = 0
    while j < len(want)
        ws = ws + str(want[j])
        if j + 1 < len(want)
            ws = ws + ","
        j = j + 1
    print("FAIL viterbi " + label + ": got=[" + gs + "] want=[" + ws + "]")
    exit(1)

fn fail_int(label, got, want)
    print("FAIL viterbi " + label + ": got=" + str(got) + " want=" + str(want))
    exit(1)

// ── Inlined encoder (G1=7 G2=5 K=3) so the KAT is self-contained ─────────────
// This mirrors the cv_encode logic exactly; we do not import convolutional.nova.

fn _s1(state) -> int
    let v = (state >> 1) & 1
    v

fn _s2(state) -> int
    let v = state & 1
    v

fn _enc_out(state, u) -> any
    let s1 = _s1(state)
    let s2 = _s2(state)
    let g1 = u ^ s1 ^ s2
    let g2 = u ^ s2
    let out = []
    push(out, g1)
    push(out, g2)
    out

fn _next_state(state, u) -> int
    let s1 = _s1(state)
    let ns = u * 2 + s1
    ns

fn encode(bits) -> any
    let n = len(bits)
    let state = 0
    let out = []
    let i = 0
    while i < n
        let u = bits[i]
        let pair = _enc_out(state, u)
        push(out, pair[0])
        push(out, pair[1])
        state = _next_state(state, u)
        i = i + 1
    let f = 0
    while f < 2
        let pair = _enc_out(state, 0)
        push(out, pair[0])
        push(out, pair[1])
        state = _next_state(state, 0)
        f = f + 1
    out

// ── KAT ──────────────────────────────────────────────────────────────────────

fn main()
    // Code parameters
    if vt_g1() != 7
        fail_int("g1", vt_g1(), 7)
    if vt_g2() != 5
        fail_int("g2", vt_g2(), 5)

    // vt_hamming
    let a11 = []
    push(a11, 1)
    push(a11, 1)
    let a10 = []
    push(a10, 1)
    push(a10, 0)
    if vt_hamming(a11, a10) != 1
        fail_int("hamming([1,1],[1,0])", vt_hamming(a11, a10), 1)
    let a00 = []
    push(a00, 0)
    push(a00, 0)
    if vt_hamming(a11, a00) != 2
        fail_int("hamming([1,1],[0,0])", vt_hamming(a11, a00), 2)
    if vt_hamming(a11, a11) != 0
        fail_int("hamming([1,1],[1,1])", vt_hamming(a11, a11), 0)

    // vt_branch_metric
    if vt_branch_metric(a11, a10) != 1
        fail_int("branch_metric([1,1],[1,0])", vt_branch_metric(a11, a10), 1)
    if vt_branch_metric(a11, a11) != 0
        fail_int("branch_metric([1,1],[1,1])", vt_branch_metric(a11, a11), 0)
    if vt_branch_metric(a11, a00) != 2
        fail_int("branch_metric([1,1],[0,0])", vt_branch_metric(a11, a00), 2)

    // vt_expected_output
    let eo01 = vt_expected_output(0, 1)
    if not list_eq(eo01, a11)
        fail_list("expected_output(0,1)", eo01, a11)
    let eo00 = vt_expected_output(0, 0)
    if not list_eq(eo00, a00)
        fail_list("expected_output(0,0)", eo00, a00)

    // ── ROUND-TRIP: msg=[1] ───────────────────────────────────────────────────
    let msg1 = []
    push(msg1, 1)
    let enc1 = encode(msg1)
    // enc1 should be [1,1,1,0,1,1] (6 bits)
    let want_enc1 = []
    push(want_enc1, 1)
    push(want_enc1, 1)
    push(want_enc1, 1)
    push(want_enc1, 0)
    push(want_enc1, 1)
    push(want_enc1, 1)
    if not list_eq(enc1, want_enc1)
        fail_list("internal_enc([1])", enc1, want_enc1)
    let dec1 = vt_decode(enc1)
    if not list_eq(dec1, msg1)
        fail_list("decode(enc([1]))", dec1, msg1)

    // ── ROUND-TRIP: msg=[0] (all-zeros) ──────────────────────────────────────
    let msg0 = []
    push(msg0, 0)
    let enc0 = encode(msg0)
    let dec0 = vt_decode(enc0)
    if not list_eq(dec0, msg0)
        fail_list("decode(enc([0]))", dec0, msg0)

    // ── ROUND-TRIP: msg=[1,0,1,1] ────────────────────────────────────────────
    // Encoding trace (verified manually):
    // u=1,s=0: g=[1,1]; ns=2
    // u=0,s=2: g=[1,0]; ns=1
    // u=1,s=1: g=[0,0]; ns=2
    // u=1,s=2: g=[0,1]; ns=3
    // flush u=0,s=3: g=[0,1]; ns=1
    // flush u=0,s=1: g=[1,1]; ns=0
    // enc4 = [1,1,1,0,0,0,0,1,0,1,1,1]
    let msg4 = []
    push(msg4, 1)
    push(msg4, 0)
    push(msg4, 1)
    push(msg4, 1)
    let enc4 = encode(msg4)
    let want_enc4 = []
    push(want_enc4, 1)
    push(want_enc4, 1)
    push(want_enc4, 1)
    push(want_enc4, 0)
    push(want_enc4, 0)
    push(want_enc4, 0)
    push(want_enc4, 0)
    push(want_enc4, 1)
    push(want_enc4, 0)
    push(want_enc4, 1)
    push(want_enc4, 1)
    push(want_enc4, 1)
    if not list_eq(enc4, want_enc4)
        fail_list("internal_enc([1,0,1,1])", enc4, want_enc4)
    let dec4 = vt_decode(enc4)
    if not list_eq(dec4, msg4)
        fail_list("decode(enc([1,0,1,1]))", dec4, msg4)

    // ── ERROR CORRECTION: flip bit 0 of enc([1,0,1,1]) ───────────────────────
    // enc4 = [1,1,1,0,0,0,0,1,0,1,1,1]; flip index 0: [0,1,1,0,0,0,0,1,0,1,1,1]
    // This introduces 1 bit error; Viterbi (d_free=5) corrects up to 2 errors.
    let flipped = []
    push(flipped, 0)
    push(flipped, 1)
    push(flipped, 1)
    push(flipped, 0)
    push(flipped, 0)
    push(flipped, 0)
    push(flipped, 0)
    push(flipped, 1)
    push(flipped, 0)
    push(flipped, 1)
    push(flipped, 1)
    push(flipped, 1)
    let dec_flip = vt_decode(flipped)
    if not list_eq(dec_flip, msg4)
        fail_list("decode(flip_bit0(enc([1,0,1,1])))", dec_flip, msg4)

    // ── ERROR CORRECTION: flip bit 5 (middle of enc([1,0,1,1])) ──────────────
    // enc4[5]=0 -> flip to 1: [1,1,1,0,0,1,0,1,0,1,1,1]
    let flipped2 = []
    push(flipped2, 1)
    push(flipped2, 1)
    push(flipped2, 1)
    push(flipped2, 0)
    push(flipped2, 0)
    push(flipped2, 1)
    push(flipped2, 0)
    push(flipped2, 1)
    push(flipped2, 0)
    push(flipped2, 1)
    push(flipped2, 1)
    push(flipped2, 1)
    let dec_flip2 = vt_decode(flipped2)
    if not list_eq(dec_flip2, msg4)
        fail_list("decode(flip_bit5(enc([1,0,1,1])))", dec_flip2, msg4)

    // ── ROUND-TRIP: msg=[1,1,0,0,1,0] (longer message) ───────────────────────
    let msg6 = []
    push(msg6, 1)
    push(msg6, 1)
    push(msg6, 0)
    push(msg6, 0)
    push(msg6, 1)
    push(msg6, 0)
    let enc6 = encode(msg6)
    let dec6 = vt_decode(enc6)
    if not list_eq(dec6, msg6)
        fail_list("decode(enc([1,1,0,0,1,0]))", dec6, msg6)

    // ── decode_terminated is an alias ────────────────────────────────────────
    let dec4t = vt_decode_terminated(enc4)
    if not list_eq(dec4t, msg4)
        fail_list("decode_terminated(enc([1,0,1,1]))", dec4t, msg4)

    print("PASS _viterbi_test")
