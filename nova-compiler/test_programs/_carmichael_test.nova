// _carmichael_test.nova — KAT for std/math/carmichael
//
// Hand-verified expected values:
//
// cm_is_carmichael:
//   561  = 3 * 11 * 17 — squarefree; (3-1)=2|560, (11-1)=10|560, (17-1)=16|560 => true
//   1105 = 5 * 13 * 17 — squarefree; 4|1104, 12|1104, 16|1104 => true
//   1729 = 7 * 13 * 19 — squarefree; 6|1728, 12|1728, 18|1728 => true
//   560  = 2^4 * 5 * 7 — not squarefree (2^4) => false
//   7    = prime — not composite => false
//   12   = 2^2 * 3 — composite but not squarefree => false
//   6    = 2 * 3 — composite, squarefree, but (2-1)=1|5 ok, (3-1)=2|5? 5%2=1 != 0 => false
//
// cm_lambda:
//   lambda(1)  = 1
//   lambda(8)  = lambda(2^3) = 2^(3-2) = 2
//   lambda(15) = lcm(lambda(3), lambda(5)) = lcm(phi(3),phi(5)) = lcm(2,4) = 4
//   lambda(12) = lcm(lambda(4), lambda(3)) = lcm(2, 2) = 2
//   lambda(7)  = phi(7) = 6   (7 is prime, k=1: p^0*(p-1)=1*6=6)
//
// cm_list:
//   cm_list(1000) = [561]  (next Carmichael is 1105 > 1000)
//   cm_list(560)  = []
//   cm_list(1729) = [561, 1105, 1729]

import std/math/carmichael

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got " + gs + " want " + ws)
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cklen(label: string, got: list, want: int)
    if len(got) != want
        print("FAIL " + label + ": list len got " + str(len(got)) + " want " + str(want))
        exit(1)

fn ckelem(label: string, got: list, idx: int, want: int)
    let v = got[idx]
    if v != want
        print("FAIL " + label + ": elem[" + str(idx) + "] got " + str(v) + " want " + str(want))
        exit(1)

fn main()
    // --- cm_is_carmichael KATs (spec-required) ---
    ckb("cm_is_carmichael(561)",  cm_is_carmichael(561),  true)
    ckb("cm_is_carmichael(1105)", cm_is_carmichael(1105), true)
    ckb("cm_is_carmichael(1729)", cm_is_carmichael(1729), true)
    ckb("cm_is_carmichael(560)",  cm_is_carmichael(560),  false)
    ckb("cm_is_carmichael(7)",    cm_is_carmichael(7),    false)
    // Additional checks
    ckb("cm_is_carmichael(1)",    cm_is_carmichael(1),    false)
    ckb("cm_is_carmichael(12)",   cm_is_carmichael(12),   false)
    ckb("cm_is_carmichael(6)",    cm_is_carmichael(6),    false)

    // --- cm_lambda KATs (spec-required) ---
    cki("cm_lambda(1)",  cm_lambda(1),  1)
    cki("cm_lambda(8)",  cm_lambda(8),  2)
    cki("cm_lambda(15)", cm_lambda(15), 4)
    // Additional checks
    cki("cm_lambda(12)", cm_lambda(12), 2)
    cki("cm_lambda(7)",  cm_lambda(7),  6)

    // --- cm_list KATs (spec-required) ---
    let list1000 = cm_list(1000)
    cklen("cm_list(1000) len", list1000, 1)
    ckelem("cm_list(1000)[0]", list1000, 0, 561)

    let list560 = cm_list(560)
    cklen("cm_list(560) empty", list560, 0)

    let list1729 = cm_list(1729)
    cklen("cm_list(1729) len", list1729, 3)
    ckelem("cm_list(1729)[0]", list1729, 0, 561)
    ckelem("cm_list(1729)[1]", list1729, 1, 1105)
    ckelem("cm_list(1729)[2]", list1729, 2, 1729)

    print("_carmichael_test passed")
