import setops

fn main()
    // set_union: a's uniques in order, then b's not-already-present
    assert(setops.set_union([1, 2, 3], [3, 4, 5]) == [1, 2, 3, 4, 5], "union of [1,2,3] and [3,4,5]")
    // set_intersection: a-order, deduped, only those also in b
    assert(setops.set_intersection([1, 2, 3, 4], [2, 4, 6]) == [2, 4], "intersection keeps shared elems")
    // set_difference: in a, not in b
    assert(setops.set_difference([1, 2, 3, 4], [2, 4]) == [1, 3], "difference removes b's elems")
    // is_subset: every element of a is in b -> 1
    assert(setops.is_subset([1, 2], [1, 2, 3]) == 1, "[1,2] is subset of [1,2,3]")
    assert(setops.is_subset([1, 4], [1, 2, 3]) == 0, "[1,4] not subset (4 missing)")
    // set_equal: same elements ignoring order/dups
    assert(setops.set_equal([1, 2, 3], [3, 2, 1]) == 1, "reordered sets are equal")

    print("setops_lib_test passed")
