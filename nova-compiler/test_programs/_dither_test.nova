import std/raster/dither

fn cki(label, got, want)
    if got != want
        print("FAIL dither " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── KAT 1: dt_bayer_matrix(2) == [0,2,3,1] ───────────────────────────────
    let bm2 = dt_bayer_matrix(2)
    cki("bayer2_0", bm2[0], 0)
    cki("bayer2_1", bm2[1], 2)
    cki("bayer2_2", bm2[2], 3)
    cki("bayer2_3", bm2[3], 1)

    // ── KAT 2: dt_bayer_matrix(4) spot checks ────────────────────────────────
    let bm4 = dt_bayer_matrix(4)
    cki("bayer4_0", bm4[0], 0)
    cki("bayer4_1", bm4[1], 8)
    cki("bayer4_4", bm4[4], 12)
    cki("bayer4_15", bm4[15], 5)

    // ── KAT 3: dt_bayer_value ─────────────────────────────────────────────────
    cki("bv_2_0_0", dt_bayer_value(2, 0, 0), 0)
    cki("bv_2_1_0", dt_bayer_value(2, 1, 0), 2)
    cki("bv_2_0_1", dt_bayer_value(2, 0, 1), 3)
    cki("bv_2_1_1", dt_bayer_value(2, 1, 1), 1)
    // Wraps modulo n:
    cki("bv_2_2_0", dt_bayer_value(2, 2, 0), 0)
    cki("bv_2_3_0", dt_bayer_value(2, 3, 0), 2)

    // ── KAT 4: dt_quantize ───────────────────────────────────────────────────
    cki("quant_0_2", dt_quantize(0, 2), 0)
    cki("quant_255_2", dt_quantize(255, 2), 255)
    // 100 < 128 so nearest of {0,255} is 0
    cki("quant_100_2", dt_quantize(100, 2), 0)
    // 200 > 128 so nearest of {0,255} is 255
    cki("quant_200_2", dt_quantize(200, 2), 255)
    cki("quant_127_2", dt_quantize(127, 2), 0)
    cki("quant_128_2", dt_quantize(128, 2), 255)

    // ── KAT 5: dt_nearest_level with 3 levels: {0,128,255} ──────────────────
    // step = 255 / 2 = 127; levels at 0, 127, 255 (last forced to 255)
    // 120: distance to 0=120, to 127=7, to 255=135 -> picks 127
    cki("nearest_120_3", dt_nearest_level(120, 3), 127)
    cki("nearest_0_3", dt_nearest_level(0, 3), 0)
    cki("nearest_255_3", dt_nearest_level(255, 3), 255)
    cki("nearest_64_3", dt_nearest_level(64, 3), 127)
    cki("nearest_63_3", dt_nearest_level(63, 3), 0)

    // ── KAT 6: dt_bayer_value 4x4 spot checks ────────────────────────────────
    cki("bv_4_0_0", dt_bayer_value(4, 0, 0), 0)
    cki("bv_4_1_0", dt_bayer_value(4, 1, 0), 8)
    cki("bv_4_0_1", dt_bayer_value(4, 0, 1), 12)
    cki("bv_4_3_3", dt_bayer_value(4, 3, 3), 5)

    // ── KAT 7: dt_ordered on all-0 surface gives all 0 ───────────────────────
    let black_s = {}
    black_s["w"] = 2
    black_s["h"] = 2
    let bpx = []
    bpx.push(0)
    bpx.push(0)
    bpx.push(0)
    bpx.push(0)
    black_s["px"] = bpx
    let ord_black = dt_ordered(black_s, 2, 2)
    let obpx = ord_black["px"]
    cki("ord_black_0", obpx[0], 0)
    cki("ord_black_1", obpx[1], 0)
    cki("ord_black_2", obpx[2], 0)
    cki("ord_black_3", obpx[3], 0)

    // ── KAT 8: dt_ordered on all-255 surface gives all 255 ───────────────────
    let white_s = {}
    white_s["w"] = 2
    white_s["h"] = 2
    let wpx = []
    wpx.push(255)
    wpx.push(255)
    wpx.push(255)
    wpx.push(255)
    white_s["px"] = wpx
    let ord_white = dt_ordered(white_s, 2, 2)
    let owpx = ord_white["px"]
    cki("ord_white_0", owpx[0], 255)
    cki("ord_white_1", owpx[1], 255)
    cki("ord_white_2", owpx[2], 255)
    cki("ord_white_3", owpx[3], 255)

    // ── KAT 9: dt_ordered output values are valid quantization levels ─────────
    let gray_s = {}
    gray_s["w"] = 2
    gray_s["h"] = 2
    let gpx = []
    gpx.push(128)
    gpx.push(128)
    gpx.push(128)
    gpx.push(128)
    gray_s["px"] = gpx
    let ord_gray = dt_ordered(gray_s, 2, 2)
    let ogpx = ord_gray["px"]
    // Each output should be 0 or 255 (2-level dither)
    let oi = 0
    while oi < 4
        let pv = ogpx[oi]
        let valid = 0
        if pv == 0
            valid = 1
        if pv == 255
            valid = 1
        cki("ord_gray_valid_" + str(oi), valid, 1)
        oi = oi + 1
    // For 2-level Bayer dither of mid-gray: at least one pixel should be dithered to 255
    // since some Bayer thresholds are < 128. Verify not all-zero and not all-255.
    let sum_ord = ogpx[0] + ogpx[1] + ogpx[2] + ogpx[3]
    let has_mix = 0
    if sum_ord > 0
        has_mix = 1
    if sum_ord < 1020
        has_mix = 1
    cki("ord_gray_dithered", has_mix, 1)

    // ── KAT 10: dt_floyd_steinberg on all-0 gives all 0 ─────────────────────
    let fs_black = {}
    fs_black["w"] = 2
    fs_black["h"] = 2
    let fbpx = []
    fbpx.push(0)
    fbpx.push(0)
    fbpx.push(0)
    fbpx.push(0)
    fs_black["px"] = fbpx
    let fs_b_out = dt_floyd_steinberg(fs_black, 2)
    let fsbpx = fs_b_out["px"]
    cki("fs_black_0", fsbpx[0], 0)
    cki("fs_black_3", fsbpx[3], 0)

    // ── KAT 11: dt_floyd_steinberg on all-255 gives all 255 ──────────────────
    let fs_white = {}
    fs_white["w"] = 2
    fs_white["h"] = 2
    let fwpx = []
    fwpx.push(255)
    fwpx.push(255)
    fwpx.push(255)
    fwpx.push(255)
    fs_white["px"] = fwpx
    let fs_w_out = dt_floyd_steinberg(fs_white, 2)
    let fswpx = fs_w_out["px"]
    cki("fs_white_0", fswpx[0], 255)
    cki("fs_white_3", fswpx[3], 255)

    // ── KAT 12: dt_floyd_steinberg on all-128 2x2 with 2 levels: produces a mix
    let fs_gray = {}
    fs_gray["w"] = 2
    fs_gray["h"] = 2
    let fgpx = []
    fgpx.push(128)
    fgpx.push(128)
    fgpx.push(128)
    fgpx.push(128)
    fs_gray["px"] = fgpx
    let fs_g_out = dt_floyd_steinberg(fs_gray, 2)
    let fsgpx = fs_g_out["px"]
    // All output values should be 0 or 255
    let fsi = 0
    while fsi < 4
        let pv = fsgpx[fsi]
        let valid = 0
        if pv == 0
            valid = 1
        if pv == 255
            valid = 1
        cki("fs_gray_valid_" + str(fsi), valid, 1)
        fsi = fsi + 1
    // Error diffusion should produce a mix (not all black or all white)
    let fs_sum = fsgpx[0] + fsgpx[1] + fsgpx[2] + fsgpx[3]
    let fs_mix = 0
    if fs_sum > 0
        fs_mix = 1
    if fs_sum < 1020
        fs_mix = 1
    cki("fs_gray_mix", fs_mix, 1)

    // ── KAT 13: dt_threshold produces valid level ─────────────────────────────
    let mx2 = dt_bayer_matrix(2)
    let tv = dt_threshold(128, 0, 0, mx2, 2, 2)
    let tv_valid = 0
    if tv == 0
        tv_valid = 1
    if tv == 255
        tv_valid = 1
    cki("threshold_valid", tv_valid, 1)

    // ── KAT 14: dt_threshold deterministic for same inputs ────────────────────
    let tv2 = dt_threshold(128, 0, 0, mx2, 2, 2)
    cki("threshold_deterministic", tv, tv2)

    // ── KAT 15: dt_quantize with 4 levels: {0,85,170,255} ────────────────────
    // step = 255/3 = 85; midpoint = 42.5; 42 -> 0, 43 -> 85
    cki("quant_0_4", dt_quantize(0, 4), 0)
    cki("quant_85_4", dt_quantize(85, 4), 85)
    cki("quant_170_4", dt_quantize(170, 4), 170)
    cki("quant_255_4", dt_quantize(255, 4), 255)
    cki("quant_42_4", dt_quantize(42, 4), 0)
    cki("quant_43_4", dt_quantize(43, 4), 85)

    print("PASS _dither_test")
