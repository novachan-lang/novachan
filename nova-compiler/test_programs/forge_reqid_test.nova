// forge_reqid_test -- master plan Phase 2.11: request-ID middleware. Mints/propagates an
// X-Request-Id, exposes it to the handler via req.state, and echoes it on the response.
import forge

fn h(req: Request) -> string
    // the handler can read the id for correlated logging
    "rid=" + req.state["request_id"]

fn main()
    let a = forge.app()
    forge.use(a, forge.mw_request_id())
    forge.get(a, "/x", h)

    // no incoming id -> a fresh one is minted, exposed to the handler, and echoed
    let r1: Response = forge.dispatch_req(a, forge.build_request("GET /x HTTP/1.1\r\n\r\n", 0))
    let rid = r1.headers["X-Request-Id"]
    assert(len(rid) > 0, "X-Request-Id minted")
    assert(find(rid, "req-") == 0, "minted id has req- prefix")
    assert(r1.body == "rid=" + rid, "handler saw the same id via req.state")
    print("PASS: request id minted + exposed + echoed")

    // an incoming X-Request-Id is HONORED (trace propagation)
    let r2: Response = forge.dispatch_req(a, forge.build_request("GET /x HTTP/1.1\r\nX-Request-Id: trace-abc-123\r\n\r\n", 0))
    assert(r2.headers["X-Request-Id"] == "trace-abc-123", "incoming id honored")
    assert(r2.body == "rid=trace-abc-123", "handler saw the incoming id")
    print("PASS: incoming request id propagated")
    print("forge_reqid_test passed")
