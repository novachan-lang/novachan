// file_handle_test — buffered streaming file I/O via open file handles.
// Whole-file read_file/write_file load the entire file; these stream a file
// line-by-line through an open FILE* handle (open/read_line/write/eof/seek/
// tell/flush/close). Binary modes ("wb"/"rb") keep byte offsets exact across
// platforms (no Windows CRLF translation).

fn main()
    let path = "_file_handle_tmp.txt"

    // --- streaming write ---
    let w = file_open(path, "wb")
    assert(w >= 1, "open for write")
    file_write(w, "alpha\n")
    file_write(w, "beta\n")
    file_write(w, "gamma\n")
    file_flush(w)
    assert_eq(file_close(w), 0)
    assert_eq(file_close(w), -1)            // double-close is reported, not a crash

    // --- streaming read + seek/tell ---
    let r = file_open(path, "rb")
    assert(r >= 1, "open for read")
    assert_eq(file_tell(r), 0)
    assert_eq(file_read_line(r), "alpha")   // terminator stripped
    assert_eq(file_tell(r), 6)              // "alpha\n" = 6 bytes
    assert_eq(file_read_line(r), "beta")
    assert_eq(file_read_line(r), "gamma")
    assert_eq(file_read_line(r), "")        // past last line
    assert_eq(file_eof(r), true)
    assert_eq(file_seek(r, 0), 0)           // rewind
    assert_eq(file_tell(r), 0)
    assert_eq(file_read_line(r), "alpha")
    assert_eq(file_close(r), 0)

    // --- invalid-handle safety (no UB; error flag + safe default) ---
    assert_eq(file_read_line(999), "")
    assert_eq(file_seek(999, 0), -1)
    assert_eq(file_eof(900), true)

    // --- canonical streaming loop: read, stop on "" at EOF ---
    let r2 = file_open(path, "rb")
    let count = 0
    let total = 0
    while true
        let line = file_read_line(r2)
        if line == "" and file_eof(r2)
            break
        count = count + 1
        total = total + len(line)
    assert_eq(file_close(r2), 0)
    assert_eq(count, 3)
    assert_eq(total, 14)                     // alpha(5)+beta(4)+gamma(5)

    remove_file(path)
    print("file_handle_test passed")
