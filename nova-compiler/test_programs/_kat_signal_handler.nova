import forge_signal_handler

fn main()
    let s = sh_new()
    s = sh_register(s, "SIGTERM", "graceful_shutdown")
    s = sh_register(s, "SIGHUP", "reload_config")
    assert(sh_handler_count(s) == 2, "2 handlers")

    let r1 = sh_fire(s, "SIGTERM")
    assert(is_ok(r1), "fire ok")
    assert(unwrap(r1) == "graceful_shutdown", "correct handler")

    let r2 = sh_fire(s, "SIGTERM")
    assert(is_ok(r2), "fire again")
    assert(sh_fire_count(s, "SIGTERM") == 2, "fired 2x")
    assert(sh_total_fired(s) == 2, "2 total")

    let r3 = sh_fire(s, "SIGUSR1")
    assert(is_err(r3), "no handler")

    let u = sh_unregister(s, "SIGHUP")
    assert(is_ok(u), "unregister ok")
    s = unwrap(u)
    assert(sh_handler_count(s) == 1, "1 handler")

    print("SIGNAL-HANDLER KAT PASS")
