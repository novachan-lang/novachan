import forge_slidingmax

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn join_ints(lst) -> string
    let parts = []
    let i = 0
    while i < len(lst)
        push(parts, str(lst[i]))
        i = i + 1
    join(parts, ",")

fn main()
    let fails = 0

    // classic LeetCode example: [1,3,-1,-3,5,3,6,7], k=3 -> [3,3,5,5,6,7]
    let arr = [1, 3, 0 - 1, 0 - 3, 5, 3, 6, 7]
    fails = fails + expect("max_k3", join_ints(sliding_max(arr, 3)), "3,3,5,5,6,7")
    // sliding min of same -> [-1,-3,-3,-3,3,3]
    fails = fails + expect("min_k3", join_ints(sliding_min(arr, 3)), "-1,-3,-3,-3,3,3")

    // k=1 -> the array itself
    fails = fails + expect("max_k1", join_ints(sliding_max([4, 2, 7, 1], 1)), "4,2,7,1")
    // k=len -> single max/min
    fails = fails + expect("max_kn", join_ints(sliding_max([4, 2, 7, 1], 4)), "7")
    fails = fails + expect("min_kn", join_ints(sliding_min([4, 2, 7, 1], 4)), "1")

    // monotonic increasing input
    fails = fails + expect("incr", join_ints(sliding_max([1, 2, 3, 4, 5], 2)), "2,3,4,5")
    // monotonic decreasing input
    fails = fails + expect("decr", join_ints(sliding_max([5, 4, 3, 2, 1], 2)), "5,4,3,2")

    // all equal
    fails = fails + expect("equal", join_ints(sliding_max([3, 3, 3, 3], 2)), "3,3,3")

    // k larger than array -> empty
    fails = fails + expect("k_too_big", str(len(sliding_max([1, 2], 5))), "0")

    // result count = n-k+1
    fails = fails + expect("count", str(len(sliding_max([1, 2, 3, 4, 5, 6], 3))), "4")

    if fails == 0
        print("forge_slidingmax: all passed")
    else
        print("forge_slidingmax: " + str(fails) + " FAILED")
