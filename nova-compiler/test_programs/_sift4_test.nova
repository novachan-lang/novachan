// KAT test for std/text/sift4
// Vectors hand-computed against the published SIFT4 "Simplest" algorithm.
import std/text/sift4

// cki: assert integer equality; print FAIL and exit(1) on mismatch.
fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// ckf: assert float within eps; print FAIL and exit(1) on mismatch.
fn ckf(label, got, expected, eps)
    let diff = got - expected
    if diff < 0.0
        diff = 0.0 - diff
    if diff > eps
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// ── KAT 1: identical strings -> distance 0 ──────────────────────────────────
let r1 = sf_distance("abc", "abc", 5)
cki("identical_abc", r1, 0)

// ── KAT 2: empty a -> distance == |b| ───────────────────────────────────────
let r2 = sf_distance("", "abc", 5)
cki("empty_a", r2, 3)

// ── KAT 3: empty b -> distance == |a| ───────────────────────────────────────
let r3 = sf_distance("abc", "", 5)
cki("empty_b", r3, 3)

// ── KAT 4: single-char mismatch -> distance 1 ───────────────────────────────
let r4 = sf_distance("a", "b", 5)
cki("single_char_mismatch", r4, 1)

// ── KAT 5: similarity of identical strings -> 1.0 ───────────────────────────
let r5 = sf_similarity("abc", "abc", 5)
ckf("similarity_identical", r5, 1.0, 0.001)

// ── KAT 6: London vs Lond -> distance 2 ─────────────────────────────────────
// "London" len=6, "Lond" len=4; SIFT4 simplest yields lcss=4, dist=max(6,4)-4=2
let r6 = sf_distance("London", "Lond", 5)
cki("london_lond", r6, 2)

// ── KAT 7: Chicago vs Chicago -> distance 0 ─────────────────────────────────
let r7 = sf_distance("Chicago", "Chicago", 5)
cki("chicago_identical", r7, 0)

// ── KAT 8: both empty -> similarity 1.0 ─────────────────────────────────────
let r8 = sf_similarity("", "", 5)
ckf("similarity_both_empty", r8, 1.0, 0.001)

// ── KAT 9: completely disjoint strings -> distance = max length ──────────────
// "abc" vs "xyz": no common characters anywhere, lcss=0, dist=max(3,3)=3
let r9 = sf_distance("abc", "xyz", 5)
cki("disjoint_abc_xyz", r9, 3)

// ── KAT 10: prefix match -> distance = suffix length ────────────────────────
// "hello" vs "hell": lcss=4 (all of "hell" matches), dist=max(5,4)-4=1
let r10 = sf_distance("hello", "hell", 5)
cki("prefix_hello_hell", r10, 1)

print("_sift4_test passed")
