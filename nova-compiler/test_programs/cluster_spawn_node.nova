// cluster_spawn_node.nova — a cluster node for the DISTRIBUTED TASK PLACEMENT test
// (increment 4). Args: <port> [seeds...] [drive]. A node whose args include "drive" plays the
// DRIVER: it joins, converges, then cluster_spawn()s add(15,27) on a LIVE peer and prints the
// result. Every other node is a WORKER: it joins and stays up to serve spawn requests (its
// _handle_peer resolves the requested function from the fn registry and replies). Both run the
// SAME program, so the worker has `add` registered under its unmangled name — exactly the
// remote_spawn_test pattern, now routed through cluster membership + liveness.
import clusterx

fn add(a, b)
    a + b

fn main()
    let argv = args()
    let port = parse_int(argv[1])
    let seeds = []
    let is_driver = false
    let i = 2
    while i < len(argv)
        if argv[i] == "drive"
            is_driver = true
        else
            push(seeds, argv[i])
        i = i + 1
    let info = cluster_start(port, seeds)
    if is_driver
        sleep(2500)                          // converge so a live peer is known
        let r = cluster_spawn(info, "add", [15, 27])
        if r["ok"]
            print("RESULT=" + str(r["value"]) + " node=" + r["node"])
        else
            print("ERROR=" + r["error"])
        exit(0)
    sleep(6000)                              // worker: stay up to serve the spawn, then exit
    print("WORKER done")
    exit(0)
