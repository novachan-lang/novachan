// KAT for std/finance/black_scholes — Black-Scholes European option pricing.
// Reference values computed from standard B-S formula with N(d) from high-precision tables.
import std/finance/black_scholes

fn approx(a: float, b: float, tol: float) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < tol
        return 1
    return 0

fn check(label: string, got: float, want: float, tol: float)
    let ok = approx(got, want, tol)
    if ok == 0
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // KAT 1: ATM call — S=100, K=100, T=1, r=0.05, sigma=0.2
    // Expected: ~10.4506
    let c1 = bs_call(100.0, 100.0, 1.0, 0.05, 0.2)
    check("bs_call_atm", c1, 10.4506, 0.05)

    // KAT 2: ATM put — same parameters
    // Expected: ~5.5735
    let p1 = bs_put(100.0, 100.0, 1.0, 0.05, 0.2)
    check("bs_put_atm", p1, 5.5735, 0.05)

    // KAT 3: Put-call parity: C - P = S - K*exp(-r*T)
    // 10.4506 - 5.5735 = 4.877; 100 - 100*exp(-0.05) = 100 - 95.123 = 4.877
    let parity_lhs = c1 - p1
    let disc = exp(0.0 - 0.05 * 1.0)
    let parity_rhs = 100.0 - 100.0 * disc
    check("put_call_parity", parity_lhs, parity_rhs, 0.01)

    // KAT 4: Deep ITM call (S=150, K=100, T=1, r=0.05, sigma=0.2)
    // d1 is large, N(d1) close to 1 => call dominates intrinsic value
    let c2 = bs_call(150.0, 100.0, 1.0, 0.05, 0.2)
    // Intrinsic value = 50; with discounting and theta, should be > 50
    let ok4 = approx(c2, 55.0, 8.0)
    if ok4 == 0
        print("FAIL bs_call_deep_itm: got=" + str(c2))
        exit(1)

    // KAT 5: Deep OTM call (S=50, K=100, T=1, r=0.05, sigma=0.2)
    // Should be very small (near zero)
    let c3 = bs_call(50.0, 100.0, 1.0, 0.05, 0.2)
    let ok5 = approx(c3, 0.0, 0.5)
    if ok5 == 0
        print("FAIL bs_call_deep_otm: got=" + str(c3) + " (expected near 0)")
        exit(1)

    // KAT 6: Short maturity — T=0.25 (3 months), ATM
    // d1=(0.05+0.02)*0.25/(0.2*0.5)=0.175; d2=0.075; C~4.61
    let c4 = bs_call(100.0, 100.0, 0.25, 0.05, 0.2)
    check("bs_call_short_maturity", c4, 4.61, 0.10)

    // KAT 7: Higher volatility raises both call and put prices
    let c_lo = bs_call(100.0, 100.0, 1.0, 0.05, 0.1)
    let c_hi = bs_call(100.0, 100.0, 1.0, 0.05, 0.4)
    if c_hi < c_lo
        print("FAIL vega_monotone: higher sigma should give higher call price")
        exit(1)

    // KAT 8: Put-call parity at different parameters
    // S=80, K=90, T=0.5, r=0.03, sigma=0.25
    let c5 = bs_call(80.0, 90.0, 0.5, 0.03, 0.25)
    let p5 = bs_put(80.0, 90.0, 0.5, 0.03, 0.25)
    let disc5 = exp(0.0 - 0.03 * 0.5)
    let par_lhs = c5 - p5
    let par_rhs = 80.0 - 90.0 * disc5
    check("put_call_parity_otm", par_lhs, par_rhs, 0.01)

    print("PASS _black_scholes_test")
