import forge_audit_trail

fn main()
    let at = at_new()
    at = at_log(at, "alice", "create", "order-123", 1000)
    at = at_log(at, "bob", "update", "order-123", 1001)
    at = at_log(at, "alice", "delete", "product-456", 1002)
    at = at_log(at, "charlie", "create", "user-789", 1003)
    assert(at_count(at) == 4, "4 entries")

    let alice_entries = at_by_actor(at, "alice")
    assert(len(alice_entries) == 2, "alice has 2")

    let order_entries = at_by_resource(at, "order-123")
    assert(len(order_entries) == 2, "order-123 has 2")

    let creates = at_by_action(at, "create")
    assert(len(creates) == 2, "2 creates")

    let recent = at_since(at, 1002)
    assert(len(recent) == 2, "2 since 1002")

    let last2 = at_last(at, 2)
    assert(len(last2) == 2, "last 2")
    assert(last2[0]["actor"] == "alice", "last 2 first = alice")
    assert(last2[1]["actor"] == "charlie", "last 2 second = charlie")

    let last10 = at_last(at, 10)
    assert(len(last10) == 4, "last 10 = all 4")

    let bob_entries = at_by_actor(at, "nobody")
    assert(len(bob_entries) == 0, "nobody has 0")

    print("AUDIT-TRAIL KAT PASS")
