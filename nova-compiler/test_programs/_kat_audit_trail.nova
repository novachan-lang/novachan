import forge_audit_trail

fn main()
    let at = at_new()
    at = at_log(at, "alice", "create", "order-123", "created new order")
    at = at_log(at, "bob", "update", "order-123", "changed qty")
    at = at_log(at, "alice", "delete", "product-456", "removed listing")
    at = at_log(at, "charlie", "create", "user-789", "signup")

    assert(at_count(at) == 4, "4 events total")
    assert(at_count_by_actor(at, "alice") == 2, "alice logged 2 events")
    assert(at_count_by_actor(at, "bob") == 1, "bob logged 1 event")
    assert(at_count_by_actor(at, "nobody") == 0, "unknown actor has 0")
    assert(at_count_by_action(at, "create") == 2, "2 create events")
    assert(at_count_by_action(at, "update") == 1, "1 update event")
    assert(at_count_by_action(at, "nope") == 0, "unknown action has 0")

    let e0 = at_entry_at(at, 0)
    assert(is_ok(e0) == true, "entry 0 exists")
    assert(unwrap(e0) == "alice:create:order-123", "entry 0 formatted")

    let e3 = at_entry_at(at, 3)
    assert(is_ok(e3) == true, "entry 3 exists")
    assert(unwrap(e3) == "charlie:create:user-789", "entry 3 formatted")

    let bad = at_entry_at(at, 99)
    assert(is_err(bad) == true, "out of range index errs")
    let neg = at_entry_at(at, -1)
    assert(is_err(neg) == true, "negative index errs")

    let la = at_last_actor(at)
    assert(is_ok(la) == true, "last actor present")
    assert(unwrap(la) == "charlie", "last actor is charlie")

    let lac = at_last_action(at)
    assert(is_ok(lac) == true, "last action present")
    assert(unwrap(lac) == "create", "last action is create")

    assert(at_actor_list(at) == "alice,bob,charlie", "actor list order")
    assert(at_action_list(at) == "create,update,delete", "action list order")

    let empty = at_new()
    let e_bad = at_entry_at(empty, 0)
    assert(is_err(e_bad) == true, "empty trail entry errs")
    let e_la = at_last_actor(empty)
    assert(is_err(e_la) == true, "empty trail last_actor errs")
    let e_lac = at_last_action(empty)
    assert(is_err(e_lac) == true, "empty trail last_action errs")
    assert(at_actor_list(empty) == "", "empty actor list")
    assert(at_action_list(empty) == "", "empty action list")

    print("AUDIT-TRAIL KAT PASS")
