// cluster_fd_node.nova — a cluster node for the failure-detection test (increment 2).
// Args: <port> [seeds...]. Joins the cluster, gossips for a fixed window, then reports its
// STEADY-STATE liveness view (cluster_alive / cluster_status). The harness kills one node
// partway through; by the time the window ends, the killed node has been silent well past
// the timeout (=> down) while the live nodes were just gossiped-with (=> alive). Reading at
// steady state (not on the first transient blip during convergence churn) is what makes the
// liveness verdict reliable — membership is the hard truth, liveness a best-effort hint.
import clusterx

fn main()
    let argv = args()
    let port = parse_int(argv[1])
    let seeds = []
    let i = 2
    while i < len(argv)
        push(seeds, argv[i])
        i = i + 1
    let info = cluster_start(port, seeds)
    sleep(9000)                              // converge + gossip; the harness kills a peer ~3.5s in
    let alive = cluster_alive(info)
    let members = cluster_members(info)
    print("FINAL alive=" + str(alive) + " members=" + str(members))
    exit(0)
