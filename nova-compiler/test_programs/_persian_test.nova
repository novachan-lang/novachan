// KAT for std/calendar/persian — Persian/Jalali calendar conversions.
import std/calendar/persian

fn greg_to_jdn(y, m, d) -> int
    let a = (14 - m) / 12
    let yy = y + 4800 - a
    let mm = m + 12*a - 3
    d + (153*mm + 2)/5 + 365*yy + yy/4 - yy/100 + yy/400 - 32045

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL persian " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL persian " + label + ": got " + str(gi) + " want " + str(wi))
        exit(1)

fn ckrt(label: string, jdn: int, wy: int, wm: int, wd: int)
    let r = jdn_to_persian(jdn)
    let ry = r[0]
    let rm = r[1]
    let rd = r[2]
    if ry != wy or rm != wm or rd != wd
        print("FAIL persian " + label + ": got [" + str(ry) + "," + str(rm) + "," + str(rd) + "] want [" + str(wy) + "," + str(wm) + "," + str(wd) + "]")
        exit(1)

fn main()
    // ── persian_is_leap ───────────────────────────────────────────────────
    // 33-year cycle leap positions (1-indexed): 1,5,9,13,17,22,26,30
    ckb("is_leap(1)",  persian_is_leap(1),  true)
    ckb("is_leap(2)",  persian_is_leap(2),  false)
    ckb("is_leap(3)",  persian_is_leap(3),  false)
    ckb("is_leap(4)",  persian_is_leap(4),  false)
    ckb("is_leap(5)",  persian_is_leap(5),  true)
    ckb("is_leap(9)",  persian_is_leap(9),  true)
    ckb("is_leap(13)", persian_is_leap(13), true)
    ckb("is_leap(17)", persian_is_leap(17), true)
    ckb("is_leap(22)", persian_is_leap(22), true)
    ckb("is_leap(26)", persian_is_leap(26), true)
    ckb("is_leap(30)", persian_is_leap(30), true)
    ckb("is_leap(33)", persian_is_leap(33), false)
    ckb("is_leap(34)", persian_is_leap(34), true)
    // Year 1403: in cycle position (1403-1)%33+1 = 1402%33+1 = 16+1 = 17 → leap
    ckb("is_leap(1403)", persian_is_leap(1403), true)
    // Year 1404: position 18 → not leap
    ckb("is_leap(1404)", persian_is_leap(1404), false)

    // ── persian_to_jdn: epoch ─────────────────────────────────────────────
    // 1 Farvardin 1 AP — the algorithmic epoch value
    let ep_jdn = persian_to_jdn(1, 1, 1)
    print("persian epoch JDN: "+str(ep_jdn))
    // Should be near 1948320 (within 2 of the 622 CE epoch)
    let ep_ok = 0
    if ep_jdn >= 1948318 and ep_jdn <= 1948322
        ep_ok = 1
    if ep_ok != 1
        print("FAIL persian epoch-range: got "+str(ep_jdn)+" want 1948318..1948322")
        exit(1)
    cki("epoch-exact", ep_jdn, 1948320)

    // ── Round-trip 1403/1/1 ───────────────────────────────────────────────
    let jdn1403 = persian_to_jdn(1403, 1, 1)
    ckrt("rt-1403/1/1", jdn1403, 1403, 1, 1)

    // ── 2024-03-20 = Persian Nowruz 1403-01-01 ───────────────────────────
    // Gregorian 2024-03-20 = JDN 2460390 (Nowruz 1403)
    let greg_nowruz = greg_to_jdn(2024, 3, 20)
    cki("greg 2024-03-20 JDN", greg_nowruz, 2460390)
    // Persian_to_jdn(1403,1,1) should match (within 1 day = astronomical accuracy)
    let diff_nowruz = jdn1403 - greg_nowruz
    if diff_nowruz < 0
        diff_nowruz = 0 - diff_nowruz
    if diff_nowruz > 1
        print("FAIL persian nowruz-match: |diff|="+str(diff_nowruz)+" want <=1")
        exit(1)
    // Exact match with our epoch 1948320
    cki("nowruz-exact", jdn1403, 2460390)

    // ── Round-trip: various dates ─────────────────────────────────────────
    // Round-trip 1/1/1
    ckrt("rt-1/1/1", ep_jdn, 1, 1, 1)

    // Round-trip 1/12/29 (last day of normal year, year 1 is leap so last day = 30)
    // Year 1 is leap → month 12 has 30 days
    let j_1_12_30 = persian_to_jdn(1, 12, 30)
    ckrt("rt-1/12/30", j_1_12_30, 1, 12, 30)
    // Year 1 length: 365+1=366 (leap)
    cki("year1-len", j_1_12_30 - ep_jdn + 1, 366)

    // Round-trip mid-year date
    let jdn_mid = persian_to_jdn(1402, 6, 15)
    ckrt("rt-1402/6/15", jdn_mid, 1402, 6, 15)

    // Round-trip month 7 (30-day month)
    let jdn_m7 = persian_to_jdn(1400, 7, 30)
    ckrt("rt-1400/7/30", jdn_m7, 1400, 7, 30)

    // Consecutive day: 1403/1/2 = 1403/1/1 + 1
    let jdn_d2 = persian_to_jdn(1403, 1, 2)
    cki("1403/1/2=1403/1/1+1", jdn_d2, jdn1403 + 1)

    // Year 1403 (leap) last day = 1403/12/30
    let jdn1403_last = persian_to_jdn(1403, 12, 30)
    ckrt("rt-1403/12/30", jdn1403_last, 1403, 12, 30)
    cki("1403-year-len", jdn1403_last - jdn1403 + 1, 366)

    // Year 1404 (non-leap) last day = 1404/12/29
    let jdn1404 = persian_to_jdn(1404, 1, 1)
    let jdn1404_last = persian_to_jdn(1404, 12, 29)
    ckrt("rt-1404/12/29", jdn1404_last, 1404, 12, 29)
    cki("1404-year-len", jdn1404_last - jdn1404 + 1, 365)

    print("PASS _persian_test")
