import forge_protocol_buffer

fn main()
    let p = pb_new()
    p = pb_set_int(p, 1, 42)
    p = pb_set_string(p, 2, "hello")
    p = pb_set_int(p, 3, 100)
    assert(pb_field_count(p) == 3, "3 fields")

    assert(pb_get_int(p, 1) == 42, "field 1 = 42")
    assert(pb_get_string(p, 2) == "hello", "field 2 = hello")
    assert(pb_has_field(p, 1) == 1, "has field 1")
    assert(pb_has_field(p, 99) == 0, "no field 99")
    assert(pb_field_type(p, 1) == "int", "field 1 is int")
    assert(pb_field_type(p, 2) == "string", "field 2 is string")

    p = pb_set_int(p, 1, 99)
    assert(pb_get_int(p, 1) == 99, "updated field 1")
    assert(pb_field_count(p) == 3, "still 3 fields")

    print("PROTOCOL-BUFFER KAT PASS")
