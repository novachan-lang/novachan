import forge_divisors

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn joinl(xs: list) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + ","
        out = out + str(xs[i])
        i = i + 1
    out

fn main()
    let fails = 0

    // divisors
    fails = fails + expect("div12", joinl(divisors(12)), "1,2,3,4,6,12")
    fails = fails + expect("div28", joinl(divisors(28)), "1,2,4,7,14,28")
    fails = fails + expect("div1", joinl(divisors(1)), "1")
    fails = fails + expect("div13", joinl(divisors(13)), "1,13")
    fails = fails + expect("div36", joinl(divisors(36)), "1,2,3,4,6,9,12,18,36")

    // divisor count (tau)
    fails = fails + expect("tau12", str(num_divisors(12)), "6")
    fails = fails + expect("tau60", str(num_divisors(60)), "12")
    fails = fails + expect("tau_prime", str(num_divisors(13)), "2")
    fails = fails + expect("tau_square", str(num_divisors(16)), "5")

    // divisor sum (sigma)
    fails = fails + expect("sig12", str(sum_divisors(12)), "28")
    fails = fails + expect("sig6", str(sum_divisors(6)), "12")
    fails = fails + expect("sig28", str(sum_divisors(28)), "56")

    // aliquot sum
    fails = fails + expect("ali12", str(aliquot_sum(12)), "16")
    fails = fails + expect("ali6", str(aliquot_sum(6)), "6")
    fails = fails + expect("ali8", str(aliquot_sum(8)), "7")

    // perfect numbers
    fails = fails + expect("perf6", str(is_perfect(6)), "true")
    fails = fails + expect("perf28", str(is_perfect(28)), "true")
    fails = fails + expect("perf496", str(is_perfect(496)), "true")
    fails = fails + expect("perf12", str(is_perfect(12)), "false")

    // abundant / deficient
    fails = fails + expect("abund12", str(is_abundant(12)), "true")
    fails = fails + expect("abund10", str(is_abundant(10)), "false")
    fails = fails + expect("defic8", str(is_deficient(8)), "true")
    fails = fails + expect("defic_prime", str(is_deficient(13)), "true")
    fails = fails + expect("defic6", str(is_deficient(6)), "false")

    if fails == 0
        print("forge_divisors: all passed")
    else
        print("forge_divisors: " + str(fails) + " FAILED")
