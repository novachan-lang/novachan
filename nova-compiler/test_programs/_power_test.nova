// _power_test.nova — KAT for std/units/power
import std/units/power

fn approx(a: float, b: float, tol: float) -> int
    let d = a - b
    let ad = d
    if d < 0.0
        ad = 0.0 - d
    let result = 0
    if ad < tol
        result = 1
    result

fn main()
    // KAT 1: 1 kw -> 1000 w
    let r1 = power_convert(1.0, "kw", "w")
    if approx(r1, 1000.0, 0.01) == 0
        print("FAIL power kw->w: got=" + str(r1) + " want=1000.0")
        exit(1)

    // KAT 2: 1 hp -> 745.6999 w (approx tol 0.01)
    let r2 = power_convert(1.0, "hp", "w")
    if approx(r2, 745.6998715823, 0.01) == 0
        print("FAIL power hp->w: got=" + str(r2) + " want=745.6999")
        exit(1)

    // KAT 3: 1 mw -> 1000 kw
    let r3 = power_convert(1.0, "mw", "kw")
    if approx(r3, 1000.0, 0.01) == 0
        print("FAIL power mw->kw: got=" + str(r3) + " want=1000.0")
        exit(1)

    // KAT 4: 1000 w -> 1 kw
    let r4 = power_convert(1000.0, "w", "kw")
    if approx(r4, 1.0, 0.01) == 0
        print("FAIL power w->kw: got=" + str(r4) + " want=1.0")
        exit(1)

    // KAT 5: round-trip hp -> w -> hp
    let hp_in = 5.0
    let as_w = power_convert(hp_in, "hp", "w")
    let back = power_convert(as_w, "w", "hp")
    if approx(back, hp_in, 0.001) == 0
        print("FAIL power round-trip hp: got=" + str(back) + " want=" + str(hp_in))
        exit(1)

    // KAT 6: round-trip btuh -> w -> btuh
    let btuh_in = 1000.0
    let as_w2 = power_convert(btuh_in, "btuh", "w")
    let back2 = power_convert(as_w2, "w", "btuh")
    if approx(back2, btuh_in, 0.01) == 0
        print("FAIL power round-trip btuh: got=" + str(back2) + " want=" + str(btuh_in))
        exit(1)

    // KAT 7: power_factor("kw") == 1000.0
    let f1 = power_factor("kw")
    if approx(f1, 1000.0, 0.01) == 0
        print("FAIL power factor kw: got=" + str(f1))
        exit(1)

    // KAT 8: power_is_supported("hp") == 1
    let s1 = power_is_supported("hp")
    if s1 != 1
        print("FAIL power is_supported hp: got=" + str(s1))
        exit(1)

    // KAT 9: power_is_supported("xyz") == 0
    let s2 = power_is_supported("xyz")
    if s2 != 0
        print("FAIL power is_supported unknown: got=" + str(s2))
        exit(1)

    // KAT 10: kw_to_w convenience fn
    let cw = kw_to_w(3.0)
    if approx(cw, 3000.0, 0.01) == 0
        print("FAIL kw_to_w: got=" + str(cw))
        exit(1)

    print("PASS _power_test")
