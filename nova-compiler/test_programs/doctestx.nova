// doctestx -- executable documentation examples. Write checks right next to the code as
// `// doctest: <expr> => <expected>` comments; doctest_extract pulls them out and
// doctest_gen synthesises a runnable NOVA program (the original source + a main that
// assert_eq's each example), which the normal toolchain compiles and runs. So docs that
// lie fail the build. Pure-NOVA string tooling -- no new compiler machinery.

fn _trim(s)
    let a = 0
    while a < len(s) and (s[a] == " " or s[a] == chr(9))
        a = a + 1
    let b = len(s)
    while b > a and (s[b - 1] == " " or s[b - 1] == chr(9) or s[b - 1] == chr(13))
        b = b - 1
    return slice(s, a, b)

// extract [[expr, expected], ...] from `// doctest: <expr> => <expected>` lines
fn doctest_extract(source)
    let pairs = []
    let marker = "// doctest:"
    for line in split(source, chr(10))
        let mi = find(line, marker)
        if mi >= 0
            let body = _trim(slice(line, mi + len(marker), len(line)))
            let arrow = find(body, " => ")
            if arrow >= 0
                let expr = _trim(slice(body, 0, arrow))
                let expected = _trim(slice(body, arrow + 4, len(body)))
                push(pairs, [expr, expected])
    return pairs

// synthesise a runnable test program: the source under test + a main asserting each pair
fn doctest_gen(source, pairs)
    let nl = chr(10)
    let out = source + nl + nl + "fn main()" + nl
    for p in pairs
        out = out + "    assert_eq(" + p[0] + ", " + p[1] + ")" + nl
    out = out + "    print(" + chr(34) + "doctests passed" + chr(34) + ")" + nl
    return out

// convenience: extract + generate in one call
fn doctest_build(source)
    return doctest_gen(source, doctest_extract(source))

fn _has(s, sub)
    if find(s, sub) >= 0
        return 1
    return 0

fn main()
    let nl = chr(10)
    let src = "fn add(a, b)" + nl + "    return a + b" + nl + "// doctest: add(2, 3) => 5" + nl + "// doctest: add(10, 20) => 30" + nl + "fn dbl(x)" + nl + "    return x * 2" + nl + "// doctest: dbl(21) => 42"

    let pairs = doctest_extract(src)
    assert_eq(len(pairs), 3)
    assert_eq(pairs[0][0], "add(2, 3)")
    assert_eq(pairs[0][1], "5")
    assert_eq(pairs[1][0], "add(10, 20)")
    assert_eq(pairs[1][1], "30")
    assert_eq(pairs[2][0], "dbl(21)")
    assert_eq(pairs[2][1], "42")

    let prog = doctest_build(src)
    // the generated program contains the original source AND the synthesised asserts
    assert_eq(_has(prog, "fn add(a, b)"), 1)
    assert_eq(_has(prog, "assert_eq(add(2, 3), 5)"), 1)
    assert_eq(_has(prog, "assert_eq(dbl(21), 42)"), 1)
    assert_eq(_has(prog, "fn main()"), 1)

    // a source with no doctests yields a main with just the success print
    let pairs2 = doctest_extract("fn noop()" + nl + "    return 0")
    assert_eq(len(pairs2), 0)

    print("doctestx passed")
