import std/net/ntppkt

fn main()
    // ── Vector 1: byte-exact encode of a known NTP client request ────────────
    // ntp_encode({"li":0,"vn":4,"mode":3,"stratum":0,"poll":6,"precision":0xEC,
    //             "root_delay":0,"root_dispersion":0,"reference_id":0,
    //             "tx_sec":0xE3C1E5C0,"tx_frac":0})
    //
    // byte0 = (li<<6)|(vn<<3)|mode = (0<<6)|(4<<3)|3 = 0|32|3 = 35 = 0x23
    // byte1 = 0 (stratum)
    // byte2 = 6 (poll)
    // byte3 = 0xEC (precision raw)
    // bytes 4-15  = all zeros (root_delay, root_dispersion, reference_id)
    // bytes 16-39 = all zeros (ref/org/rx timestamps absent, default 0)
    // bytes 40-43 = E3 C1 E5 C0 (tx_sec = 0xE3C1E5C0 BE)
    // bytes 44-47 = 00 00 00 00 (tx_frac = 0)
    // Total: 48 bytes

    let h1 = {"li": 0, "vn": 4, "mode": 3, "stratum": 0, "poll": 6, "precision": 0xEC, "root_delay": 0, "root_dispersion": 0, "reference_id": 0, "tx_sec": 0xE3C1E5C0, "tx_frac": 0}
    let enc1 = ntp_encode(h1)

    // ── Check 1: length == 48 ────────────────────────────────────────────────
    let got_len = bytes_len(enc1)
    if got_len != 48
        print("FAIL ntppkt encode-len: got "+str(got_len)+" want 48")
        exit(1)

    // ── Check 2: byte0 == 0x23 ───────────────────────────────────────────────
    let got_b0 = bytes_get(enc1, 0)
    if got_b0 != 0x23
        print("FAIL ntppkt byte0 flags: got "+str(got_b0)+" want 35")
        exit(1)

    // ── Check 3: byte1 == 0 (stratum) ────────────────────────────────────────
    let got_b1 = bytes_get(enc1, 1)
    if got_b1 != 0
        print("FAIL ntppkt byte1 stratum: got "+str(got_b1)+" want 0")
        exit(1)

    // ── Check 4: byte2 == 6 (poll) ───────────────────────────────────────────
    let got_b2 = bytes_get(enc1, 2)
    if got_b2 != 6
        print("FAIL ntppkt byte2 poll: got "+str(got_b2)+" want 6")
        exit(1)

    // ── Check 5: byte3 == 0xEC (precision raw) ───────────────────────────────
    let got_b3 = bytes_get(enc1, 3)
    if got_b3 != 0xEC
        print("FAIL ntppkt byte3 precision: got "+str(got_b3)+" want 236")
        exit(1)

    // ── Check 6: u32 at offset 40 == 0xE3C1E5C0 (tx_sec) ────────────────────
    // Bytes 40-43: E3 C1 E5 C0
    let tx_b0 = bytes_get(enc1, 40)
    let tx_b1 = bytes_get(enc1, 41)
    let tx_b2 = bytes_get(enc1, 42)
    let tx_b3 = bytes_get(enc1, 43)
    if tx_b0 != 0xE3
        print("FAIL ntppkt tx_sec byte40: got "+str(tx_b0)+" want 227")
        exit(1)
    if tx_b1 != 0xC1
        print("FAIL ntppkt tx_sec byte41: got "+str(tx_b1)+" want 193")
        exit(1)
    if tx_b2 != 0xE5
        print("FAIL ntppkt tx_sec byte42: got "+str(tx_b2)+" want 229")
        exit(1)
    if tx_b3 != 0xC0
        print("FAIL ntppkt tx_sec byte43: got "+str(tx_b3)+" want 192")
        exit(1)

    // Reconstruct u32 and check against 0xE3C1E5C0
    let got_tx_sec = ((tx_b0 << 24) | (tx_b1 << 16) | (tx_b2 << 8) | tx_b3) & 0xFFFFFFFF
    if got_tx_sec != 0xE3C1E5C0
        print("FAIL ntppkt tx_sec u32: got "+str(got_tx_sec)+" want 3821864384")
        exit(1)

    // ── Check 7: tx_frac bytes 44-47 == all zeros ────────────────────────────
    let txf_b0 = bytes_get(enc1, 44)
    let txf_b1 = bytes_get(enc1, 45)
    let txf_b2 = bytes_get(enc1, 46)
    let txf_b3 = bytes_get(enc1, 47)
    if txf_b0 != 0
        print("FAIL ntppkt tx_frac byte44: got "+str(txf_b0)+" want 0")
        exit(1)
    if txf_b1 != 0
        print("FAIL ntppkt tx_frac byte45: got "+str(txf_b1)+" want 0")
        exit(1)
    if txf_b2 != 0
        print("FAIL ntppkt tx_frac byte46: got "+str(txf_b2)+" want 0")
        exit(1)
    if txf_b3 != 0
        print("FAIL ntppkt tx_frac byte47: got "+str(txf_b3)+" want 0")
        exit(1)

    // ── Check 8: bytes 4-39 are all zero (default fields) ────────────────────
    let chk_i = 4
    while chk_i < 40
        let bv = bytes_get(enc1, chk_i)
        if bv != 0
            print("FAIL ntppkt zero-range byte "+str(chk_i)+": got "+str(bv)+" want 0")
            exit(1)
        chk_i = chk_i + 1

    // ── Vector 2: encode -> decode round-trip ─────────────────────────────────
    let dec1 = ntp_decode(enc1)

    if contains(dec1, "li") == 0
        print("FAIL ntppkt decode: missing li key")
        exit(1)

    // li == 0
    let got_li = dec1["li"]
    if got_li != 0
        print("FAIL ntppkt decode li: got "+str(got_li)+" want 0")
        exit(1)

    // vn == 4
    let got_vn = dec1["vn"]
    if got_vn != 4
        print("FAIL ntppkt decode vn: got "+str(got_vn)+" want 4")
        exit(1)

    // mode == 3
    let got_mode = dec1["mode"]
    if got_mode != 3
        print("FAIL ntppkt decode mode: got "+str(got_mode)+" want 3")
        exit(1)

    // stratum == 0
    let got_stratum = dec1["stratum"]
    if got_stratum != 0
        print("FAIL ntppkt decode stratum: got "+str(got_stratum)+" want 0")
        exit(1)

    // poll == 6
    let got_poll = dec1["poll"]
    if got_poll != 6
        print("FAIL ntppkt decode poll: got "+str(got_poll)+" want 6")
        exit(1)

    // precision == 0xEC (236)
    let got_prec = dec1["precision"]
    if got_prec != 0xEC
        print("FAIL ntppkt decode precision: got "+str(got_prec)+" want 236")
        exit(1)

    // root_delay == 0
    let got_rd = dec1["root_delay"]
    if got_rd != 0
        print("FAIL ntppkt decode root_delay: got "+str(got_rd)+" want 0")
        exit(1)

    // root_dispersion == 0
    let got_rdisp = dec1["root_dispersion"]
    if got_rdisp != 0
        print("FAIL ntppkt decode root_dispersion: got "+str(got_rdisp)+" want 0")
        exit(1)

    // reference_id == 0
    let got_refid = dec1["reference_id"]
    if got_refid != 0
        print("FAIL ntppkt decode reference_id: got "+str(got_refid)+" want 0")
        exit(1)

    // tx_sec == 0xE3C1E5C0
    let got_tx_sec2 = dec1["tx_sec"]
    if got_tx_sec2 != 0xE3C1E5C0
        print("FAIL ntppkt decode tx_sec: got "+str(got_tx_sec2)+" want 3821864384")
        exit(1)

    // tx_frac == 0
    let got_tx_frac = dec1["tx_frac"]
    if got_tx_frac != 0
        print("FAIL ntppkt decode tx_frac: got "+str(got_tx_frac)+" want 0")
        exit(1)

    // ── Vector 3: server response with all timestamps set ────────────────────
    // Simulate a real NTP server reply: li=0, vn=4, mode=4 (server), stratum=2
    // ref_sec=0xE3C1E000, org=tx from client, rx/tx slightly later
    let h2 = {"li": 0, "vn": 4, "mode": 4, "stratum": 2, "poll": 6, "precision": 0xEC, "root_delay": 0x00000020, "root_dispersion": 0x00000010, "reference_id": 0xC0A80001, "ref_sec": 0xE3C1E000, "ref_frac": 0, "org_sec": 0xE3C1E5C0, "org_frac": 0, "rx_sec": 0xE3C1E5C1, "rx_frac": 0x80000000, "tx_sec": 0xE3C1E5C1, "tx_frac": 0xC0000000}
    let enc2 = ntp_encode(h2)

    let got_len2 = bytes_len(enc2)
    if got_len2 != 48
        print("FAIL ntppkt server encode-len: got "+str(got_len2)+" want 48")
        exit(1)

    // byte0 = (0<<6)|(4<<3)|4 = 0|32|4 = 36 = 0x24
    let got_b0_2 = bytes_get(enc2, 0)
    if got_b0_2 != 0x24
        print("FAIL ntppkt server byte0: got "+str(got_b0_2)+" want 36")
        exit(1)

    // stratum == 2
    let got_s2 = bytes_get(enc2, 1)
    if got_s2 != 2
        print("FAIL ntppkt server stratum: got "+str(got_s2)+" want 2")
        exit(1)

    // Decode the server packet
    let dec2 = ntp_decode(enc2)
    let got_li2 = dec2["li"]
    if got_li2 != 0
        print("FAIL ntppkt server decode li: got "+str(got_li2)+" want 0")
        exit(1)
    let got_vn2 = dec2["vn"]
    if got_vn2 != 4
        print("FAIL ntppkt server decode vn: got "+str(got_vn2)+" want 4")
        exit(1)
    let got_mode2 = dec2["mode"]
    if got_mode2 != 4
        print("FAIL ntppkt server decode mode: got "+str(got_mode2)+" want 4")
        exit(1)
    let got_stratum2 = dec2["stratum"]
    if got_stratum2 != 2
        print("FAIL ntppkt server decode stratum: got "+str(got_stratum2)+" want 2")
        exit(1)
    let got_refid2 = dec2["reference_id"]
    if got_refid2 != 0xC0A80001
        print("FAIL ntppkt server decode reference_id: got "+str(got_refid2)+" want 3232235521")
        exit(1)
    let got_org2 = dec2["org_sec"]
    if got_org2 != 0xE3C1E5C0
        print("FAIL ntppkt server decode org_sec: got "+str(got_org2)+" want 3821864384")
        exit(1)
    let got_rx2 = dec2["rx_sec"]
    if got_rx2 != 0xE3C1E5C1
        print("FAIL ntppkt server decode rx_sec: got "+str(got_rx2)+" want 3821864385")
        exit(1)
    let got_rx_frac2 = dec2["rx_frac"]
    if got_rx_frac2 != 0x80000000
        print("FAIL ntppkt server decode rx_frac: got "+str(got_rx_frac2)+" want 2147483648")
        exit(1)
    let got_tx_frac2 = dec2["tx_frac"]
    if got_tx_frac2 != 0xC0000000
        print("FAIL ntppkt server decode tx_frac: got "+str(got_tx_frac2)+" want 3221225472")
        exit(1)
    let got_rd2 = dec2["root_delay"]
    if got_rd2 != 0x00000020
        print("FAIL ntppkt server decode root_delay: got "+str(got_rd2)+" want 32")
        exit(1)

    // ── Vector 4: short input returns empty dict ──────────────────────────────
    let short_b = bytes(20)
    let dec_short = ntp_decode(short_b)
    if contains(dec_short, "li")
        print("FAIL ntppkt short-decode: expected empty dict but got li key")
        exit(1)

    // ── Vector 5: zero-length input returns empty dict ────────────────────────
    let zero_b = bytes(0)
    let dec_zero = ntp_decode(zero_b)
    if contains(dec_zero, "mode")
        print("FAIL ntppkt zero-decode: expected empty dict but got mode key")
        exit(1)

    // ── Vector 6: exactly 47 bytes returns empty dict ─────────────────────────
    let b47 = bytes(47)
    let dec47 = ntp_decode(b47)
    if contains(dec47, "vn")
        print("FAIL ntppkt 47byte-decode: expected empty dict but got vn key")
        exit(1)

    // ── Vector 7: broadcast mode (mode=5, li=3 leap-alarm) ───────────────────
    let h3 = {"li": 3, "vn": 4, "mode": 5, "stratum": 1, "poll": 10, "precision": 0xF0, "root_delay": 0, "root_dispersion": 0, "reference_id": 0x47505300, "tx_sec": 0xE3C1FFFF, "tx_frac": 0x00010000}
    let enc3 = ntp_encode(h3)
    // byte0 = (3<<6)|(4<<3)|5 = 0xC0|0x20|0x05 = 0xE5
    let got_b0_3 = bytes_get(enc3, 0)
    if got_b0_3 != 0xE5
        print("FAIL ntppkt broadcast byte0: got "+str(got_b0_3)+" want 229")
        exit(1)
    let dec3 = ntp_decode(enc3)
    let got_li3 = dec3["li"]
    if got_li3 != 3
        print("FAIL ntppkt broadcast decode li: got "+str(got_li3)+" want 3")
        exit(1)
    let got_mode3 = dec3["mode"]
    if got_mode3 != 5
        print("FAIL ntppkt broadcast decode mode: got "+str(got_mode3)+" want 5")
        exit(1)
    let got_refid3 = dec3["reference_id"]
    if got_refid3 != 0x47505300
        print("FAIL ntppkt broadcast decode reference_id: got "+str(got_refid3)+" want 1196573440")
        exit(1)
    let got_tx3 = dec3["tx_sec"]
    if got_tx3 != 0xE3C1FFFF
        print("FAIL ntppkt broadcast decode tx_sec: got "+str(got_tx3)+" want 3821932543")
        exit(1)

    print("PASS _ntppkt_test")
