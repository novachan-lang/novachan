// KAT: std/data/rss_parse
import std/data/rss_parse

fn cki(label, got, want)
    if got != want
        print("FAIL rss_parse " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL rss_parse " + label + ": got=[" + got + "] want=[" + want + "]")
        exit(1)

// ── Test 1: minimal KAT from spec ───────────────────────────────────────────
let xml1 = "<rss><channel><title>My Feed</title><link>http://x</link><item><title>A</title><link>http://x/a</link></item><item><title>B</title></item></channel></rss>"
let feed1 = rss_parse(xml1)

cks("title",           feed1["title"], "My Feed")
cks("link",            feed1["link"],  "http://x")
let items1 = feed1["items"]
cki("item_count",      len(items1), 2)
let it0 = items1[0]
let it1 = items1[1]
cks("item0_title",     it0["title"], "A")
cks("item0_link",      it0["link"],  "http://x/a")
cks("item1_title",     it1["title"], "B")
cks("item1_link",      it1["link"],  "")

// ── Test 2: channel description + item fields ────────────────────────────────
let xml2 = "<rss><channel><title>T</title><link>L</link><description>D</description><item><title>I1</title><link>IL1</link><description>ID1</description><pubDate>Mon, 01 Jan 2024</pubDate><guid>g1</guid></item></channel></rss>"
let feed2 = rss_parse(xml2)
cks("desc",            feed2["description"], "D")
let items2 = feed2["items"]
cki("item2_count",     len(items2), 1)
let it2 = items2[0]
cks("item2_title",     it2["title"],       "I1")
cks("item2_link",      it2["link"],        "IL1")
cks("item2_desc",      it2["description"], "ID1")
cks("item2_pubdate",   it2["pubDate"],     "Mon, 01 Jan 2024")
cks("item2_guid",      it2["guid"],        "g1")

// ── Test 3: empty feed (no items) ───────────────────────────────────────────
let xml3 = "<rss><channel><title>Empty</title><link>http://e</link></channel></rss>"
let feed3 = rss_parse(xml3)
cks("empty_title",     feed3["title"], "Empty")
let items3 = feed3["items"]
cki("empty_count",     len(items3), 0)

// ── Test 4: multiple items with LF whitespace ────────────────────────────────
let lf = chr(10)
let xml4 = "<rss><channel>" + lf + "<title>Multi</title>" + lf + "<item><title>X</title></item>" + lf + "<item><title>Y</title></item>" + lf + "<item><title>Z</title></item>" + lf + "</channel></rss>"
let feed4 = rss_parse(xml4)
let items4 = feed4["items"]
cki("multi_count",     len(items4), 3)
cks("multi_0",         items4[0]["title"], "X")
cks("multi_1",         items4[1]["title"], "Y")
cks("multi_2",         items4[2]["title"], "Z")

print("PASS _rss_parse_test")
