import std/collections/suffixarray

fn cki(got, expected, label)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(got, expected, label)
    if got != expected
        print("FAIL " + label + ": got " + got + " expected " + expected)
        exit(1)

fn main()
    // --- KAT 1: sa_build("banana") == [5,3,1,0,4,2] ---
    let s = "banana"
    let sa = suffixarray.sa_build(s)
    cki(len(sa), 6, "sa len==6")
    cki(sa[0], 5, "sa[0]==5 (suffix 'a')")
    cki(sa[1], 3, "sa[1]==3 (suffix 'ana')")
    cki(sa[2], 1, "sa[2]==1 (suffix 'anana')")
    cki(sa[3], 0, "sa[3]==0 (suffix 'banana')")
    cki(sa[4], 4, "sa[4]==4 (suffix 'na')")
    cki(sa[5], 2, "sa[5]==2 (suffix 'nana')")

    // --- KAT 2: sa_contains ---
    cki(suffixarray.sa_contains(s, sa, "ana"), 1, "contains 'ana'==true")
    cki(suffixarray.sa_contains(s, sa, "xyz"), 0, "contains 'xyz'==false")
    cki(suffixarray.sa_contains(s, sa, "banana"), 1, "contains 'banana'==true")
    cki(suffixarray.sa_contains(s, sa, "nan"), 1, "contains 'nan'==true")
    cki(suffixarray.sa_contains(s, sa, "bananaz"), 0, "contains 'bananaz'==false")

    // --- KAT 3: sa_count ---
    cki(suffixarray.sa_count(s, sa, "ana"), 2, "count 'ana'==2")
    cki(suffixarray.sa_count(s, sa, "a"), 3, "count 'a'==3")
    cki(suffixarray.sa_count(s, sa, "na"), 2, "count 'na'==2")
    cki(suffixarray.sa_count(s, sa, "xyz"), 0, "count 'xyz'==0")
    cki(suffixarray.sa_count(s, sa, "banana"), 1, "count 'banana'==1")
    cki(suffixarray.sa_count(s, sa, "n"), 2, "count 'n'==2")

    // --- KAT 4: sa_search ---
    let pos_na = suffixarray.sa_search(s, sa, "na")
    cki(len(pos_na), 2, "search 'na' len==2")
    cki(pos_na[0], 2, "search 'na'[0]==2")
    cki(pos_na[1], 4, "search 'na'[1]==4")

    let pos_ana = suffixarray.sa_search(s, sa, "ana")
    cki(len(pos_ana), 2, "search 'ana' len==2")
    cki(pos_ana[0], 1, "search 'ana'[0]==1")
    cki(pos_ana[1], 3, "search 'ana'[1]==3")

    let pos_xyz = suffixarray.sa_search(s, sa, "xyz")
    cki(len(pos_xyz), 0, "search 'xyz' len==0")

    // --- KAT 5: single-character string ---
    let s2 = "a"
    let sa2 = suffixarray.sa_build(s2)
    cki(len(sa2), 1, "single char sa len==1")
    cki(sa2[0], 0, "single char sa[0]==0")
    cki(suffixarray.sa_contains(s2, sa2, "a"), 1, "single 'a' contains 'a'==true")
    cki(suffixarray.sa_contains(s2, sa2, "b"), 0, "single 'a' contains 'b'==false")
    cki(suffixarray.sa_count(s2, sa2, "a"), 1, "single 'a' count 'a'==1")

    // --- KAT 6: repeated characters "aaa" ---
    let s3 = "aaa"
    let sa3 = suffixarray.sa_build(s3)
    // suffixes: "aaa"(0) "aa"(1) "a"(2) -> sorted: "a"(2) "aa"(1) "aaa"(0)
    cki(sa3[0], 2, "aaa sa3[0]==2")
    cki(sa3[1], 1, "aaa sa3[1]==1")
    cki(sa3[2], 0, "aaa sa3[2]==0")
    cki(suffixarray.sa_count(s3, sa3, "a"), 3, "aaa count 'a'==3")
    cki(suffixarray.sa_count(s3, sa3, "aa"), 2, "aaa count 'aa'==2")
    cki(suffixarray.sa_count(s3, sa3, "aaa"), 1, "aaa count 'aaa'==1")
    cki(suffixarray.sa_count(s3, sa3, "aaaa"), 0, "aaa count 'aaaa'==0")
    let pos_a3 = suffixarray.sa_search(s3, sa3, "a")
    cki(len(pos_a3), 3, "aaa search 'a' len==3")
    cki(pos_a3[0], 0, "aaa search 'a'[0]==0")
    cki(pos_a3[1], 1, "aaa search 'a'[1]==1")
    cki(pos_a3[2], 2, "aaa search 'a'[2]==2")

    print("_suffixarray_test passed")
