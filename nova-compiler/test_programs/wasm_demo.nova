// Simple pure-compute NOVA program for WASM compilation.
// No I/O, no threads, no allocations — just math.

fn fib(n: int) -> int
    if n < 2
        return n
    return fib(n - 1) + fib(n - 2)

fn factorial(n: int) -> int
    let r = 1
    let i = 2
    while i <= n
        r = r * i
        i = i + 1
    r

fn sum_squares(n: int) -> int
    let total = 0
    let i = 1
    while i <= n
        total = total + i * i
        i = i + 1
    total

fn main()
    let a = fib(15)
    let b = factorial(10)
    let c = sum_squares(100)
    return a + b + c
