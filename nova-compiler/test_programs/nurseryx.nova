// nurseryx — structured concurrency: a nursery (task group / trio-style scope) whose
// children CANNOT outlive it. nursery_go spawns a child; nursery_join blocks until
// EVERY child spawned into the nursery has completed, returning their results. So a
// child started inside a scope is guaranteed joined before that scope proceeds — no
// orphaned tasks, no leak. Built over spawn + channel + the atomic counter.

fn nursery_new()
    return [channel(), atomic_new(0)]        // [result_channel, child_count]

fn nursery_go(nur, task)                      // task: fn() -> result
    atomic_add(nur[1], 1)
    let ch = nur[0]
    spawn fn()
        send(ch, task())
    return 0

fn nursery_join(nur)                          // blocks until all children done
    let n = atomic_get(nur[1])
    let results = []
    let i = 0
    while i < n
        push(results, receive(nur[0]))
        i = i + 1
    return results

fn main()
    let nur = nursery_new()
    nursery_go(nur, fn() 10)
    nursery_go(nur, fn() 20)
    nursery_go(nur, fn() 30)
    let rs = nursery_join(nur)
    assert_eq(len(rs), 3)
    // all three children completed before join returned (order-independent sum)
    let total = 0
    for r in rs
        total = total + r
    assert_eq(total, 60)

    // a second, independent nursery with more children
    let nur2 = nursery_new()
    let k = 0
    while k < 8
        nursery_go(nur2, fn() 1)
        k = k + 1
    let rs2 = nursery_join(nur2)
    assert_eq(len(rs2), 8)

    print("nursery passed")
