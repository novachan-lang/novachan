// KAT for std/framing/crc_frame — CRC-trailer framing.
import std/framing/crc_frame

// ── Private list equality helper ──────────────────────────────────────────────

fn list_eq(a: list, b: list) -> int
    if len(a) != len(b)
        return 0
    let i = 0
    let ok = 1
    while i < len(a) and ok == 1
        if a[i] != b[i]
            ok = 0
        i = i + 1
    ok

// ── Assert helpers ─────────────────────────────────────────────────────────────

fn ck_list(label: string, got: list, want: list)
    let eq = list_eq(got, want)
    if eq != 1
        let gs = "["
        let i = 0
        while i < len(got)
            if i > 0
                gs = gs + ","
            gs = gs + str(got[i])
            i = i + 1
        gs = gs + "]"
        let wi = "["
        let j = 0
        while j < len(want)
            if j > 0
                wi = wi + ","
            wi = wi + str(want[j])
            j = j + 1
        wi = wi + "]"
        print("FAIL crc_frame " + label + ": got=" + gs + " want=" + wi)
        exit(1)

fn ck_int(label: string, got: int, want: int)
    if got != want
        print("FAIL crc_frame " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ── KAT: CRC-16/CCITT-FALSE check value ───────────────────────────────────────

fn main()
    // "123456789" as byte list
    let b9 = []
    push(b9, 0x31)
    push(b9, 0x32)
    push(b9, 0x33)
    push(b9, 0x34)
    push(b9, 0x35)
    push(b9, 0x36)
    push(b9, 0x37)
    push(b9, 0x38)
    push(b9, 0x39)

    // CRC-16/CCITT-FALSE check value = 0x29B1 = 10673
    ck_int("crc16-check-value", cf_crc16(b9), 10673)

    // CRC-16 of empty = init = 0xFFFF = 65535
    ck_int("crc16-empty", cf_crc16([]), 65535)

    // ── KAT: CRC-32 check value ───────────────────────────────────────────────
    // CRC-32 of "123456789" = 0xCBF43926 = 3421780262
    ck_int("crc32-check-value", cf_crc32(b9), 3421780262)

    // CRC-32 of empty: init ^ xorout = 0xFFFFFFFF ^ 0xFFFFFFFF = 0
    ck_int("crc32-empty", cf_crc32([]), 0)

    // ── ROUND-TRIP CRC-16 ─────────────────────────────────────────────────────

    // RT 1: [1,2,3]
    let rt1 = []
    push(rt1, 1)
    push(rt1, 2)
    push(rt1, 3)
    ck_int("verify16-rt1", cf_verify16(cf_frame16(rt1)), 1)

    // RT 2: empty
    ck_int("verify16-empty", cf_verify16(cf_frame16([])), 1)

    // RT 3: deframe round-trip
    let rt3 = []
    push(rt3, 9)
    push(rt3, 8)
    push(rt3, 7)
    let rt3_frame = cf_frame16(rt3)
    let rt3_dec = cf_deframe16(rt3_frame)
    let rt3_data = rt3_dec["data"]
    let rt3_ok = rt3_dec["crc_ok"]
    ck_list("deframe16-data", rt3_data, rt3)
    ck_int("deframe16-ok", rt3_ok, 1)

    // RT 4: tamper — flip a byte, should fail
    let tamper4 = []
    push(tamper4, 1)
    push(tamper4, 2)
    push(tamper4, 3)
    let tamper4_f = cf_frame16(tamper4)
    // flip first byte
    tamper4_f[0] = tamper4_f[0] ^ 0xFF
    ck_int("verify16-tamper", cf_verify16(tamper4_f), 0)

    // RT 5: all-zero bytes
    let rt5 = []
    push(rt5, 0)
    push(rt5, 0)
    push(rt5, 0)
    ck_int("verify16-zeros", cf_verify16(cf_frame16(rt5)), 1)

    // RT 6: byte with value 0xFF
    let rt6 = []
    push(rt6, 0xFF)
    push(rt6, 0xFF)
    ck_int("verify16-0xFF", cf_verify16(cf_frame16(rt6)), 1)

    // ── cf_strip_crc16 ────────────────────────────────────────────────────────
    let strip_in = []
    push(strip_in, 5)
    push(strip_in, 6)
    push(strip_in, 7)
    push(strip_in, 8)
    let strip_out = cf_strip_crc16(strip_in)
    let strip_want = []
    push(strip_want, 5)
    push(strip_want, 6)
    ck_list("strip-crc16", strip_out, strip_want)

    // ── ROUND-TRIP CRC-32 ─────────────────────────────────────────────────────

    // RT7: [1,2,3]
    let rt7 = []
    push(rt7, 1)
    push(rt7, 2)
    push(rt7, 3)
    ck_int("verify32-rt7", cf_verify32(cf_frame32(rt7)), 1)

    // RT8: empty
    ck_int("verify32-empty", cf_verify32(cf_frame32([])), 1)

    // RT9: "123456789" frame round-trips
    ck_int("verify32-rt9", cf_verify32(cf_frame32(b9)), 1)

    // RT10: tamper CRC-32
    let tamper10 = []
    push(tamper10, 10)
    push(tamper10, 20)
    push(tamper10, 30)
    let tamper10_f = cf_frame32(tamper10)
    tamper10_f[0] = tamper10_f[0] ^ 0xFF
    ck_int("verify32-tamper", cf_verify32(tamper10_f), 0)

    // RT11: big-endian CRC16 bytes are correct
    // cf_crc16([1,2,3]) and check the trailer bytes in cf_frame16([1,2,3])
    let f16 = cf_frame16(rt1)
    let n16 = len(f16)
    let hi = f16[n16 - 2]
    let lo = f16[n16 - 1]
    let crc16_manual = ((hi << 8) | lo) & 0xFFFF
    ck_int("frame16-crc-bytes", crc16_manual, cf_crc16(rt1))

    // RT12: big-endian CRC32 bytes are correct
    let f32 = cf_frame32(rt7)
    let n32 = len(f32)
    let c3 = f32[n32 - 4]
    let c2 = f32[n32 - 3]
    let c1 = f32[n32 - 2]
    let c0 = f32[n32 - 1]
    let crc32_manual = ((c3 << 24) | (c2 << 16) | (c1 << 8) | c0) & 0xFFFFFFFF
    ck_int("frame32-crc-bytes", crc32_manual, cf_crc32(rt7))

    print("PASS _crc_frame_test")
