import std/util/ranges

// Helper: compare two int lists for equality.
fn rg_lists_equal(a: list, b: list) -> bool
    let na = len(a)
    let nb = len(b)
    if na != nb
        return 0
    let i = 0
    while i < na
        let av = a[i]
        let bv = b[i]
        if av != bv
            return 0
        let i = i + 1
    1

// KAT 1: rg_to_list(rg_new(0,5,1)) == [0,1,2,3,4]
let r1 = rg_new(0, 5, 1)
let l1 = rg_to_list(r1)
let exp1 = []
exp1.push(0)
exp1.push(1)
exp1.push(2)
exp1.push(3)
exp1.push(4)
if rg_lists_equal(l1, exp1) == 0
    print("FAIL KAT1: rg_to_list(rg_new(0,5,1))")
    exit(1)

// KAT 2: rg_to_list(rg_new(0,10,2)) == [0,2,4,6,8]
let r2 = rg_new(0, 10, 2)
let l2 = rg_to_list(r2)
let exp2 = []
exp2.push(0)
exp2.push(2)
exp2.push(4)
exp2.push(6)
exp2.push(8)
if rg_lists_equal(l2, exp2) == 0
    print("FAIL KAT2: rg_to_list(rg_new(0,10,2))")
    exit(1)

// KAT 3: rg_to_list(rg_new(5,0,-1)) == [5,4,3,2,1]
let r3 = rg_new(5, 0, -1)
let l3 = rg_to_list(r3)
let exp3 = []
exp3.push(5)
exp3.push(4)
exp3.push(3)
exp3.push(2)
exp3.push(1)
if rg_lists_equal(l3, exp3) == 0
    print("FAIL KAT3: rg_to_list(rg_new(5,0,-1))")
    exit(1)

// KAT 4: rg_len(rg_new(0,10,2)) == 5
let r4 = rg_new(0, 10, 2)
let len4 = rg_len(r4)
if len4 != 5
    print("FAIL KAT4: rg_len expected 5 got")
    print(str(len4))
    exit(1)

// KAT 5: rg_contains(rg_new(0,10,2), 4) == true
let r5 = rg_new(0, 10, 2)
let c5 = rg_contains(r5, 4)
if c5 == 0
    print("FAIL KAT5: rg_contains(rg_new(0,10,2), 4) should be true")
    exit(1)

// KAT 6: rg_contains(rg_new(0,10,2), 5) == false
let r6 = rg_new(0, 10, 2)
let c6 = rg_contains(r6, 5)
if c6 != 0
    print("FAIL KAT6: rg_contains(rg_new(0,10,2), 5) should be false")
    exit(1)

// KAT 7: rg_get(rg_new(0,10,2), 2) == 4
let r7 = rg_new(0, 10, 2)
let g7 = rg_get(r7, 2)
if g7 != 4
    print("FAIL KAT7: rg_get expected 4 got")
    print(str(g7))
    exit(1)

// KAT 8: rg_sum(rg_new(1,5,1)) == 10
let r8 = rg_new(1, 5, 1)
let s8 = rg_sum(r8)
if s8 != 10
    print("FAIL KAT8: rg_sum expected 10 got")
    print(str(s8))
    exit(1)

print("_ranges_test passed")
