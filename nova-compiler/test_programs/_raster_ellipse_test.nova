import std/raster/raster_ellipse

// _ck_b: check boolean; print FAIL + exit(1) on mismatch.
fn _ck_b(label, got, want)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL raster_ellipse " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

// _ck_i: check integer equality.
fn _ck_i(label, got, want)
    if got != want
        print("FAIL raster_ellipse " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// _ck_list4: check [a,b,c,d] list.
fn _ck_list4(label, got, a, b, c, d)
    if len(got) != 4
        print("FAIL raster_ellipse " + label + ": len=" + str(len(got)) + " want 4")
        exit(1)
    if got[0] != a
        print("FAIL raster_ellipse " + label + "[0]: got=" + str(got[0]) + " want=" + str(a))
        exit(1)
    if got[1] != b
        print("FAIL raster_ellipse " + label + "[1]: got=" + str(got[1]) + " want=" + str(b))
        exit(1)
    if got[2] != c
        print("FAIL raster_ellipse " + label + "[2]: got=" + str(got[2]) + " want=" + str(c))
        exit(1)
    if got[3] != d
        print("FAIL raster_ellipse " + label + "[3]: got=" + str(got[3]) + " want=" + str(d))
        exit(1)

// _pt_in_list: true if [px,py] is present in the list of [x,y] pairs.
fn _pt_in_list(pts, px, py)
    let n = len(pts)
    let i = 0
    let found = false
    while i < n
        let p = pts[i]
        if p[0] == px
            if p[1] == py
                found = true
        i = i + 1
    found

// _ck_pt: assert that point (px,py) exists in pts.
fn _ck_pt(label, pts, px, py)
    let ok = _pt_in_list(pts, px, py)
    if not ok
        print("FAIL raster_ellipse " + label + ": point [" + str(px) + "," + str(py) + "] not found (list has " + str(len(pts)) + " pts)")
        exit(1)

fn main()
    // --- rel_ellipse(0,0,2,1): axis extremes ---
    // Expected: [2,0],[-2,0],[0,1],[0,-1] plus intermediate points
    let e21 = rel_ellipse(0, 0, 2, 1)
    _ck_pt("e21_right",  e21, 2, 0)
    _ck_pt("e21_left",   e21, -2, 0)
    _ck_pt("e21_top",    e21, 0, 1)
    _ck_pt("e21_bottom", e21, 0, -1)
    // Should have 8 points (verified by debug run)
    _ck_i("e21_count", len(e21), 8)

    // --- rel_contains(0,0,2,1,...) ---
    // (1,0): 1*1 + 4*0 = 1 <= 4 -> true
    _ck_b("contains_1_0", rel_contains(0, 0, 2, 1, 1, 0), true)
    // (0,2): 1*0 + 4*4 = 16 > 4 -> false
    _ck_b("contains_0_2_false", rel_contains(0, 0, 2, 1, 0, 2), false)
    // (2,0): 1*4 + 4*0 = 4 <= 4 -> true (on boundary)
    _ck_b("contains_2_0_on", rel_contains(0, 0, 2, 1, 2, 0), true)
    // (0,1): 1*0 + 4*1 = 4 <= 4 -> true (on boundary)
    _ck_b("contains_0_1_on", rel_contains(0, 0, 2, 1, 0, 1), true)
    // Center always inside
    _ck_b("contains_center", rel_contains(0, 0, 2, 1, 0, 0), true)

    // --- rel_ellipse(0,0,1,1): unit circle has the 4 axis points ---
    let e11 = rel_ellipse(0, 0, 1, 1)
    _ck_pt("e11_px", e11, 1, 0)
    _ck_pt("e11_nx", e11, -1, 0)
    _ck_pt("e11_py", e11, 0, 1)
    _ck_pt("e11_ny", e11, 0, -1)
    _ck_i("e11_count", len(e11), 4)

    // --- rel_ellipse(0,0,3,0): degenerate b=0, horizontal segment ---
    // Should produce 7 points: x=-3,-2,-1,0,1,2,3 at y=0
    let e30 = rel_ellipse(0, 0, 3, 0)
    _ck_i("e30_count", len(e30), 7)
    _ck_pt("e30_right", e30, 3, 0)
    _ck_pt("e30_left",  e30, -3, 0)
    _ck_pt("e30_ctr",   e30, 0, 0)

    // --- rel_ellipse(0,0,0,2): degenerate a=0, vertical segment ---
    let e02 = rel_ellipse(0, 0, 0, 2)
    _ck_i("e02_count", len(e02), 5)
    _ck_pt("e02_top",    e02, 0, 2)
    _ck_pt("e02_bottom", e02, 0, -2)
    _ck_pt("e02_ctr",    e02, 0, 0)

    // --- rel_bbox(5,5,3,2) == [2,3,8,7] ---
    let bb = rel_bbox(5, 5, 3, 2)
    _ck_list4("bbox_5_5_3_2", bb, 2, 3, 8, 7)

    // --- rel_bbox(0,0,4,4) ---
    let bb2 = rel_bbox(0, 0, 4, 4)
    _ck_list4("bbox_0_0_4_4", bb2, -4, -4, 4, 4)

    // --- rel_point_count ---
    _ck_i("pc_1_1", rel_point_count(1, 1), 4)
    _ck_i("pc_2_1", rel_point_count(2, 1), 8)

    // --- rel_filled(0,0,2,1): all points with 1*x^2 + 4*y^2 <= 4 ---
    // y=0: x in [-2..2] all satisfy 1*x^2 <= 4 -> x=-2,-1,0,1,2 (5 pts)
    // y=1 or y=-1: 1*x^2 + 4 <= 4 -> x^2<=0 -> only x=0 (2 pts)
    // total = 7
    let f21 = rel_filled(0, 0, 2, 1)
    _ck_i("filled_2_1_count", len(f21), 7)
    _ck_pt("filled_2_1_right", f21, 2, 0)
    _ck_pt("filled_2_1_left",  f21, -2, 0)
    _ck_pt("filled_2_1_top",   f21, 0, 1)
    _ck_pt("filled_2_1_bot",   f21, 0, -1)
    _ck_pt("filled_2_1_ctr",   f21, 0, 0)

    // All filled points must satisfy rel_contains
    let j = 0
    while j < len(f21)
        let pt = f21[j]
        let inside = rel_contains(0, 0, 2, 1, pt[0], pt[1])
        _ck_b("filled_2_1_inside_" + str(j), inside, true)
        j = j + 1

    // --- rel_ellipse_to_surface: draw (0,0,2,1) on a 7x7 surface at center (3,3) ---
    let sur = {}
    let spx = []
    let si = 0
    while si < 49
        push(spx, 0)
        si = si + 1
    sur["w"] = 7
    sur["h"] = 7
    sur["px"] = spx
    rel_ellipse_to_surface(sur, 3, 3, 2, 1, 1)
    let spxr = sur["px"]
    // Axis extremes in surface coords: (5,3),(1,3),(3,4),(3,2)
    _ck_i("sur_right", spxr[3 * 7 + 5], 1)
    _ck_i("sur_left",  spxr[3 * 7 + 1], 1)
    _ck_i("sur_top",   spxr[2 * 7 + 3], 1)
    _ck_i("sur_bot",   spxr[4 * 7 + 3], 1)
    // Center unfilled
    _ck_i("sur_center_unfilled", spxr[3 * 7 + 3], 0)

    print("PASS _raster_ellipse_test")
