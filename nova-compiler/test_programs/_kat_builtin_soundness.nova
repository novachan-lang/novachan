// Soundness KAT for the builtin region.
// Every case below CRASHED or corrupted memory before the soundness sweep.
// The bar here is not "returns the right answer" — it is "does not fault and
// returns a sane degenerate value". A run that prints a final line at all is
// itself most of the proof.
let pass = 0
let fail = 0

// ---- wrong-type handles reaching container builtins -------------------------
// Before: the int elements 1/2/3 were cast to NovaList* and ->size was read,
// dereferencing 0x1/0x2/0x3. Guaranteed segfault.
let fm = list_flatten_map([1, 2, 3])
if len(fm) == 3
    pass = pass + 1
else
    print("FAIL list_flatten_map scalars: expected 3 got " + str(len(fm)))
    fail = fail + 1

let fm2 = list_flatten_map([])
if len(fm2) == 0
    pass = pass + 1
else
    print("FAIL list_flatten_map empty")
    fail = fail + 1

// genuine nested case must still work
let fm3 = list_flatten_map([[1, 2], [3]])
if len(fm3) == 3
    pass = pass + 1
else
    print("FAIL list_flatten_map nested: expected 3 got " + str(len(fm3)))
    fail = fail + 1

// ---- negative length parameters --------------------------------------------
// Before: dots = -5, then buf[-5] = 0 — heap underflow write at an
// attacker-controlled negative offset.
let te = str_truncate_ellipsis("hello world", -5)
if len(te) >= 0
    pass = pass + 1
else
    print("FAIL str_truncate_ellipsis negative")
    fail = fail + 1

let te2 = str_truncate_ellipsis("hello world", 8)
if len(te2) == 8
    pass = pass + 1
else
    print("FAIL str_truncate_ellipsis normal: expected len 8 got " + str(len(te2)))
    fail = fail + 1

let te3 = str_truncate_ellipsis("hi", 100)
if te3 == "hi"
    pass = pass + 1
else
    print("FAIL str_truncate_ellipsis shorter-than-max")
    fail = fail + 1

// ---- size-arithmetic overflow ----------------------------------------------
// Before: slen * n overflowed size_t, malloc under-allocated, the fill loop
// wrote past the end. These must now return a degenerate value, not corrupt.
let sm = str_mul("ab", 3)
if sm == "ababab"
    pass = pass + 1
else
    print("FAIL str_mul normal: expected 'ababab' got '" + sm + "'")
    fail = fail + 1

let sm2 = str_mul("ab", 0)
if sm2 == ""
    pass = pass + 1
else
    print("FAIL str_mul zero")
    fail = fail + 1

let re1 = str_repeat_each("abc", 2)
if re1 == "aabbcc"
    pass = pass + 1
else
    print("FAIL str_repeat_each: expected 'aabbcc' got '" + re1 + "'")
    fail = fail + 1

// ---- str_replace_n: buf_cap was sized from max_n, not from real matches -----
let rn = str_replace_n("aaa", "a", "bb", 2)
if rn == "bbbba"
    pass = pass + 1
else
    print("FAIL str_replace_n: expected 'bbbba' got '" + rn + "'")
    fail = fail + 1

let rn2 = str_replace_n("hello", "z", "y", 1000000)
if rn2 == "hello"
    pass = pass + 1
else
    print("FAIL str_replace_n no-match large max_n: got '" + rn2 + "'")
    fail = fail + 1

// ---- tab expansion ----------------------------------------------------------
let tb = str_tab_to_spaces("a\tb", 4)
if len(tb) == 6
    pass = pass + 1
else
    print("FAIL str_tab_to_spaces: expected len 6 got " + str(len(tb)))
    fail = fail + 1

// ---- padding: s and fill were both dereferenced with no null check ----------
let pb = str_pad_both("ab", 6, "-")
if len(pb) == 6
    pass = pass + 1
else
    print("FAIL str_pad_both: expected len 6 got " + str(len(pb)))
    fail = fail + 1

let pb2 = str_pad_both("abcdef", 3, "-")
if pb2 == "abcdef"
    pass = pass + 1
else
    print("FAIL str_pad_both width<=len")
    fail = fail + 1

// ---- INT64_MIN negation (UB) ------------------------------------------------
// -INT64_MIN is UB and wraps back to INT64_MIN, so the "make positive" step
// silently failed and the gcd loop invariant was corrupted.
let g1 = math_gcd(12, 18)
if g1 == 6
    pass = pass + 1
else
    print("FAIL math_gcd(12,18): expected 6 got " + str(g1))
    fail = fail + 1

let g2 = math_gcd(-12, 18)
if g2 == 6
    pass = pass + 1
else
    print("FAIL math_gcd(-12,18): expected 6 got " + str(g2))
    fail = fail + 1

let l1 = math_lcm(4, 6)
if l1 == 12
    pass = pass + 1
else
    print("FAIL math_lcm(4,6): expected 12 got " + str(l1))
    fail = fail + 1

let mb = list_max_by_abs([3, -7, 5])
if mb == 1
    pass = pass + 1
else
    print("FAIL list_max_by_abs: expected index 1 got " + str(mb))
    fail = fail + 1

let mb2 = list_max_by_abs([])
if mb2 == -1
    pass = pass + 1
else
    print("FAIL list_max_by_abs empty: expected -1 got " + str(mb2))
    fail = fail + 1

// ---- dict builtins on an empty dict (dense-layout fix, commit 08b03d37) -----
let ed = {}
if len(dict_values_flat(ed)) == 0
    pass = pass + 1
else
    print("FAIL dict_values_flat empty")
    fail = fail + 1

if dict_to_query_string(ed) == ""
    pass = pass + 1
else
    print("FAIL dict_to_query_string empty")
    fail = fail + 1

print("Builtin soundness KAT: " + str(pass) + " passed, " + str(fail) + " failed")
