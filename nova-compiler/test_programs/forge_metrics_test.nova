// Forge T8.1: the RED metrics registry (single-owner actor). Observations aggregate under the route
// PATTERN; in-flight gauge tracks start/finish; /metrics Prometheus text exposes them. Socketless.
import forge_obs

fn main()
    let reg = metrics_registry()
    metric_observe(reg, "GET", "/users/:id", 200, 5)
    metric_observe(reg, "GET", "/users/:id", 200, 7)   // same pattern -> aggregates
    metric_observe(reg, "POST", "/users", 201, 10)
    metric_inflight(reg, 1)
    metric_inflight(reg, -1)
    let snap = metrics_snapshot(reg)
    let entries = snap["entries"]
    let getc = 0
    let getlat = 0
    let i = 0
    while i < len(entries)
        let e = entries[i]
        if e["key"] == "GET /users/:id"
            getc = e["count"]
            getlat = e["totlat"]
        i = i + 1
    if getc != 2 or getlat != 12 or snap["inflight"] != 0
        print("FAIL: GET count=" + str(getc) + " totlat=" + str(getlat) + " inflight=" + str(snap["inflight"]))
        exit(1)
    let prom = metrics_prometheus(reg)
    let q = chr(34)
    let lb = chr(123)
    let rb = chr(125)
    // status-code breakdown: both GETs were status 200 -> ONE counter line, value 2 (FIX 1 -- status
    // used to be silently dropped, so this label triple could never have appeared in the old text).
    let target = "http_requests_total" + lb + "method=" + q + "GET" + q + ",route=" + q + "/users/:id" + q + ",status=" + q + "200" + q + rb + " 2"
    if find(prom, target) < 0
        print("FAIL: prometheus exposition missing the status-labeled GET counter line:\n" + prom)
        exit(1)
    // latency summary: sum=12 (5+7), count=2 -- mean derivable as 6ms (FIX 2 -- totlat was already
    // accumulated internally but ZERO latency data was ever exported before this fix).
    let sum_line = "http_request_duration_ms_sum" + lb + "method=" + q + "GET" + q + ",route=" + q + "/users/:id" + q + rb + " 12"
    let count_line = "http_request_duration_ms_count" + lb + "method=" + q + "GET" + q + ",route=" + q + "/users/:id" + q + rb + " 2"
    if find(prom, sum_line) < 0
        print("FAIL: prometheus exposition missing the duration SUM line:\n" + prom)
        exit(1)
    if find(prom, count_line) < 0
        print("FAIL: prometheus exposition missing the duration COUNT line:\n" + prom)
        exit(1)
    // full histogram (stretch goal): a 5ms + a 7ms observation -> le="5" cumulative count is 1 (only
    // the 5ms sample qualifies) but le="10" cumulative count is 2 (both 5ms and 7ms qualify) -- proves
    // the buckets are genuinely cumulative-by-value, not just a copy of the total count.
    let bucket5_line = "http_request_duration_ms_bucket" + lb + "method=" + q + "GET" + q + ",route=" + q + "/users/:id" + q + ",le=" + q + "5" + q + rb + " 1"
    let bucket10_line = "http_request_duration_ms_bucket" + lb + "method=" + q + "GET" + q + ",route=" + q + "/users/:id" + q + ",le=" + q + "10" + q + rb + " 2"
    let bucket_inf_line = "http_request_duration_ms_bucket" + lb + "method=" + q + "GET" + q + ",route=" + q + "/users/:id" + q + ",le=" + q + "+Inf" + q + rb + " 2"
    if find(prom, bucket5_line) < 0
        print("FAIL: histogram le=\"5\" bucket should be 1 (only the 5ms sample):\n" + prom)
        exit(1)
    if find(prom, bucket10_line) < 0
        print("FAIL: histogram le=\"10\" bucket should be 2 (5ms and 7ms both qualify):\n" + prom)
        exit(1)
    if find(prom, bucket_inf_line) < 0
        print("FAIL: histogram le=\"+Inf\" bucket should equal total count 2:\n" + prom)
        exit(1)
    print("PASS forge_metrics (2 GETs aggregate under /users/:id -> count 2 lat 12; inflight 0; status+duration+histogram exported)")
