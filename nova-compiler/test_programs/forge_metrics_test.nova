// Forge T8.1: the RED metrics registry (single-owner actor). Observations aggregate under the route
// PATTERN; in-flight gauge tracks start/finish; /metrics Prometheus text exposes them. Socketless.
import forge_obs

fn main()
    let reg = metrics_registry()
    metric_observe(reg, "GET", "/users/:id", 200, 5)
    metric_observe(reg, "GET", "/users/:id", 200, 7)   // same pattern -> aggregates
    metric_observe(reg, "POST", "/users", 201, 10)
    metric_inflight(reg, 1)
    metric_inflight(reg, -1)
    let snap = metrics_snapshot(reg)
    let entries = snap["entries"]
    let getc = 0
    let getlat = 0
    let i = 0
    while i < len(entries)
        let e = entries[i]
        if e["key"] == "GET /users/:id"
            getc = e["count"]
            getlat = e["totlat"]
        i = i + 1
    if getc != 2 or getlat != 12 or snap["inflight"] != 0
        print("FAIL: GET count=" + str(getc) + " totlat=" + str(getlat) + " inflight=" + str(snap["inflight"]))
        exit(1)
    let prom = metrics_prometheus(reg)
    let target = "http_requests_total" + chr(123) + "endpoint=" + chr(34) + "GET /users/:id" + chr(34) + chr(125) + " 2"
    if find(prom, target) < 0
        print("FAIL: prometheus exposition missing the GET line:\n" + prom)
        exit(1)
    print("PASS forge_metrics (2 GETs aggregate under /users/:id -> count 2 lat 12; inflight 0; /metrics text ok)")
