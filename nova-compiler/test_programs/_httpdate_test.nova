// KAT for std/net/httpdate — RFC 1123 HTTP-date formatting.
import std/net/httpdate

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": '" + got + "' != '" + want + "'")
        exit(1)

fn main()
    // KAT 1: canonical RFC 2616 example
    // epoch 784111777 = Sun, 06 Nov 1994 08:49:37 UTC
    cks("format-canonical", hd_format(784111777), "Sun, 06 Nov 1994 08:49:37 GMT")

    // KAT 2: epoch 0 = 1970-01-01 00:00:00 (Thursday)
    cks("format-epoch0", hd_format(0), "Thu, 01 Jan 1970 00:00:00 GMT")

    // KAT 3: weekday names
    cks("wday-Sun", hd_weekday_name(0), "Sun")
    cks("wday-Mon", hd_weekday_name(1), "Mon")
    cks("wday-Tue", hd_weekday_name(2), "Tue")
    cks("wday-Wed", hd_weekday_name(3), "Wed")
    cks("wday-Thu", hd_weekday_name(4), "Thu")
    cks("wday-Fri", hd_weekday_name(5), "Fri")
    cks("wday-Sat", hd_weekday_name(6), "Sat")

    // KAT 4: month names
    cks("mon-Jan", hd_month_name(1), "Jan")
    cks("mon-Feb", hd_month_name(2), "Feb")
    cks("mon-Mar", hd_month_name(3), "Mar")
    cks("mon-Apr", hd_month_name(4), "Apr")
    cks("mon-May", hd_month_name(5), "May")
    cks("mon-Jun", hd_month_name(6), "Jun")
    cks("mon-Jul", hd_month_name(7), "Jul")
    cks("mon-Aug", hd_month_name(8), "Aug")
    cks("mon-Sep", hd_month_name(9), "Sep")
    cks("mon-Oct", hd_month_name(10), "Oct")
    cks("mon-Nov", hd_month_name(11), "Nov")
    cks("mon-Dec", hd_month_name(12), "Dec")

    // KAT 5: out-of-range returns empty string
    cks("wday-oor", hd_weekday_name(7), "")
    cks("mon-oor", hd_month_name(0), "")
    cks("mon-oor2", hd_month_name(13), "")

    // KAT 6: a second full-format spot-check
    // epoch 1000000000 = Sat, 09 Sep 2001 01:46:40 UTC
    // days = floor(1000000000/86400) = 11574, rem = 1000000000 - 11574*86400 = 52000 - 4000 = ?
    // 11574*86400 = 999993600, rem = 1000000000-999993600 = 6400
    // h=floor(6400/3600)=1, rem2=6400-3600=2800, m=floor(2800/60)=46, s=2800-2760=40
    // weekday: (11574+4)%7 = 11578%7 = 11578/7=1654r0 -> wd=0 -> Sun?
    // 11578 = 7*1654 = 11578, yes wd=0=Sun
    // Actually: 7*1654=11578, so 11578%7=0 -> Sun
    // But 2001-09-09 was a Sunday! Correct.
    cks("format-2001", hd_format(1000000000), "Sun, 09 Sep 2001 01:46:40 GMT")

    print("_httpdate_test passed")
