// #16 sub-cycle 3: HTTP client Location resolution must follow RFC-3986 §5 relative-reference
// resolution, not just absolute + "/rooted". Covers path-relative ("page2"), dot-segments
// ("../x", "./x"), protocol-relative ("//host"), query/fragment preservation, and port.
import forge_http_client

fn chk(got: string, want: string, label: string) -> bool
    if got != want
        print("  FAIL " + label + ": got '" + got + "' want '" + want + "'")
        return false
    true

fn main() -> int
    let ok = true
    if not chk(resolve_location("http://h/a/b", "http://other/x"), "http://other/x", "absolute")
        ok = false
    if not chk(resolve_location("http://h/a/b", "/x/y"), "http://h/x/y", "root-relative")
        ok = false
    if not chk(resolve_location("http://h/dir/page1", "page2"), "http://h/dir/page2", "path-relative")
        ok = false
    if not chk(resolve_location("http://h/dir/sub/page1", "../page2"), "http://h/dir/page2", "dot-dot")
        ok = false
    if not chk(resolve_location("http://h/dir/page1", "./page2"), "http://h/dir/page2", "dot-slash")
        ok = false
    if not chk(resolve_location("http://h/dir/", "sub/page"), "http://h/dir/sub/page", "trailing-slash base")
        ok = false
    if not chk(resolve_location("https://h/a", "//other/x"), "https://other/x", "protocol-relative")
        ok = false
    if not chk(resolve_location("http://h/dir/page", "?q=1"), "http://h/dir/page?q=1", "query-only ref")
        ok = false
    if not chk(resolve_location("http://h/dir/page1", "page2?x=1"), "http://h/dir/page2?x=1", "relative+query")
        ok = false
    if not chk(resolve_location("http://h:8080/a/b", "/c"), "http://h:8080/c", "port preserved")
        ok = false
    if not chk(resolve_location("http://h/a/b/c", "../../x"), "http://h/x", "double dot-dot")
        ok = false
    if ok
        print("HTTP-REDIRECT-RESOLVE KAT PASS")
        return 0
    print("HTTP-REDIRECT-RESOLVE KAT FAIL")
    1
