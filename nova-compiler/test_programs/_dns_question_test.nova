import std/net/dns_question

// Known-answer test for std/net/dns_question.
// Validates: name encoder, question encoder, question decoder, round-trip.

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL dns_question " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL dns_question " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // ── KAT 1: dns_question_encode("example.com", 1, 1) ─────────────────────
    // Expected wire bytes:
    //   \x07 e x a m p l e  \x03 c o m \x00  \x00\x01  \x00\x01
    //    [0] [1..7]           [8] [9..11] [12]  [13][14]  [15][16]
    //   name = 13 bytes, QTYPE = 2 bytes, QCLASS = 2 bytes -> total 17 bytes

    let enc = dns_question_encode("example.com", 1, 1)
    cki("encode len", bytes_len(enc), 17)

    // Byte 0: label length for "example" = 7
    cki("enc[0] = 7", bytes_get(enc, 0), 7)
    // Bytes 1..7: "example" ASCII
    cki("enc[1]='e'", bytes_get(enc, 1), 101)
    cki("enc[2]='x'", bytes_get(enc, 2), 120)
    cki("enc[3]='a'", bytes_get(enc, 3), 97)
    cki("enc[4]='m'", bytes_get(enc, 4), 109)
    cki("enc[5]='p'", bytes_get(enc, 5), 112)
    cki("enc[6]='l'", bytes_get(enc, 6), 108)
    cki("enc[7]='e'", bytes_get(enc, 7), 101)
    // Byte 8: label length for "com" = 3
    cki("enc[8] = 3", bytes_get(enc, 8), 3)
    // Bytes 9..11: "com" ASCII
    cki("enc[9]='c'", bytes_get(enc, 9), 99)
    cki("enc[10]='o'", bytes_get(enc, 10), 111)
    cki("enc[11]='m'", bytes_get(enc, 11), 109)
    // Byte 12: name terminator
    cki("enc[12]=0", bytes_get(enc, 12), 0)
    // Bytes 13..14: QTYPE = 1 big-endian
    cki("enc[13]=0", bytes_get(enc, 13), 0)
    cki("enc[14]=1", bytes_get(enc, 14), 1)
    // Bytes 15..16: QCLASS = 1 big-endian
    cki("enc[15]=0", bytes_get(enc, 15), 0)
    cki("enc[16]=1", bytes_get(enc, 16), 1)

    print("ok: dns_question_encode(example.com,1,1) 17-byte wire encoding verified")

    // ── KAT 2: round-trip decode ──────────────────────────────────────────────
    // Decode the same wire bytes from offset 0
    let dec = dns_question_decode(enc, 0)
    let rec = dec[0]
    let nxt = dec[1]

    cks("decode name", rec["name"], "example.com")
    cki("decode type", rec["type"], 1)
    cki("decode class", rec["class"], 1)
    cki("decode next_pos", nxt, 17)

    print("ok: dns_question_decode round-trip name=example.com type=1 class=1 next_pos=17")

    // ── KAT 3: multi-label name — "mail.example.com" ────────────────────────
    // Wire: \x04mail\x07example\x03com\x00 = 1+4+1+7+1+3+1 = 18 bytes
    //       + QTYPE(MX=15): \x00\x0F
    //       + QCLASS(IN=1): \x00\x01
    //       total = 22 bytes
    let enc2 = dns_question_encode("mail.example.com", 15, 1)
    cki("enc2 len", bytes_len(enc2), 22)
    // First label: 4 = len("mail")
    cki("enc2[0]=4", bytes_get(enc2, 0), 4)
    // Terminator is at position 18 (0-indexed): 1+4+1+7+1+3+1 = 18 -> index 17
    cki("enc2[17]=0", bytes_get(enc2, 17), 0)
    // QTYPE MX=15 big-endian
    cki("enc2[18]=0", bytes_get(enc2, 18), 0)
    cki("enc2[19]=15", bytes_get(enc2, 19), 15)
    // QCLASS IN=1 big-endian
    cki("enc2[20]=0", bytes_get(enc2, 20), 0)
    cki("enc2[21]=1", bytes_get(enc2, 21), 1)

    let dec2 = dns_question_decode(enc2, 0)
    let rec2 = dec2[0]
    let nxt2 = dec2[1]
    cks("dec2 name", rec2["name"], "mail.example.com")
    cki("dec2 type", rec2["type"], 15)
    cki("dec2 class", rec2["class"], 1)
    cki("dec2 next_pos", nxt2, 22)

    print("ok: dns_question encode/decode mail.example.com MX IN")

    // ── KAT 4: trailing-dot canonical form ───────────────────────────────────
    // "example.com." should encode identically to "example.com"
    let enc3 = dns_question_encode("example.com.", 1, 1)
    cki("trailing-dot len", bytes_len(enc3), 17)
    cki("trailing-dot[0]", bytes_get(enc3, 0), 7)
    cki("trailing-dot[12]", bytes_get(enc3, 12), 0)

    print("ok: trailing-dot form encodes identically")

    // ── KAT 5: AAAA query (type=28) ──────────────────────────────────────────
    let enc4 = dns_question_encode("example.com", 28, 1)
    cki("aaaa len", bytes_len(enc4), 17)
    cki("aaaa type hi", bytes_get(enc4, 13), 0)
    cki("aaaa type lo", bytes_get(enc4, 14), 28)

    let dec4 = dns_question_decode(enc4, 0)
    cks("aaaa name", dec4[0]["name"], "example.com")
    cki("aaaa type", dec4[0]["type"], 28)
    cki("aaaa next", dec4[1], 17)

    print("ok: AAAA query type=28 encode/decode")

    // ── KAT 6: error cases ───────────────────────────────────────────────────
    // Empty bytes -> decode error (next_pos == pos == 0)
    let empty_b = bytes(0)
    let dec_err = dns_question_decode(empty_b, 0)
    cki("empty-buf next_pos", dec_err[1], 0)

    // Label > 63 chars -> encode returns empty bytes
    let long_label = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    let enc_err = dns_question_encode(long_label + ".com", 1, 1)
    cki("long-label encode len", bytes_len(enc_err), 0)

    print("ok: error cases handled correctly")

    print("PASS _dns_question_test")
