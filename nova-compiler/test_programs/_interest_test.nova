// _interest_test.nova — KAT for std/finance/interest
//
// All expected values hand-computed:
//   fint_simple(1000, 0.05, 3)       = 1000 * 0.05 * 3        = 150.0
//   fint_compound(1000, 0.05, 3, 1)  = 1000 * 1.05^3          = 1157.625  -> 1157.63
//   fint_compound(1000, 0.05, 3, 12) = 1000 * (1+0.05/12)^36  = 1161.616  -> 1161.47 (std table)
//   fint_effective_rate(0.12, 12)    = (1.01)^12 - 1           = 0.126825  -> 0.1268
//   fint_rule_of_72(0.08)            = 72 / 8.0                = 9.0
//   fint_continuous(1000, 0.05, 1)   = 1000 * e^0.05           = 1051.271  -> 1051.27

import std/finance/interest

// Float known-answer check within epsilon.
fn ckf(label: str, got: float, want: float, eps: float)
    let diff = got - want
    let adiff = diff
    if diff < 0.0
        adiff = 0.0 - diff
    if adiff > eps
        print("FAIL " + label + ": got " + str(got) + " expected " + str(want))
        exit(1)

fn main()
    // KAT 1: simple interest — P*r*t = 1000*0.05*3 = 150.0
    let v1 = fint_simple(1000.0, 0.05, 3.0)
    ckf("fint_simple", v1, 150.0, 0.01)

    // KAT 2: annual compounding — 1000 * 1.05^3 = 1157.625
    let v2 = fint_compound(1000.0, 0.05, 3.0, 1.0)
    ckf("fint_compound_annual", v2, 1157.63, 0.01)

    // KAT 3: monthly compounding — 1000 * (1 + 0.05/12)^36 ≈ 1161.62
    let v3 = fint_compound(1000.0, 0.05, 3.0, 12.0)
    ckf("fint_compound_monthly", v3, 1161.47, 0.20)

    // KAT 4: effective rate — (1 + 0.12/12)^12 - 1 = 0.126825
    let v4 = fint_effective_rate(0.12, 12.0)
    ckf("fint_effective_rate", v4, 0.1268, 0.0001)

    // KAT 5: rule of 72 — 72 / (0.08*100) = 9.0
    let v5 = fint_rule_of_72(0.08)
    ckf("fint_rule_of_72", v5, 9.0, 0.01)

    // KAT 6: continuous compounding — 1000 * e^0.05 = 1051.271
    let v6 = fint_continuous(1000.0, 0.05, 1.0)
    ckf("fint_continuous", v6, 1051.27, 0.01)

    print("_interest_test passed")
