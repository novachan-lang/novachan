// Reflection Phase 2b: @derive(Clone) and @derive(Hash). Clone returns a fresh
// equal struct (verified via @derive(Eq)); nested derived fields deep-clone/-hash.
// Hash is structural + deterministic (equal structs hash equal); we assert
// reproducibility/idempotence, not magic values.

@derive(Eq)
@derive(Clone)
@derive(Hash)
type Point
    x: int
    y: int

@derive(Eq)
@derive(Clone)
@derive(Hash)
type Box
    p: Point
    w: int

fn main()
    let p = Point { x: 3, y: 7 }

    // clone -> equal struct, fields preserved
    let c = p.clone()
    assert_eq(c.eq(p), true)
    assert_eq(c.x, 3)
    assert_eq(c.y, 7)

    // hash: idempotent + reproducible across equal structs
    let p2 = Point { x: 3, y: 7 }
    assert_eq(p.hash(), p.hash())
    assert_eq(p.hash(), p2.hash())

    // nested clone is deep + still equal
    let b = Box { p: Point { x: 1, y: 2 }, w: 5 }
    let bc = b.clone()
    assert_eq(bc.eq(b), true)
    assert_eq(bc.p.x, 1)
    assert_eq(bc.w, 5)

    // nested hash reproducible
    let b2 = Box { p: Point { x: 1, y: 2 }, w: 5 }
    assert_eq(b.hash(), b2.hash())

    print("derive_clone_hash_test passed")
