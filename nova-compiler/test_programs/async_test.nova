// Async/await test suite

fn expensive_add(a: int, b: int) -> int
    a + b

fn slow_compute(n: int) -> int
    let i = 0
    let acc = 0
    while i < n
        acc = acc + i
        i = i + 1
    acc

fn test_basic_async()
    print("--- basic async/await ---")
    let f = async(fn() 42)
    let r = await(f)
    print(r)

fn test_multiple_futures()
    print("--- multiple futures ---")
    let f1 = async(fn() 10)
    let f2 = async(fn() 20)
    let f3 = async(fn() 30)
    let r1 = await(f1)
    let r2 = await(f2)
    let r3 = await(f3)
    print(r1 + r2 + r3)

fn test_await_all()
    print("--- await_all ---")
    let futures = []
    push(futures, async(fn() 100))
    push(futures, async(fn() 200))
    push(futures, async(fn() 300))
    let results = await_all(futures)
    print(len(results))
    print(results[0])
    print(results[1])
    print(results[2])

fn test_await_any()
    print("--- await_any ---")
    let futures = []
    push(futures, async(fn() 111))
    push(futures, async(fn() 222))
    push(futures, async(fn() 333))
    let winner = await_any(futures)
    print(len(winner))
    let idx = winner[0]
    let val = winner[1]
    print(idx >= 0)
    print(val == 111 or val == 222 or val == 333)

fn test_compute_parallel()
    print("--- parallel compute ---")
    let f1 = async(fn() slow_compute(1000))
    let f2 = async(fn() slow_compute(2000))
    let r1 = await(f1)
    let r2 = await(f2)
    print(r1)
    print(r2)

fn test_many_tasks()
    print("--- many async tasks ---")
    let futures = []
    let i = 0
    while i < 50
        push(futures, async(fn() i * i))
        i = i + 1
    let results = await_all(futures)
    print(len(results))

fn main()
    test_basic_async()
    test_multiple_futures()
    test_await_all()
    test_await_any()
    test_compute_parallel()
    test_many_tasks()
    print("ALL ASYNC TESTS PASSED")
