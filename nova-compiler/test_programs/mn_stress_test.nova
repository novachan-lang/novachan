// M:N stress: many green tasks (more than carriers) each compute + send a result on a
// shared channel; main collects all and verifies the total. Validates correctness under
// the multi-carrier scheduler (run with NOVA_CARRIERS=N once M:N lands). Deterministic.
fn worker(ch, n)
    let s = 0
    let i = 0
    while i < n
        s = s + i
        i = i + 1
    send(ch, s)

fn main()
    let ch = channel()
    let ntasks = 1000
    let i = 0
    while i < ntasks
        spawn worker(ch, 100)
        i = i + 1
    let total = 0
    let r = 0
    while r < ntasks
        total = total + receive(ch)
        r = r + 1
    assert_eq(total, 4950000)
    print("mn_stress ok: " + str(total))
