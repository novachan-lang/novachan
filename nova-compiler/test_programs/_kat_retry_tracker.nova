import forge_retry_tracker

fn main()
    let r = rt_new(3)
    let a1 = rt_attempt(r, "op1")
    assert(is_ok(a1), "attempt 1 ok")
    assert(unwrap(a1) == 1, "first attempt")

    let a2 = rt_attempt(r, "op1")
    assert(is_ok(a2), "attempt 2 ok")
    assert(unwrap(a2) == 2, "second attempt")

    let a3 = rt_attempt(r, "op1")
    assert(is_ok(a3), "attempt 3 ok")

    let a4 = rt_attempt(r, "op1")
    assert(is_err(a4), "max retries exceeded")
    assert(rt_total_exhausted(r) == 1, "1 exhausted")
    assert(rt_can_retry(r, "op1") == 0, "cant retry")

    let af = rt_attempts_for(r, "op1")
    assert(is_ok(af), "attempts for ok")
    assert(unwrap(af) == 3, "3 attempts")

    assert(rt_can_retry(r, "new_op") == 1, "new op can retry")

    let rst = rt_reset(r, "op1")
    assert(is_ok(rst), "reset ok")
    r = unwrap(rst)
    assert(rt_can_retry(r, "op1") == 1, "can retry after reset")

    print("RETRY-TRACKER KAT PASS")
