import forge_scc

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn main()
    let fails = 0

    // single cycle a->b->c->a : one SCC of 3
    let cyc = [["a", "b"], ["b", "c"], ["c", "a"]]
    fails = fails + expect("cycle_count", str(scc_count(cyc)), "1")
    fails = fails + expect_true("cycle_same", scc_same(cyc, "a", "c"))

    // DAG a->b->c : 3 separate SCCs
    let dag = [["a", "b"], ["b", "c"]]
    fails = fails + expect("dag_count", str(scc_count(dag)), "3")
    fails = fails + expect_true("dag_notsame", scc_same(dag, "a", "c") == false)

    // two cycles joined by a bridge: {a,b} and {c,d}, edge a->c
    let two = [["a", "b"], ["b", "a"], ["c", "d"], ["d", "c"], ["a", "c"]]
    fails = fails + expect("two_count", str(scc_count(two)), "2")
    fails = fails + expect_true("two_ab", scc_same(two, "a", "b"))
    fails = fails + expect_true("two_cd", scc_same(two, "c", "d"))
    fails = fails + expect_true("two_not_ac", scc_same(two, "a", "c") == false)

    // classic Tarjan example: 1->2, 2->3, 3->1 (SCC), 4->5,5->6,6->4 (SCC), 7->6,7->8,8->7,8->9,9->9? simpler
    // 0->1,1->2,2->0 (A), 2->3, 3->4,4->5,5->3 (B): two SCCs {0,1,2} and {3,4,5}
    let big = [["0", "1"], ["1", "2"], ["2", "0"], ["2", "3"], ["3", "4"], ["4", "5"], ["5", "3"]]
    fails = fails + expect("big_count", str(scc_count(big)), "2")
    fails = fails + expect_true("big_A", scc_same(big, "0", "2"))
    fails = fails + expect_true("big_B", scc_same(big, "3", "5"))
    fails = fails + expect_true("big_notmix", scc_same(big, "0", "3") == false)

    // self loop is its own SCC of 1
    let selfl = [["x", "x"]]
    fails = fails + expect("self_count", str(scc_count(selfl)), "1")

    // every node covered exactly once across components (partition)
    let total = 0
    let comps = scc(big)
    let i = 0
    while i < len(comps)
        total = total + len(comps[i])
        i = i + 1
    fails = fails + expect("partition_covers_all", str(total), "6")

    if fails == 0
        print("forge_scc: all passed")
    else
        print("forge_scc: " + str(fails) + " FAILED")
