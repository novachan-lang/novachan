// forge_ws_client_test -- the WebSocket CONSUME client (D7r.4b): forge.ws_connect / ws_client_send /
// ws_client_recv / ws_client_close dial a Forge ws() endpoint, do the RFC 6455 client handshake (random
// Sec-WebSocket-Key, 101 + accept verify), send MASKED text frames, and decode the server's echo -- all
// over the SAME frame codec the server uses. Round-trips two messages, then closes.
import forge

fn _echo(c, m)
    forge.ws_emit_bin(c, m)

fn _server(port: int)
    let a = forge.app()
    forge.ws(a, "/echo", fn(c, m) _echo(c, m))
    forge.serve_req_n(a, port, 1)

fn main()
    let port = 19391
    let p = port
    spawn fn()
        _server(p)
    sleep(300)

    let cc = forge.ws_connect("ws://127.0.0.1:" + str(port) + "/echo")
    assert(is_ok(cc), "ws_connect handshake succeeded")
    let c = unwrap(cc)
    print("PASS: ws_connect (client handshake + 101 Sec-WebSocket-Accept verify)")

    forge.ws_client_send(c, "hello from ws consume")
    let r1 = forge.ws_client_recv(c)
    assert(is_ok(r1), "ws_client_recv returned a frame")
    assert(unwrap(r1) == "hello from ws consume", "echo 1 round-trips (masked client -> server -> decoded) [" + unwrap(r1) + "]")
    print("PASS: ws_client_send/recv round-trip 1")

    forge.ws_client_send(c, "second-message")
    let r2 = forge.ws_client_recv(c)
    assert(is_ok(r2) and unwrap(r2) == "second-message", "echo 2 round-trips (buffer state persists)")
    print("PASS: ws_client_send/recv round-trip 2")

    forge.ws_client_close(c)
    print("forge_ws_client_test passed")
