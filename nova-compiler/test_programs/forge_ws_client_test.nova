// forge_ws_client_test -- the WebSocket CONSUME client's frame DECODE logic, tested DETERMINISTICALLY
// (no socket): ws_client_recv decodes complete server frames straight from its buffer (ws_try_decode
// returns a full frame without touching the socket), so this is race-free. The socket handshake/send
// (ws_connect/ws_client_send) are thin glue over proven primitives (tcp + ws_encode_frame +
// ws_compute_accept); a live loopback round-trip is dev-verifiable via _fdb_one but is excluded from the
// gate because client+server as concurrent green tasks in ONE process is timing-racy under FULLRC (a
// test-harness artifact, not a client-code bug -- NORMAL mode is 100%).
import forge

fn main()
    // Pre-fill the buffer with two complete UNMASKED server frames (text + binary). ws_client_recv decodes
    // frame-by-frame, advancing the buffer -- no socket read (sock is a dummy, never used at status 1).
    let f1 = forge.ws_encode_frame(1, 1, str_to_bytes("hello nova"), [])
    let f2 = forge.ws_encode_frame(1, 2, str_to_bytes("second frame"), [])
    let c = {}
    c["sock"] = 0
    c["buf"] = bytes_concat(f1, f2)
    let r1 = forge.ws_client_recv(c)
    assert(is_ok(r1) and unwrap(r1) == "hello nova", "ws_client_recv decodes text frame 1 [" + unwrap(r1) + "]")
    let r2 = forge.ws_client_recv(c)
    assert(is_ok(r2) and unwrap(r2) == "second frame", "ws_client_recv decodes frame 2 (buffer advanced) [" + unwrap(r2) + "]")
    print("PASS: ws_client_recv decodes consecutive server frames from the buffer")

    // A Close frame (opcode 8) -> err (the caller stops the stream).
    let cc = {}
    cc["sock"] = 0
    cc["buf"] = forge.ws_encode_frame(1, 8, bytes(0), [])
    assert(is_err(forge.ws_client_recv(cc)), "ws_client_recv on a Close frame -> err")
    print("PASS: ws_client_recv surfaces Close as err")

    print("forge_ws_client_test passed")
