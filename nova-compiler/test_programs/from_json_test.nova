// Automatic derive-able deserialization: from_json reconstructs a struct from a
// json-decoded dict with ZERO annotation, the inverse of the automatic to_json.
// Round-trip: struct -> to_json -> string -> json_decode -> from_json -> struct.
// Dispatched by the genius compiler via the let's declared type. Beats Serde's
// #[derive(Deserialize)] — no annotation at all.

type Config
    name: string
    port: int
    ratio: float
    enabled: bool

type Server
    id: int
    cfg: Config

type Member
    name: string
    level: int

type Team
    title: string
    members: list<Member>

fn main()
    // flat struct round-trip (int / float / string / bool fields)
    // json_stringify serializes (auto <T>__to_json); from_json deserializes the string.
    let c = Config("nova", 8080, 2.5, true)
    let s = json_stringify(c)
    let c2: Config = from_json(s)
    assert_eq(c2.name, "nova")
    assert_eq(c2.port, 8080)
    assert_near(c2.ratio, 2.5, 0.0001)
    assert_eq(c2.enabled, true)

    // nested struct round-trip (cfg field recurses via Config__from_json)
    let srv = Server(1, Config("api", 443, 1.5, false))
    let s2 = json_stringify(srv)
    let srv2: Server = from_json(s2)
    assert_eq(srv2.id, 1)
    assert_eq(srv2.cfg.name, "api")
    assert_eq(srv2.cfg.port, 443)
    assert_near(srv2.cfg.ratio, 1.5, 0.0001)
    assert_eq(srv2.cfg.enabled, false)

    // list<struct> round-trip (members maps each element through Member__to_json/from_json)
    let t = Team("core", [Member("ada", 10), Member("alan", 9)])
    let ts = json_stringify(t)
    let t2: Team = from_json(ts)
    assert_eq(t2.title, "core")
    assert_eq(len(t2.members), 2)
    assert_eq(t2.members[0].name, "ada")
    assert_eq(t2.members[0].level, 10)
    assert_eq(t2.members[1].name, "alan")
    assert_eq(t2.members[1].level, 9)

    print("from_json passed")
