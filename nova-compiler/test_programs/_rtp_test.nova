import std/net/rtp

fn main()
    let fails = 0

    // ── Vector 1: RFC 3550 minimal header, byte-exact ──────────────────────────
    // V=2, P=0, X=0, CC=0, M=0, PT=96, seq=1, ts=0, ssrc=0x11223344
    // Expected wire: 80 60 00 01 00 00 00 00 11 22 33 44
    let h1 = {"version": 2, "pt": 96, "seq": 1, "timestamp": 0, "ssrc": 0x11223344}
    let e1 = rtp_encode(h1)
    if bytes_len(e1) != 12
        print("FAIL v1 len: got "+str(bytes_len(e1))+" want 12")
        fails = fails + 1
    else
        print("ok v1 len")

    let want1 = [0x80, 0x60, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x11, 0x22, 0x33, 0x44]
    let i1 = 0
    let v1ok = 1
    while i1 < 12
        if bytes_get(e1, i1) != want1[i1]
            v1ok = 0
        i1 = i1 + 1
    if v1ok == 0
        print("FAIL v1 byte-exact mismatch")
        fails = fails + 1
    else
        print("ok v1 byte-exact 80 60 00 01 00 00 00 00 11 22 33 44")

    // ── Vector 2: marker bit set -> byte1 = 0xE0 for PT 96 ─────────────────────
    let h2 = {"version": 2, "marker": 1, "pt": 96, "seq": 1, "timestamp": 0, "ssrc": 0x11223344}
    let e2 = rtp_encode(h2)
    if bytes_get(e2, 1) != 0xE0
        print("FAIL v2 marker byte1: got "+str(bytes_get(e2, 1))+" want 224")
        fails = fails + 1
    else
        print("ok v2 marker byte1 = 0xE0")
    // byte0 unaffected by marker
    if bytes_get(e2, 0) != 0x80
        print("FAIL v2 byte0: got "+str(bytes_get(e2, 0))+" want 128")
        fails = fails + 1
    else
        print("ok v2 byte0 unchanged")

    // ── Vector 3: 1 CSRC identifier ─────────────────────────────────────────────
    let h3 = {"version": 2, "pt": 0, "seq": 0, "timestamp": 0, "ssrc": 0, "csrc": [0xAABBCCDD]}
    let e3 = rtp_encode(h3)
    if bytes_len(e3) != 16
        print("FAIL v3 len: got "+str(bytes_len(e3))+" want 16")
        fails = fails + 1
    else
        print("ok v3 len 16 (12 + 1 csrc)")
    if bytes_get(e3, 0) != 0x81
        print("FAIL v3 byte0 CC=1: got "+str(bytes_get(e3, 0))+" want 129")
        fails = fails + 1
    else
        print("ok v3 byte0 CC=1")
    let csrc_bytes_ok = bytes_get(e3, 12) == 0xAA and bytes_get(e3, 13) == 0xBB and bytes_get(e3, 14) == 0xCC and bytes_get(e3, 15) == 0xDD
    if csrc_bytes_ok == 0
        print("FAIL v3 csrc bytes mismatch")
        fails = fails + 1
    else
        print("ok v3 csrc bytes AA BB CC DD")
    let d3 = rtp_decode(e3)
    if len(d3["csrc"]) != 1
        print("FAIL v3 decode csrc-count: got "+str(len(d3["csrc"]))+" want 1")
        fails = fails + 1
    else
        print("ok v3 decode csrc-count = 1")
    if d3["csrc"][0] != 0xAABBCCDD
        print("FAIL v3 decode csrc[0]: got "+str(d3["csrc"][0])+" want "+str(0xAABBCCDD))
        fails = fails + 1
    else
        print("ok v3 decode csrc[0] = 0xAABBCCDD")

    // ── Vector 4: extension bit + 1-word extension ──────────────────────────────
    let ext = bytes(0)
    ext = bytes_append(ext, 0xDE)
    ext = bytes_append(ext, 0xAD)
    ext = bytes_append(ext, 0xBE)
    ext = bytes_append(ext, 0xEF)
    let h4 = {"version": 2, "pt": 0, "seq": 0, "timestamp": 0, "ssrc": 0, "ext_profile": 0xABCD, "ext_data": ext}
    let e4 = rtp_encode(h4)
    if bytes_len(e4) != 20
        print("FAIL v4 len: got "+str(bytes_len(e4))+" want 20 (12 hdr + 4 exthdr + 4 extdata)")
        fails = fails + 1
    else
        print("ok v4 len 20")
    if bytes_get(e4, 0) != 0x90
        print("FAIL v4 byte0 X=1: got "+str(bytes_get(e4, 0))+" want 144")
        fails = fails + 1
    else
        print("ok v4 byte0 X=1")
    // extension header: profile 0xABCD (12,13), length-words 0x0001 (14,15)
    let exthdr_ok = bytes_get(e4, 12) == 0xAB and bytes_get(e4, 13) == 0xCD and bytes_get(e4, 14) == 0x00 and bytes_get(e4, 15) == 0x01
    if exthdr_ok == 0
        print("FAIL v4 ext header bytes mismatch")
        fails = fails + 1
    else
        print("ok v4 ext header AB CD 00 01")
    let d4 = rtp_decode(e4)
    if d4["ext"] != 1
        print("FAIL v4 decode ext flag: got "+str(d4["ext"])+" want 1")
        fails = fails + 1
    else
        print("ok v4 decode ext flag = 1")
    if d4["ext_profile"] != 0xABCD
        print("FAIL v4 decode ext_profile: got "+str(d4["ext_profile"])+" want "+str(0xABCD))
        fails = fails + 1
    else
        print("ok v4 decode ext_profile = 0xABCD")
    if bytes_len(d4["ext_data"]) != 4
        print("FAIL v4 decode ext_data len: got "+str(bytes_len(d4["ext_data"]))+" want 4")
        fails = fails + 1
    else
        print("ok v4 decode ext_data len = 4")
    let extdata_ok = bytes_get(d4["ext_data"], 0) == 0xDE and bytes_get(d4["ext_data"], 1) == 0xAD and bytes_get(d4["ext_data"], 2) == 0xBE and bytes_get(d4["ext_data"], 3) == 0xEF
    if extdata_ok == 0
        print("FAIL v4 decode ext_data bytes mismatch")
        fails = fails + 1
    else
        print("ok v4 decode ext_data = DE AD BE EF")

    // ── Vector 5: padded packet round-trips with padding stripped ──────────────
    let payload5 = str_to_bytes("hi")
    let h5 = {"version": 2, "pt": 8, "seq": 42, "timestamp": 9000, "ssrc": 0x01020304, "payload": payload5, "pad": 4}
    let e5 = rtp_encode(h5)
    // total = 12 hdr + 2 payload + 4 pad = 18
    if bytes_len(e5) != 18
        print("FAIL v5 len: got "+str(bytes_len(e5))+" want 18")
        fails = fails + 1
    else
        print("ok v5 len 18")
    // last byte must be the pad count (4)
    if bytes_get(e5, 17) != 4
        print("FAIL v5 last byte pad-count: got "+str(bytes_get(e5, 17))+" want 4")
        fails = fails + 1
    else
        print("ok v5 last byte = pad count 4")
    // padding flag set in byte0
    if (bytes_get(e5, 0) & 0x20) != 0x20
        print("FAIL v5 P-bit not set")
        fails = fails + 1
    else
        print("ok v5 P-bit set")
    let d5 = rtp_decode(e5)
    if d5["padding"] != 1
        print("FAIL v5 decode padding flag: got "+str(d5["padding"])+" want 1")
        fails = fails + 1
    else
        print("ok v5 decode padding flag = 1")
    if d5["pad"] != 4
        print("FAIL v5 decode pad count: got "+str(d5["pad"])+" want 4")
        fails = fails + 1
    else
        print("ok v5 decode pad count = 4")
    if bytes_len(d5["payload"]) != 2
        print("FAIL v5 decode payload len (padding stripped): got "+str(bytes_len(d5["payload"]))+" want 2")
        fails = fails + 1
    else
        print("ok v5 decode payload len 2 (padding stripped)")
    if bytes_to_str(d5["payload"]) != "hi"
        print("FAIL v5 decode payload content: got "+bytes_to_str(d5["payload"])+" want hi")
        fails = fails + 1
    else
        print("ok v5 decode payload = 'hi'")
    if d5["seq"] != 42
        print("FAIL v5 decode seq: got "+str(d5["seq"])+" want 42")
        fails = fails + 1
    else
        print("ok v5 decode seq = 42")
    if d5["timestamp"] != 9000
        print("FAIL v5 decode timestamp: got "+str(d5["timestamp"])+" want 9000")
        fails = fails + 1
    else
        print("ok v5 decode timestamp = 9000")
    if d5["ssrc"] != 0x01020304
        print("FAIL v5 decode ssrc: got "+str(d5["ssrc"])+" want "+str(0x01020304))
        fails = fails + 1
    else
        print("ok v5 decode ssrc = 0x01020304")

    // Minimal padding: pad=1 -> single count byte, no zero fill bytes.
    let h5b = {"payload": str_to_bytes("x"), "pad": 1}
    let e5b = rtp_encode(h5b)
    if bytes_len(e5b) != 14
        print("FAIL v5b len: got "+str(bytes_len(e5b))+" want 14 (12 hdr + 1 payload + 1 pad)")
        fails = fails + 1
    else
        print("ok v5b len 14")
    let d5b = rtp_decode(e5b)
    if bytes_len(d5b["payload"]) != 1
        print("FAIL v5b decode payload len: got "+str(bytes_len(d5b["payload"]))+" want 1")
        fails = fails + 1
    else
        print("ok v5b decode payload len 1 (pad=1 strips only itself)")

    // ── Vector 6: header shorter than 12 bytes -> in-band error, no over-read ──
    let short0 = bytes(0)
    let dshort0 = rtp_decode(short0)
    if contains(dshort0, "ssrc")
        print("FAIL v6 zero-length decode should be empty dict")
        fails = fails + 1
    else
        print("ok v6 zero-length input -> empty dict")

    let short11 = bytes(0)
    let si = 0
    while si < 11
        short11 = bytes_append(short11, 0)
        si = si + 1
    let dshort11 = rtp_decode(short11)
    if contains(dshort11, "ssrc")
        print("FAIL v6 11-byte decode should be empty dict (need 12)")
        fails = fails + 1
    else
        print("ok v6 11-byte input (one short of header) -> empty dict")

    // ── Vector 7: payload with embedded 0x00 survives ───────────────────────────
    let payload7 = bytes(0)
    payload7 = bytes_append(payload7, 0x41)
    payload7 = bytes_append(payload7, 0x00)
    payload7 = bytes_append(payload7, 0x42)
    let h7 = {"pt": 100, "payload": payload7}
    let e7 = rtp_encode(h7)
    let d7 = rtp_decode(e7)
    if bytes_len(d7["payload"]) != 3
        print("FAIL v7 payload len: got "+str(bytes_len(d7["payload"]))+" want 3")
        fails = fails + 1
    else
        print("ok v7 payload len 3 (embedded NUL preserved)")
    let v7ok = bytes_get(d7["payload"], 0) == 0x41 and bytes_get(d7["payload"], 1) == 0x00 and bytes_get(d7["payload"], 2) == 0x42
    if v7ok == 0
        print("FAIL v7 payload bytes mismatch (embedded 0x00 corrupted)")
        fails = fails + 1
    else
        print("ok v7 payload bytes 41 00 42 exact (binary-safe, not string)")

    // ── Vector 8: CSRC count clamp — encoder never emits/reads > 15 entries ────
    let big_csrc = []
    let bi = 0
    while bi < 20
        big_csrc.push(bi + 1)
        bi = bi + 1
    let h8 = {"csrc": big_csrc}
    let e8 = rtp_encode(h8)
    let cc8 = bytes_get(e8, 0) & 0xF
    if cc8 != 15
        print("FAIL v8 CC clamp: got "+str(cc8)+" want 15")
        fails = fails + 1
    else
        print("ok v8 CC clamped to 15 (4-bit field) for 20-entry csrc list")
    if bytes_len(e8) != 12 + 15 * 4
        print("FAIL v8 len: got "+str(bytes_len(e8))+" want "+str(12 + 15 * 4))
        fails = fails + 1
    else
        print("ok v8 encoded len matches 15 csrc entries")

    // ── Vector 9: decode rejects CSRC count that overruns the buffer ───────────
    // byte0 claims CC=2 (needs 12+8=20 bytes) but buffer is only 12 bytes.
    let short_csrc = bytes(0)
    short_csrc = bytes_append(short_csrc, 0x82) // V2 CC=2
    short_csrc = bytes_append(short_csrc, 0x00)
    let sci = 0
    while sci < 10
        short_csrc = bytes_append(short_csrc, 0)
        sci = sci + 1
    let d9 = rtp_decode(short_csrc)
    if contains(d9, "ssrc")
        print("FAIL v9 CSRC-count overrun should be rejected in-band")
        fails = fails + 1
    else
        print("ok v9 CSRC count declaring more than buffer holds -> rejected")

    // ── Vector 10: decode rejects an extension length that overruns buffer ─────
    // byte0 X=1, CC=0; ext header claims length=100 words but buffer is short.
    let bad_ext = bytes(0)
    bad_ext = bytes_append(bad_ext, 0x90) // V2 X=1
    bad_ext = bytes_append(bad_ext, 0x00)
    let bei = 0
    while bei < 10
        bad_ext = bytes_append(bad_ext, 0)
        bei = bei + 1
    // now at offset 12: ext header profile=0000, length=0x0064 (100 words)
    bad_ext = bytes_append(bad_ext, 0x00)
    bad_ext = bytes_append(bad_ext, 0x00)
    bad_ext = bytes_append(bad_ext, 0x00)
    bad_ext = bytes_append(bad_ext, 0x64)
    let d10 = rtp_decode(bad_ext)
    if contains(d10, "ssrc")
        print("FAIL v10 oversized ext-length should be rejected in-band")
        fails = fails + 1
    else
        print("ok v10 extension length overrunning buffer -> rejected")

    // ── Vector 11: decode rejects pad count of 0 (invalid per RFC) ─────────────
    let bad_pad0 = bytes(0)
    bad_pad0 = bytes_append(bad_pad0, 0xA0) // V2 P=1
    bad_pad0 = bytes_append(bad_pad0, 0x00)
    let pi = 0
    while pi < 10
        bad_pad0 = bytes_append(bad_pad0, 0)
        pi = pi + 1
    bad_pad0 = bytes_append(bad_pad0, 0x00) // last byte = 0 (invalid pad count)
    let d11 = rtp_decode(bad_pad0)
    if contains(d11, "ssrc")
        print("FAIL v11 pad-count=0 should be rejected in-band")
        fails = fails + 1
    else
        print("ok v11 pad count of 0 -> rejected (invalid per RFC 3550)")

    // ── Vector 12: decode rejects pad count larger than remaining region ───────
    let bad_pad_big = bytes(0)
    bad_pad_big = bytes_append(bad_pad_big, 0xA0) // V2 P=1
    bad_pad_big = bytes_append(bad_pad_big, 0x00)
    let pbi = 0
    while pbi < 10
        bad_pad_big = bytes_append(bad_pad_big, 0)
        pbi = pbi + 1
    bad_pad_big = bytes_append(bad_pad_big, 0xFF) // pad count 255 but only 1 byte of "payload region" exists
    let d12 = rtp_decode(bad_pad_big)
    if contains(d12, "ssrc")
        print("FAIL v12 oversized pad-count should be rejected in-band")
        fails = fails + 1
    else
        print("ok v12 pad count exceeding available region -> rejected")

    // ── Vector 13: missing dict keys default correctly ──────────────────────────
    let h13 = {}
    let e13 = rtp_encode(h13)
    if bytes_len(e13) != 12
        print("FAIL v13 minimal encode len: got "+str(bytes_len(e13))+" want 12")
        fails = fails + 1
    else
        print("ok v13 empty-dict encode -> 12-byte default header")
    if bytes_get(e13, 0) != 0x80
        print("FAIL v13 default byte0 (version=2, rest 0): got "+str(bytes_get(e13, 0))+" want 128")
        fails = fails + 1
    else
        print("ok v13 default byte0 = 0x80 (V=2, P=X=0, CC=0)")

    // ── Vector 14: general round-trip preserves every field ─────────────────────
    let h14 = {"version": 2, "marker": 1, "pt": 111, "seq": 0xFFFF, "timestamp": 0xFFFFFFFF, "ssrc": 0xDEADBEEF, "payload": str_to_bytes("opus-frame-data")}
    let e14 = rtp_encode(h14)
    let d14 = rtp_decode(e14)
    let rt_ok = d14["version"] == 2 and d14["marker"] == 1 and d14["pt"] == 111 and d14["seq"] == 0xFFFF and d14["timestamp"] == 0xFFFFFFFF and d14["ssrc"] == 0xDEADBEEF and bytes_to_str(d14["payload"]) == "opus-frame-data"
    if rt_ok == 0
        print("FAIL v14 full round-trip field mismatch")
        fails = fails + 1
    else
        print("ok v14 full round-trip (max seq/timestamp/ssrc + marker + payload)")

    // ── Vector 15: rtp_encode must NOT mutate caller's ext_data buffer ─────────
    // ext_data length (3) is not a multiple of 4 -> encoder must zero-pad a
    // DEFENSIVE COPY, never bytes_append onto the caller's own bytes handle.
    let ext15 = bytes(0)
    ext15 = bytes_append(ext15, 0x11)
    ext15 = bytes_append(ext15, 0x22)
    ext15 = bytes_append(ext15, 0x33)
    let ext15_len_before = bytes_len(ext15)
    let h15 = {"ext_profile": 0x0001, "ext_data": ext15}
    let e15 = rtp_encode(h15)
    // Caller's original ext_data must be byte-for-byte unchanged after encode.
    if bytes_len(ext15) != ext15_len_before
        print("FAIL v15 caller ext_data length mutated: got "+str(bytes_len(ext15))+" want "+str(ext15_len_before))
        fails = fails + 1
    else
        print("ok v15 caller ext_data length unchanged (3)")
    let ext15_unchanged = bytes_get(ext15, 0) == 0x11 and bytes_get(ext15, 1) == 0x22 and bytes_get(ext15, 2) == 0x33
    if ext15_unchanged == 0
        print("FAIL v15 caller ext_data bytes mutated")
        fails = fails + 1
    else
        print("ok v15 caller ext_data bytes unchanged 11 22 33")
    // Encoded packet: extension length-words must round up 3 -> 4 bytes (1 word),
    // with the encoder's own copy zero-padded, not the caller's buffer grown.
    if bytes_len(e15) != 20
        print("FAIL v15 encoded len: got "+str(bytes_len(e15))+" want 20 (12 hdr + 4 exthdr + 4 padded extdata)")
        fails = fails + 1
    else
        print("ok v15 encoded len 20 (extension zero-padded to 4-byte boundary)")
    let exthdr15_ok = bytes_get(e15, 14) == 0x00 and bytes_get(e15, 15) == 0x01
    if exthdr15_ok == 0
        print("FAIL v15 ext length-words: want 1 word (4 bytes)")
        fails = fails + 1
    else
        print("ok v15 ext length-words = 1 (3 bytes padded to 4)")
    let extbytes15_ok = bytes_get(e15, 16) == 0x11 and bytes_get(e15, 17) == 0x22 and bytes_get(e15, 18) == 0x33 and bytes_get(e15, 19) == 0x00
    if extbytes15_ok == 0
        print("FAIL v15 padded extension bytes mismatch: want 11 22 33 00")
        fails = fails + 1
    else
        print("ok v15 padded extension bytes = 11 22 33 00 (zero-fill on the copy)")
    // Decode round-trip: encoder's zero-pad must not corrupt the declared data.
    let d15 = rtp_decode(e15)
    if bytes_len(d15["ext_data"]) != 4
        print("FAIL v15 decode ext_data len: got "+str(bytes_len(d15["ext_data"]))+" want 4")
        fails = fails + 1
    else
        print("ok v15 decode ext_data len = 4 (padded)")

    if fails == 0
        print("PASS _rtp_test")
    else
        print("FAIL _rtp_test: "+str(fails)+" check(s) failed")
        exit(1)
