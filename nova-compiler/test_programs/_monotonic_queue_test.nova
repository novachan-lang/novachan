import std/collections/monotonic_queue

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn ckl(label, got, expected)
    let ng = len(got)
    let ne = len(expected)
    if ng != ne
        print("FAIL " + label + ": length " + str(ng) + " != " + str(ne))
        exit(1)
    let i = 0
    while i < ng
        let gv = got[i]
        let ev = expected[i]
        if gv != ev
            print("FAIL " + label + "[" + str(i) + "]: got " + str(gv) + " expected " + str(ev))
            exit(1)
        i = i + 1

fn main()
    // KAT: mdq_sliding_max([1,3,-1,-3,5,3,6,7], 3) = [3,3,5,5,6,7]
    let a1 = [1, 3, 0-1, 0-3, 5, 3, 6, 7]
    let e1 = [3, 3, 5, 5, 6, 7]
    ckl("sliding_max k=3", mdq_sliding_max(a1, 3), e1)

    // KAT: mdq_sliding_min([1,3,-1,-3,5,3,6,7], 3) = [-1,-3,-3,-3,3,3]
    let a2 = [1, 3, 0-1, 0-3, 5, 3, 6, 7]
    let e2 = [0-1, 0-3, 0-3, 0-3, 3, 3]
    ckl("sliding_min k=3", mdq_sliding_min(a2, 3), e2)

    // KAT: mdq_sliding_max([4,3,2,1], 2) = [4,3,2]
    let a3 = [4, 3, 2, 1]
    let e3 = [4, 3, 2]
    ckl("sliding_max [4,3,2,1] k=2", mdq_sliding_max(a3, 2), e3)

    // KAT: mdq_sliding_max([1], 1) = [1]
    let a4 = [1]
    let e4 = [1]
    ckl("sliding_max single k=1", mdq_sliding_max(a4, 1), e4)

    // Edge: window equals full array
    let a5 = [3, 1, 4, 1, 5]
    let e5max = [5]
    let e5min = [1]
    ckl("sliding_max full window", mdq_sliding_max(a5, 5), e5max)
    ckl("sliding_min full window", mdq_sliding_min(a5, 5), e5min)

    // Edge: k=1 (each element is its own window)
    let a6 = [2, 7, 3, 5]
    ckl("sliding_max k=1", mdq_sliding_max(a6, 1), a6)
    ckl("sliding_min k=1", mdq_sliding_min(a6, 1), a6)

    // Edge: all equal
    let a7 = [4, 4, 4, 4]
    let e7 = [4, 4, 4]
    ckl("sliding_max equal k=2", mdq_sliding_max(a7, 2), e7)
    ckl("sliding_min equal k=2", mdq_sliding_min(a7, 2), e7)

    print("PASS _monotonic_queue_test")
