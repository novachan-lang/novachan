import forge_sla_monitor

fn main()
    let sla = sla_new("api-gateway", 99)

    let i = 0
    while i < 99
        sla = sla_record_up(sla)
        i = i + 1
    sla = sla_record_down(sla, "timeout")

    assert(sla_uptime_pct(sla) == 99, "99% uptime")
    assert(sla_is_met(sla) == true, "SLA met")
    assert(sla_violation_count(sla) == 1, "1 violation")

    sla = sla_record_down(sla, "crash")
    assert(sla_uptime_pct(sla) == 98, "98% now")
    assert(sla_is_met(sla) == false, "SLA not met")

    sla = sla_set_latency_target(sla, 200)
    sla = sla_record_latency(sla, 50)
    sla = sla_record_latency(sla, 100)
    sla = sla_record_latency(sla, 150)
    sla = sla_record_latency(sla, 200)
    sla = sla_record_latency(sla, 500)

    assert(sla_avg_latency(sla) == 200, "avg=200ms")

    let p99 = sla_p99_latency(sla)
    assert(p99 == 500, "p99=500ms")

    let summary = sla_summary(sla)
    assert(summary["name"] == "api-gateway", "name")
    assert(summary["violations"] == 2, "2 violations in summary")

    // --- sm_ multi-service API ---
    let m = sm_new()
    m = sm_add_sla(m, "api", 99)
    m = sm_add_sla(m, "db", 95)
    assert(sm_service_count(m) == 2, "2 services registered")

    let i2 = 0
    while i2 < 98
        let rr = sm_record(m, "api", 1)
        assert(is_ok(rr), "loop record ok")
        i2 = i2 + 1
    let rr2 = sm_record(m, "api", 0)
    assert(is_ok(rr2), "record ok")

    let up = sm_uptime(m, "api")
    assert(is_ok(up), "uptime ok")
    assert(unwrap(up) == 98, "api uptime 98% (98 of 99 succeeded)")

    let br = sm_is_breached(m, "api")
    assert(unwrap(br) == 1, "api breached (98 < target 99)")

    let j = 0
    while j < 96
        let rr3 = sm_record(m, "db", 1)
        assert(is_ok(rr3), "loop record ok")
        j = j + 1
    let br2 = sm_is_breached(m, "db")
    assert(unwrap(br2) == 0, "db not breached (100 >= target 95)")

    assert(sm_breached_count(m) == 1, "1 service breached")
    assert(sm_service_count(m) == 2, "still 2 services")
    assert(sm_total_records(m) == 195, "99 + 96 = 195 total records")

    let worst = sm_worst_service(m)
    assert(is_ok(worst), "worst_service ok")
    assert(unwrap(worst) == "api", "api is the worst service")

    let bad_rec = sm_record(m, "cache", 1)
    assert(is_err(bad_rec), "recording against unregistered service errs")

    let bad_up = sm_uptime(m, "cache")
    assert(is_err(bad_up), "uptime on unregistered service errs")

    let fresh = sm_new()
    let no_worst = sm_worst_service(fresh)
    assert(is_err(no_worst), "worst_service on empty monitor errs")
    assert(sm_breached_count(fresh) == 0, "breached_count on empty monitor is 0")

    print("SLA-MONITOR KAT PASS")
