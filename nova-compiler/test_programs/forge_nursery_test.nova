// Forge T4.20: structured concurrency. A nursery launches child tasks and joins them ALL before
// returning (no orphans); crash-safe -- a panicking child yields an err slot, the others still join.
// Socketless (spawn/monitor) -> kill-on-timeout safe.
import forge_otp

fn w10()
    10
fn w20()
    20
fn w30()
    30
fn wboom()
    panic("child died")

fn main()
    // All-succeed: 3 children join, sum = 60.
    let nur = nursery()
    nursery_go(nur, w10)
    nursery_go(nur, w20)
    nursery_go(nur, w30)
    let results = nursery_join(nur)
    let sum = 0
    let i = 0
    while i < len(results)
        let r: Result<any> = results[i]
        match r
            Ok(v) =>
                sum = sum + v
            Err(e) =>
                print("FAIL: unexpected err " + e)
                exit(1)
        i = i + 1
    if sum != 60
        print("FAIL: sum expected 60 got " + str(sum))
        exit(1)

    // Crash-safe: one child panics -> err slot, the join still returns and the other child is ok.
    let nur2 = nursery()
    nursery_go(nur2, w10)
    nursery_go(nur2, wboom)
    let r2 = nursery_join(nur2)
    let oks = 0
    let errs = 0
    let j = 0
    while j < len(r2)
        let rr: Result<any> = r2[j]
        match rr
            Ok(v) =>
                oks = oks + 1
            Err(e) =>
                errs = errs + 1
        j = j + 1
    if oks != 1 or errs != 1
        print("FAIL: expected 1 ok + 1 err, got oks=" + str(oks) + " errs=" + str(errs))
        exit(1)
    print("PASS forge_nursery (3 children sum 60; a panicking child -> err slot, join still returns)")
