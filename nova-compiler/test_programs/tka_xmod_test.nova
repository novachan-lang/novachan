// TRACK-A: an UNANNOTATED `let x = mod.fn()` must resolve x's struct type so field access uses
// the PER-STRUCT slot, not the global (last-registered-wins) name->slot map. XS.a is slot 1,
// YS.a is slot 2; x = make_xs() (XS) so x.a must be 10 (slot 1), not 30 (YS slot 2).
import tka_mod

fn main()
    let x = tka_mod.make_xs()
    print("x.a=" + str(x.a) + " x.b=" + str(x.b))
    assert(x.a == 10, "x.a must be 10 (XS slot), not the shared-name global slot")
    assert(x.b == 20, "x.b must be 20")
    let y = tka_mod.make_ys()
    print("y.a=" + str(y.a) + " y.b=" + str(y.b))
    assert(y.a == 40, "y.a must be 40 (YS slot)")
    assert(y.b == 30, "y.b must be 30")
    print("tka_xmod_test passed")
