// KAT for std/math/fibonacci — Fibonacci utilities.
// Known-answer vectors verified by hand and against OEIS A000045.
import std/math/fibonacci

// cki — check int equality; print FAIL and exit(1) on mismatch.
fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// ckb — check bool equality; print FAIL and exit(1) on mismatch.
fn ckb(label: str, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got " + gs + " want " + ws)
        exit(1)

// list_to_str — render an int list as "[a,b,c]" for comparison.
fn list_to_str(xs: list) -> str
    let n = len(xs)
    if n == 0
        return "[]"
    let s = "["
    let i = 0
    while i < n
        s = s + str(xs[i])
        if i < n - 1
            s = s + ","
        i = i + 1
    s = s + "]"
    s

fn main()
    // --- fib: base cases and published OEIS A000045 values ---
    cki("fib(0)", fib(0), 0)
    cki("fib(1)", fib(1), 1)
    cki("fib(2)", fib(2), 1)
    cki("fib(3)", fib(3), 2)
    cki("fib(4)", fib(4), 3)
    cki("fib(5)", fib(5), 5)
    cki("fib(10)", fib(10), 55)
    cki("fib(20)", fib(20), 6765)
    // Negative n treated as 0
    cki("fib(-1)", fib(-1), 0)

    // --- fib_list ---
    // fib_list(7) == [0,1,1,2,3,5,8]
    let fl7 = fib_list(7)
    let fl7s = list_to_str(fl7)
    if fl7s != "[0,1,1,2,3,5,8]"
        print("FAIL fib_list(7): got " + fl7s + " want [0,1,1,2,3,5,8]")
        exit(1)
    // fib_list(0) == []
    let fl0 = fib_list(0)
    let fl0s = list_to_str(fl0)
    if fl0s != "[]"
        print("FAIL fib_list(0): got " + fl0s + " want []")
        exit(1)
    // fib_list(1) == [0]
    let fl1 = fib_list(1)
    let fl1s = list_to_str(fl1)
    if fl1s != "[0]"
        print("FAIL fib_list(1): got " + fl1s + " want [0]")
        exit(1)
    // fib_list(2) == [0,1]
    let fl2 = fib_list(2)
    let fl2s = list_to_str(fl2)
    if fl2s != "[0,1]"
        print("FAIL fib_list(2): got " + fl2s + " want [0,1]")
        exit(1)

    // --- is_fib ---
    // n=21 is Fibonacci (fib(8)=21); n=22 is not.
    ckb("is_fib(0)", is_fib(0), true)
    ckb("is_fib(1)", is_fib(1), true)
    ckb("is_fib(2)", is_fib(2), true)
    ckb("is_fib(8)", is_fib(8), true)
    ckb("is_fib(21)", is_fib(21), true)
    ckb("is_fib(22)", is_fib(22), false)
    ckb("is_fib(55)", is_fib(55), true)
    ckb("is_fib(56)", is_fib(56), false)
    ckb("is_fib(-1)", is_fib(-1), false)
    ckb("is_fib(4)", is_fib(4), false)

    // --- fib_index ---
    // fib_index(55) == 10 because fib(10)=55 (OEIS A000045)
    cki("fib_index(0)", fib_index(0), 0)
    cki("fib_index(1)", fib_index(1), 1)
    cki("fib_index(2)", fib_index(2), 3)
    cki("fib_index(55)", fib_index(55), 10)
    cki("fib_index(22)", fib_index(22), -1)
    cki("fib_index(-1)", fib_index(-1), -1)
    cki("fib_index(21)", fib_index(21), 8)

    // --- fib_sum ---
    // fib_sum(5) = fib(0)+fib(1)+fib(2)+fib(3)+fib(4) = 0+1+1+2+3 = 7
    cki("fib_sum(0)", fib_sum(0), 0)
    cki("fib_sum(1)", fib_sum(1), 0)
    cki("fib_sum(2)", fib_sum(2), 1)
    cki("fib_sum(5)", fib_sum(5), 7)
    // fib_sum(7) = 0+1+1+2+3+5+8 = 20; fib(8)=21, 21-1=20
    cki("fib_sum(7)", fib_sum(7), 20)
    // fib_sum(10) = fib(11)-1 = 89-1 = 88
    cki("fib_sum(10)", fib_sum(10), 88)

    print("_fibonacci_test passed")
