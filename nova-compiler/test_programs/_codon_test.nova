// KAT for std/bio/codon — standard genetic code + translation.
// All reference values verified against NCBI standard genetic code (table 1).
import std/bio/codon

// cks — check string equality.
fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

// cki — check int equality.
fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb — check bool equality.
fn ckb(label, got, want)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
        exit(1)

// ckf — check float within tolerance.
fn ckf(label, got, want, tol)
    let diff = got - want
    if diff < 0.0
        diff = 0.0 - diff
    if diff >= tol
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// list_contains: check if a string value is in a list.
fn list_contains(lst, val)
    let i = 0
    let n = len(lst)
    let found = false
    while i < n and not found
        if lst[i] == val
            found = true
        i = i + 1
    return found

fn main()
    // ── codon_to_aa ──────────────────────────────────────────────────────────
    cks("codon_ATG",  codon_to_aa("ATG"),  "M")
    cks("codon_TTT",  codon_to_aa("TTT"),  "F")
    cks("codon_TTC",  codon_to_aa("TTC"),  "F")
    cks("codon_TAA",  codon_to_aa("TAA"),  "*")
    cks("codon_TAG",  codon_to_aa("TAG"),  "*")
    cks("codon_TGA",  codon_to_aa("TGA"),  "*")
    cks("codon_GGG",  codon_to_aa("GGG"),  "G")
    cks("codon_AAA",  codon_to_aa("AAA"),  "K")
    cks("codon_CTG",  codon_to_aa("CTG"),  "L")
    cks("codon_ACG",  codon_to_aa("ACG"),  "T")
    cks("codon_TGG",  codon_to_aa("TGG"),  "W")
    cks("codon_unknown", codon_to_aa("NNN"), "?")

    // ── codon_is_start / codon_is_stop ────────────────────────────────────────
    ckb("start_ATG",  codon_is_start("ATG"),  true)
    ckb("start_TTG",  codon_is_start("TTG"),  false)
    ckb("stop_TAA",   codon_is_stop("TAA"),   true)
    ckb("stop_TAG",   codon_is_stop("TAG"),   true)
    ckb("stop_TGA",   codon_is_stop("TGA"),   true)
    ckb("stop_ATG",   codon_is_stop("ATG"),   false)

    // ── codon_count ───────────────────────────────────────────────────────────
    cki("codon_count_9",  codon_count("ATGAAATAA"),  3)
    cki("codon_count_0",  codon_count("AT"),          0)
    cki("codon_count_4",  codon_count("ATGATGATGX"),  3)

    // ── translate ─────────────────────────────────────────────────────────────
    // ATG=M, AAA=K, TAA=stop  -> "MK*"
    cks("translate_MK*",  translate("ATGAAATAA"),  "MK*")
    // ATG=M, TTT=F, GGG=G -> "MFG" (no stop)
    cks("translate_MFG",  translate("ATGTTTGGG"),  "MFG")
    // empty
    cks("translate_empty", translate(""),           "")
    // incomplete trailing base ignored
    cks("translate_trail", translate("ATGAA"),     "M")
    // TGA is stop
    cks("translate_stop2", translate("ATGTGA"),    "M*")

    // ── translate_all_frames ──────────────────────────────────────────────────
    let frames = translate_all_frames("ATGAAATAA")
    cki("frames_count",  len(frames),  3)
    // Frame 0: ATG+AAA+TAA = "MK*"
    cks("frame0",  frames[0],  "MK*")

    // ── aa_to_codons ──────────────────────────────────────────────────────────
    // M is encoded only by ATG
    let m_codons = aa_to_codons("M")
    cki("aa_M_count",    len(m_codons),   1)
    ckb("aa_M_ATG",      list_contains(m_codons, "ATG"),  true)
    // W is encoded only by TGG
    let w_codons = aa_to_codons("W")
    cki("aa_W_count",    len(w_codons),   1)
    ckb("aa_W_TGG",      list_contains(w_codons, "TGG"),  true)
    // L is encoded by 6 codons
    let l_codons = aa_to_codons("L")
    cki("aa_L_count",    len(l_codons),   6)
    // Stop '*' is encoded by 3 codons
    let stop_codons = aa_to_codons("*")
    cki("aa_stop_count", len(stop_codons), 3)

    // ── synonymous_codons ──────────────────────────────────────────────────────
    // ATG encodes M (only one codon) -> no synonyms
    let atg_syn = synonymous_codons("ATG")
    cki("syn_ATG_count",  len(atg_syn),  0)
    // TTT encodes F; synonyms = {TTC}
    let ttt_syn = synonymous_codons("TTT")
    cki("syn_TTT_count",  len(ttt_syn),  1)
    ckb("syn_TTT_TTC",    list_contains(ttt_syn, "TTC"),  true)

    // ── codon_gc3 ─────────────────────────────────────────────────────────────
    // "ATGCCC": codon 0 = ATG (3rd=G), codon 1 = CCC (3rd=C) -> 2/2 = 1.0
    ckf("gc3_atgccc",   codon_gc3("ATGCCC"),   1.0,  0.001)
    // "ATGTTT": codon 0 = ATG (3rd=G=GC), codon 1 = TTT (3rd=T=not GC) -> 1/2 = 0.5
    ckf("gc3_atgttt",   codon_gc3("ATGTTT"),   0.5,  0.001)
    // Empty
    ckf("gc3_empty",    codon_gc3(""),          0.0,  0.001)

    // ── is_synonymous ──────────────────────────────────────────────────────────
    ckb("syn_TTT_TTC",   is_synonymous("TTT", "TTC"),  true)
    ckb("syn_ATG_TTT",   is_synonymous("ATG", "TTT"),  false)
    ckb("syn_same",      is_synonymous("GGG", "GGG"),  true)
    ckb("syn_stop_pair", is_synonymous("TAA", "TGA"),  true)

    // ── codon_table_size ──────────────────────────────────────────────────────
    cki("table_size",  codon_table_size(),  64)

    print("PASS _codon_test")
