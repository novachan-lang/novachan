import forge_wrand

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn count_of(xs: list, v: int) -> int
    let c = 0
    let i = 0
    while i < len(xs)
        if xs[i] == v
            c = c + 1
        i = i + 1
    c

fn main()
    let fails = 0

    // build + total
    let cum = wrand_build([1, 1, 2])
    fails = fails + expect("cum", str(cum[0]) + "," + str(cum[1]) + "," + str(cum[2]), "1,2,4")
    fails = fails + expect("total", str(wrand_total(cum)), "4")

    // exact target -> index mapping (index i owns target range [cum[i-1], cum[i]))
    fails = fails + expect("at0", str(wrand_sample_at(cum, 0)), "0")
    fails = fails + expect("at1", str(wrand_sample_at(cum, 1)), "1")
    fails = fails + expect("at2", str(wrand_sample_at(cum, 2)), "2")
    fails = fails + expect("at3", str(wrand_sample_at(cum, 3)), "2")

    // single weight -> always index 0
    let one = wrand_build([5])
    fails = fails + expect("single", str(wrand_sample_at(one, 3)), "0")

    // zero weight in the middle is NEVER selected
    let z = wrand_build([2, 0, 3])
    fails = fails + expect("z_cum", str(z[0]) + "," + str(z[1]) + "," + str(z[2]), "2,2,5")
    fails = fails + expect("z0", str(wrand_sample_at(z, 0)), "0")
    fails = fails + expect("z1", str(wrand_sample_at(z, 1)), "0")
    fails = fails + expect("z2", str(wrand_sample_at(z, 2)), "2")
    fails = fails + expect("z4", str(wrand_sample_at(z, 4)), "2")

    // determinism: same seed -> same sequence
    let s1 = wrand_sample_n(cum, 12345, 20)
    let s2 = wrand_sample_n(cum, 12345, 20)
    fails = fails + expect("determinism", join(map(s1, fn(x) str(x)), ","), join(map(s2, fn(x) str(x)), ","))

    // statistical: weights [1,1,2] over 40000 draws -> ~10000/10000/20000 (+-5%)
    let samples = wrand_sample_n(cum, 999, 40000)
    let c0 = count_of(samples, 0)
    let c1 = count_of(samples, 1)
    let c2 = count_of(samples, 2)
    print("  dist: c0=" + str(c0) + " c1=" + str(c1) + " c2=" + str(c2) + " (exp ~10000/10000/20000)")
    fails = fails + expect_true("dist0", c0 > 9500 and c0 < 10500)
    fails = fails + expect_true("dist1", c1 > 9500 and c1 < 10500)
    fails = fails + expect_true("dist2", c2 > 19000 and c2 < 21000)
    // zero-weight bucket never appears
    let zsamples = wrand_sample_n(z, 777, 5000)
    fails = fails + expect_true("zero_never", count_of(zsamples, 1) == 0)

    if fails == 0
        print("forge_wrand: all passed")
    else
        print("forge_wrand: " + str(fails) + " FAILED")
