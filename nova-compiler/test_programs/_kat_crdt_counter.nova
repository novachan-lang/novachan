import forge_crdt_counter

fn main()
    let gc1 = gc_new()
    gc1 = gc_increment(gc1, "node-1", 5)
    gc1 = gc_increment(gc1, "node-1", 3)
    gc1 = gc_increment(gc1, "node-2", 10)
    assert(gc_value(gc1) == 18, "total 18")

    let n1 = gc_node_value(gc1, "node-1")
    assert(is_ok(n1), "node-1 lookup ok")
    assert(unwrap(n1) == 8, "node-1 = 8")

    let n2 = gc_node_value(gc1, "node-2")
    assert(is_ok(n2), "node-2 lookup ok")
    assert(unwrap(n2) == 10, "node-2 = 10")

    assert(gc_node_count(gc1) == 2, "2 nodes")
    assert(gc_has_node(gc1, "node-1") == 1, "has node-1")
    assert(gc_has_node(gc1, "node-9") == 0, "no node-9")

    let list1 = gc_node_list(gc1)
    assert(contains(list1, "node-1") == true, "list has node-1")
    assert(contains(list1, "node-2") == true, "list has node-2")

    let gc2 = gc_new()
    gc2 = gc_increment(gc2, "node-1", 10)
    gc2 = gc_increment(gc2, "node-3", 7)

    let merged = gc_merge(gc1, gc2)
    assert(unwrap(gc_node_value(merged, "node-1")) == 10, "merged node-1=10 (max)")
    assert(unwrap(gc_node_value(merged, "node-2")) == 10, "merged node-2=10")
    assert(unwrap(gc_node_value(merged, "node-3")) == 7, "merged node-3=7")
    assert(gc_value(merged) == 27, "merged total 27")
    assert(gc_node_count(merged) == 3, "3 nodes merged")
    assert(gc_has_node(merged, "node-3") == 1, "merged has node-3")

    assert(is_err(gc_node_value(gc1, "missing")), "missing node errors")

    print("CRDT-COUNTER KAT PASS")
