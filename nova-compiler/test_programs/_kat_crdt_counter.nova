import forge_crdt_counter

fn main()
    let gc1 = gc_new()
    gc1 = gc_increment(gc1, "node-1", 5)
    gc1 = gc_increment(gc1, "node-1", 3)
    gc1 = gc_increment(gc1, "node-2", 10)
    assert(gc_value(gc1) == 18, "total 18")
    assert(gc_node_value(gc1, "node-1") == 8, "node-1 = 8")
    assert(gc_node_value(gc1, "node-2") == 10, "node-2 = 10")
    assert(gc_node_count(gc1) == 2, "2 nodes")

    let gc2 = gc_new()
    gc2 = gc_increment(gc2, "node-1", 10)
    gc2 = gc_increment(gc2, "node-3", 7)

    let merged = gc_merge(gc1, gc2)
    assert(gc_node_value(merged, "node-1") == 10, "merged node-1=10 (max)")
    assert(gc_node_value(merged, "node-2") == 10, "merged node-2=10")
    assert(gc_node_value(merged, "node-3") == 7, "merged node-3=7")
    assert(gc_value(merged) == 27, "merged total 27")
    assert(gc_node_count(merged) == 3, "3 nodes merged")

    assert(gc_node_value(gc1, "missing") == 0, "missing = 0")

    print("CRDT-COUNTER KAT PASS")
