import std/lambda/lambda_normal

// cki: check int equality
fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// ckb: check bool (int) equality
fn ckb(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// term_eq: recursive structural equality of two terms (tagged lists).
fn term_eq(a, b) -> int
    if len(a) != len(b)
        return 0
    if a[0] != b[0]
        return 0
    let tag = a[0]
    if tag == "var"
        if int(a[1]) != int(b[1])
            return 0
        return 1
    if tag == "lam"
        return term_eq(a[1], b[1])
    if term_eq(a[1], b[1]) == 0
        return 0
    return term_eq(a[2], b[2])

// ckt: check term equality
fn ckt(label, a, b)
    if term_eq(a, b) == 0
        print("FAIL " + label + ": terms differ")
        exit(1)

fn main()
    // The canonical test term: (λx.x)((λx.x) 7)
    // Encoded: ["app", ["lam",["var",0]], ["app", ["lam",["var",0]], ["var",7]]]
    // Both strategies reduce to ["var",7].
    let id_lam1 = lambda_normal.lnr_mk_lam(lambda_normal.lnr_mk_var(0))
    let id_lam2 = lambda_normal.lnr_mk_lam(lambda_normal.lnr_mk_var(0))
    let v7 = lambda_normal.lnr_mk_var(7)
    let inner_app = lambda_normal.lnr_mk_app(id_lam2, v7)
    let test_term = lambda_normal.lnr_mk_app(id_lam1, inner_app)
    let expected_v7 = lambda_normal.lnr_mk_var(7)

    // ── KAT 1: normal_order reaches ["var",7]
    let r_no = lambda_normal.lnr_normal_order(test_term, 100)
    ckt("normal_order_to_var7", r_no, expected_v7)

    // ── KAT 2: applicative_order reaches ["var",7]
    let r_ao = lambda_normal.lnr_applicative_order(test_term, 100)
    ckt("applicative_order_to_var7", r_ao, expected_v7)

    // ── KAT 3: confluent = true (both strategies agree)
    ckb("confluent_true", lambda_normal.lnr_confluent(test_term, 100), 1)

    // ── KAT 4: count_steps = 2
    // Step 1: outermost redex fires: (λx.x)((λx.x)7) -> (λx.x)7
    // Step 2: (λx.x)7 -> 7.  Total = 2.
    cki("count_steps_2", lambda_normal.lnr_count_steps(test_term, 100), 2)

    // ── KAT 5: whnf of (λx.λy.y) 5 = ["lam",["var",0]]
    // Encoded: ["app", ["lam",["lam",["var",0]]], ["var",5]]
    // Beta: shift(-1,0, subst(0, shift(1,0,["var",5]), ["lam",["var",0]]))
    //   shift(1,0,["var",5]) = ["var",6]
    //   subst(0, ["var",6], ["lam",["var",0]]):
    //     = ["lam", subst(1, shift(1,0,["var",6]), ["var",0])]
    //     = ["lam", subst(1, ["var",7], ["var",0])]
    //     = ["lam", ["var",0]]   (0 != 1, so unchanged)
    //   shift(-1, 0, ["lam",["var",0]]) = ["lam", shift(-1,1,["var",0])]
    //     = ["lam", ["var",0]]  (0 < 1, not free, unchanged)
    // WHNF result: ["lam",["var",0]]
    let inner_id = lambda_normal.lnr_mk_lam(lambda_normal.lnr_mk_var(0))
    let k_outer = lambda_normal.lnr_mk_lam(inner_id)
    let v5 = lambda_normal.lnr_mk_var(5)
    let whnf_test = lambda_normal.lnr_mk_app(k_outer, v5)
    let r_whnf = lambda_normal.lnr_whnf(whnf_test, 100)
    let exp_whnf = lambda_normal.lnr_mk_lam(lambda_normal.lnr_mk_var(0))
    ckt("whnf_result", r_whnf, exp_whnf)

    // ── KAT 6: already-normal term stays unchanged under normal_order
    let plain_var = lambda_normal.lnr_mk_var(3)
    let r_nf = lambda_normal.lnr_normal_order(plain_var, 100)
    ckt("normal_order_noop_on_var", r_nf, lambda_normal.lnr_mk_var(3))

    // ── KAT 7: count_steps on already-normal = 0
    cki("count_steps_zero_on_var", lambda_normal.lnr_count_steps(plain_var, 100), 0)

    // ── KAT 8: confluent on single-redex identity application
    let id_s = lambda_normal.lnr_mk_lam(lambda_normal.lnr_mk_var(0))
    let v2 = lambda_normal.lnr_mk_var(2)
    let single_app = lambda_normal.lnr_mk_app(id_s, v2)
    ckb("confluent_single_redex", lambda_normal.lnr_confluent(single_app, 100), 1)

    print("PASS _lambda_normal_test")
