// Test compile-time evaluation: paren expressions in static_assert
// (if_expr in call args not yet supported by parser — deferred)

fn main()
    // paren in comptime arithmetic
    static_assert((1 + 2) * 3 == 9)
    static_assert((10 - 3) == 7)
    static_assert(((2 + 3) * (4 - 1)) == 15)
    static_assert((1 == 1) and (2 == 2))
    static_assert((5 > 3) or (1 > 10))
    static_assert(not (1 == 2))

    // existing comptime works
    static_assert(2 + 2 == 4)
    static_assert(100 / 5 == 20)
    static_assert(7 % 3 == 1)

    print("comptime_if: all static_assert passed")
