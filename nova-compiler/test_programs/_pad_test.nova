// KAT for std/text/pad — ljust/rjust/center/zfill (sign-aware).
import std/text/pad

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": '" + got + "' != '" + want + "'")
        exit(1)

fn main()
    cks("ljust", ljust("hi", 5, " "), "hi   ")
    cks("ljust-star", ljust("hi", 5, "*"), "hi***")
    cks("ljust-over", ljust("hello", 3, " "), "hello")
    cks("rjust", rjust("hi", 5, " "), "   hi")
    cks("rjust-zero", rjust("42", 5, "0"), "00042")
    cks("center", center("hi", 6, " "), "  hi  ")
    cks("center-odd", center("hi", 5, " "), " hi  ")
    cks("zfill", zfill("42", 5), "00042")
    cks("zfill-neg", zfill("-42", 5), "-0042")
    cks("zfill-pos", zfill("+42", 5), "+0042")
    cks("zfill-noop", zfill("7", 1), "7")
    print("_pad_test passed")
