import std/complex/complex_norm

// cki — assert integer equality
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _complex_norm_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb — assert boolean equality
fn ckb(label: string, got: bool, want: bool)
    if got != want
        print("FAIL _complex_norm_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// cks — assert string equality
fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL _complex_norm_test " + label + ": got=" + got + " want=" + want)
        exit(1)

// ckl — assert list equality (not directly needed here but provided per spec)
fn ckl(label: string, got: list, wr: int, wi: int)
    if got[0] != wr or got[1] != wi
        print("FAIL _complex_norm_test " + label + ": got=[" + str(got[0]) + "," + str(got[1]) + "] want=[" + str(wr) + "," + str(wi) + "]")
        exit(1)

// helper: build complex [re, im]
fn mk(re: int, im: int) -> list
    let c = []
    push(c, re)
    push(c, im)
    c

// --- cxn_norm_sq ---
// |3+4i|^2 = 9+16 = 25
cki("norm_sq_3_4", cxn_norm_sq(mk(3, 4)), 25)

// |0+0i|^2 = 0
cki("norm_sq_zero", cxn_norm_sq(mk(0, 0)), 0)

// |1+0i|^2 = 1
cki("norm_sq_1_0", cxn_norm_sq(mk(1, 0)), 1)

// |0+1i|^2 = 1
cki("norm_sq_0_1", cxn_norm_sq(mk(0, 1)), 1)

// |-3+4i|^2 = 9+16 = 25
cki("norm_sq_neg3_4", cxn_norm_sq(mk(0 - 3, 4)), 25)

// |5+12i|^2 = 25+144 = 169
cki("norm_sq_5_12", cxn_norm_sq(mk(5, 12)), 169)

// |0+5i|^2 = 25
cki("norm_sq_pure_imag", cxn_norm_sq(mk(0, 5)), 25)

// --- cxn_is_zero ---
ckb("is_zero_true", cxn_is_zero(mk(0, 0)), true)
ckb("is_zero_false_re", cxn_is_zero(mk(1, 0)), false)
ckb("is_zero_false_im", cxn_is_zero(mk(0, 1)), false)
ckb("is_zero_false_both", cxn_is_zero(mk(3, 4)), false)

// --- cxn_compare_abs ---
// |3+4i|=5 == |5+0i|=5 -> 0
cki("cmp_abs_equal", cxn_compare_abs(mk(3, 4), mk(5, 0)), 0)

// |1+1i|^2=2 < |2+0i|^2=4 -> -1
cki("cmp_abs_less", cxn_compare_abs(mk(1, 1), mk(2, 0)), 0 - 1)

// |2+0i|^2=4 > |1+1i|^2=2 -> 1
cki("cmp_abs_greater", cxn_compare_abs(mk(2, 0), mk(1, 1)), 1)

// |0+0i|=0 < |1+0i|=1 -> -1
cki("cmp_abs_zero_vs_one", cxn_compare_abs(mk(0, 0), mk(1, 0)), 0 - 1)

// |5+12i|=13 > |3+4i|=5 -> 1
cki("cmp_abs_5_12_vs_3_4", cxn_compare_abs(mk(5, 12), mk(3, 4)), 1)

// |3+4i|=5 == |4+3i|=5 -> 0  (symmetry)
cki("cmp_abs_pythagorean", cxn_compare_abs(mk(3, 4), mk(4, 3)), 0)

// --- cxn_is_unit ---
// z in {1,-1,i,-i} are units
ckb("is_unit_1_0", cxn_is_unit(mk(1, 0)), true)
ckb("is_unit_neg1_0", cxn_is_unit(mk(0 - 1, 0)), true)
ckb("is_unit_0_1", cxn_is_unit(mk(0, 1)), true)
ckb("is_unit_0_neg1", cxn_is_unit(mk(0, 0 - 1)), true)

// non-units
ckb("is_unit_zero", cxn_is_unit(mk(0, 0)), false)
ckb("is_unit_1_1", cxn_is_unit(mk(1, 1)), false)
ckb("is_unit_2_0", cxn_is_unit(mk(2, 0)), false)
ckb("is_unit_3_4", cxn_is_unit(mk(3, 4)), false)

print("PASS _complex_norm_test")
