// PARALLEL SCALING BENCHMARK (WEAPON_PARITY_PLAN 4.1)
//
// WHY THIS FILE EXISTS: the N>1 story had no live measurement anywhere. The
// _n_carriers_ci gate proves CORRECTNESS at NOVA_CARRIERS=4/8, and all six
// bench/programs are single-threaded — so the long-standing "N>1 runs at
// 0.76-0.82x single-core" claim was unverifiable against today's build. You cannot
// fix, or honestly claim, a scaling number you do not measure.
//
// The workload is deliberately CPU-BOUND and allocation-free in its inner loop:
// each worker runs a tight integer mix over a disjoint slice, so wall-clock is
// dominated by compute rather than by channel traffic or the allocator. Work is
// split into exactly WORKERS disjoint chunks with one channel fan-in, which is the
// shape a real data-parallel job has.
//
// Run the SAME binary under NOVA_CARRIERS=1,2,4,8 and compare wall times; the
// harness (_par_scale_bench.ps1) does that and computes speedup. Per
// .claude/rules/compiler-architecture.md the bar for 4 workers is > 1.8x.
//
// Total work is held CONSTANT across carrier counts — the per-worker slice shrinks
// as WORKERS rises — so the comparison is strong scaling (Amdahl), not a throughput
// illusion from doing more total work.

let WORKERS = 8
let TOTAL = 24000000          // total inner iterations across all workers
let PER = TOTAL / WORKERS

// A tight integer mix. No allocation, no calls out — just enough arithmetic that
// the loop cannot be folded away, and a data dependency so it cannot be vectorized
// into nothing.
fn crunch(seed: int, iters: int) -> int
    let acc = seed
    let i = 0
    while i < iters
        acc = acc + (i * 2654435761) % 1000003
        acc = acc % 4294967291
        i = i + 1
    acc

fn main()
    let hub = channel()
    let w = 0
    while w < WORKERS
        let my_seed = w + 1
        spawn fn()
            send(hub, crunch(my_seed, PER))
        w = w + 1

    // Fan-in. Summing the results forces every worker to complete and keeps the
    // compiler from eliminating any of the work as dead.
    let total = 0
    let got = 0
    while got < WORKERS
        total = total + receive(hub)
        got = got + 1

    // Printed so the run is verifiable, and so a carrier count that silently
    // dropped or double-counted a worker shows up as a different checksum. The
    // value is carrier-count INDEPENDENT by construction.
    print("workers=" + str(WORKERS))
    print("checksum=" + str(total))
    print("PAR_SCALE_OK")
