/// real_test_runner.nova — NOVA language self-test suite
///
/// A comprehensive test of NOVA's core features, written IN NOVA.
/// Exercises: types, strings, lists, dicts, closures, channels,
/// concurrency, file I/O, error handling, higher-order functions.

fn _test_inline()
    let pass_count = 0
    let fail_count = 0

    assert(1 + 1 == 2, "basic math")
    pass_count = pass_count + 1

    assert(len("hello") == 5, "string length")
    pass_count = pass_count + 1

    assert(len([1,2,3]) == 3, "list length")
    pass_count = pass_count + 1

    let d = {"a": 1, "b": 2}
    assert(contains(d, "a"), "dict contains")
    assert(not contains(d, "c"), "dict not contains")
    pass_count = pass_count + 2

    let nums = [1,2,3,4,5]
    let evens = filter(nums, fn(x) x % 2 == 0)
    assert(len(evens) == 2, "filter")
    pass_count = pass_count + 1

    let doubled = map(nums, fn(x) x * 2)
    assert(doubled[0] == 2, "map")
    assert(doubled[4] == 10, "map last")
    pass_count = pass_count + 2

    let parts = split("a,b,c", ",")
    assert(len(parts) == 3, "split")
    assert(parts[0] == "a", "split first")
    assert(parts[2] == "c", "split last")
    pass_count = pass_count + 3

    let j = join(["x", "y", "z"], "-")
    assert(j == "x-y-z", "join")
    pass_count = pass_count + 1

    assert(starts_with("hello", "he"), "starts_with")
    assert(not starts_with("hello", "lo"), "not starts_with")
    pass_count = pass_count + 2

    assert(trim("  hi  ") == "hi", "trim")
    pass_count = pass_count + 1

    let ch = channel()
    let c = ch
    spawn(fn(x) send(c, 42))
    let v = recv(ch)
    assert(v == 42, "channel send/recv")
    pass_count = pass_count + 1

    print("  inline tests: " + str(pass_count) + " passed, " + str(fail_count) + " failed")
    assert(fail_count == 0, "no inline failures")

fn _test_error_handling()
    let r = parse_int("123")
    assert(r == 123, "parse_int valid")

    let r2 = parse_int("not_a_number")
    assert(r2 == 0, "parse_int invalid returns 0")

    print("  error handling: PASS")

fn _test_file_io()
    let tmp = "_test_runner_tmp.txt"
    write_file(tmp, "hello from NOVA\nline 2\n")
    let content = read_file(tmp)
    assert(contains(content, "hello from NOVA"), "write+read file")
    assert(contains(content, "line 2"), "multi-line file")
    remove_file(tmp)
    assert(not file_exists(tmp), "file removed")
    print("  file I/O: PASS")

fn _test_string_processing()
    let csv = "name,age,city\nAlice,30,NYC\nBob,25,SF"
    let lines = split(csv, "\n")
    assert(len(lines) == 3, "csv lines")
    let header = split(lines[0], ",")
    assert(header[0] == "name", "csv header")
    assert(header[2] == "city", "csv header 3")
    let row1 = split(lines[1], ",")
    assert(row1[0] == "Alice", "csv row1 name")
    assert(row1[1] == "30", "csv row1 age")
    print("  string processing: PASS")

fn _test_concurrent_aggregation()
    let num_workers = 4
    let ch = channel()
    let c = ch
    let i = 0
    while i < num_workers
        let wid = i
        spawn(fn(x) send(c, wid * wid))
        i = i + 1
    let total = 0
    let j = 0
    while j < num_workers
        total = total + recv(ch)
        j = j + 1
    assert(total == 0 + 1 + 4 + 9, "concurrent sum of squares: " + str(total))
    print("  concurrent aggregation: PASS")

fn _test_data_structures()
    let stack = []
    push(stack, 10)
    push(stack, 20)
    push(stack, 30)
    assert(len(stack) == 3, "stack push")
    assert(stack[2] == 30, "stack top")

    let m = {}
    m["x"] = 100
    m["y"] = 200
    let ks = keys(m)
    assert(len(ks) == 2, "dict keys")
    assert(m["x"] + m["y"] == 300, "dict values")

    print("  data structures: PASS")

fn main()
    print("NOVA self-test suite")
    print("====================")
    _test_inline()
    _test_error_handling()
    _test_file_io()
    _test_string_processing()
    _test_concurrent_aggregation()
    _test_data_structures()
    print("====================")
    print("real_test_runner: all passed")
