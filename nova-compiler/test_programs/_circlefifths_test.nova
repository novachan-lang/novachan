import std/music/circlefifths

fn main()
    // ── fifth_up ──────────────────────────────────────────────────────────────
    let got_fu_C = fifth_up("C")
    if got_fu_C != "G"
        print("FAIL circlefifths fifth_up(C): got " + got_fu_C + " want G")
        exit(1)

    let got_fu_G = fifth_up("G")
    if got_fu_G != "D"
        print("FAIL circlefifths fifth_up(G): got " + got_fu_G + " want D")
        exit(1)

    let got_fu_B = fifth_up("B")
    if got_fu_B != "F#"
        print("FAIL circlefifths fifth_up(B): got " + got_fu_B + " want F#")
        exit(1)

    let got_fu_F = fifth_up("F")
    if got_fu_F != "C"
        print("FAIL circlefifths fifth_up(F): got " + got_fu_F + " want C")
        exit(1)

    // ── fifth_down ────────────────────────────────────────────────────────────
    let got_fd_C = fifth_down("C")
    if got_fd_C != "F"
        print("FAIL circlefifths fifth_down(C): got " + got_fd_C + " want F")
        exit(1)

    let got_fd_F = fifth_down("F")
    if got_fd_F != "Bb"
        print("FAIL circlefifths fifth_down(F): got " + got_fd_F + " want Bb")
        exit(1)

    let got_fd_G = fifth_down("G")
    if got_fd_G != "C"
        print("FAIL circlefifths fifth_down(G): got " + got_fd_G + " want C")
        exit(1)

    // ── circle_position ───────────────────────────────────────────────────────
    let got_cp_C = circle_position("C")
    if got_cp_C != 0
        print("FAIL circlefifths circle_position(C): got " + str(got_cp_C) + " want 0")
        exit(1)

    let got_cp_G = circle_position("G")
    if got_cp_G != 1
        print("FAIL circlefifths circle_position(G): got " + str(got_cp_G) + " want 1")
        exit(1)

    let got_cp_D = circle_position("D")
    if got_cp_D != 2
        print("FAIL circlefifths circle_position(D): got " + str(got_cp_D) + " want 2")
        exit(1)

    let got_cp_Fsh = circle_position("F#")
    if got_cp_Fsh != 6
        print("FAIL circlefifths circle_position(F#): got " + str(got_cp_Fsh) + " want 6")
        exit(1)

    let got_cp_Db = circle_position("Db")
    if got_cp_Db != 7
        print("FAIL circlefifths circle_position(Db): got " + str(got_cp_Db) + " want 7")
        exit(1)

    let got_cp_F = circle_position("F")
    if got_cp_F != 11
        print("FAIL circlefifths circle_position(F): got " + str(got_cp_F) + " want 11")
        exit(1)

    // enharmonic alias: Gb == F# at position 6
    let got_cp_Gb = circle_position("Gb")
    if got_cp_Gb != 6
        print("FAIL circlefifths circle_position(Gb): got " + str(got_cp_Gb) + " want 6")
        exit(1)

    // ── distance_fifths ───────────────────────────────────────────────────────
    let got_df_CD = distance_fifths("C", "D")
    if got_df_CD != 2
        print("FAIL circlefifths distance_fifths(C,D): got " + str(got_df_CD) + " want 2")
        exit(1)

    let got_df_CC = distance_fifths("C", "C")
    if got_df_CC != 0
        print("FAIL circlefifths distance_fifths(C,C): got " + str(got_df_CC) + " want 0")
        exit(1)

    let got_df_CF = distance_fifths("C", "F")
    if got_df_CF != 11
        print("FAIL circlefifths distance_fifths(C,F): got " + str(got_df_CF) + " want 11")
        exit(1)

    let got_df_GC = distance_fifths("G", "C")
    if got_df_GC != 11
        print("FAIL circlefifths distance_fifths(G,C): got " + str(got_df_GC) + " want 11")
        exit(1)

    // ── circle_order ──────────────────────────────────────────────────────────
    let ord = circle_order()
    let ord_len = len(ord)
    if ord_len != 12
        print("FAIL circlefifths circle_order length: got " + str(ord_len) + " want 12")
        exit(1)

    let ord0 = ord[0]
    if ord0 != "C"
        print("FAIL circlefifths circle_order[0]: got " + ord0 + " want C")
        exit(1)

    let ord1 = ord[1]
    if ord1 != "G"
        print("FAIL circlefifths circle_order[1]: got " + ord1 + " want G")
        exit(1)

    let ord6 = ord[6]
    if ord6 != "F#"
        print("FAIL circlefifths circle_order[6]: got " + ord6 + " want F#")
        exit(1)

    let ord11 = ord[11]
    if ord11 != "F"
        print("FAIL circlefifths circle_order[11]: got " + ord11 + " want F")
        exit(1)

    print("PASS _circlefifths_test")
