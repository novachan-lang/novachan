// Test: lists, for loops, list operations
fn sum_list(items: list) -> int
    let total = 0
    for x in items
        total = total + x
    return total

fn make_range(n: int) -> list
    let result = []
    let i = 0
    while i < n
        push(result, i)
        i = i + 1
    return result

let nums = make_range(10)
print(len(nums))
print(sum_list(nums))

let words = ["hello", "world", "nova"]
for w in words
    print(w)
