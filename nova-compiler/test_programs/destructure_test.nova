type Point
    x: int
    y: int

type Circle
    center: int
    radius: int

fn describe(p: Point) -> string
    match p
        Point(x, y) => "(" + str(x) + ", " + str(y) + ")"

fn area_label(c: Circle) -> string
    match c
        Circle(_, r) => "area=" + str(r * r)

let p = Point(3, 4)
let c = Circle(0, 5)

print(describe(p))
print(area_label(c))

fn magnitude(p: Point) -> int
    match p
        Point(x, y) => x * x + y * y

print(str(magnitude(Point(3, 4))))
print(str(magnitude(Point(5, 12))))
