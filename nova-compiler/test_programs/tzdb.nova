fn _tz_offsets() -> dict
    let db = {}
    db["UTC"] = 0
    db["GMT"] = 0
    db["EST"] = -18000
    db["EDT"] = -14400
    db["CST"] = -21600
    db["CDT"] = -18000
    db["MST"] = -25200
    db["MDT"] = -21600
    db["PST"] = -28800
    db["PDT"] = -25200
    db["AKST"] = -32400
    db["AKDT"] = -28800
    db["HST"] = -36000
    db["AST"] = -14400
    db["NST"] = -12600
    db["NDT"] = -9000
    db["CET"] = 3600
    db["CEST"] = 7200
    db["EET"] = 7200
    db["EEST"] = 10800
    db["WET"] = 0
    db["WEST"] = 3600
    db["MSK"] = 10800
    db["IST"] = 19800
    db["PKT"] = 18000
    db["BST"] = 3600
    db["JST"] = 32400
    db["KST"] = 32400
    db["CST_CN"] = 28800
    db["HKT"] = 28800
    db["SGT"] = 28800
    db["AWST"] = 28800
    db["ACST"] = 34200
    db["AEST"] = 36000
    db["AEDT"] = 39600
    db["NZST"] = 43200
    db["NZDT"] = 46800
    db["ICT"] = 25200
    db["WIB"] = 25200
    db["WITA"] = 28800
    db["WIT"] = 32400
    db["BRT"] = -10800
    db["ART"] = -10800
    db["CLT"] = -14400
    db["COT"] = -18000
    db["PET"] = -18000
    db["VET"] = -14400
    db["ECT"] = -18000
    db["SAST"] = 7200
    db["EAT"] = 10800
    db["WAT"] = 3600
    db["CAT"] = 7200
    db["GST"] = 14400
    db["TRT"] = 10800
    db["NPT"] = 20700
    db["MMT"] = 23400
    db["AFT"] = 16200
    db["UZT"] = 18000
    db["ALMT"] = 21600
    db["KRAT"] = 25200
    db["IRKT"] = 28800
    db["YAKT"] = 32400
    db["VLAT"] = 36000
    db["MAGT"] = 39600
    db["PETT"] = 43200
    db["SAMT"] = 14400
    db["YEKT"] = 18000
    db["OMST"] = 21600
    db["NOVT"] = 25200
    db

fn _tz_db()
    _tz_offsets()

fn tz_offset(zone: string) -> int
    let db = _tz_db()
    if contains(db, zone)
        return db[zone]
    return -999999

fn tz_has(zone: string) -> int
    let db = _tz_db()
    contains(db, zone)

fn tz_list() -> list
    let db = _tz_db()
    keys(db)

fn tz_convert(ts: int, from_zone: string, to_zone: string) -> int
    let db = _tz_db()
    let from_off = 0
    if contains(db, from_zone)
        from_off = db[from_zone]
    let to_off = 0
    if contains(db, to_zone)
        to_off = db[to_zone]
    ts - from_off + to_off

fn _is_leap(y: int) -> int
    if y % 400 == 0
        return 1
    if y % 100 == 0
        return 0
    if y % 4 == 0
        return 1
    0

fn _days_in_month(y: int, m: int) -> int
    if m == 2
        if _is_leap(y) == 1
            return 29
        return 28
    if m == 4 or m == 6 or m == 9 or m == 11
        return 30
    31

fn _utc_decompose(ts: int) -> dict
    let rem = ts
    let sign = 1
    if rem < 0
        sign = -1
        rem = 0 - rem
    let s = rem % 60
    rem = rem / 60
    let mi = rem % 60
    rem = rem / 60
    let h = rem % 24
    let days = rem / 24
    if sign == -1
        if s > 0
            s = 60 - s
            mi = mi + 1
        if mi > 0
            mi = 60 - mi
            h = h + 1
        if h > 0
            h = 24 - h
            days = days + 1
        days = 0 - days
    let y = 1970
    if days >= 0
        while 1 == 1
            let ydays = 365
            if _is_leap(y) == 1
                ydays = 366
            if days < ydays
                break
            days = days - ydays
            y = y + 1
    else
        while days < 0
            y = y - 1
            let ydays = 365
            if _is_leap(y) == 1
                ydays = 366
            days = days + ydays
    let m = 1
    while m <= 12
        let dm = _days_in_month(y, m)
        if days < dm
            break
        days = days - dm
        m = m + 1
    let d = days + 1
    {"year": y, "month": m, "day": d, "hour": h, "minute": mi, "second": s}

fn tz_at(ts: int, zone: string) -> dict
    let off = tz_offset(zone)
    if off == -999999
        return {"error": "unknown zone"}
    let local_ts = ts + off
    let parts = _utc_decompose(local_ts)
    parts["zone"] = zone
    parts["offset"] = off
    parts

fn tz_format_iso(ts: int, zone: string) -> string
    let off = tz_offset(zone)
    if off == -999999
        return "unknown zone: " + zone
    let parts = _utc_decompose(ts + off)
    let y = str(parts["year"])
    let mo = str(parts["month"])
    let d = str(parts["day"])
    let h = str(parts["hour"])
    let mi = str(parts["minute"])
    let s = str(parts["second"])
    if len(mo) < 2
        mo = "0" + mo
    if len(d) < 2
        d = "0" + d
    if len(h) < 2
        h = "0" + h
    if len(mi) < 2
        mi = "0" + mi
    if len(s) < 2
        s = "0" + s
    let sign = "+"
    let abs_off = off
    if off < 0
        sign = "-"
        abs_off = 0 - off
    let oh = str(abs_off / 3600)
    let om = str((abs_off % 3600) / 60)
    if len(oh) < 2
        oh = "0" + oh
    if len(om) < 2
        om = "0" + om
    y + "-" + mo + "-" + d + "T" + h + ":" + mi + ":" + s + sign + oh + ":" + om

fn main()
    assert(tz_has("UTC") == 1, "has UTC")
    assert(tz_has("EST") == 1, "has EST")
    assert(tz_has("JST") == 1, "has JST")
    assert(tz_has("BOGUS") == 0, "no BOGUS")

    assert(tz_offset("UTC") == 0, "UTC offset 0")
    assert(tz_offset("EST") == -18000, "EST offset -5h")
    assert(tz_offset("IST") == 19800, "IST offset +5:30")
    assert(tz_offset("JST") == 32400, "JST offset +9h")

    let epoch = 0
    let utc_comp = tz_at(epoch, "UTC")
    assert(utc_comp["year"] == 1970, "epoch year")
    assert(utc_comp["month"] == 1, "epoch month")
    assert(utc_comp["day"] == 1, "epoch day")
    assert(utc_comp["hour"] == 0, "epoch hour")

    let converted = tz_convert(1234567890, "UTC", "JST")
    assert(converted == 1234567890 + 32400, "UTC->JST conversion")

    let back = tz_convert(converted, "JST", "UTC")
    assert(back == 1234567890, "JST->UTC roundtrip")

    let cross = tz_convert(1234567890, "EST", "IST")
    let expected = 1234567890 - (-18000) + 19800
    assert(cross == expected, "EST->IST cross-conversion")

    let zones = tz_list()
    assert(len(zones) > 60, "at least 60 zones")

    let iso = tz_format_iso(0, "UTC")
    assert(contains(iso, "1970"), "ISO has 1970")
    assert(contains(iso, "+00:00"), "ISO has +00:00")

    let ist_iso = tz_format_iso(0, "IST")
    assert(contains(ist_iso, "+05:30"), "IST ISO has +05:30")

    print("tzdb: all passed")
