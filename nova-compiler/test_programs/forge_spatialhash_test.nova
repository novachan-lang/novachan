import forge_spatialhash

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn has_id(ids, target) -> bool
    let f = false
    let i = 0
    while i < len(ids)
        if ids[i] == target
            f = true
        i = i + 1
    f

fn main()
    let fails = 0

    let g = spatial_new(10)
    // objects in various cells (cell size 10)
    spatial_insert(g, 1, 5, 5)      // cell 0,0
    spatial_insert(g, 2, 15, 5)     // cell 1,0
    spatial_insert(g, 3, 5, 15)     // cell 0,1
    spatial_insert(g, 4, 100, 100)  // cell 10,10 (far away)
    spatial_insert(g, 5, 8, 8)      // cell 0,0 (same as id 1)

    // cell 0,0 has ids 1 and 5
    let c00 = spatial_cell(g, 3, 3)
    fails = fails + expect("cell00_count", str(len(c00)), "2")
    fails = fails + expect_true("cell00_has1", has_id(c00, 1))
    fails = fails + expect_true("cell00_has5", has_id(c00, 5))

    // neighbors of (5,5): cells around 0,0 -> ids 1,5 (0,0), 2 (1,0), 3 (0,1). NOT 4 (far)
    let nb = spatial_neighbors(g, 5, 5)
    fails = fails + expect_true("nb_has1", has_id(nb, 1))
    fails = fails + expect_true("nb_has2", has_id(nb, 2))
    fails = fails + expect_true("nb_has3", has_id(nb, 3))
    fails = fails + expect_true("nb_not4", has_id(nb, 4) == false)

    // query box [0,0]..[19,19] covers cells 0,0 / 1,0 / 0,1 / 1,1 -> ids 1,5,2,3 not 4
    let q = spatial_query(g, 0, 0, 19, 19)
    fails = fails + expect_true("q_has1", has_id(q, 1))
    fails = fails + expect_true("q_has2", has_id(q, 2))
    fails = fails + expect_true("q_has3", has_id(q, 3))
    fails = fails + expect_true("q_not4", has_id(q, 4) == false)

    // query around the far object finds only it
    let qf = spatial_query(g, 95, 95, 105, 105)
    fails = fails + expect("qf_count", str(len(qf)), "1")
    fails = fails + expect_true("qf_has4", has_id(qf, 4))

    // empty cell -> empty list
    fails = fails + expect("empty_cell", str(len(spatial_cell(g, 500, 500))), "0")

    // occupied cell count: 0,0 / 1,0 / 0,1 / 10,10 = 4
    fails = fails + expect("cell_count", str(spatial_cell_count(g)), "4")

    // float coordinates + negative
    let g2 = spatial_new(1.0)
    spatial_insert(g2, 9, 0 - 0.5, 0 - 0.5)  // cell -1,-1
    fails = fails + expect_true("neg_cell", has_id(spatial_cell(g2, 0 - 0.3, 0 - 0.9), 9))

    if fails == 0
        print("forge_spatialhash: all passed")
    else
        print("forge_spatialhash: " + str(fails) + " FAILED")
