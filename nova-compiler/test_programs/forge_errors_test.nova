// forge_errors_test -- structured JSON errors (resp_error) + a custom 404 handler (on_not_found).
import forge

fn h(req: Request) -> string
    "ok"

fn my_404(req: Request) -> Response
    forge.resp_error(404, "no such resource: " + req.path)

fn main()
    let q = chr(34)

    // resp_error -> {"error": "..."} with the status
    let e: Response = forge.resp_error(422, "bad input")
    assert(e.status == 422, "resp_error status")
    assert(find(e.body, q + "error" + q + ":" + q + "bad input" + q) >= 0, "resp_error JSON shape")
    print("PASS: resp_error structured JSON")

    // custom 404: an unmatched route hits the registered handler
    let a = forge.app()
    forge.get(a, "/x", h)
    forge.on_not_found(a, my_404)
    let nf: Response = forge.dispatch_req(a, forge.build_request("GET /missing HTTP/1.1\r\n\r\n", 0))
    assert(nf.status == 404, "custom 404 status")
    assert(find(nf.body, q + "error" + q + ":" + q + "no such resource: /missing" + q) >= 0, "custom 404 JSON body")
    print("PASS: custom 404 handler")

    // a matched route is unaffected
    let ok: Response = forge.dispatch_req(a, forge.build_request("GET /x HTTP/1.1\r\n\r\n", 0))
    assert(ok.status == 200, "matched route still works")
    print("PASS: matched route unaffected")
    print("forge_errors_test passed")
