// KAT for std/dsp/correlation.
// Hand-computed expected values verified against the cross-correlation formula:
//   out[k] = sum_i a[i]*b[j]  where j = i - (k - (len(b)-1))
//   for valid index ranges.
import std/dsp/correlation

// Float epsilon comparison.
fn ckf(label: string, got: float, want: float)
    let d = got - want
    if d < 0.0
        d = 0.0 - d
    if d > 0.001
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// Element-wise float-list comparison with epsilon.
fn ckfl(label: string, got: list, want: list)
    let ng = len(got)
    let nw = len(want)
    if ng != nw
        print("FAIL " + label + " length: got=" + str(ng) + " want=" + str(nw))
        exit(1)
    let i = 0
    while i < ng
        let g = got[i] * 1.0
        let w = want[i] * 1.0
        let d = g - w
        if d < 0.0
            d = 0.0 - d
        if d > 0.001
            print("FAIL " + label + "[" + str(i) + "]: got=" + str(g) + " want=" + str(w))
            exit(1)
        i = i + 1

fn main()
    // KAT 1: perfect positive Pearson (identical signals).
    let a1 = [1.0, 2.0, 3.0]
    let b1 = [1.0, 2.0, 3.0]
    ckf("pearson_identical", cor_pearson(a1, b1), 1.0)

    // KAT 2: perfect negative Pearson (reversed signal).
    let a2 = [1.0, 2.0, 3.0]
    let b2 = [3.0, 2.0, 1.0]
    ckf("pearson_negone", cor_pearson(a2, b2), 0.0 - 1.0)

    // KAT 3: perfect positive Pearson (scaled signal).
    let a3 = [1.0, 2.0, 3.0, 4.0]
    let b3 = [2.0, 4.0, 6.0, 8.0]
    ckf("pearson_scaled", cor_pearson(a3, b3), 1.0)

    // KAT 4: zero-variance signals -> Pearson == 0.0.
    let a4 = [1.0, 1.0, 1.0]
    let b4 = [2.0, 2.0, 2.0]
    ckf("pearson_zero_var", cor_pearson(a4, b4), 0.0)

    // KAT 5: autocorrelation of [1,2,1] must be symmetric and peak at center.
    // Expected: cor_cross([1,2,1],[1,2,1]) = [1,4,6,4,1]
    //   k=0: i=0,j=2 -> 1*1=1
    //   k=1: i in [0,1] -> 1*2+2*1=4
    //   k=2: i in [0,2] -> 1*1+2*2+1*1=6
    //   k=3: i in [1,2] -> 2*1+1*2=4  (j=i-1 since offset=1)
    //   k=4: i=2, j=0 -> 1*1=1
    let sig = [1.0, 2.0, 1.0]
    let ac = cor_auto(sig)
    // Length must be 5
    if len(ac) != 5
        print("FAIL autocorr_length: got=" + str(len(ac)) + " want=5")
        exit(1)
    ckfl("autocorr_values", ac, [1.0, 4.0, 6.0, 4.0, 1.0])
    // Symmetry: ac[0]==ac[4], ac[1]==ac[3]
    ckf("autocorr_sym04", ac[0] * 1.0, ac[4] * 1.0)
    ckf("autocorr_sym13", ac[1] * 1.0, ac[3] * 1.0)
    // Peak at center (index 2)
    ckf("autocorr_center_peak", ac[2] * 1.0, 6.0)

    // KAT 6: cross-correlation of [1,2,3] with [0,1,0].
    // Expected: [0, 1, 2, 3, 0]  (full, length 5)
    //   k=0: i=0,j=2 -> 1*0=0
    //   k=1: i in [0,1], j=i+1 -> 1*1+2*0=1
    //   k=2: i in [0,2], j=i   -> 1*0+2*1+3*0=2
    //   k=3: i in [1,2], j=i-1 -> 2*0+3*1=3
    //   k=4: i=2, j=0          -> 3*0=0
    let a6 = [1.0, 2.0, 3.0]
    let b6 = [0.0, 1.0, 0.0]
    let cc6 = cor_cross(a6, b6)
    ckfl("cross_121_010", cc6, [0.0, 1.0, 2.0, 3.0, 0.0])

    // KAT 7: lag_of_max for a padded copy: b = [0,0,1,2,3] vs a = [1,2,3].
    // The [1,2,3] part of b starts 2 positions in; cross-correlation peaks at index 2.
    // b has len=5, N=5; lag = best_idx - (N-1) = 2 - 4 = -2.
    // Negative lag: a leads b (b's matching portion comes later in the sequence).
    let a7 = [1.0, 2.0, 3.0]
    let b7 = [0.0, 0.0, 1.0, 2.0, 3.0]
    let lag7 = cor_lag_of_max(a7, b7)
    if lag7 != 0 - 2
        print("FAIL lag_of_max: got=" + str(lag7) + " want=-2")
        exit(1)

    // KAT 8: cross-correlation is commutative in energy (peak of cc = peak of reversed).
    // cor_cross([1,2,3],[3,2,1]) hand-computed:
    // M=3, N=3, out_len=5
    //   k=0: i=0,j=2 -> 1*1=1
    //   k=1: i in [0,1],j=i+1 -> 1*2+2*1=4
    //   k=2: i in [0,2],j=i   -> 1*3+2*2+3*1=10
    //   k=3: i in [1,2],j=i-1 -> 2*3+3*2=12
    //   k=4: i=2,j=0           -> 3*3=9
    let a8 = [1.0, 2.0, 3.0]
    let b8 = [3.0, 2.0, 1.0]
    let cc8 = cor_cross(a8, b8)
    ckfl("cross_123_321", cc8, [1.0, 4.0, 10.0, 12.0, 9.0])

    // KAT 9: lag_of_max where signal is perfectly aligned (lag=0).
    let a9 = [1.0, 3.0, 2.0]
    let b9 = [1.0, 3.0, 2.0]
    let lag9 = cor_lag_of_max(a9, b9)
    if lag9 != 0
        print("FAIL lag_aligned: got=" + str(lag9) + " want=0")
        exit(1)

    print("_correlation_test passed")
