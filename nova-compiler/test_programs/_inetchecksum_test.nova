import std/net/inetchecksum

// ── KAT helpers ──────────────────────────────────────────────────────────────

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL inetchecksum " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gs = "false"
    if got
        gs = "true"
    let ws = "false"
    if want
        ws = "true"
    if got != want
        print("FAIL inetchecksum " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn main()
    // ── Vector 1: canonical IPv4 header (RFC 1071 example) ───────────────────
    // 45 00 00 73 00 00 40 00 40 11 00 00 c0 a8 00 01 c0 a8 00 c7
    // checksum field zeroed; expected result = 0xB861
    let h = bytes(20)
    bytes_set(h, 0,  0x45)
    bytes_set(h, 1,  0x00)
    bytes_set(h, 2,  0x00)
    bytes_set(h, 3,  0x73)
    bytes_set(h, 4,  0x00)
    bytes_set(h, 5,  0x00)
    bytes_set(h, 6,  0x40)
    bytes_set(h, 7,  0x00)
    bytes_set(h, 8,  0x40)
    bytes_set(h, 9,  0x11)
    bytes_set(h, 10, 0x00)
    bytes_set(h, 11, 0x00)
    bytes_set(h, 12, 0xc0)
    bytes_set(h, 13, 0xa8)
    bytes_set(h, 14, 0x00)
    bytes_set(h, 15, 0x01)
    bytes_set(h, 16, 0xc0)
    bytes_set(h, 17, 0xa8)
    bytes_set(h, 18, 0x00)
    bytes_set(h, 19, 0xc7)
    cki("ipv4_header_checksum", inet_checksum(h), 0xB861)

    // ── Vector 2: empty bytes -> 0xFFFF ──────────────────────────────────────
    cki("empty_bytes", inet_checksum(bytes(0)), 0xFFFF)

    // ── Vector 3: verify — embed checksum 0xB861, then verify == true ────────
    // Write 0xB861 into bytes 10-11 of the header copy.
    let hv = bytes(20)
    bytes_set(hv, 0,  0x45)
    bytes_set(hv, 1,  0x00)
    bytes_set(hv, 2,  0x00)
    bytes_set(hv, 3,  0x73)
    bytes_set(hv, 4,  0x00)
    bytes_set(hv, 5,  0x00)
    bytes_set(hv, 6,  0x40)
    bytes_set(hv, 7,  0x00)
    bytes_set(hv, 8,  0x40)
    bytes_set(hv, 9,  0x11)
    bytes_set(hv, 10, 0xB8)
    bytes_set(hv, 11, 0x61)
    bytes_set(hv, 12, 0xc0)
    bytes_set(hv, 13, 0xa8)
    bytes_set(hv, 14, 0x00)
    bytes_set(hv, 15, 0x01)
    bytes_set(hv, 16, 0xc0)
    bytes_set(hv, 17, 0xa8)
    bytes_set(hv, 18, 0x00)
    bytes_set(hv, 19, 0xc7)
    // Full-header checksum (with correct checksum embedded) == 0 (folded sum = 0xFFFF complement = 0)
    cki("verify_full_header_checksum", inet_checksum(hv), 0)
    ckb("verify_verify_true", inet_checksum_verify(hv), true)

    // ── Vector 4: tamper one byte — verify must be false ─────────────────────
    let hbad = bytes(20)
    bytes_set(hbad, 0,  0x45)
    bytes_set(hbad, 1,  0x00)
    bytes_set(hbad, 2,  0x00)
    bytes_set(hbad, 3,  0x73)
    bytes_set(hbad, 4,  0x00)
    bytes_set(hbad, 5,  0x00)
    bytes_set(hbad, 6,  0x40)
    bytes_set(hbad, 7,  0x00)
    bytes_set(hbad, 8,  0x40)
    bytes_set(hbad, 9,  0x11)
    bytes_set(hbad, 10, 0xB8)
    bytes_set(hbad, 11, 0x62)
    bytes_set(hbad, 12, 0xc0)
    bytes_set(hbad, 13, 0xa8)
    bytes_set(hbad, 14, 0x00)
    bytes_set(hbad, 15, 0x01)
    bytes_set(hbad, 16, 0xc0)
    bytes_set(hbad, 17, 0xa8)
    bytes_set(hbad, 18, 0x00)
    bytes_set(hbad, 19, 0xc7)
    ckb("verify_tampered_false", inet_checksum_verify(hbad), false)

    // ── Vector 5: odd-length — [0x00, 0x01, 0xf2] ────────────────────────────
    // 0x00,0x01 as word = 1; 0xf2 as high byte = 0xf200; sum = 0xf201
    // ones-complement of 0xf201 = 0x0DFE
    let odd = bytes(3)
    bytes_set(odd, 0, 0x00)
    bytes_set(odd, 1, 0x01)
    bytes_set(odd, 2, 0xf2)
    cki("odd_length_3bytes", inet_checksum(odd), 0x0DFE)

    // ── Vector 6: inet_add_words — simple carry test ──────────────────────────
    // 0x8000 + 0x8000 = 0x10000 -> carry fold -> 0x0001
    cki("add_words_carry", inet_add_words(0x8000, 0x8000), 0x0001)
    // 0x1234 + 0x5678 = 0x68AC (no carry)
    cki("add_words_no_carry", inet_add_words(0x1234, 0x5678), 0x68AC)
    // 0x0000 + 0x0000 = 0x0000
    cki("add_words_zero", inet_add_words(0, 0), 0)
    // 0xFFFF + 0x0001 = 0x10000 -> 0x0000 + 0x0001 = 0x0001
    cki("add_words_ffff_plus_1", inet_add_words(0xFFFF, 0x0001), 0x0001)

    // ── Vector 7: round-trip — encode->checksum->embed->verify ───────────────
    // Build a minimal 20-byte header with checksum=0, compute, embed, verify.
    let rt = bytes(20)
    bytes_set(rt, 0,  0x45)
    bytes_set(rt, 1,  0x00)
    bytes_set(rt, 2,  0x00)
    bytes_set(rt, 3,  0x14)
    bytes_set(rt, 4,  0x00)
    bytes_set(rt, 5,  0x01)
    bytes_set(rt, 6,  0x00)
    bytes_set(rt, 7,  0x00)
    bytes_set(rt, 8,  0x40)
    bytes_set(rt, 9,  0x06)
    bytes_set(rt, 10, 0x00)
    bytes_set(rt, 11, 0x00)
    bytes_set(rt, 12, 0x7f)
    bytes_set(rt, 13, 0x00)
    bytes_set(rt, 14, 0x00)
    bytes_set(rt, 15, 0x01)
    bytes_set(rt, 16, 0x7f)
    bytes_set(rt, 17, 0x00)
    bytes_set(rt, 18, 0x00)
    bytes_set(rt, 19, 0x01)
    let ck = inet_checksum(rt)
    bytes_set(rt, 10, (ck >> 8) & 0xFF)
    bytes_set(rt, 11, ck & 0xFF)
    ckb("roundtrip_verify", inet_checksum_verify(rt), true)
    cki("roundtrip_recheck_zero", inet_checksum(rt), 0)

    print("PASS _inetchecksum_test")
