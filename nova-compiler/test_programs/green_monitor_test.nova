fn worker(ch)
  send(ch, 42)

fn crasher()
  panic("boom")

fn main()
  let ch = channel()
  let p1 = spawn worker(ch)
  let mon1 = monitor(p1)
  let val = receive(ch)
  assert(val == 42, "worker should send 42")
  let s1 = receive(mon1)
  assert(s1 == 0, "normal exit should be 0")
  let r1 = exit_reason(p1)
  assert(r1 == "normal", "normal reason should be 'normal'")

  let p2 = spawn crasher()
  let mon2 = monitor(p2)
  let s2 = receive(mon2)
  assert(s2 == 1, "crash exit should be 1")
  let r2 = exit_reason(p2)
  assert(contains(r2, "boom"), "crash reason should contain 'boom'")

  print("green_monitor_test: all passed")
