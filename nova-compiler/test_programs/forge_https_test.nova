// Forge HTTPS: serve a routed response over TLS 1.3. The handler receives the decrypted HTTP request and
// returns the response; forge_serve_tls wraps the TLS handshake + record layer around it. Fetched by curl.
import forge_tls_server
import forge_crypto

fn https_handler(req) -> string
    let crlf = chr(13) + chr(10)
    let body = "Hello from NOVA HTTPS via Forge routing!"
    "HTTP/1.1 200 OK" + crlf + "Content-Type: text/plain" + crlf + "Content-Length: 40" + crlf + crlf + body

fn main()
    forge_serve_tls(44331, https_handler)
    print("HTTPS-SERVED")
