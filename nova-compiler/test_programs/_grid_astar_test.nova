import std/game2d/grid_astar

// Helper: check two [x,y] cells are equal.
fn _ga_cell_eq(a, b)
    if a[0] != b[0]
        return false
    return a[1] == b[1]

// Helper: check path contains a given [x,y] cell.
fn _ga_path_has(path, x, y)
    let i = 0
    let n = len(path)
    while i < n
        let c = path[i]
        if c[0] == x and c[1] == y
            return true
        i = i + 1
    return false

fn main()
    // ── KAT 1: ga_manhattan ───────────────────────────────────────────────────
    let m1 = ga_manhattan(0, 0, 3, 4)
    if m1 != 7
        print("FAIL grid_astar ga_manhattan(0,0,3,4): got=" + str(m1) + " want=7")
        exit(1)

    let m2 = ga_manhattan(2, 2, 2, 2)
    if m2 != 0
        print("FAIL grid_astar ga_manhattan same cell: got=" + str(m2) + " want=0")
        exit(1)

    // ── KAT 2: ga_new / ga_is_wall / ga_set_wall ─────────────────────────────
    let g5 = ga_new(5, 5)
    let w1 = ga_is_wall(g5, 0, 0)
    if w1 != false
        print("FAIL grid_astar ga_is_wall on fresh cell: got=" + str(w1) + " want=false")
        exit(1)

    ga_set_wall(g5, 2, 2)
    let w2 = ga_is_wall(g5, 2, 2)
    if w2 != true
        print("FAIL grid_astar ga_is_wall after set_wall: got=" + str(w2) + " want=true")
        exit(1)

    // Out-of-bounds is treated as wall.
    let woob = ga_is_wall(g5, -1, 0)
    if woob != true
        print("FAIL grid_astar ga_is_wall out-of-bounds: got=" + str(woob) + " want=true")
        exit(1)

    // ── KAT 3: straight 4-dir path on 5x5 empty grid (0,0)->(4,0) ───────────
    // Manhattan distance = 4; path must have 5 cells (length == 5).
    let g_empty = ga_new(5, 5)
    let path_straight = ga_find_path(g_empty, 0, 0, 4, 0, false)
    let plen_straight = ga_path_length(path_straight)
    if plen_straight != 5
        print("FAIL grid_astar straight 4-dir path length: got=" + str(plen_straight) + " want=5")
        exit(1)

    // Start and end cells correct.
    let ps0 = path_straight[0]
    if ps0[0] != 0 or ps0[1] != 0
        print("FAIL grid_astar straight path start: got=[" + str(ps0[0]) + "," + str(ps0[1]) + "] want=[0,0]")
        exit(1)
    let ps_last = path_straight[4]
    if ps_last[0] != 4 or ps_last[1] != 0
        print("FAIL grid_astar straight path end: got=[" + str(ps_last[0]) + "," + str(ps_last[1]) + "] want=[4,0]")
        exit(1)

    // path_length of that == 5 (confirming the function itself).
    let pl5 = ga_path_length(path_straight)
    if pl5 != 5
        print("FAIL grid_astar ga_path_length: got=" + str(pl5) + " want=5")
        exit(1)

    // ── KAT 4: Manhattan+1 rule for straight empty-grid paths ─────────────────
    // (0,0)->(3,0): manhattan=3, path_length should be 4.
    let path_m3 = ga_find_path(g_empty, 0, 0, 3, 0, false)
    let pl_m3 = ga_path_length(path_m3)
    if pl_m3 != 4
        print("FAIL grid_astar path length manhattan+1: got=" + str(pl_m3) + " want=4")
        exit(1)

    // ── KAT 5: forced detour in 3x3 grid ──────────────────────────────────────
    // Walls at (1,0) and (1,1); path (0,0)->(2,0) must go DOWN around walls.
    // Direct (through x=1) is blocked; must route via (0,1) or (0,2).
    // Minimum detour path length > 3 (the straight would be 3 steps = 3 cells).
    let g33 = ga_new(3, 3)
    ga_set_wall(g33, 1, 0)
    ga_set_wall(g33, 1, 1)
    let path_det = ga_find_path(g33, 0, 0, 2, 0, false)
    let plen_det = ga_path_length(path_det)
    if plen_det < 4
        print("FAIL grid_astar detour path too short: got=" + str(plen_det) + " want>=4")
        exit(1)

    // Path must start at (0,0) and end at (2,0).
    let pd0 = path_det[0]
    if pd0[0] != 0 or pd0[1] != 0
        print("FAIL grid_astar detour path start: got=[" + str(pd0[0]) + "," + str(pd0[1]) + "]")
        exit(1)
    let pd_last = path_det[plen_det - 1]
    if pd_last[0] != 2 or pd_last[1] != 0
        print("FAIL grid_astar detour path end: got=[" + str(pd_last[0]) + "," + str(pd_last[1]) + "]")
        exit(1)

    // The path must pass through y>=1 (detour downward, since (1,0),(1,1) blocked).
    // Check the path goes through (0,1) which is the first step of the detour.
    let has_01 = _ga_path_has(path_det, 0, 1)
    let has_02 = _ga_path_has(path_det, 0, 2)
    if has_01 != true and has_02 != true
        print("FAIL grid_astar detour path doesn't visit y>=1 column x=0")
        exit(1)

    // ── KAT 6: goal walled-off returns [] ────────────────────────────────────
    let g_walled = ga_new(3, 3)
    ga_set_wall(g_walled, 2, 0)
    ga_set_wall(g_walled, 2, 1)
    ga_set_wall(g_walled, 2, 2)
    let path_nope = ga_find_path(g_walled, 0, 0, 2, 1, false)
    let plen_nope = ga_path_length(path_nope)
    if plen_nope != 0
        print("FAIL grid_astar blocked goal should return []: got length=" + str(plen_nope))
        exit(1)

    // ── KAT 7: ga_reachable — fully walled goal ───────────────────────────────
    let reach1 = ga_reachable(g_walled, 0, 0, 2, 1)
    if reach1 != false
        print("FAIL grid_astar ga_reachable walled goal: got=" + str(reach1) + " want=false")
        exit(1)

    // Reachable on empty grid.
    let reach2 = ga_reachable(g_empty, 0, 0, 4, 4)
    if reach2 != true
        print("FAIL grid_astar ga_reachable empty grid: got=" + str(reach2) + " want=true")
        exit(1)

    // ── KAT 8: goal is a wall — returns [] ───────────────────────────────────
    let g_gwall = ga_new(3, 3)
    ga_set_wall(g_gwall, 2, 2)
    let path_gwall = ga_find_path(g_gwall, 0, 0, 2, 2, false)
    if ga_path_length(path_gwall) != 0
        print("FAIL grid_astar wall-as-goal should return []: got length=" + str(ga_path_length(path_gwall)))
        exit(1)

    // ── KAT 9: start == goal ─────────────────────────────────────────────────
    let path_same = ga_find_path(g_empty, 2, 2, 2, 2, false)
    let plen_same = ga_path_length(path_same)
    if plen_same != 1
        print("FAIL grid_astar start==goal path length: got=" + str(plen_same) + " want=1")
        exit(1)
    let psame0 = path_same[0]
    if psame0[0] != 2 or psame0[1] != 2
        print("FAIL grid_astar start==goal cell: got=[" + str(psame0[0]) + "," + str(psame0[1]) + "]")
        exit(1)

    // ── KAT 10: ga_octile sanity (pure-diagonal should be ~1.414) ────────────
    // Tolerance 0.001 around 1.4142.
    let oct_diag = ga_octile(0, 0, 1, 1)
    let oct_lo = 1.413
    let oct_hi = 1.415
    if oct_diag < oct_lo or oct_diag > oct_hi
        print("FAIL grid_astar ga_octile(0,0,1,1): got=" + str(oct_diag) + " want~1.4142")
        exit(1)

    // Pure cardinal should be exact integer.
    let oct_card = ga_octile(0, 0, 3, 0)
    let oct_card_lo = 2.999
    let oct_card_hi = 3.001
    if oct_card < oct_card_lo or oct_card > oct_card_hi
        print("FAIL grid_astar ga_octile(0,0,3,0): got=" + str(oct_card) + " want~3.0")
        exit(1)

    // ── KAT 11: ga_neighbors 4-dir ───────────────────────────────────────────
    let g_nb = ga_new(3, 3)
    let nb_center = ga_neighbors(g_nb, 1, 1, false)
    let nb_cnt = len(nb_center)
    if nb_cnt != 4
        print("FAIL grid_astar ga_neighbors 4-dir center: got=" + str(nb_cnt) + " want=4")
        exit(1)

    // Corner cell (0,0) has only 2 cardinal neighbors.
    let nb_corner = ga_neighbors(g_nb, 0, 0, false)
    let nb_corner_cnt = len(nb_corner)
    if nb_corner_cnt != 2
        print("FAIL grid_astar ga_neighbors 4-dir corner: got=" + str(nb_corner_cnt) + " want=2")
        exit(1)

    // ── KAT 12: ga_neighbors 8-dir ───────────────────────────────────────────
    let nb_center8 = ga_neighbors(g_nb, 1, 1, true)
    let nb_cnt8 = len(nb_center8)
    if nb_cnt8 != 8
        print("FAIL grid_astar ga_neighbors 8-dir center: got=" + str(nb_cnt8) + " want=8")
        exit(1)

    // Corner (0,0) has 3 neighbors in 8-dir (right, down, diagonal).
    let nb_corner8 = ga_neighbors(g_nb, 0, 0, true)
    let nb_corner8_cnt = len(nb_corner8)
    if nb_corner8_cnt != 3
        print("FAIL grid_astar ga_neighbors 8-dir corner: got=" + str(nb_corner8_cnt) + " want=3")
        exit(1)

    print("PASS _grid_astar_test")
