// Forge T2.7: with_tx -- atomic DB transactions on a pooled connection. A body returning ok(..) commits
// (the row survives); a body returning err(..) rolls back (the row is discarded). Real sqlite (a temp
// file), socketless, deterministic, kill-on-timeout.
import forge_db
import sqlitex

fn ins_ok(db)
    db_query(db, "INSERT INTO t (v) VALUES (?)", ["committed"])
    ok(1)

fn ins_err(db)
    db_query(db, "INSERT INTO t (v) VALUES (?)", ["rolledback"])
    err("simulated failure mid-transaction")

fn row_count(pool) -> int
    let rows = pool_query(pool, "SELECT COUNT(*) FROM t", [])
    parse_int(rows[0][0])

fn main()
    let pool = pool_open("_withtx_test.db", 1)
    pool_query(pool, "DROP TABLE IF EXISTS t", [])
    pool_query(pool, "CREATE TABLE t (v TEXT)", [])

    // committed transaction: body returns ok -> COMMIT -> row persists
    let r1 = with_tx(pool, ins_ok)
    if is_ok(r1) == false
        print("FAIL: ok-body tx should return ok")
        exit(1)
    if row_count(pool) != 1
        print("FAIL: committed insert should leave 1 row, got " + str(row_count(pool)))
        exit(1)

    // rolled-back transaction: body returns err -> ROLLBACK -> row discarded (count stays 1)
    let r2 = with_tx(pool, ins_err)
    if is_err(r2) == false
        print("FAIL: err-body tx should return err")
        exit(1)
    if row_count(pool) != 1
        print("FAIL: rolled-back insert must NOT persist; count should be 1, got " + str(row_count(pool)))
        exit(1)

    print("PASS forge_with_tx (commit-on-ok keeps the row; rollback-on-err discards it)")
