import std/gametheory/subtraction_game

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _subtraction_game_test " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gs = "false"
    if got
        gs = "true"
    let ws = "false"
    if want
        ws = "true"
    if got != want
        print("FAIL _subtraction_game_test " + label + ": got " + gs + " want " + ws)
        exit(1)

fn ckl(label: string, got, want)
    let gl = len(got)
    let wl = len(want)
    if gl != wl
        print("FAIL _subtraction_game_test " + label + " len: got " + str(gl) + " want " + str(wl))
        exit(1)
    let i = 0
    while i < gl
        if got[i] != want[i]
            print("FAIL _subtraction_game_test " + label + "[" + str(i) + "]: got " + str(got[i]) + " want " + str(want[i]))
            exit(1)
        i = i + 1

fn mk3(a: int, b: int, c: int) -> list
    let xs = []
    push(xs, a)
    push(xs, b)
    push(xs, c)
    xs

fn mk2(a: int, b: int) -> list
    let xs = []
    push(xs, a)
    push(xs, b)
    xs

fn main()
    // KAT: sg_grundy with moves=[1,2,3]
    let m123 = mk3(1, 2, 3)
    cki("grundy(0,[1,2,3])", sg_grundy(0, m123), 0)
    cki("grundy(3,[1,2,3])", sg_grundy(3, m123), 3)
    cki("grundy(4,[1,2,3])", sg_grundy(4, m123), 0)
    cki("grundy(5,[1,2,3])", sg_grundy(5, m123), 1)

    // KAT: sg_grundy with moves=[1,2]
    let m12 = mk2(1, 2)
    cki("grundy(6,[1,2])", sg_grundy(6, m12), 0)
    cki("grundy(4,[1,2])", sg_grundy(4, m12), 1)

    // KAT: sg_is_winning
    ckb("is_winning(4,[1,2,3])", sg_is_winning(4, m123), false)
    ckb("is_winning(3,[1,2,3])", sg_is_winning(3, m123), true)

    // KAT: sg_grundy_seq for moves=[1,2,3], check first 7 entries
    let seq = sg_grundy_seq(6, m123)
    let want_seq = []
    push(want_seq, 0)
    push(want_seq, 1)
    push(want_seq, 2)
    push(want_seq, 3)
    push(want_seq, 0)
    push(want_seq, 1)
    push(want_seq, 2)
    ckl("grundy_seq(6,[1,2,3])", seq, want_seq)

    // Edge: n=0 is always P-position (Grundy 0) regardless of moves
    cki("grundy(0,[1,2])", sg_grundy(0, m12), 0)
    ckb("is_winning(0,[1,2])", sg_is_winning(0, m12), false)

    print("PASS _subtraction_game_test")
