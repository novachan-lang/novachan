import forge_connection_manager

fn main()
    let c = cm_new(3)
    assert(cm_active_count(c) == 0, "none active")
    assert(cm_available(c) == 3, "3 available")

    let r1 = cm_open(c, "db-1", "localhost:5432")
    c = r1["c"]
    assert(r1["ok"] == 1, "db-1 opened")
    assert(cm_active_count(c) == 1, "1 active")
    assert(cm_is_open(c, "db-1") == 1, "db-1 open")

    let r2 = cm_open(c, "cache-1", "localhost:6379")
    c = r2["c"]
    let r3 = cm_open(c, "mq-1", "localhost:5672")
    c = r3["c"]
    assert(cm_active_count(c) == 3, "3 active")
    assert(cm_available(c) == 0, "0 available")
    assert(cm_utilization(c) == 100, "100% util")

    let r4 = cm_open(c, "extra", "localhost:9999")
    c = r4["c"]
    assert(r4["ok"] == 0, "pool full")
    assert(r4["reason"] == "pool_full", "reason")

    c = cm_close(c, "cache-1")
    assert(cm_active_count(c) == 2, "2 after close")
    assert(cm_is_open(c, "cache-1") == 0, "cache closed")

    let g = cm_get(c, "db-1")
    assert(g["found"] == 1, "found db-1")
    assert(g["addr"] == "localhost:5432", "addr match")
    assert(g["status"] == "open", "status open")

    let g2 = cm_get(c, "unknown")
    assert(g2["found"] == 0, "unknown not found")

    print("CONNECTION-MANAGER KAT PASS")
