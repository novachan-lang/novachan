import forge_watermark_tracker

fn main()
    let w = wt_new()
    w = wt_record(w, "cpu", 50)
    w = wt_record(w, "cpu", 80)
    w = wt_record(w, "cpu", 30)
    w = wt_record(w, "mem", 60)

    let cur = wt_current(w, "cpu")
    assert(is_ok(cur), "current ok")
    assert(unwrap(cur) == 30, "current=30")

    let hi = wt_high(w, "cpu")
    assert(is_ok(hi), "high ok")
    assert(unwrap(hi) == 80, "high=80")

    let lo = wt_low(w, "cpu")
    assert(is_ok(lo), "low ok")
    assert(unwrap(lo) == 30, "low=30")

    let rng = wt_range(w, "cpu")
    assert(is_ok(rng), "range ok")
    assert(unwrap(rng) == 50, "range=50")

    assert(wt_metric_count(w) == 2, "2 metrics")

    let bad = wt_current(w, "nope")
    assert(is_err(bad), "not found")

    print("WATERMARK-TRACKER KAT PASS")
