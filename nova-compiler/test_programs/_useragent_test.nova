import std/net/useragent

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn main()
    // --- KAT 1: Chrome on Windows desktop ---
    let ua1 = "Mozilla/5.0 (Windows NT 10.0) Chrome/120.0"
    cks("kat1_browser", ua_browser(ua1), "Chrome")
    cks("kat1_os",      ua_os(ua1),      "Windows")
    ckb("kat1_mobile",  ua_is_mobile(ua1), false)

    // --- KAT 2: Chrome on Android mobile ---
    let ua2 = "Mozilla/5.0 (Linux; Android 13) Chrome/120 Mobile"
    cks("kat2_browser", ua_browser(ua2), "Chrome")
    cks("kat2_os",      ua_os(ua2),      "Android")
    ckb("kat2_mobile",  ua_is_mobile(ua2), true)

    // --- KAT 3: Firefox on macOS ---
    let ua3 = "Mozilla/5.0 (Macintosh; Intel Mac OS X 10.15) Gecko/20100101 Firefox/121.0"
    cks("kat3_browser", ua_browser(ua3), "Firefox")
    cks("kat3_os",      ua_os(ua3),      "macOS")
    ckb("kat3_mobile",  ua_is_mobile(ua3), false)

    // --- KAT 4: Edge (must NOT be detected as Chrome) ---
    let ua4 = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/120.0.0.0 Safari/537.36 Edg/120.0.0.0"
    cks("kat4_browser", ua_browser(ua4), "Edge")
    cks("kat4_os",      ua_os(ua4),      "Windows")
    ckb("kat4_mobile",  ua_is_mobile(ua4), false)

    // --- KAT 5: Safari on iOS (iPhone) ---
    let ua5 = "Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X) AppleWebKit/605.1.15 Mobile/15E148 Safari/604.1"
    cks("kat5_browser", ua_browser(ua5), "Safari")
    cks("kat5_os",      ua_os(ua5),      "iOS")
    ckb("kat5_mobile",  ua_is_mobile(ua5), true)

    // --- KAT 6: unknown / curl ---
    let ua6 = "curl/7.88.1"
    cks("kat6_browser", ua_browser(ua6), "unknown")
    cks("kat6_os",      ua_os(ua6),      "unknown")
    ckb("kat6_mobile",  ua_is_mobile(ua6), false)

    // --- KAT 7: iPad is iOS not macOS ---
    let ua7 = "Mozilla/5.0 (iPad; CPU OS 16_0 like Mac OS X) AppleWebKit/605.1.15 Mobile/15E148"
    cks("kat7_os",     ua_os(ua7),     "iOS")
    ckb("kat7_mobile", ua_is_mobile(ua7), true)

    // --- KAT 8: Linux desktop (not Android) ---
    let ua8 = "Mozilla/5.0 (X11; Linux x86_64) Gecko/20100101 Firefox/118.0"
    cks("kat8_browser", ua_browser(ua8), "Firefox")
    cks("kat8_os",      ua_os(ua8),      "Linux")
    ckb("kat8_mobile",  ua_is_mobile(ua8), false)

    print("_useragent_test passed")
