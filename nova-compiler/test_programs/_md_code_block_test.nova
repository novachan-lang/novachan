import std/text/md_code_block

fn cks(got, expected, label)
    if got != expected
        print("FAIL md_code_block " + label + ": got [" + got + "]")
        exit(1)

fn main()
    let nl = chr(10)
    let fence = "```"

    // KAT-1: basic fenced block, single content line
    let input1 = fence + nl + "let x = 1" + nl + fence
    let r1 = md_code_block(input1)
    let e1 = "<pre><code>let x = 1</code></pre>"
    cks(r1, e1, "basic single line")

    // KAT-2: language tag on opening fence is ignored
    let input2 = fence + "python" + nl + "x = 1" + nl + fence
    let r2 = md_code_block(input2)
    let e2 = "<pre><code>x = 1</code></pre>"
    cks(r2, e2, "language tag ignored")

    // KAT-3: HTML escaping — < becomes &lt;
    let input3 = fence + nl + "if a < b" + nl + fence
    let r3 = md_code_block(input3)
    let e3 = "<pre><code>if a &lt; b</code></pre>"
    cks(r3, e3, "lt escape")

    // KAT-4: HTML escaping — > becomes &gt;
    let input4 = fence + nl + "a > b" + nl + fence
    let r4 = md_code_block(input4)
    let e4 = "<pre><code>a &gt; b</code></pre>"
    cks(r4, e4, "gt escape")

    // KAT-5: HTML escaping — & becomes &amp;
    let input5 = fence + nl + "a && b" + nl + fence
    let r5 = md_code_block(input5)
    let e5 = "<pre><code>a &amp;&amp; b</code></pre>"
    cks(r5, e5, "amp escape")

    // KAT-6: multiple content lines, inner newlines preserved
    let input6 = fence + nl + "line1" + nl + "line2" + nl + fence
    let r6 = md_code_block(input6)
    let e6 = "<pre><code>line1" + nl + "line2</code></pre>"
    cks(r6, e6, "multi-line content")

    // KAT-7: md_code_escape directly
    let r7 = md_code_escape("<b>Hello & World</b>")
    let e7 = "&lt;b&gt;Hello &amp; World&lt;/b&gt;"
    cks(r7, e7, "escape direct")

    print("PASS _md_code_block_test")
