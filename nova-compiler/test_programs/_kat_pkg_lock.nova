// #26 pkg-manager: nova.lock reproducibility. `nova install` now honors an existing lockfile
// (exact pinned versions) and writes one otherwise. The network install needs a registry, but the
// lockfile round-trip IS the verifiable core of reproducibility — tested here end-to-end.
fn main() -> int
    let fails = 0
    let lock = {}
    lock["forge"] = "1.2.0"
    lock["json"] = "0.4.1"
    if lockfile_write("_kat_test.lock", lock) != 1
        print("FAIL lockfile_write")
        fails = fails + 1
    let back = lockfile_read("_kat_test.lock")
    if back == 0
        print("FAIL lockfile_read returned 0")
        fails = fails + 1
    else
        if back["forge"] != "1.2.0"
            print("FAIL forge version")
            fails = fails + 1
        if back["json"] != "0.4.1"
            print("FAIL json version")
            fails = fails + 1
    remove_file("_kat_test.lock")
    if fails == 0
        print("PASS _kat_pkg_lock")
    else
        print("FAILED _kat_pkg_lock")
    return 0
