import std/interval/interval_overlap

// iv_eq2: compare two 2-element interval lists for exact equality.
fn iv_eq2(a, b) -> bool
    if len(a) != 2
        return false
    if len(b) != 2
        return false
    if a[0] != b[0]
        return false
    if a[1] != b[1]
        return false
    return true

fn ck(label: string, got, want)
    if iv_eq2(got, want) == false
        print("FAIL " + label + ": got=[" + str(got[0]) + "," + str(got[1]) + "] want=[" + str(want[0]) + "," + str(want[1]) + "]")
        exit(1)

fn cke(label: string, got)
    if len(got) != 0
        print("FAIL " + label + ": expected empty list, got len=" + str(len(got)))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckf(label: string, got: float, want: float)
    let diff = got - want
    if diff < 0.0
        diff = 0.0 - diff
    if diff > 0.0001
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck2(label: string, got, w0, w1)
    if len(got) != 2
        print("FAIL " + label + ": list len=" + str(len(got)))
        exit(1)
    let g0 = got[0]
    let g1 = got[1]
    if iv_eq2(g0, w0) == false
        print("FAIL " + label + "[0]: got=[" + str(g0[0]) + "," + str(g0[1]) + "]")
        exit(1)
    if iv_eq2(g1, w1) == false
        print("FAIL " + label + "[1]: got=[" + str(g1[0]) + "," + str(g1[1]) + "]")
        exit(1)

fn main()
    // io_overlaps([1,3],[2,4]) == true
    ckb("overlaps-yes", io_overlaps([1, 3], [2, 4]), true)

    // io_overlaps([1,2],[3,4]) == false
    ckb("overlaps-no", io_overlaps([1, 2], [3, 4]), false)

    // io_overlaps([1,2],[2,3]) == true (touch)
    ckb("overlaps-touch", io_overlaps([1, 2], [2, 3]), true)

    // io_overlaps([5,7],[1,3]) == false
    ckb("overlaps-rev", io_overlaps([5, 7], [1, 3]), false)

    // io_intersection([1,3],[2,4]) == [2,3]
    let i1 = io_intersection([1, 3], [2, 4])
    ck("inter-yes", i1, [2, 3])

    // io_intersection([1,2],[3,4]) == []
    let i2 = io_intersection([1, 2], [3, 4])
    cke("inter-no", i2)

    // io_intersection([1,5],[2,3]) == [2,3] (containment)
    let i3 = io_intersection([1, 5], [2, 3])
    ck("inter-contain", i3, [2, 3])

    // io_overlap_length([1,4],[2,6]) == 2.0
    ckf("olen-yes", io_overlap_length([1, 4], [2, 6]), 2.0)

    // io_overlap_length([1,2],[3,4]) == 0.0
    ckf("olen-no", io_overlap_length([1, 2], [3, 4]), 0.0)

    // io_overlap_length([1,2],[2,3]) == 0.0 (touch: single point has length 0)
    ckf("olen-touch", io_overlap_length([1, 2], [2, 3]), 0.0)

    // io_is_disjoint([1,2],[3,4]) == true
    ckb("disj-yes", io_is_disjoint([1, 2], [3, 4]), true)

    // io_is_disjoint([1,3],[2,4]) == false
    ckb("disj-no", io_is_disjoint([1, 3], [2, 4]), false)

    // io_touches([1,2],[2,3]) == true
    ckb("touch-yes", io_touches([1, 2], [2, 3]), true)

    // io_touches([1,2],[3,4]) == false
    ckb("touch-no", io_touches([1, 2], [3, 4]), false)

    // io_touches([1,3],[2,4]) == false (overlap, not just touch)
    ckb("touch-overlap", io_touches([1, 3], [2, 4]), false)

    // io_gap([1,2],[5,7]) == [2,5]
    let g1 = io_gap([1, 2], [5, 7])
    ck("gap-yes", g1, [2, 5])

    // io_gap([1,3],[2,4]) == [] (overlapping)
    let g2 = io_gap([1, 3], [2, 4])
    cke("gap-no", g2)

    // io_union_if_overlap([1,3],[2,5]) == [1,5]
    let u1 = io_union_if_overlap([1, 3], [2, 5])
    ck("union-yes", u1, [1, 5])

    // io_union_if_overlap([1,2],[4,5]) == []
    let u2 = io_union_if_overlap([1, 2], [4, 5])
    cke("union-no", u2)

    // io_contains([1,10],[3,7]) == true
    ckb("contains-yes", io_contains([1, 10], [3, 7]), true)

    // io_contains([1,5],[3,7]) == false
    ckb("contains-no", io_contains([1, 5], [3, 7]), false)

    // io_symmetric_diff([1,3],[5,7]) == [[1,3],[5,7]] (disjoint)
    let sd1 = io_symmetric_diff([1, 3], [5, 7])
    ck2("sdiff-disj", sd1, [1, 3], [5, 7])

    // io_symmetric_diff([1,3],[2,5]) == [[1,2],[3,5]]
    let sd2 = io_symmetric_diff([1, 3], [2, 5])
    ck2("sdiff-overlap", sd2, [1, 2], [3, 5])

    print("PASS _interval_overlap_test")
