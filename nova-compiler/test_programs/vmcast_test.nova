// Value-model cast soundness (scalar): float()/int() must UNBOX an Any-typed boxed
// number — e.g. a scalar float straight out of json_decode. Before the fix,
// float(json_decode("2.5")) read the box POINTER as a double and returned garbage
// (~1.6e12). A real pattern: reading a numeric config value out of decoded JSON.
//
// (Scope note: this fixes the SCALAR boxed-any case. float() of a dict/list ELEMENT
//  still hits the separate float(float)/element-unbox path — tracked, not this fix.)

fn main()
    let f = json_decode("2.5")
    assert_near(float(f), 2.5, 0.0001)
    assert_near(float(f) + 1.0, 3.5, 0.0001)
    assert_eq(int(f), 2)

    let four = json_decode("4.0")
    assert_near(float(four) * 2.0, 8.0, 0.0001)

    // int() truncates a boxed float toward zero
    assert_eq(int(json_decode("9.9")), 9)
    assert_eq(int(json_decode("3.2")), 3)

    print("vmcast passed")
