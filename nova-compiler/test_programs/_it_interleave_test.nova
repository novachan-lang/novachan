import std/itertools/it_interleave

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckflat(label: string, got, want)
    let gn = len(got)
    let wn = len(want)
    if gn != wn
        print("FAIL " + label + "_len: got=" + str(gn) + " want=" + str(wn))
        exit(1)
    let i = 0
    while i < wn
        if got[i] != want[i]
            print("FAIL " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn cknest(label: string, got, want)
    let gn = len(got)
    let wn = len(want)
    if gn != wn
        print("FAIL " + label + "_outerlen: got=" + str(gn) + " want=" + str(wn))
        exit(1)
    let i = 0
    while i < wn
        let gr = got[i]
        let wr = want[i]
        let grl = len(gr)
        let wrl = len(wr)
        if grl != wrl
            print("FAIL " + label + "[" + str(i) + "]_len: got=" + str(grl) + " want=" + str(wrl))
            exit(1)
        let j = 0
        while j < wrl
            if gr[j] != wr[j]
                print("FAIL " + label + "[" + str(i) + "][" + str(j) + "]: got=" + str(gr[j]) + " want=" + str(wr[j]))
                exit(1)
            j = j + 1
        i = i + 1

fn main()
    // --- iti_interleave ---
    // equal length: [1,2,3],[4,5,6] -> [1,4,2,5,3,6]
    let il1 = iti_interleave([1, 2, 3], [4, 5, 6])
    ckflat("interleave_equal", il1, [1, 4, 2, 5, 3, 6])
    // a longer: [1,2,3],[4] -> [1,4,2,3]
    let il2 = iti_interleave([1, 2, 3], [4])
    ckflat("interleave_a_longer", il2, [1, 4, 2, 3])
    // b longer: [1],[2,3,4] -> [1,2,3,4]
    let il3 = iti_interleave([1], [2, 3, 4])
    ckflat("interleave_b_longer", il3, [1, 2, 3, 4])
    // both empty
    cki("interleave_both_empty", len(iti_interleave([], [])), 0)
    // a empty
    let il4 = iti_interleave([], [1, 2])
    ckflat("interleave_a_empty", il4, [1, 2])
    // b empty
    let il5 = iti_interleave([1, 2], [])
    ckflat("interleave_b_empty", il5, [1, 2])
    // single each
    let il6 = iti_interleave([9], [8])
    ckflat("interleave_single", il6, [9, 8])

    // --- iti_intersperse ---
    // basic: [1,2,3], 0 -> [1,0,2,0,3]
    let is1 = iti_intersperse([1, 2, 3], 0)
    ckflat("intersperse_basic", is1, [1, 0, 2, 0, 3])
    // single element: [1], 0 -> [1]
    let is2 = iti_intersperse([1], 0)
    ckflat("intersperse_single", is2, [1])
    // empty
    cki("intersperse_empty", len(iti_intersperse([], 0)), 0)
    // two elements
    let is3 = iti_intersperse([5, 6], 9)
    ckflat("intersperse_two", is3, [5, 9, 6])
    // sep=99
    let is4 = iti_intersperse([1, 2, 3, 4], 99)
    ckflat("intersperse_four", is4, [1, 99, 2, 99, 3, 99, 4])

    // --- iti_roundrobin ---
    // basic: [[1,2],[3,4],[5,6]] -> [1,3,5,2,4,6]
    let rr1 = iti_roundrobin([[1, 2], [3, 4], [5, 6]])
    ckflat("rr_basic", rr1, [1, 3, 5, 2, 4, 6])
    // unequal lengths: [[1,2],[3]] -> [1,3,2]
    let rr2 = iti_roundrobin([[1, 2], [3]])
    ckflat("rr_unequal", rr2, [1, 3, 2])
    // single list: [[1,2,3]] -> [1,2,3]
    let rr3 = iti_roundrobin([[1, 2, 3]])
    ckflat("rr_single_list", rr3, [1, 2, 3])
    // empty outer
    cki("rr_empty", len(iti_roundrobin([])), 0)
    // one empty inner list
    let rr4 = iti_roundrobin([[1, 2], []])
    ckflat("rr_one_empty_inner", rr4, [1, 2])

    // --- iti_weave ---
    // [1,2,3],[4,5] -> [1,4,2,5]
    let w1 = iti_weave([1, 2, 3], [4, 5])
    ckflat("weave_a_longer", w1, [1, 4, 2, 5])
    // equal: [1,2],[3,4] -> [1,3,2,4]
    let w2 = iti_weave([1, 2], [3, 4])
    ckflat("weave_equal", w2, [1, 3, 2, 4])
    // b shorter: [1,2],[3] -> [1,3]
    let w3 = iti_weave([1, 2], [3])
    ckflat("weave_b_shorter", w3, [1, 3])
    // both empty
    cki("weave_both_empty", len(iti_weave([], [])), 0)
    // a empty
    cki("weave_a_empty", len(iti_weave([], [1, 2])), 0)
    // single pair
    let w4 = iti_weave([7], [8])
    ckflat("weave_single", w4, [7, 8])

    // --- ROUND-TRIP: iti_intersperse then remove seps re-yields original ---
    // Verify: elements at even indices of interspersed list are original elements
    let orig = [10, 20, 30]
    let isp = iti_intersperse(orig, 0)
    // isp has len 5; elements at 0,2,4 are 10,20,30
    cki("intersperse_rt_len", len(isp), 5)
    cki("intersperse_rt_0", isp[0], 10)
    cki("intersperse_rt_2", isp[2], 20)
    cki("intersperse_rt_4", isp[4], 30)
    cki("intersperse_rt_sep1", isp[1], 0)
    cki("intersperse_rt_sep3", isp[3], 0)

    print("PASS _it_interleave_test")
