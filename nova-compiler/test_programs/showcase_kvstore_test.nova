// showcase_kvstore -- a mini in-memory key-value database with a Redis-like command interface, in
// pure NOVA. Combines many features in one app (where interaction bugs hide): command tokenizing,
// a dict-backed store, dynamic string values, integer INCR/DECR (parse + reformat), key existence,
// counting, and error handling for malformed commands. Each command returns a response string; a
// scripted session is verified end to end.

fn _get(store: dict, k: string) -> string
    if contains(store, k)
        return store[k]
    return ""

fn run_cmd(store: dict, line: string) -> string
    let parts = split(line, " ")
    if len(parts) == 0
        return "ERR empty"
    let cmd = parts[0]
    if cmd == "SET"
        if len(parts) < 3
            return "ERR SET needs key value"
        store[parts[1]] = parts[2]
        return "OK"
    else if cmd == "GET"
        if len(parts) < 2
            return "ERR GET needs key"
        if contains(store, parts[1])
            return store[parts[1]]
        return "(nil)"
    else if cmd == "DEL"
        if contains(store, parts[1])
            del(store, parts[1])
            return "1"
        return "0"
    else if cmd == "EXISTS"
        if contains(store, parts[1])
            return "1"
        return "0"
    else if cmd == "INCR"
        let cur = 0
        if contains(store, parts[1])
            cur = parse_int(store[parts[1]])
        cur = cur + 1
        store[parts[1]] = str(cur)
        return str(cur)
    else if cmd == "DECR"
        let cur = 0
        if contains(store, parts[1])
            cur = parse_int(store[parts[1]])
        cur = cur - 1
        store[parts[1]] = str(cur)
        return str(cur)
    else if cmd == "COUNT"
        return str(len(store))
    else if cmd == "APPEND"
        let old = _get(store, parts[1])
        store[parts[1]] = old + parts[2]
        return str(len(store[parts[1]]))
    return "ERR unknown command '" + cmd + "'"

fn main()
    let store = {}
    // scripted session: (command, expected response)
    assert(run_cmd(store, "SET name nova") == "OK", "SET returns OK")
    assert(run_cmd(store, "GET name") == "nova", "GET returns the value")
    assert(run_cmd(store, "GET missing") == "(nil)", "GET missing -> (nil)")
    assert(run_cmd(store, "EXISTS name") == "1", "EXISTS present -> 1")
    assert(run_cmd(store, "EXISTS ghost") == "0", "EXISTS absent -> 0")

    // counter via INCR/DECR (string<->int round-trip through the store)
    assert(run_cmd(store, "INCR hits") == "1", "INCR from absent -> 1")
    assert(run_cmd(store, "INCR hits") == "2", "INCR again -> 2")
    assert(run_cmd(store, "INCR hits") == "3", "INCR again -> 3")
    assert(run_cmd(store, "DECR hits") == "2", "DECR -> 2")
    assert(run_cmd(store, "GET hits") == "2", "GET the counter -> 2")

    // APPEND builds a string
    assert(run_cmd(store, "SET greet Hel") == "OK", "SET greet")
    assert(run_cmd(store, "APPEND greet lo") == "5", "APPEND -> new length 5")
    assert(run_cmd(store, "GET greet") == "Hello", "APPEND result is Hello")

    // COUNT + DEL
    let n_before = parse_int(run_cmd(store, "COUNT"))
    assert(run_cmd(store, "DEL name") == "1", "DEL present -> 1")
    assert(run_cmd(store, "DEL name") == "0", "DEL again -> 0")
    let n_after = parse_int(run_cmd(store, "COUNT"))
    assert(n_after == n_before - 1, "COUNT drops by 1 after DEL")

    // error handling
    assert(run_cmd(store, "SET") == "ERR SET needs key value", "SET arity error")
    assert(run_cmd(store, "FLUSHALL now") == "ERR unknown command 'FLUSHALL'", "unknown command error")

    print("final COUNT = " + run_cmd(store, "COUNT") + ", hits = " + run_cmd(store, "GET hits"))
    print("showcase_kvstore_test passed -- mini KV database: commands + store + INCR + errors, pure NOVA")
