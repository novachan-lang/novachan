// KAT for prism/ui/prism_ui_drawer.nova -- the `ui/` composition layer's drawer/sidebar
// overlay-panel components: drawer(), sidebar(), triggered(), nav().
//
// Every expected shape below is verified structurally via prism_node.prism_node_kind_str /
// prism_node_children / prism_node_attr_str against the composition documented in
// prism_ui_drawer.nova's own comments -- never taken on faith from the implementation.
//   1. Drawer (open): layer[backdrop(label,""), panel]; panel = stack[header, gap, body];
//      header = band[label(title), press("Close drawer", [label("X")])]; body = stack(content).
//      Exercised with 1 content item and with 2 (order-preserving). Rejects an empty title, an
//      empty content list, a non-PrismNode content element -- and unconditionally validates
//      title/content even when open == false (proven separately from case 2).
//   2. Drawer (closed): collapses to a bare label(""), regardless of content -- proven it is
//      NOT a layer/stack at all.
//   3. Sidebar: band[stack(nav_items), stack(main_content)], always present (no open flag).
//      Rejects empty nav_items, empty main_content, a non-PrismNode element in either list.
//   4. Triggered: layer[press(trigger_label -> "Open "+title, [label]), drawer(title, content,
//      open)]. Proven with open=true (inner layer) and open=false (inner label). Rejects an
//      empty trigger_label and propagates the inner drawer's own title/content validation.
//   5. Nav: stack of labels, "> " prefix at active_index, "  " elsewhere -- exact text checked
//      at index 0 and a later index. Rejects empty items, negative index, out-of-bounds index,
//      a non-string item.
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova into
// $NOVA_HOME/lib, so `import prism_node` / `import prism_ui_drawer` resolve.
//   ./gen3_test.exe _kat_prism_ui_drawer.nova
//   clang -O2 -o _kat_prism_ui_drawer.exe _kat_prism_ui_drawer.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_ui_drawer.exe

import prism_node
import prism_content
import prism_arrange
import prism_interact
import prism_ui_drawer

let FAILED = [0]

fn _check(label: string, got: string, want: string)
    if got == want
        print("  pass  " + label)
    else
        print("  FAIL  " + label + "  got=" + got + "  want=" + want)
        FAILED[0] = FAILED[0] + 1

fn _check_true(label: string, cond: bool)
    if cond
        print("  pass  " + label)
    else
        print("  FAIL  " + label)
        FAILED[0] = FAILED[0] + 1

fn _lbl(s: string) -> PrismNode
    unwrap(prism_content.prism_label(s))

fn main()
    // ── 1. Drawer (open) ─────────────────────────────────────────────────────────────────────
    print("== 1. drawer (open) ==")

    let item1 = _lbl("Body text")
    let d1 = prism_ui_drawer.prism_dr_drawer("Settings", [item1], true)
    _check_true("drawer(open) is_ok", is_ok(d1))
    let n1 = unwrap(d1)
    _check("drawer(open) kind == layer", prism_node.prism_node_kind_str(n1), "layer")
    let n1_kids = prism_node.prism_node_children(n1)
    _check("drawer(open) child_count == 2", str(len(n1_kids)), "2")
    _check("drawer(open) backdrop kind == label", prism_node.prism_node_kind_str(n1_kids[0]), "label")
    _check("drawer(open) backdrop text == \"\"", prism_node.prism_node_attr_str(n1_kids[0], "text", "MISSING"), "")
    _check("drawer(open) panel kind == stack", prism_node.prism_node_kind_str(n1_kids[1]), "stack")

    let panel_kids = prism_node.prism_node_children(n1_kids[1])
    _check("drawer(open) panel child_count == 3", str(len(panel_kids)), "3")
    _check("drawer(open) panel[0] (header) kind == band", prism_node.prism_node_kind_str(panel_kids[0]), "band")
    _check("drawer(open) panel[1] (gap) kind == gap", prism_node.prism_node_kind_str(panel_kids[1]), "gap")
    _check("drawer(open) panel[2] (body) kind == stack", prism_node.prism_node_kind_str(panel_kids[2]), "stack")

    let header_kids = prism_node.prism_node_children(panel_kids[0])
    _check("drawer(open) header child_count == 2", str(len(header_kids)), "2")
    _check("drawer(open) header title kind == label", prism_node.prism_node_kind_str(header_kids[0]), "label")
    _check("drawer(open) header title text == Settings", prism_node.prism_node_attr_str(header_kids[0], "text", ""), "Settings")
    _check("drawer(open) header close kind == press", prism_node.prism_node_kind_str(header_kids[1]), "press")
    let close_kids = prism_node.prism_node_children(header_kids[1])
    _check("drawer(open) close button child_count == 1", str(len(close_kids)), "1")
    _check("drawer(open) close button label text == X", prism_node.prism_node_attr_str(close_kids[0], "text", ""), "X")

    let body1_kids = prism_node.prism_node_children(panel_kids[2])
    _check("drawer(open) body(1 item) child_count == 1", str(len(body1_kids)), "1")
    _check("drawer(open) body[0] text == Body text", prism_node.prism_node_attr_str(body1_kids[0], "text", ""), "Body text")

    // Two content items -- order preserved through the body stack.
    let item2a = _lbl("First")
    let item2b = _lbl("Second")
    let d1b = prism_ui_drawer.prism_dr_drawer("Info", [item2a, item2b], true)
    _check_true("drawer(open, 2 items) is_ok", is_ok(d1b))
    let n1b_panel = prism_node.prism_node_children(unwrap(d1b))[1]
    let body2_kids = prism_node.prism_node_children(prism_node.prism_node_children(n1b_panel)[2])
    _check("drawer(open, 2 items) body child_count == 2", str(len(body2_kids)), "2")
    _check("drawer(open, 2 items) body[0] text == First", prism_node.prism_node_attr_str(body2_kids[0], "text", ""), "First")
    _check("drawer(open, 2 items) body[1] text == Second", prism_node.prism_node_attr_str(body2_kids[1], "text", ""), "Second")

    // ── 2. Drawer (closed) ───────────────────────────────────────────────────────────────────
    print("== 2. drawer (closed) ==")

    let d2 = prism_ui_drawer.prism_dr_drawer("Settings", [item1], false)
    _check_true("drawer(closed) is_ok", is_ok(d2))
    let n2 = unwrap(d2)
    _check("drawer(closed) kind == label (NOT layer)", prism_node.prism_node_kind_str(n2), "label")
    _check("drawer(closed) text == \"\"", prism_node.prism_node_attr_str(n2, "text", "MISSING"), "")

    // Unconditional validation: an empty title still errors even when closed.
    let d2_bad_title = prism_ui_drawer.prism_dr_drawer("", [item1], false)
    _check_true("drawer(closed) still rejects empty title", is_err(d2_bad_title))

    // ── 3. Drawer error paths ────────────────────────────────────────────────────────────────
    print("== 3. drawer error paths ==")

    let d_bad_title = prism_ui_drawer.prism_dr_drawer("", [item1], true)
    _check_true("drawer rejects empty title", is_err(d_bad_title))
    let d_bad_content = prism_ui_drawer.prism_dr_drawer("Settings", [], true)
    _check_true("drawer rejects empty content", is_err(d_bad_content))
    let d_bad_child = prism_ui_drawer.prism_dr_drawer("Settings", [5], true)
    _check_true("drawer rejects a non-PrismNode content element", is_err(d_bad_child))

    // ── 4. Sidebar ───────────────────────────────────────────────────────────────────────────
    print("== 4. sidebar ==")

    let nav1 = _lbl("Home")
    let nav2 = _lbl("Profile")
    let main1 = _lbl("Dashboard")
    let s1 = prism_ui_drawer.prism_dr_sidebar([nav1, nav2], [main1])
    _check_true("sidebar is_ok", is_ok(s1))
    let sn1 = unwrap(s1)
    _check("sidebar kind == band", prism_node.prism_node_kind_str(sn1), "band")
    let s1_kids = prism_node.prism_node_children(sn1)
    _check("sidebar child_count == 2", str(len(s1_kids)), "2")
    _check("sidebar[0] (nav) kind == stack", prism_node.prism_node_kind_str(s1_kids[0]), "stack")
    _check("sidebar[1] (main) kind == stack", prism_node.prism_node_kind_str(s1_kids[1]), "stack")

    let sidebar_nav_kids = prism_node.prism_node_children(s1_kids[0])
    _check("sidebar nav child_count == 2", str(len(sidebar_nav_kids)), "2")
    _check("sidebar nav[0] text == Home", prism_node.prism_node_attr_str(sidebar_nav_kids[0], "text", ""), "Home")
    _check("sidebar nav[1] text == Profile", prism_node.prism_node_attr_str(sidebar_nav_kids[1], "text", ""), "Profile")

    let sidebar_main_kids = prism_node.prism_node_children(s1_kids[1])
    _check("sidebar main child_count == 1", str(len(sidebar_main_kids)), "1")
    _check("sidebar main[0] text == Dashboard", prism_node.prism_node_attr_str(sidebar_main_kids[0], "text", ""), "Dashboard")

    // ── 5. Sidebar error paths ───────────────────────────────────────────────────────────────
    print("== 5. sidebar error paths ==")

    let s_bad_nav_empty = prism_ui_drawer.prism_dr_sidebar([], [main1])
    _check_true("sidebar rejects empty nav_items", is_err(s_bad_nav_empty))
    let s_bad_main_empty = prism_ui_drawer.prism_dr_sidebar([nav1], [])
    _check_true("sidebar rejects empty main_content", is_err(s_bad_main_empty))
    let s_bad_nav_elem = prism_ui_drawer.prism_dr_sidebar([nav1, 5], [main1])
    _check_true("sidebar rejects a non-PrismNode nav_item", is_err(s_bad_nav_elem))
    let s_bad_main_elem = prism_ui_drawer.prism_dr_sidebar([nav1], [main1, "not a node"])
    _check_true("sidebar rejects a non-PrismNode main_content element", is_err(s_bad_main_elem))

    // ── 6. Triggered (open) ──────────────────────────────────────────────────────────────────
    print("== 6. triggered (open) ==")

    let t1 = prism_ui_drawer.prism_dr_triggered("Open Menu", "Settings", [item1], true)
    _check_true("triggered(open) is_ok", is_ok(t1))
    let tn1 = unwrap(t1)
    _check("triggered(open) kind == layer", prism_node.prism_node_kind_str(tn1), "layer")
    let t1_kids = prism_node.prism_node_children(tn1)
    _check("triggered(open) child_count == 2", str(len(t1_kids)), "2")
    _check("triggered(open) trigger kind == press", prism_node.prism_node_kind_str(t1_kids[0]), "press")
    let trigger_kids = prism_node.prism_node_children(t1_kids[0])
    _check("triggered(open) trigger child_count == 1", str(len(trigger_kids)), "1")
    _check("triggered(open) trigger label text == Open Menu", prism_node.prism_node_attr_str(trigger_kids[0], "text", ""), "Open Menu")
    _check("triggered(open) inner drawer kind == layer", prism_node.prism_node_kind_str(t1_kids[1]), "layer")
    let inner_drawer_kids = prism_node.prism_node_children(t1_kids[1])
    _check("triggered(open) inner drawer child_count == 2", str(len(inner_drawer_kids)), "2")

    // ── 7. Triggered (closed) ────────────────────────────────────────────────────────────────
    print("== 7. triggered (closed) ==")

    let t2 = prism_ui_drawer.prism_dr_triggered("Open Menu", "Settings", [item1], false)
    _check_true("triggered(closed) is_ok", is_ok(t2))
    let t2_kids = prism_node.prism_node_children(unwrap(t2))
    _check("triggered(closed) child_count == 2", str(len(t2_kids)), "2")
    _check("triggered(closed) inner drawer kind == label (collapsed)", prism_node.prism_node_kind_str(t2_kids[1]), "label")
    _check("triggered(closed) inner drawer text == \"\"", prism_node.prism_node_attr_str(t2_kids[1], "text", "MISSING"), "")

    // ── 8. Triggered error paths ─────────────────────────────────────────────────────────────
    print("== 8. triggered error paths ==")

    let t_bad_trigger = prism_ui_drawer.prism_dr_triggered("", "Settings", [item1], true)
    _check_true("triggered rejects empty trigger_label", is_err(t_bad_trigger))
    let t_bad_inner = prism_ui_drawer.prism_dr_triggered("Open Menu", "", [item1], true)
    _check_true("triggered propagates inner drawer's empty-title rejection", is_err(t_bad_inner))

    // ── 9. Nav ───────────────────────────────────────────────────────────────────────────────
    print("== 9. nav ==")

    let items3 = ["Home", "Profile", "Settings"]
    let nv0 = prism_ui_drawer.prism_dr_nav(items3, 0)
    _check_true("nav(active=0) is_ok", is_ok(nv0))
    let nv0n = unwrap(nv0)
    _check("nav(active=0) kind == stack", prism_node.prism_node_kind_str(nv0n), "stack")
    let nv0_kids = prism_node.prism_node_children(nv0n)
    _check("nav(active=0) child_count == 3", str(len(nv0_kids)), "3")
    _check("nav(active=0) item0 text == \"> Home\"", prism_node.prism_node_attr_str(nv0_kids[0], "text", ""), "> Home")
    _check("nav(active=0) item1 text == \"  Profile\"", prism_node.prism_node_attr_str(nv0_kids[1], "text", ""), "  Profile")
    _check("nav(active=0) item2 text == \"  Settings\"", prism_node.prism_node_attr_str(nv0_kids[2], "text", ""), "  Settings")

    let nv2 = prism_ui_drawer.prism_dr_nav(items3, 2)
    _check_true("nav(active=2) is_ok", is_ok(nv2))
    let nv2_kids = prism_node.prism_node_children(unwrap(nv2))
    _check("nav(active=2) item0 text == \"  Home\"", prism_node.prism_node_attr_str(nv2_kids[0], "text", ""), "  Home")
    _check("nav(active=2) item2 text == \"> Settings\"", prism_node.prism_node_attr_str(nv2_kids[2], "text", ""), "> Settings")

    // ── 10. Nav error paths ──────────────────────────────────────────────────────────────────
    print("== 10. nav error paths ==")

    let nv_bad_empty = prism_ui_drawer.prism_dr_nav([], 0)
    _check_true("nav rejects empty items", is_err(nv_bad_empty))
    let nv_bad_neg = prism_ui_drawer.prism_dr_nav(items3, -1)
    _check_true("nav rejects negative active_index", is_err(nv_bad_neg))
    let nv_bad_oob = prism_ui_drawer.prism_dr_nav(items3, 3)
    _check_true("nav rejects out-of-bounds active_index", is_err(nv_bad_oob))
    let nv_bad_elem = prism_ui_drawer.prism_dr_nav(["Home", 5, "Settings"], 0)
    _check_true("nav rejects a non-string item", is_err(nv_bad_elem))

    // ── Summary ───────────────────────────────────────────────────────────────────────────────
    if FAILED[0] == 0
        print("")
        print("_kat_prism_ui_drawer: ALL PASS")
    else
        print("")
        print("_kat_prism_ui_drawer: " + str(FAILED[0]) + " FAILURE(S)")
        exit(1)
