// KAT for std/math/regression — known-answer tests with hand-computed values.
import std/math/regression

// ckf: check float within epsilon 0.0001
fn ckf(label: str, got: float, expected: float)
    let diff = got - expected
    let adiff = 0.0
    if diff < 0.0
        adiff = 0.0 - diff
    else
        adiff = diff
    if adiff > 0.0001
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn main()
    // KAT 1: reg_linear([1,2,3,4],[2,4,6,8]) = [2.0, 0.0]
    // Hand: mx=2.5, my=5.0, num=5.0, den=5.0 -> slope=1.0?
    // Actually: (1-2.5)*(2-5)=(-1.5)*(-3)=4.5, (2-2.5)*(4-5)=(-0.5)*(-1)=0.5,
    //           (3-2.5)*(6-5)=(0.5)*(1)=0.5, (4-2.5)*(8-5)=(1.5)*(3)=4.5
    // num=4.5+0.5+0.5+4.5=10.0
    // den=(1.5^2)+(0.5^2)+(0.5^2)+(1.5^2)=2.25+0.25+0.25+2.25=5.0
    // slope=10.0/5.0=2.0, intercept=5.0-2.0*2.5=5.0-5.0=0.0  -> [2.0, 0.0] ✓
    let r1 = reg_linear([1,2,3,4], [2,4,6,8])
    ckf("kat1_slope", r1[0]*1.0, 2.0)
    ckf("kat1_intercept", r1[1]*1.0, 0.0)

    // KAT 2: reg_r2([1,2,3,4],[2,4,6,8]) = 1.0 (perfect fit)
    let r2a = reg_r2([1,2,3,4], [2,4,6,8])
    ckf("kat2_r2", r2a, 1.0)

    // KAT 3: reg_predict(2.0, 0.0, 5.0) = 10.0
    let p1 = reg_predict(2.0, 0.0, 5.0)
    ckf("kat3_predict", p1, 10.0)

    // KAT 4: reg_linear([1,2,3],[3,5,7]) = [2.0, 1.0]
    // Hand: mx=2.0, my=5.0
    // num=(1-2)*(3-5)+(2-2)*(5-5)+(3-2)*(7-5)=(-1)*(-2)+0+1*2=2+0+2=4.0
    // den=(1-2)^2+(2-2)^2+(3-2)^2=1+0+1=2.0
    // slope=4.0/2.0=2.0, intercept=5.0-2.0*2.0=5.0-4.0=1.0  -> [2.0, 1.0] ✓
    let r2 = reg_linear([1,2,3], [3,5,7])
    ckf("kat4_slope", r2[0]*1.0, 2.0)
    ckf("kat4_intercept", r2[1]*1.0, 1.0)

    // KAT 5: reg_predict(2.0, 1.0, 10.0) = 21.0
    let p2 = reg_predict(2.0, 1.0, 10.0)
    ckf("kat5_predict", p2, 21.0)

    // KAT 6: reg_r2([1,2,3],[3,5,7]) = 1.0 (perfect fit)
    let r2b = reg_r2([1,2,3], [3,5,7])
    ckf("kat6_r2", r2b, 1.0)

    print("_regression_test passed")
