// Real WASM i64 + f64 oracle.
//  i64.wasm: main()->i64 = 1000000 * 1000000 = 1_000_000_000_000 (10^12).
//            Overflows i32 (would wrap to 2696279552), so a correct 10^12 proves real i64.
//  f64.wasm: main()->i32 = i32.trunc_f64_s(f64.const 3.5 + f64.const 1.5) = trunc(5.0) = 5.
//            Proves real f64 arithmetic + float->int conversion.
fn main()
    let m1 = wasm_compile("i64.wasm")
    assert_eq(m1 >= 0, true)
    assert_eq(wasm_run(m1), 1000000000000)
    wasm_free(m1)
    let m2 = wasm_compile("f64.wasm")
    assert_eq(m2 >= 0, true)
    assert_eq(wasm_run(m2), 5)
    wasm_free(m2)
    print("WASM i64/f64 test passed: 10^12 and trunc(3.5+1.5)=5")
