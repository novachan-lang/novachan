// clockx — monotonic vs wall clock as DISTINCT types.
//
// A monotonic Instant only ever moves forward (immune to NTP steps / clock
// adjustments) and is the ONLY correct source for measuring elapsed time. A WallTime
// is calendar time — it can jump backward when the system clock is corrected. Keeping
// them distinct types prevents the classic latency-measurement bug of subtracting two
// wall times (which can go negative or wildly wrong across a clock adjustment).
// Rule enforced by API shape: elapsed is defined on Instant, never on WallTime.

type Instant
    ns: int
type WallTime
    ms: int

fn now_monotonic() -> Instant
    return Instant(clock_ns())
fn now_wall() -> WallTime
    return WallTime(time_ms())

fn elapsed_ns(a, b) -> int          // a = earlier Instant, b = later Instant
    return b.ns - a.ns
fn elapsed_ms(a, b) -> int
    return (b.ns - a.ns) / 1000000

fn instant_after(a, dur_ns) -> Instant
    return Instant(a.ns + dur_ns)

fn wall_ms(w) -> int
    return w.ms

fn main()
    let t0 = now_monotonic()
    let acc = 0
    let i = 0
    while i < 200000
        acc = acc + i
        i = i + 1
    let t1 = now_monotonic()

    // monotonic: never goes backward
    let mono = 0
    if elapsed_ns(t0, t1) >= 0
        mono = 1
    assert_eq(mono, 1)

    // synthetic elapsed is exact (no wall-clock flakiness in the assertion)
    let base = Instant(1000)
    let later = instant_after(base, 500000000)   // +500ms in ns
    assert_eq(elapsed_ns(base, later), 500000000)
    assert_eq(elapsed_ms(base, later), 500)

    // wall clock is available and positive (ms since epoch)
    let w = now_wall()
    let wpos = 0
    if wall_ms(w) > 0
        wpos = 1
    assert_eq(wpos, 1)

    print("clockx passed")
