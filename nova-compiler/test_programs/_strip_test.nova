import std/term/strip

// ── helpers ───────────────────────────────────────────────────────────────────

fn cks(label, got, want)
    if got != want
        print("FAIL strip " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        print("  got  [" + got + "]")
        print("  want [" + want + "]")
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL strip " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    if got != want
        print("FAIL strip " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    let esc = chr(27)

    // ── KAT 1: strip_ansi basic SGR ──────────────────────────────────────────
    // strip_ansi(ESC[31m + "hi" + ESC[0m) == "hi"
    let s1 = esc + "[31m" + "hi" + esc + "[0m"
    cks("basic_sgr", strip_ansi(s1), "hi")

    // ── KAT 2: visible_len with SGR ──────────────────────────────────────────
    // visible_len(ESC[1m + "abc" + ESC[0m) == 3
    let s2 = esc + "[1m" + "abc" + esc + "[0m"
    cki("visible_len_sgr", visible_len(s2), 3)

    // ── KAT 3: plain string unchanged ────────────────────────────────────────
    cks("plain_unchanged", strip_ansi("plain"), "plain")

    // ── KAT 4: has_ansi false on plain ───────────────────────────────────────
    ckb("has_ansi_false", has_ansi("plain"), false)

    // ── KAT 5: has_ansi true on ESC[0m ───────────────────────────────────────
    let s5 = esc + "[0m"
    ckb("has_ansi_true", has_ansi(s5), true)

    // ── KAT 6: strip_ansi with 256-color param ESC[38;5;200m + "x" ──────────
    let s6 = esc + "[38;5;200m" + "x"
    cks("256color", strip_ansi(s6), "x")

    // ── KAT 7: visible_len of empty string ───────────────────────────────────
    cki("empty_visible_len", visible_len(""), 0)

    // ── KAT 8: strip_ansi on empty string ────────────────────────────────────
    cks("empty_strip", strip_ansi(""), "")

    // ── KAT 9: cursor-move CSI (not SGR — different final byte) ──────────────
    // ESC[2A = cursor up 2; final byte 'A' = ord 65, in [64..126]
    let s9 = esc + "[2A" + "ok"
    cks("csi_cursor", strip_ansi(s9), "ok")

    // ── KAT 10: OSC sequence (e.g. title set) ────────────────────────────────
    // OSC = ESC ] ... BEL(7)
    let s10 = esc + "]0;My Title" + chr(7) + "text"
    cks("osc_bel", strip_ansi(s10), "text")

    // ── KAT 11: OSC with ST terminator (ESC \) ───────────────────────────────
    let s11 = esc + "]0;Title" + esc + chr(92) + "text"
    cks("osc_st", strip_ansi(s11), "text")

    // ── KAT 12: adjacent sequences ───────────────────────────────────────────
    // ESC[1m + ESC[31m + "x" + ESC[0m
    let s12 = esc + "[1m" + esc + "[31m" + "x" + esc + "[0m"
    cks("adjacent_seqs", strip_ansi(s12), "x")
    cki("adjacent_visible", visible_len(s12), 1)

    // ── KAT 13: bare ESC at end (truncated) ──────────────────────────────────
    let s13 = "hi" + esc
    cks("lone_esc_end", strip_ansi(s13), "hi")

    // ── KAT 14: two-byte Fe escape (ESC M = reverse index) ───────────────────
    let s14 = esc + "M" + "z"
    cks("fe_escape", strip_ansi(s14), "z")

    // ── KAT 15: visible_len on string with no escapes ─────────────────────────
    cki("plain_visible_len", visible_len("hello"), 5)

    print("PASS _strip_test")
