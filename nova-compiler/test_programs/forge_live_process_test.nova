// Forge S5 LiveView: the per-connection live process. A counter live view -- view_fn renders [count],
// update_fn increments on "inc" / leaves state alone on "noop". Asserts: each inc emits a patch carrying
// only the changed slot with the new value; a no-op emits NOTHING (proved indirectly -- after noop the
// next inc's patch shows 2, not 1, so the noop put nothing on the wire); state persists across events.
// Socketless (channels only), deterministic, kill-on-timeout.
import forge_live

fn counter_view(state)
    [str(state["count"])]

fn counter_update(state, ev)
    let ns = {}
    if ev == "inc"
        ns["count"] = state["count"] + 1
    else
        ns["count"] = state["count"]
    ns

fn main()
    let s0 = {}
    s0["count"] = 0
    let lv = live_view(counter_view, counter_update, s0)

    // inc: 0 -> 1, patch slot 0 = "1"
    live_send(lv, "inc")
    let p1 = live_recv(lv)
    let c1 = p1["changed"]
    if len(c1) != 1 or c1[0]["i"] != 0 or str(c1[0]["val"]) != "1"
        print("FAIL: first inc should patch slot 0 -> 1")
        exit(1)

    // noop emits nothing; the NEXT inc takes count 1 -> 2. If noop had emitted, this recv would see "1".
    live_send(lv, "noop")
    live_send(lv, "inc")
    let p2 = live_recv(lv)
    let c2 = p2["changed"]
    if len(c2) != 1 or str(c2[0]["val"]) != "2"
        print("FAIL: noop must emit no patch; next inc -> 2 (got " + str(c2[0]["val"]) + ")")
        exit(1)

    print("PASS forge_live_process (live actor: per-event diff patch, no-op emits nothing, state persists)")
