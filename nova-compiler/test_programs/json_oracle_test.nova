// JSON oracle test — expected values derived from RFC 8259, not from our own output.
// Status after the integer-corruption fix: ints/strings/typed containers are correct.
// KNOWN EDGE (documented in IMPLEMENTATION_AUDIT.md #1): a standalone bool renders as 1/0,
// and heterogeneous mixed-primitive containers need the tagged value model. Not asserted here.

fn main()
    // Integer scalars — these were the corrupted cases (0->"null", 1->"true"). Now correct.
    assert_eq(json_encode(0), "0")
    assert_eq(json_encode(1), "1")
    assert_eq(json_encode(42), "42")
    assert_eq(json_encode(-7), "-7")

    // String scalar must be quoted per spec.
    assert_eq(json_encode("hello"), "\"hello\"")

    // THE KEY WIN: integers inside containers (number arrays) — extremely common in real JSON.
    // Previously [0,1,2] serialized as "[null,true,2]". Must now be exact.
    assert_eq(json_encode([0, 1, 2]), "[0,1,2]")
    assert_eq(json_encode([10, 0, 1, 99]), "[10,0,1,99]")

    // Decode a known array.
    let arr = json_decode("[1, 2, 3]")
    assert_eq(len(arr), 3)
    assert_eq(arr[0], 1)
    assert_eq(arr[2], 3)

    // Decode a known object. ('{' escaped as '\{' because NOVA uses {} for interpolation.)
    let obj = json_decode("\{\"x\": 10, \"y\": 20\}")
    assert_eq(obj["x"], 10)
    assert_eq(obj["y"], 20)

    // Nested structure with a number array.
    let nested = json_decode("\{\"name\": \"nova\", \"nums\": [4, 0, 6]\}")
    assert_eq(nested["name"], "nova")
    let nums = nested["nums"]
    assert_eq(len(nums), 3)
    assert_eq(nums[1], 0)

    // Round-trip: decode(encode(x)) must preserve integer values, including 0 and 1.
    assert_eq(json_decode(json_encode(0)), 0)
    assert_eq(json_decode(json_encode(1)), 1)
    assert_eq(json_decode(json_encode(123)), 123)

    print("JSON ORACLE: ALL PASSED")
