// JSON oracle test -- expected values derived from RFC 8259, not from our own output.
// Stage 1 of the JSON-native value model CLOSES the prior KNOWN EDGE: bool/null are now
// first-class (true stays true, null stays null -- NOT 1 / 0) and mixed-primitive containers
// round-trip faithfully. Fatal if+exit(1) (assert_eq is non-fatal). Objects escape braces
// (\{ \}) because NOVA uses {} for string interpolation. json_encode emits no spaces; %.15g floats.

fn check(got: string, want: string, label: string)
    if got != want
        print("FAIL " + label + ": got [" + got + "] want [" + want + "]")
        exit(1)

fn main()
    // --- integer / string scalars (unchanged: numbers stay bare, distinct from bool/null) ---
    check(json_encode(0), "0", "enc 0")
    check(json_encode(1), "1", "enc 1")
    check(json_encode(-7), "-7", "enc -7")
    check(json_encode("hello"), "\"hello\"", "enc string")

    // --- number arrays exact (the earlier integer-corruption win) ---
    check(json_encode([0, 1, 2]), "[0,1,2]", "enc [0,1,2]")
    check(json_encode([10, 0, 1, 99]), "[10,0,1,99]", "enc num array")

    // --- THE HEADLINE WIN: mixed bool/null/number/string round-trips faithfully ---
    let s = "[null,true,false,3,1.5,\"x\"]"
    check(json_encode(json_decode(s)), s, "mixed array round-trip")

    // --- bool survives as true (not 1) inside an object ---
    let o = "\{\"ok\":true\}"
    check(json_encode(json_decode(o)), o, "object bool round-trip")

    // --- null survives as null (not 0) inside an object ---
    let o2 = "\{\"v\":null\}"
    check(json_encode(json_decode(o2)), o2, "object null round-trip")

    // --- standalone literals ---
    check(json_encode(json_decode("null")), "null", "standalone null")
    check(json_encode(json_decode("true")), "true", "standalone true")
    check(json_encode(json_decode("false")), "false", "standalone false")

    // --- nested arrays of oddballs ---
    let n = "[[null],[true,false]]"
    check(json_encode(json_decode(n)), n, "nested oddballs")

    // --- numbers are NOT confused with bool/null (0 stays 0, 1 stays 1) ---
    let m = "[0,1,2,0.5]"
    check(json_encode(json_decode(m)), m, "number distinctness")

    // --- decode still yields usable typed values for the non-oddball path ---
    let arr = json_decode("[1, 2, 3]")
    if len(arr) != 3 or arr[0] != 1 or arr[2] != 3
        print("FAIL decode int array")
        exit(1)
    let obj = json_decode("\{\"x\": 10, \"y\": 20\}")
    if obj["x"] != 10 or obj["y"] != 20
        print("FAIL decode object ints")
        exit(1)

    // --- Stage 2: hardened matrix -- empty containers, realistic nested payload, escapes ---
    check(json_encode(json_decode("[]")), "[]", "empty array")
    check(json_encode(json_decode("\{\}")), "\{\}", "empty object")
    let payload = "\{\"users\":[\{\"name\":\"a\",\"active\":true,\"meta\":null\}],\"count\":1\}"
    check(json_encode(json_decode(payload)), payload, "realistic API payload")
    // bool/null as BOTH object values and array elements, alongside numbers/strings
    let mixed = "[\{\"k\":true\},\{\"k\":null\},\{\"k\":0\},\{\"k\":\"s\"\}]"
    check(json_encode(json_decode(mixed)), mixed, "mixed object values")

    // --- Stage 2: the binary term codec preserves bool/null too (term_encode/term_decode) ---
    // round-trip a mixed value through the binary wire, then back to JSON -> must match.
    let tv = json_decode("[null,true,false,7,2.5,\"y\"]")
    let back = json_encode(term_decode(term_encode(tv)))
    check(back, "[null,true,false,7,2.5,\"y\"]", "term codec round-trip")
    // term codec preserves a standalone null (was previously mis-encoded as float 0.0)
    check(json_encode(term_decode(term_encode(json_decode("null")))), "null", "term null")
    check(json_encode(term_decode(term_encode(json_decode("true")))), "true", "term true")

    print("json_oracle PASS")
