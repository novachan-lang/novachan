fn parse_host_port(addr)
  let colon = -1
  let i = len(addr) - 1
  while i >= 0
    if slice(addr, i, i + 1) == ":"
      colon = i
      i = -1
    i = i - 1
  if colon <= 0
    return err("missing port")
  let host = slice(addr, 0, colon)
  let port_str = slice(addr, colon + 1, len(addr))
  let port_r = parse_int_safe(port_str)
  if is_err(port_r)
    return err("invalid port: " + port_str)
  let port = unwrap(port_r)
  if port < 0 or port > 65535
    return err("port out of range: " + str(port))
  ok({"host": host, "port": port})

fn format_addr(host, port)
  host + ":" + str(port)

fn is_localhost(host)
  host == "localhost" or host == "127.0.0.1" or host == "::1" or host == "0.0.0.0"

fn default_port(scheme)
  if scheme == "http"
    return 80
  if scheme == "https"
    return 443
  if scheme == "ftp"
    return 21
  if scheme == "ssh"
    return 22
  if scheme == "smtp"
    return 25
  if scheme == "redis"
    return 6379
  if scheme == "postgres" or scheme == "postgresql"
    return 5432
  if scheme == "mysql"
    return 3306
  0

fn main()
  let r = parse_host_port("example.com:8080")
  assert(is_ok(r), "parse ok")
  let hp = unwrap(r)
  assert(hp["host"] == "example.com", "host")
  assert(hp["port"] == 8080, "port")

  assert(format_addr("0.0.0.0", 3000) == "0.0.0.0:3000", "format")

  assert(is_localhost("localhost") == 1, "localhost")
  assert(is_localhost("127.0.0.1") == 1, "127.0.0.1")
  assert(is_localhost("example.com") == 0, "not localhost")

  assert(default_port("http") == 80, "http 80")
  assert(default_port("https") == 443, "https 443")
  assert(default_port("postgres") == 5432, "pg 5432")
  assert(default_port("unknown") == 0, "unknown 0")

  assert(is_err(parse_host_port("noport")), "missing port")
  assert(is_err(parse_host_port("host:abc")), "invalid port")
  assert(is_err(parse_host_port("host:99999")), "port too high")

  print("netaddrx: all passed")
