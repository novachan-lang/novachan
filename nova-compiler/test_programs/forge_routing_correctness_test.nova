// forge_routing_correctness_test -- SEC-3: routing/serialization correctness from the review.
// (1) json_obj escapes embedded quotes (was raw concatenation -> invalid JSON);
// (2) a :param must NOT bind an empty segment (/users/:id must not match /users/);
// (3) a static mount matches at a SEGMENT boundary (/app must not shadow /application);
// (4) _status_line gives the right reason phrase (405 was "405 OK").
import forge

fn h(req: Request) -> string
    "ok"

fn main()
    let q = chr(34)

    // 1. json_obj must produce VALID escaped JSON for a value containing a quote.
    let jo = forge.json_obj(200, [["msg", "say " + q + "hi" + q]])
    assert(find(jo, "\\" + q + "hi\\" + q) >= 0, "json_obj escapes embedded quotes")
    print("PASS: json_obj valid escaped JSON")

    let a = forge.app()
    forge.get(a, "/users/:id", h)
    forge.static(a, "/app", "_static_fixture")

    // 2. :param must not match an empty segment.
    let r1: Response = forge.dispatch_req(a, forge.build_request("GET /users/ HTTP/1.1\r\n\r\n", 0))
    assert(r1.status == 404, ":param empty segment -> 404")
    let r2: Response = forge.dispatch_req(a, forge.build_request("GET /users/42 HTTP/1.1\r\n\r\n", 0))
    assert(r2.status == 200, ":id matches a non-empty segment")
    print("PASS: :param empty-segment rejected")

    // 3. static prefix is segment-anchored: /application must NOT match mount /app.
    let r3: Response = forge.dispatch_req(a, forge.build_request("GET /application/x HTTP/1.1\r\n\r\n", 0))
    assert(r3.status == 404, "/application does not match mount /app")
    let r4: Response = forge.dispatch_req(a, forge.build_request("GET /app HTTP/1.1\r\n\r\n", 0))
    assert(r4.status == 200, "/app (== prefix) serves index.html")
    print("PASS: static prefix segment-anchored")

    // 4. status reason phrases (405 was rendered "405 OK").
    let r5: Response = forge.dispatch_req(a, forge.build_request("POST /users/42 HTTP/1.1\r\n\r\n", 0))
    assert(r5.status == 405, "POST to GET route -> 405")
    assert(find(forge.finalize(r5), "405 Method Not Allowed") >= 0, "405 reason phrase")
    assert(find(forge.finalize(forge.resp_text(422, "bad")), "422 Unprocessable Entity") >= 0, "422 reason phrase")
    print("PASS: status reason phrases")
    print("forge_routing_correctness_test passed")
