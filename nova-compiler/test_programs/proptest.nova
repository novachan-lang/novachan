// ============================================================================
// NOVA Standard Library — proptest: property-based / fuzz testing helpers
// ============================================================================
// Pure NOVA (no new builtins). Fills cat-19 (Testing: property-based / fuzz).
//
// A "property" is a function taking one int and returning 1 (holds) or 0 (fails).
// These helpers drive a property across many inputs and report the first
// counterexample. forall_range is exhaustive + deterministic; forall_int is a
// random sampler (utility) — its result is only deterministic when the property
// holds for every value in the range.

// Exhaustively check `prop` for EVERY integer x in [lo, hi] inclusive.
// Returns 1 if it holds for all; on the first failure prints the offending
// value and returns 0. If lo > hi the range is empty and it vacuously holds (1).
fn forall_range(lo, hi, prop) -> int
    let x = lo
    while x <= hi
        if prop(x) == 0
            print("property failed at: " + str(x))
            return 0
        x = x + 1
    return 1

// Named property check. Runs forall_range; if it holds, announces it.
// Returns the same 1/0 result so callers can assert on it.
fn check(name, lo, hi, prop) -> int
    let r = forall_range(lo, hi, prop)
    if r == 1
        print(name + " holds")
    return r

// Random sampler: draw `n` random ints in [lo, hi] and test `prop` on each.
// Returns 0 on the first failure, else 1. Non-deterministic in general — only
// use with a property that holds everywhere if you need a stable result.
fn forall_int(lo, hi, n, prop) -> int
    let i = 0
    while i < n
        let x = random_int(lo, hi)
        if prop(x) == 0
            print("property failed at: " + str(x))
            return 0
        i = i + 1
    return 1

// ── Properties under test (each: int -> 1 holds / 0 fails) ──

// abs is always non-negative.
fn prop_abs(x) -> int
    if abs(x) >= 0
        return 1
    return 0

// doubling via addition equals doubling via multiplication.
fn prop_double(x) -> int
    if x + x == x * 2
        return 1
    return 0

// KNOWN-FALSE property: "x is never 5" — fails exactly at x == 5.
fn prop_not5(x) -> int
    if x != 5
        return 1
    return 0

// ============================================================================
fn main()
    // ── forall_range: exhaustive, deterministic ──
    // abs(x) >= 0 holds across a wide signed range.
    assert_eq(forall_range(-50, 50, prop_abs), 1)
    // x+x == x*2 holds across a wide range including negatives and zero.
    assert_eq(forall_range(-100, 100, prop_double), 1)
    // The known-false property is detected: prints the counterexample at x == 5.
    assert_eq(forall_range(0, 10, prop_not5), 0)

    // Edge cases for forall_range.
    assert_eq(forall_range(0, 0, prop_abs), 1)      // single element, holds
    assert_eq(forall_range(7, 7, prop_not5), 1)     // single element, not the bad one
    assert_eq(forall_range(5, 5, prop_not5), 0)     // single element, the bad one
    assert_eq(forall_range(10, 0, prop_not5), 1)    // empty range -> vacuously true

    // ── check: returns the result AND announces on success ──
    assert_eq(check("abs_nonneg", -10, 10, prop_abs), 1)
    assert_eq(check("double_eq", -10, 10, prop_double), 1)
    assert_eq(check("not5", 0, 10, prop_not5), 0)   // returns 0, no announce

    // ── forall_int: random sampler, tested only with an ALWAYS-true property
    //    so the result is deterministic regardless of the samples drawn. ──
    assert_eq(forall_int(0, 1000000, 50, prop_abs), 1)
    assert_eq(forall_int(-1000, 1000, 100, prop_abs), 1)
    assert_eq(forall_int(0, 0, 5, prop_abs), 1)     // degenerate range, always 0 -> holds

    print("proptest_test passed")
