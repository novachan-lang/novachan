// KAT for std/calendar/iso_week
// Tests: iso_week_of, iso_weeks_in_year, iso_week_to_greg
import std/calendar/iso_week

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _iso_week_test " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // ── iso_week_of ───────────────────────────────────────────────────────
    // 2026-01-01 is a Thursday -> ISO week 1 of 2026
    let w1 = iso_week_of(2026, 1, 1)
    cki("2026-01-01 iso_year", w1[0], 2026)
    cki("2026-01-01 week", w1[1], 1)

    // 2021-01-01 is a Friday -> belongs to ISO week 53 of 2020
    let w2 = iso_week_of(2021, 1, 1)
    cki("2021-01-01 iso_year", w2[0], 2020)
    cki("2021-01-01 week", w2[1], 53)

    // 2020-12-28 (Mon) -> last week of 2020 = W53
    let w3 = iso_week_of(2020, 12, 28)
    cki("2020-12-28 iso_year", w3[0], 2020)
    cki("2020-12-28 week", w3[1], 53)

    // 2020-01-01 (Wed) -> W01 of 2020
    let w4 = iso_week_of(2020, 1, 1)
    cki("2020-01-01 iso_year", w4[0], 2020)
    cki("2020-01-01 week", w4[1], 1)

    // 2021-12-31 (Fri) -> W52 of 2021
    let w5 = iso_week_of(2021, 12, 31)
    cki("2021-12-31 iso_year", w5[0], 2021)
    cki("2021-12-31 week", w5[1], 52)

    // 2015-12-28 -> W53 of 2015 (2015 has 53 weeks)
    let w6 = iso_week_of(2015, 12, 28)
    cki("2015-12-28 iso_year", w6[0], 2015)
    cki("2015-12-28 week", w6[1], 53)

    // 2000-01-01 (Sat) -> W52 of 1999
    let w7 = iso_week_of(2000, 1, 1)
    cki("2000-01-01 iso_year", w7[0], 1999)
    cki("2000-01-01 week", w7[1], 52)

    // ── iso_weeks_in_year ─────────────────────────────────────────────────
    cki("iso_weeks_in_year(2020)", iso_weeks_in_year(2020), 53)
    cki("iso_weeks_in_year(2021)", iso_weeks_in_year(2021), 52)
    cki("iso_weeks_in_year(2015)", iso_weeks_in_year(2015), 53)
    cki("iso_weeks_in_year(2014)", iso_weeks_in_year(2014), 52)
    cki("iso_weeks_in_year(2026)", iso_weeks_in_year(2026), 53)
    cki("iso_weeks_in_year(2019)", iso_weeks_in_year(2019), 52)
    cki("iso_weeks_in_year(2004)", iso_weeks_in_year(2004), 53)

    // ── iso_week_to_greg ──────────────────────────────────────────────────
    // iso_week_to_greg(2026, 1, 4) -> [2026, 1, 1]  (weekday 4 = Thursday)
    let g1 = iso_week_to_greg(2026, 1, 4)
    cki("2026-W01-4 y", g1[0], 2026)
    cki("2026-W01-4 m", g1[1], 1)
    cki("2026-W01-4 d", g1[2], 1)

    // iso_week_to_greg(2020, 53, 1) -> [2020, 12, 28]  (Monday)
    let g2 = iso_week_to_greg(2020, 53, 1)
    cki("2020-W53-1 y", g2[0], 2020)
    cki("2020-W53-1 m", g2[1], 12)
    cki("2020-W53-1 d", g2[2], 28)

    // iso_week_to_greg(2020, 53, 7) -> [2021, 1, 3]  (Sunday)
    let g3 = iso_week_to_greg(2020, 53, 7)
    cki("2020-W53-7 y", g3[0], 2021)
    cki("2020-W53-7 m", g3[1], 1)
    cki("2020-W53-7 d", g3[2], 3)

    // iso_week_to_greg(2026, 1, 1) -> [2025, 12, 29]  (Monday of W01 2026)
    let g4 = iso_week_to_greg(2026, 1, 1)
    cki("2026-W01-1 y", g4[0], 2025)
    cki("2026-W01-1 m", g4[1], 12)
    cki("2026-W01-1 d", g4[2], 29)

    // Round-trip: iso_week_of then iso_week_to_greg should return original date
    // for any weekday; check 2024-02-29 (leap day, Thu)
    let rt = iso_week_of(2024, 2, 29)
    // rt should be [2024, 9] (2024-02-29 is a Thursday = weekday 4)
    cki("2024-02-29 iso_year", rt[0], 2024)
    cki("2024-02-29 week", rt[1], 9)
    let g5 = iso_week_to_greg(rt[0], rt[1], 4)
    cki("roundtrip-2024-02-29 y", g5[0], 2024)
    cki("roundtrip-2024-02-29 m", g5[1], 2)
    cki("roundtrip-2024-02-29 d", g5[2], 29)

    print("PASS _iso_week_test")
