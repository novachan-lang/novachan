import std/collections/lazy_segment_tree

fn cki(got, expected, label)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn ckb(got, expected, label)
    let gi = 0
    let ei = 0
    if got
        gi = 1
    if expected
        ei = 1
    if gi != ei
        print("FAIL " + label + ": got " + str(gi) + " expected " + str(ei))
        exit(1)

fn main()
    // --- KAT: spec scenario: arr=[1,2,3,4,5] ---
    let arr = []
    arr.push(1)
    arr.push(2)
    arr.push(3)
    arr.push(4)
    arr.push(5)
    let t = lseg_build(arr)
    // Initial sum: 1+2+3+4+5=15
    cki(lseg_range_sum(t, 0, 4), 15, "initial sum(0,4)=15")

    // range_add(1,3,10): arr becomes [1,12,13,14,5]
    lseg_range_add(t, 1, 3, 10)
    cki(lseg_range_sum(t, 0, 4), 45, "after add(1,3,10): sum(0,4)=45")
    cki(lseg_range_sum(t, 1, 3), 39, "after add(1,3,10): sum(1,3)=39")
    cki(lseg_point_query(t, 2), 13, "after add(1,3,10): point(2)=13")
    cki(lseg_point_query(t, 0), 1,  "point(0)=1 unchanged")
    cki(lseg_point_query(t, 4), 5,  "point(4)=5 unchanged")

    // another range_add(0,4,1): arr becomes [2,13,14,15,6]
    lseg_range_add(t, 0, 4, 1)
    cki(lseg_range_sum(t, 0, 4), 50, "after add(0,4,1): sum(0,4)=50")
    cki(lseg_point_query(t, 0), 2,  "after add(0,4,1): point(0)=2")
    cki(lseg_point_query(t, 4), 6,  "after add(0,4,1): point(4)=6")

    // --- single element ---
    let a1 = []
    a1.push(7)
    let t1 = lseg_build(a1)
    cki(lseg_range_sum(t1, 0, 0), 7, "single: sum(0,0)=7")
    lseg_range_add(t1, 0, 0, 3)
    cki(lseg_point_query(t1, 0), 10, "single: after add(0,0,3) point(0)=10")

    // --- all-zeros range_add then sum ---
    let a0 = []
    a0.push(0)
    a0.push(0)
    a0.push(0)
    let t0 = lseg_build(a0)
    lseg_range_add(t0, 0, 2, 5)
    cki(lseg_range_sum(t0, 0, 2), 15, "zeros after add(5): sum=15")
    cki(lseg_point_query(t0, 1), 5, "zeros: point(1)=5")

    // --- overlapping updates ---
    let ab = []
    ab.push(0)
    ab.push(0)
    ab.push(0)
    ab.push(0)
    let tb = lseg_build(ab)
    lseg_range_add(tb, 0, 3, 1)
    lseg_range_add(tb, 1, 2, 1)
    // arr is now [1,2,2,1]
    cki(lseg_range_sum(tb, 0, 3), 6, "overlap: sum(0,3)=6")
    cki(lseg_point_query(tb, 0), 1, "overlap: point(0)=1")
    cki(lseg_point_query(tb, 1), 2, "overlap: point(1)=2")
    cki(lseg_point_query(tb, 3), 1, "overlap: point(3)=1")

    print("PASS _lazy_segment_tree_test")

main()
