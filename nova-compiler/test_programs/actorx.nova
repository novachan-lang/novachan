// actorx — GenServer/actor: a stateful server Process behind a typed request
// Channel (Erlang's gen_server, the NOVA way over spawn + channel). actor_start
// spawns a receive loop threading state through a handler fn(state,msg)->[state,reply];
// actor_call is a synchronous request/reply rendezvous; actor_stop ends the loop so
// the process completes (program-exit join stays clean). Built on real spawn+channel.

fn actor_start(initial_state, handler)
    let reqch = channel()
    spawn fn()
        let state = initial_state
        let go = 1
        while go == 1
            let env = receive(reqch)
            if env[0] == 0
                go = 0
            else
                let res = handler(state, env[1])
                state = res[0]
                send(env[2], res[1])
    return reqch

fn actor_call(server, msg)
    let rch = channel()
    send(server, [1, msg, rch])
    return receive(rch)

fn actor_stop(server)
    let dummy = channel()
    send(server, [0, 0, dummy])
    return 0

// handler: fn(state, msg) -> [new_state, reply]  (named fn; multi-statement)
fn counter_handler(state, msg)
    if msg == "inc"
        return [state + 1, state + 1]
    if msg == "dec"
        return [state - 1, state - 1]
    return [state, state]

fn main()
    let srv = actor_start(0, counter_handler)
    assert_eq(actor_call(srv, "inc"), 1)
    assert_eq(actor_call(srv, "inc"), 2)
    assert_eq(actor_call(srv, "inc"), 3)
    assert_eq(actor_call(srv, "dec"), 2)
    assert_eq(actor_call(srv, "get"), 2)
    actor_stop(srv)
    print("actorx passed")
