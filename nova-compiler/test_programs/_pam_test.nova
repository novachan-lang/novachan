// KAT probe for std/media/pam — PAM (P7) encode/decode.
// Vectors:
//   pam_encode(1,1,3,"RGB",[10,20,30]):
//     Header = "P7\nWIDTH 1\nHEIGHT 1\nDEPTH 3\nMAXVAL 255\nTUPLTYPE RGB\nENDHDR\n"
//     Header byte length = 59
//     Total blob = 62 bytes (59 header + 3 pixel bytes)
//     Final 3 bytes = 10, 20, 30
//   Round-trip: decode(encode(1,1,3,"RGB",[10,20,30])) -> w=1,h=1,depth=3,tupltype="RGB",px=[10,20,30]
import std/media/pam

fn ck_int(label, got, want)
    if got != want
        print("FAIL pam " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck_str(label, got, want)
    if got != want
        print("FAIL pam " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn main()
    // ── KAT 1: magic header bytes ─────────────────────────────────────────────
    let enc = pam_encode(1, 1, 3, "RGB", [10, 20, 30])
    let blen = bytes_len(enc)
    // "P7\nWIDTH 1\nHEIGHT 1\nDEPTH 3\nMAXVAL 255\nTUPLTYPE RGB\nENDHDR\n" = 59 bytes
    // + 3 pixel bytes = 62
    ck_int("total-len", blen, 62)
    // First 3 bytes are the magic: P(80) 7(55) LF(10)
    ck_int("magic-P", bytes_get(enc, 0), 80)
    ck_int("magic-7", bytes_get(enc, 1), 55)
    ck_int("magic-LF", bytes_get(enc, 2), 10)
    print("KAT 1 PASS: magic bytes P7\\n correct, total length 62")

    // ── KAT 2: exact header text via bytes_to_str ─────────────────────────────
    let hdr_slice = bytes_slice(enc, 0, 59)
    let hdr_str = bytes_to_str(hdr_slice)
    let want_hdr = "P7\nWIDTH 1\nHEIGHT 1\nDEPTH 3\nMAXVAL 255\nTUPLTYPE RGB\nENDHDR\n"
    ck_str("header-text", hdr_str, want_hdr)
    print("KAT 2 PASS: header text byte-exact")

    // ── KAT 3: final 3 bytes are the pixel samples ────────────────────────────
    ck_int("pixel-R", bytes_get(enc, 59), 10)
    ck_int("pixel-G", bytes_get(enc, 60), 20)
    ck_int("pixel-B", bytes_get(enc, 61), 30)
    print("KAT 3 PASS: pixel bytes [10,20,30] at offsets 59,60,61")

    // ── KAT 4: round-trip encode -> decode ────────────────────────────────────
    let dec = pam_decode(enc)
    ck_int("rt-w", dec["w"], 1)
    ck_int("rt-h", dec["h"], 1)
    ck_int("rt-depth", dec["depth"], 3)
    ck_str("rt-tupltype", dec["tupltype"], "RGB")
    let px = dec["px"]
    ck_int("rt-px-len", len(px), 3)
    ck_int("rt-px-0", px[0], 10)
    ck_int("rt-px-1", px[1], 20)
    ck_int("rt-px-2", px[2], 30)
    print("KAT 4 PASS: round-trip w=1 h=1 depth=3 tupltype=RGB px=[10,20,30]")

    // ── KAT 5: larger image round-trip (2x2 GRAYSCALE) ───────────────────────
    let px2 = [0, 64, 128, 255]
    let enc2 = pam_encode(2, 2, 1, "GRAYSCALE", px2)
    let dec2 = pam_decode(enc2)
    ck_int("rt2-w", dec2["w"], 2)
    ck_int("rt2-h", dec2["h"], 2)
    ck_int("rt2-depth", dec2["depth"], 1)
    ck_str("rt2-tupltype", dec2["tupltype"], "GRAYSCALE")
    let px2r = dec2["px"]
    ck_int("rt2-px-len", len(px2r), 4)
    ck_int("rt2-px-0", px2r[0], 0)
    ck_int("rt2-px-1", px2r[1], 64)
    ck_int("rt2-px-2", px2r[2], 128)
    ck_int("rt2-px-3", px2r[3], 255)
    print("KAT 5 PASS: 2x2 GRAYSCALE round-trip correct")

    // ── KAT 6: malformed input returns empty dict ─────────────────────────────
    let bad = bytes(0)
    bad = bytes_append(bad, 80)
    bad = bytes_append(bad, 54)
    bad = bytes_append(bad, 10)
    let dec_bad = pam_decode(bad)
    ck_int("bad-magic-w", dec_bad["w"], 0)
    print("KAT 6 PASS: malformed magic returns zeroed result")

    // ── KAT 7: truncated input (no ENDHDR) returns empty ─────────────────────
    let partial = str_to_bytes("P7\nWIDTH 1\n")
    let dec_partial = pam_decode(partial)
    ck_int("partial-w", dec_partial["w"], 0)
    print("KAT 7 PASS: truncated input (no ENDHDR) returns zeroed result")

    // ── KAT 8: 1x1 RGB_ALPHA (depth=4) round-trip ────────────────────────────
    let px3 = [200, 100, 50, 255]
    let enc3 = pam_encode(1, 1, 4, "RGB_ALPHA", px3)
    let dec3 = pam_decode(enc3)
    ck_int("rt3-depth", dec3["depth"], 4)
    ck_str("rt3-tupltype", dec3["tupltype"], "RGB_ALPHA")
    let px3r = dec3["px"]
    ck_int("rt3-px-len", len(px3r), 4)
    ck_int("rt3-px-0", px3r[0], 200)
    ck_int("rt3-px-1", px3r[1], 100)
    ck_int("rt3-px-2", px3r[2], 50)
    ck_int("rt3-px-3", px3r[3], 255)
    print("KAT 8 PASS: 1x1 RGB_ALPHA depth=4 round-trip correct")

    print("PASS _pam_test")
