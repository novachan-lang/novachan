import std/util/env

// ── check helpers ─────────────────────────────────────────────────────────────

fn cks(label: str, got: str, want: str)
    if got != want
        print("FAIL " + label + ": got [" + got + "] want [" + want + "]")
        exit(1)

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label: str, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got " + gs + " want " + ws)
        exit(1)

fn main()
    // ── ev_parse_bool: spec KATs ──────────────────────────────────────────────
    ckb("pb_true",    ev_parse_bool("true",  false), true)
    ckb("pb_zero",    ev_parse_bool("0",     true),  false)
    ckb("pb_yes_uc",  ev_parse_bool("YES",   false), true)
    ckb("pb_maybe",   ev_parse_bool("maybe", true),  true)   // default returned

    // ── ev_parse_int: spec KATs ───────────────────────────────────────────────
    cki("pi_42",      ev_parse_int("42",  0), 42)
    cki("pi_x",       ev_parse_int("x",   7), 7)
    cki("pi_empty",   ev_parse_int("",    5), 5)

    // ── ev_parse_bool: extra coverage ─────────────────────────────────────────
    ckb("pb_1",       ev_parse_bool("1",     false), true)
    ckb("pb_on",      ev_parse_bool("on",    false), true)
    ckb("pb_ON",      ev_parse_bool("ON",    false), true)
    ckb("pb_false",   ev_parse_bool("false", true),  false)
    ckb("pb_no",      ev_parse_bool("no",    true),  false)
    ckb("pb_off",     ev_parse_bool("off",   true),  false)
    ckb("pb_empty_d", ev_parse_bool("",      true),  true)   // empty = default

    // ── ev_parse_int: extra coverage ──────────────────────────────────────────
    cki("pi_0",       ev_parse_int("0",    99), 0)
    cki("pi_neg",     ev_parse_int("-5",   0),  0 - 5)
    cki("pi_spaces",  ev_parse_int("1 2",  3),  3)   // non-digit -> default

    // ── live env tests via set_env ────────────────────────────────────────────
    set_env("_NOVA_EV_TEST_STR", "hello")
    cks("ev_str_set",     ev_str("_NOVA_EV_TEST_STR", "d"), "hello")
    cks("ev_str_unset",   ev_str("_NOVA_EV_TEST_NONE", "d"), "d")

    set_env("_NOVA_EV_TEST_INT", "99")
    cki("ev_int_set",     ev_int("_NOVA_EV_TEST_INT", 0), 99)
    cki("ev_int_unset",   ev_int("_NOVA_EV_TEST_NONE", 7), 7)

    set_env("_NOVA_EV_TEST_BOOL", "true")
    ckb("ev_bool_set",    ev_bool("_NOVA_EV_TEST_BOOL", false), true)
    ckb("ev_bool_unset",  ev_bool("_NOVA_EV_TEST_NONE", true), true)

    set_env("_NOVA_EV_TEST_HAS", "1")
    ckb("ev_has_set",     ev_has("_NOVA_EV_TEST_HAS"),  true)
    ckb("ev_has_unset",   ev_has("_NOVA_EV_TEST_NONE"), false)

    print("_env_test passed")
