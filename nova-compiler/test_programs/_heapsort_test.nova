import std/collections/heapsort

fn _ck(got, want, label)
    if got != want
        print("FAIL heapsort " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // KAT 1: heapsort_asc basic
    let r1 = heapsort.heapsort_asc([5,3,8,1,9,2])
    _ck(r1[0], 1, "asc[0]")
    _ck(r1[1], 2, "asc[1]")
    _ck(r1[2], 3, "asc[2]")
    _ck(r1[3], 5, "asc[3]")
    _ck(r1[4], 8, "asc[4]")
    _ck(r1[5], 9, "asc[5]")
    _ck(len(r1), 6, "asc len")

    // KAT 2: heapsort_desc basic
    let r2 = heapsort.heapsort_desc([5,3,8,1,9,2])
    _ck(r2[0], 9, "desc[0]")
    _ck(r2[1], 8, "desc[1]")
    _ck(r2[2], 5, "desc[2]")
    _ck(r2[3], 3, "desc[3]")
    _ck(r2[4], 2, "desc[4]")
    _ck(r2[5], 1, "desc[5]")
    _ck(len(r2), 6, "desc len")

    // KAT 3: empty list
    let r3 = heapsort.heapsort_asc([])
    _ck(len(r3), 0, "asc empty len")

    // KAT 4: singleton
    let r4 = heapsort.heapsort_asc([7])
    _ck(len(r4), 1, "asc singleton len")
    _ck(r4[0], 7, "asc singleton val")

    // KAT 5: duplicates
    let r5 = heapsort.heapsort_asc([4,1,4,1])
    _ck(r5[0], 1, "dup[0]")
    _ck(r5[1], 1, "dup[1]")
    _ck(r5[2], 4, "dup[2]")
    _ck(r5[3], 4, "dup[3]")

    // KAT 6: heapsort_inplace mutates in-place
    let a6 = [5,3,8,1,9,2]
    heapsort.heapsort_inplace(a6)
    _ck(a6[0], 1, "inplace[0]")
    _ck(a6[1], 2, "inplace[1]")
    _ck(a6[2], 3, "inplace[2]")
    _ck(a6[3], 5, "inplace[3]")
    _ck(a6[4], 8, "inplace[4]")
    _ck(a6[5], 9, "inplace[5]")

    // KAT 7: heapsort_by_key — sort pairs by key
    let p0 = [3,0]
    let p1 = [1,0]
    let p2 = [2,0]
    let pairs = []
    pairs.push(p0)
    pairs.push(p1)
    pairs.push(p2)
    let r7 = heapsort.heapsort_by_key(pairs)
    let k0 = r7[0]
    let k1 = r7[1]
    let k2 = r7[2]
    _ck(k0[0], 1, "by_key keys[0]")
    _ck(k1[0], 2, "by_key keys[1]")
    _ck(k2[0], 3, "by_key keys[2]")

    // KAT 8: non-destructive — original list unchanged after heapsort_asc
    let orig = [5,3,8,1,9,2]
    let sorted = heapsort.heapsort_asc(orig)
    _ck(orig[0], 5, "nondestructive orig[0]")
    _ck(orig[1], 3, "nondestructive orig[1]")
    _ck(sorted[0], 1, "nondestructive sorted[0]")

    // KAT 9: already-sorted input
    let r9 = heapsort.heapsort_asc([1,2,3,4,5])
    _ck(r9[0], 1, "presorted[0]")
    _ck(r9[4], 5, "presorted[4]")

    // KAT 10: reverse-sorted input
    let r10 = heapsort.heapsort_asc([9,8,7,6,5,4,3,2,1])
    _ck(r10[0], 1, "revsorted[0]")
    _ck(r10[8], 9, "revsorted[8]")

    print("PASS _heapsort_test")
