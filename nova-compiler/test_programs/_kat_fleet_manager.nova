import forge_fleet_manager

fn main()
    let s = flm_new()
    assert(flm_total_devices(s) == 0, "0 devices")
    assert(flm_has_device(s, "d1") == 0, "d1 absent")

    s = flm_add_device(s, "d1", "groupA")
    assert(flm_has_device(s, "d1") == 1, "d1 present")
    let g1 = flm_device_group(s, "d1")
    assert(is_ok(g1), "group ok")
    assert(unwrap(g1) == "groupA", "d1 in groupA")
    assert(flm_group_count(s, "groupA") == 1, "groupA has 1")

    s = flm_add_device(s, "d2", "groupA")
    assert(flm_group_count(s, "groupA") == 2, "groupA has 2")
    assert(flm_total_devices(s) == 2, "2 total")

    s = flm_add_device(s, "d3", "groupB")
    assert(flm_group_count(s, "groupB") == 1, "groupB has 1")
    let gl1 = flm_group_list(s)
    assert(gl1 == "groupA,groupB", "group list A,B")

    let m1 = flm_move(s, "d1", "groupB")
    assert(is_ok(m1), "move ok")
    assert(flm_group_count(s, "groupA") == 1, "groupA down to 1")
    assert(flm_group_count(s, "groupB") == 2, "groupB up to 2")
    let g2 = flm_device_group(s, "d1")
    assert(unwrap(g2) == "groupB", "d1 now groupB")

    let r1 = flm_remove(s, "d2")
    assert(is_ok(r1), "remove ok")
    assert(flm_has_device(s, "d2") == 0, "d2 absent after remove")
    assert(flm_total_devices(s) == 2, "2 total after remove")
    assert(flm_group_count(s, "groupA") == 0, "groupA now 0")

    let gl2 = flm_group_list(s)
    assert(gl2 == "groupB", "group list only B (A vacated)")

    let g3 = flm_device_group(s, "d2")
    assert(is_err(g3), "removed device group err")

    let rbad = flm_remove(s, "d99")
    assert(is_err(rbad), "remove unknown device err")

    let cnt_unknown = flm_group_count(s, "groupZ")
    assert(cnt_unknown == 0, "unknown group count 0")

    print("FLEET-MANAGER KAT PASS")
