// nova_doc — NOVA documentation generator
// Extracts /// doc comments from NOVA source files
// Generates Markdown or HTML documentation
// Usage: nova_doc <source.nova> [output.md|output.html]

fn extract_doc_text(line: string) -> string
    let t = trim(line)
    if len(t) <= 3
        return ""
    let text = slice(t, 3, len(t))
    if len(text) > 0 and text[0] == " "
        text = slice(text, 1, len(text))
    text

fn extract_name(sig: string) -> string
    let p = find(sig, "(")
    if p >= 0
        return slice(sig, 0, p)
    sig

fn split_field(s: string) -> list
    let p = find(s, ":")
    if p < 0
        return [s, ""]
    [trim(slice(s, 0, p)), trim(slice(s, p + 1, len(s)))]

fn html_esc(s: string) -> string
    let r = replace(s, "&", "&amp;")
    r = replace(r, "<", "&lt;")
    r = replace(r, ">", "&gt;")
    r

fn doc_to_html(doc: string) -> string
    if doc == ""
        return ""
    let escaped = html_esc(doc)
    `<div class="doc">` + replace(escaped, "\n", "<br>\n") + "</div>\n"

fn generate_markdown(title: string, types: list, enums: list, fns: list) -> string
    let tick = chr(96)
    let fence = tick + tick + tick
    let out = "# " + title + "\n\n"

    if len(types) > 0
        out = out + "## Types\n\n"
        let ti = 0
        while ti < len(types)
            let e = types[ti]
            out = out + "### " + tick + e[0] + tick + "\n\n"
            if e[1] != ""
                out = out + e[1] + "\n\n"
            let fields = e[2]
            if len(fields) > 0
                out = out + "**Fields:**\n\n"
                out = out + "| Field | Type |\n|-------|------|\n"
                let fj = 0
                while fj < len(fields)
                    let parts = split_field(fields[fj])
                    out = out + "| " + tick + parts[0] + tick + " | " + tick + parts[1] + tick + " |\n"
                    fj = fj + 1
                out = out + "\n"
            out = out + "---\n\n"
            ti = ti + 1

    if len(enums) > 0
        out = out + "## Enums\n\n"
        let ei = 0
        while ei < len(enums)
            let e = enums[ei]
            out = out + "### " + tick + e[0] + tick + "\n\n"
            if e[1] != ""
                out = out + e[1] + "\n\n"
            let variants = e[2]
            if len(variants) > 0
                out = out + "**Variants:**\n\n"
                let vj = 0
                while vj < len(variants)
                    out = out + "- " + tick + variants[vj] + tick + "\n"
                    vj = vj + 1
                out = out + "\n"
            out = out + "---\n\n"
            ei = ei + 1

    if len(fns) > 0
        out = out + "## Functions\n\n"
        let fi = 0
        while fi < len(fns)
            let e = fns[fi]
            out = out + "### " + tick + e[0] + tick + "\n\n"
            out = out + fence + "nova\n"
            out = out + "fn " + e[1] + "\n"
            out = out + fence + "\n\n"
            if e[2] != ""
                out = out + e[2] + "\n\n"
            out = out + "---\n\n"
            fi = fi + 1

    out

fn generate_html(title: string, types: list, enums: list, fns: list) -> string
    let out = `<!DOCTYPE html>` + "\n"
    out = out + `<html lang="en">` + "\n<head>\n"
    out = out + `<meta charset="UTF-8">` + "\n"
    out = out + "<title>" + html_esc(title) + "</title>\n"
    out = out + "<style>\n"
    out = out + `body { font-family: -apple-system, BlinkMacSystemFont, sans-serif; max-width: 800px; margin: 40px auto; padding: 0 20px; line-height: 1.6; color: #333; }` + "\n"
    out = out + `h1 { border-bottom: 2px solid #2c3e50; padding-bottom: 8px; }` + "\n"
    out = out + `h2 { color: #2c3e50; margin-top: 32px; }` + "\n"
    out = out + `h3 { color: #34495e; }` + "\n"
    out = out + `code { background: #f4f4f4; padding: 2px 6px; border-radius: 3px; font-size: 0.9em; }` + "\n"
    out = out + `pre { background: #f4f4f4; padding: 16px; border-radius: 6px; overflow-x: auto; }` + "\n"
    out = out + `pre code { background: none; padding: 0; }` + "\n"
    out = out + `.doc { border-left: 4px solid #3498db; margin: 8px 0 16px 0; padding: 8px 16px; color: #555; background: #f8f9fa; }` + "\n"
    out = out + `table { border-collapse: collapse; width: 100%; margin: 16px 0; }` + "\n"
    out = out + `th, td { border: 1px solid #ddd; padding: 8px 12px; text-align: left; }` + "\n"
    out = out + `th { background: #f4f4f4; }` + "\n"
    out = out + `hr { border: none; border-top: 1px solid #eee; margin: 24px 0; }` + "\n"
    out = out + "</style>\n</head>\n<body>\n"
    out = out + "<h1>" + html_esc(title) + "</h1>\n"

    if len(types) > 0
        out = out + "<h2>Types</h2>\n"
        let ti = 0
        while ti < len(types)
            let e = types[ti]
            out = out + "<h3><code>" + html_esc(e[0]) + "</code></h3>\n"
            out = out + doc_to_html(e[1])
            let fields = e[2]
            if len(fields) > 0
                out = out + "<table><tr><th>Field</th><th>Type</th></tr>\n"
                let fj = 0
                while fj < len(fields)
                    let parts = split_field(fields[fj])
                    out = out + "<tr><td><code>" + html_esc(parts[0]) + "</code></td>"
                    out = out + "<td><code>" + html_esc(parts[1]) + "</code></td></tr>\n"
                    fj = fj + 1
                out = out + "</table>\n"
            out = out + "<hr>\n"
            ti = ti + 1

    if len(enums) > 0
        out = out + "<h2>Enums</h2>\n"
        let ei = 0
        while ei < len(enums)
            let e = enums[ei]
            out = out + "<h3><code>" + html_esc(e[0]) + "</code></h3>\n"
            out = out + doc_to_html(e[1])
            let variants = e[2]
            if len(variants) > 0
                out = out + "<ul>\n"
                let vj = 0
                while vj < len(variants)
                    out = out + "<li><code>" + html_esc(variants[vj]) + "</code></li>\n"
                    vj = vj + 1
                out = out + "</ul>\n"
            out = out + "<hr>\n"
            ei = ei + 1

    if len(fns) > 0
        out = out + "<h2>Functions</h2>\n"
        let fi = 0
        while fi < len(fns)
            let e = fns[fi]
            out = out + "<h3><code>" + html_esc(e[0]) + "</code></h3>\n"
            out = out + "<pre><code>fn " + html_esc(e[1]) + "</code></pre>\n"
            out = out + doc_to_html(e[2])
            out = out + "<hr>\n"
            fi = fi + 1

    out = out + "</body>\n</html>\n"
    out

fn main()
    let argv = args()
    if len(argv) < 2
        print("Usage: nova_doc <source.nova> [output.md|output.html]")
        exit(1)
    let source_file = argv[1]
    if not file_exists(source_file)
        print("Error: file not found: " + source_file)
        exit(1)
    let content = read_file(source_file)
    content = replace(content, "\r", "")
    let lines = split(content, "\n")
    let num_lines = len(lines)
    let display_name = path_name(source_file)

    let types = []
    let enums = []
    let functions = []
    let doc_parts = []
    let idx = 0

    while idx < num_lines
        let line = lines[idx]
        let t = trim(line)
        if starts_with(t, "///")
            push(doc_parts, extract_doc_text(line))
            idx = idx + 1
        else if starts_with(t, "fn ")
            let sig = slice(t, 3, len(t))
            let doc = join(doc_parts, "\n")
            let fname = extract_name(sig)
            push(functions, [fname, sig, doc])
            doc_parts = []
            idx = idx + 1
        else if starts_with(t, "type ")
            let tname = slice(t, 5, len(t))
            let doc = join(doc_parts, "\n")
            doc_parts = []
            idx = idx + 1
            let fields = []
            while idx < num_lines and (starts_with(lines[idx], " ") or starts_with(lines[idx], "\t"))
                let ft = trim(lines[idx])
                if ft != "" and not starts_with(ft, "//")
                    push(fields, ft)
                idx = idx + 1
            push(types, [tname, doc, fields])
        else if starts_with(t, "enum ")
            let ename = slice(t, 5, len(t))
            let doc = join(doc_parts, "\n")
            doc_parts = []
            idx = idx + 1
            let variants = []
            while idx < num_lines and (starts_with(lines[idx], " ") or starts_with(lines[idx], "\t"))
                let vt = trim(lines[idx])
                if vt != "" and not starts_with(vt, "//")
                    push(variants, vt)
                idx = idx + 1
            push(enums, [ename, doc, variants])
        else
            if t != "" and not starts_with(t, "//")
                doc_parts = []
            idx = idx + 1

    let total = len(types) + len(enums) + len(functions)
    if total == 0
        print("No documented items found in " + source_file)
        exit(0)

    if len(argv) >= 3
        let output_file = argv[2]
        if ends_with(output_file, ".html")
            let html = generate_html(display_name, types, enums, functions)
            write_file(output_file, html)
        else
            let md = generate_markdown(display_name, types, enums, functions)
            write_file(output_file, md)
        print("Documentation: " + str(len(types)) + " types, " + str(len(enums)) + " enums, " + str(len(functions)) + " functions -> " + output_file)
    else
        let md = generate_markdown(display_name, types, enums, functions)
        print(md)
