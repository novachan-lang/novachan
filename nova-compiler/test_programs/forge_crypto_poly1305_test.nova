// Forge crypto: Poly1305 MAC, gated against the RFC 8439 Sec 2.5.2 KAT. Socketless, deterministic.
import forge_crypto

fn main()
    let key = hex_to_blist("85d6be7857556d337f4452fe42d506a80103808afb0db2fd4abff6af4149f51b")
    let msg = str_to_blist("Cryptographic Forum Research Group")
    let tag = poly1305_mac(key, msg)
    if hex_of(tag) != "a8061dc1305136c6c22b8baf0c0127a9"
        print("FAIL: Poly1305 tag -> " + hex_of(tag))
        exit(1)
    print("PASS forge_crypto_poly1305 (RFC 8439 Sec 2.5.2 KAT)")
