// KAT for std/net/coap_block — RFC 7959 Block1/Block2 option value codec.
import std/net/coap_block

fn cki(label, got, want)
    if got != want
        print("FAIL coap_block " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── Vector 1: coap_block_encode(0, 0, 6) -> [0x06] ───────────────────────
    // value = (0<<4)|(0<<3)|6 = 6 = 0x06 — fits in 1 byte
    let enc1 = coap_block_encode(0, 0, 6)
    cki("v1_len", len(enc1), 1)
    cki("v1_b0",  enc1[0],   0x06)

    // ── Vector 2: coap_block_encode(1, 1, 2) -> [0x1A] ───────────────────────
    // value = (1<<4)|(1<<3)|2 = 16+8+2 = 26 = 0x1A — fits in 1 byte
    let enc2 = coap_block_encode(1, 1, 2)
    cki("v2_len", len(enc2), 1)
    cki("v2_b0",  enc2[0],   0x1A)

    // ── Vector 3: block_size(6) == 1024 ──────────────────────────────────────
    let bs6 = block_size(6)
    cki("bs6", bs6, 1024)

    // ── Vector 4: block_size(0) == 16 ────────────────────────────────────────
    let bs0 = block_size(0)
    cki("bs0", bs0, 16)

    // ── Vector 5: block_size for all SZX values ───────────────────────────────
    cki("bs1", block_size(1), 32)
    cki("bs2", block_size(2), 64)
    cki("bs3", block_size(3), 128)
    cki("bs4", block_size(4), 256)
    cki("bs5", block_size(5), 512)

    // ── Vector 6: round-trip decode(encode(0,0,6)) ────────────────────────────
    let dec1 = coap_block_decode(enc1)
    cki("rt1_num",  dec1[0], 0)
    cki("rt1_more", dec1[1], 0)
    cki("rt1_szx",  dec1[2], 6)

    // ── Vector 7: round-trip decode(encode(1,1,2)) ────────────────────────────
    let dec2 = coap_block_decode(enc2)
    cki("rt2_num",  dec2[0], 1)
    cki("rt2_more", dec2[1], 1)
    cki("rt2_szx",  dec2[2], 2)

    // ── Vector 8: large num spans 2 bytes ────────────────────────────────────
    // num=16, more=0, szx=6
    // value = (16<<4)|(0<<3)|6 = 256+6 = 262 = 0x0106 — 2 bytes
    let enc3 = coap_block_encode(16, 0, 6)
    cki("v8_len", len(enc3), 2)
    cki("v8_b0",  enc3[0],   0x01)
    cki("v8_b1",  enc3[1],   0x06)
    let dec3 = coap_block_decode(enc3)
    cki("rt3_num",  dec3[0], 16)
    cki("rt3_more", dec3[1], 0)
    cki("rt3_szx",  dec3[2], 6)

    // ── Vector 9: large num spans 2 bytes with more=1 ────────────────────────
    // num=20, more=1, szx=3
    // value = (20<<4)|(1<<3)|3 = 320+8+3 = 331 = 0x014B — 2 bytes
    let enc4 = coap_block_encode(20, 1, 3)
    cki("v9_len", len(enc4), 2)
    cki("v9_b0",  enc4[0],   0x01)
    cki("v9_b1",  enc4[1],   0x4B)
    let dec4 = coap_block_decode(enc4)
    cki("rt4_num",  dec4[0], 20)
    cki("rt4_more", dec4[1], 1)
    cki("rt4_szx",  dec4[2], 3)

    // ── Vector 10: num that requires 3 bytes ─────────────────────────────────
    // num=4096, more=1, szx=6
    // value = (4096<<4)|(1<<3)|6 = 65536+8+6 = 65550 = 0x01000E
    // 0x01000E > 0xFFFF → 3 bytes: [0x01, 0x00, 0x0E]
    let enc5 = coap_block_encode(4096, 1, 6)
    cki("v10_len", len(enc5), 3)
    cki("v10_b0",  enc5[0],   0x01)
    cki("v10_b1",  enc5[1],   0x00)
    cki("v10_b2",  enc5[2],   0x0E)
    let dec5 = coap_block_decode(enc5)
    cki("rt5_num",  dec5[0], 4096)
    cki("rt5_more", dec5[1], 1)
    cki("rt5_szx",  dec5[2], 6)

    // ── Vector 11: empty input decode returns [0,0,0] ────────────────────────
    let empty_bl = []
    let dec6 = coap_block_decode(empty_bl)
    cki("empty_num",  dec6[0], 0)
    cki("empty_more", dec6[1], 0)
    cki("empty_szx",  dec6[2], 0)

    print("PASS _coap_block_test")
