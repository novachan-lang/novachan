import std/backtracking/bt_palindrome_partition

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

// cknest — assert outer list has wantlen sublists then check sublist at idx element-wise against want_sub.
fn cknest(label: string, outer: list, wantlen: int, idx: int, want_sub: list)
    cki(label + "_outerlen", len(outer), wantlen)
    let sub = outer[idx]
    cki(label + "_sublen", len(sub), len(want_sub))
    let k = 0
    while k < len(want_sub)
        cks(label + "[" + str(idx) + "][" + str(k) + "]", sub[k], want_sub[k])
        k = k + 1

// list_contains_strlist — true iff outer (list-of-lists) contains a sublist equal to target.
fn list_contains_strlist(outer: list, target: list) -> bool
    let tn = len(target)
    let i = 0
    while i < len(outer)
        let cand = outer[i]
        if len(cand) == tn
            let matched = true
            let j = 0
            while j < tn
                if cand[j] != target[j]
                    matched = false
                j = j + 1
            if matched
                return true
        i = i + 1
    false

fn main()
    // pp_count basic cases
    cki("pp_count_a", pp_count("a"), 1)
    cki("pp_count_aab", pp_count("aab"), 2)
    cki("pp_count_aaa", pp_count("aaa"), 4)
    cki("pp_count_empty", pp_count(""), 1)
    cki("pp_count_ab", pp_count("ab"), 1)

    // pp_min_cuts basic cases
    cki("pp_min_cuts_aab", pp_min_cuts("aab"), 1)
    cki("pp_min_cuts_aba", pp_min_cuts("aba"), 0)
    cki("pp_min_cuts_abccba", pp_min_cuts("abccba"), 0)
    cki("pp_min_cuts_a", pp_min_cuts("a"), 0)
    cki("pp_min_cuts_empty", pp_min_cuts(""), 0)
    cki("pp_min_cuts_ab", pp_min_cuts("ab"), 1)
    cki("pp_min_cuts_abc", pp_min_cuts("abc"), 2)
    cki("pp_min_cuts_aabb", pp_min_cuts("aabb"), 1)

    // pp_solve("a") -> [["a"]]
    let sa = pp_solve("a")
    cki("pp_solve_a_len", len(sa), 1)
    let sub_a = sa[0]
    cki("pp_solve_a[0]_len", len(sub_a), 1)
    cks("pp_solve_a[0][0]", sub_a[0], "a")

    // pp_solve("aab") -> [["a","a","b"], ["aa","b"]] in depth-first order
    let saab = pp_solve("aab")
    cki("pp_solve_aab_len", len(saab), 2)
    let exp_aab0 = []
    push(exp_aab0, "a")
    push(exp_aab0, "a")
    push(exp_aab0, "b")
    let exp_aab1 = []
    push(exp_aab1, "aa")
    push(exp_aab1, "b")
    ckb("pp_solve_aab_has_[a,a,b]", list_contains_strlist(saab, exp_aab0), true)
    ckb("pp_solve_aab_has_[aa,b]", list_contains_strlist(saab, exp_aab1), true)
    // Depth-first order: [a,a,b] comes before [aa,b]
    let p0 = saab[0]
    cks("pp_solve_aab[0][0]", p0[0], "a")
    cks("pp_solve_aab[0][1]", p0[1], "a")
    cks("pp_solve_aab[0][2]", p0[2], "b")
    let p1 = saab[1]
    cks("pp_solve_aab[1][0]", p1[0], "aa")
    cks("pp_solve_aab[1][1]", p1[1], "b")

    // pp_solve("aaa") -> [["a","a","a"], ["a","aa"], ["aa","a"], ["aaa"]] in depth-first order
    let saaa = pp_solve("aaa")
    cki("pp_solve_aaa_len", len(saaa), 4)
    let exp_aaa0 = []
    push(exp_aaa0, "a")
    push(exp_aaa0, "a")
    push(exp_aaa0, "a")
    let exp_aaa1 = []
    push(exp_aaa1, "a")
    push(exp_aaa1, "aa")
    let exp_aaa2 = []
    push(exp_aaa2, "aa")
    push(exp_aaa2, "a")
    let exp_aaa3 = []
    push(exp_aaa3, "aaa")
    ckb("pp_solve_aaa_has_[a,a,a]", list_contains_strlist(saaa, exp_aaa0), true)
    ckb("pp_solve_aaa_has_[a,aa]", list_contains_strlist(saaa, exp_aaa1), true)
    ckb("pp_solve_aaa_has_[aa,a]", list_contains_strlist(saaa, exp_aaa2), true)
    ckb("pp_solve_aaa_has_[aaa]", list_contains_strlist(saaa, exp_aaa3), true)
    // Check depth-first order
    let q0 = saaa[0]
    cks("pp_solve_aaa[0][0]", q0[0], "a")
    cks("pp_solve_aaa[0][1]", q0[1], "a")
    cks("pp_solve_aaa[0][2]", q0[2], "a")
    let q3 = saaa[3]
    cks("pp_solve_aaa[3][0]", q3[0], "aaa")

    // pp_solve("") -> [[]]
    let sem = pp_solve("")
    cki("pp_solve_empty_len", len(sem), 1)
    cki("pp_solve_empty[0]_len", len(sem[0]), 0)

    print("PASS _bt_palindrome_partition_test")
