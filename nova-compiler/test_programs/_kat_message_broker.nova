import forge_message_broker

fn main()
    let m = mb_new()
    let r1 = mb_create_queue(m, "orders")
    assert(is_ok(r1), "create queue")
    m = unwrap(r1)
    assert(mb_queue_count(m) == 1, "1 queue")

    let dup = mb_create_queue(m, "orders")
    assert(is_err(dup), "duplicate queue")

    let r2 = mb_enqueue(m, "orders", "order-1")
    assert(is_ok(r2), "enqueue ok")
    m = unwrap(r2)
    let r3 = mb_enqueue(m, "orders", "order-2")
    assert(is_ok(r3), "enqueue 2")
    m = unwrap(r3)
    assert(mb_queue_size(m, "orders") == 2, "size 2")

    let d1 = mb_dequeue(m, "orders")
    assert(is_ok(d1), "dequeue ok")
    assert(unwrap(d1) == "order-1", "FIFO order")

    assert(mb_total_enqueued(m) == 2, "2 enqueued")
    assert(mb_total_dequeued(m) == 1, "1 dequeued")

    let bad = mb_enqueue(m, "nope", "x")
    assert(is_err(bad), "unknown queue")

    print("MESSAGE-BROKER KAT PASS")
