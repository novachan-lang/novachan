// KAT for std/calendar/calendar_convert — calendar conversion via JDN.
// Note: days_between(1970,1,1, 2000,1,1) = 10957 (NOT 11323; 10957 is the
// correct count: 30 years, 7 leap years -> 23*365 + 7*366 = 10957).
import std/calendar/calendar_convert

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // ── via_jdn_greg_to_greg — identity round-trip ────────────────────────────
    let r1 = via_jdn_greg_to_greg(2000, 1, 1)
    cki("roundtrip 2000-01-01 y", r1[0], 2000)
    cki("roundtrip 2000-01-01 m", r1[1], 1)
    cki("roundtrip 2000-01-01 d", r1[2], 1)

    let r2 = via_jdn_greg_to_greg(1970, 1, 1)
    cki("roundtrip 1970-01-01 y", r2[0], 1970)
    cki("roundtrip 1970-01-01 m", r2[1], 1)
    cki("roundtrip 1970-01-01 d", r2[2], 1)

    let r3 = via_jdn_greg_to_greg(2024, 2, 29)
    cki("roundtrip 2024-02-29 y", r3[0], 2024)
    cki("roundtrip 2024-02-29 m", r3[1], 2)
    cki("roundtrip 2024-02-29 d", r3[2], 29)

    // ── days_between ──────────────────────────────────────────────────────────
    // Adjacent days
    cki("days 2000-01-01 to 2000-01-02", days_between(2000, 1, 1, 2000, 1, 2), 1)
    // Same day = 0
    cki("days same day",                 days_between(2023, 6, 15, 2023, 6, 15), 0)
    // Unix epoch to J2000: 10957 days (30 years, 7 leap)
    cki("days 1970->2000",               days_between(1970, 1, 1, 2000, 1, 1), 10957)
    // Negative: backward in time
    cki("days backward",                 days_between(2000, 1, 2, 2000, 1, 1), -1)
    // Across Feb-29 boundary (2024 is leap)
    cki("days 2024-02-28 to 2024-03-01", days_between(2024, 2, 28, 2024, 3, 1), 2)
    // 2023 is not leap: Feb-28 to Mar-01 = 1 day
    cki("days 2023-02-28 to 2023-03-01", days_between(2023, 2, 28, 2023, 3, 1), 1)

    // ── add_days ──────────────────────────────────────────────────────────────
    // Step over Feb-29 in leap year
    let a1 = add_days(2024, 2, 28, 1)
    cki("add 2024-02-28+1 y", a1[0], 2024)
    cki("add 2024-02-28+1 m", a1[1], 2)
    cki("add 2024-02-28+1 d", a1[2], 29)

    // Year boundary
    let a2 = add_days(2023, 12, 31, 1)
    cki("add 2023-12-31+1 y", a2[0], 2024)
    cki("add 2023-12-31+1 m", a2[1], 1)
    cki("add 2023-12-31+1 d", a2[2], 1)

    // Negative: go back one day
    let a3 = add_days(2024, 1, 1, -1)
    cki("add 2024-01-01-1 y", a3[0], 2023)
    cki("add 2024-01-01-1 m", a3[1], 12)
    cki("add 2024-01-01-1 d", a3[2], 31)

    // Add zero
    let a4 = add_days(2000, 6, 15, 0)
    cki("add 2000-06-15+0 y", a4[0], 2000)
    cki("add 2000-06-15+0 m", a4[1], 6)
    cki("add 2000-06-15+0 d", a4[2], 15)

    // Large positive offset: +365 (2024 is leap so +366 lands same date)
    let a5 = add_days(2024, 2, 29, 366)
    cki("add 2024-02-29+366 y", a5[0], 2025)
    cki("add 2024-02-29+366 m", a5[1], 3)
    cki("add 2024-02-29+366 d", a5[2], 1)

    print("PASS _calendar_convert_test")
