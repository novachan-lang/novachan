// _angle_unit_test.nova — KAT for std/units/angle_unit
import std/units/angle_unit

fn approx(a: float, b: float, tol: float) -> int
    let d = a - b
    let ad = d
    if d < 0.0
        ad = 0.0 - d
    let result = 0
    if ad < tol
        result = 1
    result

fn main()
    // KAT 1: deg_to_rad(180) == PI ~= 3.14159265
    let r1 = deg_to_rad(180.0)
    if approx(r1, 3.14159265, 0.0001) == 0
        print("FAIL angle deg_to_rad(180): got=" + str(r1) + " want=3.14159265")
        exit(1)

    // KAT 2: rad_to_deg(PI) == 180.0
    let PI = 3.141592653589793
    let r2 = rad_to_deg(PI)
    if approx(r2, 180.0, 0.0001) == 0
        print("FAIL angle rad_to_deg(PI): got=" + str(r2) + " want=180.0")
        exit(1)

    // KAT 3: 90 deg -> 100 grad
    let r3 = angle_unit_convert(90.0, "deg", "grad")
    if approx(r3, 100.0, 0.0001) == 0
        print("FAIL angle 90deg->grad: got=" + str(r3) + " want=100.0")
        exit(1)

    // KAT 4: 1 turn -> 360 deg
    let r4 = angle_unit_convert(1.0, "turn", "deg")
    if approx(r4, 360.0, 0.0001) == 0
        print("FAIL angle 1turn->deg: got=" + str(r4) + " want=360.0")
        exit(1)

    // KAT 5: 60 arcmin -> 1 deg
    let r5 = angle_unit_convert(60.0, "arcmin", "deg")
    if approx(r5, 1.0, 0.0001) == 0
        print("FAIL angle 60arcmin->deg: got=" + str(r5) + " want=1.0")
        exit(1)

    // KAT 6: round-trip deg -> rad -> deg
    let deg_in = 45.0
    let as_rad = angle_unit_convert(deg_in, "deg", "rad")
    let back = angle_unit_convert(as_rad, "rad", "deg")
    if approx(back, deg_in, 0.0001) == 0
        print("FAIL angle round-trip deg: got=" + str(back))
        exit(1)

    // KAT 7: 3600 arcsec -> 1 deg
    let r7 = angle_unit_convert(3600.0, "arcsec", "deg")
    if approx(r7, 1.0, 0.0001) == 0
        print("FAIL angle 3600arcsec->deg: got=" + str(r7) + " want=1.0")
        exit(1)

    // KAT 8: 0 deg -> 0 rad (boundary)
    let r8 = deg_to_rad(0.0)
    if approx(r8, 0.0, 0.0001) == 0
        print("FAIL angle deg_to_rad(0): got=" + str(r8))
        exit(1)

    // KAT 9: deg_to_grad(90.0) == 100.0
    let r9 = deg_to_grad(90.0)
    if approx(r9, 100.0, 0.0001) == 0
        print("FAIL angle deg_to_grad(90): got=" + str(r9) + " want=100.0")
        exit(1)

    // KAT 10: angle_unit_is_supported("turn") == 1
    let s1 = angle_unit_is_supported("turn")
    if s1 != 1
        print("FAIL angle is_supported turn: got=" + str(s1))
        exit(1)

    // KAT 11: angle_unit_is_supported("xyz") == 0
    let s2 = angle_unit_is_supported("xyz")
    if s2 != 0
        print("FAIL angle is_supported xyz: got=" + str(s2))
        exit(1)

    // KAT 12: 1 turn -> 2*PI rad
    let r12 = angle_unit_convert(1.0, "turn", "rad")
    let two_pi = 3.141592653589793 * 2.0
    if approx(r12, two_pi, 0.0001) == 0
        print("FAIL angle 1turn->rad: got=" + str(r12) + " want=" + str(two_pi))
        exit(1)

    print("PASS _angle_unit_test")
