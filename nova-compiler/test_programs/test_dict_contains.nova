fn main()
    let d = {}
    d["hello"] = 1
    d["world"] = 2
    d["print"] = 3
    if contains(d, "hello")
        print("found hello")
    else
        print("NOT found hello")
    if contains(d, "print")
        print("found print")
    else
        print("NOT found print")
    if contains(d, "missing")
        print("found missing")
    else
        print("NOT found missing")
