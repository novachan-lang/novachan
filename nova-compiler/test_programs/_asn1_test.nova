// _asn1_test — KAT for std/data/asn1 (ASN.1 DER encoder)
//
// Verifies:
//   1. asn_encode_int(42)   -> [2,1,42]
//   2. asn_encode_int(256)  -> [2,2,1,0]
//   3. asn_encode_int(0)    -> [2,1,0]
//   4. asn_encode_octetstring("AB") -> [4,2,65,66]
//   5. asn_tag(asn_encode_int(5)) == 2
//   6. asn_length(asn_encode_octetstring("ABC")) == 3
//   7. asn_encode_sequence([asn_encode_int(1), asn_encode_int(2)])
//      -> [48,6,2,1,1,2,1,2]

import std/data/asn1

// ── KAT 1: asn_encode_int(42) == [2,1,42] ───────────────────────────────────
let r1 = asn_encode_int(42)
if bytes_len(r1) != 3
    print("FAIL kat1: wrong length")
    exit(1)
if bytes_get(r1, 0) != 2
    print("FAIL kat1: wrong tag")
    exit(1)
if bytes_get(r1, 1) != 1
    print("FAIL kat1: wrong length byte")
    exit(1)
if bytes_get(r1, 2) != 42
    print("FAIL kat1: wrong value byte")
    exit(1)
print("PASS kat1: asn_encode_int(42)")

// ── KAT 2: asn_encode_int(256) == [2,2,1,0] ─────────────────────────────────
let r2 = asn_encode_int(256)
if bytes_len(r2) != 4
    print("FAIL kat2: wrong length")
    exit(1)
if bytes_get(r2, 0) != 2
    print("FAIL kat2: tag != 2")
    exit(1)
if bytes_get(r2, 1) != 2
    print("FAIL kat2: content-len byte != 2")
    exit(1)
if bytes_get(r2, 2) != 1
    print("FAIL kat2: high byte != 1")
    exit(1)
if bytes_get(r2, 3) != 0
    print("FAIL kat2: low byte != 0")
    exit(1)
print("PASS kat2: asn_encode_int(256)")

// ── KAT 3: asn_encode_int(0) == [2,1,0] ─────────────────────────────────────
let r3 = asn_encode_int(0)
if bytes_len(r3) != 3
    print("FAIL kat3: wrong length")
    exit(1)
if bytes_get(r3, 0) != 2
    print("FAIL kat3: tag != 2")
    exit(1)
if bytes_get(r3, 1) != 1
    print("FAIL kat3: len byte != 1")
    exit(1)
if bytes_get(r3, 2) != 0
    print("FAIL kat3: value != 0")
    exit(1)
print("PASS kat3: asn_encode_int(0)")

// ── KAT 4: asn_encode_octetstring("AB") == [4,2,65,66] ─────────────────────
let ab = str_to_bytes("AB")
let r4 = asn_encode_octetstring(ab)
if bytes_len(r4) != 4
    print("FAIL kat4: wrong length")
    exit(1)
if bytes_get(r4, 0) != 4
    print("FAIL kat4: tag != 4")
    exit(1)
if bytes_get(r4, 1) != 2
    print("FAIL kat4: len byte != 2")
    exit(1)
if bytes_get(r4, 2) != 65
    print("FAIL kat4: 'A' != 65")
    exit(1)
if bytes_get(r4, 3) != 66
    print("FAIL kat4: 'B' != 66")
    exit(1)
print("PASS kat4: asn_encode_octetstring('AB')")

// ── KAT 5: asn_tag(asn_encode_int(5)) == 2 ──────────────────────────────────
let r5 = asn_encode_int(5)
let t5 = asn_tag(r5)
if t5 != 2
    print("FAIL kat5: tag != 2")
    exit(1)
print("PASS kat5: asn_tag == 2")

// ── KAT 6: asn_length(asn_encode_octetstring("ABC")) == 3 ───────────────────
let abc = str_to_bytes("ABC")
let r6 = asn_encode_octetstring(abc)
let l6 = asn_length(r6)
if l6 != 3
    print("FAIL kat6: length != 3")
    exit(1)
print("PASS kat6: asn_length == 3")

// ── KAT 7: SEQUENCE([INT 1, INT 2]) == [48,6,2,1,1,2,1,2] ──────────────────
let i1 = asn_encode_int(1)
let i2 = asn_encode_int(2)
let seq_items = [i1, i2]
let r7 = asn_encode_sequence(seq_items)
// Expected: 48  6  2 1 1  2 1 2
if bytes_len(r7) != 8
    print("FAIL kat7: total length != 8")
    exit(1)
if bytes_get(r7, 0) != 48
    print("FAIL kat7: tag != 48 (0x30)")
    exit(1)
if bytes_get(r7, 1) != 6
    print("FAIL kat7: content-len byte != 6")
    exit(1)
if bytes_get(r7, 2) != 2
    print("FAIL kat7: INT tag byte[2] != 2")
    exit(1)
if bytes_get(r7, 3) != 1
    print("FAIL kat7: INT len byte[3] != 1")
    exit(1)
if bytes_get(r7, 4) != 1
    print("FAIL kat7: value 1 at byte[4] != 1")
    exit(1)
if bytes_get(r7, 5) != 2
    print("FAIL kat7: INT tag byte[5] != 2")
    exit(1)
if bytes_get(r7, 6) != 1
    print("FAIL kat7: INT len byte[6] != 1")
    exit(1)
if bytes_get(r7, 7) != 2
    print("FAIL kat7: value 2 at byte[7] != 2")
    exit(1)
print("PASS kat7: asn_encode_sequence([INT 1, INT 2])")

// ── Additional round-trip: asn_tag + asn_length on SEQUENCE ─────────────────
let tag7 = asn_tag(r7)
if tag7 != 48
    print("FAIL extra: sequence tag != 48")
    exit(1)
let len7 = asn_length(r7)
if len7 != 6
    print("FAIL extra: sequence content length != 6")
    exit(1)
print("PASS extra: asn_tag/asn_length on SEQUENCE")

print("_asn1_test passed")
