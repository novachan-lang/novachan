// KAT test for std/text/zalgorithm
import std/text/zalgorithm

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// ckli compares two lists of ints by length then element.
fn ckli(label, got, expected)
    if len(got) != len(expected)
        print("FAIL " + label + ": length got=" + str(len(got)) + " expected=" + str(len(expected)))
        exit(1)
    let i = 0
    while i < len(got)
        let gv = got[i]
        let ev = expected[i]
        if gv != ev
            print("FAIL " + label + "[" + str(i) + "]: got=" + str(gv) + " expected=" + str(ev))
            exit(1)
        i = i + 1

fn main()
    // ── z_array KAT 1: "aaaa" → [0,3,2,1] ───────────────────────────────────
    // Z[1]=3: "aaa" == prefix "aaa" (of "aaaa")
    // Z[2]=2: "aa"  == prefix "aa"
    // Z[3]=1: "a"   == prefix "a"
    let z1 = z_array("aaaa")
    let e1 = [0, 3, 2, 1]
    ckli("z_array aaaa", z1, e1)

    // ── z_array KAT 2: "abab" → [0,0,2,0] ───────────────────────────────────
    // Z[1]=0: 'b' != 'a'
    // Z[2]=2: "ab" == prefix "ab"
    // Z[3]=0: 'b' != 'a'
    let z2 = z_array("abab")
    let e2 = [0, 0, 2, 0]
    ckli("z_array abab", z2, e2)

    // ── z_array KAT 3: "abacaba" → [0,0,1,0,3,0,1] ──────────────────────────
    // Z[1]=0: 'b'!='a'
    // Z[2]=1: 'a'=='a', 'c'!='b'  → 1
    // Z[3]=0: 'c'!='a'
    // Z[4]=3: "aba" == "aba" prefix
    // Z[5]=0: 'b'!='a'
    // Z[6]=1: 'a'=='a', end of string → 1
    let z3 = z_array("abacaba")
    let e3 = [0, 0, 1, 0, 3, 0, 1]
    ckli("z_array abacaba", z3, e3)

    // ── z_array KAT 4: single char → [0] ─────────────────────────────────────
    let z4 = z_array("x")
    let e4 = [0]
    ckli("z_array single", z4, e4)

    // ── z_array KAT 5: empty string → [] ─────────────────────────────────────
    let z5 = z_array("")
    let e5 = []
    ckli("z_array empty", z5, e5)

    // ── z_search KAT 6: "aabaacaadaabaaba","aaba" → [0,9,12] ────────────────
    // Positions (0-based) where "aaba" occurs in "aabaacaadaabaaba":
    //   pos 0: "aaba" ✓
    //   pos 9: "aaba" ✓
    //   pos 12: "aaba" ✓
    let r6 = z_search("aabaacaadaabaaba", "aaba")
    let e6 = [0, 9, 12]
    ckli("z_search aabaacaadaabaaba aaba", r6, e6)

    // ── z_search KAT 7: no match → [] ────────────────────────────────────────
    let r7 = z_search("abc", "xyz")
    let e7 = []
    ckli("z_search no match", r7, e7)

    // ── z_search KAT 8: overlapping "aa" in "aaaa" → [0,1,2] ────────────────
    let r8 = z_search("aaaa", "aa")
    let e8 = [0, 1, 2]
    ckli("z_search overlapping aa in aaaa", r8, e8)

    // ── z_count KAT 9: "aa" in "aaaa" → 3 ───────────────────────────────────
    cki("z_count aa in aaaa", z_count("aaaa", "aa"), 3)

    // ── z_count KAT 10: no occurrences → 0 ───────────────────────────────────
    cki("z_count no match", z_count("abc", "xyz"), 0)

    // ── z_count KAT 11: single match → 1 ─────────────────────────────────────
    cki("z_count single", z_count("abacaba", "bac"), 1)

    // ── z_search KAT 12: empty pattern → [] ──────────────────────────────────
    let r12 = z_search("hello", "")
    let e12 = []
    ckli("z_search empty pat", r12, e12)

    print("_zalgorithm_test passed")
