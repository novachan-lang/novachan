import forge_lichao as lc

fn check(cond: bool, label: str)
    if cond == false
        print("FAIL: " + label)

// Brute-force min over lines at x
fn brute_min(lines: list, x: int) -> int
    let best = 4000000000000000000
    let i = 0
    while i < len(lines)
        let m = lines[i][0]
        let b = lines[i][1]
        let val = m * x + b
        if val < best
            best = val
        i = i + 1
    return best

// TEST 1: single line
let t1 = lc.lichao_new(0, 10)
lc.lichao_add(t1, 2, 3)  // y = 2x + 3
check(lc.lichao_query_min(t1, 0) == 3, "single line at x=0 -> 3")
check(lc.lichao_query_min(t1, 5) == 13, "single line at x=5 -> 13")

// TEST 2: two crossing lines
// y = 2x (m=2,b=0) and y = -x + 10 (m=-1,b=10)
// crossing: 2x = -x + 10 -> 3x = 10 -> x ~ 3.33
// For x < 3.33, -x+10 lower? at x=0: 2x=0 vs 10 -> 2x lower (0<10). Hmm both min varies.
// at x=0: min(0, 10) = 0
// at x=5: min(10, 5) = 5
// at x=3: min(6, 7) = 6
// at x=4: min(8, 6) = 6
let t2 = lc.lichao_new(0, 10)
lc.lichao_add(t2, 2, 0)
lc.lichao_add(t2, 0 - 1, 10)
check(lc.lichao_query_min(t2, 0) == 0, "two lines at x=0 -> 0")
check(lc.lichao_query_min(t2, 5) == 5, "two lines at x=5 -> 5")
check(lc.lichao_query_min(t2, 3) == 6, "two lines at x=3 -> 6")
check(lc.lichao_query_min(t2, 4) == 6, "two lines at x=4 -> 6")

// TEST 3: horizontal line (m=0)
let t3 = lc.lichao_new(0, 20)
lc.lichao_add(t3, 0, 5)  // constant y=5
lc.lichao_add(t3, 1, 0)  // y=x
// at x=3: min(5, 3) = 3; at x=10: min(5, 10) = 5
check(lc.lichao_query_min(t3, 3) == 3, "const+line at x=3 -> 3")
check(lc.lichao_query_min(t3, 10) == 5, "const+line at x=10 -> 5")

// TEST 4: DECISIVE brute-force cross-check with many lines, ANY insertion order
// Domain [0, 100]. Add a batch of lines and check every query point.
let lines = [[3, 5], [0 - 2, 40], [1, 10], [0 - 5, 100], [4, 0 - 8], [0, 12], [2, 3], [0 - 1, 25], [6, 0 - 30], [0 - 4, 80]]
let t4 = lc.lichao_new(0, 100)
let i = 0
while i < len(lines)
    lc.lichao_add(t4, lines[i][0], lines[i][1])
    i = i + 1

let ok = true
let x = 0
while x <= 100
    let expected = brute_min(lines, x)
    let got = lc.lichao_query_min(t4, x)
    if expected != got
        ok = false
        print("MISMATCH x=" + str(x) + " expected=" + str(expected) + " got=" + str(got))
    x = x + 1
check(ok, "DECISIVE: Li Chao matches brute-force min over 10 lines at ALL x in 0..100")

// TEST 5: interleaved add and query (fully online)
let t5 = lc.lichao_new(0, 50)
lc.lichao_add(t5, 5, 0)  // y=5x
check(lc.lichao_query_min(t5, 10) == 50, "online: only 5x -> 50 at x=10")
lc.lichao_add(t5, 0, 20)  // y=20 constant
check(lc.lichao_query_min(t5, 10) == 20, "online: after adding const 20, x=10 -> 20")
lc.lichao_add(t5, 1, 5)   // y=x+5
check(lc.lichao_query_min(t5, 10) == 15, "online: after x+5, x=10 -> 15")
check(lc.lichao_query_min(t5, 2) == 7, "online: x=2 -> min(10,20,7)=7")

// TEST 6: negative domain
let t6 = lc.lichao_new(0 - 20, 20)
lc.lichao_add(t6, 1, 0)   // y=x
lc.lichao_add(t6, 0 - 1, 0)  // y=-x
// min at x=-5: min(-5, 5) = -5; at x=5: min(5, -5) = -5
check(lc.lichao_query_min(t6, 0 - 5) == 0 - 5, "neg domain x=-5 -> -5")
check(lc.lichao_query_min(t6, 5) == 0 - 5, "neg domain x=5 -> -5")
check(lc.lichao_query_min(t6, 0) == 0, "neg domain x=0 -> 0")

// TEST 7: MAX envelope via negation (add -m, -b; negate query)
// Want max of {y=x, y=-x+10} at x=3: max(3, 7)=7
let t7 = lc.lichao_new(0, 20)
lc.lichao_add(t7, 0 - 1, 0)       // represents y=x for max -> stored as -x
lc.lichao_add(t7, 1, 0 - 10)      // represents y=-x+10 for max -> stored as x-10
let max_at_3 = 0 - lc.lichao_query_min(t7, 3)
check(max_at_3 == 7, "max envelope via negation at x=3 -> 7")

print("forge_lichao: KAT done")
