// _scale_test.nova — KAT for std/music/scale
//
// Known-answer tests for scale utilities.
//
// HAND-VERIFIED VECTORS
//   scale_notes(60, "major"):
//     offsets [0,2,4,5,7,9,11] + 60 = [60,62,64,65,67,69,71]
//   scale_notes(60, "natural_minor"):
//     offsets [0,2,3,5,7,8,10] + 60 = [60,62,63,65,67,68,70]
//   scale_pattern("major_pentatonic"):
//     [0,2,4,7,9]
//   scale_degree(60, "major", 5):
//     pattern[4] = 7, so 60+7 = 67
//   in_scale(66, 60, "major"):
//     66 pc=6, root pc=0, rel=6 — not in [0,2,4,5,7,9,11] -> false (0)
//   in_scale(67, 60, "major"):
//     67 pc=7, root pc=0, rel=7 — in [0,2,4,5,7,9,11] -> true (1)

import std/music/scale

// ── helpers ──────────────────────────────────────────────────────────────────

fn cki(label, got, want)
    if got != want
        print("FAIL scale " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    if got != want
        print("FAIL scale " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck_list(label, got, want)
    let ok = 1
    if len(got) != len(want)
        ok = 0
    else
        let i = 0
        while i < len(want)
            if got[i] != want[i]
                ok = 0
            i = i + 1
    if ok == 0
        // Print both lists for debugging.
        let gs = "["
        let ws = "["
        let i = 0
        while i < len(got)
            if i > 0
                gs = gs + ","
            gs = gs + str(got[i])
            i = i + 1
        gs = gs + "]"
        let j = 0
        while j < len(want)
            if j > 0
                ws = ws + ","
            ws = ws + str(want[j])
            j = j + 1
        ws = ws + "]"
        print("FAIL scale " + label + ": got=" + gs + " want=" + ws)
        exit(1)

// ── main ─────────────────────────────────────────────────────────────────────

fn main()
    // ── scale_notes ───────────────────────────────────────────────────────────

    // KAT spec vector 1: scale_notes(60,"major")==[60,62,64,65,67,69,71]
    let maj_want = []
    push(maj_want, 60)
    push(maj_want, 62)
    push(maj_want, 64)
    push(maj_want, 65)
    push(maj_want, 67)
    push(maj_want, 69)
    push(maj_want, 71)
    ck_list("scale_notes(60,major)", scale_notes(60, "major"), maj_want)

    // KAT spec vector 2: scale_notes(60,"natural_minor")==[60,62,63,65,67,68,70]
    let nm_want = []
    push(nm_want, 60)
    push(nm_want, 62)
    push(nm_want, 63)
    push(nm_want, 65)
    push(nm_want, 67)
    push(nm_want, 68)
    push(nm_want, 70)
    ck_list("scale_notes(60,natural_minor)", scale_notes(60, "natural_minor"), nm_want)

    // Additional: harmonic_minor from C4 -> [60,62,63,65,67,68,71]
    let hm_want = []
    push(hm_want, 60)
    push(hm_want, 62)
    push(hm_want, 63)
    push(hm_want, 65)
    push(hm_want, 67)
    push(hm_want, 68)
    push(hm_want, 71)
    ck_list("scale_notes(60,harmonic_minor)", scale_notes(60, "harmonic_minor"), hm_want)

    // Additional: melodic_minor from C4 -> [60,62,63,65,67,69,71]
    let mm_want = []
    push(mm_want, 60)
    push(mm_want, 62)
    push(mm_want, 63)
    push(mm_want, 65)
    push(mm_want, 67)
    push(mm_want, 69)
    push(mm_want, 71)
    ck_list("scale_notes(60,melodic_minor)", scale_notes(60, "melodic_minor"), mm_want)

    // Additional: blues from C4 -> [60,63,65,66,67,70]
    let bl_want = []
    push(bl_want, 60)
    push(bl_want, 63)
    push(bl_want, 65)
    push(bl_want, 66)
    push(bl_want, 67)
    push(bl_want, 70)
    ck_list("scale_notes(60,blues)", scale_notes(60, "blues"), bl_want)

    // Additional: whole_tone from C4 -> [60,62,64,66,68,70]
    let wt_want = []
    push(wt_want, 60)
    push(wt_want, 62)
    push(wt_want, 64)
    push(wt_want, 66)
    push(wt_want, 68)
    push(wt_want, 70)
    ck_list("scale_notes(60,whole_tone)", scale_notes(60, "whole_tone"), wt_want)

    // Additional: chromatic from C4 -> 12 notes [60..71]
    let chr_want = []
    let ci = 0
    while ci < 12
        push(chr_want, 60 + ci)
        ci = ci + 1
    ck_list("scale_notes(60,chromatic)", scale_notes(60, "chromatic"), chr_want)

    // Non-zero root: A4=69, major -> [69,71,73,74,76,78,80]
    let a4maj_want = []
    push(a4maj_want, 69)
    push(a4maj_want, 71)
    push(a4maj_want, 73)
    push(a4maj_want, 74)
    push(a4maj_want, 76)
    push(a4maj_want, 78)
    push(a4maj_want, 80)
    ck_list("scale_notes(69,major)", scale_notes(69, "major"), a4maj_want)

    // ── scale_pattern ─────────────────────────────────────────────────────────

    // KAT spec vector 3: scale_pattern("major_pentatonic")==[0,2,4,7,9]
    let mp_want = []
    push(mp_want, 0)
    push(mp_want, 2)
    push(mp_want, 4)
    push(mp_want, 7)
    push(mp_want, 9)
    ck_list("scale_pattern(major_pentatonic)", scale_pattern("major_pentatonic"), mp_want)

    // minor_pentatonic: [0,3,5,7,10]
    let minp_want = []
    push(minp_want, 0)
    push(minp_want, 3)
    push(minp_want, 5)
    push(minp_want, 7)
    push(minp_want, 10)
    ck_list("scale_pattern(minor_pentatonic)", scale_pattern("minor_pentatonic"), minp_want)

    // Unknown name -> empty list
    let unk = scale_pattern("dorian")
    cki("scale_pattern(unknown) len", len(unk), 0)

    // ── scale_degree ──────────────────────────────────────────────────────────

    // KAT spec vector 4: scale_degree(60,"major",5)==67
    cki("scale_degree(60,major,5)", scale_degree(60, "major", 5), 67)

    // Degree 1 always equals root.
    cki("scale_degree(60,major,1)", scale_degree(60, "major", 1), 60)
    // Degree 7 = 60 + 11 = 71.
    cki("scale_degree(60,major,7)", scale_degree(60, "major", 7), 71)
    // Degree 3 of natural_minor = 60 + 3 = 63.
    cki("scale_degree(60,natural_minor,3)", scale_degree(60, "natural_minor", 3), 63)
    // Degree 5 of major_pentatonic (5 notes) = 60 + 9 = 69.
    cki("scale_degree(60,major_pentatonic,5)", scale_degree(60, "major_pentatonic", 5), 69)
    // Out-of-range degree -> -1.
    cki("scale_degree(60,major,0)", scale_degree(60, "major", 0), -1)
    cki("scale_degree(60,major,8)", scale_degree(60, "major", 8), -1)

    // ── in_scale ──────────────────────────────────────────────────────────────

    // KAT spec vector 5: in_scale(66,60,"major")==false (0)
    ckb("in_scale(66,60,major)=false", in_scale(66, 60, "major"), 0)

    // KAT spec vector 6: in_scale(67,60,"major")==true (1)
    ckb("in_scale(67,60,major)=true", in_scale(67, 60, "major"), 1)

    // Root itself is always in scale.
    ckb("in_scale(60,60,major)=true", in_scale(60, 60, "major"), 1)

    // Octave equivalent: 72 (C5) is also C, in C major.
    ckb("in_scale(72,60,major)=true", in_scale(72, 60, "major"), 1)

    // F# (66) not in C major, but IS in G major (root=67): rel=66-67=-1+12=11 — not in major.
    // G major offsets [0,2,4,5,7,9,11]: F# pc=6, G pc=7, rel=6-7=-1+12=11 — 11 IS in major.
    ckb("in_scale(66,67,major)=true", in_scale(66, 67, "major"), 1)

    // Blues: note 64 (E) relative to C root: rel=4, not in [0,3,5,6,7,10] -> false.
    ckb("in_scale(64,60,blues)=false", in_scale(64, 60, "blues"), 0)

    // Blues: note 63 (Eb) rel=3, IS in blues -> true.
    ckb("in_scale(63,60,blues)=true", in_scale(63, 60, "blues"), 1)

    print("PASS _scale_test")
