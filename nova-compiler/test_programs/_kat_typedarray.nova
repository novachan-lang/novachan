// KAT: LOCK-4 inc3d -- packed typed arrays.
//
// The claim being tested is MEMORY, so the tests assert bytes, not just values: a u8 array of
// 1000 elements must occupy 1000 bytes, against the 8000 a boxed list would need. A test that
// only checked values would pass just as happily against an implementation that stored
// everything as i64 and called it packed.
import std/collections/typedarray

fn main()
    let ok_n = 0
    let fail = 0

    // ── the packing is REAL ─────────────────────────────────────────────
    let u = unwrap(ta_new(ta_u8(), 1000))
    let w = unwrap(ta_new(ta_i16(), 1000))
    let q = unwrap(ta_new(ta_i32(), 1000))
    let d = unwrap(ta_new(ta_f64(), 1000))
    if ta_bytes(u) == 1000 and ta_bytes(w) == 2000 and ta_bytes(q) == 4000 and ta_bytes(d) == 8000
        ok_n = ok_n + 1
        print("ok: elements occupy their true width (1000 u8 = 1000 bytes, not 8000)")
    else
        fail = fail + 1
        print("FAIL packing: " + str(ta_bytes(u)) + " " + str(ta_bytes(w)) + " " + str(ta_bytes(q)))

    // ── round-trip at each width, including the sign boundary ───────────
    let i8a = unwrap(ta_new(ta_i8(), 4))
    tarray_set(i8a, 0, 127)
    tarray_set(i8a, 1, -128)
    tarray_set(i8a, 2, 300)     // truncates with defined wrapping, like sized-int arithmetic
    tarray_set(i8a, 3, -1)
    if tarray_get(i8a, 0) == 127 and tarray_get(i8a, 1) == -128 and tarray_get(i8a, 2) == 44 and tarray_get(i8a, 3) == -1
        ok_n = ok_n + 1
        print("ok: i8 sign-extends on read and truncates on write (300 -> 44)")
    else
        fail = fail + 1
        print("FAIL i8: " + str(tarray_get(i8a, 0)) + " " + str(tarray_get(i8a, 1)) + " " + str(tarray_get(i8a, 2)))

    let u8a = unwrap(ta_new(ta_u8(), 2))
    tarray_set(u8a, 0, 255)
    tarray_set(u8a, 1, 256)
    if tarray_get(u8a, 0) == 255 and tarray_get(u8a, 1) == 0
        ok_n = ok_n + 1
        print("ok: u8 zero-extends on read and wraps on write (256 -> 0)")
    else
        fail = fail + 1
        print("FAIL u8: " + str(tarray_get(u8a, 0)) + " " + str(tarray_get(u8a, 1)))

    let i32a = unwrap(ta_new(ta_i32(), 2))
    tarray_set(i32a, 0, 2147483647)
    tarray_set(i32a, 1, -2147483648)
    if tarray_get(i32a, 0) == 2147483647 and tarray_get(i32a, 1) == -2147483648
        ok_n = ok_n + 1
        print("ok: i32 holds its full signed range")
    else
        fail = fail + 1
        print("FAIL i32")

    // ── floats: f32 must actually LOSE precision, f64 must not ──────────
    let f32a = unwrap(ta_new(ta_f32(), 1))
    let f64a = unwrap(ta_new(ta_f64(), 1))
    tarray_setf(f32a, 0, 16777217.0)
    tarray_setf(f64a, 0, 16777217.0)
    if tarray_getf(f32a, 0) == 16777216.0 and tarray_getf(f64a, 0) == 16777217.0
        ok_n = ok_n + 1
        print("ok: f32 storage genuinely narrows (16777217 -> 16777216); f64 does not")
    else
        fail = fail + 1
        print("FAIL float storage: " + str(tarray_getf(f32a, 0)) + " " + str(tarray_getf(f64a, 0)))

    // ── len / index through the GENERIC paths ───────────────────────────
    let g = unwrap(ta_of_list(ta_i32(), [10, 20, 30, 40]))
    let via_index = g[2]
    g[3] = 99
    if len(g) == 4 and via_index == 30 and g[3] == 99
        ok_n = ok_n + 1
        print("ok: len(a) and a[i] / a[i]=v dispatch at the right element width")
    else
        fail = fail + 1
        print("FAIL generic paths: len=" + str(len(g)) + " idx=" + str(via_index) + " set=" + str(g[3]))

    // ── iteration materialises the right values, not raw bytes ──────────
    let it_sum = 0
    for v in g
        it_sum = it_sum + v
    if it_sum == 159
        ok_n = ok_n + 1
        print("ok: `for v in a` yields elements, not misread bytes")
    else
        fail = fail + 1
        print("FAIL iteration sum: " + str(it_sum))

    // ── checked accessors return Result ─────────────────────────────────
    let good = ta_at(g, 0)
    let bad = ta_at(g, 99)
    let badput = ta_put(g, -1, 5)
    if is_ok(good) and is_err(bad) and is_err(badput)
        ok_n = ok_n + 1
        print("ok: ta_at / ta_put report an out-of-range index as err(), not as 0")
    else
        fail = fail + 1
        print("FAIL Result accessors")

    // ── higher-order surface ────────────────────────────────────────────
    let src = unwrap(ta_of_list(ta_i32(), [1, 2, 3, 4, 5, 6]))
    let doubled = unwrap(ta_map(src, x => x * 2))
    let evens = unwrap(ta_filter(src, x => x % 2 == 0))
    let total = ta_fold(src, 0, (acc, v) => acc + v)
    let idx = ta_find_index(src, x => x > 4)
    if tarray_get(doubled, 5) == 12 and ta_len(evens) == 3 and total == 21 and unwrap(idx) == 4
        ok_n = ok_n + 1
        print("ok: map / filter / fold / find_index over closures, staying packed")
    else
        fail = fail + 1
        print("FAIL HOF: " + str(tarray_get(doubled, 5)) + " " + str(ta_len(evens)) + " " + str(total))

    if ta_all(src, x => x > 0) and ta_any(src, x => x == 6) and not ta_any(src, x => x > 100)
        ok_n = ok_n + 1
        print("ok: all / any short-circuit correctly")
    else
        fail = fail + 1
        print("FAIL all/any")

    // ── reductions refuse the meaningless case rather than answering it ──
    let fsum = ta_sum(unwrap(ta_new(ta_f64(), 3)))
    if unwrap(ta_sum(src)) == 21 and unwrap(ta_min(src)) == 1 and unwrap(ta_max(src)) == 6 and is_err(fsum)
        ok_n = ok_n + 1
        print("ok: sum/min/max on ints; err() on float kinds rather than a plausible wrong number")
    else
        fail = fail + 1
        print("FAIL reductions")

    // ── copy independence: a clone must not alias ───────────────────────
    let c = unwrap(ta_clone(src))
    tarray_set(c, 0, 999)
    if tarray_get(src, 0) == 1 and tarray_get(c, 0) == 999 and ta_eq(src, unwrap(ta_clone(src)))
        ok_n = ok_n + 1
        print("ok: clone owns an independent buffer; ta_eq compares element-wise")
    else
        fail = fail + 1
        print("FAIL clone independence")

    // ── growth ──────────────────────────────────────────────────────────
    let grow = unwrap(ta_new(ta_u8(), 0))
    let gi = 0
    while gi < 300
        ta_push(grow, gi)
        gi = gi + 1
    if ta_len(grow) == 300 and tarray_get(grow, 299) == 43 and ta_bytes(grow) == 300
        ok_n = ok_n + 1
        print("ok: push grows geometrically and stays packed (299 wraps to 43 in u8)")
    else
        fail = fail + 1
        print("FAIL growth: len=" + str(ta_len(grow)) + " last=" + str(tarray_get(grow, 299)) + " bytes=" + str(ta_bytes(grow)))

    // ── float reductions through the float-typed surface ────────────────
    let fa = unwrap(ta_new(ta_f64(), 3))
    unwrap(ta_putf(fa, 0, 1.5))
    unwrap(ta_putf(fa, 1, 2.25))
    unwrap(ta_putf(fa, 2, 0.25))
    if unwrap(ta_sumf(fa)) == 4.0 and unwrap(ta_atf(fa, 1)) == 2.25 and is_err(ta_sumf(src))
        ok_n = ok_n + 1
        print("ok: float-typed accessors and ta_sumf; ta_sumf refuses integer kinds")
    else
        fail = fail + 1
        print("FAIL float surface: " + str(unwrap(ta_sumf(fa))))

    // ── the remaining generic dispatchers ───────────────────────────────
    // A typed array HAS a canonical JSON form -- an array of numbers -- unlike bytes, which
    // only get a diagnostic placeholder. Emitting the real thing is the point.
    let js = unwrap(ta_of_list(ta_i32(), [10, 20, 30]))
    let jf = unwrap(ta_new(ta_f64(), 2))
    unwrap(ta_putf(jf, 0, 1.5))
    unwrap(ta_putf(jf, 1, 2.25))
    if json_stringify(js) == "[10,20,30]" and json_stringify(jf) == "[1.5,2.25]"
        ok_n = ok_n + 1
        print("ok: json_stringify emits a real numeric array for int and float kinds")
    else
        fail = fail + 1
        print("FAIL json: " + json_stringify(js) + " " + json_stringify(jf))

    if contains(js, 20) and not contains(js, 99)
        ok_n = ok_n + 1
        print("ok: contains() tests ELEMENT membership, not string containment")
    else
        fail = fail + 1
        print("FAIL contains")

    // (index, element) pairs at the true element width
    let kvsum = 0
    let kvidx = 0
    for i, v in js
        kvidx = kvidx + i
        kvsum = kvsum + v
    if kvsum == 60 and kvidx == 3
        ok_n = ok_n + 1
        print("ok: `for i, v in a` yields index/element pairs")
    else
        fail = fail + 1
        print("FAIL kv iteration: " + str(kvsum) + " " + str(kvidx))

    // a slice is a NEW typed array of the SAME kind, clamped -- not a list, not a view
    let sl = js[1:3]
    let over = js[0:99]
    if ta_len(sl) == 2 and tarray_get(sl, 0) == 20 and ta_kind(sl) == ta_i32() and ta_bytes(sl) == 8 and ta_len(over) == 3
        ok_n = ok_n + 1
        print("ok: slice yields a same-kind packed array and clamps out-of-range bounds")
    else
        fail = fail + 1
        print("FAIL slice: len=" + str(ta_len(sl)) + " kind=" + str(ta_kind(sl)) + " bytes=" + str(ta_bytes(sl)))

    print("ok=" + str(ok_n) + " fail=" + str(fail))
    assert(fail == 0, "typedarray: all checks pass")
    assert(ok_n == 18, "typedarray: all 18 checks ran")
    print("KAT typedarray PASS")
