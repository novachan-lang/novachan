fn classify(n)
    match n
        1 | 2 | 3 => "few"
        4 | 5 => "some"
        6..10 => "medium"
        _ => "other"

fn describe(s)
    match s
        "yes" | "y" | "Y" => "affirmative"
        "no" | "n" | "N" => "negative"
        _ => "unknown"

fn grade(score)
    match score
        0..59 => "F"
        60..69 | 70..79 => "D-C"
        80..89 => "B"
        90 | 91 | 92 | 93 | 94 | 95 | 96 | 97 | 98 | 99 | 100 => "A"
        _ => "invalid"

fn main()
    assert(classify(1) == "few", "or 1")
    assert(classify(2) == "few", "or 2")
    assert(classify(3) == "few", "or 3")
    assert(classify(4) == "some", "or 4")
    assert(classify(5) == "some", "or 5")
    assert(classify(6) == "medium", "or 6")
    assert(classify(10) == "medium", "or 10")
    assert(classify(11) == "other", "or 11")
    assert(classify(0) == "other", "or 0")

    assert(describe("yes") == "affirmative", "str or 1")
    assert(describe("y") == "affirmative", "str or 2")
    assert(describe("Y") == "affirmative", "str or 3")
    assert(describe("no") == "negative", "str or 4")
    assert(describe("n") == "negative", "str or 5")
    assert(describe("N") == "negative", "str or 6")
    assert(describe("maybe") == "unknown", "str or 7")

    assert(grade(50) == "F", "grade F")
    assert(grade(65) == "D-C", "grade D")
    assert(grade(75) == "D-C", "grade C")
    assert(grade(85) == "B", "grade B")
    assert(grade(90) == "A", "grade A 90")
    assert(grade(95) == "A", "grade A 95")
    assert(grade(100) == "A", "grade A 100")
    assert(grade(101) == "invalid", "grade invalid")

    let x = 42
    match x
        1 | 2 | 3 =>
            assert(false, "should not match few")
        42 | 43 =>
            assert(true, "stmt or matched 42")
        _ =>
            assert(false, "should not match other")

    let neg = -5
    match neg
        -10..-6 => assert(false, "neg range wrong")
        -5 | -4 | -3 => assert(true, "neg or match")
        _ => assert(false, "neg wildcard wrong")

    match -1
        -1 => assert(true, "neg literal match")
        _ => assert(false, "neg literal miss")

    let r = match -7
        -10..-1 => "negative"
        0 => "zero"
        _ => "positive"
    assert(r == "negative", "neg range expr")

    print("or_pattern_test: all passed")
