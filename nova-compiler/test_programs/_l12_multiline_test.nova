// L12: multi-line list AND dict/collection literals
fn main()
    // multi-line list
    let xs = [
        1,
        2,
        3
    ]
    if len(xs) != 3 or xs[0] != 1 or xs[2] != 3
        print("FAIL list")
        exit(1)
    // trailing comma
    let ys = [
        10,
        20,
    ]
    if len(ys) != 2
        print("FAIL list-trailing")
        exit(1)
    // multi-line dict
    let d = {
        "a": 1,
        "b": 2,
        "c": 3
    }
    if d["a"] != 1 or d["c"] != 3
        print("FAIL dict")
        exit(1)
    // dict trailing comma
    let d2 = {
        "x": 10,
        "y": 20,
    }
    if d2["x"] != 10 or d2["y"] != 20
        print("FAIL dict-trailing")
        exit(1)
    // single-line still works (both)
    let zs = [1, 2, 3]
    let sd = {"k": 9}
    if len(zs) != 3 or sd["k"] != 9
        print("FAIL singleline")
        exit(1)
    // empty multi-line
    let es = [
    ]
    if len(es) != 0
        print("FAIL empty-list")
        exit(1)
    print("PASS _l12_multiline_test")
