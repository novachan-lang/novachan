// functional: JSON-RPC 2.0 codec round-trip (request/notification/success/error)
import forge_jsonrpc

fn main()
    let req = jsonrpc_request("sum", [1, 2], 7)
    let m = jsonrpc_parse(req)
    if jsonrpc_method(m) != "sum"
        print("FAIL method = " + jsonrpc_method(m))
        exit(1)
    if jsonrpc_id(m) != 7
        print("FAIL id = " + str(jsonrpc_id(m)))
        exit(1)
    if jsonrpc_is_notification(m) != false
        print("FAIL req is notif")
        exit(1)
    let notif = jsonrpc_parse(jsonrpc_notification("ping", []))
    if jsonrpc_is_notification(notif) != true
        print("FAIL notif")
        exit(1)
    let succ = jsonrpc_parse(jsonrpc_success(7, 3))
    if jsonrpc_result(succ) != 3
        print("FAIL result = " + str(jsonrpc_result(succ)))
        exit(1)
    let er = jsonrpc_parse(jsonrpc_error(7, jsonrpc_method_not_found(), "no"))
    if jsonrpc_has_error(er) != true
        print("FAIL has_error")
        exit(1)
    print("PASS forge_jsonrpc")
