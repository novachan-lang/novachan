import forge_dns_round_robin

fn main()
    let r = rr_new()
    r = rr_add_record(r, "api.example.com", "10.0.0.1")
    r = rr_add_record(r, "api.example.com", "10.0.0.2")
    r = rr_add_record(r, "api.example.com", "10.0.0.3")
    r = rr_add_record(r, "db.example.com", "10.1.0.1")
    assert(rr_record_count(r) == 4, "4 records")

    let r1 = rr_resolve(r, "api.example.com")
    assert(is_ok(r1), "resolve ok")
    assert(unwrap(r1) == "10.0.0.1", "first IP")

    let r2 = rr_resolve(r, "api.example.com")
    assert(unwrap(r2) == "10.0.0.2", "second IP")

    let r3 = rr_resolve(r, "api.example.com")
    assert(unwrap(r3) == "10.0.0.3", "third IP")

    let r4 = rr_resolve(r, "api.example.com")
    assert(unwrap(r4) == "10.0.0.1", "wraps around")

    let r5 = rr_resolve(r, "db.example.com")
    assert(unwrap(r5) == "10.1.0.1", "db IP")

    let bad = rr_resolve(r, "nope.com")
    assert(is_err(bad), "not found")

    assert(rr_total_queries(r) == 6, "6 queries")

    print("DNS-ROUND-ROBIN KAT PASS")
