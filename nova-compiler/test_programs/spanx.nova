// spanx -- non-owning contiguous views (span) + 2D views (mdspan). A Span is a
// (data, offset, length) window over an existing list: slicing returns a sub-view that
// SHARES the underlying storage (zero copy), so large buffers are passed and sub-ranged
// without allocation. mdspan is a row-major 2D view over a flat list (matrices without
// nested allocation). Accessors are bounds-checked (never UB; OOB read -> 0).

type Span
    data: list
    off: int
    cap: int

fn span(data)
    return Span(data, 0, len(data))
fn span_of(data, off, length)
    return Span(data, off, length)
fn span_len(s)
    return s.cap
fn span_get(s, i)
    if i < 0 or i >= s.cap
        return 0
    return s.data[s.off + i]
fn span_set(s, i, v)                 // writes through to the shared storage
    if i < 0 or i >= s.cap
        return -1
    s.data[s.off + i] = v
    return 0
fn span_slice(s, a, b)               // sub-view [a, b) over the SAME storage (no copy)
    let lo = a
    if lo < 0
        lo = 0
    let hi = b
    if hi > s.cap
        hi = s.cap
    return Span(s.data, s.off + lo, hi - lo)
fn span_to_list(s)                   // materialize an owned copy only when needed
    let out = []
    let i = 0
    while i < s.cap
        push(out, s.data[s.off + i])
        i = i + 1
    return out
fn span_sum(s)
    let t = 0
    let i = 0
    while i < s.cap
        t = t + span_get(s, i)
        i = i + 1
    return t

// ── 2D row-major view over a flat list ───────────────────────────────────────
type MdSpan
    data: list
    rows: int
    cols: int

fn mdspan(data, rows, cols)
    return MdSpan(data, rows, cols)
fn md_get(m, r, c)
    if r < 0 or r >= m.rows or c < 0 or c >= m.cols
        return 0
    return m.data[r * m.cols + c]
fn md_set(m, r, c, v)
    if r < 0 or r >= m.rows or c < 0 or c >= m.cols
        return -1
    m.data[r * m.cols + c] = v
    return 0
fn md_row(m, r)                      // a Span view of row r (no copy)
    return Span(m.data, r * m.cols, m.cols)

fn main()
    let data = [10, 20, 30, 40, 50]
    let s = span(data)
    assert_eq(span_len(s), 5)
    assert_eq(span_get(s, 0), 10)
    assert_eq(span_get(s, 4), 50)
    assert_eq(span_get(s, 9), 0)         // OOB -> safe 0
    assert_eq(span_sum(s), 150)

    // zero-copy sub-view
    let sub = span_slice(s, 1, 4)        // [20, 30, 40]
    assert_eq(span_len(sub), 3)
    assert_eq(span_get(sub, 0), 20)
    assert_eq(span_sum(sub), 90)

    // NON-OWNING: mutate the underlying list -> the view sees it (shared storage)
    data[2] = 99
    assert_eq(span_get(sub, 1), 99)
    // write through the view -> reflected in the underlying list
    span_set(sub, 0, 21)
    assert_eq(data[1], 21)

    // materialize when an owned copy is genuinely needed
    assert_eq(span_to_list(span_slice(s, 0, 3)), [10, 21, 99])

    // 2D view over a flat 2x3 matrix
    let flat = [1, 2, 3, 4, 5, 6]
    let m = mdspan(flat, 2, 3)
    assert_eq(md_get(m, 0, 0), 1)
    assert_eq(md_get(m, 1, 2), 6)
    md_set(m, 0, 1, 20)
    assert_eq(md_get(m, 0, 1), 20)
    assert_eq(flat[1], 20)               // view writes through to the flat list
    let row1 = md_row(m, 1)              // span of [4, 5, 6]
    assert_eq(span_sum(row1), 15)
    assert_eq(span_get(row1, 0), 4)

    print("spanx passed")
