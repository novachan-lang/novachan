fn square(x)
    x * x

fn circleArea(radius)
    3.14159265 * square(radius)

fn toCelsius(fahrenheit)
    (fahrenheit - 32.0) * 5.0 / 9.0

fn absFloat(x)
    if x < 0.0
        -x
    else
        x

fn sqrtApprox(x)
    g = x / 2.0
    g = (g + x / g) / 2.0
    g = (g + x / g) / 2.0
    g = (g + x / g) / 2.0
    g = (g + x / g) / 2.0
    g

print(3.14)
print(1.5 + 2.5)
print(10.0 - 3.5)
print(2.5 * 4.0)
print(10.0 / 3.0)
print(circleArea(5.0))
print(toCelsius(212.0))
print(toCelsius(32.0))
print(absFloat(-42.5))
print(sqrtApprox(2.0))
