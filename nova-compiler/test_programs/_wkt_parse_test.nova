// KAT: std/data/wkt_parse
import std/data/wkt_parse

fn approx(a, b, tol) -> int
    wkt_approx(a, b, tol)

fn ck_i(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck_s(label, got, want)
    if got != want
        print("FAIL " + label + ": got=[" + got + "] want=[" + want + "]")
        exit(1)

fn ck_f(label, got, want)
    if approx(got, want, 0.0001) == 0
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ── Test 1: POINT ────────────────────────────────────────────────────────────
let pt1 = wkt_parse("POINT(1 2)")
ck_s("point_type", pt1["type"], "POINT")
let ptc1 = pt1["coords"]
ck_i("point_ncoords", len(ptc1), 1)
let p10 = ptc1[0]
ck_f("point_x", p10[0], 1.0)
ck_f("point_y", p10[1], 2.0)

// ── Test 2: POINT with floats ────────────────────────────────────────────────
let pt2 = wkt_parse("POINT(-73.9857 40.7484)")
ck_s("point_f_type", pt2["type"], "POINT")
let ptc2 = pt2["coords"]
ck_i("point_f_len", len(ptc2), 1)
let p20 = ptc2[0]
ck_f("point_f_x", p20[0], -73.9857)
ck_f("point_f_y", p20[1], 40.7484)

// ── Test 3: LINESTRING ───────────────────────────────────────────────────────
let ls1 = wkt_parse("LINESTRING(1 2, 3 4)")
ck_s("ls_type", ls1["type"], "LINESTRING")
let lsc1 = ls1["coords"]
ck_i("ls_len", len(lsc1), 2)
let l10 = lsc1[0]
let l11 = lsc1[1]
ck_f("ls_p0_x", l10[0], 1.0)
ck_f("ls_p0_y", l10[1], 2.0)
ck_f("ls_p1_x", l11[0], 3.0)
ck_f("ls_p1_y", l11[1], 4.0)

// ── Test 4: LINESTRING three points ─────────────────────────────────────────
let ls2 = wkt_parse("LINESTRING(0 0, 1 1, 2 2)")
ck_s("ls3_type", ls2["type"], "LINESTRING")
let lsc2 = ls2["coords"]
ck_i("ls3_len", len(lsc2), 3)
let l20 = lsc2[2]
ck_f("ls3_p2_x", l20[0], 2.0)
ck_f("ls3_p2_y", l20[1], 2.0)

// ── Test 5: POLYGON outer ring ───────────────────────────────────────────────
let pg1 = wkt_parse("POLYGON((0 0, 1 0, 1 1, 0 1, 0 0))")
ck_s("poly_type", pg1["type"], "POLYGON")
let pgc1 = pg1["coords"]
ck_i("poly_len", len(pgc1), 5)
let pg10 = pgc1[0]
let pg12 = pgc1[2]
ck_f("poly_p0_x", pg10[0], 0.0)
ck_f("poly_p0_y", pg10[1], 0.0)
ck_f("poly_p2_x", pg12[0], 1.0)
ck_f("poly_p2_y", pg12[1], 1.0)

// ── Test 6: case-insensitivity ───────────────────────────────────────────────
let pt3 = wkt_parse("point(5 6)")
ck_s("lower_type", pt3["type"], "POINT")
let ptc3 = pt3["coords"]
ck_i("lower_len", len(ptc3), 1)
let p30 = ptc3[0]
ck_f("lower_x", p30[0], 5.0)
ck_f("lower_y", p30[1], 6.0)

// ── Test 7: UNKNOWN returns empty ─────────────────────────────────────────────
let unk = wkt_parse("CIRCLE(0 0, 5)")
ck_s("unk_type", unk["type"], "UNKNOWN")
let unkc = unk["coords"]
ck_i("unk_len", len(unkc), 0)

// ── Test 8: POINT extra whitespace ───────────────────────────────────────────
let pt4 = wkt_parse("  POINT( 10.0  20.5 )  ")
ck_s("ws_type", pt4["type"], "POINT")
let ptc4 = pt4["coords"]
ck_i("ws_len", len(ptc4), 1)
let p40 = ptc4[0]
ck_f("ws_x", p40[0], 10.0)
ck_f("ws_y", p40[1], 20.5)

// ── Test 9: LINESTRING negative coords ───────────────────────────────────────
let ls3 = wkt_parse("LINESTRING(-1.5 -2.5, 3.5 4.5)")
ck_s("ls_neg_type", ls3["type"], "LINESTRING")
let lsc3 = ls3["coords"]
ck_i("ls_neg_len", len(lsc3), 2)
let ln0 = lsc3[0]
let ln1 = lsc3[1]
ck_f("ls_neg_p0_x", ln0[0], -1.5)
ck_f("ls_neg_p0_y", ln0[1], -2.5)
ck_f("ls_neg_p1_x", ln1[0], 3.5)
ck_f("ls_neg_p1_y", ln1[1], 4.5)

print("PASS _wkt_parse_test")
