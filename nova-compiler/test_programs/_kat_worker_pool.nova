import forge_worker_pool

fn main()
    let w = wp_new(3)
    w = wp_add_worker(w, "w1")
    w = wp_add_worker(w, "w2")
    w = wp_add_worker(w, "w3")
    assert(wp_active_count(w) == 3, "3 active")

    w = wp_add_worker(w, "w4")
    assert(wp_active_count(w) == 3, "max 3")

    let r1 = wp_assign(w)
    w = r1["w"]
    assert(r1["ok"] == 1, "assigned 1")
    let assigned1 = r1["worker"]

    let r2 = wp_assign(w)
    w = r2["w"]
    assert(r2["ok"] == 1, "assigned 2")

    let r3 = wp_assign(w)
    w = r3["w"]
    assert(r3["ok"] == 1, "assigned 3")
    assert(wp_total_assigned(w) == 3, "3 total assigned")

    w = wp_release(w, assigned1)

    w = wp_stop_worker(w, "w3")
    assert(wp_active_count(w) == 2, "2 active after stop")

    let r4 = wp_assign(w)
    w = r4["w"]
    assert(r4["ok"] == 1, "can still assign")

    print("WORKER-POOL KAT PASS")
