import forge_quota_manager

fn main()
    let q = qm_new()
    q = qm_set_quota(q, "api", 100)

    let r1 = qm_consume(q, "api", 30)
    assert(is_ok(r1), "consume 30 ok")
    q = unwrap(r1)

    let r2 = qm_consume(q, "api", 50)
    assert(is_ok(r2), "consume 50 ok")
    q = unwrap(r2)

    let rem = qm_remaining(q, "api")
    assert(is_ok(rem), "remaining ok")
    assert(unwrap(rem) == 20, "20 remaining")

    let r3 = qm_consume(q, "api", 30)
    assert(is_err(r3), "exceed quota")
    assert(qm_total_granted(q) == 2, "2 granted")
    assert(qm_total_denied(q) == 1, "1 denied")

    let use1 = qm_usage(q, "api")
    assert(is_ok(use1), "usage ok")
    assert(unwrap(use1) == 80, "80 used")

    let r4 = qm_reset(q, "api")
    assert(is_ok(r4), "reset ok")
    q = unwrap(r4)
    let use2 = qm_usage(q, "api")
    assert(unwrap(use2) == 0, "0 after reset")

    let bad = qm_consume(q, "nope", 1)
    assert(is_err(bad), "no quota set")

    print("QUOTA-MANAGER KAT PASS")
