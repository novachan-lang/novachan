// KAT for std/util/latch
import std/util/latch

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + got + " expected " + expected)
        exit(1)

fn main()
    // --- KAT 1: initial count ---
    let l = lt_new(3)
    cki("initial_count", lt_count(l), 3)

    // --- KAT 2: not open at start ---
    let open0 = lt_is_open(l)
    cki("not_open_at_start", open0, 0)

    // --- KAT 3: count after one count_down ---
    lt_count_down(l)
    cki("count_after_1_down", lt_count(l), 2)

    // --- KAT 4: open after two more count_downs ---
    lt_count_down(l)
    lt_count_down(l)
    let open1 = lt_is_open(l)
    cki("open_after_reaching_zero", open1, 1)

    // --- KAT 5: extra count_down does not go negative ---
    lt_count_down(l)
    cki("floor_at_zero", lt_count(l), 0)

    // --- KAT 6: reset ---
    lt_reset(l, 5)
    cki("count_after_reset", lt_count(l), 5)

    // --- KAT 7: not open after reset ---
    let open2 = lt_is_open(l)
    cki("not_open_after_reset", open2, 0)

    // --- KAT 8: count_down_n by 3 ---
    lt_count_down_n(l, 3)
    cki("count_after_down_n_3", lt_count(l), 2)

    // --- KAT 9: count_down_n by more than remaining ---
    lt_count_down_n(l, 10)
    cki("floor_after_down_n_excess", lt_count(l), 0)

    // --- KAT 10: is_open after down_n exhausted ---
    let open3 = lt_is_open(l)
    cki("open_after_down_n", open3, 1)

    // --- KAT 11: reset to 0 opens immediately ---
    lt_reset(l, 0)
    cki("reset_zero_count", lt_count(l), 0)
    let open4 = lt_is_open(l)
    cki("reset_zero_open", open4, 1)

    // --- KAT 12: independent latches don't interfere ---
    let a = lt_new(2)
    let b = lt_new(7)
    lt_count_down(a)
    cki("a_independent", lt_count(a), 1)
    cki("b_independent", lt_count(b), 7)

    print("_latch_test passed")
