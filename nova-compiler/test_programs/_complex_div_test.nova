import std/complex/complex_div

// cki — assert integer equality
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _complex_div_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb — assert boolean equality
fn ckb(label: string, got: bool, want: bool)
    if got != want
        print("FAIL _complex_div_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// cks — assert string equality
fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL _complex_div_test " + label + ": got=" + got + " want=" + want)
        exit(1)

// ckl — assert 3-element result list [re_num, im_num, den]
fn ckl(label: string, got: list, wr: int, wi: int, wd: int)
    if got[0] != wr or got[1] != wi or got[2] != wd
        print("FAIL _complex_div_test " + label + ": got=[" + str(got[0]) + "," + str(got[1]) + "," + str(got[2]) + "] want=[" + str(wr) + "," + str(wi) + "," + str(wd) + "]")
        exit(1)

// helper: build complex [re, im]
fn mk(re: int, im: int) -> list
    let c = []
    push(c, re)
    push(c, im)
    c

// --- cxd_div KAT vectors from spec ---

// (1+0i)/(0+1i): conj(b)=[0,-1]; a*conj(b)=[0,-1]; |b|^2=1 -> [0,-1,1]
let d1 = cxd_div(mk(1, 0), mk(0, 1))
ckl("div_1_0__by__0_1", d1, 0, 0 - 1, 1)

// (3+4i)/(1+2i): conj(b)=[1,-2]; a*conj(b)=[3+8, 4-6]=[11,-2]; |b|^2=5 -> [11,-2,5]
let d2 = cxd_div(mk(3, 4), mk(1, 2))
ckl("div_3_4__by__1_2", d2, 11, 0 - 2, 5)

// (2+0i)/(1+1i): conj(b)=[1,-1]; a*conj(b)=[2,-2]; |b|^2=2 -> [2,-2,2]->gcd=2->[1,-1,1]
let d3 = cxd_div(mk(2, 0), mk(1, 1))
ckl("div_2_0__by__1_1", d3, 1, 0 - 1, 1)

// (6+0i)/(0+2i): conj(b)=[0,-2]; a*conj(b)=[0,-12]; |b|^2=4 -> [0,-12,4]->gcd=4->[0,-3,1]
let d4 = cxd_div(mk(6, 0), mk(0, 2))
ckl("div_6_0__by__0_2", d4, 0, 0 - 3, 1)

// (4+0i)/(2+0i): conj(b)=[2,0]; a*conj(b)=[8,0]; |b|^2=4 -> [8,0,4]->gcd=4->[2,0,1]
let d5 = cxd_div(mk(4, 0), mk(2, 0))
ckl("div_4_0__by__2_0", d5, 2, 0, 1)

// extra: divide by zero -> [0,0,0]
let d6 = cxd_div(mk(3, 4), mk(0, 0))
ckl("div_by_zero", d6, 0, 0, 0)

// extra: i/i = 1 -> [1,0,1]
let d7 = cxd_div(mk(0, 1), mk(0, 1))
ckl("div_i_by_i", d7, 1, 0, 1)

// extra: (2+2i)/(1+1i) = 2 -> [2,0,1]
// conj([1,1])=[1,-1]; (2+2i)(1-i)=[2+2+2i-2i]=[4,0]; |b|^2=2 -> [4,0,2]->gcd=2->[2,0,1]
let d8 = cxd_div(mk(2, 2), mk(1, 1))
ckl("div_2_2__by__1_1", d8, 2, 0, 1)

// extra: (5+5i)/(5+5i) = 1 -> [1,0,1]
// conj==[5,-5]; (5+5i)(5-5i)=[25+25,0]=[50,0]; |b|^2=50 -> [50,0,50]->gcd=50->[1,0,1]
let d9 = cxd_div(mk(5, 5), mk(5, 5))
ckl("div_self", d9, 1, 0, 1)

// --- cxd_reciprocal ---

// 1/(1+1i): conj=[1,-1]; 1*[1,-1]=[1,-1]; |b|^2=2 -> [1,-1,2]
let r1 = cxd_reciprocal(mk(1, 1))
ckl("recip_1_1", r1, 1, 0 - 1, 2)

// 1/(2+0i) = [1,0,2]
let r2 = cxd_reciprocal(mk(2, 0))
ckl("recip_real_2", r2, 1, 0, 2)

// 1/(0+1i) = [0,-1,1]  (i.e. 1/i = -i)
let r3 = cxd_reciprocal(mk(0, 1))
ckl("recip_i", r3, 0, 0 - 1, 1)

// 1/(0+0i) -> [0,0,0] (division by zero)
let r4 = cxd_reciprocal(mk(0, 0))
ckl("recip_zero", r4, 0, 0, 0)

// 1/(3+4i): conj=[3,-4]; 1*[3,-4]=[3,-4]; |b|^2=25 -> [3,-4,25]; gcd(3,4,25)=1 -> [3,-4,25]
let r5 = cxd_reciprocal(mk(3, 4))
ckl("recip_3_4", r5, 3, 0 - 4, 25)

// 1/(-1+0i) = [-1,0,1]
let r6 = cxd_reciprocal(mk(0 - 1, 0))
ckl("recip_neg1", r6, 0 - 1, 0, 1)

print("PASS _complex_div_test")
