import forge_consensus_log

fn main()
    let c = cl_new(3)
    assert(cl_proposal_count(c) == 0, "0 proposals initially")
    assert(cl_decided_count(c) == 0, "0 decided initially")

    let p1 = cl_propose(c, "set-leader-A")
    assert(p1 == 0, "first proposal id is 0")
    assert(cl_proposal_count(c) == 1, "1 proposal")

    let v1 = cl_vote(c, p1, "n1", 1)
    assert(is_ok(v1), "vote 1 ok")
    let vc1 = cl_vote_count(c, p1)
    assert(is_ok(vc1), "vote count ok")
    assert(unwrap(vc1) == 1, "1 vote cast")

    let dec0 = cl_is_decided(c, p1)
    assert(is_ok(dec0), "is_decided ok")
    assert(unwrap(dec0) == 0, "not decided at 1 vote")

    let v2 = cl_vote(c, p1, "n2", 1)
    assert(is_ok(v2), "vote 2 ok")
    let v3 = cl_vote(c, p1, "n3", 1)
    assert(is_ok(v3), "vote 3 ok")

    let dec1 = cl_is_decided(c, p1)
    assert(is_ok(dec1), "is_decided ok 2")
    assert(unwrap(dec1) == 1, "decided at quorum")
    assert(cl_decided_count(c) == 1, "1 decided")

    let decision1 = cl_decision(c, p1)
    assert(is_ok(decision1), "decision ok")
    assert(unwrap(decision1) == "accepted", "accepted")

    // voting after decided should fail
    let v_late = cl_vote(c, p1, "n4", 1)
    assert(is_err(v_late), "vote after decided fails")

    // double vote by same voter should fail
    let p2 = cl_propose(c, "set-leader-B")
    assert(p2 == 1, "second proposal id is 1")
    let v4 = cl_vote(c, p2, "n1", 0)
    assert(is_ok(v4), "p2 vote 1 ok")
    let v4_dup = cl_vote(c, p2, "n1", 1)
    assert(is_err(v4_dup), "duplicate voter fails")

    let v5 = cl_vote(c, p2, "n2", 0)
    assert(is_ok(v5), "p2 vote 2 ok")
    let v6 = cl_vote(c, p2, "n3", 0)
    assert(is_ok(v6), "p2 vote 3 ok")

    let decision2 = cl_decision(c, p2)
    assert(is_ok(decision2), "p2 decision ok")
    assert(unwrap(decision2) == "rejected", "rejected")
    assert(cl_decided_count(c) == 2, "2 decided")

    let bad_vote = cl_vote(c, 99, "n1", 1)
    assert(is_err(bad_vote), "vote on unknown proposal fails")

    let bad_decision = cl_decision(c, 99)
    assert(is_err(bad_decision), "decision on unknown proposal fails")

    print("CONSENSUS-LOG KAT PASS")
