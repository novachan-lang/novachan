// Capstone: a real data pipeline composing the high-level std/core modules
// (seq/dict/list/num/str/sort/result + closures + Result/match). End-to-end proof
// that reusable high-level NOVA composes — the payoff of the inference fixes.
import std/core/seq
import std/core/dict
import std/core/list
import std/core/num
import std/core/str
import std/core/sort

fn grade_of(score: int) -> string
    if score >= 90
        return "A"
    if score >= 80
        return "B"
    if score >= 70
        return "C"
    return "F"

fn main() -> int
    let fails = 0
    let scores = [85, 92, 78, 95, 88, 70, 92, 60]

    // fold -> total + average
    let total = seq_fold(scores, 0, fn(a, x) a + x)
    let avg = total / len(scores)
    // filter -> passing (>= 70) via the builtin .filter method
    let passing = scores.filter(fn(x) x >= 70)
    // count -> number of A's
    let a_count = seq_count(scores, fn(x) x >= 90)
    // reduce -> highest, as Result (handles empty), unwrapped via match
    let hi = 0
    match seq_reduce(scores, fn(a, x) int_max(a, x))
        Ok(v) =>
            hi = v
        Err(e) =>
            hi = 0 - 1
    // sort + unique
    let sorted = sort_ints(scores)
    let uniq = list_unique(scores)
    // dict -> grade distribution (dict_get_or closes the missing-key footgun)
    let dist = {}
    for s in scores
        let g = grade_of(s)
        dist[g] = dict_get_or(dist, g, 0) + 1
    // str -> a padded report line
    let report = str_pad_right("avg", 8, " ") + str(avg)
    print(report)
    print("distribution A=" + str(dict_get_or(dist, "A", 0)) + " B=" + str(dict_get_or(dist, "B", 0)) + " C=" + str(dict_get_or(dist, "C", 0)) + " F=" + str(dict_get_or(dist, "F", 0)))

    // assertions
    if avg != 82
        print("FAIL avg=" + str(avg))
        fails = fails + 1
    if len(passing) != 7
        print("FAIL passing=" + str(len(passing)))
        fails = fails + 1
    if a_count != 3
        print("FAIL a_count=" + str(a_count))
        fails = fails + 1
    if hi != 95
        print("FAIL hi=" + str(hi))
        fails = fails + 1
    if sorted[0] != 60
        print("FAIL sorted min")
        fails = fails + 1
    if sorted[7] != 95
        print("FAIL sorted max")
        fails = fails + 1
    if len(uniq) != 7
        print("FAIL uniq=" + str(len(uniq)))
        fails = fails + 1
    if dict_get_or(dist, "A", 0) != 3
        print("FAIL dist A")
        fails = fails + 1
    if dict_get_or(dist, "B", 0) != 2
        print("FAIL dist B")
        fails = fails + 1
    if dict_get_or(dist, "F", 0) != 1
        print("FAIL dist F")
        fails = fails + 1
    if fails == 0
        print("PASS _kat_stdcore_demo")
    else
        print("FAILED _kat_stdcore_demo")
    return 0
