// NOVA Prism v0.1 demo: terminal UI primitives (ANSI escapes, box,
// table). The output isn't observed visually here; we just verify the
// strings contain the right structure.
import prism

fn main()
    // 1. ANSI escape sequences for clear/move/color
    let c = prism.clear()
    if find(c, "[2J") < 0 or find(c, "[H") < 0
        print("FAIL clear escape: " + c)
        exit(1)
    let m = prism.move(10, 5)
    if find(m, "[5;10H") < 0
        print("FAIL move escape: " + m)
        exit(1)
    let fg = prism.color_fg(255, 128, 0)
    if find(fg, "[38;2;255;128;0m") < 0
        print("FAIL color_fg: " + fg)
        exit(1)

    // 2. Box rendering: 5x3 grid of ASCII art
    let b = prism.box(5, 3)
    if find(b, "+---+\n|   |\n+---+\n") < 0
        print("FAIL box: " + b)
        exit(1)

    // 3. Table render with header + 2 rows
    let tbl = prism.table(["name", "value"], [["alice", "42"], ["bob", "100"]])
    if find(tbl, "name") < 0 or find(tbl, "value") < 0
        print("FAIL table headers: " + tbl)
        exit(1)
    if find(tbl, "alice") < 0 or find(tbl, "bob") < 0
        print("FAIL table rows: " + tbl)
        exit(1)

    print("PRISM v0.1 demo passed: ANSI clear/move/color escapes + box + table render — terminal UI primitives ready")
