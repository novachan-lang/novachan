// Phase 7.5: Operator overloading test
// Tests that struct types can define add/sub/mul/div/eq/lt/neg methods
// and binary operators dispatch to them automatically.

type Vec2
    x: float
    y: float

fn Vec2.add(other: Vec2) -> Vec2
    Vec2(self.x + other.x, self.y + other.y)

fn Vec2.sub(other: Vec2) -> Vec2
    Vec2(self.x - other.x, self.y - other.y)

fn Vec2.mul(other: Vec2) -> Vec2
    Vec2(self.x * other.x, self.y * other.y)

fn Vec2.neg() -> Vec2
    Vec2(0.0 - self.x, 0.0 - self.y)

fn Vec2.eq(other: Vec2) -> bool
    self.x == other.x and self.y == other.y

fn Vec2.show() -> string
    "Vec2(" + str(self.x) + ", " + str(self.y) + ")"

// Test basic operator overloading
let a = Vec2(1.0, 2.0)
let b = Vec2(3.0, 4.0)

let c = a + b
assert(c.x == 4.0, "add x")
assert(c.y == 6.0, "add y")

let d = b - a
assert(d.x == 2.0, "sub x")
assert(d.y == 2.0, "sub y")

let e = a * b
assert(e.x == 3.0, "mul x")
assert(e.y == 8.0, "mul y")

// Test unary negation
let f = -a
assert(f.x == -1.0, "neg x")
assert(f.y == -2.0, "neg y")

// Test equality
assert(a == Vec2(1.0, 2.0), "eq true")

// Test chained operations
let g = a + b + Vec2(10.0, 10.0)
assert(g.x == 14.0, "chain x")
assert(g.y == 16.0, "chain y")

// Test that primitive ops still work
assert(1 + 2 == 3, "int add")
assert(10 - 3 == 7, "int sub")
assert(3 * 4 == 12, "int mul")
assert(10 / 2 == 5, "int div")
assert(1.5 + 2.5 == 4.0, "float add")

// Test with a different struct type
type Complex
    re: float
    im: float

fn Complex.add(other: Complex) -> Complex
    Complex(self.re + other.re, self.im + other.im)

fn Complex.mul(other: Complex) -> Complex
    Complex(self.re * other.re - self.im * other.im, self.re * other.im + self.im * other.re)

fn Complex.show() -> string
    str(self.re) + "+" + str(self.im) + "i"

let c1 = Complex(1.0, 2.0)
let c2 = Complex(3.0, 4.0)

let c3 = c1 + c2
assert(c3.re == 4.0, "complex add re")
assert(c3.im == 6.0, "complex add im")

let c4 = c1 * c2
assert(c4.re == -5.0, "complex mul re")
assert(c4.im == 10.0, "complex mul im")

print("PHASE 7.5 OPERATOR OVERLOADING TEST PASSED")
