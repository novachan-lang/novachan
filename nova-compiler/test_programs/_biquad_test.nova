// KAT test for std/audio/biquad.nova
// Tests:
//   1. biquad_lowpass returns 5 finite coefficients.
//   2. DC gain of the lowpass == 1.0 (b0+b1+b2)/(1+a1+a2).
//   3. Feeding constant 1.0 through lowpass converges toward 1.0.
//   4. Zero input -> zero output.
//   5. Coefficients are deterministic.

import std/audio/biquad

fn approx(a: float, b: float, tol: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    let result = d < tol
    result

fn ckf(label: string, got: float, want: float, tol: float)
    if approx(got, want, tol) != true
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// Run the biquad filter for n steps with constant input dc.
// Returns the final output sample.
fn run_dc(coeffs: list, dc: float, n: int) -> float
    let x1 = 0.0
    let x2 = 0.0
    let y1 = 0.0
    let y2 = 0.0
    let b0 = coeffs[0] * 1.0
    let b1 = coeffs[1] * 1.0
    let b2 = coeffs[2] * 1.0
    let a1 = coeffs[3] * 1.0
    let a2 = coeffs[4] * 1.0
    let y = 0.0
    let i = 0
    while i < n
        let t0 = b0 * dc
        let t1 = b1 * x1
        let t2 = b2 * x2
        let t3 = a1 * y1
        let t4 = a2 * y2
        y = t0 + t1 + t2 - t3 - t4
        x2 = x1
        x1 = dc
        y2 = y1
        y1 = y
        i = i + 1
    y

fn main()
    // Build a lowpass at 1000 Hz, Q=0.707 (Butterworth), sr=44100
    let coeffs = biquad_lowpass(1000.0, 0.7071, 44100.0)

    // KAT 1: coeffs has exactly 5 elements
    let nc = len(coeffs)
    if nc != 5
        print("FAIL biquad_lowpass len: got=" + str(nc) + " want=5")
        exit(1)

    // KAT 2: each coefficient is a real finite number (not 0 everywhere)
    let b0 = coeffs[0] * 1.0
    let b1 = coeffs[1] * 1.0
    let b2 = coeffs[2] * 1.0
    let a1 = coeffs[3] * 1.0
    let a2 = coeffs[4] * 1.0

    // b0, b1, b2 should be positive (lowpass formula gives positive numerators)
    if b0 < 0.0
        print("FAIL b0 negative: " + str(b0))
        exit(1)
    if b1 < 0.0
        print("FAIL b1 negative: " + str(b1))
        exit(1)
    if b2 < 0.0
        print("FAIL b2 negative: " + str(b2))
        exit(1)

    // KAT 3: DC gain = (b0+b1+b2)/(1+a1+a2) ~ 1.0
    let num = b0 + b1 + b2
    let denom = 1.0 + a1 + a2
    // denom should be positive for stable LP; take abs for safety
    let abs_denom = 0.0
    if denom < 0.0
        abs_denom = 0.0 - denom
    else
        abs_denom = denom
    let abs_num = 0.0
    if num < 0.0
        abs_num = 0.0 - num
    else
        abs_num = num
    let dc_gain = abs_num / abs_denom
    ckf("dc_gain", dc_gain, 1.0, 0.01)

    // KAT 4: Apply 200 iterations of constant 1.0 -> converges toward 1.0
    let y200 = run_dc(coeffs, 1.0, 200)
    ckf("dc_converge", y200, 1.0, 0.001)

    // KAT 5: Zero input -> zero output (all zeros)
    let y0 = run_dc(coeffs, 0.0, 10)
    ckf("zero_in_zero_out", y0, 0.0, 0.0001)

    // KAT 6: Apply one sample via biquad_apply, verify output list has 2 elements
    let state = []
    push(state, 0.0)
    push(state, 0.0)
    push(state, 0.0)
    push(state, 0.0)
    let res = biquad_apply(coeffs, 1.0, state)
    let rlen = len(res)
    if rlen != 2
        print("FAIL biquad_apply result len: got=" + str(rlen) + " want=2")
        exit(1)

    // KAT 7: first element of result is the output sample (float, bounded)
    let y_first = res[0] * 1.0
    // First sample with 1.0 DC input should be b0 (initial state all zeros)
    ckf("biquad_apply_first_out", y_first, b0, 0.0001)

    // KAT 8: state after apply has 4 elements
    let new_state = res[1]
    let ns_len = len(new_state)
    if ns_len != 4
        print("FAIL new_state len: got=" + str(ns_len) + " want=4")
        exit(1)

    // KAT 9: Coefficients are deterministic (second call same as first)
    let coeffs2 = biquad_lowpass(1000.0, 0.7071, 44100.0)
    let b0b = coeffs2[0] * 1.0
    let b1b = coeffs2[1] * 1.0
    ckf("deterministic_b0", b0b, b0, 0.000001)
    ckf("deterministic_b1", b1b, b1, 0.000001)

    print("PASS _biquad_test")
