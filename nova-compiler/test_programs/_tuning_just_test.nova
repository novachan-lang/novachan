import std/music/tuning_just

fn main()
    // ── just_ratio ────────────────────────────────────────────────────────────

    // P5 = 3/2
    let r_p5 = just_ratio("P5")
    if r_p5[0] != 3 or r_p5[1] != 2
        print("FAIL tuning_just just_ratio(P5): got [" + str(r_p5[0]) + "," + str(r_p5[1]) + "] want [3,2]")
        exit(1)

    // M3 = 5/4
    let r_m3 = just_ratio("M3")
    if r_m3[0] != 5 or r_m3[1] != 4
        print("FAIL tuning_just just_ratio(M3): got [" + str(r_m3[0]) + "," + str(r_m3[1]) + "] want [5,4]")
        exit(1)

    // P8 = 2/1
    let r_p8 = just_ratio("P8")
    if r_p8[0] != 2 or r_p8[1] != 1
        print("FAIL tuning_just just_ratio(P8): got [" + str(r_p8[0]) + "," + str(r_p8[1]) + "] want [2,1]")
        exit(1)

    // P1 = 1/1
    let r_p1 = just_ratio("P1")
    if r_p1[0] != 1 or r_p1[1] != 1
        print("FAIL tuning_just just_ratio(P1): got [" + str(r_p1[0]) + "," + str(r_p1[1]) + "] want [1,1]")
        exit(1)

    // P4 = 4/3
    let r_p4 = just_ratio("P4")
    if r_p4[0] != 4 or r_p4[1] != 3
        print("FAIL tuning_just just_ratio(P4): got [" + str(r_p4[0]) + "," + str(r_p4[1]) + "] want [4,3]")
        exit(1)

    // TT = 45/32
    let r_tt = just_ratio("TT")
    if r_tt[0] != 45 or r_tt[1] != 32
        print("FAIL tuning_just just_ratio(TT): got [" + str(r_tt[0]) + "," + str(r_tt[1]) + "] want [45,32]")
        exit(1)

    // m2 = 16/15
    let r_m2 = just_ratio("m2")
    if r_m2[0] != 16 or r_m2[1] != 15
        print("FAIL tuning_just just_ratio(m2): got [" + str(r_m2[0]) + "," + str(r_m2[1]) + "] want [16,15]")
        exit(1)

    // M2 = 9/8
    let r_M2 = just_ratio("M2")
    if r_M2[0] != 9 or r_M2[1] != 8
        print("FAIL tuning_just just_ratio(M2): got [" + str(r_M2[0]) + "," + str(r_M2[1]) + "] want [9,8]")
        exit(1)

    // m3 = 6/5
    let r_m3b = just_ratio("m3")
    if r_m3b[0] != 6 or r_m3b[1] != 5
        print("FAIL tuning_just just_ratio(m3): got [" + str(r_m3b[0]) + "," + str(r_m3b[1]) + "] want [6,5]")
        exit(1)

    // m6 = 8/5
    let r_m6 = just_ratio("m6")
    if r_m6[0] != 8 or r_m6[1] != 5
        print("FAIL tuning_just just_ratio(m6): got [" + str(r_m6[0]) + "," + str(r_m6[1]) + "] want [8,5]")
        exit(1)

    // M6 = 5/3
    let r_M6 = just_ratio("M6")
    if r_M6[0] != 5 or r_M6[1] != 3
        print("FAIL tuning_just just_ratio(M6): got [" + str(r_M6[0]) + "," + str(r_M6[1]) + "] want [5,3]")
        exit(1)

    // m7 = 9/5
    let r_m7 = just_ratio("m7")
    if r_m7[0] != 9 or r_m7[1] != 5
        print("FAIL tuning_just just_ratio(m7): got [" + str(r_m7[0]) + "," + str(r_m7[1]) + "] want [9,5]")
        exit(1)

    // M7 = 15/8
    let r_M7 = just_ratio("M7")
    if r_M7[0] != 15 or r_M7[1] != 8
        print("FAIL tuning_just just_ratio(M7): got [" + str(r_M7[0]) + "," + str(r_M7[1]) + "] want [15,8]")
        exit(1)

    // unknown name -> [1,1]
    let r_unk = just_ratio("XX")
    if r_unk[0] != 1 or r_unk[1] != 1
        print("FAIL tuning_just just_ratio(XX): got [" + str(r_unk[0]) + "," + str(r_unk[1]) + "] want [1,1]")
        exit(1)

    // ── just_cents ────────────────────────────────────────────────────────────

    // P5 = 702
    let c_p5 = just_cents("P5")
    if c_p5 != 702
        print("FAIL tuning_just just_cents(P5): got " + str(c_p5) + " want 702")
        exit(1)

    // M3 = 386
    let c_m3 = just_cents("M3")
    if c_m3 != 386
        print("FAIL tuning_just just_cents(M3): got " + str(c_m3) + " want 386")
        exit(1)

    // P4 = 498
    let c_p4 = just_cents("P4")
    if c_p4 != 498
        print("FAIL tuning_just just_cents(P4): got " + str(c_p4) + " want 498")
        exit(1)

    // P1 = 0
    let c_p1 = just_cents("P1")
    if c_p1 != 0
        print("FAIL tuning_just just_cents(P1): got " + str(c_p1) + " want 0")
        exit(1)

    // P8 = 1200
    let c_p8 = just_cents("P8")
    if c_p8 != 1200
        print("FAIL tuning_just just_cents(P8): got " + str(c_p8) + " want 1200")
        exit(1)

    // m2 = 112
    let c_m2 = just_cents("m2")
    if c_m2 != 112
        print("FAIL tuning_just just_cents(m2): got " + str(c_m2) + " want 112")
        exit(1)

    // M2 = 204
    let c_M2 = just_cents("M2")
    if c_M2 != 204
        print("FAIL tuning_just just_cents(M2): got " + str(c_M2) + " want 204")
        exit(1)

    // m3 = 316
    let c_m3b = just_cents("m3")
    if c_m3b != 316
        print("FAIL tuning_just just_cents(m3): got " + str(c_m3b) + " want 316")
        exit(1)

    // TT = 590
    let c_tt = just_cents("TT")
    if c_tt != 590
        print("FAIL tuning_just just_cents(TT): got " + str(c_tt) + " want 590")
        exit(1)

    // m6 = 814
    let c_m6 = just_cents("m6")
    if c_m6 != 814
        print("FAIL tuning_just just_cents(m6): got " + str(c_m6) + " want 814")
        exit(1)

    // M6 = 884
    let c_M6 = just_cents("M6")
    if c_M6 != 884
        print("FAIL tuning_just just_cents(M6): got " + str(c_M6) + " want 884")
        exit(1)

    // m7 = 1018
    let c_m7 = just_cents("m7")
    if c_m7 != 1018
        print("FAIL tuning_just just_cents(m7): got " + str(c_m7) + " want 1018")
        exit(1)

    // M7 = 1088
    let c_M7 = just_cents("M7")
    if c_M7 != 1088
        print("FAIL tuning_just just_cents(M7): got " + str(c_M7) + " want 1088")
        exit(1)

    // unknown -> 0
    let c_unk = just_cents("XX")
    if c_unk != 0
        print("FAIL tuning_just just_cents(XX): got " + str(c_unk) + " want 0")
        exit(1)

    // ── ratio_to_cents ────────────────────────────────────────────────────────

    // 2/1 = 1200 (octave)
    let rtc_oct = ratio_to_cents(2, 1)
    if rtc_oct != 1200
        print("FAIL tuning_just ratio_to_cents(2,1): got " + str(rtc_oct) + " want 1200")
        exit(1)

    // 3/2 = 702 (P5)
    let rtc_p5 = ratio_to_cents(3, 2)
    if rtc_p5 != 702
        print("FAIL tuning_just ratio_to_cents(3,2): got " + str(rtc_p5) + " want 702")
        exit(1)

    // 1/1 = 0 (unison)
    let rtc_p1 = ratio_to_cents(1, 1)
    if rtc_p1 != 0
        print("FAIL tuning_just ratio_to_cents(1,1): got " + str(rtc_p1) + " want 0")
        exit(1)

    // 4/3 = 498 (P4)
    let rtc_p4 = ratio_to_cents(4, 3)
    if rtc_p4 != 498
        print("FAIL tuning_just ratio_to_cents(4,3): got " + str(rtc_p4) + " want 498")
        exit(1)

    // 5/4 = 386 (M3)
    let rtc_m3 = ratio_to_cents(5, 4)
    if rtc_m3 != 386
        print("FAIL tuning_just ratio_to_cents(5,4): got " + str(rtc_m3) + " want 386")
        exit(1)

    // consistency: ratio_to_cents must match just_cents for all 13 intervals
    let names = ["P1","m2","M2","m3","M3","P4","TT","P5","m6","M6","m7","M7","P8"]
    let i = 0
    while i < 13
        let nm = names[i]
        let r = just_ratio(nm)
        let expected = just_cents(nm)
        let computed = ratio_to_cents(r[0], r[1])
        if computed != expected
            print("FAIL tuning_just ratio_to_cents consistency " + nm + ": got " + str(computed) + " want " + str(expected))
            exit(1)
        i = i + 1

    // ── ratio_reduce ──────────────────────────────────────────────────────────

    // 6/4 -> 3/2
    let rr1 = ratio_reduce(6, 4)
    if rr1[0] != 3 or rr1[1] != 2
        print("FAIL tuning_just ratio_reduce(6,4): got [" + str(rr1[0]) + "," + str(rr1[1]) + "] want [3,2]")
        exit(1)

    // 10/8 -> 5/4
    let rr2 = ratio_reduce(10, 8)
    if rr2[0] != 5 or rr2[1] != 4
        print("FAIL tuning_just ratio_reduce(10,8): got [" + str(rr2[0]) + "," + str(rr2[1]) + "] want [5,4]")
        exit(1)

    // already reduced: 3/2 -> 3/2
    let rr3 = ratio_reduce(3, 2)
    if rr3[0] != 3 or rr3[1] != 2
        print("FAIL tuning_just ratio_reduce(3,2): got [" + str(rr3[0]) + "," + str(rr3[1]) + "] want [3,2]")
        exit(1)

    // 1/1 -> 1/1
    let rr4 = ratio_reduce(1, 1)
    if rr4[0] != 1 or rr4[1] != 1
        print("FAIL tuning_just ratio_reduce(1,1): got [" + str(rr4[0]) + "," + str(rr4[1]) + "] want [1,1]")
        exit(1)

    // 12/8 -> 3/2
    let rr5 = ratio_reduce(12, 8)
    if rr5[0] != 3 or rr5[1] != 2
        print("FAIL tuning_just ratio_reduce(12,8): got [" + str(rr5[0]) + "," + str(rr5[1]) + "] want [3,2]")
        exit(1)

    // 100/50 -> 2/1
    let rr6 = ratio_reduce(100, 50)
    if rr6[0] != 2 or rr6[1] != 1
        print("FAIL tuning_just ratio_reduce(100,50): got [" + str(rr6[0]) + "," + str(rr6[1]) + "] want [2,1]")
        exit(1)

    print("PASS _tuning_just_test")
