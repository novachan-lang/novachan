// KAT: an extern declared `-> float` must render as a FLOAT, not as its raw bits.
// An extern hands back raw double bits (NOVA's float ABI), but the call result carried
// no type, so str() lowered to any_to_str -- which runs find_tag on those bits, finds no
// heap object, and prints them as an INTEGER. A C function returning 3.75 printed
// 4615626668101337088, which IS 3.75's bit pattern.
//
// The subtle part: when an extern needs a marshalling wrapper the call site emits
// `nova_ffi_<name>`, so seeding the return type under the bare name does nothing.
extern fn ffi_half(x: float) -> float
extern fn ffi_const_pi() -> float
extern fn ffi_add(a: int, b: int) -> int

fn main()
    let ok = 0
    let fail = 0

    let h = unsafe ffi_half(7.5)
    if str(h) == "3.75"
        ok = ok + 1
        print("ok: extern -> float renders as a float (" + str(h) + ")")
    else
        fail = fail + 1
        print("FAIL extern float rendered as: " + str(h) + " (expected 3.75)")

    // zero-arg extern returning float
    let p = unsafe ffi_const_pi()
    if p > 3.14 and p < 3.15
        ok = ok + 1
        print("ok: zero-arg extern float is numerically usable (" + str(p) + ")")
    else
        fail = fail + 1
        print("FAIL zero-arg extern float = " + str(p))

    // the returned float must still work in ARITHMETIC, not just printing
    let doubled = h * 2.0
    if str(doubled) == "7.5"
        ok = ok + 1
        print("ok: extern float participates in arithmetic")
    else
        fail = fail + 1
        print("FAIL arithmetic on extern float gave " + str(doubled))

    // int-returning externs must be unaffected
    if unsafe ffi_add(40, 2) == 42
        ok = ok + 1
        print("ok: int-returning extern unchanged")
    else
        fail = fail + 1
        print("FAIL int extern regressed")

    print("ok=" + str(ok) + " fail=" + str(fail))
    if fail == 0
        print("KAT ffi_float_ret PASS")
    else
        print("KAT ffi_float_ret FAIL")
