import forge_debruijn

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

// verify: every length-n cyclic window is distinct and all k^n appear
fn verify(k: int, n: int) -> int
    let seq = de_bruijn(k, n)
    let m = len(seq)
    // expected length = k^n
    let expect_len = 1
    let e = 0
    while e < n
        expect_len = expect_len * k
        e = e + 1
    if m != expect_len
        return 0
    // collect all cyclic windows as base-k numbers, check distinct count == k^n
    let seen = {}
    let distinct = 0
    let i = 0
    while i < m
        let val = 0
        let w = 0
        while w < n
            val = val * k + seq[(i + w) % m]
            w = w + 1
        let key = str(val)
        if contains(seen, key) == false
            seen[key] = 1
            distinct = distinct + 1
        i = i + 1
    if distinct == expect_len
        return 1
    0

fn main()
    let fails = 0

    // exact known sequences
    fails = fails + expect("b23", de_bruijn_string(2, 3), "00010111")
    fails = fails + expect("b22", de_bruijn_string(2, 2), "0011")
    fails = fails + expect("b21", de_bruijn_string(2, 1), "01")
    fails = fails + expect("b24", de_bruijn_string(2, 4), "0000100110101111")

    // lengths = k^n
    fails = fails + expect("len23", str(len(de_bruijn(2, 3))), "8")
    fails = fails + expect("len32", str(len(de_bruijn(3, 2))), "9")
    fails = fails + expect("len25", str(len(de_bruijn(2, 5))), "32")

    // full-coverage verification: every window distinct and all present
    fails = fails + expect("verify_2_3", str(verify(2, 3)), "1")
    fails = fails + expect("verify_2_4", str(verify(2, 4)), "1")
    fails = fails + expect("verify_3_2", str(verify(3, 2)), "1")
    fails = fails + expect("verify_3_3", str(verify(3, 3)), "1")
    fails = fails + expect("verify_4_2", str(verify(4, 2)), "1")

    if fails == 0
        print("forge_debruijn: all passed")
    else
        print("forge_debruijn: " + str(fails) + " FAILED")
