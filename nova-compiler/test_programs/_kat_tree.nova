// KAT: std/core/tree — generic n-ary tree, high-level recursive ops.
import std/core/tree

fn list_eq(a: list, b: list) -> bool
    if len(a) != len(b)
        return false
    for i, v in a
        if v != b[i]
            return false
    return true

fn main() -> int
    let fails = 0

    //        1
    //      /   \
    //     2     3
    //    / \
    //   4   5
    let t = tnode(1, [tnode(2, [tleaf(4), tleaf(5)]), tleaf(3)])

    let vals = t_values(t)
    if not list_eq(vals, [1, 2, 4, 5, 3])
        print("FAIL t_values=" + str(vals))
        fails = fails + 1

    let lvs = t_leaves(t)
    if not list_eq(lvs, [4, 5, 3])
        print("FAIL t_leaves=" + str(lvs))
        fails = fails + 1

    if t_depth(t) != 3
        print("FAIL t_depth=" + str(t_depth(t)))
        fails = fails + 1

    if t_count(t) != 5
        print("FAIL t_count=" + str(t_count(t)))
        fails = fails + 1

    // single leaf: depth 1, count 1
    let single = tleaf(42)
    if t_depth(single) != 1
        print("FAIL t_depth(single)=" + str(t_depth(single)))
        fails = fails + 1
    if t_count(single) != 1
        print("FAIL t_count(single)=" + str(t_count(single)))
        fails = fails + 1

    // t_fold: pre-order sum of all values == 1+2+4+5+3 == 15
    let folded = t_fold(t, fn(acc, v) acc + v, 0)
    if folded != 15
        print("FAIL t_fold=" + str(folded))
        fails = fails + 1

    // t_map(double) preserves shape; pre-order values all doubled
    let doubled = t_map(t, fn(v) v * 2)
    let dvals = t_values(doubled)
    if not list_eq(dvals, [2, 4, 8, 10, 6])
        print("FAIL t_map values=" + str(dvals))
        fails = fails + 1
    // shape preserved: same depth/count after mapping
    if t_depth(doubled) != 3
        print("FAIL t_map depth=" + str(t_depth(doubled)))
        fails = fails + 1
    if t_count(doubled) != 5
        print("FAIL t_map count=" + str(t_count(doubled)))
        fails = fails + 1

    // t_find: hit
    match t_find(t, fn(v) v == 4)
        Some(v) =>
            if v != 4
                print("FAIL t_find hit value=" + str(v))
                fails = fails + 1
        None =>
            print("FAIL t_find hit -> None")
            fails = fails + 1

    // t_find: miss
    match t_find(t, fn(v) v == 99)
        Some(v) =>
            print("FAIL t_find miss -> Some(" + str(v) + ")")
            fails = fails + 1
        None =>
            0

    if fails == 0
        print("TREE KAT PASS")
    else
        print("TREE KAT FAILED: " + str(fails) + " assertion(s)")
    return 0
