// KAT for std/text/md_hr
import std/text/md_hr

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL md_hr " + label + ": got [" + str(got) + "] want [" + str(want) + "]")
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL md_hr " + label + ": got [" + got + "]")
        exit(1)

fn main()
    // Core KAT from spec
    cks("dashes",   md_hr("---"),   "<hr>")
    cks("stars",    md_hr("***"),   "<hr>")
    cks("undersc",  md_hr("___"),   "<hr>")

    // Spaces allowed between markers
    cks("spaced_dash", md_hr("- - -"), "<hr>")
    cks("spaced_star", md_hr("* * *"), "<hr>")
    cks("spaced_us",   md_hr("_ _ _"), "<hr>")

    // Only 2 markers -> not a HR
    cks("two_dash", md_hr("--"), "")
    cks("two_star", md_hr("**"), "")

    // Non-HR text
    cks("text",      md_hr("text"),    "")
    cks("empty",     md_hr(""),        "")

    // More than 3
    cks("four_dash", md_hr("----"),    "<hr>")
    cks("ten_star",  md_hr("**********"), "<hr>")

    // Leading/trailing spaces (spaces in the run, not leading spaces - treat as spaces between)
    cks("mixed_spaces", md_hr("-  -  -"), "<hr>")

    // Mixed chars -> not HR
    cks("mixed_chars", md_hr("-*-"), "")

    // is_hr bool function
    cki("is_hr_dash",  is_hr("---"),    1)
    cki("is_hr_star",  is_hr("***"),    1)
    cki("is_hr_text",  is_hr("text"),   0)
    cki("is_hr_empty", is_hr(""),       0)
    cki("is_hr_two",   is_hr("--"),     0)
    cki("is_hr_space", is_hr("- - -"),  1)

    print("PASS _md_hr_test")
