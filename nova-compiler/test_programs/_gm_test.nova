// _gm_test.nova — KAT for std/midi/gm
//
// Known-answer tests for General MIDI instrument/drum/family name lookups.
//
// HAND-VERIFIED VECTORS (from GM Level 1 specification)
//   program 0   -> "Acoustic Grand Piano"   (Piano family, fam index 0)
//   program 40  -> "Violin"                 (Strings family, fam index 5)
//   program 56  -> "Trumpet"                (Brass family, fam index 7)
//   program 73  -> "Flute"                  (Pipe family, fam index 9)
//   program 127 -> "Gunshot"                (Sound Effects family, fam index 15)
//   program 200 -> "Undefined"              (out of range)
//   gm_program("Violin")      -> 40
//   gm_program("Unknown Xyz") -> -1
//   drum note 35 -> "Acoustic Bass Drum"
//   drum note 38 -> "Acoustic Snare"
//   drum note 42 -> "Closed Hi-Hat"
//   drum note 81 -> "Open Triangle"
//   drum note 34 -> "Undefined"             (below range)
//   drum note 82 -> "Undefined"             (above range)
//   gm_family(0)   -> "Piano"               (0/8=0)
//   gm_family(7)   -> "Piano"               (7/8=0)
//   gm_family(8)   -> "Chromatic Perc"      (8/8=1)
//   gm_family(40)  -> "Strings"             (40/8=5)
//   gm_family(56)  -> "Brass"               (56/8=7)
//   gm_family(72)  -> "Pipe"                (72/8=9)
//   gm_family(127) -> "Sound Effects"       (127/8=15)
//   gm_family(128) -> "Undefined"           (out of range)

import std/midi/gm

fn cks(label, got, want)
    if got != want
        print("FAIL gm " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL gm " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── gm_instrument ────────────────────────────────────────────────────────
    cks("instrument(0)",   gm_instrument(0),   "Acoustic Grand Piano")
    cks("instrument(1)",   gm_instrument(1),   "Bright Acoustic Piano")
    cks("instrument(7)",   gm_instrument(7),   "Clavi")
    cks("instrument(8)",   gm_instrument(8),   "Celesta")
    cks("instrument(40)",  gm_instrument(40),  "Violin")
    cks("instrument(41)",  gm_instrument(41),  "Viola")
    cks("instrument(42)",  gm_instrument(42),  "Cello")
    cks("instrument(56)",  gm_instrument(56),  "Trumpet")
    cks("instrument(57)",  gm_instrument(57),  "Trombone")
    cks("instrument(73)",  gm_instrument(73),  "Flute")
    cks("instrument(127)", gm_instrument(127), "Gunshot")
    cks("instrument(-1)",  gm_instrument(-1),  "Undefined")
    cks("instrument(128)", gm_instrument(128), "Undefined")
    cks("instrument(200)", gm_instrument(200), "Undefined")

    // ── gm_program (reverse lookup) ──────────────────────────────────────────
    cki("program(AcousticGrand)",  gm_program("Acoustic Grand Piano"), 0)
    cki("program(Violin)",         gm_program("Violin"), 40)
    cki("program(Trumpet)",        gm_program("Trumpet"), 56)
    cki("program(Flute)",          gm_program("Flute"), 73)
    cki("program(Gunshot)",        gm_program("Gunshot"), 127)
    cki("program(unknown)",        gm_program("Unknown Instrument"), -1)
    cki("program(empty)",          gm_program(""), -1)

    // ── gm_drum ──────────────────────────────────────────────────────────────
    cks("drum(35)", gm_drum(35), "Acoustic Bass Drum")
    cks("drum(36)", gm_drum(36), "Bass Drum 1")
    cks("drum(38)", gm_drum(38), "Acoustic Snare")
    cks("drum(42)", gm_drum(42), "Closed Hi-Hat")
    cks("drum(46)", gm_drum(46), "Open Hi-Hat")
    cks("drum(49)", gm_drum(49), "Crash Cymbal 1")
    cks("drum(51)", gm_drum(51), "Ride Cymbal 1")
    cks("drum(81)", gm_drum(81), "Open Triangle")
    cks("drum(34)", gm_drum(34), "Undefined")
    cks("drum(82)", gm_drum(82), "Undefined")
    cks("drum(0)",  gm_drum(0),  "Undefined")

    // ── gm_family ────────────────────────────────────────────────────────────
    cks("family(0)",   gm_family(0),   "Piano")
    cks("family(7)",   gm_family(7),   "Piano")
    cks("family(8)",   gm_family(8),   "Chromatic Perc")
    cks("family(15)",  gm_family(15),  "Chromatic Perc")
    cks("family(16)",  gm_family(16),  "Organ")
    cks("family(24)",  gm_family(24),  "Guitar")
    cks("family(32)",  gm_family(32),  "Bass")
    cks("family(40)",  gm_family(40),  "Strings")
    cks("family(48)",  gm_family(48),  "Ensemble")
    cks("family(56)",  gm_family(56),  "Brass")
    cks("family(64)",  gm_family(64),  "Reed")
    cks("family(72)",  gm_family(72),  "Pipe")
    cks("family(80)",  gm_family(80),  "Synth Lead")
    cks("family(88)",  gm_family(88),  "Synth Pad")
    cks("family(96)",  gm_family(96),  "Synth Effects")
    cks("family(104)", gm_family(104), "Ethnic")
    cks("family(112)", gm_family(112), "Percussive")
    cks("family(120)", gm_family(120), "Sound Effects")
    cks("family(127)", gm_family(127), "Sound Effects")
    cks("family(128)", gm_family(128), "Undefined")
    cks("family(-1)",  gm_family(-1),  "Undefined")

    print("PASS _gm_test")
