import forge_josephus

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn joinl(xs: list) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + ","
        out = out + str(xs[i])
        i = i + 1
    out

fn main()
    let fails = 0

    // survivor (0-based) via the recurrence
    fails = fails + expect("j_7_3", str(josephus(7, 3)), "3")
    fails = fails + expect("j_1_1", str(josephus(1, 1)), "0")
    fails = fails + expect("j_5_2", str(josephus(5, 2)), "2")
    fails = fails + expect("j_10_2", str(josephus(10, 2)), "4")
    fails = fails + expect("j_100_1", str(josephus(100, 1)), "99")
    fails = fails + expect("j_6_5", str(josephus(6, 5)), "0")

    // elimination order
    fails = fails + expect("order_7_3", joinl(josephus_order(7, 3)), "2,5,1,6,4,0,3")
    fails = fails + expect("order_5_2", joinl(josephus_order(5, 2)), "1,3,0,4,2")

    // survivor via simulation matches the recurrence for many (n,k)
    let match_all = 1
    let n = 1
    while n <= 30
        let k = 1
        while k <= 6
            if josephus_survivor_sim(n, k) != josephus(n, k)
                match_all = 0
            k = k + 1
        n = n + 1
    fails = fails + expect("sim_matches_recurrence", str(match_all), "1")

    // order is a permutation of 0..n-1 (length n, all present)
    let ord = josephus_order(8, 3)
    fails = fails + expect("order_len", str(len(ord)), "8")

    if fails == 0
        print("forge_josephus: all passed")
    else
        print("forge_josephus: " + str(fails) + " FAILED")
