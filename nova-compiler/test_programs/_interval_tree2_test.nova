import std/interval/interval_tree2

// Helper: compare two lists of [lo,hi] intervals for structural equality.
fn iv_eq(a, b)
    if len(a) != len(b)
        return 0
    let i = 0
    while i < len(a)
        let ii = i
        let pa = a[ii]
        let pb = b[ii]
        if pa[0] != pb[0] or pa[1] != pb[1]
            return 0
        i = i + 1
    return 1

fn main()
    // Build tree from [[1,3],[5,8],[6,10],[15,20]]
    let t = it_build([[1,3],[5,8],[6,10],[15,20]])

    // KAT 1: it_query_point(t, 6) == [[5,8],[6,10]] (both contain 6, sorted by lo)
    let r1 = it_query_point(t, 6)
    let want1 = [[5,8],[6,10]]
    if iv_eq(r1, want1) != 1
        print("FAIL it_query_point_1: got len=" + str(len(r1)))
        if len(r1) > 0
            let e0 = r1[0]
            print("  [0]=" + str(e0[0]) + "," + str(e0[1]))
        exit(1)

    // KAT 2: it_query_point(t, 4) == [] (none contain 4)
    let r2 = it_query_point(t, 4)
    if len(r2) != 0
        print("FAIL it_query_point_2: got len=" + str(len(r2)) + " want=0")
        exit(1)

    // KAT 3: it_query_overlap(t, 7, 9) == [[5,8],[6,10]]
    let r3 = it_query_overlap(t, 7, 9)
    let want3 = [[5,8],[6,10]]
    if iv_eq(r3, want3) != 1
        print("FAIL it_query_overlap_3: got len=" + str(len(r3)))
        exit(1)

    // KAT 4: it_query_overlap(t, 11, 14) == [] (gap between [6,10] and [15,20])
    let r4 = it_query_overlap(t, 11, 14)
    if len(r4) != 0
        print("FAIL it_query_overlap_4: got len=" + str(len(r4)) + " want=0")
        exit(1)

    // KAT 5: it_query_overlap(t, 2, 16) == [[1,3],[5,8],[6,10],[15,20]] (all overlap)
    let r5 = it_query_overlap(t, 2, 16)
    let want5 = [[1,3],[5,8],[6,10],[15,20]]
    if iv_eq(r5, want5) != 1
        print("FAIL it_query_overlap_5: got len=" + str(len(r5)))
        exit(1)

    // KAT 6: it_count(t) == 4
    let r6 = it_count(t)
    if r6 != 4
        print("FAIL it_count_6: got=" + str(r6) + " want=4")
        exit(1)

    // KAT 7: it_contains_point(t, 4) == false (0) (4 not in any interval)
    let r7 = it_contains_point(t, 4)
    if r7 != 0
        print("FAIL it_contains_point_7: got=" + str(r7) + " want=0")
        exit(1)

    // KAT 8: it_contains_point(t, 6) == true (1)
    let r8 = it_contains_point(t, 6)
    if r8 != 1
        print("FAIL it_contains_point_8: got=" + str(r8) + " want=1")
        exit(1)

    // KAT 9: it_contains_point(t, 16) == true (16 in [15,20])
    let r9 = it_contains_point(t, 16)
    if r9 != 1
        print("FAIL it_contains_point_9: got=" + str(r9) + " want=1")
        exit(1)

    // KAT 10: it_all returns all 4 intervals sorted by lo
    let r10 = it_all(t)
    let want10 = [[1,3],[5,8],[6,10],[15,20]]
    if iv_eq(r10, want10) != 1
        print("FAIL it_all_10: got len=" + str(len(r10)))
        exit(1)

    // KAT 11: it_query_count(t, 7, 9) == 2
    let r11 = it_query_count(t, 7, 9)
    if r11 != 2
        print("FAIL it_query_count_11: got=" + str(r11) + " want=2")
        exit(1)

    // KAT 12: it_max_endpoint(t) == 20.0
    let r12 = it_max_endpoint(t)
    if r12 != 20.0
        print("FAIL it_max_endpoint_12: got=" + str(r12) + " want=20.0")
        exit(1)

    // KAT 13: it_insert adds a new interval and maintains sorted order
    let t2 = it_build([[5,8],[1,3]])
    let t3 = it_insert(t2, [2,4])
    // After insert: sorted [[1,3],[2,4],[5,8]]
    if it_count(t3) != 3
        print("FAIL it_insert_13_count: got=" + str(it_count(t3)) + " want=3")
        exit(1)
    let all3 = it_all(t3)
    let want13 = [[1,3],[2,4],[5,8]]
    if iv_eq(all3, want13) != 1
        print("FAIL it_insert_13_order: got len=" + str(len(all3)))
        exit(1)

    // KAT 14: empty tree queries
    let te = it_build([])
    if it_count(te) != 0
        print("FAIL it_empty_count")
        exit(1)
    if len(it_query_point(te, 5)) != 0
        print("FAIL it_empty_query_point")
        exit(1)
    if len(it_query_overlap(te, 1, 10)) != 0
        print("FAIL it_empty_query_overlap")
        exit(1)
    if it_contains_point(te, 5) != 0
        print("FAIL it_empty_contains_point")
        exit(1)
    let me = it_max_endpoint(te)
    if me != 0.0
        print("FAIL it_empty_max_endpoint: got=" + str(me))
        exit(1)

    // KAT 15: query_overlap touching boundary (closed intervals touch = overlap)
    // [1,3] and [3,5] share point 3 => they DO overlap
    let tb = it_build([[1,3],[5,7]])
    let rb = it_query_overlap(tb, 3, 4)
    // [1,3] overlaps [3,4] (1<=4 AND 3<=3); [5,7] does not (5>4)
    if len(rb) != 1
        print("FAIL it_boundary_overlap: got len=" + str(len(rb)) + " want=1")
        exit(1)
    let rb0 = rb[0]
    if rb0[0] != 1 or rb0[1] != 3
        print("FAIL it_boundary_overlap_val: " + str(rb0[0]) + "," + str(rb0[1]))
        exit(1)

    print("PASS _interval_tree2_test")

main()
