import std/relation/relation_ops

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn ckl(label, got, want)
    if len(got) != len(want)
        print("FAIL " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL " + label + ": [" + str(i) + "] got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

// ckm — check two n x n matrices are equal cell by cell.
fn ckm(label, A, B)
    let n = len(A)
    if len(B) != n
        print("FAIL " + label + ": row count got=" + str(len(A)) + " want=" + str(len(B)))
        exit(1)
    let i = 0
    while i < n
        let j = 0
        while j < n
            if A[i][j] != B[i][j]
                print("FAIL " + label + ": [" + str(i) + "][" + str(j) + "] got=" + str(A[i][j]) + " want=" + str(B[i][j]))
                exit(1)
            j = j + 1
        i = i + 1

// Local helper — build n x n zero matrix.
fn _mk_zeros(n)
    let M = []
    let i = 0
    while i < n
        let row = []
        let j = 0
        while j < n
            row.push(0)
            j = j + 1
        M.push(row)
        i = i + 1
    return M

// Local helper — build matrix from pairs.
fn _mk_pairs(pairs, n)
    let M = _mk_zeros(n)
    let k = 0
    while k < len(pairs)
        let p = pairs[k]
        M[p[0]][p[1]] = 1
        k = k + 1
    return M

// Local helper — build identity matrix.
fn _mk_id(n)
    let M = _mk_zeros(n)
    let i = 0
    while i < n
        M[i][i] = 1
        i = i + 1
    return M

// Local helper — count 1s in matrix.
fn _mat_size(M)
    let count = 0
    let n = len(M)
    let i = 0
    while i < n
        let j = 0
        while j < n
            if M[i][j] == 1
                count = count + 1
            j = j + 1
        i = i + 1
    return count

fn main()
    // =========================================================================
    // rop_union
    // =========================================================================
    // A = {(0,1)}, B = {(1,2)} on n=3 -> union = {(0,1),(1,2)}
    let pA = []
    pA.push([0, 1])
    let A3 = _mk_pairs(pA, 3)
    let pB = []
    pB.push([1, 2])
    let B3 = _mk_pairs(pB, 3)
    let U = rop_union(A3, B3)
    cki("union_01", U[0][1], 1)
    cki("union_12", U[1][2], 1)
    cki("union_10_absent", U[1][0], 0)
    cki("union_size", _mat_size(U), 2)

    // Union with self = self
    let Uself = rop_union(A3, A3)
    cki("union_self_01", Uself[0][1], 1)
    cki("union_self_size", _mat_size(Uself), 1)

    // =========================================================================
    // rop_intersect
    // =========================================================================
    // A = {(0,1),(1,2)}, B = {(0,1),(2,2)} -> intersect = {(0,1)}
    let pA2 = []
    pA2.push([0, 1])
    pA2.push([1, 2])
    let A2 = _mk_pairs(pA2, 3)
    let pB2 = []
    pB2.push([0, 1])
    pB2.push([2, 2])
    let B2 = _mk_pairs(pB2, 3)
    let I = rop_intersect(A2, B2)
    cki("intersect_01", I[0][1], 1)
    cki("intersect_12_absent", I[1][2], 0)
    cki("intersect_22_absent", I[2][2], 0)
    cki("intersect_size", _mat_size(I), 1)

    // Intersect with zeros = zeros
    let Iz = rop_intersect(A2, _mk_zeros(3))
    cki("intersect_zeros_size", _mat_size(Iz), 0)

    // =========================================================================
    // rop_difference
    // =========================================================================
    // A = {(0,1),(1,2)}, B = {(0,1)} -> diff = {(1,2)}
    let pDa = []
    pDa.push([0, 1])
    pDa.push([1, 2])
    let Da = _mk_pairs(pDa, 3)
    let pDb = []
    pDb.push([0, 1])
    let Db = _mk_pairs(pDb, 3)
    let D = rop_difference(Da, Db)
    cki("diff_12", D[1][2], 1)
    cki("diff_01_absent", D[0][1], 0)
    cki("diff_size", _mat_size(D), 1)

    // A - A = empty
    let Dself = rop_difference(Da, Da)
    cki("diff_self_size", _mat_size(Dself), 0)

    // =========================================================================
    // rop_complement
    // =========================================================================
    // complement of identity(2) = {(0,1),(1,0)}
    let id2 = _mk_id(2)
    let C = rop_complement(id2)
    cki("comp_id2_01", C[0][1], 1)
    cki("comp_id2_10", C[1][0], 1)
    cki("comp_id2_00", C[0][0], 0)
    cki("comp_id2_11", C[1][1], 0)
    cki("comp_id2_size", _mat_size(C), 2)

    // complement of zeros = all-ones
    let Z3 = _mk_zeros(3)
    let CZ = rop_complement(Z3)
    cki("comp_zeros3_size", _mat_size(CZ), 9)

    // complement(complement(A)) = A
    let pOrig = []
    pOrig.push([0, 1])
    let Orig = _mk_pairs(pOrig, 3)
    let CC = rop_complement(rop_complement(Orig))
    ckm("comp_comp_identity", CC, Orig)

    // =========================================================================
    // rop_converse
    // =========================================================================
    // converse of {(0,1),(1,2)} = {(1,0),(2,1)}
    let pConv = []
    pConv.push([0, 1])
    pConv.push([1, 2])
    let Conv = _mk_pairs(pConv, 3)
    let CV = rop_converse(Conv)
    cki("converse_10", CV[1][0], 1)
    cki("converse_21", CV[2][1], 1)
    cki("converse_01_absent", CV[0][1], 0)
    cki("converse_12_absent", CV[1][2], 0)
    cki("converse_size", _mat_size(CV), 2)

    // converse of identity = identity
    let id3 = _mk_id(3)
    let CVid = rop_converse(id3)
    ckm("converse_identity", CVid, id3)

    // converse(converse(A)) = A
    let CVV = rop_converse(CV)
    ckm("converse_involution", CVV, Conv)

    // =========================================================================
    // rop_compose
    // =========================================================================
    // {(0,1)} composed with {(1,2)} on n=3 = {(0,2)}
    let pC1 = []
    pC1.push([0, 1])
    let C1 = _mk_pairs(pC1, 3)
    let pC2 = []
    pC2.push([1, 2])
    let C2 = _mk_pairs(pC2, 3)
    let Comp = rop_compose(C1, C2)
    cki("compose_02", Comp[0][2], 1)
    cki("compose_size", _mat_size(Comp), 1)
    cki("compose_01_absent", Comp[0][1], 0)
    cki("compose_12_absent", Comp[1][2], 0)

    // compose(identity, A) = A
    let id3b = _mk_id(3)
    let pAny = []
    pAny.push([0, 1])
    pAny.push([1, 2])
    pAny.push([0, 2])
    let Aany = _mk_pairs(pAny, 3)
    let CompId = rop_compose(id3b, Aany)
    ckm("compose_id_A", CompId, Aany)

    // compose(A, identity) = A
    let CompAId = rop_compose(Aany, id3b)
    ckm("compose_A_id", CompAId, Aany)

    // compose({(0,1),(1,2)},{(2,0)}) = {(1,0)} only
    // (0,1)o(1,2): 1 is intermediate -> need B[1][*]; B[2][0]=1; so (0 via 2?) no
    // let's trace: A={(0,1),(1,2)}, B={(2,0)}
    // (i=0,k=0): j=1: A[0][1]=1, B[1][0]=0; j=2: A[0][2]=0. no.
    // (i=1,k=0): j=2: A[1][2]=1, B[2][0]=1. YES -> (1,0)
    let pX = []
    pX.push([0, 1])
    pX.push([1, 2])
    let X = _mk_pairs(pX, 3)
    let pY = []
    pY.push([2, 0])
    let Y = _mk_pairs(pY, 3)
    let XY = rop_compose(X, Y)
    cki("compose_chain_10", XY[1][0], 1)
    cki("compose_chain_size", _mat_size(XY), 1)
    cki("compose_chain_00_absent", XY[0][0], 0)

    // compose of empty with anything = empty
    let Zcomp = rop_compose(_mk_zeros(3), Aany)
    cki("compose_empty_size", _mat_size(Zcomp), 0)

    print("PASS _relation_ops_test")

main()
