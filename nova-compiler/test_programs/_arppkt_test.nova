import std/net/arppkt

fn _check_v1(sha1)
    let h1 = {"oper": 1, "sha": sha1, "spa": 0xC0A80001, "tha": bytes(6), "tpa": 0xC0A800C7}
    let enc1 = arp_encode(h1)
    let got_len = bytes_len(enc1)
    if got_len != 28
        print("FAIL arppkt encode-len: got "+str(got_len)+" want 28")
        exit(1)
    let b0 = bytes_get(enc1, 0)
    if b0 != 0
        print("FAIL arppkt byte[0] htype-hi: got "+str(b0)+" want 0")
        exit(1)
    let b1 = bytes_get(enc1, 1)
    if b1 != 1
        print("FAIL arppkt byte[1] htype-lo: got "+str(b1)+" want 1")
        exit(1)
    let b2 = bytes_get(enc1, 2)
    if b2 != 0x08
        print("FAIL arppkt byte[2] ptype-hi: got "+str(b2)+" want 8")
        exit(1)
    let b3 = bytes_get(enc1, 3)
    if b3 != 0x00
        print("FAIL arppkt byte[3] ptype-lo: got "+str(b3)+" want 0")
        exit(1)
    let b4 = bytes_get(enc1, 4)
    if b4 != 6
        print("FAIL arppkt byte[4] hlen: got "+str(b4)+" want 6")
        exit(1)
    let b5 = bytes_get(enc1, 5)
    if b5 != 4
        print("FAIL arppkt byte[5] plen: got "+str(b5)+" want 4")
        exit(1)
    let b6 = bytes_get(enc1, 6)
    if b6 != 0
        print("FAIL arppkt byte[6] oper-hi: got "+str(b6)+" want 0")
        exit(1)
    let b7 = bytes_get(enc1, 7)
    if b7 != 1
        print("FAIL arppkt byte[7] oper-lo: got "+str(b7)+" want 1")
        exit(1)
    let b8 = bytes_get(enc1, 8)
    if b8 != 0xDE
        print("FAIL arppkt sha[0]: got "+str(b8)+" want 222")
        exit(1)
    let b9 = bytes_get(enc1, 9)
    if b9 != 0xAD
        print("FAIL arppkt sha[1]: got "+str(b9)+" want 173")
        exit(1)
    let b10 = bytes_get(enc1, 10)
    if b10 != 0xBE
        print("FAIL arppkt sha[2]: got "+str(b10)+" want 190")
        exit(1)
    let b11 = bytes_get(enc1, 11)
    if b11 != 0xEF
        print("FAIL arppkt sha[3]: got "+str(b11)+" want 239")
        exit(1)
    let b12 = bytes_get(enc1, 12)
    if b12 != 0x00
        print("FAIL arppkt sha[4]: got "+str(b12)+" want 0")
        exit(1)
    let b13 = bytes_get(enc1, 13)
    if b13 != 0x01
        print("FAIL arppkt sha[5]: got "+str(b13)+" want 1")
        exit(1)
    let b14 = bytes_get(enc1, 14)
    if b14 != 0xC0
        print("FAIL arppkt spa[0]: got "+str(b14)+" want 192")
        exit(1)
    let b15 = bytes_get(enc1, 15)
    if b15 != 0xA8
        print("FAIL arppkt spa[1]: got "+str(b15)+" want 168")
        exit(1)
    let b16 = bytes_get(enc1, 16)
    if b16 != 0x00
        print("FAIL arppkt spa[2]: got "+str(b16)+" want 0")
        exit(1)
    let b17 = bytes_get(enc1, 17)
    if b17 != 0x01
        print("FAIL arppkt spa[3]: got "+str(b17)+" want 1")
        exit(1)
    let b18 = bytes_get(enc1, 18)
    if b18 != 0
        print("FAIL arppkt tha[0]: got "+str(b18)+" want 0")
        exit(1)
    let b23 = bytes_get(enc1, 23)
    if b23 != 0
        print("FAIL arppkt tha[5]: got "+str(b23)+" want 0")
        exit(1)
    let b24 = bytes_get(enc1, 24)
    if b24 != 0xC0
        print("FAIL arppkt tpa[0]: got "+str(b24)+" want 192")
        exit(1)
    let b25 = bytes_get(enc1, 25)
    if b25 != 0xA8
        print("FAIL arppkt tpa[1]: got "+str(b25)+" want 168")
        exit(1)
    let b26 = bytes_get(enc1, 26)
    if b26 != 0x00
        print("FAIL arppkt tpa[2]: got "+str(b26)+" want 0")
        exit(1)
    let b27 = bytes_get(enc1, 27)
    if b27 != 0xC7
        print("FAIL arppkt tpa[3]: got "+str(b27)+" want 199")
        exit(1)
    enc1

fn _check_rt(enc1)
    let dec1 = arp_decode(enc1)
    let rt_htype = dec1["htype"]
    if rt_htype != 1
        print("FAIL arppkt rt htype: got "+str(rt_htype)+" want 1")
        exit(1)
    let rt_ptype = dec1["ptype"]
    if rt_ptype != 0x0800
        print("FAIL arppkt rt ptype: got "+str(rt_ptype)+" want 2048")
        exit(1)
    let rt_hlen = dec1["hlen"]
    if rt_hlen != 6
        print("FAIL arppkt rt hlen: got "+str(rt_hlen)+" want 6")
        exit(1)
    let rt_plen = dec1["plen"]
    if rt_plen != 4
        print("FAIL arppkt rt plen: got "+str(rt_plen)+" want 4")
        exit(1)
    let rt_oper = dec1["oper"]
    if rt_oper != 1
        print("FAIL arppkt rt oper: got "+str(rt_oper)+" want 1")
        exit(1)
    let rt_spa = dec1["spa"]
    if rt_spa != 0xC0A80001
        print("FAIL arppkt rt spa: got "+str(rt_spa)+" want 3232235521")
        exit(1)
    let rt_tpa = dec1["tpa"]
    if rt_tpa != 0xC0A800C7
        print("FAIL arppkt rt tpa: got "+str(rt_tpa)+" want 3232235719")
        exit(1)
    let rt_sha = dec1["sha"]
    let rt_sha0 = bytes_get(rt_sha, 0)
    if rt_sha0 != 0xDE
        print("FAIL arppkt rt sha[0]: got "+str(rt_sha0)+" want 222")
        exit(1)
    let rt_sha3 = bytes_get(rt_sha, 3)
    if rt_sha3 != 0xEF
        print("FAIL arppkt rt sha[3]: got "+str(rt_sha3)+" want 239")
        exit(1)
    let rt_sha5 = bytes_get(rt_sha, 5)
    if rt_sha5 != 0x01
        print("FAIL arppkt rt sha[5]: got "+str(rt_sha5)+" want 1")
        exit(1)
    0

fn _check_reply(sha1)
    let sha2 = bytes(6)
    bytes_set(sha2, 0, 0xAA)
    bytes_set(sha2, 1, 0xBB)
    bytes_set(sha2, 2, 0xCC)
    bytes_set(sha2, 3, 0xDD)
    bytes_set(sha2, 4, 0xEE)
    bytes_set(sha2, 5, 0xFF)
    let h2 = {"oper": 2, "sha": sha2, "spa": 0xC0A800C7, "tha": sha1, "tpa": 0xC0A80001}
    let enc2 = arp_encode(h2)
    let enc2_len = bytes_len(enc2)
    if enc2_len != 28
        print("FAIL arppkt reply len: got "+str(enc2_len)+" want 28")
        exit(1)
    let e2b6 = bytes_get(enc2, 6)
    if e2b6 != 0
        print("FAIL arppkt reply oper-hi: got "+str(e2b6)+" want 0")
        exit(1)
    let e2b7 = bytes_get(enc2, 7)
    if e2b7 != 2
        print("FAIL arppkt reply oper-lo: got "+str(e2b7)+" want 2")
        exit(1)
    let dec2 = arp_decode(enc2)
    let dec2_oper = dec2["oper"]
    if dec2_oper != 2
        print("FAIL arppkt reply rt oper: got "+str(dec2_oper)+" want 2")
        exit(1)
    let dec2_tha = dec2["tha"]
    let dec2_tha0 = bytes_get(dec2_tha, 0)
    if dec2_tha0 != 0xDE
        print("FAIL arppkt reply rt tha[0]: got "+str(dec2_tha0)+" want 222")
        exit(1)
    0

fn main()
    // ── Build known SHA (sender MAC): DE:AD:BE:EF:00:01 ─────────────────────────
    let sha1 = bytes(6)
    bytes_set(sha1, 0, 0xDE)
    bytes_set(sha1, 1, 0xAD)
    bytes_set(sha1, 2, 0xBE)
    bytes_set(sha1, 3, 0xEF)
    bytes_set(sha1, 4, 0x00)
    bytes_set(sha1, 5, 0x01)

    // Vector 1: byte-exact encode checks; also returns enc1 for round-trip
    let enc1 = _check_v1(sha1)

    // Vector 2: encode->decode round-trip
    _check_rt(enc1)

    // Vector 3: ARP REPLY
    _check_reply(sha1)

    // Vector 4: short input returns empty dict
    let short_b = bytes(10)
    let dec_short = arp_decode(short_b)
    if contains(dec_short, "htype")
        print("FAIL arppkt short-decode: expected empty but got htype key")
        exit(1)

    // Vector 5: exactly 27 bytes (one short) returns empty dict
    let b27z = bytes(27)
    let dec27 = arp_decode(b27z)
    if contains(dec27, "oper")
        print("FAIL arppkt 27-byte-decode: expected empty but got oper key")
        exit(1)

    // Vector 6: empty bytes returns empty dict
    let empty_b = bytes(0)
    let dec_empty = arp_decode(empty_b)
    if contains(dec_empty, "sha")
        print("FAIL arppkt empty-decode: expected empty but got sha key")
        exit(1)

    // Vector 7: missing dict keys default to 0 in encode
    let h_min = {"oper": 1}
    let enc_min = arp_encode(h_min)
    let min_len = bytes_len(enc_min)
    if min_len != 28
        print("FAIL arppkt minimal encode-len: got "+str(min_len)+" want 28")
        exit(1)
    let min_ht = bytes_get(enc_min, 1)
    if min_ht != 1
        print("FAIL arppkt minimal htype: got "+str(min_ht)+" want 1")
        exit(1)
    let min_spa0 = bytes_get(enc_min, 14)
    if min_spa0 != 0
        print("FAIL arppkt minimal spa: got "+str(min_spa0)+" want 0")
        exit(1)

    print("PASS _arppkt_test")
