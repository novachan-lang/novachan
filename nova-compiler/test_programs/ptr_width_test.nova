// Typed-width raw memory: read/write a value at its NATIVE byte width.
// The bare ptr_read/ptr_write are i64-only (8 bytes) -> reading a narrow trailing field is an
// out-of-bounds 8-byte over-read. These access exactly the width and are memcpy-based (unaligned-safe).
// (#4) the raw-memory region is now inside an `unsafe` block; offheap_* below is safe (bounds-checked).

unsafe
    p = alloc_raw(64)
    if p == 0
        print("FAIL alloc_raw")
        exit(1)

    // --- unsigned widths round-trip ---
    ptr_write_u8(p, 171)                                  // 0xAB
    if ptr_read_u8(p) != 171
        print("FAIL u8")
        exit(1)
    ptr_write_u16(ptr_add(p, 2), 48879)                   // 0xBEEF
    if ptr_read_u16(ptr_add(p, 2)) != 48879
        print("FAIL u16")
        exit(1)
    ptr_write_u32(ptr_add(p, 4), 3735928559)              // 0xDEADBEEF
    if ptr_read_u32(ptr_add(p, 4)) != 3735928559
        print("FAIL u32")
        exit(1)
    ptr_write_u64(ptr_add(p, 8), 81985529216486895)       // 0x0123456789ABCDEF
    if ptr_read_u64(ptr_add(p, 8)) != 81985529216486895
        print("FAIL u64")
        exit(1)

    // --- signed reads sign-extend; unsigned reads zero-extend, SAME bytes ---
    ptr_write_u16(ptr_add(p, 16), 65535)                  // 0xFFFF
    if ptr_read_i16(ptr_add(p, 16)) != -1
        print("FAIL i16 sign-extend")
        exit(1)
    if ptr_read_u16(ptr_add(p, 16)) != 65535
        print("FAIL u16 zero-extend")
        exit(1)
    ptr_write_u8(ptr_add(p, 18), 255)                     // 0xFF
    if ptr_read_i8(ptr_add(p, 18)) != -1
        print("FAIL i8 sign-extend")
        exit(1)
    ptr_write_u32(ptr_add(p, 20), 4294967295)             // 0xFFFFFFFF
    if ptr_read_i32(ptr_add(p, 20)) != -1
        print("FAIL i32 sign-extend")
        exit(1)

    // --- NATIVE-WIDTH BOUNDARY (the soundness proof): two adjacent u32 in 8 bytes.
    //     Each read must touch EXACTLY 4 bytes; an 8-byte over-read would corrupt the result. ---
    ptr_write_u32(ptr_add(p, 24), 2863311530)             // 0xAAAAAAAA
    ptr_write_u32(ptr_add(p, 28), 3149642683)             // 0xBBBBBBBB
    if ptr_read_u32(ptr_add(p, 24)) != 2863311530
        print("FAIL boundary lo (8-byte over-read?)")
        exit(1)
    if ptr_read_u32(ptr_add(p, 28)) != 3149642683
        print("FAIL boundary hi")
        exit(1)

    // --- UNALIGNED u32 at an ODD offset (real wire-buffer scenario; memcpy-safe) ---
    ptr_write_u32(ptr_add(p, 33), 305419896)              // 0x12345678
    if ptr_read_u32(ptr_add(p, 33)) != 305419896
        print("FAIL unaligned u32")
        exit(1)

    // --- float round-trips (bit-exact via memcpy; values exact in f64/f32) ---
    ptr_write_f64(ptr_add(p, 40), 2.5)
    if ptr_read_f64(ptr_add(p, 40)) != 2.5
        print("FAIL f64 roundtrip")
        exit(1)
    ptr_write_f32(ptr_add(p, 48), 1.25)
    if ptr_read_f32(ptr_add(p, 48)) != 1.25
        print("FAIL f32 roundtrip")
        exit(1)

    // --- UFCS method form ---
    if ptr_add(p, 4).ptr_read_u32() != 3735928559
        print("FAIL UFCS ptr_read_u32")
        exit(1)

    free_raw(p)

// --- typed offheap f64 view (byte offset, bounds-checked) --- (safe: NOT a raw primitive)
h = offheap_create(64)
offheap_set_f64(h, 0, 6.5)
offheap_set_f64(h, 8, 7.25)
if offheap_get_f64(h, 0) != 6.5
    print("FAIL offheap f64 at 0")
    exit(1)
if offheap_get_f64(h, 8) != 7.25
    print("FAIL offheap f64 at 8")
    exit(1)
// OOB-safe: offset 60 (+8 > 64) -> 0, must NOT crash
if offheap_get_f64(h, 60) != 0
    print("FAIL offheap OOB guard")
    exit(1)
offheap_free(h)

print("ptr_width PASS")
