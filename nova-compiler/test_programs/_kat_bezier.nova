import forge_bezier

fn ap(a: float, b: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    d < 0.0001
fn tf(b: bool) -> string
    if b
        return "T"
    "F"

fn main()
    let p0 = [0.0, 0.0]
    let p1 = [1.0, 2.0]
    let p2 = [2.0, 0.0]
    // quad endpoints + midpoint: t=0.5 -> [1,1]
    let q0 = bezier_quad(p0, p1, p2, 0.0)
    let q1 = bezier_quad(p0, p1, p2, 1.0)
    let qh = bezier_quad(p0, p1, p2, 0.5)
    print("quad_t0=" + tf(ap(q0[0], 0.0) and ap(q0[1], 0.0)))
    print("quad_t1=" + tf(ap(q1[0], 2.0) and ap(q1[1], 0.0)))
    print("quad_half=" + tf(ap(qh[0], 1.0) and ap(qh[1], 1.0)))
    // cubic p0=[0,0] p1=[0,1] p2=[1,1] p3=[1,0]; t=0.5 -> [0.5, 0.75]
    let c0 = [0.0, 0.0]
    let c1 = [0.0, 1.0]
    let c2 = [1.0, 1.0]
    let c3 = [1.0, 0.0]
    let ch = bezier_cubic(c0, c1, c2, c3, 0.5)
    print("cubic_t0=" + tf(ap(bezier_cubic(c0, c1, c2, c3, 0.0)[0], 0.0)))
    print("cubic_t1=" + tf(ap(bezier_cubic(c0, c1, c2, c3, 1.0)[0], 1.0)))
    print("cubic_half=" + tf(ap(ch[0], 0.5) and ap(ch[1], 0.75)))
    // path sampling: n points, first==P0, last==P3
    let path = bezier_cubic_path(c0, c1, c2, c3, 5)
    print("path_len=" + tf(len(path) == 5))
    print("path_first=" + tf(ap(path[0][0], 0.0) and ap(path[0][1], 0.0)))
    print("path_last=" + tf(ap(path[4][0], 1.0) and ap(path[4][1], 0.0)))
