import std/collections/indexedpq

fn cki(label, got, want)
    if got != want
        print("FAIL _indexedpq_test " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // KAT 1: basic insert + pop order with decrease-key
    // insert(0,5), insert(1,3), insert(2,8), decrease_key(2,1)
    // Expected pop order: 2 (prio 1), 1 (prio 3), 0 (prio 5)
    let pq = ipq_new()
    ipq_insert(pq, 0, 5)
    ipq_insert(pq, 1, 3)
    ipq_insert(pq, 2, 8)
    ipq_decrease_key(pq, 2, 1)

    let p1 = ipq_pop_min(pq)
    cki("pop1", p1, 2)

    let p2 = ipq_pop_min(pq)
    cki("pop2", p2, 1)

    let p3 = ipq_pop_min(pq)
    cki("pop3", p3, 0)

    // KAT 2: pop on empty returns null
    let p4 = ipq_pop_min(pq)
    if p4 != null
        print("FAIL _indexedpq_test pop_empty_null: got " + str(p4) + " want null")
        exit(1)

    // KAT 3: ipq_contains after pop is false (0)
    cki("contains_after_pop", ipq_contains(pq, 2), 0)
    cki("contains_after_pop2", ipq_contains(pq, 1), 0)
    cki("contains_after_pop3", ipq_contains(pq, 0), 0)

    // KAT 4: fresh queue — contains on never-inserted idx is 0
    let pq2 = ipq_new()
    cki("contains_never_inserted", ipq_contains(pq2, 99), 0)

    // KAT 5: single element insert + pop
    let pq3 = ipq_new()
    ipq_insert(pq3, 7, 42)
    cki("contains_present", ipq_contains(pq3, 7), 1)
    let mn = ipq_min_priority(pq3)
    cki("min_prio_single", mn, 42)
    let pp = ipq_pop_min(pq3)
    cki("pop_single", pp, 7)
    cki("contains_after_single_pop", ipq_contains(pq3, 7), 0)
    let empty_min = ipq_min_priority(pq3)
    cki("min_prio_empty", empty_min, -1)

    // KAT 6: duplicates — same priority different indices
    let pq4 = ipq_new()
    ipq_insert(pq4, 10, 5)
    ipq_insert(pq4, 20, 5)
    ipq_insert(pq4, 30, 5)
    // All same priority — pop order depends on insertion/heap structure but all must emerge
    let d1 = ipq_pop_min(pq4)
    let d2 = ipq_pop_min(pq4)
    let d3 = ipq_pop_min(pq4)
    // Just verify all three indices came out (sum should be 60)
    let dsum = d1 + d2 + d3
    cki("dup_sum", dsum, 60)

    // KAT 7: decrease-key to same value (no-op decrease, valid call)
    let pq5 = ipq_new()
    ipq_insert(pq5, 0, 10)
    ipq_insert(pq5, 1, 20)
    ipq_decrease_key(pq5, 1, 20)
    let e1 = ipq_pop_min(pq5)
    cki("no_op_decrease_pop1", e1, 0)
    let e2 = ipq_pop_min(pq5)
    cki("no_op_decrease_pop2", e2, 1)

    // KAT 8: decrease-key makes element become minimum
    let pq6 = ipq_new()
    ipq_insert(pq6, 0, 100)
    ipq_insert(pq6, 1, 200)
    ipq_insert(pq6, 2, 300)
    let before_mn = ipq_min_priority(pq6)
    cki("min_before_dk", before_mn, 100)
    ipq_decrease_key(pq6, 2, 1)
    let after_mn = ipq_min_priority(pq6)
    cki("min_after_dk", after_mn, 1)
    let f1 = ipq_pop_min(pq6)
    cki("dk_became_min", f1, 2)

    // KAT 9: ipq_contains returns 1 for present element mid-queue
    let pq7 = ipq_new()
    ipq_insert(pq7, 5, 10)
    ipq_insert(pq7, 6, 20)
    cki("contains_mid1", ipq_contains(pq7, 5), 1)
    cki("contains_mid2", ipq_contains(pq7, 6), 1)
    ipq_pop_min(pq7)
    cki("contains_after_first_pop", ipq_contains(pq7, 5), 0)
    cki("contains_remaining", ipq_contains(pq7, 6), 1)

    print("PASS _indexedpq_test")
