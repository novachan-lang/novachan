// ADVERSARIAL PROBE: when `?` inside a map/comprehension lambda FAILS,
// does the error propagate out of the enclosing fn, or is it SWALLOWED?
// A swallowed error = silent data corruption = worse than a hand-rolled loop.

fn mk(s: string) -> Result<string>
    if len(s) == 0
        return err("REJECTED_EMPTY")
    ok("<" + s + ">")

// E1 — `?` in a map lambda, second element fails
fn e1() -> Result<list>
    let rs = ["a", "", "c"].map(fn(s) mk(s)?)
    ok(rs)

// E2 — `?` in a comprehension, second element fails
fn e2() -> Result<list>
    let xs = [mk(s)? for s in ["a", "", "c"]]
    ok(xs)

// E3 — FIRST element fails (does it even run?)
fn e3() -> Result<list>
    let xs = [mk(s)? for s in ["", "b"]]
    ok(xs)

// E4 — the known-good baseline: explicit collect loop
fn e4() -> Result<list>
    let out = []
    for s in ["a", "", "c"]
        out.push(mk(s)?)
    ok(out)

fn report(name: string, r: Result<list>)
    if is_ok(r)
        let l = unwrap(r)
        print("{name}: is_ok=TRUE len={len(l)}  <-- did the error VANISH?")
        for i, v in l
            print("    [{i}] = {v}")
    else
        print("{name}: is_err=true  err={unwrap_err(r)}  <-- correctly propagated")

fn main()
    print("== ADVERSARIAL PROBE: does ? in a lambda propagate errors? ==")
    report("E1 map+?      ", e1())
    report("E2 comprehen+?", e2())
    report("E3 first-fails", e3())
    report("E4 loop (base)", e4())
    print("== DONE ==")
