import forge_metric_histogram

fn main()
    let h = hist_new(10, 5)
    assert(hist_bucket_count(h) == 5, "5 buckets")

    h = hist_record(h, 5)
    h = hist_record(h, 15)
    h = hist_record(h, 25)
    h = hist_record(h, 35)
    h = hist_record(h, 55)
    assert(hist_total_samples(h) == 5, "5 samples")
    assert(hist_total_sum(h) == 135, "sum=135")

    let b0 = hist_bucket(h, 0)
    assert(is_ok(b0), "bucket 0 ok")
    assert(unwrap(b0) == 1, "bucket 0=1")

    let b1 = hist_bucket(h, 1)
    assert(unwrap(b1) == 1, "bucket 1=1")

    assert(hist_overflow(h) == 1, "1 overflow (55)")

    let avg = hist_mean(h)
    assert(is_ok(avg), "mean ok")
    assert(unwrap(avg) == 27, "mean=27")

    let bad = hist_bucket(h, 10)
    assert(is_err(bad), "out of range")

    print("METRIC-HISTOGRAM KAT PASS")
