import std/greedy/gas_station

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _gas_station_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL _gas_station_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(label: string, got: list, want: list)
    cki(label + ".len", len(got), len(want))
    let i = 0
    while i < len(want)
        cki(label + "[" + str(i) + "]", got[i], want[i])
        i = i + 1

fn main()
    // KAT 1: gs_start_index([1,2,3,4,5],[3,4,5,1,2])=3
    // net=[-2,-2,-2,3,3], total=0 -> possible
    // Greedy: i=0 tank=-2<0 start=1,tank=0; i=1 tank=-2<0 start=2,tank=0;
    //         i=2 tank=-2<0 start=3,tank=0; i=3 tank=3>=0; i=4 tank=6>=0
    // start=3
    let g1 = [1, 2, 3, 4, 5]
    let c1 = [3, 4, 5, 1, 2]
    cki("start_3", gs_start_index(g1, c1), 3)
    ckb("can_1", gs_can_complete(g1, c1), true)

    // KAT 2: gs_start_index([2,3,4],[3,4,3])=-1
    // net=[-1,-1,1], total=-1 < 0 -> impossible
    let g2 = [2, 3, 4]
    let c2 = [3, 4, 3]
    cki("start_impossible", gs_start_index(g2, c2), -1)
    ckb("can_2", gs_can_complete(g2, c2), false)

    // KAT 3: gs_start_index([5,1,2,3,4],[4,4,1,5,1])=4
    // net=[1,-3,1,-2,3], total=0 -> possible
    // Greedy: i=0 tank=1>=0; i=1 tank=-2<0 start=2,tank=0; i=2 tank=1>=0;
    //         i=3 tank=-1<0 start=4,tank=0; i=4 tank=3>=0
    // start=4
    let g3 = [5, 1, 2, 3, 4]
    let c3 = [4, 4, 1, 5, 1]
    cki("start_4", gs_start_index(g3, c3), 4)
    ckb("can_3", gs_can_complete(g3, c3), true)

    // KAT 4: empty arrays -> -1 and false
    let g4 = []
    let c4 = []
    cki("start_empty", gs_start_index(g4, c4), -1)
    ckb("can_empty", gs_can_complete(g4, c4), false)

    // KAT 5: single station, gas >= cost -> start=0
    let g5 = [3]
    let c5 = [3]
    cki("start_single_eq", gs_start_index(g5, c5), 0)
    ckb("can_single_eq", gs_can_complete(g5, c5), true)

    // KAT 6: single station, gas < cost -> -1
    let g6 = [2]
    let c6 = [5]
    cki("start_single_fail", gs_start_index(g6, c6), -1)
    ckb("can_single_fail", gs_can_complete(g6, c6), false)

    // KAT 7: start index is 0 (first station works)
    // gas=[5,0], cost=[1,4]: net=[4,-4] total=0 -> possible
    // Greedy: i=0 tank=4>=0; i=1 tank=0>=0 -> start=0
    let g7 = [5, 0]
    let c7 = [1, 4]
    cki("start_0", gs_start_index(g7, c7), 0)
    ckb("can_7", gs_can_complete(g7, c7), true)

    // KAT 8: all stations surplus -> can complete from 0
    // gas=[4,4,4], cost=[1,1,1]: total=9>0 -> possible, greedy never resets -> start=0
    let g8 = [4, 4, 4]
    let c8 = [1, 1, 1]
    cki("start_all_surplus", gs_start_index(g8, c8), 0)
    ckb("can_all_surplus", gs_can_complete(g8, c8), true)

    // KAT 9: large deficit at end, unique start in middle
    // gas=[1,2,3,4,5,6], cost=[2,4,5,1,1,2]: net=[-1,-2,-2,3,4,4] total=6>0
    // Greedy: i=0 tank=-1<0 start=1,tank=0; i=1 tank=-2<0 start=2,tank=0;
    //         i=2 tank=-2<0 start=3,tank=0; i=3 tank=3>=0; i=4 tank=7>=0; i=5 tank=11>=0
    // start=3
    let g9 = [1, 2, 3, 4, 5, 6]
    let c9 = [2, 4, 5, 1, 1, 2]
    cki("start_3_large", gs_start_index(g9, c9), 3)
    ckb("can_9", gs_can_complete(g9, c9), true)

    print("PASS _gas_station_test")
