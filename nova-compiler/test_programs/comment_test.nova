// Single line comment

/* Simple multi-line comment */

/*
  Multi-line
  spanning
  several lines
*/

/* Nested /* inner comment */ outer still going */

fn add(a: int, b: int) -> int
    /* inline block comment */ a + b

fn main()
    // single line
    let x = 10 /* inline */ + 20
    print(x)
    print(add(3, 4))

    /*
      Test that line numbers
      are tracked correctly
      after multi-line comments
    */
    let y = 100
    print(y)
    print("COMMENT TESTS PASSED")
