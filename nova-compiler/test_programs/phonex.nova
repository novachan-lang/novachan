fn _soundex_code(ch)
  let c = upper(ch)
  if c == "B" or c == "F" or c == "P" or c == "V"
    return "1"
  if c == "C" or c == "G" or c == "J" or c == "K" or c == "Q" or c == "S" or c == "X" or c == "Z"
    return "2"
  if c == "D" or c == "T"
    return "3"
  if c == "L"
    return "4"
  if c == "M" or c == "N"
    return "5"
  if c == "R"
    return "6"
  "0"

fn soundex(name)
  if len(name) == 0
    return "0000"
  let result = upper(slice(name, 0, 1))
  let prev_code = _soundex_code(slice(name, 0, 1))
  let i = 1
  while i < len(name) and len(result) < 4
    let ch = slice(name, i, i + 1)
    let code = _soundex_code(ch)
    if code != "0" and code != prev_code
      result = result + code
    prev_code = code
    i = i + 1
  while len(result) < 4
    result = result + "0"
  result

fn sounds_like(a, b)
  soundex(a) == soundex(b)

fn main()
  assert(soundex("Robert") == "R163", "Robert")
  assert(soundex("Rupert") == "R163", "Rupert = Robert")
  assert(sounds_like("Robert", "Rupert") == 1, "Robert ~ Rupert")

  assert(soundex("Smith") == "S530", "Smith")
  assert(soundex("Smythe") == "S530", "Smythe = Smith")
  assert(sounds_like("Smith", "Smythe") == 1, "Smith ~ Smythe")

  let ac = soundex("Ashcraft")
  assert(len(ac) == 4, "Ashcraft len 4")

  assert(sounds_like("Alice", "Bob") == 0, "Alice != Bob")

  assert(soundex("") == "0000", "empty")
  assert(soundex("A") == "A000", "single char")

  print("phonex: all passed")
