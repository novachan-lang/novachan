// LOCK-4 inc3b CRASH-REGRESSION — a sized literal inside a LOOP.
// A while-loop triggers the compiler's s4 loop pass, which GENERICALLY walks Expr.fields
// (s4_e_ok / s4_rename_e do `for f in e.fields` and treat each element as a child Expr).
// inc3b originally stored the width suffix as a STRING in that fields list -> the s4 pass
// dereferenced it as an Expr -> compiler SEGFAULT (0xC0000005) on any sized literal in a
// loop. The fix rides the suffix on the value string instead. This KAT MUST compile (no
// crash) AND wrap correctly (the literal operand `100u8`/`50u8` carries the width).
fn main() -> int
    let ok = true
    // sized var reassigned in a loop: each `acc + 100u8` wraps at u8 (width from the literal)
    let acc = 0u8
    let i = 0
    while i < 3
        acc = acc + 100u8
        i = i + 1
    // 0 -> 100 -> 200 -> (300 & 255) = 44
    if acc != 44
        print("  FAIL loop acc got " + str(acc) + " want 44")
        ok = false
    else
        print("  ok loop acc = 44")
    // nested loops (deeper s4 exercise): 6 * 50 = 300 -> 44
    let s = 0u8
    let a = 0
    while a < 2
        let b = 0
        while b < 3
            s = s + 50u8
            b = b + 1
        a = a + 1
    if s != 44
        print("  FAIL nested s got " + str(s) + " want 44")
        ok = false
    else
        print("  ok nested s = 44")
    if ok
        print("L7-LOOP KAT PASS")
        return 0
    print("L7-LOOP KAT FAIL")
    1
