import "std/collections/pairingheap"

// Helper assertions
fn cki(got, expected, label)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)
    return 0

fn cks(got, expected, label)
    if got != expected
        print("FAIL " + label + ": got " + got + " expected " + expected)
        exit(1)
    return 0

// KAT 1: basic construction and find_min after multiple inserts
let h = ph_new()
ph_insert(h, 5)
ph_insert(h, 3)
ph_insert(h, 8)
ph_insert(h, 1)
ph_insert(h, 9)
ph_insert(h, 2)

cki(ph_find_min(h), 1, "find_min after 6 inserts")
cki(ph_size(h), 6, "size after 6 inserts")
cki(ph_is_empty(h), 0, "is_empty after inserts")

// KAT 2: delete_min extracts elements in sorted order
let d1 = ph_delete_min(h)
cki(d1, 1, "delete_min #1 == 1")
cki(ph_find_min(h), 2, "find_min after first delete == 2")

let d2 = ph_delete_min(h)
cki(d2, 2, "delete_min #2 == 2")

let d3 = ph_delete_min(h)
cki(d3, 3, "delete_min #3 == 3")

// KAT 3: state after 3 deletes
cki(ph_is_empty(h), 0, "is_empty after 3 deletes == false")
cki(ph_size(h), 3, "size after 3 deletes == 3")

// KAT 4: remaining elements come out in sorted order
let d4 = ph_delete_min(h)
cki(d4, 5, "delete_min #4 == 5")

let d5 = ph_delete_min(h)
cki(d5, 8, "delete_min #5 == 8")

let d6 = ph_delete_min(h)
cki(d6, 9, "delete_min #6 == 9")

cki(ph_is_empty(h), 1, "is_empty after all deletes == true")
cki(ph_size(h), 0, "size after all deletes == 0")

// KAT 5: single element heap
let h2 = ph_new()
ph_insert(h2, 42)
cki(ph_size(h2), 1, "single elem size")
cki(ph_find_min(h2), 42, "single elem find_min")
cki(ph_is_empty(h2), 0, "single elem not empty")
let ds = ph_delete_min(h2)
cki(ds, 42, "single elem delete_min")
cki(ph_is_empty(h2), 1, "single elem empty after delete")

// KAT 6: insert duplicates and negative values
let h3 = ph_new()
ph_insert(h3, 10)
ph_insert(h3, -5)
ph_insert(h3, 10)
ph_insert(h3, 0)
ph_insert(h3, -5)
cki(ph_size(h3), 5, "dup+neg size == 5")
cki(ph_find_min(h3), -5, "dup+neg find_min == -5")
let dn1 = ph_delete_min(h3)
cki(dn1, -5, "dup+neg del1 == -5")
let dn2 = ph_delete_min(h3)
cki(dn2, -5, "dup+neg del2 == -5")
let dn3 = ph_delete_min(h3)
cki(dn3, 0, "dup+neg del3 == 0")
cki(ph_size(h3), 2, "dup+neg size after 3 dels == 2")

print("_pairingheap_test passed")
