import std/text/commonprefix

// KAT 1: classic prefix-shrinking case
let r1 = cp_longest(["flower", "flow", "flight"])
if r1 != "fl"
    print("FAIL KAT1: expected 'fl' got '" + r1 + "'")
    exit(1)

// KAT 2: no common prefix at all
let r2 = cp_longest(["dog", "cat"])
if r2 != ""
    print("FAIL KAT2: expected '' got '" + r2 + "'")
    exit(1)

// KAT 3: single-element list returns that element
let r3 = cp_longest(["abc"])
if r3 != "abc"
    print("FAIL KAT3: expected 'abc' got '" + r3 + "'")
    exit(1)

// KAT 4: empty list returns ""
let r4 = cp_longest([])
if r4 != ""
    print("FAIL KAT4: expected '' got '" + r4 + "'")
    exit(1)

// KAT 5: cp_longest_pair direct call
let r5 = cp_longest_pair("abcdef", "abcxyz")
if r5 != "abc"
    print("FAIL KAT5: expected 'abc' got '" + r5 + "'")
    exit(1)

// KAT 6: common suffix
let r6 = cp_longest_suffix(["running", "jumping", "swimming"])
if r6 != "ing"
    print("FAIL KAT6: expected 'ing' got '" + r6 + "'")
    exit(1)

// KAT 7: prefix where one element is a prefix of another
let r7 = cp_longest(["prefix", "pre", "prefixation"])
if r7 != "pre"
    print("FAIL KAT7: expected 'pre' got '" + r7 + "'")
    exit(1)

// KAT 8: identical strings — full string is the prefix
let r8 = cp_longest_pair("hello", "hello")
if r8 != "hello"
    print("FAIL KAT8: expected 'hello' got '" + r8 + "'")
    exit(1)

// KAT 9: suffix with no common suffix
let r9 = cp_longest_suffix(["abc", "xyz"])
if r9 != ""
    print("FAIL KAT9: expected '' got '" + r9 + "'")
    exit(1)

// KAT 10: suffix with single-character common suffix
let r10 = cp_longest_suffix(["cat", "bat", "rat"])
if r10 != "at"
    print("FAIL KAT10: expected 'at' got '" + r10 + "'")
    exit(1)

print("_commonprefix_test passed")
