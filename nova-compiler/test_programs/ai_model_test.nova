// Real AI model loader + inference, written in NOVA over the real tensor ops.
// Loads weights from a file (real file I/O), builds a tensor, runs a real forward pass.
// Oracle values are hand-computed.

fn load_matrix(path: string)
    let content = read_file(path)
    let lines = split(content, "\n")
    let dims = split(lines[0], " ")
    let rows = parse_int(dims[0])
    let cols = parse_int(dims[1])
    let flat = []
    let r = 1
    while r <= rows
        let vals = split(lines[r], " ")
        for v in vals
            if len(v) > 0
                flat.push(parse_float(v))
        r = r + 1
    tensor_from_list(flat, [rows, cols])

fn main()
    // Persist a tiny model (2x3 weight matrix) to disk, then load it back.
    write_file("model_w.txt", "2 3\n1.0 0.0 1.0\n0.0 1.0 1.0\n")
    let w = load_matrix("model_w.txt")

    // input x = [3, 4]  (1x2)
    let x = tensor_from_list([3.0, 4.0], [1, 2])
    let out = tensor_matmul(x, w)
    // x @ W = [3*1+4*0, 3*0+4*1, 3*1+4*1] = [3, 4, 7]  (hand-computed)
    assert_near(tensor_get(out, [0, 0]), 3.0, 0.001)
    assert_near(tensor_get(out, [0, 1]), 4.0, 0.001)
    assert_near(tensor_get(out, [0, 2]), 7.0, 0.001)

    print("AI model load + inference oracle test passed")
