import std/units/mass

// Float approximate equality with tolerance.
fn approx(a: float, b: float, tol: float) -> int
    let diff = a - b
    let adiff = diff
    if diff < 0.0
        adiff = 0.0 - diff
    let ok = 1
    if adiff > tol
        ok = 0
    ok

fn ckf(label: string, got: float, want: float, tol: float)
    let ok = approx(got, want, tol)
    if ok == 0
        print("FAIL mass " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL mass " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // mass_convert(1.0,'kg','g') == 1000.0
    let v1 = mass_convert(1.0, "kg", "g")
    ckf("kg_to_g", v1, 1000.0, 0.0001)

    // mass_convert(1.0,'lb','kg') == 0.45359237
    let v2 = mass_convert(1.0, "lb", "kg")
    ckf("lb_to_kg", v2, 0.45359237, 0.0000001)

    // mass_convert(1.0,'lb','oz') == 16.0 (1 lb = 16 oz exactly)
    let v3 = mass_convert(1.0, "lb", "oz")
    ckf("lb_to_oz", v3, 16.0, 0.001)

    // mass_convert(1.0,'t','kg') == 1000.0
    let v4 = mass_convert(1.0, "t", "kg")
    ckf("t_to_kg", v4, 1000.0, 0.0001)

    // round-trip: from_base(to_base(2.5,'lb'),'lb') approx 2.5
    let base5 = mass_to_base(2.5, "lb")
    let v5 = mass_from_base(base5, "lb")
    ckf("roundtrip_lb", v5, 2.5, 0.000001)

    // mass_factor('kg') == 1.0
    let f1 = mass_factor("kg")
    ckf("factor_kg", f1, 1.0, 0.0000001)

    // mass_factor('oz') == 0.028349523125
    let f2 = mass_factor("oz")
    ckf("factor_oz", f2, 0.028349523125, 0.0000000001)

    // mass_factor('ct') == 0.0002
    let f3 = mass_factor("ct")
    ckf("factor_ct", f3, 0.0002, 0.00000001)

    // mass_is_supported('lb') == 1
    let s1 = mass_is_supported("lb")
    cki("supported_lb", s1, 1)

    // mass_is_supported('xyz') == 0
    let s2 = mass_is_supported("xyz")
    cki("unsupported_xyz", s2, 0)

    // mass_units() has 8 entries
    let us = mass_units()
    let ulen = len(us)
    cki("units_count", ulen, 8)

    // stone roundtrip
    let base_st = mass_to_base(1.0, "st")
    ckf("st_to_base", base_st, 6.35029318, 0.0000001)
    let from_st = mass_from_base(6.35029318, "st")
    ckf("from_base_st", from_st, 1.0, 0.0000001)

    // mg roundtrip
    let base_mg = mass_to_base(1000000.0, "mg")
    ckf("mg_to_base_1kg", base_mg, 1.0, 0.0000001)

    // g -> t
    let v6 = mass_convert(1000000.0, "g", "t")
    ckf("g_to_t_1M", v6, 1.0, 0.0000001)

    print("PASS _mass_test")
