import std/time/humanize

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn main()
    cks("kat1",  hz_relative(5),       "just now")
    cks("kat2",  hz_relative(1),       "just now")
    cks("kat3",  hz_relative(90),      "1 minute ago")
    cks("kat4",  hz_relative(120),     "2 minutes ago")
    cks("kat5",  hz_relative(3600),    "1 hour ago")
    cks("kat6",  hz_relative(7200),    "2 hours ago")
    cks("kat7",  hz_relative(86400),   "1 day ago")
    cks("kat8",  hz_relative(-3600),   "in 1 hour")
    cks("kat9",  hz_relative(-172800), "in 2 days")
    cks("kat10", hz_relative(10),      "10 seconds ago")
    cks("kat11", hz_relative(59),      "59 seconds ago")
    cks("kat12", hz_relative(2592000), "1 month ago")
    cks("kat13", hz_relative(5184000), "2 months ago")
    cks("kat14", hz_relative(-60),     "in 1 minute")
    cks("kat15", hz_relative(-9),      "just now")
    print("_humanize_test passed")
