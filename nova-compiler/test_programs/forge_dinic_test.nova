import forge_dinic as dn

fn check(cond: bool, label: str)
    if cond == false
        print("FAIL: " + label)

// TEST 1: Classic small network (CLRS-style)
// Nodes 0..3. 0=source, 3=sink.
// 0->1 cap 3, 0->2 cap 2, 1->2 cap 1, 1->3 cap 2, 2->3 cap 3
// Max flow = 4? Let's compute: 0->1->3 (2), 0->2->3 (2), 0->1->2->3 (1 more? 0->1 has 1 left, 1->2 cap1, 2->3 has 1 left) = 1
// Total = 2 + 2 + ... 0->1 total 3: 2 to 3, 1 to 2; 0->2 total 2 to 3; so sink gets 2(from1) + 2(from2 direct) + 1(1->2->3) = 5? but 2->3 cap 3
// Let me just verify against known: max flow = 4? Actually recompute
// Capacities into sink: 1->3 cap2, 2->3 cap3, total 5 possible in.
// Out of source: 0->1 cap3, 0->2 cap2, total 5.
// 0->1(3): 1->3(2), 1->2(1). 0->2(2): 2->3. Node 2 in = 1(from1)+2(from0)=3, 2->3 cap3 OK.
// sink in = 2(1->3) + 3(2->3) = 5. Max flow = 5? Wait source out max = 5, all used. YES flow=5.
let edges1 = [[0, 1, 3], [0, 2, 2], [1, 2, 1], [1, 3, 2], [2, 3, 3]]
let f1 = dn.dinic_max_flow(4, edges1, 0, 3)
check(f1 == 5, "flow test1 = 5")

// TEST 2: Simple series 0->1->2, min of caps
let edges2 = [[0, 1, 10], [1, 2, 5]]
let f2 = dn.dinic_max_flow(3, edges2, 0, 2)
check(f2 == 5, "series flow = min(10,5) = 5")

// TEST 3: Two parallel paths
let edges3 = [[0, 1, 4], [1, 3, 4], [0, 2, 6], [2, 3, 6]]
let f3 = dn.dinic_max_flow(4, edges3, 0, 3)
check(f3 == 10, "parallel paths flow = 4 + 6 = 10")

// TEST 4: No path (disconnected)
let edges4 = [[0, 1, 5]]
let f4 = dn.dinic_max_flow(3, edges4, 0, 2)
check(f4 == 0, "disconnected sink flow = 0")

// TEST 5: Source == sink
let f5 = dn.dinic_max_flow(3, edges4, 0, 0)
check(f5 == 0, "source==sink flow = 0")

// TEST 6: Bottleneck in the middle
// 0->1 cap 100, 1->2 cap 1, 2->3 cap 100
let edges6 = [[0, 1, 100], [1, 2, 1], [2, 3, 100]]
let f6 = dn.dinic_max_flow(4, edges6, 0, 3)
check(f6 == 1, "bottleneck flow = 1")

// TEST 7: Classic max-flow example (Wikipedia Dinic's)
// 6 nodes: 0=s, 5=t
// s->1 (10), s->2 (10), 1->2 (2), 1->3 (4), 1->4 (8), 2->4 (9), 4->3 (6), 3->5 (10), 4->5 (10)
let edges7 = [[0, 1, 10], [0, 2, 10], [1, 2, 2], [1, 3, 4], [1, 4, 8], [2, 4, 9], [4, 3, 6], [3, 5, 10], [4, 5, 10]]
let f7 = dn.dinic_max_flow(6, edges7, 0, 5)
check(f7 == 19, "wikipedia Dinic example flow = 19")

// TEST 8: min cut - flow equals cut capacity
let mc = dn.dinic_min_cut(4, edges1, 0, 3)
check(mc[0] == 5, "min_cut flow = 5")
// source side should include node 0
let src_side = mc[1]
let has_source = false
let i = 0
while i < len(src_side)
    if src_side[i] == 0
        has_source = true
    i = i + 1
check(has_source, "min_cut source side includes source")

// TEST 9: Bipartite matching via max flow
// Left nodes {1,2,3}, right nodes {4,5,6}, source 0, sink 7
// Edges: 1-4, 1-5, 2-5, 3-6 (capacities 1)
// source->each left (cap1), each right->sink (cap1)
let edges9 = [[0, 1, 1], [0, 2, 1], [0, 3, 1], [1, 4, 1], [1, 5, 1], [2, 5, 1], [3, 6, 1], [4, 7, 1], [5, 7, 1], [6, 7, 1]]
let f9 = dn.dinic_max_flow(8, edges9, 0, 7)
// Max matching: 1-4, 2-5, 3-6 -> 3
check(f9 == 3, "bipartite matching = 3")

// TEST 10: DECISIVE cross-check against a brute-force / independent Edmonds-Karp-style flow
// Build several random-ish networks and compare Dinic's result to a simple max-flow computed here.
fn simple_max_flow(num_nodes: int, edges: list, source: int, sink: int) -> int
    // Build capacity matrix
    let cap = []
    let i = 0
    while i < num_nodes
        let row = []
        let j = 0
        while j < num_nodes
            push(row, 0)
            j = j + 1
        push(cap, row)
        i = i + 1
    let e = 0
    while e < len(edges)
        let u = edges[e][0]
        let v = edges[e][1]
        let c = edges[e][2]
        cap[u][v] = cap[u][v] + c
        e = e + 1
    let total = 0
    let running = true
    while running
        // BFS for augmenting path
        let parent = []
        let k = 0
        while k < num_nodes
            push(parent, 0 - 1)
            k = k + 1
        parent[source] = source
        let queue = []
        push(queue, source)
        let qi = 0
        let found = false
        while qi < len(queue) and found == false
            let u = queue[qi]
            qi = qi + 1
            let v = 0
            while v < num_nodes
                if parent[v] < 0 and cap[u][v] > 0
                    parent[v] = u
                    if v == sink
                        found = true
                    push(queue, v)
                v = v + 1
        if found == false
            running = false
        else
            // bottleneck
            let bn = 1000000000000
            let node = sink
            while node != source
                let p = parent[node]
                if cap[p][node] < bn
                    bn = cap[p][node]
                node = p
            let node2 = sink
            while node2 != source
                let p = parent[node2]
                cap[p][node2] = cap[p][node2] - bn
                cap[node2][p] = cap[node2][p] + bn
                node2 = p
            total = total + bn
    return total

let networks = [[[0, 1, 3], [0, 2, 2], [1, 2, 1], [1, 3, 2], [2, 3, 3]], [[0, 1, 7], [1, 2, 4], [0, 2, 3], [2, 3, 8], [1, 3, 5]], [[0, 1, 5], [0, 2, 4], [1, 3, 3], [2, 3, 6], [1, 2, 2], [3, 4, 9], [2, 4, 1]], [[0, 1, 16], [0, 2, 13], [1, 2, 10], [2, 1, 4], [1, 3, 12], [3, 2, 9], [2, 4, 14], [4, 3, 7], [3, 5, 20], [4, 5, 4]]]
let nsizes = [4, 4, 5, 6]
let sinks = [3, 3, 4, 5]
let ok = true
let ni = 0
while ni < len(networks)
    let net = networks[ni]
    let nn = nsizes[ni]
    let sk = sinks[ni]
    let dinic_res = dn.dinic_max_flow(nn, net, 0, sk)
    let simple_res = simple_max_flow(nn, net, 0, sk)
    if dinic_res != simple_res
        ok = false
        print("MISMATCH net " + str(ni) + " dinic=" + str(dinic_res) + " simple=" + str(simple_res))
    ni = ni + 1
check(ok, "DECISIVE: Dinic matches independent max-flow on all networks")

// The famous CLRS network (last one) has known max flow = 23
let clrs = [[0, 1, 16], [0, 2, 13], [1, 2, 10], [2, 1, 4], [1, 3, 12], [3, 2, 9], [2, 4, 14], [4, 3, 7], [3, 5, 20], [4, 5, 4]]
let f_clrs = dn.dinic_max_flow(6, clrs, 0, 5)
check(f_clrs == 23, "CLRS network max flow = 23")

print("forge_dinic: KAT done")
