// KAT for the one-line `if <cond> then <stmt>` (optional `else <stmt>`) sugar.
// Exercises the sugar in helper fns + inline then/else, and confirms the block
// form still works (regression). Compiled by the reconverged gen5 (has the sugar).
fn classify(x: int) -> string
    if x > 0 then return "pos"
    if x < 0 then return "neg"
    return "zero"

fn absval(x: int) -> int
    if x < 0 then return 0 - x
    return x

fn main() -> int
    let fails = 0
    if classify(5) != "pos"
        print("FAIL pos")
        fails = fails + 1
    if classify(-3) != "neg"
        print("FAIL neg")
        fails = fails + 1
    if classify(0) != "zero"
        print("FAIL zero")
        fails = fails + 1
    if absval(-7) != 7
        print("FAIL absneg")
        fails = fails + 1
    if absval(4) != 4
        print("FAIL abspos")
        fails = fails + 1
    // inline then + else as statements
    let msg = ""
    let y = 10
    if y > 5 then msg = "big" else msg = "small"
    if msg != "big"
        print("FAIL inline_else_big")
        fails = fails + 1
    let z = 2
    if z > 5 then msg = "big" else msg = "small"
    if msg != "small"
        print("FAIL inline_else_small")
        fails = fails + 1
    // sugar then with NO else, condition false -> body skipped
    let n = 0
    if z > 5 then n = 99
    if n != 0
        print("FAIL noelse_skip")
        fails = fails + 1
    // block form still works (regression)
    let bf = 0
    if y > 5
        bf = 1
    else
        bf = 2
    if bf != 1
        print("FAIL blockform")
        fails = fails + 1
    if fails == 0
        print("PASS _if_then_sugar_kat")
    else
        print("FAILED _if_then_sugar_kat")
    return 0
