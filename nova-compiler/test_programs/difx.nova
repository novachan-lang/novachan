// difx.nova — sequence/line diff via Longest Common Subsequence, the NOVA way.
//
// A foundational tool: compute the minimal edit script between two sequences
// (lists of ints or strings/lines) as a list of [op, value] where op is
// "=" keep / "-" remove / "+" add. Powers version tooling, test-output
// comparison, and hot-reload state migration. Pure-NOVA, no new runtime.
// Uses a classic O(m*n) LCS DP table (flat-indexed to avoid nested index-set).

fn _lcs_table(a, b)
  let m = len(a)
  let n = len(b)
  let w = n + 1
  let dp = []
  let k = 0
  let total = (m + 1) * w
  while k < total
    push(dp, 0)
    k = k + 1
  let i = m - 1
  while i >= 0
    let j = n - 1
    while j >= 0
      if a[i] == b[j]
        dp[i * w + j] = dp[(i + 1) * w + (j + 1)] + 1
      else
        let down = dp[(i + 1) * w + j]
        let right = dp[i * w + (j + 1)]
        if down >= right
          dp[i * w + j] = down
        else
          dp[i * w + j] = right
      j = j - 1
    i = i - 1
  dp

// diff(a, b) -> list of [op, value]   (op: "=" | "-" | "+")
fn diff(a, b)
  let m = len(a)
  let n = len(b)
  let w = n + 1
  let dp = _lcs_table(a, b)
  let result = []
  let i = 0
  let j = 0
  while i < m and j < n
    if a[i] == b[j]
      push(result, ["=", a[i]])
      i = i + 1
      j = j + 1
    else
      let down = dp[(i + 1) * w + j]
      let right = dp[i * w + (j + 1)]
      if down >= right
        push(result, ["-", a[i]])
        i = i + 1
      else
        push(result, ["+", b[j]])
        j = j + 1
  while i < m
    push(result, ["-", a[i]])
    i = i + 1
  while j < n
    push(result, ["+", b[j]])
    j = j + 1
  result

// length of the LCS (the common-subsequence size).
fn lcs_len(a, b)
  let dp = _lcs_table(a, b)
  dp[0]

fn diff_stats(d)
  let added = 0
  let removed = 0
  let common = 0
  for entry in d
    let op = entry[0]
    if op == "+"
      added = added + 1
    else if op == "-"
      removed = removed + 1
    else
      common = common + 1
  let r = {}
  r["added"] = added
  r["removed"] = removed
  r["common"] = common
  r

// reconstruct `b` by applying the diff to `a` (keep/add emit, remove skips).
fn apply_diff(d)
  let out = []
  for entry in d
    let op = entry[0]
    if op == "=" or op == "+"
      push(out, entry[1])
  out

// ── Tests ────────────────────────────────────────────────────────────

// Test 1: int sequences.
let a1 = [1, 2, 3, 4]
let b1 = [1, 3, 4, 5]
let d1 = diff(a1, b1)
// expect: =1, -2, =3, =4, +5
let s1 = diff_stats(d1)
assert(s1["common"] == 3, "3 common (1,3,4)")
assert(s1["removed"] == 1, "1 removed (2)")
assert(s1["added"] == 1, "1 added (5)")
assert(lcs_len(a1, b1) == 3, "LCS length 3")
print("PASS: int diff stats")

// Test 2: apply_diff reconstructs b exactly.
let rb1 = apply_diff(d1)
assert(len(rb1) == 4, "reconstructed length")
assert(rb1[0] == 1, "rb[0]")
assert(rb1[1] == 3, "rb[1]")
assert(rb1[2] == 4, "rb[2]")
assert(rb1[3] == 5, "rb[3]")
print("PASS: apply_diff reconstructs b")

// Test 3: line/string diff.
let a2 = ["alpha", "beta", "gamma"]
let b2 = ["alpha", "delta", "gamma"]
let d2 = diff(a2, b2)
let s2 = diff_stats(d2)
assert(s2["common"] == 2, "alpha+gamma common")
assert(s2["removed"] == 1, "beta removed")
assert(s2["added"] == 1, "delta added")
let rb2 = apply_diff(d2)
assert(rb2[1] == "delta", "reconstructed middle line is delta")
print("PASS: line diff")

// Test 4: identical sequences -> all keep, no edits.
let same = diff([1, 2, 3], [1, 2, 3])
let ss = diff_stats(same)
assert(ss["common"] == 3, "all common")
assert(ss["added"] == 0 and ss["removed"] == 0, "no edits")
print("PASS: identical")

// Test 5: edges — empty source / empty target.
let only_add = diff([], [1, 2])
assert(diff_stats(only_add)["added"] == 2, "all additions from empty")
let only_rm = diff([9, 8], [])
assert(diff_stats(only_rm)["removed"] == 2, "all removals to empty")
print("PASS: empty edges")

// Test 6: a larger interleaved case + round-trip.
let a3 = [1, 2, 3, 4, 5, 6, 7, 8]
let b3 = [2, 3, 9, 5, 6, 7, 10]
let d3 = diff(a3, b3)
let rb3 = apply_diff(d3)
assert(len(rb3) == len(b3), "round-trip length")
let ok = 1
let i3 = 0
while i3 < len(b3)
  if rb3[i3] != b3[i3]
    ok = 0
  i3 = i3 + 1
assert(ok == 1, "diff(a,b) applied to a yields exactly b")
print("PASS: larger interleaved round-trip")

print("ALL PASS: difx — LCS-based sequence diff")
