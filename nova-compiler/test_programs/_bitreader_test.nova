import std/os/bitreader

fn ck_int(label: string, got: int, want: int)
    if got != want
        print("FAIL bitreader " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck_bits8(label: string, got: any, b7: int, b6: int, b5: int, b4: int, b3: int, b2: int, b1: int, b0: int)
    let g0 = got[0]
    let g1 = got[1]
    let g2 = got[2]
    let g3 = got[3]
    let g4 = got[4]
    let g5 = got[5]
    let g6 = got[6]
    let g7 = got[7]
    if g0 != b7 or g1 != b6 or g2 != b5 or g3 != b4 or g4 != b3 or g5 != b2 or g6 != b1 or g7 != b0
        print("FAIL bitreader " + label + ": got=[" + str(g0)+","+str(g1)+","+str(g2)+","+str(g3)+","+str(g4)+","+str(g5)+","+str(g6)+","+str(g7) + "]")
        exit(1)

fn main()
    // KAT: byte_to_bits(0xA0) == [1,0,1,0,0,0,0,0]
    // 0xA0 = 160 = 1010 0000 binary
    let bits_a0 = byte_to_bits(160)
    ck_bits8("byte_to_bits_0xA0", bits_a0, 1, 0, 1, 0, 0, 0, 0, 0)

    // KAT: bits_to_bytes([1,0,0,0,0,0,0,1]) == [0x81]
    // 1000 0001 = 0x81 = 129
    let input_bits = [1, 0, 0, 0, 0, 0, 0, 1]
    let bytes_out = bits_to_bytes(input_bits)
    let b0 = bytes_out[0]
    ck_int("bits_to_bytes_0x81_len", len(bytes_out), 1)
    ck_int("bits_to_bytes_0x81_val", b0, 129)

    // KAT: reading 4 bits then 4 bits from byte_to_bits(0xA5) yields 10 then 5
    // 0xA5 = 1010 0101 => first 4 bits: 1010 = 10; next 4 bits: 0101 = 5
    let bits_a5 = byte_to_bits(165)
    let r1 = bit_read_n(bits_a5, 0, 4)
    let val1 = r1[0]
    let pos1 = r1[1]
    ck_int("bit_read_n_0xA5_first4_val", val1, 10)
    ck_int("bit_read_n_0xA5_first4_pos", pos1, 4)
    let r2 = bit_read_n(bits_a5, pos1, 4)
    let val2 = r2[0]
    let pos2 = r2[1]
    ck_int("bit_read_n_0xA5_second4_val", val2, 5)
    ck_int("bit_read_n_0xA5_second4_pos", pos2, 8)

    // KAT: reading 3 bits from byte_to_bits(0xE0) yields 7
    // 0xE0 = 1110 0000 => first 3 bits: 111 = 7
    let bits_e0 = byte_to_bits(224)
    let r3 = bit_read_n(bits_e0, 0, 3)
    let val3 = r3[0]
    ck_int("bit_read_n_0xE0_3bits", val3, 7)

    // Extra: byte_to_bits(0xFF) -> all ones
    let bits_ff = byte_to_bits(255)
    ck_bits8("byte_to_bits_0xFF", bits_ff, 1, 1, 1, 1, 1, 1, 1, 1)

    // Extra: byte_to_bits(0) -> all zeros
    let bits_00 = byte_to_bits(0)
    ck_bits8("byte_to_bits_0x00", bits_00, 0, 0, 0, 0, 0, 0, 0, 0)

    // Extra: bits_to_bytes then byte_to_bits roundtrip for 0xA5
    let bits_a5b = byte_to_bits(165)
    let packed = bits_to_bytes(bits_a5b)
    ck_int("roundtrip_0xA5", packed[0], 165)

    // Extra: bit_read_n reading 8 bits = full byte value
    let bits_81 = byte_to_bits(129)
    let r4 = bit_read_n(bits_81, 0, 8)
    ck_int("bit_read_n_8bits_0x81", r4[0], 129)

    // Extra: bits_to_int convenience wrapper
    let bits_e0b = byte_to_bits(224)
    ck_int("bits_to_int_3", bits_to_int(bits_e0b, 0, 3), 7)

    print("PASS _bitreader_test")
