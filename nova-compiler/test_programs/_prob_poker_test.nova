import std/probability/prob_poker

// cki — check integer equality.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL prob_poker " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckr — check reduced fraction [num,den] equals expected [wn,wd].
fn ckr(label: string, got, wn: int, wd: int)
    if got[0] != wn or got[1] != wd
        print("FAIL prob_poker " + label + ": got=[" + str(got[0]) + "," + str(got[1]) + "] want=[" + str(wn) + "," + str(wd) + "]")
        exit(1)

fn main()
    // Total hands C(52,5) = 2598960
    cki("ppk_total()", ppk_total(), 2598960)

    // Four of a kind: 13*48 = 624
    cki("ppk_ways_four_kind()", ppk_ways_four_kind(), 624)

    // Full house: 13*C(4,3)*12*C(4,2) = 13*4*12*6 = 3744
    cki("ppk_ways_full_house()", ppk_ways_full_house(), 3744)

    // Plain flush (not straight flush): 4*C(13,5)-40 = 5148-40 = 5108
    cki("ppk_ways_flush()", ppk_ways_flush(), 5108)

    // Plain straight (not straight flush): 10*4^5-40 = 10240-40 = 10200
    cki("ppk_ways_straight()", ppk_ways_straight(), 10200)

    // Two pair: C(13,2)*C(4,2)^2*44 = 78*6*6*44 = 123552
    cki("ppk_ways_two_pair()", ppk_ways_two_pair(), 123552)

    // ppk_prob(624) = 624/2598960 = 1/4165
    let r1 = ppk_prob(624)
    ckr("ppk_prob(624)", r1, 1, 4165)

    // ppk_prob(3744): gcd(3744,2598960)=624 => 6/4165
    let r2 = ppk_prob(3744)
    ckr("ppk_prob(3744)", r2, 6, 4165)

    // ppk_prob(0) = 0
    let r3 = ppk_prob(0)
    ckr("ppk_prob(0)", r3, 0, 1)

    print("PASS _prob_poker_test")
