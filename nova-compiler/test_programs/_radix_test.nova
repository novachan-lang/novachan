// _radix_test.nova
// KAT for std/math/radix — arbitrary-base integer <-> string conversion.

import std/math/radix

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got [" + got + "] expected [" + expected + "]")
        exit(1)

// --- rx_to_base ---
cks("to_base 255 hex",   rx_to_base(255, 16),  "ff")
cks("to_base 10 bin",    rx_to_base(10,  2),   "1010")
cks("to_base 0 bin",     rx_to_base(0,   2),   "0")
cks("to_base 35 b36",    rx_to_base(35,  36),  "z")
cks("to_base 1 bin",     rx_to_base(1,   2),   "1")
cks("to_base 7 oct",     rx_to_base(7,   8),   "7")
cks("to_base 8 oct",     rx_to_base(8,   8),   "10")
cks("to_base 16 hex",    rx_to_base(16,  16),  "10")
cks("to_base 1000 b7",   rx_to_base(1000, 7),  "2626")

// --- rx_from_base ---
cki("from_base ff hex",    rx_from_base("ff",   16), 255)
cki("from_base FF hex",    rx_from_base("FF",   16), 255)
cki("from_base 1010 bin",  rx_from_base("1010", 2),  10)
cki("from_base z b36",     rx_from_base("z",    36), 35)
cki("from_base Z b36",     rx_from_base("Z",    36), 35)
cki("from_base 10 oct",    rx_from_base("10",   8),  8)
cki("from_base 0 bin",     rx_from_base("0",    2),  0)
cki("from_base 2626 b7",   rx_from_base("2626", 7),  1000)

// --- rx_to_base_signed ---
cks("signed -255 hex",  rx_to_base_signed(-255, 16), "-ff")
cks("signed 0",         rx_to_base_signed(0,    10), "0")
cks("signed 255 hex",   rx_to_base_signed(255,  16), "ff")
cks("signed -10 bin",   rx_to_base_signed(-10,  2),  "-1010")

// --- round-trip: rx_from_base(rx_to_base(n,b),b) == n ---
cki("roundtrip 1000 b7",    rx_from_base(rx_to_base(1000, 7),  7),  1000)
cki("roundtrip 255 b16",    rx_from_base(rx_to_base(255,  16), 16), 255)
cki("roundtrip 0 b2",       rx_from_base(rx_to_base(0,    2),  2),  0)
cki("roundtrip 100000 b36", rx_from_base(rx_to_base(100000, 36), 36), 100000)

// --- rx_valid_digit ---
cki("valid_digit 0 b2",  rx_valid_digit("0", 2),  1)
cki("valid_digit 1 b2",  rx_valid_digit("1", 2),  1)
cki("valid_digit 2 b2",  rx_valid_digit("2", 2),  0)
cki("valid_digit f b16", rx_valid_digit("f", 16), 1)
cki("valid_digit F b16", rx_valid_digit("F", 16), 1)
cki("valid_digit g b16", rx_valid_digit("g", 16), 0)
cki("valid_digit z b36", rx_valid_digit("z", 36), 1)
cki("valid_digit z b35", rx_valid_digit("z", 35), 0)

print("_radix_test passed")
