import forge_damerau

fn ck(label: string, got: int, want: int)
    let ok = "FAIL"
    if got == want
        ok = "ok"
    print(label + "=" + ok + "(" + str(got) + ")")

fn main()
    // transposition = 1 (Levenshtein would say 2)
    ck("ca_ac", damerau_levenshtein("ca", "ac"), 1)
    ck("ab_ba", damerau_levenshtein("ab", "ba"), 1)
    ck("teh_the", damerau_levenshtein("teh", "the"), 1)
    // identical
    ck("same", damerau_levenshtein("abc", "abc"), 0)
    // pure insert/delete
    ck("empty_abc", damerau_levenshtein("", "abc"), 3)
    ck("abc_empty", damerau_levenshtein("abc", ""), 3)
    // classic
    ck("kitten", damerau_levenshtein("kitten", "sitting"), 3)
    // substitution
    ck("a_b", damerau_levenshtein("a", "b"), 1)
    // real typo with transposition + others
    ck("recieve", damerau_levenshtein("recieve", "receive"), 1)
