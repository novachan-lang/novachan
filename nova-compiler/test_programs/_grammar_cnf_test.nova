// KAT for std/grammar/grammar_cnf
// Verify CNF conversion of S->aSb|epsilon:
//   1. grcnf_is_cnf(cnf_prods) = true
//   2. For all token strings over {a,b} up to length 4,
//      the CNF grammar (via CYK) recognizes exactly the same strings as the original.
import std/grammar/grammar_cnf

// ─── Check helpers ────────────────────────────────────────────────────────────

fn cki(label, got, want)
    if got != want
        print("FAIL _grammar_cnf_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    if got != want
        print("FAIL _grammar_cnf_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ─── Inline CYK recognizer for CNF grammars ──────────────────────────────────

fn _cnf_is_nt(sym) -> int
    if len(sym) == 0
        return 0
    let c = slice(sym, 0, 1)
    let ok = 0
    if c == "A" or c == "B" or c == "C" or c == "D" or c == "E"
        ok = 1
    if c == "F" or c == "G" or c == "H" or c == "I" or c == "J"
        ok = 1
    if c == "K" or c == "L" or c == "M" or c == "N" or c == "O"
        ok = 1
    if c == "P" or c == "Q" or c == "R" or c == "S" or c == "T"
        ok = 1
    if c == "U" or c == "V" or c == "W" or c == "X" or c == "Y"
        ok = 1
    if c == "Z"
        ok = 1
    return ok

fn _cnf_lst_has(lst, s) -> int
    let i = 0
    while i < len(lst)
        if lst[i] == s
            return 1
        i = i + 1
    return 0

fn _cnf_lst_add(lst, s)
    if _cnf_lst_has(lst, s) == 0
        push(lst, s)

// _cnf_recognize: CYK recognition for CNF grammar.
// Handles S0->epsilon (empty string) as a special case before CYK.
fn _cnf_recognize(cnf_prods, start, tokens) -> int
    let n = len(tokens)
    // Handle epsilon: if start has an epsilon production and tokens empty
    if n == 0
        let i = 0
        while i < len(cnf_prods)
            let p = cnf_prods[i]
            if p[0] == start
                if len(p[1]) == 0
                    return 1
            i = i + 1
        return 0
    // CYK DP table: flat index i*n+j
    // Build n×n table of empty lists
    let table = []
    let r = 0
    while r < n
        let row = []
        let c = 0
        while c < n
            let cell = []
            push(row, cell)
            c = c + 1
        push(table, row)
        r = r + 1
    // Length-1 cells
    let i = 0
    while i < n
        let tok = tokens[i]
        let cell = table[i][i]
        let pi = 0
        while pi < len(cnf_prods)
            let p = cnf_prods[pi]
            let rhs = p[1]
            if len(rhs) == 1
                if rhs[0] == tok
                    _cnf_lst_add(cell, p[0])
            pi = pi + 1
        i = i + 1
    // Longer spans
    let length = 2
    while length <= n
        let si = 0
        while si <= n - length
            let ej = si + length - 1
            let cell = table[si][ej]
            let k = si
            while k < ej
                let left = table[si][k]
                let right = table[k + 1][ej]
                let pi = 0
                while pi < len(cnf_prods)
                    let p = cnf_prods[pi]
                    let rhs = p[1]
                    if len(rhs) == 2
                        if _cnf_lst_has(left, rhs[0]) == 1
                            if _cnf_lst_has(right, rhs[1]) == 1
                                _cnf_lst_add(cell, p[0])
                    pi = pi + 1
                k = k + 1
            si = si + 1
        length = length + 1
    let top = table[0][n - 1]
    return _cnf_lst_has(top, start)

// ─── Inline general recognizer for S->aSb | epsilon ─────────────────────────
// This is a direct membership test for the language {a^n b^n : n>=0}.
// We test by checking the token list has equal a's followed by equal b's.
fn _orig_recognize(tokens) -> int
    let n = len(tokens)
    // Must have even length OR be empty
    if n == 0
        return 1
    let half = n / 2
    if half * 2 != n
        return 0
    // First half must all be "a", second half must all be "b"
    let i = 0
    let ok = 1
    while i < half
        if tokens[i] != "a"
            ok = 0
        i = i + 1
    let j = half
    while j < n
        if tokens[j] != "b"
            ok = 0
        j = j + 1
    return ok

// ─── Generate all strings over {a,b} up to length max_len ───────────────────
// Returns a list of token lists.
fn _gen_strings(max_len) -> list
    let result = []
    // Add the empty string
    let empty = []
    push(result, empty)
    // BFS / iterative generation
    let queue = []
    let e2 = []
    push(queue, e2)
    let qi = 0
    while qi < len(queue)
        let cur = queue[qi]
        if len(cur) < max_len
            // Extend with "a"
            let ca = []
            let ci = 0
            while ci < len(cur)
                push(ca, cur[ci])
                ci = ci + 1
            push(ca, "a")
            push(result, ca)
            push(queue, ca)
            // Extend with "b"
            let cb = []
            let ci2 = 0
            while ci2 < len(cur)
                push(cb, cur[ci2])
                ci2 = ci2 + 1
            push(cb, "b")
            push(result, cb)
            push(queue, cb)
        qi = qi + 1
    return result

// ─── Main ────────────────────────────────────────────────────────────────────

fn main()
    // Build original grammar: S -> a S b | epsilon
    // Productions: [["S", ["a","S","b"]], ["S", []]]
    let orig_p1 = ["S", ["a", "S", "b"]]
    let orig_p2 = ["S", []]
    let orig_prods = []
    push(orig_prods, orig_p1)
    push(orig_prods, orig_p2)

    // Convert to CNF
    let cnf_result = grcnf_convert(orig_prods, "S")
    let cnf_prods = cnf_result[0]
    let cnf_start = cnf_result[1]

    // KAT 1: new start is "S0"
    cki("new_start_is_S0", cnf_start, "S0")

    // KAT 2: CNF grammar passes is_cnf validation
    ckb("cnf_is_cnf", grcnf_is_cnf(cnf_prods), 1)

    // KAT 3: "aabb" recognized by CNF (a^2 b^2 is in language)
    let tok_aabb = ["a", "a", "b", "b"]
    ckb("cnf_aabb_true", _cnf_recognize(cnf_prods, cnf_start, tok_aabb), 1)

    // KAT 4: "" recognized by CNF (epsilon is in language)
    let tok_empty = []
    ckb("cnf_empty_true", _cnf_recognize(cnf_prods, cnf_start, tok_empty), 1)

    // KAT 5: "ab" recognized by CNF
    let tok_ab = ["a", "b"]
    ckb("cnf_ab_true", _cnf_recognize(cnf_prods, cnf_start, tok_ab), 1)

    // KAT 6: "ba" NOT recognized by CNF
    let tok_ba = ["b", "a"]
    ckb("cnf_ba_false", _cnf_recognize(cnf_prods, cnf_start, tok_ba), 0)

    // KAT 7: "aab" NOT recognized
    let tok_aab = ["a", "a", "b"]
    ckb("cnf_aab_false", _cnf_recognize(cnf_prods, cnf_start, tok_aab), 0)

    // KAT 8: Equivalence check — CNF vs original for all strings up to length 4
    let all_strings = _gen_strings(4)
    let si = 0
    while si < len(all_strings)
        let toks = all_strings[si]
        let orig_res = _orig_recognize(toks)
        let cnf_res = _cnf_recognize(cnf_prods, cnf_start, toks)
        if orig_res != cnf_res
            // Build a label string for the failing case
            let label = "equiv_len" + str(len(toks))
            ckb(label, cnf_res, orig_res)
        si = si + 1

    // KAT 9: grcnf_is_cnf rejects a non-CNF grammar (unit production A->B)
    let bad1 = ["S", ["A"]]
    let bad_prods1 = []
    push(bad_prods1, bad1)
    ckb("is_cnf_reject_unit", grcnf_is_cnf(bad_prods1), 0)

    // KAT 10: grcnf_is_cnf rejects length-3 RHS
    let bad2 = ["S", ["a", "S", "b"]]
    let bad_prods2 = []
    push(bad_prods2, bad2)
    ckb("is_cnf_reject_len3", grcnf_is_cnf(bad_prods2), 0)

    // KAT 11: grcnf_is_cnf accepts a pure CNF grammar
    let good1 = ["S", ["A", "B"]]
    let good2 = ["A", ["a"]]
    let good3 = ["B", ["b"]]
    let good_prods = []
    push(good_prods, good1)
    push(good_prods, good2)
    push(good_prods, good3)
    ckb("is_cnf_accept_valid", grcnf_is_cnf(good_prods), 1)

    // KAT 12: CNF has at least one epsilon production for S0 (start was nullable)
    let has_eps_for_s0 = 0
    let pi = 0
    while pi < len(cnf_prods)
        let p = cnf_prods[pi]
        if p[0] == "S0"
            if len(p[1]) == 0
                has_eps_for_s0 = 1
        pi = pi + 1
    ckb("cnf_has_s0_epsilon", has_eps_for_s0, 1)

    print("PASS _grammar_cnf_test")
