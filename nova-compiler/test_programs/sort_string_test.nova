// iter-20: sort() on strings must order LEXICOGRAPHICALLY (was sorting by heap-pointer
// address -> wrong). Ints/floats must still sort numerically.
fn main()
    let a = sort(["cherry", "apple", "banana"])
    assert(a[0] == "apple", "str 0 apple, got " + a[0])
    assert(a[1] == "banana", "str 1 banana, got " + a[1])
    assert(a[2] == "cherry", "str 2 cherry, got " + a[2])

    let dup = sort(["zebra", "alpha", "mike", "alpha"])
    assert(dup[0] == "alpha", "dup 0")
    assert(dup[1] == "alpha", "dup 1")
    assert(dup[2] == "mike", "dup 2")
    assert(dup[3] == "zebra", "dup 3")

    let ints = sort([3, 1, 2, 100, 5])
    assert(ints[0] == 1, "int 0")
    assert(ints[4] == 100, "int 4")

    let fs = sort([3.5, 1.5, 2.5])
    assert(fs[0] == 1.5, "float 0")
    assert(fs[2] == 3.5, "float 2")

    print("sort_string_test: strings lexicographic, ints+floats numeric")
