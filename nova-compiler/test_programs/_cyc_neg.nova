// 1.7 cycle detector — NEGATIVE case: an ACYCLIC chain a -> b, plus ordinary
// lists/dicts/strings. Nothing here is cycle-held. The detector MUST report 0.
// A detector that flags healthy programs is worse than no detector, so this half
// of the gate matters more than the positive one.
type AcycNode
    an_id: int
    an_next: AcycNode

fn main()
    let a = AcycNode(1, null)
    let b = AcycNode(2, null)
    a.an_next = b

    let xs = [1, 2, 3]
    let ys = ["alpha", "beta"]
    let d = {"k1": 10, "k2": 20}
    let nested = [[1, 2], [3, 4]]
    let dd = {"inner": [5, 6]}

    print("built acyclic " + str(len(xs)) + str(len(ys)) + str(len(d)) + str(len(nested)) + str(len(dd)))
