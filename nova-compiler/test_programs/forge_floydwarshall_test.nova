import forge_floydwarshall

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn joinrow(row: list) -> string
    let out = ""
    let i = 0
    while i < len(row)
        if i > 0
            out = out + ","
        out = out + str(row[i])
        i = i + 1
    out

fn main()
    let fails = 0
    let INF = fw_inf()

    // 4-node directed graph
    let g = []
    push(g, [0, 3, INF, 7])
    push(g, [8, 0, 2, INF])
    push(g, [5, INF, 0, 1])
    push(g, [2, INF, INF, 0])

    let d = floyd_warshall(g)

    fails = fails + expect("row0", joinrow(d[0]), "0,3,5,6")
    fails = fails + expect("row1", joinrow(d[1]), "5,0,2,3")
    fails = fails + expect("row2", joinrow(d[2]), "3,6,0,1")
    fails = fails + expect("row3", joinrow(d[3]), "2,5,7,0")

    // individual cells
    fails = fails + expect("d_0_3", str(d[0][3]), "6")
    fails = fails + expect("d_1_0", str(d[1][0]), "5")
    fails = fails + expect("d_3_2", str(d[3][2]), "7")

    // negative edges (no negative cycle): 0->1 (4), 1->2 (-2), 0->2 (5)
    let gn = []
    push(gn, [0, 4, 5])
    push(gn, [INF, 0, 0 - 2])
    push(gn, [INF, INF, 0])
    let dn = floyd_warshall(gn)
    // 0->2 direct is 5, but 0->1->2 = 4 + (-2) = 2
    fails = fails + expect("neg_edge", str(dn[0][2]), "2")
    fails = fails + expect("neg_nocycle", str(fw_has_negative_cycle(gn)), "false")

    // negative cycle: 0->1 (1), 1->0 (-3)
    let gc = []
    push(gc, [0, 1])
    push(gc, [0 - 3, 0])
    fails = fails + expect("neg_cycle", str(fw_has_negative_cycle(gc)), "true")

    // reachability: disconnected node
    let gr = []
    push(gr, [0, 1, INF])
    push(gr, [INF, 0, INF])
    push(gr, [INF, INF, 0])
    let dr = floyd_warshall(gr)
    fails = fails + expect("reach_yes", str(fw_reachable(dr, 0, 1)), "true")
    fails = fails + expect("reach_no", str(fw_reachable(dr, 0, 2)), "false")
    fails = fails + expect("reach_self", str(fw_reachable(dr, 2, 2)), "true")

    if fails == 0
        print("forge_floydwarshall: all passed")
    else
        print("forge_floydwarshall: " + str(fails) + " FAILED")
