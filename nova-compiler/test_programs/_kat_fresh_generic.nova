// finding #4 regression: an IMPORTED bare-type-parameter generic fn must be POLYMORPHIC —
// callable at multiple concrete types within one file (was: E1001 "expected T, found <type>"
// on the 2nd differently-typed call, because imports were registered ti_mono not generalized).
import _fresh_generic_mod
fn main() -> int
    let ok = true
    // Same imported bare-T fn, called at int then string then int again in one file.
    let a = fg_id(5)
    if a != 5
        print("  FAIL fg_id(5) got " + str(a))
        ok = false
    let b = fg_id("hello")
    if b != "hello"
        print("  FAIL fg_id(str) got " + str(b))
        ok = false
    let a2 = fg_id(42)
    if a2 != 42
        print("  FAIL fg_id(42) got " + str(a2))
        ok = false
    // A second bare-T fn (two T params), int then string.
    let d = fg_pick(10, 20, true)
    if d != 10
        print("  FAIL fg_pick(int) got " + str(d))
        ok = false
    let e = fg_pick("x", "y", false)
    if e != "y"
        print("  FAIL fg_pick(str) got " + str(e))
        ok = false
    if ok
        print("FRESH-GENERIC KAT PASS")
        return 0
    print("FRESH-GENERIC KAT FAIL")
    1
