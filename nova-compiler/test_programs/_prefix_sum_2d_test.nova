import std/collections/prefix_sum_2d

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn main()
    // Build 3x3 matrix [[1,2,3],[4,5,6],[7,8,9]]
    let row0 = [1, 2, 3]
    let row1 = [4, 5, 6]
    let row2 = [7, 8, 9]
    let mat = [row0, row1, row2]
    let p = ps2_build(mat)

    // KAT 1: top-left 2x2 = 1+2+4+5 = 12
    cki("submatrix_0011", ps2_submatrix_sum(p, 0, 0, 1, 1), 12)

    // KAT 2: bottom-right 2x2 = 5+6+8+9 = 28
    cki("submatrix_1122", ps2_submatrix_sum(p, 1, 1, 2, 2), 28)

    // KAT 3: entire matrix = 45
    cki("submatrix_full", ps2_submatrix_sum(p, 0, 0, 2, 2), 45)

    // KAT 4: single cell (1,1) = 5
    cki("submatrix_single", ps2_submatrix_sum(p, 1, 1, 1, 1), 5)

    // KAT 5: ps2_total = 45
    cki("total", ps2_total(p), 45)

    // KAT 6: first row sum = 1+2+3 = 6
    cki("row0_sum", ps2_submatrix_sum(p, 0, 0, 0, 2), 6)

    // KAT 7: last column sum = 3+6+9 = 18
    cki("col2_sum", ps2_submatrix_sum(p, 0, 2, 2, 2), 18)

    // KAT 8: 1x1 matrix
    let r0 = [99]
    let mat2 = [r0]
    let p2 = ps2_build(mat2)
    cki("single_cell_matrix", ps2_submatrix_sum(p2, 0, 0, 0, 0), 99)
    cki("single_cell_total", ps2_total(p2), 99)

    print("PASS _prefix_sum_2d_test")
