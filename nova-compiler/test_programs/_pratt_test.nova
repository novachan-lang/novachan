// KAT for std/parsing/pratt
// Tests: pratt_calc, pratt_parse, pratt_eval
// Convention: -2^2 == -4  (unary minus binds looser than ^)
import std/parsing/pratt

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL pratt " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL pratt " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // ── KAT 1: basic addition and multiplication precedence ──────────────────
    // 1+2*3 = 1+(2*3) = 1+6 = 7
    cki("calc_add_mul", pratt_calc("1+2*3"), 7)

    // ── KAT 2: right-associative exponentiation ───────────────────────────────
    // 2^3^2 = 2^(3^2) = 2^9 = 512
    cki("calc_pow_right_assoc", pratt_calc("2^3^2"), 512)

    // ── KAT 3: parentheses override precedence ────────────────────────────────
    // (1+2)*3 = 3*3 = 9
    cki("calc_parens", pratt_calc("(1+2)*3"), 9)

    // ── KAT 4: unary minus binds looser than ^ ────────────────────────────────
    // -2^2 = -(2^2) = -4
    cki("calc_unary_pow", pratt_calc("-2^2"), -4)

    // ── KAT 5: simple addition ────────────────────────────────────────────────
    cki("calc_simple_add", pratt_calc("1+2"), 3)

    // ── KAT 6: pratt_parse returns AST with correct op ───────────────────────
    let ast6 = pratt_parse("1+2")
    cks("parse_op", ast6["op"], "+")
    cks("parse_kind", ast6["kind"], "binop")

    // ── KAT 7: pratt_eval of parsed AST ──────────────────────────────────────
    cki("eval_parsed", pratt_eval(ast6), 3)

    // ── KAT 8: subtraction left-associative ──────────────────────────────────
    // 10-3-2 = (10-3)-2 = 5
    cki("calc_sub_left_assoc", pratt_calc("10-3-2"), 5)

    // ── KAT 9: division ───────────────────────────────────────────────────────
    // 12/4 = 3
    cki("calc_div", pratt_calc("12/4"), 3)

    // ── KAT 10: chained multiply ──────────────────────────────────────────────
    // 2*3*4 = 24
    cki("calc_mul_chain", pratt_calc("2*3*4"), 24)

    // ── KAT 11: empty input returns err node (no crash) ───────────────────────
    let ast_empty = pratt_parse("")
    cks("empty_kind", ast_empty["kind"], "err")

    // ── KAT 12: single number ─────────────────────────────────────────────────
    cki("calc_single", pratt_calc("42"), 42)

    // ── KAT 13: nested parens ─────────────────────────────────────────────────
    // ((3+4)*2) = 14
    cki("calc_nested_parens", pratt_calc("((3+4)*2)"), 14)

    // ── KAT 14: unary minus on a simple number ────────────────────────────────
    // -5 = -5
    cki("calc_neg", pratt_calc("-5"), -5)

    // ── KAT 15: complex expression ────────────────────────────────────────────
    // 2+3*4-1 = 2+12-1 = 13
    cki("calc_complex", pratt_calc("2+3*4-1"), 13)

    // ── KAT 16: division by zero returns 0 (safe, no crash) ──────────────────
    cki("calc_div_zero", pratt_calc("5/0"), 0)

    // ── KAT 17: spaces ignored ────────────────────────────────────────────────
    cki("calc_spaces", pratt_calc("  3 + 4 * 2 "), 11)

    // ── KAT 18: exponent of zero ──────────────────────────────────────────────
    cki("calc_pow_zero", pratt_calc("5^0"), 1)

    // ── KAT 19: multi-digit numbers ───────────────────────────────────────────
    cki("calc_multidigit", pratt_calc("100+23"), 123)

    // ── KAT 20: parse num node val ───────────────────────────────────────────
    let ast20 = pratt_parse("7")
    cks("num_kind", ast20["kind"], "num")
    cki("num_val", ast20["val"], 7)

    print("PASS _pratt_test")
