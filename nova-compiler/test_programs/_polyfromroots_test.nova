import std/poly/polyfromroots

// Known-answer tests for std/poly/polyfromroots.
// Integer coefficients are exact; float helpers use tolerance 0.0001.

fn ckf(label: str, got: float, want: float)
    let d = got - want
    if d < 0.0
        d = 0.0 - d
    if d > 0.0001
        print("FAIL polyfromroots " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL polyfromroots " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckcoeff(label: str, lst: list, idx: int, want: int)
    let v = lst[idx]
    if v != want
        print("FAIL polyfromroots " + label + "[" + str(idx) + "]: got=" + str(v) + " want=" + str(want))
        exit(1)

fn main()
    // --- pfr_from_roots([2,3]) = [6,-5,1] ---
    // (x-2)(x-3) = x^2 - 5x + 6
    let p23 = pfr_from_roots([2, 3])
    cki("from_roots_2_3_len", len(p23), 3)
    ckcoeff("from_roots_2_3_c0", p23, 0, 6)
    ckcoeff("from_roots_2_3_c1", p23, 1, -5)
    ckcoeff("from_roots_2_3_c2", p23, 2, 1)

    // --- pfr_from_roots([1,2,3]) = [-6,11,-6,1] ---
    // (x-1)(x-2)(x-3) = x^3 - 6x^2 + 11x - 6
    let p123 = pfr_from_roots([1, 2, 3])
    cki("from_roots_1_2_3_len", len(p123), 4)
    ckcoeff("from_roots_1_2_3_c0", p123, 0, -6)
    ckcoeff("from_roots_1_2_3_c1", p123, 1, 11)
    ckcoeff("from_roots_1_2_3_c2", p123, 2, -6)
    ckcoeff("from_roots_1_2_3_c3", p123, 3, 1)

    // --- pfr_from_roots([0,0]) = [0,0,1] ---
    // x^2
    let p00 = pfr_from_roots([0, 0])
    cki("from_roots_0_0_len", len(p00), 3)
    ckcoeff("from_roots_0_0_c0", p00, 0, 0)
    ckcoeff("from_roots_0_0_c1", p00, 1, 0)
    ckcoeff("from_roots_0_0_c2", p00, 2, 1)

    // --- pfr_from_roots([1]) = [-1,1] ---
    // (x-1) = x - 1
    let p1 = pfr_from_roots([1])
    cki("from_roots_1_len", len(p1), 2)
    ckcoeff("from_roots_1_c0", p1, 0, -1)
    ckcoeff("from_roots_1_c1", p1, 1, 1)

    // --- pfr_from_roots([]) = [1] (empty = constant 1) ---
    let p_empty = pfr_from_roots([])
    cki("from_roots_empty_len", len(p_empty), 1)
    ckcoeff("from_roots_empty_c0", p_empty, 0, 1)

    // --- pfr_from_roots_monic = from_roots ---
    let pm = pfr_from_roots_monic([2, 3])
    cki("monic_2_3_len", len(pm), 3)
    ckcoeff("monic_2_3_c0", pm, 0, 6)
    ckcoeff("monic_2_3_c1", pm, 1, -5)
    ckcoeff("monic_2_3_c2", pm, 2, 1)

    // --- pfr_vieta = from_roots ---
    let pv = pfr_vieta([2, 3])
    cki("vieta_len", len(pv), 3)
    ckcoeff("vieta_c0", pv, 0, 6)

    // --- pfr_sum_of_roots([6,-5,1]) = 5.0 ---
    // -c_{n-1}/c_n = -(-5)/1 = 5
    let sum23 = pfr_sum_of_roots([6, -5, 1])
    ckf("sum_of_roots_2_3", sum23, 5.0)

    // --- pfr_product_of_roots([6,-5,1]) = 6.0 ---
    // (-1)^2 * c_0/c_n = 1 * 6/1 = 6
    let prod23 = pfr_product_of_roots([6, -5, 1])
    ckf("product_of_roots_2_3", prod23, 6.0)

    // --- pfr_product_of_roots for cubic [-6,11,-6,1] ---
    // degree=3, (-1)^3 * c_0/c_3 = -1 * (-6)/1 = 6
    let prod123 = pfr_product_of_roots([-6, 11, -6, 1])
    ckf("product_of_roots_1_2_3", prod123, 6.0)

    // --- pfr_from_roots_scaled([2,3], 2) = [12,-10,2] ---
    let ps = pfr_from_roots_scaled([2, 3], 2)
    cki("scaled_len", len(ps), 3)
    ckcoeff("scaled_c0", ps, 0, 12)
    ckcoeff("scaled_c1", ps, 1, -10)
    ckcoeff("scaled_c2", ps, 2, 2)

    // --- pfr_verify([2,3], 0.0001) = true ---
    let vok = pfr_verify([2, 3], 0.0001)
    if not vok
        print("FAIL polyfromroots verify_2_3: expected true")
        exit(1)

    // --- pfr_verify([1,2,3], 0.0001) = true ---
    let vok2 = pfr_verify([1, 2, 3], 0.0001)
    if not vok2
        print("FAIL polyfromroots verify_1_2_3: expected true")
        exit(1)

    // --- pfr_add_root([-1,1], 2) = [2,-3,1] ---
    // (x-1)(x-2) = x^2 - 3x + 2
    let ar = pfr_add_root([-1, 1], 2)
    cki("add_root_len", len(ar), 3)
    ckcoeff("add_root_c0", ar, 0, 2)
    ckcoeff("add_root_c1", ar, 1, -3)
    ckcoeff("add_root_c2", ar, 2, 1)

    // --- pfr_add_root([1], 5) = [-5,1] ---
    // (x-5)
    let ar2 = pfr_add_root([1], 5)
    cki("add_root_5_len", len(ar2), 2)
    ckcoeff("add_root_5_c0", ar2, 0, -5)
    ckcoeff("add_root_5_c1", ar2, 1, 1)

    // --- round-trip: from_roots then eval at each root -> 0 ---
    // roots=[4,7]: poly=[28,-11,1]; eval at 4=0, eval at 7=0
    // pfr_verify internally rebuilds and checks
    let vrt = pfr_verify([4, 7], 0.0001)
    if not vrt
        print("FAIL polyfromroots roundtrip_4_7: expected verify=true")
        exit(1)

    print("PASS _polyfromroots_test")
