// S4 PRE-EXISTING SOUNDNESS BUG repro (found 2026-06-20).
// An intlist (raw int64 storage + UNGUARDED native load) that escapes to a function which appends a
// CONFLICTING kind is corrupted: the callee boxes the float INTO the raw int64 array, and the caller's
// native int load reads the box POINTER as a raw int.
// CURRENT (buggy) output: 1 / 2 / <a huge heap-pointer int> / 4
// AFTER S4.1 (guarded load + runtime deopt) it MUST be: 1 / 2 / 3.5 / 4
// This file is the permanent guard for the fix.

fn addfloat(lst)
    push(lst, 3.5)

fn main()
    let xs = []
    push(xs, 1)
    push(xs, 2)
    addfloat(xs)
    push(xs, 4)
    // After S4.1 the escape (addfloat) taints xs -> generic reads -> the float reads correctly.
    assert(xs[0] == 1, "escbug: int head")
    assert(xs[1] == 2, "escbug: int")
    assert(xs[2] == 3.5, "escbug: escaped float (was a heap pointer pre-S4.1)")
    assert(xs[3] == 4, "escbug: int tail")
    print("S4_ESCBUG_OK")
