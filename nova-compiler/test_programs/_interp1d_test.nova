// KAT test for std/numeric/interp1d — 1-D linear interpolation.
// Known-answer tests verified by hand calculation.
import std/numeric/interp1d

fn approx(a: float, b: float, tol: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < tol

fn chk(label: string, got: float, want: float)
    if not approx(got, want, 0.0001)
        print("FAIL interp1d " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)
    print("ok " + label)

fn main()
    // KAT 1: linear_interp midpoint of (0,0)..(1,10) at x=0.5 -> 5.0
    let r1 = linear_interp(0.5, 0.0, 0.0, 1.0, 10.0)
    chk("linear_interp mid", r1, 5.0)

    // KAT 2: linear_interp at left endpoint -> y0
    let r2 = linear_interp(0.0, 0.0, 3.0, 1.0, 7.0)
    chk("linear_interp left", r2, 3.0)

    // KAT 3: linear_interp at right endpoint -> y1
    let r3 = linear_interp(1.0, 0.0, 3.0, 1.0, 7.0)
    chk("linear_interp right", r3, 7.0)

    // KAT 4: interp_array midpoint between x=1.0 and x=2.0 -> 15.0
    let xs4 = [0.0, 1.0, 2.0]
    let ys4 = [0.0, 10.0, 20.0]
    let r4 = interp_array(xs4, ys4, 1.5)
    chk("interp_array mid", r4, 15.0)

    // KAT 5: interp_array at exact knot x=1.0 -> 10.0
    let xs5 = [0.0, 1.0, 2.0]
    let ys5 = [0.0, 10.0, 20.0]
    let r5 = interp_array(xs5, ys5, 1.0)
    chk("interp_array exact_knot", r5, 10.0)

    // KAT 6: interp_array clamped left (x < xs[0]) -> ys[0]
    let xs6 = [0.0, 1.0, 2.0]
    let ys6 = [0.0, 10.0, 20.0]
    let r6 = interp_array(xs6, ys6, -1.0)
    chk("interp_array clamp_left", r6, 0.0)

    // KAT 7: interp_array clamped right (x > xs[last]) -> ys[last]
    let xs7 = [0.0, 1.0, 2.0]
    let ys7 = [0.0, 10.0, 20.0]
    let r7 = interp_array(xs7, ys7, 5.0)
    chk("interp_array clamp_right", r7, 20.0)

    // KAT 8: interp_array at first knot x=0.0 -> 0.0
    let xs8 = [0.0, 1.0, 2.0]
    let ys8 = [0.0, 10.0, 20.0]
    let r8 = interp_array(xs8, ys8, 0.0)
    chk("interp_array exact_first_knot", r8, 0.0)

    // KAT 9: nearest — x=0.4 is closest to xs=0.0 -> ys=0.0
    let xs9 = [0.0, 1.0, 2.0]
    let ys9 = [0.0, 10.0, 20.0]
    let r9 = nearest(xs9, ys9, 0.4)
    chk("nearest left_win", r9, 0.0)

    // KAT 10: nearest — x=0.6 is closest to xs=1.0 -> ys=10.0
    let xs10 = [0.0, 1.0, 2.0]
    let ys10 = [0.0, 10.0, 20.0]
    let r10 = nearest(xs10, ys10, 0.6)
    chk("nearest right_win", r10, 10.0)

    print("PASS _interp1d_test")
