import forge_enumerate

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn render(xs: list) -> string
    // list-of-lists -> "a-b,c-d" (inner joined by -, outer by ,)
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + ","
        let inner = xs[i]
        let j = 0
        while j < len(inner)
            if j > 0
                out = out + "-"
            out = out + str(inner[j])
            j = j + 1
        i = i + 1
    out

fn main()
    let fails = 0

    // combinations
    fails = fails + expect("comb_2", render(combinations([1, 2, 3, 4], 2)), "1-2,1-3,1-4,2-3,2-4,3-4")
    fails = fails + expect("comb_3", render(combinations([1, 2, 3], 3)), "1-2-3")
    fails = fails + expect("comb_1", render(combinations([1, 2, 3], 1)), "1,2,3")
    fails = fails + expect("comb_0", render(combinations([1, 2, 3], 0)), "")
    fails = fails + expect("comb_0_count", str(len(combinations([1, 2, 3], 0))), "1")
    fails = fails + expect("comb_over", str(len(combinations([1, 2, 3], 4))), "0")
    fails = fails + expect("comb_count6", str(len(combinations([1, 2, 3, 4], 2))), "6")

    // power set
    fails = fails + expect("pset_2", render(power_set([1, 2])), ",1,2,1-2")
    fails = fails + expect("pset_3_size", str(len(power_set([1, 2, 3]))), "8")
    fails = fails + expect("pset_empty", str(len(power_set([]))), "1")

    // cartesian product
    fails = fails + expect("cart_2x2", render(cartesian_product([[1, 2], [3, 4]])), "1-3,1-4,2-3,2-4")
    let m = []
    push(m, ["a", "b"])
    push(m, ["x"])
    push(m, ["1", "2"])
    fails = fails + expect("cart_3", render(cartesian_product(m)), "a-x-1,a-x-2,b-x-1,b-x-2")
    fails = fails + expect("cart_size", str(len(cartesian_product([[1, 2, 3], [4, 5]]))), "6")

    // counts
    fails = fails + expect("count_5_2", str(combination_count(5, 2)), "10")
    fails = fails + expect("count_52_5", str(combination_count(52, 5)), "2598960")
    fails = fails + expect("count_n_0", str(combination_count(7, 0)), "1")

    if fails == 0
        print("forge_enumerate: all passed")
    else
        print("forge_enumerate: " + str(fails) + " FAILED")
