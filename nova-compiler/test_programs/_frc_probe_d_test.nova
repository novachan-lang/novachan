fn main()
    let b0 = live_count()
    let i = 0
    while i < 100
        let x = [i, i + 1, i + 2]
        let _u = len(x)
        i = i + 1
    let list_delta = live_count() - b0
    let b1 = live_count()
    let j = 0
    while j < 100
        let d = {"a": j}
        let _v = len(d)
        j = j + 1
    let dict_delta = live_count() - b1
    let b2 = live_count()
    let k = 0
    while k < 100
        let c = channel()
        send(c, 1)
        let _w = receive(c)
        k = k + 1
    let chan_delta = live_count() - b2
    print("probe_d list=" + str(list_delta) + " dict=" + str(dict_delta) + " chan=" + str(chan_delta))
    if list_delta > 2200 or dict_delta > 2200 or chan_delta > 2200
        print("FAILED")
        exit(1)
    print("passed")
