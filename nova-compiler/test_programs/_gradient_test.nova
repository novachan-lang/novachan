import std/color/gradient

// Helper: compare two RGB int lists for equality
fn rgb_eq(a: list, b: list) -> bool
    let ra = a[0]
    let ga = a[1]
    let ba = a[2]
    let rb = b[0]
    let gb = b[1]
    let bb = b[2]
    let result = false
    if ra == rb
        if ga == gb
            if ba == bb
                result = true
    result

// KAT 1: grd_linear black->white in 3 steps => [[0,0,0],[128,128,128],[255,255,255]]
let lin3 = grd_linear([0,0,0], [255,255,255], 3)
let lin3_ok = true
let exp0 = [0,0,0]
let exp1 = [128,128,128]
let exp2 = [255,255,255]
if rgb_eq(lin3[0], exp0) == false
    lin3_ok = false
if rgb_eq(lin3[1], exp1) == false
    lin3_ok = false
if rgb_eq(lin3[2], exp2) == false
    lin3_ok = false
if lin3_ok == false
    print("FAIL KAT1: grd_linear 3-step black->white mismatch")
    print("  [0]=" + str(lin3[0][0]) + "," + str(lin3[0][1]) + "," + str(lin3[0][2]))
    print("  [1]=" + str(lin3[1][0]) + "," + str(lin3[1][1]) + "," + str(lin3[1][2]))
    print("  [2]=" + str(lin3[2][0]) + "," + str(lin3[2][1]) + "," + str(lin3[2][2]))
    exit(1)

// KAT 2: grd_at midpoint [0,0,0]->[100,100,100] at t=0.5 => [50,50,50]
let mid = grd_at([0,0,0], [100,100,100], 0.5)
let exp_mid = [50,50,50]
if rgb_eq(mid, exp_mid) == false
    print("FAIL KAT2: grd_at 0.5 mismatch, got " + str(mid[0]) + "," + str(mid[1]) + "," + str(mid[2]))
    exit(1)

// KAT 3: grd_at t=0.0 returns a
let at0 = grd_at([0,0,0], [255,255,255], 0.0)
let exp_at0 = [0,0,0]
if rgb_eq(at0, exp_at0) == false
    print("FAIL KAT3: grd_at t=0.0 mismatch, got " + str(at0[0]) + "," + str(at0[1]) + "," + str(at0[2]))
    exit(1)

// KAT 4: grd_at t=1.0 returns b
let at1 = grd_at([0,0,0], [255,255,255], 1.0)
let exp_at1 = [255,255,255]
if rgb_eq(at1, exp_at1) == false
    print("FAIL KAT4: grd_at t=1.0 mismatch, got " + str(at1[0]) + "," + str(at1[1]) + "," + str(at1[2]))
    exit(1)

// KAT 5: len(grd_linear([255,0,0],[0,0,255],5)) == 5
let lin5 = grd_linear([255,0,0], [0,0,255], 5)
let lin5_len = len(lin5)
if lin5_len != 5
    print("FAIL KAT5: expected len=5, got " + str(lin5_len))
    exit(1)

// KAT 6: grd_linear([255,0,0],[0,0,255],5)[0] == [255,0,0]
let exp_first = [255,0,0]
if rgb_eq(lin5[0], exp_first) == false
    print("FAIL KAT6: first color mismatch, got " + str(lin5[0][0]) + "," + str(lin5[0][1]) + "," + str(lin5[0][2]))
    exit(1)

// KAT 7: grd_linear([255,0,0],[0,0,255],5)[4] == [0,0,255]
let exp_last = [0,0,255]
if rgb_eq(lin5[4], exp_last) == false
    print("FAIL KAT7: last color mismatch, got " + str(lin5[4][0]) + "," + str(lin5[4][1]) + "," + str(lin5[4][2]))
    exit(1)

// KAT 8: grd_multi with 2 stops (black + white), 3 steps => same as grd_linear 3 steps
let stops = [[0,0,0],[255,255,255]]
let multi3 = grd_multi(stops, 3)
let multi3_ok = true
if rgb_eq(multi3[0], exp0) == false
    multi3_ok = false
if rgb_eq(multi3[2], exp2) == false
    multi3_ok = false
if multi3_ok == false
    print("FAIL KAT8: grd_multi 2-stop 3-step mismatch")
    print("  [0]=" + str(multi3[0][0]) + "," + str(multi3[0][1]) + "," + str(multi3[0][2]))
    print("  [2]=" + str(multi3[2][0]) + "," + str(multi3[2][1]) + "," + str(multi3[2][2]))
    exit(1)

print("_gradient_test passed")
