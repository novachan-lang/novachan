import std/relation/relation_core

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn ckl(label, got, want)
    if len(got) != len(want)
        print("FAIL " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL " + label + ": [" + str(i) + "] got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

// ckm — check two n x n matrices are equal cell by cell.
fn ckm(label, A, B)
    let n = len(A)
    if len(B) != n
        print("FAIL " + label + ": row count got=" + str(len(A)) + " want=" + str(len(B)))
        exit(1)
    let i = 0
    while i < n
        let j = 0
        while j < n
            if A[i][j] != B[i][j]
                print("FAIL " + label + ": [" + str(i) + "][" + str(j) + "] got=" + str(A[i][j]) + " want=" + str(B[i][j]))
                exit(1)
            j = j + 1
        i = i + 1

fn ckpairs(label, got, want)
    if len(got) != len(want)
        print("FAIL " + label + ": pair count got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        let gp = got[i]
        let wp = want[i]
        if gp[0] != wp[0] or gp[1] != wp[1]
            print("FAIL " + label + ": pair[" + str(i) + "] got=[" + str(gp[0]) + "," + str(gp[1]) + "] want=[" + str(wp[0]) + "," + str(wp[1]) + "]")
            exit(1)
        i = i + 1

fn main()
    // =========================================================================
    // rn_zeros
    // =========================================================================
    let Z = rn_zeros(3)
    cki("zeros_size", len(Z), 3)
    cki("zeros_00", Z[0][0], 0)
    cki("zeros_12", Z[1][2], 0)
    cki("zeros_22", Z[2][2], 0)

    // n=0 edge case
    let Z0 = rn_zeros(0)
    cki("zeros_n0_len", len(Z0), 0)

    // =========================================================================
    // rn_from_pairs + rn_contains
    // =========================================================================
    let pairs01 = []
    pairs01.push([0, 1])
    pairs01.push([1, 2])
    let M = rn_from_pairs(pairs01, 3)
    cki("from_pairs_01", M[0][1], 1)
    cki("from_pairs_12", M[1][2], 1)
    cki("from_pairs_10_absent", M[1][0], 0)
    cki("from_pairs_02_absent", M[0][2], 0)
    ckb("contains_01", rn_contains(M, 0, 1), true)
    ckb("contains_10_false", rn_contains(M, 1, 0), false)

    // empty pairs
    let Mempty = rn_from_pairs([], 3)
    cki("from_empty_size", rn_size(Mempty), 0)

    // =========================================================================
    // rn_to_pairs
    // =========================================================================
    let id3 = rn_identity(3)
    let id3_pairs = rn_to_pairs(id3)
    let exp_id3 = []
    exp_id3.push([0, 0])
    exp_id3.push([1, 1])
    exp_id3.push([2, 2])
    ckpairs("to_pairs_identity3", id3_pairs, exp_id3)

    let pairs_M = rn_to_pairs(M)
    let exp_M = []
    exp_M.push([0, 1])
    exp_M.push([1, 2])
    ckpairs("to_pairs_M", pairs_M, exp_M)

    // to_pairs on empty relation
    let pe = rn_to_pairs(rn_zeros(3))
    cki("to_pairs_empty", len(pe), 0)

    // =========================================================================
    // rn_identity
    // =========================================================================
    let id2 = rn_identity(2)
    cki("identity2_00", id2[0][0], 1)
    cki("identity2_11", id2[1][1], 1)
    cki("identity2_01", id2[0][1], 0)
    cki("identity2_10", id2[1][0], 0)

    let id0 = rn_identity(0)
    cki("identity0_len", len(id0), 0)

    // =========================================================================
    // rn_universal
    // =========================================================================
    let U3 = rn_universal(3)
    cki("universal3_size", rn_size(U3), 9)
    cki("universal3_00", U3[0][0], 1)
    cki("universal3_12", U3[1][2], 1)
    cki("universal3_22", U3[2][2], 1)

    // =========================================================================
    // rn_size
    // =========================================================================
    cki("size_universal3", rn_size(rn_universal(3)), 9)
    cki("size_identity3", rn_size(rn_identity(3)), 3)
    cki("size_zeros3", rn_size(rn_zeros(3)), 0)
    cki("size_M", rn_size(M), 2)

    // =========================================================================
    // rn_domain
    // =========================================================================
    let pairs_dom = []
    pairs_dom.push([0, 1])
    pairs_dom.push([0, 2])
    let Mdom = rn_from_pairs(pairs_dom, 3)
    let dom = rn_domain(Mdom)
    let exp_dom = []
    exp_dom.push(0)
    ckl("domain_01_02", dom, exp_dom)

    // both rows have outgoing
    let pairs_dom2 = []
    pairs_dom2.push([0, 2])
    pairs_dom2.push([2, 1])
    let Mdom2 = rn_from_pairs(pairs_dom2, 3)
    let dom2 = rn_domain(Mdom2)
    let exp_dom2 = []
    exp_dom2.push(0)
    exp_dom2.push(2)
    ckl("domain_02_21", dom2, exp_dom2)

    // empty relation
    let dom_empty = rn_domain(rn_zeros(3))
    cki("domain_empty", len(dom_empty), 0)

    // =========================================================================
    // rn_range
    // =========================================================================
    let pairs_rng = []
    pairs_rng.push([0, 1])
    pairs_rng.push([2, 1])
    let Mrng = rn_from_pairs(pairs_rng, 3)
    let rng = rn_range(Mrng)
    let exp_rng = []
    exp_rng.push(1)
    ckl("range_01_21", rng, exp_rng)

    let pairs_rng2 = []
    pairs_rng2.push([0, 1])
    pairs_rng2.push([1, 2])
    let Mrng2 = rn_from_pairs(pairs_rng2, 3)
    let rng2 = rn_range(Mrng2)
    let exp_rng2 = []
    exp_rng2.push(1)
    exp_rng2.push(2)
    ckl("range_01_12", rng2, exp_rng2)

    // empty relation range
    let rng_empty = rn_range(rn_zeros(3))
    cki("range_empty", len(rng_empty), 0)

    print("PASS _relation_core_test")

main()
