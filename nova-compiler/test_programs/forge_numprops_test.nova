import forge_numprops

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn expect_false(name: string, cond: bool) -> int
    if cond
        print("FAIL " + name + ": expected false")
        return 1
    0

fn main()
    let fails = 0

    // digit_sum + digital_root
    fails = fails + expect("digit_sum", str(digit_sum(12345)), "15")
    fails = fails + expect("digit_sum_0", str(digit_sum(0)), "0")
    fails = fails + expect("droot_12345", str(digital_root(12345)), "6")
    fails = fails + expect("droot_9", str(digital_root(9)), "9")
    fails = fails + expect("droot_18", str(digital_root(18)), "9")
    fails = fails + expect("droot_0", str(digital_root(0)), "0")

    // perfect numbers
    fails = fails + expect_true("perfect_6", is_perfect(6))
    fails = fails + expect_true("perfect_28", is_perfect(28))
    fails = fails + expect_true("perfect_496", is_perfect(496))
    fails = fails + expect_false("perfect_12", is_perfect(12))
    fails = fails + expect_false("perfect_1", is_perfect(1))

    // armstrong
    fails = fails + expect_true("arm_153", is_armstrong(153))
    fails = fails + expect_true("arm_370", is_armstrong(370))
    fails = fails + expect_true("arm_9474", is_armstrong(9474))
    fails = fails + expect_true("arm_single", is_armstrong(5))
    fails = fails + expect_false("arm_154", is_armstrong(154))
    fails = fails + expect_false("arm_100", is_armstrong(100))

    // happy numbers
    fails = fails + expect_true("happy_19", is_happy(19))
    fails = fails + expect_true("happy_1", is_happy(1))
    fails = fails + expect_true("happy_7", is_happy(7))
    fails = fails + expect_false("happy_4", is_happy(4))
    fails = fails + expect_false("happy_2", is_happy(2))

    // palindrome numbers
    fails = fails + expect_true("pal_12321", is_palindrome_number(12321))
    fails = fails + expect_true("pal_7", is_palindrome_number(7))
    fails = fails + expect_true("pal_1221", is_palindrome_number(1221))
    fails = fails + expect_false("pal_123", is_palindrome_number(123))
    fails = fails + expect_false("pal_neg", is_palindrome_number(0 - 121))

    // triangular
    fails = fails + expect_true("tri_10", is_triangular(10))
    fails = fails + expect_true("tri_15", is_triangular(15))
    fails = fails + expect_true("tri_0", is_triangular(0))
    fails = fails + expect_true("tri_1", is_triangular(1))
    fails = fails + expect_false("tri_11", is_triangular(11))
    fails = fails + expect_false("tri_2", is_triangular(2))

    if fails == 0
        print("forge_numprops: all passed")
    else
        print("forge_numprops: " + str(fails) + " FAILED")
