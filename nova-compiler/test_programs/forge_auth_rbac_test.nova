// Forge S4 (RBAC): require_role / require_any_role middleware gate a request on the user's roles
// (carried on req["roles"]). Tested by invoking the middleware closure directly with a mock req + next
// (no live server). Socketless, deterministic.
import forge
import forge_auth

fn ok_next(req)
    resp_text(200, "ok")

fn main()
    let mw = require_role("admin")

    let req1 = {}
    req1["roles"] = ["admin", "user"]
    if mw(req1, ok_next).status != 200
        print("FAIL: admin should be allowed (200)")
        exit(1)

    let req2 = {}
    req2["roles"] = ["user"]
    if mw(req2, ok_next).status != 403
        print("FAIL: non-admin should be 403")
        exit(1)

    let req3 = {}                       // no roles key -> denied
    if mw(req3, ok_next).status != 403
        print("FAIL: no-roles should be 403")
        exit(1)

    let mw2 = require_any_role(["editor", "admin"])
    if mw2(req1, ok_next).status != 200
        print("FAIL: require_any_role should allow admin")
        exit(1)
    if mw2(req2, ok_next).status != 403
        print("FAIL: require_any_role should deny a plain user")
        exit(1)

    if has_role(["a", "b"], "a") == false or has_any_role(["x", "b"], ["b", "z"]) == false
        print("FAIL: has_role / has_any_role")
        exit(1)

    print("PASS forge_auth_rbac (require_role 200/403, require_any_role 200/403, has_role/has_any_role)")
