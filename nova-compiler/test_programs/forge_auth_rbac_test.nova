// Forge S4: the full authn->authz chain. mw_require_auth(secret) verifies a JWT and sets
// req.state["user"]=claims; require_role(role) reads the claims' roles and gates. Tests admin-allowed
// (200), wrong-role-denied (403), no-token-denied (401). Socketless (middleware closures chained
// directly), deterministic, kill-on-timeout.
import forge
import forge_auth

fn ok_next(req)
    resp_text(200, "ok")

fn main()
    let secret = "test-secret-key"
    let auth = mw_require_auth(secret)
    let need_admin = require_role("admin")

    // admin token -> authn sets req.state["user"], require_role(admin) allows -> 200
    let ac = {}
    ac["sub"] = "alice"
    ac["roles"] = ["admin", "user"]
    ac["exp"] = 9999999999
    let atok = jwt_encode(ac, secret)
    let areq = build_request("GET /admin HTTP/1.1\r\nAuthorization: Bearer " + atok + "\r\n\r\n", 0)
    if auth(areq, fn(rq) need_admin(rq, ok_next)).status != 200
        print("FAIL: admin token + require_role(admin) should be 200")
        exit(1)

    // user-only token -> require_role(admin) denies -> 403
    let uc = {}
    uc["sub"] = "bob"
    uc["roles"] = ["user"]
    uc["exp"] = 9999999999
    let utok = jwt_encode(uc, secret)
    let ureq = build_request("GET /admin HTTP/1.1\r\nAuthorization: Bearer " + utok + "\r\n\r\n", 0)
    if auth(ureq, fn(rq) need_admin(rq, ok_next)).status != 403
        print("FAIL: user token + require_role(admin) should be 403")
        exit(1)

    // no token -> authn 401 (require_role never runs)
    let nreq = build_request("GET /admin HTTP/1.1\r\n\r\n", 0)
    if auth(nreq, fn(rq) need_admin(rq, ok_next)).status != 401
        print("FAIL: no token should be 401")
        exit(1)

    // pure role checks
    if has_role(["a", "b"], "a") == false or has_any_role(["x", "b"], ["b", "z"]) == false
        print("FAIL: has_role / has_any_role")
        exit(1)

    print("PASS forge_auth_chain (jwt -> mw_require_auth -> require_role: admin 200, user 403, anon 401)")
