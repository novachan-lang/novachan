import std/rational/rfrac_core

// ckr — assert rational equality element-wise
fn ckr(label: string, got: list, wn: int, wd: int)
    if got[0] != wn or got[1] != wd
        print("FAIL rfrac_core " + label + ": got=" + str(got[0]) + "/" + str(got[1]) + " want=" + str(wn) + "/" + str(wd))
        exit(1)

// cki — assert integer equality
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL rfrac_core " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// cks — assert string equality
fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL rfrac_core " + label + ": got=" + got + " want=" + want)
        exit(1)

// --- rf_make ---
let r1 = rf_make(4, 8)
ckr("make_4_8", r1, 1, 2)

let r2 = rf_make(2, 0 - 4)
ckr("make_2_neg4", r2, 0 - 1, 2)

let r3 = rf_make(0 - 2, 0 - 4)
ckr("make_neg2_neg4", r3, 1, 2)

let r4 = rf_make(0, 5)
ckr("make_0_5", r4, 0, 1)

// invalid: denominator zero
let r5 = rf_make(3, 0)
ckr("make_3_0", r5, 0, 0)

// --- rf_gcd ---
cki("gcd_48_36", rf_gcd(48, 36), 12)
cki("gcd_0_5", rf_gcd(0, 5), 5)
cki("gcd_7_7", rf_gcd(7, 7), 7)
cki("gcd_12_8", rf_gcd(12, 8), 4)

// --- rf_reciprocal ---
let rec1 = rf_reciprocal(rf_make(2, 5))
ckr("recip_2_5", rec1, 5, 2)

let rec2 = rf_reciprocal(rf_make(0 - 3, 4))
ckr("recip_neg3_4", rec2, 0 - 4, 3)

// reciprocal of zero is invalid
let rec3 = rf_reciprocal(rf_make(0, 7))
ckr("recip_zero", rec3, 0, 0)

// --- rf_is_integer ---
let int1 = rf_make(6, 3)
cki("is_integer_6_3", rf_is_integer(int1), 1)

let int2 = rf_make(1, 2)
cki("is_integer_1_2", rf_is_integer(int2), 0)

// --- rf_sign ---
cki("sign_neg3_4", rf_sign(rf_make(0 - 3, 4)), 0 - 1)
cki("sign_0", rf_sign(rf_make(0, 1)), 0)
cki("sign_pos", rf_sign(rf_make(3, 4)), 1)

// --- rf_from_int ---
let fi = rf_from_int(7)
ckr("from_int_7", fi, 7, 1)

// --- rf_to_string ---
cks("to_string_3_4", rf_to_string(rf_make(3, 4)), "3/4")
cks("to_string_5_1", rf_to_string(rf_make(5, 1)), "5")
cks("to_string_neg3_4", rf_to_string(rf_make(0 - 3, 4)), "-3/4")
cks("to_string_0", rf_to_string(rf_make(0, 1)), "0")

// --- rf_neg ---
let neg1 = rf_neg(rf_make(3, 4))
ckr("neg_3_4", neg1, 0 - 3, 4)

let neg2 = rf_neg(rf_make(0 - 3, 4))
ckr("neg_neg3_4", neg2, 3, 4)

// --- rf_abs ---
let abs1 = rf_abs(rf_make(0 - 5, 6))
ckr("abs_neg5_6", abs1, 5, 6)

let abs2 = rf_abs(rf_make(5, 6))
ckr("abs_5_6", abs2, 5, 6)

// --- rf_is_zero ---
cki("is_zero_0_1", rf_is_zero(rf_make(0, 1)), 1)
cki("is_zero_1_2", rf_is_zero(rf_make(1, 2)), 0)

// --- rf_is_valid ---
cki("is_valid_1_2", rf_is_valid(rf_make(1, 2)), 1)
cki("is_valid_bad", rf_is_valid(rf_make(3, 0)), 0)

// --- rf_num / rf_den ---
let nd = rf_make(3, 4)
cki("num_3_4", rf_num(nd), 3)
cki("den_3_4", rf_den(nd), 4)

print("PASS _rfrac_core_test")
