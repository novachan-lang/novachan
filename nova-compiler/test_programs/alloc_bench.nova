// Allocation stress test: creates many lists and dicts
fn make_lists(n)
    let i = 0
    let last = [0]
    while i < n
        last = [1, 2, 3, 4, 5]
        i = i + 1
    len(last)

fn make_dicts(n)
    let i = 0
    let last = {}
    while i < n
        last = {"a": 1, "b": 2, "c": 3}
        i = i + 1
    len(last)

fn main()
    let r1 = make_lists(100000)
    let r2 = make_dicts(100000)
    print(r1)
    print(r2)
