// Allocation stress test: creates many lists and dicts
fn make_lists(n)
    let i = 0
    while i < n
        let lst = [1, 2, 3, 4, 5]
        i = i + 1
    n

fn make_dicts(n)
    let i = 0
    while i < n
        let d = {"a": 1, "b": 2, "c": 3}
        i = i + 1
    n

fn main()
    let r1 = make_lists(100000)
    let r2 = make_dicts(100000)
    print(r1)
    print(r2)
