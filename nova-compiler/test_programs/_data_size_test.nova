// _data_size_test.nova — KAT for std/units/data_size
import std/units/data_size

fn approx(a: float, b: float, tol: float) -> int
    let d = a - b
    let ad = d
    if d < 0.0
        ad = 0.0 - d
    let result = 0
    if ad < tol
        result = 1
    result

fn main()
    // KAT 1: 1 kb -> 1000 b
    let r1 = data_size_convert(1.0, "kb", "b")
    if approx(r1, 1000.0, 0.01) == 0
        print("FAIL data_size kb->b: got=" + str(r1) + " want=1000.0")
        exit(1)

    // KAT 2: 1 kib -> 1024 b
    let r2 = data_size_convert(1.0, "kib", "b")
    if approx(r2, 1024.0, 0.01) == 0
        print("FAIL data_size kib->b: got=" + str(r2) + " want=1024.0")
        exit(1)

    // KAT 3: 1 mib -> 1024 kib
    let r3 = data_size_convert(1.0, "mib", "kib")
    if approx(r3, 1024.0, 0.01) == 0
        print("FAIL data_size mib->kib: got=" + str(r3) + " want=1024.0")
        exit(1)

    // KAT 4: 1 b -> 8 bit
    let r4 = data_size_convert(1.0, "b", "bit")
    if approx(r4, 8.0, 0.01) == 0
        print("FAIL data_size b->bit: got=" + str(r4) + " want=8.0")
        exit(1)

    // KAT 5: 1 gb -> 1000 mb
    let r5 = data_size_convert(1.0, "gb", "mb")
    if approx(r5, 1000.0, 0.01) == 0
        print("FAIL data_size gb->mb: got=" + str(r5) + " want=1000.0")
        exit(1)

    // KAT 6: round-trip mib -> b -> mib
    let mib_in = 2.0
    let as_b = data_size_convert(mib_in, "mib", "b")
    let back = data_size_convert(as_b, "b", "mib")
    if approx(back, mib_in, 0.0001) == 0
        print("FAIL data_size round-trip mib: got=" + str(back))
        exit(1)

    // KAT 7: round-trip tb -> b -> tb
    let tb_in = 1.0
    let as_b2 = data_size_convert(tb_in, "tb", "b")
    let back2 = data_size_convert(as_b2, "b", "tb")
    if approx(back2, tb_in, 0.0001) == 0
        print("FAIL data_size round-trip tb: got=" + str(back2))
        exit(1)

    // KAT 8: data_size_factor("gib") == 1073741824.0
    let f1 = data_size_factor("gib")
    if approx(f1, 1073741824.0, 1.0) == 0
        print("FAIL data_size factor gib: got=" + str(f1))
        exit(1)

    // KAT 9: data_size_is_supported("tib") == 1
    let s1 = data_size_is_supported("tib")
    if s1 != 1
        print("FAIL data_size is_supported tib: got=" + str(s1))
        exit(1)

    // KAT 10: data_size_is_supported("pb") == 0 (not in set)
    let s2 = data_size_is_supported("pb")
    if s2 != 0
        print("FAIL data_size is_supported pb: got=" + str(s2))
        exit(1)

    // KAT 11: b_to_bit convenience fn: 8 bytes -> 64 bits
    let bits = b_to_bit(8.0)
    if approx(bits, 64.0, 0.01) == 0
        print("FAIL b_to_bit: got=" + str(bits))
        exit(1)

    // KAT 12: kib_to_b(1.0) == 1024.0
    let kb2 = kib_to_b(1.0)
    if approx(kb2, 1024.0, 0.01) == 0
        print("FAIL kib_to_b: got=" + str(kb2))
        exit(1)

    print("PASS _data_size_test")
