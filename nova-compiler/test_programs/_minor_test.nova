// KAT for std/money/minor — core integer minor-unit money arithmetic.
import std/money/minor

fn cki(label, got, want)
    if got != want
        print("FAIL _minor_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL _minor_test " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL _minor_test " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn main()
    // minor_from_major
    cki("from_major", minor_from_major(12, 34, 2), 1234)
    cki("from_major_zero", minor_from_major(5, 0, 2), 500)
    cki("from_major_jpy", minor_from_major(1000, 0, 0), 1000)
    cki("from_major_bhd", minor_from_major(1, 500, 3), 1500)

    // minor_major_part / minor_minor_part
    cki("major_part", minor_major_part(1234, 2), 12)
    cki("minor_part", minor_minor_part(1234, 2), 34)
    cki("major_part_neg", minor_major_part(-1234, 2), -12)
    cki("minor_part_neg", minor_minor_part(-1234, 2), 34)

    // minor_add / minor_sub
    cki("add", minor_add(150, 250), 400)
    cki("sub", minor_sub(500, 200), 300)
    cki("sub_neg", minor_sub(100, 300), -200)

    // minor_mul_int
    cki("mul_int", minor_mul_int(150, 3), 450)
    cki("mul_int_zero", minor_mul_int(999, 0), 0)

    // minor_neg / minor_abs
    cki("neg", minor_neg(500), -500)
    cki("neg_neg", minor_neg(-300), 300)
    cki("abs_pos", minor_abs(500), 500)
    cki("abs_neg", minor_abs(-500), 500)
    cki("abs_zero", minor_abs(0), 0)

    // minor_is_zero
    ckb("is_zero_t", minor_is_zero(0), true)
    ckb("is_zero_f", minor_is_zero(1), false)

    // minor_sign
    cki("sign_neg", minor_sign(-3), -1)
    cki("sign_zero", minor_sign(0), 0)
    cki("sign_pos", minor_sign(42), 1)

    // minor_to_major_str
    cks("to_str_1234", minor_to_major_str(1234, 2), "12.34")
    cks("to_str_5", minor_to_major_str(5, 2), "0.05")
    cks("to_str_neg", minor_to_major_str(-1234, 2), "-12.34")
    cks("to_str_jpy", minor_to_major_str(1000, 0), "1000")
    cks("to_str_bhd", minor_to_major_str(1500, 3), "1.500")
    cks("to_str_zero", minor_to_major_str(0, 2), "0.00")

    // minor_scale
    cki("scale_up", minor_scale(1234, 2, 3), 12340)
    cki("scale_down", minor_scale(12340, 3, 2), 1234)
    cki("scale_same", minor_scale(1234, 2, 2), 1234)

    print("PASS _minor_test")
