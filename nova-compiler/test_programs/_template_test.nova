import std/parsing/template

// Helper: build "{{" and "}}" without literal braces
fn _ob2()
    return chr(123) + chr(123)

fn _cb2()
    return chr(125) + chr(125)

fn main()
    let ob = _ob2()
    let cb = _cb2()

    // --- Mandatory KAT vectors (from spec) ---

    // render("Hi {{name}}!", {"name":"Bo"}) == "Hi Bo!"
    let ctx1 = {}
    ctx1["name"] = "Bo"
    let tmpl1 = "Hi " + ob + "name" + cb + "!"
    let r1 = render(tmpl1, ctx1)
    if r1 == "Hi Bo!"
        let ok1 = 1
        ok1 = ok1 + 0
    else
        print("FAIL template var-simple: got " + r1 + " want Hi Bo!")
        exit(1)

    // render("{{a}}+{{b}}", {"a":"1","b":"2"}) == "1+2"
    let ctx2 = {}
    ctx2["a"] = "1"
    ctx2["b"] = "2"
    let tmpl2 = ob + "a" + cb + "+" + ob + "b" + cb
    let r2 = render(tmpl2, ctx2)
    if r2 == "1+2"
        let ok2 = 1
        ok2 = ok2 + 0
    else
        print("FAIL template two-vars: got " + r2 + " want 1+2")
        exit(1)

    // render("{{#if x}}Y{{/if}}", {"x":1}) == "Y"
    let ctx3 = {}
    ctx3["x"] = 1
    let tmpl3 = ob + "#if x" + cb + "Y" + ob + "/if" + cb
    let r3 = render(tmpl3, ctx3)
    if r3 == "Y"
        let ok3 = 1
        ok3 = ok3 + 0
    else
        print("FAIL template if-true: got " + r3 + " want Y")
        exit(1)

    // render("{{#if x}}Y{{/if}}", {"x":0}) == ""
    let ctx4 = {}
    ctx4["x"] = 0
    let tmpl4 = ob + "#if x" + cb + "Y" + ob + "/if" + cb
    let r4 = render(tmpl4, ctx4)
    if r4 == ""
        let ok4 = 1
        ok4 = ok4 + 0
    else
        print("FAIL template if-false: got " + r4 + " want empty")
        exit(1)

    // render("{{#each xs}}[{{.}}]{{/each}}", {"xs":["a","b"]}) == "[a][b]"
    let ctx5 = {}
    let xs5 = []
    push(xs5, "a")
    push(xs5, "b")
    ctx5["xs"] = xs5
    let tmpl5 = ob + "#each xs" + cb + "[" + ob + "." + cb + "]" + ob + "/each" + cb
    let r5 = render(tmpl5, ctx5)
    if r5 == "[a][b]"
        let ok5 = 1
        ok5 = ok5 + 0
    else
        print("FAIL template each: got " + r5 + " want [a][b]")
        exit(1)

    // missing var -> ""
    let ctx6 = {}
    let tmpl6 = ob + "missing" + cb
    let r6 = render(tmpl6, ctx6)
    if r6 == ""
        let ok6 = 1
        ok6 = ok6 + 0
    else
        print("FAIL template missing-var: got " + r6 + " want empty")
        exit(1)

    // render_vars("{{a}}{{b}}") contains "a" and "b"
    let rv_tmpl = ob + "a" + cb + ob + "b" + cb
    let rvars = render_vars(rv_tmpl)
    let has_a = 0
    let has_b = 0
    let vi = 0
    while vi < len(rvars)
        let vn = rvars[vi]
        if vn == "a"
            has_a = 1
        if vn == "b"
            has_b = 1
        vi = vi + 1
    if has_a == 0
        print("FAIL template render_vars-a: not found in " + str(rvars))
        exit(1)
    if has_b == 0
        print("FAIL template render_vars-b: not found in " + str(rvars))
        exit(1)

    // --- Additional edge-case vectors ---

    // Empty template
    let ctx7 = {}
    let r7 = render("", ctx7)
    if r7 == ""
        let ok7 = 1
        ok7 = ok7 + 0
    else
        print("FAIL template empty-tmpl: got " + r7 + " want empty")
        exit(1)

    // Template with no tags -- literal passthrough
    let ctx8 = {}
    let r8 = render("hello world", ctx8)
    if r8 == "hello world"
        let ok8 = 1
        ok8 = ok8 + 0
    else
        print("FAIL template literal: got " + r8 + " want hello world")
        exit(1)

    // if with missing key -> falsy
    let ctx9 = {}
    let tmpl9 = ob + "#if flag" + cb + "YES" + ob + "/if" + cb
    let r9 = render(tmpl9, ctx9)
    if r9 == ""
        let ok9 = 1
        ok9 = ok9 + 0
    else
        print("FAIL template if-missing: got " + r9 + " want empty")
        exit(1)

    // each with empty list -> ""
    let ctx10 = {}
    let emp = []
    ctx10["items"] = emp
    let tmpl10 = ob + "#each items" + cb + "x" + ob + "/each" + cb
    let r10 = render(tmpl10, ctx10)
    if r10 == ""
        let ok10 = 1
        ok10 = ok10 + 0
    else
        print("FAIL template each-empty: got " + r10 + " want empty")
        exit(1)

    // int variable substitution
    let ctx11 = {}
    ctx11["n"] = 42
    let tmpl11 = "count=" + ob + "n" + cb
    let r11 = render(tmpl11, ctx11)
    if r11 == "count=42"
        let ok11 = 1
        ok11 = ok11 + 0
    else
        print("FAIL template int-var: got " + r11 + " want count=42")
        exit(1)

    // if with string var truthy
    let ctx12 = {}
    ctx12["greeting"] = "hello"
    let tmpl12 = ob + "#if greeting" + cb + "HAS" + ob + "/if" + cb
    let r12 = render(tmpl12, ctx12)
    if r12 == "HAS"
        let ok12 = 1
        ok12 = ok12 + 0
    else
        print("FAIL template if-str-truthy: got " + r12 + " want HAS")
        exit(1)

    // each with int items
    let ctx13 = {}
    let nums = []
    push(nums, 1)
    push(nums, 2)
    push(nums, 3)
    ctx13["nums"] = nums
    let tmpl13 = ob + "#each nums" + cb + ob + "." + cb + "," + ob + "/each" + cb
    let r13 = render(tmpl13, ctx13)
    if r13 == "1,2,3,"
        let ok13 = 1
        ok13 = ok13 + 0
    else
        print("FAIL template each-ints: got " + r13 + " want 1,2,3,")
        exit(1)

    // render_vars on if/each blocks
    let rv2_tmpl = ob + "#if flag" + cb + ob + "name" + cb + ob + "/if" + cb + ob + "#each items" + cb + ob + "." + cb + ob + "/each" + cb
    let rv2 = render_vars(rv2_tmpl)
    let hf = 0
    let hn = 0
    let hi = 0
    let hd = 0
    let rv2i = 0
    while rv2i < len(rv2)
        let rn = rv2[rv2i]
        if rn == "flag"
            hf = 1
        if rn == "name"
            hn = 1
        if rn == "items"
            hi = 1
        if rn == "."
            hd = 1
        rv2i = rv2i + 1
    if hf == 0
        print("FAIL template render_vars-flag: not found")
        exit(1)
    if hn == 0
        print("FAIL template render_vars-name: not found")
        exit(1)
    if hi == 0
        print("FAIL template render_vars-items: not found")
        exit(1)
    if hd == 0
        print("FAIL template render_vars-dot: not found")
        exit(1)

    // Surrounding text preserved
    let ctx14 = {}
    ctx14["x"] = "X"
    let tmpl14 = "before " + ob + "x" + cb + " after"
    let r14 = render(tmpl14, ctx14)
    if r14 == "before X after"
        let ok14 = 1
        ok14 = ok14 + 0
    else
        print("FAIL template surrounding-text: got " + r14 + " want before X after")
        exit(1)

    print("PASS _template_test")
