// KAT for std/text/template — {{key}} substitution. Braces built via chr(123)/chr(125) to avoid NOVA interpolation.
import std/text/template

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": '" + got + "' != '" + want + "'")
        exit(1)

fn main()
    let ob = chr(123) + chr(123)
    let cb = chr(125) + chr(125)
    let v = {}
    v["name"] = "World"
    cks("single", template_render("Hello " + ob + "name" + cb + "!", v), "Hello World!")
    let v2 = {}
    v2["a"] = "1"
    v2["b"] = "2"
    cks("two", template_render(ob + "a" + cb + " and " + ob + "b" + cb, v2), "1 and 2")
    let v3 = {}
    cks("missing", template_render("x" + ob + "gone" + cb + "y", v3), "xy")
    cks("none", template_render("plain text", v3), "plain text")
    print("_template_test passed")
