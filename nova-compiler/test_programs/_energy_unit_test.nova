import std/units/energy

// approx — float equality within tolerance.
fn approx(a, b, tol)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < tol

fn ckf(label, got, want, tol)
    if not approx(got, want, tol)
        print("FAIL energy " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // KAT 1: 1 kJ -> J = 1000
    let r1 = energy_convert(1.0, "kj", "j")
    ckf("kj->j", r1, 1000.0, 0.001)

    // KAT 2: 1 kcal -> cal = 1000
    let r2 = energy_convert(1.0, "kcal", "cal")
    ckf("kcal->cal", r2, 1000.0, 0.001)

    // KAT 3: 1 kWh -> J = 3600000
    let r3 = energy_convert(1.0, "kwh", "j")
    ckf("kwh->j", r3, 3600000.0, 0.1)

    // KAT 4: 1 kWh -> Wh = 1000
    let r4 = energy_convert(1.0, "kwh", "wh")
    ckf("kwh->wh", r4, 1000.0, 0.001)

    // KAT 5: 1 cal -> J = 4.184
    let r5 = energy_convert(1.0, "cal", "j")
    ckf("cal->j", r5, 4.184, 0.001)

    // KAT 6: round-trip J->kJ->J
    let v6 = 5000.0
    let rt6 = energy_convert(energy_convert(v6, "j", "kj"), "kj", "j")
    ckf("roundtrip-j-kj", rt6, v6, 0.001)

    // KAT 7: round-trip BTU->J->BTU
    let v7 = 1.0
    let rt7 = energy_convert(energy_convert(v7, "btu", "j"), "j", "btu")
    ckf("roundtrip-btu", rt7, v7, 0.0001)

    // KAT 8: 1 MJ -> kJ = 1000
    let r8 = energy_convert(1.0, "mj", "kj")
    ckf("mj->kj", r8, 1000.0, 0.001)

    // KAT 9: 1 BTU -> J ≈ 1055.056
    let r9 = energy_convert(1.0, "btu", "j")
    ckf("btu->j", r9, 1055.05585262, 0.001)

    // KAT 10: 1 ft-lbf -> J ≈ 1.3558179483
    let r10 = energy_convert(1.0, "ftlb", "j")
    ckf("ftlb->j", r10, 1.3558179483, 0.0001)

    // KAT 11: energy_is_supported
    let s1 = energy_is_supported("kwh")
    if s1 != 1
        print("FAIL energy is_supported kwh")
        exit(1)
    let s2 = energy_is_supported("xyz")
    if s2 != 0
        print("FAIL energy is_supported xyz")
        exit(1)

    // KAT 12: kcal -> J = 4184
    let r12 = energy_convert(1.0, "kcal", "j")
    ckf("kcal->j", r12, 4184.0, 0.001)

    print("PASS _energy_unit_test")
