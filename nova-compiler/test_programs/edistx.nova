fn edit_distance(a, b)
  let m = len(a)
  let n = len(b)
  if m == 0
    return n
  if n == 0
    return m
  let prev = []
  let j = 0
  while j <= n
    push(prev, j)
    j = j + 1
  let i = 1
  while i <= m
    let curr = [i]
    let j2 = 1
    while j2 <= n
      let cost = 1
      if slice(a, i - 1, i) == slice(b, j2 - 1, j2)
        cost = 0
      let del = prev[j2] + 1
      let ins = curr[j2 - 1] + 1
      let sub = prev[j2 - 1] + cost
      let best = del
      if ins < best
        best = ins
      if sub < best
        best = sub
      push(curr, best)
      j2 = j2 + 1
    prev = curr
    i = i + 1
  prev[n]

fn similarity(a, b)
  let d = edit_distance(a, b)
  let maxlen = len(a)
  if len(b) > maxlen
    maxlen = len(b)
  if maxlen == 0
    return 100
  (maxlen - d) * 100 / maxlen

fn is_similar(a, b, threshold)
  similarity(a, b) >= threshold

fn closest_match(target, candidates)
  let best = ""
  let best_dist = 999999
  for c in candidates
    let d = edit_distance(target, c)
    if d < best_dist
      best_dist = d
      best = c
  best

fn main()
  assert(edit_distance("", "") == 0, "empty-empty")
  assert(edit_distance("abc", "") == 3, "abc-empty")
  assert(edit_distance("", "xyz") == 3, "empty-xyz")
  assert(edit_distance("kitten", "sitting") == 3, "kitten-sitting")
  assert(edit_distance("saturday", "sunday") == 3, "saturday-sunday")
  assert(edit_distance("hello", "hello") == 0, "identical")
  assert(edit_distance("a", "b") == 1, "single substitution")
  assert(edit_distance("abc", "ab") == 1, "single deletion")
  assert(edit_distance("ab", "abc") == 1, "single insertion")

  assert(similarity("hello", "hello") == 100, "identical similarity")
  assert(similarity("hello", "hallo") >= 80, "close similarity")
  assert(similarity("abc", "xyz") == 0, "no similarity")

  assert(is_similar("color", "colour", 70) == 1, "color-colour similar")
  assert(is_similar("abc", "xyz", 50) == 0, "abc-xyz not similar")

  let best = closest_match("printt", ["print", "sprint", "point", "paint"])
  assert(best == "print", "closest to printt is print")

  let best2 = closest_match("helo", ["heap", "hello", "hero", "help"])
  assert(best2 == "hello" or best2 == "hero" or best2 == "help", "closest to helo is dist-1")

  print("edistx: all passed")
