// Forge crypto: SHA-256, gated against the published NIST/FIPS-180 Known-Answer Tests. A single wrong
// bit (a K-constant typo, a shift off-by-one) changes the digest completely (avalanche), so matching all
// three vectors is a complete correctness proof. Socketless, deterministic.
import forge_crypto

fn main()
    if sha256_hex("") != "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
        print("FAIL: sha256('') -> " + sha256_hex(""))
        exit(1)
    if sha256_hex("abc") != "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
        print("FAIL: sha256('abc') -> " + sha256_hex("abc"))
        exit(1)
    let m448 = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
    if sha256_hex(m448) != "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1"
        print("FAIL: sha256(448-bit) -> " + sha256_hex(m448))
        exit(1)
    print("PASS forge_crypto_sha256 (NIST KATs: empty / abc / 448-bit message)")
