import std/core/seq
fn main() -> int
    let fails = 0
    let xs = [1, 2, 3, 4, 5]
    let d = seq_map(xs, fn(x) x * 2)
    if d[2] != 6
        print("FAIL map")
        fails = fails + 1
    if len(d) != 5
        print("FAIL map len")
        fails = fails + 1
    let e = seq_filter(xs, fn(x) x % 2 == 0)
    if len(e) != 2
        print("FAIL filter")
        fails = fails + 1
    if e[0] != 2
        print("FAIL filter[0]")
        fails = fails + 1
    let f = seq_flat_map([1, 2, 3], fn(x) [x, x])
    if len(f) != 6
        print("FAIL flat_map len=" + str(len(f)))
        fails = fails + 1
    if fails == 0
        print("PASS _kat_seq_hof")
    else
        print("FAILED _kat_seq_hof")
    return 0
