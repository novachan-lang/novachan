import forge_billing_meter

fn main()
    let b = bm_new()
    b = bm_add_meter(b, "api_calls", 1)
    b = bm_add_meter(b, "data_gb", 10)

    b = bm_record(b, "api_calls", 100)
    b = bm_record(b, "api_calls", 50)
    b = bm_record(b, "data_gb", 5)

    assert(bm_usage(b, "api_calls") == 150, "150 api calls")
    assert(bm_usage(b, "data_gb") == 5, "5 gb data")
    assert(bm_cost(b, "api_calls") == 150, "api cost 150")
    assert(bm_cost(b, "data_gb") == 50, "data cost 50")
    assert(bm_total_cost(b) == 200, "total 200")

    assert(bm_record_count(b, "api_calls") == 2, "2 api records")
    assert(bm_record_count(b, "data_gb") == 1, "1 data record")
    assert(bm_record_count(b, "unknown") == 0, "unknown 0")

    b = bm_reset(b, "api_calls")
    assert(bm_usage(b, "api_calls") == 0, "reset to 0")
    assert(bm_cost(b, "api_calls") == 0, "reset cost 0")
    assert(bm_total_cost(b) == 50, "total now 50")

    print("BILLING-METER KAT PASS")
