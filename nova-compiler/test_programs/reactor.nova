// NOVA REACTOR — minimal game/simulation framework.
// v0.1 ships the core loop pattern (state, update, render) — testable
// without a GPU. v0.2+ adds wgpu rendering via FFI (planned for when
// the target machine has the SDK installed). The strategy doc shows
// the API surface; v0.1 picks the parts that work today.
//
// Public API (v0.1):
//   reactor.run_n_ticks(initial_state, update_fn, n) -> final state
//   reactor.frame_to_str(grid, w, h)                 -> ASCII render
//                                                      of a 1D grid as
//                                                      a (h x w) char map

fn run_n_ticks(initial_state, update_fn, n: int)
    let s = initial_state
    let i = 0
    while i < n
        s = update_fn(s)
        i = i + 1
    s

fn frame_to_str(grid: list, w: int, h: int) -> string
    let out = ""
    let y = 0
    while y < h
        let x = 0
        while x < w
            let v = grid[y * w + x]
            if v == 0
                out = out + "."
            else if v == 1
                out = out + "#"
            else if v == 2
                out = out + "@"
            else
                out = out + "?"
            x = x + 1
        out = out + "\n"
        y = y + 1
    out

// ── v0.2 additions ───────────────────────────────────────────────────────

// Fixed-timestep loop: run for total_ms wall-clock, calling update_fn
// once every dt_ms. Returns the final state.
fn fixed_step(initial_state, update_fn, dt_ms: int, total_ms: int)
    let s = initial_state
    let t0 = time_ms()
    let elapsed = 0
    while elapsed < total_ms
        s = update_fn(s)
        sleep(dt_ms)
        elapsed = time_ms() - t0
    s

// Estimate frames-per-second from a tick count and elapsed milliseconds.
fn fps_estimate(frame_count: int, elapsed_ms: int) -> int
    if elapsed_ms <= 0
        return 0
    (frame_count * 1000) / elapsed_ms

// Bench-style: run update_fn n times, return [final_state, elapsed_ms].
fn benchmark(initial_state, update_fn, n: int) -> list
    let s = initial_state
    let t0 = clock_ns()
    let i = 0
    while i < n
        s = update_fn(s)
        i = i + 1
    let elapsed = (clock_ns() - t0) / 1000000
    let pair = []
    pair.push(s)
    pair.push(elapsed)
    pair

// Two-frame interpolator for smooth animation - returns a blended grid
// that's t fraction (0.0..1.0) of the way from prev to curr.
fn blend_grids(prev: list, curr: list, t: int) -> list
    let out = []
    let n = len(prev)
    if len(curr) < n
        n = len(curr)
    let i = 0
    while i < n
        let p = prev[i]
        let c = curr[i]
        // integer milli-blend: t in 0..1000
        let v = (p * (1000 - t) + c * t) / 1000
        out.push(v)
        i = i + 1
    out
