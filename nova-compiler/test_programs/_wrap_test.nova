// KAT for std/text/wrap — greedy word-wrap (list-of-lines) + fill (joined).
import std/text/wrap

fn _leq(label: string, got: any, want: any)
    if len(got) != len(want)
        print("FAIL " + label + ": len " + str(len(got)) + " != " + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL " + label + " [" + str(i) + "]: '" + got[i] + "' != '" + want[i] + "'")
            exit(1)
        i = i + 1

fn main()
    _leq("wrap1", wrap("the quick brown fox jumps", 10), ["the quick", "brown fox", "jumps"])
    _leq("hello", wrap("hello", 10), ["hello"])
    _leq("empty", wrap("", 10), [])
    _leq("longword", wrap("supercalifragilistic expialidocious", 10), ["supercalifragilistic", "expialidocious"])
    _leq("abc1", wrap("a b c", 1), ["a", "b", "c"])
    let want = "the quick" + chr(10) + "brown fox" + chr(10) + "jumps"
    if fill("the quick brown fox jumps", 10) != want
        print("FAIL fill")
        exit(1)
    print("_wrap_test passed")
