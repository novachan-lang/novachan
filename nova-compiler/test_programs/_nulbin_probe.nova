// Truncation detector that needs no known digests and no NUL-bearing literal.
// If a function stops at the first 0x00, then every draw whose FIRST byte is 0x00
// (p = 1/256) is processed as EMPTY -- so its output equals the output for "".
// 2000 draws => ~8 such cases if broken, exactly 0 if length-aware.
fn main()
    let n = 2000
    let empty_sha = sha256("")
    let empty_b64 = base64_encode("")
    let empty_crc = crc32("")
    let empty_mac = hmac_sha256("", "m")
    let mut as_empty_sha = 0
    let mut as_empty_b64 = 0
    let mut as_empty_crc = 0
    let mut as_empty_mac = 0
    let mut short_b64 = 0
    let mut short_len = 0
    let mut i = 0
    while i < n
        let b = random_bytes(32)
        if len(b) != 32
            short_len = short_len + 1
        if sha256(b) == empty_sha
            as_empty_sha = as_empty_sha + 1
        if base64_encode(b) == empty_b64
            as_empty_b64 = as_empty_b64 + 1
        if len(base64_encode(b)) != 44
            short_b64 = short_b64 + 1
        if crc32(b) == empty_crc
            as_empty_crc = as_empty_crc + 1
        if hmac_sha256(b, "m") == empty_mac
            as_empty_mac = as_empty_mac + 1
        i = i + 1
    print("len!=32:" + str(short_len) + " sha_as_empty:" + str(as_empty_sha) + " b64_as_empty:" + str(as_empty_b64) + " b64_shortlen:" + str(short_b64) + " crc_as_empty:" + str(as_empty_crc) + " mackey_as_empty:" + str(as_empty_mac))
    let total = short_len + as_empty_sha + as_empty_b64 + short_b64 + as_empty_crc + as_empty_mac
    if total > 0
        print("FAIL binary truncation still present (total " + str(total) + ")")
        exit(1)
    print("OK all binary-safe over " + str(n) + " draws")
