// KAT for std/text/case — identifier case conversion.
import std/text/case

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": '" + got + "' != '" + want + "'")
        exit(1)

fn main()
    cks("snake-camel", to_snake("helloWorld"), "hello_world")
    cks("snake-pascal", to_snake("HelloWorld"), "hello_world")
    cks("snake-kebab", to_snake("hello-world"), "hello_world")
    cks("snake-space", to_snake("hello world"), "hello_world")
    cks("kebab", to_kebab("helloWorld"), "hello-world")
    cks("camel", to_camel("hello_world"), "helloWorld")
    cks("camel-kebab", to_camel("hello-world"), "helloWorld")
    cks("pascal", to_pascal("hello_world"), "HelloWorld")
    cks("cap", cap_first("hello"), "Hello")
    cks("already", to_snake("already_snake"), "already_snake")
    print("_case_test passed")
