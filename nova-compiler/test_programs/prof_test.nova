// Profiler smoke test: instrument two distinct workloads with prof_enter
// /prof_exit. The runtime atexit handler dumps timing to stderr at end.
// We only verify the runtime didn't crash; the dump is observed by the
// user (visual check) — this is a SMOKE test, not an oracle test.
fn busy_loop(n: int) -> int
    let s = 0
    let i = 0
    while i < n
        s = s + i
        i = i + 1
    s

fn lighter(n: int) -> int
    let s = 0
    let i = 0
    while i < n
        s = s + 1
        i = i + 1
    s

fn main()
    let i = 0
    while i < 3
        prof_enter("busy_loop")
        let _a = busy_loop(100000)
        prof_exit("busy_loop")
        prof_enter("lighter")
        let _b = lighter(100000)
        prof_exit("lighter")
        i = i + 1
    print("prof_test passed: prof_enter/exit invoked, atexit dump pending")
