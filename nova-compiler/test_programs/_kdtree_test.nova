// KAT test for std/collections/kdtree
// Points: [2,3],[5,4],[9,6],[4,7],[8,1],[7,2]
// Hand-computed expected values in comments.

import std/collections/kdtree

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + got + " expected " + expected)
        exit(1)

fn main()
    let points = [[2,3],[5,4],[9,6],[4,7],[8,1],[7,2]]
    let t = kd_build(points)

    // KAT 1: kd_size == 6
    cki("kd_size", kd_size(t), 6)

    // KAT 2: nearest to (9,2) == [8,1]
    // distances^2: [2,3]=50, [5,4]=29, [9,6]=16, [4,7]=50, [8,1]=2, [7,2]=4
    let n1 = kd_nearest(t, 9, 2)
    cki("nearest(9,2).x", n1[0], 8)
    cki("nearest(9,2).y", n1[1], 1)

    // KAT 3: nearest to (2,3) == [2,3] (exact hit)
    let n2 = kd_nearest(t, 2, 3)
    cki("nearest(2,3).x", n2[0], 2)
    cki("nearest(2,3).y", n2[1], 3)

    // KAT 4: nearest to (6,5) == [5,4]
    // distances^2: [2,3]=20, [5,4]=2, [9,6]=10, [4,7]=8, [8,1]=20, [7,2]=10
    let n3 = kd_nearest(t, 6, 5)
    cki("nearest(6,5).x", n3[0], 5)
    cki("nearest(6,5).y", n3[1], 4)

    // KAT 5: nearest to (4,8) == [4,7]
    // distances^2: [2,3]=25, [5,4]=17, [9,6]=41, [4,7]=1, [8,1]=58, [7,2]=52
    let n4 = kd_nearest(t, 4, 8)
    cki("nearest(4,8).x", n4[0], 4)
    cki("nearest(4,8).y", n4[1], 7)

    // KAT 6: nearest to (7,2) == [7,2] (exact hit)
    let n5 = kd_nearest(t, 7, 2)
    cki("nearest(7,2).x", n5[0], 7)
    cki("nearest(7,2).y", n5[1], 2)

    // KAT 7: range(5,4, radius=2) — radius^2=4
    // distances^2 from (5,4): [2,3]=10, [5,4]=0, [9,6]=20, [4,7]=10, [8,1]=18, [7,2]=9
    // Only [5,4] qualifies (dsq=0 <= 4)
    let r1 = kd_range(t, 5, 4, 2)
    if len(r1) < 1
        print("FAIL range(5,4,2) len: got " + str(len(r1)) + " expected >=1")
        exit(1)
    // verify every returned point is within distance 2 of (5,4)
    let ri = 0
    while ri < len(r1)
        let rp = r1[ri]
        let rdx = rp[0] - 5
        let rdy = rp[1] - 4
        let rdsq = rdx * rdx + rdy * rdy
        if rdsq > 4
            print("FAIL range(5,4,2) point out of range: " + str(rp[0]) + "," + str(rp[1]) + " dsq=" + str(rdsq))
            exit(1)
        ri = ri + 1

    // KAT 8: range with radius=3 — radius^2=9
    // distances^2: [7,2]=9 qualifies too (exactly 9 <= 9), [5,4]=0
    let r2 = kd_range(t, 5, 4, 3)
    if len(r2) < 2
        print("FAIL range(5,4,3) len: got " + str(len(r2)) + " expected >=2")
        exit(1)
    let ri2 = 0
    while ri2 < len(r2)
        let rp2 = r2[ri2]
        let rdx2 = rp2[0] - 5
        let rdy2 = rp2[1] - 4
        let rdsq2 = rdx2 * rdx2 + rdy2 * rdy2
        if rdsq2 > 9
            print("FAIL range(5,4,3) point out of range: " + str(rp2[0]) + "," + str(rp2[1]) + " dsq=" + str(rdsq2))
            exit(1)
        ri2 = ri2 + 1

    // KAT 9: kd_build on a single point
    let single = [[3, 7]]
    let ts = kd_build(single)
    cki("single kd_size", kd_size(ts), 1)
    let ns = kd_nearest(ts, 0, 0)
    cki("single nearest.x", ns[0], 3)
    cki("single nearest.y", ns[1], 7)

    // KAT 10: range on empty result — radius=0 from a non-stored point
    let r3 = kd_range(t, 0, 0, 1)
    // (0,0) with radius 1: nearest point is [2,3] with dsq=13 > 1; no results
    cki("range(0,0,1) len", len(r3), 0)

    // KAT 11: nearest to point not in set, equidistant tiebreak
    // nearest to (6,1): [7,2] dsq=2, [8,1] dsq=4, [5,4] dsq=10, [2,3] dsq=20
    // so [7,2] wins
    let n6 = kd_nearest(t, 6, 1)
    cki("nearest(6,1).x", n6[0], 7)
    cki("nearest(6,1).y", n6[1], 2)

    // KAT 12: large radius captures all 6 points
    let r4 = kd_range(t, 5, 4, 20)
    cki("range(5,4,20) len", len(r4), 6)

    print("_kdtree_test passed")
