import std/typesystem/type_unify

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

// _type_eq: structural equality of two types
fn _type_eq(a, b) -> int
    let ta = type_of(a)
    let tb = type_of(b)
    if ta != tb
        return 0
    if ta == "int"
        if a == b
            return 1
        return 0
    if ta == "string"
        if a == b
            return 1
        return 0
    if ta == "list"
        if len(a) != len(b)
            return 0
        let i = 0
        while i < len(a)
            let r = _type_eq(a[i], b[i])
            if r == 0
                return 0
            i = i + 1
        return 1
    return 0

fn ckt(label, got, expected)
    let eq = _type_eq(got, expected)
    if eq == 0
        print("FAIL " + label + ": types not equal")
        exit(1)

// Apply a substitution to a type (local helper for verifying unifier results)
fn _apply(sub, t) -> any
    if type_of(t) != "list"
        return t
    if len(t) < 1
        return t
    let tag = t[0]
    if tag == "tvar"
        let k = t[1]
        let i = 0
        while i < len(sub)
            if sub[i][0] == k
                return _apply(sub, sub[i][1])
            i = i + 1
        return t
    if tag == "arr"
        let a2 = _apply(sub, t[1])
        let b2 = _apply(sub, t[2])
        let res = []
        push(res, "arr")
        push(res, a2)
        push(res, b2)
        return res
    if tag == "con"
        let name = t[1]
        let args = t[2]
        let new_args = []
        let i = 0
        while i < len(args)
            push(new_args, _apply(sub, args[i]))
            i = i + 1
        let res = []
        push(res, "con")
        push(res, name)
        push(res, new_args)
        return res
    return t

fn main()
    // KAT 1: tuni_unify(tvar(0), int) applied to tvar(0) gives int
    let sub1 = type_unify.tuni_unify(["tvar", 0], ["con", "int", []])
    cki("unify_tvar_int_not_fail", type_of(sub1) == "string", 0)
    let res1 = _apply(sub1, ["tvar", 0])
    ckt("unify_tvar0_int", res1, ["con", "int", []])

    // KAT 2: tuni_unify(arr(tvar(0),tvar(1)), arr(int,bool)) makes tvar0=int, tvar1=bool
    let sub2 = type_unify.tuni_unify(["arr", ["tvar", 0], ["tvar", 1]], ["arr", ["con", "int", []], ["con", "bool", []]])
    cki("unify_arr_not_fail", type_of(sub2) == "string", 0)
    ckt("unify_arr_tvar0", _apply(sub2, ["tvar", 0]), ["con", "int", []])
    ckt("unify_arr_tvar1", _apply(sub2, ["tvar", 1]), ["con", "bool", []])

    // KAT 3: tuni_succeeds(arr(tvar(0),tvar(0)), arr(int,bool)) = false
    // 0 cannot be both int and bool
    cki("succeeds_conflict_false", type_unify.tuni_succeeds(["arr", ["tvar", 0], ["tvar", 0]], ["arr", ["con", "int", []], ["con", "bool", []]]), 0)

    // KAT 4: tuni_occurs(0, arr(tvar(0), tvar(1))) = true
    cki("occurs_0_arr01", type_unify.tuni_occurs(0, ["arr", ["tvar", 0], ["tvar", 1]]), 1)

    // KAT 5: tuni_occurs(2, arr(tvar(0), tvar(1))) = false
    cki("occurs_2_arr01_false", type_unify.tuni_occurs(2, ["arr", ["tvar", 0], ["tvar", 1]]), 0)

    // KAT 6: tuni_unify(tvar(0), arr(tvar(0), tvar(1))) == "FAIL" (occurs check)
    let sub6 = type_unify.tuni_unify(["tvar", 0], ["arr", ["tvar", 0], ["tvar", 1]])
    cki("occurs_check_fail", sub6, "FAIL")

    // KAT 7: tuni_succeeds(list(tvar(0)), list(int)) = true
    cki("succeeds_list_int", type_unify.tuni_succeeds(["con", "list", [["tvar", 0]]], ["con", "list", [["con", "int", []]]]), 1)

    // KAT 8: tuni_succeeds(int, bool) = false
    cki("succeeds_int_bool_false", type_unify.tuni_succeeds(["con", "int", []], ["con", "bool", []]), 0)

    // KAT 9: unify two identical tvars -> empty substitution
    let sub9 = type_unify.tuni_unify(["tvar", 3], ["tvar", 3])
    cki("unify_same_tvar_empty", len(sub9), 0)

    // KAT 10: unify two different tvars -> one binding
    let sub10 = type_unify.tuni_unify(["tvar", 0], ["tvar", 1])
    cki("unify_diff_tvar_len", len(sub10), 1)

    // KAT 11: tuni_unify on mismatched constructors = FAIL
    let sub11 = type_unify.tuni_unify(["con", "int", []], ["con", "bool", []])
    cki("unify_mismatch_con_fail", sub11, "FAIL")

    // KAT 12: tuni_unify on mismatched tags = FAIL
    let sub12 = type_unify.tuni_unify(["con", "int", []], ["arr", ["tvar", 0], ["tvar", 1]])
    cki("unify_mismatch_tag_fail", sub12, "FAIL")

    // KAT 13: occurs in con args
    cki("occurs_in_con", type_unify.tuni_occurs(0, ["con", "list", [["tvar", 0]]]), 1)
    cki("occurs_not_in_con", type_unify.tuni_occurs(5, ["con", "list", [["tvar", 0]]]), 0)

    // KAT 14: tuni_unify_pair with multiple constraints
    let p1 = [["tvar", 0], ["con", "int", []]]
    let p2 = [["tvar", 1], ["con", "bool", []]]
    let pairs = []
    push(pairs, p1)
    push(pairs, p2)
    let sub14 = type_unify.tuni_unify_pair(pairs)
    cki("unify_pair_not_fail", type_of(sub14) == "string", 0)
    ckt("unify_pair_tvar0", _apply(sub14, ["tvar", 0]), ["con", "int", []])
    ckt("unify_pair_tvar1", _apply(sub14, ["tvar", 1]), ["con", "bool", []])

    // KAT 15: tuni_unify_pair with conflicting constraints -> FAIL
    let q1 = [["tvar", 0], ["con", "int", []]]
    let q2 = [["tvar", 0], ["con", "bool", []]]
    let bad_pairs = []
    push(bad_pairs, q1)
    push(bad_pairs, q2)
    let sub15 = type_unify.tuni_unify_pair(bad_pairs)
    cki("unify_pair_conflict_fail", sub15, "FAIL")

    print("PASS _type_unify_test")

main()
