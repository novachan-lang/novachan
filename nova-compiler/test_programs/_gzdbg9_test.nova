// Similar to what the module exports but in standalone
fn gz_magic_check_loc(buf: any) -> bool
    if len(buf) < 2
        return false
    if buf[0] != 31
        return false
    if buf[1] != 139
        return false
    return true

fn gz_flag_fname_loc(buf: any) -> bool
    if len(buf) < 4
        return false
    let f = buf[3]
    let b = f & 8
    if b == 8
        return true
    return false

fn ck_bool(label, got, want)
    if got != want
        let gs = "false"
        let ws = "false"
        if got
            gs = "true"
        if want
            ws = "true"
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn main()
    let buf = []
    push(buf, 31)
    push(buf, 139)
    push(buf, 8)
    push(buf, 8)
    push(buf, 0)
    push(buf, 0)
    push(buf, 0)
    push(buf, 0)
    push(buf, 0)
    push(buf, 3)
    ck_bool("magic", gz_magic_check_loc(buf), true)
    ck_bool("fname", gz_flag_fname_loc(buf), true)
    print("PASS _gzdbg9_test")
