import std/physics/momentum

fn approx(a: float, b: float) -> int
    let d = a - b
    let ad = 0.0
    if d < 0.0
        ad = 0.0 - d
    else
        ad = d
    if ad < 0.0001
        return 1
    return 0

fn main()
    // momentum(2.0, 5.0) = 10.0
    let v1 = momentum(2.0, 5.0)
    if approx(v1, 10.0) == 0
        print("FAIL momentum_basic: got " + str(v1))
        exit(1)

    // impulse(10.0, 3.0) = 30.0
    let v2 = impulse(10.0, 3.0)
    if approx(v2, 30.0) == 0
        print("FAIL impulse_basic: got " + str(v2))
        exit(1)

    // elastic: equal masses, one stationary -> velocities swap
    // v1' = ((1-1)*1 + 2*1*0)/(1+1) = 0.0
    let v3 = elastic_final_v1(1.0, 1.0, 1.0, 0.0)
    if approx(v3, 0.0) == 0
        print("FAIL elastic_equal_mass: got " + str(v3))
        exit(1)

    // elastic: m1=2, v1=3, m2=1, v2=0 => v1' = ((2-1)*3 + 2*1*0)/(2+1) = 3/3 = 1.0
    let v4 = elastic_final_v1(2.0, 3.0, 1.0, 0.0)
    if approx(v4, 1.0) == 0
        print("FAIL elastic_unequal_mass: got " + str(v4))
        exit(1)

    // inelastic_final_v(2.0, 3.0, 2.0, 0.0) = (6+0)/4 = 1.5
    let v5 = inelastic_final_v(2.0, 3.0, 2.0, 0.0)
    if approx(v5, 1.5) == 0
        print("FAIL inelastic_basic: got " + str(v5))
        exit(1)

    // inelastic: both moving
    // inelastic_final_v(3.0, 2.0, 1.0, 4.0) = (6+4)/4 = 2.5
    let v6 = inelastic_final_v(3.0, 2.0, 1.0, 4.0)
    if approx(v6, 2.5) == 0
        print("FAIL inelastic_both_moving: got " + str(v6))
        exit(1)

    print("PASS _momentum_test")
