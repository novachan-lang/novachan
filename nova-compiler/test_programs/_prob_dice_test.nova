// _prob_dice_test.nova — KAT for std/probability/prob_dice
import std/probability/prob_dice

// ckr — assert fraction [num, den] equals (wn, wd)
fn ckr(label: string, got: list, wn: int, wd: int)
    if got[0] != wn or got[1] != wd
        print("FAIL " + label + ": got=[" + str(got[0]) + "," + str(got[1]) + "] want=[" + str(wn) + "," + str(wd) + "]")
        exit(1)

// cki — assert int equality
fn cki(label: string, got: int, expected: int)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(expected))
        exit(1)

// --- pd_sum_ways ---
cki("ways_2d6_7",  pd_sum_ways(2, 6, 7),  6)
cki("ways_2d6_2",  pd_sum_ways(2, 6, 2),  1)
cki("ways_2d6_12", pd_sum_ways(2, 6, 12), 1)
cki("ways_2d6_1",  pd_sum_ways(2, 6, 1),  0)
// edge: target below minimum
cki("ways_below",  pd_sum_ways(3, 6, 2),  0)
// edge: target above maximum
cki("ways_above",  pd_sum_ways(2, 6, 13), 0)
// single die
cki("ways_1d6_3",  pd_sum_ways(1, 6, 3),  1)
cki("ways_1d6_7",  pd_sum_ways(1, 6, 7),  0)

// --- pd_total_outcomes ---
cki("total_2d6",  pd_total_outcomes(2, 6),  36)
cki("total_3d6",  pd_total_outcomes(3, 6),  216)
cki("total_1d6",  pd_total_outcomes(1, 6),  6)
cki("total_2d4",  pd_total_outcomes(2, 4),  16)

// --- pd_sum_prob ---
let p7 = pd_sum_prob(2, 6, 7)
ckr("prob_2d6_7",  p7,  1, 6)

let p2 = pd_sum_prob(2, 6, 2)
ckr("prob_2d6_2",  p2,  1, 36)

let p1 = pd_sum_prob(2, 6, 1)
ckr("prob_2d6_1",  p1,  0, 1)

// pd_sum_ways(2,6,6)=5 => 5/36
let p6 = pd_sum_prob(2, 6, 6)
ckr("prob_2d6_6",  p6,  5, 36)

// pd_sum_ways(1,6,1)=1 => 1/6
let p1d = pd_sum_prob(1, 6, 1)
ckr("prob_1d6_1",  p1d, 1, 6)

// --- pd_expected_sum_x2 ---
cki("ex2_2d6",  pd_expected_sum_x2(2, 6),  14)
cki("ex2_3d6",  pd_expected_sum_x2(3, 6),  21)
cki("ex2_1d4",  pd_expected_sum_x2(1, 4),  5)

print("PASS _prob_dice_test")
