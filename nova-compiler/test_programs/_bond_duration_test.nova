import std/finance/bond_duration

fn approx(a: float, b: float, tol: float) -> float
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < tol
        return 1.0
    return 0.0

fn main()
    // KAT 1: zero-coupon bond macaulay_duration == periods
    // All cash flow at maturity => weighted average time == maturity.
    // macaulay_duration(1000.0, 0.0, 0.05, 10) == 10.0
    let d1 = macaulay_duration(1000.0, 0.0, 0.05, 10)
    let ok1 = approx(d1, 10.0, 0.0001)
    if ok1 == 0.0
        print("FAIL bond_duration zero_coupon_duration: got=" + str(d1))
        exit(1)

    // KAT 2: coupon bond duration < maturity
    // macaulay_duration(1000.0, 0.05, 0.05, 10) should be ~8.108
    // (earlier coupons pull weighted average below maturity)
    let d2 = macaulay_duration(1000.0, 0.05, 0.05, 10)
    if d2 >= 10.0
        print("FAIL bond_duration coupon_bond_not_lt_maturity: got=" + str(d2))
        exit(1)
    let ok2 = approx(d2, 8.108, 0.05)
    if ok2 == 0.0
        print("FAIL bond_duration coupon_bond_value: got=" + str(d2))
        exit(1)

    // KAT 3: modified_duration < macaulay_duration for ytm > 0
    // modified_duration(8.108, 0.05, 1.0) == 8.108 / 1.05 == 7.722
    let md3 = modified_duration(8.108, 0.05, 1.0)
    if md3 >= 8.108
        print("FAIL bond_duration modified_not_lt_macaulay: got=" + str(md3))
        exit(1)
    let ok3 = approx(md3, 7.722, 0.005)
    if ok3 == 0.0
        print("FAIL bond_duration modified_value: got=" + str(md3))
        exit(1)

    // KAT 4: zero-coupon 1yr => duration == 1.0
    let d4 = macaulay_duration(1000.0, 0.0, 0.05, 1)
    let ok4 = approx(d4, 1.0, 0.0001)
    if ok4 == 0.0
        print("FAIL bond_duration zero_coupon_1yr: got=" + str(d4))
        exit(1)

    // KAT 5: higher coupon => shorter duration (more early cash flow weight)
    // macaulay_duration at 10% coupon should be less than at 5% coupon
    let d5a = macaulay_duration(1000.0, 0.05, 0.05, 10)
    let d5b = macaulay_duration(1000.0, 0.10, 0.05, 10)
    if d5b >= d5a
        print("FAIL bond_duration higher_coupon_shorter_duration: d5a=" + str(d5a) + " d5b=" + str(d5b))
        exit(1)

    // KAT 6: modified_duration semi-annual freq (freq=2)
    // modified_duration(8.108, 0.05, 2.0) == 8.108 / (1 + 0.05/2) == 8.108 / 1.025 == 7.91
    let md6 = modified_duration(8.108, 0.05, 2.0)
    let ok6 = approx(md6, 7.91, 0.01)
    if ok6 == 0.0
        print("FAIL bond_duration modified_semiannual: got=" + str(md6))
        exit(1)

    print("PASS _bond_duration_test")
