let s = "  hello world  "
let t = strip(s)
print(t)
assert(t == "hello world", "strip failed")

let nums = [5, 2, 8, 1, 9, 3]
let lo = min(nums)
let hi = max(nums)
print(lo)
print(hi)
assert(lo == 1, "min(list) failed")
assert(hi == 9, "max(list) failed")

let a = min(3, 7)
let b = max(3, 7)
print(a)
print(b)
assert(a == 3, "min(a,b) failed")
assert(b == 7, "max(a,b) failed")

let empty_pad = "   test   "
assert(strip(empty_pad) == "test", "strip padding failed")

let floats = [3.14, 1.0, 2.71, 0.5]
let fmin = min(floats)
let fmax = max(floats)
print(fmin)
print(fmax)

print("ALL ALIAS TESTS PASSED")
