// Canonical KAT test for std/encoding/pack (binary struct pack/unpack). Adversarially-verified vectors.
import std/encoding/pack

fn _hex(b) -> string
    let digs = "0123456789abcdef"
    let out = ""
    let n = bytes_len(b)
    let i = 0
    while i < n
        let v = bytes_get(b, i)
        out = out + char_at(digs, (v >> 4) & 15) + char_at(digs, v & 15)
        i = i + 1
    return out

fn eq_s(name: string, got: string, want: string)
    if got != want
        print("FAIL " + name + ": got '" + got + "' want '" + want + "'")
        exit(1)
    print("ok " + name)

fn eq_i(name: string, got: int, want: int)
    if got != want
        print("FAIL " + name + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("ok " + name)

fn main()
    eq_s("u32_be", _hex(pack_u32_be(16909060)), "01020304")
    eq_s("u32_le", _hex(pack_u32_le(16909060)), "04030201")
    eq_s("u16_be ffff", _hex(pack_u16_be(65535)), "ffff")
    eq_s("i16_be -1", _hex(pack_i16_be(0 - 1)), "ffff")
    eq_i("u32 roundtrip", unpack_u32_be(pack_u32_be(4000000000), 0), 4000000000)
    eq_i("i32 roundtrip", unpack_i32_be(pack_i32_be(0 - 2000000000), 0), 0 - 2000000000)
    eq_i("u16_le 513", unpack_u16_le(pack_u16_le(513), 0), 513)
    let vals = []
    push(vals, 16909060)
    push(vals, 65535)
    eq_s("fmt >IH", _hex(pack_fmt(">IH", vals)), "01020304ffff")
    let v2 = []
    push(v2, 513)
    eq_s("fmt <H (LE 513=0x0201 -> 0102)", _hex(pack_fmt("<H", v2)), "0102")
    let v3 = []
    push(v3, 100000)
    push(v3, 42)
    let rt = unpack_fmt(">IH", pack_fmt(">IH", v3))
    if rt[0] != 100000 or rt[1] != 42
        print("FAIL fmt roundtrip")
        exit(1)
    print("ok fmt roundtrip")
    print("_pack_test passed")
