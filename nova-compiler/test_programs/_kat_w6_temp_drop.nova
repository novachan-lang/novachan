fn main()
    // temps NOT retained anywhere: the intermediate str(n) feeds str_concat,
    // and the concat result is only read by len(). Nothing keeps either.
    // Use n >= 10000 so str(n) is a REAL allocation, not the small-int cache.
    let b = live_count()
    let n = 100000
    let acc = 0
    while n < 101000
        let c = "row-" + str(n)
        acc = acc + len(c)
        n = n + 1
    let d = live_count() - b
    print("temp-arg delta over 1000 iters = " + str(d))
