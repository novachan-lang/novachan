import std/raster/bresenham

// cki — check int equality; FAIL+exit(1) on mismatch.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL bresenham " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb — check bool equality; FAIL+exit(1) on mismatch.
fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL bresenham " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

// pt_eq — true iff two [x,y] points are equal.
fn pt_eq(a: list, b: list) -> bool
    a[0] == b[0] and a[1] == b[1]

// pts_eq — true iff two point lists have identical length and values.
fn pts_eq(a: list, b: list) -> bool
    let ok = true
    if len(a) != len(b)
        ok = false
    else
        let i = 0
        while i < len(a)
            if not pt_eq(a[i], b[i])
                ok = false
            i = i + 1
    ok

// pts_str — compact string representation for debugging.
fn pts_str(pp: list) -> string
    let parts = []
    let i = 0
    while i < len(pp)
        let p = pp[i]
        push(parts, "(" + str(p[0]) + "," + str(p[1]) + ")")
        i = i + 1
    join(parts, ",")

fn main()
    // KAT 1: horizontal right — bl_line(0,0,3,0) == [[0,0],[1,0],[2,0],[3,0]]
    let want1 = [[0,0],[1,0],[2,0],[3,0]]
    let got1 = bl_line(0, 0, 3, 0)
    if not pts_eq(got1, want1)
        print("FAIL bresenham kat1_horiz: got=" + pts_str(got1) + " want=" + pts_str(want1))
        exit(1)

    // KAT 2: vertical down — bl_line(0,0,0,3) == [[0,0],[0,1],[0,2],[0,3]]
    let want2 = [[0,0],[0,1],[0,2],[0,3]]
    let got2 = bl_line(0, 0, 0, 3)
    if not pts_eq(got2, want2)
        print("FAIL bresenham kat2_vert: got=" + pts_str(got2) + " want=" + pts_str(want2))
        exit(1)

    // KAT 3: diagonal — bl_line(0,0,2,2) == [[0,0],[1,1],[2,2]]
    let want3 = [[0,0],[1,1],[2,2]]
    let got3 = bl_line(0, 0, 2, 2)
    if not pts_eq(got3, want3)
        print("FAIL bresenham kat3_diag: got=" + pts_str(got3) + " want=" + pts_str(want3))
        exit(1)

    // KAT 4: shallow slope — bl_line(0,0,4,2) == [[0,0],[1,0],[2,1],[3,1],[4,2]]
    let want4 = [[0,0],[1,0],[2,1],[3,1],[4,2]]
    let got4 = bl_line(0, 0, 4, 2)
    if not pts_eq(got4, want4)
        print("FAIL bresenham kat4_shallow: got=" + pts_str(got4) + " want=" + pts_str(want4))
        exit(1)

    // KAT 5: negative direction — bl_line(0,0,-2,-2) == [[0,0],[-1,-1],[-2,-2]]
    let want5 = [[0,0],[-1,-1],[-2,-2]]
    let got5 = bl_line(0, 0, -2, -2)
    if not pts_eq(got5, want5)
        print("FAIL bresenham kat5_neg: got=" + pts_str(got5) + " want=" + pts_str(want5))
        exit(1)

    // KAT 6: single point — bl_line(2,2,2,2) == [[2,2]]
    let want6 = [[2,2]]
    let got6 = bl_line(2, 2, 2, 2)
    if not pts_eq(got6, want6)
        print("FAIL bresenham kat6_point: got=" + pts_str(got6) + " want=" + pts_str(want6))
        exit(1)

    // KAT 7: bl_points_count(0,0,3,0) == 4
    let cnt7 = bl_points_count(0, 0, 3, 0)
    cki("kat7_count_horiz", cnt7, 4)

    // KAT 8: bl_horizontal(0,3,5) produces 4 points at y=5
    let h8 = bl_horizontal(0, 3, 5)
    cki("kat8_horiz_len", len(h8), 4)
    cki("kat8_horiz_y0", h8[0][1], 5)
    cki("kat8_horiz_x0", h8[0][0], 0)
    cki("kat8_horiz_x3", h8[3][0], 3)

    // KAT 9: bl_vertical(2,0,3) produces 4 points at x=2
    let v9 = bl_vertical(2, 0, 3)
    cki("kat9_vert_len", len(v9), 4)
    cki("kat9_vert_x", v9[0][0], 2)
    cki("kat9_vert_y0", v9[0][1], 0)
    cki("kat9_vert_y3", v9[3][1], 3)

    // KAT 10: bl_slope_octant(1,0)==0 (right, shallow), bl_slope_octant(0,1)==1 (up, steep)
    cki("kat10_oct_0", bl_slope_octant(1, 0), 0)
    cki("kat10_oct_1", bl_slope_octant(0, 1), 1)
    cki("kat10_oct_4", bl_slope_octant(-1, -1), 4)

    // KAT 11: bl_reverse([[0,0],[1,1],[2,2]]) == [[2,2],[1,1],[0,0]]
    let fwd = [[0,0],[1,1],[2,2]]
    let rev = bl_reverse(fwd)
    cki("kat11_rev_len", len(rev), 3)
    cki("kat11_rev_x0", rev[0][0], 2)
    cki("kat11_rev_x2", rev[2][0], 0)

    // KAT 12: bl_line_to_surface draws pixels; check 4x4 surface
    let s12 = sur_new(4, 4, 0)
    bl_line_to_surface(s12, 0, 0, 3, 0, 7)
    cki("kat12_sur_00", sur_get(s12, 0, 0), 7)
    cki("kat12_sur_10", sur_get(s12, 1, 0), 7)
    cki("kat12_sur_30", sur_get(s12, 3, 0), 7)
    cki("kat12_sur_01", sur_get(s12, 0, 1), 0)

    // KAT 13: clipping — draw outside surface bounds, in-bounds pixels written
    let s13 = sur_new(4, 4, 0)
    bl_line_to_surface(s13, -2, 0, 5, 0, 3)
    cki("kat13_clip_00", sur_get(s13, 0, 0), 3)
    cki("kat13_clip_30", sur_get(s13, 3, 0), 3)

    // KAT 14: bl_points_count diagonal — max(2,2)+1 = 3
    cki("kat14_count_diag", bl_points_count(0, 0, 2, 2), 3)

    // KAT 15: bl_points_count steep — max(0,3)+1 = 4
    cki("kat15_count_steep", bl_points_count(0, 0, 0, 3), 4)

    print("PASS _bresenham_test")
