import std/logic/logic_karnaugh

// cki — integer known-answer check.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// ckb — boolean known-answer check.
fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got " + gs + " want " + ws)
        exit(1)

// _list_eq — compare two integer lists for equality.
fn _list_eq(a, b)
    if len(a) != len(b)
        return false
    let i = 0
    while i < len(a)
        if a[i] != b[i]
            return false
        i = i + 1
    true

fn main()
    // --- lkm_gray ---
    // G(0)=0^0=0
    cki("gray(0)=0", lkm_gray(0), 0)
    // G(1)=1^0=1
    cki("gray(1)=1", lkm_gray(1), 1)
    // G(2)=2^1=3
    cki("gray(2)=3", lkm_gray(2), 3)
    // G(3)=3^1=2
    cki("gray(3)=2", lkm_gray(3), 2)
    // G(4)=4^2=6
    cki("gray(4)=6", lkm_gray(4), 6)
    // G(5)=5^2=7
    cki("gray(5)=7", lkm_gray(5), 7)
    // G(6)=6^3=5
    cki("gray(6)=5", lkm_gray(6), 5)
    // G(7)=7^3=4
    cki("gray(7)=4", lkm_gray(7), 4)

    // --- lkm_gray_sequence ---
    let gs2 = lkm_gray_sequence(2)
    cki("gray_seq(2) len=4", len(gs2), 4)
    cki("gray_seq(2)[0]=0", gs2[0], 0)
    cki("gray_seq(2)[1]=1", gs2[1], 1)
    cki("gray_seq(2)[2]=3", gs2[2], 3)
    cki("gray_seq(2)[3]=2", gs2[3], 2)

    let gs3 = lkm_gray_sequence(3)
    ckb("gray_seq(3)==[0,1,3,2,6,7,5,4]", _list_eq(gs3, [0,1,3,2,6,7,5,4]), true)

    // --- lkm_adjacent ---
    ckb("adjacent(0,1)=true",  lkm_adjacent(0, 1), true)
    ckb("adjacent(1,0)=true",  lkm_adjacent(1, 0), true)
    ckb("adjacent(0,3)=false", lkm_adjacent(0, 3), false)
    ckb("adjacent(0,0)=false", lkm_adjacent(0, 0), false)
    ckb("adjacent(2,3)=true",  lkm_adjacent(2, 3), true)
    ckb("adjacent(1,3)=true",  lkm_adjacent(1, 3), true)
    ckb("adjacent(4,5)=true",  lkm_adjacent(4, 5), true)
    ckb("adjacent(4,6)=true",  lkm_adjacent(4, 6), true)
    ckb("adjacent(4,7)=false", lkm_adjacent(4, 7), false)

    // --- lkm_is_valid_group ---
    // [0,1] n=2: cells 00,01 — differ only in bit0, so valid (x1=0 fixed, x0 free)
    ckb("valid_group([0,1],2)=true", lkm_is_valid_group([0,1], 2), true)
    // [0,3] n=2: 00 and 11 differ in 2 bits => not a subcube
    ckb("valid_group([0,3],2)=false", lkm_is_valid_group([0,3], 2), false)
    // [0,1,2,3] n=2: all minterms = tautology cube [2,2] — valid
    ckb("valid_group([0,1,2,3],2)=true", lkm_is_valid_group([0,1,2,3], 2), true)
    // [2,3] n=2: cells 10,11 — differ only in bit0, x1=1 fixed — valid
    ckb("valid_group([2,3],2)=true", lkm_is_valid_group([2,3], 2), true)
    // [1,2] n=2: 01 and 10 differ in 2 bits — invalid
    ckb("valid_group([1,2],2)=false", lkm_is_valid_group([1,2], 2), false)
    // Single cell: size=1=2^0, nfree=0, should be valid
    ckb("valid_group([0],2)=true", lkm_is_valid_group([0], 2), true)
    ckb("valid_group([3],2)=true", lkm_is_valid_group([3], 2), true)
    // Empty: invalid
    ckb("valid_group([],2)=false", lkm_is_valid_group([], 2), false)
    // [0,1,2] n=2: size 3, not a power of 2 — invalid
    ckb("valid_group([0,1,2],2)=false", lkm_is_valid_group([0,1,2], 2), false)
    // n=3 groupings:
    // [0,1,2,3] n=3: 000,001,010,011 — bits 2 fixed at 0, bits 0,1 free — valid
    ckb("valid_group([0,1,2,3],3)=true", lkm_is_valid_group([0,1,2,3], 3), true)
    // [0,2,4,6] n=3: 000,010,100,110 — bit1 varies, bit2 varies, bit0=0 fixed — valid
    ckb("valid_group([0,2,4,6],3)=true", lkm_is_valid_group([0,2,4,6], 3), true)
    // [0,1,3] n=3: size 3, not power of 2 — invalid
    ckb("valid_group([0,1,3],3)=false", lkm_is_valid_group([0,1,3], 3), false)

    // --- lkm_group_to_cube ---
    // [0,1] n=2: andv=0, orv=1, varying=1 => bit0 free, bit1 fixed-0 => cube=[2,0]
    let c01 = lkm_group_to_cube([0,1], 2)
    ckb("group_to_cube([0,1],2)==[2,0]", _list_eq(c01, [2,0]), true)
    // [0,1,2,3] n=2 => [2,2]
    let c_all = lkm_group_to_cube([0,1,2,3], 2)
    ckb("group_to_cube([0,1,2,3],2)==[2,2]", _list_eq(c_all, [2,2]), true)
    // [0,3] n=2 => [] (invalid)
    let c_inv = lkm_group_to_cube([0,3], 2)
    ckb("group_to_cube([0,3],2)==[]", _list_eq(c_inv, []), true)
    // [2,3] n=2: andv=2, orv=3, varying=1 => bit0 free, bit1=1 fixed => cube=[2,1]
    let c23 = lkm_group_to_cube([2,3], 2)
    ckb("group_to_cube([2,3],2)==[2,1]", _list_eq(c23, [2,1]), true)
    // [1] n=2: single cell 01 => cube=[1,0]
    let c1 = lkm_group_to_cube([1], 2)
    ckb("group_to_cube([1],2)==[1,0]", _list_eq(c1, [1,0]), true)
    // [3] n=2: cell 11 => cube=[1,1]
    let c3 = lkm_group_to_cube([3], 2)
    ckb("group_to_cube([3],2)==[1,1]", _list_eq(c3, [1,1]), true)
    // n=3: [0,2,4,6] — bit0=0, bit1 free, bit2 free => cube=[0,2,2]
    let c_0246 = lkm_group_to_cube([0,2,4,6], 3)
    ckb("group_to_cube([0,2,4,6],3)==[0,2,2]", _list_eq(c_0246, [0,2,2]), true)

    // Enumeration cross-check: valid 2-element subsets of {0,1,2,3} for n=2.
    // Valid pairs (Hamming-1): (0,1), (0,2), (1,3), (2,3). Invalid: (0,3),(1,2).
    // For each valid pair, group_to_cube must return a non-empty cube whose
    // sop_to_tt (via logic_quine) equals the bitmask of the pair.
    // We instead check the cube directly: compute its coverage mask over {0,1,2,3}.
    // _cube_covers_tt(cube, n) computes the truth-table-int of the cube.
    ckb("valid_pair(0,1)=true",  lkm_is_valid_group([0,1], 2), true)
    ckb("valid_pair(0,2)=true",  lkm_is_valid_group([0,2], 2), true)
    ckb("valid_pair(1,3)=true",  lkm_is_valid_group([1,3], 2), true)
    ckb("valid_pair(2,3)=true",  lkm_is_valid_group([2,3], 2), true)
    ckb("invalid_pair(0,3)=false", lkm_is_valid_group([0,3], 2), false)
    ckb("invalid_pair(1,2)=false", lkm_is_valid_group([1,2], 2), false)
    // Cube coverage checks via direct verify (computed above):
    // [0,1]: cube=[2,0] covers {0,1} => tt mask = (1<<0)|(1<<1)=3
    // [0,2]: andv=0,orv=2,varying=2 => b0:fix-0,b1:free => cube=[0,2] covers {0,2} => mask=5
    // [1,3]: cube=[1,2] covers {1,3} => mask=10
    // [2,3]: cube=[2,1] covers {2,3} => mask=12
    let cc01 = lkm_group_to_cube([0,1], 2)
    let cc02 = lkm_group_to_cube([0,2], 2)
    let cc13 = lkm_group_to_cube([1,3], 2)
    let cc23 = lkm_group_to_cube([2,3], 2)
    ckb("cube([0,1],2)==[2,0]", _list_eq(cc01, [2,0]), true)
    ckb("cube([0,2],2)==[0,2]", _list_eq(cc02, [0,2]), true)
    ckb("cube([1,3],2)==[1,2]", _list_eq(cc13, [1,2]), true)
    ckb("cube([2,3],2)==[2,1]", _list_eq(cc23, [2,1]), true)

    print("PASS _logic_karnaugh_test")
