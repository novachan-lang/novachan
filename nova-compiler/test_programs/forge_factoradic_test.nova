import forge_factoradic

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn joinl(xs: list) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + ","
        out = out + str(xs[i])
        i = i + 1
    out

fn main()
    let fails = 0

    // num_permutations
    fails = fails + expect("nperm4", str(num_permutations(4)), "24")
    fails = fails + expect("nperm5", str(num_permutations(5)), "120")

    // factoradic
    fails = fails + expect("to_fac5", joinl(to_factoradic(5, 3)), "2,1,0")
    fails = fails + expect("to_fac3", joinl(to_factoradic(3, 3)), "1,1,0")
    fails = fails + expect("from_fac", str(from_factoradic([2, 1, 0])), "5")
    fails = fails + expect("from_fac2", str(from_factoradic([1, 1, 0])), "3")

    // perm_unrank of [0,1,2]
    fails = fails + expect("unrank30", joinl(perm_unrank(3, 0)), "0,1,2")
    fails = fails + expect("unrank31", joinl(perm_unrank(3, 1)), "0,2,1")
    fails = fails + expect("unrank32", joinl(perm_unrank(3, 2)), "1,0,2")
    fails = fails + expect("unrank35", joinl(perm_unrank(3, 5)), "2,1,0")
    fails = fails + expect("unrank40", joinl(perm_unrank(4, 0)), "0,1,2,3")
    fails = fails + expect("unrank4_23", joinl(perm_unrank(4, 23)), "3,2,1,0")

    // perm_rank
    fails = fails + expect("rank_id", str(perm_rank([0, 1, 2])), "0")
    fails = fails + expect("rank_rev", str(perm_rank([2, 1, 0])), "5")
    fails = fails + expect("rank_102", str(perm_rank([1, 0, 2])), "2")

    // round-trip: rank(unrank(4,k)) == k for all 24
    let rt_ok = 1
    let k = 0
    while k < 24
        if perm_rank(perm_unrank(4, k)) != k
            rt_ok = 0
        k = k + 1
    fails = fails + expect("roundtrip4", str(rt_ok), "1")

    // round-trip for n=5 (120)
    let rt5 = 1
    let m = 0
    while m < 120
        if perm_rank(perm_unrank(5, m)) != m
            rt5 = 0
        m = m + 1
    fails = fails + expect("roundtrip5", str(rt5), "1")

    if fails == 0
        print("forge_factoradic: all passed")
    else
        print("forge_factoradic: " + str(fails) + " FAILED")
