import std/money/validate

// _ck_b — check boolean equality.
fn _ck_b(label: string, got: bool, want: bool)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL validate " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

// _ck_i — check integer equality.
fn _ck_i(label: string, got: int, want: int)
    if got != want
        print("FAIL validate " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// _ck_s — check string equality.
fn _ck_s(label: string, got: string, want: string)
    if got != want
        print("FAIL validate " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn main()
    // mvalid_range
    _ck_b("range_in", mvalid_range(500, 0, 1000), true)
    _ck_b("range_out", mvalid_range(1500, 0, 1000), false)
    _ck_b("range_lo", mvalid_range(0, 0, 1000), true)
    _ck_b("range_hi", mvalid_range(1000, 0, 1000), true)
    _ck_b("range_neg", mvalid_range(-1, 0, 1000), false)

    // mvalid_positive
    _ck_b("positive_true", mvalid_positive(100), true)
    _ck_b("positive_false_neg", mvalid_positive(-100), false)
    _ck_b("positive_false_zero", mvalid_positive(0), false)

    // mvalid_non_negative
    _ck_b("nonneg_zero", mvalid_non_negative(0), true)
    _ck_b("nonneg_pos", mvalid_non_negative(1), true)
    _ck_b("nonneg_neg", mvalid_non_negative(-1), false)

    // mvalid_same_currency
    _ck_b("same_cur_true", mvalid_same_currency("USD", "USD"), true)
    _ck_b("same_cur_false", mvalid_same_currency("USD", "EUR"), false)
    _ck_b("same_cur_case", mvalid_same_currency("usd", "USD"), false)

    // mvalid_add_safe — no clamp
    _ck_i("add_safe_basic", mvalid_add_safe(300, 200, 1000), 500)
    // clamp upper
    _ck_i("add_safe_clamp_hi", mvalid_add_safe(800, 300, 1000), 1000)
    // clamp lower
    _ck_i("add_safe_clamp_lo", mvalid_add_safe(-800, -300, 1000), -1000)

    // mvalid_is_minor
    _ck_b("is_minor_pos", mvalid_is_minor(1234), true)
    _ck_b("is_minor_zero", mvalid_is_minor(0), true)
    _ck_b("is_minor_neg", mvalid_is_minor(-100), true)

    // mvalid_max_amount
    _ck_i("max_amount", mvalid_max_amount(), 9223372036854775)

    // mvalid_no_overflow_mul
    _ck_b("no_ovf_true", mvalid_no_overflow_mul(1000, 1000, 10000000), true)
    _ck_b("no_ovf_false", mvalid_no_overflow_mul(1000000, 1000000, 10000000), false)
    _ck_b("no_ovf_zero_b", mvalid_no_overflow_mul(1000000000, 0, 10000000), true)
    _ck_b("no_ovf_neg", mvalid_no_overflow_mul(-1000, 1000, 10000000), true)

    // mvalid_currency_match_or
    _ck_s("cur_match", mvalid_currency_match_or("USD", "USD", "MIXED"), "USD")
    _ck_s("cur_no_match", mvalid_currency_match_or("USD", "EUR", "MIXED"), "MIXED")

    // mvalid_cents_in_range
    _ck_b("cents_ok", mvalid_cents_in_range(34, 2), true)
    _ck_b("cents_zero", mvalid_cents_in_range(0, 2), true)
    _ck_b("cents_at_limit", mvalid_cents_in_range(100, 2), false)
    _ck_b("cents_neg", mvalid_cents_in_range(-1, 2), false)
    _ck_b("cents_99", mvalid_cents_in_range(99, 2), true)

    // mvalid_round_trip
    _ck_b("round_trip_basic", mvalid_round_trip(1234, 2), true)
    _ck_b("round_trip_zero", mvalid_round_trip(0, 2), true)
    _ck_b("round_trip_nodec", mvalid_round_trip(100, 0), true)

    print("PASS _mvalidate_test")
