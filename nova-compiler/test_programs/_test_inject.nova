@inject
type UserService
    db: string
    cache: string

@inject
type AuthProvider
    secret: string

fn main()
    assert(UserService__is_injectable() == 1, "injectable")
    assert(UserService__inject_deps() == "db:string, cache:string", "deps")
    assert(UserService__inject_name() == "user_service", "name")

    assert(AuthProvider__is_injectable() == 1, "auth injectable")
    assert(AuthProvider__inject_deps() == "secret:string", "auth deps")
    assert(AuthProvider__inject_name() == "auth_provider", "auth name")

    let us = UserService("pg", "redis")
    assert(us.db == "pg", "struct works")

    print("INJECT ANNOTATION TEST PASS")
