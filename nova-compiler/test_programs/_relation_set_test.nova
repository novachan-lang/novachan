import std/relation/relation_set

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let g = 0
    let w = 0
    if got
        g = 1
    if want
        w = 1
    if g != w
        print("FAIL " + label + ": got=" + str(g) + " want=" + str(w))
        exit(1)

fn ckl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL " + label + ": at " + str(i) + " got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // KAT 1: rset_union([0,2],[1,2])==[0,1,2]
    let u1 = []
    u1.push(0)
    u1.push(2)
    let u2 = []
    u2.push(1)
    u2.push(2)
    let ur = rset_union(u1, u2)
    let want_u = []
    want_u.push(0)
    want_u.push(1)
    want_u.push(2)
    ckl("kat1_union", ur, want_u)

    // KAT 2: rset_intersect([0,1,2],[1,3])==[1]
    let ia = []
    ia.push(0)
    ia.push(1)
    ia.push(2)
    let ib = []
    ib.push(1)
    ib.push(3)
    let ir = rset_intersect(ia, ib)
    let want_i = []
    want_i.push(1)
    ckl("kat2_intersect", ir, want_i)

    // KAT 3: rset_difference([0,1,2],[1])==[0,2]
    let da = []
    da.push(0)
    da.push(1)
    da.push(2)
    let db = []
    db.push(1)
    let dr = rset_difference(da, db)
    let want_d = []
    want_d.push(0)
    want_d.push(2)
    ckl("kat3_difference", dr, want_d)

    // KAT 4: rset_symdiff([0,1],[1,2])==[0,2]
    let sa = []
    sa.push(0)
    sa.push(1)
    let sb = []
    sb.push(1)
    sb.push(2)
    let sr = rset_symdiff(sa, sb)
    let want_s = []
    want_s.push(0)
    want_s.push(2)
    ckl("kat4_symdiff", sr, want_s)

    // KAT 5: rset_is_subset([1],[0,1,2])==true
    let sub1 = []
    sub1.push(1)
    let sup1 = []
    sup1.push(0)
    sup1.push(1)
    sup1.push(2)
    ckb("kat5_is_subset_true", rset_is_subset(sub1, sup1), true)

    // KAT 5b: rset_is_subset([0,3],[0,1,2])==false
    let sub2 = []
    sub2.push(0)
    sub2.push(3)
    ckb("kat5b_is_subset_false", rset_is_subset(sub2, sup1), false)

    // KAT 6: rset_is_disjoint([0],[1,2])==true
    let d1 = []
    d1.push(0)
    let d2 = []
    d2.push(1)
    d2.push(2)
    ckb("kat6_is_disjoint_true", rset_is_disjoint(d1, d2), true)

    // KAT 6b: rset_is_disjoint([0,1],[1,2])==false
    let d3 = []
    d3.push(0)
    d3.push(1)
    ckb("kat6b_is_disjoint_false", rset_is_disjoint(d3, d2), false)

    // KAT 7: len(rset_powerset([0,1,2]))==8
    let elems = []
    elems.push(0)
    elems.push(1)
    elems.push(2)
    let ps = rset_powerset(elems)
    cki("kat7_powerset_len", len(ps), 8)

    // KAT 7b: powerset of [] has 1 subset (the empty set)
    let empty_elems = []
    let ps0 = rset_powerset(empty_elems)
    cki("kat7b_powerset_empty", len(ps0), 1)

    // KAT 7c: all subsets of [0,1,2] total 8 elements summing to 0+1+2+... = correct element counts
    // Check that each subset of powerset has correct size (0..3 in some order)
    // We just verify sizes: should have 1 empty, 3 size-1, 3 size-2, 1 size-3
    let cnt0 = 0
    let cnt1 = 0
    let cnt2 = 0
    let cnt3 = 0
    let pi = 0
    while pi < len(ps)
        let sz = len(ps[pi])
        if sz == 0
            cnt0 = cnt0 + 1
        else
            if sz == 1
                cnt1 = cnt1 + 1
            else
                if sz == 2
                    cnt2 = cnt2 + 1
                else
                    cnt3 = cnt3 + 1
        pi = pi + 1
    cki("kat7c_cnt0", cnt0, 1)
    cki("kat7c_cnt1", cnt1, 3)
    cki("kat7c_cnt2", cnt2, 3)
    cki("kat7c_cnt3", cnt3, 1)

    // KAT 8: rset_cartesian([0,1],[2])==[[0,2],[1,2]]
    let ca = []
    ca.push(0)
    ca.push(1)
    let cb = []
    cb.push(2)
    let cart = rset_cartesian(ca, cb)
    cki("kat8_cart_len", len(cart), 2)
    cki("kat8_cart_0_0", cart[0][0], 0)
    cki("kat8_cart_0_1", cart[0][1], 2)
    cki("kat8_cart_1_0", cart[1][0], 1)
    cki("kat8_cart_1_1", cart[1][1], 2)

    // KAT 8b: cartesian of empty sets
    let empty_a = []
    let cart2 = rset_cartesian(empty_a, cb)
    cki("kat8b_cart_empty", len(cart2), 0)

    // KAT 9: union with empty set
    let empty_s = []
    let single = []
    single.push(3)
    let ur2 = rset_union(empty_s, single)
    cki("kat9_union_empty_len", len(ur2), 1)
    cki("kat9_union_empty_0", ur2[0], 3)

    // KAT 10: is_subset([], anything) == true
    ckb("kat10_empty_subset", rset_is_subset(empty_s, single), true)

    // KAT 11: is_disjoint([], anything) == true
    ckb("kat11_empty_disjoint", rset_is_disjoint(empty_s, single), true)

    print("PASS _relation_set_test")

main()
