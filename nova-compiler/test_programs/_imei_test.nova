// _imei_test.nova — KAT for std/validation/imei.nova

import std/validation/imei

// KAT 1: known-valid IMEI (no separators)
let r1 = vim_is_valid("490154203237518")
if r1 == false
    print("FAIL: vim_is_valid('490154203237518') expected true")
    exit(1)

// KAT 2: known-invalid IMEI (wrong check digit)
let r2 = vim_is_valid("490154203237519")
if r2 == true
    print("FAIL: vim_is_valid('490154203237519') expected false")
    exit(1)

// KAT 3: valid IMEI with dashes
let r3 = vim_is_valid("35-209900-176148-1")
if r3 == false
    print("FAIL: vim_is_valid('35-209900-176148-1') expected true")
    exit(1)

// KAT 4: too short — must be invalid
let r4 = vim_is_valid("12345")
if r4 == true
    print("FAIL: vim_is_valid('12345') expected false")
    exit(1)

// KAT 5: TAC extraction
let r5 = vim_tac("490154203237518")
if r5 != "49015420"
    print("FAIL: vim_tac expected '49015420' got " + r5)
    exit(1)

// KAT 6: check digit extraction
let r6 = vim_check_digit("490154203237518")
if r6 != "8"
    print("FAIL: vim_check_digit expected '8' got " + r6)
    exit(1)

// KAT 7: compute check digit from 14-digit prefix
let r7 = vim_compute_check("49015420323751")
if r7 != 8
    print("FAIL: vim_compute_check expected 8 got " + str(r7))
    exit(1)

// KAT 8: IMEI with spaces as separator
let r8 = vim_is_valid("490154 2032375 18")
if r8 == false
    print("FAIL: vim_is_valid with spaces expected true")
    exit(1)

print("_imei_test passed")
