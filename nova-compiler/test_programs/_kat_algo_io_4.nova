// _kat_algo_io_4 — combined KAT for 6 new pure-NOVA stdlib modules.
//
// NOTE ON THE ORIGINAL TASK SPEC: two of the six originally requested
// modules turned out to be near-total duplicates of existing std modules,
// discovered via the mandatory pre-build duplicate survey:
//   - std/algo/knapsack.nova (0/1 knapsack)  duplicates std/dp/dp_knapsack.nova
//     (kp_max_value/kp_selected/kp_fits_count, same DP). Substituted with
//     std/algo/unbounded_knapsack.nova (prefix ukn_) — the UNBOUNDED
//     knapsack variant (unlimited item reuse), a genuinely different DP
//     recurrence not covered anywhere in std/.
//   - std/algo/huffman.nova duplicates the already-thorough
//     std/compress/huffman.nova (hf_*, min-heap + pool tree) and
//     std/compress/adaptive_huffman.nova. Substituted with
//     std/algo/majority_element.nova (prefix mjr_) — Boyer-Moore majority
//     vote (n/2 and n/3 generalization), which no existing module covers.
// The other four were kept but scoped to add real, non-duplicate value on
// top of existing partial coverage (see each module's DUPLICATE-SURVEY NOTE
// header for the full comparison):
//   - std/algo/topological_sort.nova (tsrt_) — incremental builder + full
//     layer decomposition, vs. existing tk_/tp_ fixed-input sorters.
//   - std/algo/edit_distance.nova (edst_) — full edit-script backtrace +
//     similarity %, vs. existing ed_distance's distance-only rolling DP.
//   - std/io/csv_writer.nova (csvw_) — incremental builder + configurable
//     delimiter/quote, vs. existing csv_write's fixed comma/quote full-list
//     writer.
//   - std/io/ini_writer.nova (iniw_) — incremental builder + COMMENT
//     emission, which none of the three existing INI read/write modules
//     support on the write side.

import std/algo/unbounded_knapsack
import std/algo/topological_sort
import std/algo/edit_distance
import std/algo/majority_element
import std/io/csv_writer
import std/io/ini_writer

fn ck(name, got, want)
    if str(got) != str(want)
        print("FAIL " + name + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("ok " + name)

fn main()
    // ================================================================
    // std/algo/unbounded_knapsack (prefix ukn_)
    // ================================================================
    let ukn_w = [1, 3, 4, 5]
    let ukn_v = [10, 40, 50, 70]

    ck("ukn_solve classic W=8", ukn_solve(ukn_w, ukn_v, 8), 110)
    ck("ukn_counts classic W=8", str(ukn_counts(ukn_w, ukn_v, 8)), str([0, 1, 0, 1]))

    let ukn_table8 = ukn_table(ukn_w, ukn_v, 8)
    ck("ukn_table length", len(ukn_table8), 9)
    ck("ukn_table[0]", ukn_table8[0], 0)
    ck("ukn_table[8]", ukn_table8[8], 110)

    ck("ukn_solve capacity 0", ukn_solve(ukn_w, ukn_v, 0), 0)
    ck("ukn_solve empty items", ukn_solve([], [], 10), 0)

    // Single item, unlimited reuse: weight 2 value 3, capacity 7 -> 3 uses, value 9.
    ck("ukn_solve single item reuse", ukn_solve([2], [3], 7), 9)
    ck("ukn_counts single item reuse", str(ukn_counts([2], [3], 7)), str([3]))

    // Zero-weight item must be SKIPPED (not exploited for infinite value).
    ck("ukn_solve skips zero-weight item", ukn_solve([0, 2], [100, 3], 4), 6)
    ck("ukn_counts skips zero-weight item", str(ukn_counts([0, 2], [100, 3], 4)), str([0, 2]))

    // Two items, mixed weights: weight2/val3 + weight3/val4, capacity 5 -> one of each.
    ck("ukn_solve two items W=5", ukn_solve([2, 3], [3, 4], 5), 7)
    ck("ukn_counts two items W=5", str(ukn_counts([2, 3], [3, 4], 5)), str([1, 1]))
    ck("ukn_table two items W=5 [3]", ukn_table([2, 3], [3, 4], 5)[3], 4)
    ck("ukn_table two items W=5 [5]", ukn_table([2, 3], [3, 4], 5)[5], 7)

    ck("ukn_table negative capacity", str(ukn_table([1], [1], -1)), str([]))
    ck("ukn_table empty items nonzero capacity", str(ukn_table([], [], 3)), str([0, 0, 0, 0]))

    // ================================================================
    // std/algo/topological_sort (prefix tsrt_)
    // ================================================================
    // Diamond DAG: A->B, A->C, B->D, C->D.
    let diamond = tsrt_new()
    tsrt_add_edge(diamond, "A", "B")
    tsrt_add_edge(diamond, "A", "C")
    tsrt_add_edge(diamond, "B", "D")
    tsrt_add_edge(diamond, "C", "D")

    ck("tsrt_sort diamond", str(tsrt_sort(diamond)), str(["A", "B", "C", "D"]))
    ck("tsrt_has_cycle diamond", tsrt_has_cycle(diamond), 0)
    ck("tsrt_layers diamond", str(tsrt_layers(diamond)), str([["A"], ["B", "C"], ["D"]]))

    // Linear chain: A->B->C->D.
    let chain = tsrt_new()
    tsrt_add_edge(chain, "A", "B")
    tsrt_add_edge(chain, "B", "C")
    tsrt_add_edge(chain, "C", "D")

    ck("tsrt_sort chain", str(tsrt_sort(chain)), str(["A", "B", "C", "D"]))
    ck("tsrt_layers chain", str(tsrt_layers(chain)), str([["A"], ["B"], ["C"], ["D"]]))

    // Cycle: A->B, B->A.
    let cyc = tsrt_new()
    tsrt_add_edge(cyc, "A", "B")
    tsrt_add_edge(cyc, "B", "A")

    ck("tsrt_has_cycle detects cycle", tsrt_has_cycle(cyc), 1)
    ck("tsrt_sort cycle returns empty", str(tsrt_sort(cyc)), str([]))
    ck("tsrt_layers cycle returns empty", str(tsrt_layers(cyc)), str([]))

    // Self-loop: A->A is itself a cycle.
    let selfloop = tsrt_new()
    tsrt_add_edge(selfloop, "A", "A")
    ck("tsrt_has_cycle self-loop", tsrt_has_cycle(selfloop), 1)
    ck("tsrt_sort self-loop returns empty", str(tsrt_sort(selfloop)), str([]))

    // Fan-out (no merge): A->B, A->C, A->D.
    let fanout = tsrt_new()
    tsrt_add_edge(fanout, "A", "B")
    tsrt_add_edge(fanout, "A", "C")
    tsrt_add_edge(fanout, "A", "D")
    ck("tsrt_sort fanout", str(tsrt_sort(fanout)), str(["A", "B", "C", "D"]))
    ck("tsrt_layers fanout", str(tsrt_layers(fanout)), str([["A"], ["B", "C", "D"]]))
    ck("tsrt_has_cycle fanout is acyclic", tsrt_has_cycle(fanout), 0)

    ck("tsrt_layers diamond layer count", len(tsrt_layers(diamond)), 3)
    ck("tsrt_sort chain length", len(tsrt_sort(chain)), 4)

    // Duplicate edge (A->B added twice) must not corrupt indegree bookkeeping.
    let dup = tsrt_new()
    tsrt_add_edge(dup, "A", "B")
    tsrt_add_edge(dup, "A", "B")
    ck("tsrt_sort duplicate edge", str(tsrt_sort(dup)), str(["A", "B"]))
    ck("tsrt_has_cycle duplicate edge acyclic", tsrt_has_cycle(dup), 0)

    // ================================================================
    // std/algo/edit_distance (prefix edst_)
    // ================================================================
    ck("edst_distance kitten/sitting", edst_distance("kitten", "sitting"), 3)
    ck("edst_distance flaw/lawn", edst_distance("flaw", "lawn"), 2)
    ck("edst_distance empty/abc", edst_distance("", "abc"), 3)
    ck("edst_distance abc/abc", edst_distance("abc", "abc"), 0)
    ck("edst_distance empty/empty", edst_distance("", ""), 0)

    let cat_cut_ops = edst_ops("cat", "cut")
    ck("edst_ops cat->cut length", len(cat_cut_ops), 3)
    ck("edst_ops cat->cut[0]", cat_cut_ops[0], "MATCH c")
    ck("edst_ops cat->cut[1]", cat_cut_ops[1], "SUB a->u")
    ck("edst_ops cat->cut[2]", cat_cut_ops[2], "MATCH t")

    ck("edst_ops empty->ab", str(edst_ops("", "ab")), str(["INS a", "INS b"]))
    ck("edst_ops ab->empty", str(edst_ops("ab", "")), str(["DEL a", "DEL b"]))

    ck("edst_similarity identical", edst_similarity("abc", "abc"), 100)
    ck("edst_similarity both empty", edst_similarity("", ""), 100)
    ck("edst_similarity kitten/sitting", edst_similarity("kitten", "sitting"), 57)

    ck("edst_is_close within threshold", edst_is_close("kitten", "sitting", 3), 1)
    ck("edst_is_close beyond threshold", edst_is_close("kitten", "sitting", 2), 0)

    // ================================================================
    // std/io/csv_writer (prefix csvw_)
    // ================================================================
    let cw1 = csvw_new()
    csvw_add_row(cw1, ["a", "b", "c"])
    csvw_add_row(cw1, ["1", "2", "3"])
    ck("csvw_row_count basic", csvw_row_count(cw1), 2)
    ck("csvw_to_string basic", csvw_to_string(cw1), "a,b,c" + chr(10) + "1,2,3")

    let cw2 = csvw_new()
    csvw_add_row(cw2, ["hello, world", "x"])
    ck("csvw_to_string quotes comma field", csvw_to_string(cw2), chr(34) + "hello, world" + chr(34) + ",x")

    let cw3 = csvw_new()
    let quote_field = chr(34) + "quoted" + chr(34)
    csvw_add_row(cw3, [quote_field])
    let expect_doubled = chr(34) + chr(34) + chr(34) + "quoted" + chr(34) + chr(34) + chr(34)
    ck("csvw_to_string doubles internal quote", csvw_to_string(cw3), expect_doubled)

    let cw4 = csvw_new()
    csvw_add_row(cw4, ["line1" + chr(10) + "line2", "ok"])
    let expect_nl = chr(34) + "line1" + chr(10) + "line2" + chr(34) + ",ok"
    ck("csvw_to_string quotes embedded newline", csvw_to_string(cw4), expect_nl)

    let cw5 = csvw_new()
    csvw_set_delimiter(cw5, ";")
    csvw_add_row(cw5, ["a,b", "c"])
    ck("csvw_to_string custom delimiter no-quote-comma", csvw_to_string(cw5), "a,b;c")

    let cw6 = csvw_new()
    csvw_set_delimiter(cw6, ";")
    csvw_add_row(cw6, ["a;b", "c"])
    ck("csvw_to_string custom delimiter quotes itself", csvw_to_string(cw6), chr(34) + "a;b" + chr(34) + ";c")

    let cw7 = csvw_new()
    csvw_set_quote(cw7, "'")
    csvw_add_row(cw7, ["it's", "ok"])
    let expect_sq = "'it''s'" + ",ok"
    ck("csvw_to_string custom quote char", csvw_to_string(cw7), expect_sq)

    let cw8 = csvw_new()
    ck("csvw_row_count empty writer", csvw_row_count(cw8), 0)
    ck("csvw_to_string empty writer", csvw_to_string(cw8), "")

    let cw9 = csvw_new()
    csvw_add_row(cw9, ["", "x"])
    ck("csvw_to_string empty field stays unquoted", csvw_to_string(cw9), ",x")

    let cw10 = csvw_new()
    csvw_add_row(cw10, ["solo"])
    ck("csvw_to_string single-field row no delimiter", csvw_to_string(cw10), "solo")

    let cw11 = csvw_new()
    csvw_add_row(cw11, ["r1"])
    csvw_add_row(cw11, ["r2"])
    csvw_add_row(cw11, ["r3"])
    ck("csvw_row_count three rows", csvw_row_count(cw11), 3)

    let cw12 = csvw_new()
    csvw_add_row(cw12, ["a," + chr(34) + "b"])
    let expect_combo = chr(34) + "a," + chr(34) + chr(34) + "b" + chr(34)
    ck("csvw_to_string comma+quote combined escape", csvw_to_string(cw12), expect_combo)

    let cw13 = csvw_new()
    csvw_set_delimiter(cw13, "|")
    csvw_set_quote(cw13, "*")
    csvw_add_row(cw13, ["a|b", "c*d", "plain"])
    ck("csvw_to_string custom delimiter+quote compose", csvw_to_string(cw13), "*a|b*|*c**d*|plain")

    let cw14 = csvw_new()
    csvw_add_row(cw14, ["a", "b"])
    csvw_add_row(cw14, ["x", "y", "z"])
    ck("csvw_to_string ragged rows", csvw_to_string(cw14), "a,b" + chr(10) + "x,y,z")

    let cw15 = csvw_new()
    csvw_set_delimiter(cw15, chr(9))
    csvw_add_row(cw15, ["a", "b"])
    ck("csvw_to_string tab delimiter", csvw_to_string(cw15), "a" + chr(9) + "b")

    // ================================================================
    // std/io/ini_writer (prefix iniw_)
    // ================================================================
    let iw = iniw_new()
    iniw_set(iw, "", "global_key", "global_val")
    iniw_set(iw, "server", "host", "localhost")
    iniw_add_comment(iw, "server", "Server configuration")
    iniw_set(iw, "server", "port", "8080")

    ck("iniw_section_count", iniw_section_count(iw), 2)
    ck("iniw_key_count server", iniw_key_count(iw, "server"), 2)
    ck("iniw_key_count default", iniw_key_count(iw, ""), 1)
    ck("iniw_key_count missing section", iniw_key_count(iw, "nope"), 0)

    let iw_text = iniw_to_string(iw)
    ck("iniw_to_string has global key", contains(iw_text, "global_key = global_val"), true)
    ck("iniw_to_string has section header", contains(iw_text, "[server]"), true)
    ck("iniw_to_string has comment", contains(iw_text, "; Server configuration"), true)
    ck("iniw_to_string has host", contains(iw_text, "host = localhost"), true)
    ck("iniw_to_string has port", contains(iw_text, "port = 8080"), true)

    // Update-in-place preserves original position.
    iniw_set(iw, "server", "host", "127.0.0.1")
    ck("iniw_key_count unchanged after update", iniw_key_count(iw, "server"), 2)
    let iw_text2 = iniw_to_string(iw)
    ck("iniw_to_string reflects updated value", contains(iw_text2, "host = 127.0.0.1"), true)
    ck("iniw_to_string old value gone", contains(iw_text2, "host = localhost"), false)

    // Value needing quoting (contains a space).
    iniw_set(iw, "server", "note", "hello world")
    let iw_text3 = iniw_to_string(iw)
    ck("iniw_to_string quotes value with space", contains(iw_text3, "note = " + chr(34) + "hello world" + chr(34)), true)

    // Empty value must also be quoted (round-trip safety).
    iniw_set(iw, "server", "empty", "")
    let iw_text4 = iniw_to_string(iw)
    ck("iniw_to_string quotes empty value", contains(iw_text4, "empty = " + chr(34) + chr(34)), true)

    // Multi-line comment splits into multiple "; " lines.
    let iw2 = iniw_new()
    iniw_add_comment(iw2, "sec", "line1" + chr(10) + "line2")
    let iw2_text = iniw_to_string(iw2)
    ck("iniw_to_string multiline comment line1", contains(iw2_text, "; line1"), true)
    ck("iniw_to_string multiline comment line2", contains(iw2_text, "; line2"), true)

    // Exact full-text check for a minimal single-section writer.
    let iw3 = iniw_new()
    iniw_set(iw3, "a", "k", "v")
    ck("iniw_to_string exact minimal", iniw_to_string(iw3), "[a]" + chr(10) + "k = v" + chr(10))

    // ================================================================
    // std/algo/majority_element (prefix mjr_)
    // ================================================================
    ck("mjr_count basic", mjr_count([1, 2, 2, 3, 2], 2), 3)

    ck("mjr_find classic majority", str(mjr_find([2, 2, 1, 1, 1, 2, 2])), str([1, 2]))
    ck("mjr_find leetcode 3,2,3", str(mjr_find([3, 2, 3])), str([1, 3]))
    ck("mjr_find no majority", str(mjr_find([1, 2, 3, 4])), str([0, 0]))
    ck("mjr_find empty list", str(mjr_find([])), str([0, 0]))
    ck("mjr_find single element", str(mjr_find([7])), str([1, 7]))

    ck("mjr_find_n3 two winners", str(mjr_find_n3([1, 2, 1, 1, 3, 2, 2, 2])), str([1, 2]))
    ck("mjr_find_n3 no winners", str(mjr_find_n3([1, 2, 3, 4, 5, 6])), str([]))
    ck("mjr_find_n3 empty list", str(mjr_find_n3([])), str([]))

    ck("mjr_candidate raw", mjr_candidate([1, 1, 2, 2, 2]), 2)
    ck("mjr_find confirms candidate", str(mjr_find([1, 1, 2, 2, 2])), str([1, 2]))
    ck("mjr_find all-same-element", str(mjr_find([5, 5, 5, 5])), str([1, 5]))
    ck("mjr_find simple tie no majority", str(mjr_find([1, 2])), str([0, 0]))
    ck("mjr_count value absent", mjr_count([1, 2, 3], 9), 0)
    ck("mjr_find_n3 even three-way split none qualify", str(mjr_find_n3([1, 1, 2, 2, 3, 3])), str([]))
    ck("mjr_find_n3 one dominant plus singles", str(mjr_find_n3([4, 4, 4, 4, 1, 2, 3])), str([4]))
    ck("mjr_candidate all same", mjr_candidate([9, 9, 9]), 9)
    ck("mjr_find unanimous pair", str(mjr_find([3, 3])), str([1, 3]))

    print("ALL PASS")
