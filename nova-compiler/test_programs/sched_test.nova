// Stage 2a: the M:N green-task scheduler. sched_spawn creates a green task (a
// fiber); sched_run drives them cooperatively on ONE OS thread. When a green
// task blocks on a channel it PARKS (yields to the carrier) and the carrier runs
// another task — so many green tasks coordinate on one thread with no
// thread-per-task cost, and blocking-LOOKING channel ops need no async keyword.

// ── Test 1: producer/consumer with PARKING ───────────────────────────
// The consumer is scheduled first and PARKS on an empty channel; the producer
// then sends, which unparks the consumer. Proves channel-park + unpark.
let ch1 = channel()
let got = [0]

fn consumer1(c, acc)
  let i = 0
  while i < 5
    let v = receive(c)
    acc[0] = acc[0] + v
    i = i + 1

fn producer1(c)
  let i = 0
  while i < 5
    send(c, i * 10)
    i = i + 1

sched_spawn(fn(z) consumer1(ch1, got))   // runs first -> parks on empty channel
sched_spawn(fn(z) producer1(ch1))        // then sends -> unparks the consumer
sched_run()
assert(got[0] == 0 + 10 + 20 + 30 + 40, "consumer received all 5 via green parking (sum 100)")
print("PASS: producer/consumer with channel parking")

// ── Test 2: ping-pong — two tasks alternate via two channels ─────────
// Each side blocks on its inbox, so the carrier must alternate them precisely.
let a2b = channel()
let b2a = channel()
let pong_log = []

fn ping(out_ch, in_ch, log)
  let i = 0
  while i < 3
    send(out_ch, i)
    let reply = receive(in_ch)
    push(log, reply)
    i = i + 1

fn pong(in_ch, out_ch)
  let i = 0
  while i < 3
    let v = receive(in_ch)
    send(out_ch, v * 100)
    i = i + 1

sched_spawn(fn(z) ping(a2b, b2a, pong_log))
sched_spawn(fn(z) pong(a2b, b2a))
sched_run()
assert(len(pong_log) == 3, "3 ping-pong rounds")
assert(pong_log[0] == 0, "round0 reply 0*100")
assert(pong_log[1] == 100, "round1 reply 1*100")
assert(pong_log[2] == 200, "round2 reply 2*100")
print("PASS: ping-pong across two channels")

// ── Test 3: SCALE — 1000 green tasks on one OS thread ────────────────
// Each task sends 1 into a shared channel; one collector sums them all.
// 1000 fibers multiplexed on a SINGLE carrier (the no-thread-per-task win).
let hub = channel()
let total = [0]
let n_tasks = 1000

fn worker(c)
  send(c, 1)

fn collector(c, acc, count)
  let i = 0
  while i < count
    acc[0] = acc[0] + receive(c)
    i = i + 1

sched_spawn(fn(z) collector(hub, total, n_tasks))
let k = 0
while k < n_tasks
  sched_spawn(fn(z) worker(hub))
  k = k + 1
sched_run()
assert(total[0] == 1000, "collector summed all 1000 worker sends")
print("PASS: 1000 green tasks coordinating on one thread (sum " + str(total[0]) + ")")

// ── Test 4: bounded-channel BACKPRESSURE (send-side parking, F3) ─────
// A bounded channel (cap 2). The producer sends 5 items and PARKS when the
// channel is full; the consumer drains, each receive unparking the producer.
// Proves send-side green parking — backpressure without blocking the carrier.
let bch = channel_bounded(2)
let drained = []

fn bp_producer(c)
  let i = 0
  while i < 5
    send(c, i)
    i = i + 1

fn bp_consumer(c, out)
  let i = 0
  while i < 5
    push(out, receive(c))
    i = i + 1

sched_spawn(fn(z) bp_producer(bch))     // fills to 2, then PARKS on send
sched_spawn(fn(z) bp_consumer(bch, drained))
sched_run()
assert(len(drained) == 5, "consumer drained all 5 despite cap-2 backpressure")
assert(drained[0] == 0, "ordered 0")
assert(drained[4] == 4, "ordered 4")
print("PASS: bounded-channel backpressure (send-side parking)")

// ── Test 5: green-task SELECT (cooperative yield, no deadlock) ───────
// A selector green task select()s over two channels; another green task sends.
// The selector must YIELD to the carrier (not OS-spin) so the sender runs — an
// OS spin would deadlock the single carrier (the sender would never get to run).
let sc1 = channel()
let sc2 = channel()
let sel_got = []

fn selector(c1, c2, out)
  let i = 0
  while i < 3
    let r = select(c1, c2)
    push(out, r[1])
    i = i + 1

fn sel_sender(c)
  let i = 0
  while i < 3
    send(c, i * 7)
    i = i + 1

sched_spawn(fn(z) selector(sc1, sc2, sel_got))   // selects -> nothing ready -> yields to carrier
sched_spawn(fn(z) sel_sender(sc2))               // runs, sends -> selector's retry finds it
sched_run()
assert(len(sel_got) == 3, "selector got 3 values via green select")
assert(sel_got[0] == 0, "0*7")
assert(sel_got[1] == 7, "1*7")
assert(sel_got[2] == 14, "2*7")
print("PASS: green-task select (cooperative, no deadlock)")

print("ALL PASS: Stage 2a — M:N green scheduler: parking + backpressure + select")
