import std/interval/interval_arith

// iv_eq2: compare two 2-element interval lists for exact equality.
fn iv_eq2(a, b) -> bool
    if len(a) != 2
        return false
    if len(b) != 2
        return false
    if a[0] != b[0]
        return false
    if a[1] != b[1]
        return false
    return true

fn ck(label: string, got, want)
    if iv_eq2(got, want) == false
        print("FAIL " + label + ": got=[" + str(got[0]) + "," + str(got[1]) + "] want=[" + str(want[0]) + "," + str(want[1]) + "]")
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckf(label: string, got: float, want: float)
    let diff = got - want
    if diff < 0.0
        diff = 0.0 - diff
    if diff > 0.0001
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cke(label: string, got)
    if len(got) != 0
        print("FAIL " + label + ": expected empty, got len=" + str(len(got)))
        exit(1)

fn main()
    // ia_add([1,2],[3,4]) == [4,6]
    let r1 = ia_add([1, 2], [3, 4])
    ck("add-basic", r1, [4, 6])

    // ia_sub([5,7],[1,2]) == [3,6]
    let r2 = ia_sub([5, 7], [1, 2])
    ck("sub-basic", r2, [3, 6])

    // ia_mul([1,2],[3,4]) == [3,8]
    let r3 = ia_mul([1, 2], [3, 4])
    ck("mul-pos", r3, [3, 8])

    // ia_mul([-1,1],[-1,1]) == [-1,1]
    let r4 = ia_mul([-1, 1], [-1, 1])
    ck("mul-cross", r4, [-1, 1])

    // ia_mul([-2,3],[-1,4]) == [-8,12]
    let r5 = ia_mul([-2, 3], [-1, 4])
    ck("mul-neg", r5, [-8, 12])

    // ia_neg([1,3]) == [-3,-1]
    let r6 = ia_neg([1, 3])
    ck("neg", r6, [-3, -1])

    // ia_scale([1,2],-2) == [-4,-2]
    let r7 = ia_scale([1, 2], -2)
    ck("scale-neg", r7, [-4, -2])

    // ia_scale([1,2],3) == [3,6]
    let r8 = ia_scale([1, 2], 3)
    ck("scale-pos", r8, [3, 6])

    // ia_abs([-3,-1]) == [1,3]
    let r9 = ia_abs([-3, -1])
    ck("abs-neg", r9, [1, 3])

    // ia_abs([-2,3]) == [0,3]
    let r10 = ia_abs([-2, 3])
    ck("abs-strad", r10, [0, 3])

    // ia_abs([1,4]) == [1,4]
    let r11 = ia_abs([1, 4])
    ck("abs-pos", r11, [1, 4])

    // ia_pow2([2,3]) == [4,9]
    let r12 = ia_pow2([2, 3])
    ck("pow2-pos", r12, [4, 9])

    // ia_pow2([-3,-1]) == [1,9]
    let r13 = ia_pow2([-3, -1])
    ck("pow2-neg", r13, [1, 9])

    // ia_pow2([-2,3]) == [0,9]
    let r14 = ia_pow2([-2, 3])
    ck("pow2-strad", r14, [0, 9])

    // ia_contains_value([1,5],3) == true
    ckb("cv-inside", ia_contains_value([1, 5], 3), true)

    // ia_contains_value([1,5],1) == true (boundary)
    ckb("cv-lo", ia_contains_value([1, 5], 1), true)

    // ia_contains_value([1,5],5) == true (boundary)
    ckb("cv-hi", ia_contains_value([1, 5], 5), true)

    // ia_contains_value([1,5],6) == false
    ckb("cv-out", ia_contains_value([1, 5], 6), false)

    // ia_width([1,4]) == 3.0
    ckf("width", ia_width([1, 4]), 3.0)

    // ia_midpoint([1,3]) == 2.0
    ckf("midpoint", ia_midpoint([1, 3]), 2.0)

    // ia_is_valid([1,3]) == true
    ckb("valid-yes", ia_is_valid([1, 3]), true)

    // ia_is_valid([3,1]) == false
    ckb("valid-no", ia_is_valid([3, 1]), false)

    // ia_from_center(5, 2) == [3,7]
    let r15 = ia_from_center(5, 2)
    ck("from-center", r15, [3, 7])

    print("PASS _interval_arith_test")
