// List operations benchmark (vs Python)
fn list_build_and_sum(n)
    lst = []
    i = 0
    while i < n
        lst.push(i * 2 + 1)
        i = i + 1
    total = 0
    for x in lst
        total = total + x
    total

fn list_filter_sum(n)
    lst = []
    i = 0
    while i < n
        lst.push(i)
        i = i + 1
    total = 0
    for x in lst
        if x % 3 == 0
            total = total + x
    total

r1 = list_build_and_sum(100000)
r2 = list_filter_sum(100000)
print(r1)
print(r2)
