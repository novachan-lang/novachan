// _fnv64_test.nova — KAT for std/hash/fnv64
//
// Canonical vectors from the FNV specification:
//   https://datatracker.ietf.org/doc/html/draft-eastlake-fnv
//
// All expected values are expressed as (hi << 32) | lo pairs to avoid
// compiler rejection of hex literals >= 2^63 (bit 63 set).
//
// Hand-trace of h_fnv1a64("a") (byte 97 = 0x61):
//   h  = 0xCBF29CE484222325
//   h  = (h ^ 0x61) * 0x100000001B3
//   h ^ 0x61 = 0xCBF29CE484222344  (bit flip in low byte: 0x25^0x61=0x44)
//   h * prime wrapping mod 2^64 = 0xAF63DC4C8601EC8C  (reference spec)

import std/hash/fnv64

// Integer known-answer check.  Prints FAIL and exits on mismatch.
fn cki(label, got, want)
    if got != want
        print("FAIL fnv64 " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // Build expected constants as (hi << 32) | lo — same pattern the module uses.
    // offset_basis = 0xCBF29CE484222325
    let want_basis = (0xCBF29CE4 << 32) | 0x84222325

    // FNV-1a KAT 1: empty string returns the offset basis unchanged.
    cki("fnv1a64_empty", h_fnv1a64(""), want_basis)

    // FNV-1a KAT 2: "a" (byte 97) = 0xAF63DC4C8601EC8C
    let want_a = (0xAF63DC4C << 32) | 0x8601EC8C
    cki("fnv1a64_a", h_fnv1a64("a"), want_a)

    // FNV-1a KAT 3: "foobar" = 0x85944171F73967E8
    let want_foobar = (0x85944171 << 32) | 0xF73967E8
    cki("fnv1a64_foobar", h_fnv1a64("foobar"), want_foobar)

    // FNV-1 KAT 4: empty string also returns offset basis (no bytes processed).
    cki("fnv1_64_empty", h_fnv1_64(""), want_basis)

    // FNV-1 KAT 5: "a" must differ from FNV-1a "a" (different byte ordering).
    let fnv1_a = h_fnv1_64("a")
    if fnv1_a == want_a
        print("FAIL fnv64 fnv1_differs: FNV-1 and FNV-1a returned same value for non-empty input")
        exit(1)

    // FNV-1 KAT 6: "a" = 0xAF63BD4C8601B7BE (from reference implementation)
    let want_fnv1_a = (0xAF63BD4C << 32) | 0x8601B7BE
    cki("fnv1_64_a", fnv1_a, want_fnv1_a)

    // FNV-1 KAT 7: "foobar" = 0x340D8765A4DDA9C2 (from reference implementation)
    let want_fnv1_foobar = (0x340D8765 << 32) | 0xA4DDA9C2
    cki("fnv1_64_foobar", h_fnv1_64("foobar"), want_fnv1_foobar)

    // Sanity KAT 8: determinism — same input, same output.
    cki("fnv1a64_determinism", h_fnv1a64("hello world"), h_fnv1a64("hello world"))

    // Sanity KAT 9: different strings produce different hashes.
    if h_fnv1a64("foo") == h_fnv1a64("bar")
        print("FAIL fnv64 collision_check: foo and bar hash to same value")
        exit(1)

    // Sanity KAT 10: single null-like termination edge — "f" vs "fo" must differ.
    if h_fnv1a64("f") == h_fnv1a64("fo")
        print("FAIL fnv64 prefix_check: f and fo hash to same value")
        exit(1)

    print("PASS _fnv64_test")
