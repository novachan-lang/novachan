import forge_calc

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // precedence
    fails = fails + expect("prec", str(calc("1 + 2 * 3")), "7")
    fails = fails + expect("paren", str(calc("(1 + 2) * 3")), "9")
    fails = fails + expect("mix", str(calc("2 * 3 + 4 * 5")), "26")
    fails = fails + expect("chain", str(calc("3 + 4 * 2 - 1")), "10")

    // associativity
    fails = fails + expect("sub_assoc", str(calc("10 - 2 - 3")), "5")
    fails = fails + expect("div_assoc", str(calc("100 / 5 / 2")), "10")

    // modulo + integer division
    fails = fails + expect("mod", str(calc("17 % 5")), "2")
    fails = fails + expect("intdiv", str(calc("20 / 3")), "6")

    // unary minus
    fails = fails + expect("unary", str(calc("-5 + 3")), "-2")
    fails = fails + expect("unary_paren", str(calc("-(3 + 4)")), "-7")
    fails = fails + expect("mul_neg", str(calc("2 * -3")), "-6")
    fails = fails + expect("sub_neg", str(calc("7 - -3")), "10")

    // nested parens
    fails = fails + expect("nested", str(calc("((1 + 2) * (3 + 4))")), "21")
    fails = fails + expect("deep", str(calc("((2 + 3) * 4 - 6) / 2")), "7")

    // single number + whitespace
    fails = fails + expect("single", str(calc("42")), "42")
    fails = fails + expect("ws", str(calc("   8   *   4   ")), "32")

    // large (i64)
    fails = fails + expect("large", str(calc("1000000 * 1000000")), "1000000000000")

    // realistic formula
    fails = fails + expect("formula", str(calc("(100 + 2) * 3 - 6 / 2")), "303")

    if fails == 0
        print("forge_calc: all passed")
    else
        print("forge_calc: " + str(fails) + " FAILED")
