fn main()
    // repeat() builtin
    assert(repeat("abc", 3) == "abcabcabc", "repeat 3")
    assert(repeat("x", 5) == "xxxxx", "repeat 5")
    assert(repeat("hi", 1) == "hi", "repeat 1")
    assert(repeat("hi", 0) == "", "repeat 0")

    // Chaining
    let s = repeat("na", 4)
    assert(s == "nananana", "repeat 4")
    assert(len(repeat("ab", 10)) == 20, "repeat len")

    // Edge cases
    assert(repeat("", 100) == "", "repeat empty")
    assert(repeat("a", 0) == "", "repeat zero times")

    print("str_repeat_test: all passed")
