// Nested fibers: a fiber that resumes ANOTHER fiber (generator composition +
// fault isolation across the nesting). Validates that fiber_resume restores the
// RESUMER's own task state on return (Stage 2 F7) — without that fix, a parent
// that panics AFTER resuming a child would read the wrong (thread-default) fault
// state and terminate the whole program instead of being contained.

// ── Test 1: nested generator value composition ───────────────────────
// An upstream generator yields naturals; a downstream "mapper" fiber pulls from
// it (NESTED fiber_resume) and yields each value doubled.
let up_box = [0]

fn naturals(b)
  let i = 0
  while i < 100
    b[0] = i
    fiber_yield()
    i = i + 1

let up = fiber_create(fn(z) naturals(up_box))

let map_box = [0]

fn doubler(ub, mb, upf)
  let k = 0
  while k < 5
    fiber_resume(upf)        // NESTED resume: pull the next upstream value
    mb[0] = ub[0] * 2        // transform
    fiber_yield()            // yield the mapped value to the consumer
    k = k + 1

let mapped = fiber_create(fn(z) doubler(up_box, map_box, up))

let results = []
let n = 0
while n < 5
  fiber_resume(mapped)
  push(results, map_box[0])
  n = n + 1
assert(len(results) == 5, "5 mapped values")
assert(results[0] == 0, "0*2=0")
assert(results[1] == 2, "1*2=2")
assert(results[2] == 4, "2*2=4")
assert(results[4] == 8, "4*2=8")
print("PASS: nested generator composition (doubler over naturals)")

// ── Test 2: nested fault isolation ───────────────────────────────────
// A parent fiber resumes a child (which yields back), then the parent PANICS.
// The panic must be contained to the parent's OWN fiber, not corrupt the task
// state via the nested resume. (Without the F7 fix this terminates the program.)
let child_box = [0]

fn child_work(b)
  b[0] = 1
  fiber_yield()
  b[0] = 2

fn parent_work(b, childf)
  fiber_resume(childf)       // resume child; it yields back here
  panic("parent panics after nested resume")

let child = fiber_create(fn(z) child_work(child_box))
let parent = fiber_create(fn(z) parent_work(child_box, child))
let pr = fiber_resume(parent)
assert(pr == 1, "parent fiber finished — panic contained to it (not the program)")
assert(fiber_is_done(parent) == 1, "parent contained")
assert(child_box[0] == 1, "child ran up to its yield before the parent panicked")
print("PASS: nested fault isolation (parent panic after resuming child)")

print("ALL PASS: nested fibers — composition + fault isolation")
