import std/gametheory/kayles

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _kayles_test " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gs = "false"
    if got
        gs = "true"
    let ws = "false"
    if want
        ws = "true"
    if got != want
        print("FAIL _kayles_test " + label + ": got " + gs + " want " + ws)
        exit(1)

fn main()
    // ky_grundy KAT values
    cki("grundy_0", ky_grundy(0), 0)
    cki("grundy_1", ky_grundy(1), 1)
    cki("grundy_2", ky_grundy(2), 2)
    cki("grundy_3", ky_grundy(3), 3)
    cki("grundy_4", ky_grundy(4), 1)
    cki("grundy_5", ky_grundy(5), 4)
    cki("grundy_6", ky_grundy(6), 3)
    cki("grundy_7", ky_grundy(7), 2)

    // ky_is_winning
    ckb("is_winning_4", ky_is_winning(4), true)
    ckb("is_winning_0", ky_is_winning(0), false)

    // ky_grundy_row: nim-sum of [4,3] = 1 XOR 3 = 2
    let rows = []
    push(rows, 4)
    push(rows, 3)
    cki("grundy_row_43", ky_grundy_row(rows), 2)

    // ky_grundy_row: single element [5] = 4
    let rows2 = []
    push(rows2, 5)
    cki("grundy_row_5", ky_grundy_row(rows2), 4)

    print("PASS _kayles_test")
