// KAT test for std/text/nlp_eval
// Hand-computed values:
//   ev_wer("the cat sat","the cat sat") = 0/3 = 0.0
//   ev_wer("the cat sat on the mat","the cat sat") = edit_dist(6words,3words)/6 = 3/6 = 0.5
//   ev_edit_distance(['a','b','c'],['a','x','c']) = 1
//   ev_bleu("the cat","the cat") ~ 1.0 (identical, all precisions=1, BP=1)
//   ev_rouge_n("the cat sat","the cat",1): ref=["the","cat"], both in cand -> recall=1.0
//   ev_cer("abc","abc") = 0.0
//   ev_f1_tokens("a b c","a b"): cand=3tok, ref=2tok, matches=2, P=2/3, R=2/2=1
//     F1 = 2*(2/3 * 1)/(2/3+1) = (4/3)/(5/3) = 4/5 = 0.8
import std/text/nlp_eval

fn ckf(label, got, want, tol)
    let diff = got - want
    if diff < 0.0
        diff = 0.0 - diff
    if diff > tol
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── KAT 1: ev_wer identical strings ─────────────────────────────────────
    let wer_same = ev_wer("the cat sat", "the cat sat")
    ckf("wer_identical", wer_same, 0.0, 0.001)

    // ── KAT 2: ev_wer with 3 deletions out of 6 reference words ─────────────
    let wer_half = ev_wer("the cat sat on the mat", "the cat sat")
    ckf("wer_half", wer_half, 0.5, 0.001)

    // ── KAT 3: ev_wer with one substitution ─────────────────────────────────
    let wer_one = ev_wer("hello world", "hello there")
    ckf("wer_one_sub", wer_one, 0.5, 0.001)

    // ── KAT 4: ev_edit_distance on token lists ───────────────────────────────
    let ta = ["a", "b", "c"]
    let tb = ["a", "x", "c"]
    let ed1 = ev_edit_distance(ta, tb)
    cki("edit_dist_1_sub", ed1, 1)

    let tc = ["a", "b", "c"]
    let td = ["a", "b"]
    let ed2 = ev_edit_distance(tc, td)
    cki("edit_dist_1_del", ed2, 1)

    let te = []
    let tf_l = ["x"]
    let ed3 = ev_edit_distance(te, tf_l)
    cki("edit_dist_empty_to_one", ed3, 1)

    let ed4 = ev_edit_distance(ta, ta)
    cki("edit_dist_identical", ed4, 0)

    // ── KAT 5: ev_bleu identical strings ────────────────────────────────────
    let bleu_same = ev_bleu("the cat sat on the mat", "the cat sat on the mat")
    ckf("bleu_identical", bleu_same, 1.0, 0.001)

    // ── KAT 6: ev_bleu candidate shorter with exact match → < 1.0 ───────────
    // "the cat" vs "the cat sat": 1-gram P=1.0, 2-gram P=1.0 (only 1 bigram "the cat" which is in ref)
    // BP: cand_len=2 < ref_len=3 -> exp(1-3/2) = exp(-0.5) ~ 0.6065
    let bleu_short = ev_bleu_n("the cat", "the cat sat", 2)
    // Should be less than 1 due to BP penalty
    if bleu_short >= 1.0
        print("FAIL bleu_short_lt1: expected <1.0 due to brevity penalty")
        exit(1)
    if bleu_short <= 0.0
        print("FAIL bleu_short_gt0: expected >0.0 since all grams match")
        exit(1)

    // ── KAT 7: ev_rouge_n recall ────────────────────────────────────────────
    // rouge_n("the cat sat","the cat",1): ref=["the","cat"], cand=["the","cat","sat"]
    // matches: "the"->min(1,1)=1, "cat"->min(1,1)=1; total ref grams=2 -> recall=2/2=1.0
    let rouge1 = ev_rouge_n("the cat sat", "the cat", 1)
    ckf("rouge1_full_recall", rouge1, 1.0, 0.001)

    // rouge_n with no overlap -> 0.0
    let rouge1_zero = ev_rouge_n("dog cat", "the mat", 1)
    ckf("rouge1_no_overlap", rouge1_zero, 0.0, 0.001)

    // ── KAT 8: ev_rouge_n bigram ────────────────────────────────────────────
    // rouge_n("the cat sat","the cat sat",2): both have bigram "the cat" and "cat sat"
    // recall = 2/2 = 1.0
    let rouge2_same = ev_rouge_n("the cat sat", "the cat sat", 2)
    ckf("rouge2_identical", rouge2_same, 1.0, 0.001)

    // ── KAT 9: ev_rouge_l LCS F-measure ─────────────────────────────────────
    // Identical strings -> LCS = full length -> F1 = 1.0
    let rl_same = ev_rouge_l("a b c", "a b c")
    ckf("rouge_l_identical", rl_same, 1.0, 0.001)

    // LCS("a b c", "a x c"): LCS length = 2 ("a","c")
    // P = 2/3, R = 2/3, F1 = 2*(2/3)*(2/3)/((2/3)+(2/3)) = (8/9)/(4/3) = 2/3 ~ 0.6667
    let rl_partial = ev_rouge_l("a b c", "a x c")
    ckf("rouge_l_partial", rl_partial, 0.6667, 0.001)

    // ── KAT 10: ev_cer identical ─────────────────────────────────────────────
    let cer_same = ev_cer("abc", "abc")
    ckf("cer_identical", cer_same, 0.0, 0.001)

    // ev_cer with one substitution
    let cer_one = ev_cer("abc", "axc")
    ckf("cer_one_sub", cer_one, 0.3333, 0.001)

    // ── KAT 11: ev_f1_tokens ─────────────────────────────────────────────────
    // cand="a b c" (3 toks), ref="a b" (2 toks)
    // matches: a->1, b->1 => matches=2
    // P=2/3, R=2/2=1.0
    // F1 = 2*(2/3*1)/(2/3+1) = (4/3)/(5/3) = 4/5 = 0.8
    let f1 = ev_f1_tokens("a b c", "a b")
    ckf("f1_tokens", f1, 0.8, 0.001)

    // F1 of identical strings = 1.0
    let f1_same = ev_f1_tokens("hello world", "hello world")
    ckf("f1_identical", f1_same, 1.0, 0.001)

    // F1 of disjoint tokens = 0.0
    let f1_zero = ev_f1_tokens("a b c", "x y z")
    ckf("f1_no_overlap", f1_zero, 0.0, 0.001)

    // ── KAT 12: ev_tokens ────────────────────────────────────────────────────
    let toks = ev_tokens("  hello   world  ")
    cki("tokens_len", len(toks), 2)
    if toks[0] != "hello"
        print("FAIL tokens_0: expected 'hello'")
        exit(1)
    if toks[1] != "world"
        print("FAIL tokens_1: expected 'world'")
        exit(1)

    let toks_empty = ev_tokens("")
    cki("tokens_empty", len(toks_empty), 0)

    // ── KAT 13: ev_ngrams ────────────────────────────────────────────────────
    let words3 = ["a", "b", "c"]
    let bi = ev_ngrams(words3, 2)
    cki("ngrams_bigram_len", len(bi), 2)
    if bi[0] != "a b"
        print("FAIL ngrams_bi0: expected 'a b'")
        exit(1)
    if bi[1] != "b c"
        print("FAIL ngrams_bi1: expected 'b c'")
        exit(1)

    // ── KAT 14: ev_precision_n clipping ──────────────────────────────────────
    // cand="the the the" ref="the dog"
    // ref has "the" once; cand has "the" 3x -> clipped count=1
    // precision = 1/3 ~ 0.3333
    let prec = ev_precision_n("the the the", "the dog", 1)
    ckf("precision_clipped", prec, 0.3333, 0.001)

    // ── KAT 15: ev_brevity_penalty ───────────────────────────────────────────
    let bp1 = ev_brevity_penalty(10, 5)
    ckf("bp_no_penalty", bp1, 1.0, 0.001)

    // BP when cand=2, ref=4: exp(1 - 4/2) = exp(-1) ~ 0.3679
    let bp2 = ev_brevity_penalty(2, 4)
    ckf("bp_with_penalty", bp2, 0.3679, 0.001)

    print("PASS _nlp_eval_test")
