import forge_health_aggregator

fn main()
    let ha = ha_new()
    ha = ha_register(ha, "database", 1)
    ha = ha_register(ha, "cache", 0)
    ha = ha_register(ha, "api", 1)
    assert(ha_service_count(ha) == 3, "3 services")

    ha = ha_report_up(ha, "database", 100)
    ha = ha_report_up(ha, "cache", 100)
    ha = ha_report_up(ha, "api", 100)
    assert(ha_overall_status(ha) == "healthy", "all up = healthy")
    assert(ha_up_count(ha) == 3, "3 up")

    ha = ha_report_down(ha, "cache", 200)
    assert(ha_overall_status(ha) == "degraded", "non-critical down = degraded")
    let down = ha_down_services(ha)
    assert(len(down) == 1, "1 down")
    assert(down[0] == "cache", "cache down")

    ha = ha_report_down(ha, "database", 300)
    assert(ha_overall_status(ha) == "critical", "critical service down")

    ha = ha_report_up(ha, "database", 400)
    ha = ha_report_up(ha, "cache", 400)
    assert(ha_overall_status(ha) == "healthy", "recovered")

    print("HEALTH-AGGREGATOR KAT PASS")
