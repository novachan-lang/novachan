// KAT for std/game/cribbage -- Cribbage hand scoring.
// Deterministic vectors verified by hand against standard cribbage rules.
import std/game/cribbage

fn cki(label, got, want)
    if got != want
        print("FAIL cribbage " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // ── Build card helpers ────────────────────────────────────────────────────
    // The 29-point hand: three 5s + Jack-of-spades (hand), starter = 5-of-spades.
    // hand4 = [5C, 5D, 5H, JS]  starter = [5S]
    let h29 = []
    push(h29, [5, 0])
    push(h29, [5, 1])
    push(h29, [5, 2])
    push(h29, [11, 3])
    let st29 = [5, 3]

    // ── KAT: the spec-required 29-point hand ─────────────────────────────────
    cki("crib_score_29", crib_score(h29, st29), 29)

    // ── KAT: crib_pairs for four-of-a-kind (all four 5s + Jack) ───────────────
    // cards5 = five-card combined list for the 29 hand
    let cards29 = []
    push(cards29, [5, 0])
    push(cards29, [5, 1])
    push(cards29, [5, 2])
    push(cards29, [11, 3])
    push(cards29, [5, 3])
    // Four 5s => C(4,2)=6 pairs * 2 = 12 pts
    cki("crib_pairs_four5s", crib_pairs(cards29), 12)

    // ── KAT: crib_fifteens for the 29 hand ───────────────────────────────────
    // Jack=10, four 5s. Subsets summing to 15:
    //   J+5 (4 ways) = 8 pts; 5+5+5 (C(4,3)=4 ways) = 8 pts => 16 pts total
    cki("crib_fifteens_29hand", crib_fifteens(cards29), 16)

    // ── KAT: second spec hand -- hand with fifteens ───────────────────────────
    // hand4 = [5C, 10D, 5H, KS]  starter = [5D]
    // Values: 5,10,5,10,5.
    // Fifteens: 5+10=15 (6 pairs: 5C/10D,5C/KS,5H/10D,5H/KS,5D/10D,5D/KS) +
    //           5+5+5=15 (1 triple: 5C/5H/5D) = 7 subsets * 2 = 14 pts.
    // Pairs: three 5s = C(3,2)=3 pairs * 2 = 6 pts.
    // Runs: none. Flush: no. Nobs: no.
    // Total = 14+6 = 20 pts.
    let h2 = []
    push(h2, [5, 0])
    push(h2, [10, 1])
    push(h2, [5, 2])
    push(h2, [13, 3])
    let st2 = [5, 1]
    let score2 = crib_score(h2, st2)
    cki("crib_score_5T5K_st5", score2, 20)
    // Also verify fifteens specifically
    let cards2 = []
    push(cards2, [5, 0])
    push(cards2, [10, 1])
    push(cards2, [5, 2])
    push(cards2, [13, 3])
    push(cards2, [5, 1])
    // 7 subsets * 2 = 14 pts
    cki("crib_fifteens_5T5K5", crib_fifteens(cards2), 14)

    // ── KAT: pairs - basic pair (two kings) ──────────────────────────────────
    let pairhand = []
    push(pairhand, [13, 0])
    push(pairhand, [13, 1])
    push(pairhand, [2, 2])
    push(pairhand, [7, 3])
    push(pairhand, [9, 0])
    cki("crib_pairs_one_pair", crib_pairs(pairhand), 2)

    // ── KAT: pairs - three of a kind (three queens) ──────────────────────────
    let toak_hand = []
    push(toak_hand, [12, 0])
    push(toak_hand, [12, 1])
    push(toak_hand, [12, 2])
    push(toak_hand, [3, 3])
    push(toak_hand, [7, 0])
    cki("crib_pairs_three_of_kind", crib_pairs(toak_hand), 6)

    // ── KAT: pairs - no pairs ─────────────────────────────────────────────────
    let nopair = []
    push(nopair, [2, 0])
    push(nopair, [4, 1])
    push(nopair, [6, 2])
    push(nopair, [8, 3])
    push(nopair, [10, 0])
    cki("crib_pairs_none", crib_pairs(nopair), 0)

    // ── KAT: runs - run of 5 ─────────────────────────────────────────────────
    let run5 = []
    push(run5, [5, 0])
    push(run5, [6, 1])
    push(run5, [7, 2])
    push(run5, [8, 3])
    push(run5, [9, 0])
    cki("crib_runs_5", crib_runs(run5), 5)

    // ── KAT: runs - run of 4 ─────────────────────────────────────────────────
    let run4 = []
    push(run4, [5, 0])
    push(run4, [6, 1])
    push(run4, [7, 2])
    push(run4, [8, 3])
    push(run4, [11, 0])
    cki("crib_runs_4", crib_runs(run4), 4)

    // ── KAT: runs - run of 3 ─────────────────────────────────────────────────
    let run3 = []
    push(run3, [5, 0])
    push(run3, [6, 1])
    push(run3, [7, 2])
    push(run3, [2, 3])
    push(run3, [9, 0])
    cki("crib_runs_3", crib_runs(run3), 3)

    // ── KAT: runs - double run of 3 (pair within a run) ──────────────────────
    // [5,5,6,7,K] => two runs of 3 (5-6-7 doubled) = 6 pts
    let drun3 = []
    push(drun3, [5, 0])
    push(drun3, [5, 1])
    push(drun3, [6, 2])
    push(drun3, [7, 3])
    push(drun3, [13, 0])
    cki("crib_runs_double3", crib_runs(drun3), 6)

    // ── KAT: runs - triple run of 3 (three-of-a-kind within run) ─────────────
    // [5,5,5,6,7] => three runs of 3 = 9 pts
    let trun3 = []
    push(trun3, [5, 0])
    push(trun3, [5, 1])
    push(trun3, [5, 2])
    push(trun3, [6, 3])
    push(trun3, [7, 0])
    cki("crib_runs_triple3", crib_runs(trun3), 9)

    // ── KAT: runs - double run of 4 ──────────────────────────────────────────
    // [5,5,6,7,8] => two runs of 4 = 8 pts
    let drun4 = []
    push(drun4, [5, 0])
    push(drun4, [5, 1])
    push(drun4, [6, 2])
    push(drun4, [7, 3])
    push(drun4, [8, 0])
    cki("crib_runs_double4", crib_runs(drun4), 8)

    // ── KAT: runs - no run ────────────────────────────────────────────────────
    let norun = []
    push(norun, [2, 0])
    push(norun, [4, 1])
    push(norun, [6, 2])
    push(norun, [8, 3])
    push(norun, [10, 0])
    cki("crib_runs_none", crib_runs(norun), 0)

    // ── KAT: flush 4-card (hand only) ────────────────────────────────────────
    // hand=[2H,5H,9H,KH] starter=[7C]
    // Values: 2,5,9,10,7. Fifteens: 5+K(10)=15 (1), 9+? no; 2+5+? 2+5+9=16...
    // K(10)+5=15 => 2pts fifteens. Pairs: none. Runs: none. Flush: 4pts. Nobs: no.
    // Total = 2+4 = 6.
    let flush4h = []
    push(flush4h, [2, 2])
    push(flush4h, [5, 2])
    push(flush4h, [9, 2])
    push(flush4h, [13, 2])
    let flush4st = [7, 0]
    cki("crib_score_flush4", crib_score(flush4h, flush4st), 6)

    // ── KAT: flush 5-card (hand + starter same suit) ──────────────────────────
    // Same hand, starter=[7H]. Same scoring but 5-card flush => flush=5 not 4.
    // Total = 2+5 = 7.
    let flush5h = []
    push(flush5h, [2, 2])
    push(flush5h, [5, 2])
    push(flush5h, [9, 2])
    push(flush5h, [13, 2])
    let flush5st = [7, 2]
    cki("crib_score_flush5", crib_score(flush5h, flush5st), 7)

    // ── KAT: flush 4-card pure (no other scoring) ────────────────────────────
    // hand=[2H,3H,4H,9H] starter=[7C]
    // Values: 2,3,4,9,7. Fifteens: 2+3+9+? 2+3+4=9, 2+3+9=14, 2+4+9=15 YES => 2 pts
    // Runs: 2,3,4 = run of 3 = 3 pts. Pairs: none. Flush: 4 pts. Nobs: none.
    // Total = 2+3+4 = 9
    let flush4ph = []
    push(flush4ph, [2, 2])
    push(flush4ph, [3, 2])
    push(flush4ph, [4, 2])
    push(flush4ph, [9, 2])
    let flush4pst = [7, 0]
    cki("crib_score_flush4_run3", crib_score(flush4ph, flush4pst), 9)

    // ── KAT: his nobs (Jack in hand matches starter suit) ─────────────────────
    // hand=[JH(11,2), 2C(2,0), 3D(3,1), 4S(4,3)] starter=[10H(10,2)]
    // Values: J=10, 2=2, 3=3, 4=4, 10(starter)=10
    // Fifteens: J+2+3=15 YES; starter_10+2+3=15 YES => 4 pts
    // Pairs: none => 0
    // Runs: sorted ranks [2,3,4,10,11]; 2-3-4 is a run of 3 => 3 pts
    // Flush: hand suits [2,0,1,3] not all same => 0
    // Nobs: J of hearts (suit 2) starter suit 2 => 1 pt
    // Total = 4+0+3+0+1 = 8
    let nobs_h = []
    push(nobs_h, [11, 2])
    push(nobs_h, [2, 0])
    push(nobs_h, [3, 1])
    push(nobs_h, [4, 3])
    let nobs_st = [10, 2]
    cki("crib_score_nobs", crib_score(nobs_h, nobs_st), 8)

    // ── KAT: his nobs NOT scored when Jack suit != starter suit ───────────────
    // Same hand but J of spades (suit 3), starter still hearts (suit 2) -> no nobs
    // hand=[JS(11,3), 2C(2,0), 3D(3,1), 4H(4,2)] starter=[10H(10,2)]
    // Fifteens=4, Pairs=0, Runs=3, Flush=0, Nobs=0 => Total=7
    let no_nobs_h = []
    push(no_nobs_h, [11, 3])
    push(no_nobs_h, [2, 0])
    push(no_nobs_h, [3, 1])
    push(no_nobs_h, [4, 2])
    let no_nobs_st = [10, 2]
    cki("crib_score_no_nobs", crib_score(no_nobs_h, no_nobs_st), 7)

    // ── KAT: known scoring hand -- 15/2 + 15/4 + run of 3 ───────────────────
    // [7H, 8C, 9D, 5S] starter [6H]
    // Values: 7,8,9,5,6. Fifteens: 7+8=15 YES, 9+6=15 YES => 4 pts
    // Pairs: none. Runs: 5,6,7,8,9 = run of 5 => 5 pts. Flush: no. Nobs: no.
    // Total = 4+5 = 9
    let runhand = []
    push(runhand, [7, 2])
    push(runhand, [8, 0])
    push(runhand, [9, 1])
    push(runhand, [5, 3])
    let runst = [6, 2]
    cki("crib_score_run5_plus_fifteen", crib_score(runhand, runst), 9)

    print("PASS _cribbage_test")
