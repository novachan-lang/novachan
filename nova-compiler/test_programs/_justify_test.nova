// KAT for std/textlayout/justify — full justification utilities.
import std/textlayout/justify

fn cks(label, got, want)
    if got != want
        print("FAIL justify " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL justify " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(label, got, want)
    if len(got) != len(want)
        print("FAIL justify " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL justify " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // jf_gaps
    cki("gaps0", jf_gaps(1), 0)
    cki("gaps1", jf_gaps(2), 1)
    cki("gaps2", jf_gaps(3), 2)

    // jf_distribute
    ckl("dist52", jf_distribute(5, 2), [3, 2])
    ckl("dist22", jf_distribute(2, 2), [1, 1])
    ckl("dist03", jf_distribute(0, 3), [0, 0, 0])
    ckl("dist43", jf_distribute(4, 3), [2, 1, 1])

    // jf_word_count
    cki("wc1", jf_word_count("the quick fox"), 3)
    cki("wc2", jf_word_count("a"), 1)
    cki("wc3", jf_word_count(""), 0)

    // jf_is_last_line
    let xs = ["a", "b", "c"]
    if jf_is_last_line(xs, 2) != 1
        print("FAIL justify is_last_line true")
        exit(1)
    if jf_is_last_line(xs, 1) != 0
        print("FAIL justify is_last_line false")
        exit(1)

    // jf_justify — core cases
    // "the quick fox": 3+5+3=11 chars, 2 gaps, total 13; width=15 -> extra=2, 1 per gap
    cks("jfy1", jf_justify("the quick fox", 15), "the  quick  fox")
    // "a b c": 3 chars, 2 gaps, total 5; width=7 -> extra=2, 1 per gap
    cks("jfy2", jf_justify("a b c", 7), "a  b  c")
    // single word: pad right
    cks("jfy3", jf_justify("word", 8), "word    ")
    // already exact width: no change
    cks("jfy4", jf_justify("hello world", 11), "hello world")
    // two words: extra space all goes in 1 gap
    // "ab cd": 2+2=4 chars, 1 gap, width=8 -> extra=3 -> gap gets 1+3=4 spaces
    cks("jfy5", jf_justify("ab cd", 8), "ab    cd")

    // jf_justify_text: wrap then justify all but last line
    let nl = chr(10)
    let paragraph = "the quick brown fox jumps over the lazy dog"
    let result = jf_justify_text(paragraph, 20)
    let rlines = split(result, nl)
    // Every line except the last must be exactly 20 chars (or be the only line).
    let rn = len(rlines)
    let i = 0
    while i < rn - 1
        if len(rlines[i]) != 20
            print("FAIL justify jf_justify_text line " + str(i) + " len=" + str(len(rlines[i])) + " want=20")
            exit(1)
        i = i + 1

    print("PASS _justify_test")
