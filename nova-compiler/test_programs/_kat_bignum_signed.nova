// ============================================================================
// Known-answer test for std/numeric/bignum SIGNED arithmetic (task #13).
// ============================================================================
// Every expected value below was derived independently (by hand, shown in the
// comments) -- NOT copied from an unverified source. The two big vectors were
// re-derived because the values suggested in the task brief were WRONG:
//
//   (-123456789012345678901234567890) + (98765432109876543210)
//     Opposite signs, |A|>|B| -> -(|A|-|B|). Subtract in 10-digit chunks:
//       hi:  1234567890 - 0        - borrow(1) = 1234567889
//       mid: 1234567890 - 9876543210 - borrow(1) -> 1358024679 (borrow 1)
//       lo:  1234567890 - 9876543210            -> 1358024680 (borrow 1)
//     = -123456788913580246791358024680
//
//   (-999999999999999999) * (-1000000000001)  = (10^18-1)*(10^12+1)
//     = 10^30 + 10^18 - 10^12 - 1
//     = 1000000000000999998999999999999   (31 digits)
//
// Prints "BIGNUM_SIGNED KAT PASS" on success, else the mismatch and exit(1).
// ============================================================================
import std/numeric/bignum

fn fail(msg: string)
    print("BIGNUM_SIGNED KAT FAIL " + msg)
    exit(1)

fn eq_s(name: string, got: string, want: string)
    if got != want
        fail(name + ": got '" + got + "' want '" + want + "'")

// unwrap the Ok Signum from a checked div/mod Result (test context only)
fn uw(r: Result) -> dict
    match r
        Ok(v) =>
            return v
        Err(e) =>
            fail("unexpected err: " + e)
            return sn_from_str("0")

// Check q = a/b and r = a%b against expected strings AND the exact identity
// a == q*b + r (the definition of truncated division), for any sign combo.
fn check_divmod(a: string, b: string, wq: string, wr: string)
    let av = sn_from_str(a)
    let bv = sn_from_str(b)
    let q = uw(sn_div(av, bv))
    let r = uw(sn_mod(av, bv))
    eq_s(a + "/" + b, sn_to_str(q), wq)
    eq_s(a + "%" + b, sn_to_str(r), wr)
    let recon = sn_add(sn_mul(q, bv), r)
    if sn_cmp(recon, av) != 0
        fail("identity q*b+r != a for " + a + "," + b)

fn main()
    // ---- big negative + positive, crossing far past zero ----
    let a = sn_from_str("-123456789012345678901234567890")
    let b = sn_from_str("98765432109876543210")
    eq_s("neg+pos cross", sn_to_str(sn_add(a, b)), "-123456788913580246791358024680")
    // commutative: same the other way around
    eq_s("pos+neg cross", sn_to_str(sn_add(b, a)), "-123456788913580246791358024680")

    // ---- big neg * neg = pos ----
    let c = sn_from_str("-999999999999999999")
    let d = sn_from_str("-1000000000001")
    eq_s("neg*neg", sn_to_str(sn_mul(c, d)), "1000000000000999998999999999999")

    // ---- product sign: neg*pos = neg (123*456 = 56088) ----
    eq_s("neg*pos", sn_to_str(sn_mul(sn_from_str("-123"), sn_from_str("456"))), "-56088")
    eq_s("pos*neg", sn_to_str(sn_mul(sn_from_str("123"), sn_from_str("-456"))), "-56088")

    // ---- add landing exactly on zero, and one step past ----
    eq_s("to zero", sn_to_str(sn_add(sn_from_str("-100"), sn_from_str("100"))), "0")
    eq_s("past zero", sn_to_str(sn_add(sn_from_str("-1000000000000000000"), sn_from_str("999999999999999999"))), "-1")

    // ---- subtraction with signs (uses magnitude compare + borrow) ----
    eq_s("5-8", sn_to_str(sn_sub(sn_from_str("5"), sn_from_str("8"))), "-3")
    eq_s("-5--8", sn_to_str(sn_sub(sn_from_str("-5"), sn_from_str("-8"))), "3")
    eq_s("-8-5", sn_to_str(sn_sub(sn_from_str("-8"), sn_from_str("5"))), "-13")

    // ---- truncated div / mod full sign matrix (identity-checked inside) ----
    check_divmod("-7", "3", "-2", "-1")
    check_divmod("7", "-3", "-2", "1")
    check_divmod("-7", "-3", "2", "-1")
    check_divmod("7", "3", "2", "1")
    check_divmod("-83810205", "6789", "-12345", "0")
    // dividend smaller than divisor: quotient 0, remainder = dividend (signed)
    check_divmod("-3", "10", "0", "-3")

    // ---- negate / abs / parse ----
    eq_s("neg of -42", sn_to_str(sn_neg(sn_from_str("-42"))), "42")
    eq_s("neg of 42", sn_to_str(sn_neg(sn_from_str("42"))), "-42")
    eq_s("abs -42", sn_to_str(sn_abs(sn_from_str("-42"))), "42")
    eq_s("parse -123", sn_to_str(sn_from_str("-123")), "-123")
    eq_s("parse +9", sn_to_str(sn_from_str("+9")), "9")

    // ---- signed compare ----
    if sn_cmp(sn_from_str("-100"), sn_from_str("2")) != 0 - 1
        fail("cmp -100 < 2")
    if sn_cmp(sn_from_str("-5"), sn_from_str("-3")) != 0 - 1
        fail("cmp -5 < -3")
    if sn_cmp(sn_from_str("-3"), sn_from_str("-5")) != 1
        fail("cmp -3 > -5")

    // ---- division by zero -> err (Result), never a crash / silent zero ----
    match sn_div(sn_from_str("5"), sn_from_str("0"))
        Ok(v) =>
            fail("divzero returned ok")
        Err(e) =>
            print("ok divzero -> " + e)
    match sn_mod(sn_from_str("-5"), sn_from_str("0"))
        Ok(v) =>
            fail("modzero returned ok")
        Err(e) =>
            print("ok modzero -> " + e)

    print("BIGNUM_SIGNED KAT PASS")
