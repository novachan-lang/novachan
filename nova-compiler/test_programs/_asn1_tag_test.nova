// _asn1_tag_test — KAT for std/data/asn1_tag
//
// Verifies:
//   KAT1: asn1_tag_encode(0,0,2) == [0x02]            (INTEGER, universal primitive)
//   KAT2: asn1_tag_encode(0,1,16) == [0x30]           (SEQUENCE, universal constructed)
//   KAT3: asn1_tag_encode(2,1,0) == [0xA0]            (context [0] constructed)
//   KAT4: asn1_tag_encode(0,0,31) == [0x1F, 0x1F]     (high-tag universal 31)
//   KAT5: asn1_tag_encode(0,0,128) == [0x1F,0x81,0x00](high-tag number 128)
//   KAT6-10: round-trips for all 5 above via asn1_tag_decode
//   KAT11: decode malformed (empty) returns next_pos=-1
//   KAT12: application constructed 3 -> (1<<6)|(1<<5)|3 = 64+32+3 = 99 = 0x63

import std/data/asn1_tag

// ── KAT1: INTEGER tag (universal primitive 2) ────────────────────────────────
let k1 = asn1_tag_encode(0, 0, 2)
if bytes_len(k1) != 1
    print("FAIL asn1_tag KAT1: length != 1, got " + str(bytes_len(k1)))
    exit(1)
if bytes_get(k1, 0) != 2
    print("FAIL asn1_tag KAT1: byte0 != 0x02, got " + str(bytes_get(k1, 0)))
    exit(1)
print("PASS KAT1: encode(0,0,2) == [0x02]")

// ── KAT2: SEQUENCE tag (universal constructed 16) ────────────────────────────
let k2 = asn1_tag_encode(0, 1, 16)
if bytes_len(k2) != 1
    print("FAIL asn1_tag KAT2: length != 1")
    exit(1)
if bytes_get(k2, 0) != 48
    print("FAIL asn1_tag KAT2: byte0 != 0x30 (48), got " + str(bytes_get(k2, 0)))
    exit(1)
print("PASS KAT2: encode(0,1,16) == [0x30]")

// ── KAT3: context [0] constructed -> 0xA0 = 160 ─────────────────────────────
// class=2 -> bits 7-6 = 10; constructed=1 -> bit 5 = 1; number=0
// = (2<<6)|(1<<5)|0 = 128+32+0 = 160 = 0xA0
let k3 = asn1_tag_encode(2, 1, 0)
if bytes_len(k3) != 1
    print("FAIL asn1_tag KAT3: length != 1")
    exit(1)
if bytes_get(k3, 0) != 160
    print("FAIL asn1_tag KAT3: byte0 != 0xA0 (160), got " + str(bytes_get(k3, 0)))
    exit(1)
print("PASS KAT3: encode(2,1,0) == [0xA0]")

// ── KAT4: high-tag-number form: universal primitive 31 -> [0x1F, 0x1F] ───────
// First byte: (0<<6)|(0<<5)|0x1F = 31 = 0x1F
// Number 31 in base-128: 31 < 128, single byte = 31 = 0x1F (no high bit set)
let k4 = asn1_tag_encode(0, 0, 31)
if bytes_len(k4) != 2
    print("FAIL asn1_tag KAT4: length != 2, got " + str(bytes_len(k4)))
    exit(1)
if bytes_get(k4, 0) != 31
    print("FAIL asn1_tag KAT4: byte0 != 0x1F (31), got " + str(bytes_get(k4, 0)))
    exit(1)
if bytes_get(k4, 1) != 31
    print("FAIL asn1_tag KAT4: byte1 != 0x1F (31), got " + str(bytes_get(k4, 1)))
    exit(1)
print("PASS KAT4: encode(0,0,31) == [0x1F, 0x1F]")

// ── KAT5: high-tag universal 128 -> [0x1F, 0x81, 0x00] ──────────────────────
// First byte: 0x1F
// 128 in base-128: 128 = 1*128 + 0 -> limbs LSB-first [0, 1] -> big-endian [1, 0]
// All but last get high bit set: [1|0x80, 0] = [0x81, 0x00]
let k5 = asn1_tag_encode(0, 0, 128)
if bytes_len(k5) != 3
    print("FAIL asn1_tag KAT5: length != 3, got " + str(bytes_len(k5)))
    exit(1)
if bytes_get(k5, 0) != 31
    print("FAIL asn1_tag KAT5: byte0 != 0x1F (31), got " + str(bytes_get(k5, 0)))
    exit(1)
if bytes_get(k5, 1) != 129
    print("FAIL asn1_tag KAT5: byte1 != 0x81 (129), got " + str(bytes_get(k5, 1)))
    exit(1)
if bytes_get(k5, 2) != 0
    print("FAIL asn1_tag KAT5: byte2 != 0x00, got " + str(bytes_get(k5, 2)))
    exit(1)
print("PASS KAT5: encode(0,0,128) == [0x1F, 0x81, 0x00]")

// ── KAT6: round-trip encode(0,0,2) ───────────────────────────────────────────
let rt1 = asn1_tag_decode(k1, 0)
let rt1_info = rt1[0]
let rt1_next = rt1[1]
if rt1_next != 1
    print("FAIL asn1_tag KAT6: next_pos != 1, got " + str(rt1_next))
    exit(1)
if rt1_info["class"] != 0
    print("FAIL asn1_tag KAT6: class != 0, got " + str(rt1_info["class"]))
    exit(1)
if rt1_info["constructed"] != 0
    print("FAIL asn1_tag KAT6: constructed != 0, got " + str(rt1_info["constructed"]))
    exit(1)
if rt1_info["number"] != 2
    print("FAIL asn1_tag KAT6: number != 2, got " + str(rt1_info["number"]))
    exit(1)
print("PASS KAT6: round-trip encode(0,0,2)")

// ── KAT7: round-trip encode(0,1,16) ──────────────────────────────────────────
let rt2 = asn1_tag_decode(k2, 0)
let rt2_info = rt2[0]
let rt2_next = rt2[1]
if rt2_next != 1
    print("FAIL asn1_tag KAT7: next_pos != 1, got " + str(rt2_next))
    exit(1)
if rt2_info["class"] != 0
    print("FAIL asn1_tag KAT7: class != 0")
    exit(1)
if rt2_info["constructed"] != 1
    print("FAIL asn1_tag KAT7: constructed != 1, got " + str(rt2_info["constructed"]))
    exit(1)
if rt2_info["number"] != 16
    print("FAIL asn1_tag KAT7: number != 16, got " + str(rt2_info["number"]))
    exit(1)
print("PASS KAT7: round-trip encode(0,1,16)")

// ── KAT8: round-trip encode(2,1,0) ───────────────────────────────────────────
let rt3 = asn1_tag_decode(k3, 0)
let rt3_info = rt3[0]
let rt3_next = rt3[1]
if rt3_next != 1
    print("FAIL asn1_tag KAT8: next_pos != 1, got " + str(rt3_next))
    exit(1)
if rt3_info["class"] != 2
    print("FAIL asn1_tag KAT8: class != 2, got " + str(rt3_info["class"]))
    exit(1)
if rt3_info["constructed"] != 1
    print("FAIL asn1_tag KAT8: constructed != 1")
    exit(1)
if rt3_info["number"] != 0
    print("FAIL asn1_tag KAT8: number != 0, got " + str(rt3_info["number"]))
    exit(1)
print("PASS KAT8: round-trip encode(2,1,0)")

// ── KAT9: round-trip encode(0,0,31) high-tag ─────────────────────────────────
let rt4 = asn1_tag_decode(k4, 0)
let rt4_info = rt4[0]
let rt4_next = rt4[1]
if rt4_next != 2
    print("FAIL asn1_tag KAT9: next_pos != 2, got " + str(rt4_next))
    exit(1)
if rt4_info["class"] != 0
    print("FAIL asn1_tag KAT9: class != 0")
    exit(1)
if rt4_info["constructed"] != 0
    print("FAIL asn1_tag KAT9: constructed != 0")
    exit(1)
if rt4_info["number"] != 31
    print("FAIL asn1_tag KAT9: number != 31, got " + str(rt4_info["number"]))
    exit(1)
print("PASS KAT9: round-trip encode(0,0,31)")

// ── KAT10: round-trip encode(0,0,128) high-tag ───────────────────────────────
let rt5 = asn1_tag_decode(k5, 0)
let rt5_info = rt5[0]
let rt5_next = rt5[1]
if rt5_next != 3
    print("FAIL asn1_tag KAT10: next_pos != 3, got " + str(rt5_next))
    exit(1)
if rt5_info["class"] != 0
    print("FAIL asn1_tag KAT10: class != 0")
    exit(1)
if rt5_info["constructed"] != 0
    print("FAIL asn1_tag KAT10: constructed != 0")
    exit(1)
if rt5_info["number"] != 128
    print("FAIL asn1_tag KAT10: number != 128, got " + str(rt5_info["number"]))
    exit(1)
print("PASS KAT10: round-trip encode(0,0,128)")

// ── KAT11: decode malformed input (empty bytes) returns next_pos = -1 ─────────
let empty_b = bytes(0)
let err_r = asn1_tag_decode(empty_b, 0)
let err_next = err_r[1]
if err_next != -1
    print("FAIL asn1_tag KAT11: malformed should return -1, got " + str(err_next))
    exit(1)
print("PASS KAT11: malformed input returns next_pos=-1")

// ── KAT12: application constructed 3 -> 0x63 = 99 ───────────────────────────
// class=1 -> bits 7-6 = 01; constructed=1 -> bit 5 = 1; number=3
// = (1<<6)|(1<<5)|3 = 64+32+3 = 99 = 0x63
let k12 = asn1_tag_encode(1, 1, 3)
if bytes_len(k12) != 1
    print("FAIL asn1_tag KAT12: length != 1")
    exit(1)
if bytes_get(k12, 0) != 99
    print("FAIL asn1_tag KAT12: byte0 != 0x63 (99), got " + str(bytes_get(k12, 0)))
    exit(1)
let rt12 = asn1_tag_decode(k12, 0)
let rt12_info = rt12[0]
let rt12_next = rt12[1]
if rt12_next != 1
    print("FAIL asn1_tag KAT12: next_pos != 1")
    exit(1)
if rt12_info["class"] != 1
    print("FAIL asn1_tag KAT12: class != 1, got " + str(rt12_info["class"]))
    exit(1)
if rt12_info["constructed"] != 1
    print("FAIL asn1_tag KAT12: constructed != 1")
    exit(1)
if rt12_info["number"] != 3
    print("FAIL asn1_tag KAT12: number != 3, got " + str(rt12_info["number"]))
    exit(1)
print("PASS KAT12: encode/decode application constructed 3")

// ── KAT13: out-of-bounds pos returns -1 ──────────────────────────────────────
let oob_r = asn1_tag_decode(k1, 10)
if oob_r[1] != -1
    print("FAIL asn1_tag KAT13: out-of-bounds should return -1")
    exit(1)
print("PASS KAT13: out-of-bounds pos returns -1")

// ── KAT14: truncated high-tag (only first byte, no continuation) returns -1 ──
let trunc_b = bytes(0)
trunc_b = bytes_append(trunc_b, 31)
let trunc_r = asn1_tag_decode(trunc_b, 0)
if trunc_r[1] != -1
    print("FAIL asn1_tag KAT14: truncated high-tag should return -1")
    exit(1)
print("PASS KAT14: truncated high-tag returns -1")

print("PASS _asn1_tag_test")
