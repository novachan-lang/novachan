import forge_tfidf

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn nearp(name: string, a: float, b: float) -> int
    let d = a - b
    if d > -0.001 and d < 0.001
        return 0
    print("FAIL " + name + ": got=" + str(a) + " want~=" + str(b))
    1

fn main()
    let fails = 0

    // corpus: 3 documents, N=3
    let docs = [["the", "cat", "sat"], ["the", "dog", "ran"], ["the", "cat", "ran"]]
    let idf = tfidf_fit(docs)

    // idf: "the" in all 3 -> ln(3/3)=0 ; "sat" in 1 -> ln(3)=1.0986 ; "cat" in 2 -> ln(1.5)=0.4055
    fails = fails + nearp("idf_the", tfidf_idf(idf, "the"), 0.0)
    fails = fails + nearp("idf_sat", tfidf_idf(idf, "sat"), 1.09861)
    fails = fails + nearp("idf_cat", tfidf_idf(idf, "cat"), 0.40546)
    fails = fails + nearp("idf_unseen", tfidf_idf(idf, "zzz"), 0.0)

    // tfidf_score in doc ["the","cat","sat"] (tf each = 1/3)
    let doc0 = ["the", "cat", "sat"]
    fails = fails + nearp("score_the", tfidf_score(idf, doc0, "the"), 0.0)
    fails = fails + nearp("score_sat", tfidf_score(idf, doc0, "sat"), 0.36620)
    fails = fails + nearp("score_cat", tfidf_score(idf, doc0, "cat"), 0.13515)

    // repeated term has higher tf: doc ["cat","cat","the"] -> cat tf=2/3
    let doc1 = ["cat", "cat", "the"]
    fails = fails + nearp("score_cat_rep", tfidf_score(idf, doc1, "cat"), 0.27031)

    // vector: "the" dropped-to-0, "sat" is the top term
    let vec = tfidf_vector(idf, doc0)
    fails = fails + expect_true("vec_has_terms", contains(vec, "cat") and contains(vec, "sat"))
    fails = fails + nearp("vec_the_zero", vec["the"], 0.0)
    fails = fails + expect_true("vec_sat_gt_cat", vec["sat"] > vec["cat"])

    // empty doc
    fails = fails + nearp("empty", tfidf_score(idf, [], "cat"), 0.0)

    if fails == 0
        print("forge_tfidf: all passed")
    else
        print("forge_tfidf: " + str(fails) + " FAILED")
