// _streamstats_test.nova — KAT for std/sketch/streamstats
//
// Exact known-answer tests with tolerance 0.0001 for float comparisons.
// Dataset: [2, 4, 4, 4, 5, 5, 7, 9]
//   n=8, sum=40, mean=5.0
//   deviations: -3,-1,-1,-1,0,0,2,4  squared: 9,1,1,1,0,0,4,16  sum-sq=32
//   population variance = 32/8 = 4.0   stddev = 2.0
//   sample variance     = 32/7 ~ 4.5714...
//   min=2, max=9

import std/sketch/streamstats

fn ck(label, got, want)
    if got != want
        print("FAIL streamstats " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck_f(label, got, want, tol)
    let diff = got - want
    if diff < 0.0
        diff = 0.0 - diff
    if diff > tol
        print("FAIL streamstats " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // --- Build state from [2, 4, 4, 4, 5, 5, 7, 9] ---
    let s = ss_new()
    s = ss_push(s, 2)
    s = ss_push(s, 4)
    s = ss_push(s, 4)
    s = ss_push(s, 4)
    s = ss_push(s, 5)
    s = ss_push(s, 5)
    s = ss_push(s, 7)
    s = ss_push(s, 9)

    ck("count",    ss_count(s), 8)
    ck_f("mean",      ss_mean(s),     5.0,    0.0001)
    ck_f("variance",  ss_variance(s), 4.0,    0.0001)
    ck_f("stddev",    ss_stddev(s),   2.0,    0.0001)
    ck_f("min",       ss_min(s),      2.0,    0.0001)
    ck_f("max",       ss_max(s),      9.0,    0.0001)
    ck_f("sum",       ss_sum(s),      40.0,   0.0001)
    ck_f("range",     ss_range(s),    7.0,    0.0001)

    // sample variance = 32/7
    let sv = ss_sample_variance(s)
    ck_f("sample_var", sv, 4.571428, 0.0001)

    // --- Single value: mean == value, variance == 0.0 ---
    let s1 = ss_new()
    s1 = ss_push(s1, 42)
    ck_f("single_mean",     ss_mean(s1),     42.0, 0.0001)
    ck_f("single_variance", ss_variance(s1),  0.0, 0.0001)
    ck_f("single_stddev",   ss_stddev(s1),    0.0, 0.0001)
    ck_f("single_min",      ss_min(s1),      42.0, 0.0001)
    ck_f("single_max",      ss_max(s1),      42.0, 0.0001)
    ck_f("single_range",    ss_range(s1),     0.0, 0.0001)
    ck("single_sample_var", ss_sample_variance(s1) < 0.0001, 1)

    // --- Empty state returns 0 without crash ---
    let se = ss_new()
    ck_f("empty_mean",     ss_mean(se),     0.0, 0.0001)
    ck_f("empty_variance", ss_variance(se), 0.0, 0.0001)
    ck_f("empty_stddev",   ss_stddev(se),   0.0, 0.0001)
    ck_f("empty_min",      ss_min(se),      0.0, 0.0001)
    ck_f("empty_max",      ss_max(se),      0.0, 0.0001)
    ck_f("empty_sum",      ss_sum(se),      0.0, 0.0001)
    ck_f("empty_range",    ss_range(se),    0.0, 0.0001)

    // --- EMA: alpha=0.5, push 10 then 20 -> 15.0 ---
    let ema = ss_ema_new(0.5)
    let v1 = ss_ema_push(ema, 10)
    ck_f("ema_init", v1, 10.0, 0.0001)
    let v2 = ss_ema_push(ema, 20)
    // ema = 0.5*20 + 0.5*10 = 15.0
    ck_f("ema_second", v2, 15.0, 0.0001)

    // --- EMA with alpha=1.0: always equals last value ---
    let ema1 = ss_ema_new(1.0)
    let ea = ss_ema_push(ema1, 5)
    let eb = ss_ema_push(ema1, 99)
    ck_f("ema_alpha1", eb, 99.0, 0.0001)

    // --- EMA with alpha=0.0: always equals first value ---
    let ema0 = ss_ema_new(0.0)
    let ec = ss_ema_push(ema0, 7)
    let ed = ss_ema_push(ema0, 100)
    ck_f("ema_alpha0", ed, 7.0, 0.0001)

    // suppress unused warnings
    if ea > 999999.0
        print("unused")
    if ec > 999999.0
        print("unused")

    // --- Monotonic count ---
    let sm = ss_new()
    let i = 0
    while i < 10
        sm = ss_push(sm, i)
        i = i + 1
    ck("count_10", ss_count(sm), 10)

    // --- Determinism: two states with same input give same mean ---
    let sd1 = ss_new()
    let sd2 = ss_new()
    let di = 0
    while di < 20
        sd1 = ss_push(sd1, di)
        sd2 = ss_push(sd2, di)
        di = di + 1
    let m1 = ss_mean(sd1)
    let m2 = ss_mean(sd2)
    ck_f("determinism_mean", m1, m2, 0.000001)

    // --- min/max track correctly ---
    let sminmax = ss_new()
    sminmax = ss_push(sminmax, 10)
    sminmax = ss_push(sminmax, 3)
    sminmax = ss_push(sminmax, 7)
    sminmax = ss_push(sminmax, 1)
    sminmax = ss_push(sminmax, 5)
    ck_f("mm_min", ss_min(sminmax), 1.0, 0.0001)
    ck_f("mm_max", ss_max(sminmax), 10.0, 0.0001)
    ck_f("mm_range", ss_range(sminmax), 9.0, 0.0001)

    print("PASS _streamstats_test")
