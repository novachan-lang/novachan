// NOVA zero-SQL, zero-table-name, zero-annotation reads: `let xs: list<T> = orm_fetch(db)`. The struct
// type IS the whole query -- no table name, no SQL, no @Entity. Define a struct, fetch it.
import forge_orm

type Todo
    id: int
    title: string
    done: bool

fn main()
    let sr = orm_open("sqlite://_orm_fetch.db")
    match sr
        Ok(db) =>
            orm_exec(db, "DROP TABLE IF EXISTS Todo", [])
            orm_ensure(db, Todo(0, "", false))
            orm_save(db, Todo(1, "alpha", false))
            orm_save(db, Todo(2, "beta", true))
            let todos: list<Todo> = orm_fetch(db)     // SELECT * FROM Todo -- derived from <Todo>
            if len(todos) != 2
                print("FAIL count: " + str(len(todos)))
                exit(1)
            if todos[0].title != "alpha" or todos[1].title != "beta" or todos[1].done != true
                print("FAIL fields: " + todos[0].title + "/" + todos[1].title + "/" + str(todos[1].done))
                exit(1)
            orm_close(db)
            print("PASS _orm_fetch_test")
        Err(e) =>
            print("FAIL open: " + e)
            exit(1)
