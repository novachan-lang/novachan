// Forge RSA: RSASSA-PKCS1-v1.5 SHA-256 verify, gated against a computed+OpenSSL-verified RSA-2048 vector
// (message "NOVA forge"). Verify-only (e=65537). The modexp is heavy; may exceed the 15s harness run.
import forge_rsa
import forge_crypto

fn main()
    let n = hex_to_blist("")
    let sig = hex_to_blist("")
    let h = hex_to_blist("be62950e3e03ec8b2f8606a161c961c1a2fd68c150ae32628a2fc979a1b95789")

    if len(n) != 256
        print("FAIL: n length not 256")
        exit(1)
    if len(sig) != 256
        print("FAIL: sig length not 256")
        exit(1)

    // sanity: my SHA-256 of the message matches the vector's digest
    if hex_of(sha256_bytes(str_to_blist("NOVA forge"))) != "be62950e3e03ec8b2f8606a161c961c1a2fd68c150ae32628a2fc979a1b95789"
        print("FAIL: sha256 of message")
        exit(1)

    if rsa_pkcs1_sha256_verify(n, h, sig) != 1
        print("FAIL: RSA verify")
        exit(1)

    let bad = []
    let i = 0
    while i < 256
        push(bad, sig[i])
        i = i + 1
    bad[200] = bad[200] ^ 1
    if rsa_pkcs1_sha256_verify(n, h, bad) != 0
        print("FAIL: tampered signature not rejected")
        exit(1)

    print("PASS forge_rsa (RSA-2048 PKCS1-v1.5 SHA-256 verify KAT + tamper)")
