// graphx — graph algorithms in pure NOVA over an adjacency dict
// (node -> list of neighbor nodes). BFS distances/reachability, path existence,
// and Kahn's topological sort with cycle detection. Pure dict/list primitives;
// no runtime/compiler changes. Useful for pathfinding (games) and dependency
// resolution (build systems) — both NOVA "build anything" use cases.

fn _neighbors(g: dict, node: string) -> list
    if g.has(node)
        return g[node]
    return []

// BFS order of all nodes reachable from start (start first), in neighbor order.
fn reachable(g: dict, start: string) -> list
    let visited: dict<string, int> = {}
    let order: list<string> = []
    let queue: list<string> = [start]
    visited[start] = 1
    let i = 0
    while i < len(queue)
        let node = queue[i]
        i = i + 1
        push(order, node)
        for nb in _neighbors(g, node)
            if not visited.has(nb)
                visited[nb] = 1
                push(queue, nb)
    return order

// Shortest unweighted distance (in edges) from start to every reachable node.
fn bfs_dist(g: dict, start: string) -> dict
    let dist: dict<string, int> = {}
    let queue: list<string> = [start]
    dist[start] = 0
    let i = 0
    while i < len(queue)
        let node = queue[i]
        i = i + 1
        let d = dist[node]
        for nb in _neighbors(g, node)
            if not dist.has(nb)
                dist[nb] = d + 1
                push(queue, nb)
    return dist

// Is there a directed path from a to b?
fn has_path(g: dict, a: string, b: string) -> bool
    let visited: dict<string, int> = {}
    let queue: list<string> = [a]
    visited[a] = 1
    let i = 0
    while i < len(queue)
        let node = queue[i]
        i = i + 1
        if node == b
            return true
        for nb in _neighbors(g, node)
            if not visited.has(nb)
                visited[nb] = 1
                push(queue, nb)
    return a == b

// Kahn's topological sort over an explicit node ordering (deterministic).
// Returns [] if the graph has a cycle (fewer than len(nodes) emitted).
fn topo_sort(g: dict, nodes: list) -> list
    let indeg: dict<string, int> = {}
    for n in nodes
        indeg[n] = 0
    for n in nodes
        for nb in _neighbors(g, n)
            if indeg.has(nb)
                indeg[nb] = indeg[nb] + 1
    let queue: list<string> = []
    for n in nodes
        if indeg[n] == 0
            push(queue, n)
    let order: list<string> = []
    let i = 0
    while i < len(queue)
        let node = queue[i]
        i = i + 1
        push(order, node)
        for nb in _neighbors(g, node)
            if indeg.has(nb)
                indeg[nb] = indeg[nb] - 1
                if indeg[nb] == 0
                    push(queue, nb)
    if len(order) < len(nodes)
        return []
    return order

fn main()
    // a -> b, a -> c, b -> d, c -> d  (a small DAG)
    let g: dict<string, list> = {"a": ["b", "c"], "b": ["d"], "c": ["d"], "d": []}

    assert_eq(reachable(g, "a"), ["a", "b", "c", "d"])
    assert_eq(reachable(g, "d"), ["d"])

    let dist = bfs_dist(g, "a")
    assert_eq(dist["a"], 0)
    assert_eq(dist["b"], 1)
    assert_eq(dist["c"], 1)
    assert_eq(dist["d"], 2)

    assert_eq(has_path(g, "a", "d"), true)
    assert_eq(has_path(g, "d", "a"), false)
    assert_eq(has_path(g, "b", "d"), true)
    assert_eq(has_path(g, "a", "a"), true)

    // deterministic Kahn order for this DAG + node listing
    assert_eq(topo_sort(g, ["a", "b", "c", "d"]), ["a", "b", "c", "d"])

    // cycle -> empty result
    let cyclic: dict<string, list> = {"x": ["y"], "y": ["x"]}
    assert_eq(topo_sort(cyclic, ["x", "y"]), [])

    // dependency-resolution shape: edge u -> v means "u must be built before v".
    // core enables lib and app; lib enables app. Topo order = a valid build order.
    let deps: dict<string, list> = {"core": ["lib", "app"], "lib": ["app"], "app": []}
    let build_order = topo_sort(deps, ["core", "lib", "app"])
    assert_eq(build_order[0], "core")   // prerequisite first
    assert_eq(build_order[2], "app")    // dependent last

    print("graphx passed")
