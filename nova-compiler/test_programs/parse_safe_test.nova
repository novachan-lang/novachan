// Result-returning safe number parsing — closes cat-17 "number<->text returning
// Result" and showcases the new typed Result<T,E>. parse_int_safe : string ->
// Result<int,string>; parse_float_safe : string -> Result<float,string>. unwrap /
// unwrap_or / is_ok / is_err are all type-checked over the Sum type.

fn main()
    // ── parse_int_safe: valid ──
    let a = parse_int_safe("42")
    assert_eq(is_ok(a), 1)
    assert_eq(unwrap(a), 42)                          // unwrap : Sum<int,str> -> int
    assert_eq(unwrap(parse_int_safe("-17")), -17)
    assert_eq(unwrap(parse_int_safe("0")), 0)
    assert_eq(unwrap(parse_int_safe("  100  ")), 100) // surrounding whitespace tolerated

    // ── parse_int_safe: invalid -> err, recoverable ──
    assert_eq(is_ok(parse_int_safe("abc")), 0)
    assert_eq(is_err(parse_int_safe("abc")), 1)
    assert_eq(unwrap_or(parse_int_safe("abc"), -1), -1)
    assert_eq(unwrap_or(parse_int_safe(""), -1), -1)
    assert_eq(unwrap_or(parse_int_safe("12x"), -1), -1)   // trailing junk rejected
    assert_eq(unwrap_or(parse_int_safe("3.14"), -1), -1)  // not an integer

    // ── parse_float_safe ──
    assert_near(unwrap(parse_float_safe("3.14")), 3.14, 0.0001)
    assert_near(unwrap(parse_float_safe("-2.5")), -2.5, 0.0001)
    assert_near(unwrap(parse_float_safe("  10  ")), 10.0, 0.0001)
    assert_eq(is_ok(parse_float_safe("1.5e3")), 1)
    assert_near(unwrap(parse_float_safe("1.5e3")), 1500.0, 0.01)
    assert_eq(is_err(parse_float_safe("nope")), 1)
    assert_near(unwrap_or(parse_float_safe("nope"), 0.0), 0.0, 0.0001)
    assert_near(unwrap_or(parse_float_safe(""), -1.0), -1.0, 0.0001)

    print("parse_safe_test passed")
