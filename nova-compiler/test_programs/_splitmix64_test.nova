// KAT test for std/random/splitmix64
//
// Tests:
//   KAT1: sm_next(sm_seed(0)) == 0xE220A8397B1DCDAF
//   KAT2: second output of sm_seed(0)  == 0x6E789E6AA1B965F4
//   KAT3: determinism -- two generators seeded identically produce same sequence
//   KAT4: seed(12345) first output matches reference
//   KAT5: sm_next_range stays in [0, n)
//   KAT6: different seeds produce different outputs
//
// Reference anchor values computed with Python ctypes u64 simulation.

import std/random/splitmix64

fn main()
    // ── KAT 1: first output of seed=0 ──────────────────────────────────────
    // Expected: 0xE220A8397B1DCDAF = -2152535657050944081 as signed i64
    // Built from 32-bit halves per spec: (0xE220A839 << 32) | 0x7B1DCDAF
    let want1 = (0xE220A839 << 32) | 0x7B1DCDAF
    let r0 = sm_seed(0)
    let got1 = sm_next(r0)
    if got1 != want1
        print("FAIL splitmix64 KAT1: got " + str(got1) + " want " + str(want1))
        exit(1)

    // ── KAT 2: second output of seed=0 ─────────────────────────────────────
    // Expected: 0x6E789E6AA1B965F4 = 7960286522194355700 as signed i64
    let want2 = (0x6E789E6A << 32) | 0xA1B965F4
    let got2 = sm_next(r0)
    if got2 != want2
        print("FAIL splitmix64 KAT2: got " + str(got2) + " want " + str(want2))
        exit(1)

    // ── KAT 3: determinism -- two independent rngs seeded the same ──────────
    let ra = sm_seed(0)
    let rb = sm_seed(0)
    let i = 0
    while i < 10
        let va = sm_next(ra)
        let vb = sm_next(rb)
        if va != vb
            print("FAIL splitmix64 KAT3: diverged at step " + str(i))
            exit(1)
        i = i + 1

    // ── KAT 4: seed=12345 first output ──────────────────────────────────────
    // Reference: 0x22118258A9D111A0 = 2454886589211414944 as signed i64
    let want4 = (0x22118258 << 32) | 0xA9D111A0
    let r12345 = sm_seed(12345)
    let got4 = sm_next(r12345)
    if got4 != want4
        print("FAIL splitmix64 KAT4: got " + str(got4) + " want " + str(want4))
        exit(1)

    // ── KAT 5: sm_next_range stays in [0, n) ────────────────────────────────
    let rr = sm_seed(99)
    let j = 0
    while j < 200
        let v = sm_next_range(rr, 100)
        if v < 0
            print("FAIL splitmix64 KAT5a: v < 0 at step " + str(j))
            exit(1)
        if v >= 100
            print("FAIL splitmix64 KAT5b: v >= 100 at step " + str(j))
            exit(1)
        j = j + 1

    // ── KAT 6: different seeds produce different first outputs ───────────────
    let rx = sm_seed(1)
    let ry = sm_seed(2)
    let vx = sm_next(rx)
    let vy = sm_next(ry)
    if vx == vy
        print("FAIL splitmix64 KAT6: seed 1 and seed 2 produced the same first output")
        exit(1)

    // ── KAT 7: sm_next_range concrete anchor ────────────────────────────────
    // sm_seed(42), sm_next_range(rng, 10): raw63 % 10 = 5 (from Python reference)
    let r42 = sm_seed(42)
    let got7 = sm_next_range(r42, 10)
    if got7 != 5
        print("FAIL splitmix64 KAT7: got " + str(got7) + " want 5")
        exit(1)

    print("PASS _splitmix64_test")
