import forge_frobenius as fr

fn check(cond: bool, label: string)
    if cond == false
        print("FAIL: " + label)

fn my_gcd(a: int, b: int) -> int
    let x = a
    let y = b
    while y != 0
        let t = x % y
        x = y
        y = t
    if x < 0
        x = 0 - x
    x

fn main()
    // ---- classic fixed values ----
    check(fr.frobenius_number([3, 5]) == 7, "frob 3,5 == 7")
    check(fr.frobenius_number([4, 7]) == 17, "frob 4,7 == 17")
    check(fr.frobenius_number([2, 3]) == 1, "frob 2,3 == 1")
    check(fr.frobenius_number([6, 9, 20]) == 43, "frob McNugget 6,9,20 == 43")
    check(fr.frobenius_number([3, 5, 7]) == 4, "frob 3,5,7 == 4")
    check(fr.frobenius_number([5, 8, 11]) == 17, "frob 5,8,11 == 17")

    // ---- no finite Frobenius ----
    check(fr.frobenius_number([4, 6]) == 0 - 1, "frob 4,6 gcd2 -> -1")
    check(fr.frobenius_number([1, 5]) == 0 - 1, "frob with coin 1 -> -1")
    check(fr.frobenius_number([6, 10, 15]) == 29, "frob 6,10,15 gcd1 == 29")

    // ---- is_representable ----
    check(fr.is_representable([3, 5], 0), "rep 0")
    check(fr.is_representable([3, 5], 8), "rep 8 = 3+5")
    check(fr.is_representable([3, 5], 7) == false, "7 not representable")
    check(fr.is_representable([3, 5], 4) == false, "4 not representable")
    check(fr.is_representable([6, 9, 20], 43) == false, "43 not representable")
    check(fr.is_representable([6, 9, 20], 44), "44 representable (6+9+9+20)")

    // every amount above the Frobenius number must be representable
    let big = 0
    while big <= 30
        check(fr.is_representable([3, 5], 8 + big), "3,5 all >=8 representable off=" + str(big))
        big = big + 1

    // ---- count_non_representable (genus) ----
    check(fr.count_non_representable([3, 5]) == 4, "genus 3,5 == 4")   // {1,2,4,7}
    check(fr.count_non_representable([4, 6]) == 0 - 1, "genus 4,6 -> infinite -1")

    // ---- cross-check vs Sylvester closed form for ALL coprime pairs a<b ----
    // frobenius(a,b) = a*b - a - b ; genus = (a-1)(b-1)/2
    let a = 2
    while a <= 12
        let b = a + 1
        while b <= 13
            if my_gcd(a, b) == 1
                let expect_f = a * b - a - b
                check(fr.frobenius_number([a, b]) == expect_f, "sylvester frob a=" + str(a) + " b=" + str(b))
                let expect_g = (a - 1) * (b - 1) / 2
                check(fr.count_non_representable([a, b]) == expect_g, "sylvester genus a=" + str(a) + " b=" + str(b))
            b = b + 1
        a = a + 1

    // ---- consistency: frobenius itself is NOT representable, frobenius+1..+min all ARE ----
    let sets = [[3, 5], [4, 7], [6, 9, 20], [5, 8, 11], [7, 11, 13]]
    let si = 0
    while si < len(sets)
        let coins = sets[si]
        let f = fr.frobenius_number(coins)
        if f > 0
            check(fr.is_representable(coins, f) == false, "frob itself not representable set " + str(si))
            check(fr.is_representable(coins, f + 1), "frob+1 representable set " + str(si))
        si = si + 1

    print("forge_frobenius: all passed")
