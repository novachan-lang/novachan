// NOVA's zero-annotation, zero-table-name persistence: the struct's TYPE is the table. No @Entity,
// no @Column, no table-name strings, no SQL for writes -- define a struct, persist it.
import forge_orm

type Todo
    id: int
    title: string
    done: bool

fn main()
    let sr = orm_open("sqlite://_orm_zero.db")
    match sr
        Ok(db) =>
            orm_exec(db, "DROP TABLE IF EXISTS Todo", [])
            orm_ensure(db, Todo(0, "", false))            // CREATE TABLE Todo(...) from the struct
            orm_save(db, Todo(1, "ship nova", false))     // INSERT -- table derived from type_name
            orm_save(db, Todo(2, "write tests", true))
            let todos: list<Todo> = orm_all(db, "SELECT * FROM Todo ORDER BY id", [])
            if len(todos) != 2
                print("FAIL count: " + str(len(todos)))
                exit(1)
            if todos[0].title != "ship nova" or todos[1].done != true
                print("FAIL fields: " + todos[0].title + " / " + str(todos[1].done))
                exit(1)
            orm_modify(db, Todo(1, "shipped nova", true)) // UPDATE by id, table from type
            let one: Result<Todo> = orm_one(db, "SELECT * FROM Todo WHERE id = ?", [1])
            match one
                Ok(t) =>
                    if t.title != "shipped nova" or t.done != true
                        print("FAIL modify: " + t.title + " / " + str(t.done))
                        exit(1)
                Err(e) =>
                    print("FAIL modify-read: " + e)
                    exit(1)
            orm_remove(db, Todo(2, "", false))            // DELETE by id, table from type
            let rest: list<Todo> = orm_all(db, "SELECT * FROM Todo", [])
            if len(rest) != 1
                print("FAIL after-remove: " + str(len(rest)))
                exit(1)
            orm_close(db)
            print("PASS _orm_zero_test")
        Err(e) =>
            print("FAIL open: " + e)
            exit(1)
