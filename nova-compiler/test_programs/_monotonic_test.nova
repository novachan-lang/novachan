import std/collections/monotonic

// Helper: assert two int lists are equal
fn cki_list(got, expected, label)
    let ng = len(got)
    let ne = len(expected)
    if ng != ne
        print("FAIL " + label + ": length " + str(ng) + " != " + str(ne))
        exit(1)
    let i = 0
    while i < ng
        let gv = got[i]
        let ev = expected[i]
        if gv != ev
            print("FAIL " + label + "[" + str(i) + "]: got " + str(gv) + " expected " + str(ev))
            exit(1)
        i = i + 1

// KAT 1: mono_max_sliding basic
// xs=[1,3,-1,-3,5,3,6,7], k=3 => [3,3,5,5,6,7]
let xs1 = [1, 3, 0-1, 0-3, 5, 3, 6, 7]
let exp1 = [3, 3, 5, 5, 6, 7]
let got1 = mono_max_sliding(xs1, 3)
cki_list(got1, exp1, "max_sliding k=3")

// KAT 2: mono_max_sliding window = 1 (each element is its own max)
let xs2 = [4, 2, 7, 1]
let exp2 = [4, 2, 7, 1]
let got2 = mono_max_sliding(xs2, 1)
cki_list(got2, exp2, "max_sliding k=1")

// KAT 3: mono_min_sliding
// xs=[1,3,-1,-3,5], k=2 => [1,-1,-3,-3]
let xs3 = [1, 3, 0-1, 0-3, 5]
let exp3 = [1, 0-1, 0-3, 0-3]
let got3 = mono_min_sliding(xs3, 2)
cki_list(got3, exp3, "min_sliding k=2")

// KAT 4: mono_min_sliding window covers full array
let xs4 = [3, 1, 2]
let exp4 = [1]
let got4 = mono_min_sliding(xs4, 3)
cki_list(got4, exp4, "min_sliding k=n")

// KAT 5: mono_next_greater mixed
// [2,1,3] => [3,3,-1]
let xs5 = [2, 1, 3]
let exp5 = [3, 3, 0-1]
let got5 = mono_next_greater(xs5)
cki_list(got5, exp5, "next_greater [2,1,3]")

// KAT 6: mono_next_greater descending (all -1)
// [5,4,3] => [-1,-1,-1]
let xs6 = [5, 4, 3]
let exp6 = [0-1, 0-1, 0-1]
let got6 = mono_next_greater(xs6)
cki_list(got6, exp6, "next_greater descending")

// KAT 7: mono_prev_smaller
// [2,5,3,7,1] => [-1,2,2,3,-1]
let xs7 = [2, 5, 3, 7, 1]
let exp7 = [0-1, 2, 2, 3, 0-1]
let got7 = mono_prev_smaller(xs7)
cki_list(got7, exp7, "prev_smaller [2,5,3,7,1]")

// KAT 8: mono_next_greater single element
let xs8 = [42]
let exp8 = [0-1]
let got8 = mono_next_greater(xs8)
cki_list(got8, exp8, "next_greater single")

// KAT 9: mono_prev_smaller all equal
// [3,3,3] => [-1,-1,-1]  (strictly smaller: equal does NOT qualify)
let xs9 = [3, 3, 3]
let exp9 = [0-1, 0-1, 0-1]
let got9 = mono_prev_smaller(xs9)
cki_list(got9, exp9, "prev_smaller equal elements")

print("_monotonic_test passed")
