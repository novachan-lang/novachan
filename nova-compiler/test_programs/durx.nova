// durx — durations as first-class values with unit-safe arithmetic.
//
// A Duration carries a canonical nanosecond count, so "5 seconds" and "5 millis" are
// distinct VALUES, not ambiguous ints. Constructors name the unit at the boundary so
// it is never guessed; arithmetic stays in the Duration domain (dur+dur -> dur,
// dur*scalar -> dur). This is the value-level safety; the future type-level layer
// would make `seconds(5) + 5` (Duration + raw int) a compile error via newtypes.

type Duration
    nanos: int

fn nanos(n) -> Duration
    return Duration(n)
fn micros(n) -> Duration
    return Duration(n * 1000)
fn millis(n) -> Duration
    return Duration(n * 1000000)
fn seconds(n) -> Duration
    return Duration(n * 1000000000)
fn minutes(n) -> Duration
    return Duration(n * 60000000000)
fn hours(n) -> Duration
    return Duration(n * 3600000000000)

fn dur_add(a, b) -> Duration
    return Duration(a.nanos + b.nanos)
fn dur_sub(a, b) -> Duration
    return Duration(a.nanos - b.nanos)
fn dur_scale(a, k) -> Duration
    return Duration(a.nanos * k)

fn dur_eq(a, b) -> bool
    return a.nanos == b.nanos
fn dur_lt(a, b) -> bool
    return a.nanos < b.nanos

fn to_nanos(d) -> int
    return d.nanos
fn to_millis(d) -> int
    return d.nanos / 1000000
fn to_seconds(d) -> int
    return d.nanos / 1000000000

// human-readable, millisecond granularity (h/m/s/ms, zero parts omitted)
fn dur_str(d) -> string
    let ms_total = d.nanos / 1000000
    let h = ms_total / 3600000
    let rem = ms_total % 3600000
    let m = rem / 60000
    rem = rem % 60000
    let s = rem / 1000
    let ms = rem % 1000
    let out = ""
    if h > 0
        out = out + str(h) + "h"
    if m > 0
        out = out + str(m) + "m"
    if s > 0
        out = out + str(s) + "s"
    if ms > 0
        out = out + str(ms) + "ms"
    if out == ""
        out = "0s"
    return out

fn main()
    let a = seconds(5)
    let b = millis(500)
    assert_eq(to_millis(a), 5000)
    assert_eq(to_millis(dur_add(a, b)), 5500)
    assert_eq(to_millis(dur_sub(a, b)), 4500)
    assert_eq(to_millis(dur_scale(b, 3)), 1500)
    assert_eq(to_seconds(minutes(2)), 120)
    assert_eq(to_seconds(hours(1)), 3600)
    assert_eq(to_nanos(micros(7)), 7000)

    // distinct values: 5 seconds != 5 millis
    let neq = 0
    if dur_eq(seconds(5), millis(5))
        neq = 1
    assert_eq(neq, 0)

    // ordering
    let lt = 0
    if dur_lt(millis(500), seconds(1))
        lt = 1
    assert_eq(lt, 1)

    // rendering
    assert_eq(dur_str(seconds(90)), "1m30s")
    assert_eq(dur_str(millis(1500)), "1s500ms")
    assert_eq(dur_str(hours(1)), "1h")
    assert_eq(dur_str(nanos(0)), "0s")

    print("durx passed")
