// _shift64_guard_test.nova -- CORE_GAP: LLVM shl/ashr by >= bit-width is POISON (UB). NOVA wraps on
// overflow, so a shift moving every bit out is defined: shl >= 64 -> 0, ashr >= 64 -> sign-extension.
// Guards against the historic `1<<64 -> 0xFFFFFFFF` garbage. Hard assert -> CI fails loud on regression.
fn expect(name: string, got: int, want: int)
    if got != want
        print("FAIL " + name + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("ok " + name + " = " + str(got))

fn main()
    // constant shifts < 64 stay exact (LLVM folds the guard away)
    expect("1<<3", 1 << 3, 8)
    expect("1<<10", 1 << 10, 1024)
    expect("1<<62", 1 << 62, 4611686018427387904)
    // the historic bug: shifting all bits out is 0, not garbage
    expect("1<<64", 1 << 64, 0)
    expect("1<<65", 1 << 65, 0)
    expect("5<<64", 5 << 64, 0)
    // ashr >= 64 sign-extends: negative -> -1, non-negative -> 0
    expect("(-8)>>64", (0 - 8) >> 64, 0 - 1)
    expect("16>>64", 16 >> 64, 0)
    expect("16>>2", 16 >> 2, 4)
    expect("(-16)>>2", (0 - 16) >> 2, 0 - 4)
    // VARIABLE amount (not const-folded) must also be guarded at runtime
    let n = 64
    let one = 1
    expect("one<<n(var 64)", one << n, 0)
    let big = 0 - 100
    expect("big>>n(var 64)", big >> n, 0 - 1)
    let m = 5
    expect("one<<m(var 5)", one << m, 32)
    print("_shift64_guard_test passed")
