import forge_bech32

fn tf(b: bool) -> string
    if b
        return "T"
    "F"

fn main()
    let z = []
    let k = 0
    while k < 82
        push(z, 0)
        k = k + 1
    let s = bech32_encode("1", z)
    // BIP173 max-length vector: total 90 chars, hrp "1", ends with checksum "c8247j"
    print("len90=" + tf(len(s) == 90))
    print("prefix=" + tf(find(s, "11qq") == 0))
    print("suffix=" + tf(ends_with(s, "c8247j")))
