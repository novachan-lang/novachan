// Test: nested list literals
fn main()
    print("=== nested list test ===")
    let matrix = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
    print(matrix)
    print(matrix[0])
    print(matrix[1])
    print(matrix[2])
    print(matrix[1][2])
    let nested = [[10, 20], [30, 40]]
    let sum = nested[0][0] + nested[0][1] + nested[1][0] + nested[1][1]
    print(sum)
    print("=== done ===")

main()
