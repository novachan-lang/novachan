// intfloat_mixed_test — the reported value-model bug: a large int in a MIXED list
// printed as float garbage. Now floats/bools in collections are boxed (literals,
// push, index-set, json, lambda/map results), so a raw collection element is an int
// and list rendering is heuristic-free.

fn main()
    // the reported bug: large int alongside a float
    assert_eq(str([1, 2.5, 1000000000000000000]), "[1, 2.5, 1000000000000000000]")
    assert_eq(str([9007199254740993, 1.5]), "[9007199254740993, 1.5]")

    // homogeneous lists unchanged
    assert_eq(str([1, 2, 3]), "[1, 2, 3]")
    assert_eq(str([1.5, 2.5]), "[1.5, 2.5]")

    // bool/float/int mixed renders each correctly
    assert_eq(str([true, 1, 2.5]), "[true, 1, 2.5]")

    // map producing floats (ai_classify softmax pattern) -> boxed -> correct values
    let xs = [2, 4, 6]
    let halved = xs.map(fn(e) e / 2.0)
    assert_near(halved[0], 1.0, 0.0001)
    assert_near(halved[1], 2.0, 0.0001)
    assert_near(halved[2], 3.0, 0.0001)

    print("intfloat_mixed_test passed")
