// KAT: std/data/sub_srt_parse
import std/data/sub_srt_parse

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=[" + got + "] want=[" + want + "]")
        exit(1)

// ── Spec vector: 2-cue SRT ────────────────────────────────────────────────────
let lf = chr(10)
let srt2 = "1" + lf + "00:00:01,000 --> 00:00:04,000" + lf + "Hello" + lf + lf + "2" + lf + "00:00:05,000 --> 00:00:08,000" + lf + "World" + lf
let cues2 = srt_parse(srt2)
cki("parse2_count",   len(cues2),       2)
cki("cue0_index",     cues2[0]["index"], 1)
cki("cue0_start",     cues2[0]["start"], 1000)
cki("cue0_end",       cues2[0]["end"],   4000)
cks("cue0_text",      cues2[0]["text"],  "Hello")
cki("cue1_index",     cues2[1]["index"], 2)
cki("cue1_start",     cues2[1]["start"], 5000)
cki("cue1_end",       cues2[1]["end"],   8000)
cks("cue1_text",      cues2[1]["text"],  "World")

// ── srt_cue_count ─────────────────────────────────────────────────────────────
cki("count2", srt_cue_count(srt2), 2)

// ── Single cue, no trailing blank line ────────────────────────────────────────
let srt1 = "1" + lf + "00:00:01,000 --> 00:00:04,000" + lf + "Hello"
let cues1 = srt_parse(srt1)
cki("single_count", len(cues1), 1)
cki("single_index", cues1[0]["index"], 1)
cki("single_start", cues1[0]["start"], 1000)
cki("single_end",   cues1[0]["end"],   4000)
cks("single_text",  cues1[0]["text"],  "Hello")

// ── Multi-line text ───────────────────────────────────────────────────────────
let srt_ml = "1" + lf + "00:00:10,000 --> 00:00:15,000" + lf + "Line one" + lf + "Line two" + lf
let cues_ml = srt_parse(srt_ml)
cki("ml_count", len(cues_ml), 1)
cks("ml_text",  cues_ml[0]["text"], "Line one" + lf + "Line two")

// ── CRLF tolerance ────────────────────────────────────────────────────────────
let cr = chr(13)
let srt_crlf = "1" + cr + lf + "00:00:01,000 --> 00:00:04,000" + cr + lf + "Hello" + cr + lf + cr + lf
let cues_crlf = srt_parse(srt_crlf)
cki("crlf_count", len(cues_crlf), 1)
cks("crlf_text",  cues_crlf[0]["text"], "Hello")

// ── Timing accuracy ───────────────────────────────────────────────────────────
let srt_t = "1" + lf + "01:02:03,456 --> 02:03:04,567" + lf + "T" + lf
let cues_t = srt_parse(srt_t)
cki("timing_start", cues_t[0]["start"], 3723456)
cki("timing_end",   cues_t[0]["end"],   7384567)

// ── cue_count on empty text ───────────────────────────────────────────────────
cki("count_empty", srt_cue_count(""), 0)

// ── 3 cues ────────────────────────────────────────────────────────────────────
let srt3 = "1" + lf + "00:00:01,000 --> 00:00:02,000" + lf + "A" + lf + lf + "2" + lf + "00:00:03,000 --> 00:00:04,000" + lf + "B" + lf + lf + "3" + lf + "00:00:05,000 --> 00:00:06,000" + lf + "C" + lf
let cues3 = srt_parse(srt3)
cki("three_count", len(cues3), 3)
cks("three_0",     cues3[0]["text"], "A")
cks("three_1",     cues3[1]["text"], "B")
cks("three_2",     cues3[2]["text"], "C")

print("PASS _sub_srt_parse_test")
