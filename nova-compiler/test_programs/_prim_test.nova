import std/graph/prim

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // Build the spec example graph (undirected, both directions present):
    // A-B(1), A-C(2), B-C(2), B-D(4), C-D(3)
    let g = {}
    g["A"] = [["B", 1], ["C", 2]]
    g["B"] = [["A", 1], ["C", 2], ["D", 4]]
    g["C"] = [["A", 2], ["B", 2], ["D", 3]]
    g["D"] = [["C", 3], ["B", 4]]

    // KAT 1: total MST weight from A == 6 (edges B-w1, C-w2, D-w3)
    cki("mst_weight_from_A", pr_mst_weight(g, "A"), 6)

    // KAT 2: MST edge count == 3 (V-1 for 4 nodes)
    let edges_a = pr_mst(g, "A")
    cki("mst_edge_count_from_A", len(edges_a), 3)

    // KAT 3: same MST weight regardless of start node (Prim on same component)
    cki("mst_weight_from_D", pr_mst_weight(g, "D"), 6)

    // KAT 4: MST from D also yields 3 edges
    let edges_d = pr_mst(g, "D")
    cki("mst_edge_count_from_D", len(edges_d), 3)

    // KAT 5: single-edge graph A-B weight 5
    let g2 = {}
    g2["A"] = [["B", 5]]
    g2["B"] = [["A", 5]]
    cki("single_edge_weight", pr_mst_weight(g2, "A"), 5)
    let e2 = pr_mst(g2, "A")
    cki("single_edge_count", len(e2), 1)

    // KAT 6: single isolated node -> MST weight 0, 0 edges
    let g3 = {}
    g3["A"] = []
    cki("isolated_weight", pr_mst_weight(g3, "A"), 0)
    let e3 = pr_mst(g3, "A")
    cki("isolated_edge_count", len(e3), 0)

    // KAT 7: each MST edge has 3 elements [u, v, w] and weights are positive
    let i = 0
    while i < len(edges_a)
        let ed = edges_a[i]
        cki("edge_arity_" + str(i), len(ed), 3)
        let w = ed[2]
        if w <= 0
            print("FAIL edge_pos_weight_" + str(i) + ": w=" + str(w))
            exit(1)
        i = i + 1

    // KAT 8: verify total weight from pr_mst edges matches pr_mst_weight
    let sum_w = 0
    let j = 0
    while j < len(edges_a)
        let ed2 = edges_a[j]
        sum_w = sum_w + ed2[2]
        j = j + 1
    cki("mst_weight_sum_consistency", sum_w, 6)

    print("_prim_test passed")
