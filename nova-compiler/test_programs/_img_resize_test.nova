// _img_resize_test.nova — KAT for std/image/img_resize
import std/image/img_resize

fn lists_equal(a, b)
    let na = len(a)
    let nb = len(b)
    if na != nb
        return 0
    let i = 0
    while i < na
        if a[i] != b[i]
            return 0
        i = i + 1
    return 1

fn list_to_str(lst)
    let s = "["
    let i = 0
    let n = len(lst)
    while i < n
        if i > 0
            s = s + ","
        s = s + str(lst[i])
        i = i + 1
    s = s + "]"
    s

fn main()
    // KAT 1: nearest-neighbor 2x2 -> 4x4 (each pixel becomes 2x2 block)
    // Input: [1,2,3,4] (w=2,h=2)
    // Expected first row: [1,1,2,2]
    // Full: [1,1,2,2, 1,1,2,2, 3,3,4,4, 3,3,4,4]
    let px1 = []
    px1.push(1)
    px1.push(2)
    px1.push(3)
    px1.push(4)
    let got1 = img_resize_nearest(px1, 2, 2, 4, 4)
    if len(got1) != 16
        print("FAIL img_resize_nearest 2x2->4x4 len: got " + str(len(got1)))
        exit(1)
    // Check first row
    if got1[0] != 1
        print("FAIL img_resize_nearest first row[0]: got " + str(got1[0]))
        exit(1)
    if got1[1] != 1
        print("FAIL img_resize_nearest first row[1]: got " + str(got1[1]))
        exit(1)
    if got1[2] != 2
        print("FAIL img_resize_nearest first row[2]: got " + str(got1[2]))
        exit(1)
    if got1[3] != 2
        print("FAIL img_resize_nearest first row[3]: got " + str(got1[3]))
        exit(1)
    // Check full output
    let want1 = []
    want1.push(1)
    want1.push(1)
    want1.push(2)
    want1.push(2)
    want1.push(1)
    want1.push(1)
    want1.push(2)
    want1.push(2)
    want1.push(3)
    want1.push(3)
    want1.push(4)
    want1.push(4)
    want1.push(3)
    want1.push(3)
    want1.push(4)
    want1.push(4)
    if not lists_equal(got1, want1)
        print("FAIL img_resize_nearest 2x2->4x4: got " + list_to_str(got1) + " want " + list_to_str(want1))
        exit(1)

    // KAT 2: nearest-neighbor 2x2 -> 1x1 downsampling
    // src_r=floor(0*2/1)=0, src_c=floor(0*2/1)=0 -> pixel[0]=1
    let px2 = []
    px2.push(1)
    px2.push(2)
    px2.push(3)
    px2.push(4)
    let got2 = img_resize_nearest(px2, 2, 2, 1, 1)
    if len(got2) != 1
        print("FAIL img_resize_nearest 2x2->1x1 len: got " + str(len(got2)))
        exit(1)
    if got2[0] != 1
        print("FAIL img_resize_nearest 2x2->1x1 value: got " + str(got2[0]) + " want 1")
        exit(1)

    // KAT 3: bilinear on uniform image returns same value everywhere
    // 3x3 all-128, resize to 5x5 -> all pixels should be 128
    let px3 = []
    let i3 = 0
    while i3 < 9
        px3.push(128)
        i3 = i3 + 1
    let got3 = img_resize_bilinear(px3, 3, 3, 5, 5)
    if len(got3) != 25
        print("FAIL img_resize_bilinear uniform len: got " + str(len(got3)))
        exit(1)
    let j3 = 0
    while j3 < 25
        if got3[j3] != 128
            print("FAIL img_resize_bilinear uniform pixel " + str(j3) + ": got " + str(got3[j3]) + " want 128")
            exit(1)
        j3 = j3 + 1

    // KAT 4: nearest-neighbor identity (same size) preserves image
    let px4 = []
    px4.push(10)
    px4.push(20)
    px4.push(30)
    px4.push(40)
    px4.push(50)
    px4.push(60)
    let got4 = img_resize_nearest(px4, 3, 2, 3, 2)
    if not lists_equal(got4, px4)
        print("FAIL img_resize_nearest identity: got " + list_to_str(got4) + " want " + list_to_str(px4))
        exit(1)

    // KAT 5: bilinear uniform 2x2 all-200 -> 4x4, all values = 200
    let px5 = []
    px5.push(200)
    px5.push(200)
    px5.push(200)
    px5.push(200)
    let got5 = img_resize_bilinear(px5, 2, 2, 4, 4)
    if len(got5) != 16
        print("FAIL img_resize_bilinear uniform 2x2->4x4 len: got " + str(len(got5)))
        exit(1)
    let j5 = 0
    while j5 < 16
        if got5[j5] != 200
            print("FAIL img_resize_bilinear uniform 2x2->4x4 pixel " + str(j5) + ": got " + str(got5[j5]) + " want 200")
            exit(1)
        j5 = j5 + 1

    // KAT 6: nearest 1x1 -> 3x3 repeats single pixel
    let px6 = []
    px6.push(77)
    let got6 = img_resize_nearest(px6, 1, 1, 3, 3)
    if len(got6) != 9
        print("FAIL img_resize_nearest 1x1->3x3 len: got " + str(len(got6)))
        exit(1)
    let j6 = 0
    while j6 < 9
        if got6[j6] != 77
            print("FAIL img_resize_nearest 1x1->3x3 pixel " + str(j6) + ": got " + str(got6[j6]) + " want 77")
            exit(1)
        j6 = j6 + 1

    print("PASS _img_resize_test")
