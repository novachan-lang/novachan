// _geo_area_test.nova — KAT for std/geo/geo_area
import std/geo/geo_area

fn approx_pct(a: float, b: float, pct: float) -> bool
    // true if a is within pct% of b
    let diff = a - b
    if diff < 0.0
        diff = 0.0 - diff
    let rel = diff / b
    return rel < pct

fn approx(a: float, b: float, tol: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < tol

fn main()
    // KAT 1: degenerate polygon (2 points) -> 0.0
    let deg_pts = []
    let d0 = []
    d0.push(0.0)
    d0.push(0.0)
    let d1 = []
    d1.push(1.0)
    d1.push(1.0)
    deg_pts.push(d0)
    deg_pts.push(d1)
    let area_deg = polygon_area(deg_pts)
    if not approx(area_deg, 0.0, 0.001)
        print("FAIL degenerate polygon area: got " + str(area_deg))
        exit(1)

    // KAT 2: zero points -> 0.0
    let empty_pts = []
    let area_empty = polygon_area(empty_pts)
    if not approx(area_empty, 0.0, 0.001)
        print("FAIL empty polygon area: got " + str(area_empty))
        exit(1)

    // KAT 3: small square near equator, side ~1 degree
    // Points: (0,0), (0,1), (1,1), (1,0) (counterclockwise)
    // Side ~= 111195 m, area ~= 111195^2 ~= 1.2364e10 m^2
    // Allow 5% tolerance due to spherical vs flat approximation
    let sq_pts = []
    let sq0 = []
    sq0.push(0.0)
    sq0.push(0.0)
    let sq1 = []
    sq1.push(0.0)
    sq1.push(1.0)
    let sq2 = []
    sq2.push(1.0)
    sq2.push(1.0)
    let sq3 = []
    sq3.push(1.0)
    sq3.push(0.0)
    sq_pts.push(sq0)
    sq_pts.push(sq1)
    sq_pts.push(sq2)
    sq_pts.push(sq3)
    let area_sq = polygon_area(sq_pts)
    // side in meters ~ 111195 m
    // expected area ~ 111195 * 111195 = 12364373025 m^2 ~= 1.236e10
    let expected_sq = 12364373025.0
    if not approx_pct(area_sq, expected_sq, 0.05)
        print("FAIL small square area: got " + str(area_sq) + " expected ~" + str(expected_sq))
        exit(1)

    // KAT 4: area is non-negative
    if area_sq < 0.0
        print("FAIL area negative: " + str(area_sq))
        exit(1)

    // KAT 5: triangle vs square — triangle should be ~half
    // Triangle (0,0),(0,1),(1,0)
    let tri_pts = []
    let t0 = []
    t0.push(0.0)
    t0.push(0.0)
    let t1 = []
    t1.push(0.0)
    t1.push(1.0)
    let t2 = []
    t2.push(1.0)
    t2.push(0.0)
    tri_pts.push(t0)
    tri_pts.push(t1)
    tri_pts.push(t2)
    let area_tri = polygon_area(tri_pts)
    // triangle area should be roughly half the square area (within ~10%)
    let half_sq = expected_sq / 2.0
    if not approx_pct(area_tri, half_sq, 0.10)
        print("FAIL triangle area: got " + str(area_tri) + " expected ~" + str(half_sq))
        exit(1)

    print("PASS _geo_area_test")
