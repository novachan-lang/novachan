// Test: polymorphic dispatch where builtin + struct share method name
// This should test the dynamic dispatch path for builtins

type Wrapper
    val: int

fn int__describe(x: int) -> string
    return "int:" + str(x)

fn Wrapper__describe(w: Wrapper) -> string
    return "wrapper:" + str(w.val)

fn main()
    // Static dispatch — these should work
    let x = 42
    assert(x.describe() == "int:42", "static int.describe")

    let w = Wrapper(99)
    assert(w.describe() == "wrapper:99", "static Wrapper.describe")

    // Dynamic dispatch — same method on different types
    let things = [x, w]
    let d0 = things[0].describe()
    let d1 = things[1].describe()
    assert(d0 == "int:42", "dyn int.describe")
    assert(d1 == "wrapper:99", "dyn Wrapper.describe")

    print("protocol_builtin_dyn: all passed")
