// KAT for std/core/query — fluent, generic query pipeline.
// Asserts EXACT results (structural list ==) for every method, then prints
// "QUERY KAT PASS" iff all checks hold.
import std/core/query

// compare a produced list against the expected list; report + count failures.
fn _q_check(fails: int, label, got, want) -> int
    if got == want
        return fails
    print("FAIL " + label + ": got " + str(got) + " want " + str(want))
    return fails + 1

fn main() -> int
    let fails = 0
    let a = [i for i in 1..21]                 // [1, 2, ..., 20]

    // ── the headline chain: evens -> squares -> desc -> top 3 ────────────────
    let top3 = q_from(a).where(fn(x) x % 2 == 0).map(fn(x) x * x).sort_by(fn(x) 0 - x).take(3).to_list()
    fails = _q_check(fails, "where/map/sort/take", top3, [400, 324, 256])

    // ── sort_by with non-int keys (generic merge-sort, not the int-only builtin)
    let ws = ["pear", "fig", "apple", "kiwi"]
    let byname = q_from(ws).where(fn(w) len(w) > 0).sort_by(fn(w) w).to_list()
    fails = _q_check(fails, "sort_by string", byname, ["apple", "fig", "kiwi", "pear"])
    let byf = q_from([3.5, 1.5, 2.5]).where(fn(x) x > 0.0).sort_by(fn(x) x).to_list()
    fails = _q_check(fails, "sort_by float", byf, [1.5, 2.5, 3.5])
    // stability: equal keys keep original relative order (b before d, a before c)
    let sp = [[2, 1], [1, 2], [2, 3], [1, 4]]
    let stab = q_from(sp).where(fn(p) true).sort_by(fn(p) p[0]).to_list()
    fails = _q_check(fails, "sort_by stable", stab, [[1, 2], [1, 4], [2, 1], [2, 3]])

    // ── group_by: bucket 1..20 by residue mod 3 ──────────────────────────────
    let g = q_from(a).group_by(fn(x) x % 3)
    fails = _q_check(fails, "group_by[0]", g[0], [3, 6, 9, 12, 15, 18])
    fails = _q_check(fails, "group_by[1]", g[1], [1, 4, 7, 10, 13, 16, 19])
    fails = _q_check(fails, "group_by[2]", g[2], [2, 5, 8, 11, 14, 17, 20])

    // ── distinct: dedup, first-seen order ────────────────────────────────────
    let d = q_from([3, 3, 1, 1, 2, 2, 3, 1]).distinct().to_list()
    fails = _q_check(fails, "distinct", d, [3, 1, 2])

    // ── flat_map: x -> [x, -x] ───────────────────────────────────────────────
    let fm = q_from([1, 2, 3]).flat_map(fn(x) [x, 0 - x]).to_list()
    fails = _q_check(fails, "flat_map", fm, [1, -1, 2, -2, 3, -3])

    // ── drop + take bounds-clamping ──────────────────────────────────────────
    fails = _q_check(fails, "drop", q_from(a).drop(17).to_list(), [18, 19, 20])
    fails = _q_check(fails, "take>len", q_from([1, 2]).take(10).to_list(), [1, 2])
    fails = _q_check(fails, "take<0", q_from([1, 2, 3]).take(0 - 1).to_list(), [])
    fails = _q_check(fails, "drop>len", q_from([1, 2, 3]).drop(99).to_list(), [])

    // ── reduce / sum / count ─────────────────────────────────────────────────
    let r = q_from(a).where(fn(x) x % 3 == 0).reduce(fn(acc, x) acc + x, 0)
    if r != 63
        print("FAIL reduce: got " + str(r) + " want 63")
        fails = fails + 1
    let s = q_from([1, 2, 3, 4, 5]).where(fn(x) x > 0).sum()
    if s != 15.0                                // sum is float-aware -> 15.0
        print("FAIL sum: got " + str(s) + " want 15.0")
        fails = fails + 1
    let c = q_from(a).where(fn(x) x > 15).count()
    if c != 5
        print("FAIL count: got " + str(c) + " want 5")
        fails = fails + 1

    // ── first -> Option (None on empty, Some(x0) otherwise) ──────────────────
    match q_from(a).where(fn(x) x > 100).first()
        Some(v) =>
            print("FAIL first-empty: got Some " + str(v))
            fails = fails + 1
        None =>
            fails = fails
    match q_from(a).where(fn(x) x > 7).first()
        Some(v) =>
            if v != 8
                print("FAIL first: got " + str(v) + " want 8")
                fails = fails + 1
        None =>
            print("FAIL first: got None want Some 8")
            fails = fails + 1

    if fails == 0
        print("QUERY KAT PASS")
    else
        print("QUERY KAT FAIL (" + str(fails) + ")")
    return 0
