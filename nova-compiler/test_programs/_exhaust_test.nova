fn safe_div(a: int, b: int) -> int
    if b == 0
        return unwrap_or(err("divide by zero"), -1)
    unwrap_or(ok(a / b), -1)

fn classify(r) -> string
    match r
        Ok(n) => "ok: " + str(n)
        Err(e) => "err: " + e

fn describe(o) -> string
    match o
        Some(v) => "some: " + str(v)
        None => "nothing"

fn classify_wild(r) -> string
    match r
        Ok(n) => "ok"
        _ => "other"

assert(classify(ok(42)) == "ok: 42", "Result Ok arm")
assert(classify(err("boom")) == "err: boom", "Result Err arm")
assert(describe(some(7)) == "some: 7", "Option Some arm")
assert(describe(none()) == "nothing", "Option None arm")
assert(classify_wild(ok(1)) == "ok", "Result with wildcard Ok")
assert(classify_wild(err("x")) == "other", "Result with wildcard Err")

print("all exhaustiveness tests passed")
