import std/greedy/jump_game

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _jump_game_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL _jump_game_test " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn main()
    // ── jg_can_reach ─────────────────────────────────────────────────────────
    // [2,3,1,1,4]: can always jump to end
    let a1 = []
    push(a1, 2)
    push(a1, 3)
    push(a1, 1)
    push(a1, 1)
    push(a1, 4)
    ckb("can_reach_true", jg_can_reach(a1), true)

    // [3,2,1,0,4]: gets stuck at index 3 (zero jump)
    let a2 = []
    push(a2, 3)
    push(a2, 2)
    push(a2, 1)
    push(a2, 0)
    push(a2, 4)
    ckb("can_reach_false", jg_can_reach(a2), false)

    // [0]: single element, already at last index
    let a3 = []
    push(a3, 0)
    ckb("can_reach_single", jg_can_reach(a3), true)

    // empty list: trivially true
    let a4 = []
    ckb("can_reach_empty", jg_can_reach(a4), true)

    // [1,0]: can only jump 1 from index 0, reaching last index (1)
    let a5 = []
    push(a5, 1)
    push(a5, 0)
    ckb("can_reach_two_ok", jg_can_reach(a5), true)

    // [0,1]: stuck at index 0 (zero jump, can't reach index 1)
    let a6 = []
    push(a6, 0)
    push(a6, 1)
    ckb("can_reach_zero_stuck", jg_can_reach(a6), false)

    // ── jg_min_jumps ─────────────────────────────────────────────────────────
    // [2,3,1,1,4]: jump from 0→1 (jump 3 covers 1..4), total 2 jumps
    let b1 = []
    push(b1, 2)
    push(b1, 3)
    push(b1, 1)
    push(b1, 1)
    push(b1, 4)
    cki("min_jumps_2a", jg_min_jumps(b1), 2)

    // [2,3,0,1,4]: 0→2→4, total 2 jumps
    let b2 = []
    push(b2, 2)
    push(b2, 3)
    push(b2, 0)
    push(b2, 1)
    push(b2, 4)
    cki("min_jumps_2b", jg_min_jumps(b2), 2)

    // [1,1,1,1]: must jump each step, 3 jumps for 4 elements
    let b3 = []
    push(b3, 1)
    push(b3, 1)
    push(b3, 1)
    push(b3, 1)
    cki("min_jumps_3", jg_min_jumps(b3), 3)

    // single element: 0 jumps needed
    let b4 = []
    push(b4, 0)
    cki("min_jumps_single", jg_min_jumps(b4), 0)

    // [5,1,1,1,1]: one big jump covers everything
    let b5 = []
    push(b5, 5)
    push(b5, 1)
    push(b5, 1)
    push(b5, 1)
    push(b5, 1)
    cki("min_jumps_one", jg_min_jumps(b5), 1)

    print("PASS _jump_game_test")
