// _harmonic_test.nova — KAT for std/math/harmonic
// Hand-computed reference values:
//   arithmetic_mean([1,2,3,4])    = (1+2+3+4)/4 = 10/4 = 2.5
//   harmonic_mean([1,2,4])        = 3/(1 + 0.5 + 0.25) = 3/1.75 = 1.71428...
//   quadratic_mean([3,4])         = sqrt((9+16)/2) = sqrt(12.5) = 3.53553...
//   geometric_mean([1,3,9])       = exp((ln1+ln3+ln9)/3) = exp(ln3) = 3.0
//   weighted_mean([1,2,3],[1,0,0])= (1*1+2*0+3*0)/(1+0+0) = 1.0
import std/math/harmonic

fn ckf(got: float, want: float, label: str)
    let diff = got - want
    let adiff = diff
    if adiff < 0.0
        adiff = 0.0 - adiff
    if adiff > 0.001
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // KAT 1: arithmetic mean
    let xs1 = [1, 2, 3, 4]
    let am = hm_arithmetic_mean(xs1)
    ckf(am, 2.5, "arithmetic_mean([1,2,3,4])")

    // KAT 2: harmonic mean
    // 3 / (1/1 + 1/2 + 1/4) = 3 / 1.75 = 1.714285...
    let xs2 = [1, 2, 4]
    let hm = hm_harmonic_mean(xs2)
    ckf(hm, 1.714285, "harmonic_mean([1,2,4])")

    // KAT 3: quadratic mean (RMS)
    // sqrt((3^2 + 4^2)/2) = sqrt(25/2) = sqrt(12.5) = 3.53553...
    let xs3 = [3, 4]
    let qm = hm_quadratic_mean(xs3)
    ckf(qm, 3.5355, "quadratic_mean([3,4])")

    // KAT 4: geometric mean
    // cube root of (1*3*9) = cube root of 27 = 3.0
    // via exp: exp((ln1 + ln3 + ln9)/3) = exp(ln3) = 3.0
    let xs4 = [1, 3, 9]
    let gm = hm_geometric_mean(xs4)
    ckf(gm, 3.0, "geometric_mean([1,3,9])")

    // KAT 5: weighted mean — only first weight non-zero
    let xs5 = [1, 2, 3]
    let ws5 = [1, 0, 0]
    let wm = hm_weighted_mean(xs5, ws5)
    ckf(wm, 1.0, "weighted_mean([1,2,3],[1,0,0])")

    // KAT 6: weighted mean with equal weights == arithmetic mean
    let xs6 = [2, 4, 6]
    let ws6 = [1, 1, 1]
    let wm2 = hm_weighted_mean(xs6, ws6)
    ckf(wm2, 4.0, "weighted_mean equal weights == arithmetic mean")

    // KAT 7: harmonic mean of [2,3] = 2/(1/2+1/3) = 2/(5/6) = 12/5 = 2.4
    let xs7 = [2, 3]
    let hm2 = hm_harmonic_mean(xs7)
    ckf(hm2, 2.4, "harmonic_mean([2,3])")

    // KAT 8: empty list returns 0.0 (no crash)
    let empty = []
    let am_empty = hm_arithmetic_mean(empty)
    ckf(am_empty, 0.0, "arithmetic_mean([])==0.0")

    print("_harmonic_test passed")
