// KAT for std/text/casefold cf_* API (full-folding tier: ASCII + Latin-1 Supplement +
// sz/SZ -> "ss" + dotted capital I -> i + combining dot above). UTF-8 source.
import std/text/casefold

fn ok_t(name: string, cond: bool)
    if not cond
        print("FAIL " + name)
        exit(1)
    print("ok " + name)

fn main()
    // ASCII
    ok_t("Hello==hello", cf_eq("Hello", "hello"))
    ok_t("HELLO==hello", cf_eq("HELLO", "hello"))
    ok_t("Hello!=world", not cf_eq("Hello", "world"))
    ok_t("cf_fold ASCII", cf_fold("Hello World") == "hello world")

    // German sharp s: straße == STRASSE (the headline case this tier exists for)
    ok_t("straße==STRASSE", cf_eq("straße", "STRASSE"))
    ok_t("STRASSE==straße", cf_eq("STRASSE", "straße"))
    ok_t("cf_fold straße", cf_fold("straße") == "strasse")
    // capital sharp s (U+1E9E) also folds to "ss"
    ok_t("STRASSE==STRAßE-capital", cf_eq("STRASSE", "STRAẞE"))

    // Latin-1 accented: café == CAFÉ
    ok_t("cafe==CAFE-accented", cf_eq("café", "CAFÉ"))
    ok_t("CAFE-accented==cafe", cf_eq("CAFÉ", "café"))
    ok_t("cf_fold café", cf_fold("café") == "café")
    ok_t("cf_fold CAFÉ", cf_fold("CAFÉ") == "café")
    // multiplication sign U+00D7 has no case -- passes through unchanged
    ok_t("multiply sign passthrough", cf_fold("5×3") == "5×3")

    // Turkish dotted capital I (U+0130) -> "i" + combining dot above (U+0307)
    ok_t("dotted-I fold", cf_fold("İstanbul") == "i" + "̇" + "stanbul")

    // empty strings
    ok_t("empty fold", cf_fold("") == "")
    ok_t("empty eq", cf_eq("", ""))
    ok_t("empty vs nonempty", not cf_eq("", "a"))

    // mixed case + substring/prefix/suffix helpers
    ok_t("contains WORLD in Hello World", cf_contains("Hello World", "WORLD"))
    ok_t("contains straße in STRASSE-word", cf_contains("Der STRASSENBAU", "straße"))
    ok_t("not contains xyz", not cf_contains("Hello World", "xyz"))
    ok_t("starts_with Hello", cf_starts_with("HELLO world", "hello"))
    ok_t("not starts_with world", not cf_starts_with("Hello World", "world"))
    ok_t("ends_with WORLD", cf_ends_with("Hello World", "world"))
    ok_t("not ends_with hello", not cf_ends_with("Hello World", "hello"))
    ok_t("empty needle contains", cf_contains("anything", ""))
    ok_t("empty prefix starts_with", cf_starts_with("anything", ""))
    ok_t("empty suffix ends_with", cf_ends_with("anything", ""))

    print("CASEFOLD KAT PASS")
