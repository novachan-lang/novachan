// #13 S3 Stage-A net: a push-built float array (which Stage A would make raw kind=2)
// read through EVERY generic / escape path. Raw storage is only sound if the list is
// DEOPTED to boxed before any generic read; a single un-deopted escape path = the
// 06-20 "raw bits read as a tagged value" corruption. Must pass today (boxed) and is
// the gate for enabling append_fraw.

type Holder
    items: list

fn take_any(v)
    v

fn sumlist(xs)
    let s = 0.0
    let i = 0
    while i < len(xs)
        s = s + xs[i]
        i = i + 1
    s

fn main()
    let fl = []
    push(fl, 1.5)
    push(fl, 2.5)
    push(fl, 4.0)

    // 1) direct typed reads
    assert(fl[0] == 1.5, "direct read 0")
    assert(fl[2] == 4.0, "direct read 2")
    assert(len(fl) == 3, "len")
    assert(sumlist(fl) == 8.0, "sum via fn param")

    // 2) str() / print() -> to_str reader must see floats, not raw-bit garbage
    let s = str(fl)
    assert(contains(s, "1.5"), "str contains 1.5")
    assert(contains(s, "4"), "str contains 4")

    // 3) equality reader (deep compare)
    let fl2 = []
    push(fl2, 1.5)
    push(fl2, 2.5)
    push(fl2, 4.0)
    assert(fl == fl2, "deep eq of two float arrays")
    let fl3 = []
    push(fl3, 1.5)
    push(fl3, 9.9)
    assert(not (fl == fl3), "deep neq")

    // 4) pass to an any param, then read back through it
    let a = take_any(fl)
    assert(a[1] == 2.5, "read via any-typed alias")

    // 5) alias then read (aliasing should taint->deopt, still correct)
    let g = fl
    assert(g[0] == 1.5, "alias read 0")
    push(g, 5.5)
    assert(fl[3] == 5.5, "alias mutation visible (shared)")

    // 6) store in a struct field, read back
    let h = Holder { items: fl }
    assert(h.items[2] == 4.0, "struct field list read")

    // 7) store in a dict, read back
    let d = {}
    d["xs"] = fl
    let back = d["xs"]
    assert(back[0] == 1.5, "dict-stored list read")

    // 10) index_set (mutate an element), then read
    fl[0] = 7.5
    assert(fl[0] == 7.5, "index_set then read")
    assert(fl[1] == 2.5, "neighbor intact after index_set")

    print("float_array_escape_test: all passed")
