import forge_di

fn main()
    let c = di_container()
    c = di_singleton(c, "db", {"host": "localhost", "port": 5432})
    c = di_singleton(c, "cache", {"type": "redis", "host": "localhost"})
    c = di_transient(c, "logger", {"level": "info"})

    assert(di_has(c, "db") == true, "has db")
    assert(di_has(c, "missing") == false, "no missing")

    let db = di_resolve(c, "db")
    assert(db["host"] == "localhost", "db host")
    assert(db["port"] == 5432, "db port")

    let db2 = di_resolve(c, "db")
    assert(db2["host"] == "localhost", "singleton same")

    let logger = di_resolve(c, "logger")
    assert(logger["level"] == "info", "logger level")

    let services = di_list_services(c)
    assert(len(services) == 3, "3 services")

    c = di_override(c, "db", {"host": "prod-db", "port": 5432})
    let prod_db = di_resolve(c, "db")
    assert(prod_db["host"] == "prod-db", "overridden db")

    c = di_remove(c, "cache")
    assert(di_has(c, "cache") == false, "cache removed")

    let child = di_scope(c)
    assert(di_has(child, "db") == true, "child has db")
    child = di_override(child, "db", {"host": "test-db", "port": 5432})
    let test_db = di_resolve(child, "db")
    assert(test_db["host"] == "test-db", "child override")

    print("FORGE-DI KAT PASS")
