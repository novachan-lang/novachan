import std/net/httpheaders

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got=[" + got + "] want=[" + want + "]")
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn main()
    // ── Test 1: basic two-header parse ────────────────────────────────────────
    let text = "Content-Type: text/html" + chr(10) + "X-Custom: 42"
    let p = hh_parse(text)

    // 1a: lowercase lookup matches
    cks("1a content-type lowercase", hh_get(p, "content-type"), "text/html")

    // 1b: mixed-case lookup also matches (auto-lowercased)
    cks("1b Content-Type mixed-case", hh_get(p, "Content-Type"), "text/html")

    // 1c: second header
    cks("1c x-custom", hh_get(p, "x-custom"), "42")

    // ── Test 2: hh_has ────────────────────────────────────────────────────────
    // 2a: present with mixed-case name
    ckb("2a hh_has X-Custom", hh_has(p, "X-Custom"), true)

    // 2b: absent header
    ckb("2b hh_has missing", hh_has(p, "missing"), false)

    // ── Test 3: hh_get absent key returns "" ──────────────────────────────────
    cks("3 absent key", hh_get(p, "absent"), "")

    // ── Test 4: blank lines ignored ───────────────────────────────────────────
    let text2 = "Host: example.com" + chr(10) + "" + chr(10) + "Accept: */*"
    let p2 = hh_parse(text2)
    cks("4a host", hh_get(p2, "host"), "example.com")
    cks("4b accept", hh_get(p2, "accept"), "*/*")
    // blank line should not have created an entry (dict should only have 2 keys)
    ckb("4c blank not stored", hh_has(p2, ""), false)

    // ── Test 5: hh_build produces correct output ───────────────────────────────
    let h = {}
    h["Content-Type"] = "text/html"
    h["X-Frame-Options"] = "DENY"
    let built = hh_build(h)
    // built must contain "Content-Type: text/html"
    let target = "Content-Type: text/html"
    let found = false
    let idx = 0
    let blen = len(built)
    let tlen = len(target)
    while idx <= blen - tlen
        let sub = slice(built, idx, idx + tlen)
        if sub == target
            found = true
            idx = blen
        else
            idx = idx + 1
    ckb("5 build contains Content-Type line", found, true)

    // ── Test 6: colon in value (URL) preserved ────────────────────────────────
    let text3 = "Location: http://example.com:8080/path"
    let p3 = hh_parse(text3)
    cks("6 colon-in-value", hh_get(p3, "location"), "http://example.com:8080/path")

    // ── Test 7: CRLF-delimited input ─────────────────────────────────────────
    let text4 = "Cache-Control: no-cache" + chr(13) + chr(10) + "Pragma: no-cache"
    let p4 = hh_parse(text4)
    cks("7a cache-control", hh_get(p4, "cache-control"), "no-cache")
    cks("7b pragma", hh_get(p4, "pragma"), "no-cache")

    // ── Test 8: request line skipped (no colon on request line) ───────────────
    // "GET / HTTP/1.1" has no colon before first space, but colon IS absent
    // entirely. Our rule: skip lines where colon index <= 0 (not found = -1).
    let text5 = "GET / HTTP/1.1" + chr(10) + "Host: localhost"
    let p5 = hh_parse(text5)
    cks("8a host from request", hh_get(p5, "host"), "localhost")
    // The request line has no ":" so it should not be stored
    ckb("8b request line not stored", hh_has(p5, "get / http/1.1"), false)

    print("_httpheaders_test passed")
