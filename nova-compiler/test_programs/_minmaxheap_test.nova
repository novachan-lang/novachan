import std/collections/minmaxheap

fn cki(label, got, expected)
    if got != expected
        print("FAIL minmaxheap " + label + ": got " + str(got) + " want " + str(expected))
        exit(1)

fn main()
    // ---- KAT 1: basic push sequence, then min/max/size ----
    // push 5,3,8,1,9,2
    let h = mmh_new()
    mmh_push(h, 5)
    mmh_push(h, 3)
    mmh_push(h, 8)
    mmh_push(h, 1)
    mmh_push(h, 9)
    mmh_push(h, 2)
    cki("size_6", mmh_size(h), 6)
    cki("min_1", mmh_min(h), 1)
    cki("max_9", mmh_max(h), 9)

    // ---- KAT 2: pop_min returns 1 and new min is 2 ----
    let pm1 = mmh_pop_min(h)
    cki("pop_min_1", pm1, 1)
    cki("min_after_pop_2", mmh_min(h), 2)
    cki("size_5", mmh_size(h), 5)

    // ---- KAT 3: pop_max returns 9 and new max is 8 ----
    let pmax1 = mmh_pop_max(h)
    cki("pop_max_9", pmax1, 9)
    cki("max_after_pop_8", mmh_max(h), 8)
    cki("size_4", mmh_size(h), 4)

    // ---- KAT 4: pop all remaining in sorted order via pop_min ----
    let v1 = mmh_pop_min(h)
    cki("sorted1", v1, 2)
    let v2 = mmh_pop_min(h)
    cki("sorted2", v2, 3)
    let v3 = mmh_pop_min(h)
    cki("sorted3", v3, 5)
    let v4 = mmh_pop_min(h)
    cki("sorted4", v4, 8)
    cki("size_empty", mmh_size(h), 0)

    // ---- KAT 5: single element — min == max ----
    let hs = mmh_new()
    mmh_push(hs, 42)
    cki("single_min", mmh_min(hs), 42)
    cki("single_max", mmh_max(hs), 42)
    cki("single_size", mmh_size(hs), 1)
    let sp = mmh_pop_min(hs)
    cki("single_pop_min", sp, 42)
    cki("single_empty", mmh_size(hs), 0)

    // ---- KAT 6: empty heap operations return null ----
    let he = mmh_new()
    let enull1 = mmh_min(he)
    if enull1 != null
        print("FAIL minmaxheap empty_min: expected null got " + str(enull1))
        exit(1)
    let enull2 = mmh_max(he)
    if enull2 != null
        print("FAIL minmaxheap empty_max: expected null got " + str(enull2))
        exit(1)
    let enull3 = mmh_pop_min(he)
    if enull3 != null
        print("FAIL minmaxheap empty_pop_min: expected null got " + str(enull3))
        exit(1)
    let enull4 = mmh_pop_max(he)
    if enull4 != null
        print("FAIL minmaxheap empty_pop_max: expected null got " + str(enull4))
        exit(1)

    // ---- KAT 7: duplicates ----
    let hd = mmh_new()
    mmh_push(hd, 5)
    mmh_push(hd, 5)
    mmh_push(hd, 3)
    mmh_push(hd, 3)
    mmh_push(hd, 7)
    cki("dup_min", mmh_min(hd), 3)
    cki("dup_max", mmh_max(hd), 7)
    cki("dup_size", mmh_size(hd), 5)
    let dp1 = mmh_pop_min(hd)
    cki("dup_pop_min1", dp1, 3)
    let dp2 = mmh_pop_min(hd)
    cki("dup_pop_min2", dp2, 3)
    let dp3 = mmh_pop_max(hd)
    cki("dup_pop_max1", dp3, 7)
    let dp4 = mmh_pop_max(hd)
    cki("dup_pop_max2", dp4, 5)
    let dp5 = mmh_pop_max(hd)
    cki("dup_pop_max3", dp5, 5)
    cki("dup_empty", mmh_size(hd), 0)

    // ---- KAT 8: two-element heap ----
    let h2 = mmh_new()
    mmh_push(h2, 10)
    mmh_push(h2, 3)
    cki("two_min", mmh_min(h2), 3)
    cki("two_max", mmh_max(h2), 10)
    let tp1 = mmh_pop_max(h2)
    cki("two_pop_max", tp1, 10)
    cki("two_remaining_min", mmh_min(h2), 3)
    cki("two_remaining_max", mmh_max(h2), 3)

    // ---- KAT 9: pop_max on single element ----
    let hpm = mmh_new()
    mmh_push(hpm, 77)
    let xpm = mmh_pop_max(hpm)
    cki("single_pop_max", xpm, 77)
    cki("single_pop_max_empty", mmh_size(hpm), 0)

    // ---- KAT 10: larger sequence, interleave pop_min and pop_max ----
    let hm = mmh_new()
    mmh_push(hm, 10)
    mmh_push(hm, 4)
    mmh_push(hm, 7)
    mmh_push(hm, 1)
    mmh_push(hm, 15)
    mmh_push(hm, 6)
    mmh_push(hm, 3)
    mmh_push(hm, 12)
    // pop min twice then max twice
    let r1 = mmh_pop_min(hm)
    cki("large_pop_min1", r1, 1)
    let r2 = mmh_pop_min(hm)
    cki("large_pop_min2", r2, 3)
    let r3 = mmh_pop_max(hm)
    cki("large_pop_max1", r3, 15)
    let r4 = mmh_pop_max(hm)
    cki("large_pop_max2", r4, 12)
    cki("large_size", mmh_size(hm), 4)
    cki("large_min_now", mmh_min(hm), 4)
    cki("large_max_now", mmh_max(hm), 10)

    print("PASS _minmaxheap_test")
