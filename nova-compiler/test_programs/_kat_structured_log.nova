import forge_structured_log

fn main()
    let s = slog_new()
    assert(slog_entry_count(s) == 0, "starts empty")

    s = slog_debug(s, "init complete", "module", "app")
    s = slog_info(s, "server started", "port", "8080")
    s = slog_warn(s, "high latency", "ms", "500")
    s = slog_error(s, "connection failed", "host", "db-1")
    assert(slog_entry_count(s) == 4, "4 entries")

    assert(slog_entry_msg(s, 0) == "init complete", "msg 0")
    assert(slog_entry_level(s, 0) == 0, "level 0 = debug")
    assert(slog_entry_level(s, 3) == 3, "level 3 = error")

    s = slog_set_level(s, 2)
    s = slog_debug(s, "filtered", "x", "y")
    s = slog_info(s, "filtered", "x", "y")
    assert(slog_entry_count(s) == 4, "debug/info filtered")

    s = slog_warn(s, "visible", "z", "w")
    assert(slog_entry_count(s) == 5, "warn passes filter")

    assert(slog_entry_msg(s, -1) == "", "neg idx empty")
    assert(slog_entry_msg(s, 99) == "", "out of range empty")

    print("STRUCTURED-LOG KAT PASS")
