// KAT for std/text/titlecase -- small-word title casing.
import std/text/titlecase

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": '" + got + "' != '" + want + "'")
        exit(1)

fn main()
    // KAT 1: classic fantasy title -- first and last always cap, small words in middle stay lower
    cks("rings", tc_title("the lord of the rings"), "The Lord of the Rings")
    // KAT 2: first word is small (a) -- must still be capitalized
    cks("cities", tc_title("a tale of two cities"), "A Tale of Two Cities")
    // KAT 3: "with" is not a small word; "the" in middle is
    cks("wind", tc_title("gone with the wind"), "Gone With the Wind")
    // KAT 4: first/last both small words; middle small words stay lower
    cks("hamlet", tc_title("to be or not to be"), "To Be or Not to Be")
    // KAT 5: single word -- is both first and last, must capitalize
    cks("single", tc_title("hello"), "Hello")
    // KAT 6: "and" is small word in middle position
    cks("tolstoy", tc_title("war and peace"), "War and Peace")
    // KAT 7: mix of small and non-small; "out" is not small
    cks("prepositions", tc_title("in and out of the park"), "In and Out of the Park")
    // KAT 8: already mixed-case input should be normalized
    cks("mixed-input", tc_title("THE QUICK BROWN FOX"), "The Quick Brown Fox")
    print("_titlecase_test passed")
