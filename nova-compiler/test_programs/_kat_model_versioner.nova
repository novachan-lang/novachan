import forge_model_versioner

fn main()
    let mv = mv_new()
    mv = mv_register(mv, "classifier")
    mv = mv_register(mv, "detector")
    assert(mv_model_count(mv) == 2, "2 models")

    let v1 = mv_add_version(mv, "classifier", "v1.0", 85)
    mv = unwrap(v1)
    let v2 = mv_add_version(mv, "classifier", "v1.1", 90)
    mv = unwrap(v2)
    let v3 = mv_add_version(mv, "detector", "v0.1", 70)
    mv = unwrap(v3)
    assert(mv_total_versions(mv) == 3, "3 versions")

    let vc = mv_version_count(mv, "classifier")
    assert(unwrap(vc) == 2, "classifier has 2")

    let lt = mv_latest(mv, "classifier")
    assert(unwrap(lt) == "v1.1", "latest v1.1")

    let p1 = mv_promote(mv, "classifier", "v1.1")
    mv = unwrap(p1)
    let act = mv_active(mv, "classifier")
    assert(unwrap(act) == "v1.1", "active v1.1")
    assert(mv_promoted_count(mv) == 1, "1 promoted")

    let acc = mv_accuracy(mv, "classifier", "v1.0")
    assert(unwrap(acc) == 85, "v1.0 acc 85")

    let st = mv_status(mv, "classifier", "v1.1")
    assert(unwrap(st) == "active", "v1.1 active")
    let st2 = mv_status(mv, "classifier", "v1.0")
    assert(unwrap(st2) == "staged", "v1.0 staged")

    let noact = mv_active(mv, "detector")
    assert(is_err(noact), "no active for detector")

    let bad = mv_add_version(mv, "nope", "v1", 50)
    assert(is_err(bad), "unknown model")

    let bad2 = mv_promote(mv, "classifier", "v9.9")
    assert(is_err(bad2), "unknown version")

    print("MODEL-VERSIONER KAT PASS")
