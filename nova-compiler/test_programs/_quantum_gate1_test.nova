import std/quantum/quantum_state
import std/quantum/quantum_gate1

// cki — integer known-answer check.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _quantum_gate1_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// _round1000 — local test helper: round x*1000 to nearest int (handles negative x).
fn _round1000(x: float) -> int
    if x < 0.0
        let neg = 0.0 - x
        let scaled = neg * 1000.0 + 0.5
        let r = float_to_int(scaled)
        return 0 - r
    let scaled = x * 1000.0 + 0.5
    float_to_int(scaled)

fn main()
    let PI = 3.14159265358979323846

    // qg1_apply core, called directly with a matrix (not just via wrappers):
    // X|0> = |1>.
    let s1 = qg1_apply(qst_zero(1), qg1_x(), 0)
    cki("qg1_apply(X)|0>=|1>", qst_equal_x1000(s1, qst_basis(1, 1)), 1)

    // X|0> = |1> via wrapper.
    let sx0 = qg1_apply_x(qst_zero(1), 0)
    cki("X|0>=|1>", qst_equal_x1000(sx0, qst_basis(1, 1)), 1)

    // X|1> = |0>.
    let sx1 = qg1_apply_x(qst_basis(1, 1), 0)
    cki("X|1>=|0>", qst_equal_x1000(sx1, qst_basis(1, 0)), 1)

    // X on qubit 0 of a 2-qubit |00> -> |10> = basis(2,2).
    let sx2 = qg1_apply_x(qst_zero(2), 0)
    cki("X q0 of |00>=|10>", qst_equal_x1000(sx2, qst_basis(2, 2)), 1)

    // X on qubit 1 (not qubit 0) of a 2-qubit |00> -> |01> = basis(2,1).
    let sx3 = qg1_apply_x(qst_zero(2), 1)
    cki("X q1 of |00>=|01>", qst_equal_x1000(sx3, qst_basis(2, 1)), 1)

    // H|0> gives 50/50 split.
    let h0 = qg1_apply_h(qst_zero(1), 0)
    cki("H|0> prob0", qst_prob_x1000(h0, 0), 500)
    cki("H|0> prob1", qst_prob_x1000(h0, 1), 500)

    // H.H|0> = |0> (H is its own inverse).
    let hh0 = qg1_apply_h(h0, 0)
    cki("H.H|0> prob0", qst_prob_x1000(hh0, 0), 1000)
    cki("H.H|0> prob1", qst_prob_x1000(hh0, 1), 0)

    // Z|1>: probability unchanged, only phase flips.
    let z1 = qg1_apply_z(qst_basis(1, 1), 0)
    cki("Z|1> prob1", qst_prob_x1000(z1, 1), 1000)
    let z1amp = qst_amp(z1, 1)
    cki("Z|1> amp1 re", _round1000(z1amp[0]), -1000)

    // Z|0>: unchanged entirely (Z|0> = |0>).
    let z0 = qg1_apply_z(qst_basis(1, 0), 0)
    cki("Z|0>=|0>", qst_equal_x1000(z0, qst_basis(1, 0)), 1)

    // Y|0> = i|1>: prob0=0, prob1=1.
    let y0 = qg1_apply_y(qst_zero(1), 0)
    cki("Y|0> prob0", qst_prob_x1000(y0, 0), 0)
    cki("Y|0> prob1", qst_prob_x1000(y0, 1), 1000)
    let y0amp = qst_amp(y0, 1)
    cki("Y|0> amp1 im", _round1000(y0amp[1]), 1000)

    // Y|1> = -i|0>: prob0=1, prob1=0.
    let y1 = qg1_apply_y(qst_basis(1, 1), 0)
    cki("Y|1> prob0", qst_prob_x1000(y1, 0), 1000)
    let y1amp = qst_amp(y1, 0)
    cki("Y|1> amp0 im", _round1000(y1amp[1]), -1000)

    // S|1> = i|1>.
    let s_1 = qg1_apply_s(qst_basis(1, 1), 0)
    cki("S|1> prob1", qst_prob_x1000(s_1, 1), 1000)
    let s1amp = qst_amp(s_1, 1)
    cki("S|1> amp1 re", _round1000(s1amp[0]), 0)
    cki("S|1> amp1 im", _round1000(s1amp[1]), 1000)

    // T|1> = e^{i pi/4}|1>: re=im=cos(pi/4)~=0.7071.
    let t1 = qg1_apply_t(qst_basis(1, 1), 0)
    let t1amp = qst_amp(t1, 1)
    cki("T|1> amp1 re", _round1000(t1amp[0]), 707)
    cki("T|1> amp1 im", _round1000(t1amp[1]), 707)

    // S then Sdg is identity.
    let s_then_sd = qg1_apply(s_1, qg1_sdg(), 0)
    cki("S.Sdg|1>=|1>", qst_equal_x1000(s_then_sd, qst_basis(1, 1)), 1)

    // T then Tdg is identity.
    let t_then_td = qg1_apply(t1, qg1_tdg(), 0)
    cki("T.Tdg|1>=|1>", qst_equal_x1000(t_then_td, qst_basis(1, 1)), 1)

    // Identity gate leaves state unchanged.
    let idn = qg1_apply(qst_basis(1, 1), qg1_i(), 0)
    cki("I|1>=|1>", qst_equal_x1000(idn, qst_basis(1, 1)), 1)

    // RX(pi)|0> = -i|1>: prob0=0, prob1=1.
    let rx0 = qg1_apply(qst_zero(1), qg1_rx(PI), 0)
    cki("RX(pi)|0> prob0", qst_prob_x1000(rx0, 0), 0)
    cki("RX(pi)|0> prob1", qst_prob_x1000(rx0, 1), 1000)

    // RY(pi)|0> = |1> exactly (real rotation).
    let ry0 = qg1_apply(qst_zero(1), qg1_ry(PI), 0)
    cki("RY(pi)|0>=|1>", qst_equal_x1000(ry0, qst_basis(1, 1)), 1)

    // RZ(pi)|0>: probability unchanged (diagonal gate), amp0 = -i.
    let rz0 = qg1_apply(qst_zero(1), qg1_rz(PI), 0)
    cki("RZ(pi)|0> prob0", qst_prob_x1000(rz0, 0), 1000)
    let rz0amp = qst_amp(rz0, 0)
    cki("RZ(pi)|0> amp0 im", _round1000(rz0amp[1]), -1000)

    // Phase(pi/2)|1> = i|1>.
    let ph1 = qg1_apply(qst_basis(1, 1), qg1_phase(PI / 2.0), 0)
    cki("Phase(pi/2)|1> prob1", qst_prob_x1000(ph1, 1), 1000)
    let ph1amp = qst_amp(ph1, 1)
    cki("Phase(pi/2)|1> amp1 re", _round1000(ph1amp[0]), 0)
    cki("Phase(pi/2)|1> amp1 im", _round1000(ph1amp[1]), 1000)

    print("PASS _quantum_gate1_test")
