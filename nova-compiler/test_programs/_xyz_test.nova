import std/color/xyz

// ckf: check float within eps
fn ckf(label: string, got: float, expected: float, eps: float)
    let diff = got - expected
    let adiff = 0.0
    if diff < 0.0
        adiff = 0.0 - diff
    else
        adiff = diff
    if adiff > eps
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// cki: check int exact
fn cki(label: string, got: int, expected: int)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn main()
    // KAT 1: cxyz_from_rgb([255,255,255])[1] == 100.0 (Y of white), eps 0.5
    let white = [255, 255, 255]
    let white_xyz = cxyz_from_rgb(white)
    let white_Y = white_xyz[1]
    ckf("white_Y_100", white_Y, 100.0, 0.5)

    // KAT 2: cxyz_from_rgb([0,0,0]) == [0.0, 0.0, 0.0]
    let black = [0, 0, 0]
    let black_xyz = cxyz_from_rgb(black)
    let black_X = black_xyz[0]
    let black_Y = black_xyz[1]
    let black_Z = black_xyz[2]
    ckf("black_X_0", black_X, 0.0, 0.5)
    ckf("black_Y_0", black_Y, 0.0, 0.5)
    ckf("black_Z_0", black_Z, 0.0, 0.5)

    // KAT 3: cxyz_luminance([255,255,255]) == 1.0
    let lum_white = cxyz_luminance(white)
    ckf("lum_white_1", lum_white, 1.0, 0.5)

    // KAT 4: cxyz_luminance([0,0,0]) == 0.0
    let lum_black = cxyz_luminance(black)
    ckf("lum_black_0", lum_black, 0.0, 0.5)

    // KAT 5: cxyz_luminance([255,0,0]) == 0.2126 (eps 0.005)
    let red = [255, 0, 0]
    let lum_red = cxyz_luminance(red)
    ckf("lum_red_0_2126", lum_red, 0.2126, 0.005)

    // KAT 6: round-trip cxyz_to_rgb(cxyz_from_rgb([128,64,200])) within +/-3 per channel
    let orig = [128, 64, 200]
    let orig_xyz = cxyz_from_rgb(orig)
    let ox = orig_xyz[0]
    let oy = orig_xyz[1]
    let oz = orig_xyz[2]
    let rt = cxyz_to_rgb(ox, oy, oz)
    let rtr = rt[0]
    let rtg = rt[1]
    let rtb = rt[2]
    // Check each channel within +/-3 using float comparison
    let dr = rtr - 128
    let adr = 0
    if dr < 0
        adr = 0 - dr
    else
        adr = dr
    let dg = rtg - 64
    let adg = 0
    if dg < 0
        adg = 0 - dg
    else
        adg = dg
    let db = rtb - 200
    let adb = 0
    if db < 0
        adb = 0 - db
    else
        adb = db
    if adr > 3
        print("FAIL rt_r: got " + str(rtr) + " expected ~128")
        exit(1)
    if adg > 3
        print("FAIL rt_g: got " + str(rtg) + " expected ~64")
        exit(1)
    if adb > 3
        print("FAIL rt_b: got " + str(rtb) + " expected ~200")
        exit(1)

    print("_xyz_test passed")
