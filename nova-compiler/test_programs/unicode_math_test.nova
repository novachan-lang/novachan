// Unicode (codepoint-aware) + numerics completeness test.

fn main()
    // ── Unicode: codepoint vs byte semantics ──────────────────────────────
    // é = U+00E9 (2 UTF-8 bytes); built via from_codepoint to avoid source-encoding ambiguity.
    let eacute = from_codepoint(233)
    assert_eq(len(eacute), 2)            // byte length
    assert_eq(char_count(eacute), 1)     // codepoint count
    assert_eq(is_valid_utf8(eacute), true)

    let word = "caf" + eacute            // "café"
    assert_eq(len(word), 5)              // 5 bytes
    assert_eq(char_count(word), 4)       // 4 codepoints
    assert_eq(char_at(word, 0), "c")
    assert_eq(char_at(word, 3), eacute)
    assert_eq(char_at(word, 9), "")      // out of range -> ""

    let cps = code_points(word)
    assert_eq(len(cps), 4)
    assert_eq(cps[0], 99)
    assert_eq(cps[1], 97)
    assert_eq(cps[2], 102)
    assert_eq(cps[3], 233)

    // 4-byte codepoint (emoji U+1F600)
    let emoji = from_codepoint(128512)
    assert_eq(len(emoji), 4)             // 4 bytes
    assert_eq(char_count(emoji), 1)      // 1 codepoint
    let cps2 = code_points(emoji)
    assert_eq(cps2[0], 128512)

    // round-trip: codepoints -> string -> codepoints
    assert_eq(char_at("hello", 1), "e")
    assert_eq(char_count("hello"), 5)

    // invalid UTF-8: a lone lead byte (0xC3) is not valid
    assert_eq(is_valid_utf8(chr(195)), false)
    assert_eq(is_valid_utf8("plain ascii"), true)

    // ── Numerics completeness ─────────────────────────────────────────────
    assert_near(sinh(0.0), 0.0, 0.0001)
    assert_near(cosh(0.0), 1.0, 0.0001)
    assert_near(tanh(0.0), 0.0, 0.0001)
    assert_near(cbrt(27.0), 3.0, 0.0001)
    assert_near(hypot(3.0, 4.0), 5.0, 0.0001)
    assert_near(fmod(10.0, 3.0), 1.0, 0.0001)
    assert_near(pi(), 3.14159, 0.001)
    assert_near(e(), 2.71828, 0.001)

    assert_eq(gcd(12, 18), 6)
    assert_eq(gcd(17, 5), 1)
    assert_eq(gcd(-12, 18), 6)
    assert_eq(lcm(4, 6), 12)
    assert_eq(lcm(0, 5), 0)

    print("unicode_math_test passed")
