// KAT test for std/cipher/hill
// Hill cipher (2x2 matrix, mod 26).
import std/cipher/hill

fn cks(label, got, want)
    if got != want
        print("FAIL _hill_test " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL _hill_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    if got != want
        let gs = "false"
        let ws = "false"
        if got
            gs = "true"
        if want
            ws = "true"
        print("FAIL _hill_test " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn main()
    // ── KAT 1: mod_inverse known vectors ──────────────────────────────────────
    cki("mod_inv_3_26", mod_inverse(3, 26), 9)
    cki("mod_inv_9_26", mod_inverse(9, 26), 3)
    cki("mod_inv_1_26", mod_inverse(1, 26), 1)
    cki("mod_inv_25_26", mod_inverse(25, 26), 25)
    cki("mod_inv_2_26_none", mod_inverse(2, 26), -1)
    cki("mod_inv_13_26_none", mod_inverse(13, 26), -1)

    // ── KAT 2: hill_invertible ────────────────────────────────────────────────
    let key1 = []
    push(key1, 3)
    push(key1, 3)
    push(key1, 2)
    push(key1, 5)
    ckb("invertible_3325", hill_invertible(key1), true)

    let key2 = []
    push(key2, 2)
    push(key2, 4)
    push(key2, 2)
    push(key2, 4)
    ckb("invertible_2424_false", hill_invertible(key2), false)

    let key3 = []
    push(key3, 1)
    push(key3, 0)
    push(key3, 0)
    push(key3, 1)
    ckb("invertible_identity", hill_invertible(key3), true)

    let key_sing = []
    push(key_sing, 3)
    push(key_sing, 2)
    push(key_sing, 3)
    push(key_sing, 2)
    ckb("invertible_singular_false", hill_invertible(key_sing), false)

    // ── KAT 3: hill_encrypt known vector ─────────────────────────────────────
    // hill_encrypt("HELP", [3,3,2,5]) == "HIAT"
    // H=7,E=4: c0=(3*7+3*4)%26=33%26=7=H, c1=(2*7+5*4)%26=34%26=8=I -> "HI"
    // L=11,P=15: c0=(3*11+3*15)%26=78%26=0=A, c1=(2*11+5*15)%26=97%26=19=T -> "AT"
    cks("encrypt_HELP", hill_encrypt("HELP", key1), "HIAT")

    // ── KAT 4: hill_decrypt known vector ─────────────────────────────────────
    cks("decrypt_HIAT", hill_decrypt("HIAT", key1), "HELP")

    // ── KAT 5: round-trip various plaintexts ─────────────────────────────────
    // "HELLOX" is even-length so round-trip is exact
    let pt1pad = "HELLOX"
    cks("roundtrip_HELLOX", hill_decrypt(hill_encrypt(pt1pad, key1), key1), pt1pad)

    let pt2 = "ATTACKATDAWN"
    cks("roundtrip_ATTACKATDAWN", hill_decrypt(hill_encrypt(pt2, key1), key1), pt2)

    let pt3 = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    cks("roundtrip_alphabet", hill_decrypt(hill_encrypt(pt3, key1), key1), pt3)

    let pt4pad = "NOVAPROGRAMMINGLANGUAGEX"
    cks("roundtrip_NOVA_padded", hill_decrypt(hill_encrypt(pt4pad, key1), key1), pt4pad)

    // ── KAT 6: identity key round-trip ───────────────────────────────────────
    let pt5 = "HELLOWORLD"
    cks("roundtrip_identity_key", hill_decrypt(hill_encrypt(pt5, key3), key3), pt5)

    // ── KAT 7: lowercase + non-letters get normalized ────────────────────────
    cks("encrypt_lowercase", hill_encrypt("help", key1), "HIAT")
    cks("encrypt_spaces", hill_encrypt("H E L P", key1), "HIAT")

    // ── KAT 8: empty input ────────────────────────────────────────────────────
    cks("encrypt_empty", hill_encrypt("", key1), "")
    cks("decrypt_empty", hill_decrypt("", key1), "")

    // ── KAT 9: single letter input (padded with X) ───────────────────────────
    // "A" -> "AX": c0=(3*0+3*23)%26=69%26=17=R, c1=(2*0+5*23)%26=115%26=11=L
    cks("encrypt_single_A", hill_encrypt("A", key1), "RL")

    // ── KAT 10: determinism ───────────────────────────────────────────────────
    let enc1a = hill_encrypt("SECURITY", key1)
    let enc1b = hill_encrypt("SECURITY", key1)
    cks("deterministic", enc1a, enc1b)

    print("PASS _hill_test")
