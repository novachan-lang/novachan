import std/combinatorics/derangement

// cki — check integer equality
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL derangement " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb — check bool equality
fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL derangement " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

// list_to_str — flatten a list to a string for comparison
fn list_to_str(xs) -> string
    let s = "["
    let i = 0
    let n = len(xs)
    while i < n
        if i > 0
            s = s + ","
        s = s + str(xs[i])
        i = i + 1
    s = s + "]"
    return s

// ckl — check list equality as string
fn ckl(label: string, got, want: string)
    let gs = list_to_str(got)
    if gs != want
        print("FAIL derangement " + label + ": got=" + gs + " want=" + want)
        exit(1)

// ckll — check list-of-lists equality as string
fn sublist_to_str(xss) -> string
    let s = "["
    let i = 0
    let n = len(xss)
    while i < n
        if i > 0
            s = s + ","
        s = s + list_to_str(xss[i])
        i = i + 1
    s = s + "]"
    return s

fn ckll(label: string, got, want: string)
    let gs = sublist_to_str(got)
    if gs != want
        print("FAIL derangement " + label + ": got=" + gs + " want=" + want)
        exit(1)

fn main()
    // --- der_count ---
    cki("der_count(0)", der_count(0), 1)
    cki("der_count(1)", der_count(1), 0)
    cki("der_count(2)", der_count(2), 1)
    cki("der_count(3)", der_count(3), 2)
    cki("der_count(4)", der_count(4), 9)
    cki("der_count(5)", der_count(5), 44)

    // --- der_is_derangement ---
    let p12 = [2, 1]
    let o12 = [1, 2]
    ckb("is_der([2,1],[1,2])", der_is_derangement(p12, o12), true)
    let p12b = [1, 2]
    ckb("is_der([1,2],[1,2])", der_is_derangement(p12b, o12), false)
    let p123a = [2, 3, 1]
    let o123 = [1, 2, 3]
    ckb("is_der([2,3,1],[1,2,3])", der_is_derangement(p123a, o123), true)
    let p123b = [1, 3, 2]
    ckb("is_der([1,3,2],[1,2,3])", der_is_derangement(p123b, o123), false)

    // --- der_all ---
    let items3 = [1, 2, 3]
    let d3 = der_all(items3)
    cki("der_all([1,2,3]) len", len(d3), 2)
    ckll("der_all([1,2,3])", d3, "[[2,3,1],[3,1,2]]")

    let items2 = [1, 2]
    let d2 = der_all(items2)
    cki("der_all([1,2]) len", len(d2), 1)
    ckl("der_all([1,2])[0]", d2[0], "[2,1]")

    // der_all([1]) should be empty (no derangements possible)
    let items1 = [1]
    let d1 = der_all(items1)
    cki("der_all([1]) len", len(d1), 0)

    // der_all([1,2,3,4]) should have 9 derangements
    let items4 = [1, 2, 3, 4]
    let d4 = der_all(items4)
    cki("der_all([1,2,3,4]) len", len(d4), 9)

    // --- der_nth ---
    let dn0 = der_nth(items3, 0)
    ckl("der_nth([1,2,3],0)", dn0, "[2,3,1]")
    let dn1 = der_nth(items3, 1)
    ckl("der_nth([1,2,3],1)", dn1, "[3,1,2]")

    // --- der_count_with_fixed ---
    // C(4,1) * D_3 = 4 * 2 = 8
    cki("der_count_with_fixed(4,1)", der_count_with_fixed(4, 1), 8)
    // C(4,0) * D_4 = 1 * 9 = 9
    cki("der_count_with_fixed(4,0)", der_count_with_fixed(4, 0), 9)
    // C(4,4) * D_0 = 1 * 1 = 1
    cki("der_count_with_fixed(4,4)", der_count_with_fixed(4, 4), 1)
    // C(5,2) * D_3 = 10 * 2 = 20
    cki("der_count_with_fixed(5,2)", der_count_with_fixed(5, 2), 20)

    // --- der_ratio_permille ---
    // D_5*1000/5! = 44000/120 = 366
    cki("der_ratio_permille(5)", der_ratio_permille(5), 366)
    // D_4*1000/4! = 9000/24 = 375
    cki("der_ratio_permille(4)", der_ratio_permille(4), 375)

    // --- der_partial ---
    // With fixed_allowed=[] on [1,2,3] => same as der_all
    let fp0 = []
    let dp0 = der_partial(items3, fp0)
    cki("der_partial([1,2,3],[]) len", len(dp0), 2)
    // With fixed_allowed=[0] on [1,2,3]: pos 0 may keep value 1
    // derangements of 2,3 restricted + pos 0 free to be anything
    // all perms where pos 1 != 2 and pos 2 != 3
    let fp1 = [0]
    let dp1 = der_partial(items3, fp1)
    // should include [1,3,2] (pos0=1=fixed ok, pos1=3!=2 ok, pos2=2!=3 ok)
    // plus the 2 full derangements: [2,3,1],[3,1,2]
    // total 3
    cki("der_partial([1,2,3],[0]) len", len(dp1), 3)

    print("PASS _derangement_test")
