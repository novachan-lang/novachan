// _grammar_ll1_test — KAT for std/grammar/grammar_ll1.nova
// Dragon-book LL(1) expression grammar (already left-factored):
//   E -> T X; X -> + T X | eps; T -> F Y; Y -> * F Y | eps; F -> ( E ) | id
// This grammar IS LL(1) (textbook verified).
// A conflicting grammar (two alternatives starting with same terminal) is NOT LL(1).

import std/grammar/grammar_ll1

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn build_expr_grammar()
    let p1 = ["E", ["T", "X"]]
    let p2 = ["X", ["+", "T", "X"]]
    let p3 = ["X", []]
    let p4 = ["T", ["F", "Y"]]
    let p5 = ["Y", ["*", "F", "Y"]]
    let p6 = ["Y", []]
    let p7 = ["F", ["(", "E", ")"]]
    let p8 = ["F", ["id"]]
    let prods = []
    prods.push(p1)
    prods.push(p2)
    prods.push(p3)
    prods.push(p4)
    prods.push(p5)
    prods.push(p6)
    prods.push(p7)
    prods.push(p8)
    return prods

fn main()
    let prods = build_expr_grammar()

    // KAT 1: expression grammar IS LL(1)
    cki("is_ll1_expr", grll_is_ll1(prods, "E"), 1)

    // KAT 2: parse "id + id" -> true
    let t1 = ["id", "+", "id"]
    cki("parse_id_plus_id", grll_parse(prods, "E", t1), 1)

    // KAT 3: parse "id +" -> false (incomplete expression)
    let t2 = ["id", "+"]
    cki("parse_id_plus_incomplete", grll_parse(prods, "E", t2), 0)

    // KAT 4: parse "( id * id )" -> true
    let t3 = ["(", "id", "*", "id", ")"]
    cki("parse_paren_mul", grll_parse(prods, "E", t3), 1)

    // KAT 5: parse "id" alone -> true (single factor)
    let t5 = ["id"]
    cki("parse_single_id", grll_parse(prods, "E", t5), 1)

    // KAT 6: parse "id * id + id" -> true
    let t6 = ["id", "*", "id", "+", "id"]
    cki("parse_mul_plus", grll_parse(prods, "E", t6), 1)

    // KAT 7: parse "()" -> false (no E inside parens)
    let t7 = ["(", ")"]
    cki("parse_empty_parens", grll_parse(prods, "E", t7), 0)

    // KAT 8: empty input -> false (E requires at least F -> id or ( E ))
    let t8 = []
    cki("parse_empty", grll_parse(prods, "E", t8), 0)

    // KAT 9: conflicting grammar — S -> a A | a B; A -> c; B -> d
    // Both alternatives for S start with terminal 'a' => FIRST/FIRST conflict => NOT LL(1)
    let pc1 = ["S", ["a", "A"]]
    let pc2 = ["S", ["a", "B"]]
    let pc3 = ["A", ["c"]]
    let pc4 = ["B", ["d"]]
    let conflict_prods = []
    conflict_prods.push(pc1)
    conflict_prods.push(pc2)
    conflict_prods.push(pc3)
    conflict_prods.push(pc4)
    cki("conflict_not_ll1", grll_is_ll1(conflict_prods, "S"), 0)

    // KAT 10: parse "( id + id ) * id" -> true
    let t10 = ["(", "id", "+", "id", ")", "*", "id"]
    cki("parse_nested", grll_parse(prods, "E", t10), 1)

    print("PASS _grammar_ll1_test")

main()
