// KAT for std/os/dotpath — dotted-path access into nested dicts.
import std/os/dotpath

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _dotpath_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // Build a nested dict via dot_set.
    let d = {}
    dot_set(d, "a.b.c", 5)

    // dot_get deep path
    let v1 = dot_get(d, "a.b.c")
    cki("get_deep", v1, 5)

    // dot_has present path
    if not dot_has(d, "a.b.c")
        print("FAIL _dotpath_test has_present: expected true")
        exit(1)

    // dot_get missing key returns null
    let v2 = dot_get(d, "a.x")
    if v2 != null
        print("FAIL _dotpath_test get_missing: expected null, got " + str(v2))
        exit(1)

    // dot_has missing key returns false
    if dot_has(d, "a.x")
        print("FAIL _dotpath_test has_missing: expected false")
        exit(1)

    // dot_get one-level key
    let d2 = {}
    dot_set(d2, "hello", 42)
    let v3 = dot_get(d2, "hello")
    cki("get_one_level", v3, 42)

    // dot_has one-level key
    if not dot_has(d2, "hello")
        print("FAIL _dotpath_test has_one_level: expected true")
        exit(1)

    // dot_set overwrites existing value
    dot_set(d, "a.b.c", 99)
    let v4 = dot_get(d, "a.b.c")
    cki("get_overwrite", v4, 99)

    // dot_set creates sibling keys
    dot_set(d, "a.b.z", 7)
    let v5 = dot_get(d, "a.b.z")
    cki("get_sibling", v5, 7)

    // dot_get returns null if path goes through missing intermediate
    let v6 = dot_get(d, "x.y.z")
    if v6 != null
        print("FAIL _dotpath_test get_no_root: expected null")
        exit(1)

    print("PASS _dotpath_test")
