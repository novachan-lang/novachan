// demo_forge_chat -- a complete real-time chat app in ONE NOVA file: HTTP serves the page, a WebSocket
// room broadcasts every message to all connected browsers. Run it, open http://localhost:8080 in two
// browser tabs, and type -- each message appears in both tabs instantly. This is NOVA's "channels across
// ALL boundaries": a NOVA channel (the hub) fans messages out to live browser sockets, full-stack, one
// language, ~70 lines. (Serves forever -- run manually; the automated proof is forge_ws_chat_test.)
import forge

// The chat page (HTML + a tiny WebSocket client). NOVA strings interpolate {x}, and JS is full of braces,
// so we build it with chr(123)/chr(125) for { } and chr(34) for " -- the same pattern forge's Swagger page uses.
fn _chat_page() -> string
    let q = chr(34)
    let lb = chr(123)
    let rb = chr(125)
    let h = "<!doctype html><html><head><meta charset=" + q + "utf-8" + q + ">"
    h = h + "<meta name=" + q + "viewport" + q + " content=" + q + "width=device-width,initial-scale=1" + q + ">"
    h = h + "<title>NOVA Forge Chat</title><style>"
    h = h + "body" + lb + "font-family:system-ui,sans-serif;max-width:640px;margin:2rem auto;padding:0 1rem" + rb
    h = h + "#log" + lb + "border:1px solid #ccc;border-radius:8px;height:340px;overflow:auto;padding:10px;margin:10px 0;background:#fafafa" + rb
    h = h + "#log div" + lb + "padding:2px 0" + rb
    h = h + ".sys" + lb + "color:#999;font-style:italic" + rb
    h = h + "input" + lb + "width:75%;padding:8px;border:1px solid #ccc;border-radius:6px" + rb
    h = h + "button" + lb + "padding:8px 16px;border:0;border-radius:6px;background:#3b82f6;color:#fff;cursor:pointer" + rb
    h = h + "</style></head><body>"
    h = h + "<h2>NOVA Forge Chat</h2>"
    h = h + "<p style=" + q + "color:#666" + q + ">Open this page in another tab and chat in real time. Served full-stack by NOVA + Forge.</p>"
    h = h + "<div id=" + q + "log" + q + "></div>"
    h = h + "<input id=" + q + "m" + q + " autocomplete=" + q + "off" + q + " placeholder=" + q + "Type a message and press Enter..." + q + ">"
    h = h + " <button id=" + q + "s" + q + ">Send</button>"
    let js = "<script>"
    js = js + "var proto=location.protocol===" + q + "https:" + q + "?" + q + "wss://" + q + ":" + q + "ws://" + q + ";"
    js = js + "var ws=new WebSocket(proto+location.host+" + q + "/chat" + q + ");"
    js = js + "var log=document.getElementById(" + q + "log" + q + ");"
    js = js + "var m=document.getElementById(" + q + "m" + q + ");"
    js = js + "var s=document.getElementById(" + q + "s" + q + ");"
    js = js + "function add(t,c)" + lb + "var d=document.createElement(" + q + "div" + q + ");if(c)d.className=c;d.textContent=t;log.appendChild(d);log.scrollTop=log.scrollHeight;" + rb
    js = js + "ws.onmessage=function(e)" + lb + "add(e.data);" + rb
    js = js + "ws.onopen=function()" + lb + "add(" + q + "connected" + q + "," + q + "sys" + q + ");" + rb
    js = js + "ws.onclose=function()" + lb + "add(" + q + "disconnected" + q + "," + q + "sys" + q + ");" + rb
    js = js + "function send()" + lb + "if(m.value)" + lb + "ws.send(m.value);m.value=" + q + q + ";" + rb + rb
    js = js + "s.onclick=send;"
    js = js + "m.addEventListener(" + q + "keydown" + q + ",function(e)" + lb + "if(e.key===" + q + "Enter" + q + ")send();" + rb + ");"
    js = js + "</script>"
    h + js + "</body></html>"

// One inbound message -> broadcast it (prefixed) to everyone in the room.
fn _on_msg(ws, msg, hub)
    forge.room_say(hub, "guest: " + bytes_to_str(msg))

fn main()
    let a = forge.app()
    let h = forge.hub()
    forge.get(a, "/", fn(req) forge.resp_html(200, _chat_page()))
    forge.ws_room(a, "/chat", h, fn(ws, msg, hub) _on_msg(ws, msg, hub))
    print("NOVA Forge chat serving on http://localhost:8080")
    print("Open it in two browser tabs and chat in real time.")
    forge.serve_req(a, 8080)
