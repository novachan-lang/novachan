// Bootstrap test 20: string interpolation (f-strings)
// Used ~15 times in the self-hosted compiler for IR emission

let name = "world"
print(f"hello {name}")

let x = 42
print(f"value is {x}")

// Multiple interpolations
let a = 10
let b = 20
print(f"{a} + {b} = {a + b}")

// Nested expressions in f-strings
let items = [1, 2, 3]
print(f"length is {len(items)}")

// f-string with string concatenation
let prefix = "result"
let val = 99
print(f"{prefix}: {val}")

// f-string in a loop (compiler pattern: building IR strings)
let parts = ""
let i = 0
while i < 3
    parts = parts + f"r{i} "
    i = i + 1
print(parts)
