// Forge T8.11: RFC 9457 problem+json error body. problem(status, title, detail) -> a Response with
// the right status, an application/problem+json content-type, and a {type,title,status,detail} body.
// Socketless (build + finalize), deterministic.
import forge
import forge_obs

fn main()
    let r = problem(404, "Not Found", "no such user")
    if r.status != 404
        print("FAIL: status should be 404, got " + str(r.status))
        exit(1)
    let full = finalize(r)
    let q = chr(34)
    if find(full, "application/problem+json") < 0
        print("FAIL: content-type application/problem+json missing")
        exit(1)
    if find(full, q + "title" + q + ":" + q + "Not Found") < 0
        print("FAIL: title field missing from body")
        exit(1)
    if find(full, q + "status" + q + ":404") < 0
        print("FAIL: numeric status field missing from body")
        exit(1)
    if find(full, q + "detail" + q + ":" + q + "no such user") < 0
        print("FAIL: detail field missing from body")
        exit(1)
    print("PASS forge_problem (RFC 9457 problem+json: 404 + content-type + type/title/status/detail body)")
