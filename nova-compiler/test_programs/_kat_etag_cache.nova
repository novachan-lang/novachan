import forge_etag_cache

fn main()
    let e = ec_new()

    e = ec_set(e, "/api/users", "users-list-v1")
    let r1 = ec_get(e, "/api/users")
    e = r1["e"]
    assert(r1["found"] == 1, "found")
    assert(r1["body"] == "users-list-v1", "body match")
    let etag1 = r1["etag"]
    assert(len(etag1) > 0, "has etag")

    let r2 = ec_get(e, "/api/missing")
    e = r2["e"]
    assert(r2["found"] == 0, "missing not found")
    assert(ec_hit_rate(e) == 50, "50% hit rate")

    let cond = ec_check_etag(e, "/api/users", etag1)
    assert(cond["status"] == 304, "304 not modified")

    e = ec_set(e, "/api/users", "users-list-v2")
    let cond2 = ec_check_etag(e, "/api/users", etag1)
    assert(cond2["status"] == 200, "200 modified")
    assert(cond2["body"] == "users-list-v2", "new body")

    let cond3 = ec_check_etag(e, "/api/nope", "any")
    assert(cond3["status"] == 404, "404 for missing")

    e = ec_invalidate(e, "/api/users")
    let r3 = ec_get(e, "/api/users")
    e = r3["e"]
    assert(r3["found"] == 0, "invalidated")

    print("ETAG-CACHE KAT PASS")
