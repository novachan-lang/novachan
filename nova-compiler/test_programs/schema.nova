// ══════════════════════════════════════════════════════════════════════════════
// schema — table schema + DDL + migrations for NOVA (web/data, ORM foundation)
//
// Pairs with qb (which builds row queries): schema defines a table's shape and emits
// the DDL, and schema_diff produces the ALTER statements to migrate an old shape to
// a new one (additive — the safe, portable migration that every SQL engine supports).
// All output is plain SQL strings, fed to sqlitex db_exec.
//
//   t = schema_table("users")
//   t = schema_add(t, "id",   "INTEGER", 1, 0)   // pk
//   t = schema_add(t, "name", "TEXT",    0, 1)   // not null
//   schema_create_sql(t)   // "CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT NOT NULL)"
// ══════════════════════════════════════════════════════════════════════════════

fn schema_table(name: string) -> dict
    {"name": name, "cols": []}

// add a column: pk/notnull are 0/1 flags
fn schema_add(t: dict, name: string, sqltype: string, pk: int, notnull: int) -> dict
    let cols = t["cols"]
    push(cols, {"name": name, "type": sqltype, "pk": pk, "notnull": notnull})
    t["cols"] = cols
    t

fn _coldef(c: dict) -> string
    let s = c["name"] + " " + c["type"]
    if c["pk"] != 0
        s = s + " PRIMARY KEY"
    if c["notnull"] != 0
        s = s + " NOT NULL"
    s

fn schema_create_sql(t: dict) -> string
    let defs = []
    for c in t["cols"]
        push(defs, _coldef(c))
    "CREATE TABLE " + t["name"] + " (" + join(defs, ", ") + ")"

fn schema_create_if_not_exists_sql(t: dict) -> string
    let defs = []
    for c in t["cols"]
        push(defs, _coldef(c))
    "CREATE TABLE IF NOT EXISTS " + t["name"] + " (" + join(defs, ", ") + ")"

fn schema_drop_sql(name: string) -> string
    "DROP TABLE IF EXISTS " + name

fn _has_col(t: dict, name: string) -> int
    for c in t["cols"]
        if c["name"] == name
            return 1
    0

// Additive migration: ALTER TABLE ... ADD COLUMN for every column in `new` not in
// `old`, in `new`'s declared order. (SQLite ADD COLUMN can't carry PRIMARY KEY, so
// only the type + NOT NULL are emitted; a NOT NULL add needs a default, surfaced to
// the caller as a "-- needs default" marker rather than silently producing bad SQL.)
fn schema_diff(old_t: dict, new_t: dict) -> list
    let stmts = []
    for c in new_t["cols"]
        if _has_col(old_t, c["name"]) == 0
            let s = "ALTER TABLE " + new_t["name"] + " ADD COLUMN " + c["name"] + " " + c["type"]
            if c["notnull"] != 0
                s = s + " NOT NULL -- needs default"
            push(stmts, s)
    stmts
