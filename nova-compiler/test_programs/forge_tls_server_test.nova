// Live TLS 1.3 server vs openssl s_client: full handshake + encrypted application data (read the client's
// request, send an HTTP response back encrypted).
import forge_tls_server
import forge_crypto

fn main()
    let crlf = chr(13) + chr(10)
    let response = str_to_blist("HTTP/1.0 200 OK" + crlf + "Content-Type: text/plain" + crlf + crlf + "NOVA-TLS-SERVER-OK" + crlf)
    let r = tls13_serve_once(44331, response)
    if r != 1
        print("SERVER-FAIL")
        exit(1)
    print("SERVER-HANDSHAKE-OK")
