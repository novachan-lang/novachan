// Live TLS 1.3 server vs openssl s_client: listen, accept, complete the handshake (ServerHello +
// encrypted flight with an Ed25519 cert + CertificateVerify + Finished), verify the client Finished.
import forge_tls_server

fn main()
    let r = tls13_server_accept_once(44331)
    if r[0] != 1
        print("SERVER-FAIL")
        exit(1)
    print("SERVER-HANDSHAKE-OK")
