// floatlist optimization: homogeneous literal float lists read as typed floats
// (fadd/fcmp/float_to_str) with boxed storage (safe everywhere).

let v = [1.5, 2.5, 3.5, 4.5]

// typed element reads
assert(v[0] == 1.5, "elem 0")
assert(v[3] == 4.5, "elem 3")
assert(v[0] + v[1] == 4.0, "elem add")
assert(v[3] - v[0] == 3.0, "elem sub")
assert(v[1] * v[2] == 8.75, "elem mul")
assert(v[3] / v[1] == 1.8, "elem div")

// comparison
assert(v[0] < v[1], "elem lt")
assert(v[3] > v[2], "elem gt")
assert(v[1] <= 2.5, "elem le")
assert(v[2] >= 3.5, "elem ge")

// iteration + accumulation (typed float, no boxing in the loop)
let total = 0.0
for x in v
    total = total + x
assert(total == 12.0, "iterate sum")

let prod = 1.0
for x in v
    prod = prod * x
assert(prod == 59.0625, "iterate product")

// str of a typed element
assert(str(v[2]) == "3.5", "elem str")

// negative index
assert(v[-1] == 4.5, "neg index")

// element into another list (boxed correctly)
let w = []
push(w, v[0])
push(w, v[1])
assert(str(w[0]) == "1.5", "restore 0")
assert(w[0] + w[1] == 4.0, "restore add")

// pushing a float to a floatlist literal keeps it a float list
let g = [10.0, 20.0]
push(g, 30.0)
assert(g[2] == 30.0, "appended float elem")
assert(g[0] + g[2] == 40.0, "appended float arith")

// max/min/sum aggregates over a float list
assert(sum(v) == 12.0, "sum aggregate")

print("all floatlist tests passed")
