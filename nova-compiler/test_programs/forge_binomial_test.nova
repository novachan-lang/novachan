import forge_binomial

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn nearp(name: string, a: float, b: float) -> int
    let d = a - b
    if d > -0.0005 and d < 0.0005
        return 0
    print("FAIL " + name + ": got=" + str(a) + " want~=" + str(b))
    1

fn main()
    let fails = 0

    // binomial pmf known values
    fails = fails + nearp("b_10_5_.5", binom_pmf(10, 5, 0.5), 0.24609)
    fails = fails + nearp("b_10_0_.5", binom_pmf(10, 0, 0.5), 0.00098)
    fails = fails + nearp("b_10_10_.5", binom_pmf(10, 10, 0.5), 0.00098)
    fails = fails + nearp("b_5_2_.3", binom_pmf(5, 2, 0.3), 0.30870)
    // out of range
    fails = fails + nearp("b_oor", binom_pmf(5, 6, 0.5), 0.0)

    // binomial cdf
    fails = fails + nearp("bcdf_10_5", binom_cdf(10, 5, 0.5), 0.62305)
    fails = fails + nearp("bcdf_all", binom_cdf(10, 10, 0.5), 1.0)

    // mean/variance
    fails = fails + nearp("bmean", binom_mean(10, 0.5), 5.0)
    fails = fails + nearp("bvar", binom_variance(10, 0.5), 2.5)
    fails = fails + nearp("bmean2", binom_mean(20, 0.3), 6.0)

    // pmf sums to 1 over all k
    let s = 0.0
    let k = 0
    while k <= 10
        s = s + binom_pmf(10, k, 0.3)
        k = k + 1
    fails = fails + nearp("b_sums1", s, 1.0)

    // Poisson known values (lambda=2)
    fails = fails + nearp("p_0_2", poisson_pmf(0, 2.0), 0.13534)
    fails = fails + nearp("p_1_2", poisson_pmf(1, 2.0), 0.27067)
    fails = fails + nearp("p_2_2", poisson_pmf(2, 2.0), 0.27067)
    fails = fails + nearp("p_3_2", poisson_pmf(3, 2.0), 0.18045)

    // poisson cdf
    fails = fails + nearp("pcdf_2_2", poisson_cdf(2, 2.0), 0.67668)

    // poisson sums to ~1 over enough k
    let ps = 0.0
    let j = 0
    while j <= 20
        ps = ps + poisson_pmf(j, 2.0)
        j = j + 1
    fails = fails + nearp("p_sums1", ps, 1.0)

    if fails == 0
        print("forge_binomial: all passed")
    else
        print("forge_binomial: " + str(fails) + " FAILED")
