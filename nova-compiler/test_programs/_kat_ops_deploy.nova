import forge_ops_deploy

fn main()
    let d = deploy_service("api", "myapp:v1.2", 8080)
    assert(d["name"] == "api", "name")
    assert(d["replicas"] == 1, "default replicas 1")

    d = deploy_replicas(d, 3)
    assert(d["replicas"] == 3, "replicas 3")

    d = deploy_env(d, "DB_URL", "postgres://db:5432")
    d = deploy_env(d, "LOG_LEVEL", "info")
    assert(len(keys(d["env"])) == 2, "2 env vars")

    d = deploy_health_check(d, "/health", 10)
    assert(d["health_check"]["path"] == "/health", "health path")

    d = deploy_resource_limits(d, 500, 256)
    assert(d["resources"]["cpu_millicores"] == 500, "cpu 500m")

    d = deploy_rolling_update(d, 2, 1)
    assert(d["max_surge"] == 2, "max_surge 2")

    // k8s manifest
    let k = deploy_to_k8s(d)
    assert(k["apiVersion"] == "apps/v1", "k8s apiVersion")
    assert(k["kind"] == "Deployment", "k8s kind")
    assert(k["metadata"]["name"] == "api", "k8s metadata name")
    assert(k["spec"]["replicas"] == 3, "k8s replicas 3")
    let containers = k["spec"]["template"]["spec"]["containers"]
    assert(len(containers) == 1, "1 container")
    assert(containers[0]["image"] == "myapp:v1.2", "k8s image")

    // compose
    let comp = deploy_to_compose(d)
    assert(comp["image"] == "myapp:v1.2", "compose image")
    assert(comp["deploy"]["replicas"] == 3, "compose replicas")

    // canary
    d = deploy_canary(d, 10)
    assert(d["canary_weight"] == 10, "canary 10%")

    // describe
    let desc = deploy_describe(d)
    assert(contains(desc, "api"), "describe has name")
    assert(contains(desc, "myapp:v1.2"), "describe has image")
    assert(contains(desc, "3"), "describe has replicas")
    assert(contains(desc, "Canary"), "describe has canary")

    print("FORGE-OPS-DEPLOY KAT PASS")
