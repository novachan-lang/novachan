import forge_subarray

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // min subarray sum
    fails = fails + expect("min1", str(min_subarray_sum([1, 0 - 2, 3, 0 - 2])), "-2")
    fails = fails + expect("min2", str(min_subarray_sum([3, 0 - 1, 0 - 4, 1])), "-5")
    fails = fails + expect("min_allpos", str(min_subarray_sum([1, 2, 3])), "1")
    fails = fails + expect("min_single", str(min_subarray_sum([7])), "7")

    // max circular subarray
    fails = fails + expect("circ1", str(max_circular_subarray([1, 0 - 2, 3, 0 - 2])), "3")
    fails = fails + expect("circ_wrap", str(max_circular_subarray([5, 0 - 3, 5])), "10")
    fails = fails + expect("circ_allneg", str(max_circular_subarray([0 - 3, 0 - 2, 0 - 3])), "-2")
    fails = fails + expect("circ_full", str(max_circular_subarray([3, 0 - 1, 2, 0 - 1])), "4")
    fails = fails + expect("circ_wrap2", str(max_circular_subarray([8, 0 - 1, 3, 4])), "15")
    fails = fails + expect("circ_single", str(max_circular_subarray([5])), "5")
    // classic: [1,-2,3,-2] non-wrap 3; [-2,-3,-1] all neg -> -1
    fails = fails + expect("circ_allneg2", str(max_circular_subarray([0 - 2, 0 - 3, 0 - 1])), "-1")

    if fails == 0
        print("forge_subarray_ext: all passed")
    else
        print("forge_subarray_ext: " + str(fails) + " FAILED")
