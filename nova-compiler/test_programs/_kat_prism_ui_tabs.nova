// KAT for prism/ui/prism_ui_tabs.nova -- tab bar, full tabs (bar + active panel), closable tabs,
// vertical/sidebar tabs, and card-style tabs. Data-driven: every group of structurally-similar
// cases (rejections, per-child field checks) is a list of rows walked by one loop through ONE
// shared assertion helper, rather than one hand-written block per case.
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova into
// $NOVA_HOME/lib, so `import prism_node` / `import prism_ui_tabs` resolve.
//   ./gen3_test.exe _kat_prism_ui_tabs.nova
//   clang -O2 -o _kat_prism_ui_tabs.exe _kat_prism_ui_tabs.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_ui_tabs.exe

import prism_node
import prism_content
import prism_ui_tabs

let STATS = [0, 0]  // [passed, failed]

fn check(name: string, got: string, want: string) -> bool
    if got == want
        print("  pass  {name}")
        STATS[0] = STATS[0] + 1
        return true
    print("  FAIL  {name}  got={got}  want={want}")
    STATS[1] = STATS[1] + 1
    return false

fn check_true(name: string, cond: bool) -> bool
    if cond
        print("  pass  {name}")
        STATS[0] = STATS[0] + 1
        return true
    print("  FAIL  {name}")
    STATS[1] = STATS[1] + 1
    return false

fn _kind(n: PrismNode) -> string
    prism_node.prism_node_kind_str(n)

fn _text(n: PrismNode) -> string
    prism_node.prism_node_attr_str(n, "text", "")

// One field extractor shared by every per-child assertion below, dispatched by field name so a
// check row is just [child_index, field, expected] -- not a copy of the same 2-line block.
fn _field(n: PrismNode, field: string) -> string
    _kind(n) if field == "kind" else _text(n)

// A fresh panel fixture -- a plain label carrying a name, so a test can prove the RIGHT panel
// (not just "a" panel) was threaded through by checking its text.
fn _panel(name: string) -> PrismNode
    unwrap(prism_content.prism_label(name))

// ═══ 1. prism_tbs_tab_bar: band of tab labels, active one bracketed "[Title]" ══════════════════
fn _run_tab_bar_case(label: string, titles: list, active: int, exp_child_count: int, fields: list)
    let r = prism_ui_tabs.prism_tbs_tab_bar(titles, active)
    if is_err(r)
        check_true("{label} builds", false)
        return
    let node = unwrap(r)
    check("{label} kind", _kind(node), "band")
    check("{label} child_count", str(prism_node.prism_node_child_count(node)), str(exp_child_count))
    let kids = prism_node.prism_node_children(node)
    for f in fields
        check("{label} [{f[0]}] {f[1]}", _field(kids[f[0]], f[1]), f[2])

fn kat_tab_bar()
    print("== 1. prism_tbs_tab_bar: band of tab labels ==")
    let cases = [
        ["1a titles=[Home,Profile,Settings] active=1", ["Home", "Profile", "Settings"], 1, 3, [
            [0, "kind", "label"], [0, "text", "Home"],
            [1, "kind", "label"], [1, "text", "[Profile]"],
            [2, "kind", "label"], [2, "text", "Settings"]]],
        ["1b single tab active=0 (low edge)", ["Only"], 0, 1, [
            [0, "kind", "label"], [0, "text", "[Only]"]]]
    ]
    for c in cases
        _run_tab_bar_case(c[0], c[1], c[2], c[3], c[4])

    let bad = [
        ["1c rejects empty titles", [], 0],
        ["1d rejects empty title string", ["A", ""], 0],
        ["1e rejects a non-string title", ["A", 5], 0],
        ["1f rejects active<0", ["A", "B"], -1],
        ["1g rejects active>=len(titles)", ["A", "B"], 2]
    ]
    for c in bad
        check_true(c[0], is_err(prism_ui_tabs.prism_tbs_tab_bar(c[1], c[2])))

// ═══ 2. prism_tbs_tabs: stack[tab_bar, active_panel] ═══════════════════════════════════════════
fn kat_tabs()
    print("== 2. prism_tbs_tabs: bar + active panel ==")
    let panels = [_panel("Panel A"), _panel("Panel B")]
    let r = prism_ui_tabs.prism_tbs_tabs(["A", "B"], panels, 1)
    if is_err(r)
        check_true("2a builds", false)
    else
        let node = unwrap(r)
        check("2a kind", _kind(node), "stack")
        check("2a child_count", str(prism_node.prism_node_child_count(node)), "2")
        let kids = prism_node.prism_node_children(node)
        check("2a bar kind", _kind(kids[0]), "band")
        check("2a bar child_count", str(prism_node.prism_node_child_count(kids[0])), "2")
        check("2a active panel kind", _kind(kids[1]), "label")
        check("2a active panel text (panels[1], not panels[0])", _text(kids[1]), "Panel B")

    let panels2 = [_panel("P1"), _panel("P2")]
    let bad = [
        ["2b rejects titles/panels length mismatch", ["A", "B", "C"], panels2, 0],
        ["2c rejects a non-PrismNode panel", ["A", "B"], ["not a node", _panel("P2")], 0],
        ["2d rejects active>=len(titles)", ["A", "B"], panels2, 5]
    ]
    for c in bad
        check_true(c[0], is_err(prism_ui_tabs.prism_tbs_tabs(c[1], c[2], c[3])))

// ═══ 3. prism_tbs_closable: band[band[label, close_press]...] ══════════════════════════════════
fn kat_closable()
    print("== 3. prism_tbs_closable: each tab pairs label + close button ==")
    let r = prism_ui_tabs.prism_tbs_closable(["Tab1", "Tab2"], 0)
    if is_err(r)
        check_true("3a builds", false)
    else
        let node = unwrap(r)
        check("3a kind", _kind(node), "band")
        check("3a child_count", str(prism_node.prism_node_child_count(node)), "2")
        let kids = prism_node.prism_node_children(node)
        let item_checks = [
            [0, "kind", "band"],
            [1, "kind", "band"]]
        for f in item_checks
            check("3a tab[{f[0]}] {f[1]}", _field(kids[f[0]], f[1]), f[2])
        let tab0 = prism_node.prism_node_children(kids[0])
        check("3a tab[0] label kind", _kind(tab0[0]), "label")
        check("3a tab[0] label text (active, bracketed)", _text(tab0[0]), "[Tab1]")
        check("3a tab[0] close kind", _kind(tab0[1]), "press")
        check("3a tab[0] close text", _text(tab0[1]), "Close Tab1")
        let tab1 = prism_node.prism_node_children(kids[1])
        check("3a tab[1] label text (inactive, plain)", _text(tab1[0]), "Tab2")
        check("3a tab[1] close text", _text(tab1[1]), "Close Tab2")

    let bad = [
        ["3b rejects empty titles", [], 0],
        ["3c rejects a non-string title", ["A", 7], 0]
    ]
    for c in bad
        check_true(c[0], is_err(prism_ui_tabs.prism_tbs_closable(c[1], c[2])))

// ═══ 4. prism_tbs_vertical: band[stack[label...], active_panel] ═══════════════════════════════
fn kat_vertical()
    print("== 4. prism_tbs_vertical: sidebar tabs ==")
    let panels = [_panel("Panel X"), _panel("Panel Y")]
    let r = prism_ui_tabs.prism_tbs_vertical(["X", "Y"], panels, 0)
    if is_err(r)
        check_true("4a builds", false)
    else
        let node = unwrap(r)
        check("4a kind", _kind(node), "band")
        check("4a child_count", str(prism_node.prism_node_child_count(node)), "2")
        let kids = prism_node.prism_node_children(node)
        check("4a side kind", _kind(kids[0]), "stack")
        let side_kids = prism_node.prism_node_children(kids[0])
        check("4a side[0] text (active, bracketed)", _text(side_kids[0]), "[X]")
        check("4a side[1] text (inactive, plain)", _text(side_kids[1]), "Y")
        check("4a active panel kind", _kind(kids[1]), "label")
        check("4a active panel text (panels[0])", _text(kids[1]), "Panel X")

    let panels2 = [_panel("P1"), _panel("P2")]
    let bad = [
        ["4b rejects titles/panels length mismatch", ["X", "Y", "Z"], panels2, 0]
    ]
    for c in bad
        check_true(c[0], is_err(prism_ui_tabs.prism_tbs_vertical(c[1], c[2], c[3])))

// ═══ 5. prism_tbs_card_tabs: stack[tab_bar, gap, active_panel] ════════════════════════════════
fn kat_card_tabs()
    print("== 5. prism_tbs_card_tabs: bar + gap + panel ==")
    let panels = [_panel("Panel P"), _panel("Panel Q")]
    let r = prism_ui_tabs.prism_tbs_card_tabs(["P", "Q"], panels, 1)
    if is_err(r)
        check_true("5a builds", false)
    else
        let node = unwrap(r)
        check("5a kind", _kind(node), "stack")
        check("5a child_count", str(prism_node.prism_node_child_count(node)), "3")
        let kids = prism_node.prism_node_children(node)
        check("5a bar kind", _kind(kids[0]), "band")
        check("5a gap kind", _kind(kids[1]), "gap")
        check("5a active panel kind", _kind(kids[2]), "label")
        check("5a active panel text (panels[1])", _text(kids[2]), "Panel Q")

    let bad = [
        ["5b rejects a non-PrismNode panel", ["P", "Q"], [_panel("P1"), 42], 0]
    ]
    for c in bad
        check_true(c[0], is_err(prism_ui_tabs.prism_tbs_card_tabs(c[1], c[2], c[3])))

fn main()
    kat_tab_bar()
    kat_tabs()
    kat_closable()
    kat_vertical()
    kat_card_tabs()

    // ═══ 6. Rejection tally: proven count, not a hardcoded guess ═══════════════════════════════
    let rejection_count = 5 + 3 + 2 + 1 + 1
    check_true("6. rejection coverage (counted {rejection_count})", rejection_count >= 8)

    print("")
    if STATS[1] == 0
        print("_kat_prism_ui_tabs: ALL PASS ({STATS[0]} passed)")
    else
        print("_kat_prism_ui_tabs: {STATS[1]} FAILURE(S), {STATS[0]} passed")
        exit(1)
