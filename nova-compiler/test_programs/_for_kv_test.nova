fn main()
    let d = {"name": "NOVA", "version": "1.0", "lang": "all"}
    let keys = []
    let vals = []
    for k, v in d
        push(keys, k)
        push(vals, v)
    assert(contains(keys, "name"), "dict key missing")
    assert(contains(keys, "version"), "dict key missing")
    assert(contains(keys, "lang"), "dict key missing")
    assert(contains(vals, "NOVA"), "dict val missing")
    assert(contains(vals, "1.0"), "dict val missing")
    assert(contains(vals, "all"), "dict val missing")
    print("for k,v in dict (no parens): PASS")

    let items = ["a", "b", "c"]
    let indices = []
    let values = []
    for i, val in items
        push(indices, i)
        push(values, val)
    assert_eq(indices, [0, 1, 2])
    assert_eq(values, ["a", "b", "c"])
    print("for i,val in list (enumerate): PASS")

    let d2 = {"x": 10, "y": 20}
    let sum = 0
    for k, v in d2
        sum = sum + v
    assert_eq(sum, 30)
    print("for k,v in dict sum: PASS")

    for k, v in {}
        assert(false, "should not enter empty dict loop")
    print("for k,v in empty dict: PASS")

    for i, v in []
        assert(false, "should not enter empty list loop")
    print("for i,v in empty list: PASS")

    let nums = [10, 20, 30]
    let wsum = 0
    for idx, n in nums
        wsum = wsum + idx * n
    assert_eq(wsum, 0 * 10 + 1 * 20 + 2 * 30)
    print("for idx,n weighted sum: PASS")

    let old_keys = []
    for (k, v) in d
        push(old_keys, k)
    assert(contains(old_keys, "name"), "old-style dict still works")
    print("for (k,v) in dict (parens): PASS")

    let old_idx = []
    let old_vals = []
    for (i, x) in enumerate([100, 200])
        push(old_idx, i)
        push(old_vals, x)
    assert_eq(old_idx, [0, 1])
    assert_eq(old_vals, [100, 200])
    print("old enumerate style: PASS")

    print("ALL FOR-KV TESTS PASSED")
