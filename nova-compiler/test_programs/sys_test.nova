fn run()
    // Test args()
    let a = args()
    print("arg count: {len(a)}")
    print("program: {a[0]}")

    // Test env()
    let path = env("PATH")
    assert(len(path) > 0, "PATH should not be empty")
    print("PATH length: {len(path)}")

    // Test random_int()
    let r = random_int(1, 100)
    assert(r >= 1 and r <= 100, "random out of range")
    print("random(1,100) = {r}")

    // Test shell()
    let out = shell("echo hello")
    assert(out == "hello", "shell failed: got '{out}'")
    print("shell echo: {out}")

    print("SYSTEM: ALL PASSED")

run()
