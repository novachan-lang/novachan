import forge_onehot

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn join_ints(lst) -> string
    let parts = []
    let i = 0
    while i < len(lst)
        push(parts, str(lst[i]))
        i = i + 1
    join(parts, ",")

fn main()
    let fails = 0

    // fit vocabulary (first-seen order): red=0, green=1, blue=2
    let vocab = onehot_fit(["red", "green", "blue", "red", "green"])
    fails = fails + expect("size", str(onehot_size(vocab)), "3")
    fails = fails + expect("categories", join(onehot_categories(vocab), ","), "red,green,blue")

    // label encode
    fails = fails + expect("label_red", str(label_encode(vocab, "red")), "0")
    fails = fails + expect("label_blue", str(label_encode(vocab, "blue")), "2")
    fails = fails + expect("label_unknown", str(label_encode(vocab, "purple")), "-1")

    // one-hot vectors
    fails = fails + expect("vec_red", join_ints(onehot_vector(vocab, "red")), "1,0,0")
    fails = fails + expect("vec_green", join_ints(onehot_vector(vocab, "green")), "0,1,0")
    fails = fails + expect("vec_blue", join_ints(onehot_vector(vocab, "blue")), "0,0,1")
    // unknown -> all zeros
    fails = fails + expect("vec_unknown", join_ints(onehot_vector(vocab, "purple")), "0,0,0")

    // encode a list
    let enc = onehot_encode(vocab, ["blue", "red"])
    fails = fails + expect("enc0", join_ints(enc[0]), "0,0,1")
    fails = fails + expect("enc1", join_ints(enc[1]), "1,0,0")

    // decode
    fails = fails + expect("decode_green", onehot_decode(vocab, [0, 1, 0]), "green")
    fails = fails + expect("decode_red", onehot_decode(vocab, [1, 0, 0]), "red")
    fails = fails + expect("decode_none", onehot_decode(vocab, [0, 0, 0]), "")

    // integer categories work too
    let v2 = onehot_fit([10, 20, 30])
    fails = fails + expect("int_label", str(label_encode(v2, 20)), "1")
    fails = fails + expect("int_vec", join_ints(onehot_vector(v2, 30)), "0,0,1")

    if fails == 0
        print("forge_onehot: all passed")
    else
        print("forge_onehot: " + str(fails) + " FAILED")
