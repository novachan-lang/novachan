// KAT for std/physics/kinematics — SUVAT equations.
import std/physics/kinematics

// approx — float equality within 0.0001 tolerance.
fn approx(a, b)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < 0.0001

fn ckf(label, got, want)
    if not approx(got, want)
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // final_velocity: v = u + a*t
    // u=0, a=9.81, t=2 -> v=19.62
    ckf("final_velocity(0,9.81,2)", final_velocity(0.0, 9.81, 2.0), 19.62)
    // u=5, a=2, t=3 -> v=11
    ckf("final_velocity(5,2,3)", final_velocity(5.0, 2.0, 3.0), 11.0)
    // u=10, a=0, t=5 -> v=10 (constant velocity)
    ckf("final_velocity(10,0,5)", final_velocity(10.0, 0.0, 5.0), 10.0)

    // displacement: s = u*t + 0.5*a*t^2
    // u=0, a=9.81, t=2 -> s=19.62
    ckf("displacement(0,9.81,2)", displacement(0.0, 9.81, 2.0), 19.62)
    // u=5, a=2, t=3 -> s=5*3 + 0.5*2*9 = 15+9 = 24
    ckf("displacement(5,2,3)", displacement(5.0, 2.0, 3.0), 24.0)
    // u=0, a=0, t=10 -> s=0
    ckf("displacement(0,0,10)", displacement(0.0, 0.0, 10.0), 0.0)

    // v_squared: v^2 = u^2 + 2*a*s
    // u=0, a=2, s=10 -> v^2=40
    ckf("v_squared(0,2,10)", v_squared(0.0, 2.0, 10.0), 40.0)
    // u=3, a=4, s=5 -> v^2=9+40=49
    ckf("v_squared(3,4,5)", v_squared(3.0, 4.0, 5.0), 49.0)

    // time_to_reach: t = (v - u) / a
    // u=0, v=20, a=10 -> t=2
    ckf("time_to_reach(0,20,10)", time_to_reach(0.0, 20.0, 10.0), 2.0)
    // u=5, v=35, a=6 -> t=5
    ckf("time_to_reach(5,35,6)", time_to_reach(5.0, 35.0, 6.0), 5.0)

    print("PASS _kinematics_test")
