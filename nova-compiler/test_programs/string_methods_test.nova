s = "hello world"
print(s.len())

print(s.contains("world"))
print(s.contains("xyz"))

sub = s.slice(0, 5)
print(sub)

up = s.upper()
print(up)

lo = "NOVA LANG".lower()
print(lo)

trimmed = "  spaces  ".trim()
print(trimmed)

replaced = "foo bar foo".replace("foo", "baz")
print(replaced)

parts = "a,b,c,d".split(",")
print(parts[0])
print(parts[2])
