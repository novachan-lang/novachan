// Phase 13 Web: JSON encoding, URL routing, HTTP server stub

fn test_json_encode_decode()
    // Encode integer
    let s1 = json_encode(42)
    assert_eq(s1, "42")
    // Decode back
    let v1 = json_decode("42")
    assert_eq(v1, 42)
    // Decode a string
    let v2 = json_decode("\"hello\"")
    assert_eq(v2, "hello")
    print("JSON encode/decode test passed")

fn test_route_match()
    // Exact match with named param
    let params = route_match("/users/:id", "/users/42")
    let id = params["id"]
    assert_eq(id, "42")
    // Two params
    let params2 = route_match("/users/:uid/posts/:pid", "/users/7/posts/99")
    assert_eq(params2["uid"], "7")
    assert_eq(params2["pid"], "99")
    // No match returns empty dict
    let params3 = route_match("/users/:id", "/posts/42")
    let count = len(params3)
    assert_eq(count, 0)
    print("Route match test passed")

fn test_http_server()
    // Use an ephemeral port; just test listen+close
    let srv = http_listen(18099)
    assert_eq(srv >= 0, true)
    let closed = http_close(srv)
    assert_eq(closed, 0)
    print("HTTP listen/close test passed")

fn main()
    test_json_encode_decode()
    test_route_match()
    test_http_server()
    print("All Phase 13 Web tests passed!")
