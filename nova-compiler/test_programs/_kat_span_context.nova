import forge_span_context

fn main()
    let root = span_new("trace-001", "http-handler")
    assert(span_is_root(root) == 1, "root span")
    assert(root["trace_id"] == "trace-001", "trace id")

    root = span_start(root, 1000)
    assert(root["status"] == "active", "active after start")

    root = span_add_event(root, "request-received", 1001)
    root = span_add_event(root, "auth-complete", 1005)
    assert(span_event_count(root) == 2, "2 events")

    root = span_set_attr(root, "http.method", "GET")
    root = span_set_attr(root, "http.path", "/api/users")
    assert(root["attributes"]["http.method"] == "GET", "method attr")

    let child = span_child(root, "db-query")
    assert(span_is_root(child) == 0, "child not root")
    assert(child["parent_id"] == "http-handler", "parent link")
    assert(child["trace_id"] == "trace-001", "same trace")
    assert(span_child_count(root) == 1, "1 child")

    child = span_start(child, 1010)
    child = span_end(child, 1050)
    assert(span_duration(child) == 40, "40ms duration")

    root = span_end(root, 1100)
    assert(span_duration(root) == 100, "100ms total")
    assert(root["status"] == "ended", "ended status")

    let err_span = span_new("trace-002", "failing-op")
    err_span = span_start(err_span, 2000)
    err_span = span_set_error(err_span, "timeout")
    assert(err_span["status"] == "error", "error status")
    assert(err_span["attributes"]["error"] == "timeout", "error msg")

    let header = span_trace_header(root)
    assert(header == "trace-001-http-handler", "trace header")

    assert(span_duration(span_new("x", "y")) == 0, "unfinished = 0 duration")

    print("SPAN-CONTEXT KAT PASS")
