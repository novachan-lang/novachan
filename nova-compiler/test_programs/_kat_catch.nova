// KAT: `EXPR catch e => handler` (inline concise form) and `EXPR catch e\n  handler` (multi-line)
// must both parse + run. Regression for the dogfood parser gap: the inline `=>` form failed with
// "unexpected FAT_ARROW '=>' in expression" (the parser never consumed the `=>` before the handler).
// Fix: consume the optional FAT_ARROW in the inline catch path. read_file() on a missing file sets
// the ambient error -> catch binds it -> the handler value is returned.

fn safe_inline(path: string) -> string
    let r = read_file(path) catch e => "MISSING_INLINE"
    return r

fn safe_multiline(path: string) -> string
    let r = read_file(path) catch e
        "MISSING_MULTI"
    return r

fn safe_return_inline(path: string) -> string
    return read_file(path) catch e => "MISSING_RET"

fn main() -> int
    assert(safe_inline("nope_zzz_9137.txt") == "MISSING_INLINE", "inline => catch")
    assert(safe_multiline("nope_zzz_9137.txt") == "MISSING_MULTI", "multi-line catch")
    assert(safe_return_inline("nope_zzz_9137.txt") == "MISSING_RET", "return + inline => catch")
    print("PASS _kat_catch")
    return 0

main()
