// iter-77: proves @link_source -- the general FFI auto-link. `nova run`/`nova build`
// compiles + links a LOCAL C source on demand. foo.c defines foo_add(long long, long long);
// nova_link sees the `; LINK_SOURCE: foo.c` marker this annotation emits, compiles foo.c
// into a cached foo.c.o (rebuilt only when foo.c is newer), and links it automatically --
// no manual clang, no regression special-path. This generalizes the iter-75 one-off
// SQLite auto-link into "link ANY local C library with one annotation".
@link_source("foo.c")
extern fn foo_add(a: int, b: int) -> int

fn main()
    let r = unsafe foo_add(40, 2)
    assert_eq(r, 42)
    // A second nesting to exercise the linked object more than once on the same build.
    assert_eq(unsafe foo_add(unsafe foo_add(10, 10), unsafe foo_add(1, 1)), 22)
    print("ffi_linksrc_test passed: @link_source compiled+linked foo.c, foo_add(40,2)=" + str(r))
