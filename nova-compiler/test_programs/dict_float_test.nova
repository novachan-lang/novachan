// FINDING #1 nested: a float stored as a DICT VALUE must serialize correctly and
// read back as a float. (The common "build a response object" JSON case.)
fn main()
    let d = {}
    d["x"] = 2.5
    d["n"] = 7
    // json: float value rendered correctly, int value too. ('{' escaped for NOVA interpolation.)
    assert_eq(json_encode(d), "\{\"x\":2.5,\"n\":7\}")
    // read-back must unbox the float for computation
    assert_near(d["x"], 2.5, 0.001)
    assert_eq(d["n"], 7)
    print("dict float value test passed")
