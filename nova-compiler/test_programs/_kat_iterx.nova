import std/core/iterx

fn main() -> int
    let fails = 0

    // take_while — stops at the first element failing pred
    let tw = take_while([1, 2, 3, 4, 1], fn(x) x < 3)
    if tw != [1, 2]
        print("FAIL take_while=" + str(tw))
        fails = fails + 1

    // drop_while — the complementary tail of the same split point
    let dw = drop_while([1, 2, 3, 4, 1], fn(x) x < 3)
    if dw != [3, 4, 1]
        print("FAIL drop_while=" + str(dw))
        fails = fails + 1

    // take_while / drop_while on an all-true predicate (no split point -> None)
    if take_while([1, 2, 3], fn(x) x < 99) != [1, 2, 3]
        print("FAIL take_while all-true")
        fails = fails + 1
    if drop_while([1, 2, 3], fn(x) x < 99) != []
        print("FAIL drop_while all-true")
        fails = fails + 1

    // find_first — hit and miss
    match find_first([1, 2, 3, 4], fn(x) x > 2)
        Some(v) =>
            if v != 3
                print("FAIL find_first hit v=" + str(v))
                fails = fails + 1
        None =>
            print("FAIL find_first hit should be Some")
            fails = fails + 1
    match find_first([1, 2, 3, 4], fn(x) x > 99)
        Some(v) =>
            print("FAIL find_first miss should be None")
            fails = fails + 1
        None =>
            print("ok: find_first miss -> None")

    // position — hit and miss
    match position([10, 20, 30], fn(x) x == 20)
        Some(i) =>
            if i != 1
                print("FAIL position hit i=" + str(i))
                fails = fails + 1
        None =>
            print("FAIL position hit should be Some")
            fails = fails + 1
    match position([10, 20, 30], fn(x) x == 99)
        Some(i) =>
            print("FAIL position miss should be None")
            fails = fails + 1
        None =>
            print("ok: position miss -> None")

    // count_by / all_by / any_by
    if count_by([1, 2, 3, 4, 5, 6], fn(x) x % 2 == 0) != 3
        print("FAIL count_by")
        fails = fails + 1
    if not all_by([2, 4, 6], fn(x) x % 2 == 0)
        print("FAIL all_by (should be true)")
        fails = fails + 1
    if all_by([2, 4, 5], fn(x) x % 2 == 0)
        print("FAIL all_by (should be false)")
        fails = fails + 1
    if not any_by([1, 3, 4], fn(x) x % 2 == 0)
        print("FAIL any_by (should be true)")
        fails = fails + 1
    if any_by([1, 3, 5], fn(x) x % 2 == 0)
        print("FAIL any_by (should be false)")
        fails = fails + 1

    // replicate
    let rep = replicate("x", 3)
    if rep != ["x", "x", "x"]
        print("FAIL replicate=" + str(rep))
        fails = fails + 1
    if replicate("x", 0) != []
        print("FAIL replicate n=0 should be []")
        fails = fails + 1
    if replicate("x", -2) != []
        print("FAIL replicate n<0 should be []")
        fails = fails + 1

    // range_step — ascending, descending, and degenerate cases
    let rs = range_step(0, 10, 3)
    if rs != [0, 3, 6, 9]
        print("FAIL range_step asc=" + str(rs))
        fails = fails + 1
    let rsd = range_step(10, 0, -3)
    if rsd != [10, 7, 4, 1]
        print("FAIL range_step desc=" + str(rsd))
        fails = fails + 1
    if range_step(0, 10, 0) != []
        print("FAIL range_step step=0 should be []")
        fails = fails + 1
    if range_step(10, 0, 3) != []
        print("FAIL range_step wrong-direction should be []")
        fails = fails + 1

    // zip3
    let z3 = zip3([1, 2, 3], ["a", "b", "c"], [true, false, true])
    if z3 != [[1, "a", true], [2, "b", false], [3, "c", true]]
        print("FAIL zip3=" + str(z3))
        fails = fails + 1
    let z3short = zip3([1, 2, 3, 4], [10, 20], [100, 200, 300])
    if len(z3short) != 2
        print("FAIL zip3 truncation len=" + str(len(z3short)))
        fails = fails + 1

    // pairwise
    let pw = pairwise([1, 2, 3])
    if pw != [[1, 2], [2, 3]]
        print("FAIL pairwise=" + str(pw))
        fails = fails + 1
    if pairwise([1]) != []
        print("FAIL pairwise singleton should be []")
        fails = fails + 1
    if pairwise([]) != []
        print("FAIL pairwise empty should be []")
        fails = fails + 1

    // intersperse
    let iv = intersperse([1, 2, 3], 0)
    if iv != [1, 0, 2, 0, 3]
        print("FAIL intersperse=" + str(iv))
        fails = fails + 1
    if intersperse([], 0) != []
        print("FAIL intersperse empty should be []")
        fails = fails + 1
    if intersperse([1], 0) != [1]
        print("FAIL intersperse singleton=" + str(intersperse([1], 0)))
        fails = fails + 1

    if fails == 0
        print("ITERX KAT PASS")
    else
        print("ITERX KAT FAILED (" + str(fails) + ")")
    return 0
