import std/data/jsondiff

// ── Assertion helpers ────────────────────────────────────────────────────────

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + got + " want " + want)
        exit(1)

fn ckb(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// ── KAT 1: jd_equal — identical dicts -> true ────────────────────────────────
let d1a = {}
d1a["a"] = 1
let d1b = {}
d1b["a"] = 1
ckb("equal_dicts", jd_equal(d1a, d1b), 1)

// ── KAT 2: jd_equal — different value -> false ───────────────────────────────
let d2a = {}
d2a["a"] = 1
let d2b = {}
d2b["a"] = 2
ckb("unequal_dicts", jd_equal(d2a, d2b), 0)

// ── KAT 3: jd_diff — single replace ─────────────────────────────────────────
// {"a":1,"b":2} vs {"a":1,"b":3} => one replace on path "b"
let d3a = {}
d3a["a"] = 1
d3a["b"] = 2
let d3b = {}
d3b["a"] = 1
d3b["b"] = 3
let diff3 = jd_diff(d3a, d3b)
cki("replace_len", len(diff3), 1)
let rec3 = diff3[0]
cks("replace_op", rec3["op"], "replace")
cks("replace_path", rec3["path"], "b")

// ── KAT 4: jd_diff — one add ─────────────────────────────────────────────────
// {"a":1} vs {"a":1,"c":9} => one add on path "c"
let d4a = {}
d4a["a"] = 1
let d4b = {}
d4b["a"] = 1
d4b["c"] = 9
let diff4 = jd_diff(d4a, d4b)
cki("add_len", len(diff4), 1)
let rec4 = diff4[0]
cks("add_op", rec4["op"], "add")
cks("add_path", rec4["path"], "c")

// ── KAT 5: jd_diff — one remove ──────────────────────────────────────────────
// {"a":1,"x":9} vs {"a":1} => one remove on path "x"
let d5a = {}
d5a["a"] = 1
d5a["x"] = 9
let d5b = {}
d5b["a"] = 1
let diff5 = jd_diff(d5a, d5b)
cki("remove_len", len(diff5), 1)
let rec5 = diff5[0]
cks("remove_op", rec5["op"], "remove")
cks("remove_path", rec5["path"], "x")

// ── KAT 6: jd_equal — lists equal -> true ────────────────────────────────────
let l6a = [1, 2, 3]
let l6b = [1, 2, 3]
ckb("list_equal", jd_equal(l6a, l6b), 1)

// ── KAT 7: jd_equal — lists different length -> false ────────────────────────
let l7a = [1, 2]
let l7b = [1, 2, 3]
ckb("list_unequal_len", jd_equal(l7a, l7b), 0)

// ── KAT 8: jd_diff — no diff on equal dicts -> empty list ────────────────────
let d8a = {}
d8a["x"] = 10
d8a["y"] = 20
let d8b = {}
d8b["x"] = 10
d8b["y"] = 20
let diff8 = jd_diff(d8a, d8b)
cki("nodiff_len", len(diff8), 0)

// ── KAT 9: jd_diff — nested dict replace ─────────────────────────────────────
// {"a":{"b":1}} vs {"a":{"b":2}} => replace at path "a.b"
let inner9a = {}
inner9a["b"] = 1
let d9a = {}
d9a["a"] = inner9a
let inner9b = {}
inner9b["b"] = 2
let d9b = {}
d9b["a"] = inner9b
let diff9 = jd_diff(d9a, d9b)
cki("nested_replace_len", len(diff9), 1)
let rec9 = diff9[0]
cks("nested_replace_op", rec9["op"], "replace")
cks("nested_replace_path", rec9["path"], "a.b")

// ── KAT 10: jd_paths — flat dict ─────────────────────────────────────────────
// {"a":1,"b":2} -> paths = ["a","b"] (sorted)
let d10 = {}
d10["a"] = 1
d10["b"] = 2
let p10 = jd_paths(d10)
cki("paths_flat_len", len(p10), 2)
cks("paths_flat_0", p10[0], "a")
cks("paths_flat_1", p10[1], "b")

// ── KAT 11: jd_paths — nested dict ───────────────────────────────────────────
// {"a":{"x":1,"y":2},"b":3} -> paths = ["a.x","a.y","b"]
let inner11 = {}
inner11["x"] = 1
inner11["y"] = 2
let d11 = {}
d11["a"] = inner11
d11["b"] = 3
let p11 = jd_paths(d11)
cki("paths_nested_len", len(p11), 3)
cks("paths_nested_0", p11[0], "a.x")
cks("paths_nested_1", p11[1], "a.y")
cks("paths_nested_2", p11[2], "b")

// ── KAT 12: jd_paths — list ──────────────────────────────────────────────────
// [10,20,30] -> paths = ["0","1","2"]
let l12 = [10, 20, 30]
let p12 = jd_paths(l12)
cki("paths_list_len", len(p12), 3)
cks("paths_list_0", p12[0], "0")
cks("paths_list_1", p12[1], "1")
cks("paths_list_2", p12[2], "2")

// ── KAT 13: jd_diff list element replace ─────────────────────────────────────
// [1,2,3] vs [1,2,4] => replace at path "2"
let l13a = [1, 2, 3]
let l13b = [1, 2, 4]
let diff13 = jd_diff(l13a, l13b)
cki("list_replace_len", len(diff13), 1)
let rec13 = diff13[0]
cks("list_replace_op", rec13["op"], "replace")
cks("list_replace_path", rec13["path"], "2")

// ── KAT 14: jd_equal — string scalars ────────────────────────────────────────
ckb("str_equal", jd_equal("hello", "hello"), 1)
ckb("str_unequal", jd_equal("hello", "world"), 0)

// ── KAT 15: jd_diff — add record has correct value ───────────────────────────
// confirm d["value"] == 9 for the add in KAT 4
cki("add_value", diff4[0]["value"], 9)

// ── KAT 16: jd_diff — remove record has correct old ─────────────────────────
// confirm d["old"] == 9 for the remove in KAT 5
cki("remove_old", diff5[0]["old"], 9)

// ── KAT 17: replace record has old and value ────────────────────────────────
cki("replace_old", diff3[0]["old"], 2)
cki("replace_value", diff3[0]["value"], 3)

print("_jsondiff_test passed")
