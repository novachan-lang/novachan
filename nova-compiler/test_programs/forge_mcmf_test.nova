import forge_mcmf as mf

fn check(cond: bool, label: string)
    if cond == false
        print("FAIL: " + label)

fn lcg(state: int) -> int
    (state * 1103515245 + 12345) % 2147483648

// brute-force minimum assignment cost over all permutations (recursive)
fn brute_assign(cost: list, used: list, row: int, acc: int, best: list)
    let n = len(cost)
    if row == n
        if acc < best[0]
            best[0] = acc
    else
        let crow = cost[row]
        let c = 0
        while c < n
            if used[c] == 0
                used[c] = 1
                brute_assign(cost, used, row + 1, acc + crow[c], best)
                used[c] = 0
            c = c + 1

fn brute_min(cost: list) -> int
    let n = len(cost)
    let used = []
    let z = 0
    while z < n
        push(used, 0)
        z = z + 1
    let best = [1000000000]
    brute_assign(cost, used, 0, 0, best)
    best[0]

fn main()
    // ---- simple known max-flow / min-cost ----
    // source 0 -> 1 (cap 2, cost 1) ; 1 -> sink 2 (cap 2, cost 1) ; flow 2, cost 2*(1+1)=4
    let r1 = mf.min_cost_max_flow(3, [[0, 1, 2, 1], [1, 2, 2, 1]], 0, 2)
    check(r1[0] == 2, "simple max flow == 2")
    check(r1[1] == 4, "simple min cost == 4")

    // two parallel paths, choose cheaper first
    // 0->1 cap1 cost1, 0->2 cap1 cost5, 1->3 cap1 cost1, 2->3 cap1 cost1, sink 3
    // max flow 2: one unit via 0-1-3 (cost 2), one via 0-2-3 (cost 6) -> total flow 2 cost 8
    let r2 = mf.min_cost_max_flow(4, [[0, 1, 1, 1], [0, 2, 1, 5], [1, 3, 1, 1], [2, 3, 1, 1]], 0, 3)
    check(r2[0] == 2, "two-path flow == 2")
    check(r2[1] == 8, "two-path cost == 8")

    // ---- assignment problem: fixed 3x3 ----
    // classic: cost [[9,2,7],[6,4,3],[5,8,1]] ; optimal assignment cost = 2+3+5? check via brute
    let cm = [[9, 2, 7], [6, 4, 3], [5, 8, 1]]
    check(mf.assignment_min_cost(cm) == brute_min(cm), "3x3 assignment matches brute")

    // ---- BIG cross-check: random n x n cost matrices, MCMF assignment == brute-force permutation min ----
    let st = 98765
    let trial = 0
    while trial < 25
        st = lcg(st)
        let n = 2 + (st % 3)   // n = 2..4 (brute is n!)
        let cost = []
        let i = 0
        while i < n
            let row = []
            let j = 0
            while j < n
                st = lcg(st)
                push(row, st % 20)
                j = j + 1
            push(cost, row)
            i = i + 1
        let viaMcmf = mf.assignment_min_cost(cost)
        let viaBrute = brute_min(cost)
        check(viaMcmf == viaBrute, "assignment matches brute trial " + str(trial))
        trial = trial + 1

    // ---- max-flow value on assignment must be n (perfect matching) ----
    let src = 0
    let snk = 2 * 2 + 1
    let edges = [[src, 1, 1, 0], [src, 2, 1, 0], [3, snk, 1, 0], [4, snk, 1, 0], [1, 3, 1, 1], [1, 4, 1, 2], [2, 3, 1, 3], [2, 4, 1, 4]]
    let rr = mf.min_cost_max_flow(6, edges, src, snk)
    check(rr[0] == 2, "assignment max flow == n")

    print("forge_mcmf: all passed")
