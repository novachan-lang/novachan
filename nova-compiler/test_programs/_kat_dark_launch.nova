import forge_dark_launch

fn main()
    let dl = dl_new()
    dl = dl_add_feature(dl, "new-search", 50)
    dl = dl_add_feature(dl, "new-checkout", 100)
    assert(dl_feature_count(dl) == 2, "2 features")

    assert(dl_should_shadow(dl, "new-search", 10) == 1, "10%50 = shadow")
    assert(dl_should_shadow(dl, "new-search", 75) == 0, "75%50 = no shadow")
    assert(dl_should_shadow(dl, "new-checkout", 99) == 1, "100% always shadow")

    dl = dl_record_call(dl, "new-search", 1, 1)
    dl = dl_record_call(dl, "new-search", 1, 0)
    dl = dl_record_call(dl, "new-search", 0, 1)
    assert(dl_total_calls(dl, "new-search") == 3, "3 calls")
    assert(dl_shadow_calls(dl, "new-search") == 2, "2 shadow calls")
    assert(dl_mismatch_rate(dl, "new-search") == 50, "50% mismatch")

    dl = dl_disable(dl, "new-search")
    assert(dl_should_shadow(dl, "new-search", 10) == 0, "disabled no shadow")

    assert(dl_should_shadow(dl, "nonexistent", 0) == 0, "no feature no shadow")
    assert(dl_total_calls(dl, "nonexistent") == 0, "no feature no calls")

    print("DARK-LAUNCH KAT PASS")
