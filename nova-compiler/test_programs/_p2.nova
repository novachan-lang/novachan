// phase2 park-then-wake only
let n = 3000
let inboxes = []
let j = 0
while j < n
    push(inboxes, channel())
    j = j + 1
let results = channel()
let k = 0
while k < n
    let myc = inboxes[k]
    spawn fn()
        let v = receive(myc)
        send(results, v + 1)
    k = k + 1
let w = 0
while w < n
    send(inboxes[w], w)
    w = w + 1
let sum2 = 0
let c2 = 0
while c2 < n
    sum2 = sum2 + receive(results)
    c2 = c2 + 1
let expected = n + n * (n - 1) / 2
assert(sum2 == expected, "p2")
print("p2 OK sum=" + str(sum2))
