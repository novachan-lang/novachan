// KAT test for std/numeric/poly_eval.nova
// Tests: poly_eval (Horner), poly_derivative, poly_roots_quadratic
import std/numeric/poly_eval

fn approx(a, b, tol) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < tol
        return 1
    return 0

fn ckf(label, got, expected, tol)
    if approx(got, expected, tol) == 0
        print("FAIL: " + label + " got=" + str(got) + " expected=" + str(expected))
        exit(1)

fn ckfl(label, lst, idx, expected, tol)
    let got = lst[idx] * 1.0
    ckf(label, got, expected, tol)

fn cklen(label, lst, expected_len)
    let n = len(lst)
    if n != expected_len
        print("FAIL: " + label + " len=" + str(n) + " expected=" + str(expected_len))
        exit(1)

fn main()
    let eps = 0.0001

    // KAT 1: poly_eval([1.0, 2.0], 3.0)
    // p(x) = 1 + 2x; p(3) = 1 + 6 = 7
    let c1 = [1.0, 2.0]
    let v1 = poly_eval.poly_eval(c1, 3.0)
    ckf("kat1 eval 1+2x at 3 = 7", v1, 7.0, eps)

    // KAT 2: poly_eval([1.0, 0.0, 1.0], 2.0)
    // p(x) = 1 + 0x + x^2; p(2) = 1 + 0 + 4 = 5
    let c2 = [1.0, 0.0, 1.0]
    let v2 = poly_eval.poly_eval(c2, 2.0)
    ckf("kat2 eval 1+x^2 at 2 = 5", v2, 5.0, eps)

    // KAT 3: poly_eval constant [5.0] at any x
    let c3 = [5.0]
    let v3 = poly_eval.poly_eval(c3, 99.0)
    ckf("kat3 eval const 5 at 99 = 5", v3, 5.0, eps)

    // KAT 4: poly_derivative([1.0, 2.0, 3.0])
    // p(x) = 1 + 2x + 3x^2  ->  p'(x) = 2 + 6x  ->  [2.0, 6.0]
    let c4 = [1.0, 2.0, 3.0]
    let d4 = poly_eval.poly_derivative(c4)
    cklen("kat4 deriv len=2", d4, 2)
    ckfl("kat4 deriv[0]=2", d4, 0, 2.0, eps)
    ckfl("kat4 deriv[1]=6", d4, 1, 6.0, eps)

    // KAT 5: poly_derivative of constant -> [0.0]
    let c5 = [7.0]
    let d5 = poly_eval.poly_derivative(c5)
    cklen("kat5 deriv const len=1", d5, 1)
    ckfl("kat5 deriv const[0]=0", d5, 0, 0.0, eps)

    // KAT 6: poly_roots_quadratic(1.0, -3.0, 2.0)
    // x^2 - 3x + 2 = (x-1)(x-2) -> roots 1.0 and 2.0 ascending
    let roots6 = poly_eval.poly_roots_quadratic(1.0, 0.0 - 3.0, 2.0)
    cklen("kat6 roots len=2", roots6, 2)
    ckfl("kat6 root0=1", roots6, 0, 1.0, eps)
    ckfl("kat6 root1=2", roots6, 1, 2.0, eps)

    // KAT 7: poly_roots_quadratic with double root
    // x^2 - 2x + 1 = (x-1)^2 -> root 1.0
    let roots7 = poly_eval.poly_roots_quadratic(1.0, 0.0 - 2.0, 1.0)
    cklen("kat7 double root len=1", roots7, 1)
    ckfl("kat7 double root=1", roots7, 0, 1.0, eps)

    // KAT 8: poly_roots_quadratic no real roots
    // x^2 + 1 = 0 -> no real roots
    let roots8 = poly_eval.poly_roots_quadratic(1.0, 0.0, 1.0)
    cklen("kat8 no real roots len=0", roots8, 0)

    // KAT 9: Horner on cubic p(x) = 2 + x + 0*x^2 + x^3 at x=2
    // p(2) = 2 + 2 + 0 + 8 = 12
    let c9 = [2.0, 1.0, 0.0, 1.0]
    let v9 = poly_eval.poly_eval(c9, 2.0)
    ckf("kat9 cubic eval at 2 = 12", v9, 12.0, eps)

    // KAT 10: poly_derivative([1.0, 3.0, 0.0, 2.0])
    // p(x) = 1 + 3x + 0x^2 + 2x^3 -> p'(x) = 3 + 0x + 6x^2 -> [3.0, 0.0, 6.0]
    let c10 = [1.0, 3.0, 0.0, 2.0]
    let d10 = poly_eval.poly_derivative(c10)
    cklen("kat10 deriv len=3", d10, 3)
    ckfl("kat10 deriv[0]=3", d10, 0, 3.0, eps)
    ckfl("kat10 deriv[1]=0", d10, 1, 0.0, eps)
    ckfl("kat10 deriv[2]=6", d10, 2, 6.0, eps)

    print("PASS _poly_eval_test")
