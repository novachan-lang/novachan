// Oracle for collatex (human-friendly Unicode collation), exercised through import. Accented
// inputs are built via from_codepoint so this source stays pure ASCII and every codepoint is
// explicit. The headline: an accented word collates NEXT TO its base letter, not after z.
import collatex

fn cp(c)
    from_codepoint(c)

fn main()
    let neg1 = 0 - 1
    let eclair_acc = cp(233) + "clair"        // eclair with an accented e (U+00E9)
    let zurich_um = "Z" + cp(252) + "rich"    // Zurich with u-umlaut (U+00FC)

    // collation_key strips accents (via NFD) + folds case at the primary level
    assert(collatex.collation_key(eclair_acc) == "eclair", "key accented eclair -> eclair")
    assert(collatex.collation_key("Apple") == "apple", "key Apple -> apple")
    assert(collatex.collation_key(zurich_um) == "zurich", "key Zurich-umlaut -> zurich")

    // THE HEADLINE: an accented word sorts NEAR its base letter, not after z
    assert(collatex.collate(eclair_acc, "zebra") == neg1, "accented eclair collates before zebra")
    // ...whereas the naive codepoint order gets it WRONG (the accented e outranks z):
    assert(eclair_acc > "zebra", "naive codepoint order is wrong (accented-e > z)")

    // case-insensitive at the primary level, deterministic tiebreak by original codepoint
    assert(collatex.collate("Apple", "apple") == neg1, "Apple before apple (case tiebreak)")
    assert(collatex.collate("apple", "apple") == 0, "equal")
    assert(collatex.collate("zebra", "Zurich") == neg1, "zebra before Zurich (e < u, case-insensitive)")

    // Greek + Cyrillic fold case at the primary level (capital collates with its small form)
    assert(collatex.collate(cp(913), cp(945)) == neg1, "Greek Alpha before alpha (tiebreak)")
    assert(collatex.collate(cp(1040), cp(1072)) == neg1, "Cyrillic A before a (tiebreak)")

    // full sort into human-friendly order: accented near base, case-insensitive primary
    let items = ["zebra", "Apple", "apple", "eclair", eclair_acc, "Zurich", zurich_um]
    let sorted = collatex.collate_sort(items)
    assert(sorted[0] == "Apple", "0 Apple")
    assert(sorted[1] == "apple", "1 apple")
    assert(sorted[2] == "eclair", "2 eclair")
    assert(sorted[3] == eclair_acc, "3 accented eclair")
    assert(sorted[4] == "zebra", "4 zebra")
    assert(sorted[5] == "Zurich", "5 Zurich")
    assert(sorted[6] == zurich_um, "6 Zurich-umlaut")

    print("collatex_test passed: accent/case-insensitive primary collation + stable total order")
