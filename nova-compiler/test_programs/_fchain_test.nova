import std/functional/fchain

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckl(label, got, want)
    if len(got) != len(want)
        print("FAIL " + label + ": len " + str(len(got)) + " != " + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL " + label + "[" + str(i) + "]: got " + str(got[i]) + " want " + str(want[i]))
            exit(1)
        i = i + 1

fn dbl(x)
    x * 2

fn inc(x)
    x + 1

fn sqr(x)
    x * x

fn main()
    // fch_pipe2(x, f, g) = g(f(x))  left-to-right
    // fch_pipe2(3, dbl, inc) = inc(dbl(3)) = inc(6) = 7
    cki("pipe2_3_dbl_inc", fch_pipe2(3, dbl, inc), 7)
    // fch_pipe2(5, inc, dbl) = dbl(inc(5)) = dbl(6) = 12
    cki("pipe2_5_inc_dbl", fch_pipe2(5, inc, dbl), 12)
    // fch_pipe2(0, dbl, inc) = 1
    cki("pipe2_0_dbl_inc", fch_pipe2(0, dbl, inc), 1)

    // fch_pipe3(x, f, g, h) = h(g(f(x)))
    // fch_pipe3(3, dbl, inc, sqr) = sqr(inc(dbl(3))) = sqr(inc(6)) = sqr(7) = 49
    cki("pipe3_3_dbl_inc_sqr", fch_pipe3(3, dbl, inc, sqr), 49)
    // fch_pipe3(2, inc, dbl, inc) = inc(dbl(inc(2))) = inc(dbl(3)) = inc(6) = 7
    cki("pipe3_2_inc_dbl_inc", fch_pipe3(2, inc, dbl, inc), 7)

    // fch_compose2(x, f, g) = f(g(x))  right-to-left
    // fch_compose2(3, dbl, inc) = dbl(inc(3)) = dbl(4) = 8
    cki("compose2_3_dbl_inc", fch_compose2(3, dbl, inc), 8)
    // fch_compose2(2, sqr, inc) = sqr(inc(2)) = sqr(3) = 9
    cki("compose2_2_sqr_inc", fch_compose2(2, sqr, inc), 9)
    // fch_compose2(3, inc, dbl) = inc(dbl(3)) = 7
    cki("compose2_3_inc_dbl", fch_compose2(3, inc, dbl), 7)

    // fch_apply_all(x, f, g, h) = [f(x), g(x), h(x)]
    // fch_apply_all(3, dbl, inc, sqr) = [6, 4, 9]
    let want1 = [6, 4, 9]
    ckl("apply_all_3_dbl_inc_sqr", fch_apply_all(3, dbl, inc, sqr), want1)

    // fch_apply_all(0, dbl, inc, sqr) = [0, 1, 0]
    let want2 = [0, 1, 0]
    ckl("apply_all_0_dbl_inc_sqr", fch_apply_all(0, dbl, inc, sqr), want2)

    // fch_apply_all(5, inc, dbl, sqr) = [6, 10, 25]
    let want3 = [6, 10, 25]
    ckl("apply_all_5_inc_dbl_sqr", fch_apply_all(5, inc, dbl, sqr), want3)

    print("PASS _fchain_test")

main()
