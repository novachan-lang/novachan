fn link_pair()
  let a_to_b = channel()
  let b_to_a = channel()
  let link = {}
  link["a_ch"] = a_to_b
  link["b_ch"] = b_to_a
  link

fn link_processes(pa, pb)
  let mon_a = monitor(pa)
  let mon_b = monitor(pb)
  [mon_a, mon_b]

fn link_watch(links, handler)
  let mon_a = links[0]
  let mon_b = links[1]
  let ch = channel()
  spawn fn(z) _link_watcher(mon_a, "a", ch)
  spawn fn(z) _link_watcher(mon_b, "b", ch)
  let first = receive(ch)
  handler(first)

fn _link_watcher(mon, name, out)
  let status = receive(mon)
  send(out, [name, status])

fn _worker_a(ch, delay)
  send(ch, "a:started")
  sleep(delay)
  send(ch, "a:done")

fn _worker_b(ch)
  send(ch, "b:started")
  panic("b:crashed")

fn main()
  let ch = channel()
  let pa = spawn _worker_a(ch, 50)
  let pb = spawn _worker_b(ch)

  let links = link_processes(pa, pb)

  let msgs = []
  let _m1 = receive(ch)
  push(msgs, _m1)
  let _m2 = receive(ch)
  push(msgs, _m2)

  let status_b = receive(links[1])
  assert(status_b == 1, "b crashed with status 1")

  let status_a = receive(links[0])
  assert(status_a == 0, "a finished normally")

  let reason_b = exit_reason(pb)
  assert(contains(reason_b, "b:crashed"), "b reason")

  print("linkx2: all passed")
