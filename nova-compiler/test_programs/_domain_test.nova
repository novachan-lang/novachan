// _domain_test.nova — KAT for std/validation/domain
// Hand-computed expected values verified against RFC 1035-lite rules.
import std/validation/domain

fn ckb(label: string, got: bool, expected: bool)
    if got != expected
        let gs = "false"
        if got
            gs = "true"
        let es = "false"
        if expected
            es = "true"
        print("FAIL " + label + ": got " + gs + " expected " + es)
        exit(1)

fn cks(label: string, got: string, expected: string)
    if got != expected
        print("FAIL " + label + ": got [" + got + "] expected [" + expected + "]")
        exit(1)

fn cki(label: string, got: int, expected: int)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn main()
    // ── KAT 1: vdom_is_valid — well-formed domains ───────────────────────────
    // "example.com": 2 labels, TLD "com" all-alpha, label "example" alphanum
    ckb("valid_example_com",      vdom_is_valid("example.com"),        true)
    // "sub.example.co.uk": 4 labels, TLD "uk" 2 letters, all labels clean
    ckb("valid_sub_co_uk",        vdom_is_valid("sub.example.co.uk"),  true)
    // "a-b.example.com": hyphen in middle of label — allowed
    ckb("valid_hyphen_middle",    vdom_is_valid("a-b.example.com"),    true)
    // "x1.y2.org": digits in non-TLD labels — allowed
    ckb("valid_digits_in_label",  vdom_is_valid("x1.y2.org"),          true)

    // ── KAT 2: vdom_is_valid — invalid domains ───────────────────────────────
    // "-bad.com": first label starts with hyphen
    ckb("invalid_leading_hyphen", vdom_is_valid("-bad.com"),           false)
    // "bad-.com": first label ends with hyphen
    ckb("invalid_trailing_hyphen", vdom_is_valid("bad-.com"),          false)
    // "example": no dot -> no TLD -> invalid
    ckb("invalid_no_tld",         vdom_is_valid("example"),            false)
    // "ex ample.com": space character not in [A-Za-z0-9-]
    ckb("invalid_space",          vdom_is_valid("ex ample.com"),       false)
    // "foo.123": TLD "123" contains digits only -> invalid TLD
    ckb("invalid_numeric_tld",    vdom_is_valid("foo.123"),            false)
    // "": empty string -> invalid
    ckb("invalid_empty",          vdom_is_valid(""),                   false)
    // ".com": empty first label (length 0 before dot) -> invalid
    ckb("invalid_dot_prefix",     vdom_is_valid(".com"),               false)
    // "foo.c": TLD "c" is only 1 char -> must be >= 2 letters
    ckb("invalid_tld_too_short",  vdom_is_valid("foo.c"),              false)

    // ── KAT 3: vdom_tld ──────────────────────────────────────────────────────
    // "a.b.com" -> last label is "com"
    cks("tld_abc",    vdom_tld("a.b.com"),        "com")
    // "example.org" -> "org"
    cks("tld_org",    vdom_tld("example.org"),     "org")
    // "sub.example.co.uk" -> "uk"
    cks("tld_uk",     vdom_tld("sub.example.co.uk"), "uk")

    // ── KAT 4: vdom_labels ───────────────────────────────────────────────────
    // "a.b.com" -> ["a", "b", "com"]  (3 labels)
    let labs = vdom_labels("a.b.com")
    cki("labels_count",    len(labs), 3)
    cks("labels_0",        labs[0],   "a")
    cks("labels_1",        labs[1],   "b")
    cks("labels_2",        labs[2],   "com")

    // "example.com" -> ["example", "com"]  (2 labels)
    let labs2 = vdom_labels("example.com")
    cki("labels2_count",   len(labs2), 2)
    cks("labels2_0",       labs2[0],   "example")
    cks("labels2_1",       labs2[1],   "com")

    // ── KAT 5: vdom_is_subdomain ─────────────────────────────────────────────
    // "a.b.com" has 3 labels -> true
    ckb("subdomain_abc",     vdom_is_subdomain("a.b.com"),       true)
    // "example.com" has 2 labels -> false
    ckb("subdomain_2label",  vdom_is_subdomain("example.com"),   false)
    // "x.y.z.com" has 4 labels -> true
    ckb("subdomain_4label",  vdom_is_subdomain("x.y.z.com"),     true)

    print("_domain_test passed")
