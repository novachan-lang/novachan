import std/cipher/autokey

fn main()
    // ── KNOWN VECTOR ─────────────────────────────────────────────────────────
    // autokey_encrypt("ATTACKATDAWN", "QUEENLY") == "QNXEPVYTWTWP"
    let kv_ct = autokey_encrypt("ATTACKATDAWN", "QUEENLY")
    if kv_ct != "QNXEPVYTWTWP"
        print("FAIL autokey_test known-vector-encrypt: got " + kv_ct + " want QNXEPVYTWTWP")
        exit(1)

    let kv_pt = autokey_decrypt("QNXEPVYTWTWP", "QUEENLY")
    if kv_pt != "ATTACKATDAWN"
        print("FAIL autokey_test known-vector-decrypt: got " + kv_pt + " want ATTACKATDAWN")
        exit(1)

    // ── ROUND-TRIP 1: short message, short key ────────────────────────────────
    let rt1_pt = "HELLO"
    let rt1_key = "KEY"
    let rt1_ct = autokey_encrypt(rt1_pt, rt1_key)
    let rt1_dec = autokey_decrypt(rt1_ct, rt1_key)
    if rt1_dec != rt1_pt
        print("FAIL autokey_test round-trip-1: got " + rt1_dec + " want " + rt1_pt)
        exit(1)

    // ── ROUND-TRIP 2: message shorter than key ────────────────────────────────
    let rt2_pt = "HI"
    let rt2_key = "LONGERKEYWORD"
    let rt2_ct = autokey_encrypt(rt2_pt, rt2_key)
    let rt2_dec = autokey_decrypt(rt2_ct, rt2_key)
    if rt2_dec != rt2_pt
        print("FAIL autokey_test round-trip-2 (msg<key): got " + rt2_dec + " want " + rt2_pt)
        exit(1)

    // ── ROUND-TRIP 3: message same length as key ──────────────────────────────
    let rt3_pt = "EXACT"
    let rt3_key = "MATCH"
    let rt3_ct = autokey_encrypt(rt3_pt, rt3_key)
    let rt3_dec = autokey_decrypt(rt3_ct, rt3_key)
    if rt3_dec != rt3_pt
        print("FAIL autokey_test round-trip-3 (msg==key): got " + rt3_dec + " want " + rt3_pt)
        exit(1)

    // ── ROUND-TRIP 4: long message ────────────────────────────────────────────
    let rt4_pt = "THEQUICKBROWNFOXJUMPSOVERTHELAZYDOG"
    let rt4_key = "SECRET"
    let rt4_ct = autokey_encrypt(rt4_pt, rt4_key)
    let rt4_dec = autokey_decrypt(rt4_ct, rt4_key)
    if rt4_dec != rt4_pt
        print("FAIL autokey_test round-trip-4 (long): got " + rt4_dec + " want " + rt4_pt)
        exit(1)

    // ── ROUND-TRIP 5: input normalisation (lowercase + spaces) ───────────────
    let rt5_pt = "HELLOWORLD"
    let rt5_ct = autokey_encrypt("hello world", "key")
    let rt5_dec = autokey_decrypt(rt5_ct, "key")
    if rt5_dec != rt5_pt
        print("FAIL autokey_test round-trip-5 (normalise): got " + rt5_dec + " want " + rt5_pt)
        exit(1)

    // ── EMPTY INPUT ───────────────────────────────────────────────────────────
    let empty_ct = autokey_encrypt("", "QUEENLY")
    if empty_ct != ""
        print("FAIL autokey_test empty-encrypt: got " + empty_ct + " want empty")
        exit(1)

    let empty_pt = autokey_decrypt("", "QUEENLY")
    if empty_pt != ""
        print("FAIL autokey_test empty-decrypt: got " + empty_pt + " want empty")
        exit(1)

    // ── EMPTY KEYWORD (smoke: encrypt does not crash) ─────────────────────────
    // With empty keyword the key stream == plaintext, so C[i]=(2*P[i])%26.
    // This is a degenerate case (not invertible for all inputs) — we only check
    // that the function returns a string of the right length without crashing.
    let ek_ct = autokey_encrypt("ACE", "")
    if len(ek_ct) != 3
        print("FAIL autokey_test empty-keyword-len: got len " + str(len(ek_ct)) + " want 3")
        exit(1)

    // ── SINGLE CHARACTER ──────────────────────────────────────────────────────
    let sc_ct = autokey_encrypt("A", "Z")
    let sc_dec = autokey_decrypt(sc_ct, "Z")
    if sc_dec != "A"
        print("FAIL autokey_test single-char: got " + sc_dec + " want A")
        exit(1)

    // ── WRAP-AROUND CHECK (Z+Z = 25+25=50 mod 26 = 24 = Y) ──────────────────
    let wa_ct = autokey_encrypt("Z", "Z")
    if wa_ct != "Y"
        print("FAIL autokey_test wrap-around-encrypt: got " + wa_ct + " want Y")
        exit(1)
    let wa_dec = autokey_decrypt("Y", "Z")
    if wa_dec != "Z"
        print("FAIL autokey_test wrap-around-decrypt: got " + wa_dec + " want Z")
        exit(1)

    print("PASS _autokey_test")
