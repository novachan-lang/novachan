// KAT for std/math/combinatorics — integer combinatorics.
// All expected values are hand-computed.
import std/math/combinatorics

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // --- cb_factorial ---
    cki("factorial(0)", cb_factorial(0), 1)
    cki("factorial(1)", cb_factorial(1), 1)
    cki("factorial(5)", cb_factorial(5), 120)
    cki("factorial(10)", cb_factorial(10), 3628800)

    // --- cb_nCr ---
    cki("nCr(5,2)", cb_nCr(5, 2), 10)
    cki("nCr(10,0)", cb_nCr(10, 0), 1)
    cki("nCr(10,10)", cb_nCr(10, 10), 1)
    cki("nCr(52,5)", cb_nCr(52, 5), 2598960)
    cki("nCr(6,3)", cb_nCr(6, 3), 20)
    cki("nCr(7,4)", cb_nCr(7, 4), 35)
    // symmetry: C(8,3) == C(8,5) == 56
    cki("nCr(8,3)", cb_nCr(8, 3), 56)
    cki("nCr(8,5)", cb_nCr(8, 5), 56)

    // --- cb_nPr ---
    cki("nPr(5,2)", cb_nPr(5, 2), 20)
    cki("nPr(5,0)", cb_nPr(5, 0), 1)
    cki("nPr(5,5)", cb_nPr(5, 5), 120)
    cki("nPr(10,3)", cb_nPr(10, 3), 720)

    // --- cb_catalan ---
    // Catalan: 1,1,2,5,14,42,132,...
    cki("catalan(0)", cb_catalan(0), 1)
    cki("catalan(1)", cb_catalan(1), 1)
    cki("catalan(2)", cb_catalan(2), 2)
    cki("catalan(3)", cb_catalan(3), 5)
    cki("catalan(4)", cb_catalan(4), 14)
    cki("catalan(5)", cb_catalan(5), 42)

    // --- cb_binomial_row ---
    // Row 0 = [1]
    let r0 = cb_binomial_row(0)
    cki("binomial_row(0)[0]", r0[0], 1)

    // Row 1 = [1,1]
    let r1 = cb_binomial_row(1)
    cki("binomial_row(1)[0]", r1[0], 1)
    cki("binomial_row(1)[1]", r1[1], 1)

    // Row 4 = [1,4,6,4,1]
    let r4 = cb_binomial_row(4)
    cki("binomial_row(4)[0]", r4[0], 1)
    cki("binomial_row(4)[1]", r4[1], 4)
    cki("binomial_row(4)[2]", r4[2], 6)
    cki("binomial_row(4)[3]", r4[3], 4)
    cki("binomial_row(4)[4]", r4[4], 1)

    // Row 6 = [1,6,15,20,15,6,1]
    let r6 = cb_binomial_row(6)
    cki("binomial_row(6)[0]", r6[0], 1)
    cki("binomial_row(6)[1]", r6[1], 6)
    cki("binomial_row(6)[2]", r6[2], 15)
    cki("binomial_row(6)[3]", r6[3], 20)
    cki("binomial_row(6)[4]", r6[4], 15)
    cki("binomial_row(6)[5]", r6[5], 6)
    cki("binomial_row(6)[6]", r6[6], 1)

    print("_combinatorics_test passed")
