// _crt_test.nova — KAT tests for std/math/crt.nova
// Known-answer tests; each prints FAIL and exits 1 on failure.

import std/math/crt

// KAT 1: classic three-congruence CRT with coprime moduli.
// x≡2(3), x≡3(5), x≡2(7) -> [23, 105]
let kat1 = crt_solve([2, 3, 2], [3, 5, 7])
let kat1_x = kat1[0]
let kat1_m = kat1[1]
if kat1_x != 23
    print("FAIL KAT1: expected x=23 got " + str(kat1_x))
    exit(1)
if kat1_m != 105
    print("FAIL KAT1: expected m=105 got " + str(kat1_m))
    exit(1)

// KAT 2: two coprime moduli.
// x≡2(3), x≡3(5) -> [8, 15]
let kat2 = crt_solve2(2, 3, 3, 5)
let kat2_x = kat2[0]
let kat2_m = kat2[1]
if kat2_x != 8
    print("FAIL KAT2: expected x=8 got " + str(kat2_x))
    exit(1)
if kat2_m != 15
    print("FAIL KAT2: expected m=15 got " + str(kat2_m))
    exit(1)

// KAT 3: both remainders zero — trivial solution x=0.
// x≡0(3), x≡0(5) -> [0, 15]
let kat3 = crt_solve([0, 0], [3, 5])
let kat3_x = kat3[0]
let kat3_m = kat3[1]
if kat3_x != 0
    print("FAIL KAT3: expected x=0 got " + str(kat3_x))
    exit(1)
if kat3_m != 15
    print("FAIL KAT3: expected m=15 got " + str(kat3_m))
    exit(1)

// KAT 4: inconsistent system — non-coprime moduli, gcd does not divide diff.
// x≡1(4), x≡2(6) -> gcd(4,6)=2; diff=1; 2 ∤ 1 -> [-1, -1]
let kat4 = crt_solve([1, 2], [4, 6])
let kat4_x = kat4[0]
let kat4_m = kat4[1]
if kat4_x != -1
    print("FAIL KAT4: expected x=-1 got " + str(kat4_x))
    exit(1)
if kat4_m != -1
    print("FAIL KAT4: expected m=-1 got " + str(kat4_m))
    exit(1)

// KAT 5: crt_lcm basic.
// lcm(4, 6) = 12
let kat5 = crt_lcm(4, 6)
if kat5 != 12
    print("FAIL KAT5: expected 12 got " + str(kat5))
    exit(1)

// KAT 6: crt_solve2 with non-coprime moduli (consistent).
// x≡2(4), x≡4(6) -> gcd(4,6)=2; diff=2; 2|2; a=2,c=3; inv(2,3)=2; k=(1*2)%3=2; x=2+4*2=10; M=12 -> [10, 12]
let kat6 = crt_solve2(2, 4, 4, 6)
let kat6_x = kat6[0]
let kat6_m = kat6[1]
if kat6_x != 10
    print("FAIL KAT6: expected x=10 got " + str(kat6_x))
    exit(1)
if kat6_m != 12
    print("FAIL KAT6: expected m=12 got " + str(kat6_m))
    exit(1)

print("_crt_test passed")
