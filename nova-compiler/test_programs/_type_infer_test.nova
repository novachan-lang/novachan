import std/typesystem/type_infer

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _type_infer_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL _type_infer_test " + label + ": got=" + got + " want=" + want)
        exit(1)

fn ckb(label: string, got: int, want: int)
    if got != want
        print("FAIL _type_infer_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// Build term helpers
fn mk_var(name)
    let t = []
    push(t, "var")
    push(t, name)
    t

fn mk_lam(x, body)
    let t = []
    push(t, "lam")
    push(t, x)
    push(t, body)
    t

fn mk_app(f, a)
    let t = []
    push(t, "app")
    push(t, f)
    push(t, a)
    t

// Build type helpers for expected values
fn mk_tvar(k)
    let t = []
    push(t, "tvar")
    push(t, k)
    t

fn mk_arr(a, b)
    let t = []
    push(t, "arr")
    push(t, a)
    push(t, b)
    t

fn main()
    // --- KAT 1: lam x. x  =>  alpha-equal to a->a ---
    let id_term = mk_lam("x", mk_var("x"))
    let id_ty = tinf_infer(id_term)
    // id_ty should NOT be "FAIL"
    cki("id_not_fail", id_ty == "FAIL", 0)
    cks("id_tag", id_ty[0], "arr")
    // alpha-equal to a->a: both sides must be same tvar
    let id_c = tinf_canonicalize(id_ty)
    cks("id_canon_tag", id_c[0], "arr")
    cks("id_canon_l_tag", id_c[1][0], "tvar")
    cks("id_canon_r_tag", id_c[2][0], "tvar")
    cki("id_alpha_self_eq", tinf_alpha_eq(id_ty, id_ty), 1)
    // both sides of a->a must be the same tvar after canonicalize
    cki("id_aa_same", id_c[1][1], id_c[2][1])
    // explicit alpha-eq: inferred type == mk_arr(mk_tvar(0), mk_tvar(0)) up to alpha
    let want_aa = mk_arr(mk_tvar(0), mk_tvar(0))
    cki("id_alpha_eq_aa", tinf_alpha_eq(id_ty, want_aa), 1)

    // --- KAT 2: lam x. lam y. x  =>  alpha-equal to a->(b->a) ---
    let k_term = mk_lam("x", mk_lam("y", mk_var("x")))
    let k_ty = tinf_infer(k_term)
    cki("k_not_fail", k_ty == "FAIL", 0)
    cks("k_tag", k_ty[0], "arr")
    let want_aba = mk_arr(mk_tvar(0), mk_arr(mk_tvar(1), mk_tvar(0)))
    cki("k_alpha_eq", tinf_alpha_eq(k_ty, want_aba), 1)
    // also verify the return type IS a->a (not a->b)
    let k_c = tinf_canonicalize(k_ty)
    // canonical: arr(tv0, arr(tv1, tv0))
    cks("k_canon_tag", k_c[0], "arr")
    cks("k_canon_r_tag", k_c[2][0], "arr")
    // the outer domain and inner codomain must be the same tvar
    cki("k_outer_dom_eq_inner_cod", k_c[1][1], k_c[2][2][1])

    // --- KAT 3: lam f. lam x. f x  =>  alpha-equal to (a->b)->(a->b) ---
    let s_term = mk_lam("f", mk_lam("x", mk_app(mk_var("f"), mk_var("x"))))
    let s_ty = tinf_infer(s_term)
    cki("s_not_fail", s_ty == "FAIL", 0)
    let want_faa = mk_arr(mk_arr(mk_tvar(0), mk_tvar(1)), mk_arr(mk_tvar(0), mk_tvar(1)))
    cki("s_alpha_eq", tinf_alpha_eq(s_ty, want_faa), 1)

    // --- KAT 4: lam x. x x  =>  FAIL (occurs check / self-application) ---
    let self_app = mk_lam("x", mk_app(mk_var("x"), mk_var("x")))
    let self_ty = tinf_infer(self_app)
    cks("selfapp_fail", self_ty, "FAIL")

    // --- KAT 5: lam f. lam x. f (f x)  =>  alpha-equal to (a->a)->(a->a) ---
    let twice_term = mk_lam("f", mk_lam("x", mk_app(mk_var("f"), mk_app(mk_var("f"), mk_var("x")))))
    let twice_ty = tinf_infer(twice_term)
    cki("twice_not_fail", twice_ty == "FAIL", 0)
    let want_twice = mk_arr(mk_arr(mk_tvar(0), mk_tvar(0)), mk_arr(mk_tvar(0), mk_tvar(0)))
    cki("twice_alpha_eq", tinf_alpha_eq(twice_ty, want_twice), 1)

    // --- Additional: tinf_alpha_eq is symmetric ---
    cki("alpha_sym", tinf_alpha_eq(want_aa, id_ty), 1)

    // --- Additional: different structures are not alpha-equal ---
    let want_ab = mk_arr(mk_tvar(0), mk_tvar(1))
    cki("aa_ne_ab", tinf_alpha_eq(want_aa, want_ab), 0)

    // --- Additional: var lookup in empty env fails ---
    let v_term = mk_var("z")
    let v_ty = tinf_infer(v_term)
    cks("unbound_var_fail", v_ty, "FAIL")

    // --- Additional: id applied to itself in LAMBDA context fails (no polymorphism) ---
    // (lam id. id id) but id is lambda-bound, so tinf treats id monomorphically
    let lam_id_term = mk_lam("f", mk_app(mk_var("f"), mk_var("f")))
    let lam_id_ty = tinf_infer(lam_id_term)
    // f applied to f: f must be a->b AND a, so a = a->b -> FAIL (occurs check)
    cks("lam_selfapp_fail", lam_id_ty, "FAIL")

    print("PASS _type_infer_test")

main()
