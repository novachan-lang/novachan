// forge_cookie_test -- cookies: read from the request Cookie header, set with secure defaults,
// and MULTIPLE Set-Cookie lines on one response (Set-Cookie is the one header that repeats).
import forge

fn count_occurrences(hay: string, needle: string) -> int
    let n = 0
    let base = 0
    let i = find(hay, needle)
    while i >= 0
        n = n + 1
        base = base + i + len(needle)
        let rest = slice(hay, base, len(hay))
        i = find(rest, needle)
    n

fn main()
    // read cookies from the request
    let req: Request = forge.build_request("GET / HTTP/1.1\r\nCookie: sid=abc123; theme=dark\r\n\r\n", 0)
    assert(forge.cookie_get(req, "sid") == "abc123", "cookie_get sid")
    assert(forge.cookie_get(req, "theme") == "dark", "cookie_get theme")
    assert(forge.cookie_get(req, "nope") == "", "cookie_get missing -> empty")
    print("PASS: cookie_get")

    // set TWO cookies -> two distinct Set-Cookie lines, each with the secure attributes
    let r0: Response = forge.resp_text(200, "ok")
    let r1: Response = forge.resp_set_cookie(r0, "sid", "xyz")
    let r2: Response = forge.resp_set_cookie(r1, "csrf", "tok")
    let wire = forge.finalize(r2)
    assert(count_occurrences(wire, "Set-Cookie:") == 2, "two Set-Cookie lines")
    assert(find(wire, "Set-Cookie: sid=xyz; Path=/; HttpOnly; SameSite=Lax") >= 0, "sid cookie + secure attrs")
    assert(find(wire, "Set-Cookie: csrf=tok; Path=/; HttpOnly; SameSite=Lax") >= 0, "csrf cookie + secure attrs")
    print("PASS: resp_set_cookie (multi + secure defaults)")

    // a cookie value cannot inject a header line (sanitized at the boundary)
    let rev: Response = forge.resp_set_cookie(forge.resp_text(200, "ok"), "x", "a\r\nInjected: y")
    let wire2 = forge.finalize(rev)
    assert(find(wire2, "\r\nInjected: y") < 0, "cookie CRLF cannot inject a header")
    print("PASS: cookie value sanitized")
    print("forge_cookie_test passed")
