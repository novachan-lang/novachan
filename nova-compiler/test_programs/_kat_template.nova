// _kat_template.nova — KAT probe for std/text/template
// Builds brace chars via chr(123)/chr(125) — never literal "{" in template strings.
import std/text/template

// Helper: build "{{inner}}" without source-level brace literals
fn _ph(inner) -> string
    chr(123) + chr(123) + inner + chr(125) + chr(125)

// ── KAT 1: single placeholder ──────────────────────────────────────────────
let v1 = {}
v1["name"] = "World"
let t1 = "Hello " + _ph("name") + "!"
let r1 = template_render(t1, v1)
if r1 != "Hello World!"
    print("FAIL KAT1: expected 'Hello World!' got: " + r1)
    exit(1)
print("OK KAT1: single placeholder")

// ── KAT 2: two placeholders ────────────────────────────────────────────────
let v2 = {}
v2["a"] = "1"
v2["b"] = "2"
let op = chr(123) + chr(123)
let cl = chr(125) + chr(125)
let t2 = op + "a" + cl + " and " + op + "b" + cl
let r2 = template_render(t2, v2)
if r2 != "1 and 2"
    print("FAIL KAT2: expected '1 and 2' got: " + r2)
    exit(1)
print("OK KAT2: two placeholders")

// ── KAT 3: missing key -> "" ───────────────────────────────────────────────
let v3 = {}
let t3 = "x" + _ph("gone") + "y"
let r3 = template_render(t3, v3)
if r3 != "xy"
    print("FAIL KAT3: expected 'xy' got: " + r3)
    exit(1)
print("OK KAT3: missing key -> empty")

// ── KAT 4: no placeholders -> unchanged ───────────────────────────────────
let v4 = {}
v4["x"] = "X"
let t4 = "plain text"
let r4 = template_render(t4, v4)
if r4 != "plain text"
    print("FAIL KAT4: expected 'plain text' got: " + r4)
    exit(1)
print("OK KAT4: no placeholders -> passthrough")

// ── KAT 5: lone '{' (not '{{') passes through verbatim ────────────────────
let v5 = {}
v5["k"] = "v"
let t5 = chr(123) + "not-double"    // single { followed by text
let r5 = template_render(t5, v5)
if r5 != chr(123) + "not-double"
    print("FAIL KAT5: lone brace should pass through verbatim, got: " + r5)
    exit(1)
print("OK KAT5: lone brace is literal")

// ── KAT 6: whitespace trimming in key ─────────────────────────────────────
let v6 = {}
v6["name"] = "Alice"
let t6 = "Hi " + chr(123) + chr(123) + "  name  " + chr(125) + chr(125) + "."
let r6 = template_render(t6, v6)
if r6 != "Hi Alice."
    print("FAIL KAT6: trimmed key lookup failed, got: " + r6)
    exit(1)
print("OK KAT6: key whitespace trimming")

// ── KAT 7: repeated placeholder ───────────────────────────────────────────
let v7 = {}
v7["x"] = "Z"
let t7 = _ph("x") + "-" + _ph("x")
let r7 = template_render(t7, v7)
if r7 != "Z-Z"
    print("FAIL KAT7: expected 'Z-Z' got: " + r7)
    exit(1)
print("OK KAT7: repeated placeholder")

// ── KAT 8: empty template ─────────────────────────────────────────────────
let v8 = {}
let r8 = template_render("", v8)
if r8 != ""
    print("FAIL KAT8: expected '' got: " + r8)
    exit(1)
print("OK KAT8: empty template")

// ── KAT 9: int value coerced to string ────────────────────────────────────
let v9 = {}
v9["n"] = 42
let t9 = "count=" + _ph("n")
let r9 = template_render(t9, v9)
if r9 != "count=42"
    print("FAIL KAT9: expected 'count=42' got: " + r9)
    exit(1)
print("OK KAT9: int value coercion")

print("ALL OK: std/text/template KATs passed")
