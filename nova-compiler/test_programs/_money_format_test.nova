import std/money/format
fn _s(l, g, w)
    if g != w
        print("FAIL format " + l + " got=" + g + " want=" + w)
        exit(1)
fn main()
    _s("group", mfmt_group("1234567"), "1,234,567")
    _s("amt", mfmt_amount(123456, 2), "1,234.56")
    _s("amt0", mfmt_amount(1000, 0), "1,000")
    _s("amt5", mfmt_amount(5, 2), "0.05")
    _s("usd", mfmt_money(123456, "USD"), "$1,234.56")
    _s("paren", mfmt_negative_paren(-123456, 2), "(1,234.56)")
    _s("plain", mfmt_plain(123456, 2), "1234.56")
    // Negative symbol-position cases: sign must appear BEFORE the symbol
    _s("usd_neg", mfmt_money(-123456, "USD"), "-$1,234.56")
    _s("sym_neg", mfmt_with_symbol(-123456, 2, "$"), "-$1,234.56")
    _s("sym_pos", mfmt_with_symbol(123456, 2, "$"), "$1,234.56")
    print("PASS _money_format_test")
