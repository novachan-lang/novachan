import forge_lfu_cache

fn main()
    let c = lfu_new(2)
    c = lfu_put(c, "a", "1")
    c = lfu_put(c, "b", "2")
    assert(lfu_count(c) == 2, "2 items")

    let r1 = lfu_get(c, "a")
    assert(is_ok(r1), "get a ok")
    assert(unwrap(r1) == "1", "a=1")

    let r2 = lfu_get(c, "a")
    assert(is_ok(r2), "get a again")

    let r3 = lfu_get(c, "missing")
    assert(is_err(r3), "cache miss")

    assert(lfu_hit_rate(c) == 66, "66% hit rate")

    print("LFU-CACHE KAT PASS")
