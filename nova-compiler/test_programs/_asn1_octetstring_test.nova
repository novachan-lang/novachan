// _asn1_octetstring_test — KAT for std/data/asn1_octetstring
//
// Verifies byte-exact DER encoding per X.690 §8.7:
//
//   KAT 1: asn1_octetstring_encode([0x01,0x02,0x03]) == [0x04,0x03,0x01,0x02,0x03]
//   KAT 2: asn1_octetstring_encode(empty)            == [0x04,0x00]
//   KAT 3: asn1_octetstring_encode(200 bytes) len==203, starts [0x04,0x81,0xC8]
//   KAT 4: decode [0x04,0x03,0x01,0x02,0x03] -> content=[1,2,3], next_pos=5
//   KAT 5: decode empty OCTET STRING [0x04,0x00] -> content=empty, next_pos=2
//   KAT 6: round-trip encode->decode recovers content exactly (3-byte case)
//   KAT 7: round-trip encode->decode recovers content exactly (200-byte case)
//   KAT 8: decode wrong tag (0x02) -> safe stall [bytes(0), pos]
//   KAT 9: decode truncated buffer -> safe stall
//   KAT 10: decode at non-zero offset (buffer with 3 garbage bytes before TLV)

import std/data/asn1_octetstring

fn _bytes_eq(a, b) -> int
    let la = bytes_len(a)
    let lb = bytes_len(b)
    let eq = 1
    if la != lb
        eq = 0
    else
        let i = 0
        while i < la
            if bytes_get(a, i) != bytes_get(b, i)
                eq = 0
            i = i + 1
    eq

fn ckb(label, got, want)
    if got != want
        print("FAIL asn1_octetstring " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // ── KAT 1: encode [0x01,0x02,0x03] == [0x04,0x03,0x01,0x02,0x03] ─────────
    let data1 = bytes(3)
    bytes_set(data1, 0, 1)
    bytes_set(data1, 1, 2)
    bytes_set(data1, 2, 3)
    let enc1 = asn1_octetstring_encode(data1)
    ckb("kat1 total len",  bytes_len(enc1), 5)
    ckb("kat1 tag",        bytes_get(enc1, 0), 4)
    ckb("kat1 len byte",   bytes_get(enc1, 1), 3)
    ckb("kat1 content[0]", bytes_get(enc1, 2), 1)
    ckb("kat1 content[1]", bytes_get(enc1, 3), 2)
    ckb("kat1 content[2]", bytes_get(enc1, 4), 3)
    print("KAT 1 passed: encode([0x01,0x02,0x03]) == [0x04,0x03,0x01,0x02,0x03]")

    // ── KAT 2: encode empty == [0x04,0x00] ────────────────────────────────────
    let data2 = bytes(0)
    let enc2 = asn1_octetstring_encode(data2)
    ckb("kat2 total len", bytes_len(enc2), 2)
    ckb("kat2 tag",       bytes_get(enc2, 0), 4)
    ckb("kat2 len byte",  bytes_get(enc2, 1), 0)
    print("KAT 2 passed: encode(empty) == [0x04,0x00]")

    // ── KAT 3: encode 200-byte value; total len=203, starts [0x04,0x81,0xC8] ──
    // 200 == 0xC8.  Long form: 0x81 marker, then 0xC8.
    let data3 = bytes(200)
    let i3 = 0
    while i3 < 200
        bytes_set(data3, i3, i3 & 255)
        i3 = i3 + 1
    let enc3 = asn1_octetstring_encode(data3)
    ckb("kat3 total len",    bytes_len(enc3), 203)
    ckb("kat3 tag",          bytes_get(enc3, 0), 4)
    ckb("kat3 len hdr",      bytes_get(enc3, 1), 129)
    ckb("kat3 len byte",     bytes_get(enc3, 2), 200)
    ckb("kat3 first content",bytes_get(enc3, 3), 0)
    ckb("kat3 last content", bytes_get(enc3, 202), 199 & 255)
    print("KAT 3 passed: encode(200 bytes) starts [0x04,0x81,0xC8], total len=203")

    // ── KAT 4: decode [0x04,0x03,0x01,0x02,0x03] -> content=[1,2,3], next=5 ──
    let buf4 = bytes(5)
    bytes_set(buf4, 0, 4)
    bytes_set(buf4, 1, 3)
    bytes_set(buf4, 2, 1)
    bytes_set(buf4, 3, 2)
    bytes_set(buf4, 4, 3)
    let dec4 = asn1_octetstring_decode(buf4, 0)
    let content4 = dec4[0]
    let next4 = dec4[1]
    ckb("kat4 next_pos",     next4, 5)
    ckb("kat4 content len",  bytes_len(content4), 3)
    ckb("kat4 content[0]",   bytes_get(content4, 0), 1)
    ckb("kat4 content[1]",   bytes_get(content4, 1), 2)
    ckb("kat4 content[2]",   bytes_get(content4, 2), 3)
    print("KAT 4 passed: decode [0x04,0x03,...] -> content=[1,2,3], next_pos=5")

    // ── KAT 5: decode empty OCTET STRING [0x04,0x00] -> content=empty, next=2 ─
    let buf5 = bytes(2)
    bytes_set(buf5, 0, 4)
    bytes_set(buf5, 1, 0)
    let dec5 = asn1_octetstring_decode(buf5, 0)
    let content5 = dec5[0]
    let next5 = dec5[1]
    ckb("kat5 next_pos",    next5, 2)
    ckb("kat5 content len", bytes_len(content5), 0)
    print("KAT 5 passed: decode [0x04,0x00] -> empty content, next_pos=2")

    // ── KAT 6: round-trip 3-byte case ─────────────────────────────────────────
    let rt6 = asn1_octetstring_decode(enc1, 0)
    let rt6_content = rt6[0]
    let rt6_next = rt6[1]
    ckb("kat6 next_pos", rt6_next, 5)
    if _bytes_eq(rt6_content, data1) == 0
        print("FAIL asn1_octetstring kat6: round-trip 3-byte content mismatch")
        exit(1)
    print("KAT 6 passed: round-trip encode->decode recovers [0x01,0x02,0x03]")

    // ── KAT 7: round-trip 200-byte case ───────────────────────────────────────
    let rt7 = asn1_octetstring_decode(enc3, 0)
    let rt7_content = rt7[0]
    let rt7_next = rt7[1]
    ckb("kat7 next_pos", rt7_next, 203)
    if _bytes_eq(rt7_content, data3) == 0
        print("FAIL asn1_octetstring kat7: round-trip 200-byte content mismatch")
        exit(1)
    print("KAT 7 passed: round-trip encode->decode recovers 200-byte content")

    // ── KAT 8: decode wrong tag (0x02) -> safe stall [bytes(0), 0] ───────────
    let buf8 = bytes(3)
    bytes_set(buf8, 0, 2)
    bytes_set(buf8, 1, 1)
    bytes_set(buf8, 2, 0)
    let dec8 = asn1_octetstring_decode(buf8, 0)
    let content8 = dec8[0]
    let next8 = dec8[1]
    ckb("kat8 stall pos",    next8, 0)
    ckb("kat8 content empty",bytes_len(content8), 0)
    print("KAT 8 passed: wrong tag returns safe stall [bytes(0), pos]")

    // ── KAT 9: decode truncated buffer (tag present, declared len exceeds buf) ─
    // Build [0x04, 0x05] with only those 2 bytes — declares 5 content bytes not there.
    let buf9 = bytes(2)
    bytes_set(buf9, 0, 4)
    bytes_set(buf9, 1, 5)
    let dec9 = asn1_octetstring_decode(buf9, 0)
    let content9 = dec9[0]
    let next9 = dec9[1]
    ckb("kat9 stall pos",    next9, 0)
    ckb("kat9 content empty",bytes_len(content9), 0)
    print("KAT 9 passed: truncated buffer returns safe stall")

    // ── KAT 10: decode at non-zero offset ─────────────────────────────────────
    // Buffer: [0x00, 0x00, 0x00, 0x04, 0x03, 0x01, 0x02, 0x03]
    // TLV starts at pos=3; next_pos should be 8.
    let buf10 = bytes(8)
    bytes_set(buf10, 0, 0)
    bytes_set(buf10, 1, 0)
    bytes_set(buf10, 2, 0)
    bytes_set(buf10, 3, 4)
    bytes_set(buf10, 4, 3)
    bytes_set(buf10, 5, 1)
    bytes_set(buf10, 6, 2)
    bytes_set(buf10, 7, 3)
    let dec10 = asn1_octetstring_decode(buf10, 3)
    let content10 = dec10[0]
    let next10 = dec10[1]
    ckb("kat10 next_pos",    next10, 8)
    ckb("kat10 content len", bytes_len(content10), 3)
    ckb("kat10 content[0]",  bytes_get(content10, 0), 1)
    ckb("kat10 content[1]",  bytes_get(content10, 1), 2)
    ckb("kat10 content[2]",  bytes_get(content10, 2), 3)
    print("KAT 10 passed: decode at non-zero offset pos=3, next_pos=8")

    print("PASS _asn1_octetstring_test")
