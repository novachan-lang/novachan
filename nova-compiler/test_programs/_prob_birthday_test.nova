import std/probability/prob_birthday

// ckr — check fraction [num,den] matches expected wn/wd.
fn ckr(label: string, got, wn: int, wd: int)
    if got[0] != wn or got[1] != wd
        print("FAIL prob_birthday " + label + ": got=[" + str(got[0]) + "," + str(got[1]) + "] want=[" + str(wn) + "," + str(wd) + "]")
        exit(1)

// cki — check integer equality.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL prob_birthday " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // pbd_no_collision(365, 2) = (365*364)/(365^2) = 132860/133225 = 364/365
    let r1 = pbd_no_collision(365, 2)
    ckr("pbd_no_collision(365,2)", r1, 364, 365)

    // pbd_collision(365, 2) = 1 - 364/365 = 1/365
    let r2 = pbd_collision(365, 2)
    ckr("pbd_collision(365,2)", r2, 1, 365)

    // pbd_no_collision(6, 3) = (6*5*4)/(6^3) = 120/216 = 5/9
    let r3 = pbd_no_collision(6, 3)
    ckr("pbd_no_collision(6,3)", r3, 5, 9)

    // pbd_collision(6, 3) = 1 - 5/9 = 4/9
    let r4 = pbd_collision(6, 3)
    ckr("pbd_collision(6,3)", r4, 4, 9)

    // pbd_distinct_ways(6, 3) = 6*5*4 = 120
    cki("pbd_distinct_ways(6,3)", pbd_distinct_ways(6, 3), 120)

    // pbd_no_collision(365, 1) = 365/365 = 1/1
    let r6 = pbd_no_collision(365, 1)
    ckr("pbd_no_collision(365,1)", r6, 1, 1)

    // Edge: pbd_no_collision(365, 0) = [1,1] (no people, no collision possible)
    let r7 = pbd_no_collision(365, 0)
    ckr("pbd_no_collision(365,0)", r7, 1, 1)

    // Edge: pbd_no_collision(3, 4) = [0,1] (more people than days)
    let r8 = pbd_no_collision(3, 4)
    ckr("pbd_no_collision(3,4)=impossible", r8, 0, 1)

    // Edge: pbd_collision(3, 4) = [1,1]
    let r9 = pbd_collision(3, 4)
    ckr("pbd_collision(3,4)=certain", r9, 1, 1)

    // pbd_distinct_ways(5, 0) = 1 (empty product)
    cki("pbd_distinct_ways(5,0)", pbd_distinct_ways(5, 0), 1)

    // pbd_distinct_ways(5, 5) = 5! = 120
    cki("pbd_distinct_ways(5,5)", pbd_distinct_ways(5, 5), 120)

    // pbd_no_collision(4, 2) = (4*3)/(4^2) = 12/16 = 3/4
    let r12 = pbd_no_collision(4, 2)
    ckr("pbd_no_collision(4,2)", r12, 3, 4)

    print("PASS _prob_birthday_test")
