import forge_bipartite

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn expect_false(name: string, cond: bool) -> int
    if cond
        print("FAIL " + name + ": expected false")
        return 1
    0

// verify a coloring: no edge joins two same-colored nodes
fn valid_coloring(edges, color) -> bool
    let ok = true
    let i = 0
    while i < len(edges)
        let u = edges[i][0]
        let v = edges[i][1]
        if color[u] == color[v]
            ok = false
        i = i + 1
    ok

fn main()
    let fails = 0

    // even cycle a-b-c-d-a -> bipartite
    let even = [["a", "b"], ["b", "c"], ["c", "d"], ["d", "a"]]
    fails = fails + expect_true("even_cycle", is_bipartite(even))
    let ce = bipartite_coloring(even)
    fails = fails + expect_true("even_valid", valid_coloring(even, ce))

    // odd cycle (triangle) a-b-c-a -> NOT bipartite
    let tri = [["a", "b"], ["b", "c"], ["c", "a"]]
    fails = fails + expect_false("triangle", is_bipartite(tri))
    fails = fails + expect_true("triangle_null", bipartite_coloring(tri) == null)

    // 5-cycle (odd) -> not bipartite
    let five = [["a", "b"], ["b", "c"], ["c", "d"], ["d", "e"], ["e", "a"]]
    fails = fails + expect_false("five_cycle", is_bipartite(five))

    // tree -> bipartite
    let tree = [["r", "a"], ["r", "b"], ["a", "c"], ["a", "d"], ["b", "e"]]
    fails = fails + expect_true("tree", is_bipartite(tree))

    // classic bipartite: jobs {j1,j2} vs applicants {a1,a2,a3}
    let jobs = [["j1", "a1"], ["j1", "a2"], ["j2", "a2"], ["j2", "a3"]]
    fails = fails + expect_true("jobs", is_bipartite(jobs))
    let cj = bipartite_coloring(jobs)
    fails = fails + expect_true("jobs_valid", valid_coloring(jobs, cj))

    // disconnected: one bipartite component + one triangle -> NOT bipartite overall
    let disc = [["a", "b"], ["c", "d"], ["d", "e"], ["e", "c"]]
    fails = fails + expect_false("disconnected_with_odd", is_bipartite(disc))

    // disconnected all-bipartite
    let disc2 = [["a", "b"], ["c", "d"], ["e", "f"]]
    fails = fails + expect_true("disconnected_bipartite", is_bipartite(disc2))

    // single edge
    fails = fails + expect_true("single_edge", is_bipartite([["x", "y"]]))

    if fails == 0
        print("forge_bipartite: all passed")
    else
        print("forge_bipartite: " + str(fails) + " FAILED")
