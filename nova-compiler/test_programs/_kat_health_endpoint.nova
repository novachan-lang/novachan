import forge_health_endpoint

fn main()
    let h = he_new("my-service")
    assert(he_service_name(h) == "my-service", "service name")

    h = he_add_component(h, "database")
    h = he_add_component(h, "cache")
    assert(he_component_status(h, "database") == "up", "db up")
    assert(he_component_status(h, "cache") == "up", "cache up")
    assert(he_component_status(h, "missing") == "unknown", "missing unknown")

    let r1 = he_check(h)
    h = r1["h"]
    assert(r1["status"] == "up", "all up")
    assert(he_total_checks(h) == 1, "1 check")

    h = he_set_status(h, "database", "down", "connection refused")
    assert(he_component_status(h, "database") == "down", "db down")

    let r2 = he_check(h)
    h = r2["h"]
    assert(he_total_checks(h) == 2, "2 checks")

    h = he_set_status(h, "database", "up", "")
    let r3 = he_check(h)
    h = r3["h"]
    assert(he_total_checks(h) == 3, "3 checks")

    print("HEALTH-ENDPOINT KAT PASS")
