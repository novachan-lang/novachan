// KAT probe for std/data/sub_convert
// Spec:
//   srt_to_vtt of 1-cue SRT starts "WEBVTT" and contains "00:00:01.000 --> 00:00:04.000"
//   vtt_to_srt(srt_to_vtt(srt)) recovers start=1000,end=4000,text="Hi"
//   detect_format(srt) == "srt"
import std/data/sub_convert

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn _starts_with(s: string, prefix: string) -> int
    let result = 0
    if len(s) >= len(prefix)
        if slice(s, 0, len(prefix)) == prefix
            result = 1
    result

fn _contains(s: string, sub: string) -> int
    let n = len(s)
    let m = len(sub)
    let found = 0
    let i = 0
    while i <= n - m
        if slice(s, i, i + m) == sub
            found = 1
            i = n
        i = i + 1
    found

fn main()
    let nl = chr(10)

    // Build a 1-cue SRT: "1\n00:00:01,000 --> 00:00:04,000\nHi\n"
    let srt_timing = "00:00:01,000 --> 00:00:04,000"
    let srt = "1" + nl + srt_timing + nl + "Hi" + nl

    // ── KAT 1: detect_format SRT ─────────────────────────────────────────────
    cks("kat1-detect-srt", detect_format(srt), "srt")
    print("KAT 1 PASS: detect_format(srt)==srt")

    // ── KAT 2: detect_format VTT ─────────────────────────────────────────────
    let vtt_timing = "00:00:01.000 --> 00:00:04.000"
    let vtt = "WEBVTT" + nl + nl + vtt_timing + nl + "Hi" + nl
    cks("kat2-detect-vtt", detect_format(vtt), "vtt")
    print("KAT 2 PASS: detect_format(vtt)==vtt")

    // ── KAT 3: detect_format unknown ─────────────────────────────────────────
    cks("kat3-detect-unk", detect_format("hello world"), "unknown")
    print("KAT 3 PASS: detect_format unknown")

    // ── KAT 4: srt_to_vtt starts with WEBVTT ────────────────────────────────
    let converted = srt_to_vtt(srt)
    cki("kat4-starts-webvtt", _starts_with(converted, "WEBVTT"), 1)
    print("KAT 4 PASS: srt_to_vtt starts with WEBVTT")

    // ── KAT 5: srt_to_vtt contains dot timecode ──────────────────────────────
    cki("kat5-dot-timing", _contains(converted, "00:00:01.000 --> 00:00:04.000"), 1)
    print("KAT 5 PASS: srt_to_vtt contains dot timing")

    // ── KAT 6: vtt_to_srt round-trip via srt_to_vtt ─────────────────────────
    // vtt_to_srt(srt_to_vtt(srt)) should produce SRT with comma timing
    let back = vtt_to_srt(converted)
    cki("kat6-comma-timing", _contains(back, "00:00:01,000 --> 00:00:04,000"), 1)
    print("KAT 6 PASS: vtt_to_srt produces comma timing")

    // ── KAT 7: full round-trip text preserved ────────────────────────────────
    cki("kat7-rt-text", _contains(back, "Hi"), 1)
    print("KAT 7 PASS: round-trip preserves text")

    // ── KAT 8: vtt_to_srt on VTT document produces SRT ──────────────────────
    let srt_out = vtt_to_srt(vtt)
    cki("kat8-vtt-to-srt-comma", _contains(srt_out, "00:00:01,000 --> 00:00:04,000"), 1)
    cki("kat8-vtt-to-srt-text",  _contains(srt_out, "Hi"), 1)
    print("KAT 8 PASS: vtt_to_srt from VTT doc")

    // ── KAT 9: multi-cue convert ─────────────────────────────────────────────
    let srt2tc1 = "00:00:01,000 --> 00:00:04,000"
    let srt2tc2 = "00:00:05,500 --> 00:00:08,200"
    let srt2 = "1" + nl + srt2tc1 + nl + "Hello" + nl + nl + "2" + nl + srt2tc2 + nl + "World" + nl
    let vtt2 = srt_to_vtt(srt2)
    cki("kat9-multi-webvtt",  _starts_with(vtt2, "WEBVTT"), 1)
    cki("kat9-multi-tc1", _contains(vtt2, "00:00:01.000 --> 00:00:04.000"), 1)
    cki("kat9-multi-tc2", _contains(vtt2, "00:00:05.500 --> 00:00:08.200"), 1)
    cki("kat9-multi-hello", _contains(vtt2, "Hello"), 1)
    cki("kat9-multi-world", _contains(vtt2, "World"), 1)
    print("KAT 9 PASS: multi-cue srt_to_vtt")

    // ── KAT 10: detect after conversion ─────────────────────────────────────
    cks("kat10-detect-vtt2", detect_format(vtt2), "vtt")
    print("KAT 10 PASS: detect_format on converted doc")

    print("PASS _sub_convert_test")
