// _kat_enc_ds_3 — combined KAT for 6 new pure-NOVA stdlib modules:
//   std/collections/red_black_tree.nova  (rbt_)
//   std/encoding/bech32.nova             (bch_)
//   std/text/diff_patch.nova             (dfp_)
//   std/data/json_patch.nova             (jsp_)
//   std/algo/sparse_matrix.nova          (csr_)
//   std/scheduling/leaky_bucket.nova     (lkb_)

import std/collections/red_black_tree
import std/encoding/bech32
import std/text/diff_patch
import std/data/json_patch
import std/algo/sparse_matrix
import std/scheduling/leaky_bucket

fn ck(name, got, want)
    if str(got) != str(want)
        print("FAIL " + name + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("ok " + name)

// ---------------------------------------------------------------------
// red_black_tree
// ---------------------------------------------------------------------
fn test_red_black_tree()
    let t = rbt_new()
    ck("rbt_size_empty", rbt_size(t), 0)
    ck("rbt_contains_empty", rbt_contains(t, 5), false)

    let vals = [50, 30, 70, 20, 40, 60, 80, 10, 25, 35, 45, 55, 65, 75, 85, 5, 15]
    let i = 0
    while i < len(vals)
        rbt_insert(t, vals[i])
        i = i + 1
    ck("rbt_size_after_insert", rbt_size(t), len(vals))

    // every inserted value must be found
    let all_found = true
    let j = 0
    while j < len(vals)
        if rbt_contains(t, vals[j]) == false
            all_found = false
        j = j + 1
    ck("rbt_all_found", all_found, true)

    ck("rbt_contains_absent", rbt_contains(t, 999), false)
    ck("rbt_min", rbt_min(t), 5)
    ck("rbt_max", rbt_max(t), 85)

    // inorder must be fully sorted and match input set size
    let order = rbt_inorder(t)
    ck("rbt_inorder_len", len(order), len(vals))
    let sorted_ok = true
    let k = 1
    while k < len(order)
        if order[k - 1] >= order[k]
            sorted_ok = false
        k = k + 1
    ck("rbt_inorder_sorted", sorted_ok, true)

    // duplicate insert is a no-op
    rbt_insert(t, 50)
    ck("rbt_size_dup_noop", rbt_size(t), len(vals))

    // balance invariant: every root-to-null path has the same black-height
    // (rbt_black_height reports the LEFTMOST path's count; if the LLRB
    // invariants were violated this wouldn't equal a consistent value —
    // we additionally cross-check by height <= 2*log2(n+1))
    let bh = rbt_black_height(t)
    ck("rbt_black_height_positive", bh > 0, true)
    let h = rbt_height(t)
    // for n=17 nodes, LLRB guarantees height <= 2*log2(n+1) ~= 2*4.17 ~= 8.3
    ck("rbt_height_bounded", h <= 9, true)

    // delete leaves, then internal nodes, verifying sortedness + membership
    // after every removal
    rbt_delete(t, 5)
    ck("rbt_size_after_del1", rbt_size(t), len(vals) - 1)
    ck("rbt_contains_after_del1", rbt_contains(t, 5), false)
    ck("rbt_contains_neighbor_after_del1", rbt_contains(t, 10), true)

    rbt_delete(t, 50)  // delete the (former) root, forces successor promotion
    ck("rbt_size_after_del_root", rbt_size(t), len(vals) - 2)
    ck("rbt_contains_after_del_root", rbt_contains(t, 50), false)

    // delete absent value: no-op
    rbt_delete(t, 999)
    ck("rbt_size_noop_del_absent", rbt_size(t), len(vals) - 2)

    // drain the rest via repeated delete-min (rbt_min + rbt_delete),
    // verifying strictly increasing extraction order == a full sort
    let remaining = rbt_inorder(t)
    let drained = []
    while rbt_size(t) > 0
        let mn = rbt_min(t)
        drained.push(mn)
        rbt_delete(t, mn)
    ck("rbt_drain_count", len(drained), len(remaining))
    let drain_sorted = true
    let dk = 1
    while dk < len(drained)
        if drained[dk - 1] >= drained[dk]
            drain_sorted = false
        dk = dk + 1
    ck("rbt_drain_sorted", drain_sorted, true)
    ck("rbt_size_after_drain", rbt_size(t), 0)

// ---------------------------------------------------------------------
// bech32
// ---------------------------------------------------------------------
fn test_bech32()
    // BIP-0173 official test vector: "A12UEL5L" is a valid Bech32 string
    // with an empty data payload and hrp "a".
    let d1 = bch_decode("A12UEL5L")
    ck("bch_decode_official_ok", d1["bch_ok"], true)
    ck("bch_decode_official_hrp", d1["bch_hrp"], "a")
    ck("bch_decode_official_data_len", bytes_len(d1["bch_data"]), 0)

    // round-trip: encode arbitrary payload bytes, decode back
    let payload = bytes(0)
    payload = bytes_append(payload, 0)
    payload = bytes_append(payload, 202)
    payload = bytes_append(payload, 254)
    let enc = bch_encode("bc", payload)
    let dec = bch_decode(enc)
    ck("bch_roundtrip_ok", dec["bch_ok"], true)
    ck("bch_roundtrip_hrp", dec["bch_hrp"], "bc")
    ck("bch_roundtrip_len", bytes_len(dec["bch_data"]), bytes_len(payload))
    ck("bch_roundtrip_b0", bytes_get(dec["bch_data"], 0), 0)
    ck("bch_roundtrip_b1", bytes_get(dec["bch_data"], 1), 202)
    ck("bch_roundtrip_b2", bytes_get(dec["bch_data"], 2), 254)

    // case-insensitivity: uppercase of a valid encoding must also decode
    let enc_upper = upper(enc)
    let dec_upper = bch_decode(enc_upper)
    ck("bch_uppercase_ok", dec_upper["bch_ok"], true)
    ck("bch_uppercase_hrp", dec_upper["bch_hrp"], "bc")

    // corrupted checksum must be rejected
    let corrupted = slice(enc, 0, len(enc) - 1) + "x"
    let dec_bad = bch_decode(corrupted)
    ck("bch_corrupted_rejected", dec_bad["bch_ok"], false)

    // bech32m round-trip with a different constant — must NOT cross-validate
    // against the plain bech32 decoder
    let enc_m = bch_encode_m("bc", payload)
    let dec_m = bch_decode_m(enc_m)
    ck("bch_m_roundtrip_ok", dec_m["bch_ok"], true)
    ck("bch_m_roundtrip_hrp", dec_m["bch_hrp"], "bc")
    let cross = bch_decode(enc_m)
    ck("bch_m_not_bech32", cross["bch_ok"], false)

    // empty payload round-trip
    let empty_payload = bytes(0)
    let enc_empty = bch_encode("x", empty_payload)
    let dec_empty = bch_decode(enc_empty)
    ck("bch_empty_payload_ok", dec_empty["bch_ok"], true)
    ck("bch_empty_payload_len", bytes_len(dec_empty["bch_data"]), 0)

// ---------------------------------------------------------------------
// diff_patch
// ---------------------------------------------------------------------
fn test_diff_patch()
    let a = ["one", "two", "three", "four"]
    let b = ["one", "three", "four", "five"]
    let ops = dfp_diff(a, b)

    // rebuilding b from the ops must reproduce b exactly
    let rebuilt_b = dfp_apply(ops)
    ck("dfp_apply_len", len(rebuilt_b), len(b))
    let bi = 0
    let b_match = true
    while bi < len(b)
        if rebuilt_b[bi] != b[bi]
            b_match = false
        bi = bi + 1
    ck("dfp_apply_matches_b", b_match, true)

    // rebuilding a from the ops must reproduce a exactly
    let rebuilt_a = dfp_source(ops)
    ck("dfp_source_len", len(rebuilt_a), len(a))
    let ai = 0
    let a_match = true
    while ai < len(a)
        if rebuilt_a[ai] != a[ai]
            a_match = false
        ai = ai + 1
    ck("dfp_source_matches_a", a_match, true)

    // "two" was removed, "five" was added -> exactly 1 del, 1 ins
    let stats = dfp_stats(ops)
    ck("dfp_stats_del", stats["del"], 1)
    ck("dfp_stats_ins", stats["ins"], 1)
    ck("dfp_stats_eq", stats["eq"], 3)

    // identical inputs -> no del/ins at all, pure eq
    let ops_same = dfp_diff(a, a)
    let stats_same = dfp_stats(ops_same)
    ck("dfp_identical_no_del", stats_same["del"], 0)
    ck("dfp_identical_no_ins", stats_same["ins"], 0)
    ck("dfp_identical_all_eq", stats_same["eq"], len(a))
    ck("dfp_identical_true", dfp_identical(a, a), true)
    ck("dfp_identical_false", dfp_identical(a, b), false)

    // LCS length: "one","three","four" are common in order -> 3
    ck("dfp_lcs_len", dfp_lcs_len(a, b), 3)

    // totally disjoint lists: LCS 0, every line is a del/ins
    let x = ["aa", "bb"]
    let y = ["cc", "dd", "ee"]
    ck("dfp_disjoint_lcs", dfp_lcs_len(x, y), 0)
    let ops_disjoint = dfp_diff(x, y)
    let stats_disjoint = dfp_stats(ops_disjoint)
    ck("dfp_disjoint_del", stats_disjoint["del"], 2)
    ck("dfp_disjoint_ins", stats_disjoint["ins"], 3)

    // unified rendering: sanity check it's non-empty and line-count matches
    let uni = dfp_unified(a, b)
    let uni_lines = split(uni, "\n")
    ck("dfp_unified_line_count", len(uni_lines), len(ops))

    // empty vs empty
    let empty_ops = dfp_diff([], [])
    ck("dfp_empty_ops_len", len(empty_ops), 0)
    ck("dfp_empty_identical", dfp_identical([], []), true)

// ---------------------------------------------------------------------
// json_patch
// ---------------------------------------------------------------------
fn test_json_patch()
    // "add" a new key into a dict
    let doc1 = {}
    doc1["a"] = 1
    let patch1 = [jsp_op("add", "/b", 2)]
    let r1 = jsp_apply(doc1, patch1)
    ck("jsp_add_key_ok", r1["jsp_ok"], true)
    ck("jsp_add_key_value", doc1["b"], 2)
    ck("jsp_add_key_untouched", doc1["a"], 1)

    // "add" into a nested list, "-" appends
    let doc2 = {}
    doc2["items"] = [10, 20, 30]
    let patch2 = [jsp_op("add", "/items/-", 40), jsp_op("add", "/items/0", 5)]
    let r2 = jsp_apply(doc2, patch2)
    ck("jsp_add_list_ok", r2["jsp_ok"], true)
    let items2 = doc2["items"]
    ck("jsp_add_list_len", len(items2), 5)
    ck("jsp_add_list_front", items2[0], 5)
    ck("jsp_add_list_orig0", items2[1], 10)
    ck("jsp_add_list_appended", items2[4], 40)

    // "replace"
    let doc3 = {}
    doc3["x"] = "old"
    let patch3 = [jsp_op("replace", "/x", "new")]
    let r3 = jsp_apply(doc3, patch3)
    ck("jsp_replace_ok", r3["jsp_ok"], true)
    ck("jsp_replace_value", doc3["x"], "new")

    // "replace" on a missing key must fail
    let doc3b = {}
    let patch3b = [jsp_op("replace", "/missing", 1)]
    let r3b = jsp_apply(doc3b, patch3b)
    ck("jsp_replace_missing_fails", r3b["jsp_ok"], false)

    // "remove" a dict key
    let doc4 = {}
    doc4["keep"] = 1
    doc4["drop"] = 2
    let patch4 = [jsp_op_remove("/drop")]
    let r4 = jsp_apply(doc4, patch4)
    ck("jsp_remove_key_ok", r4["jsp_ok"], true)
    ck("jsp_remove_key_gone", contains(doc4, "drop"), false)
    ck("jsp_remove_key_kept", doc4["keep"], 1)

    // "remove" a list element (middle), order preserved
    let doc5 = {}
    doc5["arr"] = [1, 2, 3, 4]
    let patch5 = [jsp_op_remove("/arr/1")]
    let r5 = jsp_apply(doc5, patch5)
    ck("jsp_remove_list_ok", r5["jsp_ok"], true)
    let arr5 = doc5["arr"]
    ck("jsp_remove_list_len", len(arr5), 3)
    ck("jsp_remove_list_0", arr5[0], 1)
    ck("jsp_remove_list_1", arr5[1], 3)
    ck("jsp_remove_list_2", arr5[2], 4)

    // "move"
    let doc6 = {}
    doc6["from_here"] = 99
    let patch6 = [jsp_op_from("move", "/to_there", "/from_here")]
    let r6 = jsp_apply(doc6, patch6)
    ck("jsp_move_ok", r6["jsp_ok"], true)
    ck("jsp_move_dest", doc6["to_there"], 99)
    ck("jsp_move_src_gone", contains(doc6, "from_here"), false)

    // "copy"
    let doc7 = {}
    doc7["orig"] = 7
    let patch7 = [jsp_op_from("copy", "/dup", "/orig")]
    let r7 = jsp_apply(doc7, patch7)
    ck("jsp_copy_ok", r7["jsp_ok"], true)
    ck("jsp_copy_dest", doc7["dup"], 7)
    ck("jsp_copy_src_kept", doc7["orig"], 7)

    // "test" passing and failing
    let doc8 = {}
    doc8["v"] = 42
    let patch8ok = [jsp_op("test", "/v", 42)]
    let r8ok = jsp_apply(doc8, patch8ok)
    ck("jsp_test_pass", r8ok["jsp_ok"], true)

    let patch8bad = [jsp_op("test", "/v", 43)]
    let r8bad = jsp_apply(doc8, patch8bad)
    ck("jsp_test_fail", r8bad["jsp_ok"], false)

    // multi-op patch applied in order; a failing op stops the sequence
    let doc9 = {}
    doc9["n"] = 1
    let patch9 = [jsp_op("replace", "/n", 2), jsp_op("replace", "/missing2", 9), jsp_op("replace", "/n", 999)]
    let r9 = jsp_apply(doc9, patch9)
    ck("jsp_stops_on_failure", r9["jsp_ok"], false)
    // op0 succeeded (n=2) before op1 failed; op2 never ran (n stays 2)
    ck("jsp_partial_progress_kept", doc9["n"], 2)

// ---------------------------------------------------------------------
// sparse_matrix
// ---------------------------------------------------------------------
fn test_sparse_matrix()
    let dense = [
        [0, 0, 3, 0],
        [4, 0, 0, 0],
        [0, 0, 0, 0],
        [0, 5, 0, 6]
    ]
    let m = csr_from_dense(dense)
    ck("csr_nnz", csr_nnz(m), 4)
    ck("csr_row_nnz_0", csr_row_nnz(m, 0), 1)
    ck("csr_row_nnz_1", csr_row_nnz(m, 1), 1)
    ck("csr_row_nnz_2", csr_row_nnz(m, 2), 0)
    ck("csr_row_nnz_3", csr_row_nnz(m, 3), 2)

    ck("csr_get_02", csr_get(m, 0, 2), 3)
    ck("csr_get_10", csr_get(m, 1, 0), 4)
    ck("csr_get_absent", csr_get(m, 0, 0), 0)
    ck("csr_get_33", csr_get(m, 3, 3), 6)

    // to_dense round-trip must reproduce the original matrix exactly
    let back = csr_to_dense(m)
    let match_ok = true
    let r = 0
    while r < 4
        let c = 0
        while c < 4
            if back[r][c] != dense[r][c]
                match_ok = false
            c = c + 1
        r = r + 1
    ck("csr_dense_roundtrip", match_ok, true)

    // csr_set: overwrite an existing entry
    csr_set(m, 0, 2, 30)
    ck("csr_set_overwrite", csr_get(m, 0, 2), 30)
    ck("csr_set_overwrite_nnz_unchanged", csr_nnz(m), 4)

    // csr_set: insert a brand-new entry into a previously empty row
    csr_set(m, 2, 1, 99)
    ck("csr_set_insert", csr_get(m, 2, 1), 99)
    ck("csr_set_insert_nnz", csr_nnz(m), 5)
    ck("csr_set_insert_row_nnz", csr_row_nnz(m, 2), 1)

    // csr_set: remove an entry by setting it to 0
    csr_set(m, 1, 0, 0)
    ck("csr_set_remove", csr_get(m, 1, 0), 0)
    ck("csr_set_remove_nnz", csr_nnz(m), 4)
    ck("csr_set_remove_row_nnz", csr_row_nnz(m, 1), 0)

    // mat-vec product on the ORIGINAL dense matrix values
    let m2 = csr_from_dense(dense)
    let vec = [1, 2, 3, 4]
    // row0: 3*3=9 ; row1: 4*1=4 ; row2: 0 ; row3: 5*2 + 6*4 = 10+24=34
    let mv = csr_mul_vec(m2, vec)
    ck("csr_mul_vec_len", len(mv), 4)
    ck("csr_mul_vec_0", mv[0], 9)
    ck("csr_mul_vec_1", mv[1], 4)
    ck("csr_mul_vec_2", mv[2], 0)
    ck("csr_mul_vec_3", mv[3], 34)

    // transpose: (r,c) of m2 must equal (c,r) of transpose
    let mt = csr_transpose(m2)
    ck("csr_transpose_02_becomes_20", csr_get(mt, 2, 0), 3)
    ck("csr_transpose_10_becomes_01", csr_get(mt, 0, 1), 4)
    ck("csr_transpose_31_becomes_13", csr_get(mt, 1, 3), 5)
    ck("csr_transpose_33_stays_33", csr_get(mt, 3, 3), 6)
    ck("csr_transpose_nnz_preserved", csr_nnz(mt), csr_nnz(m2))

    // empty matrix
    let empty_dense = [[0, 0], [0, 0]]
    let em = csr_from_dense(empty_dense)
    ck("csr_empty_nnz", csr_nnz(em), 0)
    ck("csr_empty_get", csr_get(em, 0, 0), 0)

// ---------------------------------------------------------------------
// leaky_bucket
// ---------------------------------------------------------------------
fn test_leaky_bucket()
    // capacity 100, leaks 10 units per time-unit
    let b = lkb_new(100, 10)
    ck("lkb_capacity", lkb_capacity(b), 100)
    ck("lkb_initial_level", lkb_level(b, 0), 0)

    // fill to exactly capacity at t=0
    ck("lkb_fill_to_cap", lkb_allow(b, 0, 100), true)
    ck("lkb_level_after_fill", lkb_level(b, 0), 100)

    // immediately over capacity -> rejected, level unchanged
    ck("lkb_reject_overflow", lkb_allow(b, 0, 1), false)
    ck("lkb_level_after_reject", lkb_level(b, 0), 100)

    // after 5 time-units, 50 units have leaked out -> level 50
    ck("lkb_level_after_leak", lkb_level(b, 5), 50)

    // now 40 more units fit (50+40=90 <= 100)
    ck("lkb_admit_after_leak", lkb_allow(b, 5, 40), true)
    ck("lkb_level_after_admit", lkb_level(b, 5), 90)

    // fully drain: 90 units at 10/unit-time needs 9 more time-units -> t=14
    ck("lkb_level_fully_drained", lkb_level(b, 14), 0)

    // draining never goes negative even far in the future
    ck("lkb_level_far_future_floor", lkb_level(b, 1000), 0)

    // a fresh bucket admits exactly up to capacity, in multiple pieces
    let b2 = lkb_new(50, 1)
    ck("lkb_partial_1", lkb_allow(b2, 0, 20), true)
    ck("lkb_partial_2", lkb_allow(b2, 0, 20), true)
    ck("lkb_partial_3_fits_exactly", lkb_allow(b2, 0, 10), true)
    ck("lkb_partial_4_overflow", lkb_allow(b2, 0, 1), false)
    ck("lkb_partial_level", lkb_level(b2, 0), 50)

    // lkb_reset
    lkb_reset(b2)
    ck("lkb_reset_level", lkb_level(b2, 0), 0)
    // reset also rewinds the clock to 0: an earlier "now" than the bucket
    // had previously observed should be treated as no-elapsed-time, not a
    // negative leak
    ck("lkb_reset_allows_reuse", lkb_allow(b2, 0, 50), true)

fn main()
    test_red_black_tree()
    test_bech32()
    test_diff_patch()
    test_json_patch()
    test_sparse_matrix()
    test_leaky_bucket()
    print("ALL PASS")

main()
