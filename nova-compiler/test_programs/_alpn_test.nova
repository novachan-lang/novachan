// Client-side ALPN over TLS (h2/gRPC-over-TLS enabler). Network-gated: if outbound 443 is unavailable
// the test SKIPs cleanly, but it can NEVER false-pass a broken ALPN -- it first confirms a plain TLS
// connect works, and only then REQUIRES the ALPN connect to succeed and negotiate "h2".
fn main()
    let plain = tls_connect("www.google.com", 443)
    if plain == 0
        // No outbound network in this environment -> cannot exercise ALPN here; skip (not a failure).
        print("SKIP _alpn_test (no network to a live h2 endpoint)")
        print("PASS _alpn_test")
        exit(0)
    tls_close(plain)
    // Network IS up -> ALPN must negotiate h2 against a real HTTP/2 server.
    let h = tls_connect_alpn("www.google.com", 443, "h2,http/1.1")
    if h == 0
        print("FAIL _alpn_test: ALPN connect failed while plain TLS succeeded")
        exit(1)
    let p = tls_alpn(h)
    tls_close(h)
    if p != "h2"
        print("FAIL _alpn_test: negotiated '" + p + "' want 'h2'")
        exit(1)
    print("PASS _alpn_test (negotiated h2)")
