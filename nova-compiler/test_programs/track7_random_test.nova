import random

fn main()
    // Create seeded RNG
    let rng = random.rng_new(42)

    // Generate integers
    let v1 = random.rng_int(rng, 1, 100)
    if v1 < 1 or v1 > 100
        print("FAIL: rng_int out of range")
        exit(1)

    // Generate float
    let f1 = random.rng_float(rng)
    if f1 < 0.0 or f1 > 1.0
        print("FAIL: rng_float out of [0,1]")
        exit(1)

    // Determinism: same seed should give same sequence
    let rng2 = random.rng_new(42)
    let v2 = random.rng_int(rng2, 1, 100)
    assert_eq(v1, v2)

    // Choice
    let items = ["a", "b", "c", "d"]
    let choice = random.rng_choice(rng, items)
    if len(str(choice)) == 0
        print("FAIL: rng_choice returned empty")
        exit(1)

    // Shuffle
    let nums = [1, 2, 3, 4, 5]
    let shuffled = random.rng_shuffle(rng, nums)
    assert_eq(len(shuffled), 5)

    // Sample
    let sampled = random.rng_sample(rng, nums, 3)
    assert_eq(len(sampled), 3)

    // Gaussian
    let g1 = random.rng_gauss(rng, 0.0, 1.0)
    if g1 < -10.0 or g1 > 10.0
        print("FAIL: rng_gauss wildly out of range")
        exit(1)

    print("TRACK 7 RANDOM TEST PASSED")
