import forge_model_registry

fn main()
    let r = mr_new()
    assert(mr_model_count(r) == 0, "0 models initially")
    assert(mr_has_model(r, "fraud_detector") == 0, "no model yet")

    let r1 = mr_register(r, "fraud_detector", 1, "acc=0.90,f1=0.88")
    assert(mr_model_count(r1) == 1, "1 model after first register")
    assert(mr_has_model(r1, "fraud_detector") == 1, "model exists now")

    let r2 = mr_register(r1, "fraud_detector", 2, "acc=0.93,f1=0.91")
    assert(mr_model_count(r2) == 1, "still 1 model (same name, new version)")

    let r3 = mr_register(r2, "churn_predictor", 1, "acc=0.80,f1=0.75")
    assert(mr_model_count(r3) == 2, "2 models now")

    let latest = mr_latest(r3, "fraud_detector")
    assert(is_ok(latest), "latest ok")
    assert(unwrap(latest) == 2, "latest version is 2")

    let vc = mr_version_count(r3, "fraud_detector")
    assert(is_ok(vc), "version count ok")
    assert(unwrap(vc) == 2, "2 versions for fraud_detector")

    let m1 = mr_metrics(r3, "fraud_detector", 1)
    assert(is_ok(m1), "metrics v1 ok")
    assert(unwrap(m1) == "acc=0.90,f1=0.88", "metrics v1 match")

    let m2 = mr_metrics(r3, "fraud_detector", 2)
    assert(unwrap(m2) == "acc=0.93,f1=0.91", "metrics v2 match")

    assert(is_err(mr_metrics(r3, "fraud_detector", 99)), "unknown version errors")
    assert(is_err(mr_latest(r3, "unknown_model")), "unknown model latest errors")
    assert(is_err(mr_production(r3, "fraud_detector")), "no production yet errors")

    let promoted = mr_promote(r3, "fraud_detector", 2)
    assert(is_ok(promoted), "promote ok")
    assert(unwrap(promoted) == 2, "promoted version 2")

    let prod = mr_production(r3, "fraud_detector")
    assert(is_ok(prod), "production ok")
    assert(unwrap(prod) == 2, "production version is 2")

    assert(is_err(mr_promote(r3, "fraud_detector", 99)), "promote unknown version errors")
    assert(is_err(mr_promote(r3, "unknown_model", 1)), "promote unknown model errors")

    print("MODEL-REGISTRY KAT PASS")
