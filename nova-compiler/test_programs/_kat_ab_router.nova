import forge_ab_router

fn main()
    let a = ab_new(50)

    let r1 = ab_route(a, 25)
    a = r1["a"]
    assert(r1["variant"] == "A", "25 -> A")

    let r2 = ab_route(a, 75)
    a = r2["a"]
    assert(r2["variant"] == "B", "75 -> B")

    let r3 = ab_route(a, 10)
    a = r3["a"]
    let r4 = ab_route(a, 90)
    a = r4["a"]

    assert(ab_a_count(a) == 2, "2 A")
    assert(ab_b_count(a) == 2, "2 B")
    assert(ab_total_traffic(a) == 4, "4 total")

    a = ab_convert(a, "A")
    a = ab_convert(a, "A")
    a = ab_convert(a, "B")
    assert(ab_a_rate(a) == 100, "A 100% convert")
    assert(ab_b_rate(a) == 50, "B 50% convert")
    assert(ab_winner(a) == "A", "A wins")

    print("AB-ROUTER KAT PASS")
