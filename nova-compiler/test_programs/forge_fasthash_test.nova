import forge_fasthash

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // FNV-1a 32-bit canonical vectors
    fails = fails + expect("fnv_empty", str(fnv1a_32("")), "2166136261")
    fails = fails + expect("fnv_a", str(fnv1a_32("a")), "3826002220")
    fails = fails + expect("fnv_foobar", str(fnv1a_32("foobar")), "3214735720")
    // determinism + non-triviality
    fails = fails + expect("fnv_det", str(fnv1a_32("hello") == fnv1a_32("hello")), "1")
    fails = fails + expect("fnv_diff", str(fnv1a_32("hello") == fnv1a_32("world")), "0")

    // djb2 exact small values
    fails = fails + expect("djb2_empty", str(djb2("")), "5381")
    fails = fails + expect("djb2_a", str(djb2("a")), "177670")
    fails = fails + expect("djb2_hi", str(djb2("hi")), "5863446")

    // sdbm exact small values
    fails = fails + expect("sdbm_empty", str(sdbm("")), "0")
    fails = fails + expect("sdbm_a", str(sdbm("a")), "97")
    fails = fails + expect("sdbm_hi", str(sdbm("hi")), "6822401")

    // all hashes stay within 32-bit range (non-negative)
    fails = fails + expect("fnv_range", str(fnv1a_32("a long-ish string to force many multiplies") >= 0), "1")
    fails = fails + expect("fnv_range2", str(fnv1a_32("another quite long test string here!!") < 4294967296), "1")

    // hash_combine is order-sensitive (good for tuple hashing) and deterministic
    let ab = hash_combine(hash_combine(0, 1), 2)
    let ba = hash_combine(hash_combine(0, 2), 1)
    fails = fails + expect("combine_order", str(ab == ba), "0")
    fails = fails + expect("combine_det", str(hash_combine(hash_combine(0, 1), 2) == ab), "1")
    fails = fails + expect("combine_range", str(ab >= 0), "1")

    // hash_bucket stays in range
    let allin = 1
    let i = 0
    while i < 20
        let b = hash_bucket("key" + str(i), 8)
        if b < 0 or b >= 8
            allin = 0
        i = i + 1
    fails = fails + expect("bucket_range", str(allin), "1")

    if fails == 0
        print("forge_fasthash: all passed")
    else
        print("forge_fasthash: " + str(fails) + " FAILED")
