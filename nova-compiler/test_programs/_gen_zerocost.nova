// 3.3 — is an ERASED generic actually zero-cost vs a concrete typed fn?
// NOVA does type ERASURE (one i64-shaped fn), not monomorphization, so the honest
// question is not "does it monomorphize" but "does erasure cost anything at runtime".
//
// v2: the v1 int loop measured 0ms/0ms because LLVM constant-folded the whole loop
// away. Every input below is derived from time_ms() so the optimizer cannot know it,
// and every accumulator is printed so the loop cannot be dead-coded.

fn gadd(a, b)                       // generic: params untyped -> erased
    a + b

fn iadd(a: int, b: int) -> int      // concrete: fully typed
    a + b

fn gmul(a, b)
    a * b

fn fmul_c(a: float, b: float) -> float
    a * b

fn main()
    let seed = time_ms() % 7 + 1        // runtime-unknown: blocks constant folding
    let n = 20000000

    let t0 = time_ms()
    let acc_g = 0
    let i = 0
    while i < n
        acc_g = gadd(acc_g, i * seed)
        i = i + 1
    let t_generic = time_ms() - t0

    let t1 = time_ms()
    let acc_c = 0
    let j = 0
    while j < n
        acc_c = iadd(acc_c, j * seed)
        j = j + 1
    let t_concrete = time_ms() - t1

    assert(acc_g == acc_c, "generic and concrete must agree")
    print("int   generic=" + str(t_generic) + "ms concrete=" + str(t_concrete) + "ms acc=" + str(acc_g))

    // float path — this is where erasure is expected to COST (boxing at any-widen)
    let fseed = 1.0 + float(seed) * 0.0000001
    let fn_iters = 20000000

    let t2 = time_ms()
    let fg = 1.0
    let k = 0
    while k < fn_iters
        fg = gmul(fg, fseed)
        k = k + 1
    let t_fgen = time_ms() - t2

    let t3 = time_ms()
    let fc = 1.0
    let m = 0
    while m < fn_iters
        fc = fmul_c(fc, fseed)
        m = m + 1
    let t_fcon = time_ms() - t3

    print("float generic=" + str(t_fgen) + "ms concrete=" + str(t_fcon) + "ms fg=" + str(fg) + " fc=" + str(fc))
    print("OK")
