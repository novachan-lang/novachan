import std/collections/indexmap

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + got + " want " + want)
        exit(1)

fn main()
    // Build: insert c, a, b in that order
    let im = im_new()
    im_set(im, "c", 30)
    im_set(im, "a", 10)
    im_set(im, "b", 20)

    // im_len -> 3
    cki("len", im_len(im), 3)

    // im_keys insertion order = ["c","a","b"]
    let ks = im_keys(im)
    cki("keys_len", len(ks), 3)
    cks("keys[0]", ks[0], "c")
    cks("keys[1]", ks[1], "a")
    cks("keys[2]", ks[2], "b")

    // im_key_at positional access
    cks("key_at(0)", im_key_at(im, 0), "c")
    cks("key_at(1)", im_key_at(im, 1), "a")
    cks("key_at(2)", im_key_at(im, 2), "b")

    // im_value_at: c=30 at position 0
    cki("value_at(0)", im_value_at(im, 0), 30)
    cki("value_at(1)", im_value_at(im, 1), 10)
    cki("value_at(2)", im_value_at(im, 2), 20)

    // im_index_of
    cki("index_of_b", im_index_of(im, "b"), 2)
    cki("index_of_z", im_index_of(im, "z"), -1)

    // im_has
    cki("has_a", im_has(im, "a"), 1)
    cki("has_z", im_has(im, "z"), 0)

    // im_get
    cki("get_c", im_get(im, "c"), 30)
    cki("get_z_null", im_get(im, "z") == null, 1)

    // re-set "a" must keep its position (index 1) and update value
    im_set(im, "a", 99)
    cki("len_after_reset", im_len(im), 3)
    cks("key_at(1)_after_reset", im_key_at(im, 1), "a")
    cki("index_of_a_after_reset", im_index_of(im, "a"), 1)
    cki("value_at(1)_after_reset", im_value_at(im, 1), 99)
    cki("get_a_after_reset", im_get(im, "a"), 99)

    // keys list still 3, order unchanged
    let ks2 = im_keys(im)
    cki("keys_len_after_reset", len(ks2), 3)
    cks("keys2[0]", ks2[0], "c")
    cks("keys2[1]", ks2[1], "a")
    cks("keys2[2]", ks2[2], "b")

    print("_indexmap_test passed")
