// forge_keystone_test -- Phase 0a capstone: the struct<->JSON keystone DEMONSTRATED
// end-to-end in Forge, both directions, zero annotation.
//   OUT: a handler returning a domain struct -> JSON OBJECT response via forge.json_of
//        (the struct-through-any serialize-out keystone; bool/float/string all correct).
//   IN : a typed request body -> struct via the from_json typed-let keystone.
import forge

type User
    id: int
    name: string
    active: bool

fn main()
    // serialize-OUT: domain struct -> JSON object response body
    let u = User(7, "ada", true)
    let resp = forge.json_of(200, u)
    assert(find(resp, "\"id\":7") >= 0, "json_of id")
    assert(find(resp, "\"name\":\"ada\"") >= 0, "json_of name")
    assert(find(resp, "\"active\":true") >= 0, "json_of bool field")
    assert(find(resp, "application/json") >= 0, "json_of content-type")
    print("PASS: forge.json_of struct -> JSON object response")

    // deserialize-IN: typed request body -> struct (from_json typed-let)
    let body = "\{\"id\": 9, \"name\": \"bob\", \"active\": false\}"
    let u2: User = from_json(body)
    assert(u2.id == 9, "from_json id")
    assert(u2.name == "bob", "from_json name")
    assert(u2.active == false, "from_json active")
    print("PASS: typed from_json request body -> struct")
    print("forge_keystone_test passed")
