// CVE ORACLE for nominal-struct-return inference (S1). (1) POSITIVE: a struct-returning fn WITHOUT a
// `-> Point` annotation; field access must work (annotation-removal WIN). (2) NULL-SAFETY: make_or_null
// can return null on fallthrough -> S1 must NOT pin its return to Point (all-paths walker rejects),
// else result.x = native slot-read on null = segfault. Kept on the safe path here; asserts no crash.
type Point
    x: float
    y: float

fn make_point(x, y)
    Point(x, y)

fn make_or_null(flag)
    if flag
        return Point(1.0, 2.0)
    null

fn main() -> int
    let q = make_point(3.0, 4.0)
    assert_near(q.x, 3.0, 0.001)
    assert_near(q.y, 4.0, 0.001)
    let p = make_or_null(false)
    if p != null
        print("FAIL: make_or_null(false) should be null")
        exit(1)
    let r = make_or_null(true)
    match r
        Point(rx, ry) =>
            assert_near(rx, 1.0, 0.001)
    print("PASS null_return_canary")
    return 0
