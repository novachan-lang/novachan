import forge_infotheory

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn nearp(name: string, a: float, b: float) -> int
    let d = a - b
    if d > -0.001 and d < 0.001
        return 0
    print("FAIL " + name + ": got=" + str(a) + " want~=" + str(b))
    1

fn main()
    let fails = 0

    // Shannon entropy (bits)
    fails = fails + nearp("ent_coin", shannon_entropy([1, 1]), 1.0)
    fails = fails + nearp("ent_4equal", shannon_entropy([1, 1, 1, 1]), 2.0)
    fails = fails + nearp("ent_pure", shannon_entropy([5, 0]), 0.0)
    fails = fails + nearp("ent_single", shannon_entropy([7]), 0.0)
    fails = fails + nearp("ent_empty", shannon_entropy([]), 0.0)
    fails = fails + nearp("ent_75_25", shannon_entropy([3, 1]), 0.81128)

    // normalized entropy
    fails = fails + nearp("norm_coin", normalized_entropy([1, 1]), 1.0)
    fails = fails + nearp("norm_skew", normalized_entropy([9, 1]), 0.46900)

    // Gini impurity
    fails = fails + nearp("gini_coin", gini_impurity([1, 1]), 0.5)
    fails = fails + nearp("gini_pure", gini_impurity([5, 0]), 0.0)
    fails = fails + nearp("gini_4equal", gini_impurity([1, 1, 1, 1]), 0.75)

    // information gain: parent [2,2] (entropy 1) split into [2,0] and [0,2] (both pure) -> gain = 1.0
    fails = fails + nearp("infogain_perfect", information_gain([2, 2], [[2, 0], [0, 2]]), 1.0)
    // useless split: parent [2,2] into [1,1],[1,1] -> gain 0
    fails = fails + nearp("infogain_useless", information_gain([2, 2], [[1, 1], [1, 1]]), 0.0)

    // Gini coefficient (inequality)
    fails = fails + nearp("gini_equal", gini_coefficient([1, 1, 1, 1]), 0.0)
    fails = fails + nearp("gini_maxineq", gini_coefficient([0, 0, 0, 4]), 0.75)
    fails = fails + expect_true("gini_partial", gini_coefficient([1, 2, 3, 4]) > 0.2 and gini_coefficient([1, 2, 3, 4]) < 0.3)

    if fails == 0
        print("forge_infotheory: all passed")
    else
        print("forge_infotheory: " + str(fails) + " FAILED")
