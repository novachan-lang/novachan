import forge_treap

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

// reference: a sorted-unique list maintained in parallel
fn ref_insert(ref: list, k: int) -> list
    // insert keeping sorted, no dup
    let out = []
    let inserted = 0
    let i = 0
    while i < len(ref)
        if ref[i] == k
            inserted = 1
        if ref[i] > k and inserted == 0
            push(out, k)
            inserted = 1
        push(out, ref[i])
        i = i + 1
    if inserted == 0
        push(out, k)
    out

fn ref_erase(ref: list, k: int) -> list
    let out = []
    let i = 0
    while i < len(ref)
        if ref[i] != k
            push(out, ref[i])
        i = i + 1
    out

fn ref_rank(ref: list, k: int) -> int
    let c = 0
    let i = 0
    while i < len(ref)
        if ref[i] < k
            c = c + 1
        i = i + 1
    c

fn main()
    let fails = 0

    let t = treap_new()
    let ref = []

    // insert a sequence with duplicates
    let vals = [50, 20, 80, 20, 10, 90, 60, 30, 70, 40, 50, 5, 95, 25]
    let i = 0
    while i < len(vals)
        treap_insert(t, vals[i])
        ref = ref_insert(ref, vals[i])
        i = i + 1

    fails = fails + expect("size", str(treap_size(t)), str(len(ref)))

    // contains: present and absent
    fails = fails + expect("has50", str(treap_contains(t, 50)), "true")
    fails = fails + expect("has99", str(treap_contains(t, 99)), "false")

    // select matches the sorted reference for every index
    let sel_ok = 1
    let s = 0
    while s < len(ref)
        if treap_select(t, s) != ref[s]
            sel_ok = 0
        s = s + 1
    fails = fails + expect("select_all", str(sel_ok), "1")

    // rank matches for a range of query values
    let rank_ok = 1
    let q = 0
    while q <= 100
        if treap_rank(t, q) != ref_rank(ref, q)
            rank_ok = 0
        q = q + 1
    fails = fails + expect("rank_all", str(rank_ok), "1")

    // erase several, then re-check select + size against reference
    let dels = [20, 5, 95, 60, 999]
    let d = 0
    while d < len(dels)
        treap_erase(t, dels[d])
        ref = ref_erase(ref, dels[d])
        d = d + 1
    fails = fails + expect("size_after", str(treap_size(t)), str(len(ref)))

    let sel_ok2 = 1
    let s2 = 0
    while s2 < len(ref)
        if treap_select(t, s2) != ref[s2]
            sel_ok2 = 0
        s2 = s2 + 1
    fails = fails + expect("select_after", str(sel_ok2), "1")

    fails = fails + expect("has20_after", str(treap_contains(t, 20)), "false")
    fails = fails + expect("select_oob", str(treap_select(t, 1000)), "-1")

    // empty treap
    let e = treap_new()
    fails = fails + expect("empty_size", str(treap_size(e)), "0")
    fails = fails + expect("empty_sel", str(treap_select(e, 0)), "-1")

    if fails == 0
        print("forge_treap: all passed")
    else
        print("forge_treap: " + str(fails) + " FAILED")
