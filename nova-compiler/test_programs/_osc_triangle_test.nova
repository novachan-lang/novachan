// KAT test for std/audio/osc_triangle.nova
import std/audio/osc_triangle

fn approx(a: float, b: float, tol: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    let result = d < tol
    result

fn main()
    // KAT 1: osc_triangle(0.0) == -1.0 (start of rise)
    let t0 = osc_triangle(0.0)
    if approx(t0, -1.0, 0.0001) != true
        print("FAIL osc_triangle(0.0): got=" + str(t0) + " want~-1.0")
        exit(1)

    // KAT 2: osc_triangle(0.25) == 0.0 (midpoint of rise)
    let t25 = osc_triangle(0.25)
    if approx(t25, 0.0, 0.0001) != true
        print("FAIL osc_triangle(0.25): got=" + str(t25) + " want~0.0")
        exit(1)

    // KAT 3: osc_triangle(0.5) == 1.0 (peak)
    let t50 = osc_triangle(0.5)
    if approx(t50, 1.0, 0.0001) != true
        print("FAIL osc_triangle(0.5): got=" + str(t50) + " want~1.0")
        exit(1)

    // KAT 4: osc_triangle(0.75) == 0.0 (midpoint of fall)
    let t75 = osc_triangle(0.75)
    if approx(t75, 0.0, 0.0001) != true
        print("FAIL osc_triangle(0.75): got=" + str(t75) + " want~0.0")
        exit(1)

    // KAT 5: osc_triangle(0.125) == -0.5 (quarter of rise)
    let t125 = osc_triangle(0.125)
    if approx(t125, -0.5, 0.0001) != true
        print("FAIL osc_triangle(0.125): got=" + str(t125) + " want~-0.5")
        exit(1)

    // KAT 6: osc_triangle(0.375) == 0.5 (three-quarter of rise)
    let t375 = osc_triangle(0.375)
    if approx(t375, 0.5, 0.0001) != true
        print("FAIL osc_triangle(0.375): got=" + str(t375) + " want~0.5")
        exit(1)

    // KAT 7: osc_triangle(0.625) == 0.5 (just past peak, start of fall)
    let t625 = osc_triangle(0.625)
    if approx(t625, 0.5, 0.0001) != true
        print("FAIL osc_triangle(0.625): got=" + str(t625) + " want~0.5")
        exit(1)

    // KAT 8: osc_triangle(0.875) == -0.5 (three-quarter of fall)
    let t875 = osc_triangle(0.875)
    if approx(t875, -0.5, 0.0001) != true
        print("FAIL osc_triangle(0.875): got=" + str(t875) + " want~-0.5")
        exit(1)

    print("PASS _osc_triangle_test")
