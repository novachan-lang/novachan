import forge_search_index

fn main()
    let s = si_new()
    s = si_add_doc(s, "d1", "hello world")
    s = si_add_doc(s, "d2", "hello nova")
    s = si_add_doc(s, "d3", "world peace")
    assert(si_doc_count(s) == 3, "3 docs")

    let r1 = si_search(s, "hello")
    assert(is_ok(r1), "hello found")
    assert(unwrap(r1) == 2, "hello in 2 docs")

    let r2 = si_search(s, "world")
    assert(is_ok(r2), "world found")

    let r3 = si_search(s, "missing")
    assert(is_err(r3), "missing not found")

    assert(si_has_doc(s, "hello", "d1") == 1, "hello in d1")
    assert(si_has_doc(s, "hello", "d3") == 0, "hello not in d3")
    assert(si_has_doc(s, "nova", "d2") == 1, "nova in d2")

    print("SEARCH-INDEX KAT PASS")
