// KAT for std/testing/property — property-based testing helpers
import std/testing/property

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// Named predicate: 1 if x >= 0
fn nonneg(x) -> int
    if x >= 0
        return 1
    return 0

// Named predicate: 1 if x < 10
fn under10(x) -> int
    if x < 10
        return 1
    return 0

// Named predicate: always false
fn always_false(x) -> int
    return 0

fn main()
    // ── KAT 1: forall_int over [0,100], nonneg always true ──────────────────
    let r1 = prop_forall_int(nonneg, 0, 100, 50, 1)
    ckb("forall_int_nonneg_ok", r1["ok"], 1)
    cki("forall_int_nonneg_trials", r1["trials"], 50)

    // ── KAT 2: forall_int over [0,100], under10 finds counterexample ─────────
    // Range [0,100] contains values >= 10, so the predicate must fail.
    let r2 = prop_forall_int(under10, 0, 100, 50, 1)
    ckb("forall_int_under10_ok", r2["ok"], 0)
    // counterexample must be >= 10 (the failing condition)
    let ce = r2["counterexample"]
    if ce < 10
        print("FAIL forall_int_under10_ce: counterexample " + str(ce) + " is < 10, should be >= 10")
        exit(1)

    // ── KAT 3: prop_check all pass ──────────────────────────────────────────
    let r3 = prop_check(nonneg, [0, 1, 2, 3])
    ckb("check_all_pass_ok", r3["ok"], 1)
    cki("check_all_pass_trials", r3["trials"], 4)

    // ── KAT 4: prop_check with one negative — ok==false ─────────────────────
    let r4 = prop_check(nonneg, [1, 0 - 1, 2])
    ckb("check_neg_ok", r4["ok"], 0)

    // ── KAT 5: counterexample is -1 ─────────────────────────────────────────
    cki("check_neg_ce", r4["counterexample"], 0 - 1)

    // ── KAT 6: empty list → ok==1, trials==0 ────────────────────────────────
    let r5 = prop_check(nonneg, [])
    ckb("check_empty_ok", r5["ok"], 1)
    cki("check_empty_trials", r5["trials"], 0)

    // ── KAT 7: always_false predicate finds counterexample on first value ────
    let r6 = prop_check(always_false, [42])
    ckb("check_always_false_ok", r6["ok"], 0)
    cki("check_always_false_ce", r6["counterexample"], 42)
    cki("check_always_false_trials", r6["trials"], 1)

    // ── KAT 8: forall_int with seed=42, nonneg on [0,10], all must pass ─────
    let r7 = prop_forall_int(nonneg, 0, 10, 20, 42)
    ckb("forall_int_seed42_ok", r7["ok"], 1)
    cki("forall_int_seed42_trials", r7["trials"], 20)

    print("_property_test passed")

main()
