import telemetry

fn _near(a: float, b: float) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < 0.000001
        return 1
    0

fn main()
    let m = telemetry.telem_new()

    // counters (monotonic)
    m = telemetry.telem_counter(m, "requests", 1)
    m = telemetry.telem_counter(m, "requests", 1)
    m = telemetry.telem_counter(m, "requests", 3)
    assert(telemetry.telem_get(m, "requests") == 5, "counter accumulates to 5")
    assert(telemetry.telem_get(m, "absent") == 0, "absent counter -> 0")
    m = telemetry.telem_counter(m, "errors", 2)
    assert(telemetry.telem_get(m, "errors") == 2, "second counter independent")
    assert(telemetry.telem_get(m, "requests") == 5, "first counter unchanged")

    // gauges (last-write-wins)
    m = telemetry.telem_gauge(m, "queue_depth", 7.0)
    m = telemetry.telem_gauge(m, "queue_depth", 3.0)
    assert(_near(telemetry.telem_gauge_get(m, "queue_depth"), 3.0), "gauge last-write 3.0")

    // histogram: observe 10, 20, 30, 40 -> count 4, min 10, max 40, sum 100, mean 25
    m = telemetry.telem_observe(m, "latency_ms", 10.0)
    m = telemetry.telem_observe(m, "latency_ms", 20.0)
    m = telemetry.telem_observe(m, "latency_ms", 30.0)
    m = telemetry.telem_observe(m, "latency_ms", 40.0)
    let h = telemetry.telem_hist(m, "latency_ms")
    assert(h["count"] == 4, "hist count 4")
    assert(_near(h["min"], 10.0), "hist min 10")
    assert(_near(h["max"], 40.0), "hist max 40")
    assert(_near(h["sum"], 100.0), "hist sum 100")
    assert(_near(h["mean"], 25.0), "hist mean 25")

    // empty histogram is safe
    let h0 = telemetry.telem_hist(m, "never")
    assert(h0["count"] == 0, "empty hist count 0")

    print("telemetry_lib_test: all passed")
