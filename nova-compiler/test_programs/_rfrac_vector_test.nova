import std/rational/rfrac_vector

fn ckr(label, got, wn, wd)
    if got[0] != wn or got[1] != wd
        print("FAIL rfrac_vector " + label + ": got=" + str(got[0]) + "/" + str(got[1]) + " want=" + str(wn) + "/" + str(wd))
        exit(1)

fn main()
    // rfvec_sum KAT
    let xs = [[1, 2], [1, 3], [1, 6]]
    ckr("sum([1/2,1/3,1/6])", rfvec_sum(xs), 1, 1)

    // rfvec_mean KAT
    ckr("mean([1/2,1/3,1/6])", rfvec_mean(xs), 1, 3)

    // rfvec_dot KAT
    let a = [[1, 2], [1, 3]]
    let b = [[2, 1], [3, 1]]
    ckr("dot([1/2,1/3],[2,3])", rfvec_dot(a, b), 2, 1)

    // rfvec_mean uniform KAT
    let ys = [[2, 3], [2, 3], [2, 3]]
    ckr("mean([2/3,2/3,2/3])", rfvec_mean(ys), 2, 3)

    // rfvec_scale KAT: scale [[1/2],[1/3]] by [2,1] -> [[1,1],[2,3]]
    let src = [[1, 2], [1, 3]]
    let sc = [2, 1]
    let scaled = rfvec_scale(src, sc)
    if len(scaled) != 2
        print("FAIL rfrac_vector scale_len: got=" + str(len(scaled)) + " want=2")
        exit(1)
    ckr("scale[0]", scaled[0], 1, 1)
    ckr("scale[1]", scaled[1], 2, 3)

    // rfvec_weighted_mean KAT: vals=[1,3] weights=[1,1] -> 2/1
    let vals = [[1, 1], [3, 1]]
    let weights = [[1, 1], [1, 1]]
    ckr("wmean([1,3],[1,1])", rfvec_weighted_mean(vals, weights), 2, 1)

    print("PASS _rfrac_vector_test")
