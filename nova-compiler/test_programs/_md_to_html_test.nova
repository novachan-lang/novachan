// KAT for std/text/md_to_html
import std/text/md_to_html

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL md_to_html " + label + ": got [" + got + "]")
        exit(1)

fn main()
    let nl = chr(10)

    // spec KAT #1: heading
    cks("h1", md_to_html("# Title"), "<h1>Title</h1>")

    // spec KAT #2: heading + paragraph with bold
    let doc2 = "# T" + nl + nl + "Hello **world**"
    let want2 = "<h1>T</h1>" + nl + "<p>Hello <strong>world</strong></p>"
    cks("h1_para_bold", md_to_html(doc2), want2)

    // spec KAT #3: list produces <ul>
    let list_in = "- a" + nl + "- b"
    let list_out = md_to_html(list_in)
    if find(list_out, "<ul>") < 0
        print("FAIL md_to_html list_ul: got [" + list_out + "]")
        exit(1)
    if find(list_out, "<li>a</li>") < 0
        print("FAIL md_to_html list_li_a: got [" + list_out + "]")
        exit(1)
    if find(list_out, "<li>b</li>") < 0
        print("FAIL md_to_html list_li_b: got [" + list_out + "]")
        exit(1)

    // h2, h3
    cks("h2", md_to_html("## Sub"), "<h2>Sub</h2>")
    cks("h3", md_to_html("### Deep"), "<h3>Deep</h3>")

    // hr
    cks("hr", md_to_html("---"), "<hr>")

    // blockquote
    cks("bq", md_to_html("> quote"), "<blockquote>quote</blockquote>")

    // inline italic
    cks("em", md_to_html("*hello*"), "<p><em>hello</em></p>")

    // inline code
    let backtick = chr(96)
    let code_in = backtick + "x" + backtick
    cks("code", md_to_html(code_in), "<p><code>x</code></p>")

    // * list
    let star_list = "* one" + nl + "* two"
    let star_out = md_to_html(star_list)
    if find(star_out, "<li>one</li>") < 0
        print("FAIL md_to_html star_list: got [" + star_out + "]")
        exit(1)

    // multi-block document
    let full = "# Hello" + nl + nl + "---" + nl + nl + "World"
    let full_want = "<h1>Hello</h1>" + nl + "<hr>" + nl + "<p>World</p>"
    cks("full_doc", md_to_html(full), full_want)

    print("PASS _md_to_html_test")
