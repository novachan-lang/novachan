// bloomx.nova — a Bloom filter: a compact PROBABILISTIC set, the NOVA way.
//
// A Bloom filter answers "is x in the set?" with "definitely NO" or "probably
// YES" using k hash functions over a bit array — far smaller than storing the
// elements. The defining guarantee: NO FALSE NEGATIVES (anything added always
// tests positive); false positives are possible but tunable by size/k. Used for
// caches, dedup, "have I seen this?" membership at scale. Self-contained: a
// pure-NOVA djb2 hash over codepoints (no hash builtin needed).

fn _hash_str(s)
  let cps = code_points(s)
  let h = 5381
  for c in cps
    h = (h * 33 + c) % 2147483647
  h

fn bloom_new(size, k)
  let bits = []
  let i = 0
  while i < size
    push(bits, 0)
    i = i + 1
  let bf = {}
  bf["bits"] = bits
  bf["k"] = k
  bf["size"] = size
  bf

fn _bloom_pos(bf, item, i)
  let h = _hash_str(item + ":" + str(i))
  let p = h % bf["size"]
  if p < 0
    p = p + bf["size"]
  p

fn bloom_add(bf, item)
  let bits = bf["bits"]
  let i = 0
  while i < bf["k"]
    bits[_bloom_pos(bf, item, i)] = 1
    i = i + 1

// 1 = probably present, 0 = definitely absent.
fn bloom_contains(bf, item)
  let bits = bf["bits"]
  let i = 0
  while i < bf["k"]
    if bits[_bloom_pos(bf, item, i)] == 0
      return 0
    i = i + 1
  1

// ── Tests ────────────────────────────────────────────────────────────

let bf = bloom_new(10007, 4)

// empty filter: nothing is present.
assert(bloom_contains(bf, "apple") == 0, "empty filter has nothing")
print("PASS: empty filter")

// add items; the NO-FALSE-NEGATIVE guarantee: every added item tests positive.
let items = ["apple", "banana", "cherry", "date", "elderberry"]
for it in items
  bloom_add(bf, it)
for it in items
  assert(bloom_contains(bf, it) == 1, "added item always present (no false negatives)")
print("PASS: no false negatives")

// items NOT added: almost certainly absent with a 10007-bit array + 5 items
// (false-positive probability is ~1e-11 here, so deterministic in practice).
assert(bloom_contains(bf, "zebra") == 0, "non-member zebra absent")
assert(bloom_contains(bf, "kiwi") == 0, "non-member kiwi absent")
assert(bloom_contains(bf, "mango") == 0, "non-member mango absent")
print("PASS: non-members rejected")

// a second, independent filter does not share state.
let bf2 = bloom_new(2003, 3)
bloom_add(bf2, "only")
assert(bloom_contains(bf2, "only") == 1, "bf2 has its own item")
assert(bloom_contains(bf2, "apple") == 0, "bf2 independent of bf")
print("PASS: independent filters")

print("ALL PASS: bloomx — probabilistic set (Bloom filter)")
