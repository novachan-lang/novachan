import std/backtracking/bt_combination_sum3

// cki — assert integer equality
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// list_str — render int list as "[a,b,...]"
fn list_str(xs)
    let s = "["
    let i = 0
    let n = len(xs)
    while i < n
        if i > 0
            s = s + ","
        s = s + str(xs[i])
        i = i + 1
    s + "]"

// list_eq — true if two int lists are equal element-wise
fn list_eq(a, b) -> bool
    if len(a) != len(b)
        return false
    let i = 0
    while i < len(a)
        if a[i] != b[i]
            return false
        i = i + 1
    true

// results_contains — true if results contains a combo equal to want
fn results_contains(results, want) -> bool
    let i = 0
    while i < len(results)
        if list_eq(results[i], want)
            return true
        i = i + 1
    false

// ck_contains — assert results contains the expected combo
fn ck_contains(label: string, results, want)
    if not results_contains(results, want)
        print("FAIL " + label + ": result set does not contain " + list_str(want))
        exit(1)

// cknest — assert outer length matches want_len
fn cknest(label: string, results, want_len: int)
    if len(results) != want_len
        print("FAIL " + label + "_len: got=" + str(len(results)) + " want=" + str(want_len))
        exit(1)

fn main()
    // --- cs3_count basic KATs ---
    // k=3, n=7: only [1,2,4] => 1
    cki("cs3_count_3_7", cs3_count(3, 7), 1)

    // k=3, n=9: [1,2,6],[1,3,5],[2,3,4] => 3
    cki("cs3_count_3_9", cs3_count(3, 9), 3)

    // k=2, n=18: impossible (max 2-combo from 1..9 is 8+9=17) => 0
    cki("cs3_count_2_18", cs3_count(2, 18), 0)

    // k=4, n=1: impossible (min 4-combo is 1+2+3+4=10 > 1) => 0
    cki("cs3_count_4_1", cs3_count(4, 1), 0)

    // --- cs3_solve correctness ---
    // k=3, n=7 => exactly 1 combo [1,2,4]
    let r7 = cs3_solve(3, 7)
    cknest("cs3_solve_3_7", r7, 1)
    ck_contains("contains_124", r7, [1, 2, 4])

    // k=3, n=9 => 3 combos
    let r9 = cs3_solve(3, 9)
    cknest("cs3_solve_3_9", r9, 3)
    ck_contains("contains_126", r9, [1, 2, 6])
    ck_contains("contains_135", r9, [1, 3, 5])
    ck_contains("contains_234", r9, [2, 3, 4])

    // --- additional boundary KATs ---
    // k=1, n=5 => [5] only
    cki("cs3_count_1_5", cs3_count(1, 5), 1)
    let r1_5 = cs3_solve(1, 5)
    cknest("cs3_solve_1_5", r1_5, 1)
    ck_contains("contains_5", r1_5, [5])

    // k=1, n=10 => impossible (digits only 1..9)
    cki("cs3_count_1_10", cs3_count(1, 10), 0)

    // k=2, n=3 => [1,2] only
    cki("cs3_count_2_3", cs3_count(2, 3), 1)
    let r2_3 = cs3_solve(2, 3)
    cknest("cs3_solve_2_3", r2_3, 1)
    ck_contains("contains_12", r2_3, [1, 2])

    // k=2, n=17 => [8,9] only (max)
    cki("cs3_count_2_17", cs3_count(2, 17), 1)
    let r2_17 = cs3_solve(2, 17)
    cknest("cs3_solve_2_17", r2_17, 1)
    ck_contains("contains_89", r2_17, [8, 9])

    // k=9, n=45 => 1 combo [1,2,3,4,5,6,7,8,9] (only one: all digits)
    cki("cs3_count_9_45", cs3_count(9, 45), 1)
    let r9_45 = cs3_solve(9, 45)
    cknest("cs3_solve_9_45", r9_45, 1)
    ck_contains("contains_123456789", r9_45, [1, 2, 3, 4, 5, 6, 7, 8, 9])

    // k=0 => invalid => 0
    cki("cs3_count_0_0", cs3_count(0, 0), 0)

    // k=3, n=6 => [1,2,3] only
    cki("cs3_count_3_6", cs3_count(3, 6), 1)

    print("PASS _bt_combination_sum3_test")
