// _adaptive_huffman_test.nova — KAT for std/compress/adaptive_huffman
//
// Tests round-trip ahuff_decompress(ahuff_compress(bytes)) == bytes
// for multiple inputs: empty, repetitive, mixed, text.

import std/compress/adaptive_huffman

// ── Helpers ──────────────────────────────────────────────────────────────────

fn bytes_eq(a, b) -> int
    if len(a) != len(b)
        return 0
    let i = 0
    let ok = 1
    while i < len(a)
        if a[i] != b[i]
            ok = 0
        i = i + 1
    ok

fn str_to_bytes(s) -> list
    let out = []
    let i = 0
    while i < len(s)
        push(out, ord(s[i]))
        i = i + 1
    out

fn ckrt(label, input_bytes)
    let compressed = ahuff_compress(input_bytes)
    let recovered = ahuff_decompress(compressed)
    if bytes_eq(recovered, input_bytes) == 0
        print("FAIL " + label + ": round-trip mismatch")
        print("  input len=" + str(len(input_bytes)) + " bits=" + str(len(compressed)) + " recovered=" + str(len(recovered)))
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // KAT 1: empty
    let empty = []
    ckrt("empty", empty)
    let enc_empty = ahuff_compress(empty)
    cki("empty-bits-len", len(enc_empty), 0)

    // KAT 2: single byte
    let single = [65]
    ckrt("single-A", single)

    // KAT 3: two identical bytes [65,65]
    // First 65: escape=1, then 8 bits of 65
    // Second 65: escape=0, then Huffman code (only 1 known sym -> [0])
    let two_same = [65, 65]
    ckrt("two-same", two_same)

    // KAT 4: repetitive "aaaa" = [97,97,97,97]
    let aaaa = [97, 97, 97, 97]
    ckrt("aaaa-roundtrip", aaaa)
    // Repetitive should compress: after first literal, subsequent use 0-bit codes
    let aaaa_bits = ahuff_compress(aaaa)
    // First symbol: 1 (escape) + 8 bits = 9 bits
    // Subsequent: 0 (huffman-flag) + 1 bit (single-symbol code) = 2 bits each
    // Total = 9 + 3*2 = 15 bits
    cki("aaaa-bits-count", len(aaaa_bits), 15)

    // KAT 5: [0,0,0] — byte 0
    let zeros = [0, 0, 0]
    ckrt("zeros-roundtrip", zeros)

    // KAT 6: "TOBEORNOTTOBEORTOBEORNOT" as bytes
    let tobe = str_to_bytes("TOBEORNOTTOBEORTOBEORNOT")
    ckrt("TOBE-roundtrip", tobe)

    // KAT 7: mixed bytes
    let mixed = [1, 128, 255, 0, 64, 200, 1, 128]
    ckrt("mixed-roundtrip", mixed)

    // KAT 8: all distinct bytes [65,66,67,68,69]
    let distinct = [65, 66, 67, 68, 69]
    ckrt("distinct-roundtrip", distinct)

    // KAT 9: longer repetitive — 8 copies of same byte
    let longrun = [77, 77, 77, 77, 77, 77, 77, 77]
    ckrt("longrun-roundtrip", longrun)

    // KAT 10: longer text
    let longer = str_to_bytes("hello world")
    ckrt("hello-world-roundtrip", longer)

    // KAT 11: text with repeated patterns
    let pattern = str_to_bytes("abcabcabc")
    ckrt("pattern-roundtrip", pattern)

    // KAT 12: single zero byte
    let zero1 = [0]
    ckrt("single-zero", zero1)

    // KAT 13: single byte 255
    let max1 = [255]
    ckrt("single-255", max1)

    // KAT 14: two different bytes
    let two_diff = [100, 200]
    ckrt("two-diff", two_diff)

    // KAT 15: banana as bytes
    let banana = str_to_bytes("banana")
    ckrt("banana-roundtrip", banana)

    print("PASS _adaptive_huffman_test")
