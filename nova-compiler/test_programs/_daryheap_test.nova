import std/collections/daryheap

fn cki(label, got, expected)
    if got != expected
        print("FAIL daryheap " + label + ": got " + str(got) + " want " + str(expected))
        exit(1)

fn list_eq(a, b)
    if len(a) != len(b)
        return 0
    let i = 0
    while i < len(a)
        if a[i] != b[i]
            return 0
        i = i + 1
    return 1

fn main()
    // ---- KAT 1: d=4 basic push + peek + size ----
    let h = dh_new(4)
    dh_push(h, 5)
    dh_push(h, 3)
    dh_push(h, 8)
    dh_push(h, 1)
    dh_push(h, 9)
    dh_push(h, 2)
    cki("d4_peek", dh_peek(h), 1)
    cki("d4_size", dh_size(h), 6)

    // ---- KAT 2: d=4 pop sequence gives sorted order ----
    let p1 = dh_pop(h)
    cki("d4_pop1", p1, 1)
    let p2 = dh_pop(h)
    cki("d4_pop2", p2, 2)
    let p3 = dh_pop(h)
    cki("d4_pop3", p3, 3)
    let p4 = dh_pop(h)
    cki("d4_pop4", p4, 5)
    let p5 = dh_pop(h)
    cki("d4_pop5", p5, 8)
    let p6 = dh_pop(h)
    cki("d4_pop6", p6, 9)
    cki("d4_empty_size", dh_size(h), 0)

    // ---- KAT 3: pop on empty returns null ----
    let pnull = dh_pop(h)
    if pnull != null
        print("FAIL daryheap d4_pop_empty: expected null got " + str(pnull))
        exit(1)

    // ---- KAT 4: peek on empty returns null ----
    let pk_empty = dh_peek(h)
    if pk_empty != null
        print("FAIL daryheap d4_peek_empty: expected null")
        exit(1)

    // ---- KAT 5: d=3 push + pop sequence ----
    let h3 = dh_new(3)
    dh_push(h3, 5)
    dh_push(h3, 3)
    dh_push(h3, 8)
    dh_push(h3, 1)
    dh_push(h3, 9)
    dh_push(h3, 2)
    cki("d3_peek", dh_peek(h3), 1)
    cki("d3_size", dh_size(h3), 6)
    let q1 = dh_pop(h3)
    cki("d3_pop1", q1, 1)
    let q2 = dh_pop(h3)
    cki("d3_pop2", q2, 2)
    let q3 = dh_pop(h3)
    cki("d3_pop3", q3, 3)
    let q4 = dh_pop(h3)
    cki("d3_pop4", q4, 5)
    let q5 = dh_pop(h3)
    cki("d3_pop5", q5, 8)
    let q6 = dh_pop(h3)
    cki("d3_pop6", q6, 9)

    // ---- KAT 6: dh_from with d=2 then pop-all gives sorted order ----
    let hf = dh_from([5, 3, 8, 1, 9, 2], 2)
    cki("from_d2_peek", dh_peek(hf), 1)
    cki("from_d2_size", dh_size(hf), 6)
    let r1 = dh_pop(hf)
    cki("from_d2_pop1", r1, 1)
    let r2 = dh_pop(hf)
    cki("from_d2_pop2", r2, 2)
    let r3 = dh_pop(hf)
    cki("from_d2_pop3", r3, 3)
    let r4 = dh_pop(hf)
    cki("from_d2_pop4", r4, 5)
    let r5 = dh_pop(hf)
    cki("from_d2_pop5", r5, 8)
    let r6 = dh_pop(hf)
    cki("from_d2_pop6", r6, 9)

    // ---- KAT 7: single element heap ----
    let hs = dh_new(4)
    dh_push(hs, 42)
    cki("single_peek", dh_peek(hs), 42)
    cki("single_size", dh_size(hs), 1)
    let sp = dh_pop(hs)
    cki("single_pop", sp, 42)
    cki("single_empty", dh_size(hs), 0)

    // ---- KAT 8: duplicates ----
    let hd = dh_new(4)
    dh_push(hd, 3)
    dh_push(hd, 3)
    dh_push(hd, 1)
    dh_push(hd, 1)
    dh_push(hd, 2)
    cki("dup_peek", dh_peek(hd), 1)
    cki("dup_size", dh_size(hd), 5)
    let d1 = dh_pop(hd)
    cki("dup_pop1", d1, 1)
    let d2 = dh_pop(hd)
    cki("dup_pop2", d2, 1)
    let d3 = dh_pop(hd)
    cki("dup_pop3", d3, 2)
    let d4 = dh_pop(hd)
    cki("dup_pop4", d4, 3)
    let d5 = dh_pop(hd)
    cki("dup_pop5", d5, 3)

    // ---- KAT 9: dh_from with d=4 (heapify) ----
    let hf4 = dh_from([5, 3, 8, 1, 9, 2], 4)
    cki("from_d4_peek", dh_peek(hf4), 1)
    let f1 = dh_pop(hf4)
    cki("from_d4_pop1", f1, 1)
    let f2 = dh_pop(hf4)
    cki("from_d4_pop2", f2, 2)
    let f3 = dh_pop(hf4)
    cki("from_d4_pop3", f3, 3)

    // ---- KAT 10: dh_from on single-element list ----
    let hf1 = dh_from([7], 3)
    cki("from_single_peek", dh_peek(hf1), 7)
    let fp1 = dh_pop(hf1)
    cki("from_single_pop", fp1, 7)
    let fp_null = dh_pop(hf1)
    if fp_null != null
        print("FAIL daryheap from_single_empty: expected null")
        exit(1)

    // ---- KAT 11: dh_from on empty list ----
    let hfe = dh_from([], 2)
    cki("from_empty_size", dh_size(hfe), 0)
    let fpe = dh_pop(hfe)
    if fpe != null
        print("FAIL daryheap from_empty_pop: expected null")
        exit(1)

    print("PASS _daryheap_test")
