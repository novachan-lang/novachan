// _kat_orm_pool_stress -- reproduces the ORIGINALLY REPORTED BUG:
//   "ORM PostgreSQL pool segfaults after pool_size + 1 ORM calls."
// KNOWN ANSWER: N ORM calls on a pool of size K must all succeed and return correct data for any
// N >> K, and the pool must still hold exactly K connections at the end.
//
// Pre-fix, several defects produced exactly this symptom class: the pooled path released with a
// non-crash-safe `defer send`, orm_all's sqlite path DOUBLE-released (pool grew duplicate handles,
// so two callers could share one physical connection), a dead connection was returned to the pool
// and reused mid-protocol, and EOF was reported as success so a poisoned connection kept serving.

import forge_orm

type SRow
    id: int
    label: string

fn _envor(name: string, dflt: string) -> string
    let v = env(name)
    if len(v) > 0
        return v
    dflt

// Count what is in the pool WITHOUT consuming it -- take everything, then put it all back.
// (A destructive count left the pool empty and made every later call time out: a bug in the test,
// not in the ORM.)
fn drain_count(ch) -> int
    let taken = []
    let going = 1
    while going == 1
        let r = select_timeout(ch, 300)
        if r[0] == 0
            push(taken, r[1])
        else
            going = 0
    for t in taken
        send(ch, t)
    len(taken)

// Run `calls` sequential ORM operations over a pool of `size`. Returns the number of BAD results.
fn hammer(db, size: int, calls: int, label: string) -> int
    let bad = 0
    for i in 0..calls
        let rows: list<SRow> = orm_all(db, "SELECT id, label FROM kat_stress WHERE id = ?", [1])
        if len(rows) != 1
            bad += 1
        else if rows[0].label != "alpha"
            bad += 1
    let left = drain_count(orm_pool(db))
    if bad == 0 and left == size
        print("PASS {label}: {calls} calls on a pool of {size} -- all correct, pool intact ({left})")
    else
        print("FAIL {label}: bad={bad} of {calls}, pool has {left} (expected {size})")
    bad + (size - left) * (size - left)

fn run(url: string, label: string) -> int
    // pool of 2 -> the reported failure was at pool_size + 1 = 3 calls. Run far past it.
    let dr = orm_open_with_pool(url, 2)
    if is_err(dr)
        print("SKIP {label}: {unwrap_err(dr)}")
        return 0
    let db = unwrap(dr)
    _ = orm_exec(db, "DROP TABLE IF EXISTS kat_stress", [])
    _ = orm_exec(db, "CREATE TABLE kat_stress (id int, label text)", [])
    _ = orm_exec(db, "INSERT INTO kat_stress (id, label) VALUES (?, ?)", [1, "alpha"])

    // exactly pool_size + 1 -- the originally reported failure point
    let a = hammer(db, 2, 3, "{label} pool_size+1")
    // and far beyond it
    let b = hammer(db, 2, 50, "{label} 25x pool_size")

    // writes through the pool too, then a transaction, then more reads
    let w = 0
    for i in 0..20
        let r = orm_exec(db, "UPDATE kat_stress SET label = ? WHERE id = ?", ["alpha", 1])
        if is_err(r)
            w += 1
    let t = orm_with_tx(db, fn(txdb) orm_exec(txdb, "UPDATE kat_stress SET label = ? WHERE id = ?", ["alpha", 1]))
    let c = hammer(db, 2, 20, "{label} after 20 writes + tx")
    if w == 0 and is_ok(t)
        print("PASS {label}: 20 pooled writes + transaction all ok")
    else
        print("FAIL {label}: write errors={w} tx_ok={is_ok(t)}")

    _ = orm_exec(db, "DROP TABLE IF EXISTS kat_stress", [])
    orm_close(db)
    a + b + c + w

fn main()
    let fails = 0
    fails += run("sqlite://_kat_stress.db", "[sqlite]")
    let pw = env("PGPASSWORD")
    if len(pw) > 0
        let url = "postgres://" + _envor("PGUSER", "postgres") + ":" + pw + "@" + _envor("PGHOST", "127.0.0.1") + ":" + _envor("PGPORT", "5432") + "/" + _envor("PGDATABASE", "postgres")
        fails += run(url, "[postgres]")
    else
        print("[postgres] skipped (set PGPASSWORD)")
    if fails == 0
        print("_kat_orm_pool_stress passed")
    else
        print("_kat_orm_pool_stress FAILED ({fails})")
        exit(1)
