fn task_queue()
  let tq = {}
  tq["tasks"] = []
  tq["done"] = []
  tq

fn tq_add(tq, name, priority)
  push(tq["tasks"], {"name": name, "priority": priority, "status": "pending"})

fn tq_next(tq)
  let tasks = tq["tasks"]
  let best_idx = -1
  let best_pri = 999999
  let i = 0
  while i < len(tasks)
    let t = tasks[i]
    if t["status"] == "pending" and t["priority"] < best_pri
      best_pri = t["priority"]
      best_idx = i
    i = i + 1
  if best_idx < 0
    return err("no pending tasks")
  let t = tasks[best_idx]
  t["status"] = "done"
  push(tq["done"], t)
  ok(t["name"])

fn tq_pending(tq)
  let count = 0
  for t in tq["tasks"]
    if t["status"] == "pending"
      count = count + 1
  count

fn tq_completed(tq)
  len(tq["done"])

fn main()
  let q = task_queue()
  tq_add(q, "deploy", 3)
  tq_add(q, "test", 1)
  tq_add(q, "build", 2)
  assert(tq_pending(q) == 3, "3 pending")

  let first = tq_next(q)
  assert(unwrap(first) == "test", "highest priority first")
  assert(tq_pending(q) == 2, "2 pending")

  let second = tq_next(q)
  assert(unwrap(second) == "build", "next priority")

  let third = tq_next(q)
  assert(unwrap(third) == "deploy", "last")

  assert(tq_pending(q) == 0, "none pending")
  assert(tq_completed(q) == 3, "3 completed")
  assert(is_err(tq_next(q)), "empty = err")

  print("taskqx: all passed")
