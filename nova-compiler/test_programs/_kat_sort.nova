import std/core/sort

fn main() -> int
    let fails = 0
    let a = sort_ints([3, 1, 4, 1, 5, 9, 2, 6])
    if a[0] != 1
        print("FAIL sort_ints[0]")
        fails = fails + 1
    if a[7] != 9
        print("FAIL sort_ints[7]")
        fails = fails + 1
    if len(a) != 8
        print("FAIL sort_ints len")
        fails = fails + 1
    let d = sort_ints_desc([3, 1, 4, 1, 5])
    if d[0] != 5
        print("FAIL desc[0]")
        fails = fails + 1
    if d[4] != 1
        print("FAIL desc[4]")
        fails = fails + 1
    let s = sort_strings(["banana", "apple", "cherry"])
    if s[0] != "apple"
        print("FAIL sort_strings[0]")
        fails = fails + 1
    if s[2] != "cherry"
        print("FAIL sort_strings[2]")
        fails = fails + 1
    // sort_by with a comparison closure (descending)
    let b = sort_by([3, 1, 4, 1, 5], fn(x, y) x > y)
    if b[0] != 5
        print("FAIL sort_by desc[0]")
        fails = fails + 1
    if b[4] != 1
        print("FAIL sort_by desc[4]")
        fails = fails + 1
    // empty + single
    if len(sort_ints([])) != 0
        print("FAIL sort empty")
        fails = fails + 1
    if sort_ints([7])[0] != 7
        print("FAIL sort single")
        fails = fails + 1
    if fails == 0
        print("PASS _kat_sort")
    else
        print("FAILED _kat_sort")
    return 0
