import std/math/combinations

// cki — check integer equality
fn cki(label: string, got: int, expected: int)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// cks — check string equality
fn cks(label: string, got: string, expected: string)
    if got != expected
        print("FAIL " + label + ": got " + got + " expected " + expected)
        exit(1)

// list_to_str — flatten a list to a string for comparison
fn list_to_str(xs)
    let s = "["
    let i = 0
    let n = len(xs)
    while i < n
        if i > 0
            s = s + ","
        s = s + str(xs[i])
        i = i + 1
    s = s + "]"
    s

// sublist_to_str — convert a list-of-lists to a string
fn sublist_to_str(xss)
    let s = "["
    let i = 0
    let n = len(xss)
    while i < n
        if i > 0
            s = s + ","
        s = s + list_to_str(xss[i])
        i = i + 1
    s = s + "]"
    s

fn main()
    // KAT 1: cm_combinations([1,2,3], 2) = [[1,2],[1,3],[2,3]]
    let xs3 = [1, 2, 3]
    let c2 = cm_combinations(xs3, 2)
    cki("comb_3_2_len", len(c2), 3)
    cks("comb_3_2_0", list_to_str(c2[0]), "[1,2]")
    cks("comb_3_2_1", list_to_str(c2[1]), "[1,3]")
    cks("comb_3_2_2", list_to_str(c2[2]), "[2,3]")

    // KAT 2: cm_combinations([1,2,3], 0) = [[]]
    let c0 = cm_combinations(xs3, 0)
    cki("comb_3_0_len", len(c0), 1)
    cks("comb_3_0_0", list_to_str(c0[0]), "[]")

    // KAT 3: cm_combinations([1,2,3], 3) = [[1,2,3]]
    let c3 = cm_combinations(xs3, 3)
    cki("comb_3_3_len", len(c3), 1)
    cks("comb_3_3_0", list_to_str(c3[0]), "[1,2,3]")

    // KAT 4: cm_combinations([1,2,3], 4) = [] (impossible)
    let c4 = cm_combinations(xs3, 4)
    cki("comb_3_4_len", len(c4), 0)

    // KAT 5: len(cm_permutations([1,2,3])) = 6
    let p3 = cm_permutations(xs3)
    cki("perm_3_len", len(p3), 6)

    // KAT 6: cm_permutations([1,2]) = [[1,2],[2,1]]
    let xs2 = [1, 2]
    let p2 = cm_permutations(xs2)
    cki("perm_2_len", len(p2), 2)
    cks("perm_2_0", list_to_str(p2[0]), "[1,2]")
    cks("perm_2_1", list_to_str(p2[1]), "[2,1]")

    // KAT 7: len(cm_power_set([1,2,3])) = 8
    let ps3 = cm_power_set(xs3)
    cki("pset_3_len", len(ps3), 8)

    // KAT 8: cm_power_set([1]) = [[],[1]]
    let xs1 = [1]
    let ps1 = cm_power_set(xs1)
    cki("pset_1_len", len(ps1), 2)
    cks("pset_1_0", list_to_str(ps1[0]), "[]")
    cks("pset_1_1", list_to_str(ps1[1]), "[1]")

    // KAT 9: cm_power_set([]) = [[]]
    let xs0 = []
    let ps0 = cm_power_set(xs0)
    cki("pset_0_len", len(ps0), 1)
    cks("pset_0_0", list_to_str(ps0[0]), "[]")

    // KAT 10: cm_combinations with strings — [a,b,c] choose 2
    let ss = ["a", "b", "c"]
    let sc2 = cm_combinations(ss, 2)
    cki("comb_str_len", len(sc2), 3)
    cks("comb_str_0", list_to_str(sc2[0]), "[a,b]")
    cks("comb_str_1", list_to_str(sc2[1]), "[a,c]")
    cks("comb_str_2", list_to_str(sc2[2]), "[b,c]")

    // KAT 11: cm_permutations of empty list = [[]]
    let pe = cm_permutations(xs0)
    cki("perm_0_len", len(pe), 1)
    cks("perm_0_0", list_to_str(pe[0]), "[]")

    print("_combinations_test passed")
