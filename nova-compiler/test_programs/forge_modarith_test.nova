import forge_modarith

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn main()
    let fails = 0

    // ext_gcd: 30x + 18y = 6
    let e = ext_gcd(30, 18)
    fails = fails + expect("extgcd_g", str(e[0]), "6")
    fails = fails + expect_true("extgcd_bezout", 30 * e[1] + 18 * e[2] == 6)
    // 35 and 15 -> gcd 5
    let e2 = ext_gcd(35, 15)
    fails = fails + expect("extgcd2", str(e2[0]), "5")
    fails = fails + expect_true("extgcd2_bezout", 35 * e2[1] + 15 * e2[2] == 5)

    // gcd
    fails = fails + expect("gcd", str(gcd(48, 36)), "12")
    fails = fails + expect("gcd_coprime", str(gcd(17, 5)), "1")

    // modular inverse
    fails = fails + expect("inv_3_11", str(mod_inverse(3, 11)), "4")
    fails = fails + expect("inv_7_26", str(mod_inverse(7, 26)), "15")
    fails = fails + expect("inv_none", str(mod_inverse(2, 4)), "-1")
    // verify: a * inv mod m == 1
    let inv = mod_inverse(17, 3120)
    fails = fails + expect_true("inv_verify", (17 * inv) % 3120 == 1)

    // Chinese Remainder Theorem - classic Sun Tzu: x≡2(3), x≡3(5), x≡2(7) -> 23
    fails = fails + expect("crt_suntzu", str(crt([2, 3, 2], [3, 5, 7])), "23")
    // x≡0(4), x≡3(5) -> 8
    fails = fails + expect("crt_2", str(crt([0, 3], [4, 5])), "8")
    // single congruence
    fails = fails + expect("crt_single", str(crt([4], [7])), "4")
    // non-coprime moduli -> -1
    fails = fails + expect("crt_noncoprime", str(crt([1, 2], [4, 6])), "-1")

    // verify CRT result satisfies all congruences
    let x = crt([1, 4, 6], [5, 7, 11])
    fails = fails + expect_true("crt_verify", x % 5 == 1 and x % 7 == 4 and x % 11 == 6)

    if fails == 0
        print("forge_modarith: all passed")
    else
        print("forge_modarith: " + str(fails) + " FAILED")
