import forge_eertree as ee

fn check(cond: bool, label: str)
    if cond == false
        print("FAIL: " + label)

fn is_palin(s: str) -> bool
    let n = len(s)
    let i = 0
    let j = n - 1
    while i < j
        if char_at(s, i) != char_at(s, j)
            return false
        i = i + 1
        j = j - 1
    return true

// Brute force: count DISTINCT palindromic substrings
fn brute_distinct_palindromes(s: str) -> int
    let n = len(s)
    let seen = {}
    let i = 0
    while i < n
        let j = i + 1
        while j <= n
            let sub = slice(s, i, j)
            if is_palin(sub)
                seen[sub] = 1
            j = j + 1
        i = i + 1
    return len(keys(seen))

// Brute force: occurrence count of a palindrome substring
fn brute_occurrences(s: str, p: str) -> int
    let n = len(s)
    let m = len(p)
    let cnt = 0
    let i = 0
    while i + m <= n
        if slice(s, i, i + m) == p
            cnt = cnt + 1
        i = i + 1
    return cnt

// TEST 1: known small cases
// "aba" distinct palindromes: a, b, aba = 3
let t1 = ee.ee_build("aba")
check(ee.ee_num_distinct_palindromes(t1) == 3, "aba has 3 distinct palindromes")

// "aaa" distinct: a, aa, aaa = 3
let t2 = ee.ee_build("aaa")
check(ee.ee_num_distinct_palindromes(t2) == 3, "aaa has 3 distinct palindromes")

// "abc" distinct: a, b, c = 3
let t3 = ee.ee_build("abc")
check(ee.ee_num_distinct_palindromes(t3) == 3, "abc has 3 distinct palindromes")

// "abacaba" distinct: a,b,c,aba,aca,bacab? let brute decide
let t4 = ee.ee_build("abacaba")
check(ee.ee_num_distinct_palindromes(t4) == brute_distinct_palindromes("abacaba"), "abacaba distinct matches brute")

// TEST 2: node count bound (<= n+2)
check(ee.ee_num_nodes(t4) <= 7 + 2, "abacaba nodes <= n+2")
check(ee.ee_num_nodes(t2) <= 3 + 2, "aaa nodes <= n+2")

// TEST 3: distinct palindromes list is correct
let palins = ee.ee_distinct_palindromes(t1)
check(len(palins) == 3, "aba palindrome list length 3")
// verify each is a palindrome and appears in "aba"
let all_palin = true
let i = 0
while i < len(palins)
    if is_palin(palins[i]) == false
        all_palin = false
    if brute_occurrences("aba", palins[i]) == 0
        all_palin = false
    i = i + 1
check(all_palin, "aba: all listed items are real palindromic substrings")

// TEST 4: DECISIVE brute-force cross-check on many strings for DISTINCT count AND list validity
let strings = ["aab", "banana", "racecar", "mississippi", "abcba", "aabbaabb", "level", "noon", "abababab", "xyzzyx"]
let ok = true
let si = 0
while si < len(strings)
    let s = strings[si]
    let tree = ee.ee_build(s)
    let exp = brute_distinct_palindromes(s)
    let got = ee.ee_num_distinct_palindromes(tree)
    if exp != got
        ok = false
        print("DISTINCT MISMATCH s=" + s + " exp=" + str(exp) + " got=" + str(got))
    // node bound
    if ee.ee_num_nodes(tree) > len(s) + 2
        ok = false
        print("NODE BOUND VIOLATED s=" + s)
    // verify the distinct-palindrome LIST has no duplicates, all palindromes, all present in s
    let plist = ee.ee_distinct_palindromes(tree)
    if len(plist) != exp
        ok = false
        print("LIST LEN MISMATCH s=" + s + " list=" + str(len(plist)) + " exp=" + str(exp))
    let seen = {}
    let k = 0
    while k < len(plist)
        let pp = plist[k]
        if is_palin(pp) == false
            ok = false
            print("NOT PALINDROME s=" + s + " p=" + pp)
        if brute_occurrences(s, pp) == 0
            ok = false
            print("NOT IN STRING s=" + s + " p=" + pp)
        if get(seen, pp, 0) == 1
            ok = false
            print("DUPLICATE IN LIST s=" + s + " p=" + pp)
        seen[pp] = 1
        k = k + 1
    si = si + 1
check(ok, "DECISIVE: distinct count + palindrome list valid for all test strings")

// TEST 5: occurrence counts cross-check
let occ_ok = true
let s5 = "abacabadabacaba"
let tree5 = ee.ee_build(s5)
let counts = ee.ee_occurrence_counts(tree5, s5)
let plist5 = ee.ee_distinct_palindromes(tree5)
let m = 0
while m < len(plist5)
    let pp = plist5[m]
    let expected = brute_occurrences(s5, pp)
    let got = get(counts, pp, 0)
    if expected != got
        occ_ok = false
        print("OCC MISMATCH p=" + pp + " exp=" + str(expected) + " got=" + str(got))
    m = m + 1
check(occ_ok, "DECISIVE: occurrence counts match brute for all palindromes in abacabadabacaba")

print("forge_eertree: KAT done")
