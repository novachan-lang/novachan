fn greet(name)
    print("Hello, {name}!")

fn max(a, b)
    if a > b a else b

fn fizzbuzz(n)
    for i in 1..n+1
        match (i % 3, i % 5)
            (0, 0) => print("FizzBuzz")
            (0, _) => print("Fizz")
            (_, 0) => print("Buzz")
            _      => print(i)

fn factorial(n)
    if n <= 1
        return 1
    n * factorial(n - 1)

greet("World")
print(max(10, 20))
fizzbuzz(30)
print(factorial(10))
