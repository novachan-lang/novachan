let s = "hello world"
if "world" in s
    print("string in: YES")
else
    print("string in: NO")

let d = {"a": 1, "b": 2}
if "a" in d
    print("dict in: YES")
else
    print("dict in: NO")

if "c" not in d
    print("dict not in: YES")
else
    print("dict not in: NO")

let lst = [10, 20, 30]
if 20 in lst
    print("list in: YES")
else
    print("list in: NO")

if 99 not in lst
    print("list not in: YES")
else
    print("list not in: NO")
