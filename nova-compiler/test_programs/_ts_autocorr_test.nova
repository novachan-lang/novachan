import std/math/ts_autocorr

fn approx(a: float, b: float, tol: float) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < tol
        return 1
    return 0

fn ckf(label: str, got: float, want: float, tol: float)
    if approx(got, want, tol) == 0
        print("FAIL " + label + " got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // KAT 1: lag=0 always returns 1.0
    let d1 = [1.0, 2.0, 3.0, 4.0]
    let r0 = ts_autocorr(d1, 0)
    ckf("ts_autocorr lag=0", r0, 1.0, 0.0001)

    // KAT 2: [1,2,3,4] lag=1 -> 0.25
    // mu=2.5, var_g=(2.25+0.25+0.25+2.25)=5.0
    // cov_lag1=(-1.5)(-0.5)+(-0.5)(0.5)+(0.5)(1.5)=0.75-0.25+0.75=1.25
    // r=1.25/5.0=0.25
    let r1 = ts_autocorr(d1, 1)
    ckf("ts_autocorr [1,2,3,4] lag=1", r1, 0.25, 0.05)

    // KAT 3: positive autocorr (ramp should be > 0)
    if r1 < 0.0
        print("FAIL ts_autocorr ramp should be positive, got=" + str(r1))
        exit(1)

    // KAT 4: constant series -> 0.0
    let d4 = [3.0, 3.0, 3.0, 3.0]
    let r4 = ts_autocorr(d4, 1)
    ckf("ts_autocorr constant lag=1", r4, 0.0, 0.0001)

    // KAT 5: lag >= n -> 0.0
    let d5 = [1.0, 2.0]
    let r5 = ts_autocorr(d5, 2)
    ckf("ts_autocorr lag>=n", r5, 0.0, 0.0001)

    // KAT 6: alternating series [1,-1,1,-1] lag=1 -> negative autocorr
    // mu=0.0, var_g=4.0
    // cov=(1*-1)+(-1*1)+(1*-1)= -1-1-1= -3
    // r=-3/4=-0.75
    let d6 = [1.0, -1.0, 1.0, -1.0]
    let r6 = ts_autocorr(d6, 1)
    ckf("ts_autocorr alternating lag=1", r6, -0.75, 0.05)

    print("PASS _ts_autocorr_test")
