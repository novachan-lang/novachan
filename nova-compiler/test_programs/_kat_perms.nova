// Ledger #18: file perms / symlinks (chmod/umask/symlink/readlink).
// chmod + umask are cross-platform (Windows maps chmod->read-only bit, _umask). symlink/readlink
// are POSIX-primary (Windows needs Developer Mode; readlink unsupported) -> exercised gracefully.
fn main() -> int
    let fails = 0
    let f = "_kat_perms_tmp.txt"
    write_file(f, "hello")

    // chmod: returns 1 on success (420 = 0o644; has the owner-write bit so the file stays deletable)
    if chmod(f, 420) != 1
        print("FAIL chmod")
        fails = fails + 1

    // umask returns the PREVIOUS mask. Use the write bit 128 (0o200 POSIX / _S_IWRITE Windows) so the
    // round-trip holds cross-platform (Windows _umask only honors the write bit, so 0o022 would collapse).
    let old = umask(128)
    let prev = umask(old)
    if prev != 128
        print("FAIL umask prev=" + str(prev))
        fails = fails + 1

    // symlink + readlink round-trip (POSIX). Where unsupported (Windows/no-privilege) symlink
    // returns 0 and we skip -- not a failure, the point is the builtins are wired + safe.
    let link = "_kat_perms_link"
    remove_file(link)
    if symlink(f, link) == 1
        let tgt = readlink(link)
        if tgt != f
            print("FAIL readlink tgt=" + tgt)
            fails = fails + 1
        remove_file(link)

    remove_file(f)
    if fails == 0
        print("PASS _kat_perms")
    else
        print("FAILED _kat_perms")
    return 0
