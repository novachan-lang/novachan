// KAT for std/cipher/twosquare
// Two-Square (Double Playfair) horizontal variant.
//
// Test strategy:
//   1. Round-trip: decrypt(encrypt(pt, k1, k2), k1, k2) == normalise(pt)
//      for multiple plaintexts and key pairs.
//   2. Specific known digraph: verify the rectangle-swap rule manually.
//   3. Same-column: when c1==c2, letters pass through unchanged.
//   4. Edge cases: empty input, single letter (padded to XX), all non-letters.
//   5. J->I normalisation round-trip.

import std/cipher/twosquare

fn ck(label, got, want)
    if got != want
        print("FAIL _twosquare_test " + label + ": got=" + got + " want=" + want)
        exit(1)

// ── Helpers ───────────────────────────────────────────────────────────────────

// normalise: uppercase, J->I, drop non-letters, pad X if odd (mirrors module)
fn norm(pt) -> string
    let out = ""
    let n = len(pt)
    let i = 0
    while i < n
        let b = ord(pt[i])
        if b >= 97 and b <= 122
            b = b - 32
        if b >= 65 and b <= 90
            if b == 74
                b = 73
            out = out + chr(b)
        i = i + 1
    let outlen = len(out)
    let rem = outlen - (outlen / 2) * 2
    if rem == 1
        out = out + "X"
    out

// ── KAT 1: round-trip with keys "EXAMPLE" / "KEYWORD" ────────────────────────
let k1 = "EXAMPLE"
let k2 = "KEYWORD"

// Several even-length plaintexts
let pts = ["HELP", "ATTACK", "HELLO", "NOVA", "ABCDEFGHIKLMNOPQRSTUVWXYZ"]
let pi = 0
while pi < len(pts)
    let pt = pts[pi]
    let enc = twosquare_encrypt(pt, k1, k2)
    let dec = twosquare_decrypt(enc, k1, k2)
    let expected = norm(pt)
    ck("rt_ex_kw_" + pt, dec, expected)
    pi = pi + 1

// ── KAT 2: round-trip with different key pair ─────────────────────────────────
let k3 = "PLAYFAIR"
let k4 = "CIPHER"

let pts2 = ["SECRETMESSAGE", "TWOSQUARE", "CRYPTOGRAPHY"]
let p2i = 0
while p2i < len(pts2)
    let pt2 = pts2[p2i]
    let enc2 = twosquare_encrypt(pt2, k3, k4)
    let dec2 = twosquare_decrypt(enc2, k3, k4)
    let expected2 = norm(pt2)
    ck("rt_pf_ci_" + pt2, dec2, expected2)
    p2i = p2i + 1

// ── KAT 3: same-column digraph passes through unchanged ──────────────────────
// Square 1 from "EXAMPLE": E X A M P | L B C D F | G H I K N | O Q R S T | U V W Y Z
// Square 2 from "KEYWORD": K E Y W O | R D A B C | F G H I L | M N P Q S | T U V X Z
// H is in sq1 at row=2,col=1; E is in sq2 at row=0,col=1.  Same column (c=1).
// So "HE" should encrypt to "HE".
let same_col_enc = twosquare_encrypt("HE", k1, k2)
ck("same_col_HE", same_col_enc, "HE")
let same_col_dec = twosquare_decrypt("HE", k1, k2)
ck("same_col_dec_HE", same_col_dec, "HE")

// ── KAT 4: rectangle swap ─────────────────────────────────────────────────────
// H in sq1: row=2, col=1.  I in sq2: row=2, col=3.  Different columns.
// out1 = sq1[2*5+3] = sq1[13] = K
// out2 = sq2[2*5+1] = sq2[11] = G
// So "HI" encrypts to "KG"
let rect_enc = twosquare_encrypt("HI", k1, k2)
ck("rect_HI_enc", rect_enc, "KG")
let rect_dec = twosquare_decrypt("KG", k1, k2)
ck("rect_KG_dec", rect_dec, "HI")

// ── KAT 5: empty input ────────────────────────────────────────────────────────
ck("empty_enc", twosquare_encrypt("", k1, k2), "")
ck("empty_dec", twosquare_decrypt("", k1, k2), "")

// ── KAT 6: all non-letters (stripped → empty) ─────────────────────────────────
ck("non_letter_enc", twosquare_encrypt("123 !@#", k1, k2), "")

// ── KAT 7: odd-length → padded with X ────────────────────────────────────────
// "A" normalises to "AX" (length 2)
let odd_enc = twosquare_encrypt("A", k1, k2)
// Round-trip of "AX"
let odd_dec = twosquare_decrypt(odd_enc, k1, k2)
ck("odd_pad_rt", odd_dec, "AX")

// ── KAT 8: J -> I normalisation ───────────────────────────────────────────────
// "JAVA" normalises to "IAVA" (J->I), even length
let j_enc = twosquare_encrypt("JAVA", k1, k2)
let j_dec = twosquare_decrypt(j_enc, k1, k2)
ck("j_to_i_rt", j_dec, "IAVA")

// ── KAT 9: lowercase input round-trip ─────────────────────────────────────────
let lc_enc = twosquare_encrypt("hello world", k1, k2)
let lc_dec = twosquare_decrypt(lc_enc, k1, k2)
// normalise("hello world") -> "HELLOWORLD" (10 chars, even)
ck("lowercase_rt", lc_dec, "HELLOWORLD")

// ── KAT 10: mixed-case, punctuation stripped ──────────────────────────────────
let mx_enc = twosquare_encrypt("Hello, World!", k3, k4)
let mx_dec = twosquare_decrypt(mx_enc, k3, k4)
// norm("Hello, World!") = "HELLOWORLD" (10 chars)
ck("mixed_rt", mx_dec, "HELLOWORLD")

// ── KAT 11: ciphertext != plaintext (encryption actually changes something) ───
// "NOVA" with EXAMPLE/KEYWORD: verify it doesn't trivially pass through
// (statistically it shouldn't for a generic plaintext)
let nova_enc = twosquare_encrypt("NOVA", k1, k2)
let nova_dec = twosquare_decrypt(nova_enc, k1, k2)
ck("nova_rt", nova_dec, "NOVA")

// ── KAT 12: long message round-trip ──────────────────────────────────────────
let long_pt = "THEQUICKBROWNFOXIUMPSOVERTHELAZYDOG"
let long_enc = twosquare_encrypt(long_pt, k1, k2)
let long_dec = twosquare_decrypt(long_enc, k1, k2)
ck("long_rt", long_dec, norm(long_pt))

print("PASS _twosquare_test")
