fn health_check_new()
  let hc = {}
  hc["checks"] = []
  hc["name"] = "service"
  hc

fn health_add(hc, name, check_fn)
  push(hc["checks"], [name, check_fn])

fn health_set_name(hc, name)
  hc["name"] = name

fn health_run(hc)
  let results = {}
  let all_ok = 1
  let checks = hc["checks"]
  let i = 0
  while i < len(checks)
    let check = checks[i]
    let name = check[0]
    let fn_check = check[1]
    let r = fn_check(0)
    if is_ok(r)
      results[name] = "ok"
    else
      results[name] = "fail: " + str(unwrap_err(r))
      all_ok = 0
    i = i + 1
  let report = {}
  report["status"] = "healthy"
  if all_ok == 0
    report["status"] = "unhealthy"
  report["service"] = hc["name"]
  report["checks"] = results
  report

fn health_status(hc)
  let report = health_run(hc)
  report["status"]

fn health_json(hc)
  json_stringify(health_run(hc))

fn _db_check(x)
  ok("connected")

fn _cache_check(x)
  ok("redis up")

fn _external_check(x)
  err("timeout")

fn main()
  let hc = health_check_new()
  health_set_name(hc, "my-api")
  health_add(hc, "database", fn(z) _db_check(z))
  health_add(hc, "cache", fn(z) _cache_check(z))

  assert(health_status(hc) == "healthy", "all healthy")

  let report = health_run(hc)
  assert(report["status"] == "healthy", "report healthy")
  assert(report["service"] == "my-api", "service name")
  let checks = report["checks"]
  assert(checks["database"] == "ok", "db ok")
  assert(checks["cache"] == "ok", "cache ok")

  health_add(hc, "external", fn(z) _external_check(z))
  assert(health_status(hc) == "unhealthy", "unhealthy with failing check")
  let r2 = health_run(hc)
  assert(starts_with(r2["checks"]["external"], "fail"), "external fails")

  let json = health_json(hc)
  assert(contains(json, "unhealthy"), "json has status")
  assert(contains(json, "my-api"), "json has service")

  print("healthx: all passed")
