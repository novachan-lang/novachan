import std/dp/dp_lcs

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

fn ckb(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

fn ckl(label, got, expected)
    let gl = len(got)
    let el = len(expected)
    if gl != el
        print("FAIL " + label + " len: got=" + str(gl) + " expected=" + str(el))
        exit(1)
    let i = 0
    while i < gl
        if got[i] != expected[i]
            print("FAIL " + label + " [" + str(i) + "]: got=" + str(got[i]) + " expected=" + str(expected[i]))
            exit(1)
        i = i + 1

fn main()
    // KAT 1: lcs_length([1,2,3],[1,3]) = 2
    let a1 = [1, 2, 3]
    let b1 = [1, 3]
    cki("lcs_length 1,2,3 / 1,3", lcs_length(a1, b1), 2)

    // KAT 2: lcs_length([1,2,3,4,5],[2,4]) = 2
    let a2 = [1, 2, 3, 4, 5]
    let b2 = [2, 4]
    cki("lcs_length 1..5 / 2,4", lcs_length(a2, b2), 2)

    // KAT 3: lcs_length([1,2,3],[4,5,6]) = 0  (disjoint)
    let a3 = [1, 2, 3]
    let b3 = [4, 5, 6]
    cki("lcs_length disjoint", lcs_length(a3, b3), 0)

    // KAT 4: lcs_length([],[1]) = 0  (empty a)
    let a4 = []
    let b4 = [1]
    cki("lcs_length empty/[1]", lcs_length(a4, b4), 0)

    // KAT 5: lcs_length([1,2,1,3],[1,3,1]) = 2
    let a5 = [1, 2, 1, 3]
    let b5 = [1, 3, 1]
    cki("lcs_length 1,2,1,3 / 1,3,1", lcs_length(a5, b5), 2)

    // KAT 6: lcs_sequence([1,2,3,4],[2,4]) = [2,4]
    let a6 = [1, 2, 3, 4]
    let b6 = [2, 4]
    let s6 = lcs_sequence(a6, b6)
    let e6 = [2, 4]
    ckl("lcs_sequence [1,2,3,4]/[2,4]", s6, e6)

    // KAT 7: lcs_length([1,2,3,4,5],[2,4]) = 2  (sanity from KAT6)
    cki("lcs_length [1,2,3,4]/[2,4]", lcs_length(a6, b6), 2)

    // KAT 8: lcs_sequence of identical lists
    let a8 = [5, 10, 15]
    let b8 = [5, 10, 15]
    let s8 = lcs_sequence(a8, b8)
    let e8 = [5, 10, 15]
    ckl("lcs_sequence identical", s8, e8)

    // KAT 9: lcs_sequence empty result when disjoint
    let s9 = lcs_sequence(a3, b3)
    let e9 = []
    ckl("lcs_sequence disjoint=empty", s9, e9)

    // KAT 10: lcs_length both empty
    let a10 = []
    let b10 = []
    cki("lcs_length both empty", lcs_length(a10, b10), 0)

    print("PASS _dp_lcs_test")
