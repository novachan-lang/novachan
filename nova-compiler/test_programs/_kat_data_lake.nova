import forge_data_lake

fn main()
    let d = dl_new()
    d = dl_add_layer(d, "raw", "json")
    d = dl_add_layer(d, "curated", "parquet")
    assert(dl_layer_count(d) == 2, "2 layers")

    let r1 = dl_ingest(d, "raw", "events/2024-01.json", "data1")
    assert(is_ok(r1), "ingest ok")
    d = unwrap(r1)

    let r2 = dl_ingest(d, "curated", "users.parquet", "data2")
    d = unwrap(r2)
    assert(dl_object_count(d) == 2, "2 objects")

    let r3 = dl_read(d, "raw", "events/2024-01.json")
    assert(is_ok(r3), "read ok")
    assert(unwrap(r3) == "data1", "correct data")

    let r4 = dl_read(d, "raw", "missing")
    assert(is_err(r4), "missing object is err")

    let r5 = dl_ingest(d, "unknown", "x", "y")
    assert(is_err(r5), "unknown layer is err")

    let fmt = dl_layer_format(d, "raw")
    assert(is_ok(fmt), "format ok")
    assert(unwrap(fmt) == "json", "raw=json")

    print("DATA-LAKE KAT PASS")
