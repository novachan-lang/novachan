import forge_aabb
fn main()
    let a = [0, 0, 10, 10]
    let b = [5, 5, 10, 10]
    let c = [20, 20, 5, 5]
    let touch = [10, 0, 5, 5]
    let inside = [2, 2, 3, 3]
    for pair in [[a, b], [a, c], [a, touch], [a, inside], [a, a], [a, [0,0,0,0]]]
        print("isect=" + str(aabb_intersects(pair[0], pair[1])) + " contains=" + str(aabb_contains(pair[0], pair[1])) + " inter=" + str(aabb_intersection(pair[0], pair[1])))
    for pt in [[0.0, 0.0], [5.0, 5.0], [10.0, 10.0], [9.9, 9.9], [0 - 1.0, 5.0], [10.0, 5.0]]
        print("pt=" + str(aabb_contains_point(a, pt[0], pt[1])))
    print("EXERCISE-DONE")
