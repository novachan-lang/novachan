fn status_text(code)
  if code == 200
    return "OK"
  if code == 201
    return "Created"
  if code == 204
    return "No Content"
  if code == 301
    return "Moved Permanently"
  if code == 302
    return "Found"
  if code == 304
    return "Not Modified"
  if code == 400
    return "Bad Request"
  if code == 401
    return "Unauthorized"
  if code == 403
    return "Forbidden"
  if code == 404
    return "Not Found"
  if code == 405
    return "Method Not Allowed"
  if code == 409
    return "Conflict"
  if code == 422
    return "Unprocessable Entity"
  if code == 429
    return "Too Many Requests"
  if code == 500
    return "Internal Server Error"
  if code == 502
    return "Bad Gateway"
  if code == 503
    return "Service Unavailable"
  if code == 504
    return "Gateway Timeout"
  "Unknown"

fn is_success(code)
  code >= 200 and code < 300

fn is_redirect(code)
  code >= 300 and code < 400

fn is_client_error(code)
  code >= 400 and code < 500

fn is_server_error(code)
  code >= 500 and code < 600

fn status_line(code)
  "HTTP/1.1 " + str(code) + " " + status_text(code)

fn main()
  assert(status_text(200) == "OK", "200")
  assert(status_text(404) == "Not Found", "404")
  assert(status_text(500) == "Internal Server Error", "500")
  assert(status_text(999) == "Unknown", "unknown")

  assert(is_success(200) == 1, "200 success")
  assert(is_success(201) == 1, "201 success")
  assert(is_success(404) == 0, "404 not success")

  assert(is_redirect(301) == 1, "301 redirect")
  assert(is_redirect(200) == 0, "200 not redirect")

  assert(is_client_error(400) == 1, "400 client err")
  assert(is_client_error(404) == 1, "404 client err")
  assert(is_server_error(500) == 1, "500 server err")
  assert(is_server_error(503) == 1, "503 server err")

  assert(status_line(200) == "HTTP/1.1 200 OK", "status line 200")
  assert(status_line(404) == "HTTP/1.1 404 Not Found", "status line 404")

  print("httpstatusx: all passed")
