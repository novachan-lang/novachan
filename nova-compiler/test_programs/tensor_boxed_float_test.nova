// Regression: a float tensor built from a PUSH-built list (list<Any>, boxed floats)
// must matmul identically to one built from a list literal (list<float>, raw bits).
// Bug history: tensor_from_list read list backing storage raw, so boxed floats from
// push were stored as box-pointer bits -> matmul produced ~1e-311 garbage. The print
// path masked it (any_to_str re-unboxed the still-alive box pointers). Fixed by
// unboxing each element via nova_elem_to_double in the runtime.
fn build_w()
    let flat = []
    flat.push(1.0)
    flat.push(2.0)
    flat.push(0.0)
    flat.push(0.0)
    flat.push(1.0)
    flat.push(1.0)
    tensor_from_list(flat, [2, 3])

fn main()
    // pushed-list path (boxed floats)
    let w = build_w()
    let x = tensor_from_list([1.0, 2.0], [1, 2])
    let logits = tensor_to_list(tensor_matmul(x, w))
    // [1,2] @ [[1,2,0],[0,1,1]] = [1, 4, 2]
    assert_near(logits[0], 1.0, 0.001)
    assert_near(logits[1], 4.0, 0.001)
    assert_near(logits[2], 2.0, 0.001)

    // float values must survive a round-trip out of the tensor too
    let back = tensor_to_list(w)
    assert_near(back[0], 1.0, 0.001)
    assert_near(back[1], 2.0, 0.001)
    assert_near(back[2], 0.0, 0.001)
    assert_near(back[4], 1.0, 0.001)
    print("tensor boxed-float test passed")
