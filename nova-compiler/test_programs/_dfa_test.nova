import std/automata/dfa

fn main()
    // Build a DFA over {0,1} that accepts strings ending in "1".
    // States: q0 (start, non-accepting), q1 (accepting).
    // Transitions: q0-0->q0, q0-1->q1, q1-0->q0, q1-1->q1.
    let m = dfa.dfa_new("q0")
    dfa.dfa_add_transition(m, "q0", "0", "q0")
    dfa.dfa_add_transition(m, "q0", "1", "q1")
    dfa.dfa_add_transition(m, "q1", "0", "q0")
    dfa.dfa_add_transition(m, "q1", "1", "q1")
    dfa.dfa_set_accept(m, "q1")

    // KAT 1: "1" ends in 1 -> accept
    if dfa.dfa_accept(m, "1") == 0
        print("FAIL: dfa_accept(m,'1') expected 1 got 0")
        exit(1)

    // KAT 2: "101" ends in 1 -> accept
    if dfa.dfa_accept(m, "101") == 0
        print("FAIL: dfa_accept(m,'101') expected 1 got 0")
        exit(1)

    // KAT 3: "110" ends in 0 -> reject
    if dfa.dfa_accept(m, "110") == 1
        print("FAIL: dfa_accept(m,'110') expected 0 got 1")
        exit(1)

    // KAT 4: "" empty string -> start state q0 which is non-accepting -> reject
    if dfa.dfa_accept(m, "") == 1
        print("FAIL: dfa_accept(m,'') expected 0 got 1")
        exit(1)

    // KAT 5: "0" -> q0 (non-accepting) -> reject
    if dfa.dfa_accept(m, "0") == 1
        print("FAIL: dfa_accept(m,'0') expected 0 got 1")
        exit(1)

    // KAT 6: dfa_run(m,"11") should land in q1
    let final_state = dfa.dfa_run(m, "11")
    if final_state != "q1"
        print("FAIL: dfa_run(m,'11') expected q1 got " + final_state)
        exit(1)

    // KAT 7: DFA with a missing transition rejects on unknown symbol
    let m2 = dfa.dfa_new("s0")
    dfa.dfa_add_transition(m2, "s0", "a", "s1")
    dfa.dfa_set_accept(m2, "s1")
    // "ab" -> s0-a->s1, then "b" has no transition from s1 -> stuck -> reject
    if dfa.dfa_accept(m2, "ab") == 1
        print("FAIL: dfa_accept(m2,'ab') missing transition should reject, got 1")
        exit(1)
    // "a" -> s1 (accept) should still work
    if dfa.dfa_accept(m2, "a") == 0
        print("FAIL: dfa_accept(m2,'a') expected 1 got 0")
        exit(1)

    // KAT 8: dfa_states returns all registered states
    let st = dfa.dfa_states(m)
    // The "ends in 1" DFA has exactly q0 and q1
    if len(st) != 2
        print("FAIL: dfa_states(m) expected 2 states got " + str(len(st)))
        exit(1)

    print("_dfa_test passed")

main()
