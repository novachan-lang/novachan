// _kat_tx_panic -- what happens to a POOLED connection when a TRANSACTION BODY panics?
//
// KNOWN ANSWER: a connection whose transaction state is UNKNOWN must never be handed to another
// caller. Either it is rolled back before reuse, or it is discarded and replaced. What must NOT
// happen is the next borrower silently inheriting an open transaction.
//
// The concern: with_tx acquires (which REGISTERS a crash-safe RETURN-to-pool), runs BEGIN, then
// calls body_fn(db) -- USER code. On a panic there:
//   * `defer pool_release` does NOT run (defer is inlined at exit points; a panic longjmps past),
//   * but the registration from the acquire DOES fire, returning the connection to the pool,
//   * and neither COMMIT nor ROLLBACK ever ran.
// So the pool can hand out a connection sitting inside an abandoned transaction. On SQLite that
// holds a write lock (later writers get SQLITE_BUSY); on PostgreSQL/MySQL the next borrower's
// statements silently join a transaction they did not open, and are lost when it is finally
// rolled back.
//
// This KAT is deliberately written to REPORT rather than assume: it prints what actually happens so
// the behaviour is on record either way.

import forge_db
import sqlitex

fn census(ch) -> int
    let taken = []
    let going = 1
    while going == 1
        let r = select_timeout(ch, 300)
        if r[0] == 0
            push(taken, r[1])
        else
            going = 0
    for t in taken
        send(ch, t)
    len(taken)

// a transaction body that panics AFTER its write, i.e. between BEGIN and COMMIT
fn _panicking_body(db) -> any
    db_query(db, "INSERT INTO katx (v) VALUES (1)", [])
    let boom = unwrap(err("panic inside the transaction body"))
    ok(boom)

fn _run_tx(pool)
    let r = forge_db.with_tx(pool, fn(db) _panicking_body(db))
    print("    with_tx returned (unexpected): is_err={is_err(r)}")

fn main()
    let path = "_kat_tx_panic.db"
    let pool = forge_db.pool_open(path, 1)
    let c0 = recv(pool)
    db_query(c0, "DROP TABLE IF EXISTS katx", [])
    db_query(c0, "CREATE TABLE katx (v int)", [])
    send(pool, c0)

    print("pool at start        : {census(pool)}  (1 -- so the next borrower MUST reuse the SAME conn)")
    print("running a transaction whose BODY panics between BEGIN and COMMIT...")
    spawn _run_tx(pool)
    sleep(800)

    let after = census(pool)
    let fails = 0
    print("pool after the panic : {after}")
    if after != 0
        print("FAIL: the dirty connection was RETURNED to the pool ({after} of 1).")
        print("      The next borrower would silently join its abandoned transaction.")
        fails += 1
    else
        print("PASS: the connection was DISCARDED, not returned -- no contamination path.")

    // The abandoned transaction must not have committed either. Use a FRESH connection (the pool is
    // intentionally empty now) and a bounded wait, so a leaked write lock shows up as a failure
    // rather than hanging the test.
    let fresh = db_open(path)
    let rows = db_query(fresh, "SELECT count(*) AS n FROM katx", [])
    let seen = parse_int(str(rows[0][0])) if len(rows) > 0 else 0 - 1
    print("rows a FRESH connection sees: {seen}   (0 = the abandoned INSERT never committed)")
    if seen != 0
        print("FAIL: the abandoned transaction leaked data (expected 0, saw {seen})")
        fails += 1
    db_close(fresh)

    if fails == 0
        print("_kat_tx_panic passed")
    else
        print("_kat_tx_panic FAILED ({fails})")
        exit(1)
