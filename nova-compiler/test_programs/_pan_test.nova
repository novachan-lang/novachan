// KAT test for std/audio/pan.nova
//
// Hand-computed reference values:
//   pan_linear(1.0,  0.0) = [0.5, 0.5]     (center)
//   pan_linear(1.0, -1.0) = [1.0, 0.0]     (full left)
//   pan_linear(1.0,  1.0) = [0.0, 1.0]     (full right)
//   pan_linear(0.5,  0.0) = [0.25, 0.25]   (center, half amplitude)
//   pan_constant_power(1.0, 0.0): angle=PI/4; left=cos(PI/4)=sqrt(2)/2~0.7071; right same
//   pan_constant_power(1.0,-1.0): angle=0;   left=cos(0)=1.0; right=sin(0)=0.0
//   pan_constant_power(1.0, 1.0): angle=PI/2; left=cos(PI/2)=0.0; right=sin(PI/2)=1.0

import std/audio/pan

// approx: true if |a-b| < tol
fn approx(a: float, b: float, tol: float) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < tol
        return 1
    return 0

fn ckf(label: string, got: float, want: float)
    let ok = approx(got, want, 0.0001)
    if ok == 0
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // ── KAT 1: pan_linear(1.0, 0.0) == [0.5, 0.5] (center) ─────────────────
    let r1 = pan_linear(1.0, 0.0)
    cki("linear_center_len", len(r1), 2)
    let r1l = r1[0] * 1.0
    let r1r = r1[1] * 1.0
    ckf("linear_center_left",  r1l, 0.5)
    ckf("linear_center_right", r1r, 0.5)

    // ── KAT 2: pan_linear(1.0, -1.0) == [1.0, 0.0] (full left) ─────────────
    let r2 = pan_linear(1.0, 0.0 - 1.0)
    let r2l = r2[0] * 1.0
    let r2r = r2[1] * 1.0
    ckf("linear_full_left_L",  r2l, 1.0)
    ckf("linear_full_left_R",  r2r, 0.0)

    // ── KAT 3: pan_linear(1.0, 1.0) == [0.0, 1.0] (full right) ─────────────
    let r3 = pan_linear(1.0, 1.0)
    let r3l = r3[0] * 1.0
    let r3r = r3[1] * 1.0
    ckf("linear_full_right_L", r3l, 0.0)
    ckf("linear_full_right_R", r3r, 1.0)

    // ── KAT 4: pan_linear(0.5, 0.0) == [0.25, 0.25] (center, half ampl) ────
    let r4 = pan_linear(0.5, 0.0)
    let r4l = r4[0] * 1.0
    let r4r = r4[1] * 1.0
    ckf("linear_half_center_L", r4l, 0.25)
    ckf("linear_half_center_R", r4r, 0.25)

    // ── KAT 5: pan_linear(0.0, any) == [0.0, 0.0] (silent sample) ───────────
    let r5 = pan_linear(0.0, 0.5)
    let r5l = r5[0] * 1.0
    let r5r = r5[1] * 1.0
    ckf("linear_silent_L", r5l, 0.0)
    ckf("linear_silent_R", r5r, 0.0)

    // ── KAT 6: pan_constant_power(1.0, 0.0) center: L==R ~0.7071 ────────────
    // angle = (0+1)*PI/4 = PI/4; cos(PI/4)=sin(PI/4)=sqrt(2)/2=0.70710...
    let r6 = pan_constant_power(1.0, 0.0)
    let r6l = r6[0] * 1.0
    let r6r = r6[1] * 1.0
    ckf("cp_center_left",  r6l, 0.70711)
    ckf("cp_center_right", r6r, 0.70711)

    // ── KAT 7: pan_constant_power center: L == R (equal power symmetry) ─────
    let diffLR = r6l - r6r
    if diffLR < 0.0
        diffLR = 0.0 - diffLR
    let ok7 = approx(r6l, r6r, 0.0001)
    if ok7 == 0
        print("FAIL cp_center_equal_power: L=" + str(r6l) + " R=" + str(r6r))
        exit(1)

    // ── KAT 8: pan_constant_power(1.0, -1.0) == [1.0, 0.0] (full left) ─────
    // angle = (-1+1)*PI/4 = 0; cos(0)=1.0, sin(0)=0.0
    let r8 = pan_constant_power(1.0, 0.0 - 1.0)
    let r8l = r8[0] * 1.0
    let r8r = r8[1] * 1.0
    ckf("cp_full_left_L",  r8l, 1.0)
    ckf("cp_full_left_R",  r8r, 0.0)

    // ── KAT 9: pan_constant_power(1.0, 1.0) == [0.0, 1.0] (full right) ─────
    // angle = (1+1)*PI/4 = PI/2; cos(PI/2)=0.0, sin(PI/2)=1.0
    let r9 = pan_constant_power(1.0, 1.0)
    let r9l = r9[0] * 1.0
    let r9r = r9[1] * 1.0
    ckf("cp_full_right_L", r9l, 0.0)
    ckf("cp_full_right_R", r9r, 1.0)

    // ── KAT 10: pan_constant_power power conservation at center ──────────────
    // L^2 + R^2 should equal 1.0 (for unit sample, constant-power law)
    let lsq = r6l * r6l
    let rsq = r6r * r6r
    let power = lsq + rsq
    ckf("cp_power_conservation", power, 1.0)

    print("PASS _pan_test")
