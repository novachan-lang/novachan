// Cross-module soundness probe — the IMPORTED module.
// Declares an enum with 3 variants, a fn with a defaulted param, and a struct
// whose field name deliberately collides with the main file's struct at a
// DIFFERENT slot. Each exists to prove one of the 4 Phase-1 fixes.

enum XmColor
    XmRed(xr_v: int)
    XmGreen(xg_v: int)
    XmBlue(xb_v: int)

fn xm_make_red() -> XmColor
    XmRed(1)

fn xm_make_blue() -> XmColor
    XmBlue(3)

// Fix 1.3: a defaulted trailing param. Calling `mod.xm_greet("World")` used to
// be E1003 ("expects 2 arguments, but got 1") because the import scan recorded
// min_arity = len(params) instead of counting non-defaulted params.
fn xm_greet(name: string, greeting: string = "Hello") -> string
    greeting + ", " + name

fn xm_add(a: int, b: int = 10, c: int = 100) -> int
    a + b + c

// Fix 1.4: `xm_shared` sits at slot 1 here.
type XmFirst
    xm_shared: int
    xm_other: int

fn xm_make_first() -> XmFirst
    XmFirst(11, 22)
