import forge_hot_key_detector

fn main()
    let h = hk_new(3)
    h = hk_access(h, "key1")
    h = hk_access(h, "key1")
    assert(hk_is_hot(h, "key1") == 0, "not hot at 2")

    h = hk_access(h, "key1")
    assert(hk_is_hot(h, "key1") == 1, "hot at 3")
    assert(hk_hot_key_count(h) == 1, "1 hot key")

    h = hk_access(h, "key2")
    assert(hk_is_hot(h, "key2") == 0, "key2 not hot")

    let ac = hk_access_count(h, "key1")
    assert(is_ok(ac), "access count ok")
    assert(unwrap(ac) == 3, "3 accesses")

    assert(hk_total_accesses(h) == 4, "4 total")

    let bad = hk_access_count(h, "nope")
    assert(is_err(bad), "not tracked")

    print("HOT-KEY-DETECTOR KAT PASS")
