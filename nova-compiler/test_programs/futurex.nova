// futurex — future composition the NOVA way: thin combinators over the EXISTING
// async/await primitives (zero new runtime, zero coloring — strictly more NOVA-way
// than a runtime then() builtin). A chained future is just a new async that awaits
// the source then transforms it.

fn future_then(f, g)
    return async(fn() g(await(f)))      // run g after f completes, as a new future

fn future_map(f, g)
    return async(fn() g(await(f)))      // alias: transform the result

fn future_all(fs)
    return await_all(fs)                // join many (already shipped)

fn compute10()
    return 10
fn add_one(x)
    return x + 1
fn double_it(x)
    return x * 2

fn main()
    let f = async(fn() compute10())
    let f2 = future_then(f, add_one)
    assert_eq(await(f2), 11)

    // chain two transforms: (10 + 1) * 2 = 22
    let g = async(fn() compute10())
    let g2 = future_then(future_then(g, add_one), double_it)
    assert_eq(await(g2), 22)

    // join many futures
    let fs = [async(fn() 1), async(fn() 2), async(fn() 3)]
    let rs = future_all(fs)
    assert_eq(rs[0], 1)
    assert_eq(rs[1], 2)
    assert_eq(rs[2], 3)

    print("futurex passed")
