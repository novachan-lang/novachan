// _tar_ustar_test.nova — KAT for std/os/tar_ustar
import std/os/tar_ustar

fn ck_bool(label, got, want)
    if got != want
        let gs = "false"
        let ws = "false"
        if got
            gs = "true"
        if want
            ws = "true"
        print("FAIL tar_ustar " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn ck_int(label, got, want)
    if got != want
        print("FAIL tar_ustar " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck_str(label, got, want)
    if got != want
        print("FAIL tar_ustar " + label + ": got=" + got + " want=" + want)
        exit(1)

fn _pad(buf, n)
    while len(buf) < n
        push(buf, 0)

// Write a byte at a specific absolute position in an already-padded buffer.
fn _wb(buf, pos, v)
    buf[pos] = v

// Write an ASCII string into the buffer starting at pos, NUL-terminated.
fn _wstr(buf, pos, s)
    let i = 0
    while i < len(s)
        buf[pos + i] = ord(s[i])
        i = i + 1

// Write an octal-padded checksum (6 octal digits + NUL + space) at pos.
fn _write_chksum(buf, pos, v)
    // Build 6-digit zero-padded octal string for v.
    let digits = []
    let n = v
    let di = 0
    while di < 6
        let d = n - (n / 8) * 8
        push(digits, d)
        n = n / 8
        di = di + 1
    // digits is now LSB-first; write MSB-first
    let idx = 0
    while idx < 6
        buf[pos + idx] = 48 + digits[5 - idx]
        idx = idx + 1
    // NUL then space (standard ustar format)
    buf[pos + 6] = 0
    buf[pos + 7] = 32

fn main()
    // ── Build a 512-byte tar header block ────────────────────────────────────
    let buf = []
    _pad(buf, 512)

    // name: 'hi.txt' at offset 0
    // h=104, i=105, .=46, t=116, x=120, t=116
    _wb(buf, 0, 104)
    _wb(buf, 1, 105)
    _wb(buf, 2, 46)
    _wb(buf, 3, 116)
    _wb(buf, 4, 120)
    _wb(buf, 5, 116)

    // size: octal 12 = decimal 10, written as '00000000012' (11 chars) at offset 124
    // '0'=48 repeated 9 times, then '1'=49, '2'=50
    _wb(buf, 124, 48)
    _wb(buf, 125, 48)
    _wb(buf, 126, 48)
    _wb(buf, 127, 48)
    _wb(buf, 128, 48)
    _wb(buf, 129, 48)
    _wb(buf, 130, 48)
    _wb(buf, 131, 48)
    _wb(buf, 132, 48)
    _wb(buf, 133, 49)
    _wb(buf, 134, 50)

    // typeflag '0'=48 at offset 156
    _wb(buf, 156, 48)

    // magic 'ustar\0' at offset 257: u=117, s=115, t=116, a=97, r=114, NUL=0
    _wb(buf, 257, 117)
    _wb(buf, 258, 115)
    _wb(buf, 259, 116)
    _wb(buf, 260, 97)
    _wb(buf, 261, 114)
    _wb(buf, 262, 0)

    // Compute checksum and write to chksum field at 148
    let chksum = tar_checksum_calc(buf, 0)
    _write_chksum(buf, 148, chksum)

    // ── Assertions ─────────────────────────────────────────────────────────
    ck_bool("magic_check", tar_magic_check(buf, 0), true)
    ck_int("size", tar_size(buf, 0), 10)
    ck_int("typeflag_byte", tar_typeflag(buf, 0), 48)
    ck_str("typeflag_name", tar_typeflag_name(buf, 0), "regular")
    ck_str("name", tar_name(buf, 0), "hi.txt")
    ck_bool("checksum_valid", tar_checksum_valid(buf, 0), true)

    // ── Verify stored checksum equals computed ──────────────────────────────
    let stored = tar_checksum_stored(buf, 0)
    let calc = tar_checksum_calc(buf, 0)
    ck_int("checksum_round_trip", stored, calc)

    // ── Octal field parsing ─────────────────────────────────────────────────
    // Build another block to test mode/uid/gid fields
    let buf2 = []
    _pad(buf2, 512)
    // mode: '0000644\0' at 100 — octal 644 = decimal 420
    _wb(buf2, 100, 48)
    _wb(buf2, 101, 48)
    _wb(buf2, 102, 48)
    _wb(buf2, 103, 48)
    _wb(buf2, 104, 54)
    _wb(buf2, 105, 52)
    _wb(buf2, 106, 52)
    _wb(buf2, 107, 0)
    // uid: '0000001\0' at 108 — octal 1 = decimal 1
    _wb(buf2, 108, 48)
    _wb(buf2, 109, 48)
    _wb(buf2, 110, 48)
    _wb(buf2, 111, 48)
    _wb(buf2, 112, 48)
    _wb(buf2, 113, 48)
    _wb(buf2, 114, 49)
    _wb(buf2, 115, 0)
    // gid: '0000002\0' at 116 — octal 2 = decimal 2
    _wb(buf2, 116, 48)
    _wb(buf2, 117, 48)
    _wb(buf2, 118, 48)
    _wb(buf2, 119, 48)
    _wb(buf2, 120, 48)
    _wb(buf2, 121, 48)
    _wb(buf2, 122, 50)
    _wb(buf2, 123, 0)
    ck_int("mode_644", tar_mode(buf2, 0), 420)
    ck_int("uid_1", tar_uid(buf2, 0), 1)
    ck_int("gid_2", tar_gid(buf2, 0), 2)

    // ── typeflag variants ────────────────────────────────────────────────────
    let buf3 = []
    _pad(buf3, 512)
    _wb(buf3, 156, 53)
    ck_str("typeflag_dir", tar_typeflag_name(buf3, 0), "directory")

    let buf4 = []
    _pad(buf4, 512)
    _wb(buf4, 156, 50)
    ck_str("typeflag_symlink", tar_typeflag_name(buf4, 0), "symlink")

    // ── magic_check negative ─────────────────────────────────────────────────
    let buf5 = []
    _pad(buf5, 512)
    // magic with wrong first letter 'Ustar' (U=85, not u=117)
    _wb(buf5, 257, 85)
    _wb(buf5, 258, 115)
    _wb(buf5, 259, 116)
    _wb(buf5, 260, 97)
    _wb(buf5, 261, 114)
    ck_bool("magic_wrong", tar_magic_check(buf5, 0), false)

    print("PASS _tar_ustar_test")
