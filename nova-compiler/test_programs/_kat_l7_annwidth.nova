// KAT: LOCK-4 inc3c -- sized numerics reachable through the two spellings a developer
// actually writes: a TYPE ANNOTATION (`let y: u8 = 255`) and an EXPLICIT CONVERSION
// (`u8(x)`). Before this, only a suffixed literal (`255u8`) carried a width, so both of
// these silently produced a plain i64 and did not wrap.
fn take_u8(v: int) -> int
    v + 1

// a runtime (non-constant) source for the narrowing check
fn f_300() -> int
    300

fn main()
    let ok = 0
    let fail = 0

    // ── annotation bridge ────────────────────────────────────────────────
    let y: u8 = 255
    if y + 1 == 0
        ok = ok + 1
        print("ok: let y: u8 = 255 wraps at 8 bits")
    else
        fail = fail + 1
        print("FAIL annotated u8: " + str(y + 1))

    let s: i8 = 127
    if s + 1 == -128
        ok = ok + 1
        print("ok: let s: i8 = 127 sign-extends to -128")
    else
        fail = fail + 1
        print("FAIL annotated i8: " + str(s + 1))

    let w: u16 = 65535
    if w + 1 == 0
        ok = ok + 1
        print("ok: let w: u16 = 65535 wraps at 16 bits")
    else
        fail = fail + 1
        print("FAIL annotated u16: " + str(w + 1))

    let d: u32 = 4294967295
    if d + 1 == 0
        ok = ok + 1
        print("ok: let d: u32 wraps at 32 bits")
    else
        fail = fail + 1
        print("FAIL annotated u32: " + str(d + 1))

    // ── explicit conversion carries the width ───────────────────────────
    let a = u8(255)
    let b = i8(127)
    let c = u16(65535)
    if a + 1 == 0 and b + 1 == -128 and c + 1 == 0
        ok = ok + 1
        print("ok: u8()/i8()/u16() results carry their width")
    else
        fail = fail + 1
        print("FAIL conversions: " + str(a + 1) + " " + str(b + 1) + " " + str(c + 1))

    // conversion of a runtime (non-constant) value, not just a literal
    let n = 200
    let m = u8(n + 100)
    if m == 44
        ok = ok + 1
        print("ok: u8() masks a runtime value (300 -> 44)")
    else
        fail = fail + 1
        print("FAIL runtime conversion: " + str(m))

    // ── an OUT-OF-RANGE initialiser is genuinely NARROWED, not just tagged ─
    // This is the difference between the annotation being a real type and being a
    // label: the IR builder's pre-existing bridge width-TAGGED the slot without
    // masking the value, so `let a: u8 = 300` would have claimed u8 while holding
    // 300. Lowering through the conversion masks it.
    let big_a: u8 = 300
    let big_b: u8 = f_300()
    let big_c: i8 = 200
    if big_a == 44 and big_b == 44 and big_c == -56
        ok = ok + 1
        print("ok: out-of-range initialisers narrow (const and runtime alike)")
    else
        fail = fail + 1
        print("FAIL narrowing: " + str(big_a) + " " + str(big_b) + " " + str(big_c))

    // ── the previously-working paths must NOT regress ───────────────────
    let lit = 255u8
    let acc = 0u8
    let i = 0
    while i < 3
        acc = acc + 100u8
        i = i + 1
    if 255u8 + 1 == 0 and lit + 1 == 0 and acc == 44 and 200u8 + 100u8 == 44
        ok = ok + 1
        print("ok: suffixed literals, sized vars and loop-carried sized vars unchanged")
    else
        fail = fail + 1
        print("FAIL inc3b regression")

    // ── DEFAULT int must stay 64-bit ────────────────────────────────────
    let big = 255
    let plain: int = 255
    if 255 + 1 == 256 and big + 1 == 256 and plain + 1 == 256 and take_u8(255) == 256
        ok = ok + 1
        print("ok: unannotated/int-annotated values stay 64-bit")
    else
        fail = fail + 1
        print("FAIL default int changed: " + str(big + 1) + " " + str(plain + 1))

    print("ok=" + str(ok) + " fail=" + str(fail))
    assert(fail == 0, "l7_annwidth: all checks pass")
    assert(ok == 9, "l7_annwidth: all 9 checks ran")
    print("KAT l7_annwidth PASS")
