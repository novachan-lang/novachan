import forge_merge3

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn joinl(xs: list) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + "|"
        out = out + xs[i]
        i = i + 1
    out

fn main()
    let fails = 0

    // no changes -> base unchanged, 0 conflicts
    let r1 = merge3(["a", "b", "c"], ["a", "b", "c"], ["a", "b", "c"])
    fails = fails + expect("nochange", joinl(r1[0]), "a|b|c")
    fails = fails + expect("nochange_conf", str(r1[1]), "0")

    // only ours changes middle line -> take ours, no conflict
    let r2 = merge3(["a", "b", "c"], ["a", "B", "c"], ["a", "b", "c"])
    fails = fails + expect("ours_only", joinl(r2[0]), "a|B|c")
    fails = fails + expect("ours_only_conf", str(r2[1]), "0")

    // only theirs changes -> take theirs
    let r3 = merge3(["a", "b", "c"], ["a", "b", "c"], ["a", "b", "C"])
    fails = fails + expect("theirs_only", joinl(r3[0]), "a|b|C")

    // non-overlapping changes on both sides merge cleanly
    let r4 = merge3(["a", "b", "c"], ["A", "b", "c"], ["a", "b", "C"])
    fails = fails + expect("nonoverlap", joinl(r4[0]), "A|b|C")
    fails = fails + expect("nonoverlap_conf", str(r4[1]), "0")

    // both make the SAME change -> collapse, no conflict
    let r5 = merge3(["a", "b", "c"], ["a", "X", "c"], ["a", "X", "c"])
    fails = fails + expect("same_change", joinl(r5[0]), "a|X|c")
    fails = fails + expect("same_change_conf", str(r5[1]), "0")

    // conflicting different edits to the same line -> conflict markers
    let r6 = merge3(["a", "b", "c"], ["a", "B", "c"], ["a", "X", "c"])
    fails = fails + expect("conflict", joinl(r6[0]), "a|<<<<<<< ours|B|=======|X|>>>>>>> theirs|c")
    fails = fails + expect("conflict_conf", str(r6[1]), "1")

    // ours adds a line, theirs unchanged -> take the addition
    let r7 = merge3(["a", "c"], ["a", "b", "c"], ["a", "c"])
    fails = fails + expect("insert", joinl(r7[0]), "a|b|c")

    // both delete same line -> deleted
    let r8 = merge3(["a", "b", "c"], ["a", "c"], ["a", "c"])
    fails = fails + expect("both_delete", joinl(r8[0]), "a|c")

    if fails == 0
        print("forge_merge3: all passed")
    else
        print("forge_merge3: " + str(fails) + " FAILED")
