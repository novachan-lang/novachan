import unitext

fn main()
    // é precomposed (U+00E9) vs decomposed (e + U+0301 combining acute)
    let pre = from_codepoint(233)
    let dec = normalize_nfd(pre)
    assert(not (pre == dec), "the two forms are byte-different (raw == fails)")
    assert(unitext.nfc_eq(pre, dec) == 1, "canonically equal under NFC")
    assert(unitext.nfd_eq(pre, dec) == 1, "canonically equal under NFD")
    assert(unitext.canon_eq(pre, dec) == 1, "canon_eq")

    // is_nfc / is_nfd
    assert(unitext.is_nfc(pre) == 1, "precomposed is NFC")
    assert(unitext.is_nfc(dec) == 0, "decomposed is not NFC")
    assert(unitext.is_nfd(dec) == 1, "decomposed is NFD")

    // realistic word: "café" precomposed vs decomposed
    let cafe_pre = "caf" + from_codepoint(233)
    let cafe_dec = "cafe" + from_codepoint(769)
    assert(not (cafe_pre == cafe_dec), "café forms byte-differ")
    assert(unitext.nfc_eq(cafe_pre, cafe_dec) == 1, "café canonically equal")

    // plain ASCII behaves like ==
    assert(unitext.nfc_eq("hello", "hello") == 1, "ascii equal")
    assert(unitext.nfc_eq("hello", "hallo") == 0, "ascii not equal")

    // caseless canonical (ASCII fold)
    assert(unitext.ci_canon_eq("Hello", "hello") == 1, "caseless equal")
    assert(unitext.ci_canon_eq(cafe_pre, "CAFE" + from_codepoint(769)) == 1, "caseless + canonical café")

    print("unitext_lib_test: all passed")
