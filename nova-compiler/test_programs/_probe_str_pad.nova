fn main()
    let p1 = str_pad_left("42", 5, "0")
    print("pad_left: [" + p1 + "]")
    let p2 = str_pad_right("hi", 8, ".")
    print("pad_right: [" + p2 + "]")
    let p3 = str_center("ok", 10, "-")
    print("center: [" + p3 + "]")
    let p4 = str_pad_left("hello", 3, " ")
    print("no-op: [" + p4 + "]")
    if p1 == "00042" and p2 == "hi......" and p3 == "----ok----" and p4 == "hello"
        print("ALL PASS")
    else
        print("FAIL")
