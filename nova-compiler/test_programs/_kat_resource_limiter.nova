import forge_resource_limiter

fn main()
    let r = rlim_new()
    r = rlim_add(r, "cpu", 100)
    r = rlim_add(r, "memory", 512)
    assert(rlim_resource_count(r) == 2, "2 resources")

    let a1 = rlim_acquire(r, "cpu", 60)
    assert(is_ok(a1), "acquire ok")
    r = unwrap(a1)

    let u = rlim_usage(r, "cpu")
    assert(unwrap(u) == 60, "60 used")

    let rem = rlim_remaining(r, "cpu")
    assert(unwrap(rem) == 40, "40 remaining")

    let a2 = rlim_acquire(r, "cpu", 50)
    assert(is_err(a2), "limit exceeded")
    assert(rlim_violation_count(r) == 1, "1 violation")

    let rel = rlim_release(r, "cpu", 30)
    assert(is_ok(rel), "release ok")
    r = unwrap(rel)
    let u2 = rlim_usage(r, "cpu")
    assert(unwrap(u2) == 30, "30 after release")

    let bad = rlim_acquire(r, "nope", 1)
    assert(is_err(bad), "not found")

    print("RESOURCE-LIMITER KAT PASS")
