import forge_dashboard_widget

fn main()
    let dw = dw_new()
    dw = dw_add(dw, "cpu_chart", "line", "metrics.cpu")
    dw = dw_add(dw, "mem_gauge", "gauge", "metrics.mem")
    dw = dw_add(dw, "log_table", "table", "logs.recent")
    assert(dw_widget_count(dw) == 3, "3 widgets")
    assert(dw_visible_count(dw) == 3, "3 visible")

    let t1 = dw_get_type(dw, "cpu_chart")
    assert(is_ok(t1), "type ok")
    assert(unwrap(t1) == "line", "cpu is line")

    let s1 = dw_get_source(dw, "mem_gauge")
    assert(unwrap(s1) == "metrics.mem", "mem source")

    assert(dw_has_widget(dw, "cpu_chart") == 1, "has cpu_chart")
    assert(dw_has_widget(dw, "nope") == 0, "no nope")

    let v1 = dw_is_visible(dw, "log_table")
    assert(unwrap(v1) == 1, "visible initially")

    let h1 = dw_set_visible(dw, "log_table", 0)
    dw = unwrap(h1)
    assert(dw_visible_count(dw) == 2, "2 visible after hide")

    let v2 = dw_is_visible(dw, "log_table")
    assert(unwrap(v2) == 0, "hidden now")

    let bad = dw_get_type(dw, "nope")
    assert(is_err(bad), "unknown widget")

    let wl = dw_widget_list(dw)
    assert(find(wl, "cpu_chart") >= 0, "has cpu in list")

    print("DASHBOARD-WIDGET KAT PASS")
