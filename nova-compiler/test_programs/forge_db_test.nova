// forge_db_test -- the optional Forge data layer end-to-end: a connection pool over SQLite,
// parameterized (injection-safe) queries, and a transaction. Real DB round-trip through a file DB
// (so pooled connections share data).
import forge_db

fn main()
    let pool = forge_db.pool_open("_fdb_test.db", 2)
    forge_db.pool_exec(pool, "DROP TABLE IF EXISTS users")
    forge_db.pool_exec(pool, "CREATE TABLE users (id INTEGER, name TEXT)")

    // parameterized inserts (injection-safe)
    forge_db.pool_query(pool, "INSERT INTO users VALUES (?, ?)", [1, "ada"])
    forge_db.pool_query(pool, "INSERT INTO users VALUES (?, ?)", [2, "bob"])

    let rows = forge_db.pool_query(pool, "SELECT id, name FROM users ORDER BY id", [])
    assert(len(rows) == 2, "two rows inserted + selected")
    assert(rows[0][1] == "ada", "row0 name = ada")
    assert(rows[1][1] == "bob", "row1 name = bob")
    print("PASS: pool open + DDL + parameterized insert/select")

    // a param query cannot be injected (the value is bound, not concatenated)
    let evil = forge_db.pool_query(pool, "SELECT name FROM users WHERE name = ?", ["bob' OR '1'='1"])
    assert(len(evil) == 0, "injection attempt binds as a literal -> no rows")
    print("PASS: parameterized query is injection-safe")

    // transaction: two inserts atomically
    forge_db.tx(pool, [["INSERT INTO users VALUES (?, ?)", [3, "cy"]], ["INSERT INTO users VALUES (?, ?)", [4, "di"]]])
    let after = forge_db.pool_query(pool, "SELECT count(*) FROM users", [])
    assert(after[0][0] == "4", "tx committed both rows (count = 4)")
    print("PASS: transaction commit")

    forge_db.pool_close(pool, 2)
    print("forge_db_test passed")
