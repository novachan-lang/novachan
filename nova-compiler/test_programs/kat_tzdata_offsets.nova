import std/time/tz

fn check(label, got, want) -> int
    if got != want
        print("FAIL " + label + " got=" + str(got) + " want=" + str(want))
        exit(1)
    0

fn main()
    let jan = 1609459200  // 2021-01-01T00:00:00Z
    let jul = 1625097600  // 2021-07-01T00:00:00Z

    check("UTC-jan", tz_offset_at(jan, "UTC"), 0)
    check("UTC-jul", tz_offset_at(jul, "UTC"), 0)

    check("NY-jan-EST", tz_offset_at(jan, "America/New_York"), -18000)
    check("NY-jul-EDT", tz_offset_at(jul, "America/New_York"), -14400)

    check("London-jan-GMT", tz_offset_at(jan, "Europe/London"), 0)
    check("London-jul-BST", tz_offset_at(jul, "Europe/London"), 3600)

    check("Kolkata-jan", tz_offset_at(jan, "Asia/Kolkata"), 19800)
    check("Kolkata-jul", tz_offset_at(jul, "Asia/Kolkata"), 19800)

    check("Sydney-jan-AEDT", tz_offset_at(jan, "Australia/Sydney"), 39600)
    check("Sydney-jul-AEST", tz_offset_at(jul, "Australia/Sydney"), 36000)

    print("PASS kat_tzdata_offsets")
