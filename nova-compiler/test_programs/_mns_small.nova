// M:N park-commit race stress: many tasks (>> carriers) hammering the yield_runnable path via
// reschedule(), to widen the pop-vs-resume window at NOVA_CARRIERS>1. With the park-then-commit fix,
// no carrier resumes a task still mid-SwitchToFiber. The always-on double-resume guard (N>1) aborts on
// any residual race; ASAN catches stack corruption. Clean completion at N=4 under ASAN = strong evidence.
fn churn_task(hub, id, iters)
    let i = 0
    while i < iters
        reschedule()
        i = i + 1
    send(hub, id)

fn main()
    let hub = channel()
    let n = 30          // 500 tasks >> 4 carriers (high oversubscription)
    let iters = 30      // 500 * 200 = 100k yield_runnable calls total
    let k = 0
    while k < n
        spawn churn_task(hub, k, iters)
        k = k + 1
    let got = 0
    let sum = 0
    while got < n
        sum = sum + receive(hub)
        got = got + 1
    assert(sum == n * (n - 1) / 2, "all tasks finished and delivered")
    print("MN_STRESS_OK n=" + str(n))
