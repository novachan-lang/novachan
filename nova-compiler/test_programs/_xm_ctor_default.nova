// PROBE: Fix 1.2 (cross-module enum ctor) + Fix 1.3 (cross-module default params).
// Both MUST compile and run. Before the fix, the bare ctor `XmRed(7)` was E1002
// and `xm_greet("World")` (omitting the defaulted arg) was E1003.
import _xm_soundness_mod

fn main()
    // Fix 1.2: bare constructor of an IMPORTED enum's variant.
    let c = XmRed(7)
    match c
        XmRed(v) => print("ctor-ok red " + str(v))
        XmGreen(v) => print("ctor-BAD green")
        XmBlue(v) => print("ctor-BAD blue")

    // Fix 1.2: exhaustive match over a value produced by the imported module.
    let d = _xm_soundness_mod.xm_make_blue()
    match d
        XmRed(v) => print("mod-BAD red")
        XmGreen(v) => print("mod-BAD green")
        XmBlue(v) => print("mod-ok blue " + str(v))

    // Fix 1.3: omit the defaulted trailing arg across the module boundary.
    print(_xm_soundness_mod.xm_greet("World"))
    print(_xm_soundness_mod.xm_greet("World", "Hi"))

    // Fix 1.3: two defaulted params, omit both / one / none.
    print("add1=" + str(_xm_soundness_mod.xm_add(1)))
    print("add2=" + str(_xm_soundness_mod.xm_add(1, 2)))
    print("add3=" + str(_xm_soundness_mod.xm_add(1, 2, 3)))
