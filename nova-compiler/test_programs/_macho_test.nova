import std/os/macho

fn ck_bool(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL _macho_test " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn ck_int(label: string, got: int, want: int)
    if got != want
        print("FAIL _macho_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck_str(label: string, got: string, want: string)
    if got != want
        print("FAIL _macho_test " + label + ": got=" + got + " want=" + want)
        exit(1)

// Build 64-bit LE x86_64 EXECUTE Mach-O header
// magic: 0xCF,0xFA,0xED,0xFE (MH_CIGAM_64, little-endian 64-bit)
// cputype u32le: 0x01000007 = [7,0,0,1]
// cpusubtype u32le: [3,0,0,0]
// filetype u32le: 2 = [2,0,0,0]
let hdr = []
push(hdr, 0xCF)
push(hdr, 0xFA)
push(hdr, 0xED)
push(hdr, 0xFE)
push(hdr, 7)
push(hdr, 0)
push(hdr, 0)
push(hdr, 1)
push(hdr, 3)
push(hdr, 0)
push(hdr, 0)
push(hdr, 0)
push(hdr, 2)
push(hdr, 0)
push(hdr, 0)
push(hdr, 0)

ck_bool("magic_check", macho_magic_check(hdr), true)
ck_bool("is_64", macho_is_64(hdr), true)
ck_bool("is_le", macho_is_le(hdr), true)
ck_bool("is_fat", macho_is_fat(hdr), false)
ck_int("cputype", macho_cputype(hdr), 16777223)
ck_str("cputype_name", macho_cputype_name(hdr), "x86_64")
ck_int("filetype", macho_filetype(hdr), 2)
ck_str("filetype_name", macho_filetype_name(hdr), "EXECUTE")
ck_bool("is_valid", macho_is_valid(hdr), true)
ck_str("magic_name", macho_magic_name(hdr), "MH_CIGAM_64")

// Test FAT magic: 0xCA,0xFE,0xBA,0xBE
let fat = []
push(fat, 0xCA)
push(fat, 0xFE)
push(fat, 0xBA)
push(fat, 0xBE)
ck_bool("fat_magic_check", macho_magic_check(fat), true)
ck_bool("fat_is_fat", macho_is_fat(fat), true)
ck_bool("fat_is_64", macho_is_64(fat), false)
ck_str("fat_magic_name", macho_magic_name(fat), "FAT_MAGIC")

// Test 32-bit BE magic: 0xFE,0xED,0xFA,0xCE
let be32 = []
push(be32, 0xFE)
push(be32, 0xED)
push(be32, 0xFA)
push(be32, 0xCE)
ck_bool("be32_magic_check", macho_magic_check(be32), true)
ck_bool("be32_is_64", macho_is_64(be32), false)
ck_bool("be32_is_le", macho_is_le(be32), false)
ck_str("be32_magic_name", macho_magic_name(be32), "MH_MAGIC")

// Negative: wrong magic
let bad = [1, 2, 3, 4]
ck_bool("bad_magic", macho_magic_check(bad), false)

// Empty buffer
let empty = []
ck_bool("empty_magic", macho_magic_check(empty), false)

print("PASS _macho_test")
