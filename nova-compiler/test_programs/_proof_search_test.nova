import std/proof/proof_search

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

// =========================================================================
// Inline truth-table oracle for cross-checking
// =========================================================================

fn _eval_tag(f) -> string
    if type_of(f) != "list"
        return "bad"
    if len(f) == 0
        return "bad"
    f[0]

fn _eval_lookup(name, asgn) -> int
    let n = len(asgn)
    let i = 0
    while i < n
        if asgn[i][0] == name
            return asgn[i][1]
        i = i + 1
    0

fn _eval(f, asgn) -> int
    let tag = _eval_tag(f)
    if tag == "var"
        return _eval_lookup(f[1], asgn)
    if tag == "bot"
        return 0
    if tag == "top"
        return 1
    if tag == "not"
        let v = _eval(f[1], asgn)
        if v == 0
            return 1
        return 0
    if tag == "and"
        let v1 = _eval(f[1], asgn)
        if v1 == 0
            return 0
        return _eval(f[2], asgn)
    if tag == "or"
        let v1 = _eval(f[1], asgn)
        if v1 == 1
            return 1
        return _eval(f[2], asgn)
    if tag == "imp"
        let v1 = _eval(f[1], asgn)
        if v1 == 0
            return 1
        return _eval(f[2], asgn)
    0

fn _collect_vars(f, vs)
    let tag = _eval_tag(f)
    if tag == "var"
        let name = f[1]
        let n = len(vs)
        let i = 0
        let found = 0
        while i < n
            if vs[i] == name
                found = 1
            i = i + 1
        if found == 0
            push(vs, name)
        return
    if tag == "not"
        _collect_vars(f[1], vs)
        return
    if tag == "and"
        _collect_vars(f[1], vs)
        _collect_vars(f[2], vs)
        return
    if tag == "or"
        _collect_vars(f[1], vs)
        _collect_vars(f[2], vs)
        return
    if tag == "imp"
        _collect_vars(f[1], vs)
        _collect_vars(f[2], vs)
        return

fn _tt_is_tautology(f) -> bool
    let vs = []
    _collect_vars(f, vs)
    let k = len(vs)
    let total = 1 << k
    let i = 0
    while i < total
        let asgn = []
        let b = 0
        while b < k
            push(asgn, [vs[b], (i >> b) & 1])
            b = b + 1
        if _eval(f, asgn) == 0
            return false
        i = i + 1
    true

// =========================================================================
// Formula constructors
// =========================================================================

fn mkvar(name) -> list
    ["var", name]

fn mknot(f) -> list
    ["not", f]

fn mkand(a, b) -> list
    ["and", a, b]

fn mkor(a, b) -> list
    ["or", a, b]

fn mkimp(a, b) -> list
    ["imp", a, b]

fn mkbot() -> list
    ["bot"]

fn mktop() -> list
    ["top"]

fn main()
    let fa = mkvar("A")
    let fb = mkvar("B")
    let fc = mkvar("C")

    // =========================================================================
    // KAT 1: psrch_provable(imp(A,A)) = true
    // =========================================================================
    let imp_aa = mkimp(fa, fa)
    ckb("provable_impAA", psrch_provable(imp_aa), true)

    // =========================================================================
    // KAT 2: psrch_provable(A) = false and psrch_countermodel(A) falsifies A
    // =========================================================================
    ckb("provable_A_false", psrch_provable(fa), false)
    let cm_a = psrch_countermodel(fa)
    cki("countermodel_A_type_list", type_of(cm_a) == "list", 1)
    // eval(A, cm_a) should be 0
    cki("countermodel_A_eval0", _eval(fa, cm_a), 0)

    // =========================================================================
    // KAT 3: psrch_provable(or(A, not(A))) = true
    // =========================================================================
    let or_a_na = mkor(fa, mknot(fa))
    ckb("provable_or_A_notA", psrch_provable(or_a_na), true)

    // =========================================================================
    // KAT 4: psrch_prove(f) returns non-"none" for valid f, "none" for invalid
    // =========================================================================
    let cert_impAA = psrch_prove(imp_aa)
    cki("prove_impAA_not_none", cert_impAA != "none", 1)
    // For invalid formula, psrch_prove returns "none"
    let cert_A = psrch_prove(fa)
    cki("prove_A_is_none", cert_A == "none", 1)
    // Certificate for valid formula should be a list tagged "tableau"
    cki("cert_impAA_type_list", type_of(cert_impAA) == "list", 1)
    cki("cert_impAA_tag", cert_impAA[0] == "tableau", 1)

    // =========================================================================
    // KAT 5: psrch_countermodel returns "none" for valid formulas
    // =========================================================================
    let cm_impAA = psrch_countermodel(imp_aa)
    cki("countermodel_tautology_none", cm_impAA == "none", 1)

    let cm_or_a_na = psrch_countermodel(or_a_na)
    cki("countermodel_or_A_notA_none", cm_or_a_na == "none", 1)

    // =========================================================================
    // KAT 6: More provability tests
    // =========================================================================
    let peirce = mkimp(mkimp(mkimp(fa, fb), fa), fa)
    ckb("provable_peirce", psrch_provable(peirce), true)

    let k_axiom = mkimp(fa, mkimp(fb, fa))
    ckb("provable_K", psrch_provable(k_axiom), true)

    let imp_ab = mkimp(fa, fb)
    ckb("provable_A_imp_B_false", psrch_provable(imp_ab), false)
    let cm_ab = psrch_countermodel(imp_ab)
    cki("countermodel_AB_type", type_of(cm_ab) == "list", 1)
    cki("countermodel_AB_eval0", _eval(imp_ab, cm_ab), 0)

    // =========================================================================
    // KAT 7: top and bot
    // =========================================================================
    ckb("provable_top", psrch_provable(mktop()), true)
    ckb("provable_bot_false", psrch_provable(mkbot()), false)
    let cm_bot = psrch_countermodel(mkbot())
    cki("countermodel_bot_eval0", _eval(mkbot(), cm_bot), 0)

    // =========================================================================
    // CROSS-CHECK (KEY): psrch_provable(f) == _tt_is_tautology(f) for MANY formulas
    // =========================================================================

    // 1-var
    ckb("cross_A", psrch_provable(fa), _tt_is_tautology(fa))
    ckb("cross_notA", psrch_provable(mknot(fa)), _tt_is_tautology(mknot(fa)))
    ckb("cross_A_or_notA", psrch_provable(or_a_na), _tt_is_tautology(or_a_na))
    ckb("cross_A_and_notA", psrch_provable(mkand(fa, mknot(fa))), _tt_is_tautology(mkand(fa, mknot(fa))))
    ckb("cross_impAA", psrch_provable(imp_aa), _tt_is_tautology(imp_aa))
    ckb("cross_dne", psrch_provable(mkimp(mknot(mknot(fa)), fa)), _tt_is_tautology(mkimp(mknot(mknot(fa)), fa)))

    // 2-var
    ckb("cross_impAB", psrch_provable(imp_ab), _tt_is_tautology(imp_ab))
    ckb("cross_peirce", psrch_provable(peirce), _tt_is_tautology(peirce))
    ckb("cross_K", psrch_provable(k_axiom), _tt_is_tautology(k_axiom))
    let mp = mkimp(mkand(fa, mkimp(fa, fb)), fb)
    ckb("cross_mp", psrch_provable(mp), _tt_is_tautology(mp))
    let dm1 = mkimp(mknot(mkand(fa, fb)), mkor(mknot(fa), mknot(fb)))
    ckb("cross_demorgan1", psrch_provable(dm1), _tt_is_tautology(dm1))
    let dm2 = mkimp(mkor(mknot(fa), mknot(fb)), mknot(mkand(fa, fb)))
    ckb("cross_demorgan2", psrch_provable(dm2), _tt_is_tautology(dm2))
    let mt = mkimp(mkand(imp_ab, mknot(fb)), mknot(fa))
    ckb("cross_modus_tollens", psrch_provable(mt), _tt_is_tautology(mt))
    let hyp_syl = mkimp(imp_ab, mkimp(mkimp(fb, fc), mkimp(fa, fc)))
    ckb("cross_hyp_syl", psrch_provable(hyp_syl), _tt_is_tautology(hyp_syl))

    // 3-var
    let dist1 = mkimp(mkand(fa, mkor(fb, fc)), mkor(mkand(fa, fb), mkand(fa, fc)))
    ckb("cross_dist1", psrch_provable(dist1), _tt_is_tautology(dist1))
    let dist2 = mkimp(mkor(mkand(fa, fb), mkand(fa, fc)), mkand(fa, mkor(fb, fc)))
    ckb("cross_dist2", psrch_provable(dist2), _tt_is_tautology(dist2))
    let non_taut3 = mkimp(fa, mkand(fb, fc))
    ckb("cross_non_taut3", psrch_provable(non_taut3), _tt_is_tautology(non_taut3))

    // =========================================================================
    // CROSS-CHECK: when NOT provable, psrch_countermodel(f) makes eval(f)=0
    // =========================================================================
    let non_taut_list = []
    push(non_taut_list, fa)
    push(non_taut_list, mknot(fa))
    push(non_taut_list, imp_ab)
    push(non_taut_list, mkimp(fb, fa))
    push(non_taut_list, mkand(fa, fb))
    push(non_taut_list, mkor(fa, fb))
    push(non_taut_list, mkbot())
    push(non_taut_list, non_taut3)

    let nti = 0
    while nti < len(non_taut_list)
        let nt = non_taut_list[nti]
        if not _tt_is_tautology(nt)
            let cm = psrch_countermodel(nt)
            cki("countermodel_is_list_" + str(nti), type_of(cm) == "list", 1)
            cki("countermodel_falsifies_" + str(nti), _eval(nt, cm), 0)
        nti = nti + 1

    print("PASS _proof_search_test")
