// KAT for std/textlayout/reflow — paragraph reflow / squeeze blanks / unwrap.
import std/textlayout/reflow

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL reflow " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        let ws = "false"
        if got == true
            gs = "true"
        if want == true
            ws = "true"
        print("FAIL reflow " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn ckn(label: string, got: int, want: int)
    if got != want
        print("FAIL reflow " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    let nl = chr(10)

    // rf_is_blank
    ckb("blank_empty",  rf_is_blank(""),    true)
    ckb("blank_spaces", rf_is_blank("   "), true)
    ckb("blank_tab",    rf_is_blank(chr(9)), true)
    ckb("blank_text",   rf_is_blank("x"),   false)
    ckb("blank_mixed",  rf_is_blank(" x "), false)

    // rf_unwrap: join wrapped lines with single spaces
    cks("unwrap_two",    rf_unwrap("line one" + nl + "line two"), "line one line two")
    cks("unwrap_single", rf_unwrap("just one line"),              "just one line")
    cks("unwrap_trim",   rf_unwrap("  hello  " + nl + "  world  "), "hello world")
    cks("unwrap_empty",  rf_unwrap(""), "")

    // rf_paragraphs: split on blank lines
    let paras1 = rf_paragraphs("p1" + nl + nl + "p2")
    ckn("para_len", len(paras1), 2)
    cks("para_0", paras1[0], "p1")
    cks("para_1", paras1[1], "p2")

    // single paragraph (no blank line)
    let paras2 = rf_paragraphs("aa bb" + nl + "cc dd")
    ckn("para_single_len", len(paras2), 1)

    // empty
    let paras3 = rf_paragraphs("")
    ckn("para_empty", len(paras3), 0)

    // rf_reflow_para: unwrap then greedy-wrap
    // para="aa bb\ncc dd", width=5: unwrap="aa bb cc dd"
    // words=[aa,bb,cc,dd]: "aa"=2,"aa bb"=5 fits,"cc"=5+1+2=8>5 flush
    // "aa bb" / "cc"=2,"cc dd"=5 fits => "cc dd"
    cks("reflow_para", rf_reflow_para("aa bb" + nl + "cc dd", 5), "aa bb" + nl + "cc dd")

    // rf_reflow: full pipeline — one paragraph
    cks("reflow_one_para", rf_reflow("aa bb" + nl + "cc dd", 5), "aa bb" + nl + "cc dd")

    // rf_reflow: two paragraphs separated by blank line
    let two_para_in = "hello world" + nl + nl + "foo bar baz"
    let two_para_out = rf_reflow(two_para_in, 6)
    // para1: "hello world" → wrap at 6: "hello" / "world"
    // para2: "foo bar baz" → wrap at 6: "foo" / "bar" / "baz"
    // joined with blank line between
    let want_two = "hello" + nl + "world" + nl + nl + "foo" + nl + "bar" + nl + "baz"
    cks("reflow_two_paras", two_para_out, want_two)

    // rf_squeeze_blanks: collapse multiple blank lines to one
    cks("squeeze_triple", rf_squeeze_blanks("a" + nl + nl + nl + "b"), "a" + nl + nl + "b")
    cks("squeeze_double", rf_squeeze_blanks("a" + nl + nl + "b"),      "a" + nl + nl + "b")
    cks("squeeze_none",   rf_squeeze_blanks("a" + nl + "b"),            "a" + nl + "b")
    cks("squeeze_empty",  rf_squeeze_blanks(""),                        "")

    // rf_join_paragraphs: rejoin para list with blank line separator
    let jp_want = "aa" + nl + nl + "bb" + nl + nl + "cc"
    cks("join_paras", rf_join_paragraphs(["aa", "bb", "cc"]), jp_want)
    cks("join_one",   rf_join_paragraphs(["solo"]), "solo")
    cks("join_empty", rf_join_paragraphs([]),        "")

    print("PASS _reflow_test")
