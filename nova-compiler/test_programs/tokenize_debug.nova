type Token
    kind: string
    value: string

fn tokenize(input: string) -> list
    let tokens = []
    let i = 0
    let current = ""
    while i < len(input)
        let ch = input[i]
        if ch == " "
            if len(current) > 0
                push(tokens, Token("word", current))
                current = ""
        else if ch == "("
            if len(current) > 0
                push(tokens, Token("word", current))
                current = ""
            push(tokens, Token("sym", ch))
        else
            current = current + ch
        i = i + 1
    if len(current) > 0
        push(tokens, Token("word", current))
    tokens

fn test()
    let toks = tokenize("ab (cd")
    print("count: " + str(len(toks)))
    match toks[0]
        Token(kind, value) =>
            print("t0: kind=" + kind + " val=" + value)
    match toks[1]
        Token(kind, value) =>
            print("t1: kind=" + kind + " val=" + value)
    match toks[2]
        Token(kind, value) =>
            print("t2: kind=" + kind + " val=" + value)

test()
