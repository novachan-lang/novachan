import forge_session_store

fn main()
    let s = ss_new(3600)
    assert(ss_session_count(s) == 0, "starts empty")

    s = ss_create(s, "sid1", "user42")
    s = ss_create(s, "sid2", "user42")
    s = ss_create(s, "sid3", "user99")
    assert(ss_session_count(s) == 3, "3 sessions")
    assert(ss_user_sessions(s, "user42") == 2, "user42 has 2 sessions")
    assert(ss_user_sessions(s, "user99") == 1, "user99 has 1 session")
    assert(ss_user_sessions(s, "ghost") == 0, "unknown user has 0")

    assert(ss_is_valid(s, "sid1") == 1, "sid1 valid")
    assert(ss_is_valid(s, "nope") == 0, "nope invalid")

    let ru = ss_get_user(s, "sid1")
    assert(is_ok(ru), "get_user ok")
    assert(unwrap(ru) == "user42", "sid1 -> user42")

    let rmiss = ss_get_user(s, "nope")
    assert(is_err(rmiss), "get_user err for missing session")

    let rset = ss_set_data(s, "sid1", "cart_items", "3")
    assert(is_ok(rset), "set_data ok")

    let rget = ss_get_data(s, "sid1", "cart_items")
    assert(is_ok(rget), "get_data ok")
    assert(unwrap(rget) == "3", "cart_items == 3")

    let rgetmiss = ss_get_data(s, "sid1", "no_such_key")
    assert(is_err(rgetmiss), "get_data err for missing key")

    let rsetmiss = ss_set_data(s, "nope", "x", "y")
    assert(is_err(rsetmiss), "set_data err for missing session")

    let rtouch = ss_touch(s, "sid1", 123456)
    assert(is_ok(rtouch), "touch ok")
    assert(unwrap(rtouch) == 123456, "touch returns timestamp")

    let rtouchmiss = ss_touch(s, "nope", 1)
    assert(is_err(rtouchmiss), "touch err for missing session")

    let rdes = ss_destroy(s, "sid1")
    assert(is_ok(rdes), "destroy ok")
    assert(ss_session_count(s) == 2, "2 sessions after destroy")
    assert(ss_user_sessions(s, "user42") == 1, "user42 has 1 session after destroy")
    assert(ss_is_valid(s, "sid1") == 0, "sid1 invalid after destroy")

    let rdesagain = ss_destroy(s, "sid1")
    assert(is_err(rdesagain), "destroy err on already-destroyed session")

    let rgetdestroyed = ss_get_user(s, "sid1")
    assert(is_err(rgetdestroyed), "get_user err after destroy")

    // re-create sid1 for a fresh user -- should NOT double count session_count
    s = ss_create(s, "sid1", "user7")
    assert(ss_session_count(s) == 3, "3 sessions after re-create")
    assert(ss_is_valid(s, "sid1") == 1, "sid1 valid again")
    let ru2 = ss_get_user(s, "sid1")
    assert(unwrap(ru2) == "user7", "sid1 rebound to user7")

    print("SESSION-STORE KAT PASS")
