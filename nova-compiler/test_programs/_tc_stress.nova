type P
    x: int
    y: int
// bounded(1), fill it, then 200k try_sends that all return 0:
// each deep-copies a struct then frees the copy (the !sent path). Double-free => crash.
bc = channel_bounded(1)
try_send(bc, P{x: 1, y: 2})
rejected = 0
i = 0
while i < 200000
    r = try_send(bc, P{x: i, y: i})
    if r == 0
        rejected = rejected + 1
    i = i + 1
// drain + refill churn: 200k transfers through an unbounded channel (recv path)
uc = channel()
j = 0
acc = 0
while j < 200000
    try_send(uc, j)
    g = try_recv(uc)
    if g[0] == 1
        acc = acc + 1
    j = j + 1
print("stress rejected=" + str(rejected) + " transferred=" + str(acc))
