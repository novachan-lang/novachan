// cryptorand — cryptographically secure randomness, clearly DISTINCT from the fast,
// reproducible prng. secure_* draws from the OS CSPRNG (CryptGenRandom / /dev/urandom
// via the random_bytes builtin); prng.nova is the seedable, reproducible generator for
// simulations/tests. The naming IS the safety boundary: never use prng_* for keys or
// tokens, never expect secure_* to reproduce. (Future: the compiler flags secure-vs-fast
// at the type so misuse in a security context is a compile error.)

fn secure_random_bytes(n)
    return secure_bytes(n)            // OS CSPRNG-backed bytes buffer (length n, NUL-safe)

fn secure_random_int()
    // assemble a non-negative 56-bit int from 7 secure bytes (7*8=56 < 63, so the
    // sign bit is never set -> always >= 0, no overflow games).
    let b = secure_bytes(7)
    let v = 0
    let i = 0
    while i < 7
        v = (v * 256) + bytes_get(b, i)
        i = i + 1
    return v

fn secure_random_below(n)
    // unbiased uniform in [0, n) via rejection sampling: reject the biased tail above
    // the largest multiple of n that fits in 2^56, then take the modulus. (Plain
    // `% n` alone is biased when n does not divide 2^56 — this removes that bias.)
    if n <= 0
        return 0
    let limit = 72057594037927936     // 2^56
    let zone = limit - (limit % n)
    let v = secure_random_int()
    while v >= zone
        v = secure_random_int()
    return v % n

fn main()
    let b = secure_random_bytes(16)
    assert_eq(bytes_len(b), 16)

    // every byte is in [0, 255]
    let allok = 1
    let i = 0
    while i < 16
        let by = bytes_get(b, i)
        if by < 0
            allok = 0
        if by > 255
            allok = 0
        i = i + 1
    assert_eq(allok, 1)

    // two independent draws differ (entropy; collision on 16 bytes is ~2^-128)
    let b2 = secure_random_bytes(16)
    let diff = 0
    let j = 0
    while j < 16
        if bytes_get(b, j) != bytes_get(b2, j)
            diff = 1
        j = j + 1
    assert_eq(diff, 1)

    // secure_random_int is non-negative
    let r = secure_random_int()
    let neg = 0
    if r < 0
        neg = 1
    assert_eq(neg, 0)

    // secure_random_below stays in bounds across many draws
    let inrange = 1
    let k = 0
    while k < 200
        let x = secure_random_below(10)
        if x < 0
            inrange = 0
        if x >= 10
            inrange = 0
        k = k + 1
    assert_eq(inrange, 1)

    print("cryptorand passed")
