// KAT test for std/random/xorshift
// Tests: determinism, range bounds, float bounds, bool domain, seed independence.
// All expected values hand-computed and cross-checked against JS BigInt simulation.
//
// xs_next(xs_new(1)) concrete value = 1082269761
//   Trace: s=1, s^=(s<<13)->8193, s^=(s>>7)->8257, s^=(s<<17)->1082269761
//   All masked to 63 bits; 1082269761 < 2^31 so no sign issues.

import std/random/xorshift

fn main()
    // ── KAT 1: concrete xs_next(xs_new(1)) value ───────────────────────────
    let a1 = xs_new(1)
    let concrete = xs_next(a1)
    if concrete != 1082269761
        print("FAIL KAT1: xs_next(xs_new(1)) expected 1082269761 got " + str(concrete))
        exit(1)

    // ── KAT 2 + 3: determinism — two independent streams produce identical sequences
    let a = xs_new(1)
    let v1 = xs_next(a)
    let v2 = xs_next(a)
    let a2 = xs_new(1)
    let w1 = xs_next(a2)
    let w2 = xs_next(a2)
    if w1 != v1
        print("FAIL KAT2: determinism w1!=v1: " + str(w1) + " vs " + str(v1))
        exit(1)
    if w2 != v2
        print("FAIL KAT3: determinism w2!=v2: " + str(w2) + " vs " + str(v2))
        exit(1)

    // ── KAT 4: v1 >= 0 (non-negative output) ───────────────────────────────
    if v1 < 0
        print("FAIL KAT4: v1 < 0: " + str(v1))
        exit(1)

    // ── KAT 5: xs_range result in [1, 6] ───────────────────────────────────
    let xr = xs_new(5)
    let rv = xs_range(xr, 1, 6)
    if rv < 1
        print("FAIL KAT5a: xs_range < lo: " + str(rv))
        exit(1)
    if rv > 6
        print("FAIL KAT5b: xs_range > hi: " + str(rv))
        exit(1)
    // Concrete value: xs_range(xs_new(5),1,6) = 4
    if rv != 4
        print("FAIL KAT5c: xs_range(xs_new(5),1,6) expected 4 got " + str(rv))
        exit(1)

    // ── KAT 6: different seed produces different first value ────────────────
    let b = xs_new(2)
    let bv = xs_next(b)
    if bv == v1
        print("FAIL KAT6: xs_next(xs_new(2)) == xs_next(xs_new(1)): " + str(bv))
        exit(1)

    // ── KAT 7: xs_float in [0.0, 1.0) ─────────────────────────────────────
    let xf = xs_new(3)
    let fv = xs_float(xf)
    if fv < 0.0
        print("FAIL KAT7a: xs_float < 0.0: " + str(fv))
        exit(1)
    if fv >= 1.0
        print("FAIL KAT7b: xs_float >= 1.0: " + str(fv))
        exit(1)

    // ── KAT 8: xs_bool returns 0 or 1 only ─────────────────────────────────
    let xb = xs_new(7)
    let i = 0
    while i < 20
        let bv2 = xs_bool(xb)
        if bv2 < 0
            print("FAIL KAT8a: xs_bool < 0 at step " + str(i))
            exit(1)
        if bv2 > 1
            print("FAIL KAT8b: xs_bool > 1 at step " + str(i))
            exit(1)
        i = i + 1

    // ── KAT 9: xs_range over 1000 values stays in bounds ───────────────────
    let xrb = xs_new(42)
    let j = 0
    while j < 1000
        let rv2 = xs_range(xrb, 0, 99)
        if rv2 < 0
            print("FAIL KAT9a: xs_range out of bounds (< 0) at step " + str(j))
            exit(1)
        if rv2 > 99
            print("FAIL KAT9b: xs_range out of bounds (> 99) at step " + str(j))
            exit(1)
        j = j + 1

    // ── KAT 10: xs_new(0) treated as seed=1 ────────────────────────────────
    let x0 = xs_new(0)
    let z0 = xs_next(x0)
    let x1b = xs_new(1)
    let z1 = xs_next(x1b)
    if z0 != z1
        print("FAIL KAT10: xs_new(0) should behave as xs_new(1), got " + str(z0) + " vs " + str(z1))
        exit(1)

    print("_xorshift_test passed")
