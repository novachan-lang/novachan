// _fastx_test.nova — KAT for std/bio/fastx (FASTA/FASTQ parsing).
import std/bio/fastx

fn check_int(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn check_str(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn check_bool(label, got, want)
    let g = 0
    if got
        g = 1
    let w = 0
    if want
        w = 1
    if g != w
        print("FAIL " + label + ": got=" + str(g) + " want=" + str(w))
        exit(1)

fn approx(a, b, tol) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < tol

fn main()
    let nl = chr(10)

    // --- KAT 1: fasta_parse single record ---
    let fa1 = ">" + "s1" + nl + "ATGC"
    let recs1 = fasta_parse(fa1)
    check_int("fasta_parse count 1", len(recs1), 1)
    let r1 = recs1[0]
    check_str("fasta_parse id", r1["id"], "s1")
    check_str("fasta_parse seq", r1["seq"], "ATGC")

    // --- KAT 2: fasta_count two records ---
    let fa2 = ">" + "a" + nl + "AA" + nl + ">" + "b" + nl + "CC"
    check_int("fasta_count 2", fasta_count(fa2), 2)

    // --- KAT 3: fasta_parse multi-line seq ---
    let fa3 = ">" + "seq1" + nl + "AAAA" + nl + "CCCC" + nl + "GGGG"
    let recs3 = fasta_parse(fa3)
    check_int("multi-line count", len(recs3), 1)
    check_str("multi-line seq", recs3[0]["seq"], "AAAACCCCGGGG")

    // --- KAT 4: round-trip parse -> format -> parse ---
    let fa4 = ">" + "r1" + nl + "ATGCATGC" + nl + ">" + "r2" + nl + "TTTT"
    let recs4 = fasta_parse(fa4)
    let formatted = fasta_format(recs4, 60)
    let recs4b = fasta_parse(formatted)
    check_int("round-trip count", len(recs4b), 2)
    check_str("round-trip id0", recs4b[0]["id"], "r1")
    check_str("round-trip seq0", recs4b[0]["seq"], "ATGCATGC")
    check_str("round-trip id1", recs4b[1]["id"], "r2")
    check_str("round-trip seq1", recs4b[1]["seq"], "TTTT")

    // --- KAT 5: fasta_ids ---
    let ids4 = fasta_ids(fa4)
    check_int("fasta_ids count", len(ids4), 2)
    check_str("fasta_ids[0]", ids4[0], "r1")
    check_str("fasta_ids[1]", ids4[1], "r2")

    // --- KAT 6: fasta_get ---
    let got_seq = fasta_get(fa4, "r2")
    check_str("fasta_get r2", got_seq, "TTTT")
    let got_missing = fasta_get(fa4, "notexist")
    check_str("fasta_get missing", got_missing, "")

    // --- KAT 7: fasta_total_length ---
    check_int("fasta_total_length", fasta_total_length(fa4), 12)

    // --- KAT 8: fastq_phred_to_q ---
    // '!' = 33 -> q=0; 'I' = 73 -> q=40
    check_int("phred_to_q !", fastq_phred_to_q("!"), 0)
    check_int("phred_to_q I", fastq_phred_to_q("I"), 40)
    check_int("phred_to_q A", fastq_phred_to_q("A"), 32)

    // --- KAT 9: fastq_q_to_phred ---
    check_str("q_to_phred 0", fastq_q_to_phred(0), "!")
    check_str("q_to_phred 40", fastq_q_to_phred(40), "I")

    // --- KAT 10: fastq_parse single record ---
    let fq1 = "@r1" + nl + "ACGT" + nl + "+" + nl + "IIII"
    let qrecs = fastq_parse(fq1)
    check_int("fastq_parse count", len(qrecs), 1)
    let qr1 = qrecs[0]
    check_str("fastq id", qr1["id"], "r1")
    check_str("fastq seq", qr1["seq"], "ACGT")
    check_str("fastq qual", qr1["qual"], "IIII")

    // --- KAT 11: fastq_avg_quality ---
    // "IIII": each 'I'=73, q=40; avg=40.0
    let avg1 = fastq_avg_quality("IIII")
    check_bool("fastq_avg_quality IIII", approx(avg1, 40.0, 0.01), true)
    // "!I": (0+40)/2 = 20.0
    let avg2 = fastq_avg_quality("!I")
    check_bool("fastq_avg_quality !I", approx(avg2, 20.0, 0.01), true)

    // --- KAT 12: fastq_min_quality ---
    check_int("fastq_min_quality IIII", fastq_min_quality("IIII"), 40)
    check_int("fastq_min_quality !I", fastq_min_quality("!I"), 0)

    // --- KAT 13: fastq_count ---
    let fq2 = "@r1" + nl + "ACGT" + nl + "+" + nl + "IIII" + nl + "@r2" + nl + "TTTT" + nl + "+" + nl + "!!!!"
    check_int("fastq_count 2", fastq_count(fq2), 2)

    // --- KAT 14: fastq_format round-trip ---
    let fq_recs = fastq_parse(fq2)
    let fq_formatted = fastq_format(fq_recs)
    let fq_recs2 = fastq_parse(fq_formatted)
    check_int("fastq round-trip count", len(fq_recs2), 2)
    check_str("fastq round-trip seq0", fq_recs2[0]["seq"], "ACGT")
    check_str("fastq round-trip qual0", fq_recs2[0]["qual"], "IIII")
    check_str("fastq round-trip seq1", fq_recs2[1]["seq"], "TTTT")

    // --- KAT 15: fasta_format wrapping ---
    // width=4 with "ATGCATGC" => "ATGC\nATGC\n"
    let wrap_recs = []
    let wr = {}
    wr["id"] = "test"
    wr["seq"] = "ATGCATGC"
    push(wrap_recs, wr)
    let wrapped = fasta_format(wrap_recs, 4)
    let wrapped_recs = fasta_parse(wrapped)
    check_int("wrap count", len(wrapped_recs), 1)
    check_str("wrap seq recovered", wrapped_recs[0]["seq"], "ATGCATGC")

    // --- KAT 16: fastq_parse truncated 7-line input (FIX 1 regression guard) ---
    // Complete record (@r1/seq/+/qual) + 3 leftover lines (@r2/seq/+, qual MISSING).
    // Parser must return exactly 1 record; the second group is silently skipped.
    let fq_trunc = "@r1" + nl + "ACGT" + nl + "+" + nl + "IIII" + nl + "@r2" + nl + "TTTT" + nl + "+"
    let trunc_recs = fastq_parse(fq_trunc)
    check_int("fastq_trunc count", len(trunc_recs), 1)
    let trunc_r0 = trunc_recs[0]
    check_str("fastq_trunc id", trunc_r0["id"], "r1")
    // qual must be a string (not integer 0 from out-of-bounds read)
    let trunc_qual = trunc_r0["qual"]
    check_str("fastq_trunc qual is string", trunc_qual, "IIII")

    print("PASS _fastx_test")
