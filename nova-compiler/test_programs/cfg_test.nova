// Compile-time conditional compilation via cfg()
// cfg(key, value) evaluates at COMPILE TIME — no runtime cost.
// False branches are dead-stripped by LLVM.

fn main()
    // On Windows x86_64, cfg("os", "windows") == 1
    let is_win = cfg("os", "windows")
    let is_linux = cfg("os", "linux")
    let is_macos = cfg("os", "macos")

    // Exactly one OS must be true
    assert(is_win + is_linux + is_macos == 1, "exactly one os")
    assert(is_win == 1, "should be windows")
    assert(is_linux == 0, "not linux")
    assert(is_macos == 0, "not macos")

    // Architecture check
    let is_x64 = cfg("arch", "x86_64")
    let is_arm = cfg("arch", "aarch64")
    assert(is_x64 == 1, "should be x86_64")
    assert(is_arm == 0, "not aarch64")

    // cfg in conditional — the false branch is dead-stripped at compile time
    let platform = ""
    if cfg("os", "windows")
        platform = "win"
    else if cfg("os", "linux")
        platform = "linux"
    else
        platform = "other"
    assert(platform == "win", "platform conditional")

    // cfg in expressions
    let path_sep = ""
    if cfg("os", "windows")
        path_sep = "\\"
    else
        path_sep = "/"
    assert(path_sep == "\\", "path separator")

    // Unknown key/value => 0 (safe fallback)
    assert(cfg("os", "beos") == 0, "unknown os")
    assert(cfg("unknown_key", "value") == 0, "unknown key")

    print("cfg_test: all passed")
