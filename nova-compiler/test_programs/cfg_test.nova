// Compile-time conditional compilation via cfg()
// cfg(key, value) evaluates at COMPILE TIME — no runtime cost.
// False branches are dead-stripped by LLVM.
//
// PORTABILITY: this test asserted `is_win == 1` and `is_x64 == 1` -- true only of the machine it
// was written on, so it failed on Linux and macOS and reported a PLATFORM DIFFERENCE as a NOVA
// defect. What cfg() actually promises is testable everywhere:
//   * exactly ONE os is true, and exactly ONE arch is true (no double-true, no all-false)
//   * cfg AGREES with the runtime's own os_name()/arch_name() -- the real property, since a
//     compile-time constant that disagreed with the runtime is precisely the dangerous bug
//   * a cfg-selected branch is taken consistently
//   * unknown keys/values fall back to 0
// Asserting the host is a stronger claim than the feature makes, and a test must not assert
// more than the thing it guards. (Fifth test found doing this -- see osname_test, proc_pipe_test,
// hot_reload_test, _asm_inline_test.)

fn main()
    let is_win = cfg("os", "windows")
    let is_linux = cfg("os", "linux")
    let is_macos = cfg("os", "macos")

    // Exactly one OS must be true -- holds on every platform.
    assert(is_win + is_linux + is_macos == 1, "exactly one os")

    // cfg() must AGREE with the runtime. This is the property that matters: a compile-time
    // constant disagreeing with os_name() would silently select the wrong branch.
    let os = os_name()
    if os == "windows"
        assert(is_win == 1, "cfg agrees with os_name (windows)")
    if os == "linux"
        assert(is_linux == 1, "cfg agrees with os_name (linux)")
    if os == "macos"
        assert(is_macos == 1, "cfg agrees with os_name (macos)")

    // Architecture: exactly one, and agreeing with arch_name().
    let is_x64 = cfg("arch", "x86_64")
    let is_arm = cfg("arch", "aarch64")
    assert(is_x64 + is_arm == 1, "exactly one arch")
    let a = arch_name()
    if a == "x86_64"
        assert(is_x64 == 1, "cfg agrees with arch_name (x86_64)")
    if a == "arm64"
        assert(is_arm == 1, "cfg agrees with arch_name (aarch64)")

    // cfg in a conditional — the false branches are dead-stripped at compile time.
    let platform = ""
    if cfg("os", "windows")
        platform = "win"
    else if cfg("os", "linux")
        platform = "linux"
    else if cfg("os", "macos")
        platform = "macos"
    else
        platform = "other"
    let expect_platform = "other"
    if os == "windows"
        expect_platform = "win"
    if os == "linux"
        expect_platform = "linux"
    if os == "macos"
        expect_platform = "macos"
    assert(platform == expect_platform, "platform conditional selects the running os")

    // cfg in expressions: the separator must match the platform convention.
    let path_sep = ""
    if cfg("os", "windows")
        path_sep = "\\"
    else
        path_sep = "/"
    let expect_sep = "/"
    if os == "windows"
        expect_sep = "\\"
    assert(path_sep == expect_sep, "path separator")

    // Unknown key/value => 0 (safe fallback) -- platform-independent.
    assert(cfg("os", "beos") == 0, "unknown os")
    assert(cfg("unknown_key", "value") == 0, "unknown key")

    print("cfg_test: all passed on " + os + "/" + a)
