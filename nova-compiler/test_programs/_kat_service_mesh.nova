import forge_service_mesh

fn main()
    let m = sm_new()
    m = sm_register(m, "auth", "10.0.0.1:8080")
    m = sm_register(m, "users", "10.0.0.2:8080")
    m = sm_register(m, "orders", "10.0.0.3:8080")
    assert(sm_service_count(m) == 3, "3 services")

    let r1 = sm_resolve(m, "auth")
    assert(r1["found"] == 1, "auth found")
    assert(r1["address"] == "10.0.0.1:8080", "auth addr")

    let r2 = sm_resolve(m, "missing")
    assert(r2["found"] == 0, "missing not found")

    m = sm_add_route(m, "orders", "users")
    let r3 = sm_route(m, "orders")
    m = r3["m"]
    assert(r3["found"] == 1, "route found")
    assert(r3["target"] == "users", "target=users")

    m = sm_set_health(m, "users", "unhealthy")
    let r4 = sm_route(m, "orders")
    m = r4["m"]
    assert(r4["found"] == 0, "unhealthy target blocked")

    assert(sm_healthy_count(m) == 2, "2 healthy")
    assert(sm_total_routed(m) == 1, "1 routed")

    print("SERVICE-MESH KAT PASS")
