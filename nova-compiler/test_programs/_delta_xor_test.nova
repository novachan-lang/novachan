// KAT test for std/compress/delta_xor
// Tests: delta_encode, delta_decode, xor_encode, xor_decode.
// PRIMARY gate: round-trips delta_decode(delta_encode(x))==x, xor_decode(xor_encode(x))==x
// SECONDARY gate: known vectors from the spec.
import std/compress/delta_xor

// ── Helpers ───────────────────────────────────────────────────────────────────

fn _lists_eq(a, b) -> int
    let na = len(a)
    let nb = len(b)
    if na != nb
        return 0
    let i = 0
    while i < na
        if a[i] != b[i]
            return 0
        i = i + 1
    1

fn list_to_str(xs) -> string
    let s = "["
    let n = len(xs)
    let i = 0
    while i < n
        if i > 0
            s = s + ","
        s = s + str(xs[i])
        i = i + 1
    s + "]"

fn check_lists(label, got, want)
    if _lists_eq(got, want) == 0
        print("FAIL " + label + ": got=" + list_to_str(got) + " want=" + list_to_str(want))
        exit(1)

fn str_to_bytes(s) -> list
    let out = []
    let n = len(s)
    let i = 0
    while i < n
        out.push(ord(s[i]))
        i = i + 1
    out

// ── DELTA ENCODE / DECODE ─────────────────────────────────────────────────────

// KAT D1: empty
let d1 = delta_decode(delta_encode([]))
check_lists("delta_empty_rt", d1, [])

// KAT D2: single byte
let d2 = delta_decode(delta_encode([42]))
check_lists("delta_single_rt", d2, [42])

// KAT D3: published vector — ramp [10,11,12,13] -> [10,1,1,1]
let de3 = delta_encode([10, 11, 12, 13])
check_lists("delta_ramp_encode", de3, [10, 1, 1, 1])

// KAT D4: round-trip the ramp
let dd4 = delta_decode(de3)
check_lists("delta_ramp_rt", dd4, [10, 11, 12, 13])

// KAT D5: descending ramp [20,15,10,5] -> [20, 251, 251, 251] (−5 & 0xFF = 251)
let de5 = delta_encode([20, 15, 10, 5])
check_lists("delta_desc_encode", de5, [20, 251, 251, 251])
let dd5 = delta_decode(de5)
check_lists("delta_desc_rt", dd5, [20, 15, 10, 5])

// KAT D6: all-same bytes [7,7,7,7] -> [7,0,0,0]
let de6 = delta_encode([7, 7, 7, 7])
check_lists("delta_same_encode", de6, [7, 0, 0, 0])
let dd6 = delta_decode(de6)
check_lists("delta_same_rt", dd6, [7, 7, 7, 7])

// KAT D7: round-trip "TOBEORNOTTOBEORTOBEORNOT" as bytes
let in7 = str_to_bytes("TOBEORNOTTOBEORTOBEORNOT")
let rt7 = delta_decode(delta_encode(in7))
check_lists("delta_tobeornot_rt", rt7, in7)

// KAT D8: boundary values [0, 255, 128, 0]
let in8 = [0, 255, 128, 0]
let rt8 = delta_decode(delta_encode(in8))
check_lists("delta_boundary_rt", rt8, in8)

// KAT D9: 0xFF wraparound: [255, 1] -> [255, (1-255)&0xFF] = [255, 2]
let de9 = delta_encode([255, 1])
check_lists("delta_wraparound_encode", de9, [255, 2])
let dd9 = delta_decode(de9)
check_lists("delta_wraparound_rt", dd9, [255, 1])

// KAT D10: longer sequence round-trip
let in10 = [10, 20, 30, 25, 15, 5, 10, 200, 100, 50]
let rt10 = delta_decode(delta_encode(in10))
check_lists("delta_longer_rt", rt10, in10)

// ── XOR ENCODE / DECODE ───────────────────────────────────────────────────────

// KAT X1: empty
let x1 = xor_decode(xor_encode([]))
check_lists("xor_empty_rt", x1, [])

// KAT X2: single byte
let x2 = xor_decode(xor_encode([99]))
check_lists("xor_single_rt", x2, [99])

// KAT X3: [0xFF, 0xFF] -> [0xFF, 0x00]
let xe3 = xor_encode([255, 255])
check_lists("xor_same_encode", xe3, [255, 0])
let xd3 = xor_decode(xe3)
check_lists("xor_same_rt", xd3, [255, 255])

// KAT X4: [10, 12, 10] -> [10, 6, 6]  (10^12=6, 12^10=6)
let xe4 = xor_encode([10, 12, 10])
check_lists("xor_known_encode", xe4, [10, 6, 6])
let xd4 = xor_decode(xe4)
check_lists("xor_known_rt", xd4, [10, 12, 10])

// KAT X5: all-zero bytes
let in5 = [0, 0, 0, 0, 0]
let xe5 = xor_encode(in5)
check_lists("xor_zeros_encode", xe5, [0, 0, 0, 0, 0])
let xd5 = xor_decode(xe5)
check_lists("xor_zeros_rt", xd5, in5)

// KAT X6: round-trip "TOBEORNOTTOBEORTOBEORNOT" as bytes
let in6b = str_to_bytes("TOBEORNOTTOBEORTOBEORNOT")
let rt6b = xor_decode(xor_encode(in6b))
check_lists("xor_tobeornot_rt", rt6b, in6b)

// KAT X7: round-trip boundary values [0, 128, 255, 64, 192]
let in7b = [0, 128, 255, 64, 192]
let rt7b = xor_decode(xor_encode(in7b))
check_lists("xor_boundary_rt", rt7b, in7b)

// KAT X8: alternating 0/255 [0, 255, 0, 255]
let xe8 = xor_encode([0, 255, 0, 255])
// 0; 0^255=255; 255^0=255; 0^255=255 — wait: xor with PREVIOUS decoded
// xor encodes: prev=0, cur=255 -> 0^255=255; prev=255, cur=0 -> 255^0=255; prev=0, cur=255 -> 0^255=255
// so encoded = [0, 255, 255, 255]
check_lists("xor_alt_encode", xe8, [0, 255, 255, 255])
let xd8 = xor_decode(xe8)
check_lists("xor_alt_rt", xd8, [0, 255, 0, 255])

// KAT X9: longer mixed input round-trip
let in9b = [10, 20, 30, 25, 15, 5, 10, 200, 100, 50]
let rt9b = xor_decode(xor_encode(in9b))
check_lists("xor_longer_rt", rt9b, in9b)

print("PASS _delta_xor_test")
