// ============================================================================
// Known-answer test for std/numeric/decimal (BigDecimal completeness, task #14).
// ============================================================================
// Covers: signed add/sub/mul, scale/precision handling, value-compare across
// differing scales, every rounding mode with signs (incl. the required
// half-even case 2.5 -> 2 and 3.5 -> 4 at scale 0), signed division with
// rounding, and the fallible paths returning err(...) instead of crashing.
// Prints "DECIMAL_COMPLETE KAT PASS" on success, else the mismatch + exit(1).
// ============================================================================
import std/numeric/decimal

fn fail(msg: string)
    print("DECIMAL_COMPLETE KAT FAIL " + msg)
    exit(1)

fn eq_s(name: string, got: string, want: string)
    if got != want
        fail(name + ": got '" + got + "' want '" + want + "'")

// dec / dec_round / dec_div return Result -- unwrap in test context.
fn D(r: Result) -> Decimal
    match r
        Ok(v) =>
            return v
        Err(e) =>
            fail("unexpected err: " + e)
            return dec_from_int(0)

fn main()
    // ---- arbitrary-precision add / sub / mul, signs & scales ----
    eq_s("0.1+0.2", dec_str(dec_add(D(dec("0.1")), D(dec("0.2")))), "0.3")
    eq_s("1.1*1.1", dec_str(dec_mul(D(dec("1.1")), D(dec("1.1")))), "1.21")
    eq_s("10-0.001", dec_str(dec_sub(D(dec("10")), D(dec("0.001")))), "9.999")
    // negative crossing zero
    eq_s("-1.5+0.5", dec_str(dec_add(D(dec("-1.5")), D(dec("0.5")))), "-1")
    eq_s("0.5-1.5", dec_str(dec_sub(D(dec("0.5")), D(dec("1.5")))), "-1")
    // product sign: -2.5 * 4 = -10
    eq_s("-2.5*4", dec_str(dec_mul(D(dec("-2.5")), D(dec("4")))), "-10")
    // large exact shift: x.12 * 100 has scale 2+0, strips to an integer
    eq_s("big*100", dec_str(dec_mul(D(dec("12345678901234567890.12")), D(dec("100")))), "1234567890123456789012")

    // ---- value compare ignores trailing-zero scale differences ----
    if dec_cmp(D(dec("1.10")), D(dec("1.1"))) != 0
        fail("cmp 1.10 == 1.1")
    if dec_cmp(D(dec("-2.50")), D(dec("-2.5"))) != 0
        fail("cmp -2.50 == -2.5")
    if dec_cmp(D(dec("-1")), D(dec("1"))) != 0 - 1
        fail("cmp -1 < 1")

    // ---- half-even (banker's) at scale 0: ties go to the EVEN neighbor ----
    eq_s("banker 2.5", dec_str(D(dec_round(D(dec("2.5")), 0, "half_even"))), "2")
    eq_s("banker 3.5", dec_str(D(dec_round(D(dec("3.5")), 0, "half_even"))), "4")
    eq_s("banker 4.5", dec_str(D(dec_round(D(dec("4.5")), 0, "half_even"))), "4")
    eq_s("banker -2.5", dec_str(D(dec_round(D(dec("-2.5")), 0, "half_even"))), "-2")
    eq_s("banker -3.5", dec_str(D(dec_round(D(dec("-3.5")), 0, "half_even"))), "-4")
    // non-tie half-even still rounds to nearest
    eq_s("banker 2.4", dec_str(D(dec_round(D(dec("2.4")), 0, "half_even"))), "2")
    eq_s("banker 2.6", dec_str(D(dec_round(D(dec("2.6")), 0, "half_even"))), "3")

    // ---- half-up / half-down at ties ----
    eq_s("half_up 2.5", dec_str(D(dec_round(D(dec("2.5")), 0, "half_up"))), "3")
    eq_s("half_up -2.5", dec_str(D(dec_round(D(dec("-2.5")), 0, "half_up"))), "-3")
    eq_s("half_down 2.5", dec_str(D(dec_round(D(dec("2.5")), 0, "half_down"))), "2")
    // carry across a digit boundary
    eq_s("half_up 1.005", dec_str(D(dec_round(D(dec("1.005")), 2, "half_up"))), "1.01")

    // ---- directed modes with signs ----
    eq_s("floor -0.1", dec_str(D(dec_round(D(dec("-0.1")), 0, "floor"))), "-1")
    eq_s("ceil 0.1", dec_str(D(dec_round(D(dec("0.1")), 0, "ceil"))), "1")
    eq_s("down -1.9", dec_str(D(dec_round(D(dec("-1.9")), 0, "down"))), "-1")
    eq_s("up 1.1", dec_str(D(dec_round(D(dec("1.1")), 0, "up"))), "2")

    // ---- signed division with rounding ----
    eq_s("1/3@5", dec_str(D(dec_div(D(dec("1")), D(dec("3")), 5, "half_even"))), "0.33333")
    eq_s("-1/3@5", dec_str(D(dec_div(D(dec("-1")), D(dec("3")), 5, "half_even"))), "-0.33333")
    eq_s("-10/-4@2", dec_str(D(dec_div(D(dec("-10")), D(dec("-4")), 2, "half_even"))), "2.5")
    eq_s("2/3@4up", dec_str(D(dec_div(D(dec("2")), D(dec("3")), 4, "half_up"))), "0.6667")

    // ---- fallible paths return err(...) -- never crash, never silent zero ----
    match dec_div(D(dec("1")), D(dec("0")), 2, "half_even")
        Ok(v) =>
            fail("divzero returned ok")
        Err(e) =>
            print("ok divzero -> " + e)
    match dec("1.2.3")
        Ok(v) =>
            fail("bad parse returned ok")
        Err(e) =>
            print("ok parse err -> " + e)
    match dec("12x3")
        Ok(v) =>
            fail("bad char returned ok")
        Err(e) =>
            print("ok badchar err -> " + e)
    match dec_round(D(dec("1.5")), 0, "bogus")
        Ok(v) =>
            fail("bad mode returned ok")
        Err(e) =>
            print("ok mode err -> " + e)

    print("DECIMAL_COMPLETE KAT PASS")
