import std/complex/complex_rotate

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _complex_rotate_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL _complex_rotate_test " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn ckl2(label: string, got: list, re: int, im: int)
    cki(label + "[re]", got[0], re)
    cki(label + "[im]", got[1], im)

fn main()
    // cxrot_by_i([1,0]) = [0,1]
    let r1 = cxrot_by_i([1, 0])
    ckl2("by_i_1_0", r1, 0, 1)

    // cxrot_by_i([0,1]) = [-1,0]
    let r2 = cxrot_by_i([0, 1])
    ckl2("by_i_0_1", r2, 0 - 1, 0)

    // cxrot_by_ik([1,0],2) = i^2 * 1 = -1 => [-1,0]
    let r3 = cxrot_by_ik([1, 0], 2)
    ckl2("by_ik_1_0_k2", r3, 0 - 1, 0)

    // cxrot_by_ik([1,0],3) = i^3 * 1 = -i => [0,-1]
    let r4 = cxrot_by_ik([1, 0], 3)
    ckl2("by_ik_1_0_k3", r4, 0, 0 - 1)

    // cxrot_by_ik([1,0],4) = i^4 * 1 = 1 => [1,0]
    let r5 = cxrot_by_ik([1, 0], 4)
    ckl2("by_ik_1_0_k4", r5, 1, 0)

    // cxrot_conj([3,4]) = [3,-4]
    let r6 = cxrot_conj([3, 4])
    ckl2("conj_3_4", r6, 3, 0 - 4)

    // cxrot_by_unit([1,0],[0,1]) = (1)(0+i) = [0,1]
    let r7 = cxrot_by_unit([1, 0], [0, 1])
    ckl2("by_unit_1_0_times_i", r7, 0, 1)

    print("PASS _complex_rotate_test")
