// Test: NOVA stdlib — collection utilities (enumerate, zip, sum, any, all)

fn main()
    // Test enumerate
    let items = [10, 20, 30]
    let pairs = enumerate(items)
    assert(len(pairs) == 3, "enumerate length")
    print("enumerate: {pairs}")

    // Test zip
    let a = [1, 2, 3]
    let b = [10, 20, 30]
    let zipped = zip(a, b)
    assert(len(zipped) == 3, "zip length")
    print("zip: {zipped}")

    // Test sum
    let nums = [1, 2, 3, 4, 5]
    let total = sum(nums)
    assert(total == 15, "sum should be 15")
    print("sum: {total}")

    // Test any/all
    let truthy = [1, 0, 1]
    let all_true = [1, 1, 1]
    let all_false = [0, 0, 0]

    assert(any(truthy) == 1, "any truthy")
    assert(all(all_true) == 1, "all true")
    assert(all(truthy) == 0, "not all truthy")
    assert(any(all_false) == 0, "none true")

    print("any([1,0,1]): {any(truthy)}")
    print("all([1,1,1]): {all(all_true)}")

    // Test list_min / list_max
    let vals = [5, 2, 8, 1, 9, 3]
    assert(list_min(vals) == 1, "min should be 1")
    assert(list_max(vals) == 9, "max should be 9")
    print("min: {list_min(vals)}, max: {list_max(vals)}")

    print("all collection tests passed")

main()
