fn _find_char(s, ch)
  let i = 0
  while i < len(s)
    if slice(s, i, i + 1) == ch
      return i
    i = i + 1
  -1

fn semver_parse(s)
  let version = s
  let pre = ""
  let dash = _find_char(s, "-")
  if dash >= 0
    version = slice(s, 0, dash)
    pre = slice(s, dash + 1, len(s))
  let parts = split(version, ".")
  let major = 0
  let minor = 0
  let patch = 0
  if len(parts) >= 1
    let r = parse_int_safe(parts[0])
    if is_ok(r)
      major = unwrap(r)
  if len(parts) >= 2
    let r2 = parse_int_safe(parts[1])
    if is_ok(r2)
      minor = unwrap(r2)
  if len(parts) >= 3
    let r3 = parse_int_safe(parts[2])
    if is_ok(r3)
      patch = unwrap(r3)
  [major, minor, patch, pre]

fn semver_str(v)
  let s = str(v[0]) + "." + str(v[1]) + "." + str(v[2])
  if v[3] != ""
    s = s + "-" + str(v[3])
  s

fn semver_cmp(a, b)
  if a[0] != b[0]
    if a[0] < b[0]
      return -1
    return 1
  if a[1] != b[1]
    if a[1] < b[1]
      return -1
    return 1
  if a[2] != b[2]
    if a[2] < b[2]
      return -1
    return 1
  let ap = a[3]
  let bp = b[3]
  if ap == "" and bp == ""
    return 0
  if ap != "" and bp == ""
    return -1
  if ap == "" and bp != ""
    return 1
  if ap < bp
    return -1
  if ap > bp
    return 1
  0

fn semver_eq(a, b)
  semver_cmp(a, b) == 0

fn semver_lt(a, b)
  semver_cmp(a, b) < 0

fn semver_gt(a, b)
  semver_cmp(a, b) > 0

fn semver_compatible(a, b)
  a[0] == b[0]

fn semver_bump_major(v)
  [v[0] + 1, 0, 0, ""]

fn semver_bump_minor(v)
  [v[0], v[1] + 1, 0, ""]

fn semver_bump_patch(v)
  [v[0], v[1], v[2] + 1, ""]

fn main()
  let v1 = semver_parse("1.2.3")
  assert(v1[0] == 1, "major 1")
  assert(v1[1] == 2, "minor 2")
  assert(v1[2] == 3, "patch 3")
  assert(v1[3] == "", "no pre")

  let v2 = semver_parse("2.0.0-beta.1")
  assert(v2[0] == 2, "major 2")
  assert(v2[3] == "beta.1", "pre beta.1")

  assert(semver_str(v1) == "1.2.3", "str 1.2.3")
  assert(semver_str(v2) == "2.0.0-beta.1", "str pre")

  assert(semver_lt(v1, v2) == 1, "1.2.3 < 2.0.0-beta.1")
  assert(semver_gt(v2, v1) == 1, "2.0.0-beta.1 > 1.2.3")

  let v3 = semver_parse("1.2.4")
  assert(semver_lt(v1, v3) == 1, "1.2.3 < 1.2.4")

  assert(semver_eq(v1, semver_parse("1.2.3")) == 1, "eq same")
  assert(semver_eq(v1, v3) == 0, "ne diff")

  let rel = semver_parse("2.0.0")
  assert(semver_lt(v2, rel) == 1, "pre < release")

  assert(semver_compatible(v1, v3) == 1, "same major compat")
  assert(semver_compatible(v1, v2) == 0, "diff major incompat")

  let bmi = semver_bump_minor(v1)
  assert(semver_str(bmi) == "1.3.0", "bump minor")
  let bma = semver_bump_major(v1)
  assert(semver_str(bma) == "2.0.0", "bump major")
  let bp = semver_bump_patch(v1)
  assert(semver_str(bp) == "1.2.4", "bump patch")

  let v0 = semver_parse("0.1.0")
  assert(v0[0] == 0 and v0[1] == 1 and v0[2] == 0, "0.1.0")

  print("semverx: all passed")
