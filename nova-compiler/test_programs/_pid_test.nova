import std/control/pid

// approx — float equality within tolerance.
fn approx(a, b, tol)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < tol

fn ckf(label, got, want)
    if not approx(got, want, 0.0001)
        print("FAIL pid " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // P-only: kp=2, error=3, dt=0.1 => 2*3 = 6.0 (no integral/derivative since prev=0)
    let s1 = pid_new(2.0, 0.0, 0.0)
    let out1 = pid_step(s1, 3.0, 0.1)
    ckf("p_only_step", out1, 6.0)

    // P term standalone
    let s2 = pid_new(2.0, 0.0, 0.0)
    ckf("p_term", pid_p_term(s2, 3.0), 6.0)

    // I accumulation: ki=1, two steps error=1 dt=1 => integ grows
    // step1: integ=0+1*1=1 => out=0+1*1+0=1.0
    // step2: integ=1+1*1=2 => out=0+1*2+0=2.0
    let si = pid_new(0.0, 1.0, 0.0)
    let oi1 = pid_step(si, 1.0, 1.0)
    let oi2 = pid_step(si, 1.0, 1.0)
    ckf("integral_step1", oi1, 1.0)
    ckf("integral_step2", oi2, 2.0)

    // pid_reset zeroes the integral
    let sr = pid_new(0.0, 1.0, 0.0)
    pid_step(sr, 5.0, 1.0)
    pid_reset(sr)
    let after_reset = pid_step(sr, 1.0, 1.0)
    ckf("reset_integral", after_reset, 1.0)

    // pid_with_limits clamps to hi
    let sl = pid_new(10.0, 0.0, 0.0)
    let clamped = pid_with_limits(sl, 5.0, 1.0, 0.0, 20.0)
    ckf("limits_hi", clamped, 20.0)

    // clamped to lo: raw = 10*(-5) = -50, lo=-20 => output = -20
    let sl2 = pid_new(10.0, 0.0, 0.0)
    let clamped2 = pid_with_limits(sl2, 0.0 - 5.0, 1.0, 0.0 - 20.0, 100.0)
    ckf("limits_lo", clamped2, 0.0 - 20.0)

    // pid_output returns last output
    let so = pid_new(3.0, 0.0, 0.0)
    pid_step(so, 4.0, 1.0)
    ckf("pid_output", pid_output(so), 12.0)

    // pid_set_gains changes gains
    let sg = pid_new(1.0, 0.0, 0.0)
    pid_set_gains(sg, 5.0, 0.0, 0.0)
    let og = pid_step(sg, 2.0, 1.0)
    ckf("set_gains", og, 10.0)

    // i_term preview (no state mutation): ki=2, error=3, dt=1 => integ=0+3=3 => 2*3=6
    let st = pid_new(0.0, 2.0, 0.0)
    let it = pid_i_term(st, 3.0, 1.0)
    ckf("i_term_preview", it, 6.0)

    // d_term: kd=1, first step from 0 -> error=5 => (5-0)/1 = 5
    let sd = pid_new(0.0, 0.0, 1.0)
    let dt1 = pid_d_term(sd, 5.0, 1.0)
    ckf("d_term_first", dt1, 5.0)

    // anti_windup: kp=10, ki=1 with hi=20 => raw=50 > 20 => integral NOT updated
    let saw = pid_new(10.0, 1.0, 0.0)
    let aw1 = pid_anti_windup(saw, 5.0, 1.0, 0.0 - 100.0, 20.0)
    ckf("anti_windup_clamped", aw1, 20.0)
    // integral should still be 0 (saturated => no update)
    // verify: step with error 0 => only integral term; should stay low
    let aw2 = pid_anti_windup(saw, 0.0, 1.0, 0.0 - 100.0, 20.0)
    ckf("anti_windup_integ_frozen", aw2, 0.0)

    // feedforward: kp=1, error=2 dt=1 ff=3 => 2+3=5
    let sff = pid_new(1.0, 0.0, 0.0)
    let ffout = pid_feedforward(sff, 2.0, 1.0, 3.0)
    ckf("feedforward", ffout, 5.0)

    print("PASS _pid_test")
