import std/game/maze_recursive_backtracker

// ---- structural helpers (inlined) ----

// Count total edges in links (each edge stored twice -> divide by 2)
fn _edge_count(links: list) -> int
    let total = len(links)
    let s = 0
    let i = 0
    while i < total
        s = s + len(links[i])
        i = i + 1
    s / 2

// BFS from cell 0; return number of visited cells
fn _count_reachable(links: list) -> int
    let total = len(links)
    let vis = []
    let qi = 0
    while qi < total
        push(vis, 0)
        qi = qi + 1

    let queue = []
    let qhead = []
    push(qhead, 0)

    vis[0] = 1
    push(queue, 0)
    let visited_count = 1

    // BFS; bound by total * total iterations
    let max_iters = total * total + 16
    let iters = 0

    while qhead[0] < len(queue) and iters < max_iters
        iters = iters + 1
        let front = queue[qhead[0]]
        qhead[0] = qhead[0] + 1

        let nbrs = links[front]
        let ni = 0
        let nc = len(nbrs)
        while ni < nc
            let nb = nbrs[ni]
            if vis[nb] == 0
                vis[nb] = 1
                push(queue, nb)
                visited_count = visited_count + 1
            ni = ni + 1

    visited_count

// Check two links are identical (same adjacency lists)
fn _links_equal(a: list, b: list) -> int
    let ta = len(a)
    let tb = len(b)
    if ta != tb
        0
    else
        let eq = 1
        let i = 0
        while i < ta and eq == 1
            let la = a[i]
            let lb = b[i]
            if len(la) != len(lb)
                eq = 0
            else
                let j = 0
                let nc = len(la)
                while j < nc and eq == 1
                    if la[j] != lb[j]
                        eq = 0
                    j = j + 1
            i = i + 1
        eq

fn main()
    // --- Test 1: gen(6,6,42) -> 35 edges, fully connected ---
    let w1 = 6
    let h1 = 6
    let links1 = gen(w1, h1, 42)
    let ec1 = _edge_count(links1)
    let want_ec1 = w1 * h1 - 1
    if ec1 != want_ec1
        print("FAIL maze_recursive_backtracker edge_count_6x6: got " + str(ec1) + " want " + str(want_ec1))
        exit(1)
    let reach1 = _count_reachable(links1)
    let want_reach1 = w1 * h1
    if reach1 != want_reach1
        print("FAIL maze_recursive_backtracker connected_6x6: got " + str(reach1) + " want " + str(want_reach1))
        exit(1)

    // --- Test 2: gen(4,4,7) -> 15 edges, fully connected ---
    let w2 = 4
    let h2 = 4
    let links2 = gen(w2, h2, 7)
    let ec2 = _edge_count(links2)
    let want_ec2 = w2 * h2 - 1
    if ec2 != want_ec2
        print("FAIL maze_recursive_backtracker edge_count_4x4: got " + str(ec2) + " want " + str(want_ec2))
        exit(1)
    let reach2 = _count_reachable(links2)
    let want_reach2 = w2 * h2
    if reach2 != want_reach2
        print("FAIL maze_recursive_backtracker connected_4x4: got " + str(reach2) + " want " + str(want_reach2))
        exit(1)

    // --- Test 3: gen(5,3,1) -> 14 edges, fully connected ---
    let w3 = 5
    let h3 = 3
    let links3 = gen(w3, h3, 1)
    let ec3 = _edge_count(links3)
    let want_ec3 = w3 * h3 - 1
    if ec3 != want_ec3
        print("FAIL maze_recursive_backtracker edge_count_5x3: got " + str(ec3) + " want " + str(want_ec3))
        exit(1)
    let reach3 = _count_reachable(links3)
    let want_reach3 = w3 * h3
    if reach3 != want_reach3
        print("FAIL maze_recursive_backtracker connected_5x3: got " + str(reach3) + " want " + str(want_reach3))
        exit(1)

    // --- Test 4: determinism gen(6,6,42) == gen(6,6,42) ---
    let links1b = gen(6, 6, 42)
    let deq = _links_equal(links1, links1b)
    if deq != 1
        print("FAIL maze_recursive_backtracker determinism_6x6: two calls with same seed differ")
        exit(1)

    print("PASS _maze_recursive_backtracker_test")
