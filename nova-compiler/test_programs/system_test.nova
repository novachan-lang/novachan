// Test system() and exec() builtins

let ret = system("echo hello_from_system")
print("system() returned: " + str(ret))

let output = exec("echo hello_from_exec")
print("exec() returned: " + output)

if ret == 0
    print("PASS: system()")
else
    print("FAIL: system() returned " + str(ret))

if starts_with(output, "hello_from_exec")
    print("PASS: exec()")
else
    print("FAIL: exec() returned '" + output + "'")
