// KAT for std/math/numtheory — elementary number theory.
// All expected values are hand-computed.
import std/math/numtheory

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let g = "false"
        if got
            g = "true"
        let w = "false"
        if want
            w = "true"
        print("FAIL " + label + ": got " + g + " want " + w)
        exit(1)

fn main()
    // --- nt_gcd ---
    cki("gcd(48,18)", nt_gcd(48, 18), 6)
    cki("gcd(0,5)", nt_gcd(0, 5), 5)
    cki("gcd(7,7)", nt_gcd(7, 7), 7)
    cki("gcd(100,75)", nt_gcd(100, 75), 25)

    // --- nt_lcm ---
    cki("lcm(4,6)", nt_lcm(4, 6), 12)
    cki("lcm(0,5)", nt_lcm(0, 5), 0)
    cki("lcm(5,7)", nt_lcm(5, 7), 35)

    // --- nt_egcd ---
    // nt_egcd(35,15) => [5, x, y] where 35x + 15y = 5
    let t1 = nt_egcd(35, 15)
    cki("egcd(35,15).g", t1[0], 5)
    // verify Bezout identity: 35*x + 15*y == 5
    let bezout1 = 35 * t1[1] + 15 * t1[2]
    cki("egcd(35,15).bezout", bezout1, 5)
    // nt_egcd(3, 11) => [1, x, y] where 3x + 11y = 1
    let t2 = nt_egcd(3, 11)
    cki("egcd(3,11).g", t2[0], 1)
    let bezout2 = 3 * t2[1] + 11 * t2[2]
    cki("egcd(3,11).bezout", bezout2, 1)

    // --- nt_mod_pow ---
    // 2^10 mod 1000 = 1024 mod 1000 = 24
    cki("mod_pow(2,10,1000)", nt_mod_pow(2, 10, 1000), 24)
    // 3^4 mod 5 = 81 mod 5 = 1
    cki("mod_pow(3,4,5)", nt_mod_pow(3, 4, 5), 1)
    // any^0 mod m = 1 (for m > 1)
    cki("mod_pow(7,0,13)", nt_mod_pow(7, 0, 13), 1)
    // m=1 edge case
    cki("mod_pow(*,*,1)", nt_mod_pow(5, 3, 1), 0)

    // --- nt_mod_inv ---
    // 3 * 4 = 12 ≡ 1 (mod 11) => inv(3,11)=4
    cki("mod_inv(3,11)", nt_mod_inv(3, 11), 4)
    // 2 has no inverse mod 4 (gcd(2,4)=2) => -1
    cki("mod_inv(2,4)", nt_mod_inv(2, 4), -1)
    // inv(1,7) = 1
    cki("mod_inv(1,7)", nt_mod_inv(1, 7), 1)

    // --- nt_is_prime ---
    ckb("is_prime(2)", nt_is_prime(2), true)
    ckb("is_prime(3)", nt_is_prime(3), true)
    ckb("is_prime(97)", nt_is_prime(97), true)
    ckb("is_prime(91)", nt_is_prime(91), false)
    ckb("is_prime(1)", nt_is_prime(1), false)
    ckb("is_prime(0)", nt_is_prime(0), false)
    ckb("is_prime(4)", nt_is_prime(4), false)
    ckb("is_prime(101)", nt_is_prime(101), true)

    // --- nt_next_prime ---
    cki("next_prime(1)", nt_next_prime(1), 2)
    cki("next_prime(2)", nt_next_prime(2), 3)
    cki("next_prime(20)", nt_next_prime(20), 23)
    cki("next_prime(96)", nt_next_prime(96), 97)

    // --- nt_factorize ---
    // 60 = 2 * 2 * 3 * 5
    let f60 = nt_factorize(60)
    cki("factorize(60).len", len(f60), 4)
    cki("factorize(60)[0]", f60[0], 2)
    cki("factorize(60)[1]", f60[1], 2)
    cki("factorize(60)[2]", f60[2], 3)
    cki("factorize(60)[3]", f60[3], 5)
    // prime => [prime]
    let f97 = nt_factorize(97)
    cki("factorize(97).len", len(f97), 1)
    cki("factorize(97)[0]", f97[0], 97)
    // 1 => []
    let f1 = nt_factorize(1)
    cki("factorize(1).len", len(f1), 0)

    // --- nt_euler_phi ---
    // phi(10) = 4 (coprimes: 1,3,7,9)
    cki("euler_phi(10)", nt_euler_phi(10), 4)
    // phi(1) = 1
    cki("euler_phi(1)", nt_euler_phi(1), 1)
    // phi(prime p) = p-1
    cki("euler_phi(7)", nt_euler_phi(7), 6)
    cki("euler_phi(13)", nt_euler_phi(13), 12)
    // phi(p^k) = p^(k-1)*(p-1): phi(8)=phi(2^3)=4
    cki("euler_phi(8)", nt_euler_phi(8), 4)
    // phi(12) = phi(4)*phi(3) = 2*2 = 4
    cki("euler_phi(12)", nt_euler_phi(12), 4)

    print("_numtheory_test passed")
