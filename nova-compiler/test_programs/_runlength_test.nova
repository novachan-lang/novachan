import std/encoding/runlength

// Helper checkers — print FAIL and exit(1) on mismatch.
fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ── rl_encode known-answer tests ─────────────────────────────────────────────

// KAT-1: canonical RLE example
cks("enc_basic",   rl_encode("aaabbc"),           "3a2b1c")

// KAT-2: empty string
cks("enc_empty",   rl_encode(""),                 "")

// KAT-3: no repeated chars (each run = 1)
cks("enc_abc",     rl_encode("abc"),              "1a1b1c")

// KAT-4: all same character
cks("enc_all_a",   rl_encode("aaaaa"),            "5a")

// KAT-5: longer realistic input
cks("enc_long",    rl_encode("wwwwaaadexxxxxx"),   "4w3a1d1e6x")

// KAT-6: single character
cks("enc_single",  rl_encode("z"),                "1z")

// ── rl_decode known-answer tests ─────────────────────────────────────────────

// KAT-7: decode canonical form
cks("dec_basic",   rl_decode("3a2b1c"),           "aaabbc")

// KAT-8: empty decode
cks("dec_empty",   rl_decode(""),                 "")

// KAT-9: multi-digit count (10a)
cks("dec_10a",     rl_decode("10a"),              "aaaaaaaaaa")

// KAT-10: decode no-repeats form
cks("dec_abc",     rl_decode("1a1b1c"),           "abc")

// ── round-trip test ───────────────────────────────────────────────────────────

// KAT-11: round-trip on a realistic input
cks("rt_long",     rl_decode(rl_encode("wwwwaaadexxxxxx")), "wwwwaaadexxxxxx")

// ── rl_encode_pairs known-answer tests ───────────────────────────────────────

// KAT-12: encode_pairs basic
let pairs_aab = rl_encode_pairs("aab")
cki("pairs_len",   len(pairs_aab),  2)
cks("pairs_0_ch",  pairs_aab[0][0], "a")
cki("pairs_0_cnt", pairs_aab[0][1], 2)
cks("pairs_1_ch",  pairs_aab[1][0], "b")
cki("pairs_1_cnt", pairs_aab[1][1], 1)

// KAT-13: encode_pairs empty
let pairs_empty = rl_encode_pairs("")
cki("pairs_empty_len", len(pairs_empty), 0)

// ── rl_decode_pairs known-answer tests ───────────────────────────────────────

// KAT-14: decode_pairs round-trip via encode_pairs
let src = "aaabbc"
let encoded_pairs = rl_encode_pairs(src)
let decoded_from_pairs = rl_decode_pairs(encoded_pairs)
cks("pairs_rt", decoded_from_pairs, src)

// KAT-15: decode_pairs empty list
cks("dec_pairs_empty", rl_decode_pairs([]), "")

// KAT-16: decode_pairs explicit construction
let manual_pairs = [["w", 4], ["x", 3]]
cks("dec_pairs_manual", rl_decode_pairs(manual_pairs), "wwwwxxx")

print("_runlength_test passed")
