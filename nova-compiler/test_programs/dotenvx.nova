fn dotenv_parse(content)
  let result = {}
  let lines = split(content, "\n")
  for line in lines
    let trimmed = trim(line)
    if len(trimmed) == 0
      continue
    if starts_with(trimmed, "#")
      continue
    let eq = -1
    let ei = 0
    while ei < len(trimmed)
      if slice(trimmed, ei, ei + 1) == "="
        eq = ei
        ei = len(trimmed)
      ei = ei + 1
    if eq > 0
      let key = trim(slice(trimmed, 0, eq))
      let val = trim(slice(trimmed, eq + 1, len(trimmed)))
      if len(val) >= 2
        if (starts_with(val, "\"") and slice(val, len(val) - 1, len(val)) == "\"") or (starts_with(val, "'") and slice(val, len(val) - 1, len(val)) == "'")
          val = slice(val, 1, len(val) - 1)
      result[key] = val
  result

fn dotenv_load(path)
  let content = read_file(path)
  let parsed = dotenv_parse(content)
  let ks = keys(parsed)
  for k in ks
    set_env(k, parsed[k])
  parsed

fn dotenv_str(pairs)
  let lines = []
  let ks = keys(pairs)
  for k in ks
    let val = str(pairs[k])
    if contains(val, " ") or contains(val, "=")
      push(lines, k + "=\"" + val + "\"")
    else
      push(lines, k + "=" + val)
  join(lines, "\n")

fn main()
  let content = "# Database config\nDB_HOST=localhost\nDB_PORT=5432\nDB_NAME=myapp\n\n# Auth\nSECRET_KEY=\"my secret key\"\nDEBUG=true\nEMPTY=\n"
  let parsed = dotenv_parse(content)
  assert(parsed["DB_HOST"] == "localhost", "host")
  assert(parsed["DB_PORT"] == "5432", "port")
  assert(parsed["DB_NAME"] == "myapp", "name")
  assert(parsed["SECRET_KEY"] == "my secret key", "quoted")
  assert(parsed["DEBUG"] == "true", "debug")
  assert(parsed["EMPTY"] == "", "empty value")
  assert(not contains(parsed, "#"), "no comment keys")

  let content2 = "KEY1='single quoted'\nKEY2=noquotes\n  PADDED  = spaced  \n"
  let p2 = dotenv_parse(content2)
  assert(p2["KEY1"] == "single quoted", "single quoted")
  assert(p2["KEY2"] == "noquotes", "no quotes")
  assert(p2["PADDED"] == "spaced", "trimmed")

  let serialized = dotenv_str(parsed)
  assert(contains(serialized, "DB_HOST=localhost"), "serialize host")
  assert(contains(serialized, "SECRET_KEY=\"my secret key\""), "serialize quoted")

  write_file("_test.env", "TEST_DOT=hello\nTEST_NUM=42\n")
  let _loaded = dotenv_load("_test.env")
  assert(env("TEST_DOT") == "hello", "loaded from file")
  assert(env("TEST_NUM") == "42", "loaded num")
  remove_file("_test.env")

  print("dotenvx: all passed")
