type Point
    x: int
    y: int

fn main()
    let a = Point { x: 1, y: 2 }
    let b = Point { x: 1, y: 2 }
    let c = Point { x: 3, y: 4 }

    if a == b
        print("a == b: TRUE")
    else
        print("a == b: FALSE")

    if a == c
        print("a == c: TRUE")
    else
        print("a == c: FALSE")

    print("done")
