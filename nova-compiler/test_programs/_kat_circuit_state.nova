import forge_circuit_state

fn main()
    let c = cs_new(3, 60)
    assert(cs_state(c) == "closed", "starts closed")

    let r1 = cs_call(c, 0)
    assert(is_ok(r1), "call ok")

    c = cs_record_failure(c, 10)
    c = cs_record_failure(c, 20)
    assert(cs_state(c) == "closed", "still closed at 2")
    c = cs_record_failure(c, 30)
    assert(cs_state(c) == "open", "opened at 3 failures")
    assert(cs_total_trips(c) == 1, "1 trip")

    let r2 = cs_call(c, 40)
    assert(is_err(r2), "circuit open at 40")

    let r3 = cs_call(c, 100)
    assert(is_ok(r3), "half_open at 100")
    assert(unwrap(r3) == "half_open", "state is half_open")

    c = cs_record_success(c)
    assert(cs_state(c) == "closed", "closed after success")

    print("CIRCUIT-STATE KAT PASS")
