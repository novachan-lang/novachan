import forge_longestrun

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    fails = fails + expect("lc1", str(longest_consecutive([100, 4, 200, 1, 3, 2])), "4")
    fails = fails + expect("lc_start", str(longest_consecutive_start([100, 4, 200, 1, 3, 2])), "1")
    fails = fails + expect("lc2", str(longest_consecutive([0, 3, 7, 2, 5, 8, 4, 6, 0, 1])), "9")
    fails = fails + expect("lc2_start", str(longest_consecutive_start([0, 3, 7, 2, 5, 8, 4, 6, 0, 1])), "0")
    fails = fails + expect("lc_empty", str(longest_consecutive([])), "0")
    fails = fails + expect("lc_single", str(longest_consecutive([5])), "1")
    fails = fails + expect("lc_dups", str(longest_consecutive([1, 1, 1])), "1")
    fails = fails + expect("lc_neg", str(longest_consecutive([0 - 3, 0 - 2, 0 - 1, 5])), "3")

    // max consecutive ones
    fails = fails + expect("ones1", str(max_consecutive_ones([1, 1, 0, 1, 1, 1])), "3")
    fails = fails + expect("ones_all", str(max_consecutive_ones([1, 1, 1])), "3")
    fails = fails + expect("ones_none", str(max_consecutive_ones([0, 0, 0])), "0")
    fails = fails + expect("ones_empty", str(max_consecutive_ones([])), "0")

    if fails == 0
        print("forge_longestrun: all passed")
    else
        print("forge_longestrun: " + str(fails) + " FAILED")
