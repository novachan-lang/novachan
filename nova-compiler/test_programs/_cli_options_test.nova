import std/cli/cli_options

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn ckl(label: string, got: any, want: any)
    if len(got) != len(want)
        print("FAIL " + label + ": len " + str(len(got)) + " != " + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL " + label + " [" + str(i) + "]: '" + got[i] + "' != '" + want[i] + "'")
            exit(1)
        i = i + 1

fn main()
    // KAT: clo_get(['--port','8080'],'--port')='8080'
    cks("get_space_form", clo_get(["--port", "8080"], "--port"), "8080")

    // KAT: clo_get(['--port=8080'],'--port')='8080'
    cks("get_eq_form", clo_get(["--port=8080"], "--port"), "8080")

    // KAT: clo_get(['--x','1'],'--y')=''
    cks("get_absent", clo_get(["--x", "1"], "--y"), "")

    // KAT: clo_has(['--v','1'],'--v')=true
    ckb("has_present", clo_has(["--v", "1"], "--v"), true)

    // KAT: clo_get_default(['--a','1'],'--b','def')='def'
    cks("get_default_absent", clo_get_default(["--a", "1"], "--b", "def"), "def")

    // KAT: clo_get_all(['--i','1','--i','2'],'--i')=['1','2']
    ckl("get_all_repeated", clo_get_all(["--i", "1", "--i", "2"], "--i"), ["1", "2"])

    // Additional robustness tests.

    // has on absent option.
    ckb("has_absent", clo_has(["--x", "1"], "--y"), false)

    // get_default when present: returns actual value.
    cks("get_default_present", clo_get_default(["--a", "hello"], "--a", "def"), "hello")

    // get with eq form for get_default.
    cks("get_default_eq_form", clo_get_default(["--a=world"], "--a", "none"), "world")

    // get_all returns empty list when option absent.
    ckl("get_all_absent", clo_get_all(["--x", "1"], "--y"), [])

    // get_all with eq form.
    ckl("get_all_eq_form", clo_get_all(["--i=a", "--i=b"], "--i"), ["a", "b"])

    // get: option at end of argv with no value returns ''.
    cks("get_no_value_eof", clo_get(["--port"], "--port"), "")

    // get: empty argv returns ''.
    cks("get_empty_argv", clo_get([], "--port"), "")

    // Mixed eq and space forms in get_all.
    ckl("get_all_mixed_forms", clo_get_all(["--i=1", "--i", "2"], "--i"), ["1", "2"])

    print("PASS _cli_options_test")
