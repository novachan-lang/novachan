// _geohash_test.nova — KAT for std/encoding/geohash
//
// Known-answer tests against published geohash values and
// round-trip tests (decode(encode(x)) ≈ x within cell error).
import std/encoding/geohash

// ── Helpers ───────────────────────────────────────────────────────────────────

fn cki(label: str, got: int, expected: int)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(label: str, got: str, expected: str)
    if got != expected
        print("FAIL " + label + ": got '" + got + "' expected '" + expected + "'")
        exit(1)

fn ckf(label: str, got: float, expected: float, eps: float)
    let diff = got - expected
    let adiff = diff
    if diff < 0.0
        adiff = 0.0 - diff
    if adiff > eps
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected) + " eps " + str(eps))
        exit(1)

fn main()
    // ── KAT 1: published geohash for (42.6, -5.6) precision 5 ──────────────
    // Reference: geohash.org / Wikipedia / multiple online tools.
    let enc1 = gh_encode(42.6, -5.6, 5)
    cks("encode(42.6,-5.6,5)", enc1, "ezs42")

    // ── KAT 2: published geohash for (57.64911, 10.40744) precision 11 ─────
    // Reference: Wikipedia "Geohash" article example.
    let enc2 = gh_encode(57.64911, 10.40744, 11)
    cks("encode(57.64911,10.40744,11)", enc2, "u4pruydqqvj")

    // ── KAT 3: length == precision ──────────────────────────────────────────
    let enc3 = gh_encode(0.0, 0.0, 6)
    cki("encode(0,0,6) length", len(enc3), 6)

    // ── KAT 4: longer precision yields longer string ─────────────────────────
    let s5 = gh_encode(51.5074, -0.1278, 5)
    let s9 = gh_encode(51.5074, -0.1278, 9)
    cki("length 5", len(s5), 5)
    cki("length 9", len(s9), 9)

    // ── KAT 5: decode "ezs42" → within 0.02 of (42.6, -5.6) ─────────────────
    let dec1 = gh_decode("ezs42")
    let dec1_lat = dec1[0] * 1.0
    let dec1_lon = dec1[1] * 1.0
    ckf("decode(ezs42) lat", dec1_lat, 42.6, 0.02)
    ckf("decode(ezs42) lon", dec1_lon, -5.6, 0.02)

    // ── KAT 6: bounds("ezs42") brackets 42.6 and -5.6 ───────────────────────
    let b1 = gh_bounds("ezs42")
    let b_lat_min = b1[0] * 1.0
    let b_lat_max = b1[1] * 1.0
    let b_lon_min = b1[2] * 1.0
    let b_lon_max = b1[3] * 1.0
    // lat 42.6 must be within [lat_min, lat_max]
    if b_lat_min > 42.6 or b_lat_max < 42.6
        print("FAIL bounds lat: 42.6 not in [" + str(b_lat_min) + "," + str(b_lat_max) + "]")
        exit(1)
    // lon -5.6 must be within [lon_min, lon_max]
    if b_lon_min > -5.6 or b_lon_max < -5.6
        print("FAIL bounds lon: -5.6 not in [" + str(b_lon_min) + "," + str(b_lon_max) + "]")
        exit(1)

    // ── KAT 7: round-trip decode(encode(lat,lon,12)) ≈ (lat,lon) ─────────────
    // At precision 12: cell ≈ 3.7 μm × 1.9 μm; error < 0.0001 degree.
    let rt_lat = 51.5074
    let rt_lon = -0.1278
    let rt_hash = gh_encode(rt_lat, rt_lon, 12)
    cki("round-trip hash length", len(rt_hash), 12)
    let rt_dec = gh_decode(rt_hash)
    let rt_dec_lat = rt_dec[0] * 1.0
    let rt_dec_lon = rt_dec[1] * 1.0
    ckf("round-trip lat", rt_dec_lat, rt_lat * 1.0, 0.0001)
    ckf("round-trip lon", rt_dec_lon, rt_lon * 1.0, 0.0001)

    // ── KAT 8: encode at equator+prime-meridian (0,0) ────────────────────────
    // Precision 1: 's' is the geohash for the cell containing (0,0).
    let enc00 = gh_encode(0.0, 0.0, 1)
    cks("encode(0,0,1)", enc00, "s")

    // ── KAT 9: bounds sanity — min < max for both axes ───────────────────────
    let b2 = gh_bounds("u4pruydqqvj")
    let b2_lat_min = b2[0] * 1.0
    let b2_lat_max = b2[1] * 1.0
    let b2_lon_min = b2[2] * 1.0
    let b2_lon_max = b2[3] * 1.0
    if b2_lat_min >= b2_lat_max
        print("FAIL bounds sanity lat_min >= lat_max")
        exit(1)
    if b2_lon_min >= b2_lon_max
        print("FAIL bounds sanity lon_min >= lon_max")
        exit(1)
    // and must contain (57.64911, 10.40744)
    if b2_lat_min > 57.64911 or b2_lat_max < 57.64911
        print("FAIL bounds(u4pruydqqvj) lat")
        exit(1)
    if b2_lon_min > 10.40744 or b2_lon_max < 10.40744
        print("FAIL bounds(u4pruydqqvj) lon")
        exit(1)

    // ── KAT 10: decode precision-11 hash close to original ───────────────────
    let dec2 = gh_decode("u4pruydqqvj")
    let dec2_lat = dec2[0] * 1.0
    let dec2_lon = dec2[1] * 1.0
    ckf("decode(u4pruydqqvj) lat", dec2_lat, 57.64911, 0.0001)
    ckf("decode(u4pruydqqvj) lon", dec2_lon, 10.40744, 0.0001)

    print("_geohash_test passed")
