// _dms_test.nova — KAT for std/geo/dms
import std/geo/dms

fn ckf(label, got, expected, eps)
    let diff = got - expected
    if diff < 0.0
        diff = 0.0 - diff
    if diff > eps
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(expected))
        exit(1)

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + got + " want=" + expected)
        exit(1)

fn ckb(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(expected))
        exit(1)

fn main()
    // KAT 1: dms_to_decimal North
    let r1 = dms_to_decimal(40, 26, 46.0, "N")
    ckf("to_decimal N", r1, 40.44611, 0.0001)

    // KAT 2: dms_to_decimal South (negative)
    let r2 = dms_to_decimal(40, 26, 46.0, "S")
    ckf("to_decimal S", r2, 0.0 - 40.44611, 0.0001)

    // KAT 3: dms_to_decimal East, 0 deg 30 min 0 sec = 0.5
    let r3 = dms_to_decimal(0, 30, 0.0, "E")
    ckf("to_decimal E 0d30m0s", r3, 0.5, 0.0001)

    // KAT 4: dms_from_decimal latitude positive
    let fd1 = dms_from_decimal(40.44611, 1)
    let fd1_deg = fd1["deg"]
    let fd1_min = fd1["min"]
    let fd1_sec = fd1["sec"] * 1.0
    let fd1_hemi = fd1["hemi"]
    cki("from_decimal N deg", fd1_deg, 40)
    cki("from_decimal N min", fd1_min, 26)
    ckf("from_decimal N sec", fd1_sec, 46.0, 0.1)
    cks("from_decimal N hemi", fd1_hemi, "N")

    // KAT 5: dms_from_decimal longitude negative
    let fd2 = dms_from_decimal(0.0 - 73.985, 0)
    let fd2_hemi = fd2["hemi"]
    let fd2_deg = fd2["deg"]
    cks("from_decimal W hemi", fd2_hemi, "W")
    cki("from_decimal W deg", fd2_deg, 73)

    // KAT 6: round-trip dms_to_decimal(dms_from_decimal(12.5, true)) approx 12.5
    let rt = dms_from_decimal(12.5, 1)
    let rt_d = rt["deg"]
    let rt_m = rt["min"]
    let rt_s = rt["sec"] * 1.0
    let rt_h = rt["hemi"]
    let rt_back = dms_to_decimal(rt_d, rt_m, rt_s, rt_h)
    ckf("round-trip lat 12.5", rt_back, 12.5, 0.0001)

    // KAT 7: dms_seconds_total(1, 0, 0) == 3600.0
    let st = dms_seconds_total(1, 0, 0.0)
    ckf("seconds_total 1d0m0s", st, 3600.0, 0.0001)

    // KAT 8: dms_seconds_total(0, 1, 0) == 60.0
    let st2 = dms_seconds_total(0, 1, 0.0)
    ckf("seconds_total 0d1m0s", st2, 60.0, 0.0001)

    // KAT 9: dms_seconds_total(0, 0, 1) == 1.0
    let st3 = dms_seconds_total(0, 0, 1.0)
    ckf("seconds_total 0d0m1s", st3, 1.0, 0.0001)

    // KAT 10: dms_to_dm converts seconds to fractional minutes
    let dm = dms_to_dm(40, 26, 30.0)
    let dm_d = dm["deg"]
    let dm_m = dm["dec_min"] * 1.0
    cki("to_dm deg", dm_d, 40)
    // 26 min + 30 sec = 26.5 dec_min
    ckf("to_dm dec_min", dm_m, 26.5, 0.0001)

    // KAT 11: dms_decimal_minutes of 40.5 -> [40, 30.0]
    let dm2 = dms_decimal_minutes(40.5)
    let dm2_d = dm2[0]
    let dm2_m = dm2[1] * 1.0
    cki("dec_minutes deg", dm2_d, 40)
    ckf("dec_minutes min", dm2_m, 30.0, 0.0001)

    // KAT 12: dms_parse '40 26 46 N'
    let parsed = dms_parse("40 26 46 N")
    ckf("parse N", parsed, 40.44611, 0.0001)

    // KAT 13: dms_parse '40 26 46 S'
    let parsed2 = dms_parse("40 26 46 S")
    ckf("parse S", parsed2, 0.0 - 40.44611, 0.0001)

    // KAT 14: dms_format
    let fmt = dms_format(40.44611, 1)
    cks("format lat", fmt, "40 26 46 N")

    // KAT 15: round-trip negative longitude
    let rt2 = dms_from_decimal(0.0 - 73.985, 0)
    let rt2_d = rt2["deg"]
    let rt2_m = rt2["min"]
    let rt2_s = rt2["sec"] * 1.0
    let rt2_h = rt2["hemi"]
    let rt2_back = dms_to_decimal(rt2_d, rt2_m, rt2_s, rt2_h)
    ckf("round-trip lon -73.985", rt2_back, 0.0 - 73.985, 0.001)

    print("PASS _dms_test")
