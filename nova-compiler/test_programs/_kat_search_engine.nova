import forge_search_engine

fn main()
    let eng = se_new()
    eng = se_add_doc(eng, "d1", "The quick brown fox jumps over the lazy dog")
    eng = se_add_doc(eng, "d2", "A quick brown dog runs in the park")
    eng = se_add_doc(eng, "d3", "The fox is clever and fast")

    assert(se_doc_count(eng) == 3, "3 docs")

    let tokens = se_tokenize("Hello, World! Test.")
    assert(len(tokens) == 3, "3 tokens")
    assert(tokens[0] == "hello", "lowercase")

    let r2 = se_search(eng, "quick brown")
    assert(len(r2) >= 2, "quick brown in >=2 docs")

    let r3 = se_search(eng, "nonexistent")
    assert(len(r3) == 0, "no results for missing")

    let r4 = se_search(eng, "the")
    assert(len(r4) >= 1, "the found")

    let r5 = se_search(eng, "dog")
    assert(len(r5) >= 1, "dog found")

    let has_d1 = se_has_doc(eng, "d1")
    assert(has_d1 == true, "has d1")
    let has_d9 = se_has_doc(eng, "d9")
    assert(has_d9 == false, "no d9")

    print("SEARCH-ENGINE KAT PASS")
