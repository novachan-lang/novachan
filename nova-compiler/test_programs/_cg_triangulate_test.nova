import std/geometry/cg_triangulate

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // Square: 4 vertices -> 2 triangles, area=4, 2x=8.
    let sq = [[0,0],[2,0],[2,2],[0,2]]
    cki("count(square)", cgt_count(sq), 2)
    cki("area2x(square)", cgt_total_area_2x(sq), 8)

    // Triangle: 3 vertices -> 1 triangle, 2x area of tri with base 2, height 1 = 2.
    let tri3 = [[0,0],[1,0],[0,1]]
    cki("count(tri3)", cgt_count(tri3), 1)
    cki("area2x(tri3)", cgt_total_area_2x(tri3), 1)

    // Pentagon: 5 vertices -> 3 triangles.
    let penta = [[0,0],[4,0],[4,4],[2,5],[0,4]]
    cki("count(penta)", cgt_count(penta), 3)

    // 4x4 square: 2x area = 32.
    let sq4 = [[0,0],[4,0],[4,4],[0,4]]
    cki("count(sq4)", cgt_count(sq4), 2)
    cki("area2x(sq4)", cgt_total_area_2x(sq4), 32)

    // Degenerate: fewer than 3 points.
    let tiny = [[0,0],[1,1]]
    cki("count(tiny)", cgt_count(tiny), 0)

    print("PASS _cg_triangulate_test")
