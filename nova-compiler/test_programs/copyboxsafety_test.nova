// copyboxsafety_test — deep-copy / copy() of collections holding boxed float/bool
// elements must not free the box prematurely. Was a use-after-free: deep_copy shared
// the box without a refcount bump while the copy loop decremented it. Stress with many
// copies + reads so a premature free shows up as garbage or a crash.

fn main()
    let orig = [1.5, 2.5, 3.5]
    let i = 0
    while i < 200
        let c = copy(orig)
        assert_near(c[0], 1.5, 0.0001)
        assert_near(c[2], 3.5, 0.0001)
        i = i + 1
    assert_near(orig[1], 2.5, 0.0001)
    assert_eq(orig, [1.5, 2.5, 3.5])

    let bl = [true, false, true]
    let j = 0
    while j < 200
        let cb = copy(bl)
        assert(cb[0] == true, "copy bool0")
        assert(cb[1] == false, "copy bool1")
        j = j + 1
    assert_eq(bl, [true, false, true])

    let d = {"a": 1.5, "b": 2.5}
    let k = 0
    while k < 100
        let cd = copy(d)
        assert_near(cd["a"], 1.5, 0.0001)
        assert_near(cd["b"], 2.5, 0.0001)
        k = k + 1
    assert_near(d["a"], 1.5, 0.0001)

    print("copyboxsafety_test passed")
