import forge_suffixarray

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn joinl(xs: list) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + ","
        out = out + str(xs[i])
        i = i + 1
    out

fn main()
    let fails = 0

    // suffix array of banana -> [5,3,1,0,4,2]
    let sa = sa_build("banana")
    fails = fails + expect("sa_banana", joinl(sa), "5,3,1,0,4,2")
    fails = fails + expect("sa_abc", joinl(sa_build("abc")), "0,1,2")
    fails = fails + expect("sa_aaa", joinl(sa_build("aaa")), "2,1,0")

    // substring search via the index
    fails = fails + expect("has_ana", str(sa_contains(sa, "banana", "ana")), "true")
    fails = fails + expect("has_nan", str(sa_contains(sa, "banana", "nan")), "true")
    fails = fails + expect("has_banana", str(sa_contains(sa, "banana", "banana")), "true")
    fails = fails + expect("has_a", str(sa_contains(sa, "banana", "a")), "true")
    fails = fails + expect("has_no", str(sa_contains(sa, "banana", "xyz")), "false")
    fails = fails + expect("has_ban_no", str(sa_contains(sa, "banana", "bananas")), "false")
    fails = fails + expect("has_empty", str(sa_contains(sa, "banana", "")), "true")

    // LCP array of banana sorted suffixes -> [0,1,3,0,0,2]
    fails = fails + expect("lcp_banana", joinl(sa_lcp(sa, "banana")), "0,1,3,0,0,2")

    // longest repeated substring
    fails = fails + expect("lrs_banana", sa_longest_repeated("banana"), "ana")
    fails = fails + expect("lrs_miss", sa_longest_repeated("mississippi"), "issi")
    fails = fails + expect("lrs_none", sa_longest_repeated("abcd"), "")

    // distinct substring counts
    fails = fails + expect("distinct_banana", str(sa_count_distinct("banana")), "15")
    fails = fails + expect("distinct_aaa", str(sa_count_distinct("aaa")), "3")
    fails = fails + expect("distinct_abc", str(sa_count_distinct("abc")), "6")
    fails = fails + expect("distinct_abab", str(sa_count_distinct("abab")), "7")

    if fails == 0
        print("forge_suffixarray: all passed")
    else
        print("forge_suffixarray: " + str(fails) + " FAILED")
