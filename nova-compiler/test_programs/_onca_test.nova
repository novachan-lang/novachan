import std/phonetic/onca

// KAT helpers.
fn cks(label, got, want)
    if got != want
        print("FAIL onca " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL onca " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── on_nysiis_stage: canonical NYSIIS transforms ─────────────────────────
    // MAC prefix -> MCC; vowels->A; M->N; trailing H stripped (silent at end);
    // collapse duplicates.  Hand-traced: MACINTOSH->MCCINTOSH->key=MCCANTASH
    // ->collapse->MCANTASH->strip-H->MCANTAS.
    cks("nysiis_macintosh", on_nysiis_stage("MACINTOSH"), "MCANTAS")

    // MacDonald: MAC->MCC, MCCDONALD, vowels->A, M->N, collapse CC->C.
    // Hand-traced: key=MCCDANALD->collapse->MCDANALD (no trailing H).
    cks("nysiis_macdonald", on_nysiis_stage("MacDonald"), "MCDANALD")

    // Smith: M->N, trailing H stripped.  SMITH->key=SNATH->stripH->SNAT.
    cks("nysiis_smith", on_nysiis_stage("Smith"), "SNAT")

    // Smyth: same path. SMYTH->key=SNYTH->stripH->SNYT.
    cks("nysiis_smyth", on_nysiis_stage("Smyth"), "SNYT")

    // ── on_soundex_stage: Soundex of pre-processed strings ───────────────────
    // MCANTAS: M(first,5), C->2, A->reset, N->5, T->3 => digits=253 => M253
    cks("soundex_mcantas", on_soundex_stage("MCANTAS"), "M253")

    // SNAT: S(first,2), N->5, A->reset, T->3 => digits=53 pad=>530 => S530
    cks("soundex_snat", on_soundex_stage("SNAT"), "S530")

    // ── on_encode: full ONCA (NYSIIS then Soundex) ───────────────────────────
    // on_encode(name) = on_soundex_stage(on_nysiis_stage(name)).

    // Smith => NYSIIS=SNAT => Soundex=S530.
    cks("encode_smith", on_encode("Smith"), "S530")

    // Smyth => NYSIIS=SNYT => Soundex=S530.  Must equal Smith (phonetic match).
    cks("encode_smyth", on_encode("Smyth"), "S530")

    // Smith and Smyth must produce the SAME ONCA code (they sound alike).
    let smith_code = on_encode("Smith")
    let smyth_code = on_encode("Smyth")
    cks("smith_smyth_match", smith_code, smyth_code)

    // MacDonald => NYSIIS=MCDANALD => Soundex=M235.
    // M(5), C->2, D->3, A->reset, N->5 => digits=235 => M235.
    cks("encode_macdonald", on_encode("MacDonald"), "M235")

    // ── Format invariants ────────────────────────────────────────────────────
    // Every on_encode result must be exactly 4 characters: letter + 3 digits.
    let names = ["Smith", "MacDonald", "Johnson", "Williams", "Brown", "Jones"]
    let ni = 0
    while ni < len(names)
        let code = on_encode(names[ni])
        // Length must be 4.
        cki("len4_" + names[ni], len(code), 4)
        // First char must be a letter (A-Z): ord 65..90.
        let first_ord = ord(char_at(code, 0))
        let is_letter = 0
        if first_ord >= 65 and first_ord <= 90
            is_letter = 1
        cki("firstletter_" + names[ni], is_letter, 1)
        // Remaining 3 chars must be digits 0-9: ord 48..57.
        let di = 1
        while di < 4
            let dord = ord(char_at(code, di))
            let is_digit = 0
            if dord >= 48 and dord <= 57
                is_digit = 1
            cki("digit" + str(di) + "_" + names[ni], is_digit, 1)
            di = di + 1
        ni = ni + 1

    // ── Edge cases ───────────────────────────────────────────────────────────
    // Empty name -> "0000".
    cks("empty", on_encode(""), "0000")

    // Non-alpha chars stripped before processing.
    cks("nonalpha", on_encode("O'Brien"), on_encode("OBrien"))

    print("PASS _onca_test")
