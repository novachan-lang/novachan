// _img_flip_test.nova — KAT for std/image/img_flip
import std/image/img_flip

fn lists_equal(a, b)
    let na = len(a)
    let nb = len(b)
    if na != nb
        return 0
    let i = 0
    while i < na
        if a[i] != b[i]
            return 0
        i = i + 1
    return 1

fn list_to_str(lst)
    let s = "["
    let i = 0
    let n = len(lst)
    while i < n
        if i > 0
            s = s + ","
        s = s + str(lst[i])
        i = i + 1
    s = s + "]"
    s

fn main()
    // KAT 1: img_flip_h on 2x2 image [1,2,3,4]
    // Row0: [1,2] -> [2,1]   Row1: [3,4] -> [4,3]
    // Expected: [2,1,4,3]
    let px1 = []
    px1.push(1)
    px1.push(2)
    px1.push(3)
    px1.push(4)
    let got1 = img_flip_h(px1, 2, 2)
    let want1 = []
    want1.push(2)
    want1.push(1)
    want1.push(4)
    want1.push(3)
    if not lists_equal(got1, want1)
        print("FAIL img_flip_h 2x2: got " + list_to_str(got1) + " want " + list_to_str(want1))
        exit(1)

    // KAT 2: img_flip_v on 2x2 image [1,2,3,4]
    // Row0: [1,2]  Row1: [3,4] -> reversed -> Row0:[3,4] Row1:[1,2]
    // Expected: [3,4,1,2]
    let px2 = []
    px2.push(1)
    px2.push(2)
    px2.push(3)
    px2.push(4)
    let got2 = img_flip_v(px2, 2, 2)
    let want2 = []
    want2.push(3)
    want2.push(4)
    want2.push(1)
    want2.push(2)
    if not lists_equal(got2, want2)
        print("FAIL img_flip_v 2x2: got " + list_to_str(got2) + " want " + list_to_str(want2))
        exit(1)

    // KAT 3: img_flip_h on 1x3 row [10,20,30] (w=3, h=1)
    // Should reverse to [30,20,10]
    let px3 = []
    px3.push(10)
    px3.push(20)
    px3.push(30)
    let got3 = img_flip_h(px3, 3, 1)
    let want3 = []
    want3.push(30)
    want3.push(20)
    want3.push(10)
    if not lists_equal(got3, want3)
        print("FAIL img_flip_h 1x3: got " + list_to_str(got3) + " want " + list_to_str(want3))
        exit(1)

    // KAT 4: flip_h then flip_h is identity
    let px4 = []
    px4.push(5)
    px4.push(10)
    px4.push(15)
    px4.push(20)
    px4.push(25)
    px4.push(30)
    let flipped = img_flip_h(px4, 3, 2)
    let restored = img_flip_h(flipped, 3, 2)
    if not lists_equal(restored, px4)
        print("FAIL img_flip_h double-flip identity: got " + list_to_str(restored) + " want " + list_to_str(px4))
        exit(1)

    // KAT 5: flip_v then flip_v is identity
    let px5 = []
    px5.push(5)
    px5.push(10)
    px5.push(15)
    px5.push(20)
    px5.push(25)
    px5.push(30)
    let fv = img_flip_v(px5, 3, 2)
    let rv = img_flip_v(fv, 3, 2)
    if not lists_equal(rv, px5)
        print("FAIL img_flip_v double-flip identity: got " + list_to_str(rv) + " want " + list_to_str(px5))
        exit(1)

    // KAT 6: single pixel image unchanged by both flips
    let px6 = []
    px6.push(128)
    let fh6 = img_flip_h(px6, 1, 1)
    let fv6 = img_flip_v(px6, 1, 1)
    if fh6[0] != 128
        print("FAIL img_flip_h single pixel: got " + str(fh6[0]))
        exit(1)
    if fv6[0] != 128
        print("FAIL img_flip_v single pixel: got " + str(fv6[0]))
        exit(1)

    print("PASS _img_flip_test")
