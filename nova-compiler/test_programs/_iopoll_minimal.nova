fn main()
  let server = tcp_listen(19877)
  print("server fd = " + str(server))
  io_set_nonblocking(server)
  let p = io_poll_create()
  io_poll_add(p, server, 1)
  spawn
    sleep(100)
    print("spawned: connecting...")
    let c = tcp_connect("127.0.0.1", 19877)
    print("spawned: connected fd=" + str(c))
    if c >= 0
      tcp_send(c, "hi")
      tcp_close(c)
    print("spawned: done")
  print("main: polling...")
  let events = io_poll_wait(p, 3000)
  print("main: got " + str(len(events)) + " events")
  if len(events) > 0
    let client = tcp_accept(server)
    print("main: accepted fd=" + str(client))
    let data = tcp_recv(client)
    print("main: received=" + str(data))
    tcp_close(client)
  tcp_close(server)
  io_poll_close(p)
  sleep(200)
  print("done")
