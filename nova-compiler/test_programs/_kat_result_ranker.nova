import forge_result_ranker

fn main()
    let r = rr_new()
    r = rr_add(r, "doc-a", 10)
    r = rr_add(r, "doc-b", 30)
    r = rr_add(r, "doc-c", 20)
    assert(rr_count(r) == 3, "3 items")

    let top = rr_top(r)
    assert(is_ok(top), "top ok")
    assert(unwrap(top) == "doc-b", "doc-b is top")

    let s = rr_score(r, "doc-a")
    assert(is_ok(s), "score ok")
    assert(unwrap(s) == 10, "doc-a=10")

    let b = rr_boost(r, "doc-a", 25)
    assert(is_ok(b), "boost ok")
    r = unwrap(b)
    let top2 = rr_top(r)
    assert(unwrap(top2) == "doc-a", "doc-a now top after boost")

    assert(rr_total_score(r) == 85, "total=85")

    let bad = rr_score(r, "missing")
    assert(is_err(bad), "unknown item is err")

    let empty = rr_new()
    let no_top = rr_top(empty)
    assert(is_err(no_top), "empty ranker is err")

    print("RESULT-RANKER KAT PASS")
