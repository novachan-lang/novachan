import std/graph/hamiltonian

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn main()
    // KAT 1: ham_has_cycle([[1,2,3],[0,2,3],[0,1,3],[0,1,2]],4)=true
    // K4 (complete graph on 4 nodes): definitely has a Hamiltonian cycle
    let adj_k4 = []
    push(adj_k4, [1, 2, 3])
    push(adj_k4, [0, 2, 3])
    push(adj_k4, [0, 1, 3])
    push(adj_k4, [0, 1, 2])
    ckb("cycle_k4", ham_has_cycle(adj_k4, 4), true)

    // KAT 2: ham_has_path([[1],[0,2],[1]],3)=true
    // Line 0-1-2: path 0->1->2 is Hamiltonian
    let adj_line = []
    push(adj_line, [1])
    push(adj_line, [0, 2])
    push(adj_line, [1])
    ckb("path_line", ham_has_path(adj_line, 3), true)

    // KAT 3: ham_has_cycle([[1],[0,2],[1]],3)=false
    // Line graph: no Hamiltonian cycle (no edge between 0 and 2)
    ckb("cycle_line_false", ham_has_cycle(adj_line, 3), false)

    // KAT 4: ham_has_cycle([[1,2],[0,2],[0,1]],3)=true
    // Triangle K3: 0-1-2-0 is a Hamiltonian cycle
    let adj_tri = []
    push(adj_tri, [1, 2])
    push(adj_tri, [0, 2])
    push(adj_tri, [0, 1])
    ckb("cycle_triangle", ham_has_cycle(adj_tri, 3), true)

    // KAT 5: ham_has_path([[1,2,3],[0],[0],[0]],4)=false
    // Star: center=0 connected to 1,2,3. Leaves only connect to center.
    // Path would need to go 1-0-2-? or similar; can only visit 2 leaves via center
    // No Hamiltonian path: after visiting center, can only reach one other leaf
    let adj_star = []
    push(adj_star, [1, 2, 3])
    push(adj_star, [0])
    push(adj_star, [0])
    push(adj_star, [0])
    ckb("path_star_false", ham_has_path(adj_star, 4), false)

    // Additional: empty graph
    let adj_empty = []
    ckb("cycle_empty_false", ham_has_cycle(adj_empty, 0), false)
    ckb("path_empty_false", ham_has_path(adj_empty, 0), false)

    // Single node: trivially has a path (visits all 1 node)
    let adj_single = []
    push(adj_single, [])
    ckb("path_single", ham_has_path(adj_single, 1), true)
    // Single node: no cycle (need at least 3 nodes)
    ckb("cycle_single_false", ham_has_cycle(adj_single, 1), false)

    // Count cycles: K4 has 3 distinct Hamiltonian cycles
    // K4 has (4-1)!/2 = 6/2 = 3 distinct Hamiltonian cycles
    cki("count_k4", ham_count_cycles(adj_k4, 4), 3)

    // Triangle has exactly 1 Hamiltonian cycle
    cki("count_triangle", ham_count_cycles(adj_tri, 3), 1)

    // Line: 0 cycles
    cki("count_line", ham_count_cycles(adj_line, 3), 0)

    print("PASS _hamiltonian_test")

main()
