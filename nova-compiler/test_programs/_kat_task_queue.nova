import forge_task_queue

fn main()
    let q = tq_new("emails")
    q = tq_set_workers(q, 4)
    q = tq_set_max_retries(q, 2)

    q = tq_enqueue(q, "send_email", {"to": "alice@test.com"})
    q = tq_enqueue_priority(q, "send_sms", {"to": "+123"}, 10)
    assert(tq_pending_count(q) == 2, "2 pending")

    let r1 = tq_dequeue(q)
    q = r1["queue"]
    let job1 = r1["job"]
    assert(job1["type"] == "send_sms", "priority job first")
    q = tq_complete(q, job1)
    assert(tq_completed_count(q) == 1, "1 completed")
    assert(tq_pending_count(q) == 1, "1 pending")

    let r2 = tq_dequeue(q)
    q = r2["queue"]
    let job2 = r2["job"]
    assert(job2["type"] == "send_email", "email job")
    assert(tq_pending_count(q) == 0, "0 pending after dequeue")

    q = tq_fail(q, job2, "timeout")
    assert(tq_pending_count(q) == 1, "retried -> back to pending")
    assert(tq_failed_count(q) == 0, "not exhausted yet")

    let r3 = tq_dequeue(q)
    q = r3["queue"]
    let job3 = r3["job"]
    q = tq_fail(q, job3, "timeout again")
    assert(tq_failed_count(q) == 1, "exhausted retries -> failed")

    q = tq_schedule(q, "cleanup", {"type": "logs"}, 1000)
    q = tq_schedule(q, "report", {"type": "daily"}, 2000)
    let stats = tq_stats(q)
    assert(stats["scheduled"] == 2, "2 scheduled")

    q = tq_promote_scheduled(q, 1500)
    assert(tq_pending_count(q) == 1, "1 promoted")
    let stats2 = tq_stats(q)
    assert(stats2["scheduled"] == 1, "1 still scheduled")

    let final_stats = tq_stats(q)
    assert(final_stats["name"] == "emails", "queue name")
    assert(final_stats["workers"] == 4, "4 workers")

    print("FORGE-TASK-QUEUE KAT PASS")
