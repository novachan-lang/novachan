// Reflection Phase 3: @derive(Serialize) generates to_json() rendering the struct as
// a JSON object. Scalar field values go through json_stringify (handles int/float and
// string quoting/escaping); nested @derive(Serialize) struct fields recurse via
// self.f.to_json(). The serialize direction of the DB/HTTP keystone.
// Expected strings escape { } " as \{ \} \" (the lexer handles all three).

@derive(Serialize)
type Point
    x: int
    y: int

@derive(Serialize)
type Wrap
    p: Point
    tag: string
    n: int

fn main()
    let p = Point { x: 3, y: 4 }
    assert_eq(p.to_json(), "\{\"x\":3,\"y\":4\}")

    // nested Serialize struct + a string (json_stringify quotes it) + an int
    let w = Wrap { p: Point { x: 1, y: 2 }, tag: "hi", n: 7 }
    assert_eq(w.to_json(), "\{\"p\":\{\"x\":1,\"y\":2\},\"tag\":\"hi\",\"n\":7\}")

    print("derive_serialize_test passed")
