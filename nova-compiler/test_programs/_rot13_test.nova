import std/encoding/rot13

// Helper macros — print FAIL and exit on mismatch.
fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ── rot13 known-answer tests ──────────────────────────────────────────────────

// KAT-1: basic uppercase+lowercase mix
cks("rot13_hello",   rot13("Hello"),        "Uryyb")

// KAT-2: self-inverse round-trip with non-letters
cks("rot13_rt",      rot13(rot13("Hello, World!")), "Hello, World!")

// KAT-3: all lowercase, shifts wrapping N-Z to A-M
cks("rot13_abc",     rot13("abc"),          "nop")

// KAT-4: full alphabet uppercase round-trip
cks("rot13_alpha_rt", rot13(rot13("ABCDEFGHIJKLMNOPQRSTUVWXYZ")), "ABCDEFGHIJKLMNOPQRSTUVWXYZ")

// ── caesar_encode known-answer tests ─────────────────────────────────────────

// KAT-5: shift 1, simple
cks("caesar_enc_1",  caesar_encode("abc", 1),  "bcd")

// KAT-6: shift 3, wrap-around xyz -> abc
cks("caesar_enc_xyz", caesar_encode("xyz", 3), "abc")

// KAT-7: shift 13 == rot13
cks("caesar_enc_13", caesar_encode("Hello", 13), rot13("Hello"))

// KAT-8: non-letters preserved
cks("caesar_nonletter", caesar_encode("a1!", 1), "b1!")

// ── caesar_decode known-answer tests ─────────────────────────────────────────

// KAT-9: round-trip
cks("caesar_rt", caesar_decode(caesar_encode("Test", 5), 5), "Test")

// KAT-10: shift 0 is identity
cks("caesar_zero", caesar_encode("Hello, World!", 0), "Hello, World!")

// KAT-11: uppercase case preservation on decode
cks("caesar_upper_rt", caesar_decode(caesar_encode("NOVA", 7), 7), "NOVA")

// KAT-12: mixed sentence round-trip
cks("caesar_sentence_rt", caesar_decode(caesar_encode("The Quick Brown Fox!", 17), 17), "The Quick Brown Fox!")

print("_rot13_test passed")
