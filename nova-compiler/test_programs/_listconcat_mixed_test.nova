// pins the list-concat soundness fix: `+` routes to nova_rt_list_concat when EITHER operand is a
// list; a DYNAMIC operand holding a non-list (dict["missing"]->0) used to be deref'd as a NovaList*
// (segfault). Now list+list concatenates; list+non-list is a DEFINED panic (not a wild deref). This
// test covers the POSITIVE cases (both operands are lists at runtime, incl. via `any`); the panic
// case is verified separately (it aborts by design).
fn main()
    let d = {}
    d["L"] = [9, 8]
    let anylist = d["L"]              // any holding [9,8]

    let a = [1, 2] + [3, 4]           // static list + static list
    assert(len(a) == 4, "list+list concat len 4")
    assert(a[0] == 1 and a[3] == 4, "list+list order preserved")

    let b = [1, 2] + anylist          // list + any(list)
    assert(len(b) == 4, "list + any(list) concat len 4")
    assert(b[2] == 9 and b[3] == 8, "any(list) elements appended")

    let c = anylist + [1, 2]          // any(list) + list
    assert(len(c) == 4, "any(list) + list concat len 4")
    assert(c[0] == 9 and c[3] == 2, "any(list) prefix preserved")

    // nested / repeated to exercise rc on concatenated elements
    let big = []
    let i = 0
    while i < 5
        big = big + [i]
        i = i + 1
    assert(len(big) == 5, "repeated concat builds len 5")
    assert(big[4] == 4, "repeated concat last element")

    print("listconcat_mixed_test passed -- list+list (static + via any) concatenates; non-list is a defined error")
