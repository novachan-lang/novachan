@async
fn fetch_data() -> string
    return "fetched"

@async
fn process_batch(n: int) -> int
    return n * 2

fn main()
    assert(fetch_data__is_async() == 1, "is async")
    assert(process_batch__is_async() == 1, "batch is async")

    let r = fetch_data()
    assert(r == "fetched", "fn works")

    let p = process_batch(21)
    assert(p == 42, "batch fn works")

    print("ASYNC ANNOTATION TEST PASS")
