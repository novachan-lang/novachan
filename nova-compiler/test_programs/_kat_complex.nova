import forge_complex

fn tf(b: bool) -> string
    if b
        return "T"
    "F"
fn ap(a: float, b: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    d < 0.0001

fn main()
    print("add=" + tf(complex_add([1, 2], [3, 4]) == [4, 6]))
    print("sub=" + tf(complex_sub([3, 4], [1, 2]) == [2, 2]))
    // (1+2i)(3+4i) = -5 + 10i
    print("mul=" + tf(complex_mul([1, 2], [3, 4]) == [0 - 5, 10]))
    // i*i = -1
    print("i2=" + tf(complex_mul([0, 1], [0, 1]) == [0 - 1, 0]))
    print("conj=" + tf(complex_conj([3, 4]) == [3, 0 - 4]))
    print("abs=" + tf(ap(complex_abs([3, 4]), 5.0)))
    // z * conj(z) = |z|^2 (real): (3+4i)(3-4i) = 25
    let zzc = complex_mul([3, 4], complex_conj([3, 4]))
    print("z_zconj=" + tf(zzc[0] == 25 and zzc[1] == 0))
    // (a/b)*b = a : divide then multiply back recovers
    let q = complex_div([1, 2], [3, 4])
    let back = complex_mul(q, [3, 4])
    print("div_roundtrip=" + tf(ap(back[0], 1.0) and ap(back[1], 2.0)))
    // arg(i) = pi/2 ~ 1.5708
    print("arg_i=" + tf(ap(complex_arg([0, 1]), 1.5707963)))
    print("div_zero=" + tf(complex_div([1, 1], [0, 0]) == [0.0, 0.0]))
