// No import - define functions inline
fn gz_flags_local(buf: any) -> int
    if len(buf) < 4
        return 0
    return buf[3]

fn gz_flag_fname_v1(buf: any) -> bool
    if len(buf) < 4
        return false
    let f = buf[3]
    let b = f & 8
    if b == 8
        return true
    return false

fn gz_flag_fname_v2(buf: any) -> int
    if len(buf) < 4
        return 0
    let f = buf[3]
    let b = f & 8
    if b == 8
        return 1
    return 0

fn main()
    let buf = []
    push(buf, 31)
    push(buf, 139)
    push(buf, 8)
    push(buf, 8)
    push(buf, 0)
    push(buf, 0)
    push(buf, 0)
    push(buf, 0)
    push(buf, 0)
    push(buf, 3)
    let r1 = gz_flag_fname_v1(buf)
    print("v1 (bool)=" + str(r1))
    let r2 = gz_flag_fname_v2(buf)
    print("v2 (int)=" + str(r2))
    print("PASS _gzdbg8_test")
