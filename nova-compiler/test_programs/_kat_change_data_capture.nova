import forge_change_data_capture

fn main()
    let c = cdc_new()
    assert(cdc_change_count(c) == 0, "starts empty")

    c = cdc_insert(c, "users", "u1", "alice")
    c = cdc_update(c, "users", "u1", "alice", "alice-v2")
    c = cdc_delete_record(c, "users", "u1")
    assert(cdc_change_count(c) == 3, "3 changes")

    assert(cdc_change_op(c, 1) == "INSERT", "seq 1 = INSERT")
    assert(cdc_change_table(c, 1) == "users", "seq 1 table")
    assert(cdc_change_key(c, 1) == "u1", "seq 1 key")

    assert(cdc_change_op(c, 2) == "UPDATE", "seq 2 = UPDATE")
    assert(cdc_change_op(c, 3) == "DELETE", "seq 3 = DELETE")

    assert(cdc_change_op(c, 99) == "", "missing seq empty")
    assert(cdc_next_seq(c) == 4, "next seq = 4")

    c = cdc_insert(c, "orders", "o1", "order-data")
    assert(cdc_change_count(c) == 4, "4 changes")
    assert(cdc_change_table(c, 4) == "orders", "seq 4 = orders")

    print("CHANGE-DATA-CAPTURE KAT PASS")
