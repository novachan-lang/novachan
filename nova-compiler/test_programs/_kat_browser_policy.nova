import forge_browser_policy

fn tf(b: bool) -> string
    if b
        return "T"
    "F"

fn main()
    let q = chr(34)
    print("none=" + tf(pp_none("geolocation") == "geolocation=()"))
    print("self=" + tf(pp_self("fullscreen") == "fullscreen=(self)"))
    print("any=" + tf(pp_any("autoplay") == "autoplay=*"))
    print("allow=" + tf(pp_allow("camera", ["https://a.com"]) == "camera=(self " + q + "https://a.com" + q + ")"))
    print("allow2=" + tf(pp_allow("camera", ["https://a.com", "https://b.com"]) == "camera=(self " + q + "https://a.com" + q + " " + q + "https://b.com" + q + ")"))
    print("allow_empty=" + tf(pp_allow("camera", []) == "camera=(self)"))
    let hdr = permissions_policy([pp_none("geolocation"), pp_self("fullscreen"), pp_any("autoplay")])
    print("hdr=" + tf(hdr == "geolocation=(), fullscreen=(self), autoplay=*"))
    print("csd=" + tf(clear_site_data(["cache", "cookies"]) == q + "cache" + q + ", " + q + "cookies" + q))
    print("csd_all=" + tf(clear_site_data_all() == q + "*" + q))
