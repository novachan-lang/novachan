import forge_service_mesh_proxy

fn main()
    let smp = smp_new()
    smp = smp_register(smp, "frontend", "10.0.0.1:80")
    smp = smp_register(smp, "backend", "10.0.0.2:8080")
    smp = smp_register(smp, "database", "10.0.0.3:5432")
    assert(smp_service_count(smp) == 3, "3 services")

    smp = smp_add_route(smp, "frontend", "backend", "/api")
    smp = smp_add_route(smp, "backend", "database", "/db")
    assert(smp_route_count(smp) == 2, "2 routes")

    let addr = smp_route(smp, "frontend", "/api")
    assert(addr == "10.0.0.2:8080", "routed to backend")
    assert(smp_total_requests(smp) == 1, "1 request")
    assert(smp_service_requests(smp, "backend") == 1, "backend got 1")

    let addr2 = smp_route(smp, "backend", "/db")
    assert(addr2 == "10.0.0.3:5432", "routed to db")

    let miss = smp_route(smp, "frontend", "/unknown")
    assert(miss == "", "no route = empty")
    assert(smp_total_errors(smp) == 1, "1 error")

    smp = smp_set_health(smp, "database", 0)
    let down = smp_route(smp, "backend", "/db")
    assert(down == "", "unhealthy = no route")
    assert(smp_total_errors(smp) == 2, "2 errors")

    smp = smp_set_health(smp, "database", 1)
    let up = smp_route(smp, "backend", "/db")
    assert(up == "10.0.0.3:5432", "recovered")

    assert(smp_service_requests(smp, "nonexistent") == 0, "no service = 0")

    print("SERVICE-MESH-PROXY KAT PASS")
