// Dispatch benchmark: 12 types implementing the same method, dispatched dynamically
type T0
    t0_v: int

type T1
    t1_v: int

type T2
    t2_v: int

type T3
    t3_v: int

type T4
    t4_v: int

type T5
    t5_v: int

type T6
    t6_v: int

type T7
    t7_v: int

type T8
    t8_v: int

type T9
    t9_v: int

type T10
    t10_v: int

type T11
    t11_v: int

fn T0.kick(self) -> int
    return self.t0_v

fn T1.kick(self) -> int
    return self.t1_v

fn T2.kick(self) -> int
    return self.t2_v

fn T3.kick(self) -> int
    return self.t3_v

fn T4.kick(self) -> int
    return self.t4_v

fn T5.kick(self) -> int
    return self.t5_v

fn T6.kick(self) -> int
    return self.t6_v

fn T7.kick(self) -> int
    return self.t7_v

fn T8.kick(self) -> int
    return self.t8_v

fn T9.kick(self) -> int
    return self.t9_v

fn T10.kick(self) -> int
    return self.t10_v

fn T11.kick(self) -> int
    return self.t11_v

fn main()
    let xs = []
    xs.push(T0(0))
    xs.push(T1(1))
    xs.push(T2(2))
    xs.push(T3(3))
    xs.push(T4(4))
    xs.push(T5(5))
    xs.push(T6(6))
    xs.push(T7(7))
    xs.push(T8(8))
    xs.push(T9(9))
    xs.push(T10(10))
    xs.push(T11(11))
    let t0 = clock_ns()
    let acc = 0
    let r = 0
    while r < 200000
        let k = 0
        while k < 12
            acc = acc + xs[k].kick()
            k = k + 1
        r = r + 1
    print("acc=" + str(acc))
    print("dispatch ns=" + str(clock_ns() - t0))
