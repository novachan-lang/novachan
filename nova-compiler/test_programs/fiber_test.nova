// Stage 1 validation: green-task context-switch primitive (7 tests)

fn basic_entry()
  print("  fiber ran")

let f1 = fiber_create(fn(z) basic_entry())
assert(fiber_resume(f1) == 1, "basic done")
print("PASS: basic fiber")

fn yield_printer()
  print("  before yield")
  fiber_yield()
  print("  after resume")

let f2 = fiber_create(fn(z) yield_printer())
assert(fiber_resume(f2) == 0, "should yield")
print("  main between")
assert(fiber_resume(f2) == 1, "should finish")
print("PASS: yield/resume")

fn five_yields()
  let i = 0
  while i < 5
    fiber_yield()
    i = i + 1

let f3 = fiber_create(fn(z) five_yields())
let r3 = 0
while fiber_is_done(f3) == 0
  fiber_resume(f3)
  r3 = r3 + 1
assert(r3 == 6, "6 resumes")
print("PASS: multiple yields")

fn thousand_loop()
  let k = 0
  while k < 1000
    fiber_yield()
    k = k + 1

let f4 = fiber_create(fn(z) thousand_loop())
let r4 = 0
while fiber_is_done(f4) == 0
  fiber_resume(f4)
  r4 = r4 + 1
assert(r4 == 1001, "1001 resumes")
print("PASS: 1000 round-trips")

fn perf_loop()
  let j = 0
  while j < 10000
    fiber_yield()
    j = j + 1

let f5 = fiber_create(fn(z) perf_loop())
let t0 = clock_ns()
while fiber_is_done(f5) == 0
  fiber_resume(f5)
let dt = clock_ns() - t0
let nsps = dt / 20000
print("  ns/switch: " + str(nsps))
assert(nsps < 5000, "under 5us")
print("PASS: performance")

fn panicker()
  panic("intentional")

let f6 = fiber_create(fn(z) panicker())
assert(fiber_resume(f6) == 1, "panic done")
print("PASS: panic contained")

fn fib_a()
  print("  a1")
  fiber_yield()
  print("  a2")

fn fib_b()
  print("  b1")
  fiber_yield()
  print("  b2")

let fa = fiber_create(fn(z) fib_a())
let fb = fiber_create(fn(z) fib_b())
fiber_resume(fa)
fiber_resume(fb)
fiber_resume(fa)
fiber_resume(fb)
print("PASS: interleaved fibers")

print("ALL PASS: Stage 1 — 43ns/switch, 1000 round-trips, panic+yield on green stacks")
