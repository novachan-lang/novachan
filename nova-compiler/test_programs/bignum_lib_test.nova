import std/numeric/nat

// Validation test for the bignum module (arbitrary-precision decimal strings).
// All expected values are computed by hand from schoolbook arithmetic.
fn main()
    // add: 999 + 1 = 1000
    assert(nat.bn_add("999", "1") == "1000", "bn_add 999+1 == 1000")
    // add normalizes leading zeros: 00012 + 8 = 20
    assert(nat.bn_add("00012", "8") == "20", "bn_add leading-zero normalize")

    // cmp: 100 > 99 -> 1 ; 99 < 100 -> -1 ; equal after normalize -> 0
    assert(nat.bn_cmp("100", "99") == 1, "bn_cmp 100>99")
    assert(nat.bn_cmp("99", "100") == -1, "bn_cmp 99<100")
    assert(nat.bn_cmp("0123", "123") == 0, "bn_cmp normalized equal")

    // mul: 12*12 = 144 ; 999*999 = 998001 ; 0*x = 0
    assert(nat.bn_mul("12", "12") == "144", "bn_mul 12*12 == 144")
    assert(nat.bn_mul("999", "999") == "998001", "bn_mul 999*999 == 998001")
    assert(nat.bn_mul("0", "123456") == "0", "bn_mul 0*x == 0")

    // sub: 1000 - 1 = 999 ; equal -> 0
    assert(nat.bn_sub("1000", "1") == "999", "bn_sub 1000-1 == 999")
    assert(nat.bn_sub("555", "555") == "0", "bn_sub equal == 0")

    // divmod: 1234 / 56 = 22 rem 2  (22*56 = 1232)
    let dm = nat.bn_divmod("1234", "56")
    assert(dm[0] == "22", "bn_divmod quotient == 22")
    assert(dm[1] == "2", "bn_divmod remainder == 2")

    // gcd: gcd(12,18) = 6 ; gcd(0,5) = 5
    assert(nat.bn_gcd("12", "18") == "6", "bn_gcd 12,18 == 6")
    assert(nat.bn_gcd("0", "5") == "5", "bn_gcd 0,5 == 5")

    print("bignum_lib_test passed")
