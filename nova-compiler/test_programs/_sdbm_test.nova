// _sdbm_test.nova — KAT for std/hash/sdbm.nova
//
// Known-answer test vectors (all hand-computed or cross-checked):
//   h_sdbm("")       = 0        (trivial: loop never runs, init = 0)
//   h_sdbm("a")      = 97       (c=97, h = 97+0+0-0 = 97)
//   h_sdbm("ab")     = 6363201  (hand-traced in module header)
//   h_sdbm("hello")  = 684824882 (cross-checked against noncrypto.nova)
//   seeded("")        = seed     (no bytes processed, result = seed masked)
//   seeded("a", 0)   = 97       (same as unseeded)
//   determinism: h_sdbm("hello") called twice == same
//   different inputs: h_sdbm("abc") != h_sdbm("xyz")

import std/hash/sdbm

// Integer check helper
fn cki(label, got, expected)
    if got == expected
        // pass — silent
    else
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// String check helper (unused here but kept for completeness; suppresses unused-import)
fn cks(label, got, expected)
    if got == expected
        // pass — silent
    else
        print("FAIL " + label + ": got " + got + " expected " + expected)
        exit(1)

fn main()
    // KAT 1: empty string -> 0 (canonical base case)
    cki("empty", h_sdbm(""), 0)

    // KAT 2: single byte 'a' -> 97
    // Trace: h = (97 + (0<<6) + (0<<16) - 0) & mask = 97
    cki("a", h_sdbm("a"), 97)

    // KAT 3: "ab" -> 6363201 (hand-traced in module header)
    // After 'a': h=97
    // After 'b': h = (98 + (97<<6) + (97<<16) - 97) & 0xFFFFFFFF
    //              = (98 + 6208 + 6356992 - 97) & mask = 6363201
    cki("ab", h_sdbm("ab"), 6363201)

    // KAT 4: "hello" -> 684824882 (published in noncrypto.nova KAT section)
    cki("hello", h_sdbm("hello"), 684824882)

    // KAT 5: seeded with seed=0 on empty string returns 0
    // _sdbm_core("", 0): h starts at 0&mask=0, loop never runs, returns 0
    cki("seeded_empty_0", h_sdbm_seeded("", 0), 0)

    // KAT 6: seeded with seed=0 on "a" must equal unseeded on "a" (= 97)
    cki("seeded_a_0", h_sdbm_seeded("a", 0), 97)

    // KAT 7: seeded with non-zero seed on empty returns seed (masked to 32 bits)
    // seed=12345, no bytes -> h = 12345 & 0xFFFFFFFF = 12345
    cki("seeded_empty_12345", h_sdbm_seeded("", 12345), 12345)

    // KAT 8: determinism — calling h_sdbm("hello") twice gives same result
    let v1 = h_sdbm("hello")
    let v2 = h_sdbm("hello")
    cki("determinism", v1, v2)

    // KAT 9: different inputs produce different hashes (collision sanity)
    let ha = h_sdbm("abc")
    let hx = h_sdbm("xyz")
    if ha == hx
        print("FAIL collision: abc and xyz collide at " + str(ha))
        exit(1)

    // KAT 10: result is always in [0, 0xFFFFFFFF] range
    // Test with a longer string that exercises multi-byte mixing
    let hlong = h_sdbm("The quick brown fox jumps over the lazy dog")
    if hlong < 0
        print("FAIL range: hlong is negative: " + str(hlong))
        exit(1)
    if hlong > 4294967295
        print("FAIL range: hlong exceeds 32 bits: " + str(hlong))
        exit(1)

    print("_sdbm_test passed")

main()
