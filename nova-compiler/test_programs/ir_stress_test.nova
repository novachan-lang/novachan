type Point
    x: int
    y: int

fn make_point(x: int, y: int) -> Point
    Point(x, y)

fn point_sum(p: Point) -> int
    match p
        Point(x, y) =>
            x + y

fn find_first_negative(items: list) -> int
    let i = 0
    while i < len(items)
        if items[i] < 0
            return items[i]
        i = i + 1
    return 0

fn count_positives(items: list) -> int
    let count = 0
    for item in items
        if item > 0
            count = count + 1
    return count

fn is_alpha(ch: string) -> bool
    let c = ord(ch)
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or ch == "_"

fn tokenize_word(s: string, pos: int) -> string
    let word = ""
    while pos < len(s) and is_alpha(s[pos])
        word = word + s[pos]
        pos = pos + 1
    word

// Test implicit returns and struct matching
let p = make_point(3, 7)
print("point_sum: " + str(point_sum(p)))

// Test early return
let nums = [5, 3, -2, 8, -1]
print("first neg: " + str(find_first_negative(nums)))

// Test for loop
print("positives: " + str(count_positives(nums)))

// Test implicit return with complex expr
print("is_alpha(a): " + str(is_alpha("a")))
print("is_alpha(1): " + str(is_alpha("1")))

// Test tokenize
print("word: " + tokenize_word("hello world", 0))

// Test match in loop
let points = [make_point(1, 2), make_point(3, 4), make_point(5, 6)]
let total = 0
for pt in points
    match pt
        Point(x, y) =>
            total = total + x + y
print("total: " + str(total))

// Test break
let found = -1
let j = 0
while j < len(nums)
    if nums[j] < 0
        found = nums[j]
        break
    j = j + 1
print("found: " + str(found))

print("PASS")
