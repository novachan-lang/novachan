// NOVA way (not Rust/Python): structs serialize AUTOMATICALLY — zero @derive, zero .to_json().
// json_stringify(p) on ANY record struct derives the JSON object from its STRUCTURE (innovation D1);
// nested structs recurse through the same derived path. No annotation anywhere.
// (Expected strings escape { } " as \{ \} \" — { is interpolation in NOVA.)

type Point
    x: int
    y: int

type Wrap
    p: Point
    tag: string
    n: int

fn main()
    let p = Point { x: 3, y: 4 }
    // automatic: the universal serializer renders a struct's structure, no annotation
    assert_eq(json_stringify(p), "\{\"x\":3,\"y\":4\}")

    // nested struct + a string (quoted) + an int, all derived
    let w = Wrap { p: Point { x: 1, y: 2 }, tag: "hi", n: 7 }
    assert_eq(json_stringify(w), "\{\"p\":\{\"x\":1,\"y\":2\},\"tag\":\"hi\",\"n\":7\}")

    print("auto_json_test passed")
