import std/rational/rfrac_format

fn ckr(label, got, wn, wd)
    if got[0] != wn or got[1] != wd
        print("FAIL rfrac_format " + label + ": got=" + str(got[0]) + "/" + str(got[1]) + " want=" + str(wn) + "/" + str(wd))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL rfrac_format " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // rft_parse KAT
    ckr("parse 3/4", rft_parse("3/4"), 3, 4)
    ckr("parse -5/8", rft_parse("-5/8"), -5, 8)
    ckr("parse 7", rft_parse("7"), 7, 1)
    ckr("parse 1 3/4", rft_parse("1 3/4"), 7, 4)
    ckr("parse 6/4", rft_parse("6/4"), 3, 2)

    // rft_to_string KAT
    cks("to_str 3/4", rft_to_string([3, 4]), "3/4")
    cks("to_str 5/1", rft_to_string([5, 1]), "5")

    // rft_to_ratio KAT
    cks("to_ratio 3/4", rft_to_ratio([3, 4]), "3:4")

    // rft_from_ratio KAT
    ckr("from_ratio 3:4", rft_from_ratio("3:4"), 3, 4)

    // rft_to_percent KAT
    cks("to_pct 3/4", rft_to_percent([3, 4]), "75%")
    cks("to_pct 1/3", rft_to_percent([1, 3]), "33%")

    // round-trip KAT
    ckr("round_trip [3,2]", rft_parse(rft_to_string([3, 2])), 3, 2)

    print("PASS _rfrac_format_test")
