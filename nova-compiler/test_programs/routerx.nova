fn router_new()
  let r = {}
  r["routes"] = []
  r

fn route_add(router, method, pattern, handler)
  push(router["routes"], [method, pattern, handler])

fn _match_pattern(pattern, path)
  let pat_parts = split(pattern, "/")
  let path_parts = split(path, "/")
  if len(pat_parts) != len(path_parts)
    return err("length mismatch")
  let params = {}
  let i = 0
  while i < len(pat_parts)
    let pp = pat_parts[i]
    let vp = path_parts[i]
    if len(pp) > 0 and starts_with(pp, ":")
      let param_name = slice(pp, 1, len(pp))
      params[param_name] = vp
    else if pp != vp
      return err("mismatch")
    i = i + 1
  ok(params)

fn route_match(router, method, path)
  let routes = router["routes"]
  let i = 0
  while i < len(routes)
    let route = routes[i]
    if route[0] == method or route[0] == "*"
      let mr = _match_pattern(route[1], path)
      if is_ok(mr)
        let result = {}
        result["handler"] = route[2]
        result["params"] = unwrap(mr)
        return ok(result)
    i = i + 1
  err("no matching route")

fn _handle_hello(params)
  "Hello, " + str(params["name"])

fn _handle_user(params)
  "User #" + str(params["id"])

fn _handle_index(params)
  "Welcome"

fn main()
  let r = router_new()
  route_add(r, "GET", "/", fn(z) _handle_index(z))
  route_add(r, "GET", "/hello/:name", fn(z) _handle_hello(z))
  route_add(r, "GET", "/users/:id", fn(z) _handle_user(z))

  let m1 = route_match(r, "GET", "/")
  assert(is_ok(m1), "root matches")
  let match1 = unwrap(m1)
  let h1 = match1["handler"]
  assert(h1(match1["params"]) == "Welcome", "root handler")

  let m2 = route_match(r, "GET", "/hello/world")
  assert(is_ok(m2), "hello matches")
  let match2 = unwrap(m2)
  assert(match2["params"]["name"] == "world", "param extracted")
  let h2 = match2["handler"]
  assert(h2(match2["params"]) == "Hello, world", "hello handler")

  let m3 = route_match(r, "GET", "/users/42")
  assert(is_ok(m3), "user matches")
  let match3 = unwrap(m3)
  assert(match3["params"]["id"] == "42", "user id param")

  let m4 = route_match(r, "GET", "/not/found")
  assert(is_err(m4), "no match = err")

  let m5 = route_match(r, "POST", "/")
  assert(is_err(m5), "wrong method")

  print("routerx: all passed")
