import std/util/tuple

// KAT helpers
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got " + got + " want " + want)
        exit(1)

fn ckb(label: string, got, want)
    if got != want
        print("FAIL " + label + ": mismatch")
        exit(1)

// ── KAT 1: tp_pair first/second ──────────────────────────────────────────────
let p = tp_pair(1, "x")
let p_first = tp_first(p)
cki("pair_first", p_first, 1)

let p_second = tp_second(p)
cks("pair_second", p_second, "x")

// ── KAT 2: tp_size pair ───────────────────────────────────────────────────────
cki("pair_size", tp_size(p), 2)

// ── KAT 3: tp_swap ────────────────────────────────────────────────────────────
let q = tp_swap(p)
let q_first = tp_first(q)
cks("swap_first", q_first, "x")

let q_second = tp_second(q)
cki("swap_second", q_second, 1)

// ── KAT 4: tp_triple third/size ───────────────────────────────────────────────
let t = tp_triple(1, 2, 3)
let t_third = tp_third(t)
cki("triple_third", t_third, 3)
cki("triple_size", tp_size(t), 3)

// ── KAT 5: tp_to_list pair ────────────────────────────────────────────────────
let pl = tp_to_list(tp_pair(4, 5))
let pl0 = pl[0]
let pl1 = pl[1]
cki("to_list_pair_0", pl0, 4)
cki("to_list_pair_1", pl1, 5)
cki("to_list_pair_len", len(pl), 2)

// ── KAT 6: tp_to_list triple ─────────────────────────────────────────────────
let tl = tp_to_list(tp_triple(10, 20, 30))
let tl0 = tl[0]
let tl1 = tl[1]
let tl2 = tl[2]
cki("to_list_triple_0", tl0, 10)
cki("to_list_triple_1", tl1, 20)
cki("to_list_triple_2", tl2, 30)
cki("to_list_triple_len", len(tl), 3)

// ── KAT 7: mixed-type triple ──────────────────────────────────────────────────
let m = tp_triple(42, "hello", 99)
let m_first = tp_first(m)
let m_second = tp_second(m)
let m_third = tp_third(m)
cki("mixed_first", m_first, 42)
cks("mixed_second", m_second, "hello")
cki("mixed_third", m_third, 99)

print("_tuple_test passed")
