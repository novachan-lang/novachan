import std/data/tlv

// cki: check int equality
fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // ── KAT 1: tl_encode byte layout ─────────────────────────────────────────
    // Build value bytes "AB" = [65, 66]
    let v = tl_bytes("AB")
    let enc = tl_encode(5, v)
    // Expect: [5, 2, 65, 66]
    cki("encode type byte",  bytes_get(enc, 0), 5)
    cki("encode len byte",   bytes_get(enc, 1), 2)
    cki("encode val[0]",     bytes_get(enc, 2), 65)
    cki("encode val[1]",     bytes_get(enc, 3), 66)
    cki("encode total len",  bytes_len(enc), 4)
    print("KAT 1 passed: tl_encode byte layout")

    // ── KAT 2: tl_decode_at round-trip ────────────────────────────────────────
    let r = tl_decode_at(enc, 0)
    cki("decode type",     r[0], 5)
    cki("decode vlen",     bytes_len(r[1]), 2)
    cki("decode next_pos", r[2], 4)
    cki("decode val[0]",   bytes_get(r[1], 0), 65)
    cki("decode val[1]",   bytes_get(r[1], 1), 66)
    print("KAT 2 passed: tl_decode_at round-trip")

    // ── KAT 3: tl_encode type=0 / empty value ────────────────────────────────
    let empty_val = bytes(0)
    let enc0 = tl_encode(0, empty_val)
    cki("encode0 type byte",  bytes_get(enc0, 0), 0)
    cki("encode0 len byte",   bytes_get(enc0, 1), 0)
    cki("encode0 total len",  bytes_len(enc0), 2)
    print("KAT 3 passed: tl_encode type=0 empty value")

    // ── KAT 4: tl_encode_all / tl_decode_all round-trip ─────────────────────
    let x_bytes = tl_bytes("X")
    let yz_bytes = tl_bytes("YZ")
    let item1 = []
    item1.push(1)
    item1.push(x_bytes)
    let item2 = []
    item2.push(2)
    item2.push(yz_bytes)
    let items = []
    items.push(item1)
    items.push(item2)
    let blob = tl_encode_all(items)
    // Wire: [1,1,'X', 2,2,'Y','Z'] = 7 bytes
    cki("encode_all total len", bytes_len(blob), 7)
    cki("encode_all rec1 type",  bytes_get(blob, 0), 1)
    cki("encode_all rec1 vlen",  bytes_get(blob, 1), 1)
    cki("encode_all rec1 val",   bytes_get(blob, 2), 88)
    cki("encode_all rec2 type",  bytes_get(blob, 3), 2)
    cki("encode_all rec2 vlen",  bytes_get(blob, 4), 2)
    cki("encode_all rec2 val0",  bytes_get(blob, 5), 89)
    cki("encode_all rec2 val1",  bytes_get(blob, 6), 90)
    print("KAT 4a passed: tl_encode_all byte layout")

    let decoded = tl_decode_all(blob)
    cki("decode_all length", len(decoded), 2)
    cki("decode_all [0] type", decoded[0][0], 1)
    cki("decode_all [1] type", decoded[1][0], 2)
    cki("decode_all [0] vlen", bytes_len(decoded[0][1]), 1)
    cki("decode_all [1] vlen", bytes_len(decoded[1][1]), 2)
    cki("decode_all [0] val", bytes_get(decoded[0][1], 0), 88)
    cki("decode_all [1] val0", bytes_get(decoded[1][1], 0), 89)
    cki("decode_all [1] val1", bytes_get(decoded[1][1], 1), 90)
    print("KAT 4b passed: tl_decode_all round-trip")

    // ── KAT 5: type=255 (max tag byte) ────────────────────────────────────────
    let ff_val = tl_bytes("Z")
    let enc255 = tl_encode(255, ff_val)
    cki("encode 255 type byte", bytes_get(enc255, 0), 255)
    cki("encode 255 len byte",  bytes_get(enc255, 1), 1)
    cki("encode 255 val",       bytes_get(enc255, 2), 90)
    let r255 = tl_decode_at(enc255, 0)
    cki("decode 255 type",    r255[0], 255)
    cki("decode 255 vlen",    bytes_len(r255[1]), 1)
    cki("decode 255 next",    r255[2], 3)
    print("KAT 5 passed: type=255 max tag")

    // ── KAT 6: multi-record decode_all with 3 records ────────────────────────
    let a1 = []
    a1.push(10)
    a1.push(tl_bytes("Hello"))
    let a2 = []
    a2.push(20)
    a2.push(tl_bytes(""))
    let a3 = []
    a3.push(30)
    a3.push(tl_bytes("!"))
    let all3 = []
    all3.push(a1)
    all3.push(a2)
    all3.push(a3)
    let blob3 = tl_encode_all(all3)
    // rec1: 2+5=7 bytes; rec2: 2+0=2 bytes; rec3: 2+1=3 bytes => total 12
    cki("encode_all 3rec len", bytes_len(blob3), 12)
    let dec3 = tl_decode_all(blob3)
    cki("decode_all 3rec count",    len(dec3), 3)
    cki("decode_all 3rec [0] type", dec3[0][0], 10)
    cki("decode_all 3rec [0] vlen", bytes_len(dec3[0][1]), 5)
    cki("decode_all 3rec [1] type", dec3[1][0], 20)
    cki("decode_all 3rec [1] vlen", bytes_len(dec3[1][1]), 0)
    cki("decode_all 3rec [2] type", dec3[2][0], 30)
    cki("decode_all 3rec [2] vlen", bytes_len(dec3[2][1]), 1)
    print("KAT 6 passed: 3-record encode_all/decode_all")

    print("_tlv_test passed")
