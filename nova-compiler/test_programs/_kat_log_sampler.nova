import forge_log_sampler

fn main()
    let s = ls_new(5)
    assert(ls_sample_rate(s) == 5, "rate 5")
    assert(ls_total_events(s) == 0, "starts 0")

    let i = 0
    while i < 10
        let r = ls_should_log(s)
        s = r["s"]
        i = i + 1
    assert(ls_total_events(s) == 10, "10 events")
    assert(ls_total_sampled(s) == 2, "2 sampled (5,10)")
    assert(ls_total_dropped(s) == 8, "8 dropped")
    assert(ls_drop_rate(s) == 80, "80% drop rate")

    let r1 = ls_should_log(s)
    s = r1["s"]
    assert(r1["log"] == 0, "11th not sampled")

    let j = 0
    while j < 4
        let r2 = ls_should_log(s)
        s = r2["s"]
        j = j + 1
    assert(ls_total_sampled(s) == 3, "3 sampled at 15")

    print("LOG-SAMPLER KAT PASS")
