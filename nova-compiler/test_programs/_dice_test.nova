// KAT test for std/random/dice
// All concrete values hand-computed by simulating the embedded LCG in Python.
//
// LCG: state = (state * 6364136223846793005 + 1442695040888963407) & 0x7FFFFFFFFFFFFFFF
//
// dc_roll("3d6", 42):
//   step1 = 1258627373665771185 -> 1258627373665771185 % 6 + 1 = 4
//   step2 = 4159066171780167020 -> 4159066171780167020 % 6 + 1 = 3
//   step3 = 7615522811268512075 -> 7615522811268512075 % 6 + 1 = 6
//   sum = 4 + 3 + 6 = 13
//
// dc_roll("2d10+5", 100):
//   step1 -> 6, step2 -> 9; total = 6 + 9 + 5 = 20
//
// dc_roll("d20", 7):
//   step1 -> 11

import std/random/dice

// ── helpers ──────────────────────────────────────────────────────────────────

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got " + got + " want " + want)
        exit(1)

fn ckf(label: string, got: float, want: float, eps: float)
    let diff = got - want
    if diff < 0.0
        diff = 0.0 - diff
    if diff > eps
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// ═════════════════════════════════════════════════════════════════════════════
// KAT 1: dc_parse("3d6+2") -> count=3, sides=6, modifier=2
// ═════════════════════════════════════════════════════════════════════════════
let p1 = dc_parse("3d6+2")
cki("KAT1_count",    p1["count"],    3)
cki("KAT1_sides",    p1["sides"],    6)
cki("KAT1_modifier", p1["modifier"], 2)

// ═════════════════════════════════════════════════════════════════════════════
// KAT 2: dc_parse("d20") -> count=1, sides=20, modifier=0
// ═════════════════════════════════════════════════════════════════════════════
let p2 = dc_parse("d20")
cki("KAT2_count",    p2["count"],    1)
cki("KAT2_sides",    p2["sides"],    20)
cki("KAT2_modifier", p2["modifier"], 0)

// ═════════════════════════════════════════════════════════════════════════════
// KAT 3: dc_parse("2d10-1") -> count=2, sides=10, modifier=-1
// ═════════════════════════════════════════════════════════════════════════════
let p3 = dc_parse("2d10-1")
cki("KAT3_count",    p3["count"],    2)
cki("KAT3_sides",    p3["sides"],    10)
cki("KAT3_modifier", p3["modifier"], -1)

// ═════════════════════════════════════════════════════════════════════════════
// KAT 4: dc_min / dc_max
// dc_min("3d6")     = 3*1 + 0 = 3
// dc_max("3d6")     = 3*6 + 0 = 18
// dc_min("2d10+5")  = 2*1 + 5 = 7
// dc_max("2d10+5")  = 2*10 + 5 = 25
// ═════════════════════════════════════════════════════════════════════════════
cki("KAT4_min_3d6",      dc_min("3d6"),    3)
cki("KAT4_max_3d6",      dc_max("3d6"),    18)
cki("KAT4_min_2d10p5",   dc_min("2d10+5"), 7)
cki("KAT4_max_2d10p5",   dc_max("2d10+5"), 25)

// ═════════════════════════════════════════════════════════════════════════════
// KAT 5: dc_average("1d6") = 1*(6+1)/2.0 + 0 = 3.5
// ═════════════════════════════════════════════════════════════════════════════
let avg_1d6 = dc_average("1d6")
ckf("KAT5_avg_1d6", avg_1d6, 3.5, 0.001)

// ═════════════════════════════════════════════════════════════════════════════
// KAT 6: dc_average("2d6") = 2*(6+1)/2.0 + 0 = 7.0
// ═════════════════════════════════════════════════════════════════════════════
let avg_2d6 = dc_average("2d6")
ckf("KAT6_avg_2d6", avg_2d6, 7.0, 0.001)

// ═════════════════════════════════════════════════════════════════════════════
// KAT 7: dc_roll("3d6", 42) == 13 (hand-computed from LCG simulation)
//        result in valid range [3, 18]
// ═════════════════════════════════════════════════════════════════════════════
let r1 = dc_roll("3d6", 42)
cki("KAT7_roll_3d6_concrete", r1, 13)
if r1 < 3
    print("FAIL KAT7_range_low: " + str(r1))
    exit(1)
if r1 > 18
    print("FAIL KAT7_range_high: " + str(r1))
    exit(1)

// ═════════════════════════════════════════════════════════════════════════════
// KAT 8: dc_roll is deterministic — same seed same result
// ═════════════════════════════════════════════════════════════════════════════
let r2 = dc_roll("3d6", 42)
cki("KAT8_determinism", r1, r2)

// ═════════════════════════════════════════════════════════════════════════════
// KAT 9: dc_roll("2d10+5", 100) == 20 (hand-computed)
//        in-range check: [7, 25]
// ═════════════════════════════════════════════════════════════════════════════
let r3 = dc_roll("2d10+5", 100)
cki("KAT9_roll_2d10p5_concrete", r3, 20)
if r3 < 7
    print("FAIL KAT9_range_low: " + str(r3))
    exit(1)
if r3 > 25
    print("FAIL KAT9_range_high: " + str(r3))
    exit(1)

// ═════════════════════════════════════════════════════════════════════════════
// KAT 10: dc_roll("d20", 7) == 11 (hand-computed)
//         in-range check: [1, 20]
// ═════════════════════════════════════════════════════════════════════════════
let r4 = dc_roll("d20", 7)
cki("KAT10_roll_d20_concrete", r4, 11)
if r4 < 1
    print("FAIL KAT10_range_low: " + str(r4))
    exit(1)
if r4 > 20
    print("FAIL KAT10_range_high: " + str(r4))
    exit(1)

// ═════════════════════════════════════════════════════════════════════════════
// KAT 11: dc_min("d20") == 1, dc_max("d20") == 20
// ═════════════════════════════════════════════════════════════════════════════
cki("KAT11_min_d20", dc_min("d20"), 1)
cki("KAT11_max_d20", dc_max("d20"), 20)

// ═════════════════════════════════════════════════════════════════════════════
// KAT 12: different seeds produce different rolls (basic entropy check)
// ═════════════════════════════════════════════════════════════════════════════
let ra = dc_roll("1d100", 1)
let rb = dc_roll("1d100", 99999)
if ra == rb
    print("FAIL KAT12_seed_sensitivity: seeds 1 and 99999 both gave " + str(ra))
    exit(1)

print("_dice_test passed")
