// Typed Result<T,E> / Option<T>: with the new typing, ok/err produce a Sum<T,E>,
// unwrap(Sum<T,E>) yields T (tracked, not erased to `any`), and is_ok/unwrap_or are
// type-aware. This exercises the happy paths end-to-end (codegen still lowers the
// Sum as the NovaResult i64 handle, so behavior is unchanged — only the static
// types got sharper).

fn divide(a, b)
    if b == 0
        return err("division by zero")
    return ok(a / b)

fn main()
    // Result round-trip: ok branch
    let r = divide(10, 2)
    assert_eq(is_ok(r), 1)
    assert_eq(unwrap(r), 5)           // unwrap : Sum<int,str> -> int

    // Result: err branch
    let r2 = divide(5, 0)
    assert_eq(is_ok(r2), 0)
    assert_eq(is_err(r2), 1)
    assert_eq(unwrap_or(r2, -1), -1)  // unwrap_or : (Sum<int,str>, int) -> int

    // unwrap the recovered value
    let r3 = divide(20, 4)
    assert_eq(unwrap_or(r3, 0), 5)

    // Option<T> via some/none
    let o = some(42)
    assert_eq(is_some(o), 1)
    assert_eq(unwrap(o), 42)          // unwrap : Sum<int,unit> -> int

    let n = none()
    assert_eq(is_some(n), 0)
    assert_eq(is_none(n), 1)
    assert_eq(unwrap_or(n, 99), 99)

    // chained: unwrap result feeds further arithmetic (proves T is really int)
    let sum = unwrap(divide(100, 10)) + unwrap_or(divide(8, 2), 0)
    assert_eq(sum, 14)               // 10 + 4

    print("typed_result_test passed")
