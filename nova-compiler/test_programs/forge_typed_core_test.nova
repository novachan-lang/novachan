// forge_typed_core_test -- Phase 1 increment 1: the typed Request/Response core.
// Proves build_request parses a raw HTTP request into a typed Request (parse-once query +
// case-insensitive headers), finalize serializes a Response struct to the wire, and the
// typed JSON builder returns a domain struct as a JSON object (the keystone, end to end).
import forge

type User
    id: int
    name: string
    active: bool

fn main()
    let q = chr(34)

    // build_request: raw HTTP -> typed Request (parse-once)
    let raw = "POST /api/users?tab=active&page=2 HTTP/1.1\r\nHost: example.com\r\nX-Token: abc123\r\nContent-Type: application/json\r\n\r\nhello-body"
    // Typed binding: the idiomatic form (handlers also receive `req: Request` as a typed
    // param). The declared type lets field access resolve per-struct, not via the global
    // name->slot map (which would collide Request.headers with Response.headers).
    let req: Request = forge.build_request(raw, 0)
    assert(req.method == "POST", "method")
    assert(req.path == "/api/users", "clean path (query stripped)")
    assert(req.raw_path == "/api/users?tab=active&page=2", "raw path")
    assert(req.query["tab"] == "active", "query tab")
    assert(req.query["page"] == "2", "query page")
    assert(req.headers["host"] == "example.com", "header lowercased key")
    assert(req.body == "hello-body", "body")
    // case-insensitive header lookup
    assert(forge.req_header(req, "HOST") == "example.com", "req_header case-insensitive")
    assert(forge.req_header(req, "X-Token") == "abc123", "req_header X-Token")
    assert(forge.req_header(req, "missing") == "", "req_header absent -> empty")
    print("PASS: build_request -> typed Request (parse-once, case-insensitive headers)")

    // finalize: Response struct -> wire string
    let resp = forge.resp_text(200, "hi there")
    let wire = forge.finalize(resp)
    assert(find(wire, "HTTP/1.1 200 OK") >= 0, "status line")
    assert(find(wire, "Content-Type: text/plain") >= 0, "content-type")
    assert(find(wire, "Content-Length: 8") >= 0, "content-length")
    assert(ends_with(wire, "hi there"), "body at end")
    print("PASS: finalize(Response) -> wire string")

    // resp_set_header: O(1) header mutation (the typed answer to string surgery)
    let r2 = forge.resp_set_header(forge.resp_text(200, "x"), "X-Custom", "yes")
    assert(find(forge.finalize(r2), "X-Custom: yes") >= 0, "resp_set_header")
    print("PASS: resp_set_header")

    // resp_json: domain struct -> JSON object Response (the keystone)
    let u = User(7, "ada", true)
    let jr = forge.resp_json(200, u)
    let jwire = forge.finalize(jr)
    assert(find(jwire, q + "id" + q + ":7") >= 0, "struct->json id")
    assert(find(jwire, q + "name" + q + ":" + q + "ada" + q) >= 0, "struct->json name")
    assert(find(jwire, q + "active" + q + ":true") >= 0, "struct->json bool")
    assert(find(jwire, "application/json") >= 0, "json content-type")
    print("PASS: resp_json(struct) -> JSON object Response (keystone end-to-end)")
    print("forge_typed_core_test passed")
