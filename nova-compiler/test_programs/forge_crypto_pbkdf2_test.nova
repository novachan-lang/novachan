// Forge crypto: PBKDF2-HMAC-SHA-256, gated against published vectors. RFC 7914's ("passwd","salt",1,64)
// exercises multi-block output; the ("password","salt",2,32) vector exercises the iteration XOR loop.
// Socketless, deterministic, fast (low iteration counts).
import forge_crypto

fn main()
    // RFC 7914: PBKDF2-HMAC-SHA-256("passwd", "salt", c=1, dkLen=64) -- 2 output blocks
    let dk1 = hex_of(pbkdf2_sha256(str_to_blist("passwd"), str_to_blist("salt"), 1, 64))
    if dk1 != "55ac046e56e3089fec1691c22544b605f94185216dde0465e68b9d57c20dacbc49ca9cccf179b645991664b39d77ef317c71b845b1e30bd509112041d3a19783"
        print("FAIL: PBKDF2 c=1 dkLen=64 -> " + dk1)
        exit(1)

    // iteration loop: PBKDF2-HMAC-SHA-256("password", "salt", c=2, dkLen=32)
    let dk2 = hex_of(pbkdf2_sha256(str_to_blist("password"), str_to_blist("salt"), 2, 32))
    if dk2 != "ae4d0c95af6b46d32d0adff928f06dd02a303f8ef3c251dfd6e2d85a95474c43"
        print("FAIL: PBKDF2 c=2 dkLen=32 -> " + dk2)
        exit(1)

    print("PASS forge_crypto_pbkdf2 (RFC 7914 c=1/64 + c=2/32 iteration loop)")
