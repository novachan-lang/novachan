import std/game/sudoku

fn assert_bool(label: string, got: bool, want: bool)
    let gs = "false"
    if got
        gs = "true"
    let ws = "false"
    if want
        ws = "true"
    if gs != ws
        print("FAIL sudoku " + label + ": got " + gs + " want " + ws)
        exit(1)

fn assert_int(label: string, got: int, want: int)
    if got != want
        print("FAIL sudoku " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn _push9(b, a0, a1, a2, a3, a4, a5, a6, a7, a8)
    push(b, a0)
    push(b, a1)
    push(b, a2)
    push(b, a3)
    push(b, a4)
    push(b, a5)
    push(b, a6)
    push(b, a7)
    push(b, a8)

fn main()
    // Build the classic partial puzzle board
    let puzzle = []
    _push9(puzzle, 5,3,0, 0,7,0, 0,0,0)
    _push9(puzzle, 6,0,0, 1,9,5, 0,0,0)
    _push9(puzzle, 0,9,8, 0,0,0, 0,6,0)
    _push9(puzzle, 8,0,0, 0,6,0, 0,0,3)
    _push9(puzzle, 4,0,0, 8,0,3, 0,0,1)
    _push9(puzzle, 7,0,0, 0,2,0, 0,0,6)
    _push9(puzzle, 0,6,0, 0,0,0, 2,8,0)
    _push9(puzzle, 0,0,0, 4,1,9, 0,0,5)
    _push9(puzzle, 0,0,0, 0,8,0, 0,7,9)

    // --- Test 1: solve the puzzle ---
    let sol = sudoku_solve(puzzle)
    let solved = sudoku_is_solved(sol)
    assert_bool("puzzle_solved", solved, true)

    // Check clues preserved
    let agree = true
    let i = 0
    while i < 81
        let orig = puzzle[i]
        if orig != 0
            let sv = sol[i]
            if sv != orig
                agree = false
        i = i + 1
    assert_bool("puzzle_clues_preserved", agree, true)

    // Known solution spot checks: row0=[5,3,4,6,7,8,9,1,2]
    let s00 = sol[0]
    let s01 = sol[1]
    let s02 = sol[2]
    let s04 = sol[4]
    assert_int("sol_0_0", s00, 5)
    assert_int("sol_0_1", s01, 3)
    assert_int("sol_0_2", s02, 4)
    assert_int("sol_0_4", s04, 7)

    // --- Test 2: already-solved board returned unchanged ---
    let already = []
    _push9(already, 5,3,4, 6,7,8, 9,1,2)
    _push9(already, 6,7,2, 1,9,5, 3,4,8)
    _push9(already, 1,9,8, 3,4,2, 5,6,7)
    _push9(already, 8,5,9, 7,6,1, 4,2,3)
    _push9(already, 4,2,6, 8,5,3, 7,9,1)
    _push9(already, 7,1,3, 9,2,4, 8,5,6)
    _push9(already, 9,6,1, 5,3,7, 2,8,4)
    _push9(already, 2,8,7, 4,1,9, 6,3,5)
    _push9(already, 3,4,5, 2,8,6, 1,7,9)
    let sol2 = sudoku_solve(already)
    let solved2 = sudoku_is_solved(sol2)
    assert_bool("already_solved", solved2, true)

    // --- Test 3: partial board is not solved ---
    let partial_solved = sudoku_is_solved(puzzle)
    assert_bool("partial_not_solved", partial_solved, false)

    print("PASS _sudoku_test")
