// _compound_interest_test.nova — KAT for std/finance/compound_interest
//
// Known answers:
//   compound(1000.0, 0.05, 1.0, 1)      = 1000*(1+0.05)^1         = 1050.0
//   compound(1000.0, 0.05, 1.0, 12)     = 1000*(1+0.05/12)^12     ~ 1051.16
//   effective_rate(0.10, 2)             = (1+0.05)^2 - 1           = 0.1025
//   effective_rate(0.12, 12)            = (1+0.01)^12 - 1          ~ 0.12682
//   rule_of_72(0.08)                    = 72 / 8                   = 9.0
//   rule_of_72(0.06)                    = 72 / 6                   = 12.0
//   continuous_compound(1000.0,0.05,1)  = 1000*e^0.05              ~ 1051.27

import std/finance/compound_interest

fn approx(a: float, b: float, tol: float) -> int
    let d = a - b
    let ad = d
    if d < 0.0
        ad = 0.0 - d
    if ad < tol
        return 1
    return 0

fn main()
    // KAT 1: compound annual — 1000*(1.05)^1 = 1050.0
    let v1 = compound(1000.0, 0.05, 1.0, 1.0)
    if not approx(v1, 1050.0, 0.01)
        print("FAIL compound_interest compound_annual: got " + str(v1))
        exit(1)

    // KAT 2: compound monthly — 1000*(1+0.05/12)^12 ~ 1051.16
    let v2 = compound(1000.0, 0.05, 1.0, 12.0)
    if not approx(v2, 1051.16, 0.1)
        print("FAIL compound_interest compound_monthly: got " + str(v2))
        exit(1)

    // KAT 3: effective_rate semi-annual — (1.05)^2 - 1 = 0.1025
    let v3 = effective_rate(0.10, 2.0)
    if not approx(v3, 0.1025, 0.0001)
        print("FAIL compound_interest effective_rate_semi: got " + str(v3))
        exit(1)

    // KAT 4: effective_rate monthly — (1.01)^12 - 1 ~ 0.12682
    let v4 = effective_rate(0.12, 12.0)
    if not approx(v4, 0.12682, 0.0001)
        print("FAIL compound_interest effective_rate_monthly: got " + str(v4))
        exit(1)

    // KAT 5: rule_of_72 at 8% — 72/8 = 9.0
    let v5 = rule_of_72(0.08)
    if not approx(v5, 9.0, 0.01)
        print("FAIL compound_interest rule_of_72_8pct: got " + str(v5))
        exit(1)

    // KAT 6: rule_of_72 at 6% — 72/6 = 12.0
    let v6 = rule_of_72(0.06)
    if not approx(v6, 12.0, 0.01)
        print("FAIL compound_interest rule_of_72_6pct: got " + str(v6))
        exit(1)

    // KAT 7: continuous_compound — 1000*e^0.05 ~ 1051.271
    let v7 = continuous_compound(1000.0, 0.05, 1.0)
    if not approx(v7, 1051.27, 0.1)
        print("FAIL compound_interest continuous_compound: got " + str(v7))
        exit(1)

    print("PASS _compound_interest_test")
