fn add_zero(x: int) -> int
    x + 0

fn zero_add(x: int) -> int
    0 + x

fn sub_zero(x: int) -> int
    x - 0

fn mul_one(x: int) -> int
    x * 1

fn one_mul(x: int) -> int
    1 * x

fn mul_zero(x: int) -> int
    x * 0

fn zero_mul(x: int) -> int
    0 * x

assert(add_zero(42) == 42, "x + 0 == x")
assert(zero_add(42) == 42, "0 + x == x")
assert(sub_zero(42) == 42, "x - 0 == x")
assert(mul_one(42) == 42, "x * 1 == x")
assert(one_mul(42) == 42, "1 * x == x")
assert(mul_zero(42) == 0, "x * 0 == 0")
assert(zero_mul(42) == 0, "0 * x == 0")

assert(add_zero(-7) == -7, "negative x + 0")
assert(mul_one(-7) == -7, "negative x * 1")
assert(mul_zero(999) == 0, "large x * 0")

fn compound(a: int, b: int) -> int
    let x = a * 1 + 0
    let y = 0 + b * 1
    x + y

assert(compound(10, 20) == 30, "compound strength reductions")

print("all strength reduction tests passed")
