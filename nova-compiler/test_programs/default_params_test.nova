// Default parameter values test

fn greet(name, greeting = "Hello")
    return greeting + " " + name

assert(greet("world") == "Hello world", "default greeting")
assert(greet("NOVA", "Welcome") == "Welcome NOVA", "custom greeting")

fn connect(host, port = 8080, timeout = 5000)
    return host + ":" + str(port) + ":" + str(timeout)

assert(connect("localhost") == "localhost:8080:5000", "all defaults")
assert(connect("localhost", 3000) == "localhost:3000:5000", "custom port")
assert(connect("localhost", 3000, 10000) == "localhost:3000:10000", "all custom")

fn power(base, exp = 2)
    result = 1
    i = 0
    while i < exp
        result = result * base
        i = i + 1
    return result

assert(power(5) == 25, "default square")
assert(power(2, 10) == 1024, "custom exponent")

print("DEFAULT PARAMS: ALL PASSED")
