fn greet(name, greeting = "Hello")
    print(greeting + " " + name)

greet("Alice")
greet("Bob", "Hi")

fn add(a, b = 0, c = 0)
    a + b + c

print(add(10))
print(add(10, 20))
print(add(10, 20, 30))

fn create_range(start, end, step = 1)
    let result = []
    let i = start
    while i < end
        push(result, i)
        i = i + step
    result

r1 = create_range(0, 5)
print(r1)
r2 = create_range(0, 10, 2)
print(r2)
