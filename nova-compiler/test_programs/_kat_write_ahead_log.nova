import forge_write_ahead_log

fn main()
    let w = wal_new()
    w = wal_append(w, "SET", "name", "alice")
    w = wal_append(w, "SET", "age", "30")
    w = wal_append(w, "DEL", "temp", "")
    assert(wal_count(w) == 3, "3 entries")
    assert(wal_uncommitted_count(w) == 3, "3 uncommitted")

    let r1 = wal_commit(w, 0)
    assert(is_ok(r1), "commit 0 ok")
    w = unwrap(r1)
    assert(wal_committed_count(w) == 1, "1 committed")
    assert(wal_is_committed(w, 0) == 1, "entry 0 committed")
    assert(wal_is_committed(w, 1) == 0, "entry 1 not")

    let r2 = wal_get(w, 0)
    assert(is_ok(r2), "get 0 ok")
    assert(unwrap(r2) == "SET:name=alice", "entry 0 content")

    let bad = wal_get(w, 99)
    assert(is_err(bad), "out of range")

    print("WRITE-AHEAD-LOG KAT PASS")
