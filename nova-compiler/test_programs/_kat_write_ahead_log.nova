import forge_write_ahead_log

fn main()
    let wal = wal_new()
    wal = wal_append(wal, "INSERT", "user:alice")
    wal = wal_append(wal, "UPDATE", "user:alice:email")
    wal = wal_append(wal, "INSERT", "user:bob")
    assert(wal_entry_count(wal) == 3, "3 entries")
    assert(wal_current_seq(wal) == 3, "seq at 3")

    wal = wal_checkpoint(wal)
    assert(wal_checkpoint_seq(wal) == 3, "checkpoint at 3")

    wal = wal_append(wal, "DELETE", "user:bob")
    wal = wal_append(wal, "INSERT", "user:charlie")

    let replay = wal_replay_since_checkpoint(wal)
    assert(len(replay) == 2, "2 after checkpoint")
    assert(replay[0]["op"] == "DELETE", "first replay = delete")

    let from1 = wal_replay_from(wal, 1)
    assert(len(from1) == 4, "4 after seq 1")

    wal = wal_truncate_before(wal, 3)
    assert(wal_entry_count(wal) == 3, "3 after truncate")

    print("WRITE-AHEAD-LOG KAT PASS")
