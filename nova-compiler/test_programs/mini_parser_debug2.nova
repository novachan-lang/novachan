type Token
    kind: string
    value: string

type Expr
    tag: string
    num_val: int
    op: string
    children: list

fn make_num(n: int) -> Expr
    Expr("num", n, "", [])

fn make_binop(op: string, left: Expr, right: Expr) -> Expr
    Expr("binop", 0, op, [left, right])

fn tokenize(input: string) -> list
    let tokens = []
    let i = 0
    let current = ""
    while i < len(input)
        let ch = input[i]
        if ch == " "
            if len(current) > 0
                push(tokens, Token("num", current))
                current = ""
        else if ch == "+" or ch == "-" or ch == "*"
            if len(current) > 0
                push(tokens, Token("num", current))
                current = ""
            push(tokens, Token("op", ch))
        else
            current = current + ch
        i = i + 1
    if len(current) > 0
        push(tokens, Token("num", current))
    tokens

fn eval(e: Expr) -> int
    match e
        Expr(tag, num_val, op, children) =>
            if tag == "num"
                num_val
            else
                let l = eval(children[0])
                let r = eval(children[1])
                if op == "+"
                    l + r
                else if op == "-"
                    l - r
                else
                    l * r

fn test()
    let tokens = tokenize("3 + 4")
    print("tokens: " + str(len(tokens)))

    let t0_val = match tokens[0]
        Token(kind, value) => value
    print("t0: " + t0_val)

    let left = make_num(int(t0_val))
    print("left created")

    let op_str = match tokens[1]
        Token(kind, value) => value
    print("op: " + op_str)

    let t2_val = match tokens[2]
        Token(kind, value) => value
    print("t2: " + t2_val)

    let right = make_num(int(t2_val))
    let expr = make_binop(op_str, left, right)
    print("expr created")

    let result = eval(expr)
    print("result: " + str(result))

test()
