import forge_raster

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn pts_str(pp) -> string
    let parts = []
    let i = 0
    while i < len(pp)
        push(parts, str(pp[i][0]) + str(pp[i][1]))
        i = i + 1
    join(parts, ",")

fn main()
    let fails = 0

    // diagonal line
    fails = fails + expect("diag", pts_str(line(0, 0, 3, 3)), "00,11,22,33")
    // horizontal
    fails = fails + expect("horiz", pts_str(line(0, 0, 4, 0)), "00,10,20,30,40")
    // vertical
    fails = fails + expect("vert", pts_str(line(2, 0, 2, 3)), "20,21,22,23")
    // reversed direction still connects endpoints
    let rl = line(5, 5, 0, 0)
    fails = fails + expect_true("rev_endpoints", rl[0][0] == 5 and rl[0][1] == 5 and rl[len(rl) - 1][0] == 0 and rl[len(rl) - 1][1] == 0)
    // shallow slope line: (0,0)->(6,2)
    fails = fails + expect("shallow", pts_str(line(0, 0, 6, 2)), "00,10,21,31,41,52,62")
    // single point
    fails = fails + expect("point", pts_str(line(3, 3, 3, 3)), "33")

    // circle: every pixel is at radius ~r (r^2 within +/- r of x^2+y^2)
    let c = circle(0, 0, 5)
    let all_on = true
    let i = 0
    while i < len(c)
        let dx = c[i][0]
        let dy = c[i][1]
        let d2 = dx * dx + dy * dy
        // midpoint circle keeps pixels within ~1 of the true radius: 16 <= d2 <= 36 for r=5
        if d2 < 16 or d2 > 36
            all_on = false
        i = i + 1
    fails = fails + expect_true("circle_radius", all_on)
    // circle includes the 4 axis extremes
    fails = fails + expect_true("circle_nonempty", len(c) > 0)
    // r=0 -> a single center-ish pixel set
    let c0 = circle(0, 0, 0)
    fails = fails + expect_true("circle_r0", len(c0) > 0)

    // rectangle outline of a 3x3 box has 8 border cells (perimeter), corners once
    let rc = rect(0, 0, 2, 2)
    fails = fails + expect("rect_count", str(len(rc)), "8")

    if fails == 0
        print("forge_raster: all passed")
    else
        print("forge_raster: " + str(fails) + " FAILED")
