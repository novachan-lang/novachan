fn hash_password(password, salt)
  sha256(salt + password + salt)

fn verify_password(password, salt, hashed)
  hash_password(password, salt) == hashed

fn generate_token(length)
  let chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
  let out = ""
  let i = 0
  while i < length
    let idx = random_int(0, 61)
    out = out + slice(chars, idx, idx + 1)
    i = i + 1
  out

fn create_session(user_id)
  let session = {}
  session["user_id"] = user_id
  session["token"] = generate_token(32)
  session["created_at"] = time_ms()
  session["expires_at"] = time_ms() + 3600000
  session

fn session_valid(session)
  time_ms() < session["expires_at"]

fn session_refresh(session, ttl_ms)
  session["expires_at"] = time_ms() + ttl_ms

fn basic_auth_encode(username, password)
  base64_encode(username + ":" + password)

fn basic_auth_decode(encoded)
  let decoded = base64_decode(encoded)
  let colon = -1
  let i = 0
  while i < len(decoded)
    if slice(decoded, i, i + 1) == ":"
      colon = i
      i = len(decoded)
    i = i + 1
  if colon < 0
    return err("invalid basic auth")
  let user = slice(decoded, 0, colon)
  let pass = slice(decoded, colon + 1, len(decoded))
  ok([user, pass])

fn main()
  let salt = "random_salt_123"
  let hashed = hash_password("mypassword", salt)
  assert(len(hashed) > 0, "hash non-empty")
  assert(verify_password("mypassword", salt, hashed) == 1, "verify correct")
  assert(verify_password("wrongpassword", salt, hashed) == 0, "verify wrong")
  assert(hash_password("mypassword", salt) == hashed, "deterministic")

  let tok = generate_token(16)
  assert(len(tok) == 16, "token length")
  let tok2 = generate_token(16)
  assert(tok != tok2, "tokens differ (probabilistic)")

  let session = create_session("user42")
  assert(session["user_id"] == "user42", "session user")
  assert(len(session["token"]) == 32, "session token len")
  assert(session_valid(session) == 1, "session valid")

  let encoded = basic_auth_encode("admin", "secret")
  let decoded = basic_auth_decode(encoded)
  assert(is_ok(decoded), "decode ok")
  let creds = unwrap(decoded)
  assert(creds[0] == "admin", "decoded user")
  assert(creds[1] == "secret", "decoded pass")

  let bad = basic_auth_decode(base64_encode("nocolon"))
  assert(is_err(bad), "no colon = err")

  print("authx: all passed")
