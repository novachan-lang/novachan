// _normaldist_test.nova — KAT for std/math/normaldist
// Known-answer values hand-computed from standard tables (epsilon = 0.001).
import std/math/normaldist

fn ckf(name: string, got: float, want: float)
    let diff = got - want
    if diff < 0.0
        diff = 0.0 - diff
    if diff >= 0.001
        print("FAIL " + name + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // nd_standard_cdf(0.0) = 0.5
    let v1 = nd_standard_cdf(0.0)
    ckf("nd_standard_cdf(0)", v1, 0.5)

    // nd_standard_cdf(1.0) ~ 0.8413
    let v2 = nd_standard_cdf(1.0)
    ckf("nd_standard_cdf(1)", v2, 0.8413)

    // nd_standard_cdf(-1.0) ~ 0.1587
    let v3 = nd_standard_cdf(-1.0)
    ckf("nd_standard_cdf(-1)", v3, 0.1587)

    // nd_standard_cdf(1.96) ~ 0.975
    let v4 = nd_standard_cdf(1.96)
    ckf("nd_standard_cdf(1.96)", v4, 0.975)

    // nd_pdf_standard(0.0) = 1/sqrt(2*pi) ~ 0.3989
    let v5 = nd_pdf_standard(0.0)
    ckf("nd_pdf_standard(0)", v5, 0.3989)

    // nd_cdf(5.0, 5.0, 2.0) = 0.5  (x == mean => exactly 0.5)
    let v6 = nd_cdf(5.0, 5.0, 2.0)
    ckf("nd_cdf(5,5,2)", v6, 0.5)

    // nd_pdf(0.0, 0.0, 1.0) = nd_pdf_standard(0) ~ 0.3989
    let v7 = nd_pdf(0.0, 0.0, 1.0)
    ckf("nd_pdf(0,0,1)", v7, 0.3989)

    print("_normaldist_test passed")
