// Forge S10: in-process message broker. Named FIFO queues + work-sharing (each message to ONE consumer).
// Socketless (actor + channels), deterministic, kill-on-timeout.
import forge_mq

fn main()
    let b = mq_broker()

    // (1) named FIFO queue: publish a,b,c -> consume in order
    mq_publish(b, "jobs", "a")
    mq_publish(b, "jobs", "b")
    mq_publish(b, "jobs", "c")
    let c = mq_consumer(b, "jobs")
    if mq_pull(c) != "a" or mq_pull(c) != "b" or mq_pull(c) != "c"
        print("FAIL: named queue should deliver FIFO")
        exit(1)

    // (2) separate queues are independent
    mq_publish(b, "other", "z")
    if mq_pull(mq_consumer(b, "other")) != "z"
        print("FAIL: queues must be independent by name")
        exit(1)

    // (3) work-sharing: two consumers on one queue split the messages (each delivered exactly once)
    mq_publish(b, "work", "x")
    mq_publish(b, "work", "y")
    let ca = mq_consumer(b, "work")
    let cb = mq_consumer(b, "work")
    let ra = mq_pull(ca)
    let rb = mq_pull(cb)
    let shared_ok = (ra == "x" and rb == "y") or (ra == "y" and rb == "x")
    if shared_ok == false
        print("FAIL: work-sharing should split messages once each; ra=" + str(ra) + " rb=" + str(rb))
        exit(1)

    mq_stop(b)
    print("PASS forge_mq (named FIFO queues, independent by name, work-shared across consumers)")
