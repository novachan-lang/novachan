// Test: NOVA distributed computing — serialization round-trip
fn main()
    // Test 1: integer round-trip
    let a = 42
    let sa = serialize(a)
    let da = deserialize(sa)
    assert(da == 42, "int round-trip failed")
    print("int: {da}")

    // Test 2: string round-trip
    let s = "hello distributed NOVA"
    let ss = serialize(s)
    let ds = deserialize(ss)
    assert(ds == "hello distributed NOVA", "string round-trip failed")
    print("string: {ds}")

    // Test 3: list round-trip
    let lst = [10, 20, 30, 40, 50]
    let sl = serialize(lst)
    let dl = deserialize(sl)
    assert(len(dl) == 5, "list length mismatch")
    print("list: {dl}")

    // Test 4: dict with string values round-trip
    let d = {}
    d["name"] = "NOVA"
    d["version"] = "1.0"
    d["lang"] = "universal"
    let sd = serialize(d)
    let dd = deserialize(sd)
    print("dict name: {dd["name"]}")
    print("dict version: {dd["version"]}")

    // Test 5: nested list round-trip
    let nested = [[1, 2], [3, 4], [5, 6]]
    let sn = serialize(nested)
    let dn = deserialize(sn)
    print("nested list: {dn}")

    // Test 6: hex debug output
    let hex = bytes_to_hex(serialize(42))
    print("hex(42): {hex}")
    let hex2 = bytes_to_hex(serialize("hello"))
    print("hex(hello): {hex2}")

    // Test 7: zero/empty edge cases
    let z = serialize(0)
    let dz = deserialize(z)
    assert(dz == 0, "zero round-trip failed")
    print("zero: {dz}")

    let empty_list = [0]
    let se = serialize(empty_list)
    let de = deserialize(se)
    print("single-element list: {de}")

    // Test 8: large list
    let big = range(100)
    let sb = serialize(big)
    let db = deserialize(sb)
    assert(len(db) == 100, "large list round-trip failed")
    print("large list len: {len(db)}")

    print("all serialization tests passed")

main()
