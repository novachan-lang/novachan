import std/gametheory/matrix_game

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _matrix_game_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL _matrix_game_test " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn ckl(label: string, got: list, want: list)
    let ng = len(got)
    let nw = len(want)
    if ng != nw
        print("FAIL _matrix_game_test " + label + " len: got=" + str(ng) + " want=" + str(nw))
        exit(1)
    let i = 0
    while i < ng
        if got[i] != want[i]
            print("FAIL _matrix_game_test " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // Build m = [[3,2,5],[2,1,8],[5,4,6]]
    let m = []
    let r0 = []
    push(r0, 3)
    push(r0, 2)
    push(r0, 5)
    let r1 = []
    push(r1, 2)
    push(r1, 1)
    push(r1, 8)
    let r2 = []
    push(r2, 5)
    push(r2, 4)
    push(r2, 6)
    push(m, r0)
    push(m, r1)
    push(m, r2)

    // KAT: mg_row_mins(m) = [2,1,4]
    let rm = mg_row_mins(m)
    let rm_want = []
    push(rm_want, 2)
    push(rm_want, 1)
    push(rm_want, 4)
    ckl("row_mins", rm, rm_want)

    // KAT: mg_col_maxs(m) = [5,4,8]
    let cm = mg_col_maxs(m)
    let cm_want = []
    push(cm_want, 5)
    push(cm_want, 4)
    push(cm_want, 8)
    ckl("col_maxs", cm, cm_want)

    // KAT: mg_maximin(m) = 4
    cki("maximin", mg_maximin(m), 4)

    // KAT: mg_minimax(m) = 4
    cki("minimax", mg_minimax(m), 4)

    // KAT: mg_has_saddle(m) = true
    ckb("has_saddle", mg_has_saddle(m), true)

    // KAT: mg_saddle_value(m) = 4
    cki("saddle_value", mg_saddle_value(m), 4)

    // KAT: mg_maximin([[1,2],[3,4]]) = 3
    let m2 = []
    let m2r0 = []
    push(m2r0, 1)
    push(m2r0, 2)
    let m2r1 = []
    push(m2r1, 3)
    push(m2r1, 4)
    push(m2, m2r0)
    push(m2, m2r1)
    cki("maximin [[1,2],[3,4]]", mg_maximin(m2), 3)

    // KAT: mg_has_saddle([[1,2],[3,4]]) = true
    // col_maxs = [3,4], minimax=3; maximin=3 -> saddle exists
    ckb("has_saddle [[1,2],[3,4]]", mg_has_saddle(m2), true)

    // No-saddle matrix: [[0,3],[3,0]] -> row_mins=[0,0] maximin=0; col_maxs=[3,3] minimax=3 -> no saddle
    let m3 = []
    let m3r0 = []
    push(m3r0, 0)
    push(m3r0, 3)
    let m3r1 = []
    push(m3r1, 3)
    push(m3r1, 0)
    push(m3, m3r0)
    push(m3, m3r1)
    ckb("has_saddle [[0,3],[3,0]]", mg_has_saddle(m3), false)
    cki("maximin [[0,3],[3,0]]", mg_maximin(m3), 0)
    cki("minimax [[0,3],[3,0]]", mg_minimax(m3), 3)
    cki("saddle_value no-saddle returns maximin", mg_saddle_value(m3), 0)

    // 1x1 matrix: [[7]] -> trivially a saddle at 7
    let m4 = []
    let m4r0 = []
    push(m4r0, 7)
    push(m4, m4r0)
    cki("maximin [[7]]", mg_maximin(m4), 7)
    cki("minimax [[7]]", mg_minimax(m4), 7)
    ckb("has_saddle [[7]]", mg_has_saddle(m4), true)
    cki("saddle_value [[7]]", mg_saddle_value(m4), 7)

    print("PASS _matrix_game_test")
