import forge_failover_manager

fn main()
    let f = fm_new()
    assert(fm_service_count(f) == 0, "0 services initially")
    assert(fm_failover_count(f) == 0, "0 failovers initially")

    f = fm_add_primary(f, "api", "10.0.0.1:8080")
    f = fm_add_secondary(f, "api", "10.0.0.2:8080")
    assert(fm_service_count(f) == 1, "1 service")

    let active0 = fm_active_endpoint(f, "api")
    assert(is_ok(active0), "active endpoint ok")
    assert(unwrap(active0) == "10.0.0.1:8080", "primary is active")
    assert(fm_is_failed_over(f, "api") == 0, "not failed over yet")

    let hc_bad_unknown = fm_health_check(f, "unknown-service", 0)
    assert(is_err(hc_bad_unknown), "health check on unknown service fails")

    let hc1 = fm_health_check(f, "api", 1)
    assert(is_ok(hc1), "healthy report ok")
    assert(fm_is_failed_over(f, "api") == 0, "still on primary")

    let hc2 = fm_health_check(f, "api", 0)
    assert(is_ok(hc2), "unhealthy report ok")
    assert(fm_is_failed_over(f, "api") == 1, "failed over now")
    assert(fm_failover_count(f) == 1, "1 failover recorded")

    let active1 = fm_active_endpoint(f, "api")
    assert(is_ok(active1), "active endpoint after failover ok")
    assert(unwrap(active1) == "10.0.0.2:8080", "secondary is active")

    // a second unhealthy report should not double-count the failover
    let hc3 = fm_health_check(f, "api", 0)
    assert(is_ok(hc3), "repeat unhealthy report ok")
    assert(fm_failover_count(f) == 1, "still 1 failover")

    let restore1 = fm_restore(f, "api")
    assert(is_ok(restore1), "restore ok")
    assert(fm_is_failed_over(f, "api") == 0, "restored to primary")

    let active2 = fm_active_endpoint(f, "api")
    assert(is_ok(active2), "active endpoint after restore ok")
    assert(unwrap(active2) == "10.0.0.1:8080", "primary active again")

    let restore2 = fm_restore(f, "api")
    assert(is_err(restore2), "restore when not failed over fails")

    // service with no secondary: unhealthy report cannot fail over
    f = fm_add_primary(f, "db", "10.0.0.5:5432")
    assert(fm_service_count(f) == 2, "2 services")
    let hc_no_secondary = fm_health_check(f, "db", 0)
    assert(is_err(hc_no_secondary), "no secondary available fails")

    print("FAILOVER-MANAGER KAT PASS")
