import forge_health_checker

fn main()
    let h = hc_new()
    h = hc_add_check(h, "db", "tcp")
    h = hc_add_check(h, "cache", "tcp")
    assert(hc_check_count(h) == 2, "2 checks")
    assert(hc_status(h) == "unknown", "unknown before runs")

    let r1 = hc_run_check(h, "db", 1)
    assert(is_ok(r1), "run db ok")
    h = unwrap(r1)
    assert(hc_status(h) == "healthy", "healthy after pass")

    let r2 = hc_run_check(h, "cache", 0)
    assert(is_ok(r2), "run cache ok")
    h = unwrap(r2)
    assert(hc_status(h) == "unhealthy", "unhealthy after fail")
    assert(hc_is_healthy(h) == 0, "not healthy")

    let r3 = hc_last_failed(h)
    assert(is_ok(r3), "has last failed")
    assert(unwrap(r3) == "cache", "cache failed")

    assert(hc_pass_rate(h) == 50, "50% pass rate")

    let bad = hc_run_check(h, "nope", 1)
    assert(is_err(bad), "unknown check err")

    print("HEALTH-CHECKER KAT PASS")
