// KAT: std/data/sub_srt_build
import std/data/sub_srt_build
import std/data/sub_srt_parse

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=[" + got + "] want=[" + want + "]")
        exit(1)

let lf = chr(10)

// ── Spec: single cue build ────────────────────────────────────────────────────
let cue1 = {}
cue1["index"] = 1
cue1["start"] = 1000
cue1["end"] = 4000
cue1["text"] = "Hello"

let expected1 = "1" + lf + "00:00:01,000 --> 00:00:04,000" + lf + "Hello" + lf + lf
let built1 = srt_build_cue(cue1)
cks("build_cue_spec", built1, expected1)

// ── Build a list of one cue ───────────────────────────────────────────────────
let cues_one = []
cues_one.push(cue1)
let doc1 = srt_build(cues_one)
cks("build_doc_one", doc1, expected1)

// ── Round-trip: build -> parse recovers cue ───────────────────────────────────
let rt_cues = srt_parse(doc1)
cki("rt_count",   len(rt_cues),       1)
cki("rt_index",   rt_cues[0]["index"], 1)
cki("rt_start",   rt_cues[0]["start"], 1000)
cki("rt_end",     rt_cues[0]["end"],   4000)
cks("rt_text",    rt_cues[0]["text"],  "Hello")

// ── Two-cue build ─────────────────────────────────────────────────────────────
let cue2 = {}
cue2["index"] = 2
cue2["start"] = 5000
cue2["end"] = 8000
cue2["text"] = "World"
let cues_two = []
cues_two.push(cue1)
cues_two.push(cue2)
let doc2 = srt_build(cues_two)
// Parse it back
let rt2 = srt_parse(doc2)
cki("rt2_count",  len(rt2),            2)
cki("rt2_0_idx",  rt2[0]["index"],     1)
cks("rt2_0_txt",  rt2[0]["text"],      "Hello")
cki("rt2_1_idx",  rt2[1]["index"],     2)
cks("rt2_1_txt",  rt2[1]["text"],      "World")
cki("rt2_1_s",    rt2[1]["start"],     5000)
cki("rt2_1_e",    rt2[1]["end"],       8000)

// ── Timing accuracy: 01:02:03,456 --> 02:03:04,567 ───────────────────────────
let cue3 = {}
cue3["index"] = 3
cue3["start"] = 3723456
cue3["end"] = 7384567
cue3["text"] = "Timing test"
let built3 = srt_build_cue(cue3)
let expected3 = "3" + lf + "01:02:03,456 --> 02:03:04,567" + lf + "Timing test" + lf + lf
cks("timing_block", built3, expected3)

// ── Multi-line text round-trip ────────────────────────────────────────────────
let cue_ml = {}
cue_ml["index"] = 1
cue_ml["start"] = 0
cue_ml["end"] = 3000
cue_ml["text"] = "Line one" + lf + "Line two"
let doc_ml = srt_build_cue(cue_ml)
let rt_ml = srt_parse(doc_ml)
cki("ml_rt_count", len(rt_ml), 1)
cks("ml_rt_text",  rt_ml[0]["text"], "Line one" + lf + "Line two")

// ── Empty cue list -> empty string ────────────────────────────────────────────
let empty_list = []
let doc_empty = srt_build(empty_list)
cks("build_empty", doc_empty, "")

print("PASS _sub_srt_build_test")
