// Iterator performance benchmark: sum a list many times
fn make_list(n)
    let lst = []
    let i = 0
    while i < n
        lst.push(i)
        i = i + 1
    lst

fn sum_list(lst)
    let total = 0
    for x in lst
        total = total + x
    total

let big = make_list(10000)
let result = 0
let i = 0
while i < 100
    result = sum_list(big)
    i = i + 1
print(result)
