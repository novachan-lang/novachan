// Worst case: the list escapes to a helper -> S4 floatlist detection is dropped (taint) ->
// reads go through the generic boxed path (nova_rt_index_get). This is the "cliff" scenario.
fn touch(ys)
    return len(ys)
fn main()
    let n = 2000000
    let xs = []
    let i = 0
    while i < n
        push(xs, i * 1.5)
        i = i + 1
    let _ = touch(xs)   // escape -> taint -> boxed reads
    let reps = 50
    let t0 = time_ms()
    let total = 0.0
    let r = 0
    while r < reps
        let s = 0.0
        let j = 0
        while j < n
            s = s + xs[j]
            j = j + 1
        total = total + s
        r = r + 1
    let t1 = time_ms()
    print("BENCH fa_sum_boxed elapsed_ms=" + str(t1 - t0))
    print(total)
