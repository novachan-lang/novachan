import forge_circuit_breaker_pool

fn main()
    let c = cbp_new(3)
    c = cbp_add(c, "db")
    c = cbp_add(c, "api")
    assert(cbp_breaker_count(c) == 2, "2 breakers")

    let r1 = cbp_call(c, "db", 1)
    assert(is_ok(r1), "success ok")
    c = unwrap(r1)

    let r2 = cbp_call(c, "db", 0)
    c = unwrap(r2)
    let r3 = cbp_call(c, "db", 0)
    c = unwrap(r3)
    let r4 = cbp_call(c, "db", 0)
    c = unwrap(r4)

    let st = cbp_state(c, "db")
    assert(unwrap(st) == "open", "db tripped")
    assert(cbp_total_trips(c) == 1, "1 trip")

    let r5 = cbp_call(c, "db", 1)
    assert(is_err(r5), "circuit open")

    let rs = cbp_reset(c, "db")
    assert(is_ok(rs), "reset ok")
    c = unwrap(rs)
    let st2 = cbp_state(c, "db")
    assert(unwrap(st2) == "closed", "db reset")

    assert(cbp_total_calls(c) == 4, "4 calls")

    let bad = cbp_call(c, "nope", 1)
    assert(is_err(bad), "not found")

    print("CIRCUIT-BREAKER-POOL KAT PASS")
