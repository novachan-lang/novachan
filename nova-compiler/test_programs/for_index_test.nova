fn main()
    let items = ["a", "b", "c", "d"]
    let indices = []
    let values = []
    for i, val in items
        push(indices, i)
        push(values, val)
    assert_eq(indices, [0, 1, 2, 3])
    assert_eq(values, ["a", "b", "c", "d"])
    print("for i,val basic: " + str(indices) + " " + str(values))

    let nums = [10, 20, 30]
    let sum = 0
    for idx, n in nums
        sum = sum + idx * n
    assert_eq(sum, 0 * 10 + 1 * 20 + 2 * 30)
    print("for i,val weighted sum: " + str(sum))

    let found_idx = -1
    for i, x in [5, 10, 15, 20]
        if x == 15
            found_idx = i
            break
    assert_eq(found_idx, 2)
    print("for i,val find: idx " + str(found_idx))

    let evens = []
    for i, v in [1, 2, 3, 4, 5, 6] if v % 2 == 0
        push(evens, str(i) + ":" + str(v))
    assert_eq(evens, ["1:2", "3:4", "5:6"])
    print("for i,val with guard: " + str(evens))

    let empty_ran = false
    for i, v in []
        empty_ran = true
    assert_eq(empty_ran, false)
    print("for i,val empty: skipped")

    let old_style = []
    for (i, x) in enumerate([100, 200])
        push(old_style, str(i) + "=" + str(x))
    assert_eq(old_style, ["0=100", "1=200"])
    print("old enumerate style still works: " + str(old_style))

    print("ALL FOR-INDEX TESTS PASSED")
