import forge_circuit_panel

fn main()
    let c = cpanel_new()
    c = cpanel_add_circuit(c, "db", 3)
    c = cpanel_add_circuit(c, "api", 2)
    assert(cpanel_circuit_count(c) == 2, "2 circuits")

    let s1 = cpanel_record_success(c, "db")
    assert(is_ok(s1), "success ok")
    c = unwrap(s1)

    let st = cpanel_state(c, "db")
    assert(unwrap(st) == "closed", "closed")

    let f1 = cpanel_record_failure(c, "api")
    c = unwrap(f1)
    let f2 = cpanel_record_failure(c, "api")
    c = unwrap(f2)
    let st2 = cpanel_state(c, "api")
    assert(unwrap(st2) == "open", "api tripped")
    assert(cpanel_total_trips(c) == 1, "1 trip")

    let fl = cpanel_failures(c, "api")
    assert(unwrap(fl) == 2, "2 failures")

    let rs = cpanel_record_success(c, "api")
    c = unwrap(rs)
    let st3 = cpanel_state(c, "api")
    assert(unwrap(st3) == "closed", "api recovered")

    let bad = cpanel_state(c, "nope")
    assert(is_err(bad), "not found")

    print("CIRCUIT-PANEL KAT PASS")
