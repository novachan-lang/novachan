import forge_topk

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn join_ints(lst) -> string
    let parts = []
    let i = 0
    while i < len(lst)
        push(parts, str(lst[i]))
        i = i + 1
    join(parts, ",")

fn main()
    let fails = 0

    // top-3 from a stream
    let t = topk_new(3)
    topk_add(t, 5, "e")
    topk_add(t, 1, "a")
    topk_add(t, 9, "i")
    topk_add(t, 3, "c")
    topk_add(t, 7, "g")
    topk_add(t, 2, "b")
    fails = fails + expect("items", join(topk_items(t), ","), "i,g,e")
    fails = fails + expect("scores", join_ints(topk_scores(t)), "9,7,5")
    fails = fails + expect("size", str(topk_size(t)), "3")
    fails = fails + expect("threshold", str(topk_threshold(t)), "5")

    // below threshold -> ignored
    topk_add(t, 4, "d")
    fails = fails + expect("below_ignored", join(topk_items(t), ","), "i,g,e")
    fails = fails + expect("size_stable", str(topk_size(t)), "3")

    // above threshold -> displaces the min
    topk_add(t, 8, "h")
    fails = fails + expect("above_admits", join(topk_items(t), ","), "i,h,g")
    fails = fails + expect("new_threshold", str(topk_threshold(t)), "7")

    // fewer than k items retained
    let u = topk_new(5)
    topk_add(u, 10, "x")
    topk_add(u, 20, "y")
    fails = fails + expect("partial", join(topk_items(u), ","), "y,x")
    fails = fails + expect("partial_size", str(topk_size(u)), "2")

    // empty threshold -> null
    let v = topk_new(3)
    fails = fails + expect_true("empty_thresh", topk_threshold(v) == null)

    // tie keeps the earlier item
    let w = topk_new(2)
    topk_add(w, 5, "a")
    topk_add(w, 5, "b")
    topk_add(w, 5, "c")
    fails = fails + expect("tie_keep_earlier", join(topk_items(w), ","), "a,b")

    // entries carry [score,item]
    let ents = topk_entries(t)
    fails = fails + expect("entry0", str(ents[0][0]) + ":" + str(ents[0][1]), "9:i")

    if fails == 0
        print("forge_topk: all passed")
    else
        print("forge_topk: " + str(fails) + " FAILED")
