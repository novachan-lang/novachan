import forge_config_server

fn main()
    let s = cfg_server()
    s = cfg_set(s, "prod", "db_host", "db.prod.internal")
    s = cfg_set(s, "prod", "db_port", 5432)
    s = cfg_set(s, "staging", "db_host", "db.staging.internal")

    assert(cfg_get(s, "prod", "db_host") == "db.prod.internal", "prod db_host")
    assert(cfg_get(s, "prod", "db_port") == 5432, "prod db_port")
    assert(cfg_get(s, "staging", "db_host") == "db.staging.internal", "staging db_host")
    assert(cfg_get(s, "prod", "missing") == "", "missing key")
    assert(cfg_get(s, "unknown_ns", "key") == "", "missing ns")

    assert(cfg_get_or(s, "prod", "missing", "default") == "default", "fallback")
    assert(cfg_get_or(s, "prod", "db_host", "x") == "db.prod.internal", "no fallback needed")

    let pkeys = cfg_list_keys(s, "prod")
    assert(len(pkeys) == 2, "2 prod keys")

    let nss = cfg_list_namespaces(s)
    assert(len(nss) == 2, "2 namespaces")

    assert(cfg_version(s) == 3, "version=3")

    let v1 = cfg_version(s)
    s = cfg_set(s, "prod", "cache_ttl", 300)
    let changes = cfg_changes_since(s, v1)
    assert(len(changes) == 1, "1 change since v3")
    assert(changes[0]["key"] == "cache_ttl", "change is cache_ttl")

    let snap = cfg_snapshot(s, "prod")
    assert(snap["db_host"] == "db.prod.internal", "snapshot db_host")
    assert(snap["cache_ttl"] == 300, "snapshot cache_ttl")

    print("CONFIG-SERVER KAT PASS")
