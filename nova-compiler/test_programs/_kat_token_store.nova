import forge_token_store

fn main()
    let t = ts_new()
    t = ts_store(t, "tok-abc", "user-1", 1000)
    t = ts_store(t, "tok-def", "user-2", 2000)
    assert(ts_total_created(t) == 2, "2 created")

    let r1 = ts_validate(t, "tok-abc", 500)
    t = r1["t"]
    assert(r1["valid"] == 1, "valid at 500")
    assert(r1["owner"] == "user-1", "owner user-1")

    let r2 = ts_validate(t, "tok-abc", 1500)
    t = r2["t"]
    assert(r2["valid"] == 0, "expired at 1500")
    assert(r2["reason"] == "expired", "reason expired")
    assert(ts_total_expired(t) == 1, "1 expired")

    t = ts_revoke(t, "tok-def")
    let r3 = ts_validate(t, "tok-def", 500)
    t = r3["t"]
    assert(r3["valid"] == 0, "revoked")
    assert(r3["reason"] == "revoked", "reason revoked")

    let r4 = ts_validate(t, "tok-xyz", 100)
    t = r4["t"]
    assert(r4["valid"] == 0, "not found")
    assert(r4["reason"] == "not_found", "reason not_found")

    print("TOKEN-STORE KAT PASS")
