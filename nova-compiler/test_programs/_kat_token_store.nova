import forge_token_store

fn main()
    let t = ts_new(3600)
    assert(ts_active_count(t) == 0, "starts empty")
    assert(ts_total_issued(t) == 0, "0 issued")

    t = ts_issue(t, "tok-abc", "user-1", "read")
    t = ts_issue(t, "tok-def", "user-2", "write")
    t = ts_issue(t, "tok-ghi", "user-1", "read")
    assert(ts_total_issued(t) == 3, "3 issued")
    assert(ts_active_count(t) == 3, "3 active")
    assert(ts_user_tokens(t, "user-1") == 2, "user-1 has 2 tokens")
    assert(ts_user_tokens(t, "user-2") == 1, "user-2 has 1 token")
    assert(ts_user_tokens(t, "ghost") == 0, "unknown user has 0")

    let rv1 = ts_validate(t, "tok-abc")
    assert(is_ok(rv1), "tok-abc valid")
    assert(unwrap(rv1) == "valid", "valid message")

    let rmiss = ts_validate(t, "tok-nope")
    assert(is_err(rmiss), "unknown token invalid")

    let ru = ts_get_user(t, "tok-abc")
    assert(is_ok(ru), "get_user ok")
    assert(unwrap(ru) == "user-1", "tok-abc -> user-1")

    let rs = ts_get_scope(t, "tok-def")
    assert(is_ok(rs), "get_scope ok")
    assert(unwrap(rs) == "write", "tok-def scope write")

    let rumiss = ts_get_user(t, "tok-nope")
    assert(is_err(rumiss), "get_user err for missing token")

    let rrev0 = ts_is_revoked(t, "tok-abc")
    assert(is_ok(rrev0), "is_revoked ok")
    assert(unwrap(rrev0) == 0, "not revoked yet")

    let rrevoke = ts_revoke(t, "tok-abc")
    assert(is_ok(rrevoke), "revoke ok")
    assert(ts_active_count(t) == 2, "2 active after revoke")

    let rrev1 = ts_is_revoked(t, "tok-abc")
    assert(unwrap(rrev1) == 1, "now revoked")

    let rvafter = ts_validate(t, "tok-abc")
    assert(is_err(rvafter), "revoked token invalid")

    let rrevagain = ts_revoke(t, "tok-abc")
    assert(is_err(rrevagain), "double revoke errs")

    let rrevmiss = ts_revoke(t, "tok-nope")
    assert(is_err(rrevmiss), "revoke unknown token errs")

    // re-issue reactivates
    t = ts_issue(t, "tok-abc", "user-3", "admin")
    assert(ts_active_count(t) == 3, "3 active after re-issue")
    assert(ts_total_issued(t) == 4, "4 total issuance events")
    let ru2 = ts_get_user(t, "tok-abc")
    assert(unwrap(ru2) == "user-3", "tok-abc rebound to user-3")
    let rrev2 = ts_is_revoked(t, "tok-abc")
    assert(unwrap(rrev2) == 0, "un-revoked after re-issue")

    print("TOKEN-STORE KAT PASS")
