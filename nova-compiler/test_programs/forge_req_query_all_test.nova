// forge_req_query_all_test -- req_query_all reads EVERY value of a repeated query key on a typed Request
// (re-parsing req.raw_path, since req.query is a single-value dict). The typed counterpart of query_all; the
// way a multi-select/checkbox form (?tag=a&tag=b) is fully readable on the Request path. Exact key match.
import forge

fn main()
    let req = forge.build_request("GET /p?tag=a&tag=b&tag=c HTTP/1.1\r\n\r\n", 0)
    let r = forge.req_query_all(req, "tag")
    if len(r) != 3 or r[0] != "a" or r[1] != "b" or r[2] != "c"
        print("FAIL: expected [a,b,c]")
        exit(1)

    // interleaved with other keys; a prefix key (xtag) must NOT match
    let req2 = forge.build_request("GET /p?x=1&tag=a&xtag=z&tag=b HTTP/1.1\r\n\r\n", 0)
    let r2 = forge.req_query_all(req2, "tag")
    if len(r2) != 2 or r2[0] != "a" or r2[1] != "b"
        print("FAIL: interleaved / exact-match")
        exit(1)

    // absent key -> empty list
    let req3 = forge.build_request("GET /p?x=1 HTTP/1.1\r\n\r\n", 0)
    if len(forge.req_query_all(req3, "tag")) != 0
        print("FAIL: absent key should be empty")
        exit(1)

    // no query string at all -> empty list
    let req4 = forge.build_request("GET /p HTTP/1.1\r\n\r\n", 0)
    if len(forge.req_query_all(req4, "tag")) != 0
        print("FAIL: no query string should be empty")
        exit(1)

    print("PASS forge_req_query_all (typed Request: all repeated values, exact-match, absent->[])")
