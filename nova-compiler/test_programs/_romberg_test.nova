// KAT test for std/numeric/romberg — Romberg integration (Richardson extrapolation)
import std/numeric/romberg

// Named top-level functions passed as first-class arguments to rb_integrate.
// Each is a single-argument pure-math function returning float.
fn fsq(x) -> float
    let v = x * x
    return v

fn fx(x) -> float
    return x

fn fcube(x) -> float
    let v = x * x * x
    return v

fn fquad(x) -> float
    let v = x * x * x * x
    return v

// ckf: check a float result is within eps of want; print FAIL+exit on mismatch
fn ckf(got, want, eps, label)
    let diff = got - want
    let adiff = diff
    if diff < 0.0
        adiff = diff * -1.0
    if adiff > eps
        print("FAIL " + label + " got=" + str(got) + " want=" + str(want))
        exit(1)
    print("ok " + label)

fn main()
    // KAT 1: integral of x^2 from 0 to 3 = 9.0
    let r1 = rb_integrate(fsq, 0.0, 3.0, 6)
    ckf(r1, 9.0, 0.001, "rb_integrate(fsq,0,3,6)==9.0")

    // KAT 2: integral of x from 0 to 4 = 8.0
    let r2 = rb_integrate(fx, 0.0, 4.0, 6)
    ckf(r2, 8.0, 0.001, "rb_integrate(fx,0,4,6)==8.0")

    // KAT 3: integral of x^2 from 0 to 1 = 1/3 ~ 0.33333
    let r3 = rb_integrate(fsq, 0.0, 1.0, 6)
    ckf(r3, 0.33333, 0.001, "rb_integrate(fsq,0,1,6)==0.33333")

    // KAT 4: integral of x^3 from 0 to 2 = 4.0
    let r4 = rb_integrate(fcube, 0.0, 2.0, 6)
    ckf(r4, 4.0, 0.001, "rb_integrate(fcube,0,2,6)==4.0")

    // KAT 5: integral of x^2 from 1 to 2 = (8-1)/3 = 7/3 ~ 2.33333
    let r5 = rb_integrate(fsq, 1.0, 2.0, 6)
    ckf(r5, 2.33333, 0.001, "rb_integrate(fsq,1,2,6)==7/3")

    // KAT 6: integral of x^4 from 0 to 2 = 2^5/5 = 32/5 = 6.4
    // Romberg with order=6 should nail this exactly (polynomial of degree 4).
    let r6 = rb_integrate(fquad, 0.0, 2.0, 6)
    ckf(r6, 6.4, 0.001, "rb_integrate(fquad,0,2,6)==6.4")

    print("_romberg_test passed")
