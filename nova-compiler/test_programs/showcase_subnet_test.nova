// showcase_subnet_test.nova
// IPv4 subnet planner — exercises std/net/ip with edge-case CIDRs.
// Bug-hunt target: >> arithmetic-shift hazard on high-bit (>=128) IP integers.
// Every computed value is cross-checked against hand-derived expected values.

import std/net/ip

// ── helpers (all 32-bit safe) ─────────────────────────────────────────────────

// Build 32-bit subnet mask from prefix length.
// GOTCHA: >> is arithmetic in NOVA.  We only shift 0xFFFFFFFF (positive i64) so
// sign-extension is harmless, but we still & 0xFFFFFFFF at the end to keep the
// value in [0, 2^32-1] for safe comparisons.
fn _subnet_mask(prefix: int) -> int
    if prefix == 0
        return 0
    (0xFFFFFFFF << (32 - prefix)) & 0xFFFFFFFF

// Network address: zero the host bits.
fn _network_addr(ip_int: int, prefix: int) -> int
    let msk = _subnet_mask(prefix)
    ip_int & msk

// Broadcast: set all host bits.
fn _broadcast_addr(ip_int: int, prefix: int) -> int
    let msk = _subnet_mask(prefix)
    let host_mask = (msk ^ 0xFFFFFFFF) & 0xFFFFFFFF
    (ip_int & msk) | host_mask

// Usable host count: 2^(32-prefix) - 2, but /32 = 1 host, /31 = 2 hosts.
fn _host_count(prefix: int) -> int
    if prefix == 32
        return 1
    if prefix == 31
        return 2
    // 2^(32-prefix) addresses minus network+broadcast
    let shift = 32 - prefix
    // build 2^shift via a loop (avoid 1<<shift which has the 1<<64 bug for prefix=0)
    let i = 0
    let acc = 1
    while i < shift
        acc = acc * 2
        i = i + 1
    acc - 2

// ── per-CIDR assertion helper ─────────────────────────────────────────────────

fn _assert_int(label: string, got: int, expected: int)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn _assert_str(label: string, got: string, expected: string)
    if got != expected
        print("FAIL " + label + ": got " + got + " expected " + expected)
        exit(1)

fn _assert_bool(label: string, got: bool, expected: bool)
    let gs = "false"
    if got
        gs = "true"
    let es = "false"
    if expected
        es = "true"
    if got != expected
        print("FAIL " + label + ": got " + gs + " expected " + es)
        exit(1)

// ── main ──────────────────────────────────────────────────────────────────────

fn main()
    // ══════════════════════════════════════════════════════════════════════════
    // BLOCK 1: 192.168.1.0/24  (canonical private /24)
    // ══════════════════════════════════════════════════════════════════════════
    // 192.168.1.0 = 192*16777216 + 168*65536 + 1*256 + 0 = 3232235776
    let cidr24 = "192.168.1.0/24"
    let ip24 = ipv4_parse("192.168.1.0")
    _assert_int("b1/parse", ip24, 3232235776)
    _assert_str("b1/format", ipv4_format(ip24), "192.168.1.0")
    _assert_int("b1/mask", _subnet_mask(24), 4294967040)       // 0xFFFFFF00
    _assert_int("b1/network", _network_addr(ip24, 24), 3232235776)
    _assert_int("b1/broadcast", _broadcast_addr(ip24, 24), 3232236031)  // .255
    _assert_str("b1/bcast_fmt", ipv4_format(_broadcast_addr(ip24, 24)), "192.168.1.255")
    _assert_int("b1/hosts", _host_count(24), 254)
    _assert_bool("b1/contains_200", cidr_contains(cidr24, "192.168.1.200"), true)
    _assert_bool("b1/contains_0",   cidr_contains(cidr24, "192.168.1.0"),   true)
    _assert_bool("b1/contains_255", cidr_contains(cidr24, "192.168.1.255"), true)
    _assert_bool("b1/excl_2.1",     cidr_contains(cidr24, "192.168.2.1"),   false)
    _assert_bool("b1/excl_0.1",     cidr_contains(cidr24, "192.168.0.1"),   false)
    print("BLOCK1 192.168.1.0/24 OK")

    // ══════════════════════════════════════════════════════════════════════════
    // BLOCK 2: 10.0.0.0/8  (class A)
    // ══════════════════════════════════════════════════════════════════════════
    // 10.0.0.0 = 10*16777216 = 167772160
    let cidr8 = "10.0.0.0/8"
    let ip8 = ipv4_parse("10.0.0.0")
    _assert_int("b2/parse", ip8, 167772160)
    _assert_int("b2/mask", _subnet_mask(8), 4278190080)        // 0xFF000000
    _assert_int("b2/network", _network_addr(ip8, 8), 167772160)
    // broadcast = 10.255.255.255 = 10*16777216 + 16777215 = 184549375
    _assert_int("b2/broadcast", _broadcast_addr(ip8, 8), 184549375)
    _assert_str("b2/bcast_fmt", ipv4_format(_broadcast_addr(ip8, 8)), "10.255.255.255")
    _assert_int("b2/hosts", _host_count(8), 16777214)
    _assert_bool("b2/contains_5.4.3", cidr_contains(cidr8, "10.5.4.3"),   true)
    _assert_bool("b2/contains_255.1", cidr_contains(cidr8, "10.255.255.1"), true)
    _assert_bool("b2/excl_11",        cidr_contains(cidr8, "11.0.0.0"),    false)
    _assert_bool("b2/excl_9",         cidr_contains(cidr8, "9.255.255.255"), false)
    print("BLOCK2 10.0.0.0/8 OK")

    // ══════════════════════════════════════════════════════════════════════════
    // BLOCK 3: 0.0.0.0/0  (default route — everything matches)
    // ══════════════════════════════════════════════════════════════════════════
    let cidr0 = "0.0.0.0/0"
    _assert_int("b3/mask", _subnet_mask(0), 0)
    _assert_int("b3/hosts", _host_count(0), 4294967294)   // 2^32 - 2
    _assert_bool("b3/contains_any1", cidr_contains(cidr0, "0.0.0.0"),         true)
    _assert_bool("b3/contains_any2", cidr_contains(cidr0, "255.255.255.255"), true)
    _assert_bool("b3/contains_any3", cidr_contains(cidr0, "10.0.0.1"),        true)
    // BUG-HUNT: high-bit address 200.1.2.3 — raw int = 3355508227 (> 2^31)
    // If >> sign-extends and mask is wrong, this could yield a wrong result.
    _assert_bool("b3/high_bit_200", cidr_contains(cidr0, "200.1.2.3"), true)
    print("BLOCK3 0.0.0.0/0 OK")

    // ══════════════════════════════════════════════════════════════════════════
    // BLOCK 4: 10.1.2.3/32  (single host)
    // ══════════════════════════════════════════════════════════════════════════
    let cidr32 = "10.1.2.3/32"
    _assert_int("b4/mask", _subnet_mask(32), 4294967295)   // 0xFFFFFFFF
    _assert_int("b4/hosts", _host_count(32), 1)
    _assert_bool("b4/exact",   cidr_contains(cidr32, "10.1.2.3"), true)
    _assert_bool("b4/excl_+1", cidr_contains(cidr32, "10.1.2.4"), false)
    _assert_bool("b4/excl_-1", cidr_contains(cidr32, "10.1.2.2"), false)
    print("BLOCK4 10.1.2.3/32 OK")

    // ══════════════════════════════════════════════════════════════════════════
    // BLOCK 5: 10.1.2.2/31  (point-to-point /31, RFC 3021)
    // ══════════════════════════════════════════════════════════════════════════
    // mask = 0xFFFFFFFE; network = 10.1.2.2; both .2 and .3 are in range
    let cidr31 = "10.1.2.2/31"
    _assert_int("b5/mask", _subnet_mask(31), 4294967294)   // 0xFFFFFFFE
    _assert_int("b5/hosts", _host_count(31), 2)
    _assert_bool("b5/contains_2", cidr_contains(cidr31, "10.1.2.2"), true)
    _assert_bool("b5/contains_3", cidr_contains(cidr31, "10.1.2.3"), true)
    _assert_bool("b5/excl_1",     cidr_contains(cidr31, "10.1.2.1"), false)
    _assert_bool("b5/excl_4",     cidr_contains(cidr31, "10.1.2.4"), false)
    print("BLOCK5 10.1.2.2/31 OK")

    // ══════════════════════════════════════════════════════════════════════════
    // BLOCK 6: HIGH-BIT addresses — the prime >> arithmetic-shift bug target.
    // 200.x.x.x has bit 31 set → raw i64 is positive (200*2^24 = 3355443200)
    // but a WRONG shift of the mask could sign-extend into negative territory.
    // ══════════════════════════════════════════════════════════════════════════
    // 200.100.50.25 = 200*16777216 + 100*65536 + 50*256 + 25
    //               = 3355443200 + 6553600 + 12800 + 25 = 3361909625 (but above 2^31!)
    // Wait — let me recompute: 200*16777216 = 3355443200 (this is > 2^31=2147483648)
    // so this stored as positive i64 = 3355443200.  Safe.
    let ip_200 = ipv4_parse("200.100.50.25")
    // hand: 200*16777216=3355443200, +100*65536=6553600, +50*256=12800, +25=25
    //       total = 3355443200+6553600+12800+25 = 3362009625
    // Re-check: 3355443200+6553600=3361996800, +12800=3362009600, +25=3362009625
    _assert_int("b6/parse_200", ip_200, 3362009625)
    _assert_str("b6/format_200", ipv4_format(ip_200), "200.100.50.25")

    // /24 around 200.100.50.0
    let cidr_200_24 = "200.100.50.0/24"
    // mask = 0xFFFFFF00; network = 200.100.50.0; broadcast = 200.100.50.255
    // network_int = 3362009600
    let net_200 = _network_addr(ip_200, 24)
    _assert_int("b6/net_200", net_200, 3362009600)
    _assert_str("b6/net_200_fmt", ipv4_format(net_200), "200.100.50.0")
    let bcast_200 = _broadcast_addr(ip_200, 24)
    // broadcast = 3362009600 | 0xFF = 3362009855
    _assert_int("b6/bcast_200", bcast_200, 3362009855)
    _assert_str("b6/bcast_200_fmt", ipv4_format(bcast_200), "200.100.50.255")
    _assert_bool("b6/contains_25",  cidr_contains(cidr_200_24, "200.100.50.25"),  true)
    _assert_bool("b6/contains_1",   cidr_contains(cidr_200_24, "200.100.50.1"),   true)
    _assert_bool("b6/excl_51",      cidr_contains(cidr_200_24, "200.100.51.0"),   false)
    _assert_bool("b6/excl_49",      cidr_contains(cidr_200_24, "200.100.49.255"), false)
    print("BLOCK6 high-bit 200.x.x.x/24 OK")

    // ══════════════════════════════════════════════════════════════════════════
    // BLOCK 7: 255.255.255.255/32 (all-ones — maximum IP)
    // ══════════════════════════════════════════════════════════════════════════
    // 255.255.255.255 = 4294967295  (0xFFFFFFFF, stored as positive i64)
    let ip_max = ipv4_parse("255.255.255.255")
    _assert_int("b7/parse_max", ip_max, 4294967295)
    _assert_str("b7/format_max", ipv4_format(ip_max), "255.255.255.255")
    _assert_bool("b7/contains_max", cidr_contains("255.255.255.255/32", "255.255.255.255"), true)
    _assert_bool("b7/excl_254",     cidr_contains("255.255.255.255/32", "255.255.255.254"), false)
    // /24 around it: 255.255.255.0/24
    let net_ff24 = _network_addr(ip_max, 24)
    // 0xFFFFFFFF & 0xFFFFFF00 = 0xFFFFFF00 = 4294967040
    _assert_int("b7/net_ff24", net_ff24, 4294967040)
    _assert_str("b7/net_ff24_fmt", ipv4_format(net_ff24), "255.255.255.0")
    _assert_bool("b7/contains_1",  cidr_contains("255.255.255.0/24", "255.255.255.1"),   true)
    _assert_bool("b7/excl_lower",  cidr_contains("255.255.255.0/24", "255.255.254.255"), false)
    print("BLOCK7 255.255.255.255/32 OK")

    // ══════════════════════════════════════════════════════════════════════════
    // BLOCK 8: validity checks and malformed input
    // ══════════════════════════════════════════════════════════════════════════
    _assert_bool("b8/valid_ok",      ipv4_is_valid("10.0.0.1"),      true)
    _assert_bool("b8/valid_255",     ipv4_is_valid("255.255.255.255"), true)
    _assert_bool("b8/valid_0",       ipv4_is_valid("0.0.0.0"),       true)
    _assert_bool("b8/invalid_256",   ipv4_is_valid("256.0.0.1"),     false)
    _assert_bool("b8/invalid_empty", ipv4_is_valid(""),              false)
    _assert_bool("b8/invalid_3oct",  ipv4_is_valid("1.2.3"),         false)
    _assert_bool("b8/invalid_alpha", ipv4_is_valid("1.2.a.4"),       false)
    _assert_bool("b8/cidr_bad_ip",   cidr_contains("10.0.0.0/8", "not.an.ip"), false)
    _assert_bool("b8/cidr_no_slash", cidr_contains("10.0.0.0", "10.1.2.3"),    false)
    _assert_bool("b8/cidr_prefix33", cidr_contains("10.0.0.0/33", "10.1.2.3"), false)
    print("BLOCK8 validity/malformed OK")

    // ══════════════════════════════════════════════════════════════════════════
    // BLOCK 9: /16 with non-zero host bits in the CIDR address (10.1.5.7/16)
    // cidr_contains should still match based on masked network = 10.1.0.0
    // ══════════════════════════════════════════════════════════════════════════
    // 10.1.5.7 masked /16 = 10.1.0.0 = 167837696
    _assert_bool("b9/non_aligned_cidr_in",  cidr_contains("10.1.5.7/16", "10.1.200.1"), true)
    _assert_bool("b9/non_aligned_cidr_out", cidr_contains("10.1.5.7/16", "10.2.0.1"),   false)
    // mask /16 = 0xFFFF0000 = 4294901760
    _assert_int("b9/mask16", _subnet_mask(16), 4294901760)
    // network = 10.1.5.7 & 0xFFFF0000
    // 10.1.5.7 = 10*16777216+1*65536+5*256+7 = 167837191 (wait, let me re-check)
    // 10*16777216 = 167772160; +1*65536=65536 -> 167837696; +5*256=1280 -> 167838976; +7=167838983
    // & 0xFFFF0000 = 167837696
    let ip_1_5_7 = ipv4_parse("10.1.5.7")
    _assert_int("b9/parse_1_5_7", ip_1_5_7, 167838983)
    let net_1_5_7_16 = _network_addr(ip_1_5_7, 16)
    _assert_int("b9/net16", net_1_5_7_16, 167837696)
    _assert_str("b9/net16_fmt", ipv4_format(net_1_5_7_16), "10.1.0.0")
    print("BLOCK9 non-aligned CIDR /16 OK")

    print("showcase_subnet_test passed")
