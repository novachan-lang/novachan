// KAT test for std/numeric/sf_erf — error function and relatives.
//
// Known answers:
//   erf(0.0)       = 0.0
//   erf(1.0)       ~= 0.8427007929...
//   erf(-1.0)      ~= -0.8427007929...
//   erfc(0.0)      = 1.0
//   erfc(1.0)      ~= 0.1572992...
//   normal_cdf(0.0) = 0.5
//   normal_cdf(1.0) ~= 0.8413447...
import std/numeric/sf_erf

fn approx(a, b, tol) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < tol
        return 1
    return 0

fn ck(label: string, got: float, want: float, tol: float)
    let ok = approx(got, want, tol)
    if ok == 0
        print("FAIL sf_erf " + label + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("ok " + label)

fn main()
    // erf(0.0) = 0.0
    let e0 = erf(0.0)
    ck("erf(0.0)=0.0", e0, 0.0, 0.0001)

    // erf(1.0) ~= 0.8427008
    let e1 = erf(1.0)
    ck("erf(1.0)=0.8427008", e1, 0.8427008, 0.001)

    // erf(-1.0) ~= -0.8427008 (antisymmetry)
    let em1 = erf(0.0 - 1.0)
    ck("erf(-1.0)=-0.8427008", em1, 0.0 - 0.8427008, 0.001)

    // erfc(0.0) = 1.0
    let ec0 = erfc(0.0)
    ck("erfc(0.0)=1.0", ec0, 1.0, 0.001)

    // erfc(1.0) ~= 0.1572992
    let ec1 = erfc(1.0)
    ck("erfc(1.0)=0.1572992", ec1, 0.1572992, 0.001)

    // normal_cdf(0.0) = 0.5
    let nc0 = normal_cdf(0.0)
    ck("normal_cdf(0.0)=0.5", nc0, 0.5, 0.001)

    // normal_cdf(1.0) ~= 0.8413447
    let nc1 = normal_cdf(1.0)
    ck("normal_cdf(1.0)=0.8413447", nc1, 0.8413447, 0.001)

    print("PASS _sf_erf_test")
