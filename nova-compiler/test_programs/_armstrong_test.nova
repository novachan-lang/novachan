// _armstrong_test.nova — KAT for std/math/armstrong
// Hand-computed expected values, cross-checked against OEIS A005188 (narcissistic numbers).
//
// Digit-power sum traces:
//   153: d=3, 1^3+5^3+3^3 = 1+125+27     = 153   -> is Armstrong
//   154: d=3, 1^3+5^3+4^3 = 1+125+64     = 190   -> not Armstrong
//   370: d=3, 3^3+7^3+0^3 = 27+343+0     = 370   -> is Armstrong
//   371: d=3, 3^3+7^3+1^3 = 27+343+1     = 371   -> is Armstrong
//   407: d=3, 4^3+0^3+7^3 = 64+0+343     = 407   -> is Armstrong
//   408: d=3, 4^3+0^3+8^3 = 64+0+512     = 576   -> not Armstrong
//   9474: d=4, 9^4+4^4+7^4+4^4 = 6561+256+2401+256 = 9474 -> is Armstrong
//
// Digit count traces:
//   arm_digit_count(0)=1, arm_digit_count(9)=1, arm_digit_count(10)=2,
//   arm_digit_count(153)=3, arm_digit_count(9474)=4.

import std/math/armstrong

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got " + gs + " want " + ws)
        exit(1)

fn main()
    // --- arm_digit_count ---
    cki("digit_count(0)",    arm_digit_count(0),    1)
    cki("digit_count(9)",    arm_digit_count(9),    1)
    cki("digit_count(10)",   arm_digit_count(10),   2)
    cki("digit_count(99)",   arm_digit_count(99),   2)
    cki("digit_count(100)",  arm_digit_count(100),  3)
    cki("digit_count(153)",  arm_digit_count(153),  3)
    cki("digit_count(9474)", arm_digit_count(9474), 4)

    // --- arm_digit_pow_sum ---
    // Single digits: d=1, digit^1 = digit
    cki("pow_sum(0)",  arm_digit_pow_sum(0),  0)
    cki("pow_sum(5)",  arm_digit_pow_sum(5),  5)
    cki("pow_sum(9)",  arm_digit_pow_sum(9),  9)
    // 3-digit Armstrong numbers
    cki("pow_sum(153)", arm_digit_pow_sum(153), 153)  // 1+125+27=153
    cki("pow_sum(370)", arm_digit_pow_sum(370), 370)  // 27+343+0=370
    cki("pow_sum(371)", arm_digit_pow_sum(371), 371)  // 27+343+1=371
    cki("pow_sum(407)", arm_digit_pow_sum(407), 407)  // 64+0+343=407
    // 3-digit non-Armstrong
    cki("pow_sum(154)", arm_digit_pow_sum(154), 190)  // 1+125+64=190
    cki("pow_sum(408)", arm_digit_pow_sum(408), 576)  // 64+0+512=576
    // 4-digit Armstrong
    cki("pow_sum(9474)", arm_digit_pow_sum(9474), 9474) // 6561+256+2401+256=9474

    // --- arm_sum_powers (alias for arm_digit_pow_sum per SPEC) ---
    cki("sum_powers(153)", arm_sum_powers(153), 153)

    // --- arm_is (SPEC-required KATs) ---
    ckb("is(153)",  arm_is(153),  true)
    ckb("is(154)",  arm_is(154),  false)
    ckb("is(370)",  arm_is(370),  true)
    ckb("is(371)",  arm_is(371),  true)
    ckb("is(407)",  arm_is(407),  true)
    ckb("is(408)",  arm_is(408),  false)
    ckb("is(9474)", arm_is(9474), true)
    // Single digits are all narcissistic
    ckb("is(0)", arm_is(0), true)
    ckb("is(1)", arm_is(1), true)
    ckb("is(9)", arm_is(9), true)
    // Two-digit numbers: none are narcissistic (e.g. 10: 1^2+0^2=1!=10)
    ckb("is(10)", arm_is(10), false)
    ckb("is(11)", arm_is(11), false)
    ckb("is(99)", arm_is(99), false)

    // --- arm_upto ---
    let u0 = arm_upto(-1)
    cki("upto(-1) len", len(u0), 0)

    // All single-digit 0..9 are Armstrong
    let u9 = arm_upto(9)
    cki("upto(9) len", len(u9), 10)
    cki("upto(9)[0]",  u9[0],  0)
    cki("upto(9)[9]",  u9[9],  9)

    // No Armstrong numbers between 10 and 152
    let u10 = arm_upto(10)
    cki("upto(10) len", len(u10), 10)  // same 10 single-digits

    // 153 is the first 3-digit Armstrong
    let u153 = arm_upto(153)
    cki("upto(153) len",   len(u153), 11)
    cki("upto(153)[10]",   u153[10],  153)

    // All 3-digit Armstrong numbers: 153, 370, 371, 407
    // upto(500): 10 singles + 153, 370, 371, 407 = 14 total
    let u500 = arm_upto(500)
    cki("upto(500) len",  len(u500), 14)
    cki("upto(500)[10]",  u500[10],  153)
    cki("upto(500)[11]",  u500[11],  370)
    cki("upto(500)[12]",  u500[12],  371)
    cki("upto(500)[13]",  u500[13],  407)

    // upto(410): 10 singles + 153, 370, 371, 407 = 14 (same, 407 <= 410)
    let u410 = arm_upto(410)
    cki("upto(410) len", len(u410), 14)
    cki("upto(410)[13]", u410[13],  407)

    print("_armstrong_test passed")
