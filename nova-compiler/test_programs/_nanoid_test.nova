// KAT test for std/util/nanoid.
// All expected values were HAND-COMPUTED by tracing prng_seed(42) through the
// xorshift64 generator and applying idx = value & 63 into the 64-char alphabet.
//
// Assertions:
//   cks(got, expected, label) — checks a string, prints FAIL + exits on mismatch
//   cki(got, expected, label) — checks an int,    prints FAIL + exits on mismatch
//   ckt(condition, label)     — asserts a bool,   prints FAIL + exits if false

import std/util/nanoid
import std/util/prng

fn cks(got, expected, label)
    if got != expected
        print("FAIL " + label + ": got '" + got + "' expected '" + expected + "'")
        exit(1)

fn cki(got: int, expected: int, label)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn ckt(condition: int, label)
    if condition == 0
        print("FAIL " + label)
        exit(1)

// Scan `s` to confirm every character appears somewhere in `alpha`.
// Returns 1 if all chars are in the alphabet, 0 if any is not.
fn _all_in_alpha(s, alpha) -> int
    let i = 0
    while i < len(s)
        let c = s[i]
        let found = 0
        let j = 0
        while j < len(alpha)
            if alpha[j] == c
                found = 1
                j = len(alpha)
            j = j + 1
        if found == 0
            return 0
        i = i + 1
    1

fn main()
    let alpha = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-"

    // ── KAT 1: length == size for an explicit size ──────────────────────────
    // nano_gen(seed=42, size=6) -> ['PP9vZb', newstate]  (hand-traced)
    let s42 = prng_seed(42)
    let r6 = nano_gen(s42, 6)
    let id6 = r6[0]
    cki(len(id6), 6, "KAT1 length==6")
    cks(id6, "PP9vZb", "KAT1 exact id6")

    // ── KAT 2: length == 21 for nano_gen_default ───────────────────────────
    let rd = nano_gen_default(s42)
    let idd = rd[0]
    cki(len(idd), 21, "KAT2 default length==21")
    cks(idd, "PP9vZbR-S9k4RMyfOPscH", "KAT2 exact default id")

    // ── KAT 3: nano_gen(state, 21) == nano_gen_default(state) ──────────────
    let r21 = nano_gen(s42, 21)
    let id21 = r21[0]
    cks(id21, idd, "KAT3 nano_gen(21)==default")

    // ── KAT 4: every character of the produced id is in the alphabet ────────
    ckt(_all_in_alpha(id21, alpha), "KAT4 all chars in alphabet (seed=42)")

    // ── KAT 5: same seed -> identical id (determinism) ─────────────────────
    let r21b = nano_gen(s42, 21)
    cks(r21b[0], id21, "KAT5 same seed->same id")

    // ── KAT 6: different seed -> different id ──────────────────────────────
    let s1234 = prng_seed(1234)
    let r_diff = nano_gen(s1234, 21)
    let id_diff = r_diff[0]
    cks(id_diff, "hKaH1kymkNZS2L8fwsLGy", "KAT6 exact id seed=1234")
    ckt(len(id_diff), "KAT6 diff id non-empty")
    // They must differ (would be an astronomical coincidence otherwise, and
    // the hand-trace confirms they are distinct strings).
    if id_diff == id21
        print("FAIL KAT6 different seeds produced identical ids")
        exit(1)

    // ── KAT 7: alphabet chars in id_diff also valid ────────────────────────
    ckt(_all_in_alpha(id_diff, alpha), "KAT7 all chars in alphabet (seed=1234)")

    print("_nanoid_test passed")
