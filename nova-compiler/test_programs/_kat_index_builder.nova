import forge_index_builder

fn main()
    let b = ib_new()
    b = ib_register_doc(b)
    b = ib_add_doc(b, "doc1", "rust")
    b = ib_add_doc(b, "doc1", "safety")
    b = ib_register_doc(b)
    b = ib_add_doc(b, "doc2", "rust")
    b = ib_add_doc(b, "doc2", "performance")

    assert(ib_doc_count(b) == 2, "2 docs")
    assert(ib_term_count(b) == 3, "3 terms")
    assert(ib_total_entries(b) == 4, "4 entries")

    let r1 = ib_search(b, "rust")
    assert(is_ok(r1), "search ok")
    assert(unwrap(r1) == "doc1,doc2", "both docs")

    let r2 = ib_search(b, "safety")
    assert(is_ok(r2), "search safety")
    assert(unwrap(r2) == "doc1", "only doc1")

    assert(ib_has_term(b, "rust") == 1, "has rust")
    assert(ib_has_term(b, "nope") == 0, "no nope")

    let bad = ib_search(b, "missing")
    assert(is_err(bad), "term not found")

    print("INDEX-BUILDER KAT PASS")
