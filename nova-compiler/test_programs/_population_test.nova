import std/bio/population

fn approx(a, b, tol) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < tol
        return true
    return false

fn fail(label, got, want)
    print("FAIL population " + label + ": got=" + str(got) + " want=" + str(want))
    exit(1)

fn main()
    // KAT 1: allele_freq(['AA','Aa','aa'], 'A') = (2+1+0)/6 = 0.5
    let genos1 = ["AA", "Aa", "aa"]
    let f1 = allele_freq(genos1, "A")
    if not approx(f1, 0.5, 0.0001)
        fail("allele_freq A=0.5", f1, 0.5)

    // KAT 2: expected_heterozygosity(0.5) = 2*0.5*0.5 = 0.5
    let he1 = expected_heterozygosity(0.5)
    if not approx(he1, 0.5, 0.0001)
        fail("expected_het 0.5", he1, 0.5)

    // KAT 3: hw_expected_freqs(0.5) -> AA=0.25
    let hwf = hw_expected_freqs(0.5)
    let fAA = hwf["AA"]
    if not approx(fAA, 0.25, 0.0001)
        fail("hw_expected AA=0.25", fAA, 0.25)

    // KAT 4: heterozygosity(['AA','Aa','aa']) = 1/3
    let het1 = heterozygosity(genos1)
    if not approx(het1, 0.3333, 0.001)
        fail("heterozygosity 1/3", het1, 0.3333)

    // KAT 5: allele_count(['AA','Aa'], 'A') = 2 + 1 = 3
    let genos2 = ["AA", "Aa"]
    let cnt1 = allele_count(genos2, "A")
    if cnt1 != 3
        print("FAIL population allele_count: got=" + str(cnt1) + " want=3")
        exit(1)

    // KAT 6: inbreeding_coefficient(0.4, 0.5) = 1 - 0.4/0.5 = 0.2
    let F1 = inbreeding_coefficient(0.4, 0.5)
    if not approx(F1, 0.2, 0.0001)
        fail("inbreeding_coeff 0.2", F1, 0.2)

    // KAT 7: hw_expected_freqs(0.5) -> Aa=0.5
    let fAa = hwf["Aa"]
    if not approx(fAa, 0.5, 0.0001)
        fail("hw_expected Aa=0.5", fAa, 0.5)

    // KAT 8: hw_expected_freqs(0.5) -> aa=0.25
    let faa = hwf["aa"]
    if not approx(faa, 0.25, 0.0001)
        fail("hw_expected aa=0.25", faa, 0.25)

    // KAT 9: allele_freq for 'a' in genos1 = 0.5
    let f2 = allele_freq(genos1, "a")
    if not approx(f2, 0.5, 0.0001)
        fail("allele_freq a=0.5", f2, 0.5)

    // KAT 10: num_alleles(['AA','Aa','aa']) = 2 (A and a)
    let na1 = num_alleles(genos1)
    if na1 != 2
        print("FAIL population num_alleles: got=" + str(na1) + " want=2")
        exit(1)

    // KAT 11: minor_allele_freq(['AA','Aa','aa'], 'A', 'a') = 0.5 (equal)
    let maf1 = minor_allele_freq(genos1, "A", "a")
    if not approx(maf1, 0.5, 0.0001)
        fail("minor_allele_freq 0.5", maf1, 0.5)

    // KAT 12: fst with equal subpop freqs should be 0.0
    let subpops1 = [0.5, 0.5]
    let fst1 = fst(subpops1)
    if not approx(fst1, 0.0, 0.0001)
        fail("fst equal pops", fst1, 0.0)

    // KAT 13: fst with differing subpop freqs should be positive
    let subpops2 = [0.1, 0.9]
    let fst2 = fst(subpops2)
    if fst2 <= 0.0
        fail("fst positive", fst2, 0.0)

    // KAT 14: nucleotide_diversity on identical seqs == 0.0
    let seqs_id = ["AAAA", "AAAA", "AAAA"]
    let pi1 = nucleotide_diversity(seqs_id)
    if not approx(pi1, 0.0, 0.0001)
        fail("nucleotide_diversity_identical", pi1, 0.0)

    // KAT 15: nucleotide_diversity on 2 seqs with 2/4 differences = 0.5
    let seqs_diff = ["AAAA", "AATT"]
    let pi2 = nucleotide_diversity(seqs_diff)
    if not approx(pi2, 0.5, 0.0001)
        fail("nucleotide_diversity 0.5", pi2, 0.5)

    // KAT 16: inbreeding_coefficient with exp_het=0.0 returns 0.0 (edge)
    let F2 = inbreeding_coefficient(0.0, 0.0)
    if not approx(F2, 0.0, 0.0001)
        fail("inbreeding_coeff zero exp_het", F2, 0.0)

    // KAT 17: expected_heterozygosity(0.0) == 0.0
    let he2 = expected_heterozygosity(0.0)
    if not approx(he2, 0.0, 0.0001)
        fail("expected_het p=0", he2, 0.0)

    // KAT 18: hw_chi_square with perfectly HW pop
    // N=100, p=0.5 => expected: AA=25, Aa=50, aa=25
    // If observed matches exactly, chi-square = 0
    let obs_hw = {}
    obs_hw["AA"] = 25
    obs_hw["Aa"] = 50
    obs_hw["aa"] = 25
    let chi1 = hw_chi_square(obs_hw, 0.5)
    if not approx(chi1, 0.0, 0.0001)
        fail("hw_chi_square perfect HW", chi1, 0.0)

    // KAT 19: is_in_hwe with perfect HW pop
    let in_hwe1 = is_in_hwe(obs_hw, 0.5, 3.841)
    if not in_hwe1
        print("FAIL population is_in_hwe: perfect pop should be in HWE")
        exit(1)

    // KAT 20: hw_chi_square with p=1.0 must return a finite number (not NaN).
    // At p=1.0, q=0.0 => exp_Aa=0 and exp_aa=0 (excluded by the fix); only exp_AA is nonzero.
    // With observed={AA:10, Aa:0, aa:0}, n=10, exp_AA=10.0 => chi = 0.0 exactly.
    let obs_p1 = {}
    obs_p1["AA"] = 10
    obs_p1["Aa"] = 0
    obs_p1["aa"] = 0
    let chi_p1 = hw_chi_square(obs_p1, 1.0)
    // NaN != NaN, so if chi_p1 != chi_p1 the result is NaN (which is the bug we fixed).
    if chi_p1 != chi_p1
        print("FAIL population hw_chi_square p=1.0: got NaN (division by zero)")
        exit(1)
    if chi_p1 < 0.0
        print("FAIL population hw_chi_square p=1.0: got negative value")
        exit(1)

    print("PASS _population_test")
