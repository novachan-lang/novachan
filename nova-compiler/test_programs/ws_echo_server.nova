// WebSocket echo server (RFC 6455) — accepts one client, echoes 2 messages, closes.
fn main()
    let argv = args()
    let port = 18890
    if len(argv) > 1
        port = parse_int(argv[1])
    let server = tcp_listen(port)
    print("ws listening on {port}")
    let client = tcp_accept(server)
    let up = ws_upgrade(client)
    if up == 0
        print("upgrade failed")
        return
    print("upgraded")
    let i = 0
    while i < 2
        let msg = ws_recv(up, 65536)
        print("recv: {msg}")
        ws_send(up, msg)
        i = i + 1
    ws_close(up)
    print("closed")
