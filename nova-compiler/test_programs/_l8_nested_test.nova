// L8 fix: custom-index return-type resolution -> nested `grid[i][j]` and chained `grid[i].field` dispatch
// correctly (previously the second index / float field read garbage), and an ANNOTATED struct param
// dispatches via [].
type Row
    cells: list
    tag: float

fn Row.index(self, j) -> any
    self.cells[j]

type Grid
    rows: list

fn Grid.index(self, i) -> Row
    self.rows[i]

fn sum_row(r: Row) -> int          // annotated param, used purely via []
    r[0] + r[1] + r[2]

fn main()
    let r0 = Row([1, 2, 3], 1.5)
    let r1 = Row([4, 5, 6], 2.5)
    let g = Grid([r0, r1])
    if g[1][2] != 6                 // Grid__index(g,1)=r1 -> Row__index(r1,2)=6
        print("FAIL nested g[1][2]=" + str(g[1][2]))
        exit(1)
    if g[0].tag != 1.5             // chained float field on a custom-index result (must unbox)
        print("FAIL chain g[0].tag=" + str(g[0].tag))
        exit(1)
    if sum_row(r0) != 6            // annotated-param dispatch
        print("FAIL annotated sum_row=" + str(sum_row(r0)))
        exit(1)
    print("PASS _l8_nested_test")
