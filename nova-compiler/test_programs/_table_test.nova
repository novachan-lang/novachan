// KAT for std/testing/table — table-driven testing helpers
import std/testing/table

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// Named comparator functions for table-driven tests
fn dbl(x) return x * 2
fn square(x) return x * x

fn main()
    // ── KAT 1: all rows pass — passed==3, failed==0 ─────────────────────────
    let rows1 = [[1, 2], [2, 4], [3, 6]]
    let r = ttab_run_eq(rows1, dbl)
    cki("all_pass_passed", r["passed"], 3)
    cki("all_pass_failed", r["failed"], 0)

    // ── KAT 2: ttab_all_pass true when no failures ───────────────────────────
    ckb("all_pass_flag", ttab_all_pass(r), 1)

    // ── KAT 3: one failure — passed==1, failed==1 ────────────────────────────
    let rows2 = [[1, 2], [2, 5]]
    let r2 = ttab_run_eq(rows2, dbl)
    cki("mixed_passed", r2["passed"], 1)
    cki("mixed_failed", r2["failed"], 1)

    // ── KAT 4: failures list has exactly one entry ────────────────────────────
    let fails2 = r2["failures"]
    cki("failures_len", len(fails2), 1)

    // ── KAT 5: ttab_all_pass false when there are failures ───────────────────
    ckb("mixed_flag", ttab_all_pass(r2), 0)

    // ── KAT 6: failure entry records the correct index ────────────────────────
    let fi = fails2[0]
    cki("failure_index", fi["index"], 1)

    // ── KAT 7: failure entry records actual and expected ─────────────────────
    cki("failure_actual",   fi["actual"],   4)
    cki("failure_expected", fi["expected"], 5)

    // ── KAT 8: square comparator — 4 rows all pass ───────────────────────────
    let rows3 = [[2, 4], [3, 9], [4, 16], [5, 25]]
    let r3 = ttab_run_eq(rows3, square)
    cki("square_passed", r3["passed"], 4)
    cki("square_failed", r3["failed"], 0)
    ckb("square_flag", ttab_all_pass(r3), 1)

    // ── KAT 9: empty table — zero passed, zero failed ────────────────────────
    let rows_empty = []
    let r4 = ttab_run_eq(rows_empty, dbl)
    cki("empty_passed", r4["passed"], 0)
    cki("empty_failed", r4["failed"], 0)
    ckb("empty_flag", ttab_all_pass(r4), 1)

    // ── KAT 10: all rows fail ────────────────────────────────────────────────
    let rows5 = [[1, 99], [2, 99], [3, 99]]
    let r5 = ttab_run_eq(rows5, dbl)
    cki("all_fail_passed", r5["passed"], 0)
    cki("all_fail_failed", r5["failed"], 3)
    cki("all_fail_failures_len", len(r5["failures"]), 3)
    ckb("all_fail_flag", ttab_all_pass(r5), 0)

    print("_table_test passed")

main()
