// NOVA standard library — pure-NOVA utilities built on primitives.
//
// Usage: import stdlib
//        (then call clamp(x, 0, 10), unique([1,1,2]), etc.)
//
// All functions are O(n) or better. No allocations beyond the result.

/// Clamp x to the closed interval [low, high].
fn clamp(x: int, low: int, high: int) -> int
    if x < low
        return low
    if x > high
        return high
    x

/// Linear interpolation. Returns a + (b - a) * t.
fn lerp(a: float, b: float, t: float) -> float
    a + (b - a) * t

/// Count items in the list that satisfy the predicate.
fn count_where(items: list, pred) -> int
    let n = 0
    for x in items
        if pred(x)
            n = n + 1
    n

/// Return a new list with duplicates removed (preserves first occurrence).
fn unique(items: list) -> list
    let seen = {}
    let out = []
    for x in items
        let key = str(x)
        if not contains(seen, key)
            seen[key] = 1
            push(out, x)
    out

/// Take the first n elements of a list.
fn take(items: list, n: int) -> list
    let out = []
    let i = 0
    while i < n and i < len(items)
        push(out, items[i])
        i = i + 1
    out

/// Drop the first n elements of a list.
fn drop(items: list, n: int) -> list
    let out = []
    let i = n
    while i < len(items)
        push(out, items[i])
        i = i + 1
    out

/// Flatten one level: [[1,2],[3]] -> [1,2,3].
fn flatten(lists: list) -> list
    let out = []
    for sub in lists
        for x in sub
            push(out, x)
    out

/// Partition list by predicate. Returns [matched, unmatched].
fn partition(items: list, pred) -> list
    let yes = []
    let no = []
    for x in items
        if pred(x)
            push(yes, x)
        else
            push(no, x)
    [yes, no]

/// Pad string on left with `fill` (1 char) to reach `width`.
/// Renamed from pad_left to avoid collision with built-in (int fill char).
fn str_pad_left(s: string, width: int, fill: string) -> string
    let pad = ""
    let need = width - len(s)
    while len(pad) < need
        pad = pad + fill
    pad + s

/// Pad string on right with `fill` (1 char) to reach `width`.
fn str_pad_right(s: string, width: int, fill: string) -> string
    let pad = ""
    let need = width - len(s)
    while len(pad) < need
        pad = pad + fill
    s + pad

/// True iff c is a single ASCII digit character.
fn is_digit_char(c: string) -> bool
    if len(c) != 1
        return false
    let o = ord(c)
    o >= 48 and o <= 57

/// True iff c is a single ASCII letter character.
fn is_alpha_char(c: string) -> bool
    if len(c) != 1
        return false
    let o = ord(c)
    (o >= 65 and o <= 90) or (o >= 97 and o <= 122)

/// True iff c is a single ASCII whitespace character.
fn is_space_char(c: string) -> bool
    if len(c) != 1
        return false
    c == " " or c == "\t" or c == "\n" or c == "\r"

/// Return a list with n copies of value.
fn repeat_value(value, n: int) -> list
    let out = []
    let i = 0
    while i < n
        push(out, value)
        i = i + 1
    out

/// Abort with a message. Use for unrecoverable errors.
fn panic(msg: string)
    print("panic: " + msg)
    exit(1)

/// Ceiling integer division: ceil(a / b) for positive a, b.
fn div_ceil(a: int, b: int) -> int
    (a + b - 1) / b

/// Greatest common divisor (Euclid's algorithm).
fn gcd(a: int, b: int) -> int
    if b == 0
        return a
    gcd(b, a - (a / b) * b)

/// Least common multiple. 0 if either input is 0.
fn lcm(a: int, b: int) -> int
    if a == 0 or b == 0
        return 0
    let g = gcd(a, b)
    (a / g) * b

/// Sum integers in a list. (sum() built-in handles list<int>; this matches.)
fn sum_ints(xs: list) -> int
    let total = 0
    for x in xs
        total = total + x
    total

/// Arithmetic mean of an integer list (truncating int division).
fn average(xs: list) -> int
    let n = len(xs)
    if n == 0
        return 0
    sum_ints(xs) / n

/// Last element of a list. Aborts if empty.
fn last(items: list)
    if len(items) == 0
        panic("last() called on empty list")
    items[len(items) - 1]

/// First element of a list. Aborts if empty.
fn first(items: list)
    if len(items) == 0
        panic("first() called on empty list")
    items[0]

/// Swap first and second elements of a 2-element list. For tuples.
fn swap_pair(pair: list) -> list
    [pair[1], pair[0]]

/// Build [start, start+step, start+2*step, ..., < stop].
fn range_step(start: int, stop: int, step: int) -> list
    let out = []
    let i = start
    if step == 0
        return out
    if step > 0
        while i < stop
            push(out, i)
            i = i + step
    else
        while i > stop
            push(out, i)
            i = i + step
    out

/// True iff all elements satisfy the predicate.
fn every(items: list, pred) -> bool
    for x in items
        if not pred(x)
            return false
    true

/// True iff at least one element satisfies the predicate.
/// Renamed from `some` to avoid collision with built-in.
fn some_match(items: list, pred) -> bool
    for x in items
        if pred(x)
            return true
    false

/// Apply fn to each element, ignore returns (for side effects).
fn for_each(items: list, fn_arg)
    for x in items
        fn_arg(x)
