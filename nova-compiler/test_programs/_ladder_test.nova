import std/game/ladder

fn chk_int(name: string, got: int, want: int)
    if got != want
        print("FAIL ladder " + name + ": got " + str(got) + " want " + str(want))
        exit(1)

fn test_win_swap()
    // ladder [1,2,3,4]; challenger at pos 2 (id=3) beats defender at pos 0 (id=1).
    // Result: [3,2,1,4] — pos 0 and pos 2 swapped.
    let lad = []
    push(lad, 1)
    push(lad, 2)
    push(lad, 3)
    push(lad, 4)
    let result = ladder_challenge(lad, 2, 0, true)
    chk_int("win_swap len", len(result), 4)
    chk_int("win_swap pos0", result[0], 3)
    chk_int("win_swap pos1", result[1], 2)
    chk_int("win_swap pos2", result[2], 1)
    chk_int("win_swap pos3", result[3], 4)

fn test_loss_unchanged()
    // Same ladder; challenger at pos 2 loses — ladder unchanged.
    let lad = []
    push(lad, 1)
    push(lad, 2)
    push(lad, 3)
    push(lad, 4)
    let result = ladder_challenge(lad, 2, 0, false)
    chk_int("loss pos0", result[0], 1)
    chk_int("loss pos1", result[1], 2)
    chk_int("loss pos2", result[2], 3)
    chk_int("loss pos3", result[3], 4)

fn test_adjacent_swap()
    // challenger at pos 1 beats defender at pos 0: adjacent swap.
    let lad = []
    push(lad, 10)
    push(lad, 20)
    push(lad, 30)
    let result = ladder_challenge(lad, 1, 0, true)
    chk_int("adj pos0", result[0], 20)
    chk_int("adj pos1", result[1], 10)
    chk_int("adj pos2", result[2], 30)

fn test_rank()
    let lad = []
    push(lad, 5)
    push(lad, 3)
    push(lad, 7)
    push(lad, 1)
    chk_int("rank id=5", ladder_rank(lad, 5), 0)
    chk_int("rank id=3", ladder_rank(lad, 3), 1)
    chk_int("rank id=7", ladder_rank(lad, 7), 2)
    chk_int("rank id=1", ladder_rank(lad, 1), 3)
    chk_int("rank missing", ladder_rank(lad, 99), -1)

fn test_rank_after_swap()
    // After a win swap, ranks should reflect new positions.
    let lad = []
    push(lad, 1)
    push(lad, 2)
    push(lad, 3)
    push(lad, 4)
    let result = ladder_challenge(lad, 2, 0, true)
    chk_int("post-swap rank3", ladder_rank(result, 3), 0)
    chk_int("post-swap rank1", ladder_rank(result, 1), 2)

fn test_no_upward_move()
    // If chal_pos < def_pos (defender is lower ranked), no swap even if wins=true.
    let lad = []
    push(lad, 1)
    push(lad, 2)
    push(lad, 3)
    let result = ladder_challenge(lad, 0, 2, true)
    chk_int("no_up pos0", result[0], 1)
    chk_int("no_up pos1", result[1], 2)
    chk_int("no_up pos2", result[2], 3)

fn main()
    test_win_swap()
    test_loss_unchanged()
    test_adjacent_swap()
    test_rank()
    test_rank_after_swap()
    test_no_upward_move()
    print("PASS _ladder_test")
