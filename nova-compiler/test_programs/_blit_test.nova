import std/raster/blit

fn cki(label, got, want)
    if got != want
        print("FAIL blit " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── KAT 1: bt_new creates correct size surface ────────────────────────────
    let s1 = bt_new(3, 2, 5)
    cki("new_w", s1["w"], 3)
    cki("new_h", s1["h"], 2)
    cki("new_px0", bt_get(s1, 0, 0), 5)
    cki("new_px_last", bt_get(s1, 2, 1), 5)

    // ── KAT 2: bt_get out-of-bounds returns 0 ────────────────────────────────
    cki("get_oob_neg", bt_get(s1, -1, 0), 0)
    cki("get_oob_w", bt_get(s1, 3, 0), 0)
    cki("get_oob_h", bt_get(s1, 0, 2), 0)

    // ── KAT 3: bt_set writes pixel correctly ─────────────────────────────────
    let s3 = bt_new(3, 3, 0)
    bt_set(s3, 1, 1, 42)
    cki("set_center", bt_get(s3, 1, 1), 42)
    cki("set_neighbour_unchanged", bt_get(s3, 0, 0), 0)
    bt_set(s3, 100, 100, 99)
    cki("set_oob_noop", bt_get(s3, 0, 0), 0)

    // ── KAT 4: bt_blit copies src onto dst ───────────────────────────────────
    let dst = bt_new(4, 4, 0)
    let src = bt_new(2, 2, 7)
    bt_blit(dst, src, 1, 1)
    cki("blit_1_1", bt_get(dst, 1, 1), 7)
    cki("blit_2_1", bt_get(dst, 2, 1), 7)
    cki("blit_1_2", bt_get(dst, 1, 2), 7)
    cki("blit_2_2", bt_get(dst, 2, 2), 7)
    cki("blit_0_0_untouched", bt_get(dst, 0, 0), 0)
    cki("blit_3_3_untouched", bt_get(dst, 3, 3), 0)

    // ── KAT 5: bt_blit clipped at boundary — only corner pixel lands ──────────
    let dst2 = bt_new(4, 4, 0)
    let src2 = bt_new(2, 2, 7)
    bt_blit(dst2, src2, 3, 3)
    cki("blit_clip_3_3", bt_get(dst2, 3, 3), 7)
    cki("blit_clip_no_crash", bt_get(dst2, 0, 0), 0)

    // ── KAT 6: bt_blit_transparent skips transparent colour ──────────────────
    let dst3 = bt_new(4, 4, 0)
    let src3 = bt_new(2, 2, 0)
    bt_set(src3, 1, 0, 5)
    bt_set(src3, 0, 1, 8)
    bt_blit_transparent(dst3, src3, 0, 0, 0)
    cki("blit_transp_skip_0_0", bt_get(dst3, 0, 0), 0)
    cki("blit_transp_keep_1_0", bt_get(dst3, 1, 0), 5)
    cki("blit_transp_keep_0_1", bt_get(dst3, 0, 1), 8)

    // ── KAT 7: bt_blit_region copies sub-rectangle ───────────────────────────
    let src4 = bt_new(4, 4, 0)
    bt_set(src4, 2, 1, 11)
    bt_set(src4, 3, 1, 22)
    bt_set(src4, 2, 2, 33)
    bt_set(src4, 3, 2, 44)
    let dst4 = bt_new(3, 3, 0)
    bt_blit_region(dst4, src4, 2, 1, 2, 2, 0, 0)
    cki("region_0_0", bt_get(dst4, 0, 0), 11)
    cki("region_1_0", bt_get(dst4, 1, 0), 22)
    cki("region_0_1", bt_get(dst4, 0, 1), 33)
    cki("region_1_1", bt_get(dst4, 1, 1), 44)

    // ── KAT 8: bt_copy is independent clone ──────────────────────────────────
    let orig = bt_new(2, 2, 3)
    let clone = bt_copy(orig)
    bt_set(clone, 0, 0, 99)
    cki("copy_orig_unchanged", bt_get(orig, 0, 0), 3)
    cki("copy_clone_changed", bt_get(clone, 0, 0), 99)

    // ── KAT 9: bt_fill_region fills correctly ────────────────────────────────
    let sf = bt_new(4, 4, 0)
    bt_fill_region(sf, 0, 0, 2, 2, 9)
    cki("fill_0_0", bt_get(sf, 0, 0), 9)
    cki("fill_1_0", bt_get(sf, 1, 0), 9)
    cki("fill_0_1", bt_get(sf, 0, 1), 9)
    cki("fill_1_1", bt_get(sf, 1, 1), 9)
    cki("fill_2_0_untouched", bt_get(sf, 2, 0), 0)
    cki("fill_0_2_untouched", bt_get(sf, 0, 2), 0)

    // ── KAT 10: bt_fill_region clipped ───────────────────────────────────────
    let sf2 = bt_new(3, 3, 0)
    bt_fill_region(sf2, 2, 2, 5, 5, 7)
    cki("fill_clip_2_2", bt_get(sf2, 2, 2), 7)
    cki("fill_clip_0_0_untouched", bt_get(sf2, 0, 0), 0)

    // ── KAT 11: bt_flip_h of 2x2 [[1,2],[3,4]] gives [[2,1],[4,3]] ───────────
    let fh = bt_new(2, 2, 0)
    bt_set(fh, 0, 0, 1)
    bt_set(fh, 1, 0, 2)
    bt_set(fh, 0, 1, 3)
    bt_set(fh, 1, 1, 4)
    let fhr = bt_flip_h(fh)
    cki("flip_h_0_0", bt_get(fhr, 0, 0), 2)
    cki("flip_h_1_0", bt_get(fhr, 1, 0), 1)
    cki("flip_h_0_1", bt_get(fhr, 0, 1), 4)
    cki("flip_h_1_1", bt_get(fhr, 1, 1), 3)

    // ── KAT 12: bt_flip_v of 2x2 [[1,2],[3,4]] gives [[3,4],[1,2]] ───────────
    let fv = bt_new(2, 2, 0)
    bt_set(fv, 0, 0, 1)
    bt_set(fv, 1, 0, 2)
    bt_set(fv, 0, 1, 3)
    bt_set(fv, 1, 1, 4)
    let fvr = bt_flip_v(fv)
    cki("flip_v_0_0", bt_get(fvr, 0, 0), 3)
    cki("flip_v_1_0", bt_get(fvr, 1, 0), 4)
    cki("flip_v_0_1", bt_get(fvr, 0, 1), 1)
    cki("flip_v_1_1", bt_get(fvr, 1, 1), 2)

    // ── KAT 13: flip_h is its own inverse ────────────────────────────────────
    let fh2 = bt_new(3, 2, 0)
    bt_set(fh2, 0, 0, 10)
    bt_set(fh2, 1, 0, 20)
    bt_set(fh2, 2, 0, 30)
    bt_set(fh2, 0, 1, 40)
    bt_set(fh2, 1, 1, 50)
    bt_set(fh2, 2, 1, 60)
    let fh2a = bt_flip_h(fh2)
    let fh2b = bt_flip_h(fh2a)
    cki("flip_h_inv_0_0", bt_get(fh2b, 0, 0), 10)
    cki("flip_h_inv_2_1", bt_get(fh2b, 2, 1), 60)

    // ── KAT 14: bt_blit fully off-surface (negative offset) — no crash ────────
    let dst5 = bt_new(4, 4, 0)
    let src5 = bt_new(2, 2, 3)
    bt_blit(dst5, src5, -10, -10)
    cki("blit_offscreen_neg_0_0", bt_get(dst5, 0, 0), 0)

    // ── KAT 15: bt_blit_region with clipping on source and dest ──────────────
    let big = bt_new(6, 6, 1)
    let sm = bt_new(4, 4, 2)
    bt_blit_region(big, sm, 0, 0, 4, 4, 4, 4)
    cki("region_clip_4_4", bt_get(big, 4, 4), 2)
    cki("region_clip_5_4", bt_get(big, 5, 4), 2)
    cki("region_clip_4_5", bt_get(big, 4, 5), 2)
    cki("region_clip_5_5", bt_get(big, 5, 5), 2)
    cki("region_clip_3_3_untouched", bt_get(big, 3, 3), 1)

    print("PASS _blit_test")
