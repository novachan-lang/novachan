import std/math/gcd_list

fn main()
    // ---- gl_gcd KAT ----
    // gl_gcd([12,18,24]) = 6
    let r1 = gl_gcd([12, 18, 24])
    if r1 != 6
        print("FAIL gl_gcd([12,18,24]): expected 6 got " + str(r1))
        exit(1)

    // gl_gcd([7]) = 7
    let r2 = gl_gcd([7])
    if r2 != 7
        print("FAIL gl_gcd([7]): expected 7 got " + str(r2))
        exit(1)

    // gl_gcd([]) = 0
    let r3 = gl_gcd([])
    if r3 != 0
        print("FAIL gl_gcd([]): expected 0 got " + str(r3))
        exit(1)

    // gl_gcd([17,13]) = 1
    let r4 = gl_gcd([17, 13])
    if r4 != 1
        print("FAIL gl_gcd([17,13]): expected 1 got " + str(r4))
        exit(1)

    // gl_gcd([100,75,50]) = 25
    let r5 = gl_gcd([100, 75, 50])
    if r5 != 25
        print("FAIL gl_gcd([100,75,50]): expected 25 got " + str(r5))
        exit(1)

    // ---- gl_lcm KAT ----
    // gl_lcm([4,6]) = 12
    let r6 = gl_lcm([4, 6])
    if r6 != 12
        print("FAIL gl_lcm([4,6]): expected 12 got " + str(r6))
        exit(1)

    // gl_lcm([2,3,4]) = 12
    let r7 = gl_lcm([2, 3, 4])
    if r7 != 12
        print("FAIL gl_lcm([2,3,4]): expected 12 got " + str(r7))
        exit(1)

    // gl_lcm([]) = 1
    let r8 = gl_lcm([])
    if r8 != 1
        print("FAIL gl_lcm([]): expected 1 got " + str(r8))
        exit(1)

    // ---- gl_coprime_all KAT ----
    // gl_coprime_all([9,16]) = true  (gcd=1)
    let r9 = gl_coprime_all([9, 16])
    if r9 != true
        print("FAIL gl_coprime_all([9,16]): expected true")
        exit(1)

    // gl_coprime_all([6,9]) = false  (gcd=3)
    let r10 = gl_coprime_all([6, 9])
    if r10 != false
        print("FAIL gl_coprime_all([6,9]): expected false")
        exit(1)

    // ---- gl_gcd2 / gl_lcm2 pair helpers ----
    // gl_gcd2(48, 18) = 6   hand: 48%18=12; 18%12=6; 12%6=0 -> 6
    let r11 = gl_gcd2(48, 18)
    if r11 != 6
        print("FAIL gl_gcd2(48,18): expected 6 got " + str(r11))
        exit(1)

    // gl_gcd2 with negatives: gl_gcd2(-12, 8) = 4
    let r12 = gl_gcd2(-12, 8)
    if r12 != 4
        print("FAIL gl_gcd2(-12,8): expected 4 got " + str(r12))
        exit(1)

    // gl_lcm2(4, 6) = 12
    let r13 = gl_lcm2(4, 6)
    if r13 != 12
        print("FAIL gl_lcm2(4,6): expected 12 got " + str(r13))
        exit(1)

    // gl_lcm2(0, 5) = 0
    let r14 = gl_lcm2(0, 5)
    if r14 != 0
        print("FAIL gl_lcm2(0,5): expected 0 got " + str(r14))
        exit(1)

    print("_gcd_list_test passed")
