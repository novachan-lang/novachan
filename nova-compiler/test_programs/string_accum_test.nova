type Token
    kind: string
    value: string

let tokens = []
let current = ""
let input = "ab cd"
let i = 0
while i < len(input)
    let ch = input[i]
    if ch == " "
        if len(current) > 0
            push(tokens, Token("word", current))
            current = ""
    else
        current = current + ch
    i = i + 1
if len(current) > 0
    push(tokens, Token("word", current))

print("count: " + str(len(tokens)))
match tokens[0]
    Token(kind, value) =>
        print("t0: " + kind + " " + value)
match tokens[1]
    Token(kind, value) =>
        print("t1: " + kind + " " + value)
