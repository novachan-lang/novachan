import forge_resource_quota

fn main()
    let r = rq_new()
    r = rq_set_quota(r, "cpu", 100)
    r = rq_set_quota(r, "memory", 1024)

    let c1 = rq_consume(r, "cpu", 30)
    r = c1["r"]
    assert(c1["ok"] == 1, "cpu 30 ok")
    assert(rq_usage(r, "cpu") == 30, "30 used")
    assert(rq_remaining(r, "cpu") == 70, "70 remaining")
    assert(rq_utilization(r, "cpu") == 30, "30% util")

    let c2 = rq_consume(r, "cpu", 80)
    r = c2["r"]
    assert(c2["ok"] == 0, "cpu 80 exceeds")
    assert(c2["reason"] == "exceeded", "exceeded reason")

    let c3 = rq_consume(r, "cpu", 70)
    r = c3["r"]
    assert(c3["ok"] == 1, "cpu 70 ok (total 100)")
    assert(rq_utilization(r, "cpu") == 100, "100% util")

    r = rq_release(r, "cpu", 50)
    assert(rq_usage(r, "cpu") == 50, "50 after release")

    let c4 = rq_consume(r, "unknown", 10)
    r = c4["r"]
    assert(c4["ok"] == 0, "no quota = fail")
    assert(c4["reason"] == "no_quota", "no_quota reason")

    print("RESOURCE-QUOTA KAT PASS")
