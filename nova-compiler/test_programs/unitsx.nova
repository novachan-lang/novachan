// unitsx — dimensional analysis. A Quantity carries a value plus a 7-element SI
// dimension vector [Length, Mass, Time, Current, Temperature, Amount, Luminosity].
// Same-dimension-only add/sub; mul/div combine dimensions; comparisons require a
// matching dimension. Catches unit-mismatch bugs (the Mars Climate Orbiter class) at
// the value level. (Future: compile-time dimension checking via newtypes.)

type Quantity
    value: float
    dims: list

fn _dims_add(a, b)
    let out = []
    let i = 0
    while i < 7
        push(out, a[i] + b[i])
        i = i + 1
    return out

fn _dims_sub(a, b)
    let out = []
    let i = 0
    while i < 7
        push(out, a[i] - b[i])
        i = i + 1
    return out

fn quantity(v, dims) -> Quantity
    return Quantity(v, dims)

// base-unit constructors
fn meters(v) -> Quantity
    return Quantity(v, [1, 0, 0, 0, 0, 0, 0])
fn kilograms(v) -> Quantity
    return Quantity(v, [0, 1, 0, 0, 0, 0, 0])
fn seconds(v) -> Quantity
    return Quantity(v, [0, 0, 1, 0, 0, 0, 0])
fn scalar(v) -> Quantity
    return Quantity(v, [0, 0, 0, 0, 0, 0, 0])

fn q_compatible(a, b) -> bool
    return a.dims == b.dims

fn q_add(a, b) -> Quantity
    return Quantity(a.value + b.value, a.dims)          // caller ensures compatible
fn q_sub(a, b) -> Quantity
    return Quantity(a.value - b.value, a.dims)
fn q_mul(a, b) -> Quantity
    return Quantity(a.value * b.value, _dims_add(a.dims, b.dims))
fn q_div(a, b) -> Quantity
    return Quantity(a.value / b.value, _dims_sub(a.dims, b.dims))
fn q_scale(a, k) -> Quantity
    return Quantity(a.value * k, a.dims)

fn q_eq(a, b) -> bool
    return a.dims == b.dims and a.value == b.value

fn to_value(q) -> float
    return q.value
fn dims_of(q) -> list
    return q.dims

fn main()
    // same-dimension add
    let d = q_add(meters(5.0), meters(3.0))
    assert_eq(to_value(d), 8.0)
    assert_eq(dims_of(d), [1, 0, 0, 0, 0, 0, 0])

    // dimensional safety: metres and seconds are NOT compatible
    let ok = 0
    if q_compatible(meters(5.0), seconds(3.0))
        ok = 1
    assert_eq(ok, 0)
    // ...but metres and metres are
    let ok2 = 0
    if q_compatible(meters(5.0), meters(1.0))
        ok2 = 1
    assert_eq(ok2, 1)

    // derived units emerge from mul/div: 10 m / 2 s = 5 m/s (velocity)
    let velocity = q_div(meters(10.0), seconds(2.0))
    assert_eq(to_value(velocity), 5.0)
    assert_eq(dims_of(velocity), [1, 0, -1, 0, 0, 0, 0])

    // force = mass * acceleration = kg * (m/s^2) -> kg·m·s^-2 (newtons)
    let accel = q_div(meters(10.0), q_mul(seconds(1.0), seconds(1.0)))
    let force = q_mul(kilograms(2.0), accel)
    assert_eq(to_value(force), 20.0)
    assert_eq(dims_of(force), [1, 1, -2, 0, 0, 0, 0])

    // area = m * m -> m^2
    let area = q_mul(meters(3.0), meters(4.0))
    assert_eq(to_value(area), 12.0)
    assert_eq(dims_of(area), [2, 0, 0, 0, 0, 0, 0])

    print("unitsx passed")
