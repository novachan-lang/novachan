// PROBE: do NOVA's HOFs / comprehensions compose with Result + `?`?
// This decides the idiom for all Prism code. Each block is independent so a
// compile failure names exactly which construct is unsupported.

fn mk(s: string) -> Result<string>
    if len(s) == 0
        return err("empty")
    ok("<" + s + ">")

fn plain(s: string) -> string
    "[" + s + "]"

// P1 — map with a lambda that returns Result (no `?`): expect list of Results
fn p1() -> int
    let rs = ["a", "b"].map(fn(s) mk(s))
    print("P1 len={len(rs)} first_ok={is_ok(rs[0])}")
    len(rs)

// P2 — map with a lambda calling `?` INSIDE the lambda.
// The open question: does `?` propagate out of the ENCLOSING fn, or is it illegal here?
fn p2() -> Result<list>
    let rs = ["a", "b"].map(fn(s) mk(s)?)
    ok(rs)

// P3 — list comprehension over a plain (non-Result) fn
fn p3() -> int
    let xs = [plain(s) for s in ["a", "b", "c"]]
    print("P3 {xs[0]} {xs[1]} {xs[2]}")
    len(xs)

// P4 — comprehension with `?` inside
fn p4() -> Result<list>
    let xs = [mk(s)? for s in ["a", "b"]]
    ok(xs)

// P5 — zip + map, the parallel-list case Prism keeps hand-rolling
fn p5() -> int
    let pairs = ["x", "y"].zip([1, 2])
    let out = pairs.map(fn(p) "{p[0]}={p[1]}")
    print("P5 {out[0]} {out[1]}")
    len(out)

// P6 — unwrap inside the lambda, validate BEFORE mapping (the safe idiom if `?` fails)
fn p6() -> Result<list>
    let names = ["a", "b"]
    for n in names
        if len(n) == 0
            return err("bad")
    ok(names.map(fn(s) unwrap(mk(s))))

// P7 — filter + map chained
fn p7() -> int
    let out = [1, 2, 3, 4, 5, 6].filter(fn(n) n % 2 == 0).map(fn(n) n * 10)
    print("P7 len={len(out)} first={out[0]}")
    len(out)

// P8 — pipe operator with lambdas
fn p8() -> int
    let out = [1, 2, 3, 4, 5] |> filter(fn(x) x > 2) |> map(fn(x) x * 10)
    print("P8 len={len(out)}")
    len(out)

fn main()
    print("== PROBE hof + Result ==")
    print("P1 map(->Result) count = {p1()}")

    let r2 = p2()
    print("P2 map with ? inside lambda: is_ok={is_ok(r2)}")
    if is_ok(r2)
        let l2 = unwrap(r2)
        print("P2 len={len(l2)} v0={l2[0]}")
    else
        print("P2 err={unwrap_err(r2)}")

    print("P3 comprehension count = {p3()}")

    let r4 = p4()
    print("P4 comprehension with ?: is_ok={is_ok(r4)}")
    if is_ok(r4)
        let l4 = unwrap(r4)
        print("P4 len={len(l4)} v0={l4[0]}")
    else
        print("P4 err={unwrap_err(r4)}")

    print("P5 zip+map count = {p5()}")

    let r6 = p6()
    print("P6 validate-then-map: is_ok={is_ok(r6)}")
    if is_ok(r6)
        let l6 = unwrap(r6)
        print("P6 len={len(l6)} v0={l6[0]}")

    print("P7 filter+map count = {p7()}")
    print("P8 pipe count = {p8()}")
    print("== PROBE DONE ==")
