import forge_alert_engine
fn main()
    let s = ae_new()
    s = ae_add_rule(s, "cpu-high", "cpu", "gt", 90)
    s = ae_add_rule(s, "cpu-low", "cpu", "lt", 10)
    s = ae_add_rule(s, "mem-exact", "mem", "eq", 50)
    s = ae_add_rule(s, "disk-ge", "disk", "gte", 80)
    s = ae_add_rule(s, "disk-le", "disk", "lte", 20)
    s = ae_add_rule(s, "typo-op", "cpu", "GREATER", 5)
    print("rules=" + str(ae_rule_count(s)) + " names=" + ae_rule_names(s))
    for v in [95, 5, 50, 90]
        _ = ae_check(s, "cpu", v)
        print("cpu=" + str(v) + " alerts=" + str(ae_alert_count(s)) + " last=" + str(unwrap_or(ae_last_triggered(s), "-")))
    for v in [50, 49]
        _ = ae_check(s, "mem", v)
        print("mem=" + str(v) + " alerts=" + str(ae_alert_count(s)))
    for v in [80, 20, 50]
        _ = ae_check(s, "disk", v)
        print("disk=" + str(v) + " alerts=" + str(ae_alert_count(s)))
    print("checks=" + str(ae_check_count(s)))
    print("cpu-high fired=" + str(unwrap_or(ae_rule_alerts(s, "cpu-high"), 0 - 1)))
    print("typo-op fired=" + str(unwrap_or(ae_rule_alerts(s, "typo-op"), 0 - 1)))
    print("missing=" + str(is_err(ae_rule_alerts(s, "nope"))))
    print("unknown metric: " + str(is_ok(ae_check(s, "nosuch", 1))))
    print("EXERCISE-DONE")
