import std/greedy/assign_cookies

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _assign_cookies_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── ac_max_content ──────────────────────────────────────────────────────
    // KAT vectors from spec:
    // greed=[1,2,3] sizes=[1,1]: only 1 cookie of size 1 -> satisfies child with greed=1
    cki("spec1", ac_max_content([1, 2, 3], [1, 1]), 1)
    // greed=[1,2] sizes=[1,2,3]: both children satisfied
    cki("spec2", ac_max_content([1, 2], [1, 2, 3]), 2)
    // greed=[10,9,8,7] sizes=[5,6,7,8]: sorted greed=[7,8,9,10], sorted sizes=[5,6,7,8]
    //   7<=8 yes, 8<=7? no. 8<=8 yes, 9<=? no more cookies. count=2
    cki("spec3", ac_max_content([10, 9, 8, 7], [5, 6, 7, 8]), 2)
    // empty greed => 0
    cki("spec4", ac_max_content([], [1, 2]), 0)
    // empty sizes => 0
    cki("spec5", ac_max_content([1, 2, 3], []), 0)
    // additional cases:
    // all greed=1, plenty of cookies
    cki("all_ones", ac_max_content([1, 1, 1], [1, 2, 3]), 3)
    // single child, exact cookie
    cki("single_exact", ac_max_content([5], [5]), 1)
    // single child, cookie too small
    cki("single_small", ac_max_content([5], [4]), 0)
    // cookies smaller than all greed
    cki("all_small", ac_max_content([3, 4, 5], [1, 2]), 0)
    // more cookies than children, all satisfied
    cki("surplus", ac_max_content([1, 2], [3, 3, 3]), 2)
    // one child, no cookie
    cki("one_no_cookie", ac_max_content([1], []), 0)
    // greed and sizes same single element equal
    cki("equal_single", ac_max_content([7], [7]), 1)

    print("PASS _assign_cookies_test")
