// KAT test for std/text/kmp
import std/text/kmp

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got [" + got + "] expected [" + expected + "]")
        exit(1)

// ckl: check list equality by verifying length then each element.
fn ckl_len(label, got_len, exp_len)
    if got_len != exp_len
        print("FAIL " + label + " (len): got " + str(got_len) + " expected " + str(exp_len))
        exit(1)

fn ckl_elem(label, got_elem, exp_elem, idx)
    if got_elem != exp_elem
        print("FAIL " + label + " [" + str(idx) + "]: got " + str(got_elem) + " expected " + str(exp_elem))
        exit(1)

fn main()
    // ── km_failure ──────────────────────────────────────────────────────────
    // KAT: km_failure("abab") == [0,0,1,2]
    let f1 = km_failure("abab")
    ckl_len("fail_abab_len", len(f1), 4)
    ckl_elem("fail_abab_0", f1[0], 0, 0)
    ckl_elem("fail_abab_1", f1[1], 0, 1)
    ckl_elem("fail_abab_2", f1[2], 1, 2)
    ckl_elem("fail_abab_3", f1[3], 2, 3)

    // km_failure("aabaa") == [0,1,0,1,2]  (additional vector)
    let f2 = km_failure("aabaa")
    ckl_len("fail_aabaa_len", len(f2), 5)
    ckl_elem("fail_aabaa_0", f2[0], 0, 0)
    ckl_elem("fail_aabaa_1", f2[1], 1, 1)
    ckl_elem("fail_aabaa_2", f2[2], 0, 2)
    ckl_elem("fail_aabaa_3", f2[3], 1, 3)
    ckl_elem("fail_aabaa_4", f2[4], 2, 4)

    // km_failure("abcaby") == [0,0,0,1,2,0]
    let f3 = km_failure("abcaby")
    ckl_len("fail_abcaby_len", len(f3), 6)
    ckl_elem("fail_abcaby_0", f3[0], 0, 0)
    ckl_elem("fail_abcaby_1", f3[1], 0, 1)
    ckl_elem("fail_abcaby_2", f3[2], 0, 2)
    ckl_elem("fail_abcaby_3", f3[3], 1, 3)
    ckl_elem("fail_abcaby_4", f3[4], 2, 4)
    ckl_elem("fail_abcaby_5", f3[5], 0, 5)

    // ── km_search ───────────────────────────────────────────────────────────
    // KAT: km_search("abxabcabcaby","abcaby") == 6
    cki("search_abcaby",        km_search("abxabcabcaby", "abcaby"), 6)

    // KAT: km_search("hello","ll") == 2
    cki("search_ll",            km_search("hello", "ll"), 2)

    // KAT: km_search("abc","xyz") == -1
    cki("search_absent",        km_search("abc", "xyz"), -1)

    // KAT: km_search("abc","") == 0  (empty pattern)
    cki("search_empty_pat",     km_search("abc", ""), 0)

    // Additional: first occurrence in repeated pattern
    cki("search_first",         km_search("abababab", "abab"), 0)

    // Additional: match at very end
    cki("search_end",           km_search("xyzabc", "abc"), 3)

    // ── km_search_all ───────────────────────────────────────────────────────
    // KAT: km_search_all("aaaa","aa") == [0,1,2]
    let sa1 = km_search_all("aaaa", "aa")
    ckl_len("search_all_aaaa_len", len(sa1), 3)
    ckl_elem("search_all_aaaa_0",  sa1[0], 0, 0)
    ckl_elem("search_all_aaaa_1",  sa1[1], 1, 1)
    ckl_elem("search_all_aaaa_2",  sa1[2], 2, 2)

    // Additional: no occurrences
    let sa2 = km_search_all("hello", "xyz")
    ckl_len("search_all_absent_len", len(sa2), 0)

    // Additional: multiple non-overlapping
    let sa3 = km_search_all("abcabc", "abc")
    ckl_len("search_all_abcabc_len", len(sa3), 2)
    ckl_elem("search_all_abcabc_0",  sa3[0], 0, 0)
    ckl_elem("search_all_abcabc_1",  sa3[1], 3, 1)

    // ── km_count ────────────────────────────────────────────────────────────
    // KAT: km_count("aaaa","aa") == 3
    cki("count_aaaa_aa",        km_count("aaaa", "aa"), 3)

    // Additional: absent pattern
    cki("count_absent",         km_count("hello", "xyz"), 0)

    // Additional: whole-string match
    cki("count_exact",          km_count("abc", "abc"), 1)

    // Additional: non-overlapping repeats
    cki("count_abcabc",         km_count("abcabc", "abc"), 2)

    print("_kmp_test passed")
