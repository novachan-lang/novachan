fn migration_new(version, description, up_fn, down_fn)
  let m = {}
  m["version"] = version
  m["description"] = description
  m["up"] = up_fn
  m["down"] = down_fn
  m

fn migration_runner()
  let runner = {}
  runner["migrations"] = []
  runner["applied"] = []
  runner["log"] = []
  runner

fn mr_add(runner, migration)
  push(runner["migrations"], migration)

fn mr_up(runner)
  let migrations = runner["migrations"]
  let applied = runner["applied"]
  let log_list = runner["log"]
  let results = []
  for m in migrations
    let ver = m["version"]
    let already = 0
    for a in applied
      if a == ver
        already = 1
    if already == 0
      let up_fn = m["up"]
      let result = up_fn(ver)
      push(applied, ver)
      push(log_list, "UP " + str(ver) + ": " + str(m["description"]))
      push(results, [ver, result])
  results

fn mr_down(runner, target_version)
  let applied = runner["applied"]
  let migrations = runner["migrations"]
  let log_list = runner["log"]
  let rolled = []
  let new_applied = []
  let i = len(applied) - 1
  while i >= 0
    let ver = applied[i]
    if ver > target_version
      let mi = 0
      while mi < len(migrations)
        let m = migrations[mi]
        if m["version"] == ver
          let down_fn = m["down"]
          let _r = down_fn(ver)
          push(log_list, "DOWN " + str(ver) + ": " + str(m["description"]))
          push(rolled, ver)
        mi = mi + 1
    else
      push(new_applied, ver)
    i = i - 1
  runner["applied"] = new_applied
  rolled

fn mr_current(runner)
  let applied = runner["applied"]
  if len(applied) == 0
    return 0
  applied[len(applied) - 1]

fn mr_pending(runner)
  let migrations = runner["migrations"]
  let applied = runner["applied"]
  let pending = []
  for m in migrations
    let ver = m["version"]
    let found = 0
    for a in applied
      if a == ver
        found = 1
    if found == 0
      push(pending, m)
  pending

fn _up1(v)
  "created users table"

fn _down1(v)
  "dropped users table"

fn _up2(v)
  "added email column"

fn _down2(v)
  "removed email column"

fn _up3(v)
  "created orders table"

fn _down3(v)
  "dropped orders table"

fn main()
  let r = migration_runner()
  mr_add(r, migration_new(1, "create users", fn(z) _up1(z), fn(z) _down1(z)))
  mr_add(r, migration_new(2, "add email", fn(z) _up2(z), fn(z) _down2(z)))
  mr_add(r, migration_new(3, "create orders", fn(z) _up3(z), fn(z) _down3(z)))

  assert(mr_current(r) == 0, "initial version 0")
  assert(len(mr_pending(r)) == 3, "3 pending")

  let results = mr_up(r)
  assert(len(results) == 3, "applied 3")
  assert(mr_current(r) == 3, "now at version 3")
  assert(len(mr_pending(r)) == 0, "none pending")

  let results2 = mr_up(r)
  assert(len(results2) == 0, "no-op on repeat")

  let rolled = mr_down(r, 1)
  assert(len(rolled) == 2, "rolled back 2")
  assert(mr_current(r) == 1, "now at version 1")
  assert(len(mr_pending(r)) == 2, "2 pending again")

  let log_list = r["log"]
  assert(len(log_list) == 5, "5 log entries: 3 up + 2 down")
  assert(starts_with(log_list[0], "UP 1"), "log: up 1")
  assert(starts_with(log_list[3], "DOWN 3"), "log: down 3")

  print("migrationx: all passed")
