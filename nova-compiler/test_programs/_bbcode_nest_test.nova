// KAT test for std/text/bbcode_nest
import std/text/bbcode_nest

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got [" + got + "] want [" + want + "]")
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // KAT 1: max_depth — single flat tag
    cki("depth_flat", bnst_max_depth("[b]hi[/b]"), 1)

    // KAT 2: max_depth — three levels of nesting
    cki("depth_nested3", bnst_max_depth("[a][b][c]x[/c][/b][/a]"), 3)

    // KAT 3: max_depth — no tags at all
    cki("depth_none", bnst_max_depth("plain text"), 0)

    // KAT 4: tag_counts — repeated + distinct tags
    let tc = bnst_tag_counts("[b]x[/b][b]y[/b][i]z[/i]")
    cki("tagcounts_b", tc["b"], 2)
    cki("tagcounts_i", tc["i"], 1)

    // KAT 5: tag_counts — attribute form counted by base tag name
    let tc2 = bnst_tag_counts("[url=http://x]a[/url][url=http://y]b[/url]")
    cki("tagcounts_url", tc2["url"], 2)

    // KAT 6: flatten — strip tags deeper than max_depth=1, keep inner text
    let f1 = bnst_flatten("[a]outer[b]inner[/b]tail[/a]", 1)
    cks("flatten_depth1", f1, "[a]outerinnertail[/a]")

    // KAT 7: flatten — max_depth=0 strips everything
    let f2 = bnst_flatten("[a]outer[b]inner[/b]tail[/a]", 0)
    cks("flatten_depth0", f2, "outerinnertail")

    // KAT 8: find_tag — basic content lookup
    let ft1 = bnst_find_tag("[b]bold text[/b]", "b")
    cks("find_tag_basic", ft1, "bold text")

    // KAT 9: find_tag — tag not present returns ""
    let ft2 = bnst_find_tag("[i]italic[/i]", "b")
    cks("find_tag_missing", ft2, "")

    // KAT 10: replace_tag — replaces content of every occurrence
    let rt = bnst_replace_tag("[b]old1[/b] and [b]old2[/b]", "b", "new")
    cks("replace_tag_all", rt, "[b]new[/b] and [b]new[/b]")

    print("PASS _bbcode_nest_test")
