import std/game/magic_square

fn chk_int(name: string, got: int, want: int)
    if got != want
        print("FAIL magic_square " + name + ": got " + str(got) + " want " + str(want))
        exit(1)

fn chk_bool(name: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL magic_square " + name + ": got " + gs + " want " + ws)
        exit(1)

fn main()
    // --- magic_constant ---
    chk_int("mc(1)", magic_constant(1), 1)
    chk_int("mc(3)", magic_constant(3), 15)
    chk_int("mc(5)", magic_constant(5), 65)
    chk_int("mc(7)", magic_constant(7), 175)

    // --- magic_square(1) ---
    let sq1 = magic_square(1)
    chk_int("sq1 len", len(sq1), 1)
    chk_int("sq1[0]", sq1[0], 1)
    chk_bool("sq1 is_magic", is_magic(sq1, 1), true)

    // --- magic_square(3): verify is_magic and contains 1..9 ---
    let sq3 = magic_square(3)
    chk_int("sq3 len", len(sq3), 9)
    chk_bool("sq3 is_magic", is_magic(sq3, 3), true)

    // verify every value 1..9 appears exactly once
    let seen3 = []
    let i3 = 0
    while i3 < 9
        push(seen3, 0)
        i3 = i3 + 1
    let j3 = 0
    while j3 < 9
        let v = sq3[j3]
        if v < 1 or v > 9
            print("FAIL magic_square sq3 value out of range: " + str(v))
            exit(1)
        seen3[v - 1] = seen3[v - 1] + 1
        j3 = j3 + 1
    let k3 = 0
    while k3 < 9
        chk_int("sq3 value " + str(k3 + 1) + " count", seen3[k3], 1)
        k3 = k3 + 1

    // --- magic_square(5) ---
    let sq5 = magic_square(5)
    chk_int("sq5 len", len(sq5), 25)
    chk_bool("sq5 is_magic", is_magic(sq5, 5), true)

    // verify every value 1..25 appears exactly once
    let seen5 = []
    let i5 = 0
    while i5 < 25
        push(seen5, 0)
        i5 = i5 + 1
    let j5 = 0
    while j5 < 25
        let v5 = sq5[j5]
        if v5 < 1 or v5 > 25
            print("FAIL magic_square sq5 value out of range: " + str(v5))
            exit(1)
        seen5[v5 - 1] = seen5[v5 - 1] + 1
        j5 = j5 + 1
    let k5 = 0
    while k5 < 25
        chk_int("sq5 value " + str(k5 + 1) + " count", seen5[k5], 1)
        k5 = k5 + 1

    // --- magic_square(7) ---
    let sq7 = magic_square(7)
    chk_bool("sq7 is_magic", is_magic(sq7, 7), true)

    // --- is_magic of a non-magic square == false ---
    // Build a 3x3 with values that don't sum correctly
    let bad = []
    let bi = 0
    while bi < 9
        push(bad, bi + 1)
        bi = bi + 1
    // bad = [1,2,3,4,5,6,7,8,9] — rows sum to 6,15,24; not all 15
    chk_bool("non_magic is_magic", is_magic(bad, 3), false)

    // --- another non-magic: swap two cells in the 3x3 so rows differ ---
    let bad2 = []
    let bi2 = 0
    while bi2 < 9
        push(bad2, sq3[bi2])
        bi2 = bi2 + 1
    // swap cells 0 and 1 in first row — breaks row sum and diagonals
    let tmp = bad2[0]
    bad2[0] = bad2[1]
    bad2[1] = tmp
    chk_bool("swapped non_magic", is_magic(bad2, 3), false)

    print("PASS _magic_square_test")
