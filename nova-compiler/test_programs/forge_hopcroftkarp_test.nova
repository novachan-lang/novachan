import forge_hopcroftkarp as hk
import forge_bimatch as bm

fn check(cond: bool, label: str)
    if cond == false
        print("FAIL: " + label)

// TEST 1: perfect matching 3x3
// left {0,1,2}, right {0,1,2}; edges 0-0, 1-1, 2-2
let e1 = [[0, 0], [1, 1], [2, 2]]
check(hk.hk_matching_size(3, 3, e1) == 3, "diagonal perfect matching = 3")

// TEST 2: classic non-trivial
// 0-0, 0-1, 1-0, 2-2 -> max matching 3 (0-1, 1-0, 2-2)
let e2 = [[0, 0], [0, 1], [1, 0], [2, 2]]
check(hk.hk_matching_size(3, 3, e2) == 3, "matching e2 = 3")

// TEST 3: no edges
check(hk.hk_matching_size(3, 3, []) == 0, "no edges = 0")

// TEST 4: star (one right vertex connected to all left) -> matching 1
let e4 = [[0, 0], [1, 0], [2, 0]]
check(hk.hk_matching_size(3, 1, e4) == 1, "star matching = 1")

// TEST 5: matching validity - each left/right used once
let pairing = hk.hk_max_matching(3, 3, e2)
check(len(pairing) == 3, "match array length 3")
// verify each matched pair is a real edge and no right vertex reused
fn is_edge(edges: list, u: int, v: int) -> bool
    let i = 0
    while i < len(edges)
        if edges[i][0] == u and edges[i][1] == v
            return true
        i = i + 1
    return false

let used_right = {}
let ok_valid = true
let i = 0
while i < len(pairing)
    if pairing[i] != 0 - 1
        if is_edge(e2, i, pairing[i]) == false
            ok_valid = false
            print("INVALID EDGE left=" + str(i) + " right=" + str(pairing[i]))
        let rkey = str(pairing[i])
        if get(used_right, rkey, 0) == 1
            ok_valid = false
            print("RIGHT REUSED " + rkey)
        used_right[rkey] = 1
    i = i + 1
check(ok_valid, "matching is valid (real edges, no right reused)")

// TEST 6: DECISIVE cross-check against forge_bimatch (Kuhn) on many random bipartite graphs
let ok = true
let seed = 7
let tc = 0
while tc < 40
    seed = (seed * 1103515245 + 12345) % 2147483648
    let nl = seed % 6 + 1
    seed = (seed * 1103515245 + 12345) % 2147483648
    let nr = seed % 6 + 1
    // random edges
    let edges = []
    let u = 0
    while u < nl
        let v = 0
        while v < nr
            seed = (seed * 1103515245 + 12345) % 2147483648
            if seed % 3 == 0
                push(edges, [u, v])
            v = v + 1
        u = u + 1
    let hk_size = hk.hk_matching_size(nl, nr, edges)
    let bm_size = bm.matching_size(nl, nr, edges)
    if hk_size != bm_size
        ok = false
        print("MISMATCH tc=" + str(tc) + " nl=" + str(nl) + " nr=" + str(nr) + " hk=" + str(hk_size) + " kuhn=" + str(bm_size))
    tc = tc + 1
check(ok, "DECISIVE: Hopcroft-Karp matches Kuhn (forge_bimatch) on 40 random graphs")

// TEST 7: larger dense graph - complete bipartite K(4,4) -> matching 4
let e7 = []
let a = 0
while a < 4
    let b = 0
    while b < 4
        push(e7, [a, b])
        b = b + 1
    a = a + 1
check(hk.hk_matching_size(4, 4, e7) == 4, "K(4,4) matching = 4")

// TEST 8: unbalanced - 5 left, 2 right, all connected -> matching 2
let e8 = []
let l = 0
while l < 5
    let r = 0
    while r < 2
        push(e8, [l, r])
        r = r + 1
    l = l + 1
check(hk.hk_matching_size(5, 2, e8) == 2, "unbalanced 5x2 matching = 2")

// TEST 9: path graph 0-0, 1-0, 1-1, 2-1, 2-2 -> matching 3
let e9 = [[0, 0], [1, 0], [1, 1], [2, 1], [2, 2]]
check(hk.hk_matching_size(3, 3, e9) == 3, "path graph matching = 3")

print("forge_hopcroftkarp: KAT done")
