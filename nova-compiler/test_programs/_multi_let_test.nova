fn main()
    let a, b, c = 1, 2, 3
    assert_eq(a, 1)
    assert_eq(b, 2)
    assert_eq(c, 3)
    print("multi-let basic: PASS")

    let x, y = "hello", "world"
    assert_eq(x, "hello")
    assert_eq(y, "world")
    print("multi-let strings: PASS")

    let p, q = [1, 2], [3, 4]
    assert_eq(p, [1, 2])
    assert_eq(q, [3, 4])
    print("multi-let lists: PASS")

    let m, n = {"a": 1}, {"b": 2}
    assert_eq(m["a"], 1)
    assert_eq(n["b"], 2)
    print("multi-let dicts: PASS")

    let i, j = 10 + 20, 30 * 2
    assert_eq(i, 30)
    assert_eq(j, 60)
    print("multi-let expressions: PASS")

    let r, s = len([1, 2, 3]), str(42)
    assert_eq(r, 3)
    assert_eq(s, "42")
    print("multi-let function calls: PASS")

    let u, v = true, false
    assert(u, "u should be true")
    assert(not v, "v should be false")
    print("multi-let booleans: PASS")

    let (d, e) = [100, 200]
    assert_eq(d, 100)
    assert_eq(e, 200)
    print("paren destructure still works: PASS")

    print("ALL MULTI-LET TESTS PASSED")
