import std/finance/tax

// Helper: check float within epsilon, print FAIL and exit(1) on mismatch.
fn _tax_check(label: string, got: float, want: float, eps: float)
    let d = got - want
    let ad = d
    if ad < 0.0
        ad = 0.0 - ad
    if ad > eps
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // Standard 3-bracket set:
    //   0 %   on nothing (first threshold is 0, rate 10 %)
    //   10 %  on $0–$10 000
    //   20 %  on $10 000–$40 000
    //   30 %  on $40 000+
    let br = [[0.0, 0.1], [10000.0, 0.2], [40000.0, 0.3]]

    // KAT 1: income in first bracket only
    // tax = (5000 - 0) * 0.1 = 500
    let t1 = tax_compute(5000.0, br)
    _tax_check("tax_compute_5000", t1, 500.0, 0.01)

    // KAT 2: income spans first two brackets
    // tax = (10000-0)*0.1 + (20000-10000)*0.2 = 1000 + 2000 = 3000
    let t2 = tax_compute(20000.0, br)
    _tax_check("tax_compute_20000", t2, 3000.0, 0.01)

    // KAT 3: income spans all three brackets
    // tax = (10000-0)*0.1 + (40000-10000)*0.2 + (50000-40000)*0.3
    //     = 1000 + 6000 + 3000 = 10000
    let t3 = tax_compute(50000.0, br)
    _tax_check("tax_compute_50000", t3, 10000.0, 0.01)

    // KAT 4: marginal rate for income in second bracket
    // 20000 falls in [10000, 40000) -> rate = 0.2
    let t4 = tax_marginal_rate(20000.0, br)
    _tax_check("tax_marginal_rate_20000", t4, 0.2, 0.0001)

    // KAT 5: effective rate at $20 000
    // tax = 3000, effective = 3000/20000 = 0.15
    let t5 = tax_effective_rate(20000.0, br)
    _tax_check("tax_effective_rate_20000", t5, 0.15, 0.0001)

    // KAT 6: after-tax income at $20 000
    // after_tax = 20000 - 3000 = 17000
    let t6 = tax_after_tax(20000.0, br)
    _tax_check("tax_after_tax_20000", t6, 17000.0, 0.01)

    // KAT 7: marginal rate at exact bracket boundary (50000 in third bracket)
    // 50000 > 40000 -> rate = 0.3
    let t7 = tax_marginal_rate(50000.0, br)
    _tax_check("tax_marginal_rate_50000", t7, 0.3, 0.0001)

    // KAT 8: zero income -> all results zero
    let t8a = tax_compute(0.0, br)
    _tax_check("tax_compute_zero", t8a, 0.0, 0.001)
    let t8b = tax_effective_rate(0.0, br)
    _tax_check("tax_effective_rate_zero", t8b, 0.0, 0.0001)
    let t8c = tax_after_tax(0.0, br)
    _tax_check("tax_after_tax_zero", t8c, 0.0, 0.001)

    print("_tax_test passed")
