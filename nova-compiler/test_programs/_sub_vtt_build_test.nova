// KAT probe for std/data/sub_vtt_build
// Spec: one cue {start=1000,end=4000,text="Hi"}
//   -> starts with "WEBVTT" and contains "00:00:01.000 --> 00:00:04.000\nHi"
//   round-trip: vtt_parse(vtt_build(cues)) recovers start/end/text
import std/data/sub_vtt_build
import std/data/sub_vtt_parse

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn _starts_with(s: string, prefix: string) -> int
    let result = 0
    if len(s) >= len(prefix)
        if slice(s, 0, len(prefix)) == prefix
            result = 1
    result

fn _contains(s: string, sub: string) -> int
    let n = len(s)
    let m = len(sub)
    let found = 0
    let i = 0
    while i <= n - m
        if slice(s, i, i + m) == sub
            found = 1
            i = n
        i = i + 1
    found

fn main()
    // ── Build one cue dict ────────────────────────────────────────────────────
    let cue = {}
    cue["index"] = 1
    cue["start"] = 1000
    cue["end"] = 4000
    cue["text"] = "Hi"
    let cue_list = [cue]

    // ── KAT 1: vtt_build starts with "WEBVTT" ────────────────────────────────
    let doc = vtt_build(cue_list)
    cki("kat1-starts-webvtt", _starts_with(doc, "WEBVTT"), 1)
    print("KAT 1 PASS: starts with WEBVTT")

    // ── KAT 2: document contains correct timing line ─────────────────────────
    let timing_line = "00:00:01.000 --> 00:00:04.000"
    cki("kat2-timing", _contains(doc, timing_line), 1)
    print("KAT 2 PASS: timing line present")

    // ── KAT 3: document contains "Hi" ────────────────────────────────────────
    cki("kat3-text", _contains(doc, "Hi"), 1)
    print("KAT 3 PASS: text 'Hi' present")

    // ── KAT 4: round-trip via vtt_parse ──────────────────────────────────────
    let parsed = vtt_parse(doc)
    cki("kat4-rt-count", len(parsed), 1)
    let pc = parsed[0]
    cki("kat4-rt-start", pc["start"], 1000)
    cki("kat4-rt-end",   pc["end"],   4000)
    cks("kat4-rt-text",  pc["text"],  "Hi")
    print("KAT 4 PASS: round-trip recovers start/end/text")

    // ── KAT 5: vtt_build_cue single cue ─────────────────────────────────────
    let cue2 = {}
    cue2["index"] = 1
    cue2["start"] = 1000
    cue2["end"] = 4000
    cue2["text"] = "Hi"
    let cs = vtt_build_cue(cue2)
    cki("kat5-cue-str-timing", _contains(cs, timing_line), 1)
    cki("kat5-cue-str-text",   _contains(cs, "Hi"), 1)
    print("KAT 5 PASS: vtt_build_cue produces timing + text")

    // ── KAT 6: ms padding — 5500ms = 00:00:05.500 ────────────────────────────
    let cue3 = {}
    cue3["index"] = 1
    cue3["start"] = 5500
    cue3["end"] = 8200
    cue3["text"] = "World"
    let cue3_list = [cue3]
    let doc3 = vtt_build(cue3_list)
    cki("kat6-pad500", _contains(doc3, "00:00:05.500 --> 00:00:08.200"), 1)
    print("KAT 6 PASS: ms padding correct")

    // ── KAT 7: large timecode — 01:02:03.456 ────────────────────────────────
    let cue4 = {}
    cue4["index"] = 1
    cue4["start"] = 3723456
    cue4["end"] = 3724789
    cue4["text"] = "Edge"
    let cue4_list = [cue4]
    let doc4 = vtt_build(cue4_list)
    cki("kat7-large-tc", _contains(doc4, "01:02:03.456 --> 01:02:04.789"), 1)
    print("KAT 7 PASS: large timecode renders correctly")

    // ── KAT 8: two-cue document, round-trip ──────────────────────────────────
    let ca = {}
    ca["index"] = 1
    ca["start"] = 1000
    ca["end"] = 4000
    ca["text"] = "Hello"
    let cb = {}
    cb["index"] = 2
    cb["start"] = 5000
    cb["end"] = 8000
    cb["text"] = "World"
    let two_cues = [ca, cb]
    let doc_two = vtt_build(two_cues)
    let rt_two = vtt_parse(doc_two)
    cki("kat8-two-count", len(rt_two), 2)
    cki("kat8-two-c1-start", rt_two[0]["start"], 1000)
    cki("kat8-two-c2-start", rt_two[1]["start"], 5000)
    print("KAT 8 PASS: two-cue round-trip")

    print("PASS _sub_vtt_build_test")
