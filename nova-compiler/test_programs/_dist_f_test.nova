// _dist_f_test.nova — KAT for std/numeric/dist_f
import std/numeric/dist_f

fn approx(a, b, tol) -> float
    let af = a * 1.0
    let bf = b * 1.0
    let tf = tol * 1.0
    let d = af - bf
    if d < 0.0
        d = 0.0 - d
    if d < tf
        return 1.0
    return 0.0

fn check(name, got, want, tol)
    let af = got * 1.0
    let bf = want * 1.0
    let tf = tol * 1.0
    let ok = approx(af, bf, tf)
    if ok < 1.0
        print("FAIL " + name + ": got=" + str(af) + " want=" + str(bf))
        exit(1)

fn main()
    // f_mean(5, 10) = 10/(10-2) = 10/8 = 1.25
    let m = f_mean(5.0, 10.0)
    check("f_mean(5,10)", m, 1.25, 0.01)

    // f_mean with d2 <= 2 => 0
    let m2 = f_mean(5.0, 2.0)
    check("f_mean(5,2)=0", m2, 0.0, 0.001)

    // f_pdf returns 0 for x <= 0
    let pneg = f_pdf(0.0 - 1.0, 5.0, 10.0)
    check("f_pdf(-1,5,10)=0", pneg, 0.0, 0.001)

    let pzero = f_pdf(0.0, 5.0, 10.0)
    check("f_pdf(0,5,10)=0", pzero, 0.0, 0.001)

    // f_pdf(1, 5, 10): known value ~ 0.4955
    // Verified: B(2.5,5)=0.01705; f=(1/B)*(0.5^2.5)*(1.5^-7.5)~0.4955
    let p1 = f_pdf(1.0, 5.0, 10.0)
    check("f_pdf(1,5,10)", p1, 0.4955, 0.02)

    // f_pdf should be > 0 for positive x
    let p2 = f_pdf(2.0, 5.0, 10.0)
    if p2 <= 0.0
        print("FAIL f_pdf(2,5,10) should be > 0, got=" + str(p2))
        exit(1)

    // f_cdf(0, 5, 10) = 0
    let c0 = f_cdf(0.0, 5.0, 10.0)
    check("f_cdf(0,5,10)=0", c0, 0.0, 0.001)

    // f_cdf is monotonically increasing
    let c1 = f_cdf(1.0, 5.0, 10.0)
    let c3 = f_cdf(3.0, 5.0, 10.0)
    let c10 = f_cdf(10.0, 5.0, 10.0)
    if c1 >= c3
        print("FAIL f_cdf not monotone: cdf(1)=" + str(c1) + " cdf(3)=" + str(c3))
        exit(1)
    if c3 >= c10
        print("FAIL f_cdf not monotone: cdf(3)=" + str(c3) + " cdf(10)=" + str(c10))
        exit(1)

    // f_cdf(large x) approx 1.0
    let clarge = f_cdf(100.0, 5.0, 10.0)
    check("f_cdf(100,5,10) ~= 1", clarge, 1.0, 0.01)

    // f_cdf(1, 5, 10) should be roughly 0.5 (median near d2/(d2-2) region)
    // Actual value at x=1 is about 0.5 by symmetry-like properties... ~0.4956
    // Let's just check range: 0.4 < cdf(1) < 0.6
    if c1 < 0.4
        print("FAIL f_cdf(1,5,10) too low: " + str(c1))
        exit(1)
    if c1 > 0.65
        print("FAIL f_cdf(1,5,10) too high: " + str(c1))
        exit(1)

    // f_cdf(5, 5, 5) should be about 0.9 (F(5;5,5) ~ 0.9 from tables)
    let c55 = f_cdf(5.0, 5.0, 5.0)
    check("f_cdf(5,5,5) ~= 0.9", c55, 0.9, 0.05)

    print("PASS _dist_f_test")
