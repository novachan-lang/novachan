import std/complex/complex_convert

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label, got, want)
    let gs = "false"
    if got
        gs = "true"
    let ws = "false"
    if want
        ws = "true"
    if gs != ws
        print("FAIL " + label + ": got " + gs + " want " + ws)
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got '" + got + "' want '" + want + "'")
        exit(1)

fn ckl(label, got, want)
    if got[0] != want[0]
        print("FAIL " + label + "[0]: got " + str(got[0]) + " want " + str(want[0]))
        exit(1)
    if got[1] != want[1]
        print("FAIL " + label + "[1]: got " + str(got[1]) + " want " + str(want[1]))
        exit(1)

fn main()
    // cxc_from_real
    ckl("from_real(7)", cxc_from_real(7), [7, 0])
    ckl("from_real(0)", cxc_from_real(0), [0, 0])
    ckl("from_real(-3)", cxc_from_real(0 - 3), [0 - 3, 0])

    // cxc_to_string: various cases
    cks("3-2i", cxc_to_string([3, 0 - 2]), "3-2i")
    cks("[0,1]=i", cxc_to_string([0, 1]), "i")
    cks("[0,-1]=-i", cxc_to_string([0, 0 - 1]), "-i")
    cks("[5,0]=5", cxc_to_string([5, 0]), "5")
    cks("2+3i", cxc_to_string([2, 3]), "2+3i")
    cks("[0,0]=0", cxc_to_string([0, 0]), "0")
    cks("[1,1]=1+i", cxc_to_string([1, 1]), "1+i")
    cks("[1,-1]=1-i", cxc_to_string([1, 0 - 1]), "1-i")
    cks("[0,5]=5i", cxc_to_string([0, 5]), "5i")
    cks("[-2,-3]", cxc_to_string([0 - 2, 0 - 3]), "-2-3i")

    // cxc_is_real
    ckb("is_real [5,0]", cxc_is_real([5, 0]), true)
    ckb("is_real [0,3]", cxc_is_real([0, 3]), false)
    ckb("is_real [1,2]", cxc_is_real([1, 2]), false)

    // cxc_is_imaginary
    ckb("is_imag [0,3]", cxc_is_imaginary([0, 3]), true)
    ckb("is_imag [0,0]", cxc_is_imaginary([0, 0]), false)
    ckb("is_imag [1,2]", cxc_is_imaginary([1, 2]), false)

    // cxc_is_zero
    ckb("is_zero [0,0]", cxc_is_zero([0, 0]), true)
    ckb("is_zero [1,0]", cxc_is_zero([1, 0]), false)

    // cxc_equal
    ckb("equal [1,2]==[1,2]", cxc_equal([1, 2], [1, 2]), true)
    ckb("equal [1,2]!=[1,3]", cxc_equal([1, 2], [1, 3]), false)

    print("PASS _complex_convert_test")
