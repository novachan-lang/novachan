import forge_backup

fn main()
    let bk = bk_new()
    assert(bk_count(bk) == 0, "empty")

    bk = bk_add_policy(bk, "daily", 7, 10)
    bk = bk_add_policy(bk, "weekly", 30, 5)

    let r1 = bk_create(bk, "daily", "/data/db", 1000000)
    bk = r1["bk"]
    let id1 = r1["backup_id"]
    assert(id1 == 1, "id=1")
    assert(bk_count(bk) == 1, "1 backup")

    bk = bk_set_size(bk, id1, 5000000)

    let r2 = bk_create(bk, "daily", "/data/db", 1086400)
    bk = r2["bk"]

    let r3 = bk_create(bk, "weekly", "/data/full", 1100000)
    bk = r3["bk"]
    bk = bk_set_size(bk, r3["backup_id"], 20000000)

    assert(bk_count(bk) == 3, "3 backups")

    let latest = bk_latest(bk)
    assert(latest["source"] == "/data/full", "latest=weekly")
    assert(latest["policy"] == "weekly", "latest policy")

    let daily = bk_for_policy(bk, "daily")
    assert(len(daily) == 2, "2 daily backups")

    let weekly = bk_for_policy(bk, "weekly")
    assert(len(weekly) == 1, "1 weekly backup")

    bk = bk_verify(bk, id1)
    assert(bk["backups"][0]["verified"] == 1, "verified")

    assert(bk_total_size(bk) == 25000000, "total size")

    let expired = bk_expired(bk, "daily", 2000000)
    assert(len(expired) == 2, "2 expired (>7 days)")

    let not_expired = bk_expired(bk, "daily", 1100000)
    assert(len(not_expired) == 0, "none expired yet")

    let empty_latest = bk_new()
    let el = bk_latest(empty_latest)
    assert(el["id"] == -1, "empty latest")

    print("BACKUP KAT PASS")
