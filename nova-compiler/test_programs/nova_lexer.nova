type Token
    kind: string
    value: string
    line: int
    col: int

fn is_alpha(ch: string) -> bool
    let c = ord(ch)
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or ch == "_"

fn is_digit(ch: string) -> bool
    let c = ord(ch)
    c >= 48 and c <= 57

fn is_alnum(ch: string) -> bool
    is_alpha(ch) or is_digit(ch)

fn is_whitespace(ch: string) -> bool
    ch == " " or ch == "\t" or ch == "\r"

fn make_token(kind: string, value: string, line: int, col: int) -> Token
    Token(kind, value, line, col)

fn tokenize(source: string) -> list
    let tokens = []
    let pos = 0
    let line = 1
    let col = 1
    let length = len(source)

    while pos < length
        let ch = source[pos]

        if ch == "\n"
            push(tokens, make_token("NEWLINE", "\\n", line, col))
            line = line + 1
            col = 1
            pos = pos + 1
        else if is_whitespace(ch)
            let start_col = col
            let spaces = ""
            while pos < length and is_whitespace(source[pos])
                spaces = spaces + source[pos]
                pos = pos + 1
                col = col + 1
            push(tokens, make_token("WS", spaces, line, start_col))
        else if ch == "/" and pos + 1 < length and source[pos + 1] == "/"
            while pos < length and source[pos] != "\n"
                pos = pos + 1
                col = col + 1
        else if is_alpha(ch)
            let start_col = col
            let word = ""
            while pos < length and is_alnum(source[pos])
                word = word + source[pos]
                pos = pos + 1
                col = col + 1
            let kind = if word == "fn" or word == "let" or word == "if" or word == "else" or word == "while" or word == "for" or word == "in" or word == "return" or word == "match" or word == "type" or word == "trait" or word == "import" or word == "true" or word == "false" or word == "and" or word == "or" or word == "not" or word == "spawn" or word == "try" or word == "catch"
                "KW"
            else
                "IDENT"
            push(tokens, make_token(kind, word, line, start_col))
        else if is_digit(ch)
            let start_col = col
            let num = ""
            while pos < length and (is_digit(source[pos]) or source[pos] == "." or source[pos] == "_")
                if source[pos] != "_"
                    num = num + source[pos]
                pos = pos + 1
                col = col + 1
            let kind = if contains(num, ".")
                "FLOAT"
            else
                "INT"
            push(tokens, make_token(kind, num, line, start_col))
        else if ch == "\""
            let start_col = col
            pos = pos + 1
            col = col + 1
            let str_val = ""
            while pos < length and source[pos] != "\""
                if source[pos] == "\\"
                    pos = pos + 1
                    col = col + 1
                    if pos < length
                        let esc = source[pos]
                        if esc == "n"
                            str_val = str_val + "\n"
                        else if esc == "t"
                            str_val = str_val + "\t"
                        else if esc == "\\"
                            str_val = str_val + "\\"
                        else if esc == "\""
                            str_val = str_val + "\""
                        else
                            str_val = str_val + esc
                else
                    str_val = str_val + source[pos]
                pos = pos + 1
                col = col + 1
            if pos < length
                pos = pos + 1
                col = col + 1
            push(tokens, make_token("STR", str_val, line, start_col))
        else if ch == "(" or ch == ")" or ch == "[" or ch == "]" or ch == "\{" or ch == "\}"
            push(tokens, make_token("DELIM", ch, line, col))
            pos = pos + 1
            col = col + 1
        else if ch == "+" or ch == "*" or ch == "/" or ch == "%" or ch == "^"
            push(tokens, make_token("OP", ch, line, col))
            pos = pos + 1
            col = col + 1
        else if ch == "-"
            if pos + 1 < length and source[pos + 1] == ">"
                push(tokens, make_token("ARROW", "->", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, make_token("OP", "-", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == "="
            if pos + 1 < length and source[pos + 1] == "="
                push(tokens, make_token("OP", "==", line, col))
                pos = pos + 2
                col = col + 2
            else if pos + 1 < length and source[pos + 1] == ">"
                push(tokens, make_token("FAT_ARROW", "=>", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, make_token("ASSIGN", "=", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == "!"
            if pos + 1 < length and source[pos + 1] == "="
                push(tokens, make_token("OP", "!=", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, make_token("OP", "!", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == "<"
            if pos + 1 < length and source[pos + 1] == "="
                push(tokens, make_token("OP", "<=", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, make_token("OP", "<", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == ">"
            if pos + 1 < length and source[pos + 1] == "="
                push(tokens, make_token("OP", ">=", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, make_token("OP", ">", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == ":"
            push(tokens, make_token("COLON", ":", line, col))
            pos = pos + 1
            col = col + 1
        else if ch == ","
            push(tokens, make_token("COMMA", ",", line, col))
            pos = pos + 1
            col = col + 1
        else if ch == "."
            if pos + 1 < length and source[pos + 1] == "."
                push(tokens, make_token("RANGE", "..", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, make_token("DOT", ".", line, col))
                pos = pos + 1
                col = col + 1
        else
            push(tokens, make_token("UNKNOWN", ch, line, col))
            pos = pos + 1
            col = col + 1

    push(tokens, make_token("EOF", "", line, col))
    tokens

fn run_tests()
    // Test 1: Basic tokenization
    let src = "let x = 42"
    let toks = tokenize(src)
    let non_ws = filter_ws(toks)
    assert(len(non_ws) >= 4, "basic token count")
    match non_ws[0]
        Token(kind, value, line, col) =>
            assert(kind == "KW" and value == "let", "t0: " + kind + " " + value)
    match non_ws[1]
        Token(kind, value, line, col) =>
            assert(kind == "IDENT" and value == "x", "t1: " + kind + " " + value)
    match non_ws[2]
        Token(kind, value, line, col) =>
            assert(kind == "ASSIGN" and value == "=", "t2: " + kind + " " + value)
    match non_ws[3]
        Token(kind, value, line, col) =>
            assert(kind == "INT" and value == "42", "t3: " + kind + " " + value)

    // Test 2: Function declaration
    let src2 = "fn add(a: int, b: int) -> int"
    let toks2 = filter_ws(tokenize(src2))
    match toks2[0]
        Token(kind, value, line, col) =>
            assert(kind == "KW" and value == "fn", "fn keyword")
    match toks2[1]
        Token(kind, value, line, col) =>
            assert(kind == "IDENT" and value == "add", "fn name")

    // Test 3: Operators and comparisons
    let src3 = "x == y != z <= w"
    let toks3 = filter_ws(tokenize(src3))
    match toks3[1]
        Token(kind, value, line, col) =>
            assert(value == "==", "eq op")
    match toks3[3]
        Token(kind, value, line, col) =>
            assert(value == "!=", "neq op")
    match toks3[5]
        Token(kind, value, line, col) =>
            assert(value == "<=", "lte op")

    // Test 4: String literals with escapes
    let src4 = `"hello\nworld"`
    let toks4 = tokenize(src4)
    match toks4[0]
        Token(kind, value, line, col) =>
            assert(kind == "STR", "string token: " + kind)

    // Test 5: Multi-line with line tracking
    let src5 = "a\nb\nc"
    let toks5 = tokenize(src5)
    let last = toks5[len(toks5) - 1]
    match last
        Token(kind, value, line, col) =>
            assert(line == 3, "line tracking: " + str(line))

    // Test 6: Real NOVA code
    let nova_code = "fn fib(n: int) -> int\n    if n < 2\n        return n\n    fib(n - 1) + fib(n - 2)"
    let nova_toks = tokenize(nova_code)
    let count = 0
    for t in nova_toks
        match t
            Token(kind, value, line, col) =>
                if kind == "KW" or kind == "IDENT" or kind == "INT" or kind == "OP"
                    count = count + 1
    assert(count > 15, "nova code token count: " + str(count))

    print("NOVA Lexer self-test: ALL PASSED")
    print("Tokenized " + str(len(nova_toks)) + " tokens from fib source")

fn filter_ws(tokens: list) -> list
    let result = []
    for t in tokens
        match t
            Token(kind, value, line, col) =>
                if kind != "WS" and kind != "NEWLINE" and kind != "EOF"
                    push(result, t)
    result

run_tests()
