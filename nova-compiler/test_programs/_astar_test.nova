// KAT test for std/graph/astar — A* search on a weighted directed graph.
// Hand-computed expected values against the example from the spec.
import std/graph/astar

fn cki(name: string, got: int, want: int)
    if got != want
        print("FAIL " + name + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("ok " + name)

fn cks(name: string, got: string, want: string)
    if got != want
        print("FAIL " + name + ": got '" + got + "' want '" + want + "'")
        exit(1)
    print("ok " + name)

fn path_str(p: list) -> string
    let s = ""
    let i = 0
    while i < len(p)
        if i > 0
            s = s + ","
        s = s + p[i]
        i = i + 1
    return s

fn main()
    // ----------------------------------------------------------------
    // Example graph from spec:
    //   A->[[B,1],[C,4]], B->[[C,2],[D,5]], C->[[D,1]], D->[]
    // Heuristic (admissible): h = A:4, B:3, C:1, D:0
    // ----------------------------------------------------------------
    let g = {}
    g["A"] = [["B",1],["C",4]]
    g["B"] = [["C",2],["D",5]]
    g["C"] = [["D",1]]
    g["D"] = []

    let h = {}
    h["A"] = 4
    h["B"] = 3
    h["C"] = 1
    h["D"] = 0

    // KAT 1: shortest A->D cost == 4 (path A->B->C->D: 1+2+1=4)
    cki("as_distance A->D", as_distance(g, h, "A", "D"), 4)

    // KAT 2: path A->D sequence == [A,B,C,D]
    let p1 = as_path(g, h, "A", "D")
    cki("as_path A->D len", len(p1), 4)
    cks("as_path A->D[0]", p1[0], "A")
    cks("as_path A->D[1]", p1[1], "B")
    cks("as_path A->D[2]", p1[2], "C")
    cks("as_path A->D[3]", p1[3], "D")

    // KAT 3: shortest A->C cost == 3 (A->B->C: 1+2=3, not A->C direct=4)
    cki("as_distance A->C", as_distance(g, h, "A", "C"), 3)

    // KAT 4: same node start==goal returns 0 cost
    cki("as_distance A->A", as_distance(g, h, "A", "A"), 0)

    // KAT 5: single-node path for start==goal
    let p2 = as_path(g, h, "A", "A")
    cki("as_path A->A len", len(p2), 1)
    cks("as_path A->A[0]", p2[0], "A")

    // KAT 6: no path from D to A (D has no edges) -> distance == -1
    cki("as_distance D->A", as_distance(g, h, "D", "A"), -1)

    // KAT 7: no path -> empty path list
    let p3 = as_path(g, h, "D", "A")
    cki("as_path D->A len", len(p3), 0)

    // KAT 8: all-zero heuristic (reduces to Dijkstra) still yields cost 4
    let h0 = {}
    h0["A"] = 0
    h0["B"] = 0
    h0["C"] = 0
    h0["D"] = 0
    cki("as_distance A->D zero-h", as_distance(g, h0, "A", "D"), 4)

    // KAT 9: zero-h path also [A,B,C,D]
    let p4 = as_path(g, h0, "A", "D")
    cki("as_path A->D zero-h len", len(p4), 4)
    cks("as_path A->D zero-h[0]", p4[0], "A")
    cks("as_path A->D zero-h[3]", p4[3], "D")

    // KAT 10: A->B direct cost == 1
    cki("as_distance A->B", as_distance(g, h, "A", "B"), 1)

    print("_astar_test passed")
