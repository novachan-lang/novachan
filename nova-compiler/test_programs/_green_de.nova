fn mk()
    let t = {}
    t["start_ms"] = time_ms()
    t

fn elapsed(t)
    time_ms() - t["start_ms"]

fn main()
    let bad = 0
    let lo = 9999
    let i = 0
    while i < 60
        let t = mk()
        let f = {}
        f["enter_ms"] = time_ms()
        sleep(10)
        let e = elapsed(t)
        if e < lo
            lo = e
        if e < 10
            bad = bad + 1
        i = i + 1
    print("min=" + str(lo) + " bad(<10)=" + str(bad) + " of 60")
