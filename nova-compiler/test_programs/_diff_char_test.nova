// KAT for std/text/diff_char
// Tests: diff_chars + chars_apply (round-trip) + specific vector checks.
import std/text/diff_char

// ── helpers ──────────────────────────────────────────────────────────────────

// cks: assert string equality; print FAIL + exit on mismatch.
fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

// cki: assert int equality; print FAIL + exit on mismatch.
fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// op_tag: return the tag string from a [tag, char] op.
fn op_tag(op)
    op[0]

// op_char: return the char string from a [tag, char] op.
fn op_char(op)
    op[1]

// count_tag: count ops with a given tag in a script.
fn count_tag(script, tag)
    let cnt = 0
    let i = 0
    while i < len(script)
        if op_tag(script[i]) == tag
            cnt = cnt + 1
        i = i + 1
    cnt

// ── KAT 1: ROUND-TRIP kitten -> sitting ──────────────────────────────────────
fn main()
    let sc1 = diff_chars("kitten", "sitting")
    let rt1 = chars_apply("kitten", sc1)
    cks("RT1 kitten->sitting", rt1, "sitting")

    // ── KAT 2: identical strings — all "=" ops ───────────────────────────────
    let sc2 = diff_chars("abc", "abc")
    cki("identical len", len(sc2), 3)
    cki("identical tags all =", count_tag(sc2, "="), 3)
    cki("identical no +", count_tag(sc2, "+"), 0)
    cki("identical no -", count_tag(sc2, "-"), 0)
    // Round-trip
    let rt2 = chars_apply("abc", sc2)
    cks("RT2 abc->abc", rt2, "abc")

    // ── KAT 3: empty a, single char b — one "+" op ───────────────────────────
    let sc3 = diff_chars("", "x")
    cki("empty->x len", len(sc3), 1)
    cki("empty->x tag", op_tag(sc3[0]) == "+", 1)
    cks("empty->x char", op_char(sc3[0]), "x")
    // Round-trip
    let rt3 = chars_apply("", sc3)
    cks("RT3 empty->x", rt3, "x")

    // ── KAT 4: non-empty a, empty b — all "-" ops ────────────────────────────
    let sc4 = diff_chars("abc", "")
    cki("abc->empty len", len(sc4), 3)
    cki("abc->empty all -", count_tag(sc4, "-"), 3)
    // Round-trip: chars_apply("abc", script) should yield ""
    let rt4 = chars_apply("abc", sc4)
    cks("RT4 abc->empty", rt4, "")

    // ── KAT 5: cat -> cut (one substitution = one - one +) ───────────────────
    let sc5 = diff_chars("cat", "cut")
    // Expect exactly one "-" (the 'a') and one "+" (the 'u')
    cki("cat->cut deletes", count_tag(sc5, "-"), 1)
    cki("cat->cut inserts", count_tag(sc5, "+"), 1)
    // The deleted char is 'a'
    let found_del_a = 0
    let ci5 = 0
    while ci5 < len(sc5)
        if op_tag(sc5[ci5]) == "-"
            if op_char(sc5[ci5]) == "a"
                found_del_a = 1
        ci5 = ci5 + 1
    cki("cat->cut del=a", found_del_a, 1)
    // The inserted char is 'u'
    let found_ins_u = 0
    let ci5b = 0
    while ci5b < len(sc5)
        if op_tag(sc5[ci5b]) == "+"
            if op_char(sc5[ci5b]) == "u"
                found_ins_u = 1
        ci5b = ci5b + 1
    cki("cat->cut ins=u", found_ins_u, 1)
    // Round-trip
    let rt5 = chars_apply("cat", sc5)
    cks("RT5 cat->cut", rt5, "cut")

    // ── KAT 6: both empty -> empty script ────────────────────────────────────
    let sc6 = diff_chars("", "")
    cki("both-empty len", len(sc6), 0)
    let rt6 = chars_apply("", sc6)
    cks("RT6 empty->empty", rt6, "")

    // ── KAT 7: ROUND-TRIP full replacement abc -> xyz ─────────────────────────
    let sc7 = diff_chars("abc", "xyz")
    let rt7 = chars_apply("abc", sc7)
    cks("RT7 abc->xyz", rt7, "xyz")

    // ── KAT 8: ROUND-TRIP prefix insertion ───────────────────────────────────
    let sc8 = diff_chars("bc", "abc")
    let rt8 = chars_apply("bc", sc8)
    cks("RT8 bc->abc", rt8, "abc")

    // ── KAT 9: ROUND-TRIP suffix deletion ────────────────────────────────────
    let sc9 = diff_chars("hello!", "hello")
    let rt9 = chars_apply("hello!", sc9)
    cks("RT9 hello!->hello", rt9, "hello")

    // ── KAT 10: ROUND-TRIP longer realistic example ───────────────────────────
    let sc10 = diff_chars("sunday", "saturday")
    let rt10 = chars_apply("sunday", sc10)
    cks("RT10 sunday->saturday", rt10, "saturday")

    print("PASS _diff_char_test")
