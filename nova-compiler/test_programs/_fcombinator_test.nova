import std/functional/fcombinator

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn sub(a, b)
    a - b

fn add(a, b)
    a + b

fn sqr(x)
    x * x

fn dbl(x)
    x * 2

fn main()
    // fc_flip(f, a, b) = f(b, a)
    // fc_flip(sub, 3, 10) = sub(10, 3) = 7
    cki("flip_sub_3_10", fc_flip(sub, 3, 10), 7)
    // fc_flip(add, 1, 2) = add(2, 1) = 3
    cki("flip_add_1_2", fc_flip(add, 1, 2), 3)
    // flip is symmetric for commutative ops
    cki("flip_add_comm", fc_flip(add, 5, 9), 14)
    // flip with sub reversed
    cki("flip_sub_10_3", fc_flip(sub, 10, 3), -7)

    // fc_on(f, g, a, b) = f(g(a), g(b))
    // fc_on(add, sqr, 3, 4) = add(sqr(3), sqr(4)) = add(9, 16) = 25
    cki("on_add_sqr_3_4", fc_on(add, sqr, 3, 4), 25)
    // fc_on(sub, dbl, 5, 3) = sub(dbl(5), dbl(3)) = sub(10, 6) = 4
    cki("on_sub_dbl_5_3", fc_on(sub, dbl, 5, 3), 4)
    // fc_on(add, sqr, 0, 0) = 0
    cki("on_add_sqr_0_0", fc_on(add, sqr, 0, 0), 0)

    // fc_apply(f, x) = f(x)
    // fc_apply(sqr, 5) = 25
    cki("apply_sqr_5", fc_apply(sqr, 5), 25)
    cki("apply_dbl_6", fc_apply(dbl, 6), 12)
    cki("apply_sqr_0", fc_apply(sqr, 0), 0)

    // fc_apply2(f, a, b) = f(a, b)
    // fc_apply2(sub, 10, 3) = sub(10, 3) = 7
    cki("apply2_sub_10_3", fc_apply2(sub, 10, 3), 7)
    cki("apply2_add_4_6", fc_apply2(add, 4, 6), 10)

    // fc_twice(f, x) = f(f(x))
    // fc_twice(dbl, 3) = dbl(dbl(3)) = dbl(6) = 12
    cki("twice_dbl_3", fc_twice(dbl, 3), 12)
    // fc_twice(sqr, 2) = sqr(sqr(2)) = sqr(4) = 16
    cki("twice_sqr_2", fc_twice(sqr, 2), 16)
    // fc_twice(dbl, 0) = 0
    cki("twice_dbl_0", fc_twice(dbl, 0), 0)

    print("PASS _fcombinator_test")

main()
