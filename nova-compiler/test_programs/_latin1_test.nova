import std/encoding/latin1

// ── KAT helpers ───────────────────────────────────────────────────────────────

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got [" + got + "] want [" + want + "]")
        exit(1)

fn ckb(label, got, want)
    if got != want
        print("FAIL " + label + ": bool mismatch")
        exit(1)

// ── KAT 1: l1_encode("AB") — basic ASCII bytes ───────────────────────────────
// "AB" = codepoints [65, 66]; encode should yield bytes_len=2, get(0)=65, get(1)=66
let ab_bytes = l1_encode("AB")
cki("encode_AB_len", bytes_len(ab_bytes), 2)
cki("encode_AB_b0", bytes_get(ab_bytes, 0), 65)
cki("encode_AB_b1", bytes_get(ab_bytes, 1), 66)

// ── KAT 2: l1_decode round-trip "AB" ─────────────────────────────────────────
// decode the bytes we just encoded must yield "AB"
let ab_str = l1_decode(ab_bytes)
cks("decode_AB", ab_str, "AB")

// ── KAT 3: round-trip chr(200) ────────────────────────────────────────────────
// chr(200) is U+00C8 (Latin capital E with grave). ord=200, fits in Latin-1.
// encode -> 1 byte = 200, decode -> back to chr(200)
let c200 = chr(200)
let b200 = l1_encode(c200)
cki("encode_c200_len", bytes_len(b200), 1)
cki("encode_c200_b0", bytes_get(b200, 0), 200)
let rt200 = l1_decode(b200)
cks("roundtrip_c200", rt200, c200)

// ── KAT 4: l1_is_latin1("hello") = true ─────────────────────────────────────
// All chars in "hello" are ASCII (ord <= 127 <= 255) -> true
ckb("is_latin1_hello", l1_is_latin1("hello"), true)

// ── KAT 5: bytes_len(l1_encode(s)) == len(s) ─────────────────────────────────
// For a 5-char ASCII string, encode produces exactly 5 bytes
let hello5 = "hello"
let hb = l1_encode(hello5)
cki("encode_hello_len", bytes_len(hb), len(hello5))

// ── KAT 6: decode [72, 105, 33] -> "Hi!" ─────────────────────────────────────
// chr(72)='H', chr(105)='i', chr(33)='!'
let payload = bytes(0)
payload = bytes_append(payload, 72)
payload = bytes_append(payload, 105)
payload = bytes_append(payload, 33)
let decoded = l1_decode(payload)
cks("decode_Hi!", decoded, "Hi!")

// ── KAT 7: l1_is_latin1 with a high Latin-1 character (ord=200 <= 255 -> true)
ckb("is_latin1_c200", l1_is_latin1(chr(200)), true)

// ── KAT 8: l1_encode empty string -> bytes_len 0 ────────────────────────────
let empty_b = l1_encode("")
cki("encode_empty_len", bytes_len(empty_b), 0)

// ── KAT 9: l1_decode empty bytes -> "" ──────────────────────────────────────
let empty_bytes = bytes(0)
let empty_s = l1_decode(empty_bytes)
cks("decode_empty", empty_s, "")

print("_latin1_test passed")
