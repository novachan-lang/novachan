fn test_fn(name: string) -> string
    if name == "print"
        "rt_print"
    else if name == "copy"
        "rt_copy"
    else if name == "len"
        "rt_len"
    else if name == "str"
        "rt_str"
    else if name == "int"
        "rt_int"
    else if name == "push"
        "rt_push"
    else if name == "ord"
        "rt_ord"
    else if name == "chr"
        "rt_chr"
    else if name == "assert"
        "rt_assert"
    else if name == "contains"
        "rt_contains"
    else if name == "del"
        "rt_del"
    else if name == "read_file"
        "rt_read_file"
    else
        name

fn main()
    assert(test_fn("print") == "rt_print", "print branch")
    assert(test_fn("contains") == "rt_contains", "contains branch")
    assert(test_fn("del") == "rt_del", "del branch")
    assert(test_fn("read_file") == "rt_read_file", "read_file branch")
    assert(test_fn("unknown") == "unknown", "default branch")
    print("del_ifelse_test: all passed")
