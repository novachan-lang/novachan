import std/itertools/it_window

// ── helpers ──────────────────────────────────────────────────────────────────

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// cknest: compare a list-of-lists against a reference list-of-lists
fn cknest(label: string, got, wantlist)
    let on = len(wantlist)
    if len(got) != on
        print("FAIL " + label + " outer_len: got=" + str(len(got)) + " want=" + str(on))
        exit(1)
    let i = 0
    while i < on
        let ginner = got[i]
        let winner = wantlist[i]
        let inn = len(winner)
        if len(ginner) != inn
            print("FAIL " + label + "[" + str(i) + "] inner_len: got=" + str(len(ginner)) + " want=" + str(inn))
            exit(1)
        let j = 0
        while j < inn
            if ginner[j] != winner[j]
                print("FAIL " + label + "[" + str(i) + "][" + str(j) + "]: got=" + str(ginner[j]) + " want=" + str(winner[j]))
                exit(1)
            j = j + 1
        i = i + 1

fn main()
    // ── itw_window ────────────────────────────────────────────────────────
    // k=2 basic case
    let r1 = itw_window([1, 2, 3, 4], 2)
    let w1 = [[1, 2], [2, 3], [3, 4]]
    cknest("window_k2", r1, w1)

    // k=3
    let r2 = itw_window([1, 2, 3, 4], 3)
    let w2 = [[1, 2, 3], [2, 3, 4]]
    cknest("window_k3", r2, w2)

    // k=1: each element as singleton window
    let r3 = itw_window([5, 6, 7], 1)
    let w3 = [[5], [6], [7]]
    cknest("window_k1", r3, w3)

    // k == len: single window containing all
    let r4 = itw_window([1, 2, 3], 3)
    let w4 = [[1, 2, 3]]
    cknest("window_k_eq_len", r4, w4)

    // k > len: empty
    let r5 = itw_window([1, 2], 3)
    cki("window_k_over", len(r5), 0)

    // empty input: []
    cki("window_empty", len(itw_window([], 2)), 0)

    // k <= 0: []
    cki("window_k0", len(itw_window([1, 2, 3], 0)), 0)
    cki("window_kneg", len(itw_window([1, 2, 3], -1)), 0)

    // k=2 on length-5 list: 4 windows
    let r6 = itw_window([1, 2, 3, 4, 5], 2)
    let w6 = [[1, 2], [2, 3], [3, 4], [4, 5]]
    cknest("window_5_k2", r6, w6)

    // ── itw_pairwise ──────────────────────────────────────────────────────
    let rp1 = itw_pairwise([1, 2, 3])
    let wp1 = [[1, 2], [2, 3]]
    cknest("pairwise_3", rp1, wp1)

    let rp2 = itw_pairwise([10, 20])
    let wp2 = [[10, 20]]
    cknest("pairwise_2", rp2, wp2)

    // length 1: no pairs
    cki("pairwise_1", len(itw_pairwise([42])), 0)

    // empty
    cki("pairwise_empty", len(itw_pairwise([])), 0)

    // pairwise matches window(xs,2)
    let xs_rt = [3, 1, 4, 1, 5, 9, 2, 6]
    let pw = itw_pairwise(xs_rt)
    let wn = itw_window(xs_rt, 2)
    cki("pairwise_vs_window_len", len(pw), len(wn))

    // ── itw_windows_count ─────────────────────────────────────────────────
    cki("wc_4_2", itw_windows_count([1, 2, 3, 4], 2), 3)
    cki("wc_4_1", itw_windows_count([1, 2, 3, 4], 1), 4)
    cki("wc_4_4", itw_windows_count([1, 2, 3, 4], 4), 1)
    cki("wc_4_5", itw_windows_count([1, 2, 3, 4], 5), 0)
    cki("wc_0_2", itw_windows_count([], 2), 0)
    cki("wc_k0", itw_windows_count([1, 2, 3], 0), 0)

    // Round-trip: windows_count matches len of window output
    let xs_rt2 = [1, 2, 3, 4, 5]
    cki("wc_rt_k2", itw_windows_count(xs_rt2, 2), len(itw_window(xs_rt2, 2)))
    cki("wc_rt_k3", itw_windows_count(xs_rt2, 3), len(itw_window(xs_rt2, 3)))

    // ── itw_triples ───────────────────────────────────────────────────────
    let rt1 = itw_triples([1, 2, 3, 4])
    let wt1 = [[1, 2, 3], [2, 3, 4]]
    cknest("triples_4", rt1, wt1)

    let rt2 = itw_triples([1, 2, 3])
    let wt2 = [[1, 2, 3]]
    cknest("triples_3", rt2, wt2)

    // length 2: no triples
    cki("triples_2", len(itw_triples([1, 2])), 0)

    // empty
    cki("triples_empty", len(itw_triples([])), 0)

    // triples matches window(xs,3)
    let xs_tr = [10, 20, 30, 40, 50]
    let tr = itw_triples(xs_tr)
    let wn3 = itw_window(xs_tr, 3)
    cki("triples_vs_window_len", len(tr), len(wn3))

    print("PASS _it_window_test")
