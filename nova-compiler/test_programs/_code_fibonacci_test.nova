// KAT test for std/compress/code_fibonacci
// Verifies: known-answer bit vectors, round-trips 1..100, sequence round-trip.
import std/compress/code_fibonacci

// ── Helpers ───────────────────────────────────────────────────────────────────

// cki: check integer equality; print FAIL and exit on mismatch.
fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckl_eq: check two lists of ints are equal; print FAIL and exit on mismatch.
fn ckl_eq(label, got, want)
    if len(got) != len(want)
        print("FAIL " + label + " len: got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

// bits_str: convert a list of 0/1 ints to a debug string like "[1,0,1,1]"
fn bits_str(bits) -> string
    let s = "["
    let n = len(bits)
    let i = 0
    while i < n
        if i > 0
            s = s + ","
        s = s + str(bits[i])
        i = i + 1
    s = s + "]"
    s

// make2: build a 2-element list
fn make2(a, b) -> list
    let r = []
    push(r, a)
    push(r, b)
    r

// make3: build a 3-element list
fn make3(a, b, c) -> list
    let r = []
    push(r, a)
    push(r, b)
    push(r, c)
    r

// make4: build a 4-element list
fn make4(a, b, c, d) -> list
    let r = []
    push(r, a)
    push(r, b)
    push(r, c)
    push(r, d)
    r

// make5: build a 5-element list
fn make5(a, b, c, d, e) -> list
    let r = []
    push(r, a)
    push(r, b)
    push(r, c)
    push(r, d)
    push(r, e)
    r

// make6: build a 6-element list
fn make6(a, b, c, d, e, f) -> list
    let r = []
    push(r, a)
    push(r, b)
    push(r, c)
    push(r, d)
    push(r, e)
    push(r, f)
    r

// ── KAT 1: known bit-vector vectors ───────────────────────────────────────────
// Fibonacci sequence used: F[0]=1, F[1]=2, F[2]=3, F[3]=5, F[4]=8, ...
//
// n=1: Zeckendorf=1=F[0].             Payload=[1].     Code=[1,1].
// n=2: Zeckendorf=2=F[1].             Payload=[0,1].   Code=[0,1,1].
// n=3: Zeckendorf=3=F[2].             Payload=[0,0,1]. Code=[0,0,1,1].
// n=4: Zeckendorf=4=3+1=F[2]+F[0].   Payload=[1,0,1]. Code=[1,0,1,1].
// n=5: Zeckendorf=5=F[3].             Payload=[0,0,0,1]. Code=[0,0,0,1,1].
// n=6: Zeckendorf=6=5+1=F[3]+F[0].   Payload=[1,0,0,1]. Code=[1,0,0,1,1].
// n=7: Zeckendorf=7=5+2=F[3]+F[1].   Payload=[0,1,0,1]. Code=[0,1,0,1,1].
// n=8: Zeckendorf=8=F[4].             Payload=[0,0,0,0,1]. Code=[0,0,0,0,1,1].
// n=10: Zeckendorf=10=8+2=F[4]+F[1]. Payload=[0,1,0,0,1]. Code=[0,1,0,0,1,1].
// Note: the task spec's fib_encode(6)==[0,0,0,1,1] is a typographic error
// (that is actually fib_encode(5)); the correct vector is verified below.

let enc1 = fib_encode(1)
ckl_eq("encode_1", enc1, make2(1, 1))

let enc2 = fib_encode(2)
ckl_eq("encode_2", enc2, make3(0, 1, 1))

let enc3 = fib_encode(3)
ckl_eq("encode_3", enc3, make4(0, 0, 1, 1))

let enc4 = fib_encode(4)
ckl_eq("encode_4", enc4, make4(1, 0, 1, 1))

let enc5 = fib_encode(5)
ckl_eq("encode_5", enc5, make5(0, 0, 0, 1, 1))

// n=6: 6=5+1=F[3]+F[0] -> payload=[1,0,0,1] -> code=[1,0,0,1,1]
let enc6 = fib_encode(6)
ckl_eq("encode_6", enc6, make5(1, 0, 0, 1, 1))

// n=7: 7=5+2=F[3]+F[1] -> payload=[0,1,0,1] -> code=[0,1,0,1,1]
let enc7 = fib_encode(7)
ckl_eq("encode_7", enc7, make5(0, 1, 0, 1, 1))

// n=8: 8=F[4] -> payload=[0,0,0,0,1] -> code=[0,0,0,0,1,1]
let enc8 = fib_encode(8)
ckl_eq("encode_8", enc8, make6(0, 0, 0, 0, 1, 1))

// ── KAT 2: decode known vectors ───────────────────────────────────────────────

let d1 = fib_decode(make2(1, 1), 0)
cki("decode_1_val",  d1[0], 1)
cki("decode_1_pos",  d1[1], 2)

let d2 = fib_decode(make3(0, 1, 1), 0)
cki("decode_2_val",  d2[0], 2)
cki("decode_2_pos",  d2[1], 3)

let d3 = fib_decode(make4(0, 0, 1, 1), 0)
cki("decode_3_val",  d3[0], 3)
cki("decode_3_pos",  d3[1], 4)

let d4 = fib_decode(make4(1, 0, 1, 1), 0)
cki("decode_4_val",  d4[0], 4)
cki("decode_4_pos",  d4[1], 4)

let d5 = fib_decode(make5(0, 0, 0, 1, 1), 0)
cki("decode_5_val",  d5[0], 5)
cki("decode_5_pos",  d5[1], 5)

let d6 = fib_decode(make5(1, 0, 0, 1, 1), 0)
cki("decode_6_val",  d6[0], 6)
cki("decode_6_pos",  d6[1], 5)

// ── KAT 3: round-trip 1..100 ─────────────────────────────────────────────────
// For each n in [1..100]: encode then decode must return [n, len(encode(n))].
let rt_n = 1
while rt_n <= 100
    let enc = fib_encode(rt_n)
    let dec = fib_decode(enc, 0)
    if dec[0] != rt_n
        print("FAIL round_trip_" + str(rt_n) + " val: got=" + str(dec[0]) + " want=" + str(rt_n))
        exit(1)
    if dec[1] != len(enc)
        print("FAIL round_trip_" + str(rt_n) + " pos: got=" + str(dec[1]) + " want=" + str(len(enc)))
        exit(1)
    rt_n = rt_n + 1

// ── KAT 4: sequence round-trip (concatenated codes decoded in order) ───────────
// Encode a sequence of values into one concatenated bit-list.
// Decode sequentially using the self-delimiting "11" terminator property.
// This is the key correctness test for stream usage.
let seq_vals = []
push(seq_vals, 1)
push(seq_vals, 2)
push(seq_vals, 3)
push(seq_vals, 5)
push(seq_vals, 8)
push(seq_vals, 13)
push(seq_vals, 21)
push(seq_vals, 100)

// Build concatenated bit-list
let concat = []
let sv_i = 0
while sv_i < len(seq_vals)
    let sv_enc = fib_encode(seq_vals[sv_i])
    let sv_j = 0
    while sv_j < len(sv_enc)
        push(concat, sv_enc[sv_j])
        sv_j = sv_j + 1
    sv_i = sv_i + 1

// Decode sequentially
let seq_pos = 0
let seq_k = 0
while seq_k < len(seq_vals)
    let sv_dec = fib_decode(concat, seq_pos)
    let want_v = seq_vals[seq_k]
    if sv_dec[0] != want_v
        print("FAIL seq_rt[" + str(seq_k) + "] val: got=" + str(sv_dec[0]) + " want=" + str(want_v))
        exit(1)
    seq_pos = sv_dec[1]
    seq_k = seq_k + 1

// ── KAT 5: decode pos offset — decode from middle of a concatenated stream ────
// Encode [4, 7] concatenated; verify we can decode the second value using the
// next_pos returned from decoding the first.
let ab_bits = []
let enc_a = fib_encode(4)
let ab_i = 0
while ab_i < len(enc_a)
    push(ab_bits, enc_a[ab_i])
    ab_i = ab_i + 1
let enc_b = fib_encode(7)
let ab_j = 0
while ab_j < len(enc_b)
    push(ab_bits, enc_b[ab_j])
    ab_j = ab_j + 1

let dec_a = fib_decode(ab_bits, 0)
cki("concat_a_val", dec_a[0], 4)
let dec_b = fib_decode(ab_bits, dec_a[1])
cki("concat_b_val", dec_b[0], 7)

// ── KAT 6: fib_encode(1) special case (shortest code) ────────────────────────
let short = fib_encode(1)
cki("short_len", len(short), 2)
cki("short_b0", short[0], 1)
cki("short_b1", short[1], 1)

// ── KAT 7: code length monotonically non-decreasing for increasing n ──────────
// fib codes are not strictly monotone in length (e.g. n=4 has same length as n=3),
// but length must only increase at Fibonacci boundaries. Verify length is sane
// for 1..20 (all <= 10 bits).
let len_n = 1
while len_n <= 20
    let len_enc = fib_encode(len_n)
    if len(len_enc) < 2
        print("FAIL len_sanity_" + str(len_n) + ": len=" + str(len(len_enc)) + " < 2")
        exit(1)
    if len(len_enc) > 10
        print("FAIL len_sanity_" + str(len_n) + ": len=" + str(len(len_enc)) + " > 10")
        exit(1)
    len_n = len_n + 1

// ── KAT 8: larger round-trips (200, 500, 1000, 9999) ─────────────────────────
let big_vals = []
push(big_vals, 200)
push(big_vals, 500)
push(big_vals, 1000)
push(big_vals, 9999)

let bv_i = 0
while bv_i < len(big_vals)
    let bv = big_vals[bv_i]
    let bv_enc = fib_encode(bv)
    let bv_dec = fib_decode(bv_enc, 0)
    if bv_dec[0] != bv
        print("FAIL big_rt_" + str(bv) + ": got=" + str(bv_dec[0]) + " want=" + str(bv))
        exit(1)
    bv_i = bv_i + 1

// ── KAT 9: invalid input guard ────────────────────────────────────────────────
// fib_encode(0) should return empty list (n < 1 guard).
let enc0 = fib_encode(0)
cki("encode_0_len", len(enc0), 0)

// fib_decode on too-short input should return [-1, len(bits)].
let short_bits = []
push(short_bits, 1)
let bad_dec = fib_decode(short_bits, 0)
cki("decode_short_val", bad_dec[0], -1)

print("PASS _code_fibonacci_test")
