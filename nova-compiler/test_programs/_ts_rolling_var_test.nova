import std/math/ts_rolling_var

fn approx(a: float, b: float, tol: float) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < tol
        return 1
    return 0

fn ck(label: str, got: float, want: float)
    if approx(got, want, 0.0001) == 0
        print("FAIL " + label + " got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // KAT 1: ts_rolling_var([1,2,3], 2) -> [0.25, 0.25]
    // window [1,2]: mean=1.5, deviations -0.5,+0.5, var=(0.25+0.25)/2=0.25
    // window [2,3]: mean=2.5, deviations -0.5,+0.5, var=0.25
    let d1 = [1.0, 2.0, 3.0]
    let r1 = ts_rolling_var(d1, 2)
    if len(r1) != 2
        print("FAIL ts_rolling_var len expected 2 got=" + str(len(r1)))
        exit(1)
    ck("rv_w2[0]", r1[0], 0.25)
    ck("rv_w2[1]", r1[1], 0.25)

    // KAT 2: constant window -> variance = 0.0
    let d2 = [2.0, 2.0, 2.0]
    let r2 = ts_rolling_var(d2, 2)
    if len(r2) != 2
        print("FAIL ts_rolling_var const len expected 2 got=" + str(len(r2)))
        exit(1)
    ck("rv_const[0]", r2[0], 0.0)
    ck("rv_const[1]", r2[1], 0.0)

    // KAT 3: ts_rolling_var([1,3], 2) -> [1.0]
    // mean=2.0, deviations -1,+1, var=(1+1)/2=1.0
    let d3 = [1.0, 3.0]
    let r3 = ts_rolling_var(d3, 2)
    if len(r3) != 1
        print("FAIL ts_rolling_var [1,3] len expected 1 got=" + str(len(r3)))
        exit(1)
    ck("rv_13[0]", r3[0], 1.0)

    // KAT 4: window==len -> single population variance
    // [1,2,3,4]: mean=2.5, deviations -1.5,-0.5,0.5,1.5
    // var = (2.25+0.25+0.25+2.25)/4 = 5.0/4 = 1.25
    let d4 = [1.0, 2.0, 3.0, 4.0]
    let r4 = ts_rolling_var(d4, 4)
    if len(r4) != 1
        print("FAIL ts_rolling_var full len expected 1 got=" + str(len(r4)))
        exit(1)
    ck("rv_full", r4[0], 1.25)

    // KAT 5: window > len -> empty
    let d5 = [1.0, 2.0]
    let r5 = ts_rolling_var(d5, 5)
    if len(r5) != 0
        print("FAIL ts_rolling_var window>len expected 0 got=" + str(len(r5)))
        exit(1)

    // KAT 6: window=3 on [0,0,6,0,0]
    // [0,0,6]: mean=2, var=(4+4+16)/3=8.0
    // [0,6,0]: mean=2, var=(4+16+4)/3=8.0
    // [6,0,0]: mean=2, var=(16+4+4)/3=8.0
    let d6 = [0.0, 0.0, 6.0, 0.0, 0.0]
    let r6 = ts_rolling_var(d6, 3)
    if len(r6) != 3
        print("FAIL ts_rolling_var w3 len expected 3 got=" + str(len(r6)))
        exit(1)
    ck("rv_w3[0]", r6[0], 8.0)
    ck("rv_w3[1]", r6[1], 8.0)
    ck("rv_w3[2]", r6[2], 8.0)

    print("PASS _ts_rolling_var_test")
