import forge_uptime_tracker

fn main()
    let u = ut_new("web-api")
    assert(ut_is_up(u) == 1, "starts up")
    assert(ut_incident_count(u) == 0, "no incidents")
    assert(ut_uptime_pct(u, 100) == 100, "100% uptime")

    u = ut_mark_down(u, 100)
    assert(ut_is_up(u) == 0, "now down")
    assert(ut_incident_count(u) == 1, "1 incident")

    u = ut_mark_up(u, 110)
    assert(ut_is_up(u) == 1, "back up")
    assert(ut_longest_outage(u) == 10, "10 unit outage")

    u = ut_mark_down(u, 200)
    u = ut_mark_up(u, 250)
    assert(ut_incident_count(u) == 2, "2 incidents")
    assert(ut_longest_outage(u) == 50, "longest 50")

    assert(ut_total_downtime(u, 300) == 60, "60 total down")
    let pct = ut_uptime_pct(u, 300)
    assert(pct == 80, "80% uptime")

    u = ut_mark_down(u, 300)
    u = ut_mark_down(u, 310)
    assert(ut_incident_count(u) == 3, "double-down = still 3")

    print("UPTIME-TRACKER KAT PASS")
