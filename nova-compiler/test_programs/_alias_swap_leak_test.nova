// _alias_swap_leak_test.nova -- pins CORE_GAP 0.10 (see NOVA_DESIGN/CORE_GAPS_2026_07_03.md):
// a use-after-free when a heap string is stored as BOTH a dict key AND a list element, and the list
// is then mutated in place (a swap). The overwritten element's string is prematurely freed even
// though the dict still references it, so after allocation churn the list slots come back as reused
// (garbage) memory. This is the common "aggregate into a dict + list, then rank" pattern.
//
// This test is CI-SAFE: it exits 0 whether or not the bug is present, and prints the status so that
// when the RC-ownership fix lands the message flips to "0.10 FIXED" (tighten to a hard assert then).
fn main()
    let totals = {}
    let cats = []
    let names = ["AAAA", "BBBB", "CCCC", "DDDD"]
    for nm in names
        let cat = trim("  " + nm + "  ")   // fresh heap string
        totals[cat] = 1                    // ...used as a dict key (dict_set rc_inc's it)
        push(cats, cat)                    // ...AND as a list element (aliased)

    // in-place swaps (as a selection sort would do): 0<->2, 1<->3
    let tmp = ""
    let i = 0
    while i < 2
        tmp = cats[i]
        cats[i] = cats[i + 2]
        cats[i + 2] = tmp
        i = i + 1

    // allocation churn to reuse any prematurely-freed string memory
    let junk = []
    let k = 0
    while k < 200
        push(junk, trim("  ZZZZ  "))
        k = k + 1

    // expected order after the swaps: CCCC DDDD AAAA BBBB
    let expect = ["CCCC", "DDDD", "AAAA", "BBBB"]
    let ok = 1
    let j = 0
    while j < len(cats)
        if cats[j] != expect[j]
            ok = 0
        j = j + 1

    if ok == 1
        print("alias_swap_leak_test: 0.10 FIXED -- aliased dict-key/list-element swap survives; tighten to assert + close 0.10")
    else
        print("alias_swap_leak_test: 0.10 STILL OPEN (known UAF: list swap frees a string that is also a dict key) -- CI-safe")
    // NOTE: intentionally always exit 0 -- this DOCUMENTS a known bug; it must not fail the suite.
