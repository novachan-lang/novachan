import std/dp/dp_knapsack

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _dp_knapsack_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(label: string, got: list, want: list)
    cki(label + ".len", len(got), len(want))
    let i = 0
    while i < len(want)
        cki(label + "[" + str(i) + "]", got[i], want[i])
        i = i + 1

fn main()
    // ── kp_max_value ─────────────────────────────────────────────────────────
    // classic: w=[1,2,3] v=[6,10,12] cap=5 -> take items 1+2 (w=2+3,v=10+12=22)
    cki("max_5",  kp_max_value([1, 2, 3], [6, 10, 12], 5),  22)
    // only first item fits (cap=1)
    cki("max_1",  kp_max_value([1, 2, 3], [6, 10, 12], 1),   6)
    // capacity 0: nothing fits
    cki("max_0",  kp_max_value([1, 2, 3], [6, 10, 12], 0),   0)
    // w=[2,3,4,5] v=[3,4,5,6] cap=5 -> take w2+w3=5, v3+v4=7
    cki("max_7",  kp_max_value([2, 3, 4, 5], [3, 4, 5, 6], 5), 7)
    // empty lists
    cki("max_empty", kp_max_value([], [], 10), 0)
    // single item too heavy
    cki("max_toobig", kp_max_value([10], [50], 5), 0)
    // single item fits
    cki("max_single", kp_max_value([3], [50], 5), 50)

    // ── kp_selected ──────────────────────────────────────────────────────────
    // w=[1,2,3] v=[6,10,12] cap=5 -> items at indices 1 and 2 (w=2+3=5, v=10+12=22)
    let s5 = kp_selected([1, 2, 3], [6, 10, 12], 5)
    cki("sel_5_len", len(s5), 2)
    // verify total weight <= 5 and total value == 22
    let sv = 0
    let sw = 0
    let si = 0
    while si < len(s5)
        let idx = s5[si]
        sv = sv + [6, 10, 12][idx]
        sw = sw + [1, 2, 3][idx]
        si = si + 1
    cki("sel_5_val",    sv, 22)
    cki("sel_5_wt_ok",  sw <= 5, 1)

    // capacity 0: no items selected
    let s0 = kp_selected([1, 2, 3], [6, 10, 12], 0)
    cki("sel_0_len", len(s0), 0)

    // single item fits: index 0
    let ss1 = kp_selected([3], [50], 5)
    ckl("sel_single", ss1, [0])

    // single item too heavy: empty
    let ss0 = kp_selected([10], [50], 5)
    cki("sel_toobig_len", len(ss0), 0)

    // ── kp_fits_count ────────────────────────────────────────────────────────
    // w=[1,2,3,4] cap=5: lightest combo of 3 = 1+2+3=6>5; max 2 (e.g. 1+2=3 or 1+4=5 or 2+3=5)
    cki("fits_2", kp_fits_count([1, 2, 3, 4], 5), 2)
    // cap=0: nothing fits
    cki("fits_0", kp_fits_count([1, 2, 3], 0), 0)
    // all same weight [2,2,2] cap=6 -> 3 items
    cki("fits_all3", kp_fits_count([2, 2, 2], 6), 3)
    // heavy single [5] cap=4: none
    cki("fits_none", kp_fits_count([5], 4), 0)
    // empty: 0
    cki("fits_empty", kp_fits_count([], 10), 0)

    print("PASS _dp_knapsack_test")
