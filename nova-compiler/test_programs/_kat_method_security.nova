// KAT: forge_method_security -- @PreAuthorize/@Secured-style method guards.
import forge_method_security

fn main()
    let admin = {"roles": ["admin", "user"]}
    let user = {"roles": ["user"]}
    let mod = {"roles": ["mod"]}
    let nobody = {}

    // has_role
    assert(has_role(admin, "admin"), "admin principal has admin role")
    assert(not has_role(user, "admin"), "user principal lacks admin role")
    assert(not has_role(nobody, "admin"), "principal with no roles key is denied, not crashed")

    // has_any_role
    assert(has_any_role(mod, ["admin", "mod"]), "mod matches at least one of admin/mod")
    assert(not has_any_role(user, ["admin", "mod"]), "user matches none of admin/mod")

    // has_all_roles
    assert(has_all_roles(admin, ["admin", "user"]), "admin holds every required role")
    assert(not has_all_roles(user, ["admin", "user"]), "user is missing the admin role")

    // pre_authorize -- single required role, {allowed,value} contract
    let r1 = pre_authorize(admin, "admin", fn() 42)
    assert(r1["allowed"], "admin passes pre_authorize('admin')")
    assert(r1["value"] == 42, "action() result surfaces in value on allow")

    let r2 = pre_authorize(user, "admin", fn() 42)
    assert(not r2["allowed"], "user fails pre_authorize('admin')")
    assert(r2["value"] == 0, "value defaults to 0 on deny")

    // secured -- any-of role list, same {allowed,value} contract
    let r3 = secured(mod, ["admin", "mod"], fn() 99)
    assert(r3["allowed"], "mod passes secured(['admin','mod'])")
    assert(r3["value"] == 99, "action() result surfaces in value on allow")

    let r4 = secured(user, ["admin", "mod"], fn() 99)
    assert(not r4["allowed"], "user fails secured(['admin','mod'])")
    assert(r4["value"] == 0, "value defaults to 0 on deny")

    print("METHOD-SECURITY KAT PASS")
