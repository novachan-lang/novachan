// _topological_test.nova — KAT for std/graph/topological.nova
//
// Hand-computed expected results for each assertion are documented inline.

import std/graph/topological

// ─── helpers ──────────────────────────────────────────────────────────────────

// cks: check-string equality; print FAIL and exit(1) on mismatch.
fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

// cki: check-int equality; print FAIL and exit(1) on mismatch.
fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// list_to_str: convert a list of strings to a bracketed comma-separated string.
fn list_to_str(xs)
    let out = "["
    let i = 0
    while i < len(xs)
        let cur = xs[i]
        if i > 0
            out = out + ","
        out = out + cur
        i = i + 1
    out = out + "]"
    return out

// ─── test graph 1: standard DAG A->B,C; B->D; C->D; D->[] ────────────────────
//
// Expected topological order (deterministic, smallest first at each step):
//   A->B->C->D
// Longest path (in edges): A->B->D = 2 edges, or A->C->D = 2 edges => 2
// Is DAG: true (1)

fn test_dag()
    let adj = {}
    let nbrs_a = []
    nbrs_a.push("B")
    nbrs_a.push("C")
    adj["A"] = nbrs_a

    let nbrs_b = []
    nbrs_b.push("D")
    adj["B"] = nbrs_b

    let nbrs_c = []
    nbrs_c.push("D")
    adj["C"] = nbrs_c

    let nbrs_d = []
    adj["D"] = nbrs_d

    let nodes = []
    nodes.push("A")
    nodes.push("B")
    nodes.push("C")
    nodes.push("D")

    // KAT 1: topological order must be [A,B,C,D]
    let order = tp_sort(adj, nodes)
    cks("tp_sort_dag", list_to_str(order), "[A,B,C,D]")

    // KAT 2: tp_is_dag must be 1
    let is_dag = tp_is_dag(adj, nodes)
    cki("tp_is_dag_true", is_dag, 1)

    // KAT 3: longest path must be 2 edges
    let lp = tp_longest_path_len(adj, nodes)
    cki("tp_longest_path_2", lp, 2)

// ─── test graph 2: cyclic graph A->B, B->A ────────────────────────────────────
//
// Expected: tp_sort returns [], tp_is_dag returns 0

fn test_cycle()
    let adj = {}
    let nbrs_a = []
    nbrs_a.push("B")
    adj["A"] = nbrs_a

    let nbrs_b = []
    nbrs_b.push("A")
    adj["B"] = nbrs_b

    let nodes = []
    nodes.push("A")
    nodes.push("B")

    // KAT 4: tp_sort on cyclic graph must return []
    let order = tp_sort(adj, nodes)
    cks("tp_sort_cycle_empty", list_to_str(order), "[]")

    // KAT 5: tp_is_dag on cyclic graph must be 0
    let is_dag = tp_is_dag(adj, nodes)
    cki("tp_is_dag_false", is_dag, 0)

// ─── test graph 3: single node X with no edges ───────────────────────────────
//
// Expected: tp_sort returns [X]

fn test_single_node()
    let adj = {}
    let nbrs_x = []
    adj["X"] = nbrs_x

    let nodes = []
    nodes.push("X")

    // KAT 6: single node X must appear alone
    let order = tp_sort(adj, nodes)
    cks("tp_sort_single", list_to_str(order), "[X]")

// ─── test graph 4: linear chain A->B->C ──────────────────────────────────────
//
// Expected: tp_sort=[A,B,C]; longest_path=2

fn test_linear_chain()
    let adj = {}
    let nbrs_a = []
    nbrs_a.push("B")
    adj["A"] = nbrs_a

    let nbrs_b = []
    nbrs_b.push("C")
    adj["B"] = nbrs_b

    let nbrs_c = []
    adj["C"] = nbrs_c

    let nodes = []
    nodes.push("A")
    nodes.push("B")
    nodes.push("C")

    // KAT 7: chain order
    let order = tp_sort(adj, nodes)
    cks("tp_sort_chain", list_to_str(order), "[A,B,C]")

    // KAT 8: chain longest path
    let lp = tp_longest_path_len(adj, nodes)
    cki("tp_longest_chain_2", lp, 2)

// ─── run all tests ────────────────────────────────────────────────────────────

test_dag()
test_cycle()
test_single_node()
test_linear_chain()
print("_topological_test passed")
