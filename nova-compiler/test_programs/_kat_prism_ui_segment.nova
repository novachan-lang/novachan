import prism_node
import prism_ui_segment

// Small local test harness: kat_check returns 1 on pass, 0 on fail, printing a
// line that STARTS with "FAIL" (the gate's failure token) when it fails.
fn kat_check(cond: bool, msg: string) -> int
    if cond
        return 1
    else
        print("FAIL: " + msg)
        return 0

// A press-button node's sole child is its label; read the label's rendered text.
fn option_label_text(btn: PrismNode) -> string
    let children = prism_node.prism_node_children(btn)
    let lbl = children[0]
    prism_node.prism_node_attr_str(lbl, "text", "")

// A band/stack container's i-th child is a press-button node; drill through it.
fn segment_label_text(container: PrismNode, i: int) -> string
    let items = prism_node.prism_node_children(container)
    let btn = items[i]
    option_label_text(btn)

fn main()
    let mut pass_count = 0
    let mut total = 0

    print("=== KAT: prism_ui_segment ===")

    // ============================================================
    // Section A: prism_sg_option (12 assertions)
    // ============================================================
    let a1 = prism_ui_segment.prism_sg_option("Alpha", true)
    total += 1
    pass_count += kat_check(is_ok(a1), "A1 option Alpha selected=true is_ok")
    let a1n = unwrap(a1)
    total += 1
    pass_count += kat_check(option_label_text(a1n) == "[*] Alpha", "A2 option Alpha selected=true text")

    let a2 = prism_ui_segment.prism_sg_option("Alpha", false)
    total += 1
    pass_count += kat_check(is_ok(a2), "A3 option Alpha selected=false is_ok")
    let a2n = unwrap(a2)
    total += 1
    pass_count += kat_check(option_label_text(a2n) == "[ ] Alpha", "A4 option Alpha selected=false text")

    let a3 = prism_ui_segment.prism_sg_option("Bravo Two", true)
    total += 1
    pass_count += kat_check(is_ok(a3), "A5 option 'Bravo Two' selected=true is_ok")
    let a3n = unwrap(a3)
    total += 1
    pass_count += kat_check(option_label_text(a3n) == "[*] Bravo Two", "A6 option 'Bravo Two' selected=true text")

    let a4 = prism_ui_segment.prism_sg_option("Z", false)
    total += 1
    pass_count += kat_check(is_ok(a4), "A7 option Z selected=false is_ok")
    let a4n = unwrap(a4)
    total += 1
    pass_count += kat_check(option_label_text(a4n) == "[ ] Z", "A8 option Z selected=false text")

    let a5 = prism_ui_segment.prism_sg_option("", true)
    total += 1
    pass_count += kat_check(is_err(a5), "A9 option empty label selected=true is_err")
    total += 1
    pass_count += kat_check(unwrap_err(a5) == "prism_sg_option: label must not be empty", "A10 option empty label selected=true error text")

    let a6 = prism_ui_segment.prism_sg_option("", false)
    total += 1
    pass_count += kat_check(is_err(a6), "A11 option empty label selected=false is_err")
    total += 1
    pass_count += kat_check(unwrap_err(a6) == "prism_sg_option: label must not be empty", "A12 option empty label selected=false error text")

    // ============================================================
    // Section B: prism_sg_segment (16 assertions)
    // ============================================================
    let b1 = prism_ui_segment.prism_sg_segment(["A", "B", "C"], 0)
    total += 1
    pass_count += kat_check(is_ok(b1), "B1 segment ABC selected=0 is_ok")
    let b1n = unwrap(b1)
    let b1c = prism_node.prism_node_children(b1n)
    total += 1
    pass_count += kat_check(len(b1c) == 3, "B2 segment ABC children count == 3")
    total += 1
    pass_count += kat_check(segment_label_text(b1n, 0) == "[*] A", "B3 segment ABC selected=0 label0")
    total += 1
    pass_count += kat_check(segment_label_text(b1n, 1) == "[ ] B", "B4 segment ABC selected=0 label1")
    total += 1
    pass_count += kat_check(segment_label_text(b1n, 2) == "[ ] C", "B5 segment ABC selected=0 label2")

    let b2 = prism_ui_segment.prism_sg_segment(["A", "B", "C"], 2)
    total += 1
    pass_count += kat_check(is_ok(b2), "B6 segment ABC selected=2 is_ok")
    let b2n = unwrap(b2)
    total += 1
    pass_count += kat_check(segment_label_text(b2n, 2) == "[*] C", "B7 segment ABC selected=2 label2")
    total += 1
    pass_count += kat_check(segment_label_text(b2n, 0) == "[ ] A", "B8 segment ABC selected=2 label0")
    total += 1
    pass_count += kat_check(segment_label_text(b2n, 1) == "[ ] B", "B9 segment ABC selected=2 label1")

    let b3 = prism_ui_segment.prism_sg_segment([], 0)
    total += 1
    pass_count += kat_check(is_err(b3), "B10 segment empty options is_err")
    total += 1
    pass_count += kat_check(unwrap_err(b3) == "prism_sg_segment: options must not be empty", "B11 segment empty options error text")

    let b4 = prism_ui_segment.prism_sg_segment(["A", "B"], 5)
    total += 1
    pass_count += kat_check(is_err(b4), "B12 segment selected out of bounds high is_err")
    total += 1
    pass_count += kat_check(unwrap_err(b4) == "prism_sg_segment: selected 5 out of bounds (0..1)", "B13 segment out of bounds high error text")

    let b5 = prism_ui_segment.prism_sg_segment(["A", "B"], -1)
    total += 1
    pass_count += kat_check(is_err(b5), "B14 segment selected out of bounds negative is_err")
    total += 1
    pass_count += kat_check(unwrap_err(b5) == "prism_sg_segment: selected -1 out of bounds (0..1)", "B15 segment out of bounds negative error text")

    let b6 = prism_ui_segment.prism_sg_segment([1, 2], 0)
    total += 1
    pass_count += kat_check(is_err(b6), "B16 segment non-string option is_err")

    // ============================================================
    // Section C: prism_sg_toggle_group (14 assertions)
    // ============================================================
    let c1 = prism_ui_segment.prism_sg_toggle_group(["X", "Y"], 0)
    total += 1
    pass_count += kat_check(is_ok(c1), "C1 toggle_group XY selected=0 is_ok")
    let c1n = unwrap(c1)
    let c1c = prism_node.prism_node_children(c1n)
    total += 1
    pass_count += kat_check(len(c1c) == 2, "C2 toggle_group XY children count == 2")
    total += 1
    pass_count += kat_check(segment_label_text(c1n, 0) == "[*] X", "C3 toggle_group XY selected=0 label0")
    total += 1
    pass_count += kat_check(segment_label_text(c1n, 1) == "[ ] Y", "C4 toggle_group XY selected=0 label1")

    let c2 = prism_ui_segment.prism_sg_toggle_group(["X", "Y", "Z"], 1)
    total += 1
    pass_count += kat_check(is_ok(c2), "C5 toggle_group XYZ selected=1 is_ok")
    let c2n = unwrap(c2)
    total += 1
    pass_count += kat_check(segment_label_text(c2n, 1) == "[*] Y", "C6 toggle_group XYZ selected=1 label1")
    total += 1
    pass_count += kat_check(segment_label_text(c2n, 0) == "[ ] X", "C7 toggle_group XYZ selected=1 label0")
    total += 1
    pass_count += kat_check(segment_label_text(c2n, 2) == "[ ] Z", "C8 toggle_group XYZ selected=1 label2")

    let c3 = prism_ui_segment.prism_sg_toggle_group([], 0)
    total += 1
    pass_count += kat_check(is_err(c3), "C9 toggle_group empty options is_err")
    total += 1
    pass_count += kat_check(unwrap_err(c3) == "prism_sg_toggle_group: options must not be empty", "C10 toggle_group empty options error text")

    let c4 = prism_ui_segment.prism_sg_toggle_group(["X"], 3)
    total += 1
    pass_count += kat_check(is_err(c4), "C11 toggle_group out of bounds high is_err")
    total += 1
    pass_count += kat_check(unwrap_err(c4) == "prism_sg_toggle_group: selected 3 out of bounds (0..0)", "C12 toggle_group out of bounds high error text")

    let c5 = prism_ui_segment.prism_sg_toggle_group(["X"], -1)
    total += 1
    pass_count += kat_check(is_err(c5), "C13 toggle_group out of bounds negative is_err")

    let c6 = prism_ui_segment.prism_sg_toggle_group([7, 8], 0)
    total += 1
    pass_count += kat_check(is_err(c6), "C14 toggle_group non-string option is_err")

    // ============================================================
    // Section D: prism_sg_multi (21 assertions)
    // ============================================================
    let d1 = prism_ui_segment.prism_sg_multi(["A", "B", "C"], [0, 2])
    total += 1
    pass_count += kat_check(is_ok(d1), "D1 multi ABC selected=[0,2] is_ok")
    let d1n = unwrap(d1)
    let d1c = prism_node.prism_node_children(d1n)
    total += 1
    pass_count += kat_check(len(d1c) == 3, "D2 multi ABC children count == 3")
    total += 1
    pass_count += kat_check(segment_label_text(d1n, 0) == "[*] A", "D3 multi ABC selected=[0,2] label0")
    total += 1
    pass_count += kat_check(segment_label_text(d1n, 1) == "[ ] B", "D4 multi ABC selected=[0,2] label1")
    total += 1
    pass_count += kat_check(segment_label_text(d1n, 2) == "[*] C", "D5 multi ABC selected=[0,2] label2")

    let d2 = prism_ui_segment.prism_sg_multi(["A", "B", "C"], [])
    total += 1
    pass_count += kat_check(is_ok(d2), "D6 multi ABC selected=[] is_ok")
    let d2n = unwrap(d2)
    total += 1
    pass_count += kat_check(segment_label_text(d2n, 0) == "[ ] A", "D7 multi ABC selected=[] label0")
    total += 1
    pass_count += kat_check(segment_label_text(d2n, 1) == "[ ] B", "D8 multi ABC selected=[] label1")
    total += 1
    pass_count += kat_check(segment_label_text(d2n, 2) == "[ ] C", "D9 multi ABC selected=[] label2")

    let d3 = prism_ui_segment.prism_sg_multi(["A", "B"], [0, 1])
    total += 1
    pass_count += kat_check(is_ok(d3), "D10 multi AB selected=[0,1] is_ok")
    let d3n = unwrap(d3)
    total += 1
    pass_count += kat_check(segment_label_text(d3n, 0) == "[*] A", "D11 multi AB selected=[0,1] label0")
    total += 1
    pass_count += kat_check(segment_label_text(d3n, 1) == "[*] B", "D12 multi AB selected=[0,1] label1")

    let d4 = prism_ui_segment.prism_sg_multi([], [0])
    total += 1
    pass_count += kat_check(is_err(d4), "D13 multi empty options is_err")
    total += 1
    pass_count += kat_check(unwrap_err(d4) == "prism_sg_multi: options must not be empty", "D14 multi empty options error text")

    let d5 = prism_ui_segment.prism_sg_multi(["A", "B"], [5])
    total += 1
    pass_count += kat_check(is_err(d5), "D15 multi index out of bounds high is_err")
    total += 1
    pass_count += kat_check(unwrap_err(d5) == "prism_sg_multi: selected index 5 out of bounds (0..1)", "D16 multi index out of bounds high error text")

    let d6 = prism_ui_segment.prism_sg_multi(["A", "B"], [-1])
    total += 1
    pass_count += kat_check(is_err(d6), "D17 multi index out of bounds negative is_err")
    total += 1
    pass_count += kat_check(unwrap_err(d6) == "prism_sg_multi: selected index -1 out of bounds (0..1)", "D18 multi index out of bounds negative error text")

    let d7 = prism_ui_segment.prism_sg_multi(["A", "B"], ["x"])
    total += 1
    pass_count += kat_check(is_err(d7), "D19 multi non-int index is_err")
    total += 1
    pass_count += kat_check(unwrap_err(d7) == "prism_sg_multi: selected index is not an int (got string)", "D20 multi non-int index error text")

    let d8 = prism_ui_segment.prism_sg_multi([9, 10], [0])
    total += 1
    pass_count += kat_check(is_err(d8), "D21 multi non-string option is_err")

    print("TOTAL " + str(pass_count) + "/" + str(total) + " passed")
