import forge_regexmatch

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // classic '*' cases
    fails = fails + expect("aa_a", str(is_match("aa", "a")), "false")
    fails = fails + expect("aa_astar", str(is_match("aa", "a*")), "true")
    fails = fails + expect("ab_dotstar", str(is_match("ab", ".*")), "true")
    fails = fails + expect("aab", str(is_match("aab", "c*a*b")), "true")
    fails = fails + expect("miss", str(is_match("mississippi", "mis*is*p*.")), "false")
    fails = fails + expect("miss2", str(is_match("mississippi", "mis*is*ip*.")), "true")

    // literals + '.'
    fails = fails + expect("exact", str(is_match("abc", "abc")), "true")
    fails = fails + expect("dot", str(is_match("abc", "a.c")), "true")
    fails = fails + expect("dot_no", str(is_match("abc", "a.d")), "false")
    fails = fails + expect("dotstar_c", str(is_match("ab", ".*c")), "false")

    // empty
    fails = fails + expect("empty_empty", str(is_match("", "")), "true")
    fails = fails + expect("empty_astar", str(is_match("", "a*")), "true")
    fails = fails + expect("empty_a", str(is_match("", "a")), "false")

    // '+' one-or-more
    fails = fails + expect("plus_yes", str(is_match("abbb", "ab+")), "true")
    fails = fails + expect("plus_one", str(is_match("ab", "ab+")), "true")
    fails = fails + expect("plus_no", str(is_match("a", "ab+")), "false")
    fails = fails + expect("dotplus", str(is_match("abc", "a.+")), "true")

    // '?' zero-or-one
    fails = fails + expect("opt_with", str(is_match("colour", "colou?r")), "true")
    fails = fails + expect("opt_without", str(is_match("color", "colou?r")), "true")
    fails = fails + expect("opt_toomany", str(is_match("colouur", "colou?r")), "false")
    fails = fails + expect("opt_aaa", str(is_match("aaa", "a?")), "false")

    // combined / realistic
    fails = fails + expect("phone", str(is_match("555", "[0-9]")), "false")
    fails = fails + expect("prefix", str(is_match("hello world", "hello.*")), "true")
    fails = fails + expect("anchored", str(is_match("hello", ".*o")), "true")

    if fails == 0
        print("forge_regexmatch: all passed")
    else
        print("forge_regexmatch: " + str(fails) + " FAILED")
