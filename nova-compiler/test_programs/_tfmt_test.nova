// KAT for std/testing/format
import std/testing/format

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // KAT 1: tfmt_result with ok=true (1)
    cks("result_ok", tfmt_result("test1", 1), "ok - test1")

    // KAT 2: tfmt_result with ok=false (0)
    cks("result_notok", tfmt_result("test2", 0), "not ok - test2")

    // KAT 3: tfmt_summary
    cks("summary", tfmt_summary(3, 1), "3 passed, 1 failed")

    // KAT 4: tfmt_pct normal case
    cki("pct_75", tfmt_pct(3, 4), 75)

    // KAT 5: tfmt_pct division by zero edge case
    cki("pct_zero_total", tfmt_pct(0, 0), 100)

    // KAT 6: tfmt_tap produces correct TAP report
    let results = []
    let row_a = []
    row_a.push("a")
    row_a.push(1)
    let row_b = []
    row_b.push("b")
    row_b.push(0)
    results.push(row_a)
    results.push(row_b)
    let tap = tfmt_tap(results)
    // must contain "1..2"
    ckb("tap_header", find(tap, "1..2") >= 0, 1)
    // must contain "ok - a"
    ckb("tap_ok_a", find(tap, "ok - a") >= 0, 1)
    // must contain "not ok - b"
    ckb("tap_notok_b", find(tap, "not ok - b") >= 0, 1)

    print("_tfmt_test passed")
