import std/numeral/tally

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL tally " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL tally " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // tl_to_tally KAT
    cks("to_tally(0)",  tl_to_tally(0),  "")
    cks("to_tally(3)",  tl_to_tally(3),  "|||")
    cks("to_tally(5)",  tl_to_tally(5),  "|||||")
    cks("to_tally(7)",  tl_to_tally(7),  "||||| ||")
    cks("to_tally(12)", tl_to_tally(12), "||||| ||||| ||")
    cks("to_tally(10)", tl_to_tally(10), "||||| |||||")
    cks("to_tally(1)",  tl_to_tally(1),  "|")
    cks("to_tally(4)",  tl_to_tally(4),  "||||")

    // tl_from_tally KAT
    cki("from_tally(||||| ||)", tl_from_tally("||||| ||"), 7)
    cki("from_tally()",         tl_from_tally(""),         0)
    cki("from_tally(|||)",      tl_from_tally("|||"),      3)
    cki("from_tally(|||||)",    tl_from_tally("|||||"),    5)

    // tl_group_count KAT
    cki("group_count(12)", tl_group_count(12), 2)
    cki("group_count(0)",  tl_group_count(0),  0)
    cki("group_count(5)",  tl_group_count(5),  1)
    cki("group_count(7)",  tl_group_count(7),  1)
    cki("group_count(10)", tl_group_count(10), 2)

    // tl_remainder KAT
    cki("remainder(12)", tl_remainder(12), 2)
    cki("remainder(0)",  tl_remainder(0),  0)
    cki("remainder(5)",  tl_remainder(5),  0)
    cki("remainder(7)",  tl_remainder(7),  2)
    cki("remainder(1)",  tl_remainder(1),  1)

    // Round-trip: tl_from_tally(tl_to_tally(n)) == n
    cki("roundtrip(0)",  tl_from_tally(tl_to_tally(0)),  0)
    cki("roundtrip(1)",  tl_from_tally(tl_to_tally(1)),  1)
    cki("roundtrip(5)",  tl_from_tally(tl_to_tally(5)),  5)
    cki("roundtrip(23)", tl_from_tally(tl_to_tally(23)), 23)
    cki("roundtrip(50)", tl_from_tally(tl_to_tally(50)), 50)
    cki("roundtrip(99)", tl_from_tally(tl_to_tally(99)), 99)

    print("PASS _tally_test")
