import std/complex/complex_poly_eval

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _complex_poly_eval_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL _complex_poly_eval_test " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn ckl2(label: string, got: list, re: int, im: int)
    cki(label + "[re]", got[0], re)
    cki(label + "[im]", got[1], im)

fn main()
    // cxpe_eval([1,0,1],[0,1]) = x^2+1 at i => i^2+1 = -1+1 = 0 => [0,0]
    let r1 = cxpe_eval([1, 0, 1], [0, 1])
    ckl2("eval_x2p1_at_i", r1, 0, 0)

    // cxpe_eval([2,3],[1,1]) = 2+3*(1+i) = 2+3+3i = 5+3i => [5,3]
    let r2 = cxpe_eval([2, 3], [1, 1])
    ckl2("eval_2p3z_at_1pi", r2, 5, 3)

    // cxpe_eval([1,1,1],[0,1]) = 1+i+i^2 = 1+i-1 = i => [0,1]
    let r3 = cxpe_eval([1, 1, 1], [0, 1])
    ckl2("eval_1pzpz2_at_i", r3, 0, 1)

    // cxpe_eval([0,0,1],[2,3]) = (2+3i)^2 = 4-9+12i = -5+12i => [-5,12]
    let r4 = cxpe_eval([0, 0, 1], [2, 3])
    ckl2("eval_z2_at_2p3i", r4, 0 - 5, 12)

    // cxpe_eval([5],[9,9]) = constant 5 => [5,0]
    let r5 = cxpe_eval([5], [9, 9])
    ckl2("eval_const5", r5, 5, 0)

    // cxpe_eval_at_i([1,0,1]) = same as first case => [0,0]
    let r6 = cxpe_eval_at_i([1, 0, 1])
    ckl2("eval_at_i_x2p1", r6, 0, 0)

    print("PASS _complex_poly_eval_test")
