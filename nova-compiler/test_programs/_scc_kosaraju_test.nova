import std/graph/scc_kosaraju

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn main()
    // KAT1: 3-cycle 0->1->2->0, single SCC
    let adj1 = []
    let a1r0 = []
    a1r0.push(1)
    adj1.push(a1r0)
    let a1r1 = []
    a1r1.push(2)
    adj1.push(a1r1)
    let a1r2 = []
    a1r2.push(0)
    adj1.push(a1r2)
    cki("kat1_count_cycle3", scc_kosaraju.sk_count(adj1, 3), 1)
    ckb("kat2_same_0_2", scc_kosaraju.sk_same(adj1, 3, 0, 2), true)

    // KAT2: 0->1->2 chain, 3 SCCs (each node alone)
    let adj2 = []
    let a2r0 = []
    a2r0.push(1)
    adj2.push(a2r0)
    let a2r1 = []
    a2r1.push(2)
    adj2.push(a2r1)
    let a2r2 = []
    adj2.push(a2r2)
    cki("kat3_count_chain", scc_kosaraju.sk_count(adj2, 3), 3)
    ckb("kat4_same_0_2_chain", scc_kosaraju.sk_same(adj2, 3, 0, 2), false)

    // KAT3: 4-node: 0->1->0 (cycle), 2->3->2 (cycle), cross edge 1->2
    // adj[0]=[1], adj[1]=[0,2], adj[2]=[3], adj[3]=[2]  => 2 SCCs: {0,1},{2,3}
    let adj3 = []
    let a3r0 = []
    a3r0.push(1)
    adj3.push(a3r0)
    let a3r1 = []
    a3r1.push(0)
    a3r1.push(2)
    adj3.push(a3r1)
    let a3r2 = []
    a3r2.push(3)
    adj3.push(a3r2)
    let a3r3 = []
    a3r3.push(2)
    adj3.push(a3r3)
    cki("kat5_count_two_sccs", scc_kosaraju.sk_count(adj3, 4), 2)
    // spec: sk_count([[1],[0,2],[3],[2]],4)=2
    let adj3b = []
    let a3br0 = []
    a3br0.push(1)
    adj3b.push(a3br0)
    let a3br1 = []
    a3br1.push(0)
    a3br1.push(2)
    adj3b.push(a3br1)
    let a3br2 = []
    a3br2.push(3)
    adj3b.push(a3br2)
    let a3br3 = []
    a3br3.push(2)
    adj3b.push(a3br3)
    cki("kat6_spec_4node", scc_kosaraju.sk_count(adj3b, 4), 2)

    // KAT4: all isolated nodes (no edges), n=3 => 3 SCCs
    let adj4 = []
    adj4.push([])
    adj4.push([])
    adj4.push([])
    cki("kat7_isolated_count", scc_kosaraju.sk_count(adj4, 3), 3)

    // KAT5: sk_same on isolated nodes: 0 and 2 not same
    ckb("kat8_isolated_same", scc_kosaraju.sk_same(adj4, 3, 0, 2), false)

    // KAT6: sk_components on chain => [[0],[1],[2]] (each node its own SCC)
    let comps2 = scc_kosaraju.sk_components(adj2, 3)
    cki("kat9_chain_comps_len", len(comps2), 3)
    cki("kat10_comp0_node", comps2[0][0], 0)
    cki("kat11_comp1_node", comps2[1][0], 1)
    cki("kat12_comp2_node", comps2[2][0], 2)

    // KAT7: sk_components on cycle => [[0,1,2]]
    let comps1 = scc_kosaraju.sk_components(adj1, 3)
    cki("kat13_cycle_comps_len", len(comps1), 1)
    cki("kat14_cycle_comp_len", len(comps1[0]), 3)
    cki("kat15_cycle_comp_0", comps1[0][0], 0)
    cki("kat16_cycle_comp_1", comps1[0][1], 1)
    cki("kat17_cycle_comp_2", comps1[0][2], 2)

    // KAT8: n=0 empty graph
    let adj0 = []
    cki("kat18_empty_count", scc_kosaraju.sk_count(adj0, 0), 0)

    print("PASS _scc_kosaraju_test")

main()
