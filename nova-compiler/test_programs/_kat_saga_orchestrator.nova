import forge_saga_orchestrator

fn main()
    let so = so_new("order-saga")
    so = so_add_step(so, "reserve-stock", "release-stock")
    so = so_add_step(so, "charge-payment", "refund-payment")
    so = so_add_step(so, "ship-order", "cancel-shipment")
    assert(so_step_count(so) == 3, "3 steps")
    assert(so_status(so) == "pending", "pending")

    assert(so_current_step_name(so) == "reserve-stock", "first step")
    so = so_execute_next(so)
    assert(so_status(so) == "running", "running")
    assert(so_completed_count(so) == 1, "1 completed")
    assert(so_step_status(so, "reserve-stock") == "done", "stock done")

    so = so_execute_next(so)
    assert(so_completed_count(so) == 2, "2 completed")
    assert(so_current_step_name(so) == "ship-order", "at ship step")

    so = so_fail_current(so)
    assert(so_status(so) == "compensating", "compensating")
    assert(so_step_status(so, "ship-order") == "failed", "ship failed")

    so = so_compensate(so)
    assert(so_status(so) == "compensated", "compensated")
    assert(so_compensated_count(so) == 2, "2 compensated")
    assert(so_step_status(so, "reserve-stock") == "compensated", "stock compensated")
    assert(so_step_status(so, "charge-payment") == "compensated", "payment compensated")

    let so2 = so_new("simple")
    so2 = so_add_step(so2, "do-thing", "undo-thing")
    so2 = so_execute_next(so2)
    assert(so_status(so2) == "completed", "single step completed")

    assert(so_step_status(so2, "nonexistent") == "", "missing step")

    print("SAGA-ORCHESTRATOR KAT PASS")
