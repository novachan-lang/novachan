import forge_saga_orchestrator

fn main()
    let s = saga_new()
    s = saga_add_step(s, "debit")
    s = saga_add_step(s, "ship")
    s = saga_add_step(s, "notify")
    assert(saga_step_count(s) == 3, "3 steps")
    assert(saga_status(s) == "pending", "pending")

    let r1 = saga_execute_step(s)
    assert(is_ok(r1), "step 1 ok")
    s = unwrap(r1)
    assert(saga_status(s) == "running", "running")
    assert(saga_progress(s) == 33, "33%")

    let r2 = saga_execute_step(s)
    assert(is_ok(r2), "step 2 ok")
    s = unwrap(r2)

    s = saga_fail_step(s, "ship failed")
    assert(saga_status(s) == "failed", "failed")

    s = saga_compensate(s)
    assert(saga_status(s) == "compensated", "compensated")
    assert(saga_compensated_count(s) == 2, "2 compensated")

    let name = saga_step_name(s, 0)
    assert(is_ok(name), "step name ok")
    assert(unwrap(name) == "debit", "step 0 = debit")

    let bad = saga_step_name(s, 99)
    assert(is_err(bad), "out of range")

    print("SAGA-ORCHESTRATOR KAT PASS")
