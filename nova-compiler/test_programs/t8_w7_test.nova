// Track 8 W7: auto-arena. No spawn anywhere, no manual set_arena_mode.
// Compiler should detect no-spawn and emit set_arena_mode(1) automatically
// when NOVA_AUTO_ARENA=1. Result: 0 RC ops, just like t8_w6_test.

fn build_strings(n: int) -> int
    let xs = []
    let i = 0
    while i < n
        xs.push("elem_" + str(i))
        i = i + 1
    len(xs)

fn main()
    let total = 0
    let k = 0
    while k < 30
        total = total + build_strings(80)
        k = k + 1
    print(total)
    rc_stats_dump()
