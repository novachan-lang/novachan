import std/raster/sprite_mask

fn cki(label, got, want)
    if got != want
        print("FAIL sprite_mask " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── KAT 1: sm_from_bits creates correct mask ──────────────────────────────
    let bits_a = []
    bits_a.push(1)
    bits_a.push(0)
    bits_a.push(0)
    bits_a.push(1)
    let a = sm_from_bits(2, 2, bits_a)
    cki("a_0_0", sm_get(a, 0, 0), 1)
    cki("a_1_0", sm_get(a, 1, 0), 0)
    cki("a_0_1", sm_get(a, 0, 1), 0)
    cki("a_1_1", sm_get(a, 1, 1), 1)

    // ── KAT 2: sm_get out-of-bounds returns 0 ────────────────────────────────
    cki("get_oob_neg", sm_get(a, -1, 0), 0)
    cki("get_oob_w", sm_get(a, 2, 0), 0)
    cki("get_oob_h", sm_get(a, 0, 2), 0)

    // ── KAT 3: sm_count ───────────────────────────────────────────────────────
    cki("count_a", sm_count(a), 2)

    // ── KAT 4: sm_collides — a and b have no overlapping set pixels ────────────
    let bits_b = []
    bits_b.push(0)
    bits_b.push(1)
    bits_b.push(1)
    bits_b.push(0)
    let b = sm_from_bits(2, 2, bits_b)
    // a set at (0,0),(1,1); b set at (1,0),(0,1) — complementary
    cki("collide_a_b_false", sm_collides(a, 0, 0, b, 0, 0), 0)

    // ── KAT 5: sm_collides — a overlaps itself ────────────────────────────────
    cki("collide_a_a_true", sm_collides(a, 0, 0, a, 0, 0), 1)

    // ── KAT 6: sm_collides — shifted so no overlap ───────────────────────────
    cki("collide_a_b_shifted", sm_collides(a, 0, 0, b, 10, 10), 0)

    // ── KAT 7: sm_collides — b shifted to overlap a ──────────────────────────
    // a at (0,0): set=(0,0),(1,1). b at (1,1): b's (0,0) = world (1,1) = b bit[0,0]=0; b's (0,0)=0... wait:
    // b bits = [0,1,1,0] so b[0,0]=0, b[1,0]=1, b[0,1]=1, b[1,1]=0.
    // b at world offset (1,1): b's (0,0) maps to world (1,1); b[0,0]=0 and a[1,1]=1 -> no hit
    //                          b's (1,0) maps to world (2,1); out of a's 2x2 extent -> no hit
    //                          b's (0,1) maps to world (1,2); out of a -> no hit
    //                          b's (1,1) maps to world (2,2); out of a -> no hit
    // So no collision expected:
    cki("collide_a_b_shift11", sm_collides(a, 0, 0, b, 1, 1), 0)
    // b at world offset (-1,-1): b's (1,0) maps to world (0,-1) out; b's (0,1) maps to world (-1,0) out;
    // b's (1,1) maps to world (0,0) = b[1,1]=0; no match
    cki("collide_a_b_shiftneg", sm_collides(a, 0, 0, b, -1, -1), 0)
    // a and b at same pos with a overlapping b: use two all-1 masks
    let bits_all = []
    bits_all.push(1)
    bits_all.push(1)
    bits_all.push(1)
    bits_all.push(1)
    let full = sm_from_bits(2, 2, bits_all)
    cki("collide_full_full", sm_collides(full, 0, 0, full, 0, 0), 1)
    cki("collide_full_full_shifted", sm_collides(full, 0, 0, full, 5, 5), 0)

    // ── KAT 8: sm_and(a, all_ones) == a ─────────────────────────────────────
    let anded = sm_and(a, full)
    cki("and_0_0", sm_get(anded, 0, 0), 1)
    cki("and_1_0", sm_get(anded, 1, 0), 0)
    cki("and_0_1", sm_get(anded, 0, 1), 0)
    cki("and_1_1", sm_get(anded, 1, 1), 1)

    // ── KAT 9: sm_or(a, b) has count 4 ──────────────────────────────────────
    let ored = sm_or(a, b)
    cki("or_count", sm_count(ored), 4)
    cki("or_0_0", sm_get(ored, 0, 0), 1)
    cki("or_1_0", sm_get(ored, 1, 0), 1)
    cki("or_0_1", sm_get(ored, 0, 1), 1)
    cki("or_1_1", sm_get(ored, 1, 1), 1)

    // ── KAT 10: sm_and(a, b) == 0 (complementary masks) ─────────────────────
    let anded2 = sm_and(a, b)
    cki("and_ab_count", sm_count(anded2), 0)

    // ── KAT 11: sm_bbox_overlap ──────────────────────────────────────────────
    cki("bbox_overlap_true", sm_bbox_overlap(0, 0, 2, 2, 1, 1, 2, 2), 1)
    cki("bbox_overlap_false", sm_bbox_overlap(0, 0, 2, 2, 5, 5, 2, 2), 0)
    cki("bbox_overlap_touch_edge", sm_bbox_overlap(0, 0, 2, 2, 2, 0, 2, 2), 0)
    cki("bbox_overlap_partial", sm_bbox_overlap(0, 0, 3, 3, 2, 2, 3, 3), 1)

    // ── KAT 12: sm_invert ────────────────────────────────────────────────────
    let inv = sm_invert(a)
    cki("invert_0_0", sm_get(inv, 0, 0), 0)
    cki("invert_1_0", sm_get(inv, 1, 0), 1)
    cki("invert_0_1", sm_get(inv, 0, 1), 1)
    cki("invert_1_1", sm_get(inv, 1, 1), 0)
    cki("invert_count", sm_count(inv), 2)

    // ── KAT 13: sm_outline — 3x3 all-set has inner pixel not on outline ──────
    let bits3x3 = []
    bits3x3.push(1)
    bits3x3.push(1)
    bits3x3.push(1)
    bits3x3.push(1)
    bits3x3.push(1)
    bits3x3.push(1)
    bits3x3.push(1)
    bits3x3.push(1)
    bits3x3.push(1)
    let sq = sm_from_bits(3, 3, bits3x3)
    let outline = sm_outline(sq)
    cki("outline_center_0", sm_get(outline, 1, 1), 0)
    cki("outline_edge_top", sm_get(outline, 1, 0), 1)
    cki("outline_edge_left", sm_get(outline, 0, 1), 1)
    cki("outline_corner", sm_get(outline, 0, 0), 1)

    // ── KAT 14: sm_outline of diagonal mask has all pixels on outline ─────────
    // a = diagonal mask: (0,0)=1, (1,1)=1 — both are edge pixels since they have unset neighbours
    let outline_a = sm_outline(a)
    cki("outline_a_0_0", sm_get(outline_a, 0, 0), 1)
    cki("outline_a_1_1", sm_get(outline_a, 1, 1), 1)
    cki("outline_a_1_0", sm_get(outline_a, 1, 0), 0)

    // ── KAT 15: sm_from_bits normalizes non-zero to 1 ────────────────────────
    let bits_n = []
    bits_n.push(5)
    bits_n.push(0)
    bits_n.push(0)
    bits_n.push(255)
    let mn = sm_from_bits(2, 2, bits_n)
    cki("norm_0_0", sm_get(mn, 0, 0), 1)
    cki("norm_1_0", sm_get(mn, 1, 0), 0)
    cki("norm_1_1", sm_get(mn, 1, 1), 1)

    print("PASS _sprite_mask_test")
