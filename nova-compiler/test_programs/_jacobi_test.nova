// _jacobi_test.nova — KAT for std/math/jacobi.nova
// Tests Jacobi symbol, Legendre symbol, and quadratic residue detection.
// Each assertion prints FAIL + exits with code 1 on mismatch.

import std/math/jacobi

// KAT 1: jc_legendre(2, 7) == 1
// 7 ≡ 7 (mod 8); stripping the factor of 2 gives sign factor (-1)^((49-1)/8) = (-1)^6 = 1
let kat1 = jc_legendre(2, 7)
if kat1 != 1
    print("FAIL: jc_legendre(2,7) expected 1 got " + str(kat1))
    exit(1)

// KAT 2: jc_legendre(3, 7) == -1
// 3 is not a quadratic residue mod 7 (QRs mod 7 are 1, 2, 4)
let kat2 = jc_legendre(3, 7)
if kat2 != -1
    print("FAIL: jc_legendre(3,7) expected -1 got " + str(kat2))
    exit(1)

// KAT 3: jc_jacobi(1001, 9907) == -1
// Verified by hand-trace of iterative algorithm (see module comments)
let kat3 = jc_jacobi(1001, 9907)
if kat3 != -1
    print("FAIL: jc_jacobi(1001,9907) expected -1 got " + str(kat3))
    exit(1)

// KAT 4: jc_jacobi(2, 15) == 1
// 15 = 3×5; (2/3)=-1 and (2/5)=-1; product = +1
let kat4 = jc_jacobi(2, 15)
if kat4 != 1
    print("FAIL: jc_jacobi(2,15) expected 1 got " + str(kat4))
    exit(1)

// KAT 5: jc_jacobi(3, 15) == 0
// gcd(3,15) = 3 > 1, so symbol is 0
let kat5 = jc_jacobi(3, 15)
if kat5 != 0
    print("FAIL: jc_jacobi(3,15) expected 0 got " + str(kat5))
    exit(1)

// KAT 6: jc_legendre(1, 7) == 1
// 1 is always a perfect square (1 = 1^2), so Legendre symbol is 1
let kat6 = jc_legendre(1, 7)
if kat6 != 1
    print("FAIL: jc_legendre(1,7) expected 1 got " + str(kat6))
    exit(1)

// KAT 7: jc_is_qr(2, 7) == true
// 2 is a quadratic residue mod 7 (3^2 = 9 ≡ 2 mod 7)
let kat7 = jc_is_qr(2, 7)
if kat7 != true
    print("FAIL: jc_is_qr(2,7) expected true got " + str(kat7))
    exit(1)

// KAT 8: jc_is_qr(3, 7) == false
// 3 is not a quadratic residue mod 7
let kat8 = jc_is_qr(3, 7)
if kat8 != false
    print("FAIL: jc_is_qr(3,7) expected false got " + str(kat8))
    exit(1)

print("_jacobi_test passed")
