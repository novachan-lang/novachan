import forge_dead_letter_queue

fn main()
    let d = dlq_new(3)
    assert(dlq_count(d) == 0, "empty")

    d = dlq_fail(d, "msg-1", "timeout")
    assert(dlq_count(d) == 0, "1 retry, not dead yet")
    assert(dlq_retry_count(d, "msg-1") == 1, "1 retry")

    d = dlq_fail(d, "msg-1", "timeout")
    assert(dlq_count(d) == 0, "2 retries, not dead")

    d = dlq_fail(d, "msg-1", "timeout")
    assert(dlq_count(d) == 1, "dead after 3 retries")
    assert(dlq_msg_id(d, 0) == "msg-1", "msg-1 in DLQ")
    assert(dlq_msg_reason(d, 0) == "timeout", "reason timeout")
    assert(dlq_total_dead(d) == 1, "1 total dead")

    d = dlq_fail(d, "msg-2", "parse_error")
    d = dlq_fail(d, "msg-2", "parse_error")
    d = dlq_fail(d, "msg-2", "parse_error")
    assert(dlq_count(d) == 2, "2 dead")

    let r = dlq_replay(d, 0)
    d = r["d"]
    assert(r["ok"] == 1, "replay ok")
    assert(r["msg_id"] == "msg-1", "replayed msg-1")
    assert(dlq_total_replayed(d) == 1, "1 replayed")

    let r2 = dlq_replay(d, 99)
    d = r2["d"]
    assert(r2["ok"] == 0, "out of range")

    print("DEAD-LETTER-QUEUE KAT PASS")
