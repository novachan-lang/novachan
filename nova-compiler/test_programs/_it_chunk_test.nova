import std/itertools/it_chunk

// ── helpers ──────────────────────────────────────────────────────────────────

fn _join(xs) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + ","
        out = out + str(xs[i])
        i = i + 1
    return out

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckflat: compare a flat int list element-wise against a string like "1,2,3"
fn ckflat(label: string, got, wantlist)
    let wn = len(wantlist)
    if len(got) != wn
        print("FAIL " + label + " len: got=" + str(len(got)) + " want=" + str(wn))
        exit(1)
    let i = 0
    while i < wn
        if got[i] != wantlist[i]
            print("FAIL " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(wantlist[i]))
            exit(1)
        i = i + 1

// cknest: compare a list-of-lists against a reference list-of-lists
fn cknest(label: string, got, wantlist)
    let on = len(wantlist)
    if len(got) != on
        print("FAIL " + label + " outer_len: got=" + str(len(got)) + " want=" + str(on))
        exit(1)
    let i = 0
    while i < on
        let ginner = got[i]
        let winner = wantlist[i]
        let inn = len(winner)
        if len(ginner) != inn
            print("FAIL " + label + "[" + str(i) + "] inner_len: got=" + str(len(ginner)) + " want=" + str(inn))
            exit(1)
        let j = 0
        while j < inn
            if ginner[j] != winner[j]
                print("FAIL " + label + "[" + str(i) + "][" + str(j) + "]: got=" + str(ginner[j]) + " want=" + str(winner[j]))
                exit(1)
            j = j + 1
        i = i + 1

fn main()
    // ── itc_chunk ──────────────────────────────────────────────────────────
    // Basic: odd length, last chunk short
    let r1 = itc_chunk([1, 2, 3, 4, 5], 2)
    let w1 = [[1, 2], [3, 4], [5]]
    cknest("chunk_odd", r1, w1)

    // Even: divides exactly
    let r2 = itc_chunk([1, 2, 3, 4], 2)
    let w2 = [[1, 2], [3, 4]]
    cknest("chunk_even", r2, w2)

    // size=1: each element its own chunk
    let r3 = itc_chunk([7, 8, 9], 1)
    let w3 = [[7], [8], [9]]
    cknest("chunk_size1", r3, w3)

    // size >= len: single chunk
    let r4 = itc_chunk([1, 2, 3], 10)
    let w4 = [[1, 2, 3]]
    cknest("chunk_oversize", r4, w4)

    // empty input
    let r5 = itc_chunk([], 2)
    cki("chunk_empty", len(r5), 0)

    // size <= 0: return []
    cki("chunk_size0", len(itc_chunk([1, 2, 3], 0)), 0)
    cki("chunk_sizeneg", len(itc_chunk([1, 2, 3], -1)), 0)

    // size=3 on 6 elements
    let r6 = itc_chunk([1, 2, 3, 4, 5, 6], 3)
    let w6 = [[1, 2, 3], [4, 5, 6]]
    cknest("chunk_3", r6, w6)

    // ── itc_chunk_pad ─────────────────────────────────────────────────────
    // Last chunk padded
    let rp1 = itc_chunk_pad([1, 2, 3, 4, 5], 2, 0)
    let wp1 = [[1, 2], [3, 4], [5, 0]]
    cknest("chunk_pad_odd", rp1, wp1)

    // Exact fit: no padding needed
    let rp2 = itc_chunk_pad([1, 2, 3, 4], 2, 0)
    let wp2 = [[1, 2], [3, 4]]
    cknest("chunk_pad_exact", rp2, wp2)

    // size=3, xs has 5 elements: last chunk [5, pad, pad]
    let rp3 = itc_chunk_pad([1, 2, 3, 4, 5], 3, 99)
    let wp3 = [[1, 2, 3], [4, 5, 99]]
    cknest("chunk_pad3", rp3, wp3)

    // empty input: []
    let rp4 = itc_chunk_pad([], 3, 0)
    cki("chunk_pad_empty", len(rp4), 0)

    // ── itc_chunk_count ───────────────────────────────────────────────────
    cki("count_5_2", itc_chunk_count([1, 2, 3, 4, 5], 2), 3)
    cki("count_4_2", itc_chunk_count([1, 2, 3, 4], 2), 2)
    cki("count_0_2", itc_chunk_count([], 2), 0)
    cki("count_size0", itc_chunk_count([1, 2, 3], 0), 0)
    cki("count_6_3", itc_chunk_count([1, 2, 3, 4, 5, 6], 3), 2)
    cki("count_1_1", itc_chunk_count([42], 1), 1)

    // ── itc_evenly ────────────────────────────────────────────────────────
    // 5 elements into 2 chunks: [1,2,3] and [4,5]
    let re1 = itc_evenly([1, 2, 3, 4, 5], 2)
    let we1 = [[1, 2, 3], [4, 5]]
    cknest("evenly_5_2", re1, we1)

    // 6 elements into 3 chunks: [1,2],[3,4],[5,6]
    let re2 = itc_evenly([1, 2, 3, 4, 5, 6], 3)
    let we2 = [[1, 2], [3, 4], [5, 6]]
    cknest("evenly_6_3", re2, we2)

    // 5 elements into 3 chunks: [1,2],[3,4],[5]
    let re3 = itc_evenly([1, 2, 3, 4, 5], 3)
    let we3 = [[1, 2], [3, 4], [5]]
    cknest("evenly_5_3", re3, we3)

    // n=1: single chunk containing everything
    let re4 = itc_evenly([1, 2, 3], 1)
    let we4 = [[1, 2, 3]]
    cknest("evenly_n1", re4, we4)

    // n >= len: each element its own chunk
    let re5 = itc_evenly([1, 2, 3], 3)
    let we5 = [[1], [2], [3]]
    cknest("evenly_n_eq_len", re5, we5)

    // empty: []
    cki("evenly_empty", len(itc_evenly([], 2)), 0)

    // n <= 0: []
    cki("evenly_n0", len(itc_evenly([1, 2, 3], 0)), 0)

    // Round-trip: itc_chunk_count matches len of itc_chunk
    let xs_rt = [1, 2, 3, 4, 5, 6, 7]
    cki("rt_count_match", itc_chunk_count(xs_rt, 3), len(itc_chunk(xs_rt, 3)))

    print("PASS _it_chunk_test")
