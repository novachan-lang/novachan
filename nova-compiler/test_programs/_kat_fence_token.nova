import forge_fence_token

fn main()
    let ft = ft_new()
    assert(ft_current_token(ft) == 0, "starts at 0")

    let r1 = ft_acquire(ft, "worker-a")
    ft = r1["ft"]
    let t1 = r1["token"]
    assert(t1 == 1, "first token = 1")
    assert(ft_current_token(ft) == 1, "counter = 1")

    let r2 = ft_acquire(ft, "worker-b")
    ft = r2["ft"]
    let t2 = r2["token"]
    assert(t2 == 2, "second token = 2")

    assert(ft_validate(ft, "worker-a", t1) == 1, "worker-a valid")
    assert(ft_validate(ft, "worker-b", t2) == 1, "worker-b valid")

    assert(ft_validate(ft, "worker-a", 999) == 0, "wrong token invalid")
    assert(ft_validate(ft, "nobody", 1) == 0, "unknown owner invalid")

    assert(ft_is_latest(ft, t2) == 1, "t2 is latest")
    assert(ft_is_latest(ft, t1) == 0, "t1 not latest")

    ft = ft_revoke(ft, "worker-a")
    assert(ft_validate(ft, "worker-a", t1) == 0, "revoked = invalid")
    assert(ft_validate(ft, "worker-b", t2) == 1, "worker-b still valid")

    assert(ft_owner_token(ft, "worker-b") == 2, "owner lookup")
    assert(ft_owner_token(ft, "ghost") == 0, "unknown owner = 0")

    print("FENCE-TOKEN KAT PASS")
