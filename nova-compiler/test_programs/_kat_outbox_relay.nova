import forge_outbox_relay

fn main()
    let o = or_new()
    assert(or_total_count(o) == 0, "starts empty")

    o = or_add(o, "orders", "order-created-1")
    o = or_add(o, "orders", "order-created-2")
    o = or_add(o, "payments", "payment-1")
    assert(or_total_count(o) == 3, "3 messages")
    assert(or_pending_count(o) == 3, "3 pending")

    let r1 = or_relay_next(o)
    o = r1["o"]
    assert(r1["found"] == 1, "found pending")
    assert(r1["topic"] == "orders", "topic orders")
    assert(r1["payload"] == "order-created-1", "first payload")
    assert(or_relayed_count(o) == 1, "1 relayed")

    let r2 = or_relay_next(o)
    o = r2["o"]
    assert(r2["found"] == 1, "second relay found")
    assert(or_pending_count(o) == 1, "1 pending left")

    o = or_fail(o, 3)
    let retried = or_retry_failed(o)
    assert(retried == 1, "1 retried")

    let r3 = or_relay_next(o)
    o = r3["o"]
    assert(r3["found"] == 1, "retried message found")
    assert(r3["topic"] == "payments", "retried = payments")

    print("OUTBOX-RELAY KAT PASS")
