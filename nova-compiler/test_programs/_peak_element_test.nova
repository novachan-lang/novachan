import std/search/peak_element

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL peak_element " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let g = 0
    let w = 0
    if got
        g = 1
    if want
        w = 1
    if g != w
        print("FAIL peak_element " + label + ": got=" + str(g) + " want=" + str(w))
        exit(1)

fn main()
    // pk_find_peak — find index of a peak via binary search
    // [1,2,3,1] — peak at index 2 (value 3)
    let a1 = [1, 2, 3, 1]
    cki("find_peak([1,2,3,1])", pk_find_peak(a1), 2)

    // [5,4,3,2,1] — strictly decreasing, peak at index 0
    let a2 = [5, 4, 3, 2, 1]
    cki("find_peak([5,4,3,2,1])", pk_find_peak(a2), 0)

    // [1,2,3,4,5] — strictly increasing, peak at index 4
    let a3 = [1, 2, 3, 4, 5]
    cki("find_peak([1,2,3,4,5])", pk_find_peak(a3), 4)

    // [7] — single element, peak at index 0
    let a4 = [7]
    cki("find_peak([7])", pk_find_peak(a4), 0)

    // [] — empty, returns -1
    let a5 = []
    cki("find_peak([])", pk_find_peak(a5), -1)

    // [1,3,2] — peak at index 1
    let a6 = [1, 3, 2]
    cki("find_peak([1,3,2])", pk_find_peak(a6), 1)

    // pk_is_peak
    // [1,3,2] index 1 is a peak
    ckb("is_peak([1,3,2],1)", pk_is_peak(a6, 1), true)
    // [1,3,2] index 0 is NOT a peak (3 > 1)
    ckb("is_peak([1,3,2],0)", pk_is_peak(a6, 0), false)
    // [1,3,2] index 2 is NOT a peak (3 > 2)
    ckb("is_peak([1,3,2],2)", pk_is_peak(a6, 2), false)
    // single element is always a peak
    ckb("is_peak([7],0)", pk_is_peak(a4, 0), true)
    // empty array — out of bounds
    ckb("is_peak([],0)", pk_is_peak(a5, 0), false)
    // first element with left neighbor -inf
    ckb("is_peak([5,4,3,2,1],0)", pk_is_peak(a2, 0), true)
    // last element with right neighbor -inf
    ckb("is_peak([1,2,3,4,5],4)", pk_is_peak(a3, 4), true)

    // pk_find_peak_value
    cki("find_peak_value([1,2,3,1])", pk_find_peak_value(a1), 3)
    cki("find_peak_value([5,4,3,2,1])", pk_find_peak_value(a2), 5)
    cki("find_peak_value([1,2,3,4,5])", pk_find_peak_value(a3), 5)
    cki("find_peak_value([7])", pk_find_peak_value(a4), 7)
    cki("find_peak_value([])", pk_find_peak_value(a5), -1)

    // Verify the found peak is actually a peak
    let idx1 = pk_find_peak(a1)
    ckb("is_peak_check_a1", pk_is_peak(a1, idx1), true)
    let idx3 = pk_find_peak(a3)
    ckb("is_peak_check_a3", pk_is_peak(a3, idx3), true)

    print("PASS _peak_element_test")
