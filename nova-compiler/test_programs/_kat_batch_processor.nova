import forge_batch_processor

fn main()
    let bp = bp_new(3)
    bp = bp_add(bp, "item-1")
    bp = bp_add(bp, "item-2")
    assert(bp_buffer_size(bp) == 2, "2 buffered")
    assert(bp_should_flush(bp) == 0, "not ready")

    bp = bp_add(bp, "item-3")
    assert(bp_should_flush(bp) == 1, "ready at 3")

    bp = bp_flush(bp)
    assert(bp_buffer_size(bp) == 0, "buffer empty after flush")
    assert(bp_batches_processed(bp) == 1, "1 batch")
    assert(bp_items_processed(bp) == 3, "3 items")

    bp = bp_add(bp, "item-4")
    bp = bp_add(bp, "item-5")
    bp = bp_add(bp, "item-6")
    bp = bp_add(bp, "item-7")
    bp = bp_add(bp, "item-8")
    bp = bp_flush_all(bp)
    assert(bp_batches_processed(bp) == 3, "3 batches total")
    assert(bp_items_processed(bp) == 8, "8 items total")
    assert(bp_buffer_size(bp) == 0, "all flushed")

    bp = bp_record_error(bp)
    bp = bp_record_error(bp)
    assert(bp_error_count(bp) == 2, "2 errors")
    assert(bp_error_rate(bp) == 25, "25% error rate")

    print("BATCH-PROCESSOR KAT PASS")
