// Test default function parameters

fn greet(name, greeting = "hello")
    print("{greeting} {name}")

fn power(base, exp = 2)
    result = 1
    for i in 0..exp - 1
        result = result * base
    result

fn make_list(size, value = 0)
    result = []
    for i in 0..size - 1
        result.push(value)
    result

// Test with and without defaults
greet("world")
greet("nova", "welcome to")
print(power(3))
print(power(2, 10))
nums = make_list(3)
print(len(nums))
nums2 = make_list(3, 42)
print(nums2[-1])
print("done")
