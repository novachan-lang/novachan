// ============================================================================
// NOVA Standard Library — collections module
// ============================================================================
// Pure-NOVA implementations. No del() — gen3 compiler doesn't support it yet.

// ── Set ─────────────────────────────────────────────────────────────────────
// Backed by a list of unique items. O(n) add/contains/remove.

fn set_new() -> list
    let items = []
    [items]

fn set_add(s, item)
    let items = s[0]
    let i = 0
    while i < len(items)
        if items[i] == item
            return 0
        i = i + 1
    push(items, item)
    0

fn set_remove(s, item)
    let items = s[0]
    let rebuilt = []
    let i = 0
    while i < len(items)
        if items[i] != item
            push(rebuilt, items[i])
        i = i + 1
    s[0] = rebuilt
    0

fn set_contains(s, item) -> bool
    let items = s[0]
    let i = 0
    while i < len(items)
        if items[i] == item
            return true
        i = i + 1
    false

fn set_size(s) -> int
    len(s[0])

fn set_union(a, b) -> list
    let result = set_new()
    let ai = a[0]
    let i = 0
    while i < len(ai)
        set_add(result, ai[i])
        i = i + 1
    let bi = b[0]
    let j = 0
    while j < len(bi)
        set_add(result, bi[j])
        j = j + 1
    result

fn set_intersection(a, b) -> list
    let result = set_new()
    let ai = a[0]
    let i = 0
    while i < len(ai)
        if set_contains(b, ai[i])
            set_add(result, ai[i])
        i = i + 1
    result

fn set_difference(a, b) -> list
    let result = set_new()
    let ai = a[0]
    let i = 0
    while i < len(ai)
        if set_contains(b, ai[i]) == false
            set_add(result, ai[i])
        i = i + 1
    result

fn set_to_list(s) -> list
    let items = s[0]
    let result = []
    let i = 0
    while i < len(items)
        push(result, items[i])
        i = i + 1
    result


// ── Deque ───────────────────────────────────────────────────────────────────
// Wrapper list: [backing_list]. Pop replaces backing via slice.

fn deque_new() -> list
    let items = []
    [items]

fn deque_push_back(d, item)
    let items = d[0]
    push(items, item)

fn deque_push_front(d, item)
    let items = d[0]
    push(items, 0)
    let i = len(items) - 1
    while i > 0
        items[i] = items[i - 1]
        i = i - 1
    items[0] = item

fn deque_pop_back(d)
    let items = d[0]
    let n = len(items)
    if n == 0
        return null
    let val = items[n - 1]
    d[0] = items[0:n - 1]
    val

fn deque_pop_front(d)
    let items = d[0]
    let n = len(items)
    if n == 0
        return null
    let val = items[0]
    d[0] = items[1:n]
    val

fn deque_peek_front(d)
    let items = d[0]
    if len(items) == 0
        return null
    items[0]

fn deque_peek_back(d)
    let items = d[0]
    let n = len(items)
    if n == 0
        return null
    items[n - 1]

fn deque_size(d) -> int
    len(d[0])


// ── PriorityQueue (min-heap) ────────────────────────────────────────────────
// Wrapper: [heap_list]. Each element is [priority, value].

fn pq_new() -> list
    let heap = []
    [heap]

fn pq_push(pq, priority, value)
    let heap = pq[0]
    let entry = [priority, value]
    push(heap, entry)
    _pq_sift_up(heap, len(heap) - 1)

fn pq_pop(pq) -> list
    let heap = pq[0]
    let n = len(heap)
    if n == 0
        return []
    let min_entry = heap[0]
    if n == 1
        pq[0] = []
        return min_entry
    heap[0] = heap[n - 1]
    pq[0] = heap[0:n - 1]
    let new_heap = pq[0]
    _pq_sift_down(new_heap, 0)
    min_entry

fn pq_peek(pq) -> list
    let heap = pq[0]
    if len(heap) == 0
        return []
    heap[0]

fn pq_size(pq) -> int
    len(pq[0])

fn _pq_sift_up(heap, i)
    while i > 0
        let parent = (i - 1) / 2
        if heap[i][0] < heap[parent][0]
            _pq_swap(heap, i, parent)
            i = parent
        else
            return

fn _pq_sift_down(heap, i)
    let n = len(heap)
    while true
        let smallest = i
        let left = 2 * i + 1
        let right = 2 * i + 2
        if left < n
            if heap[left][0] < heap[smallest][0]
                smallest = left
        if right < n
            if heap[right][0] < heap[smallest][0]
                smallest = right
        if smallest == i
            return
        _pq_swap(heap, i, smallest)
        i = smallest

fn _pq_swap(heap, i, j)
    let tmp = heap[i]
    heap[i] = heap[j]
    heap[j] = tmp


// ── Counter ─────────────────────────────────────────────────────────────────
// Dict-backed: keys are items, values are counts.

fn counter_new() -> dict
    let c = {}
    c

fn counter_add(c, item)
    let k = keys(c)
    let found = false
    let i = 0
    while i < len(k)
        if k[i] == item
            found = true
        i = i + 1
    if found
        c[item] = c[item] + 1
    else
        c[item] = 1

fn counter_add_n(c, item, n)
    let k = keys(c)
    let found = false
    let i = 0
    while i < len(k)
        if k[i] == item
            found = true
        i = i + 1
    if found
        c[item] = c[item] + n
    else
        c[item] = n

fn counter_count(c, item) -> int
    let k = keys(c)
    let i = 0
    while i < len(k)
        if k[i] == item
            return c[item]
        i = i + 1
    0

fn counter_total(c) -> int
    let total = 0
    for k in keys(c)
        total = total + c[k]
    total

fn counter_most_common(c, n) -> list
    let pairs = []
    for k in keys(c)
        push(pairs, [k, c[k]])
    let num_pairs = len(pairs)
    let outer = 0
    while outer < num_pairs
        let inner = 0
        while inner < num_pairs - 1
            if pairs[inner][1] < pairs[inner + 1][1]
                let tmp = pairs[inner]
                pairs[inner] = pairs[inner + 1]
                pairs[inner + 1] = tmp
            inner = inner + 1
        outer = outer + 1
    let result = []
    let limit = n
    if limit > num_pairs
        limit = num_pairs
    let i = 0
    while i < limit
        push(result, pairs[i])
        i = i + 1
    result


// ── LRU Cache ───────────────────────────────────────────────────────────────
// [data_dict, key_order_list, capacity, evicted_set]
// Since gen3 lacks del(), evicted keys stay in dict but are tracked
// in a separate evicted set. Size = order list length.

fn lru_new(capacity) -> list
    let data = {}
    let order = []
    [data, order, capacity]

fn lru_get(cache, key)
    let data = cache[0]
    let idx = _lru_find_index(cache[1], key)
    if idx < 0
        return null
    _lru_move_to_end(cache, key)
    data[key]

fn lru_put(cache, key, value)
    let data = cache[0]
    let capacity = cache[2]
    let existing = _lru_find_index(cache[1], key)
    if existing >= 0
        data[key] = value
        _lru_move_to_end(cache, key)
        return 0
    let order = cache[1]
    if len(order) >= capacity
        // Evict LRU (index 0). Can't delete from dict, just remove from order.
        cache[1] = order[1:len(order)]
    let current_order = cache[1]
    data[key] = value
    push(current_order, key)
    0

fn lru_size(cache) -> int
    len(cache[1])

fn _lru_move_to_end(cache, key)
    let order = cache[1]
    let idx = _lru_find_index(order, key)
    if idx >= 0
        let rebuilt = []
        let i = 0
        while i < len(order)
            if i != idx
                push(rebuilt, order[i])
            i = i + 1
        push(rebuilt, key)
        cache[1] = rebuilt

fn _lru_find_index(order, key) -> int
    let i = 0
    while i < len(order)
        if order[i] == key
            return i
        i = i + 1
    -1


// ── Sorted Map (ordered key-value store) ────────────────────────────────────
// Backed by sorted list of [key, value] pairs. Binary search for O(log n)
// lookup. Insertion is O(n) due to list shifting. Good for moderate sizes
// where ordered iteration is needed.

fn sorted_map_new() -> list
    let pairs = []
    [pairs]

fn _sm_bsearch(pairs, key) -> int
    let lo = 0
    let hi = len(pairs) - 1
    while lo <= hi
        let mid = (lo + hi) / 2
        let mk = pairs[mid][0]
        if mk == key
            return mid
        if mk < key
            lo = mid + 1
        else
            hi = mid - 1
    -(lo + 1)

fn sorted_map_set(sm, key, value)
    let pairs = sm[0]
    let idx = _sm_bsearch(pairs, key)
    if idx >= 0
        pairs[idx] = [key, value]
        return 0
    let insert_at = -(idx + 1)
    push(pairs, [key, value])
    let i = len(pairs) - 1
    while i > insert_at
        pairs[i] = pairs[i - 1]
        i = i - 1
    pairs[insert_at] = [key, value]
    0

fn sorted_map_get(sm, key)
    let pairs = sm[0]
    let idx = _sm_bsearch(pairs, key)
    if idx >= 0
        return pairs[idx][1]
    null

fn sorted_map_has(sm, key) -> bool
    let pairs = sm[0]
    _sm_bsearch(pairs, key) >= 0

fn sorted_map_remove(sm, key) -> bool
    let pairs = sm[0]
    let idx = _sm_bsearch(pairs, key)
    if idx < 0
        return false
    let rebuilt = []
    let i = 0
    while i < len(pairs)
        if i != idx
            push(rebuilt, pairs[i])
        i = i + 1
    sm[0] = rebuilt
    true

fn sorted_map_size(sm) -> int
    len(sm[0])

fn sorted_map_keys(sm) -> list
    let pairs = sm[0]
    let result = []
    let i = 0
    while i < len(pairs)
        push(result, pairs[i][0])
        i = i + 1
    result

fn sorted_map_values(sm) -> list
    let pairs = sm[0]
    let result = []
    let i = 0
    while i < len(pairs)
        push(result, pairs[i][1])
        i = i + 1
    result

fn sorted_map_min_key(sm)
    let pairs = sm[0]
    if len(pairs) == 0
        return null
    pairs[0][0]

fn sorted_map_max_key(sm)
    let pairs = sm[0]
    if len(pairs) == 0
        return null
    pairs[len(pairs) - 1][0]

fn sorted_map_range(sm, lo_key, hi_key) -> list
    let pairs = sm[0]
    let result = []
    let i = 0
    while i < len(pairs)
        let k = pairs[i][0]
        if k >= lo_key and k <= hi_key
            push(result, pairs[i])
        i = i + 1
    result


// ── Ring Buffer (fixed-capacity circular buffer) ─────────────────────────────
// [backing_list, head, tail, capacity, count]

fn ring_new(capacity: int) -> list
    let backing = []
    let i = 0
    while i < capacity
        push(backing, null)
        i = i + 1
    [backing, 0, 0, capacity, 0]

fn ring_push(r, item) -> bool
    let count = r[4]
    let cap = r[3]
    if count >= cap
        return false
    let backing = r[0]
    let tail = r[2]
    backing[tail] = item
    r[2] = (tail + 1) % cap
    r[4] = count + 1
    true

fn ring_pop(r)
    let count = r[4]
    if count == 0
        return null
    let backing = r[0]
    let head = r[1]
    let val = backing[head]
    r[1] = (head + 1) % r[3]
    r[4] = count - 1
    val

fn ring_peek(r)
    if r[4] == 0
        return null
    r[0][r[1]]

fn ring_size(r) -> int
    r[4]

fn ring_capacity(r) -> int
    r[3]

fn ring_is_full(r) -> bool
    r[4] >= r[3]

fn ring_is_empty(r) -> bool
    r[4] == 0
