// _hyperloglog_test.nova — KAT for std/sketch/hyperloglog
//
// Tests INVARIANTS and DETERMINISM, NOT exact estimates.
// HyperLogLog is approximate; we test bounds and structural properties.

import std/sketch/hyperloglog

fn ck(label, got, want)
    if got != want
        print("FAIL hyperloglog " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck_range(label, got, lo, hi)
    if got < lo or got > hi
        print("FAIL hyperloglog " + label + ": got=" + str(got) + " want in [" + str(lo) + ".." + str(hi) + "]")
        exit(1)

fn main()
    // --- Structural: hll_new ---
    let h = hll_new(10)
    ck("new_p", h["p"], 10)
    ck("new_m", h["m"], 1024)
    ck("new_reg_count", len(h["r"]), 1024)
    ck("new_registers_used", hll_registers_used(h), 0)

    // --- leading_zeros helper ---
    // hll_leading_zeros(val, bits): count leading zeros of 'bits'-wide val, then +1
    // All zeros -> bits+1
    ck("lz_all_zero_8",  hll_leading_zeros(0, 8), 9)
    // 0b10000000 (128) in 8 bits: MSB is 1 -> 0 leading zeros -> rank=1
    ck("lz_msb_set_8",   hll_leading_zeros(128, 8), 1)
    // 0b01000000 (64) in 8 bits: 1 leading zero -> rank=2
    ck("lz_one_lz_8",    hll_leading_zeros(64, 8), 2)
    // 0b00000001 (1) in 8 bits: 7 leading zeros -> rank=8
    ck("lz_lsb_only_8",  hll_leading_zeros(1, 8), 8)

    // --- register_index: top p bits ---
    // For p=4 and 63-bit h: (h >> (63-p)) & ((1<<p)-1) = (h >> 59) & 0xF
    // h=0x7FFFFFFFFFFFFFFF = 9223372036854775807 -> bits 62..59 = 0b1111 = 15
    ck("reg_idx_p4", hll_register_index(9223372036854775807, 4), 15)
    // h=0x4000000000000000 = 4611686018427387904 = 2^62 -> bits 62..59 = 0b1000 = 8
    ck("reg_idx_p4b", hll_register_index(4611686018427387904, 4), 8)

    // --- Adding same item 100 times -> estimate near 1 (at most 3) ---
    let h2 = hll_new(10)
    let i = 0
    while i < 100
        h2 = hll_add(h2, "same_item")
        i = i + 1
    let cnt_same = hll_count(h2)
    ck_range("same_item_100x", cnt_same, 1, 3)

    // --- registers_used increases as distinct items are added ---
    let h3 = hll_new(10)
    let used0 = hll_registers_used(h3)
    h3 = hll_add(h3, "a")
    h3 = hll_add(h3, "b")
    h3 = hll_add(h3, "c")
    let used3 = hll_registers_used(h3)
    if used3 <= used0
        print("FAIL hyperloglog registers_used_grows: used0=" + str(used0) + " used3=" + str(used3))
        exit(1)

    // --- 1000 distinct items within ~15% of 1000 (bound: 800..1200) ---
    let h4 = hll_new(10)
    let j = 0
    while j < 1000
        h4 = hll_add(h4, "item" + str(j))
        j = j + 1
    let cnt1000 = hll_count(h4)
    ck_range("distinct_1000", cnt1000, 800, 1200)

    // --- Determinism: two HLLs with identical adds give identical hll_count ---
    let ha = hll_new(10)
    let hb = hll_new(10)
    let k = 0
    while k < 50
        ha = hll_add(ha, "det_item" + str(k))
        hb = hll_add(hb, "det_item" + str(k))
        k = k + 1
    ck("determinism", hll_count(ha), hll_count(hb))

    // --- Merge: merged estimate >= max of two separate estimates ---
    let hm1 = hll_new(10)
    let hm2 = hll_new(10)
    let mi = 0
    while mi < 200
        hm1 = hll_add(hm1, "left" + str(mi))
        mi = mi + 1
    let mj = 0
    while mj < 200
        hm2 = hll_add(hm2, "right" + str(mj))
        mj = mj + 1
    let merged = hll_merge(hm1, hm2)
    let cnt_merged = hll_count(merged)
    let cnt1 = hll_count(hm1)
    let cnt2 = hll_count(hm2)
    // merged estimate must be >= max of individual (register-wise max property)
    let bigger = cnt1
    if cnt2 > cnt1
        bigger = cnt2
    if cnt_merged < bigger
        print("FAIL hyperloglog merge_ge_max: merged=" + str(cnt_merged) + " bigger=" + str(bigger))
        exit(1)
    // Merged 400 distinct items should be within ~15% of 400
    ck_range("merge_400", cnt_merged, 340, 460)

    // --- Merge preserves p and m ---
    ck("merge_p", merged["p"], 10)
    ck("merge_m", merged["m"], 1024)

    print("PASS _hyperloglog_test")
