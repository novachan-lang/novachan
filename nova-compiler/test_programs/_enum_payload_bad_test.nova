// enum payload typing (negative): a float payload used where a string is required MUST be rejected.
// Before the fix the binder was a fresh type var -> the float unified to `string` from usage -> the
// runtime treated float bits as a string pointer = type confusion. Now `v` is bound to the DECLARED
// float, so passing it to needs_string is a compile-time E1001.
enum FBox
    FloatBox(x: float)

fn needs_string(s: string) -> string
    return s + "!"

fn main()
    match FloatBox(2.5)
        FloatBox(v) => print(needs_string(v))
