import forge_tracing

fn main()
    let t = trace_new("abc123")

    t = trace_start_span(t, "http-request", 0)
    let s1 = trace_last_span_id(t)
    t = trace_start_span(t, "db-query", s1)
    let s2 = trace_last_span_id(t)
    t = trace_start_span(t, "cache-lookup", s1)
    let s3 = trace_last_span_id(t)

    assert(trace_span_count(t) == 3, "3 spans")

    let roots = trace_root_spans(t)
    assert(len(roots) == 1, "1 root")
    assert(roots[0]["name"] == "http-request", "root name")

    let children = trace_children(t, s1)
    assert(len(children) == 2, "2 children of http-request")

    t = trace_set_attr(t, s1, "method", "GET")
    t = trace_set_attr(t, s1, "path", "/api/users")
    t = trace_add_event(t, s2, "query-start")
    t = trace_add_event(t, s2, "query-end")

    let span1 = trace_get_span(t, s1)
    assert(span1["attributes"]["method"] == "GET", "attr method")
    assert(span1["status"] == "running", "running")

    let span2 = trace_get_span(t, s2)
    assert(len(span2["events"]) == 2, "2 events on db-query")

    t = trace_end_span(t, s2)
    let span2b = trace_get_span(t, s2)
    assert(span2b["status"] == "ended", "db-query ended")

    t = trace_set_status(t, s3, "error")
    let span3 = trace_get_span(t, s3)
    assert(span3["status"] == "error", "cache error")

    t = trace_end_span(t, s1)
    let span1b = trace_get_span(t, s1)
    assert(span1b["status"] == "ended", "http-request ended")

    print("TRACING KAT PASS")
