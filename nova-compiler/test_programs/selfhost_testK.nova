// Test: recursion, nested function calls, string building
fn fib(n: int) -> int
    if n <= 1
        return n
    return fib(n - 1) + fib(n - 2)

fn repeat_str(s: string, n: int) -> string
    let result = ""
    let i = 0
    while i < n
        result = result + s
        i = i + 1
    return result

print(fib(10))
print(repeat_str("ab", 4))
print(fib(0))
print(fib(1))
print(fib(7))
