import std/image/img_dither

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL img_dither " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // ── KAT 1: FS dither of all-0 image is all 0 ─────────────────────────────
    let black4 = []
    black4.push(0)
    black4.push(0)
    black4.push(0)
    black4.push(0)
    let res_black = img_dither_fs(black4, 2, 2)
    cki("fs_black_0", res_black[0], 0)
    cki("fs_black_1", res_black[1], 0)
    cki("fs_black_2", res_black[2], 0)
    cki("fs_black_3", res_black[3], 0)

    // ── KAT 2: FS dither of all-255 image is all 255 ─────────────────────────
    let white4 = []
    white4.push(255)
    white4.push(255)
    white4.push(255)
    white4.push(255)
    let res_white = img_dither_fs(white4, 2, 2)
    cki("fs_white_0", res_white[0], 255)
    cki("fs_white_1", res_white[1], 255)
    cki("fs_white_2", res_white[2], 255)
    cki("fs_white_3", res_white[3], 255)

    // ── KAT 3: FS mid-gray produces a mix whose sum approximates mid-gray ─────
    // Use a 4x1 strip of 128 — FS will produce alternating 255 and 0 values.
    // The average of the output should be close to 128.
    let gray4 = []
    gray4.push(128)
    gray4.push(128)
    gray4.push(128)
    gray4.push(128)
    let res_gray = img_dither_fs(gray4, 4, 1)
    // Check all output values are exactly 0 or 255.
    let gi = 0
    while gi < 4
        let pv = res_gray[gi]
        let valid = 0
        if pv == 0
            valid = 1
        if pv == 255
            valid = 1
        cki("fs_gray_valid_" + str(gi), valid, 1)
        gi = gi + 1
    // Sum should be at least 255 (at least one 255 pixel in the mix).
    let gs = res_gray[0] + res_gray[1] + res_gray[2] + res_gray[3]
    let nonzero = 0
    if gs > 0
        nonzero = 1
    cki("fs_gray_nonzero", nonzero, 1)

    // ── KAT 4: All output values are only 0 or 255 — ordered dither ──────────
    // 4x4 ramp: 0..255 in 16 steps
    let ramp = []
    ramp.push(0)
    ramp.push(17)
    ramp.push(34)
    ramp.push(51)
    ramp.push(68)
    ramp.push(85)
    ramp.push(102)
    ramp.push(119)
    ramp.push(136)
    ramp.push(153)
    ramp.push(170)
    ramp.push(187)
    ramp.push(204)
    ramp.push(221)
    ramp.push(238)
    ramp.push(255)
    let res_ord = img_dither_ordered(ramp, 4, 4)
    let oi = 0
    while oi < 16
        let pv = res_ord[oi]
        let valid = 0
        if pv == 0
            valid = 1
        if pv == 255
            valid = 1
        cki("ord_valid_" + str(oi), valid, 1)
        oi = oi + 1

    // ── KAT 5: Ordered dither all-0 is all 0; all-255 is all 255 ─────────────
    let black16 = []
    let bi = 0
    while bi < 16
        black16.push(0)
        bi = bi + 1
    let res_ord_black = img_dither_ordered(black16, 4, 4)
    cki("ord_black_0", res_ord_black[0], 0)
    cki("ord_black_15", res_ord_black[15], 0)

    let white16 = []
    let wi = 0
    while wi < 16
        white16.push(255)
        wi = wi + 1
    let res_ord_white = img_dither_ordered(white16, 4, 4)
    cki("ord_white_0", res_ord_white[0], 255)
    cki("ord_white_15", res_ord_white[15], 255)

    print("PASS _img_dither_test")
