import forge_partition_manager

fn main()
    let p = pm_new(4)
    p = pm_assign_owner(p, 0, "node-a")
    p = pm_assign_owner(p, 1, "node-b")
    p = pm_assign_owner(p, 2, "node-c")
    p = pm_assign_owner(p, 3, "node-a")
    assert(pm_partition_count(p) == 4, "4 partitions")

    p = pm_put(p, "user:alice")
    p = pm_put(p, "user:bob")
    assert(pm_item_count(p) == 2, "2 items")

    let pa = pm_partition_for(p, "user:alice")
    assert(pa >= 0, "partition >= 0")
    assert(pa < 4, "partition < 4")

    let owner = pm_owner_for(p, "user:alice")
    assert(len(owner) > 0, "has owner")

    let same = pm_partition_for(p, "user:alice")
    assert(same == pa, "deterministic")

    print("PARTITION-MANAGER KAT PASS")
