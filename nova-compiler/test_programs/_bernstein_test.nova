import std/poly/bernstein

// Known-answer tests for std/poly/bernstein.
// Tolerance 0.0001 for all float comparisons.

fn approx(a: float, b: float, tol: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    d < tol

fn ckf(label: str, got: float, want: float)
    if not approx(got, want, 0.0001)
        print("FAIL bernstein " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL bernstein " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // --- bern_binom ---
    cki("binom_4_2", bern_binom(4, 2), 6)
    cki("binom_0_0", bern_binom(0, 0), 1)
    cki("binom_5_0", bern_binom(5, 0), 1)
    cki("binom_5_5", bern_binom(5, 5), 1)
    cki("binom_4_1", bern_binom(4, 1), 4)
    cki("binom_4_3", bern_binom(4, 3), 4)

    // --- bern_basis ---
    // B_{1,2}(0.5) = C(2,1)*0.5^1*(1-0.5)^1 = 2*0.5*0.5 = 0.5
    let b12h = bern_basis(2, 1, 0.5)
    ckf("basis_1_2_half", b12h, 0.5)

    // B_{0,2}(0) = 1  (left endpoint)
    let b020 = bern_basis(2, 0, 0.0)
    ckf("basis_0_2_0", b020, 1.0)

    // B_{2,2}(1) = 1  (right endpoint)
    let b221 = bern_basis(2, 2, 1.0)
    ckf("basis_2_2_1", b221, 1.0)

    // B_{0,3}(0.5) = C(3,0)*0.5^0*(0.5)^3 = 0.125
    let b030h = bern_basis(3, 0, 0.5)
    ckf("basis_0_3_half", b030h, 0.125)

    // --- bern_all_basis: partition of unity ---
    // bern_all_basis(3, 0.5) must sum to 1.0
    let ab3h = bern_all_basis(3, 0.5)
    cki("all_basis_3_len", len(ab3h), 4)
    let s = ab3h[0] * 1.0 + ab3h[1] * 1.0 + ab3h[2] * 1.0 + ab3h[3] * 1.0
    ckf("all_basis_3_sum1", s, 1.0)

    // bern_all_basis(2, 0.5) sum = 1.0
    let ab2h = bern_all_basis(2, 0.5)
    cki("all_basis_2_len", len(ab2h), 3)
    let s2 = ab2h[0] * 1.0 + ab2h[1] * 1.0 + ab2h[2] * 1.0
    ckf("all_basis_2_sum1", s2, 1.0)

    // at t=0: B_{0,n}=1, rest=0
    let ab3zero = bern_all_basis(3, 0.0)
    let s0 = ab3zero[0] * 1.0
    ckf("all_basis_3_t0_b0", s0, 1.0)
    let s0b = ab3zero[1] * 1.0
    ckf("all_basis_3_t0_b1", s0b, 0.0)

    // at t=1: B_{n,n}=1, rest=0
    let ab3one = bern_all_basis(3, 1.0)
    let s1last = ab3one[3] * 1.0
    ckf("all_basis_3_t1_bn", s1last, 1.0)
    let s1b0 = ab3one[0] * 1.0
    ckf("all_basis_3_t1_b0", s1b0, 0.0)

    // --- bern_bezier_point (de Casteljau) ---
    // Linear [0,1] at t=0.5 -> 0.5
    let bp_lin = bern_bezier_point([0.0, 1.0], 0.5)
    ckf("bezier_linear_half", bp_lin, 0.5)

    // Quadratic [0,0,1] at t=1.0 -> endpoint = 1.0
    let bp_quad1 = bern_bezier_point([0.0, 0.0, 1.0], 1.0)
    ckf("bezier_quad_t1", bp_quad1, 1.0)

    // Quadratic [0,1,0] at t=0.5 -> 2*0.5*(1-0.5)*1 = 0.5
    let bp_quad2 = bern_bezier_point([0.0, 1.0, 0.0], 0.5)
    ckf("bezier_quad_mid", bp_quad2, 0.5)

    // Endpoint interpolation: t=0 -> first control point
    let bp_t0 = bern_bezier_point([3.0, 1.0, 2.0], 0.0)
    ckf("bezier_t0_interp", bp_t0, 3.0)

    // Endpoint interpolation: t=1 -> last control point
    let bp_t1 = bern_bezier_point([3.0, 1.0, 2.0], 1.0)
    ckf("bezier_t1_interp", bp_t1, 2.0)

    // --- bern_de_casteljau (alias) ---
    // [1,2,3] at t=0.5 -> de_casteljau: d0=[1.5,2.5], d1=[2.0] -> 2.0
    let dc = bern_de_casteljau([1.0, 2.0, 3.0], 0.5)
    ckf("de_casteljau_1_2_3_half", dc, 2.0)

    // --- bern_bezier_deriv ---
    // Linear [0,1]: degree 1, derivative = 1*[1-0] = [1], at any t -> 1.0
    let bd_lin = bern_bezier_deriv([0.0, 1.0], 0.5)
    ckf("bezier_deriv_linear", bd_lin, 1.0)

    // Quadratic [0,0,1]: Q_i = 2*(P_{i+1}-P_i) = [0,2]
    // bezier_point([0,2], 0.5) = 0*0.5 + 2*0.5 = 1.0
    let bd_q = bern_bezier_deriv([0.0, 0.0, 1.0], 0.5)
    ckf("bezier_deriv_quad_half", bd_q, 1.0)

    // --- bern_elevate ---
    // Degree 1 [a,b] elevated to degree 2: [a, (a+b)/2, b]
    // [0,1] -> [0, 0.5, 1]
    let el = bern_elevate([0.0, 1.0])
    cki("elevate_len", len(el), 3)
    let el0 = el[0] * 1.0
    let el1 = el[1] * 1.0
    let el2 = el[2] * 1.0
    ckf("elevate_0", el0, 0.0)
    ckf("elevate_1", el1, 0.5)
    ckf("elevate_2", el2, 1.0)

    print("PASS _bernstein_test")
