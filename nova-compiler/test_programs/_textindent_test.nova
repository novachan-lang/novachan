// KAT for std/textlayout/textindent — indent/dedent utilities.
import std/textlayout/textindent

fn cks(label, got, want)
    if got != want
        print("FAIL textindent " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL textindent " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    let nl = chr(10)

    // ti_indent: prepend prefix to every line including blank
    cks("indent1", ti_indent("a" + nl + "b", "  "), "  a" + nl + "  b")
    cks("indent2", ti_indent("x", "> "), "> x")
    cks("indent3", ti_indent("a" + nl + "" + nl + "b", "  "), "  a" + nl + "  " + nl + "  b")

    // ti_indent_n
    cks("indent_n1", ti_indent_n("x" + nl + "y", 4), "    x" + nl + "    y")
    cks("indent_n2", ti_indent_n("z", 0), "z")

    // ti_common_indent
    cki("ci1", ti_common_indent("  a" + nl + "    b"), 2)
    cki("ci2", ti_common_indent("    a" + nl + "    b"), 4)
    cki("ci3", ti_common_indent("a" + nl + "  b"), 0)
    cki("ci4", ti_common_indent(""), 0)

    // ti_dedent: remove common leading spaces
    cks("dedent1", ti_dedent("    a" + nl + "      b"), "a" + nl + "  b")
    cks("dedent2", ti_dedent("  a" + nl + "    b"), "a" + nl + "  b")
    cks("dedent3", ti_dedent("a" + nl + "b"), "a" + nl + "b")

    // ti_dedent_n: remove up to n leading spaces
    cks("dedent_n1", ti_dedent_n("    x", 2), "  x")
    cks("dedent_n2", ti_dedent_n("  x", 5), "x")
    cks("dedent_n3", ti_dedent_n("x", 3), "x")

    // ti_strip_lines: trailing whitespace removed
    cks("strip1", ti_strip_lines("hello   " + nl + "world  "), "hello" + nl + "world")
    cks("strip2", ti_strip_lines("  no trail"), "  no trail")

    // ti_indent_first: only first line gets prefix
    cks("first1", ti_indent_first("a" + nl + "b", ">> "), ">> a" + nl + "b")
    cks("first2", ti_indent_first("only", "- "), "- only")

    // ti_indent_rest: every line but first gets prefix
    cks("rest1", ti_indent_rest("a" + nl + "b", ">"), "a" + nl + ">b")
    cks("rest2", ti_indent_rest("a" + nl + "b" + nl + "c", "  "), "a" + nl + "  b" + nl + "  c")

    print("PASS _textindent_test")
