// forge_lang_test -- negotiate_lang picks the best offered language for the request's Accept-Language,
// matching on the primary subtag (en-US/en-GB -> en), honoring entry order as the preference, and falling
// back to the first supported language for "*" / no match / absent header.
import forge

fn main()
    // fr-CH/fr not offered, en is -> "en"
    let req = forge.build_request("GET / HTTP/1.1\r\nAccept-Language: fr-CH, fr;q=0.9, en;q=0.8\r\n\r\n", 0)
    if forge.negotiate_lang(req, ["en", "de"]) != "en"
        print("FAIL: en should be chosen")
        exit(1)

    // de not offered, en is and comes before fr in the header -> "en"
    let req2 = forge.build_request("GET / HTTP/1.1\r\nAccept-Language: de, en, fr\r\n\r\n", 0)
    if forge.negotiate_lang(req2, ["en", "fr"]) != "en"
        print("FAIL: preference order -> en")
        exit(1)

    // primary-subtag match: en-GB -> en
    let req3 = forge.build_request("GET / HTTP/1.1\r\nAccept-Language: en-GB\r\n\r\n", 0)
    if forge.negotiate_lang(req3, ["en", "fr"]) != "en"
        print("FAIL: en-GB should match en")
        exit(1)

    // no offered language matches -> default (supported[0])
    let req4 = forge.build_request("GET / HTTP/1.1\r\nAccept-Language: es, it\r\n\r\n", 0)
    if forge.negotiate_lang(req4, ["en", "fr"]) != "en"
        print("FAIL: no match -> default en")
        exit(1)

    // wildcard -> default (supported[0] = fr here)
    let req5 = forge.build_request("GET / HTTP/1.1\r\nAccept-Language: *\r\n\r\n", 0)
    if forge.negotiate_lang(req5, ["fr", "en"]) != "fr"
        print("FAIL: * -> default fr")
        exit(1)

    // absent Accept-Language -> default
    let req6 = forge.build_request("GET / HTTP/1.1\r\nHost: x\r\n\r\n", 0)
    if forge.negotiate_lang(req6, ["fr", "en"]) != "fr"
        print("FAIL: absent header -> default fr")
        exit(1)

    print("PASS forge_lang (negotiate_lang: primary-subtag match, preference order, wildcard/no-match/absent -> default)")
