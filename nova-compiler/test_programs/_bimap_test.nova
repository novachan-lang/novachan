import std/collections/bimap

// Helper: check string equality
fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

// Helper: check integer equality
fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ── KAT 1: basic set + get ──────────────────────────────────────────────────
let bm = bm_new()
bm_set(bm, "a", "1")
bm_set(bm, "b", "2")

cks("get_a",     bm_get(bm, "a"),       "1")
cks("get_b",     bm_get(bm, "b"),       "2")
cks("get_key_1", bm_get_key(bm, "1"),   "a")
cks("get_key_2", bm_get_key(bm, "2"),   "b")

// ── KAT 2: has_key / has_value ──────────────────────────────────────────────
cki("has_key_a",    bm_has_key(bm, "a"),    1)
cki("has_key_c",    bm_has_key(bm, "c"),    0)
cki("has_val_1",    bm_has_value(bm, "1"),  1)
cki("has_val_9",    bm_has_value(bm, "9"),  0)

// ── KAT 3: del_key removes both directions ───────────────────────────────────
bm_del_key(bm, "a")
cki("has_key_a_after_del",   bm_has_key(bm, "a"),   0)
cki("has_val_1_after_del",   bm_has_value(bm, "1"), 0)
// "b"->2 must be untouched
cks("get_b_after_del", bm_get(bm, "b"), "2")

// ── KAT 4: re-set key to new value removes old reverse entry ─────────────────
// Restore a->1 first, then re-map a->9
bm_set(bm, "a", "1")
cks("get_a_restored", bm_get(bm, "a"), "1")
bm_set(bm, "a", "9")
cks("get_a_remapped",      bm_get(bm, "a"),       "9")
cks("get_key_9",           bm_get_key(bm, "9"),   "a")
// old reverse entry for "1" must be gone
cki("has_val_1_evicted",   bm_has_value(bm, "1"), 0)
cks("get_key_1_gone",      bm_get_key(bm, "1"),   "")

// ── KAT 5: setting value already owned by another key evicts that key ─────────
let bm2 = bm_new()
bm_set(bm2, "x", "10")
bm_set(bm2, "y", "20")
// Now map "z" to "10" — must evict "x"
bm_set(bm2, "z", "10")
cks("get_key_10_new",   bm_get_key(bm2, "10"), "z")
cki("has_key_x_evicted", bm_has_key(bm2, "x"),  0)
cks("get_x_gone",        bm_get(bm2, "x"),       "")
// "y"->20 must survive
cks("get_y_survives",    bm_get(bm2, "y"),       "20")

// ── KAT 6: bm_len ───────────────────────────────────────────────────────────
// bm now has: a->9, b->2  (two entries)
cki("len_2", bm_len(bm), 2)
bm_del_key(bm, "b")
cki("len_1", bm_len(bm), 1)

// ── KAT 7: absent-key lookups return "" ─────────────────────────────────────
cks("get_absent",     bm_get(bm, "zzz"),     "")
cks("get_key_absent", bm_get_key(bm, "zzz"), "")

print("_bimap_test passed")
