// _adler32_test.nova — KAT for std/hash/adler32
// Published vectors from RFC 1950 and the Wikipedia "Adler-32" article.
//
// Hand-trace for "a" (byte 97):
//   a = (1 + 97) % 65521 = 98
//   b = (0 + 98) % 65521 = 98
//   result = (98 << 16) | 98 = 6422626 = 0x00620062
//
// Hand-trace for "abc" (bytes 97, 98, 99):
//   after 'a': a=98,  b=98
//   after 'b': a=196, b=294
//   after 'c': a=295, b=589
//   result = (589 << 16) | 295 = 38600999 = 0x024d0127

import std/hash/adler32

// Integer known-answer check.
fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // KAT 1: empty string → 1 (RFC 1950 initial state, no bytes processed)
    cki("empty", h_adler32(""), 1)

    // KAT 2: single character "a" (byte 97) → 0x00620062 = 6422626
    cki("a", h_adler32("a"), 6422626)

    // KAT 3: "abc" → 0x024d0127 = 38600999
    cki("abc", h_adler32("abc"), 38600999)

    // KAT 4: "Wikipedia" → 0x11E60398 = 300286872 (Wikipedia article standard vector)
    cki("Wikipedia", h_adler32("Wikipedia"), 300286872)

    // KAT 5: determinism — calling twice on same input returns same value
    cki("determinism", h_adler32("hello world"), h_adler32("hello world"))

    // KAT 6: single space character (byte 32)
    //   a = (1+32)%65521 = 33
    //   b = (0+33)%65521 = 33
    //   result = (33<<16)|33 = 2162721 = 0x00210021
    cki("space", h_adler32(" "), 2162721)

    // KAT 7: two characters "ab" (bytes 97, 98)
    //   after 'a': a=98, b=98
    //   after 'b': a=196, b=294
    //   result = (294<<16)|196 = 19267780 = 0x012600C4
    cki("ab", h_adler32("ab"), 19267780)

    print("_adler32_test passed")
