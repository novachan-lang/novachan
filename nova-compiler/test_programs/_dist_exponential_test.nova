// _dist_exponential_test.nova — KAT for std/numeric/dist_exponential
// Known-answer values verified analytically.
import std/numeric/dist_exponential

fn approx(a, b, tol) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < tol
        return 1
    return 0

fn ck(label: string, got: float, want: float, tol: float)
    let ok = approx(got, want, tol)
    if ok == 0
        print("FAIL dist_exponential " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)
    print("ok " + label)

fn main()
    // exp_pdf(1.0, 1.0) = 1.0 * exp(-1.0) ~= 0.36787944
    let v1 = exp_pdf(1.0, 1.0)
    ck("exp_pdf(1,1)", v1, 0.3679, 0.001)

    // exp_pdf for x<0 must return 0.0
    let v2 = exp_pdf(0.0 - 1.0, 1.0)
    ck("exp_pdf(-1,1)=0", v2, 0.0, 0.0001)

    // exp_cdf(1.0, 1.0) = 1 - exp(-1.0) ~= 0.63212056
    let v3 = exp_cdf(1.0, 1.0)
    ck("exp_cdf(1,1)", v3, 0.6321, 0.001)

    // exp_cdf(0.0, 1.0) = 0.0
    let v4 = exp_cdf(0.0, 1.0)
    ck("exp_cdf(0,1)=0", v4, 0.0, 0.0001)

    // exp_mean(2.0) = 1/2 = 0.5
    let v5 = exp_mean(2.0)
    ck("exp_mean(2)=0.5", v5, 0.5, 0.0001)

    // exp_mean(1.0) = 1.0
    let v6 = exp_mean(1.0)
    ck("exp_mean(1)=1.0", v6, 1.0, 0.0001)

    // exp_ppf(0.5, 1.0) = -ln(0.5) = ln(2) ~= 0.6931
    let v7 = exp_ppf(0.5, 1.0)
    ck("exp_ppf(0.5,1)", v7, 0.6931, 0.001)

    // exp_ppf(0.0, 1.0) = 0.0 (0th percentile)
    let v8 = exp_ppf(0.0, 1.0)
    ck("exp_ppf(0,1)=0", v8, 0.0, 0.0001)

    print("PASS _dist_exponential_test")
