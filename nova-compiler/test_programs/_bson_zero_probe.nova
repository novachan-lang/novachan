import std/encoding/bson
fn main()
    let d1 = {}
    d1["a"] = 0
    let e1 = bson_encode(d1)
    if bytes_get(e1, 4) != 16
        print("FAIL int 0 type=" + str(bytes_get(e1, 4)))
        exit(1)
    let d2 = {}
    d2["b"] = 0.0
    let e2 = bson_encode(d2)
    if bytes_get(e2, 4) != 1
        print("FAIL float 0.0 type=" + str(bytes_get(e2, 4)))
        exit(1)
    let d3 = {}
    d3["c"] = bson_null()
    let e3 = bson_encode(d3)
    if bytes_get(e3, 4) != 10
        print("FAIL bson_null type=" + str(bytes_get(e3, 4)))
        exit(1)
    let back = bson_decode(e1)
    if back["a"] != 0
        print("FAIL roundtrip int0=" + str(back["a"]))
        exit(1)
    print("PASS _bson_zero_probe (int0->int32, 0.0->double, bson_null()->0x0A)")
