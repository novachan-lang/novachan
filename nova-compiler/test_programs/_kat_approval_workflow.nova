import forge_approval_workflow

fn main()
    let a = aw_new(2)
    a = aw_submit(a, "pr-100", "alice")
    assert(aw_request_count(a) == 1, "1 request")

    let s1 = aw_status(a, "pr-100")
    assert(is_ok(s1), "status ok")
    assert(unwrap(s1) == "pending", "pending")

    let self_approve = aw_approve(a, "pr-100", "alice")
    assert(is_err(self_approve), "self-approval blocked")

    let r1 = aw_approve(a, "pr-100", "bob")
    assert(is_ok(r1), "bob approves")
    a = unwrap(r1)
    assert(aw_approvals(a, "pr-100") == 1, "1 approval")

    let r2 = aw_approve(a, "pr-100", "carol")
    assert(is_ok(r2), "carol approves")
    a = unwrap(r2)

    let s2 = aw_status(a, "pr-100")
    assert(unwrap(s2) == "approved", "approved after 2")

    let r3 = aw_approve(a, "pr-100", "dave")
    assert(is_err(r3), "already approved, not pending")

    let bad = aw_status(a, "pr-999")
    assert(is_err(bad), "unknown request is err")

    a = aw_submit(a, "pr-200", "bob")
    let rej = aw_reject(a, "pr-200", "policy violation")
    assert(is_ok(rej), "reject ok")
    a = unwrap(rej)
    let s3 = aw_status(a, "pr-200")
    assert(unwrap(s3) == "rejected", "rejected")

    print("APPROVAL-WORKFLOW KAT PASS")
