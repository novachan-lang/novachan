import std/proof/proof_tableau

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

// =========================================================================
// Inline truth-table oracle for cross-checking
// =========================================================================

fn _eval_tag(f) -> string
    if type_of(f) != "list"
        return "bad"
    if len(f) == 0
        return "bad"
    f[0]

fn _eval_lookup(name, asgn) -> int
    let n = len(asgn)
    let i = 0
    while i < n
        if asgn[i][0] == name
            return asgn[i][1]
        i = i + 1
    0

fn _eval(f, asgn) -> int
    let tag = _eval_tag(f)
    if tag == "var"
        return _eval_lookup(f[1], asgn)
    if tag == "bot"
        return 0
    if tag == "top"
        return 1
    if tag == "not"
        let v = _eval(f[1], asgn)
        if v == 0
            return 1
        return 0
    if tag == "and"
        let v1 = _eval(f[1], asgn)
        if v1 == 0
            return 0
        return _eval(f[2], asgn)
    if tag == "or"
        let v1 = _eval(f[1], asgn)
        if v1 == 1
            return 1
        return _eval(f[2], asgn)
    if tag == "imp"
        let v1 = _eval(f[1], asgn)
        if v1 == 0
            return 1
        return _eval(f[2], asgn)
    0

fn _collect_vars(f, vs)
    let tag = _eval_tag(f)
    if tag == "var"
        let name = f[1]
        let n = len(vs)
        let i = 0
        let found = 0
        while i < n
            if vs[i] == name
                found = 1
            i = i + 1
        if found == 0
            push(vs, name)
        return
    if tag == "not"
        _collect_vars(f[1], vs)
        return
    if tag == "and"
        _collect_vars(f[1], vs)
        _collect_vars(f[2], vs)
        return
    if tag == "or"
        _collect_vars(f[1], vs)
        _collect_vars(f[2], vs)
        return
    if tag == "imp"
        _collect_vars(f[1], vs)
        _collect_vars(f[2], vs)
        return

fn _tt_is_tautology(f) -> bool
    let vs = []
    _collect_vars(f, vs)
    let k = len(vs)
    let total = 1 << k
    let i = 0
    while i < total
        let asgn = []
        let b = 0
        while b < k
            push(asgn, [vs[b], (i >> b) & 1])
            b = b + 1
        if _eval(f, asgn) == 0
            return false
        i = i + 1
    true

fn _tt_is_sat(f) -> bool
    let vs = []
    _collect_vars(f, vs)
    let k = len(vs)
    let total = 1 << k
    let i = 0
    while i < total
        let asgn = []
        let b = 0
        while b < k
            push(asgn, [vs[b], (i >> b) & 1])
            b = b + 1
        if _eval(f, asgn) == 1
            return true
        i = i + 1
    false

// =========================================================================
// Formula constructors
// =========================================================================

fn mkvar(name) -> list
    ["var", name]

fn mknot(f) -> list
    ["not", f]

fn mkand(a, b) -> list
    ["and", a, b]

fn mkor(a, b) -> list
    ["or", a, b]

fn mkimp(a, b) -> list
    ["imp", a, b]

fn mkbot() -> list
    ["bot"]

fn mktop() -> list
    ["top"]

fn main()
    let fa = mkvar("A")
    let fb = mkvar("B")
    let fc = mkvar("C")

    // =========================================================================
    // KAT 1: ptab_is_valid(imp(A,A)) = true
    // =========================================================================
    let imp_aa = mkimp(fa, fa)
    ckb("valid_impAA", ptab_is_valid(imp_aa), true)

    // =========================================================================
    // KAT 2: ptab_is_valid(or(A, not(A))) = true  (law of excluded middle)
    // =========================================================================
    let or_a_na = mkor(fa, mknot(fa))
    ckb("valid_or_A_notA", ptab_is_valid(or_a_na), true)

    // =========================================================================
    // KAT 3: ptab_is_valid(A) = false  (A alone is not a tautology)
    // =========================================================================
    ckb("valid_A_false", ptab_is_valid(fa), false)

    // =========================================================================
    // KAT 4: ptab_is_valid(imp(imp(imp(A,B),A),A)) = true  (Peirce's law)
    // =========================================================================
    let peirce = mkimp(mkimp(mkimp(fa, fb), fa), fa)
    ckb("valid_peirce", ptab_is_valid(peirce), true)

    // =========================================================================
    // KAT 5: ptab_is_satisfiable(and(A, not(A))) = false
    // =========================================================================
    let and_a_na = mkand(fa, mknot(fa))
    ckb("sat_and_A_notA_false", ptab_is_satisfiable(and_a_na), false)

    // =========================================================================
    // KAT 6: More validity tests
    // =========================================================================
    // Double negation: not(not(A)) -> A
    let dne = mkimp(mknot(mknot(fa)), fa)
    ckb("valid_dne", ptab_is_valid(dne), true)

    // Modus ponens tautology: (A and (A -> B)) -> B
    let mp = mkimp(mkand(fa, mkimp(fa, fb)), fb)
    ckb("valid_mp", ptab_is_valid(mp), true)

    // A -> (B -> A)
    let k_axiom = mkimp(fa, mkimp(fb, fa))
    ckb("valid_K_axiom", ptab_is_valid(k_axiom), true)

    // A -> B is not a tautology
    let imp_ab = mkimp(fa, fb)
    ckb("valid_impAB_false", ptab_is_valid(imp_ab), false)

    // =========================================================================
    // KAT 7: ptab_is_contradiction tests
    // =========================================================================
    ckb("contra_and_A_notA", ptab_is_contradiction(and_a_na), true)
    ckb("contra_A_false", ptab_is_contradiction(fa), false)
    ckb("contra_bot_true", ptab_is_contradiction(mkbot()), true)
    ckb("contra_top_false", ptab_is_contradiction(mktop()), false)

    // =========================================================================
    // CROSS-CHECK 1: ptab_is_valid(f) == _tt_is_tautology(f) for many formulas
    // =========================================================================
    // We check a set of formulas with 1-3 variables.

    // 1-var formulas
    ckb("cross_A", ptab_is_valid(fa), _tt_is_tautology(fa))
    ckb("cross_notA", ptab_is_valid(mknot(fa)), _tt_is_tautology(mknot(fa)))
    ckb("cross_A_or_notA", ptab_is_valid(mkor(fa, mknot(fa))), _tt_is_tautology(mkor(fa, mknot(fa))))
    ckb("cross_A_and_notA", ptab_is_valid(mkand(fa, mknot(fa))), _tt_is_tautology(mkand(fa, mknot(fa))))
    ckb("cross_A_imp_A", ptab_is_valid(mkimp(fa, fa)), _tt_is_tautology(mkimp(fa, fa)))
    ckb("cross_impAA_dne", ptab_is_valid(dne), _tt_is_tautology(dne))

    // 2-var formulas
    ckb("cross_A_imp_B", ptab_is_valid(imp_ab), _tt_is_tautology(imp_ab))
    ckb("cross_B_imp_A", ptab_is_valid(mkimp(fb, fa)), _tt_is_tautology(mkimp(fb, fa)))
    ckb("cross_A_or_B", ptab_is_valid(mkor(fa, fb)), _tt_is_tautology(mkor(fa, fb)))
    ckb("cross_A_and_B", ptab_is_valid(mkand(fa, fb)), _tt_is_tautology(mkand(fa, fb)))
    ckb("cross_peirce", ptab_is_valid(peirce), _tt_is_tautology(peirce))
    ckb("cross_mp", ptab_is_valid(mp), _tt_is_tautology(mp))
    ckb("cross_K", ptab_is_valid(k_axiom), _tt_is_tautology(k_axiom))
    // (A -> B) -> ((B -> C) -> (A -> C))  -- hypothetical syllogism
    let hyp_syl = mkimp(imp_ab, mkimp(mkimp(fb, fc), mkimp(fa, fc)))
    ckb("cross_hyp_syl", ptab_is_valid(hyp_syl), _tt_is_tautology(hyp_syl))
    // (A -> B) and not B -> not A (modus tollens as formula)
    let mt = mkimp(mkand(imp_ab, mknot(fb)), mknot(fa))
    ckb("cross_modus_tollens", ptab_is_valid(mt), _tt_is_tautology(mt))
    // De Morgan: not(A and B) <-> (not A or not B)  as imp both ways
    let demorgan1 = mkimp(mknot(mkand(fa, fb)), mkor(mknot(fa), mknot(fb)))
    let demorgan2 = mkimp(mkor(mknot(fa), mknot(fb)), mknot(mkand(fa, fb)))
    ckb("cross_demorgan1", ptab_is_valid(demorgan1), _tt_is_tautology(demorgan1))
    ckb("cross_demorgan2", ptab_is_valid(demorgan2), _tt_is_tautology(demorgan2))

    // 3-var formula
    // Distribution: A and (B or C) <-> (A and B) or (A and C)
    let dist1 = mkimp(mkand(fa, mkor(fb, fc)), mkor(mkand(fa, fb), mkand(fa, fc)))
    let dist2 = mkimp(mkor(mkand(fa, fb), mkand(fa, fc)), mkand(fa, mkor(fb, fc)))
    ckb("cross_dist1", ptab_is_valid(dist1), _tt_is_tautology(dist1))
    ckb("cross_dist2", ptab_is_valid(dist2), _tt_is_tautology(dist2))

    // =========================================================================
    // CROSS-CHECK 2: ptab_is_satisfiable(f) == _tt_is_sat(f) for same formulas
    // =========================================================================
    ckb("sat_cross_A", ptab_is_satisfiable(fa), _tt_is_sat(fa))
    ckb("sat_cross_notA", ptab_is_satisfiable(mknot(fa)), _tt_is_sat(mknot(fa)))
    ckb("sat_cross_A_and_notA", ptab_is_satisfiable(and_a_na), _tt_is_sat(and_a_na))
    ckb("sat_cross_A_or_notA", ptab_is_satisfiable(or_a_na), _tt_is_sat(or_a_na))
    ckb("sat_cross_A_and_B", ptab_is_satisfiable(mkand(fa, fb)), _tt_is_sat(mkand(fa, fb)))
    ckb("sat_cross_impAA", ptab_is_satisfiable(imp_aa), _tt_is_sat(imp_aa))
    ckb("sat_cross_bot", ptab_is_satisfiable(mkbot()), _tt_is_sat(mkbot()))
    ckb("sat_cross_top", ptab_is_satisfiable(mktop()), _tt_is_sat(mktop()))
    ckb("sat_cross_peirce", ptab_is_satisfiable(peirce), _tt_is_sat(peirce))
    ckb("sat_cross_dist1", ptab_is_satisfiable(dist1), _tt_is_sat(dist1))
    ckb("sat_cross_mt", ptab_is_satisfiable(mt), _tt_is_sat(mt))

    print("PASS _proof_tableau_test")
