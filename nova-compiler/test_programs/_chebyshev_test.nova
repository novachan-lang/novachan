import std/poly/chebyshev

// Known-answer tests for std/poly/chebyshev.
// Tolerance 0.0001 for all float comparisons.

fn approx(a: float, b: float, tol: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    d < tol

fn ckf(label: str, got: float, want: float)
    if not approx(got, want, 0.0001)
        print("FAIL chebyshev " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL chebyshev " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cklen(label: str, lst: list, want: int)
    let n = len(lst)
    if n != want
        print("FAIL chebyshev " + label + " len: got=" + str(n) + " want=" + str(want))
        exit(1)

fn ckcoeff(label: str, lst: list, idx: int, want: float)
    let v = lst[idx] * 1.0
    if not approx(v, want, 0.0001)
        print("FAIL chebyshev " + label + "[" + str(idx) + "]: got=" + str(v) + " want=" + str(want))
        exit(1)

fn main()
    // --- T_0 = 1 = [1] ---
    let t0 = cheb_t(0)
    cklen("T0_len", t0, 1)
    ckcoeff("T0_c0", t0, 0, 1.0)

    // --- T_1 = x = [0,1] ---
    let t1 = cheb_t(1)
    cklen("T1_len", t1, 2)
    ckcoeff("T1_c0", t1, 0, 0.0)
    ckcoeff("T1_c1", t1, 1, 1.0)

    // --- T_2 = 2x^2 - 1 = [-1,0,2] ---
    let t2 = cheb_t(2)
    cklen("T2_len", t2, 3)
    ckcoeff("T2_c0", t2, 0, -1.0)
    ckcoeff("T2_c1", t2, 1, 0.0)
    ckcoeff("T2_c2", t2, 2, 2.0)

    // --- T_3 = 4x^3 - 3x = [0,-3,0,4] ---
    let t3 = cheb_t(3)
    cklen("T3_len", t3, 4)
    ckcoeff("T3_c0", t3, 0, 0.0)
    ckcoeff("T3_c1", t3, 1, -3.0)
    ckcoeff("T3_c2", t3, 2, 0.0)
    ckcoeff("T3_c3", t3, 3, 4.0)

    // --- cheb_eval_t KATs ---
    // T_2(1) = 2*1 - 1 = 1
    let et21 = cheb_eval_t(2, 1.0)
    ckf("eval_T2_1", et21, 1.0)

    // T_3(1) = 4*1 - 3*1 = 1
    let et31 = cheb_eval_t(3, 1.0)
    ckf("eval_T3_1", et31, 1.0)

    // T_2(0) = -1
    let et20 = cheb_eval_t(2, 0.0)
    ckf("eval_T2_0", et20, -1.0)

    // T_0(5) = 1  (constant)
    let et05 = cheb_eval_t(0, 5.0)
    ckf("eval_T0_5", et05, 1.0)

    // T_1(0.5) = 0.5
    let et10h = cheb_eval_t(1, 0.5)
    ckf("eval_T1_half", et10h, 0.5)

    // --- U_0 = 1, U_1 = 2x ---
    let u0 = cheb_u(0)
    cklen("U0_len", u0, 1)
    ckcoeff("U0_c0", u0, 0, 1.0)

    let u1 = cheb_u(1)
    cklen("U1_len", u1, 2)
    ckcoeff("U1_c0", u1, 0, 0.0)
    ckcoeff("U1_c1", u1, 1, 2.0)

    // --- U_2 = 4x^2 - 1 = [-1,0,4] ---
    let u2 = cheb_u(2)
    cklen("U2_len", u2, 3)
    ckcoeff("U2_c0", u2, 0, -1.0)
    ckcoeff("U2_c1", u2, 1, 0.0)
    ckcoeff("U2_c2", u2, 2, 4.0)

    // --- cheb_eval_u ---
    // U_2(1) = 4 - 1 = 3
    let eu21 = cheb_eval_u(2, 1.0)
    ckf("eval_U2_1", eu21, 3.0)

    // U_1(0.5) = 2*0.5 = 1.0
    let eu10h = cheb_eval_u(1, 0.5)
    ckf("eval_U1_half", eu10h, 1.0)

    // --- cheb_roots_t ---
    // T_1 has one root at x=0
    let r1 = cheb_roots_t(1)
    cklen("roots_T1_len", r1, 1)
    let r1v = r1[0] * 1.0
    ckf("roots_T1_val", r1v, 0.0)

    // T_2 has roots at -1/sqrt(2), +1/sqrt(2) ~= -0.7071, 0.7071
    let r2 = cheb_roots_t(2)
    cklen("roots_T2_len", r2, 2)
    let r2a = r2[0] * 1.0
    let r2b = r2[1] * 1.0
    ckf("roots_T2_lo", r2a, -0.7071)
    ckf("roots_T2_hi", r2b, 0.7071)
    // Verify T_2 is ~0 at each root
    let chk2a = cheb_eval_t(2, r2a)
    let chk2b = cheb_eval_t(2, r2b)
    ckf("roots_T2_verify_lo", chk2a, 0.0)
    ckf("roots_T2_verify_hi", chk2b, 0.0)

    // T_3 has 3 roots — just check count and T_3(root) ~= 0
    let r3 = cheb_roots_t(3)
    cklen("roots_T3_len", r3, 3)
    let r3a = r3[0] * 1.0
    let r3b = r3[1] * 1.0
    let r3c = r3[2] * 1.0
    let chk3a = cheb_eval_t(3, r3a)
    let chk3b = cheb_eval_t(3, r3b)
    let chk3c = cheb_eval_t(3, r3c)
    ckf("roots_T3_verify0", chk3a, 0.0)
    ckf("roots_T3_verify1", chk3b, 0.0)
    ckf("roots_T3_verify2", chk3c, 0.0)

    // --- cheb_clenshaw ---
    // Series [1,0,0] = 1*T_0 + 0*T_1 + 0*T_2 = 1 at any x
    let cs0 = [1.0, 0.0, 0.0]
    let cl0 = cheb_clenshaw(cs0, 0.5)
    ckf("clenshaw_const", cl0, 1.0)

    // Series [0,1] = T_1(x) = x; at x=0.3 -> 0.3
    let cs1 = [0.0, 1.0]
    let cl1 = cheb_clenshaw(cs1, 0.3)
    ckf("clenshaw_T1_at03", cl1, 0.3)

    // Series [c0] (length 1) = c0
    let csc = [3.5]
    let clc = cheb_clenshaw(csc, 0.7)
    ckf("clenshaw_scalar", clc, 3.5)

    // Series [] -> 0.0
    let cse = []
    let cle = cheb_clenshaw(cse, 1.0)
    ckf("clenshaw_empty", cle, 0.0)

    // --- cheb_degree ---
    cki("degree_0", cheb_degree(0), 0)
    cki("degree_1", cheb_degree(1), 1)
    cki("degree_5", cheb_degree(5), 5)

    print("PASS _chebyshev_test")
