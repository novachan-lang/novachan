// KAT test for std/media/ico
// Covers:
//   (a) Exact magic/header bytes for a 1-entry ICO (ICONDIR reserved=0, type=1, count=1)
//   (b) Byte-exact ICONDIRENTRY fields for w=16,h=16,bitcount=32,data=bytes(40)
//   (c) Full ico_build -> ico_parse round-trip equality check
//   (d) Malformed input returns []
import std/media/ico

// ── Helper: assert int equality ───────────────────────────────────────────────
fn cki(label, got, want)
    if got != want
        print("FAIL ico " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // Build a 1-entry ICO: w=16, h=16, bitcount=32, data=bytes(40)
    let data40 = bytes(40)
    let entry0 = {"w": 16, "h": 16, "bitcount": 32, "data": data40}
    let entries = [entry0]
    let ico = ico_build(entries)

    // ── (a) Total file size = ICONDIR(6) + ICONDIRENTRY(16) + data(40) = 62 ──
    cki("total_len", bytes_len(ico), 62)

    // ── ICONDIR bytes ─────────────────────────────────────────────────────────
    // u16@0 reserved = 0 (LE)
    cki("reserved_lo", bytes_get(ico, 0), 0)
    cki("reserved_hi", bytes_get(ico, 1), 0)

    // u16@2 type = 1 (LE)
    let itype = bytes_get(ico, 2) | (bytes_get(ico, 3) * 256)
    cki("type", itype, 1)

    // u16@4 count = 1 (LE)
    let icount = bytes_get(ico, 4) | (bytes_get(ico, 5) * 256)
    cki("count", icount, 1)

    // ── (b) ICONDIRENTRY at file offset 6 ────────────────────────────────────
    // byte 6: w = 16
    cki("entry_w", bytes_get(ico, 6), 16)
    // byte 7: h = 16
    cki("entry_h", bytes_get(ico, 7), 16)
    // byte 8: ncolors = 0
    cki("entry_ncolors", bytes_get(ico, 8), 0)
    // byte 9: reserved = 0
    cki("entry_reserved", bytes_get(ico, 9), 0)
    // u16@10 planes = 1 (LE)
    let planes = bytes_get(ico, 10) | (bytes_get(ico, 11) * 256)
    cki("entry_planes", planes, 1)
    // u16@12 bitcount = 32 (LE)
    let bitcount = bytes_get(ico, 12) | (bytes_get(ico, 13) * 256)
    cki("entry_bitcount", bitcount, 32)
    // u32@14 bytesize = 40 (LE)
    let bytesize = bytes_get(ico, 14) | (bytes_get(ico, 15) * 256) | (bytes_get(ico, 16) * 65536) | (bytes_get(ico, 17) * 16777216)
    cki("entry_bytesize", bytesize, 40)
    // u32@18 offset = 22 (LE) — first blob = 6 + 16*1 = 22
    let bloboff = bytes_get(ico, 18) | (bytes_get(ico, 19) * 256) | (bytes_get(ico, 20) * 65536) | (bytes_get(ico, 21) * 16777216)
    cki("entry_offset", bloboff, 22)

    // ── Data blob: bytes 22..61 should all be 0 ───────────────────────────────
    cki("blob_byte22", bytes_get(ico, 22), 0)
    cki("blob_byte61", bytes_get(ico, 61), 0)

    // ── (c) Round-trip: ico_parse on the built file ───────────────────────────
    let parsed = ico_parse(ico)
    cki("parse_count", len(parsed), 1)
    let p0 = parsed[0]
    cki("rt_w", p0["w"], 16)
    cki("rt_h", p0["h"], 16)
    cki("rt_size", p0["size"], 40)
    cki("rt_offset", p0["offset"], 22)

    // ── 2-entry build/parse round-trip ───────────────────────────────────────
    // Entry 0: w=32, h=32, bitcount=24, data=bytes(12)
    // Entry 1: w=16, h=16, bitcount=32, data=bytes(8)
    // blob_base = 6 + 16*2 = 38
    // offset of entry0 blob = 38; offset of entry1 blob = 38+12 = 50
    let data12 = bytes(12)
    let data8 = bytes(8)
    let e2a = {"w": 32, "h": 32, "bitcount": 24, "data": data12}
    let e2b = {"w": 16, "h": 16, "bitcount": 32, "data": data8}
    let entries2 = [e2a, e2b]
    let ico2 = ico_build(entries2)
    // Total size = 6 + 32 + 12 + 8 = 58
    cki("2entry_total_len", bytes_len(ico2), 58)
    // ICONDIR count = 2
    let cnt2 = bytes_get(ico2, 4) | (bytes_get(ico2, 5) * 256)
    cki("2entry_count", cnt2, 2)
    // Entry 0 at file offset 6
    cki("2e0_w", bytes_get(ico2, 6), 32)
    cki("2e0_h", bytes_get(ico2, 7), 32)
    let off0 = bytes_get(ico2, 18) | (bytes_get(ico2, 19) * 256) | (bytes_get(ico2, 20) * 65536) | (bytes_get(ico2, 21) * 16777216)
    cki("2e0_offset", off0, 38)
    // Entry 1 at file offset 22
    cki("2e1_w", bytes_get(ico2, 22), 16)
    cki("2e1_h", bytes_get(ico2, 23), 16)
    let off1 = bytes_get(ico2, 34) | (bytes_get(ico2, 35) * 256) | (bytes_get(ico2, 36) * 65536) | (bytes_get(ico2, 37) * 16777216)
    cki("2e1_offset", off1, 50)
    // Parse the 2-entry file
    let p2 = ico_parse(ico2)
    cki("2rt_count", len(p2), 2)
    let p2e0 = p2[0]
    let p2e1 = p2[1]
    cki("2rt_e0_w", p2e0["w"], 32)
    cki("2rt_e0_size", p2e0["size"], 12)
    cki("2rt_e0_offset", p2e0["offset"], 38)
    cki("2rt_e1_w", p2e1["w"], 16)
    cki("2rt_e1_size", p2e1["size"], 8)
    cki("2rt_e1_offset", p2e1["offset"], 50)

    // ── (d) Malformed input → empty list ─────────────────────────────────────
    // Too short
    let bad1 = bytes(3)
    let bp1 = ico_parse(bad1)
    cki("bad_short_len", len(bp1), 0)

    // Non-zero reserved word → invalid
    let bad2 = bytes(0)
    bad2 = bytes_append(bad2, 1)
    bad2 = bytes_append(bad2, 0)
    bad2 = bytes_append(bad2, 1)
    bad2 = bytes_append(bad2, 0)
    bad2 = bytes_append(bad2, 1)
    bad2 = bytes_append(bad2, 0)
    let bp2 = ico_parse(bad2)
    cki("bad_reserved_len", len(bp2), 0)

    // Wrong type (type=3)
    let bad3 = bytes(0)
    bad3 = bytes_append(bad3, 0)
    bad3 = bytes_append(bad3, 0)
    bad3 = bytes_append(bad3, 3)
    bad3 = bytes_append(bad3, 0)
    bad3 = bytes_append(bad3, 0)
    bad3 = bytes_append(bad3, 0)
    let bp3 = ico_parse(bad3)
    cki("bad_type_len", len(bp3), 0)

    // Empty entries list → bytes(0) (empty)
    let empty_entries = []
    let ico_empty = ico_build(empty_entries)
    cki("empty_build_len", bytes_len(ico_empty), 0)

    print("PASS _ico_test")
