fn naturals(start: int)
    let i = start
    while true
        yield i
        i = i + 1

fn fib_gen()
    let a = 0
    let b = 1
    while true
        yield a
        let t = a + b
        a = b
        b = t

fn finite_gen(n: int)
    let i = 0
    while i < n
        yield i * i
        i = i + 1

fn main()
    let count = 0
    for n in naturals(0)
        if n >= 10
            break
        count = count + 1
    assert_eq(count, 10)

    let sum = 0
    for n in naturals(1)
        if n > 100
            break
        sum = sum + n
    assert_eq(sum, 5050)

    let fibs = []
    for f in fib_gen()
        if f > 100
            break
        push(fibs, f)
    assert_eq(len(fibs), 12)
    assert_eq(fibs[0], 0)
    assert_eq(fibs[1], 1)
    assert_eq(fibs[10], 55)
    assert_eq(fibs[11], 89)

    let squares = []
    for s in finite_gen(5)
        push(squares, s)
    assert_eq(squares, [0, 1, 4, 9, 16])

    print("lazy_gen_probe: all passed")
