// KAT test for std/random/sample.
// All concrete expected values are hand-computed against the LCG specification:
//   state = (state * 6364136223846793005 + 1442695040888963407) & 0x7FFFFFFFFFFFFFFF
//
// Computed values verified independently via Python simulation.

import std/random/sample

// ── helpers ──────────────────────────────────────────────────────────────────

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got " + got + " want " + want)
        exit(1)

fn _int_in_list(xs: list, v: int) -> int
    let i = 0
    while i < len(xs)
        if xs[i] == v
            return 1
        i = i + 1
    0

fn _all_in_src(samp: list, src: list) -> int
    let i = 0
    while i < len(samp)
        if _int_in_list(src, samp[i]) == 0
            return 0
        i = i + 1
    1

fn _all_distinct(xs: list) -> int
    let i = 0
    while i < len(xs)
        let j = i + 1
        while j < len(xs)
            if xs[i] == xs[j]
                return 0
            j = j + 1
        i = i + 1
    1

fn _list_eq_str(a: list, b: list) -> int
    if len(a) != len(b)
        return 0
    let i = 0
    while i < len(a)
        if a[i] != b[i]
            return 0
        i = i + 1
    1

// ── KAT 1: rs_uniform_int(3, 3, 7) == 3  (lo==hi always returns lo) ─────────
fn test_uniform_same()
    let r = rs_uniform_int(3, 3, 7)
    cki("KAT1 uniform_same", r, 3)
    print("KAT1 rs_uniform_int(3,3,7)==3: PASS")

// ── KAT 2: rs_uniform_int(0, 9, 7) within [0, 9] ────────────────────────────
fn test_uniform_range()
    let r = rs_uniform_int(0, 9, 7)
    // Python simulation: rs_uniform_int(0,9,7)=0
    if r < 0 or r > 9
        print("FAIL KAT2 uniform_range: out of [0,9]: " + str(r))
        exit(1)
    cki("KAT2 uniform_range concrete", r, 0)
    print("KAT2 rs_uniform_int(0,9,7) in [0,9]: PASS")

// ── KAT 3: rs_weighted weight-0 exclusion — weight [0,1] always picks "b" ───
fn test_weighted_zero_first()
    let items = ["a", "b"]
    let weights = [0, 1]
    let r = rs_weighted(items, weights, 5)
    cks("KAT3 weighted_zero_first", r, "b")
    print("KAT3 rs_weighted([a,b],[0,1],5)==b: PASS")

// ── KAT 4: rs_weighted weight [1,0] always picks "a" ─────────────────────────
fn test_weighted_zero_second()
    let items = ["a", "b"]
    let weights = [1, 0]
    let r = rs_weighted(items, weights, 5)
    cks("KAT4 weighted_zero_second", r, "a")
    print("KAT4 rs_weighted([a,b],[1,0],5)==a: PASS")

// ── KAT 5: rs_with_replacement single-item list, k=4 ─────────────────────────
fn test_with_replacement_single()
    let items = ["x"]
    let r = rs_with_replacement(items, 4, 9)
    if len(r) != 4
        print("FAIL KAT5 with_replacement_single: len=" + str(len(r)))
        exit(1)
    let i = 0
    while i < 4
        if r[i] != "x"
            print("FAIL KAT5 with_replacement_single: r[" + str(i) + "]=" + r[i])
            exit(1)
        i = i + 1
    print("KAT5 rs_with_replacement([x],4,9)==[x,x,x,x]: PASS")

// ── KAT 6: rs_reservoir length, distinctness, membership ─────────────────────
fn test_reservoir_properties()
    let src = [1, 2, 3, 4, 5]
    let r = rs_reservoir(src, 3, 42)
    if len(r) != 3
        print("FAIL KAT6 reservoir_len: got " + str(len(r)))
        exit(1)
    if _all_distinct(r) == 0
        print("FAIL KAT6 reservoir_distinct: duplicates in result")
        exit(1)
    if _all_in_src(r, src) == 0
        print("FAIL KAT6 reservoir_membership: result contains unknown element")
        exit(1)
    print("KAT6 rs_reservoir([1..5],3,42) len=3 distinct all_in_src: PASS")

// ── KAT 7: rs_reservoir determinism — same seed same result ──────────────────
fn test_reservoir_determinism()
    let src = [1, 2, 3, 4, 5]
    let r1 = rs_reservoir(src, 3, 42)
    let r2 = rs_reservoir(src, 3, 42)
    if _list_eq_str(r1, r2) == 0
        print("FAIL KAT7 reservoir_determinism: two calls with same seed differ")
        exit(1)
    // Concrete values: Python simulation gives [5,4,3]
    cki("KAT7 reservoir[0]", r1[0], 5)
    cki("KAT7 reservoir[1]", r1[1], 4)
    cki("KAT7 reservoir[2]", r1[2], 3)
    print("KAT7 rs_reservoir determinism + concrete values [5,4,3]: PASS")

// ── KAT 8: rs_uniform_int concrete hard-coded KAT ────────────────────────────
// Python simulation: rs_uniform_int(0, 99, 12345) = 88
fn test_uniform_concrete()
    let r = rs_uniform_int(0, 99, 12345)
    cki("KAT8 uniform_concrete", r, 88)
    print("KAT8 rs_uniform_int(0,99,12345)==88: PASS")

// ── KAT 9: different seeds produce different results (basic entropy check) ────
fn test_seed_sensitivity()
    let r1 = rs_uniform_int(0, 1000000, 1)
    let r2 = rs_uniform_int(0, 1000000, 2)
    // Astronomically unlikely they are equal.
    if r1 == r2
        print("FAIL KAT9 seed_sensitivity: two seeds gave same result")
        exit(1)
    print("KAT9 different seeds produce different results: PASS")

// ── KAT 10: rs_with_replacement length invariant ─────────────────────────────
fn test_with_replacement_length()
    let items = ["a", "b", "c"]
    let r = rs_with_replacement(items, 10, 777)
    if len(r) != 10
        print("FAIL KAT10 with_replacement_length: got " + str(len(r)))
        exit(1)
    // All items must be from the input list.
    let valid = ["a", "b", "c"]
    let i = 0
    while i < len(r)
        let found = 0
        let j = 0
        while j < len(valid)
            if r[i] == valid[j]
                found = 1
            j = j + 1
        if found == 0
            print("FAIL KAT10 with_replacement_length: unknown item " + r[i])
            exit(1)
        i = i + 1
    print("KAT10 rs_with_replacement([a,b,c],10,777) len=10 all_valid: PASS")

fn main()
    test_uniform_same()
    test_uniform_range()
    test_weighted_zero_first()
    test_weighted_zero_second()
    test_with_replacement_single()
    test_reservoir_properties()
    test_reservoir_determinism()
    test_uniform_concrete()
    test_seed_sensitivity()
    test_with_replacement_length()
    print("_sample_test passed")
