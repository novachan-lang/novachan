// KAT for std/os/tempname — deterministic temp-name generation.
import std/os/tempname

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL tempname " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL tempname " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL tempname " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn starts_with(s: string, prefix: string) -> bool
    if len(s) < len(prefix)
        return false
    return slice(s, 0, len(prefix)) == prefix

fn ends_with(s: string, suffix: string) -> bool
    let sn = len(s)
    let pn = len(suffix)
    if sn < pn
        return false
    return slice(s, sn - pn, sn) == suffix

fn main()
    // KAT 1: temp_name starts with given prefix
    let n1 = temp_name(42, "tmp", ".txt")
    if not starts_with(n1, "tmp")
        print("FAIL tempname starts_prefix: got=" + n1)
        exit(1)

    // KAT 2: temp_name ends with given ext
    if not ends_with(n1, ".txt")
        print("FAIL tempname ends_ext: got=" + n1)
        exit(1)

    // KAT 3: deterministic — same seed gives same name
    let n1b = temp_name(42, "tmp", ".txt")
    cks("deterministic", n1, n1b)

    // KAT 4: different seeds give different names
    let na = temp_name(1, "t", "")
    let nb = temp_name(2, "t", "")
    if na == nb
        print("FAIL tempname different_seeds_same: " + na)
        exit(1)

    // KAT 5: temp_name_n returns n distinct names
    let names = temp_name_n(5, 3)
    cki("temp_name_n_len", len(names), 3)

    // All distinct
    if names[0] == names[1]
        print("FAIL tempname distinct_0_1")
        exit(1)
    if names[0] == names[2]
        print("FAIL tempname distinct_0_2")
        exit(1)
    if names[1] == names[2]
        print("FAIL tempname distinct_1_2")
        exit(1)

    // KAT 6: temp_name_n names start with "tmp"
    if not starts_with(names[0], "tmp")
        print("FAIL tempname n_prefix: got=" + names[0])
        exit(1)

    // KAT 7: is_safe_name true for simple names
    ckb("safe_simple", is_safe_name("a.txt"), true)
    ckb("safe_letters", is_safe_name("tempfile123"), true)

    // KAT 8: is_safe_name false for ".."
    ckb("unsafe_dotdot", is_safe_name("../x"), false)

    // KAT 9: is_safe_name false for "/"
    ckb("unsafe_slash", is_safe_name("a/b"), false)

    // KAT 10: is_safe_name false for empty
    ckb("unsafe_empty", is_safe_name(""), false)

    // KAT 11: is_safe_name false for backslash
    ckb("unsafe_backslash", is_safe_name("a\\b"), false)

    // KAT 12: temp_name_n is deterministic — same seed same results
    let names2 = temp_name_n(5, 3)
    cks("n_det_0", names[0], names2[0])
    cks("n_det_1", names[1], names2[1])
    cks("n_det_2", names[2], names2[2])

    print("PASS _tempname_test")
