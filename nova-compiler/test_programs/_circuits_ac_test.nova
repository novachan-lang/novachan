// KAT for std/physics/circuits_ac — reactance, impedance, resonant frequency.
import std/physics/circuits_ac

// approx — absolute float equality within 0.001 tolerance.
fn approx(a, b)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < 0.001

// approx_rel — relative tolerance: |a-b|/|b| < tol
fn approx_rel(a, b, tol)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    let babs = b
    if babs < 0.0
        babs = 0.0 - babs
    let ratio = d / babs
    return ratio < tol

fn main()
    // KAT 1: impedance(3.0, 4.0, 0.0) = sqrt(9 + 16) = 5.0
    let z = impedance(3.0, 4.0, 0.0)
    if not approx(z, 5.0)
        print("FAIL circuits_ac impedance(3,4,0): got=" + str(z) + " want=5.0")
        exit(1)

    // KAT 2: impedance(0.0, 0.0, 0.0) = 0.0 (pure DC, no reactance)
    let z0 = impedance(0.0, 0.0, 0.0)
    if not approx(z0, 0.0)
        print("FAIL circuits_ac impedance(0,0,0): got=" + str(z0) + " want=0.0")
        exit(1)

    // KAT 3: impedance(5.0, 0.0, 0.0) = 5.0 (pure resistive)
    let zr = impedance(5.0, 0.0, 0.0)
    if not approx(zr, 5.0)
        print("FAIL circuits_ac impedance(5,0,0): got=" + str(zr) + " want=5.0")
        exit(1)

    // KAT 4: resonant_frequency(1.0, 1.0) ~ 0.15915 = 1/(2*pi)
    // Relative tolerance 0.01 (1%)
    let f0 = resonant_frequency(1.0, 1.0)
    let f0_want = 0.15915
    if not approx_rel(f0, f0_want, 0.01)
        print("FAIL circuits_ac resonant_frequency(1,1): got=" + str(f0) + " want~0.15915")
        exit(1)

    // KAT 5: reactance_inductive increases with frequency
    // Xl = 2*pi*f*L; larger f => larger Xl
    let xl_low = reactance_inductive(50.0, 0.1)
    let xl_high = reactance_inductive(100.0, 0.1)
    if xl_high < xl_low
        print("FAIL circuits_ac Xl must increase with freq: xl_low=" + str(xl_low) + " xl_high=" + str(xl_high))
        exit(1)

    // KAT 6: reactance_inductive(f, L) doubles when f doubles (linear)
    let xl1 = reactance_inductive(60.0, 1.0)
    let xl2 = reactance_inductive(120.0, 1.0)
    let xratio = xl2 / xl1
    if not approx(xratio, 2.0)
        print("FAIL circuits_ac Xl linear in freq: ratio=" + str(xratio) + " want=2.0")
        exit(1)

    // KAT 7: reactance_capacitive decreases with frequency (inverse)
    let xc_low = reactance_capacitive(50.0, 0.001)
    let xc_high = reactance_capacitive(100.0, 0.001)
    if xc_high > xc_low
        print("FAIL circuits_ac Xc must decrease with freq: xc_low=" + str(xc_low) + " xc_high=" + str(xc_high))
        exit(1)

    // KAT 8: at resonance Xl == Xc => impedance == R
    // For ind=1.0, cap=1.0: f0 = 1/(2*pi), Xl = 2*pi*f0*L = 1.0, Xc = 1/(2*pi*f0*C) = 1.0
    let ind = 1.0
    let cap = 1.0
    let freq = resonant_frequency(ind, cap)
    let xl_res = reactance_inductive(freq, ind)
    let xc_res = reactance_capacitive(freq, cap)
    let z_res = impedance(10.0, xl_res, xc_res)
    // At resonance, Z should equal R = 10.0
    if not approx(z_res, 10.0)
        print("FAIL circuits_ac resonance Z==R: got=" + str(z_res) + " want=10.0")
        exit(1)

    print("PASS _circuits_ac_test")
