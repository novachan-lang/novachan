// KAT for std/text/md_table
import std/text/md_table

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL md_table " + label + ": got [" + got + "]")
        exit(1)

fn main()
    // canonical KAT from spec
    let nl = chr(10)
    let t1 = "| A | B |" + nl + "| - | - |" + nl + "| 1 | 2 |"
    let want1 = "<table><thead><tr><th>A</th><th>B</th></tr></thead><tbody><tr><td>1</td><td>2</td></tr></tbody></table>"
    cks("basic", md_table(t1), want1)

    // multiple body rows
    let t2 = "| Name | Age |" + nl + "| --- | --- |" + nl + "| Alice | 30 |" + nl + "| Bob | 25 |"
    let want2 = "<table><thead><tr><th>Name</th><th>Age</th></tr></thead><tbody><tr><td>Alice</td><td>30</td></tr><tr><td>Bob</td><td>25</td></tr></tbody></table>"
    cks("multi_rows", md_table(t2), want2)

    // trimming: extra spaces around cells
    let t3 = "|  X  |  Y  |" + nl + "|-----|-----|" + nl + "|  a  |  b  |"
    let want3 = "<table><thead><tr><th>X</th><th>Y</th></tr></thead><tbody><tr><td>a</td><td>b</td></tr></tbody></table>"
    cks("trimmed", md_table(t3), want3)

    // three columns
    let t4 = "| C1 | C2 | C3 |" + nl + "| - | - | - |" + nl + "| x | y | z |"
    let want4 = "<table><thead><tr><th>C1</th><th>C2</th><th>C3</th></tr></thead><tbody><tr><td>x</td><td>y</td><td>z</td></tr></tbody></table>"
    cks("three_cols", md_table(t4), want4)

    print("PASS _md_table_test")
