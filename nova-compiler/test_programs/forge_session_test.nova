// forge_session_test -- HMAC-signed, stateless, tamper-evident sessions (review rank 3).
// A signed value round-trips; a wrong secret, a tampered value, or a tampered signature all
// reject; and session_set -> session_get round-trips through a real cookie on a request.
import forge

fn main()
    let secret = "topsecret-key-please-change"

    // round-trip
    let signed = forge.sign_value(secret, "user:42")
    assert(forge.unsign_value(secret, signed) == "user:42", "sign/unsign round-trip")
    print("PASS: sign/unsign round-trip")

    // wrong secret -> rejected
    assert(forge.unsign_value("attacker", signed) == "", "wrong secret rejected")

    // tampered VALUE (re-using the captured signature) -> rejected
    let dot = find(signed, ".")
    let sig = slice(signed, dot + 1, len(signed))
    let forged = "user:1." + sig
    assert(forge.unsign_value(secret, forged) == "", "tampered value rejected")

    // tampered SIGNATURE -> rejected
    let badsig = slice(signed, 0, dot + 1) + "deadbeef"
    assert(forge.unsign_value(secret, badsig) == "", "tampered signature rejected")
    print("PASS: forgery + tamper rejected")

    // full cookie round-trip: set the session on a Response, read its value, carry it on a
    // request, and recover it verified.
    let resp: Response = forge.session_set(forge.resp_text(200, "ok"), secret, "user:42")
    // the Set-Cookie carries the signed session
    let wire = forge.finalize(resp)
    assert(find(wire, "Set-Cookie: session=user:42.") >= 0, "session cookie set + signed")
    let req: Request = forge.build_request("GET / HTTP/1.1\r\nCookie: session=" + signed + "\r\n\r\n", 0)
    assert(forge.session_get(req, secret) == "user:42", "session_get verifies + recovers value")
    // a request with no session cookie -> empty
    let req2: Request = forge.build_request("GET / HTTP/1.1\r\n\r\n", 0)
    assert(forge.session_get(req2, secret) == "", "no session cookie -> empty")
    print("PASS: session_set/session_get cookie round-trip")
    print("forge_session_test passed")
