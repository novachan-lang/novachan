import forge_span_tracker

fn main()
    let s = st_new()
    s = st_start(s, "s1", "http_request", 1000)
    s = st_start(s, "s2", "db_query", 1010)
    assert(st_active_count(s) == 2, "2 active")
    assert(st_is_active(s, "s1") == 1, "s1 active")

    let n = st_name(s, "s1")
    assert(is_ok(n), "name ok")
    assert(unwrap(n) == "http_request", "correct name")

    let e1 = st_end(s, "s2", 1050)
    assert(is_ok(e1), "end s2 ok")
    s = unwrap(e1)
    assert(st_active_count(s) == 1, "1 active")
    assert(st_completed_count(s) == 1, "1 completed")

    let dur = st_duration(s, "s2")
    assert(is_ok(dur), "duration ok")
    assert(unwrap(dur) == 40, "40ms duration")

    let e2 = st_end(s, "s1", 1100)
    assert(is_ok(e2), "end s1 ok")
    s = unwrap(e2)
    assert(st_total_count(s) == 2, "2 total")

    let bad = st_end(s, "s1", 1200)
    assert(is_err(bad), "already ended")

    let bad2 = st_duration(s, "nope")
    assert(is_err(bad2), "unknown span")

    print("SPAN-TRACKER KAT PASS")
