// KAT: std/compress/code_truncated_binary
// Tests: known-answer vectors + round-trip for n in {3,5,7,10} and n=power-of-2.

import std/compress/code_truncated_binary

// ── Helper: compare two lists for equality ────────────────────────────────────
fn _lists_eq(a, b) -> int
    if len(a) != len(b)
        return 0
    let i = 0
    while i < len(a)
        let _unused = 0
        if a[i] != b[i]
            return 0
        i = i + 1
    1

// ── Helper: build a string representation of a list ──────────────────────────
fn _list_str(lst) -> str
    let s = "["
    let i = 0
    while i < len(lst)
        let _unused = 0
        if i > 0
            s = s + ","
        s = s + str(lst[i])
        i = i + 1
    s = s + "]"
    s

// ── KAT 1: known-answer vectors for n=5 ──────────────────────────────────────
// n=5, k=2, u=3: values 0,1,2 use 2 bits; values 3,4 use 3 bits.
// trunc_encode(0,5) == [0,0]
// trunc_encode(1,5) == [0,1]
// trunc_encode(2,5) == [1,0]
// trunc_encode(3,5) == [1,1,0]
// trunc_encode(4,5) == [1,1,1]

let want00 = []
push(want00, 0)
push(want00, 0)
let got00 = trunc_encode(0, 5)
if not _lists_eq(got00, want00)
    print("FAIL code_truncated_binary KAT-n5-v0: got " + _list_str(got00) + " want " + _list_str(want00))
    exit(1)

let want01 = []
push(want01, 0)
push(want01, 1)
let got01 = trunc_encode(1, 5)
if not _lists_eq(got01, want01)
    print("FAIL code_truncated_binary KAT-n5-v1: got " + _list_str(got01) + " want " + _list_str(want01))
    exit(1)

let want02 = []
push(want02, 1)
push(want02, 0)
let got02 = trunc_encode(2, 5)
if not _lists_eq(got02, want02)
    print("FAIL code_truncated_binary KAT-n5-v2: got " + _list_str(got02) + " want " + _list_str(want02))
    exit(1)

let want03 = []
push(want03, 1)
push(want03, 1)
push(want03, 0)
let got03 = trunc_encode(3, 5)
if not _lists_eq(got03, want03)
    print("FAIL code_truncated_binary KAT-n5-v3: got " + _list_str(got03) + " want " + _list_str(want03))
    exit(1)

let want04 = []
push(want04, 1)
push(want04, 1)
push(want04, 1)
let got04 = trunc_encode(4, 5)
if not _lists_eq(got04, want04)
    print("FAIL code_truncated_binary KAT-n5-v4: got " + _list_str(got04) + " want " + _list_str(want04))
    exit(1)

// ── KAT 2: trunc_len for n=5 ─────────────────────────────────────────────────
if trunc_len(0, 5) != 2
    print("FAIL code_truncated_binary trunc_len(0,5): got " + str(trunc_len(0,5)) + " want 2")
    exit(1)
if trunc_len(2, 5) != 2
    print("FAIL code_truncated_binary trunc_len(2,5): got " + str(trunc_len(2,5)) + " want 2")
    exit(1)
if trunc_len(3, 5) != 3
    print("FAIL code_truncated_binary trunc_len(3,5): got " + str(trunc_len(3,5)) + " want 3")
    exit(1)
if trunc_len(4, 5) != 3
    print("FAIL code_truncated_binary trunc_len(4,5): got " + str(trunc_len(4,5)) + " want 3")
    exit(1)

// ── KAT 3: round-trip for n=5 (all values) ───────────────────────────────────
let val5 = 0
while val5 < 5
    let _unused = 0
    let enc5 = trunc_encode(val5, 5)
    let dec5 = trunc_decode(enc5, 0, 5)
    if dec5[0] != val5
        print("FAIL code_truncated_binary round-trip n=5 v=" + str(val5) + ": decoded=" + str(dec5[0]))
        exit(1)
    if dec5[1] != len(enc5)
        print("FAIL code_truncated_binary round-trip n=5 v=" + str(val5) + ": next_pos=" + str(dec5[1]) + " want " + str(len(enc5)))
        exit(1)
    val5 = val5 + 1

// ── KAT 4: round-trip for n=3 (k=1, u=1) ────────────────────────────────────
// n=3: k=1, u=2^2-3=1. value=0 -> 1 bit [0]; values 1,2 -> 2 bits.
let val3 = 0
while val3 < 3
    let _unused = 0
    let enc3 = trunc_encode(val3, 3)
    let dec3 = trunc_decode(enc3, 0, 3)
    if dec3[0] != val3
        print("FAIL code_truncated_binary round-trip n=3 v=" + str(val3) + ": decoded=" + str(dec3[0]))
        exit(1)
    if dec3[1] != len(enc3)
        print("FAIL code_truncated_binary round-trip n=3 v=" + str(val3) + ": next_pos=" + str(dec3[1]) + " want " + str(len(enc3)))
        exit(1)
    val3 = val3 + 1

// ── KAT 5: round-trip for n=7 (k=2, u=1) ────────────────────────────────────
// n=7: k=2, u=2^3-7=1. value=0 -> 2 bits; values 1..6 -> 3 bits.
let val7 = 0
while val7 < 7
    let _unused = 0
    let enc7 = trunc_encode(val7, 7)
    let dec7 = trunc_decode(enc7, 0, 7)
    if dec7[0] != val7
        print("FAIL code_truncated_binary round-trip n=7 v=" + str(val7) + ": decoded=" + str(dec7[0]))
        exit(1)
    if dec7[1] != len(enc7)
        print("FAIL code_truncated_binary round-trip n=7 v=" + str(val7) + ": next_pos=" + str(dec7[1]) + " want " + str(len(enc7)))
        exit(1)
    val7 = val7 + 1

// ── KAT 6: round-trip for n=10 (k=3, u=6) ───────────────────────────────────
// n=10: k=3, u=2^4-10=6. values 0..5 -> 3 bits; values 6..9 -> 4 bits.
let val10 = 0
while val10 < 10
    let _unused = 0
    let enc10 = trunc_encode(val10, 10)
    let dec10 = trunc_decode(enc10, 0, 10)
    if dec10[0] != val10
        print("FAIL code_truncated_binary round-trip n=10 v=" + str(val10) + ": decoded=" + str(dec10[0]))
        exit(1)
    if dec10[1] != len(enc10)
        print("FAIL code_truncated_binary round-trip n=10 v=" + str(val10) + ": next_pos=" + str(dec10[1]) + " want " + str(len(enc10)))
        exit(1)
    val10 = val10 + 1

// ── KAT 7: power-of-2 n=8 -> plain 3-bit binary ──────────────────────────────
// n=8: k=3, u=2^4-8=8. u==n so ALL values use k=3 bits (plain binary).
let val8 = 0
while val8 < 8
    let _unused = 0
    let enc8 = trunc_encode(val8, 8)
    if len(enc8) != 3
        print("FAIL code_truncated_binary n=8 v=" + str(val8) + ": len=" + str(len(enc8)) + " want 3")
        exit(1)
    let dec8 = trunc_decode(enc8, 0, 8)
    if dec8[0] != val8
        print("FAIL code_truncated_binary round-trip n=8 v=" + str(val8) + ": decoded=" + str(dec8[0]))
        exit(1)
    if dec8[1] != 3
        print("FAIL code_truncated_binary round-trip n=8 v=" + str(val8) + ": next_pos=" + str(dec8[1]) + " want 3")
        exit(1)
    val8 = val8 + 1

// ── KAT 8: power-of-2 n=4 -> plain 2-bit binary ──────────────────────────────
let val4 = 0
while val4 < 4
    let _unused = 0
    let enc4 = trunc_encode(val4, 4)
    if len(enc4) != 2
        print("FAIL code_truncated_binary n=4 v=" + str(val4) + ": len=" + str(len(enc4)) + " want 2")
        exit(1)
    let dec4 = trunc_decode(enc4, 0, 4)
    if dec4[0] != val4
        print("FAIL code_truncated_binary round-trip n=4 v=" + str(val4) + ": decoded=" + str(dec4[0]))
        exit(1)
    val4 = val4 + 1

// ── KAT 9: sequence round-trip — concatenate several codes, decode them back ──
// Encode 0,1,2,3,4 for n=5, concatenate into one bit-list, decode sequentially.
let seq_bits = []
let sv = 0
while sv < 5
    let _unused = 0
    let se = trunc_encode(sv, 5)
    let si = 0
    while si < len(se)
        let _unused2 = 0
        push(seq_bits, se[si])
        si = si + 1
    sv = sv + 1

let seq_pos = 0
let seq_val = 0
while seq_val < 5
    let _unused = 0
    let sdec = trunc_decode(seq_bits, seq_pos, 5)
    if sdec[0] != seq_val
        print("FAIL code_truncated_binary seq n=5 v=" + str(seq_val) + ": decoded=" + str(sdec[0]))
        exit(1)
    seq_pos = sdec[1]
    seq_val = seq_val + 1

// ── KAT 10: n=1 edge case -> 0-bit encoding ──────────────────────────────────
let enc1 = trunc_encode(0, 1)
if len(enc1) != 0
    print("FAIL code_truncated_binary n=1 v=0: len=" + str(len(enc1)) + " want 0")
    exit(1)
let dec1 = trunc_decode(enc1, 0, 1)
if dec1[0] != 0
    print("FAIL code_truncated_binary n=1 decode: got " + str(dec1[0]) + " want 0")
    exit(1)
if dec1[1] != 0
    print("FAIL code_truncated_binary n=1 decode next_pos: got " + str(dec1[1]) + " want 0")
    exit(1)

// ── KAT 11: trunc_len consistency with encode ─────────────────────────────────
// For every (n, value) tested above, trunc_len must equal len(trunc_encode).
let nvals = []
push(nvals, 3)
push(nvals, 5)
push(nvals, 7)
push(nvals, 8)
push(nvals, 10)

let ni = 0
while ni < len(nvals)
    let _unused = 0
    let nn = nvals[ni]
    let vv = 0
    while vv < nn
        let _unused2 = 0
        let elen = len(trunc_encode(vv, nn))
        let tlen = trunc_len(vv, nn)
        if elen != tlen
            print("FAIL code_truncated_binary trunc_len n=" + str(nn) + " v=" + str(vv) + ": trunc_len=" + str(tlen) + " encode_len=" + str(elen))
            exit(1)
        vv = vv + 1
    ni = ni + 1

// ── KAT 12: invalid-input guard ──────────────────────────────────────────────
let inv1 = trunc_encode(-1, 5)
if len(inv1) != 0
    print("FAIL code_truncated_binary invalid value=-1: expected []")
    exit(1)
let inv2 = trunc_encode(5, 5)
if len(inv2) != 0
    print("FAIL code_truncated_binary invalid value=n: expected []")
    exit(1)
let inv3 = trunc_encode(0, 0)
if len(inv3) != 0
    print("FAIL code_truncated_binary invalid n=0: expected []")
    exit(1)

print("PASS _code_truncated_binary_test")
