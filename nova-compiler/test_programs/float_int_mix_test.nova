// #13 S2 canary: int/float MIXING must never corrupt. If S2 promotes a list to the
// floatlist (typed-float read) path, a list that ever held an int must NOT be on it —
// else the int element is read as a raw double (garbage). Passes today (no promotion,
// all boxed) and is the gate that S2's promotion guard is correct.

fn sumf(xs)
    let s = 0.0
    let i = 0
    while i < len(xs)
        s = s + xs[i]
        i = i + 1
    s

fn main()
    // empty -> all floats: the case S2 should accelerate; must stay correct
    let a = []
    push(a, 1.5)
    push(a, 2.5)
    push(a, 4.0)
    assert(a[0] == 1.5, "all-float a[0]")
    assert(a[2] == 4.0, "all-float a[2]")
    assert(sumf(a) == 8.0, "all-float sum via fn param")

    // int THEN float (mixed): must read both correctly, no raw-double misread of the int
    let b = []
    push(b, 5)
    push(b, 1.5)
    assert(b[0] == 5, "mixed b[0] int stays 5")
    assert(b[1] == 1.5, "mixed b[1] float stays 1.5")

    // non-empty int LITERAL list then a float push
    let c = [10, 20, 30]
    push(c, 1.5)
    assert(c[0] == 10, "int-literal c[0] stays 10")
    assert(c[1] == 20, "int-literal c[1] stays 20")
    assert(c[3] == 1.5, "float pushed onto int-literal c[3]")

    // float THEN int
    let d = []
    push(d, 1.5)
    push(d, 7)
    assert(d[0] == 1.5, "float-then-int d[0] float")
    assert(d[1] == 7, "float-then-int d[1] int")

    // pure-int list stays correct (intlist fast path untouched)
    let e = []
    push(e, 100)
    push(e, 200)
    assert(e[0] == 100, "intlist e[0]")
    assert(e[1] == 200, "intlist e[1]")

    print("float_int_mix_test: all passed")
