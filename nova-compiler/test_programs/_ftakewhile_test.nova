// KAT for std/functional/ftakewhile — take_while / drop_while / span
import std/functional/ftakewhile

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckl(label: string, got: list, want: list)
    let gl = len(got)
    let wl = len(want)
    if gl != wl
        print("FAIL " + label + ": len got " + str(gl) + " want " + str(wl))
        exit(1)
    let i = 0
    while i < wl
        if got[i] != want[i]
            print("FAIL " + label + "[" + str(i) + "]: got " + str(got[i]) + " want " + str(want[i]))
            exit(1)
        i = i + 1

fn is_pos(x)
    x > 0

fn lt3(x)
    x < 3

fn is_even(x)
    x % 2 == 0

fn main()
    // --- ftw_take_while ---
    ckl("take_while pos [1,2,-3,4]", ftw_take_while(is_pos, [1, 2, -3, 4]), [1, 2])
    ckl("take_while lt3 [1,2,3,1]", ftw_take_while(lt3, [1, 2, 3, 1]), [1, 2])
    ckl("take_while pos [-1,2]", ftw_take_while(is_pos, [-1, 2]), [])
    ckl("take_while pos [] empty", ftw_take_while(is_pos, []), [])
    ckl("take_while all match", ftw_take_while(is_pos, [1, 2, 3]), [1, 2, 3])
    ckl("take_while single true", ftw_take_while(is_pos, [5]), [5])
    ckl("take_while single false", ftw_take_while(is_pos, [-5]), [])
    ckl("take_while even [2,4,3,6]", ftw_take_while(is_even, [2, 4, 3, 6]), [2, 4])

    // --- ftw_drop_while ---
    ckl("drop_while pos [1,2,-3,4]", ftw_drop_while(is_pos, [1, 2, -3, 4]), [-3, 4])
    ckl("drop_while pos [-1,2]", ftw_drop_while(is_pos, [-1, 2]), [-1, 2])
    ckl("drop_while all match", ftw_drop_while(is_pos, [1, 2, 3]), [])
    ckl("drop_while pos [] empty", ftw_drop_while(is_pos, []), [])
    ckl("drop_while lt3 [1,2,3,1]", ftw_drop_while(lt3, [1, 2, 3, 1]), [3, 1])
    ckl("drop_while single false", ftw_drop_while(is_pos, [-5]), [-5])
    ckl("drop_while single true", ftw_drop_while(is_pos, [5]), [])

    // --- ftw_span ---
    // span returns [[taken], [dropped]]
    let sp1 = ftw_span(is_pos, [1, 2, -3, 4])
    cki("span result len", len(sp1), 2)
    ckl("span taken [1,2,-3,4]", sp1[0], [1, 2])
    ckl("span dropped [1,2,-3,4]", sp1[1], [-3, 4])

    let sp2 = ftw_span(lt3, [1, 2, 3, 1])
    cki("span lt3 result len", len(sp2), 2)
    ckl("span lt3 taken [1,2,3,1]", sp2[0], [1, 2])
    ckl("span lt3 dropped [1,2,3,1]", sp2[1], [3, 1])

    let sp3 = ftw_span(is_pos, [-1, 2])
    ckl("span empty taken [-1,2]", sp3[0], [])
    ckl("span full dropped [-1,2]", sp3[1], [-1, 2])

    let sp4 = ftw_span(is_pos, [])
    ckl("span empty both", sp4[0], [])
    ckl("span empty both dropped", sp4[1], [])

    let sp5 = ftw_span(is_pos, [1, 2, 3])
    ckl("span all taken", sp5[0], [1, 2, 3])
    ckl("span all taken empty dropped", sp5[1], [])

    print("PASS _ftakewhile_test")

main()
