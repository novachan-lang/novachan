// _bytes_builders_test -- bytes_concat + bytes_append (the buffer-building primitives that complete the
// bytes value-type API and unblock gzip/uploads/streaming). Both are binary-safe (length-based, NUL-safe);
// append grows across reallocations (amortized doubling), masks to a byte, and returns the same handle.
fn main()
    // concat: text
    let a = str_to_bytes("hel")
    let b = str_to_bytes("lo")
    let c = bytes_concat(a, b)
    assert(bytes_len(c) == 5, "concat len 5")
    assert(bytes_to_str(c) == "hello", "concat content == hello")

    // concat: embedded NULs (binary-safe, not strlen-joined)
    let x = bytes(2)
    bytes_set(x, 0, 65)
    bytes_set(x, 1, 0)
    let y = bytes(2)
    bytes_set(y, 0, 0)
    bytes_set(y, 1, 66)
    let z = bytes_concat(x, y)
    assert(bytes_len(z) == 4, "concat-with-NULs len 4")
    assert(bytes_get(z, 0) == 65 and bytes_get(z, 1) == 0 and bytes_get(z, 2) == 0 and bytes_get(z, 3) == 66, "concat preserves NULs")
    print("PASS: bytes_concat (text + embedded NULs)")

    // append: build a 300-byte buffer incrementally (forces several reallocations from cap 16)
    let buf = bytes(0)
    let i = 0
    while i < 300
        buf = bytes_append(buf, i)
        i = i + 1
    assert(bytes_len(buf) == 300, "append grew to 300")
    assert(bytes_get(buf, 0) == 0, "buf[0] == 0")
    assert(bytes_get(buf, 255) == 255, "buf[255] == 255")
    assert(bytes_get(buf, 256) == 0, "buf[256] == 256 & 0xFF == 0")
    assert(bytes_get(buf, 299) == 43, "buf[299] == 299 & 0xFF == 43")
    print("PASS: bytes_append (grew across reallocations, byte-masked)")
    print("_bytes_builders_test passed")
