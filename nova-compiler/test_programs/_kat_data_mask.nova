import forge_data_mask

fn main()
    let m1 = dm_mask_email("alice@example.com")
    assert(m1 == "a***@example.com", "email masked")

    let m2 = dm_mask_email("b@x.co")
    assert(m2 == "b***@x.co", "short email")

    let m3 = dm_mask_email("nope")
    assert(m3 == "***", "no @ = fully masked")

    let m4 = dm_mask_phone("555-123-4567")
    assert(m4 == "***-***-4567", "phone masked")

    let m5 = dm_mask_phone("12")
    assert(m5 == "****", "short phone")

    let m6 = dm_mask_card("4111-1111-1111-1234")
    assert(m6 == "****-****-****-1234", "card masked")

    let m7 = dm_mask_card("12")
    assert(m7 == "****", "short card")

    let m8 = dm_mask_string("HelloWorld", 2, 2)
    assert(m8 == "He******ld", "partial mask")

    let m9 = dm_redact("secret")
    assert(m9 == "******", "fully redacted")

    let d = {}
    d["name"] = "Alice"
    d["email"] = "alice@x.com"
    d["age"] = 30
    let masked = dm_mask_dict(d, ["email"])
    assert(masked["name"] == "Alice", "name preserved")
    assert(masked["email"] == "***REDACTED***", "email redacted")
    assert(masked["age"] == 30, "age preserved")

    let m10 = dm_mask_ssn("123-45-6789")
    assert(m10 == "***-**-6789", "ssn masked")

    print("DATA-MASK KAT PASS")
