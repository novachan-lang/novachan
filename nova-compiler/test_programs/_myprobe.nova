import forge_mysql
fn try_login(user: string, pw: string)
    let r = forge_mysql.mysql_connect("127.0.0.1", 3306, user, "", pw)
    if is_ok(r)
        print("  OK  user={user} pw={"(empty)" if len(pw)==0 else pw}")
        forge_mysql.mysql_close(unwrap(r))
    else
        print("  no  user={user} pw={"(empty)" if len(pw)==0 else pw} -> {unwrap_err(r)}")
fn main()
    print("probing local mysqld on 127.0.0.1:3306")
    try_login("root", "root")
    try_login("root", "")
