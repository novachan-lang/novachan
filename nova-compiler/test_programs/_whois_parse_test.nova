// KAT for std/net/whois_parse — WHOIS response parser.
import std/net/whois_parse

// ── Assertion helpers ─────────────────────────────────────────────────────────

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL whois_parse " + label + ": got=[" + got + "] want=[" + want + "]")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL whois_parse " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    let lf = chr(10)
    let cr = chr(13)

    // ── KAT 1: spec-mandated basic vector ────────────────────────────────────
    let t1a = "Domain Name: EXAMPLE.COM" + lf
    let t1b = "Registrar: Test Inc" + lf
    let t1c = "Name Server: NS1.X" + lf
    let t1d = "Name Server: NS2.X" + lf
    let t = t1a + t1b + t1c + t1d

    // whois_field — single-value lookup (case-insensitive key)
    cks("field-registrar",   whois_field(t, "Registrar"),    "Test Inc")
    cks("field-domain",      whois_field(t, "Domain Name"),  "EXAMPLE.COM")
    cks("field-absent",      whois_field(t, "Expiry Date"),  "")

    // whois_all — repeated field collects all values
    let ns = whois_all(t, "Name Server")
    cki("ns-count",  len(ns), 2)
    cks("ns-0",      ns[0],   "NS1.X")
    cks("ns-1",      ns[1],   "NS2.X")

    // ── KAT 2: comment lines ignored ─────────────────────────────────────────
    let t2a = "% This is a comment" + lf
    let t2b = "# Another comment" + lf
    let t2c = "Domain Name: FOO.ORG" + lf
    let t2d = "Registrar: ACME" + lf
    let t2 = t2a + t2b + t2c + t2d

    cks("comment-domain", whois_field(t2, "Domain Name"), "FOO.ORG")
    cks("comment-reg",    whois_field(t2, "Registrar"),   "ACME")

    // whois_all on commented text should not contain comment lines as fields
    let commented_ns = whois_all(t2, "Name Server")
    cki("comment-no-ns", len(commented_ns), 0)

    // ── KAT 3: whois_sections — two-block text returns 2 sections ────────────
    let t3a = "Domain Name: A.COM" + lf
    let t3b = "Registrar: RegA" + lf
    let t3c = lf
    let t3d = "Domain Name: B.COM" + lf
    let t3e = "Registrar: RegB" + lf
    let t3 = t3a + t3b + t3c + t3d + t3e

    let secs = whois_sections(t3)
    cki("sections-count", len(secs), 2)

    // First section should contain "Domain Name: A.COM"
    let sec0 = secs[0]
    let sec1 = secs[1]
    // Just verify each section contains its expected content (not empty)
    cki("sec0-nonempty", len(sec0) > 0, 1)
    cki("sec1-nonempty", len(sec1) > 0, 1)

    // Parse each section independently
    cks("sec0-domain",    whois_field(sec0, "Domain Name"), "A.COM")
    cks("sec0-registrar", whois_field(sec0, "Registrar"),   "RegA")
    cks("sec1-domain",    whois_field(sec1, "Domain Name"), "B.COM")
    cks("sec1-registrar", whois_field(sec1, "Registrar"),   "RegB")

    // ── KAT 4: continuation line folding ─────────────────────────────────────
    let t4a = "Remarks: First line" + lf
    let t4b = "  continuation here" + lf
    let t4c = "Status: active" + lf
    let t4 = t4a + t4b + t4c

    cks("cont-remarks", whois_field(t4, "Remarks"), "First line continuation here")
    cks("cont-status",  whois_field(t4, "Status"),  "active")

    // ── KAT 5: case-insensitive key lookup ───────────────────────────────────
    let t5a = "DOMAIN NAME: UPPER.COM" + lf
    let t5b = "registrar: lower reg" + lf
    let t5 = t5a + t5b

    cks("case-upper",  whois_field(t5, "domain name"), "UPPER.COM")
    cks("case-lower",  whois_field(t5, "REGISTRAR"),   "lower reg")
    cks("case-mixed",  whois_field(t5, "Domain Name"), "UPPER.COM")

    // ── KAT 6: CRLF input normalised ─────────────────────────────────────────
    let t6a = "Domain Name: CRLF.COM" + cr + lf
    let t6b = "Registrar: CRLFReg" + cr + lf
    let t6 = t6a + t6b

    cks("crlf-domain", whois_field(t6, "Domain Name"), "CRLF.COM")
    cks("crlf-reg",    whois_field(t6, "Registrar"),   "CRLFReg")

    // ── KAT 7: repeated field — last value wins in whois_parse dict ──────────
    let t7a = "Status: pendingDelete" + lf
    let t7b = "Status: clientTransferProhibited" + lf
    let t7 = t7a + t7b

    cks("repeat-last", whois_field(t7, "Status"), "clientTransferProhibited")
    let all_status = whois_all(t7, "Status")
    cki("repeat-all-count", len(all_status), 2)
    cks("repeat-all-0",     all_status[0],   "pendingDelete")
    cks("repeat-all-1",     all_status[1],   "clientTransferProhibited")

    // ── KAT 8: empty and malformed input ─────────────────────────────────────
    let tempty = ""
    let dempty = whois_parse(tempty)
    cki("empty-len", len(dempty), 0)
    cks("empty-absent", whois_field(tempty, "Domain Name"), "")

    let tcomment = "% only comments here" + lf + "# nothing else" + lf
    cks("all-comment", whois_field(tcomment, "Domain Name"), "")

    // ── KAT 9: whois_sections with multiple blank lines between sections ──────
    let t9a = "Domain Name: X.COM" + lf
    let t9b = lf
    let t9c = lf
    let t9d = "Registrar: YReg" + lf
    let t9 = t9a + t9b + t9c + t9d

    let secs9 = whois_sections(t9)
    cki("multi-blank-count", len(secs9), 2)
    cks("multi-blank-sec0", whois_field(secs9[0], "Domain Name"), "X.COM")
    cks("multi-blank-sec1", whois_field(secs9[1], "Registrar"),   "YReg")

    // ── KAT 10: colon in value (URL) ─────────────────────────────────────────
    let t10 = "Referral URL: http://www.example-registrar.com" + lf

    cks("url-value", whois_field(t10, "Referral URL"), "http://www.example-registrar.com")

    // ── KAT 11: section count with trailing blank lines ───────────────────────
    let t11 = "A: 1" + lf + lf + "B: 2" + lf + lf

    let secs11 = whois_sections(t11)
    cki("trail-blank-count", len(secs11), 2)

    // ── KAT 12: whois_all on field not present returns empty list ─────────────
    let absent = whois_all(t, "Expiry Date")
    cki("all-absent", len(absent), 0)

    // ── KAT 13: real-world IANA WHOIS fragment ───────────────────────────────
    let tiana_a = "domain:       EXAMPLE" + lf
    let tiana_b = "organisation: Internet Assigned Numbers Authority" + lf
    let tiana_c = "created:      1992-01-01" + lf
    let tiana_d = "source:       IANA" + lf
    let tiana = tiana_a + tiana_b + tiana_c + tiana_d

    cks("iana-domain",  whois_field(tiana, "domain"),       "EXAMPLE")
    cks("iana-org",     whois_field(tiana, "organisation"), "Internet Assigned Numbers Authority")
    cks("iana-created", whois_field(tiana, "created"),      "1992-01-01")
    cks("iana-source",  whois_field(tiana, "source"),       "IANA")

    print("PASS _whois_parse_test")
