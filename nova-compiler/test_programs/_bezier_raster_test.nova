import std/raster/bezier_raster

// _ck_i: check integer equality; exit(1) on mismatch.
fn _ck_i(label, got, want)
    if got != want
        print("FAIL bezier_raster " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// _ck_pt2: check that a 2-element point list equals [ex,ey].
fn _ck_pt2(label, got, ex, ey)
    if len(got) != 2
        print("FAIL bezier_raster " + label + ": len=" + str(len(got)) + " want 2")
        exit(1)
    if got[0] != ex
        print("FAIL bezier_raster " + label + "[x]: got=" + str(got[0]) + " want=" + str(ex))
        exit(1)
    if got[1] != ey
        print("FAIL bezier_raster " + label + "[y]: got=" + str(got[1]) + " want=" + str(ey))
        exit(1)

fn main()
    // --- bz_point_quad: exact rational evaluation ---
    // t=0.5: B(0.5) = 0.25*[0,0] + 0.5*[2,4] + 0.25*[4,0] = [2, 2]
    let p_half = bz_point_quad(0, 0, 2, 4, 4, 0, 1, 2)
    _ck_pt2("quad_t_half", p_half, 2, 2)

    // t=0 -> start point [0,0]
    let p_t0 = bz_point_quad(0, 0, 5, 5, 10, 0, 0, 1)
    _ck_pt2("quad_t0", p_t0, 0, 0)

    // t=1 -> end point [10,0]
    let p_t1 = bz_point_quad(0, 0, 5, 5, 10, 0, 1, 1)
    _ck_pt2("quad_t1", p_t1, 10, 0)

    // t=1/4: B(0.25) = 0.5625*[0,0] + 0.375*[2,4] + 0.0625*[4,0]
    //                 = [0+0.75+0.25, 0+1.5+0] = [1, 1.5] -> rounds to [1,2]
    let p_t14 = bz_point_quad(0, 0, 2, 4, 4, 0, 1, 4)
    _ck_pt2("quad_t1_4", p_t14, 1, 2)

    // --- bz_quadratic: endpoints and midpoint ---
    // steps=2 -> t in {0, 1/2, 1}: points [0,0],[2,2],[4,0]
    let q2 = bz_quadratic(0, 0, 2, 4, 4, 0, 2)
    // First point must be [0,0]
    _ck_pt2("q2_start", q2[0], 0, 0)
    // Last point must be [4,0]
    _ck_pt2("q2_end", q2[len(q2) - 1], 4, 0)
    // Should have 3 distinct points (no consecutive dedup needed here)
    _ck_i("q2_count", len(q2), 3)
    // Mid is [2,2]
    _ck_pt2("q2_mid", q2[1], 2, 2)

    // steps=1 -> t in {0,1}: points [0,0],[4,0]  (2 points after dedup)
    let q1 = bz_quadratic(0, 0, 2, 4, 4, 0, 1)
    _ck_pt2("q1_start", q1[0], 0, 0)
    _ck_pt2("q1_end", q1[len(q1) - 1], 4, 0)

    // Degenerate: flat bezier (all collinear) steps=4 -> [0,0],[1,0],[2,0],[3,0],[4,0]
    let qflat = bz_quadratic(0, 0, 2, 0, 4, 0, 4)
    _ck_pt2("qflat_start", qflat[0], 0, 0)
    _ck_pt2("qflat_end", qflat[len(qflat) - 1], 4, 0)

    // --- bz_cubic: collinear control points -> straight line ---
    // bz_cubic(0,0,0,0,4,0,4,0, 4): P0=(0,0), P1=(0,0), P2=(4,0), P3=(4,0)
    // B(t)_x = (1-t)^3*0 + 3t(1-t)^2*0 + 3t^2(1-t)*4 + t^3*4
    //        = 4*[3t^2-3t^3 + t^3] = 4*(3t^2-2t^3) -> cubic S-curve
    // steps=4: t=0,1/4,1/2,3/4,1
    //   t=0:   [0,0]
    //   t=1/4: x=4*(3/16-2/64)=4*(12/64-2/64)=4*(10/64)=40/64~0.625->1
    //   t=1/2: x=4*(3/4-2/8)=4*(6/8-2/8)=4*(4/8)=2
    //   t=3/4: x=4*(27/16-54/64)=... ~3
    //   t=1:   [4,0]
    let c4 = bz_cubic(0, 0, 0, 0, 4, 0, 4, 0, 4)
    _ck_pt2("c4_start", c4[0], 0, 0)
    _ck_pt2("c4_end", c4[len(c4) - 1], 4, 0)
    // Mid at t=1/2: x=4*(3/4-1/4)=4*1/2=2 ... Wait:
    // 3t^2(1-t)*4 + t^3*4 at t=0.5: 3*0.25*0.5*4 + 0.125*4 = 1.5 + 0.5 = 2
    // y stays 0 throughout
    _ck_pt2("c4_mid", c4[2], 2, 0)

    // Straight cubic (all control on same line)
    let cstraight = bz_cubic(0, 0, 2, 0, 4, 0, 6, 0, 6)
    _ck_pt2("cstraight_start", cstraight[0], 0, 0)
    _ck_pt2("cstraight_end", cstraight[len(cstraight) - 1], 6, 0)

    // --- bz_line_length_estimate ---
    // [0,0] -> [3,4]: length = sqrt(9+16) = sqrt(25) = 5
    let pts_a = []
    let pt0a = []
    push(pt0a, 0)
    push(pt0a, 0)
    push(pts_a, pt0a)
    let pt1a = []
    push(pt1a, 3)
    push(pt1a, 4)
    push(pts_a, pt1a)
    _ck_i("len_3_4", bz_line_length_estimate(pts_a), 5)

    // [0,0] -> [0,0]: empty polyline (1 point)
    let pts_b = []
    let pt0b = []
    push(pt0b, 0)
    push(pt0b, 0)
    push(pts_b, pt0b)
    _ck_i("len_single", bz_line_length_estimate(pts_b), 0)

    // Two segments: [0,0]->[4,0]->[4,3] -> 4 + 3 = 7
    let pts_c = []
    let pc0 = []
    push(pc0, 0)
    push(pc0, 0)
    push(pts_c, pc0)
    let pc1 = []
    push(pc1, 4)
    push(pc1, 0)
    push(pts_c, pc1)
    let pc2 = []
    push(pc2, 4)
    push(pc2, 3)
    push(pts_c, pc2)
    _ck_i("len_two_segs", bz_line_length_estimate(pts_c), 7)

    // --- bz_flatten_quad ---
    // tol=0: very fine subdivision, endpoints must still be [0,0] and [4,0]
    let fq = bz_flatten_quad(0, 0, 2, 4, 4, 0, 1)
    _ck_pt2("flat_start", fq[0], 0, 0)
    _ck_pt2("flat_end", fq[len(fq) - 1], 4, 0)
    // At tol=1000: single straight segment (no subdivision needed)
    let fq_big = bz_flatten_quad(0, 0, 2, 4, 4, 0, 1000)
    _ck_pt2("flat_big_start", fq_big[0], 0, 0)
    _ck_pt2("flat_big_end", fq_big[len(fq_big) - 1], 4, 0)
    // Large tol = straight line -> 2 points
    _ck_i("flat_big_count", len(fq_big), 2)

    // --- bz_endpoints ---
    let ep = bz_endpoints(q2)
    _ck_i("ep_len", len(ep), 4)
    _ck_i("ep_x0", ep[0], 0)
    _ck_i("ep_y0", ep[1], 0)
    _ck_i("ep_x1", ep[2], 4)
    _ck_i("ep_y1", ep[3], 0)

    // --- bz_dedup_consec ---
    let dpts = []
    let d0 = []
    push(d0, 1)
    push(d0, 1)
    push(dpts, d0)
    let d1 = []
    push(d1, 1)
    push(d1, 1)
    push(dpts, d1)
    let d2 = []
    push(d2, 2)
    push(d2, 3)
    push(dpts, d2)
    let dd = bz_dedup_consec(dpts)
    _ck_i("dedup_count", len(dd), 2)
    _ck_pt2("dedup_0", dd[0], 1, 1)
    _ck_pt2("dedup_1", dd[1], 2, 3)

    print("PASS _bezier_raster_test")
