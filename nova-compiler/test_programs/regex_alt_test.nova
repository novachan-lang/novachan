// Regex alternation (|) — exhaustive. regex_match is unanchored (matches anywhere
// unless the pattern is ^-anchored); regex_find returns the first match substring.

fn main()
    // ── simple two-way ──
    assert_eq(regex_match("cat", "cat|dog"), 1)
    assert_eq(regex_match("dog", "cat|dog"), 1)
    assert_eq(regex_match("bird", "cat|dog"), 0)

    // ── three-way (a|b|c) ──
    assert_eq(regex_match("cat", "cat|dog|bird"), 1)
    assert_eq(regex_match("dog", "cat|dog|bird"), 1)
    assert_eq(regex_match("bird", "cat|dog|bird"), 1)
    assert_eq(regex_match("fish", "cat|dog|bird"), 0)

    // ── unanchored: matches anywhere ──
    assert_eq(regex_match("I have a cat", "cat|dog"), 1)
    assert_eq(regex_match("hotdog stand", "cat|dog"), 1)   // dog inside hotdog
    assert_eq(regex_match("a fish here", "cat|dog"), 0)

    // ── grouped alternation (cat|dog)s ──
    assert_eq(regex_match("cats", "(cat|dog)s"), 1)
    assert_eq(regex_match("dogs", "(cat|dog)s"), 1)
    assert_eq(regex_match("cat", "(cat|dog)s"), 0)         // missing trailing s
    assert_eq(regex_match("birds", "(cat|dog)s"), 0)

    // ── alternation of a single inner letter: h(a|e)llo ──
    assert_eq(regex_match("hello", "h(a|e)llo"), 1)
    assert_eq(regex_match("hallo", "h(a|e)llo"), 1)
    assert_eq(regex_match("hillo", "h(a|e)llo"), 0)

    // ── alternation with classes + quantifiers ──
    assert_eq(regex_match("123", "[0-9]+|[a-z]+"), 1)
    assert_eq(regex_match("abc", "[0-9]+|[a-z]+"), 1)
    assert_eq(regex_match("...", "[0-9]+|[a-z]+"), 0)
    assert_eq(regex_match("ab12", "[0-9]+|[a-z]+"), 1)

    // ── alternation with quantified left branch: ab*|cd ──
    assert_eq(regex_match("a", "ab*|cd"), 1)               // a + zero b
    assert_eq(regex_match("abbb", "ab*|cd"), 1)
    assert_eq(regex_match("cd", "ab*|cd"), 1)
    assert_eq(regex_match("ce", "ab*|cd"), 0)

    // ── anchored alternation: ^hello|^world ──
    assert_eq(regex_match("hello there", "^hello|^world"), 1)
    assert_eq(regex_match("world peace", "^hello|^world"), 1)
    assert_eq(regex_match("say hello", "^hello|^world"), 0) // neither at start

    // ── nested alternation: (a|b)|c ──
    assert_eq(regex_match("a", "(a|b)|c"), 1)
    assert_eq(regex_match("b", "(a|b)|c"), 1)
    assert_eq(regex_match("c", "(a|b)|c"), 1)
    assert_eq(regex_match("d", "(a|b)|c"), 0)

    // ── empty alternative: "a|" matches anything (empty branch) ──
    assert_eq(regex_match("xyz", "a|"), 1)

    // ── regex_find with alternation ──
    assert_eq(regex_find("the dog ran", "cat|dog"), "dog")
    assert_eq(regex_find("the cat ran", "cat|dog"), "cat")
    assert_eq(regex_find("xyz123", "[0-9]+|[a-z]+"), "xyz")  // earliest-position wins
    assert_eq(regex_find("99 bottles", "[0-9]+|[a-z]+"), "99")
    assert_eq(regex_find("no match", "cat|dog"), "")

    // ── ordering: first-listed alternative preferred at a given start ──
    assert_eq(regex_find("abcd", "ab|abcd"), "ab")

    // ── must not break plain patterns (no |) ──
    assert_eq(regex_match("hello", "hello"), 1)
    assert_eq(regex_match("abc123", "[0-9]+"), 1)
    assert_eq(regex_find("a 42 b", "[0-9]+"), "42")

    print("regex_alt_test passed")
