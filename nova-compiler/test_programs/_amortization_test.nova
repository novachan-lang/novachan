// KAT for std/finance/amortization — loan amortization functions.
// All expected values computed by hand using standard annuity formulas.
// Epsilon: 0.01 for money amounts, 0.0001 for rates.
import std/finance/amortization

// ckf: check float within epsilon
fn ckf(label: string, got: float, want: float, eps: float)
    let diff = got - want
    if diff < 0.0
        diff = 0.0 - diff
    if diff > eps
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want) + " diff=" + str(diff))
        exit(1)

fn main()
    // KAT 1: amt_payment — classic 10k@0.5%/mo for 60 months -> 193.33
    // Formula: 10000*0.005*(1.005)^60 / ((1.005)^60 - 1)
    // (1.005)^60 = 1.348850... payment = 67.4425/0.348850 = 193.328...
    let p = amt_payment(10000.0, 0.005, 60)
    ckf("payment", p, 193.33, 0.01)

    // KAT 2: schedule length == n
    let s = amt_schedule(10000.0, 0.005, 60)
    if len(s) != 60
        print("FAIL schedule_len: got=" + str(len(s)) + " want=60")
        exit(1)

    // KAT 3: first row interest = principal * rate = 10000 * 0.005 = 50.0
    let row0 = s[0]
    ckf("first_interest", row0[1] * 1.0, 50.0, 0.01)

    // KAT 4: final row balance is ~0 (should be <= 0.05 due to rounding)
    let row59 = s[59]
    let final_balance = row59[3] * 1.0
    ckf("final_balance", final_balance, 0.0, 0.05)

    // KAT 5: total interest = total_paid - principal
    // 193.3284 * 60 - 10000 = 11599.70 - 10000 = 1599.70 (within 0.5 of 1599.68)
    let ti = amt_total_interest(10000.0, 0.005, 60)
    ckf("total_interest", ti, 1599.68, 0.5)

    // KAT 6: balance after 0 payments == principal (exact)
    let b0 = amt_balance_after(10000.0, 0.005, 60, 0)
    ckf("balance_after_0", b0, 10000.0, 0.01)

    // KAT 7: balance after all 60 payments == ~0
    let b60 = amt_balance_after(10000.0, 0.005, 60, 60)
    ckf("balance_after_60", b60, 0.0, 0.05)

    // KAT 8: zero-interest loan: payment = principal/n exactly
    let p0 = amt_payment(1200.0, 0.0, 12)
    ckf("zero_rate_payment", p0, 100.0, 0.01)

    print("_amortization_test passed")
