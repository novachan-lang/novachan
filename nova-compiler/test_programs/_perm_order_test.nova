import std/permutation/perm_order

// cki — check integer equality
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _perm_order_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb — check bool equality
fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL _perm_order_test " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn main()
    // --- po_order ---
    // [1,2,0,4,3]: cycles (0,1,2) len=3, (3,4) len=2 -> LCM(3,2)=6
    cki("order_120_43", po_order([1, 2, 0, 4, 3]), 6)

    // [1,0,2]: cycles (0,1) len=2, (2) len=1 -> LCM(2,1)=2
    cki("order_102", po_order([1, 0, 2]), 2)

    // [0,1,2]: three fixed points -> LCM(1,1,1)=1
    cki("order_identity", po_order([0, 1, 2]), 1)

    // [1,2,0]: single 3-cycle -> LCM(3)=3
    cki("order_3cycle", po_order([1, 2, 0]), 3)

    // [1,2,3,0]: single 4-cycle -> LCM(4)=4
    cki("order_4cycle", po_order([1, 2, 3, 0]), 4)

    // empty permutation -> 1 (identity)
    cki("order_empty", po_order([]), 1)

    // single-element identity -> 1
    cki("order_single", po_order([0]), 1)

    // transposition [1,0] -> 2-cycle -> order=2
    cki("order_transpos", po_order([1, 0]), 2)

    // [2,0,1,5,3,4]: cycles (0,2,1) len=3, (3,5,4) len=3 -> LCM(3,3)=3
    cki("order_two3cycles", po_order([2, 0, 1, 5, 3, 4]), 3)

    // [1,2,3,4,5,0]: one 6-cycle -> order=6
    cki("order_6cycle", po_order([1, 2, 3, 4, 5, 0]), 6)

    // [2,3,0,1]: cycles (0,2)(1,3) both len=2 -> LCM(2,2)=2
    cki("order_two2cycles", po_order([2, 3, 0, 1]), 2)

    // --- po_is_order ---
    ckb("is_order_6", po_is_order([1, 2, 0, 4, 3], 6), true)
    ckb("is_order_not5", po_is_order([1, 2, 0, 4, 3], 5), false)
    ckb("is_order_identity1", po_is_order([0, 1, 2], 1), true)
    ckb("is_order_identity_not2", po_is_order([0, 1, 2], 2), false)
    ckb("is_order_3cycle_3", po_is_order([1, 2, 0], 3), true)
    ckb("is_order_4cycle_4", po_is_order([1, 2, 3, 0], 4), true)
    ckb("is_order_4cycle_not2", po_is_order([1, 2, 3, 0], 2), false)

    // --- po_power_order ---
    // order([1,2,3,0])=4; po_power_order(p,2)=4/gcd(4,2)=4/2=2
    cki("power_order_4_2", po_power_order([1, 2, 3, 0], 2), 2)

    // order=4, k=1: 4/gcd(4,1)=4/1=4
    cki("power_order_4_1", po_power_order([1, 2, 3, 0], 1), 4)

    // order=4, k=4: 4/gcd(4,4)=4/4=1 (p^4=identity -> order 1)
    cki("power_order_4_4", po_power_order([1, 2, 3, 0], 4), 1)

    // order=6, k=2: 6/gcd(6,2)=6/2=3
    cki("power_order_6_2", po_power_order([1, 2, 0, 4, 3], 2), 3)

    // order=6, k=3: 6/gcd(6,3)=6/3=2
    cki("power_order_6_3", po_power_order([1, 2, 0, 4, 3], 3), 2)

    // order=3, k=2: 3/gcd(3,2)=3/1=3
    cki("power_order_3_2", po_power_order([1, 2, 0], 2), 3)

    // identity, k=anything: order=1, power_order=1
    cki("power_order_id_5", po_power_order([0, 1, 2], 5), 1)

    print("PASS _perm_order_test")
