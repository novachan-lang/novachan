import forge_dynamodb

fn main()
    // Host construction
    let host = dynamodb_host("us-east-1")
    assert(host == "dynamodb.us-east-1.amazonaws.com", "host format")

    // Build a signed request
    let body = "{\"TableName\":\"Users\",\"Key\":{\"id\":{\"S\":\"user1\"}}}"
    let req = dynamodb_get_item("AKID", "secret", "us-east-1", body, "20260101T000000Z", "20260101")
    assert(req["method"] == "POST", "method is POST")
    assert(find(req["url"], "dynamodb.us-east-1.amazonaws.com") >= 0, "url has host")
    assert(req["x-amz-target"] == "DynamoDB_20120810.GetItem", "target GetItem")
    assert(req["content-type"] == "application/x-amz-json-1.0", "content type")
    assert(find(req["authorization"], "AWS4-HMAC-SHA256") >= 0, "sigv4 auth")
    assert(req["x-amz-date"] == "20260101T000000Z", "amz date")

    // PutItem
    let put_body = "{\"TableName\":\"Users\",\"Item\":{\"id\":{\"S\":\"u2\"},\"name\":{\"S\":\"Bob\"}}}"
    let pr = dynamodb_put_item("AKID", "secret", "us-east-1", put_body, "20260101T000000Z", "20260101")
    assert(pr["x-amz-target"] == "DynamoDB_20120810.PutItem", "target PutItem")

    // Query
    let qr = dynamodb_query("AKID", "secret", "us-east-1", body, "20260101T000000Z", "20260101")
    assert(qr["x-amz-target"] == "DynamoDB_20120810.Query", "target Query")

    print("DYNAMODB KAT PASS")
