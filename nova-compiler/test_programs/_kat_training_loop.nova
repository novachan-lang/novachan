import forge_training_loop

fn main()
    let s = tl_new(3)
    assert(tl_current_epoch(s) == 0, "epoch 0 at start")
    assert(tl_total_epochs(s) == 0, "0 completed")
    assert(tl_is_complete(s) == 0, "not complete")

    let bl0 = tl_best_loss(s)
    assert(is_err(bl0), "no best loss yet")
    let imp0 = tl_is_improving(s)
    assert(is_err(imp0), "not enough epochs yet")

    let endtoosoon = tl_end_epoch(s, 100)
    assert(is_err(endtoosoon), "cannot end before start")

    let se1 = tl_start_epoch(s)
    assert(is_ok(se1), "start epoch 1 ok")
    s = unwrap(se1)
    assert(tl_current_epoch(s) == 1, "current epoch 1")

    let dbl_start = tl_start_epoch(s)
    assert(is_err(dbl_start), "cannot double-start")

    let ee1 = tl_end_epoch(s, 100)
    assert(is_ok(ee1), "end epoch 1 ok")
    s = unwrap(ee1)
    assert(tl_total_epochs(s) == 1, "1 completed")

    let bl1 = tl_best_loss(s)
    assert(is_ok(bl1), "best loss ok")
    assert(unwrap(bl1) == 100, "best loss 100")
    let be1 = tl_best_epoch(s)
    assert(unwrap(be1) == 1, "best epoch 1")

    s = unwrap(tl_start_epoch(s))
    s = unwrap(tl_end_epoch(s, 80))
    assert(tl_total_epochs(s) == 2, "2 completed")
    let bl2 = tl_best_loss(s)
    assert(unwrap(bl2) == 80, "best loss now 80")
    let be2 = tl_best_epoch(s)
    assert(unwrap(be2) == 2, "best epoch now 2")

    let imp1 = tl_is_improving(s)
    assert(is_ok(imp1), "improving check ok")
    assert(unwrap(imp1) == 1, "loss improved (80 < 100)")

    s = unwrap(tl_start_epoch(s))
    s = unwrap(tl_end_epoch(s, 90))
    assert(tl_total_epochs(s) == 3, "3 completed")
    let bl3 = tl_best_loss(s)
    assert(unwrap(bl3) == 80, "best loss still 80")
    let be3 = tl_best_epoch(s)
    assert(unwrap(be3) == 2, "best epoch still 2")

    let imp2 = tl_is_improving(s)
    assert(unwrap(imp2) == 0, "loss worsened (90 > 80)")

    assert(tl_is_complete(s) == 1, "now complete")
    let overbudget = tl_start_epoch(s)
    assert(is_err(overbudget), "cannot start beyond budget")

    let la1 = tl_loss_at(s, 1)
    assert(is_ok(la1), "loss at 1 ok")
    assert(unwrap(la1) == 100, "loss at epoch 1 is 100")
    let la2 = tl_loss_at(s, 2)
    assert(unwrap(la2) == 80, "loss at epoch 2 is 80")
    let labad = tl_loss_at(s, 99)
    assert(is_err(labad), "loss at unknown epoch errs")

    print("TRAINING-LOOP KAT PASS")
