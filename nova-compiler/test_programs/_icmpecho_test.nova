import std/net/icmpecho

fn main()
    // ── Vector 1: byte-exact encode of a known ICMP echo request ─────────────
    // icmp_echo_encode(8, 0x1234, 1, str_to_bytes("abc"))
    // Header (checksum zeroed): 08 00 00 00 12 34 00 01  payload: 61 62 63
    // Checksum over 11 bytes: 0x2168  =>  byte[2]=0x21, byte[3]=0x68
    // Full wire: 08 00 21 68 12 34 00 01 61 62 63
    let payload = str_to_bytes("abc")
    let enc1 = icmp_echo_encode(8, 0x1234, 1, payload)

    // Length must be exactly 11 (8-byte header + 3-byte payload)
    let got_len = bytes_len(enc1)
    if got_len != 11
        print("FAIL icmpecho encode-len: got "+str(got_len)+" want 11")
        exit(1)

    // byte[0] == 0x08 (type = echo request)
    let got_b0 = bytes_get(enc1, 0)
    if got_b0 != 8
        print("FAIL icmpecho byte[0] type: got "+str(got_b0)+" want 8")
        exit(1)

    // byte[1] == 0x00 (code = 0)
    let got_b1 = bytes_get(enc1, 1)
    if got_b1 != 0
        print("FAIL icmpecho byte[1] code: got "+str(got_b1)+" want 0")
        exit(1)

    // u16@[2..3] == 0x2168 (checksum)
    let got_cks_hi = bytes_get(enc1, 2)
    let got_cks_lo = bytes_get(enc1, 3)
    let got_cks = (got_cks_hi << 8) | got_cks_lo
    if got_cks != 0x2168
        print("FAIL icmpecho checksum: got "+str(got_cks)+" want 8552")
        exit(1)

    // u16@[4..5] == 0x1234 (id)
    let got_id_hi = bytes_get(enc1, 4)
    let got_id_lo = bytes_get(enc1, 5)
    let got_id = (got_id_hi << 8) | got_id_lo
    if got_id != 0x1234
        print("FAIL icmpecho id: got "+str(got_id)+" want 4660")
        exit(1)

    // u16@[6..7] == 0x0001 (seq)
    let got_seq_hi = bytes_get(enc1, 6)
    let got_seq_lo = bytes_get(enc1, 7)
    let got_seq = (got_seq_hi << 8) | got_seq_lo
    if got_seq != 1
        print("FAIL icmpecho seq: got "+str(got_seq)+" want 1")
        exit(1)

    // payload bytes at 8..10 must be 0x61 0x62 0x63 ('a','b','c')
    let got_pa = bytes_get(enc1, 8)
    if got_pa != 0x61
        print("FAIL icmpecho payload[0]: got "+str(got_pa)+" want 97")
        exit(1)
    let got_pb = bytes_get(enc1, 9)
    if got_pb != 0x62
        print("FAIL icmpecho payload[1]: got "+str(got_pb)+" want 98")
        exit(1)
    let got_pc = bytes_get(enc1, 10)
    if got_pc != 0x63
        print("FAIL icmpecho payload[2]: got "+str(got_pc)+" want 99")
        exit(1)

    // ── Vector 2: checksum validity — inet_checksum over whole message == 0 ──
    // After embedding the checksum, summing all words must yield 0xFFFF,
    // so inet_checksum (which returns ~sum & 0xFFFF) must return 0x0000.
    // We compute this inline using the same RFC 1071 algorithm.
    let acc = 0
    let ci = 0
    let cn = bytes_len(enc1)
    while ci + 1 < cn
        acc = acc + ((bytes_get(enc1, ci) << 8) | bytes_get(enc1, ci + 1))
        ci = ci + 2
    if ci < cn
        acc = acc + (bytes_get(enc1, ci) << 8)
    while (acc >> 16) != 0
        acc = (acc & 0xFFFF) + ((acc >> 16) & 0xFFFF)
    let verify_result = (~acc) & 0xFFFF
    if verify_result != 0
        print("FAIL icmpecho checksum-verify: got "+str(verify_result)+" want 0")
        exit(1)

    // ── Vector 3: encode -> decode round-trip ─────────────────────────────────
    let dec1 = icmp_echo_decode(enc1)

    if contains(dec1, "type") == 0
        print("FAIL icmpecho decode: missing type key")
        exit(1)

    let got_type = dec1["type"]
    if got_type != 8
        print("FAIL icmpecho decode type: got "+str(got_type)+" want 8")
        exit(1)

    let got_code = dec1["code"]
    if got_code != 0
        print("FAIL icmpecho decode code: got "+str(got_code)+" want 0")
        exit(1)

    let got_dec_id = dec1["id"]
    if got_dec_id != 0x1234
        print("FAIL icmpecho decode id: got "+str(got_dec_id)+" want 4660")
        exit(1)

    let got_dec_seq = dec1["seq"]
    if got_dec_seq != 1
        print("FAIL icmpecho decode seq: got "+str(got_dec_seq)+" want 1")
        exit(1)

    let got_payload = dec1["payload"]
    let got_payload_len = bytes_len(got_payload)
    if got_payload_len != 3
        print("FAIL icmpecho decode payload-len: got "+str(got_payload_len)+" want 3")
        exit(1)
    let got_pba = bytes_get(got_payload, 0)
    if got_pba != 0x61
        print("FAIL icmpecho decode payload[0]: got "+str(got_pba)+" want 97")
        exit(1)
    let got_pbb = bytes_get(got_payload, 1)
    if got_pbb != 0x62
        print("FAIL icmpecho decode payload[1]: got "+str(got_pbb)+" want 98")
        exit(1)
    let got_pbc = bytes_get(got_payload, 2)
    if got_pbc != 0x63
        print("FAIL icmpecho decode payload[2]: got "+str(got_pbc)+" want 99")
        exit(1)

    // ── Vector 4: echo reply encode/decode ───────────────────────────────────
    let rep = icmp_echo_encode(0, 0x1234, 1, str_to_bytes("abc"))
    let got_rep_type = bytes_get(rep, 0)
    if got_rep_type != 0
        print("FAIL icmpecho reply type: got "+str(got_rep_type)+" want 0")
        exit(1)
    let dec_rep = icmp_echo_decode(rep)
    let got_rep_dec_type = dec_rep["type"]
    if got_rep_dec_type != 0
        print("FAIL icmpecho reply decode type: got "+str(got_rep_dec_type)+" want 0")
        exit(1)

    // ── Vector 5: empty payload ────────────────────────────────────────────────
    let enc_empty = icmp_echo_encode(8, 0x0001, 0, bytes(0))
    let got_empty_len = bytes_len(enc_empty)
    if got_empty_len != 8
        print("FAIL icmpecho empty payload len: got "+str(got_empty_len)+" want 8")
        exit(1)
    let dec_empty = icmp_echo_decode(enc_empty)
    let got_empty_payload_len = bytes_len(dec_empty["payload"])
    if got_empty_payload_len != 0
        print("FAIL icmpecho empty payload decode len: got "+str(got_empty_payload_len)+" want 0")
        exit(1)

    // ── Vector 6: short input decode returns empty dict ───────────────────────
    let short_b = bytes(4)
    let dec_short = icmp_echo_decode(short_b)
    if contains(dec_short, "type")
        print("FAIL icmpecho short-decode: expected empty dict but got type key")
        exit(1)

    // ── Vector 7: zero-length input returns empty dict ────────────────────────
    let zero_b = bytes(0)
    let dec_zero = icmp_echo_decode(zero_b)
    if contains(dec_zero, "id")
        print("FAIL icmpecho zero-decode: expected empty dict but got id key")
        exit(1)

    // ── Vector 8: checksum stored in decode matches the u16 in wire bytes ─────
    let got_stored_cks = dec1["checksum"]
    if got_stored_cks != 0x2168
        print("FAIL icmpecho decode checksum field: got "+str(got_stored_cks)+" want 8552")
        exit(1)

    print("PASS _icmpecho_test")
