// jsonunicode_test — json_decode now decodes \uXXXX escapes (and UTF-16 surrogate
// pairs) to proper UTF-8, instead of collapsing each to '?'. Real data-corruption fix.

fn main()
    let q = chr(34)
    let bs = chr(92)

    // A -> "A"
    assert_eq(json_decode(q + bs + "u0041" + q), "A")

    // é -> é (1 codepoint, 2 UTF-8 bytes)
    let e = json_decode(q + bs + "u00e9" + q)
    assert_eq(char_count(e), 1)
    assert_eq(len(e), 2)

    // "café" -> café
    let cafe = json_decode(q + "caf" + bs + "u00e9" + q)
    assert_eq(char_count(cafe), 4)
    assert_eq(cafe, "café")

    // € -> € (3 UTF-8 bytes)
    let euro = json_decode(q + bs + "u20ac" + q)
    assert_eq(len(euro), 3)
    assert_eq(char_count(euro), 1)

    // surrogate pair 😀 -> U+1F600 (4 UTF-8 bytes, 1 codepoint)
    let emoji = json_decode(q + bs + "uD83D" + bs + "uDE00" + q)
    assert_eq(len(emoji), 4)
    assert_eq(char_count(emoji), 1)

    print("jsonunicode_test passed")
