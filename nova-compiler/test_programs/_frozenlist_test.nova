import std/collections/frozenlist

fn cki(label, got, expected)
    if got == expected
        return 0
    print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
    exit(1)

fn cks(label, got, expected)
    if got == expected
        return 0
    print("FAIL " + label + ": got " + got + " expected " + expected)
    exit(1)

fn main()
    // Build the primary frozenlist
    let f = fl_of([1, 2, 3])

    // KAT 1: length
    cki("fl_len", fl_len(f), 3)

    // KAT 2: element access
    cki("fl_get_0", fl_get(f, 0), 1)
    cki("fl_get_1", fl_get(f, 1), 2)
    cki("fl_get_2", fl_get(f, 2), 3)

    // KAT 3: contains present
    cki("fl_contains_2", fl_contains(f, 2), 1)

    // KAT 4: contains absent
    cki("fl_contains_9", fl_contains(f, 9), 0)

    // KAT 5: index_of found
    cki("fl_index_of_3", fl_index_of(f, 3), 2)

    // KAT 6: index_of absent
    cki("fl_index_of_9", fl_index_of(f, 9), -1)

    // KAT 7: to_list returns a copy with correct values
    let lst = fl_to_list(f)
    cki("fl_to_list_len", len(lst), 3)
    cki("fl_to_list_0", lst[0], 1)
    cki("fl_to_list_1", lst[1], 2)
    cki("fl_to_list_2", lst[2], 3)

    // KAT 8: map doubles each element
    let mapped = fl_map(f, fn(x) x * 2)
    cki("fl_map_len", fl_len(mapped), 3)
    let ml = fl_to_list(mapped)
    cki("fl_map_0", ml[0], 2)
    cki("fl_map_1", ml[1], 4)
    cki("fl_map_2", ml[2], 6)

    // KAT 9: filter keeps elements > 1
    let filtered = fl_filter(f, fn(x) x > 1)
    cki("fl_filter_len", fl_len(filtered), 2)
    let fl2 = fl_to_list(filtered)
    cki("fl_filter_0", fl2[0], 2)
    cki("fl_filter_1", fl2[1], 3)

    // KAT 10: concat two single-element frozenlists
    let c = fl_concat(fl_of([1]), fl_of([2]))
    cki("fl_concat_len", fl_len(c), 2)
    let cl = fl_to_list(c)
    cki("fl_concat_0", cl[0], 1)
    cki("fl_concat_1", cl[1], 2)

    // KAT 11: original f is unchanged after map/filter (immutability check)
    cki("immutable_len", fl_len(f), 3)
    let orig = fl_to_list(f)
    cki("immutable_0", orig[0], 1)
    cki("immutable_1", orig[1], 2)
    cki("immutable_2", orig[2], 3)

    // KAT 12: fl_of does not alias the input list (mutating input must not affect frozenlist)
    let src = [10, 20, 30]
    let frozen_src = fl_of(src)
    src.push(40)
    cki("no_alias_len", fl_len(frozen_src), 3)

    print("_frozenlist_test passed")
