import std/game2d/raycast2d

// approx: float equality within tolerance.
fn approx(a, b, tol)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < tol

// approx_vec2: check two-element float list within tolerance.
fn approx_vec2(v, ex, ey, tol)
    let ax = v[0]
    let ay = v[1]
    let dx = ax - ex
    let dy = ay - ey
    if dx < 0.0
        dx = 0.0 - dx
    if dy < 0.0
        dy = 0.0 - dy
    return dx < tol and dy < tol

fn main()
    let TOL = 0.0001

    // ── KAT 1: rc2_normalize(3,4) == [0.6, 0.8] ──────────────────────────────
    let norm1 = rc2_normalize(3, 4)
    let ok1 = approx_vec2(norm1, 0.6, 0.8, TOL)
    if ok1 != true
        print("FAIL raycast2d rc2_normalize(3,4): got=[" + str(norm1[0]) + "," + str(norm1[1]) + "] want=[0.6,0.8]")
        exit(1)

    // ── KAT 2: rc2_normalize(0,0) == [0.0,0.0] (degenerate) ─────────────────
    let norm2 = rc2_normalize(0, 0)
    let ok2 = approx_vec2(norm2, 0.0, 0.0, TOL)
    if ok2 != true
        print("FAIL raycast2d rc2_normalize(0,0): got=[" + str(norm2[0]) + "," + str(norm2[1]) + "]")
        exit(1)

    // ── KAT 3: rc2_point_at(0,0, 1,0, 5) == [5,0] ───────────────────────────
    let pt3 = rc2_point_at(0, 0, 1, 0, 5)
    let ok3 = approx_vec2(pt3, 5.0, 0.0, TOL)
    if ok3 != true
        print("FAIL raycast2d rc2_point_at(0,0,1,0,5): got=[" + str(pt3[0]) + "," + str(pt3[1]) + "] want=[5,0]")
        exit(1)

    // ── KAT 4: rc2_point_at(1,2, 0,1, 3) == [1,5] ───────────────────────────
    let pt4 = rc2_point_at(1, 2, 0, 1, 3)
    let ok4 = approx_vec2(pt4, 1.0, 5.0, TOL)
    if ok4 != true
        print("FAIL raycast2d rc2_point_at(1,2,0,1,3): got=[" + str(pt4[0]) + "," + str(pt4[1]) + "] want=[1,5]")
        exit(1)

    // ── KAT 5: rc2_reflect(1,-1, 0,1) == [1,1] (reflect off horizontal) ──────
    // Incoming direction [1,-1], surface normal [0,1] (upward).
    // Reflected = d - 2*(d·n)*n = [1,-1] - 2*(-1)*[0,1] = [1,-1]+[0,2] = [1,1].
    let ref5 = rc2_reflect(1, -1, 0, 1)
    let ok5 = approx_vec2(ref5, 1.0, 1.0, TOL)
    if ok5 != true
        print("FAIL raycast2d rc2_reflect(1,-1, 0,1): got=[" + str(ref5[0]) + "," + str(ref5[1]) + "] want=[1,1]")
        exit(1)

    // ── KAT 6: rc2_reflect vertical surface ───────────────────────────────────
    // Direction [1,0], normal [-1,0] (left face of wall).
    // d·n = -1; reflect = [1,0] - 2*(-1)*[-1,0] = [1,0] - [2,0] = [-1,0].
    let ref6 = rc2_reflect(1, 0, -1, 0)
    let ok6 = approx_vec2(ref6, -1.0, 0.0, TOL)
    if ok6 != true
        print("FAIL raycast2d rc2_reflect(1,0,-1,0): got=[" + str(ref6[0]) + "," + str(ref6[1]) + "] want=[-1,0]")
        exit(1)

    // ── KAT 7: rc2_ray_aabb hit ───────────────────────────────────────────────
    // Ray from (0, 0.5) direction (1,0); box [3,0,1,1] (x=3..4, y=0..1).
    // Slab x: entry t=3.0, exit t=4.0.  Origin y=0.5 inside y-slab [0,1].
    // Should hit at t=3.0, px=3.0, py=0.5.
    let box7 = [3, 0, 1, 1]
    let hit7 = rc2_ray_aabb(0, 0.5, 1, 0, box7)
    if hit7["hit"] != true
        print("FAIL raycast2d rc2_ray_aabb: expected hit=true")
        exit(1)
    let t7 = hit7["t"]
    if approx(t7, 3.0, TOL) != true
        print("FAIL raycast2d rc2_ray_aabb t: got=" + str(t7) + " want=3.0")
        exit(1)
    let px7 = hit7["px"]
    if approx(px7, 3.0, TOL) != true
        print("FAIL raycast2d rc2_ray_aabb px: got=" + str(px7) + " want=3.0")
        exit(1)

    // ── KAT 8: rc2_ray_aabb miss (y=5 above box) ─────────────────────────────
    let hit8 = rc2_ray_aabb(0, 5, 1, 0, box7)
    if hit8["hit"] != false
        print("FAIL raycast2d rc2_ray_aabb miss: expected hit=false, got hit=true")
        exit(1)

    // ── KAT 9: rc2_ray_aabb miss (ray going away from box) ───────────────────
    let hit9 = rc2_ray_aabb(10, 0.5, 1, 0, box7)
    if hit9["hit"] != false
        print("FAIL raycast2d rc2_ray_aabb reverse miss: expected hit=false")
        exit(1)

    // ── KAT 10: rc2_ray_circle ───────────────────────────────────────────────
    // Ray (0,0) direction (1,0); circle at (5,0) radius 1.
    // Nearest entry: x=4.0 (t=4.0).
    let hit10 = rc2_ray_circle(0, 0, 1, 0, 5, 0, 1)
    if hit10["hit"] != true
        print("FAIL raycast2d rc2_ray_circle: expected hit=true")
        exit(1)
    let t10 = hit10["t"]
    if approx(t10, 4.0, TOL) != true
        print("FAIL raycast2d rc2_ray_circle t: got=" + str(t10) + " want=4.0")
        exit(1)
    let px10 = hit10["px"]
    if approx(px10, 4.0, TOL) != true
        print("FAIL raycast2d rc2_ray_circle px: got=" + str(px10) + " want=4.0")
        exit(1)

    // ── KAT 11: rc2_ray_circle miss ──────────────────────────────────────────
    // Ray (0,0) direction (0,1) (going up); circle at (5,0) radius 1.
    // Ray goes along y-axis, never reaches x=5.
    let hit11 = rc2_ray_circle(0, 0, 0, 1, 5, 0, 1)
    if hit11["hit"] != false
        print("FAIL raycast2d rc2_ray_circle miss: expected hit=false")
        exit(1)

    // ── KAT 12: rc2_ray_segment ───────────────────────────────────────────────
    // Ray (0,0) direction (0,1) (going in +y direction).
    // Segment (-1,5)-(1,5) is a horizontal line at y=5.
    // Hit point should be (0,5), t=5.
    let hit12 = rc2_ray_segment(0, 0, 0, 1, -1, 5, 1, 5)
    if hit12["hit"] != true
        print("FAIL raycast2d rc2_ray_segment: expected hit=true")
        exit(1)
    let t12 = hit12["t"]
    if approx(t12, 5.0, TOL) != true
        print("FAIL raycast2d rc2_ray_segment t: got=" + str(t12) + " want=5.0")
        exit(1)
    let px12 = hit12["px"]
    let py12 = hit12["py"]
    if approx(px12, 0.0, TOL) != true or approx(py12, 5.0, TOL) != true
        print("FAIL raycast2d rc2_ray_segment px,py: got=[" + str(px12) + "," + str(py12) + "] want=[0,5]")
        exit(1)

    // ── KAT 13: rc2_ray_segment miss (parallel) ──────────────────────────────
    // Horizontal ray and horizontal segment — parallel, no hit.
    let hit13 = rc2_ray_segment(0, 0, 1, 0, 0, 5, 10, 5)
    if hit13["hit"] != false
        print("FAIL raycast2d rc2_ray_segment parallel: expected hit=false")
        exit(1)

    // ── KAT 14: rc2_ray_segment miss (ray doesn't reach) ─────────────────────
    // Ray (0,0) direction (0,1); segment at y=5 but x range [3,7] (miss).
    let hit14 = rc2_ray_segment(0, 0, 0, 1, 3, 5, 7, 5)
    if hit14["hit"] != false
        print("FAIL raycast2d rc2_ray_segment x-range miss: expected hit=false")
        exit(1)

    // ── KAT 15: rc2_dda_grid ─────────────────────────────────────────────────
    // Build a 5x5 grid (tilesize=1). Place a wall at (3,0).
    // Ray from (0.5, 0.5) direction (1,0) — travelling right along row y=0.
    // Should hit cell (3,0).
    let grid15 = {}
    let cells15 = []
    let ii = 0
    while ii < 25
        push(cells15, 0)
        ii = ii + 1
    cells15[3] = 1
    grid15["w"] = 5
    grid15["h"] = 5
    grid15["cells"] = cells15
    grid15["tilesize"] = 1
    let dda15 = rc2_dda_grid(0.5, 0.5, 1, 0, grid15, 10)
    let dda15_len = len(dda15)
    if dda15_len != 2
        print("FAIL raycast2d rc2_dda_grid: expected 2-elem result [cx,cy], got len=" + str(dda15_len))
        exit(1)
    let dda15_cx = dda15[0]
    let dda15_cy = dda15[1]
    if dda15_cx != 3 or dda15_cy != 0
        print("FAIL raycast2d rc2_dda_grid hit cell: got=[" + str(dda15_cx) + "," + str(dda15_cy) + "] want=[3,0]")
        exit(1)

    // ── KAT 16: rc2_dda_grid no hit ──────────────────────────────────────────
    // Empty grid, ray goes right, max_steps=3 (won't reach far wall).
    let grid16 = {}
    let cells16 = []
    let jj = 0
    while jj < 25
        push(cells16, 0)
        jj = jj + 1
    grid16["w"] = 5
    grid16["h"] = 5
    grid16["cells"] = cells16
    grid16["tilesize"] = 1
    let dda16 = rc2_dda_grid(0.5, 0.5, 1, 0, grid16, 3)
    let dda16_len = len(dda16)
    if dda16_len != 0
        print("FAIL raycast2d rc2_dda_grid no-hit: expected [] got len=" + str(dda16_len))
        exit(1)

    print("PASS _raycast2d_test")
