// Forge S5: channel join-authorization. channel_join admits a topic join only when the policy allows
// (registers presence + true); a denied join leaves presence untouched + returns false. presence_count
// reports membership. Socketless (actor + a plain policy fn), deterministic, kill-on-timeout.
import forge_otp

// Policy: only "room1" admits joins.
fn allow_room1(topic, who)
    topic == "room1"

fn main()
    let pr = presence()
    let pol = allow_room1

    // allowed join -> true + presence registered
    if channel_join(pr, "room1", "alice", pol) == false
        print("FAIL: room1 join should be allowed")
        exit(1)
    if presence_count(pr, "room1") != 1
        print("FAIL: alice should be present in room1")
        exit(1)

    // denied join -> false + NO presence
    if channel_join(pr, "room2", "eve", pol)
        print("FAIL: room2 join should be denied")
        exit(1)
    if presence_count(pr, "room2") != 0
        print("FAIL: eve must NOT be present in room2 after a denied join")
        exit(1)

    // join_allowed direct
    if join_allowed("room1", "x", pol) == false or join_allowed("room2", "x", pol)
        print("FAIL: join_allowed should mirror the policy")
        exit(1)

    print("PASS forge_channel (channel_join: allow -> presence+true, deny -> no-presence+false; presence_count)")
