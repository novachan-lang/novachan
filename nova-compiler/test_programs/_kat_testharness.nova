import forge_test

fn tf(b: bool) -> string
    if b
        return "T"
    "F"

fn main()
    let q = chr(34)
    let crlf = chr(13) + chr(10)
    let body = chr(123) + q + "id" + q + ":5," + q + "name" + q + ":" + q + "neo" + q + chr(125)
    let resp = "HTTP/1.1 200 OK" + crlf + "Content-Type: application/json" + crlf + crlf + body
    print("status=" + str(response_status(resp)))
    print("body_ok=" + tf(response_body(resp) == body))
    print("hdr_hit=" + tf(assert_header(resp, "Content-Type", "application/json")))
    print("hdr_miss=" + tf(assert_header(resp, "X-Missing", "y")))
    print("notcontains_ok=" + tf(assert_not_contains(resp, "secret")))
    print("notcontains_body=" + tf(assert_not_contains(resp, "neo")))
    print("json_id=" + tf(assert_json_field(resp, "id", "5")))
    print("json_name=" + tf(assert_json_field(resp, "name", "neo")))
    print("json_missing=" + tf(assert_json_field(resp, "nope", "x")))
    let r404 = "HTTP/1.1 404 Not Found" + crlf + crlf + "gone"
    print("status404=" + str(response_status(r404)))
