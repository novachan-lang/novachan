// Forge S3 (T8.4/T8.5/T8.6): the observability endpoints wired onto a live Forge app -- GET /metrics
// (Prometheus text), GET /healthz (liveness 200), GET /readyz (readiness, 503 if a check fails).
// Socketless via dispatch_req -> kill-on-timeout safe.
import forge
import forge_obs

fn chk_ok()
    true
fn chk_bad()
    false

fn main()
    let a = app()
    let reg = metrics_registry()
    obs_routes(a, reg)
    readyz_route(a, [["db", chk_ok]])
    metric_observe(reg, "GET", "/x", 200, 5)

    let m: Response = dispatch_req(a, build_request("GET /metrics HTTP/1.1\r\n\r\n", 0))
    if find(finalize(m), "http_requests_total") < 0
        print("FAIL: /metrics missing prometheus text")
        exit(1)
    let h: Response = dispatch_req(a, build_request("GET /healthz HTTP/1.1\r\n\r\n", 0))
    if h.status != 200
        print("FAIL: /healthz status " + str(h.status))
        exit(1)
    let rd: Response = dispatch_req(a, build_request("GET /readyz HTTP/1.1\r\n\r\n", 0))
    if rd.status != 200
        print("FAIL: /readyz (all checks ok) status " + str(rd.status))
        exit(1)

    // readyz with a failing check -> 503
    let b = app()
    readyz_route(b, [["db", chk_bad]])
    let rb: Response = dispatch_req(b, build_request("GET /readyz HTTP/1.1\r\n\r\n", 0))
    if rb.status != 503
        print("FAIL: /readyz (failing check) should be 503, got " + str(rb.status))
        exit(1)

    print("PASS forge_obs_routes (/metrics prometheus + /healthz 200 + /readyz 200/503)")
