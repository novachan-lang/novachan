// KAT for std/physics/optics_geo — geometric optics formulas.
import std/physics/optics_geo

// approx — absolute tolerance 0.001.
fn approx(a, b)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < 0.001

// approx_rel — relative tolerance for very large or very small values.
fn approx_rel(a, b, tol)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    let ref = b
    if ref < 0.0
        ref = 0.0 - ref
    if ref < 0.000001
        return d < tol
    let ratio = d / ref
    return ratio < tol

fn ckf(label, got, want)
    if not approx(got, want)
        print("FAIL optics_geo " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // image_distance: 1/(1/focal - 1/obj_dist)
    // obj=30, f=10 -> 1/(1/10 - 1/30) = 1/(3/30 - 1/30) = 1/(2/30) = 15
    ckf("image_distance(30,10)", image_distance(30.0, 10.0), 15.0)
    // obj=20, f=10 -> 1/(0.1 - 0.05) = 1/0.05 = 20
    ckf("image_distance(20,10)", image_distance(20.0, 10.0), 20.0)
    // obj=40, f=10 -> 1/(0.1 - 0.025) = 1/0.075 = 13.333...
    let d_40_10 = image_distance(40.0, 10.0)
    if not approx_rel(d_40_10, 13.3333, 0.001)
        print("FAIL optics_geo image_distance(40,10): got " + str(d_40_10) + " want ~13.333")
        exit(1)

    // magnification: -di/do
    // di=15, do=30 -> -15/30 = -0.5
    ckf("magnification(15,30)", magnification(15.0, 30.0), 0.0 - 0.5)
    // di=20, do=20 -> -1.0
    ckf("magnification(20,20)", magnification(20.0, 20.0), 0.0 - 1.0)
    // di=5, do=10 -> -0.5
    ckf("magnification(5,10)", magnification(5.0, 10.0), 0.0 - 0.5)

    // snell_refraction_ratio: n1*sin(t1)/n2
    // n1=1.0, sin_t1=0.5, n2=1.5 -> 0.5/1.5 = 0.3333
    let sr1 = snell_refraction_ratio(1.0, 0.5, 1.5)
    if not approx_rel(sr1, 0.3333, 0.001)
        print("FAIL optics_geo snell(1.0,0.5,1.5): got " + str(sr1) + " want ~0.3333")
        exit(1)
    // n1=1.5, sin_t1=0.5, n2=1.0 -> 0.75
    ckf("snell(1.5,0.5,1.0)", snell_refraction_ratio(1.5, 0.5, 1.0), 0.75)

    // mirror_focal: R/2
    ckf("mirror_focal(20)", mirror_focal(20.0), 10.0)
    ckf("mirror_focal(8)", mirror_focal(8.0), 4.0)
    ckf("mirror_focal(0.5)", mirror_focal(0.5), 0.25)

    print("PASS _optics_geo_test")
