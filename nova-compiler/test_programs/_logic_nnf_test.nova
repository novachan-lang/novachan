import std/logic/logic_nnf

// cki — integer known-answer check.
fn cki(label, got, want)
    if got != want
        print("FAIL _logic_nnf_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb — boolean known-answer check (bool as int).
fn ckb(label, got, want)
    if got != want
        print("FAIL _logic_nnf_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckl — integer-list known-answer check.
fn ckl(label, got, want)
    if len(got) != len(want)
        print("FAIL _logic_nnf_test " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL _logic_nnf_test " + label + ": got[" + str(i) + "]=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

// make_asgn — build an assignment list [v0, v1, ...] from a bitmask.
// For n variables, bit b of mask = value of var b.
fn make_asgn(mask, n) -> list
    let asgn = []
    let b = 0
    while b < n
        push(asgn, (mask >> b) & 1)
        b = b + 1
    asgn

// equiv_check — verify that transform(f) is logically equiv to f on all 2^n assignments.
// Returns 1 if equivalent, 0 if any mismatch found.
fn equiv_check(orig, transformed, n) -> int
    let total = 1
    let k = 0
    while k < n
        total = total * 2
        k = k + 1
    let ok = 1
    let i = 0
    while i < total
        let asgn = make_asgn(i, n)
        let v_orig = lnf_eval(orig, asgn)
        let v_trans = lnf_eval(transformed, asgn)
        if v_orig != v_trans
            ok = 0
        i = i + 1
    ok

fn main()
    // ─── lnf_eval basic cases ───────────────────────────────────────────────

    // const 1
    let c1 = []
    push(c1, "const")
    push(c1, 1)
    let a0 = []
    cki("eval_const1", lnf_eval(c1, a0), 1)

    // const 0
    let c0 = []
    push(c0, "const")
    push(c0, 0)
    cki("eval_const0", lnf_eval(c0, a0), 0)

    // var 0 with asgn [1]
    let vnode = []
    push(vnode, "var")
    push(vnode, 0)
    let a1 = []
    push(a1, 1)
    cki("eval_var0_true", lnf_eval(vnode, a1), 1)
    let a2 = []
    push(a2, 0)
    cki("eval_var0_false", lnf_eval(vnode, a2), 0)

    // not(var 0) with asgn [1] => 0
    let not_v = []
    push(not_v, "not")
    push(not_v, vnode)
    cki("eval_not_var0_true", lnf_eval(not_v, a1), 0)
    cki("eval_not_var0_false", lnf_eval(not_v, a2), 1)

    // and(var0, var1) => 1 only when both true
    let v0 = []
    push(v0, "var")
    push(v0, 0)
    let v1 = []
    push(v1, "var")
    push(v1, 1)
    let and_f = []
    push(and_f, "and")
    push(and_f, v0)
    push(and_f, v1)
    let a_tt = []
    push(a_tt, 1)
    push(a_tt, 1)
    let a_tf = []
    push(a_tf, 1)
    push(a_tf, 0)
    let a_ft = []
    push(a_ft, 0)
    push(a_ft, 1)
    let a_ff = []
    push(a_ff, 0)
    push(a_ff, 0)
    cki("eval_and_tt", lnf_eval(and_f, a_tt), 1)
    cki("eval_and_tf", lnf_eval(and_f, a_tf), 0)
    cki("eval_and_ft", lnf_eval(and_f, a_ft), 0)
    cki("eval_and_ff", lnf_eval(and_f, a_ff), 0)

    // or(var0, var1)
    let or_f = []
    push(or_f, "or")
    push(or_f, v0)
    push(or_f, v1)
    cki("eval_or_tt", lnf_eval(or_f, a_tt), 1)
    cki("eval_or_tf", lnf_eval(or_f, a_tf), 1)
    cki("eval_or_ft", lnf_eval(or_f, a_ft), 1)
    cki("eval_or_ff", lnf_eval(or_f, a_ff), 0)

    // ─── lnf_to_nnf — equivalence check over n=2 ────────────────────────────
    // f = NOT(AND(var0, var1))
    let f_nand = []
    push(f_nand, "not")
    push(f_nand, and_f)
    let nnf_nand = lnf_to_nnf(f_nand)
    // Check the NNF result evaluates equivalently on all 4 assignments
    cki("nnf_nand_tt", lnf_eval(nnf_nand, a_tt), 0)
    cki("nnf_nand_tf", lnf_eval(nnf_nand, a_tf), 1)
    cki("nnf_nand_ft", lnf_eval(nnf_nand, a_ft), 1)
    cki("nnf_nand_ff", lnf_eval(nnf_nand, a_ff), 1)
    // Full enumeration equivalence check
    cki("nnf_nand_equiv", equiv_check(f_nand, nnf_nand, 2), 1)

    // NNF of NOT(NOT(var0)) = var0
    let dbl_neg = []
    push(dbl_neg, "not")
    push(dbl_neg, not_v)
    let nnf_dbl = lnf_to_nnf(dbl_neg)
    cki("nnf_double_neg_0", lnf_eval(nnf_dbl, a2), 0)
    cki("nnf_double_neg_1", lnf_eval(nnf_dbl, a1), 1)

    // ─── lnf_to_cnf — n=3 enumeration check ─────────────────────────────────
    // f = OR(AND(var0, var1), var2)
    let v2 = []
    push(v2, "var")
    push(v2, 2)
    let f3 = []
    push(f3, "or")
    push(f3, and_f)
    push(f3, v2)
    let cnf3 = lnf_to_cnf(f3)
    cki("cnf3_equiv", equiv_check(f3, cnf3, 3), 1)

    // ─── lnf_to_dnf — n=3 enumeration check ─────────────────────────────────
    let dnf3 = lnf_to_dnf(f3)
    cki("dnf3_equiv", equiv_check(f3, dnf3, 3), 1)

    // ─── lnf_simplify ────────────────────────────────────────────────────────
    // AND(var0, const1) should simplify to something equivalent to var0
    let const1_node = []
    push(const1_node, "const")
    push(const1_node, 1)
    let and_const1 = []
    push(and_const1, "and")
    push(and_const1, v0)
    push(and_const1, const1_node)
    let simp1 = lnf_simplify(and_const1)
    cki("simplify_and_const1_equiv", equiv_check(and_const1, simp1, 1), 1)
    // result must not be "and" (was constant-folded)
    let simp1_tag = simp1[0]
    if simp1_tag == "and"
        print("FAIL _logic_nnf_test simplify_and_const1_tag: still an 'and' node")
        exit(1)

    // AND(var0, const0) should simplify to const0
    let const0_node = []
    push(const0_node, "const")
    push(const0_node, 0)
    let and_const0 = []
    push(and_const0, "and")
    push(and_const0, v0)
    push(and_const0, const0_node)
    let simp0 = lnf_simplify(and_const0)
    cki("simplify_and_const0_tag_is_const", simp0[0] == "const", 1)
    cki("simplify_and_const0_val", simp0[1], 0)

    // OR(var0, const0) => var0
    let or_c0 = []
    push(or_c0, "or")
    push(or_c0, v0)
    push(or_c0, const0_node)
    let simp_or0 = lnf_simplify(or_c0)
    cki("simplify_or_const0_equiv", equiv_check(or_c0, simp_or0, 1), 1)
    if simp_or0[0] == "or"
        print("FAIL _logic_nnf_test simplify_or_const0_tag: still an 'or' node")
        exit(1)

    // OR(var0, const1) => const1
    let or_c1 = []
    push(or_c1, "or")
    push(or_c1, v0)
    push(or_c1, const1_node)
    let simp_or1 = lnf_simplify(or_c1)
    cki("simplify_or_const1_tag_is_const", simp_or1[0] == "const", 1)
    cki("simplify_or_const1_val", simp_or1[1], 1)

    // NOT(const0) => const1
    let not_c0 = []
    push(not_c0, "not")
    push(not_c0, const0_node)
    let simp_nc0 = lnf_simplify(not_c0)
    cki("simplify_not_const0", simp_nc0[1], 1)

    // NOT(NOT(var0)) => var0 equivalent
    let nn_v0 = []
    push(nn_v0, "not")
    push(nn_v0, not_v)
    let simp_nn = lnf_simplify(nn_v0)
    cki("simplify_dbl_neg_equiv", equiv_check(nn_v0, simp_nn, 1), 1)

    // ─── NNF on NOT(OR(var0,var1)) = De Morgan's: AND(NOT var0, NOT var1) ────
    let not_or = []
    push(not_or, "not")
    push(not_or, or_f)
    let nnf_nor = lnf_to_nnf(not_or)
    cki("nnf_nor_equiv", equiv_check(not_or, nnf_nor, 2), 1)
    // result should be an AND at top level
    cki("nnf_nor_top_and", nnf_nor[0] == "and", 1)

    // ─── CNF/DNF on NOT(AND(var0,var1)) over n=2 ────────────────────────────
    let cnf_nand = lnf_to_cnf(f_nand)
    cki("cnf_nand_equiv", equiv_check(f_nand, cnf_nand, 2), 1)
    let dnf_nand = lnf_to_dnf(f_nand)
    cki("dnf_nand_equiv", equiv_check(f_nand, dnf_nand, 2), 1)

    // ─── tautology: OR(var0, NOT(var0)) ─────────────────────────────────────
    let taut = []
    push(taut, "or")
    push(taut, v0)
    push(taut, not_v)
    let nnf_taut = lnf_to_nnf(taut)
    cki("nnf_taut_equiv", equiv_check(taut, nnf_taut, 1), 1)
    cki("taut_all_true_0", lnf_eval(taut, a1), 1)
    cki("taut_all_true_1", lnf_eval(taut, a2), 1)

    print("PASS _logic_nnf_test")
