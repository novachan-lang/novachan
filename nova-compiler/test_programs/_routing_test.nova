import std/validation/routing

// KAT 1: JPMorgan Chase routing number — known valid
let ck1 = vrt_is_valid("021000021")
if ck1 != 1
    print("FAIL: vrt_is_valid(021000021) expected 1, got " + str(ck1))
    exit(1)

// KAT 2: Another known valid routing number (Wells Fargo Boston area)
let ck2 = vrt_is_valid("011401533")
if ck2 != 1
    print("FAIL: vrt_is_valid(011401533) expected 1, got " + str(ck2))
    exit(1)

// KAT 3: Off-by-one in last digit — must be invalid
let ck3 = vrt_is_valid("021000020")
if ck3 != 0
    print("FAIL: vrt_is_valid(021000020) expected 0, got " + str(ck3))
    exit(1)

// KAT 4: Only 8 digits — must be invalid
let ck4 = vrt_is_valid("12345678")
if ck4 != 0
    print("FAIL: vrt_is_valid(12345678) expected 0, got " + str(ck4))
    exit(1)

// KAT 5: Non-digit characters — must be invalid
let ck5 = vrt_is_valid("abcdefghi")
if ck5 != 0
    print("FAIL: vrt_is_valid(abcdefghi) expected 0, got " + str(ck5))
    exit(1)

// KAT 6: vrt_check for valid number returns 0
let ck6 = vrt_check("021000021")
if ck6 != 0
    print("FAIL: vrt_check(021000021) expected 0, got " + str(ck6))
    exit(1)

// KAT 7: vrt_federal_district for "021000021" -> first two digits = 02 -> int 2
let ck7 = vrt_federal_district("021000021")
if ck7 != 2
    print("FAIL: vrt_federal_district(021000021) expected 2, got " + str(ck7))
    exit(1)

// KAT 8: vrt_check returns -1 for non-digit input
let ck8 = vrt_check("abcdefghi")
if ck8 != -1
    print("FAIL: vrt_check(abcdefghi) expected -1, got " + str(ck8))
    exit(1)

// KAT 9: vrt_federal_district returns -1 for short input
let ck9 = vrt_federal_district("12345678")
if ck9 != -1
    print("FAIL: vrt_federal_district(12345678) expected -1, got " + str(ck9))
    exit(1)

// KAT 10: vrt_federal_district for "011401533" -> first two digits = 01 -> int 1
let ck10 = vrt_federal_district("011401533")
if ck10 != 1
    print("FAIL: vrt_federal_district(011401533) expected 1, got " + str(ck10))
    exit(1)

print("_routing_test passed")
