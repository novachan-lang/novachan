import std/functional/faccumulate

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckl(label, got, want)
    if len(got) != len(want)
        print("FAIL " + label + ": len " + str(len(got)) + " != " + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL " + label + "[" + str(i) + "]: got " + str(got[i]) + " want " + str(want[i]))
            exit(1)
        i = i + 1

fn sqr(x)
    x * x

fn dbl(x)
    x * 2

fn is_even(x)
    x % 2 == 0

fn main()
    // fa_sum_by(sqr, [1,2,3]) = 1+4+9 = 14
    let xs1 = [1, 2, 3]
    cki("sum_by_sqr_123", fa_sum_by(sqr, xs1), 14)

    // fa_sum_by(dbl, [1,2,3,4]) = 2+4+6+8 = 20
    let xs2 = [1, 2, 3, 4]
    cki("sum_by_dbl_1234", fa_sum_by(dbl, xs2), 20)

    // empty list -> 0
    let empty = []
    cki("sum_by_sqr_empty", fa_sum_by(sqr, empty), 0)

    // fa_product_by(dbl, [1,2,3]) = 2*4*6 = 48
    let xs3 = [1, 2, 3]
    cki("product_by_dbl_123", fa_product_by(dbl, xs3), 48)

    // empty list -> 1
    cki("product_by_empty", fa_product_by(dbl, empty), 1)

    // fa_product_by(sqr, [1,2,3]) = 1*4*9 = 36
    cki("product_by_sqr_123", fa_product_by(sqr, xs1), 36)

    // fa_max_by_value(sqr, [-3,1,2]) = max(9,1,4) = 9
    let xs4 = [-3, 1, 2]
    cki("max_by_sqr_m3_1_2", fa_max_by_value(sqr, xs4), 9)

    // fa_max_by_value on single element
    let single = [5]
    cki("max_by_sqr_single5", fa_max_by_value(sqr, single), 25)

    // fa_max_by_value empty -> 0
    cki("max_by_empty", fa_max_by_value(sqr, empty), 0)

    // fa_count_where(is_even, [1,2,3,4]) = 2
    let xs5 = [1, 2, 3, 4]
    cki("count_where_even_1234", fa_count_where(is_even, xs5), 2)

    // fa_count_where empty -> 0
    cki("count_where_empty", fa_count_where(is_even, empty), 0)

    // fa_count_where all match
    let evens = [2, 4, 6]
    cki("count_where_all_even", fa_count_where(is_even, evens), 3)

    // fa_count_where none match
    let odds = [1, 3, 5]
    cki("count_where_no_even", fa_count_where(is_even, odds), 0)

    print("PASS _faccumulate_test")

main()
