import std/permutation/perm_fixed

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got " + gs + " want " + ws)
        exit(1)

fn ckl(label: string, got, want)
    let ng = len(got)
    let nw = len(want)
    if ng != nw
        print("FAIL " + label + ": length " + str(ng) + " want " + str(nw))
        exit(1)
    let i = 0
    while i < ng
        if got[i] != want[i]
            print("FAIL " + label + "[" + str(i) + "]: got " + str(got[i]) + " want " + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // pf_fixed_points([0,2,1,3]) = [0,3]  (0 fixed, 1<->2 swap, 3 fixed)
    let p0213 = [0, 2, 1, 3]
    let fp0213 = pf_fixed_points(p0213)
    let exp_fp0213 = [0, 3]
    ckl("fixed_points([0,2,1,3])", fp0213, exp_fp0213)

    // pf_fixed_count([0,2,1,3]) = 2
    cki("fixed_count([0,2,1,3])", pf_fixed_count(p0213), 2)

    // pf_moved_count([0,2,1,3]) = 2
    cki("moved_count([0,2,1,3])", pf_moved_count(p0213), 2)

    // pf_moved_points([0,2,1,3]) = [1,2]
    let mp0213 = pf_moved_points(p0213)
    let exp_mp0213 = [1, 2]
    ckl("moved_points([0,2,1,3])", mp0213, exp_mp0213)

    // pf_fixed_points([0,1,2]) = [0,1,2]  (identity)
    let pid = [0, 1, 2]
    let fp_id = pf_fixed_points(pid)
    let exp_id = [0, 1, 2]
    ckl("fixed_points(identity)", fp_id, exp_id)

    // pf_fixed_count([1,2,0]) = 0  (3-cycle, no fixed points)
    cki("fixed_count([1,2,0])", pf_fixed_count([1, 2, 0]), 0)

    // empty permutation: all counts zero, empty lists
    let pe = []
    cki("fixed_count([])", pf_fixed_count(pe), 0)
    cki("moved_count([])", pf_moved_count(pe), 0)
    let fp_e = pf_fixed_points(pe)
    let exp_e = []
    ckl("fixed_points([])", fp_e, exp_e)
    let mp_e = pf_moved_points(pe)
    ckl("moved_points([])", mp_e, exp_e)

    // single element: [0] -> fixed
    let p1 = [0]
    cki("fixed_count([0])", pf_fixed_count(p1), 1)
    cki("moved_count([0])", pf_moved_count(p1), 0)

    print("PASS _perm_fixed_test")
