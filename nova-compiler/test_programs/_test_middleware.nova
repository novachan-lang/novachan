@middleware
fn auth_check(req: string) -> string
    return "checked: " + req

@middleware("rate_limit")
fn rate_limiter(req: string) -> string
    return "limited: " + req

fn main()
    assert(auth_check__middleware_name() == "auth_check", "auto name")
    assert(auth_check__is_middleware() == 1, "is middleware")

    assert(rate_limiter__middleware_name() == "rate_limit", "custom name")
    assert(rate_limiter__is_middleware() == 1, "custom is middleware")

    let r1 = auth_check("GET /api")
    assert(r1 == "checked: GET /api", "fn still works")

    print("MIDDLEWARE ANNOTATION TEST PASS")
