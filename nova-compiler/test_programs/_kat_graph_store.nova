import forge_graph_store

fn main()
    let g = gs_new()
    let r1 = gs_add_node(g, "alice", "person")
    assert(is_ok(r1), "add alice")
    g = unwrap(r1)
    let r2 = gs_add_node(g, "bob", "person")
    assert(is_ok(r2), "add bob")
    g = unwrap(r2)
    assert(gs_node_count(g) == 2, "2 nodes")

    let dup = gs_add_node(g, "alice", "x")
    assert(is_err(dup), "dup node")

    let r3 = gs_add_edge(g, "alice", "bob", "knows")
    assert(is_ok(r3), "add edge")
    g = unwrap(r3)
    assert(gs_has_edge(g, "alice", "bob") == 1, "has edge")
    assert(gs_has_edge(g, "bob", "alice") == 0, "no reverse")

    let lbl = gs_edge_label(g, "alice", "bob")
    assert(is_ok(lbl), "edge label ok")
    assert(unwrap(lbl) == "knows", "label=knows")

    let nlbl = gs_node_label(g, "alice")
    assert(is_ok(nlbl), "node label ok")
    assert(unwrap(nlbl) == "person", "label=person")

    let bad = gs_add_edge(g, "alice", "z", "x")
    assert(is_err(bad), "unknown target")

    print("GRAPH-STORE KAT PASS")
