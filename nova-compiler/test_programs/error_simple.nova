// Minimal error handling test

fn bad() -> int
    error("something broke")
    return 0

fn good() -> int
    return 42

fn main()
    // Test 1: catch an error — single expression handler
    let x = bad() catch e
        -1
    print(x)

    // Test 2: no error — catch is skipped
    let y = good() catch e
        -1
    print(y)

    // Test 3: arithmetic doesn't trigger error
    let z = 10 + 5 catch e
        99
    print(z)

    // Test 4: error message propagation
    let msg = bad() catch e
        e
    print(msg)

    print("done")

main()
