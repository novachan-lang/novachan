fn map_ok(result, f)
  if is_ok(result)
    return ok(f(unwrap(result)))
  result

fn map_err(result, f)
  if is_err(result)
    return err(f(unwrap_err(result)))
  result

fn and_then(result, f)
  if is_ok(result)
    return f(unwrap(result))
  result

fn or_else(result, f)
  if is_err(result)
    return f(unwrap_err(result))
  result

fn result_flatten(result)
  if is_ok(result)
    let inner = unwrap(result)
    return inner
  result

fn result_to_list(result)
  if is_ok(result)
    return [unwrap(result)]
  []

fn result_default(result, default_val)
  if is_ok(result)
    return unwrap(result)
  default_val

fn result_tap(result, f)
  if is_ok(result)
    f(unwrap(result))
  result

fn result_tap_err(result, f)
  if is_err(result)
    f(unwrap_err(result))
  result

fn _double(x)
  x * 2

fn _upcase(s)
  upper(s)

fn _safe_half(x)
  if x % 2 != 0
    return err("not even")
  ok(x / 2)

fn main()
  let r1 = map_ok(ok(21), fn(z) _double(z))
  assert(is_ok(r1), "map_ok keeps ok")
  assert(unwrap(r1) == 42, "map_ok transforms")

  let r2 = map_ok(err("fail"), fn(z) _double(z))
  assert(is_err(r2), "map_ok passes through err")

  let r3 = map_err(err("bad"), fn(z) _upcase(z))
  assert(unwrap_err(r3) == "BAD", "map_err transforms")

  let r4 = map_err(ok(10), fn(z) _upcase(z))
  assert(is_ok(r4), "map_err passes through ok")

  let r5 = and_then(ok(10), fn(z) _safe_half(z))
  assert(is_ok(r5), "and_then chains ok")
  assert(unwrap(r5) == 5, "and_then value")

  let r6 = and_then(ok(11), fn(z) _safe_half(z))
  assert(is_err(r6), "and_then chains to err")

  let r7 = and_then(err("x"), fn(z) _safe_half(z))
  assert(is_err(r7), "and_then short-circuits on err")

  let r8 = or_else(err("x"), fn(z) ok(99))
  assert(is_ok(r8), "or_else recovers")
  assert(unwrap(r8) == 99, "or_else value")

  let r9 = or_else(ok(42), fn(z) ok(99))
  assert(unwrap(r9) == 42, "or_else passes ok")

  assert(len(result_to_list(ok(5))) == 1, "to_list ok")
  assert(len(result_to_list(err("x"))) == 0, "to_list err")

  assert(result_default(ok(42), 0) == 42, "default ok")
  assert(result_default(err("x"), 0) == 0, "default err")

  let tapped = []
  let _t = result_tap(ok(5), fn(z) push(tapped, z))
  assert(len(tapped) == 1, "tap fires on ok")
  let _t2 = result_tap(err("x"), fn(z) push(tapped, z))
  assert(len(tapped) == 1, "tap skips err")

  print("resultx: all passed")
