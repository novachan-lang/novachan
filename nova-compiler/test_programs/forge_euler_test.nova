import forge_euler

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn expect_false(name: string, cond: bool) -> int
    if cond
        print("FAIL " + name + ": expected false")
        return 1
    0

fn main()
    let fails = 0

    // square cycle a-b-c-d-a: all degree 2 -> Euler circuit
    let sq = [["a", "b"], ["b", "c"], ["c", "d"], ["d", "a"]]
    fails = fails + expect_true("square_circuit", has_euler_circuit(sq))
    fails = fails + expect_true("square_path", has_euler_path(sq))
    fails = fails + expect("square_odd", str(euler_odd_count(sq)), "0")

    // path a-b-c: a,c degree 1 (odd), b degree 2 -> Euler path but NOT circuit
    let path = [["a", "b"], ["b", "c"]]
    fails = fails + expect_false("path_no_circuit", has_euler_circuit(path))
    fails = fails + expect_true("path_has_path", has_euler_path(path))
    fails = fails + expect("path_odd", str(euler_odd_count(path)), "2")

    // triangle a-b-c-a: all degree 2 -> Euler circuit
    let tri = [["a", "b"], ["b", "c"], ["c", "a"]]
    fails = fails + expect_true("triangle_circuit", has_euler_circuit(tri))

    // Konigsberg: 4 land masses, 7 bridges, all 4 vertices odd degree -> NO Euler path
    let kb = [["A", "B"], ["A", "B"], ["A", "C"], ["A", "C"], ["A", "D"], ["B", "D"], ["C", "D"]]
    fails = fails + expect_false("konigsberg_path", has_euler_path(kb))
    fails = fails + expect("konigsberg_odd", str(euler_odd_count(kb)), "4")

    // disconnected -> no Euler path even if degrees are fine
    let disc = [["a", "b"], ["b", "a"], ["c", "d"], ["d", "c"]]
    fails = fails + expect_false("disconnected", has_euler_path(disc))

    // single edge a-b: two odd (degree 1) -> Euler path, not circuit
    fails = fails + expect_true("single_path", has_euler_path([["x", "y"]]))
    fails = fails + expect_false("single_circuit", has_euler_circuit([["x", "y"]]))

    // figure-eight (two triangles sharing a vertex): center has degree 4, others degree 2 -> circuit
    let fig8 = [["c", "a"], ["a", "b"], ["b", "c"], ["c", "d"], ["d", "e"], ["e", "c"]]
    fails = fails + expect_true("fig8_circuit", has_euler_circuit(fig8))

    if fails == 0
        print("forge_euler: all passed")
    else
        print("forge_euler: " + str(fails) + " FAILED")
