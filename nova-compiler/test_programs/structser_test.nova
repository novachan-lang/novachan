// structser_test — automatic struct show/to_json renders bool and float fields
// correctly (flagship zero-annotation reflection). Was: bool field -> 1/0, float
// field in JSON -> giant-int garbage (generated self was untyped + json_stringify
// is type-erased). Fix: str() now dispatches bool->true/false, self is typed so
// fields resolve, and to_json uses str() for bool/float (valid JSON tokens).

type Rec
    id: int
    active: bool
    score: float
    name: string

fn main()
    // str()/print of a bool now renders true/false (was 1/0)
    assert_eq(str(true), "true")
    assert_eq(str(false), "false")

    let r = Rec(7, true, 2.5, "alice")

    // automatic __show: bool -> true, float -> 2.5, string -> raw
    assert_eq(str(r), "Rec " + chr(123) + " id: 7, active: true, score: 2.5, name: alice " + chr(125))

    // automatic __to_json: bool -> true, float -> 2.5, string -> quoted
    let q = chr(34)
    let lb = chr(123)
    let rb = chr(125)
    let expected = lb + q + "id" + q + ":7," + q + "active" + q + ":true," + q + "score" + q + ":2.5," + q + "name" + q + ":" + q + "alice" + q + rb
    assert_eq(json_stringify(r), expected)

    print("structser_test passed")
