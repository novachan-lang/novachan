// KAT for std/time/strptime — pattern-based date/time parsing + epoch decomposition.
// Known-answer vectors verified against POSIX strptime + RFC 3339.
import std/time/strptime

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL strptime " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL strptime " + label + ": got '" + got + "' want '" + want + "'")
        exit(1)

fn ckl(label: string, got: list, want: list)
    let ok = true
    if len(got) != len(want)
        ok = false
    else
        let i = 0
        while i < len(want)
            if got[i] != want[i]
                ok = false
            i = i + 1
    if not ok
        let gs = str(got[0]) + "," + str(got[1]) + "," + str(got[2]) + "," + str(got[3]) + "," + str(got[4]) + "," + str(got[5])
        let ws = str(want[0]) + "," + str(want[1]) + "," + str(want[2]) + "," + str(want[3]) + "," + str(want[4]) + "," + str(want[5])
        print("FAIL strptime " + label + ": got [" + gs + "] want [" + ws + "]")
        exit(1)

fn main()
    // ── KAT 1: full datetime pattern ─────────────────────────────────────────
    // 2024-03-09 12:34:56 UTC = epoch 1709987696 (node.js verified)
    let pat1 = "%Y-%m-%d %H:%M:%S"
    let e1 = dt_strptime("2024-03-09 12:34:56", pat1)
    cki("epoch-full", e1, 1709987696)
    // Decompose the epoch back to components
    ckl("ymdhms-full", dt_to_ymdhms(e1), [2024, 3, 9, 12, 34, 56])

    // ── KAT 2: date-only pattern (time fields default to 0) ───────────────────
    // 2024-01-01 00:00:00 UTC = epoch 1704067200
    let e2 = dt_strptime("2024-01-01", "%Y-%m-%d")
    cki("epoch-date-only", e2, 1704067200)
    ckl("ymdhms-date-only", dt_to_ymdhms(e2), [2024, 1, 1, 0, 0, 0])

    // ── KAT 3: malformed input returns -1 ────────────────────────────────────
    let e3 = dt_strptime("bad", "%Y-%m-%d")
    cki("malformed-bad", e3, -1)

    // Partial date (only 8 chars, pattern needs 10)
    let e4 = dt_strptime("2024-03", "%Y-%m-%d")
    cki("malformed-partial", e4, -1)

    // Wrong separator
    let e5 = dt_strptime("2024/03/09", "%Y-%m-%d")
    cki("malformed-sep", e5, -1)

    // Extra trailing chars
    let e6 = dt_strptime("2024-03-09X", "%Y-%m-%d")
    cki("malformed-trail", e6, -1)

    // ── KAT 4: different literal separators ──────────────────────────────────
    // Slash-separated date
    let e7 = dt_strptime("09/03/2024", "%d/%m/%Y")
    cki("slash-sep", e7, 1709942400)
    // 2024-03-09 00:00:00
    ckl("ymdhms-slash", dt_to_ymdhms(e7), [2024, 3, 9, 0, 0, 0])

    // ── KAT 5: T-separator ISO-like ──────────────────────────────────────────
    let e8 = dt_strptime("2024-03-09T12:34:56", "%Y-%m-%dT%H:%M:%S")
    cki("T-sep", e8, 1709987696)

    // ── KAT 6: dt_strftime produces correct strings ───────────────────────────
    cks("strftime-full", dt_strftime(1709987696, "%Y-%m-%d %H:%M:%S"), "2024-03-09 12:34:56")
    cks("strftime-date", dt_strftime(1704067200, "%Y-%m-%d"), "2024-01-01")
    cks("strftime-iso",  dt_strftime(1709987696, "%Y-%m-%dT%H:%M:%S"), "2024-03-09T12:34:56")

    // ── KAT 7: round-trip dt_strftime -> dt_strptime == epoch ────────────────
    // Use a known epoch: 2023-07-04 15:00:00 UTC = 1688482800
    let base = 1688482800
    let rt_str = dt_strftime(base, "%Y-%m-%d %H:%M:%S")
    let rt_ep = dt_strptime(rt_str, "%Y-%m-%d %H:%M:%S")
    cki("round-trip", rt_ep, base)

    // ── KAT 8: leap year 2024-02-29 ──────────────────────────────────────────
    let e9 = dt_strptime("2024-02-29", "%Y-%m-%d")
    ckl("leap-feb29", dt_to_ymdhms(e9), [2024, 2, 29, 0, 0, 0])

    // ── KAT 9: epoch 0 (1970-01-01) ─────────────────────────────────────────
    let e10 = dt_strptime("1970-01-01 00:00:00", "%Y-%m-%d %H:%M:%S")
    cki("epoch-zero", e10, 0)
    ckl("ymdhms-epoch0", dt_to_ymdhms(0), [1970, 1, 1, 0, 0, 0])

    // ── KAT 10: %% literal percent in strftime ────────────────────────────────
    cks("strftime-pct", dt_strftime(1704067200, "%%Y=%Y"), "%Y=2024")
    // strptime: pattern "date: %Y/%m/%d", input must have literal "date: "
    let e11 = dt_strptime("date: 2024/01/01", "date: %Y/%m/%d")
    cki("strptime-literal-prefix", e11, 1704067200)

    print("PASS _strptime_test")
