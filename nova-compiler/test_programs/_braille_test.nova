// KAT test for std/encoding/braille
import std/encoding/braille

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + got + " expected " + expected)
        exit(1)

// ── br_dots ──────────────────────────────────────────────────────────────────

// br_dots("a") == [1]
let dots_a = br_dots("a")
cki("dots_a len", len(dots_a), 1)
cki("dots_a[0]", dots_a[0], 1)

// br_dots("c") == [1, 4]
let dots_c = br_dots("c")
cki("dots_c len", len(dots_c), 2)
cki("dots_c[0]", dots_c[0], 1)
cki("dots_c[1]", dots_c[1], 4)

// br_dots(" ") == []
let dots_sp = br_dots(" ")
cki("dots_sp len", len(dots_sp), 0)

// br_dots("h") == [1,2,5]
let dots_h = br_dots("h")
cki("dots_h len", len(dots_h), 3)
cki("dots_h[0]", dots_h[0], 1)
cki("dots_h[1]", dots_h[1], 2)
cki("dots_h[2]", dots_h[2], 5)

// ── br_cell ──────────────────────────────────────────────────────────────────

// br_cell([1]) == from_codepoint(10241)  (U+2801 = "a")
let cell_a = br_cell([1])
let expect_a = from_codepoint(10241)
cks("cell_a", cell_a, expect_a)

// br_cell([1,2]) == from_codepoint(10243)  (U+2803 = "b")
let cell_b = br_cell([1, 2])
let expect_b = from_codepoint(10243)
cks("cell_b", cell_b, expect_b)

// br_cell([]) == from_codepoint(10240)  (U+2800 = space)
let cell_sp = br_cell([])
let expect_sp = from_codepoint(10240)
cks("cell_sp", cell_sp, expect_sp)

// br_cell([1,4]) == from_codepoint(10249)  (U+2809 = "c", mask=1+8=9)
let cell_c = br_cell([1, 4])
let expect_c = from_codepoint(10249)
cks("cell_c", cell_c, expect_c)

// ── br_from_text ─────────────────────────────────────────────────────────────

// br_from_text("a") == from_codepoint(10241)
let enc_a = br_from_text("a")
cks("from_text_a", enc_a, from_codepoint(10241))

// br_from_text("b") == from_codepoint(10243)
let enc_b = br_from_text("b")
cks("from_text_b", enc_b, from_codepoint(10243))

// br_from_text(" ") == from_codepoint(10240)
let enc_sp = br_from_text(" ")
cks("from_text_space", enc_sp, from_codepoint(10240))

// br_from_text("ab") == two cells: U+2801 U+2803
let enc_ab = br_from_text("ab")
let expect_ab = from_codepoint(10241) + from_codepoint(10243)
cks("from_text_ab", enc_ab, expect_ab)

// h=mask19=U+2813=10259, e=mask17=U+2811=10257, l=mask7=U+2807=10247, o=mask21=U+2815=10261
let enc_hello = br_from_text("hello")
let expect_hello = from_codepoint(10259) + from_codepoint(10257) + from_codepoint(10247) + from_codepoint(10247) + from_codepoint(10261)
cks("from_text_hello", enc_hello, expect_hello)

// ── br_to_text (round-trip) ──────────────────────────────────────────────────

// round-trip: br_to_text(br_from_text("hello")) == "hello"
let rt_hello = br_to_text(br_from_text("hello"))
cks("roundtrip_hello", rt_hello, "hello")

// round-trip: "nova"
let rt_nova = br_to_text(br_from_text("nova"))
cks("roundtrip_nova", rt_nova, "nova")

// round-trip: "a z" (with space)
let rt_space = br_to_text(br_from_text("a z"))
cks("roundtrip_space", rt_space, "a z")

// round-trip: all 26 letters
let rt_alpha = br_to_text(br_from_text("abcdefghijklmnopqrstuvwxyz"))
cks("roundtrip_alpha", rt_alpha, "abcdefghijklmnopqrstuvwxyz")

// round-trip: space alone
let rt_sp = br_to_text(br_from_text(" "))
cks("roundtrip_sp_alone", rt_sp, " ")

print("_braille_test passed")
