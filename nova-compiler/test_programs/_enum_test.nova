// ============================================================================
// KAT test for std/util/enum
//
// Hand-computed expected values for e = en_new(["RED","GREEN","BLUE"]):
//
//   en_value(e, "RED")    == 0   (first ordinal)
//   en_value(e, "GREEN")  == 1
//   en_value(e, "BLUE")   == 2   (last ordinal)
//   en_value(e, "PURPLE") == -1  (absent)
//   en_name(e, 0)         == "RED"
//   en_name(e, 1)         == "GREEN"
//   en_name(e, 2)         == "BLUE"
//   en_name(e, 3)         == ""   (out of range)
//   en_name(e, -1)        == ""   (out of range)
//   en_count(e)           == 3
//   en_has(e, "GREEN")    == true
//   en_has(e, "PURPLE")   == false
//   en_names(e) joined    == "RED,GREEN,BLUE"
//   en_next(e, "RED")     == "GREEN"  ((0+1)%3=1)
//   en_next(e, "GREEN")   == "BLUE"   ((1+1)%3=2)
//   en_next(e, "BLUE")    == "RED"    ((2+1)%3=0)  cyclic wrap
//   en_next(e, "PURPLE")  == ""       (absent)
// ============================================================================

import std/util/enum

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label: str, got: str, want: str)
    if got != want
        print("FAIL " + label + ": got [" + got + "] want [" + want + "]")
        exit(1)

fn ckb(label: str, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got " + gs + " want " + ws)
        exit(1)

fn main()
    // ── Build the test enum ───────────────────────────────────────────────────
    let names = ["RED", "GREEN", "BLUE"]
    let e = en_new(names)

    // ── en_value: ordinals ────────────────────────────────────────────────────
    cki("value_RED",    en_value(e, "RED"),    0)
    cki("value_GREEN",  en_value(e, "GREEN"),  1)
    cki("value_BLUE",   en_value(e, "BLUE"),   2)
    cki("value_PURPLE", en_value(e, "PURPLE"), -1)

    // ── en_name: reverse lookup ───────────────────────────────────────────────
    cks("name_0",  en_name(e, 0),  "RED")
    cks("name_1",  en_name(e, 1),  "GREEN")
    cks("name_2",  en_name(e, 2),  "BLUE")
    cks("name_3",  en_name(e, 3),  "")
    cks("name_neg", en_name(e, -1), "")

    // ── en_count ──────────────────────────────────────────────────────────────
    cki("count", en_count(e), 3)

    // ── en_has ────────────────────────────────────────────────────────────────
    ckb("has_GREEN",  en_has(e, "GREEN"),  true)
    ckb("has_RED",    en_has(e, "RED"),    true)
    ckb("has_BLUE",   en_has(e, "BLUE"),   true)
    ckb("has_PURPLE", en_has(e, "PURPLE"), false)
    ckb("has_empty",  en_has(e, ""),       false)

    // ── en_names: ordered list ────────────────────────────────────────────────
    // Join to a string to verify ordering without needing list == list.
    let nlist = en_names(e)
    let joined = join(nlist, ",")
    cks("names_joined", joined, "RED,GREEN,BLUE")
    cki("names_len", len(nlist), 3)
    cks("names_0", nlist[0], "RED")
    cks("names_1", nlist[1], "GREEN")
    cks("names_2", nlist[2], "BLUE")

    // ── en_next: cyclic successor ─────────────────────────────────────────────
    cks("next_RED",    en_next(e, "RED"),    "GREEN")
    cks("next_GREEN",  en_next(e, "GREEN"),  "BLUE")
    cks("next_BLUE",   en_next(e, "BLUE"),   "RED")
    cks("next_PURPLE", en_next(e, "PURPLE"), "")

    // ── Edge cases: single-element enum ──────────────────────────────────────
    let single_names = ["ONLY"]
    let s = en_new(single_names)
    cki("single_count",       en_count(s),          1)
    cki("single_value_ONLY",  en_value(s, "ONLY"),  0)
    cks("single_name_0",      en_name(s, 0),        "ONLY")
    cks("single_name_1",      en_name(s, 1),        "")
    ckb("single_has_ONLY",    en_has(s, "ONLY"),    true)
    ckb("single_has_X",       en_has(s, "X"),       false)
    // Cyclic next on a single-element enum wraps back to itself.
    cks("single_next_ONLY",   en_next(s, "ONLY"),   "ONLY")

    // ── Edge cases: empty enum ────────────────────────────────────────────────
    let empty_names = []
    let empty = en_new(empty_names)
    cki("empty_count",      en_count(empty),         0)
    cki("empty_value_X",    en_value(empty, "X"),    -1)
    cks("empty_name_0",     en_name(empty, 0),       "")
    ckb("empty_has_X",      en_has(empty, "X"),      false)
    cks("empty_next_X",     en_next(empty, "X"),     "")

    print("_enum_test passed")
