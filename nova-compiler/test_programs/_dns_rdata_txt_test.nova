import std/net/dns_rdata_txt

// ── Helpers ──────────────────────────────────────────────────────────────────

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL dns_rdata_txt " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL dns_rdata_txt " + label + ": got " + got + " want " + want)
        exit(1)

fn ckb(label: string, got: bytes, want: bytes)
    if bytes_len(got) != bytes_len(want)
        print("FAIL dns_rdata_txt " + label + ": len got=" + str(bytes_len(got)) + " want=" + str(bytes_len(want)))
        exit(1)
    let i = 0
    while i < bytes_len(want)
        if bytes_get(got, i) != bytes_get(want, i)
            print("FAIL dns_rdata_txt " + label + ": byte[" + str(i) + "] got=" + str(bytes_get(got, i)) + " want=" + str(bytes_get(want, i)))
            exit(1)
        i = i + 1

// dns_txt_decode now returns list of BYTES character-strings (binary-safe).
// Compare a decoded bytes element against an expected NOVA string by
// comparing byte-for-byte (never bytes_to_str — that NUL-truncates, which
// is exactly the bug we're guarding against for the embedded-NUL vector).
fn ckbs(label: string, got: bytes, want: string)
    if bytes_len(got) != len(want)
        print("FAIL dns_rdata_txt " + label + ": len got=" + str(bytes_len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if bytes_get(got, i) != ord(char_at(want, i))
            print("FAIL dns_rdata_txt " + label + ": byte[" + str(i) + "] got=" + str(bytes_get(got, i)) + " want=" + str(ord(char_at(want, i))))
            exit(1)
        i = i + 1

// ── Build known-answer bytes manually ────────────────────────────────────────

// dns_txt_encode(["hello"]) -> [5, 104, 101, 108, 108, 111]  (6 bytes)
fn make_hello_bytes() -> bytes
    let w = bytes(0)
    w = bytes_append(w, 5)
    w = bytes_append(w, 104)
    w = bytes_append(w, 101)
    w = bytes_append(w, 108)
    w = bytes_append(w, 108)
    w = bytes_append(w, 111)
    w

// dns_txt_encode(["ab","cde"]) -> [2, 97, 98, 3, 99, 100, 101]  (7 bytes)
fn make_ab_cde_bytes() -> bytes
    let w = bytes(0)
    w = bytes_append(w, 2)
    w = bytes_append(w, 97)
    w = bytes_append(w, 98)
    w = bytes_append(w, 3)
    w = bytes_append(w, 99)
    w = bytes_append(w, 100)
    w = bytes_append(w, 101)
    w

fn main()
    // ── Test 1: encode ["hello"] exact KAT bytes ─────────────────────────────
    let enc1 = dns_txt_encode(["hello"])
    let want1 = make_hello_bytes()
    cki("hello_len", bytes_len(enc1), 6)
    ckb("hello_bytes", enc1, want1)

    // ── Test 2: decode ["hello"] round-trip ──────────────────────────────────
    let dec1 = dns_txt_decode(enc1)
    cki("hello_dec_count", len(dec1), 1)
    ckbs("hello_dec_0", dec1[0], "hello")

    // ── Test 3: encode ["ab","cde"] exact KAT bytes ──────────────────────────
    let enc2 = dns_txt_encode(["ab", "cde"])
    let want2 = make_ab_cde_bytes()
    cki("ab_cde_len", bytes_len(enc2), 7)
    ckb("ab_cde_bytes", enc2, want2)

    // ── Test 4: decode ["ab","cde"] round-trip ───────────────────────────────
    let dec2 = dns_txt_decode(enc2)
    cki("ab_cde_dec_count", len(dec2), 2)
    ckbs("ab_cde_dec_0", dec2[0], "ab")
    ckbs("ab_cde_dec_1", dec2[1], "cde")

    // ── Test 5: encode empty list -> 0 bytes ─────────────────────────────────
    let enc_empty = dns_txt_encode([])
    cki("empty_list_len", bytes_len(enc_empty), 0)

    // ── Test 6: decode empty bytes -> empty list ──────────────────────────────
    let dec_empty = dns_txt_decode(bytes(0))
    cki("empty_bytes_count", len(dec_empty), 0)

    // ── Test 7: encode single empty string -> [0] (1 byte, length 0) ─────────
    let enc_zs = dns_txt_encode([""])
    cki("zero_str_len", bytes_len(enc_zs), 1)
    cki("zero_str_byte0", bytes_get(enc_zs, 0), 0)

    // ── Test 8: decode [0] -> [""] (empty character-string) ──────────────────
    let dec_zs = dns_txt_decode(enc_zs)
    cki("zero_str_dec_count", len(dec_zs), 1)
    ckbs("zero_str_dec_0", dec_zs[0], "")

    // ── Test 9: decode truncated input -> partial result (no crash) ───────────
    // Wire: [5, 104, 101] — says length=5 but only 2 bytes follow -> stops early
    let trunc = bytes(0)
    trunc = bytes_append(trunc, 5)
    trunc = bytes_append(trunc, 104)
    trunc = bytes_append(trunc, 101)
    let dec_trunc = dns_txt_decode(trunc)
    cki("trunc_count", len(dec_trunc), 0)

    // ── Test 10: three strings round-trip ─────────────────────────────────────
    let enc3 = dns_txt_encode(["v=spf1", "include:example.com", "~all"])
    let dec3 = dns_txt_decode(enc3)
    cki("three_count", len(dec3), 3)
    ckbs("three_0", dec3[0], "v=spf1")
    ckbs("three_1", dec3[1], "include:example.com")
    ckbs("three_2", dec3[2], "~all")

    // ── Test 11 (NEW): TXT character-string with an embedded 0x00 byte
    // round-trips fully and binary-safely — proves the fix for the
    // string-NUL-truncation defect (dns_txt_decode used to build each
    // character-string via NOVA `string` concatenation, which silently
    // truncates at an embedded 0x00 C-string terminator).
    let txt_nul = bytes(0)
    txt_nul = bytes_append(txt_nul, 5)      // length=5
    txt_nul = bytes_append(txt_nul, 0x41)   // 'A'
    txt_nul = bytes_append(txt_nul, 0x00)   // embedded NUL
    txt_nul = bytes_append(txt_nul, 0x42)   // 'B'
    txt_nul = bytes_append(txt_nul, 0x00)   // another embedded NUL
    txt_nul = bytes_append(txt_nul, 0x43)   // 'C'
    let dec_nul = dns_txt_decode(txt_nul)
    cki("nul_dec_count", len(dec_nul), 1)
    let nul_elem = dec_nul[0]
    cki("nul_dec_len", bytes_len(nul_elem), 5)
    cki("nul_dec_b0", bytes_get(nul_elem, 0), 0x41)
    cki("nul_dec_b1", bytes_get(nul_elem, 1), 0x00)
    cki("nul_dec_b2", bytes_get(nul_elem, 2), 0x42)
    cki("nul_dec_b3", bytes_get(nul_elem, 3), 0x00)
    cki("nul_dec_b4", bytes_get(nul_elem, 4), 0x43)

    print("PASS _dns_rdata_txt_test")
