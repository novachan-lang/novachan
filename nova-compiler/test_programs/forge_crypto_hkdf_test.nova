// Forge crypto: HKDF-SHA256, gated against RFC 5869 Test Case 1 (PRK + the 42-byte OKM). Socketless.
import forge_crypto

fn _rep(byteval: int, n: int) -> list
    let o = []
    let i = 0
    while i < n
        push(o, byteval)
        i = i + 1
    o

fn main()
    let ikm = _rep(0x0b, 22)
    let salt = hex_to_blist("000102030405060708090a0b0c")
    let info = hex_to_blist("f0f1f2f3f4f5f6f7f8f9")

    let prk = hkdf_extract(salt, ikm)
    if hex_of(prk) != "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5"
        print("FAIL: HKDF PRK -> " + hex_of(prk))
        exit(1)

    let okm = hkdf(salt, ikm, info, 42)
    if hex_of(okm) != "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865"
        print("FAIL: HKDF OKM -> " + hex_of(okm))
        exit(1)

    print("PASS forge_crypto_hkdf (RFC 5869 TC1: PRK + 42-byte OKM)")
