// KAT for std/encoding/base58 — binary-safe Bitcoin base58 (leading-zero convention + 0x00 round-trip).
import std/encoding/base58

fn _b(s: string) -> any
    let o = bytes(0)
    let i = 0
    while i < len(s)
        o = bytes_append(o, ord(char_at(s, i)))
        i = i + 1
    return o

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": '" + got + "' != '" + want + "'")
        exit(1)

fn main()
    cks("hello", base58_encode(_b("hello world")), "StV1DL6CwTryKyV")
    cks("a", base58_encode(_b("a")), "2g")
    cks("empty", base58_encode(_b("")), "")
    let z1 = bytes(0)
    z1 = bytes_append(z1, 0)
    cks("zero1", base58_encode(z1), "1")
    let z3 = bytes(0)
    z3 = bytes_append(z3, 0)
    z3 = bytes_append(z3, 0)
    z3 = bytes_append(z3, 0)
    cks("zero3", base58_encode(z3), "111")
    // binary round-trip with interior/leading/trailing 0x00
    let bin = bytes(0)
    bin = bytes_append(bin, 0)
    bin = bytes_append(bin, 16)
    bin = bytes_append(bin, 0)
    bin = bytes_append(bin, 255)
    bin = bytes_append(bin, 0)
    let dec = base58_decode(base58_encode(bin))
    if bytes_len(dec) != 5
        print("FAIL bin len " + str(bytes_len(dec)))
        exit(1)
    if bytes_get(dec, 0) != 0 or bytes_get(dec, 1) != 16 or bytes_get(dec, 2) != 0 or bytes_get(dec, 3) != 255 or bytes_get(dec, 4) != 0
        print("FAIL bin content")
        exit(1)
    cks("decode", str(bytes_get(base58_decode("2g"), 0)), "97")
    print("_base58_test passed")
