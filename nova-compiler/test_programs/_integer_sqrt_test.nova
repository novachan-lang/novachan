import std/search/integer_sqrt

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// KAT: iq_isqrt(17) = 4
cki("isqrt_17", iq_isqrt(17), 4)

// KAT: iq_isqrt(16) = 4
cki("isqrt_16", iq_isqrt(16), 4)

// KAT: iq_isqrt(0) = 0
cki("isqrt_0", iq_isqrt(0), 0)

// KAT: iq_isqrt(1) = 1
cki("isqrt_1", iq_isqrt(1), 1)

// Additional isqrt
cki("isqrt_2",   iq_isqrt(2),   1)
cki("isqrt_3",   iq_isqrt(3),   1)
cki("isqrt_4",   iq_isqrt(4),   2)
cki("isqrt_25",  iq_isqrt(25),  5)
cki("isqrt_26",  iq_isqrt(26),  5)
cki("isqrt_100", iq_isqrt(100), 10)
cki("isqrt_99",  iq_isqrt(99),  9)

// KAT: iq_icbrt(27) = 3
cki("icbrt_27", iq_icbrt(27), 3)

// KAT: iq_icbrt(28) = 3
cki("icbrt_28", iq_icbrt(28), 3)

// Additional icbrt
cki("icbrt_0",   iq_icbrt(0),   0)
cki("icbrt_1",   iq_icbrt(1),   1)
cki("icbrt_8",   iq_icbrt(8),   2)
cki("icbrt_26",  iq_icbrt(26),  2)
cki("icbrt_125", iq_icbrt(125), 5)

// KAT: iq_nth_root(32,5) = 2
cki("nth_root_32_5", iq_nth_root(32, 5), 2)

// KAT: iq_nth_root(80,4) = 2
cki("nth_root_80_4", iq_nth_root(80, 4), 2)

// Additional nth_root
cki("nth_root_1_any", iq_nth_root(1, 3), 1)
cki("nth_root_0_3",   iq_nth_root(0, 3), 0)
cki("nth_root_81_4",  iq_nth_root(81, 4), 3)
cki("nth_root_64_2",  iq_nth_root(64, 2), 8)
cki("nth_root_64_6",  iq_nth_root(64, 6), 2)

// KAT: iq_is_perfect_square(16) = true
ckb("perfect_sq_16",   iq_is_perfect_square(16), true)

// KAT: iq_is_perfect_square(17) = false
ckb("perfect_sq_17",   iq_is_perfect_square(17), false)

// Additional perfect square
ckb("perfect_sq_0",    iq_is_perfect_square(0),  true)
ckb("perfect_sq_1",    iq_is_perfect_square(1),  true)
ckb("perfect_sq_4",    iq_is_perfect_square(4),  true)
ckb("perfect_sq_9",    iq_is_perfect_square(9),  true)
ckb("perfect_sq_15",   iq_is_perfect_square(15), false)
ckb("perfect_sq_100",  iq_is_perfect_square(100),true)

// KAT: iq_is_perfect_power(64) = true  (64 = 2^6 = 4^3 = 8^2)
ckb("perfect_pow_64",  iq_is_perfect_power(64), true)

// KAT: iq_is_perfect_power(63) = false
ckb("perfect_pow_63",  iq_is_perfect_power(63), false)

// KAT: iq_is_perfect_power(1) = false  (no m>=2, k>=2 satisfies m^k=1)
ckb("perfect_pow_1",   iq_is_perfect_power(1),  false)

// Additional perfect power
ckb("perfect_pow_4",   iq_is_perfect_power(4),  true)   // 2^2
ckb("perfect_pow_8",   iq_is_perfect_power(8),  true)   // 2^3
ckb("perfect_pow_9",   iq_is_perfect_power(9),  true)   // 3^2
ckb("perfect_pow_27",  iq_is_perfect_power(27), true)   // 3^3
ckb("perfect_pow_32",  iq_is_perfect_power(32), true)   // 2^5
ckb("perfect_pow_3",   iq_is_perfect_power(3),  false)
ckb("perfect_pow_2",   iq_is_perfect_power(2),  false)
ckb("perfect_pow_0",   iq_is_perfect_power(0),  false)

print("PASS _integer_sqrt_test")
