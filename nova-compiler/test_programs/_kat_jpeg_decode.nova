// KAT for std/media/jpeg — BASELINE SEQUENTIAL DCT JPEG decoder (jpeg_decode).
//
// TEST VECTORS were produced by Pillow/libjpeg (PIL 12.0.0), the authoritative
// reference JPEG codec, and embedded here as literal byte arrays. For each
// image PIL encoded a baseline (progressive=False, optimize=False) JPEG; the
// exact file bytes are the JPEGBYTES literals. The EXPECTED decoded pixels are:
//   * solid-colour images  -> the known input colour. JPEG on a flat 8x8 block
//     leaves only the DC coefficient non-zero, so the round-trip is exact up
//     to quantisation of that one coefficient -> within a couple of units.
//   * gradient images       -> PIL's OWN decode of that same JPEG file (i.e.
//     libjpeg's islow integer IDCT), embedded as REFPIX. Our separable float
//     IDCT must match libjpeg within a small documented tolerance.
//
// TOLERANCE: asserted per channel as |ours - expected| <= TOL. Solid and
// 4:4:4 cases use TOL=3/4 (observed maxdev 0..1) — that residue is float-IDCT
// vs integer-IDCT rounding plus YCbCr->RGB rounding. The two SUBSAMPLED
// gradients (4:2:0 / 4:2:2) use TOL=20 (observed 13 / 7): we chroma-upsample
// by nearest-neighbour (box) whereas libjpeg uses 'fancy' triangle upsampling,
// so a varying chroma field legitimately differs by ~a dozen units. That is an
// upsampling-METHOD difference, NOT a decode error — the solid 4:2:0/4:2:2
// cases (maxdev 0..1) prove the subsampled plumbing itself is exact. Every
// case prints its actual maxdev; a broken decoder blows far past TOL.
//
// COVERAGE: grayscale (1-comp) + YCbCr (3-comp); 4:4:4 / 4:2:2 / 4:2:0
// subsampling; AC coefficient decode (gradient); partial MCUs (dims not a
// multiple of 8, with cropping); DRI restart markers; and several err() paths
// (non-JPEG, truncated, SOI-only, progressive SOF2). Any failure aborts via
// assert(); on full success it prints exactly 'JPEG-DECODE KAT PASS'.
import std/media/jpeg

fn bytes_of(lst)
    let b = bytes(0)
    let i = 0
    while i < len(lst)
        b = bytes_append(b, lst[i])
        i = i + 1
    return b

// Decode `res`, assert dims/channels/length, then assert the max per-channel
// deviation from `expected` is within `tol`. Prints the actual max deviation.
fn check_img(label, res: Result, ew, eh, ech, expected, tol)
    match res
        Ok(v) =>
            assert(v["width"] == ew, label + ": width mismatch")
            assert(v["height"] == eh, label + ": height mismatch")
            assert(v["channels"] == ech, label + ": channels mismatch")
            let px = v["pixels"]
            let plen = bytes_len(px)
            assert(plen == len(expected), label + ": pixel length mismatch")
            let maxdev = 0
            let i = 0
            while i < plen
                let got = bytes_get(px, i)
                let exp = expected[i]
                let d = got - exp
                if d < 0
                    d = 0 - d
                if d > maxdev
                    maxdev = d
                i = i + 1
            print(label + ": maxdev=" + str(maxdev) + " tol=" + str(tol))
            assert(maxdev <= tol, label + ": deviation exceeds tolerance")
            return maxdev
        Err(e) =>
            assert(0 == 1, label + ": expected ok, got err: " + e)
            return 0 - 1

// Build a flat solid-colour expected pixel list (npx pixels of `color`).
fn solid_expected(npx, color)
    let e = []
    let i = 0
    while i < npx
        let c = 0
        while c < len(color)
            push(e, color[c])
            c = c + 1
        i = i + 1
    return e

// 1 iff decoding `d` returns Err (used to prove the err() paths never crash).
fn decode_is_err(d)
    let r = 1
    match jpeg_decode(d)
        Ok(v) =>
            r = 0
        Err(e) =>
            r = 1
    return r

// Adversary-found regression: keep a valid JPEG's header THROUGH the SOS segment, then
// replace the entropy-coded data with an immediate EOI (FF D9). The decoder used to accept
// this silently (ok + garbage pixels) because the truncation guard only checked EOF, not a
// latched marker. It MUST now err (a padding bit is consumed as coefficient data).
fn truncate_entropy_to_eoi(d)
    let n = bytes_len(d)
    let i = 0
    let sos_end = 0 - 1
    while i + 3 < n and sos_end < 0
        if bytes_get(d, i) == 255 and bytes_get(d, i + 1) == 218
            let seglen = bytes_get(d, i + 2) * 256 + bytes_get(d, i + 3)
            sos_end = i + 2 + seglen
        i = i + 1
    if sos_end < 0
        return d
    let out = bytes(0)
    let j = 0
    while j < sos_end
        out = bytes_append(out, bytes_get(d, j))
        j = j + 1
    out = bytes_append(out, 255)
    out = bytes_append(out, 217)
    return out

