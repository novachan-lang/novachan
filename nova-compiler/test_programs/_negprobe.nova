fn ineg(a: int) -> int
    -a
fn main()
    if ineg(7) != 0 - 7
        print("FAIL int neg")
        exit(1)
    if ineg(0) != 0
        print("FAIL neg 0")
        exit(1)
    let fs = [7.5]
    print(-fs[0])
    let x = 3.25
    print(-x)
    let d = {}
    d["p"] = 2.5
    print(-d["p"])
    let xs = [42]
    print(-xs[0])
    print("done-neg")
