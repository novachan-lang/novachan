// Track 8 channel soundness: a list that escapes via channel send must
// retain its data — escape analysis must NOT mark it as local, and RC
// elision must NOT skip the incref. Receiver iterates and verifies.

fn make_payload(n: int) -> list
    let xs = []
    let i = 0
    while i < n
        xs.push(i * 3)
        i = i + 1
    xs

fn worker(ch)
    let payload = make_payload(50)
    send(ch, payload)

fn main()
    let ch = channel()
    spawn worker(ch)
    let received = receive(ch)
    let total = 0
    let i = 0
    while i < len(received)
        total = total + received[i]
        i = i + 1
    print(total)
