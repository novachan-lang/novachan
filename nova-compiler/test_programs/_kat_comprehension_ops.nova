fn main()
    let xs = [1, 2, 3, 4]
    let c = [x * 2 for x in xs]
    print("literal len:   " + str(len([2,4,6,8])))
    print("comp    len:   " + str(len(c)))
    print("literal str:   " + str([2,4,6,8]))
    print("comp    str:   " + str(c))
    print("literal print:")
    print([2,4,6,8])
    print("comp print:")
    print(c)
    print("comp first:    " + str(c[0]))
    print("comp contains: " + str(contains(c, 4)))
    print("comp sorted:   " + str(sort(c)))
    print("comp rev:      " + str(reverse(c)))
    print("comp index_of: " + str(index_of(c, 6)))
    let total = 0
    for v in c
        total = total + v
    print("comp for-sum:  " + str(total))
