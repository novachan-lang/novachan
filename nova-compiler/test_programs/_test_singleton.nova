@singleton
type AppConfig
    debug: int
    version: string

@singleton
type DatabasePool
    max_conn: int

fn main()
    assert(AppConfig__is_singleton() == 1, "is singleton")
    assert(AppConfig__singleton_name() == "app_config", "singleton name")

    assert(DatabasePool__is_singleton() == 1, "pool is singleton")
    assert(DatabasePool__singleton_name() == "database_pool", "pool name")

    let cfg = AppConfig(1, "1.0")
    assert(cfg.debug == 1, "struct still works")
    assert(cfg.version == "1.0", "version field")

    print("SINGLETON ANNOTATION TEST PASS")
