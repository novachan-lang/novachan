// functional: dead-letter queue (poison-message sink) over the channel-based broker
import forge_mq

fn main()
    let b = mq_broker()
    mq_dead_letter(b, "jobs", "poison")
    if mq_pull(mq_dlq_consumer(b, "jobs")) != "poison"
        print("FAIL dlq")
        exit(1)
    mq_publish(b, "jobs", "ok")
    if mq_pull(mq_consumer(b, "jobs")) != "ok"
        print("FAIL normal queue unaffected by dlq")
        exit(1)
    mq_stop(b)
    print("PASS forge_mq_dlq")
