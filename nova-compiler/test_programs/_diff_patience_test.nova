// KAT for std/text/diff_patience
import std/text/diff_patience

// ── Helpers ──────────────────────────────────────────────────────────────────

fn _list_eq(a, b)
    if len(a) != len(b)
        return 0
    let i = 0
    while i < len(a)
        if a[i] != b[i]
            return 0
        i = i + 1
    return 1

fn _op_str(op)
    op[0] + op[1]

fn _script_str(script)
    let s = "["
    let i = 0
    while i < len(script)
        if i > 0
            s = s + ","
        s = s + _op_str(script[i])
        i = i + 1
    s = s + "]"
    s

fn _lines_str(lines)
    let s = "["
    let i = 0
    while i < len(lines)
        if i > 0
            s = s + ","
        s = s + lines[i]
        i = i + 1
    s = s + "]"
    s

// Check that patience_apply(a, patience_diff(a,b)) == b (round-trip).
fn check_roundtrip(a, b, label)
    let script = patience_diff(a, b)
    let got = patience_apply(a, script)
    if _list_eq(got, b) == 0
        print("FAIL diff_patience " + label + ": apply(diff(a,b),a) got=" + _lines_str(got) + " want=" + _lines_str(b))
        exit(1)

// Check script equality directly.
fn check_script(a, b, want_script, label)
    let got_script = patience_diff(a, b)
    // Also verify round-trip.
    let got = patience_apply(a, got_script)
    if _list_eq(got, b) == 0
        print("FAIL diff_patience " + label + " roundtrip: got=" + _lines_str(got) + " want=" + _lines_str(b))
        exit(1)
    // Verify script itself matches expected.
    if _list_eq(_script_str(got_script), _script_str(want_script)) == 0
        print("FAIL diff_patience " + label + " script: got=" + _script_str(got_script) + " want=" + _script_str(want_script))
        exit(1)

fn main()
    // ── KAT 1: identical inputs → all "=" ops ────────────────────────────────
    let a1 = []
    a1.push("foo")
    a1.push("bar")
    a1.push("baz")
    let b1 = []
    b1.push("foo")
    b1.push("bar")
    b1.push("baz")
    check_roundtrip(a1, b1, "KAT1-identical")

    // Verify all ops are "=".
    let s1 = patience_diff(a1, b1)
    let all_eq = 1
    let k = 0
    while k < len(s1)
        if s1[k][0] != "="
            all_eq = 0
        k = k + 1
    if all_eq == 0
        print("FAIL diff_patience KAT1-identical: not all = ops")
        exit(1)

    // ── KAT 2: empty a → all "+" ops ─────────────────────────────────────────
    let a2 = []
    let b2 = []
    b2.push("x")
    b2.push("y")
    check_roundtrip(a2, b2, "KAT2-empty-a")

    let s2 = patience_diff(a2, b2)
    let all_ins = 1
    let k2 = 0
    while k2 < len(s2)
        if s2[k2][0] != "+"
            all_ins = 0
        k2 = k2 + 1
    if all_ins == 0
        print("FAIL diff_patience KAT2-empty-a: not all + ops")
        exit(1)

    // ── KAT 3: empty b → all "-" ops ─────────────────────────────────────────
    let a3 = []
    a3.push("p")
    a3.push("q")
    let b3 = []
    check_roundtrip(a3, b3, "KAT3-empty-b")

    let s3 = patience_diff(a3, b3)
    let all_del = 1
    let k3 = 0
    while k3 < len(s3)
        if s3[k3][0] != "-"
            all_del = 0
        k3 = k3 + 1
    if all_del == 0
        print("FAIL diff_patience KAT3-empty-b: not all - ops")
        exit(1)

    // ── KAT 4: both empty → empty script ─────────────────────────────────────
    let a4 = []
    let b4 = []
    let s4 = patience_diff(a4, b4)
    if len(s4) != 0
        print("FAIL diff_patience KAT4-both-empty: script not empty")
        exit(1)

    // ── KAT 5: move — ["1","2","3","4"] -> ["1","3","2","4"] ─────────────────
    // unique anchors: "1" at (0,0), "2" at (1,2), "3" at (2,1), "4" at (3,3)
    // patience finds unique lines; LCS of anchors by b-pos: "1"->0,"3"->1,"4"->3
    // so "2" is treated as a delete+insert. Round-trip must reconstruct b.
    let a5 = []
    a5.push("1")
    a5.push("2")
    a5.push("3")
    a5.push("4")
    let b5 = []
    b5.push("1")
    b5.push("3")
    b5.push("2")
    b5.push("4")
    check_roundtrip(a5, b5, "KAT5-move")

    // ── KAT 6: unique anchor preserved + surrounding noise ────────────────────
    // a = ["common","x","ANCHOR","y"]  b = ["z","ANCHOR","w"]
    // "ANCHOR" appears exactly once in each → patience anchors on it.
    // Round-trip must reconstruct b.
    let a6 = []
    a6.push("common")
    a6.push("x")
    a6.push("ANCHOR")
    a6.push("y")
    let b6 = []
    b6.push("z")
    b6.push("ANCHOR")
    b6.push("w")
    check_roundtrip(a6, b6, "KAT6-unique-anchor")

    // Verify ANCHOR appears as "=" in the script.
    let s6 = patience_diff(a6, b6)
    let anchor_eq = 0
    let k6 = 0
    while k6 < len(s6)
        if s6[k6][0] == "=" and s6[k6][1] == "ANCHOR"
            anchor_eq = 1
        k6 = k6 + 1
    if anchor_eq == 0
        print("FAIL diff_patience KAT6-unique-anchor: ANCHOR not preserved as =")
        exit(1)

    // ── KAT 7: full replacement ───────────────────────────────────────────────
    // a = ["aaa","bbb"]  b = ["xxx","yyy"] — no common lines.
    let a7 = []
    a7.push("aaa")
    a7.push("bbb")
    let b7 = []
    b7.push("xxx")
    b7.push("yyy")
    check_roundtrip(a7, b7, "KAT7-full-replace")

    // ── KAT 8: insert at start ────────────────────────────────────────────────
    let a8 = []
    a8.push("b")
    a8.push("c")
    let b8 = []
    b8.push("a")
    b8.push("b")
    b8.push("c")
    check_roundtrip(a8, b8, "KAT8-insert-start")

    // ── KAT 9: delete from middle ─────────────────────────────────────────────
    let a9 = []
    a9.push("alpha")
    a9.push("beta")
    a9.push("gamma")
    let b9 = []
    b9.push("alpha")
    b9.push("gamma")
    check_roundtrip(a9, b9, "KAT9-delete-middle")

    // ── KAT 10: multiple unique anchors, gaps filled by LCS fallback ──────────
    // a = ["A","x","B","y","C"]  b = ["A","p","q","B","r","C"]
    // A, B, C are unique in both → anchors. Gaps: [] vs ["p","q"] (insert),
    // ["x"] vs [] (delete), ["y"] vs ["r"] (replace).
    let a10 = []
    a10.push("A")
    a10.push("x")
    a10.push("B")
    a10.push("y")
    a10.push("C")
    let b10 = []
    b10.push("A")
    b10.push("p")
    b10.push("q")
    b10.push("B")
    b10.push("r")
    b10.push("C")
    check_roundtrip(a10, b10, "KAT10-multi-anchor")

    // Verify A, B, C are all "=".
    let s10 = patience_diff(a10, b10)
    let abc_count = 0
    let k10 = 0
    while k10 < len(s10)
        let op10 = s10[k10]
        if op10[0] == "="
            if op10[1] == "A" or op10[1] == "B" or op10[1] == "C"
                abc_count = abc_count + 1
        k10 = k10 + 1
    if abc_count != 3
        print("FAIL diff_patience KAT10-multi-anchor: A/B/C not all preserved as =, count=" + str(abc_count))
        exit(1)

    print("PASS _diff_patience_test")
