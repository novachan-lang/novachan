@validate
type User
    name: string
    email: string

@validate
type Product
    title: string
    sku: string
    price: int

fn main()
    assert(User__has_validation() == 1, "has validation")
    assert(User__validate_fields() == "name:string, email:string", "fields")
    assert(User__field_count() == 2, "field count")

    assert(Product__has_validation() == 1, "product has validation")
    assert(Product__validate_fields() == "title:string, sku:string, price:int", "product fields")
    assert(Product__field_count() == 3, "product field count")

    let u = User("Alice", "alice@example.com")
    assert(u.name == "Alice", "struct works")

    print("VALIDATE ANNOTATION TEST PASS")
