import forge_routing_table

fn main()
    let r = rtbl_new()
    r = rtbl_add(r, "/api/", "api_handler")
    r = rtbl_add(r, "/api/users", "users_handler")
    r = rtbl_add(r, "/static/", "static_handler")
    assert(rtbl_route_count(r) == 3, "3 routes")

    let r1 = rtbl_lookup(r, "/api/users/123")
    assert(is_ok(r1), "lookup ok")
    assert(unwrap(r1) == "users_handler", "longest match")

    let r2 = rtbl_lookup(r, "/api/orders")
    assert(is_ok(r2), "orders ok")
    assert(unwrap(r2) == "api_handler", "api prefix")

    let r3 = rtbl_lookup(r, "/static/img.png")
    assert(unwrap(r3) == "static_handler", "static match")

    let r4 = rtbl_lookup(r, "/unknown")
    assert(is_err(r4), "no match")

    assert(rtbl_total_lookups(r) == 4, "4 lookups")
    assert(rtbl_match_count(r) == 3, "3 matches")

    print("ROUTING-TABLE KAT PASS")
