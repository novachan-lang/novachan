import prism_ui_chip
import prism_node

fn main()
    let mut total = 0
    let mut passed = 0

    // -- prism_ch_chip -----------------------------------------------------
    total += 1
    let r1 = prism_ui_chip.prism_ch_chip("Sports")
    if is_ok(r1)
        passed += 1
    else
        print("FAIL 1: prism_ch_chip(\"Sports\") should be ok")

    total += 1
    let n1 = unwrap(r1)
    if prism_node.prism_node_kind_str(n1) == "label"
        passed += 1
    else
        print("FAIL 2: chip kind expected label, got " + prism_node.prism_node_kind_str(n1))

    total += 1
    let r2 = prism_ui_chip.prism_ch_chip("")
    if is_err(r2)
        passed += 1
    else
        print("FAIL 3: prism_ch_chip(\"\") should be err")

    total += 1
    if unwrap_err(r2) == "prism_ch_chip: text must not be empty"
        passed += 1
    else
        print("FAIL 4: chip empty error message mismatch: " + unwrap_err(r2))

    // -- prism_ch_dismissible ------------------------------------------------
    total += 1
    let r3 = prism_ui_chip.prism_ch_dismissible("Sports")
    if is_ok(r3)
        passed += 1
    else
        print("FAIL 5: prism_ch_dismissible(\"Sports\") should be ok")

    let n3 = unwrap(r3)
    total += 1
    if prism_node.prism_node_kind_str(n3) == "band"
        passed += 1
    else
        print("FAIL 6: dismissible kind expected band, got " + prism_node.prism_node_kind_str(n3))

    let kids3 = prism_node.prism_node_children(n3)
    total += 1
    if len(kids3) == 2
        passed += 1
    else
        print("FAIL 7: dismissible expected 2 children, got " + str(len(kids3)))

    total += 1
    if prism_node.prism_node_kind_str(kids3[0]) == "label"
        passed += 1
    else
        print("FAIL 8: dismissible child 0 expected label, got " + prism_node.prism_node_kind_str(kids3[0]))

    total += 1
    let r4 = prism_ui_chip.prism_ch_dismissible("")
    if is_err(r4)
        passed += 1
    else
        print("FAIL 9: prism_ch_dismissible(\"\") should be err")

    total += 1
    if unwrap_err(r4) == "prism_ch_dismissible: text must not be empty"
        passed += 1
    else
        print("FAIL 10: dismissible empty error message mismatch: " + unwrap_err(r4))

    // -- prism_ch_group -------------------------------------------------------
    total += 1
    let r5 = prism_ui_chip.prism_ch_group(["A", "B", "C"])
    if is_ok(r5)
        passed += 1
    else
        print("FAIL 11: prism_ch_group([A,B,C]) should be ok")

    let n5 = unwrap(r5)
    total += 1
    if prism_node.prism_node_kind_str(n5) == "flow"
        passed += 1
    else
        print("FAIL 12: group kind expected flow, got " + prism_node.prism_node_kind_str(n5))

    let kids5 = prism_node.prism_node_children(n5)
    total += 1
    if len(kids5) == 3
        passed += 1
    else
        print("FAIL 13: group expected 3 children, got " + str(len(kids5)))

    total += 1
    if prism_node.prism_node_kind_str(kids5[0]) == "label"
        passed += 1
    else
        print("FAIL 14: group child 0 expected label, got " + prism_node.prism_node_kind_str(kids5[0]))

    total += 1
    let r6 = prism_ui_chip.prism_ch_group([])
    if is_err(r6)
        passed += 1
    else
        print("FAIL 15: prism_ch_group([]) should be err")

    total += 1
    if unwrap_err(r6) == "prism_ch_group: labels must not be empty"
        passed += 1
    else
        print("FAIL 16: group empty error message mismatch: " + unwrap_err(r6))

    total += 1
    let r7 = prism_ui_chip.prism_ch_group(["A", ""])
    if is_err(r7)
        passed += 1
    else
        print("FAIL 17: prism_ch_group([A,\"\"]) should be err")

    total += 1
    if unwrap_err(r7) == "prism_ch_group: element 1 is empty"
        passed += 1
    else
        print("FAIL 18: group empty element error mismatch: " + unwrap_err(r7))

    // -- prism_ch_filter_group -------------------------------------------------
    total += 1
    let r8 = prism_ui_chip.prism_ch_filter_group(["X", "Y"])
    if is_ok(r8)
        passed += 1
    else
        print("FAIL 19: prism_ch_filter_group([X,Y]) should be ok")

    let n8 = unwrap(r8)
    total += 1
    if prism_node.prism_node_kind_str(n8) == "flow"
        passed += 1
    else
        print("FAIL 20: filter_group kind expected flow, got " + prism_node.prism_node_kind_str(n8))

    let kids8 = prism_node.prism_node_children(n8)
    total += 1
    if len(kids8) == 2
        passed += 1
    else
        print("FAIL 21: filter_group expected 2 children, got " + str(len(kids8)))

    total += 1
    if prism_node.prism_node_kind_str(kids8[0]) == "band"
        passed += 1
    else
        print("FAIL 22: filter_group child 0 expected band, got " + prism_node.prism_node_kind_str(kids8[0]))

    let inner8 = prism_node.prism_node_children(kids8[0])
    total += 1
    if len(inner8) == 2
        passed += 1
    else
        print("FAIL 23: filter_group child 0 (band) expected 2 children, got " + str(len(inner8)))

    total += 1
    let r9 = prism_ui_chip.prism_ch_filter_group([])
    if is_err(r9)
        passed += 1
    else
        print("FAIL 24: prism_ch_filter_group([]) should be err")

    total += 1
    if unwrap_err(r9) == "prism_ch_filter_group: labels must not be empty"
        passed += 1
    else
        print("FAIL 25: filter_group empty error message mismatch: " + unwrap_err(r9))

    total += 1
    let r10 = prism_ui_chip.prism_ch_filter_group(["Z", ""])
    if is_err(r10)
        passed += 1
    else
        print("FAIL 26: prism_ch_filter_group([Z,\"\"]) should be err")

    total += 1
    if unwrap_err(r10) == "prism_ch_filter_group: element 1 is empty"
        passed += 1
    else
        print("FAIL 27: filter_group empty element error mismatch: " + unwrap_err(r10))

    // -- attribute default fallback -------------------------------------------
    total += 1
    if prism_node.prism_node_attr_str(n1, "nonexistent_key_xyz", "fallback") == "fallback"
        passed += 1
    else
        print("FAIL 28: attr_str default fallback mismatch")

    print(str(passed) + "/" + str(total) + " assertions passed")
    if passed != total
        print("FAIL: " + str(total - passed) + " assertion(s) failed")
