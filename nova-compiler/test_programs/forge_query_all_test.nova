// forge_query_all_test -- query_all returns EVERY value for a repeated query key (in order), the way to read
// a multi-select / checkbox form (?tag=a&tag=b&tag=c) since query_get returns only the first. Exact key
// match (no prefix shadowing); absent key -> empty list. Pure string parsing.
import forge

fn main()
    // all values for a repeated key, in order
    let r = forge.query_all("GET /p?tag=a&tag=b&tag=c HTTP/1.1\r\n\r\n", "tag")
    if len(r) != 3
        print("FAIL: expected 3 values, got " + str(len(r)))
        exit(1)
    if r[0] != "a" or r[1] != "b" or r[2] != "c"
        print("FAIL: values/order wrong")
        exit(1)

    // interleaved with other keys -> only the matching ones, in order
    let r2 = forge.query_all("GET /p?x=1&tag=a&y=2&tag=b HTTP/1.1\r\n\r\n", "tag")
    if len(r2) != 2 or r2[0] != "a" or r2[1] != "b"
        print("FAIL: interleaved keys")
        exit(1)

    // single value
    let r3 = forge.query_all("GET /p?tag=only HTTP/1.1\r\n\r\n", "tag")
    if len(r3) != 1 or r3[0] != "only"
        print("FAIL: single value")
        exit(1)

    // absent key -> empty list
    let r4 = forge.query_all("GET /p?x=1 HTTP/1.1\r\n\r\n", "tag")
    if len(r4) != 0
        print("FAIL: absent key should be empty list")
        exit(1)

    // exact match: a key with the target as a prefix/substring must NOT match
    let r5 = forge.query_all("GET /p?xtag=1&tag=real HTTP/1.1\r\n\r\n", "tag")
    if len(r5) != 1 or r5[0] != "real"
        print("FAIL: prefix key xtag wrongly matched tag")
        exit(1)

    print("PASS forge_query_all (all values for a repeated key, in order, exact-match, absent->[])")
