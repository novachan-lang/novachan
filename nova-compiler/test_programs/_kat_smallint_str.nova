// KAT: str(n) must survive CONCATENATION for every n, including the 0..9999 range that
// nova_rt_int_to_str serves from a static cache instead of a heap string.
//
// This is a LINUX-only regression guard written from a real failure: nova_is_readable_str
// falls through to a module-range test for header-less pointers, and on Linux that test
// accepts only NON-WRITABLE PT_LOAD segments -- but the small-int cache lives in .bss.
// Every str(n) with n < 10000 was therefore judged "not a string" and silently became "",
// so `"count = " + str(42)` printed `count = ` on Linux while working on Windows. The CI
// runs on Windows, which is exactly why it went unseen. Direct print(str(n)) still worked,
// so only the concatenating paths -- i.e. most log lines and error messages -- were wrong.
fn ident(x: int) -> int
    x

fn main()
    let ok = 0
    let fail = 0

    // constant-folded, cached range
    if ("[" + str(42) + "]") == "[42]"
        ok = ok + 1
    else
        fail = fail + 1
        print("FAIL const small: [" + str(42) + "]")

    // runtime value, cached range
    let n = ident(7)
    if ("[" + str(n) + "]") == "[7]"
        ok = ok + 1
    else
        fail = fail + 1
        print("FAIL runtime small")

    // both sides of the cache boundary
    if ("[" + str(9999) + "]") == "[9999]" and ("[" + str(10000) + "]") == "[10000]"
        ok = ok + 1
    else
        fail = fail + 1
        print("FAIL boundary 9999/10000")

    // uncached range, and zero/negative
    if ("[" + str(2000000) + "]") == "[2000000]" and ("[" + str(0) + "]") == "[0]" and ("[" + str(-5) + "]") == "[-5]"
        ok = ok + 1
    else
        fail = fail + 1
        print("FAIL large/zero/negative")

    // len() of a cached string must also be right (it reads through the same path)
    if len(str(42)) == 2 and len(str(7)) == 1
        ok = ok + 1
    else
        fail = fail + 1
        print("FAIL len of cached str")

    // string ops other than concat on a cached string
    if upper(str(42)) == "42" and contains(str(1234), "23")
        ok = ok + 1
    else
        fail = fail + 1
        print("FAIL string ops on cached str")

    print("ok=" + str(ok) + " fail=" + str(fail))
    assert(fail == 0, "smallint_str: all checks pass")
    assert(ok == 6, "smallint_str: all 6 checks ran")
    print("KAT smallint_str PASS")
