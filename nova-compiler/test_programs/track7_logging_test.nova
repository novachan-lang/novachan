import logging

fn main()
    // Create default config
    let cfg = logging.log_config()

    // Log level names
    assert_eq(logging.log_level_name(0), "TRACE")
    assert_eq(logging.log_level_name(2), "INFO")
    assert_eq(logging.log_level_name(4), "ERROR")

    // Set level
    let cfg2 = logging.log_set_level(cfg, 2)

    // Format a message
    let fields = {}
    fields["user"] = "admin"
    let human = logging.log_human_format(2, "test message", fields)
    if find(human, "test message") < 0
        print("FAIL: human format missing message")
        exit(1)

    let jfmt = logging.log_json_format(2, "test event", fields)
    if find(jfmt, "test event") < 0
        print("FAIL: json format missing message")
        exit(1)

    // Level-specific logging
    let out = logging.log_info(cfg2, "server started", fields)
    if find(out, "server started") < 0
        print("FAIL: log_info missing message")
        exit(1)

    // Below-level messages should be empty
    let trace_out = logging.log_trace(cfg2, "trace msg", fields)
    assert_eq(trace_out, "")

    print("TRACK 7 LOGGING TEST PASSED")
