// KAT test for std/compress/golomb
// Tests: Rice encode bitstrings, round-trip decode, list encode/decode,
//        Golomb encode/decode, and cross-k round-trips.
import std/compress/golomb

// ── Helpers ───────────────────────────────────────────────────────────────────

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ── KAT 1: glm_rice_encode known bitstrings (k=2) ────────────────────────────
// n=0: q=0,r=0 -> unary="0", rem="00" -> "000"
cks("rice_enc_0_k2", glm_rice_encode(0, 2), "000")
// n=1: q=0,r=1 -> unary="0", rem="01" -> "001"
cks("rice_enc_1_k2", glm_rice_encode(1, 2), "001")
// n=5: q=1,r=1 -> unary="10", rem="01" -> "1001"
cks("rice_enc_5_k2", glm_rice_encode(5, 2), "1001")
// n=10: q=2,r=2 -> unary="110", rem="10" -> "11010"
cks("rice_enc_10_k2", glm_rice_encode(10, 2), "11010")
// n=20: q=5,r=0 -> unary="111110", rem="00" -> "11111000"
cks("rice_enc_20_k2", glm_rice_encode(20, 2), "11111000")

// ── KAT 2: glm_rice_encode known bitstrings (k=3) ────────────────────────────
// n=0: q=0,r=0 -> "0"+"000" -> "0000"
cks("rice_enc_0_k3", glm_rice_encode(0, 3), "0000")
// n=5: q=0,r=5 -> "0"+"101" -> "0101"
cks("rice_enc_5_k3", glm_rice_encode(5, 3), "0101")
// n=10: q=1,r=2 -> "10"+"010" -> "10010"
cks("rice_enc_10_k3", glm_rice_encode(10, 3), "10010")
// n=20: q=2,r=4 -> "110"+"100" -> "110100"
cks("rice_enc_20_k3", glm_rice_encode(20, 3), "110100")

// ── KAT 3: glm_rice_encode k=0 (pure unary) ──────────────────────────────────
// k=0: no remainder bits; n=3 -> q=3 -> "1110"
cks("rice_enc_3_k0", glm_rice_encode(3, 0), "1110")

// ── KAT 4: round-trip k=2 via glm_rice_decode ────────────────────────────────
// glm_rice_decode decodes from position 0; [value, next_pos]
let rt0k2 = glm_rice_decode(glm_rice_encode(0, 2), 2)
cki("rt_0_k2_val",  rt0k2[0], 0)
cki("rt_0_k2_pos",  rt0k2[1], 3)

let rt1k2 = glm_rice_decode(glm_rice_encode(1, 2), 2)
cki("rt_1_k2_val",  rt1k2[0], 1)

let rt5k2 = glm_rice_decode(glm_rice_encode(5, 2), 2)
cki("rt_5_k2_val",  rt5k2[0], 5)

let rt10k2 = glm_rice_decode(glm_rice_encode(10, 2), 2)
cki("rt_10_k2_val", rt10k2[0], 10)

let rt20k2 = glm_rice_decode(glm_rice_encode(20, 2), 2)
cki("rt_20_k2_val", rt20k2[0], 20)

// ── KAT 5: round-trip k=3 ────────────────────────────────────────────────────
let rt0k3 = glm_rice_decode(glm_rice_encode(0, 3), 3)
cki("rt_0_k3_val",  rt0k3[0], 0)

let rt1k3 = glm_rice_decode(glm_rice_encode(1, 3), 3)
cki("rt_1_k3_val",  rt1k3[0], 1)

let rt5k3 = glm_rice_decode(glm_rice_encode(5, 3), 3)
cki("rt_5_k3_val",  rt5k3[0], 5)

let rt10k3 = glm_rice_decode(glm_rice_encode(10, 3), 3)
cki("rt_10_k3_val", rt10k3[0], 10)

let rt20k3 = glm_rice_decode(glm_rice_encode(20, 3), 3)
cki("rt_20_k3_val", rt20k3[0], 20)

// ── KAT 6: glm_encode_list + glm_decode_list round-trip ──────────────────────
// [1,2,3] at k=2:
//   encode(1,2)="001", encode(2,2)="010", encode(3,2)="011"
//   concatenated = "001010011"
let xs123 = []
xs123.push(1)
xs123.push(2)
xs123.push(3)
let bits123 = glm_encode_list(xs123, 2)
cks("enc_list_1_2_3_k2", bits123, "001010011")
let dec123 = glm_decode_list(bits123, 2, 3)
cki("dec_list_1_k2", dec123[0], 1)
cki("dec_list_2_k2", dec123[1], 2)
cki("dec_list_3_k2", dec123[2], 3)

// ── KAT 7: glm_encode_list empty list ────────────────────────────────────────
let xs_empty = []
let bits_empty = glm_encode_list(xs_empty, 2)
cks("enc_list_empty", bits_empty, "")
let dec_empty = glm_decode_list(bits_empty, 2, 0)
cki("dec_list_empty_len", len(dec_empty), 0)

// ── KAT 8: list round-trip with k=3 for larger values ────────────────────────
let xs_big = []
xs_big.push(0)
xs_big.push(7)
xs_big.push(15)
xs_big.push(20)
let bits_big = glm_encode_list(xs_big, 3)
let dec_big = glm_decode_list(bits_big, 3, 4)
cki("rt_list_0_k3",  dec_big[0], 0)
cki("rt_list_7_k3",  dec_big[1], 7)
cki("rt_list_15_k3", dec_big[2], 15)
cki("rt_list_20_k3", dec_big[3], 20)

// ── KAT 9: Golomb with m=4 (power of two, same as Rice k=2) ──────────────────
// m=4=2^2 so b=2, cutoff=0; all remainders use 2-bit encoding -> same as Rice k=2
cks("golomb_enc_0_m4",  glm_golomb_encode(0, 4),  "000")
cks("golomb_enc_5_m4",  glm_golomb_encode(5, 4),  "1001")
cks("golomb_enc_10_m4", glm_golomb_encode(10, 4), "11010")

// ── KAT 10: Golomb round-trip with m=3 ───────────────────────────────────────
// m=3: b=2, cutoff=1
//   n=0: q=0,r=0 -> r<1 -> "0"+"0"  = "00"   (1-bit rem)
//   n=1: q=0,r=1 -> r>=1 -> "0"+"10" = "010"  (2-bit: r+cutoff=2 -> "10")
//   n=2: q=0,r=2 -> r>=1 -> "0"+"11" = "011"  (r+cutoff=3 -> "11")
//   n=3: q=1,r=0 -> "10"+"0" = "100"
cks("golomb_enc_0_m3", glm_golomb_encode(0, 3), "00")
cks("golomb_enc_1_m3", glm_golomb_encode(1, 3), "010")
cks("golomb_enc_2_m3", glm_golomb_encode(2, 3), "011")
cks("golomb_enc_3_m3", glm_golomb_encode(3, 3), "100")

let gd0m3 = glm_golomb_decode(glm_golomb_encode(0, 3), 3)
cki("golomb_rt_0_m3", gd0m3[0], 0)
let gd1m3 = glm_golomb_decode(glm_golomb_encode(1, 3), 3)
cki("golomb_rt_1_m3", gd1m3[0], 1)
let gd2m3 = glm_golomb_decode(glm_golomb_encode(2, 3), 3)
cki("golomb_rt_2_m3", gd2m3[0], 2)
let gd6m3 = glm_golomb_decode(glm_golomb_encode(6, 3), 3)
cki("golomb_rt_6_m3", gd6m3[0], 6)
let gd9m3 = glm_golomb_decode(glm_golomb_encode(9, 3), 3)
cki("golomb_rt_9_m3", gd9m3[0], 9)

// ── KAT 11: Golomb round-trip with m=5 ───────────────────────────────────────
let gd0m5  = glm_golomb_decode(glm_golomb_encode(0, 5), 5)
cki("golomb_rt_0_m5", gd0m5[0], 0)
let gd4m5  = glm_golomb_decode(glm_golomb_encode(4, 5), 5)
cki("golomb_rt_4_m5", gd4m5[0], 4)
let gd10m5 = glm_golomb_decode(glm_golomb_encode(10, 5), 5)
cki("golomb_rt_10_m5", gd10m5[0], 10)
let gd17m5 = glm_golomb_decode(glm_golomb_encode(17, 5), 5)
cki("golomb_rt_17_m5", gd17m5[0], 17)

print("_golomb_test passed")
