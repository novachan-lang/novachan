// SQLite end-to-end through NOVA's FFI surface. This is the first
// substantive use of @opaque + out<T> + @link + @repr-style handles
// against a REAL C library (the bundled sqlite3.c amalgamation).
//
// Workflow: open in-memory DB → CREATE TABLE → INSERT → SELECT → close.
// Verifies that the FFI machinery survives a non-toy C API.

@opaque
type DbHandle

@opaque
type StmtHandle

extern fn sqlite3_open(path: string, db_out: out<DbHandle>) -> i32
extern fn sqlite3_close(db: DbHandle) -> i32
extern fn sqlite3_exec(db: DbHandle, sql: string, cb: int, ctx: int, errmsg_out: int) -> i32
extern fn sqlite3_prepare_v2(db: DbHandle, sql: string, nbyte: i32, stmt_out: out<StmtHandle>, tail_out: int) -> i32
extern fn sqlite3_step(stmt: StmtHandle) -> i32
extern fn sqlite3_column_int(stmt: StmtHandle, col: i32) -> i32
extern fn sqlite3_column_text(stmt: StmtHandle, col: i32) -> int  // returns const unsigned char*
extern fn sqlite3_finalize(stmt: StmtHandle) -> i32

fn main()
    // SQLite status codes inlined (top-level lets may not be visible here).
    let SQLITE_ROW = 100
    let SQLITE_DONE = 101

    let db = 0
    let rc = unsafe sqlite3_open(":memory:", db)
    assert_eq(rc, 0)

    let create_rc = unsafe sqlite3_exec(db, "CREATE TABLE users (id INTEGER, name TEXT)", 0, 0, 0)
    assert_eq(create_rc, 0)

    let insert_rc = unsafe sqlite3_exec(db, "INSERT INTO users VALUES (1, 'alice'), (2, 'bob'), (3, 'carol')", 0, 0, 0)
    assert_eq(insert_rc, 0)

    let stmt = 0
    let prep_rc = unsafe sqlite3_prepare_v2(db, "SELECT id, name FROM users ORDER BY id", -1, stmt, 0)
    assert_eq(prep_rc, 0)

    let rows = []
    let step_rc = unsafe sqlite3_step(stmt)
    while step_rc == SQLITE_ROW
        let id = unsafe sqlite3_column_int(stmt, 0)
        let name_ptr = unsafe sqlite3_column_text(stmt, 1)
        let name = cstr_to_string(name_ptr)
        push(rows, [id, name])
        step_rc = unsafe sqlite3_step(stmt)
    assert_eq(step_rc, SQLITE_DONE)
    assert_eq(len(rows), 3)
    assert_eq(rows[0][0], 1)
    assert_eq(rows[0][1], "alice")
    assert_eq(rows[1][0], 2)
    assert_eq(rows[1][1], "bob")
    assert_eq(rows[2][0], 3)
    assert_eq(rows[2][1], "carol")

    let fin_rc = unsafe sqlite3_finalize(stmt)
    assert_eq(fin_rc, 0)
    let close_rc = unsafe sqlite3_close(db)
    assert_eq(close_rc, 0)

    print("sqlite demo passed: opened in-memory DB, created table, inserted 3 rows, queried back via prepare/step/column, closed")
