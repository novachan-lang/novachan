// KAT test for std/encoding/hexdump
import std/encoding/hexdump

// ── Helper: build a bytes value from a plain ASCII string ────────────────────
// bytes_append_str appends the string bytes (NUL-terminated so no 0x00 issues
// for printable ASCII). We use byte-at-a-time to be explicit.
fn _bytes(s) -> any
    let b = bytes(0)
    let i = 0
    while i < len(s)
        b = bytes_append(b, ord(s[i]))
        i = i + 1
    b

// ── Assertion helpers ─────────────────────────────────────────────────────────
fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=[" + got + "] expected=[" + expected + "]")
        exit(1)

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

fn ck_starts(label, got, prefix)
    let plen = len(prefix)
    if len(got) < plen
        print("FAIL " + label + ": got=[" + got + "] does not start with [" + prefix + "]")
        exit(1)
    let actual_start = slice(got, 0, plen)
    if actual_start != prefix
        print("FAIL " + label + ": got=[" + got + "] does not start with [" + prefix + "]")
        exit(1)

fn ck_contains(label, got, needle)
    let glen = len(got)
    let nlen = len(needle)
    let found = 0
    let i = 0
    while i <= glen - nlen
        let chunk = slice(got, i, i + nlen)
        if chunk == needle
            found = 1
        i = i + 1
    if found == 0
        print("FAIL " + label + ": [" + got + "] does not contain [" + needle + "]")
        exit(1)

// ── KAT 1: hd_hexline of "Hi" (bytes 0x48, 0x69) ────────────────────────────
let b_hi = _bytes("Hi")
cks("hexline_hi", hd_hexline(b_hi), "48 69")

// ── KAT 2: hd_dump first line starts with correct offset+hex ─────────────────
let dump_hi = hd_dump(b_hi)
ck_starts("dump_hi_offset", dump_hi, "00000000  48 69")

// ── KAT 3: hd_dump contains the ASCII gutter "|Hi|" ─────────────────────────
ck_contains("dump_hi_ascii", dump_hi, "|Hi|")

// ── KAT 4: NUL byte (0x00) shows as "." in the ASCII gutter ─────────────────
// Build bytes: [65=0x41 'A', 0=0x00 NUL, 66=0x42 'B']
let b_nul = bytes(0)
b_nul = bytes_append(b_nul, 65)
b_nul = bytes_append(b_nul, 0)
b_nul = bytes_append(b_nul, 66)
let dump_nul = hd_dump(b_nul)
// ASCII gutter must be "|A.B|" — the NUL becomes '.'
ck_contains("dump_nul_ascii_gutter", dump_nul, "|A.B|")
// Hex portion must show "41 00 42"
ck_contains("dump_nul_hex", dump_nul, "41 00 42")

// ── KAT 5: 17 bytes → exactly 2 lines (one chr(10) in the dump) ─────────────
// Build 17 bytes with value i+1 each
let b17 = bytes(0)
let fill = 0
while fill < 17
    b17 = bytes_append(b17, (fill + 1) & 0xFF)
    fill = fill + 1
let dump17 = hd_dump(b17)
// First line must start at offset 00000000, second at 00000010 (16 decimal)
ck_starts("dump17_row0", dump17, "00000000  01 02 03")
ck_contains("dump17_row1_offset", dump17, "00000010")
// Exactly one newline character
let nl_count = 0
let ci = 0
while ci < len(dump17)
    if ord(dump17[ci]) == 10
        nl_count = nl_count + 1
    ci = ci + 1
cki("dump17_newline_count", nl_count, 1)

// ── KAT 6: empty bytes → "" ──────────────────────────────────────────────────
let b_empty = bytes(0)
cks("dump_empty", hd_dump(b_empty), "")
cks("hexline_empty", hd_hexline(b_empty), "")

// ── KAT 7: hd_hexline of 3 known bytes ──────────────────────────────────────
// Bytes: [0x00, 0xFF, 0x10]
let b3 = bytes(0)
b3 = bytes_append(b3, 0)
b3 = bytes_append(b3, 255)
b3 = bytes_append(b3, 16)
cks("hexline_3bytes", hd_hexline(b3), "00 ff 10")

// ── KAT 8: hd_dump padded short line ends with the ASCII gutter ─────────────
// 2 bytes → gutter should be "|Hi|" (4 chars: pipe H i pipe)
// Line must end with "|Hi|"
let dump_end = slice(dump_hi, len(dump_hi) - 4, len(dump_hi))
cks("dump_hi_ends_with_gutter", dump_end, "|Hi|")

print("_hexdump_test passed")
