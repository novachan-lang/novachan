import std/os/hexdump

// Helper: assert string contains substring
fn ck_contains(label: string, haystack: string, needle: string)
    let hn = len(haystack)
    let nn = len(needle)
    let found = 0
    let i = 0
    while i <= hn - nn
        let chunk = slice(haystack, i, i + nn)
        if chunk == needle
            found = 1
        i = i + 1
    if found == 0
        print("FAIL " + label + ": [" + haystack + "] does not contain [" + needle + "]")
        exit(1)

fn ck_starts(label: string, s: string, prefix: string)
    let pn = len(prefix)
    if pn > len(s)
        print("FAIL " + label + ": string too short")
        exit(1)
    let got = slice(s, 0, pn)
    if got != prefix
        print("FAIL " + label + ": starts with [" + got + "] want [" + prefix + "]")
        exit(1)

fn ck_eq_str(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got [" + got + "] want [" + want + "]")
        exit(1)

fn ck_eq_int(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// KAT 1: hexdump([72,105]) starts with "00000000" and contains "48 69" and "|Hi|"
let bytes1 = [72, 105]
let out1 = hexdump(bytes1)
ck_starts("hexdump_start", out1, "00000000")
ck_contains("hexdump_hex", out1, "48 69")
ck_contains("hexdump_ascii", out1, "|Hi|")

// KAT 2: byte 0x00 renders as "00" in hex and '.' in ascii column
let bytes2 = [0]
let out2 = hexdump(bytes2)
ck_contains("hexdump_null_hex", out2, "00")
ck_contains("hexdump_null_dot", out2, "|.|")

// KAT 3: empty input -> ""
let bytes3 = []
let out3 = hexdump(bytes3)
ck_eq_str("hexdump_empty", out3, "")

// KAT 4: 17 bytes span 2 lines (contains a LF)
let bytes4 = [65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81]
let out4 = hexdump(bytes4)
let lf_count = 0
let i4 = 0
while i4 < len(out4)
    if slice(out4, i4, i4+1) == chr(10)
        lf_count = lf_count + 1
    i4 = i4 + 1
ck_eq_int("hexdump_two_lines", lf_count, 1)
ck_contains("hexdump_offset16", out4, "00000010")

// KAT 5: first line has all 16 bytes
ck_contains("hexdump_row1_hex", out4, "41 42 43 44 45 46 47 48 49 4a 4b 4c 4d 4e 4f 50")

// KAT 6: non-printable byte (0x01) shows as '.' in ascii column
let bytes6 = [1]
let out6 = hexdump(bytes6)
ck_contains("hexdump_nonprint_dot", out6, "|.|")
ck_contains("hexdump_nonprint_hex", out6, "01")

print("PASS _hexdump_test")
