// Unsigned / logical-shift ops -- prove the fix vs the arithmetic `>>` baseline.
// NOVA's `>>` lowers to ashr (sign-extending); ushr/ult/ugt/ule/uge/udiv/urem treat i64 as u64.

let high = 1 << 63            // 0x8000000000000000 = most-negative i64 (high bit set)

// LOGICAL right shift (the FIX): high >>> 1 == 0x4000000000000000
let logical = ushr(high, 1)
if logical != 4611686018427387904
    print("FAIL ushr(high,1) = " + str(logical))
    exit(1)
// ARITHMETIC baseline (the bug ushr works around): high >> 1 sign-extends to 0xC000...
let arith = high >> 1
if arith != -4611686018427387904
    print("FAIL baseline ashr high>>1 = " + str(arith))
    exit(1)
// normal positive value: logical == arithmetic
if ushr(256, 2) != 64
    print("FAIL ushr(256,2)")
    exit(1)

// UNSIGNED compare vs SIGNED contrast on the SAME bits
if not ugt(high, 1)
    print("FAIL ugt(high,1) unsigned")
    exit(1)
if not ult(1, high)
    print("FAIL ult(1,high) unsigned")
    exit(1)
if not (high < 1)            // signed: high is negative, so high < 1 is true
    print("FAIL signed high<1 contrast")
    exit(1)
if ult(high, 1)             // unsigned: high is huge, NOT < 1
    print("FAIL ult(high,1) should be false")
    exit(1)

// ule / uge edges
if not ule(5, 5)
    print("FAIL ule(5,5)")
    exit(1)
if ule(6, 5)
    print("FAIL ule(6,5)")
    exit(1)
if not uge(5, 5)
    print("FAIL uge(5,5)")
    exit(1)
if uge(4, 5)
    print("FAIL uge(4,5)")
    exit(1)

// UNSIGNED div / rem + div0 guard (no crash)
if udiv(high, 2) != 4611686018427387904
    print("FAIL udiv(high,2)")
    exit(1)
if urem(high, 2) != 0
    print("FAIL urem(high,2)")
    exit(1)
if urem(high, 3) != 2       // 9223372036854775808 % 3 = 2 (unsigned)
    print("FAIL urem(high,3)")
    exit(1)
if udiv(5, 0) != 0
    print("FAIL udiv div0 guard")
    exit(1)
if urem(5, 0) != 0
    print("FAIL urem div0 guard")
    exit(1)

// UFCS method forms
if high.ushr(1) != 4611686018427387904
    print("FAIL UFCS ushr")
    exit(1)
if not high.ugt(1)
    print("FAIL UFCS ugt")
    exit(1)

print("uint_ops PASS")
