import std/net/netmask

// Known-answer test for std/net/netmask.
// Each assertion uses cks/cki helpers that print FAIL and exit(1) on mismatch.

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gs = "false"
    if got
        gs = "true"
    let ws = "false"
    if want
        ws = "true"
    if got != want
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn main()
    // ── nm_prefix_to_mask ─────────────────────────────────────────────────────

    // /24 -> "255.255.255.0"
    cks("nm_prefix_to_mask(24)", nm_prefix_to_mask(24), "255.255.255.0")

    // /16 -> "255.255.0.0"
    cks("nm_prefix_to_mask(16)", nm_prefix_to_mask(16), "255.255.0.0")

    // /32 -> "255.255.255.255"  (exact host route)
    cks("nm_prefix_to_mask(32)", nm_prefix_to_mask(32), "255.255.255.255")

    // /0  -> "0.0.0.0"  (default route, no bits fixed)
    cks("nm_prefix_to_mask(0)", nm_prefix_to_mask(0), "0.0.0.0")

    // /25 -> "255.255.255.128"
    cks("nm_prefix_to_mask(25)", nm_prefix_to_mask(25), "255.255.255.128")

    // /8  -> "255.0.0.0"
    cks("nm_prefix_to_mask(8)", nm_prefix_to_mask(8), "255.0.0.0")

    // ── nm_mask_to_prefix ─────────────────────────────────────────────────────

    // "255.255.255.0" -> 24
    cki("nm_mask_to_prefix(255.255.255.0)", nm_mask_to_prefix("255.255.255.0"), 24)

    // "255.255.255.128" -> 25
    cki("nm_mask_to_prefix(255.255.255.128)", nm_mask_to_prefix("255.255.255.128"), 25)

    // "255.0.255.0" -> -1  (non-contiguous: 1s, then 0s, then 1s again)
    cki("nm_mask_to_prefix(255.0.255.0)", nm_mask_to_prefix("255.0.255.0"), -1)

    // "255.255.0.0" -> 16
    cki("nm_mask_to_prefix(255.255.0.0)", nm_mask_to_prefix("255.255.0.0"), 16)

    // "0.0.0.0" -> 0
    cki("nm_mask_to_prefix(0.0.0.0)", nm_mask_to_prefix("0.0.0.0"), 0)

    // "255.255.255.255" -> 32
    cki("nm_mask_to_prefix(255.255.255.255)", nm_mask_to_prefix("255.255.255.255"), 32)

    // ── nm_wildcard ───────────────────────────────────────────────────────────

    // /24 -> "0.0.0.255"
    cks("nm_wildcard(24)", nm_wildcard(24), "0.0.0.255")

    // /0  -> "255.255.255.255"
    cks("nm_wildcard(0)", nm_wildcard(0), "255.255.255.255")

    // /32 -> "0.0.0.0"
    cks("nm_wildcard(32)", nm_wildcard(32), "0.0.0.0")

    // /16 -> "0.0.255.255"
    cks("nm_wildcard(16)", nm_wildcard(16), "0.0.255.255")

    // ── nm_is_valid_mask ──────────────────────────────────────────────────────

    // "255.255.0.0" -> true
    ckb("nm_is_valid_mask(255.255.0.0)", nm_is_valid_mask("255.255.0.0"), true)

    // "255.0.255.0" -> false  (non-contiguous)
    ckb("nm_is_valid_mask(255.0.255.0)", nm_is_valid_mask("255.0.255.0"), false)

    // "255.255.255.128" -> true  (/25)
    ckb("nm_is_valid_mask(255.255.255.128)", nm_is_valid_mask("255.255.255.128"), true)

    // "255.255.255.1" -> false  (isolated low bit — not a valid subnet mask)
    ckb("nm_is_valid_mask(255.255.255.1)", nm_is_valid_mask("255.255.255.1"), false)

    // "0.0.0.0" -> true  (/0)
    ckb("nm_is_valid_mask(0.0.0.0)", nm_is_valid_mask("0.0.0.0"), true)

    // "255.255.255.255" -> true  (/32)
    ckb("nm_is_valid_mask(255.255.255.255)", nm_is_valid_mask("255.255.255.255"), true)

    print("_netmask_test passed")
