// KAT: a float payload wrapped by ok() must be boxed, so match reads it back as a float, not the
// raw IEEE-754 int64 bits. Regression for the dogfood-found bug (exact repro shape): with a single
// Result fn, ir_collect_param_types recorded fpt["nova_rt_ok"]["0"]="float", so the fpt-boxing
// branch SKIPPED boxing (its "concrete-float => callee reads raw bits" rule is false for the
// any-storing ok()/err()/some(), which nova_result_pack stores verbatim). It was context-sensitive:
// a 2nd Result fn calling ok(int) conflict-merged the fpt entry to "any", "accidentally" fixing it.
// Fix: exclude ok/err/some from that branch + box a raw-float payload deterministically.

fn price_ok() -> Result
    return ok(9.99)

fn err_msg() -> Result
    return err("nope")

fn main() -> int
    // single ok(float) call site -> the exact buggy configuration
    match price_ok()
        Ok(v) => assert(v == 9.99, "ok(float) payload read back as float")
        Err(e) => assert(false, "unexpected err from price_ok")
    // the value must be a REAL float (usable in arithmetic downstream, not raw bits)
    match price_ok()
        Ok(v) => assert(v * 2.0 == 19.98, "ok(float) payload is arithmetic-usable")
        Err(e) => assert(false, "unexpected err from price_ok #2")
    // err() carrying its normal string payload still works (no regression)
    match err_msg()
        Ok(v) => assert(false, "unexpected ok from err_msg")
        Err(e) => assert(e == "nope", "err(string) payload intact")
    print("PASS _kat_result_float")
    return 0

main()
