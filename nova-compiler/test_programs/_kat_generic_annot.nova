// KAT: multi-argument generic annotations must keep the comma between type args.
// Regression for the comma-drop bug: a comma is tokenized COMMA (not DELIM), but the param-type,
// return-type, and type-alias generic-capture loops checked "DELIM" and silently dropped it, so
// `Result<int, string>` became `Result<intstring>` (error "expected intstring") and `dict<string,
// int>` became `dict<stringint>`. The 1-arg form `Result<int>` (no comma) worked. Fix: 3x
// DELIM->COMMA (matches the already-correct let-type and struct-field loops).

// return-type annotation with a 2-arg generic (site 2638)
fn only_ok(path: string) -> Result<int, string>
    return ok(len(path))

// parameter-type annotation with a 2-arg generic (site 2582)
fn dict_val(d: dict<string, int>, key: string) -> int
    return d[key]

fn main() -> int
    match only_ok("hi")
        Ok(n) => assert(n == 2, "Result<int,string> ok payload")
        Err(e) => assert(false, "unexpected err from only_ok")
    let d = {}
    d["x"] = 7
    assert(dict_val(d, "x") == 7, "dict<string,int> param type")
    print("PASS _kat_generic_annot")
    return 0

main()
