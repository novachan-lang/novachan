// TIER 1 regression guard: an un-annotated function with heterogeneous returns must
// COMPILE (widen to any) and each value must print/behave correctly through the any path.
// A consistent-return function must keep its concrete type (real int math, not boxed garbage).
fn classify(k: int)
    if k == 0
        return 42
    if k == 1
        return "hello"
    return true

fn addup(a: int, b: int)
    return a + b

fn main()
    // heterogeneous: the string branch must round-trip as a real string
    let s = classify(1)
    if s != "hello"
        print("FAIL: classify(1) != hello")
        exit(1)
    if classify(0) != 42
        print("FAIL: classify(0) != 42")
        exit(1)
    // consistent int return: must be a real int (arithmetic works)
    let n = addup(3, 4)
    if n + 1 != 8
        print("FAIL: addup consistent-int typing broken")
        exit(1)
    print("PASS hetreturn")
