import forge_template_engine

fn main()
    let t = te_new()
    t = te_register(t, "greeting", "Hello $name!")
    t = te_register(t, "msg", "$user says $text")
    assert(te_count(t) == 2, "2 templates")

    let vars = {}
    vars["name"] = "Alice"
    let r1 = te_render(t, "greeting", vars)
    assert(is_ok(r1), "render ok")
    assert(unwrap(r1) == "Hello Alice!", "greeting rendered")

    let vars2 = {}
    vars2["user"] = "Bob"
    vars2["text"] = "hi"
    let r2 = te_render(t, "msg", vars2)
    assert(unwrap(r2) == "Bob says hi", "msg rendered")

    let bad = te_render(t, "missing", vars)
    assert(is_err(bad), "missing template is err")

    print("TEMPLATE-ENGINE KAT PASS")
