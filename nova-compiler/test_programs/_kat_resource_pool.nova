import forge_resource_pool

fn main()
    let rp = rp_new(3)
    rp = rp_add(rp, "worker-1")
    rp = rp_add(rp, "worker-2")
    rp = rp_add(rp, "worker-3")
    assert(rp_available(rp) == 3, "3 available")
    assert(rp_in_use(rp) == 0, "0 in use")
    assert(rp_total(rp) == 3, "3 total")

    rp = rp_add(rp, "worker-4")
    assert(rp_total(rp) == 3, "still 3 (at capacity)")

    let b1 = rp_borrow(rp)
    rp = b1["pool"]
    assert(b1["ok"] == 1, "borrow ok")
    assert(b1["resource"] == "worker-1", "got worker-1")
    assert(rp_available(rp) == 2, "2 available")
    assert(rp_in_use(rp) == 1, "1 in use")

    let b2 = rp_borrow(rp)
    rp = b2["pool"]
    let b3 = rp_borrow(rp)
    rp = b3["pool"]
    assert(rp_available(rp) == 0, "0 available")

    let b4 = rp_borrow(rp)
    assert(b4["ok"] == 0, "borrow failed (empty)")
    assert(b4["resource"] == "", "no resource")

    rp = rp_return(rp, "worker-2")
    assert(rp_available(rp) == 1, "1 available after return")
    assert(rp_in_use(rp) == 2, "2 in use")

    rp = rp_return(rp, "worker-1")
    rp = rp_return(rp, "worker-3")
    assert(rp_available(rp) == 3, "all returned")

    let stats = rp_stats(rp)
    assert(stats["capacity"] == 3, "capacity=3")
    assert(stats["total_borrows"] == 3, "3 borrows")
    assert(stats["total_returns"] == 3, "3 returns")

    print("RESOURCE-POOL KAT PASS")
