import std/encoding/caesar

// Helper: check string equality
fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

// Helper: check int equality
fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// KAT 1: encrypt "Hello" by 3 -> "Khoor"
cks("encrypt_Hello_3", cae_encrypt("Hello", 3), "Khoor")

// KAT 2: decrypt "Khoor" by 3 -> "Hello"
cks("decrypt_Khoor_3", cae_decrypt("Khoor", 3), "Hello")

// KAT 3: encrypt "abc" by 1 -> "bcd"
cks("encrypt_abc_1", cae_encrypt("abc", 1), "bcd")

// KAT 4: encrypt "xyz" by 3 -> "abc" (wrap-around)
cks("encrypt_xyz_3", cae_encrypt("xyz", 3), "abc")

// KAT 5: rot13("Hello") -> "Uryyb"
cks("rot13_Hello", cae_rot13("Hello"), "Uryyb")

// KAT 6: encrypt "Hi, Bob!" by 1 -> "Ij, Cpc!" (punctuation/space preserved)
cks("encrypt_mixed_1", cae_encrypt("Hi, Bob!", 1), "Ij, Cpc!")

// KAT 7: brute returns exactly 25 entries
cki("brute_len", len(cae_brute("abc")), 25)

// KAT 8: rot13 is self-inverse
cks("rot13_inverse", cae_rot13(cae_rot13("Hello, World!")), "Hello, World!")

// KAT 9: shift 0 is identity
cks("encrypt_shift0", cae_encrypt("Nova", 0), "Nova")

// KAT 10: decrypt is inverse of encrypt (round-trip)
cks("roundtrip", cae_decrypt(cae_encrypt("The quick brown FOX", 17), 17), "The quick brown FOX")

print("_caesar_test passed")
