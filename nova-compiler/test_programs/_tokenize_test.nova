// KAT for std/text/tokenize
import std/text/tokenize

// ── helpers ──────────────────────────────────────────────────────────────────

// Compare string lists element-by-element; exit(1) on mismatch.
fn _leq(label, got, want)
    if len(got) != len(want)
        print("FAIL " + label + ": len " + str(len(got)) + " != " + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL " + label + " [" + str(i) + "]: '" + str(got[i]) + "' != '" + str(want[i]) + "'")
            exit(1)
        i = i + 1

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " expected=" + str(want))
        exit(1)

// ── tk_words ─────────────────────────────────────────────────────────────────

// KAT 1 (from spec): "  hi   there " -> ["hi","there"]
_leq("words_spec",     tk_words("  hi   there "),       ["hi", "there"])

// KAT 2 (from spec): "" -> []
_leq("words_empty",    tk_words(""),                    [])

// KAT 3: leading/trailing tabs and newlines
_leq("words_ws_mix",   tk_words(chr(9)+"a"+chr(10)+"b"+chr(13)+"c"), ["a", "b", "c"])

// KAT 4: single word, no surrounding whitespace
_leq("words_single",   tk_words("hello"),               ["hello"])

// KAT 5: all whitespace
_leq("words_all_ws",   tk_words("   "+chr(9)+"   "),   [])

// KAT 6: three words with mixed whitespace
_leq("words_three",    tk_words("foo  bar"+chr(9)+"baz"), ["foo", "bar", "baz"])

// ── tk_lines ─────────────────────────────────────────────────────────────────

// KAT 7 (from spec): "a\nb" -> ["a","b"]
_leq("lines_spec",     tk_lines("a"+chr(10)+"b"),       ["a", "b"])

// KAT 8: three lines
_leq("lines_three",    tk_lines("x"+chr(10)+"y"+chr(10)+"z"), ["x", "y", "z"])

// KAT 9: empty string -> [""] (one empty segment)
_leq("lines_empty",    tk_lines(""),                    [""])

// KAT 10: trailing LF produces trailing empty string
_leq("lines_trailing", tk_lines("a"+chr(10)),           ["a", ""])

// KAT 11: two consecutive LFs -> middle empty string
_leq("lines_blank",    tk_lines("a"+chr(10)+chr(10)+"b"), ["a", "", "b"])

// KAT 12: single line, no LF
_leq("lines_no_lf",    tk_lines("hello"),               ["hello"])

// ── tk_chars ─────────────────────────────────────────────────────────────────

// KAT 13 (from spec): "ab" -> ["a","b"]
_leq("chars_spec",     tk_chars("ab"),                  ["a", "b"])

// KAT 14: empty string -> []
_leq("chars_empty",    tk_chars(""),                    [])

// KAT 15: single char
_leq("chars_one",      tk_chars("x"),                   ["x"])

// KAT 16: three chars
_leq("chars_three",    tk_chars("123"),                 ["1", "2", "3"])

// KAT 17: spaces are chars too
_leq("chars_spaces",   tk_chars("a b"),                 ["a", " ", "b"])

// ── tk_sentences ─────────────────────────────────────────────────────────────

// KAT 18 (from spec): "Hi. Bye!" -> ["Hi.","Bye!"]
_leq("sent_spec",      tk_sentences("Hi. Bye!"),        ["Hi.", "Bye!"])

// KAT 19: question mark terminal
_leq("sent_question",  tk_sentences("Who are you? I am NOVA."), ["Who are you?", "I am NOVA."])

// KAT 20: empty string -> []
_leq("sent_empty",     tk_sentences(""),                [])

// KAT 21: single sentence ending at string end
_leq("sent_single",    tk_sentences("Hello world."),    ["Hello world."])

// KAT 22: leading/trailing whitespace trimmed from each piece
_leq("sent_trim",      tk_sentences("  First.  Second!  "), ["First.", "Second!"])

// KAT 23: no terminal -> whole string treated as one piece (non-empty)
_leq("sent_no_term",   tk_sentences("no terminal here"), ["no terminal here"])

// ── tk_alnum_words ───────────────────────────────────────────────────────────

// KAT 24 (from spec): "Hello, World! 42" -> ["hello","world","42"]
_leq("alnum_spec",     tk_alnum_words("Hello, World! 42"), ["hello", "world", "42"])

// KAT 25: empty string -> []
_leq("alnum_empty",    tk_alnum_words(""),              [])

// KAT 26: all separators -> []
_leq("alnum_sep_only", tk_alnum_words("!!! ???"),       [])

// KAT 27: digits only
_leq("alnum_digits",   tk_alnum_words("123 456"),       ["123", "456"])

// KAT 28: lowercasing of uppercase
_leq("alnum_lower",    tk_alnum_words("ABC"),           ["abc"])

// KAT 29: mixed letters and digits in one run stay together
_leq("alnum_mixed_run",tk_alnum_words("abc123def"),     ["abc123def"])

print("_tokenize_test passed")
