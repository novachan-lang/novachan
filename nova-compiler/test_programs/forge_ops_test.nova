// forge_ops_test -- master plan Phase 1.12 / 2.10: per-route body-size limit (413) + /health.
import forge

fn h(req: Request) -> string
    "ok"

fn main()
    let q = chr(34)
    let a = forge.app()
    forge.use(a, forge.mw_limit_body(10))
    forge.health_route(a)
    forge.post(a, "/echo", h)

    // body within the limit -> handler runs
    let small: Response = forge.dispatch_req(a, forge.build_request("POST /echo HTTP/1.1\r\nContent-Length: 3\r\n\r\nhey", 0))
    assert(small.status == 200, "small body -> 200")
    // body over the limit -> 413 before the handler
    let big: Response = forge.dispatch_req(a, forge.build_request("POST /echo HTTP/1.1\r\nContent-Length: 20\r\n\r\nthis body is too big", 0))
    assert(big.status == 413, "oversized body -> 413")
    assert(big.body != "ok", "handler did not run for oversized body")
    print("PASS: mw_limit_body (413)")

    // /health
    let hr: Response = forge.dispatch_req(a, forge.build_request("GET /health HTTP/1.1\r\n\r\n", 0))
    assert(hr.status == 200, "/health -> 200")
    assert(find(hr.body, q + "status" + q + ":" + q + "ok" + q) >= 0, "/health body status ok")
    print("PASS: /health route")
    print("forge_ops_test passed")
