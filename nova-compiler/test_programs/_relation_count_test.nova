import std/relation/relation_count

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // KAT: rcnt_bell(n) for n=0..5
    cki("kat1_bell0", rcnt_bell(0), 1)
    cki("kat2_bell1", rcnt_bell(1), 1)
    cki("kat3_bell2", rcnt_bell(2), 2)
    cki("kat4_bell3", rcnt_bell(3), 5)
    cki("kat5_bell4", rcnt_bell(4), 15)
    cki("kat6_bell5", rcnt_bell(5), 52)

    // KAT: rcnt_stirling2(n,k)
    // S(4,2)=7
    cki("kat7_s42", rcnt_stirling2(4, 2), 7)
    // S(5,3)=25
    cki("kat8_s53", rcnt_stirling2(5, 3), 25)
    // S(0,0)=1
    cki("kat9_s00", rcnt_stirling2(0, 0), 1)
    // S(1,1)=1
    cki("kat10_s11", rcnt_stirling2(1, 1), 1)
    // S(3,1)=1 (only one way: all in one block)
    cki("kat11_s31", rcnt_stirling2(3, 1), 1)
    // S(3,3)=1 (each element its own block)
    cki("kat12_s33", rcnt_stirling2(3, 3), 1)
    // S(5,0)=0 (can't partition into 0 non-empty blocks)
    cki("kat13_s50", rcnt_stirling2(5, 0), 0)
    // S(3,2)=3
    cki("kat14_s32", rcnt_stirling2(3, 2), 3)

    // KAT: rcnt_num_reflexive(n)
    // n=0: 2^0=1
    cki("kat15_refl0", rcnt_num_reflexive(0), 1)
    // n=1: 2^0=1
    cki("kat16_refl1", rcnt_num_reflexive(1), 1)
    // n=2: 2^(4-2)=2^2=4
    cki("kat17_refl2", rcnt_num_reflexive(2), 4)
    // n=3: 2^(9-3)=2^6=64
    cki("kat18_refl3", rcnt_num_reflexive(3), 64)

    // KAT: rcnt_num_symmetric(n)
    // n=0: 2^0=1
    cki("kat19_sym0", rcnt_num_symmetric(0), 1)
    // n=1: 2^1=2
    cki("kat20_sym1", rcnt_num_symmetric(1), 2)
    // n=2: 2^3=8
    cki("kat21_sym2", rcnt_num_symmetric(2), 8)
    // n=3: 2^6=64
    cki("kat22_sym3", rcnt_num_symmetric(3), 64)

    // KAT: rcnt_num_relations(n)
    // n=0: 2^0=1
    cki("kat23_rel0", rcnt_num_relations(0), 1)
    // n=1: 2^1=2
    cki("kat24_rel1", rcnt_num_relations(1), 2)
    // n=2: 2^4=16
    cki("kat25_rel2", rcnt_num_relations(2), 16)
    // n=3: 2^9=512
    cki("kat26_rel3", rcnt_num_relations(3), 512)

    // KAT: rcnt_partitions_count == rcnt_bell
    cki("kat27_partitions3", rcnt_partitions_count(3), 5)
    cki("kat28_partitions4", rcnt_partitions_count(4), 15)

    // Additional Bell: B(6)=203
    cki("kat29_bell6", rcnt_bell(6), 203)

    print("PASS _relation_count_test")

main()
