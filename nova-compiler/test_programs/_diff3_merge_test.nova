// KAT for std/text/diff3_merge
import std/text/diff3_merge

fn _list_eq(a, b)
    if len(a) != len(b)
        return 0
    let i = 0
    while i < len(a)
        if a[i] != b[i]
            return 0
        i = i + 1
    return 1

fn _list_str(xs)
    let s = "["
    let i = 0
    while i < len(xs)
        if i > 0
            s = s + ","
        s = s + xs[i]
        i = i + 1
    s = s + "]"
    s

fn _contains(xs, needle)
    let i = 0
    while i < len(xs)
        if xs[i] == needle
            return 1
        i = i + 1
    return 0

fn check_list(got, want, label)
    if _list_eq(got, want) == 0
        print("FAIL diff3_merge " + label + ": got=" + _list_str(got) + " want=" + _list_str(want))
        exit(1)

fn check_int(got, want, label)
    if got != want
        print("FAIL diff3_merge " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── KAT 1: non-conflicting — mine changes "b"->"B", theirs changes "c"->"C" ──
    let base1  = ["a","b","c"]
    let mine1  = ["a","B","c"]
    let their1 = ["a","b","C"]
    let r1 = diff3_merge(base1, mine1, their1)
    let want1 = ["a","B","C"]
    check_list(r1["merged"], want1, "KAT1-merged")
    check_int(r1["conflict"], 0, "KAT1-conflict")

    // ── KAT 2: conflicting — mine changes "b"->"X", theirs changes "b"->"Y" ───
    let base2  = ["a","b","c"]
    let mine2  = ["a","X","c"]
    let their2 = ["a","Y","c"]
    let r2 = diff3_merge(base2, mine2, their2)
    check_int(r2["conflict"], 1, "KAT2-conflict")
    let m2 = r2["merged"]
    if _contains(m2, "<<<<<<<") == 0
        print("FAIL diff3_merge KAT2: merged missing '<<<<<<<'")
        exit(1)
    if _contains(m2, ">>>>>>>") == 0
        print("FAIL diff3_merge KAT2: merged missing '>>>>>>>'")
        exit(1)

    // ── KAT 3: mine == theirs (same change on both sides) → clean, no conflict ─
    let base3  = ["a","b","c"]
    let mine3  = ["a","Z","c"]
    let their3 = ["a","Z","c"]
    let r3 = diff3_merge(base3, mine3, their3)
    let want3 = ["a","Z","c"]
    check_list(r3["merged"], want3, "KAT3-merged")
    check_int(r3["conflict"], 0, "KAT3-conflict")

    // ── KAT 4: mine == base → theirs wins cleanly ────────────────────────────
    let base4  = ["a","b","c"]
    let mine4  = ["a","b","c"]
    let their4 = ["a","Q","c"]
    let r4 = diff3_merge(base4, mine4, their4)
    let want4 = ["a","Q","c"]
    check_list(r4["merged"], want4, "KAT4-merged")
    check_int(r4["conflict"], 0, "KAT4-conflict")

    // ── KAT 5: theirs == base → mine wins cleanly ────────────────────────────
    let base5  = ["a","b","c"]
    let mine5  = ["a","R","c"]
    let their5 = ["a","b","c"]
    let r5 = diff3_merge(base5, mine5, their5)
    let want5 = ["a","R","c"]
    check_list(r5["merged"], want5, "KAT5-merged")
    check_int(r5["conflict"], 0, "KAT5-conflict")

    // ── KAT 6: all identical → base returned unchanged ────────────────────────
    let base6  = ["x","y","z"]
    let mine6  = ["x","y","z"]
    let their6 = ["x","y","z"]
    let r6 = diff3_merge(base6, mine6, their6)
    check_list(r6["merged"], base6, "KAT6-merged")
    check_int(r6["conflict"], 0, "KAT6-conflict")

    // ── KAT 7: empty base — both sides add independent lines ─────────────────
    let base7  = []
    let mine7  = ["mine_line"]
    let their7 = ["their_line"]
    let r7 = diff3_merge(base7, mine7, their7)
    // Both add different lines → conflict
    check_int(r7["conflict"], 1, "KAT7-conflict")

    // ── KAT 8: empty base — both sides add SAME line (clean) ─────────────────
    let base8  = []
    let mine8  = ["same"]
    let their8 = ["same"]
    let r8 = diff3_merge(base8, mine8, their8)
    let want8 = ["same"]
    check_list(r8["merged"], want8, "KAT8-merged")
    check_int(r8["conflict"], 0, "KAT8-conflict")

    // ── KAT 9: diff3_clean returns just the list ───────────────────────────────
    let r9 = diff3_clean(["a","b","c"], ["a","B","c"], ["a","b","C"])
    let want9 = ["a","B","C"]
    check_list(r9, want9, "KAT9-clean")

    // ── KAT 10: mine inserts a line, theirs unchanged ─────────────────────────
    let base10  = ["a","c"]
    let mine10  = ["a","b","c"]
    let their10 = ["a","c"]
    let r10 = diff3_merge(base10, mine10, their10)
    let want10 = ["a","b","c"]
    check_list(r10["merged"], want10, "KAT10-merged")
    check_int(r10["conflict"], 0, "KAT10-conflict")

    print("PASS _diff3_merge_test")
