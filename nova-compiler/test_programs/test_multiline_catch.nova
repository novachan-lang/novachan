// Test: multi-line catch blocks
fn risky_divide(a: int, b: int) -> int
    if b == 0
        error("division by zero")
        return 0
    a / b

fn main()
    // Test 1: Single-line catch (should still work)
    let r1 = risky_divide(10, 0) catch e
        -1
    print(f"single-line: {r1}")

    // Test 2: Multi-line catch block
    let r2 = risky_divide(10, 0) catch e
        print(f"caught error: {e}")
        let fallback = 42
        fallback
    print(f"multi-line: {r2}")

    // Test 3: No error case
    let r3 = risky_divide(100, 5) catch e
        print("should not print")
        -1
    print(f"no-error: {r3}")

    // Test 4: Multi-line with computation
    let r4 = risky_divide(10, 0) catch e
        let a = 10
        let b = 20
        a + b
    print(f"computed: {r4}")

    print("done")

main()
