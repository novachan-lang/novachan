import prism_node
import prism_ui_tag

// Small local test harness: kat_check returns 1 on pass, 0 on fail, printing a
// line that STARTS with "FAIL" (the gate's failure token) when it fails.
fn kat_check(cond: bool, msg: string) -> int
    if cond
        return 1
    else
        print("FAIL: " + msg)
        return 0

// A label (leaf) node's rendered text lives in its own "text" attr.
fn label_text(n: PrismNode) -> string
    prism_node.prism_node_attr_str(n, "text", "")

fn main()
    let mut pass_count = 0
    let mut total = 0

    print("=== KAT: prism_ui_tag ===")

    // ============================================================
    // Section A: prism_tg_tag (6 assertions)
    // ============================================================
    let a1 = prism_ui_tag.prism_tg_tag("Bug")
    total += 1
    pass_count += kat_check(is_ok(a1), "A1 tag Bug is_ok")
    let a1n = unwrap(a1)
    total += 1
    pass_count += kat_check(prism_node.prism_node_kind_str(a1n) == "label", "A2 tag Bug kind_str == label")
    total += 1
    pass_count += kat_check(label_text(a1n) == "[Bug]", "A3 tag Bug text == [Bug]")

    let a2 = prism_ui_tag.prism_tg_tag("Multi Word")
    total += 1
    pass_count += kat_check(label_text(unwrap(a2)) == "[Multi Word]", "A4 tag 'Multi Word' text")

    let a3 = prism_ui_tag.prism_tg_tag("")
    total += 1
    pass_count += kat_check(is_err(a3), "A5 tag empty text is_err")
    total += 1
    pass_count += kat_check(unwrap_err(a3) == "prism_tg_tag: text must not be empty", "A6 tag empty text error text")

    // ============================================================
    // Section B: prism_tg_colored (8 assertions)
    // ============================================================
    let b1 = prism_ui_tag.prism_tg_colored("Bug", "red")
    total += 1
    pass_count += kat_check(is_ok(b1), "B1 colored Bug/red is_ok")
    let b1n = unwrap(b1)
    total += 1
    pass_count += kat_check(prism_node.prism_node_kind_str(b1n) == "label", "B2 colored Bug/red kind_str == label")
    total += 1
    pass_count += kat_check(label_text(b1n) == "(red) [Bug]", "B3 colored Bug/red text")

    let b2 = prism_ui_tag.prism_tg_colored("Feature", "blue")
    total += 1
    pass_count += kat_check(label_text(unwrap(b2)) == "(blue) [Feature]", "B4 colored Feature/blue text")

    let b3 = prism_ui_tag.prism_tg_colored("", "red")
    total += 1
    pass_count += kat_check(is_err(b3), "B5 colored empty text is_err")
    total += 1
    pass_count += kat_check(unwrap_err(b3) == "prism_tg_colored: text must not be empty", "B6 colored empty text error text")

    let b4 = prism_ui_tag.prism_tg_colored("Bug", "")
    total += 1
    pass_count += kat_check(is_err(b4), "B7 colored empty color is_err")
    total += 1
    pass_count += kat_check(unwrap_err(b4) == "prism_tg_colored: color must not be empty", "B8 colored empty color error text")

    // ============================================================
    // Section C: prism_tg_removable (10 assertions)
    // ============================================================
    let c1 = prism_ui_tag.prism_tg_removable("Bug")
    total += 1
    pass_count += kat_check(is_ok(c1), "C1 removable Bug is_ok")
    let c1n = unwrap(c1)
    total += 1
    pass_count += kat_check(prism_node.prism_node_kind_str(c1n) == "band", "C2 removable Bug kind_str == band")
    let c1c = prism_node.prism_node_children(c1n)
    total += 1
    pass_count += kat_check(len(c1c) == 2, "C3 removable Bug children count == 2")

    let c1_tag = c1c[0]
    total += 1
    pass_count += kat_check(prism_node.prism_node_kind_str(c1_tag) == "label", "C4 removable Bug child0 kind_str == label")
    total += 1
    pass_count += kat_check(label_text(c1_tag) == "[Bug]", "C5 removable Bug child0 text == [Bug]")

    let c1_close = c1c[1]
    total += 1
    pass_count += kat_check(prism_node.prism_node_kind_str(c1_close) == "press", "C6 removable Bug child1 kind_str == press")
    total += 1
    pass_count += kat_check(label_text(c1_close) == "Remove tag Bug", "C7 removable Bug child1 accessible name")

    let c1_close_kids = prism_node.prism_node_children(c1_close)
    total += 1
    pass_count += kat_check(len(c1_close_kids) == 1 and label_text(c1_close_kids[0]) == "x", "C8 removable Bug close button x label")

    let c2 = prism_ui_tag.prism_tg_removable("")
    total += 1
    pass_count += kat_check(is_err(c2), "C9 removable empty text is_err")
    total += 1
    pass_count += kat_check(unwrap_err(c2) == "prism_tg_removable: text must not be empty", "C10 removable empty text error text")

    // ============================================================
    // Section D: prism_tg_group (9 assertions)
    // ============================================================
    let tag1 = unwrap(prism_ui_tag.prism_tg_tag("Bug"))
    let tag2 = unwrap(prism_ui_tag.prism_tg_tag("Feature"))

    let d1 = prism_ui_tag.prism_tg_group([tag1])
    total += 1
    pass_count += kat_check(is_ok(d1), "D1 group single tag is_ok")
    let d1n = unwrap(d1)
    total += 1
    pass_count += kat_check(prism_node.prism_node_kind_str(d1n) == "flow", "D2 group kind_str == flow")
    total += 1
    pass_count += kat_check(len(prism_node.prism_node_children(d1n)) == 1, "D3 group single tag children count == 1")

    let d2 = prism_ui_tag.prism_tg_group([tag1, tag2])
    total += 1
    pass_count += kat_check(is_ok(d2), "D4 group two tags is_ok")
    let d2c = prism_node.prism_node_children(unwrap(d2))
    total += 1
    pass_count += kat_check(len(d2c) == 2, "D5 group two tags children count == 2")
    total += 1
    pass_count += kat_check(label_text(d2c[0]) == "[Bug]" and label_text(d2c[1]) == "[Feature]", "D6 group two tags order preserved")

    let d3 = prism_ui_tag.prism_tg_group([])
    total += 1
    pass_count += kat_check(is_err(d3), "D7 group empty list is_err")
    total += 1
    pass_count += kat_check(unwrap_err(d3) == "prism_tg_group: tags must not be empty", "D8 group empty list error text")

    let d4 = prism_ui_tag.prism_tg_group([tag1, "notanode"])
    total += 1
    pass_count += kat_check(is_err(d4), "D9 group non-PrismNode is_err")
    total += 1
    pass_count += kat_check(unwrap_err(d4) == "prism_tg_group: tag 1 is not a PrismNode (got string)", "D10 group non-PrismNode error text")

    // ============================================================
    // Section E: prism_tg_counted (9 assertions)
    // ============================================================
    let e1 = prism_ui_tag.prism_tg_counted("Bug", 3)
    total += 1
    pass_count += kat_check(is_ok(e1), "E1 counted Bug/3 is_ok")
    let e1n = unwrap(e1)
    total += 1
    pass_count += kat_check(prism_node.prism_node_kind_str(e1n) == "label", "E2 counted Bug/3 kind_str == label")
    total += 1
    pass_count += kat_check(label_text(e1n) == "[Bug (3)]", "E3 counted Bug/3 text")

    let e2 = prism_ui_tag.prism_tg_counted("Bug", 0)
    total += 1
    pass_count += kat_check(label_text(unwrap(e2)) == "[Bug (0)]", "E4 counted Bug/0 text")

    let e3 = prism_ui_tag.prism_tg_counted("Feature", 100)
    total += 1
    pass_count += kat_check(label_text(unwrap(e3)) == "[Feature (100)]", "E5 counted Feature/100 text")

    let e4 = prism_ui_tag.prism_tg_counted("", 3)
    total += 1
    pass_count += kat_check(is_err(e4), "E6 counted empty text is_err")
    total += 1
    pass_count += kat_check(unwrap_err(e4) == "prism_tg_counted: text must not be empty", "E7 counted empty text error text")

    let e5 = prism_ui_tag.prism_tg_counted("Bug", -1)
    total += 1
    pass_count += kat_check(is_err(e5), "E8 counted negative count is_err")
    total += 1
    pass_count += kat_check(unwrap_err(e5) == "prism_tg_counted: count must be >= 0", "E9 counted negative count error text")

    print("TOTAL " + str(pass_count) + "/" + str(total) + " passed")
