import forge_consensus

fn main()
    let c = cons_new(5)
    c = cons_propose(c, "add-server-A")
    assert(cons_round_count(c) == 1, "1 round")

    let p = cons_proposal(c, 0)
    assert(is_ok(p), "proposal ok")
    assert(unwrap(p) == "add-server-A", "proposal text")

    let v1 = cons_vote(c, 0, 1)
    assert(is_ok(v1), "vote1 ok")
    c = unwrap(v1)
    assert(cons_is_decided(c, 0) == 0, "not decided yet")

    let v2 = cons_vote(c, 0, 1)
    c = unwrap(v2)
    let v3 = cons_vote(c, 0, 1)
    c = unwrap(v3)
    assert(cons_is_decided(c, 0) == 1, "decided after 3 yes")

    let res = cons_result(c, 0)
    assert(is_ok(res), "result ok")
    assert(unwrap(res) == "accepted", "accepted")
    assert(cons_agreement_count(c) == 1, "1 agreement")

    c = cons_propose(c, "remove-server-B")
    let n1 = cons_vote(c, 1, 0)
    c = unwrap(n1)
    let n2 = cons_vote(c, 1, 0)
    c = unwrap(n2)
    let n3 = cons_vote(c, 1, 0)
    c = unwrap(n3)
    let res2 = cons_result(c, 1)
    assert(unwrap(res2) == "rejected", "rejected")

    let bad = cons_vote(c, 5, 1)
    assert(is_err(bad), "out of range")

    print("CONSENSUS KAT PASS")
