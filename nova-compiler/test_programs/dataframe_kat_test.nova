// KAT for std/data/dataframe.nova: 3-col DataFrame (name, age, score), 4 rows.
// Proves L8 dispatch: df["age"] must go through DataFrame__index, not a
// builtin index_get, because DataFrame is a user struct with no native []
// support -- if dispatch were broken this would compile-error or crash.
import std/data/dataframe

fn main()
    let colnames = ["name", "age", "score"]
    let rows = [
        ["alice", 30, 91.5],
        ["bob", 25, 88.0],
        ["carol", 40, 95.25],
        ["dave", 22, 70.0]
    ]
    let df: DataFrame = df_new(colnames, rows)

    // known answer: shape
    if df.nrows != 4
        print("FAIL nrows=" + str(df.nrows))
        exit(1)
    if len(df.colnames) != 3
        print("FAIL ncols=" + str(len(df.colnames)))
        exit(1)

    // known answer: df["age"] via L8 index operator -> [30, 25, 40, 22]
    let ages = df["age"]
    if len(ages) != 4 or ages[0] != 30 or ages[1] != 25 or ages[2] != 40 or ages[3] != 22
        print("FAIL df[age]=" + str(ages))
        exit(1)

    // known answer: df["name"] via same operator -> string column
    let names = df["name"]
    if names[0] != "alice" or names[3] != "dave"
        print("FAIL df[name]=" + str(names))
        exit(1)

    // known answer: missing column -> empty list, not a crash
    if len(df["nope"]) != 0
        print("FAIL missing col not empty")
        exit(1)
    if df_has_col(df, "age") != 1 or df_has_col(df, "nope") != 0
        print("FAIL df_has_col")
        exit(1)

    // known answer: col_sum(age) = 30+25+40+22 = 117.0
    let s = col_sum(df, "age")
    if s < 116.999 or s > 117.001
        print("FAIL col_sum age=" + str(s))
        exit(1)

    // known answer: col_mean(age) = 117/4 = 29.25
    let mean_age = col_mean(df, "age")
    if mean_age < 29.249 or mean_age > 29.251
        print("FAIL col_mean age=" + str(mean_age))
        exit(1)

    // known answer: col_min/col_max(score) = 70.0 / 95.25
    let minscore = col_min(df, "score")
    let maxscore = col_max(df, "score")
    if minscore < 69.999 or minscore > 70.001
        print("FAIL col_min score=" + str(minscore))
        exit(1)
    if maxscore < 95.249 or maxscore > 95.251
        print("FAIL col_max score=" + str(maxscore))
        exit(1)

    // known answer: df_filter(age > 25) keeps alice(30) + carol(40) -> 2 rows
    let adults = df_filter(df, fn(row) row[1] > 25)
    if adults.nrows != 2
        print("FAIL filter nrows=" + str(adults.nrows))
        exit(1)
    let fnames = adults["name"]
    if fnames[0] != "alice" or fnames[1] != "carol"
        print("FAIL filter names=" + str(fnames))
        exit(1)
    let fages = adults["age"]
    if fages[0] != 30 or fages[1] != 40
        print("FAIL filter ages=" + str(fages))
        exit(1)

    // known answer: df_select(["name","score"]) narrows to 2 cols, 4 rows,
    // preserving values and dropping "age".
    let narrow = df_select(df, ["name", "score"])
    if len(narrow.colnames) != 2 or narrow.nrows != 4
        print("FAIL select shape")
        exit(1)
    if df_has_col(narrow, "age") != 0
        print("FAIL select dropped col leaked")
        exit(1)
    let nscores = narrow["score"]
    if nscores[2] != 95.25
        print("FAIL select score=" + str(nscores))
        exit(1)

    // known answer: df_head(2) keeps first 2 rows of the original df.
    let top2 = df_head(df, 2)
    if top2.nrows != 2
        print("FAIL head nrows=" + str(top2.nrows))
        exit(1)
    let hages = top2["age"]
    if hages[0] != 30 or hages[1] != 25
        print("FAIL head ages=" + str(hages))
        exit(1)

    // df_head(n) with n > nrows clamps to nrows.
    let topbig = df_head(df, 100)
    if topbig.nrows != 4
        print("FAIL head clamp nrows=" + str(topbig.nrows))
        exit(1)

    // known answer: df[col] returns a defensive COPY, not a live reference
    // into df.coldata -- mutating the returned list must not corrupt the
    // original DataFrame's column.
    let ages_copy = df["age"]
    push(ages_copy, 999)
    let ages_again = df["age"]
    if len(ages_again) != 4
        print("FAIL index() aliasing: df column corrupted, len=" + str(len(ages_again)))
        exit(1)
    if ages_again[0] != 30 or ages_again[1] != 25 or ages_again[2] != 40 or ages_again[3] != 22
        print("FAIL index() aliasing: df column values corrupted=" + str(ages_again))
        exit(1)
    ages_copy[0] = -1
    let ages_third = df["age"]
    if ages_third[0] != 30
        print("FAIL index() aliasing: mutating element corrupted df=" + str(ages_third))
        exit(1)

    // known answer: df_head(df, -1) clamps negative n to 0 -> empty,
    // internally-consistent DataFrame (nrows == 0, and every column
    // actually has 0 elements, not just the nrows field lying).
    let neghead = df_head(df, -1)
    if neghead.nrows != 0
        print("FAIL head negative n not clamped, nrows=" + str(neghead.nrows))
        exit(1)
    let neg_ages = neghead["age"]
    if len(neg_ages) != 0
        print("FAIL head negative n: column not empty, len=" + str(len(neg_ages)))
        exit(1)
    let neg_names = neghead["name"]
    if len(neg_names) != 0
        print("FAIL head negative n: name column not empty, len=" + str(len(neg_names)))
        exit(1)

    print("PASS dataframe_kat_test")
