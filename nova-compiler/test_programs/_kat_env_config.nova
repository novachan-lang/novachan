import forge_env_config

fn main()
    let e = env_new("production")
    e = env_set(e, "db_host", "prod-db.example.com")
    e = env_set(e, "port", "443")
    assert(env_count(e) == 2, "2 values")
    assert(env_environment(e) == "production", "production env")
    assert(env_is_production(e) == 1, "is production")

    let r1 = env_get(e, "db_host")
    assert(is_ok(r1), "get ok")
    assert(unwrap(r1) == "prod-db.example.com", "db host")

    let r2 = env_get(e, "missing")
    assert(is_err(r2), "missing err")

    let v = env_get_or(e, "missing", "default_val")
    assert(v == "default_val", "fallback works")

    let dev = env_new("development")
    assert(env_is_production(dev) == 0, "dev not production")

    print("ENV-CONFIG KAT PASS")
