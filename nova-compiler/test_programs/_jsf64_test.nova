// KAT test for std/random/jsf64
// Tests: determinism, anchor vectors, range bounds, seed divergence.
//
// Anchor values computed from Python reference implementation
// (JSF reference: http://burtleburtle.net/bob/rand/smallprng.html)
// Cross-verified via Python rotl64 simulation.
//
// jsf_seed(0) -> 20 warm-up steps -> first 8 outputs (signed i64):
//   [0]  5420579327082221045   (0x4b39c42db38fcdf5)
//   [1] -5844887363380887767   (0xaee2c9e919833f29)
//   [2]  3486099297865454798   (0x30611cd75d0254ce)
//   [3]  9209813893562929851   (0x7fcfd4f0c54692bb)
//   [4] -5363933490331570821   (0xb58f7ae8edf72d7b)
//   [5]  4627400453105216791   (0x4037d431f0d16d17)
//   [6]  6354545896730271205   (0x582fe1d343861de5)
//   [7] -4968378171157735571   (0xbb0cc6607e56976d)

import std/random/jsf64

fn main()
    // ── KAT 1: DETERMINISM — two jsf_seed(0) generators produce same first 8 values
    let rng_a = jsf_seed(0)
    let a0 = jsf_next(rng_a)
    let a1 = jsf_next(rng_a)
    let a2 = jsf_next(rng_a)
    let a3 = jsf_next(rng_a)
    let a4 = jsf_next(rng_a)
    let a5 = jsf_next(rng_a)
    let a6 = jsf_next(rng_a)
    let a7 = jsf_next(rng_a)

    let rng_b = jsf_seed(0)
    let b0 = jsf_next(rng_b)
    let b1 = jsf_next(rng_b)
    let b2 = jsf_next(rng_b)
    let b3 = jsf_next(rng_b)
    let b4 = jsf_next(rng_b)
    let b5 = jsf_next(rng_b)
    let b6 = jsf_next(rng_b)
    let b7 = jsf_next(rng_b)

    if a0 != b0
        print("FAIL jsf64 determinism[0]: " + str(a0) + " vs " + str(b0))
        exit(1)
    if a1 != b1
        print("FAIL jsf64 determinism[1]: " + str(a1) + " vs " + str(b1))
        exit(1)
    if a2 != b2
        print("FAIL jsf64 determinism[2]: " + str(a2) + " vs " + str(b2))
        exit(1)
    if a3 != b3
        print("FAIL jsf64 determinism[3]: " + str(a3) + " vs " + str(b3))
        exit(1)
    if a4 != b4
        print("FAIL jsf64 determinism[4]: " + str(a4) + " vs " + str(b4))
        exit(1)
    if a5 != b5
        print("FAIL jsf64 determinism[5]: " + str(a5) + " vs " + str(b5))
        exit(1)
    if a6 != b6
        print("FAIL jsf64 determinism[6]: " + str(a6) + " vs " + str(b6))
        exit(1)
    if a7 != b7
        print("FAIL jsf64 determinism[7]: " + str(a7) + " vs " + str(b7))
        exit(1)

    // ── KAT 2: ANCHOR VECTORS for jsf_seed(0) ─────────────────────────────────
    // These are signed i64 representations of the 64-bit outputs.
    let want0 = 5420579327082221045
    let want1 = -5844887363380887767
    let want2 = 3486099297865454798
    let want3 = 9209813893562929851
    let want4 = -5363933490331570821
    let want5 = 4627400453105216791
    let want6 = 6354545896730271205
    let want7 = -4968378171157735571

    if a0 != want0
        print("FAIL jsf64 anchor[0]: got " + str(a0) + " want " + str(want0))
        exit(1)
    if a1 != want1
        print("FAIL jsf64 anchor[1]: got " + str(a1) + " want " + str(want1))
        exit(1)
    if a2 != want2
        print("FAIL jsf64 anchor[2]: got " + str(a2) + " want " + str(want2))
        exit(1)
    if a3 != want3
        print("FAIL jsf64 anchor[3]: got " + str(a3) + " want " + str(want3))
        exit(1)
    if a4 != want4
        print("FAIL jsf64 anchor[4]: got " + str(a4) + " want " + str(want4))
        exit(1)
    if a5 != want5
        print("FAIL jsf64 anchor[5]: got " + str(a5) + " want " + str(want5))
        exit(1)
    if a6 != want6
        print("FAIL jsf64 anchor[6]: got " + str(a6) + " want " + str(want6))
        exit(1)
    if a7 != want7
        print("FAIL jsf64 anchor[7]: got " + str(a7) + " want " + str(want7))
        exit(1)

    // ── KAT 3: NON-DEGENERATE after mixing — outputs are not all zero/same ────
    // (anchor[0] != anchor[1] verifies the generator is actually moving)
    if a0 == a1
        print("FAIL jsf64 non-degenerate: first two outputs are equal: " + str(a0))
        exit(1)

    // ── KAT 4: DIFFERENT SEEDS DIVERGE ────────────────────────────────────────
    let rng_1 = jsf_seed(1)
    let v1_out = jsf_next(rng_1)
    let want_seed1_first = -5876251242010375864
    if v1_out != want_seed1_first
        print("FAIL jsf64 seed(1) anchor: got " + str(v1_out) + " want " + str(want_seed1_first))
        exit(1)
    // Also verify seed(0) first != seed(1) first
    let rng_0c = jsf_seed(0)
    let v0c = jsf_next(rng_0c)
    if v0c == v1_out
        print("FAIL jsf64 diverge: seed(0) and seed(1) produce same first output: " + str(v0c))
        exit(1)

    // ── KAT 5: jsf_next_range BOUNDS — 1000 values in [0, 100) ──────────────
    let rng_r = jsf_seed(7)
    let j = 0
    while j < 1000
        let rv = jsf_next_range(rng_r, 100)
        if rv < 0
            print("FAIL jsf64 range(100) below 0 at step " + str(j) + ": " + str(rv))
            exit(1)
        if rv >= 100
            print("FAIL jsf64 range(100) >= 100 at step " + str(j) + ": " + str(rv))
            exit(1)
        j = j + 1

    // ── KAT 6: jsf_next_range with n=1 always returns 0 ─────────────────────
    let rng_r2 = jsf_seed(99)
    let k = 0
    while k < 20
        let rv2 = jsf_next_range(rng_r2, 1)
        if rv2 != 0
            print("FAIL jsf64 range(1) != 0 at step " + str(k) + ": " + str(rv2))
            exit(1)
        k = k + 1

    // ── KAT 7: Multiple independent generators don't interfere ───────────────
    let rng_x = jsf_seed(42)
    let rng_y = jsf_seed(42)
    let x0 = jsf_next(rng_x)
    let y0 = jsf_next(rng_y)
    // Advance x independently
    let _x1 = jsf_next(rng_x)
    let _x2 = jsf_next(rng_x)
    // y should still match the x stream at position 3
    let x3 = jsf_next(rng_x)
    let _y1 = jsf_next(rng_y)
    let _y2 = jsf_next(rng_y)
    let y3 = jsf_next(rng_y)
    if x0 != y0
        print("FAIL jsf64 independence x0!=y0: " + str(x0) + " vs " + str(y0))
        exit(1)
    if x3 != y3
        print("FAIL jsf64 independence x3!=y3: " + str(x3) + " vs " + str(y3))
        exit(1)

    print("PASS _jsf64_test")
