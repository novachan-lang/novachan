// _pda_test — KAT for std/automata/pda.nova
// Builds a PDA for the language a^n b^n (n >= 0) and validates accept/reject.
//
// Construction:
//   States:  q0 (read a's; also accept for n=0), q1 (read b's; accept state)
//   Stack:   Z = bottom marker, A = pushed for each 'a'
//   Transitions:
//     (q0, a, Z) -> push AZ, q0    [first 'a': A on top of Z]
//     (q0, a, A) -> push AA, q0    [more a's: stack up A's]
//     (q0, b, A) -> push  "", q1   [first 'b': start popping]
//     (q1, b, A) -> push  "", q1   [subsequent b's: keep popping]
//   Accept states: q0 (handles n=0, empty string), q1 (handles n>0 balanced)
//   Acceptance condition: final state in accept set AND stack == [Z]

import std/automata/pda

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got " + got + " want " + want)
        exit(1)

fn build_anbn()
    let m = pda_new("q0", "Z")
    // transitions for reading a's
    pda_add(m, "q0", "a", "Z", "AZ", "q0")
    pda_add(m, "q0", "a", "A", "AA", "q0")
    // transition for first b (q0 -> q1)
    pda_add(m, "q0", "b", "A", "", "q1")
    // transition for subsequent b's (q1 -> q1)
    pda_add(m, "q1", "b", "A", "", "q1")
    // accept states
    pda_set_accept(m, "q0")   // n=0: empty string accepted
    pda_set_accept(m, "q1")   // n>0: balanced a^n b^n
    return m

fn main()
    let m = build_anbn()

    // KAT 1: "ab" -> true (n=1)
    cki("ab_accept", pda_accept(m, "ab"), 1)

    // KAT 2: "aabb" -> true (n=2)
    cki("aabb_accept", pda_accept(m, "aabb"), 1)

    // KAT 3: "aaabbb" -> true (n=3)
    cki("aaabbb_accept", pda_accept(m, "aaabbb"), 1)

    // KAT 4: "aab" -> false (more a's than b's)
    cki("aab_reject", pda_accept(m, "aab"), 0)

    // KAT 5: "abb" -> false (more b's than a's)
    cki("abb_reject", pda_accept(m, "abb"), 0)

    // KAT 6: "" -> true (n=0, the empty word is in a^0 b^0)
    cki("empty_accept", pda_accept(m, ""), 1)

    // KAT 7: "ba" -> false (wrong order)
    cki("ba_reject", pda_accept(m, "ba"), 0)

    // KAT 8: "aabbcc" -> false (extra characters after balanced prefix)
    cki("aabbcc_reject", pda_accept(m, "aabbcc"), 0)

    print("_pda_test passed")
