import std/functional/fiterate

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got " + gs + " want " + ws)
        exit(1)

fn ckl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + ": length got " + str(len(got)) + " want " + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL " + label + ": index " + str(i) + " got " + str(got[i]) + " want " + str(want[i]))
            exit(1)
        i = i + 1

// ── helpers ──────────────────────────────────────────────────────────────────
fn dbl(x)
    x * 2

fn inc(x)
    x + 1

fn main()
    // ── fi_apply_n ───────────────────────────────────────────────────────────

    // KAT: fi_apply_n(dbl,3,1) = dbl(dbl(dbl(1))) = 2->4->8 = 8
    cki("apply_n dbl 3 1", fi_apply_n(dbl, 3, 1), 8)

    // KAT: fi_apply_n(inc,5,0) = 0+5 = 5
    cki("apply_n inc 5 0", fi_apply_n(inc, 5, 0), 5)

    // KAT: fi_apply_n(dbl,0,7) = 7 (n=0 returns x unchanged)
    cki("apply_n dbl 0 7", fi_apply_n(dbl, 0, 7), 7)

    // Additional: fi_apply_n(inc,1,10) = 11
    cki("apply_n inc 1 10", fi_apply_n(inc, 1, 10), 11)

    // Additional: large n
    cki("apply_n inc 100 0", fi_apply_n(inc, 100, 0), 100)

    // ── fi_iterate ───────────────────────────────────────────────────────────

    // KAT: fi_iterate(dbl,1,4)=[1,2,4,8]
    let it1 = fi_iterate(dbl, 1, 4)
    ckl("iterate dbl 1 4", it1, [1, 2, 4, 8])

    // KAT: fi_iterate(inc,0,3)=[0,1,2]
    let it2 = fi_iterate(inc, 0, 3)
    ckl("iterate inc 0 3", it2, [0, 1, 2])

    // KAT: fi_iterate(dbl,5,1)=[5]
    let it3 = fi_iterate(dbl, 5, 1)
    ckl("iterate dbl 5 1", it3, [5])

    // KAT: n=0 returns empty list
    let it4 = fi_iterate(dbl, 1, 0)
    cki("iterate n=0 len", len(it4), 0)

    // Additional: fi_iterate(inc,10,5)=[10,11,12,13,14]
    let it5 = fi_iterate(inc, 10, 5)
    ckl("iterate inc 10 5", it5, [10, 11, 12, 13, 14])

    // Additional: fi_iterate(dbl,3,3)=[3,6,12]
    let it6 = fi_iterate(dbl, 3, 3)
    ckl("iterate dbl 3 3", it6, [3, 6, 12])

    // ── fi_nest_list (alias for fi_iterate) ──────────────────────────────────

    // KAT: fi_nest_list(dbl,1,4)=[1,2,4,8]
    let nl1 = fi_nest_list(dbl, 1, 4)
    ckl("nest_list dbl 1 4", nl1, [1, 2, 4, 8])

    // KAT: fi_nest_list(inc,0,3)=[0,1,2]
    let nl2 = fi_nest_list(inc, 0, 3)
    ckl("nest_list inc 0 3", nl2, [0, 1, 2])

    // KAT: fi_nest_list empty
    let nl3 = fi_nest_list(dbl, 7, 0)
    cki("nest_list n=0 len", len(nl3), 0)

    print("PASS _fiterate_test")

main()
