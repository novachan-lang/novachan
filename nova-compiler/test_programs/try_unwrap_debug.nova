fn safe_div(a: int, b: int) -> int
    if b == 0
        return err("zero")
    return ok(a / b)

fn propagate(a: int, b: int) -> int
    let val = safe_div(a, b)?
    return ok(val * 10)

fn main()
    let r1 = propagate(20, 4)
    print("r1 tag: " + str(result_tag(r1)))
    print("r1 unwrap: " + str(unwrap(r1)))

    let r2 = propagate(20, 0)
    print("r2 is_err: " + str(is_err(r2)))
