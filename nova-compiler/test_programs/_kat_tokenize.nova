import forge_tokenize

fn tf(b: bool) -> string
    if b
        return "T"
    "F"
fn joinl(xs: list) -> string
    let s = ""
    let i = 0
    while i < len(xs)
        if i > 0
            s = s + "|"
        s = s + xs[i]
        i = i + 1
    s

fn main()
    print("tok=" + joinl(text_tokenize("The Quick, Brown Fox!")))
    print("tok_num=" + joinl(text_tokenize("Hello World 123")))
    print("sw_the=" + tf(is_stopword("the")))
    print("sw_fox=" + tf(is_stopword("fox")))
    print("nostop=" + joinl(remove_stopwords(text_tokenize("The quick brown fox is over the lazy dog"))))
    print("bigrams=" + joinl(ngrams(["a", "b", "c"], 2)))
    print("unigrams=" + joinl(ngrams(["a", "b", "c"], 1)))
    print("trigram=" + joinl(ngrams(["a", "b", "c"], 3)))
    print("ng_empty=" + tf(len(ngrams(["a"], 2)) == 0))
