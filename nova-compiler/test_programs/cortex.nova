// NOVA CORTEX — minimal AI inference framework.
// Stage 2b adoption-engine #2 per FRAMEWORK_ECOSYSTEM_STRATEGY.md.
// Pairs with Forge: same process, same channels, same compilation unit,
// so a request handler that calls a Cortex model is ONE optimized
// function from TCP accept to JSON response (compiler advantage thesis).
//
// Public API (v0.1):
//   cortex.softmax(logits)           -> probabilities (numerically stable)
//   cortex.argmax(values)            -> index of max value
//   cortex.linear_classifier(W,x)    -> logits via tensor matmul
//   cortex.classify(W, x)            -> (class_index, top_probability)
//   cortex.parse_floats(csv)         -> list<float> from "1.0,2.0,3.0"

fn softmax(xs: list) -> list
    let m = xs[0]
    for x in xs
        if x > m
            m = x
    let exps = []
    for x in xs
        exps.push(exp(x - m))
    let total = 0.0
    for e in exps
        total = total + e
    let out = []
    for e in exps
        out.push(e / total)
    out

fn argmax(xs: list) -> int
    let best = 0
    let bestv = xs[0]
    let i = 1
    while i < len(xs)
        if xs[i] > bestv
            bestv = xs[i]
            best = i
        i = i + 1
    best

// Run a linear classifier: logits = x @ W
// W: tensor of shape [in_dim, num_classes]
// x: tensor of shape [1, in_dim]
// returns: list of logits (length num_classes)
fn linear_classifier(w, x) -> list
    tensor_to_list(tensor_matmul(x, w))

// Classify: returns [class_index, top_probability_as_int_x_1000].
// Floats can't cleanly cross some FFI/JSON boundaries yet, so we
// scale the probability by 1000 and return it as int for stable
// JSON encoding. cortex.classify_raw is the float-result variant.
fn classify(w, x) -> list
    let logits = linear_classifier(w, x)
    let probs = softmax(logits)
    let cls = argmax(probs)
    let top_p = probs[cls]
    let top_p_milli = int_milli(top_p)
    [cls, top_p_milli]

fn int_milli(p: float) -> int
    let scaled = p * 1000.0
    float_to_int(scaled)

// Parse a comma-separated list of floats: "1.0,2.0,3.5" -> [1.0, 2.0, 3.5]
fn parse_floats(csv: string) -> list
    let parts = split(csv, ",")
    let out = []
    for p in parts
        let t = trim(p)
        if len(t) > 0
            out.push(parse_float(t))
    out
