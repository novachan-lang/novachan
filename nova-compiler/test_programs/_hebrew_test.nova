// KAT for std/calendar/hebrew — Hebrew calendar conversions.
import std/calendar/hebrew

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL hebrew " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL hebrew " + label + ": got " + str(gi) + " want " + str(wi))
        exit(1)

fn ckrt(label: string, jdn: int, wy: int, wm: int, wd: int)
    let r = jdn_to_hebrew(jdn)
    let ry = r[0]
    let rm = r[1]
    let rd = r[2]
    if ry != wy or rm != wm or rd != wd
        print("FAIL hebrew " + label + ": got [" + str(ry) + "," + str(rm) + "," + str(rd) + "] want [" + str(wy) + "," + str(wm) + "," + str(wd) + "]")
        exit(1)

fn main()
    // ── hebrew_is_leap ────────────────────────────────────────────────────
    // Leap years in 19-yr cycle: 3,6,8,11,14,17,19
    ckb("is_leap(1)",  hebrew_is_leap(1),  false)
    ckb("is_leap(2)",  hebrew_is_leap(2),  false)
    ckb("is_leap(3)",  hebrew_is_leap(3),  true)
    ckb("is_leap(4)",  hebrew_is_leap(4),  false)
    ckb("is_leap(5)",  hebrew_is_leap(5),  false)
    ckb("is_leap(6)",  hebrew_is_leap(6),  true)
    ckb("is_leap(7)",  hebrew_is_leap(7),  false)
    ckb("is_leap(8)",  hebrew_is_leap(8),  true)
    ckb("is_leap(9)",  hebrew_is_leap(9),  false)
    ckb("is_leap(11)", hebrew_is_leap(11), true)
    ckb("is_leap(14)", hebrew_is_leap(14), true)
    ckb("is_leap(17)", hebrew_is_leap(17), true)
    ckb("is_leap(19)", hebrew_is_leap(19), true)
    ckb("is_leap(20)", hebrew_is_leap(20), false)
    // Year 5784: 5784 mod 19 = 5784 - 304*19 = 5784 - 5776 = 8 → leap
    ckb("is_leap(5784)", hebrew_is_leap(5784), true)
    // Year 5785: 5785 mod 19 = 9 → not leap
    ckb("is_leap(5785)", hebrew_is_leap(5785), false)

    // ── hebrew_to_jdn: plausibility check ─────────────────────────────────
    // 1 Tishri 5784 = Rosh Hashana 2023 = 2023-09-16 (Gregorian)
    // greg_to_jdn(2023,9,16): a=(14-9)/12=0, yy=2023+4800=6823, mm=9-3=6
    // =16+(153*6+2)/5+365*6823+6823/4-6823/100+6823/400-32045
    // =16+(920)/5+2490395+1705-68+17-32045 =16+184+2490395+1705-68+17-32045=2460204
    let jdn5784 = hebrew_to_jdn(5784, 1, 1)
    // Should be 2460204 (verified independently)
    cki("5784/1/1 JDN", jdn5784, 2460204)

    // ── Round-trip tests ──────────────────────────────────────────────────
    // Round-trip on 5784/1/1
    ckrt("rt-5784/1/1", jdn5784, 5784, 1, 1)

    // Round-trip on 5784/1/1 (Tishri 1 = Rosh Hashana) via to/from
    let jdn_check = hebrew_to_jdn(5784, 1, 1)
    ckrt("rt-5784/1/1-b", jdn_check, 5784, 1, 1)

    // Round-trip: mid-year date 5783/7/1 (Nisan = month 7 in non-leap year 5783)
    // Year 5783: 5783 mod 19 = 7 → not leap
    ckb("is_leap(5783)", hebrew_is_leap(5783), false)
    let jdn_mid = hebrew_to_jdn(5783, 7, 1)
    ckrt("rt-5783/7/1", jdn_mid, 5783, 7, 1)

    // Round-trip: a leap year mid-date
    // Year 5784 is leap; try month 6 (Adar I) day 15
    let jdn_leap_mid = hebrew_to_jdn(5784, 6, 15)
    ckrt("rt-5784/6/15", jdn_leap_mid, 5784, 6, 15)

    // Round-trip: last month of non-leap year
    // Year 5785: not leap, 12 months, last month = 12 (Elul)
    let jdn5785_last = hebrew_to_jdn(5785, 12, 29)
    ckrt("rt-5785/12/29", jdn5785_last, 5785, 12, 29)

    // Consecutive day check: 5784/1/2 = 5784/1/1 + 1
    let jdn5784_d2 = hebrew_to_jdn(5784, 1, 2)
    cki("5784/1/2 = 5784/1/1+1", jdn5784_d2, jdn5784 + 1)

    // Year length check: 5784 is leap (13 months)
    // Leap year lengths: 383, 384, or 385
    let rh5784 = hebrew_to_jdn(5784, 1, 1)
    let rh5785 = hebrew_to_jdn(5785, 1, 1)
    let ylen5784 = rh5785 - rh5784
    // 5784 is leap: should be 383, 384, or 385
    let ok5784 = 0
    if ylen5784 == 383 or ylen5784 == 384 or ylen5784 == 385
        ok5784 = 1
    if ok5784 != 1
        print("FAIL hebrew 5784-year-len: got "+str(ylen5784)+" want 383..385")
        exit(1)

    // Non-leap year length for 5785
    let rh5786 = hebrew_to_jdn(5786, 1, 1)
    let ylen5785 = rh5786 - rh5785
    let ok5785 = 0
    if ylen5785 == 353 or ylen5785 == 354 or ylen5785 == 355
        ok5785 = 1
    if ok5785 != 1
        print("FAIL hebrew 5785-year-len: got "+str(ylen5785)+" want 353..355")
        exit(1)

    print("PASS _hebrew_test")
