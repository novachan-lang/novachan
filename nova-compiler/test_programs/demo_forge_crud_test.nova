// demo_forge_crud_test -- the FULL Forge stack end-to-end: typed routing + handlers (closures
// capturing a forge_db connection pool) + DB storage + JSON body parsing (from_json) + response
// coercion (return your type -> JSON). A real todo CRUD API, exercised through dispatch.
import forge
import forge_db

type Todo
    id: int
    title: string

// GET /todos -> read from the DB, return a list of Todo (coerced to a JSON array).
fn list_todos(req: Request, pool) -> list
    let rows = forge_db.pool_query(pool, "SELECT id, title FROM todos ORDER BY id", [])
    let out = []
    for r in rows
        push(out, Todo(parse_int(r[0]), r[1]))
    out

// POST /todos -> parse a JSON body into a typed Todo, store it (parameterized), echo 201.
fn create_todo(req: Request, pool) -> Response
    let t: Todo = from_json(req.body)
    forge_db.pool_query(pool, "INSERT INTO todos VALUES (?, ?)", [t.id, t.title])
    forge.resp_json(201, t)

fn main()
    let q = chr(34)
    let pool = forge_db.pool_open("_crud.db", 2)
    forge_db.pool_exec(pool, "DROP TABLE IF EXISTS todos")
    forge_db.pool_exec(pool, "CREATE TABLE todos (id INTEGER, title TEXT)")

    let a = forge.app()
    let p = pool
    forge.get(a, "/todos", fn(req) list_todos(req, p))
    forge.post(a, "/todos", fn(req) create_todo(req, p))

    // create two todos via POST (JSON body, parsed by from_json)
    let b1 = "\{" + q + "id" + q + ":1," + q + "title" + q + ":" + q + "learn nova" + q + "\}"
    let cr: Response = forge.dispatch_req(a, forge.build_request("POST /todos HTTP/1.1\r\nContent-Length: " + str(len(b1)) + "\r\n\r\n" + b1, 0))
    assert(cr.status == 201, "create todo 1 -> 201")
    let b2 = "\{" + q + "id" + q + ":2," + q + "title" + q + ":" + q + "ship forge" + q + "\}"
    forge.dispatch_req(a, forge.build_request("POST /todos HTTP/1.1\r\nContent-Length: " + str(len(b2)) + "\r\n\r\n" + b2, 0))
    print("PASS: POST /todos (JSON body -> typed -> DB)")

    // list via GET -> JSON array sourced from the DB
    assert(find(cr.body, q + "title" + q + ":" + q + "learn nova" + q) >= 0, "create echoed the parsed Todo")
    let ls: Response = forge.dispatch_req(a, forge.build_request("GET /todos HTTP/1.1\r\n\r\n", 0))
    assert(ls.status == 200, "list -> 200")
    assert(find(ls.body, q + "title" + q + ":" + q + "learn nova" + q) >= 0, "DB-backed list has todo 1")
    assert(find(ls.body, q + "title" + q + ":" + q + "ship forge" + q) >= 0, "DB-backed list has todo 2")
    assert(find(ls.body, q + "id" + q + ":1") >= 0, "todo id round-trips through DB as int")
    print("PASS: GET /todos (DB -> JSON array)")

    forge_db.pool_close(pool, 2)
    print("demo_forge_crud_test passed")
