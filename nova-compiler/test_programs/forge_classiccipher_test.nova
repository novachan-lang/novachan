import forge_classiccipher

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // Caesar
    fails = fails + expect("caesar_enc", caesar_encrypt("Hello, World!", 3), "Khoor, Zruog!")
    fails = fails + expect("caesar_dec", caesar_decrypt("Khoor, Zruog!", 3), "Hello, World!")
    fails = fails + expect("caesar_wrap", caesar_encrypt("XYZ", 3), "ABC")
    fails = fails + expect("caesar_rt", caesar_decrypt(caesar_encrypt("The Quick Brown Fox", 7), 7), "The Quick Brown Fox")

    // ROT13 (self-inverse)
    fails = fails + expect("rot13", rot13("Hello"), "Uryyb")
    fails = fails + expect("rot13_inv", rot13(rot13("Attack at dawn!")), "Attack at dawn!")

    // Atbash (self-inverse)
    fails = fails + expect("atbash_abc", atbash("abc"), "zyx")
    fails = fails + expect("atbash_hello", atbash("Hello"), "Svool")
    fails = fails + expect("atbash_inv", atbash(atbash("Zebra 42!")), "Zebra 42!")

    // Vigenere (classic textbook example)
    fails = fails + expect("vig_enc", vigenere_encrypt("ATTACKATDAWN", "LEMON"), "LXFOPVEFRNHR")
    fails = fails + expect("vig_dec", vigenere_decrypt("LXFOPVEFRNHR", "LEMON"), "ATTACKATDAWN")
    fails = fails + expect("vig_rt", vigenere_decrypt(vigenere_encrypt("Hello, World!", "KEY"), "KEY"), "Hello, World!")
    fails = fails + expect("vig_case", vigenere_encrypt("attackatdawn", "lemon"), "lxfopvefrnhr")

    // Rail-Fence (canonical example)
    fails = fails + expect("rail_enc", railfence_encrypt("WEAREDISCOVEREDFLEEATONCE", 3), "WECRLTEERDSOEEFEAOCAIVDEN")
    fails = fails + expect("rail_dec", railfence_decrypt("WECRLTEERDSOEEFEAOCAIVDEN", 3), "WEAREDISCOVEREDFLEEATONCE")
    fails = fails + expect("rail_2", railfence_encrypt("HELLO", 2), "HLOEL")
    fails = fails + expect("rail_2dec", railfence_decrypt("HLOEL", 2), "HELLO")
    fails = fails + expect("rail_rt", railfence_decrypt(railfence_encrypt("DEFENDTHEEASTWALL", 4), 4), "DEFENDTHEEASTWALL")
    fails = fails + expect("rail_1", railfence_encrypt("NOCHANGE", 1), "NOCHANGE")

    if fails == 0
        print("forge_classiccipher: all passed")
    else
        print("forge_classiccipher: " + str(fails) + " FAILED")
