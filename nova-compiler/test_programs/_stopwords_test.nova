// KAT test for std/text/stopwords
import std/text/stopwords

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + got + " expected=" + expected)
        exit(1)

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

fn ck_true(label, got)
    if not got
        print("FAIL " + label + ": expected true got false")
        exit(1)

fn ck_false(label, got)
    if got
        print("FAIL " + label + ": expected false got true")
        exit(1)

fn main()
    // KAT 1: sw_is_stop lowercase
    ck_true("is_stop_the_en", sw_is_stop("the", "en"))

    // KAT 2: sw_is_stop case-insensitive
    ck_true("is_stop_The_en", sw_is_stop("The", "en"))

    // KAT 3: content word is NOT a stopword
    ck_false("is_stop_elephant_en", sw_is_stop("elephant", "en"))

    // KAT 4: sw_filter removes 'the' and 'is' from token list
    let tokens4 = []
    push(tokens4, "the")
    push(tokens4, "big")
    push(tokens4, "red")
    push(tokens4, "fox")
    push(tokens4, "is")
    push(tokens4, "fast")
    let filtered4 = sw_filter(tokens4, "en")
    cki("filter_len", len(filtered4), 4)
    cks("filter_0", filtered4[0], "big")
    cks("filter_1", filtered4[1], "red")
    cks("filter_2", filtered4[2], "fox")
    cks("filter_3", filtered4[3], "fast")

    // KAT 5: sw_count_stop
    let tokens5 = []
    push(tokens5, "the")
    push(tokens5, "a")
    push(tokens5, "cat")
    let cnt5 = sw_count_stop(tokens5, "en")
    cki("count_stop", cnt5, 2)

    // KAT 6: sw_supported contains the four codes
    let sup = sw_supported()
    let has_en = 0
    let has_es = 0
    let has_fr = 0
    let has_de = 0
    let si = 0
    while si < len(sup)
        if sup[si] == "en"
            has_en = 1
        if sup[si] == "es"
            has_es = 1
        if sup[si] == "fr"
            has_fr = 1
        if sup[si] == "de"
            has_de = 1
        si = si + 1
    cki("supported_en", has_en, 1)
    cki("supported_es", has_es, 1)
    cki("supported_fr", has_fr, 1)
    cki("supported_de", has_de, 1)

    // KAT 7: sw_is_stop Spanish word 'el'
    ck_true("is_stop_el_es", sw_is_stop("el", "es"))

    // KAT 8: sw_count_content
    let tokens8 = []
    push(tokens8, "the")
    push(tokens8, "quick")
    push(tokens8, "brown")
    push(tokens8, "fox")
    let cnt8 = sw_count_content(tokens8, "en")
    cki("count_content", cnt8, 3)

    // KAT 9: sw_ratio — 1 stop out of 2 tokens = 0.5
    let tokens9 = []
    push(tokens9, "the")
    push(tokens9, "cat")
    let ratio9 = sw_ratio(tokens9, "en")
    let diff9 = ratio9 - 0.5
    if diff9 < 0.0
        diff9 = 0.0 - diff9
    if diff9 > 0.001
        print("FAIL sw_ratio: got=" + str(ratio9) + " expected=0.5")
        exit(1)

    // KAT 10: sw_ratio empty returns 0.0
    let empty10 = []
    let ratio10 = sw_ratio(empty10, "en")
    let diff10 = ratio10 - 0.0
    if diff10 < 0.0
        diff10 = 0.0 - diff10
    if diff10 > 0.001
        print("FAIL sw_ratio_empty: got=" + str(ratio10) + " expected=0.0")
        exit(1)

    // KAT 11: sw_add appends a word
    let base11 = []
    push(base11, "foo")
    let added11 = sw_add(base11, "bar")
    cki("sw_add_len", len(added11), 2)
    cks("sw_add_0", added11[0], "foo")
    cks("sw_add_1", added11[1], "bar")

    // KAT 12: sw_filter_text
    let ft12 = sw_filter_text("the big red fox is fast", "en")
    cks("filter_text", ft12, "big red fox fast")

    // KAT 13: German stopword 'der'
    ck_true("is_stop_der_de", sw_is_stop("der", "de"))

    // KAT 14: French stopword 'les'
    ck_true("is_stop_les_fr", sw_is_stop("les", "fr"))

    // KAT 15: unknown lang returns empty -> nothing is a stopword
    ck_false("is_stop_unknown_lang", sw_is_stop("the", "xx"))

    print("PASS _stopwords_test")
