// KAT for std/testing/timer — deterministic test-timing utilities.
// All time values are injected nanosecond integers; no real clock needed.
import std/testing/timer

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + got + " want " + want)
        exit(1)

fn ckb(label, got, want)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got " + gs + " want " + ws)
        exit(1)

fn main()
    // ── ttmr_new + ttmr_elapsed ───────────────────────────────────────────────
    // KAT: ttmr_elapsed(ttmr_new(1000), 3500) == 2500
    let t = ttmr_new(1000)
    let e1 = ttmr_elapsed(t, 3500)
    cki("elapsed_basic", e1, 2500)

    // elapsed at start (nowNs == startNs) should be 0
    let t2 = ttmr_new(5000)
    let e2 = ttmr_elapsed(t2, 5000)
    cki("elapsed_zero", e2, 0)

    // elapsed with large gap
    let t3 = ttmr_new(0)
    let e3 = ttmr_elapsed(t3, 1000000000)
    cki("elapsed_1s_ns", e3, 1000000000)

    // ── ttmr_lap ──────────────────────────────────────────────────────────────
    // KAT sequence on fresh timer starting at 1000:
    //   ttmr_lap(t, 2000) == 1000  (since start=1000)
    //   ttmr_lap(t, 2500) == 500   (since last lap at 2000)
    let tl = ttmr_new(1000)
    let lap1 = ttmr_lap(tl, 2000)
    cki("lap_first", lap1, 1000)

    let lap2 = ttmr_lap(tl, 2500)
    cki("lap_second", lap2, 500)

    // third lap: from 2500 to 3000 = 500
    let lap3 = ttmr_lap(tl, 3000)
    cki("lap_third", lap3, 500)

    // ── ttmr_format_ns ────────────────────────────────────────────────────────
    // KAT: ttmr_format_ns(1500000) == "1.50ms"
    let fmt1 = ttmr_format_ns(1500000)
    cks("format_ms", fmt1, "1.50ms")

    // KAT: ttmr_format_ns(2000000000) == "2.00s"
    let fmt2 = ttmr_format_ns(2000000000)
    cks("format_s", fmt2, "2.00s")

    // KAT: ttmr_format_ns(500) == "500ns"
    let fmt3 = ttmr_format_ns(500)
    cks("format_ns", fmt3, "500ns")

    // microseconds: 1500 ns -> "1.50us"
    let fmt4 = ttmr_format_ns(1500)
    cks("format_us", fmt4, "1.50us")

    // exact 1ms boundary: 1000000 ns -> "1.00ms"
    let fmt5 = ttmr_format_ns(1000000)
    cks("format_1ms", fmt5, "1.00ms")

    // zero ns -> "0ns"
    let fmt6 = ttmr_format_ns(0)
    cks("format_0ns", fmt6, "0ns")

    // ── ttmr_faster ───────────────────────────────────────────────────────────
    // KAT: ttmr_faster(100, 200) == true
    let fa1 = ttmr_faster(100, 200)
    ckb("faster_true", fa1, true)

    // ttmr_faster(200, 100) == false
    let fa2 = ttmr_faster(200, 100)
    ckb("faster_false", fa2, false)

    // equal: not faster
    let fa3 = ttmr_faster(150, 150)
    ckb("faster_equal_false", fa3, false)

    print("_timer_test passed")
