fn pq_new()
  let pq = {}
  pq["heap"] = []
  pq

fn _pq_parent(i)
  (i - 1) / 2

fn _pq_left(i)
  2 * i + 1

fn _pq_right(i)
  2 * i + 2

fn _pq_swap(heap, i, j)
  let tmp = heap[i]
  heap[i] = heap[j]
  heap[j] = tmp

fn pq_push(pq, priority, value)
  let heap = pq["heap"]
  push(heap, [priority, value])
  let i = len(heap) - 1
  while i > 0
    let p = _pq_parent(i)
    if heap[p][0] > heap[i][0]
      _pq_swap(heap, p, i)
      i = p
    else
      i = 0

fn pq_pop(pq)
  let heap = pq["heap"]
  if len(heap) == 0
    return err("empty priority queue")
  let result = heap[0]
  let last_idx = len(heap) - 1
  heap[0] = heap[last_idx]
  let new_heap = []
  let k = 0
  while k < last_idx
    push(new_heap, heap[k])
    k = k + 1
  pq["heap"] = new_heap
  let h2 = pq["heap"]
  let i = 0
  let n = len(h2)
  while i < n
    let smallest = i
    let left = _pq_left(i)
    let right = _pq_right(i)
    if left < n and h2[left][0] < h2[smallest][0]
      smallest = left
    if right < n and h2[right][0] < h2[smallest][0]
      smallest = right
    if smallest != i
      _pq_swap(h2, i, smallest)
      i = smallest
    else
      i = n
  ok(result)

fn pq_peek(pq)
  let heap = pq["heap"]
  if len(heap) == 0
    return err("empty")
  ok(heap[0])

fn pq_size(pq)
  len(pq["heap"])

fn main()
  let pq = pq_new()
  assert(pq_size(pq) == 0, "empty")

  pq_push(pq, 3, "low")
  pq_push(pq, 1, "high")
  pq_push(pq, 2, "medium")
  assert(pq_size(pq) == 3, "size 3")

  let top = pq_peek(pq)
  assert(unwrap(top)[1] == "high", "peek = highest priority (lowest number)")

  let p1 = pq_pop(pq)
  assert(unwrap(p1)[0] == 1, "pop priority 1")
  assert(unwrap(p1)[1] == "high", "pop value high")

  let p2 = pq_pop(pq)
  assert(unwrap(p2)[0] == 2, "pop priority 2")

  let p3 = pq_pop(pq)
  assert(unwrap(p3)[0] == 3, "pop priority 3")

  assert(pq_size(pq) == 0, "empty after drain")
  assert(is_err(pq_pop(pq)), "pop empty = err")

  pq_push(pq, 5, "e")
  pq_push(pq, 1, "a")
  pq_push(pq, 3, "c")
  pq_push(pq, 2, "b")
  pq_push(pq, 4, "d")
  let order = []
  while pq_size(pq) > 0
    let _item = pq_pop(pq)
    push(order, unwrap(_item)[1])
  assert(order[0] == "a", "sorted a")
  assert(order[4] == "e", "sorted e")

  print("priorityx: all passed")
