// Multithreaded pipeline: 3-stage pipeline where each stage is a spawned
// process connected by channels. Data flows: producer -> transformer -> consumer.
// This is the classic concurrent pipeline pattern — zero async keywords.

fn producer(out_ch, items)
    let i = 0
    while i < len(items)
        send(out_ch, items[i])
        i = i + 1
    send(out_ch, -1)  // sentinel: done

fn transformer(in_ch, out_ch)
    let running = 1
    while running == 1
        let v = receive(in_ch)
        if v == -1
            send(out_ch, -1)
            running = 0
        else
            send(out_ch, v * 10 + 1)  // transform: x -> x*10+1

fn consumer(in_ch, result_ch)
    let results = []
    let running = 1
    while running == 1
        let v = receive(in_ch)
        if v == -1
            running = 0
        else
            push(results, v)
    send(result_ch, results)

fn main()
    let pipe1 = channel()
    let pipe2 = channel()
    let done = channel()

    // Wire up the pipeline: producer -> transformer -> consumer
    let data = [1, 2, 3, 4, 5]
    spawn producer(pipe1, data)
    spawn transformer(pipe1, pipe2)
    spawn consumer(pipe2, done)

    // Wait for the consumer to finish
    let results = receive(done)

    assert(len(results) == 5, "expected 5 results")
    assert(results[0] == 11, "1*10+1 = 11")
    assert(results[1] == 21, "2*10+1 = 21")
    assert(results[2] == 31, "3*10+1 = 31")
    assert(results[3] == 41, "4*10+1 = 41")
    assert(results[4] == 51, "5*10+1 = 51")

    print("pipeline: " + str(results))
    print("mt_pipeline_test: PASSED — 3-stage concurrent pipeline")
