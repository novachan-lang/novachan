// KAT for std/parsing/tokenizer
// Behavioral known-answer test — asserts exact outputs from spec.
import std/parsing/tokenizer

// ---- helpers ---------------------------------------------------------------

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL tokenizer " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL tokenizer " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// Serialize a list of kind strings to comma-separated for comparison.
fn kinds_str(kinds: list) -> string
    let out = ""
    let i = 0
    while i < len(kinds)
        if i > 0
            out = out + ","
        out = out + kinds[i]
        i = i + 1
    return out

// ---- KAT 1: tok_kinds basic expression -------------------------------------
// "x = 42 + y" => ident op int op ident

fn main()
    let src1 = "x = 42 + y"
    let k1 = tok_kinds(src1)
    cki("k1_len", len(k1), 5)
    cks("k1_0", k1[0], "ident")
    cks("k1_1", k1[1], "op")
    cks("k1_2", k1[2], "int")
    cks("k1_3", k1[3], "op")
    cks("k1_4", k1[4], "ident")
    cks("k1_kinds", kinds_str(k1), "ident,op,int,op,ident")

    // ---- KAT 2: first token text == "x" ------------------------------------
    let t1 = tokenize(src1)
    cks("first_text", t1[0]["text"], "x")

    // ---- KAT 3: int token text == "42" ------------------------------------
    cks("int_text", t1[2]["text"], "42")

    // ---- KAT 4: int token pos (x@0, sp@1, =@2, sp@3, 4@4, 2@5, sp@6, +@7, sp@8, y@9)
    cki("int_pos", t1[2]["pos"], 4)

    // ---- KAT 5: str token for say "hi" ------------------------------------
    // tokenize('say "hi"') has a str token with text == `"hi"` (raw lexeme with quotes)
    let src2 = "say \"hi\""
    let t2 = tokenize(src2)
    // Should be: ident "say", str `"hi"`
    cki("str_len", len(t2), 2)
    cks("str_kind", t2[1]["kind"], "str")
    // text includes surrounding quotes: "\"hi\""
    cks("str_text", t2[1]["text"], "\"hi\"")

    // ---- KAT 6: empty string input -----------------------------------------
    let t3 = tokenize("")
    cki("empty_len", len(t3), 0)

    // ---- KAT 7: tok_kinds of empty string ----------------------------------
    let k3 = tok_kinds("")
    cki("empty_kinds_len", len(k3), 0)

    // ---- KAT 8: ident starting with underscore ----------------------------
    let src4 = "_a1 b2"
    let t4 = tokenize(src4)
    cki("under_len", len(t4), 2)
    cks("under_first_kind", t4[0]["kind"], "ident")
    cks("under_first_text", t4[0]["text"], "_a1")
    cks("under_first_pos", str(t4[0]["pos"]), "0")

    // ---- KAT 9: underscore-ident kinds -------------------------------------
    let k4 = tok_kinds(src4)
    cks("under_kinds", kinds_str(k4), "ident,ident")

    // ---- KAT 10: operator positions ----------------------------------------
    let src5 = "a+b"
    let t5 = tokenize(src5)
    cki("op_len", len(t5), 3)
    cks("op_kinds", kinds_str(tok_kinds(src5)), "ident,op,ident")
    cks("op_text", t5[1]["text"], "+")
    cki("op_pos", t5[1]["pos"], 1)

    // ---- KAT 11: multiple operators ----------------------------------------
    let src6 = "a==b"
    let t6 = tokenize(src6)
    // '==' is two separate op tokens (tokenizer is single-char op)
    cki("multiop_len", len(t6), 4)
    cks("multiop_kinds", kinds_str(tok_kinds(src6)), "ident,op,op,ident")

    // ---- KAT 12: string with escape sequence ------------------------------
    let src7 = "\"hello\\nworld\""
    let t7 = tokenize(src7)
    cki("esc_len", len(t7), 1)
    cks("esc_kind", t7[0]["kind"], "str")
    // The raw lexeme includes the quotes and the backslash-n as-is
    cks("esc_text", t7[0]["text"], "\"hello\\nworld\"")

    // ---- KAT 13: unterminated string is safe (no crash) -------------------
    let src8 = "\"unterminated"
    let t8 = tokenize(src8)
    cki("unterm_len", len(t8), 1)
    cks("unterm_kind", t8[0]["kind"], "str")

    // ---- KAT 14: whitespace-only source ------------------------------------
    let src9 = "   \t  "
    let t9 = tokenize(src9)
    cki("ws_only_len", len(t9), 0)

    // ---- KAT 15: single operator -------------------------------------------
    let src10 = ";"
    let t10 = tokenize(src10)
    cki("single_op_len", len(t10), 1)
    cks("single_op_kind", t10[0]["kind"], "op")
    cks("single_op_text", t10[0]["text"], ";")

    // ---- KAT 16: pos field is correct for all tokens in src1 --------------
    // "x = 42 + y"
    //  0123456789A  (A=10)
    // x@0, =@2, 42@4, +@7, y@9  (spaces at 1,3,6,8)
    cki("pos_ident_x",   t1[0]["pos"], 0)
    cki("pos_op_eq",     t1[1]["pos"], 2)
    cki("pos_int_42",    t1[2]["pos"], 4)
    cki("pos_op_plus",   t1[3]["pos"], 7)
    cki("pos_ident_y",   t1[4]["pos"], 9)

    print("PASS _tokenizer_test")
