fn thousands(n)
  let s = str(n)
  let neg = 0
  if starts_with(s, "-")
    neg = 1
    s = slice(s, 1, len(s))
  let result = ""
  let i = 0
  let digits = len(s)
  while i < digits
    if i > 0 and (digits - i) % 3 == 0
      result = result + ","
    result = result + slice(s, i, i + 1)
    i = i + 1
  if neg == 1
    return "-" + result
  result

fn ordinal(n)
  let abs_n = n
  if abs_n < 0
    abs_n = 0 - abs_n
  let suffix = "th"
  let mod100 = abs_n % 100
  if mod100 >= 11 and mod100 <= 13
    suffix = "th"
  else
    let mod10 = abs_n % 10
    if mod10 == 1
      suffix = "st"
    else if mod10 == 2
      suffix = "nd"
    else if mod10 == 3
      suffix = "rd"
  str(n) + suffix

fn bytes_human(n)
  if n < 1024
    return str(n) + " B"
  if n < 1048576
    return str(n / 1024) + " KB"
  if n < 1073741824
    return str(n / 1048576) + " MB"
  str(n / 1073741824) + " GB"

fn percentage(part, total)
  if total == 0
    return "0%"
  str(part * 100 / total) + "%"

fn main()
  assert(thousands(1234567) == "1,234,567", "millions")
  assert(thousands(999) == "999", "no separator")
  assert(thousands(1000) == "1,000", "exactly 1k")
  assert(thousands(-5000) == "-5,000", "negative")

  assert(ordinal(1) == "1st", "1st")
  assert(ordinal(2) == "2nd", "2nd")
  assert(ordinal(3) == "3rd", "3rd")
  assert(ordinal(4) == "4th", "4th")
  assert(ordinal(11) == "11th", "11th")
  assert(ordinal(12) == "12th", "12th")
  assert(ordinal(13) == "13th", "13th")
  assert(ordinal(21) == "21st", "21st")
  assert(ordinal(22) == "22nd", "22nd")
  assert(ordinal(101) == "101st", "101st")

  assert(bytes_human(500) == "500 B", "bytes")
  assert(bytes_human(2048) == "2 KB", "kilobytes")
  assert(bytes_human(5242880) == "5 MB", "megabytes")
  assert(bytes_human(2147483648) == "2 GB", "gigabytes")

  assert(percentage(75, 100) == "75%", "75%")
  assert(percentage(1, 3) == "33%", "33%")
  assert(percentage(0, 0) == "0%", "0/0")

  print("numfmtx: all passed")
