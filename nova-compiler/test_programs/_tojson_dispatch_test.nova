// REGRESSION TEST for a CONFIRMED NOVA defect: to_json() on an IMPORTED struct dispatches to an
// unrelated LOCAL struct's generated __to_json when the consuming file declares EXACTLY ONE
// struct of its own.
//
// Found while building prism/core/prism_secret.nova (PRISM_SPEC §15.3, "a Secret has no
// serializer"), but it is NOT secret-specific and NOT generic-specific -- MacCreds below is an
// ordinary non-generic struct with no annotations.
//
// MEASURED (gen3_test.exe, 2026-09-03):
//   one local struct, 3 fields, imported struct has 2:
//     to_json(imported) = {"mo_a":"alice","mo_b":"SECRET-MARKER","mo_c":5608789569}
//   ^ WRONG FIELD NAMES, and `mo_c` is an OUT-OF-BOUNDS READ past the end of the 2-field object,
//     leaking a raw heap value into JSON. A Forge endpoint returning to_json() of an imported
//     struct could therefore emit adjacent heap memory.
//   TWO local structs: the imported struct serializes CORRECTLY. So the trigger is specifically
//   "exactly one local struct", which is why it survived so long -- most files declare several.
//
// This test FAILS while the defect is live. It is committed red-on-purpose as an executable
// record; when the compiler is fixed it turns green and becomes the guard.
import _tojson_dispatch_mod

type TjOnly
    tj_a: string
    tj_b: string
    tj_c: string

fn main()
    let c = _tojson_dispatch_mod.mac_creds_new("alice", "SECRET-MARKER")
    let j = to_json(c)
    print("to_json(imported) = {j}")
    let bad = 0
    if contains(j, "tj_a") or contains(j, "tj_b") or contains(j, "tj_c")
        print("FAIL assert: to_json dispatched to the LOCAL struct's method")
        bad = 1
    if not contains(j, "mc_user")
        print("FAIL assert: to_json did not use the imported struct's field names")
        bad = 1
    // The out-of-bounds field is the security half: a value that is not a string at all.
    if contains(j, "mc_user") and not contains(j, "mc_pass")
        print("FAIL assert: imported struct serialized with missing fields")
        bad = 1
    if bad == 1
        exit(1)
    print("ok to_json dispatch is correct for imported structs")
