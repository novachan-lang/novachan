import std/lambda/lambda_bool

// ── Check helpers ────────────────────────────────────────────────────────────

fn cki(label, got, want)
    if got != want
        print("FAIL _lambda_bool_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    if got != want
        let gs = "false"
        let ws = "false"
        if got
            gs = "true"
        if want
            ws = "true"
        print("FAIL _lambda_bool_test " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn main()
    // KAT 1: and(true, false) = false
    let t1 = lambda_bool.lbl_app(lambda_bool.lbl_app(lambda_bool.lbl_and(), lambda_bool.lbl_true()), lambda_bool.lbl_false())
    cki("and_T_F", lambda_bool.lbl_decode_bool(t1), 0)

    // KAT 2: and(true, true) = true
    let t2 = lambda_bool.lbl_app(lambda_bool.lbl_app(lambda_bool.lbl_and(), lambda_bool.lbl_true()), lambda_bool.lbl_true())
    cki("and_T_T", lambda_bool.lbl_decode_bool(t2), 1)

    // KAT 3: or(false, true) = true
    let t3 = lambda_bool.lbl_app(lambda_bool.lbl_app(lambda_bool.lbl_or(), lambda_bool.lbl_false()), lambda_bool.lbl_true())
    cki("or_F_T", lambda_bool.lbl_decode_bool(t3), 1)

    // KAT 4: or(false, false) = false
    let t4 = lambda_bool.lbl_app(lambda_bool.lbl_app(lambda_bool.lbl_or(), lambda_bool.lbl_false()), lambda_bool.lbl_false())
    cki("or_F_F", lambda_bool.lbl_decode_bool(t4), 0)

    // KAT 5: not(false) = true
    let t5 = lambda_bool.lbl_app(lambda_bool.lbl_not(), lambda_bool.lbl_false())
    cki("not_F", lambda_bool.lbl_decode_bool(t5), 1)

    // KAT 6: not(true) = false
    let t6 = lambda_bool.lbl_app(lambda_bool.lbl_not(), lambda_bool.lbl_true())
    cki("not_T", lambda_bool.lbl_decode_bool(t6), 0)

    // KAT 7: fst(pair(true, false)) = true
    let p = lambda_bool.lbl_app(lambda_bool.lbl_app(lambda_bool.lbl_pair(), lambda_bool.lbl_true()), lambda_bool.lbl_false())
    let t7 = lambda_bool.lbl_app(lambda_bool.lbl_fst(), p)
    cki("fst_pair_T_F", lambda_bool.lbl_decode_bool(t7), 1)

    // KAT 8: snd(pair(true, false)) = false
    let t8 = lambda_bool.lbl_app(lambda_bool.lbl_snd(), p)
    cki("snd_pair_T_F", lambda_bool.lbl_decode_bool(t8), 0)

    // KAT 9: if(true, true, false) picks first = true
    let t9 = lambda_bool.lbl_app(lambda_bool.lbl_app(lambda_bool.lbl_app(lambda_bool.lbl_if(), lambda_bool.lbl_true()), lambda_bool.lbl_true()), lambda_bool.lbl_false())
    cki("if_T_T_F", lambda_bool.lbl_decode_bool(t9), 1)

    // KAT 10: if(false, true, false) picks second = false
    let t10 = lambda_bool.lbl_app(lambda_bool.lbl_app(lambda_bool.lbl_app(lambda_bool.lbl_if(), lambda_bool.lbl_false()), lambda_bool.lbl_true()), lambda_bool.lbl_false())
    cki("if_F_T_F", lambda_bool.lbl_decode_bool(t10), 0)

    // KAT 11: and(false, true) = false
    let t11 = lambda_bool.lbl_app(lambda_bool.lbl_app(lambda_bool.lbl_and(), lambda_bool.lbl_false()), lambda_bool.lbl_true())
    cki("and_F_T", lambda_bool.lbl_decode_bool(t11), 0)

    print("PASS _lambda_bool_test")
