import std/vector/vec_gram

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl2(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + ": outer len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        let row_got = got[i]
        let row_want = want[i]
        if len(row_got) != len(row_want)
            print("FAIL " + label + " row " + str(i) + ": inner len mismatch")
            exit(1)
        let j = 0
        while j < len(row_got)
            if row_got[j] != row_want[j]
                print("FAIL " + label + "[" + str(i) + "][" + str(j) + "]: got=" + str(row_got[j]) + " want=" + str(row_want[j]))
                exit(1)
            j = j + 1
        i = i + 1

fn main()
    // KAT 1: vg_determinant([[1,0],[0,1]]) = 1
    // Gram = [[1,0],[0,1]], det = 1
    cki("det_identity_2", vg_determinant([[1, 0], [0, 1]]), 1)

    // KAT 2: vg_determinant([[1,0],[1,1]]) = 1
    // Gram = [[1,1],[1,2]], det = 2-1 = 1
    cki("det_shear_2", vg_determinant([[1, 0], [1, 1]]), 1)

    // KAT 3: vg_determinant([[2,0],[0,3]]) = 36
    // Gram = [[4,0],[0,9]], det = 36
    cki("det_scale_2", vg_determinant([[2, 0], [0, 3]]), 36)

    // KAT 4: vg_determinant([[1,1],[1,1]]) = 0 (linearly dependent)
    // Gram = [[2,2],[2,2]], det = 4-4 = 0
    cki("det_dependent_2", vg_determinant([[1, 1], [1, 1]]), 0)

    // KAT 5: vg_matrix([[1,0],[0,1]]) = [[1,0],[0,1]]
    let gm = vg_matrix([[1, 0], [0, 1]])
    ckl2("gram_identity", gm, [[1, 0], [0, 1]])

    // KAT 6: vg_determinant([[3,0,0],[0,4,0],[0,0,5]]) = 3600
    // Gram = [[9,0,0],[0,16,0],[0,0,25]], det = 9*16*25 = 3600
    cki("det_diag_3", vg_determinant([[3, 0, 0], [0, 4, 0], [0, 0, 5]]), 3600)

    // KAT 7: vg_volume_sq is alias for vg_determinant
    cki("volume_sq_alias", vg_volume_sq([[1, 0], [0, 1]]), 1)
    cki("volume_sq_diag", vg_volume_sq([[2, 0], [0, 3]]), 36)

    // KAT 8: Gram matrix of [[1,0],[1,1]] = [[1,1],[1,2]]
    let gm2 = vg_matrix([[1, 0], [1, 1]])
    ckl2("gram_shear", gm2, [[1, 1], [1, 2]])

    // KAT 9: single vector [[3]] — gram is [[9]], det = 9
    cki("det_single", vg_determinant([[3]]), 9)

    // KAT 10: empty vectors — gram is [], det = 1 by convention
    cki("det_empty", vg_determinant([]), 1)

    print("PASS _vec_gram_test")
