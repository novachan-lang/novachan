type Item
    price: float
    qty: int

fn get_price(it: Item) -> float
    return it.price

fn main()
    let items = [Item(10.5, 2), Item(20.25, 3)]
    let d = items.map(get_price)
    print("D named-fn:   " + str(d[1]))
    let e = items.map(fn(x) get_price(x))
    print("E inline-wrap:" + str(e[1]))
    let c = items.map(fn(x) x.price)
    print("C lambda-fld: " + str(c[1]))
