// Diagnostic: many functions + deep call chains

fn f1(x: int) -> int
    x + 1

fn f2(x: int) -> int
    f1(x) + 1

fn f3(x: int) -> int
    f2(x) + 1

fn f4(x: int) -> int
    f3(x) + 1

fn f5(x: int) -> int
    f4(x) + 1

fn f6(x: int) -> int
    f5(x) + 1

fn f7(x: int) -> int
    f6(x) + 1

fn f8(x: int) -> int
    f7(x) + 1

fn f9(x: int) -> int
    f8(x) + 1

fn f10(x: int) -> int
    f9(x) + 1

fn f11(x: int) -> int
    f10(x) + 1

fn f12(x: int) -> int
    f11(x) + 1

fn f13(x: int) -> int
    f12(x) + 1

fn f14(x: int) -> int
    f13(x) + 1

fn f15(x: int) -> int
    f14(x) + 1

fn f16(x: int) -> int
    f15(x) + 1

fn f17(x: int) -> int
    f16(x) + 1

fn f18(x: int) -> int
    f17(x) + 1

fn f19(x: int) -> int
    f18(x) + 1

fn f20(x: int) -> int
    f19(x) + 1

// Deep chain call
print(f20(0))

// Now test many functions with string operations
fn s1() -> string
    "hello"

fn s2() -> string
    s1() + " world"

fn s3() -> string
    s2() + " foo"

fn s4() -> string
    s3() + " bar"

fn s5() -> string
    s4() + " baz"

print(s5())
