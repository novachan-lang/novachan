import std/phonetic/cologne

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL cologne " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL cologne " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ---- KAT: Cologne reference vectors ----
    // Muller (Mueller = ue variant of Muller): M=6, U=0, E=0, L=5,L(dup), E=0, R=7
    // digits: 6,0,0,5,5,0,7 -> dedup: 6,0,5,0,7 -> strip 0: 657
    cks("Mueller", co_encode("Mueller"), "657")

    // Meyer: M=6, E=0, Y=0, E=0, R=7 -> dedup: 6,0,0,0,7 -> 6,0,7 -> strip 0: 67
    cks("Meyer", co_encode("Meyer"), "67")

    // Wikipedia: W=3,I=0,K=4,I=0,P=1,E=0,D=2,I=0,A=0
    // -> 3,0,4,0,1,0,2,0,0 -> dedup: 3,0,4,0,1,0,2,0 -> strip 0: 3412
    cks("Wikipedia", co_encode("Wikipedia"), "3412")

    // Breschnew: B=1,R=7,E=0,SCH=8,N=6,E=0,W=3
    // -> 1,7,0,8,6,0,3 -> no dups -> strip 0: 17863
    cks("Breschnew", co_encode("Breschnew"), "17863")

    // Muller-Ludenscheidt: Mueller(657) + Ludenscheidt(52682) = 65752682
    // (hyphen stripped; L=5,U=0,D=2,E=0,N=6,SCH=8,E=0,I=0,D=2,T=2)
    // -> 5,0,2,0,6,8,0,0,2,2 -> dedup: 5,0,2,0,6,8,0,2 -> strip 0: 52682
    cks("MullerLudenscheidt", co_encode("MullerLudenscheidt"), "65752682")

    // ---- Edge cases ----
    cks("empty", co_encode(""), "")
    // All vowels: stripped to nothing (or single 0 for leading vowel)
    // Anna: A=0,N=6,N(dup),A=0 -> dedup: 0,6,0 -> strip interior 0 (keep leading): 06
    cks("Anna", co_encode("Anna"), "06")
    // Single consonant
    cks("B", co_encode("B"), "1")
    cks("S", co_encode("S"), "8")

    // ---- co_normalize ----
    cks("norm_Wikipedia", co_normalize("Wikipedia"), "WIKIPEDIA")
    cks("norm_Breschnew", co_normalize("Breschnew"), "BRESCHNEW")
    cks("norm_empty", co_normalize(""), "")

    print("PASS _cologne_test")
