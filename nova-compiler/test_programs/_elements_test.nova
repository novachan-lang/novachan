// _elements_test.nova — KAT for std/chem/elements
//
// Known answers from IUPAC 2021 standard atomic weights:
//   atomic_number("C") == 6
//   atomic_mass("C")   ~= 12.011  (tol 0.001)
//   atomic_number("O") == 8
//   atomic_mass("H")   ~= 1.008   (tol 0.001)
//   symbol_of(11)      == "Na"
//   element_name("Fe") == "Iron"

import std/chem/elements

// Float proximity check.
fn approx(a: float, b: float, tol: float) -> int
    let d = a - b
    let ad = d
    if d < 0.0
        ad = 0.0 - d
    if ad < tol
        return 1
    return 0

fn main()
    // KAT 1: atomic_number("C") == 6
    let z_C = atomic_number("C")
    if z_C != 6
        print("FAIL elements atomic_number C: got " + str(z_C))
        exit(1)

    // KAT 2: atomic_mass("C") ~= 12.011
    let m_C = atomic_mass("C")
    if approx(m_C, 12.011, 0.001) != 1
        print("FAIL elements atomic_mass C: got " + str(m_C))
        exit(1)

    // KAT 3: atomic_number("O") == 8
    let z_O = atomic_number("O")
    if z_O != 8
        print("FAIL elements atomic_number O: got " + str(z_O))
        exit(1)

    // KAT 4: atomic_mass("H") ~= 1.008
    let m_H = atomic_mass("H")
    if approx(m_H, 1.008, 0.001) != 1
        print("FAIL elements atomic_mass H: got " + str(m_H))
        exit(1)

    // KAT 5: symbol_of(11) == "Na"
    let sym11 = symbol_of(11)
    if sym11 != "Na"
        print("FAIL elements symbol_of 11: got " + sym11)
        exit(1)

    // KAT 6: element_name("Fe") == "Iron"
    let name_Fe = element_name("Fe")
    if name_Fe != "Iron"
        print("FAIL elements element_name Fe: got " + name_Fe)
        exit(1)

    // KAT 7: atomic_number("Au") == 79
    let z_Au = atomic_number("Au")
    if z_Au != 79
        print("FAIL elements atomic_number Au: got " + str(z_Au))
        exit(1)

    // KAT 8: element_name("Na") == "Sodium"
    let name_Na = element_name("Na")
    if name_Na != "Sodium"
        print("FAIL elements element_name Na: got " + name_Na)
        exit(1)

    // KAT 9: unknown symbol returns 0 and 0.0
    let z_unk = atomic_number("Xx")
    if z_unk != 0
        print("FAIL elements unknown_symbol z: got " + str(z_unk))
        exit(1)

    print("PASS _elements_test")
