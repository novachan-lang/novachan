// NOVA Performance Benchmark Suite
// Tests: recursive fib, tight loop sum, prime sieve

fn fib(n: int) -> int
    if n <= 1
        return n
    return fib(n - 1) + fib(n - 2)

fn sum_loop(n: int) -> int
    let total = 0
    let i = 0
    while i < n
        total = total + i
        i = i + 1
    return total

fn count_primes(limit: int) -> int
    let count = 0
    let n = 2
    while n < limit
        let is_prime = 1
        let d = 2
        while d * d <= n
            if n % d == 0
                is_prime = 0
            d = d + 1
        if is_prime == 1
            count = count + 1
        n = n + 1
    return count

fn run()
    let t0 = clock_ns()
    let r1 = fib(38)
    let t1 = clock_ns()
    let r2 = sum_loop(100000000)
    let t2 = clock_ns()
    let r3 = count_primes(100000)
    let t3 = clock_ns()

    print("fib(38)       = " + str(r1) + "  (" + str((t1 - t0) / 1000000) + " ms)")
    print("sum(100M)     = " + str(r2) + "  (" + str((t2 - t1) / 1000000) + " ms)")
    print("primes(100K)  = " + str(r3) + "  (" + str((t3 - t2) / 1000000) + " ms)")
    print("TOTAL         = " + str((t3 - t0) / 1000000) + " ms")

run()
