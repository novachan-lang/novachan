// KAT LOCK-7: constant-time compare + secure wipe must be BYTE-EXACT.
// Both primitives used strlen(), which truncates at the first 0x00 -- and binary key
// material and MAC tags routinely contain 0x00. That made ct_eq compare a PREFIX:
// two different tags that both start with a NUL compared EQUAL == auth bypass.
fn main()
    let ok = 0
    let fail = 0

    // (1) two DIFFERENT secrets whose first byte is 0x00 must NOT be equal
    let a = bytes_from_list([0, 65, 66, 67])
    let b = bytes_from_list([0, 65, 66, 68])
    if ct_eq(a, b) == 0
        ok = ok + 1
        print("ok: NUL-prefixed differing tags are NOT equal")
    else
        fail = fail + 1
        print("FAIL: auth bypass -- differing tags compared equal")

    // (2) identical binary secrets containing 0x00 must still be equal
    let c = bytes_from_list([0, 65, 66, 67])
    if ct_eq(a, c) == 1
        ok = ok + 1
        print("ok: identical binary secrets are equal")
    else
        fail = fail + 1
        print("FAIL: identical binary secrets compared unequal")

    // (3) a shared prefix with different LENGTH must not be equal
    let d = bytes_from_list([65, 66])
    let e = bytes_from_list([65, 66, 67])
    if ct_eq(d, e) == 0
        ok = ok + 1
        print("ok: prefix of a longer secret is not equal")
    else
        fail = fail + 1
        print("FAIL: short prefix compared equal to longer secret")

    // (4) ordinary text still works (hex digests are the live forge call sites)
    if ct_eq("deadbeef", "deadbeef") == 1 and ct_eq("deadbeef", "deadbeee") == 0
        ok = ok + 1
        print("ok: text compare unchanged")
    else
        fail = fail + 1
        print("FAIL: text compare regressed")

    // (5) secure_zero must REFUSE a non-heap literal instead of faulting on .rdata,
    //     and must report that refusal rather than silently claiming success.
    if secure_zero("literal-not-heap") == 0
        ok = ok + 1
        print("ok: secure_zero refuses a read-only literal")
    else
        fail = fail + 1
        print("FAIL: secure_zero wrote through a literal")

    // (6) secure_zero wipes a real heap secret ACROSS an embedded 0x00
    let sec = bytes_from_list([255, 0, 254, 253])
    let wiped = secure_zero(sec)
    let tail_cleared = bytes_get(sec, 2) == 0 and bytes_get(sec, 3) == 0
    if wiped == 1 and bytes_get(sec, 0) == 0 and tail_cleared
        ok = ok + 1
        print("ok: heap secret wiped past the embedded NUL")
    else
        fail = fail + 1
        print("FAIL: wipe stopped at the NUL -- key material left in memory")

    print("ok=" + str(ok) + " fail=" + str(fail))
    if fail == 0
        print("KAT lock7 PASS")
    else
        print("KAT lock7 FAIL")
