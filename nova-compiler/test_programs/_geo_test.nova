// _geo_test.nova — KAT for std/math/geo
// Known-answer tests with hand-computed reference values.
import std/math/geo

fn ckf(label: str, got: float, expected: float, eps: float)
    let diff = got - expected
    let adiff = diff
    if diff < 0.0
        adiff = 0.0 - diff
    if adiff > eps
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected) + " eps " + str(eps))
        exit(1)

fn cki(label: str, got: int, expected: int)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn main()
    // ── geo_to_radians ────────────────────────────────────────────────────
    // 0 degrees -> 0 radians
    let r0 = geo_to_radians(0.0)
    ckf("to_radians(0)", r0, 0.0, 0.0001)

    // 180 degrees -> pi ~= 3.14159
    let r180 = geo_to_radians(180.0)
    ckf("to_radians(180)", r180, 3.14159, 0.0001)

    // 90 degrees -> pi/2 ~= 1.5708
    let r90 = geo_to_radians(90.0)
    ckf("to_radians(90)", r90, 1.5708, 0.0001)

    // ── geo_haversine ─────────────────────────────────────────────────────
    // Same point: distance = 0
    let h0 = geo_haversine(0.0, 0.0, 0.0, 0.0)
    ckf("haversine same point", h0, 0.0, 0.001)

    // Berlin (52.5200, 13.4050) -> Paris (48.8566, 2.3522) ~= 878 km
    let h_bp = geo_haversine(52.5200, 13.4050, 48.8566, 2.3522)
    ckf("haversine Berlin->Paris", h_bp, 878.0, 5.0)

    // Equator 0->1 degree longitude: 1 degree = 111.195 km at equator
    let h_eq = geo_haversine(0.0, 0.0, 0.0, 1.0)
    ckf("haversine equator 1 deg", h_eq, 111.195, 1.0)

    // Antipodal: (0,0) -> (0,180): half circumference ~= 20015 km
    let h_anti = geo_haversine(0.0, 0.0, 0.0, 180.0)
    ckf("haversine antipodal", h_anti, 20015.0, 10.0)

    // ── geo_bearing ───────────────────────────────────────────────────────
    // Due east: (0,0) -> (0,1) = 90 degrees
    let b_east = geo_bearing(0.0, 0.0, 0.0, 1.0)
    ckf("bearing due east", b_east, 90.0, 1.0)

    // Due north: (0,0) -> (1,0) = 0 degrees
    let b_north = geo_bearing(0.0, 0.0, 1.0, 0.0)
    ckf("bearing due north", b_north, 0.0, 1.0)

    // Due south: (1,0) -> (0,0) = 180 degrees
    let b_south = geo_bearing(1.0, 0.0, 0.0, 0.0)
    ckf("bearing due south", b_south, 180.0, 1.0)

    // Due west: (0,1) -> (0,0) = 270 degrees
    let b_west = geo_bearing(0.0, 1.0, 0.0, 0.0)
    ckf("bearing due west", b_west, 270.0, 1.0)

    // ── geo_midpoint ──────────────────────────────────────────────────────
    // Midpoint of (0,0) and (0,0) = (0,0)
    let mp0 = geo_midpoint(0.0, 0.0, 0.0, 0.0)
    let mp0_lat = mp0[0] * 1.0
    let mp0_lng = mp0[1] * 1.0
    ckf("midpoint same lat", mp0_lat, 0.0, 0.001)
    ckf("midpoint same lng", mp0_lng, 0.0, 0.001)

    // Midpoint of (0,0) and (0,10) = (0,5)
    let mp1 = geo_midpoint(0.0, 0.0, 0.0, 10.0)
    let mp1_lat = mp1[0] * 1.0
    let mp1_lng = mp1[1] * 1.0
    ckf("midpoint equator lat", mp1_lat, 0.0, 0.001)
    ckf("midpoint equator lng", mp1_lng, 5.0, 0.001)

    // Midpoint of (0,0) and (10,0) = (5,0)
    let mp2 = geo_midpoint(0.0, 0.0, 10.0, 0.0)
    let mp2_lat = mp2[0] * 1.0
    let mp2_lng = mp2[1] * 1.0
    ckf("midpoint meridian lat", mp2_lat, 5.0, 0.001)
    ckf("midpoint meridian lng", mp2_lng, 0.0, 0.001)

    print("_geo_test passed")
