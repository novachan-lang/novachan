// KAT test for std/data/json5 -- j5_parse / j5_parse_or
import std/data/json5

// Helper: check int equality
fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// Helper: check string equality
fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + got + " expected " + expected)
        exit(1)

// Shared char constants
let sq = chr(39)
let ob = chr(123)
let cb = chr(125)

// KAT 1: plain integer
let v1 = j5_parse("42")
cki("int-42", v1, 42)

// KAT 2: trailing comma in array
let v2 = j5_parse("[1, 2, 3,]")
cki("array-len", len(v2), 3)
cki("array-0", v2[0], 1)
cki("array-1", v2[1], 2)
cki("array-2", v2[2], 3)

// KAT 3: single-quoted string -- build at runtime: 'hello'
let v3 = j5_parse(sq + "hello" + sq)
cks("single-quote", v3, "hello")

// KAT 4: line comment then integer
// Build "// c\n42" at runtime: chr(47)=/ chr(10)=newline
let v4src = chr(47) + chr(47) + " c" + chr(10) + "42"
let v4 = j5_parse(v4src)
cki("line-comment", v4, 42)

// KAT 5: unquoted keys, trailing comma -- build {a: 1, b: 2,} at runtime
let v5src = ob + "a: 1, b: 2," + cb
let v5 = j5_parse(v5src)
cki("unquoted-key-a", v5["a"], 1)
cki("unquoted-key-b", v5["b"], 2)

// KAT 6: single-quoted key with nested array
// Build {'x': [1, 2]} at runtime
let v6src = ob + sq + "x" + sq + ": [1, 2]" + cb
let v6 = j5_parse(v6src)
let v6x = v6["x"]
cki("nested-array-len", len(v6x), 2)
cki("nested-array-0", v6x[0], 1)
cki("nested-array-1", v6x[1], 2)

// KAT 7: block comment
// Build "/* c */ 7" at runtime: chr(47)=/ chr(42)=*
let v7src = chr(47) + chr(42) + " c " + chr(42) + chr(47) + " 7"
let v7 = j5_parse(v7src)
cki("block-comment", v7, 7)

// KAT 8: true / false / null
let v8t = j5_parse("true")
cki("true-is-1", v8t, 1)
let v8f = j5_parse("false")
cki("false-is-0", v8f, 0)
let v8n = j5_parse("null")
let is_null8 = 0
if v8n == null
    is_null8 = 1
cki("null-is-null", is_null8, 1)

// KAT 9: negative integer
let v9 = j5_parse("-17")
cki("negative-int", v9, -17)

// KAT 10: double-quoted string with backslash-n escape
// Build: chr(34) + "he" + chr(92) + "nllo" + chr(34)
// which is the JSON string "he\nllo" -> should parse to "he" + chr(10) + "llo"
let dq_src = chr(34) + "he" + chr(92) + "nllo" + chr(34)
let v10 = j5_parse(dq_src)
let v10_expected = "he" + chr(10) + "llo"
cks("dq-escape-n", v10, v10_expected)

// KAT 11: nested objects -- build {outer: {inner: 99}} at runtime
let v11src = ob + "outer: " + ob + "inner: 99" + cb + cb
let v11 = j5_parse(v11src)
let v11o = v11["outer"]
cki("nested-obj", v11o["inner"], 99)

// KAT 12: j5_parse_or empty string returns default
let v12 = j5_parse_or("", 55)
cki("parse-or-empty", v12, 55)

// KAT 13: j5_parse_or valid returns parsed value
let v13 = j5_parse_or("77", 0)
cki("parse-or-valid", v13, 77)

// KAT 14: block comment mid-array
// Build "[1, /* skip */ 2, 3]" at runtime
let v14src = "[1, " + chr(47) + chr(42) + " skip " + chr(42) + chr(47) + " 2, 3]"
let v14 = j5_parse(v14src)
cki("block-in-array-len", len(v14), 3)
cki("block-in-array-1", v14[1], 2)

// KAT 15: zero integer
let v15 = j5_parse("0")
cki("zero", v15, 0)

// KAT 16: empty array
let v16 = j5_parse("[]")
cki("empty-array-len", len(v16), 0)

// KAT 17: empty object -- build {} at runtime
let v17 = j5_parse(ob + cb)
let v17k = keys(v17)
cki("empty-obj-keys", len(v17k), 0)

// KAT 18: whitespace-only string goes to default in parse_or
let v18 = j5_parse_or("   ", 42)
cki("parse-or-ws", v18, 42)

print("_json5_test passed")
