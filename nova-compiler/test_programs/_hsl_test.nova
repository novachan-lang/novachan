import std/color/hsl

// ── check helpers ─────────────────────────────────────────────────────────────

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckf(label: str, got: float, want: float, eps: float)
    let diff = got - want
    if diff < 0.0
        diff = 0.0 - diff
    if diff > eps
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ck_channel_near(label: str, got: int, want: int, tol: int)
    let diff = got - want
    if diff < 0
        diff = 0 - diff
    if diff > tol
        print("FAIL " + label + ": got " + str(got) + " want " + str(want) + " tol " + str(tol))
        exit(1)

fn main()
    // ── KAT 1: hsl_from_rgb([255,0,0]) == [0,100,50] ─────────────────────────
    let hsl_red = hsl_from_rgb([255, 0, 0])
    cki("from_rgb_red_h", hsl_red[0], 0)
    cki("from_rgb_red_s", hsl_red[1], 100)
    cki("from_rgb_red_l", hsl_red[2], 50)

    // ── KAT 2: hsl_from_rgb([0,255,0]) == [120,100,50] ───────────────────────
    let hsl_grn = hsl_from_rgb([0, 255, 0])
    cki("from_rgb_grn_h", hsl_grn[0], 120)
    cki("from_rgb_grn_s", hsl_grn[1], 100)
    cki("from_rgb_grn_l", hsl_grn[2], 50)

    // ── KAT 3: hsl_from_rgb([0,0,255]) == [240,100,50] ───────────────────────
    let hsl_blu = hsl_from_rgb([0, 0, 255])
    cki("from_rgb_blu_h", hsl_blu[0], 240)
    cki("from_rgb_blu_s", hsl_blu[1], 100)
    cki("from_rgb_blu_l", hsl_blu[2], 50)

    // ── KAT 4: hsl_from_rgb([255,255,255]) == [0,0,100] ──────────────────────
    let hsl_wht = hsl_from_rgb([255, 255, 255])
    cki("from_rgb_wht_h", hsl_wht[0], 0)
    cki("from_rgb_wht_s", hsl_wht[1], 0)
    cki("from_rgb_wht_l", hsl_wht[2], 100)

    // ── KAT 5: hsl_from_rgb([128,128,128]) == [0,0,50] ───────────────────────
    let hsl_gry = hsl_from_rgb([128, 128, 128])
    cki("from_rgb_gry_h", hsl_gry[0], 0)
    cki("from_rgb_gry_s", hsl_gry[1], 0)
    cki("from_rgb_gry_l", hsl_gry[2], 50)

    // ── KAT 6: hsl_to_rgb(0,100,50) == [255,0,0] ─────────────────────────────
    let rgb_red = hsl_to_rgb(0, 100, 50)
    cki("to_rgb_red_r", rgb_red[0], 255)
    cki("to_rgb_red_g", rgb_red[1], 0)
    cki("to_rgb_red_b", rgb_red[2], 0)

    // ── KAT 7: hsl_to_rgb(120,100,50) == [0,255,0] ───────────────────────────
    let rgb_grn = hsl_to_rgb(120, 100, 50)
    cki("to_rgb_grn_r", rgb_grn[0], 0)
    cki("to_rgb_grn_g", rgb_grn[1], 255)
    cki("to_rgb_grn_b", rgb_grn[2], 0)

    // ── KAT 8: round-trip hsl_to_rgb(hsl_from_rgb([200,100,50])) ~= [200,100,50] (±2)
    let src = []
    src.push(200)
    src.push(100)
    src.push(50)
    let hsl_mid = hsl_from_rgb(src)
    let rt = hsl_to_rgb(hsl_mid[0], hsl_mid[1], hsl_mid[2])
    ck_channel_near("roundtrip_r", rt[0], 200, 2)
    ck_channel_near("roundtrip_g", rt[1], 100, 2)
    ck_channel_near("roundtrip_b", rt[2], 50, 2)

    // ── Extra: hsl_to_rgb(240,100,50) == [0,0,255] ───────────────────────────
    let rgb_blu = hsl_to_rgb(240, 100, 50)
    cki("to_rgb_blu_r", rgb_blu[0], 0)
    cki("to_rgb_blu_g", rgb_blu[1], 0)
    cki("to_rgb_blu_b", rgb_blu[2], 255)

    // ── Extra: hsl_rotate_hue([255,0,0], 120) -> green-ish [0,255,0] ─────────
    let rotated = hsl_rotate_hue([255, 0, 0], 120)
    ck_channel_near("rotate_r", rotated[0], 0, 2)
    ck_channel_near("rotate_g", rotated[1], 255, 2)
    ck_channel_near("rotate_b", rotated[2], 0, 2)

    // ── Extra: black round-trip ───────────────────────────────────────────────
    let hsl_blk = hsl_from_rgb([0, 0, 0])
    cki("from_rgb_blk_l", hsl_blk[2], 0)
    cki("from_rgb_blk_s", hsl_blk[1], 0)

    print("_hsl_test passed")
