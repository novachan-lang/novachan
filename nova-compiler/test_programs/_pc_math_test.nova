// KAT for std/math/percent — percentage arithmetic.
import std/math/percent

fn ckf(label: string, got: float, want: float)
    let d = got - want
    if d < 0.0
        d = 0.0 - d
    if d > 0.001
        print("FAIL " + label + ": " + str(got) + " != " + str(want))
        exit(1)

fn main()
    ckf("pc_of(25,200)", pc_of(25, 200), 12.5)
    ckf("pc_of(1,4)", pc_of(1, 4), 25.0)
    ckf("pc_apply(200,15)", pc_apply(200, 15), 30.0)
    ckf("pc_change(100,150)", pc_change(100, 150), 50.0)
    ckf("pc_change(100,80)", pc_change(100, 80), -20.0)
    ckf("pc_add(100,10)", pc_add(100, 10), 110.0)
    ckf("pc_discount(100,20)", pc_discount(100, 20), 80.0)
    ckf("pc_ratio_to_pct(3,4)", pc_ratio_to_pct(3, 4), 75.0)
    print("_pc_math_test passed")
