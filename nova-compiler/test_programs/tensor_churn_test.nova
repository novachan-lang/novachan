// Isolate the tensor-lifetime-under-heap-churn bug (no HTTP/JSON involved).
// Create a tensor, churn the heap with many allocations, then matmul + read.
fn main()
    let w = tensor_from_list([1.0, 2.0, 0.0, 0.0, 1.0, 1.0], [2, 3])
    // churn the heap (lots of allocations, like a server handling requests)
    let junk = []
    let i = 0
    while i < 2000
        junk.push("some throwaway string allocation")
        i = i + 1
    let x = tensor_from_list([1.0, 2.0], [1, 2])
    let logits = tensor_to_list(tensor_matmul(x, w))
    // expected: [1, 4, 2]
    assert_near(logits[0], 1.0, 0.001)
    assert_near(logits[1], 4.0, 0.001)
    assert_near(logits[2], 2.0, 0.001)
    print("tensor churn test passed")
