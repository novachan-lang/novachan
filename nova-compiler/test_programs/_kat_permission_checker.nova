import forge_permission_checker

fn main()
    let p = pc_new()
    p = pc_grant(p, "admin", "read")
    p = pc_grant(p, "admin", "write")
    p = pc_grant(p, "admin", "delete")
    p = pc_grant(p, "viewer", "read")

    assert(pc_has_permission(p, "admin", "read") == 1, "admin can read")
    assert(pc_has_permission(p, "admin", "delete") == 1, "admin can delete")
    assert(pc_has_permission(p, "viewer", "read") == 1, "viewer can read")
    assert(pc_has_permission(p, "viewer", "write") == 0, "viewer cannot write")

    let r1 = pc_check(p, "admin", "write")
    p = r1["p"]
    assert(r1["allowed"] == 1, "admin write allowed")

    let r2 = pc_check(p, "viewer", "delete")
    p = r2["p"]
    assert(r2["allowed"] == 0, "viewer delete denied")

    assert(pc_total_checks(p) == 2, "2 checks")
    assert(pc_grant_rate(p) == 50, "50% grant rate")

    p = pc_revoke(p, "admin", "delete")
    assert(pc_has_permission(p, "admin", "delete") == 0, "admin delete revoked")

    let r3 = pc_check(p, "admin", "delete")
    p = r3["p"]
    assert(r3["allowed"] == 0, "admin delete now denied")

    print("PERMISSION-CHECKER KAT PASS")
