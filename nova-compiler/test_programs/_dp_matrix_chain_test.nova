import std/dp/dp_matrix_chain

fn cki(got, expected, label)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn ckb(got, expected, label)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn main()
    // KAT 1: [1,2,3,4] -> 3 matrices A(1x2),B(2x3),C(3x4). optimal=(AB)C=6+12=18
    let d1 = []
    push(d1, 1)
    push(d1, 2)
    push(d1, 3)
    push(d1, 4)
    cki(mc_min_mults(d1), 18, "min [1,2,3,4]")

    // KAT 2: [10,20,30] -> single pair, only one way: 10*20*30=6000
    let d2 = []
    push(d2, 10)
    push(d2, 20)
    push(d2, 30)
    cki(mc_min_mults(d2), 6000, "min [10,20,30]")

    // KAT 3: [10,20,30,40,30] -> min=30000
    let d3 = []
    push(d3, 10)
    push(d3, 20)
    push(d3, 30)
    push(d3, 40)
    push(d3, 30)
    cki(mc_min_mults(d3), 30000, "min [10,20,30,40,30]")

    // KAT 4: [40,20,30,10,30] -> min=26000
    let d4 = []
    push(d4, 40)
    push(d4, 20)
    push(d4, 30)
    push(d4, 10)
    push(d4, 30)
    cki(mc_min_mults(d4), 26000, "min [40,20,30,10,30]")

    // KAT 5: [5,10] -> single matrix, zero multiplications
    let d5 = []
    push(d5, 5)
    push(d5, 10)
    cki(mc_min_mults(d5), 0, "min [5,10] single matrix")

    // KAT 6: empty dims -> 0
    let d6 = []
    cki(mc_min_mults(d6), 0, "min [] empty")

    // KAT 7: single dim -> 0
    let d7 = []
    push(d7, 5)
    cki(mc_min_mults(d7), 0, "min [5] one dim")

    // KAT 8: mc_max_mults on [1,2,3,4]: max is A(BC)=2*3*4+1*2*4=24+8=32
    cki(mc_max_mults(d1), 32, "max [1,2,3,4]")

    // KAT 9: mc_max_mults [10,20,30] only one way same as min
    cki(mc_max_mults(d2), 6000, "max [10,20,30] only one order")

    // KAT 10: mc_max_mults [5,10] single matrix
    cki(mc_max_mults(d5), 0, "max [5,10] single matrix")

    print("PASS _dp_matrix_chain_test")
