import forge_session_mgr

fn main()
    let store = sm_new_store()
    assert(sm_session_count(store) == 0, "empty store")

    let r1 = sm_create(store, 3600, 1000)
    store = r1["store"]
    let sid1 = r1["session_id"]
    assert(sm_session_count(store) == 1, "1 session")
    assert(sm_active_count(store) == 1, "1 active")

    let r2 = sm_create(store, 1800, 1000)
    store = r2["store"]
    let sid2 = r2["session_id"]
    assert(sm_session_count(store) == 2, "2 sessions")

    store = sm_set(store, sid1, "user", "alice")
    store = sm_set(store, sid1, "role", "admin")
    assert(sm_get_val(store, sid1, "user") == "alice", "user=alice")
    assert(sm_get_val(store, sid1, "role") == "admin", "role=admin")
    assert(sm_get_val(store, sid1, "missing") == "", "missing key")

    let s1 = sm_get_session(store, sid1, 2000)
    assert(s1["valid"] == 1, "session valid")
    assert(s1["session_id"] == sid1, "correct id")

    let s2 = sm_get_session(store, sid2, 5000)
    assert(s2["valid"] == 0, "session expired (1800s TTL)")

    let s3 = sm_get_session(store, "fake_id", 1000)
    assert(s3["valid"] == 0, "fake session invalid")

    store = sm_destroy(store, sid1)
    let s4 = sm_get_session(store, sid1, 2000)
    assert(s4["valid"] == 0, "destroyed session invalid")
    assert(sm_active_count(store) == 0, "0 active after destroy+expire")

    assert(sm_get_val(store, "fake", "key") == "", "get from fake session")

    print("SESSION-MGR KAT PASS")
