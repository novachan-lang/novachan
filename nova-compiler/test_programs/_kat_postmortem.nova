import forge_postmortem

fn main()
    let pm = pm_new()
    pm = pm_create(pm, "PM-001", "Database outage", "P1", "alice")
    pm = pm_create(pm, "PM-002", "API latency spike", "P2", "bob")
    assert(pm_count(pm) == 2, "2 postmortems")
    assert(pm_has(pm, "PM-001") == 1, "has PM-001")

    let st = pm_status(pm, "PM-001")
    assert(unwrap(st) == "open", "open initially")

    let rc = pm_set_root_cause(pm, "PM-001", "Connection pool exhaustion")
    pm = unwrap(rc)
    let rcv = pm_root_cause(pm, "PM-001")
    assert(unwrap(rcv) == "Connection pool exhaustion", "root cause set")

    let a1 = pm_add_action(pm, "PM-001", "Increase pool size", "alice")
    pm = unwrap(a1)
    let a2 = pm_add_action(pm, "PM-001", "Add pool monitoring", "bob")
    pm = unwrap(a2)
    let ac = pm_action_count(pm, "PM-001")
    assert(unwrap(ac) == 2, "2 actions")
    assert(pm_total_actions(pm) == 2, "total 2")

    let c1 = pm_complete_action(pm, "PM-001", 0)
    pm = unwrap(c1)

    let cl = pm_close(pm, "PM-001")
    pm = unwrap(cl)
    let st2 = pm_status(pm, "PM-001")
    assert(unwrap(st2) == "closed", "closed")

    let norc = pm_root_cause(pm, "PM-002")
    assert(is_err(norc), "no root cause set")

    let bad = pm_status(pm, "PM-999")
    assert(is_err(bad), "not found")

    let oor = pm_complete_action(pm, "PM-001", 99)
    assert(is_err(oor), "out of range")

    print("POSTMORTEM KAT PASS")
