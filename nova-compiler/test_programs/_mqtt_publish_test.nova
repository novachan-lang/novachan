import std/net/mqtt_publish

fn main()
    // ── KAT 1: mqtt_publish("a/b", [104,105], 0, 0) ─────────────────────────
    // topic "a/b" length = 3
    // payload [104,105] = 2 bytes ("hi")
    // qos=0 so no packet_id in wire
    // Variable header: [0,3,'a','/','b'] + payload [104,105] = 7 bytes
    // Fixed header: [0x30, 7] = 2 bytes
    // Total = 9 bytes
    let payload0 = [104, 105]
    let pkt0 = mqtt_publish("a/b", payload0, 0, 0)

    if len(pkt0) != 9
        print("FAIL mqtt_publish qos0 pkt len: got "+str(len(pkt0))+" want 9")
        exit(1)

    // byte0 = 0x30 = 48 (PUBLISH type=3, flags=0)
    if pkt0[0] != 48
        print("FAIL mqtt_publish qos0 byte0: got "+str(pkt0[0])+" want 48 (0x30)")
        exit(1)

    // remlen = 7
    if pkt0[1] != 7
        print("FAIL mqtt_publish qos0 remlen: got "+str(pkt0[1])+" want 7")
        exit(1)

    // topic len hi = 0
    if pkt0[2] != 0
        print("FAIL mqtt_publish qos0 topic_len_hi: got "+str(pkt0[2])+" want 0")
        exit(1)

    // topic len lo = 3
    if pkt0[3] != 3
        print("FAIL mqtt_publish qos0 topic_len_lo: got "+str(pkt0[3])+" want 3")
        exit(1)

    // 'a' = 97
    if pkt0[4] != 97
        print("FAIL mqtt_publish qos0 topic[0] a: got "+str(pkt0[4])+" want 97")
        exit(1)

    // '/' = 47
    if pkt0[5] != 47
        print("FAIL mqtt_publish qos0 topic[1] /: got "+str(pkt0[5])+" want 47")
        exit(1)

    // 'b' = 98
    if pkt0[6] != 98
        print("FAIL mqtt_publish qos0 topic[2] b: got "+str(pkt0[6])+" want 98")
        exit(1)

    // payload[0] = 104
    if pkt0[7] != 104
        print("FAIL mqtt_publish qos0 payload[0]: got "+str(pkt0[7])+" want 104")
        exit(1)

    // payload[1] = 105
    if pkt0[8] != 105
        print("FAIL mqtt_publish qos0 payload[1]: got "+str(pkt0[8])+" want 105")
        exit(1)

    // ── KAT 2: qos=1 includes packet_id ──────────────────────────────────────
    // topic "a/b" = 3 bytes, u16-prefixed = 5 bytes
    // packet_id=42 = 2 bytes
    // payload [104,105] = 2 bytes
    // remlen = 5 + 2 + 2 = 9
    // Fixed header byte0: type=3, flags=(1<<1)=2 => 0x32=50
    let payload1 = [104, 105]
    let pkt1 = mqtt_publish("a/b", payload1, 1, 42)

    if len(pkt1) != 11
        print("FAIL mqtt_publish qos1 pkt len: got "+str(len(pkt1))+" want 11")
        exit(1)

    // byte0 = 0x32 = 50 (PUBLISH type=3, flags=2=qos1)
    if pkt1[0] != 50
        print("FAIL mqtt_publish qos1 byte0: got "+str(pkt1[0])+" want 50 (0x32)")
        exit(1)

    // remlen = 9
    if pkt1[1] != 9
        print("FAIL mqtt_publish qos1 remlen: got "+str(pkt1[1])+" want 9")
        exit(1)

    // packet_id at offset 7 (after 2-byte fixed hdr + 5-byte topic section)
    // pkt1[7] = packet_id_hi = 0, pkt1[8] = packet_id_lo = 42
    if pkt1[7] != 0
        print("FAIL mqtt_publish qos1 packet_id_hi: got "+str(pkt1[7])+" want 0")
        exit(1)
    if pkt1[8] != 42
        print("FAIL mqtt_publish qos1 packet_id_lo: got "+str(pkt1[8])+" want 42")
        exit(1)

    // ── KAT 3: decode round-trip qos=0 ───────────────────────────────────────
    let d0 = mqtt_publish_decode(pkt0)
    if not contains(d0, "topic")
        print("FAIL mqtt_publish decode qos0 missing topic")
        exit(1)
    if d0["topic"] != "a/b"
        print("FAIL mqtt_publish decode qos0 topic: got "+str(d0["topic"])+" want a/b")
        exit(1)
    if d0["qos"] != 0
        print("FAIL mqtt_publish decode qos0 qos: got "+str(d0["qos"])+" want 0")
        exit(1)
    let dp0 = d0["payload"]
    if len(dp0) != 2
        print("FAIL mqtt_publish decode qos0 payload len: got "+str(len(dp0))+" want 2")
        exit(1)
    if dp0[0] != 104
        print("FAIL mqtt_publish decode qos0 payload[0]: got "+str(dp0[0])+" want 104")
        exit(1)
    if dp0[1] != 105
        print("FAIL mqtt_publish decode qos0 payload[1]: got "+str(dp0[1])+" want 105")
        exit(1)

    // ── KAT 4: decode round-trip qos=1 ───────────────────────────────────────
    let d1 = mqtt_publish_decode(pkt1)
    if d1["topic"] != "a/b"
        print("FAIL mqtt_publish decode qos1 topic: got "+str(d1["topic"])+" want a/b")
        exit(1)
    if d1["qos"] != 1
        print("FAIL mqtt_publish decode qos1 qos: got "+str(d1["qos"])+" want 1")
        exit(1)
    if d1["packet_id"] != 42
        print("FAIL mqtt_publish decode qos1 packet_id: got "+str(d1["packet_id"])+" want 42")
        exit(1)
    let dp1 = d1["payload"]
    if len(dp1) != 2
        print("FAIL mqtt_publish decode qos1 payload len: got "+str(len(dp1))+" want 2")
        exit(1)
    if dp1[0] != 104
        print("FAIL mqtt_publish decode qos1 payload[0]: got "+str(dp1[0])+" want 104")
        exit(1)
    if dp1[1] != 105
        print("FAIL mqtt_publish decode qos1 payload[1]: got "+str(dp1[1])+" want 105")
        exit(1)

    print("PASS _mqtt_publish_test")
