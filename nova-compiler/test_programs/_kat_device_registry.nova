import forge_device_registry

fn main()
    let s = dr_new()
    assert(dr_device_count(s) == 0, "0 devices")
    assert(dr_online_count(s) == 0, "0 online")
    assert(dr_has_device(s, "d1") == 0, "d1 absent")

    s = dr_register(s, "d1", "sensor", "1.0.0")
    assert(dr_has_device(s, "d1") == 1, "d1 present")
    assert(dr_device_count(s) == 1, "1 device")

    let t1 = dr_get_type(s, "d1")
    assert(is_ok(t1), "type ok")
    assert(unwrap(t1) == "sensor", "type sensor")

    let f1 = dr_get_firmware(s, "d1")
    assert(is_ok(f1), "fw ok")
    assert(unwrap(f1) == "1.0.0", "fw 1.0.0")

    let st1 = dr_get_status(s, "d1")
    assert(is_ok(st1), "status ok")
    assert(unwrap(st1) == "offline", "default offline")

    let u1 = dr_update_firmware(s, "d1", "1.1.0")
    assert(is_ok(u1), "update ok")
    let f2 = dr_get_firmware(s, "d1")
    assert(unwrap(f2) == "1.1.0", "fw updated")

    let so1 = dr_set_status(s, "d1", "online")
    assert(is_ok(so1), "set online ok")
    assert(dr_online_count(s) == 1, "1 online")
    let st2 = dr_get_status(s, "d1")
    assert(unwrap(st2) == "online", "status online")

    let so2 = dr_set_status(s, "d1", "offline")
    assert(is_ok(so2), "set offline ok")
    assert(dr_online_count(s) == 0, "0 online after offline")

    s = dr_register(s, "d2", "gateway", "2.0.0")
    assert(dr_device_count(s) == 2, "2 devices")
    let so3 = dr_set_status(s, "d2", "online")
    assert(is_ok(so3), "set d2 online ok")
    assert(dr_online_count(s) == 1, "1 online (d2)")

    // re-registering d1 must not double-count or reset status
    s = dr_register(s, "d1", "sensor-v2", "1.2.0")
    assert(dr_device_count(s) == 2, "still 2 devices after re-register")
    let st3 = dr_get_status(s, "d1")
    assert(unwrap(st3) == "offline", "status preserved across re-register")

    let missing = dr_get_type(s, "d3")
    assert(is_err(missing), "unknown device err")

    print("DEVICE-REGISTRY KAT PASS")
