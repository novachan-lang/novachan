import forge_pwpolicy

fn main()
    // pw_classes: count character types
    assert(pw_classes("abc") == 1, "lower only")
    assert(pw_classes("abcABC") == 2, "lower+upper")
    assert(pw_classes("abcABC123") == 3, "lower+upper+digit")
    assert(pw_classes("aA1!") == 4, "all four")

    // pw_entropy: bits estimate
    let e1 = pw_entropy("aaaa")
    assert(e1 > 0, "nonzero entropy")
    let e2 = pw_entropy("aA1!aA1!")
    assert(e2 > e1, "more classes = more entropy")

    // pw_check: returns list of errors
    let ok = pw_check("Str0ng!Pass", 8, 3)
    assert(len(ok) == 0, "good password passes")
    let bad = pw_check("ab", 8, 3)
    assert(len(bad) > 0, "short password fails")

    // pw_check detects common passwords
    let common = pw_check("password", 4, 1)
    assert(len(common) > 0, "common pw rejected")

    // pw_ok: combined check with entropy
    assert(pw_ok("MyStr0ng!Pass99", 8, 3, 40), "strong pw ok")
    assert(not pw_ok("ab", 8, 3, 40), "weak pw not ok")

    // pw_score: 0..4
    let s0 = pw_score("ab")
    assert(s0 == 0, "very weak = 0")
    let s4 = pw_score("MyVery$tr0ng!Passw0rd!XYZ")
    assert(s4 >= 3, "very strong >= 3")

    print("PWPOLICY KAT PASS")
