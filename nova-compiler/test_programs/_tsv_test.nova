// KAT probe for std/data/tsv — Tab-Separated Values
//
// All answers hand-computed.
// TSV document under test: "a\tb\nc\td"  (chr(9)=tab, chr(10)=newline)
import std/data/tsv

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn main()
    let tab = chr(9)
    let nl  = chr(10)

    // ── Spec fixture: "a\tb\nc\td" ───────────────────────────────────────────
    let t = "a" + tab + "b" + nl + "c" + tab + "d"

    // ── KAT 1: tsv_parse returns 2 rows ──────────────────────────────────────
    let rows = tsv_parse(t)
    cki("kat1-row-count", len(rows), 2)
    print("KAT 1 PASS: tsv_parse row count == 2")

    // ── KAT 2: first row has 2 fields: "a" and "b" ───────────────────────────
    let row0 = rows[0]
    cki("kat2-row0-len", len(row0), 2)
    cks("kat2-row0-f0", row0[0], "a")
    cks("kat2-row0-f1", row0[1], "b")
    print("KAT 2 PASS: first row fields == [\"a\", \"b\"]")

    // ── KAT 3: second row has 2 fields: "c" and "d" ──────────────────────────
    let row1 = rows[1]
    cki("kat3-row1-len", len(row1), 2)
    cks("kat3-row1-f0", row1[0], "c")
    cks("kat3-row1-f1", row1[1], "d")
    print("KAT 3 PASS: second row fields == [\"c\", \"d\"]")

    // ── KAT 4: tsv_format round-trips correctly ───────────────────────────────
    // Build rows [["x","y"],["1","2"]], format, then parse back and verify.
    let r0 = ["x", "y"]
    let r1 = ["1", "2"]
    let src_rows = [r0, r1]
    let formatted = tsv_format(src_rows)
    // formatted should be "x\ty\n1\t2"
    let want_fmt = "x" + tab + "y" + nl + "1" + tab + "2"
    cks("kat4-format-text", formatted, want_fmt)
    print("KAT 4 PASS: tsv_format text == \"x\\ty\\n1\\t2\"")

    // ── KAT 5: parse the formatted text back and verify same rows ─────────────
    let rt_rows = tsv_parse(formatted)
    cki("kat5-rt-row-count", len(rt_rows), 2)
    let rt0 = rt_rows[0]
    let rt1 = rt_rows[1]
    cks("kat5-rt-r0f0", rt0[0], "x")
    cks("kat5-rt-r0f1", rt0[1], "y")
    cks("kat5-rt-r1f0", rt1[0], "1")
    cks("kat5-rt-r1f1", rt1[1], "2")
    print("KAT 5 PASS: round-trip parse matches original rows")

    // ── KAT 6: tsv_parse_dicts with header "name\tage" and data "bob\t30" ─────
    let hdr_txt = "name" + tab + "age" + nl + "bob" + tab + "30"
    let dicts = tsv_parse_dicts(hdr_txt)
    cki("kat6-dicts-len", len(dicts), 1)
    let d0 = dicts[0]
    cks("kat6-name", d0["name"], "bob")
    cks("kat6-age",  d0["age"],  "30")
    print("KAT 6 PASS: tsv_parse_dicts gives {\"name\":\"bob\",\"age\":\"30\"}")

    // ── KAT 7: tsv_parse skips trailing empty line (trailing newline) ─────────
    let t_trail = "p" + tab + "q" + nl + "r" + tab + "s" + nl
    let rows_trail = tsv_parse(t_trail)
    cki("kat7-trail-rows", len(rows_trail), 2)
    print("KAT 7 PASS: trailing newline produces no extra empty row")

    // ── KAT 8: tsv_parse_dicts with multiple data rows ────────────────────────
    let multi = "x" + tab + "y" + nl + "1" + tab + "2" + nl + "3" + tab + "4"
    let mdicts = tsv_parse_dicts(multi)
    cki("kat8-multi-len", len(mdicts), 2)
    let md0 = mdicts[0]
    let md1 = mdicts[1]
    cks("kat8-row0-x", md0["x"], "1")
    cks("kat8-row0-y", md0["y"], "2")
    cks("kat8-row1-x", md1["x"], "3")
    cks("kat8-row1-y", md1["y"], "4")
    print("KAT 8 PASS: tsv_parse_dicts multiple rows correct")

    print("_tsv_test passed")
