import std/game/bridge

fn chki(name: string, got: int, want: int)
    if got != want
        print("FAIL bridge " + name + ": got " + str(got) + " want " + str(want))
        exit(1)

fn chkb(name: string, got: bool, want: bool)
    let gots = "false"
    if got
        gots = "true"
    let wants = "false"
    if want
        wants = "true"
    if got != want
        print("FAIL bridge " + name + ": got " + gots + " want " + wants)
        exit(1)

fn main()
    // ── KAT 1: bridge_hcp A K Q J same suit = 10 ──────────────────────────
    let topfour = []
    push(topfour, [14, 3])
    push(topfour, [13, 3])
    push(topfour, [12, 3])
    push(topfour, [11, 3])
    chki("hcp_AKQJ", bridge_hcp(topfour), 10)

    // ── KAT 2: bridge_hcp 4 aces = 16 ────────────────────────────────────
    let aces = []
    push(aces, [14, 0])
    push(aces, [14, 1])
    push(aces, [14, 2])
    push(aces, [14, 3])
    chki("hcp_4aces", bridge_hcp(aces), 16)

    // ── KAT 3: bridge_hcp mixed hand ─────────────────────────────────────
    // A(4) + K(3) + Q(2) + J(1) + rest no pts = 10
    let mixed = []
    push(mixed, [14, 0])
    push(mixed, [13, 1])
    push(mixed, [12, 2])
    push(mixed, [11, 3])
    push(mixed, [10, 0])
    push(mixed, [9, 1])
    push(mixed, [8, 2])
    push(mixed, [7, 3])
    push(mixed, [6, 0])
    push(mixed, [5, 1])
    push(mixed, [4, 2])
    push(mixed, [3, 3])
    push(mixed, [2, 0])
    chki("hcp_mixed_13cards", bridge_hcp(mixed), 10)

    // ── KAT 4: bridge_suit_lengths sums to 13 ────────────────────────────
    let lengths = bridge_suit_lengths(mixed)
    let total_cards = lengths[0] + lengths[1] + lengths[2] + lengths[3]
    chki("suit_lengths_sum", total_cards, 13)

    // ── KAT 5: bridge_suit_lengths correct per suit ───────────────────────
    // mixed hand: clubs=[14,13,8,2] -> wait, let me trace:
    // suits: [14,0]=C, [13,1]=D, [12,2]=H, [11,3]=S, [10,0]=C, [9,1]=D,
    //        [8,2]=H,  [7,3]=S,  [6,0]=C,  [5,1]=D,  [4,2]=H, [3,3]=S, [2,0]=C
    // clubs=4 (14,10,6,2), diamonds=3 (13,9,5), hearts=3 (12,8,4), spades=3 (11,7,3)
    chki("suit_clubs",    lengths[0], 4)
    chki("suit_diamonds", lengths[1], 3)
    chki("suit_hearts",   lengths[2], 3)
    chki("suit_spades",   lengths[3], 3)

    // ── KAT 6: bridge_dist_points void = 3 ───────────────────────────────
    // Build a hand with a void in one suit: 5 clubs, 4 diamonds, 4 hearts, 0 spades
    let void_hand = []
    push(void_hand, [2, 0])
    push(void_hand, [3, 0])
    push(void_hand, [4, 0])
    push(void_hand, [5, 0])
    push(void_hand, [6, 0])
    push(void_hand, [7, 1])
    push(void_hand, [8, 1])
    push(void_hand, [9, 1])
    push(void_hand, [10, 1])
    push(void_hand, [11, 2])
    push(void_hand, [12, 2])
    push(void_hand, [13, 2])
    push(void_hand, [14, 2])
    // clubs=5, diamonds=4, hearts=4, spades=0 -> dist = 0+0+0+3 = 3
    chki("dist_void", bridge_dist_points(void_hand), 3)

    // ── KAT 7: bridge_dist_points singleton = 2 ───────────────────────────
    // Build hand with a singleton: 5c, 4d, 3h, 1s
    let sing_hand = []
    push(sing_hand, [2, 0])
    push(sing_hand, [3, 0])
    push(sing_hand, [4, 0])
    push(sing_hand, [5, 0])
    push(sing_hand, [6, 0])
    push(sing_hand, [7, 1])
    push(sing_hand, [8, 1])
    push(sing_hand, [9, 1])
    push(sing_hand, [10, 1])
    push(sing_hand, [11, 2])
    push(sing_hand, [12, 2])
    push(sing_hand, [13, 2])
    push(sing_hand, [14, 3])
    // clubs=5, diamonds=4, hearts=3, spades=1 -> dist = 0+0+0+2 = 2
    chki("dist_singleton", bridge_dist_points(sing_hand), 2)

    // ── KAT 8: bridge_dist_points doubleton = 1 ───────────────────────────
    // 5c, 4d, 2h, 2s
    let dbl_hand = []
    push(dbl_hand, [2, 0])
    push(dbl_hand, [3, 0])
    push(dbl_hand, [4, 0])
    push(dbl_hand, [5, 0])
    push(dbl_hand, [6, 0])
    push(dbl_hand, [7, 1])
    push(dbl_hand, [8, 1])
    push(dbl_hand, [9, 1])
    push(dbl_hand, [10, 1])
    push(dbl_hand, [11, 2])
    push(dbl_hand, [12, 2])
    push(dbl_hand, [13, 3])
    push(dbl_hand, [14, 3])
    // clubs=5, diamonds=4, hearts=2, spades=2 -> dist = 0+0+1+1 = 2
    chki("dist_doubleton", bridge_dist_points(dbl_hand), 2)

    // ── KAT 9: bridge_total ───────────────────────────────────────────────
    // mixed hand: hcp=10, dist=0 (4-3-3-3: only one len<=2 => wait, min=3)
    // clubs=4,diamonds=3,hearts=3,spades=3 -> all >=3, dist=0
    chki("total_mixed", bridge_total(mixed), 10)

    // ── KAT 10: bridge_is_balanced — 4-3-3-3 ────────────────────────────
    // mixed hand is 4-3-3-3
    chkb("balanced_4333", bridge_is_balanced(mixed), true)

    // ── KAT 11: bridge_is_balanced — 4-4-3-2 ────────────────────────────
    // Build 4-4-3-2 hand: 4 clubs, 4 diamonds, 3 hearts, 2 spades
    let b4432 = []
    push(b4432, [2, 0])
    push(b4432, [3, 0])
    push(b4432, [4, 0])
    push(b4432, [5, 0])
    push(b4432, [6, 1])
    push(b4432, [7, 1])
    push(b4432, [8, 1])
    push(b4432, [9, 1])
    push(b4432, [10, 2])
    push(b4432, [11, 2])
    push(b4432, [12, 2])
    push(b4432, [13, 3])
    push(b4432, [14, 3])
    chkb("balanced_4432", bridge_is_balanced(b4432), true)

    // ── KAT 12: bridge_is_balanced — 5-3-3-2 ────────────────────────────
    // 5 clubs, 3 diamonds, 3 hearts, 2 spades
    let b5332 = []
    push(b5332, [2, 0])
    push(b5332, [3, 0])
    push(b5332, [4, 0])
    push(b5332, [5, 0])
    push(b5332, [6, 0])
    push(b5332, [7, 1])
    push(b5332, [8, 1])
    push(b5332, [9, 1])
    push(b5332, [10, 2])
    push(b5332, [11, 2])
    push(b5332, [12, 2])
    push(b5332, [13, 3])
    push(b5332, [14, 3])
    chkb("balanced_5332", bridge_is_balanced(b5332), true)

    // ── KAT 13: bridge_is_balanced — unbalanced (void) ───────────────────
    // void_hand is 5-4-4-0 -> unbalanced
    chkb("unbalanced_void", bridge_is_balanced(void_hand), false)

    // ── KAT 14: bridge_is_balanced — unbalanced 6-4-2-1 ─────────────────
    let b6421 = []
    push(b6421, [2, 0])
    push(b6421, [3, 0])
    push(b6421, [4, 0])
    push(b6421, [5, 0])
    push(b6421, [6, 0])
    push(b6421, [7, 0])
    push(b6421, [8, 1])
    push(b6421, [9, 1])
    push(b6421, [10, 1])
    push(b6421, [11, 1])
    push(b6421, [12, 2])
    push(b6421, [13, 2])
    push(b6421, [14, 3])
    chkb("unbalanced_6421", bridge_is_balanced(b6421), false)

    // ── KAT 15: bridge_hcp 0 for a low hand ─────────────────────────────
    let low_hand = []
    push(low_hand, [2, 0])
    push(low_hand, [3, 1])
    push(low_hand, [4, 2])
    push(low_hand, [5, 3])
    push(low_hand, [6, 0])
    push(low_hand, [7, 1])
    push(low_hand, [8, 2])
    push(low_hand, [9, 3])
    push(low_hand, [10, 0])
    push(low_hand, [2, 1])
    push(low_hand, [3, 2])
    push(low_hand, [4, 3])
    push(low_hand, [5, 0])
    chki("hcp_zero", bridge_hcp(low_hand), 0)

    print("PASS _bridge_test")
