// KAT: an unmappable row must NOT vanish silently.
// A row that failed struct mapping used to be discarded with NO signal, so data loss looked exactly
// like "the query matched fewer rows" -- one nullable column once made rows disappear from a typed
// read while orm_count still counted them. Mapping stays LENIENT (one bad row must not abort a page of
// results), but a drop is now ANNOUNCED with the struct name and the mapper's own reason.
import forge_orm

type Rd
    id: int
    name: string
    qty: int

fn main()
    let db = unwrap(orm_open("sqlite://_kat_rowdrop.db"))
    let d = orm_exec(db, "DROP TABLE IF EXISTS Rd", [])
    if is_err(d)
        print("drop failed")
    let c = orm_exec(db, "CREATE TABLE Rd (id INTEGER PRIMARY KEY, name TEXT, qty INTEGER)", [])
    if is_err(c)
        print("create failed")

    let i1 = orm_exec(db, "INSERT INTO Rd (name, qty) VALUES (?, ?)", ["good", 10])
    if is_err(i1)
        print("seed failed")
    let i2 = orm_exec(db, "INSERT INTO Rd (name, qty) VALUES ('nullqty', NULL)", [])
    if is_err(i2)
        print("null seed failed")

    // the clean path must still map correctly
    let rows: list<Rd> = orm_all(db, "SELECT id, name, qty FROM Rd ORDER BY id", [])
    let n = orm_count(db, "Rd", "", [])
    print("table has {n} row(s); typed read mapped {len(rows)}")

    if len(rows) < n
        print("  -> {n - len(rows)} row(s) were dropped; the [nova] line above names which and why")
    for r in rows
        print("  mapped id={r.id} name={r.name} qty={r.qty}")

    if len(rows) == 0
        print("_kat_rowdrop FAILED: nothing mapped at all")
        exit(1)
    print("_kat_rowdrop passed")
