// rtti_json_test -- THE keystone proof (Phase 0a S2). A struct ERASED to `any` must
// json-serialize as an OBJECT {"field":value} -- with bool/float/string/int/nested ALL
// rendered correctly (type-aware via the hash-keyed RTTI field metadata) -- not garbage.
// Statically-typed structs already work via the compile-time <T>__to_json; this forces the
// value through `fn erase(x) -> any` so the RUNTIME path is exercised, and asserts the
// erased output EQUALS the static output.

type Rec
    id: int
    active: bool
    ratio: float
    name: string

type Outer
    tag: int
    inner: Rec

fn erase(x) -> any
    x

fn main()
    let q = chr(34)
    let lb = chr(123)
    let rb = chr(125)

    let r = Rec(7, true, 2.5, "ada")
    // expected object (no spaces, bool->true, float->2.5, string quoted) -- matches __to_json
    let exp = lb + q+"id"+q+":7," + q+"active"+q+":true," + q+"ratio"+q+":2.5," + q+"name"+q+":"+q+"ada"+q + rb

    // 1) static path (compile-time __to_json) -- regression guard + reference
    assert_eq(json_stringify(r), exp)

    // 2) ERASED flat struct -> runtime struct case; bool/float/string/int all correct
    let re = erase(r)
    assert_eq(json_stringify(re), exp)

    // 3) ERASED nested struct -> recursion renders the inner struct as a nested object
    let o = Outer(1, Rec(7, true, 2.5, "ada"))
    let oe = erase(o)
    let nexp = lb + q+"tag"+q+":1," + q+"inner"+q+":" + exp + rb
    assert_eq(json_stringify(oe), nexp)

    print("rtti_json_test passed")
