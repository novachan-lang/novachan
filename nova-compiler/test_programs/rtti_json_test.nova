// rtti_json_test -- THE keystone proof (Phase 0a S2).
// A struct ERASED to `any` must json-serialize as an OBJECT {"field":value}, not as
// garbage / a bare integer. Statically-typed structs already work via the compile-time
// <Type>__to_json; this test forces the value through an `any` boundary so the RUNTIME
// path (nova_rt_json_stringify -> json_stringify_value struct case, keyed on the slot-0
// hash -> registered field metadata) is the one exercised. Covers: erased flat struct,
// erased nested struct (recursion), and the still-working static path (no regression).

type Inner
    a: int
    b: int

type Outer
    id: int
    pt: Inner

// returns `any` -> the compiler cannot resolve a concrete <Type>__to_json at the call
// site, so json_stringify falls to the runtime path. This is the erasure the keystone fixes.
fn erase(x) -> any
    x

fn main()
    let q = chr(34)
    let lb = chr(123)
    let rb = chr(125)

    let p = Inner(3, 4)

    // 1) static path (compile-time __to_json) still correct -- regression guard
    assert_eq(json_stringify(p), lb + q + "a" + q + ":3," + q + "b" + q + ":4" + rb)

    // 2) ERASED flat struct -> runtime struct case -> object (the S2 fix)
    let pe = erase(p)
    assert_eq(json_stringify(pe), lb + q + "a" + q + ":3," + q + "b" + q + ":4" + rb)

    // 3) ERASED nested struct -> recursion renders the inner struct as a nested object
    let o = Outer(7, Inner(1, 2))
    let oe = erase(o)
    let inner = lb + q + "a" + q + ":1," + q + "b" + q + ":2" + rb
    let exp = lb + q + "id" + q + ":7," + q + "pt" + q + ":" + inner + rb
    assert_eq(json_stringify(oe), exp)

    print("rtti_json_test passed")
