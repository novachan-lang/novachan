// rex — a guaranteed LINEAR-TIME regex engine (Thompson NFA simulation), immune to the
// catastrophic backtracking that plagues PCRE-style engines on inputs like (a+)+$. A
// pattern compiles to a small instruction program; matching steps a SET of NFA threads
// through the input in lockstep, so time is O(input * program) regardless of pattern.
// Supports: literal chars, . (any), * + ? (greedy), | (alternation), (...) grouping.

// ── parse pattern -> tree ────────────────────────────────────────────────────
// node = ["char", code] | ["any"] | ["concat", a, b] | ["alt", a, b]
//      | ["star", a] | ["plus", a] | ["quest", a] | ["empty"]

fn _peek(s, p)
    if p < len(s)
        return s[p]
    return ""

fn _parse_alt(s, p)
    let lhs = _parse_concat(s, p)
    let node = lhs[0]
    let pos = lhs[1]
    while _peek(s, pos) == "|"
        let rhs = _parse_concat(s, pos + 1)
        node = ["alt", node, rhs[0]]
        pos = rhs[1]
    return [node, pos]

fn _parse_concat(s, p)
    let node = ["empty"]
    let pos = p
    let first = 1
    while pos < len(s) and _peek(s, pos) != "|" and _peek(s, pos) != ")"
        let r = _parse_repeat(s, pos)
        if first == 1
            node = r[0]
            first = 0
        else
            node = ["concat", node, r[0]]
        pos = r[1]
    return [node, pos]

// Expand a {n,m} quantifier into the existing star/quest/concat nodes (no matcher change):
// n required copies, then either (m-n) optional copies (bounded) or a star (open-ended {n,}).
fn _expand_repeat(node, n, m, has_max)
    let result = ["empty"]
    let i = 0
    while i < n
        if i == 0
            result = node
        else
            result = ["concat", result, node]
        i = i + 1
    if has_max
        let opt = m - n
        let j = 0
        while j < opt
            result = ["concat", result, ["quest", node]]
            j = j + 1
    else
        result = ["concat", result, ["star", node]]
    return result

fn _parse_repeat(s, p)
    let a = _parse_atom(s, p)
    let node = a[0]
    let pos = a[1]
    let c = _peek(s, pos)
    if c == "*"
        return [["star", node], pos + 1]
    if c == "+"
        return [["plus", node], pos + 1]
    if c == "?"
        return [["quest", node], pos + 1]
    if c == "\{"
        // {n} | {n,} | {n,m}  — bounded repetition
        let q = pos + 1
        let n = 0
        let saw_n = 0
        while q < len(s) and _peek(s, q) >= "0" and _peek(s, q) <= "9"
            n = n * 10 + (ord(s[q]) - 48)
            saw_n = 1
            q = q + 1
        let m = n
        let has_max = 1
        if _peek(s, q) == ","
            q = q + 1
            if _peek(s, q) >= "0" and _peek(s, q) <= "9"
                m = 0
                while q < len(s) and _peek(s, q) >= "0" and _peek(s, q) <= "9"
                    m = m * 10 + (ord(s[q]) - 48)
                    q = q + 1
            else
                has_max = 0          // {n,} — open-ended
        if _peek(s, q) == "\}" and saw_n == 1
            return [_expand_repeat(node, n, m, has_max), q + 1]
    return [node, pos]

// char class [abc] [a-z] [^...] -> ["class", ranges, neg]; ranges = list of [lo,hi]
fn _parse_class(s, p)
    let neg = 0
    let pos = p
    if _peek(s, pos) == "^"
        neg = 1
        pos = pos + 1
    let ranges = []
    while pos < len(s) and _peek(s, pos) != "]"
        let lo = ord(s[pos])
        if _peek(s, pos + 1) == "-" and pos + 2 < len(s) and _peek(s, pos + 2) != "]"
            let hi = ord(s[pos + 2])
            push(ranges, [lo, hi])
            pos = pos + 3
        else
            push(ranges, [lo, lo])
            pos = pos + 1
    if _peek(s, pos) == "]"
        pos = pos + 1
    return [["class", ranges, neg], pos]

fn _unicode_prop_ranges(name)
    if name == "L" or name == "Letter"
        return [[65, 90], [97, 122], [192, 687], [880, 1023], [1024, 1279], [1280, 1535], [1536, 1791], [2304, 2431], [2432, 2559], [2560, 2687], [2688, 2815], [2816, 2943], [2944, 3071], [3072, 3199], [3200, 3327], [3328, 3455], [3456, 3583], [3584, 3711], [3712, 3839], [3840, 4095], [4096, 4255], [4256, 4351], [4352, 4607], [4608, 4991], [4992, 5119], [5120, 5759], [5760, 5791], [5792, 5887], [5888, 5919], [5920, 5951], [5984, 6015], [6016, 6143], [6144, 6319], [6400, 6479], [6480, 6527], [6528, 6623], [6656, 6687], [7424, 7679], [7680, 7935], [7936, 8191], [8304, 8351], [11264, 11359], [11360, 11391], [11392, 11519], [11520, 11567], [12352, 12447], [12448, 12543], [12544, 12591], [13312, 19903], [19968, 40959], [44032, 55203], [63744, 64255], [64256, 64335], [65136, 65279], [65296, 65370]]
    if name == "N" or name == "Number"
        return [[48, 57], [178, 179], [185, 185], [188, 190], [1632, 1641], [1776, 1785], [1984, 1993], [2406, 2415], [2534, 2543], [2662, 2671], [2790, 2799], [2918, 2927], [3046, 3055], [3174, 3183], [3302, 3311], [3430, 3439], [3558, 3567], [3664, 3673], [3792, 3801], [3872, 3881], [4160, 4169], [6112, 6121], [6160, 6169], [6470, 6479], [65296, 65305]]
    if name == "Z" or name == "Separator"
        return [[32, 32], [160, 160], [5760, 5760], [8192, 8202], [8232, 8233], [8239, 8239], [8287, 8287], [12288, 12288]]
    if name == "S" or name == "Symbol"
        return [[36, 36], [43, 43], [60, 62], [94, 94], [96, 96], [124, 124], [126, 126], [162, 169], [172, 172], [174, 177], [8352, 8399], [8448, 8527], [8592, 8703], [8704, 8959], [8960, 9215], [9472, 9599], [9600, 9631], [9632, 9727], [9728, 9983], [9984, 10175], [10176, 10223], [10224, 10239], [10240, 10495]]
    if name == "P" or name == "Punctuation"
        return [[33, 35], [37, 42], [44, 47], [58, 59], [63, 64], [91, 93], [95, 95], [123, 123], [125, 125], [161, 161], [171, 171], [183, 183], [187, 187], [191, 191], [8208, 8231], [8240, 8286]]
    return []

fn _parse_atom(s, p)
    let c = _peek(s, p)
    if c == "("
        // lookahead: (?=...) positive, (?!...) negative
        if _peek(s, p + 1) == "?" and (_peek(s, p + 2) == "=" or _peek(s, p + 2) == "!")
            let la_positive = 1
            if _peek(s, p + 2) == "!"
                la_positive = 0
            let la_inner = _parse_alt(s, p + 3)
            let la_pos = la_inner[1]
            if _peek(s, la_pos) == ")"
                la_pos = la_pos + 1
            return [["lookahead", la_inner[0], la_positive], la_pos]
        // lookbehind: (?<=...) positive, (?<!...) negative
        if _peek(s, p + 1) == "?" and _peek(s, p + 2) == "<" and (_peek(s, p + 3) == "=" or _peek(s, p + 3) == "!")
            let lb_positive = 1
            if _peek(s, p + 3) == "!"
                lb_positive = 0
            let lb_inner = _parse_alt(s, p + 4)
            let lb_pos = lb_inner[1]
            if _peek(s, lb_pos) == ")"
                lb_pos = lb_pos + 1
            return [["lookbehind", lb_inner[0], lb_positive], lb_pos]
        // capturing group `(...)`, or named `(?<name>...)`. Indices are assigned
        // left-to-right (by opening paren) in _number_groups after the parse.
        let pos = p + 1
        let gname = ""
        if _peek(s, pos) == "?" and _peek(s, pos + 1) == "<"
            pos = pos + 2
            while pos < len(s) and _peek(s, pos) != ">"
                gname = gname + s[pos]
                pos = pos + 1
            if _peek(s, pos) == ">"
                pos = pos + 1
        let inner = _parse_alt(s, pos)
        let ipos = inner[1]
        if _peek(s, ipos) == ")"
            ipos = ipos + 1
        return [["group", 0 - 1, gname, inner[0]], ipos]
    if c == "["
        return _parse_class(s, p + 1)
    if c == "."
        return [["any"], p + 1]
    if c == chr(92)            // backslash: shorthand class (\d \w \s + negations) or escaped literal
        let nx = _peek(s, p + 1)
        let digit = [[48, 57]]
        let word = [[48, 57], [65, 90], [97, 122], [95, 95]]
        let space = [[32, 32], [9, 9], [10, 10], [13, 13], [12, 12], [11, 11]]
        if nx == "d"
            return [["class", digit, 0], p + 2]
        if nx == "D"
            return [["class", digit, 1], p + 2]
        if nx == "w"
            return [["class", word, 0], p + 2]
        if nx == "W"
            return [["class", word, 1], p + 2]
        if nx == "s"
            return [["class", space, 0], p + 2]
        if nx == "S"
            return [["class", space, 1], p + 2]
        if (nx == "p" or nx == "P") and _peek(s, p + 2) == "\{"
            let pp = p + 3
            let pname = ""
            while pp < len(s) and _peek(s, pp) != "\}"
                pname = pname + s[pp]
                pp = pp + 1
            if _peek(s, pp) == "\}"
                pp = pp + 1
            let pranges = _unicode_prop_ranges(pname)
            let pneg = 0
            if nx == "P"
                pneg = 1
            return [["class", pranges, pneg], pp]
        return [["char", ord(nx)], p + 2]
    return [["char", ord(c)], p + 1]

// ── compile tree -> instruction program ──────────────────────────────────────
// instr = [op, a, b]. op: "char"(a=code) "any" "split"(a,b=pcs) "jmp"(a=pc) "match"

fn _emit(prog, instr)
    push(prog, instr)
    return len(prog) - 1

// Assign capture-group indices left-to-right by opening paren (pre-order). gc is a
// 1-element mutable counter; group 0 is reserved for the whole match, so explicit
// groups start at 1. Returns the numbered tree.
fn _number_groups(node, gc)
    let t = node[0]
    if t == "group"
        let idx = gc[0]
        gc[0] = idx + 1
        let inner = _number_groups(node[3], gc)
        return ["group", idx, node[2], inner]
    if t == "concat"
        return ["concat", _number_groups(node[1], gc), _number_groups(node[2], gc)]
    if t == "alt"
        return ["alt", _number_groups(node[1], gc), _number_groups(node[2], gc)]
    if t == "star"
        return ["star", _number_groups(node[1], gc)]
    if t == "plus"
        return ["plus", _number_groups(node[1], gc)]
    if t == "quest"
        return ["quest", _number_groups(node[1], gc)]
    return node

fn _compile_node(prog, node)
    let t = node[0]
    if t == "empty"
        return 0
    if t == "char"
        _emit(prog, ["char", node[1], 0])
        return 0
    if t == "any"
        _emit(prog, ["any", 0, 0])
        return 0
    if t == "class"
        _emit(prog, ["class", node[1], node[2]])
        return 0
    if t == "group"
        // save 2k at start, save 2k+1 at end; the start-save carries the name (if any)
        // so a named lookup can map name -> group index by scanning the program.
        _emit(prog, ["save", 2 * node[1], node[2]])
        _compile_node(prog, node[3])
        _emit(prog, ["save", 2 * node[1] + 1, ""])
        return 0
    if t == "concat"
        _compile_node(prog, node[1])
        _compile_node(prog, node[2])
        return 0
    if t == "alt"
        let s = _emit(prog, ["split", 0, 0])
        prog[s] = ["split", len(prog), 0]      // target1 = start of left
        _compile_node(prog, node[1])
        let j = _emit(prog, ["jmp", 0, 0])
        // patch split target2 = start of right (current end)
        let sp = prog[s]
        prog[s] = ["split", sp[1], len(prog)]
        _compile_node(prog, node[2])
        prog[j] = ["jmp", len(prog), 0]        // jmp over right to end
        return 0
    if t == "star"
        let s = _emit(prog, ["split", 0, 0])
        prog[s] = ["split", len(prog), 0]      // enter body
        _compile_node(prog, node[1])
        _emit(prog, ["jmp", s, 0])             // loop back to split
        let sp = prog[s]
        prog[s] = ["split", sp[1], len(prog)]  // exit = current end
        return 0
    if t == "plus"
        let body = len(prog)
        _compile_node(prog, node[1])
        let s = _emit(prog, ["split", body, 0])
        prog[s] = ["split", body, len(prog)]   // loop to body or exit
        return 0
    if t == "quest"
        let s = _emit(prog, ["split", 0, 0])
        prog[s] = ["split", len(prog), 0]      // body
        _compile_node(prog, node[1])
        let sp = prog[s]
        prog[s] = ["split", sp[1], len(prog)]  // skip = end
        return 0
    if t == "lookahead"
        let sub_prog = []
        _compile_node(sub_prog, node[1])
        _emit(sub_prog, ["match", 0, 0])
        _emit(prog, ["lookahead", sub_prog, node[2]])
        return 0
    if t == "lookbehind"
        let sub_prog = []
        _compile_node(sub_prog, node[1])
        _emit(sub_prog, ["match", 0, 0])
        _emit(prog, ["lookbehind", sub_prog, node[2]])
        return 0
    return 0

fn rex_compile(pattern)
    let prog = []
    let parsed = _parse_alt(pattern, 0)
    let numbered = _number_groups(parsed[0], [1])
    _compile_node(prog, numbered)
    _emit(prog, ["match", 0, 0])
    return prog

// ── lookahead sub-match: does any PREFIX of input (from pos) match sub_prog? ──
fn _prefix_match(sub_prog, input, pos)
    let clist = []
    _la_add(sub_prog, clist, 0)
    if _la_has_match(sub_prog, clist)
        return 1
    let i = pos
    while i < len(input)
        let code = ord(input[i])
        let nlist = []
        for pc in clist
            let instr = sub_prog[pc]
            if instr[0] == "char"
                if code == instr[1]
                    _la_add(sub_prog, nlist, pc + 1)
            else if instr[0] == "any"
                _la_add(sub_prog, nlist, pc + 1)
            else if instr[0] == "class"
                let matched = 0
                for rng in instr[1]
                    if code >= rng[0] and code <= rng[1]
                        matched = 1
                if instr[2] == 1
                    matched = 1 - matched
                if matched == 1
                    _la_add(sub_prog, nlist, pc + 1)
        if _la_has_match(sub_prog, nlist)
            return 1
        if len(nlist) == 0
            return 0
        clist = nlist
        i = i + 1
    return 0

fn _la_add(prog, lst, pc)
    if contains(lst, pc)
        return 0
    let instr = prog[pc]
    if instr[0] == "split"
        push(lst, pc)
        _la_add(prog, lst, instr[1])
        _la_add(prog, lst, instr[2])
    else if instr[0] == "jmp"
        push(lst, pc)
        _la_add(prog, lst, instr[1])
    else if instr[0] == "save"
        push(lst, pc)
        _la_add(prog, lst, pc + 1)
    else
        push(lst, pc)
    return 0

fn _la_has_match(prog, lst)
    for pc in lst
        if prog[pc][0] == "match"
            return 1
    return 0

// ── simulate (linear-time NFA, thread-set) ───────────────────────────────────
fn _add_thread(prog, lst, pc)
    if contains(lst, pc)
        return 0
    let instr = prog[pc]
    if instr[0] == "split"
        push(lst, pc)                          // mark visited to break eps-cycles
        _add_thread(prog, lst, instr[1])
        _add_thread(prog, lst, instr[2])
    else if instr[0] == "jmp"
        push(lst, pc)
        _add_thread(prog, lst, instr[1])
    else if instr[0] == "save"
        // epsilon for the non-capturing matchers (rex_full_match/search): skip through.
        push(lst, pc)
        _add_thread(prog, lst, pc + 1)
    else
        push(lst, pc)
    return 0

fn _has_match(prog, lst)
    for pc in lst
        if prog[pc][0] == "match"
            return 1
    return 0

// ── lookbehind sub-match: does the sub_prog match any SUFFIX of input[0..pos)? ──
// Try matching starting at every position j in [0, pos) and check if the match
// consumes exactly up to pos. This is O(pos * |sub_prog|), still linear per position.
fn _suffix_match(sub_prog, input, pos)
    let j = 0
    while j <= pos
        let clist = []
        _la_add(sub_prog, clist, 0)
        if j == pos and _la_has_match(sub_prog, clist)
            return 1
        let k = j
        while k < pos
            let code = ord(input[k])
            let nlist = []
            for pc in clist
                let instr = sub_prog[pc]
                if instr[0] == "char"
                    if code == instr[1]
                        _la_add(sub_prog, nlist, pc + 1)
                else if instr[0] == "any"
                    _la_add(sub_prog, nlist, pc + 1)
                else if instr[0] == "class"
                    let matched = 0
                    for rng in instr[1]
                        if code >= rng[0] and code <= rng[1]
                            matched = 1
                    if instr[2] == 1
                        matched = 1 - matched
                    if matched == 1
                        _la_add(sub_prog, nlist, pc + 1)
            if len(nlist) == 0
                k = pos
            else
                clist = nlist
                k = k + 1
                if k == pos and _la_has_match(sub_prog, clist)
                    return 1
        j = j + 1
    return 0

fn _resolve_assertions(prog, lst, input, pos)
    let resolved = []
    for pc in lst
        let instr = prog[pc]
        if instr[0] == "lookahead"
            let sub_prog = instr[1]
            let positive = instr[2]
            let la_ok = _prefix_match(sub_prog, input, pos)
            if (la_ok == 1 and positive == 1) or (la_ok == 0 and positive == 0)
                _add_thread(prog, resolved, pc + 1)
        else if instr[0] == "lookbehind"
            let sub_prog = instr[1]
            let positive = instr[2]
            let lb_ok = _suffix_match(sub_prog, input, pos)
            if (lb_ok == 1 and positive == 1) or (lb_ok == 0 and positive == 0)
                _add_thread(prog, resolved, pc + 1)
        else
            if not contains(resolved, pc)
                push(resolved, pc)
    resolved

fn rex_full_match(prog, input)
    let clist = []
    _add_thread(prog, clist, 0)
    clist = _resolve_assertions(prog, clist, input, 0)
    let i = 0
    let n = len(input)
    while i < n
        let code = ord(input[i])
        let nlist = []
        for pc in clist
            let instr = prog[pc]
            if instr[0] == "char"
                if code == instr[1]
                    _add_thread(prog, nlist, pc + 1)
            else if instr[0] == "any"
                _add_thread(prog, nlist, pc + 1)
            else if instr[0] == "class"
                let matched = 0
                for rng in instr[1]
                    if code >= rng[0] and code <= rng[1]
                        matched = 1
                if instr[2] == 1
                    matched = 1 - matched
                if matched == 1
                    _add_thread(prog, nlist, pc + 1)
        nlist = _resolve_assertions(prog, nlist, input, i + 1)
        clist = nlist
        i = i + 1
    return _has_match(prog, clist)

// rex_search: does the pattern occur ANYWHERE in the input (substring), still
// linear-time � a fresh start-thread is seeded at every position and we accept as soon
// as any thread reaches Match.
fn rex_search(prog, input)
    let clist = []
    _add_thread(prog, clist, 0)
    clist = _resolve_assertions(prog, clist, input, 0)
    if _has_match(prog, clist)
        return 1
    let i = 0
    let n = len(input)
    while i < n
        let code = ord(input[i])
        let nlist = []
        for pc in clist
            let instr = prog[pc]
            if instr[0] == "char"
                if code == instr[1]
                    _add_thread(prog, nlist, pc + 1)
            else if instr[0] == "any"
                _add_thread(prog, nlist, pc + 1)
            else if instr[0] == "class"
                let matched = 0
                for rng in instr[1]
                    if code >= rng[0] and code <= rng[1]
                        matched = 1
                if instr[2] == 1
                    matched = 1 - matched
                if matched == 1
                    _add_thread(prog, nlist, pc + 1)
        _add_thread(prog, nlist, 0)            // re-seed: a match may start here
        nlist = _resolve_assertions(prog, nlist, input, i + 1)
        clist = nlist
        i = i + 1
        if _has_match(prog, clist)
            return 1
    return 0

fn rex_find(pattern, input)
    return rex_search(rex_compile(pattern), input)

fn rex_test(pattern, input)
    return rex_full_match(rex_compile(pattern), input)

// ── submatch (capture groups), still linear-time ─────────────────────────────
// Pike-VM with per-thread save-slots: each thread carries its own capture positions
// (slot 2k = group k start, 2k+1 = end). Dedup-by-pc keeps the highest-priority
// (leftmost-greedy) thread, so captures follow standard regex semantics.
fn _ngroups(prog)
    let mx = 0
    for instr in prog
        if instr[0] == "save"
            if instr[1] > mx
                mx = instr[1]
    return mx / 2

fn _add_thread_cap(prog, pcs, svs, pc, saves, pos)
    if contains(pcs, pc)
        return 0
    let instr = prog[pc]
    if instr[0] == "split"
        push(pcs, pc)
        push(svs, saves)
        _add_thread_cap(prog, pcs, svs, instr[1], saves, pos)
        _add_thread_cap(prog, pcs, svs, instr[2], saves, pos)
    else if instr[0] == "jmp"
        push(pcs, pc)
        push(svs, saves)
        _add_thread_cap(prog, pcs, svs, instr[1], saves, pos)
    else if instr[0] == "save"
        push(pcs, pc)
        push(svs, saves)
        let ns = copy(saves)
        ns[instr[1]] = pos
        _add_thread_cap(prog, pcs, svs, pc + 1, ns, pos)
    else if instr[0] == "lookahead"
        push(pcs, pc)
        push(svs, saves)
    else if instr[0] == "lookbehind"
        push(pcs, pc)
        push(svs, saves)
    else
        push(pcs, pc)
        push(svs, saves)
    return 0

fn _resolve_assertions_cap(prog, pcs, svs, input, pos)
    let rpcs = []
    let rsvs = []
    let ti = 0
    while ti < len(pcs)
        let pc = pcs[ti]
        let instr = prog[pc]
        if instr[0] == "lookahead"
            let sub_prog = instr[1]
            let positive = instr[2]
            let la_ok = _prefix_match(sub_prog, input, pos)
            if (la_ok == 1 and positive == 1) or (la_ok == 0 and positive == 0)
                _add_thread_cap(prog, rpcs, rsvs, pc + 1, svs[ti], pos)
        else if instr[0] == "lookbehind"
            let sub_prog = instr[1]
            let positive = instr[2]
            let lb_ok = _suffix_match(sub_prog, input, pos)
            if (lb_ok == 1 and positive == 1) or (lb_ok == 0 and positive == 0)
                _add_thread_cap(prog, rpcs, rsvs, pc + 1, svs[ti], pos)
        else
            if not contains(rpcs, pc)
                push(rpcs, pc)
                push(rsvs, svs[ti])
        ti = ti + 1
    return [rpcs, rsvs]

fn _step_cap(prog, pcs, svs, code, npcs, nsvs, pos)
    let ti = 0
    while ti < len(pcs)
        let pc = pcs[ti]
        let instr = prog[pc]
        let matched = 0
        if instr[0] == "char"
            if code == instr[1]
                matched = 1
        else if instr[0] == "any"
            matched = 1
        else if instr[0] == "class"
            for rng in instr[1]
                if code >= rng[0] and code <= rng[1]
                    matched = 1
            if instr[2] == 1
                matched = 1 - matched
        if matched == 1
            _add_thread_cap(prog, npcs, nsvs, pc + 1, svs[ti], pos)
        ti = ti + 1
    return 0

fn _extract_caps(input, saves, ng, whole)
    let caps = [whole]                  // index 0 = whole match
    let g = 1
    while g <= ng
        let st = saves[2 * g]
        let en = saves[2 * g + 1]
        if st >= 0 and en >= 0
            push(caps, input[st:en])
        else
            push(caps, "")
        g = g + 1
    return caps

// rex_captures(pattern, input) -> [wholeMatch, group1, group2, ...] on a full match,
// or [] if the pattern does not match the whole input.
fn rex_captures(pattern, input)
    let prog = rex_compile(pattern)
    let ng = _ngroups(prog)
    let initsaves = []
    let k = 0
    while k < 2 * (ng + 1)
        push(initsaves, 0 - 1)
        k = k + 1
    let pcs = []
    let svs = []
    _add_thread_cap(prog, pcs, svs, 0, initsaves, 0)
    let r0 = _resolve_assertions_cap(prog, pcs, svs, input, 0)
    pcs = r0[0]
    svs = r0[1]
    let i = 0
    let n = len(input)
    while i < n
        let npcs = []
        let nsvs = []
        _step_cap(prog, pcs, svs, ord(input[i]), npcs, nsvs, i + 1)
        let ra = _resolve_assertions_cap(prog, npcs, nsvs, input, i + 1)
        pcs = ra[0]
        svs = ra[1]
        i = i + 1
    let ti = 0
    while ti < len(pcs)
        if prog[pcs[ti]][0] == "match"
            return _extract_caps(input, svs[ti], ng, input)
        ti = ti + 1
    return []

// rex_named(pattern, input, name) -> the substring captured by the named group, or "".
fn rex_named(pattern, input, name)
    let prog = rex_compile(pattern)
    let idx = 0 - 1
    for instr in prog
        if instr[0] == "save" and name != "" and instr[2] == name
            idx = instr[1] / 2
    if idx < 0
        return ""
    let caps = rex_captures(pattern, input)
    if len(caps) > idx
        return caps[idx]
    return ""

fn _add_thread_simple(prog, tlist, pc)
    if pc >= len(prog)
        return 0
    if contains(tlist, pc)
        return 0
    let instr = prog[pc]
    if instr[0] == "split"
        push(tlist, pc)
        _add_thread_simple(prog, tlist, instr[1])
        _add_thread_simple(prog, tlist, instr[2])
    else if instr[0] == "jmp"
        _add_thread_simple(prog, tlist, instr[1])
    else if instr[0] == "save"
        push(tlist, pc)
        _add_thread_simple(prog, tlist, pc + 1)
    else
        push(tlist, pc)
    return 0

fn rex_full_match_u(prog, input)
    let cps = code_points(input)
    let clist = []
    _add_thread_simple(prog, clist, 0)
    let i = 0
    let n = len(cps)
    while i < n
        let code = cps[i]
        let nlist = []
        for pc in clist
            let instr = prog[pc]
            if instr[0] == "char"
                if code == instr[1]
                    _add_thread_simple(prog, nlist, pc + 1)
            else if instr[0] == "any"
                _add_thread_simple(prog, nlist, pc + 1)
            else if instr[0] == "class"
                let matched = 0
                for rng in instr[1]
                    if code >= rng[0] and code <= rng[1]
                        matched = 1
                if instr[2] == 1
                    matched = 1 - matched
                if matched == 1
                    _add_thread_simple(prog, nlist, pc + 1)
        clist = nlist
        i = i + 1
    return _has_match(prog, clist)

fn rex_search_u(prog, input)
    let cps = code_points(input)
    let clist = []
    _add_thread_simple(prog, clist, 0)
    if _has_match(prog, clist)
        return 1
    let i = 0
    let n = len(cps)
    while i < n
        let code = cps[i]
        let nlist = []
        for pc in clist
            let instr = prog[pc]
            if instr[0] == "char"
                if code == instr[1]
                    _add_thread_simple(prog, nlist, pc + 1)
            else if instr[0] == "any"
                _add_thread_simple(prog, nlist, pc + 1)
            else if instr[0] == "class"
                let matched = 0
                for rng in instr[1]
                    if code >= rng[0] and code <= rng[1]
                        matched = 1
                if instr[2] == 1
                    matched = 1 - matched
                if matched == 1
                    _add_thread_simple(prog, nlist, pc + 1)
        _add_thread_simple(prog, nlist, 0)
        clist = nlist
        i = i + 1
        if _has_match(prog, clist)
            return 1
    return 0

fn rex_test_u(pattern, input)
    return rex_full_match_u(rex_compile(pattern), input)

fn rex_find_u(pattern, input)
    return rex_search_u(rex_compile(pattern), input)

fn main()
    // literals
    assert_eq(rex_test("abc", "abc"), 1)
    assert_eq(rex_test("abc", "abd"), 0)
    assert_eq(rex_test("abc", "ab"), 0)
    // any
    assert_eq(rex_test("a.c", "axc"), 1)
    assert_eq(rex_test("a.c", "ac"), 0)
    // star
    assert_eq(rex_test("ab*c", "ac"), 1)
    assert_eq(rex_test("ab*c", "abbbc"), 1)
    assert_eq(rex_test("ab*c", "abx"), 0)
    // plus
    assert_eq(rex_test("ab+c", "ac"), 0)
    assert_eq(rex_test("ab+c", "abbc"), 1)
    // quest
    assert_eq(rex_test("ab?c", "ac"), 1)
    assert_eq(rex_test("ab?c", "abc"), 1)
    assert_eq(rex_test("ab?c", "abbc"), 0)
    // alternation
    assert_eq(rex_test("cat|dog", "cat"), 1)
    assert_eq(rex_test("cat|dog", "dog"), 1)
    assert_eq(rex_test("cat|dog", "cow"), 0)
    // grouping + repetition
    assert_eq(rex_test("(ab)+", "ababab"), 1)
    assert_eq(rex_test("(ab)+", "aba"), 0)
    assert_eq(rex_test("a(b|c)*d", "abcbcd"), 1)
    assert_eq(rex_test("a(b|c)*d", "ad"), 1)
    assert_eq(rex_test("a(b|c)*d", "abed"), 0)
    // escaped metachar
    assert_eq(rex_test("a" + chr(92) + ".c", "a.c"), 1)
    assert_eq(rex_test("a" + chr(92) + ".c", "axc"), 0)
    // LINEAR-TIME: the classic catastrophic-backtracking killer completes instantly
    assert_eq(rex_test("(a+)+b", "aaaaaaaaaaaaaaaaaaaac"), 0)

    // character classes
    assert_eq(rex_test("[abc]", "b"), 1)
    assert_eq(rex_test("[abc]", "d"), 0)
    assert_eq(rex_test("[a-z]+", "hello"), 1)
    assert_eq(rex_test("[a-z]+", "Hello"), 0)
    assert_eq(rex_test("[0-9]+", "2024"), 1)
    assert_eq(rex_test("[0-9]+", "20a4"), 0)
    assert_eq(rex_test("[^0-9]+", "abc"), 1)
    assert_eq(rex_test("[^0-9]+", "ab2"), 0)
    assert_eq(rex_test("[a-z][0-9]*", "x"), 1)
    assert_eq(rex_test("[a-z][0-9]*", "x42"), 1)
    // a realistic identifier pattern
    assert_eq(rex_test("[a-z][a-z0-9]*", "var2"), 1)
    assert_eq(rex_test("[a-z][a-z0-9]*", "2var"), 0)

    // search (substring) vs full-match
    assert_eq(rex_find("cat", "the cat sat"), 1)
    assert_eq(rex_find("cat", "the dog sat"), 0)
    assert_eq(rex_find("[0-9]+", "order 42 please"), 1)
    assert_eq(rex_find("[0-9]+", "no digits here"), 0)
    assert_eq(rex_find("a(b|c)+d", "xx abccbd yy"), 1)
    // full-match still requires the whole string
    assert_eq(rex_test("cat", "the cat sat"), 0)
    assert_eq(rex_test("cat", "cat"), 1)

    // ── capture groups (submatch) ────────────────────────────────────────────
    // numbered groups: caps[0] = whole match, caps[1..] = groups left-to-right
    let c1 = rex_captures("([0-9]+)-([0-9]+)", "12-345")
    assert_eq(len(c1), 3)
    assert_eq(c1[0], "12-345")
    assert_eq(c1[1], "12")
    assert_eq(c1[2], "345")
    // nested groups number by opening paren
    let c2 = rex_captures("(a(b)(c))d", "abcd")
    assert_eq(c2[1], "abc")
    assert_eq(c2[2], "b")
    assert_eq(c2[3], "c")
    // a repeated group captures its LAST iteration (greedy), like every regex engine
    let c3 = rex_captures("([a-z])+", "abc")
    assert_eq(c3[1], "c")
    // alternation inside a group
    let c4 = rex_captures("(cat|dog)s", "dogs")
    assert_eq(c4[1], "dog")
    // an optional group that doesn't participate captures the empty string
    let c5 = rex_captures("a(b)?c", "ac")
    assert_eq(len(c5), 2)
    assert_eq(c5[1], "")
    let c6 = rex_captures("a(b)?c", "abc")
    assert_eq(c6[1], "b")
    // no match -> empty result
    assert_eq(len(rex_captures("(x)", "y")), 0)
    // named groups
    assert_eq(rex_named("(?<y>[0-9]+)-(?<m>[0-9]+)", "2026-06", "y"), "2026")
    assert_eq(rex_named("(?<y>[0-9]+)-(?<m>[0-9]+)", "2026-06", "m"), "06")
    assert_eq(rex_named("(?<word>[a-z]+)", "hello", "word"), "hello")
    assert_eq(rex_named("(?<word>[a-z]+)", "hello", "missing"), "")

    // ── shorthand classes \d \w \s (+ negations \D \W \S) ─────────────────────
    let bs = chr(92)
    assert_eq(rex_test(bs + "d+", "2024"), 1)
    assert_eq(rex_test(bs + "d+", "20a4"), 0)
    assert_eq(rex_test(bs + "w+", "hello_42"), 1)
    assert_eq(rex_test(bs + "w+", "no-dash"), 0)
    assert_eq(rex_test(bs + "s", " "), 1)
    assert_eq(rex_test(bs + "s", "x"), 0)
    assert_eq(rex_test(bs + "D+", "abc"), 1)
    assert_eq(rex_test(bs + "D+", "ab2"), 0)
    assert_eq(rex_find(bs + "d+", "order 42 now"), 1)
    // shorthand inside captures: a date pattern
    let dc = rex_captures("(" + bs + "d+)-(" + bs + "d+)", "2026-06")
    assert_eq(dc[1], "2026")
    assert_eq(dc[2], "06")

    // ── {n,m} bounded repetition (expands to star/quest/concat) ───────────────
    // (NOVA strings interpolate { }, so brace literals are written \{ \} -> "a{3}")
    assert_eq(rex_test("a\{3\}", "aaa"), 1)
    assert_eq(rex_test("a\{3\}", "aa"), 0)
    assert_eq(rex_test("a\{3\}", "aaaa"), 0)
    assert_eq(rex_test("a\{2,4\}", "aa"), 1)
    assert_eq(rex_test("a\{2,4\}", "aaaa"), 1)
    assert_eq(rex_test("a\{2,4\}", "a"), 0)
    assert_eq(rex_test("a\{2,4\}", "aaaaa"), 0)
    assert_eq(rex_test("a\{2,\}", "aa"), 1)
    assert_eq(rex_test("a\{2,\}", "aaaaaa"), 1)
    assert_eq(rex_test("a\{2,\}", "a"), 0)
    // composes with shorthand classes and groups
    assert_eq(rex_test(bs + "d\{4\}", "2026"), 1)
    assert_eq(rex_test(bs + "d\{4\}", "202"), 0)
    assert_eq(rex_test("(ab)\{2\}", "abab"), 1)
    assert_eq(rex_test("(ab)\{2\}", "ababab"), 0)
    assert_eq(rex_find(bs + "d\{4\}", "year 2026 ok"), 1)

    // ── lookahead (?=...) and (?!...) ──────────────────────────────────────────
    // positive lookahead: assert what follows without consuming
    assert_eq(rex_test("foo(?=bar)", "foobar"), 0)  // lookahead doesn't consume "bar", full match needs it
    assert_eq(rex_find("foo(?=bar)", "foobar"), 1)  // search: "foo" followed by "bar"
    assert_eq(rex_find("foo(?=bar)", "foobaz"), 0)  // "foo" NOT followed by "bar"
    // negative lookahead: assert what does NOT follow
    assert_eq(rex_find("foo(?!bar)", "foobaz"), 1)  // "foo" NOT followed by "bar" -> match
    assert_eq(rex_find("foo(?!bar)", "foobar"), 0)  // "foo" followed by "bar" -> no match
    // lookahead with class
    assert_eq(rex_find(bs + "d+(?=" + bs + "D)", "123abc"), 1)  // digits followed by non-digit
    assert_eq(rex_find(bs + "d+(?=" + bs + "D)", "123"), 0)     // digits NOT followed by non-digit

    // ── lookbehind (?<=...) and (?<!...) ──────────────────────────────────────
    // positive lookbehind: assert what precedes without consuming
    assert_eq(rex_find("(?<=foo)bar", "foobar"), 1)  // "bar" preceded by "foo"
    assert_eq(rex_find("(?<=foo)bar", "bazbar"), 0)  // "bar" NOT preceded by "foo"
    assert_eq(rex_find("(?<=a)b", "ab"), 1)
    assert_eq(rex_find("(?<=a)b", "cb"), 0)
    // negative lookbehind: assert what does NOT precede
    assert_eq(rex_find("(?<!foo)bar", "bazbar"), 1)  // "bar" NOT preceded by "foo"
    assert_eq(rex_find("(?<!foo)bar", "foobar"), 0)  // "bar" preceded by "foo" -> no match
    assert_eq(rex_find("(?<!a)b", "cb"), 1)
    assert_eq(rex_find("(?<!a)b", "ab"), 0)
    // lookbehind with classes
    assert_eq(rex_find("(?<=" + bs + "d)x", "3x"), 1)   // x preceded by a digit
    assert_eq(rex_find("(?<=" + bs + "d)x", "ax"), 0)   // x NOT preceded by a digit

    // ── Unicode property classes \p{L} \p{N} \p{Z} ────────────────────────────
    assert_eq(rex_test_u(bs + "p\{L\}+", "hello"), 1)
    assert_eq(rex_test_u(bs + "p\{L\}+", "123"), 0)
    assert_eq(rex_test_u(bs + "p\{N\}+", "42"), 1)
    assert_eq(rex_test_u(bs + "p\{N\}+", "abc"), 0)
    assert_eq(rex_find_u(bs + "p\{L\}+", "item 42"), 1)
    assert_eq(rex_find_u(bs + "p\{N\}+", "item 42"), 1)
    assert_eq(rex_test_u(bs + "P\{N\}+", "abc"), 1)
    assert_eq(rex_test_u(bs + "P\{N\}+", "123"), 0)
    assert_eq(rex_test_u(bs + "p\{L\}" + bs + "p\{N\}", "a1"), 1)
    assert_eq(rex_test_u(bs + "p\{L\}" + bs + "p\{N\}", "11"), 0)
    assert_eq(rex_test_u(bs + "p\{Letter\}+", "hello"), 1)
    assert_eq(rex_test_u(bs + "p\{Number\}+", "42"), 1)

    // ── Unicode codepoint matching (multi-byte characters) ───────────────────
    assert_eq(rex_test_u(".+", from_codepoint(20320) + from_codepoint(22909)), 1)
    assert_eq(rex_test_u("...", from_codepoint(20320) + from_codepoint(22909) + from_codepoint(21527)), 1)
    assert_eq(rex_find_u(bs + "p\{L\}+", from_codepoint(20320) + from_codepoint(22909)), 1)
    let cafe = "caf" + from_codepoint(233)
    assert_eq(rex_test_u(bs + "p\{L\}+", cafe), 1)
    assert_eq(char_count(cafe), 4)

    print("rex passed")
