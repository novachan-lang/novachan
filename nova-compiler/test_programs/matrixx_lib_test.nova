import std/numeric/matrixx

fn main()
    // shape accessors on a literal 2x3 matrix
    let m23 = [[1, 2, 3], [4, 5, 6]]
    assert(matrixx.mat_rows(m23) == 2, "2x3 matrix has 2 rows")
    assert(matrixx.mat_cols(m23) == 3, "2x3 matrix has 3 cols")
    assert(matrixx.mat_get(m23, 1, 2) == 6, "element (1,2) is 6")

    // transpose: [[1,2,3],[4,5,6]] -> [[1,4],[2,5],[3,6]]
    let t = matrixx.mat_transpose(m23)
    assert(matrixx.mat_get(t, 0, 1) == 4, "transpose (0,1) is original (1,0)=4")
    assert(matrixx.mat_get(t, 2, 0) == 3, "transpose (2,0) is original (0,2)=3")

    // mat_add: [[1,2],[3,4]] + [[5,6],[7,8]] = [[6,8],[10,12]]
    let s = matrixx.mat_add([[1, 2], [3, 4]], [[5, 6], [7, 8]])
    assert(matrixx.mat_get(s, 1, 1) == 12, "add (1,1) = 4+8 = 12")

    // mat_mul: [[1,2],[3,4]] * [[5,6],[7,8]] = [[19,22],[43,50]]
    let p = matrixx.mat_mul([[1, 2], [3, 4]], [[5, 6], [7, 8]])
    assert(matrixx.mat_get(p, 0, 0) == 19, "mul (0,0) = 1*5+2*7 = 19")
    assert(matrixx.mat_get(p, 1, 1) == 50, "mul (1,1) = 3*6+4*8 = 50")

    print("matrixx_lib_test passed")
