import std/rational/rfrac_arith

// ckr — assert rational equality element-wise
fn ckr(label: string, got: list, wn: int, wd: int)
    if got[0] != wn or got[1] != wd
        print("FAIL rfrac_arith " + label + ": got=" + str(got[0]) + "/" + str(got[1]) + " want=" + str(wn) + "/" + str(wd))
        exit(1)

// cki — assert integer equality
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL rfrac_arith " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// helper: build a rational [n, d] directly (caller ensures already reduced, den>0)
fn q(n: int, d: int) -> list
    let r = []
    push(r, n)
    push(r, d)
    r

// --- rfa_add ---
// 1/2 + 1/3 = 5/6
let a1 = rfa_add(q(1, 2), q(1, 3))
ckr("add_1_2__1_3", a1, 5, 6)

// 1/2 + (-1/2) = 0
let a2 = rfa_add(q(1, 2), q(0 - 1, 2))
ckr("add_halfneghalf", a2, 0, 1)

// 1/4 + 3/4 = 1
let a3 = rfa_add(q(1, 4), q(3, 4))
ckr("add_quarter", a3, 1, 1)

// -1/3 + 1/3 = 0
let a4 = rfa_add(q(0 - 1, 3), q(1, 3))
ckr("add_neg_cancel", a4, 0, 1)

// --- rfa_sub ---
// 1/2 - 1/3 = 1/6
let s1 = rfa_sub(q(1, 2), q(1, 3))
ckr("sub_1_2__1_3", s1, 1, 6)

// 1/2 - 1/2 = 0
let s2 = rfa_sub(q(1, 2), q(1, 2))
ckr("sub_zero", s2, 0, 1)

// 1/4 - 3/4 = -1/2
let s3 = rfa_sub(q(1, 4), q(3, 4))
ckr("sub_negative", s3, 0 - 1, 2)

// --- rfa_mul ---
// 2/3 * 3/4 = 1/2
let m1 = rfa_mul(q(2, 3), q(3, 4))
ckr("mul_2_3__3_4", m1, 1, 2)

// (-1/2) * 2 = -1
let m2 = rfa_mul(q(0 - 1, 2), q(2, 1))
ckr("mul_neg", m2, 0 - 1, 1)

// 0 * 5/7 = 0
let m3 = rfa_mul(q(0, 1), q(5, 7))
ckr("mul_by_zero", m3, 0, 1)

// --- rfa_div ---
// 1/2 / 3/4 = 2/3
let d1 = rfa_div(q(1, 2), q(3, 4))
ckr("div_1_2__3_4", d1, 2, 3)

// 5/7 / 5/7 = 1
let d2 = rfa_div(q(5, 7), q(5, 7))
ckr("div_self", d2, 1, 1)

// 3/4 / (-1/2) = -3/2
let d3 = rfa_div(q(3, 4), q(0 - 1, 2))
ckr("div_neg_denom", d3, 0 - 3, 2)

// divide by zero -> invalid
let d4 = rfa_div(q(1, 2), q(0, 1))
ckr("div_by_zero", d4, 0, 0)

// --- rfa_pow ---
// (2/3)^2 = 4/9
let p1 = rfa_pow(q(2, 3), 2)
ckr("pow_2_3__2", p1, 4, 9)

// (2/3)^(-2) = 9/4
let p2 = rfa_pow(q(2, 3), 0 - 2)
ckr("pow_2_3__neg2", p2, 9, 4)

// (5/7)^0 = 1
let p3 = rfa_pow(q(5, 7), 0)
ckr("pow_any_0", p3, 1, 1)

// (1/2)^3 = 1/8
let p4 = rfa_pow(q(1, 2), 3)
ckr("pow_1_2__3", p4, 1, 8)

// (-2/3)^2 = 4/9 (even power makes positive)
let p5 = rfa_pow(q(0 - 2, 3), 2)
ckr("pow_neg_even", p5, 4, 9)

// (-2/3)^3 = -8/27
let p6 = rfa_pow(q(0 - 2, 3), 3)
ckr("pow_neg_odd", p6, 0 - 8, 27)

// --- rfa_inv ---
// inv(2/5) = 5/2
let i1 = rfa_inv(q(2, 5))
ckr("inv_2_5", i1, 5, 2)

// inv(-3/4) = -4/3
let i2 = rfa_inv(q(0 - 3, 4))
ckr("inv_neg3_4", i2, 0 - 4, 3)

// inv(0) = invalid
let i3 = rfa_inv(q(0, 1))
ckr("inv_zero", i3, 0, 0)

// --- rfa_addmany ---
// 1/2 + 1/3 + 1/6 = 1
let lst1 = []
push(lst1, q(1, 2))
push(lst1, q(1, 3))
push(lst1, q(1, 6))
let am1 = rfa_addmany(lst1)
ckr("addmany_1", am1, 1, 1)

// empty list = 0
let lst2 = []
let am2 = rfa_addmany(lst2)
ckr("addmany_empty", am2, 0, 1)

// 1/4 + 1/4 + 1/4 + 1/4 = 1
let lst3 = []
push(lst3, q(1, 4))
push(lst3, q(1, 4))
push(lst3, q(1, 4))
push(lst3, q(1, 4))
let am3 = rfa_addmany(lst3)
ckr("addmany_quarters", am3, 1, 1)

// --- rfa_mulmany ---
// 2/3 * 3/4 * 4/5 = 2/5
let lst4 = []
push(lst4, q(2, 3))
push(lst4, q(3, 4))
push(lst4, q(4, 5))
let mm1 = rfa_mulmany(lst4)
ckr("mulmany_1", mm1, 2, 5)

// empty list = 1
let lst5 = []
let mm2 = rfa_mulmany(lst5)
ckr("mulmany_empty", mm2, 1, 1)

// 1/2 * 2/3 * 3/1 = 1
let lst6 = []
push(lst6, q(1, 2))
push(lst6, q(2, 3))
push(lst6, q(3, 1))
let mm3 = rfa_mulmany(lst6)
ckr("mulmany_cancel", mm3, 1, 1)

print("PASS _rfrac_arith_test")
