// Exercise every public function of std/itertools/itertools with normal AND edge
// inputs, so _hldiff.sh can compare the raised module against git HEAD.
import std/itertools/itertools

fn main()
    let xs = [10, 20, 30, 40, 50]
    let ys = ["a", "b", "c"]
    let e = []

    // it_range — forward, empty, reversed(a>b), negative, single
    print(it_range(0, 5))
    print(it_range(3, 3))
    print(it_range(5, 2))
    print(it_range(0 - 3, 2))
    print(it_range(7, 8))

    // it_chain — both non-empty, one empty, both empty
    print(it_chain(xs, ys))
    print(it_chain(e, ys))
    print(it_chain(xs, e))
    print(it_chain(e, e))

    // it_zip — truncation both directions, empty
    print(it_zip(xs, ys))
    print(it_zip(ys, xs))
    print(it_zip(e, xs))
    print(it_zip(xs, e))

    // it_take — normal, zero, negative, oversized, exact
    print(it_take(xs, 3))
    print(it_take(xs, 0))
    print(it_take(xs, 0 - 2))
    print(it_take(xs, 99))
    print(it_take(xs, 5))
    print(it_take(e, 3))

    // it_drop — normal, zero, negative, oversized, exact
    print(it_drop(xs, 2))
    print(it_drop(xs, 0))
    print(it_drop(xs, 0 - 2))
    print(it_drop(xs, 99))
    print(it_drop(xs, 5))
    print(it_drop(e, 2))

    // it_windowed — normal, k=1, k=len, k>len, k=0, k negative, empty input
    print(it_windowed(xs, 2))
    print(it_windowed(xs, 1))
    print(it_windowed(xs, 5))
    print(it_windowed(xs, 6))
    print(it_windowed(xs, 0))
    print(it_windowed(xs, 0 - 1))
    print(it_windowed(e, 2))

    // it_chunked — even divide, short tail, k=1, k>len, k=0, negative, empty
    print(it_chunked([1, 2, 3, 4], 2))
    print(it_chunked(xs, 2))
    print(it_chunked(xs, 1))
    print(it_chunked(xs, 99))
    print(it_chunked(xs, 0))
    print(it_chunked(xs, 0 - 3))
    print(it_chunked(e, 2))

    // it_enumerate — normal, single, empty
    print(it_enumerate(ys))
    print(it_enumerate([42]))
    print(it_enumerate(e))

    // it_flatten — nested, ragged, empty inners, empty outer
    print(it_flatten([[1, 2], [3], [4, 5, 6]]))
    print(it_flatten([[], [1], []]))
    print(it_flatten([]))
    print(it_flatten([[1, 2]]))

    // it_repeat — normal, zero, negative, string element, list element
    print(it_repeat(7, 4))
    print(it_repeat(7, 0))
    print(it_repeat(7, 0 - 1))
    print(it_repeat("z", 3))
    print(it_repeat([1], 2))

    print("EXERCISE-DONE")
