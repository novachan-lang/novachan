import std/bits/bitscan

// cki — integer known-answer check.
fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL bitscan " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // --- bs_ctz ---
    // 8 = 0b1000: three trailing zeros
    cki("ctz(8)", bs_ctz(8), 3)
    // 1 = 0b0001: no trailing zeros
    cki("ctz(1)", bs_ctz(1), 0)
    // 0: convention = 64
    cki("ctz(0)", bs_ctz(0), 64)
    // 16 = 0b10000: four trailing zeros
    cki("ctz(16)", bs_ctz(16), 4)
    // 6 = 0b110: one trailing zero
    cki("ctz(6)", bs_ctz(6), 1)

    // --- bs_bit_length ---
    // 0: no bits -> 0
    cki("bit_length(0)", bs_bit_length(0), 0)
    // 1: highest bit at position 0 -> length 1
    cki("bit_length(1)", bs_bit_length(1), 1)
    // 255 = 0xFF: highest bit at position 7 -> length 8
    cki("bit_length(255)", bs_bit_length(255), 8)
    // 256 = 0x100: highest bit at position 8 -> length 9
    cki("bit_length(256)", bs_bit_length(256), 9)
    // 4 = 0b100: highest bit at position 2 -> length 3
    cki("bit_length(4)", bs_bit_length(4), 3)

    // --- bs_msb_pos ---
    // 255 = 0xFF: highest set bit at position 7
    cki("msb_pos(255)", bs_msb_pos(255), 7)
    // 0: no bits -> -1
    cki("msb_pos(0)", bs_msb_pos(0), 0 - 1)
    // 1: highest bit at position 0
    cki("msb_pos(1)", bs_msb_pos(1), 0)
    // 256 = 2^8: highest bit at position 8
    cki("msb_pos(256)", bs_msb_pos(256), 8)

    // --- bs_lsb_pos ---
    // 12 = 0b1100: lowest set bit at position 2
    cki("lsb_pos(12)", bs_lsb_pos(12), 2)
    // 0: no bits -> -1
    cki("lsb_pos(0)", bs_lsb_pos(0), 0 - 1)
    // 1: lowest bit at position 0
    cki("lsb_pos(1)", bs_lsb_pos(1), 0)
    // 8 = 0b1000: lowest bit at position 3
    cki("lsb_pos(8)", bs_lsb_pos(8), 3)

    // --- bs_ffs ---
    // 12 = 0b1100: lowest set bit at position 2 -> ffs = 3 (1-indexed)
    cki("ffs(12)", bs_ffs(12), 3)
    // 0: no bits -> 0
    cki("ffs(0)", bs_ffs(0), 0)
    // 1: lowest bit at position 0 -> ffs = 1
    cki("ffs(1)", bs_ffs(1), 1)
    // 8 = 0b1000: lowest bit at position 3 -> ffs = 4
    cki("ffs(8)", bs_ffs(8), 4)

    // --- bs_clz ---
    // clz(1, 8): within 8 bits, 1 = 0b00000001, leading zeros = 7
    cki("clz(1,8)", bs_clz(1, 8), 7)
    // clz(255, 8): 255 = 0xFF fills all 8 bits -> leading zeros = 0
    cki("clz(255,8)", bs_clz(255, 8), 0)
    // clz(0, 8): all zero -> leading zeros = 8
    cki("clz(0,8)", bs_clz(0, 8), 8)
    // clz(128, 8): 0b10000000 -> leading zeros = 0
    cki("clz(128,8)", bs_clz(128, 8), 0)
    // clz(1, 16): 1 within 16 bits -> 15 leading zeros
    cki("clz(1,16)", bs_clz(1, 16), 15)
    // clz(256, 16): 0x0100 within 16 bits -> leading zeros = 7
    cki("clz(256,16)", bs_clz(256, 16), 7)

    print("PASS _bitscan_test")
