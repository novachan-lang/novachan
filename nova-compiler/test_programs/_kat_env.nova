// KAT: forge_env — typed environment variable / config access.
import forge_env

fn main() -> int
    // ── env_get_or: non-existent key falls back to default ──────────────────
    assert(env_get_or("NOVA_KAT_ENV_DOES_NOT_EXIST_XYZ", "fallback") == "fallback", "env_get_or: missing key -> default")

    // ── env_get: non-existent key -> "" ──────────────────────────────────────
    assert(env_get("NOVA_KAT_ENV_DOES_NOT_EXIST_XYZ") == "", "env_get: missing key -> empty string")

    // ── env_int: parsing ──────────────────────────────────────────────────────
    assert(env_int("NOVA_KAT_ENV_DOES_NOT_EXIST_XYZ", 42) == 42, "env_int: missing key -> default")
    // PATH is set in every real process environment and is never a bare integer.
    assert(env_int("PATH", 99) == 99, "env_int: non-numeric value -> default")

    // ── env_bool: parsing ──────────────────────────────────────────────────────
    assert(env_bool("NOVA_KAT_ENV_DOES_NOT_EXIST_XYZ", 0) == 0, "env_bool: missing key -> default (0)")
    assert(env_bool("NOVA_KAT_ENV_DOES_NOT_EXIST_XYZ", 1) == 1, "env_bool: missing key -> default (1)")

    // ── env_required: err for missing, ok for present ──────────────────────────
    assert(env_required("NOVA_KAT_ENV_DOES_NOT_EXIST_XYZ") == err("missing env: NOVA_KAT_ENV_DOES_NOT_EXIST_XYZ"), "env_required: missing key -> err")
    match env_required("PATH")
        Ok(v) =>
            assert(len(v) > 0, "env_required: PATH present -> ok(non-empty)")
        Err(e) =>
            assert(false, "env_required: PATH should be present in every process env")

    // ── env_prefix: batch read keyed by short name ───────────────────────────
    let px = env_prefix("NOVA_KAT_ENV_PFX_", ["A", "B"])
    assert(px["A"] == "" and px["B"] == "", "env_prefix: unset prefixed keys -> empty strings, keyed by short name")

    // ── env_config: schema-driven typed config load ──────────────────────────
    let schema = [{"name": "NOVA_KAT_ENV_STR", "type": "string", "default": "hello", "required": false}, {"name": "NOVA_KAT_ENV_INT", "type": "int", "default": 7, "required": false}, {"name": "NOVA_KAT_ENV_BOOL", "type": "bool", "default": 1, "required": false}]
    match env_config(schema)
        Ok(cfg) =>
            assert(cfg["NOVA_KAT_ENV_STR"] == "hello", "env_config: string default applied")
            assert(cfg["NOVA_KAT_ENV_INT"] == 7, "env_config: int default applied")
            assert(cfg["NOVA_KAT_ENV_BOOL"] == 1, "env_config: bool default applied")
        Err(e) =>
            assert(false, "env_config: all-optional schema should never err")

    // env_config: a required-but-missing entry fails fast with the right message.
    let req_schema = [{"name": "NOVA_KAT_ENV_REQUIRED_XYZ", "type": "string", "default": "", "required": true}]
    assert(env_config(req_schema) == err("missing env: NOVA_KAT_ENV_REQUIRED_XYZ"), "env_config: required-and-missing -> err with the missing name")

    print("FORGE-ENV KAT PASS")
    0
