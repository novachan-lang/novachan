// KAT test for std/audio/osc_noise.nova
import std/audio/osc_noise

fn approx(a: float, b: float, tol: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    let result = d < tol
    result

fn main()
    // KAT 1: Deterministic — two noise_seed(42) produce same first 5 values.
    let s1 = noise_seed(42)
    let r1a = noise_next(s1)
    let v1a = r1a[0]
    let st1a = r1a[1]
    let r2a = noise_next(st1a)
    let v2a = r2a[0]
    let st2a = r2a[1]
    let r3a = noise_next(st2a)
    let v3a = r3a[0]
    let st3a = r3a[1]
    let r4a = noise_next(st3a)
    let v4a = r4a[0]
    let st4a = r4a[1]
    let r5a = noise_next(st4a)
    let v5a = r5a[0]

    // Second run with same seed
    let s2 = noise_seed(42)
    let r1b = noise_next(s2)
    let v1b = r1b[0]
    let st1b = r1b[1]
    let r2b = noise_next(st1b)
    let v2b = r2b[0]
    let st2b = r2b[1]
    let r3b = noise_next(st2b)
    let v3b = r3b[0]
    let st3b = r3b[1]
    let r4b = noise_next(st3b)
    let v4b = r4b[0]
    let st4b = r4b[1]
    let r5b = noise_next(st4b)
    let v5b = r5b[0]

    if approx(v1a, v1b, 0.000001) != true
        print("FAIL determinism v1: " + str(v1a) + " != " + str(v1b))
        exit(1)
    if approx(v2a, v2b, 0.000001) != true
        print("FAIL determinism v2: " + str(v2a) + " != " + str(v2b))
        exit(1)
    if approx(v3a, v3b, 0.000001) != true
        print("FAIL determinism v3: " + str(v3a) + " != " + str(v3b))
        exit(1)
    if approx(v4a, v4b, 0.000001) != true
        print("FAIL determinism v4: " + str(v4a) + " != " + str(v4b))
        exit(1)
    if approx(v5a, v5b, 0.000001) != true
        print("FAIL determinism v5: " + str(v5a) + " != " + str(v5b))
        exit(1)

    // KAT 2: All values in [-1.0, 1.0].
    if v1a < -1.0 or v1a > 1.0
        print("FAIL range v1a: " + str(v1a))
        exit(1)
    if v2a < -1.0 or v2a > 1.0
        print("FAIL range v2a: " + str(v2a))
        exit(1)
    if v3a < -1.0 or v3a > 1.0
        print("FAIL range v3a: " + str(v3a))
        exit(1)
    if v4a < -1.0 or v4a > 1.0
        print("FAIL range v4a: " + str(v4a))
        exit(1)
    if v5a < -1.0 or v5a > 1.0
        print("FAIL range v5a: " + str(v5a))
        exit(1)

    // KAT 3: Different seeds produce different first values.
    let sa = noise_seed(42)
    let sb = noise_seed(99)
    let ra = noise_next(sa)
    let rb = noise_next(sb)
    let va = ra[0]
    let vb = rb[0]
    if approx(va, vb, 0.000001) == true
        print("FAIL different seeds same value: seed42=" + str(va) + " seed99=" + str(vb))
        exit(1)

    print("PASS _osc_noise_test")
