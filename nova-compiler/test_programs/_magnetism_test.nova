// KAT for std/physics/magnetism.
import std/physics/magnetism

fn approx(a, b)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < 0.001

fn ckf(label, got, want)
    if not approx(got, want)
        print("FAIL magnetism " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // lorentz_force(2,3,4) = 2*3*4 = 24.0
    ckf("lorentz_force(2,3,4)", lorentz_force(2.0, 3.0, 4.0), 24.0)
    // lorentz_force(1,10,2) = 20.0
    ckf("lorentz_force(1,10,2)", lorentz_force(1.0, 10.0, 2.0), 20.0)
    // lorentz_force(5,1,1) = 5.0
    ckf("lorentz_force(5,1,1)", lorentz_force(5.0, 1.0, 1.0), 5.0)

    // force_on_wire(2,3,4) = 2*3*4 = 24.0
    ckf("force_on_wire(2,3,4)", force_on_wire(2.0, 3.0, 4.0), 24.0)
    // force_on_wire(1,5,3) = 15.0
    ckf("force_on_wire(1,5,3)", force_on_wire(1.0, 5.0, 3.0), 15.0)
    // force_on_wire(0.5,2,4) = 4.0
    ckf("force_on_wire(0.5,2,4)", force_on_wire(0.5, 2.0, 4.0), 4.0)

    // solenoid_field increases with turns_per_m:
    // solenoid_field(1000,1) < solenoid_field(2000,1)
    let b1 = solenoid_field(1000.0, 1.0)
    let b2 = solenoid_field(2000.0, 1.0)
    if b2 < b1
        print("FAIL magnetism solenoid_field does not increase with turns")
        exit(1)
    // solenoid_field(1000,2) ~ 2 * solenoid_field(1000,1)
    let b3 = solenoid_field(1000.0, 2.0)
    ckf("solenoid_field doubles with current", b3, b1 * 2.0)
    // solenoid_field(1000,1) = 1.2566e-6 * 1000 * 1 = 1.2566e-3 ~ 0.0012566
    ckf("solenoid_field(1000,1)", b1, 0.0012566)

    // cyclotron_frequency(1,1,1) = 1/(2*pi) ~ 0.15915
    ckf("cyclotron_frequency(1,1,1)", cyclotron_frequency(1.0, 1.0, 1.0), 0.15915)
    // cyclotron_frequency(2,1,1) = 2/(2*pi) ~ 0.31831
    ckf("cyclotron_frequency(2,1,1)", cyclotron_frequency(2.0, 1.0, 1.0), 0.31831)

    print("PASS _magnetism_test")
