import std/parsing/peg

fn main()
    // ── KAT 1: lit("ab") on "abc" at 0 -> [1, 2] ────────────────────────────
    let e1 = lit("ab")
    let r1 = peg_match(e1, "abc", 0)
    let r1ok = r1[0]
    let r1pos = r1[1]
    if r1ok != 1
        print("FAIL peg lit-ok: got "+str(r1ok)+" want 1")
        exit(1)
    if r1pos != 2
        print("FAIL peg lit-pos: got "+str(r1pos)+" want 2")
        exit(1)

    // ── KAT 2: star(cls("a")) on "aaab" at 0 -> [1, 3] ──────────────────────
    let e2 = star(cls("a"))
    let r2 = peg_match(e2, "aaab", 0)
    let r2ok = r2[0]
    let r2pos = r2[1]
    if r2ok != 1
        print("FAIL peg star-ok: got "+str(r2ok)+" want 1")
        exit(1)
    if r2pos != 3
        print("FAIL peg star-pos: got "+str(r2pos)+" want 3")
        exit(1)

    // ── KAT 3: choice([lit("cat"),lit("dog")]) on "dog" at 0 -> [1, 3] ──────
    let alts = []
    push(alts, lit("cat"))
    push(alts, lit("dog"))
    let e3 = choice(alts)
    let r3 = peg_match(e3, "dog", 0)
    let r3ok = r3[0]
    let r3pos = r3[1]
    if r3ok != 1
        print("FAIL peg choice-ok: got "+str(r3ok)+" want 1")
        exit(1)
    if r3pos != 3
        print("FAIL peg choice-pos: got "+str(r3pos)+" want 3")
        exit(1)

    // ── KAT 4: plus(cls("0123456789")) on "42x" at 0 -> [1, 2] ──────────────
    let e4 = plus(cls("0123456789"))
    let r4 = peg_match(e4, "42x", 0)
    let r4ok = r4[0]
    let r4pos = r4[1]
    if r4ok != 1
        print("FAIL peg plus-ok: got "+str(r4ok)+" want 1")
        exit(1)
    if r4pos != 2
        print("FAIL peg plus-pos: got "+str(r4pos)+" want 2")
        exit(1)

    // ── KAT 5: notp(lit("x")) on "y" at 0 -> [1, 0] (no consume) ────────────
    let e5 = notp(lit("x"))
    let r5 = peg_match(e5, "y", 0)
    let r5ok = r5[0]
    let r5pos = r5[1]
    if r5ok != 1
        print("FAIL peg notp-ok: got "+str(r5ok)+" want 1")
        exit(1)
    if r5pos != 0
        print("FAIL peg notp-pos: got "+str(r5pos)+" want 0")
        exit(1)

    // ── KAT 6: seq([lit("a"),lit("b")]) on "ac" at 0 -> [0, ...] ────────────
    let sv = []
    push(sv, lit("a"))
    push(sv, lit("b"))
    let e6 = seq(sv)
    let r6 = peg_match(e6, "ac", 0)
    let r6ok = r6[0]
    if r6ok != 0
        print("FAIL peg seq-fail-ok: got "+str(r6ok)+" want 0")
        exit(1)

    // ── KAT 7: anychar on "z" at 0 -> [1, 1] ────────────────────────────────
    let e7 = anychar()
    let r7 = peg_match(e7, "z", 0)
    let r7ok = r7[0]
    let r7pos = r7[1]
    if r7ok != 1
        print("FAIL peg anychar-ok: got "+str(r7ok)+" want 1")
        exit(1)
    if r7pos != 1
        print("FAIL peg anychar-pos: got "+str(r7pos)+" want 1")
        exit(1)

    // ── KAT 8: anychar on "" at 0 -> [0, 0] (empty input) ───────────────────
    let e8 = anychar()
    let r8 = peg_match(e8, "", 0)
    let r8ok = r8[0]
    if r8ok != 0
        print("FAIL peg anychar-empty: got "+str(r8ok)+" want 0")
        exit(1)

    // ── KAT 9: opt(lit("x")) on "y" at 0 -> [1, 0] (optional, no match ok) ──
    let e9 = opt(lit("x"))
    let r9 = peg_match(e9, "y", 0)
    let r9ok = r9[0]
    let r9pos = r9[1]
    if r9ok != 1
        print("FAIL peg opt-ok: got "+str(r9ok)+" want 1")
        exit(1)
    if r9pos != 0
        print("FAIL peg opt-pos: got "+str(r9pos)+" want 0")
        exit(1)

    // ── KAT 10: opt(lit("h")) on "hello" at 0 -> [1, 1] (matched one) ───────
    let e10 = opt(lit("h"))
    let r10 = peg_match(e10, "hello", 0)
    let r10ok = r10[0]
    let r10pos = r10[1]
    if r10ok != 1
        print("FAIL peg opt-match-ok: got "+str(r10ok)+" want 1")
        exit(1)
    if r10pos != 1
        print("FAIL peg opt-match-pos: got "+str(r10pos)+" want 1")
        exit(1)

    // ── KAT 11: andp(lit("ab")) on "abc" at 0 -> [1, 0] (lookahead) ─────────
    let e11 = andp(lit("ab"))
    let r11 = peg_match(e11, "abc", 0)
    let r11ok = r11[0]
    let r11pos = r11[1]
    if r11ok != 1
        print("FAIL peg andp-ok: got "+str(r11ok)+" want 1")
        exit(1)
    if r11pos != 0
        print("FAIL peg andp-pos: got "+str(r11pos)+" want 0")
        exit(1)

    // ── KAT 12: andp(lit("xy")) on "abc" at 0 -> [0, 0] (lookahead fail) ────
    let e12 = andp(lit("xy"))
    let r12 = peg_match(e12, "abc", 0)
    let r12ok = r12[0]
    if r12ok != 0
        print("FAIL peg andp-fail: got "+str(r12ok)+" want 0")
        exit(1)

    // ── KAT 13: notp(lit("x")) on "x" -> [0, 0] (neg lookahead fail) ────────
    let e13 = notp(lit("x"))
    let r13 = peg_match(e13, "x", 0)
    let r13ok = r13[0]
    if r13ok != 0
        print("FAIL peg notp-fail: got "+str(r13ok)+" want 0")
        exit(1)

    // ── KAT 14: plus on no-match -> [0, pos] ─────────────────────────────────
    let e14 = plus(cls("0123456789"))
    let r14 = peg_match(e14, "abc", 0)
    let r14ok = r14[0]
    if r14ok != 0
        print("FAIL peg plus-nomatch: got "+str(r14ok)+" want 0")
        exit(1)

    // ── KAT 15: star on empty string -> [1, 0] ───────────────────────────────
    let e15 = star(cls("a"))
    let r15 = peg_match(e15, "", 0)
    let r15ok = r15[0]
    let r15pos = r15[1]
    if r15ok != 1
        print("FAIL peg star-empty-ok: got "+str(r15ok)+" want 1")
        exit(1)
    if r15pos != 0
        print("FAIL peg star-empty-pos: got "+str(r15pos)+" want 0")
        exit(1)

    // ── KAT 16: seq of three lits ────────────────────────────────────────────
    let sv2 = []
    push(sv2, lit("foo"))
    push(sv2, lit("bar"))
    push(sv2, lit("!"))
    let e16 = seq(sv2)
    let r16 = peg_match(e16, "foobar!", 0)
    let r16ok = r16[0]
    let r16pos = r16[1]
    if r16ok != 1
        print("FAIL peg seq3-ok: got "+str(r16ok)+" want 1")
        exit(1)
    if r16pos != 7
        print("FAIL peg seq3-pos: got "+str(r16pos)+" want 7")
        exit(1)

    // ── KAT 17: lit("") matches zero chars ───────────────────────────────────
    let e17 = lit("")
    let r17 = peg_match(e17, "abc", 0)
    let r17ok = r17[0]
    let r17pos = r17[1]
    if r17ok != 1
        print("FAIL peg lit-empty-ok: got "+str(r17ok)+" want 1")
        exit(1)
    if r17pos != 0
        print("FAIL peg lit-empty-pos: got "+str(r17pos)+" want 0")
        exit(1)

    // ── KAT 18: nested — seq([star(cls("ab")), lit("c")]) on "aabbc" -> [1,5]
    let sv3 = []
    push(sv3, star(cls("ab")))
    push(sv3, lit("c"))
    let e18 = seq(sv3)
    let r18 = peg_match(e18, "aabbc", 0)
    let r18ok = r18[0]
    let r18pos = r18[1]
    if r18ok != 1
        print("FAIL peg nested-ok: got "+str(r18ok)+" want 1")
        exit(1)
    if r18pos != 5
        print("FAIL peg nested-pos: got "+str(r18pos)+" want 5")
        exit(1)

    // ── KAT 19: match at non-zero pos ────────────────────────────────────────
    let e19 = lit("bc")
    let r19 = peg_match(e19, "abc", 1)
    let r19ok = r19[0]
    let r19pos = r19[1]
    if r19ok != 1
        print("FAIL peg lit-offset-ok: got "+str(r19ok)+" want 1")
        exit(1)
    if r19pos != 3
        print("FAIL peg lit-offset-pos: got "+str(r19pos)+" want 3")
        exit(1)

    // ── KAT 20: choice returns first alt even if second also matches ──────────
    let sv4 = []
    push(sv4, lit("a"))
    push(sv4, lit("ab"))
    let e20 = choice(sv4)
    let r20 = peg_match(e20, "ab", 0)
    let r20ok = r20[0]
    let r20pos = r20[1]
    if r20ok != 1
        print("FAIL peg choice-first-ok: got "+str(r20ok)+" want 1")
        exit(1)
    if r20pos != 1
        print("FAIL peg choice-first-pos: got "+str(r20pos)+" want 1")
        exit(1)

    print("PASS _peg_test")
