import prism_node
import prism_arrange
import prism_content
import prism_ui_countdown

let mut results = []

// ---- SECTION 1: prism_cd_timer ----

let r_t0 = prism_ui_countdown.prism_cd_timer(0)
let c1 = is_ok(r_t0)
if c1 == false
    print("FAIL c1: timer(0) is_ok")
results.push(c1)

let t0 = unwrap(r_t0)
let c2 = (prism_node.prism_node_attr_str(t0, "text", "?") == "00:00:00")
if c2 == false
    print("FAIL c2: timer(0) text")
results.push(c2)

