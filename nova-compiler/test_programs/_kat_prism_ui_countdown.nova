// ---- SECTION 3: prism_cd_labeled ----

let r_lab1 = prism_ui_countdown.prism_cd_labeled("Sale Ends", 3661)
let c21 = is_ok(r_lab1)
if c21 == false
    print("FAIL c21: labeled(Sale Ends, 3661) is_ok")
results.push(c21)

let lab1 = unwrap(r_lab1)
let c22 = (prism_node.prism_node_kind_str(lab1) == "stack")
if c22 == false
    print("FAIL c22: labeled kind == stack")
results.push(c22)

let lab1_children = prism_node.prism_node_children(lab1)
let c23 = (len(lab1_children) == 2)
if c23 == false
    print("FAIL c23: labeled children_len == 2")
results.push(c23)

let c24 = (prism_node.prism_node_attr_str(lab1_children[0], "text", "?") == "Sale Ends")
