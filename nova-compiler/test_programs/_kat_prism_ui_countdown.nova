if c63 == false
    print("FAIL c63: progress(5,-10,5) is_err")
results.push(c63)

// ---- SUMMARY ----

let mut pass_count = 0
let mut fail_count = 0
for r in results
    if r
        pass_count += 1
    else
        fail_count += 1

print("")
print("_kat_prism_ui_countdown: " + str(pass_count) + "/" + str(len(results)) + " assertions passed")
if fail_count == 0
    print("ALL PASS")
else
    print("FAILURES: " + str(fail_count))
