import std/encoding/quotedprintable

fn cks(label, got, expected)
    if got == expected
        return null
    print("FAIL " + label + ": got=" + got + " expected=" + expected)
    exit(1)

fn main()
    // KAT 1: plain ASCII — no encoding needed
    cks("encode_hello", qp_encode("Hello"), "Hello")

    // KAT 2: '=' must encode as =3D
    cks("encode_eq", qp_encode("a=b"), "a=3Db")

    // KAT 3: byte 233 (é) must appear as =E9
    let cafe = "caf" + chr(233)
    let enc_cafe = qp_encode(cafe)
    // check that =E9 is present
    let found_e9 = 0
    let n = len(enc_cafe)
    let i = 0
    while i + 2 < n
        if char_at(enc_cafe, i) == "=" and char_at(enc_cafe, i+1) == "E" and char_at(enc_cafe, i+2) == "9"
            found_e9 = 1
        i = i + 1
    if found_e9 == 0
        print("FAIL encode_e9: =E9 not found in " + enc_cafe)
        exit(1)

    // KAT 4: decode =3D -> "="
    cks("decode_3D", qp_decode("=3D"), "=")

    // KAT 5: decode =20 -> space
    cks("decode_space", qp_decode("Hello=20World"), "Hello World")

    // KAT 6: soft line break "=\n" removed
    cks("decode_softbreak", qp_decode("a=\nb"), "ab")

    // KAT 7: round-trip encode->decode of "x=y z"
    let src = "x=y z"
    cks("roundtrip", qp_decode(qp_encode(src)), src)

    // KAT 8: lower-case hex in decode (=2b -> '+')
    cks("decode_lc", qp_decode("=2b"), "+")

    // KAT 9: space passes through in encode (mid-line)
    cks("encode_space", qp_encode("a b"), "a b")

    // KAT 10: control char <32 encodes as hex (e.g. chr(1) -> =01)
    cks("encode_ctrl", qp_encode(chr(1)), "=01")

    print("_quotedprintable_test passed")
