// _wav_test.nova — KAT for std/media/wav
//
// WAV PCM 16-bit known-answer test.
//
// HAND-VERIFIED VECTORS for wav_encode(8000, 1, [0, 100, -100, 32767, -32768])
//
//   numsamples = 5  (flat list, mono)
//   datasize   = 5 * 2 = 10
//   chunksize  = 36 + 10 = 46
//   Total file = 12 + 24 + 18 = 54 bytes
//
//   RIFF header (offsets 0..11):
//     [0..3]  = 'RIFF'  = 82,73,70,70
//     [4..7]  = u32le(46) = 46,0,0,0
//     [8..11] = 'WAVE'  = 87,65,86,69
//
//   fmt sub-chunk (offsets 12..35):
//     [12..15] = 'fmt ' = 102,109,116,32
//     [16..19] = u32le(16) = 16,0,0,0
//     [20..21] = u16le(1)  = 1,0   (PCM)
//     [22..23] = u16le(1)  = 1,0   (mono)
//     [24..27] = u32le(8000) = 64,31,0,0  (8000=0x1F40; lo=0x40=64, next=0x1F=31)
//     [28..31] = u32le(16000) byterate = 8000*1*2  (0x3E80; lo=0x80=128, next=0x3E=62)
//     [32..33] = u16le(2) blockalign = 1*2
//     [34..35] = u16le(16) bitspersmpl
//
//   data sub-chunk (offsets 36..53):
//     [36..39] = 'data' = 100,97,116,97
//     [40..43] = u32le(10) = 10,0,0,0
//     Samples (signed 16-bit LE):
//       0:      m=0;     lo=0,   hi=0   → [44]=0,  [45]=0
//       100:    m=100;   lo=100, hi=0   → [46]=100,[47]=0
//      -100:    m=65436; lo=156, hi=255 → [48]=156,[49]=255
//       32767:  m=32767; lo=255, hi=127 → [50]=255,[51]=127
//      -32768:  m=32768; lo=0,   hi=128 → [52]=0,  [53]=128
//
// Round-trip: wav_decode(wav_encode(...)) must return original samples.

import std/media/wav

// ── helpers ──────────────────────────────────────────────────────────────────

fn cki(label, got, want)
    if got != want
        print("FAIL wav " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, b, offset, want)
    let got = bytes_get(b, offset)
    if got != want
        print("FAIL wav byte[" + str(offset) + "] " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// Read u32 little-endian from bytes b at pos.
fn rd_u32le(b, pos)
    let b0 = bytes_get(b, pos)
    let b1 = bytes_get(b, pos + 1)
    let b2 = bytes_get(b, pos + 2)
    let b3 = bytes_get(b, pos + 3)
    b0 | (b1 * 256) | (b2 * 65536) | (b3 * 16777216)

// Read u16 little-endian from bytes b at pos.
fn rd_u16le(b, pos)
    let b0 = bytes_get(b, pos)
    let b1 = bytes_get(b, pos + 1)
    b0 | (b1 * 256)

fn main()
    // ── KAT 1: encode known vector ────────────────────────────────────────────
    let samples = [0, 100, -100, 32767, -32768]
    let w = wav_encode(8000, 1, samples)

    // (a) Total file size = 54.
    cki("filelen", bytes_len(w), 54)

    // (b) RIFF magic at [0..3].
    ckb("RIFF[0]", w, 0, 82)
    ckb("RIFF[1]", w, 1, 73)
    ckb("RIFF[2]", w, 2, 70)
    ckb("RIFF[3]", w, 3, 70)

    // (c) chunksize = 46 at offset 4.
    cki("chunksize", rd_u32le(w, 4), 46)

    // (d) WAVE at [8..11].
    ckb("WAVE[0]", w, 8,  87)
    ckb("WAVE[1]", w, 9,  65)
    ckb("WAVE[2]", w, 10, 86)
    ckb("WAVE[3]", w, 11, 69)

    // (e) 'fmt ' at [12..15].
    ckb("fmt[0]", w, 12, 102)
    ckb("fmt[1]", w, 13, 109)
    ckb("fmt[2]", w, 14, 116)
    ckb("fmt[3]", w, 15,  32)

    // (f) fmt sub-chunk size = 16 at offset 16.
    cki("fmtsize", rd_u32le(w, 16), 16)

    // (g) audiofmt = 1 (PCM) at offset 20.
    cki("audiofmt", rd_u16le(w, 20), 1)

    // (h) channels = 1 at offset 22.
    cki("channels", rd_u16le(w, 22), 1)

    // (i) samplerate = 8000 at offset 24.
    cki("samplerate", rd_u32le(w, 24), 8000)

    // (j) byterate = 16000 at offset 28.
    cki("byterate", rd_u32le(w, 28), 16000)

    // (k) blockalign = 2 at offset 32.
    cki("blockalign", rd_u16le(w, 32), 2)

    // (l) bitspersmpl = 16 at offset 34.
    cki("bitspersmpl", rd_u16le(w, 34), 16)

    // (m) 'data' at [36..39].
    ckb("data[0]", w, 36, 100)
    ckb("data[1]", w, 37,  97)
    ckb("data[2]", w, 38, 116)
    ckb("data[3]", w, 39,  97)

    // (n) datasize = 10 at offset 40.
    cki("datasize", rd_u32le(w, 40), 10)

    // (o) Sample bytes starting at offset 44.
    // sample 0 = 0
    ckb("s0_lo", w, 44,   0)
    ckb("s0_hi", w, 45,   0)
    // sample 1 = 100
    ckb("s1_lo", w, 46, 100)
    ckb("s1_hi", w, 47,   0)
    // sample 2 = -100 → 65436 → lo=156, hi=255
    ckb("s2_lo", w, 48, 156)
    ckb("s2_hi", w, 49, 255)
    // sample 3 = 32767 → lo=255, hi=127
    ckb("s3_lo", w, 50, 255)
    ckb("s3_hi", w, 51, 127)
    // sample 4 = -32768 → 32768 → lo=0, hi=128
    ckb("s4_lo", w, 52,   0)
    ckb("s4_hi", w, 53, 128)

    // ── KAT 2: decode round-trip ──────────────────────────────────────────────
    let dec = wav_decode(w)
    cki("rt_samplerate", dec["samplerate"], 8000)
    cki("rt_channels",   dec["channels"],   1)
    cki("rt_bits",       dec["bits"],        16)
    let dsmp = dec["samples"]
    cki("rt_samples_len", len(dsmp), 5)
    cki("rt_s0", dsmp[0],     0)
    cki("rt_s1", dsmp[1],   100)
    cki("rt_s2", dsmp[2],  -100)
    cki("rt_s3", dsmp[3], 32767)
    cki("rt_s4", dsmp[4], -32768)

    // ── KAT 3: encode stereo 2-channel ───────────────────────────────────────
    // 2 channels, 44100 Hz, 4 samples (2 frames: [L0,R0,L1,R1])
    let stereo = [1000, -1000, 2000, -2000]
    let ws = wav_encode(44100, 2, stereo)
    // datasize = 4*2 = 8; chunksize = 36+8 = 44
    cki("stereo_filelen",   bytes_len(ws), 52)
    cki("stereo_chunksize", rd_u32le(ws, 4), 44)
    cki("stereo_channels",  rd_u16le(ws, 22), 2)
    cki("stereo_samplerate",rd_u32le(ws, 24), 44100)
    cki("stereo_datasize",  rd_u32le(ws, 40), 8)

    // Round-trip stereo decode
    let ds = wav_decode(ws)
    cki("stereo_rt_channels",   ds["channels"],   2)
    cki("stereo_rt_samplerate", ds["samplerate"], 44100)
    let dss = ds["samples"]
    cki("stereo_rt_len",  len(dss), 4)
    cki("stereo_rt_s0",   dss[0],  1000)
    cki("stereo_rt_s1",   dss[1], -1000)
    cki("stereo_rt_s2",   dss[2],  2000)
    cki("stereo_rt_s3",   dss[3], -2000)

    // ── KAT 4: decode rejects malformed input ─────────────────────────────────
    let bad = bytes(10)
    let rbad = wav_decode(bad)
    cki("bad_empty_dict", len(rbad), 0)

    print("PASS _wav_test")
