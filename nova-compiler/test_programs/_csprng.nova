fn rand_hex(nbytes)
    let b = secure_bytes(nbytes)
    let n = bytes_len(b)
    let digits = "0123456789abcdef"
    let out = ""
    let i = 0
    while i < n
        let byte = bytes_get(b, i)
        out = out + digits[byte / 16] + digits[byte % 16]
        i = i + 1
    out
fn main()
    let a = rand_hex(16)
    let b = rand_hex(16)
    print("a len=" + str(len(a)) + " a=" + a)
    print("b len=" + str(len(b)) + " b=" + b)
    print("differ=" + str(a != b))
