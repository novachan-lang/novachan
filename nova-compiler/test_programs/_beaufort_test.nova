import std/cipher/beaufort

fn main()
    // ── KAT 1: Hand-checkable single-letter vector ───────────────────────────
    // beaufort_encrypt("A","B") = (ord('B')-ord('A')) mod 26 = 1 -> 'B'
    let v1 = beaufort_encrypt("A", "B")
    if v1 != "B"
        print("FAIL beaufort single-A-B: got " + v1 + " want B")
        exit(1)

    // beaufort_encrypt("B","B") = (1-1) mod 26 = 0 -> 'A'
    let v2 = beaufort_encrypt("B", "B")
    if v2 != "A"
        print("FAIL beaufort single-B-B: got " + v2 + " want A")
        exit(1)

    // beaufort_encrypt("Z","A") = (0-25+26) mod 26 = 1 -> 'B'
    let v3 = beaufort_encrypt("Z", "A")
    if v3 != "B"
        print("FAIL beaufort single-Z-A: got " + v3 + " want B")
        exit(1)

    // ── KAT 2: Known documentary vector ──────────────────────────────────────
    // beaufort_encrypt("DEFENDTHEEASTWALLOFTHECASTLE","FORTIFICATION")
    //   == "CKMPVCPVWPIWUJOGIUAPVWRIWUUK"
    let known_pt = "DEFENDTHEEASTWALLOFTHECASTLE"
    let known_key = "FORTIFICATION"
    let known_ct = "CKMPVCPVWPIWUJOGIUAPVWRIWUUK"
    let enc_known = beaufort_encrypt(known_pt, known_key)
    if enc_known != known_ct
        print("FAIL beaufort known-enc: got " + enc_known + " want " + known_ct)
        exit(1)

    // ── KAT 3: Involution — applying encrypt twice restores plaintext ─────────
    // beaufort_encrypt(beaufort_encrypt(pt, key), key) == pt
    let inv_ct = beaufort_encrypt(known_pt, known_key)
    let inv_rt = beaufort_encrypt(inv_ct, known_key)
    if inv_rt != known_pt
        print("FAIL beaufort involution: got " + inv_rt + " want " + known_pt)
        exit(1)

    // ── KAT 4: decrypt == encrypt (reciprocal property) ──────────────────────
    let dec_known = beaufort_decrypt(known_ct, known_key)
    if dec_known != known_pt
        print("FAIL beaufort decrypt-known: got " + dec_known + " want " + known_pt)
        exit(1)

    // ── KAT 5: Round-trip with a different key ────────────────────────────────
    let pt5 = "HELLOWORLD"
    let key5 = "SECRET"
    let ct5 = beaufort_encrypt(pt5, key5)
    let rt5 = beaufort_decrypt(ct5, key5)
    if rt5 != pt5
        print("FAIL beaufort round-trip HELLOWORLD/SECRET: got " + rt5 + " want " + pt5)
        exit(1)

    // ── KAT 6: Round-trip longer plaintext ───────────────────────────────────
    let pt6 = "THEQUICKBROWNFOXJUMPSOVERTHELAZYDOG"
    let key6 = "NOVA"
    let ct6 = beaufort_encrypt(pt6, key6)
    let rt6 = beaufort_decrypt(ct6, key6)
    if rt6 != pt6
        print("FAIL beaufort round-trip THEQUICK.../NOVA: got " + rt6 + " want " + pt6)
        exit(1)

    // ── KAT 7: Empty plaintext safety ────────────────────────────────────────
    let empty_enc = beaufort_encrypt("", "KEY")
    if empty_enc != ""
        print("FAIL beaufort empty-pt: got " + empty_enc + " want empty")
        exit(1)

    // ── KAT 8: Empty key safety ───────────────────────────────────────────────
    let empty_key_enc = beaufort_encrypt("HELLO", "")
    if empty_key_enc != ""
        print("FAIL beaufort empty-key: got " + empty_key_enc + " want empty")
        exit(1)

    // ── KAT 9: Key longer than plaintext ─────────────────────────────────────
    let pt9 = "AB"
    let key9 = "LONGERKEYHERE"
    let ct9 = beaufort_encrypt(pt9, key9)
    let rt9 = beaufort_decrypt(ct9, key9)
    if rt9 != pt9
        print("FAIL beaufort long-key round-trip: got " + rt9 + " want " + pt9)
        exit(1)

    // ── KAT 10: Non-letter characters normalised away from plaintext ──────────
    let pt10 = "HELLO, WORLD!"
    let ct10 = beaufort_encrypt(pt10, "KEY")
    let ct10_clean = beaufort_encrypt("HELLOWORLD", "KEY")
    if ct10 != ct10_clean
        print("FAIL beaufort normalise-pt: got " + ct10 + " want " + ct10_clean)
        exit(1)

    // ── KAT 11: Non-letter characters normalised away from key ───────────────
    let ct11a = beaufort_encrypt("HELLO", "K E Y")
    let ct11b = beaufort_encrypt("HELLO", "KEY")
    if ct11a != ct11b
        print("FAIL beaufort normalise-key: got " + ct11a + " want " + ct11b)
        exit(1)

    // ── KAT 12: Lowercase input normalised ───────────────────────────────────
    let ct12 = beaufort_encrypt("hello", "key")
    let ct12_up = beaufort_encrypt("HELLO", "KEY")
    if ct12 != ct12_up
        print("FAIL beaufort lowercase-normalise: got " + ct12 + " want " + ct12_up)
        exit(1)

    // ── KAT 13: Single-letter key (repeating) ────────────────────────────────
    // With key="A" (index 0): C = (0 - P) mod 26 = (-P+26) mod 26
    // beaufort_encrypt("A","A") = (0-0) mod 26 = 0 -> 'A'
    let v13a = beaufort_encrypt("A", "A")
    if v13a != "A"
        print("FAIL beaufort single-key-A: got " + v13a + " want A")
        exit(1)
    // beaufort_encrypt("B","A") = (0-1+26) mod 26 = 25 -> 'Z'
    let v13b = beaufort_encrypt("B", "A")
    if v13b != "Z"
        print("FAIL beaufort B-keyA: got " + v13b + " want Z")
        exit(1)
    // round-trip
    let rt13 = beaufort_decrypt(v13b, "A")
    if rt13 != "B"
        print("FAIL beaufort B-keyA round-trip: got " + rt13 + " want B")
        exit(1)

    // ── KAT 14: Variant Beaufort (German variant) — hand vectors ──────────────
    // beaufort_variant("A","B") = (0-1+26) mod 26 = 25 -> 'Z'
    let var1 = beaufort_variant("A", "B")
    if var1 != "Z"
        print("FAIL beaufort_variant A/B: got " + var1 + " want Z")
        exit(1)

    // beaufort_variant("B","B") = (1-1) mod 26 = 0 -> 'A'
    let var2 = beaufort_variant("B", "B")
    if var2 != "A"
        print("FAIL beaufort_variant B/B: got " + var2 + " want A")
        exit(1)

    // beaufort_variant("Z","A") = (25-0) mod 26 = 25 -> 'Z'
    let var3 = beaufort_variant("Z", "A")
    if var3 != "Z"
        print("FAIL beaufort_variant Z/A: got " + var3 + " want Z")
        exit(1)

    // ── KAT 15: Variant — hand-verify selected letters ───────────────────────
    // variant("HELLO","KEY"):
    //   H(7)  K(10): (7-10+26)  mod 26 = 23 -> X
    //   E(4)  E(4):  (4-4)      mod 26 =  0 -> A
    //   L(11) Y(24): (11-24+26) mod 26 = 13 -> N
    //   L(11) K(10): (11-10)    mod 26 =  1 -> B
    //   O(14) E(4):  (14-4)     mod 26 = 10 -> K
    // so beaufort_variant("HELLO","KEY") == "XANBK"
    let pt15 = "HELLO"
    let key15 = "KEY"
    let vct15 = beaufort_variant(pt15, key15)
    if vct15 != "XANBK"
        print("FAIL beaufort_variant HELLO/KEY: got " + vct15 + " want XANBK")
        exit(1)

    // ── KAT 16: Variant empty-key safety ─────────────────────────────────────
    let vempty = beaufort_variant("HELLO", "")
    if vempty != ""
        print("FAIL beaufort_variant empty-key: got " + vempty + " want empty")
        exit(1)

    print("PASS _beaufort_test")
