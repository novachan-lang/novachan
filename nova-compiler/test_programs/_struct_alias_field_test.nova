// _struct_alias_field_test.nova -- CORE_GAP 0.8 DOUBLE-FREE probe.
// The type-directed field-ownership fix makes structs OWN their managed fields (rc_inc on construct,
// bitmap-driven dec on free). The classic hazard the runtime comment warns about is ALIASING: the SAME
// heap value stored into two fields (Pair(x,x)) or into two distinct structs (Box(x); Box(x)). If the
// struct wrongly MOVED instead of SHARED (no inc), each owner's free would dec the same object -> the
// second dec is a double-free / use-after-free. The SHARE model (inc per managed field) makes this
// balanced: 2 inc + 1 source-drop + 2 dec = 0. This test drives both patterns hard, then churns fresh
// allocations to reuse any prematurely-freed memory -- a double-free corrupts the reused blocks and the
// value check fails (and ASAN traps the free). Correct output must be exact.

type Pair
    a: list
    b: list

type Box
    v: list

fn main()
    let n = 0
    // (1) ALIASING: same list x in BOTH fields of one struct.
    let iter = 0
    while iter < 2000
        let x = [iter, iter + 1]
        let p = Pair(x, x)
        n = n + len(p.a) + len(p.b)   // 2 + 2 = 4 per iter
        iter = iter + 1
    // (2) REUSE: same list y into two SEPARATE structs (both own it).
    let iter2 = 0
    while iter2 < 2000
        let y = [iter2]
        let b1 = Box(y)
        let b2 = Box(y)
        n = n + len(b1.v) + len(b2.v) // 1 + 1 = 2 per iter
        iter2 = iter2 + 1
    // (3) churn: reuse any wrongly-freed memory so a UAF corrupts observable state.
    let junk = []
    let k = 0
    while k < 500
        push(junk, [k, k, k])
        k = k + 1
    print("struct_alias_field n=" + str(n))
    // (1): 4 * 2000 = 8000 ; (2): 2 * 2000 = 4000 ; total = 12000
    if n != 12000
        print("struct_alias_field_test FAILED: value corruption (double-free/UAF) n=" + str(n))
        exit(1)
    print("struct_alias_field_test passed (aliased + reused struct fields survive, no double-free)")
