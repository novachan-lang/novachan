fn pad_right(s, width, ch)
  let out = s
  while len(out) < width
    out = out + ch
  out

fn pad_left(s, width, ch)
  let out = s
  while len(out) < width
    out = ch + out
  out

fn center(s, width, ch)
  let total_pad = width - len(s)
  if total_pad <= 0
    return s
  let left_pad = total_pad / 2
  let right_pad = total_pad - left_pad
  let out = ""
  let i = 0
  while i < left_pad
    out = out + ch
    i = i + 1
  out = out + s
  let j = 0
  while j < right_pad
    out = out + ch
    j = j + 1
  out

fn truncate(s, max_len, suffix)
  if len(s) <= max_len
    return s
  let cut = max_len - len(suffix)
  if cut < 0
    cut = 0
  slice(s, 0, cut) + suffix

fn repeat_str(s, n)
  let out = ""
  let i = 0
  while i < n
    out = out + s
    i = i + 1
  out

fn word_wrap(text, width)
  let words = split(text, " ")
  let lines = []
  let current = ""
  for w in words
    if len(current) == 0
      current = w
    else if len(current) + 1 + len(w) <= width
      current = current + " " + w
    else
      push(lines, current)
      current = w
  if len(current) > 0
    push(lines, current)
  join(lines, "\n")

fn indent(text, spaces)
  let prefix = repeat_str(" ", spaces)
  let lines = split(text, "\n")
  let result = []
  for line in lines
    push(result, prefix + line)
  join(result, "\n")

fn main()
  assert(pad_right("hi", 6, " ") == "hi    ", "pad right")
  assert(pad_right("hello", 3, " ") == "hello", "pad right no-op")

  assert(pad_left("42", 6, "0") == "000042", "pad left zeros")
  assert(pad_left("hi", 6, " ") == "    hi", "pad left spaces")

  assert(center("hi", 8, "-") == "---hi---", "center even")
  assert(center("abc", 7, " ") == "  abc  ", "center odd")

  assert(truncate("Hello World", 8, "...") == "Hello...", "truncate")
  assert(truncate("Hi", 8, "...") == "Hi", "truncate no-op")

  assert(repeat_str("ab", 3) == "ababab", "repeat")
  assert(repeat_str("x", 0) == "", "repeat 0")

  let wrapped = word_wrap("The quick brown fox jumps over the lazy dog", 15)
  let wlines = split(wrapped, "\n")
  assert(len(wlines) >= 3, "wrapped into multiple lines")
  let max_w = 0
  for wl in wlines
    if len(wl) > max_w
      max_w = len(wl)
  assert(max_w <= 15, "no line exceeds width")

  let indented = indent("line1\nline2\nline3", 4)
  assert(starts_with(indented, "    line1"), "indented")
  assert(contains(indented, "\n    line2"), "indent all lines")

  print("formatx: all passed")
