import std/numeric/dual

fn ckf(label, got, expected, eps)
    let diff = got - expected
    let adiff = diff
    if diff < 0.0
        let adiff = 0.0 - diff
    if adiff > eps
        print("FAIL: " + label + " got " + str(got) + " expected " + str(expected))
        exit(1)

fn main()
    let eps = 0.001

    // KAT 1: du_mul — (2 + 1*e)(3 + 1*e) = 6 + (2*1 + 1*3)*e = 6 + 5*e
    let m = dual.du_mul(dual.du_new(2.0, 1.0), dual.du_new(3.0, 1.0))
    ckf("mul.a", m["a"], 6.0, eps)
    ckf("mul.b", m["b"], 5.0, eps)

    // KAT 2: du_pow — (3 + 1*e)^2 = 9 + 2*3^1*1*e = 9 + 6*e
    let p = dual.du_pow(dual.du_new(3.0, 1.0), 2)
    ckf("pow.a", p["a"], 9.0, eps)
    ckf("pow.b", p["b"], 6.0, eps)

    // KAT 3: du_sin — sin(0 + 1*e) = sin(0) + cos(0)*1*e = 0 + 1*e
    let s = dual.du_sin(dual.du_new(0.0, 1.0))
    ckf("sin.a", s["a"], 0.0, eps)
    ckf("sin.b", s["b"], 1.0, eps)

    // KAT 4: du_add — (1+2*e) + (3+4*e) = 4 + 6*e
    let a = dual.du_add(dual.du_new(1.0, 2.0), dual.du_new(3.0, 4.0))
    ckf("add.a", a["a"], 4.0, eps)
    ckf("add.b", a["b"], 6.0, eps)

    // KAT 5: du_sub — (5+3*e) - (2+1*e) = 3 + 2*e
    let sb = dual.du_sub(dual.du_new(5.0, 3.0), dual.du_new(2.0, 1.0))
    ckf("sub.a", sb["a"], 3.0, eps)
    ckf("sub.b", sb["b"], 2.0, eps)

    // KAT 6: du_cos — cos(0 + 1*e) = cos(0) - sin(0)*1*e = 1 + 0*e
    let c = dual.du_cos(dual.du_new(0.0, 1.0))
    ckf("cos.a", c["a"], 1.0, eps)
    ckf("cos.b", c["b"], 0.0, eps)

    // KAT 7: du_exp — exp(0 + 1*e) = exp(0) + exp(0)*1*e = 1 + 1*e
    let e = dual.du_exp(dual.du_new(0.0, 1.0))
    ckf("exp.a", e["a"], 1.0, eps)
    ckf("exp.b", e["b"], 1.0, eps)

    // KAT 8: du_scale — scale(2+3*e, 4) = 8 + 12*e
    let sc = dual.du_scale(dual.du_new(2.0, 3.0), 4.0)
    ckf("scale.a", sc["a"], 8.0, eps)
    ckf("scale.b", sc["b"], 12.0, eps)

    // KAT 9: du_pow n=0 — (5+1*e)^0 = 1 + 0*e
    let p0 = dual.du_pow(dual.du_new(5.0, 1.0), 0)
    ckf("pow0.a", p0["a"], 1.0, eps)
    ckf("pow0.b", p0["b"], 0.0, eps)

    // KAT 10: du_pow n=1 — (7+1*e)^1 = 7 + 1*e
    let p1 = dual.du_pow(dual.du_new(7.0, 1.0), 1)
    ckf("pow1.a", p1["a"], 7.0, eps)
    ckf("pow1.b", p1["b"], 1.0, eps)

    // KAT 11: du_new preserves floats
    let n = dual.du_new(3.14, 2.71)
    ckf("new.a", n["a"], 3.14, eps)
    ckf("new.b", n["b"], 2.71, eps)

    // KAT 12: derivative of x^3 at x=2 is 3*x^2 = 12
    let x3 = dual.du_pow(dual.du_new(2.0, 1.0), 3)
    ckf("pow3.a", x3["a"], 8.0, eps)
    ckf("pow3.b", x3["b"], 12.0, eps)

    print("_dual_test passed")
