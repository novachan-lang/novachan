import forge_api_key

fn main()
    let ak = ak_new()
    assert(ak_key_count(ak) == 0, "empty")

    let r1 = ak_issue(ak, "alice", ["read", "write"])
    ak = r1["ak"]
    let key1 = r1["key"]
    assert(ak_key_count(ak) == 1, "1 key")

    let r2 = ak_issue(ak, "bob", ["read"])
    ak = r2["ak"]
    let key2 = r2["key"]

    let r3 = ak_issue(ak, "admin", ["*"])
    ak = r3["ak"]
    let key3 = r3["key"]
    assert(ak_key_count(ak) == 3, "3 keys")
    assert(ak_active_count(ak) == 3, "3 active")

    assert(ak_validate(ak, key1) == 1, "key1 valid")
    assert(ak_validate(ak, "fake_key") == 0, "fake invalid")

    assert(ak_has_scope(ak, key1, "read") == 1, "alice has read")
    assert(ak_has_scope(ak, key1, "write") == 1, "alice has write")
    assert(ak_has_scope(ak, key1, "admin") == 0, "alice no admin")

    assert(ak_has_scope(ak, key2, "read") == 1, "bob has read")
    assert(ak_has_scope(ak, key2, "write") == 0, "bob no write")

    assert(ak_has_scope(ak, key3, "anything") == 1, "admin wildcard")

    assert(ak_owner(ak, key1) == "alice", "owner=alice")
    assert(ak_owner(ak, "fake") == "", "fake owner empty")

    ak = ak_record_use(ak, key1)
    ak = ak_record_use(ak, key1)
    ak = ak_record_use(ak, key2)
    assert(ak_usage(ak, key1) == 2, "key1 used 2x")
    assert(ak_usage(ak, key2) == 1, "key2 used 1x")

    ak = ak_revoke(ak, key2)
    assert(ak_validate(ak, key2) == 0, "key2 revoked")
    assert(ak_has_scope(ak, key2, "read") == 0, "revoked no scope")
    assert(ak_active_count(ak) == 2, "2 active")
    assert(ak_revoked_count(ak) == 1, "1 revoked")

    print("API-KEY KAT PASS")
