import forge_on_call

fn main()
    let oc = oc_new()
    oc = oc_add_schedule(oc, "backend")
    oc = oc_add_schedule(oc, "frontend")
    assert(oc_schedule_count(oc) == 2, "2 schedules")
    assert(oc_has_schedule(oc, "backend") == 1, "has backend")

    let p1 = oc_set_primary(oc, "backend", "alice")
    oc = unwrap(p1)
    let p2 = oc_set_secondary(oc, "backend", "bob")
    oc = unwrap(p2)

    let pr = oc_primary(oc, "backend")
    assert(unwrap(pr) == "alice", "alice primary")
    let sc = oc_secondary(oc, "backend")
    assert(unwrap(sc) == "bob", "bob secondary")

    let pg = oc_page(oc, "backend", "P1", "DB down")
    oc = unwrap(pg)
    let pg2 = oc_page(oc, "backend", "P2", "High latency")
    oc = unwrap(pg2)
    assert(oc_total_pages(oc) == 2, "2 pages")

    let pc = oc_page_count(oc, "backend")
    assert(unwrap(pc) == 2, "backend 2 pages")

    let noprimary = oc_page(oc, "frontend", "P1", "Test")
    assert(is_err(noprimary), "no one on call")

    let nosec = oc_secondary(oc, "frontend")
    assert(is_err(nosec), "no secondary")

    let bad = oc_primary(oc, "nope")
    assert(is_err(bad), "no schedule")

    print("ON-CALL KAT PASS")
