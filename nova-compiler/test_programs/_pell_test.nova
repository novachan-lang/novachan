import std/math/pell

// KAT: pel_pell sequence P(0)=0, P(1)=1, P(2)=2, P(3)=5, P(4)=12, P(5)=29
let p0 = pel_pell(0)
if p0 != 0
    print("FAIL pel_pell(0) expected 0 got " + str(p0))
    exit(1)

let p1 = pel_pell(1)
if p1 != 1
    print("FAIL pel_pell(1) expected 1 got " + str(p1))
    exit(1)

let p2 = pel_pell(2)
if p2 != 2
    print("FAIL pel_pell(2) expected 2 got " + str(p2))
    exit(1)

let p3 = pel_pell(3)
if p3 != 5
    print("FAIL pel_pell(3) expected 5 got " + str(p3))
    exit(1)

let p4 = pel_pell(4)
if p4 != 12
    print("FAIL pel_pell(4) expected 12 got " + str(p4))
    exit(1)

let p5 = pel_pell(5)
if p5 != 29
    print("FAIL pel_pell(5) expected 29 got " + str(p5))
    exit(1)

// KAT: pel_companion Q(0)=2, Q(1)=2, Q(2)=6, Q(3)=14, Q(4)=34
let q0 = pel_companion(0)
if q0 != 2
    print("FAIL pel_companion(0) expected 2 got " + str(q0))
    exit(1)

let q1 = pel_companion(1)
if q1 != 2
    print("FAIL pel_companion(1) expected 2 got " + str(q1))
    exit(1)

let q2 = pel_companion(2)
if q2 != 6
    print("FAIL pel_companion(2) expected 6 got " + str(q2))
    exit(1)

let q3 = pel_companion(3)
if q3 != 14
    print("FAIL pel_companion(3) expected 14 got " + str(q3))
    exit(1)

let q4 = pel_companion(4)
if q4 != 34
    print("FAIL pel_companion(4) expected 34 got " + str(q4))
    exit(1)

// KAT: pel_solve_equation(2) == [3, 2]  (3^2 - 2*2^2 = 9-8 = 1)
let sol2 = pel_solve_equation(2)
let sol2x = sol2[0]
let sol2y = sol2[1]
if sol2x != 3
    print("FAIL pel_solve_equation(2)[0] expected 3 got " + str(sol2x))
    exit(1)
if sol2y != 2
    print("FAIL pel_solve_equation(2)[1] expected 2 got " + str(sol2y))
    exit(1)

// KAT: pel_solve_equation(3) == [2, 1]  (2^2 - 3*1^2 = 4-3 = 1)
let sol3 = pel_solve_equation(3)
let sol3x = sol3[0]
let sol3y = sol3[1]
if sol3x != 2
    print("FAIL pel_solve_equation(3)[0] expected 2 got " + str(sol3x))
    exit(1)
if sol3y != 1
    print("FAIL pel_solve_equation(3)[1] expected 1 got " + str(sol3y))
    exit(1)

// KAT: pel_solve_equation(7) == [8, 3]  (8^2 - 7*3^2 = 64-63 = 1)
let sol7 = pel_solve_equation(7)
let sol7x = sol7[0]
let sol7y = sol7[1]
if sol7x != 8
    print("FAIL pel_solve_equation(7)[0] expected 8 got " + str(sol7x))
    exit(1)
if sol7y != 3
    print("FAIL pel_solve_equation(7)[1] expected 3 got " + str(sol7y))
    exit(1)

// KAT: pel_list(6) == [0, 1, 2, 5, 12, 29]
let lst = pel_list(6)
let lst_len = len(lst)
if lst_len != 6
    print("FAIL pel_list(6) length expected 6 got " + str(lst_len))
    exit(1)

let le0 = lst[0]
if le0 != 0
    print("FAIL pel_list(6)[0] expected 0 got " + str(le0))
    exit(1)

let le1 = lst[1]
if le1 != 1
    print("FAIL pel_list(6)[1] expected 1 got " + str(le1))
    exit(1)

let le2 = lst[2]
if le2 != 2
    print("FAIL pel_list(6)[2] expected 2 got " + str(le2))
    exit(1)

let le3 = lst[3]
if le3 != 5
    print("FAIL pel_list(6)[3] expected 5 got " + str(le3))
    exit(1)

let le4 = lst[4]
if le4 != 12
    print("FAIL pel_list(6)[4] expected 12 got " + str(le4))
    exit(1)

let le5 = lst[5]
if le5 != 29
    print("FAIL pel_list(6)[5] expected 29 got " + str(le5))
    exit(1)

// KAT: pel_list(0) == []
let lst0 = pel_list(0)
let lst0_len = len(lst0)
if lst0_len != 0
    print("FAIL pel_list(0) length expected 0 got " + str(lst0_len))
    exit(1)

// KAT: pel_solve_equation(5) == [9, 4]  (9^2 - 5*4^2 = 81-80 = 1)
let sol5 = pel_solve_equation(5)
let sol5x = sol5[0]
let sol5y = sol5[1]
if sol5x != 9
    print("FAIL pel_solve_equation(5)[0] expected 9 got " + str(sol5x))
    exit(1)
if sol5y != 4
    print("FAIL pel_solve_equation(5)[1] expected 4 got " + str(sol5y))
    exit(1)

print("_pell_test passed")
