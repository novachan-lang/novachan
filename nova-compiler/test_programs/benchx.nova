fn bench(name, iterations, action)
  let start = clock_ns()
  let i = 0
  while i < iterations
    let _r = action(i)
    i = i + 1
  let elapsed_ns = clock_ns() - start
  let ns_per_op = elapsed_ns / iterations
  let ops_per_sec = 0
  if ns_per_op > 0
    ops_per_sec = 1000000000 / ns_per_op
  {"name": name, "iterations": iterations, "total_ns": elapsed_ns, "ns_per_op": ns_per_op, "ops_per_sec": ops_per_sec}

fn bench_report(result)
  result["name"] + ": " + str(result["ns_per_op"]) + " ns/op (" + str(result["ops_per_sec"]) + " ops/sec, " + str(result["iterations"]) + " iters)"

fn bench_compare(a, b)
  if a["ns_per_op"] == 0 or b["ns_per_op"] == 0
    return "cannot compare (zero)"
  let ratio = b["ns_per_op"] * 100 / a["ns_per_op"]
  a["name"] + " vs " + b["name"] + ": " + str(ratio) + "% (lower is faster)"

fn _fib(n)
  if n <= 1
    return n
  let a = 0
  let b = 1
  let i = 2
  while i <= n
    let t = a + b
    a = b
    b = t
    i = i + 1
  b

fn _sum_range(n)
  let s = 0
  let i = 0
  while i < 1000
    s = s + i
    i = i + 1
  s

fn main()
  let r1 = bench("fib(20)", 1000, fn(z) _fib(20))
  assert(r1["iterations"] == 1000, "iterations")
  assert(r1["total_ns"] > 0, "elapsed > 0")
  assert(r1["ns_per_op"] >= 0, "ns/op >= 0")

  let report = bench_report(r1)
  assert(contains(report, "fib(20)"), "report has name")
  assert(contains(report, "ns/op"), "report has ns/op")

  // bench_compare is exercised with SYNTHETIC results, not measured ones.
  //
  // ns_per_op is an INTEGER division (elapsed_ns / iterations), and _fib here is the ITERATIVE
  // Fibonacci, so 1000 iterations can average under 1ns on fast hardware and truncate to 0.
  // bench_compare then correctly takes its "cannot compare (zero)" branch, which contains no
  // "vs" -- so asserting on "vs" after a real measurement made this a test of how fast the host
  // is, not of what bench_compare does. It passed on x86_64 and failed on the aarch64 runner for
  // exactly that reason. Feeding it known inputs tests the contract on every machine, and lets
  // us assert the ratio and the degenerate branch too, which the timing-dependent version could
  // not do at all.
  let fast = {"name": "fast", "iterations": 1000, "total_ns": 1000000, "ns_per_op": 1000, "ops_per_sec": 1000000}
  let slow = {"name": "slow", "iterations": 1000, "total_ns": 2000000, "ns_per_op": 2000, "ops_per_sec": 500000}
  let cmp = bench_compare(fast, slow)
  assert(contains(cmp, "vs"), "compare has vs")
  assert(contains(cmp, "200%"), "compare computes the ratio (2000/1000)")
  let zero = {"name": "z", "iterations": 1, "total_ns": 0, "ns_per_op": 0, "ops_per_sec": 0}
  assert(contains(bench_compare(fast, zero), "cannot compare"), "zero branch is reported, not silently wrong")

  // A real second measurement still has to produce sane fields -- that part IS machine-independent.
  let r2 = bench("sum", 1000, fn(z) _sum_range(z))
  assert(r2["iterations"] == 1000, "r2 iterations")
  assert(r2["ns_per_op"] >= 0, "r2 ns/op >= 0")

  print("benchx: all passed")
