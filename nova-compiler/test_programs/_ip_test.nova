// KAT for std/net/ip — IPv4 parse/format + CIDR containment.
import std/net/ip

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": " + str(got) + " != " + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": '" + got + "' != '" + want + "'")
        exit(1)

fn cktrue(label: string, got: bool)
    if not got
        print("FAIL " + label + ": expected true")
        exit(1)

fn ckfalse(label: string, got: bool)
    if got
        print("FAIL " + label + ": expected false")
        exit(1)

fn main()
    cki("parse", ipv4_parse("192.168.1.1"), 3232235777)
    cki("parse0", ipv4_parse("0.0.0.0"), 0)
    cki("parsemax", ipv4_parse("255.255.255.255"), 4294967295)
    cki("parse10", ipv4_parse("10.0.0.5"), 167772165)
    cki("bad256", ipv4_parse("256.1.1.1"), -1)
    cki("short", ipv4_parse("1.2.3"), -1)
    cks("format", ipv4_format(3232235777), "192.168.1.1")
    cks("format0", ipv4_format(0), "0.0.0.0")
    cktrue("cidr8-in", cidr_contains("10.0.0.0/8", "10.5.4.3"))
    ckfalse("cidr8-out", cidr_contains("10.0.0.0/8", "11.0.0.1"))
    cktrue("cidr24-in", cidr_contains("192.168.1.0/24", "192.168.1.55"))
    ckfalse("cidr24-out", cidr_contains("192.168.1.0/24", "192.168.2.1"))
    cki("roundtrip", ipv4_parse(ipv4_format(167772165)), 167772165)
    print("_ip_test passed")
