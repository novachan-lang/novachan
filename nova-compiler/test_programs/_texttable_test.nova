// KAT for std/textlayout/texttable — ASCII table rendering.
import std/textlayout/texttable

fn cks(label, got, want)
    if got != want
        print("FAIL texttable " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL texttable " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck_ilist(label, got, want)
    if len(got) != len(want)
        print("FAIL texttable " + label + ": len(got)=" + str(len(got)) + " len(want)=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL texttable " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // ── ttab_col_widths ──────────────────────────────────────────────────────
    // rows=[['a','bb'],['ccc','d']]
    //   col0: max(len('a')=1, len('ccc')=3) = 3
    //   col1: max(len('bb')=2, len('d')=1) = 2
    let rows1 = [["a", "bb"], ["ccc", "d"]]
    ck_ilist("ttab_col_widths-basic", ttab_col_widths(rows1), [3, 2])
    // Single row
    ck_ilist("ttab_col_widths-1row", ttab_col_widths([["hi", "there"]]), [2, 5])
    // Empty rows
    ck_ilist("ttab_col_widths-empty", ttab_col_widths([]), [])

    // ── ttab_separator ───────────────────────────────────────────────────────
    // ttab_separator([3,2]):
    //   col0: '+' + '-'*(3+2) = '+-----'
    //   col1: '+' + '-'*(2+2) = '+----'
    //   final: '+'
    //   = '+-----+----+'
    cks("ttab_separator-3-2", ttab_separator([3, 2]), "+-----+----+")
    // ttab_separator([1,1]):
    //   '+' + '---' + '+' + '---' + '+' = '+---+---+'
    cks("ttab_separator-1-1", ttab_separator([1, 1]), "+---+---+")
    // Single column
    cks("ttab_separator-single", ttab_separator([4]), "+------+")

    // ── ttab_row ─────────────────────────────────────────────────────────────
    // ttab_row(['a','b'], [3,2]):
    //   '| ' + ljust('a',3) + ' ' + '| ' + ljust('b',2) + ' ' + '|'
    //   = '| ' + 'a  ' + ' | ' + 'b ' + ' |'
    //   = '| a   | b  |'
    cks("ttab_row-basic", ttab_row(["a", "b"], [3, 2]), "| a   | b  |")
    // Long cell = no truncation; cell already fits.
    cks("ttab_row-exact", ttab_row(["abc", "de"], [3, 2]), "| abc | de |")
    // Single column
    cks("ttab_row-single", ttab_row(["hi"], [4]), "| hi   |")

    // ── ttab_render ──────────────────────────────────────────────────────────
    // rows=[['a','b'],['1','2']]
    //   col_widths = [1,1]
    //   sep = '+---+---+'
    //   row 0: '| a | b |'
    //   row 1: '| 1 | 2 |'
    //   full: sep + nl + row0 + nl + sep + nl + row1 + nl + sep
    let rows2 = [["a", "b"], ["1", "2"]]
    let nl = chr(10)
    let sep11 = "+---+---+"
    let want_r2 = sep11 + nl + "| a | b |" + nl + sep11 + nl + "| 1 | 2 |" + nl + sep11
    cks("ttab_render-2row", ttab_render(rows2), want_r2)

    // rows=[['a','bb'],['ccc','d']]
    //   col_widths = [3,2]
    //   sep = '+-----+----+'
    //   row 0: '| a   | bb |'
    //   row 1: '| ccc | d  |'
    let sep32 = "+-----+----+"
    let want_r3 = sep32 + nl + "| a   | bb |" + nl + sep32 + nl + "| ccc | d  |" + nl + sep32
    cks("ttab_render-varying-width", ttab_render(rows1), want_r3)

    // Empty rows: single separator with zero columns = "+"
    let want_empty = "+"
    cks("ttab_render-empty", ttab_render([]), want_empty)

    // ── ttab_render_no_border ─────────────────────────────────────────────────
    // rows=[['a','bb'],['ccc','d']], col_widths=[3,2]
    //   row 0: ljust('a',3)+'  '+'bb'  = 'a  '+'  '+'bb'  = 'a    bb'
    //   row 1: ljust('ccc',3)+'  '+'d' = 'ccc'+'  '+'d'   = 'ccc  d'
    let want_nb = "a    bb" + nl + "ccc  d"
    cks("ttab_render_no_border", ttab_render_no_border(rows1), want_nb)

    // ── ttab_render_align ─────────────────────────────────────────────────────
    // rows=[['a','b'],['1','2']], aligns=['l','r']
    //   col_widths=[1,1], sep='+---+---+'
    //   row 0 col0 'a' left -> 'a'; col1 'b' right -> 'b'
    //   row 0: '| a | b |'
    //   row 1 col0 '1' left -> '1'; col1 '2' right -> '2'
    //   row 1: '| 1 | 2 |'
    let want_al = sep11 + nl + "| a | b |" + nl + sep11 + nl + "| 1 | 2 |" + nl + sep11
    cks("ttab_render_align-lr", ttab_render_align(rows2, ["l", "r"]), want_al)

    // Center alignment: rows=[['ab','c']], aligns=['c','c']
    //   col_widths=[2,1]
    //   sep = '+----+---+'
    //   row 0 col0 'ab' center in 2 -> 'ab'; col1 'c' center in 1 -> 'c'
    //   row 0: '| ab | c |'
    let rowsc = [["ab", "c"]]
    let sepc = "+----+---+"
    let want_c = sepc + nl + "| ab | c |" + nl + sepc
    cks("ttab_render_align-center", ttab_render_align(rowsc, ["c", "c"]), want_c)

    // ── ttab_header ──────────────────────────────────────────────────────────
    // rows=[['Name','Age'],['Alice','30'],['Bob','25']]
    //   col_widths = [max(4,5,3)=5, max(3,2,2)=3]
    //   sep = '+-------+-----+'
    //   header row: '| Name  | Age |'
    //   data row 0: '| Alice | 30  |'
    //   data row 1: '| Bob   | 25  |'
    let rows_h = [["Name", "Age"], ["Alice", "30"], ["Bob", "25"]]
    let sep_h = "+-------+-----+"
    let want_h = sep_h + nl + "| Name  | Age |" + nl + sep_h + nl + "| Alice | 30  |" + nl + sep_h + nl + "| Bob   | 25  |" + nl + sep_h
    cks("ttab_header-basic", ttab_header(rows_h), want_h)

    print("PASS _texttable_test")
