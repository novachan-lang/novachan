import encoding

fn main()
    // URL encoding
    let encoded = encoding.url_encode("hello world&foo=bar")
    assert_eq(encoding.url_decode(encoded), "hello world&foo=bar")

    // Verify special chars are encoded
    if find(encoded, "%20") < 0 and find(encoded, "+") < 0
        print("FAIL: url_encode didn't encode space")
        exit(1)

    // Query string
    let params = {}
    params["name"] = "nova"
    params["version"] = "3"
    let qs = encoding.query_string(params)
    if find(qs, "name=nova") < 0
        print("FAIL: query_string missing name=nova")
        exit(1)

    let parsed = encoding.query_parse("a=1&b=2")
    assert_eq(parsed["a"], "1")
    assert_eq(parsed["b"], "2")

    // HTML escape
    let esc = encoding.html_escape("<div class=\"test\">&</div>")
    if find(esc, "&lt;") < 0
        print("FAIL: html_escape didn't escape <")
        exit(1)
    if find(esc, "&amp;") < 0
        print("FAIL: html_escape didn't escape &")
        exit(1)
    let unesc = encoding.html_unescape("&lt;b&gt;hi&lt;/b&gt;")
    assert_eq(unesc, "<b>hi</b>")

    // CSV
    let row = encoding.csv_encode_row(["name", "age", "city"])
    assert_eq(row, "name,age,city")
    let row2 = encoding.csv_encode_row(["hello, world", "simple", "has \"quotes\""])
    if find(row2, "\"hello, world\"") < 0
        print("FAIL: csv_encode_row didn't quote comma field")
        exit(1)
    let dec = encoding.csv_decode_row("a,b,c")
    assert_eq(len(dec), 3)
    assert_eq(dec[0], "a")
    assert_eq(dec[2], "c")

    print("TRACK 7 ENCODING TEST PASSED")
