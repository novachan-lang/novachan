fn main()
    // Test: 3224829557 >> 16
    let h = 3224829557
    let shifted = h >> 16
    print("h = " + str(h))
    print("h >> 16 = " + str(shifted))
    // Expected: 49213 (= 0xC03D)
    // Test XOR
    let xored = h ^ shifted
    print("h ^ (h>>16) = " + str(xored))
    // Expected: 0xC03DE248 = 3224961608

    // Test the mask approach
    let shifted2 = (h >> 16) & 0xFFFF
    print("(h>>16) & 0xFFFF = " + str(shifted2))
    let xored2 = (h ^ ((h >> 16) & 0xFFFF)) & 0xFFFFFFFF
    print("masked xor = " + str(xored2))

    // Also test with a value that has bit 31 set as i64 perspective
    // 0xC03D2275 = 3224829557 (positive i64)
    // But what if we mask it first?
    let h2 = 3224829557 & 0xFFFFFFFF
    print("h2 = " + str(h2))
    print("h2 >> 16 = " + str(h2 >> 16))
