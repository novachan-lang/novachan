// Wave-C: MySQL binary-protocol DATE/DATETIME/TIMESTAMP/TIME decode. Offline KAT (hand-built packets).
import forge_mysql

fn _b(vals: list) -> any
    let out = bytes(0)
    let i = 0
    while i < len(vals)
        out = bytes_append(out, vals[i])
        i = i + 1
    out

fn main()
    // DATE 2024-01-15 (year 2024 = LE 232,7); len=4
    let dr = mysql_bin_val(_b([4, 232, 7, 1, 15]), 0, 10)
    if dr[0] != "2024-01-15" or dr[1] != 5
        print("FAIL date: '" + dr[0] + "' next=" + str(dr[1]))
        exit(1)
    // DATE zero
    let dzr = mysql_bin_val(_b([0]), 0, 10)
    if dzr[0] != "0000-00-00" or dzr[1] != 1
        print("FAIL date0")
        exit(1)
    // DATETIME 2024-01-15 10:30:45 (len=7)
    let dtr = mysql_bin_val(_b([7, 232, 7, 1, 15, 10, 30, 45]), 0, 12)
    if dtr[0] != "2024-01-15 10:30:45" or dtr[1] != 8
        print("FAIL datetime: '" + dtr[0] + "'")
        exit(1)
    // DATETIME + micros=123456 (LE 64,226,1,0); len=11
    let dtmr = mysql_bin_val(_b([11, 232, 7, 1, 15, 10, 30, 45, 64, 226, 1, 0]), 0, 12)
    if dtmr[0] != "2024-01-15 10:30:45.123456" or dtmr[1] != 12
        print("FAIL datetime-us: '" + dtmr[0] + "'")
        exit(1)
    // TIMESTAMP (t==7) same layout
    let tspr = mysql_bin_val(_b([7, 232, 7, 1, 15, 10, 30, 45]), 0, 7)
    if tspr[0] != "2024-01-15 10:30:45"
        print("FAIL timestamp: '" + tspr[0] + "'")
        exit(1)
    // TIME 10:30:45 (len=8, days=0)
    let tmr = mysql_bin_val(_b([8, 0, 0, 0, 0, 0, 10, 30, 45]), 0, 11)
    if tmr[0] != "10:30:45" or tmr[1] != 9
        print("FAIL time: '" + tmr[0] + "'")
        exit(1)
    // TIME negative 2 days 3:04:05 -> -51:04:05
    let tnr = mysql_bin_val(_b([8, 1, 2, 0, 0, 0, 3, 4, 5]), 0, 11)
    if tnr[0] != "-51:04:05"
        print("FAIL time-neg: '" + tnr[0] + "'")
        exit(1)
    // TIME zero
    let tzr = mysql_bin_val(_b([0]), 0, 11)
    if tzr[0] != "00:00:00" or tzr[1] != 1
        print("FAIL time0")
        exit(1)
    print("PASS _mysql_temporal_test")
