// FINDING #1 bool: json_encode of a bool must be true/false (was 1/0).
// Bool literals now carry bool type through the IR, so the json_encode rewrite
// routes them to nova_rt_json_encode_bool.
fn main()
    assert_eq(json_encode(true), "true")
    assert_eq(json_encode(false), "false")
    // typed bool still behaves normally
    let b = true
    assert_eq(b, true)
    let c = false
    assert_eq(c, false)
    print("bool json test passed")
