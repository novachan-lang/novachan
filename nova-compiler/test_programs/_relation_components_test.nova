import std/relation/relation_components

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let g = 0
    let w = 0
    if got
        g = 1
    if want
        w = 1
    if g != w
        print("FAIL " + label + ": got=" + str(g) + " want=" + str(w))
        exit(1)

fn ckl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL " + label + ": at " + str(i) + " got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

// Build an n x n zero matrix.
fn make_zero(n: int) -> list
    let M = []
    let i = 0
    while i < n
        let row = []
        let j = 0
        while j < n
            row.push(0)
            j = j + 1
        M.push(row)
        i = i + 1
    return M

fn main()
    // =========================================================================
    // KAT 1: M={(0,1),(2,3)} on n=4: two components {0,1} and {2,3}
    // =========================================================================
    let M1 = make_zero(4)
    M1[0][1] = 1
    M1[2][3] = 1

    let comps1 = rcmp_components(M1, 4)
    cki("kat1_num_comps", len(comps1), 2)
    // Component 0: [0,1]
    let c0 = comps1[0]
    ckl("kat1_comp0", c0, [0, 1])
    // Component 1: [2,3]
    let c1 = comps1[1]
    ckl("kat1_comp1", c1, [2, 3])

    cki("kat1_num_components", rcmp_num_components(M1, 4), 2)
    ckb("kat1_is_connected", rcmp_is_connected(M1, 4), false)

    // =========================================================================
    // KAT 2: M={(0,1),(1,2)} on n=3: one component [0,1,2]
    // =========================================================================
    let M2 = make_zero(3)
    M2[0][1] = 1
    M2[1][2] = 1

    let comps2 = rcmp_components(M2, 3)
    cki("kat2_num_comps", len(comps2), 1)
    let c2 = comps2[0]
    ckl("kat2_comp0", c2, [0, 1, 2])
    ckb("kat2_is_connected", rcmp_is_connected(M2, 3), true)
    let comp_of_0 = rcmp_component_of(M2, 3, 0)
    ckl("kat2_component_of_0", comp_of_0, [0, 1, 2])

    // =========================================================================
    // KAT 3: empty relation on n=3 -> three singleton components
    // =========================================================================
    let M3 = make_zero(3)
    let comps3 = rcmp_components(M3, 3)
    cki("kat3_num_comps", len(comps3), 3)
    let e0 = []
    e0.push(0)
    let e1 = []
    e1.push(1)
    let e2 = []
    e2.push(2)
    ckl("kat3_comp0", comps3[0], e0)
    ckl("kat3_comp1", comps3[1], e1)
    ckl("kat3_comp2", comps3[2], e2)
    cki("kat3_num_components", rcmp_num_components(M3, 3), 3)
    ckb("kat3_is_connected", rcmp_is_connected(M3, 3), false)

    // =========================================================================
    // KAT 4: rcmp_component_of for connected graph
    // =========================================================================
    let comp_of_2 = rcmp_component_of(M2, 3, 2)
    ckl("kat4_component_of_2", comp_of_2, [0, 1, 2])

    // =========================================================================
    // KAT 5: symmetric closure — directed edge (0->1) becomes symmetric {(0,1),(1,0)}
    // =========================================================================
    let M5 = make_zero(3)
    M5[0][1] = 1
    let sc = rcmp_symmetric_closure(M5, 3)
    cki("kat5_sc_01", sc[0][1], 1)
    cki("kat5_sc_10", sc[1][0], 1)
    cki("kat5_sc_00", sc[0][0], 0)
    cki("kat5_sc_22", sc[2][2], 0)

    // =========================================================================
    // KAT 6: n=1 — single vertex, no edges; one component [0]
    // =========================================================================
    let M6 = make_zero(1)
    cki("kat6_num_components", rcmp_num_components(M6, 1), 1)
    ckb("kat6_is_connected", rcmp_is_connected(M6, 1), true)
    let comp6 = rcmp_component_of(M6, 1, 0)
    let want6 = []
    want6.push(0)
    ckl("kat6_component_of_0", comp6, want6)

    // =========================================================================
    // KAT 7: n=0 — trivially connected, 0 components
    // =========================================================================
    let M7 = []
    cki("kat7_num_components", rcmp_num_components(M7, 0), 0)
    ckb("kat7_is_connected", rcmp_is_connected(M7, 0), true)

    // =========================================================================
    // KAT 8: complete relation on n=4 -> 1 component [0,1,2,3]
    // =========================================================================
    let M8 = make_zero(4)
    let ki = 0
    while ki < 4
        let kj = 0
        while kj < 4
            if ki != kj
                M8[ki][kj] = 1
            kj = kj + 1
        ki = ki + 1
    cki("kat8_num_components", rcmp_num_components(M8, 4), 1)
    ckb("kat8_is_connected", rcmp_is_connected(M8, 4), true)

    // =========================================================================
    // KAT 9: already-symmetric relation (M[i][j]=M[j][i]) — symmetric closure unchanged
    // =========================================================================
    let M9 = make_zero(3)
    M9[0][1] = 1
    M9[1][0] = 1
    let sc9 = rcmp_symmetric_closure(M9, 3)
    cki("kat9_sc_01", sc9[0][1], 1)
    cki("kat9_sc_10", sc9[1][0], 1)
    cki("kat9_sc_02", sc9[0][2], 0)
    cki("kat9_sc_12", sc9[1][2], 0)

    print("PASS _relation_components_test")

main()
