// KAT for std/net/ldap.nova — LDAP v3 (RFC 4511) protocol codec on top of
// std/encoding/asn1's BER/DER TLV layer.
//
// Covers: byte-exact BindRequest encode (RFC 4511 shape), BindResponse
// decode round-trip, exact APPLICATION/context tag bytes, UnbindRequest,
// and the mandatory edge-case checklist: binary 0x00 in DN/password,
// boundary int widths for messageID/resultCode, empty/missing fields,
// truncated buffer, over-long/lying length field, and never-exit-on-bad-input.

import std/net/ldap
import std/encoding/hex
import std/encoding/asn1

// check() returns 1 on failure / 0 on pass and the caller THREADS that
// return value into a local `fails` accumulator inside main() — NOT a
// module-level list mutated from inside the helper. A `let FAILS = [0]`
// captured-list counter mutated via FAILS[0] = FAILS[0] + 1 from inside a
// called function does NOT reliably propagate to the module-level binding
// in NOVA, which can print "ALL PASS" even with real FAIL lines above it.
// Return-value threading through a local variable is the sound pattern
// (see std/testing/proptest's check()).
fn check(name: string, cond: bool) -> int
    if cond
        print("PASS " + name)
        return 0
    print("FAIL " + name)
    return 1

fn bytes_from_hex(h: string) -> any
    return hex_decode(h)

fn main()
    let fails = 0
    // ── 1. byte-exact BindRequest, RFC 4511 shape ──────────────────────────
    // messageID=1, version=3, DN="cn=admin,dc=example,dc=com", simple pw "secret"
    // Expected wire bytes computed independently (outer SEQUENCE, len 0x2c=44;
    // messageID INTEGER 1; [APPLICATION 0] BindRequest len 0x27=39; version
    // INTEGER 3; name OCTET STRING len 0x1a=26 "cn=admin,dc=example,dc=com";
    // simple auth context-tag 0x80 len 6 "secret").
    let bindreq = ldap_encode_bind_request(1, 3, "cn=admin,dc=example,dc=com", "secret")
    let got_hex = hex_encode(bindreq)
    // Build the true expected vector directly from spec bytes (avoids any
    // string-literal transcription risk): assemble it byte-by-byte and
    // compare via hex_encode, which is the same function used to render
    // `got_hex` above -- so both sides go through identical formatting.
    let ev = bytes_create(46)
    let spec = [0x30,0x2c,0x02,0x01,0x01,0x60,0x27,0x02,0x01,0x03,0x04,0x1a,
        0x63,0x6e,0x3d,0x61,0x64,0x6d,0x69,0x6e,0x2c,0x64,0x63,0x3d,0x65,0x78,
        0x61,0x6d,0x70,0x6c,0x65,0x2c,0x64,0x63,0x3d,0x63,0x6f,0x6d,
        0x80,0x06,0x73,0x65,0x63,0x72,0x65,0x74]
    let i = 0
    while i < len(spec)
        bytes_set(ev, i, spec[i])
        i = i + 1
    let want = hex_encode(ev)
    fails = fails + check("bindreq_len_46", bytes_len(bindreq) == 46)
    fails = fails + check("bindreq_bytes_exact", got_hex == want)
    print("  got : " + got_hex)
    print("  want: " + want)

    // ── 2. exact tag bytes: outer message=0x30, [APPLICATION 0]=0x60, simple-auth=0x80
    fails = fails + check("outer_tag_0x30", bytes_get(bindreq, 0) == 0x30)
    fails = fails + check("app0_tag_0x60_exact", bytes_get(bindreq, 5) == 0x60)
    fails = fails + check("op_tag_peek_0x60", ldap_peek_op_tag(bindreq) == ldap_tag_bind_request())
    fails = fails + check("simple_auth_tag_0x80_exact", bytes_get(bindreq, 38) == 0x80)

    // ── 3. BindRequest decode round-trip ───────────────────────────────────
    let dr = ldap_decode_bind_request(bindreq)
    fails = fails + check("dr_ok", dr["ok"] == true)
    fails = fails + check("dr_msgid", dr["message_id"] == 1)
    fails = fails + check("dr_version", dr["version"] == 3)
    fails = fails + check("dr_dn", dr["dn"] == "cn=admin,dc=example,dc=com")
    fails = fails + check("dr_password", dr["password"] == "secret")
    fails = fails + check("dr_error_empty", dr["error"] == "")

    // ── 4. BindResponse encode + decode, resultCode 0 (success) ───────────
    let bindresp = ldap_encode_bind_response(1, ldap_result_success(), "", "")
    fails = fails + check("bindresp_app1_tag", ldap_peek_op_tag(bindresp) == ldap_tag_bind_response())
    let dresp = ldap_decode_bind_response(bindresp)
    fails = fails + check("dresp_ok", dresp["ok"] == true)
    fails = fails + check("dresp_msgid", dresp["message_id"] == 1)
    fails = fails + check("dresp_result_code_success", dresp["result_code"] == 0)
    fails = fails + check("dresp_matched_dn_empty", dresp["matched_dn"] == "")
    fails = fails + check("dresp_diag_empty", dresp["diagnostic_message"] == "")

    // BindResponse with non-empty matchedDN/diagnosticMessage and a
    // nonzero (multi-byte) result code -- exercises ENUMERATED >127.
    let bindresp2 = ldap_encode_bind_response(7, ldap_result_invalid_credentials(), "cn=admin,dc=example,dc=com", "invalid credentials")
    let dresp2 = ldap_decode_bind_response(bindresp2)
    fails = fails + check("dresp2_ok", dresp2["ok"] == true)
    fails = fails + check("dresp2_msgid", dresp2["message_id"] == 7)
    fails = fails + check("dresp2_result_code_49", dresp2["result_code"] == 49)
    fails = fails + check("dresp2_matched_dn", dresp2["matched_dn"] == "cn=admin,dc=example,dc=com")
    fails = fails + check("dresp2_diag", dresp2["diagnostic_message"] == "invalid credentials")

    // ── 5. UnbindRequest, [APPLICATION 2] NULL, tag 0x42 ───────────────────
    let unbind = ldap_encode_unbind_request(2)
    fails = fails + check("unbind_app2_tag_0x42", ldap_peek_op_tag(unbind) == 0x42)
    let dun = ldap_decode_unbind_request(unbind)
    fails = fails + check("dun_ok", dun["ok"] == true)
    fails = fails + check("dun_msgid", dun["message_id"] == 2)
    // spec: 30 05 02 01 02 42 00  (SEQUENCE len5, INTEGER 2, APPLICATION-2 NULL empty)
    fails = fails + check("unbind_bytes_exact", hex_encode(unbind) == "300502010242" + "00")

    // ── 6. EDGE CASE: binary 0x00 embedded in DN/password (bytes-safe path) ─
    let dn_bin = bytes_create(5)
    bytes_set(dn_bin, 0, 0x61)
    bytes_set(dn_bin, 1, 0x00)
    bytes_set(dn_bin, 2, 0x62)
    bytes_set(dn_bin, 3, 0x00)
    bytes_set(dn_bin, 4, 0x63)
    let pw_bin = bytes_create(3)
    bytes_set(pw_bin, 0, 0x00)
    bytes_set(pw_bin, 1, 0xFF)
    bytes_set(pw_bin, 2, 0x00)
    let breq_bin = ldap_encode_bind_request_bytes(9, 3, dn_bin, pw_bin)
    let dreq_bin = ldap_decode_bind_request(breq_bin)
    fails = fails + check("bin_dr_ok", dreq_bin["ok"] == true)
    fails = fails + check("bin_dn_bytes_len5", bytes_len(dreq_bin["dn_bytes"]) == 5)
    fails = fails + check("bin_dn_bytes_exact", hex_encode(dreq_bin["dn_bytes"]) == "6100620063")
    fails = fails + check("bin_pw_bytes_len3", bytes_len(dreq_bin["password_bytes"]) == 3)
    fails = fails + check("bin_pw_bytes_exact", hex_encode(dreq_bin["password_bytes"]) == "00ff00")
    // and the string view legitimately truncates at the first NUL (documented,
    // not a crash) -- confirms the _bytes fields are the source of truth.
    fails = fails + check("bin_dn_string_truncates_at_nul", dreq_bin["dn"] == "a")

    // ── 7. EDGE CASE: int width boundaries for messageID / resultCode ──────
    let ids_to_try = [0, 1, 127, 128, 255, 256, 32767, 32768, 2147483647, 4294967296]
    let idx = 0
    let ids_ok = true
    while idx < len(ids_to_try)
        let mid = ids_to_try[idx]
        let m = ldap_encode_unbind_request(mid)
        let dm = ldap_decode_unbind_request(m)
        if dm["ok"] != true
            ids_ok = false
        if dm["message_id"] != mid
            ids_ok = false
        idx = idx + 1
    fails = fails + check("messageid_width_boundaries", ids_ok)

    // ── 8. EDGE CASE: empty DN + empty password (still round-trips, no crash) ─
    let breq_empty = ldap_encode_bind_request(3, 3, "", "")
    let dreq_empty = ldap_decode_bind_request(breq_empty)
    fails = fails + check("empty_dn_pw_ok", dreq_empty["ok"] == true)
    fails = fails + check("empty_dn_is_empty", dreq_empty["dn"] == "")
    fails = fails + check("empty_pw_is_empty", dreq_empty["password"] == "")

    // ── 9. EDGE CASE: truncated buffer -- must reject in-band, never crash ──
    let truncated = bytes_slice(bindreq, 0, 10)
    let dtrunc = ldap_decode_bind_request(truncated)
    fails = fails + check("truncated_rejected", dtrunc["ok"] == false)
    fails = fails + check("truncated_has_error", dtrunc["error"] != "")

    let truncated_tiny = bytes_slice(bindreq, 0, 1)
    let dtiny = ldap_decode_bind_request(truncated_tiny)
    fails = fails + check("truncated_tiny_rejected", dtiny["ok"] == false)

    let empty_buf = bytes_create(0)
    let dempty = ldap_decode_bind_request(empty_buf)
    fails = fails + check("empty_buffer_rejected", dempty["ok"] == false)
    fails = fails + check("empty_buffer_peek_neg1", ldap_peek_op_tag(empty_buf) == -1)

    // ── 10. EDGE CASE: over-long / lying length field -- declares more
    // content than the buffer actually holds; must NOT over-read, must
    // reject in-band. Craft: SEQUENCE len=0x7F (127) but supply only 5
    // content bytes after the header.
    let lie = bytes_create(7)
    bytes_set(lie, 0, 0x30)
    bytes_set(lie, 1, 0x7F)
    bytes_set(lie, 2, 0x02)
    bytes_set(lie, 3, 0x01)
    bytes_set(lie, 4, 0x01)
    bytes_set(lie, 5, 0x60)
    bytes_set(lie, 6, 0x00)
    let dlie = ldap_decode_bind_request(lie)
    fails = fails + check("overlong_length_rejected", dlie["ok"] == false)
    fails = fails + check("overlong_length_peek_neg1", ldap_peek_op_tag(lie) == -1)

    // Craft: BER multi-byte long-form length that is itself well-formed but
    // whose declared value (0x02000000 = 33554432) vastly exceeds any
    // plausible buffer -- must reject cleanly, no OOB read, no crash.
    let lie2 = bytes_create(10)
    bytes_set(lie2, 0, 0x30)
    bytes_set(lie2, 1, 0x84)  // long form, 4 length bytes follow
    bytes_set(lie2, 2, 0x02)
    bytes_set(lie2, 3, 0x00)
    bytes_set(lie2, 4, 0x00)
    bytes_set(lie2, 5, 0x00)
    bytes_set(lie2, 6, 0x02)
    bytes_set(lie2, 7, 0x01)
    bytes_set(lie2, 8, 0x01)
    bytes_set(lie2, 9, 0x60)
    let dlie2 = ldap_decode_bind_request(lie2)
    fails = fails + check("overlong_longform_rejected", dlie2["ok"] == false)

    // Craft: BER indefinite length (0x80 alone) on the outer tag -- BER-only,
    // not valid for a length we can bound; asn1_decode_length already
    // rejects it (clen==-1) and _ldap_safe_tlv must propagate that as ok=false.
    let indef = bytes_create(4)
    bytes_set(indef, 0, 0x30)
    bytes_set(indef, 1, 0x80)
    bytes_set(indef, 2, 0x00)
    bytes_set(indef, 3, 0x00)
    let dindef = ldap_decode_bind_request(indef)
    fails = fails + check("indefinite_length_rejected", dindef["ok"] == false)

    // ── 11. EDGE CASE: unsupported auth choice (SASL [3] = 0xA3) rejected,
    // not silently misparsed as simple.
    let sasl_content_dn = asn1_encode_octet_string(bytes_from_hex(""))
    let version_tlv = asn1_encode_integer(3)
    let sasl_tlv = asn1_write_tlv(0xA3, bytes_create(2))
    let inner = bytes_concat(version_tlv, sasl_content_dn)
    inner = bytes_concat(inner, sasl_tlv)
    let bindreq_sasl_op = asn1_write_tlv(0x60, inner)
    let msgid_tlv = asn1_encode_integer(4)
    let msg_content = bytes_concat(msgid_tlv, bindreq_sasl_op)
    let sasl_msg = asn1_write_tlv(0x30, msg_content)
    let dsasl = ldap_decode_bind_request(sasl_msg)
    fails = fails + check("sasl_auth_rejected_not_crashed", dsasl["ok"] == false)
    fails = fails + check("sasl_auth_has_error", dsasl["error"] != "")

    // ── 12. EDGE CASE: wrong protocolOp tag (e.g. decode a BindResponse as
    // if it were a BindRequest) rejected cleanly.
    let wrong_op = ldap_decode_bind_request(bindresp)
    fails = fails + check("wrong_protocolop_rejected", wrong_op["ok"] == false)

    // ── 13. EDGE CASE: never exit(1) -- every malformed-input path above
    // returned normally (we are still executing here, after ~10 reject
    // cases); explicit sentinel check that the process is alive.
    fails = fails + check("still_alive_after_all_rejects", true)

    // ── 14. REGRESSION: per-field tag-confusion (BER/DER type confusion).
    // Before the fix, ONLY the two CHOICE points (protocolOp APPLICATION
    // tag, auth CHOICE tag) were tag-checked -- messageID, version, DN,
    // resultCode, matchedDN, diagnosticMessage were read via the generic
    // _ldap_safe_tlv with NO tag check, so a wrongly-tagged field decoded
    // ok=true. Each case below builds an otherwise well-formed message
    // with exactly ONE field mis-tagged (still syntactically valid
    // TLV -- correct length/content, wrong tag byte) and asserts ok=false.
    // Built compositionally from asn1's TLV primitives (not by poking a
    // magic byte offset into an already-encoded message), so these stay
    // correct even if unrelated field values/lengths change above.

    // 14a. messageID mis-tagged OCTET STRING (0x04) instead of INTEGER (0x02).
    let mid_wrong_tag = asn1_write_tlv(asn1_tag_octet_string(), bytes_from_hex("01"))
    let version_tlv2 = asn1_encode_integer(3)
    let dn_tlv2 = asn1_encode_octet_string(bytes_from_hex(""))
    let auth_tlv2 = asn1_write_tlv(ldap_tag_simple_auth(), bytes_from_hex(""))
    let op_content2 = bytes_concat(version_tlv2, dn_tlv2)
    op_content2 = bytes_concat(op_content2, auth_tlv2)
    let bindreq_op2 = asn1_write_tlv(ldap_tag_bind_request(), op_content2)
    let msg_content3 = bytes_concat(mid_wrong_tag, bindreq_op2)
    let mid_mistag_msg = asn1_write_tlv(asn1_tag_sequence(), msg_content3)
    let dmid = ldap_decode_bind_request(mid_mistag_msg)
    fails = fails + check("messageid_mistag_rejected", dmid["ok"] == false)
    fails = fails + check("messageid_mistag_has_error", dmid["error"] != "")

    // 14b. DN (name) mis-tagged INTEGER (0x02) instead of OCTET STRING (0x04).
    let midtlv3 = asn1_encode_integer(5)
    let version_tlv3 = asn1_encode_integer(3)
    let dn_wrong_tag = asn1_write_tlv(asn1_tag_integer(), bytes_from_hex("00"))
    let auth_tlv3 = asn1_write_tlv(ldap_tag_simple_auth(), bytes_from_hex(""))
    let op_content3 = bytes_concat(version_tlv3, dn_wrong_tag)
    op_content3 = bytes_concat(op_content3, auth_tlv3)
    let bindreq_op3 = asn1_write_tlv(ldap_tag_bind_request(), op_content3)
    let msg_content4 = bytes_concat(midtlv3, bindreq_op3)
    let dn_mistag_msg = asn1_write_tlv(asn1_tag_sequence(), msg_content4)
    let ddn = ldap_decode_bind_request(dn_mistag_msg)
    fails = fails + check("dn_mistag_rejected", ddn["ok"] == false)
    fails = fails + check("dn_mistag_has_error", ddn["error"] != "")

    // 14c. resultCode mis-tagged OCTET STRING (0x04) instead of ENUMERATED (0x0A).
    let resultcode_wrong_tag = asn1_write_tlv(asn1_tag_octet_string(), bytes_from_hex("00"))
    let matched_dn_tlv = asn1_encode_octet_string(bytes_from_hex(""))
    let diag_tlv = asn1_encode_octet_string(bytes_from_hex(""))
    let bindresp_content = bytes_concat(resultcode_wrong_tag, matched_dn_tlv)
    bindresp_content = bytes_concat(bindresp_content, diag_tlv)
    let bindresp_op = asn1_write_tlv(ldap_tag_bind_response(), bindresp_content)
    let msgid_tlv2 = asn1_encode_integer(8)
    let msg_content5 = bytes_concat(msgid_tlv2, bindresp_op)
    let resultcode_mistag_msg = asn1_write_tlv(asn1_tag_sequence(), msg_content5)
    let dresultcode = ldap_decode_bind_response(resultcode_mistag_msg)
    fails = fails + check("resultcode_mistag_rejected", dresultcode["ok"] == false)
    fails = fails + check("resultcode_mistag_has_error", dresultcode["error"] != "")

    // 14d. control: a message built the SAME compositional way, but with
    // every field CORRECTLY tagged, still decodes ok=true -- confirms the
    // new per-field tag checks reject only the mis-tagged case, not
    // legitimate messages built from the same primitives.
    let midtlv4 = asn1_encode_integer(6)
    let version_tlv4 = asn1_encode_integer(3)
    let dn_ok_tlv = asn1_encode_octet_string(bytes_from_hex(""))
    let auth_tlv4 = asn1_write_tlv(ldap_tag_simple_auth(), bytes_from_hex(""))
    let op_content4 = bytes_concat(version_tlv4, dn_ok_tlv)
    op_content4 = bytes_concat(op_content4, auth_tlv4)
    let bindreq_op4 = asn1_write_tlv(ldap_tag_bind_request(), op_content4)
    let msg_content6 = bytes_concat(midtlv4, bindreq_op4)
    let wellformed_msg = asn1_write_tlv(asn1_tag_sequence(), msg_content6)
    let dwf = ldap_decode_bind_request(wellformed_msg)
    fails = fails + check("wellformed_still_ok_true", dwf["ok"] == true)
    fails = fails + check("wellformed_still_ok_true_msgid", dwf["message_id"] == 6)

    if fails == 0
        print("ALL PASS")
    else
        print("FAILURES: " + str(fails))
