import forge_delayed_queue

fn main()
    let d = dq_new()
    d = dq_enqueue(d, "email-reminder", 100)
    d = dq_enqueue(d, "cleanup-job", 200)
    d = dq_enqueue(d, "report-gen", 150)
    assert(dq_pending_count(d) == 3, "3 pending")

    let r1 = dq_poll(d, 50)
    d = r1["d"]
    assert(r1["found"] == 0, "nothing due at 50")

    let r2 = dq_poll(d, 100)
    d = r2["d"]
    assert(r2["found"] == 1, "email due at 100")
    assert(r2["payload"] == "email-reminder", "email first")
    assert(dq_pending_count(d) == 2, "2 pending")

    let r3 = dq_poll(d, 160)
    d = r3["d"]
    assert(r3["found"] == 1, "report due at 160")
    assert(r3["payload"] == "report-gen", "report at 150")

    assert(dq_next_delivery_time(d) == 200, "next at 200")
    assert(dq_total_delivered(d) == 2, "2 delivered")

    let r4 = dq_poll(d, 300)
    d = r4["d"]
    assert(r4["found"] == 1, "cleanup due")
    assert(dq_pending_count(d) == 0, "all delivered")

    print("DELAYED-QUEUE KAT PASS")
