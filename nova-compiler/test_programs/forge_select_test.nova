import forge_select

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn near(a: float, b: float) -> bool
    let d = a - b
    d > -0.001 and d < 0.001

fn main()
    let fails = 0

    // [3,1,4,1,5,9,2,6] sorted = [1,1,2,3,4,5,6,9]
    let arr = [3, 1, 4, 1, 5, 9, 2, 6]
    fails = fails + expect("k0_min", str(kth_smallest(arr, 0)), "1")
    fails = fails + expect("k3", str(kth_smallest(arr, 3)), "3")
    fails = fails + expect("k7_max", str(kth_smallest(arr, 7)), "9")
    fails = fails + expect("k5", str(kth_smallest(arr, 5)), "5")
    // out of range
    fails = fails + expect("oor", str(kth_smallest(arr, 100)), "0")

    // kth_largest
    fails = fails + expect("largest0", str(kth_largest(arr, 0)), "9")
    fails = fails + expect("largest1", str(kth_largest(arr, 1)), "6")

    // input unchanged (works on a copy)
    kth_smallest(arr, 3)
    fails = fails + expect("unchanged", str(arr[0]) + str(arr[1]) + str(arr[2]), "314")

    // median odd
    fails = fails + expect_true("median_odd", near(median([3, 1, 2]), 2.0))
    fails = fails + expect_true("median_odd5", near(median([5, 2, 8, 1, 9]), 5.0))
    // median even
    fails = fails + expect_true("median_even", near(median([4, 1, 2, 3]), 2.5))
    fails = fails + expect_true("median_even2", near(median([10, 20, 30, 40]), 25.0))

    // single
    fails = fails + expect("single", str(kth_smallest([42], 0)), "42")
    // duplicates
    fails = fails + expect("dups", str(kth_smallest([5, 5, 5, 5], 2)), "5")
    // negative numbers
    fails = fails + expect("negatives", str(kth_smallest([0 - 3, 0 - 1, 0 - 2, 5], 0)), "-3")

    // exhaustive: kth_smallest matches a sorted array for all k
    let test = [7, 3, 9, 1, 5, 2, 8]
    // sorted: [1,2,3,5,7,8,9]
    let expected = [1, 2, 3, 5, 7, 8, 9]
    let allok = true
    let k = 0
    while k < 7
        if kth_smallest(test, k) != expected[k]
            allok = false
        k = k + 1
    fails = fails + expect_true("exhaustive", allok)

    if fails == 0
        print("forge_select: all passed")
    else
        print("forge_select: " + str(fails) + " FAILED")
