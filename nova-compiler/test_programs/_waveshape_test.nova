// KAT test for std/audio/waveshape.nova
// Hand-computed reference values:
//   hard_clip( 2.0, 1.0) =  1.0  (above threshold)
//   hard_clip(-2.0, 1.0) = -1.0  (below -threshold)
//   hard_clip( 0.5, 1.0) =  0.5  (within threshold)
//   hard_clip( 1.0, 1.0) =  1.0  (exactly at threshold)
//   soft_clip( 0.0) = 0.0
//   soft_clip( 1.0) = 0.5    (1/(1+1))
//   soft_clip(-1.0) = -0.5
//   soft_clip large positive -> bounded in (0, 1)
//   soft_clip is odd: soft_clip(-x) == -soft_clip(x)
//   fold( 0.5, 1.0) =  0.5   (within range, rising)
//   fold( 1.0, 1.0) =  1.0   (at peak)
//   fold( 2.0, 1.0) =  0.0   (folded back from 2.0)
//   fold( 1.5, 1.0) =  0.5   (folded: 2.0-1.5=0.5)
//   fold(-2.0, 1.0) =  0.0   (symmetric with fold(2.0))
//   fold( 3.0, 1.0) = -1.0   (3L->-L in fall: 2L-3L=-L)
//   fold( 3.5, 1.0) = -0.5   (rising back: 3.5-4.0=-0.5)
//   fold( 4.0, 1.0) =  0.0   (back to start of period)

import std/audio/waveshape

fn approx(a: float, b: float, tol: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    let result = d < tol
    result

fn ckf(label: string, got: float, want: float, tol: float)
    if approx(got, want, tol) != true
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── hard_clip ─────────────────────────────────────────────────────────────
    // KAT 1: above threshold -> clamp to threshold
    let h1 = hard_clip(2.0, 1.0)
    ckf("hard_clip_above", h1, 1.0, 0.0001)

    // KAT 2: below -threshold -> clamp to -threshold
    let h2 = hard_clip(0.0 - 2.0, 1.0)
    ckf("hard_clip_below", h2, 0.0 - 1.0, 0.0001)

    // KAT 3: within range -> pass through unchanged
    let h3 = hard_clip(0.5, 1.0)
    ckf("hard_clip_within", h3, 0.5, 0.0001)

    // KAT 4: exactly at threshold -> equal to threshold
    let h4 = hard_clip(1.0, 1.0)
    ckf("hard_clip_exact", h4, 1.0, 0.0001)

    // KAT 5: negative within range
    let h5 = hard_clip(0.0 - 0.5, 1.0)
    ckf("hard_clip_neg_within", h5, 0.0 - 0.5, 0.0001)

    // KAT 6: zero input -> zero output
    let h6 = hard_clip(0.0, 1.0)
    ckf("hard_clip_zero", h6, 0.0, 0.0001)

    // ── soft_clip ─────────────────────────────────────────────────────────────
    // KAT 7: soft_clip(0.0) = 0.0
    let s0 = soft_clip(0.0)
    ckf("soft_clip_zero", s0, 0.0, 0.0001)

    // KAT 8: soft_clip(1.0) = 0.5 (1/(1+1))
    let s1 = soft_clip(1.0)
    ckf("soft_clip_one", s1, 0.5, 0.0001)

    // KAT 9: soft_clip(-1.0) = -0.5
    let sn1 = soft_clip(0.0 - 1.0)
    ckf("soft_clip_neg_one", sn1, 0.0 - 0.5, 0.0001)

    // KAT 10: soft_clip is odd: soft_clip(-x) == -soft_clip(x)
    let s2 = soft_clip(2.0)
    let sn2 = soft_clip(0.0 - 2.0)
    let sum = s2 + sn2
    ckf("soft_clip_odd", sum, 0.0, 0.0001)

    // KAT 11: soft_clip output is bounded < 1.0 for large positive input
    let s_large = soft_clip(1000.0)
    if s_large >= 1.0
        print("FAIL soft_clip_bound: got=" + str(s_large) + " want < 1.0")
        exit(1)

    // KAT 12: soft_clip output is > -1.0 for large negative input
    let s_large_neg = soft_clip(0.0 - 1000.0)
    if s_large_neg <= (0.0 - 1.0)
        print("FAIL soft_clip_neg_bound: got=" + str(s_large_neg) + " want > -1.0")
        exit(1)

    // KAT 13: soft_clip is monotone: soft_clip(0.5) > soft_clip(0.25)
    let sm05 = soft_clip(0.5)
    let sm25 = soft_clip(0.25)
    if sm05 < sm25
        print("FAIL soft_clip_monotone: 0.5->" + str(sm05) + " < 0.25->" + str(sm25))
        exit(1)

    // KAT 14: soft_clip(x) magnitude < 1.0 for x != inf
    let s3 = soft_clip(3.0)
    let s3_abs = s3
    if s3 < 0.0
        s3_abs = 0.0 - s3
    if s3_abs >= 1.0
        print("FAIL soft_clip_mag: got=" + str(s3) + " want < 1.0")
        exit(1)

    // ── fold ──────────────────────────────────────────────────────────────────
    // KAT 15: fold(0.5, 1.0) = 0.5 (within range, rising seg)
    let f1 = fold(0.5, 1.0)
    ckf("fold_within", f1, 0.5, 0.0001)

    // KAT 16: fold(1.0, 1.0) = 1.0 (exactly at limit/peak)
    let f2 = fold(1.0, 1.0)
    ckf("fold_at_limit", f2, 1.0, 0.0001)

    // KAT 17: fold(2.0, 1.0) = 0.0 (2L-2L=0)
    let f3 = fold(2.0, 1.0)
    ckf("fold_double", f3, 0.0, 0.0001)

    // KAT 18: fold(1.5, 1.0) = 0.5 (falling seg: 2.0-1.5=0.5)
    let f4 = fold(1.5, 1.0)
    ckf("fold_one_half", f4, 0.5, 0.0001)

    // KAT 19: fold(3.0, 1.0) = -1.0 (at trough: 2.0-3.0=-1.0)
    let f5 = fold(3.0, 1.0)
    ckf("fold_trough", f5, 0.0 - 1.0, 0.0001)

    // KAT 20: fold(3.5, 1.0) = -0.5 (rising back: 3.5-4.0=-0.5)
    let f6 = fold(3.5, 1.0)
    ckf("fold_rise_back", f6, 0.0 - 0.5, 0.0001)

    // KAT 21: fold(4.0, 1.0) = 0.0 (period complete, back to start)
    let f7 = fold(4.0, 1.0)
    ckf("fold_period", f7, 0.0, 0.0001)

    // KAT 22: fold(-1.5, 1.0) = -0.5 (symmetric: -1.5 = -(1.5), fold(1.5)=0.5, so fold(-1.5)=-0.5)
    // Actually: normalize(-1.5, 4.0): neg_s=1.5, add 4.0 -> s=2.5
    // s=2.5 in [1,3]: 2.0-2.5=-0.5
    let f8 = fold(0.0 - 1.5, 1.0)
    ckf("fold_neg", f8, 0.0 - 0.5, 0.0001)

    // KAT 23: fold result is always in [-limit, limit]
    let f9a = fold(7.3, 1.0)
    let f9a_abs = f9a
    if f9a < 0.0
        f9a_abs = 0.0 - f9a
    if f9a_abs > 1.0
        print("FAIL fold_bounded: got=" + str(f9a) + " exceeds limit 1.0")
        exit(1)

    print("PASS _waveshape_test")
