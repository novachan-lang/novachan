import forge_bimatch

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

// verify a matching is valid: each right matched to <=1 left, and each matched pair is an allowed edge
fn valid(edges: list, match_right: list) -> int
    let ok = 1
    let v = 0
    while v < len(match_right)
        let u = match_right[v]
        if u != 0 - 1
            // check [u,v] is an edge
            let found = 0
            let e = 0
            while e < len(edges)
                if edges[e][0] == u and edges[e][1] == v
                    found = 1
                e = e + 1
            if found == 0
                ok = 0
        v = v + 1
    ok

fn main()
    let fails = 0

    // perfect diagonal matching 3x3
    let e1 = []
    push(e1, [0, 0])
    push(e1, [1, 1])
    push(e1, [2, 2])
    fails = fails + expect("perfect3", str(matching_size(3, 3, e1)), "3")

    // classic: 0-{0,1}, 1-0, 2-2 -> max 3 (0->1,1->0,2->2)
    let e2 = []
    push(e2, [0, 0])
    push(e2, [0, 1])
    push(e2, [1, 0])
    push(e2, [2, 2])
    let r2 = max_bipartite_matching(3, 3, e2)
    fails = fails + expect("classic3", str(r2[0]), "3")
    fails = fails + expect("classic3_valid", str(valid(e2, r2[1])), "1")

    // all left want only right 0 -> max 1
    let e3 = []
    push(e3, [0, 0])
    push(e3, [1, 0])
    push(e3, [2, 0])
    fails = fails + expect("contended", str(matching_size(3, 3, e3)), "1")

    // Hall violation 2 lefts, 1 shared right -> 1
    let e4 = []
    push(e4, [0, 0])
    push(e4, [1, 0])
    fails = fails + expect("hall", str(matching_size(2, 2, e4)), "1")

    // bigger: 4x4 with a non-trivial max matching of 4
    let e5 = []
    push(e5, [0, 0])
    push(e5, [0, 1])
    push(e5, [1, 0])
    push(e5, [1, 2])
    push(e5, [2, 1])
    push(e5, [2, 3])
    push(e5, [3, 2])
    push(e5, [3, 3])
    let r5 = max_bipartite_matching(4, 4, e5)
    fails = fails + expect("big4", str(r5[0]), "4")
    fails = fails + expect("big4_valid", str(valid(e5, r5[1])), "1")

    // no edges -> 0
    fails = fails + expect("empty", str(matching_size(3, 3, [])), "0")

    // asymmetric sizes 2 left x 3 right, max 2
    let e6 = []
    push(e6, [0, 1])
    push(e6, [0, 2])
    push(e6, [1, 1])
    fails = fails + expect("asym", str(matching_size(2, 3, e6)), "2")

    if fails == 0
        print("forge_bimatch: all passed")
    else
        print("forge_bimatch: " + str(fails) + " FAILED")
