fn _worker_loop(id, jobs, results)
  while 1
    let job = receive(jobs)
    if job < 0
      return 0
    send(results, [id, job, job * job])

fn worker_pool(num_workers, jobs_list)
  let jobs = channel()
  let results = channel()
  let i = 0
  while i < num_workers
    let _w = spawn _worker_loop(i, jobs, results)
    i = i + 1
  for job in jobs_list
    send(jobs, job)
  let output = []
  let ri = 0
  while ri < len(jobs_list)
    push(output, receive(results))
    ri = ri + 1
  let si = 0
  while si < num_workers
    send(jobs, -1)
    si = si + 1
  output

fn main()
  let jobs = [2, 3, 5, 7, 11]
  let results = worker_pool(2, jobs)
  assert(len(results) == 5, "5 results")

  let total = 0
  for r in results
    total = total + r[2]
  assert(total == 4 + 9 + 25 + 49 + 121, "sum of squares = 208")

  print("workerx: all passed")
