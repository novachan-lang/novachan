// KAT test for std/automata/mealy
import std/automata/mealy

// ── KAT 1: 1-bit inverter ──────────────────────────────────────────────────
// Single state "q". On "0" emit "1"; on "1" emit "0". Self-loop on both.
let inv = mly_new("q")
mly_add(inv, "q", "0", "1", "q")
mly_add(inv, "q", "1", "0", "q")

let r1 = mly_run(inv, "0110")
if r1 != "1001"
    print("FAIL KAT1: inverter got " + r1)
    exit(1)

// ── KAT 2: constant-x machine (any letter -> "x") ─────────────────────────
let xm = mly_new("q")
mly_add(xm, "q", "a", "x", "q")
mly_add(xm, "q", "b", "x", "q")
mly_add(xm, "q", "c", "x", "q")

let r2 = mly_run(xm, "aaa")
if r2 != "xxx"
    print("FAIL KAT2: constant-x got " + r2)
    exit(1)

// ── KAT 3: empty input -> "" ───────────────────────────────────────────────
let r3 = mly_run(xm, "")
if r3 != ""
    print("FAIL KAT3: empty input got " + r3)
    exit(1)

// ── KAT 4: edge detector ──────────────────────────────────────────────────
// Two states: "s0" (last seen was 0) and "s1" (last seen was 1).
// Start in "s0". Output "0" when input matches remembered bit, "1" on change.
// Input "0011":
//   s0 reads '0' -> same -> emit "0", stay s0
//   s0 reads '0' -> same -> emit "0", stay s0
//   s0 reads '1' -> diff -> emit "1", go s1
//   s1 reads '1' -> same -> emit "0", stay s1
// Expected output: "0010"
let ed = mly_new("s0")
mly_add(ed, "s0", "0", "0", "s0")
mly_add(ed, "s0", "1", "1", "s1")
mly_add(ed, "s1", "0", "1", "s0")
mly_add(ed, "s1", "1", "0", "s1")

let r4 = mly_run(ed, "0011")
if r4 != "0010"
    print("FAIL KAT4: edge detector got " + r4)
    exit(1)

// ── KAT 5: stuck transition returns "" ────────────────────────────────────
// Machine only handles 'a'; feeding 'b' causes a missing transition -> stuck.
let sm = mly_new("q")
mly_add(sm, "q", "a", "X", "q")
// no transition for 'b'

let r5 = mly_run(sm, "ab")
if r5 != ""
    print("FAIL KAT5: stuck expected empty, got " + r5)
    exit(1)

// ── KAT 6: multi-char output per transition ────────────────────────────────
// Each '0' emits "ab" and each '1' emits "cd". Input "010" -> "abcdab"
let mc = mly_new("q")
mly_add(mc, "q", "0", "ab", "q")
mly_add(mc, "q", "1", "cd", "q")

let r6 = mly_run(mc, "010")
if r6 != "abcdab"
    print("FAIL KAT6: multi-char output got " + r6)
    exit(1)

print("_mealy_test passed")
