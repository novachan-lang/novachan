// Exact off-by-one boundary probe for CoAP option delta/length nibble math:
// 12/13 (direct -> nibble13 threshold) and 268/269 (nibble13 -> nibble14 threshold).
import std/net/coap

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    let n = len(want)
    if bytes_len(got) != n
        print("FAIL " + label + " len: got=" + str(bytes_len(got)) + " want=" + str(n))
        exit(1)
    let i = 0
    while i < n
        if bytes_get(got, i) != want[i]
            print("FAIL " + label + " byte[" + str(i) + "]: got=" + str(bytes_get(got, i)) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn mkval(n)
    let out = []
    let i = 0
    while i < n
        push(out, 0x41)
        i = i + 1
    out

fn main()
    // delta boundary 12 -> direct nibble (no extension)
    let e12 = coap_encode(1, 0, 0x01, 1, [], [[12, []]], bytes(0))
    ckb("delta12_wire", e12["bytes"], [0x40, 0x01, 0x00, 0x01, 0xC0])
    let d12 = coap_decode(e12["bytes"])
    cki("delta12_num", d12["options"][0][0], 12)

    // delta boundary 13 -> nibble13, ext=0
    let e13 = coap_encode(1, 0, 0x01, 1, [], [[13, []]], bytes(0))
    ckb("delta13_wire", e13["bytes"], [0x40, 0x01, 0x00, 0x01, 0xD0, 0x00])
    let d13 = coap_decode(e13["bytes"])
    cki("delta13_num", d13["options"][0][0], 13)

    // delta boundary 268 -> nibble13, ext=255 (max byte)
    let e268 = coap_encode(1, 0, 0x01, 1, [], [[268, []]], bytes(0))
    ckb("delta268_wire", e268["bytes"], [0x40, 0x01, 0x00, 0x01, 0xD0, 0xFF])
    let d268 = coap_decode(e268["bytes"])
    cki("delta268_num", d268["options"][0][0], 268)

    // delta boundary 269 -> nibble14, ext=0x0000
    let e269 = coap_encode(1, 0, 0x01, 1, [], [[269, []]], bytes(0))
    ckb("delta269_wire", e269["bytes"], [0x40, 0x01, 0x00, 0x01, 0xE0, 0x00, 0x00])
    let d269 = coap_decode(e269["bytes"])
    cki("delta269_num", d269["options"][0][0], 269)

    // length boundary 12 -> direct nibble
    let el12 = coap_encode(1, 0, 0x01, 1, [], [[1, mkval(12)]], bytes(0))
    ckb("len12_hdr", bytes_slice(el12["bytes"], 4, 5), [0x1C])
    let dl12 = coap_decode(el12["bytes"])
    cki("len12_vlen", len(dl12["options"][0][1]), 12)

    // length boundary 13 -> nibble13, ext=0
    let el13 = coap_encode(1, 0, 0x01, 1, [], [[1, mkval(13)]], bytes(0))
    ckb("len13_hdr", bytes_slice(el13["bytes"], 4, 6), [0x1D, 0x00])
    let dl13 = coap_decode(el13["bytes"])
    cki("len13_vlen", len(dl13["options"][0][1]), 13)

    // length boundary 268 -> nibble13, ext=255
    let el268 = coap_encode(1, 0, 0x01, 1, [], [[1, mkval(268)]], bytes(0))
    ckb("len268_hdr", bytes_slice(el268["bytes"], 4, 6), [0x1D, 0xFF])
    let dl268 = coap_decode(el268["bytes"])
    cki("len268_vlen", len(dl268["options"][0][1]), 268)

    // length boundary 269 -> nibble14, ext=0x0000
    let el269 = coap_encode(1, 0, 0x01, 1, [], [[1, mkval(269)]], bytes(0))
    ckb("len269_hdr", bytes_slice(el269["bytes"], 4, 7), [0x1E, 0x00, 0x00])
    let dl269 = coap_decode(el269["bytes"])
    cki("len269_vlen", len(dl269["options"][0][1]), 269)

    print("PASS _coap_adv_boundary")
