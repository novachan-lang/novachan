import forge_request_coalesce

fn main()
    let rc = rc_new()
    let r1 = rc_request(rc, "user:42")
    assert(r1["coalesced"] == 0, "first not coalesced")
    assert(r1["waiters"] == 1, "1 waiter")

    let r2 = rc_request(rc, "user:42")
    assert(r2["coalesced"] == 1, "second coalesced")
    assert(r2["waiters"] == 2, "2 waiters")

    let r3 = rc_request(rc, "user:42")
    assert(r3["waiters"] == 3, "3 waiters")
    assert(rc_total_coalesced(rc) == 2, "2 coalesced")
    assert(rc_pending_count(rc) == 1, "1 pending key")
    assert(rc_waiters_for(rc, "user:42") == 3, "3 waiting")

    let r4 = rc_request(rc, "order:99")
    assert(r4["coalesced"] == 0, "different key not coalesced")
    assert(rc_pending_count(rc) == 2, "2 pending keys")

    let served = rc_complete(rc, "user:42")
    assert(served == 3, "served 3 waiters")
    assert(rc_total_served(rc) == 3, "3 total served")
    assert(rc_pending_count(rc) == 1, "1 pending after complete")
    assert(rc_waiters_for(rc, "user:42") == 0, "0 waiters after complete")

    let none = rc_complete(rc, "nonexistent")
    assert(none == 0, "no waiters for missing")

    print("REQUEST-COALESCE KAT PASS")
