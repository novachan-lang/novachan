fn main()
    let text = "hello world"
    let up = text.upper()
    assert_eq(up, "HELLO WORLD")

    let lo = "NOVA".lower()
    assert_eq(lo, "nova")

    let words = text.split(" ")
    assert_eq(words, ["hello", "world"])

    let n = text.len()
    assert_eq(n, 11)

    let items = [3, 1, 2]
    items.push(4)
    assert_eq(len(items), 4)

    let joined = ["a", "b", "c"].join("-")
    assert_eq(joined, "a-b-c")

    let trimmed = "  hi  ".trim()
    assert_eq(trimmed, "hi")

    let replaced = text.replace("world", "NOVA")
    assert_eq(replaced, "hello NOVA")

    print("ufcs_probe: all passed")
