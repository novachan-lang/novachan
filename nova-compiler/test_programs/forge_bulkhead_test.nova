// functional: bulkhead concurrency cap acquire/release
import forge_bulkhead

fn main()
    let b = bulkhead_new(2)
    if bulkhead_try_acquire(b) != 1
        print("FAIL acq1")
        exit(1)
    if bulkhead_try_acquire(b) != 1
        print("FAIL acq2")
        exit(1)
    if bulkhead_try_acquire(b) != 0
        print("FAIL acq3 should be denied")
        exit(1)
    bulkhead_release(b)
    if bulkhead_try_acquire(b) != 1
        print("FAIL acq after release")
        exit(1)
    bulkhead_stop(b)
    print("PASS forge_bulkhead")
