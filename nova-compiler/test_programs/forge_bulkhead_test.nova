// functional: bulkhead concurrency cap acquire/release using the real forge_bulkhead API
// (bulkhead_try / bulkhead_release / bulkhead_active / bulkhead_available).
import forge_bulkhead

fn main()
    let b = bulkhead_new(2)
    // first two permits succeed
    if bulkhead_try(b) == false
        print("FAIL acq1")
        exit(1)
    if bulkhead_try(b) == false
        print("FAIL acq2")
        exit(1)
    // at capacity (active=2, max=2) -> deny
    if bulkhead_try(b)
        print("FAIL acq3 should be denied")
        exit(1)
    if bulkhead_active(b) != 2
        print("FAIL active != 2")
        exit(1)
    if bulkhead_available(b) != 0
        print("FAIL available != 0")
        exit(1)
    // release one -> a permit frees up
    bulkhead_release(b)
    if bulkhead_available(b) != 1
        print("FAIL available != 1 after release")
        exit(1)
    if bulkhead_try(b) == false
        print("FAIL acq after release")
        exit(1)
    // release never underflows below 0
    bulkhead_release(b)
    bulkhead_release(b)
    bulkhead_release(b)
    if bulkhead_active(b) != 0
        print("FAIL active clamp at 0")
        exit(1)
    print("PASS forge_bulkhead")
