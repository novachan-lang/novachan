// functional: bulkhead concurrency cap acquire/release against the REAL forge_bulkhead API.
// This test previously called bulkhead_new/bulkhead_try/bulkhead_release/bulkhead_active/
// bulkhead_available -- none of which exist. The module exports bh_* and returns a Result
// from acquire/release rather than a bool, so the test never compiled. Rewritten against
// the shipped API instead of adding alias wrappers just to satisfy a stale test.
import forge_bulkhead

fn main()
    let b = bh_new(2)
    // first two permits succeed
    if is_err(bh_acquire(b))
        print("FAIL acq1")
        exit(1)
    if is_err(bh_acquire(b))
        print("FAIL acq2")
        exit(1)
    // at capacity (active=2, max=2) -> deny
    if is_ok(bh_acquire(b))
        print("FAIL acq3 should be denied")
        exit(1)
    if bh_active(b) != 2
        print("FAIL active != 2")
        exit(1)
    if bh_available(b) != 0
        print("FAIL available != 0")
        exit(1)
    // release one -> a permit frees up
    _ = bh_release(b)
    if bh_available(b) != 1
        print("FAIL available != 1 after release")
        exit(1)
    if is_err(bh_acquire(b))
        print("FAIL acq after release")
        exit(1)
    // release must not underflow past 0: two real releases drain it, and a third is
    // rejected as err rather than driving active negative.
    _ = bh_release(b)
    _ = bh_release(b)
    if is_ok(bh_release(b))
        print("FAIL release below 0 should be err")
        exit(1)
    if bh_active(b) != 0
        print("FAIL active clamp at 0")
        exit(1)
    // accounting: 3 accepted acquires, 1 denied
    if bh_total_accepted(b) != 3
        print("FAIL total_accepted != 3 got=" + str(bh_total_accepted(b)))
        exit(1)
    if bh_total_rejected(b) != 1
        print("FAIL total_rejected != 1 got=" + str(bh_total_rejected(b)))
        exit(1)
    if bh_peak(b) != 2
        print("FAIL peak != 2 got=" + str(bh_peak(b)))
        exit(1)
    print("PASS forge_bulkhead")
