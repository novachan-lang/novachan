import forge_maxflow

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // simple chain: s->a(3), a->t(2) -> bottleneck 2
    fails = fails + expect("chain", str(max_flow([["s", "a", 3], ["a", "t", 2]], "s", "t")), "2")

    // two parallel paths: s->a(1),a->t(1),s->b(1),b->t(1) -> 2
    let two = [["s", "a", 1], ["a", "t", 1], ["s", "b", 1], ["b", "t", 1]]
    fails = fails + expect("parallel", str(max_flow(two, "s", "t")), "2")

    // diamond: s->a(3),s->b(2),a->t(2),b->t(3) -> a-path 2, b-path 2 -> 4
    let diamond = [["s", "a", 3], ["s", "b", 2], ["a", "t", 2], ["b", "t", 3]]
    fails = fails + expect("diamond", str(max_flow(diamond, "s", "t")), "4")

    // classic CLRS-style network -> known max flow 23
    // s->v1(16), s->v2(13), v1->v2(10), v2->v1(4), v1->v3(12), v3->v2(9),
    // v2->v4(14), v4->v3(7), v3->t(20), v4->t(4)
    let clrs = [["s", "v1", 16], ["s", "v2", 13], ["v1", "v2", 10], ["v2", "v1", 4], ["v1", "v3", 12], ["v3", "v2", 9], ["v2", "v4", 14], ["v4", "v3", 7], ["v3", "t", 20], ["v4", "t", 4]]
    fails = fails + expect("clrs_23", str(max_flow(clrs, "s", "t")), "23")

    // bottleneck in the middle: s->a(10), a->b(1), b->t(10) -> 1
    fails = fails + expect("mid_bottleneck", str(max_flow([["s", "a", 10], ["a", "b", 1], ["b", "t", 10]], "s", "t")), "1")

    // no path from s to t -> 0
    fails = fails + expect("no_path", str(max_flow([["s", "a", 5], ["b", "t", 5]], "s", "t")), "0")

    // multiple edges merge capacity: s->a(3), s->a(2), a->t(10) -> 5
    fails = fails + expect("parallel_edges", str(max_flow([["s", "a", 3], ["s", "a", 2], ["a", "t", 10]], "s", "t")), "5")

    // bipartite matching via flow: source->L, L->R (cap 1), R->sink; 3 workers 3 jobs, perfect matching -> 3
    let matchnet = [["src", "w1", 1], ["src", "w2", 1], ["src", "w3", 1], ["w1", "j1", 1], ["w2", "j1", 1], ["w2", "j2", 1], ["w3", "j3", 1], ["j1", "snk", 1], ["j2", "snk", 1], ["j3", "snk", 1]]
    fails = fails + expect("bipartite_match", str(max_flow(matchnet, "src", "snk")), "3")

    if fails == 0
        print("forge_maxflow: all passed")
    else
        print("forge_maxflow: " + str(fails) + " FAILED")
