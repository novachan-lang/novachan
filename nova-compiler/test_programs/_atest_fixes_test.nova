// @test collection correctness: (1) a fn with a DUPLICATE @test annotation is counted ONCE; (2) a fn that
// combines @test with an `ensures` clause is counted ONCE (the compiler-generated __ens_impl is NOT
// collected as a phantom second test, and its body runs once). Before the fix, (1) double-counted and (2)
// counted the impl+wrapper as two tests (body executed twice).
@test
@test
fn t_dup() -> bool
    true

@test
fn t_ens() -> bool ensures result == true
    true

@test
fn t_pass() -> bool
    true

@test
fn t_fail() -> bool
    false

fn main()
    // 4 DISTINCT tests: t_dup, t_ens, t_pass, t_fail. Three pass -> generated runner returns 3.
    let n = __nova_run_tests()
    if n != 3
        print("FAIL __nova_run_tests returned " + str(n) + " (expected 3)")
        exit(1)
    print("PASS _atest_fixes_test")
