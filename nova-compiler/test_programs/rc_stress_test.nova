fn test_loop_temps()
    // Creates and discards 1000 list temps in a loop
    total = 0
    for i in 0..999
        total = total + len([i, i+1, i+2])
    print(total)

fn test_nested_chains()
    // Deep chain: reverse(reverse(reverse([1,2,3])))
    result = len(reverse(reverse(reverse([5, 4, 3, 2, 1]))))
    print(result)

fn test_string_loop()
    // Creates and discards string temps in a loop
    count = 0
    for i in 0..99
        n = len(upper("hello") + lower("WORLD"))
        count = count + n
    print(count)

fn test_unused_temps()
    // Heap temps that are never used at all
    [1, 2, 3]
    upper("hello")
    reverse([10, 20])
    print("unused_ok")

fn test_mixed_types()
    // List temp to len, string temp to len, interleaved
    a = len([1, 2, 3, 4, 5])
    b = len(upper("hi") + lower("BYE"))
    c = len(reverse([10, 20, 30]))
    print(a + b + c)

fn test_reassignment()
    // Variable reassigned multiple times with heap values
    x = [1, 2, 3]
    x = [4, 5, 6, 7]
    x = [8, 9]
    print(len(x))

test_loop_temps()
test_nested_chains()
test_string_loop()
test_unused_temps()
test_mixed_types()
test_reassignment()
print("all_rc_stress_ok")
