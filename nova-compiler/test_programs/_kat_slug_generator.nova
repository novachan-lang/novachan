import forge_slug_generator

fn main()
    let s1 = slug_generate("Hello World")
    assert(s1 == "hello-world", "hello-world")

    let s2 = slug_generate("My  Blog Post!")
    assert(s2 == "my-blog-post", "multi-space collapsed")

    let s3 = slug_generate("Test 123")
    assert(s3 == "test-123", "numbers preserved")

    assert(slug_is_valid("hello-world") == 1, "valid slug")
    assert(slug_is_valid("Hello World") == 0, "invalid: spaces+caps")
    assert(slug_is_valid("") == 0, "invalid: empty")

    let long = slug_generate("This Is A Very Long Title For Testing")
    let short = slug_truncate(long, 10)
    assert(len(short) <= 10, "truncated to 10")
    assert(slug_is_valid(short) == 1, "truncated is valid")

    print("SLUG-GENERATOR KAT PASS")
