fn _byte_hex(b)
  let hi = (b >> 4) & 15
  let lo = b & 15
  slice("0123456789abcdef", hi, hi + 1) + slice("0123456789abcdef", lo, lo + 1)

fn hexdump(data)
  let bytes = str_to_bytes(data)
  let n = bytes_len(bytes)
  let lines = []
  let offset = 0
  while offset < n
    let hex_part = ""
    let ascii_part = ""
    let col = 0
    while col < 16 and offset + col < n
      let b = bytes_get(bytes, offset + col)
      hex_part = hex_part + _byte_hex(b)
      if col < 15
        hex_part = hex_part + " "
      if b >= 32 and b < 127
        ascii_part = ascii_part + from_codepoint(b)
      else
        ascii_part = ascii_part + "."
      col = col + 1
    while col < 16
      hex_part = hex_part + "   "
      col = col + 1
    let off_str = _byte_hex((offset >> 8) & 255) + _byte_hex(offset & 255)
    push(lines, off_str + "  " + hex_part + "  " + ascii_part)
    offset = offset + 16
  join(lines, "\n")

fn to_hex_string(data)
  let bytes = str_to_bytes(data)
  let n = bytes_len(bytes)
  let out = ""
  let i = 0
  while i < n
    out = out + _byte_hex(bytes_get(bytes, i))
    i = i + 1
  out

fn from_hex_string(hex)
  let out = ""
  let i = 0
  while i < len(hex) - 1
    let hi_ch = lower(slice(hex, i, i + 1))
    let lo_ch = lower(slice(hex, i + 1, i + 2))
    let hi = 0
    let lo = 0
    let j = 0
    while j < 16
      if slice("0123456789abcdef", j, j + 1) == hi_ch
        hi = j
      if slice("0123456789abcdef", j, j + 1) == lo_ch
        lo = j
      j = j + 1
    out = out + from_codepoint(hi * 16 + lo)
    i = i + 2
  out

fn main()
  assert(_byte_hex(0) == "00", "hex 0")
  assert(_byte_hex(255) == "ff", "hex 255")
  assert(_byte_hex(171) == "ab", "hex 171")

  assert(to_hex_string("Hi") == "4869", "hex encode Hi")
  assert(from_hex_string("4869") == "Hi", "hex decode Hi")
  assert(from_hex_string(to_hex_string("NOVA")) == "NOVA", "round-trip")

  let dump = hexdump("Hello, World!")
  assert(contains(dump, "48 65 6c"), "dump hex bytes")
  assert(contains(dump, "Hello, World!"), "dump ascii")
  assert(starts_with(dump, "0000"), "dump offset")

  print("hexdumpx: all passed")
