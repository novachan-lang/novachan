// KAT test for std/graph/kruskal — Kruskal MST via union-find.
// Hand-computed expected values verified against the algorithm trace.
import std/graph/kruskal

fn cki(name: string, got: int, want: int)
    if got != want
        print("FAIL " + name + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("ok " + name)

fn cks(name: string, got: string, want: string)
    if got != want
        print("FAIL " + name + ": got '" + got + "' want '" + want + "'")
        exit(1)
    print("ok " + name)

fn ckb(name: string, got: bool, want: bool)
    let goti = 0
    if got
        goti = 1
    let wanti = 0
    if want
        wanti = 1
    if goti != wanti
        print("FAIL " + name + ": got " + str(goti) + " want " + str(wanti))
        exit(1)
    print("ok " + name)

fn main()
    // ----------------------------------------------------------------
    // Example graph: 4 nodes, 5 edges
    //   A-B:1, B-C:2, A-C:2, C-D:3, B-D:4
    // MST (by Kruskal): A-B:1, B-C:2, C-D:3  total=6
    // ----------------------------------------------------------------
    let e = [["A","B",1],["B","C",2],["A","C",2],["C","D",3],["B","D",4]]
    let n = ["A","B","C","D"]

    // KAT 1: total MST weight == 6
    cki("kr_mst_weight 4-node", kr_mst_weight(e, n), 6)

    // KAT 2: MST has exactly 3 edges (n-1 for 4 nodes)
    let mst = kr_mst(e, n)
    cki("kr_mst len 4-node", len(mst), 3)

    // KAT 3: first MST edge is A-B with weight 1 (sorted by weight)
    let e0 = mst[0]
    cks("kr_mst[0] u", e0[0], "A")
    cks("kr_mst[0] v", e0[1], "B")
    cki("kr_mst[0] w", e0[2], 1)

    // KAT 4: graph is connected
    ckb("kr_is_connected 4-node", kr_is_connected(e, n), true)

    // ----------------------------------------------------------------
    // Two-node connected graph
    //   A-B:5
    // ----------------------------------------------------------------
    let e2 = [["A","B",5]]
    let n2 = ["A","B"]
    cki("kr_mst_weight 2-node", kr_mst_weight(e2, n2), 5)
    ckb("kr_is_connected 2-node", kr_is_connected(e2, n2), true)

    // ----------------------------------------------------------------
    // Disconnected: edge A-B:1 but node C is isolated
    // 3 nodes, only 1 edge -> MST has 1 edge, not 2 -> disconnected
    // ----------------------------------------------------------------
    let e3 = [["A","B",1]]
    let n3 = ["A","B","C"]
    ckb("kr_is_connected disconnected", kr_is_connected(e3, n3), false)

    // ----------------------------------------------------------------
    // Single node: trivially connected, MST weight = 0
    // ----------------------------------------------------------------
    let e4 = []
    let n4 = ["X"]
    ckb("kr_is_connected single", kr_is_connected(e4, n4), true)
    cki("kr_mst_weight single", kr_mst_weight(e4, n4), 0)

    // ----------------------------------------------------------------
    // Triangle graph: A-B:3, B-C:1, A-C:2
    // MST: B-C:1, A-C:2  total=3  (A-B:3 skipped)
    // ----------------------------------------------------------------
    let e5 = [["A","B",3],["B","C",1],["A","C",2]]
    let n5 = ["A","B","C"]
    cki("kr_mst_weight triangle", kr_mst_weight(e5, n5), 3)
    let mst5 = kr_mst(e5, n5)
    cki("kr_mst len triangle", len(mst5), 2)
    ckb("kr_is_connected triangle", kr_is_connected(e5, n5), true)
    // first edge of triangle MST should be weight 1
    let te0 = mst5[0]
    cki("kr_mst triangle[0] w", te0[2], 1)

    print("_kruskal_test passed")
