// Probe for the nova_rt_eq string-branch large-int strcmp crash.
// PRE-FIX: `str_value == large_int` dereferenced the int as char* -> crash.
// POST-FIX: a string only strcmp's another readable string; else not-equal.
fn main() -> int
    let fails = 0
    let d = {}
    d["k"] = "PLISTBOO"
    // 5785133072624463183 == 0x504C495354424F4F ("PLISTBOO" packed) — the exact
    // large-int magic that crashed. Must NOT crash; must be not-equal.
    let big = 5785133072624463183
    let r1 = 0
    if d["k"] == big
        r1 = 1
    if r1 != 0
        print("FAIL str==bigint should be 0")
        fails = fails + 1
    // symmetric order: large_int == string
    let r2 = 0
    if big == d["k"]
        r2 = 1
    if r2 != 0
        print("FAIL bigint==str should be 0")
        fails = fails + 1
    // string vs small int (old fast-reject path) — still not-equal, no crash
    let r3 = 0
    if d["k"] == 42
        r3 = 1
    if r3 != 0
        print("FAIL str==smallint should be 0")
        fails = fails + 1
    // genuine string==string equality must STILL work (no regression)
    let d2 = {}
    d2["k"] = "PLISTBOO"
    let r4 = 0
    if d["k"] == d2["k"]
        r4 = 1
    if r4 != 1
        print("FAIL str==str(equal) should be 1")
        fails = fails + 1
    // genuine string inequality must still work
    let d3 = {}
    d3["k"] = "OTHERVAL"
    let r5 = 0
    if d["k"] == d3["k"]
        r5 = 1
    if r5 != 0
        print("FAIL str==str(diff) should be 0")
        fails = fails + 1
    if fails == 0
        print("PASS _eq_largeint_crash_probe")
    else
        print("FAILED _eq_largeint_crash_probe")
    return 0
