fn lru_new(capacity)
  let cache = {}
  cache["data"] = {}
  cache["order"] = []
  cache["cap"] = capacity
  cache

fn _lru_touch(cache, key)
  let order = cache["order"]
  let new_order = []
  for k in order
    if k != key
      push(new_order, k)
  push(new_order, key)
  cache["order"] = new_order

fn _lru_in_order(cache, key)
  for k in cache["order"]
    if k == key
      return 1
  0

fn lru_get(cache, key)
  if _lru_in_order(cache, key) == 0
    return err("miss")
  _lru_touch(cache, key)
  ok(cache["data"][key])

fn lru_put(cache, key, value)
  if contains(cache["data"], key)
    cache["data"][key] = value
    _lru_touch(cache, key)
    return 0
  if len(cache["order"]) >= cache["cap"]
    let evict = cache["order"][0]
    cache["order"] = list_slice(cache["order"], 1, len(cache["order"]))
    cache["data"][evict] = 0
  cache["data"][key] = value
  push(cache["order"], key)
  0

fn lru_size(cache)
  len(cache["order"])

fn lru_has(cache, key)
  contains(cache["data"], key) and cache["data"][key] != 0

fn main()
  let c = lru_new(3)
  let _p1 = lru_put(c, "a", 1)
  let _p2 = lru_put(c, "b", 2)
  let _p3 = lru_put(c, "c", 3)
  assert(lru_size(c) == 3, "size 3")

  assert(unwrap(lru_get(c, "a")) == 1, "get a")
  assert(unwrap(lru_get(c, "b")) == 2, "get b")

  let _p4 = lru_put(c, "d", 4)
  assert(lru_size(c) == 3, "still capped at 3")
  assert(is_err(lru_get(c, "c")), "c evicted (LRU after a,b touched)")

  assert(unwrap(lru_get(c, "a")) == 1, "a still present")
  assert(unwrap(lru_get(c, "d")) == 4, "d present")

  let _p5 = lru_put(c, "a", 10)
  assert(unwrap(lru_get(c, "a")) == 10, "update value")

  assert(is_err(lru_get(c, "missing")), "miss = err")

  print("lrucachex: all passed")
