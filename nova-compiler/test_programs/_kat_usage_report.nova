import forge_usage_report

fn main()
    let u = ur_new()
    u = ur_set_period(u, 1000, 2000)
    assert(ur_entry_count(u) == 0, "empty report")
    assert(ur_total_cost(u) == 0, "zero cost")

    u = ur_add_entry(u, "compute", 10, 50)
    u = ur_add_entry(u, "storage", 100, 2)
    u = ur_add_entry(u, "network", 500, 1)

    assert(ur_entry_count(u) == 3, "3 entries")
    assert(ur_entry_resource(u, 0) == "compute", "entry 0 = compute")
    assert(ur_entry_total(u, 0) == 500, "compute total 500")
    assert(ur_entry_total(u, 1) == 200, "storage total 200")
    assert(ur_entry_total(u, 2) == 500, "network total 500")

    assert(ur_total_cost(u) == 1200, "total 1200")
    assert(ur_average_cost(u) == 400, "avg 400")

    let top = ur_most_expensive(u)
    assert(top == "compute" or top == "network", "top is compute or network")

    print("USAGE-REPORT KAT PASS")
