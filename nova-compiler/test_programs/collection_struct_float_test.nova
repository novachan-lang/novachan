// A float field reached through a COLLECTION-element intermediate (list index, for-loop var) must keep
// its type for str()/arith -- else it reads raw IEEE bits (to_json masks it). Same family as the chained
// field-access + match-Ok fixes. (dict[k].field stays dynamic -- pull into a typed var if needed.)
type P
    v: float
    k: int

fn main()
    let xs = [P(1.5, 1), P(2.5, 2)]

    // list index then .floatField
    assert(str(xs[0].v) == "1.5", "list-index float via str (got " + str(xs[0].v) + ")")
    assert(xs[1].v * 2.0 > 4.9 and xs[1].v * 2.0 < 5.1, "list-index float arithmetic")
    assert(xs[0].k == 1, "list-index int field")
    print("PASS: list-index float (" + str(xs[0].v) + ")")

    // for-loop var then .floatField (the typed-list iteration shape, e.g. query results)
    let total = 0.0
    for p in xs
        total = total + p.v
    assert(total > 3.9 and total < 4.1, "for-loop float sum = 4.0 (got " + str(total) + ")")
    print("PASS: for-loop float sum=" + str(total))

    print("collection_struct_float_test passed")
