fn main()
    let d = {"x": 10, "y": 20, "z": 30}

    let key_list = []
    for k in d
        push(key_list, k)
    assert_eq(len(key_list), 3)
    assert(contains(key_list, "x"), "missing x key")
    assert(contains(key_list, "y"), "missing y key")
    assert(contains(key_list, "z"), "missing z key")

    let kv_keys = []
    let kv_vals = []
    for (k, v) in d
        push(kv_keys, k)
        push(kv_vals, v)
    assert_eq(len(kv_keys), 3)
    assert_eq(len(kv_vals), 3)
    assert(contains(kv_keys, "x"), "missing x")
    assert(contains(kv_keys, "y"), "missing y")
    assert(contains(kv_keys, "z"), "missing z")
    assert(contains(kv_vals, 10), "missing 10")
    assert(contains(kv_vals, 20), "missing 20")
    assert(contains(kv_vals, 30), "missing 30")

    let sum = 0
    for (k, v) in d
        sum = sum + v
    assert_eq(sum, 60)

    let empty = {}
    let ct = 0
    for (k, v) in empty
        ct = ct + 1
    assert_eq(ct, 0)

    let single = {"only": 42}
    let sk = ""
    let sv = 0
    for (k, v) in single
        sk = k
        sv = v
    assert_eq(sk, "only")
    assert_eq(sv, 42)

    let pairs = [[1, "one"], [2, "two"]]
    let p_strs = []
    for (n, s) in pairs
        push(p_strs, str(n) + ":" + s)
    assert_eq(p_strs[0], "1:one")
    assert_eq(p_strs[1], "2:two")

    let from_items = []
    for (k, v) in items(d)
        push(from_items, k + "=" + str(v))
    assert_eq(len(from_items), 3)

    print("dict_iter_test: all passed")
