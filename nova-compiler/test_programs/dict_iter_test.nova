// Test negative indexing
fn test_negative_index()
    nums = [10, 20, 30, 40, 50]
    print(nums[-1])
    print(nums[-2])
    print(nums[-5])

// Test dict iteration
fn test_dict_for()
    d = {"name": "nova", "version": "1.0", "lang": "new"}
    for key in d
        print(key)

// Test dict.values()
fn test_dict_values()
    d = {"a": 1, "b": 2, "c": 3}
    vals = d.values()
    for v in vals
        print(v)

// Test dict.items()
fn test_dict_items()
    d = {"x": 10, "y": 20}
    items = d.items()
    print(len(items))

test_negative_index()
print("---")
test_dict_for()
print("---")
test_dict_values()
print("---")
test_dict_items()
print("done")
