// AI inference oracle: a real linear layer + ReLU over the REAL tensor ops.
// Expected values are hand-computed (independent oracle), not read from our output.
fn main()
    // input x: 1x3
    let x = tensor_from_list([1, 2, 3], [1, 3])
    // weights W: 3x4. Column 3 weights chosen so the pre-activation is negative.
    // W = [[1, 0, 1, -3],
    //      [0, 1, 0,  0],
    //      [1, 1, 1,  0]]
    let w = tensor_from_list([1, 0, 1, -3, 0, 1, 0, 0, 1, 1, 1, 0], [3, 4])

    // z = x @ W  (hand-computed):
    //   col0 = 1*1 + 2*0 + 3*1 =  4
    //   col1 = 1*0 + 2*1 + 3*1 =  5
    //   col2 = 1*1 + 2*0 + 3*1 =  4
    //   col3 = 1*(-3)+2*0 +3*0 = -3
    let z = tensor_matmul(x, w)
    assert_near(tensor_get(z, [0, 0]), 4.0, 0.001)
    assert_near(tensor_get(z, [0, 1]), 5.0, 0.001)
    assert_near(tensor_get(z, [0, 2]), 4.0, 0.001)
    assert_near(tensor_get(z, [0, 3]), -3.0, 0.001)

    // h = relu(z) = [4, 5, 4, 0]  (the -3 must be zeroed)
    let h = tensor_relu(z)
    assert_near(tensor_get(h, [0, 0]), 4.0, 0.001)
    assert_near(tensor_get(h, [0, 1]), 5.0, 0.001)
    assert_near(tensor_get(h, [0, 2]), 4.0, 0.001)
    assert_near(tensor_get(h, [0, 3]), 0.0, 0.001)

    print("AI inference (matmul + ReLU) oracle test passed")
