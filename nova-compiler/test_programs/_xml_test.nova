// KAT test for std/text/xml.nova (xml_parse / xml_text / xml_attr / xml_find / xml_find_all).
// Node shape (from the module): dict {"tag":string, "attrs":dict, "children":list<node>, "text":string}.
// xml_text = own direct text + every descendant's text, depth-first (pre-order over children).
// xml_find / xml_find_all include the ROOT node itself in the pre-order scan, not just descendants.
// Malformed input never crashes: xml_parse returns a node with attrs["error"] set instead.
import std/text/xml

fn expect_str(name: string, got: string, want: string)
    if got != want
        print("FAIL " + name + ": got '" + got + "' want '" + want + "'")
        exit(1)

fn expect_int(name: string, got: int, want: int)
    if got != want
        print("FAIL " + name + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // 1. Basic doc: nested elements, one plain child, one child with an attribute.
    let doc1 = xml_parse("<root><a>hello</a><b x=\"1\">world</b></root>")
    let a = xml_find(doc1, "a")
    expect_str("a text", xml_text(a), "hello")
    let b = xml_find(doc1, "b")
    expect_str("b attr x", xml_attr(b, "x"), "1")
    expect_str("b text", xml_text(b), "world")
    // node shape sanity: tag/attrs/children/text keys exist directly on the dict
    expect_str("root tag", doc1["tag"], "root")
    expect_int("root children count", len(doc1["children"]), 2)
    expect_str("a tag via dict", a["tag"], "a")

    // 2. xml_find_all over a repeated tag, document order preserved.
    let doc2 = xml_parse("<list><item>1</item><item>2</item></list>")
    let items = xml_find_all(doc2, "item")
    expect_int("items count", len(items), 2)
    expect_str("item0 text", xml_text(items[0]), "1")
    expect_str("item1 text", xml_text(items[1]), "2")

    // 3. Nested element + attribute + literal whitespace preservation (no trimming).
    let doc3 = xml_parse("<root>  <child name=\"x\">  text  </child></root>")
    let child = xml_find(doc3, "child")
    expect_str("child attr name", xml_attr(child, "name"), "x")
    expect_str("child text whitespace preserved", xml_text(child), "  text  ")

    // 4. Self-closing empty element: no children, empty text, attrs empty.
    let doc4 = xml_parse("<x/>")
    expect_str("selfclose tag", doc4["tag"], "x")
    expect_int("selfclose children", len(doc4["children"]), 0)
    expect_str("selfclose text", xml_text(doc4), "")
    expect_str("selfclose missing attr", xml_attr(doc4, "missing"), "")

    // 5. Missing attribute on a node that DOES have other attributes returns "".
    expect_str("b missing attr y", xml_attr(b, "y"), "")

    // 6. Valueless (bare) attribute -> value "".
    let doc6 = xml_parse("<opt disabled>x</opt>")
    expect_str("valueless attr", xml_attr(doc6, "disabled"), "")
    expect_str("valueless attr sibling text", xml_text(doc6), "x")

    // 7. Predefined entity decoding in text content.
    let doc7 = xml_parse("<p>a &lt;b&gt; c &amp; d &quot;q&quot; &apos;s&apos;</p>")
    expect_str("entities decoded", xml_text(doc7), "a <b> c & d \"q\" 's'")

    // 8. Comments are skipped entirely; CDATA is captured raw (no entity decoding inside it).
    let doc8 = xml_parse("<r><!-- a <fake> comment --><d><![CDATA[<raw> & stuff]]></d></r>")
    let d = xml_find(doc8, "d")
    expect_str("cdata raw", xml_text(d), "<raw> & stuff")
    expect_int("comment produced no extra children", len(xml_find_all(doc8, "d")), 1)

    // 9. xml_find / xml_find_all include the ROOT itself, pre-order (root before descendants).
    let doc9 = xml_parse("<root id=\"outer\"><root id=\"inner\">nested</root></root>")
    let first = xml_find(doc9, "root")
    expect_str("find returns root itself first", xml_attr(first, "id"), "outer")
    let allroots = xml_find_all(doc9, "root")
    expect_int("find_all count incl root", len(allroots), 2)
    expect_str("find_all[0] is outer", xml_attr(allroots[0], "id"), "outer")
    expect_str("find_all[1] is inner", xml_attr(allroots[1], "id"), "inner")

    // 10. Malformed input never crashes: an error node comes back instead, tag "".
    let doc10 = xml_parse("")
    expect_str("error node tag", doc10["tag"], "")
    expect_str("error node attr", xml_attr(doc10, "error"), "no root element")

    // 11. xml_find / xml_attr are null-safe.
    let missing = xml_find(doc1, "nope")
    if missing != null
        print("FAIL find no match: expected null")
        exit(1)
    expect_str("attr on null node", xml_attr(missing, "x"), "")
    expect_str("text on null node", xml_text(missing), "")

    print("PASS _xml_test")
