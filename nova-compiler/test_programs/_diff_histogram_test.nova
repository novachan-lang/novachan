// KAT for std/text/diff_histogram
// Tests: round-trip (apply(diff(a,b),a)==b), identical, full-replace, repeated lines,
// empty inputs, and structural anchor behavior.
import std/text/diff_histogram

// ── helpers ──────────────────────────────────────────────────────────────────

fn list_eq(a, b)
    if len(a) != len(b)
        return 0
    let i = 0
    while i < len(a)
        if a[i] != b[i]
            return 0
        i = i + 1
    return 1

fn list_str(xs)
    let s = "["
    let i = 0
    while i < len(xs)
        if i > 0
            s = s + ","
        s = s + xs[i]
        i = i + 1
    s = s + "]"
    s

// op_list_str: render a list of [tag,line] ops as a readable string
fn op_list_str(ops)
    let s = "["
    let i = 0
    while i < len(ops)
        if i > 0
            s = s + ","
        let op = ops[i]
        s = s + op[0] + ":" + op[1]
        i = i + 1
    s = s + "]"
    s

// ck_roundtrip: assert that histogram_apply(a, histogram_diff(a, b)) == b
fn ck_roundtrip(label, a_lines, b_lines)
    let script = histogram_diff(a_lines, b_lines)
    let got = histogram_apply(a_lines, script)
    if list_eq(got, b_lines) == 0
        print("FAIL round-trip " + label + ": got=" + list_str(got) + " want=" + list_str(b_lines))
        print("  script=" + op_list_str(script))
        exit(1)

// ck_script_prop: check a property of the script (e.g. all "=" ops for identical)
fn ck_all_keep(label, script)
    let i = 0
    while i < len(script)
        if script[i][0] != "="
            print("FAIL " + label + ": expected all '=' ops, got " + op_list_str(script))
            exit(1)
        i = i + 1

fn ck_no_keep(label, script)
    let i = 0
    while i < len(script)
        if script[i][0] == "="
            print("FAIL " + label + ": expected no '=' ops, got " + op_list_str(script))
            exit(1)
        i = i + 1

fn main()
    // ── KAT 1: empty vs empty ─────────────────────────────────────────────────
    let ea = []
    let eb = []
    ck_roundtrip("empty-empty", ea, eb)
    let s_empty = histogram_diff(ea, eb)
    if len(s_empty) != 0
        print("FAIL KAT1 empty-empty: script should be empty, got " + op_list_str(s_empty))
        exit(1)

    // ── KAT 2: empty a, non-empty b (all inserts) ─────────────────────────────
    let b2 = []
    b2.push("hello")
    b2.push("world")
    ck_roundtrip("empty-a", ea, b2)
    let s2 = histogram_diff(ea, b2)
    let i2 = 0
    while i2 < len(s2)
        if s2[i2][0] != "+"
            print("FAIL KAT2 empty-a: all ops must be '+', got " + op_list_str(s2))
            exit(1)
        i2 = i2 + 1

    // ── KAT 3: non-empty a, empty b (all deletes) ─────────────────────────────
    let a3 = []
    a3.push("foo")
    a3.push("bar")
    ck_roundtrip("empty-b", a3, eb)
    let s3 = histogram_diff(a3, eb)
    let i3 = 0
    while i3 < len(s3)
        if s3[i3][0] != "-"
            print("FAIL KAT3 empty-b: all ops must be '-', got " + op_list_str(s3))
            exit(1)
        i3 = i3 + 1

    // ── KAT 4: identical single lines ─────────────────────────────────────────
    let same1 = []
    same1.push("alpha")
    ck_roundtrip("identical-single", same1, same1)
    let s4 = histogram_diff(same1, same1)
    ck_all_keep("KAT4 identical-single all=", s4)

    // ── KAT 5: identical multi-line ───────────────────────────────────────────
    let same5 = []
    same5.push("line one")
    same5.push("line two")
    same5.push("line three")
    ck_roundtrip("identical-multi", same5, same5)
    let s5 = histogram_diff(same5, same5)
    ck_all_keep("KAT5 identical-multi all=", s5)

    // ── KAT 6: full replacement ["a"] -> ["b"] ────────────────────────────────
    let a6 = []
    a6.push("a")
    let b6 = []
    b6.push("b")
    ck_roundtrip("full-replace-single", a6, b6)
    let s6 = histogram_diff(a6, b6)
    ck_no_keep("KAT6 full-replace-single no=", s6)

    // ── KAT 7: repeated lines ["x","x","y"] -> ["x","y","y"] ─────────────────
    let a7 = []
    a7.push("x")
    a7.push("x")
    a7.push("y")
    let b7 = []
    b7.push("x")
    b7.push("y")
    b7.push("y")
    ck_roundtrip("repeated-lines", a7, b7)

    // ── KAT 8: one substitution in the middle ────────────────────────────────
    let a8 = []
    a8.push("a")
    a8.push("b")
    a8.push("c")
    let b8 = []
    b8.push("a")
    b8.push("x")
    b8.push("c")
    ck_roundtrip("middle-substitution", a8, b8)

    // ── KAT 9: delete from middle ────────────────────────────────────────────
    let a9 = []
    a9.push("a")
    a9.push("b")
    a9.push("c")
    let b9 = []
    b9.push("a")
    b9.push("c")
    ck_roundtrip("delete-middle", a9, b9)

    // ── KAT 10: insert at start ──────────────────────────────────────────────
    let a10 = []
    a10.push("b")
    a10.push("c")
    let b10 = []
    b10.push("a")
    b10.push("b")
    b10.push("c")
    ck_roundtrip("insert-start", a10, b10)

    // ── KAT 11: insert at end ────────────────────────────────────────────────
    let a11 = []
    a11.push("a")
    a11.push("b")
    let b11 = []
    b11.push("a")
    b11.push("b")
    b11.push("c")
    ck_roundtrip("insert-end", a11, b11)

    // ── KAT 12: all-new content (no overlap) ────────────────────────────────
    let a12 = []
    a12.push("one")
    a12.push("two")
    a12.push("three")
    let b12 = []
    b12.push("four")
    b12.push("five")
    b12.push("six")
    ck_roundtrip("no-overlap", a12, b12)

    // ── KAT 13: larger realistic diff — code-like lines ──────────────────────
    let a13 = []
    a13.push("fn foo()")
    a13.push("    let x = 1")
    a13.push("    let y = 2")
    a13.push("    return x + y")
    let b13 = []
    b13.push("fn foo()")
    b13.push("    let x = 10")
    b13.push("    let z = 3")
    b13.push("    let y = 2")
    b13.push("    return x + y + z")
    ck_roundtrip("code-like", a13, b13)

    // ── KAT 14: apply on single-line full-replace ────────────────────────────
    // Verify apply correctly handles the ["-","a"],["+","b"] case.
    let a14 = []
    a14.push("a")
    let b14 = []
    b14.push("b")
    let s14 = histogram_diff(a14, b14)
    let r14 = histogram_apply(a14, s14)
    if list_eq(r14, b14) == 0
        print("FAIL KAT14 apply-full-replace: got=" + list_str(r14) + " want=" + list_str(b14))
        exit(1)

    // ── KAT 15: round-trip on longer repeated-line sequence ──────────────────
    let a15 = []
    a15.push("x")
    a15.push("y")
    a15.push("x")
    a15.push("y")
    a15.push("z")
    let b15 = []
    b15.push("y")
    b15.push("x")
    b15.push("y")
    b15.push("z")
    b15.push("z")
    ck_roundtrip("longer-repeated", a15, b15)

    print("PASS _diff_histogram_test")
