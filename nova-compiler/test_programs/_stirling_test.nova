// KAT test for std/math/stirling.nova
import std/math/stirling

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks_list(label: str, got: list, want: list)
    let n = len(want)
    if len(got) != n
        print("FAIL " + label + ": length got=" + str(len(got)) + " want=" + str(n))
        exit(1)
    let i = 0
    while i < n
        let gv = got[i]
        let wv = want[i]
        if gv != wv
            print("FAIL " + label + "[" + str(i) + "]: got=" + str(gv) + " want=" + str(wv))
            exit(1)
        i = i + 1

// --- Stirling 2nd kind ---
// S(0,0)=1 (boundary / identity)
cki("st_second(0,0)", st_second(0, 0), 1)

// S(3,2)=3: {1,2},{3} or {1,3},{2} or {2,3},{1}
cki("st_second(3,2)", st_second(3, 2), 3)

// S(4,2)=7
cki("st_second(4,2)", st_second(4, 2), 7)

// S(5,3)=25
cki("st_second(5,3)", st_second(5, 3), 25)

// S(4,4)=1 (all singletons)
cki("st_second(4,4)", st_second(4, 4), 1)

// --- Stirling 1st kind (unsigned) ---
// c(3,2)=3
cki("st_first(3,2)", st_first(3, 2), 3)

// c(4,2)=11
cki("st_first(4,2)", st_first(4, 2), 11)

// c(4,1)=6
cki("st_first(4,1)", st_first(4, 1), 6)

// --- st_second_row ---
// st_second_row(4) = [S(4,0), S(4,1), S(4,2), S(4,3), S(4,4)] = [0,1,7,6,1]
let expected4 = [0, 1, 7, 6, 1]
cks_list("st_second_row(4)", st_second_row(4), expected4)

// additional sanity: row 0 = [1]
let expected0 = [1]
cks_list("st_second_row(0)", st_second_row(0), expected0)

// out-of-range returns 0
cki("st_second(0,1)", st_second(0, 1), 0)
cki("st_first(0,1)", st_first(0, 1), 0)

print("_stirling_test passed")
