// _forex_test.nova — KAT for std/finance/forex
//
// Known answers:
//   fx_convert(100.0, 1.1)           = 110.0
//   cross_rate(1.1, 1.25)            = 1.1 / 1.25 = 0.88
//   pip_value(100000.0, 0.0001)      = 10.0
//   spread(1.1000, 1.1002)           = 0.0002

import std/finance/forex

fn approx(a: float, b: float, tol: float) -> int
    let d = a - b
    let ad = d
    if d < 0.0
        ad = 0.0 - d
    if ad < tol
        return 1
    return 0

fn main()
    // KAT 1: fx_convert — 100 * 1.1 = 110.0
    let v1 = fx_convert(100.0, 1.1)
    if not approx(v1, 110.0, 0.0001)
        print("FAIL forex fx_convert: got " + str(v1))
        exit(1)

    // KAT 2: cross_rate — 1.1 / 1.25 = 0.88
    let v2 = cross_rate(1.1, 1.25)
    if not approx(v2, 0.88, 0.0001)
        print("FAIL forex cross_rate: got " + str(v2))
        exit(1)

    // KAT 3: pip_value — 100000 * 0.0001 = 10.0
    let v3 = pip_value(100000.0, 0.0001)
    if not approx(v3, 10.0, 0.0001)
        print("FAIL forex pip_value: got " + str(v3))
        exit(1)

    // KAT 4: spread — 1.1002 - 1.1000 = 0.0002
    let v4 = spread(1.1000, 1.1002)
    if not approx(v4, 0.0002, 0.00001)
        print("FAIL forex spread: got " + str(v4))
        exit(1)

    print("PASS _forex_test")
