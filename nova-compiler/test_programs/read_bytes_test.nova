// Oracle: read_bytes() must return the file's raw bytes. ASCII codes are the
// independent authority (h=104, e=101, l=108, o=111). Was a hard link error
// (mapped+declared+typed but undefined in the runtime) until 2026-05-29.
fn main()
    write_file("rb_test.bin", "hello")
    let b = read_bytes("rb_test.bin")
    assert_eq(bytes_len(b), 5)
    assert_eq(bytes_get(b, 0), 104)
    assert_eq(bytes_get(b, 1), 101)
    assert_eq(bytes_get(b, 2), 108)
    assert_eq(bytes_get(b, 3), 108)
    assert_eq(bytes_get(b, 4), 111)
    assert_eq(bytes_to_str(b), "hello")
    print("read_bytes test passed")
