fn main()
    // Calls a TLS builtin -> the .ll has `call @nova_rt_tls_connect` -> demand-driven
    // OpenSSL kicks in (the runtime compiles its #ifdef NOVA_HAVE_OPENSSL TLS path +
    // links -lssl -lcrypto). Port 9 with no server -> the handshake fails -> 0; the
    // point is the binary LINKS with OpenSSL and the TLS code path is compiled in
    // (before this fix it could not link: nova_rt_tls_connect is OpenSSL-gated).
    let h = tls_connect("127.0.0.1", 9)
    if h == 0
        print("tls_connect -> 0 (no server); OpenSSL TLS path is live + linked")
    else
        print("tls_connect handle nonzero")
        tls_close(h)
    print("TLS_BUILD_OK")
