import forge_reservoir

fn tf(b: bool) -> string
    if b
        return "T"
    "F"

fn main()
    // build 0..99
    let items = []
    let i = 0
    while i < 100
        push(items, i)
        i = i + 1
    // sample size == k
    let s = reservoir_sample(items, 10, 42)
    print("size=" + tf(len(s) == 10))
    // deterministic: same seed -> same sample
    let s2 = reservoir_sample(items, 10, 42)
    let same = true
    let j = 0
    while j < len(s)
        if s[j] != s2[j]
            same = false
        j = j + 1
    print("deterministic=" + tf(same))
    // different seed -> (usually) different sample
    let s3 = reservoir_sample(items, 10, 999)
    let diff = false
    let k = 0
    while k < len(s)
        if s[k] != s3[k]
            diff = true
        k = k + 1
    print("seed_varies=" + tf(diff))
    // all sampled items are from the source (0..99)
    let valid = true
    let m = 0
    while m < len(s)
        if s[m] < 0 or s[m] >= 100
            valid = false
        m = m + 1
    print("valid_members=" + tf(valid))
    // small list (n <= k) returns all
    print("small=" + tf(len(reservoir_sample([1, 2, 3], 10, 1)) == 3))
    // k=0 -> empty
    print("zero=" + tf(len(reservoir_sample(items, 0, 1)) == 0))
    // no duplicates in the sample (each index replaced at most once conceptually)
    let seen = {}
    let dup = false
    let p = 0
    while p < len(s)
        if contains(seen, str(s[p]))
            dup = true
        seen[str(s[p])] = 1
        p = p + 1
    print("no_dupes=" + tf(dup == false))
