fn main()
    let a = 1
    let b = 2
    a, b = b, a
    assert(a == 2, "swap: a should be 2")
    assert(b == 1, "swap: b should be 1")

    let x = 10
    let y = 20
    let z = 30
    x, y, z = z, x, y
    assert(x == 30, "triple: x should be 30")
    assert(y == 10, "triple: y should be 10")
    assert(z == 20, "triple: z should be 20")

    let p = 100
    let q = 200
    p, q = p + q, p - q
    assert(p == 300, "expr rhs: p should be 300")
    assert(q == -100, "expr rhs: q should be -100")

    let items = [1, 2, 3]
    items[0], items[2] = items[2], items[0]
    assert(items[0] == 3, "index swap: items[0] should be 3")
    assert(items[2] == 1, "index swap: items[2] should be 1")

    print("multi_assign_test: all passed")
