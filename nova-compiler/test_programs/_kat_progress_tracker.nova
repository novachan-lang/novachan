import forge_progress_tracker

fn main()
    let p = pt_new()
    p = pt_add(p, "build", 100)
    p = pt_add(p, "test", 50)
    assert(pt_task_count(p) == 2, "2 tasks")

    let r1 = pt_advance(p, "build", 25)
    assert(is_ok(r1), "advance ok")
    p = unwrap(r1)

    let prog = pt_progress(p, "build")
    assert(is_ok(prog), "progress ok")
    assert(unwrap(prog) == 25, "25%")

    assert(pt_is_complete(p, "build") == 0, "not complete")

    let r2 = pt_advance(p, "build", 75)
    assert(is_ok(r2), "advance2 ok")
    p = unwrap(r2)
    assert(pt_is_complete(p, "build") == 1, "complete")

    let prog2 = pt_progress(p, "build")
    assert(unwrap(prog2) == 100, "100%")
    assert(pt_completed_count(p) == 1, "1 completed")

    let dc = pt_done_count(p, "build")
    assert(is_ok(dc), "done count ok")
    assert(unwrap(dc) == 100, "done=100")

    let bad = pt_advance(p, "nope", 1)
    assert(is_err(bad), "unknown task err")

    print("PROGRESS-TRACKER KAT PASS")
