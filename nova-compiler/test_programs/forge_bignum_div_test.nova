import forge_bignum

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // divmod exact
    let qr1 = big_divmod("100", "7")
    fails = fails + expect("dm_100_7_q", qr1[0], "14")
    fails = fails + expect("dm_100_7_r", qr1[1], "2")
    fails = fails + expect("div_exact", big_div("56088", "456"), "123")
    fails = fails + expect("mod_exact", big_mod("56088", "456"), "0")
    fails = fails + expect("div_1e6_3", big_div("1000000", "3"), "333333")
    fails = fails + expect("mod_1e6_3", big_mod("1000000", "3"), "1")
    // divisor larger than dividend
    fails = fails + expect("div_small", big_div("5", "10"), "0")
    fails = fails + expect("mod_small", big_mod("5", "10"), "5")

    // reconstruction: q*b + r == a for a huge dividend (2^100)
    let big = big_pow("2", 100)
    let qr = big_divmod(big, "1000000007")
    let recon = big_add(big_mul(qr[0], "1000000007"), qr[1])
    fails = fails + expect("recon_2^100", recon, big)
    // remainder must be < divisor
    fails = fails + expect("rem_lt_div", str(big_cmp(qr[1], "1000000007")), "-1")

    // 50! divided by 25! reconstruction
    let f50 = big_factorial(50)
    let f25 = big_factorial(25)
    let qr2 = big_divmod(f50, f25)
    let recon2 = big_add(big_mul(qr2[0], f25), qr2[1])
    fails = fails + expect("recon_50fact", recon2, f50)

    // modular exponentiation -- small knowns
    fails = fails + expect("pm_3_5_7", big_powmod("3", 5, "7"), "5")
    fails = fails + expect("pm_2_10_1000", big_powmod("2", 10, "1000"), "24")
    fails = fails + expect("pm_7_2_5", big_powmod("7", 2, "5"), "4")
    fails = fails + expect("pm_exp0", big_powmod("123", 0, "1000"), "1")

    // powmod must agree with pow-then-mod (2^100 mod 1e9+7)
    let direct = big_mod(big_pow("2", 100), "1000000007")
    fails = fails + expect("pm_consistency", big_powmod("2", 100, "1000000007"), direct)

    if fails == 0
        print("forge_bignum_div: all passed")
    else
        print("forge_bignum_div: " + str(fails) + " FAILED")
