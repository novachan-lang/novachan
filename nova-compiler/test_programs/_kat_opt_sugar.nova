// KAT: `T?` optional-type sugar must parse + work in a struct FIELD and a `let` annotation (not just
// param/return). Regression for the dogfood gap: `type H{ x: int? }` and `let x: int? = some(5)` failed
// with a spurious 'missing closing )'. The field/let type parsers now capture the `?` suffix
// (ti_ann_to_type_g maps it to Option<T> = nt_sum(T, unit)). NOTE: the `T?` sugar path works even though
// the EXPLICIT `Option<int>` spelling still has a separate unification bug (round-2 #4, tracked).
type Holder
    x: int?
    label: string

fn main() -> int
    let a: int? = some(42)
    match a
        Some(v) => assert(v == 42, "let int? = some")
        None => assert(false, "unexpected none for a")
    let b: int? = none()
    match b
        Some(v) => assert(false, "unexpected some for b")
        None => assert(true, "let int? = none")
    let h = Holder(some(5), "hi")
    match h.x
        Some(v) => assert(v == 5, "struct field int? some payload")
        None => assert(false, "unexpected none for field")
    assert(h.label == "hi", "struct field after an int? field is intact")
    print("PASS _kat_opt_sugar")
    return 0

main()
