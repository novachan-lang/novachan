// _vin_test.nova — KAT for std/validation/vin
import std/validation/vin

fn ckb(label: string, got: bool, expected: bool)
    if got != expected
        let gs = "false"
        if got
            gs = "true"
        let es = "false"
        if expected
            es = "true"
        print("FAIL " + label + ": got " + gs + " expected " + es)
        exit(1)

fn cks(label: string, got: string, expected: string)
    if got != expected
        print("FAIL " + label + ": got '" + got + "' expected '" + expected + "'")
        exit(1)

fn main()
    // KAT 1: Classic valid VIN with check digit 'X'
    // 1HGBH41JXMN109186 — Honda Civic, computed sum=340 mod 11=10 => 'X' at pos 8
    ckb("valid_honda", vvin_is_valid("1HGBH41JXMN109186"), true)

    // KAT 2: Same VIN with last digit changed — check digit still X but content wrong
    // Changes the last char from 6 to 7 — check digit recomputes differently
    ckb("bad_last_digit", vvin_is_valid("1HGBH41JXMN109187"), false)

    // KAT 3: VIN with '0' replacing the check-digit 'X' — wrong check digit
    ckb("wrong_check_digit", vvin_is_valid("1HGBH41J0MN109186"), false)

    // KAT 4: Too short — must be exactly 17 chars
    ckb("too_short", vvin_is_valid("SHORT"), false)

    // KAT 5: Contains illegal character 'I' at position 8
    ckb("contains_I", vvin_is_valid("1HGBH41JIMN109186"), false)

    // KAT 6: Contains illegal character 'O'
    ckb("contains_O", vvin_is_valid("1HGBH41JOMN109186"), false)

    // KAT 7: Contains illegal character 'Q'
    ckb("contains_Q", vvin_is_valid("1HGBH41JQMN109186"), false)

    // KAT 8: Empty string — invalid
    ckb("empty", vvin_is_valid(""), false)

    // KAT 9: vvin_check_digit returns "X" for the canonical Honda VIN
    cks("check_digit_X", vvin_check_digit("1HGBH41JXMN109186"), "X")

    // KAT 10: vvin_check_digit returns "" for wrong length
    cks("check_digit_empty_short", vvin_check_digit("SHORT"), "")

    // KAT 11: vvin_wmi extracts the first 3 characters (uppercased)
    cks("wmi_1hg", vvin_wmi("1HGBH41JXMN109186"), "1HG")

    // KAT 12: vvin_wmi on lowercase input — returns uppercased WMI
    cks("wmi_lowercase", vvin_wmi("1hgbh41jxmn109186"), "1HG")

    // KAT 13: vvin_year_char returns char at index 9 (model year)
    // "1HGBH41JXMN109186" index 9 = 'M'
    cks("year_char_M", vvin_year_char("1HGBH41JXMN109186"), "M")

    // KAT 14: vvin_year_char on too-short string returns ""
    cks("year_char_empty", vvin_year_char("12345678"), "")

    // KAT 15: vvin_wmi on too-short string returns ""
    cks("wmi_empty", vvin_wmi("AB"), "")

    print("_vin_test passed")
