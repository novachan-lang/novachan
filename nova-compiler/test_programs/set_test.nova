// Test: NOVA stdlib — set operations

fn main()
    let s = set_create()

    // Add elements
    set_add(s, 10)
    set_add(s, 20)
    set_add(s, 30)
    assert(set_len(s) == 3, "set should have 3 elements")

    // Duplicate add should not increase size
    set_add(s, 20)
    assert(set_len(s) == 3, "set should still have 3 elements after dup add")

    // Has check
    assert(set_has(s, 10) == 1, "set should contain 10")
    assert(set_has(s, 20) == 1, "set should contain 20")
    assert(set_has(s, 99) == 0, "set should not contain 99")

    // Remove
    set_remove(s, 20)
    assert(set_len(s) == 2, "set should have 2 after remove")
    assert(set_has(s, 20) == 0, "20 should be removed")

    // Convert to list
    let lst = set_to_list(s)
    assert(len(lst) == 2, "list from set should have 2 elements")
    print("set as list: {lst}")

    // Larger set
    let big = set_create()
    let i = 0
    while i < 100
        set_add(big, i)
        i = i + 1
    assert(set_len(big) == 100, "big set should have 100 elements")

    print("all set tests passed")

main()
