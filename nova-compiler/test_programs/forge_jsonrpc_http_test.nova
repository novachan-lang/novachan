// functional: JSON-RPC-over-HTTP endpoint dispatched through the Forge router
import forge
import forge_jsonrpc_http

fn _m_add(params)
    params["a"] + params["b"]

fn main()
    let app = forge.app()
    let m = forge_jsonrpc_http.jsonrpc_methods()
    forge_jsonrpc_http.jsonrpc_register(m, "add", _m_add)
    forge_jsonrpc_http.jsonrpc_route(app, "/rpc", m)
    let rpc = {}
    rpc["jsonrpc"] = "2.0"
    rpc["method"] = "add"
    let params = {}
    params["a"] = 100
    params["b"] = 23
    rpc["params"] = params
    rpc["id"] = 1
    let resp = forge.dispatch(app, "POST", "/rpc", json_stringify(rpc))
    if find(resp, "result") < 0
        print("FAIL no result: " + resp)
        exit(1)
    if find(resp, "123") < 0
        print("FAIL wrong sum: " + resp)
        exit(1)
    print("PASS forge_jsonrpc_http")
