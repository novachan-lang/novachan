// KAT for std/time/daycount
// Tests dc_30_360, dc_act_365, dc_act_360_frac_bp, dc_year_frac_30_360_bp.
// Known vectors verified against standard financial conventions and calendar truth.
import std/time/daycount

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL daycount " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // ── dc_30_360 (US Bond Basis / ISDA) ─────────────────────────────────

    // 2024-01-01 to 2024-07-01: exactly half a 30/360 year
    // (Y2-Y1)*360 + (M2-M1)*30 + (D2-D1) = 0*360 + 6*30 + 0 = 180
    cki("30_360-half-year", dc_30_360(2024, 1, 1, 2024, 7, 1), 180)

    // 2024-01-31 to 2024-02-28:
    // D1=31→30 (step 1). D2=28 (not 31, no step 3). Days=0*360+1*30+(28-30)=28
    cki("30_360-jan31-feb28", dc_30_360(2024, 1, 31, 2024, 2, 28), 28)

    // 2024-01-31 to 2024-03-31:
    // D1=31→30, D2=31 and D1=30→D2=30. Days=0*360+2*30+(30-30)=60
    cki("30_360-jan31-mar31", dc_30_360(2024, 1, 31, 2024, 3, 31), 60)

    // Full year: 2023-01-01 to 2024-01-01 = 360 days by 30/360
    cki("30_360-full-year", dc_30_360(2023, 1, 1, 2024, 1, 1), 360)

    // Same date → 0
    cki("30_360-same-date", dc_30_360(2024, 6, 15, 2024, 6, 15), 0)

    // Cross-year: 2023-06-15 to 2024-06-15 = 360 days (one full 30/360 year)
    cki("30_360-cross-year", dc_30_360(2023, 6, 15, 2024, 6, 15), 360)

    // 2024-02-30 clamp handling: d1=30 clamped to 29 (Feb 2024 = 29 days, leap year)
    // dc_30_360(2024,2,30→29, 2024,3,1): D1=29 (not 31), D2=1 (not 31)
    // Days = 0*360 + 1*30 + (1-29) = 30 - 28 = 2
    cki("30_360-feb-clamp", dc_30_360(2024, 2, 30, 2024, 3, 1), 2)

    // Non-leap year Feb clamp: 2023-02-30 → clamped to 28
    // dc_30_360(2023,2,30→28, 2023,3,1): D1=28 (not 31), D2=1. Days=0*360+1*30+(1-28)=3
    cki("30_360-feb-nonleap-clamp", dc_30_360(2023, 2, 30, 2023, 3, 1), 3)

    // Quarter (3 months): 2024-04-01 to 2024-07-01 = 3*30 = 90
    cki("30_360-quarter", dc_30_360(2024, 4, 1, 2024, 7, 1), 90)

    // ── dc_act_365 (Actual day count) ─────────────────────────────────────

    // 2024-01-01 to 2024-12-31: 2024 is leap (366 days total).
    // Jan1 to Dec31 = 365 actual days (Dec31 is the 366th day, not included).
    cki("act365-jan1-dec31-2024", dc_act_365(2024, 1, 1, 2024, 12, 31), 365)

    // 2024-01-01 to 2025-01-01: full leap year = 366 days
    cki("act365-full-leap-year", dc_act_365(2024, 1, 1, 2025, 1, 1), 366)

    // 2023-01-01 to 2024-01-01: full non-leap year = 365 days
    cki("act365-full-nonleap-year", dc_act_365(2023, 1, 1, 2024, 1, 1), 365)

    // Same date → 0
    cki("act365-same-date", dc_act_365(2024, 6, 15, 2024, 6, 15), 0)

    // End before start → 0
    cki("act365-reverse", dc_act_365(2024, 7, 1, 2024, 1, 1), 0)

    // 2024-02-28 to 2024-03-01: 2024 is leap, so Feb has 29 days.
    // Feb28 to Mar1 = 2 days (Feb28→Feb29→Mar1)
    cki("act365-feb28-mar1-leap", dc_act_365(2024, 2, 28, 2024, 3, 1), 2)

    // 2023-02-28 to 2023-03-01: 2023 is non-leap, Feb has 28 days.
    // Feb28 to Mar1 = 1 day
    cki("act365-feb28-mar1-nonleap", dc_act_365(2023, 2, 28, 2023, 3, 1), 1)

    // Jan1 to Apr1 2024: Jan(31) + Feb(29) + Mar(31) = 91 days
    cki("act365-jan1-apr1-2024", dc_act_365(2024, 1, 1, 2024, 4, 1), 91)

    // ── dc_act_360_frac_bp (Actual/360 in basis points) ──────────────────

    // Jan1 to Apr1 2024 = 91 actual days. (91 * 10000) / 360 = 910000 / 360 = 2527
    cki("act360bp-jan1-apr1-2024", dc_act_360_frac_bp(2024, 1, 1, 2024, 4, 1), 2527)

    // Full year 2024 (leap, 366 days): (366 * 10000) / 360 = 3660000 / 360 = 10166
    cki("act360bp-full-leap-2024", dc_act_360_frac_bp(2024, 1, 1, 2025, 1, 1), 10166)

    // Full year 2023 (non-leap, 365 days): (365 * 10000) / 360 = 3650000 / 360 = 10138
    cki("act360bp-full-nonleap-2023", dc_act_360_frac_bp(2023, 1, 1, 2024, 1, 1), 10138)

    // Same date → 0
    cki("act360bp-same-date", dc_act_360_frac_bp(2024, 6, 15, 2024, 6, 15), 0)

    // End before start → 0
    cki("act360bp-reverse", dc_act_360_frac_bp(2024, 7, 1, 2024, 1, 1), 0)

    // 180 actual days (exact): (180 * 10000) / 360 = 5000
    // 2024-01-01 to 2024-06-29: Jan(31)+Feb(29)+Mar(31)+Apr(30)+May(31)+Jun(28)=180
    cki("act360bp-180days", dc_act_360_frac_bp(2024, 1, 1, 2024, 6, 29), 5000)

    // ── dc_year_frac_30_360_bp (30/360 year fraction in basis points) ─────

    // 2024-01-01 to 2024-07-01 = 180 30/360 days. (180 * 10000) / 360 = 5000
    cki("yf30360bp-half-year", dc_year_frac_30_360_bp(2024, 1, 1, 2024, 7, 1), 5000)

    // Full 30/360 year = 360 days. (360 * 10000) / 360 = 10000
    cki("yf30360bp-full-year", dc_year_frac_30_360_bp(2023, 1, 1, 2024, 1, 1), 10000)

    // Quarter: 90 30/360 days. (90 * 10000) / 360 = 2500
    cki("yf30360bp-quarter", dc_year_frac_30_360_bp(2024, 4, 1, 2024, 7, 1), 2500)

    // Same date → 0
    cki("yf30360bp-same-date", dc_year_frac_30_360_bp(2024, 6, 15, 2024, 6, 15), 0)

    // End before start → 0
    cki("yf30360bp-reverse", dc_year_frac_30_360_bp(2024, 7, 1, 2024, 1, 1), 0)

    // ── Round-trip: dc_30_360 + dc_year_frac_30_360_bp consistency ───────
    // For any 30/360 days D: dc_year_frac_30_360_bp = (D * 10000) / 360
    // Use 2024-03-01 to 2024-09-01: 6 months = 180 30/360 days → 5000 bp
    let days_rt = dc_30_360(2024, 3, 1, 2024, 9, 1)
    cki("rt-30360-days", days_rt, 180)
    let bp_rt = dc_year_frac_30_360_bp(2024, 3, 1, 2024, 9, 1)
    cki("rt-30360-bp", bp_rt, 5000)
    // Verify consistency: (days_rt * 10000) / 360 == bp_rt
    cki("rt-30360-consistent", (days_rt * 10000) / 360, bp_rt)

    print("PASS _daycount_test")
