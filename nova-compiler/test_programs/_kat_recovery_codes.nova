// KAT: forge_recovery_codes -- 2FA backup codes: generate, format, single-use consume.
import forge_recovery_codes

fn main()
    let codes = recovery_codes(5, 2, 4)
    assert(len(codes) == 5, "recovery_codes(5,...) generates 5 codes")

    for i in 0..len(codes)
        assert(len(codes[i]) == 9, "each code is 2 groups of 4 + 1 dash = 9 chars")
        assert(char_at(codes[i], 4) == "-", "dash separator sits between the two groups")

    // CSPRNG-generated codes must not collide.
    assert(not (codes[0] == codes[1]), "first and second generated codes are unique")

    // Consume the first code: single-use removal.
    let r1 = recovery_consume(codes, codes[0])
    let found1 = r1[0]
    let remaining1 = r1[1]
    assert(found1, "consuming a valid, unused code succeeds")
    assert(len(remaining1) == 4, "consumed code is removed, 4 remain")
    assert(not (codes[0] in remaining1), "the consumed code is no longer in the remaining set")

    // Consuming the same code again against the already-reduced set fails (single-use).
    let r2 = recovery_consume(remaining1, codes[0])
    let found2 = r2[0]
    let remaining2 = r2[1]
    assert(not found2, "double-consume of an already-used code fails")
    assert(len(remaining2) == 4, "remaining set is unchanged on a failed consume")

    print("RECOVERY-CODES KAT PASS")
