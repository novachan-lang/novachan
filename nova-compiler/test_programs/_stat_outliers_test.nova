import std/statistics/stat_outliers

// ckf — float tolerance check (0.001)
fn ckf(label: string, got: float, want: float)
    let d = got - want
    if d < 0.0
        d = 0.0 - d
    if d > 0.001
        print("FAIL stat_outliers " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// cki — integer equality check
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL stat_outliers " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // --- sou_tukey_fences ---

    // [1,2,3,4,5,6,7,8]: Q1=2.5 Q3=6.5 IQR=4.0
    //   lower = 2.5 - 6.0 = -3.5   upper = 6.5 + 6.0 = 12.5
    let xs8 = [1, 2, 3, 4, 5, 6, 7, 8]
    let f8 = sou_tukey_fences(xs8)
    cki("fences8_len", len(f8), 2)
    ckf("fences8_lower", f8[0] * 1.0, -3.5)
    ckf("fences8_upper", f8[1] * 1.0, 12.5)

    // [1,2,3] n=3 odd: exclusive halves are [1] and [3] (exclude middle=2)
    //   Q1=1.0, Q3=3.0, IQR=2.0
    //   lower_fence = 1.0 - 3.0 = -2.0  upper_fence = 3.0 + 3.0 = 6.0
    let xs3 = [1, 2, 3]
    let f3 = sou_tukey_fences(xs3)
    cki("fences3_len", len(f3), 2)
    ckf("fences3_lower", f3[0] * 1.0, -2.0)
    ckf("fences3_upper", f3[1] * 1.0, 6.0)

    // single element → [0.0, 0.0]
    let f1 = sou_tukey_fences([42])
    cki("fences1_len", len(f1), 2)
    ckf("fences1_lower", f1[0] * 1.0, 0.0)
    ckf("fences1_upper", f1[1] * 1.0, 0.0)

    // --- sou_iqr_outliers ---

    // [1,2,3,4,5,6,7,8,100] → fences: Q1=2.5 Q3=7.5 IQR=5.0
    //   lower=-5.0 upper=15.0 → only 100 is an outlier
    let xs9 = [1, 2, 3, 4, 5, 6, 7, 8, 100]
    let out9 = sou_iqr_outliers(xs9)
    cki("iqr9_len", len(out9), 1)
    ckf("iqr9_val", out9[0] * 1.0, 100.0)

    // [1,2,3,4,5] → no outliers
    let xs5 = [1, 2, 3, 4, 5]
    let out5 = sou_iqr_outliers(xs5)
    cki("iqr5_len", len(out5), 0)

    // empty → empty
    let oute = sou_iqr_outliers([])
    cki("iqr_empty", len(oute), 0)

    // [1,2,3,4,5,6,7,8] → no outliers (all within fences [-3.5, 12.5])
    let out8 = sou_iqr_outliers(xs8)
    cki("iqr8_len", len(out8), 0)

    // --- sou_zscore_outliers ---

    // [1,2,3,4,100] thresh=2/1=2.0: mean=22, stddev≈39.01, z(100)≈1.999 → included (tolerance)
    let xs_z = [1, 2, 3, 4, 100]
    let zout = sou_zscore_outliers(xs_z, 2, 1)
    cki("zscore_len", len(zout), 1)
    ckf("zscore_val", zout[0] * 1.0, 100.0)

    // clear outlier: [0,0,0,0,0,100] thresh=2/1
    //   mean=100/6≈16.67, deviations: 5×(-16.67), 83.33
    //   var = (5*277.78 + 6944.44)/6 = (1388.9 + 6944.44)/6 ≈ 1388.9
    //   stddev ≈ 37.3, z(100) = (100-16.67)/37.3 ≈ 2.23 → outlier
    let xs_z2 = [0, 0, 0, 0, 0, 100]
    let zout2 = sou_zscore_outliers(xs_z2, 2, 1)
    cki("zscore2_len", len(zout2), 1)

    // constant data → no outliers (stddev=0)
    let xs_const = [5, 5, 5, 5]
    let zout_c = sou_zscore_outliers(xs_const, 2, 1)
    cki("zscore_const", len(zout_c), 0)

    print("PASS _stat_outliers_test")
