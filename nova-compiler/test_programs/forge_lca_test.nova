import forge_lca

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // tree:      0
    //           / \
    //          1   2
    //         / \   \
    //        3   4   5
    //           / \
    //          6   7
    let adj = []
    push(adj, [1, 2])
    push(adj, [0, 3, 4])
    push(adj, [0, 5])
    push(adj, [1])
    push(adj, [1, 6, 7])
    push(adj, [2])
    push(adj, [4])
    push(adj, [4])

    let pk = lca_build(8, adj, 0)

    fails = fails + expect("lca_3_4", str(lca_query(pk, 3, 4)), "1")
    fails = fails + expect("lca_6_7", str(lca_query(pk, 6, 7)), "4")
    fails = fails + expect("lca_3_6", str(lca_query(pk, 3, 6)), "1")
    fails = fails + expect("lca_6_5", str(lca_query(pk, 6, 5)), "0")
    fails = fails + expect("lca_self", str(lca_query(pk, 3, 3)), "3")
    fails = fails + expect("lca_ancestor", str(lca_query(pk, 4, 1)), "1")
    fails = fails + expect("lca_6_2", str(lca_query(pk, 6, 2)), "0")
    fails = fails + expect("lca_5_7", str(lca_query(pk, 5, 7)), "0")
    fails = fails + expect("lca_root", str(lca_query(pk, 0, 6)), "0")
    fails = fails + expect("lca_7_6", str(lca_query(pk, 7, 6)), "4")

    // distances (edges on the tree path)
    fails = fails + expect("dist_6_7", str(lca_distance(pk, 6, 7)), "2")
    fails = fails + expect("dist_3_5", str(lca_distance(pk, 3, 5)), "4")
    fails = fails + expect("dist_6_3", str(lca_distance(pk, 6, 3)), "3")
    fails = fails + expect("dist_self", str(lca_distance(pk, 4, 4)), "0")
    fails = fails + expect("dist_0_7", str(lca_distance(pk, 0, 7)), "3")

    if fails == 0
        print("forge_lca: all passed")
    else
        print("forge_lca: " + str(fails) + " FAILED")
