import std/graph/bipartite_matching

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn main()
    // KAT 1: 3x3 graph — left 0 connects to right 0,1; left 1 to right 0; left 2 to right 2
    // Expected maximum matching = 3 (L0->R1, L1->R0, L2->R2 via augmenting paths)
    let e1 = []
    push(e1, [0, 0])
    push(e1, [0, 1])
    push(e1, [1, 0])
    push(e1, [2, 2])
    cki("max_match_3x3", bpm_max_matching(3, 3, e1), 3)

    // KAT 2: 2x2 — L0->R0, L1->R0 only; only 1 can be matched
    let e2 = []
    push(e2, [0, 0])
    push(e2, [1, 0])
    cki("max_match_2x2_contend", bpm_max_matching(2, 2, e2), 1)

    // KAT 3: 2x2 complete bipartite — max matching = 2
    let e3 = []
    push(e3, [0, 0])
    push(e3, [0, 1])
    push(e3, [1, 0])
    push(e3, [1, 1])
    cki("max_match_2x2_complete", bpm_max_matching(2, 2, e3), 2)

    // KAT 4: perfect matching — L0->R0, L1->R1
    let e4 = []
    push(e4, [0, 0])
    push(e4, [1, 1])
    ckb("is_perfect_true", bpm_is_perfect(2, 2, e4), true)

    // KAT 5: not perfect — both L0,L1 compete for R0 only
    let e5 = []
    push(e5, [0, 0])
    push(e5, [1, 0])
    ckb("is_perfect_false", bpm_is_perfect(2, 2, e5), false)

    // KAT 6: no edges — max matching = 0
    let e6 = []
    cki("max_match_empty_edges", bpm_max_matching(1, 1, e6), 0)

    // KAT 7: empty graph (left_n=0) — max matching = 0
    let e7 = []
    cki("max_match_empty_graph", bpm_max_matching(0, 0, e7), 0)

    // KAT 8: disconnected right side — L0->R0, L1 has no edges
    let e8 = []
    push(e8, [0, 0])
    cki("max_match_partial", bpm_max_matching(2, 2, e8), 1)

    // KAT 9: is_perfect when left_n != right_n — always false
    let e9 = []
    push(e9, [0, 0])
    push(e9, [0, 1])
    push(e9, [0, 2])
    ckb("is_perfect_unequal", bpm_is_perfect(1, 3, e9), false)

    // KAT 10: size-1 perfect matching
    let e10 = []
    push(e10, [0, 0])
    ckb("is_perfect_1x1", bpm_is_perfect(1, 1, e10), true)

    print("PASS _bipartite_matching_test")
