import std/poly/polygcd

fn approx(a, b, tol) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < tol
        return 1
    return 0

fn ckf(label, got, want, tol)
    if approx(got, want, tol) == 0
        print("FAIL polygcd " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL polygcd " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck_poly(label, got, want, tol)
    let lg = len(got)
    let lw = len(want)
    if lg != lw
        print("FAIL polygcd " + label + " len: got=" + str(lg) + " want=" + str(lw))
        exit(1)
    let i = 0
    while i < lw
        let gv = got[i] * 1.0
        let wv = want[i] * 1.0
        if approx(gv, wv, tol) == 0
            print("FAIL polygcd " + label + "[" + str(i) + "]: got=" + str(gv) + " want=" + str(wv))
            exit(1)
        i = i + 1

fn main()
    let eps = 0.0001

    // pg_gcd([-1,0,1], [-1,1]) = gcd(x^2-1, x-1) = x-1 = [-1.0, 1.0] monic
    let a1 = [-1, 0, 1]
    let b1 = [-1, 1]
    let g1 = pg_gcd(a1, b1)
    let w1 = [-1.0, 1.0]
    ck_poly("gcd_x2m1_xm1", g1, w1, eps)

    // pg_gcd([6,-5,1], [-6,5,-1])  (x^2-5x+6 and its negation) = [6.0,-5.0,1.0] monic
    let a2 = [6, -5, 1]
    let b2 = [-6, 5, -1]
    let g2 = pg_gcd(a2, b2)
    let w2 = [6.0, -5.0, 1.0]
    ck_poly("gcd_and_neg", g2, w2, eps)

    // pg_make_monic([2,4]) = [0.5, 1.0]  (divide by leading coeff 4 => [2/4, 4/4])
    let p3 = [2, 4]
    let m3 = pg_make_monic(p3)
    let w3 = [0.5, 1.0]
    ck_poly("make_monic_2_4", m3, w3, eps)

    // pg_is_coprime([1,1],[1,-1]) — gcd(x+1,x-1) is constant => coprime == 1
    let a4 = [1, 1]
    let b4 = [1, -1]
    let c4 = pg_is_coprime(a4, b4)
    cki("is_coprime_xp1_xm1", c4, 1)

    // pg_gcd([-6,11,-6,1],[2,-3,1])
    // (x-1)(x-2)(x-3) = [-6,11,-6,1]; (x-1)(x-2) = [2,-3,1]
    // gcd should be (x-1)(x-2) = [2,-3,1] monic
    let a5 = [-6, 11, -6, 1]
    let b5 = [2, -3, 1]
    let g5 = pg_gcd(a5, b5)
    let w5 = [2.0, -3.0, 1.0]
    ck_poly("gcd_cubic_quad", g5, w5, eps)

    // pg_gcd_degree of coprime polys == 0
    let gd6 = pg_gcd_degree(a4, b4)
    cki("gcd_degree_coprime", gd6, 0)

    // pg_gcd_degree of (x-1)(x-2)(x-3) and (x-1)(x-2) == 2
    let gd7 = pg_gcd_degree(a5, b5)
    cki("gcd_degree_cubic_quad", gd7, 2)

    // pg_degree tests
    let d8 = pg_degree([-1, 0, 1])
    cki("degree_x2m1", d8, 2)
    let d9 = pg_degree([5])
    cki("degree_const", d9, 0)
    let d10 = pg_degree([])
    cki("degree_empty", d10, -1)

    print("PASS _polygcd_test")
