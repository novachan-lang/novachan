// ============================================================================
// NOVA Standard Library — exact rational arithmetic (fractions)
// ============================================================================
// Pure NOVA (uses the gcd builtin). A rational is a [num, den] int pair, always
// stored in lowest terms with den > 0 (sign carried by num). Closes cat-11
// "Decimal / exact / rational arithmetic" for the i64 range. (For unbounded
// magnitude, the same algorithm over bignum.nova would apply — i64 here keeps
// it self-contained and fast; overflow on a*d+c*b is the documented limit.)

// construct + normalize: reduce by gcd, force den > 0, 0 -> 0/1
fn rat(n, d)
    if d == 0
        return [0, 0]                 // 0/0 sentinel: undefined
    let num = n
    let den = d
    if den < 0
        num = 0 - num
        den = 0 - den
    let g = gcd(num, den)             // gcd of (possibly-neg num, pos den) -> positive
    if g == 0
        g = 1
    return [num / g, den / g]

fn rat_num(r) -> int
    return r[0]
fn rat_den(r) -> int
    return r[1]

fn rat_add(a, b)
    return rat(a[0] * b[1] + b[0] * a[1], a[1] * b[1])

fn rat_sub(a, b)
    return rat(a[0] * b[1] - b[0] * a[1], a[1] * b[1])

fn rat_mul(a, b)
    return rat(a[0] * b[0], a[1] * b[1])

fn rat_div(a, b)
    return rat(a[0] * b[1], a[1] * b[0])

// compare a vs b: -1 / 0 / 1. Dens are positive, so cross-multiply keeps order.
fn rat_cmp(a, b) -> int
    let lhs = a[0] * b[1]
    let rhs = b[0] * a[1]
    if lhs < rhs
        return -1
    if lhs > rhs
        return 1
    return 0

fn rat_to_str(r) -> string
    if r[1] == 1
        return str(r[0])
    return str(r[0]) + "/" + str(r[1])

// ============================================================================
fn main()
    // ── construct / normalize ──
    assert_eq(rat(2, 4), [1, 2])
    assert_eq(rat(6, 3), [2, 1])
    assert_eq(rat(-1, -2), [1, 2])           // double negative
    assert_eq(rat(1, -2), [-1, 2])           // sign moves to numerator
    assert_eq(rat(0, 5), [0, 1])             // zero normalizes
    assert_eq(rat(10, 100), [1, 10])

    // ── add ──
    assert_eq(rat_add([1, 2], [1, 3]), [5, 6])
    assert_eq(rat_add([1, 2], [1, 2]), [1, 1])   // 1/2 + 1/2 = 1
    assert_eq(rat_add([2, 3], [1, 6]), [5, 6])
    assert_eq(rat_add([-1, 2], [1, 2]), [0, 1])

    // ── sub ──
    assert_eq(rat_sub([3, 4], [1, 4]), [1, 2])
    assert_eq(rat_sub([1, 3], [1, 2]), [-1, 6])

    // ── mul ──
    assert_eq(rat_mul([2, 3], [3, 4]), [1, 2])
    assert_eq(rat_mul([2, 3], [0, 1]), [0, 1])
    assert_eq(rat_mul([-2, 5], [5, 4]), [-1, 2])

    // ── div ──
    assert_eq(rat_div([1, 2], [3, 4]), [2, 3])
    assert_eq(rat_div([3, 4], [3, 4]), [1, 1])   // x/x = 1

    // ── cmp ──
    assert_eq(rat_cmp([1, 2], [2, 3]), -1)       // 1/2 < 2/3
    assert_eq(rat_cmp([2, 3], [1, 2]), 1)
    assert_eq(rat_cmp([2, 4], [1, 2]), 0)        // equal after reduce
    assert_eq(rat_cmp([-1, 2], [1, 2]), -1)

    // ── to_str ──
    assert_eq(rat_to_str([3, 1]), "3")
    assert_eq(rat_to_str([1, 2]), "1/2")
    assert_eq(rat_to_str([-1, 3]), "-1/3")

    // ── identity: 1/2 + 1/3 + 1/6 = 1 ; (a/b)*(b/a) = 1 ──
    assert_eq(rat_add(rat_add([1, 2], [1, 3]), [1, 6]), [1, 1])
    assert_eq(rat_mul([7, 9], [9, 7]), [1, 1])

    // ── harmonic-ish sum stays exact: 1/1+1/2+1/3+1/4 = 25/12 ──
    let h = rat_add(rat_add(rat_add([1, 1], [1, 2]), [1, 3]), [1, 4])
    assert_eq(h, [25, 12])

    print("rational_test passed")
