// Test: try/catch error handling in IR pipeline

fn risky_divide(a: int, b: int) -> int
    if b == 0
        error("division by zero")
        return 0
    return a / b

fn risky_lookup(items: list, idx: int) -> string
    if idx < 0 or idx >= len(items)
        error("index out of bounds")
        return ""
    return items[idx]

fn main()
    // Test 1: catch a division error
    let result = risky_divide(10, 0) catch e
        print(f"Caught error: {e}")
        -1
    print(f"Result: {result}")

    // Test 2: successful operation (no error)
    let good = risky_divide(20, 4) catch e
        print("Should not reach here")
        -1
    print(f"Good result: {good}")

    // Test 3: catch a lookup error
    let items = ["hello", "world"]
    let val = risky_lookup(items, 5) catch e
        print(f"Lookup error: {e}")
        "default"
    print(f"Lookup result: {val}")

    // Test 4: successful lookup
    let val2 = risky_lookup(items, 0) catch e
        "fallback"
    print(f"Lookup ok: {val2}")

    // Test 5: try propagates error up
    print("All error tests passed!")

main()
