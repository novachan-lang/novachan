import forge_canary_monitor

fn main()
    let s = can_new()
    assert(can_deployment_count(s) == 0, "starts empty")

    s = can_start(s, "dep-1", 10)
    assert(can_deployment_count(s) == 1, "1 deployment started")

    let st0 = can_status(s, "dep-1")
    assert(is_ok(st0) == true, "status readable")
    assert(unwrap(st0) == "running", "starts running")

    // canary performs better than baseline
    let i = 0
    while i < 9
        let r = can_record_canary(s, "dep-1", 1)
        assert(is_ok(r) == true, "canary record ok")
        i = i + 1
    let rc_fail = can_record_canary(s, "dep-1", 0)
    assert(is_ok(rc_fail) == true, "canary failure record ok")

    let j = 0
    while j < 7
        let r2 = can_record_baseline(s, "dep-1", 1)
        assert(is_ok(r2) == true, "baseline record ok")
        j = j + 1
    let k = 0
    while k < 3
        let r3 = can_record_baseline(s, "dep-1", 0)
        assert(is_ok(r3) == true, "baseline failure record ok")
        k = k + 1

    let cr = can_canary_rate(s, "dep-1")
    assert(is_ok(cr) == true, "canary rate computable")
    assert(unwrap(cr) == 90, "canary rate 90%")

    let br = can_baseline_rate(s, "dep-1")
    assert(is_ok(br) == true, "baseline rate computable")
    assert(unwrap(br) == 70, "baseline rate 70%")

    let sp = can_should_promote(s, "dep-1")
    assert(is_ok(sp) == true, "promotion decision computable")
    assert(unwrap(sp) == 1, "canary beats baseline -> promote")

    let pr = can_promote(s, "dep-1")
    assert(is_ok(pr) == true, "promote succeeds")
    let st1 = can_status(s, "dep-1")
    assert(unwrap(st1) == "promoted", "status promoted")

    let bad_record = can_record_canary(s, "dep-1", 1)
    assert(is_err(bad_record) == true, "cannot record on promoted deployment")

    // second deployment: canary underperforms -> rollback
    s = can_start(s, "dep-2", 5)
    assert(can_deployment_count(s) == 2, "2 deployments now")
    let m = 0
    while m < 5
        let rr = can_record_canary(s, "dep-2", 0)
        assert(is_ok(rr) == true, "dep-2 canary record ok")
        m = m + 1
    let n = 0
    while n < 10
        let rrb = can_record_baseline(s, "dep-2", 1)
        assert(is_ok(rrb) == true, "dep-2 baseline record ok")
        n = n + 1

    let sp2 = can_should_promote(s, "dep-2")
    assert(is_ok(sp2) == true, "dep-2 decision computable")
    assert(unwrap(sp2) == 0, "dep-2 canary underperforms -> no promote")

    let rb = can_rollback(s, "dep-2")
    assert(is_ok(rb) == true, "rollback succeeds")
    let st2 = can_status(s, "dep-2")
    assert(unwrap(st2) == "rolled_back", "status rolled_back")

    let unknown = can_status(s, "dep-999")
    assert(is_err(unknown) == true, "unknown deployment errs")

    let no_data = can_new()
    no_data = can_start(no_data, "dep-3", 20)
    let no_rate = can_canary_rate(no_data, "dep-3")
    assert(is_err(no_rate) == true, "no records yet -> rate errs")
    let no_decision = can_should_promote(no_data, "dep-3")
    assert(is_err(no_decision) == true, "no data -> decision errs")

    print("CANARY-MONITOR KAT PASS")
