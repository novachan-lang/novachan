import forge_lzw

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn joinl(xs: list) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + ","
        out = out + str(xs[i])
        i = i + 1
    out

// str() of a BOOLEAN renders true/false, not 1/0. These assertions expected "1" -- the
// behaviour from before str() learned the bool path (print already had it; str did not). When
// that was fixed the assertions started failing, and nothing noticed: they print FAIL and
// exit 0, which the regression harness counted as a PASS until 2026-08-25.
fn main()
    let fails = 0

    // exact codes for simple cases
    fails = fails + expect("enc_ab", joinl(lzw_encode("ab")), "97,98")
    fails = fails + expect("enc_aa", joinl(lzw_encode("aa")), "97,97")
    fails = fails + expect("enc_aaa", joinl(lzw_encode("aaa")), "97,256")

    // textbook example TOBEORNOTTOBEORTOBEORNOT
    let tob = "TOBEORNOTTOBEORTOBEORNOT"
    fails = fails + expect("enc_tob", joinl(lzw_encode(tob)), "84,79,66,69,79,82,78,79,84,256,258,260,265,259,261,263")

    // round-trips (decode(encode(x)) == x), incl the KwKwK repeat edge cases
    fails = fails + expect("rt_tob", lzw_decode(lzw_encode(tob)), tob)
    fails = fails + expect("rt_aaaa", lzw_decode(lzw_encode("aaaaaaaa")), "aaaaaaaa")
    fails = fails + expect("rt_abab", lzw_decode(lzw_encode("abababababab")), "abababababab")
    fails = fails + expect("rt_hello", lzw_decode(lzw_encode("hello world")), "hello world")
    fails = fails + expect("rt_single", lzw_decode(lzw_encode("x")), "x")
    fails = fails + expect("rt_mixed", lzw_decode(lzw_encode("the quick brown fox the quick")), "the quick brown fox the quick")
    fails = fails + expect("rt_empty", lzw_decode(lzw_encode("")), "")

    // compression actually shrinks repetitive data
    let big = ""
    let n = 0
    while n < 20
        big = big + "ab"
        n = n + 1
    // "abab...ab" (40 chars) should compress to well under 40 codes
    let sz = lzw_compressed_size(big)
    fails = fails + expect("shrinks", str(sz < 40),"true")
    fails = fails + expect("shrinks_rt", lzw_decode(lzw_encode(big)), big)

    if fails == 0
        print("forge_lzw: all passed")
    else
        print("forge_lzw: " + str(fails) + " FAILED")
