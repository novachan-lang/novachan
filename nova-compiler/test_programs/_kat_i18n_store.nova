import forge_i18n_store

fn main()
    let i = i18n_new("en")
    i = i18n_set(i, "en", "hello", "Hello")
    i = i18n_set(i, "en", "bye", "Goodbye")
    i = i18n_set(i, "fr", "hello", "Bonjour")
    assert(i18n_count(i) == 3, "3 strings")

    let r1 = i18n_get(i, "en", "hello")
    assert(is_ok(r1), "en hello ok")
    assert(unwrap(r1) == "Hello", "Hello")

    let r2 = i18n_get(i, "fr", "hello")
    assert(unwrap(r2) == "Bonjour", "Bonjour")

    let r3 = i18n_get(i, "fr", "bye")
    assert(is_ok(r3), "fallback to en")
    assert(unwrap(r3) == "Goodbye", "fallback value")

    let r4 = i18n_get(i, "de", "missing")
    assert(is_err(r4), "missing key is err")

    assert(i18n_has(i, "fr", "hello") == 1, "fr has hello")
    assert(i18n_has(i, "fr", "bye") == 0, "fr no bye")

    print("I18N-STORE KAT PASS")
