// KAT for std/time/duration — parse/format human durations (seconds).
import std/time/duration

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": " + str(got) + " != " + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": '" + got + "' != '" + want + "'")
        exit(1)

fn main()
    cki("p-1h30m", dur_parse("1h30m"), 5400)
    cki("p-full", dur_parse("1d2h3m4s"), 93784)
    cki("p-45s", dur_parse("45s"), 45)
    cki("p-2h", dur_parse("2h"), 7200)
    cki("p-bad", dur_parse("garbage"), -1)
    cks("f-5400", dur_format(5400), "1h30m")
    cks("f-full", dur_format(93784), "1d2h3m4s")
    cks("f-90", dur_format(90), "1m30s")
    cks("f-3600", dur_format(3600), "1h")
    cks("f-0", dur_format(0), "0s")
    cki("roundtrip", dur_parse(dur_format(93784)), 93784)
    print("_duration_test passed")
