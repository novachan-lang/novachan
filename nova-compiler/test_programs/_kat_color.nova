// KAT — std/util/color dict-oriented colour API.
// rgb/rgba/rgb_to_hex/hex_to_rgb/rgb_to_hsl/hsl_to_rgb/color_lerp/
// color_lighten/color_darken/color_invert/color_grayscale/color_distance.

import std/util/color

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label: str, got: str, want: str)
    if got != want
        print("FAIL " + label + ": got [" + got + "] want [" + want + "]")
        exit(1)

fn ckf(label: str, got: float, want: float, tol: float)
    let diff = got - want
    if diff < 0.0
        diff = 0.0 - diff
    if diff > tol
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn check_rgb(label: str, c: dict, r: int, g: int, b: int)
    cki(label + "_r", c["r"], r)
    cki(label + "_g", c["g"], g)
    cki(label + "_b", c["b"], b)

fn main()
    // ── rgb_to_hex ───────────────────────────────────────────────────────────
    let red = rgb(255, 0, 0)
    cks("hex_red", rgb_to_hex(red), "#FF0000")
    cks("hex_black", rgb_to_hex(rgb(0, 0, 0)), "#000000")
    cks("hex_white", rgb_to_hex(rgb(255, 255, 255)), "#FFFFFF")
    cks("hex_mixed", rgb_to_hex(rgb(18, 52, 86)), "#123456")

    // ── hex_to_rgb (6-digit, case-insensitive, with/without '#') ───────────────
    check_rgb("hex2rgb_6", hex_to_rgb("#00FF80"), 0, 255, 128)
    check_rgb("hex2rgb_nohash", hex_to_rgb("00ff80"), 0, 255, 128)
    // 3-digit CSS shorthand: "f0a" -> ff,00,aa
    check_rgb("hex2rgb_3", hex_to_rgb("#f0a"), 255, 0, 170)
    // malformed input -> {0,0,0}
    check_rgb("hex2rgb_bad", hex_to_rgb("#zz"), 0, 0, 0)

    // ── rgb_to_hex / hex_to_rgb round-trip ──────────────────────────────────
    let blue = rgb(0, 128, 255)
    let blue_back = hex_to_rgb(rgb_to_hex(blue))
    check_rgb("rt_blue", blue_back, 0, 128, 255)

    // ── rgb_to_hsl: canonical hues ───────────────────────────────────────────
    let hsl_red = rgb_to_hsl(rgb(255, 0, 0))
    ckf("hsl_red_h", hsl_red["h"], 0.0, 0.5)
    ckf("hsl_red_s", hsl_red["s"], 1.0, 0.01)
    ckf("hsl_red_l", hsl_red["l"], 0.5, 0.01)

    let hsl_green = rgb_to_hsl(rgb(0, 255, 0))
    ckf("hsl_green_h", hsl_green["h"], 120.0, 0.5)

    let hsl_blue = rgb_to_hsl(rgb(0, 0, 255))
    ckf("hsl_blue_h", hsl_blue["h"], 240.0, 0.5)

    // ── hsl_to_rgb round-trip ────────────────────────────────────────────────
    check_rgb("rt_hsl_red", hsl_to_rgb(hsl_red), 255, 0, 0)
    check_rgb("rt_hsl_green", hsl_to_rgb(hsl_green), 0, 255, 0)
    check_rgb("rt_hsl_blue", hsl_to_rgb(hsl_blue), 0, 0, 255)

    // ── color_lerp: midpoint of black -> white ──────────────────────────────
    let mid = color_lerp(rgb(0, 0, 0), rgb(255, 255, 255), 0.5)
    check_rgb("lerp_mid", mid, 128, 128, 128)
    // t=0 -> c1, t=1 -> c2
    check_rgb("lerp_t0", color_lerp(rgb(10, 20, 30), rgb(200, 210, 220), 0.0), 10, 20, 30)
    check_rgb("lerp_t1", color_lerp(rgb(10, 20, 30), rgb(200, 210, 220), 1.0), 200, 210, 220)

    // ── color_lighten / color_darken (via HSL lightness) ────────────────────
    let gray = rgb(128, 128, 128)
    let lighter = color_lighten(gray, 0.2)
    let darker = color_darken(gray, 0.2)
    if lighter["r"] <= gray["r"]
        print("FAIL lighten: did not increase r")
        exit(1)
    if darker["r"] >= gray["r"]
        print("FAIL darken: did not decrease r")
        exit(1)
    // clamps: lighten by 1.0 saturates to white; darken by 1.0 saturates to black.
    check_rgb("lighten_clamp", color_lighten(gray, 1.0), 255, 255, 255)
    check_rgb("darken_clamp", color_darken(gray, 1.0), 0, 0, 0)

    // ── color_invert ─────────────────────────────────────────────────────────
    check_rgb("invert", color_invert(rgb(10, 20, 30)), 245, 235, 225)
    check_rgb("invert_black", color_invert(rgb(0, 0, 0)), 255, 255, 255)

    // ── color_grayscale (Rec.601 luma weights) ──────────────────────────────
    check_rgb("gray_black", color_grayscale(rgb(0, 0, 0)), 0, 0, 0)
    let gray_white = color_grayscale(rgb(255, 255, 255))
    // 0.299+0.587+0.114 == 1.0 up to float rounding -> expect 255 (+-1).
    if gray_white["r"] < 254
        print("FAIL gray_white too dark: " + str(gray_white["r"]))
        exit(1)
    if gray_white["g"] != gray_white["r"]
        print("FAIL gray_white not achromatic")
        exit(1)
    if gray_white["b"] != gray_white["r"]
        print("FAIL gray_white not achromatic (b)")
        exit(1)
    // pure red should grayscale to ~76 (0.299 * 255)
    let gray_red = color_grayscale(rgb(255, 0, 0))
    cki("gray_red_r", gray_red["r"], 76)
    cki("gray_red_check", gray_red["g"], gray_red["r"])

    // ── color_distance (Euclidean in RGB space) ──────────────────────────────
    ckf("dist_same", color_distance(rgb(10, 20, 30), rgb(10, 20, 30)), 0.0, 0.0001)
    // black -> white: sqrt(255^2 * 3) = 441.6729...
    ckf("dist_extreme", color_distance(rgb(0, 0, 0), rgb(255, 255, 255)), 441.6729, 0.01)
    // 3-4-5 triangle scaled: (0,0,0) vs (3,4,0) -> distance 5
    ckf("dist_345", color_distance(rgb(0, 0, 0), rgb(3, 4, 0)), 5.0, 0.0001)

    print("COLOR KAT PASS")
