// SEVERE soundness: sort_by must sort correctly by STRING and FLOAT keys, not just int.
// Runtime compared keys as raw signed i64 -> string keys sorted by pointer, float keys by
// raw bits (garbage, esp. negatives). Int keys were the only correct case.
type Rec
    name: string
    score: int

fn main() -> int
    let ok = true
    let ws = sort_by(["pear", "fig", "kiwi", "apple"], fn(w) w)
    print("strings: " + str(ws))
    if str(ws[0]) != "apple" or str(ws[3]) != "pear"
        print("  FAIL string sort")
        ok = false
    let fs = sort_by([3.5, 1.5, 2.5, 0.5], fn(x) x)
    print("floats: " + str(fs))
    if str(fs[0]) != "0.5" or str(fs[3]) != "3.5"
        print("  FAIL float sort")
        ok = false
    let ns = sort_by([2.0, 0.0 - 1.0, 0.0 - 3.0, 1.0], fn(x) x)
    print("negfloats: " + str(ns))
    if str(ns[0]) != "-3" and str(ns[0]) != "-3.0"
        print("  FAIL negfloat sort")
        ok = false
    let xs = sort_by([5, 2, 8, 1], fn(x) x)
    if xs[0] != 1 or xs[3] != 8
        print("  FAIL int sort")
        ok = false
    let nis = sort_by([3, 0 - 5, 0, 0 - 1], fn(x) x)
    if nis[0] != (0 - 5) or nis[3] != 3
        print("  FAIL negint sort")
        ok = false
    // Most common real case: sort RECORDS by a struct STRING field.
    let recs = [Rec("charlie", 30), Rec("alice", 10), Rec("bob", 20)]
    let byname = sort_by(recs, fn(r) r.name)
    print("byname: " + byname[0].name + "," + byname[1].name + "," + byname[2].name)
    if byname[0].name != "alice" or byname[2].name != "charlie"
        print("  FAIL struct string-field sort")
        ok = false
    // sort RECORDS by a struct INT field
    let byscore = sort_by(recs, fn(r) r.score)
    if byscore[0].score != 10 or byscore[2].score != 30
        print("  FAIL struct int-field sort")
        ok = false
    if ok
        print("SORT-BY-KEYS KAT PASS")
        return 0
    print("SORT-BY-KEYS KAT FAIL")
    1
