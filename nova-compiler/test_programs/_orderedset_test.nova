import std/collections/orderedset

// Helper: compare two lists as comma-joined strings
fn list_eq(got, want)
    if len(got) != len(want)
        return 0
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            return 0
        i = i + 1
    return 1

fn list_str(lst)
    let s = "["
    let i = 0
    while i < len(lst)
        if i > 0
            s = s + ","
        s = s + lst[i]
        i = i + 1
    s = s + "]"
    return s

// KAT 1: add c,a,b,a -> items() = ["c","a","b"]  (dup "a" ignored)
let os1 = os_new()
os_add(os1, "c")
os_add(os1, "a")
os_add(os1, "b")
os_add(os1, "a")
let want1 = ["c","a","b"]
if list_eq(os_items(os1), want1) == 0
    print("FAIL KAT1 items after dup add: got " + list_str(os_items(os1)) + " want [c,a,b]")
    exit(1)

// KAT 2: has("a") = true (1)
if os_has(os1, "a") != 1
    print("FAIL KAT2 has(a) should be 1")
    exit(1)

// KAT 3: has("z") = false (0)
if os_has(os1, "z") != 0
    print("FAIL KAT3 has(z) should be 0")
    exit(1)

// KAT 4: len = 3
if os_len(os1) != 3
    print("FAIL KAT4 len should be 3 got " + str(os_len(os1)))
    exit(1)

// KAT 5: remove("a") -> items() = ["c","b"]
os_remove(os1, "a")
let want5 = ["c","b"]
if list_eq(os_items(os1), want5) == 0
    print("FAIL KAT5 items after remove(a): got " + list_str(os_items(os1)) + " want [c,b]")
    exit(1)

// KAT 6: union of {a,b} and {b,c} = [a,b,c]
let setA = os_new()
os_add(setA, "a")
os_add(setA, "b")
let setB = os_new()
os_add(setB, "b")
os_add(setB, "c")
let u = os_union(setA, setB)
let want6 = ["a","b","c"]
if list_eq(os_items(u), want6) == 0
    print("FAIL KAT6 union: got " + list_str(os_items(u)) + " want [a,b,c]")
    exit(1)

// KAT 7: intersect of {a,b,c} and {b,c,d} = [b,c]
let setABC = os_new()
os_add(setABC, "a")
os_add(setABC, "b")
os_add(setABC, "c")
let setBCD = os_new()
os_add(setBCD, "b")
os_add(setBCD, "c")
os_add(setBCD, "d")
let inter = os_intersect(setABC, setBCD)
let want7 = ["b","c"]
if list_eq(os_items(inter), want7) == 0
    print("FAIL KAT7 intersect: got " + list_str(os_items(inter)) + " want [b,c]")
    exit(1)

// KAT 8: difference {a,b,c} minus {b} = [a,c]
let setB2 = os_new()
os_add(setB2, "b")
let diff = os_difference(setABC, setB2)
let want8 = ["a","c"]
if list_eq(os_items(diff), want8) == 0
    print("FAIL KAT8 difference: got " + list_str(os_items(diff)) + " want [a,c]")
    exit(1)

print("_orderedset_test passed")
