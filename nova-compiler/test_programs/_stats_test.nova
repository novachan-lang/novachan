// KAT for std/math/stats — descriptive statistics (float compares use an epsilon; never == on floats).
import std/math/stats

fn ckf(label: string, got: float, want: float)
    let d = got - want
    if d < 0.0
        d = 0.0 - d
    if d > 0.001
        print("FAIL " + label + ": " + str(got) + " != " + str(want))
        exit(1)

fn main()
    let xs = [1, 2, 3, 4, 5]
    ckf("sum", stats_sum(xs), 15.0)
    ckf("mean", stats_mean(xs), 3.0)
    ckf("min", stats_min(xs), 1.0)
    ckf("max", stats_max(xs), 5.0)
    ckf("median", stats_median(xs), 3.0)
    ckf("variance", stats_variance(xs), 2.0)
    ckf("stddev", stats_stddev(xs), 1.4142135)
    ckf("p50", stats_percentile(xs, 50), 3.0)
    ckf("p0", stats_percentile(xs, 0), 1.0)
    ckf("p100", stats_percentile(xs, 100), 5.0)
    let ev = [1, 2, 3, 4]
    ckf("median-even", stats_median(ev), 2.5)
    let fx = [1.5, 2.5, 3.5]
    ckf("mean-float", stats_mean(fx), 2.5)
    let empty = []
    ckf("empty-mean", stats_mean(empty), 0.0)
    ckf("empty-median", stats_median(empty), 0.0)
    print("_stats_test passed")
