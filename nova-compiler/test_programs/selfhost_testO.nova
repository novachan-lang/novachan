// Test: comprehensive - all features working together
// Simulates a mini calculator parser/evaluator

type Expr
    tag: string
    value: int
    left: Expr
    right: Expr

fn make_num(n: int) -> Expr
    Expr("num", n, null, null)

fn make_add(l: Expr, r: Expr) -> Expr
    Expr("add", 0, l, r)

fn make_mul(l: Expr, r: Expr) -> Expr
    Expr("mul", 0, l, r)

fn eval_expr(e: Expr) -> int
    match e
        Expr(tag, value, left, right) =>
            if tag == "num"
                return value
            else if tag == "add"
                return eval_expr(left) + eval_expr(right)
            else if tag == "mul"
                return eval_expr(left) * eval_expr(right)
    return 0

fn expr_to_string(e: Expr) -> string
    match e
        Expr(tag, value, left, right) =>
            if tag == "num"
                return str(value)
            else if tag == "add"
                return "(" + expr_to_string(left) + " + " + expr_to_string(right) + ")"
            else if tag == "mul"
                return "(" + expr_to_string(left) + " * " + expr_to_string(right) + ")"
    return "?"

// Build: (3 + 4) * (2 + 5)
let e1 = make_add(make_num(3), make_num(4))
let e2 = make_add(make_num(2), make_num(5))
let e3 = make_mul(e1, e2)

print(expr_to_string(e3))
print(eval_expr(e3))

// Build: 10 + (20 * 3)
let e4 = make_add(make_num(10), make_mul(make_num(20), make_num(3)))
print(expr_to_string(e4))
print(eval_expr(e4))
