import forge_charclass

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // is_digit
    fails = fails + expect("d_5", str(is_digit("5")), "true")
    fails = fails + expect("d_a", str(is_digit("a")), "false")

    // is_alpha
    fails = fails + expect("a_a", str(is_alpha("a")), "true")
    fails = fails + expect("a_Z", str(is_alpha("Z")), "true")
    fails = fails + expect("a_5", str(is_alpha("5")), "false")
    fails = fails + expect("a_sp", str(is_alpha(" ")), "false")

    // is_alnum
    fails = fails + expect("an_a", str(is_alnum("a")), "true")
    fails = fails + expect("an_5", str(is_alnum("5")), "true")
    fails = fails + expect("an_dash", str(is_alnum("-")), "false")

    // upper/lower
    fails = fails + expect("up_A", str(is_upper("A")), "true")
    fails = fails + expect("up_a", str(is_upper("a")), "false")
    fails = fails + expect("lo_a", str(is_lower("a")), "true")
    fails = fails + expect("lo_A", str(is_lower("A")), "false")

    // whitespace
    fails = fails + expect("ws_sp", str(is_whitespace(" ")), "true")
    fails = fails + expect("ws_tab", str(is_whitespace(chr(9))), "true")
    fails = fails + expect("ws_nl", str(is_whitespace(chr(10))), "true")
    fails = fails + expect("ws_a", str(is_whitespace("a")), "false")

    // punct
    fails = fails + expect("p_dash", str(is_punct("-")), "true")
    fails = fails + expect("p_at", str(is_punct("@")), "true")
    fails = fails + expect("p_a", str(is_punct("a")), "false")
    fails = fails + expect("p_sp", str(is_punct(" ")), "false")

    // case conversion
    fails = fails + expect("tu_a", to_upper_char("a"), "A")
    fails = fails + expect("tu_A", to_upper_char("A"), "A")
    fails = fails + expect("tu_5", to_upper_char("5"), "5")
    fails = fails + expect("tl_A", to_lower_char("A"), "a")
    fails = fails + expect("tl_dash", to_lower_char("-"), "-")

    if fails == 0
        print("forge_charclass: all passed")
    else
        print("forge_charclass: " + str(fails) + " FAILED")
