// _utm_zone_test.nova — KAT for std/geo/utm_zone
import std/geo/utm_zone

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got='" + got + "' want='" + expected + "'")
        exit(1)

fn ckb(label, got, expected)
    let gi = 0
    if got
        gi = 1
    let ei = 0
    if expected
        ei = 1
    if gi != ei
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(ei))
        exit(1)

fn ckf(label, got, expected, eps)
    let diff = got - expected
    let adiff = diff
    if diff < 0.0
        adiff = 0.0 - diff
    if adiff > eps
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(expected))
        exit(1)

fn main()
    // uz_zone: Munich lon=11.60833 -> zone 32
    cki("uz_zone Munich", uz_zone(11.60833), 32)

    // uz_zone: -180 -> 1
    cki("uz_zone -180", uz_zone(-180.0), 1)

    // uz_zone: 180 -> clamp to 60
    cki("uz_zone 180", uz_zone(180.0), 60)

    // uz_zone: 0.0 -> zone 31 (range 0..6, formula: floor(180/6)+1=31)
    cki("uz_zone 0", uz_zone(0.0), 31)

    // uz_band: lat=48.14 -> 'U' (48+80=128, 128/8=16 -> index 16 -> letter 'U' in CDEFGHJKLMNPQRSTUVWX)
    // Letters: C=0,D=1,E=2,F=3,G=4,H=5,J=6,K=7,L=8,M=9,N=10,P=11,Q=12,R=13,S=14,T=15,U=16,V=17,W=18,X=19
    cks("uz_band 48.14", uz_band(48.14), "U")

    // uz_band: lat=0.0 -> 'N' (0+80=80, 80/8=10 -> index 10 -> 'N')
    cks("uz_band 0.0", uz_band(0.0), "N")

    // uz_band: lat=-80.0 -> 'C' (first band)
    cks("uz_band -80.0", uz_band(-80.0), "C")

    // uz_designator: Munich 48.14N 11.60E -> '32U'
    cks("uz_designator Munich", uz_designator(48.14, 11.60), "32U")

    // uz_zone_lon_center: zone 32 -> (32-1)*6 - 180 + 3 = 186-180+3 = 9.0
    ckf("uz_zone_lon_center 32", uz_zone_lon_center(32), 9.0, 0.001)

    // uz_zone_bounds: zone 31 -> west=0, east=6
    let b31 = uz_zone_bounds(31)
    let b31w = b31[0] * 1
    let b31e = b31[1] * 1
    cki("uz_zone_bounds 31 west", b31w, 0)
    cki("uz_zone_bounds 31 east", b31e, 6)

    // uz_is_northern: 48.0 -> true
    ckb("uz_is_northern 48", uz_is_northern(48.0), true)

    // uz_is_northern: -33.0 -> false
    ckb("uz_is_northern -33", uz_is_northern(-33.0), false)

    // uz_hemisphere: -33.0 -> 'S'
    cks("uz_hemisphere -33", uz_hemisphere(-33.0), "S")

    // uz_hemisphere: 0.0 -> 'N'
    cks("uz_hemisphere 0", uz_hemisphere(0.0), "N")

    // uz_valid_zone: 1 -> true
    ckb("uz_valid_zone 1", uz_valid_zone(1), true)

    // uz_valid_zone: 60 -> true
    ckb("uz_valid_zone 60", uz_valid_zone(60), true)

    // uz_valid_zone: 0 -> false
    ckb("uz_valid_zone 0", uz_valid_zone(0), false)

    // uz_valid_zone: 61 -> false
    ckb("uz_valid_zone 61", uz_valid_zone(61), false)

    // uz_norway_exception: Svalbard test: lat=76, lon=15 -> zone 33
    cki("uz_norway lon=15", uz_norway_exception(76.0, 15.0), 33)

    // uz_norway_exception: Norway coast: lat=60, lon=5 -> zone 32
    cki("uz_norway coast", uz_norway_exception(60.0, 5.0), 32)

    // uz_norway_exception: outside exception: lat=50, lon=5 -> standard zone 31
    cki("uz_norway standard", uz_norway_exception(50.0, 5.0), 31)

    // Edge: lat=72.0 exactly -> band X
    cks("uz_band 72.0", uz_band(72.0), "X")

    // Edge: lat=84.0 -> band X
    cks("uz_band 84.0", uz_band(84.0), "X")

    // Round-trip: zone_bounds -> zone_lon_center is midpoint
    let b32 = uz_zone_bounds(32)
    let b32w = b32[0] * 1.0
    let b32e = b32[1] * 1.0
    let mid32 = (b32w + b32e) / 2.0
    ckf("uz_zone_bounds/center 32", uz_zone_lon_center(32), mid32, 0.001)

    print("PASS _utm_zone_test")
