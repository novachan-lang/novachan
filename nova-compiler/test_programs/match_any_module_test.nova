// match_any_module_test -- permanent guard for the compiler fix: `match Ok/Err` on an any-typed value
// (from a `-> any` fn) inside a MODULE function must dispatch to the correct arm. Before the fix it
// mis-resolved Ok to a struct type-name-hash and fired NEITHER arm. mr_classify lives in the imported
// module _match_any_mod (the bug only manifested for a module function, not inline in main).
import _match_any_mod

fn main()
    assert_eq(mr_classify(5), "ok:50")
    assert_eq(mr_classify(0), "err:neg")
    assert_eq(mr_classify(-3), "err:neg")
    print("match_any_module_test passed")
