import std/net/dns_name

// ── Helpers ──────────────────────────────────────────────────────────────────

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL dns_name " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL dns_name " + label + ": got " + got + " want " + want)
        exit(1)

fn ckb(label: string, got: bytes, want: bytes)
    if bytes_len(got) != bytes_len(want)
        print("FAIL dns_name " + label + ": len got=" + str(bytes_len(got)) + " want=" + str(bytes_len(want)))
        exit(1)
    let i = 0
    while i < bytes_len(want)
        if bytes_get(got, i) != bytes_get(want, i)
            print("FAIL dns_name " + label + ": byte[" + str(i) + "] got=" + str(bytes_get(got, i)) + " want=" + str(bytes_get(want, i)))
            exit(1)
        i = i + 1

// ── Build known-answer bytes for "example.com" ───────────────────────────────
// Expected wire: [7,101,120,97,109,112,108,101,3,99,111,109,0]  (13 bytes)

fn make_example_com_bytes() -> bytes
    let w = bytes(0)
    w = bytes_append(w, 7)
    w = bytes_append(w, 101)
    w = bytes_append(w, 120)
    w = bytes_append(w, 97)
    w = bytes_append(w, 109)
    w = bytes_append(w, 112)
    w = bytes_append(w, 108)
    w = bytes_append(w, 101)
    w = bytes_append(w, 3)
    w = bytes_append(w, 99)
    w = bytes_append(w, 111)
    w = bytes_append(w, 109)
    w = bytes_append(w, 0)
    w

// ── Build known-answer bytes for "www.a.io" ──────────────────────────────────
// [3,119,119,119, 1,97, 2,105,111, 0]  (10 bytes)

fn make_www_a_io_bytes() -> bytes
    let w = bytes(0)
    w = bytes_append(w, 3)
    w = bytes_append(w, 119)
    w = bytes_append(w, 119)
    w = bytes_append(w, 119)
    w = bytes_append(w, 1)
    w = bytes_append(w, 97)
    w = bytes_append(w, 2)
    w = bytes_append(w, 105)
    w = bytes_append(w, 111)
    w = bytes_append(w, 0)
    w

// ── Construct compression-pointer message ────────────────────────────────────
// Layout:
//   [0..12]  = encoded "example.com" (13 bytes)
//   [13..19] = 7 padding bytes (zeroed)
//   [20..21] = pointer 0xC0,0x00 -> offset 0
// Total: 22 bytes

fn make_ptr_msg() -> bytes
    let w = bytes(0)
    // bytes 0..12: example.com wire
    w = bytes_append(w, 7)
    w = bytes_append(w, 101)
    w = bytes_append(w, 120)
    w = bytes_append(w, 97)
    w = bytes_append(w, 109)
    w = bytes_append(w, 112)
    w = bytes_append(w, 108)
    w = bytes_append(w, 101)
    w = bytes_append(w, 3)
    w = bytes_append(w, 99)
    w = bytes_append(w, 111)
    w = bytes_append(w, 109)
    w = bytes_append(w, 0)
    // bytes 13..19: padding
    w = bytes_append(w, 0)
    w = bytes_append(w, 0)
    w = bytes_append(w, 0)
    w = bytes_append(w, 0)
    w = bytes_append(w, 0)
    w = bytes_append(w, 0)
    w = bytes_append(w, 0)
    // bytes 20..21: pointer to offset 0
    w = bytes_append(w, 192)
    w = bytes_append(w, 0)
    w

fn main()
    // ── Test 1: encode "example.com" exact bytes ─────────────────────────────
    let enc = dns_name_encode("example.com")
    let want_ec = make_example_com_bytes()
    cki("encode_example_com_len", bytes_len(enc), 13)
    ckb("encode_example_com_bytes", enc, want_ec)

    // ── Test 2: decode "example.com" from offset 0 ───────────────────────────
    let dec = dns_name_decode(enc, 0)
    cks("decode_example_com_name", dec[0], "example.com")
    cki("decode_example_com_pos", dec[1], 13)

    // ── Test 3: compression pointer at offset 20 -> ["example.com", 22] ──────
    let pmsg = make_ptr_msg()
    cki("ptr_msg_len", bytes_len(pmsg), 22)
    let pdec = dns_name_decode(pmsg, 20)
    cks("ptr_decode_name", pdec[0], "example.com")
    cki("ptr_decode_pos", pdec[1], 22)

    // ── Test 4: encode/decode round-trip "www.a.io" ──────────────────────────
    let enc2 = dns_name_encode("www.a.io")
    let want_wai = make_www_a_io_bytes()
    cki("encode_www_a_io_len", bytes_len(enc2), 10)
    ckb("encode_www_a_io_bytes", enc2, want_wai)
    let dec2 = dns_name_decode(enc2, 0)
    cks("decode_www_a_io_name", dec2[0], "www.a.io")
    cki("decode_www_a_io_pos", dec2[1], 10)

    // ── Test 5: direct decode of "example.com" from the ptr-msg at offset 0 ──
    let dec3 = dns_name_decode(pmsg, 0)
    cks("ptr_msg_offset0_name", dec3[0], "example.com")
    cki("ptr_msg_offset0_pos", dec3[1], 13)

    // ── Test 6: empty name -> single 0x00 ────────────────────────────────────
    let enc_root = dns_name_encode("")
    cki("root_len", bytes_len(enc_root), 1)
    cki("root_byte0", bytes_get(enc_root, 0), 0)

    // ── Test 7: decode root name ("") from a single 0x00 byte ────────────────
    let dec_root = dns_name_decode(enc_root, 0)
    cks("root_decode_name", dec_root[0], "")
    cki("root_decode_pos", dec_root[1], 1)

    // ── Test 8: out-of-bounds decode returns safe empty ───────────────────────
    let oob = dns_name_decode(enc, 100)
    cks("oob_name", oob[0], "")

    print("PASS _dns_name_test")
