import std/text/urlx

// Validation test for the urlx module's public functions.
// Each asserted result is computed by hand from urlx.nova's source.
fn main()
    // url_encode: RFC 3986; space -> %20; unreserved kept; others %XX (upper hex)
    assert(urlx.url_encode("hello world") == "hello%20world", "encode space")
    assert(urlx.url_encode("aA0-_.~") == "aA0-_.~", "encode all unreserved")
    assert(urlx.url_encode("a+b=c") == "a%2Bb%3Dc", "encode plus and equals")

    // url_decode: %XX (any case) -> byte; '+' -> space; malformed passes through
    assert(urlx.url_decode("hello%20world") == "hello world", "decode percent20")
    assert(urlx.url_decode("a+b") == "a b", "decode plus to space")
    assert(urlx.url_decode("%zz") == "%zz", "decode malformed passes through")

    // round-trip
    assert(urlx.url_decode(urlx.url_encode("a b/c?d=e&f")) == "a b/c?d=e&f", "encode/decode round-trip")

    // html_escape: anti-XSS output encoding
    assert(urlx.html_escape("a&b<c>d") == "a&amp;b&lt;c&gt;d", "html_escape entities")
    assert(urlx.html_escape("safe text 123") == "safe text 123", "html_escape no-op on safe text")

    // parse_query -> dict (keys/values url_decoded)
    let q = urlx.parse_query("a=1&b=hello%20world&c=")
    assert(q["a"] == "1", "parse_query simple value")
    assert(q["b"] == "hello world", "parse_query decoded value")
    assert(q["c"] == "", "parse_query empty value")

    // build_query: list of [k, v] -> "k=v&..." (each piece encoded)
    assert(urlx.build_query([["a", "1"], ["b", "x y"]]) == "a=1&b=x%20y", "build_query encodes value")

    // uri_parse: split into components
    let u = urlx.uri_parse("http://host/path")
    assert(u["scheme"] == "http", "uri_parse scheme")
    assert(u["host"] == "host", "uri_parse host")
    assert(u["path"] == "/path", "uri_parse path")
    assert(u["port"] == "", "uri_parse missing port is empty")

    print("urlx_lib_test passed")
