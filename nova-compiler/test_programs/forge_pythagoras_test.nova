import forge_pythagoras as py

fn check(cond: bool, label: string)
    if cond == false
        print("FAIL: " + label)

fn my_gcd(a: int, b: int) -> int
    let x = a
    let y = b
    while y != 0
        let t = x % y
        x = y
        y = t
    if x < 0
        x = 0 - x
    x

// brute-force reference count of triples a<b<c<=maxc with a^2+b^2==c^2
fn brute_count(maxc: int) -> int
    let cnt = 0
    let a = 1
    while a <= maxc
        let b = a + 1
        while b <= maxc
            let c2 = a * a + b * b
            // integer sqrt of c2
            let c = 1
            while c * c < c2
                c = c + 1
            if c * c == c2 and c <= maxc and c > b
                cnt = cnt + 1
            b = b + 1
        a = a + 1
    cnt

// does the flat triple list contain [a,b,c]?
fn contains_triple(flat: list, a: int, b: int, c: int) -> bool
    let out = false
    let i = 0
    while i < len(flat)
        if flat[i] == a and flat[i + 1] == b and flat[i + 2] == c
            out = true
        i = i + 3
    out

fn main()
    // ---- is_pythagorean ----
    check(py.is_pythagorean(3, 4, 5), "3,4,5")
    check(py.is_pythagorean(5, 12, 13), "5,12,13")
    check(py.is_pythagorean(8, 15, 17), "8,15,17")
    check(py.is_pythagorean(6, 8, 10), "6,8,10")
    check(py.is_pythagorean(3, 4, 6) == false, "3,4,6 not")
    check(py.is_pythagorean(0, 4, 5) == false, "0 side not")

    // ---- pythagorean_triples up to 25: known members present ----
    let t25 = py.pythagorean_triples(25)
    check(contains_triple(t25, 3, 4, 5), "has 3,4,5")
    check(contains_triple(t25, 6, 8, 10), "has 6,8,10")
    check(contains_triple(t25, 5, 12, 13), "has 5,12,13")
    check(contains_triple(t25, 9, 12, 15), "has 9,12,15")
    check(contains_triple(t25, 8, 15, 17), "has 8,15,17")
    check(contains_triple(t25, 12, 16, 20), "has 12,16,20")
    check(contains_triple(t25, 7, 24, 25), "has 7,24,25")
    check(contains_triple(t25, 15, 20, 25), "has 15,20,25")

    // every emitted triple must be valid, ordered a<b<c, c<=max, and sorted by (c,b,a)
    let prevc = 0
    let prevb = 0
    let preva = 0
    let i = 0
    while i < len(t25)
        let a = t25[i]
        let b = t25[i + 1]
        let c = t25[i + 2]
        check(py.is_pythagorean(a, b, c), "t25 valid at " + str(i))
        check(a < b and b < c, "t25 ordered a<b<c at " + str(i))
        check(c <= 25, "t25 c<=25 at " + str(i))
        // non-decreasing by (c,b,a)
        let ok_order = false
        if c > prevc
            ok_order = true
        else
            if c == prevc and b > prevb
                ok_order = true
            else
                if c == prevc and b == prevb and a >= preva
                    ok_order = true
        check(ok_order, "t25 sorted at " + str(i))
        preva = a
        prevb = b
        prevc = c
        i = i + 3

    // ---- count must match brute-force reference (Euclid vs enumeration) ----
    check(len(py.pythagorean_triples(30)) / 3 == brute_count(30), "count matches brute @30")
    check(len(py.pythagorean_triples(60)) / 3 == brute_count(60), "count matches brute @60")
    check(len(py.pythagorean_triples(100)) / 3 == brute_count(100), "count matches brute @100")

    // ---- no duplicates in the @60 list ----
    let t60 = py.pythagorean_triples(60)
    let d = 0
    while d < len(t60)
        let e = d + 3
        while e < len(t60)
            let dup = t60[d] == t60[e] and t60[d + 1] == t60[e + 1] and t60[d + 2] == t60[e + 2]
            check(dup == false, "no dup @60 " + str(d) + "," + str(e))
            e = e + 3
        d = d + 3

    // ---- primitive triples: each must be valid AND gcd(a,b)==1 ----
    let p50 = py.primitive_pythagorean_triples(50)
    check(contains_triple(p50, 3, 4, 5), "prim has 3,4,5")
    check(contains_triple(p50, 5, 12, 13), "prim has 5,12,13")
    check(contains_triple(p50, 8, 15, 17), "prim has 8,15,17")
    check(contains_triple(p50, 20, 21, 29), "prim has 20,21,29")
    check(contains_triple(p50, 6, 8, 10) == false, "prim NOT 6,8,10 (multiple)")
    let pj = 0
    while pj < len(p50)
        let a = p50[pj]
        let b = p50[pj + 1]
        let c = p50[pj + 2]
        check(py.is_pythagorean(a, b, c), "prim valid at " + str(pj))
        check(my_gcd(a, b) == 1, "prim gcd(a,b)==1 at " + str(pj))
        pj = pj + 3

    print("forge_pythagoras: all passed")
