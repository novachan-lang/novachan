// KAT test for std/text/boyermoore
import std/text/boyermoore

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got [" + got + "] expected [" + expected + "]")
        exit(1)

fn ck_list_len(label, lst, want)
    let n = len(lst)
    if n != want
        print("FAIL " + label + "_len: got " + str(n) + " expected " + str(want))
        exit(1)

fn ck_list_elem(label, lst, idx, want)
    let v = lst[idx]
    if v != want
        print("FAIL " + label + "[" + str(idx) + "]: got " + str(v) + " expected " + str(want))
        exit(1)

fn main()
    // ── KAT 1: bm_search first occurrence (6-char pattern) ───────────────────
    // "abxabcabcaby" contains "abcaby" starting at index 6.
    cki("search_abcaby", bm_search("abxabcabcaby", "abcaby"), 6)

    // ── KAT 2: bm_search two-char pattern ────────────────────────────────────
    // "hello" contains "ll" starting at index 2.
    cki("search_ll_in_hello", bm_search("hello", "ll"), 2)

    // ── KAT 3: bm_search absent pattern returns -1 ───────────────────────────
    cki("search_absent", bm_search("abc", "xyz"), -1)

    // ── KAT 4: bm_search_all overlapping matches ──────────────────────────────
    // "aaaa" contains "aa" at positions 0, 1, 2 (overlapping).
    let all4 = bm_search_all("aaaa", "aa")
    ck_list_len("search_all_aaaa_aa", all4, 3)
    ck_list_elem("search_all_aaaa_aa", all4, 0, 0)
    ck_list_elem("search_all_aaaa_aa", all4, 1, 1)
    ck_list_elem("search_all_aaaa_aa", all4, 2, 2)

    // ── KAT 5: bm_count overlapping occurrences ───────────────────────────────
    // "mississippi" contains "issi" at index 1 and 4 => count 2.
    cki("count_issi", bm_count("mississippi", "issi"), 2)

    // ── KAT 6: bm_search with offset in haystack string ──────────────────────
    // "needle in haystack": h=10 a=11 y=12 => "hay" starts at index 10.
    cki("search_hay_in_haystack", bm_search("needle in haystack", "hay"), 10)

    // ── KAT 7: bm_search single-char pattern ─────────────────────────────────
    cki("search_single_char", bm_search("abcdef", "d"), 3)

    // ── KAT 8: bm_search pattern equals text ─────────────────────────────────
    cki("search_exact_match", bm_search("nova", "nova"), 0)

    // ── KAT 9: bm_search_all no match returns empty list ─────────────────────
    let all9 = bm_search_all("hello", "xyz")
    ck_list_len("search_all_no_match", all9, 0)

    // ── KAT 10: bm_count no match returns 0 ──────────────────────────────────
    cki("count_no_match", bm_count("abcde", "xyz"), 0)

    // ── KAT 11: bm_search pattern longer than text returns -1 ────────────────
    cki("search_pat_longer", bm_search("ab", "abcd"), -1)

    // ── KAT 12: bm_search_all multiple non-overlapping matches ───────────────
    // "abababab" contains "ab" at 0,2,4,6.
    let all12 = bm_search_all("abababab", "ab")
    ck_list_len("search_all_ab", all12, 4)
    ck_list_elem("search_all_ab", all12, 0, 0)
    ck_list_elem("search_all_ab", all12, 1, 2)
    ck_list_elem("search_all_ab", all12, 2, 4)
    ck_list_elem("search_all_ab", all12, 3, 6)

    print("_boyermoore_test passed")
