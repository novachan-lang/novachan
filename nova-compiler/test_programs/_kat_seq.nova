import std/core/seq

fn main() -> int
    let fails = 0
    let xs = [1, 2, 3, 4, 5]
    // fold: sum via a closure argument
    let sum = seq_fold(xs, 0, fn(a, x) a + x)
    if sum != 15
        print("FAIL fold sum=" + str(sum))
        fails = fails + 1
    // reduce -> Result, matched
    match seq_reduce(xs, fn(a, x) a + x)
        Ok(v) =>
            if v != 15
                print("FAIL reduce v=" + str(v))
                fails = fails + 1
        Err(e) =>
            print("FAIL reduce err " + e)
            fails = fails + 1
    // reduce on empty -> Err
    let empty = seq_drop(xs, 99)
    match seq_reduce(empty, fn(a, x) a + x)
        Ok(v) =>
            print("FAIL reduce empty should Err")
            fails = fails + 1
        Err(e) =>
            print("ok: reduce empty -> Err")
    // find -> Result
    match seq_find(xs, fn(x) x > 3)
        Ok(v) =>
            if v != 4
                print("FAIL find v=" + str(v))
                fails = fails + 1
        Err(e) =>
            print("FAIL find")
            fails = fails + 1
    // any / all / count
    if not seq_any(xs, fn(x) x == 3)
        print("FAIL any")
        fails = fails + 1
    if seq_all(xs, fn(x) x > 2)
        print("FAIL all (should be false)")
        fails = fails + 1
    if seq_count(xs, fn(x) x % 2 == 0) != 2
        print("FAIL count")
        fails = fails + 1
    // take / drop / zip / reverse
    if len(seq_take(xs, 3)) != 3
        print("FAIL take")
        fails = fails + 1
    if len(seq_drop(xs, 2)) != 3
        print("FAIL drop")
        fails = fails + 1
    if len(seq_zip(xs, [10, 20])) != 2
        print("FAIL zip")
        fails = fails + 1
    let rv = seq_reverse(xs)
    if rv[0] != 5
        print("FAIL reverse")
        fails = fails + 1
    if fails == 0
        print("PASS _kat_seq")
    else
        print("FAILED _kat_seq")
    return 0
