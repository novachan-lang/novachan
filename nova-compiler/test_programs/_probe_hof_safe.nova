// Which HIGH-LEVEL idioms are SAFE for Result-returning mappers?
// `?` inside a lambda/comprehension silently corrupts (see _probe_hof_err.nova),
// so establish the correct high-level idiom to use instead.

import prism_ui_kit
import prism_content
import prism_node

fn mk(s: string) -> Result<string>
    if len(s) == 0
        return err("REJECTED_EMPTY")
    ok("<" + s + ">")

// S1 — prism_ui_collect: the existing traverse (map over Result). Does it propagate?
fn s1_ok() -> Result<list>
    prism_ui_kit.prism_ui_collect(["a", "b"], fn(s) prism_content.prism_label(s))

fn s1_err() -> Result<list>
    prism_ui_kit.prism_ui_collect(["a", ""], fn(s) prism_content.prism_label(s))

// S2 — map WITHOUT `?`, then check the list of Results explicitly (any_match)
fn s2(items: list) -> Result<list>
    let rs = items.map(fn(s) mk(s))
    if rs.any_match(fn(r) is_err(r))
        return err("at least one failed")
    ok(rs.map(fn(r) unwrap(r)))

// S3 — validate-first, then map with plain unwrap (safe because validated)
fn s3(items: list) -> Result<list>
    if items.any_match(fn(s) len(s) == 0)
        return err("empty element rejected")
    ok(items.map(fn(s) unwrap(mk(s))))

fn report(name: string, r: Result<list>)
    if is_ok(r)
        let l = unwrap(r)
        let kinds = l.map(fn(v) str(v))
        print("{name}: ok  len={len(l)}  v0={kinds[0]}")
    else
        print("{name}: ERR propagated = {unwrap_err(r)}")

fn main()
    print("== SAFE high-level idioms for Result mappers ==")

    let a = s1_ok()
    print("S1 collect happy : is_ok={is_ok(a)} len={len(unwrap(a))}")
    let b = s1_err()
    print("S1 collect error : is_err={is_err(b)} err={unwrap_err(b) if is_err(b) else \"NONE-LEAKED\"}")

    report("S2 map+any_match ok ", s2(["a", "b"]))
    report("S2 map+any_match err", s2(["a", ""]))
    report("S3 validate-then-map", s3(["a", "b"]))
    report("S3 validate rejects ", s3(["a", ""]))
    print("== DONE ==")
