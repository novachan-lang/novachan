// _move_arena_uaf_test -- regression guard for the arena-escape UAF in the channel MOVE-send and try_send
// paths (P0 from the 2026-06-20 concurrency review). A value built inside an active per-request/message
// arena and sent across the channel boundary must be materialized on the RC heap; otherwise arena_exit
// frees it wholesale and the receiver reads dangling memory (cross-task UAF). Deterministic + single-task:
// send -> arena_exit (frees the chunk) -> recv + read. Old code: the read is a heap-use-after-free (ASAN).
// Fixed: recv returns a valid RC-heap copy. Run under ASAN to prove the UAF is gone.

fn _check(label: string, got: string, want: string)
    assert(got == want, label + ": expected '" + want + "' got '" + got + "'")
    print("PASS: " + label + " -> " + got)

fn main()
    // move-send: `job` is a single-use local -> compiler emits channel_send_move
    let ch = channel()
    let prev = arena_enter()
    let job = "secret-" + str(42)        // built in the active arena
    send(ch, job)                         // must escape the arena (RC-heap copy), not raw-move the arena ptr
    arena_exit(prev)                      // frees the arena chunk; a raw-moved arena ptr would now dangle
    let got = recv(ch)                    // dequeue + compare reads the value -> UAF (old) / RC copy (fixed)
    _check("move-send arena escape", got, "secret-42")

    // try_send: bounded non-blocking send, deep-copies in the runtime (must also clear active_arena)
    let ch2 = channel()
    let prev2 = arena_enter()
    let msg = "evt-" + str(7)
    let ok = try_send(ch2, msg)
    arena_exit(prev2)
    assert(ok == 1, "try_send accepted the value")
    let got2 = recv(ch2)
    _check("try_send arena escape", got2, "evt-7")

    print("_move_arena_uaf_test passed")
