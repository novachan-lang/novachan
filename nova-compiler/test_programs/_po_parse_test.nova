// KAT test for std/data/po_parse
import std/data/po_parse

fn cks(label, got, expected)
    if got != expected
        print("FAIL po_parse " + label + ": got=[" + got + "] expected=[" + expected + "]")
        exit(1)

fn cki(label, got, expected)
    if got != expected
        print("FAIL po_parse " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

let lf = chr(10)

// ── KAT 1: single entry with comment ─────────────────────────────────────────
let src1 = "# a comment" + lf + "msgid \"hello\"" + lf + "msgstr \"bonjour\"" + lf
let r1 = po_parse(src1)
cki("k1_count",   len(r1),            1)
cks("k1_msgid",   r1[0]["msgid"],     "hello")
cks("k1_msgstr",  r1[0]["msgstr"],    "bonjour")
let c1 = r1[0]["comments"]
cki("k1_ncomments", len(c1),          1)
cks("k1_comment0",  c1[0],            "a comment")

// ── KAT 2: two-entry PO ───────────────────────────────────────────────────────
let src2 = "msgid \"hello\"" + lf + "msgstr \"bonjour\"" + lf + lf + "msgid \"world\"" + lf + "msgstr \"monde\"" + lf
let r2 = po_parse(src2)
cki("k2_count",  len(r2),           2)
cks("k2_msgid0", r2[0]["msgid"],    "hello")
cks("k2_str0",   r2[0]["msgstr"],   "bonjour")
cks("k2_msgid1", r2[1]["msgid"],    "world")
cks("k2_str1",   r2[1]["msgstr"],   "monde")

// ── KAT 3: header entry (empty msgid) ─────────────────────────────────────────
let src3 = "msgid \"\"" + lf + "msgstr \"Content-Type: text/plain\"" + lf
let r3 = po_parse(src3)
cki("k3_count",  len(r3),          1)
cks("k3_msgid",  r3[0]["msgid"],   "")
cks("k3_msgstr", r3[0]["msgstr"],  "Content-Type: text/plain")

// ── KAT 4: multi-line msgstr concatenation ────────────────────────────────────
let src4 = "msgid \"long\"" + lf + "msgstr \"\"" + lf + "\"first part \"" + lf + "\"second part\"" + lf
let r4 = po_parse(src4)
cki("k4_count",  len(r4),          1)
cks("k4_msgid",  r4[0]["msgid"],   "long")
cks("k4_msgstr", r4[0]["msgstr"],  "first part second part")

// ── KAT 5: escape sequence in msgstr ──────────────────────────────────────────
let src5 = "msgid \"q\"" + lf + "msgstr \"say \\\"hi\\\"\"" + lf
let r5 = po_parse(src5)
cki("k5_count",  len(r5),          1)
cks("k5_msgid",  r5[0]["msgid"],   "q")
cks("k5_msgstr", r5[0]["msgstr"],  "say \"hi\"")

// ── KAT 6: no trailing newline after last entry ────────────────────────────────
let src6 = "msgid \"x\"" + lf + "msgstr \"y\""
let r6 = po_parse(src6)
cki("k6_count",  len(r6),          1)
cks("k6_msgid",  r6[0]["msgid"],   "x")
cks("k6_msgstr", r6[0]["msgstr"],  "y")

// ── KAT 7: multiple comment types ─────────────────────────────────────────────
let src7 = "# Translator comment" + lf + "#. Extracted comment" + lf + "#, fuzzy" + lf + "msgid \"z\"" + lf + "msgstr \"w\"" + lf
let r7 = po_parse(src7)
cki("k7_count",    len(r7),            1)
cki("k7_ncomment", len(r7[0]["comments"]),  3)

print("PASS _po_parse_test")
