import std/validation/email

// KAT: vem_is_valid
// 1. simple valid
let r1 = vem_is_valid("a@b.com")
if r1 != 1
    print("FAIL: vem_is_valid(a@b.com) expected 1 got " + str(r1))
    exit(1)

// 2. valid with subdomain, plus-tag, dot in local
let r2 = vem_is_valid("john.doe+tag@sub.example.co")
if r2 != 1
    print("FAIL: vem_is_valid(john.doe+tag@sub.example.co) expected 1 got " + str(r2))
    exit(1)

// 3. no @ at all
let r3 = vem_is_valid("bad")
if r3 != 0
    print("FAIL: vem_is_valid(bad) expected 0 got " + str(r3))
    exit(1)

// 4. double @
let r4 = vem_is_valid("a@@b.com")
if r4 != 0
    print("FAIL: vem_is_valid(a@@b.com) expected 0 got " + str(r4))
    exit(1)

// 5. domain has no dot (TLD only, no dot)
let r5 = vem_is_valid("a@b")
if r5 != 0
    print("FAIL: vem_is_valid(a@b) expected 0 got " + str(r5))
    exit(1)

// 6. empty local part
let r6 = vem_is_valid("@b.com")
if r6 != 0
    print("FAIL: vem_is_valid(@b.com) expected 0 got " + str(r6))
    exit(1)

// 7. double dot in domain
let r7 = vem_is_valid("a@b..com")
if r7 != 0
    print("FAIL: vem_is_valid(a@b..com) expected 0 got " + str(r7))
    exit(1)

// 8. leading dot in local
let r8 = vem_is_valid(".a@b.com")
if r8 != 0
    print("FAIL: vem_is_valid(.a@b.com) expected 0 got " + str(r8))
    exit(1)

// 9. vem_domain
let d9 = vem_domain("a@b.com")
if d9 != "b.com"
    print("FAIL: vem_domain(a@b.com) expected b.com got " + d9)
    exit(1)

// 10. vem_local
let l10 = vem_local("a@b.com")
if l10 != "a"
    print("FAIL: vem_local(a@b.com) expected a got " + l10)
    exit(1)

// 11. valid with multiple allowed special chars in local
let r11 = vem_is_valid("user_%+name@domain.org")
if r11 != 1
    print("FAIL: vem_is_valid(user_%+name@domain.org) expected 1 got " + str(r11))
    exit(1)

// 12. TLD too short (single letter)
let r12 = vem_is_valid("a@b.c")
if r12 != 0
    print("FAIL: vem_is_valid(a@b.c) expected 0 got " + str(r12))
    exit(1)

// 13. trailing dot in local
let r13 = vem_is_valid("a.@b.com")
if r13 != 0
    print("FAIL: vem_is_valid(a.@b.com) expected 0 got " + str(r13))
    exit(1)

// 14. vem_local with no @
let l14 = vem_local("noatsign")
if l14 != ""
    print("FAIL: vem_local(noatsign) expected empty got " + l14)
    exit(1)

// 15. vem_domain with no @
let d15 = vem_domain("noatsign")
if d15 != ""
    print("FAIL: vem_domain(noatsign) expected empty got " + d15)
    exit(1)

print("_email_test passed")
