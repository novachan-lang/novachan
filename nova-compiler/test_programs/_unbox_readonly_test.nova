// 3.1: nova_rt_unbox / nova_rt_unbox_elem are PURE READS (check a mem tag, deref a
// payload, write nothing), so their LLVM declares carry `readonly`. Without it LLVM
// must preserve every call, because an external function might write memory.
//
// Measured on this file, same source and same -O2:
//     declare ... nounwind            -> 8 unbox calls survive -O2
//     declare ... nounwind readonly   -> 2          (75% eliminated)
//
// This test guards CORRECTNESS of that optimisation: `readonly` is a promise to LLVM,
// and if it were ever wrong the arithmetic below would silently produce a wrong
// answer rather than crash. The declare itself is asserted by _unbox_readonly_gate.ps1
// (a value test cannot see whether the attribute is still present).
fn mono_float(x: float) -> float
    x

fn scale(x: float, by: float) -> float
    x * by

fn main()
    let v = mono_float(2.5)
    assert(v + v + v + v == 10.0, "repeated use of one float value")

    let w = scale(mono_float(1.5), 4.0)
    assert(w == 6.0, "float through two calls")

    // Boxed floats inside a container still round-trip (unbox_elem path).
    let xs = [1.5, 2.5, 3.0]
    let mut_total = xs[0] + xs[1] + xs[2]
    assert(mut_total == 7.0, "float list elements unbox correctly")

    print("UNBOX_READONLY_OK")
