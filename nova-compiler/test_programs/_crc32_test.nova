// _crc32_test.nova — KAT for std/hash/crc32
//
// All expected values are the PUBLISHED CRC-32 (ISO-HDLC / zlib / PNG)
// reference vectors, verifiable with Python: import zlib; zlib.crc32(b"...") & 0xFFFFFFFF
//
// Hand-trace for "" (no bytes):
//   crc = 0xFFFFFFFF; no iterations; result = 0xFFFFFFFF^0xFFFFFFFF = 0  ✓
//
// Python spot-checks:
//   zlib.crc32(b"")          & 0xFFFFFFFF == 0
//   zlib.crc32(b"a")         & 0xFFFFFFFF == 3904355907
//   zlib.crc32(b"abc")       & 0xFFFFFFFF == 891568578
//   zlib.crc32(b"123456789") & 0xFFFFFFFF == 3421780262
//   zlib.crc32(b"The quick brown fox jumps over the lazy dog") & 0xFFFFFFFF == 1095738169

import std/hash/crc32

// Integer known-answer check.
fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // KAT 1: empty string — init XOR final = 0xFFFFFFFF XOR 0xFFFFFFFF = 0
    cki("empty", h_crc32(""), 0)

    // KAT 2: single byte 'a' (0x61) — published vector 0xE8B7BE43
    cki("a", h_crc32("a"), 3904355907)

    // KAT 3: "abc" — published vector 0x352441C2
    cki("abc", h_crc32("abc"), 891568578)

    // KAT 4: "123456789" — the canonical CRC check value in ISO 3309 / POSIX
    cki("123456789", h_crc32("123456789"), 3421780262)

    // KAT 5: pangram — published vector 0x414FA339
    cki("fox", h_crc32("The quick brown fox jumps over the lazy dog"), 1095738169)

    // KAT 6: determinism — same input always gives same result
    cki("determinism", h_crc32("hello"), h_crc32("hello"))

    // KAT 7: single NUL-equivalent safe byte — "0" (byte 48)
    // Python: zlib.crc32(b"0") & 0xFFFFFFFF == 4108050209
    cki("zero_char", h_crc32("0"), 4108050209)

    // KAT 8: two-character "ab"
    // Computed by the reference implementation: 0x9E83E7ED = 2659403885
    // (also verifiable: python -c "import zlib; print(zlib.crc32(b'ab')&0xFFFFFFFF)")
    cki("ab", h_crc32("ab"), 2659403885)

    print("_crc32_test passed")
