fn test_hot_load_basic()
  let mod = hot_load("_hot_plugin.dll")
  assert(mod >= 0, "hot_load returned handle")

  let add_fn = hot_sym(mod, "hot_add")
  assert(add_fn != 0, "found hot_add symbol")

  let mul_fn = hot_sym(mod, "hot_mul")
  assert(mul_fn != 0, "found hot_mul symbol")

  let ver_fn = hot_sym(mod, "hot_version")
  assert(ver_fn != 0, "found hot_version symbol")

  let sum = hot_call2(add_fn, 3, 4)
  assert(sum == 7, "hot_add(3,4) == 7: " + str(sum))

  let prod = hot_call2(mul_fn, 5, 6)
  assert(prod == 30, "hot_mul(5,6) == 30: " + str(prod))

  let ver = hot_call0(ver_fn)
  assert(ver == 1, "hot_version == 1: " + str(ver))

  let unload_r = hot_unload(mod)
  assert(unload_r == 0, "hot_unload ok")
  print("  basic hot_load: PASS")

fn test_hot_version_swap()
  let mod1 = hot_load("_hot_plugin.dll")
  assert(mod1 >= 0, "load v1")
  let fn1 = hot_sym(mod1, "hot_version")
  let val1 = hot_call0(fn1)
  assert(val1 == 1, "v1 returns 1: " + str(val1))
  hot_unload(mod1)

  let mod2 = hot_load("_hot_plugin_v2.dll")
  assert(mod2 >= 0, "load v2")
  let fn2 = hot_sym(mod2, "hot_version")
  let val2 = hot_call0(fn2)
  assert(val2 == 2, "v2 returns 2: " + str(val2))

  let add2 = hot_sym(mod2, "hot_add")
  let sum2 = hot_call2(add2, 3, 4)
  assert(sum2 == 1007, "v2 hot_add(3,4) == 1007: " + str(sum2))

  hot_unload(mod2)
  print("  version swap: PASS")

fn test_hot_sym_missing()
  let mod = hot_load("_hot_plugin.dll")
  assert(mod >= 0, "load for missing test")

  let missing = hot_sym(mod, "no_such_function")
  assert(missing == 0, "missing symbol returns 0")

  hot_unload(mod)
  print("  missing symbol: PASS")

fn test_hot_load_invalid()
  let mod = hot_load("nonexistent_file.dll")
  assert(mod == -1, "loading nonexistent returns -1")
  print("  invalid load: PASS")

fn test_hot_call_with_args()
  let mod = hot_load("_hot_args.dll")
  assert(mod >= 0, "load args test")

  let calc_fn = hot_sym(mod, "hot_calc")
  let result = hot_call3(calc_fn, 3, 4, 5)
  assert(result == 17, "3*4+5 == 17: " + str(result))

  let id_fn = hot_sym(mod, "hot_id")
  let id_result = hot_call1(id_fn, 999)
  assert(id_result == 999, "id(999) == 999: " + str(id_result))

  hot_unload(mod)
  print("  hot_call with args: PASS")

fn test_hot_multiple_modules()
  let m1 = hot_load("_hot_plugin.dll")
  let m2 = hot_load("_hot_args.dll")
  assert(m1 >= 0, "load m1")
  assert(m2 >= 0, "load m2")
  assert(m1 != m2, "different handles")

  let add_fn = hot_sym(m1, "hot_add")
  let calc_fn = hot_sym(m2, "hot_calc")

  let r1 = hot_call2(add_fn, 10, 20)
  assert(r1 == 30, "m1 add: " + str(r1))

  let r2 = hot_call3(calc_fn, 2, 3, 4)
  assert(r2 == 10, "m2 calc: " + str(r2))

  hot_unload(m1)
  hot_unload(m2)
  print("  multiple modules: PASS")

fn main()
  test_hot_load_basic()
  test_hot_version_swap()
  test_hot_sym_missing()
  test_hot_load_invalid()
  test_hot_call_with_args()
  test_hot_multiple_modules()
  print("hot_reload_test: all passed")
