// CORE_GAP enum-float-payload-unbox: a FLOAT enum payload must unbox to a float (not read as raw i64
// bits). Prior codegen bound the payload as `any`/ir_locals=1, corrupting `str(r)` and float arithmetic
// for single-field variants routed through the boxed-multiply path. Exhaustive across shapes.
enum Shape
    Circle(radius: float)
    Rect(w: float, h: float)
    Named(tag: string, size: float)
    Blank

enum FBox
    F(x: float)

fn approx(a: float, b: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < 0.001

fn area(s) -> float
    match s
        Circle(r) => 3.14159 * r * r
        Rect(w, h) => w * h
        Named(t, sz) => sz
        _ => 0.0

fn check(name: string, got: float, want: float)
    if not approx(got, want)
        print("FAIL " + name + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("ok " + name + " = " + str(got))

fn main()
    // 1) single-field float variant in a MULTI-variant enum (the bug), through a fn param
    check("area(Circle 5)", area(Circle(5.0)), 78.53975)
    // 2) multi-field float variant, through a fn param
    check("area(Rect 3x4)", area(Rect(3.0, 4.0)), 12.0)
    // 3) mixed string+float payload; the float field must still unbox
    check("area(Named 2.5)", area(Named("x", 2.5)), 2.5)
    // 4) single-variant enum float
    match F(1.25)
        F(x) => check("F payload", x * 2.0, 2.5)
    // 5) DIRECT match (no fn param) + float arithmetic on the payload
    match Circle(2.0)
        Circle(r) => check("direct Circle", r * r, 4.0)
        _ => print("?")
    // 6) str() on a float payload must print the value, not the bit-pattern
    match Circle(7.5)
        Circle(r) =>
            if str(r) != "7.5"
                print("FAIL str(float payload): got " + str(r))
                exit(1)
            print("ok str(float payload) = " + str(r))
        _ => print("?")
    // 7) string payload still works
    match Named("hello", 9.0)
        Named(t, sz) =>
            if t != "hello"
                print("FAIL string payload: got " + t)
                exit(1)
            print("ok string payload = " + t)
        _ => print("?")
    print("_enum_float_payload_test passed")
