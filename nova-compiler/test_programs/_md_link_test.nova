import std/text/md_link

fn main()
    let q = chr(34)

    // KAT 1: simple link
    let got1 = md_link("[go](http://x)")
    let exp1 = "<a href=" + q + "http://x" + q + ">go</a>"
    if got1 != exp1
        print("FAIL md_link KAT1: got [" + got1 + "]")
        exit(1)

    // KAT 2: two links in the same string
    let got2 = md_link("see [a](u) and [b](v)")
    let exp2 = "see <a href=" + q + "u" + q + ">a</a> and <a href=" + q + "v" + q + ">b</a>"
    if got2 != exp2
        print("FAIL md_link KAT2: got [" + got2 + "]")
        exit(1)

    // KAT 3: plain text without links is unchanged
    let got3 = md_link("hello world")
    if got3 != "hello world"
        print("FAIL md_link KAT3: got [" + got3 + "]")
        exit(1)

    // KAT 4: link with longer URL
    let got4 = md_link("[click](https://example.com/path)")
    let exp4 = "<a href=" + q + "https://example.com/path" + q + ">click</a>"
    if got4 != exp4
        print("FAIL md_link KAT4: got [" + got4 + "]")
        exit(1)

    // KAT 5: text before and after a link
    let got5 = md_link("prefix [x](y) suffix")
    let exp5 = "prefix <a href=" + q + "y" + q + ">x</a> suffix"
    if got5 != exp5
        print("FAIL md_link KAT5: got [" + got5 + "]")
        exit(1)

    // KAT 6: bare bracket without valid link syntax is emitted literally
    let got6 = md_link("[no link")
    if got6 != "[no link"
        print("FAIL md_link KAT6: got [" + got6 + "]")
        exit(1)

    // KAT 7: empty string
    let got7 = md_link("")
    if got7 != ""
        print("FAIL md_link KAT7: got [" + got7 + "]")
        exit(1)

    print("PASS _md_link_test")
