// Independent adversarial verification probe for:
//   std/devtool/gitignore_parse (prefix gip_)
//   std/devtool/gitignore_glob  (prefix gig_)
//
// Every expected value below was hand-traced from the source, NOT copied from
// the module's own existing test. Checks are accumulated (no early exit) so a
// single run reports every discrepancy found.

import std/devtool/gitignore_parse
import std/devtool/gitignore_glob

fn main()
    let fails = 0
    let bslash = chr(92)

    // ============================================================
    // gitignore_parse — edge cases
    // ============================================================

    // "!" alone: negation strip leaves body "", then dir_only/anchored checks
    // run on that empty body per the documented order of operations.
    let p1 = gip_parse_line("!", 10)
    let rp1 = p1[0]
    if rp1[0] != "" or rp1[1] != 1 or rp1[2] != 0 or rp1[3] != 0
        print("FAIL parse-bang-alone: expected [\"\",1,0,0] got " + str(rp1))
        fails = fails + 1

    // "!/" : negation strips "!", then trailing "/" strips to dir_only,
    // leaving an empty body -> anchored must be 0 (no "/" left to find).
    let p2 = gip_parse_line("!/", 11)
    let rp2 = p2[0]
    if rp2[0] != "" or rp2[1] != 1 or rp2[2] != 1 or rp2[3] != 0
        print("FAIL parse-bang-slash: expected [\"\",1,1,0] got " + str(rp2))
        fails = fails + 1

    // "/" alone: trailing-slash strip (dir_only) consumes the only char,
    // leaving body "" -> anchored 0 per the same order-of-operations rule.
    let p3 = gip_parse_line("/", 12)
    let rp3 = p3[0]
    if rp3[0] != "" or rp3[1] != 0 or rp3[2] != 1 or rp3[3] != 0
        print("FAIL parse-slash-alone: expected [\"\",0,1,0] got " + str(rp3))
        fails = fails + 1

    // "/!" : leading "/" is not "!" so no negation; body keeps the "!";
    // presence of "/" anywhere anchors; leading "/" is then stripped.
    let p4 = gip_parse_line("/!", 13)
    let rp4 = p4[0]
    if rp4[0] != "!" or rp4[1] != 0 or rp4[2] != 0 or rp4[3] != 1
        print("FAIL parse-slash-bang: expected [\"!\",0,0,1] got " + str(rp4))
        fails = fails + 1

    // "//" : trailing "/" -> dir_only, remaining "/" -> anchored, then the
    // leading "/" left after that is stripped, leaving "".
    let p5 = gip_parse_line("//", 14)
    let rp5 = p5[0]
    if rp5[0] != "" or rp5[1] != 0 or rp5[2] != 1 or rp5[3] != 1
        print("FAIL parse-double-slash: expected [\"\",0,1,1] got " + str(rp5))
        fails = fails + 1

    // "#" alone (no space, no trailing text) is a pure comment line -> [].
    let p6 = gip_parse_line("#", 15)
    if len(p6) != 0
        print("FAIL parse-hash-alone: expected empty list, got len " + str(len(p6)))
        fails = fails + 1

    // Tab-only line: trim() strips tabs too (per runtime), so this is blank.
    let tab = chr(9)
    if gip_is_blank(tab) != 1
        print("FAIL is_blank-tab: expected 1 got " + str(gip_is_blank(tab)))
        fails = fails + 1

    // gip_parse on a fully empty file: split("", "\n") yields one empty
    // line, which is blank -> zero records, no crash.
    let e1 = gip_parse("")
    if len(e1) != 0
        print("FAIL parse-empty-text: expected 0 records got " + str(len(e1)))
        fails = fails + 1

    // gip_parse on a file of only blank lines.
    let e2 = gip_parse("\n\n\n")
    if len(e2) != 0
        print("FAIL parse-only-blanks: expected 0 records got " + str(len(e2)))
        fails = fails + 1

    // strip_trailing_spaces: THREE trailing spaces after an escaping
    // backslash must collapse to exactly ONE kept space (doc: "one space is
    // kept"), not zero and not all three.
    let s10 = gip_strip_trailing_spaces("foo" + bslash + "   ")
    let want10 = "foo" + bslash + " "
    if s10 != want10
        print("FAIL strip-multi-escaped: expected '" + want10 + "' got '" + s10 + "'")
        fails = fails + 1

    // strip_trailing_spaces: an all-space line (no backslash anywhere)
    // collapses fully to "".
    let s11 = gip_strip_trailing_spaces("   ")
    if s11 != ""
        print("FAIL strip-all-spaces: expected '' got '" + s11 + "'")
        fails = fails + 1

    // ============================================================
    // gitignore_glob — edge cases
    // ============================================================

    // --- BUG CLASS 1: unterminated bracket class can produce a MATCH,
    // contradicting the module's own documented guarantee ("A malformed
    // class with no closing ']' is matched ... with no match found (safe,
    // does not crash)"). It never crashes, but it is NOT guaranteed
    // no-match: if the probed character is scanned as a literal class
    // member before the string runs out, matched=1 leaks through.

    // Direct probe of gig_char_class itself: "[abc" has no closing "]".
    // Per doc this must report no match for any input character.
    let c1 = gig_char_class("a", "[abc", 1)
    if c1[0] != 0
        print("FAIL char_class-unterminated-member: gig_char_class('a','[abc',1) expected matched=0 (doc: malformed->no match) got " + str(c1))
        fails = fails + 1

    // Control: a character that is NOT among the scanned members of the
    // same unterminated class correctly reports no match.
    let c2 = gig_char_class("d", "[abc", 1)
    if c2[0] != 0 or c2[1] != 4
        print("FAIL char_class-unterminated-nonmember: expected [0,4] got " + str(c2))
        fails = fails + 1

    // Full pipeline: pattern "a[bc" (typo'd, missing "]") against text "ab".
    // Per the documented "no match" guarantee for malformed classes this
    // must be 0.
    let m1 = gig_match("a[bc", "ab")
    if m1 != 0
        print("FAIL match-unterminated-class: gig_match('a[bc','ab') expected 0 got " + str(m1))
        fails = fails + 1

    // Control: same malformed pattern shape but the probed char is not a
    // scanned member -> correctly 0.
    let m2 = gig_match("a[xz", "ab")
    if m2 != 0
        print("FAIL match-unterminated-class-control: expected 0 got " + str(m2))
        fails = fails + 1

    // Negated + unterminated + zero real members: "[!" (bang immediately
    // followed by end of string). `matched` never gets set for any member,
    // stays 0, then negation flips it to 1 for EVERY character -- this
    // malformed class matches anything.
    let c3 = gig_char_class("q", "[!", 1)
    if c3[0] != 0
        print("FAIL char_class-negated-empty-unterminated: gig_char_class('q','[!',1) expected matched=0 got " + str(c3))
        fails = fails + 1

    // Same defect through the full matcher: "[!]" is a negated class with
    // no real members and no closing bracket (the "]" is consumed as the
    // conventional first-member literal, per the is_first rule, and then
    // the string runs out) -- it ends up matching almost any character.
    let m3 = gig_match("[!]", "q")
    if m3 != 0
        print("FAIL match-negated-empty-unterminated: gig_match('[!]','q') expected 0 got " + str(m3))
        fails = fails + 1

    // --- Control cases: well-formed brackets that SHOULD work, to confirm
    // the bug above is specific to malformed/unterminated classes and not a
    // wholesale break of bracket matching.

    // Trailing "-" right before "]" is a literal dash, not a broken range.
    let m4 = gig_match("[a-]", "-")
    if m4 != 1
        print("FAIL match-trailing-dash-literal: expected 1 got " + str(m4))
        fails = fails + 1
    let m5 = gig_match("[a-]", "z")
    if m5 != 0
        print("FAIL match-trailing-dash-literal-nomatch: expected 0 got " + str(m5))
        fails = fails + 1

    // Inverted range [z-a]: lo > hi must never crash and must never match
    // (the >= lo AND <= hi test can't both hold).
    let m6 = gig_match("[z-a]", "m")
    if m6 != 0
        print("FAIL match-inverted-range: expected 0 got " + str(m6))
        fails = fails + 1
    let m7 = gig_match("[z-a]", "z")
    if m7 != 0
        print("FAIL match-inverted-range-boundary: expected 0 got " + str(m7))
        fails = fails + 1

    // Bare "[" with nothing after it: zero members ever scanned, so
    // matched correctly stays 0 (no crash, no false positive) -- contrasts
    // with the "[!" case above where negation flips an empty scan to 1.
    let m8 = gig_match("[", "a")
    if m8 != 0
        print("FAIL match-bare-bracket: expected 0 got " + str(m8))
        fails = fails + 1

    // "[]abc]" : leading "]" is a literal member (documented convention),
    // real close is the final "]".
    let m9 = gig_match("[]abc]", "]")
    if m9 != 1
        print("FAIL match-leading-bracket-literal: expected 1 got " + str(m9))
        fails = fails + 1
    let m10 = gig_match("[]abc]", "a")
    if m10 != 1
        print("FAIL match-leading-bracket-literal-a: expected 1 got " + str(m10))
        fails = fails + 1
    let m11 = gig_match("[]abc]", "z")
    if m11 != 0
        print("FAIL match-leading-bracket-literal-nomatch: expected 0 got " + str(m11))
        fails = fails + 1

    // A literal backslash in both pattern and text must not crash and must
    // compare as an ordinary character (no escaping implemented, per doc).
    let bpat = "a" + bslash + "b"
    let m12 = gig_match(bpat, bpat)
    if m12 != 1
        print("FAIL match-literal-backslash: expected 1 got " + str(m12))
        fails = fails + 1

    // --- gig_match is a SINGLE-SEGMENT matcher (per its API doc): "*" and
    // "?" match any character including "/". Passing a "/"-containing text
    // is out of contract; "*" absorbing the whole string (incl. "/") is
    // correct single-segment behavior. The "/"-boundary guarantee is
    // enforced one level up, by gig_match_path / gig_match_basename, which
    // pre-split on "/" before ever calling gig_match (verified below).
    let x1 = gig_match("*", "a/b")
    if x1 != 1
        print("FAIL match-single-segment-star: gig_match('*','a/b') expected 1 (single-segment) got " + str(x1))
        fails = fails + 1

    // Control: through the documented multi-segment entry point, the "/"
    // boundary IS respected (pre-split happens first).
    let x2 = gig_match_path("*/*", "a/b")
    if x2 != 1
        print("FAIL match_path-star-per-segment: expected 1 got " + str(x2))
        fails = fails + 1
    let x3 = gig_match_path("*", "a/b")
    if x3 != 0
        print("FAIL match_path-segcount-mismatch: expected 0 got " + str(x3))
        fails = fails + 1

    // gig_match_basename on an empty path: split("","/") -> one empty
    // segment, "*" matches empty -> 1.
    let x4 = gig_match_basename("*", "")
    if x4 != 1
        print("FAIL match_basename-empty-path: expected 1 got " + str(x4))
        fails = fails + 1

    // ============================================================
    if fails > 0
        print("FAIL _adv_gitignore_pg_test: " + str(fails) + " check(s) failed")
        exit(1)

    print("PASS _adv_gitignore_pg_test")
