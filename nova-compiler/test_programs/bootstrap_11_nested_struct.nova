// Bootstrap test 11: nested structs, struct mutation, list of structs
type Pair
    key: string
    val: int

fn make_pair(k: string, v: int) -> Pair
    return Pair(k, v)

let items = []
push(items, make_pair("a", 1))
push(items, make_pair("b", 2))
push(items, make_pair("c", 3))

let i = 0
while i < len(items)
    let p = items[i]
    match p
        Pair(k, v) =>
            print(k + "=" + str(v))
    i = i + 1
