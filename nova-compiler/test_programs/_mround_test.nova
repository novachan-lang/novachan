import std/money/round

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL mround " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── mround_half_up KAT vectors ────────────────────────────────────────────

    // 5/2 = 2.5 -> round half away from zero -> 3
    cki("half_up_2.5", mround_half_up(5, 2), 3)
    // 7/2 = 3.5 -> round half away from zero -> 4
    cki("half_up_3.5", mround_half_up(7, 2), 4)
    // 4/2 = 2.0 -> exact -> 2
    cki("half_up_2.0", mround_half_up(4, 2), 2)
    // 6/2 = 3.0 -> exact -> 3
    cki("half_up_3.0", mround_half_up(6, 2), 3)
    // -5/2 = -2.5 -> round half away from zero -> -3
    cki("half_up_neg2.5", mround_half_up(-5, 2), -3)

    // ── mround_half_even KAT vectors ─────────────────────────────────────────

    // 5/2 = 2.5 -> nearest even (2 is even) -> 2
    cki("half_even_2.5", mround_half_even(5, 2), 2)
    // 7/2 = 3.5 -> nearest even (4 is even) -> 4
    cki("half_even_3.5", mround_half_even(7, 2), 4)
    // 2/2 = 1.0 -> exact -> 1
    cki("half_even_1.0", mround_half_even(2, 2), 1)
    // 9/2 = 4.5 -> nearest even (4 is even) -> 4
    cki("half_even_4.5", mround_half_even(9, 2), 4)
    // 3/2 = 1.5 -> nearest even (2 is even) -> 2
    cki("half_even_1.5", mround_half_even(3, 2), 2)

    // ── mround_floor KAT ─────────────────────────────────────────────────────

    // -5/2 = -2.5 -> floor -> -3
    cki("floor_neg2.5", mround_floor(-5, 2), -3)
    // 5/2 = 2.5 -> floor -> 2
    cki("floor_2.5", mround_floor(5, 2), 2)
    // 4/2 = 2.0 -> floor -> 2 (exact)
    cki("floor_2.0", mround_floor(4, 2), 2)

    // ── mround_ceil KAT ──────────────────────────────────────────────────────

    // 5/2 = 2.5 -> ceil -> 3
    cki("ceil_2.5", mround_ceil(5, 2), 3)
    // -5/2 = -2.5 -> ceil -> -2
    cki("ceil_neg2.5", mround_ceil(-5, 2), -2)

    // ── mround_trunc KAT ─────────────────────────────────────────────────────

    cki("trunc_2.5", mround_trunc(5, 2), 2)
    cki("trunc_neg2.5", mround_trunc(-5, 2), -2)
    cki("trunc_3.5", mround_trunc(7, 2), 3)

    // ── mround_half_down KAT ─────────────────────────────────────────────────

    // 5/2 = 2.5 -> tie rounds toward zero -> 2
    cki("half_down_2.5", mround_half_down(5, 2), 2)
    // 7/2 = 3.5 -> tie at .5, round toward zero -> 3 (half_down = half toward zero)
    cki("half_down_3.5", mround_half_down(7, 2), 3)
    // 8/3 = 2.67 -> strictly past midpoint -> round away -> 3
    cki("half_down_2.67", mround_half_down(8, 3), 3)

    // ── mround_div KAT vectors ────────────────────────────────────────────────

    // 100/3 = 33.33... with half_up -> 33
    cki("div_100_3_hu", mround_div(100, 3, "half_up"), 33)
    // 101/3 = 33.67 -> round -> 34
    cki("div_101_3_hu", mround_div(101, 3, "half_up"), 34)
    // 100/3 floor -> 33
    cki("div_100_3_fl", mround_div(100, 3, "floor"), 33)
    // 100/3 ceil -> 34
    cki("div_100_3_ce", mround_div(100, 3, "ceil"), 34)
    // "up" mode = half_up
    cki("div_5_2_up", mround_div(5, 2, "up"), 3)

    // ── mround_pct KAT vectors ────────────────────────────────────────────────

    // 25.5% of 100.00 (10000 minor) = 25.50 = 2550 minor
    // 10000 * 2550 / 10000 = 2550 exactly
    cki("pct_2550_of_10000", mround_pct(10000, 2550, "half_up"), 2550)

    // 10% of 100.00 = 10.00 = 1000 minor
    cki("pct_1000_of_10000", mround_pct(10000, 1000, "half_up"), 1000)

    // 33.33% (3333 bps) of 100 (minor=100) = 100*3333/10000 = 33.33 -> 33
    cki("pct_3333_of_100", mround_pct(100, 3333, "half_up"), 33)

    // 100% (10000 bps) of 999 = 999
    cki("pct_100pct", mround_pct(999, 10000, "half_up"), 999)

    // ── mround_bankers (= half_even) ─────────────────────────────────────────

    cki("bankers_2.5", mround_bankers(5, 2), 2)
    cki("bankers_3.5", mround_bankers(7, 2), 4)

    print("PASS _mround_test")
