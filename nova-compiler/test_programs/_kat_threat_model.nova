import forge_threat_model

fn main()
    let tm = tm_new()
    tm = tm_add_asset(tm, "database", "data_store")
    tm = tm_add_asset(tm, "api", "service")
    assert(tm_asset_count(tm) == 2, "2 assets")

    let t1 = tm_add_threat(tm, "T001", "database", "injection", "critical")
    tm = unwrap(t1)
    let t2 = tm_add_threat(tm, "T002", "database", "exfiltration", "high")
    tm = unwrap(t2)
    let t3 = tm_add_threat(tm, "T003", "api", "dos", "medium")
    tm = unwrap(t3)
    assert(tm_threat_count(tm) == 3, "3 threats")
    assert(tm_unmitigated_count(tm) == 3, "3 unmitigated")

    let at1 = tm_asset_threats(tm, "database")
    assert(unwrap(at1) == 2, "database 2 threats")

    let sev = tm_severity(tm, "T001")
    assert(unwrap(sev) == "critical", "T001 critical")
    let cat = tm_category(tm, "T001")
    assert(unwrap(cat) == "injection", "T001 injection")

    let m1 = tm_mitigate(tm, "T001", "parameterized queries")
    tm = unwrap(m1)
    assert(tm_mitigation_count(tm) == 1, "1 mitigated")
    assert(tm_unmitigated_count(tm) == 2, "2 unmitigated")

    let im = tm_is_mitigated(tm, "T001")
    assert(unwrap(im) == 1, "T001 mitigated")
    let im2 = tm_is_mitigated(tm, "T002")
    assert(unwrap(im2) == 0, "T002 not mitigated")

    let bad = tm_add_threat(tm, "T004", "nope", "foo", "low")
    assert(is_err(bad), "unknown asset")

    let bad2 = tm_severity(tm, "T999")
    assert(is_err(bad2), "unknown threat")

    print("THREAT-MODEL KAT PASS")
