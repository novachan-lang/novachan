import forge_aho
// Only the ORIGINAL public API, so the diff against git HEAD is meaningful.
fn build(ps: list) -> dict
    let ac = ac_new()
    for p in ps
        ac_add(ac, p)
    ac_build(ac)
fn main()
    print(str(ac_search(build(["he", "she", "his", "hers"]), "ushers")))
    print(str(ac_search(build(["he", "she", "his", "hers"]), "")))
    print(str(ac_search(build([]), "abc")))
    print(str(ac_search(build(["a"]), "aaa")))
    print(str(ac_search(build(["aa"]), "aaaa")))
    print(str(ac_search(build(["ab", "b"]), "ab")))
    print(str(ac_search(build(["abc", "bc", "c"]), "xabcy")))
    print(str(ac_search(build(["aaa"]), "aaaaa")))
    print("EXERCISE-DONE")
