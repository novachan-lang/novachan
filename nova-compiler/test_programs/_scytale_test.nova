// KAT for std/cipher/scytale
import std/cipher/scytale

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL scytale " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn main()
    // ----------------------------------------------------------------
    // 1. KNOWN VECTOR: scytale_encrypt("IAMHURTVERYBADLYHELP", 5)
    //
    // PT = "IAMHURTVERYBADLYHELP" (20 chars, 5 cols => 4 rows, no padding)
    // Grid (4 rows x 5 cols):
    //   Row 0: I A M H U
    //   Row 1: R T V E R
    //   Row 2: Y B A D L
    //   Row 3: Y H E L P
    // Read columns: col0=IRYY, col1=ATBH, col2=MVAE, col3=HEDL, col4=URLP
    // CT = "IRYYATBHMVAEHEDIURLP"
    //     = I R Y Y A T B H M V A E H E D L U R L P
    let pt_known = "IAMHURTVERYBADLYHELP"
    let ct_known = scytale_encrypt(pt_known, 5)
    cks("known_enc", ct_known, "IRYYATBHMVAEHEDLURLP")

    // Decrypt known vector round-trips back to PT (no padding needed).
    let dt_known = scytale_decrypt(ct_known, 5)
    cks("known_dec", dt_known, pt_known)

    // ----------------------------------------------------------------
    // 2. ROUND-TRIP: columns=3, plaintext of exact length (12 chars)
    let pt2 = "ATTACKATDAWN"
    let ct2 = scytale_encrypt(pt2, 3)
    let dt2 = scytale_decrypt(ct2, 3)
    cks("rt_exact3", dt2, pt2)

    // ----------------------------------------------------------------
    // 3. ROUND-TRIP: columns=4, plaintext requiring padding
    // "HELLOWORLD" = 10 chars, columns=4 => ceil(10/4)=3 rows, total=12, pad 2 X
    let pt3 = "HELLOWORLD"
    let ct3 = scytale_encrypt(pt3, 4)
    let dt3 = scytale_decrypt(ct3, 4)
    // decrypt returns 12 chars (padded), original is first 10
    cks("rt_pad4", slice(dt3, 0, 10), pt3)

    // ----------------------------------------------------------------
    // 4. ROUND-TRIP: columns=7, plaintext=20 chars (pad to 21)
    let pt4 = "WEAREDISCOVEREDRUNAT"
    let ct4 = scytale_encrypt(pt4, 7)
    let dt4 = scytale_decrypt(ct4, 7)
    cks("rt_pad7", slice(dt4, 0, 20), pt4)

    // ----------------------------------------------------------------
    // 5. ROUND-TRIP: columns=1 (trivial — each column is the full text)
    // Encrypt with 1 column: 1 column, nrows=len(pt). Read col0 = all chars.
    // CT == PT (normalized). Decrypt same.
    let pt5 = "HELLO"
    let ct5 = scytale_encrypt(pt5, 1)
    cks("cols1_enc", ct5, "HELLO")
    let dt5 = scytale_decrypt(ct5, 1)
    cks("cols1_dec", dt5, "HELLO")

    // ----------------------------------------------------------------
    // 6. ROUND-TRIP: columns == len(pt) (single row — read each column of 1)
    // Grid = 1 row x 5 cols: H E L L O
    // Read col-by-col from 1 row = same order = HELLO
    let pt6 = "HELLO"
    let ct6 = scytale_encrypt(pt6, 5)
    cks("cols_eq_len", ct6, "HELLO")
    let dt6 = scytale_decrypt(ct6, 5)
    cks("cols_eq_len_dec", dt6, "HELLO")

    // ----------------------------------------------------------------
    // 7. ROUND-TRIP: columns=2, odd-length plaintext (pad 1 X)
    // "NOVA" = 4 chars, cols=2 => 2 rows, no pad needed
    let pt7 = "NOVA"
    let ct7 = scytale_encrypt(pt7, 2)
    // Grid: N O / V A  => col0=NV, col1=OA => CT="NVOA"
    cks("cols2_nova", ct7, "NVOA")
    let dt7 = scytale_decrypt(ct7, 2)
    cks("cols2_nova_dec", dt7, "NOVA")

    // ----------------------------------------------------------------
    // 8. ROUND-TRIP: "HELLO" cols=2 (pad 1 X to "HELLOX")
    // Grid: H E / L L / O X  => col0=HLO, col1=ELX => CT="HLOELX"
    let pt8 = "HELLO"
    let ct8 = scytale_encrypt(pt8, 2)
    cks("hello_cols2_enc", ct8, "HLOELX")
    let dt8 = scytale_decrypt(ct8, 2)
    // decrypt returns "HELLOX" (6 chars), original 5
    cks("hello_cols2_rt", slice(dt8, 0, 5), "HELLO")

    // ----------------------------------------------------------------
    // 9. Normalize: lowercase + non-alpha stripped
    let ct9a = scytale_encrypt("iamhurtverybadlyhelp", 5)
    let ct9b = scytale_encrypt("IAM HURT VERY BADLY HELP!!!", 5)
    cks("norm_lower", ct9a, "IRYYATBHMVAEHEDLURLP")
    cks("norm_spaces", ct9b, "IRYYATBHMVAEHEDLURLP")

    // ----------------------------------------------------------------
    // 10. Empty input safety
    let ct10 = scytale_encrypt("", 5)
    cks("empty_enc", ct10, "")
    let dt10 = scytale_decrypt("", 5)
    cks("empty_dec", dt10, "")

    // ----------------------------------------------------------------
    // 11. Single character input
    // "A" cols=5: pad to "AXXXX", grid 1 row x 5 cols: A X X X X
    // col0=A, col1=X, col2=X, col3=X, col4=X => CT="AXXXX"
    let ct11 = scytale_encrypt("A", 5)
    cks("single_enc", ct11, "AXXXX")
    let dt11 = scytale_decrypt(ct11, 5)
    // decrypt "AXXXX" cols=5: 5 chars / 5 cols = 1 row. col0=A,col1=X,col2=X,col3=X,col4=X
    // grid row0: A X X X X => read row = "AXXXX"
    cks("single_dec_rt", slice(dt11, 0, 1), "A")

    // ----------------------------------------------------------------
    // 12. columns=0 edge case: returns normalized PT unchanged
    let ct12 = scytale_encrypt("Hello World", 0)
    cks("cols0_enc", ct12, "HELLOWORLD")
    let dt12 = scytale_decrypt("HELLOWORLD", 0)
    cks("cols0_dec", dt12, "HELLOWORLD")

    print("PASS _scytale_test")
