fn band_zero(x: int) -> int
    x & 0

fn bor_zero(x: int) -> int
    x | 0

fn bxor_zero(x: int) -> int
    x ^ 0

fn shl_zero(x: int) -> int
    x << 0

fn shr_zero(x: int) -> int
    x >> 0

fn shl_of_zero(n: int) -> int
    0 << n

fn shr_of_zero(n: int) -> int
    0 >> n

assert(band_zero(255) == 0, "x & 0 == 0")
assert(band_zero(-1) == 0, "neg & 0 == 0")
assert(bor_zero(42) == 42, "x | 0 == x")
assert(bor_zero(-7) == -7, "neg | 0 == neg")
assert(bxor_zero(99) == 99, "x ^ 0 == x")
assert(bxor_zero(-1) == -1, "neg ^ 0 == neg")
assert(shl_zero(42) == 42, "x << 0 == x")
assert(shr_zero(42) == 42, "x >> 0 == x")
assert(shl_of_zero(5) == 0, "0 << n == 0")
assert(shr_of_zero(5) == 0, "0 >> n == 0")

assert((0xFF & 0x0F) == 15, "const bitand fold")
assert((0xA0 | 0x05) == 0xA5, "const bitor fold")
assert((0xFF ^ 0x0F) == 0xF0, "const bitxor fold")
assert((1 << 10) == 1024, "const shl fold")
assert((1024 >> 3) == 128, "const shr fold")

fn compound_bits(x: int) -> int
    let a = x & 0
    let b = x | 0
    let c = x ^ 0
    a + b + c

assert(compound_bits(42) == 84, "compound bit strength")

print("all bitwise fold tests passed")
