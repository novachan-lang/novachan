import forge_shard_manager

fn main()
    let sm = sm_new(4)
    assert(sm_shard_count(sm) == 4, "4 shards")
    assert(sm_unassigned_count(sm) == 4, "all unassigned")

    sm = sm_assign(sm, 0, "node-a")
    sm = sm_assign(sm, 1, "node-b")
    sm = sm_assign(sm, 2, "node-a")
    sm = sm_assign(sm, 3, "node-c")
    assert(sm_unassigned_count(sm) == 0, "all assigned")
    assert(sm_total_moves(sm) == 0, "0 moves (first assign)")

    assert(sm_lookup(sm, 0) == "node-a", "shard 0 on node-a")
    assert(sm_lookup(sm, 3) == "node-c", "shard 3 on node-c")

    sm = sm_assign(sm, 1, "node-d")
    assert(sm_lookup(sm, 1) == "node-d", "shard 1 moved to node-d")
    assert(sm_total_moves(sm) == 1, "1 move")

    let sid = sm_key_to_shard(sm, "user:42")
    assert(sid >= 0, "shard >= 0")
    assert(sid < 4, "shard < 4")

    let sid2 = sm_key_to_shard(sm, "user:42")
    assert(sid == sid2, "deterministic sharding")

    let node = sm_node_for_key(sm, "order:100")
    assert(len(node) > 0, "got a node")

    assert(sm_lookup(sm, -1) == "", "out of range neg")
    assert(sm_lookup(sm, 99) == "", "out of range high")

    print("SHARD-MANAGER KAT PASS")
