// csvw.nova — RFC-4180 CSV WRITER (csvx has the parser; this is the writer).
//
// Correct CSV writing is non-trivial: a field must be quoted if it contains a
// comma, a double-quote, or a newline, and embedded double-quotes are doubled.
// This complements csvx's parser so a NOVA program can round-trip tabular data.

// quote a single field per RFC 4180 (only when needed).
fn csv_quote(field)
  let needs = contains(field, ",") or contains(field, "\"") or contains(field, "\n")
  if needs
    // double every embedded quote:  "  ->  ""   (split on " then join with "")
    let doubled = join(split(field, "\""), "\"\"")
    return "\"" + doubled + "\""
  field

// one CSV row from a list of string fields.
fn csv_row(fields)
  let parts = []
  for f in fields
    push(parts, csv_quote(f))
  join(parts, ",")

// full CSV text from a list of rows (each a list of string fields).
fn csv_write(rows)
  let lines = []
  for row in rows
    push(lines, csv_row(row))
  join(lines, "\n")

// ── Tests ────────────────────────────────────────────────────────────

// plain fields are not quoted.
assert(csv_quote("hello") == "hello", "plain field unquoted")
assert(csv_row(["a", "b", "c"]) == "a,b,c", "simple row")
print("PASS: plain fields")

// a field with a comma gets quoted.
assert(csv_quote("a,b") == "\"a,b\"", "comma field quoted")
print("PASS: comma quoting")

// embedded quotes are doubled and the field wrapped.
//  say "hi"   ->   "say ""hi"""
assert(csv_quote("say \"hi\"") == "\"say \"\"hi\"\"\"", "embedded quotes doubled")
print("PASS: quote doubling")

// a field with a newline gets quoted.
let nl = csv_quote("line1\nline2")
assert(starts_with(nl, "\""), "newline field is quoted (starts with quote)")
assert(contains(nl, "\n"), "newline preserved inside the quoted field")
print("PASS: newline quoting")

// a full table with mixed fields.
let table = [["name", "city"], ["Ann", "Paris"], ["Bob, Jr", "New\nYork"]]
let out = csv_write(table)
let rows = split(out, "\n")
// header + Ann row are plain; "Bob, Jr" needs quoting; "New\nYork" spans a line
assert(rows[0] == "name,city", "header row")
assert(rows[1] == "Ann,Paris", "plain data row")
assert(contains(out, "\"Bob, Jr\""), "comma field quoted in table")
print("PASS: full table")

// round-trip a comma-containing field through quote: the quoted form, when the
// surrounding quotes + doubling are reversed, recovers the original.
let original = "a,\"b\",c"
let q = csv_quote(original)
// q = "a,""b"",c"  (wrapped, inner quotes doubled)
assert(starts_with(q, "\"") and contains(q, "\"\"b\"\""), "round-trippable quoting")
print("PASS: quoting is reversible")

print("ALL PASS: csvw — RFC-4180 CSV writer")
