import forge_skyline

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn render(kp: list) -> string
    let out = ""
    let i = 0
    while i < len(kp)
        if i > 0
            out = out + " "
        out = out + str(kp[i][0]) + ":" + str(kp[i][1])
        i = i + 1
    out

// height at x from the skyline key points (step function)
fn sky_height(kp: list, x: int) -> int
    let h = 0
    let i = 0
    while i < len(kp)
        if kp[i][0] <= x
            h = kp[i][1]
        i = i + 1
    h

// brute-force max building height covering x (L <= x < R)
fn brute_height(buildings: list, x: int) -> int
    let best = 0
    let i = 0
    while i < len(buildings)
        if buildings[i][0] <= x and x < buildings[i][1]
            if buildings[i][2] > best
                best = buildings[i][2]
        i = i + 1
    best

fn main()
    let fails = 0

    // classic LeetCode skyline
    let b = []
    push(b, [2, 9, 10])
    push(b, [3, 7, 15])
    push(b, [5, 12, 12])
    push(b, [15, 20, 10])
    push(b, [19, 24, 8])
    let sk = skyline(b)
    fails = fails + expect("classic", render(sk), "2:10 3:15 7:12 12:0 15:10 20:8 24:0")

    // single building
    let b2 = []
    push(b2, [1, 5, 3])
    fails = fails + expect("single", render(skyline(b2)), "1:3 5:0")

    // two identical -> merge
    let b3 = []
    push(b3, [1, 5, 3])
    push(b3, [1, 5, 3])
    fails = fails + expect("identical", render(skyline(b3)), "1:3 5:0")

    // brute-force cross-check the classic skyline at every x in range
    let ok = 1
    let x = 0
    while x <= 26
        if sky_height(sk, x) != brute_height(b, x)
            ok = 0
        x = x + 1
    fails = fails + expect("brute_cross", str(ok), "1")

    // another set, cross-check
    let b4 = []
    push(b4, [0, 4, 5])
    push(b4, [2, 6, 3])
    push(b4, [5, 8, 6])
    push(b4, [7, 10, 2])
    let sk4 = skyline(b4)
    let ok2 = 1
    let x2 = 0 - 1
    while x2 <= 12
        if sky_height(sk4, x2) != brute_height(b4, x2)
            ok2 = 0
        x2 = x2 + 1
    fails = fails + expect("brute_cross2", str(ok2), "1")

    if fails == 0
        print("forge_skyline: all passed")
    else
        print("forge_skyline: " + str(fails) + " FAILED")
