// _move6_insert_leak_test.nova -- pins Wave-B #6 (CORE_GAPS): push/dict-set of a FRESH owned-temp leaks
// the temp's +1. mk(i) returns a +1-owned string; nova_rt_list_append rc_inc's it (rc 2); when the
// container drops, the element dec's to 1, never 0 -> leaked. Confirmed baseline ~2001 per 2000 iters.
// The fix (MOVE-on-insert) skips the insert-inc ONLY for a PROVEN owned-temp arg (literal/str-concat, and
// later user-calls minus borrow-returning builtins -- accessor builtins return BORROWS, eliding them = the
// CORE_GAP 0.10 UAF, so they must stay on the rc-inc path). CI-SAFE: reports the residual, guards it can't
// get WORSE, and flags CLOSED when a fix lands. Run under NOVA_T8_FULLRC=1.
fn mk(i: int) -> string
    return "item-" + str(i)

fn main()
    // (A) push a fresh STRING-CONCAT temp (an owned-temp the safe slice will MOVE)
    let bA = live_count()
    let i = 0
    while i < 2000
        let tmp = []
        tmp.push("row-" + str(i))
        let _u = len(tmp)
        i = i + 1
    let concat_delta = live_count() - bA

    // (B) push a fresh user-CALL temp (owned-temp; needs the borrow-builtin-aware slice -> may stay leaky for now)
    let bB = live_count()
    let j = 0
    while j < 2000
        let tmp2 = []
        tmp2.push(mk(j))
        let _v = len(tmp2)
        j = j + 1
    let call_delta = live_count() - bB

    // (C) dict-set a fresh concat value
    let bC = live_count()
    let k = 0
    while k < 2000
        let dd = {}
        dd["k"] = "val-" + str(k)
        let _w = len(dd)
        k = k + 1
    let dictset_delta = live_count() - bC

    print("insert_leak concat=" + str(concat_delta) + " call=" + str(call_delta) + " dictset=" + str(dictset_delta))

    // Guard: the known leak must not get WORSE than the pinned baseline.
    let LB_MAX = 3000
    if concat_delta > LB_MAX or call_delta > LB_MAX or dictset_delta > LB_MAX
        print("_move6_insert_leak_test FAILED: insert leak got WORSE than baseline")
        exit(1)

    if concat_delta <= 10 and dictset_delta <= 10
        print("_move6_insert_leak_test: CONCAT/DICTSET INSERT LEAK CLOSED -- tighten + update CORE_GAPS #6")
    print("_move6_insert_leak_test passed (insert leak pinned at known baseline)")
