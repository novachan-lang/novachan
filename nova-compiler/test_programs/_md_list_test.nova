import std/text/md_list

fn cks(got, expected, label)
    if got != expected
        print("FAIL md_list " + label + ": got [" + got + "]")
        exit(1)

fn main()
    let nl = chr(10)

    // KAT-1: unordered list "- " markers, two items
    let r1 = md_list("- a" + nl + "- b")
    let e1 = "<ul>" + nl + "<li>a</li>" + nl + "<li>b</li>" + nl + "</ul>"
    cks(r1, e1, "ul dash two items")

    // KAT-2: unordered list "* " markers, two items
    let r2 = md_list("* foo" + nl + "* bar")
    let e2 = "<ul>" + nl + "<li>foo</li>" + nl + "<li>bar</li>" + nl + "</ul>"
    cks(r2, e2, "ul star two items")

    // KAT-3: ordered list, two items
    let r3 = md_list("1. x" + nl + "2. y")
    let e3 = "<ol>" + nl + "<li>x</li>" + nl + "<li>y</li>" + nl + "</ol>"
    cks(r3, e3, "ol two items")

    // KAT-4: single unordered item
    let r4 = md_list("- only")
    let e4 = "<ul>" + nl + "<li>only</li>" + nl + "</ul>"
    cks(r4, e4, "ul single item")

    // KAT-5: single ordered item
    let r5 = md_list("1. solo")
    let e5 = "<ol>" + nl + "<li>solo</li>" + nl + "</ol>"
    cks(r5, e5, "ol single item")

    // KAT-6: ordered list multi-digit number
    let r6 = md_list("10. ten" + nl + "11. eleven")
    let e6 = "<ol>" + nl + "<li>ten</li>" + nl + "<li>eleven</li>" + nl + "</ol>"
    cks(r6, e6, "ol multi-digit numbers")

    print("PASS _md_list_test")
