fn main()
    let d = {"a": 1, "b": 2, "c": 3}
    let val = get(d, "a", -1)
    print(val)
    let val2 = get(d, "z", -1)
    print(val2)
    let nums = [3, 1, 4, 1, 5]
    print(min(nums))
    print(max(nums))
    print(sum(nums))
    let s = "hello world"
    let parts = split(s, " ")
    print(parts)
    let joined = join(parts, "-")
    print(joined)
