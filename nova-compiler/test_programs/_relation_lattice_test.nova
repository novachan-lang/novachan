import std/relation/relation_lattice

fn cki(label, got, want)
    if got != want
        print("FAIL _relation_lattice_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    if got != want
        print("FAIL _relation_lattice_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckl: compare two int lists by length and element equality.
fn ckl(label, got, want)
    if len(got) != len(want)
        print("FAIL _relation_lattice_test " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL _relation_lattice_test " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

// ckm: compare two n×n matrices for equality.
fn ckm(label, A, B, n)
    let i = 0
    while i < n
        let j = 0
        while j < n
            if A[i][j] != B[i][j]
                print("FAIL _relation_lattice_test " + label + " at [" + str(i) + "][" + str(j) + "]: got=" + str(A[i][j]) + " want=" + str(B[i][j]))
                exit(1)
            j = j + 1
        i = i + 1

fn main()
    // ==========================================================================
    // KAT 1: Divisibility lattice on {1,2,4} (n=3; index 0->1, 1->2, 2->4).
    // M[i][j] = 1 iff val[i] divides val[j].
    // 1|1, 1|2, 1|4, 2|2, 2|4, 4|4
    // So the partial order matrix is:
    //   row0: [1,1,1]  (1 divides all)
    //   row1: [0,1,1]  (2 divides 2 and 4)
    //   row2: [0,0,1]  (4 divides only 4)
    // ==========================================================================
    let row0 = []
    push(row0, 1)
    push(row0, 1)
    push(row0, 1)
    let row1 = []
    push(row1, 0)
    push(row1, 1)
    push(row1, 1)
    let row2 = []
    push(row2, 0)
    push(row2, 0)
    push(row2, 1)
    let div124 = []
    push(div124, row0)
    push(div124, row1)
    push(div124, row2)

    // is_lattice = 1 (divisibility on {1,2,4} is a chain, hence a lattice)
    cki("div124_is_lattice", rlat_is_lattice(div124, 3), 1)

    // is_chain = 1 (totally ordered: 1|2|4)
    cki("div124_is_chain", rlat_is_chain(div124, 3), 1)

    // top = index 2 (value 4, divisible by all)
    cki("div124_top", rlat_top(div124, 3), 2)

    // bottom = index 0 (value 1, divides all)
    cki("div124_bottom", rlat_bottom(div124, 3), 0)

    // lub(idx=0, idx=1): LUB of val-1 and val-2 = val-2 = idx 1
    cki("div124_lub_0_1", rlat_lub(div124, 3, 0, 1), 1)

    // lub(idx=1, idx=2): LUB of val-2 and val-4 = val-4 = idx 2
    cki("div124_lub_1_2", rlat_lub(div124, 3, 1, 2), 2)

    // glb(idx=1, idx=2): GLB of val-2 and val-4 = val-2 = idx 1
    cki("div124_glb_1_2", rlat_glb(div124, 3, 1, 2), 1)

    // glb(idx=0, idx=2): GLB of val-1 and val-4 = val-1 = idx 0
    cki("div124_glb_0_2", rlat_glb(div124, 3, 0, 2), 0)

    // lub(a,a) = a (reflexive)
    cki("div124_lub_self", rlat_lub(div124, 3, 1, 1), 1)

    // ==========================================================================
    // KAT 2: Diamond poset  n=4: 0<1, 0<2, 1<3, 2<3  (bottom=0, top=3, a=1, b=2)
    // Partial order matrix (reflexive + given relations + transitive closure):
    //   M[0][0]=1, M[0][1]=1, M[0][2]=1, M[0][3]=1
    //   M[1][1]=1, M[1][3]=1
    //   M[2][2]=1, M[2][3]=1
    //   M[3][3]=1
    // ==========================================================================
    let d0 = []
    push(d0, 1)
    push(d0, 1)
    push(d0, 1)
    push(d0, 1)
    let d1 = []
    push(d1, 0)
    push(d1, 1)
    push(d1, 0)
    push(d1, 1)
    let d2 = []
    push(d2, 0)
    push(d2, 0)
    push(d2, 1)
    push(d2, 1)
    let d3 = []
    push(d3, 0)
    push(d3, 0)
    push(d3, 0)
    push(d3, 1)
    let diamond = []
    push(diamond, d0)
    push(diamond, d1)
    push(diamond, d2)
    push(diamond, d3)

    // is_lattice = 1 (diamond is a classic lattice)
    cki("diamond_is_lattice", rlat_is_lattice(diamond, 4), 1)

    // is_chain = 0 (1 and 2 are incomparable)
    cki("diamond_is_chain", rlat_is_chain(diamond, 4), 0)

    // bottom = 0, top = 3
    cki("diamond_bottom", rlat_bottom(diamond, 4), 0)
    cki("diamond_top", rlat_top(diamond, 4), 3)

    // lub(1,2) = 3 (the unique upper bound of the two middle elements)
    cki("diamond_lub_1_2", rlat_lub(diamond, 4, 1, 2), 3)

    // glb(1,2) = 0 (the unique lower bound)
    cki("diamond_glb_1_2", rlat_glb(diamond, 4, 1, 2), 0)

    // lub(0,3) = 3 (top is UB)
    cki("diamond_lub_0_3", rlat_lub(diamond, 4, 0, 3), 3)

    // ==========================================================================
    // KAT 3: N-poset (two minimal upper bounds => NOT a lattice).
    // n=4: bottom=0, a=1, b=2, c=3; 0<1, 0<2, 0<3... we need a case where two
    // elements have TWO incomparable minimal upper bounds. Use n=5:
    //   0<2, 0<3, 1<2, 1<3 (i.e., 2 and 3 are BOTH upper bounds of {0,1} with no order between them)
    // Partial order (reflexive + above):
    //   M[0][0]=1, M[0][2]=1, M[0][3]=1
    //   M[1][1]=1, M[1][2]=1, M[1][3]=1
    //   M[2][2]=1
    //   M[3][3]=1
    //   M[4][4]=1  (element 4 isolated)
    // lub(0,1): upper bounds = {2,3,and any above them}. Both 2 and 3 are minimal UBs => no unique LUB.
    // ==========================================================================
    let n0 = []
    push(n0, 1)
    push(n0, 0)
    push(n0, 1)
    push(n0, 1)
    push(n0, 0)
    let n1 = []
    push(n1, 0)
    push(n1, 1)
    push(n1, 1)
    push(n1, 1)
    push(n1, 0)
    let n2 = []
    push(n2, 0)
    push(n2, 0)
    push(n2, 1)
    push(n2, 0)
    push(n2, 0)
    let n3 = []
    push(n3, 0)
    push(n3, 0)
    push(n3, 0)
    push(n3, 1)
    push(n3, 0)
    let n4 = []
    push(n4, 0)
    push(n4, 0)
    push(n4, 0)
    push(n4, 0)
    push(n4, 1)
    let nposet = []
    push(nposet, n0)
    push(nposet, n1)
    push(nposet, n2)
    push(nposet, n3)
    push(nposet, n4)

    // lub(0,1) should be -1 (two minimal upper bounds 2 and 3, not unique)
    cki("nposet_lub_0_1", rlat_lub(nposet, 5, 0, 1), -1)

    // is_lattice = 0 (because pair (0,1) has no unique lub)
    cki("nposet_is_lattice", rlat_is_lattice(nposet, 5), 0)

    // ==========================================================================
    // KAT 4: is_antichain tests
    // In the diamond poset, elements 1 and 2 are incomparable => antichain.
    // ==========================================================================
    // pairs = [[1,2]]: elements 1 and 2 appear; in diamond M[1][2]=0 and M[2][1]=0 => antichain
    let pairs_ac = []
    let p12 = []
    push(p12, 1)
    push(p12, 2)
    push(pairs_ac, p12)
    cki("diamond_antichain_1_2", rlat_is_antichain(diamond, 4, pairs_ac), 1)

    // pairs = [[0,3]]: 0<=3 in diamond => NOT antichain
    let pairs_not = []
    let p03 = []
    push(p03, 0)
    push(p03, 3)
    push(pairs_not, p03)
    cki("diamond_not_antichain_0_3", rlat_is_antichain(diamond, 4, pairs_not), 0)

    // ==========================================================================
    // KAT 5: n=0 edge cases
    // ==========================================================================
    let empty = []
    cki("n0_is_lattice", rlat_is_lattice(empty, 0), 1)
    cki("n0_is_chain", rlat_is_chain(empty, 0), 1)
    cki("n0_top", rlat_top(empty, 0), -1)
    cki("n0_bottom", rlat_bottom(empty, 0), -1)

    // ==========================================================================
    // KAT 6: n=1 trivial lattice (single element)
    // ==========================================================================
    let r1 = []
    push(r1, 1)
    let single = []
    push(single, r1)
    cki("n1_is_lattice", rlat_is_lattice(single, 1), 1)
    cki("n1_top", rlat_top(single, 1), 0)
    cki("n1_bottom", rlat_bottom(single, 1), 0)
    cki("n1_lub_0_0", rlat_lub(single, 1, 0, 0), 0)
    cki("n1_glb_0_0", rlat_glb(single, 1, 0, 0), 0)

    print("PASS _relation_lattice_test")
