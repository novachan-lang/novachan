// Character-class builtins: classify the first char of a string. Empty -> false.
// is_space / is_upper / is_lower / is_digit / is_alpha / is_alnum, function + UFCS forms.

// is_space
if not is_space(" ")
    print("FAIL is_space space")
    exit(1)
if is_space("x")
    print("FAIL is_space x")
    exit(1)
if is_space("")
    print("FAIL is_space empty")
    exit(1)
if not is_space("\t")
    print("FAIL is_space tab")
    exit(1)

// is_upper
if not is_upper("A")
    print("FAIL is_upper A")
    exit(1)
if is_upper("a")
    print("FAIL is_upper a")
    exit(1)
if is_upper("5")
    print("FAIL is_upper 5")
    exit(1)
if is_upper("")
    print("FAIL is_upper empty")
    exit(1)

// is_lower
if not is_lower("z")
    print("FAIL is_lower z")
    exit(1)
if is_lower("Z")
    print("FAIL is_lower Z")
    exit(1)

// is_digit (compiler also defines this locally -> the builtin must still serve user code)
if not is_digit("7")
    print("FAIL is_digit 7")
    exit(1)
if is_digit("a")
    print("FAIL is_digit a")
    exit(1)
if is_digit(" ")
    print("FAIL is_digit space")
    exit(1)

// is_alpha
if not is_alpha("Q")
    print("FAIL is_alpha Q")
    exit(1)
if not is_alpha("q")
    print("FAIL is_alpha q")
    exit(1)
if is_alpha("3")
    print("FAIL is_alpha 3")
    exit(1)

// is_alnum
if not is_alnum("a")
    print("FAIL is_alnum a")
    exit(1)
if not is_alnum("9")
    print("FAIL is_alnum 9")
    exit(1)
if is_alnum("!")
    print("FAIL is_alnum bang")
    exit(1)
if is_alnum(" ")
    print("FAIL is_alnum space")
    exit(1)

// UFCS method forms: c.is_upper() etc.
cu = "A"
if not cu.is_upper()
    print("FAIL UFCS is_upper")
    exit(1)
cd = "5"
if not cd.is_digit()
    print("FAIL UFCS is_digit")
    exit(1)
cs = " "
if not cs.is_space()
    print("FAIL UFCS is_space")
    exit(1)
cn = "z"
if not cn.is_alnum()
    print("FAIL UFCS is_alnum")
    exit(1)
if cn.is_upper()
    print("FAIL UFCS is_upper neg")
    exit(1)

print("char_class PASS")
