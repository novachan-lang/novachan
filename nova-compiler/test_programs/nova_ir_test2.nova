// Test: Build IR from a simple function AST and verify structure

// Include necessary types (would normally be imported)
type IrType
    kind: string
    name: string
    params: list
    id: int

type IrInst
    op: string
    dest: string
    type: IrType
    args: list
    value: string
    num: int
    effect: string

type IrBlock
    label: string
    insts: list
    terminator: IrInst

type IrParam
    name: string
    type: IrType

type IrFunction
    name: string
    params: list
    ret_type: IrType
    blocks: list
    type_params: list
    is_extern: int

fn ir_type_int() -> IrType
    IrType("int", "", [], 0)

fn ir_type_any() -> IrType
    IrType("any", "", [], 0)

fn ir_type_void() -> IrType
    IrType("void", "", [], 0)

fn ir_inst(op: string, dest: string, typ: IrType, args: list, value: string, num: int) -> IrInst
    IrInst(op, dest, typ, args, value, num, "pure")

// Build a simple function: fn add(a, b) -> a + b
fn build_add_fn() -> IrFunction
    let params = [IrParam("a", ir_type_int()), IrParam("b", ir_type_int())]
    let insts = []
    // Load a
    push(insts, ir_inst("slot_load", "%r0", ir_type_int(), [], "a", 0))
    // Load b
    push(insts, ir_inst("slot_load", "%r1", ir_type_int(), [], "b", 0))
    // Add them (direct integer add — no runtime call!)
    push(insts, ir_inst("add", "%r2", ir_type_int(), ["%r0", "%r1"], "+", 0))
    // Return
    let term = ir_inst("return", "", ir_type_void(), ["%r2"], "", 0)
    let entry = IrBlock("entry", insts, term)
    IrFunction("add", params, ir_type_int(), [entry], [], 0)

// Verify the IR structure
let add_fn = build_add_fn()
match add_fn
    IrFunction(name, params, ret_type, blocks, type_params, is_extern) =>
        print("fn: " + name)
        print("params: " + str(len(params)))
        match ret_type
            IrType(kind, n, p, id) =>
                print("returns: " + kind)
        print("blocks: " + str(len(blocks)))
        match blocks[0]
            IrBlock(label, insts, term) =>
                print("block: " + label)
                print("insts: " + str(len(insts)))
                // Check that the add instruction is direct int add, not a runtime call
                match insts[2]
                    IrInst(op, dest, typ, args, value, num, effect) =>
                        print("add op: " + op)
                        match typ
                            IrType(tk, tn, tp, tid) =>
                                print("add type: " + tk)
                        print("add effect: " + effect)
                        if op == "add" and tk == "int" and effect == "pure"
                            print("PASS: Direct integer add (zero overhead)")
                        else
                            print("FAIL: Expected direct int add")
                match term
                    IrInst(op, dest, typ, args, value, num, effect) =>
                        print("terminator: " + op)
                        if op == "return"
                            print("PASS: Function returns correctly")
