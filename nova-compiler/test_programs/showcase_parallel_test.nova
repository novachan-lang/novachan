// showcase_parallel -- a parallel map-reduce in pure NOVA: split a range across workers, each worker
// computes a partial result over its chunk and sends it back over a channel, and the main process
// reduces the partials. A FIFTH subsystem: the CONCURRENCY runtime (spawn, channels, send/receive,
// deep-copy process isolation) -- distinct from HTTP/DB, strings/dicts, floats, and recursion. Results
// are order-independent so this is deterministic and self-verifying against closed-form answers.

// Worker: sum of squares over [lo, hi); sends the partial to the result channel.
fn sq_worker(ch, lo: int, hi: int)
    let s = 0
    let i = lo
    while i < hi
        s = s + i * i
        i = i + 1
    send(ch, s)

// Worker that returns a LIST built in isolation (exercises escape-through-channel: the list must
// retain its data across the send, and the receiver owns an isolated copy).
fn list_worker(ch, lo: int, hi: int)
    let xs = []
    let i = lo
    while i < hi
        push(xs, i * 2)
        i = i + 1
    send(ch, xs)

fn main()
    let N = 100
    let K = 4
    let chunk = N / K

    // --- parallel sum of squares over [0, N) ---
    let ch = channel()
    let w = 0
    while w < K
        let lo = w * chunk
        let hi = lo + chunk
        spawn sq_worker(ch, lo, hi)
        w = w + 1

    let total = 0
    let got = 0
    while got < K
        let part = receive(ch)
        total = total + part
        got = got + 1

    // closed form: sum_{i=0}^{99} i^2 = 99*100*199/6 = 328350
    print("parallel sum of squares [0,100) = " + str(total) + " (want 328350)")
    assert(total == 328350, "parallel sum of squares matches closed form")

    // --- sequential reference (proves the parallel result is not luck) ---
    let seq = 0
    let j = 0
    while j < N
        seq = seq + j * j
        j = j + 1
    assert(total == seq, "parallel result equals sequential")

    // --- parallel list building: each worker returns an isolated list; concatenate + sum ---
    let ch2 = channel()
    let w2 = 0
    while w2 < K
        let lo = w2 * chunk
        let hi = lo + chunk
        spawn list_worker(ch2, lo, hi)
        w2 = w2 + 1

    let listsum = 0
    let nlists = 0
    let elems = 0
    while nlists < K
        let part = receive(ch2)
        let p = 0
        while p < len(part)
            listsum = listsum + part[p]
            p = p + 1
        elems = elems + len(part)
        nlists = nlists + 1

    // sum over all workers of (i*2) for i in [0,100) = 2 * sum_{0..99} i = 2 * 4950 = 9900
    print("parallel list build: " + str(elems) + " elems, sum=" + str(listsum) + " (want 100 elems, 9900)")
    assert(elems == 100, "all worker list elements received (isolation retained data)")
    assert(listsum == 9900, "parallel list sum matches closed form")

    print("showcase_parallel_test passed -- spawn + channels + map-reduce + isolation, pure NOVA")
