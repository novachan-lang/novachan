import std/grammar/grammar_elim

fn main()
    // Build E -> T E1, E1 -> + T E1 | eps, T -> id manually
    let prods = []
    let r1 = []
    r1.push("T")
    r1.push("E1")
    prods.push(["E", r1])
    let r2 = []
    r2.push("+")
    r2.push("T")
    r2.push("E1")
    prods.push(["E1", r2])
    let r3 = []
    prods.push(["E1", r3])
    let r4 = []
    r4.push("id")
    prods.push(["T", r4])

    let tok = []
    tok.push("id")

    // Test with increasing steps
    let res10 = grel_recognizes(prods, "E", tok, 10)
    let res20 = grel_recognizes(prods, "E", tok, 20)
    let res50 = grel_recognizes(prods, "E", tok, 50)
    print("steps10=" + str(res10) + " steps20=" + str(res20) + " steps50=" + str(res50))
