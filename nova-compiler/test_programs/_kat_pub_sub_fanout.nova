import forge_pub_sub_fanout

fn main()
    let psf = psf_new()
    psf = psf_create_topic(psf, "orders")
    psf = psf_create_topic(psf, "notifications")
    assert(psf_topic_count(psf) == 2, "2 topics")

    psf = psf_subscribe(psf, "orders", "analytics")
    psf = psf_subscribe(psf, "orders", "warehouse")
    psf = psf_subscribe(psf, "orders", "billing")
    psf = psf_subscribe(psf, "notifications", "email-svc")
    assert(psf_subscriber_count(psf, "orders") == 3, "3 subs on orders")

    let d1 = psf_publish(psf, "orders", "order-1")
    assert(d1 == 3, "fan-out to 3")
    let d2 = psf_publish(psf, "orders", "order-2")
    assert(d2 == 3, "again 3")

    assert(psf_subscriber_received(psf, "orders", "analytics") == 2, "analytics got 2")
    assert(psf_subscriber_received(psf, "orders", "billing") == 2, "billing got 2")
    assert(psf_total_deliveries(psf) == 6, "6 total deliveries")
    assert(psf_topic_messages(psf, "orders") == 2, "2 messages on orders")

    let d3 = psf_publish(psf, "notifications", "welcome")
    assert(d3 == 1, "1 sub on notifications")
    assert(psf_subscriber_received(psf, "notifications", "email-svc") == 1, "email got 1")

    let no_topic = psf_publish(psf, "nonexistent", "msg")
    assert(no_topic == 0, "no topic = 0 deliveries")

    assert(psf_subscriber_received(psf, "orders", "nobody") == 0, "no sub = 0")

    print("PUB-SUB-FANOUT KAT PASS")
