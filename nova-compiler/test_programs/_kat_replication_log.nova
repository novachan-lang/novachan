import forge_replication_log

fn main()
    let r = rl_new()
    assert(rl_total_entries(r) == 0, "0 entries initially")
    assert(rl_committed_count(r) == 0, "0 committed initially")

    r = rl_append(r, "set x=1", 1)
    r = rl_append(r, "set y=2", 1)
    r = rl_append(r, "del x", 2)
    assert(rl_total_entries(r) == 3, "3 entries")

    let e0 = rl_get(r, 0)
    assert(is_ok(e0), "get 0 ok")
    assert(unwrap(e0) == "set x=1", "entry 0 value")

    let t0 = rl_term_at(r, 0)
    assert(is_ok(t0), "term 0 ok")
    assert(unwrap(t0) == 1, "entry 0 term")

    let t2 = rl_term_at(r, 2)
    assert(is_ok(t2), "term 2 ok")
    assert(unwrap(t2) == 2, "entry 2 term")

    let lt = rl_last_term(r)
    assert(is_ok(lt), "last term ok")
    assert(unwrap(lt) == 2, "last term is 2")

    let bad_get = rl_get(r, 10)
    assert(is_err(bad_get), "get out of range")

    let bad_term = rl_term_at(r, -1)
    assert(is_err(bad_term), "term out of range")

    let c1 = rl_commit(r, 1)
    assert(is_ok(c1), "commit 1 ok")
    r = unwrap(c1)
    assert(rl_committed_count(r) == 2, "2 committed (0,1)")

    let c2 = rl_commit(r, 0)
    assert(is_err(c2), "commit backwards fails")

    let c3 = rl_commit(r, 2)
    assert(is_ok(c3), "commit 2 ok")
    r = unwrap(c3)
    assert(rl_committed_count(r) == 3, "3 committed")

    let c4 = rl_commit(r, 5)
    assert(is_err(c4), "commit out of range fails")

    let empty = rl_new()
    let bad_last = rl_last_term(empty)
    assert(is_err(bad_last), "last term on empty log fails")

    print("REPLICATION-LOG KAT PASS")
