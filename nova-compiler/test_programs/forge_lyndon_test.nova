import forge_lyndon as ly

fn check(cond: bool, label: string)
    if cond == false
        print("FAIL: " + label)

fn lcg(state: int) -> int
    (state * 1103515245 + 12345) % 2147483648

// lexicographic less-than on byte strings
fn str_less(a: string, b: string) -> bool
    let i = 0
    let out = false
    let decided = false
    while i < len(a) and i < len(b) and decided == false
        let ca = ord(char_at(a, i))
        let cb = ord(char_at(b, i))
        if ca < cb
            out = true
            decided = true
        else
            if ca > cb
                out = false
                decided = true
        i = i + 1
    if decided == false
        out = len(a) < len(b)
    out

// brute-force smallest rotation
fn brute_smallest(s: string) -> string
    let m = len(s)
    let best = s
    let r = 1
    while r < m
        let rot = slice(s, r, m) + slice(s, 0, r)
        if str_less(rot, best)
            best = rot
        r = r + 1
    best

// brute-force is-Lyndon: strictly smaller than all proper rotations
fn brute_is_lyndon(s: string) -> bool
    let m = len(s)
    let out = true
    if m == 0
        out = false
    else
        let r = 1
        while r < m
            let rot = slice(s, r, m) + slice(s, 0, r)
            if str_less(rot, s) or rot == s
                out = false
            r = r + 1
    out

// random lowercase string over a small alphabet (to force repeats)
fn rand_str(length: int, alpha: int, seed: int) -> string
    let out = ""
    let s = seed
    let i = 0
    while i < length
        s = lcg(s)
        out = out + chr(97 + (s % alpha))
        i = i + 1
    out

fn main()
    // ---- known factorizations ----
    let f = ly.lyndon_factorization("banana")
    check(len(f) == 4, "banana factors into 4")
    check(f[0] == "b" and f[1] == "an" and f[2] == "an" and f[3] == "a", "banana = b|an|an|a")

    // ---- is_lyndon ----
    check(ly.is_lyndon("a"), "a is Lyndon")
    check(ly.is_lyndon("ab"), "ab is Lyndon")
    check(ly.is_lyndon("aab"), "aab is Lyndon")
    check(ly.is_lyndon("abc"), "abc is Lyndon")
    check(ly.is_lyndon("aa") == false, "aa not Lyndon")
    check(ly.is_lyndon("aba") == false, "aba not Lyndon")
    check(ly.is_lyndon("ba") == false, "ba not Lyndon")

    // ---- smallest_rotation fixed ----
    check(ly.smallest_rotation("cba") == "acb", "smallest rot cba = acb")
    check(ly.smallest_rotation("banana") == "abanan", "smallest rot banana = abanan")
    check(ly.smallest_rotation("aaa") == "aaa", "smallest rot aaa = aaa")

    // ---- BIG brute self-checks over random strings ----
    let st = 7777777
    let trial = 0
    while trial < 120
        st = lcg(st)
        let length = 1 + (st % 10)
        st = lcg(st)
        let alpha = 2 + (st % 3)   // alphabet size 2..4
        let s = rand_str(length, alpha, st + 5)

        // smallest_rotation matches brute
        check(ly.smallest_rotation(s) == brute_smallest(s), "smallest matches brute trial " + str(trial))

        // is_lyndon matches brute
        check(ly.is_lyndon(s) == brute_is_lyndon(s), "is_lyndon matches brute trial " + str(trial))

        // factorization: concatenation == s, each factor is Lyndon, factors non-increasing
        let fac = ly.lyndon_factorization(s)
        let joined = ""
        let fi = 0
        while fi < len(fac)
            joined = joined + fac[fi]
            check(ly.is_lyndon(fac[fi]), "factor is Lyndon trial " + str(trial))
            if fi > 0
                // non-increasing: previous factor >= this one -> NOT (prev < this)
                check(str_less(fac[fi - 1], fac[fi]) == false, "factors non-increasing trial " + str(trial))
            fi = fi + 1
        check(joined == s, "factors concat == s trial " + str(trial))
        trial = trial + 1

    print("forge_lyndon: all passed")
