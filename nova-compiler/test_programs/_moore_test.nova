import std/automata/moore

// Build the parity Moore machine.
// States: "even" (output "E"), "odd" (output "O").
// On input '1' toggle parity; on input '0' stay.
// Transitions:
//   even:0 -> even,  even:1 -> odd
//   odd:0  -> odd,   odd:1  -> even
fn make_parity() -> dict
    let m = mor_new("even")
    mor_set_output(m, "even", "E")
    mor_set_output(m, "odd", "O")
    mor_add(m, "even", "0", "even")
    mor_add(m, "even", "1", "odd")
    mor_add(m, "odd", "0", "odd")
    mor_add(m, "odd", "1", "even")
    return m

fn main()
    let parity = make_parity()

    // KAT 1: single '1' input visits states even -> odd, outputs "EO"
    let r1 = mor_run(parity, "1")
    if r1 != "EO"
        print("FAIL KAT1: mor_run parity '1' expected EO got " + r1)
        exit(1)

    // KAT 2: input "11" visits even -> odd -> even, outputs "EOE"
    let r2 = mor_run(parity, "11")
    if r2 != "EOE"
        print("FAIL KAT2: mor_run parity '11' expected EOE got " + r2)
        exit(1)

    // KAT 3: empty input visits only start state, outputs "E"
    let r3 = mor_run(parity, "")
    if r3 != "E"
        print("FAIL KAT3: mor_run parity '' expected E got " + r3)
        exit(1)

    // KAT 4: mor_final_output "111" -> visits even->odd->even->odd, final = "O"
    let r4 = mor_final_output(parity, "111")
    if r4 != "O"
        print("FAIL KAT4: mor_final_output parity '111' expected O got " + r4)
        exit(1)

    // KAT 5: mor_final_output "" -> stays at start "even", output "E"
    let r5 = mor_final_output(parity, "")
    if r5 != "E"
        print("FAIL KAT5: mor_final_output parity '' expected E got " + r5)
        exit(1)

    // KAT 6: a machine whose start state outputs "S" begins its run string with "S"
    let m2 = mor_new("start")
    mor_set_output(m2, "start", "S")
    mor_set_output(m2, "next", "N")
    mor_add(m2, "start", "x", "next")
    let r6 = mor_run(m2, "x")
    if r6 != "SN"
        print("FAIL KAT6: start-outputs-S machine got " + r6)
        exit(1)

    print("_moore_test passed")
