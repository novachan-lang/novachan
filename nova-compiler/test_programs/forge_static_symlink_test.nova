// forge_static_symlink_test -- T1.7 static-mount symlink/realpath containment.
// Layer 1 (_safe_subpath textual whitelist) already blocks ../dotfile/backslash textually; this test
// covers Layer 2: forge.path_within (nova_rt_path_within) rejects a path that RESOLVES outside the mount
// root via a symlink/junction. Deterministic predicate coverage runs everywhere; the live junction-
// resolution proof is best-effort (Windows junctions need no admin) and can only PASS or SKIP.
import forge

fn main()
    mkdir("_sw_root")
    mkdir("_sw_out")
    write_file("_sw_root/ok.txt", "hi")
    write_file("_sw_out/secret.txt", "s")

    // ── Predicate: inside -> within; sibling dir outside -> not; nonexistent -> fail-closed not ──────
    assert(forge.path_within("_sw_root", "_sw_root/ok.txt"), "file inside mount -> within")
    assert(not forge.path_within("_sw_root", "_sw_out/secret.txt"), "sibling dir OUTSIDE mount -> not within")
    assert(not forge.path_within("_sw_root", "_sw_root/nope.txt"), "nonexistent path -> fail-closed (not within)")
    print("PASS: path_within inside / outside / nonexistent")

    // ── Dispatch smoke: a legit in-root file still serves 200 (path_within did not break normal serving) ─
    let a = forge.app()
    forge.static(a, "/s", "_sw_root")
    let r = forge.dispatch_test(a, forge.mock_request("GET", "/s/ok.txt", ""))
    assert(forge.status_of(r) == 200, "static serve of a real in-root file -> 200 (got " + str(forge.status_of(r)) + ")")
    print("PASS: static serve in-root file -> 200")

    // ── Best-effort: prove a symlink/junction escaping root is RESOLVED and rejected ─────────────────
    let q = chr(34)
    system("cd > _sw_cwd.txt")
    let cwd = trim(read_file("_sw_cwd.txt"))
    if len(cwd) > 0
        let target = cwd + "\\_sw_out"
        system("mklink /J " + q + "_sw_root\\escape" + q + " " + q + target + q + " > _sw_ml.txt 2>&1")
        if file_exists("_sw_root/escape/secret.txt")
            // The junction is inside _sw_root but traverses to _sw_out (outside). Containment MUST reject it.
            assert(not forge.path_within("_sw_root", "_sw_root/escape/secret.txt"), "junction escaping root -> NOT within (symlink resolved by realpath)")
            let r2 = forge.dispatch_test(a, forge.mock_request("GET", "/s/escape/secret.txt", ""))
            assert(forge.status_of(r2) != 200, "serving THROUGH an escaping junction must not 200 (got " + str(forge.status_of(r2)) + ")")
            print("PASS: symlink/junction escape resolved + rejected (served status " + str(forge.status_of(r2)) + ")")
            system("rmdir " + q + "_sw_root\\escape" + q)
        else
            print("SKIP: junction not created (no mklink/privilege) -- predicate test carries containment")

    // ── cleanup ─────────────────────────────────────────────────────────────────────────────────────
    remove_file("_sw_root/ok.txt")
    remove_file("_sw_out/secret.txt")
    remove_file("_sw_cwd.txt")
    remove_file("_sw_ml.txt")
    system("rmdir " + q + "_sw_root" + q)
    system("rmdir " + q + "_sw_out" + q)
    print("forge_static_symlink_test passed")
