import std/greedy/min_cost_ropes

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _min_cost_ropes_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── mcr_min_cost ────────────────────────────────────────────────────────
    // KAT vectors from spec:
    // [4,3,2,6]: merge 2+3=5(cost5), merge 4+5=9(cost9), merge 6+9=15(cost15) => 5+9+15=29
    cki("spec1", mcr_min_cost([4, 3, 2, 6]), 29)
    // [1,2,3,4,5]: merge 1+2=3(3), 3+3=6(6), 4+6=10(10), 5+10=15(15) => 3+6+10+14=33
    //   let's verify: after step1 arr=[3,3,4,5], step2: merge 3+3=6(cost6) arr=[4,5,6],
    //   step3: merge 4+5=9(cost9) arr=[6,9], step4: merge 6+9=15(cost15). total=3+6+9+15=33
    cki("spec2", mcr_min_cost([1, 2, 3, 4, 5]), 33)
    // single rope => 0
    cki("spec3", mcr_min_cost([5]), 0)
    // empty => 0
    cki("spec4", mcr_min_cost([]), 0)
    // two ropes: 1+1=2
    cki("spec5", mcr_min_cost([1, 1]), 2)
    // [2,2,3,3]: merge 2+2=4(cost4), merge 3+3=6(cost6), merge 4+6=10(cost10). total=20
    cki("spec6", mcr_min_cost([2, 2, 3, 3]), 20)
    // additional cases:
    // two different ropes: 3+7=10
    cki("two_diff", mcr_min_cost([3, 7]), 10)
    // three equal: merge 1+1=2(cost2), merge 1+2=3(cost3) => 5
    cki("three_eq", mcr_min_cost([1, 1, 1]), 5)
    // large single merge: [10,20] => 30
    cki("large_two", mcr_min_cost([10, 20]), 30)
    // already sorted input: [1,2,4,8] merge 1+2=3(3), 3+4=7(7), 7+8=15(15) => 25
    cki("sorted4", mcr_min_cost([1, 2, 4, 8]), 25)

    print("PASS _min_cost_ropes_test")
