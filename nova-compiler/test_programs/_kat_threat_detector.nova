import forge_threat_detector

fn main()
    let d = td_new()

    // fresh detector: no rules, no alerts
    assert(td_rule_count(d) == 0, "0 rules initially")
    assert(td_alert_count(d) == 0, "0 alerts initially")
    let none = td_last_alert(d)
    assert(is_err(none), "no last alert on fresh detector")

    d = td_add_rule(d, "sql_injection", "UNION SELECT", 4)
    d = td_add_rule(d, "xss_attempt", "javascript:", 3)
    d = td_add_rule(d, "path_traversal", "../../", 2)
    assert(td_rule_count(d) == 3, "3 rules registered")
    assert(td_has_rule(d, "sql_injection") == 1, "has sql_injection")
    assert(td_has_rule(d, "nonexistent") == 0, "no nonexistent rule")

    let r1 = td_check(d, "http_request", "GET /search?q=UNION SELECT * FROM users")
    assert(is_ok(r1), "r1 ok")
    assert(unwrap(r1) == "sql_injection", "r1 matched sql_injection")

    let r2 = td_check(d, "http_request", "GET /index.html")
    assert(is_ok(r2), "r2 ok")
    assert(unwrap(r2) == "clean", "r2 clean")

    let r3 = td_check(d, "http_request", "GET /x?u=javascript:alert(1)")
    assert(is_ok(r3), "r3 ok")
    assert(unwrap(r3) == "xss_attempt", "r3 matched xss_attempt")

    assert(td_alert_count(d) == 2, "2 alerts total")

    let last = td_last_alert(d)
    assert(is_ok(last), "last alert present")
    assert(unwrap(last) == "xss_attempt", "last alert is xss_attempt")

    assert(td_alerts_by_severity(d, 4) == 1, "1 alert at severity 4")
    assert(td_alerts_by_severity(d, 3) == 1, "1 alert at severity 3")
    assert(td_alerts_by_severity(d, 2) == 0, "0 alerts at severity 2 (path_traversal never matched)")
    assert(td_alerts_by_severity(d, 5) == 0, "0 alerts at unused severity 5")

    print("THREAT-DETECTOR KAT PASS")
