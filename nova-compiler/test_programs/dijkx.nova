// dijkx.nova — Dijkstra's WEIGHTED shortest-path (graphx has only unweighted BFS).
//
// Finds the minimum total edge-weight from a start node to every reachable node
// — the foundation of routing, network latency, pathfinding, and cost
// optimization. Graph = {node: [[neighbor, weight], ...]} with non-negative
// weights. Array-based O(V^2) selection (clear + dependency-free).

fn dijkstra(graph, start)
  let INF = 1000000000
  let dist = {}
  // every node that appears as a source OR a neighbor starts at INF
  for node in keys(graph)
    dist[node] = INF
    for edge in graph[node]
      if not contains(dist, edge[0])
        dist[edge[0]] = INF
  dist[start] = 0
  let visited = {}
  let total = len(keys(dist))
  let processed = 0
  while processed < total
    // pick the unvisited node with the smallest tentative distance
    let u = ""
    let best = INF + 1
    for node in keys(dist)
      if not contains(visited, node) and dist[node] < best
        best = dist[node]
        u = node
    if u == ""
      processed = total            // remaining nodes are unreachable
    else
      visited[u] = 1
      processed = processed + 1
      if contains(graph, u)
        for edge in graph[u]
          let v = edge[0]
          let nd = dist[u] + edge[1]
          if nd < dist[v]
            dist[v] = nd
  dist

// convenience: shortest distance start->target (the INF sentinel if unreachable).
fn shortest(graph, start, target)
  let d = dijkstra(graph, start)
  if contains(d, target)
    return d[target]
  1000000000

// ── Tests ────────────────────────────────────────────────────────────

// a -1-> b -2-> c, a -4-> c, b -5-> d, c -1-> d
let g = {}
g["a"] = [["b", 1], ["c", 4]]
g["b"] = [["c", 2], ["d", 5]]
g["c"] = [["d", 1]]
g["d"] = []

let dist = dijkstra(g, "a")
assert(dist["a"] == 0, "start is 0")
assert(dist["b"] == 1, "a->b = 1")
assert(dist["c"] == 3, "a->b->c = 3 (cheaper than direct a->c=4)")
assert(dist["d"] == 4, "a->b->c->d = 4 (cheaper than a->b->d=6)")
print("PASS: shortest distances via relaxation")

assert(shortest(g, "a", "d") == 4, "shortest a->d = 4")
assert(shortest(g, "b", "d") == 3, "shortest b->d = 3 (b->c->d)")
print("PASS: shortest convenience")

// unreachable node stays at INF
let g2 = {}
g2["x"] = [["y", 2]]
g2["y"] = []
g2["island"] = []
let d2 = dijkstra(g2, "x")
assert(d2["y"] == 2, "x->y = 2")
assert(d2["island"] == 1000000000, "island unreachable -> INF")
print("PASS: unreachable stays INF")

// a longer chain accumulates weight
let chain = {}
chain["n0"] = [["n1", 10]]
chain["n1"] = [["n2", 20]]
chain["n2"] = [["n3", 30]]
chain["n3"] = []
assert(shortest(chain, "n0", "n3") == 60, "10+20+30 = 60")
print("PASS: chain accumulation")

print("ALL PASS: dijkx — Dijkstra weighted shortest path")
