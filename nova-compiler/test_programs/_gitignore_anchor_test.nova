import std/devtool/gitignore_anchor

fn main()
    // --- gia_is_anchored ---
    let r1 = gia_is_anchored("foo")
    if r1 != 0
        print("FAIL gia_is_anchored-plain: got " + str(r1) + " want 0")
        exit(1)

    let r2 = gia_is_anchored("/foo")
    if r2 != 1
        print("FAIL gia_is_anchored-leading-slash: got " + str(r2) + " want 1")
        exit(1)

    let r3 = gia_is_anchored("foo/bar")
    if r3 != 1
        print("FAIL gia_is_anchored-middle-slash: got " + str(r3) + " want 1")
        exit(1)

    let r4 = gia_is_anchored("")
    if r4 != 0
        print("FAIL gia_is_anchored-empty: got " + str(r4) + " want 0")
        exit(1)

    // --- gia_strip_leading_slash ---
    let r5 = gia_strip_leading_slash("/foo")
    if r5 != "foo"
        print("FAIL gia_strip_leading_slash-present: got " + r5 + " want foo")
        exit(1)

    let r6 = gia_strip_leading_slash("foo")
    if r6 != "foo"
        print("FAIL gia_strip_leading_slash-absent: got " + r6 + " want foo")
        exit(1)

    let r7 = gia_strip_leading_slash("/")
    if r7 != ""
        print("FAIL gia_strip_leading_slash-lone-slash: got '" + r7 + "' want ''")
        exit(1)

    // --- gia_match_anchored ---
    let r8 = gia_match_anchored("foo/bar", "foo/bar")
    if r8 != 1
        print("FAIL gia_match_anchored-exact: got " + str(r8) + " want 1")
        exit(1)

    let r9 = gia_match_anchored("foo/bar", "foo/baz")
    if r9 != 0
        print("FAIL gia_match_anchored-diff: got " + str(r9) + " want 0")
        exit(1)

    let r10 = gia_match_anchored("/foo/*.txt", "foo/readme.txt")
    if r10 != 1
        print("FAIL gia_match_anchored-leading-slash-glob: got " + str(r10) + " want 1")
        exit(1)

    let r11 = gia_match_anchored("foo/*.txt", "foo/bar/readme.txt")
    if r11 != 0
        print("FAIL gia_match_anchored-star-no-cross-slash: got " + str(r11) + " want 0")
        exit(1)

    let r12 = gia_match_anchored("foo/bar", "other/foo/bar")
    if r12 != 0
        print("FAIL gia_match_anchored-not-root-relative: got " + str(r12) + " want 0")
        exit(1)

    let r13 = gia_match_anchored("build/", "build")
    if r13 != 1
        print("FAIL gia_match_anchored-trailing-slash-dirmarker: got " + str(r13) + " want 1")
        exit(1)

    let r14 = gia_match_anchored("a/b?c", "a/bxc")
    if r14 != 1
        print("FAIL gia_match_anchored-question: got " + str(r14) + " want 1")
        exit(1)

    // --- gia_match_unanchored ---
    let r15 = gia_match_unanchored("*.txt", "readme.txt")
    if r15 != 1
        print("FAIL gia_match_unanchored-star: got " + str(r15) + " want 1")
        exit(1)

    let r16 = gia_match_unanchored("foo?bar", "fooxbar")
    if r16 != 1
        print("FAIL gia_match_unanchored-question: got " + str(r16) + " want 1")
        exit(1)

    let r17 = gia_match_unanchored("foo?bar", "foobar")
    if r17 != 0
        print("FAIL gia_match_unanchored-question-requires-char: got " + str(r17) + " want 0")
        exit(1)

    let r18 = gia_match_unanchored("build/", "build")
    if r18 != 1
        print("FAIL gia_match_unanchored-trailing-slash: got " + str(r18) + " want 1")
        exit(1)

    let r19 = gia_match_unanchored("*.log", "readme.txt")
    if r19 != 0
        print("FAIL gia_match_unanchored-nomatch: got " + str(r19) + " want 0")
        exit(1)

    print("PASS _gitignore_anchor_test")
