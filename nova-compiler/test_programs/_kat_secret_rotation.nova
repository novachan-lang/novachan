import forge_secret_rotation

fn main()
    let s = sr_new()
    s = sr_set(s, "db_pass", "secret123", 1)
    assert(sr_secret_count(s) == 1, "1 secret")

    let r1 = sr_get(s, "db_pass")
    assert(r1["found"] == 1, "found")
    assert(r1["value"] == "secret123", "correct value")
    assert(r1["version"] == 1, "version 1")

    s = sr_rotate(s, "db_pass", "newsecret456")
    let r2 = sr_get(s, "db_pass")
    assert(r2["value"] == "newsecret456", "rotated value")
    assert(r2["version"] == 2, "version 2")

    assert(sr_previous(s, "db_pass") == "secret123", "previous value")
    assert(sr_total_rotations(s) == 1, "1 rotation")

    s = sr_rotate(s, "api_key", "key-abc")
    assert(sr_secret_count(s) == 2, "2 secrets")
    assert(sr_total_rotations(s) == 2, "2 rotations")

    print("SECRET-ROTATION KAT PASS")
