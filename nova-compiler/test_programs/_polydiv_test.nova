import std/poly/polydiv

fn list_eq(a, b) -> bool
    let la = len(a)
    let lb = len(b)
    if la != lb
        return false
    let i = 0
    while i < la
        if a[i] != b[i]
            return false
        i = i + 1
    true

fn ck_list(label, got, want)
    if list_eq(got, want) == false
        let gs = str(len(got))
        let ws = str(len(want))
        print("FAIL polydiv " + label + ": len got=" + gs + " want=" + ws)
        exit(1)

fn ck_int(label, got, want)
    if got != want
        print("FAIL polydiv " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck_bool(label, got, want)
    if got != want
        print("FAIL polydiv " + label + ": bool mismatch got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // KAT 1: pd_divmod([-1,0,1], [-1,1])
    // (x^2 - 1) / (x - 1) = x + 1 exactly; q=[1,1], r=[]
    let dm1 = pd_divmod([-1, 0, 1], [-1, 1])
    let q1 = dm1["q"]
    let r1 = dm1["r"]
    let wq1 = [1, 1]
    let wr1 = []
    ck_list("divmod q: x^2-1 / x-1", q1, wq1)
    ck_list("divmod r: x^2-1 / x-1", r1, wr1)

    // KAT 2: pd_quotient
    let qt2 = pd_quotient([-1, 0, 1], [-1, 1])
    let wqt2 = [1, 1]
    ck_list("pd_quotient x^2-1 / x-1 = x+1", qt2, wqt2)

    // KAT 3: pd_remainder of x^2+1 / x -> remainder = 1, quotient = x
    // x^2+1 = [1,0,1]; x = [0,1]
    let rm3 = pd_remainder([1, 0, 1], [0, 1])
    let wrm3 = [1]
    ck_list("pd_remainder x^2+1 / x = 1", rm3, wrm3)

    // KAT 4: pd_divides: (x-1) divides (x^2-1)
    let dv4 = pd_divides([-1, 0, 1], [-1, 1])
    ck_bool("pd_divides x^2-1 by x-1 = true", dv4, true)

    // KAT 5: pd_divides: (x-1) does NOT divide (x^2+1)
    let dv5 = pd_divides([1, 0, 1], [-1, 1])
    ck_bool("pd_divides x^2+1 by x-1 = false", dv5, false)

    // KAT 6: pd_synthetic of x^3 - 6x^2 + 11x - 6 by (x-1)
    // coeffs ascending: [-6, 11, -6, 1]
    // quotient = x^2 - 5x + 6 = [6, -5, 1]
    let syn6 = pd_synthetic([-6, 11, -6, 1], 1)
    let wsyn6 = [6, -5, 1]
    ck_list("pd_synthetic x^3-6x^2+11x-6 by x-1", syn6, wsyn6)

    // KAT 7: round-trip verify for several pairs
    // (x^2 - 1) / (x - 1)
    let vr7 = pd_verify([-1, 0, 1], [-1, 1], 0.0)
    ck_bool("pd_verify x^2-1 / x-1", vr7, true)

    // (x^2 + 1) / x
    let vr8 = pd_verify([1, 0, 1], [0, 1], 0.0)
    ck_bool("pd_verify x^2+1 / x", vr8, true)

    // x^3 - 6x^2 + 11x - 6 by x-1
    let vr9 = pd_verify([-6, 11, -6, 1], [-1, 1], 0.0)
    ck_bool("pd_verify cubic", vr9, true)

    // x^3 - 6x^2 + 11x - 6 by x-2 (also divides it since roots are 1,2,3)
    let vr10 = pd_verify([-6, 11, -6, 1], [-2, 1], 0.0)
    ck_bool("pd_verify cubic by x-2", vr10, true)

    // KAT 8: dividend has lower degree than divisor -> q=[], r=dividend
    let dm8 = pd_divmod([3, 4], [1, 0, 1])
    let q8 = dm8["q"]
    let r8 = dm8["r"]
    let wq8 = []
    let wr8 = [3, 4]
    ck_list("divmod deg(a)<deg(b) q=[]", q8, wq8)
    ck_list("divmod deg(a)<deg(b) r=a", r8, wr8)

    // KAT 9: pd_is_zero
    let iz1 = pd_is_zero([])
    ck_bool("pd_is_zero []", iz1, true)
    let iz2 = pd_is_zero([0, 0])
    ck_bool("pd_is_zero [0,0]", iz2, true)
    let iz3 = pd_is_zero([1])
    ck_bool("pd_is_zero [1]", iz3, false)

    // KAT 10: pd_mod (alias for pd_remainder)
    let md10 = pd_mod([-1, 0, 1], [-1, 1])
    let wmd10 = []
    ck_list("pd_mod x^2-1 mod x-1 = 0", md10, wmd10)

    // KAT 11: divide constant by constant
    // [6] / [3] -> q=[2], r=[]
    let dm11 = pd_divmod([6], [3])
    let q11 = dm11["q"]
    let r11 = dm11["r"]
    let wq11 = [2]
    let wr11 = []
    ck_list("divmod [6]/[3] q=[2]", q11, wq11)
    ck_list("divmod [6]/[3] r=[]", r11, wr11)

    // KAT 12: pd_synthetic with root=2 for (x^3 - 6x^2 + 11x - 6)/(x-2)
    // result should be x^2 - 4x + 3 = [3, -4, 1]
    let syn12 = pd_synthetic([-6, 11, -6, 1], 2)
    let wsyn12 = [3, -4, 1]
    ck_list("pd_synthetic by x-2", syn12, wsyn12)

    // round-trip verify for x^3-6x^2+11x-6 / x-3
    let vr13 = pd_verify([-6, 11, -6, 1], [-3, 1], 0.0)
    ck_bool("pd_verify cubic by x-3", vr13, true)

    print("PASS _polydiv_test")
