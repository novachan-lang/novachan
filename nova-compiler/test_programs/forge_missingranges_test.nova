import forge_missingranges

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn render(rs: list) -> string
    let out = ""
    let i = 0
    while i < len(rs)
        if i > 0
            out = out + " "
        out = out + str(rs[i][0]) + "-" + str(rs[i][1])
        i = i + 1
    out

fn main()
    let fails = 0

    fails = fails + expect("classic", render(missing_ranges([0, 1, 3, 50, 75], 0, 99)), "2-2 4-49 51-74 76-99")
    fails = fails + expect("empty_nums", render(missing_ranges([], 1, 5)), "1-5")
    fails = fails + expect("full", render(missing_ranges([1, 2, 3], 1, 3)), "")
    fails = fails + expect("edges", render(missing_ranges([2, 4], 1, 5)), "1-1 3-3 5-5")
    fails = fails + expect("one_gap", render(missing_ranges([1, 5], 1, 5)), "2-4")
    fails = fails + expect("all_missing", render(missing_ranges([], 0, 0)), "0-0")

    // count missing
    fails = fails + expect("count1", str(count_missing([0, 1, 3, 50, 75], 0, 99)), str(1 + 46 + 24 + 24))
    fails = fails + expect("count_full", str(count_missing([1, 2, 3], 1, 3)), "0")
    fails = fails + expect("count_empty", str(count_missing([], 1, 10)), "10")

    // fully covered
    fails = fails + expect("cov_yes", str(is_fully_covered([1, 2, 3, 4], 1, 4)), "true")
    fails = fails + expect("cov_no", str(is_fully_covered([1, 2, 4], 1, 4)), "false")
    fails = fails + expect("cov_single", str(is_fully_covered([5], 5, 5)), "true")

    if fails == 0
        print("forge_missingranges: all passed")
    else
        print("forge_missingranges: " + str(fails) + " FAILED")
