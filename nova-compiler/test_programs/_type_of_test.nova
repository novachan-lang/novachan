// Regression gate for the type_of scalar fix: compile-time fold for statically-typed
// values + runtime box-kind check for any-boxed float/bool/null. Before the fix, type_of
// returned "int" for float, bool, null, and any-boxed scalars.
fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": '" + got + "' != '" + want + "'")
        exit(1)
fn main()
    cks("flt", type_of(3.5), "float")
    cks("boolt", type_of(true), "bool")
    cks("boolf", type_of(false), "bool")
    cks("null", type_of(null), "null")
    cks("int", type_of(7), "int")
    cks("str", type_of("hi"), "string")
    cks("list", type_of([1, 2, 3]), "list")
    cks("dict", type_of({}), "dict")
    let f = 2.5
    cks("var_flt", type_of(f), "float")
    let box = {}
    box["v"] = 9.5
    cks("any_flt", type_of(box["v"]), "float")
    box["s"] = "hi"
    cks("any_str", type_of(box["s"]), "string")
    box["n"] = 42
    cks("any_int", type_of(box["n"]), "int")
    // KNOWN RESIDUAL: a bool stored in a container is kept RAW (int 1/0), NOT boxed, so an
    // any-typed bool read back is indistinguishable from an int -> "int". Only floats are
    // boxed in containers (they must be, or their raw bits are misread), so any_flt works.
    // Boxing bools everywhere would be a much larger change; low-severity, tracked.
    box["b"] = true
    cks("any_bool_residual", type_of(box["b"]), "int")
    print("_type_of_test passed")
