fn zip_longest(a, b, fill)
  let result = []
  let max_len = len(a)
  if len(b) > max_len
    max_len = len(b)
  let i = 0
  while i < max_len
    let va = fill
    let vb = fill
    if i < len(a)
      va = a[i]
    if i < len(b)
      vb = b[i]
    push(result, [va, vb])
    i = i + 1
  result

fn chain_lists(a, b)
  let result = []
  for x in a
    push(result, x)
  for x in b
    push(result, x)
  result

fn cycle(xs, n)
  let result = []
  let total = len(xs)
  if total == 0
    return result
  let i = 0
  while i < n
    push(result, xs[i % total])
    i = i + 1
  result

fn repeat_val(val, n)
  let result = []
  let i = 0
  while i < n
    push(result, val)
    i = i + 1
  result

fn take_while_incl(xs, pred)
  let result = []
  for x in xs
    push(result, x)
    if not pred(x)
      return result
  result

fn drop_until(xs, pred)
  let result = []
  let dropping = 1
  for x in xs
    if dropping == 1 and pred(x)
      dropping = 0
    if dropping == 0
      push(result, x)
  result

fn sliding(xs, size)
  let result = []
  let i = 0
  while i + size <= len(xs)
    let window = []
    let j = 0
    while j < size
      push(window, xs[i + j])
      j = j + 1
    push(result, window)
    i = i + 1
  result

fn _is_positive(x)
  x > 0

fn _is_even(x)
  x % 2 == 0

fn main()
  let zl = zip_longest([1, 2, 3], [10, 20], 0)
  assert(len(zl) == 3, "zip_longest length")
  assert(zl[0][0] == 1 and zl[0][1] == 10, "zl first pair")
  assert(zl[2][0] == 3 and zl[2][1] == 0, "zl fill")

  let ch = chain_lists([1, 2], [3, 4, 5])
  assert(len(ch) == 5, "chain length")
  assert(ch[2] == 3, "chain middle")

  let cy = cycle([1, 2, 3], 7)
  assert(len(cy) == 7, "cycle length")
  assert(cy[3] == 1, "cycle wraps")
  assert(cy[6] == 1, "cycle wraps 2")

  let rp = repeat_val("x", 4)
  assert(len(rp) == 4, "repeat length")
  assert(rp[3] == "x", "repeat value")

  let twi = take_while_incl([3, 5, 7, -1, 2], fn(z) _is_positive(z))
  assert(len(twi) == 4, "take_while_incl includes boundary")
  assert(twi[3] == -1, "includes the failing element")

  let du = drop_until([1, 3, 5, 4, 6], fn(z) _is_even(z))
  assert(len(du) == 2, "drop_until")
  assert(du[0] == 4, "first matching")

  let sl = sliding([1, 2, 3, 4, 5], 3)
  assert(len(sl) == 3, "sliding count")
  assert(sl[0][0] == 1 and sl[0][2] == 3, "window 1")
  assert(sl[2][0] == 3 and sl[2][2] == 5, "window 3")

  print("iterx: all passed")
