import std/net/mqtt_sub

// ── Assert helpers ────────────────────────────────────────────────────────────

fn assert_i(label, got, want)
    if got != want
        print("FAIL mqtt_sub " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn assert_s(label, got, want)
    if got != want
        print("FAIL mqtt_sub " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // ── KAT 1: mqtt_subscribe basic — packet_id=10, filter "a/b" qos=1 ─────────
    // Expected packet:
    //   0x82              — SUBSCRIBE fixed header byte
    //   0x08              — remaining length = 8
    //   0x00, 0x0A        — packet_id = 10
    //   0x00, 0x03        — topic length = 3 ("a/b")
    //   0x61, 0x2F, 0x62  — 'a', '/', 'b'
    //   0x01              — qos = 1

    let filters1 = []
    let f1 = []
    push(f1, "a/b")
    push(f1, 1)
    push(filters1, f1)
    let pkt1 = mqtt_subscribe(10, filters1)
    let pkt1_len = len(pkt1)
    assert_i("subscribe-len", pkt1_len, 10)

    // fixed header
    assert_i("subscribe-fh", pkt1[0], 0x82)
    // remaining length = 8
    assert_i("subscribe-remlen", pkt1[1], 8)
    // packet_id hi/lo
    assert_i("subscribe-pid-hi", pkt1[2], 0)
    assert_i("subscribe-pid-lo", pkt1[3], 10)
    // topic length hi/lo = 3
    assert_i("subscribe-tlen-hi", pkt1[4], 0)
    assert_i("subscribe-tlen-lo", pkt1[5], 3)
    // topic bytes: 'a'=97 '/'=47 'b'=98
    assert_i("subscribe-topic-a", pkt1[6], 97)
    assert_i("subscribe-topic-/", pkt1[7], 47)
    assert_i("subscribe-topic-b", pkt1[8], 98)
    // qos byte
    assert_i("subscribe-qos", pkt1[9], 1)
    print("PASS mqtt_sub subscribe-basic")

    // ── KAT 2: decode round-trip ─────────────────────────────────────────────
    let dec1 = mqtt_subscribe_decode(pkt1)
    let dec1_pid = dec1["packet_id"]
    assert_i("decode-pid", dec1_pid, 10)
    let dec1_filters = dec1["filters"]
    let dec1_flen = len(dec1_filters)
    assert_i("decode-filter-count", dec1_flen, 1)
    let dec1_f0 = dec1_filters[0]
    let dec1_topic = dec1_f0[0]
    let dec1_qos = dec1_f0[1]
    assert_s("decode-topic", dec1_topic, "a/b")
    assert_i("decode-qos", dec1_qos, 1)
    print("PASS mqtt_sub decode-roundtrip")

    // ── KAT 3: mqtt_subscribe multiple filters ────────────────────────────────
    let filters2 = []
    let fa = []
    push(fa, "sensors/#")
    push(fa, 2)
    let fb = []
    push(fb, "cmd/x")
    push(fb, 0)
    push(filters2, fa)
    push(filters2, fb)
    let pkt2 = mqtt_subscribe(1, filters2)
    // fixed header = 0x82
    assert_i("multi-fh", pkt2[0], 0x82)
    // packet_id = 1
    assert_i("multi-pid-hi", pkt2[2], 0)
    assert_i("multi-pid-lo", pkt2[3], 1)
    // decode multi
    let dec2 = mqtt_subscribe_decode(pkt2)
    let dec2_pid = dec2["packet_id"]
    assert_i("multi-decode-pid", dec2_pid, 1)
    let dec2_fl = dec2["filters"]
    assert_i("multi-filter-count", len(dec2_fl), 2)
    let dec2_f0 = dec2_fl[0]
    let dec2_f1 = dec2_fl[1]
    assert_s("multi-topic0", dec2_f0[0], "sensors/#")
    assert_i("multi-qos0", dec2_f0[1], 2)
    assert_s("multi-topic1", dec2_f1[0], "cmd/x")
    assert_i("multi-qos1", dec2_f1[1], 0)
    print("PASS mqtt_sub multi-filters")

    // ── KAT 4: mqtt_unsubscribe — no qos byte ────────────────────────────────
    // packet_id=5, topics=["a/b"]
    // Expected:
    //   0xA2  — UNSUBSCRIBE fixed header
    //   0x07  — remaining length = 7 (2 pid + 2 len + 3 chars)
    //   0x00 0x05  — packet_id = 5
    //   0x00 0x03  — topic length = 3
    //   0x61 0x2F 0x62  — "a/b"
    let utopics1 = []
    push(utopics1, "a/b")
    let upkt1 = mqtt_unsubscribe(5, utopics1)
    let upkt1_len = len(upkt1)
    assert_i("unsub-len", upkt1_len, 9)
    assert_i("unsub-fh", upkt1[0], 0xA2)
    assert_i("unsub-remlen", upkt1[1], 7)
    assert_i("unsub-pid-hi", upkt1[2], 0)
    assert_i("unsub-pid-lo", upkt1[3], 5)
    assert_i("unsub-tlen-hi", upkt1[4], 0)
    assert_i("unsub-tlen-lo", upkt1[5], 3)
    assert_i("unsub-t0", upkt1[6], 97)
    assert_i("unsub-t1", upkt1[7], 47)
    assert_i("unsub-t2", upkt1[8], 98)
    print("PASS mqtt_sub unsubscribe-basic")

    // ── KAT 5: unsubscribe has NO qos byte (verify length difference) ─────────
    // subscribe "a/b" qos=1 -> remaining=8 (2+2+3+1)
    // unsubscribe "a/b"     -> remaining=7 (2+2+3+0)
    let sub_rem = pkt1[1]
    let unsub_rem = upkt1[1]
    // sub remaining is 1 more than unsub (the qos byte)
    assert_i("qos-byte-absent", sub_rem - unsub_rem, 1)
    print("PASS mqtt_sub unsubscribe-no-qos-byte")

    // ── KAT 6: large packet-id (0xFFFF) ──────────────────────────────────────
    let filters3 = []
    let fc = []
    push(fc, "x")
    push(fc, 0)
    push(filters3, fc)
    let pkt3 = mqtt_subscribe(0xFFFF, filters3)
    assert_i("max-pid-hi", pkt3[2], 0xFF)
    assert_i("max-pid-lo", pkt3[3], 0xFF)
    let dec3 = mqtt_subscribe_decode(pkt3)
    assert_i("max-pid-decode", dec3["packet_id"], 0xFFFF)
    print("PASS mqtt_sub max-packet-id")

    print("PASS _mqtt_sub_test")
