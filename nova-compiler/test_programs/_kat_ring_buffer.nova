import forge_ring_buffer

fn main()
    let rb = rb_new(3)
    assert(rb_size(rb) == 0, "starts empty")
    assert(rb_capacity(rb) == 3, "capacity 3")
    assert(rb_is_full(rb) == 0, "not full")

    rb = rb_push(rb, "a")
    rb = rb_push(rb, "b")
    rb = rb_push(rb, "c")
    assert(rb_size(rb) == 3, "size 3")
    assert(rb_is_full(rb) == 1, "full")
    assert(rb_peek_oldest(rb) == "a", "oldest = a")
    assert(rb_peek_newest(rb) == "c", "newest = c")

    rb = rb_push(rb, "d")
    assert(rb_size(rb) == 3, "still 3")
    assert(rb_peek_oldest(rb) == "b", "oldest = b after overflow")
    assert(rb_peek_newest(rb) == "d", "newest = d")
    assert(rb_total_written(rb) == 4, "4 total written")

    rb = rb_push(rb, "e")
    assert(rb_peek_oldest(rb) == "c", "oldest = c")

    let items = rb_to_list(rb)
    assert(len(items) == 3, "3 items in list")
    assert(items[0] == "c", "list[0] = c")
    assert(items[2] == "e", "list[2] = e")

    let empty = rb_new(5)
    assert(rb_peek_newest(empty) == "", "empty newest")
    assert(rb_peek_oldest(empty) == "", "empty oldest")

    print("RING-BUFFER KAT PASS")
