import forge_ring_buffer

fn main()
    let r = rb_new(3)
    r = rb_write(r, "a")
    r = rb_write(r, "b")
    r = rb_write(r, "c")
    assert(rb_size(r) == 3, "size 3")
    assert(rb_is_full(r) == 1, "full")

    let r1 = rb_oldest(r)
    assert(is_ok(r1), "oldest ok")
    assert(unwrap(r1) == "a", "oldest=a")

    let r2 = rb_latest(r)
    assert(is_ok(r2), "latest ok")
    assert(unwrap(r2) == "c", "latest=c")

    r = rb_write(r, "d")
    assert(rb_size(r) == 3, "still 3")

    let r3 = rb_oldest(r)
    assert(is_ok(r3), "oldest after wrap")
    assert(unwrap(r3) == "b", "oldest=b after wrap")

    let r4 = rb_latest(r)
    assert(is_ok(r4), "latest after wrap")
    assert(unwrap(r4) == "d", "latest=d")

    let bad = rb_read(r, 99)
    assert(is_err(bad), "out of range")

    print("RING-BUFFER KAT PASS")
