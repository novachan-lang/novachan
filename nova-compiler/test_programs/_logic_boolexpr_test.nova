import std/logic/logic_boolexpr

// cki — integer known-answer check.
fn cki(label, got, want)
    if got != want
        print("FAIL _logic_boolexpr_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb — boolean check expressed as int.
fn ckb(label, got, want)
    if got != want
        print("FAIL _logic_boolexpr_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckl — string-list known-answer check.
fn ckl(label, got, want)
    if len(got) != len(want)
        print("FAIL _logic_boolexpr_test " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL _logic_boolexpr_test " + label + " [" + str(i) + "]: got=" + got[i] + " want=" + want[i])
            exit(1)
        i = i + 1

fn main()
    // ─── lbe_eval_env basic KAT ─────────────────────────────────────────────

    // a & b: both true
    let ab_names = []
    push(ab_names, "a")
    push(ab_names, "b")
    let v11 = []
    push(v11, 1)
    push(v11, 1)
    let v10 = []
    push(v10, 1)
    push(v10, 0)
    let v00 = []
    push(v00, 0)
    push(v00, 0)
    cki("and_11", lbe_eval_env("a & b", ab_names, v11), 1)
    cki("and_10", lbe_eval_env("a & b", ab_names, v10), 0)
    cki("and_00", lbe_eval_env("a & b", ab_names, v00), 0)

    // !a | b: a=1,b=0 => !1|0 = 0|0 = 0
    cki("nota_or_b_10", lbe_eval_env("!a | b", ab_names, v10), 0)
    // a=0,b=0 => !0|0 = 1|0 = 1
    cki("nota_or_b_00", lbe_eval_env("!a | b", ab_names, v00), 1)
    // a=1,b=1 => !1|1 = 0|1 = 1
    cki("nota_or_b_11", lbe_eval_env("!a | b", ab_names, v11), 1)

    // a ^ b: xor
    cki("xor_11", lbe_eval_env("a ^ b", ab_names, v11), 0)
    cki("xor_10", lbe_eval_env("a ^ b", ab_names, v10), 1)
    cki("xor_00", lbe_eval_env("a ^ b", ab_names, v00), 0)
    let v01 = []
    push(v01, 0)
    push(v01, 1)
    cki("xor_01", lbe_eval_env("a ^ b", ab_names, v01), 1)

    // a | b & c: & binds tighter; a=0,b=1,c=1 => 0 | (1&1) = 0|1 = 1
    let abc_names = []
    push(abc_names, "a")
    push(abc_names, "b")
    push(abc_names, "c")
    let v011 = []
    push(v011, 0)
    push(v011, 1)
    push(v011, 1)
    cki("prec_011", lbe_eval_env("a | b & c", abc_names, v011), 1)
    // a=0,b=1,c=0 => 0 | (1&0) = 0
    let v010 = []
    push(v010, 0)
    push(v010, 1)
    push(v010, 0)
    cki("prec_010", lbe_eval_env("a | b & c", abc_names, v010), 0)

    // (a | b) & c: a=1,b=0,c=0 => (1|0)&0 = 0
    let v100 = []
    push(v100, 1)
    push(v100, 0)
    push(v100, 0)
    cki("paren_100", lbe_eval_env("(a | b) & c", abc_names, v100), 0)
    // a=1,b=0,c=1 => (1|0)&1 = 1
    let v101 = []
    push(v101, 1)
    push(v101, 0)
    push(v101, 1)
    cki("paren_101", lbe_eval_env("(a | b) & c", abc_names, v101), 1)

    // ─── double-NOT: !!a => a ───────────────────────────────────────────────
    cki("dbl_not_1", lbe_eval_env("!!a", ab_names, v11), 1)
    cki("dbl_not_0", lbe_eval_env("!!a", ab_names, v00), 0)

    // ─── lbe_vars ───────────────────────────────────────────────────────────
    let vrs = lbe_vars("a & b | c")
    let want_abc = []
    push(want_abc, "a")
    push(want_abc, "b")
    push(want_abc, "c")
    ckl("vars_abc", vrs, want_abc)

    // single variable
    let vrs2 = lbe_vars("a")
    let want_a = []
    push(want_a, "a")
    ckl("vars_a", vrs2, want_a)

    // repeated: a & a | a => just ["a"]
    let vrs3 = lbe_vars("a & a | a")
    ckl("vars_a_dedup", vrs3, want_a)

    // ordering: c & a | b => sorted ["a","b","c"]
    let vrs4 = lbe_vars("c & a | b")
    ckl("vars_sort", vrs4, want_abc)

    // ─── lbe_truthtable ─────────────────────────────────────────────────────
    // "a & b" with names=["a","b"]
    // assignments: i=0 (a=0,b=0)->0, i=1(a=1,b=0)->0, i=2(a=0,b=1)->0, i=3(a=1,b=1)->1
    // truth-table int = 0b1000 = 8
    cki("tt_and", lbe_truthtable("a & b", ab_names), 8)

    // "a | b": 0->0, 1->1, 2->1, 3->1 => 0b1110 = 14
    cki("tt_or", lbe_truthtable("a | b", ab_names), 14)

    // "a ^ b": 0->0, 1->1, 2->1, 3->0 => 0b0110 = 6
    cki("tt_xor", lbe_truthtable("a ^ b", ab_names), 6)

    // "!a": 1-var table: a=0->1, a=1->0 => 0b01 = 1  (bit0=f(0)=1, bit1=f(1)=0)
    let a_names = []
    push(a_names, "a")
    cki("tt_not_a", lbe_truthtable("!a", a_names), 1)

    // "a" (identity): a=0->0, a=1->1 => 0b10 = 2
    cki("tt_a_id", lbe_truthtable("a", a_names), 2)

    // ─── ENUMERATION CROSS-CHECK: verify lbe_truthtable is consistent with eval ─

    // For "a & b | c" over names=["a","b","c"], recompute by enumeration manually
    // and compare with lbe_truthtable.
    let expr_abc = "a & b | c"
    let tt = lbe_truthtable(expr_abc, abc_names)
    // Verify each of the 8 assignments
    let i = 0
    while i < 8
        let vals = []
        push(vals, (i >> 0) & 1)
        push(vals, (i >> 1) & 1)
        push(vals, (i >> 2) & 1)
        let expected = lbe_eval_env(expr_abc, abc_names, vals)
        let got_bit = (tt >> i) & 1
        if got_bit != expected
            print("FAIL _logic_boolexpr_test tt_enum_check[" + str(i) + "]: got=" + str(got_bit) + " want=" + str(expected))
            exit(1)
        i = i + 1

    // Also verify "!a | b & c" over n=3 by enumeration
    let expr2 = "!a | b & c"
    let tt2 = lbe_truthtable(expr2, abc_names)
    let j = 0
    while j < 8
        let vals2 = []
        push(vals2, (j >> 0) & 1)
        push(vals2, (j >> 1) & 1)
        push(vals2, (j >> 2) & 1)
        let expected2 = lbe_eval_env(expr2, abc_names, vals2)
        let got_bit2 = (tt2 >> j) & 1
        if got_bit2 != expected2
            print("FAIL _logic_boolexpr_test tt2_enum_check[" + str(j) + "]: got=" + str(got_bit2) + " want=" + str(expected2))
            exit(1)
        j = j + 1

    // "a ^ b ^ c" over n=3 (XOR chain)
    let expr3 = "a ^ b ^ c"
    let tt3 = lbe_truthtable(expr3, abc_names)
    let m = 0
    while m < 8
        let vals3 = []
        push(vals3, (m >> 0) & 1)
        push(vals3, (m >> 1) & 1)
        push(vals3, (m >> 2) & 1)
        let expected3 = lbe_eval_env(expr3, abc_names, vals3)
        let got_bit3 = (tt3 >> m) & 1
        if got_bit3 != expected3
            print("FAIL _logic_boolexpr_test tt3_enum_check[" + str(m) + "]: got=" + str(got_bit3) + " want=" + str(expected3))
            exit(1)
        m = m + 1

    print("PASS _logic_boolexpr_test")
