import std/geometry3d/cg3_aabb3

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn ckbox(label: string, got: list, x0: int, y0: int, z0: int, x1: int, y1: int, z1: int)
    if got[0] != x0 or got[1] != y0 or got[2] != z0 or got[3] != x1 or got[4] != y1 or got[5] != z1
        print("FAIL " + label + ": got=[" + str(got[0]) + "," + str(got[1]) + "," + str(got[2]) + "," + str(got[3]) + "," + str(got[4]) + "," + str(got[5]) + "]")
        exit(1)

fn main()
    // cga3_bbox: cloud of 3 points -> [0,0,0,3,4,5]
    let pts = [[0,0,0],[3,4,5],[1,1,1]]
    let box1 = cga3_bbox(pts)
    ckbox("bbox 3pts", box1, 0, 0, 0, 3, 4, 5)

    // cga3_bbox: single point -> degenerate box
    let pts2 = [[2,3,4]]
    let box2 = cga3_bbox(pts2)
    ckbox("bbox single pt", box2, 2, 3, 4, 2, 3, 4)

    // cga3_contains: interior point -> true
    ckb("contains interior", cga3_contains([0,0,0,3,4,5], [1,2,3]), true)

    // cga3_contains: boundary point -> true
    ckb("contains boundary", cga3_contains([0,0,0,3,4,5], [3,4,5]), true)

    // cga3_contains: outside on x axis -> false
    ckb("contains outside x", cga3_contains([0,0,0,3,4,5], [4,2,3]), false)

    // cga3_contains: origin corner -> true
    ckb("contains origin", cga3_contains([0,0,0,3,4,5], [0,0,0]), true)

    // cga3_volume: 2x3x4 box -> 24
    cki("volume 2x3x4", cga3_volume([0,0,0,2,3,4]), 24)

    // cga3_volume: unit cube -> 1
    cki("volume unit cube", cga3_volume([0,0,0,1,1,1]), 1)

    // cga3_volume: degenerate (flat) -> 0
    cki("volume flat", cga3_volume([0,0,0,2,2,0]), 0)

    // cga3_intersects: overlapping boxes -> true
    ckb("intersects overlap", cga3_intersects([0,0,0,2,2,2], [1,1,1,3,3,3]), true)

    // cga3_intersects: touching on face -> true (inclusive)
    ckb("intersects touching", cga3_intersects([0,0,0,1,1,1], [1,1,1,2,2,2]), true)

    // cga3_intersects: separated -> false
    ckb("intersects separated", cga3_intersects([0,0,0,1,1,1], [2,2,2,3,3,3]), false)

    // cga3_intersects: gap on y axis -> false
    ckb("intersects gap y", cga3_intersects([0,0,0,2,1,2], [0,2,0,2,3,2]), false)

    print("PASS _cg3_aabb3_test")
