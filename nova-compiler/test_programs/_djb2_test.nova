// _djb2_test.nova — KAT test for std/hash/djb2.nova
// All expected values are hand-computed (see trace in module header) and
// cross-checked with the reference DJB2 spec from comp.lang.c (Bernstein 1991).
//
// Hand-trace for h_djb2("ab"):
//   mask = 0xFFFFFFFF
//   h = 5381
//   c = ord('a') = 97
//   h = (5381 * 33 + 97) & mask = (177573 + 97) & mask = 177670
//   c = ord('b') = 98
//   h = (177670 * 33 + 98) & mask = (5863110 + 98) & mask = 5863208
//   => 5863208

import std/hash/djb2

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + got + " want " + want)
        exit(1)

fn main()
    // --- h_djb2 canonical vectors ---

    // empty string: init value returned unchanged
    cki("djb2_empty", h_djb2(""), 5381)

    // single character 'a' (byte 97): h=(5381*33+97)&mask=177670
    cki("djb2_a", h_djb2("a"), 177670)

    // two characters 'ab': step-by-step traced above => 5863208
    cki("djb2_ab", h_djb2("ab"), 5863208)

    // published reference: "hello" => 261238937
    cki("djb2_hello", h_djb2("hello"), 261238937)

    // determinism: same input must always produce same output
    cki("djb2_determinism", h_djb2("hello"), h_djb2("hello"))

    // collision resistance: different strings must differ
    let h1 = h_djb2("hello")
    let h2 = h_djb2("world")
    if h1 == h2
        print("FAIL djb2_collision: hello and world should not collide")
        exit(1)

    // --- h_djb2a (XOR variant) ---

    // empty string: same init as classic
    cki("djb2a_empty", h_djb2a(""), 5381)

    // single 'a': h=(5381*33^97)&mask = (177573^97)&mask = 177604
    cki("djb2a_a", h_djb2a("a"), 177604)

    // "hello" XOR variant
    cki("djb2a_hello", h_djb2a("hello"), 178056679)

    // XOR variant must differ from classic on non-empty input
    let hc = h_djb2("hello")
    let hx = h_djb2a("hello")
    if hc == hx
        print("FAIL djb2_vs_djb2a: classic and XOR should differ for non-empty input")
        exit(1)

    // --- h_djb2_seeded ---

    // seed=5381 must match h_djb2 exactly
    cki("djb2_seeded_matches_classic", h_djb2_seeded("hello", 5381), h_djb2("hello"))

    // seed=0 must differ from default seed on non-empty string
    let hs0 = h_djb2_seeded("hello", 0)
    let hdef = h_djb2("hello")
    if hs0 == hdef
        print("FAIL djb2_seeded_seed0: seed=0 should differ from seed=5381 for non-empty")
        exit(1)

    // seeded is also deterministic
    cki("djb2_seeded_determinism", h_djb2_seeded("nova", 42), h_djb2_seeded("nova", 42))

    // empty string with any seed returns (seed & mask) unchanged
    cki("djb2_seeded_empty", h_djb2_seeded("", 999), 999)

    // result stays in 32-bit unsigned range [0..4294967295]
    let big = h_djb2("the quick brown fox jumps over the lazy dog")
    if big < 0
        print("FAIL djb2_range_negative: result went negative")
        exit(1)
    if big > 4294967295
        print("FAIL djb2_range_overflow: result exceeded 0xFFFFFFFF")
        exit(1)

    print("_djb2_test passed")
