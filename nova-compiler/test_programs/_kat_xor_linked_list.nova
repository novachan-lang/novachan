import std/collections/xor_linked_list as xll

fn main()
    let l = xll.xll_new()
    xll.xll_push_back(l, 10)
    xll.xll_push_back(l, 20)
    xll.xll_push_back(l, 30)
    assert_eq(xll.xll_to_list_forward(l), [10, 20, 30])
    assert_eq(xll.xll_to_list_backward(l), [30, 20, 10])
    xll.xll_push_front(l, 5)
    assert_eq(xll.xll_to_list_forward(l), [5, 10, 20, 30])
    assert_eq(xll.xll_size(l), 4)
    assert_true(not xll.xll_is_empty(l))
    assert_true(xll.xll_is_empty(xll.xll_new()))
    print("ALL OK")
