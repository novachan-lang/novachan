// KAT for std/text/naturalsort
import std/text/naturalsort

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + got + " expected " + expected)
        exit(1)

fn main()
    // ns_compare KATs
    cki("compare file2 vs file10", ns_compare("file2", "file10"), -1)
    cki("compare file10 vs file2", ns_compare("file10", "file2"), 1)
    cki("compare a vs a", ns_compare("a", "a"), 0)
    cki("compare abc vs abd", ns_compare("abc", "abd"), -1)
    cki("compare img12 vs img12", ns_compare("img12", "img12"), 0)
    cki("compare abd vs abc", ns_compare("abd", "abc"), 1)
    cki("compare leading zeros 007 vs 7", ns_compare("007", "7"), 0)
    cki("compare 1 vs 2", ns_compare("1", "2"), -1)
    cki("compare 10 vs 9", ns_compare("10", "9"), 1)
    cki("compare empty vs a", ns_compare("", "a"), -1)
    cki("compare a vs empty", ns_compare("a", ""), 1)
    cki("compare empty vs empty", ns_compare("", ""), 0)

    // ns_sort KATs
    let s1 = ns_sort(["file10", "file2", "file1"])
    cks("sort s1[0]", s1[0], "file1")
    cks("sort s1[1]", s1[1], "file2")
    cks("sort s1[2]", s1[2], "file10")

    let s2 = ns_sort(["z1", "z20", "z3"])
    cks("sort s2[0]", s2[0], "z1")
    cks("sort s2[1]", s2[1], "z3")
    cks("sort s2[2]", s2[2], "z20")

    // single element
    let s3 = ns_sort(["only"])
    cks("sort s3[0]", s3[0], "only")

    // already sorted
    let s4 = ns_sort(["a1", "a2", "a10"])
    cks("sort s4[0]", s4[0], "a1")
    cks("sort s4[1]", s4[1], "a2")
    cks("sort s4[2]", s4[2], "a10")

    // reverse sorted
    let s5 = ns_sort(["c", "b", "a"])
    cks("sort s5[0]", s5[0], "a")
    cks("sort s5[1]", s5[1], "b")
    cks("sort s5[2]", s5[2], "c")

    print("_naturalsort_test passed")
