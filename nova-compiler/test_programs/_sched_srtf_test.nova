import std/scheduling/sched_srtf

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL sched_srtf " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(label: string, got: list, want: list)
    let ng = len(got)
    let nw = len(want)
    if ng != nw
        print("FAIL sched_srtf " + label + ": len got=" + str(ng) + " want=" + str(nw))
        exit(1)
    let i = 0
    while i < nw
        if got[i] != want[i]
            print("FAIL sched_srtf " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // KAT 1: canonical 4-process SRTF example
    // arrivals 0,1,2,3 bursts 8,4,9,5
    // Hand-traced: completion=[17,5,26,10], waiting=[9,0,15,2]
    let p1 = []
    let p1a = []
    push(p1a, 0)
    push(p1a, 8)
    push(p1, p1a)
    let p1b = []
    push(p1b, 1)
    push(p1b, 4)
    push(p1, p1b)
    let p1c = []
    push(p1c, 2)
    push(p1c, 9)
    push(p1, p1c)
    let p1d = []
    push(p1d, 3)
    push(p1d, 5)
    push(p1, p1d)

    let wc = []
    push(wc, 17)
    push(wc, 5)
    push(wc, 26)
    push(wc, 10)
    ckl("completion_canonical", sr_completion_times(p1), wc)

    let ww = []
    push(ww, 9)
    push(ww, 0)
    push(ww, 15)
    push(ww, 2)
    ckl("waiting_canonical", sr_waiting_times(p1), ww)

    // KAT 2: single process — no preemption
    let p2 = []
    let p2a = []
    push(p2a, 0)
    push(p2a, 5)
    push(p2, p2a)
    let wc2 = []
    push(wc2, 5)
    ckl("completion_single", sr_completion_times(p2), wc2)
    let ww2 = []
    push(ww2, 0)
    ckl("waiting_single", sr_waiting_times(p2), ww2)

    // KAT 3: empty
    let p3 = []
    ckl("completion_empty", sr_completion_times(p3), p3)

    // KAT 4: 2 processes — P1 arrives and preempts P0 immediately
    // P0: arrival=0 burst=6, P1: arrival=2 burst=2
    // t=0: run P0. t=2: P1 arrives. rem[P0]=4, P1 burst=2 < 4 => preempt.
    // t=2: run P1 (burst=2). t=4: P1 done, completion[1]=4. run P0 (rem=4).
    // t=8: P0 done, completion[0]=8.
    // waiting: P0=8-0-6=2, P1=4-2-2=0
    let p4 = []
    let p4a = []
    push(p4a, 0)
    push(p4a, 6)
    push(p4, p4a)
    let p4b = []
    push(p4b, 2)
    push(p4b, 2)
    push(p4, p4b)
    let wc4 = []
    push(wc4, 8)
    push(wc4, 4)
    ckl("completion_preempt", sr_completion_times(p4), wc4)
    let ww4 = []
    push(ww4, 2)
    push(ww4, 0)
    ckl("waiting_preempt", sr_waiting_times(p4), ww4)

    // KAT 5: idle gap — P0 arrival=0 burst=2, P1 arrival=10 burst=3
    // P0 runs 0..2, idle 2..10, P1 runs 10..13
    let p5 = []
    let p5a = []
    push(p5a, 0)
    push(p5a, 2)
    push(p5, p5a)
    let p5b = []
    push(p5b, 10)
    push(p5b, 3)
    push(p5, p5b)
    let wc5 = []
    push(wc5, 2)
    push(wc5, 13)
    ckl("completion_idle", sr_completion_times(p5), wc5)
    let ww5 = []
    push(ww5, 0)
    push(ww5, 0)
    ckl("waiting_idle", sr_waiting_times(p5), ww5)

    // KAT 6: tie-breaking by PID in SRTF
    // P0: arrival=0 burst=4, P1: arrival=0 burst=4
    // Both arrive at 0 with same burst. P0 wins (lower PID). P0 runs 0..4,
    // then at t=4: P0 done, rem[P1]=4. But P1 already arrived at 0, has not been preempted.
    // Actually at t=0, P1 arrives too. rem[P0]=4, rem[P1]=4, P0 wins.
    // t=0: run P0. P1 arrived too but P0 lower PID. No new arrivals during [0,4].
    // t=4: P0 done. P1 runs. t=8: P1 done.
    let p6 = []
    let p6a = []
    push(p6a, 0)
    push(p6a, 4)
    push(p6, p6a)
    let p6b = []
    push(p6b, 0)
    push(p6b, 4)
    push(p6, p6b)
    let wc6 = []
    push(wc6, 4)
    push(wc6, 8)
    ckl("completion_tie", sr_completion_times(p6), wc6)
    let ww6 = []
    push(ww6, 0)
    push(ww6, 4)
    ckl("waiting_tie", sr_waiting_times(p6), ww6)

    print("PASS _sched_srtf_test")
