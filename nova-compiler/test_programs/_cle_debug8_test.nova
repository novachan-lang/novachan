fn _cle_argv_val(argv, name) -> string
    let n = len(argv)
    let nlen = len(name)
    let i = 0
    while i < n
        let tok = argv[i]
        if tok == name
            if i + 1 < n
                let nv = argv[i+1]
                return nv
            return ""
        if len(tok) > nlen
            if slice(tok, 0, nlen) == name
                if slice(tok, nlen, nlen+1) == "="
                    return slice(tok, nlen+1, len(tok))
        i = i + 1
    return ""

fn cle_resolve(argv, name, env_val, fallback) -> string
    let av = _cle_argv_val(argv, name)
    print("av='" + av + "' eq_empty=" + str(av == ""))
    if av != ""
        return av
    if env_val != ""
        return env_val
    return fallback

fn main()
    let a1 = ["--port", "9"]
    let r = cle_resolve(a1, "--port", "8080", "3000")
    print("result='" + r + "'")
    let r2 = cle_resolve([], "--port", "8080", "3000")
    print("result2='" + r2 + "'")
    let r3 = cle_resolve([], "--port", "", "3000")
    print("result3='" + r3 + "'")
