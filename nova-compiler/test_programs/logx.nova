// logx — structured, leveled logging + crash reports.
//
// Levels DEBUG(0) < INFO(1) < WARN(2) < ERROR(3); a logger carries a minimum level
// that filters lower records. Every record is a level + message + structured key/value
// fields rendered as one parseable logfmt line (`level=INFO msg="..." k=v ...`) — so
// logs are both human-readable AND machine-parseable, no regex scraping. log_at returns
// the rendered line (empty string when filtered) so it is testable and composable; the
// caller decides the sink (print here; a log-owning Process for async logging is the
// NOVA-way extension — logging is just messages to a channel).

fn logger(min_level)
    return [min_level]

fn _level_name(lvl)
    if lvl == 0
        return "DEBUG"
    if lvl == 1
        return "INFO"
    if lvl == 2
        return "WARN"
    return "ERROR"

fn _logval(v)
    let s = str(v)
    if contains(s, " ")
        return chr(34) + s + chr(34)   // quote values with spaces
    return s

fn log_at(lg, lvl, msg, fields)
    if lvl < lg[0]
        return ""
    let line = "level=" + _level_name(lvl) + " msg=" + _logval(msg)
    for kv in fields
        line = line + " " + kv[0] + "=" + _logval(kv[1])
    return line

fn log_debug(lg, msg, fields)
    return log_at(lg, 0, msg, fields)
fn log_info(lg, msg, fields)
    return log_at(lg, 1, msg, fields)
fn log_warn(lg, msg, fields)
    return log_at(lg, 2, msg, fields)
fn log_error(lg, msg, fields)
    return log_at(lg, 3, msg, fields)

// crash report: an ERROR record capturing the failure + structured context.
fn log_crash(lg, err, context)
    let f = [["error", err]]
    for kv in context
        push(f, kv)
    return log_at(lg, 3, "crash", f)

fn log_emit(line)
    if line != ""
        print(line)
    return 0

fn main()
    let lg = logger(1)        // INFO and above

    // DEBUG is below the threshold -> filtered to empty
    assert_eq(log_debug(lg, "trace", []), "")

    // INFO with no fields
    assert_eq(log_info(lg, "started", []), "level=INFO msg=started")

    // structured fields, including a value that needs quoting
    let line = log_info(lg, "request", [["path", "/api"], ["status", 200], ["ua", "test agent"]])
    assert_eq(line, "level=INFO msg=request path=/api status=200 ua=" + chr(34) + "test agent" + chr(34))

    // WARN / ERROR
    assert_eq(log_warn(lg, "slow", [["ms", 1200]]), "level=WARN msg=slow ms=1200")
    assert_eq(log_error(lg, "boom", []), "level=ERROR msg=boom")

    // crash report carries error + context
    let cr = log_crash(lg, "div by zero", [["fn", "compute"], ["line", 42]])
    assert_eq(cr, "level=ERROR msg=crash error=" + chr(34) + "div by zero" + chr(34) + " fn=compute line=42")

    // a higher-threshold logger silences INFO
    let lg2 = logger(3)       // ERROR only
    assert_eq(log_info(lg2, "x", []), "")
    assert_eq(log_error(lg2, "x", []), "level=ERROR msg=x")

    log_emit(line)            // demonstrate the sink
    print("logx passed")
