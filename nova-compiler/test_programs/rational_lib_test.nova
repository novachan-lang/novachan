import std/numeric/rational

// Validation test for the rational module ([num, den] reduced int pairs).
// Compare via the num/den accessors so assertions are plain ints.
fn main()
    // construct/normalize: 2/4 -> 1/2
    let a = rational.rat(2, 4)
    assert(rational.rat_num(a) == 1, "rat(2,4) num == 1")
    assert(rational.rat_den(a) == 2, "rat(2,4) den == 2")

    // sign moves to numerator: 1/-2 -> -1/2
    let s = rational.rat(1, -2)
    assert(rational.rat_num(s) == -1, "rat(1,-2) num == -1")
    assert(rational.rat_den(s) == 2, "rat(1,-2) den == 2")

    // add: 1/2 + 1/3 = 5/6
    let p = rational.rat_add([1, 2], [1, 3])
    assert(rational.rat_num(p) == 5, "rat_add 1/2+1/3 num == 5")
    assert(rational.rat_den(p) == 6, "rat_add 1/2+1/3 den == 6")

    // mul: 2/3 * 3/4 = 1/2
    let m = rational.rat_mul([2, 3], [3, 4])
    assert(rational.rat_num(m) == 1, "rat_mul 2/3*3/4 num == 1")
    assert(rational.rat_den(m) == 2, "rat_mul 2/3*3/4 den == 2")

    // cmp: 1/2 < 2/3 -> -1 ; reduce-equal -> 0
    assert(rational.rat_cmp([1, 2], [2, 3]) == -1, "rat_cmp 1/2 < 2/3")
    assert(rational.rat_cmp([2, 4], [1, 2]) == 0, "rat_cmp 2/4 == 1/2")

    // to_str: 3/1 -> "3" ; 1/2 -> "1/2"
    assert(rational.rat_to_str([3, 1]) == "3", "rat_to_str 3/1 == 3")
    assert(rational.rat_to_str([1, 2]) == "1/2", "rat_to_str 1/2 == 1/2")

    print("rational_lib_test passed")
