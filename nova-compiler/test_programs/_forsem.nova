fn probe_empty()
    let n = 0
    for i in 0..n
        print("SHOULD-NOT-RUN-zero")
    print("zero-ok")

fn probe_negative()
    let n = 0 - 3
    for i in 0..n
        print("SHOULD-NOT-RUN-neg")
    print("neg-ok")

// Is the range BOUND evaluated once, or re-read every iteration?
// The while form re-reads len(xs) each time; if `for` does too, a growing list loops forever.
fn probe_bound_reeval()
    let xs = [1, 2, 3]
    let count = 0
    for i in 0..len(xs)
        count = count + 1
        if count < 8
            push(xs, 99)
    print("bound_reeval count=" + str(count) + " len=" + str(len(xs)))

// Is the loop variable visible AFTER the loop?
fn probe_scope()
    let total = 0
    for i in 0..3
        total = total + i
    print("scope total=" + str(total))

// Does `break` work, and what does it leave behind?
fn probe_break()
    let hit = 0 - 1
    for i in 0..10
        if i == 4
            hit = i
            break
    print("break hit=" + str(hit))

fn main()
    probe_empty()
    probe_negative()
    probe_bound_reeval()
    probe_scope()
    probe_break()
    print("SEM-DONE")
