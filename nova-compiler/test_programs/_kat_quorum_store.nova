import forge_quorum_store

fn main()
    let q = qs_new(3, 2, 2)
    assert(qs_is_strong_consistent(q) == 1, "W2+R2>3=strong")

    let w1 = qs_write(q, "key1", "hello", 2)
    q = w1["q"]
    assert(w1["ok"] == 1, "write ok with 2 acks")
    assert(w1["version"] == 1, "version 1")

    let w2 = qs_write(q, "key1", "world", 1)
    q = w2["q"]
    assert(w2["ok"] == 0, "write fails with 1 ack")

    let r1 = qs_read(q, "key1", 2)
    q = r1["q"]
    assert(r1["ok"] == 1, "read ok")
    assert(r1["value"] == "hello", "correct value")

    let r2 = qs_read(q, "key1", 1)
    q = r2["q"]
    assert(r2["ok"] == 0, "read fails with 1 ack")

    assert(qs_version(q, "key1") == 1, "version still 1")
    assert(qs_total_writes(q) == 1, "1 write")
    assert(qs_total_reads(q) == 1, "1 read")

    print("QUORUM-STORE KAT PASS")
