// Proves the cluster recv-timeout fix: a hung-but-alive peer (accepts the connection but NEVER replies)
// must not block the caller forever. This is the exact mechanism _spawn_to now uses -- tcp_wait_readable
// on the remote_* connection (a raw TCP fd) returns a timeout instead of parking forever on remote_recv.
fn _silent_server(port)
    let lis = remote_bind(port)
    let conn = remote_accept(lis)
    sleep(8000)                    // accept, then stay up well past the client's deadline -- NEVER reply
    remote_close(conn)
    remote_close(lis)

fn main()
    let port = 19944
    spawn _silent_server(port)
    sleep(500)                     // let the server bind + be ready
    let conn = remote_connect("127.0.0.1", port)
    remote_send(conn, {"type": "spawn", "fn": "x", "args": []})
    let t0 = time_ms()
    let ready = tcp_wait_readable(conn, 2000)     // 2s deadline on a peer that never answers
    let dt = time_ms() - t0
    remote_close(conn)
    if ready == 1
        print("FAIL: reported readable but the server never replied")
    else if dt > 5000
        print("FAIL: waited " + str(dt) + "ms -- no timeout (would have hung)")
    else
        print("PASS dist_recv_timeout (silent peer -> tcp_wait_readable timed out in " + str(dt) + "ms, no hang)")
