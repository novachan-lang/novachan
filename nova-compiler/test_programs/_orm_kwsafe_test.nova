// SQL-reserved-word struct AND column names must round-trip. The zero-annotation ORM dialect-QUOTES every
// identifier (table + columns), so `type Order { ... group: string }` (both `Order` and `group` are SQL
// reserved words) persists and reads like any other struct. Before the quoting fix orm_ensure silently
// created no table and orm_fetch returned [] -- a silent data-loss footgun for very common entity names.
import forge_orm

type Order
    id: int
    total: float
    group: string

fn main()
    let sr = orm_open("sqlite://_orm_kwsafe.db")
    match sr
        Ok(db) =>
            orm_drop_table(db, "Order")                          // DROP TABLE "Order"  (quoted)
            orm_ensure(db, Order(0, 0.0, ""))                    // CREATE TABLE "Order" ("id" ..., "group" ...)
            orm_save(db, Order(0, 12.5, "alpha"))                // INSERT INTO "Order" (...)
            orm_save(db, Order(0, 99.0, "beta"))
            let os: list<Order> = orm_fetch(db)                  // SELECT * FROM "Order"
            if len(os) != 2
                print("FAIL count: " + str(len(os)))
                exit(1)
            if os[0].group != "alpha" or os[1].group != "beta"
                print("FAIL reserved col: " + os[0].group + "/" + os[1].group)
                exit(1)
            let first = os[0]
            orm_modify(db, Order(first.id, 250.0, "alpha2"))     // UPDATE "Order" SET ... WHERE id=?
            orm_remove(db, os[1])                                // DELETE FROM "Order" WHERE id=?
            let os2: list<Order> = orm_fetch(db)
            if len(os2) != 1
                print("FAIL after mod/rm count: " + str(len(os2)))
                exit(1)
            if os2[0].group != "alpha2" or os2[0].total != 250.0
                print("FAIL update: " + os2[0].group + "/" + str(os2[0].total))
                exit(1)
            orm_close(db)
            print("PASS _orm_kwsafe_test")
        Err(e) =>
            print("FAIL open: " + e)
            exit(1)
