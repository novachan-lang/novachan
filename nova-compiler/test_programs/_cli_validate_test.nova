import std/cli/cli_validate

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn ckl(label: string, got: list, want: list)
    cki(label + "_len", len(got), len(want))
    let i = 0
    while i < len(want)
        cks(label + "[" + str(i) + "]", got[i], want[i])
        i = i + 1

fn main()
    // KAT 1: missing_required with one missing
    let miss1 = clv_missing_required(["--a", "--b"], ["--a", "--c"])
    ckl("miss_one", miss1, ["--c"])

    // KAT 2: missing_required with none missing
    let miss2 = clv_missing_required(["--a"], ["--a"])
    cki("miss_none_len", len(miss2), 0)

    // KAT 3: in_choices true
    ckb("choices_true", clv_in_choices("red", ["red", "green"]), true)

    // KAT 4: in_choices false
    ckb("choices_false", clv_in_choices("blue", ["red", "green"]), false)

    // KAT 5: is_int_str positive integer
    ckb("int_pos", clv_is_int_str("42"), true)

    // KAT 6: is_int_str negative integer
    ckb("int_neg", clv_is_int_str("-7"), true)

    // KAT 7: is_int_str alphanumeric — false
    ckb("int_alpha", clv_is_int_str("4x"), false)

    // KAT 8: all_present true
    ckb("all_true", clv_all_present(["--a"], ["--a"]), true)

    // KAT 9: all_present false (one missing)
    ckb("all_false", clv_all_present(["--a"], ["--a", "--b"]), false)

    // KAT 10: is_int_str empty string
    ckb("int_empty", clv_is_int_str(""), false)

    // KAT 11: is_int_str just a dash
    ckb("int_dash", clv_is_int_str("-"), false)

    // KAT 12: is_int_str "0"
    ckb("int_zero", clv_is_int_str("0"), true)

    // KAT 13: missing_required with empty argv
    let miss3 = clv_missing_required([], ["--x", "--y"])
    ckl("miss_all", miss3, ["--x", "--y"])

    // KAT 14: all_present with empty required list — vacuously true
    ckb("all_empty_req", clv_all_present(["--a"], []), true)

    // KAT 15: in_choices empty choices
    ckb("choices_empty", clv_in_choices("red", []), false)

    print("PASS _cli_validate_test")
