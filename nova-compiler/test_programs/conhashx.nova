// conhashx.nova — consistent hashing ring, the NOVA way (for "runs anywhere").
//
// Maps keys to nodes (shards/servers) so that ADDING or REMOVING a node remaps
// only ~1/N of the keys, not all of them — the property that makes distributed
// caches, shards, and load balancers stable under churn. Each physical node is
// placed at many points around a hash ring (virtual nodes) for even spread; a
// key goes to the first node clockwise from the key's hash. Self-contained
// pure-NOVA hash. (Aligns with NOVA's distributed identity.)

fn _hash(s)
  let cps = code_points(s)
  let h = 5381
  for c in cps
    h = (h * 33 + c) % 2147483647     // djb2
  // avalanche: djb2 maps SEQUENTIAL strings to sequential hashes; a Knuth
  // multiplicative scramble spreads them around the ring (essential here).
  h = (h * 2654435761) % 2147483647
  h

fn _sort_points(points)
  let arr = []
  for p in points
    push(arr, p)
  let i = 1
  while i < len(arr)
    let key = arr[i]
    let j = i - 1
    while j >= 0 and arr[j][0] > key[0]
      arr[j + 1] = arr[j]
      j = j - 1
    arr[j + 1] = key
    i = i + 1
  arr

fn ring_new(vnodes)
  let ring = {}
  ring["points"] = []          // sorted list of [hash, node]
  ring["vnodes"] = vnodes
  ring

fn ring_add(ring, node)
  let points = ring["points"]
  let i = 0
  while i < ring["vnodes"]
    push(points, [_hash(node + "#" + str(i)), node])
    i = i + 1
  ring["points"] = _sort_points(points)

fn ring_remove(ring, node)
  let kept = []
  for p in ring["points"]
    if p[1] != node
      push(kept, p)
  ring["points"] = kept

// which node owns `key`: the first ring point clockwise from hash(key).
fn ring_get(ring, key)
  let points = ring["points"]
  if len(points) == 0
    return ""
  let h = _hash(key)
  for p in points
    if p[0] >= h
      return p[1]
  points[0][1]                 // wrapped past the end -> first point

// ── Tests ────────────────────────────────────────────────────────────

let ring = ring_new(50)
ring_add(ring, "nodeA")
ring_add(ring, "nodeB")
ring_add(ring, "nodeC")

// determinism: the same key always maps to the same node.
let k = "user:12345"
let owner = ring_get(ring, k)
assert(owner == ring_get(ring, k), "deterministic mapping")
assert(owner == "nodeA" or owner == "nodeB" or owner == "nodeC", "owned by a real node")
print("PASS: deterministic + valid owner")

// record owners of many keys, then REMOVE a node.
let keys = []
let i = 0
while i < 60
  push(keys, "key" + str(i))
  i = i + 1
let before = {}
for key in keys
  before[key] = ring_get(ring, key)

ring_remove(ring, "nodeB")

// the consistent-hashing GUARANTEE: every key NOT previously on nodeB keeps the
// same owner; keys that were on nodeB move to a remaining node.
let moved = 0
let stable_wrong = 0
for key in keys
  let now = ring_get(ring, key)
  assert(now != "nodeB", "no key still points at the removed node")
  if before[key] == "nodeB"
    moved = moved + 1
  else
    if now != before[key]
      stable_wrong = stable_wrong + 1
assert(stable_wrong == 0, "keys NOT on nodeB are undisturbed (minimal remapping)")
assert(moved > 0, "keys that were on nodeB were remapped")
print("PASS: removing a node remaps only its own keys (" + str(moved) + "/60 moved)")

// adding a node back: only some keys migrate to it, others stay.
ring_add(ring, "nodeD")
let to_d = 0
for key in keys
  if ring_get(ring, key) == "nodeD"
    to_d = to_d + 1
assert(to_d > 0, "new node nodeD takes over some keys")
assert(to_d < 60, "new node does NOT take everything (consistent)")
print("PASS: adding a node migrates only a share (" + str(to_d) + "/60 to nodeD)")

print("ALL PASS: conhashx — consistent hashing ring")
