import forge_paxos_basic

fn main()
    let p = paxos_new(3)
    assert(paxos_is_decided(p) == 0, "not decided")

    let prep = paxos_prepare(p, 1)
    p = prep["p"]
    assert(prep["ok"] == 1, "prepare accepted")

    p = paxos_promise(p)
    p = paxos_promise(p)
    assert(paxos_promise_count(p) == 2, "2 promises")
    assert(paxos_has_quorum_promise(p) == 1, "quorum (2/3)")

    let acc = paxos_accept(p, 1, "value-x")
    p = acc["p"]
    assert(acc["ok"] == 1, "accept ok")

    p = paxos_accepted(p)
    assert(paxos_is_decided(p) == 0, "1 accept not decided")
    p = paxos_accepted(p)
    assert(paxos_is_decided(p) == 1, "2 accepts = decided")
    assert(paxos_decided_value(p) == "value-x", "decided value-x")
    assert(paxos_accept_count(p) == 2, "2 accepts total")

    let p2 = paxos_new(5)
    let prep2 = paxos_prepare(p2, 1)
    p2 = prep2["p"]
    let stale = paxos_prepare(p2, 0)
    p2 = stale["p"]
    assert(stale["ok"] == 0, "stale proposal rejected")

    let acc2 = paxos_accept(p2, 0, "stale-val")
    p2 = acc2["p"]
    assert(acc2["ok"] == 0, "stale accept rejected")

    print("PAXOS-BASIC KAT PASS")
