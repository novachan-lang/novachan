import std/collections/min_stack

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn ckb(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn main()
    // KAT 1: push 3,5,2,1 — check min/max/top/size
    let s = mns_make()
    mns_push(s, 3)
    mns_push(s, 5)
    mns_push(s, 2)
    mns_push(s, 1)
    cki("min_after_4", mns_min(s), 1)
    cki("max_after_4", mns_max(s), 5)
    cki("top_after_4", mns_top(s), 1)
    cki("size_after_4", mns_size(s), 4)

    // KAT 2: pop returns 1; min becomes 2, top becomes 2
    let v1 = mns_pop(s)
    cki("pop_returns_1", v1, 1)
    cki("min_after_pop1", mns_min(s), 2)
    cki("top_after_pop1", mns_top(s), 2)

    // KAT 3: pop returns 2; min becomes 3, max stays 5
    let v2 = mns_pop(s)
    cki("pop_returns_2", v2, 2)
    cki("min_after_pop2", mns_min(s), 3)
    cki("max_after_pop2", mns_max(s), 5)

    // KAT 4: pop returns 5; only 3 remains; min=max=3
    let v3 = mns_pop(s)
    cki("pop_returns_5", v3, 5)
    cki("min_single", mns_min(s), 3)
    cki("max_single", mns_max(s), 3)
    cki("size_single", mns_size(s), 1)

    // KAT 5: empty stack queries
    let empty = mns_make()
    ckb("is_empty_true", mns_is_empty(empty), 1)
    ckb("is_empty_false", mns_is_empty(s), 0)

    // KAT 6: pop on empty returns null
    let pnull = mns_pop(empty)
    if pnull != null
        print("FAIL pop_empty_null: expected null")
        exit(1)

    // KAT 7: all equal values — min=max=value
    let s2 = mns_make()
    mns_push(s2, 7)
    mns_push(s2, 7)
    mns_push(s2, 7)
    cki("min_equal", mns_min(s2), 7)
    cki("max_equal", mns_max(s2), 7)
    cki("size_equal", mns_size(s2), 3)

    // KAT 8: descending pushes — min always latest
    let s3 = mns_make()
    mns_push(s3, 10)
    mns_push(s3, 8)
    mns_push(s3, 6)
    cki("min_desc", mns_min(s3), 6)
    cki("max_desc", mns_max(s3), 10)
    mns_pop(s3)
    cki("min_after_pop_desc", mns_min(s3), 8)

    // KAT 9: ascending pushes — max always latest
    let s4 = mns_make()
    mns_push(s4, 1)
    mns_push(s4, 3)
    mns_push(s4, 5)
    cki("max_asc", mns_max(s4), 5)
    cki("min_asc", mns_min(s4), 1)
    mns_pop(s4)
    cki("max_after_pop_asc", mns_max(s4), 3)

    print("PASS _min_stack_test")
