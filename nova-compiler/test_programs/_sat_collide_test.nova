import std/game2d/sat_collide

// ckb — check boolean equality; exit(1) on mismatch.
fn ckb(label: string, got: bool, want: bool)
    let goti = 0
    if got
        goti = 1
    let wanti = 0
    if want
        wanti = 1
    if goti != wanti
        print("FAIL sat_collide " + label + ": got=" + str(goti) + " want=" + str(wanti))
        exit(1)

// ckf — check float with tolerance 0.0001.
fn ckf(label: string, got: float, want: float)
    let tol = 0.0001
    let hi = want + tol
    let lo = want - tol
    if got > hi
        print("FAIL sat_collide " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)
    if got < lo
        print("FAIL sat_collide " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// approx2 — check two floats are within tol of their targets.
fn approx2(label: string, gx: float, gy: float, wx: float, wy: float)
    ckf(label + "_x", gx, wx)
    ckf(label + "_y", gy, wy)

fn main()
    // ---- sat_dot ----
    // (1,0)·(3,4) = 3
    let d1 = sat_dot(1, 0, 3, 4)
    ckf("dot_1_0_3_4", d1, 3.0)
    // (2,3)·(4,5) = 8+15 = 23
    let d2 = sat_dot(2, 3, 4, 5)
    ckf("dot_2_3_4_5", d2, 23.0)
    // perpendicular vectors: (1,0)·(0,1) = 0
    let d3 = sat_dot(1, 0, 0, 1)
    ckf("dot_perpendicular", d3, 0.0)

    // ---- sat_edge_normal ----
    // edge (0,0)->(1,0): dx=1,dy=0 -> normal=(0,-1) [outward for CCW = right-hand]
    // Wait: for CCW polygon, outward normal of rightward edge is DOWN.
    // normal = (dy, -dx) = (0, -1)
    let en1 = sat_edge_normal(0, 0, 1, 0)
    ckf("edge_normal_right_x", en1[0], 0.0)
    ckf("edge_normal_right_y", en1[1], -1.0)
    // edge (1,0)->(1,1): dx=0,dy=1 -> normal=(1,0) outward right
    let en2 = sat_edge_normal(1, 0, 1, 1)
    ckf("edge_normal_up_x", en2[0], 1.0)
    ckf("edge_normal_up_y", en2[1], 0.0)

    // ---- sat_project ----
    // square [[0,0],[2,0],[2,2],[0,2]] onto [1,0] -> x-extent = [0,2]
    let sq1 = [[0, 0], [2, 0], [2, 2], [0, 2]]
    let ax1 = [1, 0]
    let proj1 = sat_project(sq1, ax1)
    ckf("project_sq_x_min", proj1[0], 0.0)
    ckf("project_sq_x_max", proj1[1], 2.0)
    // same square onto [0,1] -> y-extent = [0,2]
    let ax2 = [0, 1]
    let proj2 = sat_project(sq1, ax2)
    ckf("project_sq_y_min", proj2[0], 0.0)
    ckf("project_sq_y_max", proj2[1], 2.0)

    // ---- sat_collide ----
    // two overlapping squares
    let sqA = [[0, 0], [2, 0], [2, 2], [0, 2]]
    let sqB = [[1, 1], [3, 1], [3, 3], [1, 3]]
    ckb("overlap_squares", sat_collide(sqA, sqB), true)

    // two disjoint squares
    let sqC = [[0, 0], [1, 0], [1, 1], [0, 1]]
    let sqD = [[5, 5], [6, 5], [6, 6], [5, 6]]
    ckb("disjoint_squares", sat_collide(sqC, sqD), false)

    // triangle and overlapping square
    // triangle: [[0,0],[3,0],[1,2]]  square: [[1,0],[3,0],[3,2],[1,2]] -> overlap
    let triA = [[0, 0], [3, 0], [1, 2]]
    let sqE = [[1, 0], [3, 0], [3, 2], [1, 2]]
    ckb("tri_sq_overlap", sat_collide(triA, sqE), true)

    // two disjoint triangles, far apart
    let triB = [[0, 0], [1, 0], [0, 1]]
    let triC = [[10, 10], [11, 10], [10, 11]]
    ckb("disjoint_triangles", sat_collide(triB, triC), false)

    // two squares that share only a vertex touch: [[0,0],[1,0],[1,1],[0,1]] and [[1,1],[2,1],[2,2],[1,2]]
    // Touching at (1,1) — boundary case: SAT treats touching as collision (overlap = 0 on some axis).
    // The x-axis: A=[0,1], B=[1,2], A.max==B.min -> not < so they DO overlap on x.
    // The y-axis: A=[0,1], B=[1,2], A.max==B.min -> same, overlap.
    // ALL axes overlap -> SAT says COLLIDE.  Document: vertex touch = collision.
    let sqV1 = [[0, 0], [1, 0], [1, 1], [0, 1]]
    let sqV2 = [[1, 1], [2, 1], [2, 2], [1, 2]]
    ckb("vertex_touch_collides", sat_collide(sqV1, sqV2), true)

    // ---- sat_overlaps_on_axis ----
    // same two overlapping squares on x-axis
    let oA = [[0, 0], [2, 0], [2, 2], [0, 2]]
    let oB = [[1, 1], [3, 1], [3, 3], [1, 3]]
    let xaxis = [1, 0]
    ckb("overlaps_on_x", sat_overlaps_on_axis(oA, oB, xaxis), true)
    // disjoint on x: [0,1] vs [5,6]
    let oC = [[0, 0], [1, 0], [1, 1], [0, 1]]
    let oD = [[5, 5], [6, 5], [6, 6], [5, 6]]
    ckb("disjoint_on_x", sat_overlaps_on_axis(oC, oD, xaxis), false)

    // ---- sat_mtv ----
    // Two overlapping squares: A=[0,0,2,2] B=[1,1,2,2]
    // overlap on x = 1, overlap on y = 1
    // tie-break: first axis processed (A's edges) picks x or y; MTV magnitude = 1.0
    let mtvA = [[0, 0], [2, 0], [2, 2], [0, 2]]
    let mtvB = [[1, 1], [3, 1], [3, 3], [1, 3]]
    let mtv1 = sat_mtv(mtvA, mtvB)
    let mtvlen = mtv1[0] * mtv1[0] + mtv1[1] * mtv1[1]
    ckf("mtv_magnitude_sq", mtvlen, 1.0)

    // disjoint -> [0,0]
    let mtvC = [[0, 0], [1, 0], [1, 1], [0, 1]]
    let mtvD = [[5, 5], [6, 5], [6, 6], [5, 6]]
    let mtv2 = sat_mtv(mtvC, mtvD)
    ckf("mtv_disjoint_x", mtv2[0], 0.0)
    ckf("mtv_disjoint_y", mtv2[1], 0.0)

    print("PASS _sat_collide_test")
