// Test: mini-lexer - struct creation, string char-at, while, list
type Token
    kind: string
    value: string

fn is_alpha(ch: string) -> bool
    let c = ord(ch)
    if c >= 65 and c <= 90
        return true
    if c >= 97 and c <= 122
        return true
    if ch == "_"
        return true
    return false

fn is_digit(ch: string) -> bool
    let c = ord(ch)
    return c >= 48 and c <= 57

fn tokenize(source: string) -> list
    let tokens = []
    let i = 0
    while i < len(source)
        let ch = source[i]
        if ch == " " or ch == "\n"
            i = i + 1
        else if is_alpha(ch)
            let start = i
            while i < len(source) and is_alpha(source[i])
                i = i + 1
            let word = ""
            let j = start
            while j < i
                word = word + source[j]
                j = j + 1
            push(tokens, Token("IDENT", word))
        else if is_digit(ch)
            let start = i
            while i < len(source) and is_digit(source[i])
                i = i + 1
            let num = ""
            let j = start
            while j < i
                num = num + source[j]
                j = j + 1
            push(tokens, Token("NUM", num))
        else if ch == "="
            push(tokens, Token("ASSIGN", "="))
            i = i + 1
        else if ch == "+"
            push(tokens, Token("OP", "+"))
            i = i + 1
        else if ch == "("
            push(tokens, Token("LPAREN", "("))
            i = i + 1
        else if ch == ")"
            push(tokens, Token("RPAREN", ")"))
            i = i + 1
        else
            i = i + 1
    return tokens

let src = "x = add(1 + 2)"
let toks = tokenize(src)
print(len(toks))
for t in toks
    match t
        Token(kind, value) =>
            print(kind + " " + value)
