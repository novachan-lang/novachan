import std/sketch/topk

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn main()
    // --- KAT 1: heavy-hitter ordering ---
    // Stream: 'a' x5, 'b' x3, 'c' x1, 'd' x1, 'e' x1; capacity=3
    let st = tk_new(3)
    let i = 0
    while i < 5
        tk_add(st, "a")
        i = i + 1
    let j = 0
    while j < 3
        tk_add(st, "b")
        j = j + 1
    tk_add(st, "c")
    tk_add(st, "d")
    tk_add(st, "e")

    // top-1 must be 'a' (the heavy hitter)
    let top1 = tk_top(st, 1)
    cki("top1_is_a", top1[0] == "a", true)

    // tk_estimate 'a' >= 5 (Space-Saving NEVER underestimates)
    let est_a = tk_estimate(st, "a")
    if est_a < 5
        print("FAIL estimate_a: got=" + str(est_a) + " want>=5")
        exit(1)

    // monitored entries <= k=3
    let cnt = tk_count(st)
    if cnt > 3
        print("FAIL count_bounded: got=" + str(cnt) + " want<=3")
        exit(1)

    // --- KAT 2: determinism — two identical streams give same top ---
    let st2 = tk_new(3)
    let i2 = 0
    while i2 < 5
        tk_add(st2, "a")
        i2 = i2 + 1
    let j2 = 0
    while j2 < 3
        tk_add(st2, "b")
        j2 = j2 + 1
    tk_add(st2, "c")
    tk_add(st2, "d")
    tk_add(st2, "e")
    let top1b = tk_top(st2, 1)
    cki("determinism_top1", top1b[0] == "a", true)

    // --- KAT 3: contains / items ---
    ckb("contains_a", tk_contains(st, "a"), true)
    // Items returns a list (length == count monitored)
    let all_items = tk_items(st)
    cki("items_len", len(all_items), tk_count(st))

    // --- KAT 4: min_count is non-negative ---
    let mc = tk_min_count(st)
    if mc < 0
        print("FAIL min_count_negative: " + str(mc))
        exit(1)

    // --- KAT 5: empty tracker ---
    let empty = tk_new(5)
    cki("empty_count", tk_count(empty), 0)
    cki("empty_estimate", tk_estimate(empty, "x"), 0)
    cki("empty_min_count", tk_min_count(empty), 0)
    ckb("empty_contains", tk_contains(empty, "x"), false)
    let empty_items = tk_items(empty)
    cki("empty_items_len", len(empty_items), 0)

    // --- KAT 6: single item fills up to k=1 ---
    let st3 = tk_new(1)
    tk_add(st3, "x")
    tk_add(st3, "x")
    tk_add(st3, "x")
    cki("single_k1_count", tk_count(st3), 1)
    let est_x = tk_estimate(st3, "x")
    if est_x < 3
        print("FAIL single_k1_estimate: got=" + str(est_x) + " want>=3")
        exit(1)

    // --- KAT 7: eviction when full (k=2, stream: a,a,a,b,b,c) ---
    let st4 = tk_new(2)
    tk_add(st4, "a")
    tk_add(st4, "a")
    tk_add(st4, "a")
    tk_add(st4, "b")
    tk_add(st4, "b")
    tk_add(st4, "c")
    // 'c' should have evicted the min (b count=2) getting count=3, or 'a' dominates
    // INVARIANT: count <= k always
    let cnt4 = tk_count(st4)
    if cnt4 > 2
        print("FAIL eviction_bounded: got=" + str(cnt4) + " want<=2")
        exit(1)
    // 'a' must still be present (3 occurrences, highest)
    ckb("eviction_a_present", tk_contains(st4, "a"), true)

    // --- KAT 8: top-n with n > actual count returns all ---
    let st5 = tk_new(5)
    tk_add(st5, "p")
    tk_add(st5, "q")
    let top10 = tk_top(st5, 10)
    let tlen = len(top10)
    if tlen > 2
        print("FAIL top_overflow: got=" + str(tlen) + " want<=2")
        exit(1)

    print("PASS _topk_test")

main()
