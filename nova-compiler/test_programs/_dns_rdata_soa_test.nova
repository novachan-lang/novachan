// KAT for std/net/dns_rdata_soa — SOA RDATA encode/decode.
import std/net/dns_rdata_soa

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL dns_rdata_soa " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL dns_rdata_soa " + label + ": got '" + got + "' want '" + want + "'")
        exit(1)

fn main()
    // ── Vector A: byte-exact encode of known input ────────────────────────────
    //
    // dns_soa_encode("ns.example.com","root.example.com",2024010101,7200,3600,1209600,3600)
    //
    // MNAME "ns.example.com" wire bytes (16 bytes):
    //   [2, 110, 115,                       <- "ns"
    //    7, 101, 120, 97, 109, 112, 108, 101, <- "example"
    //    3, 99, 111, 109,                    <- "com"
    //    0]                                  <- root terminator
    //
    // RNAME "root.example.com" wire bytes (18 bytes):
    //   [4, 114, 111, 111, 116,              <- "root"
    //    7, 101, 120, 97, 109, 112, 108, 101, <- "example"
    //    3, 99, 111, 109,                    <- "com"
    //    0]                                  <- root terminator
    //
    // Five u32 big-endian starting at offset 34:
    //   serial  2024010101 = 0x78A3F175 -> [120, 163, 241, 117]
    //   refresh 7200       = 0x00001C20 -> [0, 0, 28, 32]
    //   retry   3600       = 0x00000E10 -> [0, 0, 14, 16]
    //   expire  1209600    = 0x00127500 -> [0, 18, 117, 0]
    //   minimum 3600       = 0x00000E10 -> [0, 0, 14, 16]
    //
    // Total: 16 + 18 + 20 = 54 bytes.

    let enc = dns_soa_encode("ns.example.com", "root.example.com", 2024010101, 7200, 3600, 1209600, 3600)

    // Total length
    cki("enc_len", bytes_len(enc), 54)

    // MNAME first label: length byte = 2, then 'n'=110, 's'=115
    cki("mname_lbl1_len", bytes_get(enc, 0), 2)
    cki("mname_lbl1_n",   bytes_get(enc, 1), 110)
    cki("mname_lbl1_s",   bytes_get(enc, 2), 115)

    // MNAME second label: 'example' length = 7 at offset 3
    cki("mname_lbl2_len", bytes_get(enc, 3), 7)
    cki("mname_lbl2_e",   bytes_get(enc, 4), 101)

    // MNAME third label: 'com' length = 3 at offset 11
    cki("mname_lbl3_len", bytes_get(enc, 11), 3)
    cki("mname_lbl3_c",   bytes_get(enc, 12), 99)

    // MNAME terminator at offset 15
    cki("mname_term", bytes_get(enc, 15), 0)

    // RNAME first label: 'root' length = 4 at offset 16
    cki("rname_lbl1_len", bytes_get(enc, 16), 4)
    cki("rname_lbl1_r",   bytes_get(enc, 17), 114)
    cki("rname_lbl1_o1",  bytes_get(enc, 18), 111)
    cki("rname_lbl1_o2",  bytes_get(enc, 19), 111)
    cki("rname_lbl1_t",   bytes_get(enc, 20), 116)

    // RNAME second label: 'example' length = 7 at offset 21
    cki("rname_lbl2_len", bytes_get(enc, 21), 7)

    // RNAME third label: 'com' length = 3 at offset 29
    cki("rname_lbl3_len", bytes_get(enc, 29), 3)

    // RNAME terminator at offset 33
    cki("rname_term", bytes_get(enc, 33), 0)

    // serial 2024010101 = 0x78A3F175 at offset 34
    cki("serial_b0", bytes_get(enc, 34), 120)
    cki("serial_b1", bytes_get(enc, 35), 163)
    cki("serial_b2", bytes_get(enc, 36), 241)
    cki("serial_b3", bytes_get(enc, 37), 117)

    // refresh 7200 = 0x00001C20 at offset 38
    cki("refresh_b0", bytes_get(enc, 38), 0)
    cki("refresh_b1", bytes_get(enc, 39), 0)
    cki("refresh_b2", bytes_get(enc, 40), 28)
    cki("refresh_b3", bytes_get(enc, 41), 32)

    // retry 3600 = 0x00000E10 at offset 42
    cki("retry_b0", bytes_get(enc, 42), 0)
    cki("retry_b1", bytes_get(enc, 43), 0)
    cki("retry_b2", bytes_get(enc, 44), 14)
    cki("retry_b3", bytes_get(enc, 45), 16)

    // expire 1209600 = 0x00127500 at offset 46
    cki("expire_b0", bytes_get(enc, 46), 0)
    cki("expire_b1", bytes_get(enc, 47), 18)
    cki("expire_b2", bytes_get(enc, 48), 117)
    cki("expire_b3", bytes_get(enc, 49), 0)

    // minimum 3600 = 0x00000E10 at offset 50
    cki("minimum_b0", bytes_get(enc, 50), 0)
    cki("minimum_b1", bytes_get(enc, 51), 0)
    cki("minimum_b2", bytes_get(enc, 52), 14)
    cki("minimum_b3", bytes_get(enc, 53), 16)

    // ── Vector B: full encode -> decode round-trip ────────────────────────────
    //
    // Decode the encoded SOA from offset 0 (the encode produces a standalone
    // RDATA blob — no DNS header, so no compression pointers exist; decode
    // directly from the encoded bytes starting at pos=0).

    let result = dns_soa_decode(enc, 0)
    let soa = result[0]
    let next = result[1]

    // next_pos must be 54 (consumed all bytes)
    cki("rt_next_pos", next, 54)

    // Names must round-trip exactly
    cks("rt_mname",  soa["mname"],   "ns.example.com")
    cks("rt_rname",  soa["rname"],   "root.example.com")

    // All five u32 values must match exactly
    cki("rt_serial",  soa["serial"],  2024010101)
    cki("rt_refresh", soa["refresh"], 7200)
    cki("rt_retry",   soa["retry"],   3600)
    cki("rt_expire",  soa["expire"],  1209600)
    cki("rt_minimum", soa["minimum"], 3600)

    // ── Vector C: edge cases — malformed input returns safe empty result ───────

    // Empty bytes -> [{}, 0]
    let empty_b = bytes(0)
    let r_empty = dns_soa_decode(empty_b, 0)
    let d_empty = r_empty[0]
    cki("empty_next", r_empty[1], 0)
    cki("empty_dict_serial", contains(d_empty, "serial"), 0)

    // Truncated (only MNAME, no RNAME or u32 fields) -> [{}, 0]
    let trunc = dns_soa_encode("ns.example.com", "root.example.com", 2024010101, 7200, 3600, 1209600, 3600)
    let trunc2 = bytes_slice(trunc, 0, 20)
    let r_trunc = dns_soa_decode(trunc2, 0)
    let d_trunc = r_trunc[0]
    cki("trunc_dict_serial", contains(d_trunc, "serial"), 0)

    // ── Vector D: zero-field SOA (all u32 = 0) ───────────────────────────────

    let enc0 = dns_soa_encode("a.b", "c.d", 0, 0, 0, 0, 0)
    let r0 = dns_soa_decode(enc0, 0)
    let soa0 = r0[0]
    cks("zero_mname",   soa0["mname"],   "a.b")
    cks("zero_rname",   soa0["rname"],   "c.d")
    cki("zero_serial",  soa0["serial"],  0)
    cki("zero_refresh", soa0["refresh"], 0)
    cki("zero_expire",  soa0["expire"],  0)

    // ── Vector E: maximum u32 values (0xFFFFFFFF) ────────────────────────────

    let encmax = dns_soa_encode("x.y", "z.w", 4294967295, 4294967295, 4294967295, 4294967295, 4294967295)
    let blen_max = bytes_len(encmax)
    // "x.y" = [1,'x',1,'y',0] = 5 bytes; "z.w" = [1,'z',1,'w',0] = 5 bytes; 20 = 30 total
    cki("max_len", blen_max, 30)
    // u32 starts at offset 10; all bytes should be 0xFF=255
    cki("max_b10", bytes_get(encmax, 10), 255)
    cki("max_b11", bytes_get(encmax, 11), 255)
    cki("max_b12", bytes_get(encmax, 12), 255)
    cki("max_b13", bytes_get(encmax, 13), 255)

    let rmax = dns_soa_decode(encmax, 0)
    let soamax = rmax[0]
    cki("max_serial",  soamax["serial"],  4294967295)
    cki("max_expire",  soamax["expire"],  4294967295)
    cki("max_minimum", soamax["minimum"], 4294967295)

    print("PASS _dns_rdata_soa_test")
