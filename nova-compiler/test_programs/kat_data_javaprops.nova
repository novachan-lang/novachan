// KAT for std/data/properties — Java .properties parser/writer.
// Covers: '=' ':' and whitespace separators, comments (# and !), blank
// lines, line continuation with leading-whitespace trim, escaped '=' in a
// key, \n \t \\ escapes, \uXXXX at the 1/2/3-byte UTF-8 width boundaries,
// leading-whitespace-in-value round trip, empty value, and full
// props_write -> props_parse round trip.
import std/data/properties

fn main()
    let nl = chr(10)

    // ---- 1. Build a document exercising every separator style, a
    // continuation, an escaped '=' in a key, unicode escapes at each
    // UTF-8 byte-width boundary, comments, and blank lines. ----
    let doc = ""
    doc = doc + "# a comment line" + nl
    doc = doc + "! also a comment" + nl
    doc = doc + nl
    doc = doc + "   " + nl
    doc = doc + "eq=value1" + nl
    doc = doc + "colon:value2" + nl
    doc = doc + "spaced value3" + nl
    doc = doc + "cont=part1\\" + nl
    doc = doc + "     part2" + nl
    doc = doc + "a\\=b=hello" + nl
    doc = doc + "uni1=\\u0041" + nl
    doc = doc + "uni2=\\u00e9" + nl
    doc = doc + "uni3=\\u4e2d" + nl
    doc = doc + "mix=\\u0041B\\u00e9C" + nl
    doc = doc + "escapes=a\\tb\\nc\\\\d" + nl
    doc = doc + "empty=" + nl
    doc = doc + "spacekey trimmed" + nl

    let p = props_parse(doc)

    // '=' separator
    if contains(p, "eq") == 0 or p["eq"] != "value1"
        print("FAIL eq separator: " + str(contains(p, "eq")))
        exit(1)

    // ':' separator
    if contains(p, "colon") == 0 or p["colon"] != "value2"
        print("FAIL colon separator")
        exit(1)

    // whitespace-only separator
    if contains(p, "spaced") == 0 or p["spaced"] != "value3"
        print("FAIL whitespace separator: got=" + p["spaced"])
        exit(1)

    // line continuation, continuation-line leading whitespace trimmed
    if contains(p, "cont") == 0 or p["cont"] != "part1part2"
        print("FAIL continuation: got=" + p["cont"])
        exit(1)

    // escaped '=' inside a key
    if contains(p, "a=b") == 0 or p["a=b"] != "hello"
        print("FAIL escaped-equals-in-key: has-key=" + str(contains(p, "a=b")))
        exit(1)
    if contains(p, "a") == 1
        print("FAIL escaped-equals-in-key: unescaped 'a' key should not exist")
        exit(1)

    // \uXXXX at the 1-byte boundary: U+0041 'A'
    if contains(p, "uni1") == 0 or p["uni1"] != "A"
        print("FAIL uni1 (1-byte utf8): got=" + p["uni1"])
        exit(1)

    // \uXXXX at the 2-byte boundary: U+00E9 'e' with acute -> C3 A9
    let expect_e9 = chr(0xC3) + chr(0xA9)
    if contains(p, "uni2") == 0 or p["uni2"] != expect_e9
        print("FAIL uni2 (2-byte utf8)")
        exit(1)
    if len(p["uni2"]) != 2
        print("FAIL uni2 byte length: " + str(len(p["uni2"])))
        exit(1)

    // \uXXXX at the 3-byte boundary: U+4E2D (CJK) -> E4 B8 AD
    let expect_4e2d = chr(0xE4) + chr(0xB8) + chr(0xAD)
    if contains(p, "uni3") == 0 or p["uni3"] != expect_4e2d
        print("FAIL uni3 (3-byte utf8)")
        exit(1)
    if len(p["uni3"]) != 3
        print("FAIL uni3 byte length: " + str(len(p["uni3"])))
        exit(1)

    // mixed literal + escaped unicode in one value
    let expect_mix = "A" + "B" + expect_e9 + "C"
    if contains(p, "mix") == 0 or p["mix"] != expect_mix
        print("FAIL mix value")
        exit(1)

    // \t \n \\ escapes
    let expect_escapes = "a" + chr(9) + "b" + chr(10) + "c" + chr(92) + "d"
    if contains(p, "escapes") == 0 or p["escapes"] != expect_escapes
        print("FAIL escapes value")
        exit(1)

    // empty value (key with '=' and nothing after)
    if contains(p, "empty") == 0 or p["empty"] != ""
        print("FAIL empty value: got=[" + p["empty"] + "]")
        exit(1)

    // whitespace-separated key containing no '=' or ':' at all, value has
    // no leading space to lose (space-separator variant, distinct key)
    if contains(p, "spacekey") == 0 or p["spacekey"] != "trimmed"
        print("FAIL spacekey: got=" + p["spacekey"])
        exit(1)

    // comments and blank lines must not have produced any spurious entries
    if contains(p, "# a comment line") == 1 or contains(p, "! also a comment") == 1
        print("FAIL comment lines leaked into dict")
        exit(1)

    print("PASS parse basics")

    // ---- 2. Round trip: props_write(props_parse(doc)) reparsed must
    // equal the original parsed dict, for every key/value including ones
    // with leading whitespace, embedded '#'/'!' as first char, embedded
    // '=', ':', backslash, and unicode. ----
    let src = {}
    src["plain"] = "value"
    src["eq:in:key"] = "colon value"
    src["with space"] = "a value"
    src["#hashkey"] = "v1"
    src["!bangkey"] = "v2"
    src["leadspace"] = "   three leading spaces"
    src["leadtab"] = chr(9) + "tab-led value"
    src["trailing"] = "value with trailing spaces   "
    src["backslashy"] = "C:\\path\\to\\file"
    src["newliney"] = "line1" + chr(10) + "line2"
    src["unicodey"] = expect_e9 + expect_4e2d
    src["emptyval"] = ""
    src[""] = "empty key value"

    let written = props_write(src)
    let reparsed = props_parse(written)

    let sk = keys(src)
    let ski = 0
    while ski < len(sk)
        let k = sk[ski]
        ski = ski + 1
        if contains(reparsed, k) == 0
            print("FAIL roundtrip missing key: [" + k + "]")
            exit(1)
        if reparsed[k] != src[k]
            print("FAIL roundtrip value mismatch for [" + k + "]: got=[" + reparsed[k] + "] want=[" + src[k] + "]")
            exit(1)
    if len(keys(reparsed)) != len(sk)
        print("FAIL roundtrip key count: got=" + str(len(keys(reparsed))) + " want=" + str(len(sk)))
        exit(1)

    print("PASS round trip")

    // ---- 3. Boundary / defensive cases ----

    // dangling trailing backslash with nothing after it (last line, no
    // continuation partner) must not crash and must keep the backslash
    // literally in the value.
    let p3 = props_parse("k=v\\")
    if contains(p3, "k") == 0 or p3["k"] != "v" + chr(92)
        print("FAIL dangling trailing backslash: got=" + p3["k"])
        exit(1)

    // malformed \u with fewer than 4 hex digits at end of value must not
    // crash (defensive: treats missing digits as 0).
    let p4 = props_parse("k=\\u41")
    if contains(p4, "k") == 0
        print("FAIL malformed unicode escape: key missing")
        exit(1)

    // empty document
    let p5 = props_parse("")
    if len(keys(p5)) != 0
        print("FAIL empty doc: expected 0 keys, got " + str(len(keys(p5))))
        exit(1)

    // duplicate keys: last wins
    let p6 = props_parse("dup=first" + nl + "dup=second")
    if p6["dup"] != "second"
        print("FAIL duplicate key last-wins: got=" + p6["dup"])
        exit(1)

    // props_write on an empty dict -> empty string, and it parses back to
    // an empty dict.
    let empty_dict = {}
    let empty_written = props_write(empty_dict)
    if empty_written != ""
        print("FAIL empty dict write: got=[" + empty_written + "]")
        exit(1)
    if len(keys(props_parse(empty_written))) != 0
        print("FAIL empty dict write/parse round trip")
        exit(1)

    print("PASS boundary cases")
    print("ALL PASS")
