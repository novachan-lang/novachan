// KAT test for std/encoding/atbash
import "std/encoding/atbash"

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // KAT 1: uppercase ABC -> ZYX
    cks("kat1_upper", at_transform("ABC"), "ZYX")

    // KAT 2: mixed case Hello -> Svool
    cks("kat2_hello", at_transform("Hello"), "Svool")

    // KAT 3: self-inverse on "test"
    cks("kat3_selfinverse", at_transform(at_transform("test")), "test")

    // KAT 4: lowercase abc -> zyx
    cks("kat4_lower", at_transform("abc"), "zyx")

    // KAT 5: non-letter preserved: "Hi!" -> "Sr!"
    cks("kat5_nonletter", at_transform("Hi!"), "Sr!")

    // KAT 6: empty string -> empty string
    cks("kat6_empty", at_transform(""), "")

    // KAT 7: digits and spaces pass through unchanged
    cks("kat7_digits", at_transform("A1 Z"), "Z1 A")

    // KAT 8: full alphabet round-trip
    cks("kat8_fullalpha", at_transform(at_transform("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz")), "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz")

    print("_atbash_test passed")
