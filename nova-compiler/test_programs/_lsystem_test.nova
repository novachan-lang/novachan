// KAT for std/automata/lsystem
// Tests the algae L-system (axiom "A", A->AB, B->A) and a Cantor-set system.

import std/automata/lsystem

fn main()
    // --- Algae L-system ---
    // axiom="A", rules: A->AB, B->A
    // gen 0: A
    // gen 1: AB
    // gen 2: ABA
    // gen 3: ABAAB
    // gen 4: ABAABABA
    // gen 5: ABAABABAABAAB  (len 13, Fibonacci)
    let algae = ls_new("A")
    ls_add_rule(algae, "A", "AB")
    ls_add_rule(algae, "B", "A")

    // KAT 1: generation 0 == "A"
    let g0 = ls_generate(algae, 0)
    if g0 != "A"
        print("FAIL KAT1: gen0 expected A got " + g0)
        exit(1)

    // KAT 2: generation 1 == "AB"
    let g1 = ls_generate(algae, 1)
    if g1 != "AB"
        print("FAIL KAT2: gen1 expected AB got " + g1)
        exit(1)

    // KAT 3: generation 2 == "ABA"
    let g2 = ls_generate(algae, 2)
    if g2 != "ABA"
        print("FAIL KAT3: gen2 expected ABA got " + g2)
        exit(1)

    // KAT 4: generation 3 == "ABAAB"
    let g3 = ls_generate(algae, 3)
    if g3 != "ABAAB"
        print("FAIL KAT4: gen3 expected ABAAB got " + g3)
        exit(1)

    // KAT 5: generation 4 == "ABAABABA"
    let g4 = ls_generate(algae, 4)
    if g4 != "ABAABABA"
        print("FAIL KAT5: gen4 expected ABAABABA got " + g4)
        exit(1)

    // KAT 6: length at generation 5 == 13 (Fibonacci: 1,1,2,3,5,8,13)
    let len5 = ls_length(algae, 5)
    if len5 != 13
        print("FAIL KAT6: len(gen5) expected 13 got " + str(len5))
        exit(1)

    // --- Cantor set L-system ---
    // axiom="A", rules: A->ABA, B->BBB
    // gen 0: A
    // gen 1: ABA
    // gen 2: ABABBBABA  (9 chars)
    let cantor = ls_new("A")
    ls_add_rule(cantor, "A", "ABA")
    ls_add_rule(cantor, "B", "BBB")

    // KAT 7: generation 1 of Cantor system == "ABA"
    let c1 = ls_generate(cantor, 1)
    if c1 != "ABA"
        print("FAIL KAT7: cantor gen1 expected ABA got " + c1)
        exit(1)

    // KAT 8: generation 2 of Cantor system == "ABABBBABA"
    let c2 = ls_generate(cantor, 2)
    if c2 != "ABABBBABA"
        print("FAIL KAT8: cantor gen2 expected ABABBBABA got " + c2)
        exit(1)

    print("_lsystem_test passed")
