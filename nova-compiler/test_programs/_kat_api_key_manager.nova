import forge_api_key_manager

fn main()
    let a = akm_new()
    a = akm_create(a, "key-read", "read")
    a = akm_create(a, "key-write", "write")
    a = akm_create(a, "key-admin", "admin")
    assert(akm_active_count(a) == 3, "3 active")

    let r1 = akm_validate(a, "key-read", "read")
    a = r1["a"]
    assert(r1["valid"] == 1, "read key valid for read")

    let r2 = akm_validate(a, "key-read", "write")
    a = r2["a"]
    assert(r2["valid"] == 0, "read key invalid for write")
    assert(r2["reason"] == "insufficient_scope", "scope error")

    let r3 = akm_validate(a, "key-admin", "write")
    a = r3["a"]
    assert(r3["valid"] == 1, "admin key valid for write")

    assert(akm_usage(a, "key-read") == 1, "1 use read")
    assert(akm_usage(a, "key-admin") == 1, "1 use admin")
    assert(akm_scope(a, "key-write") == "write", "write scope")

    a = akm_revoke(a, "key-write")
    assert(akm_active_count(a) == 2, "2 active after revoke")
    let r4 = akm_validate(a, "key-write", "write")
    a = r4["a"]
    assert(r4["valid"] == 0, "revoked")

    let r5 = akm_validate(a, "unknown", "read")
    a = r5["a"]
    assert(r5["valid"] == 0, "unknown key")

    print("API-KEY-MANAGER KAT PASS")
