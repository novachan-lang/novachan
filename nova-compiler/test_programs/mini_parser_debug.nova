type Token
    kind: string
    value: string

type Expr
    tag: string
    num_val: int
    op: string
    children: list

fn make_num(n: int) -> Expr
    Expr("num", n, "", [])

fn make_binop(op: string, left: Expr, right: Expr) -> Expr
    Expr("binop", 0, op, [left, right])

fn eval(e: Expr) -> int
    match e
        Expr(tag, num_val, op, children) =>
            if tag == "num"
                num_val
            else
                let l = eval(children[0])
                let r = eval(children[1])
                if op == "+"
                    l + r
                else
                    l - r

fn test()
    let a = make_num(3)
    let b = make_num(4)
    let expr = make_binop("+", a, b)
    print("created expr")
    let result = eval(expr)
    print("result: " + str(result))

test()
