import forge_runningmedian

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

// brute-force median x2 of a list (sort, take middles)
fn brute_x2(vals: list) -> int
    let s = []
    let i = 0
    while i < len(vals)
        push(s, vals[i])
        i = i + 1
    // insertion sort
    let a = 1
    while a < len(s)
        let key = s[a]
        let b = a - 1
        while b >= 0 and s[b] > key
            s[b + 1] = s[b]
            b = b - 1
        s[b + 1] = key
        a = a + 1
    let n = len(s)
    let out = 0
    if n > 0
        if n % 2 == 1
            out = 2 * s[n / 2]
        else
            out = s[n / 2 - 1] + s[n / 2]
    out

fn main()
    let fails = 0

    // streaming median through a sequence
    let rm = rm_new()
    rm_add(rm, 5)
    fails = fails + expect("m1", str(rm_median_x2(rm)), "10")
    rm_add(rm, 15)
    fails = fails + expect("m2", str(rm_median_x2(rm)), "20")
    rm_add(rm, 1)
    fails = fails + expect("m3", str(rm_median_x2(rm)), "10")
    rm_add(rm, 3)
    fails = fails + expect("m4", str(rm_median_x2(rm)), "8")
    rm_add(rm, 2)
    fails = fails + expect("m5", str(rm_median_x2(rm)), "6")
    fails = fails + expect("size", str(rm_size(rm)), "5")
    fails = fails + expect("lower", str(rm_median_lower(rm)), "3")

    // 1,2,3 -> median 2
    let r2 = rm_new()
    rm_add(r2, 1)
    rm_add(r2, 2)
    rm_add(r2, 3)
    fails = fails + expect("odd_x2", str(rm_median_x2(r2)), "4")
    // 1,2,3,4 -> median 2.5, x2=5, lower=2
    rm_add(r2, 4)
    fails = fails + expect("even_x2", str(rm_median_x2(r2)), "5")
    fails = fails + expect("even_lower", str(rm_median_lower(r2)), "2")

    // brute-force cross-check on a longer stream
    let data = [23, 4, 17, 42, 8, 15, 16, 1, 30, 9, 11, 5, 27, 3, 19]
    let rm3 = rm_new()
    let seen = []
    let ok = 1
    let i = 0
    while i < len(data)
        rm_add(rm3, data[i])
        push(seen, data[i])
        if rm_median_x2(rm3) != brute_x2(seen)
            ok = 0
        i = i + 1
    fails = fails + expect("brute_cross", str(ok), "1")

    // handles duplicates
    let r4 = rm_new()
    rm_add(r4, 7)
    rm_add(r4, 7)
    rm_add(r4, 7)
    fails = fails + expect("dups", str(rm_median_x2(r4)), "14")

    if fails == 0
        print("forge_runningmedian: all passed")
    else
        print("forge_runningmedian: " + str(fails) + " FAILED")
