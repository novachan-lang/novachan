import std/collections/disjointinterval

// Helper: compare two [lo,hi] interval lists for structural equality.
// Returns 1 if identical length and every pair matches.
fn intervals_equal(a, b)
    if len(a) != len(b)
        return 0
    let i = 0
    let ok = 1
    while i < len(a)
        let ii = i
        let pa = a[ii]
        let pb = b[ii]
        if pa[0] != pb[0] or pa[1] != pb[1]
            ok = 0
        i = i + 1
    return ok

// ---- KAT 1: basic add + intervals after merge of overlapping pair -----------
let s = dvl_new()
dvl_add(s, 1, 3)
dvl_add(s, 5, 7)
dvl_add(s, 2, 4)
// [1,3] + [2,4] should merge -> [1,4]; [5,7] stays separate
let iv1 = dvl_intervals(s)
let exp1 = [[1, 4], [5, 7]]
if intervals_equal(iv1, exp1) == 0
    print("FAIL KAT1: dvl_intervals after merge should be [[1,4],[5,7]], got " + str(len(iv1)) + " intervals")
    exit(1)

// ---- KAT 2: dvl_contains x=2 (inside first interval) -----------------------
if dvl_contains(s, 2) != 1
    print("FAIL KAT2: dvl_contains(s,2) should be 1")
    exit(1)

// ---- KAT 3: dvl_contains x=4 (boundary of first interval) ------------------
if dvl_contains(s, 4) != 1
    print("FAIL KAT3: dvl_contains(s,4) should be 1")
    exit(1)

// ---- KAT 4: dvl_contains x=8 (outside all intervals) -----------------------
if dvl_contains(s, 8) != 0
    print("FAIL KAT4: dvl_contains(s,8) should be 0")
    exit(1)

// ---- KAT 5: dvl_total_length = (4-1+1) + (7-5+1) = 4 + 3 = 7 -------------
let tl1 = dvl_total_length(s)
if tl1 != 7
    print("FAIL KAT5: dvl_total_length should be 7, got " + str(tl1))
    exit(1)

// ---- KAT 6: dvl_count = 2 --------------------------------------------------
let cnt1 = dvl_count(s)
if cnt1 != 2
    print("FAIL KAT6: dvl_count should be 2, got " + str(cnt1))
    exit(1)

// ---- KAT 7: add [4,5] bridges the gap -> [1,7] (one merged interval) -------
dvl_add(s, 4, 5)
let iv2 = dvl_intervals(s)
let exp2 = [[1, 7]]
if intervals_equal(iv2, exp2) == 0
    print("FAIL KAT7: dvl_intervals after bridging merge should be [[1,7]], got " + str(len(iv2)) + " intervals")
    exit(1)

// ---- KAT 8: dvl_count after full merge should be 1 -------------------------
let cnt2 = dvl_count(s)
if cnt2 != 1
    print("FAIL KAT8: dvl_count after merge should be 1, got " + str(cnt2))
    exit(1)

// ---- KAT 9: dvl_total_length after full merge = 7-1+1 = 7 ------------------
let tl2 = dvl_total_length(s)
if tl2 != 7
    print("FAIL KAT9: dvl_total_length after merge should be 7, got " + str(tl2))
    exit(1)

// ---- KAT 10: fresh set with non-adjacent intervals, check count+total -------
let s2 = dvl_new()
dvl_add(s2, 10, 20)
dvl_add(s2, 30, 40)
dvl_add(s2, 50, 60)
let cnt3 = dvl_count(s2)
if cnt3 != 3
    print("FAIL KAT10a: dvl_count should be 3, got " + str(cnt3))
    exit(1)
let tl3 = dvl_total_length(s2)
// (20-10+1)+(40-30+1)+(60-50+1) = 11+11+11 = 33
if tl3 != 33
    print("FAIL KAT10b: dvl_total_length should be 33, got " + str(tl3))
    exit(1)

// ---- KAT 11: merging across a gap with a single spanning interval -----------
// add [15,35] to s2 which has [10,20],[30,40],[50,60]
// [15,35] overlaps/adjacent [10,20] -> merge to [10,35]
// [10,35] overlaps [30,40] -> merge to [10,40]
// [50,60] stays separate -> result [[10,40],[50,60]]
dvl_add(s2, 15, 35)
let iv3 = dvl_intervals(s2)
let exp3 = [[10, 40], [50, 60]]
if intervals_equal(iv3, exp3) == 0
    print("FAIL KAT11: dvl_intervals should be [[10,40],[50,60]]")
    exit(1)

// ---- KAT 12: single-point interval add and contains ------------------------
let s3 = dvl_new()
dvl_add(s3, 5, 5)
if dvl_contains(s3, 5) != 1
    print("FAIL KAT12a: dvl_contains single-point should be 1")
    exit(1)
if dvl_contains(s3, 4) != 0
    print("FAIL KAT12b: dvl_contains adjacent-left should be 0")
    exit(1)
let tl4 = dvl_total_length(s3)
if tl4 != 1
    print("FAIL KAT12c: dvl_total_length single-point should be 1, got " + str(tl4))
    exit(1)

print("_disjointinterval_test passed")
