// KAT for std/testing/assert — assertion primitives that return result dicts.
// Every assertion verifies the ["ok"] field of the returned dict.
// Uses inline cki/cks/ckb helpers (never calls exit on success).
import std/testing/assert

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + got + " want " + want)
        exit(1)

fn ckb(label, got, want)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got " + gs + " want " + ws)
        exit(1)

fn main()
    // ── assrt_eq ──────────────────────────────────────────────────────────────
    // KAT: assrt_eq(2,2)["ok"] == true
    let r1 = assrt_eq(2, 2)
    cki("eq_ok_true", r1["ok"], 1)
    cks("eq_ok_msg_empty", r1["msg"], "")

    // KAT: assrt_eq(2,3)["ok"] == false
    let r2 = assrt_eq(2, 3)
    cki("eq_ok_false", r2["ok"], 0)

    // equality on strings
    let r3 = assrt_eq("hello", "hello")
    cki("eq_str_ok", r3["ok"], 1)

    let r4 = assrt_eq("hello", "world")
    cki("eq_str_fail", r4["ok"], 0)

    // ── assrt_ne ──────────────────────────────────────────────────────────────
    // KAT: assrt_ne(2,3)["ok"] == true
    let r5 = assrt_ne(2, 3)
    cki("ne_ok_true", r5["ok"], 1)

    let r6 = assrt_ne(2, 2)
    cki("ne_ok_false", r6["ok"], 0)

    // ── assrt_true ────────────────────────────────────────────────────────────
    // KAT: assrt_true(1)["ok"] == true
    let r7 = assrt_true(1)
    cki("true_ok_1", r7["ok"], 1)

    let r8 = assrt_true(0)
    cki("true_ok_0", r8["ok"], 0)

    // ── assrt_false ───────────────────────────────────────────────────────────
    let r9 = assrt_false(0)
    cki("false_ok_0", r9["ok"], 1)

    let r10 = assrt_false(1)
    cki("false_ok_1", r10["ok"], 0)

    // ── assrt_null ────────────────────────────────────────────────────────────
    // KAT: assrt_null(null)["ok"] == true
    let r11 = assrt_null(null)
    cki("null_ok", r11["ok"], 1)

    let r12 = assrt_null(42)
    cki("null_fail", r12["ok"], 0)

    // ── assrt_gt / assrt_lt ───────────────────────────────────────────────────
    let r13 = assrt_gt(5, 3)
    cki("gt_ok", r13["ok"], 1)

    let r14 = assrt_gt(3, 5)
    cki("gt_fail", r14["ok"], 0)

    let r15 = assrt_lt(3, 5)
    cki("lt_ok", r15["ok"], 1)

    let r16 = assrt_lt(5, 3)
    cki("lt_fail", r16["ok"], 0)

    // ── assrt_near ────────────────────────────────────────────────────────────
    // KAT: assrt_near(1.0, 1.0001, 0.001)["ok"] == true
    let r17 = assrt_near(1.0, 1.0001, 0.001)
    cki("near_ok", r17["ok"], 1)

    // |1.0 - 1.5| = 0.5 > 0.001 -> false
    let r18 = assrt_near(1.0, 1.5, 0.001)
    cki("near_fail", r18["ok"], 0)

    // exact match -> ok
    let r19 = assrt_near(3.14, 3.14, 0.0)
    cki("near_exact", r19["ok"], 1)

    // ── assrt_contains (string substring) ────────────────────────────────────
    // KAT: assrt_contains("hello","ell")["ok"] == true
    let r20 = assrt_contains("hello", "ell")
    cki("contains_str_ok", r20["ok"], 1)

    let r21 = assrt_contains("hello", "xyz")
    cki("contains_str_fail", r21["ok"], 0)

    // ── assrt_contains (list membership) ─────────────────────────────────────
    // KAT: assrt_contains([1,2,3],2)["ok"] == true
    let r22 = assrt_contains([1, 2, 3], 2)
    cki("contains_list_ok", r22["ok"], 1)

    let r23 = assrt_contains([1, 2, 3], 99)
    cki("contains_list_fail", r23["ok"], 0)

    // string element in list
    let r24 = assrt_contains(["a", "b", "c"], "b")
    cki("contains_list_str_ok", r24["ok"], 1)

    // ── assrt_all ─────────────────────────────────────────────────────────────
    // KAT: assrt_all([assrt_eq(1,1), assrt_true(1)])["ok"] == true
    let sub1 = assrt_eq(1, 1)
    let sub2 = assrt_true(1)
    let r25 = assrt_all([sub1, sub2])
    cki("all_ok", r25["ok"], 1)

    // KAT: assrt_all([assrt_eq(1,2)])["ok"] == false
    let sub3 = assrt_eq(1, 2)
    let r26 = assrt_all([sub3])
    cki("all_fail", r26["ok"], 0)

    // mixed: first passes, second fails -> all_ok must be 0
    let sub4 = assrt_eq(5, 5)
    let sub5 = assrt_eq(5, 6)
    let r27 = assrt_all([sub4, sub5])
    cki("all_mixed_fail", r27["ok"], 0)

    // empty list -> trivially true (no failing item)
    let r28 = assrt_all([])
    cki("all_empty_ok", r28["ok"], 1)

    print("_assert_test passed")
