// Pins is_dict/is_list/is_string/is_int on ANY-typed values. Before the fix these always
// returned 0 (the compiler emitted a static const 0 for the undecidable case); now the
// compiler emits a runtime nova_rt_type_pred check. Also guards the static path still works.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": " + str(got) + " != " + str(want))
        exit(1)

fn main()
    let d = {}
    d["k"] = 1
    let l = [1, 2, 3]
    let s = "hi"

    // static path (arg type known): must still evaluate at compile time
    cki("static_dict", is_dict(d), 1)
    cki("static_list", is_list(l), 1)
    cki("static_str", is_string(s), 1)
    cki("static_dict_not_list", is_list(d), 0)

    // any path (dict reads are 'any'): the fix -> runtime type check, not a static 0
    let box = {}
    box["dict"] = d
    box["list"] = l
    box["str"] = s
    box["int"] = 42
    cki("any_dict_is_dict", is_dict(box["dict"]), 1)
    cki("any_dict_is_list", is_list(box["dict"]), 0)
    cki("any_list_is_list", is_list(box["list"]), 1)
    cki("any_list_is_dict", is_dict(box["list"]), 0)
    cki("any_str_is_string", is_string(box["str"]), 1)
    cki("any_str_is_dict", is_dict(box["str"]), 0)
    cki("any_int_is_int", is_int(box["int"]), 1)
    cki("any_int_is_dict", is_dict(box["int"]), 0)

    print("_typepred_test passed")
