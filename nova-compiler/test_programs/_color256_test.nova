import std/term/color256

fn _fail(label: str, got: str, want: str)
    print("FAIL color256 " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
    print("  got =" + got)
    print("  want=" + want)
    exit(1)

fn _assert(label: str, got: str, want: str)
    if got == want
        return
    _fail(label, got, want)

fn main()
    // ── fg256 ────────────────────────────────────────────────────────────────
    // fg256(5) == ESC[38;5;5m
    let esc = chr(27)
    let want_fg5 = esc + "[38;5;5m"
    let got_fg5 = fg256(5)
    _assert("fg256(5)", got_fg5, want_fg5)

    // fg256(0) == ESC[38;5;0m
    let want_fg0 = esc + "[38;5;0m"
    let got_fg0 = fg256(0)
    _assert("fg256(0)", got_fg0, want_fg0)

    // fg256(255) == ESC[38;5;255m
    let want_fg255 = esc + "[38;5;255m"
    let got_fg255 = fg256(255)
    _assert("fg256(255)", got_fg255, want_fg255)

    // ── bg256 ────────────────────────────────────────────────────────────────
    // bg256(200) == ESC[48;5;200m
    let want_bg200 = esc + "[48;5;200m"
    let got_bg200 = bg256(200)
    _assert("bg256(200)", got_bg200, want_bg200)

    // bg256(0) == ESC[48;5;0m
    let want_bg0 = esc + "[48;5;0m"
    let got_bg0 = bg256(0)
    _assert("bg256(0)", got_bg0, want_bg0)

    // ── fg_rgb ───────────────────────────────────────────────────────────────
    // fg_rgb(255,128,0) == ESC[38;2;255;128;0m
    let want_fgrgb = esc + "[38;2;255;128;0m"
    let got_fgrgb = fg_rgb(255, 128, 0)
    _assert("fg_rgb(255,128,0)", got_fgrgb, want_fgrgb)

    // fg_rgb(0,0,0)
    let want_fgblack = esc + "[38;2;0;0;0m"
    let got_fgblack = fg_rgb(0, 0, 0)
    _assert("fg_rgb(0,0,0)", got_fgblack, want_fgblack)

    // fg_rgb(255,255,255)
    let want_fgwhite = esc + "[38;2;255;255;255m"
    let got_fgwhite = fg_rgb(255, 255, 255)
    _assert("fg_rgb(255,255,255)", got_fgwhite, want_fgwhite)

    // ── bg_rgb ───────────────────────────────────────────────────────────────
    // bg_rgb(0,0,0) == ESC[48;2;0;0;0m
    let want_bgblack = esc + "[48;2;0;0;0m"
    let got_bgblack = bg_rgb(0, 0, 0)
    _assert("bg_rgb(0,0,0)", got_bgblack, want_bgblack)

    // bg_rgb(255,128,64)
    let want_bgc = esc + "[48;2;255;128;64m"
    let got_bgc = bg_rgb(255, 128, 64)
    _assert("bg_rgb(255,128,64)", got_bgc, want_bgc)

    // ── colorize256 ──────────────────────────────────────────────────────────
    // colorize256("x", 21) == ESC[38;5;21m + "x" + ESC[0m
    let want_col = esc + "[38;5;21m" + "x" + esc + "[0m"
    let got_col = colorize256("x", 21)
    _assert("colorize256(x,21)", got_col, want_col)

    // colorize256 with multi-char text
    let want_col2 = esc + "[38;5;100m" + "hello" + esc + "[0m"
    let got_col2 = colorize256("hello", 100)
    _assert("colorize256(hello,100)", got_col2, want_col2)

    // colorize256 empty text returns unchanged
    let got_empty = colorize256("", 21)
    _assert("colorize256(empty,21)", got_empty, "")

    // ── clamp: n > 255 clamped to 255 ────────────────────────────────────────
    let want_clamp = esc + "[38;5;255m"
    let got_clamp = fg256(300)
    _assert("fg256(300)->clamp255", got_clamp, want_clamp)

    // clamp negative to 0
    let want_neg = esc + "[38;5;0m"
    let got_neg = fg256(-5)
    _assert("fg256(-5)->clamp0", got_neg, want_neg)

    // bg256 clamp
    let want_bgclamp = esc + "[48;5;255m"
    let got_bgclamp = bg256(999)
    _assert("bg256(999)->clamp255", got_bgclamp, want_bgclamp)

    // rgb clamp channels individually
    let want_rgbclamp = esc + "[38;2;255;255;255m"
    let got_rgbclamp = fg_rgb(300, 400, 500)
    _assert("fg_rgb(300,400,500)->clamp", got_rgbclamp, want_rgbclamp)

    // ── length sanity checks ─────────────────────────────────────────────────
    // fg256(5): ESC(1) + [(1) + 38(2) + ;(1) + 5(1) + ;(1) + 5(1) + m(1) = 9
    let exp_len_fg5 = 9
    if len(got_fg5) == exp_len_fg5 == false
        print("FAIL color256 len(fg256(5)): got=" + str(len(got_fg5)) + " want=" + str(exp_len_fg5))
        exit(1)

    print("PASS _color256_test")
