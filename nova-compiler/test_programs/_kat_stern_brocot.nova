import std/math/stern_brocot as sb

fn main()
    assert_eq(sb.sb_mediant(0,1,1,0), [1,1])
    assert_eq(sb.sb_path_to_fraction([]), [1,1])
    assert_eq(sb.sb_path_to_fraction(["L"]), [1,2])
    assert_eq(sb.sb_path_to_fraction(["R"]), [2,1])
    assert_eq(sb.sb_path_to_fraction(["L","L"]), [1,3])
    assert_eq(sb.sb_path_to_fraction(["R","R"]), [3,1])
    assert_eq(sb.sb_path_to_fraction(["L","R"]), [2,3])
    assert_eq(sb.sb_path_to_fraction(["R","L"]), [3,2])
    assert_eq(sb.sb_fraction_to_path(2,3), ["L","R"])
    assert_eq(sb.sb_fraction_to_path(3,2), ["R","L"])
    assert_eq(sb.sb_fraction_to_path(1,1), [])
    assert_eq(sb.sb_parent(2,3), [1,2])
    assert_eq(sb.sb_parent(3,2), [2,1])
    assert_eq(sb.sb_parent(1,1), [1,1])
    assert_eq(sb.sb_depth(1,1), 0)
    assert_eq(sb.sb_depth(2,3), 2)
    print("ALL OK")
