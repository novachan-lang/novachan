import forge_evalmetrics

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn near(a: float, b: float) -> bool
    let d = a - b
    d > -0.001 and d < 0.001

fn main()
    let fails = 0
    let actual = ["cat", "dog", "cat", "cat", "dog", "dog"]
    let pred = ["cat", "dog", "dog", "cat", "dog", "cat"]

    // accuracy: matches at 0,1,3,4 = 4/6
    fails = fails + expect_true("accuracy", near(eval_accuracy(actual, pred), 0.66667))

    // confusion for pos=cat: TP=2 (0,3), FP=1 (5), FN=1 (2), TN=2 (1,4)
    let cm = eval_confusion(actual, pred, "cat")
    fails = fails + expect("confusion", str(cm[0]) + "," + str(cm[1]) + "," + str(cm[2]) + "," + str(cm[3]), "2,1,1,2")

    // precision/recall/f1 for cat = 2/3 each
    fails = fails + expect_true("precision", near(eval_precision(actual, pred, "cat"), 0.66667))
    fails = fails + expect_true("recall", near(eval_recall(actual, pred, "cat"), 0.66667))
    fails = fails + expect_true("f1", near(eval_f1(actual, pred, "cat"), 0.66667))

    // perfect prediction
    let perf = ["a", "b", "a", "b"]
    fails = fails + expect_true("perfect_acc", near(eval_accuracy(perf, perf), 1.0))
    fails = fails + expect_true("perfect_f1", near(eval_f1(perf, perf, "a"), 1.0))

    // all wrong
    let aw = ["a", "a"]
    let pw = ["b", "b"]
    fails = fails + expect_true("wrong_acc", near(eval_accuracy(aw, pw), 0.0))
    fails = fails + expect_true("wrong_prec", near(eval_precision(aw, pw, "a"), 0.0))

    // imbalanced: 9 ham, 1 spam; predict all ham -> accuracy 0.9 but spam recall 0
    let ia = ["ham", "ham", "ham", "ham", "ham", "ham", "ham", "ham", "ham", "spam"]
    let ip = ["ham", "ham", "ham", "ham", "ham", "ham", "ham", "ham", "ham", "ham"]
    fails = fails + expect_true("imb_acc_high", near(eval_accuracy(ia, ip), 0.9))
    fails = fails + expect_true("imb_spam_recall_0", near(eval_recall(ia, ip, "spam"), 0.0))
    fails = fails + expect_true("imb_ham_recall_1", near(eval_recall(ia, ip, "ham"), 1.0))
    // macro F1 penalizes the missed class (ham F1 high, spam F1 0 -> macro ~ 0.47)
    let mf1 = eval_macro_f1(ia, ip)
    fails = fails + expect_true("macro_f1_low", mf1 < 0.5)

    // empty
    fails = fails + expect_true("empty_acc", near(eval_accuracy([], []), 0.0))

    if fails == 0
        print("forge_evalmetrics: all passed")
    else
        print("forge_evalmetrics: " + str(fails) + " FAILED")
