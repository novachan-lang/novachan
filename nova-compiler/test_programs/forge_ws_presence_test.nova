// forge_ws_presence_test -- a WS room handler calls forge.hub_count(hub) WHILE serving (the demo's "N
// online" presence pattern) and broadcasts it. Verifies that a request/reply hub query from inside a live
// room reader task works (no deadlock) and reports the right count over a real socket.
import forge

fn _b(s: string)
    let n = len(s)
    let out = bytes(0)
    let i = 0
    while i < n
        out = bytes_append(out, ord(char_at(s, i)))
        i = i + 1
    out

fn _on(ws, msg, hub)
    forge.room_say(hub, "[" + str(forge.hub_count(hub)) + " online] " + bytes_to_str(msg))

fn _server(port: int)
    let a = forge.app()
    let h = forge.hub()
    forge.ws_room(a, "/room", h, fn(ws, msg, hub) _on(ws, msg, hub))
    forge.serve_req_n(a, port, 1)

fn _read_frame(sock)
    let buf = bytes(0)
    let guard = 0
    while guard < 1000
        guard = guard + 1
        let fr = forge.ws_try_decode(buf, 0)
        if fr.status == 1
            return fr.payload
        let chunk = tcp_recv_bytes(sock)
        if bytes_len(chunk) == 0
            return bytes(0)
        buf = bytes_concat(buf, chunk)
    bytes(0)

fn main()
    let port = 19402
    spawn fn()
        _server(port)
    sleep(300)
    let sock = tcp_connect("127.0.0.1", port)
    tcp_send(sock, "GET /room HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n")
    let r101 = tcp_recv(sock)
    while find(r101, "\r\n\r\n") < 0
        let more = tcp_recv(sock)
        if len(more) == 0
            r101 = r101
        r101 = r101 + more
    assert(find(r101, "101") >= 0, "handshake ok")

    tcp_send_bytes(sock, forge.ws_encode_frame(1, 1, _b("hello"), [3, 1, 4, 1]))
    let echo = bytes_to_str(_read_frame(sock))
    assert(echo == "[1 online] hello", "room handler queried hub_count WHILE serving and broadcast it (got '" + echo + "')")
    print("PASS: hub_count works inside a live room handler -- '" + echo + "'")

    tcp_send_bytes(sock, forge.ws_encode_frame(1, 8, bytes(0), [1, 2, 3, 4]))
    tcp_close(sock)
    print("forge_ws_presence_test passed")
