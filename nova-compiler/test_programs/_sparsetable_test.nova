import std/collections/sparsetable

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn main()
    // xs = [5, 2, 8, 1, 9, 3, 7]
    let xs = []
    xs.push(5)
    xs.push(2)
    xs.push(8)
    xs.push(1)
    xs.push(9)
    xs.push(3)
    xs.push(7)

    // --- Range minimum ---
    let t = sp_build_min(xs)

    // KAT 1: min over full range [0,6] = 1
    cki("min[0,6]", sp_query_min(t, 0, 6), 1)

    // KAT 2: min [0,2] = min(5,2,8) = 2
    cki("min[0,2]", sp_query_min(t, 0, 2), 2)

    // KAT 3: min [4,6] = min(9,3,7) = 3
    cki("min[4,6]", sp_query_min(t, 4, 6), 3)

    // KAT 4: single element [3,3] = 1
    cki("min[3,3]", sp_query_min(t, 3, 3), 1)

    // KAT 5: min [1,4] = min(2,8,1,9) = 1
    cki("min[1,4]", sp_query_min(t, 1, 4), 1)

    // KAT 6: min [0,1] = min(5,2) = 2
    cki("min[0,1]", sp_query_min(t, 0, 1), 2)

    // --- Range maximum ---
    let tm = sp_build_max(xs)

    // KAT 7: max over full range [0,6] = 9
    cki("max[0,6]", sp_query_max(tm, 0, 6), 9)

    // KAT 8: max [0,2] = max(5,2,8) = 8
    cki("max[0,2]", sp_query_max(tm, 0, 2), 8)

    // KAT 9: max [5,6] = max(3,7) = 7
    cki("max[5,6]", sp_query_max(tm, 5, 6), 7)

    // KAT 10: single element [0,0] = 5
    cki("max[0,0]", sp_query_max(tm, 0, 0), 5)

    // KAT 11: max [2,4] = max(8,1,9) = 9
    cki("max[2,4]", sp_query_max(tm, 2, 4), 9)

    // --- Range GCD ---
    // Use xs2 = [12, 8, 4, 16] for clean GCD values
    let xs2 = []
    xs2.push(12)
    xs2.push(8)
    xs2.push(4)
    xs2.push(16)

    let tg = sp_build_gcd(xs2)

    // KAT 12: gcd(12,8,4,16) = 4
    cki("gcd[0,3]", sp_query_gcd(tg, 0, 3), 4)

    // KAT 13: gcd(12,8) = 4
    cki("gcd[0,1]", sp_query_gcd(tg, 0, 1), 4)

    // KAT 14: gcd(4,16) = 4
    cki("gcd[2,3]", sp_query_gcd(tg, 2, 3), 4)

    // KAT 15: single element gcd(8) = 8
    cki("gcd[1,1]", sp_query_gcd(tg, 1, 1), 8)

    // xs3 = [6, 10, 15] -> gcd(6,10)=2, gcd(10,15)=5, gcd(6,10,15)=1
    let xs3 = []
    xs3.push(6)
    xs3.push(10)
    xs3.push(15)

    let tg2 = sp_build_gcd(xs3)

    // KAT 16: gcd(6,10) = 2
    cki("gcd2[0,1]", sp_query_gcd(tg2, 0, 1), 2)

    // KAT 17: gcd(10,15) = 5
    cki("gcd2[1,2]", sp_query_gcd(tg2, 1, 2), 5)

    // KAT 18: gcd(6,10,15) = 1
    cki("gcd2[0,2]", sp_query_gcd(tg2, 0, 2), 1)

    print("_sparsetable_test passed")
