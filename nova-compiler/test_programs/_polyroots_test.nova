import std/poly/polyroots

fn approx(a, b, tol) -> bool
    let diff = a - b
    if diff < 0.0
        diff = 0.0 - diff
    if diff <= tol
        return true
    return false

fn ckf(label, got, want, tol)
    if approx(got * 1.0, want * 1.0, tol) == false
        print("FAIL polyroots " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL polyroots " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    let tol = 0.001

    // KAT 1: pr_linear([−6, 2]) = 3.0   (2x - 6 = 0)
    let p1 = [0 - 6, 2]
    let r1 = pr_linear(p1)
    cki("linear_len", len(r1), 1)
    ckf("linear_root", r1[0] * 1.0, 3.0, tol)

    // KAT 2: pr_linear — degenerate (b=0)
    let p2 = [5, 0]
    let r2 = pr_linear(p2)
    cki("linear_degen_len", len(r2), 0)

    // KAT 3: pr_quadratic([6,-5,1]) = {2, 3}  (x^2 - 5x + 6 = 0)
    let p3 = [6, 0 - 5, 1]
    let r3 = pr_quadratic(p3)
    cki("quad_23_len", len(r3), 2)
    ckf("quad_23_r0", r3[0] * 1.0, 2.0, tol)
    ckf("quad_23_r1", r3[1] * 1.0, 3.0, tol)

    // KAT 4: pr_quadratic([-2,0,1]) = {-sqrt(2), sqrt(2)}
    let p4 = [0 - 2, 0, 1]
    let r4 = pr_quadratic(p4)
    cki("quad_sqrt2_len", len(r4), 2)
    ckf("quad_sqrt2_r0", r4[0] * 1.0, 0.0 - 1.41421, tol)
    ckf("quad_sqrt2_r1", r4[1] * 1.0, 1.41421, tol)

    // KAT 5: pr_quadratic([1,0,1]) = []  (x^2+1, complex roots)
    let p5 = [1, 0, 1]
    let r5 = pr_quadratic(p5)
    cki("quad_complex_len", len(r5), 0)

    // KAT 6: pr_discriminant_quadratic([6,-5,1]) = 25 - 24 = 1
    let disc6 = pr_discriminant_quadratic(p3)
    ckf("disc_23", disc6, 1.0, tol)

    // KAT 7: pr_bisection([-2,0,1], 0.0, 2.0, 0.00001) ≈ 1.41421
    let p7 = [0 - 2, 0, 1]
    let root7 = pr_bisection(p7, 0.0, 2.0, 0.00001)
    ckf("bisection_sqrt2", root7, 1.41421, tol)

    // KAT 8: pr_eval([6,-5,1], 2.0) = 6 - 10 + 4 = 0
    let ev8 = pr_eval(p3, 2.0)
    ckf("eval_at_root", ev8, 0.0, tol)

    // KAT 9: pr_eval([6,-5,1], 0.0) = 6
    let ev9 = pr_eval(p3, 0.0)
    ckf("eval_at_0", ev9, 6.0, tol)

    // KAT 10: pr_all_real([6,-5,1], 0.0, 5.0, 0.5, 0.00001) finds {2, 3}
    let p10 = [6, 0 - 5, 1]
    let roots10 = pr_all_real(p10, 0.0, 5.0, 0.5, 0.00001)
    cki("all_real_23_len", len(roots10), 2)
    ckf("all_real_23_r0", roots10[0] * 1.0, 2.0, tol)
    ckf("all_real_23_r1", roots10[1] * 1.0, 3.0, tol)

    // KAT 11: pr_count_sign_changes([6,-5,1], 0.0, 5.0, 0.5) = 2
    let sc11 = pr_count_sign_changes(p10, 0.0, 5.0, 0.5)
    cki("sign_changes_2", sc11, 2)

    // KAT 12: round-trip — pr_bisection near root 3
    let root12 = pr_bisection(p3, 2.5, 3.5, 0.00001)
    ckf("bisection_root3", root12, 3.0, tol)

    print("PASS _polyroots_test")
