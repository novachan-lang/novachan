// _phone_test.nova — KAT for std/validation/phone
import std/validation/phone

fn ckb(label: string, got: bool, expected: bool)
    if got != expected
        let gs = "false"
        if got
            gs = "true"
        let es = "false"
        if expected
            es = "true"
        print("FAIL " + label + ": got " + gs + " expected " + es)
        exit(1)

fn cks(label: string, got: string, expected: string)
    if got != expected
        print("FAIL " + label + ": got=" + got + " expected=" + expected)
        exit(1)

fn main()
    // --- vph_is_valid_e164 ---
    // Known-valid: US number with '+'
    ckb("e164_us_plus",   vph_is_valid_e164("+14155552671"),   true)
    // Known-valid: UK number with '+'
    ckb("e164_uk_plus",   vph_is_valid_e164("+442071838750"),  true)
    // Known-valid: without leading '+'
    ckb("e164_no_plus",   vph_is_valid_e164("14155552671"),    true)
    // Known-invalid: starts with '0' after '+'
    ckb("e164_zero",      vph_is_valid_e164("+0123"),          false)
    // Known-invalid: only 4 digits (< 8)
    ckb("e164_short",     vph_is_valid_e164("+1234"),          false)
    // Known-invalid: non-digit characters
    ckb("e164_alpha",     vph_is_valid_e164("abc"),            false)
    // Known-invalid: too long (16 digits)
    ckb("e164_long",      vph_is_valid_e164("+1234567890123456"), false)
    // Known-valid: exactly 8 digits (minimum)
    ckb("e164_min8",      vph_is_valid_e164("12345678"),       true)
    // Known-valid: exactly 15 digits (maximum)
    ckb("e164_max15",     vph_is_valid_e164("+123456789012345"), true)
    // Known-invalid: digits only but starts with 0
    ckb("e164_zero_noplus", vph_is_valid_e164("01234567"),     false)
    // Known-invalid: mixed alpha in number
    ckb("e164_mixed",     vph_is_valid_e164("+1415abc5552"),   false)

    // --- vph_normalize ---
    // Strip parens, spaces, dashes; no leading '+' in input so none in output
    cks("norm_parens",    vph_normalize("(415) 555-2671"),     "4155552671")
    // Plus is kept
    cks("norm_plus",      vph_normalize("+1 (415) 555-2671"),  "+14155552671")
    // Already clean
    cks("norm_clean",     vph_normalize("14155552671"),        "14155552671")
    // Only dashes
    cks("norm_dashes",    vph_normalize("415-555-2671"),       "4155552671")

    // --- vph_digits_only ---
    // All non-digit chars stripped including '+'
    cks("digits_plus",    vph_digits_only("+1 (415) 555-2671"), "14155552671")
    // Already digits
    cks("digits_clean",   vph_digits_only("14155552671"),       "14155552671")
    // Empty string
    cks("digits_empty",   vph_digits_only(""),                  "")
    // No digits at all
    cks("digits_none",    vph_digits_only("abc-def"),           "")

    // --- vph_country_code ---
    // NANP (US/Canada): code "1"
    cks("cc_us",     vph_country_code("+14155552671"),   "1")
    // UK: code "44"
    cks("cc_uk",     vph_country_code("+442071838750"),  "44")
    // India: code "91"
    cks("cc_india",  vph_country_code("+919876543210"),  "91")
    // China: code "86"
    cks("cc_china",  vph_country_code("+8613912345678"), "86")
    // Brazil: code "55"
    cks("cc_brazil", vph_country_code("+5511987654321"), "55")
    // Nigeria: code "234"
    cks("cc_nigeria",vph_country_code("+2348012345678"), "234")
    // No leading '+': returns ""
    cks("cc_noplus", vph_country_code("14155552671"),    "")
    // Unknown code: returns ""
    cks("cc_unknown",vph_country_code("+0001234567"),    "")

    print("_phone_test passed")
