import forge_minhash

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

// build string tokens for the integer range [lo, hi]
fn range_tokens(lo: int, hi: int) -> list
    let out = []
    let i = lo
    while i <= hi
        push(out, str(i))
        i = i + 1
    out

fn main()
    let fails = 0
    let N = 128

    // set A = 1..100, B = 50..150 (true Jaccard = 51/150 = 0.34), C = 200..300 (disjoint from A)
    let A = range_tokens(1, 100)
    let B = range_tokens(50, 150)
    let C = range_tokens(200, 300)

    let sigA = minhash_signature(A, N)
    let sigB = minhash_signature(B, N)
    let sigC = minhash_signature(C, N)

    // 1. signature length
    fails = fails + expect_true("siglen", len(sigA) == N)

    // 2. determinism: same set -> identical signature -> similarity exactly 1.0
    let sigA2 = minhash_signature(A, N)
    let selfsim = minhash_similarity(sigA, sigA2)
    fails = fails + expect_true("deterministic", selfsim >= 0.999)

    // 3. identical content, different list order + duplicates -> same signature (it's a SET)
    let Adup = range_tokens(1, 100)
    push(Adup, "50")
    push(Adup, "1")
    let sigAdup = minhash_signature(Adup, N)
    fails = fails + expect_true("set_semantics", minhash_similarity(sigA, sigAdup) >= 0.999)

    // 4. disjoint sets -> low similarity (< 0.12 with 128 hashes)
    let disj = minhash_similarity(sigA, sigC)
    fails = fails + expect_true("disjoint_low", disj < 0.12)

    // 5. known Jaccard 0.34 -> estimate within tolerance (0.19 .. 0.49)
    let est = minhash_similarity(sigA, sigB)
    print("  est(A,B)=" + str(est) + " (true 0.34)")
    fails = fails + expect_true("jaccard_est", est > 0.19 and est < 0.49)

    // 6. mismatched signature lengths -> 0.0
    let short = minhash_signature(A, 16)
    fails = fails + expect_true("mismatch_len", minhash_similarity(sigA, short) < 0.0001)

    // 7. convenience estimate matches the two-step path
    let conv = minhash_estimate(A, B, N)
    fails = fails + expect_true("convenience", conv > 0.19 and conv < 0.49)

    // 8. higher num_hashes -> estimate still in range (accuracy sanity)
    let est256 = minhash_estimate(A, B, 256)
    print("  est256(A,B)=" + str(est256))
    fails = fails + expect_true("est256", est256 > 0.22 and est256 < 0.46)

    if fails == 0
        print("forge_minhash: all passed")
    else
        print("forge_minhash: " + str(fails) + " FAILED")
