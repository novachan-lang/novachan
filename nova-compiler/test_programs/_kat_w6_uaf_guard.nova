// UAF probe: the dropped temp must never be one that is still reachable.
fn main()
    // (1) temp reused after concat — must NOT be dropped (2 uses)
    let n = 100000
    let t = str(n)
    let a = "x" + t
    print("reuse-after-concat: " + t + " / " + a)
    // (2) concat result stored and read later
    let c = "row-" + str(n)
    print("stored concat: " + c + " len=" + str(len(c)))
    // (3) nested concat chain
    let z = "a" + str(n) + "b" + str(n + 1)
    print("chain: " + z)
    // (4) concat feeding a container (retained)
    let xs = []
    let i = 100000
    while i < 100005
        xs.push("k" + str(i))
        i = i + 1
    print("container: " + str(xs))
    print("still alive: " + str(len(xs)))
