import std/rational/rfrac_compare

// ckr — assert rational equality element-wise
fn ckr(label: string, got: list, wn: int, wd: int)
    if got[0] != wn or got[1] != wd
        print("FAIL rfrac_compare " + label + ": got=" + str(got[0]) + "/" + str(got[1]) + " want=" + str(wn) + "/" + str(wd))
        exit(1)

// cki — assert integer equality
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL rfrac_compare " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// helper: build a rational [n, d] directly (caller ensures already reduced, den>0)
fn q(n: int, d: int) -> list
    let r = []
    push(r, n)
    push(r, d)
    r

// --- rfc_compare ---
// 1/2 > 1/3 => 1
cki("cmp_gt", rfc_compare(q(1, 2), q(1, 3)), 1)

// 1/3 < 1/2 => -1
cki("cmp_lt", rfc_compare(q(1, 3), q(1, 2)), 0 - 1)

// 2/4 == 1/2 => 0  (equivalent fractions)
cki("cmp_eq", rfc_compare(q(2, 4), q(1, 2)), 0)

// -1/3 < 1/4
cki("cmp_neg", rfc_compare(q(0 - 1, 3), q(1, 4)), 0 - 1)

// 0 < 1/1000
cki("cmp_zero_pos", rfc_compare(q(0, 1), q(1, 1000)), 0 - 1)

// -5/6 < -1/6
cki("cmp_both_neg", rfc_compare(q(0 - 5, 6), q(0 - 1, 6)), 0 - 1)

// --- rfc_equals ---
cki("eq_true", rfc_equals(q(2, 4), q(1, 2)), 1)
cki("eq_false", rfc_equals(q(1, 3), q(1, 2)), 0)
cki("eq_zero", rfc_equals(q(0, 1), q(0, 3)), 1)

// --- rfc_lt ---
cki("lt_true", rfc_lt(q(1, 3), q(1, 2)), 1)
cki("lt_false_eq", rfc_lt(q(1, 2), q(1, 2)), 0)
cki("lt_false_gt", rfc_lt(q(3, 4), q(1, 4)), 0)

// --- rfc_lte ---
cki("lte_lt", rfc_lte(q(1, 4), q(1, 2)), 1)
cki("lte_eq", rfc_lte(q(1, 2), q(1, 2)), 1)
cki("lte_false", rfc_lte(q(3, 4), q(1, 4)), 0)

// --- rfc_gt ---
cki("gt_true", rfc_gt(q(1, 2), q(1, 3)), 1)
cki("gt_false_eq", rfc_gt(q(1, 2), q(1, 2)), 0)
cki("gt_false_lt", rfc_gt(q(1, 4), q(3, 4)), 0)

// --- rfc_gte ---
cki("gte_gt", rfc_gte(q(3, 4), q(1, 4)), 1)
cki("gte_eq", rfc_gte(q(1, 2), q(1, 2)), 1)
cki("gte_false", rfc_gte(q(1, 4), q(3, 4)), 0)

// --- rfc_min ---
let mn1 = rfc_min(q(1, 2), q(1, 3))
ckr("min_1_2__1_3", mn1, 1, 3)

let mn2 = rfc_min(q(0 - 1, 2), q(1, 4))
ckr("min_neg", mn2, 0 - 1, 2)

let mn3 = rfc_min(q(1, 2), q(1, 2))
ckr("min_equal", mn3, 1, 2)

// --- rfc_max ---
let mx1 = rfc_max(q(0 - 1, 2), q(1, 4))
ckr("max_neg__pos", mx1, 1, 4)

let mx2 = rfc_max(q(3, 5), q(4, 7))
ckr("max_3_5__4_7", mx2, 3, 5)

let mx3 = rfc_max(q(1, 2), q(1, 2))
ckr("max_equal", mx3, 1, 2)

// --- rfc_clamp ---
// 2/1 clamped to [0/1, 1/1] -> 1/1
let cl1 = rfc_clamp(q(2, 1), q(0, 1), q(1, 1))
ckr("clamp_above", cl1, 1, 1)

// -1/1 clamped to [0/1, 1/1] -> 0/1
let cl2 = rfc_clamp(q(0 - 1, 1), q(0, 1), q(1, 1))
ckr("clamp_below", cl2, 0, 1)

// 1/2 clamped to [0/1, 1/1] -> 1/2 (within range)
let cl3 = rfc_clamp(q(1, 2), q(0, 1), q(1, 1))
ckr("clamp_within", cl3, 1, 2)

// clamp exactly at boundary lo
let cl4 = rfc_clamp(q(0, 1), q(0, 1), q(1, 1))
ckr("clamp_at_lo", cl4, 0, 1)

// clamp exactly at boundary hi
let cl5 = rfc_clamp(q(1, 1), q(0, 1), q(1, 1))
ckr("clamp_at_hi", cl5, 1, 1)

// negative range: -3/4 clamped to [-1/2, 0/1] -> -1/2
let cl6 = rfc_clamp(q(0 - 3, 4), q(0 - 1, 2), q(0, 1))
ckr("clamp_neg_range", cl6, 0 - 1, 2)

print("PASS _rfrac_compare_test")
