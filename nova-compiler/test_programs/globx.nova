// globx.nova — shell-style glob / fnmatch pattern matching, the NOVA way.
//
// Globs (*?[...]) are the standard for file-name matching — distinct from regex
// (no backtracking blowup, no anchors). glob_match uses the classic linear
// star-backtracking algorithm over codepoints, with character classes:
//   *        any run of chars (incl. empty)
//   ?        any single char
//   [abc]    one of a set      [a-z] range      [!set]/[^set] negation
//
// Operates on code_points so it is codepoint-correct, not byte-wise.

// match codepoint `ch` against a class starting at pat[pstart]=='[' .
// returns [matched(0/1), index just past the closing ']'].
fn _glob_class(pat, pstart, ch)
  let i = pstart + 1
  let neg = 0
  if i < len(pat) and (pat[i] == 33 or pat[i] == 94)
    neg = 1
    i = i + 1
  let matched = 0
  let first = 1
  while i < len(pat) and (pat[i] != 93 or first == 1)
    first = 0
    if i + 2 < len(pat) and pat[i + 1] == 45 and pat[i + 2] != 93
      // range  a-z
      if ch >= pat[i] and ch <= pat[i + 2]
        matched = 1
      i = i + 3
    else
      if ch == pat[i]
        matched = 1
      i = i + 1
  if i < len(pat) and pat[i] == 93
    i = i + 1
  let res = matched
  if neg == 1
    res = 1 - matched
  [res, i]

fn glob_match(pattern, text)
  let pat = code_points(pattern)
  let txt = code_points(text)
  let p = 0
  let t = 0
  let star_p = 0 - 1
  let star_t = 0 - 1
  while t < len(txt)
    let matched_here = 0
    let next_p = p
    if p < len(pat)
      if pat[p] == 42
        // '*' : record a backtrack point and consume it
        star_p = p
        star_t = t
        p = p + 1
        matched_here = 2          // sentinel: handled, continue loop
      else if pat[p] == 91
        let cr = _glob_class(pat, p, txt[t])
        if cr[0] == 1
          matched_here = 1
          next_p = cr[1]
      else if pat[p] == 63 or pat[p] == txt[t]
        matched_here = 1
        next_p = p + 1
    if matched_here == 1
      p = next_p
      t = t + 1
    else if matched_here == 2
      t = t            // star handled above; just continue
    else if star_p >= 0
      p = star_p + 1
      star_t = star_t + 1
      t = star_t
    else
      return 0
  // consume trailing '*'
  while p < len(pat) and pat[p] == 42
    p = p + 1
  if p == len(pat)
    return 1
  0

// ── Tests ────────────────────────────────────────────────────────────

assert(glob_match("*.txt", "file.txt") == 1, "*.txt matches file.txt")
assert(glob_match("*.txt", "file.dat") == 0, "*.txt does not match file.dat")
assert(glob_match("*.txt", ".txt") == 1, "* matches empty")
print("PASS: star + suffix")

assert(glob_match("f?o", "foo") == 1, "f?o matches foo")
assert(glob_match("f?o", "fao") == 1, "f?o matches fao")
assert(glob_match("f?o", "fo") == 0, "f?o needs 3 chars")
print("PASS: question mark")

assert(glob_match("[abc]x", "ax") == 1, "[abc]x matches ax")
assert(glob_match("[abc]x", "dx") == 0, "[abc]x rejects dx")
assert(glob_match("[a-z]*", "hello") == 1, "[a-z]* matches hello")
assert(glob_match("[a-z]*", "Hello") == 0, "[a-z]* rejects uppercase start")
print("PASS: character classes + ranges")

assert(glob_match("[!0-9]*", "abc") == 1, "[!0-9]* matches non-digit start")
assert(glob_match("[!0-9]*", "1bc") == 0, "[!0-9]* rejects digit start")
assert(glob_match("[^x]", "y") == 1, "[^x] matches y")
assert(glob_match("[^x]", "x") == 0, "[^x] rejects x")
print("PASS: negated classes")

assert(glob_match("a*b*c", "axxbyyc") == 1, "multi-star")
assert(glob_match("a*b*c", "axxbyy") == 0, "multi-star needs trailing c")
assert(glob_match("*", "anything") == 1, "lone star matches all")
assert(glob_match("", "") == 1, "empty matches empty")
assert(glob_match("", "x") == 0, "empty pattern rejects non-empty")
assert(glob_match("src/*.nova", "src/main.nova") == 1, "path-ish glob")
print("PASS: multi-star + edges")

print("ALL PASS: globx — shell-style glob matching")
