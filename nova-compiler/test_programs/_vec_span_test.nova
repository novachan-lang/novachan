import std/vector/vec_span

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn main()
    // KAT 1: vs_rank([[1,0],[0,1]]) = 2
    let v1a = [1, 0]
    let v1b = [0, 1]
    let vs1 = [v1a, v1b]
    cki("rank_std_basis_2d", vs_rank(vs1), 2)

    // KAT 2: vs_rank([[1,2],[2,4]]) = 1 (second row is 2x first)
    let v2a = [1, 2]
    let v2b = [2, 4]
    let vs2 = [v2a, v2b]
    cki("rank_dependent_2d", vs_rank(vs2), 1)

    // KAT 3: vs_are_dependent([[1,2],[2,4]]) = true
    ckb("dependent_1_2_double", vs_are_dependent(vs2), true)

    // KAT 4: vs_are_dependent([[1,0],[0,1]]) = false
    ckb("independent_std_basis", vs_are_dependent(vs1), false)

    // KAT 5: vs_rank([[1,0],[0,1],[1,1]]) = 2
    let v5a = [1, 0]
    let v5b = [0, 1]
    let v5c = [1, 1]
    let vs5 = [v5a, v5b, v5c]
    cki("rank_3vecs_2d", vs_rank(vs5), 2)

    // KAT 6: vs_is_basis([[1,0],[0,1]],2) = true
    ckb("is_basis_std_2d", vs_is_basis(vs1, 2), true)

    // KAT 7: vs_is_basis([[1,2],[2,4]],2) = false (rank < dim)
    ckb("is_basis_dependent_2d", vs_is_basis(vs2, 2), false)

    // KAT 8: vs_rank([[1,0,0],[0,1,0],[0,0,1]]) = 3 (standard 3D basis)
    let v8a = [1, 0, 0]
    let v8b = [0, 1, 0]
    let v8c = [0, 0, 1]
    let vs8 = [v8a, v8b, v8c]
    cki("rank_std_basis_3d", vs_rank(vs8), 3)

    // KAT 9: vs_rank([[1,1],[1,1]]) = 1 (identical rows)
    let v9a = [1, 1]
    let v9b = [1, 1]
    let vs9 = [v9a, v9b]
    cki("rank_identical_rows", vs_rank(vs9), 1)

    // KAT 10: vs_are_dependent([[1,0,0],[0,1,0],[1,1,0]]) = true (sum of first two)
    let v10a = [1, 0, 0]
    let v10b = [0, 1, 0]
    let v10c = [1, 1, 0]
    let vs10 = [v10a, v10b, v10c]
    ckb("dependent_sum_3d", vs_are_dependent(vs10), true)

    // KAT 11: vs_is_basis([[1,0,0],[0,1,0],[0,0,1]],3) = true
    ckb("is_basis_std_3d", vs_is_basis(vs8, 3), true)

    // KAT 12: vs_is_basis([[1,0],[0,1],[1,1]],2) = false (3 vectors for dim 2)
    ckb("is_basis_too_many", vs_is_basis(vs5, 2), false)

    // KAT 13: single zero vector has rank 0
    let v13 = [0, 0, 0]
    let vs13 = [v13]
    cki("rank_zero_vec", vs_rank(vs13), 0)

    // KAT 14: single nonzero vector has rank 1
    let v14 = [3, 0, 0]
    let vs14 = [v14]
    cki("rank_single_nonzero", vs_rank(vs14), 1)

    print("PASS _vec_span_test")
