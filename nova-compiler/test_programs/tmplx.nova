// tmplx.nova — a minimal {{mustache}}-style string templating engine.
//
// Substitutes {{key}} placeholders in a template with values from a dict — the
// core of HTML rendering, email/notification generation, config templating, and
// code generation. Whitespace around the key is trimmed; unknown keys render
// empty. Pure-NOVA over codepoints. ('{' = 123, '}' = 125.)

fn template_render(tmpl, vars)
  let cps = code_points(tmpl)
  let n = len(cps)
  let out = ""
  let i = 0
  while i < n
    if i + 1 < n and cps[i] == 123 and cps[i + 1] == 123
      // {{ ... }} — read the key up to the closing }}
      let j = i + 2
      let key = ""
      while j + 1 < n and not (cps[j] == 125 and cps[j + 1] == 125)
        key = key + from_codepoint(cps[j])
        j = j + 1
      let k = trim(key)
      if contains(vars, k)
        out = out + str(vars[k])
      i = j + 2                       // skip past the closing }}
    else
      out = out + from_codepoint(cps[i])
      i = i + 1
  out

// build "{{inner}}" reliably (avoids source brace-escaping in tests)
fn _ph(inner)
  from_codepoint(123) + from_codepoint(123) + inner + from_codepoint(125) + from_codepoint(125)

// ── Tests ────────────────────────────────────────────────────────────

let vars = {}
vars["name"] = "World"
vars["count"] = 3

let t1 = "Hello " + _ph("name") + "!"
assert(template_render(t1, vars) == "Hello World!", "single substitution")
print("PASS: single var")

let t2 = _ph("name") + " has " + _ph("count") + " items"
assert(template_render(t2, vars) == "World has 3 items", "multiple vars + int value")
print("PASS: multiple vars")

// whitespace inside the braces is trimmed
let t3 = "Hi " + _ph("  name  ") + "."
assert(template_render(t3, vars) == "Hi World.", "trimmed key")
print("PASS: trimmed key")

// unknown key renders empty
let t4 = "x" + _ph("missing") + "y"
assert(template_render(t4, vars) == "xy", "unknown key -> empty")
print("PASS: unknown key")

// no placeholders -> passthrough
assert(template_render("plain text", vars) == "plain text", "no placeholders")
// repeated placeholder
let t5 = _ph("name") + " " + _ph("name")
assert(template_render(t5, vars) == "World World", "repeated placeholder")
print("PASS: passthrough + repeats")

print("ALL PASS: tmplx — mustache-style templating")
