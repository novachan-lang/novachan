import std/text/roman

// Known-answer assertions
fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // from_int KAT
    cks("from_int(4)",    rom_from_int(4),    "IV")
    cks("from_int(9)",    rom_from_int(9),    "IX")
    cks("from_int(40)",   rom_from_int(40),   "XL")
    cks("from_int(1994)", rom_from_int(1994), "MCMXCIV")
    cks("from_int(3888)", rom_from_int(3888), "MMMDCCCLXXXVIII")

    // to_int KAT
    cki("to_int(IX)",      rom_to_int("IX"),      9)
    cki("to_int(MCMXCIV)", rom_to_int("MCMXCIV"), 1994)
    cki("to_int(XLII)",    rom_to_int("XLII"),    42)

    // round-trip
    cks("roundtrip(MMXXIV)", rom_from_int(rom_to_int("MMXXIV")), "MMXXIV")

    print("_roman_test passed")
