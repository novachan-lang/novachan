import forge_permission_manager

fn main()
    let p = pm_new()
    p = pm_add_role(p, "admin")
    p = pm_add_role(p, "viewer")
    assert(pm_role_count(p) == 2, "2 roles")

    let g1 = pm_grant_permission(p, "admin", "read")
    assert(is_ok(g1), "grant read ok")
    p = unwrap(g1)
    let g2 = pm_grant_permission(p, "admin", "write")
    assert(is_ok(g2), "grant write ok")
    p = unwrap(g2)
    let g3 = pm_grant_permission(p, "viewer", "read")
    assert(is_ok(g3), "grant viewer read")
    p = unwrap(g3)

    let a1 = pm_assign_role(p, "alice", "admin")
    assert(is_ok(a1), "assign alice")
    p = unwrap(a1)
    let a2 = pm_assign_role(p, "bob", "viewer")
    assert(is_ok(a2), "assign bob")
    p = unwrap(a2)

    assert(pm_check(p, "alice", "write") == 1, "alice can write")
    assert(pm_check(p, "bob", "write") == 0, "bob cant write")
    assert(pm_check(p, "bob", "read") == 1, "bob can read")
    assert(pm_check(p, "charlie", "read") == 0, "charlie no role")

    let r = pm_user_role(p, "alice")
    assert(is_ok(r), "role ok")
    assert(unwrap(r) == "admin", "alice is admin")

    let bad = pm_grant_permission(p, "nope", "x")
    assert(is_err(bad), "unknown role")

    print("PERMISSION-MANAGER KAT PASS")
