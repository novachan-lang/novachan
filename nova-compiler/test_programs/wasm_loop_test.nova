// Real WASM control-flow oracle. loop.wasm is a hand-crafted module:
//   (func (result i32) (local i32 i32)   ;; local0=i, local1=acc
//     i32.const 0 local.set 1   i32.const 1 local.set 0
//     (loop  local.get 1 local.get 0 i32.add local.set 1
//            local.get 0 i32.const 1 i32.add local.set 0
//            local.get 0 i32.const 11 i32.lt_s br_if 0)
//     local.get 1)
// Sums 1..10. Oracle: must return 55 — only possible with real locals + loop + br_if.
fn main()
    let m = wasm_compile("loop.wasm")
    assert_eq(m >= 0, true)
    let r = wasm_run(m)
    print("wasm loop sum(1..10) = {r}")
    assert_eq(r, 55)
    wasm_free(m)
    print("WASM control-flow test passed: loop summed 1..10 = 55")
