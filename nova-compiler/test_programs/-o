@.str.3418 = private unnamed_addr constant [2087 x i8] c"\0D\0A    // A NOVA REST API built with Forge. Handlers return a domain value -- a struct, a list, or a\0D\0A    // Response -- and Forge produces the right JSON automatically (\22return your type\22). Run with\0D\0A    // --check to dispatch one request through the full pipeline (no socket) for CI/containers.\0D\0A    import forge\0D\0A\0D\0A    type Todo\0D\0A        id: int\0D\0A        title: string\0D\0A        done: bool\0D\0A\0D\0A    type Health\0D\0A        status: string\0D\0A        service: string\0D\0A\0D\0A    fn seed() -> list\0D\0A        [Todo(1, \22Learn NOVA\22, true), Todo(2, \22Build with Forge\22, false)]\0D\0A\0D\0A    fn health(req: Request) -> Health\0D\0A        Health(\22ok\22, \22api\22)\0D\0A\0D\0A    fn list_todos(req: Request) -> list\0D\0A        seed()\0D\0A\0D\0A    fn get_todo(req: Request) -> Response\0D\0A        let id = req.params[\22id\22]\0D\0A        for t in seed()\0D\0A            if str(t.id) == id\0D\0A                return forge.resp_json(200, t)\0D\0A        forge.resp_json(404, Health(\22not found\22, \22api\22))\0D\0A\0D\0A    // POST a JSON body -> a typed Todo, rebuilt by field name -> 201. Inbound \22return your type\22.\0D\0A    fn create_todo(req: Request) -> Response\0D\0A        let t: Todo = from_json(req.body)\0D\0A        forge.resp_json(201, t)\0D\0A\0D\0A    fn build_app()\0D\0A        let a = forge.app()\0D\0A        forge.use(a, forge.mw_log())\0D\0A        forge.use(a, forge.mw_cors_origin(\22*\22))\0D\0A        forge.get(a, \22/health\22, health)\0D\0A        forge.get(a, \22/todos\22, list_todos)\0D\0A        forge.get(a, \22/todos/:id\22, get_todo)\0D\0A        forge.post(a, \22/todos\22, create_todo)\0D\0A        a\0D\0A\0D\0A    fn _port() -> int\0D\0A        let pe = env(\22PORT\22)\0D\0A        if len(pe) > 0\0D\0A            return parse_int(pe)\0D\0A        8080\0D\0A\0D\0A    fn main()\0D\0A        let a = build_app()\0D\0A        let av = args()\0D\0A        if len(av) > 1 and av[1] == \22--check\22\0D\0A            let r: Response = forge.dispatch_req(a, forge.build_request(\22GET /health HTTP/1.1\\r\\n\\r\\n\22, 0))\0D\0A            print(\22selfcheck status=\22 + str(r.status))\0D\0A            if r.status >= 400\0D\0A                exit(1)\0D\0A            return\0D\0A        let p = _port()\0D\0A        print(\22api listening on http://localhost:\22 + str(p))\0D\0A        forge.serve_req(a, p)\0D\00"
@.str.3419 = private unnamed_addr constant [1336 x i8] c"\0D\0A    // A minimal NOVA microservice. Each request is handled in a MONITORED process: a handler\0D\0A    // panic becomes a 500 and the server lives on (\22let it crash\22, at native AOT speed).\0D\0A    import forge\0D\0A\0D\0A    type Status\0D\0A        status: string\0D\0A\0D\0A    type Echo\0D\0A        echo: string\0D\0A\0D\0A    fn health(req: Request) -> Status\0D\0A        Status(\22ok\22)\0D\0A\0D\0A    fn ready(req: Request) -> Status\0D\0A        Status(\22ready\22)\0D\0A\0D\0A    fn echo(req: Request) -> Echo\0D\0A        Echo(req.body)\0D\0A\0D\0A    fn build_app()\0D\0A        let a = forge.app()\0D\0A        forge.use(a, forge.mw_log())\0D\0A        forge.get(a, \22/health\22, health)\0D\0A        forge.get(a, \22/ready\22, ready)\0D\0A        forge.post(a, \22/echo\22, echo)\0D\0A        a\0D\0A\0D\0A    fn _port() -> int\0D\0A        let pe = env(\22PORT\22)\0D\0A        if len(pe) > 0\0D\0A            return parse_int(pe)\0D\0A        8081\0D\0A\0D\0A    fn main()\0D\0A        let a = build_app()\0D\0A        let av = args()\0D\0A        if len(av) > 1 and av[1] == \22--check\22\0D\0A            let r: Response = forge.dispatch_req(a, forge.build_request(\22GET /health HTTP/1.1\\r\\n\\r\\n\22, 0))\0D\0A            print(\22selfcheck status=\22 + str(r.status))\0D\0A            if r.status >= 400\0D\0A                exit(1)\0D\0A            return\0D\0A        let p = _port()\0D\0A        print(\22microservice listening on http://localhost:\22 + str(p) + \22 (crash-isolated)\22)\0D\0A        forge.serve_safe_req(a, p)\0D\00"
@.str.3420 = private unnamed_addr constant [880 x i8] c"\0D\0A    // A NOVA static frontend. Assets in public/ are served traversal-safe (no .., no dotfiles,\0D\0A    // no path can escape the mount). One binary serves your SPA.\0D\0A    import forge\0D\0A\0D\0A    fn build_app()\0D\0A        let a = forge.app()\0D\0A        forge.static(a, \22/\22, \22public\22)\0D\0A        a\0D\0A\0D\0A    fn _port() -> int\0D\0A        let pe = env(\22PORT\22)\0D\0A        if len(pe) > 0\0D\0A            return parse_int(pe)\0D\0A        8080\0D\0A\0D\0A    fn main()\0D\0A        let a = build_app()\0D\0A        let av = args()\0D\0A        if len(av) > 1 and av[1] == \22--check\22\0D\0A            let r: Response = forge.dispatch_req(a, forge.build_request(\22GET / HTTP/1.1\\r\\n\\r\\n\22, 0))\0D\0A            print(\22selfcheck status=\22 + str(r.status))\0D\0A            if r.status >= 400\0D\0A                exit(1)\0D\0A            return\0D\0A        let p = _port()\0D\0A        print(\22frontend on http://localhost:\22 + str(p))\0D\0A        forge.serve_req(a, p)\0D\00"
@.str.3421 = private unnamed_addr constant [1535 x i8] c"\0D\0A    // A NOVA full-stack app: a JSON API under /api AND a static frontend, in ONE binary, one\0D\0A    // run. Backend + frontend, one language, no glue -- the NOVA identity use case.\0D\0A    import forge\0D\0A\0D\0A    type Todo\0D\0A        id: int\0D\0A        title: string\0D\0A        done: bool\0D\0A\0D\0A    type Health\0D\0A        status: string\0D\0A\0D\0A    fn seed() -> list\0D\0A        [Todo(1, \22Learn NOVA\22, true), Todo(2, \22Ship with Forge\22, false)]\0D\0A\0D\0A    fn api_todos(req: Request) -> list\0D\0A        seed()\0D\0A\0D\0A    fn api_health(req: Request) -> Health\0D\0A        Health(\22ok\22)\0D\0A\0D\0A    fn build_app()\0D\0A        let a = forge.app()\0D\0A        forge.use(a, forge.mw_log())\0D\0A        let api = forge.group(a, \22/api\22)\0D\0A        forge.get(api, \22/todos\22, api_todos)\0D\0A        forge.get(api, \22/health\22, api_health)\0D\0A        // Explicit /api routes win; everything else is served from public/.\0D\0A        forge.static(a, \22/\22, \22public\22)\0D\0A        a\0D\0A\0D\0A    fn _port() -> int\0D\0A        let pe = env(\22PORT\22)\0D\0A        if len(pe) > 0\0D\0A            return parse_int(pe)\0D\0A        8080\0D\0A\0D\0A    fn main()\0D\0A        let a = build_app()\0D\0A        let av = args()\0D\0A        if len(av) > 1 and av[1] == \22--check\22\0D\0A            let r: Response = forge.dispatch_req(a, forge.build_request(\22GET /api/todos HTTP/1.1\\r\\n\\r\\n\22, 0))\0D\0A            print(\22selfcheck status=\22 + str(r.status))\0D\0A            if r.status >= 400\0D\0A                exit(1)\0D\0A            return\0D\0A        let p = _port()\0D\0A        print(\22fullstack on http://localhost:\22 + str(p) + \22 (API at /api, frontend at /)\22)\0D\0A        forge.serve_req(a, p)\0D\00"
