import forge_wordsearch

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // classic LeetCode grid
    let grid = ["ABCE", "SFCS", "ADEE"]

    fails = fails + expect("abcced", str(word_search(grid, "ABCCED")), "true")
    fails = fails + expect("see", str(word_search(grid, "SEE")), "true")
    fails = fails + expect("abcb", str(word_search(grid, "ABCB")), "false")
    fails = fails + expect("single", str(word_search(grid, "A")), "true")
    fails = fails + expect("absent_letter", str(word_search(grid, "Z")), "false")
    fails = fails + expect("absent_word", str(word_search(grid, "ABCX")), "false")

    // a path that turns corners
    let g2 = ["ABCE", "SFES", "ADEE"]
    fails = fails + expect("turn", str(word_search(g2, "ABCESEEEFS")), "true")

    // word longer than grid cells -> false
    fails = fails + expect("too_long", str(word_search(["AB", "CD"], "ABCDA")), "false")

    // single-row grid
    fails = fails + expect("row_yes", str(word_search(["HELLO"], "ELL")), "true")
    fails = fails + expect("row_no", str(word_search(["HELLO"], "HLL")), "false")

    // must not reuse a cell
    fails = fails + expect("no_reuse", str(word_search(["AA"], "AAA")), "false")

    if fails == 0
        print("forge_wordsearch: all passed")
    else
        print("forge_wordsearch: " + str(fails) + " FAILED")
