import std/game2d/aabb_collide

// ckb — check boolean equality; exit(1) on mismatch.
fn ckb(label: string, got: bool, want: bool)
    let goti = 0
    if got
        goti = 1
    let wanti = 0
    if want
        wanti = 1
    if goti != wanti
        print("FAIL aabb_collide " + label + ": got=" + str(goti) + " want=" + str(wanti))
        exit(1)

// cki — check integer equality; exit(1) on mismatch.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL aabb_collide " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckf — check float with tolerance; exit(1) on mismatch.
fn ckf(label: string, got: float, want: float)
    let tol = 0.0001
    let hi = want + tol
    let lo = want - tol
    if got > hi
        print("FAIL aabb_collide " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)
    if got < lo
        print("FAIL aabb_collide " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// cklist2i — check a 2-element list of ints [a,b].
fn cklist2i(label: string, got: list, wa: int, wb: int)
    cki(label + "[0]", got[0], wa)
    cki(label + "[1]", got[1], wb)

// cklist4i — check a 4-element list of ints [a,b,c,d].
fn cklist4i(label: string, got: list, wa: int, wb: int, wc: int, wd: int)
    cki(label + "[0]", got[0], wa)
    cki(label + "[1]", got[1], wb)
    cki(label + "[2]", got[2], wc)
    cki(label + "[3]", got[3], wd)

fn main()
    // ---- ab_overlap ----
    // overlapping boxes
    let a1 = [0, 0, 2, 2]
    let b1 = [1, 1, 2, 2]
    ckb("overlap_true", ab_overlap(a1, b1), true)

    // disjoint boxes (gap between them)
    let a2 = [0, 0, 1, 1]
    let b2 = [2, 2, 1, 1]
    ckb("overlap_false", ab_overlap(a2, b2), false)

    // touching edge counts as overlap (right edge of a == left edge of b)
    let a3 = [0, 0, 2, 2]
    let b3 = [2, 0, 2, 2]
    ckb("overlap_touching_edge", ab_overlap(a3, b3), true)

    // disjoint: far apart horizontally
    let a4 = [0, 0, 1, 1]
    let b4 = [5, 0, 1, 1]
    ckb("overlap_far_apart", ab_overlap(a4, b4), false)

    // ---- ab_contains_point ----
    // interior point
    let box1 = [0, 0, 4, 4]
    ckb("contains_point_interior", ab_contains_point(box1, 2, 2), true)
    // exterior point
    ckb("contains_point_exterior", ab_contains_point(box1, 5, 2), false)
    // on the left edge
    ckb("contains_point_left_edge", ab_contains_point(box1, 0, 2), true)
    // on the right edge (x==4)
    ckb("contains_point_right_edge", ab_contains_point(box1, 4, 2), true)
    // just outside right edge
    ckb("contains_point_just_outside", ab_contains_point(box1, 5, 2), false)

    // ---- ab_contains_box ----
    let outer = [0, 0, 10, 10]
    let inner = [2, 2, 3, 3]
    ckb("contains_box_true", ab_contains_box(outer, inner), true)
    // partially overlapping (not fully contained)
    let partial = [8, 8, 5, 5]
    ckb("contains_box_partial_false", ab_contains_box(outer, partial), false)

    // ---- ab_intersection ----
    // standard overlap: [0,0,3,3] ^ [2,2,3,3] = [2,2,1,1]
    let ia = [0, 0, 3, 3]
    let ib = [2, 2, 3, 3]
    let ix = ab_intersection(ia, ib)
    cklist4i("intersection_standard", ix, 2, 2, 1, 1)

    // disjoint: empty list returned
    let ic = [0, 0, 1, 1]
    let id = [5, 5, 1, 1]
    let ix2 = ab_intersection(ic, id)
    cki("intersection_disjoint_len", len(ix2), 0)

    // ---- ab_mtv ----
    // a=[0,0,2,2], b=[1,0,2,2]:
    //   x overlap on +x side: a.right(2) - b.left(1) = 1
    //   x overlap on -x side: b.right(3) - a.left(0) = 3  -> pick smaller = 1, push A left -> mx=-1
    //   y overlap: a.bot(2) - b.top(0) = 2, b.bot(2) - a.top(0) = 2 -> py=2
    //   px(1) < py(2) -> MTV on x; A center(1) < B center(2) so push A left -> mx=-1
    let ma = [0, 0, 2, 2]
    let mb = [1, 0, 2, 2]
    let mtv1 = ab_mtv(ma, mb)
    cki("mtv_x_smaller_mx", mtv1[0], -1)
    cki("mtv_x_smaller_my", mtv1[1], 0)

    // disjoint -> [0,0]
    let mc = [0, 0, 1, 1]
    let md = [5, 5, 1, 1]
    let mtv2 = ab_mtv(mc, md)
    cki("mtv_disjoint_x", mtv2[0], 0)
    cki("mtv_disjoint_y", mtv2[1], 0)

    // ---- ab_overlap_area ----
    // [0,0,4,4] ^ [2,2,4,4] -> overlap [2,2,2,2] -> area=4.0
    let oa = [0, 0, 4, 4]
    let ob = [2, 2, 4, 4]
    let area = ab_overlap_area(oa, ob)
    ckf("overlap_area_4x4", area, 4.0)
    // disjoint -> 0.0
    let area2 = ab_overlap_area([0, 0, 1, 1], [5, 5, 1, 1])
    ckf("overlap_area_disjoint", area2, 0.0)

    // ---- ab_center ----
    // [0,0,4,2] -> center = [2.0, 1.0]
    let cbox = [0, 0, 4, 2]
    let ctr = ab_center(cbox)
    ckf("center_x", ctr[0], 2.0)
    ckf("center_y", ctr[1], 1.0)

    // ---- ab_min_max ----
    let mm = ab_min_max([3, 5, 4, 6])
    cki("min_max_minx", mm[0], 3)
    cki("min_max_miny", mm[1], 5)
    cki("min_max_maxx", mm[2], 7)
    cki("min_max_maxy", mm[3], 11)

    // ---- ab_expand ----
    let ex = ab_expand([2, 3, 4, 5], 1)
    cki("expand_x", ex[0], 1)
    cki("expand_y", ex[1], 2)
    cki("expand_w", ex[2], 6)
    cki("expand_h", ex[3], 7)

    // ---- ab_from_min_max ----
    let fm = ab_from_min_max(1, 2, 5, 8)
    cki("from_min_max_x", fm[0], 1)
    cki("from_min_max_y", fm[1], 2)
    cki("from_min_max_w", fm[2], 4)
    cki("from_min_max_h", fm[3], 6)

    print("PASS _aabb_collide_test")
