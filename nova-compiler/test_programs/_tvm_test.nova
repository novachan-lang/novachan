// KAT for std/finance/tvm — Time Value of Money
// All float comparisons use ckf with epsilon 0.01 (monetary precision).
import std/finance/tvm

fn ckf(label: string, got: float, want: float)
    let d = got - want
    if d < 0.0
        d = 0.0 - d
    if d > 0.01
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // KAT 1: tvm_fv(1000.0, 0.05, 10) == 1628.89
    // 1000 * 1.05^10 = 1000 * 1.6288946... = 1628.89
    let fv1 = tvm_fv(1000.0, 0.05, 10)
    ckf("tvm_fv basic", fv1, 1628.89)

    // KAT 2: tvm_pv(1628.89, 0.05, 10) == 1000.0
    // 1628.89 / 1.05^10 = 1000.0 (inverse of fv)
    let pv1 = tvm_pv(1628.89, 0.05, 10)
    ckf("tvm_pv basic", pv1, 1000.0)

    // KAT 3: tvm_fv_annuity(100.0, 0.05, 10) == 1257.79
    // 100 * ((1.05^10 - 1) / 0.05) = 100 * 12.5779 = 1257.79
    let fva1 = tvm_fv_annuity(100.0, 0.05, 10)
    ckf("tvm_fv_annuity basic", fva1, 1257.79)

    // KAT 4: tvm_pv_annuity(100.0, 0.05, 10) == 772.17
    // 100 * (1 - 1.05^-10) / 0.05 = 100 * 7.7217 = 772.17
    let pva1 = tvm_pv_annuity(100.0, 0.05, 10)
    ckf("tvm_pv_annuity basic", pva1, 772.17)

    // KAT 5: tvm_pmt(10000.0, 0.005, 60) == 193.33
    // monthly payment: 10000 * 0.005 / (1 - 1.005^-60) = 50 / 0.25861... = 193.33
    let pmt1 = tvm_pmt(10000.0, 0.005, 60)
    ckf("tvm_pmt loan", pmt1, 193.33)

    // KAT 6: tvm_fv(1000.0, 0.0, 5) == 1000.0 — zero-rate edge case
    let fv0 = tvm_fv(1000.0, 0.0, 5)
    ckf("tvm_fv zero-rate", fv0, 1000.0)

    // KAT 7: tvm_fv_annuity zero-rate: 100 * 5 = 500.0
    let fva0 = tvm_fv_annuity(100.0, 0.0, 5)
    ckf("tvm_fv_annuity zero-rate", fva0, 500.0)

    // KAT 8: tvm_pv_annuity zero-rate: 100 * 5 = 500.0
    let pva0 = tvm_pv_annuity(100.0, 0.0, 5)
    ckf("tvm_pv_annuity zero-rate", pva0, 500.0)

    // KAT 9: tvm_pmt zero-rate: 12000 / 12 = 1000.0
    let pmt0 = tvm_pmt(12000.0, 0.0, 12)
    ckf("tvm_pmt zero-rate", pmt0, 1000.0)

    // KAT 10: pv/fv round-trip consistency check
    // tvm_pv(tvm_fv(500.0, 0.08, 20), 0.08, 20) ~= 500.0
    let fv_rt = tvm_fv(500.0, 0.08, 20)
    let pv_rt = tvm_pv(fv_rt, 0.08, 20)
    ckf("tvm pv/fv roundtrip", pv_rt, 500.0)

    print("_tvm_test passed")
