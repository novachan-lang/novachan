// KAT for std/finance/tvm — Time Value of Money
// Tests both the tvm_* prefixed names and the short canonical aliases.
import std/finance/tvm

fn ckf(label: string, got: float, want: float, eps: float)
    let d = got - want
    if d < 0.0
        d = 0.0 - d
    if d > eps
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // KAT 1: tvm_fv(1000.0, 0.05, 10) == 1628.89
    let fv1 = tvm_fv(1000.0, 0.05, 10)
    ckf("tvm_fv basic", fv1, 1628.89, 0.01)

    // KAT 2: tvm_pv(1628.89, 0.05, 10) == 1000.0
    let pv1 = tvm_pv(1628.89, 0.05, 10)
    ckf("tvm_pv basic", pv1, 1000.0, 0.01)

    // KAT 3: tvm_fv_annuity(100.0, 0.05, 10) == 1257.79
    let fva1 = tvm_fv_annuity(100.0, 0.05, 10)
    ckf("tvm_fv_annuity basic", fva1, 1257.79, 0.01)

    // KAT 4: tvm_pv_annuity(100.0, 0.05, 10) == 772.17
    let pva1 = tvm_pv_annuity(100.0, 0.05, 10)
    ckf("tvm_pv_annuity basic", pva1, 772.17, 0.01)

    // KAT 5: tvm_pmt(10000.0, 0.005, 60) == 193.33
    let pmt1 = tvm_pmt(10000.0, 0.005, 60)
    ckf("tvm_pmt loan", pmt1, 193.33, 0.01)

    // KAT 6: zero-rate edge cases
    let fv0 = tvm_fv(1000.0, 0.0, 5)
    ckf("tvm_fv zero-rate", fv0, 1000.0, 0.001)
    let fva0 = tvm_fv_annuity(100.0, 0.0, 5)
    ckf("tvm_fv_annuity zero-rate", fva0, 500.0, 0.001)
    let pva0 = tvm_pv_annuity(100.0, 0.0, 5)
    ckf("tvm_pv_annuity zero-rate", pva0, 500.0, 0.001)
    let pmt0 = tvm_pmt(12000.0, 0.0, 12)
    ckf("tvm_pmt zero-rate", pmt0, 1000.0, 0.001)

    // KAT 7: pv/fv round-trip
    let fv_rt = tvm_fv(500.0, 0.08, 20)
    let pv_rt = tvm_pv(fv_rt, 0.08, 20)
    ckf("tvm pv/fv roundtrip", pv_rt, 500.0, 0.001)

    // KAT 8: canonical alias future_value == tvm_fv
    let fva_alias = future_value(1000.0, 0.05, 10)
    ckf("future_value alias", fva_alias, 1628.89, 0.01)

    // KAT 9: canonical alias present_value == tvm_pv
    let pva_alias = present_value(1628.89, 0.05, 10)
    ckf("present_value alias", pva_alias, 1000.0, 0.01)

    // KAT 10: annuity_fv alias
    let afv_alias = annuity_fv(100.0, 0.05, 10)
    ckf("annuity_fv alias", afv_alias, 1257.79, 0.05)

    // KAT 11: annuity_pv alias
    let apv_alias = annuity_pv(100.0, 0.05, 10)
    ckf("annuity_pv alias", apv_alias, 772.17, 0.01)

    print("PASS _tvm_test")
