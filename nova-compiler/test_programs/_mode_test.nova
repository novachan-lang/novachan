// _mode_test.nova — KAT for std/music/mode
//
// Known-answer tests for diatonic mode utilities.
//
// HAND-VERIFIED VECTORS
//   mode_pattern("dorian")     == [0,2,3,5,7,9,10]
//   mode_pattern("lydian")     == [0,2,4,6,7,9,11]
//   mode_pattern("ionian")     == [0,2,4,5,7,9,11]
//   mode_pattern("phrygian")   == [0,1,3,5,7,8,10]
//   mode_pattern("mixolydian") == [0,2,4,5,7,9,10]
//   mode_pattern("aeolian")    == [0,2,3,5,7,8,10]
//   mode_pattern("locrian")    == [0,1,3,5,6,8,10]
//
//   mode_notes(62,"dorian")    == [62,64,65,67,69,71,72]
//     62+0=62, 62+2=64, 62+3=65, 62+5=67, 62+7=69, 62+9=71, 62+10=72
//
//   mode_name(1) == "ionian"
//   mode_name(2) == "dorian"
//   mode_name(7) == "locrian"
//
//   mode_of_major(60, 2):
//     C major ionian[1] = 2 semitones -> new_root = 62 (D)
//     D Dorian -> first note = 62

import std/music/mode

// ── check helpers ─────────────────────────────────────────────────────────────

fn cki(label, got, want)
    if got != want
        print("FAIL mode " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL mode " + label + ": got=" + got + " want=" + want)
        exit(1)

// ck_list compares two int lists element by element.
fn ck_list(label, got, want)
    let glen = len(got)
    let wlen = len(want)
    if glen != wlen
        print("FAIL mode " + label + " len: got=" + str(glen) + " want=" + str(wlen))
        exit(1)
    let i = 0
    while i < wlen
        let g = got[i]
        let w = want[i]
        if g != w
            print("FAIL mode " + label + "[" + str(i) + "]: got=" + str(g) + " want=" + str(w))
            exit(1)
        i = i + 1

// ── main ─────────────────────────────────────────────────────────────────────

fn main()
    // ── mode_pattern ──────────────────────────────────────────────────────────
    let pat_ionian = []
    push(pat_ionian, 0)
    push(pat_ionian, 2)
    push(pat_ionian, 4)
    push(pat_ionian, 5)
    push(pat_ionian, 7)
    push(pat_ionian, 9)
    push(pat_ionian, 11)
    ck_list("pattern_ionian", mode_pattern("ionian"), pat_ionian)

    let pat_dorian = []
    push(pat_dorian, 0)
    push(pat_dorian, 2)
    push(pat_dorian, 3)
    push(pat_dorian, 5)
    push(pat_dorian, 7)
    push(pat_dorian, 9)
    push(pat_dorian, 10)
    ck_list("pattern_dorian", mode_pattern("dorian"), pat_dorian)

    let pat_phrygian = []
    push(pat_phrygian, 0)
    push(pat_phrygian, 1)
    push(pat_phrygian, 3)
    push(pat_phrygian, 5)
    push(pat_phrygian, 7)
    push(pat_phrygian, 8)
    push(pat_phrygian, 10)
    ck_list("pattern_phrygian", mode_pattern("phrygian"), pat_phrygian)

    let pat_lydian = []
    push(pat_lydian, 0)
    push(pat_lydian, 2)
    push(pat_lydian, 4)
    push(pat_lydian, 6)
    push(pat_lydian, 7)
    push(pat_lydian, 9)
    push(pat_lydian, 11)
    ck_list("pattern_lydian", mode_pattern("lydian"), pat_lydian)

    let pat_mixolydian = []
    push(pat_mixolydian, 0)
    push(pat_mixolydian, 2)
    push(pat_mixolydian, 4)
    push(pat_mixolydian, 5)
    push(pat_mixolydian, 7)
    push(pat_mixolydian, 9)
    push(pat_mixolydian, 10)
    ck_list("pattern_mixolydian", mode_pattern("mixolydian"), pat_mixolydian)

    let pat_aeolian = []
    push(pat_aeolian, 0)
    push(pat_aeolian, 2)
    push(pat_aeolian, 3)
    push(pat_aeolian, 5)
    push(pat_aeolian, 7)
    push(pat_aeolian, 8)
    push(pat_aeolian, 10)
    ck_list("pattern_aeolian", mode_pattern("aeolian"), pat_aeolian)

    let pat_locrian = []
    push(pat_locrian, 0)
    push(pat_locrian, 1)
    push(pat_locrian, 3)
    push(pat_locrian, 5)
    push(pat_locrian, 6)
    push(pat_locrian, 8)
    push(pat_locrian, 10)
    ck_list("pattern_locrian", mode_pattern("locrian"), pat_locrian)

    // ── mode_notes ────────────────────────────────────────────────────────────
    // D Dorian starting on MIDI 62
    let want_d_dorian = []
    push(want_d_dorian, 62)
    push(want_d_dorian, 64)
    push(want_d_dorian, 65)
    push(want_d_dorian, 67)
    push(want_d_dorian, 69)
    push(want_d_dorian, 71)
    push(want_d_dorian, 72)
    ck_list("notes_d_dorian", mode_notes(62, "dorian"), want_d_dorian)

    // C Ionian (C major) starting on MIDI 60
    let want_c_ionian = []
    push(want_c_ionian, 60)
    push(want_c_ionian, 62)
    push(want_c_ionian, 64)
    push(want_c_ionian, 65)
    push(want_c_ionian, 67)
    push(want_c_ionian, 69)
    push(want_c_ionian, 71)
    ck_list("notes_c_ionian", mode_notes(60, "ionian"), want_c_ionian)

    // A Aeolian (A natural minor) starting on MIDI 69
    let want_a_aeolian = []
    push(want_a_aeolian, 69)
    push(want_a_aeolian, 71)
    push(want_a_aeolian, 72)
    push(want_a_aeolian, 74)
    push(want_a_aeolian, 76)
    push(want_a_aeolian, 77)
    push(want_a_aeolian, 79)
    ck_list("notes_a_aeolian", mode_notes(69, "aeolian"), want_a_aeolian)

    // ── mode_name ─────────────────────────────────────────────────────────────
    cks("name_1", mode_name(1), "ionian")
    cks("name_2", mode_name(2), "dorian")
    cks("name_3", mode_name(3), "phrygian")
    cks("name_4", mode_name(4), "lydian")
    cks("name_5", mode_name(5), "mixolydian")
    cks("name_6", mode_name(6), "aeolian")
    cks("name_7", mode_name(7), "locrian")
    cks("name_oob", mode_name(0), "unknown")
    cks("name_oob8", mode_name(8), "unknown")

    // ── mode_of_major ─────────────────────────────────────────────────────────
    // C major (root=60), degree 2 -> D Dorian, first note = 62
    let d_dorian_from_major = mode_of_major(60, 2)
    cki("mode_of_major_60_2_root", d_dorian_from_major[0], 62)
    // Full check: should equal D Dorian notes
    ck_list("mode_of_major_60_2_full", d_dorian_from_major, want_d_dorian)

    // C major, degree 1 -> C Ionian
    let c_ionian_from_major = mode_of_major(60, 1)
    ck_list("mode_of_major_60_1", c_ionian_from_major, want_c_ionian)

    // C major, degree 6 -> A Aeolian (natural minor), root = 60+9 = 69
    let a_aeolian_from_major = mode_of_major(60, 6)
    cki("mode_of_major_60_6_root", a_aeolian_from_major[0], 69)
    ck_list("mode_of_major_60_6_full", a_aeolian_from_major, want_a_aeolian)

    // G major (root=67), degree 5 -> D Mixolydian, root = 67+7 = 74
    // G Ionian[4] = 7 semitones -> new_root = 67+7 = 74
    // D Mixolydian pattern [0,2,4,5,7,9,10] -> [74,76,78,79,81,83,84]
    let d_mixo = mode_of_major(67, 5)
    cki("mode_of_major_67_5_root", d_mixo[0], 74)

    // ── spec KAT vectors (canonical cross-check) ──────────────────────────────
    // mode_pattern("dorian") == [0,2,3,5,7,9,10]
    ck_list("spec_dorian_pat", mode_pattern("dorian"), pat_dorian)
    // mode_notes(62,"dorian") == [62,64,65,67,69,71,72]
    ck_list("spec_dorian_notes", mode_notes(62, "dorian"), want_d_dorian)
    // mode_name(2) == "dorian"
    cks("spec_name_2", mode_name(2), "dorian")
    // mode_of_major(60,2) starts on 62
    cki("spec_major_60_2", mode_of_major(60, 2)[0], 62)
    // mode_pattern("lydian") == [0,2,4,6,7,9,11]
    ck_list("spec_lydian_pat", mode_pattern("lydian"), pat_lydian)

    print("PASS _mode_test")
