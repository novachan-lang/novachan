// THE HERO (M1) — a real Forge app doing TYPED CRUD over the router, verified via dispatch_test
// (socketless -> no live serve loop -> kill-on-timeout safe). Self-validating: exits 1 on mismatch.
// NOTE: req: Request is the current Forge convention (see demo_forge_crud) — the one inference gap
// to close for the plan's fully annotation-free hero; everything else here is zero-annotation.
import forge
import forge_db

type Todo
    id: int
    title: string
    done: int

fn list_todos(req: Request, pool)
    let all: list<Todo> = db_all(pool, "todos")
    resp_json(200, all)

fn create_todo(req: Request, pool)
    let parsed: Result<Todo> = from_json_safe(req.body)
    match parsed
        Ok(todo) =>
            db_insert(pool, "todos", todo)
            resp_json(201, todo)
        Err(e) =>
            resp_error(422, e)

fn main()
    let pool = pool_open(":memory:", 1)
    pool_exec(pool, "CREATE TABLE IF NOT EXISTS todos (id INTEGER PRIMARY KEY, title TEXT, done INTEGER)")
    let a = app()
    let p = pool
    get(a, "/todos", fn(req) list_todos(req, p))
    post(a, "/todos", fn(req) create_todo(req, p))
    let lb = chr(123)
    let rb = chr(125)
    let r1 = dispatch_test(a, mock_request("POST", "/todos", lb + "\"title\":\"buy milk\",\"done\":0" + rb))
    if status_of(r1) != 201
        print("FAIL POST1 status=" + str(status_of(r1)) + " body=" + body_of(r1))
        exit(1)
    let r2 = dispatch_test(a, mock_request("POST", "/todos", lb + "\"title\":\"write code\",\"done\":1" + rb))
    if status_of(r2) != 201
        print("FAIL POST2 status=" + str(status_of(r2)))
        exit(1)
    let r3 = dispatch_test(a, mock_request("GET", "/todos", ""))
    if status_of(r3) != 200
        print("FAIL GET status=" + str(status_of(r3)))
        exit(1)
    let body = body_of(r3)
    if find(body, "buy milk") < 0 or find(body, "write code") < 0
        print("FAIL GET body missing todos: " + body)
        exit(1)
    if find(body, "\"id\":1") < 0 or find(body, "\"id\":2") < 0
        print("FAIL GET body missing auto-ids: " + body)
        exit(1)
    print("PASS forge_hero (typed CRUD: POST 201 x2, GET 200 typed JSON with auto-ids)")
