// KAT test for std/data/csvsniff
// Tests cs_delimiter, cs_has_header, and cs_dialect.

import std/data/csvsniff

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + got + " expected " + expected)
        exit(1)

fn main()
    // ── KAT 1: comma delimiter ────────────────────────────────────────────────
    let sample_comma = "a,b,c" + chr(10) + "1,2,3"
    cks("delimiter_comma", cs_delimiter(sample_comma), ",")

    // ── KAT 2: semicolon delimiter ────────────────────────────────────────────
    let sample_semi = "a;b;c" + chr(10) + "1;2;3"
    cks("delimiter_semi", cs_delimiter(sample_semi), ";")

    // ── KAT 3: tab delimiter ──────────────────────────────────────────────────
    let sample_tab = "a" + chr(9) + "b" + chr(10) + "1" + chr(9) + "2"
    cks("delimiter_tab", cs_delimiter(sample_tab), chr(9))

    // ── KAT 4: pipe delimiter ─────────────────────────────────────────────────
    let sample_pipe = "a|b|c" + chr(10) + "1|2|3"
    cks("delimiter_pipe", cs_delimiter(sample_pipe), "|")

    // ── KAT 5: has_header true (first row text labels, second row has numbers) ─
    let sample_hdr = "name,age" + chr(10) + "bob,30"
    cki("has_header_true", cs_has_header(sample_hdr), 1)

    // ── KAT 6: has_header false (both rows are numeric) ───────────────────────
    let sample_nohdr = "1,2" + chr(10) + "3,4"
    cki("has_header_false", cs_has_header(sample_nohdr), 0)

    // ── KAT 7: cs_dialect delimiter field ─────────────────────────────────────
    let sample_d = "a,b" + chr(10) + "1,2"
    let dialect = cs_dialect(sample_d)
    cks("dialect_delimiter", dialect["delimiter"], ",")

    // ── KAT 8: cs_dialect has_header field ────────────────────────────────────
    cki("dialect_has_header", dialect["has_header"], 1)

    // ── KAT 9: cs_dialect line_count field ────────────────────────────────────
    cki("dialect_line_count", dialect["line_count"], 2)

    // ── KAT 10: CRLF tolerance (lines end with chr(13)+chr(10)) ───────────────
    let crlf_sample = "x,y,z" + chr(13) + chr(10) + "1,2,3" + chr(13) + chr(10)
    cks("delimiter_crlf", cs_delimiter(crlf_sample), ",")

    // ── KAT 11: multi-line comma consistency (3 rows) ─────────────────────────
    let ml = "a,b,c" + chr(10) + "1,2,3" + chr(10) + "4,5,6"
    cks("delimiter_multiline", cs_delimiter(ml), ",")

    // ── KAT 12: semicolon with header detection ────────────────────────────────
    let shdr = "city;country" + chr(10) + "Paris;France" + chr(10) + "42;DE"
    cks("semi_dialect_delim", cs_dialect(shdr)["delimiter"], ";")

    // ── KAT 13: pipe with header — first row all non-numeric ──────────────────
    let phdr = "product|price" + chr(10) + "apple|1.99"
    cki("pipe_has_header", cs_has_header(phdr), 1)

    // ── KAT 14: negative number is numeric ────────────────────────────────────
    // A row with a negative value should count as numeric for has_header.
    let neg_sample = "col_a,col_b" + chr(10) + "-5,10"
    cki("has_header_neg_numeric", cs_has_header(neg_sample), 1)

    // ── KAT 15: decimal number is numeric ─────────────────────────────────────
    let dec_sample = "label,value" + chr(10) + "alpha,3.14"
    cki("has_header_decimal", cs_has_header(dec_sample), 1)

    // ── KAT 16: all-numeric first row → no header ─────────────────────────────
    let allnum = "1.5,2.7" + chr(10) + "3.1,4.9"
    cki("has_header_allnum_first", cs_has_header(allnum), 0)

    print("_csvsniff_test passed")
