// KAT test for std/data/pls_build
import std/data/pls_build

fn cks(label, got, expected)
    if got != expected
        print("FAIL pls_build " + label + ": got=[" + got + "] expected=[" + expected + "]")
        exit(1)

fn cki(label, got, expected)
    if got != expected
        print("FAIL pls_build " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

fn check_contains(label, haystack, needle)
    let found = 0
    let hlen = len(haystack)
    let nlen = len(needle)
    let i = 0
    while i + nlen <= hlen
        let frag = slice(haystack, i, i + nlen)
        if frag == needle
            found = 1
        i = i + 1
    if found == 0
        print("FAIL pls_build " + label + ": [" + haystack + "] does not contain [" + needle + "]")
        exit(1)

let lf = chr(10)

// ── KAT 1: single entry build ────────────────────────────────────────────────
let e1 = {}
e1["url"]    = "http://x/a"
e1["title"]  = "A"
e1["length"] = 120
let entries1 = [e1]
let out1 = pls_build(entries1)

check_contains("has_header",       out1, "[playlist]")
check_contains("has_file1",        out1, "File1=http://x/a")
check_contains("has_title1",       out1, "Title1=A")
check_contains("has_length1",      out1, "Length1=120")
check_contains("has_num_entries",  out1, "NumberOfEntries=1")
check_contains("has_version",      out1, "Version=2")

// ── KAT 2: multi-entry build ─────────────────────────────────────────────────
let e2 = {}
e2["url"]    = "http://x/b"
e2["title"]  = "B"
e2["length"] = 240
let entries2 = [e1, e2]
let out2 = pls_build(entries2)

check_contains("multi_file1",  out2, "File1=http://x/a")
check_contains("multi_title1", out2, "Title1=A")
check_contains("multi_file2",  out2, "File2=http://x/b")
check_contains("multi_title2", out2, "Title2=B")
check_contains("multi_len2",   out2, "Length2=240")
check_contains("multi_num",    out2, "NumberOfEntries=2")

// ── KAT 3: empty playlist ─────────────────────────────────────────────────────
let out3 = pls_build([])
check_contains("empty_header",  out3, "[playlist]")
check_contains("empty_num",     out3, "NumberOfEntries=0")
check_contains("empty_version", out3, "Version=2")

// ── KAT 4: negative length (unknown) ─────────────────────────────────────────
let e4 = {}
e4["url"]    = "http://x/c"
e4["title"]  = "C"
e4["length"] = -1
let out4 = pls_build([e4])
check_contains("neg_length", out4, "Length1=-1")

// ── KAT 5: round-trip pls_build -> pls_parse ─────────────────────────────────
let rt = pls_parse(out2)
cki("rt_len",     len(rt),           2)
cks("rt_url0",    rt[0]["url"],      "http://x/a")
cks("rt_title0",  rt[0]["title"],    "A")
cki("rt_length0", rt[0]["length"],   120)
cks("rt_url1",    rt[1]["url"],      "http://x/b")
cks("rt_title1",  rt[1]["title"],    "B")
cki("rt_length1", rt[1]["length"],   240)

// ── KAT 6: pls_parse standalone ──────────────────────────────────────────────
let sample = "[playlist]" + lf + "File1=http://example.com/song.mp3" + lf + "Title1=My Song" + lf + "Length1=200" + lf + "NumberOfEntries=1" + lf + "Version=2" + lf
let parsed = pls_parse(sample)
cki("parse_count",  len(parsed),           1)
cks("parse_url",    parsed[0]["url"],      "http://example.com/song.mp3")
cks("parse_title",  parsed[0]["title"],    "My Song")
cki("parse_length", parsed[0]["length"],   200)

print("PASS _pls_build_test")
