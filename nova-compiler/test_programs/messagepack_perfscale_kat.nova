// PERF KAT for std/encoding/messagepack — proves the O(n^2) accumulation
// defect (_mp_encode_array / _mp_encode_map building output via a per-
// element bytes_concat, each of which reallocs + memcpy's the ENTIRE
// accumulator) is fixed. Before the fix: a 200k-element array took 17.7s
// and a 65536-key map hung >60s. After the fix (byte-wise bytes_append into
// one amortized-growth buffer, see _mp_append_bytes): both must complete in
// well under 2s, AND their decode round-trips must be byte/element exact.
import std/encoding/messagepack

fn ckb(label: string, cond: int)
    if cond != 1
        print("FAIL " + label)
        exit(1)
    print("PASS " + label)

fn main()
    // ── 200,000-element int array ────────────────────────────────────────
    let n = 200000
    let a = []
    let i = 0
    while i < n
        push(a, i)
        i = i + 1

    let t0 = time_ms()
    let ea = msgpack_encode(a)
    let t1 = time_ms()
    let enc_ms = t1 - t0
    print("array_encode_ms=" + str(enc_ms))
    ckb("array_encode_under_2s", enc_ms < 2000)

    // format sanity: n=200000 > 65535 -> array32 (0xdd)
    ckb("array_fmt_is_array32", bytes_get(ea, 0) == 0xdd)

    let t2 = time_ms()
    let da = msgpack_decode(ea)
    let t3 = time_ms()
    print("array_decode_ms=" + str(t3 - t2))
    ckb("array_decode_under_2s", (t3 - t2) < 2000)

    ckb("array_rt_len", len(da) == n)
    ckb("array_rt_first", da[0] == 0)
    ckb("array_rt_mid", da[100000] == 100000)
    ckb("array_rt_last", da[n - 1] == n - 1)

    // ── 65,536-key map (was: hangs >60s before the fix) ──────────────────
    let mn = 65536
    let m = {}
    let mi = 0
    while mi < mn
        m["k" + str(mi)] = mi
        mi = mi + 1

    let t4 = time_ms()
    let em = msgpack_encode(m)
    let t5 = time_ms()
    let menc_ms = t5 - t4
    print("map_encode_ms=" + str(menc_ms))
    ckb("map_encode_under_2s", menc_ms < 2000)

    // format sanity: 65536 > 65535 -> map32 (0xdf)
    ckb("map_fmt_is_map32", bytes_get(em, 0) == 0xdf)

    let t6 = time_ms()
    let dm = msgpack_decode(em)
    let t7 = time_ms()
    print("map_decode_ms=" + str(t7 - t6))
    ckb("map_decode_under_2s", (t7 - t6) < 2000)

    ckb("map_rt_nkeys", len(keys(dm)) == mn)
    ckb("map_rt_k0", dm["k0"] == 0)
    ckb("map_rt_k32768", dm["k32768"] == 32768)
    ckb("map_rt_k65535", dm["k65535"] == 65535)

    print("messagepack PERF KAT: ALL PASS")
