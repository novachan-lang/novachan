// tablex — pure-NOVA fixed-width ASCII table rendering for CLI tools and reports.
// format_table(headers, rows) aligns columns to their widest cell and draws a
// header rule. Cells may be any value (rendered via str()). No runtime/compiler
// changes; manual padding (no builtin dependency beyond str/len/push).

fn _pad_right(s: string, w: int) -> string
    let out = s
    let n = len(s)
    while n < w
        out = out + " "
        n = n + 1
    return out

fn _repeat(ch: string, n: int) -> string
    let out = ""
    let i = 0
    while i < n
        out = out + ch
        i = i + 1
    return out

// Compute the display width of each column = max(header, all cells in column).
fn _col_widths(headers: list, rows: list) -> list
    let ncol = len(headers)
    let widths = []
    let c = 0
    while c < ncol
        push(widths, len(str(headers[c])))
        c = c + 1
    for row in rows
        let i = 0
        while i < ncol and i < len(row)
            let cw = len(str(row[i]))
            if cw > widths[i]
                widths[i] = cw
            i = i + 1
    return widths

fn _render_row(cells: list, widths: list, ncol: int) -> string
    let s = "|"
    let i = 0
    while i < ncol
        let cell = ""
        if i < len(cells)
            cell = str(cells[i])
        s = s + " " + _pad_right(cell, widths[i]) + " |"
        i = i + 1
    return s

// "+----+------+" rule sized to the columns.
fn _render_rule(widths: list, ncol: int) -> string
    let s = "+"
    let i = 0
    while i < ncol
        s = s + _repeat("-", widths[i] + 2) + "+"
        i = i + 1
    return s

fn format_table(headers: list, rows: list) -> string
    let ncol = len(headers)
    let widths = _col_widths(headers, rows)
    let rule = _render_rule(widths, ncol)
    let out = rule + "\n" + _render_row(headers, widths, ncol) + "\n" + rule
    for row in rows
        out = out + "\n" + _render_row(row, widths, ncol)
    out = out + "\n" + rule
    return out

fn main()
    let headers = ["id", "name", "score"]
    let rows = [[1, "alice", 95], [2, "bob", 7], [3, "charlie", 100]]
    let t = format_table(headers, rows)

    // column widths: id=2, name=7 (charlie), score=5 (score header)
    let expected = "+----+---------+-------+\n" + "| id | name    | score |\n" + "+----+---------+-------+\n" + "| 1  | alice   | 95    |\n" + "| 2  | bob     | 7     |\n" + "| 3  | charlie | 100   |\n" + "+----+---------+-------+"
    assert_eq(t, expected)

    // single-column, header wider than data
    let t2 = format_table(["heading"], [["a"], ["bb"]])
    assert_eq(t2, "+---------+\n| heading |\n+---------+\n| a       |\n| bb      |\n+---------+")

    // helpers
    assert_eq(_pad_right("hi", 5), "hi   ")
    assert_eq(_repeat("=", 4), "====")

    print("tablex passed")
