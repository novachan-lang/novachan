import forge_content_negotiation

fn main()
    let cn = cn_new()
    cn = cn_register(cn, "application/json", 10)
    cn = cn_register(cn, "text/html", 5)
    cn = cn_register(cn, "text/xml", 3)
    assert(cn_type_count(cn) == 3, "3 types")
    assert(cn_supports(cn, "application/json") == 1, "supports json")
    assert(cn_supports(cn, "image/png") == 0, "no png")

    let r1 = cn_negotiate(cn, "application/json, text/html")
    assert(r1 == "application/json", "prefer json (higher q)")

    let r2 = cn_negotiate(cn, "text/html")
    assert(r2 == "text/html", "html when only html")

    let r3 = cn_negotiate(cn, "image/png")
    assert(len(r3) > 0, "fallback to highest quality")

    print("CONTENT-NEGOTIATION KAT PASS")
