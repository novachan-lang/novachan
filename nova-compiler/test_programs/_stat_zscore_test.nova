import std/statistics/stat_zscore

fn ckf(label: str, got: float, want: float)
    let diff = got - want
    let adiff = diff
    if adiff < 0.0
        adiff = 0.0 - adiff
    if adiff > 0.001
        print("FAIL " + label + " got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckfl(label: str, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + " len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        let gv = got[i] * 1.0
        let wv = want[i] * 1.0
        let diff = gv - wv
        let adiff = diff
        if adiff < 0.0
            adiff = 0.0 - adiff
        if adiff > 0.001
            print("FAIL " + label + "[" + str(i) + "] got=" + str(gv) + " want=" + str(wv))
            exit(1)
        i = i + 1

fn main()
    // KAT 1: sz_zscore(5, 3, 2) = (5-3)/2 = 1.0
    let z1 = sz_zscore(5.0, 3.0, 2.0)
    ckf("sz_zscore(5,3,2)", z1, 1.0)

    // KAT 2: sz_zscore(1, 3, 2) = (1-3)/2 = -1.0
    let z2 = sz_zscore(1.0, 3.0, 2.0)
    ckf("sz_zscore(1,3,2)", z2, -1.0)

    // KAT 3: sz_minmax([0,5,10]) = [0.0, 0.5, 1.0]
    let mm1 = [0, 5, 10]
    let mmr1 = sz_minmax(mm1)
    let mmw1 = [0.0, 0.5, 1.0]
    ckfl("sz_minmax([0,5,10])", mmr1, mmw1)

    // KAT 4: sz_minmax([2,2,2]) = [0.0,0.0,0.0] (max==min guard)
    let mm2 = [2, 2, 2]
    let mmr2 = sz_minmax(mm2)
    let mmw2 = [0.0, 0.0, 0.0]
    ckfl("sz_minmax([2,2,2])", mmr2, mmw2)

    // KAT 5: sz_standardize([1,2,3])
    // mean=2.0, pop_var = ((1)^2+(0)^2+(1)^2)/3 = 2/3
    // pop_sd = sqrt(2/3) = 0.8165
    // z[0] = (1-2)/0.8165 = -1.2247
    // z[1] = (2-2)/0.8165 = 0.0
    // z[2] = (3-2)/0.8165 = 1.2247
    let st1 = [1, 2, 3]
    let str1 = sz_standardize(st1)
    let stw1 = [-1.2247, 0.0, 1.2247]
    ckfl("sz_standardize([1,2,3])", str1, stw1)

    // Edge: sz_zscore with stddev=0 returns 0.0
    let z0 = sz_zscore(5.0, 5.0, 0.0)
    ckf("sz_zscore zero stddev", z0, 0.0)

    // Edge: sz_standardize([5]) = [0.0] (single element, stddev=0)
    let st2 = [5]
    let str2 = sz_standardize(st2)
    let stw2 = [0.0]
    ckfl("sz_standardize([5])", str2, stw2)

    // Edge: sz_minmax([]) = []
    let empty = []
    let mmre = sz_minmax(empty)
    if len(mmre) != 0
        print("FAIL sz_minmax([]) expected empty")
        exit(1)

    print("PASS _stat_zscore_test")
