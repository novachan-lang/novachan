import std/proof/proof_normalize

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _proof_normalize_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL _proof_normalize_test " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL _proof_normalize_test " + label + ": got=" + got + " want=" + want)
        exit(1)

// --- Local formula equality helper ---
fn _local_feq(a, b) -> bool
    if len(a) != len(b)
        return false
    if a[0] != b[0]
        return false
    let tag = a[0]
    if tag == "bot"
        return true
    if tag == "top"
        return true
    if tag == "var"
        return a[1] == b[1]
    if tag == "not"
        return _local_feq(a[1], b[1])
    if tag == "and"
        if not _local_feq(a[1], b[1])
            return false
        return _local_feq(a[2], b[2])
    if tag == "or"
        if not _local_feq(a[1], b[1])
            return false
        return _local_feq(a[2], b[2])
    if tag == "imp"
        if not _local_feq(a[1], b[1])
            return false
        return _local_feq(a[2], b[2])
    false

// --- Local proof equality (structural) ---
fn _local_proof_eq(p, q) -> bool
    if p[0] != q[0]
        return false
    let tag = p[0]
    if tag == "assume"
        return _local_feq(p[1], q[1])
    if tag == "and_i"
        if not _local_proof_eq(p[1], q[1])
            return false
        return _local_proof_eq(p[2], q[2])
    if tag == "and_e1"
        return _local_proof_eq(p[1], q[1])
    if tag == "and_e2"
        return _local_proof_eq(p[1], q[1])
    if tag == "or_i1"
        if not _local_feq(p[1], q[1])
            return false
        return _local_proof_eq(p[2], q[2])
    if tag == "or_i2"
        if not _local_feq(p[1], q[1])
            return false
        return _local_proof_eq(p[2], q[2])
    if tag == "imp_i"
        if not _local_feq(p[1], q[1])
            return false
        return _local_proof_eq(p[2], q[2])
    if tag == "imp_e"
        if not _local_proof_eq(p[1], q[1])
            return false
        return _local_proof_eq(p[2], q[2])
    if tag == "not_i"
        if not _local_feq(p[1], q[1])
            return false
        return _local_proof_eq(p[2], q[2])
    if tag == "not_e"
        if not _local_proof_eq(p[1], q[1])
            return false
        return _local_proof_eq(p[2], q[2])
    if tag == "bot_e"
        if not _local_feq(p[1], q[1])
            return false
        return _local_proof_eq(p[2], q[2])
    false

fn main()
    let fA = ["var", "A"]
    let fB = ["var", "B"]
    let fC = ["var", "C"]

    // --- KAT 1: pnorm_step(and_e1(and_i(pA, pB))) == pA ---
    let pA = ["assume", fA]
    let pB = ["assume", fB]
    let pAndI = ["and_i", pA, pB]
    let pAndE1 = ["and_e1", pAndI]
    ckb("and_e1(and_i) has_detour", pnorm_has_detour(pAndE1), true)
    let stepped1 = pnorm_step(pAndE1)
    ckb("and_e1(and_i) step = pA", _local_proof_eq(stepped1, pA), true)

    // --- KAT 2: pnorm_step(and_e2(and_i(pA, pB))) == pB ---
    let pAndE2 = ["and_e2", pAndI]
    ckb("and_e2(and_i) has_detour", pnorm_has_detour(pAndE2), true)
    let stepped2 = pnorm_step(pAndE2)
    ckb("and_e2(and_i) step = pB", _local_proof_eq(stepped2, pB), true)

    // --- KAT 3: imp_e(imp_i(A, assume A), q) normalizes to q ---
    // imp_i(A, assume A) = proof of A->A; imp_e(that, assume A) = proof of A
    let pImpI = ["imp_i", fA, ["assume", fA]]
    let pArg = ["assume", fA]
    let pImpE = ["imp_e", pImpI, pArg]
    ckb("imp_e(imp_i(A,assume A),q) has_detour", pnorm_has_detour(pImpE), true)
    let stepped3 = pnorm_step(pImpE)
    // The body of imp_i is ["assume", fA]; subst fA-assumptions with pArg (=["assume",fA])
    // So body["assume",fA] with arg=["assume",fA] -> ["assume",fA] = pArg
    ckb("imp_e step = pArg", _local_proof_eq(stepped3, pArg), true)

    // --- KAT 4: normalize pAndE1 with maxsteps=10 -> normal form pA ---
    let normed1 = pnorm_normalize(pAndE1, 10)
    ckb("normalize and_e1(and_i) is_normal", pnorm_is_normal(normed1), true)
    // conclusion preserved
    let origConcl = pnorm_conclusion(pAndE1)
    let normConcl = pnorm_conclusion(normed1)
    ckb("normalize and_e1 concl=A", _local_feq(normConcl, fA), true)
    ckb("normalize and_e1 concl preserved", _local_feq(origConcl, normConcl), true)

    // --- KAT 5: normalize pAndE2 -> normal form pB ---
    let normed2 = pnorm_normalize(pAndE2, 10)
    ckb("normalize and_e2 is_normal", pnorm_is_normal(normed2), true)
    ckb("normalize and_e2 concl=B", _local_feq(pnorm_conclusion(normed2), fB), true)

    // --- KAT 6: already normal proofs stay normal ---
    ckb("assume is_normal", pnorm_is_normal(pA), true)
    ckb("and_i is_normal", pnorm_is_normal(pAndI), true)
    let pNormal = ["imp_i", fA, ["assume", fA]]
    ckb("imp_i(A,assume A) is_normal", pnorm_is_normal(pNormal), true)

    // --- KAT 7: imp_e(imp_i(A, and_e1(and_i(assume A, assume B))), pA) ---
    // = imp_e(imp_i(A, body), pA) where body=and_e1(and_i(assume A, assume B))
    // Step 1: imp_e(imp_i) -> body[pA/assume(A)] = and_e1(and_i(pA, assume B))
    // Step 2: and_e1(and_i(pA, assume B)) -> pA
    let bodyWithDetour = ["and_e1", ["and_i", ["assume", fA], ["assume", fB]]]
    let pImpI2 = ["imp_i", fA, bodyWithDetour]
    let pImpE2 = ["imp_e", pImpI2, pA]
    ckb("nested detour has_detour", pnorm_has_detour(pImpE2), true)
    let normed3 = pnorm_normalize(pImpE2, 20)
    ckb("nested detour normalizes", pnorm_is_normal(normed3), true)
    // conclusion: body had conclusion A; imp_e(imp_i(A,body),pA) -> A
    let normedC = pnorm_conclusion(normed3)
    ckb("nested detour concl=A", _local_feq(normedC, fA), true)

    // --- KAT 8: or_e(or_i1(B, assume A), A, assume A, B, assume B) -> assume A ---
    // or_i1(B, assume A) proves A|B (left disjunct = A)
    // or_e over this with left branch = assume A (proving A), right branch = assume B (proving A)...
    // wait, branches must have same conclusion.
    // Let's do: or_e(or_i1(fB, pA), fA, pA_2, fB, ["bot_e",fA,pBot])
    // Actually simpler: or_e(or_i1(fB, pA), fA, ["assume",fA], fB, ["assume",fB])
    // pA proves fA; left branch ["assume",fA] proves fA; right branch ["assume",fB] proves fB
    // BUT conclusions must match: fA != fB.
    // Use: or_e(or_i2(fA, pB), fA, ["assume",fA], fB, ["assume",fB])
    // or_i2(fA, pB) proves fA|fB (right disjunct=fB)
    // left branch ["assume",fA] proves fA; right branch ["assume",fB] proves fB — not equal.
    // Correct: or_e( or_i1(fB, pA), fA, conc, fB, conc ) where conc proves same formula.
    // Both branches prove fC: left = bot_e(fC, not_e(assume(not(fA)), assume(fA)))
    // This is getting complex. Let's do a simpler or_e test:
    // or_e( or_i2(fA, pB), fA, pC, fB, pC ) where pC = ["assume", fC]
    // or_i2(fA, pB): proves fA|fB (left=fA, right=fB via pB)
    // left branch pC proves fC, right branch pC proves fC => conclusion = fC
    // or_e step: inner = or_i2 => take right branch subst pB/assume(fB)
    // pC = ["assume", fC] (no fB assumption) => pC unchanged
    let pC = ["assume", fC]
    let pOrI2 = ["or_i2", fA, pB]
    let pOrE = ["or_e", pOrI2, fA, pC, fB, pC]
    ckb("or_e(or_i2) has_detour", pnorm_has_detour(pOrE), true)
    let steppedOrE = pnorm_step(pOrE)
    // or_i2 => take right branch: qR = pC, subst pB for ["assume",fB] in pC
    // pC = ["assume",fC] which doesn't contain ["assume",fB] => result = pC
    ckb("or_e(or_i2) step = pC", _local_proof_eq(steppedOrE, pC), true)

    // --- KAT 9: normalization preserves conclusion for complex proof ---
    // Build: imp_e(imp_i(fA, and_e2(and_i(pA,pB))), pA)
    // = imp_i(A, and_e2(and_i(assume A, assume B))) applied to pA
    // Conclusion of imp_e: conclusion of and_e2(and_i(assume A, assume B)) = B
    let bodyE2 = ["and_e2", ["and_i", ["assume", fA], ["assume", fB]]]
    let pComplex = ["imp_e", ["imp_i", fA, bodyE2], pA]
    let origC9 = pnorm_conclusion(pComplex)
    ckb("complex orig concl = B", _local_feq(origC9, fB), true)
    let normedC9 = pnorm_normalize(pComplex, 20)
    ckb("complex normalized is_normal", pnorm_is_normal(normedC9), true)
    ckb("complex normalized concl = B", _local_feq(pnorm_conclusion(normedC9), fB), true)

    // --- KAT 10: pnorm_step on non-detour returns same proof (no_op) ---
    let pNoop = ["and_i", pA, pB]
    ckb("and_i no detour", pnorm_has_detour(pNoop), false)
    let steppedNoop = pnorm_step(pNoop)
    ckb("and_i step no-op", _local_proof_eq(steppedNoop, pNoop), true)

    // --- KAT 11: or_e(or_i1(fB, pA), fA, pA2, fB, pA3) where pA2=pA3=["assume",fA] -> pA ---
    // or_i1(fB, pA): proves fA|fB (left=fA via pA)
    // Both branches prove fA: left = ["assume",fA], right=["assume",fA]
    // or_e step: inner=or_i1 => take left branch qL=["assume",fA], subst pA for ["assume",fA]
    // result = pA
    let pA2 = ["assume", fA]
    let pOrI1 = ["or_i1", fB, pA]
    let pOrE2 = ["or_e", pOrI1, fA, pA2, fB, ["assume", fA]]
    ckb("or_e(or_i1) has_detour", pnorm_has_detour(pOrE2), true)
    let steppedOrE2 = pnorm_step(pOrE2)
    // Left branch = pA2 = ["assume",fA]; subst pA for ["assume",fA] -> pA
    ckb("or_e(or_i1) step = pA", _local_proof_eq(steppedOrE2, pA), true)

    print("PASS _proof_normalize_test")
