// showcase_mandelbrot -- an ASCII Mandelbrot-set renderer in pure NOVA. A float-heavy fractal: the
// escape-time iteration z = z^2 + c is done inline with float arithmetic (the iteration helper
// returns an INT count, deliberately avoiding the float-return-helper pattern of CORE_GAP 0.11).
// Self-verifying against known membership facts; also prints the fractal.

fn mandel_iters(cx: float, cy: float, max_it: int) -> int
    let zx = 0.0
    let zy = 0.0
    let it = 0
    while it < max_it
        let zx2 = zx * zx
        let zy2 = zy * zy
        if zx2 + zy2 > 4.0
            return it
        let nzx = zx2 - zy2 + cx
        let nzy = 2.0 * zx * zy + cy
        zx = nzx
        zy = nzy
        it = it + 1
    return max_it

fn shade(it: int, max_it: int) -> string
    if it >= max_it
        return "#"
    if it > 8
        return "+"
    if it > 4
        return "."
    return " "

fn main()
    let max_it = 50

    // membership facts
    assert(mandel_iters(0.0, 0.0, max_it) == max_it, "origin is in the set (never escapes)")
    assert(mandel_iters(-1.0, 0.0, max_it) == max_it, "(-1,0) is in the set")
    assert(mandel_iters(2.0, 2.0, max_it) < 5, "(2,2) escapes almost immediately")
    assert(mandel_iters(1.0, 0.0, max_it) < max_it, "(1,0) escapes (past the cusp)")

    // render the set over the complex plane [-2.5,1.0] x [-1.25,1.25]
    let width = 50
    let height = 20
    let in_set = 0
    let row = 0
    while row < height
        let line = ""
        let col = 0
        while col < width
            let cx = -2.5 + (col * 1.0) * (3.5 / (width * 1.0))
            let cy = -1.25 + (row * 1.0) * (2.5 / (height * 1.0))
            let it = mandel_iters(cx, cy, max_it)
            if it >= max_it
                in_set = in_set + 1
            line = line + shade(it, max_it)
            col = col + 1
        print(line)
        row = row + 1

    // the main cardioid + bulb occupy a substantial chunk of this window
    print("cells in set = " + str(in_set) + " / " + str(width * height))
    assert(in_set > 50, "a meaningful number of cells are in the set")
    assert(in_set < width * height, "not the entire grid is in the set")

    print("showcase_mandelbrot_test passed -- ASCII Mandelbrot, float escape-time iteration, pure NOVA")
