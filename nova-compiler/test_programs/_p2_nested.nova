// PROBE: nested constructor patterns (WEAPON_PARITY_PLAN 2.1).
//
// `parse_pattern`'s pat_ctor branch (~2135) reads each field as a bare
//     push(fields, Expr("pat_var", tv(tokens, p), 0, [], [], ln)); p = p + 1
// i.e. ONE token per field, always treated as a binder. So `Outer(Inner(x))` reads
// `Inner` as a variable name and then meets `(` where it expects `,` or `)`.
//
// Nesting is what makes ADTs compose: matching a Result-of-Option, a tree node's
// children, or a protocol frame's payload all need it. Without it every layer costs
// a separate nested `match`, which is exactly the ceremony NOVA claims to remove.

enum Inner
    IntVal(iv_n: int)
    StrVal(sv_s: string)

enum Outer
    Wrap(w_inner: Inner)
    Empty()

fn render(o: Outer) -> string
    match o
        Wrap(IntVal(n)) => "int:" + str(n)
        Wrap(StrVal(s)) => "str:" + s
        Empty() => "empty"

// THREE levels deep, to prove the recursion is not special-cased to depth 2.
enum Lvl3
    L3(l3_v: int)

enum Lvl2
    L2(l2_inner: Lvl3)

enum Lvl1
    L1(l1_inner: Lvl2)

fn deep(x: Lvl1) -> int
    match x
        L1(L2(L3(n))) => n

// Nested inside a BUILT-IN sum (Result/Option), which takes the is_sum_match branch in
// ti_infer_pattern rather than the user-enum branch -- a separate code path.
fn sum_nested(r: Result<Inner>) -> string
    match r
        Ok(IntVal(n)) => "ok-int:" + str(n)
        Ok(StrVal(s)) => "ok-str:" + s
        Err(e) => "err:" + e

// (A deliberately-partial nested match used to live here, pinning the old
// outer-level-only behaviour as n8="". Item 2.9 now REJECTS that at compile time --
// see _negty_nested_exhaustive.nova -- so the case moved to the negative gate and the
// two prints below were removed. This is the deliberate update the old gate comment
// asked for, not a silent one.)

fn mk_ok(v: int) -> Result<Inner>
    ok(IntVal(v))

fn mk_err() -> Result<Inner>
    err("bad")

fn main()
    print("n1=" + render(Wrap(IntVal(42))))
    print("n2=" + render(Wrap(StrVal("hi"))))
    print("n3=" + render(Empty()))
    print("n4=" + str(deep(L1(L2(L3(7))))))
    print("n5=" + sum_nested(mk_ok(5)))
    print("n6=" + sum_nested(mk_err()))
