fn _is_alpha(ch)
  let c = code_points(ch)[0]
  (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95

fn _is_digit(ch)
  let c = code_points(ch)[0]
  c >= 48 and c <= 57

fn _is_alnum(ch)
  _is_alpha(ch) or _is_digit(ch)

fn tokenize(source)
  let tokens = []
  let i = 0
  let n = len(source)
  while i < n
    let ch = slice(source, i, i + 1)
    if ch == " " or ch == "\t" or ch == "\n" or ch == "\r"
      i = i + 1
      continue
    if _is_alpha(ch)
      let start = i
      while i < n and _is_alnum(slice(source, i, i + 1))
        i = i + 1
      push(tokens, ["IDENT", slice(source, start, i)])
      continue
    if _is_digit(ch)
      let start = i
      while i < n and _is_digit(slice(source, i, i + 1))
        i = i + 1
      push(tokens, ["INT", slice(source, start, i)])
      continue
    if ch == "\""
      i = i + 1
      let start = i
      while i < n and slice(source, i, i + 1) != "\""
        i = i + 1
      push(tokens, ["STRING", slice(source, start, i)])
      if i < n
        i = i + 1
      continue
    push(tokens, ["OP", ch])
    i = i + 1
  tokens

fn tok_type(t)
  t[0]

fn tok_value(t)
  t[1]

fn main()
  let tokens = tokenize("let x = 42 + y")
  assert(len(tokens) == 6, "6 tokens")
  assert(tok_type(tokens[0]) == "IDENT", "let is ident")
  assert(tok_value(tokens[0]) == "let", "let value")
  assert(tok_type(tokens[2]) == "OP", "= is op")
  assert(tok_value(tokens[2]) == "=", "= value")
  assert(tok_type(tokens[3]) == "INT", "42 is int")
  assert(tok_value(tokens[3]) == "42", "42 value")
  assert(tok_type(tokens[4]) == "OP", "+ is op")

  let t2 = tokenize("name = \"hello\"")
  assert(len(t2) == 3, "3 tokens with string")
  assert(tok_type(t2[2]) == "STRING", "string token")
  assert(tok_value(t2[2]) == "hello", "string value")

  let t3 = tokenize("")
  assert(len(t3) == 0, "empty = no tokens")

  let t4 = tokenize("a_b + c123")
  assert(tok_value(t4[0]) == "a_b", "underscore in ident")
  assert(tok_value(t4[2]) == "c123", "digits in ident")

  print("tokenx: all passed")
