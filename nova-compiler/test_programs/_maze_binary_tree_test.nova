import std/game/maze_binary_tree

// ---- structural helpers ----

// Count total edges: sum of all link-list lengths / 2.
fn _edge_count(links)
    let total = len(links)
    let s = 0
    let i = 0
    while i < total
        s = s + len(links[i])
        i = i + 1
    return s / 2

// BFS from cell 0; returns number of reachable cells.
fn _bfs_count(links)
    let total = len(links)
    let visited = []
    let k = 0
    while k < total
        push(visited, 0)
        k = k + 1
    let q = []
    push(q, 0)
    visited[0] = 1
    let head = 0
    let count = 1
    while head < len(q)
        let cur = q[head]
        head = head + 1
        let nb = links[cur]
        let nb_len = len(nb)
        let m = 0
        while m < nb_len
            let nxt = nb[m]
            if visited[nxt] == 0
                visited[nxt] = 1
                count = count + 1
                push(q, nxt)
            m = m + 1
    return count

// Check two adjacency lists are identical (same links in same order).
fn _links_equal(a, b)
    let ta = len(a)
    let tb = len(b)
    if ta != tb
        return 0
    let i = 0
    while i < ta
        let ai = a[i]
        let bi = b[i]
        let la = len(ai)
        let lb = len(bi)
        if la != lb
            return 0
        let j = 0
        while j < la
            if ai[j] != bi[j]
                return 0
            j = j + 1
        i = i + 1
    return 1

// ---- assertion helpers ----

fn _assert_int(label, got, want)
    if got != want
        print("FAIL maze_binary_tree " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn _assert_true(label, val)
    if val == 0
        print("FAIL maze_binary_tree " + label + ": expected true")
        exit(1)

// ---- KAT cases ----

fn _test_case(w, h, seed, label)
    let total = w * h
    let links = gen(w, h, seed)
    // edge count must equal total-1 for a perfect maze
    let ec = _edge_count(links)
    _assert_int(label + "_edges", ec, total - 1)
    // all cells must be reachable
    let rc = _bfs_count(links)
    _assert_int(label + "_connected", rc, total)

fn main()
    // Case 1: 6x6, seed 42 — edge_count==35, connected
    _test_case(6, 6, 42, "6x6_s42")

    // Case 2: 4x4, seed 3 — edge_count==15, connected
    _test_case(4, 4, 3, "4x4_s3")

    // Case 3: 5x4, seed 9 — edge_count==19, connected
    _test_case(5, 4, 9, "5x4_s9")

    // Determinism: gen(6,6,42) called twice gives identical links
    let la = gen(6, 6, 42)
    let lb = gen(6, 6, 42)
    let eq = _links_equal(la, lb)
    _assert_true("determinism_6x6_s42", eq)

    // Determinism: gen(4,4,3) called twice
    let lc = gen(4, 4, 3)
    let ld = gen(4, 4, 3)
    let eq2 = _links_equal(lc, ld)
    _assert_true("determinism_4x4_s3", eq2)

    print("PASS _maze_binary_tree_test")
