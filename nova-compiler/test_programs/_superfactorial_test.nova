// _superfactorial_test.nova — KAT for std/math/superfactorial.nova
import std/math/superfactorial

// cki — check integer equality
fn cki(label: str, got: int, expected: int)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// sf_factorial KAT
cki("sf_factorial(0)", sf_factorial(0), 1)
cki("sf_factorial(1)", sf_factorial(5), 120)
cki("sf_factorial(10)", sf_factorial(10), 3628800)

// sf_super KAT
cki("sf_super(0)", sf_super(0), 1)
cki("sf_super(1)", sf_super(1), 1)
cki("sf_super(2)", sf_super(2), 2)
cki("sf_super(3)", sf_super(3), 12)
cki("sf_super(4)", sf_super(4), 288)

// sf_hyper KAT
cki("sf_hyper(0)", sf_hyper(0), 1)
cki("sf_hyper(1)", sf_hyper(1), 1)
cki("sf_hyper(2)", sf_hyper(2), 4)
cki("sf_hyper(3)", sf_hyper(3), 108)
cki("sf_hyper(4)", sf_hyper(4), 27648)

// sf_primorial KAT
cki("sf_primorial(0)", sf_primorial(0), 1)
cki("sf_primorial(1)", sf_primorial(1), 1)
cki("sf_primorial(2)", sf_primorial(2), 2)
cki("sf_primorial(5)", sf_primorial(5), 30)
cki("sf_primorial(10)", sf_primorial(10), 210)

// additional edge / stress checks
cki("sf_factorial(neg)", sf_factorial(-3), 1)
cki("sf_hyper(5)", sf_hyper(5), 86400000)
cki("sf_primorial(11)", sf_primorial(11), 2310)

print("_superfactorial_test passed")
