// Compile-time type predicates — evaluated at compile time when type is statically known.
// LLVM dead-strips the false branches (zero runtime cost).

type Point
    x: int
    y: int

fn check_int(v: int) -> int
    return is_int(v)

fn check_str(v: string) -> int
    return is_string(v)

fn main()
    // Literal types — always statically resolved
    assert(is_int(42) == 1, "lit int")
    assert(is_int(3.14) == 0, "lit float not int")
    assert(is_float(3.14) == 1, "lit float")
    assert(is_float(42) == 0, "lit int not float")
    assert(is_string("hello") == 1, "lit string")
    assert(is_string(42) == 0, "lit int not string")
    assert(is_list([1, 2]) == 1, "lit list")
    assert(is_list(42) == 0, "lit int not list")
    assert(is_bool(true) == 1, "lit true")
    assert(is_bool(false) == 1, "lit false")
    assert(is_bool(42) == 0, "lit int not bool")
    assert(is_numeric(42) == 1, "lit int numeric")
    assert(is_numeric(3.14) == 1, "lit float numeric")
    assert(is_numeric("hi") == 0, "lit str not numeric")

    // Variables with known types (through typed params)
    assert(check_int(10) == 1, "param int")
    assert(check_str("hello") == 1, "param str")

    // Struct types
    let p = Point(3, 7)
    assert(is_struct(p) == 1, "struct is_struct")
    assert(is_int(p) == 0, "struct not int")
    assert(is_string(p) == 0, "struct not string")

    // Usage in conditionals — the genius compiler dead-strips the false branch
    let val = 42
    let desc = "unknown"
    if is_int(val)
        desc = "integer"
    assert(desc == "integer", "conditional on type")

    let fval = 2.718
    if is_float(fval)
        desc = "float"
    assert(desc == "float", "conditional float")

    // is_numeric combines int and float
    if is_numeric(val)
        desc = "number"
    assert(desc == "number", "numeric int")
    if is_numeric(fval)
        desc = "also number"
    assert(desc == "also number", "numeric float")

    // Dict type
    let d = {"a": 1}
    assert(is_dict(d) == 1, "dict is_dict")
    assert(is_list(d) == 0, "dict not list")

    print("type_pred_test: all passed")
