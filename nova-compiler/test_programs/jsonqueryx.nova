fn jq_get(data, path)
  let parts = split(path, ".")
  let current = data
  for part in parts
    if len(part) == 0
      continue
    if type_of(current) == "dict"
      if not contains(current, part)
        return err("key not found: " + part)
      current = current[part]
    else if type_of(current) == "list"
      let _idx = parse_int_safe(part)
      if is_err(_idx)
        return err("list index not int: " + part)
      let idx = unwrap(_idx)
      if idx < 0 or idx >= len(current)
        return err("index out of bounds: " + str(idx))
      current = current[idx]
    else
      return err("cannot traverse: " + type_of(current))
  ok(current)

fn jq_has(data, path)
  is_ok(jq_get(data, path))

fn jq_set(data, key, value)
  data[key] = value
  data

fn jq_pluck(data, field)
  let result = []
  for item in data
    if contains(item, field)
      push(result, item[field])
  result

fn jq_where(data, field, value)
  let result = []
  for item in data
    if contains(item, field) and item[field] == value
      push(result, item)
  result

fn main()
  let data = {"user": {"name": "Alice", "age": 30, "tags": ["admin", "dev"]}}

  assert(unwrap(jq_get(data, "user.name")) == "Alice", "nested get")
  assert(unwrap(jq_get(data, "user.age")) == 30, "nested int")
  assert(unwrap(jq_get(data, "user.tags.0")) == "admin", "list index")
  assert(unwrap(jq_get(data, "user.tags.1")) == "dev", "list index 1")

  assert(jq_has(data, "user.name") == 1, "has path")
  assert(jq_has(data, "user.email") == 0, "missing path")
  assert(is_err(jq_get(data, "user.tags.5")), "out of bounds")

  let users = [{"name": "Alice", "role": "admin"}, {"name": "Bob", "role": "user"}, {"name": "Carol", "role": "admin"}]
  let names = jq_pluck(users, "name")
  assert(len(names) == 3, "pluck 3")
  assert(names[0] == "Alice", "pluck first")

  let admins = jq_where(users, "role", "admin")
  assert(len(admins) == 2, "2 admins")
  assert(admins[0]["name"] == "Alice", "first admin")

  print("jsonqueryx: all passed")
