import std/money/round
fn _i(l, g, w)
    if g != w
        print("FAIL round " + l + " got=" + str(g) + " want=" + str(w))
        exit(1)
fn main()
    _i("hu52", mround_half_up(5, 2), 3)
    _i("hu72", mround_half_up(7, 2), 4)
    _i("he52", mround_half_even(5, 2), 2)
    _i("he72", mround_half_even(7, 2), 4)
    _i("fl", mround_floor(-5, 2), -3)
    _i("ce", mround_ceil(5, 2), 3)
    _i("d100", mround_div(100, 3, "half_up"), 33)
    _i("d101", mround_div(101, 3, "half_up"), 34)
    _i("pct", mround_pct(10000, 2550, "half_up"), 2550)
    print("PASS _money_round_test")
