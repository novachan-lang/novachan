// Diagnostic: test struct construction and match at scale

type Token
    kind: string
    value: string
    line: int
    col: int

fn make_tokens() -> list
    let tokens = []
    let i = 0
    while i < 100
        push(tokens, Token("IDENT", "x", i, 1))
        i = i + 1
    tokens

fn test_match(t: Token) -> string
    match t
        Token(k, v, l, c) => k + ":" + v

let toks = make_tokens()
print(len(toks))
let first = toks[0]
let result = test_match(first)
print(result)
print("DONE")
