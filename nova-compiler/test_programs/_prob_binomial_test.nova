// _prob_binomial_test.nova — KAT for std/probability/prob_binomial
import std/probability/prob_binomial

// ckr — assert fraction [num, den] equals (wn, wd)
fn ckr(label: string, got: list, wn: int, wd: int)
    if got[0] != wn or got[1] != wd
        print("FAIL " + label + ": got=[" + str(got[0]) + "," + str(got[1]) + "] want=[" + str(wn) + "," + str(wd) + "]")
        exit(1)

// --- pb_pmf ---
// pb_pmf(4,2,1,2) = C(4,2)*(1/2)^2*(1/2)^2 = 6*(1/4)*(1/4) = 6/16 = 3/8
let pmf42 = pb_pmf(4, 2, 1, 2)
ckr("pmf_4_2_half", pmf42, 3, 8)

// pb_pmf(3,0,1,3) = C(3,0)*(1/3)^0*(2/3)^3 = 1*1*(8/27) = 8/27
let pmf30 = pb_pmf(3, 0, 1, 3)
ckr("pmf_3_0_third", pmf30, 8, 27)

// pb_pmf(3,3,1,3) = C(3,3)*(1/3)^3*(2/3)^0 = 1*(1/27)*1 = 1/27
let pmf33 = pb_pmf(3, 3, 1, 3)
ckr("pmf_3_3_third", pmf33, 1, 27)

// pb_pmf(3,1,1,3) = C(3,1)*(1/3)^1*(2/3)^2 = 3*(1/3)*(4/9) = 12/27 = 4/9
let pmf31 = pb_pmf(3, 1, 1, 3)
ckr("pmf_3_1_third", pmf31, 4, 9)

// pb_pmf(2,1,1,2) = C(2,1)*(1/2)*(1/2) = 2*(1/4) = 1/2
let pmf21 = pb_pmf(2, 1, 1, 2)
ckr("pmf_2_1_half", pmf21, 1, 2)

// edge: k > n => 0/1
let pmf_ov = pb_pmf(3, 4, 1, 2)
ckr("pmf_over", pmf_ov, 0, 1)

// edge: k < 0 => 0/1
let pmf_neg = pb_pmf(3, -1, 1, 2)
ckr("pmf_neg", pmf_neg, 0, 1)

// p=1: pb_pmf(3,3,1,1) = 1/1
let pmf_p1 = pb_pmf(3, 3, 1, 1)
ckr("pmf_p1", pmf_p1, 1, 1)

// p=1: pb_pmf(3,2,1,1) = 0/1 (must get all 3)
let pmf_p1_k2 = pb_pmf(3, 2, 1, 1)
ckr("pmf_p1_k2", pmf_p1_k2, 0, 1)

// --- pb_cdf ---
// pb_cdf(2,1,1,2) = pmf(2,0) + pmf(2,1) = 1/4 + 1/2 = 3/4
let cdf21 = pb_cdf(2, 1, 1, 2)
ckr("cdf_2_1_half", cdf21, 3, 4)

// pb_cdf(3,3,1,3) = sum of all pmf(3,j,1,3) for j=0..3 = 8/27+12/27+6/27+1/27 = 27/27 = 1
let cdf33 = pb_cdf(3, 3, 1, 3)
ckr("cdf_3_3_third", cdf33, 1, 1)

// pb_cdf(3,0,1,3) = pmf(3,0) = 8/27
let cdf30 = pb_cdf(3, 0, 1, 3)
ckr("cdf_3_0_third", cdf30, 8, 27)

// pb_cdf k>n clamps to 1
let cdf_ov = pb_cdf(2, 5, 1, 2)
ckr("cdf_over", cdf_ov, 1, 1)

// --- pb_mean ---
// pb_mean(4,1,2) = 4*(1/2) = 2/1
let m4 = pb_mean(4, 1, 2)
ckr("mean_4_half", m4, 2, 1)

// pb_mean(3,1,3) = 3*(1/3) = 1/1
let m3 = pb_mean(3, 1, 3)
ckr("mean_3_third", m3, 1, 1)

// pb_mean(5,2,5) = 5*(2/5) = 10/5 = 2/1
let m5 = pb_mean(5, 2, 5)
ckr("mean_5_2_5", m5, 2, 1)

// --- pb_variance ---
// pb_variance(4,1,2) = 4*(1/2)*(1/2) = 4*(1/4) = 1/1
let v4 = pb_variance(4, 1, 2)
ckr("var_4_half", v4, 1, 1)

// pb_variance(3,1,3) = 3*(1/3)*(2/3) = 3*(2/9) = 6/9 = 2/3
let v3 = pb_variance(3, 1, 3)
ckr("var_3_third", v3, 2, 3)

// pb_variance(6,1,2) = 6*(1/4) = 6/4 = 3/2
let v6 = pb_variance(6, 1, 2)
ckr("var_6_half", v6, 3, 2)

print("PASS _prob_binomial_test")
