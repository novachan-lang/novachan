import forge_gaussint as gi

fn check(cond: bool, label: string)
    if cond == false
        print("FAIL: " + label)

fn lcg(state: int) -> int
    (state * 1103515245 + 12345) % 2147483648

fn eq(z: list, a: int, b: int) -> bool
    z[0] == a and z[1] == b

fn main()
    // ---- norm ----
    check(gi.gint_norm([3, 4]) == 25, "norm 3+4i == 25")
    check(gi.gint_norm([2, 0]) == 4, "norm 2 == 4")
    check(gi.gint_norm([0, 0]) == 0, "norm 0 == 0")

    // ---- mul ----
    check(eq(gi.gint_mul([1, 1], [1, 1]), 0, 2), "(1+i)^2 == 2i")
    check(eq(gi.gint_mul([2, 3], [1, -1]), 5, 1), "(2+3i)(1-i) == 5+i")
    check(eq(gi.gint_mul([2, 1], [2, -1]), 5, 0), "(2+i)(2-i) == 5")

    // ---- add / sub / conj ----
    check(eq(gi.gint_add([1, 2], [3, 4]), 4, 6), "add")
    check(eq(gi.gint_sub([5, 3], [2, 8]), 3, -5), "sub")
    check(eq(gi.gint_conj([3, -7]), 3, 7), "conj")

    // ---- division-with-remainder: z = q*w + r, norm(r) < norm(w) ----
    check(gi.gint_divides([2, 1], [5, 0]), "2+i divides 5")
    check(gi.gint_divides([2, -1], [5, 0]), "2-i divides 5")
    check(gi.gint_divides([1, 1], [0, 2]), "1+i divides 2i")
    check(gi.gint_divides([1, 1], [3, 0]) == false, "1+i does NOT divide 3")

    // ---- gcd fixed ----
    // gcd(5, 2+i): 5 = (2+i)(2-i), so 2+i divides 5 -> gcd is 2+i (canonical first quadrant)
    let g1 = gi.gint_gcd([5, 0], [2, 1])
    check(gi.gint_divides(g1, [5, 0]) and gi.gint_divides(g1, [2, 1]), "gcd(5,2+i) divides both")
    check(gi.gint_norm(g1) == 5, "gcd(5,2+i) has norm 5")

    // gcd of z and 0 is z normalized
    let g0 = gi.gint_gcd([3, 4], [0, 0])
    check(gi.gint_norm(g0) == 25, "gcd(3+4i,0) norm 25")

    // ---- big self-checks over random Gaussian integers ----
    let st = 24681357
    let t = 0
    while t < 60
        st = lcg(st)
        let a = (st % 13) - 6
        st = lcg(st)
        let b = (st % 13) - 6
        st = lcg(st)
        let c = (st % 13) - 6
        st = lcg(st)
        let d = (st % 13) - 6
        let z = [a, b]
        let w = [c, d]

        // (1) norm is multiplicative: norm(z*w) == norm(z)*norm(w)
        let zw = gi.gint_mul(z, w)
        check(gi.gint_norm(zw) == gi.gint_norm(z) * gi.gint_norm(w), "norm multiplicative t=" + str(t))

        // (2) division inequality: if w != 0 then z = q*w + r with norm(r) < norm(w)
        if c != 0 or d != 0
            let q = gi.gint_div(z, w)
            let r = gi.gint_mod(z, w)
            let recomposed = gi.gint_add(gi.gint_mul(q, w), r)
            check(eq(recomposed, a, b), "z==q*w+r t=" + str(t))
            check(gi.gint_norm(r) < gi.gint_norm(w), "norm(r)<norm(w) t=" + str(t))

        // (3) gcd divides both operands (when not both zero)
        if (a != 0 or b != 0) and (c != 0 or d != 0)
            let g = gi.gint_gcd(z, w)
            check(gi.gint_divides(g, z), "gcd divides z t=" + str(t))
            check(gi.gint_divides(g, w), "gcd divides w t=" + str(t))
        t = t + 1

    print("forge_gaussint: all passed")
