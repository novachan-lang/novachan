// KAT for std/time/datetime — UTC calendar + ISO 8601 + arithmetic (incl. leap + pre-1970 floor-div).
import std/time/datetime

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": " + str(got) + " != " + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": '" + got + "' != '" + want + "'")
        exit(1)

fn main()
    let d = dt_from_epoch(1610712000)
    cki("year", d["year"], 2021)
    cki("month", d["month"], 1)
    cki("day", d["day"], 15)
    cki("hour", d["hour"], 12)
    cki("weekday", d["weekday"], 5)
    cki("to_epoch", dt_to_epoch(2021, 1, 15, 12, 0, 0), 1610712000)
    cks("iso", dt_format_iso(1610712000), "2021-01-15T12:00:00Z")
    cki("parse", dt_parse_iso("2021-01-15T12:00:00Z"), 1610712000)
    cki("parse-space", dt_parse_iso("2021-01-15 12:00:00"), 1610712000)
    cki("add-days", dt_add_days(1610712000, 1), 1610798400)
    cki("add-secs", dt_add_seconds(1610712000, 3600), 1610715600)
    cki("malformed", dt_parse_iso("not-a-date"), -1)
    // leap year 2020-02-29
    let leap = dt_from_epoch(dt_to_epoch(2020, 2, 29, 0, 0, 0))
    cki("leap-month", leap["month"], 2)
    cki("leap-day", leap["day"], 29)
    // negative epoch (pre-1970): -1 -> 1969-12-31 23:59:59
    let neg = dt_from_epoch(0 - 1)
    cki("neg-year", neg["year"], 1969)
    cki("neg-month", neg["month"], 12)
    cki("neg-day", neg["day"], 31)
    cki("neg-sec", neg["sec"], 59)
    print("_datetime_test passed")
