d = json_decode("\{\"a\":true,\"b\":null,\"c\":0,\"d\":false\}")
print("a==true: " + str(d["a"] == true))
print("a==1:    " + str(d["a"] == 1))
print("b==null: " + str(d["b"] == null))
print("b==0:    " + str(d["b"] == 0))
print("c==0:    " + str(d["c"] == 0))
print("c==null: " + str(d["c"] == null))
print("d==false:" + str(d["d"] == false))
print("d==0:    " + str(d["d"] == 0))
print("null==0: " + str(null == 0))
print("false==0:" + str(false == 0))
print("true==1: " + str(true == 1))
