import std/logic/logic_ops

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _logic_ops_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL _logic_ops_test " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn ckl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL _logic_ops_test " + label + ": length mismatch")
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL _logic_ops_test " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // === Spec KAT vectors: n=2, x0=10 (0b1010), x1=12 (0b1100) ===
    let x0 = 10
    let x1 = 12
    cki("lop_and(10,12)", lop_and(x0, x1), 8)
    cki("lop_or(10,12)", lop_or(x0, x1), 14)
    cki("lop_xor(10,12)", lop_xor(x0, x1), 6)
    cki("lop_not(10,2)", lop_not(x0, 2), 5)
    cki("lop_nand(10,12,2)", lop_nand(x0, x1, 2), 7)
    cki("lop_nor(10,12,2)", lop_nor(x0, x1, 2), 1)
    cki("lop_implies(10,12,2)", lop_implies(x0, x1, 2), 13)
    cki("lop_iff(10,12,2)", lop_iff(x0, x1, 2), 9)

    // === ENUMERATION CROSS-CHECK: all ops on all 16x16 pairs for n=2 ===
    // For each pair (a,b) in 0..15, verify each op bit-by-bit against single-bit semantics.
    let a = 0
    while a < 16
        let b = 0
        while b < 16
            // Check lop_and
            let got_and = lop_and(a, b)
            // Check lop_or
            let got_or = lop_or(a, b)
            // Check lop_xor
            let got_xor = lop_xor(a, b)
            // Check lop_not(a)
            let got_not = lop_not(a, 2)
            // Check lop_nand
            let got_nand = lop_nand(a, b, 2)
            // Check lop_nor
            let got_nor = lop_nor(a, b, 2)
            // Check lop_implies
            let got_impl = lop_implies(a, b, 2)
            // Check lop_iff
            let got_iff = lop_iff(a, b, 2)
            // Verify bit by bit for all 4 assignments
            let i = 0
            while i < 4
                let ba = (a >> i) & 1
                let bb = (b >> i) & 1
                // and
                let exp_and = ba & bb
                if ((got_and >> i) & 1) != exp_and
                    print("FAIL _logic_ops_test enum_and a=" + str(a) + " b=" + str(b) + " i=" + str(i))
                    exit(1)
                // or
                let exp_or = ba | bb
                if ((got_or >> i) & 1) != exp_or
                    print("FAIL _logic_ops_test enum_or a=" + str(a) + " b=" + str(b) + " i=" + str(i))
                    exit(1)
                // xor
                let exp_xor = ba ^ bb
                if ((got_xor >> i) & 1) != exp_xor
                    print("FAIL _logic_ops_test enum_xor a=" + str(a) + " b=" + str(b) + " i=" + str(i))
                    exit(1)
                // not(a)
                let exp_not = 1 - ba
                if ((got_not >> i) & 1) != exp_not
                    print("FAIL _logic_ops_test enum_not a=" + str(a) + " i=" + str(i))
                    exit(1)
                // nand
                let exp_nand = 1 - (ba & bb)
                if ((got_nand >> i) & 1) != exp_nand
                    print("FAIL _logic_ops_test enum_nand a=" + str(a) + " b=" + str(b) + " i=" + str(i))
                    exit(1)
                // nor
                let exp_nor = 1 - (ba | bb)
                if ((got_nor >> i) & 1) != exp_nor
                    print("FAIL _logic_ops_test enum_nor a=" + str(a) + " b=" + str(b) + " i=" + str(i))
                    exit(1)
                // implies: NOT(a) OR b
                let exp_impl = (1 - ba) | bb
                if ((got_impl >> i) & 1) != exp_impl
                    print("FAIL _logic_ops_test enum_implies a=" + str(a) + " b=" + str(b) + " i=" + str(i))
                    exit(1)
                // iff: NOT(XOR)
                let exp_iff = 1 - (ba ^ bb)
                if ((got_iff >> i) & 1) != exp_iff
                    print("FAIL _logic_ops_test enum_iff a=" + str(a) + " b=" + str(b) + " i=" + str(i))
                    exit(1)
                i = i + 1
            b = b + 1
        a = a + 1

    // === Edge cases: tautology/contradiction inputs ===
    // lop_and(15,15)=15, lop_or(0,0)=0, lop_not(15,2)=0, lop_not(0,2)=15
    cki("lop_and(15,15)", lop_and(15, 15), 15)
    cki("lop_and(0,15)", lop_and(0, 15), 0)
    cki("lop_or(0,0)", lop_or(0, 0), 0)
    cki("lop_or(15,0)", lop_or(15, 0), 15)
    cki("lop_not(15,2)", lop_not(15, 2), 0)
    cki("lop_not(0,2)", lop_not(0, 2), 15)
    // implies(0,anything)=tautology since NOT(0)=15 => 15|b=15
    cki("lop_implies(0,0,2)", lop_implies(0, 0, 2), 15)
    cki("lop_implies(0,15,2)", lop_implies(0, 15, 2), 15)
    // implies(15,0)=NOT(15)|0=0|0=0
    cki("lop_implies(15,0,2)", lop_implies(15, 0, 2), 0)
    // iff(a,a)=NOT(XOR(a,a))=NOT(0)=15 for all a
    cki("lop_iff(10,10,2)", lop_iff(10, 10, 2), 15)
    cki("lop_iff(0,0,2)", lop_iff(0, 0, 2), 15)
    // iff(a,NOT a) = NOT(XOR(a,NOT a)) = NOT(15) = 0
    cki("lop_iff(10,5,2)", lop_iff(10, 5, 2), 0)

    // === n=3 spot-checks (mask=255) ===
    // NOT of x0 in n=3: lop_not(170,3) = 255-170 = 85 (0b01010101)
    cki("lop_not(170,3)", lop_not(170, 3), 85)
    // AND of x0 AND x1 in n=3: assignments where bit0=1 AND bit1=1 i.e. i in {3,7}
    // 3=0b011 7=0b111 => bits 3,7 set => 0b10001000 = 136
    cki("lop_and(170,204,n3)", lop_and(170, 204), 136)
    // OR of x0 OR x1: assignments where bit0=1 OR bit1=1 => i in {1,2,3,5,6,7} => 0b11101110 = 238
    cki("lop_or(170,204,n3)", lop_or(170, 204), 238)

    print("PASS _logic_ops_test")
