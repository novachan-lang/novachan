// KAT for std/text/patch_reverse
import std/text/patch_reverse

// ── Helpers ──────────────────────────────────────────────────────────────────

fn _list_eq(a, b)
    if len(a) != len(b)
        return 0
    let i = 0
    while i < len(a)
        // Each element is a 2-element list [tag, line]
        let ea = a[i]
        let eb = b[i]
        if len(ea) != len(eb)
            return 0
        if ea[0] != eb[0]
            return 0
        if ea[1] != eb[1]
            return 0
        i = i + 1
    return 1

fn _script_str(s)
    let out = "["
    let i = 0
    while i < len(s)
        if i > 0
            out = out + ","
        out = out + "[" + s[i][0] + "," + s[i][1] + "]"
        i = i + 1
    out + "]"

fn _fail_script(label, got, want)
    print("FAIL " + label + " got=" + _script_str(got) + " want=" + _script_str(want))
    exit(1)

fn _fail_str(label, got, want)
    print("FAIL " + label + " got=" + got + " want=" + want)
    exit(1)

fn _make_op(tag, line)
    let op = []
    op.push(tag)
    op.push(line)
    op

// ── KAT 1: basic reverse_script ──────────────────────────────────────────────
fn main()
    let nl = chr(10)

    // KAT 1a: spec vector from task description
    let s1 = []
    s1.push(_make_op("=", "a"))
    s1.push(_make_op("-", "b"))
    s1.push(_make_op("+", "x"))
    let got1 = reverse_script(s1)
    let want1 = []
    want1.push(_make_op("=", "a"))
    want1.push(_make_op("+", "b"))
    want1.push(_make_op("-", "x"))
    if _list_eq(got1, want1) == 0
        _fail_script("KAT1a reverse_script basic", got1, want1)

    // KAT 1b: empty script
    let s2 = []
    let got2 = reverse_script(s2)
    if len(got2) != 0
        print("FAIL KAT1b reverse_script empty: got len=" + str(len(got2)) + " want 0")
        exit(1)

    // KAT 1c: all "=" — unchanged
    let s3 = []
    s3.push(_make_op("=", "foo"))
    s3.push(_make_op("=", "bar"))
    let got3 = reverse_script(s3)
    let want3 = []
    want3.push(_make_op("=", "foo"))
    want3.push(_make_op("=", "bar"))
    if _list_eq(got3, want3) == 0
        _fail_script("KAT1c reverse_script all-equal", got3, want3)

    // KAT 1d: input not mutated
    let s4 = []
    s4.push(_make_op("-", "x"))
    s4.push(_make_op("+", "y"))
    let got4 = reverse_script(s4)
    // original s4 must be unchanged
    if s4[0][0] != "-"
        print("FAIL KAT1d: reverse_script mutated input s4[0][0]=" + s4[0][0])
        exit(1)
    if got4[0][0] != "+"
        print("FAIL KAT1d: got4[0][0]=" + got4[0][0] + " want +")
        exit(1)

    // ── KAT 2: double-reverse is identity ─────────────────────────────────────
    let s5 = []
    s5.push(_make_op("=", "ctx"))
    s5.push(_make_op("-", "old"))
    s5.push(_make_op("+", "new"))
    s5.push(_make_op("=", "end"))
    let got5 = reverse_script(reverse_script(s5))
    if _list_eq(got5, s5) == 0
        _fail_script("KAT2 double-reverse identity", got5, s5)

    // ── KAT 3: patch_reverse — empty input ────────────────────────────────────
    let got3p = patch_reverse("")
    if got3p != ""
        _fail_str("KAT3 patch_reverse empty", got3p, "")

    // ── KAT 4: patch_reverse — unified diff, +/- swap ─────────────────────────
    // A minimal unified diff (no file headers):
    //   @@ -1,2 +1,2 @@
    //    ctx
    //   -old
    //   +new
    let diff4 = "@@ -1,3 +1,3 @@" + nl + " ctx" + nl + "-old" + nl + "+new"
    let got4p = patch_reverse(diff4)
    // Expected reversed: @@ -1,3 +1,3 @@ (counts stay: a_count=3,b_count=3 swap to same)
    // Actually a_start=1 a_count=3 b_start=1 b_count=3 -> reversed: @@ -1,3 +1,3 @@
    // body: " ctx" stays, "+old", "-new"
    let want4 = "@@ -1,3 +1,3 @@" + nl + " ctx" + nl + "+old" + nl + "-new"
    if got4p != want4
        _fail_str("KAT4 patch_reverse body swap", got4p, want4)

    // ── KAT 5: patch_reverse — file headers swapped ───────────────────────────
    let diff5 = "--- a/foo.txt" + nl + "+++ b/foo.txt" + nl + "@@ -1,1 +1,1 @@" + nl + "-old" + nl + "+new"
    let got5p = patch_reverse(diff5)
    let want5 = "--- b/foo.txt" + nl + "+++ a/foo.txt" + nl + "@@ -1,1 +1,1 @@" + nl + "+old" + nl + "-new"
    if got5p != want5
        _fail_str("KAT5 patch_reverse file-headers", got5p, want5)

    // ── KAT 6: patch_reverse — hunk line numbers swapped ──────────────────────
    // A diff where a-side and b-side start at different lines.
    // @@ -3,2 +5,3 @@
    //  ctx
    // -del
    // +ins1
    // +ins2
    // Reversed: @@ -5,3 +3,2 @@  (b becomes a, a becomes b)
    //  ctx
    // +del    (was delete, now insert)
    // -ins1   (was insert, now delete)
    // -ins2   (was insert, now delete)
    let diff6 = "@@ -3,2 +5,3 @@" + nl + " ctx" + nl + "-del" + nl + "+ins1" + nl + "+ins2"
    let got6p = patch_reverse(diff6)
    let want6 = "@@ -5,3 +3,2 @@" + nl + " ctx" + nl + "+del" + nl + "-ins1" + nl + "-ins2"
    if got6p != want6
        _fail_str("KAT6 patch_reverse hunk-line-numbers", got6p, want6)

    // ── KAT 7: patch_reverse double-reverse is identity ───────────────────────
    let diff7 = "--- a/x" + nl + "+++ b/x" + nl + "@@ -1,3 +1,3 @@" + nl + " keep" + nl + "-rem" + nl + "+add"
    let got7 = patch_reverse(patch_reverse(diff7))
    if got7 != diff7
        _fail_str("KAT7 patch_reverse double-reverse identity", got7, diff7)

    // ── KAT 8: multi-hunk diff ────────────────────────────────────────────────
    let diff8 = "@@ -1,1 +1,1 @@" + nl + "-a" + nl + "+b" + nl + "@@ -10,1 +10,1 @@" + nl + "-c" + nl + "+d"
    let got8 = patch_reverse(diff8)
    let want8 = "@@ -1,1 +1,1 @@" + nl + "+a" + nl + "-b" + nl + "@@ -10,1 +10,1 @@" + nl + "+c" + nl + "-d"
    if got8 != want8
        _fail_str("KAT8 patch_reverse multi-hunk", got8, want8)

    // ── KAT 9: patch_reverse double-reverse of multi-hunk diff ───────────────
    let got9 = patch_reverse(patch_reverse(diff8))
    if got9 != diff8
        _fail_str("KAT9 patch_reverse multi-hunk double-reverse", got9, diff8)

    print("PASS _patch_reverse_test")
