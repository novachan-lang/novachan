// KAT for std/money/currency — ISO 4217 currency metadata.
import std/money/currency

fn cki(label, got, want)
    if got != want
        print("FAIL _currency_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL _currency_test " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL _currency_test " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn main()
    // cur_decimals
    cki("dec_usd", cur_decimals("USD"), 2)
    cki("dec_eur", cur_decimals("EUR"), 2)
    cki("dec_gbp", cur_decimals("GBP"), 2)
    cki("dec_jpy", cur_decimals("JPY"), 0)
    cki("dec_krw", cur_decimals("KRW"), 0)
    cki("dec_bhd", cur_decimals("BHD"), 3)
    cki("dec_kwd", cur_decimals("KWD"), 3)
    cki("dec_omr", cur_decimals("OMR"), 3)
    cki("dec_unk", cur_decimals("XYZ"), -1)

    // cur_symbol
    cks("sym_usd", cur_symbol("USD"), "$")
    cks("sym_fallback", cur_symbol("XYZ"), "XYZ")

    // cur_is_valid
    ckb("valid_usd", cur_is_valid("USD"), true)
    ckb("valid_xyz", cur_is_valid("XYZ"), false)
    ckb("valid_jpy", cur_is_valid("JPY"), true)
    ckb("valid_bhd", cur_is_valid("BHD"), true)

    // cur_minor_per_major
    cki("mpm_usd", cur_minor_per_major("USD"), 100)
    cki("mpm_jpy", cur_minor_per_major("JPY"), 1)
    cki("mpm_bhd", cur_minor_per_major("BHD"), 1000)
    cki("mpm_eur", cur_minor_per_major("EUR"), 100)

    // cur_name — just check non-empty for known codes
    let usd_name = cur_name("USD")
    if len(usd_name) == 0
        print("FAIL _currency_test name_usd: empty name")
        exit(1)
    let xyz_name = cur_name("XYZ")
    if len(xyz_name) != 0
        print("FAIL _currency_test name_xyz: expected empty got '" + xyz_name + "'")
        exit(1)

    // cur_codes — must contain at least 30 codes
    let codes = cur_codes()
    if len(codes) < 30
        print("FAIL _currency_test codes_len: got " + str(len(codes)) + " want >=30")
        exit(1)

    // cur_symbol_or_code — same as cur_symbol
    cks("soc_usd", cur_symbol_or_code("USD"), "$")
    cks("soc_xyz", cur_symbol_or_code("ZZZ"), "ZZZ")

    print("PASS _currency_test")
