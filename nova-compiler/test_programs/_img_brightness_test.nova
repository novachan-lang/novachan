// KAT for std/image/img_brightness — brightness and invert ops.
import std/image/img_brightness

fn chk_list(label: str, got: list, want: list)
    let ng = len(got)
    let nw = len(want)
    if ng != nw
        print("FAIL " + label + " len: got " + str(ng) + " want " + str(nw))
        exit(1)
    let i = 0
    while i < nw
        let gv = got[i]
        let wv = want[i]
        if gv != wv
            print("FAIL " + label + "[" + str(i) + "]: got " + str(gv) + " want " + str(wv))
            exit(1)
        i = i + 1

fn main()
    // KAT 1: img_brightness([100,200], 50) == [150,250]
    let px1 = []
    px1.push(100)
    px1.push(200)
    let b1 = img_brightness(px1, 50)
    let w1 = []
    w1.push(150)
    w1.push(250)
    chk_list("brightness_no_clamp", b1, w1)

    // KAT 2: img_brightness([100,240], 50) == [150,255]  (clamped)
    let px2 = []
    px2.push(100)
    px2.push(240)
    let b2 = img_brightness(px2, 50)
    let w2 = []
    w2.push(150)
    w2.push(255)
    chk_list("brightness_clamp_high", b2, w2)

    // KAT 3: img_brightness([50,10], -100) == [0,0]  (clamped low)
    let px3 = []
    px3.push(50)
    px3.push(10)
    let b3 = img_brightness(px3, -100)
    let w3 = []
    w3.push(0)
    w3.push(0)
    chk_list("brightness_clamp_low", b3, w3)

    // KAT 4: img_invert([0,255,128]) == [255,0,127]
    let px4 = []
    px4.push(0)
    px4.push(255)
    px4.push(128)
    let inv4 = img_invert(px4)
    let w4 = []
    w4.push(255)
    w4.push(0)
    w4.push(127)
    chk_list("invert_basic", inv4, w4)

    // KAT 5: img_brightness([255], 0) == [255]  (identity)
    let px5 = []
    px5.push(255)
    let b5 = img_brightness(px5, 0)
    let w5 = []
    w5.push(255)
    chk_list("brightness_identity", b5, w5)

    // KAT 6: img_invert([0]) == [255]  (full invert)
    let px6 = []
    px6.push(0)
    let inv6 = img_invert(px6)
    let w6 = []
    w6.push(255)
    chk_list("invert_zero", inv6, w6)

    // KAT 7: double invert round-trip: invert(invert([100,200])) == [100,200]
    let px7 = []
    px7.push(100)
    px7.push(200)
    let inv7a = img_invert(px7)
    let inv7b = img_invert(inv7a)
    let w7 = []
    w7.push(100)
    w7.push(200)
    chk_list("invert_roundtrip", inv7b, w7)

    print("PASS _img_brightness_test")
