// ══════════════════════════════════════════════════════════════════════════════
// NOVA IR → LLVM IR Emitter
//
// Takes structured IR (IrModule/IrFunction/IrBlock/IrInst) and emits
// LLVM IR text. This replaces direct AST→text codegen with a clean
// two-phase approach: AST→IR (typed, optimizable) then IR→LLVM (mechanical).
//
// Key advantage: the emitter makes decisions based on IR types:
// - IrType("int") + "add" → `add i64 %a, %b` (direct, zero overhead)
// - IrType("str") + "add" → `call @nova_rt_str_concat` (runtime)
// - IrType("any") + "add" → `call @nova_rt_add` (generic runtime)
// ══════════════════════════════════════════════════════════════════════════════

// ── IR Types (shared with nova_ir.nova) ──────────────────────────────────────

type IrType
    kind: string
    name: string
    params: list
    id: int

type IrInst
    op: string
    dest: string
    type: IrType
    args: list
    value: string
    num: int
    effect: string

type IrBlock
    label: string
    insts: list
    terminator: IrInst

type IrParam
    name: string
    type: IrType

type IrFunction
    name: string
    params: list
    ret_type: IrType
    blocks: list
    type_params: list
    is_extern: int

type IrModule
    functions: list
    structs: list
    globals: list
    string_constants: list

// ── Emitter State ────────────────────────────────────────────────────────────

type LlvmEmitter
    output: list
    strings: list
    str_map: dict
    str_count: int

fn new_emitter() -> LlvmEmitter
    LlvmEmitter([], [], {}, 0)

fn emit_line(e: LlvmEmitter, line: string)
    push(e.output, line)

fn emit_indent_line(e: LlvmEmitter, line: string)
    push(e.output, "  " + line)

fn intern_string_lit(e: LlvmEmitter, s: string) -> string
    if contains(e.str_map, s)
        return e.str_map[s]
    let escaped = llvm_escape(s)
    let name = "@.str." + str(e.str_count)
    e.str_count = e.str_count + 1
    let byte_len = len(s) + 1
    push(e.strings, name + " = private unnamed_addr constant [" + str(byte_len) + " x i8] c\"" + escaped + "\\00\"")
    e.str_map[s] = name
    name

fn llvm_escape(s: string) -> string
    let result = ""
    let i = 0
    while i < len(s)
        let ch = s[i]
        if ch == "\n"
            result = result + "\\0A"
        else if ch == "\r"
            result = result + "\\0D"
        else if ch == "\t"
            result = result + "\\09"
        else if ch == "\0"
            result = result + "\\00"
        else if ch == "\\"
            result = result + "\\\\"
        else if ch == "\""
            result = result + "\\22"
        else
            result = result + ch
        i = i + 1
    result

// ── Emit a single instruction ────────────────────────────────────────────────

fn emit_inst(e: LlvmEmitter, inst: IrInst)
    match inst
        IrInst(op, dest, typ, args, value, num, effect) =>
            if op == "const_int"
                // No-op in LLVM — integer constants are used inline
                // But we track the value for later use
                emit_indent_line(e, "; " + dest + " = " + str(num))
            else if op == "const_str"
                let str_name = intern_string_lit(e, value)
                let byte_len = len(value) + 1
                emit_indent_line(e, dest + " = getelementptr inbounds [" + str(byte_len) + " x i8], ptr " + str_name + ", i64 0, i64 0")
                let dest2 = dest + ".i"
                emit_indent_line(e, dest2 + " = ptrtoint ptr " + dest + " to i64")
            else if op == "add"
                match typ
                    IrType(tk, tn, tp, tid) =>
                        if tk == "int"
                            // DIRECT integer add — zero overhead!
                            emit_indent_line(e, dest + " = add i64 " + args[0] + ", " + args[1])
                        else if tk == "str"
                            emit_indent_line(e, dest + " = call i64 @nova_rt_str_concat(i64 " + args[0] + ", i64 " + args[1] + ")")
                        else
                            // Generic: could be int or string, use runtime
                            emit_indent_line(e, dest + " = call i64 @nova_rt_add(i64 " + args[0] + ", i64 " + args[1] + ")")
            else if op == "sub"
                emit_indent_line(e, dest + " = sub i64 " + args[0] + ", " + args[1])
            else if op == "mul"
                emit_indent_line(e, dest + " = mul i64 " + args[0] + ", " + args[1])
            else if op == "div"
                emit_indent_line(e, dest + " = sdiv i64 " + args[0] + ", " + args[1])
            else if op == "mod"
                emit_indent_line(e, dest + " = srem i64 " + args[0] + ", " + args[1])
            else if op == "neg"
                emit_indent_line(e, dest + " = sub i64 0, " + args[0])
            else if op == "eq"
                let tmp = dest + ".cmp"
                emit_indent_line(e, tmp + " = icmp eq i64 " + args[0] + ", " + args[1])
                emit_indent_line(e, dest + " = zext i1 " + tmp + " to i64")
            else if op == "neq"
                let tmp = dest + ".cmp"
                emit_indent_line(e, tmp + " = icmp ne i64 " + args[0] + ", " + args[1])
                emit_indent_line(e, dest + " = zext i1 " + tmp + " to i64")
            else if op == "lt"
                let tmp = dest + ".cmp"
                emit_indent_line(e, tmp + " = icmp slt i64 " + args[0] + ", " + args[1])
                emit_indent_line(e, dest + " = zext i1 " + tmp + " to i64")
            else if op == "le"
                let tmp = dest + ".cmp"
                emit_indent_line(e, tmp + " = icmp sle i64 " + args[0] + ", " + args[1])
                emit_indent_line(e, dest + " = zext i1 " + tmp + " to i64")
            else if op == "gt"
                let tmp = dest + ".cmp"
                emit_indent_line(e, tmp + " = icmp sgt i64 " + args[0] + ", " + args[1])
                emit_indent_line(e, dest + " = zext i1 " + tmp + " to i64")
            else if op == "ge"
                let tmp = dest + ".cmp"
                emit_indent_line(e, tmp + " = icmp sge i64 " + args[0] + ", " + args[1])
                emit_indent_line(e, dest + " = zext i1 " + tmp + " to i64")
            else if op == "not"
                let tmp = dest + ".cmp"
                emit_indent_line(e, tmp + " = icmp eq i64 " + args[0] + ", 0")
                emit_indent_line(e, dest + " = zext i1 " + tmp + " to i64")
            else if op == "slot_load"
                emit_indent_line(e, dest + " = load i64, ptr %slot." + value + ", align 8")
            else if op == "slot_store"
                emit_indent_line(e, "store i64 " + args[0] + ", ptr %slot." + value + ", align 8")
            else if op == "call"
                let call_str = "call i64 @" + value + "("
                let i = 0
                while i < len(args)
                    if i > 0
                        call_str = call_str + ", "
                    call_str = call_str + "i64 " + args[i]
                    i = i + 1
                call_str = call_str + ")"
                if dest != ""
                    emit_indent_line(e, dest + " = " + call_str)
                else
                    emit_indent_line(e, call_str)
            else if op == "call_direct"
                let call_str = "call i64 @" + value + "("
                let i = 0
                while i < len(args)
                    if i > 0
                        call_str = call_str + ", "
                    call_str = call_str + "i64 " + args[i]
                    i = i + 1
                call_str = call_str + ") nounwind"
                if dest != ""
                    emit_indent_line(e, dest + " = " + call_str)
                else
                    emit_indent_line(e, call_str)
            else if op == "make_struct"
                let size = num * 8
                emit_indent_line(e, dest + ".ptr = call ptr @nova_rt_struct_alloc(i64 " + str(size) + ")")
                let fi = 0
                while fi < len(args)
                    let gep = dest + ".f" + str(fi)
                    emit_indent_line(e, gep + " = getelementptr i64, ptr " + dest + ".ptr, i64 " + str(fi))
                    emit_indent_line(e, "store i64 " + args[fi] + ", ptr " + gep + ", align 8")
                    fi = fi + 1
                emit_indent_line(e, dest + " = ptrtoint ptr " + dest + ".ptr to i64")
            else if op == "field_get"
                let ptr_name = dest + ".ptr"
                emit_indent_line(e, ptr_name + " = inttoptr i64 " + args[0] + " to ptr")
                let gep = dest + ".gep"
                emit_indent_line(e, gep + " = getelementptr i64, ptr " + ptr_name + ", i64 " + str(num))
                emit_indent_line(e, dest + " = load i64, ptr " + gep + ", align 8")
            else if op == "field_set"
                let ptr_name = dest + ".ptr"
                if dest == ""
                    let ptr_name2 = "%fs_ptr"
                    emit_indent_line(e, ptr_name2 + " = inttoptr i64 " + args[0] + " to ptr")
                    let gep = "%fs_gep"
                    emit_indent_line(e, gep + " = getelementptr i64, ptr " + ptr_name2 + ", i64 " + str(num))
                    emit_indent_line(e, "store i64 " + args[1] + ", ptr " + gep + ", align 8")
            else if op == "index_get"
                emit_indent_line(e, dest + " = call i64 @nova_rt_index_get(i64 " + args[0] + ", i64 " + args[1] + ")")
            else if op == "index_set"
                emit_indent_line(e, "call i64 @nova_rt_index_set(i64 " + args[0] + ", i64 " + args[1] + ", i64 " + args[2] + ")")
            else if op == "make_list"
                emit_indent_line(e, dest + " = call i64 @nova_rt_list_create()")
                let i = 0
                while i < len(args)
                    emit_indent_line(e, "call i64 @nova_rt_list_append(i64 " + dest + ", i64 " + args[i] + ")")
                    i = i + 1
            else if op == "make_dict"
                emit_indent_line(e, dest + " = call i64 @nova_rt_dict_create()")
            else if op == "rc_inc"
                emit_indent_line(e, "call void @nova_rc_inc(i64 " + args[0] + ")")
            else if op == "rc_dec"
                emit_indent_line(e, "call void @nova_rc_dec(i64 " + args[0] + ")")
            else if op == "spawn"
                emit_indent_line(e, dest + " = call i64 @nova_rt_spawn(i64 " + args[0] + ")")
            else if op == "chan_create"
                emit_indent_line(e, dest + " = call i64 @nova_rt_channel_create()")
            else if op == "chan_send"
                emit_indent_line(e, "call void @nova_rt_channel_send(i64 " + args[0] + ", i64 " + args[1] + ")")
            else if op == "chan_recv"
                emit_indent_line(e, dest + " = call i64 @nova_rt_channel_receive(i64 " + args[0] + ")")

fn emit_terminator(e: LlvmEmitter, term: IrInst)
    match term
        IrInst(op, dest, typ, args, value, num, effect) =>
            if op == "return"
                if len(args) > 0
                    emit_indent_line(e, "ret i64 " + args[0])
                else
                    emit_indent_line(e, "ret i64 0")
            else if op == "goto"
                emit_indent_line(e, "br label %" + value)
            else if op == "branch"
                // args[0] = condition, args[1] = else_label, value = then_label
                let cond_cmp = value + ".br"
                emit_indent_line(e, cond_cmp + " = icmp ne i64 " + args[0] + ", 0")
                emit_indent_line(e, "br i1 " + cond_cmp + ", label %" + value + ", label %" + args[1])

// ── Emit a full function ─────────────────────────────────────────────────────

fn emit_function(e: LlvmEmitter, func: IrFunction)
    match func
        IrFunction(name, params, ret_type, blocks, type_params, is_extern) =>
            if is_extern == 1
                // External declaration
                let decl = "declare i64 @" + name + "("
                let i = 0
                while i < len(params)
                    if i > 0
                        decl = decl + ", "
                    decl = decl + "i64"
                    i = i + 1
                decl = decl + ") nounwind"
                emit_line(e, decl)
                return 0
            // Function definition
            let header = "define i64 @" + name + "("
            let i = 0
            while i < len(params)
                if i > 0
                    header = header + ", "
                header = header + "i64 %p" + str(i)
                i = i + 1
            header = header + ") nounwind {"
            emit_line(e, header)
            // Emit blocks
            for block in blocks
                match block
                    IrBlock(label, insts, terminator) =>
                        emit_line(e, label + ":")
                        // Store params into slots (first block only)
                        if label == "entry"
                            let pi = 0
                            while pi < len(params)
                                match params[pi]
                                    IrParam(pname, ptype) =>
                                        emit_indent_line(e, "%slot." + pname + " = alloca i64, align 8")
                                        emit_indent_line(e, "store i64 %p" + str(pi) + ", ptr %slot." + pname + ", align 8")
                                pi = pi + 1
                        for inst in insts
                            emit_inst(e, inst)
                        emit_terminator(e, terminator)
            emit_line(e, "}")
            emit_line(e, "")

// ── Test: Emit a complete add function ───────────────────────────────────────

fn ir_type_int() -> IrType
    IrType("int", "", [], 0)

fn ir_type_void() -> IrType
    IrType("void", "", [], 0)

fn ir_type_any() -> IrType
    IrType("any", "", [], 0)

fn ir_inst(op: string, dest: string, typ: IrType, args: list, value: string, num: int) -> IrInst
    IrInst(op, dest, typ, args, value, num, "pure")

fn test_emit()
    let e = new_emitter()
    // Build IR for: fn add(a, b) -> a + b
    let insts = []
    push(insts, ir_inst("slot_load", "%r0", ir_type_int(), [], "a", 0))
    push(insts, ir_inst("slot_load", "%r1", ir_type_int(), [], "b", 0))
    push(insts, ir_inst("add", "%r2", ir_type_int(), ["%r0", "%r1"], "+", 0))
    let term = ir_inst("return", "", ir_type_void(), ["%r2"], "", 0)
    let entry = IrBlock("entry", insts, term)
    let params = [IrParam("a", ir_type_int()), IrParam("b", ir_type_int())]
    let add_fn = IrFunction("add", params, ir_type_int(), [entry], [], 0)
    emit_function(e, add_fn)
    // Print the output
    for line in e.output
        print(line)
    // Verify it contains direct 'add i64' (not nova_rt_add)
    let found_direct_add = false
    for line in e.output
        if contains(line, "add i64")
            found_direct_add = true
    if found_direct_add
        print("PASS: Emitted direct 'add i64' (zero-cost arithmetic)")
    else
        print("FAIL: Did not emit direct add")

test_emit()
