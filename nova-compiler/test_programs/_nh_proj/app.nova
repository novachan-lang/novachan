// Out-of-tree project: imports forge with NO local copy. Resolves only via $NOVA_HOME/lib.
// This is the shape of a future `nova new --api` project.
import forge

fn h(req: Request) -> string
    "from-nova-home"

fn main()
    let a = forge.app()
    forge.get(a, "/x", h)
    let r: Response = forge.dispatch_req(a, forge.build_request("GET /x HTTP/1.1\r\n\r\n", 0))
    print("status=" + str(r.status) + " body=" + r.body)
