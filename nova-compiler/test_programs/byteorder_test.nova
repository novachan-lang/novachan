// Network byte-order builtins (cat-13): htons/htonl convert host<->network (big-endian)
// order for raw protocol code; ntohs/ntohl are the inverse. On a little-endian host
// (x86/ARM, where this runs) they byte-swap; on big-endian they are identity. The
// genius compiler picks the right thing per target with zero ceremony.

fn main()
    // little-endian host: 16-bit swap
    assert_eq(htons(1), 256)                 // 0x0001 -> 0x0100
    assert_eq(htons(256), 1)                 // 0x0100 -> 0x0001
    assert_eq(ntohs(256), 1)                 // inverse is the same swap
    // 32-bit swap
    assert_eq(htonl(1), 16777216)            // 0x00000001 -> 0x01000000
    assert_eq(htonl(16777216), 1)
    assert_eq(ntohl(16777216), 1)
    // round-trips (endianness-agnostic correctness)
    assert_eq(ntohs(htons(43981)), 43981)            // 0xABCD
    assert_eq(ntohl(htonl(305419896)), 305419896)    // 0x12345678
    assert_eq(htons(htons(4660)), 4660)              // double-swap is identity
    assert_eq(htonl(htonl(2018915346)), 2018915346)  // 0x78563412
    print("byteorder_test passed")
