import std/net/dhcphdr

fn main()
    // ── Build the chaddr bytes (16 bytes, byte0=0x00 byte1=0x0B rest=0) ─────────
    let chaddr = bytes(16)
    bytes_set(chaddr, 0, 0x00)
    bytes_set(chaddr, 1, 0x0B)

    // ── Vector 1: dhcp_encode on a known DISCOVER-like packet ────────────────────
    // xid = 0x3903F326, flags = 0x8000 (broadcast), all IPs = 0
    let h1 = {"op": 1, "htype": 1, "hlen": 6, "hops": 0, "xid": 0x3903F326, "secs": 0, "flags": 0x8000, "ciaddr": 0, "yiaddr": 0, "siaddr": 0, "giaddr": 0, "chaddr": chaddr}
    let enc1 = dhcp_encode(h1)

    // Length must be exactly 240
    let got_len = bytes_len(enc1)
    if got_len != 240
        print("FAIL dhcphdr encode-len: got "+str(got_len)+" want 240")
        exit(1)

    // byte[0] == op == 1
    let got_b0 = bytes_get(enc1, 0)
    if got_b0 != 1
        print("FAIL dhcphdr byte[0] op: got "+str(got_b0)+" want 1")
        exit(1)

    // byte[1] == htype == 1
    let got_b1 = bytes_get(enc1, 1)
    if got_b1 != 1
        print("FAIL dhcphdr byte[1] htype: got "+str(got_b1)+" want 1")
        exit(1)

    // byte[2] == hlen == 6
    let got_b2 = bytes_get(enc1, 2)
    if got_b2 != 6
        print("FAIL dhcphdr byte[2] hlen: got "+str(got_b2)+" want 6")
        exit(1)

    // u32@4 == xid == 0x3903F326
    let got_xid_hi = (bytes_get(enc1, 4) << 24) | (bytes_get(enc1, 5) << 16)
    let got_xid_lo = (bytes_get(enc1, 6) << 8) | bytes_get(enc1, 7)
    let got_xid = (got_xid_hi | got_xid_lo) & 0xFFFFFFFF
    if got_xid != 0x3903F326
        print("FAIL dhcphdr xid: got "+str(got_xid)+" want 956899110")
        exit(1)

    // u16@10 == flags == 0x8000
    let got_flags = ((bytes_get(enc1, 10) << 8) | bytes_get(enc1, 11)) & 0xFFFF
    if got_flags != 0x8000
        print("FAIL dhcphdr flags: got "+str(got_flags)+" want 32768")
        exit(1)

    // chaddr at bytes 28..43: byte[28] == 0x00, byte[29] == 0x0B
    let got_ch0 = bytes_get(enc1, 28)
    if got_ch0 != 0x00
        print("FAIL dhcphdr chaddr[0]: got "+str(got_ch0)+" want 0")
        exit(1)
    let got_ch1 = bytes_get(enc1, 29)
    if got_ch1 != 0x0B
        print("FAIL dhcphdr chaddr[1]: got "+str(got_ch1)+" want 11")
        exit(1)
    // remaining chaddr bytes must be zero
    let got_ch2 = bytes_get(enc1, 30)
    if got_ch2 != 0
        print("FAIL dhcphdr chaddr[2]: got "+str(got_ch2)+" want 0")
        exit(1)

    // sname field bytes 44..107 — all zero (not provided)
    let got_sn0 = bytes_get(enc1, 44)
    if got_sn0 != 0
        print("FAIL dhcphdr sname[0]: got "+str(got_sn0)+" want 0")
        exit(1)
    let got_sn63 = bytes_get(enc1, 107)
    if got_sn63 != 0
        print("FAIL dhcphdr sname[63]: got "+str(got_sn63)+" want 0")
        exit(1)

    // file field bytes 108..235 — all zero (not provided)
    let got_fi0 = bytes_get(enc1, 108)
    if got_fi0 != 0
        print("FAIL dhcphdr file[0]: got "+str(got_fi0)+" want 0")
        exit(1)
    let got_fi127 = bytes_get(enc1, 235)
    if got_fi127 != 0
        print("FAIL dhcphdr file[127]: got "+str(got_fi127)+" want 0")
        exit(1)

    // magic_cookie u32@236 == 0x63825363
    let got_mc_hi = (bytes_get(enc1, 236) << 24) | (bytes_get(enc1, 237) << 16)
    let got_mc_lo = (bytes_get(enc1, 238) << 8) | bytes_get(enc1, 239)
    let got_mc = (got_mc_hi | got_mc_lo) & 0xFFFFFFFF
    if got_mc != 0x63825363
        print("FAIL dhcphdr magic_cookie: got "+str(got_mc)+" want 1670007651")
        exit(1)

    // ── Vector 2: encode -> decode round-trip ─────────────────────────────────
    let dec1 = dhcp_decode(enc1)

    let got_op = dec1["op"]
    if got_op != 1
        print("FAIL dhcphdr decode op: got "+str(got_op)+" want 1")
        exit(1)

    let got_xid2 = dec1["xid"]
    if got_xid2 != 0x3903F326
        print("FAIL dhcphdr decode xid: got "+str(got_xid2)+" want 956899110")
        exit(1)

    let got_flags2 = dec1["flags"]
    if got_flags2 != 0x8000
        print("FAIL dhcphdr decode flags: got "+str(got_flags2)+" want 32768")
        exit(1)

    let got_mc2 = dec1["magic_cookie"]
    if got_mc2 != 0x63825363
        print("FAIL dhcphdr decode magic_cookie: got "+str(got_mc2)+" want 1670007651")
        exit(1)

    let got_htype = dec1["htype"]
    if got_htype != 1
        print("FAIL dhcphdr decode htype: got "+str(got_htype)+" want 1")
        exit(1)

    let got_hlen = dec1["hlen"]
    if got_hlen != 6
        print("FAIL dhcphdr decode hlen: got "+str(got_hlen)+" want 6")
        exit(1)

    let got_secs = dec1["secs"]
    if got_secs != 0
        print("FAIL dhcphdr decode secs: got "+str(got_secs)+" want 0")
        exit(1)

    let got_ci = dec1["ciaddr"]
    if got_ci != 0
        print("FAIL dhcphdr decode ciaddr: got "+str(got_ci)+" want 0")
        exit(1)

    // chaddr in decoded dict: byte[0]==0, byte[1]==0x0B
    let got_chaddr = dec1["chaddr"]
    let got_dch0 = bytes_get(got_chaddr, 0)
    if got_dch0 != 0
        print("FAIL dhcphdr decode chaddr[0]: got "+str(got_dch0)+" want 0")
        exit(1)
    let got_dch1 = bytes_get(got_chaddr, 1)
    if got_dch1 != 0x0B
        print("FAIL dhcphdr decode chaddr[1]: got "+str(got_dch1)+" want 11")
        exit(1)

    // ── Vector 3: REPLY with non-zero IP fields round-trips ───────────────────
    let h2 = {"op": 2, "htype": 1, "hlen": 6, "hops": 1, "xid": 0x12345678, "secs": 30, "flags": 0, "ciaddr": 0, "yiaddr": 0xC0A80164, "siaddr": 0xC0A80101, "giaddr": 0xC0A80102, "chaddr": chaddr}
    let enc2 = dhcp_encode(h2)
    if bytes_len(enc2) != 240
        print("FAIL dhcphdr v3 encode-len: got "+str(bytes_len(enc2))+" want 240")
        exit(1)
    let dec2 = dhcp_decode(enc2)
    let got_op2 = dec2["op"]
    if got_op2 != 2
        print("FAIL dhcphdr v3 op: got "+str(got_op2)+" want 2")
        exit(1)
    let got_yi = dec2["yiaddr"]
    if got_yi != 0xC0A80164
        print("FAIL dhcphdr v3 yiaddr: got "+str(got_yi)+" want 3232235876")
        exit(1)
    let got_si = dec2["siaddr"]
    if got_si != 0xC0A80101
        print("FAIL dhcphdr v3 siaddr: got "+str(got_si)+" want 3232235777")
        exit(1)
    let got_gi = dec2["giaddr"]
    if got_gi != 0xC0A80102
        print("FAIL dhcphdr v3 giaddr: got "+str(got_gi)+" want 3232235778")
        exit(1)
    let got_mc3 = dec2["magic_cookie"]
    if got_mc3 != 0x63825363
        print("FAIL dhcphdr v3 magic_cookie: got "+str(got_mc3)+" want 1670007651")
        exit(1)

    // ── Vector 4: short input decode returns empty dict (bounds safety) ────────
    let short_b = bytes(100)
    let dec_short = dhcp_decode(short_b)
    if contains(dec_short, "op")
        print("FAIL dhcphdr short-decode: expected empty dict but got op key")
        exit(1)

    // ── Vector 5: zero-length input returns empty dict ────────────────────────
    let empty_b = bytes(0)
    let dec_empty = dhcp_decode(empty_b)
    if contains(dec_empty, "xid")
        print("FAIL dhcphdr empty-decode: expected empty dict but got xid key")
        exit(1)

    // ── Vector 6: exactly 239 bytes (one short) returns empty dict ───────────
    let short239 = bytes(239)
    let dec239 = dhcp_decode(short239)
    if contains(dec239, "op")
        print("FAIL dhcphdr 239-decode: expected empty dict but got op key")
        exit(1)

    // ── Vector 7: missing dict keys default to 0 ─────────────────────────────
    let h_min = {"op": 1}
    let enc_min = dhcp_encode(h_min)
    if bytes_len(enc_min) != 240
        print("FAIL dhcphdr minimal encode-len: got "+str(bytes_len(enc_min))+" want 240")
        exit(1)
    let dec_min = dhcp_decode(enc_min)
    let got_min_op = dec_min["op"]
    if got_min_op != 1
        print("FAIL dhcphdr minimal op: got "+str(got_min_op)+" want 1")
        exit(1)
    let got_min_xid = dec_min["xid"]
    if got_min_xid != 0
        print("FAIL dhcphdr minimal xid: got "+str(got_min_xid)+" want 0")
        exit(1)
    let got_min_mc = dec_min["magic_cookie"]
    if got_min_mc != 0x63825363
        print("FAIL dhcphdr minimal magic_cookie: got "+str(got_min_mc)+" want 1670007651")
        exit(1)

    print("PASS _dhcphdr_test")
