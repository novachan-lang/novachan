// KAT test for std/audio/lfo.nova
// Hand-computed reference values:
//   lfo_value("sine", 0.25, 1.0, 0.0) = sin(2*PI*0.25) = sin(PI/2) = 1.0
//   lfo_value("sine", 0.0, 0.5, 0.5)  = 0.5 + 0.5*sin(0) = 0.5 + 0.0 = 0.5
//   lfo_value("sine", 0.75, 1.0, 0.0) = sin(3*PI/2) = -1.0
//   lfo_value("triangle", 0.25, 1.0, 0.0) = 0.25*4-1 = 0.0
//   lfo_value("triangle", 0.0, 1.0, 0.0)  = 0.0*4-1 = -1.0
//   lfo_value("triangle", 0.5, 1.0, 0.0)  = (1-0.5)*4-1 = 1.0
//   lfo_value("square", 0.25, 1.0, 0.0)   = +1.0 (phase<0.5)
//   lfo_value("square", 0.75, 1.0, 0.0)   = -1.0 (phase>=0.5)
//   lfo_value("square", 0.25, 1.0, 0.5)   = 0.5 + 1.0 = 1.5
//   lfo_value("square", 0.75, 1.0, 0.5)   = 0.5 - 1.0 = -0.5

import std/audio/lfo

fn approx(a: float, b: float, tol: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    let result = d < tol
    result

fn ckf(label: string, got: float, want: float)
    if approx(got, want, 0.0001) != true
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── SINE shape ────────────────────────────────────────────────────────────
    // KAT 1: sine at phase=0.25 => peak +1.0
    let r1 = lfo_value("sine", 0.25, 1.0, 0.0)
    ckf("sine_peak", r1, 1.0)

    // KAT 2: sine at phase=0.0, depth=0.5, center=0.5 => 0.5
    let r2 = lfo_value("sine", 0.0, 0.5, 0.5)
    ckf("sine_center_offset", r2, 0.5)

    // KAT 3: sine at phase=0.75 => trough -1.0
    let r3 = lfo_value("sine", 0.75, 1.0, 0.0)
    ckf("sine_trough", r3, 0.0 - 1.0)

    // KAT 4: sine at phase=0.5 => 0.0 (zero crossing)
    let r4 = lfo_value("sine", 0.5, 1.0, 0.0)
    ckf("sine_zero_cross", r4, 0.0)

    // KAT 5: sine with center shifts output
    let r5 = lfo_value("sine", 0.25, 2.0, 1.0)
    ckf("sine_center_scaled", r5, 3.0)

    // ── TRIANGLE shape ────────────────────────────────────────────────────────
    // KAT 6: triangle at phase=0.0 => -1.0
    let r6 = lfo_value("triangle", 0.0, 1.0, 0.0)
    ckf("tri_start", r6, 0.0 - 1.0)

    // KAT 7: triangle at phase=0.25 => 0.0 (midpoint of rising)
    let r7 = lfo_value("triangle", 0.25, 1.0, 0.0)
    ckf("tri_quarter", r7, 0.0)

    // KAT 8: triangle at phase=0.5 => +1.0 (peak)
    // phase=0.5 goes to else branch: (1.0-0.5)*4-1 = 2.0-1.0 = 1.0
    let r8 = lfo_value("triangle", 0.5, 1.0, 0.0)
    ckf("tri_peak", r8, 1.0)

    // KAT 9: triangle at phase=0.75 => 0.0 (midpoint of falling)
    // (1.0-0.75)*4-1 = 0.25*4-1 = 1.0-1.0 = 0.0
    let r9 = lfo_value("triangle", 0.75, 1.0, 0.0)
    ckf("tri_three_quarter", r9, 0.0)

    // ── SQUARE shape ──────────────────────────────────────────────────────────
    // KAT 10: square at phase=0.25 => center+depth
    let r10 = lfo_value("square", 0.25, 1.0, 0.0)
    ckf("square_high", r10, 1.0)

    // KAT 11: square at phase=0.75 => center-depth
    let r11 = lfo_value("square", 0.75, 1.0, 0.0)
    ckf("square_low", r11, 0.0 - 1.0)

    // KAT 12: square with center offset — high half
    let r12 = lfo_value("square", 0.25, 1.0, 0.5)
    ckf("square_high_offset", r12, 1.5)

    // KAT 13: square with center offset — low half
    let r13 = lfo_value("square", 0.75, 1.0, 0.5)
    ckf("square_low_offset", r13, 0.0 - 0.5)

    // KAT 14: depth=0 => output == center regardless of shape
    let r14a = lfo_value("sine", 0.25, 0.0, 3.0)
    ckf("depth_zero_sine", r14a, 3.0)
    let r14b = lfo_value("square", 0.25, 0.0, 3.0)
    ckf("depth_zero_square", r14b, 3.0)

    print("PASS _lfo_test")
