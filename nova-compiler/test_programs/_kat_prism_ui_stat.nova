// KAT for prism/ui/prism_ui_stat.nova (PRISM_ROADMAP.md milestone MB.13, dashboard stat/metric
// cards: single stat w/ prefix+suffix, trend, current-vs-previous comparison, titled card, and a
// responsive dashboard grid of cards).
//
// Proves, against concrete expected values (every depth/count is hand-computed from
// prism_node.nova's own `depth = max(child depths) + 1`, `count = 1 + sum(child counts)` rule,
// never guessed):
//   1. Direction: all 3 values map to a DISTINCT icon and the exhaustive name match is correct.
//   2. prism_st_stat: exact band/stack shape for all 4 prefix/suffix combinations (neither, prefix
//      only, suffix only, both) -- depth is constant at 3 across all 4, count varies 4/5/5/6
//      exactly as the child count changes; a present-but-blank Some("") prefix degrades to the
//      "neither" shape; rejects an empty st_label and an empty st_value.
//   3. prism_st_trend: exact stack(d=3,c=6) for up/down/flat, each producing a DISTINCT icon in the
//      value row's middle child; rejects an empty st_label/st_value/st_change (3 rejections).
//   4. prism_st_comparison: exact stack(d=3,c=6) with the literal "vs" separator in the middle of
//      the compare row; rejects an empty st_label/st_current/st_previous (3 rejections).
//   5. prism_st_card: exact stack(d=4,c=7) wrapping one stat child, exact stack(d=4,c=13) wrapping
//      two different-shaped children (proving the gap is 8 and fixed, and depth/count both compose
//      correctly over heterogeneous children); rejects an empty title, an empty children list, and
//      a non-PrismNode element (named by index and type).
//   6. prism_st_dashboard: exact flow(d=5,c=17) over two cards; rejects an empty list and a
//      non-PrismNode element (named by index and type).
//   7. Rejection tally: at least 8 distinct rejections proven above (13, counted explicitly).
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova into
// $NOVA_HOME/lib, so `import prism_node` / `import prism_ui_stat` resolve.
//   ./gen3_test.exe _kat_prism_ui_stat.nova
//   clang -O2 -o _kat_prism_ui_stat.exe _kat_prism_ui_stat.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_ui_stat.exe

import prism_node
import prism_content
import prism_ui_stat as st

let FAILED = [0]

fn _check(label: string, got: string, want: string)
    if got == want
        print("  pass  " + label)
    else
        print("  FAIL  " + label + "  got=" + got + "  want=" + want)
        FAILED[0] = FAILED[0] + 1

fn _check_true(label: string, cond: bool)
    if cond
        print("  pass  " + label)
    else
        print("  FAIL  " + label)
        FAILED[0] = FAILED[0] + 1

fn main()
    // ── 1. Direction: 3 distinct icons, exhaustive name match ───────────────────────────────────
    let dirs = [st.prism_st_up(), st.prism_st_down(), st.prism_st_flat()]
    _check("direction name: up", st.prism_st_direction_name(dirs[0]), "up")
    _check("direction name: down", st.prism_st_direction_name(dirs[1]), "down")
    _check("direction name: flat", st.prism_st_direction_name(dirs[2]), "flat")
    let dir_icon_names = []
    for d in dirs
        dir_icon_names.push(prism_content.prism_icon_name(st.prism_st_direction_icon(d)))
    _check("direction icon: up -> chevron_up", dir_icon_names[0], "chevron_up")
    _check("direction icon: down -> chevron_down", dir_icon_names[1], "chevron_down")
    _check("direction icon: flat -> minus", dir_icon_names[2], "minus")
    let seen_dir_icons = {}
    for nm in dir_icon_names
        seen_dir_icons[nm] = true
    _check("all 3 direction icons are pairwise distinct", str(len(seen_dir_icons.keys())), "3")
    print("")

    // ── 2. prism_st_stat: exact shape across neither/prefix/suffix/both, blank-degrade, rejects ──
    let stat_neither_r = st.prism_st_stat("Revenue", "$1.2M", none(), none())
    _check_true("stat (neither prefix nor suffix) constructs", is_ok(stat_neither_r))
    let stat_neither = unwrap(stat_neither_r)
    _check("stat(neither) kind_str", prism_node.prism_node_kind_str(stat_neither), "stack")
    _check("stat(neither) depth", str(prism_node.prism_node_depth(stat_neither)), "3")
    _check("stat(neither) count", str(prism_node.prism_node_count(stat_neither)), "4")
    let sn_kids = prism_node.prism_node_children(stat_neither)
    _check("stat(neither) child count", str(len(sn_kids)), "2")
    _check("stat(neither) value row kind_str", prism_node.prism_node_kind_str(sn_kids[0]), "band")
    _check("stat(neither) label text", prism_node.prism_node_attr_str(sn_kids[1], "text", ""), "Revenue")
    let sn_row_kids = prism_node.prism_node_children(sn_kids[0])
    _check("stat(neither) value row child count", str(len(sn_row_kids)), "1")
    _check("stat(neither) value text", prism_node.prism_node_attr_str(sn_row_kids[0], "text", ""), "$1.2M")

    let stat_prefix_r = st.prism_st_stat("Revenue", "1.2M", some("$"), none())
    _check_true("stat (prefix only) constructs", is_ok(stat_prefix_r))
    let stat_prefix = unwrap(stat_prefix_r)
    _check("stat(prefix) depth", str(prism_node.prism_node_depth(stat_prefix)), "3")
    _check("stat(prefix) count", str(prism_node.prism_node_count(stat_prefix)), "5")
    let sp_row_kids = prism_node.prism_node_children(prism_node.prism_node_children(stat_prefix)[0])
    _check("stat(prefix) value row child count", str(len(sp_row_kids)), "2")
    _check("stat(prefix) 1st child text (prefix)", prism_node.prism_node_attr_str(sp_row_kids[0], "text", ""), "$")
    _check("stat(prefix) 2nd child text (value)", prism_node.prism_node_attr_str(sp_row_kids[1], "text", ""), "1.2M")

    let stat_suffix_r = st.prism_st_stat("Growth", "42", none(), some("%"))
    _check_true("stat (suffix only) constructs", is_ok(stat_suffix_r))
    let stat_suffix = unwrap(stat_suffix_r)
    _check("stat(suffix) depth", str(prism_node.prism_node_depth(stat_suffix)), "3")
    _check("stat(suffix) count", str(prism_node.prism_node_count(stat_suffix)), "5")
    let ss_row_kids = prism_node.prism_node_children(prism_node.prism_node_children(stat_suffix)[0])
    _check("stat(suffix) value row child count", str(len(ss_row_kids)), "2")
    _check("stat(suffix) 1st child text (value)", prism_node.prism_node_attr_str(ss_row_kids[0], "text", ""), "42")
    _check("stat(suffix) 2nd child text (suffix)", prism_node.prism_node_attr_str(ss_row_kids[1], "text", ""), "%")

    let stat_both_r = st.prism_st_stat("Balance", "500", some("$"), some("USD"))
    _check_true("stat (both prefix and suffix) constructs", is_ok(stat_both_r))
    let stat_both = unwrap(stat_both_r)
    _check("stat(both) depth", str(prism_node.prism_node_depth(stat_both)), "3")
    _check("stat(both) count", str(prism_node.prism_node_count(stat_both)), "6")
    let sb_row_kids = prism_node.prism_node_children(prism_node.prism_node_children(stat_both)[0])
    _check("stat(both) value row child count", str(len(sb_row_kids)), "3")
    _check("stat(both) 1st child text (prefix)", prism_node.prism_node_attr_str(sb_row_kids[0], "text", ""), "$")
    _check("stat(both) 2nd child text (value)", prism_node.prism_node_attr_str(sb_row_kids[1], "text", ""), "500")
    _check("stat(both) 3rd child text (suffix)", prism_node.prism_node_attr_str(sb_row_kids[2], "text", ""), "USD")

    // A present-but-blank Some("") prefix degrades to the "neither" shape (d=3, c=4), never a
    // stray blank label in the value row.
    let stat_blank_r = st.prism_st_stat("X", "10", some(""), none())
    _check_true("stat (blank Some prefix) constructs", is_ok(stat_blank_r))
    let stat_blank = unwrap(stat_blank_r)
    _check("stat(blank prefix) count degrades to 4 (same as neither)", str(prism_node.prism_node_count(stat_blank)), "4")
    let sbl_row_kids = prism_node.prism_node_children(prism_node.prism_node_children(stat_blank)[0])
    _check("stat(blank prefix) value row has only the value (prefix omitted)", str(len(sbl_row_kids)), "1")

    let stat_empty_label_r = st.prism_st_stat("", "10", none(), none())
    _check_true("stat rejects an empty st_label", is_err(stat_empty_label_r))
    let stat_empty_value_r = st.prism_st_stat("Label", "", none(), none())
    _check_true("stat rejects an empty st_value", is_err(stat_empty_value_r))
    print("")

    // ── 3. prism_st_trend: exact stack(d=3,c=6), distinct icon per direction, rejects ────────────
    let trend_up_r = st.prism_st_trend("Users", "1,204", st.prism_st_up(), "+12%")
    _check_true("trend (up) constructs", is_ok(trend_up_r))
    let trend_up = unwrap(trend_up_r)
    _check("trend kind_str", prism_node.prism_node_kind_str(trend_up), "stack")
    _check("trend depth", str(prism_node.prism_node_depth(trend_up)), "3")
    _check("trend count", str(prism_node.prism_node_count(trend_up)), "6")
    let tu_kids = prism_node.prism_node_children(trend_up)
    _check("trend child count", str(len(tu_kids)), "2")
    _check("trend value row kind_str", prism_node.prism_node_kind_str(tu_kids[0]), "band")
    _check("trend label text", prism_node.prism_node_attr_str(tu_kids[1], "text", ""), "Users")
    let tu_row_kids = prism_node.prism_node_children(tu_kids[0])
    _check("trend value row child count", str(len(tu_row_kids)), "3")
    _check("trend 1st child text (value)", prism_node.prism_node_attr_str(tu_row_kids[0], "text", ""), "1,204")
    _check("trend 2nd child kind_str (icon)", prism_node.prism_node_kind_str(tu_row_kids[1]), "glyph")
    _check("trend up icon is chevron_up", prism_node.prism_node_attr_str(tu_row_kids[1], "icon", ""), "chevron_up")
    _check("trend 3rd child text (change)", prism_node.prism_node_attr_str(tu_row_kids[2], "text", ""), "+12%")

    let trend_down = unwrap(st.prism_st_trend("Users", "980", st.prism_st_down(), "-8%"))
    let td_row_kids = prism_node.prism_node_children(prism_node.prism_node_children(trend_down)[0])
    _check("trend down icon is chevron_down", prism_node.prism_node_attr_str(td_row_kids[1], "icon", ""), "chevron_down")

    let trend_flat = unwrap(st.prism_st_trend("Users", "1,000", st.prism_st_flat(), "0%"))
    let tf_row_kids = prism_node.prism_node_children(prism_node.prism_node_children(trend_flat)[0])
    _check("trend flat icon is minus", prism_node.prism_node_attr_str(tf_row_kids[1], "icon", ""), "minus")

    let trend_empty_label_r = st.prism_st_trend("", "1", st.prism_st_up(), "+1%")
    _check_true("trend rejects an empty st_label", is_err(trend_empty_label_r))
    let trend_empty_value_r = st.prism_st_trend("Users", "", st.prism_st_up(), "+1%")
    _check_true("trend rejects an empty st_value", is_err(trend_empty_value_r))
    let trend_empty_change_r = st.prism_st_trend("Users", "1", st.prism_st_up(), "")
    _check_true("trend rejects an empty st_change", is_err(trend_empty_change_r))
    print("")

    // ── 4. prism_st_comparison: exact stack(d=3,c=6), literal "vs" separator, rejects ────────────
    let cmp_r = st.prism_st_comparison("Sales", "$5,000", "$4,200")
    _check_true("comparison constructs", is_ok(cmp_r))
    let cmp = unwrap(cmp_r)
    _check("comparison kind_str", prism_node.prism_node_kind_str(cmp), "stack")
    _check("comparison depth", str(prism_node.prism_node_depth(cmp)), "3")
    _check("comparison count", str(prism_node.prism_node_count(cmp)), "6")
    let cmp_kids = prism_node.prism_node_children(cmp)
    _check("comparison label text", prism_node.prism_node_attr_str(cmp_kids[1], "text", ""), "Sales")
    _check("comparison compare row kind_str", prism_node.prism_node_kind_str(cmp_kids[0]), "band")
    let cmp_row_kids = prism_node.prism_node_children(cmp_kids[0])
    _check("comparison compare row child count", str(len(cmp_row_kids)), "3")
    _check("comparison 1st child text (current)", prism_node.prism_node_attr_str(cmp_row_kids[0], "text", ""), "$5,000")
    _check("comparison 2nd child text (literal 'vs')", prism_node.prism_node_attr_str(cmp_row_kids[1], "text", ""), "vs")
    _check("comparison 3rd child text (previous)", prism_node.prism_node_attr_str(cmp_row_kids[2], "text", ""), "$4,200")

    let cmp_empty_label_r = st.prism_st_comparison("", "1", "2")
    _check_true("comparison rejects an empty st_label", is_err(cmp_empty_label_r))
    let cmp_empty_current_r = st.prism_st_comparison("Sales", "", "2")
    _check_true("comparison rejects an empty st_current", is_err(cmp_empty_current_r))
    let cmp_empty_previous_r = st.prism_st_comparison("Sales", "1", "")
    _check_true("comparison rejects an empty st_previous", is_err(cmp_empty_previous_r))
    print("")

    // ── 5. prism_st_card: exact stack(d=4,c=7) 1 child, stack(d=4,c=13) 2 heterogeneous children ─
    let card1_r = st.prism_st_card("Overview", [stat_neither])
    _check_true("card (1 child) constructs", is_ok(card1_r))
    let card1 = unwrap(card1_r)
    _check("card1 kind_str", prism_node.prism_node_kind_str(card1), "stack")
    _check("card1 depth", str(prism_node.prism_node_depth(card1)), "4")
    _check("card1 count", str(prism_node.prism_node_count(card1)), "7")
    let card1_kids = prism_node.prism_node_children(card1)
    _check("card1 child count (title + gap + 1 stat)", str(len(card1_kids)), "3")
    _check("card1 title kind_str", prism_node.prism_node_kind_str(card1_kids[0]), "label")
    _check("card1 title text", prism_node.prism_node_attr_str(card1_kids[0], "text", ""), "Overview")
    _check("card1 gap kind_str", prism_node.prism_node_kind_str(card1_kids[1]), "gap")
    _check("card1 gap size is 8 (fixed)", str(prism_node.prism_node_attr_int(card1_kids[1], "size", -1)), "8")
    _check_true("card1 gap is not flexible", not prism_node.prism_node_attr_bool(card1_kids[1], "flexible", true))
    _check("card1 3rd child kind_str (the stat)", prism_node.prism_node_kind_str(card1_kids[2]), "stack")

    let card2_r = st.prism_st_card("Metrics", [stat_neither, trend_up])
    _check_true("card (2 heterogeneous children) constructs", is_ok(card2_r))
    let card2 = unwrap(card2_r)
    _check("card2 depth", str(prism_node.prism_node_depth(card2)), "4")
    _check("card2 count", str(prism_node.prism_node_count(card2)), "13")
    let card2_kids = prism_node.prism_node_children(card2)
    _check("card2 child count (title + gap + 2 stats)", str(len(card2_kids)), "4")

    let card_empty_title_r = st.prism_st_card("", [stat_neither])
    _check_true("card rejects an empty title", is_err(card_empty_title_r))
    let card_empty_children_r = st.prism_st_card("Overview", [])
    _check_true("card rejects an empty children list", is_err(card_empty_children_r))
    let card_bad_elem_r = st.prism_st_card("Overview", [stat_neither, "not a node"])
    _check_true("card rejects a non-PrismNode element", is_err(card_bad_elem_r))
    if is_err(card_bad_elem_r)
        _check_true("card rejection names the offending index and type", contains(unwrap_err(card_bad_elem_r), "1") and contains(unwrap_err(card_bad_elem_r), "string"))
    print("")

    // ── 6. prism_st_dashboard: exact flow(d=5,c=17) over 2 cards, rejects ─────────────────────────
    let card_users_r = st.prism_st_card("Users", [trend_up])
    let card_users = unwrap(card_users_r)
    _check("card_users depth (sanity: single trend child)", str(prism_node.prism_node_depth(card_users)), "4")
    _check("card_users count (sanity: single trend child)", str(prism_node.prism_node_count(card_users)), "9")

    let dash_r = st.prism_st_dashboard([card1, card_users])
    _check_true("dashboard constructs", is_ok(dash_r))
    let dash = unwrap(dash_r)
    _check("dashboard kind_str", prism_node.prism_node_kind_str(dash), "flow")
    _check("dashboard depth", str(prism_node.prism_node_depth(dash)), "5")
    _check("dashboard count", str(prism_node.prism_node_count(dash)), "17")
    let dash_kids = prism_node.prism_node_children(dash)
    _check("dashboard child count", str(len(dash_kids)), "2")
    _check("dashboard 1st card kind_str", prism_node.prism_node_kind_str(dash_kids[0]), "stack")
    _check("dashboard 2nd card kind_str", prism_node.prism_node_kind_str(dash_kids[1]), "stack")

    let dash_empty_r = st.prism_st_dashboard([])
    _check_true("dashboard rejects an empty list", is_err(dash_empty_r))
    let dash_bad_elem_r = st.prism_st_dashboard([card1, 5])
    _check_true("dashboard rejects a non-PrismNode element", is_err(dash_bad_elem_r))
    if is_err(dash_bad_elem_r)
        _check_true("dashboard rejection names the offending index and type", contains(unwrap_err(dash_bad_elem_r), "1") and contains(unwrap_err(dash_bad_elem_r), "int"))
    print("")

    // ── 7. Rejection tally: at least 8 distinct rejections proven above (13, counted here) ───────
    // stat: label, value (2); trend: label, value, change (3); comparison: label, current,
    // previous (3); card: title, empty children, bad element (3); dashboard: empty, bad element (2)
    let rejection_count = 13
    _check_true("expected at least 8 rejection cases, counted " + str(rejection_count), rejection_count >= 8)

    if FAILED[0] == 0
        print("")
        print("_kat_prism_ui_stat: ALL PASS")
    else
        print("")
        print("_kat_prism_ui_stat: " + str(FAILED[0]) + " FAILURE(S)")
        exit(1)
