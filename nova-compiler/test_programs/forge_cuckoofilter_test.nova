import forge_cuckoofilter

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

// str() of a BOOLEAN renders true/false, not 1/0. These assertions expected "1" -- the
// behaviour from before str() learned the bool path (print already had it; str did not). When
// that was fixed the assertions started failing, and nothing noticed: they print FAIL and
// exit 0, which the regression harness counted as a PASS until 2026-08-25.
fn main()
    let fails = 0

    // empty filter: nothing present, no false positives possible
    let cf = cuckoo_new(64)
    fails = fails + expect("empty", str(cuckoo_contains(cf, 5)), "false")

    // insert 1..40, all must insert and all must be found (NO false negatives)
    let all_inserted = 1
    let k = 1
    while k <= 40
        if cuckoo_insert(cf, k * 7) == false
            all_inserted = 0
        k = k + 1
    fails = fails + expect("all_inserted", str(all_inserted), "1")
    fails = fails + expect("count40", str(cuckoo_count(cf)), "40")

    let all_found = 1
    let k2 = 1
    while k2 <= 40
        if cuckoo_contains(cf, k2 * 7) == false
            all_found = 0
        k2 = k2 + 1
    fails = fails + expect("no_false_neg", str(all_found), "1")

    // delete all, count back to 0, none found
    let all_deleted = 1
    let k3 = 1
    while k3 <= 40
        if cuckoo_delete(cf, k3 * 7) == false
            all_deleted = 0
        k3 = k3 + 1
    fails = fails + expect("all_deleted", str(all_deleted), "1")
    fails = fails + expect("count0", str(cuckoo_count(cf)), "0")

    let none_found = 1
    let k4 = 1
    while k4 <= 40
        if cuckoo_contains(cf, k4 * 7)
            none_found = 0
        k4 = k4 + 1
    fails = fails + expect("empty_after_delete", str(none_found), "1")

    // delete of absent key returns false
    let cf2 = cuckoo_new(16)
    cuckoo_insert(cf2, 100)
    fails = fails + expect("del_absent", str(cuckoo_delete(cf2, 999)), "false")
    fails = fails + expect("del_present", str(cuckoo_delete(cf2, 100)), "true")
    fails = fails + expect("gone", str(cuckoo_contains(cf2, 100)), "false")

    // false-positive rate is low: over 200 never-inserted keys against a filter of 30 items, expect few hits
    let cf3 = cuckoo_new(64)
    let m = 0
    while m < 30
        cuckoo_insert(cf3, m)
        m = m + 1
    let fp_hits = 0
    let q = 1000
    while q < 1200
        if cuckoo_contains(cf3, q)
            fp_hits = fp_hits + 1
        q = q + 1
    // with 8-bit fingerprints and a large filter, false positives should be well under 10%
    fails = fails + expect("low_fp", str(fp_hits < 20),"true")

    if fails == 0
        print("forge_cuckoofilter: all passed")
    else
        print("forge_cuckoofilter: " + str(fails) + " FAILED")
