import forge_retry_policy

fn main()
    let rp = rp_fixed(1000, 3)
    assert(rp_should_retry(rp) == 1, "can retry")
    assert(rp_next_delay(rp) == 1000, "fixed delay=1000")

    rp = rp_record_attempt(rp)
    assert(rp_should_retry(rp) == 1, "1/3 still ok")
    assert(rp_next_delay(rp) == 1000, "still 1000")

    rp = rp_record_attempt(rp)
    rp = rp_record_attempt(rp)
    assert(rp_should_retry(rp) == 0, "3/3 exhausted")
    rp = rp_record_failure(rp)
    assert(rp_is_exhausted(rp) == 1, "marked exhausted")

    rp = rp_reset(rp)
    assert(rp_should_retry(rp) == 1, "reset allows retry")
    assert(rp_is_exhausted(rp) == 0, "not exhausted after reset")

    let lin = rp_linear(100, 200, 4)
    assert(rp_next_delay(lin) == 100, "linear base=100")
    lin = rp_record_attempt(lin)
    assert(rp_next_delay(lin) == 300, "100+200=300")
    lin = rp_record_attempt(lin)
    assert(rp_next_delay(lin) == 500, "100+400=500")

    let exp = rp_exponential(100, 5000, 5)
    assert(rp_next_delay(exp) == 100, "exp base=100")
    exp = rp_record_attempt(exp)
    assert(rp_next_delay(exp) == 200, "100*2=200")
    exp = rp_record_attempt(exp)
    assert(rp_next_delay(exp) == 400, "100*4=400")
    exp = rp_record_attempt(exp)
    assert(rp_next_delay(exp) == 800, "100*8=800")

    let exp2 = rp_exponential(1000, 3000, 10)
    exp2 = rp_record_attempt(exp2)
    exp2 = rp_record_attempt(exp2)
    assert(rp_next_delay(exp2) == 3000, "capped at max")

    let rp2 = rp_fixed(500, 2)
    rp2 = rp_record_attempt(rp2)
    rp2 = rp_record_success(rp2)
    let stats = rp_stats(rp2)
    assert(stats["attempts"] == 1, "1 attempt")
    assert(stats["successes"] == 1, "1 success")
    assert(stats["strategy"] == "fixed", "strategy=fixed")

    print("RETRY-POLICY KAT PASS")
