import std/functional/ffilter

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _ffilter_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL _ffilter_test " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn ckl(label: string, got: list, want: list)
    cki(label + ".len", len(got), len(want))
    let i = 0
    while i < len(want)
        cki(label + "[" + str(i) + "]", got[i], want[i])
        i = i + 1

// Helper predicates
fn is_even(x)
    x % 2 == 0

fn is_pos(x)
    x > 0

fn main()
    // ff_filter: keep evens from 1..6
    let r1 = ff_filter(is_even, [1, 2, 3, 4, 5, 6])
    ckl("filter_even_123456", r1, [2, 4, 6])

    // ff_filter: keep positives
    let r2 = ff_filter(is_pos, [-1, 2, -3, 4])
    ckl("filter_pos", r2, [2, 4])

    // ff_filter: empty input
    let r3 = ff_filter(is_even, [])
    cki("filter_empty_len", len(r3), 0)

    // ff_filter: none match
    let r4 = ff_filter(is_even, [1, 3, 5])
    cki("filter_none_match", len(r4), 0)

    // ff_filter: all match
    let r5 = ff_filter(is_even, [2, 4, 6])
    ckl("filter_all_match", r5, [2, 4, 6])

    // ff_reject: drop evens from 1..4
    let r6 = ff_reject(is_even, [1, 2, 3, 4])
    ckl("reject_even_1234", r6, [1, 3])

    // ff_reject: empty input
    let r7 = ff_reject(is_even, [])
    cki("reject_empty_len", len(r7), 0)

    // ff_reject: none rejected (all odd)
    let r8 = ff_reject(is_even, [1, 3, 5])
    ckl("reject_none", r8, [1, 3, 5])

    // ff_reject: all rejected (all even)
    let r9 = ff_reject(is_even, [2, 4, 6])
    cki("reject_all_len", len(r9), 0)

    // ff_partition: split [1,2,3,4] by even
    let r10 = ff_partition(is_even, [1, 2, 3, 4])
    let kept = r10[0]
    let rejected = r10[1]
    ckl("partition_kept", kept, [2, 4])
    ckl("partition_rejected", rejected, [1, 3])

    // ff_partition: empty input
    let r11 = ff_partition(is_even, [])
    let k11 = r11[0]
    let rej11 = r11[1]
    cki("partition_empty_kept_len", len(k11), 0)
    cki("partition_empty_rej_len", len(rej11), 0)

    // ff_partition: all match
    let r12 = ff_partition(is_even, [2, 4])
    let k12 = r12[0]
    let rej12 = r12[1]
    ckl("partition_all_kept", k12, [2, 4])
    cki("partition_all_rej_len", len(rej12), 0)

    // ff_partition: none match
    let r13 = ff_partition(is_even, [1, 3])
    let k13 = r13[0]
    let rej13 = r13[1]
    cki("partition_none_kept_len", len(k13), 0)
    ckl("partition_none_rej", rej13, [1, 3])

    print("PASS _ffilter_test")

main()
