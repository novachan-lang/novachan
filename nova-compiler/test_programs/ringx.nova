fn ring_new(capacity)
  let r = {}
  r["data"] = []
  let i = 0
  while i < capacity
    push(r["data"], 0)
    i = i + 1
  r["cap"] = capacity
  r["head"] = 0
  r["size"] = 0
  r

fn ring_push(r, val)
  let idx = (r["head"] + r["size"]) % r["cap"]
  r["data"][idx] = val
  if r["size"] < r["cap"]
    r["size"] = r["size"] + 1
  else
    r["head"] = (r["head"] + 1) % r["cap"]

fn ring_get(r, i)
  if i < 0 or i >= r["size"]
    return err("index out of bounds")
  let idx = (r["head"] + i) % r["cap"]
  ok(r["data"][idx])

fn ring_size(r)
  r["size"]

fn ring_capacity(r)
  r["cap"]

fn ring_is_full(r)
  r["size"] == r["cap"]

fn ring_to_list(r)
  let result = []
  let i = 0
  while i < r["size"]
    let idx = (r["head"] + i) % r["cap"]
    push(result, r["data"][idx])
    i = i + 1
  result

fn ring_latest(r)
  if r["size"] == 0
    return err("empty ring")
  let idx = (r["head"] + r["size"] - 1) % r["cap"]
  ok(r["data"][idx])

fn main()
  let r = ring_new(3)
  assert(ring_size(r) == 0, "empty")
  assert(ring_capacity(r) == 3, "cap 3")

  ring_push(r, 10)
  ring_push(r, 20)
  assert(ring_size(r) == 2, "size 2")
  assert(unwrap(ring_get(r, 0)) == 10, "first = 10")
  assert(unwrap(ring_get(r, 1)) == 20, "second = 20")

  ring_push(r, 30)
  assert(ring_is_full(r) == 1, "full")

  ring_push(r, 40)
  assert(ring_size(r) == 3, "still 3 after overflow")
  let items = ring_to_list(r)
  assert(items[0] == 20, "oldest = 20 (10 evicted)")
  assert(items[2] == 40, "newest = 40")

  assert(unwrap(ring_latest(r)) == 40, "latest = 40")

  ring_push(r, 50)
  ring_push(r, 60)
  let items2 = ring_to_list(r)
  assert(items2[0] == 40, "40 oldest")
  assert(items2[2] == 60, "60 newest")

  assert(is_err(ring_get(r, 5)), "out of bounds err")

  print("ringx: all passed")
