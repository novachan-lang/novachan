import std/text/phonetics

let _c = [0, 0]

fn cks(label: string, got: string, want: string)
    _c[0] = _c[0] + 1
    if got != want
        _c[1] = _c[1] + 1
        print("FAIL " + label + ": got=" + got + " want=" + want)

fn cki(label: string, got: int, want: int)
    _c[0] = _c[0] + 1
    if got != want
        _c[1] = _c[1] + 1
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))

fn main()
    // ---- ph_normalize ----
    cks("normalize", ph_normalize("Jo3hn Doe!"), "JOHNDOE")
    cks("normalize_empty", ph_normalize(""), "")

    // ---- ph_soundex: published Soundex vectors (NARA/Knuth) ----
    cks("soundex_Robert", ph_soundex("Robert"), "R163")
    cks("soundex_Rupert", ph_soundex("Rupert"), "R163")
    cks("soundex_Ashcraft", ph_soundex("Ashcraft"), "A261")
    cks("soundex_Ashcroft", ph_soundex("Ashcroft"), "A261")
    cks("soundex_Tymczak", ph_soundex("Tymczak"), "T522")
    cks("soundex_Pfister", ph_soundex("Pfister"), "P236")
    cks("soundex_Smith", ph_soundex("Smith"), "S530")
    cks("soundex_Smyth", ph_soundex("Smyth"), "S530")
    cks("soundex_Jones", ph_soundex("Jones"), "J520")

    // ---- ph_metaphone: published Metaphone vectors ----
    cks("metaphone_Thompson", ph_metaphone("Thompson"), "TMPSN")
    cks("metaphone_phone", ph_metaphone("phone"), "FN")
    cks("metaphone_knife", ph_metaphone("knife"), "NF")
    cks("metaphone_empty", ph_metaphone(""), "")

    // ---- ph_nysiis: published NYSIIS vectors ----
    cks("nysiis_KNUTH", ph_nysiis("KNUTH"), "NAT")
    cks("nysiis_MACINTOSH", ph_nysiis("MACINTOSH"), "MCANTAS")
    // Braun and Brown are the textbook NYSIIS homophone-collision example.
    cks("nysiis_BROWN", ph_nysiis("BROWN"), "BRAN")
    cks("nysiis_BRAUN", ph_nysiis("BRAUN"), "BRAN")

    // ---- ph_cologne: published Koelner Phonetik vectors ----
    cks("cologne_Mueller", ph_cologne("Mueller"), "657")
    cks("cologne_Meyer", ph_cologne("Meyer"), "67")
    cks("cologne_Wikipedia", ph_cologne("Wikipedia"), "3412")

    // ---- ph_caverphone: hand-traced from this module's own pipeline ----
    cks("caverphone_empty", ph_caverphone(""), "1111111111")
    cks("caverphone_A", ph_caverphone("A"), "a111111111")
    cks("caverphone_Smith", ph_caverphone("Smith"), "smth111111")
    cki("caverphone_len", len(ph_caverphone("Thompson")), 10)

    // ---- ph_match ----
    cki("match_Robert_Rupert", ph_match("Robert", "Rupert"), 1)
    cki("match_Robert_Smith", ph_match("Robert", "Smith"), 0)

    // ---- ph_distance ----
    cki("distance_same_code", ph_distance("Robert", "Rupert"), 0)
    cki("distance_Robert_Smith", ph_distance("Robert", "Smith"), 4)

    // ---- ph_fuzzy_score ----
    cki("fuzzy_self_max", ph_fuzzy_score("Robert", "Robert"), 83)
    let self_score = ph_fuzzy_score("Robert", "Robert")
    let cross_score = ph_fuzzy_score("Robert", "Rupert")
    if self_score < cross_score
        _c[0] = _c[0] + 1
        _c[1] = _c[1] + 1
        print("FAIL fuzzy_self_ge_cross: self=" + str(self_score) + " cross=" + str(cross_score))
    else
        _c[0] = _c[0] + 1

    // ---- ph_group ----
    let names = ["Robert", "Rupert", "Smith", "Smyth", "Jones"]
    let groups = ph_group(names)
    cki("group_has_R163", contains(groups, "R163"), 1)
    cki("group_has_S530", contains(groups, "S530"), 1)
    let r163 = groups["R163"]
    cki("group_R163_len", len(r163), 2)
    cks("group_R163_0", r163[0], "Robert")
    cks("group_R163_1", r163[1], "Rupert")
    let s530 = groups["S530"]
    cki("group_S530_len", len(s530), 2)

    // ---- ph_dedup ----
    let deduped = ph_dedup(names)
    cki("dedup_len", len(deduped), 3)
    cks("dedup_0", deduped[0], "Robert")
    cks("dedup_1", deduped[1], "Smith")
    cks("dedup_2", deduped[2], "Jones")

    // ---- ph_suggest ----
    let suggestions = ph_suggest("Robert", ["Rupert", "Smith"])
    cki("suggest_len", len(suggestions), 1)
    cks("suggest_0", suggestions[0], "Rupert")

    if _c[1] == 0
        print("ALL PASSED (" + str(_c[0]) + " checks)")
    else
        print(str(_c[1]) + " of " + str(_c[0]) + " checks FAILED")
        exit(1)
