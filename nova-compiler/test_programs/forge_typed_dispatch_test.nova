// forge_typed_dispatch_test -- Phase 1: the typed handler model end-to-end (pure dispatch).
// Handlers are fn(Request) -> Response (req received as a TYPED param -> sound field access).
// Returning resp_json(struct) yields a JSON object via the keystone. Covers param routes,
// 404, and 405 through the typed dispatcher.
import forge

type User
    id: int
    name: string
    active: bool

fn h_get_user(req: Request) -> Response
    forge.resp_json(200, User(7, req.params["id"], true))

fn h_list(req: Request) -> Response
    forge.resp_text(200, "user-list")

fn main()
    let q = chr(34)
    let a = forge.app()
    forge.get(a, "/users/:id", h_get_user)
    forge.get(a, "/users", h_list)

    // typed dispatch: build Request -> dispatch to typed handler -> Response -> finalize
    let req: Request = forge.build_request("GET /users/42 HTTP/1.1\r\nHost: x\r\n\r\n", 0)
    let resp: Response = forge.dispatch_req(a, req)
    assert(resp.status == 200, "status 200")
    let wire = forge.finalize(resp)
    assert(find(wire, q + "id" + q + ":7") >= 0, "json id 7")
    assert(find(wire, q + "name" + q + ":" + q + "42" + q) >= 0, "param :id bound -> name=42")
    assert(find(wire, q + "active" + q + ":true") >= 0, "bool field true")
    print("PASS: typed handler dispatch + resp_json(struct) -> JSON object")

    // 404 through the typed dispatcher
    let r404: Response = forge.dispatch_req(a, forge.build_request("GET /nope HTTP/1.1\r\n\r\n", 0))
    assert(r404.status == 404, "404 no route")
    print("PASS: typed 404")

    // 405: POST to a GET-only path
    let r405: Response = forge.dispatch_req(a, forge.build_request("POST /users HTTP/1.1\r\n\r\n", 0))
    assert(r405.status == 405, "405 method not allowed")
    print("PASS: typed 405")
    print("forge_typed_dispatch_test passed")
