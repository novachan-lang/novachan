import forge_gray

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn join_ints(lst) -> string
    let parts = []
    let i = 0
    while i < len(lst)
        push(parts, str(lst[i]))
        i = i + 1
    join(parts, ",")

fn main()
    let fails = 0

    // known gray codes: 0->0,1->1,2->3,3->2,4->6,5->7,6->5,7->4
    fails = fails + expect("enc0", str(gray_encode(0)), "0")
    fails = fails + expect("enc2", str(gray_encode(2)), "3")
    fails = fails + expect("enc3", str(gray_encode(3)), "2")
    fails = fails + expect("enc4", str(gray_encode(4)), "6")
    fails = fails + expect("enc7", str(gray_encode(7)), "4")

    // decode is the inverse
    fails = fails + expect("dec7", str(gray_decode(7)), "5")
    fails = fails + expect("dec2", str(gray_decode(2)), "3")
    // roundtrip for 0..100
    let rt_ok = true
    let n = 0
    while n <= 100
        if gray_decode(gray_encode(n)) != n
            rt_ok = false
        n = n + 1
    fails = fails + expect_true("roundtrip", rt_ok)

    // 2-bit gray sequence: [0,1,3,2]
    fails = fails + expect("seq2", join_ints(gray_sequence(2)), "0,1,3,2")
    // 3-bit: [0,1,3,2,6,7,5,4]
    fails = fails + expect("seq3", join_ints(gray_sequence(3)), "0,1,3,2,6,7,5,4")

    // consecutive entries in the sequence differ by exactly 1 bit (including wraparound)
    let seq = gray_sequence(4)
    let all_one = true
    let i = 0
    while i < len(seq)
        let j = i + 1
        if j == len(seq)
            j = 0
        if gray_bitdiff(seq[i], seq[j]) != 1
            all_one = false
        i = i + 1
    fails = fails + expect_true("single_bit_cycle", all_one)

    // bitdiff sanity
    fails = fails + expect("bitdiff", str(gray_bitdiff(5, 6)), "2")

    if fails == 0
        print("forge_gray: all passed")
    else
        print("forge_gray: " + str(fails) + " FAILED")
