import std/collections/setops
fn main()
    // ALL-DISTINCT elements -- the output set is as large as the input, which is
    // exactly where a linear membership scan degrades.
    let a = [i for i in 0..6000]
    let b = [i for i in 3000..9000]
    print(len(set_union(a, b)))
    print(len(set_intersection(a, b)))
    print(len(set_difference(a, b)))
    print(len(set_symdiff(a, b)))
    print(is_subset(a, a))
    print("BENCH-DONE")
