import std/collections/defaultdict

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + got + " want " + want)
        exit(1)

fn main()
    // ── int defaultdict ──────────────────────────────────────────────
    let dd = dd_new("int")

    // incr absent key treated as 0
    dd_incr(dd, "a", 1)
    dd_incr(dd, "a", 2)
    cki("int_incr_a", dd_get(dd, "a"), 3)

    // absent key returns 0, does NOT insert
    cki("int_get_missing", dd_get(dd, "b"), 0)
    cki("int_has_not_inserted", dd_has(dd, "b"), 0)

    // explicit set
    dd_set(dd, "c", 42)
    cki("int_set_c", dd_get(dd, "c"), 42)
    cki("int_has_c", dd_has(dd, "c"), 1)

    // ── list defaultdict ─────────────────────────────────────────────
    let dl = dd_new("list")

    // append creates list on first use
    dd_append(dl, "x", 1)
    dd_append(dl, "x", 2)
    let xv = dd_get(dl, "x")
    cki("list_append_len", len(xv), 2)
    cki("list_append_0",   xv[0], 1)
    cki("list_append_1",   xv[1], 2)
    cki("list_has_x",      dd_has(dl, "x"), 1)

    // absent key returns fresh [] without inserting
    let yv = dd_get(dl, "y")
    cki("list_absent_len",  len(yv), 0)
    cki("list_has_not_inserted", dd_has(dl, "y"), 0)

    // ── str defaultdict ──────────────────────────────────────────────
    let ds = dd_new("str")
    cks("str_absent_default", dd_get(ds, "z"), "")
    dd_set(ds, "z", "hello")
    cks("str_set_z", dd_get(ds, "z"), "hello")

    // ── dict defaultdict ─────────────────────────────────────────────
    let dm = dd_new("dict")
    let dv = dd_get(dm, "missing")
    cki("dict_absent_is_dict", type_of(dv) == "dict", 1)
    cki("dict_has_not_inserted", dd_has(dm, "missing"), 0)

    // ── dd_keys only shows explicitly set keys ───────────────────────
    let di = dd_new("int")
    dd_incr(di, "p", 5)
    dd_set(di, "q", 7)
    // probe "r" — must NOT appear in keys
    dd_get(di, "r")
    let ks = dd_keys(di)
    cki("keys_len", len(ks), 2)

    print("_defaultdict_test passed")
