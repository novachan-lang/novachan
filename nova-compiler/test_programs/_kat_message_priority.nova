import forge_message_priority

fn main()
    let m = mp_new()
    m = mp_enqueue(m, "low-task", 1)
    m = mp_enqueue(m, "high-task", 10)
    m = mp_enqueue(m, "mid-task", 5)
    assert(mp_pending_count(m) == 3, "3 pending")
    assert(mp_total_enqueued(m) == 3, "3 enqueued")

    let r1 = mp_dequeue(m)
    m = r1["m"]
    assert(r1["found"] == 1, "found")
    assert(r1["payload"] == "high-task", "highest first")
    assert(r1["priority"] == 10, "pri 10")

    let r2 = mp_dequeue(m)
    m = r2["m"]
    assert(r2["payload"] == "mid-task", "mid next")

    let r3 = mp_dequeue(m)
    m = r3["m"]
    assert(r3["payload"] == "low-task", "low last")

    let r4 = mp_dequeue(m)
    m = r4["m"]
    assert(r4["found"] == 0, "empty")
    assert(mp_total_dequeued(m) == 3, "3 dequeued")

    print("MESSAGE-PRIORITY KAT PASS")
