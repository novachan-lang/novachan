// Multi-generator comprehensions: multiple `for` clauses + per-generator filters,
// desugared to nested flatten(map(...)). Single-generator form unchanged.

fn main()
    // 2 generators = cartesian product
    let pairs = [x * 10 + y for x in [1, 2] for y in [3, 4]]
    assert_eq(pairs, [13, 14, 23, 24])

    // filter on the inner generator
    let inner = [x + y for x in [1, 2] for y in [10, 20] if y == 20]
    assert_eq(inner, [21, 22])

    // filter on the outer generator
    let outer = [x for x in [1, 2, 3, 4] if x % 2 == 0 for y in [0]]
    assert_eq(outer, [2, 4])

    // 3 generators
    let triples = [x + y + z for x in [1] for y in [2] for z in [3, 4]]
    assert_eq(triples, [6, 7])

    // single generator still works (backward compat)
    assert_eq([n * n for n in [1, 2, 3]], [1, 4, 9])
    assert_eq([n for n in [1, 2, 3, 4, 5] if n > 2], [3, 4, 5])

    print("multigen passed")
