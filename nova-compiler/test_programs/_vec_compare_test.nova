import std/vector/vec_compare

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + ": length got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // KAT 1: vcmp_lex([1,2,3],[1,2,4]) = -1 (first diff at i=2: 3 < 4)
    cki("lex_lt", vcmp_lex([1, 2, 3], [1, 2, 4]), -1)

    // KAT 2: vcmp_lex([1,2],[1,2]) = 0
    cki("lex_eq", vcmp_lex([1, 2], [1, 2]), 0)

    // KAT 3: vcmp_lex([2,0],[1,9]) = 1 (first diff at i=0: 2 > 1)
    cki("lex_gt", vcmp_lex([2, 0], [1, 9]), 1)

    // KAT 4: vcmp_dominates([3,4],[1,2]) = true (3>=1, 4>=2)
    ckb("dom_true", vcmp_dominates([3, 4], [1, 2]), true)

    // KAT 5: vcmp_dominates([3,1],[1,2]) = false (1 < 2 fails)
    ckb("dom_false", vcmp_dominates([3, 1], [1, 2]), false)

    // KAT 6: vcmp_min([1,5],[3,2]) = [1,2]
    ckl("min_basic", vcmp_min([1, 5], [3, 2]), [1, 2])

    // KAT 7: vcmp_max([1,5],[3,2]) = [3,5]
    ckl("max_basic", vcmp_max([1, 5], [3, 2]), [3, 5])

    // KAT 8: equal vectors — lex = 0
    cki("lex_all_equal", vcmp_lex([0, 0, 0], [0, 0, 0]), 0)

    // KAT 9: dominates with equal components — true (>= not just >)
    ckb("dom_eq_components", vcmp_dominates([1, 2], [1, 2]), true)

    // KAT 10: vcmp_min with negative values
    ckl("min_neg", vcmp_min([-1, 5], [3, -2]), [-1, -2])

    // KAT 11: vcmp_max with negative values
    ckl("max_neg", vcmp_max([-1, 5], [3, -2]), [3, 5])

    // KAT 12: empty vectors — lex = 0, dominates = true (vacuous)
    cki("lex_empty", vcmp_lex([], []), 0)
    ckb("dom_empty", vcmp_dominates([], []), true)

    // KAT 13: shorter prefix is less — [1,2] < [1,2,0]
    cki("lex_prefix_lt", vcmp_lex([1, 2], [1, 2, 0]), -1)

    // KAT 14: longer is greater — [1,2,3] > [1,2]
    cki("lex_longer_gt", vcmp_lex([1, 2, 3], [1, 2]), 1)

    print("PASS _vec_compare_test")
