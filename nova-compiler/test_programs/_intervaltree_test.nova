import std/collections/intervaltree

fn cki(got, expected, label)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(got, expected, label)
    if got != expected
        print("FAIL " + label + ": got " + got + " expected " + expected)
        exit(1)

fn main()
    // ---- build the shared tree used in most KATs ----
    // Insert: [1,5], [10,15], [3,8]
    let t = intervaltree.it_new()
    intervaltree.it_insert(t, 1, 5)
    intervaltree.it_insert(t, 10, 15)
    intervaltree.it_insert(t, 3, 8)

    // KAT 1: it_size == 3
    cki(intervaltree.it_size(t), 3, "kat1: size==3")

    // KAT 2: it_contains_point(t, 4) == true (covered by [1,5] and [3,8])
    cki(intervaltree.it_contains_point(t, 4), 1, "kat2: contains_point(4)==true")

    // KAT 3: it_contains_point(t, 9) == false (gap between [3,8] and [10,15])
    cki(intervaltree.it_contains_point(t, 9), 0, "kat3: contains_point(9)==false")

    // KAT 4: it_overlaps(t, 6, 11) == true ([3,8] overlaps [6,11] and [10,15] overlaps [6,11])
    cki(intervaltree.it_overlaps(t, 6, 11), 1, "kat4: overlaps(6,11)==true")

    // KAT 5: it_overlaps(t, 16, 20) == false (no interval reaches 16+)
    cki(intervaltree.it_overlaps(t, 16, 20), 0, "kat5: overlaps(16,20)==false")

    // KAT 6: it_query_point(t, 4) returns exactly 2 intervals ([1,5] and [3,8])
    let hits = intervaltree.it_query_point(t, 4)
    cki(len(hits), 2, "kat6: query_point(4) len==2")

    // KAT 7: it_merge_overlapping -> [[1,8],[10,15]]
    // [1,5] and [3,8] overlap -> merge to [1,8]; [10,15] stays separate
    let merged = intervaltree.it_merge_overlapping(t)
    cki(len(merged), 2, "kat7: merge_overlapping count==2")
    let m0 = merged[0]
    let m1 = merged[1]
    cki(m0[0], 1,  "kat7: merged[0].lo==1")
    cki(m0[1], 8,  "kat7: merged[0].hi==8")
    cki(m1[0], 10, "kat7: merged[1].lo==10")
    cki(m1[1], 15, "kat7: merged[1].hi==15")

    // KAT 8: edge case — empty tree
    let t2 = intervaltree.it_new()
    cki(intervaltree.it_size(t2), 0, "kat8: empty size==0")
    cki(intervaltree.it_contains_point(t2, 5), 0, "kat8: empty contains_point==false")
    cki(intervaltree.it_overlaps(t2, 1, 10), 0, "kat8: empty overlaps==false")
    let hits2 = intervaltree.it_query_point(t2, 5)
    cki(len(hits2), 0, "kat8: empty query_point len==0")
    let merged2 = intervaltree.it_merge_overlapping(t2)
    cki(len(merged2), 0, "kat8: empty merge_overlapping len==0")

    // KAT 9: point interval — single point [7,7]
    let t3 = intervaltree.it_new()
    intervaltree.it_insert(t3, 7, 7)
    cki(intervaltree.it_contains_point(t3, 7), 1, "kat9: point [7,7] contains 7")
    cki(intervaltree.it_contains_point(t3, 6), 0, "kat9: point [7,7] not contains 6")
    cki(intervaltree.it_contains_point(t3, 8), 0, "kat9: point [7,7] not contains 8")
    cki(intervaltree.it_overlaps(t3, 7, 7), 1, "kat9: point [7,7] overlaps [7,7]")
    cki(intervaltree.it_overlaps(t3, 8, 9), 0, "kat9: point [7,7] not overlaps [8,9]")
    let mg3 = intervaltree.it_merge_overlapping(t3)
    cki(len(mg3), 1, "kat9: single-point merge len==1")
    let mg3a = mg3[0]
    cki(mg3a[0], 7, "kat9: single-point merge lo==7")
    cki(mg3a[1], 7, "kat9: single-point merge hi==7")

    // KAT 10: three perfectly-merging intervals -> one merged result
    let t4 = intervaltree.it_new()
    intervaltree.it_insert(t4, 5, 10)
    intervaltree.it_insert(t4, 1, 6)
    intervaltree.it_insert(t4, 8, 15)
    let mg4 = intervaltree.it_merge_overlapping(t4)
    cki(len(mg4), 1, "kat10: all three merge to one")
    let mg4a = mg4[0]
    cki(mg4a[0], 1,  "kat10: merged lo==1")
    cki(mg4a[1], 15, "kat10: merged hi==15")

    print("_intervaltree_test passed")

main()
