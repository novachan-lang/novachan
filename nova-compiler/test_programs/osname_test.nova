// Platform identity: os_name()/arch_name() enable conditional code by OS/arch. Both
// branches of an `if os_name() == ...` still type-check (NOVA's win over textual #if).

fn platform_greeting()
    if os_name() == "windows"
        return "Hello from Windows"
    if os_name() == "linux"
        return "Hello from Linux"
    if os_name() == "macos"
        return "Hello from macOS"
    return "Hello from elsewhere"

fn main()
    // this build runs on Windows
    assert_eq(os_name(), "windows")
    assert_eq(platform_greeting(), "Hello from Windows")

    let a = arch_name()
    let known = 0
    if a == "x86_64"
        known = 1
    if a == "arm64"
        known = 1
    assert_eq(known, 1)

    print("osname passed")
