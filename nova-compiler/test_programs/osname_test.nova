// Platform identity: os_name()/arch_name() enable conditional code by OS/arch. Both
// branches of an `if os_name() == ...` still type-check (NOVA's win over textual #if).
//
// PORTABILITY: this test used to hardcode `assert_eq(os_name(), "windows")` with the note
// "this build runs on Windows". That was true of the only machine it ever ran on, and it made
// the test fail on Linux and macOS the moment the suite went cross-platform -- reporting a
// PLATFORM DIFFERENCE as a NOVA defect. What the test actually needs to prove is that
// os_name() returns a RECOGNISED platform and that dispatch on it AGREES with that value; both
// hold on every OS. Asserting the host is a stronger claim than the feature makes, and a test
// must not assert more than the thing it guards.

fn platform_greeting()
    if os_name() == "windows"
        return "Hello from Windows"
    if os_name() == "linux"
        return "Hello from Linux"
    if os_name() == "macos"
        return "Hello from macOS"
    return "Hello from elsewhere"

fn expected_greeting(os: string) -> string
    if os == "windows"
        return "Hello from Windows"
    if os == "linux"
        return "Hello from Linux"
    if os == "macos"
        return "Hello from macOS"
    return "Hello from elsewhere"

fn main()
    let os = os_name()

    // 1. the OS is one this build knows about -- catches an empty/garbage os_name(), which is
    //    what a broken native-target resolution actually looks like.
    let os_known = 0
    if os == "windows"
        os_known = 1
    if os == "linux"
        os_known = 1
    if os == "macos"
        os_known = 1
    assert_eq(os_known, 1)

    // 2. dispatch AGREES with os_name(). This is the real property: the branches select on the
    //    same value the runtime reports, so conditional-by-OS code cannot silently take the
    //    wrong arm. It holds identically on all three platforms.
    assert_eq(platform_greeting(), expected_greeting(os))

    // 3. os_name() is STABLE across calls -- platform_greeting() calls it up to three times, so
    //    a non-deterministic answer would make dispatch unpredictable rather than merely wrong.
    assert_eq(os_name(), os)

    let a = arch_name()
    let known = 0
    if a == "x86_64"
        known = 1
    if a == "arm64"
        known = 1
    assert_eq(known, 1)

    print("osname passed on " + os + "/" + a)
