fn main()
    // Test bitwise XOR and shift operations in NOVA
    let s = 7
    s = s ^ (s << 13)
    print("after xor<<13: " + str(s))
    s = s ^ (s >> 17)
    print("after xor>>17: " + str(s))
    s = s ^ (s << 5)
    print("after xor<<5: " + str(s))
    s = s & 0xFFFFFFFF
    print("after &0xFFFFFFFF: " + str(s))
