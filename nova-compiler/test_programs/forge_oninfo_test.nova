// Forge T4.10 (on_info): a monitored child's EXIT is forwarded into a GenServer, whose handler reacts
// to the out-of-band DOWN message (matched like any other message). This is the LiveView/Presence hook
// -- a server learns when a tracked process dies. Socketless (spawn/monitor/channel), kill-on-timeout.
import forge_otp

type ChildDown
    id: int
type GetDowns
    z: int

fn quick_child()
    0      // exits normally -> triggers the DOWN forward

// server handler: count DOWN notifications (out-of-band), answer GetDowns.
fn track_handle(state, msg)
    match msg
        ChildDown(id) =>
            [state + 1, state + 1]
        GetDowns(z) =>
            [state, state]

fn main()
    let srv = server(0, track_handle)
    gen_start(srv)
    monitor_into(srv, quick_child, ChildDown(7))   // child exits -> ChildDown cast into srv
    monitor_into(srv, quick_child, ChildDown(8))
    sleep(200)
    let downs = call(srv, GetDowns(0))
    if downs != 2
        print("FAIL: expected 2 DOWN notifications, got " + str(downs))
        exit(1)
    print("PASS forge_oninfo (2 monitored child exits forwarded to the server handler)")
