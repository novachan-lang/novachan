// forge_pg_params_test -- PARAMETERIZED queries (PG extended protocol), the INJECTION-SAFE path. Binds a
// classic SQL-injection payload as a parameter and asserts the server returns it as a LITERAL string (never
// executed) -- the production-grade guarantee that pg_exec's raw-string simple-query path lacks. Needs the
// live server + valid creds (PGUSER/PGPASSWORD env); without them it validates the structured error path.
import forge_pg

fn _envor(name: string, dflt: string) -> string
    let v = env(name)
    if len(v) > 0
        return v
    dflt

fn main()
    let host = _envor("PGHOST", "127.0.0.1")
    let port = parse_int(_envor("PGPORT", "5432"))
    let user = _envor("PGUSER", "postgres")
    let db = _envor("PGDATABASE", "postgres")
    let password = _envor("PGPASSWORD", "postgres")
    let r = pg_connect(host, port, user, db, password)
    match r
        Ok(conn) =>
            // $2 carries a SQL-injection attempt. With parameterized binding it is a VALUE, never SQL.
            let evil = "x'; DROP TABLE forge_pg_no_such; --"
            let q = pg_query_params(conn, "SELECT $1::int AS n, $2::text AS s, $1::int + 8 AS m", ["34", evil])
            match q
                Ok(rows) =>
                    if len(rows) < 1
                        print("FAIL: parameterized SELECT returned no rows")
                        exit(1)
                    print("row: n=" + rows[0]["n"] + " m=" + rows[0]["m"] + " s=" + rows[0]["s"])
                    assert_eq(rows[0]["n"], "34")
                    assert_eq(rows[0]["m"], "42")
                    // THE injection-safety proof: the payload came back verbatim as data, not executed.
                    assert_eq(rows[0]["s"], evil)
                    print("PARAMETERIZED QUERY OK -- injection payload preserved as a literal value (injection-safe)")
                Err(e) =>
                    print("FAIL: parameterized query: " + e)
                    exit(1)
            // a second call proves the unnamed statement/portal reuse across queries on one connection
            let q2 = pg_query_params(conn, "SELECT $1::text AS greeting", ["hello params"])
            match q2
                Ok(rows2) =>
                    assert_eq(rows2[0]["greeting"], "hello params")
                    print("second parameterized query OK (statement reuse)")
                Err(e) =>
                    print("FAIL: second parameterized query: " + e)
                    exit(1)
            pg_close(conn)
            print("LIVE PARAMETERIZED + INJECTION-SAFE round-trip OK")
        Err(e) =>
            print("connect returned a structured error: " + e)
            assert(starts_with(e, "pg:"), "structured pg: error (set PGUSER/PGPASSWORD for the full test)")
            print("PARAMS PLUMBING OK (needs valid creds for the full injection-safety round-trip)")
    print("forge_pg_params_test passed")
