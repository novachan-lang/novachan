import forge_metric_aggregator

fn main()
    let m = ma_new()
    m = ma_record(m, "latency", 100)
    m = ma_record(m, "latency", 200)
    m = ma_record(m, "latency", 150)
    m = ma_record(m, "errors", 5)

    let c = ma_count(m, "latency")
    assert(is_ok(c), "count ok")
    assert(unwrap(c) == 3, "3 latency records")

    let s = ma_sum(m, "latency")
    assert(is_ok(s), "sum ok")
    assert(unwrap(s) == 450, "sum 450")

    let avg = ma_mean(m, "latency")
    assert(is_ok(avg), "mean ok")
    assert(unwrap(avg) == 150, "mean 150")

    let mn = ma_min(m, "latency")
    assert(is_ok(mn), "min ok")
    assert(unwrap(mn) == 100, "min 100")

    let mx = ma_max(m, "latency")
    assert(is_ok(mx), "max ok")
    assert(unwrap(mx) == 200, "max 200")

    assert(ma_metric_count(m) == 2, "2 metrics")

    let bad = ma_count(m, "nope")
    assert(is_err(bad), "unknown metric")

    print("METRIC-AGGREGATOR KAT PASS")
