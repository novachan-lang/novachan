import forge_model_evaluator

fn main()
    let s = mev_new()
    assert(mev_total(s) == 0, "no predictions yet")

    s = mev_record(s, "cat", "cat")
    s = mev_record(s, "cat", "cat")
    s = mev_record(s, "cat", "dog")
    s = mev_record(s, "dog", "dog")
    s = mev_record(s, "dog", "dog")
    s = mev_record(s, "dog", "cat")
    s = mev_record(s, "bird", "dog")

    assert(mev_total(s) == 7, "7 predictions")
    assert(mev_correct(s) == 4, "4 correct (2 cat + 2 dog)")

    let acc = mev_accuracy(s)
    assert(is_ok(acc), "accuracy ok")
    assert(unwrap(acc) == 57, "57 percent accuracy (4/7)")

    // cat actual occurs 3 times (rows: cat/cat, cat/cat, dog/cat), 2 correct
    assert(mev_class_count(s, "cat") == 3, "3 actual cat instances")
    assert(mev_class_correct(s, "cat") == 2, "2 correct cat predictions")

    let cat_acc = mev_class_accuracy(s, "cat")
    assert(is_ok(cat_acc), "cat class accuracy ok")
    assert(unwrap(cat_acc) == 66, "66 percent cat accuracy (2/3)")

    // dog actual occurs 4 times (cat/dog, dog/dog, dog/dog, bird/dog), 2 correct
    assert(mev_class_count(s, "dog") == 4, "4 actual dog instances")
    assert(mev_class_correct(s, "dog") == 2, "2 correct dog predictions")

    let dog_acc = mev_class_accuracy(s, "dog")
    assert(is_ok(dog_acc), "dog class accuracy ok")
    assert(unwrap(dog_acc) == 50, "50 percent dog accuracy (2/4)")

    // bird was only ever predicted, never actual -> 0 ground-truth instances
    assert(mev_class_count(s, "bird") == 0, "bird never occurs as ground truth")
    let bird_acc = mev_class_accuracy(s, "bird")
    assert(is_err(bird_acc), "bird class accuracy undefined (0 support)")

    let unseen_acc = mev_class_accuracy(s, "fish")
    assert(is_err(unseen_acc), "never-seen class accuracy is an error")
    assert(mev_class_count(s, "fish") == 0, "never-seen class count is 0")

    let conf1 = mev_confusion(s, "dog", "cat")
    assert(is_ok(conf1), "confusion lookup ok")
    assert(unwrap(conf1) == 1, "1 dog-predicted-for-cat confusion")

    let conf2 = mev_confusion(s, "bird", "dog")
    assert(unwrap(conf2) == 1, "1 bird-predicted-for-dog confusion")

    let conf3 = mev_confusion(s, "fish", "fish")
    assert(unwrap(conf3) == 0, "never-seen confusion pair is 0")

    let classes = mev_class_list(s)
    assert(contains(classes, "cat") == true, "class list has cat")
    assert(contains(classes, "dog") == true, "class list has dog")
    assert(contains(classes, "bird") == true, "class list has bird")

    print("MODEL-EVALUATOR KAT PASS")
