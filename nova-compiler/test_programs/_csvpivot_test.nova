// KAT test for std/data/csvpivot
import std/data/csvpivot

fn main()
    // ── Test data ────────────────────────────────────────────────────────────
    let rows = []
    rows.push({"r": "a", "c": "x", "v": "2"})
    rows.push({"r": "a", "c": "x", "v": "3"})
    rows.push({"r": "a", "c": "y", "v": "4"})
    rows.push({"r": "b", "c": "x", "v": "5"})

    // ── cpv_pivot_sum ────────────────────────────────────────────────────────
    let p = cpv_pivot_sum(rows, "r", "c", "v")

    // KAT 1: p["a"]["x"] == 5  (2+3)
    let pa = p["a"]
    let pa_x = pa["x"]
    if pa_x != 5
        print("FAIL KAT1: p[a][x] expected 5 got " + str(pa_x))
        exit(1)

    // KAT 2: p["a"]["y"] == 4
    let pa_y = pa["y"]
    if pa_y != 4
        print("FAIL KAT2: p[a][y] expected 4 got " + str(pa_y))
        exit(1)

    // KAT 3: p["b"]["x"] == 5
    let pb = p["b"]
    let pb_x = pb["x"]
    if pb_x != 5
        print("FAIL KAT3: p[b][x] expected 5 got " + str(pb_x))
        exit(1)

    // ── cpv_pivot_count ──────────────────────────────────────────────────────
    let q = cpv_pivot_count(rows, "r", "c")

    // KAT 4: q["a"]["x"] == 2
    let qa = q["a"]
    let qa_x = qa["x"]
    if qa_x != 2
        print("FAIL KAT4: q[a][x] expected 2 got " + str(qa_x))
        exit(1)

    // KAT 5: q["a"]["y"] == 1
    let qa_y = qa["y"]
    if qa_y != 1
        print("FAIL KAT5: q[a][y] expected 1 got " + str(qa_y))
        exit(1)

    // KAT 6: q["b"]["x"] == 1
    let qb = q["b"]
    let qb_x = qb["x"]
    if qb_x != 1
        print("FAIL KAT6: q[b][x] expected 1 got " + str(qb_x))
        exit(1)

    // ── cpv_row_labels ───────────────────────────────────────────────────────
    // KAT 7: cpv_row_labels(p) == ["a","b"]
    let rl = cpv_row_labels(p)
    if len(rl) != 2
        print("FAIL KAT7a: row_labels len expected 2 got " + str(len(rl)))
        exit(1)
    if rl[0] != "a"
        print("FAIL KAT7b: row_labels[0] expected a got " + str(rl[0]))
        exit(1)
    if rl[1] != "b"
        print("FAIL KAT7c: row_labels[1] expected b got " + str(rl[1]))
        exit(1)

    // ── cpv_col_labels ───────────────────────────────────────────────────────
    // KAT 8: cpv_col_labels(p) == ["x","y"]
    let cl = cpv_col_labels(p)
    if len(cl) != 2
        print("FAIL KAT8a: col_labels len expected 2 got " + str(len(cl)))
        exit(1)
    if cl[0] != "x"
        print("FAIL KAT8b: col_labels[0] expected x got " + str(cl[0]))
        exit(1)
    if cl[1] != "y"
        print("FAIL KAT8c: col_labels[1] expected y got " + str(cl[1]))
        exit(1)

    // ── Extra: skips rows missing keys ───────────────────────────────────────
    // KAT 9: row missing rowKey is skipped
    let rows2 = []
    rows2.push({"c": "x", "v": "9"})
    rows2.push({"r": "z", "c": "x", "v": "7"})
    let p2 = cpv_pivot_sum(rows2, "r", "c", "v")
    let rl2 = cpv_row_labels(p2)
    if len(rl2) != 1
        print("FAIL KAT9a: expected 1 row label got " + str(len(rl2)))
        exit(1)
    if rl2[0] != "z"
        print("FAIL KAT9b: expected row label z got " + rl2[0])
        exit(1)
    let pz = p2["z"]
    let pz_x = pz["x"]
    if pz_x != 7
        print("FAIL KAT9c: expected p2[z][x]=7 got " + str(pz_x))
        exit(1)

    // KAT 10: pivot_count on empty rows -> no row labels
    let rows3 = []
    let q3 = cpv_pivot_count(rows3, "r", "c")
    let rl3 = cpv_row_labels(q3)
    if len(rl3) != 0
        print("FAIL KAT10: expected empty row labels got " + str(len(rl3)))
        exit(1)

    print("_csvpivot_test passed")
