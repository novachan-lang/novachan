// KAT for std/io/linereader
import std/io/linereader

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn main()
    let text3 = "a" + chr(10) + "b" + chr(10) + "c"
    let lr = lr_new(text3)

    cki("has_next_initial", lr_has_next(lr), 1)
    cki("line_no_initial", lr_line_no(lr), 1)

    let got_a = lr_next(lr)
    cks("next_a", got_a, "a")

    let got_peek_b = lr_peek(lr)
    cks("peek_b", got_peek_b, "b")

    cki("line_no_after_a", lr_line_no(lr), 2)

    let got_b = lr_next(lr)
    cks("next_b", got_b, "b")

    let got_c = lr_next(lr)
    cks("next_c", got_c, "c")

    cki("has_next_after_all", lr_has_next(lr), 0)
    cki("remaining_at_end", lr_remaining(lr), 0)

    lr_reset(lr)
    let got_a2 = lr_next(lr)
    cks("reset_next_a", got_a2, "a")

    lr_reset(lr)
    lr_next(lr)
    let rest = lr_all(lr)
    cki("all_len", len(rest), 2)
    cks("all_0", rest[0], "b")
    cks("all_1", rest[1], "c")

    let lr2 = lr_new("x")
    cki("single_remaining", lr_remaining(lr2), 1)
    let got_x = lr_next(lr2)
    cks("single_next", got_x, "x")
    cki("single_exhausted", lr_has_next(lr2), 0)
    cki("single_remaining_after", lr_remaining(lr2), 0)

    let got_peek_empty = lr_peek(lr2)
    cks("peek_empty", got_peek_empty, "")

    let lr3 = lr_new("")
    cki("empty_remaining", lr_remaining(lr3), 1)
    let got_empty_line = lr_next(lr3)
    cks("empty_line_val", got_empty_line, "")
    cki("empty_exhausted", lr_has_next(lr3), 0)

    print("_linereader_test passed")
