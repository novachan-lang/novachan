fn test_poll_create_close()
  let p = io_poll_create()
  assert(p >= 0, "io_poll_create returns valid handle: " + str(p))
  let r = io_poll_close(p)
  assert(r == 0, "io_poll_close ok")
  print("  create/close: PASS")

fn test_poll_timeout()
  let p = io_poll_create()
  assert(p >= 0, "poll created")
  let events = io_poll_wait(p, 10)
  assert(len(events) == 0, "no events on empty poll: " + str(len(events)))
  io_poll_close(p)
  print("  timeout: PASS")

fn test_nonblocking_socket()
  let server = tcp_listen(0)
  assert(server >= 0, "tcp_listen ok")
  let r = io_set_nonblocking(server)
  assert(r == 0, "set nonblocking ok: " + str(r))
  tcp_close(server)
  print("  nonblocking: PASS")

fn test_poll_with_server()
  let server = tcp_listen(19876)
  assert(server >= 0, "listen ok")
  io_set_nonblocking(server)

  let p = io_poll_create()
  assert(p >= 0, "poll created")

  let add_r = io_poll_add(p, server, 1)
  assert(add_r == 0, "poll_add ok: " + str(add_r))

  // Connect in a spawned process
  spawn
    sleep(50)
    let c = tcp_connect("127.0.0.1", 19876)
    if c >= 0
      tcp_send(c, "hello")
      tcp_close(c)

  // Wait for the connection event
  let events = io_poll_wait(p, 2000)
  assert(len(events) > 0, "got events from poll: " + str(len(events)))

  let ev = events[0]
  let ev_fd = ev[0]
  assert(ev_fd == server, "event on server fd")

  // Accept the connection
  let client = tcp_accept(server)
  assert(client >= 0, "accepted client")
  let data = tcp_recv(client)
  assert(data == "hello", "received data: " + str(data))

  tcp_close(client)
  tcp_close(server)
  io_poll_close(p)
  sleep(100)
  print("  poll with server: PASS")

fn main()
  test_poll_create_close()
  test_poll_timeout()
  test_nonblocking_socket()
  test_poll_with_server()
  print("io_poll_test: all passed")
