// ============================================================================
// KAT for std/term/box
// Tests: box(), box_titled(), hrule() with ascii and unicode styles.
// All assertions compare exact string output.
// ============================================================================
import std/term/box

// Helper: compare two lists of strings for equality.
fn _leq(a, b) -> bool
    if len(a) != len(b)
        let r = 0 == 1
        r
    else
        let ok = 1
        let i = 0
        while i < len(a) and ok == 1
            if a[i] != b[i]
                ok = 0
            i = i + 1
        ok == 1

fn main()
    // ── KAT 1: box(["hi"], "ascii") == ["+----+", "| hi |", "+----+"] ─────────
    // inner=2, span=4: top has 4 hyphens between corners.
    let lines1 = ["hi"]
    let got1 = box(lines1, "ascii")
    let w1top = "+----+"
    let w1mid = "| hi |"
    let w1bot = "+----+"
    if got1[0] != w1top
        print("FAIL box KAT1 top: got=[" + got1[0] + "] want=[" + w1top + "]")
        exit(1)
    if got1[1] != w1mid
        print("FAIL box KAT1 mid: got=[" + got1[1] + "] want=[" + w1mid + "]")
        exit(1)
    if got1[2] != w1bot
        print("FAIL box KAT1 bot: got=[" + got1[2] + "] want=[" + w1bot + "]")
        exit(1)
    if len(got1) != 3
        print("FAIL box KAT1 count: got=" + str(len(got1)) + " want=3")
        exit(1)

    // ── KAT 2: box(["ab","c"], "ascii") — "c" padded to width 2 ─────────────
    // inner=2: "ab" stays "ab", "c" -> "c " (one space appended).
    let lines2 = ["ab", "c"]
    let got2 = box(lines2, "ascii")
    let w2top = "+----+"
    let w2m0  = "| ab |"
    let w2m1  = "| c  |"
    let w2bot = "+----+"
    if got2[0] != w2top
        print("FAIL box KAT2 top: got=[" + got2[0] + "] want=[" + w2top + "]")
        exit(1)
    if got2[1] != w2m0
        print("FAIL box KAT2 m0: got=[" + got2[1] + "] want=[" + w2m0 + "]")
        exit(1)
    if got2[2] != w2m1
        print("FAIL box KAT2 m1: got=[" + got2[2] + "] want=[" + w2m1 + "]")
        exit(1)
    if got2[3] != w2bot
        print("FAIL box KAT2 bot: got=[" + got2[3] + "] want=[" + w2bot + "]")
        exit(1)

    // ── KAT 3: exact lengths ─────────────────────────────────────────────────
    // All rows of a box must have equal length.
    // box(["hi"],"ascii") — each row len 6.
    if len(got1[0]) != 6
        print("FAIL box KAT3 top len: got=" + str(len(got1[0])) + " want=6")
        exit(1)
    if len(got1[1]) != 6
        print("FAIL box KAT3 mid len: got=" + str(len(got1[1])) + " want=6")
        exit(1)
    if len(got1[2]) != 6
        print("FAIL box KAT3 bot len: got=" + str(len(got1[2])) + " want=6")
        exit(1)

    // ── KAT 4: box([], "ascii") — empty lines list ───────────────────────────
    // inner=0, span=2: top="+--+", bot="+--+", no body rows.
    let lines4 = []
    let got4 = box(lines4, "ascii")
    if len(got4) != 2
        print("FAIL box KAT4 count: got=" + str(len(got4)) + " want=2")
        exit(1)
    let w4top = "+--+"
    if got4[0] != w4top
        print("FAIL box KAT4 top: got=[" + got4[0] + "] want=[" + w4top + "]")
        exit(1)
    if got4[1] != w4top
        print("FAIL box KAT4 bot: got=[" + got4[1] + "] want=[" + w4top + "]")
        exit(1)

    // ── KAT 5: box(["hello"], "ascii") — 5-char word ─────────────────────────
    // inner=5, span=7: top="+-------+", body="| hello |", bot="+-------+"
    let lines5 = ["hello"]
    let got5 = box(lines5, "ascii")
    let w5top = "+-------+"
    let w5mid = "| hello |"
    if got5[0] != w5top
        print("FAIL box KAT5 top: got=[" + got5[0] + "] want=[" + w5top + "]")
        exit(1)
    if got5[1] != w5mid
        print("FAIL box KAT5 mid: got=[" + got5[1] + "] want=[" + w5mid + "]")
        exit(1)

    // ── KAT 6: hrule(3, "ascii") == "---" ─────────────────────────────────────
    let got6 = hrule(3, "ascii")
    if got6 != "---"
        print("FAIL hrule KAT6: got=[" + got6 + "] want=[---]")
        exit(1)

    // ── KAT 7: hrule(0, "ascii") == "" ────────────────────────────────────────
    let got7 = hrule(0, "ascii")
    if len(got7) != 0
        print("FAIL hrule KAT7 empty: got=[" + got7 + "]")
        exit(1)

    // ── KAT 8: hrule(5, "ascii") len == 5 ────────────────────────────────────
    let got8 = hrule(5, "ascii")
    if len(got8) != 5
        print("FAIL hrule KAT8 len: got=" + str(len(got8)) + " want=5")
        exit(1)

    // ── KAT 9: hrule negative width clamps to 0 ──────────────────────────────
    let got9 = hrule(-3, "ascii")
    if len(got9) != 0
        print("FAIL hrule KAT9 neg: got=[" + got9 + "]")
        exit(1)

    // ── KAT 10: box_titled — title fits, width-consistent ────────────────────
    // box_titled(["hi"], "T", "ascii")
    // inner=2, span=4
    // max_title = span-3 = 1, title "T" len 1 fits.
    // fill = 4 - 1 - 3 = 0
    // top = "+" + "-" + " T " + "" + "+" = "+-T +"  wait: "+" + "-" + " " + "T" + " " + "" + "+"
    //      = "+-" + " T " + "+" = "+- T +"  (6 chars total)
    // That's 6 chars — same as box(["hi"],"ascii") top. Good.
    let lines10 = ["hi"]
    let got10 = box_titled(lines10, "T", "ascii")
    let box_top10 = box(lines10, "ascii")[0]
    // titled top must have same length as plain box top
    if len(got10[0]) != len(box_top10)
        print("FAIL box_titled KAT10 width: titled_top_len=" + str(len(got10[0])) + " box_top_len=" + str(len(box_top10)))
        exit(1)
    // title "T" must appear somewhere in the top row
    let found10 = 0
    let ti10 = 0
    while ti10 < len(got10[0])
        if slice(got10[0], ti10, ti10 + 1) == "T"
            found10 = 1
        ti10 = ti10 + 1
    if found10 != 1
        print("FAIL box_titled KAT10 title not found: top=[" + got10[0] + "]")
        exit(1)

    // ── KAT 11: box_titled — body rows still padded correctly ─────────────────
    // box_titled(["ab","c"], "X", "ascii")
    // body rows must equal those from box(["ab","c"],"ascii")
    let lines11 = ["ab", "c"]
    let got11 = box_titled(lines11, "X", "ascii")
    if got11[1] != "| ab |"
        print("FAIL box_titled KAT11 m0: got=[" + got11[1] + "] want=[| ab |]")
        exit(1)
    if got11[2] != "| c  |"
        print("FAIL box_titled KAT11 m1: got=[" + got11[2] + "] want=[| c  |]")
        exit(1)

    // ── KAT 12: box_titled — empty title falls back to plain top ─────────────
    let lines12 = ["hi"]
    let got12 = box_titled(lines12, "", "ascii")
    let plain12 = box(lines12, "ascii")[0]
    if got12[0] != plain12
        print("FAIL box_titled KAT12 empty-title: got=[" + got12[0] + "] want=[" + plain12 + "]")
        exit(1)

    // ── KAT 13: box "single" style — tl char is 3-byte UTF-8 "┌" ─────────────
    let lines13 = ["x"]
    let got13 = box(lines13, "single")
    // "┌" is 3 UTF-8 bytes; slice(s,0,3) should equal "┌"
    let tl13 = slice(got13[0], 0, 3)
    if tl13 != "┌"
        print("FAIL box KAT13 single tl: got=[" + tl13 + "]")
        exit(1)

    // ── KAT 14: box "double" style — tl char is "╔" ─────────────────────────
    let lines14 = ["x"]
    let got14 = box(lines14, "double")
    let tl14 = slice(got14[0], 0, 3)
    if tl14 != "╔"
        print("FAIL box KAT14 double tl: got=[" + tl14 + "]")
        exit(1)

    // ── KAT 15: box "round" style — tl char is "╭" ───────────────────────────
    let lines15 = ["x"]
    let got15 = box(lines15, "round")
    let tl15 = slice(got15[0], 0, 3)
    if tl15 != "╭"
        print("FAIL box KAT15 round tl: got=[" + tl15 + "]")
        exit(1)

    // ── KAT 16: hrule "single" — repeats "─" (3 bytes each) ──────────────────
    let got16 = hrule(3, "single")
    // 3 repetitions of "─" (3 bytes each) = 9 bytes total
    let want16_bytes = len("─") * 3
    if len(got16) != want16_bytes
        print("FAIL hrule KAT16 single len: got=" + str(len(got16)) + " want=" + str(want16_bytes))
        exit(1)

    // ── KAT 17: multi-line box row-count ─────────────────────────────────────
    // box with 3 content lines -> 3 + 2 = 5 output lines
    let lines17 = ["one", "two", "three"]
    let got17 = box(lines17, "ascii")
    if len(got17) != 5
        print("FAIL box KAT17 count: got=" + str(len(got17)) + " want=5")
        exit(1)
    // inner=5 (len("three")); all rows len = 5+2+2 = 9
    if len(got17[0]) != 9
        print("FAIL box KAT17 top len: got=" + str(len(got17[0])) + " want=9")
        exit(1)
    if len(got17[1]) != 9
        print("FAIL box KAT17 m0 len: got=" + str(len(got17[1])) + " want=9")
        exit(1)
    // "one" padded to 5 = "one  "
    if got17[1] != "| one   |"
        print("FAIL box KAT17 m0: got=[" + got17[1] + "] want=[| one   |]")
        exit(1)

    print("PASS _box_test")
