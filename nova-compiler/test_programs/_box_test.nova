// KAT for std/text/box -- box_draw and box_draw_titled
import std/text/box

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// Helper: count how many chr(10) are in s (i.e. number_of_lines - 1).
fn count_nl(s: string) -> int
    let n = len(s)
    let nl = chr(10)
    let c = 0
    let i = 0
    while i < n
        if char_at(s, i) == nl
            c = c + 1
        i = i + 1
    c

// Helper: extract line idx (0-based) from a box_draw result (split on chr(10)).
fn line_at(s: string, idx: int) -> string
    let nl = chr(10)
    let parts = split(s, nl)
    parts[idx]

fn main()
    // ── Test 1: box_draw(["hi"]) ─────────────────────────────────────────────
    // inner=2, span=4 -> top="+----+" mid="| hi |" bot="+----+"
    let b1 = box_draw(["hi"])

    // Should have exactly 3 lines (2 newlines).
    cki("b1-linecount", count_nl(b1), 2)

    // Top line
    cks("b1-top",    line_at(b1, 0), "+----+")
    // Middle line
    cks("b1-mid",    line_at(b1, 1), "| hi |")
    // Bottom line
    cks("b1-bot",    line_at(b1, 2), "+----+")

    // All lines must have equal length (= 6 chars)
    cki("b1-toplen", len(line_at(b1, 0)), 6)
    cki("b1-midlen", len(line_at(b1, 1)), 6)
    cki("b1-botlen", len(line_at(b1, 2)), 6)

    // ── Test 2: box_draw(["a","bbb"]) ────────────────────────────────────────
    // inner=3, span=5 -> top="+-----+" content: "| a   |" and "| bbb |"
    let b2 = box_draw(["a", "bbb"])

    // Should have 4 lines (3 newlines).
    cki("b2-linecount", count_nl(b2), 3)

    // Top line
    cks("b2-top",  line_at(b2, 0), "+-----+")
    // "a" padded to width 3 -> "a  "; row = "| a   |"
    cks("b2-row0", line_at(b2, 1), "| a   |")
    // "bbb" already width 3; row = "| bbb |"
    cks("b2-row1", line_at(b2, 2), "| bbb |")
    // Bottom line
    cks("b2-bot",  line_at(b2, 3), "+-----+")

    // All four lines must have equal length (= 7 chars)
    cki("b2-toplen",  len(line_at(b2, 0)), 7)
    cki("b2-row0len", len(line_at(b2, 1)), 7)
    cki("b2-row1len", len(line_at(b2, 2)), 7)
    cki("b2-botlen",  len(line_at(b2, 3)), 7)

    // ── Test 3: box_draw_titled -- title fits in top border ──────────────────
    // box_draw_titled("Hi", ["abc"])
    // title_seg="-[ Hi ]-" (8 chars), seg_len=8,
    // inner=3, min_span=max(5,8)=8, trailing=0
    // top="+-[ Hi ]-+"  (10 chars)
    // content_width=6 -> ljust("abc",6)="abc   " -> "| abc    |" (10 chars)
    // bot="+---------+" (10 chars)
    let b3 = box_draw_titled("Hi", ["abc"])

    // top="+-[ Hi ]-+" (10), bot="+--------+" (10), mid="| abc    |" (10)
    cki("b3-linecount", count_nl(b3), 2)
    cks("b3-top",  line_at(b3, 0), "+-[ Hi ]-+")
    cks("b3-mid",  line_at(b3, 1), "| abc    |")
    cks("b3-bot",  line_at(b3, 2), "+--------+")

    // All lines same length (10)
    cki("b3-toplen", len(line_at(b3, 0)), 10)
    cki("b3-midlen", len(line_at(b3, 1)), 10)
    cki("b3-botlen", len(line_at(b3, 2)), 10)

    // ── Test 4: box_draw_titled -- content wider than title ──────────────────
    // box_draw_titled("X", ["hello world"])
    // inner=11, title_seg="-[ X ]-" (7 chars), min_span=max(13,7)=13, trailing=6
    // top="+-[ X ]------+"  (15 chars)
    // bot="+-------------+" (15 chars)
    // content_width=11 -> ljust("hello world",11)="hello world" -> "| hello world |" (15)
    let b4 = box_draw_titled("X", ["hello world"])

    // top="+-[ X ]-------+" (15), mid="| hello world |" (15), bot="+-------------+" (15)
    cki("b4-linecount", count_nl(b4), 2)
    cks("b4-top",  line_at(b4, 0), "+-[ X ]-------+")
    cks("b4-mid",  line_at(b4, 1), "| hello world |")
    cks("b4-bot",  line_at(b4, 2), "+-------------+")

    // All lines same length (15)
    cki("b4-toplen", len(line_at(b4, 0)), 15)
    cki("b4-midlen", len(line_at(b4, 1)), 15)
    cki("b4-botlen", len(line_at(b4, 2)), 15)

    // ── Test 5: box_draw with a single wide line ──────────────────────────────
    // box_draw(["NOVA"]) -> inner=4, span=6
    // top="+------+"  (8 chars)
    // mid="| NOVA |"  (8 chars)
    // bot="+------+"  (8 chars)
    let b5 = box_draw(["NOVA"])
    cki("b5-linecount", count_nl(b5), 2)
    cks("b5-top", line_at(b5, 0), "+------+")
    cks("b5-mid", line_at(b5, 1), "| NOVA |")
    cks("b5-bot", line_at(b5, 2), "+------+")

    // ── Test 6: box_draw with three lines of different widths ─────────────────
    // box_draw(["cat","elephant","dog"])
    // inner=max(3,8,3)=8, span=10
    // top="+----------+"  (12 chars)
    // "cat"      padded to 8 = "cat     " -> "| cat      |" (12)
    // "elephant" padded to 8 = "elephant" -> "| elephant |" (12)
    // "dog"      padded to 8 = "dog     " -> "| dog      |" (12)
    // bot="+----------+"
    let b6 = box_draw(["cat", "elephant", "dog"])
    cki("b6-linecount", count_nl(b6), 4)
    cks("b6-top",  line_at(b6, 0), "+----------+")
    cks("b6-row0", line_at(b6, 1), "| cat      |")
    cks("b6-row1", line_at(b6, 2), "| elephant |")
    cks("b6-row2", line_at(b6, 3), "| dog      |")
    cks("b6-bot",  line_at(b6, 4), "+----------+")

    // All 5 lines same length (12)
    cki("b6-toplen",  len(line_at(b6, 0)), 12)
    cki("b6-row0len", len(line_at(b6, 1)), 12)
    cki("b6-row1len", len(line_at(b6, 2)), 12)
    cki("b6-row2len", len(line_at(b6, 3)), 12)
    cki("b6-botlen",  len(line_at(b6, 4)), 12)

    print("_box_test passed")
