// WASM Stage 2: NOVA BUILDS a DOM tree via a principled host-binding surface.
// The JS host is a PEER PROCESS; these extern fns are the CHANNEL to it (string args in,
// opaque int node-handles out -- the sound subset, no heterogeneous-any across the boundary).
extern fn dom_get_by_id(id: string) -> int
extern fn dom_create(tag: string) -> int
extern fn dom_set_text(node: int, txt: string)
extern fn dom_set_attr(node: int, k: string, v: string)
extern fn dom_append(parent: int, child: int)

fn main()
    let app = unsafe dom_get_by_id("app")
    let p = unsafe dom_create("p")
    unsafe dom_set_text(p, "Built by NOVA")
    unsafe dom_set_attr(p, "class", "greeting")
    unsafe dom_append(app, p)
