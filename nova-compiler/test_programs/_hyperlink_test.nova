import std/term/hyperlink

fn main()
    let ESC = chr(27)
    let ST  = ESC + chr(92)
    let OSC = ESC + "]"

    // ── KAT 1: link basic structure ──────────────────────────────────────────
    // Expected: ESC]8;;http://x ST go ESC]8;; ST
    let want1 = OSC + "8;;" + "http://x" + ST + "go" + OSC + "8;;" + ST
    let got1  = link("http://x", "go")
    if got1 != want1
        print("FAIL hyperlink link basic: len got=" + str(len(got1)) + " want=" + str(len(want1)))
        exit(1)

    // ── KAT 2: link length check ──────────────────────────────────────────────
    // ESC(1)+](1)+8;;(3)+http://x(8)+ST(2) = 15   opener
    // go(2)                                  = 2    text
    // ESC(1)+](1)+8;;(3)+ST(2)               = 7    closer
    // total = 24
    let gotlen2 = len(got1)
    if gotlen2 != 24
        print("FAIL hyperlink link length: got=" + str(gotlen2) + " want=24")
        exit(1)

    // ── KAT 3: link contains url substring ────────────────────────────────────
    let url3 = "https://nova-lang.org"
    let got3 = link(url3, "NOVA")
    let pos3 = find(got3, url3)
    if pos3 < 0
        print("FAIL hyperlink link url substring not found in result")
        exit(1)

    // ── KAT 4: link contains text substring ───────────────────────────────────
    let text4 = "click me"
    let got4 = link("https://example.com", text4)
    let pos4 = find(got4, text4)
    if pos4 < 0
        print("FAIL hyperlink link text substring not found in result")
        exit(1)

    // ── KAT 5: set_title basic ────────────────────────────────────────────────
    // Expected: ESC]0;hi ST
    let want5 = OSC + "0;" + "hi" + ST
    let got5  = set_title("hi")
    if got5 != want5
        print("FAIL hyperlink set_title basic: len got=" + str(len(got5)) + " want=" + str(len(want5)))
        exit(1)

    // ── KAT 6: set_title length check ─────────────────────────────────────────
    // ESC(1)+](1)+0;(2)+hi(2)+ST(2) = 8
    let gotlen6 = len(got5)
    if gotlen6 != 8
        print("FAIL hyperlink set_title length: got=" + str(gotlen6) + " want=8")
        exit(1)

    // ── KAT 7: link_id includes id= param ─────────────────────────────────────
    // Expected: ESC]8;id=abc;http://x ST go ESC]8;; ST
    let want7 = OSC + "8;id=abc;" + "http://x" + ST + "go" + OSC + "8;;" + ST
    let got7  = link_id("http://x", "go", "abc")
    if got7 != want7
        print("FAIL hyperlink link_id: len got=" + str(len(got7)) + " want=" + str(len(want7)))
        exit(1)

    // ── KAT 8: link_id contains id= substring ─────────────────────────────────
    let pos8 = find(got7, "id=abc")
    if pos8 < 0
        print("FAIL hyperlink link_id id param not found in result")
        exit(1)

    // ── KAT 9: empty url is safe (produces a sequence, does not crash) ─────────
    let got9 = link("", "label")
    let want9_open = OSC + "8;;" + ST
    let pos9 = find(got9, want9_open)
    if pos9 < 0
        print("FAIL hyperlink empty url: opener not found in result")
        exit(1)

    // ── KAT 10: empty url link contains text ──────────────────────────────────
    let pos10 = find(got9, "label")
    if pos10 < 0
        print("FAIL hyperlink empty url: text not found in result")
        exit(1)

    // ── KAT 11: set_title with empty string is safe ────────────────────────────
    let got11  = set_title("")
    let want11 = OSC + "0;" + ST
    if got11 != want11
        print("FAIL hyperlink set_title empty: len got=" + str(len(got11)) + " want=" + str(len(want11)))
        exit(1)

    // ── KAT 12: link closer always has empty url (;; before ST) ─────────────────
    // Both link() and link_id() must close with ESC]8;; ST
    let closer12 = OSC + "8;;" + ST
    let pos12a = find(got1, closer12)
    let pos12b = find(got7, closer12)
    if pos12a < 0
        print("FAIL hyperlink link() missing closer")
        exit(1)
    if pos12b < 0
        print("FAIL hyperlink link_id() missing closer")
        exit(1)

    // ── KAT 13: ST is exactly ESC + backslash, not BEL ────────────────────────
    // ST must NOT contain chr(7) (BEL)
    let bel = chr(7)
    let pos13 = find(got1, bel)
    if pos13 >= 0
        print("FAIL hyperlink link() uses BEL as ST instead of ESC backslash")
        exit(1)

    // ── KAT 14: set_title with longer title ────────────────────────────────────
    let title14 = "My App - Dashboard"
    let got14   = set_title(title14)
    let pos14   = find(got14, title14)
    if pos14 < 0
        print("FAIL hyperlink set_title long: title substring not found")
        exit(1)

    print("PASS _hyperlink_test")
