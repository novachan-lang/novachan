import std/game/maze_aldous_broder

fn main()
    // Debug: test with larger cap via a manual reimplementation trace
    // First, check: does gen(3,3,7) with bigger internal cap pass?
    // Let's count visits in 3x3 with seed 7
    let links = gen(3, 3, 7)
    let total = len(links)
    print("total cells: " + str(total))
    let s = 0
    let i = 0
    while i < total
        s = s + len(links[i])
        i = i + 1
    print("total link entries: " + str(s))
    print("edges (s/2): " + str(s/2))
    // Check which cell has 0 links
    let j = 0
    while j < total
        let ln = len(links[j])
        print("cell " + str(j) + " links: " + str(ln))
        j = j + 1
