// DNS offload: a green task resolving a hostname parks on the blocking-offload
// pool (getaddrinfo has no FD to poll) instead of blocking its carrier. Exercises
// the full cycle: submit -> park -> offload worker resolves -> carrier re-enqueues
// -> resume -> correct result. 8 concurrent green resolves prove the machinery
// (park/unpark, dual to the netpoller) is race-free and returns correct answers.

fn resolver(out)
    let ip = dns_resolve("localhost")
    send(out, ip)

let out = channel()
let n = 8
let i = 0
while i < n
    spawn fn()
        resolver(out)
    i = i + 1

let got = 0
while got < n
    let ip = recv(out)
    assert(ip == "127.0.0.1", "green dns_resolve(localhost) -> 127.0.0.1, got: " + ip)
    got = got + 1
print("DNS offload: 8 concurrent green resolves all = 127.0.0.1")

// dns_resolve directly from the (green) main task
let ip2 = dns_resolve("localhost")
assert(ip2 == "127.0.0.1", "main dns_resolve(localhost)")
print("DNS offload from main: OK")

// interleave: a resolver and a channel ping-pong proceed without the resolve
// stalling the carrier (the resolve parks; the pinger keeps running).
let pingch = channel()
let pongch = channel()
let rdone = channel()
spawn fn()
    let r = dns_resolve("localhost")
    send(rdone, r)
spawn fn()
    let k = 0
    while k < 5
        send(pingch, k)
        recv(pongch)
        k = k + 1
    send(rdone, "ping-done")
spawn fn()
    let k = 0
    while k < 5
        recv(pingch)
        send(pongch, 1)
        k = k + 1
let a = recv(rdone)
let b = recv(rdone)
print("interleave OK: resolve + ping-pong both completed")

print("ALL PASS: DNS offload")
