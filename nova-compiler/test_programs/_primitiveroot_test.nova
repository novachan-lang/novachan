// KAT for std/math/primitiveroot — primitive roots and multiplicative order.
// All expected values are hand-computed.
import std/math/primitiveroot

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let g = "false"
        if got
            g = "true"
        let w = "false"
        if want
            w = "true"
        print("FAIL " + label + ": got " + g + " want " + w)
        exit(1)

fn main()
    // --- prt_phi ---
    // phi(7) = 6  (prime: all 1..6 are coprime)
    cki("phi(7)", prt_phi(7), 6)
    // phi(1) = 1  (by definition)
    cki("phi(1)", prt_phi(1), 1)
    // phi(10) = 4  (coprimes: 1,3,7,9)
    cki("phi(10)", prt_phi(10), 4)
    // phi(11) = 10  (prime)
    cki("phi(11)", prt_phi(11), 10)

    // --- prt_order ---
    // order(2, 7) = 3:  2^1=2, 2^2=4, 2^3=8≡1 (mod 7)
    cki("order(2,7)", prt_order(2, 7), 3)
    // order(3, 7) = 6:  3 is a primitive root mod 7
    cki("order(3,7)", prt_order(3, 7), 6)
    // order(1, 5) = 1:  1^1 = 1 ≡ 1 (mod 5)
    cki("order(1,5)", prt_order(1, 5), 1)
    // order(2, 11) = 10: 2 is a primitive root mod 11
    cki("order(2,11)", prt_order(2, 11), 10)
    // gcd(2,4) = 2 != 1 => -1
    cki("order(2,4)", prt_order(2, 4), -1)

    // --- prt_is_primitive_root ---
    // 3 is a primitive root mod 7 (order=6=phi(7))
    ckb("is_prim_root(3,7)", prt_is_primitive_root(3, 7), true)
    // 2 is NOT a primitive root mod 7 (order=3 != 6)
    ckb("is_prim_root(2,7)", prt_is_primitive_root(2, 7), false)
    // 2 is a primitive root mod 11 (order=10=phi(11))
    ckb("is_prim_root(2,11)", prt_is_primitive_root(2, 11), true)
    // 1 is never a primitive root (order=1, phi>=1 only for n=1 or 2)
    ckb("is_prim_root(1,7)", prt_is_primitive_root(1, 7), false)

    // --- prt_smallest ---
    // smallest primitive root mod 7 = 3
    cki("smallest(7)", prt_smallest(7), 3)
    // smallest primitive root mod 11 = 2
    cki("smallest(11)", prt_smallest(11), 2)
    // smallest primitive root mod 5 = 2
    cki("smallest(5)", prt_smallest(5), 2)
    // smallest primitive root mod 13 = 2
    cki("smallest(13)", prt_smallest(13), 2)

    print("_primitiveroot_test passed")
