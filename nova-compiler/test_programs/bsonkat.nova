// KAT for std/encoding/bson — BSON encode/decode against bsonspec.org vectors.
// Every check helper exits(1) IMMEDIATELY on failure (the proven idiom used
// by _cbor_rfc8949_kat.nova) — NOVA `fn` closures do not reliably share
// mutation of an outer scalar/dict counter, so a deferred failure-count
// pattern silently under-reports. Fail-fast-with-location is the only
// reliable KAT gate.
import std/encoding/bson

fn ckb(label: string, b: any, expected: list)
    let blen = bytes_len(b)
    let elen = len(expected)
    if blen != elen
        print("FAIL " + label + "_len: got " + str(blen) + " want " + str(elen))
        exit(1)
    let i = 0
    while i < elen
        let got = bytes_get(b, i)
        let want = expected[i]
        if got != want
            print("FAIL " + label + "_b" + str(i) + ": got " + str(got) + " want " + str(want))
            exit(1)
        i = i + 1
    print("PASS " + label + "_bytes")

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("PASS " + label)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got '" + got + "' want '" + want + "'")
        exit(1)
    print("PASS " + label)

fn ckf(label: string, got: float, want: float)
    if got != want
        print("FAIL " + label)
        exit(1)
    print("PASS " + label)

fn ckn(label: string, got: any)
    if got != null
        print("FAIL " + label + ": expected null")
        exit(1)
    print("PASS " + label)

fn main()
    // ── KAT 1: {"hello":"world"} -> exact bsonspec.org example bytes ───────
    let d1 = {}
    d1["hello"] = "world"
    let e1 = bson_encode(d1)
    let expect1 = [0x16, 0x00, 0x00, 0x00, 0x02, 0x68, 0x65, 0x6C, 0x6C, 0x6F, 0x00, 0x06, 0x00, 0x00, 0x00, 0x77, 0x6F, 0x72, 0x6C, 0x64, 0x00, 0x00]
    ckb("hello_world", e1, expect1)
    cki("hello_world_len", bytes_len(e1), 22)
    let dec1 = bson_decode(e1)
    cks("hello_world_dec", dec1["hello"], "world")

    // ── KAT 2: {"a":1} -> int32 field, spec byte-exact ──────────────────────
    let d2 = {}
    d2["a"] = 1
    let e2 = bson_encode(d2)
    let expect2 = [0x0C, 0x00, 0x00, 0x00, 0x10, 0x61, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00]
    ckb("a_eq_1", e2, expect2)
    let dec2 = bson_decode(e2)
    cki("a_eq_1_dec", dec2["a"], 1)

    // ── KAT 3: empty document -> 05 00 00 00 00 ─────────────────────────────
    let d3 = {}
    let e3 = bson_encode(d3)
    let expect3 = [0x05, 0x00, 0x00, 0x00, 0x00]
    ckb("empty_doc", e3, expect3)
    let dec3 = bson_decode(e3)
    cki("empty_doc_dec_nkeys", len(keys(dec3)), 0)

    // ── KAT 4: nested document + array + double + bool + null + binary + int64
    let inner = {}
    inner["x"] = 1
    inner["y"] = 2.5

    let arr = [1, 2, 3, "four"]

    let doc4 = {}
    doc4["name"] = "nova"
    doc4["nested"] = inner
    doc4["arr"] = arr
    doc4["pi"] = 3.5
    doc4["flag"] = bson_bool(1)
    doc4["nothing"] = null
    doc4["big"] = bson_long(7)
    doc4["huge"] = 9999999999
    let bin = bytes_create(3)
    bytes_set(bin, 0, 0xDE)
    bytes_set(bin, 1, 0xAD)
    bytes_set(bin, 2, 0xBE)
    doc4["blob"] = bin

    let e4 = bson_encode(doc4)
    let dec4 = bson_decode(e4)

    cks("nested_name", dec4["name"], "nova")
    cki("nested_x", dec4["nested"]["x"], 1)
    ckf("nested_y", dec4["nested"]["y"], 2.5)
    cki("nested_arr_len", len(dec4["arr"]), 4)
    cki("nested_arr_0", dec4["arr"][0], 1)
    cki("nested_arr_1", dec4["arr"][1], 2)
    cki("nested_arr_2", dec4["arr"][2], 3)
    cks("nested_arr_3", dec4["arr"][3], "four")
    ckf("nested_pi", dec4["pi"], 3.5)
    cki("nested_flag_dec", dec4["flag"], 1)
    ckn("nested_nothing", dec4["nothing"])
    cki("nested_big", dec4["big"], 7)
    cki("nested_huge", dec4["huge"], 9999999999)
    cki("nested_blob_len", bytes_len(dec4["blob"]), 3)
    cki("nested_blob_0", bytes_get(dec4["blob"], 0), 0xDE)
    cki("nested_blob_1", bytes_get(dec4["blob"], 1), 0xAD)
    cki("nested_blob_2", bytes_get(dec4["blob"], 2), 0xBE)

    // explicit type-byte check for bson_bool: single-field doc so the type
    // byte is at a known offset (4, right after the 4-byte length prefix).
    let dflag = {}
    dflag["f"] = bson_bool(1)
    let eflag = bson_encode(dflag)
    cki("bool_type_byte", bytes_get(eflag, 4), 0x08)
    cki("bool_true_value_byte", bytes_get(eflag, 7), 0x01)
    let dflag0 = {}
    dflag0["f"] = bson_bool(0)
    let eflag0 = bson_encode(dflag0)
    cki("bool_false_value_byte", bytes_get(eflag0, 7), 0x00)

    // ── KAT 5: round-trip empty string, empty array, empty binary ──────────
    let d5 = {}
    d5["s"] = ""
    d5["a"] = []
    d5["b"] = bytes_create(0)
    let e5 = bson_encode(d5)
    let dec5 = bson_decode(e5)
    cks("empty_string_rt", dec5["s"], "")
    cki("empty_array_rt", len(dec5["a"]), 0)
    cki("empty_binary_rt", bytes_len(dec5["b"]), 0)

    // ── KAT 6: int32/int64 width boundary transitions ──────────────────────
    let d6 = {}
    d6["max32"] = 2147483647
    d6["over32"] = 2147483648
    d6["min32"] = 0 - 2147483648
    d6["under32"] = 0 - 2147483649
    let e6 = bson_encode(d6)
    let dec6 = bson_decode(e6)
    cki("int32_max_rt", dec6["max32"], 2147483647)
    cki("int32_over_rt", dec6["over32"], 2147483648)
    cki("int32_min_rt", dec6["min32"], 0 - 2147483648)
    cki("int32_under_rt", dec6["under32"], 0 - 2147483649)

    let dmax = {}
    dmax["v"] = 2147483647
    let emax = bson_encode(dmax)
    cki("max32_type_byte", bytes_get(emax, 4), 0x10)

    let dover = {}
    dover["v"] = 2147483648
    let eover = bson_encode(dover)
    cki("over32_type_byte", bytes_get(eover, 4), 0x12)

    // ── KAT 7: encode(decode(x)) round trip + whitespace preservation ──────
    let d7 = {}
    d7["greeting"] = "  hi there  "
    d7["n"] = 42
    let e7 = bson_encode(d7)
    let dec7 = bson_decode(e7)
    cks("rt_greeting", dec7["greeting"], "  hi there  ")
    cki("rt_n", dec7["n"], 42)
    let e7b = bson_encode(dec7)
    cki("rt_reencode_len_matches", bytes_len(e7b), bytes_len(e7))
    let dec7b = bson_decode(e7b)
    cks("rt2_greeting", dec7b["greeting"], "  hi there  ")
    cki("rt2_n", dec7b["n"], 42)

    // ── KAT 8: negative int + negative double + explicit long wrapper of 0 ─
    let d8 = {}
    d8["neg"] = 0 - 12345
    d8["negf"] = 0 - 1.5
    d8["zerolong"] = bson_long(0)
    let e8 = bson_encode(d8)
    let dec8 = bson_decode(e8)
    cki("neg_int_rt", dec8["neg"], 0 - 12345)
    ckf("neg_float_rt", dec8["negf"], 0 - 1.5)
    cki("zero_long_rt", dec8["zerolong"], 0)

    // ── KAT 9: bson_null() sentinel-collision safety ────────────────────────
    // (a) bson_null() itself still round-trips as a TRUE BSON null (0x0A).
    let d9a = {}
    d9a["v"] = bson_null()
    let e9a = bson_encode(d9a)
    cki("bson_null_type_byte", bytes_get(e9a, 4), 0x0A)
    let dec9a = bson_decode(e9a)
    ckn("bson_null_rt", dec9a["v"])

    // (b) an ORDINARY user dict whose sole key is literally "$bsonNull" (built
    // WITHOUT going through bson_null(), so it lacks the magic second key)
    // must NOT collide with the null sentinel: it must encode as a real
    // 1-entry embedded document (0x03) and round-trip as that sub-document,
    // never as null.
    let collide = {}
    collide["$bsonNull"] = 1
    let d9b = {}
    d9b["v"] = collide
    let e9b = bson_encode(d9b)
    cki("bson_null_collision_type_byte", bytes_get(e9b, 4), 0x03)
    let dec9b = bson_decode(e9b)
    if type_of(dec9b["v"]) != "dict"
        print("FAIL bson_null_collision_dec: expected dict, got " + type_of(dec9b["v"]))
        exit(1)
    print("PASS bson_null_collision_dec")
    cki("bson_null_collision_field", dec9b["v"]["$bsonNull"], 1)

    // (c) a user dict with the RIGHT key name but a WRONG magic value (2 keys,
    // second key named "$bsonNullMagic" but holding a value that doesn't
    // match the fixed magic constant) must also NOT collide.
    let nearcollide = {}
    nearcollide["$bsonNull"] = 1
    nearcollide["$bsonNullMagic"] = 42
    let d9c = {}
    d9c["v"] = nearcollide
    let e9c = bson_encode(d9c)
    cki("bson_null_nearcollision_type_byte", bytes_get(e9c, 4), 0x03)
    let dec9c = bson_decode(e9c)
    cki("bson_null_nearcollision_field", dec9c["v"]["$bsonNull"], 1)
    cki("bson_null_nearcollision_magic", dec9c["v"]["$bsonNullMagic"], 42)

    // (d) a user dict with the right key name and magic key but a NON-INT
    // magic value (defensive type guard) must also NOT collide / must not crash.
    let strcollide = {}
    strcollide["$bsonNull"] = 1
    strcollide["$bsonNullMagic"] = "not-an-int"
    let d9d = {}
    d9d["v"] = strcollide
    let e9d = bson_encode(d9d)
    cki("bson_null_strcollision_type_byte", bytes_get(e9d, 4), 0x03)
    let dec9d = bson_decode(e9d)
    cki("bson_null_strcollision_field", dec9d["v"]["$bsonNull"], 1)
    cks("bson_null_strcollision_magic", dec9d["v"]["$bsonNullMagic"], "not-an-int")

    print("bson KAT: ALL PASS")
