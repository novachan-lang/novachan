// _kinetics_test.nova — KAT for std/chem/kinetics
//
// Known-answer tests:
//   ck_half_life_first_order(0.693)       = 0.693147 / 0.693   ≈ 1.000 (s)
//   ck_first_order_conc(1.0, 0.0, 10.0)  = 1.0 * exp(0) = 1.0 (k=0 -> unchanged)
//   ck_reaction_rate(0.5, 2.0)            = 0.5 / 2.0   = 0.25 (mol/L/s)
//   ck_rate_constant_arrhenius increases with T:
//     k_300 = A * exp(-Ea / (R*300))
//     k_600 = A * exp(-Ea / (R*600))   -> k_600 > k_300

import std/chem/kinetics

fn approx(a: float, b: float, tol: float) -> int
    let d = a - b
    let ad = d
    if d < 0.0
        ad = 0.0 - d
    if ad < tol
        return 1
    return 0

fn main()
    // KAT 1: half_life_first_order(0.693) ≈ 1.0
    // 0.693147 / 0.693 = 1.000212... (within 0.01)
    let hl1 = ck_half_life_first_order(0.693)
    if approx(hl1, 1.0, 0.01) == 0
        print("FAIL kinetics half_life_first_order: got " + str(hl1) + " expected ~1.0")
        exit(1)

    // KAT 2: first_order_conc(1.0, 0.0, 10.0) = 1.0 (k=0, no decay)
    let c1 = ck_first_order_conc(1.0, 0.0, 10.0)
    if approx(c1, 1.0, 0.001) == 0
        print("FAIL kinetics first_order_conc_k0: got " + str(c1) + " expected 1.0")
        exit(1)

    // KAT 3: first_order_conc — known decay
    // c0=2.0, k=0.1, t=10 -> 2.0 * exp(-1.0) ≈ 2.0 * 0.36788 = 0.73576
    let c2 = ck_first_order_conc(2.0, 0.1, 10.0)
    if approx(c2, 0.73576, 0.001) == 0
        print("FAIL kinetics first_order_conc_decay: got " + str(c2) + " expected ~0.73576")
        exit(1)

    // KAT 4: reaction_rate — rate = delta_conc / delta_t
    let rr1 = ck_reaction_rate(0.5, 2.0)
    if approx(rr1, 0.25, 0.001) == 0
        print("FAIL kinetics reaction_rate: got " + str(rr1) + " expected 0.25")
        exit(1)

    // KAT 5: arrhenius increases with temperature
    // A=1e6, Ea=50000 J/mol; k_300 < k_600
    let a_val = 1000000.0
    let ea_val = 50000.0
    let k300 = ck_rate_constant_arrhenius(a_val, ea_val, 300.0)
    let k600 = ck_rate_constant_arrhenius(a_val, ea_val, 600.0)
    if k600 < k300
        print("FAIL kinetics arrhenius_temp_dependence: k600 should be > k300")
        exit(1)

    // KAT 6: reaction_rate negative (reactant perspective)
    let rr2 = ck_reaction_rate(-0.4, 2.0)
    if approx(rr2, -0.2, 0.001) == 0
        print("FAIL kinetics reaction_rate_negative: got " + str(rr2) + " expected -0.2")
        exit(1)

    print("PASS _kinetics_test")
