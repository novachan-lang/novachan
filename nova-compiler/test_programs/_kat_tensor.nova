import forge_tensor

fn main()
    let t = tn_new(2, 3)
    assert(tn_rows(t) == 2, "2 rows")
    assert(tn_cols(t) == 3, "3 cols")
    assert(tn_size(t) == 6, "6 elements")
    assert(tn_shape(t) == "2,3", "shape string")
    assert(tn_sum(t) == 0, "sum of zeros is 0")

    let s1 = tn_set(t, 0, 0, 5)
    assert(is_ok(s1), "set(0,0,5) ok")
    let s2 = tn_set(t, 0, 1, 7)
    assert(is_ok(s2), "set(0,1,7) ok")
    let s3 = tn_set(t, 1, 2, 9)
    assert(is_ok(s3), "set(1,2,9) ok")

    let g1 = tn_get(t, 0, 0)
    assert(is_ok(g1), "get(0,0) ok")
    assert(unwrap(g1) == 5, "get(0,0)==5")

    let g2 = tn_get(t, 0, 1)
    assert(unwrap(g2) == 7, "get(0,1)==7")

    let g3 = tn_get(t, 1, 2)
    assert(unwrap(g3) == 9, "get(1,2)==9")

    let g4 = tn_get(t, 1, 0)
    assert(unwrap(g4) == 0, "get(1,0)==0 untouched")

    assert(tn_sum(t) == 21, "sum is 5+7+9=21")

    assert(is_err(tn_set(t, 5, 0, 1)), "set row out of bounds errors")
    assert(is_err(tn_set(t, 0, 9, 1)), "set col out of bounds errors")
    assert(is_err(tn_get(t, -1, 0)), "get negative row errors")
    assert(is_err(tn_get(t, 0, 3)), "get col out of bounds errors")

    let scaled = tn_scale(t, 2)
    assert(tn_sum(scaled) == 42, "scaled sum is 42")

    let a = tn_new(2, 2)
    let a1 = tn_set(a, 0, 0, 1)
    assert(is_ok(a1), "a set(0,0) ok")
    let a2 = tn_set(a, 0, 1, 2)
    assert(is_ok(a2), "a set(0,1) ok")
    let a3 = tn_set(a, 1, 0, 3)
    assert(is_ok(a3), "a set(1,0) ok")
    let a4 = tn_set(a, 1, 1, 4)
    assert(is_ok(a4), "a set(1,1) ok")

    let b = tn_new(2, 2)
    let b1 = tn_set(b, 0, 0, 10)
    assert(is_ok(b1), "b set(0,0) ok")
    let b2 = tn_set(b, 0, 1, 20)
    assert(is_ok(b2), "b set(0,1) ok")
    let b3 = tn_set(b, 1, 0, 30)
    assert(is_ok(b3), "b set(1,0) ok")
    let b4 = tn_set(b, 1, 1, 40)
    assert(is_ok(b4), "b set(1,1) ok")

    let added = tn_add(a, b)
    assert(is_ok(added), "add ok")
    let sum_tensor = unwrap(added)
    assert(unwrap(tn_get(sum_tensor, 0, 0)) == 11, "add(0,0)==11")
    assert(unwrap(tn_get(sum_tensor, 1, 1)) == 44, "add(1,1)==44")
    assert(tn_sum(sum_tensor) == 110, "add total sum is 110")

    let c = tn_new(3, 3)
    assert(is_err(tn_add(a, c)), "add shape mismatch errors")

    print("TENSOR KAT PASS")
