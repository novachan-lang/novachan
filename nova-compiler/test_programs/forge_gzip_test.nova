// forge_gzip_test -- forge_compress.mw_compress() gzip-compresses a text response when the client sends
// Accept-Encoding: gzip. The compressed body is a first-class NovaBytes (rides the binary wire path), the
// header advertises Content-Encoding: gzip, and the bytes round-trip back to the original via deflatex's
// gunzip. Clients that don't accept gzip get the plain string body (pass-through).
import forge
import forge_compress
import deflatex

fn _bytes_to_list(b)
    let n = bytes_len(b)
    let lst = []
    let i = 0
    while i < n
        push(lst, bytes_get(b, i))
        i = i + 1
    lst

fn _big_body()
    let s = ""
    let i = 0
    while i < 150
        s = s + "Hello NOVA Forge gzip! "
        i = i + 1
    s

fn main()
    let body = _big_body()
    let a = forge.app()
    forge.use(a, forge_compress.mw_compress())
    forge.get(a, "/big", fn(req) forge.resp_text(200, body))

    // client that accepts gzip
    let raw = "GET /big HTTP/1.1\r\nAccept-Encoding: gzip\r\n\r\n"
    let r = forge.dispatch_test(a, forge.build_request(raw, 0))
    assert(forge.status_of(r) == 200, "compressed response still 200")
    // header advertises gzip (finalize serializes the headers; a bytes body -> header-only string)
    let wire = forge.finalize(r)
    assert(find(wire, "Content-Encoding: gzip") >= 0, "Content-Encoding: gzip header set")
    // body is now first-class bytes with the gzip magic, and smaller than the original
    let gz = forge.body_of(r)
    assert(type_name(gz) == "bytes", "compressed body is bytes")
    assert(bytes_get(gz, 0) == 31 and bytes_get(gz, 1) == 139, "gzip magic 0x1f 0x8b")
    assert(bytes_len(gz) < len(body), "compressed (" + str(bytes_len(gz)) + ") smaller than original (" + str(len(body)) + ")")
    // round-trip: gunzip the bytes back to the original
    let back = deflatex.byte_list_to_str(deflatex.gzip_decompress(_bytes_to_list(gz)))
    assert(back == body, "gzip round-trip restores the original body exactly")
    print("PASS: mw_compress gzip'd " + str(len(body)) + " bytes -> " + str(bytes_len(gz)) + " bytes, round-trip OK")

    // client that does NOT accept gzip -> plain string body, unchanged
    let r2 = forge.dispatch_test(a, forge.mock_request("GET", "/big", ""))
    assert(forge.status_of(r2) == 200, "plain response 200")
    assert(type_name(forge.body_of(r2)) == "string", "no Accept-Encoding -> plain string body")
    print("PASS: pass-through when the client does not accept gzip")
    print("forge_gzip_test passed")
