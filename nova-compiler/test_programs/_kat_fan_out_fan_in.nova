import forge_fan_out_fan_in

fn main()
    let f = fi_new(3)
    f = fi_submit(f, "task-a")
    f = fi_submit(f, "task-b")
    f = fi_submit(f, "task-c")
    f = fi_submit(f, "task-d")
    f = fi_submit(f, "task-e")

    assert(fi_worker_load(f, 0) == 2, "worker 0 has 2")
    assert(fi_worker_load(f, 1) == 2, "worker 1 has 2")
    assert(fi_worker_load(f, 2) == 1, "worker 2 has 1")

    assert(fi_all_done(f) == 0, "not done")
    f = fi_complete(f, 0, "result-a")
    f = fi_complete(f, 1, "result-b")
    f = fi_complete(f, 2, "result-c")
    assert(fi_progress(f) == 60, "60%")

    f = fi_complete(f, 3, "result-d")
    f = fi_complete(f, 4, "result-e")
    assert(fi_all_done(f) == 1, "all done")
    assert(fi_result(f, 0) == "result-a", "result 0")

    print("FAN-OUT-FAN-IN KAT PASS")
