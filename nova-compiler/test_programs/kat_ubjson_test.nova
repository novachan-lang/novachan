// Canonical KAT test for std/encoding/ubjson (Universal Binary JSON, draft-12).
// Byte-exact vectors straight from the UBJSON spec's own worked examples,
// plus round-trip / adversarial-robustness / injection coverage.
//
// ubjson_decode(b) returns Result (Ok(value) / Err(message)) — see the
// module header's DECODE-ERROR VS. LEGITIMATE-VALUE SAFETY section. Every
// well-formed-input assertion below decodes via the `_dec` helper (fails
// the test loudly if a legitimate buffer is ever wrongly rejected — the
// strongest possible "this must succeed" assertion); every malformed-input
// assertion instead checks is_decode_err(...) rather than inspecting a
// guessed fallback value.
import std/encoding/ubjson

fn _hex(b) -> string
    let digs = "0123456789abcdef"
    let out = ""
    let n = bytes_len(b)
    let i = 0
    while i < n
        let v = bytes_get(b, i)
        out = out + char_at(digs, (v >> 4) & 15) + char_at(digs, v & 15)
        i = i + 1
    return out

fn eq_s(name: string, got: string, want: string)
    if got != want
        print("FAIL " + name + ": got '" + got + "' want '" + want + "'")
        exit(1)
    print("ok " + name)

fn eq_i(name: string, got: int, want: int)
    if got != want
        print("FAIL " + name + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("ok " + name)

fn eq_f(name: string, got: float, want: float)
    let d = got - want
    if d < 0.0
        d = 0.0 - d
    if d > 0.0000001
        print("FAIL " + name + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("ok " + name)

// True iff ubjson_decode(b) is Err — used by the malformed-input cases.
fn is_decode_err(b) -> int
    let r = 1
    match ubjson_decode(b)
        Ok(v) =>
            r = 0
        Err(e) =>
            r = 1
    return r

// Decode-or-fail helper for the well-formed-input assertions below. Returns
// `any` deliberately (NOT a concretely-typed int/string/list/dict return) —
// pinning the Result payload to one concrete scalar type here would pin it
// for every OTHER call site in this compilation unit too (NOVA's `any`
// unification for a compiler-native Result's payload is resolved once, not
// re-generalized per call), so a single `-> any` helper is what lets this
// KAT legitimately decode ints, strings, floats, lists, AND dicts all in
// the same file. A real decode error here means the KAT itself is broken
// (the input was constructed to be well-formed), so it fails loudly.
fn _dec(b) -> any
    let r = null
    match ubjson_decode(b)
        Ok(v) =>
            r = v
        Err(e) =>
            print("FAIL: unexpected decode error: " + e)
            exit(1)
    return r

fn main()
    // ── byte-exact spec vectors ─────────────────────────────────────────
    // NOTE on null: a bare `null` literal passed as a generic `any` function
    // argument is represented by NOVA as raw int 0 (type_of collapses to
    // "int" the moment it crosses a function-call boundary — verified: this
    // is NOT unique to this module, see std/encoding/bson's identical
    // documented limitation). So `ubjson_encode(null)` indistinguishably
    // encodes as int 0 (i8 marker), same as `ubjson_encode(0)` — there is
    // no way for a generic encode(v) entry point to see "this specific 0 was
    // spelled null at the call site". The spec's Z-marker byte-exact vector
    // is therefore proven via the documented ubjson_null() sentinel, exactly
    // parallel to how true/false are proven via ubjson_bool() below.
    eq_s("null (bare, indistinguishable from int 0)", _hex(ubjson_encode(null)), "6900")
    eq_s("null (explicit ubjson_null() sentinel -> Z marker)", _hex(ubjson_encode(ubjson_null())), "5a")
    eq_s("true", _hex(ubjson_encode(ubjson_bool(true))), "54")
    eq_s("false", _hex(ubjson_encode(ubjson_bool(false))), "46")
    eq_s("int 1", _hex(ubjson_encode(1)), "6901")
    eq_s("uint8 255", _hex(ubjson_encode(255)), "55ff")
    eq_s("int16 256", _hex(ubjson_encode(256)), "49" + "0100")
    eq_s("string foo", _hex(ubjson_encode("foo")), "5369" + "03" + "666f6f")
    let arr12 = [1, 2]
    eq_s("array [1,2]", _hex(ubjson_encode(arr12)), "5b" + "6901" + "6902" + "5d")
    let obja1 = {}
    obja1["a"] = 1
    eq_s("object \{a:1\}", _hex(ubjson_encode(obja1)), "7b" + "6901" + "61" + "6901" + "7d")

    // ── int width boundaries: i8/U8/i16/i32/i64 edges, both markers+roundtrip ──
    eq_s("i8 -128", _hex(ubjson_encode(0 - 128)), "6980")
    eq_s("i8 127", _hex(ubjson_encode(127)), "697f")
    eq_s("U8 128", _hex(ubjson_encode(128)), "5580")
    eq_s("U8 255 again", _hex(ubjson_encode(255)), "55ff")
    eq_s("I16 256", _hex(ubjson_encode(256)), "490100")
    eq_s("I16 -129", _hex(ubjson_encode(0 - 129)), "49ff7f")
    eq_s("I16 32767", _hex(ubjson_encode(32767)), "497fff")
    eq_s("I16 -32768", _hex(ubjson_encode(0 - 32768)), "498000")
    eq_s("l32 32768", _hex(ubjson_encode(32768)), "6c00008000")
    eq_s("l32 -32769", _hex(ubjson_encode(0 - 32769)), "6cffff7fff")
    eq_s("l32 2147483647", _hex(ubjson_encode(2147483647)), "6c7fffffff")
    eq_s("l32 -2147483648", _hex(ubjson_encode(0 - 2147483648)), "6c80000000")
    eq_s("L64 2147483648", _hex(ubjson_encode(2147483648)), "4c0000000080000000")
    eq_s("L64 -2147483649", _hex(ubjson_encode(0 - 2147483649)), "4cffffffff7fffffff")
    eq_i("i64 roundtrip large", _dec(ubjson_encode(9223372036854775807)), 9223372036854775807)
    eq_i("i64 roundtrip large neg", _dec(ubjson_encode(0 - 9223372036854775807)), 0 - 9223372036854775807)
    eq_i("int 0", _dec(ubjson_encode(0)), 0)

    // ── float32 / float64 selection + exact roundtrip ──────────────────
    eq_s("float32 1.5 marker", _hex(bytes_slice(ubjson_encode(1.5), 0, 1)), "64")
    eq_f("float32 1.5 roundtrip", _dec(ubjson_encode(1.5)), 1.5)
    eq_s("float64 0.1 marker", _hex(bytes_slice(ubjson_encode(0.1), 0, 1)), "44")
    eq_f("float64 0.1 roundtrip", _dec(ubjson_encode(0.1)), 0.1)
    eq_f("float 0.0 roundtrip", _dec(ubjson_encode(0.0)), 0.0)
    eq_f("float negative roundtrip", _dec(ubjson_encode(0.0 - 123.25)), 0.0 - 123.25)

    // ── empty containers ─────────────────────────────────────────────
    eq_s("empty array", _hex(ubjson_encode([])), "5b5d")
    let emptyd = {}
    eq_s("empty object", _hex(ubjson_encode(emptyd)), "7b7d")
    let rta = _dec(ubjson_encode([]))
    eq_i("empty array roundtrip len", len(rta), 0)
    let rtd = _dec(ubjson_encode(emptyd))
    eq_i("empty object roundtrip len", len(keys(rtd)), 0)

    // ── string edge cases: empty / whitespace / max-ish width ─────────
    eq_s("empty string", _hex(ubjson_encode("")), "5369" + "00")
    eq_s("empty string roundtrip", _dec(ubjson_encode("")), "")
    eq_s("whitespace string roundtrip", _dec(ubjson_encode("   ")), "   ")
    let wide = "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789"
    eq_s("wide string roundtrip (>127 len -> U marker)", _dec(ubjson_encode(wide)), wide)
    eq_s("wide string length marker is U (len=130>127)", _hex(bytes_slice(ubjson_encode(wide), 1, 2)), "55")
    eq_s("utf8 string roundtrip", _dec(ubjson_encode("héllo wörld 中文")), "héllo wörld 中文")

    // ── injection resistance: embedded frame-marker bytes in key/string ──
    // A key/string containing the literal '}'/']'/'[' /'{' characters must
    // NOT be mistaken for a container close/open — length-prefixed framing
    // consumes exactly the declared byte count, never scans for a delimiter.
    // NOTE: a literal '{' in a NOVA string literal triggers interpolation,
    // so the injected marker bytes are written via the \{ / \} escapes
    // (valid NOVA string escapes) — the resulting runtime STRING VALUE is
    // the plain single-brace text (e.g. "a[b]c{d}"), which is exactly the
    // byte content this test needs to push through the encoder/decoder.
    let injd = {}
    injd["x\}y"] = 1
    injd["a[b]c\{d\}"] = 2
    let rtinj = _dec(ubjson_encode(injd))
    eq_i("injection key x}y present", rtinj["x\}y"], 1)
    eq_i("injection key a[b]c\{d\} present", rtinj["a[b]c\{d\}"], 2)
    eq_i("injection object has exactly 2 keys", len(keys(rtinj)), 2)
    let injs = "]\}[\{" + "tail"
    eq_s("injection string value roundtrip", _dec(ubjson_encode(injs)), injs)

    // ── nested structure round trip ────────────────────────────────────
    let inner = {}
    inner["b"] = 2
    inner["list"] = [10, 20, 30]
    let outer = {}
    outer["a"] = [1, inner]
    outer["c"] = "x"
    outer["flag"] = ubjson_bool(true)
    let rt = _dec(ubjson_encode(outer))
    eq_i("nested a[0]", rt["a"][0], 1)
    let inner2 = rt["a"][1]
    eq_i("nested a[1].b", inner2["b"], 2)
    eq_i("nested a[1].list[0]", inner2["list"][0], 10)
    eq_i("nested a[1].list[2]", inner2["list"][2], 30)
    eq_s("nested c", rt["c"], "x")
    eq_i("nested flag (true)", rt["flag"], 1)

    // ── explicit null / bool markers inside a container ─────────────────
    let withnull = [ubjson_null(), 1, ubjson_bool(false)]
    let encnull = ubjson_encode(withnull)
    eq_s("array open marker byte", _hex(bytes_slice(encnull, 0, 1)), "5b")
    eq_s("explicit null marker byte (1st element)", _hex(bytes_slice(encnull, 1, 2)), "5a")
    let rtn = _dec(encnull)
    eq_i("explicit null decodes to null/0", rtn[0], 0)
    eq_i("plain int still 1", rtn[1], 1)
    eq_i("explicit false decodes to 0", rtn[2], 0)

    // ── no-op marker (`N`): padding, consumed inside a container, never
    // a phantom element; a bare top-level `N` decodes to Ok(null) ────────
    eq_s("bare noop -> N marker byte", _hex(ubjson_encode(ubjson_noop())), "4e")
    let withnoop = [ubjson_noop(), 1, ubjson_noop(), 2, ubjson_noop()]
    let rtnoop = _dec(ubjson_encode(withnoop))
    eq_i("noop padding consumed: array has exactly 2 real elements", len(rtnoop), 2)
    eq_i("noop padding consumed: element 0 preserved", rtnoop[0], 1)
    eq_i("noop padding consumed: element 1 preserved", rtnoop[1], 2)
    match ubjson_decode(ubjson_encode(ubjson_noop()))
        Ok(v) =>
            print("ok bare top-level noop decodes to Ok (null/0)")
        Err(e) =>
            print("FAIL bare top-level noop wrongly rejected: " + e)
            exit(1)

    // ── binary bytes value: array-of-uint8, 0x00-safe ───────────────────
    let bin = bytes_create(4)
    bytes_set(bin, 0, 0x00)
    bytes_set(bin, 1, 0xFF)
    bytes_set(bin, 2, 0x41)
    bytes_set(bin, 3, 0x7D)
    let encbin = ubjson_encode(bin)
    eq_s("bytes encodes as array open", _hex(bytes_slice(encbin, 0, 1)), "5b")
    let rtb = _dec(encbin)
    eq_i("bytes[0] == 0x00 survives (no NUL truncation)", rtb[0], 0)
    eq_i("bytes[1] == 0xFF", rtb[1], 255)
    eq_i("bytes[2] == 0x41", rtb[2], 65)
    eq_i("bytes[3] == 0x7D (not mistaken for close)", rtb[3], 125)
    eq_i("bytes roundtrip length", len(rtb), 4)

    // ── malformed/truncated input is REJECTED (Err), never guessed at ───
    // See the module header's DECODE-ERROR VS. LEGITIMATE-VALUE SAFETY
    // section: a defensive fallback VALUE (the pre-fix behavior) can never
    // be told apart from a legitimate decode of that same value, so every
    // one of these cases now asserts is_err(...), not a guessed shape.
    let trunc1 = bytes_create(1)
    bytes_set(trunc1, 0, 0x69)          // 'i' marker with NO payload byte
    eq_i("truncated int8 payload -> rejected (Err)", is_decode_err(trunc1), 1)

    let trunc2 = bytes_create(2)
    bytes_set(trunc2, 0, 0x5b)          // '[' with no close and no elements
    bytes_set(trunc2, 1, 0x69)          // 'i' marker, then buffer ends (no payload)
    eq_i("truncated array element -> rejected (Err)", is_decode_err(trunc2), 1)

    let emptybuf = bytes_create(0)
    eq_i("empty buffer -> rejected (Err)", is_decode_err(emptybuf), 1)

    // hostile negative length prefix (i FF = -1) used as a string length:
    // 53 (S) 69 FF (i, -1) -> must be REJECTED, not clamped to length 0.
    let hostile = bytes_create(3)
    bytes_set(hostile, 0, 0x53)         // 'S'
    bytes_set(hostile, 1, 0x69)         // 'i'
    bytes_set(hostile, 2, 0xFF)         // -1 as int8 payload
    eq_i("negative length string -> rejected (Err)", is_decode_err(hostile), 1)

    // ── char (C) decode-only marker ──────────────────────────────────────
    let cbuf = bytes_create(2)
    bytes_set(cbuf, 0, 0x43)            // 'C'
    bytes_set(cbuf, 1, 0x41)            // 'A'
    eq_s("char C decode", _dec(cbuf), "A")

    // ── ubjson_kat_sentinel_collision_safe: 2-key + magic-value guard ──────
    // Proves the sentinel-key collision defect is CLOSED: an ordinary user
    // dict whose sole key happens to equal one of the reserved wrapper key
    // names ("$ubjsonBool" / "$ubjsonNull" / "$ubjsonNoop") must round-trip
    // as a REAL 1-entry object, never get silently misencoded as a T/F/Z/N
    // marker byte. Only a dict built through ubjson_bool()/ubjson_null()/
    // ubjson_noop() itself (which also carries the matching magic constant
    // on a second key) may take the marker path.
    let collideBool = {}
    collideBool["$ubjsonBool"] = 42
    let encCollideBool = ubjson_encode(collideBool)
    eq_s("sentinel collision: bare $ubjsonBool dict encodes as object, not T/F", _hex(bytes_slice(encCollideBool, 0, 1)), "7b")
    let rtCollideBool = _dec(encCollideBool)
    eq_s("sentinel collision: bare $ubjsonBool dict decodes as dict", type_of(rtCollideBool), "dict")
    eq_i("sentinel collision: bare $ubjsonBool value preserved", rtCollideBool["$ubjsonBool"], 42)
    eq_i("sentinel collision: bare $ubjsonBool dict has exactly 1 key", len(keys(rtCollideBool)), 1)

    let collideNull = {}
    collideNull["$ubjsonNull"] = 7
    let encCollideNull = ubjson_encode(collideNull)
    eq_s("sentinel collision: bare $ubjsonNull dict encodes as object, not Z", _hex(bytes_slice(encCollideNull, 0, 1)), "7b")
    let rtCollideNull = _dec(encCollideNull)
    eq_s("sentinel collision: bare $ubjsonNull dict decodes as dict", type_of(rtCollideNull), "dict")
    eq_i("sentinel collision: bare $ubjsonNull value preserved", rtCollideNull["$ubjsonNull"], 7)
    eq_i("sentinel collision: bare $ubjsonNull dict has exactly 1 key", len(keys(rtCollideNull)), 1)

    let collideNoop = {}
    collideNoop["$ubjsonNoop"] = 13
    let encCollideNoop = ubjson_encode(collideNoop)
    eq_s("sentinel collision: bare $ubjsonNoop dict encodes as object, not N", _hex(bytes_slice(encCollideNoop, 0, 1)), "7b")
    let rtCollideNoop = _dec(encCollideNoop)
    eq_s("sentinel collision: bare $ubjsonNoop dict decodes as dict", type_of(rtCollideNoop), "dict")
    eq_i("sentinel collision: bare $ubjsonNoop value preserved", rtCollideNoop["$ubjsonNoop"], 13)
    eq_i("sentinel collision: bare $ubjsonNoop dict has exactly 1 key", len(keys(rtCollideNoop)), 1)

    // 2-key shape with the right key NAMES but a WRONG magic value must
    // also fall through to a real dict (name match alone is not enough).
    let wrongMagic = {}
    wrongMagic["$ubjsonBool"] = 1
    wrongMagic["$ubjsonBoolMagic"] = 12345
    let encWrongMagic = ubjson_encode(wrongMagic)
    eq_s("sentinel collision: wrong magic value stays object", _hex(bytes_slice(encWrongMagic, 0, 1)), "7b")
    let rtWrongMagic = _dec(encWrongMagic)
    eq_i("sentinel collision: wrong magic dict key count = 2", len(keys(rtWrongMagic)), 2)

    // Magic key present but holding the WRONG TYPE (string, not int) must
    // not crash comparing int==string and must fall through to a real dict.
    let wrongType = {}
    wrongType["$ubjsonBool"] = 1
    wrongType["$ubjsonBoolMagic"] = "UBJSBOOL"
    let rtWrongType = _dec(ubjson_encode(wrongType))
    eq_s("sentinel collision: non-int magic stays dict, no crash", type_of(rtWrongType), "dict")
    eq_i("sentinel collision: non-int magic dict key count = 2", len(keys(rtWrongType)), 2)

    // The legitimate mechanism must still work: ubjson_bool()/ubjson_null()
    // (with the correct magic) still produce real T/F/Z marker bytes, both
    // top-level and nested inside a container, and sibling data survives.
    eq_s("sentinel: legitimate ubjson_bool(true) still emits T", _hex(ubjson_encode(ubjson_bool(true))), "54")
    eq_s("sentinel: legitimate ubjson_null() still emits Z", _hex(ubjson_encode(ubjson_null())), "5a")
    let hostDict = {}
    hostDict["a"] = "x"
    hostDict["colliding"] = collideBool
    hostDict["flag"] = ubjson_bool(true)
    hostDict["z"] = "y"
    let rtHost = _dec(ubjson_encode(hostDict))
    eq_s("sentinel: nested collision value decodes as dict, not bool", type_of(rtHost["colliding"]), "dict")
    eq_i("sentinel: nested collision value preserved", rtHost["colliding"]["$ubjsonBool"], 42)
    eq_i("sentinel: legitimate flag still decodes as bool marker", rtHost["flag"], 1)
    eq_s("sentinel: sibling 'a' survives", rtHost["a"], "x")
    eq_s("sentinel: sibling 'z' survives", rtHost["z"], "y")

    // ── distinct-absent: a decoded object's MISSING key must read as
    // ABSENT via contains(), never conflated with a present key whose
    // value happens to be 0 — the general "legitimate value == old sentinel"
    // collision class this fix closes end-to-end. ─────────────────────────
    let sparse = {}
    sparse["presentZero"] = 0
    sparse["presentOne"] = 1
    let rtSparse = _dec(ubjson_encode(sparse))
    eq_i("distinct-absent: missing key reports absent via contains()", contains(rtSparse, "missingKey"), 0)
    eq_i("distinct-absent: present key with value 0 reports present", contains(rtSparse, "presentZero"), 1)
    eq_i("distinct-absent: present-zero value preserved exactly", rtSparse["presentZero"], 0)

    print("kat_ubjson_test passed")
