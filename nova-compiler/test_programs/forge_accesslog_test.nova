// forge_accesslog_test -- mw_access_log logs "METHOD path -> status" after the response and passes
// the response through unchanged (status + body intact, fold order preserved).
import forge

type Msg
    ok: bool

fn h(req: Request) -> Msg
    Msg(true)

fn main()
    let q = chr(34)
    let a = forge.app()
    forge.use(a, forge.mw_access_log())
    forge.get(a, "/x", h)

    let r: Response = forge.dispatch_req(a, forge.build_request("GET /x HTTP/1.1\r\n\r\n", 0))
    assert(r.status == 200, "response passes through (200)")
    assert(find(r.body, q + "ok" + q + ":true") >= 0, "body intact through access-log mw")
    print("PASS: mw_access_log passthrough")
    print("forge_accesslog_test passed")
