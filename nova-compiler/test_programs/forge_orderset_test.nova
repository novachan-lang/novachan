import forge_orderset

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn joinl(xs: list) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + ","
        out = out + str(xs[i])
        i = i + 1
    out

fn main()
    let fails = 0

    let s = os_new()
    os_add(s, 5)
    os_add(s, 2)
    os_add(s, 8)
    os_add(s, 2)
    os_add(s, 1)

    // sorted, dedup
    fails = fails + expect("size", str(os_size(s)), "4")
    fails = fails + expect("sorted", joinl(os_range(s, 0 - 100, 100)), "1,2,5,8")

    // select (k-th smallest)
    fails = fails + expect("kth0", str(os_kth(s, 0)), "1")
    fails = fails + expect("kth2", str(os_kth(s, 2)), "5")
    fails = fails + expect("kth3", str(os_kth(s, 3)), "8")

    // rank (count strictly less than)
    fails = fails + expect("rank5", str(os_rank(s, 5)), "2")
    fails = fails + expect("rank1", str(os_rank(s, 1)), "0")
    fails = fails + expect("rank9", str(os_rank(s, 9)), "4")
    fails = fails + expect("rank3", str(os_rank(s, 3)), "2")

    // contains
    fails = fails + expect("has5", str(os_contains(s, 5)), "true")
    fails = fails + expect("has3", str(os_contains(s, 3)), "false")

    // floor / ceiling
    let f4 = os_floor(s, 4)
    fails = fails + expect("floor4", str(f4[0]) + ":" + str(f4[1]), "1:2")
    let f5 = os_floor(s, 5)
    fails = fails + expect("floor5", str(f5[0]) + ":" + str(f5[1]), "1:5")
    let f0 = os_floor(s, 0)
    fails = fails + expect("floor0_none", str(f0[0]), "0")
    let c3 = os_ceiling(s, 3)
    fails = fails + expect("ceil3", str(c3[0]) + ":" + str(c3[1]), "1:5")
    let c9 = os_ceiling(s, 9)
    fails = fails + expect("ceil9_none", str(c9[0]), "0")

    // range + count_range
    fails = fails + expect("range", joinl(os_range(s, 2, 6)), "2,5")
    fails = fails + expect("count_range", str(os_count_range(s, 2, 8)), "3")

    // remove
    fails = fails + expect("rm5", str(os_remove(s, 5)), "true")
    fails = fails + expect("rm_absent", str(os_remove(s, 99)), "false")
    fails = fails + expect("after_rm", joinl(os_range(s, 0 - 100, 100)), "1,2,8")
    fails = fails + expect("size_after", str(os_size(s)), "3")

    // leaderboard scenario: add scores, query rank
    let lb = os_new()
    os_add(lb, 100)
    os_add(lb, 85)
    os_add(lb, 92)
    os_add(lb, 78)
    os_add(lb, 95)
    // how many scored below 92? -> 78,85 = 2
    fails = fails + expect("lb_rank", str(os_rank(lb, 92)), "2")
    // top score = kth(size-1)
    fails = fails + expect("lb_top", str(os_kth(lb, os_size(lb) - 1)), "100")

    if fails == 0
        print("forge_orderset: all passed")
    else
        print("forge_orderset: " + str(fails) + " FAILED")
