import std/greedy/task_scheduler

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _task_scheduler_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL _task_scheduler_test " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn main()
    // KAT: ts_min_intervals
    // [3,3] cooldown=2: ABABAB-idle -> actually (3-1)*(2+1)+2=8 vs sum=6 -> 8
    cki("kat1", ts_min_intervals([3, 3], 2), 8)
    // [1,1,1] cooldown=0: no cooldown, just execute 3 tasks
    cki("kat2", ts_min_intervals([1, 1, 1], 0), 3)
    // [6] cooldown=2: AIIAIIAIIAII... = (6-1)*3+1=16
    cki("kat3", ts_min_intervals([6], 2), 16)
    // [1,1,1] cooldown=2: sum=3, frame=(1-1)*(3)+3=3 -> max(3,3)=3
    cki("kat4", ts_min_intervals([1, 1, 1], 2), 3)
    // [4,3,3] cooldown=2: sum=10, frame=(4-1)*3+1=10 -> max(10,10)=10
    cki("kat5", ts_min_intervals([4, 3, 3], 2), 10)

    // KAT: ts_idle_slots
    // [3,3] cooldown=2: 8-6=2
    cki("idle1", ts_idle_slots([3, 3], 2), 2)

    // Additional coverage
    // empty counts
    let ec = []
    cki("empty", ts_min_intervals(ec, 2), 0)

    // single task type, no cooldown
    cki("single_n0", ts_min_intervals([5], 0), 5)

    // cooldown=0: no idle ever, total = sum
    cki("n0_multi", ts_min_intervals([3, 2, 1], 0), 6)
    cki("n0_idle",  ts_idle_slots([3, 2, 1], 0),    0)

    // many tasks, all same: [2,2,2,2] n=2 -> max_count=2, tasks_with_max=4
    // frame=(2-1)*(3)+4=7, sum=8 -> max(8,7)=8, idle=0
    cki("all_same_n2",   ts_min_intervals([2, 2, 2, 2], 2), 8)
    cki("all_same_idle", ts_idle_slots([2, 2, 2, 2], 2),    0)

    // [10] n=3: frame=(10-1)*4+1=37, sum=10 -> 37, idle=27
    cki("heavy_single",      ts_min_intervals([10], 3), 37)
    cki("heavy_single_idle", ts_idle_slots([10], 3),    27)

    // single task, n=0: frame=(1-1)*1+1=1, sum=1 -> 1, idle=0
    cki("one_task_n0",   ts_min_intervals([1], 0), 1)
    cki("one_task_idle", ts_idle_slots([1], 0),    0)

    print("PASS _task_scheduler_test")
