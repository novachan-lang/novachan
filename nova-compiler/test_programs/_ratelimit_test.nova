// KAT for std/control/ratelimit -- nonlinear signal-shaping primitives.
import std/control/ratelimit

fn approx(a, b)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < 0.0001

fn ckf(label, got, want)
    if not approx(got, want)
        print("FAIL ratelimit " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    if got != want
        print("FAIL ratelimit " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // --- sat_clamp ---
    ckf("sat_clamp above hi", sat_clamp(5.0, 0.0, 3.0), 3.0)
    ckf("sat_clamp below lo", sat_clamp(-1.0, 0.0, 3.0), 0.0)
    ckf("sat_clamp inside", sat_clamp(2.0, 0.0, 3.0), 2.0)
    ckf("sat_clamp at lo", sat_clamp(0.0, 0.0, 3.0), 0.0)
    ckf("sat_clamp at hi", sat_clamp(3.0, 0.0, 3.0), 3.0)

    // --- sat_apply ---
    ckf("sat_apply neg clamp", sat_apply(-5.0, 3.0), -3.0)
    ckf("sat_apply pos clamp", sat_apply(5.0, 3.0), 3.0)
    ckf("sat_apply inside", sat_apply(1.0, 3.0), 1.0)
    ckf("sat_apply zero", sat_apply(0.0, 3.0), 0.0)

    // --- deadband ---
    // width=1.0 => band is [-0.5, 0.5]; 0.1 is inside -> 0.0
    ckf("deadband inside", deadband(0.1, 1.0), 0.0)
    ckf("deadband neg inside", deadband(-0.1, 1.0), 0.0)
    ckf("deadband zero", deadband(0.0, 1.0), 0.0)
    // 1.0 > 0.5 -> 1.0 - 0.5 = 0.5
    ckf("deadband pos outside", deadband(1.0, 1.0), 0.5)
    // -1.0 < -0.5 -> -1.0 + 0.5 = -0.5
    ckf("deadband neg outside", deadband(-1.0, 1.0), -0.5)

    // --- deadband_centered ---
    ckf("deadband_centered inside", deadband_centered(0.5, 0.0, 1.0), 0.0)
    ckf("deadband_centered outside pos", deadband_centered(2.0, 0.0, 1.0), 2.0)
    ckf("deadband_centered outside neg", deadband_centered(-1.0, 0.0, 1.0), -1.0)

    // --- quantizer ---
    // 2.3/0.5 = 4.6; +0.5 = 5.1; int(5.1)=5; 5*0.5 = 2.5
    ckf("quantizer 2.3 step 0.5", quantizer(2.3, 0.5), 2.5)
    // 2.1/0.5 = 4.2; +0.5 = 4.7; int(4.7)=4; 4*0.5 = 2.0
    ckf("quantizer 2.1 step 0.5", quantizer(2.1, 0.5), 2.0)
    ckf("quantizer exact", quantizer(2.0, 0.5), 2.0)
    ckf("quantizer 0.0 step 0.5", quantizer(0.0, 0.5), 0.0)

    // --- quantizer_floor ---
    // 2.3/0.5 = 4.6; int(4.6)=4; 4*0.5=2.0
    ckf("quantizer_floor 2.3 step 0.5", quantizer_floor(2.3, 0.5), 2.0)
    // 2.5/0.5 = 5.0; int(5.0)=5; 5*0.5=2.5
    ckf("quantizer_floor 2.5 step 0.5", quantizer_floor(2.5, 0.5), 2.5)

    // --- rate limiter ---
    let rl = rl_new(1.0, 1.0)
    // reset to 0.0
    rl_reset(rl, 0.0)
    // target=5.0, max_delta=1.0, current=0.0 -> output=1.0
    let out1 = rl_step(rl, 5.0)
    ckf("rl_step limited up", out1, 1.0)
    // second step: current=1.0, target=5.0 -> output=2.0
    let out2 = rl_step(rl, 5.0)
    ckf("rl_step limited up 2", out2, 2.0)
    // step with target already within reach: current=2.0, target=2.5 -> output=2.5
    let out3 = rl_step(rl, 2.5)
    ckf("rl_step within reach", out3, 2.5)
    // step downward limited: current=2.5, target=0.0, max_delta=1.0 -> output=1.5
    let out4 = rl_step(rl, 0.0)
    ckf("rl_step limited down", out4, 1.5)
    // reset to 10.0, then step toward 5.0 -> 9.0
    rl_reset(rl, 10.0)
    let out5 = rl_step(rl, 5.0)
    ckf("rl_step after reset", out5, 9.0)

    // --- hysteresis ---
    // lo=2.0, hi=8.0; start false
    let hy = hysteresis_new(2.0, 8.0)
    // x=5.0 between thresholds -> holds false
    let h1 = hysteresis_step(hy, 5.0)
    ckb("hysteresis hold false", h1, false)
    // x=9.0 >= hi -> true
    let h2 = hysteresis_step(hy, 9.0)
    ckb("hysteresis above hi", h2, true)
    // x=5.0 between -> holds true
    let h3 = hysteresis_step(hy, 5.0)
    ckb("hysteresis hold true", h3, true)
    // x=1.0 <= lo -> false
    let h4 = hysteresis_step(hy, 1.0)
    ckb("hysteresis below lo", h4, false)

    // --- backlash ---
    // width=1.0, half=0.5; starts at output=0, input=0
    let bl = backlash_new(1.0)
    // move input to 1.0: diff=1.0>0, upper=0+0.5=0.5, 1.0>0.5 -> new_out=1.0-0.5=0.5
    let b1 = backlash_step(bl, 1.0)
    ckf("backlash step fwd", b1, 0.5)
    // move input to 1.2: diff=0.2>0, upper=0.5+0.5=1.0, 1.2>1.0 -> new_out=1.2-0.5=0.7
    let b2 = backlash_step(bl, 1.2)
    ckf("backlash step fwd 2", b2, 0.7)
    // move input to 0.9: diff=-0.3<0, lower=0.7-0.5=0.2, 0.9 not < 0.2 -> holds 0.7
    let b3 = backlash_step(bl, 0.9)
    ckf("backlash reverse in gap", b3, 0.7)

    print("PASS _ratelimit_test")
