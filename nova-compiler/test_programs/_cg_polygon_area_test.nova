// KAT for std/geometry/cg_polygon_area
// Verifies: cga_area_2x, cga_area_abs_2x, cga_is_ccw
import std/geometry/cg_polygon_area

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let goti = 0
    if got
        goti = 1
    let wanti = 0
    if want
        wanti = 1
    if goti != wanti
        print("FAIL " + label + ": got=" + str(goti) + " want=" + str(wanti))
        exit(1)

fn main()
    // CCW square 2x2
    let sq_ccw = [[0,0],[2,0],[2,2],[0,2]]
    cki("area_2x ccw square", cga_area_2x(sq_ccw), 8)
    cki("area_abs_2x ccw square", cga_area_abs_2x(sq_ccw), 8)
    ckb("is_ccw ccw square", cga_is_ccw(sq_ccw), true)

    // CW square 2x2 (vertices in clockwise order)
    let sq_cw = [[0,0],[0,2],[2,2],[2,0]]
    cki("area_2x cw square", cga_area_2x(sq_cw), -8)
    ckb("is_ccw cw square", cga_is_ccw(sq_cw), false)

    // CCW triangle (0,0),(4,0),(0,3): area = 12/2=6, 2x=12
    let tri = [[0,0],[4,0],[0,3]]
    cki("area_abs_2x triangle", cga_area_abs_2x(tri), 12)

    // Degenerate: collinear points — area = 0
    let coll = [[0,0],[1,1],[2,2]]
    cki("area_2x collinear", cga_area_2x(coll), 0)
    cki("area_abs_2x collinear", cga_area_abs_2x(coll), 0)
    ckb("is_ccw collinear", cga_is_ccw(coll), false)

    // Empty polygon
    let empty = []
    cki("area_2x empty", cga_area_2x(empty), 0)

    print("PASS _cg_polygon_area_test")
