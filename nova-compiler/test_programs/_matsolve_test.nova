// KAT for std/matrix/matsolve — linear system solver A x = b.
import std/matrix/matsolve

// ckf — float tolerance check.
fn ckf(label, got, want)
    let d = got - want
    if d < 0.0
        d = 0.0 - d
    if d > 0.0001
        print("FAIL matsolve " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// cki — exact int check.
fn cki(label, got, want)
    if got != want
        print("FAIL matsolve " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb — bool check.
fn ckb(label, got, want)
    if got != want
        print("FAIL matsolve " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// Helper: build a 2x2 matrix dict for use with msv_ functions.
fn mk22(a00, a01, a10, a11)
    let d = {}
    d["r"] = 2
    d["c"] = 2
    let data = [a00, a01, a10, a11]
    d["d"] = data
    d

// Helper: build a 3x3 matrix dict.
fn mk33(v00, v01, v02, v10, v11, v12, v20, v21, v22)
    let d = {}
    d["r"] = 3
    d["c"] = 3
    let data = [v00, v01, v02, v10, v11, v12, v20, v21, v22]
    d["d"] = data
    d

fn main()
    // --- msv_solve: [[2,1],[1,3]], b=[3,5] -> x=[0.8,1.4] ---
    // 2*0.8 + 1.4 = 3 ✓  0.8 + 3*1.4 = 5 ✓
    let a21 = mk22(2.0, 1.0, 1.0, 3.0)
    let b21 = [3.0, 5.0]
    let x21 = msv_solve(a21, b21)
    ckf("solve_2x2_x1", x21[0] * 1.0, 0.8)
    ckf("solve_2x2_x2", x21[1] * 1.0, 1.4)

    // --- msv_verify: A x == b ---
    let vflag = msv_verify(a21, x21, b21, 0.0001)
    ckb("verify_true", vflag, true)

    // --- msv_solve: identity 2x2, b=[5,7] -> x=[5,7] ---
    let id2 = mk22(1.0, 0.0, 0.0, 1.0)
    let bid = [5.0, 7.0]
    let xid = msv_solve(id2, bid)
    ckf("solve_identity_x1", xid[0] * 1.0, 5.0)
    ckf("solve_identity_x2", xid[1] * 1.0, 7.0)

    // --- msv_cramer_2x2: [[2,1],[1,3]], b=[3,5] -> [0.8,1.4] ---
    let cr = msv_cramer_2x2(a21, b21)
    ckf("cramer_x1", cr[0] * 1.0, 0.8)
    ckf("cramer_x2", cr[1] * 1.0, 1.4)

    // --- msv_residual near 0 for correct solution ---
    let res = msv_residual(a21, x21, b21)
    ckf("residual_near_zero", res, 0.0)

    // --- msv_solvable: non-singular -> true ---
    let solvable = msv_solvable(a21, 0.0001)
    ckb("solvable_true", solvable, true)

    // --- Singular system: [[1,2],[2,4]], b=[1,3] -> empty list ---
    let sing = mk22(1.0, 2.0, 2.0, 4.0)
    let bsing = [1.0, 3.0]
    let xsing = msv_solve(sing, bsing)
    cki("singular_empty", len(xsing), 0)

    // --- msv_solvable: singular -> false ---
    let solvable_sing = msv_solvable(sing, 0.0001)
    ckb("solvable_false", solvable_sing, false)

    // --- msv_is_consistent: non-singular -> true ---
    let cons = msv_is_consistent(a21, b21, 0.0001)
    ckb("consistent_true", cons, true)

    // --- 3x3 system: A x = b ---
    // A = [[1,2,3],[0,4,5],[1,0,2]], b=[14,23,5]
    // Solution: x=[1,2,3] (verify: 1+4+9=14, 0+8+15=23, 1+0+6=7... let me recalculate)
    // A = [[2,1,0],[1,3,1],[0,1,2]], b=[5,10,7]
    // 2x+y=5, x+3y+z=10, y+2z=7
    // From row1: 2x+y=5 -> y=5-2x
    // From row3: y+2z=7 -> (5-2x)+2z=7 -> 2z=2+2x -> z=1+x
    // From row2: x+3(5-2x)+(1+x)=10 -> x+15-6x+1+x=10 -> -4x+16=10 -> x=1.5
    // y = 5 - 3 = 2; z = 1 + 1.5 = 2.5
    let a3 = mk33(2.0, 1.0, 0.0, 1.0, 3.0, 1.0, 0.0, 1.0, 2.0)
    let b3 = [5.0, 10.0, 7.0]
    let x3 = msv_solve(a3, b3)
    ckf("solve_3x3_x1", x3[0] * 1.0, 1.5)
    ckf("solve_3x3_x2", x3[1] * 1.0, 2.0)
    ckf("solve_3x3_x3", x3[2] * 1.0, 2.5)

    // --- msv_verify for 3x3 solution ---
    let vflag3 = msv_verify(a3, x3, b3, 0.0001)
    ckb("verify_3x3_true", vflag3, true)

    // --- msv_residual for 3x3 near 0 ---
    let res3 = msv_residual(a3, x3, b3)
    ckf("residual_3x3_near_zero", res3, 0.0)

    // --- msv_solve_multiple: solve for two rhs vectors ---
    let b_mult = [[3.0, 5.0], [5.0, 7.0]]
    let xs_mult = msv_solve_multiple(a21, b_mult)
    let x_m0 = xs_mult[0]
    let x_m1 = xs_mult[1]
    ckf("solve_mult_0_x1", x_m0[0] * 1.0, 0.8)
    ckf("solve_mult_0_x2", x_m0[1] * 1.0, 1.4)
    // For b=[5,7]: 2x+y=5, x+3y=7 -> multiply eq1 by 3: 6x+3y=15; sub eq2: 5x=8 -> x=1.6, y=5-3.2=1.8
    ckf("solve_mult_1_x1", x_m1[0] * 1.0, 1.6)
    ckf("solve_mult_1_x2", x_m1[1] * 1.0, 1.8)

    print("PASS _matsolve_test")
