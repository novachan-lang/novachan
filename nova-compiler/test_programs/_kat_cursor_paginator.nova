import forge_cursor_paginator

fn main()
    let c = cp_new(3)
    let i = 0
    while i < 7
        c = cp_add(c, "k" + str(i), "v" + str(i))
        i = i + 1
    assert(cp_total_count(c) == 7, "7 items")
    assert(cp_total_pages(c) == 3, "3 pages")

    let p1 = cp_page(c, 0)
    assert(p1["count"] == 3, "page 1 = 3 items")
    assert(p1["next_cursor"] == 3, "next cursor = 3")

    let p2 = cp_page(c, 3)
    assert(p2["count"] == 3, "page 2 = 3 items")

    let p3 = cp_page(c, 6)
    assert(p3["count"] == 1, "page 3 = 1 item")

    let k = cp_item_key(c, 0)
    assert(is_ok(k), "key ok")
    assert(unwrap(k) == "k0", "key 0")

    let v = cp_item_value(c, 6)
    assert(is_ok(v), "value ok")
    assert(unwrap(v) == "v6", "value 6")

    let bad = cp_item_key(c, 99)
    assert(is_err(bad), "out of range is err")

    print("CURSOR-PAGINATOR KAT PASS")
