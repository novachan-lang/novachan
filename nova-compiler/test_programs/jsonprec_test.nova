// jsonprec_test — JSON float serialization keeps full precision (was %g = 6 sig
// figs, silently truncating). Now %.15g, matching str()/float_to_str.
fn main()
    // >6 significant figures preserved
    assert_eq(json_encode(3.14159265358979), "3.14159265358979")
    assert_eq(json_stringify([1.23456789012345]), "[1.23456789012345]")
    // short values unchanged (json_float_test compatibility)
    assert_eq(json_encode(3.14), "3.14")
    assert_eq(json_encode(2.5), "2.5")
    assert_eq(json_encode(0.5), "0.5")
    print("jsonprec_test passed")
