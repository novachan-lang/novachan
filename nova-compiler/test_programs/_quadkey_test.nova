// _quadkey_test.nova — KAT for std/geo/quadkey (Bing Maps tile quadkeys)
import std/geo/quadkey

fn cki(label: str, got: int, expected: int)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(expected))
        exit(1)

fn cks(label: str, got: str, expected: str)
    if got != expected
        print("FAIL " + label + ": got=" + got + " want=" + expected)
        exit(1)

fn ckb(label: str, got: bool, expected: bool)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(expected))
        exit(1)

fn main()
    // KAT 1: Bing reference — qk_from_tile(3, 5, 3) == '213'
    cks("from_tile(3,5,3)", qk_from_tile(3, 5, 3), "213")

    // KAT 2: decode '213' -> {tx:3, ty:5, zoom:3}
    let t1 = qk_to_tile("213")
    cki("to_tile 213 tx", t1["tx"], 3)
    cki("to_tile 213 ty", t1["ty"], 5)
    cki("to_tile 213 zoom", t1["zoom"], 3)

    // KAT 3: origin at zoom 1
    cks("from_tile(0,0,1)", qk_from_tile(0, 0, 1), "0")

    // KAT 4: bottom-right at zoom 1
    cks("from_tile(1,1,1)", qk_from_tile(1, 1, 1), "3")

    // KAT 5: zoom
    cki("qk_zoom 213", qk_zoom("213"), 3)
    cki("qk_zoom 0", qk_zoom("0"), 1)

    // KAT 6: parent
    cks("parent 213", qk_parent("213"), "21")
    cks("parent 21", qk_parent("21"), "2")
    cks("parent 2", qk_parent("2"), "")

    // KAT 7: children
    let kids = qk_children("2")
    let k0 = kids[0]
    let k1 = kids[1]
    let k2 = kids[2]
    let k3 = kids[3]
    cks("child 0", k0, "20")
    cks("child 1", k1, "21")
    cks("child 2", k2, "22")
    cks("child 3", k3, "23")

    // KAT 8: is_valid true
    ckb("is_valid 2103", qk_is_valid("2103"), true)

    // KAT 9: is_valid false (contains '4' and '5')
    ckb("is_valid 2145 false", qk_is_valid("2145"), false)

    // KAT 10: round-trip qk_to_tile(qk_from_tile(6,9,4))
    let rt = qk_to_tile(qk_from_tile(6, 9, 4))
    cki("roundtrip(6,9,4) tx", rt["tx"], 6)
    cki("roundtrip(6,9,4) ty", rt["ty"], 9)
    cki("roundtrip(6,9,4) zoom", rt["zoom"], 4)

    // KAT 11: qk_from_tile_valid
    ckb("valid(0,0,0) true", qk_from_tile_valid(0, 0, 0), true)
    ckb("valid(1,1,1) true", qk_from_tile_valid(1, 1, 1), true)
    ckb("valid(2,2,1) false", qk_from_tile_valid(2, 2, 1), false)
    ckb("valid(-1,0,1) false", qk_from_tile_valid(0 - 1, 0, 1), false)

    // KAT 12: additional encode/decode pairs
    cks("from_tile(0,0,3)", qk_from_tile(0, 0, 3), "000")
    cks("from_tile(7,7,3)", qk_from_tile(7, 7, 3), "333")
    let t2 = qk_to_tile("333")
    cki("to_tile 333 tx", t2["tx"], 7)
    cki("to_tile 333 ty", t2["ty"], 7)

    // KAT 13: is_valid empty
    ckb("is_valid empty", qk_is_valid(""), false)

    print("PASS _quadkey_test")
