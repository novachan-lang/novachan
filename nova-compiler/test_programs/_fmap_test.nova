import std/functional/fmap

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _fmap_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL _fmap_test " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn ckl(label: string, got: list, want: list)
    cki(label + ".len", len(got), len(want))
    let i = 0
    while i < len(want)
        cki(label + "[" + str(i) + "]", got[i], want[i])
        i = i + 1

// Helper functions
fn dbl(x)
    x * 2

fn add_idx(i, x)
    i + x

fn dup(x)
    let r = []
    push(r, x)
    push(r, x)
    r

fn main()
    // fm_map: double each element
    let r1 = fm_map(dbl, [1, 2, 3])
    ckl("map_dbl_123", r1, [2, 4, 6])

    // fm_map: empty input
    let r2 = fm_map(dbl, [])
    cki("map_empty_len", len(r2), 0)

    // fm_map: single element
    let r3 = fm_map(dbl, [5])
    ckl("map_single", r3, [10])

    // fm_map: negative values
    let r4 = fm_map(dbl, [0, -3, 7])
    ckl("map_mixed", r4, [0, -6, 14])

    // fm_map_indexed: add index to value
    let r5 = fm_map_indexed(add_idx, [10, 20, 30])
    ckl("map_indexed_add", r5, [10, 21, 32])

    // fm_map_indexed: empty
    let r6 = fm_map_indexed(add_idx, [])
    cki("map_indexed_empty_len", len(r6), 0)

    // fm_map_indexed: single
    let r7 = fm_map_indexed(add_idx, [100])
    ckl("map_indexed_single", r7, [100])

    // fm_flat_map: duplicate each element
    let r8 = fm_flat_map(dup, [1, 2])
    ckl("flat_map_dup_12", r8, [1, 1, 2, 2])

    // fm_flat_map: empty input
    let r9 = fm_flat_map(dup, [])
    cki("flat_map_empty_len", len(r9), 0)

    // fm_flat_map: single element
    let r10 = fm_flat_map(dup, [7])
    ckl("flat_map_single", r10, [7, 7])

    // fm_flat_map: three elements
    let r11 = fm_flat_map(dup, [3, 5, 9])
    ckl("flat_map_three", r11, [3, 3, 5, 5, 9, 9])

    print("PASS _fmap_test")

main()
