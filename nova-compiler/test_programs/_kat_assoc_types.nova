// ASSOCIATED TYPES, NOVA-way: the element type differs per implementation and must be
// INFERRED from the impl, with no `type Item = ...` declaration.
trait Container
    fn first(self) -> any

type IntBox
    ib_v: list

type StrBox
    sb_v: list

fn IntBox.first(self) -> int
    return self.ib_v[0]

fn StrBox.first(self) -> string
    return self.sb_v[0]

fn main()
    let a = IntBox([10, 20])
    let b = StrBox(["x", "y"])
    // each impl returns its OWN element type
    let n = a.first()
    let s = b.first()
    print("int impl:  " + str(n + 5))
    print("str impl:  " + s + "!")
