import std/os/fnmatch

// Helper: check bool
fn cki_bool(label: string, got: bool, expected: bool)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// Helper: check string equality
fn cks(label: string, got: string, expected: string)
    if got != expected
        print("FAIL " + label + ": got [" + got + "] expected [" + expected + "]")
        exit(1)

// --- KAT 1: star wildcard matches suffix ---
cki_bool("star_txt_true",  fn_match("foo.txt", "*.txt"), true)

// --- KAT 2: star wildcard, wrong extension ---
cki_bool("star_txt_false", fn_match("foo.py", "*.txt"), false)

// --- KAT 3: question mark matches exactly one char ---
cki_bool("qmark_one_true",  fn_match("a.txt", "?.txt"), true)

// --- KAT 4: question mark does NOT match two chars ---
cki_bool("qmark_one_false", fn_match("ab.txt", "?.txt"), false)

// --- KAT 5: bracket class positive match ---
cki_bool("bracket_cat_true", fn_match("cat", "[cb]at"), true)

// --- KAT 6: bracket class (second member) ---
cki_bool("bracket_bat_true", fn_match("bat", "[cb]at"), true)

// --- KAT 7: bracket class no match ---
cki_bool("bracket_hat_false", fn_match("hat", "[cb]at"), false)

// --- KAT 8: negated bracket class positive ---
cki_bool("neg_bracket_hat_true", fn_match("hat", "[!cb]at"), true)

// --- KAT 9: negated bracket class negative ---
cki_bool("neg_bracket_cat_false", fn_match("cat", "[!cb]at"), false)

// --- KAT 10: range [a-z] matches lowercase ---
cki_bool("range_m_true",  fn_match("m", "[a-z]"), true)

// --- KAT 11: range [a-z] does NOT match uppercase ---
cki_bool("range_M_false", fn_match("M", "[a-z]"), false)

// --- KAT 12: star matches empty string ---
cki_bool("star_empty", fn_match("", "*"), true)

// --- KAT 13: fn_filter preserves order, picks matching ---
let names = ["a.txt", "b.py", "c.txt"]
let filtered = fn_filter(names, "*.txt")
let fl = len(filtered)
if fl != 2
    print("FAIL filter_len: got " + str(fl) + " expected 2")
    exit(1)
cks("filter_0", filtered[0], "a.txt")
cks("filter_1", filtered[1], "c.txt")

// --- KAT 14: fn_filter empty result ---
let filtered2 = fn_filter(names, "*.go")
if len(filtered2) != 0
    print("FAIL filter_empty: expected 0 got " + str(len(filtered2)))
    exit(1)

// --- KAT 15: fn_match_ci ignores case ---
cki_bool("ci_upper", fn_match_ci("Foo.TXT", "*.txt"), true)
cki_bool("ci_lower", fn_match_ci("FOO.TXT", "*.TXT"), true)

// --- KAT 16: star matches multi-char middle ---
cki_bool("star_mid", fn_match("hello_world.txt", "hello*txt"), true)

// --- KAT 17: exact match no wildcards ---
cki_bool("exact_true",  fn_match("readme", "readme"), true)
cki_bool("exact_false", fn_match("readme.md", "readme"), false)

// --- KAT 18: double star collapses ---
cki_bool("double_star", fn_match("anything", "**"), true)

// --- KAT 19: range boundary inclusive ---
cki_bool("range_a_true", fn_match("a", "[a-z]"), true)
cki_bool("range_z_true", fn_match("z", "[a-z]"), true)
cki_bool("range_0_false", fn_match("0", "[a-z]"), false)

// --- KAT 20: question mark at end ---
cki_bool("qmark_end", fn_match("ab", "a?"), true)
cki_bool("qmark_end_false", fn_match("a", "a?"), false)

print("_fnmatch_test passed")
