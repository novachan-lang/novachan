// KAT for std/text/md_heading
import std/text/md_heading

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL md_heading " + label + ": got [" + got + "]")
        exit(1)

fn main()
    // Core KAT from spec
    cks("h1", md_heading("# Title"), "<h1>Title</h1>")
    cks("h2", md_heading("## Sub"), "<h2>Sub</h2>")
    cks("h6", md_heading("###### Deep"), "<h6>Deep</h6>")

    // All levels
    cks("h3", md_heading("### Third"), "<h3>Third</h3>")
    cks("h4", md_heading("#### Fourth"), "<h4>Fourth</h4>")
    cks("h5", md_heading("##### Fifth"), "<h5>Fifth</h5>")

    // Non-heading returns ""
    cks("nohead_text", md_heading("plain text"), "")
    cks("nohead_empty", md_heading(""), "")
    // 7 hashes is not a heading
    cks("nohead_7hash", md_heading("####### Too many"), "")
    // Hashes without a space after = not a heading
    cks("nohead_nospace", md_heading("#NoSpace"), "")
    // Only hashes, no text after space
    cks("h1_empty_text", md_heading("# "), "<h1></h1>")

    // Text with spaces preserved
    cks("h2_spaces", md_heading("## Hello World"), "<h2>Hello World</h2>")

    print("PASS _md_heading_test")
