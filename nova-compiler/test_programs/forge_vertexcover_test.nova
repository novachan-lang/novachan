import forge_vertexcover

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn expect_false(name: string, cond: bool) -> int
    if cond
        print("FAIL " + name + ": expected false")
        return 1
    0

fn main()
    let fails = 0

    // triangle a-b-c: greedy picks a,b -> covers all edges, size 2
    let tri = [["a", "b"], ["b", "c"], ["c", "a"]]
    let ct = vertex_cover(tri)
    fails = fails + expect("triangle_size", str(len(ct)), "2")
    fails = fails + expect_true("triangle_valid", is_vertex_cover(tri, ct))

    // the greedy cover is ALWAYS a valid cover (property test on several graphs)
    let star = [["h", "a"], ["h", "b"], ["h", "c"], ["h", "d"]]
    fails = fails + expect_true("star_valid", is_vertex_cover(star, vertex_cover(star)))
    let path = [["a", "b"], ["b", "c"], ["c", "d"], ["d", "e"]]
    fails = fails + expect_true("path_valid", is_vertex_cover(path, vertex_cover(path)))
    let complex = [["1", "2"], ["2", "3"], ["3", "4"], ["4", "1"], ["1", "3"]]
    fails = fails + expect_true("complex_valid", is_vertex_cover(complex, vertex_cover(complex)))

    // single edge -> both endpoints (size 2)
    fails = fails + expect("single_size", str(vertex_cover_size([["x", "y"]])), "2")

    // no edges -> empty cover
    fails = fails + expect("empty_size", str(vertex_cover_size([])), "0")

    // is_vertex_cover checks: {a} covers a-b but not b-c
    fails = fails + expect_true("cover_yes", is_vertex_cover([["a", "b"]], ["a"]))
    fails = fails + expect_false("cover_no", is_vertex_cover([["a", "b"], ["b", "c"]], ["a"]))
    fails = fails + expect_true("cover_full", is_vertex_cover([["a", "b"], ["b", "c"]], ["b"]))

    // 2-approximation bound: greedy <= 2 * optimal. For a star, optimal=1 (hub), greedy<=2
    fails = fails + expect_true("star_bound", vertex_cover_size(star) <= 2)

    // disconnected edges -> cover both
    fails = fails + expect("disconnected", str(vertex_cover_size([["a", "b"], ["c", "d"]])), "4")

    if fails == 0
        print("forge_vertexcover: all passed")
    else
        print("forge_vertexcover: " + str(fails) + " FAILED")
