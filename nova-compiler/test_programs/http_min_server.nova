// Minimal HTTP server: isolates the runtime primitives from NOVA parsing/dispatch.
fn main()
    let argv = args()
    let port = 18791
    if len(argv) > 1
        port = parse_int(argv[1])
    let sock = http_listen(port)
    print("listening on {port}")
    let conn = http_accept_raw(sock)
    print("accepted conn_len={len(conn)}")
    let client = conn[0]
    let raw = conn[1]
    print("raw_len={len(raw)}")
    let resp = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 2\r\nConnection: close\r\n\r\nhi"
    http_send_raw(client, resp)
    print("sent")
