// KAT test for std/numeric/hyp_anova — one-way ANOVA F-statistic.
import std/numeric/hyp_anova

// approx: check |a-b| < tol; returns 1 if pass
fn approx(a, b, tol) -> float
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < tol

fn ckf(label: string, got: float, want: float, tol: float)
    let ok = approx(got, want, tol)
    if ok == 0
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("ok " + label)

fn main()
    // KAT 1: three identical groups -> F approx 0.0
    // All means equal -> SSB=0 -> F=0
    let g1 = [1.0, 2.0, 3.0]
    let g2 = [1.0, 2.0, 3.0]
    let g3 = [1.0, 2.0, 3.0]
    let grps1 = [g1, g2, g3]
    let f1 = anova_f(grps1)
    ckf("identical_groups -> 0", f1, 0.0, 0.0001)

    // KAT 2: three groups with clearly different means -> F > 1.0
    // a=[1,2,3] mean=2, b=[10,11,12] mean=11, c=[20,21,22] mean=21
    // Grand mean = (2+11+21)/3 = 34/3 ~ 11.33 (weighted equally, n_g=3 each)
    // SSB = 3*(2-11.33)^2 + 3*(11-11.33)^2 + 3*(21-11.33)^2 >> SSW
    let a2 = [1.0, 2.0, 3.0]
    let b2 = [10.0, 11.0, 12.0]
    let c2 = [20.0, 21.0, 22.0]
    let grps2 = [a2, b2, c2]
    let f2 = anova_f(grps2)
    if f2 <= 1.0
        print("FAIL large_diff F should be > 1, got " + str(f2))
        exit(1)
    print("ok large_diff F > 1 (" + str(f2) + ")")

    // KAT 3: single-value groups — no within-group variance -> return 0.0 (guard)
    // Each group has exactly one element -> SSW=0 -> MSW=0 -> guard -> return 0.0
    let s3a = [5.0]
    let s3b = [10.0]
    let s3c = [15.0]
    let grps3 = [s3a, s3b, s3c]
    let f3 = anova_f(grps3)
    ckf("single_val_groups -> 0 guard", f3, 0.0, 0.0001)

    // KAT 4: fewer than 2 groups -> 0.0
    let grps4 = [[1.0, 2.0, 3.0]]
    let f4 = anova_f(grps4)
    ckf("one_group -> 0", f4, 0.0, 0.0001)

    // KAT 5: known F value
    // Two groups: a=[2,4,6] mean=4, b=[8,10,12] mean=10
    // Grand mean = (4*3 + 10*3)/6 = 7.0
    // SSB = 3*(4-7)^2 + 3*(10-7)^2 = 3*9 + 3*9 = 54
    // SSW_a = (2-4)^2+(4-4)^2+(6-4)^2 = 4+0+4=8, SSW_b = same = 8, SSW=16
    // MSB = SSB/(k-1) = 54/1 = 54
    // MSW = SSW/(N-k) = 16/4 = 4
    // F = 54/4 = 13.5
    let a5 = [2.0, 4.0, 6.0]
    let b5 = [8.0, 10.0, 12.0]
    let grps5 = [a5, b5]
    let f5 = anova_f(grps5)
    ckf("known_value F=13.5", f5, 13.5, 0.01)

    // KAT 6: F is always >= 0
    let a6 = [1.0, 3.0, 5.0]
    let b6 = [2.0, 4.0, 6.0]
    let c6 = [7.0, 9.0, 11.0]
    let grps6 = [a6, b6, c6]
    let f6 = anova_f(grps6)
    if f6 < 0.0
        print("FAIL F_non_negative: got " + str(f6))
        exit(1)
    print("ok F_non_negative (" + str(f6) + ")")

    print("PASS _hyp_anova_test")
