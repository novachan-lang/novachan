import forge_vector_clock

fn main()
    let vc1 = vc_new()
    vc1 = vc_increment(vc1, "A")
    vc1 = vc_increment(vc1, "A")
    vc1 = vc_increment(vc1, "B")
    assert(vc_get(vc1, "A") == 2, "A=2")
    assert(vc_get(vc1, "B") == 1, "B=1")
    assert(vc_node_count(vc1) == 2, "2 nodes")

    let vc2 = vc_new()
    vc2 = vc_increment(vc2, "A")
    vc2 = vc_increment(vc2, "C")
    vc2 = vc_increment(vc2, "C")
    vc2 = vc_increment(vc2, "C")

    let merged = vc_merge(vc1, vc2)
    assert(vc_get(merged, "A") == 2, "merged A=2 (max)")
    assert(vc_get(merged, "B") == 1, "merged B=1")
    assert(vc_get(merged, "C") == 3, "merged C=3")
    assert(vc_node_count(merged) == 3, "3 nodes merged")

    assert(vc_get(vc1, "missing") == 0, "missing=0")

    let va = vc_new()
    va = vc_increment(va, "X")
    let vb = vc_new()
    vb = vc_increment(vb, "X")
    vb = vc_increment(vb, "X")
    assert(vc_happens_before(va, vb) == 1, "a < b")
    assert(vc_happens_before(vb, va) == 0, "b not < a")

    print("VECTOR-CLOCK KAT PASS")
