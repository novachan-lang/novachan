fn main()
    let pass = 1

    if ct_eq("hello", "hello") != 1
        print("FAIL: ct_eq equal")
        pass = 0

    if ct_eq("hello", "world") != 0
        print("FAIL: ct_eq unequal same len")
        pass = 0

    if ct_eq("short", "longer_string") != 0
        print("FAIL: ct_eq diff len")
        pass = 0

    if ct_eq("", "") != 1
        print("FAIL: ct_eq empty")
        pass = 0

    if ct_eq("", "notempty") != 0
        print("FAIL: ct_eq one empty")
        pass = 0

    let h1 = "a3f2b1c4d5e6f7890123456789abcdef"
    let h2 = "a3f2b1c4d5e6f7890123456789abcdef"
    let h3 = "a3f2b1c4d5e6f7890123456789abcdee"
    if ct_eq(h1, h2) != 1
        print("FAIL: ct_eq hash match")
        pass = 0
    if ct_eq(h1, h3) != 0
        print("FAIL: ct_eq hash differ last byte")
        pass = 0

    // secure_zero: use a heap-allocated string (concat forces heap copy)
    let secret = "" + "MySecretPassword123!"
    let before_len = len(secret)
    secure_zero(secret)
    if before_len != 20
        print("FAIL: secure_zero pre-check")
        pass = 0

    if pass == 1
        print("SECURITY-PRIMITIVES KAT PASS")
    else
        print("SECURITY-PRIMITIVES KAT FAIL")
