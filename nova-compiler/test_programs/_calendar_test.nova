// KAT for std/time/calendar — leap years, days-in-month, day-of-year,
// month/weekday name lookups, and Sakamoto weekday computation.
import std/time/calendar

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": " + str(got) + " != " + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": " + str(got) + " != " + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": '" + got + "' != '" + want + "'")
        exit(1)

fn main()
    // ── cal_is_leap ───────────────────────────────────────────────────────
    ckb("leap-2000",  cal_is_leap(2000), true)
    ckb("leap-1900",  cal_is_leap(1900), false)
    ckb("leap-2024",  cal_is_leap(2024), true)
    ckb("leap-2023",  cal_is_leap(2023), false)
    // century not divisible by 400
    ckb("leap-1800",  cal_is_leap(1800), false)
    // regular divisible-by-4
    ckb("leap-2020",  cal_is_leap(2020), true)

    // ── cal_days_in_month ─────────────────────────────────────────────────
    cki("dim-2024-feb", cal_days_in_month(2024, 2), 29)
    cki("dim-2023-feb", cal_days_in_month(2023, 2), 28)
    cki("dim-2024-apr", cal_days_in_month(2024, 4), 30)
    cki("dim-2024-jan", cal_days_in_month(2024, 1), 31)
    cki("dim-2024-dec", cal_days_in_month(2024, 12), 31)
    // 1900 is NOT a leap year → Feb = 28
    cki("dim-1900-feb", cal_days_in_month(1900, 2), 28)

    // ── cal_day_of_year ───────────────────────────────────────────────────
    cki("doy-2024-mar1",  cal_day_of_year(2024, 3, 1), 61)   // Jan(31)+Feb(29)+1
    cki("doy-2023-jan1",  cal_day_of_year(2023, 1, 1), 1)
    cki("doy-2023-dec31", cal_day_of_year(2023, 12, 31), 365)
    cki("doy-2024-dec31", cal_day_of_year(2024, 12, 31), 366) // leap year
    cki("doy-2023-feb28", cal_day_of_year(2023, 2, 28), 59)   // Jan(31)+28

    // ── cal_month_name ────────────────────────────────────────────────────
    cks("mname-1",  cal_month_name(1),  "January")
    cks("mname-2",  cal_month_name(2),  "February")
    cks("mname-6",  cal_month_name(6),  "June")
    cks("mname-12", cal_month_name(12), "December")

    // ── cal_weekday_name ──────────────────────────────────────────────────
    cks("wdname-0", cal_weekday_name(0), "Sunday")
    cks("wdname-1", cal_weekday_name(1), "Monday")
    cks("wdname-6", cal_weekday_name(6), "Saturday")

    // ── cal_weekday ───────────────────────────────────────────────────────
    // 2024-01-01 was a Monday = 1
    cki("wd-2024-01-01", cal_weekday(2024, 1, 1), 1)
    // 2023-01-01 was a Sunday = 0
    cki("wd-2023-01-01", cal_weekday(2023, 1, 1), 0)
    // 2000-01-01 was a Saturday = 6
    cki("wd-2000-01-01", cal_weekday(2000, 1, 1), 6)
    // 1970-01-01 was a Thursday = 4
    cki("wd-1970-01-01", cal_weekday(1970, 1, 1), 4)

    print("_calendar_test passed")
