// Test source location builtins: __file__, __line__, __func__

fn helper() -> string
    return __func__

fn get_line() -> int
    return __line__

fn main()
    // __file__ returns the source filename
    let f = __file__
    assert(contains(f, "source_loc_test"), "file contains test name")

    // __line__ returns the current line number
    let l = __line__
    assert(l > 0, "line > 0")

    // __func__ returns the current function name
    let fn_name = __func__
    assert(fn_name == "main", "func is main")

    // __func__ in a helper function
    assert(helper() == "helper", "helper func name")

    // __line__ changes per call site
    let l1 = get_line()
    let l2 = get_line()
    assert(l1 == l2, "same func same line")

    print("source_loc: all passed")
