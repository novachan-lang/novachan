fn _store_task(c, r)
    let store = {}
    let msg = recv(c)
    store["key1"] = msg
    send(r, "stored")
    let msg2 = recv(c)
    let k = msg2
    if contains(store, k)
        send(r, "found: " + str(store[k]))
    else
        send(r, "NOT FOUND for key: " + k + " keys=" + str(keys(store)))

fn main()
    let d = {}
    d["name"] = "NOVA"
    d["age"] = "30"
    print("has name: " + str(contains(d, "name")))
    print("has age: " + str(contains(d, "age")))
    print("has missing: " + str(contains(d, "missing")))
    print("get name: " + str(d["name"]))
    del(d, "name")
    print("after del, has name: " + str(contains(d, "name")))
    print("after del, has age: " + str(contains(d, "age")))

    let ch = channel()
    let rch = channel()
    let c = ch
    let r = rch
    spawn(fn(x) _store_task(c, r))
    send(ch, "hello")
    let r1 = recv(rch)
    print("store result: " + r1)
    send(ch, "key1")
    let r2 = recv(rch)
    print("lookup result: " + r2)
