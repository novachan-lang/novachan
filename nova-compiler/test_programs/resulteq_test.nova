// resulteq_test — Result/Option value equality compares the payload.
// Was a real silent bug: ok(1) == ok(2) returned TRUE (NovaResult was NOVA_MEM_RAW,
// so nova_rt_eq strcmp'd it as a C string and the tag byte 0 made every ok(...) an
// empty string -> all equal). Now NovaResult is a 2-slot struct -> structural eq.

fn main()
    // Result
    assert(ok(1) == ok(1), "ok same payload equal")
    assert(ok(1) != ok(2), "ok different payload unequal")
    assert(ok(1) != err(1), "ok != err even with same payload")
    assert(err(5) == err(5), "err same payload equal")
    assert(err(5) != err(6), "err different payload unequal")

    // Option
    assert(some(3) == some(3), "some same equal")
    assert(some(3) != some(4), "some different unequal")
    assert(none() == none(), "none equal none")
    assert(some(1) != none(), "some != none")

    // assert_eq routes through nova_rt_eq
    assert_eq(ok(42), ok(42))
    assert_eq(err("boom"), err("boom"))

    // string payloads compare by value
    assert(ok("a") == ok("a"), "ok string payload equal")
    assert(ok("a") != ok("b"), "ok string payload unequal")

    print("resulteq_test passed")
