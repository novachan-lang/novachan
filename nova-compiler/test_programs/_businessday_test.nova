// KAT for std/time/businessday
// Tests bd_is_business, bd_add, bd_count, bd_next.
// Known vectors verified against calendar truth.
import std/time/businessday

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL businessday " + label + ": got " + str(gi) + " want " + str(wi))
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL businessday " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckl(label: string, got: list, y: int, m: int, d: int)
    let gy = got[0]
    let gm = got[1]
    let gd = got[2]
    if gy != y or gm != m or gd != d
        print("FAIL businessday " + label + ": got " + str(gy) + "-" + str(gm) + "-" + str(gd) + " want " + str(y) + "-" + str(m) + "-" + str(d))
        exit(1)

fn main()
    // ── bd_is_business ────────────────────────────────────────────────────
    // 2024-03-09 = Saturday → not a business day
    ckb("sat-not-biz",  bd_is_business(2024, 3, 9),  false)
    // 2024-03-10 = Sunday → not a business day
    ckb("sun-not-biz",  bd_is_business(2024, 3, 10), false)
    // 2024-03-08 = Friday → business day
    ckb("fri-is-biz",   bd_is_business(2024, 3, 8),  true)
    // 2024-03-11 = Monday → business day
    ckb("mon-is-biz",   bd_is_business(2024, 3, 11), true)
    // 2024-03-07 = Thursday → business day
    ckb("thu-is-biz",   bd_is_business(2024, 3, 7),  true)
    // 1970-01-01 = Thursday
    ckb("1970-01-01-biz", bd_is_business(1970, 1, 1), true)
    // 2000-01-01 = Saturday
    ckb("2000-01-01-sat", bd_is_business(2000, 1, 1), false)

    // ── bd_add forward ────────────────────────────────────────────────────
    // Fri 2024-03-08 + 1 biz = Mon 2024-03-11 (skip weekend)
    ckl("add-fri+1",  bd_add(2024, 3, 8, 1),  2024, 3, 11)
    // Mon 2024-03-11 + 1 biz = Tue 2024-03-12
    ckl("add-mon+1",  bd_add(2024, 3, 11, 1), 2024, 3, 12)
    // Mon 2024-03-11 + 4 biz = Fri 2024-03-15
    ckl("add-mon+4",  bd_add(2024, 3, 11, 4), 2024, 3, 15)
    // Mon 2024-03-11 + 5 biz = Mon 2024-03-18
    ckl("add-mon+5",  bd_add(2024, 3, 11, 5), 2024, 3, 18)
    // Fri 2024-03-08 + 5 biz = Fri 2024-03-15
    ckl("add-fri+5",  bd_add(2024, 3, 8, 5),  2024, 3, 15)
    // Fri 2024-12-27 + 3 biz = Wed 2025-01-01 (year boundary)
    ckl("add-yearbound", bd_add(2024, 12, 27, 3), 2025, 1, 1)

    // ── bd_add backward ───────────────────────────────────────────────────
    // Mon 2024-03-11 - 1 biz = Fri 2024-03-08
    ckl("add-mon-1",  bd_add(2024, 3, 11, -1), 2024, 3, 8)
    // Tue 2024-03-12 - 1 biz = Mon 2024-03-11
    ckl("add-tue-1",  bd_add(2024, 3, 12, -1), 2024, 3, 11)
    // Mon 2024-03-11 - 5 biz = Mon 2024-03-04
    ckl("add-mon-5",  bd_add(2024, 3, 11, -5), 2024, 3, 4)

    // ── bd_add zero ───────────────────────────────────────────────────────
    ckl("add-zero",   bd_add(2024, 3, 8, 0),  2024, 3, 8)

    // ── bd_count ──────────────────────────────────────────────────────────
    // Mon 2024-03-04 .. Mon 2024-03-11 (exclusive) = Mon-Fri = 5 business days
    cki("count-week",     bd_count(2024, 3, 4, 2024, 3, 11), 5)
    // Same start == end → 0
    cki("count-empty",    bd_count(2024, 3, 11, 2024, 3, 11), 0)
    // d1 > d2 → 0
    cki("count-reverse",  bd_count(2024, 3, 11, 2024, 3, 4), 0)
    // Sat..Mon (2 calendar days) → 1 business day (Monday only)
    cki("count-sat-mon",  bd_count(2024, 3, 9, 2024, 3, 11), 0)
    // Sat..Tue → 1 business day (Monday only, Tue excluded)
    cki("count-sat-tue",  bd_count(2024, 3, 9, 2024, 3, 12), 1)
    // Mon 2024-03-11 .. Fri 2024-03-15 (exclusive) = Mon..Thu = 4
    cki("count-mon-fri",  bd_count(2024, 3, 11, 2024, 3, 15), 4)
    // Full 2-week span: Mon Mar 4 .. Mon Mar 18 (exclusive) = 10
    cki("count-2weeks",   bd_count(2024, 3, 4, 2024, 3, 18), 10)
    // Year-spanning: Mon Dec 30 2024 .. Fri Jan 3 2025 (excl) = Mon-Thu = 4
    cki("count-yearbnd",  bd_count(2024, 12, 30, 2025, 1, 3), 4)

    // ── bd_next ───────────────────────────────────────────────────────────
    // Sat 2024-03-09 → Mon 2024-03-11
    ckl("next-sat",   bd_next(2024, 3, 9),  2024, 3, 11)
    // Sun 2024-03-10 → Mon 2024-03-11
    ckl("next-sun",   bd_next(2024, 3, 10), 2024, 3, 11)
    // Fri 2024-03-08 → Mon 2024-03-11 (skip weekend)
    ckl("next-fri",   bd_next(2024, 3, 8),  2024, 3, 11)
    // Mon 2024-03-11 → Tue 2024-03-12
    ckl("next-mon",   bd_next(2024, 3, 11), 2024, 3, 12)
    // Thu 2024-03-07 → Fri 2024-03-08
    ckl("next-thu",   bd_next(2024, 3, 7),  2024, 3, 8)

    // ── Round-trip: bd_add then bd_add back ───────────────────────────────
    // Wed 2024-06-05 + 7 biz = Wed 2024-06-14; -7 biz = back to Wed 2024-06-05
    let fwd = bd_add(2024, 6, 5, 7)
    ckl("rt-fwd",  fwd, 2024, 6, 14)
    let bk = bd_add(2024, 6, 14, -7)
    ckl("rt-back", bk,  2024, 6, 5)

    print("PASS _businessday_test")
