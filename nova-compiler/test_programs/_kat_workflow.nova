import forge_workflow

fn main()
    let wf = wf_new("order", "pending")
    wf = wf_add_state(wf, "pending", "initial")
    wf = wf_add_state(wf, "approved", "normal")
    wf = wf_add_state(wf, "rejected", "final")
    wf = wf_add_state(wf, "shipped", "normal")
    wf = wf_add_state(wf, "delivered", "final")

    wf = wf_add_transition(wf, "pending", "approved", "approve")
    wf = wf_add_transition(wf, "pending", "rejected", "reject")
    wf = wf_add_transition(wf, "approved", "shipped", "ship")
    wf = wf_add_transition(wf, "shipped", "delivered", "deliver")

    assert(wf_state(wf) == "pending", "initial state")
    assert(wf_can_send(wf, "approve") == true, "can approve")
    assert(wf_can_send(wf, "deliver") == false, "cant deliver yet")

    let events = wf_available_events(wf)
    assert(len(events) == 2, "2 events from pending")

    wf = wf_send(wf, "approve")
    assert(wf_state(wf) == "approved", "approved")

    wf = wf_send(wf, "ship")
    assert(wf_state(wf) == "shipped", "shipped")

    wf = wf_send(wf, "deliver")
    assert(wf_state(wf) == "delivered", "delivered")
    assert(wf_is_final(wf) == true, "delivered is final")

    let hist = wf_history(wf)
    assert(len(hist) == 3, "3 transitions")
    assert(hist[0]["event"] == "approve", "first event")
    assert(hist[2]["event"] == "deliver", "last event")

    wf = wf_reset(wf)
    assert(wf_state(wf) == "pending", "reset to pending")
    assert(len(wf_history(wf)) == 0, "history cleared")

    wf = wf_set_data(wf, "payment_ok", 1)
    let pay = wf_get_data(wf, "payment_ok")
    assert(pay == 1, "data stored")
    assert(wf_get_data(wf, "missing") == null, "missing data null")

    let wf2 = wf_new("review", "draft")
    wf2 = wf_add_state(wf2, "draft", "initial")
    wf2 = wf_add_state(wf2, "published", "final")
    wf2 = wf_add_guarded_transition(wf2, "draft", "published", "publish", "approved")
    wf2 = wf_send(wf2, "publish")
    assert(wf_state(wf2) == "draft", "guard blocked")
    wf2 = wf_set_data(wf2, "approved", 1)
    wf2 = wf_send(wf2, "publish")
    assert(wf_state(wf2) == "published", "guard passed")

    print("WORKFLOW KAT PASS")
