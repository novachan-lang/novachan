import forge_graphql_schema

fn main()
    let s = gql_schema()
    let user_fields = ["id", "name", "email", "age"]
    s = gql_add_type(s, "User", user_fields)
    let post_fields = ["id", "title", "body", "author_id"]
    s = gql_add_type(s, "Post", post_fields)

    let types = gql_type_names(s)
    assert(len(types) == 2, "2 types")

    assert(gql_field_count(s, "User") == 4, "User has 4 fields")
    assert(gql_field_count(s, "Post") == 4, "Post has 4 fields")

    s = gql_add_query(s, "user", "User")
    s = gql_add_query(s, "users", "User")
    s = gql_add_mutation(s, "createUser", "User")

    assert(gql_query_count(s) == 2, "2 queries")
    assert(gql_mutation_count(s) == 1, "1 mutation")

    s = gql_add_query_arg(s, "user", "id", "ID!")
    s = gql_add_query_arg(s, "users", "limit", "Int")

    let user_type = gql_get_type(s, "User")
    assert(user_type["name"] == "User", "type name")
    assert(len(user_type["fields"]) == 4, "type fields")

    assert(gql_field_count(s, "Missing") == 0, "missing type 0 fields")

    let intro = gql_introspect_types(s)
    assert(len(intro) == 2, "2 introspected types")

    print("GRAPHQL-SCHEMA KAT PASS")
