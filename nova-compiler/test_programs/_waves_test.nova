// KAT for std/physics/waves — wave mechanics formulas.
import std/physics/waves

// approx — float equality within 0.001 tolerance.
fn approx(a, b)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < 0.001

fn ckf(label, got, want)
    if not approx(got, want)
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // wave_speed: v = freq * wavelength
    // freq=2, wavelength=3 -> v=6
    ckf("wave_speed(2,3)", wave_speed(2.0, 3.0), 6.0)
    // freq=100, wavelength=3.4 -> v=340
    ckf("wave_speed(100,3.4)", wave_speed(100.0, 3.4), 340.0)
    // freq=10, wavelength=34 -> v=340
    ckf("wave_speed(10,34)", wave_speed(10.0, 34.0), 340.0)

    // wave_period: T = 1 / freq
    // freq=2 -> T=0.5
    ckf("wave_period(2.0)", wave_period(2.0), 0.5)
    // freq=50 -> T=0.02
    ckf("wave_period(50.0)", wave_period(50.0), 0.02)
    // freq=1 -> T=1
    ckf("wave_period(1.0)", wave_period(1.0), 1.0)

    // wavenumber: k = 2*pi / lambda
    // lambda = 2*pi -> k=1
    let two_pi = 2.0 * 3.14159265358979
    ckf("wavenumber(2pi)", wavenumber(two_pi), 1.0)
    // lambda=1 -> k=2*pi~6.2831853
    ckf("wavenumber(1.0)", wavenumber(1.0), 6.2831853)

    // angular_frequency: omega = 2*pi * freq
    // freq=1 -> omega=2*pi~6.2831853
    ckf("angular_frequency(1.0)", angular_frequency(1.0), 6.2831853)
    // freq=0.5 -> omega=pi~3.14159
    ckf("angular_frequency(0.5)", angular_frequency(0.5), 3.14159265358979)

    print("PASS _waves_test")
