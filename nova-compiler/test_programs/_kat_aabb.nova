import forge_aabb

fn tf(b: bool) -> string
    if b
        return "T"
    "F"

fn main()
    let a = [0, 0, 10, 10]
    let b = [5, 5, 10, 10]
    let c = [20, 20, 5, 5]
    let d = [10, 0, 5, 5]
    print("overlap=" + tf(aabb_intersects(a, b)))
    print("disjoint=" + tf(aabb_intersects(a, c)))
    print("touching=" + tf(aabb_intersects(a, d)))
    print("pt_in=" + tf(aabb_contains_point(a, 5.0, 5.0)))
    print("pt_out=" + tf(aabb_contains_point(a, 10.0, 5.0)))
    print("pt_corner=" + tf(aabb_contains_point(a, 0.0, 0.0)))
    // containment: a contains inner
    let inner = [2, 2, 3, 3]
    print("contains=" + tf(aabb_contains(a, inner)))
    print("not_contains=" + tf(aabb_contains(a, b)))
    // intersection rect of a and b = [5,5,5,5]
    let ix = aabb_intersection(a, b)
    print("inter=" + tf(ix[0] == 5 and ix[1] == 5 and ix[2] == 5 and ix[3] == 5))
    // intersection of disjoint = zero rect
    let iz = aabb_intersection(a, c)
    print("inter_zero=" + tf(iz[2] == 0 and iz[3] == 0))
