import std/net/mimetype

fn cks(label: string, got: string, want: string)
    if got == want
        return
    print("FAIL " + label + ": got=" + got + " want=" + want)
    exit(1)

fn cki(label: string, got: int, want: int)
    if got == want
        return
    print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
    exit(1)

fn main()
    // KAT 1: html extension no dot
    cks("ext_html",   mt_by_ext("html"),            "text/html")
    // KAT 2: png extension with leading dot
    cks("ext_dot_png", mt_by_ext(".png"),           "image/png")
    // KAT 3: uppercase JS (case-insensitive)
    cks("ext_JS",     mt_by_ext("JS"),              "text/javascript")
    // KAT 4: mt_by_path extracts extension from full path
    cks("path_json",  mt_by_path("/a/b.json"),      "application/json")
    // KAT 5: unknown extension -> octet-stream
    cks("ext_unknown", mt_by_ext("unknownext"),     "application/octet-stream")
    // KAT 6: mt_is_text("text/html") -> true
    cki("is_text_html", mt_is_text("text/html"),     1)
    // KAT 7: mt_is_text("image/png") -> false
    cki("is_text_png",  mt_is_text("image/png"),     0)
    // KAT 8: mt_is_text("application/json") -> true
    cki("is_text_json", mt_is_text("application/json"), 1)
    // KAT 9: css extension
    cks("ext_css",    mt_by_ext("css"),              "text/css")
    // KAT 10: mjs extension (ES module)
    cks("ext_mjs",    mt_by_ext("mjs"),              "text/javascript")
    // KAT 11: md extension
    cks("ext_md",     mt_by_ext("md"),               "text/markdown")
    // KAT 12: woff2 font
    cks("ext_woff2",  mt_by_ext("woff2"),            "font/woff2")
    // KAT 13: svg image
    cks("ext_svg",    mt_by_ext("svg"),              "image/svg+xml")
    // KAT 14: wasm binary
    cks("ext_wasm",   mt_by_ext("wasm"),             "application/wasm")
    // KAT 15: gz archive
    cks("ext_gz",     mt_by_ext(".gz"),              "application/gzip")
    // KAT 16: mt_is_text("application/xml") -> true
    cki("is_text_xml", mt_is_text("application/xml"), 1)
    // KAT 17: mt_is_text("application/javascript") -> true
    cki("is_text_js",  mt_is_text("application/javascript"), 1)
    // KAT 18: mp4 video
    cks("ext_mp4",    mt_by_ext("mp4"),              "video/mp4")
    // KAT 19: jpeg alias
    cks("ext_jpeg",   mt_by_ext("jpeg"),             "image/jpeg")
    // KAT 20: mt_by_path with Windows-style path
    cks("path_win",   mt_by_path("C:\\docs\\file.pdf"), "application/pdf")
    // KAT 21: path with no extension -> octet-stream
    cks("path_noext", mt_by_path("/etc/hosts"),      "application/octet-stream")
    // KAT 22: htm alias
    cks("ext_htm",    mt_by_ext("htm"),              "text/html")
    print("_mimetype_test passed")
