import std/grammar/grammar_first

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn ckl(label, got, expected)
    if len(got) != len(expected)
        print("FAIL " + label + ": length " + str(len(got)) + " != " + str(len(expected)))
        let i = 0
        while i < len(got)
            print("  got[" + str(i) + "]=" + got[i])
            i = i + 1
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != expected[i]
            print("FAIL " + label + "[" + str(i) + "]: '" + got[i] + "' != '" + expected[i] + "'")
            exit(1)
        i = i + 1

fn main()
    // Dragon-book LL(1) expression grammar:
    // E -> T X
    // X -> + T X | epsilon
    // T -> F Y
    // Y -> * F Y | epsilon
    // F -> ( E ) | id

    let prods = []

    // E -> T X
    let rhsE = []
    push(rhsE, "T")
    push(rhsE, "X")
    let pE = []
    push(pE, "E")
    push(pE, rhsE)
    push(prods, pE)

    // X -> + T X
    let rhsX1 = []
    push(rhsX1, "+")
    push(rhsX1, "T")
    push(rhsX1, "X")
    let pX1 = []
    push(pX1, "X")
    push(pX1, rhsX1)
    push(prods, pX1)

    // X -> epsilon
    let rhsX2 = []
    let pX2 = []
    push(pX2, "X")
    push(pX2, rhsX2)
    push(prods, pX2)

    // T -> F Y
    let rhsT = []
    push(rhsT, "F")
    push(rhsT, "Y")
    let pT = []
    push(pT, "T")
    push(pT, rhsT)
    push(prods, pT)

    // Y -> * F Y
    let rhsY1 = []
    push(rhsY1, "*")
    push(rhsY1, "F")
    push(rhsY1, "Y")
    let pY1 = []
    push(pY1, "Y")
    push(pY1, rhsY1)
    push(prods, pY1)

    // Y -> epsilon
    let rhsY2 = []
    let pY2 = []
    push(pY2, "Y")
    push(pY2, rhsY2)
    push(prods, pY2)

    // F -> ( E )
    let rhsF1 = []
    push(rhsF1, "(")
    push(rhsF1, "E")
    push(rhsF1, ")")
    let pF1 = []
    push(pF1, "F")
    push(pF1, rhsF1)
    push(prods, pF1)

    // F -> id
    let rhsF2 = []
    push(rhsF2, "id")
    let pF2 = []
    push(pF2, "F")
    push(pF2, rhsF2)
    push(prods, pF2)

    // KAT 1: FIRST(E) = ["(", "id"]
    let fe = grammar_first.grf_first_symbol(prods, "E")
    let exp_E = []
    push(exp_E, "(")
    push(exp_E, "id")
    ckl("FIRST_E", fe, exp_E)

    // KAT 2: FIRST(X) = ["", "+"]   (epsilon sorts before "+")
    let fx = grammar_first.grf_first_symbol(prods, "X")
    let exp_X = []
    push(exp_X, "")
    push(exp_X, "+")
    ckl("FIRST_X", fx, exp_X)

    // KAT 3: FIRST(Y) = ["", "*"]
    let fy = grammar_first.grf_first_symbol(prods, "Y")
    let exp_Y = []
    push(exp_Y, "")
    push(exp_Y, "*")
    ckl("FIRST_Y", fy, exp_Y)

    // KAT 4: FIRST(T) = ["(", "id"]
    let ft = grammar_first.grf_first_symbol(prods, "T")
    let exp_T = []
    push(exp_T, "(")
    push(exp_T, "id")
    ckl("FIRST_T", ft, exp_T)

    // KAT 5: FIRST(F) = ["(", "id"]
    let ff = grammar_first.grf_first_symbol(prods, "F")
    let exp_F = []
    push(exp_F, "(")
    push(exp_F, "id")
    ckl("FIRST_F", ff, exp_F)

    // KAT 6: FIRST of terminal "id" = ["id"]
    let fid = grammar_first.grf_first_symbol(prods, "id")
    let exp_id = []
    push(exp_id, "id")
    ckl("FIRST_id", fid, exp_id)

    // KAT 7: FIRST(F Y) = FIRST(F) since F not nullable = ["(", "id"]
    let seq_FY = []
    push(seq_FY, "F")
    push(seq_FY, "Y")
    let fFY = grammar_first.grf_first_seq(prods, seq_FY)
    let exp_FY = []
    push(exp_FY, "(")
    push(exp_FY, "id")
    ckl("FIRST_FY", fFY, exp_FY)

    // KAT 8: FIRST(X Y) = FIRST(X)+FIRST(Y) since X and Y both nullable = ["","*","+"]
    let seq_XY = []
    push(seq_XY, "X")
    push(seq_XY, "Y")
    let fXY = grammar_first.grf_first_seq(prods, seq_XY)
    // "" < "*" < "+"
    let exp_XY = []
    push(exp_XY, "")
    push(exp_XY, "*")
    push(exp_XY, "+")
    ckl("FIRST_XY", fXY, exp_XY)

    // KAT 9: FIRST of terminal "+" = ["+"]
    let fplus = grammar_first.grf_first_symbol(prods, "+")
    let exp_plus = []
    push(exp_plus, "+")
    ckl("FIRST_plus", fplus, exp_plus)

    // KAT 10: grf_first_sets returns pairs for all 5 NTs (E,F,T,X,Y)
    let all_sets = grammar_first.grf_first_sets(prods)
    cki("first_sets_count", len(all_sets), 5)

    print("PASS _grammar_first_test")
