// cross_import_extern_test -- permanent guard: a MODULE (_extmod) declares an extern + a safe
// wrapper, and THIS file imports it and calls the wrapper across the boundary. Proves the
// compiler resolves an imported module's extern declarations (compile_module_ir extern_fn path),
// i.e. cross-import FFI works -- the capability that unblocks DB-via-Forge (import sqlitex).
import _extmod

fn main()
    let n = _extmod.mylen("hello")
    assert(n == 5, "cross-import extern strlen returns 5")
    print("cross_import_extern_test passed")
