fn main()
    let buf = buffer_create()
    buf_append(buf, "hello")
    buf_append(buf, " ")
    buf_append(buf, "world")
    let result = buf_to_str(buf)
    assert(result == "hello world", "buffer basic concat")

    let buf2 = buffer_create()
    let empty = buf_to_str(buf2)
    assert(empty == "", "empty buffer")

    let buf3 = buffer_create()
    let i = 0
    while i < 100
        buf_append(buf3, "x")
        i = i + 1
    let long_str = buf_to_str(buf3)
    assert(len(long_str) == 100, "buffer 100 appends")

    let buf4 = buffer_create()
    buf_append(buf4, "abc")
    buf_append(buf4, "def")
    assert(buf_len(buf4) == 6, "buf_len")

    buf_clear(buf4)
    assert(buf_len(buf4) == 0, "buf_clear resets len")
    buf_append(buf4, "new")
    assert(buf_to_str(buf4) == "new", "buffer reuse after clear")

    print("All buffer tests passed")
