import std/httphdr/http_cookie

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)

fn main()
    // ── KAT: hck_get ──────────────────────────────────────────────────────────
    cks("get theme", hck_get("sid=abc; theme=dark", "theme"), "dark")
    cks("get sid", hck_get("sid=abc; theme=dark", "sid"), "abc")
    cks("get missing", hck_get("sid=abc; theme=dark", "nope"), "")
    cks("get empty header", hck_get("", "sid"), "")

    // ── KAT: hck_parse_cookie ─────────────────────────────────────────────────
    let p1 = hck_parse_cookie("a=1; b=2")
    cki("parse count", len(p1), 2)
    let pa = p1[0]
    let pb = p1[1]
    cks("parse a name", pa[0], "a")
    cks("parse a val", pa[1], "1")
    cks("parse b name", pb[0], "b")
    cks("parse b val", pb[1], "2")

    // single cookie
    let p2 = hck_parse_cookie("x=hello")
    cki("parse single count", len(p2), 1)
    let ps = p2[0]
    cks("parse single name", ps[0], "x")
    cks("parse single val", ps[1], "hello")

    // empty header
    let p3 = hck_parse_cookie("")
    cki("parse empty", len(p3), 0)

    // extra spaces
    let p4 = hck_parse_cookie("  a=1  ;  b=2  ")
    cki("parse spaces count", len(p4), 2)
    let psa = p4[0]
    let psb = p4[1]
    cks("parse spaces a", psa[0], "a")
    cks("parse spaces b", psb[0], "b")

    // ── KAT: hck_setcookie_name ───────────────────────────────────────────────
    cks("setcookie name", hck_setcookie_name("sid=abc; Path=/; HttpOnly"), "sid")
    cks("setcookie name simple", hck_setcookie_name("tok=val"), "tok")
    cks("setcookie name empty", hck_setcookie_name(""), "")

    // ── KAT: hck_setcookie_value ──────────────────────────────────────────────
    cks("setcookie value", hck_setcookie_value("sid=abc; Path=/"), "abc")
    cks("setcookie value simple", hck_setcookie_value("tok=val"), "val")
    cks("setcookie value empty", hck_setcookie_value(""), "")

    // ── KAT: hck_setcookie_attr ───────────────────────────────────────────────
    cks("attr Max-Age", hck_setcookie_attr("sid=abc; Path=/; Max-Age=3600", "Max-Age"), "3600")
    cks("attr Path", hck_setcookie_attr("sid=abc; Path=/; HttpOnly", "Path"), "/")
    cks("attr Secure present", hck_setcookie_attr("sid=abc; Secure", "Secure"), "true")
    cks("attr HttpOnly present", hck_setcookie_attr("sid=abc; Path=/; HttpOnly", "HttpOnly"), "true")
    cks("attr missing", hck_setcookie_attr("sid=abc; Path=/", "Secure"), "")
    cks("attr case insensitive", hck_setcookie_attr("sid=abc; max-age=600", "Max-Age"), "600")
    cks("attr empty header", hck_setcookie_attr("", "Path"), "")

    print("PASS _http_cookie_test")
