import std/math/continued

// KAT helper: integer equality check
fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// --- KAT 1: cf_from_rational(415, 93) == [4, 2, 6, 7] ---
// Hand-verified: 415 = 4*93 + 43; 93 = 2*43 + 7; 43 = 6*7 + 1; 7 = 7*1 + 0
let r1 = cf_from_rational(415, 93)
let r1_len = len(r1)
cki("kat1_len", r1_len, 4)
cki("kat1_0", r1[0], 4)
cki("kat1_1", r1[1], 2)
cki("kat1_2", r1[2], 6)
cki("kat1_3", r1[3], 7)

// --- KAT 2: cf_to_rational([4, 2, 6, 7]) == [415, 93] ---
// Back-evaluate: 7; 6+1/7=43/7; 2+7/43=93/43; 4+43/93=415/93
let coeffs2 = []
coeffs2.push(4)
coeffs2.push(2)
coeffs2.push(6)
coeffs2.push(7)
let r2 = cf_to_rational(coeffs2)
cki("kat2_num", r2[0], 415)
cki("kat2_den", r2[1], 93)

// --- KAT 3: cf_from_rational(3, 2) == [1, 2] ---
// 3 = 1*2 + 1; 2 = 2*1 + 0 -> [1, 2]
let r3 = cf_from_rational(3, 2)
let r3_len = len(r3)
cki("kat3_len", r3_len, 2)
cki("kat3_0", r3[0], 1)
cki("kat3_1", r3[1], 2)

// --- KAT 4: cf_from_rational(7, 1) == [7] ---
// 7 = 7*1 + 0 -> [7]
let r4 = cf_from_rational(7, 1)
let r4_len = len(r4)
cki("kat4_len", r4_len, 1)
cki("kat4_0", r4[0], 7)

// --- KAT 5: cf_to_rational(cf_from_rational(22, 7)) == [22, 7] ---
// 22/7: 22 = 3*7 + 1; 7 = 7*1 + 0 -> [3, 7]
// cf_to_rational([3,7]): 7; 3+1/7=22/7 -> [22, 7]
let r5_cf = cf_from_rational(22, 7)
let r5 = cf_to_rational(r5_cf)
cki("kat5_num", r5[0], 22)
cki("kat5_den", r5[1], 7)

// --- KAT 6: last convergent of [4,2,6,7] == [415, 93] ---
// Convergents: [4,1],[9,2],[58,13],[415,93]
// Hand-verify: p0=4,q0=1; p1=2*4+1=9,q1=2*1+0=2; p2=6*9+4=58,q2=6*2+1=13;
//              p3=7*58+9=415,q3=7*13+2=93
let cv_coeffs = []
cv_coeffs.push(4)
cv_coeffs.push(2)
cv_coeffs.push(6)
cv_coeffs.push(7)
let cv = cf_convergents(cv_coeffs)
let cv_len = len(cv)
cki("kat6_cvlen", cv_len, 4)
let last = cv[cv_len - 1]
let last0 = last[0]
let last1 = last[1]
cki("kat6_last_num", last0, 415)
cki("kat6_last_den", last1, 93)

// --- KAT 7: intermediate convergents of [4,2,6,7] ---
// cv[0]=[4,1], cv[1]=[9,2], cv[2]=[58,13]
let cv0 = cv[0]
cki("kat7_cv0_num", cv0[0], 4)
cki("kat7_cv0_den", cv0[1], 1)
let cv1 = cv[1]
cki("kat7_cv1_num", cv1[0], 9)
cki("kat7_cv1_den", cv1[1], 2)
let cv2 = cv[2]
cki("kat7_cv2_num", cv2[0], 58)
cki("kat7_cv2_den", cv2[1], 13)

// --- KAT 8: cf_from_rational(1, 1) == [1] ---
let r8 = cf_from_rational(1, 1)
let r8_len = len(r8)
cki("kat8_len", r8_len, 1)
cki("kat8_0", r8[0], 1)

// --- KAT 9: cf_to_rational([3]) == [3, 1] ---
let c9 = []
c9.push(3)
let r9 = cf_to_rational(c9)
cki("kat9_num", r9[0], 3)
cki("kat9_den", r9[1], 1)

// --- KAT 10: cf_from_rational(0, 5) == [0] ---
let r10 = cf_from_rational(0, 5)
let r10_len = len(r10)
cki("kat10_len", r10_len, 1)
cki("kat10_0", r10[0], 0)

print("_continued_test passed")
