// KAT test for std/numeric/lagrange — Lagrange polynomial interpolation.
// Adversarially-verified against exact polynomial values.
//
// All test cases use polynomials that are EXACTLY representable by the
// interpolating polynomial of the given degree, so the error is purely
// floating-point rounding, well within eps=0.001.
//
// KAT assertions:
//   1. lg_interpolate([0,1,2],[0,1,4], 3) == 9.0  (fits y=x^2, extrapolate)
//   2. lg_interpolate([0,1,2],[1,3,5], 3) == 7.0  (fits y=2x+1, extrapolate)
//   3. lg_interpolate([1,2,3],[1,4,9], 4) == 16.0 (fits y=x^2, extrapolate)
//   4. lg_neville   ([0,1,2],[0,1,4], 3) == 9.0  (same polynomial, Neville)
//   5. lg_interpolate([0,2],[0,4], 1)    == 2.0  (linear: y=2x, midpoint)
//   6. lg_neville   ([1,2,3],[1,4,9], 4) == 16.0 (Neville, cross-check KAT3)
import std/numeric/lagrange

// Float-close check with eps
fn ckf(label: string, got: float, want: float, eps: float)
    let d = got - want
    if d < 0.0
        d = 0.0 - d
    if d > eps
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)
    print("ok " + label)

fn main()
    // KAT 1: quadratic y=x^2 through (0,0),(1,1),(2,4), query x=3 -> 9
    let xs1 = [0.0, 1.0, 2.0]
    let ys1 = [0.0, 1.0, 4.0]
    let r1 = lg_interpolate(xs1, ys1, 3.0)
    ckf("lg_interpolate x^2 @ x=3", r1, 9.0, 0.001)

    // KAT 2: linear y=2x+1 through (0,1),(1,3),(2,5), query x=3 -> 7
    let xs2 = [0.0, 1.0, 2.0]
    let ys2 = [1.0, 3.0, 5.0]
    let r2 = lg_interpolate(xs2, ys2, 3.0)
    ckf("lg_interpolate 2x+1 @ x=3", r2, 7.0, 0.001)

    // KAT 3: quadratic y=x^2 through (1,1),(2,4),(3,9), query x=4 -> 16
    let xs3 = [1.0, 2.0, 3.0]
    let ys3 = [1.0, 4.0, 9.0]
    let r3 = lg_interpolate(xs3, ys3, 4.0)
    ckf("lg_interpolate x^2 @ x=4", r3, 16.0, 0.001)

    // KAT 4: Neville — same quadratic (0,0),(1,1),(2,4), query x=3 -> 9
    let xs4 = [0.0, 1.0, 2.0]
    let ys4 = [0.0, 1.0, 4.0]
    let r4 = lg_neville(xs4, ys4, 3.0)
    ckf("lg_neville x^2 @ x=3", r4, 9.0, 0.001)

    // KAT 5: linear y=2x through (0,0),(2,4), query x=1 -> 2
    let xs5 = [0.0, 2.0]
    let ys5 = [0.0, 4.0]
    let r5 = lg_interpolate(xs5, ys5, 1.0)
    ckf("lg_interpolate linear @ x=1", r5, 2.0, 0.001)

    // KAT 6: Neville cross-check — quadratic (1,1),(2,4),(3,9), query x=4 -> 16
    let xs6 = [1.0, 2.0, 3.0]
    let ys6 = [1.0, 4.0, 9.0]
    let r6 = lg_neville(xs6, ys6, 4.0)
    ckf("lg_neville x^2 @ x=4", r6, 16.0, 0.001)

    print("_lagrange_test passed")
