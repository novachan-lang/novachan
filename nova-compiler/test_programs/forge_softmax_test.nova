import forge_softmax

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn near(a: float, b: float) -> bool
    let d = a - b
    d > -0.001 and d < 0.001

fn vsum(v) -> float
    let s = 0.0
    let i = 0
    while i < len(v)
        s = s + v[i] * 1.0
        i = i + 1
    s

fn main()
    let fails = 0

    // argmax
    fails = fails + expect("argmax", str(argmax([1.0, 5.0, 3.0])), "1")
    fails = fails + expect("argmax_empty", str(argmax([])), "-1")

    // equal scores -> uniform
    let u = softmax([2.0, 2.0, 2.0])
    fails = fails + expect_true("uniform0", near(u[0], 0.33333))
    fails = fails + expect_true("uniform_sum", near(vsum(u), 1.0))

    // known: softmax([2,1,0]) = [0.6652, 0.2447, 0.0900]
    let s = softmax([2.0, 1.0, 0.0])
    fails = fails + expect_true("s0", near(s[0], 0.66524))
    fails = fails + expect_true("s1", near(s[1], 0.24473))
    fails = fails + expect_true("s2", near(s[2], 0.09003))
    fails = fails + expect_true("s_sum", near(vsum(s), 1.0))

    // monotonic: higher score -> higher prob; argmax of scores == argmax of probs
    fails = fails + expect_true("mono", s[0] > s[1] and s[1] > s[2])
    fails = fails + expect("prob_argmax", str(argmax(s)), "0")

    // numerical stability: huge scores don't overflow, still valid
    let big = softmax([1000.0, 1000.0])
    fails = fails + expect_true("stable", near(big[0], 0.5) and near(big[1], 0.5))
    let big2 = softmax([1000.0, 999.0, 998.0])
    fails = fails + expect_true("stable_sum", near(vsum(big2), 1.0))

    // temperature: high temp -> more uniform (closer to equal than temp 1)
    let sharp = softmax([2.0, 1.0, 0.0])
    let soft = softmax_temperature([2.0, 1.0, 0.0], 5.0)
    // soft's top prob is LOWER (more uniform) than sharp's top prob
    fails = fails + expect_true("temp_softer", soft[0] < sharp[0])
    fails = fails + expect_true("temp_sum", near(vsum(soft), 1.0))
    // low temp -> sharper
    let peaked = softmax_temperature([2.0, 1.0, 0.0], 0.5)
    fails = fails + expect_true("temp_sharper", peaked[0] > sharp[0])

    // confidence = top prob
    fails = fails + expect_true("confidence", near(softmax_confidence([2.0, 1.0, 0.0]), 0.66524))

    if fails == 0
        print("forge_softmax: all passed")
    else
        print("forge_softmax: " + str(fails) + " FAILED")
