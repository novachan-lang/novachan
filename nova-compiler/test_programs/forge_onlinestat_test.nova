import forge_onlinestat

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn near(a: float, b: float) -> bool
    let d = a - b
    d > -0.0001 and d < 0.0001

fn main()
    let fails = 0

    // classic dataset 2,4,4,4,5,5,7,9 -> mean 5, pop var 4, pop stddev 2
    let s = ostat_new()
    let data = [2, 4, 4, 4, 5, 5, 7, 9]
    let i = 0
    while i < len(data)
        ostat_add(s, data[i])
        i = i + 1
    fails = fails + expect("count", str(ostat_count(s)), "8")
    fails = fails + expect_true("mean", near(ostat_mean(s), 5.0))
    fails = fails + expect_true("pop_var", near(ostat_variance(s), 4.0))
    fails = fails + expect_true("pop_stddev", near(ostat_stddev(s), 2.0))
    fails = fails + expect_true("min", near(ostat_min(s), 2.0))
    fails = fails + expect_true("max", near(ostat_max(s), 9.0))
    // sample variance = 32/7 = 4.5714...
    fails = fails + expect_true("sample_var", near(ostat_sample_variance(s), 4.571428))
    // z-score of 7 = (7-5)/2 = 1.0 ; of 9 = 2.0 ; of 5 = 0.0
    fails = fails + expect_true("z7", near(ostat_zscore(s, 7), 1.0))
    fails = fails + expect_true("z9", near(ostat_zscore(s, 9), 2.0))
    fails = fails + expect_true("z5", near(ostat_zscore(s, 5), 0.0))

    // single value: mean=value, variance=0, min=max=value
    let one = ostat_new()
    ostat_add(one, 42)
    fails = fails + expect_true("one_mean", near(ostat_mean(one), 42.0))
    fails = fails + expect_true("one_var", near(ostat_variance(one), 0.0))
    fails = fails + expect_true("one_min", near(ostat_min(one), 42.0))
    fails = fails + expect("one_sample_var_zero", str(ostat_sample_variance(one)), "0.0")

    // empty
    let e = ostat_new()
    fails = fails + expect("empty_count", str(ostat_count(e)), "0")
    fails = fails + expect_true("empty_mean", near(ostat_mean(e), 0.0))

    // float inputs + negative values: -1.5, 2.5, 4.0 -> mean ~ 1.6667
    let f = ostat_new()
    ostat_add(f, -1.5)
    ostat_add(f, 2.5)
    ostat_add(f, 4.0)
    fails = fails + expect_true("float_mean", near(ostat_mean(f), 1.666666))
    fails = fails + expect_true("float_min", near(ostat_min(f), -1.5))
    fails = fails + expect_true("float_max", near(ostat_max(f), 4.0))

    if fails == 0
        print("forge_onlinestat: all passed")
    else
        print("forge_onlinestat: " + str(fails) + " FAILED")
