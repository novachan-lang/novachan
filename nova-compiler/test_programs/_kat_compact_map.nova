import forge_compact_map

fn main()
    let m = cm_new(3)
    m = cm_put(m, "a", "alpha")
    m = cm_put(m, "b", "beta")
    m = cm_put(m, "c", "gamma")
    assert(cm_count(m) == 3, "3 entries")

    let r1 = cm_get(m, "a")
    assert(is_ok(r1), "get a ok")
    assert(unwrap(r1) == "alpha", "correct value")

    m = cm_put(m, "d", "delta")
    assert(cm_count(m) == 3, "still 3 after eviction")
    assert(cm_eviction_count(m) == 1, "1 eviction")

    assert(cm_has(m, "d") == 1, "has d")

    m = cm_put(m, "b", "beta2")
    let r2 = cm_get(m, "b")
    assert(is_ok(r2), "get updated b")
    assert(unwrap(r2) == "beta2", "updated value")

    print("COMPACT-MAP KAT PASS")
