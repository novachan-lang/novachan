import schema

// Validation for schema DDL + migration generation. Expected SQL written by hand.
fn main()
    // build users(id INTEGER pk, name TEXT not null, age INTEGER)
    let t = schema.schema_table("users")
    t = schema.schema_add(t, "id", "INTEGER", 1, 0)
    t = schema.schema_add(t, "name", "TEXT", 0, 1)
    t = schema.schema_add(t, "age", "INTEGER", 0, 0)

    assert(schema.schema_create_sql(t) == "CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT NOT NULL, age INTEGER)", "create sql")
    assert(schema.schema_create_if_not_exists_sql(t) == "CREATE TABLE IF NOT EXISTS users (id INTEGER PRIMARY KEY, name TEXT NOT NULL, age INTEGER)", "create-if-not-exists sql")
    assert(schema.schema_drop_sql("users") == "DROP TABLE IF EXISTS users", "drop sql")

    // migration: add an email column (nullable) + a required role column
    let t2 = schema.schema_table("users")
    t2 = schema.schema_add(t2, "id", "INTEGER", 1, 0)
    t2 = schema.schema_add(t2, "name", "TEXT", 0, 1)
    t2 = schema.schema_add(t2, "age", "INTEGER", 0, 0)
    t2 = schema.schema_add(t2, "email", "TEXT", 0, 0)
    t2 = schema.schema_add(t2, "role", "TEXT", 0, 1)

    let diff = schema.schema_diff(t, t2)
    assert(len(diff) == 2, "two new columns")
    assert(diff[0] == "ALTER TABLE users ADD COLUMN email TEXT", "add email")
    assert(diff[1] == "ALTER TABLE users ADD COLUMN role TEXT NOT NULL -- needs default", "add role flags NOT NULL needs default")

    // no-op diff when shapes match
    let same = schema.schema_diff(t, t)
    assert(len(same) == 0, "identical schema -> no migration")

    print("schema_lib_test: all passed")
