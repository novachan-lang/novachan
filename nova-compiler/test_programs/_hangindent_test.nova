// KAT for std/textlayout/hangindent — hanging indent / bullet / numbered list.
import std/textlayout/hangindent

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL hangindent " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn ckn(label: string, got: int, want: int)
    if got != want
        print("FAIL hangindent " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck_contains(label: string, haystack: string, needle: string)
    let hn = len(haystack)
    let nn = len(needle)
    if nn == 0
        return
    let found = 0
    let i = 0
    while i <= hn - nn
        if slice(haystack, i, i + nn) == needle
            found = 1
        i = i + 1
    if found == 0
        print("FAIL hangindent " + label + ": '" + haystack + "' does not contain '" + needle + "'")
        exit(1)

fn main()
    let nl = chr(10)

    // hi_continuation_width
    ckn("cont_width_basic", hi_continuation_width(10, 3), 7)
    ckn("cont_width_zero",  hi_continuation_width(5, 5),  1)

    // hi_hang: first line full-width, continuations indented
    // hi_hang("one two three four", 9, 2)
    // first_width=9: "one two"=7 fits, "three"=7+1+5=13>9 flush
    // cont_width=7: "three"=5 fits, "four"=5+1+4=10>7 flush
    // lines: "one two" / "  three" / "  four"
    let hang_out = hi_hang("one two three four", 9, 2)
    let hang_lines = split(hang_out, nl)
    cks("hang_line0", hang_lines[0], "one two")
    cks("hang_line1", hang_lines[1], "  three")
    cks("hang_line2", hang_lines[2], "  four")

    // hi_hang single word: no continuation
    cks("hang_single", hi_hang("hello", 10, 3), "hello")
    // hi_hang empty
    cks("hang_empty", hi_hang("", 10, 3), "")

    // hi_bullet: bullet on first line, aligned continuation
    // hi_bullet("apple banana", 8, "* ")
    // blen=2, first_width=6: "apple"=5 fits; "apple banana"=12>6 flush
    // Result: "* apple\n  banana"
    let bullet_want = "* apple" + nl + "  banana"
    cks("bullet_basic", hi_bullet("apple banana", 8, "* "), bullet_want)
    // Single word fits on bullet line
    cks("bullet_one", hi_bullet("hello", 12, "- "), "- hello")
    // Empty text
    cks("bullet_empty", hi_bullet("", 10, "* "), "* ")

    // hi_numbered: items with 1. / 2. prefixes
    let num_items = ["first item", "second"]
    let num_out = hi_numbered(num_items, 20)
    ck_contains("numbered_1", num_out, "1. ")
    ck_contains("numbered_2", num_out, "2. ")
    ck_contains("numbered_text1", num_out, "first item")
    ck_contains("numbered_text2", num_out, "second")

    // hi_first_indent: different indent for line 0 vs rest
    // text="aa bb cc", width=7, first="A: ", rest="   "
    // first_width=7-3=4: "aa"=2,"aa bb"=5>4 flush. Line0="aa"
    // rest_width=7-3=4: "bb"=2,"bb cc"=5>4 flush. Line1="bb", Line2="cc"
    let fi_want = "A: aa" + nl + "   bb" + nl + "   cc"
    cks("first_indent", hi_first_indent("aa bb cc", 7, "A: ", "   "), fi_want)

    // hi_dedent_hang: strip leading indent spaces
    let hung = hi_hang("one two three four", 9, 2)
    let dehung = hi_dedent_hang(hung, 2)
    let dlines = split(dehung, nl)
    cks("dedent_line0", dlines[0], "one two")
    cks("dedent_line1", dlines[1], "three")
    cks("dedent_line2", dlines[2], "four")

    print("PASS _hangindent_test")
