// _gen_test.nova -- KAT for std/testing/gen
// Deterministic test-data generators (seeded 64-bit LCG).
//
// KAT values pre-computed from the LCG formula:
//   next = (seed * 6364136223846793005 + 1442695040888963407) & 0x7FFFFFFFFFFFFFFF
//
// All values independently verified in Python before embedding here.
import std/testing/gen

// Integer known-answer check.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// String known-answer check.
fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn main()
    // KAT 1: tgen_int(3,3,anyseed) == 3 — lo==hi, span=1, always returns lo.
    cki("int_fixed_99", tgen_int(3, 3, 99), 3)
    cki("int_fixed_0",  tgen_int(3, 3, 0),  3)

    // KAT 2: tgen_int(0,9,7) in [0,9] and has exact deterministic value.
    // Python: tgen_seed_next(7) & 9 mod 10 = 0  =>  result = 0
    let v09 = tgen_int(0, 9, 7)
    cki("int_0_9_7_exact", v09, 0)
    // Confirm bounds (belt-and-suspenders)
    let in_lo = 0
    if v09 >= 0
        in_lo = 1
    cki("int_ge_lo", in_lo, 1)
    let in_hi = 0
    if v09 <= 9
        in_hi = 1
    cki("int_le_hi", in_hi, 1)

    // KAT 3: len(tgen_string(5,1)) == 5 and exact value "qfkdi"
    let s5 = tgen_string(5, 1)
    cki("string_len5", len(s5), 5)
    cks("string_5_1", s5, "qfkdi")

    // KAT 4: len(tgen_list(4,0,10,2)) == 4 with exact elements [6,1,3,7]
    let lst4 = tgen_list(4, 0, 10, 2)
    cki("list_len4",  len(lst4), 4)
    cki("list4_e0", lst4[0], 6)
    cki("list4_e1", lst4[1], 1)
    cki("list4_e2", lst4[2], 3)
    cki("list4_e3", lst4[3], 7)

    // KAT 5: determinism — same seed, same result, every time.
    // Python: tgen_int(1,6,42) = 4
    let d1 = tgen_int(1, 6, 42)
    let d2 = tgen_int(1, 6, 42)
    cki("deterministic", d1, d2)
    cki("int_1_6_42",    d1, 4)

    // KAT 6: tgen_choice(["x"], 9) == "x" — single-item list always returns that item.
    let items1 = ["x"]
    let chosen = tgen_choice(items1, 9)
    cks("choice_single", chosen, "x")

    // KAT 7: every char of tgen_string(10,3) is a lowercase letter (a-z, ord 97-122).
    // Python: "gfynwbyhih"
    let s10 = tgen_string(10, 3)
    cki("string_len10", len(s10), 10)
    cks("string_10_3",  s10, "gfynwbyhih")
    let j = 0
    while j < 10
        let ch = slice(s10, j, j + 1)
        let co = ord(ch)
        let ge_a = 0
        if co >= 97
            ge_a = 1
        cki("char_ge_a_" + str(j), ge_a, 1)
        let le_z = 0
        if co <= 122
            le_z = 1
        cki("char_le_z_" + str(j), le_z, 1)
        j = j + 1

    // KAT 8: tgen_list(3,5,5,1) == [5,5,5] — lo==hi forces every element to lo.
    let lst3 = tgen_list(3, 5, 5, 1)
    cki("list555_len", len(lst3), 3)
    cki("list555_0",   lst3[0], 5)
    cki("list555_1",   lst3[1], 5)
    cki("list555_2",   lst3[2], 5)

    // KAT 9: tgen_bool returns 0 or 1 only.
    // Python: tgen_bool(5)=0, tgen_bool(2)=1
    let b5 = tgen_bool(5)
    cki("bool_5", b5, 0)
    let b2 = tgen_bool(2)
    cki("bool_2", b2, 1)

    // KAT 10: tgen_seed_next is deterministic and matches Python reference.
    // Python: tgen_seed_next(1) = 7806831264735756412
    let sn1 = tgen_seed_next(1)
    let sn2 = tgen_seed_next(1)
    cki("seed_next_det",   sn1, sn2)
    cki("seed_next_1_val", sn1, 7806831264735756412)

    print("_gen_test passed")
