import forge_bulkhead

fn main()
    let b = bh_new(2)

    let r1 = bh_acquire(b)
    assert(is_ok(r1), "acquire 1")
    b = unwrap(r1)
    assert(bh_active(b) == 1, "1 active")

    let r2 = bh_acquire(b)
    assert(is_ok(r2), "acquire 2")
    b = unwrap(r2)
    assert(bh_available(b) == 0, "0 available")

    let r3 = bh_acquire(b)
    assert(is_err(r3), "bulkhead full")
    assert(bh_total_rejected(b) == 1, "1 rejected")

    assert(bh_peak(b) == 2, "peak 2")

    let r4 = bh_release(b)
    assert(is_ok(r4), "release")
    b = unwrap(r4)
    assert(bh_active(b) == 1, "1 active after release")

    assert(bh_rejection_rate(b) == 33, "33% rejection")

    print("BULKHEAD KAT PASS")
