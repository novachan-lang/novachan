// forge_routing2_test -- routing completeness (master plan Phase 1.13/1.14):
// *wildcard catch-all binds the rest of the path; 405 carries an Allow header.
import forge

type Got
    seg: string

fn h_files(req: Request) -> Got
    Got(req.params["p"])

fn h_get(req: Request) -> string
    "got"

fn h_post(req: Request) -> string
    "posted"

fn main()
    let q = chr(34)
    let a = forge.app()
    forge.get(a, "/files/*p", h_files)
    forge.get(a, "/res", h_get)
    forge.post(a, "/res", h_post)

    // catch-all binds the entire remaining path
    let r1: Response = forge.dispatch_req(a, forge.build_request("GET /files/a/b/c.txt HTTP/1.1\r\n\r\n", 0))
    assert(r1.status == 200, "catch-all matches multi-segment")
    assert(find(r1.body, q + "seg" + q + ":" + q + "a/b/c.txt" + q) >= 0, "catch-all binds rest = a/b/c.txt")
    // single segment under the catch-all
    let r2: Response = forge.dispatch_req(a, forge.build_request("GET /files/x HTTP/1.1\r\n\r\n", 0))
    assert(find(r2.body, q + "seg" + q + ":" + q + "x" + q) >= 0, "catch-all single segment")
    print("PASS: *wildcard catch-all")

    // exact routes still work (not shadowed)
    let r3: Response = forge.dispatch_req(a, forge.build_request("GET /res HTTP/1.1\r\n\r\n", 0))
    assert(r3.status == 200 and r3.body == "got", "exact GET still works")

    // 405: a DELETE to /res (only GET/POST registered) -> 405 + Allow: GET, POST
    let r4: Response = forge.dispatch_req(a, forge.build_request("DELETE /res HTTP/1.1\r\n\r\n", 0))
    assert(r4.status == 405, "wrong method -> 405")
    let allow = r4.headers["Allow"]
    assert(find(allow, "GET") >= 0 and find(allow, "POST") >= 0, "Allow header lists GET + POST")
    print("PASS: 405 + Allow header (" + allow + ")")

    // unknown path -> 404
    let r5: Response = forge.dispatch_req(a, forge.build_request("GET /nope HTTP/1.1\r\n\r\n", 0))
    assert(r5.status == 404, "unknown path -> 404")
    print("PASS: 404 unchanged")
    print("forge_routing2_test passed")
