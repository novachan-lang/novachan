// Reflection Phase 2: @derive(Eq) generates a structural `eq` method.
// Scalar fields via ==; nested @derive(Eq) struct fields via .eq(). Also verifies
// STACKED derives (@derive(Show) + @derive(Eq) on one struct) work together.

@derive(Eq)
type Point
    x: int
    y: int

@derive(Eq)
type Seg
    a: Point
    b: Point

@derive(Show)
@derive(Eq)
type Pair
    a: int
    b: int

fn main()
    // scalar equality
    let p1 = Point { x: 3, y: 4 }
    let p2 = Point { x: 3, y: 4 }
    let p3 = Point { x: 3, y: 9 }
    assert_eq(p1.eq(p2), true)
    assert_eq(p1.eq(p3), false)

    // nested: Seg.eq uses Point.eq on each field
    let s1 = Seg { a: Point { x: 0, y: 0 }, b: Point { x: 1, y: 1 } }
    let s2 = Seg { a: Point { x: 0, y: 0 }, b: Point { x: 1, y: 1 } }
    let s3 = Seg { a: Point { x: 0, y: 0 }, b: Point { x: 2, y: 2 } }
    assert_eq(s1.eq(s2), true)
    assert_eq(s1.eq(s3), false)

    // stacked derives: Pair has BOTH show and eq
    let pr = Pair { a: 1, b: 2 }
    assert_eq(pr.show(), "Pair \{ a: 1, b: 2 \}")
    assert_eq(pr.eq(Pair { a: 1, b: 2 }), true)
    assert_eq(pr.eq(Pair { a: 9, b: 2 }), false)

    print("derive_eq_test passed")
