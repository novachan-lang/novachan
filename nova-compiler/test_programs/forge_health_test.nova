// Forge T8.5/T8.6/T8.7: readiness probe (registered checks; first failure names the culprit) +
// structured JSON logging (one valid JSON line). Socketless, deterministic.
import forge_obs

fn check_ok()
    true
fn check_fail()
    false

fn main()
    // structured log line
    let f = {}
    f["user"] = "alice"
    f["status"] = 200
    let line = log_json("info", "request done", f)
    let q = chr(34)
    if find(line, q + "level" + q + ":" + q + "info") < 0
        print("FAIL: log_json level field")
        exit(1)
    if find(line, "alice") < 0 or find(line, "request done") < 0
        print("FAIL: log_json msg/fields")
        exit(1)

    // readiness: all checks pass -> ready
    let okc = [["db", check_ok], ["cache", check_ok]]
    let r1 = readiness(okc)
    if r1["ready"] != 1
        print("FAIL: readiness should be ready")
        exit(1)

    // readiness: one check fails -> not ready, names the failed check
    let badc = [["db", check_ok], ["cache", check_fail]]
    let r2 = readiness(badc)
    if r2["ready"] != 0 or r2["failed"] != "cache"
        print("FAIL: readiness ready=" + str(r2["ready"]) + " failed=" + r2["failed"])
        exit(1)

    print("PASS forge_health (JSON log line valid; readiness ok + names the failed check)")
