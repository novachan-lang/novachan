import std/math/ts_cumsum

fn approx(a: float, b: float, tol: float) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < tol
        return 1
    return 0

fn check_list(label: str, got: list, want: list, tol: float)
    if len(got) != len(want)
        print("FAIL " + label + " len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        let g = got[i] * 1.0
        let w = want[i] * 1.0
        if approx(g, w, tol) == 0
            print("FAIL " + label + "[" + str(i) + "] got=" + str(g) + " want=" + str(w))
            exit(1)
        i = i + 1

fn main()
    // KAT 1: ts_cumsum([1,2,3,4]) == [1,3,6,10]
    let s1 = [1.0, 2.0, 3.0, 4.0]
    let r1 = ts_cumsum(s1)
    let want1 = [1.0, 3.0, 6.0, 10.0]
    check_list("ts_cumsum basic", r1, want1, 0.0001)

    // KAT 2: ts_cumsum([]) == []
    let s2 = []
    let r2 = ts_cumsum(s2)
    if len(r2) != 0
        print("FAIL ts_cumsum empty len=" + str(len(r2)))
        exit(1)

    // KAT 3: ts_cumsum single element
    let s3 = [7.0]
    let r3 = ts_cumsum(s3)
    let want3 = [7.0]
    check_list("ts_cumsum single", r3, want3, 0.0001)

    // KAT 4: ts_cumprod([1,2,3]) == [1,2,6]
    let p1 = [1.0, 2.0, 3.0]
    let rp1 = ts_cumprod(p1)
    let wantp1 = [1.0, 2.0, 6.0]
    check_list("ts_cumprod basic", rp1, wantp1, 0.0001)

    // KAT 5: ts_cumprod([]) == []
    let p2 = []
    let rp2 = ts_cumprod(p2)
    if len(rp2) != 0
        print("FAIL ts_cumprod empty len=" + str(len(rp2)))
        exit(1)

    // KAT 6: ts_cumprod([2,3,4]) == [2,6,24]
    let p3 = [2.0, 3.0, 4.0]
    let rp3 = ts_cumprod(p3)
    let wantp3 = [2.0, 6.0, 24.0]
    check_list("ts_cumprod 2-3-4", rp3, wantp3, 0.0001)

    // KAT 7: ts_cumsum with negatives [-1,2,-3] -> [-1,1,-2]
    let s4 = [-1.0, 2.0, -3.0]
    let r4 = ts_cumsum(s4)
    let want4 = [-1.0, 1.0, -2.0]
    check_list("ts_cumsum negatives", r4, want4, 0.0001)

    print("PASS _ts_cumsum_test")
