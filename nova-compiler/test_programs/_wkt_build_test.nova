// KAT: std/data/wkt_build
import std/data/wkt_build
import std/data/wkt_parse

fn approx(a, b, tol) -> int
    wkt_approx(a, b, tol)

fn ck_i(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck_s(label, got, want)
    if got != want
        print("FAIL " + label + ": got=[" + got + "] want=[" + want + "]")
        exit(1)

fn ck_f(label, got, want)
    if approx(got, want, 0.0001) == 0
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ── Test 1: POINT integer coords ─────────────────────────────────────────────
let g1 = {}
let c1 = []
let pair1 = []
pair1.push(1.0)
pair1.push(2.0)
c1.push(pair1)
g1["type"] = "POINT"
g1["coords"] = c1
let wkt1 = wkt_build(g1)
ck_s("point_int", wkt1, "POINT(1 2)")

// ── Test 2: POINT float coords ────────────────────────────────────────────────
let g2 = {}
let c2 = []
let pair2 = []
pair2.push(1.5)
pair2.push(2.7)
c2.push(pair2)
g2["type"] = "POINT"
g2["coords"] = c2
let wkt2 = wkt_build(g2)
ck_s("point_float", wkt2, "POINT(1.5 2.7)")

// ── Test 3: LINESTRING ───────────────────────────────────────────────────────
let g3 = {}
let c3 = []
let pa3 = []
pa3.push(1.0)
pa3.push(2.0)
let pb3 = []
pb3.push(3.0)
pb3.push(4.0)
c3.push(pa3)
c3.push(pb3)
g3["type"] = "LINESTRING"
g3["coords"] = c3
let wkt3 = wkt_build(g3)
ck_s("ls_int", wkt3, "LINESTRING(1 2, 3 4)")

// ── Test 4: POLYGON ──────────────────────────────────────────────────────────
let g4 = {}
let c4 = []
let p40 = []
p40.push(0.0)
p40.push(0.0)
let p41 = []
p41.push(1.0)
p41.push(0.0)
let p42 = []
p42.push(1.0)
p42.push(1.0)
let p43 = []
p43.push(0.0)
p43.push(1.0)
let p44 = []
p44.push(0.0)
p44.push(0.0)
c4.push(p40)
c4.push(p41)
c4.push(p42)
c4.push(p43)
c4.push(p44)
g4["type"] = "POLYGON"
g4["coords"] = c4
let wkt4 = wkt_build(g4)
ck_s("poly", wkt4, "POLYGON((0 0, 1 0, 1 1, 0 1, 0 0))")

// ── Test 5: POINT round-trip ─────────────────────────────────────────────────
let g5 = {}
let c5 = []
let pair5 = []
pair5.push(-73.9857)
pair5.push(40.7484)
c5.push(pair5)
g5["type"] = "POINT"
g5["coords"] = c5
let wkt5 = wkt_build(g5)
let rt5 = wkt_parse(wkt5)
ck_s("rt_point_type", rt5["type"], "POINT")
let rtc5 = rt5["coords"]
ck_i("rt_point_len", len(rtc5), 1)
let rtp5 = rtc5[0]
ck_f("rt_point_x", rtp5[0], -73.9857)
ck_f("rt_point_y", rtp5[1], 40.7484)

// ── Test 6: LINESTRING round-trip ────────────────────────────────────────────
let g6 = {}
let c6 = []
let pa6 = []
pa6.push(1.5)
pa6.push(2.5)
let pb6 = []
pb6.push(3.5)
pb6.push(4.5)
c6.push(pa6)
c6.push(pb6)
g6["type"] = "LINESTRING"
g6["coords"] = c6
let wkt6 = wkt_build(g6)
let rt6 = wkt_parse(wkt6)
ck_s("rt_ls_type", rt6["type"], "LINESTRING")
let rtc6 = rt6["coords"]
ck_i("rt_ls_len", len(rtc6), 2)
let rta6 = rtc6[0]
let rtb6 = rtc6[1]
ck_f("rt_ls_p0_x", rta6[0], 1.5)
ck_f("rt_ls_p0_y", rta6[1], 2.5)
ck_f("rt_ls_p1_x", rtb6[0], 3.5)
ck_f("rt_ls_p1_y", rtb6[1], 4.5)

// ── Test 7: POLYGON round-trip ───────────────────────────────────────────────
let g7 = {}
let c7 = []
let p70 = []
p70.push(0.0)
p70.push(0.0)
let p71 = []
p71.push(1.0)
p71.push(0.0)
let p72 = []
p72.push(1.0)
p72.push(1.0)
let p73 = []
p73.push(0.0)
p73.push(0.0)
c7.push(p70)
c7.push(p71)
c7.push(p72)
c7.push(p73)
g7["type"] = "POLYGON"
g7["coords"] = c7
let wkt7 = wkt_build(g7)
let rt7 = wkt_parse(wkt7)
ck_s("rt_poly_type", rt7["type"], "POLYGON")
let rtc7 = rt7["coords"]
ck_i("rt_poly_len", len(rtc7), 4)
let rtp70 = rtc7[0]
let rtp72 = rtc7[2]
ck_f("rt_poly_p0_x", rtp70[0], 0.0)
ck_f("rt_poly_p2_x", rtp72[0], 1.0)
ck_f("rt_poly_p2_y", rtp72[1], 1.0)

