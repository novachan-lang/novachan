fn main()
    let pass = true

    // 1. Simple dict
    let d = {"name": "alice", "age": 30}
    let pretty = json_stringify_pretty(d)
    // Should produce multi-line with 2-space indent
    let has_newline = contains(pretty, "\n")
    if not has_newline
        print("FAIL: no newlines in pretty output")
        pass = false

    // 2. Nested structure
    let nested = {"user": {"name": "bob", "scores": [10, 20, 30]}}
    let p2 = json_stringify_pretty(nested)
    // Should have deeper indentation
    let has_4space = contains(p2, "    ")
    if not has_4space
        print("FAIL: no 4-space indent for nested")
        pass = false

    // 3. Empty collections
    let empty_d = json_stringify_pretty({})
    if empty_d != "\{}\n"
        print("FAIL: empty dict should be \{}")
        print("got: " + str(empty_d))
        pass = false

    let empty_l = json_stringify_pretty([])
    if empty_l != "[]\n"
        print("FAIL: empty list should be []")
        print("got: " + str(empty_l))
        pass = false

    // 4. Scalar values
    let s_int = json_stringify_pretty(42)
    if s_int != "42\n"
        print("FAIL: int pretty should be 42 + newline")
        print("got: " + repr(s_int))
        pass = false

    let s_str = json_stringify_pretty("hello")
    if s_str != "\"hello\"\n"
        print("FAIL: string pretty")
        print("got: " + repr(s_str))
        pass = false

    // 5. List of values
    let lst = [1, 2, 3]
    let p3 = json_stringify_pretty(lst)
    let has_bracket_nl = contains(p3, "[\n")
    if not has_bracket_nl
        print("FAIL: list should open bracket then newline")
        pass = false

    // 6. Verify compact form differs from pretty
    let compact = json_stringify(d)
    if compact == pretty
        print("FAIL: pretty should differ from compact")
        pass = false

    if pass
        print("PASS _kat_json_pretty")
    else
        print("FAIL _kat_json_pretty")
