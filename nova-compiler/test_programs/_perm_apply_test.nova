import std/permutation/perm_apply

// cki — check integer equality
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _perm_apply_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// cks — check string equality
fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL _perm_apply_test " + label + ": got=" + got + " want=" + want)
        exit(1)

// list_to_str — convert int list to string for display
fn list_to_str(xs) -> string
    let s = "["
    let i = 0
    let n = len(xs)
    while i < n
        if i > 0
            s = s + ","
        s = s + str(xs[i])
        i = i + 1
    s = s + "]"
    s

// ckl — check int list equality
fn ckl(label: string, got, want)
    if len(got) != len(want)
        print("FAIL _perm_apply_test " + label + ": got=" + list_to_str(got) + " want=" + list_to_str(want))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL _perm_apply_test " + label + ": got=" + list_to_str(got) + " want=" + list_to_str(want))
            exit(1)
        i = i + 1

fn main()
    // --- pa_apply (gather: result[i] = a[p[i]]) ---
    // pa_apply([2,0,1],[10,20,30]): r[0]=a[2]=30, r[1]=a[0]=10, r[2]=a[1]=20
    let r1 = pa_apply([2, 0, 1], [10, 20, 30])
    ckl("apply_201", r1, [30, 10, 20])

    // pa_apply([0,1,2],[5,6,7]): identity -> [5,6,7]
    let r2 = pa_apply([0, 1, 2], [5, 6, 7])
    ckl("apply_identity", r2, [5, 6, 7])

    // pa_apply([1,0],[7,8]): r[0]=a[1]=8, r[1]=a[0]=7
    let r3 = pa_apply([1, 0], [7, 8])
    ckl("apply_transpos", r3, [8, 7])

    // pa_apply([2,1,0],[1,2,3]): reverse -> [3,2,1]
    let r4 = pa_apply([2, 1, 0], [1, 2, 3])
    ckl("apply_reverse", r4, [3, 2, 1])

    // pa_apply([1,2,0],[100,200,300]): r[0]=200, r[1]=300, r[2]=100
    let r5 = pa_apply([1, 2, 0], [100, 200, 300])
    ckl("apply_3cycle", r5, [200, 300, 100])

    // single-element identity
    let r6 = pa_apply([0], [42])
    ckl("apply_single", r6, [42])

    // empty
    let r7 = pa_apply([], [])
    cki("apply_empty_len", len(r7), 0)

    // 4-element: pa_apply([3,0,1,2],[10,20,30,40])
    // r[0]=a[3]=40, r[1]=a[0]=10, r[2]=a[1]=20, r[3]=a[2]=30
    let r8 = pa_apply([3, 0, 1, 2], [10, 20, 30, 40])
    ckl("apply_4cycle", r8, [40, 10, 20, 30])

    // --- pa_apply_inverse (scatter: result[p[i]] = a[i]) ---
    // pa_apply_inverse([2,0,1],[10,20,30]):
    // r[2]=a[0]=10, r[0]=a[1]=20, r[1]=a[2]=30 -> [20,30,10]
    let s1 = pa_apply_inverse([2, 0, 1], [10, 20, 30])
    ckl("apply_inv_201", s1, [20, 30, 10])

    // identity scatter: same as identity gather
    let s2 = pa_apply_inverse([0, 1, 2], [5, 6, 7])
    ckl("apply_inv_identity", s2, [5, 6, 7])

    // transposition: same as gather (self-inverse)
    let s3 = pa_apply_inverse([1, 0], [7, 8])
    ckl("apply_inv_transpos", s3, [8, 7])

    // verify gather then scatter recovers original: apply_inverse(p, apply(p, a)) == a
    let orig = [10, 20, 30]
    let p = [2, 0, 1]
    let gathered = pa_apply(p, orig)
    let recovered = pa_apply_inverse(p, gathered)
    ckl("roundtrip_gather_scatter", recovered, orig)

    // verify scatter then gather recovers original: apply(p, apply_inverse(p, a)) == a
    let scattered = pa_apply_inverse(p, orig)
    let rr = pa_apply(p, scattered)
    ckl("roundtrip_scatter_gather", rr, orig)

    // --- pa_apply_string ---
    // pa_apply_string([2,1,0],'abc'): r[0]=s[2]='c', r[1]=s[1]='b', r[2]=s[0]='a' -> 'cba'
    cks("str_reverse", pa_apply_string([2, 1, 0], "abc"), "cba")

    // identity
    cks("str_identity", pa_apply_string([0, 1, 2], "xyz"), "xyz")

    // transposition [1,0]: swap first two chars
    cks("str_swap", pa_apply_string([1, 0], "ab"), "ba")

    // 3-cycle [1,2,0]: r[0]=s[1]='e', r[1]=s[2]='l', r[2]=s[0]='h' -> "elh"
    cks("str_3cycle", pa_apply_string([1, 2, 0], "hel"), "elh")

    // longer string
    cks("str_4cycle", pa_apply_string([3, 0, 1, 2], "nova"), "anov")

    // single char
    cks("str_single", pa_apply_string([0], "x"), "x")

    print("PASS _perm_apply_test")
