import std/text/ngram

// ── KAT helpers ──────────────────────────────────────────────────────────────

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got [" + got + "] want [" + want + "]")
        exit(1)

// Check that a list element (string) at position idx equals want.
fn ck_elem(label, lst, idx, want)
    cks(label, lst[idx], want)

// Check list length.
fn ck_len(label, lst, want)
    cki(label + "_len", len(lst), want)

// ── KAT 1: ng_char("abc", 2) == ["ab", "bc"] ─────────────────────────────

let c2 = ng_char("abc", 2)
ck_len("ng_char_abc_2", c2, 2)
ck_elem("ng_char_abc_2[0]", c2, 0, "ab")
ck_elem("ng_char_abc_2[1]", c2, 1, "bc")

// ── KAT 2: ng_char("ab", 3) == [] ────────────────────────────────────────

let c3 = ng_char("ab", 3)
ck_len("ng_char_ab_3", c3, 0)

// ── KAT 3: ng_char("a", 1) == ["a"] ─────────────────────────────────────

let c1 = ng_char("a", 1)
ck_len("ng_char_a_1", c1, 1)
ck_elem("ng_char_a_1[0]", c1, 0, "a")

// ── KAT 4: ng_char with n<1 returns [] ───────────────────────────────────

let c0 = ng_char("hello", 0)
ck_len("ng_char_n0", c0, 0)

// ── KAT 5: ng_word("the big red fox", 2) == ["the big","big red","red fox"] ─

let w2 = ng_word("the big red fox", 2)
ck_len("ng_word_2", w2, 3)
ck_elem("ng_word_2[0]", w2, 0, "the big")
ck_elem("ng_word_2[1]", w2, 1, "big red")
ck_elem("ng_word_2[2]", w2, 2, "red fox")

// ── KAT 6: ng_bigrams("a b c") == ["a b","b c"] ──────────────────────────

let bg = ng_bigrams("a b c")
ck_len("ng_bigrams_abc", bg, 2)
ck_elem("ng_bigrams_abc[0]", bg, 0, "a b")
ck_elem("ng_bigrams_abc[1]", bg, 1, "b c")

// ── KAT 7: ng_word with n > word count returns [] ────────────────────────

let wfew = ng_word("one two", 3)
ck_len("ng_word_too_many", wfew, 0)

// ── KAT 8: ng_freq(["x","x","y"]) -> "x"==2, "y"==1 ────────────────────

let grams = ["x", "x", "y"]
let freq = ng_freq(grams)
cki("ng_freq_x", freq["x"], 2)
cki("ng_freq_y", freq["y"], 1)

// ── KAT 9: ng_freq on char ngrams ────────────────────────────────────────

let abcgrams = ng_char("abab", 2)
// expects: ["ab","ba","ab"] -> "ab"==2, "ba"==1
let abcfreq = ng_freq(abcgrams)
cki("ng_freq_ab", abcfreq["ab"], 2)
cki("ng_freq_ba", abcfreq["ba"], 1)

// ── KAT 10: ng_word unigrams ─────────────────────────────────────────────

let uni = ng_word("hello world", 1)
ck_len("ng_word_1gram", uni, 2)
ck_elem("ng_word_1gram[0]", uni, 0, "hello")
ck_elem("ng_word_1gram[1]", uni, 1, "world")

// ── KAT 11: ng_char on 4-char string with n==4 -> one gram ───────────────

let c4 = ng_char("abcd", 4)
ck_len("ng_char_full", c4, 1)
ck_elem("ng_char_full[0]", c4, 0, "abcd")

// ── KAT 12: ng_word drops multiple spaces ────────────────────────────────

let wsp = ng_word("a  b  c", 2)
// "a  b  c" -> split on single space gives: ["a","","b","","c"]
// but _ng_split_words drops empties, so words=["a","b","c"]
// bigrams: ["a b","b c"]
ck_len("ng_word_multispaces", wsp, 2)
ck_elem("ng_word_multispaces[0]", wsp, 0, "a b")
ck_elem("ng_word_multispaces[1]", wsp, 1, "b c")

print("_ngram_test passed")
