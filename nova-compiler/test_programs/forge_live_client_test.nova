// Forge S5 LiveView: the browser client + template helper. live_client_js returns real JS (placeholders
// materialized to braces) that opens a WebSocket and applies mount/patch frames; live_statics splits a
// marked-up template into the statics list. Shape-smoke only (real client validation is a browser, noted).
// Pure, socketless, deterministic.
import forge_live

fn main()
    let js = live_client_js()
    if len(js) < 50
        print("FAIL: client js suspiciously short")
        exit(1)
    if find(js, "WebSocket") < 0
        print("FAIL: client js missing WebSocket")
        exit(1)
    if find(js, "onmessage") < 0
        print("FAIL: client js missing onmessage handler")
        exit(1)
    // placeholders must be gone; real braces must be present
    if find(js, "@") >= 0 or find(js, chr(35)) >= 0
        print("FAIL: client js still has @/# placeholders (replace failed)")
        exit(1)
    if find(js, chr(123)) < 0 or find(js, chr(125)) < 0
        print("FAIL: client js has no real braces")
        exit(1)

    // live_statics: split a template on its marker -> statics list
    let st = live_statics("<p>n=@@</p>", "@@")
    if len(st) != 2 or st[0] != "<p>n=" or st[1] != "</p>"
        print("FAIL: live_statics should split into statics")
        exit(1)

    print("PASS forge_live_client (live_client_js: WebSocket+onmessage, braces materialized; live_statics splits)")
