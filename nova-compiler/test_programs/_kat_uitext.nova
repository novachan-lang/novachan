import forge_uitext

fn ck(label: string, got: string, want: string)
    let ok = "FAIL"
    if got == want
        ok = "ok"
    print(label + "=" + ok + " (" + got + ")")

fn main()
    ck("list0", humanize_list([], "and"), "")
    ck("list1", humanize_list(["apple"], "and"), "apple")
    ck("list2", humanize_list(["a", "b"], "and"), "a and b")
    ck("list3", humanize_list(["a", "b", "c"], "and"), "a, b and c")
    ck("list_or", humanize_list(["x", "y", "z"], "or"), "x, y or z")
    ck("pc1", pluralize_count(1, "file"), "1 file")
    ck("pc3", pluralize_count(3, "file"), "3 files")
    ck("pc0", pluralize_count(0, "item"), "0 items")
    ck("pc_city", pluralize_count(2, "city"), "2 cities")
    ck("ab_small", abbreviate_number(999), "999")
    ck("ab_1k", abbreviate_number(1000), "1K")
    ck("ab_1_5k", abbreviate_number(1500), "1.5K")
    ck("ab_2m", abbreviate_number(2000000), "2M")
    ck("ab_1_2m", abbreviate_number(1234567), "1.2M")
    ck("ab_3_2b", abbreviate_number(3200000000), "3.2B")
    ck("ab_neg", abbreviate_number(0 - 1500), "-1.5K")
