// _kat_ops_framework -- KAT for 8 forge ops modules
import forge_ops_health
import forge_ops_config
import forge_ops_rollout
import forge_ops_canary
import forge_ops_inventory
import forge_ops_sla
import forge_ops_changelog
import forge_ops_budget

fn _ok_check()
    ok("up")

fn main()
    let pass = 0
    let fail = 0

    let h = oh_new()
    h = oh_add(h, "db", _ok_check)
    let hr = oh_run_all(h)
    if len(hr) == 1 and hr[0]["status"] == "healthy"
        print("  health: OK")
        pass = pass + 1
    else
        print("  health: FAIL")
        fail = fail + 1

    let cfg = {}
    cfg["db_host"] = "localhost"
    cfg["db_port"] = 5432
    let v = oc_get(cfg, "db_host", "none")
    if v == "localhost"
        print("  config: OK")
        pass = pass + 1
    else
        print("  config: FAIL")
        fail = fail + 1

    let plan = or_plan(["a","b","c","d"], 2, 100)
    let batch = or_step(plan, 0)
    if len(batch) == 2
        print("  rollout: OK")
        pass = pass + 1
    else
        print("  rollout: FAIL")
        fail = fail + 1

    let split = ca_split(100, 10)
    if split["canary_count"] == 10 and split["stable_count"] == 90
        print("  canary: OK")
        pass = pass + 1
    else
        print("  canary: FAIL")
        fail = fail + 1

    let t1 = {}
    t1["role"] = "web"
    t1["dc"] = "us-east"
    let t2 = {}
    t2["role"] = "db"
    t2["dc"] = "us-east"
    let inv = oi_new()
    inv = oi_add_host(inv, "web1", t1)
    inv = oi_add_host(inv, "db1", t2)
    let webs = oi_filter(inv, "role", "web")
    if len(webs) == 1
        print("  inventory: OK")
        pass = pass + 1
    else
        print("  inventory: FAIL")
        fail = fail + 1

    let sla = sl_new(99)
    sla = sl_record(sla, 1, 1)
    sla = sl_record(sla, 2, 1)
    sla = sl_record(sla, 3, 0)
    let up = sl_uptime(sla)
    if up == 66 or up == 67
        print("  sla: OK")
        pass = pass + 1
    else
        print("  sla: FAIL (uptime=" + str(up) + ")")
        fail = fail + 1

    let cl = cl_new()
    cl = cl_add(cl, 1000, "alice", "deploy v2", ["deploy"])
    cl = cl_add(cl, 2000, "bob", "fix bug", ["bugfix"])
    let deploys = cl_filter(cl, "deploy")
    if len(deploys) == 1
        print("  changelog: OK")
        pass = pass + 1
    else
        print("  changelog: FAIL")
        fail = fail + 1

    let b = ob_new("cpu", 100)
    let r1 = ob_consume(b, 40)
    if is_ok(r1) and ob_remaining(b) == 60
        print("  budget: OK")
        pass = pass + 1
    else
        print("  budget: FAIL")
        fail = fail + 1

    if fail == 0
        print("OPS-FRAMEWORK KAT PASS")
    else
        print("OPS-FRAMEWORK KAT FAIL (" + str(fail) + " failures)")
