import std/money/accounting

// _ck_s — check string equality; print FAIL + exit(1) on mismatch.
fn _ck_s(label: string, got: string, want: string)
    if got != want
        print("FAIL accounting " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

// _ck_i — check integer equality.
fn _ck_i(label: string, got: int, want: int)
    if got != want
        print("FAIL accounting " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// _ck_b — check boolean equality.
fn _ck_b(label: string, got: bool, want: bool)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL accounting " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

// _ck_list2 — check [a,b] int pair.
fn _ck_list2(label: string, got: list, wa: int, wb: int)
    if len(got) != 2
        print("FAIL accounting " + label + ": list len=" + str(len(got)) + " want 2")
        exit(1)
    if got[0] != wa
        print("FAIL accounting " + label + "[0]: got=" + str(got[0]) + " want=" + str(wa))
        exit(1)
    if got[1] != wb
        print("FAIL accounting " + label + "[1]: got=" + str(got[1]) + " want=" + str(wb))
        exit(1)

fn main()
    // acct_fmt — negative in parens
    _ck_s("fmt_neg", acct_fmt(-123456, 2), "(1,234.56)")

    // acct_fmt — positive
    _ck_s("fmt_pos", acct_fmt(123456, 2), "1,234.56")

    // acct_fmt — zero
    _ck_s("fmt_zero", acct_fmt(0, 2), "0.00")

    // acct_fmt — no decimals
    _ck_s("fmt_no_dec", acct_fmt(1234, 0), "1,234")

    // acct_fmt — small amount (< 100 cents)
    _ck_s("fmt_small", acct_fmt(5, 2), "0.05")

    // acct_fmt — exactly 100 (1.00)
    _ck_s("fmt_100", acct_fmt(100, 2), "1.00")

    // acct_fmt_symbol
    _ck_s("fmt_sym_neg", acct_fmt_symbol(-123456, 2, "$"), "($1,234.56)")
    _ck_s("fmt_sym_pos", acct_fmt_symbol(123456, 2, "$"), "$1,234.56")
    _ck_s("fmt_sym_euro", acct_fmt_symbol(100000, 2, "€"), "€1,000.00")

    // acct_sign_str
    _ck_s("sign_pos", acct_sign_str(100), "DR")
    _ck_s("sign_neg", acct_sign_str(-100), "CR")
    _ck_s("sign_zero", acct_sign_str(0), "")

    // acct_debit_credit
    let dc_pos = acct_debit_credit(500)
    _ck_list2("dc_pos", dc_pos, 500, 0)

    let dc_neg = acct_debit_credit(-500)
    _ck_list2("dc_neg", dc_neg, 0, 500)

    let dc_zero = acct_debit_credit(0)
    _ck_list2("dc_zero", dc_zero, 0, 0)

    // acct_balance
    let debits1 = []
    push(debits1, 1000)
    push(debits1, 500)
    let credits1 = []
    push(credits1, 300)
    _ck_i("balance_basic", acct_balance(debits1, credits1), 1200)

    // acct_is_balanced
    let debits2 = []
    push(debits2, 500)
    let credits2 = []
    push(credits2, 500)
    _ck_b("balanced_true", acct_is_balanced(debits2, credits2), true)

    let debits3 = []
    push(debits3, 500)
    let credits3 = []
    push(credits3, 300)
    _ck_b("balanced_false", acct_is_balanced(debits3, credits3), false)

    // acct_normal_side
    _ck_s("normal_asset", acct_normal_side(100, 1), "DR")
    _ck_s("normal_liability", acct_normal_side(100, 0), "CR")

    // acct_zero_pad
    _ck_s("zero_pad_1", acct_zero_pad(5, 2), "05")
    _ck_s("zero_pad_2", acct_zero_pad(123, 2), "123")
    _ck_s("zero_pad_3", acct_zero_pad(0, 3), "000")

    // Large amount formatting
    _ck_s("fmt_large", acct_fmt(1234567890, 2), "12,345,678.90")

    print("PASS _accounting_test")
