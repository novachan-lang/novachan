import forge_cgroup_limiter

fn main()
    let c = cg_new()
    c = cg_add_group(c, "web", 100, 512)
    c = cg_add_group(c, "worker", 200, 1024)
    assert(cg_group_count(c) == 2, "2 groups")

    let r1 = cg_use_cpu(c, "web", 50)
    assert(is_ok(r1), "cpu ok")
    c = unwrap(r1)
    let r2 = cg_use_mem(c, "web", 256)
    assert(is_ok(r2), "mem ok")
    c = unwrap(r2)

    let cpu = cg_cpu_usage(c, "web")
    assert(is_ok(cpu), "cpu usage ok")
    assert(unwrap(cpu) == 50, "50 cpu")

    let mem = cg_mem_usage(c, "web")
    assert(is_ok(mem), "mem usage ok")
    assert(unwrap(mem) == 256, "256 mem")

    let r3 = cg_use_cpu(c, "web", 60)
    assert(is_err(r3), "cpu limit exceeded")
    assert(cg_violations(c) == 1, "1 violation")

    let bad = cg_use_cpu(c, "nope", 1)
    assert(is_err(bad), "group not found")

    print("CGROUP-LIMITER KAT PASS")
