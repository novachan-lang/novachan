import forge_clientip

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn main()
    let fails = 0
    let trusted = ["10.0.0.0/8", "192.168.0.0/16"]

    // parse
    let chain = parse_forwarded_for("1.2.3.4, 5.6.7.8 , 10.0.0.1")
    fails = fails + expect("parse", join(chain, "|"), "1.2.3.4|5.6.7.8|10.0.0.1")
    fails = fails + expect("parse_empty", str(len(parse_forwarded_for(""))), "0")

    // SECURE: both proxies trusted -> real client is leftmost real IP
    fails = fails + expect("secure_both_trusted", client_ip("1.2.3.4, 10.0.0.1", "10.0.0.2", trusted), "1.2.3.4")

    // SECURE SPOOF DEFENSE: client forged "1.2.3.4"; the entry your trusted proxy added is 9.9.9.9 (the real
    // direct client). Walk from right: 10.0.0.2 trusted, 9.9.9.9 NOT trusted -> real client = 9.9.9.9 (forged
    // 1.2.3.4 ignored).
    fails = fails + expect("secure_spoof", client_ip("1.2.3.4, 9.9.9.9", "10.0.0.2", trusted), "9.9.9.9")

    // direct connection, no proxy, remote not trusted -> remote_addr
    fails = fails + expect("secure_direct", client_ip("", "203.0.113.5", trusted), "203.0.113.5")

    // all hops trusted -> fall back to leftmost claim
    fails = fails + expect("secure_all_trusted", client_ip("192.168.1.1", "10.0.0.2", trusted), "192.168.1.1")

    // client connects directly but sends a forged XFF; remote not trusted -> ignore XFF entirely, use remote
    fails = fails + expect("secure_untrusted_peer", client_ip("1.1.1.1, 2.2.2.2", "203.0.113.9", trusted), "203.0.113.9")

    // naive leftmost
    fails = fails + expect("naive", client_ip_leftmost("1.2.3.4, 5.6.7.8", "10.0.0.2"), "1.2.3.4")
    fails = fails + expect("naive_empty", client_ip_leftmost("", "203.0.113.5"), "203.0.113.5")

    // helpers
    fails = fails + expect_true("trusted_yes", is_trusted_proxy("10.5.5.5", trusted))
    fails = fails + expect_true("trusted_no", is_trusted_proxy("8.8.8.8", trusted) == false)
    fails = fails + expect("hops", str(proxy_hop_count("1.2.3.4, 5.6.7.8, 9.9.9.9")), "3")

    if fails == 0
        print("forge_clientip: all passed")
    else
        print("forge_clientip: " + str(fails) + " FAILED")
