// _maidenhead_test.nova — KAT for std/geo/maidenhead
import std/geo/maidenhead

fn cki(label: str, got: int, expected: int)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(expected))
        exit(1)

fn cks(label: str, got: str, expected: str)
    if got != expected
        print("FAIL " + label + ": got=" + got + " want=" + expected)
        exit(1)

fn ckb(label: str, got: bool, expected: bool)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(expected))
        exit(1)

fn ckf(label: str, got: float, expected: float, eps: float)
    let diff = got - expected
    if diff < 0.0
        diff = 0.0 - diff
    if diff > eps
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(expected) + " eps=" + str(eps))
        exit(1)

fn main()
    // KAT 1: Munich reference value (well-known from ham radio)
    cks("Munich JN58td", mh_encode(48.14666, 11.60833, 6), "JN58td")

    // KAT 2: equator + prime meridian at precision 4
    cks("equator JJ00", mh_encode(0.0, 0.0, 4), "JJ00")

    // KAT 3: south-west corner (south pole, date line) at precision 2
    cks("SW corner AA", mh_encode(0.0 - 90.0, 0.0 - 180.0, 2), "AA")

    // KAT 4: mh_is_valid — valid code
    ckb("is_valid JN58td", mh_is_valid("JN58td"), true)

    // KAT 5: mh_is_valid — 'Z' out of A-R field range
    ckb("is_valid ZZ99 false", mh_is_valid("ZZ99"), false)

    // KAT 6: mh_is_valid — valid 4-char code
    ckb("is_valid JN58 true", mh_is_valid("JN58"), true)

    // KAT 7: mh_is_valid — too short
    ckb("is_valid J false", mh_is_valid("J"), false)

    // KAT 8: round-trip — center of JN58td within subsquare size (~0.042 lon, 0.021 lat)
    let c1 = mh_center("JN58td")
    let c1_lat = c1[0] * 1.0
    let c1_lon = c1[1] * 1.0
    // subsquare resolution: lat=1/24 deg ≈ 0.042, lon=2/24 ≈ 0.083
    // Munich is at 48.14666, 11.60833 — should be within the subsquare that covers it
    ckf("JN58td center lat", c1_lat, 48.14666, 0.05)
    ckf("JN58td center lon", c1_lon, 11.60833, 0.1)

    // KAT 9: mh_precision
    cki("precision JN58td", mh_precision("JN58td"), 6)
    cki("precision JN58", mh_precision("JN58"), 4)
    cki("precision JN", mh_precision("JN"), 2)

    // KAT 10: mh_field
    cks("field Munich", mh_field(48.14666, 11.60833), "JN")

    // KAT 11: decode JN58td bounds
    let d1 = mh_decode("JN58td")
    let d1_lat_lo = d1["lat_lo"] * 1.0
    let d1_lat_hi = d1["lat_hi"] * 1.0
    let d1_lon_lo = d1["lon_lo"] * 1.0
    let d1_lon_hi = d1["lon_hi"] * 1.0
    // Munich 48.14666 must be inside bounds
    if d1_lat_lo > 48.14666 or d1_lat_hi < 48.14666
        print("FAIL JN58td lat bounds: 48.14666 not in [" + str(d1_lat_lo) + "," + str(d1_lat_hi) + "]")
        exit(1)
    if d1_lon_lo > 11.60833 or d1_lon_hi < 11.60833
        print("FAIL JN58td lon bounds: 11.60833 not in [" + str(d1_lon_lo) + "," + str(d1_lon_hi) + "]")
        exit(1)

    // KAT 12: NE corner (north pole adjacent)
    cks("NR99xx near north", mh_encode(89.9, 179.9, 6)[0], "R")

    // KAT 13: round-trip for arbitrary point
    let rt_lat = 51.5074
    let rt_lon = 0.0 - 0.1278
    let rt_grid = mh_encode(rt_lat, rt_lon, 6)
    let rt_d = mh_decode(rt_grid)
    let rt_lat_lo = rt_d["lat_lo"] * 1.0
    let rt_lat_hi = rt_d["lat_hi"] * 1.0
    let rt_lon_lo = rt_d["lon_lo"] * 1.0
    let rt_lon_hi = rt_d["lon_hi"] * 1.0
    if rt_lat_lo > rt_lat or rt_lat_hi < rt_lat
        print("FAIL London lat round-trip: " + str(rt_lat) + " not in [" + str(rt_lat_lo) + "," + str(rt_lat_hi) + "]")
        exit(1)
    if rt_lon_lo > rt_lon or rt_lon_hi < rt_lon
        print("FAIL London lon round-trip: " + str(rt_lon) + " not in [" + str(rt_lon_lo) + "," + str(rt_lon_hi) + "]")
        exit(1)

    print("PASS _maidenhead_test")
