// _bmp_test.nova — KAT for std/media/bmp
//
// BMP 24-bit (BI_RGB) known-answer test.
//
// HAND-VERIFIED VECTORS for bmp_encode(2, 2, [255,0,0, 0,255,0, 0,0,255, 255,255,255])
//
// Image layout (top-down, as supplied):
//   Row 0: red   (255,0,0)    green (0,255,0)
//   Row 1: blue  (0,0,255)    white (255,255,255)
//
// Geometry:
//   raw_stride = 2*3 = 6 bytes
//   pad        = (4 - (6 % 4)) % 4 = (4 - 2) % 4 = 2
//   row_stride = 6 + 2 = 8 bytes
//   imgsize    = 8 * 2 = 16 bytes
//   filesize   = 14 + 40 + 16 = 70 bytes
//   pixoffset  = 54
//
// BITMAPFILEHEADER at offset 0..13 (little-endian):
//   [0]='B'=66, [1]='M'=77
//   [2..5]  = u32le(70)  = 70, 0, 0, 0
//   [6..9]  = u32le(0)   = 0, 0, 0, 0   (reserved)
//   [10..13]= u32le(54)  = 54, 0, 0, 0
//
// BITMAPINFOHEADER at offset 14..53:
//   [14..17]= u32le(40) = 40, 0, 0, 0   (hdrsize)
//   [18..21]= u32le(2)  = 2,  0, 0, 0   (width)
//   [22..25]= u32le(2)  = 2,  0, 0, 0   (height)
//   [26..27]= u16le(1)  = 1, 0           (planes)
//   [28..29]= u16le(24) = 24, 0          (bpp)
//   [30..33]= u32le(0)                   (compression BI_RGB)
//   [34..37]= u32le(16)                  (imgsize)
//   [38..53]= all zeros (xppm,yppm,clrused,clrimp)
//
// PIXEL DATA at offset 54 (bottom-up BGR with 2 pad bytes/row):
//   Row 1 file row (image row 1 = blue+white):
//     col0 blue  BGR: 255, 0,   0
//     col1 white BGR: 255, 255, 255
//     pad:             0,   0
//   Row 0 file row (image row 0 = red+green):
//     col0 red   BGR:  0,   0,  255
//     col1 green BGR:  0, 255,    0
//     pad:              0,   0
//
// Round-trip: bmp_decode(bmp_encode(2,2,px)) must return px unchanged (top-down RGB).

import std/media/bmp

// ── helpers ──────────────────────────────────────────────────────────────────

fn cki(label, got, want)
    if got != want
        print("FAIL bmp " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, b, offset, want)
    let got = bytes_get(b, offset)
    if got != want
        print("FAIL bmp " + label + " byte[" + str(offset) + "]: got=" + str(got) + " want=" + str(want))
        exit(1)

// Read little-endian u32 from bytes b at pos (4 bytes).
fn rd_u32le(b, pos)
    let b0 = bytes_get(b, pos)
    let b1 = bytes_get(b, pos + 1)
    let b2 = bytes_get(b, pos + 2)
    let b3 = bytes_get(b, pos + 3)
    b0 | (b1 * 256) | (b2 * 65536) | (b3 * 16777216)

// Read little-endian u16 from bytes b at pos (2 bytes).
fn rd_u16le(b, pos)
    let b0 = bytes_get(b, pos)
    let b1 = bytes_get(b, pos + 1)
    b0 | (b1 * 256)

fn main()
    // ── KAT 1: encode a 2×2 image ────────────────────────────────────────────
    let px = [255, 0, 0, 0, 255, 0, 0, 0, 255, 255, 255, 255]
    let bmp = bmp_encode(2, 2, px)

    // (a) Total file size must be 70.
    cki("filesize", bytes_len(bmp), 70)

    // (b) Magic bytes 'B'=66, 'M'=77.
    ckb("sig0", bmp, 0, 66)
    ckb("sig1", bmp, 1, 77)

    // (c) u32 @ 2 = filesize = 70.
    cki("u32@2 filesize", rd_u32le(bmp, 2), 70)

    // (d) u32 @ 6 = reserved = 0.
    cki("u32@6 reserved", rd_u32le(bmp, 6), 0)

    // (e) u32 @ 10 = pixoffset = 54.
    cki("u32@10 pixoffset", rd_u32le(bmp, 10), 54)

    // (f) u32 @ 14 = hdrsize = 40.
    cki("u32@14 hdrsize", rd_u32le(bmp, 14), 40)

    // (g) i32 @ 18 = width = 2.
    cki("i32@18 width", rd_u32le(bmp, 18), 2)

    // (h) i32 @ 22 = height = 2.
    cki("i32@22 height", rd_u32le(bmp, 22), 2)

    // (i) u16 @ 26 = planes = 1.
    cki("u16@26 planes", rd_u16le(bmp, 26), 1)

    // (j) u16 @ 28 = bpp = 24.
    cki("u16@28 bpp", rd_u16le(bmp, 28), 24)

    // (k) u32 @ 30 = compression = 0 (BI_RGB).
    cki("u32@30 compression", rd_u32le(bmp, 30), 0)

    // (l) u32 @ 34 = imgsize = 16.
    cki("u32@34 imgsize", rd_u32le(bmp, 34), 16)

    // (m) Zero fields.
    cki("u32@38 xppm", rd_u32le(bmp, 38), 0)
    cki("u32@42 yppm", rd_u32le(bmp, 42), 0)
    cki("u32@46 clrused", rd_u32le(bmp, 46), 0)
    cki("u32@50 clrimp", rd_u32le(bmp, 50), 0)

    // ── KAT 2: pixel data bytes (bottom-up BGR with 2 pad bytes per row) ─────
    // File row 0 at offset 54 = image row 1 (blue+white):
    //   col0 blue  BGR: B=255, G=0,   R=0
    //   col1 white BGR: B=255, G=255, R=255
    //   pad: 0, 0
    ckb("pix[0] blue.B",   bmp, 54, 255)
    ckb("pix[1] blue.G",   bmp, 55,   0)
    ckb("pix[2] blue.R",   bmp, 56,   0)
    ckb("pix[3] white.B",  bmp, 57, 255)
    ckb("pix[4] white.G",  bmp, 58, 255)
    ckb("pix[5] white.R",  bmp, 59, 255)
    ckb("pix[6] pad0",     bmp, 60,   0)
    ckb("pix[7] pad1",     bmp, 61,   0)
    // File row 1 at offset 62 = image row 0 (red+green):
    //   col0 red   BGR: B=0,   G=0,   R=255
    //   col1 green BGR: B=0,   G=255, R=0
    //   pad: 0, 0
    ckb("pix[8]  red.B",   bmp, 62,   0)
    ckb("pix[9]  red.G",   bmp, 63,   0)
    ckb("pix[10] red.R",   bmp, 64, 255)
    ckb("pix[11] green.B", bmp, 65,   0)
    ckb("pix[12] green.G", bmp, 66, 255)
    ckb("pix[13] green.R", bmp, 67,   0)
    ckb("pix[14] pad0",    bmp, 68,   0)
    ckb("pix[15] pad1",    bmp, 69,   0)

    // ── KAT 3: decode round-trip ──────────────────────────────────────────────
    let dec = bmp_decode(bmp)
    cki("rt_w", dec["w"], 2)
    cki("rt_h", dec["h"], 2)
    let dpx = dec["px"]
    cki("rt_px_len", len(dpx), 12)
    // Top-down RGB output must match original input:
    cki("rt_px[0]  R", dpx[0],  255)
    cki("rt_px[1]  G", dpx[1],    0)
    cki("rt_px[2]  B", dpx[2],    0)
    cki("rt_px[3]  R", dpx[3],    0)
    cki("rt_px[4]  G", dpx[4],  255)
    cki("rt_px[5]  B", dpx[5],    0)
    cki("rt_px[6]  R", dpx[6],    0)
    cki("rt_px[7]  G", dpx[7],    0)
    cki("rt_px[8]  B", dpx[8],  255)
    cki("rt_px[9]  R", dpx[9],  255)
    cki("rt_px[10] G", dpx[10], 255)
    cki("rt_px[11] B", dpx[11], 255)

    // ── KAT 4: 1×1 image (no padding needed: 3 bytes raw, padded to 4) ───────
    let px1 = [128, 64, 32]
    let bmp1 = bmp_encode(1, 1, px1)
    // row_stride = ceil(3/4)*4 = 4, imgsize = 4, filesize = 14+40+4 = 58
    cki("1x1_filesize", bytes_len(bmp1), 58)
    cki("1x1_sig0", bytes_get(bmp1, 0), 66)
    cki("1x1_sig1", bytes_get(bmp1, 1), 77)
    cki("1x1_imgsize", rd_u32le(bmp1, 34), 4)
    // Pixel at offset 54: BGR for R=128,G=64,B=32 => B=32, G=64, R=128; then pad byte=0
    ckb("1x1_pix.B", bmp1, 54, 32)
    ckb("1x1_pix.G", bmp1, 55, 64)
    ckb("1x1_pix.R", bmp1, 56, 128)
    ckb("1x1_pad",   bmp1, 57, 0)

    // ── KAT 4b: 1×1 round-trip ────────────────────────────────────────────────
    let dec1 = bmp_decode(bmp1)
    cki("1x1_rt_w", dec1["w"], 1)
    cki("1x1_rt_h", dec1["h"], 1)
    let dpx1 = dec1["px"]
    cki("1x1_rt_R", dpx1[0], 128)
    cki("1x1_rt_G", dpx1[1], 64)
    cki("1x1_rt_B", dpx1[2], 32)

    // ── KAT 5: 4×1 image (no padding needed: 4*3=12, already divisible by 4) ─
    let px4 = [255, 0, 0, 0, 255, 0, 0, 0, 255, 128, 128, 128]
    let bmp4 = bmp_encode(4, 1, px4)
    // row_stride = 12, imgsize = 12, filesize = 14+40+12 = 66
    cki("4x1_filesize", bytes_len(bmp4), 66)
    cki("4x1_imgsize", rd_u32le(bmp4, 34), 12)
    // Round-trip
    let dec4 = bmp_decode(bmp4)
    cki("4x1_rt_w", dec4["w"], 4)
    cki("4x1_rt_h", dec4["h"], 1)
    let dpx4 = dec4["px"]
    cki("4x1_rt_len", len(dpx4), 12)
    cki("4x1_rt_px0", dpx4[0], 255)
    cki("4x1_rt_px1", dpx4[1], 0)
    cki("4x1_rt_px2", dpx4[2], 0)
    cki("4x1_rt_px9", dpx4[9], 128)

    // ── KAT 6: bad magic -> decode returns empty ──────────────────────────────
    let bad = bytes(54)
    // Set byte 0 to 'X'=88 instead of 'B'=66 — bad magic.
    bytes_set(bad, 0, 88)
    bytes_set(bad, 1, 77)
    let dec_bad = bmp_decode(bad)
    cki("bad_magic_w", dec_bad["w"], 0)
    cki("bad_magic_h", dec_bad["h"], 0)

    // ── KAT 7: empty input (0 bytes) -> decode returns empty ─────────────────
    let dec_empty = bmp_decode(bytes(0))
    cki("empty_w", dec_empty["w"], 0)
    cki("empty_h", dec_empty["h"], 0)

    // ── KAT 8: bad input to encode returns 0-length bytes ────────────────────
    let bad_enc = bmp_encode(0, 2, [])
    cki("bad_enc_w0", bytes_len(bad_enc), 0)
    let bad_enc2 = bmp_encode(2, 2, [1, 2, 3])
    cki("bad_enc_wrong_px", bytes_len(bad_enc2), 0)

    print("PASS _bmp_test")
