import std/text/md_escape

fn main()
    // KAT 1: ampersand, angle brackets
    let got1 = md_escape("a<b>&c")
    let exp1 = "a&lt;b&gt;&amp;c"
    if got1 != exp1
        print("FAIL md_escape KAT1: got [" + got1 + "]")
        exit(1)

    // KAT 2: double-quote
    let got2 = md_escape("x" + chr(34) + "y")
    let exp2 = "x&quot;y"
    if got2 != exp2
        print("FAIL md_escape KAT2: got [" + got2 + "]")
        exit(1)

    // KAT 3: plain text unchanged
    let got3 = md_escape("plain")
    let exp3 = "plain"
    if got3 != exp3
        print("FAIL md_escape KAT3: got [" + got3 + "]")
        exit(1)

    // KAT 4: & is escaped before < (no double-escape)
    let got4 = md_escape("a&b<c")
    let exp4 = "a&amp;b&lt;c"
    if got4 != exp4
        print("FAIL md_escape KAT4: got [" + got4 + "]")
        exit(1)

    // KAT 5: empty string
    let got5 = md_escape("")
    if got5 != ""
        print("FAIL md_escape KAT5: got [" + got5 + "]")
        exit(1)

    // KAT 6: all four special chars together
    let got6 = md_escape("&<>" + chr(34))
    let exp6 = "&amp;&lt;&gt;&quot;"
    if got6 != exp6
        print("FAIL md_escape KAT6: got [" + got6 + "]")
        exit(1)

    print("PASS _md_escape_test")
