import std/tensor/tsr_index

// cki — check int equality.
fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckl — check two int lists element-by-element.
fn ckl(label, got, want)
    let ok = true
    if len(got) != len(want)
        ok = false
    if ok
        let i = 0
        while i < len(want)
            if got[i] != want[i]
                ok = false
            i = i + 1
    if not ok
        print("FAIL " + label + ": list mismatch")
        exit(1)

// ckt — check tensor flat and shape.
fn ckt(label, t, want_flat, want_shape)
    let flat = t[0]
    let shape = t[1]
    let ok = true
    if len(flat) != len(want_flat)
        ok = false
    if ok
        let i = 0
        while i < len(want_flat)
            if flat[i] != want_flat[i]
                ok = false
            i = i + 1
    if ok
        if len(shape) != len(want_shape)
            ok = false
    if ok
        let i = 0
        while i < len(want_shape)
            if shape[i] != want_shape[i]
                ok = false
            i = i + 1
    if not ok
        print("FAIL " + label + ": tensor mismatch")
        exit(1)

fn main()
    // ti_strides([2,3,4]) = [12,4,1]
    let sh1 = []
    push(sh1, 2)
    push(sh1, 3)
    push(sh1, 4)
    let st1 = ti_strides(sh1)
    let ws1 = []
    push(ws1, 12)
    push(ws1, 4)
    push(ws1, 1)
    ckl("strides_2x3x4", st1, ws1)

    // ti_strides([5]) = [1]
    let sh2 = []
    push(sh2, 5)
    let st2 = ti_strides(sh2)
    let ws2 = []
    push(ws2, 1)
    ckl("strides_5", st2, ws2)

    // ti_ravel([2,3],[1,2]) = 1*3 + 2*1 = 5
    let sh3 = []
    push(sh3, 2)
    push(sh3, 3)
    let idx3 = []
    push(idx3, 1)
    push(idx3, 2)
    cki("ravel_1_2", ti_ravel(sh3, idx3), 5)

    // ti_unravel([2,3],5) = [1,2]
    let sh4 = []
    push(sh4, 2)
    push(sh4, 3)
    let ur4 = ti_unravel(sh4, 5)
    let wu4 = []
    push(wu4, 1)
    push(wu4, 2)
    ckl("unravel_5", ur4, wu4)

    // ti_ravel([2,3],[0,0]) = 0
    let sh5 = []
    push(sh5, 2)
    push(sh5, 3)
    let idx5 = []
    push(idx5, 0)
    push(idx5, 0)
    cki("ravel_0_0", ti_ravel(sh5, idx5), 0)

    // ti_unravel([2,3,4],23) = [1,2,3]
    // strides=[12,4,1]; 23/12=1 rem11; 11/4=2 rem3; 3/1=3
    let sh6 = []
    push(sh6, 2)
    push(sh6, 3)
    push(sh6, 4)
    let ur6 = ti_unravel(sh6, 23)
    let wu6 = []
    push(wu6, 1)
    push(wu6, 2)
    push(wu6, 3)
    ckl("unravel_23", ur6, wu6)

    // ti_get: build [[1,2,3,4],[2,2]] inline, get [1,0] -> flat[1*2+0]=flat[2]=3
    let flat7 = []
    push(flat7, 1)
    push(flat7, 2)
    push(flat7, 3)
    push(flat7, 4)
    let shape7 = []
    push(shape7, 2)
    push(shape7, 2)
    let t7 = []
    push(t7, flat7)
    push(t7, shape7)
    let idx7 = []
    push(idx7, 1)
    push(idx7, 0)
    cki("get_1_0", ti_get(t7, idx7), 3)

    // ti_get [0,0] -> flat[0] = 1
    let idx7b = []
    push(idx7b, 0)
    push(idx7b, 0)
    cki("get_0_0", ti_get(t7, idx7b), 1)

    // ti_get [0,1] -> flat[1] = 2
    let idx7c = []
    push(idx7c, 0)
    push(idx7c, 1)
    cki("get_0_1", ti_get(t7, idx7c), 2)

    // ti_get [1,1] -> flat[3] = 4
    let idx7d = []
    push(idx7d, 1)
    push(idx7d, 1)
    cki("get_1_1", ti_get(t7, idx7d), 4)

    // ti_set: set [1,0] to 99, result has flat[2]=99, original unchanged
    let flat8 = []
    push(flat8, 1)
    push(flat8, 2)
    push(flat8, 3)
    push(flat8, 4)
    let shape8 = []
    push(shape8, 2)
    push(shape8, 2)
    let t8 = []
    push(t8, flat8)
    push(t8, shape8)
    let idx8 = []
    push(idx8, 1)
    push(idx8, 0)
    let t8b = ti_set(t8, idx8, 99)
    let f8b = t8b[0]
    cki("set_1_0_new", f8b[2], 99)
    // original flat8[2] unchanged = 3
    cki("set_1_0_orig", flat8[2], 3)

    // 1-D tensor: strides([3]) = [1]
    let sh9 = []
    push(sh9, 3)
    let st9 = ti_strides(sh9)
    cki("strides_1d_len", len(st9), 1)
    cki("strides_1d_0", st9[0], 1)

    // ravel 1-D: [3],[2] = 2
    let sh10 = []
    push(sh10, 3)
    let idx10 = []
    push(idx10, 2)
    cki("ravel_1d_2", ti_ravel(sh10, idx10), 2)

    // unravel 1-D: [3],2 = [2]
    let sh11 = []
    push(sh11, 3)
    let ur11 = ti_unravel(sh11, 2)
    cki("unravel_1d_2", ur11[0], 2)

    print("PASS _tsr_index_test")
