import forge_dice

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // parse
    let p1 = dice_parse("2d6+3")
    fails = fails + expect("parse1", str(p1[0]) + "," + str(p1[1]) + "," + str(p1[2]), "2,6,3")
    let p2 = dice_parse("d20")
    fails = fails + expect("parse2", str(p2[0]) + "," + str(p2[1]) + "," + str(p2[2]), "1,20,0")
    let p3 = dice_parse("3d8-2")
    fails = fails + expect("parse3", str(p3[0]) + "," + str(p3[1]) + "," + str(p3[2]), "3,8,-2")
    let p4 = dice_parse("1d20")
    fails = fails + expect("parse4", str(p4[0]) + "," + str(p4[1]) + "," + str(p4[2]), "1,20,0")

    // min / max / mean
    fails = fails + expect("min", str(dice_min("2d6+3")), "5")
    fails = fails + expect("max", str(dice_max("2d6+3")), "15")
    fails = fails + expect("mean_x2", str(dice_mean_x2("2d6+3")), "20")
    fails = fails + expect("min_d20", str(dice_min("1d20")), "1")
    fails = fails + expect("max_d20", str(dice_max("1d20")), "20")
    fails = fails + expect("max_4d6", str(dice_max("4d6")), "24")

    // d1 rolls are fully deterministic regardless of seed
    fails = fails + expect("d1_roll", str(dice_roll("2d1+3", 12345)), "5")
    fails = fails + expect("d1_roll2", str(dice_roll("1d1", 99)), "1")

    // roll determinism: same spec + seed -> same
    fails = fails + expect("det", str(dice_roll("3d6+1", 42) == dice_roll("3d6+1", 42)), "1")

    // roll always within [min, max]
    let inrange = 1
    let s = 1
    while s <= 50
        let r = dice_roll("2d6+3", s)
        if r < 5 or r > 15
            inrange = 0
        s = s + 1
    fails = fails + expect("range", str(inrange), "1")

    if fails == 0
        print("forge_dice: all passed")
    else
        print("forge_dice: " + str(fails) + " FAILED")
