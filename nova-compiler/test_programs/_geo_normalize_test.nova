import std/geo/geo_normalize

fn ckf(label, got, want, eps)
    let diff = got - want
    let adiff = diff
    if diff < 0.0
        adiff = 0.0 - diff
    if adiff > eps
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn ckb(label, got, want)
    if got != want
        let gs = "false"
        let ws = "false"
        if got
            gs = "true"
        if want
            ws = "true"
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn main()
    // gn_wrap_lon
    let w1 = gn_wrap_lon(200.0)
    ckf("wrap_lon(200)", w1, 0.0 - 160.0, 0.0001)

    let w2 = gn_wrap_lon(0.0 - 200.0)
    ckf("wrap_lon(-200)", w2, 160.0, 0.0001)

    let w3 = gn_wrap_lon(45.0)
    ckf("wrap_lon(45)", w3, 45.0, 0.0001)

    let w4 = gn_wrap_lon(0.0 - 180.0)
    ckf("wrap_lon(-180)", w4, 0.0 - 180.0, 0.0001)

    let w5 = gn_wrap_lon(180.0)
    // 180.0 wraps to -180.0 since range is [-180, 180)
    ckf("wrap_lon(180)", w5, 0.0 - 180.0, 0.0001)

    // gn_clamp_lat
    let c1 = gn_clamp_lat(100.0)
    ckf("clamp_lat(100)", c1, 90.0, 0.0001)

    let c2 = gn_clamp_lat(0.0 - 100.0)
    ckf("clamp_lat(-100)", c2, 0.0 - 90.0, 0.0001)

    let c3 = gn_clamp_lat(45.0)
    ckf("clamp_lat(45)", c3, 45.0, 0.0001)

    // gn_is_valid_lat
    ckb("valid_lat(45)", gn_is_valid_lat(45.0), true)
    ckb("valid_lat(91)", gn_is_valid_lat(91.0), false)
    ckb("valid_lat(-90)", gn_is_valid_lat(0.0 - 90.0), true)
    ckb("valid_lat(-91)", gn_is_valid_lat(0.0 - 91.0), false)

    // gn_is_valid_lon
    ckb("valid_lon(180)", gn_is_valid_lon(180.0), true)
    ckb("valid_lon(181)", gn_is_valid_lon(181.0), false)
    ckb("valid_lon(-180)", gn_is_valid_lon(0.0 - 180.0), true)

    // gn_is_valid
    ckb("is_valid(45,90)", gn_is_valid(45.0, 90.0), true)
    ckb("is_valid(91,90)", gn_is_valid(91.0, 90.0), false)

    // gn_normalize
    let n1 = gn_normalize(95.0, 200.0)
    let n1_lat = n1[0] * 1.0
    let n1_lon = n1[1] * 1.0
    ckf("normalize(95,200).lat", n1_lat, 90.0, 0.0001)
    ckf("normalize(95,200).lon", n1_lon, 0.0 - 160.0, 0.0001)

    // gn_round_coord
    let r1 = gn_round_coord(1.23456, 2)
    ckf("round_coord(1.23456,2)", r1, 1.23, 0.0001)

    let r2 = gn_round_coord(1.235, 2)
    ckf("round_coord(1.235,2)", r2, 1.24, 0.0001)

    let r3 = gn_round_coord(0.0 - 1.23456, 3)
    ckf("round_coord(-1.23456,3)", r3, 0.0 - 1.235, 0.0001)

    // gn_snap_to_grid (snap to nearest step)
    let s1 = gn_snap_to_grid(1.4, 2.6, 1.0)
    let s1_lat = s1[0] * 1.0
    let s1_lon = s1[1] * 1.0
    ckf("snap(1.4,2.6,1).lat", s1_lat, 1.0, 0.0001)
    ckf("snap(1.4,2.6,1).lon", s1_lon, 3.0, 0.0001)

    let s2 = gn_snap_to_grid(0.0 - 0.4, 0.6, 1.0)
    let s2_lat = s2[0] * 1.0
    let s2_lon = s2[1] * 1.0
    ckf("snap(-0.4,0.6,1).lat", s2_lat, 0.0, 0.0001)
    ckf("snap(-0.4,0.6,1).lon", s2_lon, 1.0, 0.0001)

    // gn_dedup_precision
    let dp1 = gn_dedup_precision(1.23456, 7.89012, 3)
    let dp1_lat = dp1[0] * 1.0
    let dp1_lon = dp1[1] * 1.0
    ckf("dedup(1.23456,7.89012,3).lat", dp1_lat, 1.235, 0.0001)
    ckf("dedup(1.23456,7.89012,3).lon", dp1_lon, 7.890, 0.0001)

    // gn_lat_direction
    cks("lat_dir(5)", gn_lat_direction(5.0), "N")
    cks("lat_dir(-5)", gn_lat_direction(0.0 - 5.0), "S")
    cks("lat_dir(0)", gn_lat_direction(0.0), "N")

    // gn_lon_direction
    cks("lon_dir(10)", gn_lon_direction(10.0), "E")
    cks("lon_dir(-10)", gn_lon_direction(0.0 - 10.0), "W")
    cks("lon_dir(0)", gn_lon_direction(0.0), "E")

    print("PASS _geo_normalize_test")
