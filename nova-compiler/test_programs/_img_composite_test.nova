// KAT for std/image/img_composite — grayscale image compositing.
import std/image/img_composite

// Helper: check a single-pixel list result
fn chk1(label: str, got: list, want: int)
    let n = len(got)
    if n != 1
        print("FAIL " + label + " length: got " + str(n) + " want 1")
        exit(1)
    let gv = got[0]
    if gv != want
        print("FAIL " + label + ": got " + str(gv) + " want " + str(want))
        exit(1)

// Helper: check two lists are equal
fn chk_list(label: str, got: list, want: list)
    let gn = len(got)
    let wn = len(want)
    if gn != wn
        print("FAIL " + label + " length: got " + str(gn) + " want " + str(wn))
        exit(1)
    let i = 0
    while i < wn
        let gv = got[i]
        let wv = want[i]
        if gv != wv
            print("FAIL " + label + "[" + str(i) + "]: got " + str(gv) + " want " + str(wv))
            exit(1)
        i = i + 1

fn main()
    // Build single-pixel lists for single-pixel KATs
    let a100 = []
    a100.push(100)
    let b200 = []
    b200.push(200)

    // KAT 1: img_blend([100],[200],50) == [150]
    // 100*(100-50)/100 + 200*50/100 = 100*50/100 + 200*50/100 = 50 + 100 = 150
    let blend50 = img_blend(a100, b200, 50)
    chk1("blend_50pct", blend50, 150)

    // KAT 2: img_blend([100],[200],0) == [100]  (pure a)
    let blend0 = img_blend(a100, b200, 0)
    chk1("blend_0pct", blend0, 100)

    // KAT 3: img_blend([100],[200],100) == [200]  (pure b)
    let blend100 = img_blend(a100, b200, 100)
    chk1("blend_100pct", blend100, 200)

    // KAT 4: img_add([200],[100]) == [255]  (clamped: 200+100=300 -> 255)
    let a200 = []
    a200.push(200)
    let b100 = []
    b100.push(100)
    let add1 = img_add(a200, b100)
    chk1("add_clamp", add1, 255)

    // KAT 5: img_add([100],[50]) == [150]  (no clamp)
    let a_100 = []
    a_100.push(100)
    let b_50 = []
    b_50.push(50)
    let add2 = img_add(a_100, b_50)
    chk1("add_no_clamp", add2, 150)

    // KAT 6: img_subtract([100],[150]) == [0]  (clamped: 100-150=-50 -> 0)
    let a_100b = []
    a_100b.push(100)
    let b_150 = []
    b_150.push(150)
    let sub1 = img_subtract(a_100b, b_150)
    chk1("subtract_clamp_zero", sub1, 0)

    // KAT 7: img_subtract([200],[50]) == [150]  (no clamp)
    let a_200 = []
    a_200.push(200)
    let b_50b = []
    b_50b.push(50)
    let sub2 = img_subtract(a_200, b_50b)
    chk1("subtract_no_clamp", sub2, 150)

    // KAT 8: img_max([100],[200]) == [200]
    let a_100c = []
    a_100c.push(100)
    let b_200 = []
    b_200.push(200)
    let max1 = img_max(a_100c, b_200)
    chk1("max_b_wins", max1, 200)

    // KAT 9: img_max([200],[100]) == [200]  (a wins)
    let a_200b = []
    a_200b.push(200)
    let b_100b = []
    b_100b.push(100)
    let max2 = img_max(a_200b, b_100b)
    chk1("max_a_wins", max2, 200)

    // KAT 10: multi-pixel blend test on 4-pixel image
    // a=[0,100,200,50], b=[100,100,100,100], alpha=50
    // 0*50/100+100*50/100=0+50=50
    // 100*50/100+100*50/100=50+50=100
    // 200*50/100+100*50/100=100+50=150
    // 50*50/100+100*50/100=25+50=75
    let am = []
    am.push(0)
    am.push(100)
    am.push(200)
    am.push(50)
    let bm = []
    bm.push(100)
    bm.push(100)
    bm.push(100)
    bm.push(100)
    let blendm = img_blend(am, bm, 50)
    let wantm = []
    wantm.push(50)
    wantm.push(100)
    wantm.push(150)
    wantm.push(75)
    chk_list("blend_multi_pixel", blendm, wantm)

    // KAT 11: img_subtract — all zeros when a==b
    let ax = []
    ax.push(128)
    ax.push(64)
    let bx = []
    bx.push(128)
    bx.push(64)
    let subx = img_subtract(ax, bx)
    let wantx = []
    wantx.push(0)
    wantx.push(0)
    chk_list("subtract_equal_zero", subx, wantx)

    // KAT 12: img_max elementwise
    let ap = []
    ap.push(50)
    ap.push(200)
    ap.push(100)
    let bp = []
    bp.push(100)
    bp.push(100)
    bp.push(150)
    let maxp = img_max(ap, bp)
    let wantp = []
    wantp.push(100)
    wantp.push(200)
    wantp.push(150)
    chk_list("max_elementwise", maxp, wantp)

    print("PASS _img_composite_test")
