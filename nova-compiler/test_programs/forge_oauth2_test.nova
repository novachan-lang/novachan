// forge_oauth2_test -- mw_oauth2 bearer resource-server validation (T3.7).
// Tests: 200 (valid token + correct aud + required scope present),
//        403 wrong audience, 403 missing scope, 401 no token, 401 bad token.
import forge
import forge_auth

fn whoami(req: Request) -> string
    let u = req.state["user"]
    u["sub"]

fn main()
    let secret = "oauth2-test-secret"

    // Build a token with aud="api", scope="read write", exp=far-future
    let claims = {}
    claims["sub"] = "user42"
    claims["aud"] = "api"
    claims["scope"] = "read write"
    claims["exp"] = 9999999999
    let tok = forge.jwt_encode(claims, secret)

    // ── 200: valid token, correct audience, required scope present ───────────────
    let a = forge.app()
    forge.use(a, forge_auth.mw_oauth2(secret, "api", "read"))
    forge.get(a, "/whoami", fn(req) whoami(req))

    let ok = forge.dispatch_test(a, forge.build_request("GET /whoami HTTP/1.1\r\nAuthorization: Bearer " + tok + "\r\n\r\n", 0))
    assert(forge.status_of(ok) == 200, "valid token + correct aud/scope -> 200 (got " + str(forge.status_of(ok)) + ")")
    assert(forge.body_of(ok) == "user42", "handler body should be sub=[" + forge.body_of(ok) + "]")
    print("PASS: mw_oauth2 -> 200 (aud=api scope=read)")

    // ── 403 wrong audience ────────────────────────────────────────────────────────
    let b = forge.app()
    forge.use(b, forge_auth.mw_oauth2(secret, "other-api", "read"))
    forge.get(b, "/whoami", fn(req) whoami(req))
    let wrong_aud = forge.dispatch_test(b, forge.build_request("GET /whoami HTTP/1.1\r\nAuthorization: Bearer " + tok + "\r\n\r\n", 0))
    assert(forge.status_of(wrong_aud) == 403, "wrong audience -> 403 (got " + str(forge.status_of(wrong_aud)) + ")")
    print("PASS: mw_oauth2 -> 403 (wrong audience)")

    // ── 403 missing scope ─────────────────────────────────────────────────────────
    let c = forge.app()
    forge.use(c, forge_auth.mw_oauth2(secret, "api", "delete"))
    forge.get(c, "/whoami", fn(req) whoami(req))
    let missing_scope = forge.dispatch_test(c, forge.build_request("GET /whoami HTTP/1.1\r\nAuthorization: Bearer " + tok + "\r\n\r\n", 0))
    assert(forge.status_of(missing_scope) == 403, "missing scope -> 403 (got " + str(forge.status_of(missing_scope)) + ")")
    print("PASS: mw_oauth2 -> 403 (missing scope 'delete')")

    // ── 401 no token ──────────────────────────────────────────────────────────────
    let d = forge.app()
    forge.use(d, forge_auth.mw_oauth2(secret, "api", "read"))
    forge.get(d, "/whoami", fn(req) whoami(req))
    let no_tok = forge.dispatch_test(d, forge.mock_request("GET", "/whoami", ""))
    assert(forge.status_of(no_tok) == 401, "no token -> 401 (got " + str(forge.status_of(no_tok)) + ")")
    print("PASS: mw_oauth2 -> 401 (no bearer token)")

    // ── 401 bad/invalid token ─────────────────────────────────────────────────────
    let e = forge.app()
    forge.use(e, forge_auth.mw_oauth2(secret, "api", "read"))
    forge.get(e, "/whoami", fn(req) whoami(req))
    let bad_tok = forge.dispatch_test(e, forge.build_request("GET /whoami HTTP/1.1\r\nAuthorization: Bearer not.a.valid.jwt\r\n\r\n", 0))
    assert(forge.status_of(bad_tok) == 401, "invalid token -> 401 (got " + str(forge.status_of(bad_tok)) + ")")
    print("PASS: mw_oauth2 -> 401 (bad token)")

    // ── aud as a list: token with aud=["api","other"] should match "api" ──────────
    let list_claims = {}
    list_claims["sub"] = "user99"
    let aud_list = []
    push(aud_list, "api")
    push(aud_list, "other")
    list_claims["aud"] = aud_list
    list_claims["scope"] = "read"
    list_claims["exp"] = 9999999999
    let list_tok = forge.jwt_encode(list_claims, secret)
    let f = forge.app()
    forge.use(f, forge_auth.mw_oauth2(secret, "api", "read"))
    forge.get(f, "/whoami", fn(req) whoami(req))
    let list_ok = forge.dispatch_test(f, forge.build_request("GET /whoami HTTP/1.1\r\nAuthorization: Bearer " + list_tok + "\r\n\r\n", 0))
    assert(forge.status_of(list_ok) == 200, "aud list containing 'api' -> 200 (got " + str(forge.status_of(list_ok)) + ")")
    print("PASS: mw_oauth2 -> 200 (aud as list)")

    print("forge_oauth2_test passed")
