fn main()
    let v = semver_parse("1.2.3")
    assert(v[0] == 1, "major")
    assert(v[1] == 2, "minor")
    assert(v[2] == 3, "patch")

    let v2 = semver_parse("2.0.0-alpha")
    assert(v2[0] == 2, "pre major")
    assert(v2[1] == 0, "pre minor")
    assert(v2[2] == 0, "pre patch")

    assert(semver_compare("1.0.0", "2.0.0") == -1, "1 < 2")
    assert(semver_compare("2.0.0", "1.0.0") == 1, "2 > 1")
    assert(semver_compare("1.0.0", "1.0.0") == 0, "equal")
    assert(semver_compare("1.2.0", "1.3.0") == -1, "minor compare")
    assert(semver_compare("1.2.3", "1.2.4") == -1, "patch compare")

    assert(semver_satisfies("1.2.3", "^1.0.0") == true, "caret match")
    assert(semver_satisfies("2.0.0", "^1.0.0") == false, "caret reject")
    assert(semver_satisfies("1.9.9", "^1.2.0") == true, "caret upper")
    assert(semver_satisfies("1.1.0", "^1.2.0") == false, "caret lower")

    assert(semver_satisfies("1.2.5", "~1.2.0") == true, "tilde match")
    assert(semver_satisfies("1.3.0", "~1.2.0") == false, "tilde reject")

    assert(semver_satisfies("1.2.3", "=1.2.3") == true, "exact match")
    assert(semver_satisfies("1.2.4", "=1.2.3") == false, "exact mismatch")

    assert(semver_satisfies("2.0.0", ">=1.5.0") == true, "gte satisfied")
    assert(semver_satisfies("1.4.0", ">=1.5.0") == false, "gte not satisfied")
    assert(semver_satisfies("1.0.0", "<=1.5.0") == true, "lte satisfied")
    assert(semver_satisfies("2.0.0", "<=1.5.0") == false, "lte not satisfied")

    let fmt = semver_format("1.2.3")
    assert(fmt == "1.2.3", "format roundtrip")

    print("All semver tests passed")
