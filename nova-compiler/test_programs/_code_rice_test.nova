// KAT test for std/compress/code_rice
// PRIMARY:   round-trip k in {0,1,2,4} for n in 0..100 + sequence round-trip
// SECONDARY: known bit-pattern vectors from the spec
import std/compress/code_rice

// ── Helpers ───────────────────────────────────────────────────────────────────

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(label, got, want)
    let ng = len(got)
    let nw = len(want)
    if ng != nw
        print("FAIL " + label + ": length got=" + str(ng) + " want=" + str(nw))
        exit(1)
    let i = 0
    while i < nw
        let _u = 0
        if got[i] != want[i]
            print("FAIL " + label + ": pos=" + str(i) + " got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

// ── KAT 1: Known bit-pattern vectors (k=2) ───────────────────────────────────
// rice_encode(0,2): q=0->unary=[0], r=0->rem=[0,0]  => [0,0,0]
let want_0_k2 = []
push(want_0_k2, 0)
push(want_0_k2, 0)
push(want_0_k2, 0)
ckl("enc_0_k2", rice_encode(0, 2), want_0_k2)

// rice_encode(1,2): q=0->unary=[0], r=1->rem=[0,1]  => [0,0,1]
let want_1_k2 = []
push(want_1_k2, 0)
push(want_1_k2, 0)
push(want_1_k2, 1)
ckl("enc_1_k2", rice_encode(1, 2), want_1_k2)

// rice_encode(5,2): q=1->unary=[1,0], r=1->rem=[0,1]  => [1,0,0,1]
let want_5_k2 = []
push(want_5_k2, 1)
push(want_5_k2, 0)
push(want_5_k2, 0)
push(want_5_k2, 1)
ckl("enc_5_k2", rice_encode(5, 2), want_5_k2)

// rice_encode(10,2): q=2->unary=[1,1,0], r=2->rem=[1,0]  => [1,1,0,1,0]
let want_10_k2 = []
push(want_10_k2, 1)
push(want_10_k2, 1)
push(want_10_k2, 0)
push(want_10_k2, 1)
push(want_10_k2, 0)
ckl("enc_10_k2", rice_encode(10, 2), want_10_k2)

// rice_encode(4,2): q=1->unary=[1,0], r=0->rem=[0,0]  => [1,0,0,0]
let want_4_k2 = []
push(want_4_k2, 1)
push(want_4_k2, 0)
push(want_4_k2, 0)
push(want_4_k2, 0)
ckl("enc_4_k2", rice_encode(4, 2), want_4_k2)

// ── KAT 2: Known bit-pattern vectors (k=0) ───────────────────────────────────
// k=0: no remainder bits — pure unary
// rice_encode(0,0): q=0->[0]  => [0]
let want_0_k0 = []
push(want_0_k0, 0)
ckl("enc_0_k0", rice_encode(0, 0), want_0_k0)

// rice_encode(3,0): q=3->[1,1,1,0]  => [1,1,1,0]
let want_3_k0 = []
push(want_3_k0, 1)
push(want_3_k0, 1)
push(want_3_k0, 1)
push(want_3_k0, 0)
ckl("enc_3_k0", rice_encode(3, 0), want_3_k0)

// ── KAT 3: Known bit-pattern vectors (k=1) ───────────────────────────────────
// rice_encode(0,1): q=0->[0], r=0->[0]  => [0,0]
let want_0_k1 = []
push(want_0_k1, 0)
push(want_0_k1, 0)
ckl("enc_0_k1", rice_encode(0, 1), want_0_k1)

// rice_encode(1,1): q=0->[0], r=1->[1]  => [0,1]
let want_1_k1 = []
push(want_1_k1, 0)
push(want_1_k1, 1)
ckl("enc_1_k1", rice_encode(1, 1), want_1_k1)

// rice_encode(3,1): q=1->[1,0], r=1->[1]  => [1,0,1]
let want_3_k1 = []
push(want_3_k1, 1)
push(want_3_k1, 0)
push(want_3_k1, 1)
ckl("enc_3_k1", rice_encode(3, 1), want_3_k1)

// ── KAT 4: Decode known vectors ──────────────────────────────────────────────
// Decode [0,0,0] with k=2 -> n=0, next_pos=3
let d_0_k2 = rice_decode(want_0_k2, 0, 2)
cki("dec_0_k2_val", d_0_k2[0], 0)
cki("dec_0_k2_pos", d_0_k2[1], 3)

// Decode [1,0,0,1] with k=2 -> n=5, next_pos=4
let d_5_k2 = rice_decode(want_5_k2, 0, 2)
cki("dec_5_k2_val", d_5_k2[0], 5)
cki("dec_5_k2_pos", d_5_k2[1], 4)

// Decode [1,1,0,1,0] with k=2 -> n=10, next_pos=5
let d_10_k2 = rice_decode(want_10_k2, 0, 2)
cki("dec_10_k2_val", d_10_k2[0], 10)
cki("dec_10_k2_pos", d_10_k2[1], 5)

// Decode [0] with k=0 -> n=0, next_pos=1
let d_0_k0 = rice_decode(want_0_k0, 0, 0)
cki("dec_0_k0_val", d_0_k0[0], 0)
cki("dec_0_k0_pos", d_0_k0[1], 1)

// Decode [1,1,1,0] with k=0 -> n=3, next_pos=4
let d_3_k0 = rice_decode(want_3_k0, 0, 0)
cki("dec_3_k0_val", d_3_k0[0], 3)
cki("dec_3_k0_pos", d_3_k0[1], 4)

// ── KAT 5: Code length invariant ─────────────────────────────────────────────
// For rice code with parameter k: code_length(n,k) = (n>>k) + 1 + k
let cl_n = 0
while cl_n <= 30
    let _u = 0
    let enc_len2 = len(rice_encode(cl_n, 2))
    let want_len2 = (cl_n >> 2) + 1 + 2
    if enc_len2 != want_len2
        print("FAIL codelen_k2 n=" + str(cl_n) + " got=" + str(enc_len2) + " want=" + str(want_len2))
        exit(1)
    let enc_len0 = len(rice_encode(cl_n, 0))
    let want_len0 = cl_n + 1
    if enc_len0 != want_len0
        print("FAIL codelen_k0 n=" + str(cl_n) + " got=" + str(enc_len0) + " want=" + str(want_len0))
        exit(1)
    cl_n = cl_n + 1

// ── KAT 6: PRIMARY round-trip k=0, n=0..30 ───────────────────────────────────
let rt0_n = 0
while rt0_n <= 30
    let _u = 0
    let enc0 = rice_encode(rt0_n, 0)
    let dec0 = rice_decode(enc0, 0, 0)
    if dec0[0] != rt0_n
        print("FAIL rt_k0 n=" + str(rt0_n) + " got=" + str(dec0[0]))
        exit(1)
    if dec0[1] != len(enc0)
        print("FAIL rt_k0_pos n=" + str(rt0_n) + " got=" + str(dec0[1]) + " want=" + str(len(enc0)))
        exit(1)
    rt0_n = rt0_n + 1

// ── KAT 7: PRIMARY round-trip k=1, n=0..100 ──────────────────────────────────
let rt1_n = 0
while rt1_n <= 100
    let _u = 0
    let enc1 = rice_encode(rt1_n, 1)
    let dec1 = rice_decode(enc1, 0, 1)
    if dec1[0] != rt1_n
        print("FAIL rt_k1 n=" + str(rt1_n) + " got=" + str(dec1[0]))
        exit(1)
    if dec1[1] != len(enc1)
        print("FAIL rt_k1_pos n=" + str(rt1_n) + " got=" + str(dec1[1]) + " want=" + str(len(enc1)))
        exit(1)
    rt1_n = rt1_n + 1

// ── KAT 8: PRIMARY round-trip k=2, n=0..100 ──────────────────────────────────
let rt2_n = 0
while rt2_n <= 100
    let _u = 0
    let enc2 = rice_encode(rt2_n, 2)
    let dec2 = rice_decode(enc2, 0, 2)
    if dec2[0] != rt2_n
        print("FAIL rt_k2 n=" + str(rt2_n) + " got=" + str(dec2[0]))
        exit(1)
    if dec2[1] != len(enc2)
        print("FAIL rt_k2_pos n=" + str(rt2_n) + " got=" + str(dec2[1]) + " want=" + str(len(enc2)))
        exit(1)
    rt2_n = rt2_n + 1

// ── KAT 9: PRIMARY round-trip k=4, n=0..100 ──────────────────────────────────
let rt4_n = 0
while rt4_n <= 100
    let _u = 0
    let enc4 = rice_encode(rt4_n, 4)
    let dec4 = rice_decode(enc4, 0, 4)
    if dec4[0] != rt4_n
        print("FAIL rt_k4 n=" + str(rt4_n) + " got=" + str(dec4[0]))
        exit(1)
    if dec4[1] != len(enc4)
        print("FAIL rt_k4_pos n=" + str(rt4_n) + " got=" + str(dec4[1]) + " want=" + str(len(enc4)))
        exit(1)
    rt4_n = rt4_n + 1

// ── KAT 10: Decode at non-zero position ──────────────────────────────────────
// Concatenate rice(5,k=2)=[1,0,0,1] ++ rice(10,k=2)=[1,1,0,1,0]
// Decode at pos=0 -> 5 (next=4); at pos=4 -> 10 (next=9)
let ctx_bits = []
push(ctx_bits, 1)
push(ctx_bits, 0)
push(ctx_bits, 0)
push(ctx_bits, 1)
push(ctx_bits, 1)
push(ctx_bits, 1)
push(ctx_bits, 0)
push(ctx_bits, 1)
push(ctx_bits, 0)
let ctx_d1 = rice_decode(ctx_bits, 0, 2)
cki("ctx_d1_val", ctx_d1[0], 5)
cki("ctx_d1_pos", ctx_d1[1], 4)
let ctx_d2 = rice_decode(ctx_bits, 4, 2)
cki("ctx_d2_val", ctx_d2[0], 10)
cki("ctx_d2_pos", ctx_d2[1], 9)

// ── KAT 11: PRIMARY sequence round-trip k=2 ──────────────────────────────────
// Encode 0..9, concatenate, decode sequentially
let seq_bits = []
let si = 0
while si < 10
    let _u = 0
    let enc_si = rice_encode(si, 2)
    let ej = 0
    let elen = len(enc_si)
    while ej < elen
        let _u2 = 0
        push(seq_bits, enc_si[ej])
        ej = ej + 1
    si = si + 1

let seq_pos = 0
let sv = 0
while sv < 10
    let _u = 0
    let dec_sv = rice_decode(seq_bits, seq_pos, 2)
    let got_sv = dec_sv[0]
    let nxt_sv = dec_sv[1]
    if got_sv != sv
        print("FAIL seq_rt val=" + str(sv) + " got=" + str(got_sv) + " at_pos=" + str(seq_pos))
        exit(1)
    seq_pos = nxt_sv
    sv = sv + 1

// Verify total consumed = sum of all code lengths
let total_bits = 0
let chk_v = 0
while chk_v < 10
    let _u = 0
    total_bits = total_bits + len(rice_encode(chk_v, 2))
    chk_v = chk_v + 1
cki("seq_rt_end_pos", seq_pos, total_bits)

// ── KAT 12: rice_encode_seq + rice_decode_seq ────────────────────────────────
let ns_seq = []
push(ns_seq, 0)
push(ns_seq, 5)
push(ns_seq, 10)
push(ns_seq, 15)
push(ns_seq, 100)
let bits_seq = rice_encode_seq(ns_seq, 2)
let dec_seq = rice_decode_seq(bits_seq, 0, 2, 5)
cki("seq_dec_0",   dec_seq[0], 0)
cki("seq_dec_5",   dec_seq[1], 5)
cki("seq_dec_10",  dec_seq[2], 10)
cki("seq_dec_15",  dec_seq[3], 15)
cki("seq_dec_100", dec_seq[4], 100)

// ── KAT 13: rice_encode_seq k=1 round-trip ───────────────────────────────────
let ns_k1 = []
push(ns_k1, 0)
push(ns_k1, 1)
push(ns_k1, 2)
push(ns_k1, 7)
push(ns_k1, 50)
let bits_k1 = rice_encode_seq(ns_k1, 1)
let dec_k1 = rice_decode_seq(bits_k1, 0, 1, 5)
cki("seq_k1_0",  dec_k1[0], 0)
cki("seq_k1_1",  dec_k1[1], 1)
cki("seq_k1_2",  dec_k1[2], 2)
cki("seq_k1_7",  dec_k1[3], 7)
cki("seq_k1_50", dec_k1[4], 50)

// ── KAT 14: pack_bits sanity ─────────────────────────────────────────────────
// pack_bits([1,0,1,1,0,0,1,0]) -> byte 10110010 = 178
let pb8 = []
push(pb8, 1)
push(pb8, 0)
push(pb8, 1)
push(pb8, 1)
push(pb8, 0)
push(pb8, 0)
push(pb8, 1)
push(pb8, 0)
let packed8 = pack_bits(pb8)
cki("pack8_len",  len(packed8), 1)
cki("pack8_byte", packed8[0],  178)

// pack_bits([1,0,1]) -> byte 10100000 = 160 (zero-padded)
let pb3 = []
push(pb3, 1)
push(pb3, 0)
push(pb3, 1)
let packed3 = pack_bits(pb3)
cki("pack3_len",  len(packed3), 1)
cki("pack3_byte", packed3[0],  160)

// ── KAT 15: Large value round-trip ───────────────────────────────────────────
let large_vals = []
push(large_vals, 200)
push(large_vals, 500)
push(large_vals, 1000)
push(large_vals, 9999)
let lv_i = 0
while lv_i < len(large_vals)
    let _u = 0
    let lv = large_vals[lv_i]
    let lv_enc2 = rice_encode(lv, 2)
    let lv_dec2 = rice_decode(lv_enc2, 0, 2)
    if lv_dec2[0] != lv
        print("FAIL large_rt_k2 n=" + str(lv) + " got=" + str(lv_dec2[0]))
        exit(1)
    let lv_enc4 = rice_encode(lv, 4)
    let lv_dec4 = rice_decode(lv_enc4, 0, 4)
    if lv_dec4[0] != lv
        print("FAIL large_rt_k4 n=" + str(lv) + " got=" + str(lv_dec4[0]))
        exit(1)
    lv_i = lv_i + 1

// ── KAT 16: Truncated stream returns -1 ──────────────────────────────────────
// rice(10,2)=[1,1,0,1,0] needs 5 bits; feed 3 bits -> truncated
let trunc_bits = []
push(trunc_bits, 1)
push(trunc_bits, 1)
push(trunc_bits, 0)
let trunc_d = rice_decode(trunc_bits, 0, 2)
cki("trunc_val", trunc_d[0], -1)

print("PASS _code_rice_test")
