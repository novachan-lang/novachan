// Forge S5 LiveView diff core: statics/dynamics model. Asserts (1) html assembly interleaves correctly,
// (2) a diff carries ONLY the changed slot (the LiveView bandwidth win), (3) apply round-trips on the
// client, (4) identical state -> empty patch (nothing on the wire). Pure, socketless, deterministic.
import forge_live

fn main()
    let statics = ["<p>Hello ", "! You have ", " messages</p>"]
    let d1 = ["alice", 3]

    // (1) full first render
    let html1 = live_html(statics, d1)
    if html1 != "<p>Hello alice! You have 3 messages</p>"
        print("FAIL: live_html assembly -> " + html1)
        exit(1)

    // (2) state change: only the count slot (index 1) changes 3 -> 5
    let d2 = ["alice", 5]
    let patch = live_diff(d1, d2)
    if patch_size(patch) != 1
        print("FAIL: exactly 1 slot should change, got " + str(patch_size(patch)))
        exit(1)
    let changed = patch["changed"]
    if changed[0]["i"] != 1 or str(changed[0]["val"]) != "5"
        print("FAIL: changed slot should be {i:1, val:5}")
        exit(1)

    // (3) the client applies the patch -> same document as a full re-render
    let d3 = live_apply(d1, patch)
    if live_html(statics, d3) != live_html(statics, d2)
        print("FAIL: apply round-trip mismatch")
        exit(1)

    // (4) no state change -> empty patch (zero bytes on the wire)
    if patch_size(live_diff(d2, d2)) != 0
        print("FAIL: identical dynamics must produce an empty patch")
        exit(1)

    // two slots change at once
    let d4 = ["bob", 9]
    if patch_size(live_diff(d2, d4)) != 2
        print("FAIL: both slots changed -> patch of 2")
        exit(1)

    print("PASS forge_live (statics/dynamics: assembly, diff = only-changed slots, apply round-trips, no-op empty)")
