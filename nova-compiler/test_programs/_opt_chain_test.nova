type Address
    city: string
    zip: string

type User
    name: string
    age: int

fn User.greet(self) -> string
    "Hello, " + self.name

fn find_user(id: int)
    if id == 1
        return some(User { name: "Alice", age: 30 })
    none()

fn find_address(id: int)
    if id == 1
        return some(Address { city: "NYC", zip: "10001" })
    none()

fn get_score(id: int)
    if id > 0
        return some(id * 10)
    none()

fn main()
    let u = find_user(1)
    let name = u?.name
    assert(is_some(name), "u?.name should be some")
    assert(unwrap(name) == "Alice", "u?.name == Alice")

    let greeting = u?.greet()
    assert(is_some(greeting), "u?.greet() should be some")
    assert(unwrap(greeting) == "Hello, Alice", "greeting")

    let nobody = find_user(99)
    let noname = nobody?.name
    assert(not is_some(noname), "nobody?.name should be none")

    let nogreet = nobody?.greet()
    assert(not is_some(nogreet), "nobody?.greet() should be none")

    let s1 = get_score(5) ?? 0
    assert(s1 == 50, "some(50) ?? 0 == 50")

    let s2 = get_score(-1) ?? 42
    assert(s2 == 42, "none ?? 42 == 42")

    let addr = find_address(1)
    let city = addr?.city ?? "unknown"
    assert(city == "NYC", "addr?.city ?? unknown == NYC")

    let no_addr = find_address(99)
    let city2 = no_addr?.city ?? "unknown"
    assert(city2 == "unknown", "none?.city ?? unknown == unknown")

    let age = find_user(1)?.age ?? -1
    assert(age == 30, "chained ?.age ?? -1 == 30")

    let age2 = find_user(99)?.age ?? -1
    assert(age2 == -1, "none?.age ?? -1 == -1")

    print("opt_chain_test: all passed")
