// WASM Stage 3: INTERACTIVITY -- a browser event (click) invokes a NOVA function.
// The handler is a NOVA top-level fn identified to the host by its EXPORT NAME (a string);
// JS addEventListener calls instance.exports["on_click"]() on the event. No fn pointers/closures.
extern fn dom_get_by_id(id: string) -> int
extern fn dom_create(tag: string) -> int
extern fn dom_set_text(node: int, txt: string)
extern fn dom_append(parent: int, child: int)
extern fn dom_on_click(node: int, handler_name: string)

// The click handler: append a <p>clicked</p> under #app on each invocation.
fn on_click()
    let app = unsafe dom_get_by_id("app")
    let p = unsafe dom_create("p")
    unsafe dom_set_text(p, "clicked")
    unsafe dom_append(app, p)

fn main()
    let app = unsafe dom_get_by_id("app")
    let btn = unsafe dom_create("button")
    unsafe dom_set_text(btn, "Click me")
    unsafe dom_append(app, btn)
    unsafe dom_on_click(btn, "on_click")
