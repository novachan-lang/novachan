import std/math/collatz

// cki — check integer known answer
fn cki(label: str, got: int, expected: int)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn main()
    // --- col_steps KATs ---
    // col_steps(1)=0: n=1 is already 1, no steps
    cki("col_steps(1)", col_steps(1), 0)

    // col_steps(2)=1: 2->1 (1 step)
    cki("col_steps(2)", col_steps(2), 1)

    // col_steps(6)=8: 6->3->10->5->16->8->4->2->1 (8 steps)
    // Hand-trace: 6(even)->3, 3(odd)->10, 10(even)->5, 5(odd)->16,
    //             16(even)->8, 8(even)->4, 4(even)->2, 2(even)->1  = 8 steps
    cki("col_steps(6)", col_steps(6), 8)

    // col_steps(27)=111: well-known published value
    cki("col_steps(27)", col_steps(27), 111)

    // col_steps(4)=2: 4->2->1 (2 steps)
    cki("col_steps(4)", col_steps(4), 2)

    // col_steps(16)=4: 16->8->4->2->1 (4 steps)
    cki("col_steps(16)", col_steps(16), 4)

    // --- col_seq KATs ---
    // col_seq(6)=[6,3,10,5,16,8,4,2,1] — 9 elements
    let s6 = col_seq(6)
    cki("col_seq(6) len", len(s6), 9)
    cki("col_seq(6)[0]", s6[0], 6)
    cki("col_seq(6)[1]", s6[1], 3)
    cki("col_seq(6)[2]", s6[2], 10)
    cki("col_seq(6)[3]", s6[3], 5)
    cki("col_seq(6)[4]", s6[4], 16)
    cki("col_seq(6)[5]", s6[5], 8)
    cki("col_seq(6)[6]", s6[6], 4)
    cki("col_seq(6)[7]", s6[7], 2)
    cki("col_seq(6)[8]", s6[8], 1)

    // col_seq(1)=[1] — degenerate base case
    let s1 = col_seq(1)
    cki("col_seq(1) len", len(s1), 1)
    cki("col_seq(1)[0]", s1[0], 1)

    // col_seq(2)=[2,1] — minimal two-element sequence
    let s2 = col_seq(2)
    cki("col_seq(2) len", len(s2), 2)
    cki("col_seq(2)[0]", s2[0], 2)
    cki("col_seq(2)[1]", s2[1], 1)

    // seq length for n=27 is steps+1 = 112
    let s27 = col_seq(27)
    cki("col_seq(27) len", len(s27), 112)
    cki("col_seq(27)[0]", s27[0], 27)
    cki("col_seq(27) last", s27[111], 1)

    // --- col_max KATs ---
    // col_max(1)=1
    cki("col_max(1)", col_max(1), 1)

    // col_max(6)=16: peak in [6,3,10,5,16,8,4,2,1] is 16
    cki("col_max(6)", col_max(6), 16)

    // col_max(27)=9232: well-known published peak
    cki("col_max(27)", col_max(27), 9232)

    // col_max(4)=4: 4->2->1, peak is 4 itself
    cki("col_max(4)", col_max(4), 4)

    // col_max(3)=16: 3->10->5->16->8->4->2->1, peak=16
    cki("col_max(3)", col_max(3), 16)

    // --- col_steps_upto KATs ---
    // col_steps_upto(0) = []
    let u0 = col_steps_upto(0)
    cki("col_steps_upto(0) len", len(u0), 0)

    // col_steps_upto(6) = [0,1,7,2,5,8]
    // steps: k=1->0, k=2->1, k=3->7, k=4->2, k=5->5, k=6->8
    // Hand-trace k=3: 3->10->5->16->8->4->2->1 = 7 steps
    // Hand-trace k=5: 5->16->8->4->2->1 = 5 steps
    let u6 = col_steps_upto(6)
    cki("col_steps_upto(6) len", len(u6), 6)
    cki("col_steps_upto(6)[0]", u6[0], 0)
    cki("col_steps_upto(6)[1]", u6[1], 1)
    cki("col_steps_upto(6)[2]", u6[2], 7)
    cki("col_steps_upto(6)[3]", u6[3], 2)
    cki("col_steps_upto(6)[4]", u6[4], 5)
    cki("col_steps_upto(6)[5]", u6[5], 8)

    // col_steps_upto(1) = [0]
    let u1 = col_steps_upto(1)
    cki("col_steps_upto(1) len", len(u1), 1)
    cki("col_steps_upto(1)[0]", u1[0], 0)

    print("_collatz_test passed")
