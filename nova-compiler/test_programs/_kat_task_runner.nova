import forge_task_runner

fn main()
    let r = tr_new()
    r = tr_add_task(r, "compile", [])
    r = tr_add_task(r, "test", ["compile"])
    r = tr_add_task(r, "lint", [])
    r = tr_add_task(r, "deploy", ["test", "lint"])

    assert(tr_task_count(r) == 4, "4 tasks")

    let ready1 = tr_ready_tasks(r)
    assert(len(ready1) >= 2, "compile+lint ready (no deps)")

    assert(tr_is_ready(r, "compile") == true, "compile ready")
    assert(tr_is_ready(r, "test") == false, "test not ready")
    assert(tr_is_ready(r, "deploy") == false, "deploy not ready")

    r = tr_run(r, "compile")
    assert(tr_status(r, "compile") == "running", "compile running")

    r = tr_complete(r, "compile")
    assert(tr_status(r, "compile") == "done", "compile done")
    assert(tr_is_ready(r, "test") == true, "test now ready")

    r = tr_complete(r, "lint")
    r = tr_complete(r, "test")
    assert(tr_is_ready(r, "deploy") == true, "deploy ready")

    r = tr_complete(r, "deploy")
    assert(tr_all_done(r) == true, "all done")

    let order = tr_execution_order(r)
    assert(len(order) == 4, "4 in execution order")
    assert(order[0] == "compile", "compile first")

    assert(tr_status(r, "unknown") == "unknown", "unknown task")

    print("TASK-RUNNER KAT PASS")
