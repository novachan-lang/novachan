import forge_liveness_probe

fn main()
    let p = lp_new("api-server")
    assert(lp_name(p) == "api-server", "name")
    assert(lp_is_live(p) == 1, "starts live")
    assert(lp_is_ready(p) == 0, "starts not ready")

    p = lp_set_ready(p, 1)
    assert(lp_is_ready(p) == 1, "now ready")

    let r1 = lp_check(p)
    p = r1["p"]
    assert(r1["live"] == 1, "check live")
    assert(r1["ready"] == 1, "check ready")
    assert(lp_check_count(p) == 1, "1 check")

    p = lp_fail(p)
    p = lp_fail(p)
    assert(lp_is_live(p) == 1, "2 fails still live")
    assert(lp_fail_count(p) == 2, "2 fails")

    p = lp_fail(p)
    assert(lp_is_live(p) == 0, "3 consecutive = dead")

    p = lp_succeed(p)
    assert(lp_is_live(p) == 1, "success = live again")

    p = lp_set_threshold(p, 2)
    p = lp_fail(p)
    assert(lp_is_live(p) == 1, "1 fail with threshold 2")
    p = lp_fail(p)
    assert(lp_is_live(p) == 0, "2 fails with threshold 2 = dead")

    print("LIVENESS-PROBE KAT PASS")
