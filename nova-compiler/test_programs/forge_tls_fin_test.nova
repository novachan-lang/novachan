// Forge TLS 1.3 end-to-end Finished verification: from the real RFC 8448 §3 ClientHello + ServerHello +
// encrypted server flight, compute the running transcript, derive the server handshake secret, and verify
// the server's actual Finished message. This validates the heart of TLS 1.3 handshake authentication.
import forge_tls
import forge_crypto

fn main()
    let ecdhe = hex_to_blist("8bd4054fb55b9d63fdfbacf9f04b9f0d35e6d63f537563efd46272900f89492d")
    let th_ch_sh = hex_to_blist("860c06edc07858ee8e78f0e7428c58edd6b43f2ca3e6e95f02ed063cf0e1cad8")
    let ch = hex_to_blist("")
    let sh = hex_to_blist("020000560303a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e2692800130100002e00330024001d0020c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f002b00020304")
    let key = hex_to_blist("3fce516009c21727d0f2e4e86ee403bc")
    let iv = hex_to_blist("5d313eb2671276ee13000b30")
    let rec = hex_to_blist("")

    let opened = tls13_record_open(key, iv, 0, rec)
    let content = opened[1]
    let m1 = tls13_hs_header(content, 0)
    let m2 = tls13_hs_header(content, m1[3])
    let m3 = tls13_hs_header(content, m2[3])
    let m4 = tls13_hs_header(content, m3[3])

    // running transcript through server CertificateVerify = CH || SH || EE || Cert || CertVerify
    let ctx = []
    let a = 0
    while a < len(ch)
        push(ctx, ch[a])
        a = a + 1
    let b = 0
    while b < len(sh)
        push(ctx, sh[b])
        b = b + 1
    let c = 0
    while c < m3[3]
        push(ctx, content[c])
        c = c + 1
    let th = tls13_transcript_hash(ctx)
    if hex_of(th) != "edb7725fa7a3473b031ec8ef65a2485493900138a2b91291407d7951a06110ed"
        print("FAIL: running transcript -> " + hex_of(th))
        exit(1)

    let hs = tls13_handshake_secret(ecdhe)
    let s_hs = tls13_derive_secret(hs, "s hs traffic", th_ch_sh)

    // the verify_data the server actually sent, taken from its Finished message body
    let recv = []
    let m = m4[2]
    while m < m4[3]
        push(recv, content[m])
        m = m + 1
    if hex_of(recv) != "9b9b141d906337fbd2cbdce71df4deda4ab42c309572cb7fffee5454b78f0718"
        print("FAIL: wire verify_data -> " + hex_of(recv))
        exit(1)
    if tls13_verify_server_finished(s_hs, th, recv) != 1
        print("FAIL: server Finished did not verify")
        exit(1)

    // tamper: a flipped verify_data byte must be rejected
    recv[0] = recv[0] ^ 1
    if tls13_verify_server_finished(s_hs, th, recv) != 0
        print("FAIL: tampered Finished not rejected")
        exit(1)

    print("PASS forge_tls_fin (RFC 8448 running transcript + end-to-end server Finished verify + tamper)")
