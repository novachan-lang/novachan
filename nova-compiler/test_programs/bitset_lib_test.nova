import bitset

fn main()
    // bs_nwords = ceil(nbits/64).
    assert(bitset.bs_nwords(0) == 0, "0 bits need 0 words")
    assert(bitset.bs_nwords(64) == 1, "64 bits fit in 1 word")
    assert(bitset.bs_nwords(65) == 2, "65 bits need 2 words")

    // bitset_new(100): [nbits, word0, word1], all clear.
    let a = bitset.bitset_new(100)
    assert(bitset.bs_nbits(a) == 100, "nbits is stored")
    assert(len(a) == 3, "100 bits = nbits + 2 words")
    assert(bitset.bs_count(a) == 0, "fresh bitset has no set bits")

    // bs_set is immutable and cross-word (bit 5 in word0, bit 70 in word1).
    let b = bitset.bs_set(a, 5)
    let c = bitset.bs_set(b, 70)
    assert(bitset.bs_count(a) == 0, "original bitset untouched (immutable)")
    assert(bitset.bs_test(c, 5) == 1, "bit 5 is set")
    assert(bitset.bs_test(c, 70) == 1, "bit 70 is set")
    assert(bitset.bs_test(c, 6) == 0, "an unset bit reads 0")
    assert(bitset.bs_count(c) == 2, "two bits set")

    // bs_clear removes a bit.
    let d = bitset.bs_clear(c, 5)
    assert(bitset.bs_test(d, 5) == 0, "bit 5 cleared")
    assert(bitset.bs_test(d, 70) == 1, "bit 70 still set")
    assert(bitset.bs_count(d) == 1, "one bit remains after clear")

    // union and intersection: setX={1,5,70}, setY={5,70,99}.
    let setX = bitset.bs_set(bitset.bs_set(bitset.bs_set(bitset.bitset_new(100), 1), 5), 70)
    let setY = bitset.bs_set(bitset.bs_set(bitset.bs_set(bitset.bitset_new(100), 5), 70), 99)
    let un = bitset.bs_union(setX, setY)
    assert(bitset.bs_count(un) == 4, "union 1,5,70,99 has 4 bits")
    let inx = bitset.bs_intersect(setX, setY)
    assert(bitset.bs_count(inx) == 2, "intersection 5,70 has 2 bits")
    assert(bitset.bs_test(inx, 1) == 0, "bit only in X is absent from intersection")

    print("bitset_lib_test passed")
