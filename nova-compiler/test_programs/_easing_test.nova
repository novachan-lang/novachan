// KAT for std/math/easing — all 8 easing functions (epsilon=0.001).
import std/math/easing

fn ckf(label: string, got: float, want: float)
    let d = got - want
    if d < 0.0
        d = 0.0 - d
    if d > 0.001
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ease_linear: identity
    ckf("linear_0",   ease_linear(0.0), 0.0)
    ckf("linear_1",   ease_linear(1.0), 1.0)
    ckf("linear_0.3", ease_linear(0.3), 0.3)

    // ease_in_quad: t*t
    ckf("in_quad_0",   ease_in_quad(0.0), 0.0)
    ckf("in_quad_1",   ease_in_quad(1.0), 1.0)
    ckf("in_quad_0.5", ease_in_quad(0.5), 0.25)

    // ease_out_quad: t*(2-t)
    ckf("out_quad_0",   ease_out_quad(0.0), 0.0)
    ckf("out_quad_1",   ease_out_quad(1.0), 1.0)
    ckf("out_quad_0.5", ease_out_quad(0.5), 0.75)

    // ease_in_out_quad: symmetric; midpoint must be 0.5
    ckf("in_out_quad_0",   ease_in_out_quad(0.0), 0.0)
    ckf("in_out_quad_1",   ease_in_out_quad(1.0), 1.0)
    ckf("in_out_quad_0.5", ease_in_out_quad(0.5), 0.5)

    // ease_in_cubic: t^3
    ckf("in_cubic_0",   ease_in_cubic(0.0), 0.0)
    ckf("in_cubic_1",   ease_in_cubic(1.0), 1.0)
    ckf("in_cubic_0.5", ease_in_cubic(0.5), 0.125)

    // ease_out_cubic: (t-1)^3+1
    ckf("out_cubic_0",   ease_out_cubic(0.0), 0.0)
    ckf("out_cubic_1",   ease_out_cubic(1.0), 1.0)
    ckf("out_cubic_0.5", ease_out_cubic(0.5), 0.875)

    // ease_in_out_cubic: midpoint = 0.5
    ckf("in_out_cubic_0",   ease_in_out_cubic(0.0), 0.0)
    ckf("in_out_cubic_1",   ease_in_out_cubic(1.0), 1.0)
    ckf("in_out_cubic_0.5", ease_in_out_cubic(0.5), 0.5)

    // ease_in_sine: 1-cos(t*PI/2)
    ckf("in_sine_0",   ease_in_sine(0.0), 0.0)
    ckf("in_sine_1",   ease_in_sine(1.0), 1.0)

    // ease_out_sine: sin(t*PI/2)
    ckf("out_sine_0",  ease_out_sine(0.0), 0.0)
    ckf("out_sine_1",  ease_out_sine(1.0), 1.0)

    print("_easing_test passed")
