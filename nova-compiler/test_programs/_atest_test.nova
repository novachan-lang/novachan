// L1 Phase-1: @test declarative test discovery. The compiler collects @test fns and generates
// __nova_run_tests() which calls each, tallies passes, prints "P/N tests passed", returns pass count.
@test
fn t_add() -> bool
    1 + 1 == 2

@test
fn t_concat() -> bool
    "a" + "b" == "ab"

@test
fn t_fails_on_purpose() -> bool
    false

fn main()
    let passed = __nova_run_tests()
    // 2 of the 3 @test fns pass (t_fails_on_purpose returns false)
    if passed != 2
        print("FAIL _atest_test: expected 2 passed, got " + str(passed))
        exit(1)
    print("PASS _atest_test")
