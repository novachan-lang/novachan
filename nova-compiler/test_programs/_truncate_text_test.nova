import std/textlayout/truncate_text

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // tt_truncate: basic — 'hello world' (11) to width 8 -> 'hello...' (8)
    cks("trunc_basic", tt_truncate("hello world", 8), "hello...")
    // tt_truncate: short string unchanged
    cks("trunc_short", tt_truncate("hi", 8), "hi")
    // tt_truncate: exact length unchanged
    cks("trunc_exact", tt_truncate("abcdefgh", 8), "abcdefgh")
    // tt_truncate: one over width
    cks("trunc_one_over", tt_truncate("abcdefghi", 8), "abcde...")
    // tt_truncate: very small width (<=3) -> first width chars of "..."
    cks("trunc_w3", tt_truncate("hello", 3), "...")
    cks("trunc_w2", tt_truncate("hello", 2), "..")
    cks("trunc_w1", tt_truncate("hello", 1), ".")

    // tt_shorten: same as tt_truncate
    cks("shorten", tt_shorten("hello world", 8), "hello...")

    // tt_cut: hard cut, no ellipsis
    cks("cut_basic", tt_cut("hello world", 5), "hello")
    cks("cut_short", tt_cut("hi", 5), "hi")
    cks("cut_exact", tt_cut("hello", 5), "hello")

    // tt_ellipsis_middle: 'abcdefghij' (10) to width 7
    // head=(7-3)/2=2, tail=7-3-2=2, tail_start=10-2=8 -> 'ab...ij'
    cks("middle_basic", tt_ellipsis_middle("abcdefghij", 7), "ab...ij")
    // tt_ellipsis_middle: short string unchanged
    cks("middle_short", tt_ellipsis_middle("hi", 8), "hi")
    // tt_ellipsis_middle: width=6, head=(6-3)/2=1, tail=6-3-1=2 -> 'a...ij'
    cks("middle_w6", tt_ellipsis_middle("abcdefghij", 6), "a...ij")
    // tt_ellipsis_middle: width=9, head=(9-3)/2=3, tail=9-3-3=3 -> 'abc...hij'
    cks("middle_w9", tt_ellipsis_middle("abcdefghij", 9), "abc...hij")

    // tt_needs_truncate
    ckb("needs_yes", tt_needs_truncate("hello world", 8), true)
    ckb("needs_no", tt_needs_truncate("hi", 8), false)
    ckb("needs_exact", tt_needs_truncate("hello", 5), false)

    // tt_visible_len
    cki("vlen_basic", tt_visible_len("hello"), 5)
    cki("vlen_empty", tt_visible_len(""), 0)

    // tt_truncate_word: 'the quick brown' (15) at width=11
    // budget=8; "the"=3<=8 fits; "the quick"=9>8 stops; -> "the..."
    cks("tword_basic", tt_truncate_word("the quick brown", 11), "the...")
    // tt_truncate_word: string fits within width -> unchanged (no ellipsis)
    cks("tword_fits", tt_truncate_word("hello", 10), "hello")
    // tt_truncate_word: width=7, budget=4; "the"=3<=4; "the qu"... "the quick"=9>4; -> "the..."
    cks("tword_w7", tt_truncate_word("the quick", 7), "the...")
    // tt_truncate_word: first word exceeds budget -> hard cut to budget + "..."
    // budget=2; "the"=3>2; hard cut "the"[0:2]="th" -> "th..."
    cks("tword_hardcut", tt_truncate_word("the quick", 5), "th...")
    // tt_truncate_word: width<=3 -> first width chars of "..."
    cks("tword_w3", tt_truncate_word("hello world", 3), "...")
    cks("tword_w2", tt_truncate_word("hello world", 2), "..")

    print("PASS _truncate_text_test")
