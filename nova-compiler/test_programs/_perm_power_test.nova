import std/permutation/perm_power

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got " + gs + " want " + ws)
        exit(1)

fn ckl(label: string, got, want)
    let ng = len(got)
    let nw = len(want)
    if ng != nw
        print("FAIL " + label + ": length " + str(ng) + " want " + str(nw))
        exit(1)
    let i = 0
    while i < ng
        if got[i] != want[i]
            print("FAIL " + label + "[" + str(i) + "]: got " + str(got[i]) + " want " + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // ppw_power([1,2,0], 2) = [2,0,1]   (3-cycle applied twice)
    let p3 = [1, 2, 0]
    let w0 = [2, 0, 1]
    let r0 = ppw_power(p3, 2)
    ckl("power(3cyc,2)", r0, w0)

    // ppw_power([1,2,0], 3) = [0,1,2]   (order 3, back to identity)
    let w1 = [0, 1, 2]
    let r1 = ppw_power(p3, 3)
    ckl("power(3cyc,3)", r1, w1)

    // ppw_power([1,2,0], 0) = [0,1,2]   (k==0 always identity)
    let r2 = ppw_power(p3, 0)
    ckl("power(3cyc,0)", r2, w1)

    // ppw_power([1,2,0], -1) = [2,0,1]  (inverse of (0 1 2) is (0 2 1))
    let winv = [2, 0, 1]
    let r3 = ppw_power(p3, -1)
    ckl("power(3cyc,-1)", r3, winv)

    // ppw_power([1,0,2], 2) = [0,1,2]   (transposition squared = identity)
    let p2 = [1, 0, 2]
    let r4 = ppw_power(p2, 2)
    ckl("power(transpos,2)", r4, w1)

    // ppw_power([1,2,3,0], 2) = [2,3,0,1]
    let p4 = [1, 2, 3, 0]
    let w4 = [2, 3, 0, 1]
    let r5 = ppw_power(p4, 2)
    ckl("power(4cyc,2)", r5, w4)

    // ppw_is_identity_power: 3-cycle has order 3
    ckb("is_id_power(3cyc,3)", ppw_is_identity_power(p3, 3), true)
    ckb("is_id_power(3cyc,2)", ppw_is_identity_power(p3, 2), false)
    ckb("is_id_power(transpos,2)", ppw_is_identity_power(p2, 2), true)

    // ppw_sqrt_exists:
    // [0,1,2] = identity: sqrt exists (identity itself)
    let pid = [0, 1, 2]
    ckb("sqrt_exists(identity)", ppw_sqrt_exists(pid), true)
    // [1,2,0] = single 3-cycle: odd length, always has sqrt
    ckb("sqrt_exists(3cyc)", ppw_sqrt_exists(p3), true)
    // [1,0,3,2] = two disjoint 2-cycles: two even cycles, count=2 (even) -> sqrt exists
    let p22 = [1, 0, 3, 2]
    ckb("sqrt_exists(two-2cyc)", ppw_sqrt_exists(p22), true)
    // [1,0,2,3] = single 2-cycle + two fixed: one even cycle (count=1, odd) -> no sqrt
    let p1t = [1, 0, 2, 3]
    ckb("sqrt_exists(one-2cyc)", ppw_sqrt_exists(p1t), false)

    print("PASS _perm_power_test")
