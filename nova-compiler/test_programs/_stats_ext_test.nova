import std/math/stats_ext

fn ckf(label: str, got: float, want: float)
    let diff = got - want
    let adiff = diff
    if adiff < 0.0
        adiff = 0.0 - adiff
    if adiff > 0.001
        print("FAIL " + label + " got=" + str(got) + " want=" + str(want))
        exit(1)

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL " + label + " got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // KAT 1: se_mode — most frequent element; 2 appears 3 times
    let mode_xs = [1, 2, 2, 3, 2]
    let mode_result = se_mode(mode_xs)
    cki("se_mode([1,2,2,3,2])", mode_result, 2)

    // KAT 2: se_range — max(5)-min(1) = 4.0
    let range_xs = [1, 5, 3]
    let range_result = se_range(range_xs)
    ckf("se_range([1,5,3])", range_result, 4.0)

    // KAT 3: se_variance_sample — n=8, mean=5.0, sum_sq_dev=32, /7 = 4.571428...
    // [2,4,4,4,5,5,7,9]: sum=40, mean=5.0
    // deviations: -3,-1,-1,-1,0,0,2,4
    // squared:     9, 1, 1, 1,0,0,4,16 = 32
    // /7 = 4.571428...
    let var_xs = [2, 4, 4, 4, 5, 5, 7, 9]
    let var_result = se_variance_sample(var_xs)
    ckf("se_variance_sample", var_result, 4.571)

    // KAT 4: se_stddev_sample — sqrt(4.571428) = 2.1380...
    let sd_result = se_stddev_sample(var_xs)
    ckf("se_stddev_sample", sd_result, 2.138)

    // KAT 5: se_covariance (population) of [1,2,3,4] and [2,4,6,8]
    // mux=2.5, muy=5.0
    // dx: -1.5,-0.5,0.5,1.5  dy: -3,-1,1,3
    // products: 4.5, 0.5, 0.5, 4.5 sum=10.0 /4 = 2.5
    let cov_xs = [1, 2, 3, 4]
    let cov_ys = [2, 4, 6, 8]
    let cov_result = se_covariance(cov_xs, cov_ys)
    ckf("se_covariance([1,2,3,4],[2,4,6,8])", cov_result, 2.5)

    // KAT 6: se_correlation([1,2,3,4],[2,4,6,8]) = 1.0 (perfect positive)
    let corr_pos = se_correlation(cov_xs, cov_ys)
    ckf("se_correlation positive", corr_pos, 1.0)

    // KAT 7: se_correlation([1,2,3],[3,2,1]) = -1.0 (perfect negative)
    let inv_xs = [1, 2, 3]
    let inv_ys = [3, 2, 1]
    let corr_neg = se_correlation(inv_xs, inv_ys)
    ckf("se_correlation negative", corr_neg, -1.0)

    // KAT 8: se_zscore(6.0, 5.0, 2.0) = (6-5)/2 = 0.5
    let z = se_zscore(6.0, 5.0, 2.0)
    ckf("se_zscore(6.0,5.0,2.0)", z, 0.5)

    // KAT 9: se_iqr([1,2,3,4,5,6,7,8])
    // sorted: [1,2,3,4,5,6,7,8], n=8
    // Q1 (p=25): rank = 0.25*7 = 1.75; lo=1, hi=2; 2+0.75*(3-2) = 2.75
    // Q3 (p=75): rank = 0.75*7 = 5.25; lo=5, hi=6; 6+0.25*(7-6) = 6.25
    // IQR = 6.25 - 2.75 = 3.5
    let iqr_xs = [1, 2, 3, 4, 5, 6, 7, 8]
    let iqr_result = se_iqr(iqr_xs)
    ckf("se_iqr([1..8])", iqr_result, 3.5)

    // KAT 10: se_mode tie-breaking — first-encountered winner
    // [3,3,7,7,1]: 3 appears at index 0, 7 at index 2; 3 should win (first found)
    let tie_xs = [3, 3, 7, 7, 1]
    let tie_mode = se_mode(tie_xs)
    cki("se_mode tie", tie_mode, 3)

    // KAT 11: edge — single-element range = 0.0
    let single = [42]
    let single_range = se_range(single)
    ckf("se_range single", single_range, 0.0)

    // KAT 12: se_zscore with zero stddev returns 0.0 (no crash)
    let z0 = se_zscore(5.0, 5.0, 0.0)
    ckf("se_zscore zero_stddev", z0, 0.0)

    print("_stats_ext_test passed")
