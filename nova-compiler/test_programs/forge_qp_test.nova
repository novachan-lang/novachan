import forge_qp

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // plain ASCII passes through
    fails = fails + expect("enc_plain", qp_encode("Hello World"), "Hello World")
    // equals sign escaped
    fails = fails + expect("enc_eq", qp_encode("a=b"), "a=3Db")
    // Latin-1 accented byte (é = 0xE9)
    fails = fails + expect("enc_cafe", qp_encode("caf" + chr(233)), "caf=E9")
    // control byte (newline 0x0A)
    fails = fails + expect("enc_nl", qp_encode("a" + chr(10) + "b"), "a=0Ab")
    // high byte 0xFF
    fails = fails + expect("enc_ff", qp_encode(chr(255)), "=FF")
    // space/tab pass through
    fails = fails + expect("enc_ws", qp_encode("a b" + chr(9) + "c"), "a b" + chr(9) + "c")

    // decode
    fails = fails + expect("dec_eq", qp_decode("a=3Db"), "a=b")
    fails = fails + expect("dec_cafe", qp_decode("caf=E9"), "caf" + chr(233))
    fails = fails + expect("dec_lower", qp_decode("caf=e9"), "caf" + chr(233))
    fails = fails + expect("dec_ff", qp_decode("=FF"), chr(255))
    // soft line breaks
    fails = fails + expect("dec_soft_n", qp_decode("Hello=" + chr(10) + "World"), "HelloWorld")
    fails = fails + expect("dec_soft_rn", qp_decode("Hello=" + chr(13) + chr(10) + "World"), "HelloWorld")
    // malformed = kept literal
    fails = fails + expect("dec_malformed", qp_decode("a=zz"), "a=zz")

    // round trips
    fails = fails + expect("rt_ascii", qp_decode(qp_encode("The quick brown fox!")), "The quick brown fox!")
    fails = fails + expect("rt_accent", qp_decode(qp_encode("na" + chr(239) + "ve caf" + chr(233))), "na" + chr(239) + "ve caf" + chr(233))
    fails = fails + expect("rt_symbols", qp_decode(qp_encode("1+1=2 & 3>2")), "1+1=2 & 3>2")

    if fails == 0
        print("forge_qp: all passed")
    else
        print("forge_qp: " + str(fails) + " FAILED")
