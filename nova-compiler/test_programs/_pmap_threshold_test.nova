// pmap/pfilter parallel-vs-serial EQUIVALENCE, including below the element threshold.
//
// nova_pmap_thread_count returns 1 when the list has fewer than nova_pmap_threshold
// elements (default 256), so pmap silently runs SERIALLY for short lists no matter
// how expensive each element is. Measured, total work constant: 255 elements took
// 212 ms serial vs 82 ms at 256 elements -- a 2.7x cliff decided by one element.
// NOVA_PMAP_THRESHOLD now makes that tunable, so a caller who knows their elements
// are expensive can opt in.
//
// Forcing parallelism on small lists changes which code path runs (threaded chunking
// instead of list_map), so this test asserts the two paths agree EXACTLY -- order
// included, since pmap writes into an indexed output array and a chunking bug would
// silently reorder or drop results. Run under both settings by _pmap_threshold_gate.

fn sq(x: int) -> int
    x * x

fn is_odd(x: int) -> bool
    x % 2 == 1

fn main()
    // Deliberately BELOW the default 256 threshold: with NOVA_PMAP_THRESHOLD unset
    // this exercises the serial path, and with =1 the threaded path. Both must agree.
    let xs = []
    let i = 0
    while i < 100
        push(xs, i)
        i = i + 1

    let mapped = pmap(xs, fn(x) sq(x))
    let serial = map(xs, fn(x) sq(x))

    assert(len(mapped) == len(serial), "pmap length matches map")
    let k = 0
    while k < len(serial)
        // ORDER matters: index-by-index, not just a sum.
        assert(mapped[k] == serial[k], "pmap element " + str(k) + " matches map")
        k = k + 1

    let filtered = pfilter(xs, fn(x) is_odd(x))
    let fserial = filter(xs, fn(x) is_odd(x))
    assert(len(filtered) == len(fserial), "pfilter length matches filter")
    let j = 0
    while j < len(fserial)
        assert(filtered[j] == fserial[j], "pfilter element " + str(j) + " matches filter")
        j = j + 1

    print("PMAP_THRESHOLD_OK")
