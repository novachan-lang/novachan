fn v_required(name, value)
  if str(value) == ""
    return err(name + " is required")
  ok(value)

fn v_min_len(name, value, min)
  if len(str(value)) < min
    return err(name + " must be at least " + str(min) + " characters")
  ok(value)

fn v_max_len(name, value, max)
  if len(str(value)) > max
    return err(name + " must be at most " + str(max) + " characters")
  ok(value)

fn v_min(name, value, min)
  if value < min
    return err(name + " must be >= " + str(min))
  ok(value)

fn v_max(name, value, max)
  if value > max
    return err(name + " must be <= " + str(max))
  ok(value)

fn v_range(name, value, lo, hi)
  if value < lo or value > hi
    return err(name + " must be between " + str(lo) + " and " + str(hi))
  ok(value)

fn v_one_of(name, value, allowed)
  for a in allowed
    if a == value
      return ok(value)
  err(name + " must be one of: " + join(map(allowed, fn(e) str(e)), ", "))

fn v_matches(name, value, pattern)
  if not contains(value, pattern)
    return err(name + " must contain '" + pattern + "'")
  ok(value)

fn validate(checks)
  let errors = []
  let i = 0
  while i < len(checks)
    let r = checks[i]
    if is_err(r)
      push(errors, unwrap_err(r))
    i = i + 1
  if len(errors) > 0
    return err(errors)
  ok("valid")

fn main()
  let r1 = v_required("name", "Alice")
  assert(is_ok(r1), "required passes")

  let r2 = v_required("name", "")
  assert(is_err(r2), "required fails empty")

  let r3 = v_min_len("password", "abc", 8)
  assert(is_err(r3), "min_len fails short")

  let r4 = v_min_len("password", "longpassword", 8)
  assert(is_ok(r4), "min_len passes")

  let r5 = v_range("age", 25, 18, 65)
  assert(is_ok(r5), "range passes")

  let r6 = v_range("age", 10, 18, 65)
  assert(is_err(r6), "range fails low")

  let r7 = v_one_of("role", "admin", ["admin", "user", "guest"])
  assert(is_ok(r7), "one_of passes")

  let r8 = v_one_of("role", "hacker", ["admin", "user", "guest"])
  assert(is_err(r8), "one_of fails")

  let checks = [v_required("name", "Alice"), v_min_len("password", "secret123", 8), v_range("age", 25, 18, 65), v_one_of("role", "admin", ["admin", "user"])]
  let result = validate(checks)
  assert(is_ok(result), "all valid")

  let bad_checks = [v_required("name", ""), v_min_len("password", "abc", 8), v_range("age", 10, 18, 65)]
  let bad = validate(bad_checks)
  assert(is_err(bad), "validation fails")
  let errs = unwrap_err(bad)
  assert(len(errs) == 3, "3 errors")

  print("validx: all passed")
