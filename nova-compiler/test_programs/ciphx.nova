fn rot13(text)
  let out = ""
  let i = 0
  while i < len(text)
    let cp = code_points(slice(text, i, i + 1))
    let c = cp[0]
    if c >= 65 and c <= 90
      c = 65 + (c - 65 + 13) % 26
    else if c >= 97 and c <= 122
      c = 97 + (c - 97 + 13) % 26
    out = out + from_codepoint(c)
    i = i + 1
  out

fn caesar(text, shift)
  let out = ""
  let i = 0
  while i < len(text)
    let cp = code_points(slice(text, i, i + 1))
    let c = cp[0]
    if c >= 65 and c <= 90
      c = 65 + (c - 65 + shift) % 26
    else if c >= 97 and c <= 122
      c = 97 + (c - 97 + shift) % 26
    out = out + from_codepoint(c)
    i = i + 1
  out

fn xor_encrypt(text, key)
  let out = []
  let key_bytes = str_to_bytes(key)
  let klen = bytes_len(key_bytes)
  let text_bytes = str_to_bytes(text)
  let tlen = bytes_len(text_bytes)
  let i = 0
  while i < tlen
    let tb = bytes_get(text_bytes, i)
    let kb = bytes_get(key_bytes, i % klen)
    push(out, tb ^ kb)
    i = i + 1
  out

fn xor_decrypt(cipher_bytes, key)
  let key_bytes = str_to_bytes(key)
  let klen = bytes_len(key_bytes)
  let out = ""
  let i = 0
  while i < len(cipher_bytes)
    let cb = cipher_bytes[i]
    let kb = bytes_get(key_bytes, i % klen)
    out = out + from_codepoint(cb ^ kb)
    i = i + 1
  out

fn main()
  assert(rot13("Hello") == "Uryyb", "rot13 encode")
  assert(rot13("Uryyb") == "Hello", "rot13 decode (self-inverse)")
  assert(rot13(rot13("NOVA rocks!")) == "NOVA rocks!", "rot13 round-trip")
  assert(rot13("abc") == "nop", "rot13 lower")

  assert(caesar("ABC", 3) == "DEF", "caesar shift 3")
  assert(caesar("XYZ", 3) == "ABC", "caesar wrap")
  assert(caesar(caesar("Hello", 7), 19) == "Hello", "caesar round-trip (7+19=26)")

  let key = "secret"
  let cipher = xor_encrypt("Hello World", key)
  let decrypted = xor_decrypt(cipher, key)
  assert(decrypted == "Hello World", "xor round-trip")

  let c2 = xor_encrypt("NOVA", "k")
  let d2 = xor_decrypt(c2, "k")
  assert(d2 == "NOVA", "xor single-char key")

  print("ciphx: all passed")
