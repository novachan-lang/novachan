// KAT test for std/cipher/polybius
import std/cipher/polybius

fn cks(label, got, want)
    if got != want
        print("FAIL polybius " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL polybius " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ── KAT 1: plain square length = 25 ─────────────────────────────────────────
let sq0 = polybius_square("")
cki("plain_sq_len", len(sq0), 25)

// ── KAT 2: plain square first five entries = A B C D E ──────────────────────
cks("plain_sq_0", sq0[0], "A")
cks("plain_sq_1", sq0[1], "B")
cks("plain_sq_2", sq0[2], "C")
cks("plain_sq_3", sq0[3], "D")
cks("plain_sq_4", sq0[4], "E")

// ── KAT 3: J not in plain square ────────────────────────────────────────────
let found_j = 0
let si = 0
while si < 25
    if sq0[si] == "J"
        found_j = 1
    si = si + 1
cki("no_J_in_sq", found_j, 0)

// ── KAT 4: KNOWN VECTOR — polybius_encrypt("HELLO","") == "2315313134" ──────
// H=(2,3)->23  E=(1,5)->15  L=(3,1)->31  L=(3,1)->31  O=(3,4)->34
let known_enc = polybius_encrypt("HELLO", "")
cks("known_vector", known_enc, "2315313134")

// ── KAT 5: decrypt known vector ─────────────────────────────────────────────
let known_dec = polybius_decrypt("2315313134", "")
cks("known_vector_dec", known_dec, "HELLO")

// ── KAT 6: round-trip plain square ──────────────────────────────────────────
let rt1_enc = polybius_encrypt("HELLOWORLD", "")
let rt1_dec = polybius_decrypt(rt1_enc, "")
cks("roundtrip_plain", rt1_dec, "HELLOWORLD")

// ── KAT 7: round-trip keyed square ──────────────────────────────────────────
let rt2_enc = polybius_encrypt("NOVAISFAST", "KEYWORD")
let rt2_dec = polybius_decrypt(rt2_enc, "KEYWORD")
cks("roundtrip_keyed", rt2_dec, "NOVAISFAST")

// ── KAT 8: second keyed round-trip ──────────────────────────────────────────
let rt3_enc = polybius_encrypt("THEQUICKBROWNFOX", "SECRETKEY")
let rt3_dec = polybius_decrypt(rt3_enc, "SECRETKEY")
cks("roundtrip_keyed2", rt3_dec, "THEQUICKBROWNFOX")

// ── KAT 9: keyed square has 25 elements and first = K ───────────────────────
let sqk = polybius_square("KEYWORD")
cki("keyed_sq_len", len(sqk), 25)
cks("keyed_sq_0", sqk[0], "K")

// ── KAT 10: J treated same as I ─────────────────────────────────────────────
let j_enc = polybius_encrypt("JAVA", "")
let i_enc = polybius_encrypt("IAVA", "")
cks("j_as_i_enc", j_enc, i_enc)

// ── KAT 11: J in key treated as I ───────────────────────────────────────────
let sq_j = polybius_square("JUMP")
let sq_i = polybius_square("IUMP")
cks("key_j_sq0", sq_j[0], sq_i[0])
cks("key_j_sq1", sq_j[1], sq_i[1])

// ── KAT 12: empty input safety ───────────────────────────────────────────────
cks("empty_enc", polybius_encrypt("", ""), "")
cks("empty_dec", polybius_decrypt("", ""), "")

// ── KAT 13: non-letter input stripped ────────────────────────────────────────
// "H E L L O" should produce the same as "HELLO"
let stripped_enc = polybius_encrypt("H E L L O", "")
cks("strip_spaces", stripped_enc, "2315313134")

// ── KAT 14: single letter ────────────────────────────────────────────────────
// A -> row=1, col=1 -> "11"
let a_enc = polybius_encrypt("A", "")
cks("single_A", a_enc, "11")
let a_dec = polybius_decrypt("11", "")
cks("single_A_dec", a_dec, "A")

// ── KAT 15: Z is last in plain square at index 24, row=5, col=5 -> "55" ─────
let z_enc = polybius_encrypt("Z", "")
cks("Z_enc", z_enc, "55")
let z_dec = polybius_decrypt("55", "")
cks("Z_dec", z_dec, "Z")

// ── KAT 16: lowercase input normalised ───────────────────────────────────────
let lower_enc = polybius_encrypt("hello", "")
cks("lower_norm", lower_enc, "2315313134")

// ── KAT 17: output length = 2 * number of letters ────────────────────────────
let msg = "ABCDE"
let enc_len_result = polybius_encrypt(msg, "")
cki("output_len", len(enc_len_result), 10)

// ── KAT 18: degenerate key with duplicate letters ────────────────────────────
let sq_dup = polybius_square("AAABBB")
cks("dup_key_sq0", sq_dup[0], "A")
cks("dup_key_sq1", sq_dup[1], "B")
cki("dup_key_sq_len", len(sq_dup), 25)

// ── KAT 19: full alphabet round-trip ─────────────────────────────────────────
// A-Z with J replaced by I on return (since J->I normalisation)
let full_pt = "ABCDEFGHIKLMNOPQRSTUVWXYZ"
let full_enc = polybius_encrypt(full_pt, "")
let full_dec = polybius_decrypt(full_enc, "")
cks("full_alpha_rt", full_dec, full_pt)

// ── KAT 20: keyed square no J in it ─────────────────────────────────────────
let found_j2 = 0
let si2 = 0
while si2 < 25
    if sqk[si2] == "J"
        found_j2 = 1
    si2 = si2 + 1
cki("no_J_keyed_sq", found_j2, 0)

print("PASS _polybius_test")
