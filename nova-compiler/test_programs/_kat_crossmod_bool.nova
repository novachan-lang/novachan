// A `-> bool` returned from an IMPORTED module must keep its bool representation.
//
// THE BUG. frt (the compiler's function-return-type map) is seeded from the TI inferrer's
// ti_fn_types, which only covers the module being inferred -- so a function from an IMPORTED module
// never reached it. str() dispatches on that static label, so it fell to the int path and printed
// 1/0 instead of true/false. A local `-> bool` was fine; the identical imported one was not.
//
// It took two fixes, and the second is the interesting one. Seeding frt from b.ir_fn_returns (which
// DOES cover imports) changed nothing, because the inter-procedural return-type fixpoint then
// overwrote it: ir_analyze_return_type re-derives from the IR, where a bool IS an i64, so it
// concluded "int". A declared `-> bool` now outranks that re-derivation -- the same principle as
// fpt_decl protecting a declared float from call-site narrowing: an annotation the author wrote
// beats a type the compiler re-inferred from a representation that cannot tell the two apart.
//
// WHY THIS WENT UNNOTICED FOR SO LONG. It broke seven gated tests (forge_anagram, forge_collatz,
// forge_cuckoofilter, forge_fasthash, forge_huffman, forge_lzw, forge_manacher) and the CI stayed
// green, because those tests print "FAIL ..." and exit 0 -- and the harness only checked the exit
// code and stderr. See SUSPECT-OUTFAIL in _test_worker.ps1.
//
// The VALUE was never wrong: `== true` and truthiness both worked throughout. This is purely the
// static label, which is exactly why nothing crashed and only str() disagreed.

import forge_anagram

fn local_bool(a: string, b: string) -> bool
    len(a) == len(b)

fn ck(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // The imported `-> bool` -- the case that regressed.
    let imported_t = is_anagram("listen", "silent")
    let imported_f = is_anagram("abc", "abd")
    ck("imported true", str(imported_t), "true")
    ck("imported false", str(imported_f), "false")

    // A local `-> bool`, which always worked. Both must agree, and asserting the pair is the point:
    // a fix that made the imported side wrong in the same way as the local side would still "match".
    ck("local true", str(local_bool("ab", "cd")), "true")
    ck("local false", str(local_bool("a", "cd")), "false")

    // An inline comparison and `not` go through the same str() dispatch.
    ck("inline cmp", str(2 == 2), "true")
    ck("inline neq", str(2 == 3), "false")
    ck("not", str(not false), "true")

    // The VALUE must stay correct independently of how it renders -- if a future change fixes the
    // label by corrupting the value, these catch it.
    if not imported_t
        print("FAIL imported true is not truthy")
        exit(1)
    if imported_f
        print("FAIL imported false is truthy")
        exit(1)
    ck("imported == true", str(imported_t == true), "true")

    // Interpolation lowers to any_to_str rather than str(), a separate path worth pinning.
    ck("interp", "{imported_t}", "true")

    print("crossmod bool kat passed")
