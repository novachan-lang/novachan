// CAPABILITY AUDIT: higher-order functions + closures (map/filter/fold).
// Confirmed working in ai_classify_test (xs.map(fn(x) ...)); this probes the
// full functional surface the stdlib should be using instead of manual loops.
fn main() -> int
    let fails = 0
    let xs = [1, 2, 3, 4, 5]
    let doubled = xs.map(fn(x) x * 2)
    if doubled[0] != 2
        print("FAIL map[0]")
        fails = fails + 1
    if doubled[4] != 10
        print("FAIL map[4]")
        fails = fails + 1
    let evens = xs.filter(fn(x) x % 2 == 0)
    if len(evens) != 2
        print("FAIL filter len (want 2, got " + str(len(evens)) + ")")
        fails = fails + 1
    // capturing closure (closes over `k`)
    let k = 100
    let shifted = xs.map(fn(x) x + k)
    if shifted[0] != 101
        print("FAIL closure capture")
        fails = fails + 1
    // chained
    let chain = xs.filter(fn(x) x > 2).map(fn(x) x * 10)
    if len(chain) != 3
        print("FAIL chain len")
        fails = fails + 1
    if chain[0] != 30
        print("FAIL chain[0] (want 30, got " + str(chain[0]) + ")")
        fails = fails + 1
    if fails == 0
        print("PASS _cap_hof_probe (map/filter/closure/chain work)")
    else
        print("FAILED _cap_hof_probe")
    return 0
