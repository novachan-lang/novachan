// NOVA Sentinel v0.1 demo: hashing, password verification, and
// tamper-evident audit log chains. All built on the existing
// nova_rt_sha256 runtime function, exposed as a clean security API.
import sentinel

fn main()
    // 1. Hashing is deterministic
    let h1 = sentinel.hash("hello")
    let h2 = sentinel.hash("hello")
    assert_eq(h1, h2)
    let h3 = sentinel.hash("world")
    if h1 == h3
        print("FAIL: distinct inputs produced same hash")
        exit(1)

    // 2. Password hash + verify round-trip
    let pw_hash = sentinel.hash_password("correct horse battery staple")
    if not sentinel.verify_password("correct horse battery staple", pw_hash)
        print("FAIL: correct password rejected")
        exit(1)
    if sentinel.verify_password("wrong password", pw_hash)
        print("FAIL: wrong password accepted")
        exit(1)

    // 3. Tamper-evident audit chain
    let chain = []
    let prev = ""
    let e1 = sentinel.audit_chain_add(prev, "\{\"event\":\"login\",\"user\":\"alice\"\}")
    chain.push(e1)
    prev = e1[0]
    let e2 = sentinel.audit_chain_add(prev, "\{\"event\":\"action\",\"user\":\"alice\",\"action\":\"transfer\"\}")
    chain.push(e2)
    prev = e2[0]
    let e3 = sentinel.audit_chain_add(prev, "\{\"event\":\"logout\",\"user\":\"alice\"\}")
    chain.push(e3)

    // Intact chain verifies
    if not sentinel.audit_chain_verify(chain)
        print("FAIL: pristine chain rejected by verify")
        exit(1)

    // Tampering breaks verification
    let tampered = []
    tampered.push(chain[0])
    let bad_e2 = [chain[1][0], "\{\"event\":\"action\",\"user\":\"alice\",\"action\":\"steal\"\}"]
    tampered.push(bad_e2)
    tampered.push(chain[2])
    if sentinel.audit_chain_verify(tampered)
        print("FAIL: tampered chain accepted by verify")
        exit(1)

    print("SENTINEL v0.1 demo passed: deterministic SHA-256 hashing, password verify round-trip, audit chain pristine-vs-tampered detection")
