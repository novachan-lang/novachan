fn naturals()
  let i = 0
  while true
    yield i
    i = i + 1

fn take_n(gen, n)
  let out = []
  let count = 0
  while count < n
    let done = gen_next(gen)
    if done == 1
      return out
    push(out, gen_value(gen))
    count = count + 1
  out

fn test_infinite_naturals()
  let g = naturals()
  let first5 = take_n(g, 5)
  assert(len(first5) == 5, "took 5 from infinite: " + str(len(first5)))
  assert(first5[0] == 0, "nat[0]==0")
  assert(first5[4] == 4, "nat[4]==4")
  let next3 = take_n(g, 3)
  assert(next3[0] == 5, "resumes at 5: " + str(next3[0]))
  assert(next3[2] == 7, "nat[7]==7")

fn fib_gen()
  let a = 0
  let b = 1
  while true
    yield a
    let t = a + b
    a = b
    b = t

fn test_fibonacci()
  let g = fib_gen()
  let fibs = take_n(g, 10)
  assert(fibs[0] == 0, "fib0")
  assert(fibs[1] == 1, "fib1")
  assert(fibs[6] == 8, "fib6==8")
  assert(fibs[9] == 34, "fib9==34")

fn finite_gen(n)
  let i = 0
  while i < n
    yield i * i
    i = i + 1

fn test_gen_collect()
  let result = gen_collect(finite_gen(5))
  assert(len(result) == 5, "collected 5: " + str(len(result)))
  assert(result[0] == 0, "sq0")
  assert(result[1] == 1, "sq1")
  assert(result[4] == 16, "sq16")

fn test_for_over_gen()
  let sum = 0
  for x in finite_gen(5)
    sum = sum + x
  assert(sum == 30, "sum of squares 0..4 = 30: " + str(sum))

fn test_nested_gen()
  let g1 = naturals()
  let g2 = naturals()
  gen_next(g1)
  gen_next(g1)
  gen_next(g2)
  assert(gen_value(g1) == 1, "g1 at 1")
  assert(gen_value(g2) == 0, "g2 at 0")
  gen_next(g1)
  assert(gen_value(g1) == 2, "g1 at 2")
  assert(gen_value(g2) == 0, "g2 still at 0")

fn main()
  test_infinite_naturals()
  test_fibonacci()
  test_gen_collect()
  test_for_over_gen()
  test_nested_gen()
  print("lazy_gen_test: all passed")
