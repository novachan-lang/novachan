// FINDING #2 oracle: a user-defined function must shadow a built-in of the same name.
// Old (buggy) behavior: ok(5) called the built-in Result constructor -> wrong slot.
// Fixed behavior: ok(5) calls THIS user function -> Box(105), b.value == 105.

type Box
    value: int

fn ok(v: int) -> Box
    Box(v + 100)

fn main()
    let b = ok(5)
    assert_eq(b.value, 105)
    print("shadowing test passed: user ok() shadows builtin")
