// Result<T,E> and Option<T> test suite

fn safe_divide(a: int, b: int) -> int
    if b == 0
        return err("division by zero")
    return ok(a / b)

fn safe_sqrt(n: int) -> int
    if n < 0
        return err("negative input")
    let r = 0
    while r * r < n
        r = r + 1
    if r * r == n
        return ok(r)
    return err("not a perfect square")

fn find_item(items: list, target: string) -> int
    let i = 0
    while i < len(items)
        if items[i] == target
            return some(i)
        i = i + 1
    return none()

fn test_basic_result()
    let r1 = ok(42)
    print(is_ok(r1))
    print(is_err(r1))
    print(unwrap(r1))

    let r2 = err("oops")
    print(is_ok(r2))
    print(is_err(r2))
    print(unwrap_err(r2))

fn test_basic_option()
    let s1 = some(99)
    print(is_some(s1))
    print(is_none(s1))
    print(unwrap(s1))

    let s2 = none()
    print(is_some(s2))
    print(is_none(s2))
    print(unwrap_or(s2, -1))

fn test_safe_divide()
    let r1 = safe_divide(10, 2)
    print(unwrap(r1))

    let r2 = safe_divide(10, 0)
    print(is_err(r2))
    print(unwrap_err(r2))

fn test_safe_sqrt()
    let r1 = safe_sqrt(25)
    print(unwrap(r1))

    let r2 = safe_sqrt(-4)
    print(is_err(r2))

    let r3 = safe_sqrt(7)
    print(is_err(r3))

fn test_find_item()
    let items = ["apple", "banana", "cherry"]
    let r1 = find_item(items, "banana")
    print(is_some(r1))
    print(unwrap(r1))

    let r2 = find_item(items, "grape")
    print(is_none(r2))
    print(unwrap_or(r2, -1))

fn test_unwrap_or()
    let r1 = ok(100)
    print(unwrap_or(r1, 0))

    let r2 = err("fail")
    print(unwrap_or(r2, 0))

    let o1 = some(77)
    print(unwrap_or(o1, 0))

    let o2 = none()
    print(unwrap_or(o2, 0))

fn test_result_tag()
    let r1 = ok(1)
    print(result_tag(r1))

    let r2 = err("x")
    print(result_tag(r2))

    let o1 = some(1)
    print(result_tag(o1))

    let o2 = none()
    print(result_tag(o2))

fn test_chaining()
    let r1 = safe_divide(100, 4)
    let r2 = result_map(r1, fn(x) x * 2)
    print(unwrap(r2))

    let r3 = safe_divide(100, 0)
    let r4 = result_map(r3, fn(x) x * 2)
    print(is_err(r4))

fn propagate_example(a: int, b: int) -> int
    let val = safe_divide(a, b)?
    return ok(val * 10)

fn test_question_mark()
    let r1 = propagate_example(20, 4)
    print(unwrap(r1))

    let r2 = propagate_example(20, 0)
    print(is_err(r2))
    print(unwrap_err(r2))

fn main()
    print("--- basic result ---")
    test_basic_result()
    print("--- basic option ---")
    test_basic_option()
    print("--- safe divide ---")
    test_safe_divide()
    print("--- safe sqrt ---")
    test_safe_sqrt()
    print("--- find item ---")
    test_find_item()
    print("--- unwrap_or ---")
    test_unwrap_or()
    print("--- result tag ---")
    test_result_tag()
    print("--- chaining ---")
    test_chaining()
    print("--- ? operator ---")
    test_question_mark()
    print("ALL RESULT/OPTION TESTS PASSED")
