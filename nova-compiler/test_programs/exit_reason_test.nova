// Structured exit reasons (Erlang-class {DOWN, reason}): monitor(p) tells you THAT a
// Process exited; exit_reason(p) tells you WHY — "normal" for a clean exit, or the panic
// message for a contained crash. A supervisor can log/decide on the reason.

fn crasher()
    panic("boom")

fn unwrap_crasher()
    unwrap(parse_int_safe("not a number"))

fn good_worker()
    return 0

p1 = spawn crasher()
m1 = monitor(p1)
assert_eq(receive(m1), 1)
assert_eq(exit_reason(p1), "boom")

p2 = spawn unwrap_crasher()
m2 = monitor(p2)
assert_eq(receive(m2), 1)
assert_eq(exit_reason(p2), "unwrap called on Err/None")

p3 = spawn good_worker()
m3 = monitor(p3)
assert_eq(receive(m3), 0)
assert_eq(exit_reason(p3), "normal")

print("exit_reason passed")
