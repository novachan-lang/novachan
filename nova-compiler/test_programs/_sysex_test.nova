// _sysex_test.nova -- KAT for std/midi/sysex
//
// Verifies exact byte outputs for all public functions.
//
// HAND-VERIFIED VECTORS:
//
//   sysex([0x43, 0x12])
//     = [0xF0, 0x43, 0x12, 0xF7]
//     = [240, 67, 18, 247]
//
//   sysex([])
//     = [0xF0, 0xF7]
//     = [240, 247]
//
//   sysex_universal_nonrealtime(0x7F, 0x06, 0x01, [])
//     = [0xF0, 0x7E, 0x7F, 0x06, 0x01, 0xF7]
//     = [240, 126, 127, 6, 1, 247]
//
//   sysex_decode([0xF0, 0x43, 0x12, 0xF7])
//     = [0x43, 0x12]
//     = [67, 18]
//
//   manufacturer_name(0x41) = "Roland"
//   manufacturer_name(0x43) = "Yamaha"

import std/midi/sysex

// ── helpers ──────────────────────────────────────────────────────────────────

fn ckstr(label, got, want)
    if got != want
        print("FAIL sysex " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL sysex " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// Check that list lengths match first, then each element.
fn cklist(label, got, want)
    let glen = len(got)
    let wlen = len(want)
    if glen != wlen
        print("FAIL sysex " + label + " len: got=" + str(glen) + " want=" + str(wlen))
        exit(1)
    let i = 0
    while i < wlen
        let gv = got[i]
        let wv = want[i]
        if gv != wv
            print("FAIL sysex " + label + "[" + str(i) + "]: got=" + str(gv) + " want=" + str(wv))
            exit(1)
        i = i + 1

fn main()
    // ── KAT 1: sysex([0x43, 0x12]) == [0xF0, 0x43, 0x12, 0xF7] ─────────────
    let data1 = [0x43, 0x12]
    let msg1 = sysex(data1)
    let want1 = [0xF0, 0x43, 0x12, 0xF7]
    cklist("sysex([0x43,0x12])", msg1, want1)

    // ── KAT 2: sysex([]) == [0xF0, 0xF7] ────────────────────────────────────
    let data2 = []
    let msg2 = sysex(data2)
    let want2 = [0xF0, 0xF7]
    cklist("sysex([])", msg2, want2)

    // ── KAT 3: sysex_universal_nonrealtime(0x7F, 0x06, 0x01, []) ────────────
    //   = [0xF0, 0x7E, 0x7F, 0x06, 0x01, 0xF7]
    let data3 = []
    let msg3 = sysex_universal_nonrealtime(0x7F, 0x06, 0x01, data3)
    let want3 = [0xF0, 0x7E, 0x7F, 0x06, 0x01, 0xF7]
    cklist("sysex_universal_nonrealtime", msg3, want3)

    // ── KAT 4: sysex_decode([0xF0, 0x43, 0x12, 0xF7]) == [0x43, 0x12] ───────
    let enc4 = [0xF0, 0x43, 0x12, 0xF7]
    let dec4 = sysex_decode(enc4)
    let want4 = [0x43, 0x12]
    cklist("sysex_decode", dec4, want4)

    // ── KAT 5: manufacturer_name(0x41) == "Roland" ───────────────────────────
    let name41 = manufacturer_name(0x41)
    ckstr("manufacturer_name(0x41)", name41, "Roland")

    // ── KAT 6: manufacturer_name(0x43) == "Yamaha" ───────────────────────────
    let name43 = manufacturer_name(0x43)
    ckstr("manufacturer_name(0x43)", name43, "Yamaha")

    // ── KAT 7: sysex_manufacturer(0x43, [0x12]) == [0xF0, 0x43, 0x12, 0xF7] ─
    let mdata7 = [0x12]
    let msg7 = sysex_manufacturer(0x43, mdata7)
    let want7 = [0xF0, 0x43, 0x12, 0xF7]
    cklist("sysex_manufacturer(0x43,[0x12])", msg7, want7)

    // ── KAT 8: round-trip sysex -> sysex_decode ──────────────────────────────
    let inner8 = [0x41, 0x10, 0x42, 0x00, 0x7F]
    let encoded8 = sysex(inner8)
    let decoded8 = sysex_decode(encoded8)
    cklist("round-trip", decoded8, inner8)

    // ── KAT 9: sysex_decode with no F0 returns empty ─────────────────────────
    let bad9 = [0x43, 0x12, 0xF7]
    let dec9 = sysex_decode(bad9)
    cki("decode-no-F0 len", len(dec9), 0)

    // ── KAT 10: sysex_decode with no F7 returns empty ────────────────────────
    let bad10 = [0xF0, 0x43, 0x12]
    let dec10 = sysex_decode(bad10)
    cki("decode-no-F7 len", len(dec10), 0)

    // ── KAT 11: manufacturer_name(0x7D) == "Educational" ─────────────────────
    let name7D = manufacturer_name(0x7D)
    ckstr("manufacturer_name(0x7D)", name7D, "Educational")

    // ── KAT 12: manufacturer_name(0x99) == "Unknown" ─────────────────────────
    let nameUnk = manufacturer_name(0x99)
    ckstr("manufacturer_name(0x99)", nameUnk, "Unknown")

    // ── KAT 13: data byte clamping — 0xFF gets clamped to 0x7F ──────────────
    let baddata = [0xFF, 0x43, 0x00]
    let msgClamp = sysex(baddata)
    // Expected: [0xF0, 0x7F, 0x43, 0x00, 0xF7]
    let wantClamp = [0xF0, 0x7F, 0x43, 0x00, 0xF7]
    cklist("sysex-clamp", msgClamp, wantClamp)

    print("PASS _sysex_test")
