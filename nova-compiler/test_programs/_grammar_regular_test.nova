// KAT for std/grammar/grammar_regular
import std/grammar/grammar_regular

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL grammar_regular " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL grammar_regular " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL grammar_regular " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn main()
    // =========================================================
    // KAT 1: S -> a S | b  is right-linear
    // grr_is_right_linear([["S",["a","S"]], ["S",["b"]]]) == true
    // =========================================================
    let rl_prods = []
    let rhs1 = []
    rhs1.push("a")
    rhs1.push("S")
    rl_prods.push(["S", rhs1])
    let rhs2 = []
    rhs2.push("b")
    rl_prods.push(["S", rhs2])

    ckb("rl_true", grr_is_right_linear(rl_prods), true)

    // =========================================================
    // KAT 2: S -> a S b  is NOT right-linear (NT not at end)
    // grr_is_right_linear([["S",["a","S","b"]]]) == false
    // =========================================================
    let notrl_prods = []
    let rhs_aSb = []
    rhs_aSb.push("a")
    rhs_aSb.push("S")
    rhs_aSb.push("b")
    notrl_prods.push(["S", rhs_aSb])

    ckb("rl_false", grr_is_right_linear(notrl_prods), false)

    // =========================================================
    // KAT 3: left-linear grammar S -> S a | b
    // grr_is_left_linear([["S",["S","a"]], ["S",["b"]]]) == true
    // =========================================================
    let ll_prods = []
    let rhs_Sa = []
    rhs_Sa.push("S")
    rhs_Sa.push("a")
    ll_prods.push(["S", rhs_Sa])
    let rhs_b2 = []
    rhs_b2.push("b")
    ll_prods.push(["S", rhs_b2])

    ckb("ll_true", grr_is_left_linear(ll_prods), true)
    // And it is NOT right-linear (NT not at end).
    ckb("ll_not_rl", grr_is_right_linear(ll_prods), false)

    // =========================================================
    // KAT 4: NFA from S -> a S | b (right-linear a*b)
    // grr_to_nfa then grr_nfa_accepts:
    //   ["a","a","b"] -> true
    //   ["b"]         -> true
    //   ["a","b","a"] -> false
    //   []            -> false
    // =========================================================
    let nfa = grr_to_nfa(rl_prods, "S")

    let tok_aab = []
    tok_aab.push("a")
    tok_aab.push("a")
    tok_aab.push("b")
    ckb("nfa_aab", grr_nfa_accepts(nfa, tok_aab), true)

    let tok_b = []
    tok_b.push("b")
    ckb("nfa_b", grr_nfa_accepts(nfa, tok_b), true)

    let tok_aba = []
    tok_aba.push("a")
    tok_aba.push("b")
    tok_aba.push("a")
    ckb("nfa_aba", grr_nfa_accepts(nfa, tok_aba), false)

    let tok_empty = []
    ckb("nfa_empty", grr_nfa_accepts(nfa, tok_empty), false)

    // =========================================================
    // KAT 5: single-step grammar S -> b (accepts only ["b"])
    // =========================================================
    let s1_prods = []
    let rhs_b3 = []
    rhs_b3.push("b")
    s1_prods.push(["S", rhs_b3])
    let nfa1 = grr_to_nfa(s1_prods, "S")
    ckb("s1_b", grr_nfa_accepts(nfa1, tok_b), true)
    ckb("s1_empty", grr_nfa_accepts(nfa1, tok_empty), false)

    // =========================================================
    // KAT 6: epsilon grammar S -> []  (accepts only [])
    // =========================================================
    let eps_prods = []
    let rhs_eps = []
    eps_prods.push(["S", rhs_eps])
    let nfa_eps = grr_to_nfa(eps_prods, "S")
    ckb("eps_empty", grr_nfa_accepts(nfa_eps, tok_empty), true)
    ckb("eps_b", grr_nfa_accepts(nfa_eps, tok_b), false)

    // =========================================================
    // KAT 7: S -> a B, B -> b (two-state chain accepts only [a,b])
    // =========================================================
    let chain_prods = []
    let rhs_aB = []
    rhs_aB.push("a")
    rhs_aB.push("B")
    chain_prods.push(["S", rhs_aB])
    let rhs_b4 = []
    rhs_b4.push("b")
    chain_prods.push(["B", rhs_b4])
    let nfa_chain = grr_to_nfa(chain_prods, "S")
    let tok_ab = []
    tok_ab.push("a")
    tok_ab.push("b")
    ckb("chain_ab", grr_nfa_accepts(nfa_chain, tok_ab), true)
    ckb("chain_a", grr_nfa_accepts(nfa_chain, tok_aab), false)
    ckb("chain_empty", grr_nfa_accepts(nfa_chain, tok_empty), false)

    // =========================================================
    // KAT 8: grr_is_right_linear for epsilon production ([] rhs)
    // S -> [] is right-linear (vacuously no NT in non-terminal position).
    // =========================================================
    let eps2_prods = []
    eps2_prods.push(["S", rhs_eps])
    ckb("eps_rl", grr_is_right_linear(eps2_prods), true)
    ckb("eps_ll", grr_is_left_linear(eps2_prods), true)

    // =========================================================
    // KAT 9: NFA with multi-step right-linear S -> a b S | c
    // (accepts: (ab)*c — strings: c, abc, ababc, ...)
    // =========================================================
    let multi_prods = []
    let rhs_abS = []
    rhs_abS.push("a")
    rhs_abS.push("b")
    rhs_abS.push("S")
    multi_prods.push(["S", rhs_abS])
    let rhs_c = []
    rhs_c.push("c")
    multi_prods.push(["S", rhs_c])
    let nfa_multi = grr_to_nfa(multi_prods, "S")

    let tok_c = []
    tok_c.push("c")
    ckb("multi_c", grr_nfa_accepts(nfa_multi, tok_c), true)

    let tok_abc = []
    tok_abc.push("a")
    tok_abc.push("b")
    tok_abc.push("c")
    ckb("multi_abc", grr_nfa_accepts(nfa_multi, tok_abc), true)

    let tok_ababc = []
    tok_ababc.push("a")
    tok_ababc.push("b")
    tok_ababc.push("a")
    tok_ababc.push("b")
    tok_ababc.push("c")
    ckb("multi_ababc", grr_nfa_accepts(nfa_multi, tok_ababc), true)

    let tok_ac = []
    tok_ac.push("a")
    tok_ac.push("c")
    ckb("multi_ac_false", grr_nfa_accepts(nfa_multi, tok_ac), false)

    // =========================================================
    // KAT 10: UNIT productions A -> B (right-linear, zero leading terminals).
    // Regression for the epsilon-edge / epsilon-closure fix.
    //   A -> B ; B -> x | y     accepts x, y (not empty, not xx)
    //   unit chain A -> B -> C -> z  accepts z
    // =========================================================
    let unit_prods = []
    let rhs_B = []
    rhs_B.push("B")
    unit_prods.push(["A", rhs_B])
    let rhs_x = []
    rhs_x.push("x")
    unit_prods.push(["B", rhs_x])
    let rhs_y = []
    rhs_y.push("y")
    unit_prods.push(["B", rhs_y])
    ckb("unit_is_rl", grr_is_right_linear(unit_prods), true)
    let nfa_unit = grr_to_nfa(unit_prods, "A")
    let tok_x = []
    tok_x.push("x")
    let tok_y = []
    tok_y.push("y")
    ckb("unit_x", grr_nfa_accepts(nfa_unit, tok_x), true)
    ckb("unit_y", grr_nfa_accepts(nfa_unit, tok_y), true)
    ckb("unit_empty", grr_nfa_accepts(nfa_unit, tok_empty), false)

    let chain2_prods = []
    let rhs_B2 = []
    rhs_B2.push("B")
    chain2_prods.push(["A", rhs_B2])
    let rhs_C = []
    rhs_C.push("C")
    chain2_prods.push(["B", rhs_C])
    let rhs_z = []
    rhs_z.push("z")
    chain2_prods.push(["C", rhs_z])
    let nfa_chain2 = grr_to_nfa(chain2_prods, "A")
    let tok_z = []
    tok_z.push("z")
    ckb("unitchain_z", grr_nfa_accepts(nfa_chain2, tok_z), true)
    ckb("unitchain_empty", grr_nfa_accepts(nfa_chain2, tok_empty), false)

    print("PASS _grammar_regular_test")
