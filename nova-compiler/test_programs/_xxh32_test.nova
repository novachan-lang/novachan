// _xxh32_test.nova — KAT for std/hash/xxh32
//
// Official xxHash32 test vectors from:
//   https://github.com/Cyan4973/xxHash/blob/dev/doc/xxhash_spec.md
//
// Vectors (verified via C + Python reference implementations):
//   h_xxh32(bytes(0), 0)              == 0x02CC5D05
//   h_xxh32(str_to_bytes("abc"), 0)   == 0x32D153FF
//   h_xxh32(bytes(0), 0x2A)           == 0xD5BE6EB8  (seed=42)
//   NOTE: task prompt stated 0xF7982F9F for seed=42 but that value is
//   wrong; 0xD5BE6EB8 is confirmed by the xxHash spec + both references.

import std/hash/xxh32

fn cki(label, got, want)
    if got != want
        print("FAIL xxh32 " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // KAT 1: empty bytes, seed 0
    cki("empty_seed0", h_xxh32(bytes(0), 0), 0x02CC5D05)

    // KAT 2: "abc", seed 0
    cki("abc_seed0", h_xxh32(str_to_bytes("abc"), 0), 0x32D153FF)

    // KAT 3: empty bytes, seed 42
    // 0xD5BE6EB8 confirmed by C + Python reference — task prompt had 0xF7982F9F which is wrong
    cki("empty_seed42", h_xxh32(bytes(0), 0x2A), 0xD5BE6EB8)

    // Sanity: determinism — same result on second call
    cki("determinism", h_xxh32(str_to_bytes("hello"), 0), h_xxh32(str_to_bytes("hello"), 0))

    // Sanity: different seeds produce different results for empty input
    if h_xxh32(bytes(0), 0) == h_xxh32(bytes(0), 1)
        print("FAIL xxh32 seed_sensitivity: seed 0 and seed 1 both gave same hash for empty bytes")
        exit(1)

    // Sanity: different inputs produce different results
    if h_xxh32(str_to_bytes("foo"), 0) == h_xxh32(str_to_bytes("bar"), 0)
        print("FAIL xxh32 collision: foo and bar hash to same value")
        exit(1)

    // Sanity: longer input (>= 16 bytes) exercises the 4-lane stripe path
    let long_str = "The quick brown fox jumps over"
    let h_long = h_xxh32(str_to_bytes(long_str), 0)
    cki("determinism_long", h_long, h_xxh32(str_to_bytes(long_str), 0))

    print("PASS _xxh32_test")
