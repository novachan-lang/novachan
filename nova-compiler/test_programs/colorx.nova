// colorx.nova — color utilities: hex <-> rgb, blend, lighten/darken.
//
// Practical color math for web, graphics, charts, and theming — convert between
// "#rrggbb" hex and [r,g,b] components, and interpolate between colors. Supports
// NOVA's full-stack / web identity. Pure-NOVA over codepoints.

fn _hex_digit(cp)
  if cp >= 48 and cp <= 57
    return cp - 48                 // 0-9
  if cp >= 97 and cp <= 102
    return cp - 97 + 10            // a-f
  if cp >= 65 and cp <= 70
    return cp - 65 + 10            // A-F
  0

// "#ff8800" or "ff8800" -> [r, g, b]
fn hex_to_rgb(hex)
  let s = hex
  if starts_with(hex, "#")
    s = slice(hex, 1, len(hex))
  let cps = code_points(s)
  let r = _hex_digit(cps[0]) * 16 + _hex_digit(cps[1])
  let g = _hex_digit(cps[2]) * 16 + _hex_digit(cps[3])
  let b = _hex_digit(cps[4]) * 16 + _hex_digit(cps[5])
  [r, g, b]

fn _hex2(v)
  let digits = "0123456789abcdef"
  let hi = v / 16
  let lo = v % 16
  slice(digits, hi, hi + 1) + slice(digits, lo, lo + 1)

fn rgb_to_hex(r, g, b)
  "#" + _hex2(r) + _hex2(g) + _hex2(b)

// interpolate from c1 toward c2 by t percent (0..100).
fn blend(c1, c2, t)
  let r = c1[0] + (c2[0] - c1[0]) * t / 100
  let g = c1[1] + (c2[1] - c1[1]) * t / 100
  let b = c1[2] + (c2[2] - c1[2]) * t / 100
  [r, g, b]

// lighten toward white / darken toward black by `amount` percent.
fn lighten(c, amount)
  blend(c, [255, 255, 255], amount)

fn darken(c, amount)
  blend(c, [0, 0, 0], amount)

// ── Tests ────────────────────────────────────────────────────────────

let orange = hex_to_rgb("#ff8800")
assert(orange[0] == 255, "r = 255")
assert(orange[1] == 136, "g = 0x88 = 136")
assert(orange[2] == 0, "b = 0")
let green = hex_to_rgb("00ff00")          // no leading '#'
assert(green[0] == 0 and green[1] == 255 and green[2] == 0, "00ff00 -> [0,255,0]")
print("PASS: hex -> rgb")

assert(rgb_to_hex(255, 136, 0) == "#ff8800", "rgb -> #ff8800")
assert(rgb_to_hex(0, 0, 0) == "#000000", "black")
assert(rgb_to_hex(255, 255, 255) == "#ffffff", "white")
print("PASS: rgb -> hex")

// round-trip
let rt = rgb_to_hex(orange[0], orange[1], orange[2])
assert(rt == "#ff8800", "round-trip hex")
print("PASS: round-trip")

// blending
let mid = blend([0, 0, 0], [255, 255, 255], 50)
assert(mid[0] == 127, "midpoint gray ~127")
let at0 = blend([10, 20, 30], [200, 200, 200], 0)
assert(at0[0] == 10 and at0[1] == 20, "t=0 stays at c1")
let at100 = blend([10, 20, 30], [200, 100, 50], 100)
assert(at100[0] == 200 and at100[2] == 50, "t=100 reaches c2")
print("PASS: blend")

let lt = lighten([100, 100, 100], 50)
assert(lt[0] == 177, "lighten 100 toward 255 by 50% -> 177")
let dk = darken([100, 100, 100], 50)
assert(dk[0] == 50, "darken 100 toward 0 by 50% -> 50")
print("PASS: lighten / darken")

print("ALL PASS: colorx — hex/rgb color utilities")
