import std/util/deepcopy

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label: str, got: bool, want: bool)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // ── KAT 1: dc_copy of a nested dict/list structure ───────────────────────
    // Build d = { "x": 1, "inner": [10, 20], "sub": { "y": 99 } }
    let d = {}
    d["x"] = 1
    let inner = [10, 20]
    d["inner"] = inner
    let sub = {}
    sub["y"] = 99
    d["sub"] = sub

    // Deep copy d -> c
    let c = dc_copy(d)

    // ── KAT 2: dc_equal(d, c) should be true right after copy ────────────────
    ckb("equal_after_copy", dc_equal(d, c), true)

    // ── KAT 3: Mutate c's nested list; d's nested list must be UNCHANGED ─────
    // c["inner"] is a separate list — pushing to it must not affect d["inner"]
    let c_inner = c["inner"]
    c_inner.push(30)
    // d["inner"] still has length 2
    let d_inner = d["inner"]
    cki("d_inner_len_unchanged", len(d_inner), 2)
    // c_inner now has length 3 (proves non-aliasing)
    cki("c_inner_len_grew", len(c_inner), 3)

    // ── KAT 4: After mutation c and d are no longer equal ────────────────────
    ckb("not_equal_after_mutate", dc_equal(d, c), false)

    // ── KAT 5: dc_copy of a scalar int returns the same int ──────────────────
    let sv = dc_copy(42)
    cki("scalar_copy", sv, 42)

    // ── KAT 6: dc_copy([1,[2,3]]) equals the original structurally ───────────
    let orig = [1, [2, 3]]
    let orig_c = dc_copy(orig)
    ckb("nested_list_equal", dc_equal(orig, orig_c), true)

    // ── KAT 7: dc_equal([1,2],[1,3]) = false ─────────────────────────────────
    ckb("list_not_equal", dc_equal([1, 2], [1, 3]), false)

    // ── KAT 8: Two independently-built equal dicts are dc_equal ──────────────
    let p = {}
    p["a"] = 1
    p["b"] = 2
    let q = {}
    q["a"] = 1
    q["b"] = 2
    ckb("independent_dicts_equal", dc_equal(p, q), true)

    // ── KAT 9: Dicts with different values are not equal ─────────────────────
    let r = {}
    r["a"] = 1
    r["b"] = 99
    ckb("dicts_differ", dc_equal(p, r), false)

    // ── KAT 10: Dicts with different key counts are not equal ─────────────────
    let s = {}
    s["a"] = 1
    ckb("dict_diff_keycount", dc_equal(p, s), false)

    print("_deepcopy_test passed")
