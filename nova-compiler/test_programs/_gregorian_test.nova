// KAT for std/calendar/gregorian — Gregorian calendar arithmetic.
import std/calendar/gregorian

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label, got, want)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got " + gs + " want " + ws)
        exit(1)

fn main()
    // ── greg_is_leap ─────────────────────────────────────────────────────────
    ckb("leap 2000",  greg_is_leap(2000), true)    // div by 400
    ckb("leap 1900",  greg_is_leap(1900), false)   // div by 100, not 400
    ckb("leap 2024",  greg_is_leap(2024), true)    // div by 4, not 100
    ckb("leap 2023",  greg_is_leap(2023), false)   // not div by 4
    ckb("leap 1600",  greg_is_leap(1600), true)    // div by 400
    ckb("leap 2100",  greg_is_leap(2100), false)   // div by 100, not 400
    ckb("leap 2004",  greg_is_leap(2004), true)

    // ── greg_days_in_month ────────────────────────────────────────────────────
    // February leap
    cki("dim 2024 Feb",  greg_days_in_month(2024, 2), 29)
    // February common
    cki("dim 2023 Feb",  greg_days_in_month(2023, 2), 28)
    cki("dim 2100 Feb",  greg_days_in_month(2100, 2), 28)  // century non-leap
    // 31-day months
    cki("dim Jan",        greg_days_in_month(2023, 1),  31)
    cki("dim Mar",        greg_days_in_month(2023, 3),  31)
    cki("dim Dec",        greg_days_in_month(2023, 12), 31)
    // 30-day months
    cki("dim Apr",        greg_days_in_month(2023, 4),  30)
    cki("dim Jun",        greg_days_in_month(2023, 6),  30)
    cki("dim Nov",        greg_days_in_month(2023, 11), 30)

    // ── greg_day_of_year ──────────────────────────────────────────────────────
    // Jan 1 always day 1
    cki("doy 2024-01-01", greg_day_of_year(2024, 1, 1), 1)
    cki("doy 2023-01-01", greg_day_of_year(2023, 1, 1), 1)
    // Mar 1: day 60 (leap) or 60 (common: 31+28+1=60)
    cki("doy 2024-03-01 leap",   greg_day_of_year(2024, 3, 1), 61)
    cki("doy 2023-03-01 common", greg_day_of_year(2023, 3, 1), 60)
    // Dec 31
    cki("doy 2024 Dec31 leap",   greg_day_of_year(2024, 12, 31), 366)
    cki("doy 2023 Dec31 common", greg_day_of_year(2023, 12, 31), 365)
    // Feb 29 in leap year = day 60
    cki("doy 2024-02-29",        greg_day_of_year(2024, 2, 29), 60)

    // ── greg_valid ────────────────────────────────────────────────────────────
    ckb("valid 2024-01-01",  greg_valid(2024, 1, 1),   true)
    ckb("valid 2024-02-29",  greg_valid(2024, 2, 29),  true)   // leap year
    ckb("valid 2023-02-29",  greg_valid(2023, 2, 29),  false)  // not leap
    ckb("valid 2024-02-30",  greg_valid(2024, 2, 30),  false)  // day 30 in Feb
    ckb("valid 2023-04-31",  greg_valid(2023, 4, 31),  false)  // Apr has 30
    ckb("valid month 0",     greg_valid(2023, 0, 1),   false)
    ckb("valid month 13",    greg_valid(2023, 13, 1),  false)
    ckb("valid day 0",       greg_valid(2023, 1, 0),   false)
    ckb("valid 2023-12-31",  greg_valid(2023, 12, 31), true)

    print("PASS _gregorian_test")
