// dpx.nova — classic dynamic-programming optimizers: coin change + 0/1 knapsack.
//
// Two workhorses of combinatorial optimization: the FEWEST coins to make an
// amount, and the MOST value that fits a weight budget. Practical for cashiers/
// currency, resource allocation, budgeting, and subset selection. Bottom-up DP,
// O(amount * coins) and O(items * capacity).

// minimum number of coins to make `amount`, or -1 if impossible.
fn coin_change(coins, amount)
  let big = amount + 1
  let dp = []
  let a = 0
  while a <= amount
    push(dp, big)
    a = a + 1
  dp[0] = 0
  a = 1
  while a <= amount
    for c in coins
      if c <= a
        if dp[a - c] + 1 < dp[a]
          dp[a] = dp[a - c] + 1
    a = a + 1
  if dp[amount] > amount
    return 0 - 1
  dp[amount]

// can `amount` be made exactly from the coins?
fn can_make(coins, amount)
  if coin_change(coins, amount) >= 0
    return 1
  0

// maximum total value of a subset of items whose weights fit `cap` (0/1).
fn knapsack(weights, values, cap)
  let n = len(weights)
  let dp = []
  let w = 0
  while w <= cap
    push(dp, 0)
    w = w + 1
  let i = 0
  while i < n
    let wi = weights[i]
    let vi = values[i]
    let cw = cap
    while cw >= wi                 // reverse iteration => each item used at most once
      if dp[cw - wi] + vi > dp[cw]
        dp[cw] = dp[cw - wi] + vi
      cw = cw - 1
    i = i + 1
  dp[cap]

// ── Tests ────────────────────────────────────────────────────────────

let us = [1, 5, 10, 25]
assert(coin_change(us, 63) == 6, "63c = 25+25+10+1+1+1 = 6 coins")
assert(coin_change(us, 0) == 0, "0 needs no coins")
assert(coin_change(us, 30) == 2, "30c = 25+5 = 2")
assert(coin_change([1, 2, 5], 11) == 3, "11 = 5+5+1 = 3")
assert(coin_change([2], 3) == 0 - 1, "odd amount from only 2s is impossible")
print("PASS: coin change")

assert(can_make([1, 2, 5], 11) == 1, "11 is makeable")
assert(can_make([3, 7], 5) == 0, "5 not makeable from 3,7")
assert(can_make([3, 7], 10) == 1, "10 = 3+7 makeable")
print("PASS: can_make")

// classic knapsack: cap 7, items (w,v) = (1,1)(3,4)(4,5)(5,7)
let weights = [1, 3, 4, 5]
let values = [1, 4, 5, 7]
assert(knapsack(weights, values, 7) == 9, "best fit = items 3+4 (w7) -> v 4+5 = 9")
assert(knapsack(weights, values, 0) == 0, "no capacity -> 0 value")
assert(knapsack(weights, values, 1) == 1, "cap 1 -> only item (1,1)")
assert(knapsack(weights, values, 6) == 8, "cap 6 -> best = (1,1)+(5,7) = 8")
print("PASS: 0/1 knapsack")

print("ALL PASS: dpx — coin change + knapsack DP")
