// ============================================================================
// NOVA Standard Library — algx module (generic functional algorithms)
// ============================================================================
// Higher-order list algorithms that complement collx (take/drop/chunk/zip/unique/
// windows). Every function is total and takes ordinary callables (closures or fn
// references) — NOVA's first-class functions, no special syntax. Predicates return
// truthy/falsy; key functions for group_by return string keys (dicts are string-keyed).

// take_while(xs, pred): leading run of elements satisfying pred.
fn take_while(xs, pred)
    let out = []
    for x in xs
        if pred(x)
            push(out, x)
        else
            return out
    return out

// drop_while(xs, pred): xs with the leading pred-run removed.
fn drop_while(xs, pred)
    let out = []
    let dropping = 1
    for x in xs
        if dropping == 1 and pred(x)
            dropping = 1
        else
            dropping = 0
            push(out, x)
    return out

// partition(xs, pred): [elements where pred is true, elements where it is false].
fn partition(xs, pred)
    let yes = []
    let no = []
    for x in xs
        if pred(x)
            push(yes, x)
        else
            push(no, x)
    return [yes, no]

// find_index(xs, target): first index of target (structural ==), or -1 if absent.
fn find_index(xs, target) -> int
    let i = 0
    let n = len(xs)
    while i < n
        if xs[i] == target
            return i
        i = i + 1
    return -1

// count_by(xs, pred): how many elements satisfy pred.
fn count_by(xs, pred) -> int
    let c = 0
    for x in xs
        if pred(x)
            c = c + 1
    return c

// zip_with(a, b, f): elementwise f(a[i], b[i]) up to the shorter length.
fn zip_with(a, b, f)
    let out = []
    let n = len(a)
    if len(b) < n
        n = len(b)
    let i = 0
    while i < n
        push(out, f(a[i], b[i]))
        i = i + 1
    return out

// flat_map(xs, f): apply f (which returns a list) to each element, concatenated.
fn flat_map(xs, f)
    let out = []
    for x in xs
        let sub = f(x)
        for y in sub
            push(out, y)
    return out

// scan(xs, f, init): running fold — out[0]=init, out[i+1]=f(out[i], xs[i]).
// Length is len(xs)+1 (includes the seed), like a prefix-sum with the identity.
fn scan(xs, f, init)
    let out = [init]
    let acc = init
    for x in xs
        acc = f(acc, x)
        push(out, acc)
    return out

// group_by(xs, keyfn): dict mapping keyfn(x) (a STRING) -> list of matching elements,
// preserving encounter order within each group.
fn group_by(xs, keyfn)
    let d = {}
    for x in xs
        let k = keyfn(x)
        if k in d
            push(d[k], x)
        else
            d[k] = [x]
    return d

// intersperse(xs, sep): sep inserted between adjacent elements.
fn intersperse(xs, sep)
    let out = []
    let first = 1
    for x in xs
        if first == 0
            push(out, sep)
        push(out, x)
        first = 0
    return out

// ── tests ────────────────────────────────────────────────────────────────────

fn _is_pos(x) -> int
    if x > 0
        return 1
    return 0

fn _add(a, b) -> int
    return a + b

fn _dup(x)
    return [x, x]

fn _parity(x) -> str
    if x % 2 == 0
        return "even"
    return "odd"

fn main()
    assert_eq(take_while([1, 2, 3, -1, 4], _is_pos), [1, 2, 3])
    assert_eq(take_while([-1, 2, 3], _is_pos), [])
    assert_eq(drop_while([1, 2, -3, 4], _is_pos), [-3, 4])
    assert_eq(drop_while([1, 2, 3], _is_pos), [])

    let parts = partition([1, -2, 3, -4, 5], _is_pos)
    assert_eq(parts[0], [1, 3, 5])
    assert_eq(parts[1], [-2, -4])

    assert_eq(find_index([10, 20, 30], 20), 1)
    assert_eq(find_index([10, 20, 30], 99), -1)
    assert_eq(find_index(["a", "b", "c"], "c"), 2)

    assert_eq(count_by([1, -1, 2, -2, 3], _is_pos), 3)

    assert_eq(zip_with([1, 2, 3], [10, 20, 30], _add), [11, 22, 33])
    assert_eq(zip_with([1, 2], [10, 20, 30], _add), [11, 22])    // shorter wins

    assert_eq(flat_map([1, 2, 3], _dup), [1, 1, 2, 2, 3, 3])

    assert_eq(scan([1, 2, 3, 4], _add, 0), [0, 1, 3, 6, 10])     // prefix sums

    let g = group_by([1, 2, 3, 4, 5], _parity)
    assert_eq(g["odd"], [1, 3, 5])
    assert_eq(g["even"], [2, 4])

    assert_eq(intersperse([1, 2, 3], 0), [1, 0, 2, 0, 3])
    assert_eq(intersperse([7], 0), [7])
    assert_eq(intersperse([], 0), [])

    print("algx_test passed")
