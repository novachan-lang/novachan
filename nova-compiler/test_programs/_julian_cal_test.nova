// KAT for std/calendar/julian_cal
// Tests: julian_is_leap, julian_to_jdn, jdn_to_julian, round-trips,
//        Gregorian/Julian 13-day difference for 21st-century dates.
import std/calendar/julian_cal

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _julian_cal_test " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL _julian_cal_test " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // ── julian_is_leap ────────────────────────────────────────────────────
    // Julian: every year divisible by 4 is a leap year — no century exception
    ckb("leap-1900-julian", julian_is_leap(1900), true)   // KEY: true in Julian (no century rule)
    ckb("leap-2000", julian_is_leap(2000), true)
    ckb("leap-2024", julian_is_leap(2024), true)
    ckb("leap-2023", julian_is_leap(2023), false)
    ckb("leap-1800", julian_is_leap(1800), true)   // Julian leap; Gregorian non-leap
    ckb("leap-1700", julian_is_leap(1700), true)   // Julian leap; Gregorian non-leap
    ckb("leap-0004", julian_is_leap(4), true)
    ckb("leap-0001", julian_is_leap(1), false)

    // ── julian_to_jdn: proleptic Julian epoch ────────────────────────────
    // Julian Day 1 Jan 1 AD (Julian calendar) = JDN 1721424
    cki("jdn-epoch-1-1-1", julian_to_jdn(1, 1, 1), 1721424)

    // Well-known anchors
    // Julian 1970-01-01 = JDN 2440601
    cki("jdn-1970-1-1", julian_to_jdn(1970, 1, 1), 2440601)

    // Julian 2000-01-01 = JDN 2451558
    // (Gregorian 2000-01-01 = JDN 2451545; diff = 13 days)
    cki("jdn-2000-1-1", julian_to_jdn(2000, 1, 1), 2451558)

    // Julian 1999-12-19 = JDN 2451545 (same JDN as Gregorian 2000-01-01)
    // This is the 13-day Julian->Gregorian offset in the 21st century:
    // The same calendar date in Julian maps to 13 days later in Gregorian.
    cki("jdn-1999-12-19", julian_to_jdn(1999, 12, 19), 2451545)

    // 13-day Julian-Gregorian difference in 21st century:
    // julian_to_jdn(2026,3,1) - greg_to_jdn(2026,3,1) = 13
    // greg_to_jdn(2026,3,1) = 2461101 (well-known)
    // julian_to_jdn(2026,3,1) = 2461114
    let gjdn = 2461101
    let jjdn = julian_to_jdn(2026, 3, 1)
    let diff = jjdn - gjdn
    cki("13day-diff-21stC", diff, 13)

    // Last day of Julian calendar before Gregorian reform (1582-10-04)
    // JDN = 2299160 (well-known historical date)
    cki("jdn-1582-10-4", julian_to_jdn(1582, 10, 4), 2299160)

    // ── jdn_to_julian: round-trips ────────────────────────────────────────
    let rt1 = jdn_to_julian(1721424)
    cki("rt-epoch-y", rt1[0], 1)
    cki("rt-epoch-m", rt1[1], 1)
    cki("rt-epoch-d", rt1[2], 1)

    let rt2 = jdn_to_julian(2440601)
    cki("rt-1970-y", rt2[0], 1970)
    cki("rt-1970-m", rt2[1], 1)
    cki("rt-1970-d", rt2[2], 1)

    let rt3 = jdn_to_julian(2451558)
    cki("rt-2000-y", rt3[0], 2000)
    cki("rt-2000-m", rt3[1], 1)
    cki("rt-2000-d", rt3[2], 1)

    // Round-trip arbitrary dates
    let jdn_a = julian_to_jdn(1582, 10, 4)
    let rt4 = jdn_to_julian(jdn_a)
    cki("rt-1582-10-4-y", rt4[0], 1582)
    cki("rt-1582-10-4-m", rt4[1], 10)
    cki("rt-1582-10-4-d", rt4[2], 4)

    let jdn_b = julian_to_jdn(2024, 12, 25)
    let rt5 = jdn_to_julian(jdn_b)
    cki("rt-2024-12-25-y", rt5[0], 2024)
    cki("rt-2024-12-25-m", rt5[1], 12)
    cki("rt-2024-12-25-d", rt5[2], 25)

    // Round-trip leap-year date
    let jdn_c = julian_to_jdn(1900, 2, 29)  // valid in Julian (1900 is a Julian leap year)
    let rt6 = jdn_to_julian(jdn_c)
    cki("rt-1900-02-29-y", rt6[0], 1900)
    cki("rt-1900-02-29-m", rt6[1], 2)
    cki("rt-1900-02-29-d", rt6[2], 29)

    print("PASS _julian_cal_test")
