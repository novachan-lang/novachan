// KAT: std/data/sub_merge
import std/data/sub_merge

fn cki(label, got, want)
    if got != want
        print("FAIL sub_merge " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL sub_merge " + label + ": got=[" + got + "] want=[" + want + "]")
        exit(1)

// ── Helper: build cue ────────────────────────────────────────────────────────
fn mk(idx, s, e, txt) -> dict
    let d = {}
    d["index"] = idx
    d["start"] = s
    d["end"] = e
    d["text"] = txt
    d

// ── Test 1: sub_concat length ────────────────────────────────────────────────
let cA = mk(0, 1000, 4000, "A")
let cB = mk(1, 5000, 8000, "B")

let la = []
la.push(cA)
let lb = []
lb.push(cB)

let cat = sub_concat(la, lb)
cki("concat_len", len(cat), 2)
cki("concat_0_start", cat[0]["start"], 1000)
cki("concat_1_start", cat[1]["start"], 5000)
cks("concat_0_text",  cat[0]["text"],  "A")
cks("concat_1_text",  cat[1]["text"],  "B")

// ── Test 2: sub_concat empty lists ───────────────────────────────────────────
let empty_cat = sub_concat([], [])
cki("concat_empty_len", len(empty_cat), 0)

let cat_lonly = sub_concat(la, [])
cki("concat_left_only", len(cat_lonly), 1)

let cat_ronly = sub_concat([], lb)
cki("concat_right_only", len(cat_ronly), 1)

// ── Test 3: sub_merge_overlaps — overlapping cues merge ──────────────────────
// 1000-4000 and 3000-6000 overlap → should produce 1 cue 1000-6000
let ov0 = mk(0, 1000, 4000, "Line1")
let ov1 = mk(1, 3000, 6000, "Line2")
let overlapping = []
overlapping.push(ov0)
overlapping.push(ov1)

let merged = sub_merge_overlaps(overlapping)
cki("merge_overlap_len",   len(merged),        1)
cki("merge_overlap_start", merged[0]["start"], 1000)
cki("merge_overlap_end",   merged[0]["end"],   6000)
let expect_txt = "Line1" + chr(10) + "Line2"
cks("merge_overlap_text",  merged[0]["text"],  expect_txt)

// ── Test 4: sub_merge_overlaps — touching (adjacent) merge ───────────────────
// end of first == start of second → touching → merge
let t0 = mk(0, 1000, 3000, "T1")
let t1 = mk(1, 3000, 5000, "T2")
let touching = []
touching.push(t0)
touching.push(t1)

let tmerged = sub_merge_overlaps(touching)
cki("merge_touch_len",   len(tmerged),        1)
cki("merge_touch_start", tmerged[0]["start"], 1000)
cki("merge_touch_end",   tmerged[0]["end"],   5000)

// ── Test 5: sub_merge_overlaps — non-overlapping stay separate ───────────────
let n0 = mk(0, 1000, 2000, "N1")
let n1 = mk(1, 3000, 4000, "N2")
let nonoverlap = []
nonoverlap.push(n0)
nonoverlap.push(n1)

let nomerged = sub_merge_overlaps(nonoverlap)
cki("merge_nonoverlap_len",    len(nomerged),        2)
cki("merge_nonoverlap_0_end",  nomerged[0]["end"],   2000)
cki("merge_nonoverlap_1_start", nomerged[1]["start"], 3000)

// ── Test 6: sub_merge_overlaps empty input ───────────────────────────────────
let empty_merge = sub_merge_overlaps([])
cki("merge_empty_len", len(empty_merge), 0)

// ── Test 7: sub_merge_overlaps single cue ────────────────────────────────────
let single_list = []
single_list.push(mk(0, 500, 1500, "Solo"))
let single_merged = sub_merge_overlaps(single_list)
cki("merge_single_len",   len(single_merged),        1)
cki("merge_single_start", single_merged[0]["start"], 500)
cki("merge_single_end",   single_merged[0]["end"],   1500)

// ── Test 8: sub_dedup removes identical consecutive cues ─────────────────────
let d0 = mk(0, 1000, 3000, "Dup")
let d1 = mk(1, 1000, 3000, "Dup")
let d2 = mk(2, 5000, 7000, "Other")

let dups = []
dups.push(d0)
dups.push(d1)
dups.push(d2)

let deduped = sub_dedup(dups)
cki("dedup_len",    len(deduped),        2)
cks("dedup_0_text", deduped[0]["text"],  "Dup")
cks("dedup_1_text", deduped[1]["text"],  "Other")
cki("dedup_1_idx",  deduped[1]["index"], 1)

// ── Test 9: sub_dedup non-consecutive duplicates kept ────────────────────────
let nc0 = mk(0, 1000, 2000, "X")
let nc1 = mk(1, 3000, 4000, "Y")
let nc2 = mk(2, 5000, 6000, "X")
let nc_list = []
nc_list.push(nc0)
nc_list.push(nc1)
nc_list.push(nc2)

let nc_deduped = sub_dedup(nc_list)
cki("nonconsec_len",    len(nc_deduped), 3)
cks("nonconsec_2_text", nc_deduped[2]["text"], "X")

// ── Test 10: sub_dedup empty input ───────────────────────────────────────────
let empty_dedup = sub_dedup([])
cki("dedup_empty_len", len(empty_dedup), 0)

// ── Test 11: sub_dedup single cue unchanged ──────────────────────────────────
let solo_dd = []
solo_dd.push(mk(0, 100, 200, "Solo"))
let solo_deduped = sub_dedup(solo_dd)
cki("dedup_solo_len",   len(solo_deduped),        1)
cks("dedup_solo_text",  solo_deduped[0]["text"],  "Solo")

print("PASS _sub_merge_test")
