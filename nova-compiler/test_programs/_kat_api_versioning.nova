import forge_api_versioning

fn main()
    let av = apiv_new()
    av = apiv_register(av, "v1", "deprecated")
    av = apiv_register(av, "v2", "current")
    av = apiv_register(av, "v3", "beta")

    assert(apiv_current(av) == "v2", "current=v2")

    let versions = apiv_list_versions(av)
    assert(len(versions) == 3, "3 versions")

    av = apiv_add_endpoint(av, "v2", "GET", "/users")
    av = apiv_add_endpoint(av, "v2", "POST", "/users")
    av = apiv_add_endpoint(av, "v2", "GET", "/users/id")
    assert(apiv_endpoint_count(av, "v2") == 3, "v2 has 3 endpoints")
    assert(apiv_endpoint_count(av, "v1") == 0, "v1 has 0 endpoints")

    av = apiv_deprecate(av, "v1", "2026-12-31")
    assert(apiv_is_deprecated(av, "v1") == true, "v1 deprecated")
    assert(apiv_is_deprecated(av, "v2") == false, "v2 not deprecated")

    assert(apiv_resolve(av, "v2") == "v2", "resolve v2")
    assert(apiv_resolve(av, "v1") == "v1", "resolve v1 (deprecated but not retired)")
    assert(apiv_resolve(av, "v99") == "v2", "resolve unknown falls to current")

    print("API-VERSIONING KAT PASS")
