fn rgb_to_hsl(r, g, b)
  let rf = r * 1.0 / 255.0
  let gf = g * 1.0 / 255.0
  let bf = b * 1.0 / 255.0
  let mx = rf
  if gf > mx
    mx = gf
  if bf > mx
    mx = bf
  let mn = rf
  if gf < mn
    mn = gf
  if bf < mn
    mn = bf
  let l = (mx + mn) / 2.0
  if mx == mn
    return [0, 0, int(l * 100.0)]
  let d = mx - mn
  let s = d / (1.0 - abs(2.0 * l - 1.0))
  let h = 0.0
  if mx == rf
    h = 60.0 * (((gf - bf) / d) % 6.0)
  else if mx == gf
    h = 60.0 * ((bf - rf) / d + 2.0)
  else
    h = 60.0 * ((rf - gf) / d + 4.0)
  if h < 0.0
    h = h + 360.0
  [int(h), int(s * 100.0), int(l * 100.0)]

fn rgb_to_hex(r, g, b)
  let hex = "0123456789abcdef"
  let out = "#"
  out = out + slice(hex, r / 16, r / 16 + 1) + slice(hex, r % 16, r % 16 + 1)
  out = out + slice(hex, g / 16, g / 16 + 1) + slice(hex, g % 16, g % 16 + 1)
  out = out + slice(hex, b / 16, b / 16 + 1) + slice(hex, b % 16, b % 16 + 1)
  out

fn grayscale(r, g, b)
  int(0.299 * r + 0.587 * g + 0.114 * b)

fn invert_rgb(r, g, b)
  [255 - r, 255 - g, 255 - b]

fn main()
  let hsl = rgb_to_hsl(255, 0, 0)
  assert(hsl[0] == 0, "red hue = 0")
  assert(hsl[2] == 50, "red lightness = 50")

  let hsl_g = rgb_to_hsl(0, 255, 0)
  assert(hsl_g[0] == 120, "green hue = 120")

  let hsl_w = rgb_to_hsl(255, 255, 255)
  assert(hsl_w[2] == 100, "white lightness = 100")

  assert(rgb_to_hex(255, 0, 0) == "#ff0000", "red hex")
  assert(rgb_to_hex(0, 255, 0) == "#00ff00", "green hex")
  assert(rgb_to_hex(0, 0, 0) == "#000000", "black hex")
  assert(rgb_to_hex(255, 255, 255) == "#ffffff", "white hex")

  let gray = grayscale(255, 0, 0)
  assert(gray > 70 and gray < 80, "red grayscale ~76")

  let inv = invert_rgb(255, 128, 0)
  assert(inv[0] == 0, "invert r")
  assert(inv[1] == 127, "invert g")
  assert(inv[2] == 255, "invert b")

  print("colorconvx: all passed")
