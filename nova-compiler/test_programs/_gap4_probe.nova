fn main()
    let items = [3, 1, 4, 1, 5, 9, 2, 6]
    let sorted = sort(items)
    print(sorted)
    let doubled = [x * 2 for x in items]
    print(doubled)
    let evens = [x for x in items if x % 2 == 0]
    print(evens)
    let total = sum(items)
    print("total: {total}")
    let result = reduce(items, fn(acc, x) acc + x, 0)
    print("reduce: {result}")
    let s = "  hello world  "
    print(lstrip(rstrip(s)))
    print(upper("hello"))
    print(lower("HELLO"))
    let d = {"a": 1, "b": 2}
    let k = keys(d)
    print(k)
    let v = values(d)
    print(v)
    let mapped = [x * x for x in 1..6]
    print("squares: {mapped}")
