import std/io/bytebuffer

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + got + " want " + want)
        exit(1)

// KAT 1: bb_write_byte + bb_write_u16_le + bb_len
// 258 = 0x0102, little-endian => [0x02, 0x01]
let bb = bb_new()
bb_write_byte(bb, 65)
bb_write_u16_le(bb, 258)
cki("kat1_len", bb_len(bb), 3)

let raw = bb_to_bytes(bb)
cki("kat1_byte0", bytes_get(raw, 0), 65)
cki("kat1_byte1", bytes_get(raw, 1), 2)
cki("kat1_byte2", bytes_get(raw, 2), 1)

// KAT 2: read cursor round-trip
bb_reset_read(bb)
cki("kat2_read_byte", bb_read_byte(bb), 65)
cki("kat2_read_u16_le", bb_read_u16_le(bb), 258)
cki("kat2_remaining", bb_remaining(bb), 0)

// KAT 3: read past end returns -1
cki("kat3_past_end", bb_read_byte(bb), -1)

// KAT 4: bb_write_str then read bytes ('A'=65, 'B'=66)
let bb2 = bb_new()
bb_write_str(bb2, "AB")
cki("kat4_len", bb_len(bb2), 2)
bb_reset_read(bb2)
cki("kat4_read_A", bb_read_byte(bb2), 65)
cki("kat4_read_B", bb_read_byte(bb2), 66)
cki("kat4_remaining", bb_remaining(bb2), 0)

// KAT 5: bb_write_u32_le(1) => bytes [1,0,0,0]
let bb3 = bb_new()
bb_write_u32_le(bb3, 1)
cki("kat5_len", bb_len(bb3), 4)
let raw3 = bb_to_bytes(bb3)
cki("kat5_byte0", bytes_get(raw3, 0), 1)
cki("kat5_byte1", bytes_get(raw3, 1), 0)
cki("kat5_byte2", bytes_get(raw3, 2), 0)
cki("kat5_byte3", bytes_get(raw3, 3), 0)

// KAT 6: bb_write_u32_le(0x01020304) => [4,3,2,1] little-endian
let bb4 = bb_new()
bb_write_u32_le(bb4, 0x01020304)
let raw4 = bb_to_bytes(bb4)
cki("kat6_byte0", bytes_get(raw4, 0), 4)
cki("kat6_byte1", bytes_get(raw4, 1), 3)
cki("kat6_byte2", bytes_get(raw4, 2), 2)
cki("kat6_byte3", bytes_get(raw4, 3), 1)

// KAT 7: bb_write_bytes from native bytes value ('X'=88, 'Y'=89)
let bb5 = bb_new()
let src = str_to_bytes("XY")
bb_write_bytes(bb5, src)
cki("kat7_len", bb_len(bb5), 2)
let raw5 = bb_to_bytes(bb5)
cki("kat7_byte0", bytes_get(raw5, 0), 88)
cki("kat7_byte1", bytes_get(raw5, 1), 89)

// KAT 8: bb_remaining mid-read
let bb6 = bb_new()
bb_write_byte(bb6, 10)
bb_write_byte(bb6, 20)
bb_write_byte(bb6, 30)
bb_reset_read(bb6)
cki("kat8_rem_before", bb_remaining(bb6), 3)
bb_read_byte(bb6)
cki("kat8_rem_after1", bb_remaining(bb6), 2)
bb_read_byte(bb6)
cki("kat8_rem_after2", bb_remaining(bb6), 1)

print("_bytebuffer_test passed")
