import std/color/cmyk

// Helper: check int equality
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// Helper: check int list equality (len 4)
fn ck4(label: string, got: list, want: list)
    let i = 0
    while i < 4
        let g = got[i]
        let w = want[i]
        if g != w
            print("FAIL " + label + "[" + str(i) + "]: got " + str(g) + " want " + str(w))
            exit(1)
        i = i + 1

// Helper: check int list equality (len 3)
fn ck3(label: string, got: list, want: list)
    let i = 0
    while i < 3
        let g = got[i]
        let w = want[i]
        if g != w
            print("FAIL " + label + "[" + str(i) + "]: got " + str(g) + " want " + str(w))
            exit(1)
        i = i + 1

// Helper: abs diff for round-trip tolerance check (int)
fn abs_diff(a: int, b: int) -> int
    let d = a - b
    if d < 0
        d = 0 - d
    d

fn main()
    // KAT 1: pure red [255,0,0] -> [0,100,100,0]
    let red_in = [255, 0, 0]
    let red_cmyk = cmyk_from_rgb(red_in)
    ck4("from_rgb_red", red_cmyk, [0, 100, 100, 0])

    // KAT 2: pure black [0,0,0] -> [0,0,0,100]
    let black_in = [0, 0, 0]
    let black_cmyk = cmyk_from_rgb(black_in)
    ck4("from_rgb_black", black_cmyk, [0, 0, 0, 100])

    // KAT 3: pure white [255,255,255] -> [0,0,0,0]
    let white_in = [255, 255, 255]
    let white_cmyk = cmyk_from_rgb(white_in)
    ck4("from_rgb_white", white_cmyk, [0, 0, 0, 0])

    // KAT 4: pure green [0,255,0] -> [100,0,100,0]
    let green_in = [0, 255, 0]
    let green_cmyk = cmyk_from_rgb(green_in)
    ck4("from_rgb_green", green_cmyk, [100, 0, 100, 0])

    // KAT 5: pure blue [0,0,255] -> [100,100,0,0]
    let blue_in = [0, 0, 255]
    let blue_cmyk = cmyk_from_rgb(blue_in)
    ck4("from_rgb_blue", blue_cmyk, [100, 100, 0, 0])

    // KAT 6: cmyk_to_rgb(0,100,100,0) -> [255,0,0]
    let red_rgb = cmyk_to_rgb(0, 100, 100, 0)
    ck3("to_rgb_red", red_rgb, [255, 0, 0])

    // KAT 7: cmyk_to_rgb(0,0,0,100) -> [0,0,0]
    let black_rgb = cmyk_to_rgb(0, 0, 0, 100)
    ck3("to_rgb_black", black_rgb, [0, 0, 0])

    // KAT 8: round-trip white [255,255,255]
    let white_rt_cmyk = cmyk_from_rgb([255, 255, 255])
    let white_rt_rgb = cmyk_to_rgb(white_rt_cmyk[0], white_rt_cmyk[1], white_rt_cmyk[2], white_rt_cmyk[3])
    let wr = abs_diff(white_rt_rgb[0], 255)
    let wg = abs_diff(white_rt_rgb[1], 255)
    let wb = abs_diff(white_rt_rgb[2], 255)
    if wr > 2
        print("FAIL round_trip_white R: " + str(white_rt_rgb[0]))
        exit(1)
    if wg > 2
        print("FAIL round_trip_white G: " + str(white_rt_rgb[1]))
        exit(1)
    if wb > 2
        print("FAIL round_trip_white B: " + str(white_rt_rgb[2]))
        exit(1)

    // KAT 9: round-trip mid-grey [128,128,128]
    let grey_in = [128, 128, 128]
    let grey_cmyk = cmyk_from_rgb(grey_in)
    let grey_rt = cmyk_to_rgb(grey_cmyk[0], grey_cmyk[1], grey_cmyk[2], grey_cmyk[3])
    let dr = abs_diff(grey_rt[0], 128)
    let dg = abs_diff(grey_rt[1], 128)
    let db = abs_diff(grey_rt[2], 128)
    if dr > 2
        print("FAIL round_trip_grey R: " + str(grey_rt[0]))
        exit(1)
    if dg > 2
        print("FAIL round_trip_grey G: " + str(grey_rt[1]))
        exit(1)
    if db > 2
        print("FAIL round_trip_grey B: " + str(grey_rt[2]))
        exit(1)

    // KAT 10: round-trip orange [255,128,0]
    let orange_in = [255, 128, 0]
    let orange_cmyk = cmyk_from_rgb(orange_in)
    let orange_rt = cmyk_to_rgb(orange_cmyk[0], orange_cmyk[1], orange_cmyk[2], orange_cmyk[3])
    let or_diff = abs_diff(orange_rt[0], 255)
    let og_diff = abs_diff(orange_rt[1], 128)
    let ob_diff = abs_diff(orange_rt[2], 0)
    if or_diff > 2
        print("FAIL round_trip_orange R: " + str(orange_rt[0]))
        exit(1)
    if og_diff > 2
        print("FAIL round_trip_orange G: " + str(orange_rt[1]))
        exit(1)
    if ob_diff > 2
        print("FAIL round_trip_orange B: " + str(orange_rt[2]))
        exit(1)

    print("_cmyk_test passed")
