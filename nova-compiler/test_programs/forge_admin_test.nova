// Forge S12: auto-CRUD admin over forge_db. Tests the CRUD logic + escaped HTML render directly over a
// sqlite pool (the route closures are thin wrappers over these). Real sqlite, socketless, deterministic.
import forge_db
import forge_admin

fn main()
    let pool = pool_open("_admin_test.db", 1)
    pool_query(pool, "DROP TABLE IF EXISTS users", [])
    pool_query(pool, "CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT)", [])

    // create
    let f1 = {}
    f1["name"] = "alice"
    admin_create(pool, "users", ["name"], f1)

    // list shows the created row
    let h = admin_list_html(pool, "users", ["name"])
    if find(h, "alice") < 0
        print("FAIL: list should show the created row")
        exit(1)

    // form has an input for the column
    if find(admin_render_form("users", ["name"]), "name") < 0
        print("FAIL: form should have an input for each column")
        exit(1)

    // XSS-safety: a value with markup is HTML-escaped
    let f2 = {}
    f2["name"] = "<script>"
    admin_create(pool, "users", ["name"], f2)
    let h2 = admin_list_html(pool, "users", ["name"])
    if find(h2, "<script>") >= 0
        print("FAIL: a value must be HTML-escaped (no raw <script>)")
        exit(1)
    if find(h2, "&lt;script&gt;") < 0
        print("FAIL: escaped value missing")
        exit(1)

    // delete removes a row
    let rows = db_all(pool, "users")
    let before = len(rows)
    admin_delete(pool, "users", rows[0]["id"])
    if len(db_all(pool, "users")) != before - 1
        print("FAIL: delete should remove exactly one row")
        exit(1)

    print("PASS forge_admin (auto-CRUD: create/list/delete over forge_db + escaped HTML render)")
