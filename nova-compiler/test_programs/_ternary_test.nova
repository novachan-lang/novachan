fn main()
    let x = 5
    let label = "big" if x > 3 else "small"
    assert_eq(label, "big")

    let y = 1
    let label2 = "big" if y > 3 else "small"
    assert_eq(label2, "small")

    let val = x * 2 if x > 10 else x * 3
    assert_eq(val, 15)

    let nested = "A" if x > 10 else "B" if x > 3 else "C"
    assert_eq(nested, "B")

    let in_call = str(100 if x > 3 else 0)
    assert_eq(in_call, "100")

    let xs = [1, 2, 3, 4, 5]
    let mapped = [x * 2 if x > 3 else x for x in xs]
    assert_eq(mapped[0], 1)
    assert_eq(mapped[1], 2)
    assert_eq(mapped[2], 3)
    assert_eq(mapped[3], 8)
    assert_eq(mapped[4], 10)

    let prefix = if x > 3 "yes" else "no"
    assert_eq(prefix, "yes")

    print("ternary_test: all passed")
