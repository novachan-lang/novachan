import forge_bittransform as bt

fn check(cond: bool, label: string)
    if cond == false
        print("FAIL: " + label)

fn lcg(state: int) -> int
    (state * 1103515245 + 12345) % 2147483648

// brute-force XOR convolution
fn brute_xor(a: list, b: list) -> list
    let n = len(a)
    let c = []
    let z = 0
    while z < n
        push(c, 0)
        z = z + 1
    let i = 0
    while i < n
        let j = 0
        while j < n
            c[i ^ j] = c[i ^ j] + a[i] * b[j]
            j = j + 1
        i = i + 1
    c

fn brute_or(a: list, b: list) -> list
    let n = len(a)
    let c = []
    let z = 0
    while z < n
        push(c, 0)
        z = z + 1
    let i = 0
    while i < n
        let j = 0
        while j < n
            c[i | j] = c[i | j] + a[i] * b[j]
            j = j + 1
        i = i + 1
    c

fn brute_and(a: list, b: list) -> list
    let n = len(a)
    let c = []
    let z = 0
    while z < n
        push(c, 0)
        z = z + 1
    let i = 0
    while i < n
        let j = 0
        while j < n
            c[i & j] = c[i & j] + a[i] * b[j]
            j = j + 1
        i = i + 1
    c

fn eq(a: list, b: list) -> bool
    let out = len(a) == len(b)
    if out
        let i = 0
        while i < len(a)
            if a[i] != b[i]
                out = false
            i = i + 1
    out

fn main()
    // ---- FWHT inverse recovers the input ----
    let orig = [1, 2, 3, 4, 5, 6, 7, 8]
    let t = bt.fwht(bt.fwht([1, 2, 3, 4, 5, 6, 7, 8], false), true)
    check(eq(t, orig), "fwht then inverse == identity")

    // ---- zeta then mobius == identity ----
    let orig2 = [3, 1, 4, 1, 5, 9, 2, 6]
    let zm = bt.mobius_transform(bt.zeta_transform([3, 1, 4, 1, 5, 9, 2, 6]))
    check(eq(zm, orig2), "zeta then mobius == identity")

    // zeta of [1,1,1,1] (2 bits) -> subset sums: mask0=1, mask1=1+1=2, mask2=1+1=2, mask3=1+1+1+1=4
    check(eq(bt.zeta_transform([1, 1, 1, 1]), [1, 2, 2, 4]), "zeta all-ones 2 bits")

    // ---- convolutions vs brute force over many random arrays ----
    let st = 424242
    let trial = 0
    while trial < 40
        st = lcg(st)
        let bits = 1 + (st % 4)   // 1..4 bits -> length 2,4,8,16
        let n = 1
        let bb = 0
        while bb < bits
            n = n * 2
            bb = bb + 1
        let a = []
        let b = []
        let i = 0
        while i < n
            st = lcg(st)
            push(a, (st % 21) - 10)
            st = lcg(st)
            push(b, (st % 21) - 10)
            i = i + 1
        check(eq(bt.xor_convolution(a, b), brute_xor(a, b)), "xor conv trial " + str(trial))
        check(eq(bt.or_convolution(a, b), brute_or(a, b)), "or conv trial " + str(trial))
        check(eq(bt.and_convolution(a, b), brute_and(a, b)), "and conv trial " + str(trial))
        trial = trial + 1

    // ---- a concrete XOR convolution ----
    // a=[1,2,3,4], b=[5,6,7,8]; check against brute
    check(eq(bt.xor_convolution([1, 2, 3, 4], [5, 6, 7, 8]), brute_xor([1, 2, 3, 4], [5, 6, 7, 8])), "concrete xor conv")

    print("forge_bittransform: all passed")
