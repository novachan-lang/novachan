import forge_countdown_latch

fn main()
    let l = latch_new(3)
    assert(latch_remaining(l) == 3, "3 remaining")
    assert(latch_initial_count(l) == 3, "initial 3")
    assert(latch_is_released(l) == 0, "not released")
    assert(latch_progress(l) == 0, "0% progress")

    l = latch_countdown(l)
    assert(latch_remaining(l) == 2, "2 remaining")
    assert(latch_is_released(l) == 0, "not released at 2")
    assert(latch_progress(l) == 33, "33% progress")

    l = latch_countdown(l)
    assert(latch_remaining(l) == 1, "1 remaining")
    assert(latch_is_released(l) == 0, "not released at 1")

    l = latch_countdown(l)
    assert(latch_remaining(l) == 0, "0 remaining")
    assert(latch_is_released(l) == 1, "released!")
    assert(latch_progress(l) == 100, "100% progress")
    assert(latch_total_countdowns(l) == 3, "3 countdowns")

    l = latch_countdown(l)
    assert(latch_remaining(l) == 0, "still 0")
    assert(latch_total_countdowns(l) == 3, "no extra countdown")

    let l2 = latch_new(0)
    assert(latch_progress(l2) == 100, "0-latch = 100%")

    print("COUNTDOWN-LATCH KAT PASS")
