import forge_election_manager

fn main()
    let e = em_new()
    e = em_add_node(e, "node-a", 1)
    e = em_add_node(e, "node-b", 3)
    e = em_add_node(e, "node-c", 2)
    assert(em_node_count(e) == 3, "3 nodes")

    e = em_elect(e)
    assert(em_leader(e) == "node-b", "highest priority wins")
    assert(em_is_leader(e, "node-b") == 1, "b is leader")
    assert(em_election_count(e) == 1, "1 election")

    e = em_set_down(e, "node-b")
    assert(em_alive_count(e) == 2, "2 alive")
    e = em_elect(e)
    assert(em_leader(e) == "node-c", "c wins after b down")

    e = em_set_up(e, "node-b")
    e = em_elect(e)
    assert(em_leader(e) == "node-b", "b back as leader")
    assert(em_election_count(e) == 3, "3 elections")

    print("ELECTION-MANAGER KAT PASS")
