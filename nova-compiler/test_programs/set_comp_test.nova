fn main()
    // set literal (dedup)
    let s = {1, 2, 3, 2, 1}
    assert_eq(set_len(s), 3)
    assert(set_has(s, 2), "2 in s")
    assert(not set_has(s, 9), "9 not in s")

    // single-element set literal
    let one = {42}
    assert_eq(set_len(one), 1)

    // set comprehension
    let sq = {x * x for x in [1, 2, 3, 4]}
    assert_eq(set_len(sq), 4)
    assert(set_has(sq, 16), "16 in sq")
    assert(set_has(sq, 1), "1 in sq")

    // set comprehension with filter + dedup
    let evens = {x % 4 for x in [2, 4, 6, 8, 10] if x > 2}
    // x>2 -> 4,6,8,10 ; %4 -> 0,2,0,2 ; dedup -> {0,2}
    assert_eq(set_len(evens), 2)
    assert(set_has(evens, 0), "0")
    assert(set_has(evens, 2), "2")

    // empty braces still parse as empty dict (disambiguation preserved)
    let d = {}
    assert_eq(len(d), 0)

    // a real dict still works
    let m = {"a": 1, "b": 2}
    assert_eq(m["a"], 1)

    print("set_comp_test passed")
