// KAT for std/control/motionprofile -- trapezoidal motion profiles.
import std/control/motionprofile

fn approx(a: float, b: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    d < 0.001

fn ckf(label: string, got: float, want: float)
    if not approx(got, want)
        print("FAIL motionprofile " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        print("FAIL motionprofile " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // -- mp_trapezoid(distance=10, vmax=2, amax=1) --
    // t_accel = vmax/amax = 2.0; d_accel = 0.5*1*4 = 2.0
    // d_cruise = 10 - 4 = 6.0; t_cruise = 6/2 = 3.0
    // t_total = 2+3+2 = 7.0
    let p = mp_trapezoid(10.0, 2.0, 1.0)
    ckf("duration", mp_duration(p), 7.0)
    ckf("accel_time", mp_accel_time(p), 2.0)
    ckf("cruise_time", mp_cruise_time(p), 3.0)
    ckf("peak_vel", mp_peak_velocity(p), 2.0)
    ckf("total_distance", mp_total_distance(p), 10.0)

    // position checks
    ckf("pos t=0", mp_position(p, 0.0), 0.0)
    ckf("pos t=total", mp_position(p, 7.0), 10.0)
    // at t=1 (accel): 0.5*1*1 = 0.5
    ckf("pos t=1", mp_position(p, 1.0), 0.5)
    // at t=2 (end accel): 0.5*1*4 = 2.0
    ckf("pos t=2", mp_position(p, 2.0), 2.0)
    // at t=3.5 (cruise midpoint t_accel=2, t_cruise=3, cruise goes 2..5, mid=3.5):
    // d_accel=2 + 2*(3.5-2) = 2+3=5
    ckf("pos cruise mid", mp_position(p, 3.5), 5.0)

    // velocity at cruise middle (t=3.5)
    ckf("vel cruise", mp_velocity(p, 3.5), 2.0)
    // velocity at t=0
    ckf("vel t=0", mp_velocity(p, 0.0), 0.0)
    // velocity at end
    ckf("vel t=total", mp_velocity(p, 7.0), 0.0)

    // -- is_triangular --
    // distance=1, vmax=10, amax=1 -> d_min=10*10/1=100 >> 1 -> triangular
    ckb("is_triangular small", mp_is_triangular(1.0, 10.0, 1.0), true)
    // distance=10, vmax=2, amax=1 -> d_min=4 < 10 -> not triangular
    ckb("is_triangular normal", mp_is_triangular(10.0, 2.0, 1.0), false)

    // -- normalized position --
    ckf("normalized t=0", mp_position_normalized(p, 0.0), 0.0)
    ckf("normalized t=total", mp_position_normalized(p, 7.0), 1.0)

    // -- reverse --
    ckf("reverse t=0", mp_reverse(p, 0.0), 10.0)
    ckf("reverse t=total", mp_reverse(p, 7.0), 0.0)

    print("PASS _motionprofile_test")
