// KAT for std/text/diff_lcs
import std/text/diff_lcs

fn cki(label, got, want)
    if got != want
        print("FAIL diff_lcs " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL diff_lcs " + label + ": got [" + got + "] want [" + want + "]")
        exit(1)

fn main()
    // ── lcs_len: list-based ──────────────────────────────────────────────────
    // KAT 1: classic ABCBDAB / BDCAB  -> 4
    let a1 = []
    a1.push("A")
    a1.push("B")
    a1.push("C")
    a1.push("B")
    a1.push("D")
    a1.push("A")
    a1.push("B")
    let b1 = []
    b1.push("B")
    b1.push("D")
    b1.push("C")
    b1.push("A")
    b1.push("B")
    let r1 = lcs_len(a1, b1)
    cki("lcs_len ABCBDAB/BDCAB", r1, 4)

    // KAT 2: both empty -> 0
    let r2 = lcs_len([], [])
    cki("lcs_len empty/empty", r2, 0)

    // KAT 3: single-element match
    let xa = []
    xa.push("x")
    let xb = []
    xb.push("x")
    let r3 = lcs_len(xa, xb)
    cki("lcs_len [x]/[x]", r3, 1)

    // KAT 4: one empty
    let r4a = lcs_len(a1, [])
    cki("lcs_len a1/[]", r4a, 0)
    let r4b = lcs_len([], b1)
    cki("lcs_len []/b1", r4b, 0)

    // KAT 5: no common elements
    let p = []
    p.push("x")
    p.push("y")
    p.push("z")
    let q = []
    q.push("a")
    q.push("b")
    q.push("c")
    let r5 = lcs_len(p, q)
    cki("lcs_len disjoint", r5, 0)

    // KAT 6: identical lists
    let same = []
    same.push("a")
    same.push("b")
    same.push("c")
    let r6 = lcs_len(same, same)
    cki("lcs_len identical", r6, 3)

    // ── lcs: list reconstruction ─────────────────────────────────────────────
    // KAT 7: lcs of a1/b1 must have length 4
    let lcs7 = lcs(a1, b1)
    let l7 = len(lcs7)
    cki("lcs len ABCBDAB/BDCAB", l7, 4)

    // KAT 8: lcs of empty lists -> empty list
    let lcs8 = lcs([], [])
    let l8 = len(lcs8)
    cki("lcs empty/empty len", l8, 0)

    // KAT 9: lcs of identical -> same list
    let lcs9 = lcs(same, same)
    let l9 = len(lcs9)
    cki("lcs identical len", l9, 3)
    cks("lcs identical[0]", lcs9[0], "a")
    cks("lcs identical[1]", lcs9[1], "b")
    cks("lcs identical[2]", lcs9[2], "c")

    // KAT 10: lcs of disjoint -> empty
    let lcs10 = lcs(p, q)
    let l10 = len(lcs10)
    cki("lcs disjoint len", l10, 0)

    // KAT 11: round-trip — lcs elements must appear in order in both a and b
    // (verify each element of lcs7 is a subsequence of a1 and b1)
    let ai = 0
    let li = 0
    let llen = len(lcs7)
    while li < llen
        let elem = lcs7[li]
        let found = 0
        while ai < len(a1) and found == 0
            if a1[ai] == elem
                found = 1
            ai = ai + 1
        cki("lcs7 subsequence-of-a1 elem " + str(li), found, 1)
        li = li + 1
    let bii = 0
    let li2 = 0
    while li2 < llen
        let elem2 = lcs7[li2]
        let found2 = 0
        while bii < len(b1) and found2 == 0
            if b1[bii] == elem2
                found2 = 1
            bii = bii + 1
        cki("lcs7 subsequence-of-b1 elem " + str(li2), found2, 1)
        li2 = li2 + 1

    // ── lcs_str: string-based ────────────────────────────────────────────────
    // KAT 12: classic strings — must be length 4
    let s12 = lcs_str("ABCBDAB", "BDCAB")
    let sl12 = len(s12)
    cki("lcs_str ABCBDAB/BDCAB len", sl12, 4)

    // KAT 13: lcs_str identical -> same string
    let s13 = lcs_str("abc", "abc")
    cks("lcs_str abc/abc", s13, "abc")

    // KAT 14: lcs_str disjoint -> empty
    let s14 = lcs_str("abc", "xyz")
    cks("lcs_str abc/xyz", s14, "")

    // KAT 15: one empty
    let s15a = lcs_str("", "abc")
    cks("lcs_str empty/abc", s15a, "")
    let s15b = lcs_str("abc", "")
    cks("lcs_str abc/empty", s15b, "")

    // KAT 16: both empty
    let s16 = lcs_str("", "")
    cks("lcs_str empty/empty", s16, "")

    // KAT 17: single matching char
    let s17 = lcs_str("A", "A")
    cks("lcs_str A/A", s17, "A")

    // KAT 18: single non-matching char
    let s18 = lcs_str("A", "B")
    cks("lcs_str A/B", s18, "")

    // KAT 19: round-trip for lcs_str — every char of result appears in order in a and b
    let s19 = lcs_str("ABCBDAB", "BDCAB")
    let orig_a = "ABCBDAB"
    let orig_b = "BDCAB"
    let si = 0
    let ai19 = 0
    let slen = len(s19)
    while si < slen
        let ch = s19[si]
        let found19 = 0
        while ai19 < len(orig_a) and found19 == 0
            if orig_a[ai19] == ch
                found19 = 1
            ai19 = ai19 + 1
        cki("lcs_str subseq a " + str(si), found19, 1)
        si = si + 1
    let bi19 = 0
    let si2 = 0
    while si2 < slen
        let ch2 = s19[si2]
        let found19b = 0
        while bi19 < len(orig_b) and found19b == 0
            if orig_b[bi19] == ch2
                found19b = 1
            bi19 = bi19 + 1
        cki("lcs_str subseq b " + str(si2), found19b, 1)
        si2 = si2 + 1

    // KAT 20: int list LCS
    let ia = []
    ia.push(1)
    ia.push(3)
    ia.push(4)
    ia.push(5)
    ia.push(6)
    ia.push(7)
    ia.push(2)
    let ib = []
    ib.push(1)
    ib.push(2)
    ib.push(3)
    ib.push(5)
    ib.push(8)
    let rl20 = lcs_len(ia, ib)
    // LCS of [1,3,4,5,6,7,2] and [1,2,3,5,8]:
    // Known LCS: [1,3,5] = length 3
    cki("lcs_len int lists", rl20, 3)

    print("PASS _diff_lcs_test")
