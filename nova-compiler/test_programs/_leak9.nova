fn make_garbage()
    let x = []
    push(x, 1)
    push(x, 2)
    push(x, 3)
    let d = {}
    d["a"] = 1
    d["b"] = 2
    len(x) + len(keys(d))

fn main()
    let i = 0
    let total = 0
    while i < 3000000
        total = total + make_garbage()
        i = i + 1
    print("total=" + str(total))
