import std/net/mqtt_fixed

fn main()
    // ── KAT 1: mqtt_remlen_encode(0) == [0] ─────────────────────────────────
    let r0 = mqtt_remlen_encode(0)
    if len(r0) != 1
        print("FAIL mqtt_fixed remlen_encode(0) len: got "+str(len(r0))+" want 1")
        exit(1)
    if r0[0] != 0
        print("FAIL mqtt_fixed remlen_encode(0) byte: got "+str(r0[0])+" want 0")
        exit(1)

    // ── KAT 2: mqtt_remlen_encode(127) == [127] ──────────────────────────────
    let r127 = mqtt_remlen_encode(127)
    if len(r127) != 1
        print("FAIL mqtt_fixed remlen_encode(127) len: got "+str(len(r127))+" want 1")
        exit(1)
    if r127[0] != 127
        print("FAIL mqtt_fixed remlen_encode(127) byte: got "+str(r127[0])+" want 127")
        exit(1)

    // ── KAT 3: mqtt_remlen_encode(128) == [128,1] ────────────────────────────
    let r128 = mqtt_remlen_encode(128)
    if len(r128) != 2
        print("FAIL mqtt_fixed remlen_encode(128) len: got "+str(len(r128))+" want 2")
        exit(1)
    if r128[0] != 128
        print("FAIL mqtt_fixed remlen_encode(128) byte0: got "+str(r128[0])+" want 128")
        exit(1)
    if r128[1] != 1
        print("FAIL mqtt_fixed remlen_encode(128) byte1: got "+str(r128[1])+" want 1")
        exit(1)

    // ── KAT 4: mqtt_remlen_encode(16383) == [255,127] ────────────────────────
    let r16383 = mqtt_remlen_encode(16383)
    if len(r16383) != 2
        print("FAIL mqtt_fixed remlen_encode(16383) len: got "+str(len(r16383))+" want 2")
        exit(1)
    if r16383[0] != 255
        print("FAIL mqtt_fixed remlen_encode(16383) byte0: got "+str(r16383[0])+" want 255")
        exit(1)
    if r16383[1] != 127
        print("FAIL mqtt_fixed remlen_encode(16383) byte1: got "+str(r16383[1])+" want 127")
        exit(1)

    // ── KAT 5: mqtt_remlen_encode(16384) == [128,128,1] ─────────────────────
    let r16384 = mqtt_remlen_encode(16384)
    if len(r16384) != 3
        print("FAIL mqtt_fixed remlen_encode(16384) len: got "+str(len(r16384))+" want 3")
        exit(1)
    if r16384[0] != 128
        print("FAIL mqtt_fixed remlen_encode(16384) byte0: got "+str(r16384[0])+" want 128")
        exit(1)
    if r16384[1] != 128
        print("FAIL mqtt_fixed remlen_encode(16384) byte1: got "+str(r16384[1])+" want 128")
        exit(1)
    if r16384[2] != 1
        print("FAIL mqtt_fixed remlen_encode(16384) byte2: got "+str(r16384[2])+" want 1")
        exit(1)

    // ── KAT 6: decode round-trip for various values ───────────────────────────
    // Round-trip 0
    let dec0 = mqtt_remlen_decode(r0, 0)
    if dec0[0] != 0
        print("FAIL mqtt_fixed decode(0) value: got "+str(dec0[0])+" want 0")
        exit(1)
    if dec0[1] != 1
        print("FAIL mqtt_fixed decode(0) next_pos: got "+str(dec0[1])+" want 1")
        exit(1)

    // Round-trip 127
    let dec127 = mqtt_remlen_decode(r127, 0)
    if dec127[0] != 127
        print("FAIL mqtt_fixed decode(127) value: got "+str(dec127[0])+" want 127")
        exit(1)
    if dec127[1] != 1
        print("FAIL mqtt_fixed decode(127) next_pos: got "+str(dec127[1])+" want 1")
        exit(1)

    // Round-trip 128
    let dec128 = mqtt_remlen_decode(r128, 0)
    if dec128[0] != 128
        print("FAIL mqtt_fixed decode(128) value: got "+str(dec128[0])+" want 128")
        exit(1)
    if dec128[1] != 2
        print("FAIL mqtt_fixed decode(128) next_pos: got "+str(dec128[1])+" want 2")
        exit(1)

    // Round-trip 16383
    let dec16383 = mqtt_remlen_decode(r16383, 0)
    if dec16383[0] != 16383
        print("FAIL mqtt_fixed decode(16383) value: got "+str(dec16383[0])+" want 16383")
        exit(1)
    if dec16383[1] != 2
        print("FAIL mqtt_fixed decode(16383) next_pos: got "+str(dec16383[1])+" want 2")
        exit(1)

    // Round-trip 16384
    let dec16384 = mqtt_remlen_decode(r16384, 0)
    if dec16384[0] != 16384
        print("FAIL mqtt_fixed decode(16384) value: got "+str(dec16384[0])+" want 16384")
        exit(1)
    if dec16384[1] != 3
        print("FAIL mqtt_fixed decode(16384) next_pos: got "+str(dec16384[1])+" want 3")
        exit(1)

    // ── KAT 7: mqtt_fixed_header(3,0,10)[0] == 0x30 (48) ────────────────────
    let fh_pub = mqtt_fixed_header(3, 0, 10)
    if fh_pub[0] != 48
        print("FAIL mqtt_fixed fixed_header PUBLISH byte0: got "+str(fh_pub[0])+" want 48")
        exit(1)
    // remlen 10 encodes as single byte 10
    if fh_pub[1] != 10
        print("FAIL mqtt_fixed fixed_header PUBLISH remlen: got "+str(fh_pub[1])+" want 10")
        exit(1)

    // ── KAT 8: mqtt_fixed_header(8,2,5)[0] == 0x82 (130) ────────────────────
    let fh_sub = mqtt_fixed_header(8, 2, 5)
    if fh_sub[0] != 130
        print("FAIL mqtt_fixed fixed_header SUBSCRIBE byte0: got "+str(fh_sub[0])+" want 130 (0x82)")
        exit(1)
    if fh_sub[1] != 5
        print("FAIL mqtt_fixed fixed_header SUBSCRIBE remlen: got "+str(fh_sub[1])+" want 5")
        exit(1)

    print("PASS _mqtt_fixed_test")
