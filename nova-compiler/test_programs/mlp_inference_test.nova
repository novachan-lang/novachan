// End-to-end MLP classifier forward pass in PURE NOVA, composing the whole tensor
// toolkit: matmul -> add_bias -> relu -> matmul -> add_bias -> softmax -> argmax.
// Hand-chosen weights make the prediction deterministic and hand-verifiable. This
// proves NOVA's AI-inference domain identity: a real 2-layer model forward pass,
// zero external libraries, running on the native tensor runtime. Floats compared
// with an explicit tolerance gate (exit(1) on miss).

fn check(got, want, msg)
    if got < want - 0.0001
        print(msg)
        exit(1)
    if got > want + 0.0001
        print(msg)
        exit(1)

fn main()
    // tensor_add_bias broadcast over MULTIPLE rows: [[1,2],[3,4]] + bias[10,20]
    // = [[11,22],[13,24]]
    let bb = tensor_to_list(tensor_add_bias(tensor_from_list([1.0, 2.0, 3.0, 4.0], [2, 2]), tensor_from_list([10.0, 20.0], [2])))
    check(bb[0], 11.0, "add_bias[0,0]")
    check(bb[1], 22.0, "add_bias[0,1]")
    check(bb[2], 13.0, "add_bias[1,0]")
    check(bb[3], 24.0, "add_bias[1,1]")

    // --- 2-layer MLP forward pass, single input (batch=1) ---
    // x = [1, 0]  (1x2)
    let x = tensor_from_list([1.0, 0.0], [1, 2])

    // Layer 1: W1 (2x3), b1 (3). matmul(x,W1)=[1,0,-1]; +b1=[1,0,-1]; relu=[1,0,0]
    let w1 = tensor_from_list([1.0, 0.0, -1.0, 0.0, 1.0, 0.0], [2, 3])
    let b1 = tensor_from_list([0.0, 0.0, 0.0], [3])
    let hidden = tensor_relu(tensor_add_bias(tensor_matmul(x, w1), b1))
    let hl = tensor_to_list(hidden)
    check(hl[0], 1.0, "hidden[0]")
    check(hl[1], 0.0, "hidden[1]")
    check(hl[2], 0.0, "hidden[2] (relu cut the -1)")

    // Layer 2: W2 (3x2), b2 (2). matmul(hidden,W2)=[3,0]; +b2=[3,5]
    let w2 = tensor_from_list([3.0, 0.0, 0.0, 3.0, 0.0, 0.0], [3, 2])
    let b2 = tensor_from_list([0.0, 5.0], [2])
    let logits = tensor_add_bias(tensor_matmul(hidden, w2), b2)
    let lg = tensor_to_list(logits)
    check(lg[0], 3.0, "logits[0]")
    check(lg[1], 5.0, "logits[1]")

    // softmax([3,5]) -> [0.11920, 0.88080]; sums to 1; argmax = class 1
    let probs = tensor_softmax(logits)
    let pl = tensor_to_list(probs)
    check(pl[0] + pl[1], 1.0, "probs sum != 1")
    check(pl[0], 0.11920292, "probs[0] ref")
    check(pl[1], 0.88079708, "probs[1] ref")

    let cls = tensor_argmax(probs)
    if cls != 1
        print("MLP predicted class != 1")
        exit(1)

    print("mlp_inference_test passed")
