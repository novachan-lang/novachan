// Networking identity test: dns_resolve + hostname.
// Offline-safe & deterministic: localhost always maps to the IPv4 loopback
// via the system hosts file, so no real network access is required.

fn main()
    // localhost resolves to the IPv4 loopback on every system (hosts file).
    // We force AF_INET in the runtime, so this is 127.0.0.1, never ::1.
    assert_eq(dns_resolve("localhost"), "127.0.0.1")

    // A nonexistent host resolves to "" (deterministic failure, not a crash).
    assert_eq(dns_resolve("__nova_no_such_host_xyz__.invalid"), "")

    // Empty host is rejected up front -> "".
    assert_eq(dns_resolve(""), "")

    // hostname() returns a non-empty machine name.
    assert_eq(len(hostname()) > 0, true)

    print("net_test passed")
