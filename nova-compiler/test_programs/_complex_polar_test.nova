import std/complex/complex_polar

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label, got, want)
    let gs = "false"
    if got
        gs = "true"
    let ws = "false"
    if want
        ws = "true"
    if gs != ws
        print("FAIL " + label + ": got " + gs + " want " + ws)
        exit(1)

fn ckf(label, got, want)
    let tol = 0.0001
    let diff = got - want
    if diff < 0.0
        diff = 0.0 - diff
    if diff > tol
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // norm_sq
    cki("norm_sq [3,4]", cxpl_norm_sq([3, 4]), 25)
    cki("norm_sq [0,0]", cxpl_norm_sq([0, 0]), 0)
    cki("norm_sq [1,0]", cxpl_norm_sq([1, 0]), 1)
    cki("norm_sq [0,1]", cxpl_norm_sq([0, 1]), 1)
    cki("norm_sq [5,12]", cxpl_norm_sq([5, 12]), 169)

    // magnitude (float, tolerance)
    let m1 = cxpl_magnitude([3, 4])
    ckf("mag [3,4]", m1, 5.0)

    let m2 = cxpl_magnitude([0, 0])
    ckf("mag [0,0]", m2, 0.0)

    let m3 = cxpl_magnitude([5, 12])
    ckf("mag [5,12]", m3, 13.0)

    let m4 = cxpl_magnitude([1, 0])
    ckf("mag [1,0]", m4, 1.0)

    let m5 = cxpl_magnitude([0, 1])
    ckf("mag [0,1]", m5, 1.0)

    // quadrant: strict interior
    cki("Q1 [1,1]", cxpl_quadrant([1, 1]), 1)
    cki("Q2 [-1,1]", cxpl_quadrant([0 - 1, 1]), 2)
    cki("Q3 [-1,-1]", cxpl_quadrant([0 - 1, 0 - 1]), 3)
    cki("Q4 [1,-1]", cxpl_quadrant([1, 0 - 1]), 4)

    // origin -> 0
    cki("origin", cxpl_quadrant([0, 0]), 0)

    // axis convention: +real axis -> Q1
    cki("+real axis", cxpl_quadrant([5, 0]), 1)

    // +imag axis -> Q2
    cki("+imag axis", cxpl_quadrant([0, 3]), 2)

    // -real axis -> Q3
    cki("-real axis", cxpl_quadrant([0 - 5, 0]), 3)

    // -imag axis -> Q4
    cki("-imag axis", cxpl_quadrant([0, 0 - 3]), 4)

    print("PASS _complex_polar_test")
