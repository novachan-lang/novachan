import std/permutation/perm_conjugate

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn list_str(xs) -> string
    let s = "["
    let i = 0
    while i < len(xs)
        if i > 0
            s = s + ","
        s = s + str(xs[i])
        i = i + 1
    return s + "]"

fn ckl(label: string, got, want)
    if len(got) != len(want)
        print("FAIL " + label + ": got=" + list_str(got) + " want=" + list_str(want))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL " + label + ": got=" + list_str(got) + " want=" + list_str(want))
            exit(1)
        i = i + 1

fn is_valid_perm(p) -> bool
    let n = len(p)
    let seen = []
    let i = 0
    while i < n
        push(seen, 0)
        i = i + 1
    let j = 0
    while j < n
        let v = p[j]
        if v < 0
            return false
        if v >= n
            return false
        if seen[v] != 0
            return false
        seen[v] = 1
        j = j + 1
    return true

fn main()
    // --- pcj_cycle_type ---
    // [1,2,0] = one 3-cycle => [3]
    let ct1 = pcj_cycle_type([1, 2, 0])
    ckl("cycle_type([1,2,0])", ct1, [3])

    // [1,0,2] = one 2-cycle + one fixed point => [1,2]
    let ct2 = pcj_cycle_type([1, 0, 2])
    ckl("cycle_type([1,0,2])", ct2, [1, 2])

    // [1,2,0,4,3] = one 3-cycle (0,1,2) + one 2-cycle (3,4) => [2,3]
    let ct3 = pcj_cycle_type([1, 2, 0, 4, 3])
    ckl("cycle_type([1,2,0,4,3])", ct3, [2, 3])

    // identity [0,1,2] = three fixed points => [1,1,1]
    let ct4 = pcj_cycle_type([0, 1, 2])
    ckl("cycle_type([0,1,2])", ct4, [1, 1, 1])

    // --- pcj_are_conjugate ---
    // [1,2,0] and [2,0,1] both single 3-cycles => conjugate
    ckb("conj([1,2,0],[2,0,1])", pcj_are_conjugate([1, 2, 0], [2, 0, 1]), true)

    // [1,0,2] has type [1,2]; [1,2,0] has type [3] => not conjugate
    ckb("conj([1,0,2],[1,2,0])", pcj_are_conjugate([1, 0, 2], [1, 2, 0]), false)

    // identity to identity => conjugate (same type [1,1,1])
    ckb("conj(id,id)", pcj_are_conjugate([0, 1, 2], [0, 1, 2]), true)

    // --- pcj_conjugate ---
    // pcj_conjugate([1,0,2],[2,0,1]): p=[1,0,2], g=[2,0,1]
    // r[g[i]] = g[p[i]]:
    //   i=0: r[g[0]]=r[2] = g[p[0]] = g[1] = 0
    //   i=1: r[g[1]]=r[0] = g[p[1]] = g[0] = 2
    //   i=2: r[g[2]]=r[1] = g[p[2]] = g[2] = 1
    // => r = [2,1,0] which is a transposition => valid perm
    let conj1 = pcj_conjugate([1, 0, 2], [2, 0, 1])
    ckb("conjugate_is_valid_perm", is_valid_perm(conj1), true)
    cki("conjugate_len", len(conj1), 3)

    // verify specific values: r[0]=2, r[1]=1, r[2]=0 (transposition (0 2))
    cki("conj1[0]", conj1[0], 2)
    cki("conj1[1]", conj1[1], 1)
    cki("conj1[2]", conj1[2], 0)

    // conjugate of identity by anything = identity
    let cid = pcj_conjugate([0, 1, 2], [2, 0, 1])
    ckl("conj(id,g)=id", cid, [0, 1, 2])

    // conjugate of g by identity = g
    let cg = pcj_conjugate([2, 0, 1], [0, 1, 2])
    ckl("conj(g,id)=g", cg, [2, 0, 1])

    // conjugate preserves cycle type: conj(p,g) has same cycle type as p
    let p5 = [1, 2, 0, 4, 3]
    let g5 = [2, 0, 1, 3, 4]
    let cp5 = pcj_conjugate(p5, g5)
    ckb("conj_preserves_cycle_type", pcj_are_conjugate(cp5, p5), true)

    print("PASS _perm_conjugate_test")
