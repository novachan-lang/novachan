import std/statistics/stat_histogram

// ckf — float tolerance check (0.001)
fn ckf(label: string, got: float, want: float)
    let d = got - want
    if d < 0.0
        d = 0.0 - d
    if d > 0.001
        print("FAIL stat_histogram " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// cki — integer equality check
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL stat_histogram " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // --- shi_bin_counts ---

    // [1,2,3,4,5,6] into 3 bins: width=5/3≈1.667 → [1..2.667) [2.667..4.333) [4.333..6]
    let xs1 = [1, 2, 3, 4, 5, 6]
    let c1 = shi_bin_counts(xs1, 3)
    cki("counts3_len", len(c1), 3)
    cki("counts3_b0", c1[0], 2)
    cki("counts3_b1", c1[1], 2)
    cki("counts3_b2", c1[2], 2)

    // [1,1,2,3] into 2 bins: width=2/2=1 → [1..2) has 1,1; [2..3] has 2,3
    let xs2 = [1, 1, 2, 3]
    let c2 = shi_bin_counts(xs2, 2)
    cki("counts2_len", len(c2), 2)
    cki("counts2_b0", c2[0], 2)
    cki("counts2_b1", c2[1], 2)

    // [5,5,5] into 1 bin: all in single bin
    let xs3 = [5, 5, 5]
    let c3 = shi_bin_counts(xs3, 1)
    cki("counts1_len", len(c3), 1)
    cki("counts1_b0", c3[0], 3)

    // empty list → empty
    let ce = shi_bin_counts([], 3)
    cki("counts_empty", len(ce), 0)

    // --- shi_relative ---

    // [1,2,3,4,5,6] into 3 bins → each = 2/6 ≈ 0.3333
    let r1 = shi_relative(xs1, 3)
    cki("rel3_len", len(r1), 3)
    ckf("rel3_b0", r1[0] * 1.0, 0.3333)
    ckf("rel3_b1", r1[1] * 1.0, 0.3333)
    ckf("rel3_b2", r1[2] * 1.0, 0.3333)

    // --- shi_bin_edges ---

    // [0,10] into 2 bins → 3 edges: [0.0, 5.0, 10.0]
    let xe = [0, 10]
    let edges = shi_bin_edges(xe, 2)
    cki("edges2_len", len(edges), 3)
    ckf("edges2_e0", edges[0] * 1.0, 0.0)
    ckf("edges2_e1", edges[1] * 1.0, 5.0)
    ckf("edges2_e2", edges[2] * 1.0, 10.0)

    // [0,9] into 3 bins → 4 edges: [0.0, 3.0, 6.0, 9.0]
    let xe2 = [0, 9]
    let edges2 = shi_bin_edges(xe2, 3)
    cki("edges3_len", len(edges2), 4)
    ckf("edges3_e0", edges2[0] * 1.0, 0.0)
    ckf("edges3_e1", edges2[1] * 1.0, 3.0)
    ckf("edges3_e2", edges2[2] * 1.0, 6.0)
    ckf("edges3_e3", edges2[3] * 1.0, 9.0)

    // single-bin [5,5,5]: edges has 2 entries, both equal to 5.0
    let edges3 = shi_bin_edges(xs3, 1)
    cki("edges_single_len", len(edges3), 2)
    ckf("edges_single_e0", edges3[0] * 1.0, 5.0)
    ckf("edges_single_e1", edges3[1] * 1.0, 5.0)

    print("PASS _stat_histogram_test")
