// KAT test for std/audio/osc_sine.nova
import std/audio/osc_sine

fn approx(a: float, b: float, tol: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    let result = d < tol
    result

fn main()
    // KAT 1: osc_sine(0.0) == sin(0) == 0.0
    let s0 = osc_sine(0.0)
    if approx(s0, 0.0, 0.0001) != true
        print("FAIL osc_sine(0.0): got=" + str(s0) + " want~0.0")
        exit(1)

    // KAT 2: osc_sine(0.25) == sin(pi/2) == 1.0
    let s25 = osc_sine(0.25)
    if approx(s25, 1.0, 0.0001) != true
        print("FAIL osc_sine(0.25): got=" + str(s25) + " want~1.0")
        exit(1)

    // KAT 3: osc_sine(0.5) == sin(pi) == 0.0
    let s50 = osc_sine(0.5)
    if approx(s50, 0.0, 0.0001) != true
        print("FAIL osc_sine(0.5): got=" + str(s50) + " want~0.0")
        exit(1)

    // KAT 4: osc_sine(0.75) == sin(3*pi/2) == -1.0
    let s75 = osc_sine(0.75)
    if approx(s75, -1.0, 0.0001) != true
        print("FAIL osc_sine(0.75): got=" + str(s75) + " want~-1.0")
        exit(1)

    // KAT 5: freq_to_phase_inc(44100.0, 44100.0) == 1.0 (one cycle per sample)
    let inc1 = freq_to_phase_inc(44100.0, 44100.0)
    if approx(inc1, 1.0, 0.0001) != true
        print("FAIL freq_to_phase_inc(44100,44100): got=" + str(inc1) + " want~1.0")
        exit(1)

    // KAT 6: freq_to_phase_inc(440.0, 44100.0) ~ 0.009977
    let inc440 = freq_to_phase_inc(440.0, 44100.0)
    if approx(inc440, 0.009977, 0.0001) != true
        print("FAIL freq_to_phase_inc(440,44100): got=" + str(inc440) + " want~0.009977")
        exit(1)

    // KAT 7: output in [-1, 1] for several phases
    let s125 = osc_sine(0.125)
    // sin(pi/4) ~ 0.7071
    if approx(s125, 0.7071, 0.001) != true
        print("FAIL osc_sine(0.125): got=" + str(s125) + " want~0.7071")
        exit(1)

    // KAT 8: osc_sine(1.0) == sin(2*pi) ~ 0.0 (full cycle)
    let s100 = osc_sine(1.0)
    if approx(s100, 0.0, 0.0001) != true
        print("FAIL osc_sine(1.0): got=" + str(s100) + " want~0.0")
        exit(1)

    print("PASS _osc_sine_test")
