import forge_matexp

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn render(m: list) -> string
    let out = ""
    let i = 0
    while i < len(m)
        let j = 0
        while j < len(m[i])
            out = out + str(m[i][j]) + " "
            j = j + 1
        i = i + 1
    out

// naive iterative fib mod for cross-check
fn naive_fib(n: int, mod: int) -> int
    let a = 0
    let b = 1
    let i = 0
    while i < n
        let t = (a + b) % mod
        a = b
        b = t
        i = i + 1
    a

fn main()
    let fails = 0
    let BIG = 1000000007

    // matrix multiply
    let A = []
    push(A, [1, 2])
    push(A, [3, 4])
    let B = []
    push(B, [5, 6])
    push(B, [7, 8])
    fails = fails + expect("matmul", render(mat_mul(A, B, BIG)), "19 22 43 50 ")

    // identity
    fails = fails + expect("ident", render(mat_identity(2)), "1 0 0 1 ")
    // A^0 = identity
    fails = fails + expect("pow0", render(mat_pow(A, 0, BIG)), "1 0 0 1 ")

    // fibonacci
    fails = fails + expect("fib0", str(mat_fib(0, BIG)), "0")
    fails = fails + expect("fib1", str(mat_fib(1, BIG)), "1")
    fails = fails + expect("fib10", str(mat_fib(10, BIG)), "55")
    fails = fails + expect("fib20", str(mat_fib(20, BIG)), "6765")
    // large-n cross-check
    fails = fails + expect("fib_big", str(mat_fib(1000, BIG)), str(naive_fib(1000, BIG)))
    fails = fails + expect("fib_huge", str(mat_fib(100000, BIG)), str(naive_fib(100000, BIG)))

    // linear recurrence: Fibonacci via rec_nth
    fails = fails + expect("rec_fib", str(rec_nth([1, 1], [0, 1], 10, BIG)), "55")
    // Tribonacci: a_n = a_{n-1}+a_{n-2}+a_{n-3}, init 0,0,1 -> 0,0,1,1,2,4,7,13,24,44,81
    fails = fails + expect("trib10", str(rec_nth([1, 1, 1], [0, 0, 1], 10, BIG)), "81")
    fails = fails + expect("trib_small", str(rec_nth([1, 1, 1], [0, 0, 1], 2, BIG)), "1")
    // geometric a_n = 2*a_{n-1}, init 1 -> 2^n
    fails = fails + expect("geo10", str(rec_nth([2], [1], 10, BIG)), "1024")
    // Pell: a_n = 2 a_{n-1} + a_{n-2}, init 0,1 -> 0,1,2,5,12,29,70
    fails = fails + expect("pell6", str(rec_nth([2, 1], [0, 1], 6, BIG)), "70")

    if fails == 0
        print("forge_matexp: all passed")
    else
        print("forge_matexp: " + str(fails) + " FAILED")
