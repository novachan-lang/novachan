// KAT for std/geometry/cg_point_in_poly
// Verifies: cgp_on_boundary, cgp_inside, cgp_contains
import std/geometry/cg_point_in_poly

fn ckb(label: string, got: bool, want: bool)
    let goti = 0
    if got
        goti = 1
    let wanti = 0
    if want
        wanti = 1
    if goti != wanti
        print("FAIL " + label + ": got=" + str(goti) + " want=" + str(wanti))
        exit(1)

fn main()
    // 4x4 square (CCW): (0,0),(4,0),(4,4),(0,4)
    let sq = [[0,0],[4,0],[4,4],[0,4]]

    // cgp_inside: interior point
    ckb("inside [2,2]", cgp_inside(sq, [2,2]), true)
    // cgp_inside: boundary point is NOT strictly inside
    ckb("inside [0,2]", cgp_inside(sq, [0,2]), false)
    // cgp_inside: corner vertex is NOT strictly inside
    ckb("inside [4,4]", cgp_inside(sq, [4,4]), false)
    // cgp_inside: exterior point
    ckb("inside [5,5]", cgp_inside(sq, [5,5]), false)
    // cgp_inside: point exactly on top edge midpoint
    ckb("inside [2,4]", cgp_inside(sq, [2,4]), false)

    // cgp_on_boundary: midpoint of left edge
    ckb("on_boundary [0,2]", cgp_on_boundary(sq, [0,2]), true)
    // cgp_on_boundary: corner
    ckb("on_boundary [0,0]", cgp_on_boundary(sq, [0,0]), true)
    // cgp_on_boundary: interior is not on boundary
    ckb("on_boundary [2,2]", cgp_on_boundary(sq, [2,2]), false)
    // cgp_on_boundary: exterior
    ckb("on_boundary [5,5]", cgp_on_boundary(sq, [5,5]), false)
    // cgp_on_boundary: midpoint of top edge
    ckb("on_boundary [2,4]", cgp_on_boundary(sq, [2,4]), true)

    // cgp_contains: inside
    ckb("contains [2,2]", cgp_contains(sq, [2,2]), true)
    // cgp_contains: boundary
    ckb("contains [0,2]", cgp_contains(sq, [0,2]), true)
    // cgp_contains: exterior
    ckb("contains [5,5]", cgp_contains(sq, [5,5]), false)

    // Triangle: (0,0),(4,0),(0,4)
    let tri = [[0,0],[4,0],[0,4]]
    // Interior
    ckb("tri inside [1,1]", cgp_inside(tri, [1,1]), true)
    // Vertex not strictly inside
    ckb("tri inside [0,0]", cgp_inside(tri, [0,0]), false)
    // Hypotenuse point: on edge from (4,0) to (0,4), midpoint (2,2): x+y=4, on_boundary
    ckb("tri on_boundary [2,2]", cgp_on_boundary(tri, [2,2]), true)
    // Contains vertex
    ckb("tri contains [0,0]", cgp_contains(tri, [0,0]), true)

    print("PASS _cg_point_in_poly_test")
