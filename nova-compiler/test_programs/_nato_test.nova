// KAT test for std/encoding/nato
import std/encoding/nato

fn cki(got, expected, label)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(got, expected, label)
    if got != expected
        print("FAIL " + label + ": got [" + got + "] expected [" + expected + "]")
        exit(1)

fn main()
    // KAT 1: uppercase A -> Alpha
    cks(nato_word("A"), "Alpha", "nato_word A")

    // KAT 2: uppercase B -> Bravo
    cks(nato_word("B"), "Bravo", "nato_word B")

    // KAT 3: uppercase Z -> Zulu
    cks(nato_word("Z"), "Zulu", "nato_word Z")

    // KAT 4: digit 5 -> Five
    cks(nato_word("5"), "Five", "nato_word 5")

    // KAT 5: lowercase n -> November (case-insensitive)
    cks(nato_word("n"), "November", "nato_word n lowercase")

    // KAT 6: nato_spell of "AB" -> list ["Alpha","Bravo"]
    let spelled = nato_spell("AB")
    cki(len(spelled), 2, "nato_spell AB len")
    cks(spelled[0], "Alpha", "nato_spell AB[0]")
    cks(spelled[1], "Bravo", "nato_spell AB[1]")

    // KAT 7: nato_spell_string "SOS" -> "Sierra Oscar Sierra"
    cks(nato_spell_string("SOS"), "Sierra Oscar Sierra", "nato_spell_string SOS")

    // KAT 8: digit 9 -> Niner
    cks(nato_word("9"), "Niner", "nato_word 9")

    // KAT 9: digit 0 -> Zero
    cks(nato_word("0"), "Zero", "nato_word 0")

    // KAT 10: full word NOVA
    cks(nato_spell_string("NOVA"), "November Oscar Victor Alpha", "nato_spell_string NOVA")

    // KAT 11: space is skipped in nato_spell
    let sp = nato_spell("A B")
    cki(len(sp), 2, "nato_spell skips space len")
    cks(sp[0], "Alpha", "nato_spell skip sp[0]")
    cks(sp[1], "Bravo", "nato_spell skip sp[1]")

    // KAT 12: unknown char returned as-is
    cks(nato_word("?"), "?", "nato_word unknown passthrough")

    print("_nato_test passed")
