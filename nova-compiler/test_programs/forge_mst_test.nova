import forge_mst

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn main()
    let fails = 0

    // triangle: a-b(1), b-c(2), a-c(3) -> MST = a-b,b-c total 3 (skip a-c cycle)
    let e1 = [["a", "b", 1], ["b", "c", 2], ["a", "c", 3]]
    fails = fails + expect("tri_total", str(mst_total_weight(e1)), "3")
    fails = fails + expect_true("tri_edges", len(mst_edges(e1)) == 2)
    fails = fails + expect_true("tri_spans", mst_spans_all(e1, 3))

    // classic 4-node graph: a-b1, a-c4, b-c2, b-d5, c-d3 -> MST weight 6 (a-b,b-c,c-d)
    let e2 = [["a", "b", 1], ["a", "c", 4], ["b", "c", 2], ["b", "d", 5], ["c", "d", 3]]
    fails = fails + expect("classic_total", str(mst_total_weight(e2)), "6")
    fails = fails + expect_true("classic_3edges", len(mst_edges(e2)) == 3)
    fails = fails + expect_true("classic_spans", mst_spans_all(e2, 4))
    // chosen edges are the cheap ones: weights sum to 6, all <= 3
    let chosen = mst_edges(e2)
    let maxw = 0
    let i = 0
    while i < len(chosen)
        if chosen[i][2] > maxw
            maxw = chosen[i][2]
        i = i + 1
    fails = fails + expect("classic_maxw", str(maxw), "3")

    // disconnected: two separate components -> spanning FOREST, not all-spanning
    let e3 = [["a", "b", 1], ["c", "d", 2]]
    fails = fails + expect("forest_total", str(mst_total_weight(e3)), "3")
    fails = fails + expect_true("forest_not_spanning", mst_spans_all(e3, 4) == false)

    // order independence: shuffled edges give the same total
    let e4 = [["c", "d", 3], ["b", "d", 5], ["a", "b", 1], ["b", "c", 2], ["a", "c", 4]]
    fails = fails + expect("shuffle_total", str(mst_total_weight(e4)), "6")

    // single edge
    let e5 = [["x", "y", 7]]
    fails = fails + expect("single", str(mst_total_weight(e5)), "7")
    fails = fails + expect_true("single_spans", mst_spans_all(e5, 2))

    if fails == 0
        print("forge_mst: all passed")
    else
        print("forge_mst: " + str(fails) + " FAILED")
