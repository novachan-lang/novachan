// Trait conformance — all methods implemented, should compile clean

trait Printable
    fn to_str(self) -> string

trait Shape
    fn area(self) -> float
    fn name(self) -> string

type Circle : Shape
    radius: float

fn Circle.area() -> float
    3.14159 * self.radius * self.radius

fn Circle.name() -> string
    "circle"

type Rect : Shape
    w: float
    h: float

fn Rect.area() -> float
    self.w * self.h

fn Rect.name() -> string
    "rect"

// Multiple trait conformance
type Point : Printable
    x: int
    y: int

fn Point.to_str() -> string
    "(" + str(self.x) + "," + str(self.y) + ")"

fn main()
    let c = Circle(5.0)
    let r = Rect(3.0, 4.0)
    let p = Point(1, 2)
    print(c.name() + " area=" + str(c.area()))
    print(r.name() + " area=" + str(r.area()))
    print(p.to_str())
