// triex.nova — trie (prefix tree) for fast prefix search + AUTOCOMPLETE.
//
// A trie stores a set of strings so that prefix queries — "is any word starting
// with 'car'?" and "give me every completion of 'car'" — are O(prefix length),
// independent of how many words are stored. The classic structure behind
// autocomplete, spell-suggestion, and routing tables. A node = {end, kids} where
// kids maps a character to a child node. (Byte/ASCII-indexed via slice.)

fn trie_new()
  let root = {}
  root["end"] = 0
  root["kids"] = {}
  root

fn trie_insert(trie, word)
  let node = trie
  let i = 0
  while i < len(word)
    let ch = slice(word, i, i + 1)
    let kids = node["kids"]
    if not contains(kids, ch)
      let child = {}
      child["end"] = 0
      child["kids"] = {}
      kids[ch] = child
    node = kids[ch]
    i = i + 1
  node["end"] = 1

// walk to the node reached by string s, or 0 if no such path.
fn _trie_node(trie, s)
  let node = trie
  let i = 0
  while i < len(s)
    let ch = slice(s, i, i + 1)
    let kids = node["kids"]
    if not contains(kids, ch)
      return 0
    node = kids[ch]
    i = i + 1
  node

// is `word` stored as a complete word (not just a prefix)?
fn trie_contains(trie, word)
  let node = _trie_node(trie, word)
  if node == 0
    return 0
  node["end"]

// is any stored word starting with `prefix`?
fn trie_has_prefix(trie, prefix)
  if _trie_node(trie, prefix) == 0
    return 0
  1

fn _trie_collect(node, prefix, out)
  if node["end"] == 1
    push(out, prefix)
  let kids = node["kids"]
  for ch in keys(kids)
    _trie_collect(kids[ch], prefix + ch, out)

// every stored word that begins with `prefix` (autocomplete).
fn trie_words_with_prefix(trie, prefix)
  let out = []
  let node = _trie_node(trie, prefix)
  if node == 0
    return out
  _trie_collect(node, prefix, out)
  out

// ── Tests ────────────────────────────────────────────────────────────

let t = trie_new()
trie_insert(t, "cat")
trie_insert(t, "car")
trie_insert(t, "card")
trie_insert(t, "dog")
trie_insert(t, "do")

assert(trie_contains(t, "cat") == 1, "cat is a word")
assert(trie_contains(t, "car") == 1, "car is a word")
assert(trie_contains(t, "ca") == 0, "ca is a prefix, not a word")
assert(trie_contains(t, "card") == 1, "card is a word")
assert(trie_contains(t, "do") == 1, "do is a word (and a prefix of dog)")
assert(trie_contains(t, "xyz") == 0, "xyz absent")
print("PASS: contains (word vs prefix)")

assert(trie_has_prefix(t, "ca") == 1, "prefix ca exists")
assert(trie_has_prefix(t, "car") == 1, "prefix car exists")
assert(trie_has_prefix(t, "z") == 0, "prefix z does not exist")
assert(trie_has_prefix(t, "care") == 0, "care is not a prefix of anything")
print("PASS: has_prefix")

// autocomplete
let car_words = trie_words_with_prefix(t, "car")
assert(len(car_words) == 2, "car* = (car, card)")
assert(contains(car_words, "car"), "car included")
assert(contains(car_words, "card"), "card included")

let ca_words = trie_words_with_prefix(t, "ca")
assert(len(ca_words) == 3, "ca* = (cat, car, card)")

let all_d = trie_words_with_prefix(t, "do")
assert(len(all_d) == 2, "do* = (do, dog)")
assert(contains(all_d, "do") and contains(all_d, "dog"), "do and dog")

let none = trie_words_with_prefix(t, "z")
assert(len(none) == 0, "no completions for z")
print("PASS: autocomplete (words_with_prefix)")

print("ALL PASS: triex — trie / prefix tree")
