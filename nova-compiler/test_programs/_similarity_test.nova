// KAT test for std/text/similarity
import std/text/similarity

fn ckf(label, got, expected, eps)
    let diff = got - expected
    if diff < 0.0
        diff = 0.0 - diff
    if diff > eps
        print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + got + " expected=" + expected)
        exit(1)

fn main()
    // ── sim_ngrams ────────────────────────────────────────────────────────────

    // KAT-1: bigrams of "abcd"
    let ng1 = sim_ngrams("abcd", 2)
    cki("ngrams_len", len(ng1), 3)
    cks("ngrams_0", ng1[0], "ab")
    cks("ngrams_1", ng1[1], "bc")
    cks("ngrams_2", ng1[2], "cd")

    // KAT-2: trigrams of "abcde"
    let ng2 = sim_ngrams("abcde", 3)
    cki("trigrams_len", len(ng2), 3)
    cks("trigrams_0", ng2[0], "abc")
    cks("trigrams_1", ng2[1], "bcd")
    cks("trigrams_2", ng2[2], "cde")

    // KAT-3: n > len -> empty
    let ng3 = sim_ngrams("ab", 5)
    cki("ngrams_empty", len(ng3), 0)

    // KAT-4: n == len -> one gram
    let ng4 = sim_ngrams("abc", 3)
    cki("ngrams_exact_len", len(ng4), 1)
    cks("ngrams_exact_0", ng4[0], "abc")

    // ── sim_dice ─────────────────────────────────────────────────────────────

    // KAT-5: dice("night","nacht") ~ 0.25
    // bigrams(night)={ni,ig,gh,ht}, bigrams(nacht)={na,ac,ch,ht}
    // shared="ht" -> 1, total=(4+4)=8, dice=2/8=0.25
    let d1 = sim_dice("night", "nacht")
    ckf("dice_night_nacht", d1, 0.25, 0.001)

    // KAT-6: dice("abc","abc") = 1.0
    // bigrams(abc)={ab,bc}, both same -> shared=2, dice=2*2/(2+2)=1.0
    let d2 = sim_dice("abc", "abc")
    ckf("dice_identical", d2, 1.0, 0.001)

    // KAT-7: dice("ab","cd") = 0.0 (no shared bigrams)
    // bigrams(ab)={ab}, bigrams(cd)={cd}, shared=0
    let d3 = sim_dice("ab", "cd")
    ckf("dice_no_shared", d3, 0.0, 0.001)

    // KAT-8: dice("night","night") = 1.0
    let d4 = sim_dice("night", "night")
    ckf("dice_self", d4, 1.0, 0.001)

    // KAT-9: dice with repeated bigrams: "aab" -> {aa:1,ab:1}, "aab" same
    let d5 = sim_dice("aab", "aab")
    ckf("dice_repeated_self", d5, 1.0, 0.001)

    // ── sim_jaccard_tokens ────────────────────────────────────────────────────

    // KAT-10: jaccard("a b c","b c d") = 0.5
    // A={a,b,c}, B={b,c,d}, inter=2, union=4
    let j1 = sim_jaccard_tokens("a b c", "b c d")
    ckf("jaccard_abc_bcd", j1, 0.5, 0.001)

    // KAT-11: jaccard("x","y") = 0.0
    let j2 = sim_jaccard_tokens("x", "y")
    ckf("jaccard_disjoint", j2, 0.0, 0.001)

    // KAT-12: jaccard identical -> 1.0
    let j3 = sim_jaccard_tokens("hello world", "hello world")
    ckf("jaccard_identical", j3, 1.0, 0.001)

    // KAT-13: jaccard subset: "a b" vs "a b c" -> inter=2, union=3
    let j4 = sim_jaccard_tokens("a b", "a b c")
    ckf("jaccard_subset", j4, 0.6666, 0.001)

    // ── sim_cosine_tokens ─────────────────────────────────────────────────────

    // KAT-14: cosine("a a b","a b b")
    // fa={a:2,b:1}, fb={a:1,b:2}
    // dot = 2*1 + 1*2 = 4
    // |fa| = sqrt(4+1)=sqrt(5), |fb|=sqrt(1+4)=sqrt(5)
    // cosine = 4/5 = 0.8
    let c1 = sim_cosine_tokens("a a b", "a b b")
    ckf("cosine_aab_abb", c1, 0.8, 0.001)

    // KAT-15: cosine identical -> 1.0
    let c2 = sim_cosine_tokens("hello world", "hello world")
    ckf("cosine_identical", c2, 1.0, 0.001)

    // KAT-16: cosine disjoint -> 0.0
    let c3 = sim_cosine_tokens("foo bar", "baz qux")
    ckf("cosine_disjoint", c3, 0.0, 0.001)

    // KAT-17: cosine("a b c","a b c d") known value
    // fa={a:1,b:1,c:1}, fb={a:1,b:1,c:1,d:1}
    // dot = 1+1+1 = 3
    // |fa| = sqrt(3), |fb| = sqrt(4) = 2
    // cosine = 3 / (sqrt(3)*2) = 3 / (1.7320508...*2) = 3/3.4641016 ~ 0.86602
    let c4 = sim_cosine_tokens("a b c", "a b c d")
    ckf("cosine_subset", c4, 0.86602, 0.001)

    print("_similarity_test passed")
