// KAT test for std/numeric/derivative
import std/numeric/derivative

// Named test functions (no closures — pass by name)
fn fsq(x) -> float
    let r = x * x
    return r

fn fcube(x) -> float
    let r = x * x * x
    return r

// Helper: float abs via if/else (abs() returns int in NOVA)
fn _dt_fabs(v) -> float
    if v < 0.0
        return v * -1.0
    return v

fn main()
    let eps1 = 0.001
    let eps2 = 0.01

    // KAT 1: dv_central(fsq, 3.0, 0.001) == 6.0  (d/dx x^2 = 2x = 6 at x=3)
    let r1 = dv_central(fsq, 3.0, 0.001)
    let e1 = _dt_fabs(r1 - 6.0)
    if e1 > eps1
        print("FAIL KAT1 dv_central(fsq,3) expected 6.0 got " + str(r1))
        exit(1)

    // KAT 2: dv_central(fcube, 2.0, 0.001) == 12.0  (d/dx x^3 = 3x^2 = 12 at x=2)
    let r2 = dv_central(fcube, 2.0, 0.001)
    let e2 = _dt_fabs(r2 - 12.0)
    if e2 > eps1
        print("FAIL KAT2 dv_central(fcube,2) expected 12.0 got " + str(r2))
        exit(1)

    // KAT 3: dv_second(fsq, 3.0, 0.01) == 2.0  (d^2/dx^2 x^2 = 2)
    let r3 = dv_second(fsq, 3.0, 0.01)
    let e3 = _dt_fabs(r3 - 2.0)
    if e3 > eps2
        print("FAIL KAT3 dv_second(fsq,3) expected 2.0 got " + str(r3))
        exit(1)

    // KAT 4: dv_forward(fsq, 5.0, 0.0001) ~= 10.0  (d/dx x^2 = 2x = 10 at x=5, eps 0.01)
    let r4 = dv_forward(fsq, 5.0, 0.0001)
    let e4 = _dt_fabs(r4 - 10.0)
    if e4 > eps2
        print("FAIL KAT4 dv_forward(fsq,5) expected ~10.0 got " + str(r4))
        exit(1)

    // KAT 5: dv_central(fcube, 1.0, 0.001) == 3.0  (d/dx x^3 = 3x^2 = 3 at x=1)
    let r5 = dv_central(fcube, 1.0, 0.001)
    let e5 = _dt_fabs(r5 - 3.0)
    if e5 > eps1
        print("FAIL KAT5 dv_central(fcube,1) expected 3.0 got " + str(r5))
        exit(1)

    // KAT 6: dv_second(fcube, 2.0, 0.01) == 12.0  (d^2/dx^2 x^3 = 6x = 12 at x=2)
    let r6 = dv_second(fcube, 2.0, 0.01)
    let e6 = _dt_fabs(r6 - 12.0)
    if e6 > eps2
        print("FAIL KAT6 dv_second(fcube,2) expected 12.0 got " + str(r6))
        exit(1)

    print("_derivative_test passed")
