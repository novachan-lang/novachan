// KAT for std/encoding/percent — RFC 3986 URL percent-encoding (binary-safe).
import std/encoding/percent

fn _b(s: string) -> any
    let o = bytes(0)
    let i = 0
    while i < len(s)
        o = bytes_append(o, ord(char_at(s, i)))
        i = i + 1
    return o

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": '" + got + "' != '" + want + "'")
        exit(1)

fn main()
    cks("hello", percent_encode(_b("hello")), "hello")
    cks("space", percent_encode(_b("a b")), "a%20b")
    cks("url", percent_encode(_b("a/b?c=d")), "a%2Fb%3Fc%3Dd")
    cks("unreserved", percent_encode(_b("~-._")), "~-._")
    let bin = bytes(0)
    bin = bytes_append(bin, 0)
    bin = bytes_append(bin, 255)
    cks("binary", percent_encode(bin), "%00%FF")
    // decode "a%20b" -> "a b"
    let d = percent_decode("a%20b")
    if bytes_len(d) != 3 or bytes_get(d, 0) != 97 or bytes_get(d, 1) != 32 or bytes_get(d, 2) != 98
        print("FAIL decode a%20b")
        exit(1)
    // round-trip binary [0x00,0x2F,0xFF,0x41]
    let x = bytes(0)
    x = bytes_append(x, 0)
    x = bytes_append(x, 47)
    x = bytes_append(x, 255)
    x = bytes_append(x, 65)
    let rt = percent_decode(percent_encode(x))
    if bytes_len(rt) != 4 or bytes_get(rt, 0) != 0 or bytes_get(rt, 1) != 47 or bytes_get(rt, 2) != 255 or bytes_get(rt, 3) != 65
        print("FAIL round-trip")
        exit(1)
    print("_percent_test passed")
