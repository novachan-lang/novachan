// float_from_bits / f32_from_bits reinterpret builtins + MySQL binary FLOAT/DOUBLE decode.
import forge_mysql

fn _b(vals: list) -> any
    let out = bytes(0)
    let i = 0
    while i < len(vals)
        out = bytes_append(out, vals[i])
        i = i + 1
    out

fn main()
    // float_from_bits round-trips exactly through float_bits (str -> bits -> float)
    if float_from_bits(float_bits("1.0")) != 1.0
        print("FAIL d1")
        exit(1)
    if float_from_bits(float_bits("2.5")) != 2.5
        print("FAIL d2.5")
        exit(1)
    if float_from_bits(float_bits("-3.5")) != 0.0 - 3.5
        print("FAIL dneg")
        exit(1)
    if float_from_bits(float_bits("123456.789")) != 123456.789
        print("FAIL dbig")
        exit(1)
    if float_from_bits(float_bits("0.0")) != 0.0
        print("FAIL dzero")
        exit(1)
    // f32_from_bits: exact for float32-representable values (bit patterns 0x3F800000, 0x40200000, 0xBFC00000)
    if f32_from_bits(1065353216) != 1.0
        print("FAIL f1")
        exit(1)
    if f32_from_bits(1075838976) != 2.5
        print("FAIL f2.5")
        exit(1)
    if f32_from_bits(3217031168) != 0.0 - 1.5
        print("FAIL fneg")
        exit(1)
    // real MySQL binary-protocol decode: DOUBLE -3.5 (LE 0xC00C000000000000), 2.5, FLOAT 2.5
    let dneg = mysql_bin_val(_b([0, 0, 0, 0, 0, 0, 12, 192]), 0, 5)
    if dneg[0] != "-3.5" or dneg[1] != 8
        print("FAIL mysql-dneg: '" + dneg[0] + "'")
        exit(1)
    let d25 = mysql_bin_val(_b([0, 0, 0, 0, 0, 0, 4, 64]), 0, 5)
    if d25[0] != "2.5"
        print("FAIL mysql-d2.5: '" + d25[0] + "'")
        exit(1)
    let f25 = mysql_bin_val(_b([0, 0, 32, 64]), 0, 4)
    if f25[0] != "2.5" or f25[1] != 4
        print("FAIL mysql-f2.5: '" + f25[0] + "'")
        exit(1)
    print("PASS _fbits_test")
