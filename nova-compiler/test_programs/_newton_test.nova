import std/numeric/newton

// ── named test functions ──────────────────────────────────────────────────────
// IMPORTANT: Functions used with nt_root_auto that call builtins (cos, exp, etc.)
// must be defined BEFORE other polynomial functions due to a NOVA HOF dispatch
// bug where the function table offset shifts with each additional definition.
// Functions passed as the SECOND HOF call in a sequence must be at low indices.

// fcos: f(x) = cos(x) - x, root at Dottie ≈ 0.739085
// Defined FIRST so it's at the lowest function index (index 0).
fn fcos(x) -> float
    let v = cos(x) - x
    return v

// fexp: f(x) = exp(x) - 3, root at ln(3) ≈ 1.09861
// Defined second for same HOF-dispatch reason.
fn fexp(x) -> float
    let v = exp(x) - 3.0
    return v

// fsq: f(x) = x^2 - 2, root at sqrt(2) ≈ 1.41421
fn fsq(x) -> float
    let v = x * x - 2.0
    return v

// dfsq: f'(x) = 2*x  (uses x — required for HOF float-return safety)
fn dfsq(x) -> float
    let v = 2.0 * x
    return v

// fc: f(x) = x^3 - 8, root at 2.0
fn fc(x) -> float
    let v = x * x * x - 8.0
    return v

// dfc: f'(x) = 3*x^2  (uses x — required for HOF float-return safety)
fn dfc(x) -> float
    let v = 3.0 * x * x
    return v

// ── helper ───────────────────────────────────────────────────────────────────

fn ckf(label, got, expected, eps)
    let diff = got - expected
    let adiff = diff
    if diff < 0.0
        let adiff = 0.0 - diff
    if adiff > eps
        print("FAIL: " + label + " got=" + str(got) + " expected=" + str(expected) + " eps=" + str(eps))
        exit(1)

// ── KAT suite ────────────────────────────────────────────────────────────────

fn main()
    let eps = 0.001

    // KAT 1: nt_root analytic — sqrt(2) from x^2-2, x0=1.0
    // Spec-required: nt_root(fsq,dfsq,1.0,0.0001,50)==1.41421
    let r1 = newton.nt_root(fsq, dfsq, 1.0, 0.0001, 50)
    ckf("nt_root sqrt2", r1, 1.41421, eps)

    // KAT 2: nt_root_auto — sqrt(2), x0=1.0
    let r2 = newton.nt_root_auto(fsq, 1.0, 0.0001)
    ckf("nt_root_auto sqrt2", r2, 1.41421, eps)

    // KAT 3: nt_root analytic — cube root of 8 = 2.0
    // Spec-required: nt_root(fc,dfc,1.0,0.0001,50)==2.0
    let r3 = newton.nt_root(fc, dfc, 1.0, 0.0001, 50)
    ckf("nt_root cbrt8", r3, 2.0, eps)

    // KAT 4: nt_root_auto — cube root of 8
    let r4 = newton.nt_root_auto(fc, 1.0, 0.0001)
    ckf("nt_root_auto cbrt8", r4, 2.0, eps)

    // KAT 5: nt_root_auto — Dottie number cos(x)=x, root ≈ 0.739085
    // fcos defined first in file (index 0) to work around HOF dispatch bug
    let r5 = newton.nt_root_auto(fcos, 0.5, 0.0001)
    ckf("nt_root_auto dottie", r5, 0.739085, eps)

    // KAT 6: nt_root_auto — exp(x)=3, root ln(3) ≈ 1.09861
    let r6 = newton.nt_root_auto(fexp, 1.0, 0.0001)
    ckf("nt_root_auto exp3", r6, 1.09861, eps)

    // KAT 7: nt_root — sqrt(2) from x0=2.0 (approach from right)
    let r7 = newton.nt_root(fsq, dfsq, 2.0, 0.0001, 50)
    ckf("nt_root sqrt2 right", r7, 1.41421, eps)

    // KAT 8: nt_root_auto — sqrt(2) from x0=2.0
    let r8 = newton.nt_root_auto(fsq, 2.0, 0.0001)
    ckf("nt_root_auto sqrt2 right", r8, 1.41421, eps)

    print("_newton_test passed")
