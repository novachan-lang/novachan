fn strip_html(text)
  let out = ""
  let in_tag = 0
  let i = 0
  while i < len(text)
    let ch = slice(text, i, i + 1)
    if ch == "<"
      in_tag = 1
    else if ch == ">"
      in_tag = 0
    else if in_tag == 0
      out = out + ch
    i = i + 1
  out

fn escape_sql(text)
  let out = ""
  let i = 0
  while i < len(text)
    let ch = slice(text, i, i + 1)
    if ch == "'"
      out = out + "''"
    else if ch == "\\"
      out = out + "\\\\"
    else
      out = out + ch
    i = i + 1
  out

fn normalize_whitespace(text)
  let out = ""
  let prev_space = 0
  let i = 0
  while i < len(text)
    let ch = slice(text, i, i + 1)
    if ch == " " or ch == "\t" or ch == "\n" or ch == "\r"
      if prev_space == 0 and len(out) > 0
        out = out + " "
        prev_space = 1
    else
      out = out + ch
      prev_space = 0
    i = i + 1
  if len(out) > 0 and slice(out, len(out) - 1, len(out)) == " "
    out = slice(out, 0, len(out) - 1)
  out

fn truncate_safe(text, max_len)
  if len(text) <= max_len
    return text
  if max_len <= 3
    return slice(text, 0, max_len)
  slice(text, 0, max_len - 3) + "..."

fn main()
  assert(strip_html("<b>bold</b>") == "bold", "strip tags")
  assert(strip_html("<a href='x'>link</a>") == "link", "strip link")
  assert(strip_html("no tags") == "no tags", "no tags")
  assert(strip_html("<p>Hello</p> <b>World</b>") == "Hello World", "multi tags")

  assert(escape_sql("it's") == "it''s", "escape single quote")
  assert(escape_sql("hello") == "hello", "no escaping needed")
  assert(escape_sql("a'b'c") == "a''b''c", "multiple quotes")

  assert(normalize_whitespace("  hello   world  ") == "hello world", "normalize spaces")
  assert(normalize_whitespace("a\t\tb") == "a b", "normalize tabs")
  assert(normalize_whitespace("   ") == "", "all whitespace")
  assert(normalize_whitespace("no  extra  spaces") == "no extra spaces", "collapse")

  assert(truncate_safe("Hello World", 8) == "Hello...", "truncate")
  assert(truncate_safe("Hi", 10) == "Hi", "no truncate needed")
  assert(truncate_safe("abcdef", 3) == "abc", "short truncate")

  print("sanitx: all passed")
