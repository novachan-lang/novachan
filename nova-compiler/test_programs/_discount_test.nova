import std/money/discount

fn _cki(label: string, got: int, want: int)
    if got != want
        print("FAIL discount " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // KAT 1: 25% off 100.00 -> 75.00
    _cki("disc_pct_10000_2500", disc_pct(10000, 2500), 7500)

    // KAT 2: discount amount only
    _cki("disc_pct_amount_10000_2500", disc_pct_amount(10000, 2500), 2500)

    // KAT 3: fixed discount
    _cki("disc_fixed_10000_1500", disc_fixed(10000, 1500), 8500)

    // KAT 4: fixed discount floored at 0 when off > amount
    _cki("disc_fixed_1000_1500_floor", disc_fixed(1000, 1500), 0)

    // KAT 5: compound 10% then 10%: 10000 -> 9000 -> 8100
    let bps2 = []
    push(bps2, 1000)
    push(bps2, 1000)
    _cki("disc_compound_10pct_10pct", disc_compound(10000, bps2), 8100)

    // KAT 6: best of 10% (saves 1000) vs fixed 15.00 (saves 1500) -> fixed wins -> 8500
    _cki("disc_best_10000_1000bps_1500", disc_best(10000, 1000, 1500), 8500)

    // KAT 7: tiered - 15000 >= 10000 tier -> 5% off -> 14250
    let thresholds = []
    push(thresholds, 0)
    push(thresholds, 10000)
    push(thresholds, 20000)
    let bps_tiers = []
    push(bps_tiers, 0)
    push(bps_tiers, 500)
    push(bps_tiers, 1000)
    _cki("disc_tiered_15000", disc_tiered(15000, thresholds, bps_tiers), 14250)

    // KAT 8: tiered - 5000 only hits first tier (0 bps) -> no discount
    _cki("disc_tiered_5000_no_discount", disc_tiered(5000, thresholds, bps_tiers), 5000)

    // KAT 9: tiered - 25000 hits top tier (1000 bps = 10%) -> 22500
    _cki("disc_tiered_25000_top_tier", disc_tiered(25000, thresholds, bps_tiers), 22500)

    // KAT 10: disc_markup: cost=5000 margin=5000 bps (50%) -> 5000*10000/5000 = 10000
    _cki("disc_markup_50pct", disc_markup(5000, 5000), 10000)

    // KAT 11: disc_markup 0% margin -> price = cost
    _cki("disc_markup_0pct", disc_markup(5000, 0), 5000)

    // KAT 12: disc_pct 0 bps -> no change
    _cki("disc_pct_zero_bps", disc_pct(10000, 0), 10000)

    // KAT 13: disc_pct 10000 bps (100% off) -> 0
    _cki("disc_pct_100pct", disc_pct(10000, 10000), 0)

    // KAT 14: compound with empty list -> unchanged
    let empty_bps = []
    _cki("disc_compound_empty", disc_compound(10000, empty_bps), 10000)

    // KAT 15: best - pct wins: 50% off 10000 = 5000 vs fixed 1000 off = 9000
    _cki("disc_best_pct_wins", disc_best(10000, 5000, 1000), 5000)

    // KAT 16: negative amount: disc_pct_amount(-10000, 2500) must be -2500 (not -2499)
    _cki("disc_pct_amount_neg", disc_pct_amount(-10000, 2500), -2500)

    // KAT 17: negative disc_pct: -10000 - (-2500) = -7500
    _cki("disc_pct_neg", disc_pct(-10000, 2500), -7500)

    print("PASS _discount_test")
