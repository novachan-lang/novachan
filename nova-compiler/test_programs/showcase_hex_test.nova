// showcase_hex -- a binary/bytes codec in pure NOVA: bytes <-> hex string, plus a byte-wise XOR. A
// NINTH angle: the BYTES value type (bytes(n), bytes_get, index-set, bytes_len, str_to_bytes) with
// integer bit arithmetic (/16 = >>4, %16 = &15). Round-trip self-verifying.

fn hexchar(v: int) -> string
    return slice("0123456789abcdef", v, v + 1)

fn to_hex(b) -> string
    let s = ""
    let i = 0
    while i < bytes_len(b)
        let byte = bytes_get(b, i)
        s = s + hexchar(byte / 16) + hexchar(byte % 16)
        i = i + 1
    return s

fn hexval(c: string) -> int
    return find("0123456789abcdef", c)   // position in the table == nibble value

fn from_hex(s: string) -> any
    let n = len(s) / 2
    let b = bytes(n)
    let i = 0
    while i < n
        let hi = hexval(slice(s, i * 2, i * 2 + 1))
        let lo = hexval(slice(s, i * 2 + 1, i * 2 + 2))
        b[i] = hi * 16 + lo
        i = i + 1
    return b

fn bytes_eq(a, b) -> int
    if bytes_len(a) != bytes_len(b)
        return 0
    let i = 0
    while i < bytes_len(a)
        if bytes_get(a, i) != bytes_get(b, i)
            return 0
        i = i + 1
    return 1

// byte-wise XOR of two equal-length buffers (the crypto workhorse).
fn xor_bytes(a, b) -> any
    let n = bytes_len(a)
    let out = bytes(n)
    let i = 0
    while i < n
        let x = bytes_get(a, i)
        let y = bytes_get(b, i)
        out[i] = x ^ y
        i = i + 1
    return out

fn main()
    let b = str_to_bytes("Hello")
    let hex = to_hex(b)
    print("to_hex('Hello') = " + hex + " (want 48656c6c6f)")
    assert(hex == "48656c6c6f", "Hello encodes to 48656c6c6f")

    let back = from_hex(hex)
    assert(bytes_eq(back, b) == 1, "hex round-trips back to the original bytes")
    assert(bytes_len(back) == 5, "decoded length is 5")

    // XOR round-trip: (a xor k) xor k == a  (the one-time-pad identity)
    let msg = str_to_bytes("secret")
    let key6 = from_hex("010203040506")
    let ct = xor_bytes(msg, key6)
    let pt = xor_bytes(ct, key6)
    assert(bytes_eq(pt, msg) == 1, "xor with the same key round-trips (OTP identity)")
    assert(bytes_eq(ct, msg) == 0, "ciphertext differs from plaintext")

    // a specific byte check: 'H'(0x48) xor 0x01 = 0x49
    let one = from_hex("01")
    let h = from_hex("48")
    let x = xor_bytes(h, one)
    assert(bytes_get(x, 0) == 73, "0x48 xor 0x01 = 0x49 (73)")

    print("showcase_hex_test passed -- bytes<->hex codec + XOR, pure NOVA binary")
