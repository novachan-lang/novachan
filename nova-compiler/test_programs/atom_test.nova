// Atoms: `:name` interned-symbol literals — concise, readable tags for statuses,
// commands, and message kinds. Lowered to the canonical string ":name", so they
// work in ==, print, match arms, and as map/list elements. (Lexer disambiguates
// `:name` atoms from the type/dict-annotation colon by previous-token + next-char.)

fn handle(cmd: string) -> string
    match cmd
        :start => "starting"
        :stop => "stopping"
        _ => "unknown"

fn main()
    // atom value + equality
    let status = :ok
    assert_eq(status == :ok, true)
    assert_eq(status == :err, false)

    // print/str shows the colon form
    assert_eq(str(:ready), ":ready")

    // atoms as match patterns (passed as args)
    assert_eq(handle(:start), "starting")
    assert_eq(handle(:stop), "stopping")
    assert_eq(handle(:other), "unknown")

    // atoms as dict keys
    let d = {}
    d[:name] = "nova"
    d[:kind] = "lang"
    assert_eq(d[:name], "nova")
    assert_eq(d[:kind], "lang")

    // atoms in a list
    let tags = [:a, :b, :c]
    assert_eq(tags[1], :b)
    assert_eq(len(tags), 3)

    // a dict-literal key colon still works alongside atoms (disambiguation:
    // ':' after a value/string stays COLON, not an atom)
    let m = {"a": 1, "b": 2}
    assert_eq(m["a"], 1)
    assert_eq(m["b"], 2)

    print("atom_test passed")
