import std/encoding/asn1
import std/encoding/hex

fn ck(label: string, got: string, want: string)
    let ok = "FAIL"
    if got == want
        ok = "ok"
    print(label + "=" + ok + " (got=" + got + " want=" + want + ")")

fn ck_str(label: string, got: string, want: string)
    let ok = "FAIL"
    if got == want
        ok = "ok"
    print(label + "=" + ok + " (got='" + got + "' want='" + want + "')")

fn ck_int(label: string, got: int, want: int)
    let ok = "FAIL"
    if got == want
        ok = "ok"
    print(label + "=" + ok + " (got=" + str(got) + " want=" + str(want) + ")")

fn main()
    // ── ADVERSARIAL PROBE #1: OID with a multi-byte FIRST identifier ────
    // X.690's own canonical textbook example: OID 2.999.3.
    // combined = 40*arc1 + arc2 = 40*2 + 999 = 1079, which does NOT fit in
    // one byte (>127) and therefore MUST itself be base-128 chained just
    // like any other arc. Independently hand-derived:
    //   1079 = 0x437; base-128 groups: hi=8 (1079>>7), lo=55 (1079&0x7F)
    //   -> bytes 0x88 (0x80|8, continuation) 0x37 (55, terminal)
    // then arc 3 -> single byte 0x03.
    // content = 88 37 03  (3 bytes) -> tag 06, len 03 -> 06 03 88 37 03
    let oidBig = asn1_encode_oid("2.999.3")
    ck("adv_oid_2_999_3_bytes", hex_encode(oidBig), "0603883703")
    let oidBigDec = asn1_decode_oid(oidBig, 0)
    ck_str("adv_oid_2_999_3_roundtrip", oidBigDec[0], "2.999.3")

    // ── ADVERSARIAL PROBE #2: boundary case, combined == 128 exactly ────
    // OID "2.48" -> combined = 40*2+48 = 128 (smallest value that needs
    // 2 bytes). Base-128: hi=1 (128>>7), lo=0 (128&0x7F)
    // -> bytes 0x81 (0x80|1) 0x00 -> content = 81 00, tag 06 len 02.
    let oidBoundary = asn1_encode_oid("2.48")
    ck("adv_oid_2_48_bytes", hex_encode(oidBoundary), "06028100")
    let oidBoundaryDec = asn1_decode_oid(oidBoundary, 0)
    ck_str("adv_oid_2_48_roundtrip", oidBoundaryDec[0], "2.48")

    // ── ADVERSARIAL PROBE #3: just-below-boundary sanity (combined==127,
    // arc1=2, arc2=47) -- must still fit ONE byte and round-trip fine, to
    // isolate that the bug is specifically the >=128 case, not arc1=2 as
    // a whole.
    let oidJustBelow = asn1_encode_oid("2.47")
    ck("adv_oid_2_47_bytes", hex_encode(oidJustBelow), "06017f")
    let oidJustBelowDec = asn1_decode_oid(oidJustBelow, 0)
    ck_str("adv_oid_2_47_roundtrip", oidJustBelowDec[0], "2.47")

    print("DONE")
