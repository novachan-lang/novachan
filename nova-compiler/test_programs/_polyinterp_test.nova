import std/poly/polyinterp

fn approx(a, b, tol) -> bool
    let diff = a - b
    if diff < 0.0
        diff = 0.0 - diff
    if diff <= tol
        return true
    return false

fn ckf(label, got, want, tol)
    if approx(got * 1.0, want * 1.0, tol) == false
        print("FAIL polyinterp " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL polyinterp " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    if got != want
        print("FAIL polyinterp " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    let tol = 0.0001

    // KAT 1: pi_lagrange([0,1,2],[0,1,4]) == [0,0,1]  (y=x^2)
    let xs1 = [0.0, 1.0, 2.0]
    let ys1 = [0.0, 1.0, 4.0]
    let c1 = pi_lagrange(xs1, ys1)
    cki("lagrange_x2_len", len(c1), 3)
    ckf("lagrange_x2_c0", c1[0] * 1.0, 0.0, tol)
    ckf("lagrange_x2_c1", c1[1] * 1.0, 0.0, tol)
    ckf("lagrange_x2_c2", c1[2] * 1.0, 1.0, tol)

    // KAT 2: pi_lagrange([0,1],[3,5]) == [3,2]  (line 3+2x)
    let xs2 = [0.0, 1.0]
    let ys2 = [3.0, 5.0]
    let c2 = pi_lagrange(xs2, ys2)
    cki("lagrange_line_len", len(c2), 2)
    ckf("lagrange_line_c0", c2[0] * 1.0, 3.0, tol)
    ckf("lagrange_line_c1", c2[1] * 1.0, 2.0, tol)

    // KAT 3: pi_eval_lagrange([0,1,2],[0,1,4], 3.0) == 9.0  (x^2 at 3)
    let ev3 = pi_eval_lagrange(xs1, ys1, 3.0)
    ckf("eval_lagrange_x2_at3", ev3, 9.0, tol)

    // KAT 4: pi_verify([0,1,2],[0,1,4], 0.0001) == true
    let ok4 = pi_verify(xs1, ys1, 0.0001)
    ckb("verify_x2", ok4, true)

    // KAT 5: pi_lagrange([1,2,3],[1,8,27]) passes through (1,1),(2,8),(3,27)
    // (3 points -> degree-2 poly; not x^3 but passes through those samples)
    let xs5 = [1.0, 2.0, 3.0]
    let ys5 = [1.0, 8.0, 27.0]
    let ok5 = pi_verify(xs5, ys5, tol)
    ckb("verify_cubic_pts", ok5, true)

    // KAT 6: pi_fit_degree of 3 points == 2
    let deg6 = pi_fit_degree(xs1, ys1)
    cki("fit_degree_3pts", deg6, 2)

    // KAT 7: pi_fit_degree of 2 points == 1
    let deg7 = pi_fit_degree(xs2, ys2)
    cki("fit_degree_2pts", deg7, 1)

    // KAT 8: pi_eval_lagrange([0,1],[3,5], 2.0) == 7.0  (3+2*2=7)
    let ev8 = pi_eval_lagrange(xs2, ys2, 2.0)
    ckf("eval_lagrange_line_at2", ev8, 7.0, tol)

    // KAT 9: pi_divided_differences([0,1,2],[0,1,4]) leading col = [0,1,1]
    let dd9 = pi_divided_differences(xs1, ys1)
    cki("dd_len", len(dd9), 3)
    ckf("dd_0", dd9[0] * 1.0, 0.0, tol)
    ckf("dd_1", dd9[1] * 1.0, 1.0, tol)
    ckf("dd_2", dd9[2] * 1.0, 1.0, tol)

    // KAT 10: pi_newton_divided([0,1,2],[0,1,4]) matches pi_lagrange
    let cn10 = pi_newton_divided(xs1, ys1)
    cki("newton_len", len(cn10), 3)
    ckf("newton_c0", cn10[0] * 1.0, 0.0, tol)
    ckf("newton_c1", cn10[1] * 1.0, 0.0, tol)
    ckf("newton_c2", cn10[2] * 1.0, 1.0, tol)

    // KAT 11: round-trip — pi_eval_lagrange at each node matches sample
    let xs11 = [0.0, 1.0, 3.0]
    let ys11 = [2.0, 5.0, 11.0]
    let ev11a = pi_eval_lagrange(xs11, ys11, 0.0)
    let ev11b = pi_eval_lagrange(xs11, ys11, 1.0)
    let ev11c = pi_eval_lagrange(xs11, ys11, 3.0)
    ckf("roundtrip_node0", ev11a, 2.0, tol)
    ckf("roundtrip_node1", ev11b, 5.0, tol)
    ckf("roundtrip_node2", ev11c, 11.0, tol)

    print("PASS _polyinterp_test")
