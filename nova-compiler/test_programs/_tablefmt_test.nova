// KAT for std/text/tablefmt -- ASCII table renderer.
// All expected values are HAND-COMPUTED from the spec.
import std/text/tablefmt

// Check string equality; print FAIL and exit(1) on mismatch.
fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

// Check int equality; print FAIL and exit(1) on mismatch.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── KAT 1: canonical 2-col, 2-row table ─────────────────────────────────
    // headers=["A","BB"]  rows=[["1","2"],["xxx","y"]]
    //
    // col0 width = max(len("A")=1, len("1")=1, len("xxx")=3) = 3
    // col1 width = max(len("BB")=2, len("2")=1, len("y")=1)  = 2
    //
    // header  : ljust("A",3)+" | "+ljust("BB",2)  = "A  " + " | " + "BB"  = "A   | BB"
    // sep     : "---" + "-+-" + "--"              = "----+---"            (8 chars)
    // row 0   : ljust("1",3)+" | "+ljust("2",2)   = "1  " + " | " + "2 " = "1   | 2 "
    // row 1   : ljust("xxx",3)+" | "+ljust("y",2) = "xxx" + " | " + "y " = "xxx | y "
    let hdrs = ["A", "BB"]
    let row0 = ["1", "2"]
    let row1 = ["xxx", "y"]
    let data_rows = [row0, row1]
    let result = tbl_render(hdrs, data_rows)

    // 4 lines total (header + sep + 2 data rows)
    let lines = split(result, chr(10))
    cki("line-count", len(lines), 4)

    // exact line checks
    cks("header-line",    lines[0], "A   | BB")
    cks("separator-line", lines[1], "----+---")
    cks("row0-line",      lines[2], "1   | 2 ")
    cks("row1-line",      lines[3], "xxx | y ")

    // KAT 1b: "A" cell is left-padded to width 3 -- the header line starts with "A  "
    cks("header-A-cell", slice(lines[0], 0, 3), "A  ")

    // ── KAT 2: single-column table ──────────────────────────────────────────
    // headers=["Name"]  rows=[["Alice"],["Bo"]]
    // col0 width = max(len("Name")=4, len("Alice")=5, len("Bo")=2) = 5
    // header : ljust("Name",5)   = "Name "
    // sep    : "-----"
    // row0   : ljust("Alice",5)  = "Alice"
    // row1   : ljust("Bo",5)     = "Bo   "
    let s1 = tbl_render(["Name"], [["Alice"], ["Bo"]])
    let s1_lines = split(s1, chr(10))
    cki("single-col-line-count", len(s1_lines), 4)
    cks("single-col-header",  s1_lines[0], "Name ")
    cks("single-col-sep",     s1_lines[1], "-----")
    cks("single-col-row0",    s1_lines[2], "Alice")
    cks("single-col-row1",    s1_lines[3], "Bo   ")

    // ── KAT 3: header wider than any cell ───────────────────────────────────
    // headers=["Category","Value"]  rows=[["a","1"]]
    // col0 width = max(len("Category")=8, len("a")=1) = 8
    // col1 width = max(len("Value")=5, len("1")=1) = 5
    //
    // header : ljust("Category",8)+" | "+ljust("Value",5)
    //        = "Category" + " | " + "Value"  = "Category | Value"   (16 chars)
    // sep    : "--------" + "-+-" + "-----"
    //          pos 1-8: 8 dashes
    //          pos 9-11: "-+-" => pos9='-' pos10='+' pos11='-'
    //          pos 12-16: "-----" => 5 dashes
    //          = "---------+------"  (9 dashes, +, 6 dashes; 16 chars)
    // row0   : ljust("a",8)+" | "+ljust("1",5)
    //        = "a       " + " | " + "1    "  = "a        | 1    "  (16 chars)
    let s2 = tbl_render(["Category", "Value"], [["a", "1"]])
    let s2_lines = split(s2, chr(10))
    cki("wide-header-line-count", len(s2_lines), 3)
    cks("wide-header", s2_lines[0], "Category | Value")
    cks("wide-sep",    s2_lines[1], "---------+------")
    cks("wide-row0",   s2_lines[2], "a        | 1    ")

    // ── KAT 4: no data rows (header + separator only) ────────────────────────
    // headers=["X","Y"]  rows=[]
    // col0 width = len("X") = 1 , col1 width = len("Y") = 1
    // header : "X | Y"
    // sep    : "-" + "-+-" + "-" = "---+-" ... char by char:
    //          "-": 1 dash; "-+-": '-','+',' '; "-": 1 dash
    //          pos1='-' pos2='-' pos3='+' pos4='-' pos5='-'
    //          = "--+--"  (5 chars)
    // (2 lines total)
    let s3 = tbl_render(["X", "Y"], [])
    let s3_lines = split(s3, chr(10))
    cki("empty-rows-line-count", len(s3_lines), 2)
    cks("empty-rows-header", s3_lines[0], "X | Y")
    cks("empty-rows-sep",    s3_lines[1], "--+--")

    // ── KAT 5: three-column table ────────────────────────────────────────────
    // headers=["ID","Name","Score"]  rows=[["1","Alice","100"],["22","Bo","9"]]
    // col0 width = max(len("ID")=2, len("1")=1, len("22")=2) = 2
    // col1 width = max(len("Name")=4, len("Alice")=5, len("Bo")=2) = 5
    // col2 width = max(len("Score")=5, len("100")=3, len("9")=1) = 5
    //
    // header : ljust("ID",2)+" | "+ljust("Name",5)+" | "+ljust("Score",5)
    //        = "ID" + " | " + "Name " + " | " + "Score"  = "ID | Name  | Score"  (18 chars)
    //
    // sep    : "--" + "-+-" + "-----" + "-+-" + "-----"
    //   pos 1-2:   "--"     (2 dashes)
    //   pos 3-5:   "-+-"    => 3='-' 4='+' 5='-'
    //   pos 6-10:  "-----"  (5 dashes)
    //   pos 11-13: "-+-"    => 11='-' 12='+' 13='-'
    //   pos 14-18: "-----"  (5 dashes)
    //   Reading:   ---+-------+------   -> "---+-------+------"  (18 chars)
    //   Verify: '+' at pos4, '+' at pos12
    //           3 dashes before first '+', 7 dashes between '+', 6 dashes after
    //           3+1+7+1+6 = 18 ✓
    //
    // row0 : ljust("1",2)+" | "+ljust("Alice",5)+" | "+ljust("100",5)
    //      = "1 " + " | " + "Alice" + " | " + "100  "  = "1  | Alice | 100  "  (18 chars)
    // row1 : ljust("22",2)+" | "+ljust("Bo",5)+" | "+ljust("9",5)
    //      = "22" + " | " + "Bo   " + " | " + "9    "  = "22 | Bo    | 9    "  (18 chars)
    let s4 = tbl_render(["ID", "Name", "Score"], [["1", "Alice", "100"], ["22", "Bo", "9"]])
    let s4_lines = split(s4, chr(10))
    cki("three-col-line-count", len(s4_lines), 4)
    cks("three-col-header", s4_lines[0], "ID | Name  | Score")
    cks("three-col-sep",    s4_lines[1], "---+-------+------")
    cks("three-col-row0",   s4_lines[2], "1  | Alice | 100  ")
    cks("three-col-row1",   s4_lines[3], "22 | Bo    | 9    ")

    // ── KAT 6: equal-width header and data ──────────────────────────────────
    // headers=["Hi"]  rows=[["Hi"]]
    // col0 width = max(2,2) = 2
    // header : "Hi"
    // sep    : "--"
    // row0   : "Hi"
    let s5 = tbl_render(["Hi"], [["Hi"]])
    let s5_lines = split(s5, chr(10))
    cki("equal-width-line-count", len(s5_lines), 3)
    cks("equal-width-header", s5_lines[0], "Hi")
    cks("equal-width-sep",    s5_lines[1], "--")
    cks("equal-width-row0",   s5_lines[2], "Hi")

    print("_tablefmt_test passed")
