@log
fn process_data(x: int) -> int
    return x * 2

@log
fn greet(name: string) -> string
    return "hello " + name

fn main()
    let r = process_data(21)
    assert(r == 42, "log does not change result")

    let g = greet("Nova")
    assert(g == "hello Nova", "log greet works")

    print("LOG ANNOTATION TEST PASS")
