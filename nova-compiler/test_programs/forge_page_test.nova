// functional: keyset (cursor) pagination page_build has_more / next_cursor / sentinel-drop
import forge

fn main()
    let p1 = forge.page_build([1, 2, 3, 4], 3, "k3")
    if p1.has_more != true
        print("FAIL has_more")
        exit(1)
    if len(p1.items) != 3
        print("FAIL truncate = " + str(len(p1.items)))
        exit(1)
    if forge.cursor_decode(p1.next_cursor) != "k3"
        print("FAIL cursor decode = " + forge.cursor_decode(p1.next_cursor))
        exit(1)
    let p2 = forge.page_build([1, 2], 3, "k2")
    if p2.has_more != false
        print("FAIL last page has_more")
        exit(1)
    if p2.next_cursor != ""
        print("FAIL last page cursor")
        exit(1)
    if len(p2.items) != 2
        print("FAIL last page items")
        exit(1)
    print("PASS forge_page")
