import forge_feature_flag_group

fn main()
    let f = ffg_new()
    f = ffg_add_group(f, "frontend")
    f = ffg_add_group(f, "backend")
    assert(ffg_group_count(f) == 2, "2 groups")

    let r1 = ffg_add_flag(f, "frontend", "dark_mode", 1)
    assert(is_ok(r1), "add flag ok")
    f = unwrap(r1)
    let r2 = ffg_add_flag(f, "frontend", "new_nav", 0)
    f = unwrap(r2)
    let r3 = ffg_add_flag(f, "backend", "cache_v2", 1)
    f = unwrap(r3)
    assert(ffg_flag_count(f) == 3, "3 flags")

    assert(ffg_is_enabled(f, "frontend", "dark_mode") == 1, "dark_mode on")
    assert(ffg_is_enabled(f, "frontend", "new_nav") == 0, "new_nav off")
    assert(ffg_is_enabled(f, "backend", "nope") == 0, "unknown flag off")

    let t = ffg_toggle(f, "frontend", "new_nav")
    assert(is_ok(t), "toggle ok")
    f = unwrap(t)
    assert(ffg_is_enabled(f, "frontend", "new_nav") == 1, "new_nav toggled on")

    assert(ffg_evaluation_count(f) == 4, "4 evaluations")

    let bad = ffg_add_flag(f, "nope", "x", 1)
    assert(is_err(bad), "group not found")

    print("FEATURE-FLAG-GROUP KAT PASS")
