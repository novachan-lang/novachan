import forge_crdt

fn main()
    // G-Counter
    let g1 = gctr_new()
    g1 = gctr_inc(g1, "node-a", 3)
    g1 = gctr_inc(g1, "node-b", 5)
    assert(gctr_value(g1) == 8, "gctr value 8")

    let g2 = gctr_new()
    g2 = gctr_inc(g2, "node-a", 2)
    g2 = gctr_inc(g2, "node-c", 4)
    assert(gctr_value(g2) == 6, "gctr value 6")

    let gm = gctr_merge(g1, g2)
    assert(gctr_value(gm) == 12, "gctr merge max(3,2)+5+4=12")

    // PN-Counter
    let pn = pnctr_new()
    pn = pnctr_inc(pn, "a", 10)
    pn = pnctr_dec(pn, "a", 3)
    assert(pnctr_value(pn) == 7, "pnctr 10-3=7")

    let pn2 = pnctr_new()
    pn2 = pnctr_inc(pn2, "b", 5)
    pn2 = pnctr_dec(pn2, "b", 1)
    let pnm = pnctr_merge(pn, pn2)
    assert(pnctr_value(pnm) == 11, "pnctr merge 10+5-(3+1)=11")

    // G-Set
    let gs1 = gset_new()
    gs1 = gset_add(gs1, "apple")
    gs1 = gset_add(gs1, "banana")
    assert(gset_contains(gs1, "apple") == 1, "gset contains apple")
    assert(gset_contains(gs1, "cherry") == 0, "gset !contains cherry")

    let gs2 = gset_new()
    gs2 = gset_add(gs2, "banana")
    gs2 = gset_add(gs2, "cherry")
    let gsm = gset_merge(gs1, gs2)
    assert(gset_contains(gsm, "apple") == 1, "gset merge has apple")
    assert(gset_contains(gsm, "banana") == 1, "gset merge has banana")
    assert(gset_contains(gsm, "cherry") == 1, "gset merge has cherry")
    assert(len(gset_elements(gsm)) == 3, "gset merge 3 elems")

    // LWW-Register
    let lw1 = lww_new("first", 100)
    let lw2 = lww_set(lw1, "second", 200)
    assert(lww_value(lw2) == "second", "lww set newer wins")
    let lw3 = lww_set(lw2, "old", 50)
    assert(lww_value(lw3) == "second", "lww set older ignored")
    let lwm = lww_merge(lww_new("x", 150), lww_new("y", 300))
    assert(lww_value(lwm) == "y", "lww merge higher ts wins")

    // MV-Register
    let mv1 = mvr_new()
    mv1 = mvr_set(mv1, "val-a", "node1", 100)
    assert(len(mvr_values(mv1)) == 1, "mvr single value")
    let mv2 = mvr_set(mvr_new(), "val-b", "node2", 100)
    let mvm = mvr_merge(mv1, mv2)
    assert(len(mvr_values(mvm)) == 2, "mvr merge concurrent = 2 values")

    print("FORGE-CRDT KAT PASS")
