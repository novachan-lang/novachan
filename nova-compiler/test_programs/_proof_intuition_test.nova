import std/proof/proof_intuition

fn cki(label, got, want)
    if got != want
        print("FAIL _proof_intuition_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL _proof_intuition_test " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL _proof_intuition_test " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    let fA = pint_var("A")
    let fB = pint_var("B")
    let fnotA = pint_not(fA)

    // === KAT 1: Law of Excluded Middle — classically valid but NOT intuitionistically valid ===
    // A | ~A is the classic example
    let lem = pint_or(fA, fnotA)
    ckb("lem_classical", pint_is_classically_valid(lem), true)
    ckb("lem_not_intuitionistic", pint_is_intuitionistically_valid(lem), false)
    ckb("lem_needs_classical", pint_needs_classical(lem), true)

    // === KAT 2: A->A is intuitionistically valid ===
    let id_f = pint_imp(fA, fA)
    ckb("AtoA_classical", pint_is_classically_valid(id_f), true)
    ckb("AtoA_intuitionistic", pint_is_intuitionistically_valid(id_f), true)
    ckb("AtoA_not_needs_classical", pint_needs_classical(id_f), false)

    // === KAT 3: A -> ~~A is intuitionistically valid ===
    // ~~A = ~(~A) = ~A -> bot, but in our representation: not(not(A))
    let dne_intro = pint_imp(fA, pint_not(pint_not(fA)))
    ckb("A_to_dne_intro_classical", pint_is_classically_valid(dne_intro), true)
    ckb("A_to_dne_intro_intuitionistic", pint_is_intuitionistically_valid(dne_intro), true)

    // === KAT 4: ~~A -> A is NOT intuitionistically valid ===
    let dne_elim = pint_imp(pint_not(pint_not(fA)), fA)
    ckb("dne_elim_classical", pint_is_classically_valid(dne_elim), true)
    ckb("dne_elim_not_intuitionistic", pint_is_intuitionistically_valid(dne_elim), false)
    ckb("dne_elim_needs_classical", pint_needs_classical(dne_elim), true)

    // === KAT 5: Modus ponens — (A -> B) -> A -> B is int-valid ===
    let mp = pint_imp(pint_imp(fA, fB), pint_imp(fA, fB))
    ckb("mp_intuitionistic", pint_is_intuitionistically_valid(mp), true)

    // === KAT 6: bot -> A (ex falso) is intuitionistically valid ===
    let ex_falso = pint_imp(pint_bot(), fA)
    ckb("ex_falso_intuitionistic", pint_is_intuitionistically_valid(ex_falso), true)

    // === KAT 7: top is intuitionistically valid ===
    let top_f = pint_top()
    ckb("top_intuitionistic", pint_is_intuitionistically_valid(top_f), true)

    // === KAT 8: A (alone) is NOT classically valid ===
    ckb("bare_A_not_classical", pint_is_classically_valid(fA), false)
    ckb("bare_A_not_intuitionistic", pint_is_intuitionistically_valid(fA), false)

    // === KAT 9: A->B->A (K axiom) is intuitionistically valid ===
    let K_ax = pint_imp(fA, pint_imp(fB, fA))
    ckb("K_axiom_intuitionistic", pint_is_intuitionistically_valid(K_ax), true)

    // === CROSS-CHECK: pint_is_classically_valid agrees with truth table for several formulas ===
    // A&B->A is a tautology
    let conj_elim = pint_imp(pint_and(fA, fB), fA)
    ckb("conj_elim_classical", pint_is_classically_valid(conj_elim), true)
    ckb("conj_elim_intuitionistic", pint_is_intuitionistically_valid(conj_elim), true)

    // A -> A|B is a tautology (classical and int)
    let disj_intro = pint_imp(fA, pint_or(fA, fB))
    ckb("disj_intro_classical", pint_is_classically_valid(disj_intro), true)
    ckb("disj_intro_intuitionistic", pint_is_intuitionistically_valid(disj_intro), true)

    // A&~A -> B (anything from contradiction) is classically valid and int-valid
    let ex_contr = pint_imp(pint_and(fA, pint_not(fA)), fB)
    ckb("ex_contr_classical", pint_is_classically_valid(ex_contr), true)
    ckb("ex_contr_intuitionistic", pint_is_intuitionistically_valid(ex_contr), true)

    // Pierce's law (A->B)->A->A: classically valid but NOT intuitionistically valid
    let pierce = pint_imp(pint_imp(pint_imp(fA, fB), fA), fA)
    ckb("pierce_classical", pint_is_classically_valid(pierce), true)
    ckb("pierce_not_intuitionistic", pint_is_intuitionistically_valid(pierce), false)
    ckb("pierce_needs_classical", pint_needs_classical(pierce), true)

    print("PASS _proof_intuition_test")
