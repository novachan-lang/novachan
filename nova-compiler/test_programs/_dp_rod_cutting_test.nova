import std/dp/dp_rod_cutting

fn cki(got, expected, label)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn ckl(got, expected_len, label)
    if len(got) != expected_len
        print("FAIL " + label + " len: got " + str(len(got)) + " expected " + str(expected_len))
        exit(1)

fn ckli(got, idx, expected, label)
    if got[idx] != expected
        print("FAIL " + label + "[" + str(idx) + "]: got " + str(got[idx]) + " expected " + str(expected))
        exit(1)

fn main()
    // KAT 1: classic CLRS [1,5,8,9,10,17,17,20] n=8 -> 22
    let p1 = []
    push(p1, 1)
    push(p1, 5)
    push(p1, 8)
    push(p1, 9)
    push(p1, 10)
    push(p1, 17)
    push(p1, 17)
    push(p1, 20)
    cki(rc_max_revenue(p1), 22, "revenue [1,5,8,9,10,17,17,20]")

    // KAT 2: [2,5,7,8] n=4 -> 10 (two pieces of length 2: 5+5)
    let p2 = []
    push(p2, 2)
    push(p2, 5)
    push(p2, 7)
    push(p2, 8)
    cki(rc_max_revenue(p2), 10, "revenue [2,5,7,8]")

    // KAT 3: single element [1] -> 1
    let p3 = []
    push(p3, 1)
    cki(rc_max_revenue(p3), 1, "revenue [1]")

    // KAT 4: [3,5,8,9,10,17,17,20] n=8 -> 24 (eight pieces of length 1: 8*3)
    let p4 = []
    push(p4, 3)
    push(p4, 5)
    push(p4, 8)
    push(p4, 9)
    push(p4, 10)
    push(p4, 17)
    push(p4, 17)
    push(p4, 20)
    cki(rc_max_revenue(p4), 24, "revenue [3,5,8,9,10,17,17,20]")

    // KAT 5: empty -> 0
    let p5 = []
    cki(rc_max_revenue(p5), 0, "revenue [] empty")

    // KAT 6: rc_cuts on [1,5,8,9,10,17,17,20] -> optimal cuts sum to 22
    // Expected: two pieces of length 2 (5+5=10) + one of length 6 (17) = nope;
    // or length 2 + length 6 = 5+17=22. Verify sum.
    let cuts1 = rc_cuts(p1)
    let sum1 = 0
    let ci = 0
    while ci < len(cuts1)
        sum1 = sum1 + cuts1[ci]
        ci = ci + 1
    cki(sum1, 8, "cuts1 pieces sum to rod length 8")
    // validate revenue of these cuts
    let rev1 = 0
    let cj = 0
    while cj < len(cuts1)
        rev1 = rev1 + p1[cuts1[cj] - 1]
        cj = cj + 1
    cki(rev1, 22, "cuts1 revenue == 22")

    // KAT 7: rc_cuts on [2,5,7,8] -> pieces sum to 4, revenue == 10
    let cuts2 = rc_cuts(p2)
    let sum2 = 0
    let ck = 0
    while ck < len(cuts2)
        sum2 = sum2 + cuts2[ck]
        ck = ck + 1
    cki(sum2, 4, "cuts2 pieces sum to rod length 4")
    let rev2 = 0
    let cl = 0
    while cl < len(cuts2)
        rev2 = rev2 + p2[cuts2[cl] - 1]
        cl = cl + 1
    cki(rev2, 10, "cuts2 revenue == 10")

    // KAT 8: rc_cuts on [1] -> single piece [1]
    let cuts3 = rc_cuts(p3)
    ckl(cuts3, 1, "cuts3 length")
    ckli(cuts3, 0, 1, "cuts3[0]==1")

    // KAT 9: rc_cuts empty -> []
    let cuts5 = rc_cuts(p5)
    ckl(cuts5, 0, "cuts5 empty")

    print("PASS _dp_rod_cutting_test")
