import std/barcode/ean8

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // ── KAT 1: ean8_check canonical vector ───────────────────────────────────
    cki("check_1234567", ean8_check("1234567"), 0)

    // ── KAT 2: ean8_encode produces 67-module pattern ────────────────────────
    let enc = ean8_encode("1234567")
    cki("encode_len", len(enc), 67)

    // ── KAT 3: left guard ────────────────────────────────────────────────────
    cks("encode_left_guard", slice(enc, 0, 3), "101")

    // ── KAT 4: center guard at positions 31..35 ──────────────────────────────
    cks("encode_center_guard", slice(enc, 31, 36), "01010")

    // ── KAT 5: right guard ───────────────────────────────────────────────────
    cks("encode_right_guard", slice(enc, 64, 67), "101")

    // ── KAT 6: ean8_valid for correct 8-digit code ───────────────────────────
    cki("valid_ok", ean8_valid("12345670"), 1)

    // ── KAT 7: ean8_valid rejects wrong check digit ──────────────────────────
    cki("valid_bad1", ean8_valid("12345671"), 0)
    cki("valid_bad9", ean8_valid("12345679"), 0)

    // ── KAT 8: all-zeros check is 0 ──────────────────────────────────────────
    // sum = 0, check = (10 - 0%10)%10 = 0
    cki("check_zeros", ean8_check("0000000"), 0)
    cki("valid_zeros", ean8_valid("00000000"), 1)

    // ── KAT 9: second known vector — "9638527" ────────────────────────────────
    // Compute expected:
    // pos1=9 *3=27, pos2=6*1=6, pos3=3*3=9, pos4=8*1=8,
    // pos5=5*3=15, pos6=2*1=2, pos7=7*3=21 => sum=88, r=8, check=2
    cki("check_9638527", ean8_check("9638527"), 2)
    cki("valid_96385272", ean8_valid("96385272"), 1)
    cki("valid_96385270", ean8_valid("96385270"), 0)

    // ── KAT 10: encode length for additional payload ──────────────────────────
    cki("encode_len_2", len(ean8_encode("9638527")), 67)

    print("PASS _ean8_test")
