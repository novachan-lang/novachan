import forge_deque

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name + ": expected true")
    1

fn main()
    let fails = 0

    // 1. FIFO queue: push_back, pop_front preserves order
    let q = deque_new()
    deque_push_back(q, "a")
    deque_push_back(q, "b")
    deque_push_back(q, "c")
    fails = fails + expect("len3", str(deque_len(q)), "3")
    fails = fails + expect("fifo1", str(deque_pop_front(q)), "a")
    fails = fails + expect("fifo2", str(deque_pop_front(q)), "b")
    fails = fails + expect("fifo3", str(deque_pop_front(q)), "c")
    fails = fails + expect_true("empty", deque_is_empty(q))

    // 2. LIFO stack: push_back, pop_back reverses
    let s = deque_new()
    deque_push_back(s, "x")
    deque_push_back(s, "y")
    deque_push_back(s, "z")
    fails = fails + expect("lifo1", str(deque_pop_back(s)), "z")
    fails = fails + expect("lifo2", str(deque_pop_back(s)), "y")
    fails = fails + expect("lifo3", str(deque_pop_back(s)), "x")

    // 3. Both ends + ordering via to_list (k,l,m,n)
    let d = deque_new()
    deque_push_back(d, "m")
    deque_push_front(d, "l")
    deque_push_back(d, "n")
    deque_push_front(d, "k")
    fails = fails + expect("both_order", join(deque_to_list(d), ","), "k,l,m,n")
    fails = fails + expect("peek_front", str(deque_peek_front(d)), "k")
    fails = fails + expect("peek_back", str(deque_peek_back(d)), "n")
    fails = fails + expect("peek_nomut_len", str(deque_len(d)), "4")
    fails = fails + expect("pop_front_k", str(deque_pop_front(d)), "k")
    fails = fails + expect("pop_back_n", str(deque_pop_back(d)), "n")
    fails = fails + expect("mid_order", join(deque_to_list(d), ","), "l,m")

    // 4. Empty guards -> null (compare == null; str(null) is ambiguous)
    let e = deque_new()
    fails = fails + expect_true("pop_front_empty", deque_pop_front(e) == null)
    fails = fails + expect_true("pop_back_empty", deque_pop_back(e) == null)
    fails = fails + expect_true("peek_front_empty", deque_peek_front(e) == null)
    fails = fails + expect_true("peek_back_empty", deque_peek_back(e) == null)
    fails = fails + expect("empty_len0", str(deque_len(e)), "0")

    // 5. from_list round-trip
    let f = deque_from_list(["1", "2", "3", "4"])
    fails = fails + expect("fromlist", join(deque_to_list(f), ","), "1,2,3,4")

    // 6. clear + reuse
    deque_clear(f)
    fails = fails + expect_true("cleared", deque_is_empty(f))
    deque_push_back(f, "reused")
    fails = fails + expect("reuse", str(deque_pop_front(f)), "reused")

    // 7. Adversarial: interleaved end operations, true O(1)
    let g = deque_new()
    let i = 0
    while i < 100
        deque_push_back(g, str(i))
        deque_push_front(g, str(1000 + i))
        i = i + 1
    fails = fails + expect("adv_front", str(deque_peek_front(g)), "1099")
    fails = fails + expect("adv_back", str(deque_peek_back(g)), "99")
    fails = fails + expect("adv_len", str(deque_len(g)), "200")
    let popped = 0
    while deque_is_empty(g) == false
        if popped % 2 == 0
            deque_pop_front(g)
        else
            deque_pop_back(g)
        popped = popped + 1
    fails = fails + expect("adv_drained", str(popped), "200")
    fails = fails + expect("adv_empty", str(deque_len(g)), "0")

    // 8. Mixed types (deque holds any)
    let h = deque_new()
    deque_push_back(h, 42)
    deque_push_back(h, "str")
    deque_push_front(h, 7)
    fails = fails + expect("mixed_front", str(deque_pop_front(h)), "7")
    fails = fails + expect("mixed_int", str(deque_pop_front(h)), "42")

    if fails == 0
        print("forge_deque: all passed")
    else
        print("forge_deque: " + str(fails) + " FAILED")
