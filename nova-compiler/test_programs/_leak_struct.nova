type Box
    data: list

fn main()
    let before = live_count()
    let acc = 0
    let i = 0
    while i < 2000
        let lst = [i, i + 1, i + 2]
        let b = Box(lst)
        acc = acc + len(b.data)
        i = i + 1
    let after = live_count()
    print("STRUCT delta=" + str(after - before) + " acc=" + str(acc))
