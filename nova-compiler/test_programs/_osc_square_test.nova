// KAT test for std/audio/osc_square.nova
import std/audio/osc_square

fn main()
    // KAT 1: osc_square(0.25) == 1.0 (in high half)
    let sq25 = osc_square(0.25)
    if sq25 != 1.0
        print("FAIL osc_square(0.25): got=" + str(sq25) + " want=1.0")
        exit(1)

    // KAT 2: osc_square(0.75) == -1.0 (in low half)
    let sq75 = osc_square(0.75)
    if sq75 != -1.0
        print("FAIL osc_square(0.75): got=" + str(sq75) + " want=-1.0")
        exit(1)

    // KAT 3: osc_square(0.0) == 1.0 (boundary: 0.0 < 0.5)
    let sq0 = osc_square(0.0)
    if sq0 != 1.0
        print("FAIL osc_square(0.0): got=" + str(sq0) + " want=1.0")
        exit(1)

    // KAT 4: osc_square(0.5) == -1.0 (boundary: 0.5 is NOT < 0.5)
    let sq50 = osc_square(0.5)
    if sq50 != -1.0
        print("FAIL osc_square(0.5): got=" + str(sq50) + " want=-1.0")
        exit(1)

    // KAT 5: osc_pulse(0.2, 0.25) == 1.0 (0.2 < 0.25)
    let p20 = osc_pulse(0.2, 0.25)
    if p20 != 1.0
        print("FAIL osc_pulse(0.2,0.25): got=" + str(p20) + " want=1.0")
        exit(1)

    // KAT 6: osc_pulse(0.3, 0.25) == -1.0 (0.3 >= 0.25)
    let p30 = osc_pulse(0.3, 0.25)
    if p30 != -1.0
        print("FAIL osc_pulse(0.3,0.25): got=" + str(p30) + " want=-1.0")
        exit(1)

    // KAT 7: osc_pulse with duty=0.5 matches osc_square
    let p25_50 = osc_pulse(0.25, 0.5)
    let sq25b = osc_square(0.25)
    if p25_50 != sq25b
        print("FAIL osc_pulse(0.25,0.5) vs osc_square(0.25): " + str(p25_50) + " vs " + str(sq25b))
        exit(1)

    let p75_50 = osc_pulse(0.75, 0.5)
    let sq75b = osc_square(0.75)
    if p75_50 != sq75b
        print("FAIL osc_pulse(0.75,0.5) vs osc_square(0.75): " + str(p75_50) + " vs " + str(sq75b))
        exit(1)

    // KAT 8: narrow pulse duty=0.1: only phase < 0.1 is high
    let pn_low = osc_pulse(0.05, 0.1)
    let pn_high = osc_pulse(0.15, 0.1)
    if pn_low != 1.0
        print("FAIL osc_pulse(0.05,0.1): got=" + str(pn_low) + " want=1.0")
        exit(1)
    if pn_high != -1.0
        print("FAIL osc_pulse(0.15,0.1): got=" + str(pn_high) + " want=-1.0")
        exit(1)

    print("PASS _osc_square_test")
