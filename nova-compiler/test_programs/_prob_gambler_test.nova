import std/probability/prob_gambler

// cki — check integer equality.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL prob_gambler " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckr — check reduced fraction [num,den] equals expected [wn,wd].
fn ckr(label: string, got, wn: int, wd: int)
    if got[0] != wn or got[1] != wd
        print("FAIL prob_gambler " + label + ": got=[" + str(got[0]) + "," + str(got[1]) + "] want=[" + str(wn) + "," + str(wd) + "]")
        exit(1)

fn main()
    // pgm_ruin_prob(1,4,1,2) = (N-i)/N = 3/4  (fair game)
    let r1 = pgm_ruin_prob(1, 4, 1, 2)
    ckr("pgm_ruin_prob(1,4,1,2)", r1, 3, 4)

    // pgm_ruin_prob(2,4,1,2) = 2/4 = 1/2  (fair game)
    let r2 = pgm_ruin_prob(2, 4, 1, 2)
    ckr("pgm_ruin_prob(2,4,1,2)", r2, 1, 2)

    // pgm_ruin_prob(1,2,1,2) = 1/2  (fair game)
    let r3 = pgm_ruin_prob(1, 2, 1, 2)
    ckr("pgm_ruin_prob(1,2,1,2)", r3, 1, 2)

    // pgm_reach_target_prob(1,4,1,2) = 1 - 3/4 = 1/4
    let r4 = pgm_reach_target_prob(1, 4, 1, 2)
    ckr("pgm_reach_target_prob(1,4,1,2)", r4, 1, 4)

    // pgm_ruin_prob(1,3,1,3): p=1/3, r=2, (r^1-r^3)/(1-r^3)=(2-8)/(1-8)=(-6)/(-7)=6/7
    let r5 = pgm_ruin_prob(1, 3, 1, 3)
    ckr("pgm_ruin_prob(1,3,1,3)", r5, 6, 7)

    // pgm_expected_duration(1,4) = 1*(4-1) = 3
    cki("pgm_expected_duration(1,4)", pgm_expected_duration(1, 4), 3)

    // Additional: pgm_ruin_prob(0,4,1,2) = 1 (already ruined)
    let r6 = pgm_ruin_prob(0, 4, 1, 2)
    ckr("pgm_ruin_prob(0,4,1,2)", r6, 1, 1)

    // pgm_ruin_prob(4,4,1,2) = 0 (already at target)
    let r7 = pgm_ruin_prob(4, 4, 1, 2)
    ckr("pgm_ruin_prob(4,4,1,2)", r7, 0, 1)

    // pgm_expected_duration(2,4) = 2*2 = 4
    cki("pgm_expected_duration(2,4)", pgm_expected_duration(2, 4), 4)

    // pgm_ruin_prob(2,3,1,3): p=1/3, r=2, (r^2-r^3)/(1-r^3)=(4-8)/(1-8)=(-4)/(-7)=4/7
    let r8 = pgm_ruin_prob(2, 3, 1, 3)
    ckr("pgm_ruin_prob(2,3,1,3)", r8, 4, 7)

    print("PASS _prob_gambler_test")
