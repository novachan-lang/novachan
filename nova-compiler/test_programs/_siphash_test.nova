// _siphash_test.nova — KAT for std/hash/siphash
//
// Canonical vectors from the SipHash reference paper (Aumasson & Bernstein,
// Appendix A): https://131002.net/siphash/siphash.pdf
//
// Key bytes: 00 01 02 03 04 05 06 07 08 09 0a 0b 0c 0d 0e 0f
//   k0 = little-endian u64 of bytes 0..7  = 0x0706050403020100
//        built as (0x07060504 << 32) | 0x03020100
//   k1 = little-endian u64 of bytes 8..15 = 0x0f0e0d0c0b0a0908
//        built as (0x0F0E0D0C << 32) | 0x0B0A0908
//
// Expected values (all > 2^63 — built as (hi<<32)|lo):
//   SipHash-2-4 of empty (0 bytes)    = 0x726FDB47DD0E0E31
//   SipHash-2-4 of msg15 (0x00..0x0E) = 0xA129CA6149BE45E5
//
// Hand-trace for empty message:
//   v0 = k0 ^ 0x736f6d6570736575
//   v1 = k1 ^ 0x646f72616e646f6d
//   v2 = k0 ^ 0x6c7967656e657261
//   v3 = k1 ^ 0x7465646279746573
//   No compression blocks.
//   last = (0 & 0xFF) << 56 = 0   (len=0, no remainder bytes)
//   v3 ^= 0; 2x SipRound; v0 ^= 0; v2 ^= 0xff; 4x SipRound; XOR all four.
//   Reference result = 0x726FDB47DD0E0E31

import std/hash/siphash

// Integer known-answer check helper.
fn cki(label, got, want)
    if got != want
        print("FAIL siphash " + label + ": got " + siphash_hex(got) + " want " + siphash_hex(want))
        exit(1)

fn main()
    // Build key words (little-endian from key bytes 00..0f).
    let k0 = (0x07060504 << 32) | 0x03020100
    let k1 = (0x0F0E0D0C << 32) | 0x0B0A0908

    // --- KAT 1: SipHash-2-4 of empty message ---
    // Expected: 0x726FDB47DD0E0E31
    let want_empty = (0x726FDB47 << 32) | 0xDD0E0E31
    let got_empty = h_siphash24(bytes(0), k0, k1)
    cki("sip24_empty", got_empty, want_empty)

    // --- KAT 2: SipHash-2-4 of 15-byte message 0x00..0x0E ---
    // Expected: 0xA129CA6149BE45E5
    // Build message bytes 0x00 through 0x0E (15 bytes).
    let msg15 = bytes(0)
    let bi = 0
    while bi < 15
        msg15 = bytes_append(msg15, bi)
        bi = bi + 1
    let want_m15 = (0xA129CA61 << 32) | 0x49BE45E5
    let got_m15 = h_siphash24(msg15, k0, k1)
    cki("sip24_msg15", got_m15, want_m15)

    // --- KAT 3: SipHash-2-4 of single-byte message 0x00 ---
    // Appendix A vector for in=0 (1 byte): 0x74f839c593dc67fd
    // built as (0x74f839c5 << 32) | 0x93dc67fd
    let msg1 = bytes(0)
    msg1 = bytes_append(msg1, 0)
    let want_1b = (0x74f839c5 << 32) | 0x93dc67fd
    let got_1b = h_siphash24(msg1, k0, k1)
    cki("sip24_1byte", got_1b, want_1b)

    // --- KAT 4: SipHash-2-4 of 8-byte message 0x00..0x07 (exactly one block) ---
    // Appendix A vector for in=0..7 (8 bytes): 0x93f5f5799a932462
    // built as (0x93f5f579 << 32) | 0x9a932462
    let msg8 = bytes(0)
    let bj = 0
    while bj < 8
        msg8 = bytes_append(msg8, bj)
        bj = bj + 1
    let want_8b = (0x93f5f579 << 32) | 0x9a932462
    let got_8b = h_siphash24(msg8, k0, k1)
    cki("sip24_8bytes", got_8b, want_8b)

    // --- KAT 5: determinism — same input, same output ---
    let b_det = bytes(0)
    b_det = bytes_append(b_det, 42)
    b_det = bytes_append(b_det, 99)
    cki("sip24_determinism", h_siphash24(b_det, k0, k1), h_siphash24(b_det, k0, k1))

    // --- KAT 6: key sensitivity — different keys produce different output ---
    let alt_k0 = k0 ^ 1
    let h1 = h_siphash24(b_det, k0, k1)
    let h2 = h_siphash24(b_det, alt_k0, k1)
    if h1 == h2
        print("FAIL siphash sip24_key_sensitivity: different keys produced same hash")
        exit(1)

    // --- KAT 7: SipHash-1-3 of empty message ---
    // SipHash-1-3 is a distinct variant — same init, 1 compression, 3 finalization.
    // No official reference vectors for SipHash-1-3 in the original paper, but
    // the Python reference implementation (https://github.com/veorq/SipHash) gives:
    // siphash13(b"", key=00..0f) = 0xabac0158050fc4dc  built as (0xabac0158 << 32) | 0x050fc4dc
    let want_13_empty = (0xabac0158 << 32) | 0x050fc4dc
    let got_13_empty = h_siphash13(bytes(0), k0, k1)
    cki("sip13_empty", got_13_empty, want_13_empty)

    // --- KAT 8: SipHash-1-3 differs from SipHash-2-4 on same input ---
    if got_13_empty == want_empty
        print("FAIL siphash sip13_differs: sip13 and sip24 returned same hash for empty input")
        exit(1)

    // --- KAT 9: input sensitivity — adjacent byte values differ ---
    let ba = bytes(0)
    ba = bytes_append(ba, 0)
    let bb = bytes(0)
    bb = bytes_append(bb, 1)
    let ha = h_siphash24(ba, k0, k1)
    let hb = h_siphash24(bb, k0, k1)
    if ha == hb
        print("FAIL siphash sip24_input_sensitivity: byte 0 and byte 1 hash identically")
        exit(1)

    // --- KAT 10: siphash_hex utility produces 16-char uppercase hex ---
    let hex16 = siphash_hex(want_empty)
    let hex_len = len(hex16)
    if hex_len != 16
        print("FAIL siphash hex_length: got " + str(hex_len) + " want 16")
        exit(1)

    print("PASS _siphash_test")
