import std/term/columns

// ── helpers ───────────────────────────────────────────────────────────────────

fn cks(label: str, got: str, want: str)
    if got != want
        print("FAIL columns " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        print("  got  [" + got + "]")
        print("  want [" + want + "]")
        exit(1)

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL columns " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── KAT 1: pad_cell left ─────────────────────────────────────────────────
    cks("pad_left", pad_cell("x", 5, "left"), "x    ")

    // ── KAT 2: pad_cell right ────────────────────────────────────────────────
    cks("pad_right", pad_cell("x", 5, "right"), "    x")

    // ── KAT 3: pad_cell center (4 surplus → 2 left, 2 right) ─────────────────
    cks("pad_center", pad_cell("x", 5, "center"), "  x  ")

    // ── KAT 4: pad_cell truncation ───────────────────────────────────────────
    cks("pad_trunc", pad_cell("hello", 3, "left"), "hel")

    // ── KAT 5: pad_cell exact fit ────────────────────────────────────────────
    cks("pad_exact", pad_cell("abc", 3, "left"), "abc")

    // ── KAT 6: pad_cell width 0 → empty ─────────────────────────────────────
    cks("pad_zero_width", pad_cell("x", 0, "left"), "")

    // ── KAT 7: pad_cell empty string left ────────────────────────────────────
    cks("pad_empty_left", pad_cell("", 4, "left"), "    ")

    // ── KAT 8: pad_cell empty string right ───────────────────────────────────
    cks("pad_empty_right", pad_cell("", 4, "right"), "    ")

    // ── KAT 9: pad_cell center odd surplus (3 surplus → 1 left, 2 right) ─────
    // pad_cell("x", 4, "center"): pad=3, left_pad=3/2=1, right_pad=3-1=2 → " x  "
    cks("pad_center_odd", pad_cell("x", 4, "center"), " x  ")

    // ── KAT 10: columnize basic 4 items 2 cols width 3 ───────────────────────
    let items = []
    push(items, "a")
    push(items, "b")
    push(items, "c")
    push(items, "d")
    let grid = columnize(items, 2, 3)
    cki("columnize_nrows", len(grid), 2)
    // row 0: pad("a",3,"left") + pad("b",3,"left") = "a  " + "b  " = "a  b  "
    cks("columnize_row0", grid[0], "a  b  ")
    // row 1: pad("c",3,"left") + pad("d",3,"left") = "c  " + "d  " = "c  d  "
    cks("columnize_row1", grid[1], "c  d  ")

    // ── KAT 11: columnize odd count (3 items, 2 cols, width 4) ───────────────
    // row 0: pad("aa",4) + pad("bb",4) = "aa  " + "bb  " = "aa  bb  "
    // row 1: pad("cc",4) + pad("",4)   = "cc  " + "    " = "cc      "
    let items2 = []
    push(items2, "aa")
    push(items2, "bb")
    push(items2, "cc")
    let grid2 = columnize(items2, 2, 4)
    cki("columnize_odd_nrows", len(grid2), 2)
    cks("columnize_odd_row0", grid2[0], "aa  bb  ")
    cks("columnize_odd_row1", grid2[1], "cc      ")

    // ── KAT 12: columnize empty list ─────────────────────────────────────────
    let empty_items = []
    let empty_grid = columnize(empty_items, 2, 3)
    cki("columnize_empty", len(empty_grid), 0)

    // ── KAT 13: columnize ncols=1 ────────────────────────────────────────────
    let items3 = []
    push(items3, "foo")
    push(items3, "bar")
    let grid3 = columnize(items3, 1, 5)
    cki("columnize_1col_nrows", len(grid3), 2)
    cks("columnize_1col_row0", grid3[0], "foo  ")
    cks("columnize_1col_row1", grid3[1], "bar  ")

    // ── KAT 14: table_simple basic ───────────────────────────────────────────
    // rows = [["name","age"],["bob","3"]]
    // widths = [4, 3]  (max("name","bob")=4, max("age","3")=3)
    // row0 = "name" + " " + "age" = "name age"
    // row1 = "bob " + " " + "3  " = "bob  3  "
    let trows = []
    let hdr = []
    push(hdr, "name")
    push(hdr, "age")
    push(trows, hdr)
    let r1 = []
    push(r1, "bob")
    push(r1, "3")
    push(trows, r1)
    let tresult = table_simple(trows)
    cki("table_nrows", len(tresult), 2)
    cks("table_row0", tresult[0], "name age")
    cks("table_row1", tresult[1], "bob  3  ")

    // ── KAT 15: table_simple empty rows → empty result ───────────────────────
    let empty_rows = []
    let empty_table = table_simple(empty_rows)
    cki("table_empty", len(empty_table), 0)

    // ── KAT 16: table_simple single row ──────────────────────────────────────
    // [["hello","world"]] → widths=[5,5] → "hello world"
    let srow = []
    push(srow, "hello")
    push(srow, "world")
    let srows = []
    push(srows, srow)
    let sresult = table_simple(srows)
    cki("table_single_nrows", len(sresult), 1)
    cks("table_single_row0", sresult[0], "hello world")

    // ── KAT 17: pad_cell right truncation ────────────────────────────────────
    cks("pad_right_trunc", pad_cell("abcde", 3, "right"), "abc")

    // ── KAT 18: pad_cell center truncation ───────────────────────────────────
    cks("pad_center_trunc", pad_cell("abcde", 3, "center"), "abc")

    // ── KAT 19: pad_cell width 1 with single char ────────────────────────────
    cks("pad_w1", pad_cell("z", 1, "right"), "z")

    // ── KAT 20: columnize guard ncols < 1 ────────────────────────────────────
    let gi = []
    push(gi, "x")
    let bad_grid = columnize(gi, 0, 3)
    cki("columnize_bad_ncols", len(bad_grid), 0)

    print("PASS _columns_test")
