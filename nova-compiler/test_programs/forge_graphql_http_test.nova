// functional: GraphQL-over-HTTP endpoint dispatched through the Forge router
import forge
import forge_graphql_http

fn _r_hello(parent, args)
    "world"

fn main()
    let app = forge.app()
    let r = {}
    r["hello"] = _r_hello
    forge_graphql_http.graphql_route(app, "/graphql", r, 0)
    let bodydict = {}
    bodydict["query"] = chr(123) + " hello " + chr(125)
    let resp = forge.dispatch(app, "POST", "/graphql", json_stringify(bodydict))
    if find(resp, "world") < 0
        print("FAIL graphql http = " + resp)
        exit(1)
    print("PASS forge_graphql_http")
