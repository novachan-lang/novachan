// #9: Windows TLS server. Runs as a DEDICATED server process — tls_listen (self-signed PFX) +
// tls_accept (AcceptSecurityContext handshake) + one encrypted request/response. Driven by a
// separate-process .NET TLS client in the harness (a real TLS server is its own process; a
// co-located client would starve the blocking accept). Exercises the whole server crypto path.
fn main()
    let port = 18094
    let srv = tls_listen(port, "_tls_test.pfx", "novatest")
    if srv == 0
        print("FAIL tls_listen")
        return 0
    print("LISTENING")
    let conn = tls_accept(srv)
    if conn == 0
        print("FAIL tls_accept")
        return 0
    let req = tls_recv(conn, 1024)
    tls_send(conn, "pong:{req}")
    tls_close(conn)
    print("SERVED")
