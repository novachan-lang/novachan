fn main()
    // SHA-256 of empty string (well-known test vector)
    let h1 = sha256("")
    print("sha256(''): " + h1)
    assert(h1 == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "sha256 empty mismatch")

    // SHA-256 of "hello"
    let h2 = sha256("hello")
    print("sha256('hello'): " + h2)
    assert(h2 == "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824", "sha256 hello mismatch")

    // HMAC-SHA256
    let hm = hmac_sha256("key", "The quick brown fox jumps over the lazy dog")
    print("hmac_sha256: " + hm)
    assert(hm == "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8", "hmac mismatch")

    // Hex encode/decode roundtrip
    let encoded = hex_encode("NOVA")
    print("hex_encode('NOVA'): " + encoded)
    assert(encoded == "4e4f5641", "hex encode mismatch")
    let decoded = hex_decode(encoded)
    assert(decoded == "NOVA", "hex roundtrip failed")

    // Base64 encode/decode roundtrip
    let b64 = base64_encode("Hello, NOVA!")
    print("base64_encode: " + b64)
    assert(b64 == "SGVsbG8sIE5PVkEh", "base64 encode mismatch")
    let b64d = base64_decode(b64)
    assert(b64d == "Hello, NOVA!", "base64 roundtrip failed")

    // UUID4 format check
    let u = uuid4()
    print("uuid4: " + u)
    assert(len(u) == 36, "uuid4 length wrong")

    // Random bytes
    let rb = random_bytes(16)
    assert(len(rb) == 16, "random_bytes length wrong")

    // Dir walk (just verify it returns a list)
    let files = dir_walk(".")
    print("dir_walk('.') found " + str(len(files)) + " entries")
    assert(len(files) > 0, "dir_walk should find files in current dir")

    print("ALL CRYPTO/STDLIB TESTS PASSED")
