// List comprehensions (signature ergonomics — "simpler than Python"):
//   [ EXPR for VAR in ITER (if COND)? ]
// desugars at parse time (no new IR) to map(filter(ITER, fn(VAR) COND), fn(VAR) EXPR),
// reusing NOVA's first-class functions. v1 iterates a list/range source.

fn _sq(x) -> int
    return x * x

fn main()
    // basic map
    assert_eq([x * 2 for x in [1, 2, 3]], [2, 4, 6])
    // filter only
    assert_eq([x for x in [1, 2, 3, 4, 5, 6] if x % 2 == 0], [2, 4, 6])
    // map + filter combined
    assert_eq([x * x for x in [1, 2, 3, 4, 5] if x > 2], [9, 16, 25])
    // over a range (iter is a function call returning a list)
    assert_eq([x for x in range(5)], [0, 1, 2, 3, 4])
    assert_eq([x + 1 for x in range(3)], [1, 2, 3])
    // function call in the result expression
    assert_eq([_sq(x) for x in [2, 3, 4]], [4, 9, 16])
    // filter removes everything -> empty
    assert_eq([x for x in [1, 2, 3] if x > 100], [])
    // string elements + len filter
    assert_eq([s for s in ["a", "bb", "ccc"] if len(s) >= 2], ["bb", "ccc"])
    // captures an outer variable
    let base = 10
    assert_eq([x + base for x in [1, 2, 3]], [11, 12, 13])
    // regression: ordinary list literals still parse correctly
    assert_eq([], [])
    assert_eq([1, 2, 3], [1, 2, 3])
    assert_eq([1, 2, 3,], [1, 2, 3])           // trailing comma
    let nested = [[1, 2], [3, 4]]
    assert_eq(nested[1], [3, 4])
    print("comprehension_test passed")
