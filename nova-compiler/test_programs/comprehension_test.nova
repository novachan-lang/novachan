fn main()
    let items = [1, 2, 3, 4, 5]
    let doubled = [x * 2 for x in items]
    assert_eq(doubled, [2, 4, 6, 8, 10])
    let big = [x for x in items if x > 3]
    assert_eq(big, [4, 5])
    let transformed = [x * 10 for x in items if x % 2 == 0]
    assert_eq(transformed, [20, 40])
    let strs = [str(x) for x in items]
    assert_eq(strs, ["1", "2", "3", "4", "5"])
    let squares = [x * x for x in [1, 2, 3]]
    assert_eq(squares, [1, 4, 9])
    let empty = [x for x in items if x > 100]
    assert_eq(empty, [])
    print("ALL COMPREHENSION TESTS PASSED")
