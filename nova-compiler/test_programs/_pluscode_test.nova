// _pluscode_test.nova — KAT for std/geo/pluscode (Open Location Code / Plus Codes)
import std/geo/pluscode

fn cki(label: str, got: int, expected: int)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(expected))
        exit(1)

fn cks(label: str, got: str, expected: str)
    if got != expected
        print("FAIL " + label + ": got=" + got + " want=" + expected)
        exit(1)

fn ckb(label: str, got: bool, expected: bool)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(expected))
        exit(1)

fn ckf(label: str, got: float, expected: float, eps: float)
    let diff = got - expected
    if diff < 0.0
        diff = 0.0 - diff
    if diff > eps
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(expected) + " eps=" + str(eps))
        exit(1)

fn main()
    // KAT 1: olc_is_valid with known valid code
    ckb("is_valid 8FVC2222+22", olc_is_valid("8FVC2222+22"), true)

    // KAT 2: olc_is_valid with invalid code
    ckb("is_valid abc false", olc_is_valid("abc"), false)

    // KAT 3: olc_char_value for first char '2' -> 0
    cki("char_value 2", olc_char_value("2"), 0)

    // KAT 4: olc_char_value for last char 'X' -> 19
    cki("char_value X", olc_char_value("X"), 19)

    // KAT 5: olc_digit round-trip
    cks("digit 0", olc_digit(0), "2")
    cks("digit 19", olc_digit(19), "X")

    // KAT 6: round-trip encode/decode for (25.0, 50.0) at codelen=10
    let code25 = olc_encode(25.0, 50.0, 10)
    // check it contains '+'
    let has_plus = 0
    let ci = 0
    while ci < len(code25)
        if code25[ci] == "+"
            has_plus = 1
        ci = ci + 1
    cki("encode has plus", has_plus, 1)
    // decode and check center within 0.01 deg
    let dec25 = olc_decode(code25)
    let lat_c = dec25["lat_center"] * 1.0
    let lon_c = dec25["lon_center"] * 1.0
    ckf("roundtrip lat 25", lat_c, 25.0, 0.01)
    ckf("roundtrip lon 50", lon_c, 50.0, 0.01)

    // KAT 7: round-trip for (0.0, 0.0) at codelen=4
    let code00 = olc_encode(0.0, 0.0, 4)
    let dec00 = olc_decode(code00)
    let lat_c00 = dec00["lat_center"] * 1.0
    let lon_c00 = dec00["lon_center"] * 1.0
    // cell at codelen=4 (2 real pairs) is 1 deg x 1 deg, center within 0.5
    ckf("roundtrip lat 0", lat_c00, 0.0, 0.6)
    ckf("roundtrip lon 0", lon_c00, 0.0, 0.6)

    // KAT 8: encode at South Pole edge
    let code_sp = olc_encode(0.0 - 90.0, 0.0, 10)
    let dec_sp = olc_decode(code_sp)
    let lat_sp = dec_sp["lat_center"] * 1.0
    ckf("south pole lat", lat_sp, 0.0 - 90.0, 0.1)

    // KAT 9: encode at antimeridian
    let code_am = olc_encode(0.0, 180.0, 10)
    let dec_am = olc_decode(code_am)
    let lon_am = dec_am["lon_center"] * 1.0
    ckf("antimeridian lon", lon_am, 179.99, 0.1)

    // KAT 10: olc_is_valid rejects code with invalid chars
    ckb("is_valid invalid chars", olc_is_valid("ZZZZZZZZ+ZZ"), false)

    // KAT 11: olc_code_area for 10-char code (5 real pairs)
    // pair 0: 20 deg, pair 1: 1 deg, pair 2: 0.05, pair 3: 0.0025, pair 4: 0.000125
    // At precision 10 (5 pairs), finest cell = 0.000125 deg ≈ 13.9 m
    let area10 = olc_code_area("7HQG2222+22")
    ckf("code_area 10", area10, 0.000125, 0.00001)

    // KAT 12: round-trip for negative lat/lon
    let code_neg = olc_encode(0.0 - 33.8688, 151.2093, 10)
    let dec_neg = olc_decode(code_neg)
    let lat_neg = dec_neg["lat_center"] * 1.0
    let lon_neg = dec_neg["lon_center"] * 1.0
    ckf("sydney lat", lat_neg, 0.0 - 33.8688, 0.01)
    ckf("sydney lon", lon_neg, 151.2093, 0.01)

    print("PASS _pluscode_test")
