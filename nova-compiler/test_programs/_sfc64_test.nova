// KAT test for std/random/sfc64
//
// Anchor values computed with a Python reference implementation of sfc64
// (Doty-Humphrey) using unsigned 64-bit arithmetic.
//
// KAT1: DETERMINISM  -- two sfc_seed(0) generators produce identical first 8 outputs
// KAT2: ANCHOR seed=0 first output (after 12 warm-up steps) == 0x3ACFA029E3CC6041
// KAT3: ANCHOR seed=0 second output == 0xF5B6515BF2EE419C
// KAT4: NON-DEGENERATE -- seed=0 outputs are not all zero and are not all identical
// KAT5: SEED DIVERGENCE -- seed=1 and seed=2 produce different first outputs
// KAT6: sfc_next_range stays in [0, n)
// KAT7: ANCHOR sfc_next_range(sfc_seed(42), 10) == 3

import std/random/sfc64

fn main()
    // ── KAT 1: determinism ───────────────────────────────────────────────────
    let ra = sfc_seed(0)
    let rb = sfc_seed(0)
    let step = 0
    while step < 8
        let va = sfc_next(ra)
        let vb = sfc_next(rb)
        if va != vb
            print("FAIL sfc64 KAT1: diverged at step " + str(step))
            exit(1)
        step = step + 1

    // ── KAT 2: anchor seed=0 output[0] ──────────────────────────────────────
    // Reference: 0x3ACFA029E3CC6041 = 4237781876154851393 (signed i64)
    let want2 = (0x3ACFA029 << 32) | 0xE3CC6041
    let r0 = sfc_seed(0)
    let got2 = sfc_next(r0)
    if got2 != want2
        print("FAIL sfc64 KAT2: got " + str(got2) + " want " + str(want2))
        exit(1)

    // ── KAT 3: anchor seed=0 output[1] ──────────────────────────────────────
    // Reference: 0xF5B6515BF2EE419C = -741315633296293476 (signed i64)
    let want3 = (0xF5B6515B << 32) | 0xF2EE419C
    let got3 = sfc_next(r0)
    if got3 != want3
        print("FAIL sfc64 KAT3: got " + str(got3) + " want " + str(want3))
        exit(1)

    // ── KAT 4: non-degenerate (not all zero, not all same) ──────────────────
    let rnd = sfc_seed(0)
    let all_zero = 1
    let first_v = sfc_next(rnd)
    let all_same = 1
    if first_v != 0
        all_zero = 0
    let k = 1
    while k < 8
        let vk = sfc_next(rnd)
        if vk != 0
            all_zero = 0
        if vk != first_v
            all_same = 0
        k = k + 1
    if all_zero == 1
        print("FAIL sfc64 KAT4a: all outputs are zero")
        exit(1)
    if all_same == 1
        print("FAIL sfc64 KAT4b: all outputs are identical")
        exit(1)

    // ── KAT 5: seed divergence ───────────────────────────────────────────────
    // seed=1 and seed=2 must produce different first outputs
    let r1 = sfc_seed(1)
    let r2 = sfc_seed(2)
    let v1 = sfc_next(r1)
    let v2 = sfc_next(r2)
    if v1 == v2
        print("FAIL sfc64 KAT5: seed=1 and seed=2 produced the same first output")
        exit(1)

    // ── KAT 6: sfc_next_range stays in [0, n) ───────────────────────────────
    let rr = sfc_seed(99)
    let j = 0
    while j < 200
        let vj = sfc_next_range(rr, 100)
        if vj < 0
            print("FAIL sfc64 KAT6a: got negative value " + str(vj) + " at step " + str(j))
            exit(1)
        if vj >= 100
            print("FAIL sfc64 KAT6b: got " + str(vj) + " >= 100 at step " + str(j))
            exit(1)
        j = j + 1

    // ── KAT 7: anchor sfc_next_range(sfc_seed(42), 10) ──────────────────────
    // Reference: 0x8523E80B9315250F (unsigned) & m63 % 10 = 3
    let r42 = sfc_seed(42)
    let got7 = sfc_next_range(r42, 10)
    if got7 != 3
        print("FAIL sfc64 KAT7: got " + str(got7) + " want 3")
        exit(1)

    print("PASS _sfc64_test")
