import forge_segment_counter

fn main()
    let s = sc_new(60)
    s = sc_increment(s, 10)
    s = sc_increment(s, 30)
    s = sc_increment(s, 50)
    s = sc_increment(s, 70)
    s = sc_increment(s, 130)

    assert(sc_total(s) == 5, "5 total")
    assert(sc_count_at(s, 10) == 3, "3 in segment 0")
    assert(sc_count_at(s, 70) == 1, "1 in segment 1")
    assert(sc_count_at(s, 130) == 1, "1 in segment 2")
    assert(sc_count_at(s, 300) == 0, "0 in empty segment")

    assert(sc_segment_count(s) == 3, "3 segments used")
    assert(sc_count_range(s, 0, 120) == 4, "4 in range 0-120")

    print("SEGMENT-COUNTER KAT PASS")
