// Erlang frontier Stage-2: `receive ... after N` timeout (the gen_server idle-timeout primitive).
// (A) a matching message is already present -> handled, the (10s) timeout body does NOT fire.
// (B) no matching message ever arrives -> the 50ms timeout body fires.
// (C) `after 0` with an empty mailbox -> immediate timeout (non-blocking poll).
// Deterministic: 1 is sent before main parks; 99 is never sent (B and C always time out); nothing
// is sent between B and C, so C's mailbox is empty.
fn t_worker(parent)
    receive
        1 => send_msg(parent, 100)
    after 10000
        send_msg(parent, 999)
    receive
        99 => send_msg(parent, 998)
    after 50
        send_msg(parent, 300)
    receive
        99 => send_msg(parent, 997)
    after 0
        send_msg(parent, 400)

fn main()
    let me = self_pid()
    let w = spawn t_worker(me)
    let wb = mailbox_of(w)
    send_msg(wb, 1)
    let a = recv_msg()
    assert(a == 100, "matched 1 before the timeout -> 100 (after body must NOT fire)")
    let b = recv_msg()
    assert(b == 300, "no match -> timed out after 50ms -> 300")
    let c = recv_msg()
    assert(c == 400, "after 0 with an empty mailbox -> immediate timeout -> 400")
    print("RECV_TIMEOUT_OK")
