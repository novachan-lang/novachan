// forge_pg_pool_test -- PG connection POOL + transactions (parallel to forge_db pool_*/with_tx). Opens a
// pool of authenticated connections, runs a pooled query, a pooled PARAMETERIZED (injection-safe) query,
// and a transaction. Creds via the standard PG env vars (defaults localhost/postgres). Without valid creds
// the pool open returns a structured pg: error (validating the error path); WITH creds it does a real
// pooled round-trip. Kill-on-timeout bounds a hang.
import forge_pg

fn _envor(name: string, dflt: string) -> string
    let v = env(name)
    if len(v) > 0
        return v
    dflt

fn main()
    let host = _envor("PGHOST", "127.0.0.1")
    let port = parse_int(_envor("PGPORT", "5432"))
    let user = _envor("PGUSER", "postgres")
    let db = _envor("PGDATABASE", "postgres")
    let password = _envor("PGPASSWORD", "postgres")
    print("opening pg pool (3 conns) to " + host + ":" + str(port))
    let r = pg_pool_open(host, port, user, db, password, 3)
    match r
        Ok(pool) =>
            print("POOL OPEN OK (3 authenticated connections)")
            let q = pg_query(pool, "SELECT 1 AS one")
            match q
                Ok(rows) =>
                    if len(rows) < 1
                        print("FAIL: pooled SELECT no rows")
                        exit(1)
                    assert_eq(rows[0]["one"], "1")
                    print("POOL QUERY OK")
                Err(e) =>
                    print("FAIL: pooled query: " + e)
                    exit(1)
            let q2 = pg_query_params_pool(pool, "SELECT $1::int AS x, $2::text AS s", ["7", "pooled'; --"])
            match q2
                Ok(rows2) =>
                    assert_eq(rows2[0]["x"], "7")
                    assert_eq(rows2[0]["s"], "pooled'; --")
                    print("POOL PARAMETERIZED QUERY OK (injection-safe)")
                Err(e) =>
                    print("FAIL: pooled params: " + e)
                    exit(1)
            let t = pg_with_tx(pool, fn(c) pg_exec(c, "SELECT 42 AS answer"))
            match t
                Ok(trows) =>
                    assert_eq(trows[0]["answer"], "42")
                    print("TRANSACTION OK (BEGIN/COMMIT on one pooled conn)")
                Err(e) =>
                    print("FAIL: tx: " + e)
                    exit(1)
            pg_pool_close(pool, 3)
            print("LIVE PG POOL + PARAMS + TX ROUND-TRIP OK")
        Err(e) =>
            print("POOL OPEN returned a structured error: " + e)
            assert(starts_with(e, "pg:"), "structured pg: error (set PGPASSWORD for the full pooled round-trip)")
            print("POOL ERROR-PATH OK")
    print("forge_pg_pool_test passed")
