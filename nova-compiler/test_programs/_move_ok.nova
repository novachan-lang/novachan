// move() must be ZERO COST and must not disturb correct programs.
fn consume(v: list) -> int
    let t = 0
    for x in v
        t = t + x
    t

fn main()
    let a = [1, 2, 3]
    let s = consume(move(a))          // a is dead after this
    print("sum=" + str(s))

    // moving into a struct field
    let b = [10, 20]
    let box = {}
    box["v"] = move(b)
    print("boxed=" + str(len(box["v"])))

    // a fresh binding may reuse the name after the move
    let a2 = [7]
    let c = consume(move(a2))
    print("c=" + str(c))

    // move of a string, then rebind
    let s1 = "hello"
    let s2 = move(s1)
    print("s2=" + s2)
    let s1b = "again"
    print("s1b=" + s1b)
