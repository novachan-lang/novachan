// KAT for std/text/syllable
import std/text/syllable

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + got + " want " + want)
        exit(1)

fn main()
    // KAT 1: "cat" -> 1 (single vowel group, no trailing e)
    cki("cat", sy_count("cat"), 1)

    // KAT 2: "apple" -> 2 (a + e, but trailing 'e' after 'l' = -le ending, no silent-e subtraction)
    cki("apple", sy_count("apple"), 2)

    // KAT 3: "banana" -> 3 (three vowel groups: a, a, a)
    cki("banana", sy_count("banana"), 3)

    // KAT 4: "code" -> 1 (o + e, silent trailing 'e' after 'd', subtract -> 1)
    cki("code", sy_count("code"), 1)

    // KAT 5: "coding" -> 2 (o + i, no trailing e)
    cki("coding", sy_count("coding"), 2)

    // KAT 6: "queue" -> 1 (one continuous vowel group: ueue; trailing e preceded by u=vowel, no subtract)
    cki("queue", sy_count("queue"), 1)

    // KAT 7: "rhythm" -> >= 1 (y treated as vowel -> 1 group)
    let rhy = sy_count("rhythm")
    if rhy < 1
        print("FAIL rhythm: got " + str(rhy) + " want >= 1")
        exit(1)

    // KAT 8: "" -> 0 (empty word)
    cki("empty", sy_count(""), 0)

    // KAT 9: sy_is_monosyllabic("cat") -> 1 (true)
    cki("mono_cat", sy_is_monosyllabic("cat"), 1)

    // KAT 10: sy_is_monosyllabic("banana") -> 0 (false, 3 syllables)
    cki("mono_banana", sy_is_monosyllabic("banana"), 0)

    // KAT 11: sy_count_sentence("The cat sat") -> 1+1+1 = 3
    cki("sentence_basic", sy_count_sentence("The cat sat"), 3)

    // KAT 12: sy_count_sentence("") -> 0
    cki("sentence_empty", sy_count_sentence(""), 0)

    // KAT 13: "bike" -> 1 (i + e; trailing e after k=non-vowel, last2="ke"->ok, groups=2>1 -> subtract -> 1)
    cki("bike", sy_count("bike"), 1)

    // KAT 14: "table" -> 2 (a + e; trailing e after l="le" ending -> no subtract -> 2)
    cki("table", sy_count("table"), 2)

    print("_syllable_test passed")
