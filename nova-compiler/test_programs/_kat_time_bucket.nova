import forge_time_bucket

fn main()
    let tb = tb_new(60)
    tb = tb_record(tb, 10, 100)
    tb = tb_record(tb, 30, 200)
    tb = tb_record(tb, 50, 150)
    tb = tb_record(tb, 70, 300)
    tb = tb_record(tb, 130, 50)
    assert(tb_total_records(tb) == 5, "5 records")
    assert(tb_bucket_count(tb) == 3, "3 buckets")

    let c0 = tb_count(tb, 0)
    assert(is_ok(c0), "count ok")
    assert(unwrap(c0) == 3, "bucket 0 has 3")

    let s0 = tb_sum(tb, 0)
    assert(unwrap(s0) == 450, "bucket 0 sum 450")

    let m0 = tb_mean(tb, 0)
    assert(unwrap(m0) == 150, "bucket 0 mean 150")

    let mn0 = tb_min_val(tb, 0)
    assert(unwrap(mn0) == 100, "bucket 0 min 100")

    let mx0 = tb_max_val(tb, 0)
    assert(unwrap(mx0) == 200, "bucket 0 max 200")

    let c1 = tb_count(tb, 1)
    assert(unwrap(c1) == 1, "bucket 1 has 1")
    assert(unwrap(tb_sum(tb, 1)) == 300, "bucket 1 sum 300")

    let c2 = tb_count(tb, 2)
    assert(unwrap(c2) == 1, "bucket 2 has 1")

    let bad = tb_count(tb, 99)
    assert(is_err(bad), "no bucket 99")

    let bl = tb_bucket_list(tb)
    assert(len(bl) > 0, "bucket list non-empty")

    print("TIME-BUCKET KAT PASS")
