// cross-module struct repro: XS + YS share field name "a" at DIFFERENT slots.
type XS
    a: int          // slot 1
    b: string
    c: dict

type YS
    p: int
    a: int          // slot 2 -- collides with XS.a (slot 1) in a GLOBAL field map
    q: dict

fn mk_xs() -> XS
    let d = {}
    d["k"] = "v"
    XS(7, "hi", d)

fn mk_ys() -> YS
    YS(1, 99, {})
