import std/geometry3d/cg3_sphere

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn main()
    // cgs3_dist_sq: squared distance
    cki("dist_sq origin", cgs3_dist_sq([0,0,0], [3,4,0]), 25)
    cki("dist_sq general", cgs3_dist_sq([1,2,3], [4,6,3]), 25)
    cki("dist_sq same", cgs3_dist_sq([5,5,5], [5,5,5]), 0)

    // cgs3_contains: [0,0,0] r_sq=25 contains [3,4,0] (dist^2=25<=25)
    ckb("contains on surface", cgs3_contains([0,0,0], 25, [3,4,0]), true)
    // [3,4,1]: dist^2 = 9+16+1 = 26 > 25
    ckb("contains outside", cgs3_contains([0,0,0], 25, [3,4,1]), false)
    // [2,2,2]: dist^2 = 4+4+4 = 12 <= 25
    ckb("contains inside", cgs3_contains([0,0,0], 25, [2,2,2]), true)
    // center itself
    ckb("contains center", cgs3_contains([1,2,3], 10, [1,2,3]), true)
    // point sphere (r_sq=0) contains only its center
    ckb("point sphere self", cgs3_contains([3,3,3], 0, [3,3,3]), true)
    ckb("point sphere other", cgs3_contains([3,3,3], 0, [3,3,4]), false)

    // cgs3_on_surface: exactly dist^2 == r_sq
    ckb("on_surface yes", cgs3_on_surface([0,0,0], 25, [3,4,0]), true)
    ckb("on_surface inside", cgs3_on_surface([0,0,0], 25, [2,2,2]), false)
    ckb("on_surface outside", cgs3_on_surface([0,0,0], 25, [3,4,1]), false)

    // cgs3_spheres_intersect
    // [0,0,0] r_sq=4 (r=2) and [3,0,0] r_sq=4 (r=2): r1+r2=4 >= dist=3 -> true
    ckb("intersect overlap", cgs3_spheres_intersect([0,0,0], 4, [3,0,0], 4), true)
    // [0,0,0] r_sq=1 (r=1) and [5,0,0] r_sq=1 (r=1): r1+r2=2 < dist=5 -> false
    ckb("intersect separated", cgs3_spheres_intersect([0,0,0], 1, [5,0,0], 1), false)
    // Touching: [0,0,0] r_sq=4 (r=2) and [4,0,0] r_sq=4 (r=2): r1+r2=4=dist=4 -> true
    ckb("intersect touch", cgs3_spheres_intersect([0,0,0], 4, [4,0,0], 4), true)
    // One inside other: [0,0,0] r_sq=100 and [1,0,0] r_sq=1 -> true
    ckb("intersect one inside", cgs3_spheres_intersect([0,0,0], 100, [1,0,0], 1), true)
    // Same center, zero radius: r1+r2=0, dist=0 -> true
    ckb("intersect point spheres same", cgs3_spheres_intersect([0,0,0], 0, [0,0,0], 0), true)

    print("PASS _cg3_sphere_test")
