// _forge_mw_test.nova -- Forge v0.3: composable middleware chain.
// Validates that use()'d middleware wraps the route dispatch (outside-in), each mw can
// modify the response, and routing/params still work through the chain. Pure dispatch
// (deterministic, no socket) -- the chain logic is socket-independent.
import forge

fn h_index(req)
    forge.json_obj(200, [["msg", "ok"]])

fn h_user(req)
    forge.json_obj(200, [["id", req["params"]["id"]]])

fn main()
    let a = forge.app()
    forge.use(a, forge.mw_logger())                 // outermost (first registered)
    forge.use(a, forge.mw_header("X-Forge", "nova"))
    forge.use(a, forge.mw_cors("*"))                // innermost (closest to the route)
    forge.get(a, "/", fn(req) h_index(req))
    forge.get(a, "/u/:id", fn(req) h_user(req))

    // index through the full chain: body + both middleware-added headers present
    let r1 = forge.dispatch(a, "GET", "/", "")
    assert(find(r1, "\"msg\":\"ok\"") >= 0, "routed + body through chain")
    assert(find(r1, "X-Forge: nova") >= 0, "mw_header applied")
    assert(find(r1, "Access-Control-Allow-Origin: *") >= 0, "mw_cors applied")
    print("PASS: forge middleware chain (header + cors both wrap the response)")

    // param route through the same chain
    let r2 = forge.dispatch(a, "GET", "/u/42", "")
    assert(find(r2, "\"id\":\"42\"") >= 0, "param routed through chain")
    assert(find(r2, "X-Forge: nova") >= 0, "mw applied on param route too")
    print("PASS: forge middleware chain (param route)")

    // 404 still flows through the chain (mw sees it too)
    let r3 = forge.dispatch(a, "GET", "/nope", "")
    assert(find(r3, "404") >= 0, "404 through chain")
    assert(find(r3, "X-Forge: nova") >= 0, "mw wraps 404 too")
    print("PASS: forge middleware chain (404 wrapped)")
    print("ALL PASS: forge_mw")
