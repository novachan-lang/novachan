// _n1_stale_pid_test -- with NOVA_SCHED_RECLAIM_TASK=1, verifies that monitoring a STALE spawn handle
// (whose task finished and whose slot was RECYCLED by later spawns) is GRACEFUL: the generation check
// makes nova_task_deref return NULL -> monitor() sends NOPROC, never a use-after-free and never the
// wrong (recycled) task. Run at NOVA_CARRIERS=4 + ASAN with the reclaim flag ON for the real stress.
// (Without reclaim the slot is never reused, so this also passes trivially -- it is the RECLAIM-ON run
// that exercises the stale-handle path.)
fn worker() -> int
    1

fn churn(n: int)
    let i = 0
    while i < n
        let q = spawn worker()
        receive(monitor(q))
        i = i + 1

fn main()
    let p = spawn worker()
    receive(monitor(p))        // p finishes; its slot is freelist-pushed (RECLAIM-ON)
    churn(300)                 // 300 spawn/finish cycles -> p's slot is reused, its generation bumped

    // Monitor the now-STALE p many times: each deref(p) must mismatch the bumped generation -> NOPROC,
    // never touching the recycled task's struct. ASAN catches any UAF; a wrong-task bug would hang or
    // return a bogus status. We only assert it stays graceful (returns, no crash, no hang).
    let k = 0
    let handled = 0
    let sum = 0
    while k < 500
        let st = receive(monitor(p))
        sum = sum + st
        handled = handled + 1
        k = k + 1
    assert(handled == 500, "all stale monitors handled (got " + str(handled) + ")")
    print("PASS stale_pid: 500 stale-handle monitors graceful, status sum=" + str(sum) + " (no UAF, no wrong-task, no hang)")
