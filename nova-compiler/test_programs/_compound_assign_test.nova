fn main()
    let a = 10
    a += 5
    assert(a == 15, "+= works")

    a -= 3
    assert(a == 12, "-= works")

    a *= 2
    assert(a == 24, "*= works")

    a /= 4
    assert(a == 6, "/= works")

    a %= 4
    assert(a == 2, "%= works")

    a = 3
    a **= 4
    assert(a == 81, "**= works: 3^4 = 81")

    let items = [10, 20, 30]
    items[1] += 5
    assert(items[1] == 25, "+= on index works")

    items[0] %= 3
    assert(items[0] == 1, "%= on index works")

    print("compound_assign_test: all passed")
