import std/encoding/morse

// Helper check functions
fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

// ── KAT: mo_encode ────────────────────────────────────────────────────────────

// KAT-1: SOS — classic distress signal
cks("encode_SOS",  mo_encode("SOS"),  "... --- ...")

// KAT-2: two-letter word — letters separated by single space
cks("encode_HI",   mo_encode("HI"),   ".... ..")

// KAT-3: two words with space -> " / " word separator
// A=.- B=-... (3 dots not 4)
cks("encode_A_B",  mo_encode("A B"),  ".- / -...")

// KAT-4: single letter E (shortest Morse code)
cks("encode_E",    mo_encode("E"),    ".")

// KAT-5: digit 1
cks("encode_1",    mo_encode("1"),    ".----")

// KAT-6: digit 0
cks("encode_0",    mo_encode("0"),    "-----")

// KAT-7: lowercase input is treated case-insensitively
cks("encode_sos_lower", mo_encode("sos"), "... --- ...")

// KAT-8: multi-letter word
cks("encode_HELLO", mo_encode("HELLO"), ".... . .-.. .-.. ---")

// ── KAT: mo_decode ────────────────────────────────────────────────────────────

// KAT-9: decode SOS
cks("decode_SOS",  mo_decode("... --- ..."),  "SOS")

// KAT-10: decode word boundary (" / ") -> space
cks("decode_A_B",  mo_decode(".- / -..."),    "A B")

// KAT-11: decode single symbol E
cks("decode_E",    mo_decode("."),             "E")

// KAT-12: decode digit 1
cks("decode_1",    mo_decode(".----"),         "1")

// ── KAT: round-trip ───────────────────────────────────────────────────────────

// KAT-13: round-trip HELLO
cks("rt_HELLO",    mo_decode(mo_encode("HELLO")),  "HELLO")

// KAT-14: round-trip with digits
cks("rt_NOVA1",    mo_decode(mo_encode("NOVA1")),  "NOVA1")

// KAT-15: round-trip multi-word
cks("rt_multi",    mo_decode(mo_encode("HI WORLD")), "HI WORLD")

print("_morse_test passed")
