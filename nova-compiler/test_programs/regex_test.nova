// Regex test — NOVA's "matches" keyword and regex stdlib

// Basic matching
assert("hello123" matches "\\d+", "digits in string")
assert("hello world" matches "world", "literal match")
assert(not ("hello" matches "\\d+"), "no digits")

// Character classes
assert("cat" matches "[abc]at", "char class")
assert("2024" matches "^\\d+$", "all digits anchored")
assert(not ("hello" matches "^\\d+$"), "not all digits")

// Wildcards and quantifiers
assert("abc" matches "a.c", "dot wildcard")
assert("aXc" matches "a.c", "dot matches any")
assert("ac" matches "ab?c", "optional b")
assert("abc" matches "ab?c", "optional b present")
assert("aXXXb" matches "a.+b", "one or more")
assert("ab" matches "a.*b", "zero or more")

// Escape sequences
assert("hello world" matches "\\w+\\s\\w+", "word space word")
assert(not ("hello" matches "\\s"), "no whitespace")

// regex_find — extracts first match
result = regex_find("price is 42 dollars", "\\d+")
assert(result == "42", "find digits")

empty = regex_find("no numbers here", "\\d+")
assert(empty == "", "find no match returns empty")

// regex_replace — replaces first match
replaced = regex_replace("hello world", "world", "NOVA")
assert(replaced == "hello NOVA", "simple replace")

replaced2 = regex_replace("foo123bar", "\\d+", "NUM")
assert(replaced2 == "fooNUMbar", "regex replace digits")

// regex_split
parts = regex_split("one:two:three", ":")
assert(len(parts) == 3, "split count")
assert(parts[0] == "one", "split first")
assert(parts[1] == "two", "split second")
assert(parts[2] == "three", "split third")

parts2 = regex_split("a1b2c3d", "\\d")
assert(len(parts2) == 4, "digit split count")
assert(parts2[0] == "a", "digit split a")
assert(parts2[1] == "b", "digit split b")
assert(parts2[2] == "c", "digit split c")
assert(parts2[3] == "d", "digit split d")

print("REGEX: ALL PASSED")
