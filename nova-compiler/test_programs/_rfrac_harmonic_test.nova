import std/rational/rfrac_harmonic

fn ckr(label, got, wn, wd)
    if got[0] != wn or got[1] != wd
        print("FAIL rfrac_harmonic " + label + ": got=" + str(got[0]) + "/" + str(got[1]) + " want=" + str(wn) + "/" + str(wd))
        exit(1)

fn main()
    // rfh_harmonic KAT vectors
    ckr("H(1)", rfh_harmonic(1), 1, 1)
    ckr("H(2)", rfh_harmonic(2), 3, 2)
    ckr("H(3)", rfh_harmonic(3), 11, 6)
    ckr("H(4)", rfh_harmonic(4), 25, 12)
    ckr("H(5)", rfh_harmonic(5), 137, 60)

    // rfh_generalized KAT vectors
    ckr("G(2,2)", rfh_generalized(2, 2), 5, 4)
    ckr("G(3,2)", rfh_generalized(3, 2), 49, 36)

    // rfh_unit_sum KAT vector
    let dens = [2, 3, 6]
    ckr("unit_sum([2,3,6])", rfh_unit_sum(dens), 1, 1)

    // rfh_alternating_harmonic KAT vectors
    ckr("alt(2)", rfh_alternating_harmonic(2), 1, 2)
    ckr("alt(4)", rfh_alternating_harmonic(4), 7, 12)

    print("PASS _rfrac_harmonic_test")
