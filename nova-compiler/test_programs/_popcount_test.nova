import std/bits/popcount

// cki — integer known-answer check.
fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL popcount " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb — boolean known-answer check.
fn ckb(label: str, got: int, want: int)
    if got != want
        print("FAIL popcount " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // --- pc_popcount ---
    // 0: no bits set
    cki("popcount(0)", pc_popcount(0), 0)
    // 255 = 0xFF: all 8 low bits set
    cki("popcount(255)", pc_popcount(255), 8)
    // 7 = 0b111: three bits set
    cki("popcount(7)", pc_popcount(7), 3)
    // 1024 = 2^10: exactly one bit set
    cki("popcount(1024)", pc_popcount(1024), 1)
    // 1 = 2^0: exactly one bit set
    cki("popcount(1)", pc_popcount(1), 1)
    // 65535 = 0xFFFF: 16 bits set
    cki("popcount(65535)", pc_popcount(65535), 16)
    // 0xF0F0F0F0 = alternating nibbles, 16 bits set over 32
    cki("popcount(0xF0F0F0F0)", pc_popcount(0xF0F0F0F0), 16)

    // --- pc_parity ---
    // 7 = 0b111: 3 set bits -> odd -> parity = 1
    cki("parity(7)", pc_parity(7), 1)
    // 3 = 0b11: 2 set bits -> even -> parity = 0
    cki("parity(3)", pc_parity(3), 0)
    // 0: 0 set bits -> even -> parity = 0
    cki("parity(0)", pc_parity(0), 0)
    // 255 = 8 bits set -> even -> parity = 0
    cki("parity(255)", pc_parity(255), 0)

    // --- pc_hamming_weight (alias for pc_popcount) ---
    cki("hamming_weight(255)", pc_hamming_weight(255), 8)
    cki("hamming_weight(0)", pc_hamming_weight(0), 0)
    cki("hamming_weight(1024)", pc_hamming_weight(1024), 1)

    // --- pc_hamming_distance ---
    // 5 = 0b101, 6 = 0b110: XOR = 0b011 = 3, popcount(3) = 2
    cki("hamming_distance(5,6)", pc_hamming_distance(5, 6), 2)
    // identical inputs -> 0
    cki("hamming_distance(7,7)", pc_hamming_distance(7, 7), 0)
    // 0 and 255: differ in 8 bits
    cki("hamming_distance(0,255)", pc_hamming_distance(0, 255), 8)

    // --- pc_popcount_byte ---
    // 511 = 0x1FF = 0b1_1111_1111; low 8 bits = 0xFF = 8 set bits
    cki("popcount_byte(511)", pc_popcount_byte(511), 8)
    // 256 = 0x100: low 8 bits = 0 -> 0 set bits
    cki("popcount_byte(256)", pc_popcount_byte(256), 0)
    // 170 = 0xAA = 0b10101010: 4 bits set in low 8
    cki("popcount_byte(170)", pc_popcount_byte(170), 4)
    // 255: 8 bits set
    cki("popcount_byte(255)", pc_popcount_byte(255), 8)
    // 0: 0 bits set
    cki("popcount_byte(0)", pc_popcount_byte(0), 0)

    print("PASS _popcount_test")
