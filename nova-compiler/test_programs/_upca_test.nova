import std/barcode/upca

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // ── KAT 1: upca_check canonical vector ───────────────────────────────────
    cki("check_03600029145", upca_check("03600029145"), 2)

    // ── KAT 2: upca_encode produces 95-module pattern ────────────────────────
    let enc = upca_encode("03600029145")
    cki("encode_len", len(enc), 95)

    // ── KAT 3: left guard ────────────────────────────────────────────────────
    cks("encode_left_guard", slice(enc, 0, 3), "101")

    // ── KAT 4: center guard at positions 45..49 ──────────────────────────────
    cks("encode_center_guard", slice(enc, 45, 50), "01010")

    // ── KAT 5: right guard ───────────────────────────────────────────────────
    cks("encode_right_guard", slice(enc, 92, 95), "101")

    // ── KAT 6: upca_to_ean13 ─────────────────────────────────────────────────
    cks("to_ean13", upca_to_ean13("036000291452"), "0036000291452")

    // ── KAT 7: upca_valid for correct 12-digit code ──────────────────────────
    cki("valid_ok", upca_valid("036000291452"), 1)

    // ── KAT 8: upca_valid rejects wrong check ─────────────────────────────────
    cki("valid_bad", upca_valid("036000291453"), 0)
    cki("valid_bad0", upca_valid("036000291450"), 0)

    // ── KAT 9: all-zeros ─────────────────────────────────────────────────────
    // sum = 0, check = 0
    cki("check_zeros", upca_check("00000000000"), 0)
    cki("valid_zeros", upca_valid("000000000000"), 1)

    // ── KAT 10: second known UPC-A — barcode "012345678905" ──────────────────
    // Digits 0-9: 01234567890, check?
    // pos1=0*3=0, pos2=1*1=1, pos3=2*3=6, pos4=3*1=3, pos5=4*3=12, pos6=5*1=5,
    // pos7=6*3=18, pos8=7*1=7, pos9=8*3=24, pos10=9*1=9, pos11=0*3=0
    // sum=0+1+6+3+12+5+18+7+24+9+0=85, r=5, check=5
    cki("check_01234567890", upca_check("01234567890"), 5)
    cki("valid_012345678905", upca_valid("012345678905"), 1)
    cki("valid_012345678904", upca_valid("012345678904"), 0)

    // ── KAT 11: encode length for second payload ──────────────────────────────
    cki("encode_len_2", len(upca_encode("01234567890")), 95)

    // ── KAT 12: upca_to_ean13 length is 13 ──────────────────────────────────
    cki("to_ean13_len", len(upca_to_ean13("012345678905")), 13)

    print("PASS _upca_test")
