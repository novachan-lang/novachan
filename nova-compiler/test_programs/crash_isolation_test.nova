// Crash isolation ("let it crash"): a fatal inside a spawned Process is CONTAINED —
// the process fails (exit_status=1, monitor notified) but the whole program SURVIVES.
// (Spawned via the spawn-call form `spawn f()` so the body runs in the Process and we
//  get a handle to monitor.)

fn crasher()
    panic("deliberate crash")

fn unwrap_crasher()
    unwrap(parse_int_safe("not a number"))

fn good_worker()
    return 0

p1 = spawn crasher()
m1 = monitor(p1)
assert_eq(receive(m1), 1)

p2 = spawn unwrap_crasher()
m2 = monitor(p2)
assert_eq(receive(m2), 1)

p3 = spawn good_worker()
m3 = monitor(p3)
assert_eq(receive(m3), 0)

print("crash isolation passed")
