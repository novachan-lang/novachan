import std/backtracking/bt_generate_parens

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn list_contains_str(xs: list, target: string) -> bool
    let i = 0
    while i < len(xs)
        if xs[i] == target
            return true
        i = i + 1
    false

fn main()
    // gp_count: Catalan numbers
    cki("gp_count(0)", gp_count(0), 1)
    cki("gp_count(1)", gp_count(1), 1)
    cki("gp_count(2)", gp_count(2), 2)
    cki("gp_count(3)", gp_count(3), 5)
    cki("gp_count(4)", gp_count(4), 14)
    cki("gp_count(5)", gp_count(5), 42)

    // gp_solve(0) -> [""]
    let s0 = gp_solve(0)
    cki("gp_solve(0)_len", len(s0), 1)
    cks("gp_solve(0)[0]", s0[0], "")

    // gp_solve(1) -> ["()"]
    let s1 = gp_solve(1)
    cki("gp_solve(1)_len", len(s1), 1)
    cks("gp_solve(1)[0]", s1[0], "()")

    // gp_solve(2) -> ["(())", "()()"]  (depth-first: '(' before ')')
    let s2 = gp_solve(2)
    cki("gp_solve(2)_len", len(s2), 2)
    ckb("gp_solve(2)_has_(())", list_contains_str(s2, "(())"), true)
    ckb("gp_solve(2)_has_()()", list_contains_str(s2, "()()"), true)

    // gp_solve(3): len=5, must contain ((())), ()()()
    let s3 = gp_solve(3)
    cki("gp_solve(3)_len", len(s3), 5)
    ckb("gp_solve(3)_has_((()))", list_contains_str(s3, "((()))"), true)
    ckb("gp_solve(3)_has_()()()", list_contains_str(s3, "()()()"), true)
    ckb("gp_solve(3)_has_(()())", list_contains_str(s3, "(()())"), true)
    ckb("gp_solve(3)_has_(())()", list_contains_str(s3, "(())()"), true)
    ckb("gp_solve(3)_has_()(())", list_contains_str(s3, "()(())"), true)

    // Depth-first order check: first element is ((()))
    cks("gp_solve(3)[0]", s3[0], "((()))")
    // Last element is ()()()
    cks("gp_solve(3)[4]", s3[4], "()()()")

    // gp_solve(4): len=14
    let s4 = gp_solve(4)
    cki("gp_solve(4)_len", len(s4), 14)

    print("PASS _bt_generate_parens_test")
