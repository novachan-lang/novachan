fn main()
    // Basic guard: only positive numbers
    let items = [3, -1, 7, -4, 2, -8, 5]
    let positives = []
    for x in items if x > 0
        push(positives, x)
    assert_eq(len(positives), 4)
    assert_eq(positives[0], 3)
    assert_eq(positives[1], 7)
    assert_eq(positives[2], 2)
    assert_eq(positives[3], 5)

    // Guard with string filter
    let words = ["hello", "", "world", "", "nova"]
    let nonempty = []
    for w in words if len(w) > 0
        push(nonempty, w)
    assert_eq(len(nonempty), 3)
    assert_eq(nonempty[2], "nova")

    // Guard with destructuring
    let pairs = [[1, 10], [2, 20], [3, 30], [4, 40]]
    let big = []
    for (idx, val) in pairs if val > 15
        push(big, idx)
    assert_eq(len(big), 3)
    assert_eq(big[0], 2)

    // Guard with for/else
    let nums = [2, 4, 6, 8]
    for n in nums if n > 10
        assert_true(false)
    else
        assert_true(true)

    // Guard doesn't affect break/else semantics
    let result = "none"
    for x in [1, 2, 3, 4, 5] if x > 2
        if x == 4
            result = "found 4"
            break
    else
        result = "not found"
    assert_eq(result, "found 4")

    // Guard filters all → else runs
    let result2 = "none"
    for x in [1, 2, 3] if x > 100
        result2 = "impossible"
        break
    else
        result2 = "all filtered"
    assert_eq(result2, "all filtered")

    print("for_guard_test: all passed")
