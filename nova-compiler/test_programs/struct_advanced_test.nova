type Vec2
    x: Float
    y: Float

type Player
    name: String
    health: Int
    pos: Int

fn make_player(n, hp)
    Player { name: n, health: hp, pos: 0 }

fn damage(p, amount)
    Player { name: p.name, health: p.health - amount, pos: p.pos }

p1 = make_player("Hero", 100)
print(p1.name)
print(p1.health)

p2 = damage(p1, 25)
print(p2.name)
print(p2.health)

v = Vec2 { x: 3.14, y: 2.71 }
print(v.x)
print(v.y)
