// KAT test for std/numeric/interval.nova
import std/numeric/interval

fn main()
    // KAT 1: add  [1,2]+[3,4] = [4,6]
    let r1 = iv_add(iv_new(1, 2), iv_new(3, 4))
    let ok1 = iv_eq(r1, iv_new(4, 6))
    if ok1 != 1
        print("FAIL KAT1: iv_add([1,2],[3,4]) expected [4,6] got lo=" + str(r1["lo"]) + " hi=" + str(r1["hi"]))
        exit(1)

    // KAT 2: sub  [1,2]-[3,4] = [-3,-1]
    let r2 = iv_sub(iv_new(1, 2), iv_new(3, 4))
    let ok2 = iv_eq(r2, iv_new(-3, -1))
    if ok2 != 1
        print("FAIL KAT2: iv_sub([1,2],[3,4]) expected [-3,-1] got lo=" + str(r2["lo"]) + " hi=" + str(r2["hi"]))
        exit(1)

    // KAT 3: mul  [-1,2]*[3,4] = [-4,8]
    // products: -1*3=-3, -1*4=-4, 2*3=6, 2*4=8  => min=-4, max=8
    let r3 = iv_mul(iv_new(-1, 2), iv_new(3, 4))
    let ok3 = iv_eq(r3, iv_new(-4, 8))
    if ok3 != 1
        print("FAIL KAT3: iv_mul([-1,2],[3,4]) expected [-4,8] got lo=" + str(r3["lo"]) + " hi=" + str(r3["hi"]))
        exit(1)

    // KAT 4: contains  3 in [1,5] = true
    let ok4 = iv_contains(iv_new(1, 5), 3)
    if ok4 != 1
        print("FAIL KAT4: iv_contains([1,5],3) expected true")
        exit(1)

    // KAT 5: contains  6 not in [1,5] = false
    let ok5 = iv_contains(iv_new(1, 5), 6)
    if ok5 != 0
        print("FAIL KAT5: iv_contains([1,5],6) expected false")
        exit(1)

    // KAT 6: width  [2,5] = 3
    let w6 = iv_width(iv_new(2, 5))
    if w6 != 3
        print("FAIL KAT6: iv_width([2,5]) expected 3 got " + str(w6))
        exit(1)

    // KAT 7: intersect  [1,5] ∩ [3,8] = [3,5]
    let r7 = iv_intersect(iv_new(1, 5), iv_new(3, 8))
    let ok7 = iv_eq(r7, iv_new(3, 5))
    if ok7 != 1
        print("FAIL KAT7: iv_intersect([1,5],[3,8]) expected [3,5] got lo=" + str(r7["lo"]) + " hi=" + str(r7["hi"]))
        exit(1)

    // KAT 8: overlaps  [1,2] and [5,6] = false (disjoint)
    let ok8 = iv_overlaps(iv_new(1, 2), iv_new(5, 6))
    if ok8 != 0
        print("FAIL KAT8: iv_overlaps([1,2],[5,6]) expected false")
        exit(1)

    // KAT 9: neg  -[2,5] = [-5,-2]
    let r9 = iv_neg(iv_new(2, 5))
    let ok9 = iv_eq(r9, iv_new(-5, -2))
    if ok9 != 1
        print("FAIL KAT9: iv_neg([2,5]) expected [-5,-2] got lo=" + str(r9["lo"]) + " hi=" + str(r9["hi"]))
        exit(1)

    // KAT 10: overlaps true case  [1,4] and [3,7] overlap
    let ok10 = iv_overlaps(iv_new(1, 4), iv_new(3, 7))
    if ok10 != 1
        print("FAIL KAT10: iv_overlaps([1,4],[3,7]) expected true")
        exit(1)

    // KAT 11: intersect disjoint sets empty flag
    let r11 = iv_intersect(iv_new(1, 2), iv_new(5, 6))
    if contains(r11, "empty") != 1
        print("FAIL KAT11: iv_intersect([1,2],[5,6]) expected empty flag")
        exit(1)

    // KAT 12: mul all-positive  [2,3]*[4,5] = [8,15]
    let r12 = iv_mul(iv_new(2, 3), iv_new(4, 5))
    let ok12 = iv_eq(r12, iv_new(8, 15))
    if ok12 != 1
        print("FAIL KAT12: iv_mul([2,3],[4,5]) expected [8,15] got lo=" + str(r12["lo"]) + " hi=" + str(r12["hi"]))
        exit(1)

    print("_interval_test passed")
