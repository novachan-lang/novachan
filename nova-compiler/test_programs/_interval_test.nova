import std/music/interval

fn main()
    // interval(a, b) — absolute semitones, order-independent
    let got1 = interval(60, 67)
    if got1 != 7
        print("FAIL interval interval(60,67): got " + str(got1) + " want 7")
        exit(1)

    let got2 = interval(67, 60)
    if got2 != 7
        print("FAIL interval interval(67,60): got " + str(got2) + " want 7")
        exit(1)

    // interval_name
    let n7 = interval_name(7)
    if n7 != "P5"
        print("FAIL interval interval_name(7): got " + n7 + " want P5")
        exit(1)

    let n4 = interval_name(4)
    if n4 != "M3"
        print("FAIL interval interval_name(4): got " + n4 + " want M3")
        exit(1)

    let n0 = interval_name(0)
    if n0 != "P1"
        print("FAIL interval interval_name(0): got " + n0 + " want P1")
        exit(1)

    let n12 = interval_name(12)
    if n12 != "P8"
        print("FAIL interval interval_name(12): got " + n12 + " want P8")
        exit(1)

    // interval_semitones (inverse)
    let s7 = interval_semitones("P5")
    if s7 != 7
        print("FAIL interval interval_semitones(P5): got " + str(s7) + " want 7")
        exit(1)

    // interval_invert
    let inv4 = interval_invert(4)
    if inv4 != 8
        print("FAIL interval interval_invert(4): got " + str(inv4) + " want 8")
        exit(1)

    // is_consonant
    let c7 = is_consonant(7)
    if c7 != 1
        print("FAIL interval is_consonant(7): got " + str(c7) + " want 1")
        exit(1)

    let c6 = is_consonant(6)
    if c6 != 0
        print("FAIL interval is_consonant(6): got " + str(c6) + " want 0")
        exit(1)

    // additional coverage: all 13 names round-trip
    let names = ["P1","m2","M2","m3","M3","P4","TT","P5","m6","M6","m7","M7","P8"]
    let i = 0
    while i < 13
        let nm = names[i]
        let sm = interval_semitones(nm)
        let back = interval_name(sm)
        if back != nm
            print("FAIL interval round-trip " + nm + ": got " + back)
            exit(1)
        i = i + 1

    // unknown name returns -1
    let unk = interval_semitones("XX")
    if unk != -1
        print("FAIL interval interval_semitones(XX): got " + str(unk) + " want -1")
        exit(1)

    // out-of-range name returns ?
    let oob = interval_name(13)
    if oob != "?"
        print("FAIL interval interval_name(13): got " + oob + " want ?")
        exit(1)

    // is_consonant all consonant intervals
    let cons = [0,3,4,5,7,8,9,12]
    let j = 0
    while j < 8
        let sv = cons[j]
        let cv = is_consonant(sv)
        if cv != 1
            print("FAIL interval is_consonant(" + str(sv) + "): got " + str(cv) + " want 1")
            exit(1)
        j = j + 1

    // is_consonant all dissonant intervals
    let diss = [1,2,6,10,11]
    let k = 0
    while k < 5
        let sv = diss[k]
        let cv = is_consonant(sv)
        if cv != 0
            print("FAIL interval is_consonant(" + str(sv) + "): got " + str(cv) + " want 0")
            exit(1)
        k = k + 1

    // interval_invert round-trip: invert(invert(x)) == x for x in 0..12
    let m = 0
    while m < 13
        let inv2 = interval_invert(interval_invert(m))
        if inv2 != m
            print("FAIL interval invert-invert(" + str(m) + "): got " + str(inv2))
            exit(1)
        m = m + 1

    print("PASS _interval_test")
