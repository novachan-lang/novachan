import forge_rate_window

fn main()
    let r = rw_new(100)
    r = rw_record(r, 50)
    r = rw_record(r, 60)
    r = rw_record(r, 70)
    r = rw_record(r, 150)

    assert(rw_count_in_window(r, 160) == 2, "2 in window (60..160]")
    assert(rw_total(r) == 4, "4 total")

    let rate = rw_rate_per_second(r, 160)
    assert(is_ok(rate), "rate ok")
    assert(unwrap(rate) == 20, "20 per 1000ms")

    let oldest = rw_oldest_in_window(r, 160)
    assert(is_ok(oldest), "oldest ok")
    assert(unwrap(oldest) == 70, "oldest=70")

    assert(rw_is_over_limit(r, 160, 1) == 1, "over limit 1")
    assert(rw_is_over_limit(r, 160, 5) == 0, "under limit 5")

    let r2 = rw_new(10)
    let empty = rw_oldest_in_window(r2, 100)
    assert(is_err(empty), "no events in empty window")

    print("RATE-WINDOW KAT PASS")
