// KAT test for std/compress/rle_bitmap
// Tests: rle_bitmap_compress, rle_bitmap_decompress — bit-run-length encoding.
// PRIMARY gate: round-trip decompress(compress(bits)) == bits
// SECONDARY gate: known vectors match spec.
import std/compress/rle_bitmap

// ── Helpers ───────────────────────────────────────────────────────────────────

fn _lists_eq(a, b) -> int
    let na = len(a)
    let nb = len(b)
    if na != nb
        return 0
    let i = 0
    while i < na
        if a[i] != b[i]
            return 0
        i = i + 1
    1

fn list_to_str(xs) -> string
    let s = "["
    let n = len(xs)
    let i = 0
    while i < n
        if i > 0
            s = s + ","
        s = s + str(xs[i])
        i = i + 1
    s + "]"

fn check_lists(label, got, want)
    if _lists_eq(got, want) == 0
        print("FAIL " + label + ": got=" + list_to_str(got) + " want=" + list_to_str(want))
        exit(1)

fn check_int(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ── KAT 1: empty input ───────────────────────────────────────────────────────

let comp1 = rle_bitmap_compress([])
check_lists("empty_compress", comp1, [])
let rt1 = rle_bitmap_decompress(comp1)
check_lists("empty_roundtrip", rt1, [])

// ── KAT 2: single 0-bit ───────────────────────────────────────────────────────

let comp2 = rle_bitmap_compress([0])
check_lists("single0_compress", comp2, [1])
let rt2 = rle_bitmap_decompress(comp2)
check_lists("single0_roundtrip", rt2, [0])

// ── KAT 3: single 1-bit ───────────────────────────────────────────────────────

let comp3 = rle_bitmap_compress([1])
// First bit is 1 -> leading 0-run of 0, then 1-run of 1: [0, 1]
check_lists("single1_compress", comp3, [0, 1])
let rt3 = rle_bitmap_decompress(comp3)
check_lists("single1_roundtrip", rt3, [1])

// ── KAT 4: [1,1,1,0,0,1] from spec ──────────────────────────────────────────

let in4 = [1, 1, 1, 0, 0, 1]
let comp4 = rle_bitmap_compress(in4)
// 0 leading zeros, 3 ones, 2 zeros, 1 one -> [0, 3, 2, 1]
check_lists("spec_example1_compress", comp4, [0, 3, 2, 1])
let rt4 = rle_bitmap_decompress(comp4)
check_lists("spec_example1_roundtrip", rt4, in4)

// ── KAT 5: [0,0,1,1,1,0,1] from spec ────────────────────────────────────────

let in5 = [0, 0, 1, 1, 1, 0, 1]
let comp5 = rle_bitmap_compress(in5)
// 2 zeros, 3 ones, 1 zero, 1 one -> [2, 3, 1, 1]
check_lists("spec_example2_compress", comp5, [2, 3, 1, 1])
let rt5 = rle_bitmap_decompress(comp5)
check_lists("spec_example2_roundtrip", rt5, in5)

// ── KAT 6: all-zeros ─────────────────────────────────────────────────────────

let in6 = [0, 0, 0, 0, 0]
let comp6 = rle_bitmap_compress(in6)
// All zeros -> single run [5]
check_lists("all_zeros_compress", comp6, [5])
let rt6 = rle_bitmap_decompress(comp6)
check_lists("all_zeros_roundtrip", rt6, in6)

// ── KAT 7: all-ones ──────────────────────────────────────────────────────────

let in7 = [1, 1, 1, 1]
let comp7 = rle_bitmap_compress(in7)
// 0 leading zeros, 4 ones -> [0, 4]
check_lists("all_ones_compress", comp7, [0, 4])
let rt7 = rle_bitmap_decompress(comp7)
check_lists("all_ones_roundtrip", rt7, in7)

// ── KAT 8: alternating [0,1,0,1,0,1] ────────────────────────────────────────

let in8 = [0, 1, 0, 1, 0, 1]
let rt8 = rle_bitmap_decompress(rle_bitmap_compress(in8))
check_lists("alternating_roundtrip", rt8, in8)

// ── KAT 9: longer mixed pattern ──────────────────────────────────────────────

let in9 = [0, 0, 0, 1, 1, 0, 0, 1, 1, 1, 1, 0]
let rt9 = rle_bitmap_decompress(rle_bitmap_compress(in9))
check_lists("longer_mixed", rt9, in9)

// ── KAT 10: rle_bitmap_decompress known vector ───────────────────────────────

// [2, 3, 1, 1] -> [0,0,1,1,1,0,1]
let dec10 = rle_bitmap_decompress([2, 3, 1, 1])
check_lists("decompress_known", dec10, [0, 0, 1, 1, 1, 0, 1])

// ── KAT 11: rle_bitmap_decompress [0, 4] -> [1,1,1,1] ───────────────────────

let dec11 = rle_bitmap_decompress([0, 4])
check_lists("decompress_0_4", dec11, [1, 1, 1, 1])

// ── KAT 12: long run for compression ratio ────────────────────────────────────

let in12 = []
let i12 = 0
while i12 < 50
    in12.push(0)
    i12 = i12 + 1
while i12 < 100
    in12.push(1)
    i12 = i12 + 1

// compress -> 2 runs, decompress -> original
let comp12 = rle_bitmap_compress(in12)
check_int("two_runs_compress_len", len(comp12), 2)
check_int("two_runs_first", comp12[0], 50)
check_int("two_runs_second", comp12[1], 50)
let rt12 = rle_bitmap_decompress(comp12)
check_lists("long_run_roundtrip", rt12, in12)

// ── KAT 13: [1] followed by zeros ────────────────────────────────────────────

let in13 = [1, 0, 0, 0]
let rt13 = rle_bitmap_decompress(rle_bitmap_compress(in13))
check_lists("one_then_zeros", rt13, in13)

print("PASS _rle_bitmap_test")
