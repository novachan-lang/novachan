// _ean_test.nova — KAT for std/validation/ean

import std/validation/ean

fn main()
    // KAT 1: valid EAN-13 "4006381333931"
    let r1 = vean_is_valid_ean13("4006381333931")
    if r1 == false
        print("FAIL KAT1: vean_is_valid_ean13(\"4006381333931\") expected true")
        exit(1)

    // KAT 2: invalid EAN-13 — wrong check digit
    let r2 = vean_is_valid_ean13("4006381333930")
    if r2 == true
        print("FAIL KAT2: vean_is_valid_ean13(\"4006381333930\") expected false")
        exit(1)

    // KAT 3: valid EAN-13 "5901234123457"
    let r3 = vean_is_valid_ean13("5901234123457")
    if r3 == false
        print("FAIL KAT3: vean_is_valid_ean13(\"5901234123457\") expected true")
        exit(1)

    // KAT 4: valid UPC-A "036000291452"
    let r4 = vean_is_valid_upca("036000291452")
    if r4 == false
        print("FAIL KAT4: vean_is_valid_upca(\"036000291452\") expected true")
        exit(1)

    // KAT 5: invalid UPC-A — wrong check digit
    let r5 = vean_is_valid_upca("036000291453")
    if r5 == true
        print("FAIL KAT5: vean_is_valid_upca(\"036000291453\") expected false")
        exit(1)

    // KAT 6: check digit computation for EAN-13 prefix "400638133393"
    let r6 = vean_check_ean13("400638133393")
    if r6 != 1
        print("FAIL KAT6: vean_check_ean13(\"400638133393\") expected 1 got " + str(r6))
        exit(1)

    // KAT 7: UPC-A to EAN-13 conversion
    let r7 = vean_upca_to_ean13("036000291452")
    if r7 != "0036000291452"
        print("FAIL KAT7: vean_upca_to_ean13(\"036000291452\") expected \"0036000291452\" got " + r7)
        exit(1)

    // KAT 8: wrong-length inputs return false / -1
    let r8a = vean_is_valid_ean13("123")
    if r8a == true
        print("FAIL KAT8a: short string should fail EAN-13 validation")
        exit(1)
    let r8b = vean_check_ean13("123456789")
    if r8b != -1
        print("FAIL KAT8b: vean_check_ean13 on wrong-length should return -1")
        exit(1)

    print("_ean_test passed")
