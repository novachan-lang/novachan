// Forge T4.11: GenServer on_terminate cleanup. A terminate callback registered before gen_start runs
// with reason "normal" when the server is stopped (gen_stop). Socketless (actor/channel), kill-on-timeout.
import forge_otp

fn noop_handle(state, msg)
    [state, state]

fn do_term(done, reason)
    send(done, reason)

fn main()
    let done = channel()
    let srv = server(0, noop_handle)
    let tfn = fn(s, r) do_term(done, r)   // single-line lambda capturing the shared `done` channel
    on_terminate(srv, tfn)
    gen_start(srv)
    gen_stop(srv)                          // -> loop runs terminate(state, "normal")
    let r = receive(done)
    if r != "normal"
        print("FAIL: terminate reason expected 'normal', got " + r)
        exit(1)
    print("PASS forge_server_terminate (on_terminate ran with reason 'normal' on gen_stop)")
