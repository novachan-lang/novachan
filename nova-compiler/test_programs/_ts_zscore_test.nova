import std/math/ts_zscore

fn approx(a: float, b: float, tol: float) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < tol
        return 1
    return 0

fn ckf(label: str, got: float, want: float, tol: float)
    if approx(got, want, tol) == 0
        print("FAIL " + label + " got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // KAT 1: [1.0,2.0,3.0] -> [-1.2247, 0.0, 1.2247]
    // mean=2.0, var=(1+0+1)/3=2/3, std=sqrt(2/3)=0.8165
    let d1 = [1.0, 2.0, 3.0]
    let r1 = ts_zscore(d1)
    ckf("ts_zscore[0]", r1[0] * 1.0, -1.2247, 0.001)
    ckf("ts_zscore[1]", r1[1] * 1.0, 0.0, 0.001)
    ckf("ts_zscore[2]", r1[2] * 1.0, 1.2247, 0.001)

    // KAT 2: constant series -> all 0.0
    let d2 = [5.0, 5.0, 5.0]
    let r2 = ts_zscore(d2)
    ckf("ts_zscore_const[0]", r2[0] * 1.0, 0.0, 0.001)
    ckf("ts_zscore_const[1]", r2[1] * 1.0, 0.0, 0.001)
    ckf("ts_zscore_const[2]", r2[2] * 1.0, 0.0, 0.001)

    // KAT 3: two-element series [0.0, 4.0]
    // mean=2.0, var=(4+4)/2=4, std=2.0
    // z: (0-2)/2=-1.0, (4-2)/2=1.0
    let d3 = [0.0, 4.0]
    let r3 = ts_zscore(d3)
    ckf("ts_zscore_two[0]", r3[0] * 1.0, -1.0, 0.001)
    ckf("ts_zscore_two[1]", r3[1] * 1.0, 1.0, 0.001)

    // KAT 4: empty list returns empty
    let d4 = []
    let r4 = ts_zscore(d4)
    let rlen = len(r4)
    if rlen != 0
        print("FAIL ts_zscore_empty len=" + str(rlen))
        exit(1)

    print("PASS _ts_zscore_test")
