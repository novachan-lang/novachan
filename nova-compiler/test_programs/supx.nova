// supx — supervisor: spawn a child Process and restart it on signaled failure up to
// a limit (Erlang's "let it crash" recovery, the NOVA way over spawn + channel).
// supervise(child, max_restarts) -> [done, restarts, payload]. The child is
// fn(attempt, result_ch) that sends [ok, payload] (ok=1 success, 0 failure) on the
// channel. Deterministic rendezvous (no timing). Children are short-lived (one signal
// each) so program-exit join stays clean.
// (Scope: restart-on-signaled-failure — the supervision pillar. True OS-crash isolation
//  across processes is the deeper Track-8 ownership work.)

fn supervise(child, max_restarts)
    let result_ch = channel()
    let attempt = 0
    let done = 0
    let payload = 0
    while done == 0 and attempt <= max_restarts
        let a = attempt
        spawn fn()
            child(a, result_ch)
        let r = receive(result_ch)
        if r[0] == 1
            payload = r[1]
            done = 1
        else
            attempt = attempt + 1
    return [done, attempt, payload]

// child: fails on attempts 0 and 1, succeeds on attempt 2 (payload 100+attempt)
fn flaky_worker(attempt, ch)
    if attempt < 2
        send(ch, [0, 0])
    else
        send(ch, [1, 100 + attempt])

fn always_fail(attempt, ch)
    send(ch, [0, 0])

fn always_ok(attempt, ch)
    send(ch, [1, 42])

fn main()
    let r = supervise(flaky_worker, 5)
    assert_eq(r[0], 1)        // recovered
    assert_eq(r[1], 2)        // after exactly 2 restarts
    assert_eq(r[2], 102)      // success payload

    let r2 = supervise(always_fail, 3)
    assert_eq(r2[0], 0)       // never recovered (exhausted restarts)
    assert_eq(r2[1], 4)       // attempts 0..3 then give up

    let r3 = supervise(always_ok, 5)
    assert_eq(r3[0], 1)
    assert_eq(r3[1], 0)       // succeeded first try
    assert_eq(r3[2], 42)

    print("supx passed")
