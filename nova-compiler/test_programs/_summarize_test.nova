// KAT for std/text/summarize
import std/text/summarize

fn cki(label, got, want) -> int
    if got == want
        return 0
    print("FAIL summarize " + label + ": got=" + str(got) + " want=" + str(want))
    exit(1)
    0

fn cks(label, got, want) -> int
    if got == want
        return 0
    print("FAIL summarize " + label + ": got=" + got + " want=" + want)
    exit(1)
    0

fn main()
    // 4-sentence text where sentence 2 repeats the most common content words.
    // Sentence indices: 0, 1, 2, 3
    // Sentence 2 ("Data science data science data science drives insights.") heavily
    // repeats "data" and "science" — those should dominate word freq.
    let text = "Machine learning is a field of study. Data science data science data science drives insights. Artificial intelligence powers modern tools. Statistics and data underpin everything."

    // sm_sentence_count == 4
    cki("sentence_count", sm_sentence_count(text), 4)

    // sm_lead returns first 2 sentences joined
    let lead = sm_lead(text, 2)
    // Must start with "Machine"
    let lead_start = slice(lead, 0, 7)
    cks("lead_start", lead_start, "Machine")
    // Must NOT be empty
    if len(lead) == 0
        print("FAIL summarize lead_nonempty")
        exit(1)

    // sm_top_sentences(text, 1) returns the sentence with highest score.
    // The sentence "Data science data science data science drives insights." is
    // at index 1 and has the highest word-freq score (data x3, science x3).
    let top1 = sm_top_sentences(text, 1)
    cki("top1_count", len(top1), 1)
    let top_idx = top1[0]["index"]
    cki("top1_index", top_idx, 1)

    // sm_top_sentences preserves original order (indices ascending)
    let top2 = sm_top_sentences(text, 2)
    cki("top2_count", len(top2), 2)
    let idx0 = top2[0]["index"]
    let idx1 = top2[1]["index"]
    if idx0 >= idx1
        print("FAIL summarize top2_order: idx0=" + str(idx0) + " idx1=" + str(idx1))
        exit(1)

    // sm_summary(text, 2) is non-empty and shorter than full text
    let summary = sm_summary(text, 2)
    if len(summary) == 0
        print("FAIL summarize summary_nonempty")
        exit(1)
    if len(summary) >= len(text)
        print("FAIL summarize summary_shorter: summary_len=" + str(len(summary)) + " text_len=" + str(len(text)))
        exit(1)

    // Determinism: two calls to sm_summary return same string
    let summary2 = sm_summary(text, 2)
    cks("summary_deterministic", summary, summary2)

    // sm_sentence_count on empty
    cki("sc_empty", sm_sentence_count(""), 0)

    // sm_lead on empty
    let lead_empty = sm_lead("", 2)
    cks("lead_empty", lead_empty, "")

    // sm_summary on empty
    let sum_empty = sm_summary("", 2)
    cks("summary_empty", sum_empty, "")

    // sm_keywords: should return a list; top keyword should be "data" or "science"
    let kws = sm_keywords(text, 3)
    if len(kws) == 0
        print("FAIL summarize keywords_nonempty")
        exit(1)
    let kw1 = kws[0]
    if kw1 != "data" and kw1 != "science"
        print("FAIL summarize keyword_top: got=" + kw1)
        exit(1)

    // sm_compression_ratio: summary shorter than text → ratio < 1.0
    let ratio = sm_compression_ratio(text, summary)
    if ratio <= 0.0
        print("FAIL summarize ratio_pos: got=" + str(ratio))
        exit(1)
    if ratio >= 1.0
        print("FAIL summarize ratio_lt1: got=" + str(ratio))
        exit(1)

    // sm_compression_ratio on empty text returns 0.0
    let ratio_empty = sm_compression_ratio("", "x")
    if ratio_empty != 0.0
        print("FAIL summarize ratio_empty: got=" + str(ratio_empty))
        exit(1)

    // sm_centroid_score: returns a list of 4 entries
    let centroid = sm_centroid_score(text)
    cki("centroid_count", len(centroid), 4)

    print("PASS _summarize_test")
