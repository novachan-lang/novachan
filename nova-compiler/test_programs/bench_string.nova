// String operations benchmark (vs Python)
fn string_work(n)
    result = ""
    i = 0
    while i < n
        result = result + "hello"
        i = i + 1
    len(result)

fn string_search(n)
    s = "the quick brown fox jumps over the lazy dog"
    count = 0
    i = 0
    while i < n
        if s.contains("fox")
            count = count + 1
        if s.starts_with("the")
            count = count + 1
        if s.ends_with("dog")
            count = count + 1
        i = i + 1
    count

r1 = string_work(1000)
r2 = string_search(100000)
print(r1)
print(r2)
