// KAT for std/math/introot — exact integer roots, pure integer arithmetic.
// All expected values are hand-computed.
import std/math/introot

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let g = "false"
        if got
            g = "true"
        let w = "false"
        if want
            w = "true"
        print("FAIL " + label + ": got " + g + " want " + w)
        exit(1)

fn main()
    // ir_isqrt KATs
    // isqrt(0): 0*0=0 <= 0, result=0
    cki("isqrt(0)", ir_isqrt(0), 0)
    // isqrt(1): 1*1=1 <= 1, result=1
    cki("isqrt(1)", ir_isqrt(1), 1)
    // isqrt(15): 3*3=9<=15, 4*4=16>15 -> 3
    cki("isqrt(15)", ir_isqrt(15), 3)
    // isqrt(16): 4*4=16<=16 -> 4
    cki("isqrt(16)", ir_isqrt(16), 4)
    // isqrt(1000000): 1000*1000=1000000 -> 1000
    cki("isqrt(1000000)", ir_isqrt(1000000), 1000)
    // isqrt(2): 1*1=1<=2, 2*2=4>2 -> 1
    cki("isqrt(2)", ir_isqrt(2), 1)
    // isqrt(4): 2*2=4 -> 2
    cki("isqrt(4)", ir_isqrt(4), 2)

    // ir_icbrt KATs
    // icbrt(27): 3*3*3=27 -> 3
    cki("icbrt(27)", ir_icbrt(27), 3)
    // icbrt(26): 2*2*2=8<=26, 3*3*3=27>26 -> 2
    cki("icbrt(26)", ir_icbrt(26), 2)
    // icbrt(8): 2*2*2=8 -> 2
    cki("icbrt(8)", ir_icbrt(8), 2)
    // icbrt(1): 1*1*1=1 -> 1
    cki("icbrt(1)", ir_icbrt(1), 1)

    // ir_inth_root KATs
    // inth_root(81,4): 3^4=81 -> 3
    cki("inth_root(81,4)", ir_inth_root(81, 4), 3)
    // inth_root(80,4): 2^4=16<=80, 3^4=81>80 -> 2
    cki("inth_root(80,4)", ir_inth_root(80, 4), 2)
    // inth_root(1,5): 1^5=1 -> 1
    cki("inth_root(1,5)", ir_inth_root(1, 5), 1)
    // inth_root(32,5): 2^5=32 -> 2
    cki("inth_root(32,5)", ir_inth_root(32, 5), 2)

    // ir_is_perfect_square KATs
    // 144=12*12 -> true
    ckb("is_perfect_square(144)", ir_is_perfect_square(144), true)
    // 145: isqrt=12, 12*12=144!=145 -> false
    ckb("is_perfect_square(145)", ir_is_perfect_square(145), false)
    // 0: 0*0=0 -> true
    ckb("is_perfect_square(0)", ir_is_perfect_square(0), true)

    // ir_is_perfect_cube KATs
    // 64=4*4*4 -> true
    ckb("is_perfect_cube(64)", ir_is_perfect_cube(64), true)
    // 65: icbrt=4, 4*4*4=64!=65 -> false
    ckb("is_perfect_cube(65)", ir_is_perfect_cube(65), false)
    // 1=1*1*1 -> true
    ckb("is_perfect_cube(1)", ir_is_perfect_cube(1), true)

    print("_introot_test passed")
