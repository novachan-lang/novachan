// Trait bug B regression: >=2 types conforming to a trait, USED AT TOP LEVEL,
// with top-level vars named d/c (which collided with the synthesized
// from_json_safe method's local `d` before the hygiene fix). Must compile + run.
trait Descr
    fn nm() -> string
    fn desc() -> string
        "I am " + self.nm()
    fn tg() -> string
        "object"
type Dg: Descr
    breed: string
fn Dg.nm() -> string
    "Dog(" + self.breed + ")"
type Ct: Descr
    color: string
fn Ct.nm() -> string
    "Cat(" + self.color + ")"
fn Ct.tg() -> string
    "feline"
let d = Dg("lab")
let c = Ct("org")
assert(d.desc() == "I am Dog(lab)", "d desc default")
assert(c.desc() == "I am Cat(org)", "c desc default")
assert(c.tg() == "feline", "c tg override")
assert(d.tg() == "object", "d tg inherited default")
print("PASS _kat_trait_multitype")
