// KAT test for std/data/gpx_parse
import std/data/gpx_parse

// ── Helper: approximate float equality ───────────────────────────────────────
fn approx(a, b, tol)
    let diff = a - b
    let adiff = diff
    if diff < 0.0
        adiff = 0.0 - diff
    let result = 0
    if adiff <= tol
        result = 1
    return result

// ── Test 1: empty GPX -> [] ───────────────────────────────────────────────────
let empty_gpx = "<?xml version=\"1.0\"?><gpx></gpx>"
let r0 = gpx_parse(empty_gpx)
if len(r0) != 0
    print("FAIL gpx_parse empty: expected 0 points, got " + str(len(r0)))
    exit(1)

// ── Test 2: two trkpt elements -> [[1.5,2.5],[3.0,4.0]] ─────────────────────
let gpx2 = "<gpx><trk><trkseg><trkpt lat=\"1.5\" lon=\"2.5\"></trkpt><trkpt lat=\"3.0\" lon=\"4.0\"/></trkseg></trk></gpx>"
let r2 = gpx_parse(gpx2)
if len(r2) != 2
    print("FAIL gpx_parse two_trkpt count: expected 2 got " + str(len(r2)))
    exit(1)
let p0 = r2[0]
let p1 = r2[1]
if approx(p0[0], 1.5, 0.0001) != 1
    print("FAIL gpx_parse trkpt[0].lat: expected 1.5 got " + str(p0[0]))
    exit(1)
if approx(p0[1], 2.5, 0.0001) != 1
    print("FAIL gpx_parse trkpt[0].lon: expected 2.5 got " + str(p0[1]))
    exit(1)
if approx(p1[0], 3.0, 0.0001) != 1
    print("FAIL gpx_parse trkpt[1].lat: expected 3.0 got " + str(p1[0]))
    exit(1)
if approx(p1[1], 4.0, 0.0001) != 1
    print("FAIL gpx_parse trkpt[1].lon: expected 4.0 got " + str(p1[1]))
    exit(1)

// ── Test 3: wpt element ───────────────────────────────────────────────────────
let gpx3 = "<gpx><wpt lat=\"51.5074\" lon=\"-0.1278\"/></gpx>"
let r3 = gpx_parse(gpx3)
if len(r3) != 1
    print("FAIL gpx_parse wpt count: expected 1 got " + str(len(r3)))
    exit(1)
let pw = r3[0]
if approx(pw[0], 51.5074, 0.0001) != 1
    print("FAIL gpx_parse wpt lat: got " + str(pw[0]))
    exit(1)
if approx(pw[1], 0.0 - 0.1278, 0.0001) != 1
    print("FAIL gpx_parse wpt lon: got " + str(pw[1]))
    exit(1)

// ── Test 4: mixed trkpt and wpt ───────────────────────────────────────────────
let gpx4 = "<gpx><wpt lat=\"10.0\" lon=\"20.0\"/><trk><trkseg><trkpt lat=\"30.0\" lon=\"40.0\"></trkpt></trkseg></trk></gpx>"
let r4 = gpx_parse(gpx4)
if len(r4) != 2
    print("FAIL gpx_parse mixed count: expected 2 got " + str(len(r4)))
    exit(1)
let pm0 = r4[0]
let pm1 = r4[1]
if approx(pm0[0], 10.0, 0.0001) != 1
    print("FAIL gpx_parse mixed[0].lat: got " + str(pm0[0]))
    exit(1)
if approx(pm1[0], 30.0, 0.0001) != 1
    print("FAIL gpx_parse mixed[1].lat: got " + str(pm1[0]))
    exit(1)

// ── Test 5: negative coords ───────────────────────────────────────────────────
let gpx5 = "<gpx><trkpt lat=\"-33.8688\" lon=\"151.2093\"></trkpt></gpx>"
let r5 = gpx_parse(gpx5)
if len(r5) != 1
    print("FAIL gpx_parse neg lat count")
    exit(1)
let pn = r5[0]
if approx(pn[0], 0.0 - 33.8688, 0.0001) != 1
    print("FAIL gpx_parse neg lat: got " + str(pn[0]))
    exit(1)
if approx(pn[1], 151.2093, 0.0001) != 1
    print("FAIL gpx_parse sydney lon: got " + str(pn[1]))
    exit(1)

print("PASS _gpx_parse_test")
