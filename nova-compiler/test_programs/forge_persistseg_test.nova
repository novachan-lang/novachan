import forge_persistseg as ps

fn check(cond: bool, label: str)
    if cond == false
        print("FAIL: " + label)

// TEST 1: basic persistence - build versions and query each
let t = ps.ps_new(8)
let r0 = ps.ps_root(t, 0)  // empty version
check(ps.ps_query(t, r0, 0, 7) == 0, "empty version sum = 0")

// version 1: add 5 at index 2
let r1 = ps.ps_update(t, r0, 2, 5)
check(ps.ps_query(t, r1, 0, 7) == 5, "v1 total sum = 5")
check(ps.ps_query(t, r1, 2, 2) == 5, "v1 point[2] = 5")
check(ps.ps_query(t, r1, 0, 1) == 0, "v1 sum[0..1] = 0")

// OLD version still intact (persistence!)
check(ps.ps_query(t, r0, 0, 7) == 0, "v0 STILL empty after v1 update (persistence)")

// version 2: add 3 at index 5 on top of v1
let r2 = ps.ps_update(t, r1, 5, 3)
check(ps.ps_query(t, r2, 0, 7) == 8, "v2 total = 8")
check(ps.ps_query(t, r2, 5, 5) == 3, "v2 point[5] = 3")
// v1 unchanged
check(ps.ps_query(t, r1, 0, 7) == 5, "v1 unchanged after v2 = 5")

// version 3: add 10 at index 2 on top of v2
let r3 = ps.ps_update(t, r2, 2, 10)
check(ps.ps_query(t, r3, 2, 2) == 15, "v3 point[2] = 5+10 = 15")
check(ps.ps_query(t, r3, 0, 7) == 18, "v3 total = 18")
// v2 unchanged
check(ps.ps_query(t, r2, 2, 2) == 5, "v2 point[2] STILL 5 (persistence)")

// TEST 2: range queries
let t2 = ps.ps_new(10)
let root = ps.ps_root(t2, 0)
// Add 1,2,3,...,10 at indices 0..9
let i = 0
while i < 10
    root = ps.ps_update(t2, root, i, i + 1)
    i = i + 1
check(ps.ps_query(t2, root, 0, 9) == 55, "sum 1..10 = 55")
check(ps.ps_query(t2, root, 0, 4) == 15, "sum 1..5 = 15")
check(ps.ps_query(t2, root, 5, 9) == 40, "sum 6..10 = 40")
check(ps.ps_query(t2, root, 3, 3) == 4, "point[3] = 4")

// TEST 3: DECISIVE - range k-th smallest via persistent segment tree over value axis
// Array a = [3, 1, 4, 1, 5, 9, 2, 6], values in [0, 9]
// Build prefix versions: prefix[i] = version after inserting a[0..i-1] (each +1 at its value)
let arr = [3, 1, 4, 1, 5, 9, 2, 6]
let n = len(arr)
let maxval = 9
let tv = ps.ps_new(maxval + 1)
// prefix_roots[i] = root after inserting first i elements
let prefix_roots = []
push(prefix_roots, ps.ps_root(tv, 0))  // prefix_roots[0] = empty
let cur = ps.ps_root(tv, 0)
let j = 0
while j < n
    cur = ps.ps_update(tv, cur, arr[j], 1)
    push(prefix_roots, cur)
    j = j + 1

// Range k-th smallest in a[l..r] = ps_kth(prefix_roots[l], prefix_roots[r+1], k)
// a[0..7] sorted = [1,1,2,3,4,5,6,9]
check(ps.ps_kth(tv, prefix_roots[0], prefix_roots[8], 1) == 1, "kth full array k=1 -> value 1")
check(ps.ps_kth(tv, prefix_roots[0], prefix_roots[8], 2) == 1, "kth full k=2 -> 1")
check(ps.ps_kth(tv, prefix_roots[0], prefix_roots[8], 3) == 2, "kth full k=3 -> 2")
check(ps.ps_kth(tv, prefix_roots[0], prefix_roots[8], 4) == 3, "kth full k=4 -> 3")
check(ps.ps_kth(tv, prefix_roots[0], prefix_roots[8], 8) == 9, "kth full k=8 -> 9")

// Range k-th: a[2..5] = [4,1,5,9] sorted = [1,4,5,9]
check(ps.ps_kth(tv, prefix_roots[2], prefix_roots[6], 1) == 1, "kth a[2..5] k=1 -> 1")
check(ps.ps_kth(tv, prefix_roots[2], prefix_roots[6], 2) == 4, "kth a[2..5] k=2 -> 4")
check(ps.ps_kth(tv, prefix_roots[2], prefix_roots[6], 3) == 5, "kth a[2..5] k=3 -> 5")
check(ps.ps_kth(tv, prefix_roots[2], prefix_roots[6], 4) == 9, "kth a[2..5] k=4 -> 9")

// TEST 4: DECISIVE brute-force cross-check on range-kth over many (l, r, k)
fn brute_kth_range(arr: list, l: int, r: int, k: int) -> int
    let sub = []
    let i = l
    while i <= r
        push(sub, arr[i])
        i = i + 1
    // sort
    let m = len(sub)
    let a = sub
    let x = 1
    while x < m
        let key = a[x]
        let y = x - 1
        while y >= 0 and a[y] > key
            a[y + 1] = a[y]
            y = y - 1
        a[y + 1] = key
        x = x + 1
    if k < 1 or k > m
        return 0 - 1
    return a[k - 1]

let ok = true
let l = 0
while l < n
    let rr = l
    while rr < n
        let range_size = rr - l + 1
        let kk = 1
        while kk <= range_size
            let expected = brute_kth_range(arr, l, rr, kk)
            let got = ps.ps_kth(tv, prefix_roots[l], prefix_roots[rr + 1], kk)
            if expected != got
                ok = false
                print("KTH MISMATCH l=" + str(l) + " r=" + str(rr) + " k=" + str(kk) + " exp=" + str(expected) + " got=" + str(got))
            kk = kk + 1
        rr = rr + 1
    l = l + 1
check(ok, "DECISIVE: range k-th matches brute force for ALL (l,r,k)")

// TEST 5: DECISIVE persistence - all historical version sums preserved
// Re-verify versions from TEST 1 still hold
check(ps.ps_query(t, r0, 0, 7) == 0, "final: v0 still empty")
check(ps.ps_query(t, r1, 0, 7) == 5, "final: v1 still 5")
check(ps.ps_query(t, r2, 0, 7) == 8, "final: v2 still 8")
check(ps.ps_query(t, r3, 0, 7) == 18, "final: v3 still 18")

print("forge_persistseg: KAT done")
