// Test all new standard library functions

fn main()
    let pass = 0

    // ── enumerate ──
    let items = ["a", "b", "c"]
    let en = enumerate(items)
    assert(len(en) == 3, "enumerate len")
    let e0 = en[0]
    assert(e0[0] == 0, "enumerate idx 0")
    assert(e0[1] == "a", "enumerate val 0")
    let e2 = en[2]
    assert(e2[0] == 2, "enumerate idx 2")
    assert(e2[1] == "c", "enumerate val 2")
    pass = pass + 1

    // ── zip ──
    let xs = [1, 2, 3]
    let ys = [10, 20, 30, 40]
    let zipped = zip(xs, ys)
    assert(len(zipped) == 3, "zip len")
    let z0 = zipped[0]
    assert(z0[0] == 1, "zip a0")
    assert(z0[1] == 10, "zip b0")
    let z2 = zipped[2]
    assert(z2[0] == 3, "zip a2")
    assert(z2[1] == 30, "zip b2")
    pass = pass + 1

    // ── reduce ──
    let nums = [1, 2, 3, 4, 5]
    let total = reduce(nums, fn(acc, x) acc + x, 0)
    assert(total == 15, "reduce sum")
    let product = reduce(nums, fn(a, x) a * x, 1)
    assert(product == 120, "reduce product")
    pass = pass + 1

    // ── any_match ──
    let has_big = any_match(nums, fn(x) x > 4)
    assert(has_big == 1, "any_match true")
    let has_neg = any_match(nums, fn(x) x < 0)
    assert(has_neg == 0, "any_match false")
    pass = pass + 1

    // ── all_match ──
    let all_pos = all_match(nums, fn(x) x > 0)
    assert(all_pos == 1, "all_match true")
    let all_big = all_match(nums, fn(x) x > 3)
    assert(all_big == 0, "all_match false")
    pass = pass + 1

    // ── sum ──
    let s = sum(nums)
    assert(s == 15, "sum")
    let empty_sum = sum([])
    assert(empty_sum == 0, "sum empty")
    pass = pass + 1

    // ── index_of ──
    let idx = index_of(nums, 3)
    assert(idx == 2, "index_of found")
    let idx2 = index_of(nums, 99)
    assert(idx2 == -1, "index_of not found")
    pass = pass + 1

    // ── sort_by ──
    let words = ["banana", "apple", "cherry"]
    let sorted = sort_by(words, fn(w) len(w))
    assert(sorted[0] == "apple", "sort_by first")
    assert(sorted[2] == "banana", "sort_by last")
    pass = pass + 1

    // ── dict_merge ──
    let d1 = {"a": 1, "b": 2}
    let d2 = {"b": 20, "c": 30}
    let merged = dict_merge(d1, d2)
    assert(merged["a"] == 1, "merge a")
    assert(merged["b"] == 20, "merge b overwritten")
    assert(merged["c"] == 30, "merge c")
    pass = pass + 1

    // ── str_count ──
    let cnt = str_count("hello world hello", "hello")
    assert(cnt == 2, "str_count")
    let cnt2 = str_count("aaa", "aa")
    assert(cnt2 == 1, "str_count overlap")
    pass = pass + 1

    // ── lstrip / rstrip ──
    let ls = lstrip("  hello  ")
    assert(ls == "hello  ", "lstrip")
    let rs = rstrip("  hello  ")
    assert(rs == "  hello", "rstrip")
    pass = pass + 1

    // ── pad_left / pad_right ──
    let pl = pad_left("hi", 5, ord("0"))
    assert(pl == "000hi", "pad_left")
    let pr = pad_right("hi", 5, ord("."))
    assert(pr == "hi...", "pad_right")
    pass = pass + 1

    // ── flatten ──
    let nested = [[1, 2], [3, 4], [5]]
    let flat = flatten(nested)
    assert(len(flat) == 5, "flatten len")
    assert(flat[0] == 1, "flatten 0")
    assert(flat[4] == 5, "flatten 4")
    pass = pass + 1

    // ── hash ──
    let h1 = hash("hello")
    let h2 = hash("hello")
    let h3 = hash("world")
    assert(h1 == h2, "hash deterministic")
    assert(h1 != h3, "hash different")
    pass = pass + 1

    // ── env ──
    let path = env("PATH")
    assert(len(path) > 0, "env PATH")
    pass = pass + 1

    // ── random_int ──
    let r = random_int(1, 100)
    assert(r >= 1, "random_int min")
    assert(r <= 100, "random_int max")
    pass = pass + 1

    // ── cwd ──
    let dir = cwd()
    assert(len(dir) > 0, "cwd nonempty")
    pass = pass + 1

    // ── list_dir ──
    let files = list_dir(cwd())
    assert(len(files) > 0, "list_dir nonempty")
    pass = pass + 1

    // ── json_parse / json_stringify ──
    let q = chr(34)
    let jstr = chr(123) + q + "x" + q + ": 42" + chr(125)
    let json = json_parse(jstr)
    assert(json["x"] == 42, "json_parse")
    pass = pass + 1

    // ── asin/acos/atan ──
    let a = asin(int_to_float(0))
    assert(float_to_int(a) == 0, "asin(0)")
    pass = pass + 1

    // ── int_pow ──
    let ip = int_pow(2, 10)
    assert(ip == 1024, "int_pow 2^10")
    pass = pass + 1

    // ── bytes ──
    let b = bytes_create(4)
    bytes_set(b, 0, 65)
    bytes_set(b, 1, 66)
    bytes_set(b, 2, 67)
    bytes_set(b, 3, 0)
    assert(bytes_get(b, 0) == 65, "bytes_get")
    assert(bytes_len(b) == 4, "bytes_len")
    let bs = bytes_to_str(b)
    assert(bs == "ABC", "bytes_to_str")
    pass = pass + 1

    // ── str_to_bytes ──
    let sb = str_to_bytes("XYZ")
    assert(bytes_len(sb) == 3, "str_to_bytes len")
    assert(bytes_get(sb, 0) == 88, "str_to_bytes X")
    pass = pass + 1

    print("stdlib_test: " + str(pass) + " groups passed")
