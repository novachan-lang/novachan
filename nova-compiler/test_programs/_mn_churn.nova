// N>1 sequential-churn slot-reuse stress + a self-checking PROOF that reclaim bounds the task-slot pool.
// Spawns a green task, WAITS for it (monitor+receive), 20000x -- each finished slot is freelist-pushed and
// reused (generation bumped). At N>1 (reclaim default ON) nova_rt_sched_slot_count() (distinct slots EVER
// allocated) must stay tiny; reclaim OFF would make it ~20000 (one new slot per spawn). Asserts BOTH all
// tasks completed AND the slot pool stayed bounded -- so a regression that re-disables N>1 reclaim FAILS.
extern fn nova_rt_sched_slot_count() -> int
fn _double(n)
    n * 2
fn main()
    let i = 0
    let done = 0
    while i < 20000
        let p = spawn _double(i)
        let m = monitor(p)
        receive(m)
        done = done + 1
        i = i + 1
    let slots = unsafe nova_rt_sched_slot_count()
    if done == 20000 and slots < 100
        print("MN CHURN OK: 20000 sequential spawn-join, task slots bounded to " + str(slots) + " (reclaim recycled)")
    else
        print("MN CHURN FAIL: done=" + str(done) + " slots=" + str(slots) + " (reclaim not bounding the slot pool)")
