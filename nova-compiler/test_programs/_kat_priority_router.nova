import forge_priority_router

fn main()
    let p = pr_new()
    p = pr_add_route(p, "/api/users", "handler_a", 1)
    p = pr_add_route(p, "/api/users", "handler_b", 5)
    p = pr_add_route(p, "/api/health", "health_check", 1)
    assert(pr_route_count(p) == 3, "3 routes")

    let r1 = pr_route(p, "/api/users")
    assert(is_ok(r1), "route ok")
    assert(unwrap(r1) == "handler_b", "highest priority handler")

    let r2 = pr_route(p, "/api/health")
    assert(is_ok(r2), "health ok")
    assert(unwrap(r2) == "health_check", "health handler")

    assert(pr_total_routed(p) == 2, "2 routed")

    let r3 = pr_route(p, "/api/missing")
    assert(is_err(r3), "no route")
    assert(pr_miss_count(p) == 1, "1 miss")

    let h = pr_handler_at(p, 0)
    assert(is_ok(h), "handler ok")
    assert(unwrap(h) == "handler_a", "handler_a")

    let pri = pr_priority_at(p, 1)
    assert(is_ok(pri), "priority ok")
    assert(unwrap(pri) == 5, "priority 5")

    let bad = pr_handler_at(p, 10)
    assert(is_err(bad), "out of range")

    print("PRIORITY-ROUTER KAT PASS")
