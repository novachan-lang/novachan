// showcase_metrics — SHOWCASE + gated integration test.
// The capstone dogfood: the FORGE web framework + this session's std/ modules, together, end-to-end.
// A small metrics API dispatched IN-PROCESS via forge.dispatch_req (self-verifying, no socket):
//   GET /health     -> {status, service, ts}  (ts from std/time/datetime)
//   GET /api/stats  -> descriptive stats over a dataset via std/math/stats
// Proves NOVA's identity claim: one dev, one language, stdlib + framework compose into a real service.
import forge
import std/math/stats
import std/time/datetime

// GET /health — liveness + a std/time/datetime-formatted timestamp
fn health(req: Request) -> Response
    let body = {}
    body["status"] = "ok"
    body["service"] = "metrics"
    body["ts"] = dt_format_iso(1700000000)
    return forge.resp_json(200, body)

// GET /api/stats — descriptive statistics computed by std/math/stats, returned as JSON
fn stats_report(req: Request) -> Response
    let xs = [2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0]
    let body = {}
    body["n"] = len(xs)
    body["mean"] = stats_mean(xs)
    body["median"] = stats_median(xs)
    body["stddev"] = stats_stddev(xs)
    body["min"] = stats_min(xs)
    body["max"] = stats_max(xs)
    return forge.resp_json(200, body)

fn build_app()
    let a = forge.app()
    forge.get(a, "/health", fn(req) health(req))
    forge.get(a, "/api/stats", fn(req) stats_report(req))
    return a

// in-process request: build a raw HTTP request line and dispatch it through the app
fn _req(a, line: string) -> Response
    return forge.dispatch_req(a, forge.build_request(line + "\r\n\r\n", 0))

fn ckf(label: string, got: float, want: float)
    let d = got - want
    if d < 0.0
        d = 0.0 - d
    if d > 0.001
        print("FAIL " + label + ": " + str(got) + " != " + str(want))
        exit(1)

fn main()
    // (1) std/math/stats correctness for the values the endpoint will serve (population variance)
    let xs = [2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0]
    ckf("mean", stats_mean(xs), 5.0)
    ckf("median", stats_median(xs), 4.5)
    ckf("stddev", stats_stddev(xs), 2.0)

    let a = build_app()

    // (2) forge routing + std integration end-to-end
    let h: Response = _req(a, "GET /health HTTP/1.1")
    if h.status != 200
        print("FAIL health status " + str(h.status))
        exit(1)
    if find(h.body, "2023") < 0
        print("FAIL health timestamp missing/wrong: " + h.body)
        exit(1)
    if find(h.body, "ok") < 0
        print("FAIL health status field: " + h.body)
        exit(1)

    let s: Response = _req(a, "GET /api/stats HTTP/1.1")
    if s.status != 200
        print("FAIL stats status " + str(s.status))
        exit(1)
    if find(s.body, "mean") < 0
        print("FAIL stats body missing mean: " + s.body)
        exit(1)
    if find(s.body, "median") < 0
        print("FAIL stats body missing median: " + s.body)
        exit(1)

    // (3) unknown route -> 404 (framework routing behaves)
    let nf: Response = _req(a, "GET /nope HTTP/1.1")
    if nf.status != 404
        print("FAIL unknown route got " + str(nf.status))
        exit(1)

    print("GET /health    -> " + str(h.status) + " " + h.body)
    print("GET /api/stats -> " + str(s.status) + " " + s.body)
    print("GET /nope      -> " + str(nf.status))
    print("showcase_metrics_test passed")
