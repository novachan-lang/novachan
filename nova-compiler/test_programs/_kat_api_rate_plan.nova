import forge_api_rate_plan

fn main()
    let r = rp_new()
    r = rp_add_plan(r, "free", 100, 3600)
    r = rp_add_plan(r, "pro", 10000, 3600)
    assert(rp_plan_count(r) == 2, "2 plans")

    let a1 = rp_assign(r, "alice", "pro")
    assert(is_ok(a1), "assign alice ok")
    r = unwrap(a1)
    let a2 = rp_assign(r, "bob", "free")
    assert(is_ok(a2), "assign bob ok")
    r = unwrap(a2)

    let c1 = rp_check(r, "alice", 50)
    assert(is_ok(c1), "alice check ok")
    assert(unwrap(c1) == 9950, "9950 remaining")

    let c2 = rp_check(r, "bob", 100)
    assert(is_err(c2), "bob limit exceeded")

    let c3 = rp_check(r, "bob", 80)
    assert(is_ok(c3), "bob ok at 80")
    assert(unwrap(c3) == 20, "20 remaining for bob")

    let up = rp_user_plan(r, "alice")
    assert(is_ok(up), "user plan ok")
    assert(unwrap(up) == "pro", "alice is pro")

    let pl = rp_plan_limit(r, "free")
    assert(is_ok(pl), "plan limit ok")
    assert(unwrap(pl) == 100, "free=100")

    let bad = rp_assign(r, "eve", "enterprise")
    assert(is_err(bad), "plan not found")

    print("API-RATE-PLAN KAT PASS")
