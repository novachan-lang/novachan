fn main()
    let xs = [3, 1, 4, 1, 5]
    print("min literal: " + str(min([3, 1, 4])))
    print("max literal: " + str(max([3, 1, 4])))
    print("min comp:    " + str(min([x for x in xs])))
    print("max comp:    " + str(max([x for x in xs])))
    let fs = [1.5, 2.5]
    print("min float:   " + str(min([f for f in fs])))
