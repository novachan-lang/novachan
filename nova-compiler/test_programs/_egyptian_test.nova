import std/math/egyptian

// cki — check integer equality; prints FAIL and exits on mismatch.
fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// --- KAT 1: eg_decompose(2,3) == [2, 6] ---
// 1/2 + 1/6 = 3/6 + 1/6 = 4/6 = 2/3  ✓
let r1 = eg_decompose(2, 3)
cki("kat1_len",  len(r1), 2)
cki("kat1_d0",  r1[0], 2)
cki("kat1_d1",  r1[1], 6)

// --- KAT 2: eg_decompose(3,4) == [2, 4] ---
// 1/2 + 1/4 = 2/4 + 1/4 = 3/4  ✓
let r2 = eg_decompose(3, 4)
cki("kat2_len",  len(r2), 2)
cki("kat2_d0",  r2[0], 2)
cki("kat2_d1",  r2[1], 4)

// --- KAT 3: eg_decompose(5,6) == [2, 3] ---
// 1/2 + 1/3 = 3/6 + 2/6 = 5/6  ✓
let r3 = eg_decompose(5, 6)
cki("kat3_len",  len(r3), 2)
cki("kat3_d0",  r3[0], 2)
cki("kat3_d1",  r3[1], 3)

// --- KAT 4: eg_decompose(1,2) == [2] ---
// 1/2 exactly  ✓
let r4 = eg_decompose(1, 2)
cki("kat4_len",  len(r4), 1)
cki("kat4_d0",  r4[0], 2)

// --- KAT 5: eg_decompose(4,5) == [2, 4, 20] ---
// 1/2 + 1/4 + 1/20 = 10/20 + 5/20 + 1/20 = 16/20 = 4/5  ✓
let r5 = eg_decompose(4, 5)
cki("kat5_len",  len(r5), 3)
cki("kat5_d0",  r5[0], 2)
cki("kat5_d1",  r5[1], 4)
cki("kat5_d2",  r5[2], 20)

// --- KAT 6: eg_is_unit(1,5) == 1 (true) ---
// 1/5 has numerator 1 after reduction  ✓
let r6 = eg_is_unit(1, 5)
cki("kat6", r6, 1)

// --- KAT 7: eg_is_unit(2,6) == 1 (true) ---
// 2/6 reduces to 1/3, numerator = 1  ✓
let r7 = eg_is_unit(2, 6)
cki("kat7", r7, 1)

// --- KAT 8: eg_is_unit(2,5) == 0 (false) ---
// 2/5 is already reduced, numerator = 2 != 1  ✓
let r8 = eg_is_unit(2, 5)
cki("kat8", r8, 0)

// --- KAT 9: eg_reduce(6,9) == [2,3] ---
// gcd(6,9)=3; 6/3=2, 9/3=3  ✓
let r9 = eg_reduce(6, 9)
cki("kat9_n", r9[0], 2)
cki("kat9_d", r9[1], 3)

// --- KAT 10: eg_decompose(3,7) terminates and has correct length ---
// Greedy: k=ceil(7/3)=3, rem=(9-7)/21=2/21; k=ceil(21/2)=11, rem=(22-21)/231=1/231.
// So [3, 11, 231] — three terms.
let r10 = eg_decompose(3, 7)
cki("kat10_len", len(r10), 3)
cki("kat10_d0",  r10[0], 3)
cki("kat10_d1",  r10[1], 11)
cki("kat10_d2",  r10[2], 231)

// --- KAT 11: eg_is_unit(3,9) == 1 (true): 3/9 = 1/3 ---
let r11 = eg_is_unit(3, 9)
cki("kat11", r11, 1)

// --- KAT 12: eg_decompose(2,7) correct ---
// k=ceil(7/2)=4, rem=(8-7)/28=1/28. [4,28].
let r12 = eg_decompose(2, 7)
cki("kat12_len", len(r12), 2)
cki("kat12_d0",  r12[0], 4)
cki("kat12_d1",  r12[1], 28)

print("_egyptian_test passed")
