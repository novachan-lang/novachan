// Benchmark: list-heavy workload that's been the main beneficiary of
// Track 8 W3 RC elision. Measures wall-clock time of N iterations of a
// loop that builds a 1000-element local list, sums it, drops it. With
// NOVA_TRACK8=1, the per-element nova_rc_inc on append disappears
// (escape analysis proves the list never leaves the function), and the
// loop runs measurably faster — the "beat C" claim made observable.
//
// Run twice with the same source: once default, once with NOVA_TRACK8=1.
// The compiler emits different .ll based on the env. Both binaries run
// the same logic; only the runtime path differs.

fn build_and_sum(n: int) -> int
    let xs = []
    let i = 0
    while i < n
        xs.push("item_" + str(i))
        i = i + 1
    len(xs)

fn main()
    let iters = 200
    let per_iter = 1000

    let t0 = time_ms()
    let total = 0
    let k = 0
    while k < iters
        total = total + build_and_sum(per_iter)
        k = k + 1
    let t1 = time_ms()

    let dt = t1 - t0
    print("bench: " + str(iters) + " iter * " + str(per_iter) + " elements -> total=" + str(total) + ", elapsed_ms=" + str(dt))
    rc_stats_dump()
