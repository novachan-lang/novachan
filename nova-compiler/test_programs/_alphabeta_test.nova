import std/gametheory/alphabeta

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _alphabeta_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL _alphabeta_test " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn main()
    // leaf node
    cki("leaf 5", ab_value(5), 5)
    cki("leaf 0", ab_value(0), 0)
    cki("leaf -3", ab_value(-3), -3)

    // KAT 1: [[3,5],[2,9],[0,1]] -> mins 3,2,0 -> max 3
    let t1 = []
    let c1a = []
    push(c1a, 3)
    push(c1a, 5)
    let c1b = []
    push(c1b, 2)
    push(c1b, 9)
    let c1c = []
    push(c1c, 0)
    push(c1c, 1)
    push(t1, c1a)
    push(t1, c1b)
    push(t1, c1c)
    cki("[[3,5],[2,9],[0,1]]", ab_value(t1), 3)

    // KAT 2: [[3,12,8],[2,4,6],[14,5,2]] -> mins 3,2,2 -> max 3
    let t2 = []
    let c2a = []
    push(c2a, 3)
    push(c2a, 12)
    push(c2a, 8)
    let c2b = []
    push(c2b, 2)
    push(c2b, 4)
    push(c2b, 6)
    let c2c = []
    push(c2c, 14)
    push(c2c, 5)
    push(c2c, 2)
    push(t2, c2a)
    push(t2, c2b)
    push(t2, c2c)
    cki("[[3,12,8],[2,4,6],[14,5,2]]", ab_value(t2), 3)

    // KAT 3: [[5,6],[7,4],[5,3]] -> mins 5,4,3 -> max 5
    let t3 = []
    let c3a = []
    push(c3a, 5)
    push(c3a, 6)
    let c3b = []
    push(c3b, 7)
    push(c3b, 4)
    let c3c = []
    push(c3c, 5)
    push(c3c, 3)
    push(t3, c3a)
    push(t3, c3b)
    push(t3, c3c)
    cki("[[5,6],[7,4],[5,3]]", ab_value(t3), 5)

    // Same as negamax KAT: [[1,2],[3,4]] -> mins 1,3 -> max 3
    let t4 = []
    let c4a = []
    push(c4a, 1)
    push(c4a, 2)
    let c4b = []
    push(c4b, 3)
    push(c4b, 4)
    push(t4, c4a)
    push(t4, c4b)
    cki("[[1,2],[3,4]]", ab_value(t4), 3)

    // pruning does not change result: high-value branch after cut
    let t5 = []
    let c5a = []
    push(c5a, 10)
    push(c5a, 2)
    let c5b = []
    push(c5b, 3)
    push(c5b, 15)
    let c5c = []
    push(c5c, 1)
    push(c5c, 7)
    push(t5, c5a)
    push(t5, c5b)
    push(t5, c5c)
    // mins: 2, 3, 1 -> max 3
    cki("prune test [[10,2],[3,15],[1,7]]", ab_value(t5), 3)

    print("PASS _alphabeta_test")
