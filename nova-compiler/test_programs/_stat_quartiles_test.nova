import std/statistics/stat_quartiles

fn ckf(label: string, got: float, want: float)
    let d = got - want
    if d < 0.0
        d = 0.0 - d
    if d > 0.001
        print("FAIL " + label + " got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // n=8 even: [1,2,3,4,5,6,7,8]
    // median = (4+5)/2 = 4.5
    // lower half [1,2,3,4] -> Q1 = (2+3)/2 = 2.5
    // upper half [5,6,7,8] -> Q3 = (6+7)/2 = 6.5
    // IQR = 6.5 - 2.5 = 4.0
    let xs8 = [1, 2, 3, 4, 5, 6, 7, 8]
    ckf("median_even8", sq_median(xs8), 4.5)
    ckf("q1_even8", sq_q1(xs8), 2.5)
    ckf("q3_even8", sq_q3(xs8), 6.5)
    ckf("iqr_even8", sq_iqr(xs8), 4.0)

    // n=5 odd: [1,2,3,4,5]
    // median = 3 (index 2)
    // lower half (exclusive) = [1,2] -> Q1 = (1+2)/2 = 1.5
    // upper half (exclusive) = [4,5] -> Q3 = (4+5)/2 = 4.5
    let xs5 = [1, 2, 3, 4, 5]
    ckf("median_odd5", sq_median(xs5), 3.0)
    ckf("q1_odd5", sq_q1(xs5), 1.5)
    ckf("q3_odd5", sq_q3(xs5), 4.5)
    ckf("iqr_odd5", sq_iqr(xs5), 3.0)

    // n=4 even: [2,4,6,8]
    // median = (4+6)/2 = 5.0
    // lower half [2,4] -> Q1 = 3.0
    // upper half [6,8] -> Q3 = 7.0
    let xs4 = [2, 4, 6, 8]
    ckf("median_4", sq_median(xs4), 5.0)
    ckf("q1_4", sq_q1(xs4), 3.0)
    ckf("q3_4", sq_q3(xs4), 7.0)
    ckf("iqr_4", sq_iqr(xs4), 4.0)

    // n=1 edge
    let xs1 = [42]
    ckf("median_1", sq_median(xs1), 42.0)
    ckf("q1_1", sq_q1(xs1), 42.0)
    ckf("q3_1", sq_q3(xs1), 42.0)
    ckf("iqr_1", sq_iqr(xs1), 0.0)

    // empty edge
    let empty = []
    ckf("median_empty", sq_median(empty), 0.0)
    ckf("q1_empty", sq_q1(empty), 0.0)
    ckf("q3_empty", sq_q3(empty), 0.0)
    ckf("iqr_empty", sq_iqr(empty), 0.0)

    // five_number summary on [1,2,3,4,5,6,7,8]: [1.0, 2.5, 4.5, 6.5, 8.0]
    let fn5 = sq_five_number(xs8)
    ckf("fn_min", fn5[0] * 1.0, 1.0)
    ckf("fn_q1", fn5[1] * 1.0, 2.5)
    ckf("fn_med", fn5[2] * 1.0, 4.5)
    ckf("fn_q3", fn5[3] * 1.0, 6.5)
    ckf("fn_max", fn5[4] * 1.0, 8.0)

    // float input
    let xsf = [1.5, 2.5, 3.5, 4.5]
    ckf("median_float", sq_median(xsf), 3.0)
    ckf("q1_float", sq_q1(xsf), 2.0)
    ckf("q3_float", sq_q3(xsf), 4.0)

    print("PASS _stat_quartiles_test")
