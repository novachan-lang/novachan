// dict_to_query_string
let qs_d = {"a": 1, "b": 2}
let qs1 = dict_to_query_string(qs_d)
if qs1 == "a=1&b=2"
    pass = pass + 1
else
    print("FAIL dict_to_query_string: expected 'a=1&b=2' got '" + qs1 + "'")
    fail = fail + 1

let qs_empty_d = {}
