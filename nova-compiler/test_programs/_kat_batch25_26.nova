// KAT for batch 25 + 26 builtins (16 functions)
let pass = 0
let fail = 0

// ---- batch 25 ----

// list_zip_with_default
let zwd1 = list_zip_with_default([1, 2, 3], [10, 20], 0, -1)
if str(zwd1) == "[[1, 10], [2, 20], [3, -1]]"
    pass = pass + 1
else
    print("FAIL list_zip_with_default: got " + str(zwd1))
    fail = fail + 1

let zwd2 = list_zip_with_default([], [], 0, 0)
if len(zwd2) == 0
    pass = pass + 1
else
    print("FAIL list_zip_with_default empty: got " + str(zwd2))
    fail = fail + 1

// dict_entries_sorted
let des_d = {"banana": 3, "apple": 1, "fig": 2}
let des = dict_entries_sorted(des_d)
if str(des) == str([["apple", 1], ["banana", 3], ["fig", 2]])
    pass = pass + 1
else
    print("FAIL dict_entries_sorted: got " + str(des))
    fail = fail + 1

let des_empty_d = {}
let des2 = dict_entries_sorted(des_empty_d)
if len(des2) == 0
    pass = pass + 1
else
    print("FAIL dict_entries_sorted empty: got " + str(des2))
    fail = fail + 1

// str_center_pad_with
let cp1 = str_center_pad_with("hi", 6, "*")
if cp1 == "**hi**"
    pass = pass + 1
else
    print("FAIL str_center_pad_with: expected '**hi**' got '" + cp1 + "'")
    fail = fail + 1

let cp2 = str_center_pad_with("hi", 6, "ab")
if cp2 == "aahiaa"
    pass = pass + 1
else
    print("FAIL str_center_pad_with multi-char pad (only first char used): expected 'aahiaa' got '" + cp2 + "'")
    fail = fail + 1

let cp3 = str_center_pad_with("hello", 3, "*")
if cp3 == "hello"
    pass = pass + 1
else
    print("FAIL str_center_pad_with width<=len: expected 'hello' got '" + cp3 + "'")
    fail = fail + 1

let cp4 = str_center_pad_with("hi", 6, "")
if cp4 == "hi"
    pass = pass + 1
else
    print("FAIL str_center_pad_with empty pad: expected 'hi' got '" + cp4 + "'")
    fail = fail + 1

// list_max_by_abs
if list_max_by_abs([3, -7, 7]) == 1
    pass = pass + 1
else
    print("FAIL list_max_by_abs: expected 1 got " + str(list_max_by_abs([3, -7, 7])))
    fail = fail + 1

if list_max_by_abs([]) == -1
    pass = pass + 1
else
    print("FAIL list_max_by_abs empty: expected -1 got " + str(list_max_by_abs([])))
    fail = fail + 1

// str_is_alpha_only
if str_is_alpha_only("Hello") == true
    pass = pass + 1
else
    print("FAIL str_is_alpha_only Hello")
    fail = fail + 1

if str_is_alpha_only("Hello123") == false
    pass = pass + 1
else
    print("FAIL str_is_alpha_only Hello123")
    fail = fail + 1

if str_is_alpha_only("") == false
    pass = pass + 1
else
    print("FAIL str_is_alpha_only empty")
    fail = fail + 1

// dict_values_avg
let dva_d = {"a": 10, "b": 20, "c": 30}
if dict_values_avg(dva_d) == 20
    pass = pass + 1
else
    print("FAIL dict_values_avg: expected 20 got " + str(dict_values_avg(dva_d)))
    fail = fail + 1

let dva_empty_d = {}
if dict_values_avg(dva_empty_d) == 0
    pass = pass + 1
else
    print("FAIL dict_values_avg empty: expected 0 got " + str(dict_values_avg(dva_empty_d)))
    fail = fail + 1

let dva_int_d = {"a": 1, "b": 2}
if dict_values_avg(dva_int_d) == 1
    pass = pass + 1
else
    print("FAIL dict_values_avg integer-division: expected 1 got " + str(dict_values_avg(dva_int_d)))
    fail = fail + 1

// list_to_string_join
let ltsj1 = list_to_string_join([1, 2, 3], "-")
if ltsj1 == "1-2-3"
    pass = pass + 1
else
    print("FAIL list_to_string_join: expected '1-2-3' got '" + ltsj1 + "'")
    fail = fail + 1

let ltsj2 = list_to_string_join([], ",")
if ltsj2 == ""
    pass = pass + 1
else
    print("FAIL list_to_string_join empty: expected '' got '" + ltsj2 + "'")
    fail = fail + 1

let ltsj3 = list_to_string_join([42], ",")
if ltsj3 == "42"
    pass = pass + 1
else
    print("FAIL list_to_string_join single: expected '42' got '" + ltsj3 + "'")
    fail = fail + 1

// list_max_n
let mxn1 = list_max_n([5, 3, 9, 1, 7], 3)
if str(mxn1) == "[5, 7, 9]"
    pass = pass + 1
else
    print("FAIL list_max_n: expected [5, 7, 9] got " + str(mxn1))
    fail = fail + 1

