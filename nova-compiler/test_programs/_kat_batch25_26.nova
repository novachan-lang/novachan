if str(mxn2) == "[2, 4]"
    pass = pass + 1
else
    print("FAIL list_max_n n>size: expected [2, 4] got " + str(mxn2))
    fail = fail + 1

let mxn3 = list_max_n([], 3)
if len(mxn3) == 0
    pass = pass + 1
else
    print("FAIL list_max_n empty: got " + str(mxn3))
    fail = fail + 1

