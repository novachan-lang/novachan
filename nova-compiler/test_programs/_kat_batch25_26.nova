    fail = fail + 1

let qs_single_d = {"x": 99}
let qs3 = dict_to_query_string(qs_single_d)
if qs3 == "x=99"
    pass = pass + 1
else
    print("FAIL dict_to_query_string single: expected 'x=99' got '" + qs3 + "'")
    fail = fail + 1

print("Batch 25+26 KAT: " + str(pass) + " passed, " + str(fail) + " failed")
