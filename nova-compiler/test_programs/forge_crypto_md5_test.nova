// Forge crypto: MD5, gated against RFC 1321 KATs. Legacy (Postgres MD5 auth), never for security.
import forge_crypto

fn main()
    if md5_hex("") != "d41d8cd98f00b204e9800998ecf8427e"
        print("FAIL: md5('') -> " + md5_hex(""))
        exit(1)
    if md5_hex("abc") != "900150983cd24fb0d6963f7d28e17f72"
        print("FAIL: md5('abc') -> " + md5_hex("abc"))
        exit(1)
    if md5_hex("message digest") != "f96b697d7cb7938d525a2f31aaf161d0"
        print("FAIL: md5('message digest') -> " + md5_hex("message digest"))
        exit(1)
    print("PASS forge_crypto_md5 (RFC 1321 KATs: empty / abc / message digest)")
