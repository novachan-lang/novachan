import forge_pub_sub

fn main()
    let p = ps_new()
    p = ps_subscribe(p, "news", "alice")
    p = ps_subscribe(p, "news", "bob")
    p = ps_subscribe(p, "sports", "alice")
    assert(ps_total_subscriptions(p) == 3, "3 subs")
    assert(ps_subscriber_count(p, "news") == 2, "2 news subs")
    assert(ps_subscriber_count(p, "sports") == 1, "1 sports sub")

    assert(ps_is_subscribed(p, "news", "alice") == 1, "alice on news")
    assert(ps_is_subscribed(p, "news", "charlie") == 0, "charlie not on news")

    p = ps_publish(p, "news", "headline1")
    assert(ps_total_messages(p) == 1, "1 msg")
    assert(ps_total_delivered(p) == 2, "2 delivered")

    p = ps_publish(p, "sports", "score1")
    assert(ps_total_delivered(p) == 3, "3 total delivered")

    let r = ps_unsubscribe(p, "news", "alice")
    assert(is_ok(r), "unsub ok")
    p = unwrap(r)
    assert(ps_subscriber_count(p, "news") == 1, "1 news sub now")

    let bad = ps_unsubscribe(p, "news", "charlie")
    assert(is_err(bad), "not subscribed err")

    print("PUB-SUB KAT PASS")
