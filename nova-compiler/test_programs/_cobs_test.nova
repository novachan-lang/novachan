// KAT for std/framing/cobs — Consistent Overhead Byte Stuffing.
// Canonical vectors from the COBS paper + round-trip tests.
import std/framing/cobs

// ── Helpers ───────────────────────────────────────────────────────────────────

// Compare two lists of ints for equality; print FAIL and exit(1) on mismatch.
fn list_eq(a, b) -> int
    let la = len(a)
    let lb = len(b)
    if la != lb
        return 0
    let i = 0
    while i < la
        if a[i] != b[i]
            return 0
        i = i + 1
    1

fn ck_list(label, got, want)
    if list_eq(got, want) == 0
        let gs = "["
        let i = 0
        while i < len(got)
            gs = gs + str(got[i])
            if i + 1 < len(got)
                gs = gs + ","
            i = i + 1
        gs = gs + "]"
        let ws = "["
        let j = 0
        while j < len(want)
            ws = ws + str(want[j])
            if j + 1 < len(want)
                ws = ws + ","
            j = j + 1
        ws = ws + "]"
        print("FAIL cobs " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn ck_int(label, got, want)
    if got != want
        print("FAIL cobs " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck_bool(label, got, want)
    if got != want
        print("FAIL cobs " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ── KAT 1: cobs_encode([]) == [0x01] ─────────────────────────────────────────
fn kat1()
    let enc = cobs_encode([])
    let want = [1]
    ck_list("encode-empty", enc, want)
    print("KAT 1 PASS: cobs_encode([]) == [0x01]")

// ── KAT 2: cobs_encode([0x00]) == [0x01,0x01] ────────────────────────────────
fn kat2()
    let data = [0]
    let enc = cobs_encode(data)
    let want = [1, 1]
    ck_list("encode-one-zero", enc, want)
    print("KAT 2 PASS: cobs_encode([0x00]) == [0x01,0x01]")

// ── KAT 3: cobs_encode([0x00,0x00]) == [0x01,0x01,0x01] ─────────────────────
fn kat3()
    let data = [0, 0]
    let enc = cobs_encode(data)
    let want = [1, 1, 1]
    ck_list("encode-two-zeros", enc, want)
    print("KAT 3 PASS: cobs_encode([0x00,0x00]) == [0x01,0x01,0x01]")

// ── KAT 4: cobs_encode([0x11,0x22,0x00,0x33]) == [0x03,0x11,0x22,0x02,0x33] ─
fn kat4()
    let data = [0x11, 0x22, 0, 0x33]
    let enc = cobs_encode(data)
    let want = [3, 0x11, 0x22, 2, 0x33]
    ck_list("encode-mixed", enc, want)
    print("KAT 4 PASS: cobs_encode([0x11,0x22,0x00,0x33]) == [0x03,0x11,0x22,0x02,0x33]")

// ── KAT 5: cobs_encode([0x11,0x22,0x33,0x44]) == [0x05,0x11,0x22,0x33,0x44] ─
fn kat5()
    let data = [0x11, 0x22, 0x33, 0x44]
    let enc = cobs_encode(data)
    let want = [5, 0x11, 0x22, 0x33, 0x44]
    ck_list("encode-no-zeros", enc, want)
    print("KAT 5 PASS: cobs_encode([0x11,0x22,0x33,0x44]) == [0x05,0x11,0x22,0x33,0x44]")

// ── KAT 6: cobs_encode([0x11,0x00,0x00,0x00]) == [0x02,0x11,0x01,0x01,0x01] ─
fn kat6()
    let data = [0x11, 0, 0, 0]
    let enc = cobs_encode(data)
    let want = [2, 0x11, 1, 1, 1]
    ck_list("encode-zeros-after-byte", enc, want)
    print("KAT 6 PASS: cobs_encode([0x11,0x00,0x00,0x00]) == [0x02,0x11,0x01,0x01,0x01]")

// ── KAT 7: round-trip decode(encode(x))==x for all canonical vectors ──────────
fn kat7()
    // [] round-trip
    let rt0 = cobs_decode(cobs_encode([]))
    ck_list("rt-empty", rt0, [])
    // [0x00]
    let d1 = [0]
    let rt1 = cobs_decode(cobs_encode(d1))
    ck_list("rt-one-zero", rt1, d1)
    // [0x00,0x00]
    let d2 = [0, 0]
    let rt2 = cobs_decode(cobs_encode(d2))
    ck_list("rt-two-zeros", rt2, d2)
    // [0x11,0x22,0x00,0x33]
    let d3 = [0x11, 0x22, 0, 0x33]
    let rt3 = cobs_decode(cobs_encode(d3))
    ck_list("rt-mixed", rt3, d3)
    // [0x11,0x22,0x33,0x44]
    let d4 = [0x11, 0x22, 0x33, 0x44]
    let rt4 = cobs_decode(cobs_encode(d4))
    ck_list("rt-no-zeros", rt4, d4)
    // [0x11,0x00,0x00,0x00]
    let d5 = [0x11, 0, 0, 0]
    let rt5 = cobs_decode(cobs_encode(d5))
    ck_list("rt-zeros-after", rt5, d5)
    print("KAT 7 PASS: round-trips for all 6 canonical vectors OK")

// ── KAT 8: round-trip for [1,2,3,0,4,5] ─────────────────────────────────────
fn kat8()
    let data = [1, 2, 3, 0, 4, 5]
    let rt = cobs_decode(cobs_encode(data))
    ck_list("rt-123-045", rt, data)
    print("KAT 8 PASS: round-trip [1,2,3,0,4,5] OK")

// ── KAT 9: round-trip for 300-byte all-zeros payload (tests 254-block) ────────
// 300 zeros forces at least one full 254-byte block (code=0xFF, no implicit 0).
fn kat9()
    let data = []
    let i = 0
    while i < 300
        push(data, 0)
        i = i + 1
    let enc = cobs_encode(data)
    let rt = cobs_decode(enc)
    ck_int("rt-300z-len", len(rt), 300)
    // All should be 0x00.
    let j = 0
    let ok = 1
    while j < 300
        if rt[j] != 0
            ok = 0
        j = j + 1
    ck_int("rt-300z-content", ok, 1)
    // Also verify no 0x00 in the encoded output (COBS invariant).
    ck_bool("rt-300z-valid", cobs_is_valid(enc), 1)
    print("KAT 9 PASS: round-trip 300-byte all-zeros payload (254-block boundary) OK")

// ── KAT 10: cobs_is_valid ─────────────────────────────────────────────────────
fn kat10()
    // cobs_encode always produces valid (no 0x00) output.
    let enc0 = cobs_encode([0])
    ck_bool("is_valid-encoded-zero", cobs_is_valid(enc0), 1)
    // A list containing 0x00 is NOT valid.
    let bad = [1, 0, 2]
    ck_bool("is_valid-with-zero", cobs_is_valid(bad), 0)
    // Empty list is valid (vacuously).
    ck_bool("is_valid-empty", cobs_is_valid([]), 1)
    print("KAT 10 PASS: cobs_is_valid OK")

// ── KAT 11: cobs_max_overhead ────────────────────────────────────────────────
fn kat11()
    // n=0: 1
    ck_int("overhead-0", cobs_max_overhead(0), 1)
    // n=1: ceil(1/254)+1 = 1+1 = 2
    ck_int("overhead-1", cobs_max_overhead(1), 2)
    // n=254: ceil(254/254)+1 = 1+1 = 2
    ck_int("overhead-254", cobs_max_overhead(254), 2)
    // n=255: ceil(255/254)+1 = 2+1 = 3
    ck_int("overhead-255", cobs_max_overhead(255), 3)
    // n=508: ceil(508/254)+1 = 2+1 = 3
    ck_int("overhead-508", cobs_max_overhead(508), 3)
    print("KAT 11 PASS: cobs_max_overhead OK")

// ── KAT 12: round-trip with max-byte-values (0xFF, 0xFE etc.) ────────────────
fn kat12()
    let data = [0xFF, 0xFE, 0x01, 0x00, 0xFF]
    let rt = cobs_decode(cobs_encode(data))
    ck_list("rt-high-bytes", rt, data)
    print("KAT 12 PASS: round-trip with high-value bytes OK")

fn main()
    kat1()
    kat2()
    kat3()
    kat4()
    kat5()
    kat6()
    kat7()
    kat8()
    kat9()
    kat10()
    kat11()
    kat12()
    print("PASS _cobs_test")
