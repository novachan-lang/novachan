// _stoichiometry_test.nova — KAT for std/chem/stoichiometry
//
// Known answers:
//   moles_from_mass(18.0, 18.0)    = 1.0
//   mass_from_moles(2.0, 18.0)     = 36.0
//   mole_ratio(2.0, 1.0)           = 2.0
//   particles_from_moles(1.0)      ~ 6.022e23  (relative tolerance 1e-6)
//   limiting_reactant(4.0,2.0,3.0,1.0) = "B"  (2.0 equiv A vs 3.0 equiv B -> A limits)
//   limiting_reactant(1.0,2.0,3.0,1.0) = "A"  (0.5 equiv A vs 3.0 equiv B -> A limits)

import std/chem/stoichiometry

// Absolute tolerance float check.
fn approx(a: float, b: float, tol: float) -> int
    let d = a - b
    let ad = d
    if d < 0.0
        ad = 0.0 - d
    if ad < tol
        return 1
    return 0

// Relative tolerance float check (for large magnitudes like Avogadro).
fn approx_rel(a: float, b: float, rel_tol: float) -> int
    let d = a - b
    let ad = d
    if d < 0.0
        ad = 0.0 - d
    // rel error = |a-b| / |b|
    let babs = b
    if b < 0.0
        babs = 0.0 - b
    let rel = ad / babs
    if rel < rel_tol
        return 1
    return 0

fn main()
    // KAT 1: moles_from_mass(18.0, 18.0) == 1.0
    let n1 = moles_from_mass(18.0, 18.0)
    if approx(n1, 1.0, 0.0001) != 1
        print("FAIL stoichiometry moles_from_mass: got " + str(n1))
        exit(1)

    // KAT 2: mass_from_moles(2.0, 18.0) == 36.0
    let m2 = mass_from_moles(2.0, 18.0)
    if approx(m2, 36.0, 0.0001) != 1
        print("FAIL stoichiometry mass_from_moles: got " + str(m2))
        exit(1)

    // KAT 3: mole_ratio(2.0, 1.0) == 2.0
    let r3 = mole_ratio(2.0, 1.0)
    if approx(r3, 2.0, 0.0001) != 1
        print("FAIL stoichiometry mole_ratio: got " + str(r3))
        exit(1)

    // KAT 4: particles_from_moles(1.0) ~= 6.022e23 (relative tol 1e-4)
    let p4 = particles_from_moles(1.0)
    let avog_ref = 6.022 * pow(10.0, 23.0)
    if approx_rel(p4, avog_ref, 0.001) != 1
        print("FAIL stoichiometry particles_from_moles: got " + str(p4))
        exit(1)

    // KAT 5: limiting_reactant — B has more equivalents so A limits
    // equivA = 4.0/2.0 = 2.0, equivB = 3.0/1.0 = 3.0 -> A limits
    let lr5 = limiting_reactant(4.0, 2.0, 3.0, 1.0)
    if lr5 != "A"
        print("FAIL stoichiometry limiting_reactant case1: got " + lr5)
        exit(1)

    // KAT 6: limiting_reactant — A has fewer equivalents
    // equivA = 1.0/2.0 = 0.5, equivB = 3.0/1.0 = 3.0 -> A limits
    let lr6 = limiting_reactant(1.0, 2.0, 3.0, 1.0)
    if lr6 != "A"
        print("FAIL stoichiometry limiting_reactant case2: got " + lr6)
        exit(1)

    // KAT 7: limiting_reactant — B limits
    // equivA = 6.0/1.0 = 6.0, equivB = 2.0/2.0 = 1.0 -> B limits
    let lr7 = limiting_reactant(6.0, 1.0, 2.0, 2.0)
    if lr7 != "B"
        print("FAIL stoichiometry limiting_reactant case3: got " + lr7)
        exit(1)

    // KAT 8: moles_from_particles inverse round-trip
    let na = avogadro()
    let rt = moles_from_particles(na)
    if approx(rt, 1.0, 0.000001) != 1
        print("FAIL stoichiometry moles_from_particles round-trip: got " + str(rt))
        exit(1)

    print("PASS _stoichiometry_test")
