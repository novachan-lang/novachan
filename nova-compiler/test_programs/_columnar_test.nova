// KAT for std/cipher/columnar
import std/cipher/columnar

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL columnar " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL columnar " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn main()
    // ----------------------------------------------------------------
    // 1. column_order("ZEBRAS")
    // ZEBRAS: Z->rank5, E->rank2, B->rank1, R->rank3, A->rank0, S->rank4
    // Expected: [5, 2, 1, 3, 0, 4]
    let ord_z = column_order("ZEBRAS")
    cki("zebras_col0", ord_z[0], 5)
    cki("zebras_col1", ord_z[1], 2)
    cki("zebras_col2", ord_z[2], 1)
    cki("zebras_col3", ord_z[3], 3)
    cki("zebras_col4", ord_z[4], 0)
    cki("zebras_col5", ord_z[5], 4)

    // ----------------------------------------------------------------
    // 2. column_order("SECRET")
    // S(18),E(4),C(2),R(17),E(4),T(19)
    // Sorted: C(col2)=0, E(col1)=1, E(col4)=2, R(col3)=3, S(col0)=4, T(col5)=5
    // So ranks: col0->4, col1->1, col2->0, col3->3, col4->2, col5->5
    // column_order = [4, 1, 0, 3, 2, 5]
    let ord_s = column_order("SECRET")
    cki("secret_col0", ord_s[0], 4)
    cki("secret_col1", ord_s[1], 1)
    cki("secret_col2", ord_s[2], 0)
    cki("secret_col3", ord_s[3], 3)
    cki("secret_col4", ord_s[4], 2)
    cki("secret_col5", ord_s[5], 5)

    // ----------------------------------------------------------------
    // 3. Round-trip with "SECRET" on a plaintext that fills the grid exactly.
    // "WEAREDISCOVEREDRUNATONCE" = 24 chars (24 / 6 = 4 rows, no padding)
    let pt1 = "WEAREDISCOVEREDRUNATONCE"
    let ct1 = columnar_encrypt(pt1, "SECRET")
    let dt1 = columnar_decrypt(ct1, "SECRET")
    cks("rt_exact", dt1, pt1)

    // ----------------------------------------------------------------
    // 4. Round-trip with padding (plaintext length not divisible by key length)
    // "HELLOWORLD" = 10 chars, key "SECRET" = 6 cols, 2 rows, padded to 12
    // decrypt then strip trailing X's to get original back
    let pt2 = "HELLOWORLD"
    let ct2 = columnar_encrypt(pt2, "SECRET")
    let dt2 = columnar_decrypt(ct2, "SECRET")
    // dt2 has 12 chars (2 rows * 6 cols), original has 10, so 2 trailing X pad
    cks("rt_padlen", slice(dt2, 0, 10), pt2)

    // ----------------------------------------------------------------
    // 5. Round-trip with a longer plaintext (odd padding)
    // "ATTACKATDAWN" = 12 chars, key "KEY" = 3 cols, 4 rows exactly (no padding)
    let pt3 = "ATTACKATDAWN"
    let ct3 = columnar_encrypt(pt3, "KEY")
    let dt3 = columnar_decrypt(ct3, "KEY")
    cks("rt_key3", dt3, pt3)

    // ----------------------------------------------------------------
    // 6. Round-trip: "ZEBRAS" key, 17-char plaintext (extra padding)
    // 17 chars, 6 cols => 3 rows (ceil(17/6)=3), total=18, 1 pad X
    let pt4 = "WEAREDISCOVEREDFR"
    let ct4 = columnar_encrypt(pt4, "ZEBRAS")
    let dt4 = columnar_decrypt(ct4, "ZEBRAS")
    cks("rt_zebras_pad", slice(dt4, 0, 17), pt4)

    // ----------------------------------------------------------------
    // 7. Empty input safety
    let ct5 = columnar_encrypt("", "SECRET")
    cks("empty_enc", ct5, "")
    let dt5 = columnar_decrypt("", "SECRET")
    cks("empty_dec", dt5, "")

    // ----------------------------------------------------------------
    // 8. Single-char input
    let ct6 = columnar_encrypt("A", "KEY")
    // 3 cols, padded to "AXX", KEY order: K->rank1, E->rank0, Y->rank2
    // read order: col1(E)=rank0 -> read col 1 first, col0(K)=rank1, col2(Y)=rank2
    // grid: A X X (row0), read col1=X, col0=A, col2=X => "XAX"
    let dt6 = columnar_decrypt(ct6, "KEY")
    // round-trip: first char should be A
    cks("single_rt", slice(dt6, 0, 1), "A")

    // ----------------------------------------------------------------
    // 9. Normalize: lowercase + non-alpha stripped
    let ct7 = columnar_encrypt("hello world!", "SECRET")
    let ct7b = columnar_encrypt("HELLOWORLD", "SECRET")
    cks("normalize", ct7, ct7b)

    // ----------------------------------------------------------------
    // 10. Known-answer: "WEAREDISCOVEREDRUNATONCE" with "ZEBRAS"
    // This is the classic Wikipedia columnar cipher example.
    // Key ZEBRAS ranks: Z=5,E=2,B=1,R=3,A=0,S=4
    // Grid (4 rows x 6 cols):
    //   col: Z  E  B  R  A  S
    //   row0: W  E  A  R  E  D
    //   row1: I  S  C  O  V  E
    //   row2: R  E  D  R  U  N
    //   row3: A  T  O  N  C  E
    // Read order by rank: A(col4),B(col2),E(col1),R(col3),S(col5),Z(col0)
    // colA=EVUC, colB=ACDO, colE=ESET, colR=RORN, colS=DENE, colZ=WIRA
    // ct = "EVUC" + "ACDO" + "ESET" + "RORN" + "DENE" + "WIRA"
    //    = "EVUCACDOESE TRORN DENEWIRA"  (no spaces)
    //    = "EVUCACDOESETRORNDENEWIRA"
    let pt_wiki = "WEAREDISCOVEREDRUNATONCE"
    let ct_wiki = columnar_encrypt(pt_wiki, "ZEBRAS")
    // Verify decrypt round-trips
    let dt_wiki = columnar_decrypt(ct_wiki, "ZEBRAS")
    cks("wiki_rt", dt_wiki, pt_wiki)
    // Verify known ciphertext (Wikipedia classic example)
    cks("wiki_ct", ct_wiki, "EVUCACDOESETRORNDENEWIRA")

    print("PASS _columnar_test")
