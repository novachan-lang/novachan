// Track 8: Safety features test
// Tests checked arithmetic, weak references, process monitoring, stack guard

fn test_checked_arithmetic()
    // Normal operations (no overflow)
    let a = checked_add(100, 200)
    let b = checked_sub(500, 300)
    let c = checked_mul(10, 20)
    assert_eq(a, 300)
    assert_eq(b, 200)
    assert_eq(c, 200)
    print("Checked arithmetic test passed")

fn test_stack_guard()
    // Set a reasonable stack depth limit
    stack_set_max(10000)
    // Normal function calls should work fine
    let x = compute_depth(100)
    assert_eq(x, 100)
    print("Stack guard test passed")

fn compute_depth(n: int) -> int
    if n <= 0
        return 0
    stack_enter()
    let result = compute_depth(n - 1) + 1
    stack_exit()
    result

fn test_process_monitoring()
    // Create fake PIDs (just i64 handles for now)
    let watcher = 1001
    let target = 1002
    let ref = process_monitor(watcher, target)
    assert_eq(ref > 0, true)
    process_demonitor(ref)
    print("Process monitoring test passed")

fn test_weak_references()
    // Create a value and make a weak reference to it
    let obj = pq_create()  // any heap object
    let w = weak_create(obj)
    let is_alive = weak_alive(w)
    assert_eq(is_alive, true)
    let upgraded = weak_upgrade(w)
    assert_eq(upgraded == obj, true)
    print("Weak reference test passed")

fn main()
    test_checked_arithmetic()
    test_stack_guard()
    test_process_monitoring()
    test_weak_references()
    print("All Track 8 safety tests passed!")
