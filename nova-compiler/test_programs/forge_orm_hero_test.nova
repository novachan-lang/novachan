// functional: the §12 hero DB flow — struct insert with id=0 -> DB auto-assigns PK -> typed get back
import forge_orm

type Todo
    id: int
    title: string
    done: bool

fn main()
    let dbr = orm_open("sqlite://_orm_hero.db")
    if is_err(dbr)
        print("FAIL open")
        exit(1)
    let db = unwrap(dbr)
    _ = orm_drop_table(db, "todos")
    _ = orm_create_table(db, "todos", Todo(0, "", false))
    _ = orm_insert(db, "todos", Todo(0, "learn nova", false))
    _ = orm_insert(db, "todos", Todo(0, "build forge", true))
    if orm_count(db, "todos", "", []) != 2
        print("FAIL count")
        exit(1)
    let t1: Result<Todo> = orm_get(db, "todos", 1)
    if is_err(t1)
        print("FAIL get id=1 (auto-increment did not assign 1)")
        exit(1)
    let todo = unwrap(t1)
    if todo.id != 1
        print("FAIL auto id = " + str(todo.id))
        exit(1)
    if todo.title != "learn nova"
        print("FAIL title = " + todo.title)
        exit(1)
    let t2: Result<Todo> = orm_get(db, "todos", 2)
    if unwrap(t2).title != "build forge"
        print("FAIL t2 title")
        exit(1)
    orm_close(db)
    print("PASS forge_orm_hero (struct insert -> auto id -> typed get)")
