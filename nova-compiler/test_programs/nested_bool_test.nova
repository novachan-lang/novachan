// FINDING #1 nested bool: bools in lists/dicts serialize as true/false (was 1/0)
// and read back correctly.
fn main()
    let lst = []
    lst.push(true)
    lst.push(false)
    assert_eq(json_encode(lst), "[true,false]")
    assert_eq(lst[0], true)
    assert_eq(lst[1], false)

    let d = {}
    d["ok"] = true
    d["done"] = false
    assert_eq(json_encode(d), "\{\"ok\":true,\"done\":false\}")
    assert_eq(d["ok"], true)
    assert_eq(d["done"], false)

    print("nested bool test passed")
