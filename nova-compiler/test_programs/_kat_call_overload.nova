// _kat_call_overload.nova — KAT for L8 call-overload: obj(args) -> Struct__call
// A struct defining a `call` method becomes callable — the NOVA way (zero annotation,
// just define the method and the operator works).

type Doubler
    factor: int

fn Doubler.call(self, x: int) -> int
    self.factor * x

type Greeter
    name: string

fn Greeter.call(self) -> string
    "Hello, " + self.name + "!"

type Adder
    base: int

fn Adder.call(self, x: int, y: int) -> int
    self.base + x + y

type Collection
    items: list

fn Collection.call(self) -> int
    len(self.items)

fn Collection.index(self, i: int) -> int
    self.items[i]

fn main()
    let _c = [0, 0]

    // ── Test 1: single-arg callable struct ──
    let d = Doubler(3)
    if d(7) == 21
        _c[0] = _c[0] + 1
        print("  ok doubler_call")
    else
        _c[1] = _c[1] + 1
        print("  FAIL doubler_call: want 21 got " + str(d(7)))

    if d(0) == 0
        _c[0] = _c[0] + 1
        print("  ok doubler_call_zero")
    else
        _c[1] = _c[1] + 1
        print("  FAIL doubler_call_zero: want 0 got " + str(d(0)))

    // ── Test 2: no-arg callable struct (thunk) ──
    let g = Greeter("NOVA")
    if g() == "Hello, NOVA!"
        _c[0] = _c[0] + 1
        print("  ok greeter_call")
    else
        _c[1] = _c[1] + 1
        print("  FAIL greeter_call: want Hello, NOVA! got " + str(g()))

    // ── Test 3: multi-arg callable struct ──
    let a = Adder(100)
    if a(20, 3) == 123
        _c[0] = _c[0] + 1
        print("  ok adder_call")
    else
        _c[1] = _c[1] + 1
        print("  FAIL adder_call: want 123 got " + str(a(20, 3)))

    // ── Test 4: call on a different instance ──
    let d2 = Doubler(5)
    if d2(10) == 50
        _c[0] = _c[0] + 1
        print("  ok doubler2_call")
    else
        _c[1] = _c[1] + 1
        print("  FAIL doubler2_call: want 50 got " + str(d2(10)))

    // ── Test 5: callable + index on the same struct ──
    let col = Collection([10, 20, 30])
    if col() == 3
        _c[0] = _c[0] + 1
        print("  ok collection_call_len")
    else
        _c[1] = _c[1] + 1
        print("  FAIL collection_call_len: want 3 got " + str(col()))

    if col[0] == 10
        _c[0] = _c[0] + 1
        print("  ok collection_index_0")
    else
        _c[1] = _c[1] + 1
        print("  FAIL collection_index_0: want 10 got " + str(col[0]))

    if col[2] == 30
        _c[0] = _c[0] + 1
        print("  ok collection_index_2")
    else
        _c[1] = _c[1] + 1
        print("  FAIL collection_index_2: want 30 got " + str(col[2]))

    // ── Summary ──
    print("")
    print("call_overload: " + str(_c[0]) + " passed, " + str(_c[1]) + " failed")
    if _c[1] > 0
        exit(1)
