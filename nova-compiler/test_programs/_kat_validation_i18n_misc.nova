// KAT for 6 new pure-NOVA stdlib modules:
//   std/validation/schema (vs_), std/i18n/locale (i18n_), std/retry/backoff (rb_),
//   std/collections/ring_buffer (rb2_), std/text/diff (df_ additions), std/net/rate_limit (rl_)
// All expected values hand-computed. Prints "PASS _kat_validation_i18n_misc"
// iff every check passes; otherwise prints one FAIL line per failing check
// and a final FAILED count.

import std/validation/schema as vs
import std/i18n/locale as il
import std/retry/backoff as rb
import std/collections/ring_buffer as rb2
import std/text/diff as df
import std/net/rate_limit as rl

fn check(name: string, cond: bool) -> int
    if not cond
        print("FAIL: " + name)
        return 1
    return 0

fn check_int(name: string, got: int, want: int) -> int
    if got != want
        print("FAIL: " + name + " got=" + str(got) + " want=" + str(want))
        return 1
    return 0

fn check_str(name: string, got: string, want: string) -> int
    if got != want
        print("FAIL: " + name + " got=[" + got + "] want=[" + want + "]")
        return 1
    return 0

// ---------------------------------------------------------------------------
// std/validation/schema
// ---------------------------------------------------------------------------
fn test_schema() -> int
    let f = 0

    let d1 = {}
    d1["name"] = "Alice"
    d1["email"] = "alice@example.com"
    d1["age"] = 30
    d1["bio"] = ""

    f = f + check("schema.required.present", vs.vs_required(d1, "name"))
    f = f + check("schema.required.missing_field", not vs.vs_required(d1, "phone"))
    f = f + check("schema.required.empty_string", not vs.vs_required(d1, "bio"))

    f = f + check("schema.min_length.ok", vs.vs_min_length("Alice", 3))
    f = f + check("schema.min_length.fail", not vs.vs_min_length("Al", 3))
    f = f + check("schema.max_length.ok", vs.vs_max_length("Alice", 10))
    f = f + check("schema.max_length.fail", not vs.vs_max_length("Alice", 2))

    f = f + check("schema.in_range.ok", vs.vs_in_range(30, 18, 65))
    f = f + check("schema.in_range.low_fail", not vs.vs_in_range(10, 18, 65))
    f = f + check("schema.in_range.high_fail", not vs.vs_in_range(99, 18, 65))
    f = f + check("schema.in_range.boundary", vs.vs_in_range(18, 18, 65))

    f = f + check("schema.pattern.email_ok", vs.vs_matches_pattern("alice@example.com", "email"))
    f = f + check("schema.pattern.email_fail", not vs.vs_matches_pattern("not-an-email", "email"))
    f = f + check("schema.pattern.url_ok", vs.vs_matches_pattern("https://example.com", "url"))
    f = f + check("schema.pattern.url_fail", not vs.vs_matches_pattern("example.com", "url"))
    f = f + check("schema.pattern.unknown", not vs.vs_matches_pattern("anything", "phone"))

    let rules = []
    let r1 = []
    r1.push("name")
    r1.push("required")
    r1.push(0)
    rules.push(r1)
    let r2 = []
    r2.push("email")
    r2.push("pattern")
    r2.push("email")
    rules.push(r2)
    let range_param = []
    range_param.push(18)
    range_param.push(65)
    let r3 = []
    r3.push("age")
    r3.push("in_range")
    r3.push(range_param)
    rules.push(r3)

    let errs = vs.vs_validate(d1, rules)
    f = f + check_int("schema.validate.no_errors", len(errs), 0)
    f = f + check("schema.is_valid.true", vs.vs_is_valid(d1, rules))

    let d2 = {}
    d2["name"] = ""
    d2["email"] = "bad"
    d2["age"] = 5
    let errs2 = vs.vs_validate(d2, rules)
    f = f + check_int("schema.validate.three_errors", len(errs2), 3)
    f = f + check("schema.is_valid.false", not vs.vs_is_valid(d2, rules))

    f

// ---------------------------------------------------------------------------
// std/i18n/locale
// ---------------------------------------------------------------------------
fn test_locale() -> int
    let f = 0

    let en = il.i18n_new("en")
    f = f + check_str("i18n.new.en.decimal", en["decimal_sep"], ".")
    f = f + check_str("i18n.new.en.thousand", en["thousand_sep"], ",")
    f = f + check_str("i18n.new.en.dir", en["dir"], "ltr")

    let de = il.i18n_new("de")
    f = f + check_str("i18n.new.de.decimal", de["decimal_sep"], ",")
    f = f + check_str("i18n.new.de.thousand", de["thousand_sep"], ".")

    let ar = il.i18n_new("ar")
    f = f + check_str("i18n.new.ar.dir", ar["dir"], "rtl")
    f = f + check_str("i18n.direction.en", il.i18n_direction("en"), "ltr")
    f = f + check_str("i18n.direction.he", il.i18n_direction("he"), "rtl")

    f = f + check_str("i18n.format_number.en.small", il.i18n_format_number(en, 42), "42")
    f = f + check_str("i18n.format_number.en.thousands", il.i18n_format_number(en, 1234567), "1,234,567")
    f = f + check_str("i18n.format_number.en.exact_group", il.i18n_format_number(en, 1000), "1,000")
    f = f + check_str("i18n.format_number.en.negative", il.i18n_format_number(en, -1234), "-1,234")
    f = f + check_str("i18n.format_number.de.thousands", il.i18n_format_number(de, 1234567), "1.234.567")

    f = f + check_str("i18n.format_currency.en", il.i18n_format_currency(en, 1234.5, "$"), "$1,234.50")
    f = f + check_str("i18n.format_currency.en.exact", il.i18n_format_currency(en, 9.99, "$"), "$9.99")
    f = f + check_str("i18n.format_currency.de", il.i18n_format_currency(de, 1234.5, "EUR "), "EUR 1.234,50")
    f = f + check_str("i18n.format_currency.negative", il.i18n_format_currency(en, -5.5, "$"), "-$5.50")

    let translations = {}
    let en_table = {}
    en_table["hello"] = "Hello"
    en_table["bye"] = "Goodbye"
    translations["en"] = en_table
    let fr_table = {}
    fr_table["hello"] = "Bonjour"
    translations["fr"] = fr_table

    f = f + check_str("i18n.translate.en.hello", il.i18n_translate(translations, "en", "hello"), "Hello")
    f = f + check_str("i18n.translate.fr.hello", il.i18n_translate(translations, "fr", "hello"), "Bonjour")
    f = f + check_str("i18n.translate.missing_key", il.i18n_translate(translations, "fr", "bye"), "bye")
    f = f + check_str("i18n.translate.missing_lang", il.i18n_translate(translations, "de", "hello"), "hello")

    f = f + check_str("i18n.plural.one", il.i18n_plural(1, "item", "items"), "item")
    f = f + check_str("i18n.plural.many", il.i18n_plural(5, "item", "items"), "items")
    f = f + check_str("i18n.plural.zero", il.i18n_plural(0, "item", "items"), "items")

    f

// ---------------------------------------------------------------------------
// std/retry/backoff
// ---------------------------------------------------------------------------
fn test_backoff() -> int
    let f = 0

    let policy = rb.rb_new(5, 100)
    f = f + check_int("backoff.delay.attempt0", rb.rb_delay(policy, 0), 100)
    f = f + check_int("backoff.delay.attempt1", rb.rb_delay(policy, 1), 200)
    f = f + check_int("backoff.delay.attempt2", rb.rb_delay(policy, 2), 400)
    f = f + check_int("backoff.delay.attempt3", rb.rb_delay(policy, 3), 800)

    let big_policy = rb.rb_new(20, 1000)
    f = f + check_int("backoff.delay.cap", rb.rb_delay(big_policy, 10), 30000)
    f = f + check_int("backoff.delay.huge_attempt_no_overflow", rb.rb_delay(big_policy, 1000000), 30000)

    f = f + check("backoff.should_retry.true", rb.rb_should_retry(policy, 0))
    f = f + check("backoff.should_retry.true.4", rb.rb_should_retry(policy, 4))
    f = f + check("backoff.should_retry.false", not rb.rb_should_retry(policy, 5))

    let jittered = rb.rb_with_jitter(1000, 10)
    f = f + check("backoff.jitter.lower_bound", jittered >= 1000)
    f = f + check("backoff.jitter.upper_bound", jittered <= 1100)
    f = f + check_int("backoff.jitter.zero_pct", rb.rb_with_jitter(1000, 0), 1000)

    let tracker = rb.rb_tracker_new(policy)
    f = f + check_int("backoff.tracker.attempt0", rb.rb_tracker_attempt(tracker), 100)
    f = f + check_int("backoff.tracker.attempt1", rb.rb_tracker_attempt(tracker), 200)
    f = f + check_int("backoff.tracker.attempt2", rb.rb_tracker_attempt(tracker), 400)
    f = f + check_int("backoff.tracker.attempt3", rb.rb_tracker_attempt(tracker), 800)
    f = f + check_int("backoff.tracker.attempt4", rb.rb_tracker_attempt(tracker), 1600)
    f = f + check_int("backoff.tracker.exhausted", rb.rb_tracker_attempt(tracker), -1)

    rb.rb_tracker_reset(tracker)
    f = f + check_int("backoff.tracker.reset", rb.rb_tracker_attempt(tracker), 100)

    f

// ---------------------------------------------------------------------------
// std/collections/ring_buffer
// ---------------------------------------------------------------------------
fn test_ring_buffer() -> int
    let f = 0

    let buf = rb2.rb2_new(3)
    f = f + check("ringbuf.new.empty", rb2.rb2_is_empty(buf))
    f = f + check("ringbuf.new.not_full", not rb2.rb2_is_full(buf))
    f = f + check_int("ringbuf.new.size", rb2.rb2_size(buf), 0)
    f = f + check_int("ringbuf.pop.empty_returns_0", rb2.rb2_pop(buf), 0)
    f = f + check_int("ringbuf.peek.empty_returns_0", rb2.rb2_peek(buf), 0)

    rb2.rb2_push(buf, 10)
    rb2.rb2_push(buf, 20)
    f = f + check_int("ringbuf.size.2", rb2.rb2_size(buf), 2)
    f = f + check_int("ringbuf.peek.oldest", rb2.rb2_peek(buf), 10)
    f = f + check("ringbuf.not_full.2of3", not rb2.rb2_is_full(buf))

    rb2.rb2_push(buf, 30)
    f = f + check("ringbuf.is_full.3of3", rb2.rb2_is_full(buf))
    f = f + check_int("ringbuf.size.3", rb2.rb2_size(buf), 3)

    let list1 = rb2.rb2_to_list(buf)
    f = f + check_int("ringbuf.to_list.len", len(list1), 3)
    f = f + check_int("ringbuf.to_list.0", list1[0], 10)
    f = f + check_int("ringbuf.to_list.1", list1[1], 20)
    f = f + check_int("ringbuf.to_list.2", list1[2], 30)

    // overwrite oldest (buffer full)
    rb2.rb2_push(buf, 40)
    f = f + check_int("ringbuf.size.still_3", rb2.rb2_size(buf), 3)
    let list2 = rb2.rb2_to_list(buf)
    f = f + check_int("ringbuf.overwrite.0", list2[0], 20)
    f = f + check_int("ringbuf.overwrite.1", list2[1], 30)
    f = f + check_int("ringbuf.overwrite.2", list2[2], 40)

    let popped = rb2.rb2_pop(buf)
    f = f + check_int("ringbuf.pop.value", popped, 20)
    f = f + check_int("ringbuf.pop.size_after", rb2.rb2_size(buf), 2)

    rb2.rb2_clear(buf)
    f = f + check("ringbuf.clear.empty", rb2.rb2_is_empty(buf))
    f = f + check_int("ringbuf.clear.size0", rb2.rb2_size(buf), 0)

    f

// ---------------------------------------------------------------------------
// std/text/diff (df_ API)
// ---------------------------------------------------------------------------
fn test_diff() -> int
    let f = 0

    let a = "line1" + chr(10) + "line2" + chr(10) + "line3"
    let b = "line1" + chr(10) + "lineX" + chr(10) + "line3" + chr(10) + "line4"

    let changes = df.df_lines(a, b)
    f = f + check_int("diff.lines.len", len(changes), 5)
    f = f + check_str("diff.lines.0.op", changes[0][0], "=")
    f = f + check_str("diff.lines.0.line", changes[0][1], "line1")

    let added = df.df_added(changes)
    let removed = df.df_removed(changes)
    f = f + check_int("diff.added.count", len(added), 2)
    f = f + check_int("diff.removed.count", len(removed), 1)
    f = f + check("diff.removed.has_line2", contains(removed, "line2"))
    f = f + check("diff.added.has_lineX", contains(added, "lineX"))
    f = f + check("diff.added.has_line4", contains(added, "line4"))

    f = f + check_str("diff.summary", df.df_summary(changes), "2 additions, 1 deletions")

    let patched = df.df_patch(a, changes)
    f = f + check_str("diff.patch.reconstructs_b", patched, b)

    let same = df.df_lines("x", "x")
    f = f + check_int("diff.same.len", len(same), 1)
    f = f + check_str("diff.same.op", same[0][0], "=")

    let empty_changes = df.df_lines("", "")
    f = f + check_int("diff.empty.len", len(empty_changes), 0)
    f = f + check_str("diff.empty.summary", df.df_summary(empty_changes), "0 additions, 0 deletions")

    f

// ---------------------------------------------------------------------------
// std/net/rate_limit
// ---------------------------------------------------------------------------
fn test_rate_limit() -> int
    let f = 0

    let lim = rl.rl_new(10, 5)
    f = f + check_int("ratelimit.available.initial", rl.rl_available(lim, 0), 10)

    f = f + check("ratelimit.acquire.5_ok", rl.rl_try_acquire(lim, 5, 0))
    f = f + check_int("ratelimit.available.after5", rl.rl_available(lim, 0), 5)

    f = f + check("ratelimit.acquire.5_more_ok", rl.rl_try_acquire(lim, 5, 0))
    f = f + check_int("ratelimit.available.after10", rl.rl_available(lim, 0), 0)

    f = f + check("ratelimit.acquire.fails_when_empty", not rl.rl_try_acquire(lim, 1, 0))

    // 2000ms elapsed at 5 tokens/sec = 10 tokens refilled, capped at max_tokens=10
    f = f + check_int("ratelimit.available.after_refill", rl.rl_available(lim, 2000), 10)

    f = f + check("ratelimit.acquire.after_refill", rl.rl_try_acquire(lim, 8, 2000))
    f = f + check_int("ratelimit.available.post_acquire", rl.rl_available(lim, 2000), 2)

    f = f + check_int("ratelimit.wait_time.available_now", rl.rl_wait_time(lim, 2, 2000), 0)
    // need 8 more tokens beyond the 2 available, deficit 8 / rate 5 = 1.6s = 1600ms (ceil)
    f = f + check_int("ratelimit.wait_time.needs_wait", rl.rl_wait_time(lim, 10, 2000), 1600)

    rl.rl_reset(lim)
    f = f + check_int("ratelimit.reset.full", rl.rl_available(lim, 2000), 10)

    let zero_rate = rl.rl_new(5, 0)
    rl.rl_try_acquire(zero_rate, 5, 0)
    f = f + check_int("ratelimit.zero_rate.no_wait_sentinel", rl.rl_wait_time(zero_rate, 1, 0), 2147483647)

    f

// ---------------------------------------------------------------------------
fn main()
    let total_fail = 0
    total_fail = total_fail + test_schema()
    total_fail = total_fail + test_locale()
    total_fail = total_fail + test_backoff()
    total_fail = total_fail + test_ring_buffer()
    total_fail = total_fail + test_diff()
    total_fail = total_fail + test_rate_limit()

    if total_fail == 0
        print("PASS _kat_validation_i18n_misc")
    else
        print("FAILED: " + str(total_fail) + " checks")
