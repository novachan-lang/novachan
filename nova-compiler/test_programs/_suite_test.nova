// KAT for std/testing/suite — test suite runner
import std/testing/suite

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got " + got + " want " + want)
        exit(1)

// Named test functions: take no args, return 1=pass or 0=fail
fn t_ok() -> int
    return 1

fn t_bad() -> int
    return 0

fn main()
    // ── KAT 1-5: suite with 2 passing + 1 failing test ──────────────────────
    let s = tsuite_new("demo")
    tsuite_add(s, "a", t_ok)
    tsuite_add(s, "b", t_ok)
    tsuite_add(s, "c", t_bad)
    let r = tsuite_run(s)

    // KAT 1: total == 3
    cki("total", r["total"], 3)

    // KAT 2: passed == 2
    cki("passed", r["passed"], 2)

    // KAT 3: failed == 1
    cki("failed", r["failed"], 1)

    // KAT 4: tsuite_all_pass is false (0) when there are failures
    ckb("all_pass_mixed", tsuite_all_pass(r), 0)

    // KAT 5: results list has 3 entries
    let res = r["results"]
    cki("results_len", len(res), 3)

    // KAT 6: first result name is "a" and ok==1
    let pair0 = res[0]
    cks("result0_name", pair0[0], "a")
    cki("result0_ok", pair0[1], 1)

    // KAT 7: third result name is "c" and ok==0 (the failing test)
    let pair2 = res[2]
    cks("result2_name", pair2[0], "c")
    cki("result2_ok", pair2[1], 0)

    // ── KAT 8: suite with only passing tests → all_pass true ─────────────────
    let s2 = tsuite_new("x")
    tsuite_add(s2, "a", t_ok)
    let r2 = tsuite_run(s2)
    ckb("all_pass_true", tsuite_all_pass(r2), 1)

    // ── KAT 9: empty suite → total==0, passed==0, failed==0, all_pass true ───
    let s3 = tsuite_new("empty")
    let r3 = tsuite_run(s3)
    cki("empty_total", r3["total"], 0)
    cki("empty_passed", r3["passed"], 0)
    cki("empty_failed", r3["failed"], 0)
    ckb("empty_all_pass", tsuite_all_pass(r3), 1)

    // ── KAT 10: all-failing suite → passed==0, all_pass false ────────────────
    let s4 = tsuite_new("allbad")
    tsuite_add(s4, "x", t_bad)
    tsuite_add(s4, "y", t_bad)
    let r4 = tsuite_run(s4)
    cki("allbad_total", r4["total"], 2)
    cki("allbad_passed", r4["passed"], 0)
    cki("allbad_failed", r4["failed"], 2)
    ckb("allbad_all_pass", tsuite_all_pass(r4), 0)

    print("_suite_test passed")

main()
