// _zip_read_test.nova — KAT for std/compress/zip_read
import std/compress/zip_read

fn ck_bool(label, got, want)
    if got != want
        let gs = "false"
        let ws = "false"
        if got
            gs = "true"
        if want
            ws = "true"
        print("FAIL zip_read " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn ck_int(label, got, want)
    if got != want
        print("FAIL zip_read " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck_str(label, got, want)
    if got != want
        print("FAIL zip_read " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // ── Build a LOCAL file header at pos 0 ──────────────────────────────────
    // sig: 80,75,3,4
    // version u16le 20: 20,0
    // flags u16le 0:    0,0
    // method u16le 8:   8,0
    // modtime u16le 0:  0,0
    // moddate u16le 0:  0,0
    // crc32 u32le 0:    0,0,0,0
    // comp_size u32le 100: 100,0,0,0
    // uncomp_size u32le 200: 200,0,0,0
    // name_len u16le 8:  8,0
    // extra_len u16le 0: 0,0
    let local = []
    // sig
    push(local, 80)
    push(local, 75)
    push(local, 3)
    push(local, 4)
    // version needed u16le 20
    push(local, 20)
    push(local, 0)
    // flags u16le 0
    push(local, 0)
    push(local, 0)
    // method u16le 8
    push(local, 8)
    push(local, 0)
    // modtime u16le 0
    push(local, 0)
    push(local, 0)
    // moddate u16le 0
    push(local, 0)
    push(local, 0)
    // crc32 u32le 0
    push(local, 0)
    push(local, 0)
    push(local, 0)
    push(local, 0)
    // comp_size u32le 100
    push(local, 100)
    push(local, 0)
    push(local, 0)
    push(local, 0)
    // uncomp_size u32le 200
    push(local, 200)
    push(local, 0)
    push(local, 0)
    push(local, 0)
    // name_len u16le 8
    push(local, 8)
    push(local, 0)
    // extra_len u16le 0
    push(local, 0)
    push(local, 0)

    ck_bool("local_check", zip_local_check(local, 0), true)
    ck_int("local_method", zip_local_method(local, 0), 8)
    ck_str("local_method_name", zip_local_method_name(local, 0), "deflate")
    ck_int("local_comp_size", zip_local_comp_size(local, 0), 100)
    ck_int("local_uncomp_size", zip_local_uncomp_size(local, 0), 200)
    ck_int("local_name_len", zip_local_name_len(local, 0), 8)

    // ── Build a central directory header and check its signature ────────────
    let central = []
    // sig: 80,75,1,2
    push(central, 80)
    push(central, 75)
    push(central, 1)
    push(central, 2)
    ck_bool("central_check", zip_central_check(central, 0), true)
    ck_bool("central_not_local", zip_local_check(central, 0), false)

    // ── Build an EOCD record at pos 0 ────────────────────────────────────────
    // sig: 80,75,5,6
    // disk u16le 0:           0,0
    // cd_disk u16le 0:        0,0
    // disk_entries u16le 3:   3,0
    // total_entries u16le 3:  3,0
    // cd_size u32le 150:      150,0,0,0
    // cd_offset u32le 40:     40,0,0,0
    let eocd = []
    push(eocd, 80)
    push(eocd, 75)
    push(eocd, 5)
    push(eocd, 6)
    // disk
    push(eocd, 0)
    push(eocd, 0)
    // cd_disk
    push(eocd, 0)
    push(eocd, 0)
    // disk_entries u16le 3
    push(eocd, 3)
    push(eocd, 0)
    // total_entries u16le 3
    push(eocd, 3)
    push(eocd, 0)
    // cd_size u32le 150
    push(eocd, 150)
    push(eocd, 0)
    push(eocd, 0)
    push(eocd, 0)
    // cd_offset u32le 40
    push(eocd, 40)
    push(eocd, 0)
    push(eocd, 0)
    push(eocd, 0)

    ck_bool("eocd_check", zip_eocd_check(eocd, 0), true)
    ck_int("eocd_total_entries", zip_eocd_total_entries(eocd, 0), 3)
    ck_int("eocd_cd_size", zip_eocd_cd_size(eocd, 0), 150)
    ck_int("eocd_cd_offset", zip_eocd_cd_offset(eocd, 0), 40)

    // ── Edge cases: wrong/bad signatures ─────────────────────────────────────
    let bad = []
    push(bad, 0)
    push(bad, 0)
    push(bad, 0)
    push(bad, 0)
    ck_bool("bad_local_check", zip_local_check(bad, 0), false)
    ck_bool("bad_central_check", zip_central_check(bad, 0), false)
    ck_bool("bad_eocd_check", zip_eocd_check(bad, 0), false)

    // ── stored method name ────────────────────────────────────────────────────
    let local2 = []
    push(local2, 80)
    push(local2, 75)
    push(local2, 3)
    push(local2, 4)
    // version
    push(local2, 20)
    push(local2, 0)
    // flags
    push(local2, 0)
    push(local2, 0)
    // method u16le 0 (stored)
    push(local2, 0)
    push(local2, 0)
    ck_str("local_method_stored", zip_local_method_name(local2, 0), "stored")

    // ── other method (not 0 or 8) ─────────────────────────────────────────────
    let local3 = []
    push(local3, 80)
    push(local3, 75)
    push(local3, 3)
    push(local3, 4)
    push(local3, 20)
    push(local3, 0)
    push(local3, 0)
    push(local3, 0)
    // method u16le 9
    push(local3, 9)
    push(local3, 0)
    ck_str("local_method_other", zip_local_method_name(local3, 0), "other")

    // ── EOCD sig wrong 4th byte ────────────────────────────────────────────────
    let eocd2 = []
    push(eocd2, 80)
    push(eocd2, 75)
    push(eocd2, 5)
    push(eocd2, 7)
    ck_bool("eocd_wrong_sig", zip_eocd_check(eocd2, 0), false)

    print("PASS _zip_read_test")
