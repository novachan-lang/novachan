import std/framing/reassembly

// ── Helpers ──────────────────────────────────────────────────────────────────

fn list_eq(a, b) -> bool
    let na = len(a)
    let nb = len(b)
    if na != nb
        return false
    let i = 0
    while i < na
        if a[i] != b[i]
            return false
        i = i + 1
    true

fn ck_int(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck_bool(label, got, want)
    let g = 0
    if got
        g = 1
    let w = 0
    if want
        w = 1
    if g != w
        print("FAIL " + label + ": got=" + str(g) + " want=" + str(w))
        exit(1)

fn ck_list(label, got, want)
    if not list_eq(got, want)
        print("FAIL " + label + ": list mismatch len_got=" + str(len(got)) + " len_want=" + str(len(want)))
        exit(1)

fn make3(a, b, c) -> list
    let out = []
    push(out, a)
    push(out, b)
    push(out, c)
    out

fn main()
    // ── KAT 1: delimiter reassembler — frames split across chunks ─────────────
    // delim=0: feed [1,2] then [3,0,4,5,0,6]
    // First feed: no delimiter -> returns []
    // Second feed: emits [1,2,3] and [4,5]; [6] stays buffered
    let rs = reasm_new_delim(0)
    let chunk1 = []
    push(chunk1, 1)
    push(chunk1, 2)
    let f1 = reasm_feed_delim(rs, chunk1)
    ck_int("delim_feed1_count", len(f1), 0)

    let chunk2 = []
    push(chunk2, 3)
    push(chunk2, 0)
    push(chunk2, 4)
    push(chunk2, 5)
    push(chunk2, 0)
    push(chunk2, 6)
    let f2 = reasm_feed_delim(rs, chunk2)
    ck_int("delim_feed2_count", len(f2), 2)

    // First frame: [1,2,3]
    let frame0 = f2[0]
    let want_frame0 = make3(1, 2, 3)
    ck_list("delim_frame0", frame0, want_frame0)

    // Second frame: [4,5]
    let frame1 = f2[1]
    let want_frame1 = []
    push(want_frame1, 4)
    push(want_frame1, 5)
    ck_list("delim_frame1", frame1, want_frame1)

    // [6] still pending
    ck_int("delim_pending", reasm_pending(rs), 1)

    // ── KAT 2: reasm_has_frame_delim ─────────────────────────────────────────
    // Buffer contains [6] with no delimiter -> false
    ck_bool("delim_has_frame_false", reasm_has_frame_delim(rs), false)
    // Feed delimiter byte
    let chunk3 = []
    push(chunk3, 0)
    reasm_feed_delim(rs, chunk3)
    // Now the [6] frame was emitted; buffer should be empty
    ck_int("delim_after_delim_pending", reasm_pending(rs), 0)

    // ── KAT 3: reasm_reset clears the buffer ─────────────────────────────────
    let rs2 = reasm_new_delim(0)
    let ch_reset = []
    push(ch_reset, 7)
    push(ch_reset, 8)
    reasm_feed_delim(rs2, ch_reset)
    ck_int("before_reset_pending", reasm_pending(rs2), 2)
    reasm_reset(rs2)
    ck_int("after_reset_pending", reasm_pending(rs2), 0)

    // ── KAT 4: u16be length-prefix reassembler ────────────────────────────────
    // Frame = [0, 3, 9, 8, 7] -> payload = [9, 8, 7]
    // Split across two feeds: [0,3] then [9,8,7]
    let lp = reasm_new_lenprefix()
    let lp_chunk1 = []
    push(lp_chunk1, 0)
    push(lp_chunk1, 3)
    let lp_f1 = reasm_feed_lenprefix(lp, lp_chunk1)
    ck_int("lp_feed1_count", len(lp_f1), 0)
    ck_int("lp_feed1_pending", reasm_pending(lp), 2)

    let lp_chunk2 = []
    push(lp_chunk2, 9)
    push(lp_chunk2, 8)
    push(lp_chunk2, 7)
    let lp_f2 = reasm_feed_lenprefix(lp, lp_chunk2)
    ck_int("lp_feed2_count", len(lp_f2), 1)

    let lp_frame = lp_f2[0]
    let want_lp = make3(9, 8, 7)
    ck_list("lp_frame_payload", lp_frame, want_lp)
    ck_int("lp_pending_after", reasm_pending(lp), 0)

    // ── KAT 5: lenprefix — two frames arrive in one chunk ─────────────────────
    // Frame A: len=2, payload=[0xAA, 0xBB]
    // Frame B: len=1, payload=[0xCC]
    // All bytes together: [0,2, 0xAA,0xBB, 0,1, 0xCC]
    let lp2 = reasm_new_lenprefix()
    let lp2_chunk = []
    push(lp2_chunk, 0)
    push(lp2_chunk, 2)
    push(lp2_chunk, 0xAA)
    push(lp2_chunk, 0xBB)
    push(lp2_chunk, 0)
    push(lp2_chunk, 1)
    push(lp2_chunk, 0xCC)
    let lp2_frames = reasm_feed_lenprefix(lp2, lp2_chunk)
    ck_int("lp2_count", len(lp2_frames), 2)
    let lp2_fa = lp2_frames[0]
    let want_lp2_fa = []
    push(want_lp2_fa, 0xAA)
    push(want_lp2_fa, 0xBB)
    ck_list("lp2_frameA", lp2_fa, want_lp2_fa)
    let lp2_fb = lp2_frames[1]
    let want_lp2_fb = []
    push(want_lp2_fb, 0xCC)
    ck_list("lp2_frameB", lp2_fb, want_lp2_fb)

    // ── KAT 6: reasm_feed_byte_delim — feed one byte at a time ──────────────
    let rs3 = reasm_new_delim(10)
    let bytes_to_feed = []
    push(bytes_to_feed, 72)
    push(bytes_to_feed, 105)
    push(bytes_to_feed, 10)
    let collected = []
    let ni = 0
    while ni < len(bytes_to_feed)
        let b = bytes_to_feed[ni]
        let result = reasm_feed_byte_delim(rs3, b)
        let ri = 0
        while ri < len(result)
            push(collected, result[ri])
            ri = ri + 1
        ni = ni + 1
    ck_int("byte_delim_frames", len(collected), 1)
    let byte_frame = collected[0]
    let want_byte_frame = []
    push(want_byte_frame, 72)
    push(want_byte_frame, 105)
    ck_list("byte_delim_frame", byte_frame, want_byte_frame)

    // ── KAT 7: reasm_buffer returns copy of current buffer ───────────────────
    let rs4 = reasm_new_delim(0)
    let ch4 = []
    push(ch4, 11)
    push(ch4, 22)
    reasm_feed_delim(rs4, ch4)
    let buf4 = reasm_buffer(rs4)
    let want_buf4 = []
    push(want_buf4, 11)
    push(want_buf4, 22)
    ck_list("reasm_buffer", buf4, want_buf4)

    // ── KAT 8: empty payload frame (delimiter immediately) ────────────────────
    let rs5 = reasm_new_delim(0)
    let ch5 = []
    push(ch5, 0)
    let f5 = reasm_feed_delim(rs5, ch5)
    ck_int("empty_frame_count", len(f5), 1)
    let empty_frame = f5[0]
    let want_empty = []
    ck_list("empty_frame_payload", empty_frame, want_empty)

    // ── KAT 9: lenprefix with zero-length payload ─────────────────────────────
    let lp3 = reasm_new_lenprefix()
    let zero_len_chunk = []
    push(zero_len_chunk, 0)
    push(zero_len_chunk, 0)
    let lp3_frames = reasm_feed_lenprefix(lp3, zero_len_chunk)
    ck_int("lp_zero_len_count", len(lp3_frames), 1)
    let lp3_frame = lp3_frames[0]
    let want_zero = []
    ck_list("lp_zero_len_payload", lp3_frame, want_zero)

    // ── KAT 10: reasm_reset on lenprefix state ────────────────────────────────
    let lp4 = reasm_new_lenprefix()
    let lp4_partial = []
    push(lp4_partial, 0)
    push(lp4_partial, 5)
    reasm_feed_lenprefix(lp4, lp4_partial)
    ck_int("lp4_before_reset", reasm_pending(lp4), 2)
    reasm_reset(lp4)
    ck_int("lp4_after_reset", reasm_pending(lp4), 0)

    print("PASS _reassembly_test")
