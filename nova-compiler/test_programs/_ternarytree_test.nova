// KAT test for std/collections/ternarytree.
//
// Hand-computed expected values for the spec KAT:
//   Insert: cat, car, card, dog, do
//
//   TST structure (conceptual, inserting in order):
//     Root node: c='c'
//       eq -> a -> t (end=cat)
//                -> r (end=car)
//                      eq -> d (end=card)
//       hi -> d -> o (end=do)
//                   eq -> g (end=dog)
//
//   tst_contains("car")  = true
//   tst_contains("ca")   = false  (no end at 'a' node)
//   tst_contains("do")   = true
//   tst_starts_with("ca") = true  (path c->a exists)
//   tst_starts_with("xy") = false (no 'x' path)
//   tst_keys_with_prefix("car") = ["car","card"]
//   tst_keys(t) = ["car","card","cat","do","dog"]
//   tst_size(t) = 5

import std/collections/ternarytree

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        let ws = "false"
        if got
            gs = "true"
        if want
            ws = "true"
        print("FAIL " + label + ": got " + gs + " want " + ws)
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got " + got + " want " + want)
        exit(1)

fn main()
    // --- Spec KAT setup ---
    let t = tst_new()
    tst_insert(t, "cat")
    tst_insert(t, "car")
    tst_insert(t, "card")
    tst_insert(t, "dog")
    tst_insert(t, "do")

    // --- KAT 1: tst_contains ---
    ckb("contains_car",  tst_contains(t, "car"),  true)
    ckb("contains_ca",   tst_contains(t, "ca"),   false)
    ckb("contains_do",   tst_contains(t, "do"),   true)
    ckb("contains_cat",  tst_contains(t, "cat"),  true)
    ckb("contains_card", tst_contains(t, "card"), true)
    ckb("contains_dog",  tst_contains(t, "dog"),  true)
    ckb("contains_d",    tst_contains(t, "d"),    false)
    ckb("contains_xyz",  tst_contains(t, "xyz"),  false)
    ckb("contains_dogs", tst_contains(t, "dogs"), false)
    ckb("contains_empty", tst_contains(t, ""),    false)

    // --- KAT 2: tst_starts_with ---
    ckb("starts_ca",  tst_starts_with(t, "ca"),  true)
    ckb("starts_xy",  tst_starts_with(t, "xy"),  false)
    ckb("starts_car", tst_starts_with(t, "car"), true)
    ckb("starts_do",  tst_starts_with(t, "do"),  true)
    ckb("starts_d",   tst_starts_with(t, "d"),   true)
    ckb("starts_da",  tst_starts_with(t, "da"),  false)
    ckb("starts_dogs", tst_starts_with(t, "dogs"), false)
    ckb("starts_empty", tst_starts_with(t, ""), true)

    // --- KAT 3: tst_keys_with_prefix("car") = ["car","card"] ---
    let kcar = tst_keys_with_prefix(t, "car")
    cki("prefix_car_len", len(kcar), 2)
    cks("prefix_car_0", kcar[0], "car")
    cks("prefix_car_1", kcar[1], "card")

    // --- KAT 4: tst_keys(t) = ["car","card","cat","do","dog"] ---
    let all = tst_keys(t)
    cki("keys_len", len(all), 5)
    cks("keys_0", all[0], "car")
    cks("keys_1", all[1], "card")
    cks("keys_2", all[2], "cat")
    cks("keys_3", all[3], "do")
    cks("keys_4", all[4], "dog")

    // --- KAT 5: tst_size = 5 ---
    cki("size", tst_size(t), 5)

    // --- KAT 6: tst_starts_with("ca") = true and prefix_ca = ["car","card","cat"] ---
    ckb("starts_with_ca", tst_starts_with(t, "ca"), true)
    let kca = tst_keys_with_prefix(t, "ca")
    cki("prefix_ca_len", len(kca), 3)
    cks("prefix_ca_0", kca[0], "car")
    cks("prefix_ca_1", kca[1], "card")
    cks("prefix_ca_2", kca[2], "cat")

    // --- KAT 7: starts_with("xy") = false ---
    ckb("starts_xy2", tst_starts_with(t, "xy"), false)
    let kxy = tst_keys_with_prefix(t, "xy")
    cki("prefix_xy_len", len(kxy), 0)

    // --- KAT 8: idempotent re-insert ---
    tst_insert(t, "car")
    tst_insert(t, "do")
    cki("size_after_dup", tst_size(t), 5)
    let all2 = tst_keys(t)
    cki("keys_len_after_dup", len(all2), 5)

    // --- KAT 9: single-character words ---
    let t2 = tst_new()
    tst_insert(t2, "a")
    tst_insert(t2, "b")
    tst_insert(t2, "c")
    cki("t2_size", tst_size(t2), 3)
    ckb("t2_contains_a", tst_contains(t2, "a"), true)
    ckb("t2_contains_b", tst_contains(t2, "b"), true)
    ckb("t2_contains_c", tst_contains(t2, "c"), true)
    ckb("t2_contains_d", tst_contains(t2, "d"), false)
    ckb("t2_starts_a",   tst_starts_with(t2, "a"), true)
    ckb("t2_starts_d",   tst_starts_with(t2, "d"), false)
    let t2all = tst_keys(t2)
    cki("t2_keys_len", len(t2all), 3)
    cks("t2_keys_0", t2all[0], "a")
    cks("t2_keys_1", t2all[1], "b")
    cks("t2_keys_2", t2all[2], "c")

    // --- KAT 10: empty trie ---
    let t3 = tst_new()
    cki("t3_size_empty", tst_size(t3), 0)
    ckb("t3_contains", tst_contains(t3, "cat"), false)
    ckb("t3_starts",   tst_starts_with(t3, "c"), false)
    let k_empty = tst_keys_with_prefix(t3, "c")
    cki("t3_prefix_len", len(k_empty), 0)
    let t3all = tst_keys(t3)
    cki("t3_keys_empty", len(t3all), 0)

    // --- KAT 11: prefix == exact word (word itself is also a key) ---
    let kdo = tst_keys_with_prefix(t, "do")
    cki("prefix_do_len", len(kdo), 2)
    cks("prefix_do_0", kdo[0], "do")
    cks("prefix_do_1", kdo[1], "dog")

    print("_ternarytree_test passed")

main()
