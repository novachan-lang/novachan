import forge_shadow_deploy

fn main()
    let s = sd_new()
    s = sd_start(s, "v1.0", "v2.0")
    assert(sd_is_active(s) == 1, "active")

    let r1 = sd_request(s, "ok-200", "ok-200")
    s = r1["s"]
    assert(r1["match"] == 1, "match")

    let r2 = sd_request(s, "ok-200", "err-500")
    s = r2["s"]
    assert(r2["match"] == 0, "mismatch")

    let r3 = sd_request(s, "ok-200", "ok-200")
    s = r3["s"]
    let r4 = sd_request(s, "ok-200", "ok-200")
    s = r4["s"]

    assert(sd_total_requests(s) == 4, "4 requests")
    assert(sd_mismatch_count(s) == 1, "1 mismatch")
    assert(sd_match_rate(s) == 75, "75% match")

    assert(sd_is_safe_to_promote(s, 10, 90) == 0, "not enough requests")
    assert(sd_is_safe_to_promote(s, 3, 70) == 1, "safe with lower bar")
    assert(sd_is_safe_to_promote(s, 3, 80) == 0, "75 < 80 threshold")

    s = sd_stop(s)
    assert(sd_is_active(s) == 0, "stopped")

    print("SHADOW-DEPLOY KAT PASS")
