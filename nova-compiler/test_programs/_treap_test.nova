import std/collections/treap

fn cki(got, expected, label)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(got, expected, label)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn ckl(got, expected, label)
    let gl = len(got)
    let el = len(expected)
    if gl != el
        print("FAIL " + label + ": length got " + str(gl) + " expected " + str(el))
        exit(1)
    let i = 0
    while i < gl
        if got[i] != expected[i]
            print("FAIL " + label + ": at index " + str(i) + " got " + str(got[i]) + " expected " + str(expected[i]))
            exit(1)
        i = i + 1

fn main()
    // Build treap with keys: 5,3,8,1,4,7,9,2 in that order
    let t = treap.tr_new()
    treap.tr_insert(t, 5)
    treap.tr_insert(t, 3)
    treap.tr_insert(t, 8)
    treap.tr_insert(t, 1)
    treap.tr_insert(t, 4)
    treap.tr_insert(t, 7)
    treap.tr_insert(t, 9)
    treap.tr_insert(t, 2)

    // KAT 1: inorder traversal produces sorted list [1,2,3,4,5,7,8,9]
    let expected_full = [1, 2, 3, 4, 5, 7, 8, 9]
    let got_full = treap.tr_inorder(t)
    ckl(got_full, expected_full, "inorder after 8 inserts")

    // KAT 2: tr_contains(t, 4) == true (1)
    cki(treap.tr_contains(t, 4), 1, "contains(4) true")

    // KAT 3: tr_contains(t, 6) == false (0)
    cki(treap.tr_contains(t, 6), 0, "contains(6) false")

    // KAT 4: tr_size(t) == 8
    cki(treap.tr_size(t), 8, "size == 8")

    // KAT 5: tr_min(t) == 1
    cki(treap.tr_min(t), 1, "min == 1")

    // KAT 6: tr_max(t) == 9
    cki(treap.tr_max(t), 9, "max == 9")

    // KAT 7: delete 5, then contains(5) == false
    treap.tr_delete(t, 5)
    cki(treap.tr_contains(t, 5), 0, "contains(5) false after delete")

    // KAT 8: inorder after deleting 5 == [1,2,3,4,7,8,9]
    let expected_del = [1, 2, 3, 4, 7, 8, 9]
    let got_del = treap.tr_inorder(t)
    ckl(got_del, expected_del, "inorder after delete(5)")

    // KAT 9: size after delete == 7
    cki(treap.tr_size(t), 7, "size == 7 after delete")

    // KAT 10: duplicate insert is idempotent (size stays 7)
    treap.tr_insert(t, 3)
    cki(treap.tr_size(t), 7, "size unchanged after duplicate insert")

    // KAT 11: delete non-existent is no-op
    treap.tr_delete(t, 99)
    cki(treap.tr_size(t), 7, "size unchanged after delete of absent key")

    // KAT 12: min/max after delete
    cki(treap.tr_min(t), 1, "min still 1 after delete(5)")
    cki(treap.tr_max(t), 9, "max still 9 after delete(5)")

    print("_treap_test passed")
