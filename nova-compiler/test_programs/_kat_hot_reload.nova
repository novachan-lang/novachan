import forge_hot_reload

fn main()
    let h = hr_new()
    h = hr_register(h, "auth", 1)
    h = hr_register(h, "api", 1)
    h = hr_register(h, "db", 1)
    assert(hr_module_count(h) == 3, "3 modules")
    assert(hr_version(h, "auth") == 1, "auth v1")

    h = hr_reload(h, "auth", 2, 1000)
    assert(hr_version(h, "auth") == 2, "auth v2")
    assert(hr_total_reloads(h) == 1, "1 reload")
    assert(hr_last_reload_time(h, "auth") == 1000, "reload at 1000")

    h = hr_reload(h, "auth", 1, 2000)
    assert(hr_version(h, "auth") == 2, "no downgrade")
    assert(hr_total_reloads(h) == 1, "still 1")

    assert(hr_needs_reload(h, "api", 3) == 1, "api needs reload")
    assert(hr_needs_reload(h, "auth", 2) == 0, "auth up to date")
    assert(hr_needs_reload(h, "unknown", 1) == 0, "unknown = 0")

    h = hr_reload(h, "api", 5, 2000)
    h = hr_reload(h, "db", 3, 3000)
    assert(hr_total_reloads(h) == 3, "3 total reloads")
    assert(hr_version(h, "db") == 3, "db v3")

    print("HOT-RELOAD KAT PASS")
