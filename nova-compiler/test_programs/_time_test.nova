import std/units/time

// Float approximate equality with tolerance.
fn approx(a: float, b: float, tol: float) -> int
    let diff = a - b
    let adiff = diff
    if diff < 0.0
        adiff = 0.0 - diff
    let ok = 1
    if adiff > tol
        ok = 0
    ok

fn ckf(label: string, got: float, want: float, tol: float)
    let ok = approx(got, want, tol)
    if ok == 0
        print("FAIL time " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL time " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // time_convert(1.0,'h','s') == 3600.0
    let v1 = time_convert(1.0, "h", "s")
    ckf("h_to_s", v1, 3600.0, 0.0001)

    // time_convert(1.0,'d','h') == 24.0
    let v2 = time_convert(1.0, "d", "h")
    ckf("d_to_h", v2, 24.0, 0.0001)

    // time_convert(1.0,'min','s') == 60.0
    let v3 = time_convert(1.0, "min", "s")
    ckf("min_to_s", v3, 60.0, 0.0001)

    // time_convert(1.0,'wk','d') == 7.0
    let v4 = time_convert(1.0, "wk", "d")
    ckf("wk_to_d", v4, 7.0, 0.0001)

    // time_convert(2.0,'h','min') == 120.0
    let v5 = time_convert(2.0, "h", "min")
    ckf("2h_to_min", v5, 120.0, 0.0001)

    // round-trip: from_base(to_base(5.0,'d'),'d') approx 5.0
    let base6 = time_to_base(5.0, "d")
    let v6 = time_from_base(base6, "d")
    ckf("roundtrip_d", v6, 5.0, 0.000001)

    // time_factor('s') == 1.0
    let f1 = time_factor("s")
    ckf("factor_s", f1, 1.0, 0.0000001)

    // time_factor('h') == 3600.0
    let f2 = time_factor("h")
    ckf("factor_h", f2, 3600.0, 0.0001)

    // time_factor('yr') == 31536000.0 (365 * 86400)
    let f3 = time_factor("yr")
    ckf("factor_yr", f3, 31536000.0, 1.0)

    // time_is_supported('min') == 1
    let s1 = time_is_supported("min")
    cki("supported_min", s1, 1)

    // time_is_supported('xyz') == 0
    let s2 = time_is_supported("xyz")
    cki("unsupported_xyz", s2, 0)

    // time_units() has 8 entries
    let us = time_units()
    let ulen = len(us)
    cki("units_count", ulen, 8)

    // ms roundtrip
    let base_ms = time_to_base(1000.0, "ms")
    ckf("ms_to_base_1s", base_ms, 1.0, 0.0000001)

    // us check
    let base_us = time_to_base(1000000.0, "us")
    ckf("us_to_base_1s", base_us, 1.0, 0.0000001)

    // wk roundtrip
    let base_wk = time_to_base(1.0, "wk")
    ckf("wk_to_base", base_wk, 604800.0, 0.01)
    let from_wk = time_from_base(604800.0, "wk")
    ckf("from_base_wk", from_wk, 1.0, 0.0000001)

    // yr check: 1 yr = 365 * 86400 = 31536000 s
    let base_yr = time_to_base(1.0, "yr")
    ckf("yr_to_base", base_yr, 31536000.0, 1.0)

    print("PASS _time_test")
