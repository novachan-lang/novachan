// OTP supervisor <-> gen_server, the NOVA way. A supervisor spawns a worker gen_server, MONITORS
// it (monitor(pid) returns a channel that fires with the worker's exit status when it dies), sends
// it a request, and RESTARTS it on failure -- until it succeeds. Composes monitor + spawn +
// mailbox + selective receive into OTP's supervisor<->gen_server loop, with NO framework.
//
// Scope note: fault signaling is NOVA-way explicit (the worker reports failure then exits) -- true
// OS-crash isolation across green tasks is the deeper Track-8 ownership work; here the supervisor
// observes the worker's DEATH via the monitor channel and restarts, which is the supervision pillar.
fn worker(boss, attempt)
    receive
        n =>
            if attempt < 2
                send_msg(boss, 0)            // report failure (then this worker exits -> monitor fires)
            else
                send_msg(boss, 100 + n)      // success payload
    // worker returns here -> task finishes -> the supervisor's monitor channel receives exit status

fn main()
    let me = self_pid()
    let attempt = 0
    let payload = 0
    let done = false
    while not done and attempt < 5
        let w = spawn worker(me, attempt)
        let m = monitor(w)                   // channel that fires when the worker dies
        send_msg(mailbox_of(w), 42)          // send the worker a request
        let r = recv_msg()                   // the worker's report (0 = failed)
        let _dead = receive(m)               // wait until the worker has actually exited
        if r == 0
            attempt = attempt + 1            // restart
        else
            payload = r
            done = true
    assert(done, "supervisor recovered the worker")
    assert(attempt == 2, "recovered after exactly 2 restarts")
    assert(payload == 142, "success payload is 100 + 42")
    print("SUPERVISED_GENSERVER_OK")
