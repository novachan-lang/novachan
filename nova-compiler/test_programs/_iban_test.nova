// _iban_test.nova — KAT for std/validation/iban
import std/validation/iban

fn ckb(label: string, got: bool, expected: bool)
    if got != expected
        let gs = "false"
        if got
            gs = "true"
        let es = "false"
        if expected
            es = "true"
        print("FAIL " + label + ": got " + gs + " expected " + es)
        exit(1)

fn cks(label: string, got: string, expected: string)
    if got != expected
        print("FAIL " + label + ": got " + got + " expected " + expected)
        exit(1)

fn main()
    // KAT 1: GB IBAN with spaces — valid
    ckb("gb_with_spaces", viban_is_valid("GB82 WEST 1234 5698 7654 32"), true)

    // KAT 2: German IBAN with spaces — valid
    ckb("de_with_spaces", viban_is_valid("DE89 3704 0044 0532 0130 00"), true)

    // KAT 3: GB IBAN compact (no spaces) — valid
    ckb("gb_compact", viban_is_valid("GB82WEST12345698765432"), true)

    // KAT 4: GB IBAN with wrong check digits (00 instead of 82) — invalid
    ckb("gb_bad_check", viban_is_valid("GB00WEST12345698765432"), false)

    // KAT 5: Too short — invalid
    ckb("too_short", viban_is_valid("XX"), false)

    // KAT 6: Norwegian IBAN (15 chars — minimum valid length) — valid
    // NO9386011117947 — a known valid Norwegian IBAN
    ckb("no_min_length", viban_is_valid("NO93 8601 1117 947"), true)

    // KAT 7: Bad check digits on Norwegian IBAN — invalid
    ckb("no_bad_check", viban_is_valid("NO00 8601 1117 947"), false)

    // KAT 8: viban_country extracts country code
    cks("country_gb", viban_country("GB82WEST12345698765432"), "GB")

    // KAT 9: viban_check_digits extracts check digits
    cks("check_digits_82", viban_check_digits("GB82WEST12345698765432"), "82")

    // KAT 10: viban_country with spaces input
    cks("country_de_spaces", viban_country("DE89 3704 0044 0532 0130 00"), "DE")

    // KAT 11: viban_check_digits with spaces input
    cks("check_digits_89", viban_check_digits("DE89 3704 0044 0532 0130 00"), "89")

    // KAT 12: viban_format groups in blocks of 4
    cks("format_gb", viban_format("GB82WEST12345698765432"), "GB82 WEST 1234 5698 7654 32")

    // KAT 13: viban_format on already-formatted input re-normalises
    cks("format_de", viban_format("DE89 3704 0044 0532 0130 00"), "DE89 3704 0044 0532 0130 00")

    // KAT 14: empty string — invalid
    ckb("empty_invalid", viban_is_valid(""), false)

    print("_iban_test passed")
