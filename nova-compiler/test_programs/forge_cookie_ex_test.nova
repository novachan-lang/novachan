// forge_cookie_ex_test -- resp_set_cookie_ex adds lifetime (Max-Age) + transport (Secure) control on top of
// the secure cookie defaults (Path=/; HttpOnly; SameSite=Lax). max_age>0 -> persistent (Max-Age); <=0 ->
// session cookie (no Max-Age). secure=1 -> "; Secure" (HTTPS-only); 0 -> omitted.
import forge

fn main()
    // persistent + secure
    let r = forge.resp_set_cookie_ex(forge.resp_text(200, ""), "session", "abc", 3600, 1)
    let ck = r.cookies[len(r.cookies) - 1]
    if find(ck, "session=abc") < 0
        print("FAIL: name=value -> " + ck)
        exit(1)
    if find(ck, "Path=/") < 0 or find(ck, "HttpOnly") < 0 or find(ck, "SameSite=Lax") < 0
        print("FAIL: secure defaults dropped -> " + ck)
        exit(1)
    if find(ck, "Max-Age=3600") < 0
        print("FAIL: Max-Age missing -> " + ck)
        exit(1)
    if find(ck, "Secure") < 0
        print("FAIL: Secure missing -> " + ck)
        exit(1)

    // session cookie (max_age<=0 -> no Max-Age) + insecure (secure=0 -> no Secure)
    let r2 = forge.resp_set_cookie_ex(forge.resp_text(200, ""), "s", "v", 0, 0)
    let ck2 = r2.cookies[len(r2.cookies) - 1]
    if find(ck2, "Max-Age") >= 0
        print("FAIL: session cookie must have no Max-Age -> " + ck2)
        exit(1)
    if find(ck2, "Secure") >= 0
        print("FAIL: secure=0 must omit Secure -> " + ck2)
        exit(1)
    if find(ck2, "HttpOnly") < 0 or find(ck2, "SameSite=Lax") < 0
        print("FAIL: defaults dropped in session mode -> " + ck2)
        exit(1)

    print("PASS forge_cookie_ex (Max-Age + Secure control; defaults preserved; session/insecure modes)")
