// Helper MODULE for match_any_module_test. Reproduces the compiler bug locus: a fn returning `-> any`
// (so the value is any-typed) whose Result is then `match`ed INSIDE a module function. Before the fix,
// `match Ok/Err` on an any-typed value in a module fn mis-resolved Ok to type_name_hash("Ok")=5862623
// instead of the Result tag 0, so NEITHER arm fired. The fix forces Ok->0 / Err->1 for these built-in
// Result constructors regardless of inference.
fn mr_produce(x: int) -> any
    if x > 0
        return ok(x * 10)
    err("neg")

// The match lives in a MODULE function (the bug only appeared here, not inline in a test main).
fn mr_classify(x: int) -> string
    let r = mr_produce(x)
    match r
        Ok(v) => "ok:" + str(v)
        Err(e) => "err:" + e
