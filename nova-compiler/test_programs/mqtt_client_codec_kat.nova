// KAT: forge_mqtt packet codec -- exact byte layouts from the OASIS MQTT 3.1.1 spec examples,
// plus remaining-length varint boundary values and round-trip decode checks for the
// server-to-client packet types (CONNACK/PUBLISH/SUBACK/PINGRESP) that forge_mqtt adds on top
// of the std/net/mqtt_* codecs it reuses.
import forge_mqtt
import std/net/mqtt_fixed
import std/net/mqtt_connect
import std/net/mqtt_publish
import std/net/mqtt_sub

fn assert_eq_int(got: int, want: int, label: string)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn assert_eq_blist(got: list, want: list, label: string)
    if len(got) != len(want)
        print("FAIL " + label + ": length got " + str(len(got)) + " want " + str(len(want)))
        exit(1)
    let i = 0
    let n = len(got)
    while i < n
        if got[i] != want[i]
            print("FAIL " + label + ": byte[" + str(i) + "] got " + str(got[i]) + " want " + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // ── Remaining-length varint boundary values (7-bit groups, high bit = continuation) ────────────
    assert_eq_blist(mqtt_remlen_encode(0), [0x00], "remlen(0)")
    assert_eq_blist(mqtt_remlen_encode(127), [0x7f], "remlen(127)")
    assert_eq_blist(mqtt_remlen_encode(128), [0x80, 0x01], "remlen(128)")
    assert_eq_blist(mqtt_remlen_encode(16383), [0xff, 0x7f], "remlen(16383)")

    // Round-trip decode of each boundary value.
    let d0 = mqtt_remlen_decode(mqtt_remlen_encode(0), 0)
    assert_eq_int(d0[0], 0, "remlen_decode(0)")
    let d127 = mqtt_remlen_decode(mqtt_remlen_encode(127), 0)
    assert_eq_int(d127[0], 127, "remlen_decode(127)")
    let d128 = mqtt_remlen_decode(mqtt_remlen_encode(128), 0)
    assert_eq_int(d128[0], 128, "remlen_decode(128)")
    let d16383 = mqtt_remlen_decode(mqtt_remlen_encode(16383), 0)
    assert_eq_int(d16383[0], 16383, "remlen_decode(16383)")

    // ── CONNECT: client id "a", clean session, keepalive 60 ─────────────────────────────────────────
    // 0x10 (type=1,flags=0), remlen=13, [00 04 'M' 'Q' 'T' 'T'] proto-name, 04 proto-level,
    // 02 connect-flags (clean_session bit), 00 3C keepalive=60, [00 01 'a'] payload client-id.
    let want_connect = [0x10, 0x0d, 0x00, 0x04, 0x4d, 0x51, 0x54, 0x54, 0x04, 0x02, 0x00, 0x3c, 0x00, 0x01, 0x61]
    let got_connect = mqtt_connect("a", 60, 1)
    assert_eq_blist(got_connect, want_connect, "CONNECT(a,60,clean)")

    // Decode round-trip.
    let cd = mqtt_connect_decode(got_connect)
    if len(cd) == 0
        print("FAIL CONNECT decode: empty")
        exit(1)
    if cd["client_id"] != "a"
        print("FAIL CONNECT decode client_id: got " + cd["client_id"])
        exit(1)
    assert_eq_int(cd["keepalive"], 60, "CONNECT decode keepalive")
    assert_eq_int(cd["clean"], 1, "CONNECT decode clean")

    // ── PUBLISH QoS0: topic "a/b", payload "hi" ──────────────────────────────────────────────────────
    // 0x30 (type=3,flags=0 QoS0), remlen=7, [00 03 'a' '/' 'b'] topic, 'h' 'i' payload (no packet-id).
    let want_publish = [0x30, 0x07, 0x00, 0x03, 0x61, 0x2f, 0x62, 0x68, 0x69]
    let payload = [0x68, 0x69]
    let got_publish = mqtt_publish("a/b", payload, 0, 0)
    assert_eq_blist(got_publish, want_publish, "PUBLISH(a/b,hi,qos0)")

    // Decode round-trip via forge_mqtt's re-exported PUBLISH decode (from std/net/mqtt_publish).
    let pd = mqtt_publish_decode(got_publish)
    if len(pd) == 0
        print("FAIL PUBLISH decode: empty")
        exit(1)
    if pd["topic"] != "a/b"
        print("FAIL PUBLISH decode topic: got " + pd["topic"])
        exit(1)
    assert_eq_int(pd["qos"], 0, "PUBLISH decode qos")
    assert_eq_blist(pd["payload"], payload, "PUBLISH decode payload")

    // ── SUBSCRIBE: packet_id=1, filter [("a/b", 0)] ──────────────────────────────────────────────────
    // 0x82 (type=8,flags=2), remlen=8, [00 01] packet-id, [00 03 'a' '/' 'b'] filter, 00 qos.
    let filters = []
    let pair = []
    push(pair, "a/b")
    push(pair, 0)
    push(filters, pair)
    let want_sub = [0x82, 0x08, 0x00, 0x01, 0x00, 0x03, 0x61, 0x2f, 0x62, 0x00]
    let got_sub = mqtt_subscribe(1, filters)
    assert_eq_blist(got_sub, want_sub, "SUBSCRIBE(1,[a/b:0])")

    // ── PINGREQ / DISCONNECT: fixed-header-only packets ──────────────────────────────────────────────
    assert_eq_blist(mqtt_pingreq(), [0xc0, 0x00], "PINGREQ")
    assert_eq_blist(mqtt_disconnect(), [0xe0, 0x00], "DISCONNECT")

    // ── CONNACK decode (server -> client): synthetic wire bytes ─────────────────────────────────────
    // 0x20 (type=2), remlen=2, connack-flags=0x00 (no session present), return-code=0x00 (accepted).
    let connack_ok = [0x20, 0x02, 0x00, 0x00]
    let ca = mqtt_connack_decode(connack_ok)
    if len(ca) == 0
        print("FAIL CONNACK decode: empty")
        exit(1)
    assert_eq_int(ca["session_present"], 0, "CONNACK session_present")
    assert_eq_int(ca["return_code"], 0, "CONNACK return_code")

    let connack_refused = [0x20, 0x02, 0x00, 0x05]
    let car = mqtt_connack_decode(connack_refused)
    assert_eq_int(car["return_code"], 5, "CONNACK refused return_code")

    // ── SUBACK decode (server -> client): packet_id=1, one granted QoS0 filter ───────────────────────
    let suback = [0x90, 0x03, 0x00, 0x01, 0x00]
    let sa = mqtt_suback_decode(suback)
    if len(sa) == 0
        print("FAIL SUBACK decode: empty")
        exit(1)
    assert_eq_int(sa["packet_id"], 1, "SUBACK packet_id")
    assert_eq_blist(sa["return_codes"], [0x00], "SUBACK return_codes")

    // ── PINGRESP decode (server -> client): 0xD0 0x00 ────────────────────────────────────────────────
    assert_eq_int(mqtt_pingresp_decode([0xd0, 0x00]), 1, "PINGRESP valid")
    assert_eq_int(mqtt_pingresp_decode([0x20, 0x00]), 0, "PINGRESP wrong type rejected")

    // ── Malformed-input rejection sanity ─────────────────────────────────────────────────────────────
    assert_eq_int(len(mqtt_connack_decode([0x20])), 0, "CONNACK short input rejected")
    assert_eq_int(len(mqtt_suback_decode([0x90, 0x01, 0x00])), 0, "SUBACK short input rejected")

    print("PASS mqtt_client_codec")
