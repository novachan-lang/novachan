// _padovan_test.nova — KAT for std/math/padovan.nova
import std/math/padovan

// KAT 1: pdv_padovan(0) == 1
let r0 = pdv_padovan(0)
if r0 != 1
    print("FAIL pdv_padovan(0): expected 1 got " + str(r0))
    exit(1)

// KAT 2: pdv_padovan(1) == 1
let r1 = pdv_padovan(1)
if r1 != 1
    print("FAIL pdv_padovan(1): expected 1 got " + str(r1))
    exit(1)

// KAT 3: pdv_padovan(2) == 1
let r2 = pdv_padovan(2)
if r2 != 1
    print("FAIL pdv_padovan(2): expected 1 got " + str(r2))
    exit(1)

// KAT 4: pdv_padovan(3) == 2
let r3 = pdv_padovan(3)
if r3 != 2
    print("FAIL pdv_padovan(3): expected 2 got " + str(r3))
    exit(1)

// KAT 5: pdv_padovan(4) == 2
let r4 = pdv_padovan(4)
if r4 != 2
    print("FAIL pdv_padovan(4): expected 2 got " + str(r4))
    exit(1)

// KAT 6: pdv_padovan(5) == 3
let r5 = pdv_padovan(5)
if r5 != 3
    print("FAIL pdv_padovan(5): expected 3 got " + str(r5))
    exit(1)

// KAT 7: pdv_padovan(6) == 4
let r6 = pdv_padovan(6)
if r6 != 4
    print("FAIL pdv_padovan(6): expected 4 got " + str(r6))
    exit(1)

// KAT 8: pdv_padovan(9) == 9
let r9 = pdv_padovan(9)
if r9 != 9
    print("FAIL pdv_padovan(9): expected 9 got " + str(r9))
    exit(1)

// KAT 9: pdv_list(6) == [1, 1, 1, 2, 2, 3]
let lst = pdv_list(6)
let llen = len(lst)
if llen != 6
    print("FAIL pdv_list(6) len: expected 6 got " + str(llen))
    exit(1)
let l0 = lst[0]
let l1 = lst[1]
let l2 = lst[2]
let l3 = lst[3]
let l4 = lst[4]
let l5 = lst[5]
if l0 != 1
    print("FAIL pdv_list(6)[0]: expected 1 got " + str(l0))
    exit(1)
if l1 != 1
    print("FAIL pdv_list(6)[1]: expected 1 got " + str(l1))
    exit(1)
if l2 != 1
    print("FAIL pdv_list(6)[2]: expected 1 got " + str(l2))
    exit(1)
if l3 != 2
    print("FAIL pdv_list(6)[3]: expected 2 got " + str(l3))
    exit(1)
if l4 != 2
    print("FAIL pdv_list(6)[4]: expected 2 got " + str(l4))
    exit(1)
if l5 != 3
    print("FAIL pdv_list(6)[5]: expected 3 got " + str(l5))
    exit(1)

// KAT 10: pdv_sum(6) == 10  (1+1+1+2+2+3)
let s6 = pdv_sum(6)
if s6 != 10
    print("FAIL pdv_sum(6): expected 10 got " + str(s6))
    exit(1)

// KAT 11: pdv_sum(0) == 0
let s0 = pdv_sum(0)
if s0 != 0
    print("FAIL pdv_sum(0): expected 0 got " + str(s0))
    exit(1)

// KAT 12: pdv_sum(3) == 3  (1+1+1)
let s3 = pdv_sum(3)
if s3 != 3
    print("FAIL pdv_sum(3): expected 3 got " + str(s3))
    exit(1)

// KAT 13: pdv_list(0) == []
let lst0 = pdv_list(0)
let llen0 = len(lst0)
if llen0 != 0
    print("FAIL pdv_list(0) len: expected 0 got " + str(llen0))
    exit(1)

// KAT 14: pdv_padovan(9) cross-check via pdv_list
let lst10 = pdv_list(10)
let l9 = lst10[9]
if l9 != 9
    print("FAIL pdv_list(10)[9]: expected 9 got " + str(l9))
    exit(1)

print("_padovan_test passed")
