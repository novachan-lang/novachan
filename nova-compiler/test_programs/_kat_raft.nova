import forge_raft

fn main()
    // 3-node cluster: n1, n2, n3
    let s1 = raft_new("n1", ["n2", "n3"])
    let s2 = raft_new("n2", ["n1", "n3"])
    let s3 = raft_new("n3", ["n1", "n2"])

    assert(s3["role"] == "follower", "n3 initial role follower")
    assert(s1["role"] == "follower", "initial role follower")
    assert(s1["term"] == 0, "initial term 0")

    // n1 times out -> becomes candidate, term 1
    let r1 = raft_timeout(s1)
    s1 = r1["state"]
    let msgs = r1["messages"]
    assert(s1["role"] == "candidate", "after timeout: candidate")
    assert(s1["term"] == 1, "after timeout: term 1")
    assert(len(msgs) == 2, "sends 2 vote requests")
    assert(msgs[0]["type"] == "vote_request", "msg type vote_request")

    // n2 receives vote request -> grants
    let r2 = raft_receive_vote_request(s2, msgs[0])
    s2 = r2["state"]
    let resp = r2["messages"]
    assert(len(resp) == 1, "1 vote response")
    assert(resp[0]["granted"] == 1, "vote granted")
    assert(s2["voted_for"] == "n1", "n2 voted for n1")

    // n1 receives the vote -> has 2 votes (self + n2) = majority of 3 -> becomes leader
    let r3 = raft_receive_vote_response(s1, resp[0])
    s1 = r3["state"]
    assert(s1["role"] == "leader", "n1 is leader with majority")

    // leader appends a command
    let r4 = raft_client_request(s1, "SET x=1")
    s1 = r4["state"]
    let app_msgs = r4["messages"]
    assert(len(s1["log"]) == 1, "leader log has 1 entry")
    assert(s1["log"][0]["command"] == "SET x=1", "log entry command")
    assert(len(app_msgs) == 2, "sends append_entries to 2 peers")
    assert(app_msgs[0]["type"] == "append_entries", "msg type append_entries")
    assert(len(app_msgs[0]["entries"]) == 1, "1 entry in append msg")

    // n2 receives append_entries
    let r5 = raft_receive_append(s2, app_msgs[0])
    s2 = r5["state"]
    let aresp = r5["messages"]
    assert(aresp[0]["success"] == 1, "append success")
    assert(len(s2["log"]) == 1, "n2 replicated the entry")

    // leader receives append response -> commit_index advances (2 of 3 have the entry)
    let r6 = raft_receive_append_response(s1, aresp[0])
    s1 = r6["state"]
    assert(s1["commit_index"] == 1, "commit_index 1 after majority replication")

    let committed = raft_committed_entries(s1)
    assert(len(committed) == 1, "1 committed entry")
    assert(committed[0]["command"] == "SET x=1", "committed command")

    // log entry helper
    let e = raft_log_entry(5, "DEL y")
    assert(e["term"] == 5, "log_entry term")
    assert(e["command"] == "DEL y", "log_entry command")

    print("FORGE-RAFT KAT PASS")
