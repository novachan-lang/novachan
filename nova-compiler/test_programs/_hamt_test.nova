// Canonical KAT test for forge_hamt (persistent HAMT map). Verified: real trie (maxdepth 3-4 at scale),
// path-copy persistence, ASAN-clean.
import std/collections/hamt

fn main()
    let a = hamt_set(hamt_set(hamt_new(), "x", 1), "y", 2)
    let b = hamt_set(a, "x", 99)
    // persistence: deriving b must NOT mutate a
    if hamt_get(a, "x") != 1
        print("FAIL persistence: a['x'] changed")
        exit(1)
    if hamt_get(b, "x") != 99
        print("FAIL b['x']")
        exit(1)
    if hamt_get(b, "y") != 2
        print("FAIL b['y']")
        exit(1)
    if hamt_len(b) != 2
        print("FAIL len")
        exit(1)
    // delete + del-persistence
    let c = hamt_del(b, "x")
    if hamt_get(c, "x") != null
        print("FAIL del")
        exit(1)
    if hamt_len(c) != 1
        print("FAIL del len")
        exit(1)
    if hamt_get(b, "x") != 99
        print("FAIL del mutated source")
        exit(1)
    // scale: 200 distinct keys read back, exercising trie branching
    let m = hamt_new()
    let i = 0
    while i < 200
        m = hamt_set(m, "k" + str(i), i * 10)
        i = i + 1
    if hamt_len(m) != 200
        print("FAIL scale len: " + str(hamt_len(m)))
        exit(1)
    i = 0
    while i < 200
        if hamt_get(m, "k" + str(i)) != i * 10
            print("FAIL scale readback k" + str(i))
            exit(1)
        i = i + 1
    print("ok persistence + del + scale(200)")
    print("_hamt_test passed")
