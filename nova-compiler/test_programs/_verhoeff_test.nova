import std/util/verhoeff

// ── check helpers ─────────────────────────────────────────────────────────────

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label: str, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got " + gs + " want " + ws)
        exit(1)

fn main()
    // ── Verhoeff KAT (from spec) ──────────────────────────────────────────────
    // Spec: vh_checksum("236")==3
    cki("vh_cs_236",   vh_checksum("236"),   3)
    // Spec: vh_validate("2363")==true
    ckb("vh_val_2363", vh_validate("2363"),  true)
    // Spec: vh_validate("2364")==false
    ckb("vh_val_2364", vh_validate("2364"),  false)
    // Spec: vh_checksum("12345")==1
    cki("vh_cs_12345", vh_checksum("12345"), 1)
    // Spec: vh_validate("123451")==true
    ckb("vh_val_123451", vh_validate("123451"), true)

    // ── Verhoeff extra coverage ───────────────────────────────────────────────
    // Single digit "0" -> check digit is inv[c] after processing; known result.
    // Internally: c=0, process '0' at pos 2%8=2: p[2][0]=5; d[5][0]=5; inv[5]=9
    cki("vh_cs_0",  vh_checksum("0"), 9)
    // Single digit "9" -> process at i=0, pos=0, prow=(0+2)%8=2, p[2][9]=2; d[2][0]=2; inv[2]=3
    cki("vh_cs_9",  vh_checksum("9"), 3)
    // Validate "09" (body="0", check=9): vh_checksum("0")==9 -> vh_validate("09")==true
    ckb("vh_val_09", vh_validate("09"), true)
    // Validate "08": check digit should be 9, not 8 -> false
    ckb("vh_val_08", vh_validate("08"), false)
    // Empty string: false (length < 2)
    ckb("vh_val_empty", vh_validate(""), false)
    // Single char: false (no body)
    ckb("vh_val_single", vh_validate("3"), false)
    // Validate the computed check digit of "12345" appended correctly
    ckb("vh_val_123451_round", vh_validate("123451"), true)
    // Wrong check digit on "12345X" where X != 1
    ckb("vh_val_123450", vh_validate("123450"), false)
    ckb("vh_val_123452", vh_validate("123452"), false)

    // ── Damm KAT (from spec) ──────────────────────────────────────────────────
    // Spec: damm_checksum("572")==4
    cki("damm_cs_572",   damm_checksum("572"),  4)
    // Spec: damm_validate("5724")==true
    ckb("damm_val_5724", damm_validate("5724"), true)
    // Spec: damm_validate("5720")==false
    ckb("damm_val_5720", damm_validate("5720"), false)

    // ── Damm extra coverage ───────────────────────────────────────────────────
    // Single digit "0": table[0][0]=0 -> check digit = 0
    cki("damm_cs_0", damm_checksum("0"), 0)
    // Validate "00": table[0][0]=0, table[0][0]=0 -> 0 -> true
    ckb("damm_val_00", damm_validate("00"), true)
    // Validate "01": table[0][0]=0 for body "0", check=0; but "01" processes
    // table[0][0]=0, table[0][1]=3 -> 3 != 0 -> false
    ckb("damm_val_01", damm_validate("01"), false)
    // Empty: false
    ckb("damm_val_empty", damm_validate(""), false)
    // Roundtrip: append checksum of "123" to validate
    let cs123 = damm_checksum("123")
    let full = "123" + str(cs123)
    ckb("damm_roundtrip_123", damm_validate(full), true)
    // Transposition detection: "5724" is valid but "5274" should NOT be
    ckb("damm_transpose_5274", damm_validate("5274"), false)

    print("_verhoeff_test passed")
