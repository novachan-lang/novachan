import forge_ipcidr

fn main()
    // ip_to_int
    assert(ip_to_int("0.0.0.0") == 0, "zero ip")
    assert(ip_to_int("0.0.0.1") == 1, "one ip")
    assert(ip_to_int("0.0.1.0") == 256, "256 ip")
    assert(ip_to_int("192.168.1.1") == 3232235777, "private ip")
    assert(ip_to_int("255.255.255.255") == 4294967295, "broadcast")

    // Malformed
    assert(ip_to_int("1.2.3") == -1, "too few octets")
    assert(ip_to_int("1.2.3.4.5") == -1, "too many octets")
    assert(ip_to_int("1.2.3.256") == -1, "octet > 255")
    assert(ip_to_int("1.2.3.abc") == -1, "non-digit")

    // cidr_contains
    assert(cidr_contains("192.168.1.0/24", "192.168.1.100"), "in /24")
    assert(cidr_contains("192.168.1.0/24", "192.168.1.255"), "broadcast in /24")
    assert(not cidr_contains("192.168.1.0/24", "192.168.2.1"), "outside /24")
    assert(cidr_contains("10.0.0.0/8", "10.255.255.255"), "in /8")
    assert(not cidr_contains("10.0.0.0/8", "11.0.0.1"), "outside /8")
    assert(cidr_contains("0.0.0.0/0", "1.2.3.4"), "/0 matches all")

    // ip_in_any
    let cidrs = ["192.168.0.0/16", "10.0.0.0/8"]
    assert(ip_in_any(cidrs, "192.168.1.1"), "in first cidr")
    assert(ip_in_any(cidrs, "10.0.0.1"), "in second cidr")
    assert(not ip_in_any(cidrs, "8.8.8.8"), "in neither cidr")

    print("IPCIDR KAT PASS")
