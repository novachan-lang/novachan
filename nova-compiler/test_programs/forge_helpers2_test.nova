// functional: REST status helpers + RFC 9457 problem+json + cursor pagination + deadline propagation
import forge

fn main()
    let c = forge.resp_created("/x", "b")
    if c.status != 201
        print("FAIL created " + str(c.status))
        exit(1)
    let a = forge.resp_accepted("b")
    if a.status != 202
        print("FAIL accepted")
        exit(1)
    let nc = forge.resp_no_content()
    if nc.status != 204
        print("FAIL no_content")
        exit(1)
    let pr = forge.problem(404, "missing")
    if pr.status != 404
        print("FAIL problem")
        exit(1)
    if forge.cursor_decode(forge.cursor_encode("k123")) != "k123"
        print("FAIL cursor round-trip = " + forge.cursor_decode(forge.cursor_encode("k123")))
        exit(1)
    let dl = forge.deadline_in(1000)
    if forge.deadline_exceeded(dl) != false
        print("FAIL deadline should not be exceeded")
        exit(1)
    if forge.deadline_remaining(dl) <= 0
        print("FAIL deadline remaining should be positive")
        exit(1)
    let past = forge.deadline_in(0 - 100)
    if forge.deadline_exceeded(past) != true
        print("FAIL past deadline should be exceeded")
        exit(1)
    print("PASS forge_helpers2")
