// Bootstrap test 23: string escape sequences
// Critical for LLVM IR emission in the compiler

// Newline
let msg = "line1\nline2"
print(msg)

// Tab
let row = "col1\tcol2"
print(row)

// Backslash
let path = "C:\\Users\\test"
print(path)

// Combined
let code = "fn main() \{\n\treturn 0;\n\}"
print(code)

// Empty string
let empty = ""
print(len(empty))
