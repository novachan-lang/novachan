import std/physics/fluid_dynamics

fn approx(a, b)
    let d = a - b
    let ad = 0.0
    if d < 0.0
        ad = 0.0 - d
    else
        ad = d
    let result = false
    if ad < 0.0001
        result = true
    result

fn main()
    // continuity_v2(2.0, 3.0, 1.0) = 2*3/1 = 6.0
    let v1 = continuity_v2(2.0, 3.0, 1.0)
    if approx(v1, 6.0)
        print("continuity_v2 OK: " + str(v1))
    else
        print("FAIL fluid_dynamics continuity_v2: got " + str(v1) + " expected 6.0")
        exit(1)

    // flow_rate(2.0, 3.0) = 6.0
    let v2 = flow_rate(2.0, 3.0)
    if approx(v2, 6.0)
        print("flow_rate OK: " + str(v2))
    else
        print("FAIL fluid_dynamics flow_rate: got " + str(v2) + " expected 6.0")
        exit(1)

    // dynamic_pressure(1000.0, 2.0) = 0.5 * 1000 * 4 = 2000.0
    let v3 = dynamic_pressure(1000.0, 2.0)
    if approx(v3, 2000.0)
        print("dynamic_pressure OK: " + str(v3))
    else
        print("FAIL fluid_dynamics dynamic_pressure: got " + str(v3) + " expected 2000.0")
        exit(1)

    // reynolds(1000.0, 2.0, 0.01, 0.001) = 1000*2*0.01/0.001 = 20000.0
    let v4 = reynolds(1000.0, 2.0, 0.01, 0.001)
    if approx(v4, 20000.0)
        print("reynolds OK: " + str(v4))
    else
        print("FAIL fluid_dynamics reynolds: got " + str(v4) + " expected 20000.0")
        exit(1)

    print("PASS _fluid_dynamics_test")
