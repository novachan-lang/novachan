import std/core/str

fn main()
    // str_reverse — normal, single, empty, palindrome, spaces
    print("[" + str_reverse("hello") + "]")
    print("[" + str_reverse("a") + "]")
    print("[" + str_reverse("") + "]")
    print("[" + str_reverse("aba") + "]")
    print("[" + str_reverse("a b c") + "]")

    // str_repeat — normal, 1, 0, negative, empty string, multi-char
    print("[" + str_repeat("ab", 3) + "]")
    print("[" + str_repeat("ab", 1) + "]")
    print("[" + str_repeat("ab", 0) + "]")
    print("[" + str_repeat("ab", 0 - 2) + "]")
    print("[" + str_repeat("", 5) + "]")
    print("[" + str_repeat("xyz", 4) + "]")

    // str_pad_left — the OVERSHOOT cases matter most
    print("[" + str_pad_left("x", 5, " ") + "]")
    print("[" + str_pad_left("x", 4, "ab") + "]")
    print("[" + str_pad_left("x", 5, "ab") + "]")
    print("[" + str_pad_left("x", 7, "ab") + "]")
    print("[" + str_pad_left("xy", 4, "abc") + "]")
    print("[" + str_pad_left("hello", 3, " ") + "]")
    print("[" + str_pad_left("hello", 5, " ") + "]")
    print("[" + str_pad_left("x", 5, "") + "]")
    print("[" + str_pad_left("", 3, "-") + "]")
    print("[" + str_pad_left("x", 0, "-") + "]")
    print("[" + str_pad_left("x", 0 - 4, "-") + "]")

    // str_pad_right — same grid
    print("[" + str_pad_right("x", 5, " ") + "]")
    print("[" + str_pad_right("x", 4, "ab") + "]")
    print("[" + str_pad_right("x", 5, "ab") + "]")
    print("[" + str_pad_right("x", 7, "ab") + "]")
    print("[" + str_pad_right("xy", 4, "abc") + "]")
    print("[" + str_pad_right("hello", 3, " ") + "]")
    print("[" + str_pad_right("hello", 5, " ") + "]")
    print("[" + str_pad_right("x", 5, "") + "]")
    print("[" + str_pad_right("", 3, "-") + "]")
    print("[" + str_pad_right("x", 0, "-") + "]")

    // str_count — non-overlapping, adjacent, longer-than-haystack, empty
    print(str_count("aaa", "a"))
    print(str_count("aaa", "aa"))
    print(str_count("aaaa", "aa"))
    print(str_count("banana", "na"))
    print(str_count("banana", "ana"))
    print(str_count("abc", "abcd"))
    print(str_count("abc", ""))
    print(str_count("", "a"))
    print(str_count("xyxyxy", "xy"))

    // str_char_at — in range, first, last, negative, past end, empty
    print("[" + str_char_at("abc", 1) + "]")
    print("[" + str_char_at("abc", 0) + "]")
    print("[" + str_char_at("abc", 2) + "]")
    print("[" + str_char_at("abc", 0 - 1) + "]")
    print("[" + str_char_at("abc", 3) + "]")
    print("[" + str_char_at("", 0) + "]")

    print("EXERCISE-DONE")
