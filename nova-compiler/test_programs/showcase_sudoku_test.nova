// showcase_sudoku -- a backtracking Sudoku solver in pure NOVA. A FOURTH subsystem mix: deep
// RECURSION, integer arrays (a flat 81-cell grid), in-place integer mutation, and nested-loop
// constraint checking -- a control-flow profile distinct from the HTTP app, the string/dict CLI, and
// the float numeric tool. Integer list index-set (not heap-string) so it also validates that the
// solid integer path is unaffected by the string-aliasing RC gap (0.10). Self-verifying against the
// known solution of a standard puzzle.

// first empty cell (value 0), or -1 if the grid is full.
fn find_empty(grid: list) -> int
    let i = 0
    while i < 81
        if grid[i] == 0
            return i
        i = i + 1
    return -1

// can digit n go at flat index idx without violating row/col/3x3-box?
fn is_valid(grid: list, idx: int, n: int) -> int
    let row = idx / 9
    let col = idx - row * 9
    // row + column
    let k = 0
    while k < 9
        if grid[row * 9 + k] == n
            return 0
        if grid[k * 9 + col] == n
            return 0
        k = k + 1
    // 3x3 box
    let br = (row / 3) * 3
    let bc = (col / 3) * 3
    let dr = 0
    while dr < 3
        let dc = 0
        while dc < 3
            if grid[(br + dr) * 9 + (bc + dc)] == n
                return 0
            dc = dc + 1
        dr = dr + 1
    return 1

// backtracking solve; mutates grid in place; returns 1 if solved.
fn solve(grid: list) -> int
    let idx = find_empty(grid)
    if idx < 0
        return 1
    let n = 1
    while n <= 9
        if is_valid(grid, idx, n) == 1
            grid[idx] = n
            if solve(grid) == 1
                return 1
            grid[idx] = 0
        n = n + 1
    return 0

// parse an 81-char digit string into a flat int grid.
fn parse_grid(s: string) -> list
    let g = []
    let i = 0
    while i < 81
        push(g, parse_int(slice(s, i, i + 1)))
        i = i + 1
    return g

fn main()
    let puzzle   = "530070000600195000098000060800060003400803001700020006060000280000419005000080079"
    let solution = "534678912672195348198342567859761423426853791713924856961537284287419635345286179"
    let grid = parse_grid(puzzle)

    let empties = 0
    let c = 0
    while c < 81
        if grid[c] == 0
            empties = empties + 1
        c = c + 1
    print("Sudoku: " + str(empties) + " blanks to fill")

    let ok = solve(grid)
    assert(ok == 1, "puzzle is solvable")

    // print the solved grid as 9 rows
    print("=== solved ===")
    let r = 0
    while r < 9
        let line = ""
        let cc = 0
        while cc < 9
            line = line + str(grid[r * 9 + cc])
            if cc < 8
                line = line + " "
            cc = cc + 1
        print(line)
        r = r + 1

    // verify against the known solution
    let expect = parse_grid(solution)
    let mism = 0
    let i = 0
    while i < 81
        if grid[i] != expect[i]
            mism = mism + 1
        i = i + 1
    assert(mism == 0, "solution matches the known answer")

    // independently verify every row, column, and box is a permutation of 1..9
    let bad = 0
    let u = 0
    while u < 9
        let rowseen = 0
        let colseen = 0
        let v = 0
        while v < 9
            let rv = grid[u * 9 + v]
            let cv = grid[v * 9 + u]
            rowseen = rowseen + rv
            colseen = colseen + cv
            v = v + 1
        if rowseen != 45
            bad = bad + 1
        if colseen != 45
            bad = bad + 1
        u = u + 1
    assert(bad == 0, "every row and column sums to 45 (1..9)")

    print("showcase_sudoku_test passed -- backtracking solver, recursion + integer grid, pure NOVA")
