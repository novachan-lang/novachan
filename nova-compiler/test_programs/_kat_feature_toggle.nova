import forge_feature_toggle

fn main()
    let ft = ft_new()
    ft = ft_add_flag(ft, "dark_mode", 1)
    ft = ft_add_flag(ft, "beta_ui", 0)
    ft = ft_add_flag(ft, "new_checkout", 1)

    assert(ft_flag_count(ft) == 3, "3 flags")

    assert(ft_is_enabled(ft, "dark_mode") == 1, "dark_mode on")
    assert(ft_is_enabled(ft, "beta_ui") == 0, "beta_ui off")
    assert(ft_is_enabled(ft, "new_checkout") == 1, "new_checkout on")
    assert(ft_is_enabled(ft, "nonexistent") == 0, "missing=off")

    ft = ft_disable(ft, "dark_mode")
    assert(ft_is_enabled(ft, "dark_mode") == 0, "dark_mode disabled")
    ft = ft_enable(ft, "dark_mode")
    assert(ft_is_enabled(ft, "dark_mode") == 1, "dark_mode re-enabled")

    ft = ft_add_override(ft, "beta_ui", "user42", 1)
    assert(ft_is_enabled_for(ft, "beta_ui", "user42") == 0, "beta_ui globally off so override inactive")

    ft = ft_enable(ft, "beta_ui")
    assert(ft_is_enabled_for(ft, "beta_ui", "user42") == 1, "user42 override active")
    assert(ft_is_enabled_for(ft, "beta_ui", "user99") == 1, "user99 default=enabled")

    ft = ft_add_override(ft, "beta_ui", "user99", 0)
    assert(ft_is_enabled_for(ft, "beta_ui", "user99") == 0, "user99 disabled by override")

    ft = ft_set_rollout(ft, "new_checkout", 50)
    let info = ft_flag_info(ft, "new_checkout")
    assert(info["rollout"] == 50, "rollout=50")
    assert(info["enabled"] == 1, "still enabled")

    ft = ft_set_description(ft, "dark_mode", "Toggle dark theme")
    let dm = ft_flag_info(ft, "dark_mode")
    assert(dm["description"] == "Toggle dark theme", "description set")

    let flags = ft_list_flags(ft)
    assert(len(flags) == 3, "3 flags listed")

    let missing = ft_flag_info(ft, "nope")
    assert(missing["name"] == "", "missing flag empty")

    print("FEATURE-TOGGLE KAT PASS")
