// KAT for std/data/dataframe.nova expansion: df_group_by, df_merge,
// df_pivot, df_apply, df_rename, df_drop, df_unique, df_value_counts,
// df_fillna, df_shape.
import std/data/dataframe

fn assert_eq_int(actual: int, expected: int, label: string)
    if actual != expected
        panic(label + ": expected " + str(expected) + " got " + str(actual))
    0

fn main()
    // ---- fixture: orders(id, region, amount) ----
    let orders = df_new(["id", "region", "amount"], [
        [1, "east", 100],
        [2, "west", 200],
        [3, "east", 300],
        [4, "west", 400],
        [5, "east", 0]
    ])

    // ---- df_group_by: 3 groups? region only has east/west -> 2 groups.
    // Use a 3-way column instead to match "3 groups" requirement.
    let sales = df_new(["id", "region", "amount"], [
        [1, "east", 100],
        [2, "west", 200],
        [3, "north", 300],
        [4, "east", 400],
        [5, "west", 500],
        [6, "north", 600]
    ])
    let groups = df_group_by(sales, "region")
    assert_eq_int(len(groups), 3, "group_by count")
    let g0 = groups[0]
    let g0_rows: DataFrame = g0["rows"]
    assert_eq_int(g0_rows.nrows, 2, "group_by east rows")
    let east_amounts = g0_rows["amount"]
    assert_eq_int(east_amounts[0] + east_amounts[1], 500, "group_by east sum")

    // ---- df_merge: inner join orders with a regions lookup on 'region' ----
    let region_info = df_new(["region", "manager"], [
        ["east", "Alice"],
        ["west", "Bob"]
    ])
    let merged: DataFrame = df_merge(orders, region_info, "region")
    // orders has 4 east/west rows (id 1,2,3,4) that match + 1 'east' with amount 0 = 4 east/west total... recompute
    // orders regions: east(1),west(2),east(3),west(4),east(5) -> all 5 match (east/west both present)
    assert_eq_int(merged.nrows, 5, "merge row count")
    assert_eq_int(len(merged.colnames), 4, "merge col count")
    let managers = merged["manager"]
    assert_eq_int(managers[0] == "Alice", 1, "merge manager lookup")

    // ---- df_pivot: index=region, pivot=id, value=amount ----
    let piv = df_pivot(sales, "region", "id", "amount")
    assert_eq_int(contains(piv, "east"), 1, "pivot has east")
    let east_cell = piv["east"]["1"]
    assert_eq_int(east_cell, 100, "pivot east/1 value")

    // ---- df_apply: double the amount column ----
    let doubled: DataFrame = df_apply(sales, "amount", fn(v) v * 2)
    let damounts = doubled["amount"]
    assert_eq_int(damounts[0], 200, "apply doubled[0]")
    assert_eq_int(damounts[5], 1200, "apply doubled[5]")
    assert_eq_int(sales["amount"][0], 100, "apply source untouched")

    // ---- df_rename ----
    let renamed: DataFrame = df_rename(sales, "amount", "total")
    assert_eq_int(df_has_col(renamed, "total"), 1, "rename has new name")
    assert_eq_int(df_has_col(renamed, "amount"), 0, "rename lost old name")
    assert_eq_int(renamed["total"][0], 100, "rename data preserved")

    // ---- df_drop ----
    let dropped: DataFrame = df_drop(sales, "id")
    assert_eq_int(len(dropped.colnames), 2, "drop col count")
    assert_eq_int(df_has_col(dropped, "id"), 0, "drop removed id")
    assert_eq_int(df_has_col(sales, "id"), 1, "drop source untouched")

    // ---- df_unique ----
    let uniq = df_unique(sales, "region")
    assert_eq_int(len(uniq), 3, "unique count")

    // ---- df_value_counts ----
    let vc = df_value_counts(sales, "region")
    assert_eq_int(vc["east"], 2, "value_counts east")
    assert_eq_int(vc["west"], 2, "value_counts west")
    assert_eq_int(vc["north"], 2, "value_counts north")

    // ---- df_fillna: orders has amount=0 at id=5 (index 4) ----
    let filled: DataFrame = df_fillna(orders, "amount", 999)
    let famounts = filled["amount"]
    assert_eq_int(famounts[4], 999, "fillna replaced zero")
    assert_eq_int(famounts[0], 100, "fillna left nonzero alone")
    assert_eq_int(orders["amount"][4], 0, "fillna source untouched")

    // ---- df_shape ----
    let shp = df_shape(sales)
    assert_eq_int(shp[0], 6, "shape rows")
    assert_eq_int(shp[1], 3, "shape cols")

    print("DATAFRAME-EXPAND KAT PASS")
    0
