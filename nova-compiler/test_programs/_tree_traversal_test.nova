import std/tree/tree_traversal

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(label, got, want)
    if len(got) != len(want)
        print("FAIL " + label + " (len): got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // =========================================================================
    // Standard T5: adj=[[1,2],[0,3,4],[0],[1],[1]] n=5 root=0
    // Edges: 0-1, 0-2, 1-3, 1-4
    // =========================================================================
    let adj5 = []
    let r0 = []
    push(r0, 1)
    push(r0, 2)
    push(adj5, r0)
    let r1 = []
    push(r1, 0)
    push(r1, 3)
    push(r1, 4)
    push(adj5, r1)
    let r2 = []
    push(r2, 0)
    push(adj5, r2)
    let r3 = []
    push(r3, 1)
    push(adj5, r3)
    let r4 = []
    push(r4, 1)
    push(adj5, r4)

    // tt_preorder(T5,5,0) = [0,1,3,4,2]
    let pre5 = tt_preorder(adj5, 5, 0)
    let want_pre5 = []
    push(want_pre5, 0)
    push(want_pre5, 1)
    push(want_pre5, 3)
    push(want_pre5, 4)
    push(want_pre5, 2)
    ckl("preorder_T5", pre5, want_pre5)

    // tt_postorder(T5,5,0) = [3,4,1,2,0]
    let post5 = tt_postorder(adj5, 5, 0)
    let want_post5 = []
    push(want_post5, 3)
    push(want_post5, 4)
    push(want_post5, 1)
    push(want_post5, 2)
    push(want_post5, 0)
    ckl("postorder_T5", post5, want_post5)

    // tt_bfs_order(T5,5,0) = [0,1,2,3,4]
    let bfs5 = tt_bfs_order(adj5, 5, 0)
    let want_bfs5 = []
    push(want_bfs5, 0)
    push(want_bfs5, 1)
    push(want_bfs5, 2)
    push(want_bfs5, 3)
    push(want_bfs5, 4)
    ckl("bfs_order_T5", bfs5, want_bfs5)

    // tt_euler_tour(T5,5,0) = [0,1,3,1,4,1,0,2,0] (length 2*5-1=9)
    let euler5 = tt_euler_tour(adj5, 5, 0)
    let want_euler5 = []
    push(want_euler5, 0)
    push(want_euler5, 1)
    push(want_euler5, 3)
    push(want_euler5, 1)
    push(want_euler5, 4)
    push(want_euler5, 1)
    push(want_euler5, 0)
    push(want_euler5, 2)
    push(want_euler5, 0)
    ckl("euler_tour_T5", euler5, want_euler5)
    cki("euler_tour_T5_len", len(euler5), 9)

    // =========================================================================
    // Edge case: 2-node path [[1],[0]] n=2 root=0
    // =========================================================================
    let adj2 = []
    let n2a = []
    push(n2a, 1)
    push(adj2, n2a)
    let n2b = []
    push(n2b, 0)
    push(adj2, n2b)

    // tt_preorder([[1],[0]],2,0) = [0,1]
    let pre2 = tt_preorder(adj2, 2, 0)
    let want_pre2 = []
    push(want_pre2, 0)
    push(want_pre2, 1)
    ckl("preorder_2node", pre2, want_pre2)

    // tt_postorder([[1],[0]],2,0) = [1,0]
    let post2 = tt_postorder(adj2, 2, 0)
    let want_post2 = []
    push(want_post2, 1)
    push(want_post2, 0)
    ckl("postorder_2node", post2, want_post2)

    // tt_bfs_order([[1],[0]],2,0) = [0,1]
    let bfs2 = tt_bfs_order(adj2, 2, 0)
    let want_bfs2 = []
    push(want_bfs2, 0)
    push(want_bfs2, 1)
    ckl("bfs_2node", bfs2, want_bfs2)

    // tt_euler_tour([[1],[0]],2,0) = [0,1,0] length=3=2*2-1
    let euler2 = tt_euler_tour(adj2, 2, 0)
    let want_euler2 = []
    push(want_euler2, 0)
    push(want_euler2, 1)
    push(want_euler2, 0)
    ckl("euler_2node", euler2, want_euler2)

    // =========================================================================
    // Edge case: single node n=1 adj=[[]]
    // =========================================================================
    let adj1 = []
    let n1a = []
    push(adj1, n1a)

    let pre1 = tt_preorder(adj1, 1, 0)
    cki("preorder_1node_len", len(pre1), 1)
    cki("preorder_1node_0", pre1[0], 0)

    let post1 = tt_postorder(adj1, 1, 0)
    cki("postorder_1node_len", len(post1), 1)
    cki("postorder_1node_0", post1[0], 0)

    let bfs1 = tt_bfs_order(adj1, 1, 0)
    cki("bfs_1node_len", len(bfs1), 1)
    cki("bfs_1node_0", bfs1[0], 0)

    let euler1 = tt_euler_tour(adj1, 1, 0)
    cki("euler_1node_len", len(euler1), 1)
    cki("euler_1node_0", euler1[0], 0)

    // =========================================================================
    // Star: [[1,2,3],[0],[0],[0]] n=4 root=0
    // preorder: 0,1,2,3; postorder: 1,2,3,0; bfs: 0,1,2,3
    // euler: [0,1,0,2,0,3,0] len=7=2*4-1
    // =========================================================================
    let adj_star = []
    let sc = []
    push(sc, 1)
    push(sc, 2)
    push(sc, 3)
    push(adj_star, sc)
    let s1 = []
    push(s1, 0)
    push(adj_star, s1)
    let s2 = []
    push(s2, 0)
    push(adj_star, s2)
    let s3 = []
    push(s3, 0)
    push(adj_star, s3)

    let pre_star = tt_preorder(adj_star, 4, 0)
    let want_pre_star = []
    push(want_pre_star, 0)
    push(want_pre_star, 1)
    push(want_pre_star, 2)
    push(want_pre_star, 3)
    ckl("preorder_star", pre_star, want_pre_star)

    let post_star = tt_postorder(adj_star, 4, 0)
    let want_post_star = []
    push(want_post_star, 1)
    push(want_post_star, 2)
    push(want_post_star, 3)
    push(want_post_star, 0)
    ckl("postorder_star", post_star, want_post_star)

    let bfs_star = tt_bfs_order(adj_star, 4, 0)
    let want_bfs_star = []
    push(want_bfs_star, 0)
    push(want_bfs_star, 1)
    push(want_bfs_star, 2)
    push(want_bfs_star, 3)
    ckl("bfs_star", bfs_star, want_bfs_star)

    let euler_star = tt_euler_tour(adj_star, 4, 0)
    let want_euler_star = []
    push(want_euler_star, 0)
    push(want_euler_star, 1)
    push(want_euler_star, 0)
    push(want_euler_star, 2)
    push(want_euler_star, 0)
    push(want_euler_star, 3)
    push(want_euler_star, 0)
    ckl("euler_star", euler_star, want_euler_star)
    cki("euler_star_len", len(euler_star), 7)

    print("PASS _tree_traversal_test")

main()
