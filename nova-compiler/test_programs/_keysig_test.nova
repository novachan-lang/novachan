// _keysig_test.nova — KAT for std/music/keysig
//
// Known-answer tests for key signature utilities.
//
// HAND-VERIFIED VECTORS
//   Circle of fifths (sharps):  C(0) G(1) D(2) A(3) E(4) B(5) F#(6) C#(7)
//   Circle of fourths (flats):  F(-1) Bb(-2) Eb(-3) Ab(-4) Db(-5) Gb(-6) Cb(-7)
//
//   Sharps order: F# C# G# D# A# E# B#
//   Flats  order: Bb Eb Ab Db Gb Cb Fb
//
//   D major has 2 sharps: F# and C#
//   Bb major has 2 flats: Bb and Eb
//
//   relative_minor("C")  = "Am"   (root 3 semitones below C)
//   relative_minor("G")  = "Em"
//   relative_major("Am") = "C"
//   relative_major("Em") = "G"
//   parallel_minor("C")  = "Cm"

import std/music/keysig

// ── check helpers ─────────────────────────────────────────────────────────────

fn cki(label, got, want)
    if got != want
        print("FAIL keysig " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL keysig " + label + ": got=" + got + " want=" + want)
        exit(1)

// _list_contains(lst, val) -> int
//   Returns 1 if lst contains val, 0 otherwise.
fn _list_contains(lst, val)
    let found = 0
    let i = 0
    while i < len(lst)
        if lst[i] == val
            found = 1
        i = i + 1
    found

fn ckcontains(label, lst, val)
    if _list_contains(lst, val) == 0
        print("FAIL keysig " + label + ": list does not contain " + val)
        exit(1)

fn cknot_contains(label, lst, val)
    if _list_contains(lst, val) == 1
        print("FAIL keysig " + label + ": list should NOT contain " + val)
        exit(1)

// ── main ─────────────────────────────────────────────────────────────────────

fn main()
    // ── key_sharps: core KAT vectors ─────────────────────────────────────────
    cki("key_sharps(C)",  key_sharps("C"),  0)
    cki("key_sharps(G)",  key_sharps("G"),  1)
    cki("key_sharps(D)",  key_sharps("D"),  2)
    cki("key_sharps(A)",  key_sharps("A"),  3)
    cki("key_sharps(E)",  key_sharps("E"),  4)
    cki("key_sharps(B)",  key_sharps("B"),  5)
    cki("key_sharps(F#)", key_sharps("F#"), 6)
    cki("key_sharps(C#)", key_sharps("C#"), 7)
    cki("key_sharps(F)",  key_sharps("F"),  -1)
    cki("key_sharps(Bb)", key_sharps("Bb"), -2)
    cki("key_sharps(Eb)", key_sharps("Eb"), -3)
    cki("key_sharps(Ab)", key_sharps("Ab"), -4)
    cki("key_sharps(Db)", key_sharps("Db"), -5)
    cki("key_sharps(Gb)", key_sharps("Gb"), -6)
    cki("key_sharps(Cb)", key_sharps("Cb"), -7)

    // unknown key
    cki("key_sharps(X)",  key_sharps("X"),  -99)

    // ── key_accidentals: C major has no accidentals ───────────────────────────
    let c_acc = key_accidentals("C")
    cki("key_accidentals(C) len", len(c_acc), 0)

    // G major has 1 sharp: F#
    let g_acc = key_accidentals("G")
    cki("key_accidentals(G) len", len(g_acc), 1)
    ckcontains("key_accidentals(G) has F#", g_acc, "F#")

    // D major has 2 sharps: F# and C#
    let d_acc = key_accidentals("D")
    cki("key_accidentals(D) len", len(d_acc), 2)
    ckcontains("key_accidentals(D) has F#", d_acc, "F#")
    ckcontains("key_accidentals(D) has C#", d_acc, "C#")
    cknot_contains("key_accidentals(D) no G#", d_acc, "G#")

    // A major has 3 sharps: F# C# G#
    let a_acc = key_accidentals("A")
    cki("key_accidentals(A) len", len(a_acc), 3)
    ckcontains("key_accidentals(A) has F#", a_acc, "F#")
    ckcontains("key_accidentals(A) has C#", a_acc, "C#")
    ckcontains("key_accidentals(A) has G#", a_acc, "G#")

    // F major has 1 flat: Bb
    let f_acc = key_accidentals("F")
    cki("key_accidentals(F) len", len(f_acc), 1)
    ckcontains("key_accidentals(F) has Bb", f_acc, "Bb")

    // Bb major has 2 flats: Bb Eb
    let bb_acc = key_accidentals("Bb")
    cki("key_accidentals(Bb) len", len(bb_acc), 2)
    ckcontains("key_accidentals(Bb) has Bb", bb_acc, "Bb")
    ckcontains("key_accidentals(Bb) has Eb", bb_acc, "Eb")
    cknot_contains("key_accidentals(Bb) no Ab", bb_acc, "Ab")

    // Eb major has 3 flats: Bb Eb Ab
    let eb_acc = key_accidentals("Eb")
    cki("key_accidentals(Eb) len", len(eb_acc), 3)
    ckcontains("key_accidentals(Eb) has Bb", eb_acc, "Bb")
    ckcontains("key_accidentals(Eb) has Eb", eb_acc, "Eb")
    ckcontains("key_accidentals(Eb) has Ab", eb_acc, "Ab")

    // B major has 5 sharps: F# C# G# D# A#
    let bkey_acc = key_accidentals("B")
    cki("key_accidentals(B) len", len(bkey_acc), 5)
    ckcontains("key_accidentals(B) has A#", bkey_acc, "A#")

    // F# major has 6 sharps
    let fsharp_acc = key_accidentals("F#")
    cki("key_accidentals(F#) len", len(fsharp_acc), 6)

    // Verify order: first element of D major is F#, second is C#
    cks("key_accidentals(D)[0]", d_acc[0], "F#")
    cks("key_accidentals(D)[1]", d_acc[1], "C#")

    // Verify order: first element of Bb major is Bb, second is Eb
    cks("key_accidentals(Bb)[0]", bb_acc[0], "Bb")
    cks("key_accidentals(Bb)[1]", bb_acc[1], "Eb")

    // ── relative_minor ────────────────────────────────────────────────────────
    cks("relative_minor(C)",  relative_minor("C"),  "Am")
    cks("relative_minor(G)",  relative_minor("G"),  "Em")
    cks("relative_minor(D)",  relative_minor("D"),  "Bm")
    cks("relative_minor(A)",  relative_minor("A"),  "F#m")
    cks("relative_minor(E)",  relative_minor("E"),  "C#m")
    cks("relative_minor(B)",  relative_minor("B"),  "G#m")
    cks("relative_minor(F#)", relative_minor("F#"), "D#m")
    cks("relative_minor(F)",  relative_minor("F"),  "Dm")
    cks("relative_minor(Bb)", relative_minor("Bb"), "Gm")
    cks("relative_minor(Eb)", relative_minor("Eb"), "Cm")
    cks("relative_minor(Ab)", relative_minor("Ab"), "Fm")
    cks("relative_minor(Db)", relative_minor("Db"), "Bbm")
    cks("relative_minor(Gb)", relative_minor("Gb"), "Ebm")
    // unknown
    cks("relative_minor(X)",  relative_minor("X"),  "")

    // ── relative_major ────────────────────────────────────────────────────────
    cks("relative_major(Am)",  relative_major("Am"),  "C")
    cks("relative_major(Em)",  relative_major("Em"),  "G")
    cks("relative_major(Bm)",  relative_major("Bm"),  "D")
    cks("relative_major(F#m)", relative_major("F#m"), "A")
    cks("relative_major(C#m)", relative_major("C#m"), "E")
    cks("relative_major(G#m)", relative_major("G#m"), "B")
    cks("relative_major(D#m)", relative_major("D#m"), "F#")
    cks("relative_major(Dm)",  relative_major("Dm"),  "F")
    cks("relative_major(Gm)",  relative_major("Gm"),  "Bb")
    cks("relative_major(Cm)",  relative_major("Cm"),  "Eb")
    cks("relative_major(Fm)",  relative_major("Fm"),  "Ab")
    cks("relative_major(Bbm)", relative_major("Bbm"), "Db")
    cks("relative_major(Ebm)", relative_major("Ebm"), "Gb")
    // unknown
    cks("relative_major(X)",   relative_major("X"),   "")

    // ── parallel_minor ────────────────────────────────────────────────────────
    cks("parallel_minor(C)",  parallel_minor("C"),  "Cm")
    cks("parallel_minor(G)",  parallel_minor("G"),  "Gm")
    cks("parallel_minor(D)",  parallel_minor("D"),  "Dm")
    cks("parallel_minor(A)",  parallel_minor("A"),  "Am")
    cks("parallel_minor(E)",  parallel_minor("E"),  "Em")
    cks("parallel_minor(F)",  parallel_minor("F"),  "Fm")
    cks("parallel_minor(Bb)", parallel_minor("Bb"), "Bbm")
    cks("parallel_minor(Eb)", parallel_minor("Eb"), "Ebm")
    // unknown
    cks("parallel_minor(X)",  parallel_minor("X"),  "")

    print("PASS _keysig_test")
