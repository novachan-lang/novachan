import forge_meetingrooms

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

// brute-force max overlap: for each interval start, count how many contain that point
fn brute(intervals: list) -> int
    let best = 0
    let i = 0
    while i < len(intervals)
        let t = intervals[i][0]
        let count = 0
        let j = 0
        while j < len(intervals)
            if intervals[j][0] <= t and t < intervals[j][1]
                count = count + 1
            j = j + 1
        if count > best
            best = count
        i = i + 1
    best

fn main()
    let fails = 0

    let m1 = []
    push(m1, [0, 30])
    push(m1, [5, 10])
    push(m1, [15, 20])
    fails = fails + expect("classic", str(min_meeting_rooms(m1)), "2")

    let m2 = []
    push(m2, [7, 10])
    push(m2, [2, 4])
    fails = fails + expect("no_overlap", str(min_meeting_rooms(m2)), "1")

    let m3 = []
    push(m3, [1, 5])
    push(m3, [2, 6])
    push(m3, [3, 7])
    push(m3, [4, 8])
    fails = fails + expect("all_overlap", str(min_meeting_rooms(m3)), "4")

    // end-exclusive: a meeting ending at t frees room for one starting at t
    let m4 = []
    push(m4, [1, 5])
    push(m4, [5, 10])
    fails = fails + expect("touching", str(min_meeting_rooms(m4)), "1")

    // can_attend_all
    fails = fails + expect("attend_yes", str(can_attend_all(m2)), "true")
    fails = fails + expect("attend_no", str(can_attend_all(m1)), "false")
    fails = fails + expect("attend_touch", str(can_attend_all(m4)), "true")

    // single + empty
    let m5 = []
    push(m5, [3, 9])
    fails = fails + expect("single", str(min_meeting_rooms(m5)), "1")
    fails = fails + expect("empty", str(min_meeting_rooms([])), "0")

    // brute-force cross-check
    let ok = 1
    let sets = []
    let s1 = []
    push(s1, [1, 4])
    push(s1, [2, 5])
    push(s1, [7, 9])
    push(s1, [3, 6])
    push(sets, s1)
    let s2 = []
    push(s2, [0, 10])
    push(s2, [1, 2])
    push(s2, [3, 4])
    push(s2, [5, 6])
    push(sets, s2)
    let t = 0
    while t < len(sets)
        if min_meeting_rooms(sets[t]) != brute(sets[t])
            ok = 0
        t = t + 1
    fails = fails + expect("brute_cross", str(ok), "1")

    if fails == 0
        print("forge_meetingrooms: all passed")
    else
        print("forge_meetingrooms: " + str(fails) + " FAILED")
