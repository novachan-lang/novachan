// 3.1 — SCALAR float through FUNCTION CALLS. This is the path 3.3 exposed: a fully-typed
// float fn still emits nova_rt_unbox on both params, because an i64 float argument may be a
// box or a raw bit pattern and the callee cannot tell.
// Paired with _f31_scalar.c (identical shape) to get the true NOVA/C ratio.
fn axpy(a: float, x: float, y: float) -> float
    a * x + y

fn main()
    let seed = time_ms() % 3 + 1        // runtime-unknown: blocks constant folding
    let a = 1.0000001 + float(seed) * 0.0000001
    let n = 20000000
    let acc = 0.0
    let t0 = time_ms()
    let i = 0
    while i < n
        acc = axpy(a, acc, 0.5)
        i = i + 1
    let el = time_ms() - t0
    print("BENCH scalar_axpy elapsed_ms=" + str(el))
    print(acc)
