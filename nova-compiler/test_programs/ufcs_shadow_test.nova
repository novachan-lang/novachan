type Rect
    x: Int
    y: Int
    w: Int
    h: Int

type Circle
    cx: Int
    cy: Int
    r: Int

fn Rect.contains(px, py)
    px >= self.x and px < self.x + self.w and py >= self.y and py < self.y + self.h

fn Rect.len()
    2 * (self.w + self.h)

fn Circle.contains(px, py)
    let dx = px - self.cx
    let dy = py - self.cy
    dx * dx + dy * dy <= self.r * self.r

fn main()
    print("test 1: rect contains")
    let r = Rect { x: 0, y: 0, w: 10, h: 5 }
    assert(r.contains(5, 3) == true, "rect contains inside")
    print("test 2: rect contains outside")
    assert(r.contains(15, 3) == false, "rect contains outside")
    print("test 3: rect len")
    assert(r.len() == 30, "rect perimeter")
    print("test 4: dict builtin contains")
    let d = {"a": 1, "b": 2}
    assert(contains(d, "a") == true, "dict contains builtin")
    print("test 5: dict UFCS contains")
    assert(d.contains("a") == true, "dict contains UFCS")
    print("test 6: list len")
    let lst = [10, 20, 30]
    assert(len(lst) == 3, "list len builtin")
    print("test 7: circle contains")
    let c = Circle { cx: 0, cy: 0, r: 5 }
    assert(c.contains(3, 4) == true, "circle contains inside")
    print("test 8: circle contains outside")
    assert(c.contains(4, 4) == false, "circle contains outside")
    print("test 9: del")
    d["c"] = 3
    del(d, "c")
    assert(contains(d, "c") == false, "del removed key")
    assert(len(keys(d)) == 2, "del key count")
    print("ufcs_shadow_test: all passed")
