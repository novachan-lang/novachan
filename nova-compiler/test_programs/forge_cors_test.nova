// forge_cors_test -- full CORS: the Allow-Origin header on every response AND the browser OPTIONS
// preflight answered with 204 + allowed methods/headers, short-circuiting before the route.
import forge

type Msg
    ok: bool

fn h(req: Request) -> Msg
    Msg(true)

fn main()
    let a = forge.app()
    forge.use(a, forge.mw_cors_origin("*"))
    forge.get(a, "/api/data", h)

    // GET -> 200 + CORS origin header (unchanged behavior)
    let g: Response = forge.dispatch_req(a, forge.build_request("GET /api/data HTTP/1.1\r\n\r\n", 0))
    assert(g.status == 200, "GET -> 200")
    assert(g.headers["Access-Control-Allow-Origin"] == "*", "GET carries CORS origin")
    print("PASS: GET + CORS header")

    // OPTIONS preflight -> 204 + allow methods/headers (route terminal NOT reached)
    let o: Response = forge.dispatch_req(a, forge.build_request("OPTIONS /api/data HTTP/1.1\r\n\r\n", 0))
    assert(o.status == 204, "OPTIONS preflight -> 204")
    assert(o.headers["Access-Control-Allow-Origin"] == "*", "preflight origin")
    assert(contains(o.headers, "Access-Control-Allow-Methods"), "preflight allow-methods")
    assert(contains(o.headers, "Access-Control-Allow-Headers"), "preflight allow-headers")
    print("PASS: OPTIONS preflight -> 204")

    // preflight short-circuits BEFORE routing, so an unrouted path still preflights (not 404)
    let o2: Response = forge.dispatch_req(a, forge.build_request("OPTIONS /unrouted HTTP/1.1\r\n\r\n", 0))
    assert(o2.status == 204, "preflight on unrouted path -> 204, not 404")
    print("PASS: preflight short-circuits before routing")
    print("forge_cors_test passed")
