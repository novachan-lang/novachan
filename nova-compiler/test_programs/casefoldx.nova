// casefoldx -- Unicode case folding for CORRECT case-insensitive comparison, covering the
// cases an ASCII tolower gets wrong. Implements DEFAULT FULL case folding (Unicode
// CaseFolding.txt status C+F+S) for the common BMP scripts. The folds here are ALGORITHMIC
// (range + fixed offset) plus a few documented 1:N specials -- so this is a compact, exact
// mapping, NOT a heuristic and NOT the 100KB UCD table.
//
// COVERED: ASCII A-Z; Latin-1 capital letters U+00C0..U+00DE (excl. U+00D7); German sharp s
// U+00DF -> "ss"; micro sign U+00B5 -> Greek mu; dotted capital I U+0130 -> "i" + combining
// dot above; Greek capitals U+0391..U+03A9 (excl. the U+03A2 hole) incl. Sigma, and final
// sigma U+03C2 -> U+03C3; Cyrillic U+0400..U+042F.
//
// DEFERRED (pass-through, documented -- NOT silently truncated): Latin Extended-A/B (its
// upper/lower pairing is irregular -- a naive rule would be WRONG, so it needs the real UCD
// table), Armenian, fullwidth forms, ligature expansions (ff/fi/...), and LOCALE-TAILORED
// folding (e.g. Turkic I/dotless-i, which is locale-dependent and would break English by
// default). Pass-through is SAFE: an uncovered codepoint folds to itself, so a comparison
// involving it is at worst case-SENSITIVE for that char -- never incorrect.
//
// Full UCA collation (locale-aware sort keys) is a separate follow-on, not part of folding.

// Fold one codepoint -> a list of folded codepoints (length 1, or 2 for the 1:N specials).
fn _fold_cp(c)
    // ASCII A-Z -> a-z
    if c >= 65 and c <= 90
        return [c + 32]
    // Latin-1 capitals U+00C0..U+00DE (skip U+00D7 MULTIPLICATION SIGN, not a letter) -> +0x20
    if c >= 192 and c <= 222 and c != 215
        return [c + 32]
    // German sharp s U+00DF -> "ss" (full folding 1:2)
    if c == 223
        return [115, 115]
    // micro sign U+00B5 -> Greek small letter mu U+03BC
    if c == 181
        return [956]
    // dotted capital I U+0130 -> "i" + combining dot above U+0307 (default, non-Turkic)
    if c == 304
        return [105, 775]
    // Greek capitals U+0391..U+03A9 -> small (+0x20); skip the U+03A2 reserved hole.
    // U+03A3 Sigma -> U+03C3 small sigma falls out of the +0x20 rule.
    if c >= 913 and c <= 937 and c != 930
        return [c + 32]
    // Greek final sigma U+03C2 -> U+03C3 (unify the two lowercase sigma forms)
    if c == 962
        return [963]
    // Cyrillic capitals U+0410..U+042F -> small (+0x20)
    if c >= 1040 and c <= 1071
        return [c + 32]
    // Cyrillic capitals U+0400..U+040F -> small U+0450..U+045F (+0x50)
    if c >= 1024 and c <= 1039
        return [c + 80]
    // uncovered: fold to self (safe pass-through)
    return [c]

// casefold(s): the case-folded form of s. Two strings are case-insensitively equal iff
// their casefold() forms are byte-equal. Idempotent on covered input (output is lowercase).
fn casefold(s)
    let cps = code_points(s)
    let out = ""
    for c in cps
        let folded = _fold_cp(c)
        for fc in folded
            out = out + from_codepoint(fc)
    out

// equals_ignore_case(a, b): true iff a and b are equal under Unicode default case folding.
fn equals_ignore_case(a, b)
    casefold(a) == casefold(b)
