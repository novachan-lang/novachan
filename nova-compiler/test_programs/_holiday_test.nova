// KAT for std/time/holiday — Easter computus, nth-weekday, US federal holidays.
import std/time/holiday

// ── helpers ───────────────────────────────────────────────────────────────

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL holiday " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL holiday " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck_date(label: string, lst, wy: int, wm: int, wd: int)
    if len(lst) != 3
        print("FAIL holiday " + label + ": list length " + str(len(lst)) + " want 3")
        exit(1)
    cki(label + "-year",  lst[0], wy)
    cki(label + "-month", lst[1], wm)
    cki(label + "-day",   lst[2], wd)

fn main()
    // ── easter ────────────────────────────────────────────────────────────
    // KAT vectors from the spec + NIST/calendrical reference.
    ck_date("easter-2024", easter(2024), 2024, 3, 31)
    ck_date("easter-2025", easter(2025), 2025, 4, 20)
    ck_date("easter-2027", easter(2027), 2027, 3, 28)
    // Extra well-known dates for coverage.
    ck_date("easter-2000", easter(2000), 2000, 4, 23)
    ck_date("easter-2019", easter(2019), 2019, 4, 21)
    ck_date("easter-2023", easter(2023), 2023, 4,  9)
    // Round-trip: re-run 2024 to confirm determinism.
    ck_date("easter-2024-rt", easter(2024), 2024, 3, 31)

    // ── holiday_nth_weekday ───────────────────────────────────────────────
    // 3rd Monday of January 2024 = Jan 15 (MLK Day).  Jan 1 2024 = Monday → Mon 1,8,15.
    ck_date("nth-mlk-2024", holiday_nth_weekday(2024, 1, 1, 3), 2024, 1, 15)
    // 1st Monday of September 2024 (Labor Day).  Sep 1 2024 = Sunday.
    // First Monday → Sep 2.
    ck_date("nth-labor-2024", holiday_nth_weekday(2024, 9, 1, 1), 2024, 9,  2)
    // Last Monday of May 2024 (Memorial Day).  May 1 2024 = Wednesday.
    // First Monday May 6; then 13,20,27.  Last = 27.
    ck_date("nth-memorial-2024", holiday_nth_weekday(2024, 5, 1, -1), 2024, 5, 27)
    // 1st Sunday of Feb 2025.  Feb 1 2025 = Saturday.  First Sunday = Feb 2.
    ck_date("nth-sun-feb-2025", holiday_nth_weekday(2025, 2, 0, 1), 2025, 2,  2)
    // Invalid: n=0 → empty list.
    let bad = holiday_nth_weekday(2024, 1, 1, 0)
    cki("nth-n0-len", len(bad), 0)
    // Out of range: 5th Monday of Feb 2025 (Feb has 28 days; 1st Mon=Feb 3).
    // Mon 3,10,17,24 → 5th would be Mar 3 — out of month → [].
    let oob = holiday_nth_weekday(2025, 2, 1, 5)
    cki("nth-oob-len", len(oob), 0)

    // ── holiday_us_thanksgiving ───────────────────────────────────────────
    // 4th Thursday of November 2024.  Nov 1 2024 = Friday.
    // First Thursday = Nov 7; then 14,21,28.  4th = Nov 28.
    ck_date("thanksgiving-2024", holiday_us_thanksgiving(2024), 2024, 11, 28)
    // 2023: Nov 1 = Wednesday.  First Thursday = Nov 2; then 9,16,23.  4th = Nov 23.
    ck_date("thanksgiving-2023", holiday_us_thanksgiving(2023), 2023, 11, 23)
    // Round-trip 2024.
    ck_date("thanksgiving-2024-rt", holiday_us_thanksgiving(2024), 2024, 11, 28)

    // ── holiday_is_us ─────────────────────────────────────────────────────
    // Fixed holidays.
    ckb("is_us-newyear",   holiday_is_us(2024,  1,  1), true)
    ckb("is_us-jul4",      holiday_is_us(2024,  7,  4), true)
    ckb("is_us-jul5",      holiday_is_us(2024,  7,  5), false)
    ckb("is_us-christmas", holiday_is_us(2024, 12, 25), true)
    ckb("is_us-dec26",     holiday_is_us(2024, 12, 26), false)
    // MLK Day 2024 = Jan 15.
    ckb("is_us-mlk-2024",  holiday_is_us(2024,  1, 15), true)
    ckb("is_us-jan14",     holiday_is_us(2024,  1, 14), false)
    // Memorial Day 2024 = May 27.
    ckb("is_us-memorial-2024", holiday_is_us(2024, 5, 27), true)
    ckb("is_us-may26",         holiday_is_us(2024, 5, 26), false)
    // Labor Day 2024 = Sep 2.
    ckb("is_us-labor-2024", holiday_is_us(2024, 9,  2), true)
    ckb("is_us-sep1",       holiday_is_us(2024, 9,  1), false)
    // Thanksgiving 2024 = Nov 28.
    ckb("is_us-tg-2024",  holiday_is_us(2024, 11, 28), true)
    ckb("is_us-nov27",    holiday_is_us(2024, 11, 27), false)
    // Invalid inputs return false.
    ckb("is_us-invalid-month", holiday_is_us(2024, 13,  1), false)
    ckb("is_us-invalid-day",   holiday_is_us(2024,  2, 30), false)

    print("PASS _holiday_test")
