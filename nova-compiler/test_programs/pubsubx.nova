fn pubsub_new()
  let ps = {}
  ps["topics"] = {}
  ps

fn subscribe(ps, topic, ch)
  let topics = ps["topics"]
  if not contains(topics, topic)
    topics[topic] = []
  push(topics[topic], ch)

fn publish(ps, topic, message)
  let topics = ps["topics"]
  if not contains(topics, topic)
    return 0
  let subs = topics[topic]
  let count = 0
  for ch in subs
    send(ch, message)
    count = count + 1
  count

fn subscriber_count(ps, topic)
  let topics = ps["topics"]
  if not contains(topics, topic)
    return 0
  len(topics[topic])

fn topics(ps)
  keys(ps["topics"])

fn main()
  let ps = pubsub_new()

  let ch1 = channel()
  let ch2 = channel()
  let ch3 = channel()

  subscribe(ps, "news", ch1)
  subscribe(ps, "news", ch2)
  subscribe(ps, "sports", ch3)

  assert(subscriber_count(ps, "news") == 2, "2 news subs")
  assert(subscriber_count(ps, "sports") == 1, "1 sports sub")
  assert(subscriber_count(ps, "none") == 0, "0 none subs")

  let sent = publish(ps, "news", "breaking story")
  assert(sent == 2, "published to 2")

  let msg1 = receive(ch1)
  let msg2 = receive(ch2)
  assert(msg1 == "breaking story", "sub1 received")
  assert(msg2 == "breaking story", "sub2 received")

  let _s2 = publish(ps, "sports", "goal scored")
  let msg3 = receive(ch3)
  assert(msg3 == "goal scored", "sports sub received")

  let t = topics(ps)
  assert(len(t) == 2, "2 topics")

  print("pubsubx: all passed")
