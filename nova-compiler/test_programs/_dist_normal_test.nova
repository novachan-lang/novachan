// KAT test for std/numeric/dist_normal — normal distribution functions.
//
// Known answers (standard normal N(0,1)):
//   normal_pdf(0.0, 0.0, 1.0)  ~= 0.39894
//   normal_cdf(0.0, 0.0, 1.0)  = 0.5
//   normal_cdf(1.96, 0.0, 1.0) ~= 0.975
//   normal_ppf(0.5,  0.0, 1.0) ~= 0.0
import std/numeric/dist_normal

fn approx(a, b, tol) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < tol
        return 1
    return 0

fn ck(label: string, got: float, want: float, tol: float)
    let ok = approx(got, want, tol)
    if ok == 0
        print("FAIL dist_normal " + label + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("ok " + label)

fn main()
    // normal_pdf at mean = peak = 1/sqrt(2*pi) ~= 0.39894228
    let pdf0 = normal_pdf(0.0, 0.0, 1.0)
    ck("normal_pdf(0,mu=0,sigma=1)=0.39894", pdf0, 0.39894, 0.001)

    // normal_cdf at mean = 0.5 by symmetry
    let cdf0 = normal_cdf(0.0, 0.0, 1.0)
    ck("normal_cdf(0,mu=0,sigma=1)=0.5", cdf0, 0.5, 0.001)

    // normal_cdf(1.96) ~= 0.975 (classic 95% CI bound)
    let cdf196 = normal_cdf(1.96, 0.0, 1.0)
    ck("normal_cdf(1.96,mu=0,sigma=1)=0.975", cdf196, 0.975, 0.005)

    // normal_ppf(0.5) = 0.0 (median = mean for symmetric distribution)
    let ppf05 = normal_ppf(0.5, 0.0, 1.0)
    ck("normal_ppf(0.5,mu=0,sigma=1)=0.0", ppf05, 0.0, 0.01)

    // normal_ppf(0.9332) ~= 1.5 (known value)
    let ppf09332 = normal_ppf(0.9332, 0.0, 1.0)
    ck("normal_ppf(0.9332,mu=0,sigma=1)=1.5", ppf09332, 1.5, 0.01)

    // normal_ppf(0.9772) ~= 2.0 (known value: 2-sigma)
    let ppf09772 = normal_ppf(0.9772, 0.0, 1.0)
    ck("normal_ppf(0.9772,mu=0,sigma=1)=2.0", ppf09772, 2.0, 0.01)

    // shifted distribution: mu=5, sigma=2
    let pdf_shifted = normal_pdf(5.0, 5.0, 2.0)
    let expected_peak = 0.19947
    ck("normal_pdf(5,mu=5,sigma=2)=0.19947", pdf_shifted, expected_peak, 0.001)

    // cdf at mu for any distribution = 0.5
    let cdf_shifted = normal_cdf(5.0, 5.0, 2.0)
    ck("normal_cdf(mu,mu,sigma)=0.5", cdf_shifted, 0.5, 0.001)

    print("PASS _dist_normal_test")
