// String paper-cut ops: splitlines / partition / rpartition / rsplit (Python string ergonomics).

// --- splitlines: split on \n, strip trailing \r (CRLF), no trailing empty, interior empty kept ---
r = splitlines("a\nb\nc")
if len(r) != 3 or r[0] != "a" or r[1] != "b" or r[2] != "c"
    print("FAIL splitlines basic len=" + str(len(r)))
    exit(1)
r2 = splitlines("a\r\nb")
if len(r2) != 2 or r2[0] != "a" or r2[1] != "b"
    print("FAIL splitlines CRLF")
    exit(1)
r3 = splitlines("a\n")
if len(r3) != 1 or r3[0] != "a"
    print("FAIL splitlines trailing newline len=" + str(len(r3)))
    exit(1)
r4 = splitlines("a\n\nb")
if len(r4) != 3 or r4[0] != "a" or r4[1] != "" or r4[2] != "b"
    print("FAIL splitlines interior empty")
    exit(1)
r5 = splitlines("")
if len(r5) != 0
    print("FAIL splitlines empty len=" + str(len(r5)))
    exit(1)

// --- partition: [before, sep, after] at FIRST sep; absent -> [s, "", ""] ---
p = partition("a=b=c", "=")
if len(p) != 3 or p[0] != "a" or p[1] != "=" or p[2] != "b=c"
    print("FAIL partition basic")
    exit(1)
p2 = partition("abc", "=")
if len(p2) != 3 or p2[0] != "abc" or p2[1] != "" or p2[2] != ""
    print("FAIL partition absent")
    exit(1)

// --- rpartition: at LAST sep; absent -> ["", "", s] ---
rp = rpartition("a=b=c", "=")
if len(rp) != 3 or rp[0] != "a=b" or rp[1] != "=" or rp[2] != "c"
    print("FAIL rpartition basic")
    exit(1)
rp2 = rpartition("abc", "=")
if len(rp2) != 3 or rp2[0] != "" or rp2[1] != "" or rp2[2] != "abc"
    print("FAIL rpartition absent")
    exit(1)

// --- rsplit (== split with no maxsplit) ---
rs = rsplit("a,b,c", ",")
if len(rs) != 3 or rs[0] != "a" or rs[1] != "b" or rs[2] != "c"
    print("FAIL rsplit")
    exit(1)

// --- UFCS method forms ---
u = "x:y".partition(":")
if len(u) != 3 or u[0] != "x" or u[1] != ":" or u[2] != "y"
    print("FAIL UFCS partition")
    exit(1)
u2 = "1\n2".splitlines()
if len(u2) != 2 or u2[0] != "1" or u2[1] != "2"
    print("FAIL UFCS splitlines")
    exit(1)

print("strx_ops PASS")
