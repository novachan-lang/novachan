// KAT for std/control/discretefilter -- discrete-time filters and compensators.
import std/control/discretefilter

fn approx(a: float, b: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    d < 0.0001

fn ckf(label: string, got: float, want: float)
    if not approx(got, want)
        print("FAIL discretefilter " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // -- lowpass alpha=1: y = x (pass-through) --
    let lp1 = df_lowpass_new(1.0)
    ckf("lowpass a=1 step 5", df_lowpass_step(lp1, 5.0), 5.0)

    // -- lowpass alpha=0.5: first step from 0, x=10 -> 0.5*10+0.5*0 = 5.0 --
    let lp5 = df_lowpass_new(0.5)
    ckf("lowpass a=0.5 step1", df_lowpass_step(lp5, 10.0), 5.0)
    // second step x=10 -> 0.5*10 + 0.5*5 = 7.5
    ckf("lowpass a=0.5 step2", df_lowpass_step(lp5, 10.0), 7.5)

    // -- df_alpha_from_cutoff: just ensure it returns a float in (0,1) --
    let alpha_val = df_alpha_from_cutoff(100.0, 1000.0)
    // at fc=100, fs=1000: RC=1/(2pi*100)~0.00159; dt=0.001; alpha~0.001/(0.00159+0.001)~0.386
    // just verify it's in (0,1)
    if alpha_val <= 0.0
        print("FAIL discretefilter alpha_from_cutoff: <= 0")
        exit(1)
    if alpha_val >= 1.0
        print("FAIL discretefilter alpha_from_cutoff: >= 1")
        exit(1)

    // -- highpass: alpha=1 passes high-freq content; first step from 0 --
    let hp = df_highpass_new(1.0)
    // y = 1*(0 + x - 0) = x for first step from zero state
    ckf("highpass step1 x=3", df_highpass_step(hp, 3.0), 3.0)
    // second step x=3 (no change): y = 1*(3 + 3 - 3) = 3
    ckf("highpass step2 x=3", df_highpass_step(hp, 3.0), 3.0)

    // -- integrator dt=0.1: three steps of x=2 -> 0.2, 0.4, 0.6 --
    let intg = df_integrator_new(0.1)
    ckf("integrator step1", df_integrator_step(intg, 2.0), 0.2)
    ckf("integrator step2", df_integrator_step(intg, 2.0), 0.4)
    ckf("integrator step3", df_integrator_step(intg, 2.0), 0.6)

    // -- differentiator dt=0.1: first step x=1.0 -> (1-0)/0.1 = 10 --
    let diff = df_differentiator_new(0.1)
    ckf("diff step1", df_differentiator_step(diff, 1.0), 10.0)
    // second step x=1.0 (no change) -> (1-1)/0.1 = 0
    ckf("diff step2", df_differentiator_step(diff, 1.0), 0.0)

    // -- moving average window=3 of [3,6,9] -> mean of last 3 = 6.0 --
    let ma = df_ma_new(3)
    df_ma_step(ma, 3.0)
    df_ma_step(ma, 6.0)
    ckf("ma step3", df_ma_step(ma, 9.0), 6.0)

    // -- df_reset clears state --
    let lp_r = df_lowpass_new(0.5)
    df_lowpass_step(lp_r, 10.0)
    df_reset(lp_r)
    // after reset y_prev = 0, so step(10) = 5 again
    ckf("reset lowpass", df_lowpass_step(lp_r, 10.0), 5.0)

    // -- integrator reset --
    let intg_r = df_integrator_new(0.1)
    df_integrator_step(intg_r, 5.0)
    df_reset(intg_r)
    ckf("reset integrator", df_integrator_step(intg_r, 2.0), 0.2)

    print("PASS _discretefilter_test")
