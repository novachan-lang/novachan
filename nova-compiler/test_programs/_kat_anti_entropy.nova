import forge_anti_entropy

fn main()
    let ae = ae_new()
    ae = ae_add_replica(ae, "replica-1")
    ae = ae_add_replica(ae, "replica-2")
    assert(ae_replica_count(ae) == 2, "2 replicas")

    ae = ae_set_key(ae, "replica-1", "user:1", "alice", 1)
    ae = ae_set_key(ae, "replica-1", "user:2", "bob", 1)
    ae = ae_set_key(ae, "replica-2", "user:1", "alice", 1)

    let diffs = ae_compare(ae, "replica-1", "replica-2")
    assert(len(diffs) == 1, "1 diff (user:2 missing)")
    assert(ae_total_scans(ae) == 1, "1 scan")

    ae = ae_repair(ae, "replica-1", "replica-2", "user:2")
    assert(ae_total_repairs(ae) == 1, "1 repair")
    assert(ae_key_count(ae, "replica-2") == 2, "replica-2 now has 2")

    let diffs2 = ae_compare(ae, "replica-1", "replica-2")
    assert(len(diffs2) == 0, "0 diffs after repair")

    ae = ae_set_key(ae, "replica-1", "user:1", "alice-v2", 2)
    let diffs3 = ae_compare(ae, "replica-1", "replica-2")
    assert(len(diffs3) == 1, "1 version diff")

    print("ANTI-ENTROPY KAT PASS")
