// forge_chunked_test -- chunked / streaming HTTP responses (Transfer-Encoding: chunked, RFC 7230). A stream
// route hijacks the connection; its producer emits chunks via forge.send_chunk; the framework writes the
// chunked headers and the terminating 0-chunk. Verifies the wire framing: chunked header, each chunk
// "<hexlen>\r\n<data>\r\n", and the terminator.
import forge

fn _produce(conn: int)
    forge.send_chunk(conn, "part1")
    forge.send_chunk(conn, "part2")
    forge.send_chunk(conn, "part3")
    forge.send_chunk_bin(conn, str_to_bytes("BIN"))

fn _server(port: int)
    let a = forge.app()
    forge.stream(a, "/download", "text/plain", fn(conn) _produce(conn))
    forge.serve_req_n(a, port, 1)

fn main()
    let port = 19420
    spawn fn()
        _server(port)
    sleep(300)
    let s = tcp_connect("127.0.0.1", port)
    tcp_send(s, "GET /download HTTP/1.0\r\n\r\n")
    // read the whole response until EOF (the stream sends Connection: close)
    let r = tcp_recv(s)
    let go = true
    while go
        let more = tcp_recv(s)
        if len(more) == 0
            go = false
        else
            r = r + more
    tcp_close(s)
    assert(find(r, "Transfer-Encoding: chunked") >= 0, "chunked transfer-encoding header set")
    assert(find(r, "5\r\npart1\r\n") >= 0, "chunk 1 framed as 5<crlf>part1<crlf>")
    assert(find(r, "5\r\npart2\r\n") >= 0, "chunk 2 framed correctly")
    assert(find(r, "5\r\npart3\r\n") >= 0, "chunk 3 framed correctly")
    assert(find(r, "3\r\nBIN\r\n") >= 0, "binary chunk framed byte-exact (3<crlf>BIN<crlf>)")
    assert(find(r, "0\r\n\r\n") >= 0, "terminating 0-length chunk present")
    print("PASS: chunked streaming response -- 3 text chunks + 1 binary chunk + terminator")
    print("forge_chunked_test passed")
