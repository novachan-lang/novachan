fn _pad2(n)
  if n < 10
    return "0" + str(n)
  str(n)

fn format_date(ts, fmt)
  let y = datetime_year(ts)
  let m = datetime_month(ts)
  let d = datetime_day(ts)
  let h = datetime_hour(ts)
  let mi = datetime_minute(ts)
  let s = datetime_second(ts)
  let out = fmt
  out = replace(out, "YYYY", str(y))
  out = replace(out, "MM", _pad2(m))
  out = replace(out, "DD", _pad2(d))
  out = replace(out, "hh", _pad2(h))
  out = replace(out, "mm", _pad2(mi))
  out = replace(out, "ss", _pad2(s))
  out

fn iso8601(ts)
  format_date(ts, "YYYY-MM-DDThh:mm:ss")

fn date_only(ts)
  format_date(ts, "YYYY-MM-DD")

fn time_only(ts)
  format_date(ts, "hh:mm:ss")

fn relative_time(diff_seconds)
  if diff_seconds < 60
    return str(diff_seconds) + "s ago"
  if diff_seconds < 3600
    return str(diff_seconds / 60) + "m ago"
  if diff_seconds < 86400
    return str(diff_seconds / 3600) + "h ago"
  str(diff_seconds / 86400) + "d ago"

fn main()
  let ts = datetime_timestamp()
  let iso = iso8601(ts)
  assert(len(iso) >= 19, "iso8601 length")
  assert(contains(iso, "-"), "iso has dash")
  assert(contains(iso, "T"), "iso has T")
  assert(contains(iso, ":"), "iso has colon")

  let d = date_only(ts)
  assert(len(d) == 10, "date_only length 10")

  let t = time_only(ts)
  assert(contains(t, ":"), "time has colon")

  let p2 = _pad2(5)
  assert(p2 == "05", "pad2 single digit")
  assert(_pad2(12) == "12", "pad2 double digit")

  assert(relative_time(30) == "30s ago", "seconds")
  assert(relative_time(120) == "2m ago", "minutes")
  assert(relative_time(7200) == "2h ago", "hours")
  assert(relative_time(172800) == "2d ago", "days")

  print("datefmtx: all passed")
