// datefmtx.nova — Date/time formatting (strftime) + parsing (strptime), the NOVA way.
// Pure integer arithmetic, no locale dependency, thread-safe by construction.

fn _df_pad2(n: int) -> string
    if n < 10
        return "0" + str(n)
    str(n)

fn _df_pad3(n: int) -> string
    if n < 10
        return "00" + str(n)
    if n < 100
        return "0" + str(n)
    str(n)

fn _df_pad4(n: int) -> string
    if n < 10
        return "000" + str(n)
    if n < 100
        return "00" + str(n)
    if n < 1000
        return "0" + str(n)
    str(n)

fn _df_weekday_short(wd: int) -> string
    if wd == 0
        return "Sun"
    if wd == 1
        return "Mon"
    if wd == 2
        return "Tue"
    if wd == 3
        return "Wed"
    if wd == 4
        return "Thu"
    if wd == 5
        return "Fri"
    "Sat"

fn _df_weekday_long(wd: int) -> string
    if wd == 0
        return "Sunday"
    if wd == 1
        return "Monday"
    if wd == 2
        return "Tuesday"
    if wd == 3
        return "Wednesday"
    if wd == 4
        return "Thursday"
    if wd == 5
        return "Friday"
    "Saturday"

fn _df_month_short(m: int) -> string
    if m == 1
        return "Jan"
    if m == 2
        return "Feb"
    if m == 3
        return "Mar"
    if m == 4
        return "Apr"
    if m == 5
        return "May"
    if m == 6
        return "Jun"
    if m == 7
        return "Jul"
    if m == 8
        return "Aug"
    if m == 9
        return "Sep"
    if m == 10
        return "Oct"
    if m == 11
        return "Nov"
    "Dec"

fn _df_month_long(m: int) -> string
    if m == 1
        return "January"
    if m == 2
        return "February"
    if m == 3
        return "March"
    if m == 4
        return "April"
    if m == 5
        return "May"
    if m == 6
        return "June"
    if m == 7
        return "July"
    if m == 8
        return "August"
    if m == 9
        return "September"
    if m == 10
        return "October"
    if m == 11
        return "November"
    "December"

fn _df_is_leap(y: int) -> int
    if y % 4 != 0
        return 0
    if y % 100 != 0
        return 1
    if y % 400 != 0
        return 0
    1

fn _df_day_of_year(y: int, m: int, d: int) -> int
    let cum = [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334]
    let doy = cum[m - 1] + d
    if m > 2 and _df_is_leap(y)
        doy = doy + 1
    doy

fn _df_days_from_civil(y0: int, m: int, d: int) -> int
    let y = y0
    if m <= 2
        y = y - 1
    let era = y / 400
    let yoe = y - era * 400
    let mp = m + 9
    if m > 2
        mp = m - 3
    let doy = (153 * mp + 2) / 5 + d - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    era * 146097 + doe - 719468

fn _df_civil_from_days(z0: int) -> list
    let z = z0 + 719468
    let era = z / 146097
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let y = yoe + era * 400
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let d = doy - (153 * mp + 2) / 5 + 1
    let m = mp + 3
    if mp >= 10
        m = mp - 9
    if m <= 2
        y = y + 1
    [y, m, d]

fn _df_components(ts: int) -> dict
    let days = ts / 86400
    let secs = ts % 86400
    let ymd = _df_civil_from_days(days)
    let comp = {}
    comp["year"] = ymd[0]
    comp["month"] = ymd[1]
    comp["day"] = ymd[2]
    comp["hour"] = secs / 3600
    comp["minute"] = (secs % 3600) / 60
    comp["second"] = secs % 60
    comp["weekday"] = (days % 7 + 4) % 7
    comp

// ── Public API ──────────────────────────────────────────────────────

// strftime-style formatting. Supported directives:
//   %Y  4-digit year      %m  2-digit month    %d  2-digit day
//   %H  24-hour (00-23)   %M  minute (00-59)   %S  second (00-59)
//   %I  12-hour (01-12)   %p  AM/PM
//   %a  short weekday     %A  long weekday
//   %b  short month       %B  long month
//   %j  day-of-year (001-366)
//   %Z  "UTC"             %%  literal %
//   %e  day space-padded  %Y  4-digit year      %C  century (20)
fn strftime(ts: int, fmt: string) -> string
    let c = _df_components(ts)
    let y = c["year"]
    let m = c["month"]
    let d = c["day"]
    let h = c["hour"]
    let mi = c["minute"]
    let s = c["second"]
    let wd = c["weekday"]
    let out = ""
    let i = 0
    let n = len(fmt)
    while i < n
        let ch = fmt[i:i + 1]
        if ch == "%" and i + 1 < n
            let spec = fmt[i + 1:i + 2]
            if spec == "Y"
                out = out + _df_pad4(y)
            else if spec == "m"
                out = out + _df_pad2(m)
            else if spec == "d"
                out = out + _df_pad2(d)
            else if spec == "H"
                out = out + _df_pad2(h)
            else if spec == "M"
                out = out + _df_pad2(mi)
            else if spec == "S"
                out = out + _df_pad2(s)
            else if spec == "I"
                let h12 = h % 12
                if h12 == 0
                    h12 = 12
                out = out + _df_pad2(h12)
            else if spec == "p"
                if h < 12
                    out = out + "AM"
                else
                    out = out + "PM"
            else if spec == "a"
                out = out + _df_weekday_short(wd)
            else if spec == "A"
                out = out + _df_weekday_long(wd)
            else if spec == "b"
                out = out + _df_month_short(m)
            else if spec == "B"
                out = out + _df_month_long(m)
            else if spec == "j"
                out = out + _df_pad3(_df_day_of_year(y, m, d))
            else if spec == "Z"
                out = out + "UTC"
            else if spec == "%"
                out = out + "%"
            else if spec == "e"
                if d < 10
                    out = out + " " + str(d)
                else
                    out = out + str(d)
            else if spec == "C"
                out = out + str(y / 100)
            else
                out = out + "%" + spec
            i = i + 2
        else
            out = out + ch
            i = i + 1
    out

// Common format presets
fn format_iso8601(ts: int) -> string
    strftime(ts, "%Y-%m-%dT%H:%M:%SZ")

fn format_rfc2822(ts: int) -> string
    strftime(ts, "%a, %d %b %Y %H:%M:%S %Z")

fn format_date(ts: int) -> string
    strftime(ts, "%Y-%m-%d")

fn format_time(ts: int) -> string
    strftime(ts, "%H:%M:%S")

fn format_datetime(ts: int) -> string
    strftime(ts, "%Y-%m-%d %H:%M:%S")

fn format_us(ts: int) -> string
    strftime(ts, "%m/%d/%Y %I:%M %p")

// ── Parsing (strptime-style) ────────────────────────────────────────

fn _df_parse_int(s: string, pos: int, width: int) -> list
    let val = 0
    let i = pos
    let end = pos + width
    if end > len(s)
        end = len(s)
    while i < end
        let c = ord(s[i:i + 1])
        if c >= 48 and c <= 57
            val = val * 10 + (c - 48)
        else
            break
        i = i + 1
    [val, i]

fn _df_match_str(s: string, pos: int, target: string) -> int
    let tlen = len(target)
    if pos + tlen > len(s)
        return 0
    let i = 0
    while i < tlen
        let sc = ord(s[pos + i:pos + i + 1])
        let tc = ord(target[i:i + 1])
        if sc >= 65 and sc <= 90
            sc = sc + 32
        if tc >= 65 and tc <= 90
            tc = tc + 32
        if sc != tc
            return 0
        i = i + 1
    1

fn _df_parse_weekday_short(s: string, pos: int) -> list
    let names = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]
    let i = 0
    while i < 7
        if _df_match_str(s, pos, names[i])
            return [i, pos + 3]
        i = i + 1
    [-1, pos]

fn _df_parse_month_short(s: string, pos: int) -> list
    let names = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    let i = 0
    while i < 12
        if _df_match_str(s, pos, names[i])
            return [i + 1, pos + 3]
        i = i + 1
    [-1, pos]

fn _df_parse_ampm(s: string, pos: int) -> list
    if _df_match_str(s, pos, "AM")
        return [0, pos + 2]
    if _df_match_str(s, pos, "PM")
        return [1, pos + 2]
    [-1, pos]

// Parse a date string according to a format pattern.
// Returns a Unix timestamp (UTC), or -1 on parse failure.
// Supports: %Y %m %d %H %M %S %I %p %a %b %Z %%
fn strptime(s: string, fmt: string) -> int
    let year = 1970
    let month = 1
    let day = 1
    let hour = 0
    let minute = 0
    let second = 0
    let is_pm = -1
    let si = 0
    let fi = 0
    let sn = len(s)
    let fn_ = len(fmt)
    while fi < fn_
        let fc = fmt[fi:fi + 1]
        if fc == "%" and fi + 1 < fn_
            let spec = fmt[fi + 1:fi + 2]
            if spec == "Y"
                let r = _df_parse_int(s, si, 4)
                year = r[0]
                si = r[1]
            else if spec == "m"
                let r = _df_parse_int(s, si, 2)
                month = r[0]
                si = r[1]
            else if spec == "d"
                let r = _df_parse_int(s, si, 2)
                day = r[0]
                si = r[1]
            else if spec == "H"
                let r = _df_parse_int(s, si, 2)
                hour = r[0]
                si = r[1]
            else if spec == "M"
                let r = _df_parse_int(s, si, 2)
                minute = r[0]
                si = r[1]
            else if spec == "S"
                let r = _df_parse_int(s, si, 2)
                second = r[0]
                si = r[1]
            else if spec == "I"
                let r = _df_parse_int(s, si, 2)
                hour = r[0]
                si = r[1]
            else if spec == "p"
                let r = _df_parse_ampm(s, si)
                is_pm = r[0]
                si = r[1]
            else if spec == "a"
                let r = _df_parse_weekday_short(s, si)
                si = r[1]
            else if spec == "b"
                let r = _df_parse_month_short(s, si)
                if r[0] > 0
                    month = r[0]
                si = r[1]
            else if spec == "Z"
                if si + 3 <= sn and _df_match_str(s, si, "UTC")
                    si = si + 3
                else if si + 1 <= sn and s[si:si + 1] == "Z"
                    si = si + 1
            else if spec == "%"
                if si < sn and s[si:si + 1] == "%"
                    si = si + 1
            else if spec == "j"
                let r = _df_parse_int(s, si, 3)
                si = r[1]
            fi = fi + 2
        else
            if si < sn and s[si:si + 1] == fc
                si = si + 1
            else
                return -1
            fi = fi + 1
    if is_pm == 1 and hour < 12
        hour = hour + 12
    if is_pm == 0 and hour == 12
        hour = 0
    _df_days_from_civil(year, month, day) * 86400 + hour * 3600 + minute * 60 + second

// Relative time description
fn relative_time(diff_seconds: int) -> string
    if diff_seconds < 0
        return "in the future"
    if diff_seconds < 60
        return str(diff_seconds) + "s ago"
    if diff_seconds < 3600
        return str(diff_seconds / 60) + "m ago"
    if diff_seconds < 86400
        return str(diff_seconds / 3600) + "h ago"
    str(diff_seconds / 86400) + "d ago"

// ── Tests ───────────────────────────────────────────────────────────

fn main()
    // Known timestamp: 1234567890 = 2009-02-13T23:31:30Z (Friday)
    let ts = 1234567890

    // strftime basic
    assert(strftime(ts, "%Y-%m-%d") == "2009-02-13", "fmt date")
    assert(strftime(ts, "%H:%M:%S") == "23:31:30", "fmt time")
    assert(strftime(ts, "%Y-%m-%dT%H:%M:%SZ") == "2009-02-13T23:31:30Z", "fmt iso")

    // Weekday names (Friday = 5)
    assert(strftime(ts, "%a") == "Fri", "short weekday")
    assert(strftime(ts, "%A") == "Friday", "long weekday")

    // Month names (February)
    assert(strftime(ts, "%b") == "Feb", "short month")
    assert(strftime(ts, "%B") == "February", "long month")

    // 12-hour clock
    assert(strftime(ts, "%I:%M %p") == "11:31 PM", "12h PM")
    let morning = 3600
    assert(strftime(morning, "%p") == "AM", "morning AM")
    assert(strftime(morning, "%I") == "01", "1 AM 12h")

    // Day of year
    assert(strftime(ts, "%j") == "044", "day of year feb 13")

    // Epoch (Jan 1, Thursday)
    assert(strftime(0, "%a, %d %b %Y") == "Thu, 01 Jan 1970", "epoch rfc")

    // Literal %%
    assert(strftime(ts, "100%%") == "100%", "literal percent")

    // Preset formatters
    assert(format_iso8601(ts) == "2009-02-13T23:31:30Z", "preset iso")
    assert(format_date(ts) == "2009-02-13", "preset date")
    assert(format_time(ts) == "23:31:30", "preset time")
    assert(format_datetime(ts) == "2009-02-13 23:31:30", "preset datetime")

    // RFC 2822
    let rfc = format_rfc2822(ts)
    assert(contains(rfc, "Fri"), "rfc2822 weekday")
    assert(contains(rfc, "Feb"), "rfc2822 month")
    assert(contains(rfc, "2009"), "rfc2822 year")

    // Day of year for leap year
    let leap_ts = _df_days_from_civil(2020, 3, 1) * 86400
    assert(strftime(leap_ts, "%j") == "061", "doy leap mar 1")
    let nonleap_ts = _df_days_from_civil(2021, 3, 1) * 86400
    assert(strftime(nonleap_ts, "%j") == "060", "doy nonleap mar 1")

    // ── Parsing tests ──
    let parsed = strptime("2009-02-13T23:31:30Z", "%Y-%m-%dT%H:%M:%SZ")
    assert(parsed == 1234567890, "parse iso")

    let p2 = strptime("2021-07-04 12:30:45", "%Y-%m-%d %H:%M:%S")
    let c2 = _df_components(p2)
    assert(c2["year"] == 2021, "parse year")
    assert(c2["month"] == 7, "parse month")
    assert(c2["day"] == 4, "parse day")
    assert(c2["hour"] == 12, "parse hour")
    assert(c2["minute"] == 30, "parse min")
    assert(c2["second"] == 45, "parse sec")

    // Parse with month name
    let p3 = strptime("13 Feb 2009", "%d %b %Y")
    let c3 = _df_components(p3)
    assert(c3["year"] == 2009, "parse named month year")
    assert(c3["month"] == 2, "parse named month")
    assert(c3["day"] == 13, "parse named month day")

    // Parse 12-hour AM/PM
    let p4 = strptime("07/04/2021 02:30 PM", "%m/%d/%Y %I:%M %p")
    let c4 = _df_components(p4)
    assert(c4["year"] == 2021, "parse 12h year")
    assert(c4["month"] == 7, "parse 12h month")
    assert(c4["hour"] == 14, "parse 12h PM -> 14")

    let p5 = strptime("12/25/2023 12:00 AM", "%m/%d/%Y %I:%M %p")
    let c5 = _df_components(p5)
    assert(c5["hour"] == 0, "12 AM = midnight")

    // Round-trip: format -> parse -> format
    let formatted = strftime(ts, "%Y-%m-%d %H:%M:%S")
    let reparsed = strptime(formatted, "%Y-%m-%d %H:%M:%S")
    assert(reparsed == ts, "round trip")

    // Parse failure returns -1
    let bad = strptime("not-a-date", "%Y-%m-%d")
    assert(bad == -1, "bad parse returns -1")

    // Relative time
    assert(relative_time(30) == "30s ago", "rel seconds")
    assert(relative_time(120) == "2m ago", "rel minutes")
    assert(relative_time(7200) == "2h ago", "rel hours")
    assert(relative_time(172800) == "2d ago", "rel days")

    // Epoch round-trip
    assert(strptime("1970-01-01T00:00:00Z", "%Y-%m-%dT%H:%M:%SZ") == 0, "epoch parse")

    print("datefmtx: all passed")
