import std/collections/btreemap

fn cks(label, got, expected)
    if got == expected
        return 0
    print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
    exit(1)

fn cki(label, got, expected)
    if got == expected
        return 0
    print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
    exit(1)

fn main()
    let bt = bt_new()

    // Insert three keys out of sorted order
    bt_set(bt, "banana", "b")
    bt_set(bt, "apple", "a")
    bt_set(bt, "cherry", "c")

    // KAT 1: keys are sorted
    let ks = bt_keys(bt)
    cks("keys[0]", ks[0], "apple")
    cks("keys[1]", ks[1], "banana")
    cks("keys[2]", ks[2], "cherry")

    // KAT 2: get by key
    cks("get apple", bt_get(bt, "apple"), "a")
    cks("get banana", bt_get(bt, "banana"), "b")
    cks("get cherry", bt_get(bt, "cherry"), "c")

    // KAT 3: has — present and absent
    cki("has banana", bt_has(bt, "banana"), 1)
    cki("has z", bt_has(bt, "z"), 0)

    // KAT 4: len
    cki("len", bt_len(bt), 3)

    // KAT 5: floor queries
    // floor("bb") -> largest key <= "bb" -> "banana" (banana < bb < cherry)
    cks("floor bb", bt_floor(bt, "bb"), "banana")
    // floor("aa") -> no key <= "aa" (apple > aa) -> ""
    cks("floor aa", bt_floor(bt, "aa"), "")
    // floor("banana") -> exact match -> "banana"
    cks("floor banana", bt_floor(bt, "banana"), "banana")
    // floor("zz") -> largest key <= "zz" -> "cherry"
    cks("floor zz", bt_floor(bt, "zz"), "cherry")

    // KAT 6: ceiling queries
    // ceiling("bb") -> smallest key >= "bb" -> "cherry"
    cks("ceiling bb", bt_ceiling(bt, "bb"), "cherry")
    // ceiling("zz") -> no key >= "zz" -> ""
    cks("ceiling zz", bt_ceiling(bt, "zz"), "")
    // ceiling("apple") -> exact match -> "apple"
    cks("ceiling apple", bt_ceiling(bt, "apple"), "apple")
    // ceiling("aa") -> smallest key >= "aa" -> "apple"
    cks("ceiling aa", bt_ceiling(bt, "aa"), "apple")

    // KAT 7: update existing key keeps sort order unchanged
    bt_set(bt, "banana", "BANANA")
    cks("update banana", bt_get(bt, "banana"), "BANANA")
    cki("len after update", bt_len(bt), 3)
    let ks2 = bt_keys(bt)
    cks("order after update keys[0]", ks2[0], "apple")
    cks("order after update keys[1]", ks2[1], "banana")
    cks("order after update keys[2]", ks2[2], "cherry")

    print("_btreemap_test passed")
