// KAT test for std/data/polyline_decode
import std/data/polyline_decode
import std/data/polyline_encode

// Helper: check int equality.
fn cki(label: string, got: int, expected: int)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

// Helper: check string equality.
fn cks(label: string, got: string, expected: string)
    if got != expected
        print("FAIL " + label + ": got=" + got + " expected=" + expected)
        exit(1)

// Helper: float approximate comparison.
fn approx(a: float, b: float, tol: float) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    let r = 0
    if d <= tol
        r = 1
    r

// ── Empty string -> empty list ────────────────────────────────────────────────

let emp = polyline_decode("")
cki("empty_len", len(emp), 0)

// ── Canonical Google example ──────────────────────────────────────────────────

let canonical = "_p~iF~ps|U_ulLnnqC_mqNvxq" + chr(96) + "@"
let dec = polyline_decode(canonical)

cki("canonical_count", len(dec), 3)

// Point 0: [38.5, -120.2]
let p0 = dec[0]
let p0lat = p0[0]
let p0lng = p0[1]
cki("p0_lat", approx(p0lat, 38.5, 0.0001), 1)
cki("p0_lng", approx(p0lng, -120.2, 0.0001), 1)

// Point 1: [40.7, -120.95]
let p1 = dec[1]
let p1lat = p1[0]
let p1lng = p1[1]
cki("p1_lat", approx(p1lat, 40.7, 0.0001), 1)
cki("p1_lng", approx(p1lng, -120.95, 0.0001), 1)

// Point 2: [43.252, -126.453]
let p2 = dec[2]
let p2lat = p2[0]
let p2lng = p2[1]
cki("p2_lat", approx(p2lat, 43.252, 0.0001), 1)
cki("p2_lng", approx(p2lng, -126.453, 0.0001), 1)

// ── Round-trip: decode(encode(pts)) approx== pts within 0.00001 ──────────────

let tol = 0.00001
let orig = [[38.5, -120.2], [40.7, -120.95], [43.252, -126.453]]
let rt = polyline_decode(polyline_encode(orig))

cki("rt_count", len(rt), 3)

let r0 = rt[0]
let r0lat = r0[0]
let r0lng = r0[1]
cki("rt_p0_lat", approx(r0lat, 38.5, tol), 1)
cki("rt_p0_lng", approx(r0lng, -120.2, tol), 1)

let r1 = rt[1]
let r1lat = r1[0]
let r1lng = r1[1]
cki("rt_p1_lat", approx(r1lat, 40.7, tol), 1)
cki("rt_p1_lng", approx(r1lng, -120.95, tol), 1)

let r2 = rt[2]
let r2lat = r2[0]
let r2lng = r2[1]
cki("rt_p2_lat", approx(r2lat, 43.252, tol), 1)
cki("rt_p2_lng", approx(r2lng, -126.453, tol), 1)

// ── Single point round-trip ───────────────────────────────────────────────────

let sp = [[51.5074, -0.1278]]
let sp_rt = polyline_decode(polyline_encode(sp))
cki("single_len", len(sp_rt), 1)
let sq = sp_rt[0]
let sqlat = sq[0]
let sqlng = sq[1]
cki("single_lat", approx(sqlat, 51.5074, tol), 1)
cki("single_lng", approx(sqlng, -0.1278, tol), 1)

// ── Round-trip stability: encode(decode(encode(pts))) == encode(pts) ──────────

let enc1 = polyline_encode(orig)
let enc2 = polyline_encode(polyline_decode(enc1))
cks("stable_rt", enc1, enc2)

// ── Origin point ─────────────────────────────────────────────────────────────

let origin = polyline_decode(polyline_encode([[0.0, 0.0]]))
cki("origin_len", len(origin), 1)
let o0 = origin[0]
let o0lat = o0[0]
let o0lng = o0[1]
cki("origin_lat", approx(o0lat, 0.0, tol), 1)
cki("origin_lng", approx(o0lng, 0.0, tol), 1)

print("PASS _polyline_decode_test")
