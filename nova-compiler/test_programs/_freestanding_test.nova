// #27 no_std: exercises the core value allocator (nova_heap_alloc) heavily via struct
// allocation. Under -DNOVA_FREESTANDING these allocate from a STATIC buffer (no libc malloc);
// the result must match the normal build.
type Node
    val: int
    dbl: int

fn build(n: int) -> int
    let acc = 0
    let i = 0
    while i < n
        let nd = Node(i, i * 2)
        acc = acc + nd.val + nd.dbl
        i = i + 1
    acc

fn main()
    print(str(build(1000)))
