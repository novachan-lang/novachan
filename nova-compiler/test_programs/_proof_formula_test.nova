import std/proof/proof_formula

// cki — integer known-answer check.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _proof_formula_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb — boolean known-answer check.
fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL _proof_formula_test " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

// cks — string known-answer check.
fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL _proof_formula_test " + label + ": got=" + got + " want=" + want)
        exit(1)

// ckl — string list check.
fn ckl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL _proof_formula_test " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL _proof_formula_test " + label + "[" + str(i) + "]: got=" + got[i] + " want=" + want[i])
            exit(1)
        i = i + 1

fn main()
    // === Constructors: shape checks ===
    let va = pfm_var("a")
    cks("var_tag", va[0], "var")
    cks("var_name", va[1], "a")

    let nb = pfm_not(pfm_var("b"))
    cks("not_tag", nb[0], "not")

    let ab = pfm_and(pfm_var("a"), pfm_var("b"))
    cks("and_tag", ab[0], "and")

    let aob = pfm_or(pfm_var("a"), pfm_var("b"))
    cks("or_tag", aob[0], "or")

    let ai = pfm_imp(pfm_var("a"), pfm_var("b"))
    cks("imp_tag", ai[0], "imp")

    let bot = pfm_bot()
    cks("bot_tag", bot[0], "bot")

    let top = pfm_top()
    cks("top_tag", top[0], "top")

    // === pfm_eval with env ===
    // env: a=1, b=0
    let env10 = []
    let pa1 = []
    push(pa1, "a")
    push(pa1, 1)
    push(env10, pa1)
    let pb0 = []
    push(pb0, "b")
    push(pb0, 0)
    push(env10, pb0)

    // a&b under a=1,b=0 => 0 (spec KAT)
    let ab_f = pfm_and(pfm_var("a"), pfm_var("b"))
    cki("eval_and_10", pfm_eval(ab_f, env10), 0)

    // env a=1,b=1
    let env11 = []
    let pa1b = []
    push(pa1b, "a")
    push(pa1b, 1)
    push(env11, pa1b)
    let pb1 = []
    push(pb1, "b")
    push(pb1, 1)
    push(env11, pb1)
    cki("eval_and_11", pfm_eval(ab_f, env11), 1)

    // not(a) under a=1 => 0
    let na_f = pfm_not(pfm_var("a"))
    cki("eval_not_1", pfm_eval(na_f, env10), 0)
    // not(a) under a=0 (env11 has a=1, need new env)
    let env0 = []
    let pa0 = []
    push(pa0, "a")
    push(pa0, 0)
    push(env0, pa0)
    cki("eval_not_0", pfm_eval(na_f, env0), 1)

    // bot => 0, top => 1
    cki("eval_bot", pfm_eval(pfm_bot(), env10), 0)
    cki("eval_top", pfm_eval(pfm_top(), env10), 1)

    // imp(a,b) under a=1,b=0 => 0
    let imp_f = pfm_imp(pfm_var("a"), pfm_var("b"))
    cki("eval_imp_10", pfm_eval(imp_f, env10), 0)
    // imp(a,b) under a=0,b=0 => 1
    let env00 = []
    let pa0b = []
    push(pa0b, "a")
    push(pa0b, 0)
    push(env00, pa0b)
    let pb0b = []
    push(pb0b, "b")
    push(pb0b, 0)
    push(env00, pb0b)
    cki("eval_imp_00", pfm_eval(imp_f, env00), 1)
    // imp(a,b) under a=1,b=1 => 1
    cki("eval_imp_11", pfm_eval(imp_f, env11), 1)

    // or: a=1,b=0 => 1; a=0,b=0 => 0
    let or_f = pfm_or(pfm_var("a"), pfm_var("b"))
    cki("eval_or_10", pfm_eval(or_f, env10), 1)
    cki("eval_or_00", pfm_eval(or_f, env00), 0)

    // === pfm_vars (spec KAT: pfm_and(pfm_var("b"),pfm_var("a"))==["a","b"]) ===
    let ba_f = pfm_and(pfm_var("b"), pfm_var("a"))
    let ba_vars = pfm_vars(ba_f)
    let want_ab = []
    push(want_ab, "a")
    push(want_ab, "b")
    ckl("vars_ba_sorted", ba_vars, want_ab)

    // pfm_vars of complex formula
    let cplx = pfm_imp(pfm_and(pfm_var("c"), pfm_var("a")), pfm_var("b"))
    let cplx_vars = pfm_vars(cplx)
    let want_abc = []
    push(want_abc, "a")
    push(want_abc, "b")
    push(want_abc, "c")
    ckl("vars_complex_sorted", cplx_vars, want_abc)

    // pfm_vars deduplicates
    let dup_f = pfm_and(pfm_var("x"), pfm_var("x"))
    let dup_vars = pfm_vars(dup_f)
    let want_x = []
    push(want_x, "x")
    ckl("vars_dedup", dup_vars, want_x)

    // === pfm_is_tautology (spec KAT) ===
    // a->a is a tautology
    let aa_imp = pfm_imp(pfm_var("a"), pfm_var("a"))
    ckb("taut_a_imp_a", pfm_is_tautology(aa_imp), true)

    // a | not(a) is excluded middle
    let em = pfm_or(pfm_var("a"), pfm_not(pfm_var("a")))
    ckb("taut_excluded_middle", pfm_is_tautology(em), true)

    // a alone is NOT a tautology
    ckb("taut_var_false", pfm_is_tautology(pfm_var("a")), false)

    // (a&b)->a is a tautology (spec KAT)
    let conj_elim = pfm_imp(pfm_and(pfm_var("a"), pfm_var("b")), pfm_var("a"))
    ckb("taut_conj_elim", pfm_is_tautology(conj_elim), true)

    // bot is NOT a tautology
    ckb("taut_bot_false", pfm_is_tautology(pfm_bot()), false)

    // top is a tautology
    ckb("taut_top_true", pfm_is_tautology(pfm_top()), true)

    // (a->b) -> ((b->c) -> (a->c)): hypothetical syllogism
    let hyp_syl = pfm_imp(pfm_imp(pfm_var("a"), pfm_var("b")), pfm_imp(pfm_imp(pfm_var("b"), pfm_var("c")), pfm_imp(pfm_var("a"), pfm_var("c"))))
    ckb("taut_hyp_syl", pfm_is_tautology(hyp_syl), true)

    // a&b is NOT a tautology
    ckb("taut_and_false", pfm_is_tautology(pfm_and(pfm_var("a"), pfm_var("b"))), false)

    // === pfm_is_sat ===
    ckb("sat_var", pfm_is_sat(pfm_var("a")), true)
    ckb("sat_bot_false", pfm_is_sat(pfm_bot()), false)
    ckb("sat_top", pfm_is_sat(pfm_top()), true)
    // a & not(a) is UNSAT
    let contra = pfm_and(pfm_var("a"), pfm_not(pfm_var("a")))
    ckb("sat_contradiction_false", pfm_is_sat(contra), false)

    // === pfm_equal ===
    ckb("equal_var_same", pfm_equal(pfm_var("a"), pfm_var("a")), true)
    ckb("equal_var_diff", pfm_equal(pfm_var("a"), pfm_var("b")), false)
    ckb("equal_bot_top", pfm_equal(pfm_bot(), pfm_top()), false)
    ckb("equal_bot_bot", pfm_equal(pfm_bot(), pfm_bot()), true)
    ckb("equal_not", pfm_equal(pfm_not(pfm_var("a")), pfm_not(pfm_var("a"))), true)
    ckb("equal_not_diff", pfm_equal(pfm_not(pfm_var("a")), pfm_not(pfm_var("b"))), false)
    ckb("equal_and", pfm_equal(pfm_and(pfm_var("a"), pfm_var("b")), pfm_and(pfm_var("a"), pfm_var("b"))), true)

    // === pfm_size ===
    cki("size_var", pfm_size(pfm_var("a")), 1)
    cki("size_bot", pfm_size(pfm_bot()), 1)
    cki("size_top", pfm_size(pfm_top()), 1)
    cki("size_not", pfm_size(pfm_not(pfm_var("a"))), 2)
    cki("size_and", pfm_size(pfm_and(pfm_var("a"), pfm_var("b"))), 3)
    // (a&b)->c: imp(and(a,b),c) = 1 + 3 + 1 = 5
    cki("size_imp_and", pfm_size(pfm_imp(pfm_and(pfm_var("a"), pfm_var("b")), pfm_var("c"))), 5)

    // === CROSS-CHECK: tautology checker vs inline truth-table ===
    // For all formulas we declared tautologies, also brute-force verify with pfm_eval directly.
    // a->a over {a=0,a=1}: both should yield 1
    let env_a0 = []
    let pair_a0 = []
    push(pair_a0, "a")
    push(pair_a0, 0)
    push(env_a0, pair_a0)
    let env_a1 = []
    let pair_a1 = []
    push(pair_a1, "a")
    push(pair_a1, 1)
    push(env_a1, pair_a1)
    cki("xcheck_aa_imp_0", pfm_eval(aa_imp, env_a0), 1)
    cki("xcheck_aa_imp_1", pfm_eval(aa_imp, env_a1), 1)

    // excluded middle: a|~a over {a=0,a=1}: both should yield 1
    cki("xcheck_em_0", pfm_eval(em, env_a0), 1)
    cki("xcheck_em_1", pfm_eval(em, env_a1), 1)

    // (a&b)->a over all 4 assignments: all yield 1
    let i = 0
    while i < 4
        let env2 = []
        let pxa = []
        push(pxa, "a")
        push(pxa, (i >> 0) & 1)
        push(env2, pxa)
        let pxb = []
        push(pxb, "b")
        push(pxb, (i >> 1) & 1)
        push(env2, pxb)
        if pfm_eval(conj_elim, env2) != 1
            print("FAIL _proof_formula_test xcheck_conj_elim i=" + str(i))
            exit(1)
        i = i + 1

    // Verify non-tautology 'a' is indeed not always 1
    cki("xcheck_var_is_0_sometimes", pfm_eval(pfm_var("a"), env_a0), 0)
    cki("xcheck_var_is_1_sometimes", pfm_eval(pfm_var("a"), env_a1), 1)

    print("PASS _proof_formula_test")
