import forge_chain_of_resp

fn main()
    let c = cor_new()
    c = cor_add_handler(c, "auth", "auth_request")
    c = cor_add_handler(c, "cache", "cache_request")
    c = cor_add_handler(c, "db", "db_request")
    assert(cor_handler_count(c) == 3, "3 handlers")

    let r1 = cor_handle(c, "auth_request")
    c = r1["c"]
    assert(r1["handled"] == 1, "auth handled")
    assert(r1["handler"] == "auth", "by auth")

    let r2 = cor_handle(c, "db_request")
    c = r2["c"]
    assert(r2["handled"] == 1, "db handled")

    let r3 = cor_handle(c, "unknown_type")
    c = r3["c"]
    assert(r3["handled"] == 0, "unknown unhandled")
    assert(cor_total_handled(c) == 2, "2 handled")
    assert(cor_total_unhandled(c) == 1, "1 unhandled")
    assert(cor_handle_rate(c) == 66, "66% rate")

    c = cor_disable(c, "cache")
    let r4 = cor_handle(c, "cache_request")
    c = r4["c"]
    assert(r4["handled"] == 0, "cache disabled")

    print("CHAIN-OF-RESP KAT PASS")
