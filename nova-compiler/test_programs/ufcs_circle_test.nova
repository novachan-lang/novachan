type Rect
    x: Int
    y: Int
    w: Int
    h: Int

type Circle
    cx: Int
    cy: Int
    r: Int

fn Rect.contains(px, py)
    px >= self.x and px < self.x + self.w and py >= self.y and py < self.y + self.h

fn Circle.contains(px, py)
    let dx = px - self.cx
    let dy = py - self.cy
    dx * dx + dy * dy <= self.r * self.r

fn main()
    print("test 1: rect contains")
    let r = Rect { x: 0, y: 0, w: 10, h: 5 }
    let v1 = r.contains(5, 3)
    print("v1 = " + str(v1))
    assert(v1 == true, "rect contains inside")

    print("test 2: circle contains")
    let c = Circle { cx: 0, cy: 0, r: 5 }
    let v2 = c.contains(3, 4)
    print("v2 = " + str(v2))
    assert(v2 == true, "circle contains inside")

    print("ufcs_circle_test: all passed")
