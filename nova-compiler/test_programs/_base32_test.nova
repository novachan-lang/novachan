// KAT for std/encoding/base32 — RFC 4648 standard + base32hex + binary-safety (0x00 bytes).
import std/encoding/base32

fn _b(s: string) -> any     // ASCII text -> bytes (inputs here contain no 0x00)
    let out = bytes(0)
    let i = 0
    while i < len(s)
        out = bytes_append(out, ord(char_at(s, i)))
        i = i + 1
    return out

fn ck(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": '" + got + "' != '" + want + "'")
        exit(1)

fn main()
    ck("empty",  base32_encode(_b("")), "")
    ck("f",      base32_encode(_b("f")), "MY======")
    ck("fo",     base32_encode(_b("fo")), "MZXQ====")
    ck("foo",    base32_encode(_b("foo")), "MZXW6===")
    ck("foob",   base32_encode(_b("foob")), "MZXW6YQ=")
    ck("fooba",  base32_encode(_b("fooba")), "MZXW6YTB")
    ck("foobar", base32_encode(_b("foobar")), "MZXW6YTBOI======")
    ck("hex",    base32hex_encode(_b("foobar")), "CPNMUOJ1E8======")

    // binary-safety: [0x00, 0x01, 0x00, 0xFF] must encode + round-trip through the codec
    let bin = bytes(0)
    bin = bytes_append(bin, 0)
    bin = bytes_append(bin, 1)
    bin = bytes_append(bin, 0)
    bin = bytes_append(bin, 255)
    ck("bin-encode", base32_encode(bin), "AAAQB7Y=")
    let dec = base32_decode(base32_encode(bin))
    if bytes_len(dec) != 4
        print("FAIL bin roundtrip len " + str(bytes_len(dec)))
        exit(1)
    if bytes_get(dec, 0) != 0 or bytes_get(dec, 1) != 1 or bytes_get(dec, 2) != 0 or bytes_get(dec, 3) != 255
        print("FAIL bin roundtrip content")
        exit(1)
    print("_base32_test passed (RFC 4648 + base32hex + binary-safety)")
