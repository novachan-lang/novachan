import forge_sensor_aggregator

fn main()
    let s = sa_new()
    s = sa_register(s, "temp-1", "temperature")
    s = sa_register(s, "hum-1", "humidity")

    assert(sa_sensor_count(s) == 2, "2 sensors registered")

    let ty = sa_sensor_type(s, "temp-1")
    assert(is_ok(ty), "type lookup ok")
    assert(unwrap(ty) == "temperature", "temp-1 is temperature")

    assert(is_err(sa_latest(s, "temp-1")), "no readings yet errors")
    assert(is_err(sa_mean(s, "temp-1")), "mean with no readings errors")

    let r1 = sa_reading(s, "temp-1", 20.0, 1000)
    assert(is_ok(r1), "reading 1 ok")
    let r2 = sa_reading(s, "temp-1", 25.0, 1001)
    assert(is_ok(r2), "reading 2 ok")
    let r3 = sa_reading(s, "temp-1", 15.0, 1002)
    assert(is_ok(r3), "reading 3 ok")

    let lat = sa_latest(s, "temp-1")
    assert(is_ok(lat), "latest ok")
    assert(unwrap(lat) == 15.0, "latest is 15.0")

    let cnt = sa_count(s, "temp-1")
    assert(is_ok(cnt), "count ok")
    assert(unwrap(cnt) == 3, "3 readings")

    let mean = sa_mean(s, "temp-1")
    assert(is_ok(mean), "mean ok")
    assert(unwrap(mean) == 20.0, "mean is 20.0")

    let mn = sa_min_val(s, "temp-1")
    assert(is_ok(mn), "min ok")
    assert(unwrap(mn) == 15.0, "min is 15.0")

    let mx = sa_max_val(s, "temp-1")
    assert(is_ok(mx), "max ok")
    assert(unwrap(mx) == 25.0, "max is 25.0")

    let hr1 = sa_reading(s, "hum-1", 55.5, 1000)
    assert(is_ok(hr1), "hum reading 1 ok")
    let hr2 = sa_reading(s, "hum-1", 60.5, 1001)
    assert(is_ok(hr2), "hum reading 2 ok")

    assert(sa_total_readings(s) == 5, "5 total readings across sensors")

    let humCnt = sa_count(s, "hum-1")
    assert(unwrap(humCnt) == 2, "2 humidity readings")

    assert(is_err(sa_reading(s, "ghost", 1.0, 999)), "reading unknown sensor errors")
    assert(is_err(sa_latest(s, "ghost")), "latest unknown sensor errors")
    assert(is_err(sa_sensor_type(s, "ghost")), "type unknown sensor errors")

    print("SENSOR-AGGREGATOR KAT PASS")
