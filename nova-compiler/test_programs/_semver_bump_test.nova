import std/semver/semver_bump

fn cks(label, got, want)
    if got != want
        print("FAIL _semver_bump_test " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL _semver_bump_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    if got != want
        print("FAIL _semver_bump_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // --- svb_major ---
    cks("major_basic",     svb_major("1.2.3"),       "2.0.0")
    cks("major_pre_drop",  svb_major("1.2.3-alpha"),  "2.0.0")
    cks("major_0",         svb_major("0.9.9"),        "1.0.0")
    cks("major_large",     svb_major("10.5.2"),       "11.0.0")
    cks("major_build_drop",svb_major("1.2.3+build"),  "2.0.0")

    // --- svb_minor ---
    cks("minor_basic",     svb_minor("1.2.3"),        "1.3.0")
    cks("minor_1_0_0",     svb_minor("1.0.0"),        "1.1.0")
    cks("minor_pre_drop",  svb_minor("2.4.1-beta"),   "2.5.0")
    cks("minor_patch_reset",svb_minor("1.2.9"),       "1.3.0")
    cks("minor_build_drop",svb_minor("1.2.3+meta"),   "1.3.0")

    // --- svb_patch ---
    cks("patch_basic",     svb_patch("1.2.3"),        "1.2.4")
    cks("patch_pre_drop",  svb_patch("1.2.3-rc"),     "1.2.4")
    cks("patch_zero",      svb_patch("0.0.0"),        "0.0.1")
    cks("patch_build_drop",svb_patch("1.2.3+sha"),    "1.2.4")
    cks("patch_large",     svb_patch("1.2.99"),       "1.2.100")

    // --- svb_bump dispatch ---
    cks("bump_patch",  svb_bump("1.2.3", "patch"),  "1.2.4")
    cks("bump_minor",  svb_bump("1.2.3", "minor"),  "1.3.0")
    cks("bump_major",  svb_bump("1.2.3", "major"),  "2.0.0")
    cks("bump_unknown",svb_bump("1.2.3", "junk"),   "1.2.3")
    cks("bump_pre",    svb_bump("1.2.3-alpha","patch"),"1.2.4")

    print("PASS _semver_bump_test")
