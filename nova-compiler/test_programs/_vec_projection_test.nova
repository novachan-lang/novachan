import std/vector/vec_projection

fn cki(label: string, got: int, want: int)
    if got == want
        return
    print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
    exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got == want
        return
    print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
    exit(1)

fn ckl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + ": len " + str(len(got)) + " != " + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // vp_coeff([3,4],[1,0]) = 3/1 = [3,1]
    ckl("coeff_1", vp_coeff([3, 4], [1, 0]), [3, 1])
    // vp_coeff([2,2],[1,1]) = 4/2 = [2,1]
    ckl("coeff_2", vp_coeff([2, 2], [1, 1]), [2, 1])
    // vp_coeff([1,1],[2,0]) = 2/4 = [1,2]
    ckl("coeff_3", vp_coeff([1, 1], [2, 0]), [1, 2])
    // vp_is_orthogonal([1,0],[0,1]) = true (dot=0)
    ckb("orth_1", vp_is_orthogonal([1, 0], [0, 1]), true)
    // vp_is_parallel([1,2],[2,4]) = true
    ckb("par_1", vp_is_parallel([1, 2], [2, 4]), true)
    // vp_is_parallel([1,0],[0,1]) = false
    ckb("par_2", vp_is_parallel([1, 0], [0, 1]), false)
    // additional: zero b -> undefined coeff [0,0]
    ckl("coeff_zero_b", vp_coeff([1, 2], [0, 0]), [0, 0])
    // negative direction: coeff([3,4],[-1,0]) = -3/1 = [-3,1]
    ckl("coeff_neg", vp_coeff([3, 4], [-1, 0]), [-3, 1])
    // anti-parallel [1,2] and [-2,-4]: parallel (cos^2==1)
    ckb("par_anti", vp_is_parallel([1, 2], [-2, -4]), true)
    // orthogonality in 3D: [1,0,0] and [0,1,0]
    ckb("orth_3d", vp_is_orthogonal([1, 0, 0], [0, 1, 0]), true)
    // not orthogonal: [1,1] and [1,0]
    ckb("orth_no", vp_is_orthogonal([1, 1], [1, 0]), false)
    // vp_coeff([0,0],[1,0]) = 0/1 = [0,1]
    ckl("coeff_zero_a", vp_coeff([0, 0], [1, 0]), [0, 1])
    print("PASS _vec_projection_test")
