import forge_distributed_counter

fn main()
    let d = dc_new()
    d = dc_add_node(d, "node1")
    d = dc_add_node(d, "node2")
    d = dc_add_node(d, "node3")
    assert(dc_node_count(d) == 3, "3 nodes")

    let r1 = dc_increment(d, "node1", 5)
    assert(is_ok(r1), "inc ok")
    d = unwrap(r1)
    let r2 = dc_increment(d, "node2", 3)
    d = unwrap(r2)
    let r3 = dc_increment(d, "node3", 7)
    d = unwrap(r3)

    let v1 = dc_node_value(d, "node1")
    assert(unwrap(v1) == 5, "node1=5")

    let global = dc_global_value(d, "node1,node2,node3")
    assert(global == 15, "global=15")

    assert(dc_total_ops(d) == 3, "3 ops")

    let bad = dc_increment(d, "nope", 1)
    assert(is_err(bad), "not found")

    print("DISTRIBUTED-COUNTER KAT PASS")
