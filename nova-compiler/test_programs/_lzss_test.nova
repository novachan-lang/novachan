// KAT for std/compress/lzss — LZSS sliding-window compression
import std/compress/lzss

// Helper: convert string to byte-list
fn str_to_bytes(s) -> list
    let n = len(s)
    let out = []
    let i = 0
    while i < n
        push(out, ord(s[i]))
        i = i + 1
    out

// Helper: convert byte-list to string
fn bytes_to_str(bytes) -> string
    let n = len(bytes)
    let out = ""
    let i = 0
    while i < n
        out = out + chr(bytes[i])
        i = i + 1
    out

// Helper: check byte-list equality
fn bytes_eq(a, b) -> int
    let na = len(a)
    let nb = len(b)
    if na != nb
        return 0
    let i = 0
    while i < na
        if a[i] != b[i]
            return 0
        i = i + 1
    1

// Round-trip check for a string input
fn ckrt_str(label, s)
    let input = str_to_bytes(s)
    let compressed = lzss_compress(input)
    let recovered  = lzss_decompress(compressed)
    if bytes_eq(input, recovered) == 0
        print("FAIL lzss " + label + ": round-trip mismatch")
        print("  input len=" + str(len(input)) + " recovered len=" + str(len(recovered)))
        exit(1)

// Round-trip check for a raw byte-list
fn ckrt_bytes(label, input)
    let compressed = lzss_compress(input)
    let recovered  = lzss_decompress(compressed)
    if bytes_eq(input, recovered) == 0
        print("FAIL lzss " + label + ": round-trip mismatch")
        exit(1)

fn main()
    // KAT 1: empty input
    let empty = []
    let ec = lzss_compress(empty)
    let ed = lzss_decompress(ec)
    if len(ed) != 0
        print("FAIL lzss empty: expected 0 bytes, got " + str(len(ed)))
        exit(1)

    // KAT 2: single byte
    ckrt_str("single_a", "a")

    // KAT 3: all same bytes (highly repetitive — should compress well)
    let rep = []
    let ri = 0
    while ri < 100
        push(rep, 65)
        ri = ri + 1
    let rep_c = lzss_compress(rep)
    let rep_d = lzss_decompress(rep_c)
    if bytes_eq(rep, rep_d) == 0
        print("FAIL lzss repetitive: round-trip failed")
        exit(1)
    // Repetitive input must compress smaller than original
    if len(rep_c) >= len(rep)
        print("FAIL lzss repetitive: no compression (compressed=" + str(len(rep_c)) + " orig=" + str(len(rep)) + ")")
        exit(1)

    // KAT 4: classic LZ example
    ckrt_str("tobeornot", "TOBEORNOTTOBEORTOBEORNOT")

    // KAT 5: mixed bytes
    let mixed = []
    let mi = 0
    while mi < 50
        push(mixed, mi * 3 - (mi * 3 / 256) * 256)
        mi = mi + 1
    ckrt_bytes("mixed", mixed)

    // KAT 6: longer text
    ckrt_str("longer", "the quick brown fox jumps over the lazy dog the quick brown fox")

    // KAT 7: all distinct bytes (worst case for compression)
    let distinct = []
    let di = 0
    while di < 256
        push(distinct, di)
        di = di + 1
    ckrt_bytes("distinct_256", distinct)

    // KAT 8: ababab pattern
    ckrt_str("ababab", "ababababababababab")

    // KAT 9: longer repetitive sequence — verify compression ratio
    let longrep = []
    let lri = 0
    while lri < 200
        push(longrep, 97)
        lri = lri + 1
    let longrep_c = lzss_compress(longrep)
    let longrep_d = lzss_decompress(longrep_c)
    if bytes_eq(longrep, longrep_d) == 0
        print("FAIL lzss longrep: round-trip failed")
        exit(1)
    if len(longrep_c) >= len(longrep)
        print("FAIL lzss longrep: not compressed (c=" + str(len(longrep_c)) + " orig=200)")
        exit(1)

    print("PASS _lzss_test")
