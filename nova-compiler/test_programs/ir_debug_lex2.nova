fn is_alpha(ch: string) -> bool
    let c = ord(ch)
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or ch == "_"

fn test_basics()
    let s = "let x = 42"
    print("len: " + str(len(s)))
    print("s[0]: '" + s[0] + "'")
    print("s[1]: '" + s[1] + "'")
    print("s[2]: '" + s[2] + "'")
    print("ord(l): " + str(ord("l")))
    print("is_alpha(l): " + str(is_alpha("l")))
    print("is_alpha(s[0]): " + str(is_alpha(s[0])))

    // Test the while loop condition
    let pos = 0
    let length = len(s)
    let ch = s[pos]
    print("ch: '" + ch + "'")
    print("pos < length: " + str(pos < length))
    print("is_alpha(ch): " + str(is_alpha(ch)))

    // Now test the actual while condition
    print("Testing while loop...")
    let word = ""
    while pos < length and is_alpha(s[pos])
        word = word + s[pos]
        pos = pos + 1
    print("word: '" + word + "'")
    print("pos after: " + str(pos))

test_basics()
