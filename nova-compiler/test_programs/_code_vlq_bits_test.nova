// KAT test for std/compress/code_vlq_bits
// Bit-level VLQ / variable-bit varint — continuation-bit + w-data-bit groups.
import std/compress/code_vlq_bits

// ── Helpers ───────────────────────────────────────────────────────────────────

fn _cvbt_list_eq(a, b) -> int
    let la = len(a)
    let lb = len(b)
    if la != lb
        return 0
    let i = 0
    while i < la
        if a[i] != b[i]
            return 0
        i = i + 1
    1

fn _cvbt_lst_str(lst) -> any
    let s = "["
    let i = 0
    let n = len(lst)
    while i < n
        s = s + str(lst[i])
        if i < n - 1
            s = s + ","
        i = i + 1
    s = s + "]"
    s

fn ckl(label, got, want) -> int
    if _cvbt_list_eq(got, want) == 0
        print("FAIL " + label + ": got=" + _cvbt_lst_str(got) + " want=" + _cvbt_lst_str(want))
        exit(1)
    0

fn cki(label, got, want) -> int
    if got != want
        print("FAIL code_vlq_bits " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)
    0

// ── KAT 1: vlqb_encode(0, 3) == [0,0,0,0] ────────────────────────────────────
// n=0, w=3: one group (n fits in 3 bits).
// cont=0 (last/only group), 3 data bits = 000.
// Output: [0, 0,0,0]
fn test_encode_0_w3() -> int
    let want = [0, 0, 0, 0]
    let got = vlqb_encode(0, 3)
    ckl("vlqb_encode(0,3)", got, want)

// ── KAT 2: vlqb_encode(7, 3) == [0,1,1,1] ────────────────────────────────────
// n=7=0b111, w=3: one group, cont=0, data=111.
fn test_encode_7_w3() -> int
    let want = [0, 1, 1, 1]
    let got = vlqb_encode(7, 3)
    ckl("vlqb_encode(7,3)", got, want)

// ── KAT 3: vlqb_encode(8, 3) — first continuation bit set ────────────────────
// n=8=0b001_000, w=3: 2 groups: g0=001 (MSB), g1=000 (LSB).
// Emit g0 with cont=1: [1, 0,0,1]
// Emit g1 with cont=0: [0, 0,0,0]
// Full: [1,0,0,1, 0,0,0,0]
fn test_encode_8_w3() -> int
    let want = [1, 0, 0, 1, 0, 0, 0, 0]
    let got = vlqb_encode(8, 3)
    ckl("vlqb_encode(8,3)", got, want)

// ── KAT 4: vlqb_encode(63, 3) — exactly fills 2 groups ───────────────────────
// n=63=0b111_111, w=3: 2 groups: g0=111, g1=111.
// [1,1,1,1, 0,1,1,1]
fn test_encode_63_w3() -> int
    let want = [1, 1, 1, 1, 0, 1, 1, 1]
    let got = vlqb_encode(63, 3)
    ckl("vlqb_encode(63,3)", got, want)

// ── KAT 5: vlqb_encode(0, 4) == [0,0,0,0,0] — w=4 boundary ──────────────────
fn test_encode_0_w4() -> int
    let want = [0, 0, 0, 0, 0]
    let got = vlqb_encode(0, 4)
    ckl("vlqb_encode(0,4)", got, want)

// ── KAT 6: vlqb_encode(15, 4) == [0,1,1,1,1] — max single group w=4 ─────────
fn test_encode_15_w4() -> int
    let want = [0, 1, 1, 1, 1]
    let got = vlqb_encode(15, 4)
    ckl("vlqb_encode(15,4)", got, want)

// ── KAT 7: vlqb_encode(16, 4) — two groups w=4 ───────────────────────────────
// n=16=0b0001_0000, w=4: g0=0001, g1=0000.
// [1,0,0,0,1, 0,0,0,0,0]
fn test_encode_16_w4() -> int
    let want = [1, 0, 0, 0, 1, 0, 0, 0, 0, 0]
    let got = vlqb_encode(16, 4)
    ckl("vlqb_encode(16,4)", got, want)

// ── KAT 8: guard — vlqb_encode(-1, 3) == [] ──────────────────────────────────
fn test_encode_neg() -> int
    let got = vlqb_encode(-1, 3)
    cki("vlqb_encode(-1,3) len", len(got), 0)

// ── KAT 9: guard — vlqb_encode(5, 0) == [] ───────────────────────────────────
fn test_encode_w0() -> int
    let got = vlqb_encode(5, 0)
    cki("vlqb_encode(5,0) len", len(got), 0)

// ── KAT 10: decode the encode(0,3) vector ─────────────────────────────────────
fn test_decode_0_w3() -> int
    let bits = [0, 0, 0, 0]
    let got = vlqb_decode(bits, 0, 3)
    cki("vlqb_decode(0,3).val",  got[0], 0)
    cki("vlqb_decode(0,3).pos",  got[1], 4)

// ── KAT 11: decode encode(8,3) ────────────────────────────────────────────────
fn test_decode_8_w3() -> int
    let bits = [1, 0, 0, 1, 0, 0, 0, 0]
    let got = vlqb_decode(bits, 0, 3)
    cki("vlqb_decode(8,3).val",  got[0], 8)
    cki("vlqb_decode(8,3).pos",  got[1], 8)

// ── KAT 12: decode at non-zero offset ─────────────────────────────────────────
// Prefix a dummy byte [0,0,0,0] then encode(7,3)=[0,1,1,1] at pos=4.
fn test_decode_offset() -> int
    let bits = [0, 0, 0, 0, 0, 1, 1, 1]
    let got = vlqb_decode(bits, 4, 3)
    cki("vlqb_decode_offset.val", got[0], 7)
    cki("vlqb_decode_offset.pos", got[1], 8)

// ── KAT 13: truncated input returns -1 ───────────────────────────────────────
fn test_decode_truncated() -> int
    let bits = [1, 0]
    let got = vlqb_decode(bits, 0, 3)
    cki("vlqb_decode_trunc.val", got[0], -1)

// ── KAT 14: round-trip w=3, n=0..100 ─────────────────────────────────────────
fn test_rt_w3() -> int
    let n = 0
    while n <= 100
        let _u = 0
        let enc = vlqb_encode(n, 3)
        let dec = vlqb_decode(enc, 0, 3)
        if dec[0] != n
            print("FAIL rt_w3 n=" + str(n) + ": got=" + str(dec[0]))
            exit(1)
        if dec[1] != len(enc)
            print("FAIL rt_w3 pos n=" + str(n) + ": got=" + str(dec[1]) + " want=" + str(len(enc)))
            exit(1)
        n = n + 1
    0

// ── KAT 15: round-trip w=4, n=0..1000 ───────────────────────────────────────
fn test_rt_w4() -> int
    let n = 0
    while n <= 1000
        let _u = 0
        let enc = vlqb_encode(n, 4)
        let dec = vlqb_decode(enc, 0, 4)
        if dec[0] != n
            print("FAIL rt_w4 n=" + str(n) + ": got=" + str(dec[0]))
            exit(1)
        if dec[1] != len(enc)
            print("FAIL rt_w4 pos n=" + str(n) + ": got=" + str(dec[1]) + " want=" + str(len(enc)))
            exit(1)
        n = n + 1
    0

// ── KAT 16: round-trip w=7, n=0..1000 ───────────────────────────────────────
fn test_rt_w7() -> int
    let n = 0
    while n <= 1000
        let _u = 0
        let enc = vlqb_encode(n, 7)
        let dec = vlqb_decode(enc, 0, 7)
        if dec[0] != n
            print("FAIL rt_w7 n=" + str(n) + ": got=" + str(dec[0]))
            exit(1)
        if dec[1] != len(enc)
            print("FAIL rt_w7 pos n=" + str(n) + ": got=" + str(dec[1]) + " want=" + str(len(enc)))
            exit(1)
        n = n + 1
    0

// ── KAT 17: vlqb_encode_bytes round-trip n=0..100000 ────────────────────────
fn test_rt_bytes() -> int
    let n = 0
    while n <= 100000
        let _u = 0
        let enc = vlqb_encode_bytes(n)
        let dec = vlqb_decode(enc, 0, 7)
        if dec[0] != n
            print("FAIL rt_bytes n=" + str(n) + ": got=" + str(dec[0]))
            exit(1)
        if dec[1] != len(enc)
            print("FAIL rt_bytes pos n=" + str(n) + ": got=" + str(dec[1]) + " want=" + str(len(enc)))
            exit(1)
        n = n + 1
    0

// ── KAT 18: sequence round-trip (concatenated stream) ────────────────────────
// Encode [10, 200, 0, 63, 1000] with w=4 concatenated; decode back in order.
fn test_sequence_w4() -> int
    let vals = [10, 200, 0, 63, 1000]
    // build concatenated bit list
    let stream = []
    let i = 0
    while i < 5
        let _u = 0
        let enc = vlqb_encode(vals[i], 4)
        let j = 0
        let elen = len(enc)
        while j < elen
            let _u2 = 0
            push(stream, enc[j])
            j = j + 1
        i = i + 1
    // decode back
    let pos = 0
    let k = 0
    while k < 5
        let _u = 0
        let dec = vlqb_decode(stream, pos, 4)
        if dec[0] != vals[k]
            print("FAIL seq_w4 k=" + str(k) + ": got=" + str(dec[0]) + " want=" + str(vals[k]))
            exit(1)
        pos = dec[1]
        k = k + 1
    0

// ── KAT 19: vlqb_pack_bits basic ─────────────────────────────────────────────
// pack_bits([1,0,1,1,0,0,1,0]) = [178]   (0b10110010)
// pack_bits([1,1]) = [192]               (0b11000000 — zero-padded)
fn test_pack_bits() -> int
    let bits1 = [1, 0, 1, 1, 0, 0, 1, 0]
    let got1 = vlqb_pack_bits(bits1)
    cki("pack_bits full byte", got1[0], 178)
    let bits2 = [1, 1]
    let got2 = vlqb_pack_bits(bits2)
    cki("pack_bits padded", got2[0], 192)
    0

// ── KAT 20: encode_bytes bit structure for n=128 ────────────────────────────
// n=128=0b1000000, w=7: 2 groups: g0=0000001 (MSB), g1=0000000 (LSB).
// g0 with cont=1: [1, 0,0,0,0,0,0,1] = 8 bits
// g1 with cont=0: [0, 0,0,0,0,0,0,0] = 8 bits
// total 16 bits.
fn test_encode_bytes_128() -> int
    let got = vlqb_encode_bytes(128)
    cki("encode_bytes(128) len", len(got), 16)
    cki("encode_bytes(128) g0_cont", got[0], 1)
    cki("encode_bytes(128) g0_lsb", got[7], 1)
    cki("encode_bytes(128) g1_cont", got[8], 0)
    0

// ── Entry point ───────────────────────────────────────────────────────────────
fn main() -> int
    test_encode_0_w3()
    test_encode_7_w3()
    test_encode_8_w3()
    test_encode_63_w3()
    test_encode_0_w4()
    test_encode_15_w4()
    test_encode_16_w4()
    test_encode_neg()
    test_encode_w0()
    test_decode_0_w3()
    test_decode_8_w3()
    test_decode_offset()
    test_decode_truncated()
    test_rt_w3()
    test_rt_w4()
    test_rt_w7()
    test_rt_bytes()
    test_sequence_w4()
    test_pack_bits()
    test_encode_bytes_128()
    print("PASS _code_vlq_bits_test")
    0
