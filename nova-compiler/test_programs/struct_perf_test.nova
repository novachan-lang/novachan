// Stage 1: unannotated struct params get their INFERRED struct type at codegen,
// so field access + arithmetic lowers natively (fmul/mul, not nova_rt_mul).
// This test verifies CORRECTNESS (the typed path computes the right values).

type Point
    x: float
    y: float

fn dot(a, b)
    a.x * b.x + a.y * b.y

fn scale(p, k)
    Point { x: p.x * k, y: p.y * k }

let p = Point { x: 1.5, y: 2.5 }
let q = Point { x: 3.0, y: 4.0 }
assert(dot(p, q) == 14.5, "dot product (1.5*3 + 2.5*4 = 14.5)")
let s = scale(p, 2.0)
assert(s.x == 3.0, "scale x")
assert(s.y == 5.0, "scale y")

type Vec2i
    a: int
    b: int

fn isum(v, w)
    v.a * w.a + v.b * w.b

let vi = Vec2i { a: 2, b: 3 }
let wi = Vec2i { a: 4, b: 5 }
assert(isum(vi, wi) == 23, "int dot (2*4 + 3*5 = 23)")

// nested call: unannotated struct param flows through
fn norm_sq(a)
    dot(a, a)

assert(norm_sq(q) == 25.0, "norm_sq (3*3+4*4=25)")

print("struct perf test passed")
