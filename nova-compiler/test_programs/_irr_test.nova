import std/finance/irr

// ckf: check float with tolerance; print FAIL and exit(1) on failure
fn ckf(name: string, got: float, want: float, eps: float)
    let diff = got - want
    let adiff = diff
    if diff < 0.0
        adiff = diff * -1.0
    if adiff > eps
        print("FAIL " + name + ": got=" + str(got) + " want=" + str(want) + " eps=" + str(eps))
        exit(1)

fn main()
    // KAT 1: irr_compute on 5-year investment
    // [-1000, 500, 400, 300, 100] -> IRR ~ 0.14489 (spec says within 0.001 of 0.1443)
    let cf1 = [-1000.0, 500.0, 400.0, 300.0, 100.0]
    let irr1 = irr_compute(cf1)
    ckf("irr1", irr1, 0.1443, 0.001)

    // KAT 2: single period [-100, 110] -> IRR = 0.10 exactly
    let cf2 = [-100.0, 110.0]
    let irr2 = irr_compute(cf2)
    ckf("irr2", irr2, 0.10, 0.0001)

    // KAT 3: two periods [-100, 0, 121] -> IRR = 0.10 exactly
    let cf3 = [-100.0, 0.0, 121.0]
    let irr3 = irr_compute(cf3)
    ckf("irr3", irr3, 0.10, 0.0001)

    // KAT 4: irr_npv at the computed IRR should be near zero (eps=0.5 per spec)
    // Use the COMPUTED irr1 (not hardcoded 0.1443) for near-zero check
    let npv_at_irr = irr_npv(irr1, cf1)
    ckf("npv_at_irr", npv_at_irr, 0.0, 0.5)

    // KAT 5: irr_npv at 10% on [-100, 110] should be 0.0
    let npv2 = irr_npv(0.10, cf2)
    ckf("npv2_at_10pct", npv2, 0.0, 0.0001)

    // KAT 6: MIRR with same finance and reinvest rate on [-100, 0, 121]
    // PV_neg_abs = 100, FV_pos = 121*(1.10)^0 = 121, n=3
    // MIRR = (121/100)^(1/2) - 1 = 0.10
    let cf6 = [-100.0, 0.0, 121.0]
    let mirr6 = irr_mirr(cf6, 0.10, 0.10)
    ckf("mirr6", mirr6, 0.10, 0.0001)

    // KAT 7: MIRR on [-1000, 200, 300, 400, 500] at finance=10%, reinvest=12%
    // pv_neg_abs = 1000, fv_pos = 1605.306
    // MIRR = (1605.306/1000)^(1/4) - 1 ~ 0.1256
    let cf7 = [-1000.0, 200.0, 300.0, 400.0, 500.0]
    let mirr7 = irr_mirr(cf7, 0.10, 0.12)
    ckf("mirr7", mirr7, 0.1256, 0.001)

    // KAT 8: irr_npv at 0% is just sum of cashflows
    // [-100, 110]: NPV at 0% = -100 + 110 = 10
    let npv3 = irr_npv(0.0, cf2)
    ckf("npv3_at_0pct", npv3, 10.0, 0.0001)

    print("_irr_test passed")
