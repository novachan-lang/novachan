import forge_iot_geofence

fn main()
    let s = gf_new()
    assert(gf_zone_count(s) == 0, "0 zones")
    assert(gf_has_zone(s, "office") == 0, "no office yet")

    s = gf_add_zone(s, "office", 100, 100, 10)
    s = gf_add_zone(s, "warehouse", 200, 200, 5)
    assert(gf_zone_count(s) == 2, "2 zones")
    assert(gf_has_zone(s, "office") == 1, "has office")

    let rad = gf_zone_radius(s, "office")
    assert(is_ok(rad), "radius ok")
    assert(unwrap(rad) == 10, "radius 10")

    let radm = gf_zone_radius(s, "nope")
    assert(is_err(radm), "radius missing zone errs")

    let c1 = gf_check(s, "office", 100, 100)
    assert(is_ok(c1), "check ok")
    assert(unwrap(c1) == "inside", "center is inside")

    let c2 = gf_check(s, "office", 105, 100)
    assert(unwrap(c2) == "inside", "5 units away is inside (radius 10)")

    let c3 = gf_check(s, "office", 200, 200)
    assert(unwrap(c3) == "outside", "far point is outside")

    let cm = gf_check(s, "nope", 0, 0)
    assert(is_err(cm), "check missing zone errs")

    assert(gf_events(s) == 3, "3 check events recorded")

    let ic = gf_inside_count(s, "office")
    assert(is_ok(ic), "inside count ok")
    assert(unwrap(ic) == 2, "2 inside hits on office")

    let icw = gf_inside_count(s, "warehouse")
    assert(unwrap(icw) == 0, "0 inside hits on warehouse")

    let icm = gf_inside_count(s, "nope")
    assert(is_err(icm), "inside count missing zone errs")

    let near = gf_nearest_zone(s, 190, 190)
    assert(is_ok(near), "nearest ok")
    assert(unwrap(near) == "warehouse", "warehouse is nearest to (190,190)")

    let near2 = gf_nearest_zone(s, 102, 102)
    assert(unwrap(near2) == "office", "office is nearest to (102,102)")

    let empty = gf_new()
    let neme = gf_nearest_zone(empty, 0, 0)
    assert(is_err(neme), "nearest on empty store errs")

    print("IOT-GEOFENCE KAT PASS")
