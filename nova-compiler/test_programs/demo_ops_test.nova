// NOVA Ops v0.1 demo: generate a Dockerfile + GitHub Actions workflow
// for a NOVA project. Also exercise healthcheck against the in-process
// HTTP server from earlier demos (Forge composition).
import ops
import forge

fn route(method: string, path: string, body: string) -> string
    if method == "GET" and path == "/ready"
        forge.text(200, "READY")
    else
        forge.text(404, "no")

fn main()
    // 1. Dockerfile contains required directives
    let df = ops.dockerfile("myapp", 8080)
    if find(df, "FROM debian:bookworm-slim") < 0
        print("FAIL dockerfile base: " + df)
        exit(1)
    if find(df, "EXPOSE 8080") < 0
        print("FAIL dockerfile EXPOSE: " + df)
        exit(1)
    if find(df, "CMD [\"/app/myapp\"]") < 0
        print("FAIL dockerfile CMD: " + df)
        exit(1)

    // 2. GitHub workflow contains required fields
    let yml = ops.github_workflow("ci", "ubuntu-latest")
    if find(yml, "name: ci") < 0
        print("FAIL workflow name: " + yml)
        exit(1)
    if find(yml, "runs-on: ubuntu-latest") < 0
        print("FAIL workflow runs-on: " + yml)
        exit(1)
    if find(yml, "nova build") < 0 or find(yml, "nova test") < 0
        print("FAIL workflow commands: " + yml)
        exit(1)

    // 3. healthcheck polls a real Forge server
    let port = 18901
    spawn fn()
        forge.serve_n(port, route, 1)
    let url = "http://127.0.0.1:" + str(port) + "/ready"
    let ok = ops.healthcheck(url, "READY", 5, 100)
    if not ok
        print("FAIL healthcheck against forge: did not get READY")
        exit(1)

    print("OPS v0.1 demo passed: dockerfile + github workflow text gen verified; healthcheck polled in-process forge server until READY")
