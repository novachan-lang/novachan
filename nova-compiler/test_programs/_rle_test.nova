// KAT test for std/compress/rle
// Covers: round-trip (decompress(compress(x))==x), structural compress output,
//         compress_str, decompress_str, and ratio.
import std/compress/rle

// ── Helper: check two strings are equal ──────────────────────────────────────
fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

// ── Helper: check two ints are equal ─────────────────────────────────────────
fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ── KAT 1: round-trip — empty string ─────────────────────────────────────────
let rt1 = rlc_decompress(rlc_compress(""))
cks("rt_empty", rt1, "")

// ── KAT 2: round-trip — single character ─────────────────────────────────────
let rt2 = rlc_decompress(rlc_compress("a"))
cks("rt_single", rt2, "a")

// ── KAT 3: round-trip — mixed runs "aaabbc" ──────────────────────────────────
let rt3 = rlc_decompress(rlc_compress("aaabbc"))
cks("rt_aaabbc", rt3, "aaabbc")

// ── KAT 4: round-trip — no repetition "abcdef" ───────────────────────────────
let rt4 = rlc_decompress(rlc_compress("abcdef"))
cks("rt_abcdef", rt4, "abcdef")

// ── KAT 5: round-trip — longer mixed input ───────────────────────────────────
let rt5 = rlc_decompress(rlc_compress("wwwwaaadexxxxxx"))
cks("rt_wwwwaaadexxxxxx", rt5, "wwwwaaadexxxxxx")

// ── KAT 6: structural — rlc_compress("aaabbc") == [["a",3],["b",2],["c",1]] ─
let comp6 = rlc_compress("aaabbc")
cki("compress_len", len(comp6), 3)
let run6a = comp6[0]
let run6b = comp6[1]
let run6c = comp6[2]
cks("compress_run0_ch", run6a[0], "a")
cki("compress_run0_cnt", run6a[1], 3)
cks("compress_run1_ch", run6b[0], "b")
cki("compress_run1_cnt", run6b[1], 2)
cks("compress_run2_ch", run6c[0], "c")
cki("compress_run2_cnt", run6c[1], 1)

// ── KAT 7: rlc_compress_str("aaabbc") == "3a2b1c" ───────────────────────────
let cs7 = rlc_compress_str("aaabbc")
cks("compress_str_aaabbc", cs7, "3a2b1c")

// ── KAT 8: rlc_compress_str — no repetition ──────────────────────────────────
let cs8 = rlc_compress_str("abcdef")
cks("compress_str_abcdef", cs8, "1a1b1c1d1e1f")

// ── KAT 9: rlc_decompress_str("3a2b1c") == "aaabbc" ─────────────────────────
let ds9 = rlc_decompress_str("3a2b1c")
cks("decompress_str_3a2b1c", ds9, "aaabbc")

// ── KAT 10: rlc_decompress_str — empty ───────────────────────────────────────
let ds10 = rlc_decompress_str("")
cks("decompress_str_empty", ds10, "")

// ── KAT 11: rlc_decompress_str — single run ──────────────────────────────────
let ds11 = rlc_decompress_str("1a")
cks("decompress_str_1a", ds11, "a")

// ── KAT 12: rlc_decompress_str round-trip via compress_str ───────────────────
let ds12 = rlc_decompress_str(rlc_compress_str("wwwwaaadexxxxxx"))
cks("decompress_str_rt_long", ds12, "wwwwaaadexxxxxx")

// ── KAT 13: rlc_ratio — highly compressible ──────────────────────────────────
// "aaaaaaa" -> "7a" (2 bytes for 7) -> ratio ~= 0.2857
let ratio13 = rlc_ratio("aaaaaaa")
// ratio < 1.0 confirms compression helped
if ratio13 >= 1.0
    print("FAIL ratio_compressible: expected ratio < 1.0, got " + str(ratio13))
    exit(1)

// ── KAT 14: rlc_ratio — non-compressible ─────────────────────────────────────
// "abcdef" -> "1a1b1c1d1e1f" (12 bytes for 6) -> ratio = 2.0
let ratio14 = rlc_ratio("abcdef")
if ratio14 <= 1.0
    print("FAIL ratio_noncompressible: expected ratio > 1.0, got " + str(ratio14))
    exit(1)

// ── KAT 15: rlc_ratio — empty ────────────────────────────────────────────────
let ratio15 = rlc_ratio("")
// By spec returns 1.0 for empty
if ratio15 < 0.99 or ratio15 > 1.01
    print("FAIL ratio_empty: expected ~1.0, got " + str(ratio15))
    exit(1)

print("_rle_test passed")
