import forge_anomaly_detector

fn main()
    let a = ad_new(2)
    a = ad_record(a, 10)
    a = ad_record(a, 12)
    a = ad_record(a, 11)
    a = ad_record(a, 10)
    a = ad_record(a, 13)
    assert(ad_sample_count(a) == 5, "5 samples")

    let m = ad_mean(a)
    assert(is_ok(m), "mean ok")

    let r1 = ad_is_anomaly(a, 11)
    assert(is_ok(r1), "check normal ok")
    assert(unwrap(r1) == 0, "11 is normal")

    let r2 = ad_is_anomaly(a, 100)
    assert(is_ok(r2), "check anomaly ok")
    assert(unwrap(r2) == 1, "100 is anomaly")
    assert(ad_anomaly_count(a) == 1, "1 anomaly")

    let empty = ad_new(2)
    assert(is_err(ad_is_anomaly(empty, 5)), "too few samples")
    assert(is_err(ad_mean(empty)), "no data")

    print("ANOMALY-DETECTOR KAT PASS")
