import std/poly/polyderiv

fn approx(a, b, tol) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < tol
        return 1
    return 0

fn ckf(label, got, want, tol)
    if approx(got, want, tol) == 0
        print("FAIL polyderiv " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL polyderiv " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck_flist(label, got, want, tol)
    let lg = len(got)
    let lw = len(want)
    if lg != lw
        print("FAIL polyderiv " + label + " len: got=" + str(lg) + " want=" + str(lw))
        exit(1)
    let i = 0
    while i < lw
        let gv = got[i] * 1.0
        let wv = want[i] * 1.0
        if approx(gv, wv, tol) == 0
            print("FAIL polyderiv " + label + "[" + str(i) + "]: got=" + str(gv) + " want=" + str(wv))
            exit(1)
        i = i + 1

fn main()
    let eps = 0.0001

    // pder_derivative([1,2,3]) = [2,6]  (d/dx(1+2x+3x^2) = 2+6x)
    let p1 = [1, 2, 3]
    let d1 = pder_derivative(p1)
    let w1 = [2.0, 6.0]
    ck_flist("deriv_1_2_3", d1, w1, eps)

    // pder_derivative([5]) = []  (constant -> zero poly)
    let p2 = [5]
    let d2 = pder_derivative(p2)
    cki("deriv_const_len", len(d2), 0)

    // pder_derivative([0,0,0,1]) = [0,0,3]  (d/dx x^3 = 3x^2)
    let p3 = [0, 0, 0, 1]
    let d3 = pder_derivative(p3)
    let w3 = [0.0, 0.0, 3.0]
    ck_flist("deriv_x3", d3, w3, eps)

    // pder_nth_derivative([1,2,3,4], 2) = [6,24]  (2nd derivative)
    // p=1+2x+3x^2+4x^3; p'=2+6x+12x^2; p''=6+24x
    let p4 = [1, 2, 3, 4]
    let d4 = pder_nth_derivative(p4, 2)
    let w4 = [6.0, 24.0]
    ck_flist("nth_deriv_2", d4, w4, eps)

    // pder_antiderivative([2,6]) = [0,2,3]  (integral of 2+6x = 0 + 2x + 3x^2)
    let p5 = [2, 6]
    let a5 = pder_antiderivative(p5)
    let w5 = [0.0, 2.0, 3.0]
    ck_flist("antideriv_2_6", a5, w5, eps)

    // pder_definite_integral([0,1], 0.0, 2.0) = 2.0  (integral of x from 0 to 2 = 2)
    let p6 = [0, 1]
    let di6 = pder_definite_integral(p6, 0.0, 2.0)
    ckf("defint_x_0_to_2", di6, 2.0, eps)

    // pder_derivative([]) = []
    let p7 = []
    let d7 = pder_derivative(p7)
    cki("deriv_empty", len(d7), 0)

    // pder_is_constant([5]) = 1
    cki("is_const_5", pder_is_constant([5]), 1)
    // pder_is_constant([1,2]) = 0
    cki("is_const_1_2", pder_is_constant([1, 2]), 0)
    // pder_is_constant([]) = 1
    cki("is_const_empty", pder_is_constant([]), 1)

    // pder_taylor_coeff([1,2,3], 1) = 2.0
    let tc = pder_taylor_coeff(p1, 1)
    ckf("taylor_coeff_1", tc, 2.0, eps)
    // pder_taylor_coeff([1,2,3], 5) = 0.0  (out of range)
    let tc2 = pder_taylor_coeff(p1, 5)
    ckf("taylor_coeff_oob", tc2, 0.0, eps)

    // round-trip: integral then derivative
    // antiderivative([1,2,3]) = [0, 1, 1, 1]  (0 + x + x^2 + x^3)
    let rt_anti = pder_antiderivative(p1)
    let rt_back = pder_derivative(rt_anti)
    // should give back [1,2,3] as floats
    let w_rt = [1.0, 2.0, 3.0]
    ck_flist("roundtrip_integ_deriv", rt_back, w_rt, eps)

    // integral with constant: pder_integral([1,0], 5.0) = [5.0, 1.0, 0.0]
    // integral of 1 + 0*x with c=5 => 5 + x + 0*x^2 = [5.0, 1.0]
    let p8 = [1, 0]
    let ig8 = pder_integral(p8, 5.0)
    let w8 = [5.0, 1.0, 0.0]
    ck_flist("integral_with_c", ig8, w8, eps)

    print("PASS _polyderiv_test")
