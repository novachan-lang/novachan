// KAT probe for std/data/sub_vtt_parse
// Spec: parse "WEBVTT\n\n00:00:01.000 --> 00:00:04.000\nHi\n"
//   -> 1 cue, start==1000, end==4000, text=="Hi"
//   vtt_has_header -> 1
import std/data/sub_vtt_parse

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn main()
    let nl = chr(10)

    // ── KAT 1: vtt_has_header ────────────────────────────────────────────────
    let sample = "WEBVTT" + nl + nl + "00:00:01.000 --> 00:00:04.000" + nl + "Hi" + nl
    cki("kat1-has-header", vtt_has_header(sample), 1)
    print("KAT 1 PASS: vtt_has_header true")

    // ── KAT 2: vtt_has_header on non-vtt ────────────────────────────────────
    cki("kat2-no-header", vtt_has_header("1" + nl + "00:00:01,000 --> 00:00:04,000" + nl + "Hi"), 0)
    print("KAT 2 PASS: vtt_has_header false for SRT")

    // ── KAT 3: parse 1 cue ───────────────────────────────────────────────────
    let cues = vtt_parse(sample)
    cki("kat3-cue-count", len(cues), 1)
    print("KAT 3 PASS: cue count == 1")

    // ── KAT 4: cue start == 1000 ─────────────────────────────────────────────
    let c0 = cues[0]
    cki("kat4-start", c0["start"], 1000)
    print("KAT 4 PASS: start == 1000")

    // ── KAT 5: cue end == 4000 ───────────────────────────────────────────────
    cki("kat5-end", c0["end"], 4000)
    print("KAT 5 PASS: end == 4000")

    // ── KAT 6: cue text == "Hi" ──────────────────────────────────────────────
    cks("kat6-text", c0["text"], "Hi")
    print("KAT 6 PASS: text == 'Hi'")

    // ── KAT 7: cue index == 1 ────────────────────────────────────────────────
    cki("kat7-index", c0["index"], 1)
    print("KAT 7 PASS: index == 1")

    // ── KAT 8: multi-cue parse ───────────────────────────────────────────────
    let tc1 = "00:00:01.000 --> 00:00:04.000"
    let tc2 = "00:00:05.500 --> 00:00:08.200"
    let multi = "WEBVTT" + nl + nl + tc1 + nl + "Hello" + nl + nl + tc2 + nl + "World" + nl
    let cues2 = vtt_parse(multi)
    cki("kat8-count", len(cues2), 2)
    let c1 = cues2[0]
    let c2 = cues2[1]
    cki("kat8-c1-start", c1["start"], 1000)
    cki("kat8-c1-end", c1["end"], 4000)
    cks("kat8-c1-text", c1["text"], "Hello")
    cki("kat8-c2-start", c2["start"], 5500)
    cki("kat8-c2-end", c2["end"], 8200)
    cks("kat8-c2-text", c2["text"], "World")
    print("KAT 8 PASS: multi-cue parse correct")

    // ── KAT 9: NOTE block is skipped ─────────────────────────────────────────
    let note_hdr = "WEBVTT" + nl + nl + "NOTE This is a comment" + nl + nl
    let noted = note_hdr + "00:00:01.000 --> 00:00:04.000" + nl + "Hi" + nl
    let cues3 = vtt_parse(noted)
    cki("kat9-note-skip", len(cues3), 1)
    print("KAT 9 PASS: NOTE block skipped")

    // ── KAT 10: ms arithmetic edge cases ────────────────────────────────────
    // 01:02:03.456 = 3600000+120000+3000+456 = 3723456
    let edge_tc = "01:02:03.456 --> 01:02:04.789"
    let edge = "WEBVTT" + nl + nl + edge_tc + nl + "Edge" + nl
    let cues4 = vtt_parse(edge)
    cki("kat10-edge-start", cues4[0]["start"], 3723456)
    cki("kat10-edge-end",   cues4[0]["end"],   3724789)
    print("KAT 10 PASS: ms arithmetic correct")

    print("PASS _sub_vtt_parse_test")
