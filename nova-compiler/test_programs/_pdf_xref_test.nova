import std/data/pdf_xref

// cki: assert integer equality, exit(1) on mismatch.
fn cki(label, got, want)
    if got != want
        print("FAIL pdf_xref " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// cks: assert string equality, exit(1) on mismatch.
fn cks(label, got, want)
    if got != want
        print("FAIL pdf_xref " + label + ": got=" + got + " want=" + want)
        exit(1)

// ckb: assert boolean equality, exit(1) on mismatch.
fn ckb(label, got, want)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL pdf_xref " + label + ": got=" + gs + " want=" + ws)
        exit(1)

// ckge: assert got >= threshold, exit(1) on failure.
fn ckge(label, got, threshold)
    if got < threshold
        print("FAIL pdf_xref " + label + ": got=" + str(got) + " want>=" + str(threshold))
        exit(1)

fn main()
    // Build a PDF buffer representing:
    // '%PDF-1.7\n%<226><227><207><211>\n1 0 obj\n<<>>\nendobj\nstartxref\n1234\n%%EOF'
    //
    // Line 1: %PDF-1.7  = 37,80,68,70,45,49,46,55,10
    // Line 2: % then 4 high bytes = 37,226,227,207,211,10
    // Line 3: 1 0 obj = 49,32,48,32,111,98,106,10
    // Line 4: <<>> = 60,60,62,62,10
    // Line 5: endobj = 101,110,100,111,98,106,10
    // Line 6: startxref = 115,116,97,114,116,120,114,101,102,10
    // Line 7: 1234 = 49,50,51,52,10
    // Line 8: %%EOF = 37,37,69,79,70

    let buf = []

    // '%PDF-1.7\n'
    push(buf, 37)
    push(buf, 80)
    push(buf, 68)
    push(buf, 70)
    push(buf, 45)
    push(buf, 49)
    push(buf, 46)
    push(buf, 55)
    push(buf, 10)

    // '%' then 4 high bytes (binary marker line) '\n'
    push(buf, 37)
    push(buf, 226)
    push(buf, 227)
    push(buf, 207)
    push(buf, 211)
    push(buf, 10)

    // '1 0 obj\n'
    push(buf, 49)
    push(buf, 32)
    push(buf, 48)
    push(buf, 32)
    push(buf, 111)
    push(buf, 98)
    push(buf, 106)
    push(buf, 10)

    // '<<>>\n'
    push(buf, 60)
    push(buf, 60)
    push(buf, 62)
    push(buf, 62)
    push(buf, 10)

    // 'endobj\n'
    push(buf, 101)
    push(buf, 110)
    push(buf, 100)
    push(buf, 111)
    push(buf, 98)
    push(buf, 106)
    push(buf, 10)

    // 'startxref\n'
    push(buf, 115)
    push(buf, 116)
    push(buf, 97)
    push(buf, 114)
    push(buf, 116)
    push(buf, 120)
    push(buf, 114)
    push(buf, 101)
    push(buf, 102)
    push(buf, 10)

    // '1234\n'
    push(buf, 49)
    push(buf, 50)
    push(buf, 51)
    push(buf, 52)
    push(buf, 10)

    // '%%EOF'
    push(buf, 37)
    push(buf, 37)
    push(buf, 69)
    push(buf, 79)
    push(buf, 70)

    // KAT 1: magic check
    ckb("magic_check", pdf_magic_check(buf), true)

    // KAT 2: version string
    cks("version", pdf_version(buf), "1.7")

    // KAT 3: version major
    cki("version_major", pdf_version_major(buf), 1)

    // KAT 4: version minor
    cki("version_minor", pdf_version_minor(buf), 7)

    // KAT 5: has %%EOF
    ckb("has_eof", pdf_has_eof(buf), true)

    // KAT 6: find startxref (must be >= 0)
    let sx = pdf_find_startxref(buf)
    ckge("find_startxref", sx, 0)

    // KAT 7: xref offset == 1234
    cki("xref_offset", pdf_xref_offset(buf), 1234)

    // KAT 8: is_valid
    ckb("is_valid", pdf_is_valid(buf), true)

    // KAT 9: count objects -- '1 0 obj' contains ' obj' once
    let obj_count = pdf_count_obj(buf)
    cki("count_obj", obj_count, 1)

    // KAT 10: is_linearized false (no /Linearized in our test buffer)
    ckb("not_linearized", pdf_is_linearized(buf), false)

    // KAT 11: binary marker -- 2nd line starts with % then 226 >= 128
    ckb("binary_marker", pdf_binary_marker(buf), true)

    // KAT 12: bad magic
    let bad = []
    push(bad, 0)
    push(bad, 1)
    push(bad, 2)
    push(bad, 3)
    push(bad, 4)
    ckb("bad_magic", pdf_magic_check(bad), false)
    ckb("bad_is_valid", pdf_is_valid(bad), false)

    // KAT 13: empty buffer
    let empty = []
    ckb("empty_magic", pdf_magic_check(empty), false)
    cki("empty_xref", pdf_xref_offset(empty), -1)

    // KAT 14: find_trailer absent
    cki("no_trailer", pdf_find_trailer(buf), -1)

    // KAT 15: startxref absent
    let notpdf = []
    push(notpdf, 37)
    push(notpdf, 80)
    push(notpdf, 68)
    push(notpdf, 70)
    push(notpdf, 45)
    push(notpdf, 49)
    push(notpdf, 46)
    push(notpdf, 52)
    push(notpdf, 10)
    push(notpdf, 37)
    push(notpdf, 37)
    push(notpdf, 69)
    push(notpdf, 79)
    push(notpdf, 70)
    cki("no_startxref", pdf_xref_offset(notpdf), -1)

    // KAT 16: linearized detection
    let linbuf = []
    push(linbuf, 37)
    push(linbuf, 80)
    push(linbuf, 68)
    push(linbuf, 70)
    push(linbuf, 45)
    push(linbuf, 49)
    push(linbuf, 46)
    push(linbuf, 52)
    push(linbuf, 10)
    push(linbuf, 47)
    push(linbuf, 76)
    push(linbuf, 105)
    push(linbuf, 110)
    push(linbuf, 101)
    push(linbuf, 97)
    push(linbuf, 114)
    push(linbuf, 105)
    push(linbuf, 122)
    push(linbuf, 101)
    push(linbuf, 100)
    ckb("is_linearized", pdf_is_linearized(linbuf), true)

    print("PASS _pdf_xref_test")
