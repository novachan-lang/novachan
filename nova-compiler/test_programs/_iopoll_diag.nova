fn main()
  let server = tcp_listen(19877)
  print("server fd: " + str(server))
  io_set_nonblocking(server)

  let p = io_poll_create()
  print("poll handle: " + str(p))

  let add_r = io_poll_add(p, server, 1)
  print("poll_add result: " + str(add_r))

  spawn connect_to_server()

  sleep(200)

  let events = io_poll_wait(p, 3000)
  print("events count: " + str(len(events)))
  if len(events) > 0
    let ev = events[0]
    print("event fd: " + str(ev[0]) + " flags: " + str(ev[1]))

  let client = tcp_accept(server)
  print("accept result: " + str(client))
  if client >= 0
    let data = tcp_recv(client)
    print("received: " + data)
    tcp_close(client)

  tcp_close(server)
  io_poll_close(p)
  print("done")

fn connect_to_server()
  sleep(100)
  print("connecting...")
  let c = tcp_connect("127.0.0.1", 19877)
  print("connect result: " + str(c))
  if c >= 0
    tcp_send(c, "hello from spawn")
    tcp_close(c)
