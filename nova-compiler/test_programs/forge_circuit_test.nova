// functional: circuit breaker CLOSED->OPEN->HALF_OPEN->CLOSED using the real forge_circuit cb_* API
// (deterministic: cb_allow/cb_failure take an explicit now_ms, so no sleep is needed).
import forge_circuit

fn main()
    let cb = cb_new(2, 50)
    // closed initially -> allow
    if cb_allow(cb, 0) == false
        print("FAIL initial allow")
        exit(1)
    // two failures at the threshold -> OPEN
    cb_failure(cb, 0)
    cb_failure(cb, 0)
    if cb_state(cb) != "open"
        print("FAIL open = " + cb_state(cb))
        exit(1)
    // while open and before the cooldown (t=10 < reset 50) -> reject fast
    if cb_allow(cb, 10)
        print("FAIL reject while open")
        exit(1)
    // after the cooldown (t=60 >= 50) -> HALF_OPEN admits one trial
    if cb_allow(cb, 60) == false
        print("FAIL half-open probe")
        exit(1)
    if cb_state(cb) != "half_open"
        print("FAIL half_open state = " + cb_state(cb))
        exit(1)
    // a success closes it again
    cb_success(cb)
    if cb_state(cb) != "closed"
        print("FAIL closed after success = " + cb_state(cb))
        exit(1)
    // a failure in half_open re-opens immediately
    let cb2 = cb_new(1, 100)
    cb_failure(cb2, 0)
    if cb_state(cb2) != "open"
        print("FAIL threshold-1 open")
        exit(1)
    cb_allow(cb2, 200)
    if cb_state(cb2) != "half_open"
        print("FAIL reopen half_open")
        exit(1)
    cb_failure(cb2, 200)
    if cb_state(cb2) != "open"
        print("FAIL half_open failure re-opens")
        exit(1)
    // registry: same named instance persists its state
    let reg = cb_registry()
    let a = cb_get(reg, "svc", 3, 100)
    cb_failure(a, 0)
    let a2 = cb_get(reg, "svc", 3, 100)
    if a2["failures"] != 1
        print("FAIL registry persistence")
        exit(1)
    print("PASS forge_circuit")
