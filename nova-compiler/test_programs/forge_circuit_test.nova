// functional: circuit breaker CLOSED->OPEN->HALF_OPEN->CLOSED with real timing
import forge_circuit

fn main()
    let cb = circuit_new(2, 50)
    if circuit_allow(cb) != 1
        print("FAIL initial allow")
        exit(1)
    circuit_failure(cb)
    circuit_failure(cb)
    if circuit_state(cb) != "open"
        print("FAIL open = " + circuit_state(cb))
        exit(1)
    if circuit_allow(cb) != 0
        print("FAIL reject while open")
        exit(1)
    sleep(80)
    if circuit_allow(cb) != 1
        print("FAIL half-open probe")
        exit(1)
    if circuit_state(cb) != "half_open"
        print("FAIL half_open = " + circuit_state(cb))
        exit(1)
    circuit_success(cb)
    if circuit_state(cb) != "closed"
        print("FAIL closed after probe")
        exit(1)
    circuit_stop(cb)
    print("PASS forge_circuit")
