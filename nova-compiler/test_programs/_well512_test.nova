// KAT test for std/random/well512 -- WELL512a PRNG
//
// Verification strategy:
//   KAT-1  Determinism: two well_seed(0) generators produce identical first 8 outputs.
//   KAT-2  Anchor values: specific outputs from well_seed(0) match the reference C impl.
//   KAT-3  All outputs < 2^32: well_next never produces a value >= 4294967296.
//   KAT-4  Non-degenerate: not all 8 outputs equal the first output.
//   KAT-5  Seed independence: well_seed(1) differs from well_seed(0) in first output.
//   KAT-6  well_next_range in bounds: 1000 calls to well_next_range(rng,100) all in [0,99].
//   KAT-7  well_next_range anchor: well_seed(42) well_next_range(100) == 53.
//
// Reference KAT vectors computed against the exact WELL512a C macro expansion
// (Panneton, L'Ecuyer, Matsumoto 2006) with LCG seeding:
//   state[k] = (1664525 * state[k-1] + 1013904223) mod 2^32, starting from seed.
//
// seed=0 expected first 8 outputs:
//   [0]=3306232329  [1]=3328115374  [2]=2632314914  [3]=1897920407
//   [4]=2024625045  [5]=496528334   [6]=27601446    [7]=607826638

import std/random/well512

fn _check_eq(got, want, label)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)
    return 0

fn main()
    let bound32 = 4294967296

    // ── KAT-1: Determinism ───────────────────────────────────────────────────
    let ra = well_seed(0)
    let a0 = well_next(ra)
    let a1 = well_next(ra)
    let a2 = well_next(ra)
    let a3 = well_next(ra)
    let a4 = well_next(ra)
    let a5 = well_next(ra)
    let a6 = well_next(ra)
    let a7 = well_next(ra)

    let rb = well_seed(0)
    let b0 = well_next(rb)
    let b1 = well_next(rb)
    let b2 = well_next(rb)
    let b3 = well_next(rb)
    let b4 = well_next(rb)
    let b5 = well_next(rb)
    let b6 = well_next(rb)
    let b7 = well_next(rb)

    _check_eq(b0, a0, "KAT1-det[0]")
    _check_eq(b1, a1, "KAT1-det[1]")
    _check_eq(b2, a2, "KAT1-det[2]")
    _check_eq(b3, a3, "KAT1-det[3]")
    _check_eq(b4, a4, "KAT1-det[4]")
    _check_eq(b5, a5, "KAT1-det[5]")
    _check_eq(b6, a6, "KAT1-det[6]")
    _check_eq(b7, a7, "KAT1-det[7]")

    // ── KAT-2: Anchor values (seed=0) ────────────────────────────────────────
    _check_eq(a0, 3306232329, "KAT2-anchor[0]")
    _check_eq(a1, 3328115374, "KAT2-anchor[1]")
    _check_eq(a2, 2632314914, "KAT2-anchor[2]")
    _check_eq(a3, 1897920407, "KAT2-anchor[3]")
    _check_eq(a4, 2024625045, "KAT2-anchor[4]")
    _check_eq(a5, 496528334,  "KAT2-anchor[5]")
    _check_eq(a6, 27601446,   "KAT2-anchor[6]")
    _check_eq(a7, 607826638,  "KAT2-anchor[7]")

    // ── KAT-3: All outputs < 2^32 ────────────────────────────────────────────
    if a0 < 0
        print("FAIL KAT3: a0 < 0: " + str(a0))
        exit(1)
    if a0 >= bound32
        print("FAIL KAT3: a0 >= 2^32: " + str(a0))
        exit(1)
    if a1 < 0
        print("FAIL KAT3: a1 < 0: " + str(a1))
        exit(1)
    if a1 >= bound32
        print("FAIL KAT3: a1 >= 2^32: " + str(a1))
        exit(1)
    if a7 < 0
        print("FAIL KAT3: a7 < 0: " + str(a7))
        exit(1)
    if a7 >= bound32
        print("FAIL KAT3: a7 >= 2^32: " + str(a7))
        exit(1)

    // ── KAT-4: Non-degenerate ────────────────────────────────────────────────
    // Check that not all 8 outputs are equal to the first
    let all_same = 1
    if a1 != a0
        all_same = 0
    if a2 != a0
        all_same = 0
    if a3 != a0
        all_same = 0
    if all_same == 1
        print("FAIL KAT4: degenerate output (all outputs equal " + str(a0) + ")")
        exit(1)

    // ── KAT-5: Seed independence ─────────────────────────────────────────────
    let rc = well_seed(1)
    let c0 = well_next(rc)
    if c0 == a0
        print("FAIL KAT5: seed(1) first output == seed(0) first output: " + str(c0))
        exit(1)
    // Verify seed(1) anchor
    _check_eq(c0, 1882373527, "KAT5-anchor-seed1[0]")

    // ── KAT-6: well_next_range in [0,99] for 1000 steps ─────────────────────
    let rr = well_seed(7)
    let step = 0
    while step < 1000
        let rv = well_next_range(rr, 100)
        if rv < 0
            print("FAIL KAT6: well_next_range < 0 at step " + str(step))
            exit(1)
        if rv >= 100
            print("FAIL KAT6: well_next_range >= 100 at step " + str(step) + " got " + str(rv))
            exit(1)
        step = step + 1

    // ── KAT-7: well_next_range anchor (seed=42, n=100) ───────────────────────
    let rk = well_seed(42)
    let kv = well_next_range(rk, 100)
    _check_eq(kv, 53, "KAT7-range-anchor")

    print("PASS _well512_test")
