type Point
    x: int
    y: int

type Person
    name: string
    age: int
    active: bool

fn main()
    let p = Point(3, 7)

    // fields() returns list of field names
    let flds = fields(p)
    assert(len(flds) == 2, "point has 2 fields")
    assert(flds[0] == "x", "field 0 is x")
    assert(flds[1] == "y", "field 1 is y")

    // type_name() returns the struct type name
    let tn = type_name(p)
    assert(tn == "Point", "type_name is Point")

    // field_types() returns list of field type names
    let ft = field_types(p)
    assert(len(ft) == 2, "point has 2 field types")
    assert(ft[0] == "int", "field 0 type is int")
    assert(ft[1] == "int", "field 1 type is int")

    // field_get() accesses field by name dynamically
    let xv = field_get(p, "x")
    assert(xv == 3, "field_get x == 3")
    let yv = field_get(p, "y")
    assert(yv == 7, "field_get y == 7")

    // Person struct
    let bob = Person("Bob", 30, 1)
    let pf = fields(bob)
    assert(len(pf) == 3, "person has 3 fields")
    assert(pf[0] == "name", "person field 0")
    assert(pf[1] == "age", "person field 1")
    assert(pf[2] == "active", "person field 2")

    let pt = field_types(bob)
    assert(pt[0] == "string", "person ftype 0")
    assert(pt[1] == "int", "person ftype 1")
    assert(pt[2] == "bool", "person ftype 2")

    assert(type_name(bob) == "Person", "type_name Person")
    assert(field_get(bob, "name") == "Bob", "field_get name")
    assert(field_get(bob, "age") == 30, "field_get age")

    // Dynamic iteration over fields
    let desc = ""
    for f in fields(bob)
        let v = field_get(bob, f)
        desc = desc + f + "=" + str(v) + " "
    assert(contains(desc, "name=Bob"), "dynamic iter name")
    assert(contains(desc, "age=30"), "dynamic iter age")

    print("reflect_test: all passed")
