// KAT for std/text/grapheme.nova — basic grapheme cluster awareness.
import std/text/grapheme

// ── Test 1: plain ASCII — 1 byte = 1 grapheme ──────────────────────────────
let a1 = gr_split("hello")
assert(len(a1) == 5, "ascii split: 5 graphemes")
assert(a1[0] == "h", "ascii first grapheme is h")
assert(gr_len("hello") == 5, "ascii gr_len == 5")
assert(gr_at("hello", 1) == "e", "ascii gr_at(1) == e")
assert(gr_at("hello", 4) == "o", "ascii gr_at(4) == o")
assert(gr_at("hello", 99) == "", "ascii gr_at out-of-range == empty")
assert(gr_at("hello", -1) == "", "ascii gr_at negative == empty")
print("PASS: ascii")

// ── Test 2: empty string — every fn handles zero-length input ─────────────
assert(gr_len("") == 0, "empty gr_len == 0")
assert(len(gr_split("")) == 0, "empty gr_split == []")
assert(gr_reverse("") == "", "empty gr_reverse == \"\"")
assert(gr_at("", 0) == "", "empty gr_at == \"\"")
print("PASS: empty string")

// ── Test 3: precomposed multi-byte UTF-8 chars (no combiner) ──────────────
// "héllo" with a PRECOMPOSED e-acute (U+00E9, 2 bytes) — 1 grapheme, not 2.
let precomposed = "h" + from_codepoint(233) + "llo"
assert(gr_len(precomposed) == 5, "precomposed accented char: 5 graphemes")
assert(gr_at(precomposed, 1) == from_codepoint(233), "precomposed grapheme is e-acute")

// 3-byte CJK: 3 codepoints, 3 graphemes, 9 bytes.
let cjk = from_codepoint(26085) + from_codepoint(26412) + from_codepoint(35486)  // 日本語
assert(len(cjk) == 9, "cjk is 9 bytes (3-byte utf8 x 3)")
assert(char_count(cjk) == 3, "cjk is 3 codepoints")
assert(gr_len(cjk) == 3, "cjk is 3 graphemes")

// 4-byte emoji, no ZWJ: 1 codepoint, 1 grapheme.
let grin = from_codepoint(128512)   // U+1F600 GRINNING FACE
assert(char_count(grin) == 1, "grin is 1 codepoint")
assert(gr_len(grin) == 1, "grin is 1 grapheme")
assert(gr_split(grin)[0] == grin, "grin round-trips through split")
print("PASS: multi-byte utf-8 (no combiner)")

// ── Test 4: decomposed combining mark — base char + U+0301 combining acute ─
// "cafe" + combining-acute over the 'e' -> "café" as 5 codepoints, 4 graphemes.
let combo = from_codepoint(101) + from_codepoint(769)          // e + combining acute
let cafe = "caf" + combo
assert(char_count(cafe) == 5, "decomposed cafe: 5 codepoints")
assert(gr_len(cafe) == 4, "decomposed cafe: 4 graphemes")
let cs = gr_split(cafe)
assert(cs[0] == "c" and cs[1] == "a" and cs[2] == "f", "first three graphemes are c,a,f")
assert(cs[3] == combo, "fourth grapheme holds e + its combining accent")
assert(char_count(cs[3]) == 2, "the e+accent grapheme is still 2 codepoints")
print("PASS: decomposed combining mark (café)")

// ── Test 5: multiple stacked combining marks on one base ──────────────────
// 'a' + combining-grave (U+0300) + combining-tilde (U+0303) -> still ONE grapheme.
let stacked = "a" + from_codepoint(768) + from_codepoint(771)
assert(char_count(stacked) == 3, "stacked: 3 codepoints")
assert(gr_len(stacked) == 1, "stacked marks still collapse to 1 grapheme")
print("PASS: stacked combining marks")

// ── Test 6: ZWJ emoji sequence — man ZWJ woman ZWJ girl (family) ──────────
let family = from_codepoint(128104) + from_codepoint(8205) + from_codepoint(128105) + from_codepoint(8205) + from_codepoint(128103)
assert(char_count(family) == 5, "family: 5 codepoints")
assert(gr_len(family) == 1, "family ZWJ sequence: 1 grapheme")
assert(gr_split(family)[0] == family, "family split round-trips to the whole sequence")
print("PASS: ZWJ emoji sequence")

// ── Test 7: grapheme-aware reverse keeps combining marks on their base ────
// reverse("a|f|c a f e-combo") behavior: reverse "caf<e+accent>" should read
// "<e+accent>fac" — the accent must stay glued to the e it belongs to.
let rev = gr_reverse(cafe)
let expect = combo + "f" + "a" + "c"
assert(rev == expect, "reverse keeps the accent attached to its base letter")
assert(gr_len(rev) == 4, "reversed string still has 4 graphemes")
assert(char_count(rev) == 5, "reversed string still has 5 codepoints (nothing lost)")
print("PASS: grapheme-aware reverse (café)")

// Reverse across a word that mixes plain ASCII AND a decomposed accent.
let word = "a" + combo + "c"        // a, (e+accent), c  -> 3 graphemes
assert(gr_len(word) == 3, "mixed word: 3 graphemes")
let wrev = gr_reverse(word)
assert(wrev == "c" + combo + "a", "mixed word reverse: c, e+accent, a")
print("PASS: grapheme-aware reverse (mixed ascii + combiner)")

// Reverse must also round-trip a plain ASCII string exactly like a normal
// byte reverse would (no combiners/ZWJ involved).
assert(gr_reverse("hello") == "olleh", "plain ascii reverse unaffected")
print("PASS: ascii reverse baseline")

// ── Test 8: reverse of the ZWJ family sequence is a no-op (1 grapheme) ────
assert(gr_reverse(family) == family, "single-grapheme ZWJ sequence reverses to itself")
print("PASS: ZWJ sequence reverse is a no-op")

print("GRAPHEME KAT PASS")
