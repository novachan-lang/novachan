import forge_object_mapper

fn main()
    let m = om_new()
    m = om_add_mapping(m, "name", "full_name")
    m = om_add_mapping(m, "age", "years")
    assert(om_mapping_count(m) == 2, "2 mappings")

    let src = {}
    src["name"] = "Alice"
    src["age"] = 30
    src["extra"] = "ignored"
    let mapped = om_map(m, src)
    assert(mapped["full_name"] == "Alice", "name mapped")
    assert(mapped["years"] == 30, "age mapped")
    assert(contains(mapped, "extra") != true, "extra not mapped")

    assert(om_has_mapping(m, "name") == 1, "has name")
    assert(om_has_mapping(m, "foo") == 0, "no foo")

    let tf = om_target_field(m, "name")
    assert(is_ok(tf), "target ok")
    assert(unwrap(tf) == "full_name", "target=full_name")

    let bad = om_target_field(m, "nope")
    assert(is_err(bad), "no mapping err")

    assert(om_total_mapped(m) == 1, "1 mapped")

    print("OBJECT-MAPPER KAT PASS")
