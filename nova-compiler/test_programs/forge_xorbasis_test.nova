import forge_xorbasis as xb

fn check(cond: bool, label: str)
    if cond == false
        print("FAIL: " + label)

// Brute force: compute all distinct XOR values reachable from subset of nums
fn brute_all_xor(nums: list) -> list
    let n = len(nums)
    let seen = {}
    let mask = 0
    let total = 1
    let i = 0
    while i < n
        total = total * 2
        i = i + 1
    while mask < total
        let x = 0
        let j = 0
        while j < n
            let bit = (mask / _pow2t(j)) % 2
            if bit == 1
                x = x ^ nums[j]
            j = j + 1
        seen[str(x)] = x
        mask = mask + 1
    // Collect values
    let vals = []
    let keys = keys(seen)
    let k = 0
    while k < len(keys)
        push(vals, get(seen, keys[k], 0))
        k = k + 1
    return vals

fn _pow2t(p: int) -> int
    let r = 1
    let i = 0
    while i < p
        r = r * 2
        i = i + 1
    return r

fn brute_max_xor(nums: list) -> int
    let vals = brute_all_xor(nums)
    let mx = 0
    let i = 0
    while i < len(vals)
        if vals[i] > mx
            mx = vals[i]
        i = i + 1
    return mx

fn brute_min_nonzero_xor(nums: list) -> int
    let vals = brute_all_xor(nums)
    let mn = 0 - 1
    let i = 0
    while i < len(vals)
        if vals[i] > 0
            if mn < 0 or vals[i] < mn
                mn = vals[i]
        i = i + 1
    if mn < 0
        return 0
    return mn

fn brute_can(nums: list, target: int) -> bool
    let vals = brute_all_xor(nums)
    let i = 0
    while i < len(vals)
        if vals[i] == target
            return true
        i = i + 1
    return false

// TEST 1: basic build and max_xor
let nums1 = [3, 10, 5]
let b1 = xb.xb_build(nums1)
// subsets: 0,3,10,5,3^10=9,3^5=6,10^5=15,3^10^5=12 -> distinct {0,3,5,6,9,10,12,15}, max=15
check(xb.xb_max_xor(b1) == 15, "max_xor([3,10,5])=15")
check(xb.xb_rank(b1) == 3, "rank([3,10,5])=3 (independent)")
check(xb.xb_span_size(b1) == 8, "span size = 2^3 = 8")

// TEST 2: linearly dependent set
let nums2 = [1, 2, 3]
// 3 = 1^2, so rank is 2; span = {0,1,2,3}, max=3
let b2 = xb.xb_build(nums2)
check(xb.xb_rank(b2) == 2, "rank([1,2,3])=2 (3=1^2)")
check(xb.xb_max_xor(b2) == 3, "max_xor([1,2,3])=3")
check(xb.xb_span_size(b2) == 4, "span size = 4")

// TEST 3: can_represent
check(xb.xb_can_represent(b2, 0), "can represent 0 (empty)")
check(xb.xb_can_represent(b2, 3), "can represent 3")
check(xb.xb_can_represent(b2, 1), "can represent 1")
check(xb.xb_can_represent(b2, 2), "can represent 2")
check(xb.xb_can_represent(b2, 4) == false, "cannot represent 4")
check(xb.xb_can_represent(b2, 5) == false, "cannot represent 5")

// TEST 4: insert return value (rank increase detection)
let b3 = xb.xb_new()
check(xb.xb_insert(b3, 5), "insert 5 -> new (true)")
check(xb.xb_insert(b3, 3), "insert 3 -> new (true)")
check(xb.xb_insert(b3, 6) == false, "insert 6=5^3 -> dependent (false)")
check(xb.xb_rank(b3) == 2, "rank after = 2")

// TEST 5: empty basis
let be = xb.xb_new()
check(xb.xb_max_xor(be) == 0, "empty basis max_xor=0")
check(xb.xb_rank(be) == 0, "empty basis rank=0")
check(xb.xb_span_size(be) == 1, "empty span size=1 (only 0)")
check(xb.xb_can_represent(be, 0), "empty can represent 0")
check(xb.xb_can_represent(be, 5) == false, "empty cannot represent 5")

// TEST 6: min_xor
let bm = xb.xb_build([6, 10, 12])
// 6=0110, 10=1010, 12=1100; subsets include 6^10=12? no 6^10=1100=12; interesting
// all xors: 0,6,10,12,6^10=12(dup)... let's just cross-check with brute
let brute_min = brute_min_nonzero_xor([6, 10, 12])
check(xb.xb_min_xor(bm) == brute_min, "min_xor matches brute")

// TEST 7: kth smallest distinct XOR
let bk = xb.xb_build([3, 10, 5])  // span {0,3,5,6,9,10,12,15} sorted
check(xb.xb_kth(bk, 1) == 0, "kth(1)=0")
check(xb.xb_kth(bk, 2) == 3, "kth(2)=3")
check(xb.xb_kth(bk, 3) == 5, "kth(3)=5")
check(xb.xb_kth(bk, 4) == 6, "kth(4)=6")
check(xb.xb_kth(bk, 5) == 9, "kth(5)=9")
check(xb.xb_kth(bk, 6) == 10, "kth(6)=10")
check(xb.xb_kth(bk, 7) == 12, "kth(7)=12")
check(xb.xb_kth(bk, 8) == 15, "kth(8)=15")
check(xb.xb_kth(bk, 9) == 0 - 1, "kth(9)=-1 (out of range)")

// TEST 8: DECISIVE brute-force cross-check on many random-ish sets
let ok_max = true
let ok_min = true
let ok_can = true
let ok_span = true
let ok_kth = true
let sets = [[1, 2, 4], [7, 3, 5], [8, 12, 6, 2], [15, 9, 6], [1, 1, 1], [0, 5, 10], [13, 7, 11, 2], [4, 6, 2, 8]]
let s = 0
while s < len(sets)
    let nums = sets[s]
    let basis = xb.xb_build(nums)
    // max
    let exp_max = brute_max_xor(nums)
    if xb.xb_max_xor(basis) != exp_max
        ok_max = false
        print("MAX FAIL set " + str(s) + " exp=" + str(exp_max) + " got=" + str(xb.xb_max_xor(basis)))
    // min
    let exp_min = brute_min_nonzero_xor(nums)
    if xb.xb_min_xor(basis) != exp_min
        ok_min = false
        print("MIN FAIL set " + str(s) + " exp=" + str(exp_min) + " got=" + str(xb.xb_min_xor(basis)))
    // span size = number of distinct reachable values
    let distinct = brute_all_xor(nums)
    if xb.xb_span_size(basis) != len(distinct)
        ok_span = false
        print("SPAN FAIL set " + str(s) + " exp=" + str(len(distinct)) + " got=" + str(xb.xb_span_size(basis)))
    // can_represent: test all values 0..31
    let t = 0
    while t <= 31
        let exp_c = brute_can(nums, t)
        let got_c = xb.xb_can_represent(basis, t)
        if exp_c != got_c
            ok_can = false
            print("CAN FAIL set " + str(s) + " target=" + str(t) + " exp=" + str(exp_c))
        t = t + 1
    // kth: verify sorted order matches sorted brute distinct values
    let sorted_distinct = _sort_test(distinct)
    let kk = 1
    while kk <= len(sorted_distinct)
        let exp_k = sorted_distinct[kk - 1]
        let got_k = xb.xb_kth(basis, kk)
        if exp_k != got_k
            ok_kth = false
            print("KTH FAIL set " + str(s) + " k=" + str(kk) + " exp=" + str(exp_k) + " got=" + str(got_k))
        kk = kk + 1
    s = s + 1

check(ok_max, "brute cross-check max_xor: all sets")
check(ok_min, "brute cross-check min_xor: all sets")
check(ok_span, "brute cross-check span size: all sets")
check(ok_can, "brute cross-check can_represent: all sets x targets 0..31")
check(ok_kth, "brute cross-check kth smallest: all sets")

fn _sort_test(arr: list) -> list
    let a = []
    let i = 0
    while i < len(arr)
        push(a, arr[i])
        i = i + 1
    let n = len(a)
    let k = 1
    while k < n
        let key = a[k]
        let j = k - 1
        while j >= 0 and a[j] > key
            a[j + 1] = a[j]
            j = j - 1
        a[j + 1] = key
        k = k + 1
    return a

print("forge_xorbasis: KAT done")
