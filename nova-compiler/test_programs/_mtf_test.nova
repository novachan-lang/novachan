// _mtf_test.nova — KAT for std/compress/mtf
//
// Move-to-Front (MTF) transform.
//
// PRIMARY KAT: round-trip   mtf_decode(mtf_encode(s)) == s
// SECONDARY KATs: specific index sequences hand-traced from the algorithm.
//
// HAND-TRACE — mtf_encode("aaaa"):
//   Initial alphabet: alpha[i] = chr(i) for i in 0..255.
//   Step 1: c='a' (ord 97).  alpha[97]='a'.  Emit 97.  Move 'a' to front.
//     New alpha[0]='a', alpha[1]=chr(0), ..., alpha[97]=chr(96), alpha[98]=chr(98),...
//   Step 2: c='a'.  alpha[0]='a'.  Emit 0.  Move 'a' to front (already there).
//   Step 3: c='a'.  alpha[0]='a'.  Emit 0.
//   Step 4: c='a'.  alpha[0]='a'.  Emit 0.
//   Result: [97, 0, 0, 0]
//
// HAND-TRACE — mtf_encode("a") -> [97]
//   Single 'a', position 97 in initial alphabet.
//
// HAND-TRACE — custom alphabet:
//   mtf_encode_alpha("aab", "abc"):
//     Initial: alpha = "abc"  (alpha[0]='a', alpha[1]='b', alpha[2]='c')
//     Step 1: 'a' at position 0.  Emit 0.  Move 'a' to front (already there).
//     Step 2: 'a' at position 0.  Emit 0.  Still at front.
//     Step 3: 'b' at position 1.  Emit 1.  Move 'b' to front.
//     Result: [0, 0, 1]

import std/compress/mtf

// Integer KAT helper.
fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// String KAT helper.
fn cks(label: str, got: str, want: str)
    if got != want
        print("FAIL " + label + ": got [" + got + "] want [" + want + "]")
        exit(1)

// List-length helper.
fn cklen(label: str, lst, want: int)
    let n = len(lst)
    if n != want
        print("FAIL " + label + " length: got " + str(n) + " want " + str(want))
        exit(1)

fn main()
    // ── KAT 1: empty string round-trip ───────────────────────────────────────
    let enc_empty = mtf_encode("")
    cklen("empty-encode-len", enc_empty, 0)
    let dec_empty = mtf_decode(enc_empty)
    cks("empty-round-trip", dec_empty, "")

    // ── KAT 2: single character "a" ──────────────────────────────────────────
    // "a" = ord 97; initial alphabet has chr(k) at position k, so 'a' is at 97.
    let enc_a = mtf_encode("a")
    cklen("a-encode-len", enc_a, 1)
    cki("a-encode-index", enc_a[0], 97)
    let dec_a = mtf_decode(enc_a)
    cks("a-round-trip", dec_a, "a")

    // ── KAT 3: "aaaa" — the canonical run-of-one-char KAT ────────────────────
    // Per SPEC and hand-trace: [97, 0, 0, 0]
    // First 'a' is at its byte value position (97); every subsequent 'a' is at 0.
    let enc_aaaa = mtf_encode("aaaa")
    cklen("aaaa-encode-len", enc_aaaa, 4)
    cki("aaaa-index-0", enc_aaaa[0], 97)
    cki("aaaa-index-1", enc_aaaa[1], 0)
    cki("aaaa-index-2", enc_aaaa[2], 0)
    cki("aaaa-index-3", enc_aaaa[3], 0)
    let dec_aaaa = mtf_decode(enc_aaaa)
    cks("aaaa-round-trip", dec_aaaa, "aaaa")

    // ── KAT 4: "banana" round-trip ───────────────────────────────────────────
    let enc_banana = mtf_encode("banana")
    cklen("banana-encode-len", enc_banana, 6)
    let dec_banana = mtf_decode(enc_banana)
    cks("banana-round-trip", dec_banana, "banana")

    // ── KAT 5: "bananaaa" round-trip ─────────────────────────────────────────
    let enc_bananaaa = mtf_encode("bananaaa")
    cklen("bananaaa-encode-len", enc_bananaaa, 8)
    let dec_bananaaa = mtf_decode(enc_bananaaa)
    cks("bananaaa-round-trip", dec_bananaaa, "bananaaa")

    // ── KAT 6: custom alphabet — mtf_encode_alpha ────────────────────────────
    // "aab" with alphabet "abc": 'a' at 0, 'a' at 0, 'b' at 1 → [0, 0, 1]
    let enc_alpha1 = mtf_encode_alpha("aab", "abc")
    cklen("alpha-aab-len", enc_alpha1, 3)
    cki("alpha-aab-0", enc_alpha1[0], 0)
    cki("alpha-aab-1", enc_alpha1[1], 0)
    cki("alpha-aab-2", enc_alpha1[2], 1)

    // ── KAT 7: "a sentence" round-trip ───────────────────────────────────────
    let sent = "hello world"
    let enc_sent = mtf_encode(sent)
    cklen("sentence-encode-len", enc_sent, 11)
    let dec_sent = mtf_decode(enc_sent)
    cks("sentence-round-trip", dec_sent, "hello world")

    // ── KAT 8: run-of-one-char property — general form ───────────────────────
    // For any char c repeated n times: first index = ord(c), rest = 0.
    // Verify with 'z' (ord 122).
    let enc_zzzz = mtf_encode("zzzz")
    cklen("zzzz-len", enc_zzzz, 4)
    cki("zzzz-index-0", enc_zzzz[0], 122)
    cki("zzzz-index-1", enc_zzzz[1], 0)
    cki("zzzz-index-2", enc_zzzz[2], 0)
    let dec_zzzz = mtf_decode(enc_zzzz)
    cks("zzzz-round-trip", dec_zzzz, "zzzz")

    print("_mtf_test passed")
