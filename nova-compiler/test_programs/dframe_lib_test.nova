import dframe

// Validation test for the dframe module's public API. Every asserted result is
// computed by hand from the 4-row people table below.
fn main()
    let rows = []
    push(rows, ["Alice", 30, "Eng", 100])
    push(rows, ["Bob", 35, "Eng", 120])
    push(rows, ["Carol", 28, "Sales", 90])
    push(rows, ["Dave", 35, "Sales", 110])
    let df = dframe.df_new(["name", "age", "dept", "salary"], rows)

    // shape + accessors
    assert(dframe.df_nrows(df) == 4, "nrows")
    assert(dframe.df_ncols(df) == 4, "ncols")
    assert(dframe.df_col(df, "name")[0] == "Alice", "col name[0]")
    assert(dframe.df_row(df, 1)["dept"] == "Eng", "row 1 dept")

    // select
    let sel = dframe.df_select(df, ["name", "salary"])
    assert(dframe.df_ncols(sel) == 2, "select ncols")
    assert(dframe.df_cols(sel)[1] == "salary", "select order")
    assert(dframe.df_nrows(sel) == 4, "select keeps rows")

    // filter (closure predicate over a row dict, passed across module boundary)
    let older = dframe.df_filter(df, fn(row) row["age"] > 30)
    assert(dframe.df_nrows(older) == 2, "filter age>30 -> 2")
    assert(dframe.df_col(older, "name")[0] == "Bob", "filter row0 Bob")
    assert(dframe.df_col(older, "name")[1] == "Dave", "filter row1 Dave")

    // sort (stable)
    let asc = dframe.df_sort(df, "age", 1)
    assert(dframe.df_col(asc, "name")[0] == "Carol", "sort asc first Carol(28)")
    assert(dframe.df_col(asc, "age")[3] == 35, "sort asc last 35")
    let desc = dframe.df_sort(df, "age", 0)
    assert(dframe.df_col(desc, "name")[0] == "Bob", "sort desc first Bob (stable)")
    assert(dframe.df_col(desc, "name")[1] == "Dave", "sort desc stable Dave second")

    // groupby aggregations
    let gsum = dframe.df_groupby_agg(df, "dept", "salary", "sum")
    assert(dframe.df_col(gsum, "dept")[0] == "Eng", "group0 Eng")
    assert(dframe.df_col(gsum, "sum_salary")[0] == 220, "Eng salary sum 220")
    assert(dframe.df_col(gsum, "dept")[1] == "Sales", "group1 Sales")
    assert(dframe.df_col(gsum, "sum_salary")[1] == 200, "Sales salary sum 200")
    let gcnt = dframe.df_groupby_agg(df, "dept", "salary", "count")
    assert(dframe.df_col(gcnt, "count_salary")[0] == 2, "Eng count 2")
    let gmean = dframe.df_groupby_agg(df, "dept", "salary", "mean")
    assert(dframe.df_col(gmean, "mean_salary")[0] == 110.0, "Eng mean 110.0")
    assert(dframe.df_col(gmean, "mean_salary")[1] == 100.0, "Sales mean 100.0")
    let gmax = dframe.df_groupby_agg(df, "dept", "salary", "max")
    assert(dframe.df_col(gmax, "max_salary")[0] == 120, "Eng max 120")

    // with_col + head
    let withb = dframe.df_with_col(df, "bonus", [1, 2, 3, 4])
    assert(dframe.df_ncols(withb) == 5, "with_col ncols")
    assert(dframe.df_col(withb, "bonus")[2] == 3, "with_col value")
    let h2 = dframe.df_head(df, 2)
    assert(dframe.df_nrows(h2) == 2, "head 2 rows")
    assert(dframe.df_col(h2, "name")[1] == "Bob", "head row1 Bob")

    // join
    let dinfo = dframe.df_new(["dept", "location"], [["Eng", "NYC"], ["Sales", "LA"]])
    let j = dframe.df_join(df, dinfo, "dept")
    assert(dframe.df_nrows(j) == 4, "join keeps 4 rows")
    assert(dframe.df_col(j, "name")[0] == "Alice", "join preserves left order")
    assert(dframe.df_col(j, "location")[0] == "NYC", "Alice in NYC")
    assert(dframe.df_col(j, "location")[2] == "LA", "Carol in LA")

    // render
    let s = dframe.df_to_str(dframe.df_head(df, 2))
    assert(len(s) > 0, "to_str non-empty")
    assert(contains(s, "name"), "to_str has header")
    assert(contains(s, "Alice"), "to_str has data")

    print("dframe_lib_test: all passed")
