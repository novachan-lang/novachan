import std/geometry/cg_point_line

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(label: string, got: list, wn: int, wd: int)
    let gn = got[0]
    let gd = got[1]
    if gn != wn or gd != wd
        print("FAIL " + label + ": got=[" + str(gn) + "," + str(gd) + "] want=[" + str(wn) + "," + str(wd) + "]")
        exit(1)

fn main()
    let o = [0,0]
    let r2 = [2,0]
    let r4 = [4,0]

    // cgpl_side tests
    cki("side left",  cgpl_side([0,1],  o, r2), 1)
    cki("side right", cgpl_side([0,-1], o, r2), -1)
    cki("side on",    cgpl_side([1,0],  o, r2), 0)

    // cgpl_dist_line_sq tests
    // Point [0,2] to x-axis (y=0) via [0,0]->[4,0]: cross=4*2-0*0=8, ab_sq=16 -> 64/16=4 -> [4,1]
    ckl("dline_sq [0,2] xaxis", cgpl_dist_line_sq([0,2], o, r4), 4, 1)
    // Point [1,1] to x-axis via [0,0]->[2,0]: cross=2*1-0*1=2, ab_sq=4 -> 4/4=1 -> [1,1]
    ckl("dline_sq [1,1] seg2",  cgpl_dist_line_sq([1,1], o, r2), 1, 1)
    // Point on the line: dist = 0
    ckl("dline_sq on line",     cgpl_dist_line_sq([1,0], o, r2), 0, 1)

    // cgpl_dist_seg_sq tests
    // [5,0] to segment [0,0]->[2,0]: dot=5*2+0*0=10, ab_sq=4; dot(10)>=ab_sq(4) -> nearest B=(2,0)
    //   dist=(5-2)^2+(0-0)^2=9 -> [9,1]
    ckl("dseg_sq [5,0] to 0-2", cgpl_dist_seg_sq([5,0], o, r2), 9, 1)
    // [-1,0] to segment [0,0]->[2,0]: dot=(-1)*2+0*0=-2 <= 0 -> nearest A=(0,0), dist=1 -> [1,1]
    ckl("dseg_sq [-1,0] to 0-2", cgpl_dist_seg_sq([-1,0], o, r2), 1, 1)
    // [1,2] to segment [0,0]->[2,0]: dot=1*2+2*0=2, ab_sq=4; 0<2<4 -> interior
    //   cross=2*2-0*1=4, num=16, den=4 -> gcd=4 -> [4,1]
    ckl("dseg_sq [1,2] interior", cgpl_dist_seg_sq([1,2], o, r2), 4, 1)
    // Degenerate: a==b -> dist to point
    ckl("dseg_sq degenerate", cgpl_dist_seg_sq([3,4], o, o), 25, 1)

    // Reduction test: [0,3] to line (0,0)->(4,0): cross=4*3=12, ab_sq=16 -> 144/16 -> gcd=16 -> [9,1]
    ckl("dline_sq [0,3] to 0-4", cgpl_dist_line_sq([0,3], o, r4), 9, 1)

    print("PASS _cg_point_line_test")
