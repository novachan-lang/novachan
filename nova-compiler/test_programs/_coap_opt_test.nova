// KAT for std/net/coap_opt — CoAP option delta+length encoding.
import std/net/coap_opt

fn cki(label, got, want)
    if got != want
        print("FAIL coap_opt " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── Vector 1: single option number 11 (Uri-Path), value "abc" ───────────
    // delta=11 (from 0), len=3
    // header nibbles: dn=11, ln=3 => byte=(11<<4)|3 = 0xB3
    // value: ord('a')=97, ord('b')=98, ord('c')=99
    let val1 = [97, 98, 99]
    let opt1 = [11, val1]
    let opts1 = [opt1]
    let enc1 = coap_opt_encode(opts1)
    cki("v1_len",  len(enc1), 4)
    cki("v1_b0",   enc1[0],   0xB3)
    cki("v1_b1",   enc1[1],   97)
    cki("v1_b2",   enc1[2],   98)
    cki("v1_b3",   enc1[3],   99)

    // ── Vector 2: two options with delta encoding ─────────────────────────────
    // Option 11 (Uri-Path), value "te" (2 bytes)
    // Option 17 (Uri-Query), value "x" (1 byte)
    // First: delta=11, len=2 => byte=(11<<4)|2 = 0xB2 + 0x74 0x65 ('t','e')
    // Second: delta=17-11=6, len=1 => byte=(6<<4)|1 = 0x61 + 0x78 ('x')
    let val2a = [116, 101]
    let val2b = [120]
    let opt2a = [11, val2a]
    let opt2b = [17, val2b]
    let opts2 = [opt2a, opt2b]
    let enc2 = coap_opt_encode(opts2)
    // Total: opt1 = 1 hdr + 2 val = 3 bytes; opt2 = 1 hdr + 1 val = 2 bytes => 5
    cki("v2_len",  len(enc2), 5)
    cki("v2_b0",   enc2[0],   0xB2)
    cki("v2_b1",   enc2[1],   116)
    cki("v2_b2",   enc2[2],   101)
    cki("v2_b3",   enc2[3],   0x61)
    cki("v2_b4",   enc2[4],   120)

    // ── Vector 3: option with value length >= 13 (extended length) ───────────
    // Option 15 (Uri-Path), value of length 14 (14 bytes, all 0x41='A')
    // delta=15 (from 0), len=14
    // dn=15 => nibble=15, dext=[]  WAIT: 15 means payload marker!
    // Let's use option number 15, delta=15: dn=13, dext=[15-13]=dext=[2]
    // Wait: delta < 13 → nibble=delta, else if delta < 269 → nibble=13, ext=delta-13
    // delta=15 >= 13 → nibble=13, ext=[15-13]=[2]
    // len=14 >= 13 → nibble=13, ext=[14-13]=[1]
    // header byte = (13<<4)|13 = 0xDD
    // Then 2 ext bytes: delta_ext=2, len_ext=1
    // Then 14 value bytes = 0x41 repeated
    let val3 = []
    let vi3 = 0
    while vi3 < 14
        push(val3, 0x41)
        vi3 = vi3 + 1
    let opt3 = [15, val3]
    let opts3 = [opt3]
    let enc3 = coap_opt_encode(opts3)
    // Total: 1 header + 1 delta_ext + 1 len_ext + 14 value = 17 bytes
    cki("v3_len",  len(enc3), 17)
    cki("v3_b0",   enc3[0],   0xDD)
    cki("v3_b1",   enc3[1],   2)
    cki("v3_b2",   enc3[2],   1)
    cki("v3_b3",   enc3[3],   0x41)
    cki("v3_b_last", enc3[16], 0x41)

    // ── Vector 4: round-trip decode of vector 1 ──────────────────────────────
    let dec1 = coap_opt_decode(enc1, 0, 0)
    let dec1_opts = dec1[0]
    let dec1_pos  = dec1[1]
    cki("rt1_npos",  dec1_pos,          4)
    cki("rt1_nopt",  len(dec1_opts),    1)
    let rt1_opt = dec1_opts[0]
    cki("rt1_num",   rt1_opt[0],        11)
    let rt1_val = rt1_opt[1]
    cki("rt1_vlen",  len(rt1_val),      3)
    cki("rt1_v0",    rt1_val[0],        97)
    cki("rt1_v1",    rt1_val[1],        98)
    cki("rt1_v2",    rt1_val[2],        99)

    // ── Vector 5: round-trip decode of vector 2 ──────────────────────────────
    let dec2 = coap_opt_decode(enc2, 0, 0)
    let dec2_opts = dec2[0]
    let dec2_pos  = dec2[1]
    cki("rt2_nopt",  len(dec2_opts),    2)
    cki("rt2_pos",   dec2_pos,          5)
    // 5 total bytes: pos=5 (past end)
    let rt2_o0 = dec2_opts[0]
    cki("rt2_o0_num", rt2_o0[0],       11)
    let rt2_v0 = rt2_o0[1]
    cki("rt2_o0_vlen", len(rt2_v0),    2)
    cki("rt2_o0_v0",  rt2_v0[0],       116)
    cki("rt2_o0_v1",  rt2_v0[1],       101)
    let rt2_o1 = dec2_opts[1]
    cki("rt2_o1_num", rt2_o1[0],       17)
    let rt2_v1 = rt2_o1[1]
    cki("rt2_o1_vlen", len(rt2_v1),    1)
    cki("rt2_o1_v0",  rt2_v1[0],       120)

    // ── Vector 6: round-trip decode of vector 3 (extended length) ────────────
    let dec3 = coap_opt_decode(enc3, 0, 0)
    let dec3_opts = dec3[0]
    let dec3_pos  = dec3[1]
    cki("rt3_nopt",  len(dec3_opts),    1)
    cki("rt3_pos",   dec3_pos,          17)
    let rt3_o0 = dec3_opts[0]
    cki("rt3_num",   rt3_o0[0],         15)
    let rt3_v = rt3_o0[1]
    cki("rt3_vlen",  len(rt3_v),        14)
    cki("rt3_v0",    rt3_v[0],          0x41)
    cki("rt3_v13",   rt3_v[13],         0x41)

    // ── Vector 7: stops at payload marker 0xFF ───────────────────────────────
    // One option followed by 0xFF (payload marker)
    let val4 = [1, 2]
    let opt4 = [3, val4]
    let opts4 = [opt4]
    let enc4_base = coap_opt_encode(opts4)
    // Manually append 0xFF payload marker
    // enc4_base should be: [0x32, 0x01, 0x02] (delta=3,len=2)
    let enc4 = []
    let eci = 0
    while eci < len(enc4_base)
        push(enc4, enc4_base[eci])
        eci = eci + 1
    push(enc4, 0xFF)
    push(enc4, 0xDE)
    push(enc4, 0xAD)
    let dec4 = coap_opt_decode(enc4, 0, 0)
    let dec4_opts = dec4[0]
    let dec4_pos  = dec4[1]
    cki("v7_nopt",   len(dec4_opts),    1)
    // pos should be at the 0xFF byte (stopped before it)
    cki("v7_pos",    dec4_pos,          3)
    let rt4_o0 = dec4_opts[0]
    cki("v7_num",    rt4_o0[0],         3)
    let rt4_v = rt4_o0[1]
    cki("v7_vlen",   len(rt4_v),        2)
    cki("v7_v0",     rt4_v[0],          1)
    cki("v7_v1",     rt4_v[1],          2)

    print("PASS _coap_opt_test")
