// KAT for prism/ui/prism_ui_result.nova (PRISM_ROADMAP.md milestone MB.26, the `ui/` composition
// layer's error/result-state components: error page, inline error, success, loading).
//
// Every expected shape below is hand-computed from `prism_node.prism_node_new`'s own depth/count
// rule (leaf: depth=1, count=1; branch: depth=max(child depths)+1, count=1+sum(child counts)) --
// never taken on faith from the implementation. Proves, against concrete expected values:
//   1. Error page: exact stack shape in all 4 presence combinations of rs_code/rs_action_label;
//      a present-but-blank rs_code degrades to the SAME shape as rs_code==None (tolerant-degrade);
//      a present-but-blank rs_action_label is REJECTED (not tolerant-degraded, unlike rs_code --
//      see file header for why); rejects an empty rs_title/rs_message.
//   2. Inline error: exact band[glyph(close), label(message)] shape; rejects an empty rs_message.
//   3. Success: exact stack[glyph(check), label(title), label(message)] shape with and without an
//      action button; a present-but-blank rs_action_label is rejected; rejects an empty
//      rs_title/rs_message.
//   4. Loading: rs_message==None and rs_message==Some("") both render the SAME bare glyph(search)
//      leaf (depth=1, count=1); rs_message==Some(non-empty) renders band[glyph(search),
//      label(message)]; the search glyph's attrs are BYTE-IDENTICAL ({"icon": "search"}, no
//      "spinning"/"rs_spinning" key) in both the bare and the with-message case, proving the "no
//      stored spinning attr" design decision from the file header. Never fails -- no rejection
//      case exists for this function.
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova into
// $NOVA_HOME/lib, so `import prism_node` / `import prism_ui_result` resolve.
//   ./gen3_test.exe _kat_prism_ui_result.nova
//   clang -O2 -o _kat_prism_ui_result.exe _kat_prism_ui_result.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_ui_result.exe

import prism_node
import prism_content
import prism_arrange
import prism_ui_result

let FAILED = [0]

fn _check(label: string, got: string, want: string)
    if got == want
        print("  pass  " + label)
    else
        print("  FAIL  " + label + "  got=" + got + "  want=" + want)
        FAILED[0] = FAILED[0] + 1

fn _check_true(label: string, cond: bool)
    if cond
        print("  pass  " + label)
    else
        print("  FAIL  " + label)
        FAILED[0] = FAILED[0] + 1

fn main()
    // ── 1. Error page ─────────────────────────────────────────────────────────────────────────
    print("== 1. error page ==")

    // No code, no action: stack[title, message]. depth=2, count=1+1+1=3.
    let e1 = unwrap(prism_ui_result.prism_rs_error_page("Not Found", none(), "The page you requested does not exist.", none()))
    _check("e1 kind == stack", prism_node.prism_node_kind_str(e1), "stack")
    _check("e1 depth", str(prism_node.prism_node_depth(e1)), "2")
    _check("e1 count", str(prism_node.prism_node_count(e1)), "3")
    let e1_kids = prism_node.prism_node_children(e1)
    _check("e1 child_count == 2 (no code, no action)", str(len(e1_kids)), "2")
    _check("e1 child 0 kind == label (title)", prism_node.prism_node_kind_str(e1_kids[0]), "label")
    _check("e1 title text", prism_node.prism_node_attr_str(e1_kids[0], "text", ""), "Not Found")
    _check("e1 message text", prism_node.prism_node_attr_str(e1_kids[1], "text", ""), "The page you requested does not exist.")

    // With code, no action: stack[code, title, message]. depth=2, count=1+3=4.
    let e2 = unwrap(prism_ui_result.prism_rs_error_page("Not Found", some("404"), "The page you requested does not exist.", none()))
    _check("e2 depth", str(prism_node.prism_node_depth(e2)), "2")
    _check("e2 count", str(prism_node.prism_node_count(e2)), "4")
    let e2_kids = prism_node.prism_node_children(e2)
    _check("e2 child_count == 3 (code, title, message)", str(len(e2_kids)), "3")
    _check("e2 child 0 kind == label (code)", prism_node.prism_node_kind_str(e2_kids[0]), "label")
    _check("e2 code text", prism_node.prism_node_attr_str(e2_kids[0], "text", ""), "404")
    _check("e2 child 1 title text", prism_node.prism_node_attr_str(e2_kids[1], "text", ""), "Not Found")

    // No code, with action: stack[title, message, press]. depth=2, count=1+3=4.
    let e3 = unwrap(prism_ui_result.prism_rs_error_page("Server Error", none(), "Something went wrong on our end.", some("Retry")))
    _check("e3 depth", str(prism_node.prism_node_depth(e3)), "2")
    _check("e3 count", str(prism_node.prism_node_count(e3)), "4")
    let e3_kids = prism_node.prism_node_children(e3)
    _check("e3 child_count == 3 (title, message, action)", str(len(e3_kids)), "3")
    _check("e3 last child kind == press", prism_node.prism_node_kind_str(e3_kids[2]), "press")
    _check("e3 action text", prism_node.prism_node_attr_str(e3_kids[2], "text", ""), "Retry")

    // With code AND action: stack[code, title, message, press]. depth=2, count=1+4=5.
    let e4 = unwrap(prism_ui_result.prism_rs_error_page("Server Error", some("500"), "Something went wrong on our end.", some("Retry")))
    _check("e4 depth", str(prism_node.prism_node_depth(e4)), "2")
    _check("e4 count", str(prism_node.prism_node_count(e4)), "5")
    let e4_kids = prism_node.prism_node_children(e4)
    _check("e4 child_count == 4 (code, title, message, action)", str(len(e4_kids)), "4")
    _check("e4 code text", prism_node.prism_node_attr_str(e4_kids[0], "text", ""), "500")
    _check("e4 title text", prism_node.prism_node_attr_str(e4_kids[1], "text", ""), "Server Error")
    _check("e4 message text", prism_node.prism_node_attr_str(e4_kids[2], "text", ""), "Something went wrong on our end.")
    _check("e4 action text", prism_node.prism_node_attr_str(e4_kids[3], "text", ""), "Retry")

    // Tolerant-degrade: a present-but-blank rs_code renders IDENTICALLY to rs_code==None.
    let e5 = unwrap(prism_ui_result.prism_rs_error_page("Not Found", some(""), "The page you requested does not exist.", none()))
    _check("e5 (blank Some(code)) child_count == 2, degrades like None", str(len(prism_node.prism_node_children(e5))), "2")
    _check("e5 count matches e1 (same degraded shape)", str(prism_node.prism_node_count(e5)), str(prism_node.prism_node_count(e1)))

    // Rejections.
    let e_empty_title = prism_ui_result.prism_rs_error_page("", none(), "msg", none())
    _check_true("error_page rejects empty rs_title", is_err(e_empty_title))
    let e_empty_msg = prism_ui_result.prism_rs_error_page("Title", none(), "", none())
    _check_true("error_page rejects empty rs_message", is_err(e_empty_msg))
    // A present-but-blank rs_action_label is REJECTED, not tolerant-degraded (see file header).
    let e_blank_action = prism_ui_result.prism_rs_error_page("Not Found", none(), "msg", some(""))
    _check_true("error_page rejects a present-but-blank rs_action_label (not tolerant-degraded)", is_err(e_blank_action))

    // ── 2. Inline error ───────────────────────────────────────────────────────────────────────
    print("== 2. inline error ==")

    let ie1 = unwrap(prism_ui_result.prism_rs_inline_error("This field is required."))
    _check("ie1 kind == band", prism_node.prism_node_kind_str(ie1), "band")
    _check("ie1 depth", str(prism_node.prism_node_depth(ie1)), "2")
    _check("ie1 count", str(prism_node.prism_node_count(ie1)), "3")
    let ie1_kids = prism_node.prism_node_children(ie1)
    _check("ie1 child 0 kind == glyph", prism_node.prism_node_kind_str(ie1_kids[0]), "glyph")
    _check("ie1 child 0 icon == close", prism_node.prism_node_attr_str(ie1_kids[0], "icon", ""), "close")
    _check("ie1 child 1 kind == label", prism_node.prism_node_kind_str(ie1_kids[1]), "label")
    _check("ie1 message text", prism_node.prism_node_attr_str(ie1_kids[1], "text", ""), "This field is required.")

    let ie_empty = prism_ui_result.prism_rs_inline_error("")
    _check_true("inline_error rejects empty rs_message", is_err(ie_empty))

    // ── 3. Success ────────────────────────────────────────────────────────────────────────────
    print("== 3. success ==")

    // No action: stack[check, title, message]. depth=2, count=1+3=4.
    let s1 = unwrap(prism_ui_result.prism_rs_success("Payment complete", "Your order has been placed.", none()))
    _check("s1 kind == stack", prism_node.prism_node_kind_str(s1), "stack")
    _check("s1 depth", str(prism_node.prism_node_depth(s1)), "2")
    _check("s1 count", str(prism_node.prism_node_count(s1)), "4")
    let s1_kids = prism_node.prism_node_children(s1)
    _check("s1 child_count == 3 (check, title, message)", str(len(s1_kids)), "3")
    _check("s1 child 0 kind == glyph", prism_node.prism_node_kind_str(s1_kids[0]), "glyph")
    _check("s1 child 0 icon == check", prism_node.prism_node_attr_str(s1_kids[0], "icon", ""), "check")
    _check("s1 title text", prism_node.prism_node_attr_str(s1_kids[1], "text", ""), "Payment complete")
    _check("s1 message text", prism_node.prism_node_attr_str(s1_kids[2], "text", ""), "Your order has been placed.")

    // With action: stack[check, title, message, press]. depth=2, count=1+4=5.
    let s2 = unwrap(prism_ui_result.prism_rs_success("Payment complete", "Your order has been placed.", some("View order")))
    _check("s2 depth", str(prism_node.prism_node_depth(s2)), "2")
    _check("s2 count", str(prism_node.prism_node_count(s2)), "5")
    let s2_kids = prism_node.prism_node_children(s2)
    _check("s2 child_count == 4 (check, title, message, action)", str(len(s2_kids)), "4")
    _check("s2 last child kind == press", prism_node.prism_node_kind_str(s2_kids[3]), "press")
    _check("s2 action text", prism_node.prism_node_attr_str(s2_kids[3], "text", ""), "View order")

    // Rejections.
    let s_empty_title = prism_ui_result.prism_rs_success("", "msg", none())
    _check_true("success rejects empty rs_title", is_err(s_empty_title))
    let s_empty_msg = prism_ui_result.prism_rs_success("Title", "", none())
    _check_true("success rejects empty rs_message", is_err(s_empty_msg))
    let s_blank_action = prism_ui_result.prism_rs_success("Title", "msg", some(""))
    _check_true("success rejects a present-but-blank rs_action_label (not tolerant-degraded)", is_err(s_blank_action))

    // ── 4. Loading ────────────────────────────────────────────────────────────────────────────
    print("== 4. loading ==")

    // None -> bare glyph(search) leaf. depth=1, count=1.
    let l1 = unwrap(prism_ui_result.prism_rs_loading(none()))
    _check("l1 (None) kind == glyph", prism_node.prism_node_kind_str(l1), "glyph")
    _check("l1 depth", str(prism_node.prism_node_depth(l1)), "1")
    _check("l1 count", str(prism_node.prism_node_count(l1)), "1")
    _check("l1 icon == search", prism_node.prism_node_attr_str(l1, "icon", ""), "search")
    _check_true("l1 carries no rs_spinning attr", not prism_node.prism_node_has_attr(l1, "rs_spinning"))
    _check_true("l1 carries no spinning attr", not prism_node.prism_node_has_attr(l1, "spinning"))

    // Some("") -> SAME bare glyph(search) leaf as None (blank degrades).
    let l2 = unwrap(prism_ui_result.prism_rs_loading(some("")))
    _check("l2 (blank Some) kind == glyph", prism_node.prism_node_kind_str(l2), "glyph")
    _check("l2 depth", str(prism_node.prism_node_depth(l2)), "1")
    _check("l2 count", str(prism_node.prism_node_count(l2)), "1")
    _check("l2 icon == search", prism_node.prism_node_attr_str(l2, "icon", ""), "search")

    // Some(non-empty) -> band[glyph(search), label(message)]. depth=2, count=1+1+1=3.
    let l3 = unwrap(prism_ui_result.prism_rs_loading(some("Loading data...")))
    _check("l3 kind == band", prism_node.prism_node_kind_str(l3), "band")
    _check("l3 depth", str(prism_node.prism_node_depth(l3)), "2")
    _check("l3 count", str(prism_node.prism_node_count(l3)), "3")
    let l3_kids = prism_node.prism_node_children(l3)
    _check("l3 child 0 kind == glyph", prism_node.prism_node_kind_str(l3_kids[0]), "glyph")
    _check("l3 child 0 icon == search", prism_node.prism_node_attr_str(l3_kids[0], "icon", ""), "search")
    _check("l3 child 1 kind == label", prism_node.prism_node_kind_str(l3_kids[1]), "label")
    _check("l3 message text", prism_node.prism_node_attr_str(l3_kids[1], "text", ""), "Loading data...")

    // The search glyph's attrs are byte-identical whether bare (l1) or nested in a band (l3
    // child 0) -- proves the "no stored spinning attr" design decision from the file header.
    _check("l1 icon attr == l3 child 0 icon attr (byte-identical glyph)", prism_node.prism_node_attr_str(l1, "icon", ""), prism_node.prism_node_attr_str(l3_kids[0], "icon", ""))
    _check_true("l3 glyph carries no rs_spinning attr either", not prism_node.prism_node_has_attr(l3_kids[0], "rs_spinning"))
    _check_true("l3 glyph carries no spinning attr either", not prism_node.prism_node_has_attr(l3_kids[0], "spinning"))

    // ── Summary ───────────────────────────────────────────────────────────────────────────────
    if FAILED[0] == 0
        print("")
        print("_kat_prism_ui_result: ALL PASS")
    else
        print("")
        print("_kat_prism_ui_result: " + str(FAILED[0]) + " FAILURE(S)")
        exit(1)
