// WASM value-model proof for WEAPON PARITY 5.6 (Prism -> Canvas): the SAME small tree the native
// KAT (_kat_prism_render_canvas.nova) hand-verifies -- Stack([Label("Hi"), Press("Go")]) at
// 200x100, default light theme -- built and rendered to a draw-command list INSIDE the wasm
// value-model (lists, dicts, strings, Result, closures), then handed to the JS host one word at a
// time through plain exported accessor functions (no raw linear-memory parsing on the JS side --
// see prism_canvas_host.js's header for why that boundary choice was made).
//
// Every exported fn re-renders from scratch: NOVA has no mutable module-level global state (wasm
// or native -- verified project finding), so there is nothing to persist a `words` list IN across
// separate host->wasm calls without a runtime state cell. Re-rendering a 6-command tree on every
// accessor call is microseconds; correctness over cleverness for a KAT-sized buffer.
import prism_node
import prism_arrange
import prism_content
import prism_interact
import prism_render_canvas as pc

fn _tree() -> PrismNode
    unwrap(prism_arrange.prism_stack([
        unwrap(prism_content.prism_label("Hi")),
        unwrap(prism_interact.prism_press("Go", []))
    ]))

fn canvas_len() -> int
    len(unwrap(pc.prism_canvas_render(_tree(), 200, 100)))

fn canvas_word(i: int) -> int
    let words = unwrap(pc.prism_canvas_render(_tree(), 200, 100))
    if i < 0 or i >= len(words)
        return -1
    words[i]

// A second export exercising verify() itself inside wasm (not just the JS-side re-implementation
// in a gate) -- if verify()'s own logic ever diverged between native and wasm codegen, this would
// be the fn that catches it. Returns the command count on success, -1 on a verify failure (a
// buffer built and immediately verified by the SAME code can never legitimately fail, so -1 here
// is itself a signal, not swallowed).
fn canvas_verify_ok() -> int
    let words = unwrap(pc.prism_canvas_render(_tree(), 200, 100))
    let v = pc.prism_canvas_verify(words)
    if is_err(v)
        return -1
    unwrap(v)

// No print() here on purpose: a browser wasm target has nothing meaningful to print TO (stdout is
// not the DOM), and nova_rt_print_str is explicitly EXCLUDED from the value-model wasm runtime
// carve (WASM_RUNTIME_PORT.md's gate list, "print family" -- dead in wasm). main() exists only
// because the compiler requires an entry point; the real callers are canvas_len/canvas_word/
// canvas_verify_ok, each independently exported via --export-all and called directly by the host.
fn main()
    canvas_verify_ok()
