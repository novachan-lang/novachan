import std/net/rtp

fn main()
    let fails = 0

    // ── Probe A: does rtp_encode mutate the caller's ext_data buffer when the
    //    extension data length is NOT a multiple of 4 (zero-pad path)? ────────
    let extA = bytes(0)
    extA = bytes_append(extA, 0x41)
    extA = bytes_append(extA, 0x42)
    extA = bytes_append(extA, 0x43)
    let origLenA = bytes_len(extA)
    if origLenA != 3
        print("FAIL setup A: expected 3-byte ext buffer, got "+str(origLenA))
        fails = fails + 1

    let hA = {"ext_data": extA, "payload": bytes(0)}
    let eA = rtp_encode(hA)
    let afterLenA = bytes_len(extA)
    if afterLenA != origLenA
        print("FAIL A: rtp_encode mutated caller ext_data buffer in place! before="+str(origLenA)+" after="+str(afterLenA))
        fails = fails + 1
    else
        print("ok A: caller ext_data buffer length unchanged after rtp_encode")

    // Check the caller's original bytes still hold 0x41 0x42 0x43 (not corrupted
    // with a trailing zero appended into the shared buffer).
    if bytes_get(extA, 0) != 0x41 or bytes_get(extA, 1) != 0x42 or bytes_get(extA, 2) != 0x43
        print("FAIL A2: caller ext_data content corrupted after rtp_encode")
        fails = fails + 1
    else
        print("ok A2: caller ext_data content unchanged (0x41 0x42 0x43)")

    // ── Probe B: re-use the same dict/ext_data handle for a SECOND encode call
    //    and check the encoded wire output is still correct (length-word=1,
    //    4 bytes of padded ext data) despite whatever probe A did to it. ─────
    let eA2 = rtp_encode(hA)
    if bytes_len(eA) != bytes_len(eA2)
        print("FAIL B: two encodes of the SAME dict produced different lengths: "+str(bytes_len(eA))+" vs "+str(bytes_len(eA2)))
        fails = fails + 1
    else
        print("ok B: repeated encode of same input dict is length-stable")

    let bOk = 1
    let bi = 0
    while bi < bytes_len(eA)
        if bytes_get(eA, bi) != bytes_get(eA2, bi)
            bOk = 0
        bi = bi + 1
    if bOk == 0
        print("FAIL B2: repeated encode of same input dict produced DIFFERENT bytes (non-deterministic due to aliasing mutation)")
        fails = fails + 1
    else
        print("ok B2: repeated encode of same input dict is byte-identical")

    // ── Probe C: decode the first encode result eA and verify ext_data is
    //    exactly 4 bytes: 41 42 43 00 (zero-padded, per module's documented
    //    caveat) — sanity check the padding math independent of aliasing. ────
    let dA = rtp_decode(eA)
    if bytes_len(dA["ext_data"]) != 4
        print("FAIL C: ext_data length after decode: got "+str(bytes_len(dA["ext_data"]))+" want 4")
        fails = fails + 1
    else
        print("ok C: decoded ext_data length = 4 (3 real + 1 zero pad)")
    if bytes_get(dA["ext_data"], 0) != 0x41 or bytes_get(dA["ext_data"], 1) != 0x42 or bytes_get(dA["ext_data"], 2) != 0x43 or bytes_get(dA["ext_data"], 3) != 0x00
        print("FAIL C2: decoded ext_data bytes mismatch")
        fails = fails + 1
    else
        print("ok C2: decoded ext_data = 41 42 43 00")

    // ── Probe D: does the encoder ALSO mutate the caller's payload buffer
    //    (sanity: payload path uses bytes_concat, not append, so should NOT
    //    alias/mutate)? ───────────────────────────────────────────────────────
    let payD = bytes(0)
    payD = bytes_append(payD, 0x99)
    payD = bytes_append(payD, 0x98)
    let hD = {"payload": payD}
    let eD = rtp_encode(hD)
    if bytes_len(eD) != 14
        print("FAIL D0: rtp_encode with 2-byte payload should be 14 bytes, got "+str(bytes_len(eD)))
        fails = fails + 1
    if bytes_len(payD) != 2
        print("FAIL D: rtp_encode mutated caller payload buffer! len="+str(bytes_len(payD)))
        fails = fails + 1
    else
        print("ok D: caller payload buffer unaffected")

    // ── Probe E: independent re-derivation of RFC 3550 byte-exact minimal
    //    header (defense against a shared miscalculation with the builder). ──
    let hE = {"version": 2, "pt": 96, "seq": 1, "timestamp": 0, "ssrc": 0x11223344}
    let eE = rtp_encode(hE)
    let wantE = [0x80, 0x60, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x11, 0x22, 0x33, 0x44]
    let eOk = 1
    let ei = 0
    while ei < 12
        if bytes_get(eE, ei) != wantE[ei]
            eOk = 0
        ei = ei + 1
    if eOk == 0 or bytes_len(eE) != 12
        print("FAIL E: RFC 3550 minimal header byte mismatch")
        fails = fails + 1
    else
        print("ok E: RFC 3550 minimal header byte-exact (independent re-derivation)")

    // ── Probe F: length-overrun injection on extension length that would
    //    read exactly 1 byte past the buffer end (off-by-one boundary). ──────
    let bufF = bytes(0)
    bufF = bytes_append(bufF, 0x90) // X=1
    bufF = bytes_append(bufF, 0x00)
    let fi = 0
    while fi < 10
        bufF = bytes_append(bufF, 0)
        fi = fi + 1
    // now len=12; ext header profile=0, length-words=1 (needs 4 more bytes: offset 16)
    bufF = bytes_append(bufF, 0x00)
    bufF = bytes_append(bufF, 0x00)
    bufF = bytes_append(bufF, 0x00)
    bufF = bytes_append(bufF, 0x01)
    // buffer len is now 16 = offset(12)+4(exthdr); ext_len needs 4 more bytes -> total needed 20, only 16 present: must reject
    let dF = rtp_decode(bufF)
    if contains(dF, "ssrc")
        print("FAIL F: ext-data-exactly-one-word-short should be rejected in-band")
        fails = fails + 1
    else
        print("ok F: ext length requiring 1 more byte than available -> rejected (no over-read)")

    // ── Probe G: pad count exactly equal to remaining region (payload
    //    entirely consumed by padding) should be ACCEPTED with empty payload,
    //    not rejected (boundary: pad_count == n - offset is the valid edge,
    //    not > n - offset). ──────────────────────────────────────────────────
    let bufG = bytes(0)
    bufG = bytes_append(bufG, 0xA0) // P=1
    bufG = bytes_append(bufG, 0x00)
    let gi = 0
    while gi < 10
        bufG = bytes_append(bufG, 0)
        gi = gi + 1
    // len=12 so far (fixed header only). Append pad region of exactly 3 bytes,
    // last byte = 3 (pad count == entire remaining region beyond header).
    bufG = bytes_append(bufG, 0)
    bufG = bytes_append(bufG, 0)
    bufG = bytes_append(bufG, 3)
    let dG = rtp_decode(bufG)
    if contains(dG, "ssrc") == 0
        print("FAIL G: pad-count exactly consuming remaining region should be ACCEPTED (valid boundary)")
        fails = fails + 1
    else
        if bytes_len(dG["payload"]) != 0
            print("FAIL G2: payload should be empty when padding consumes entire remaining region, got len="+str(bytes_len(dG["payload"])))
            fails = fails + 1
        else
            print("ok G: pad-count == remaining region accepted, payload empty")

    if fails == 0
        print("PASS _rtp_adv_probe")
    else
        print("FAIL _rtp_adv_probe: "+str(fails)+" check(s) failed")
        exit(1)
