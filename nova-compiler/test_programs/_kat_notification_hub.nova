import forge_notification_hub

fn main()
    let n = nh_new()
    n = nh_add_channel(n, "email", "smtp")
    n = nh_add_channel(n, "sms", "twilio")
    assert(nh_channel_count(n) == 2, "2 channels")

    let r1 = nh_send(n, "email", "alice@test.com", "Hello!")
    assert(is_ok(r1), "send ok")
    n = unwrap(r1)
    assert(nh_sent_count(n) == 1, "1 sent")

    let r2 = nh_send(n, "unknown", "bob", "Hi")
    assert(is_err(r2), "unknown channel is err")

    n = nh_broadcast(n, "System update", "all-users")
    assert(nh_sent_count(n) == 3, "3 sent after broadcast")

    let last_ch = nh_last_channel(n)
    assert(is_ok(last_ch), "last channel ok")

    let last_rcpt = nh_last_recipient(n)
    assert(is_ok(last_rcpt), "last recipient ok")
    assert(unwrap(last_rcpt) == "all-users", "last rcpt=all-users")

    let empty = nh_new()
    let no_msg = nh_last_channel(empty)
    assert(is_err(no_msg), "no messages is err")

    print("NOTIFICATION-HUB KAT PASS")
