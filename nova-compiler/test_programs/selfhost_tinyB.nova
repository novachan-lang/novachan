type Tok
    k: string
    v: string
    ln: int
    co: int

fn make_tok(kind: string, val: string, line: int, col: int) -> Tok
    Tok(kind, val, line, col)

let t1 = make_tok("KW", "let", 3, 1)
match t1
    Tok(k, v, ln, co) =>
        print(k)
        print(v)
        print(co)
        if co <= 1
            print("col<=1 TRUE")
        else
            print("col<=1 FALSE")
