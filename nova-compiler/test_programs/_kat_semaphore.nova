import forge_semaphore

fn main()
    let s = sem_new(2)
    assert(sem_available(s) == 2, "2 available")
    assert(sem_max_permits(s) == 2, "max 2")

    let r1 = sem_try_acquire(s)
    s = r1["s"]
    assert(r1["acquired"] == 1, "first acquire ok")
    assert(sem_available(s) == 1, "1 available")

    let r2 = sem_try_acquire(s)
    s = r2["s"]
    assert(r2["acquired"] == 1, "second acquire ok")
    assert(sem_available(s) == 0, "0 available")

    let r3 = sem_try_acquire(s)
    s = r3["s"]
    assert(r3["acquired"] == 0, "third acquire denied")
    assert(sem_waiter_count(s) == 1, "1 waiter")

    s = sem_release(s)
    assert(sem_available(s) == 1, "1 after release")

    let r4 = sem_try_acquire(s)
    s = r4["s"]
    assert(r4["acquired"] == 1, "acquire after release ok")
    assert(sem_total_acquires(s) == 3, "3 total acquires")

    s = sem_release(s)
    s = sem_release(s)
    assert(sem_available(s) == 2, "back to full")
    s = sem_release(s)
    assert(sem_available(s) == 2, "cannot exceed max")
    assert(sem_total_releases(s) == 3, "3 releases counted")

    print("SEMAPHORE KAT PASS")
