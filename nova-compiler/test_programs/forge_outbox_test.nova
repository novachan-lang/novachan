// functional: transactional outbox add/poll/ack/pending, at-least-once
import forge_outbox

fn main()
    let ob = outbox_new()
    let id1 = outbox_add(ob, "orders", "o1")
    let id2 = outbox_add(ob, "orders", "o2")
    if id1 != 1
        print("FAIL id1")
        exit(1)
    if id2 != 2
        print("FAIL id2")
        exit(1)
    if outbox_pending(ob) != 2
        print("FAIL pending2")
        exit(1)
    if len(outbox_poll(ob, 10)) != 2
        print("FAIL poll2")
        exit(1)
    outbox_ack(ob, id1)
    if outbox_pending(ob) != 1
        print("FAIL pending1")
        exit(1)
    let b2 = outbox_poll(ob, 10)
    if len(b2) != 1
        print("FAIL poll1")
        exit(1)
    if b2[0]["id"] != 2
        print("FAIL remaining = " + str(b2[0]["id"]))
        exit(1)
    outbox_stop(ob)
    print("PASS forge_outbox")
