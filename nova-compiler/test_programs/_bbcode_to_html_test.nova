import std/text/bbcode_to_html

fn main()
    let q = chr(34)

    // KAT 1: simple bold
    let got1 = bhtml_convert("[b]hi[/b]")
    if got1 != "<b>hi</b>"
        print("FAIL bbcode_to_html KAT1: got [" + got1 + "]")
        exit(1)

    // KAT 2: [url=X]text[/url]
    let got2 = bhtml_convert("[url=http://x.com]click[/url]")
    let exp2 = "<a href=" + q + "http://x.com" + q + ">click</a>"
    if got2 != exp2
        print("FAIL bbcode_to_html KAT2: got [" + got2 + "]")
        exit(1)

    // KAT 3: bare [url]text[/url] — text doubles as href
    let got3 = bhtml_convert("[url]http://x.com[/url]")
    let exp3 = "<a href=" + q + "http://x.com" + q + ">http://x.com</a>"
    if got3 != exp3
        print("FAIL bbcode_to_html KAT3: got [" + got3 + "]")
        exit(1)

    // KAT 4: [img]url[/img] -> void <img src="...">
    let got4 = bhtml_convert("[img]http://x.com/1.png[/img]")
    let exp4 = "<img src=" + q + "http://x.com/1.png" + q + ">"
    if got4 != exp4
        print("FAIL bbcode_to_html KAT4: got [" + got4 + "]")
        exit(1)

    // KAT 5: [list][*]a[*]b[/list]
    let got5 = bhtml_convert("[list][*]a[*]b[/list]")
    if got5 != "<ul><li>a</li><li>b</li></ul>"
        print("FAIL bbcode_to_html KAT5: got [" + got5 + "]")
        exit(1)

    // KAT 6: plain text is HTML-escaped
    let got6 = bhtml_convert("a & b < c")
    if got6 != "a &amp; b &lt; c"
        print("FAIL bbcode_to_html KAT6: got [" + got6 + "]")
        exit(1)

    // KAT 7: unrecognized tag passes through as literal text
    let got7 = bhtml_convert("[foo]hi[/foo]")
    if got7 != "[foo]hi[/foo]"
        print("FAIL bbcode_to_html KAT7: got [" + got7 + "]")
        exit(1)

    // KAT 8: nested tags of different kinds
    let got8 = bhtml_convert("[b][i]x[/i][/b]")
    if got8 != "<b><i>x</i></b>"
        print("FAIL bbcode_to_html KAT8: got [" + got8 + "]")
        exit(1)

    // KAT 9: [color=X]
    let got9 = bhtml_convert("[color=red]hot[/color]")
    let exp9 = "<span style=" + q + "color:red" + q + ">hot</span>"
    if got9 != exp9
        print("FAIL bbcode_to_html KAT9: got [" + got9 + "]")
        exit(1)

    // KAT 10: [size=X]
    let got10 = bhtml_convert("[size=20]big[/size]")
    let exp10 = "<span style=" + q + "font-size:20px" + q + ">big</span>"
    if got10 != exp10
        print("FAIL bbcode_to_html KAT10: got [" + got10 + "]")
        exit(1)

    // KAT 11: [quote]
    let got11 = bhtml_convert("[quote]said[/quote]")
    if got11 != "<blockquote>said</blockquote>"
        print("FAIL bbcode_to_html KAT11: got [" + got11 + "]")
        exit(1)

    // KAT 12: [code] content is HTML-escaped but NOT re-interpreted as BBCode
    let got12 = bhtml_convert("[code]a<b>&c[/code]")
    if got12 != "<pre><code>a&lt;b&gt;&amp;c</code></pre>"
        print("FAIL bbcode_to_html KAT12: got [" + got12 + "]")
        exit(1)

    // KAT 13: unclosed tag falls back to literal passthrough
    let got13 = bhtml_convert("[b]no close")
    if got13 != "[b]no close"
        print("FAIL bbcode_to_html KAT13: got [" + got13 + "]")
        exit(1)

    print("PASS _bbcode_to_html_test")
