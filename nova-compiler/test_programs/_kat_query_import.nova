// finding-#2 regression: an imported type-method named like a builtin HOF, called as the FIRST
// call on a fresh receiver, must type-check + run (was: "container element types must match").
import std/core/query
fn main() -> int
    let ok = true
    let s = q_from([1, 2, 3, 4, 5]).sum()
    if str(s) != "15" and str(s) != "15.0"
        print("  FAIL sum got " + str(s))
        ok = false
    let c = q_from([10, 20, 30]).count()
    if c != 3
        print("  FAIL count got " + str(c))
        ok = false
    if ok
        print("QUERY-IMPORT KAT PASS")
        return 0
    print("QUERY-IMPORT KAT FAIL")
    1
