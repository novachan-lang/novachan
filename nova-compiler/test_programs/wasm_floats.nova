// WASM float test: compute sum of series 1/1 + 1/2 + ... + 1/10, print the result.
// Also compute average of integers 1..10 as a float.
// Expected output (deterministic, matches native):
//   sum = <harmonic sum H_10>
//   avg = 5.5
fn main()
    // 1. Harmonic series H_10 = 1/1 + 1/2 + ... + 1/10
    let sum = 0.0
    let i = 1
    while i <= 10
        sum = sum + 1.0 / float(i)
        i = i + 1
    print("sum = " + str(sum))

    // 2. Average of 1..10
    let total = 0.0
    let j = 1
    while j <= 10
        total = total + float(j)
        j = j + 1
    let avg = total / 10.0
    print("avg = " + str(avg))
