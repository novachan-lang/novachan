fn main()
    // unless = if not
    let x = 5
    let result = "default"
    unless x > 10
        result = "small"
    assert_eq(result, "small")

    // unless with else
    let y = 15
    let r2 = ""
    unless y > 10
        r2 = "small"
    else
        r2 = "big"
    assert_eq(r2, "big")

    // unless false → body runs
    unless false
        assert_true(true)

    // unless true → body skipped
    let ran = false
    unless true
        ran = true
    assert_eq(ran, false)

    // until = while not
    let count = 0
    until count >= 5
        count = count + 1
    assert_eq(count, 5)

    // until with break
    let n = 0
    until false
        n = n + 1
        if n == 3
            break
    assert_eq(n, 3)

    // until with complex condition
    let items = [10, 20, 30, 40, 50]
    let idx = 0
    let total = 0
    until idx >= len(items) or total > 50
        total = total + items[idx]
        idx = idx + 1
    assert_eq(total, 60)
    assert_eq(idx, 3)

    print("unless_until_test: all passed")
