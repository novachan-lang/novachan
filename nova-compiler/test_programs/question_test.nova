// Test: ? operator (try_unwrap) for error propagation

fn risky(x: int) -> int
    if x < 0
        error("negative")
        return 0
    return x * 10

fn propagate(x: int) -> int
    let v = risky(x)?
    return v + 1

fn main()
    // Test 1: direct catch on error-producing function
    let a = risky(-1) catch e
        print("catch-a: " + e)
        -99
    print("a = " + str(a))

    // Test 2: direct catch on success
    let b = risky(5) catch e
        print("catch-b: " + e)
        -99
    print("b = " + str(b))

    // Test 3: ? propagation with outer catch
    let c = propagate(-1) catch e
        print("catch-c: " + e)
        -99
    print("c = " + str(c))

    // Test 4: ? no error
    let d = propagate(3) catch e
        print("catch-d: " + e)
        -99
    print("d = " + str(d))
