// Differential oracle for the value-model overhaul.
// Covers {large int, neg large int, float, neg float, small int} crossed with
// every `any`-widen context (any return, any param, any local, dict value,
// list elem, nested list, channel) under str().
// Prints PASS / FAIL per cell; exits non-zero if any cell fails.

let fails = []

fn chk(label: string, got: string, want: string)
    if got == want
        print("PASS " + label)
    else
        print("FAIL " + label + " : got=" + got + " want=" + want)
        push(fails, label)

// ── any return ───────────────────────────────────────────────
fn ret_bigint() -> any
    4610549147222700502
fn ret_negbig() -> any
    -4610549147222700502
fn ret_float() -> any
    3.14
fn ret_negfloat() -> any
    -2.5
fn ret_small() -> any
    42

chk("ret bigint", str(ret_bigint()), "4610549147222700502")
chk("ret negbig", str(ret_negbig()), "-4610549147222700502")
chk("ret float", str(ret_float()), "3.14")
chk("ret negfloat", str(ret_negfloat()), "-2.5")
chk("ret small", str(ret_small()), "42")

// ── any param ────────────────────────────────────────────────
fn show_any(x: any) -> string
    str(x)

chk("param bigint", show_any(4610549147222700502), "4610549147222700502")
chk("param negbig", show_any(-4610549147222700502), "-4610549147222700502")
chk("param float", show_any(3.14), "3.14")
chk("param negfloat", show_any(-2.5), "-2.5")
chk("param small", show_any(42), "42")

// ── any local ────────────────────────────────────────────────
let l_big: any = 4610549147222700502
let l_neg: any = -4610549147222700502
let l_flt: any = 3.14
let l_nf: any = -2.5
let l_sm: any = 42
chk("local bigint", str(l_big), "4610549147222700502")
chk("local negbig", str(l_neg), "-4610549147222700502")
chk("local float", str(l_flt), "3.14")
chk("local negfloat", str(l_nf), "-2.5")
chk("local small", str(l_sm), "42")

// ── dict value ───────────────────────────────────────────────
let d = {}
d["big"] = 4610549147222700502
d["neg"] = -4610549147222700502
d["flt"] = 3.14
d["nf"] = -2.5
d["sm"] = 42
chk("dict bigint", str(d["big"]), "4610549147222700502")
chk("dict negbig", str(d["neg"]), "-4610549147222700502")
chk("dict float", str(d["flt"]), "3.14")
chk("dict negfloat", str(d["nf"]), "-2.5")
chk("dict small", str(d["sm"]), "42")

// ── list elem ────────────────────────────────────────────────
let xs = []
push(xs, 4610549147222700502)
push(xs, -4610549147222700502)
push(xs, 3.14)
push(xs, -2.5)
push(xs, 42)
chk("list bigint", str(xs[0]), "4610549147222700502")
chk("list negbig", str(xs[1]), "-4610549147222700502")
chk("list float", str(xs[2]), "3.14")
chk("list negfloat", str(xs[3]), "-2.5")
chk("list small", str(xs[4]), "42")

// ── channel ──────────────────────────────────────────────────
let cb = channel()
send(cb, 4610549147222700502)
chk("chan bigint", str(recv(cb)), "4610549147222700502")
let cf = channel()
send(cf, 3.14)
chk("chan float", str(recv(cf)), "3.14")

// ── arithmetic through any (the const_vals corruption shape) ──
fn neg_via_any(x: any) -> any
    0 - x
chk("arith negate bigint", str(neg_via_any(4610549147222700502)), "-4610549147222700502")

print("")
if len(fails) == 0
    print("ALL VALUE-MODEL CELLS PASS")
else
    print("VALUE-MODEL FAILURES: " + str(len(fails)))
    exit(1)
