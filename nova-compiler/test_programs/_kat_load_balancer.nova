import forge_load_balancer

fn main()
    let lb = lb_new("round-robin")
    lb = lb_add_backend(lb, "10.0.0.1", 8080, 1)
    lb = lb_add_backend(lb, "10.0.0.2", 8080, 1)
    lb = lb_add_backend(lb, "10.0.0.3", 8080, 1)

    assert(lb_backend_count(lb) == 3, "3 backends")
    assert(lb_healthy_count(lb) == 3, "3 healthy")

    let r1 = lb_next(lb)
    assert(r1["host"] == "10.0.0.1", "first=10.0.0.1")
    let r2 = lb_next(lb)
    assert(r2["host"] == "10.0.0.2", "second=10.0.0.2")
    let r3 = lb_next(lb)
    assert(r3["host"] == "10.0.0.3", "third=10.0.0.3")
    let r4 = lb_next(lb)
    assert(r4["host"] == "10.0.0.1", "wraps to first")

    assert(lb_total_routed(lb) == 4, "4 routed")

    lb = lb_set_health(lb, 0, false)
    assert(lb_healthy_count(lb) == 2, "2 healthy")
    let r5 = lb_next(lb)
    assert(r5["host"] == "10.0.0.2", "skips unhealthy")

    let lb2 = lb_new("least-conn")
    lb2 = lb_add_backend(lb2, "a.com", 80, 1)
    lb2 = lb_add_backend(lb2, "b.com", 80, 1)

    let lc1 = lb_next(lb2)
    assert(lc1["host"] == "a.com", "least-conn first")
    let lc2 = lb_next(lb2)
    assert(lc2["host"] == "b.com", "least-conn second (a has 1 conn)")

    lb2 = lb_release(lb2, 0)
    let lc3 = lb_next(lb2)
    assert(lc3["host"] == "a.com", "a released, picked again")

    print("LOAD-BALANCER KAT PASS")
