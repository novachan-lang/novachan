import forge_load_balancer

fn main()
    let b = lb_new()
    b = lb_add(b, "s1", "10.0.0.1:8080")
    b = lb_add(b, "s2", "10.0.0.2:8080")
    assert(lb_backend_count(b) == 2, "2 backends")

    let r1 = lb_next(b)
    assert(is_ok(r1), "next ok")
    assert(unwrap(r1) == "10.0.0.1:8080", "first=s1")

    let r2 = lb_next(b)
    assert(is_ok(r2), "next ok 2")
    assert(unwrap(r2) == "10.0.0.2:8080", "second=s2")

    assert(lb_total_routed(b) == 2, "2 routed")

    let r3 = lb_set_healthy(b, "s1", 0)
    assert(is_ok(r3), "set unhealthy")
    b = unwrap(r3)

    let r4 = lb_next(b)
    assert(is_ok(r4), "next skips s1")
    assert(unwrap(r4) == "10.0.0.2:8080", "only s2 healthy")

    let bad = lb_set_healthy(b, "nope", 0)
    assert(is_err(bad), "unknown backend")

    print("LOAD-BALANCER KAT PASS")
