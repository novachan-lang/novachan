// Forge T4.15: the application root ties a supervisor + a registry. app_start brings up both; the
// supervised children run; the registry is queryable. Socketless (spawn/atomic) -> kill-on-timeout safe.
import forge_otp

fn bump(counter)
    atomic_add(counter, 1)

fn main()
    let counter = atomic_new(0)
    let app = application("myapp")
    let w = fn() bump(counter)
    app_child(app, "w1", w, "transient", 5000)
    app_child(app, "w2", w, "transient", 5000)
    if sup_child_count(app_supervisor(app)) != 2
        print("FAIL: child count != 2")
        exit(1)
    app_start(app)
    sleep(150)
    if atomic_get(counter) != 2
        print("FAIL: both children should have run, counter=" + str(atomic_get(counter)))
        exit(1)
    let reg = app_registry(app)
    reg_put(reg, "svc", 42)
    if reg_get(reg, "svc") != 42
        print("FAIL: app registry not working")
        exit(1)
    print("PASS forge_application (2 supervised children ran; registry up + queryable)")
