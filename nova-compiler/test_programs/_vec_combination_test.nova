import std/vector/vec_combination

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn ckl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + ": length mismatch got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL " + label + ": index " + str(i) + " got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // KAT 1: vco_linear([[1,0],[0,1]],[3,4]) = [3,4]
    let v1a = [1, 0]
    let v1b = [0, 1]
    let vecs1 = [v1a, v1b]
    let coeffs1 = [3, 4]
    let r1 = vco_linear(vecs1, coeffs1)
    ckl("linear_basis_3_4", r1, [3, 4])

    // KAT 2: vco_linear([[1,1],[2,2]],[1,-1]) = [-1,-1]
    let v2a = [1, 1]
    let v2b = [2, 2]
    let vecs2 = [v2a, v2b]
    let coeffs2 = [1, -1]
    let r2 = vco_linear(vecs2, coeffs2)
    ckl("linear_1neg1", r2, [-1, -1])

    // KAT 3: vco_add_scaled([1,2],[3,4],2) = [7,10]
    let a3 = [1, 2]
    let b3 = [3, 4]
    let r3 = vco_add_scaled(a3, b3, 2)
    ckl("add_scaled_2", r3, [7, 10])

    // KAT 4: vco_linear([[1,2,3]],[2]) = [2,4,6]
    let v4a = [1, 2, 3]
    let vecs4 = [v4a]
    let coeffs4 = [2]
    let r4 = vco_linear(vecs4, coeffs4)
    ckl("linear_scale3d", r4, [2, 4, 6])

    // KAT 5: vco_linear([[1,0],[0,1],[1,1]],[1,1,1]) = [2,2]
    let v5a = [1, 0]
    let v5b = [0, 1]
    let v5c = [1, 1]
    let vecs5 = [v5a, v5b, v5c]
    let coeffs5 = [1, 1, 1]
    let r5 = vco_linear(vecs5, coeffs5)
    ckl("linear_3vecs_111", r5, [2, 2])

    // KAT 6: vco_add_scaled with negative scalar
    let a6 = [5, 5]
    let b6 = [1, 2]
    let r6 = vco_add_scaled(a6, b6, -1)
    ckl("add_scaled_neg1", r6, [4, 3])

    // KAT 7: vco_barycentric same as vco_linear
    let vb1 = [2, 0]
    let vb2 = [0, 4]
    let vecsb = [vb1, vb2]
    let weightsb = [1, 1]
    let rb = vco_barycentric(vecsb, weightsb)
    ckl("barycentric_sum", rb, [2, 4])

    // KAT 8: vco_linear with zero coefficient
    let v8a = [1, 2]
    let v8b = [3, 4]
    let vecs8 = [v8a, v8b]
    let coeffs8 = [1, 0]
    let r8 = vco_linear(vecs8, coeffs8)
    ckl("linear_zero_coeff", r8, [1, 2])

    // KAT 9: vco_linear empty vectors list -> []
    let vecsE = []
    let coeffsE = []
    let rE = vco_linear(vecsE, coeffsE)
    cki("linear_empty_len", len(rE), 0)

    print("PASS _vec_combination_test")
