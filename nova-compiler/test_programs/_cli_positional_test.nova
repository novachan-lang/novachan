import std/cli/cli_positional

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn ckl(label: string, got: any, want: any)
    if len(got) != len(want)
        print("FAIL " + label + ": len " + str(len(got)) + " != " + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL " + label + " [" + str(i) + "]: '" + got[i] + "' != '" + want[i] + "'")
            exit(1)
        i = i + 1

fn main()
    // KAT: clp_positionals(['cmd','--port','8080','file'],['--port'])=['cmd','file']
    ckl("positionals_with_opt", clp_positionals(["cmd", "--port", "8080", "file"], ["--port"]), ["cmd", "file"])

    // KAT: clp_positionals(['a','-v','b'],[])=['a','b']
    ckl("positionals_skip_flag", clp_positionals(["a", "-v", "b"], []), ["a", "b"])

    // KAT: clp_nth(['cmd','x','y'],[],1)='y'
    cks("nth_index1", clp_nth(["cmd", "x", "y"], [], 1), "y")

    // KAT: clp_after_ddash(['a','--','b','-c'])=['b','-c']
    ckl("after_ddash_basic", clp_after_ddash(["a", "--", "b", "-c"]), ["b", "-c"])

    // KAT: clp_positionals([],[])=[]
    ckl("positionals_empty", clp_positionals([], []), [])

    // Additional robustness tests.

    // nth index 0 returns first real argument (after command name).
    cks("nth_index0", clp_nth(["cmd", "x", "y"], [], 0), "x")

    // nth out of range returns ''.
    cks("nth_oob", clp_nth(["cmd"], [], 5), "")

    // nth with value_opts skipping: positionals=['cmd','file'], nth(0)='file' (positionals[1]).
    cks("nth_with_vopts", clp_nth(["cmd", "--port", "8080", "file"], ["--port"], 0), "file")

    // after_ddash with nothing after '--' returns [].
    ckl("after_ddash_empty_tail", clp_after_ddash(["a", "--"]), [])

    // after_ddash with no '--' returns [].
    ckl("after_ddash_no_ddash", clp_after_ddash(["a", "b"]), [])

    // after_ddash on empty argv returns [].
    ckl("after_ddash_empty", clp_after_ddash([]), [])

    // positionals: '--' causes everything after to be positional.
    ckl("positionals_ddash", clp_positionals(["a", "--", "--port", "8080"], ["--port"]), ["a", "--port", "8080"])

    // positionals with eq-form option: should skip the token (no following value consumed).
    ckl("positionals_eq_form", clp_positionals(["cmd", "--port=8080", "file"], ["--port"]), ["cmd", "file"])

    // positionals: unknown long option (not in value_opts) is treated as flag → skipped.
    ckl("positionals_unknown_long", clp_positionals(["--unknown", "file"], []), ["file"])

    print("PASS _cli_positional_test")
