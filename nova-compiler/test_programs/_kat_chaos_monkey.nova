import forge_chaos_monkey

fn main()
    let c = cm_new()
    c = cm_add_target(c, "db", "crash")
    c = cm_add_target(c, "cache", "latency")
    c = cm_add_target(c, "api", "error")

    let r1 = cm_inject(c, 10, 50)
    c = r1["c"]
    assert(r1["injected"] == 1, "fault injected")
    assert(cm_total_faults(c) == 1, "1 fault")

    let r2 = cm_inject(c, 80, 50)
    c = r2["c"]
    assert(r2["injected"] == 0, "above threshold")

    c = cm_pause(c)
    let r3 = cm_inject(c, 10, 50)
    c = r3["c"]
    assert(r3["injected"] == 0, "paused")

    c = cm_resume(c)
    let r4 = cm_inject(c, 5, 50)
    c = r4["c"]
    assert(r4["injected"] == 1, "resumed")
    assert(cm_total_faults(c) == 2, "2 total")

    print("CHAOS-MONKEY KAT PASS")
