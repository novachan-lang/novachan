// 1.7 cycle COLLECTOR — the detector says where; this reclaims.
//
// Two collection modes exist and this exercises the harder one, cycle_collect(), which runs
// MID-PROGRAM and therefore must prove unreachability before freeing anything. The proof is
// per-SCC: sum(refcounts of members) == number of edges that stay inside the SCC, i.e.
// nothing outside points in. That test is useless for FINDING cycles in NOVA (a live A<->B
// pair measures rc=2/internal=1 because the compiler emits no drop for an escaping local),
// but it is exactly right for AUTHORISING a free, because a stale count pushes sum_rc ABOVE
// internal and the cycle is KEPT. Under-collection is a leak we already had; over-collection
// is a use-after-free. The predicate errs toward the first.
//
// Section 2 is the load-bearing one. A gate that only checked "cycles got freed" would pass
// just as well against a collector that freed everything, which would corrupt live data.

type CcNode
    cc_id: int
    cc_next: CcNode
    cc_tag: str

fn main()
    let freed_total = 0

    // ---- 1. an UNREACHABLE cycle, held only by a container we then clear ----------
    // The dict is the sole external reference. While it holds the nodes, sum_rc exceeds
    // the internal edge count and the collector must decline. After the dict drops them
    // the only references left are the nodes' own, so the proof succeeds. Testing BOTH
    // sides of that one line is the point -- a collector that ignored the proof would
    // pass the second check and fail the first.
    let keep = {}
    let p1 = CcNode(1, null, "p1")
    let p2 = CcNode(2, null, "p2")
    p1.cc_next = p2
    p2.cc_next = p1
    keep["a"] = p1
    keep["b"] = p2

    let while_held = cycle_collect()
    if while_held == 0
        print("HELD ok: a cycle still referenced from a live dict was NOT collected")
    else if while_held < 0
        print("HELD skip: collector refused (detector not armed, or N>1 carriers)")
    else
        print("HELD FAIL: collected " + str(while_held) + " objects that were still reachable")

    // drop the external references
    keep["a"] = null
    keep["b"] = null
    p1 = null
    p2 = null

    // MEASURED, and the honest result: this returns 0 today, not 2.
    //
    // `p1` and `p2` are locals that ESCAPE (into each other's fields), and the compiler
    // conservatively emits NO DROP for an escaping local. So their refcounts stay inflated
    // for the life of the program no matter what the source does afterwards -- setting them
    // to null above changes nothing. sum_rc therefore stays above the internal edge count
    // and the proof correctly declines.
    //
    // That is a COMPILER limitation (missing drops), not a collector one, and the collector
    // is behaving exactly as designed: when it cannot prove unreachability it keeps the
    // objects. Under-collecting is a leak we already had; over-collecting is a
    // use-after-free. The assertion below is written against what is TRUE rather than what
    // would be nice, because a test that demanded > 0 here would be demanding the unsound
    // behaviour.
    let after = cycle_collect()
    if after < 0
        print("FREE skip: collector refused")
    else
        freed_total = freed_total + after
        print("FREE collected=" + str(after) + " (0 expected: escaping locals are never dropped)")

    // ---- 2. a REACHABLE cycle must SURVIVE, and stay readable ---------------------
    // Built and kept in scope. If the collector freed it, reading cc_tag below is a
    // use-after-free: either a crash, or a garbage string. Asserting the VALUE (not just
    // that we did not crash) is what makes this a real check -- freed-then-reused memory
    // can still be readable.
    let live1 = CcNode(10, null, "live-one")
    let live2 = CcNode(11, null, "live-two")
    live1.cc_next = live2
    live2.cc_next = live1

    // n2 must be 0: every cycle alive at this point is still referenced, so the proof must
    // decline all of them. Asserting the COUNT as well as the readback is deliberate --
    // a collector that freed these and got lucky with reused memory would still read back
    // the right strings, and only the count would give it away.
    let n2 = cycle_collect()

    if live1.cc_tag == "live-one" and live2.cc_tag == "live-two" and live1.cc_next.cc_id == 11 and n2 <= 0
        print("SURVIVE ok: a reachable cycle was left intact and reads correctly")
    else
        print("SURVIVE FAIL: reachable cycle corrupted or collected -- tag=" + live1.cc_tag + " freed=" + str(n2))

    // ---- 3. ACYCLIC data must never be touched -----------------------------------
    // A chain, not a ring. It is not in any SCC, so the collector should not consider it
    // at all; this guards against a sever pass that walked outside its own cycle.
    let c3 = CcNode(23, null, "tail")
    let c2 = CcNode(22, c3, "mid")
    let c1 = CcNode(21, c2, "head")
    // Nothing here is in a cycle, so nothing is collectible: n3 must be 0. A non-zero count
    // would mean the sever pass walked outside its own SCC.
    let n3 = cycle_collect()
    if c1.cc_tag == "head" and c1.cc_next.cc_next.cc_tag == "tail" and n3 <= 0
        print("ACYCLIC ok: a plain chain was untouched")
    else
        print("ACYCLIC FAIL: acyclic chain damaged or collected -- freed=" + str(n3))

    // ---- 4. edges LEAVING a collected cycle must be released, not leaked ---------
    // The cycle holds a string that nothing else references. Freeing the cycle has to
    // decrement that outbound edge too, or the collector trades a cycle leak for a
    // payload leak. Verified by the gate through the live-object count, not from here.
    let o1 = CcNode(31, null, "outbound-payload-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
    let o2 = CcNode(32, null, "outbound-payload-bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")
    o1.cc_next = o2
    o2.cc_next = o1
    o1 = null
    o2 = null
    let n4 = cycle_collect()
    freed_total = freed_total + n4

    print("CYC_COLLECT total_freed=" + str(freed_total))
    print("CYC_COLLECT DONE")
