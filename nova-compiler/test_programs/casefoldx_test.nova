// Oracle for casefoldx (Unicode default full case folding), exercised THROUGH import.
// Non-ASCII inputs are built via from_codepoint(cp) so this source stays pure ASCII and
// every codepoint is explicit (no reliance on the file's byte encoding).
import casefoldx

fn cp(c)
    from_codepoint(c)

fn main()
    // ASCII
    assert(casefoldx.casefold("ABCxyz") == "abcxyz", "ascii fold")
    assert(casefoldx.equals_ignore_case("Hello", "HELLO"), "ascii eqic")
    assert(not casefoldx.equals_ignore_case("abc", "abd"), "ascii negative")

    // German sharp s (U+00DF) -> "ss"; mixed-case Strasse must match (the headline case)
    let sharp = cp(223)
    assert(casefoldx.casefold(sharp) == "ss", "sharp-s -> ss")
    assert(casefoldx.equals_ignore_case("Stra" + sharp + "e", "STRASSE"), "strasse fold")

    // Latin-1 accented capital -> lowercase (A-grave U+00C0 -> a-grave U+00E0)
    assert(casefoldx.equals_ignore_case(cp(192), cp(224)), "latin1 A-grave fold")
    // multiplication sign U+00D7 is NOT a letter -> unchanged
    assert(casefoldx.casefold(cp(215)) == cp(215), "U+00D7 passthrough")

    // micro sign U+00B5 -> Greek small mu U+03BC
    assert(casefoldx.casefold(cp(181)) == cp(956), "micro -> mu")

    // dotted capital I U+0130 -> "i" + combining dot above U+0307 (default, non-Turkic)
    assert(casefoldx.casefold(cp(304)) == cp(105) + cp(775), "dotted-I fold")

    // Greek: Sigma U+03A3 and final sigma U+03C2 both fold to small sigma U+03C3
    assert(casefoldx.equals_ignore_case(cp(931), cp(963)), "Sigma fold")
    assert(casefoldx.equals_ignore_case(cp(962), cp(963)), "final-sigma fold")
    // Greek word: ABG (caps) == abg (smalls)
    assert(casefoldx.equals_ignore_case(cp(913) + cp(914) + cp(915), cp(945) + cp(946) + cp(947)), "greek word fold")

    // Cyrillic: A U+0410 -> a U+0430; Yo U+0401 -> yo U+0451
    assert(casefoldx.equals_ignore_case(cp(1040), cp(1072)), "cyrillic A fold")
    assert(casefoldx.equals_ignore_case(cp(1025), cp(1105)), "cyrillic Yo fold")

    // pass-through safety: an uncovered codepoint (Latin Extended-A U+0100) folds to itself
    assert(casefoldx.casefold(cp(256)) == cp(256), "uncovered passthrough")
    assert(casefoldx.casefold("123 !@#") == "123 !@#", "punct passthrough")

    // idempotence on covered input (folded output is lowercase -> folds to itself)
    let f = casefoldx.casefold("Stra" + sharp + "e GREEK " + cp(931))
    assert(casefoldx.casefold(f) == f, "idempotent")

    print("casefoldx_test passed: ASCII + Latin-1 + sharp-s/ss + Greek(sigma) + Cyrillic + dotted-I + passthrough")
