// _cycledetect_test.nova — KAT for std/graph/cycledetect
import std/graph/cycledetect

// ── helper assertions ─────────────────────────────────────────────────────────
fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + got + " want " + want)
        exit(1)

// ── build test graphs ─────────────────────────────────────────────────────────

// Directed cyclic: A -> B -> C -> A
let dcyc = {}
dcyc["A"] = ["B"]
dcyc["B"] = ["C"]
dcyc["C"] = ["A"]
let dcyc_nodes = ["A", "B", "C"]

// Directed acyclic: A -> B -> C
let ddag = {}
ddag["A"] = ["B"]
ddag["B"] = ["C"]
ddag["C"] = []
let ddag_nodes = ["A", "B", "C"]

// Undirected triangle: A-B-C-A (all three edges, symmetric)
let utri = {}
utri["A"] = ["B", "C"]
utri["B"] = ["A", "C"]
utri["C"] = ["A", "B"]
let utri_nodes = ["A", "B", "C"]

// Undirected path: A-B-C (no cycle, symmetric)
let upath = {}
upath["A"] = ["B"]
upath["B"] = ["A", "C"]
upath["C"] = ["B"]
let upath_nodes = ["A", "B", "C"]

// ── KAT assertions ────────────────────────────────────────────────────────────

// 1. directed cyclic graph has a cycle
let r1 = cd_has_cycle_directed(dcyc, dcyc_nodes)
if r1
    cki("cd_has_cycle_directed(cyclic)", 1, 1)
else
    cki("cd_has_cycle_directed(cyclic)", 0, 1)

// 2. directed acyclic graph has no cycle
let r2 = cd_has_cycle_directed(ddag, ddag_nodes)
if r2
    cki("cd_has_cycle_directed(dag)", 1, 0)
else
    cki("cd_has_cycle_directed(dag)", 0, 0)

// 3. cd_is_dag on dag is true
let r3 = cd_is_dag(ddag, ddag_nodes)
if r3
    cki("cd_is_dag(dag)", 1, 1)
else
    cki("cd_is_dag(dag)", 0, 1)

// 4. cd_is_dag on cyclic graph is false
let r4 = cd_is_dag(dcyc, dcyc_nodes)
if r4
    cki("cd_is_dag(cyclic)", 1, 0)
else
    cki("cd_is_dag(cyclic)", 0, 0)

// 5. undirected triangle has a cycle
let r5 = cd_has_cycle_undirected(utri, utri_nodes)
if r5
    cki("cd_has_cycle_undirected(triangle)", 1, 1)
else
    cki("cd_has_cycle_undirected(triangle)", 0, 1)

// 6. undirected path has no cycle
let r6 = cd_has_cycle_undirected(upath, upath_nodes)
if r6
    cki("cd_has_cycle_undirected(path)", 1, 0)
else
    cki("cd_has_cycle_undirected(path)", 0, 0)

print("_cycledetect_test passed")
