import forge_lcs

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn near(a: float, b: float) -> bool
    let d = a - b
    d > -0.001 and d < 0.001

fn main()
    let fails = 0

    // classic: LCS("ABCBDAB","BDCAB") length 4
    fails = fails + expect("len_classic", str(lcs_length("ABCBDAB", "BDCAB")), "4")
    // the returned LCS has that length and is a subsequence of both
    let s = lcs("ABCBDAB", "BDCAB")
    fails = fails + expect("lcs_len", str(len(s)), "4")

    // AGGTAB / GXTXAYB -> GTAB (length 4)
    fails = fails + expect("agg_len", str(lcs_length("AGGTAB", "GXTXAYB")), "4")
    fails = fails + expect("agg_lcs", lcs("AGGTAB", "GXTXAYB"), "GTAB")

    // identical
    fails = fails + expect("identical", lcs("ABC", "ABC"), "ABC")
    fails = fails + expect("identical_ratio", str(lcs_ratio("hello", "hello")), "1.0")

    // nothing in common
    fails = fails + expect("none", str(lcs_length("ABC", "DEF")), "0")
    fails = fails + expect("none_lcs", lcs("ABC", "DEF"), "")
    fails = fails + expect_true("none_ratio", near(lcs_ratio("abc", "xyz"), 0.0))

    // empty
    fails = fails + expect("empty", str(lcs_length("", "abc")), "0")
    fails = fails + expect("empty_lcs", lcs("", "abc"), "")

    // one is subsequence of the other -> equals the shorter
    fails = fails + expect("subseq", lcs("ace", "abcde"), "ace")

    // ratio: "night" vs "nacht" -> LCS "nht" (3), ratio 2*3/10 = 0.6
    fails = fails + expect_true("ratio_06", near(lcs_ratio("night", "nacht"), 0.6))

    // real word similarity: "kitten" vs "sitting" -> LCS "ittn" (4)
    fails = fails + expect("word", str(lcs_length("kitten", "sitting")), "4")

    if fails == 0
        print("forge_lcs: all passed")
    else
        print("forge_lcs: " + str(fails) + " FAILED")
