// Stage 4 SROA stress test: a local non-escaping all-scalar struct stack-allocates,
// while structs that escape (returned / stored in a list / captured by a closure /
// structurally compared with == ) must stay on the heap and remain correct.
type V
    x: int
    y: int

fn store_in_list(v)
    let lst = []
    push(lst, v)
    lst

fn make_v() -> V
    V(1, 2)

fn use_closure()
    let v = V(3, 4)
    let f = fn() v.x + v.y
    f()

fn main()
    let a = V(10, 20)
    assert_eq(a.x + a.y, 30)
    let r = make_v()
    assert_eq(r.x + r.y, 3)
    let lst = store_in_list(V(5, 6))
    assert_eq(len(lst), 1)
    assert_eq(use_closure(), 7)
    assert_eq(V(1, 2) == V(1, 2), true)
    assert_eq(V(1, 2) == V(3, 4), false)
    print("sroa_stress_test passed")
