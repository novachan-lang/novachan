// KAT for forge_azure -- builds token/blob/keyvault/sql/cosmos requests and verifies the exact URL
// and header values against the known-correct Azure REST addressing scheme.
import forge_azure
import std/core/testing

fn run() -> int
    let checks = []

    // ── client + token request ──────────────────────────────────────────────────────────────
    let client = azure_client("tenant-123", "app-abc", "s3cr3t!/val ue")
    checks = checks + [assert_eq(client["tenant_id"], "tenant-123", "client-tenant")]
    checks = checks + [assert_eq(client["client_id"], "app-abc", "client-id")]

    let tok = azure_token_request(client)
    checks = checks + [assert_eq(tok["method"], "POST", "token-method")]
    checks = checks + [assert_eq(tok["url"], "https://login.microsoftonline.com/tenant-123/oauth2/v2.0/token", "token-url")]
    checks = checks + [assert_eq(tok["headers"]["Content-Type"], "application/x-www-form-urlencoded", "token-content-type")]
    checks = checks + [assert_contains(tok["body"], "grant_type=client_credentials", "token-body-grant")]
    checks = checks + [assert_contains(tok["body"], "client_id=app-abc", "token-body-clientid")]
    // secret with reserved chars (' ', '/', '!') must come back percent-encoded, never raw
    checks = checks + [assert_contains(tok["body"], "client_secret=s3cr3t%21%2Fval%20ue", "token-body-secret-encoded")]
    checks = checks + [1 if not (tok["body"] matches "val ue") else 0]
    checks = checks + [assert_contains(tok["body"], "scope=https%3A%2F%2Fmanagement.azure.com%2F.default", "token-body-scope")]

    // ── authenticated request builder ───────────────────────────────────────────────────────
    let req = azure_request("PUT", "https://example.blob.core.windows.net/c/b", "eyJhbGciOi.abc", "{\"k\":1}")
    checks = checks + [assert_eq(req["method"], "PUT", "req-method")]
    checks = checks + [assert_eq(req["headers"]["Authorization"], "Bearer eyJhbGciOi.abc", "req-auth-header")]
    checks = checks + [assert_eq(req["headers"]["Content-Type"], "application/json", "req-content-type")]
    checks = checks + [assert_eq(req["body"], "{\"k\":1}", "req-body")]

    // ── blob URL (nested virtual-directory path preserved, spaces encoded) ─────────────────
    let blob_url = azure_blob_url("mystorage", "images", "2026/07/photo one.png")
    checks = checks + [assert_eq(blob_url, "https://mystorage.blob.core.windows.net/images/2026/07/photo%20one.png", "blob-url")]

    // ── key vault secret URL ────────────────────────────────────────────────────────────────
    let kv_url = azure_keyvault_url("myvault", "db-password")
    checks = checks + [assert_eq(kv_url, "https://myvault.vault.azure.net/secrets/db-password?api-version=7.4", "keyvault-url")]

    // ── SQL connection string ───────────────────────────────────────────────────────────────
    let sql_url = azure_sql_url("myserver", "mydb")
    checks = checks + [assert_eq(sql_url, "Server=tcp:myserver.database.windows.net,1433;Database=mydb;Encrypt=true;TrustServerCertificate=false;Connection Timeout=30;", "sql-url")]

    // ── Cosmos DB resource link ─────────────────────────────────────────────────────────────
    let cosmos_url = azure_cosmosdb_url("mycosmos", "orders db", "line-items")
    checks = checks + [assert_eq(cosmos_url, "https://mycosmos.documents.azure.com/dbs/orders%20db/colls/line-items", "cosmos-url")]

    let total = len(checks)
    let passed = checks.reduce(fn(acc, r) acc + r, 0)
    if passed != total
        print("KAT INTERNAL FAILURE: {passed}/{total} checks passed")
        return 1

    print("AZURE KAT PASS")
    return 0

fn main() -> int
    return run()
