// Phase 2.4 KAT: W2003 must fire when `orm_with_tx(db, fn(tx) ...)` uses the outer `db`.
// The file must COMPILE (exit 0) -- the warning is non-fatal.
fn orm_all(db, sql: string, params) -> list
    []

fn orm_with_tx(db, body) -> int
    body(db)

fn orm_exec(db, sql: string, params) -> int
    0

type User
    id: int
    name: string

fn main()
    let db = 0
    let r = orm_with_tx(db, fn(tx) orm_exec(db, "UPDATE User SET name = 'x'", []))
    print("done: {r}")
