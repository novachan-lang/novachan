import std/util/pipe

// Known-answer test helpers
fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label: str, got: str, want: str)
    if got != want
        print("FAIL " + label + ": got " + got + " want " + want)
        exit(1)

fn ckl_int(label: str, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + ": length mismatch got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL " + label + "[" + str(i) + "]: got " + str(got[i]) + " want " + str(want[i]))
            exit(1)
        i = i + 1

// KAT 1: pp_pipe with two functions: x+1 then x*2 on 3 -> (3+1)*2 = 8
let r1 = pp_pipe(3, [fn(x) x + 1, fn(x) x * 2])
cki("pp_pipe two fns", r1, 8)

// KAT 2: pp_pipe with empty list -> identity, returns 3
let r2 = pp_pipe(3, [])
cki("pp_pipe empty", r2, 3)

// KAT 3: pp_pipe with single fn: x*x on 5 -> 25
let r3 = pp_pipe(5, [fn(x) x * x])
cki("pp_pipe single fn", r3, 25)

// KAT 4: pp_pipe on strings: "a" + "b" + "c" = "abc"
let r4 = pp_pipe("a", [fn(s) s + "b", fn(s) s + "c"])
cks("pp_pipe string", r4, "abc")

// KAT 5: pp_pipe_all: [1,2] with x*10 -> [10,20]
let r5 = pp_pipe_all([1, 2], [fn(x) x * 10])
ckl_int("pp_pipe_all", r5, [10, 20])

// KAT 6: pp_pipe chained subtractions: 10-1-2-3 = 4
let r6 = pp_pipe(10, [fn(x) x - 1, fn(x) x - 2, fn(x) x - 3])
cki("pp_pipe chain sub", r6, 4)

// KAT 7: pp_tap returns original value (side effect fires - print is the side effect)
let r7 = pp_tap(42, fn(v) str(v))
cki("pp_tap return", r7, 42)

// KAT 8: pp_tap with identity side-effect, still returns original
let r8 = pp_tap(99, fn(v) v + 1)
cki("pp_tap does not alter value", r8, 99)

print("_pipe_test passed")
