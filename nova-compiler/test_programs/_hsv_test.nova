import std/color/hsv

// ── check helpers ─────────────────────────────────────────────────────────────

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ck_near(label: str, got: int, want: int, eps: int)
    let diff = got - want
    if diff < 0
        diff = 0 - diff
    if diff > eps
        print("FAIL " + label + ": got " + str(got) + " want " + str(want) + " eps " + str(eps))
        exit(1)

fn main()
    // ── hsv_from_rgb KATs ────────────────────────────────────────────────────

    // KAT: pure red [255,0,0] -> [0, 100, 100]
    let hsv_red = hsv_from_rgb([255, 0, 0])
    cki("from_rgb_red_h",   hsv_red[0], 0)
    cki("from_rgb_red_s",   hsv_red[1], 100)
    cki("from_rgb_red_v",   hsv_red[2], 100)

    // KAT: pure green [0,255,0] -> [120, 100, 100]
    let hsv_grn = hsv_from_rgb([0, 255, 0])
    cki("from_rgb_grn_h",   hsv_grn[0], 120)
    cki("from_rgb_grn_s",   hsv_grn[1], 100)
    cki("from_rgb_grn_v",   hsv_grn[2], 100)

    // KAT: pure blue [0,0,255] -> [240, 100, 100]
    let hsv_blu = hsv_from_rgb([0, 0, 255])
    cki("from_rgb_blu_h",   hsv_blu[0], 240)
    cki("from_rgb_blu_s",   hsv_blu[1], 100)
    cki("from_rgb_blu_v",   hsv_blu[2], 100)

    // KAT: white [255,255,255] -> [0, 0, 100]
    let hsv_wht = hsv_from_rgb([255, 255, 255])
    cki("from_rgb_wht_h",   hsv_wht[0], 0)
    cki("from_rgb_wht_s",   hsv_wht[1], 0)
    cki("from_rgb_wht_v",   hsv_wht[2], 100)

    // KAT: black [0,0,0] -> [0, 0, 0]
    let hsv_blk = hsv_from_rgb([0, 0, 0])
    cki("from_rgb_blk_h",   hsv_blk[0], 0)
    cki("from_rgb_blk_s",   hsv_blk[1], 0)
    cki("from_rgb_blk_v",   hsv_blk[2], 0)

    // KAT: grey [128,128,128] -> [0, 0, 50]  (128/255*100 = 50.2 -> 50)
    let hsv_gry = hsv_from_rgb([128, 128, 128])
    cki("from_rgb_gry_h",   hsv_gry[0], 0)
    cki("from_rgb_gry_s",   hsv_gry[1], 0)
    cki("from_rgb_gry_v",   hsv_gry[2], 50)

    // ── hsv_to_rgb KATs ──────────────────────────────────────────────────────

    // KAT: hsv(0, 100, 100) -> [255, 0, 0]
    let rgb_red = hsv_to_rgb(0, 100, 100)
    cki("to_rgb_red_r",  rgb_red[0], 255)
    cki("to_rgb_red_g",  rgb_red[1], 0)
    cki("to_rgb_red_b",  rgb_red[2], 0)

    // KAT: hsv(120, 100, 100) -> [0, 255, 0]
    let rgb_grn = hsv_to_rgb(120, 100, 100)
    cki("to_rgb_grn_r",  rgb_grn[0], 0)
    cki("to_rgb_grn_g",  rgb_grn[1], 255)
    cki("to_rgb_grn_b",  rgb_grn[2], 0)

    // extra: hsv(240, 100, 100) -> [0, 0, 255]
    let rgb_blu = hsv_to_rgb(240, 100, 100)
    cki("to_rgb_blu_r",  rgb_blu[0], 0)
    cki("to_rgb_blu_g",  rgb_blu[1], 0)
    cki("to_rgb_blu_b",  rgb_blu[2], 255)

    // extra: hsv(0, 0, 100) -> white [255, 255, 255]
    let rgb_wht = hsv_to_rgb(0, 0, 100)
    cki("to_rgb_wht_r",  rgb_wht[0], 255)
    cki("to_rgb_wht_g",  rgb_wht[1], 255)
    cki("to_rgb_wht_b",  rgb_wht[2], 255)

    // extra: hsv(0, 0, 0) -> black [0, 0, 0]
    let rgb_blk = hsv_to_rgb(0, 0, 0)
    cki("to_rgb_blk_r",  rgb_blk[0], 0)
    cki("to_rgb_blk_g",  rgb_blk[1], 0)
    cki("to_rgb_blk_b",  rgb_blk[2], 0)

    // ── Round-trip KATs (within +/-2 per channel) ────────────────────────────

    // Round-trip red
    let rt_red_in = [255, 0, 0]
    let rt_red_hsv = hsv_from_rgb(rt_red_in)
    let rt_red_out = hsv_to_rgb(rt_red_hsv[0], rt_red_hsv[1], rt_red_hsv[2])
    ck_near("rt_red_r", rt_red_out[0], 255, 2)
    ck_near("rt_red_g", rt_red_out[1], 0,   2)
    ck_near("rt_red_b", rt_red_out[2], 0,   2)

    // Round-trip green
    let rt_grn_in = [0, 255, 0]
    let rt_grn_hsv = hsv_from_rgb(rt_grn_in)
    let rt_grn_out = hsv_to_rgb(rt_grn_hsv[0], rt_grn_hsv[1], rt_grn_hsv[2])
    ck_near("rt_grn_r", rt_grn_out[0], 0,   2)
    ck_near("rt_grn_g", rt_grn_out[1], 255, 2)
    ck_near("rt_grn_b", rt_grn_out[2], 0,   2)

    // Round-trip blue
    let rt_blu_in = [0, 0, 255]
    let rt_blu_hsv = hsv_from_rgb(rt_blu_in)
    let rt_blu_out = hsv_to_rgb(rt_blu_hsv[0], rt_blu_hsv[1], rt_blu_hsv[2])
    ck_near("rt_blu_r", rt_blu_out[0], 0,   2)
    ck_near("rt_blu_g", rt_blu_out[1], 0,   2)
    ck_near("rt_blu_b", rt_blu_out[2], 255, 2)

    print("_hsv_test passed")
