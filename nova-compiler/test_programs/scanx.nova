// scanx — reusable, configurable tokenizer for user code (closes the "no public
// Tokenizer/scanner library" gap). scan(src, ops) -> list of [kind, text] tokens.
// Built-in classes: ident (letter/_ then alnum/_), int, float (digits.digits),
// string ("..."); whitespace is skipped. Operators come from a caller-supplied
// list, matched longest-first (so "==" beats "="). Pure-NOVA, byte-indexed.

fn _is_alpha_b(b) -> int
    if b >= 65 and b <= 90
        return 1
    if b >= 97 and b <= 122
        return 1
    if b == 95
        return 1
    return 0

fn _is_digit_b(b) -> int
    if b >= 48 and b <= 57
        return 1
    return 0

fn _is_alnum_b(b) -> int
    if _is_alpha_b(b) == 1
        return 1
    return _is_digit_b(b)

fn scan(src, ops) -> list
    let toks = []
    let i = 0
    let n = len(src)
    while i < n
        let b = ord(src[i])
        if b == 32 or b == 9 or b == 10 or b == 13
            i = i + 1
        else if _is_alpha_b(b) == 1
            let start = i
            while i < n and _is_alnum_b(ord(src[i])) == 1
                i = i + 1
            push(toks, ["ident", slice(src, start, i)])
        else if _is_digit_b(b) == 1
            let start = i
            while i < n and _is_digit_b(ord(src[i])) == 1
                i = i + 1
            let kind = "int"
            if i < n and ord(src[i]) == 46
                if i + 1 < n and _is_digit_b(ord(src[i + 1])) == 1
                    kind = "float"
                    i = i + 1
                    while i < n and _is_digit_b(ord(src[i])) == 1
                        i = i + 1
            push(toks, [kind, slice(src, start, i)])
        else if b == 34
            let start = i
            i = i + 1
            while i < n and ord(src[i]) != 34
                i = i + 1
            if i < n
                i = i + 1
            push(toks, ["string", slice(src, start, i)])
        else
            let matched = ""
            let oi = 0
            while oi < len(ops)
                let op = ops[oi]
                let ol = len(op)
                if ol > len(matched) and i + ol <= n and slice(src, i, i + ol) == op
                    matched = op
                oi = oi + 1
            if len(matched) > 0
                push(toks, ["op", matched])
                i = i + len(matched)
            else
                push(toks, ["unknown", slice(src, i, i + 1)])
                i = i + 1
    return toks

fn main()
    let ops = ["+", "-", "*", "/", "==", "(", ")", "="]
    let t = scan("x = 12 + 3.5 * (y - 1)", ops)
    assert_eq(len(t), 11)
    assert_eq(t[0], ["ident", "x"])
    assert_eq(t[1], ["op", "="])
    assert_eq(t[2], ["int", "12"])
    assert_eq(t[3], ["op", "+"])
    assert_eq(t[4], ["float", "3.5"])
    assert_eq(t[5], ["op", "*"])
    assert_eq(t[6], ["op", "("])
    assert_eq(t[7], ["ident", "y"])
    assert_eq(t[8], ["op", "-"])
    assert_eq(t[9], ["int", "1"])
    assert_eq(t[10], ["op", ")"])

    // longest-match: "==" beats "="
    let t2 = scan("a == b", ops)
    assert_eq(t2[1], ["op", "=="])

    // string literal token
    let q = chr(34)
    let t3 = scan("say " + q + "hi" + q, ops)
    assert_eq(t3[0], ["ident", "say"])
    assert_eq(t3[1][0], "string")

    print("scanx passed")
