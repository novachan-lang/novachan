// KAT for std/units/volume.nova
import std/units/volume

fn approx(a: float, b: float, tol: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < tol

fn ckf(label: string, got: float, want: float, tol: float)
    if not approx(got, want, tol)
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    let tol = 0.0001

    // KAT 1: 1 m3 -> 1000 l
    let r1 = volume_convert(1.0, "m3", "l")
    ckf("m3_to_l", r1, 1000.0, tol)

    // KAT 2: 1 galus -> 3.785411784 l
    let r2 = volume_convert(1.0, "galus", "l")
    ckf("galus_to_l", r2, 3.785411784, 0.000001)

    // KAT 3: 1 l -> 1000 ml
    let r3 = volume_convert(1.0, "l", "ml")
    ckf("l_to_ml", r3, 1000.0, tol)

    // KAT 4: 1 galus -> 4 qtus
    let r4 = volume_convert(1.0, "galus", "qtus")
    ckf("galus_to_qtus", r4, 4.0, 0.001)

    // KAT 5: round-trip galus
    let base5 = volume_to_base(2.5, "galus")
    let rt5 = volume_from_base(base5, "galus")
    ckf("roundtrip_galus", rt5, 2.5, tol)

    // KAT 6: 1 l -> 1 l (identity)
    let r6 = volume_convert(1.0, "l", "l")
    ckf("l_identity", r6, 1.0, tol)

    // KAT 7: 1 ft3 -> 28.316846592 l
    let r7 = volume_convert(1.0, "ft3", "l")
    ckf("ft3_to_l", r7, 28.316846592, 0.00001)

    // KAT 8: 1000 ml -> 1 l
    let r8 = volume_convert(1000.0, "ml", "l")
    ckf("ml_to_l", r8, 1.0, tol)

    // KAT 9: volume_factor for l == 1.0
    let f1 = volume_factor("l")
    ckf("factor_l", f1, 1.0, tol)

    // KAT 10: volume_factor unknown -> 0.0
    let fu = volume_factor("xyz")
    ckf("factor_unknown", fu, 0.0, tol)

    // KAT 11: volume_is_supported
    let s1 = volume_is_supported("l")
    cki("supported_l", s1, 1)
    let s2 = volume_is_supported("galus")
    cki("supported_galus", s2, 1)
    let s3 = volume_is_supported("xyz")
    cki("unsupported_xyz", s3, 0)

    // KAT 12: volume_units returns 12 entries
    let us = volume_units()
    cki("units_len", len(us), 12)

    // KAT 13: 1 galus -> 8 ptus (US gallon = 8 US pints)
    let r13 = volume_convert(1.0, "galus", "ptus")
    ckf("galus_to_ptus", r13, 8.0, 0.001)

    // KAT 14: round-trip ft3
    let base14 = volume_to_base(7.3, "ft3")
    let rt14 = volume_from_base(base14, "ft3")
    ckf("roundtrip_ft3", rt14, 7.3, tol)

    // KAT 15: 1 galuk -> galus (should be ~1.20095)
    let r15 = volume_convert(1.0, "galuk", "galus")
    ckf("galuk_to_galus", r15, 1.20095, 0.0001)

    print("PASS _volume_test")
