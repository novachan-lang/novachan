// KAT test for std/text/langdetect
import std/text/langdetect

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + got + " expected=" + expected)
        exit(1)

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

fn ck_true(label, got)
    if not got
        print("FAIL " + label + ": expected true got false")
        exit(1)

fn ck_false(label, got)
    if got
        print("FAIL " + label + ": expected false got true")
        exit(1)

fn main()
    // KAT 1: detect English — 'the' and 'and' trigrams dominate
    let en_text = "the quick brown fox jumps over the lazy dog and the cat"
    let det1 = ld_detect(en_text)
    cks("detect_english", det1, "en")

    // KAT 2: detect Spanish — 'que' and 'los' trigrams dominate
    let es_text = "los gatos que estan en la casa que tienen hambre"
    let det2 = ld_detect(es_text)
    cks("detect_spanish", det2, "es")

    // KAT 3: ld_is_english on clear English text
    let is_en = ld_is_english("this is an english sentence with the and words")
    ck_true("is_english", is_en)

    // KAT 4: ld_is_english returns false for Spanish
    let is_en_es = ld_is_english("los gatos que estan en la casa que")
    ck_false("is_english_false", is_en_es)

    // KAT 5: ld_supported contains all four codes
    let sup = ld_supported()
    let has_en = 0
    let has_es = 0
    let has_fr = 0
    let has_de = 0
    let si = 0
    while si < len(sup)
        if sup[si] == "en"
            has_en = 1
        if sup[si] == "es"
            has_es = 1
        if sup[si] == "fr"
            has_fr = 1
        if sup[si] == "de"
            has_de = 1
        si = si + 1
    cki("supported_en", has_en, 1)
    cki("supported_es", has_es, 1)
    cki("supported_fr", has_fr, 1)
    cki("supported_de", has_de, 1)

    // KAT 6: ld_trigram_count is deterministic for "abcde" -> 3 trigrams
    let tc = ld_trigram_count("abcde")
    cki("trigram_count_abcde", tc, 3)

    // KAT 7: ld_trigram_count of single 3-letter word
    let tc2 = ld_trigram_count("the")
    cki("trigram_count_the", tc2, 1)

    // KAT 8: ld_score for English text vs 'en' is higher than vs 'de'
    let sc_en = ld_score(en_text, "en")
    let sc_de = ld_score(en_text, "de")
    if sc_en <= sc_de
        print("FAIL en_score_vs_de: en=" + str(sc_en) + " de=" + str(sc_de))
        exit(1)

    // KAT 9: ld_detect_top returns k entries
    let top2 = ld_detect_top(en_text, 2)
    cki("detect_top_len", len(top2), 2)
    // first should be 'en'
    let top_pair = top2[0]
    cks("detect_top_first", top_pair[0], "en")

    // KAT 10: ld_confidence in (0, 1] for non-trivial text
    let conf = ld_confidence(en_text)
    if conf <= 0.0
        print("FAIL confidence_positive: got=" + str(conf))
        exit(1)
    if conf > 1.0
        print("FAIL confidence_le_one: got=" + str(conf))
        exit(1)

    // KAT 11: ld_char_trigrams of "hello" -> ["hel","ell","llo"]
    let tris = ld_char_trigrams("hello")
    cki("trigrams_hello_len", len(tris), 3)
    cks("trigrams_hello_0", tris[0], "hel")
    cks("trigrams_hello_1", tris[1], "ell")
    cks("trigrams_hello_2", tris[2], "llo")

    // KAT 12: ld_profile returns non-empty dict for non-empty text
    let prof = ld_profile("the quick the")
    if not contains(prof, "the")
        print("FAIL profile_has_the: missing key 'the'")
        exit(1)

    // KAT 13: detect German - characteristic german trigrams
    let de_text = "der einheitliche und schnelle Unterricht durch Deutschland"
    let det13 = ld_detect(de_text)
    cks("detect_german", det13, "de")

    print("PASS _langdetect_test")
