// KAT for std/geometry/vector3 — 3D integer-coord vector ops.
import std/geometry/vector3

fn _v3eq(label: string, got: any, ex0: int, ex1: int, ex2: int)
    let g0 = got[0]
    let g1 = got[1]
    let g2 = got[2]
    if g0 != ex0
        print("FAIL " + label + "[0]: expected " + str(ex0) + " got " + str(g0))
        exit(1)
    if g1 != ex1
        print("FAIL " + label + "[1]: expected " + str(ex1) + " got " + str(g1))
        exit(1)
    if g2 != ex2
        print("FAIL " + label + "[2]: expected " + str(ex2) + " got " + str(g2))
        exit(1)

fn main()
    // KAT 1: v3_add([1,2,3],[4,5,6]) == [5,7,9]
    _v3eq("v3_add", v3_add([1, 2, 3], [4, 5, 6]), 5, 7, 9)

    // KAT 2: v3_sub([4,5,6],[1,2,3]) == [3,3,3]
    _v3eq("v3_sub", v3_sub([4, 5, 6], [1, 2, 3]), 3, 3, 3)

    // KAT 3: v3_scale([1,2,3],2) == [2,4,6]
    _v3eq("v3_scale", v3_scale([1, 2, 3], 2), 2, 4, 6)

    // KAT 4: v3_dot([1,2,3],[4,5,6]) == 32
    let d = v3_dot([1, 2, 3], [4, 5, 6])
    if d != 32
        print("FAIL v3_dot: expected 32 got " + str(d))
        exit(1)

    // KAT 5: v3_cross([1,0,0],[0,1,0]) == [0,0,1]
    _v3eq("v3_cross_unit", v3_cross([1, 0, 0], [0, 1, 0]), 0, 0, 1)

    // KAT 6: v3_cross([2,0,0],[0,3,0]) == [0,0,6]
    _v3eq("v3_cross_scaled", v3_cross([2, 0, 0], [0, 3, 0]), 0, 0, 6)

    // KAT 7: v3_length_sq([2,3,6]) == 49
    let lsq = v3_length_sq([2, 3, 6])
    if lsq != 49
        print("FAIL v3_length_sq: expected 49 got " + str(lsq))
        exit(1)

    // KAT 8: v3_length([2,3,6]) == 7.0 (within eps 0.001)
    let ln = v3_length([2, 3, 6])
    if ln < 6.999
        print("FAIL v3_length low: expected ~7.0 got " + str(ln))
        exit(1)
    if ln > 7.001
        print("FAIL v3_length high: expected ~7.0 got " + str(ln))
        exit(1)

    print("_vector3_test passed")
