// ══════════════════════════════════════════════════════════════════════════════
// qb — a composable SQL query builder for NOVA (web/data spine, ORM foundation)
//
// Builds SELECT/INSERT/UPDATE/DELETE as a parameterized statement: every VALUE
// becomes a `?` placeholder with its value collected into a params list, so the
// result feeds straight into sqlitex's db_query(db, sql, params) / db_exec and is
// injection-safe BY CONSTRUCTION (a value can never become SQL syntax). Identifiers
// (table/column names) are caller-supplied and trusted, as in every query builder.
//
//   q = qb_select("users", ["id", "name"])
//   q = qb_where(q, "age", ">=", 18)
//   q = qb_order(q, "name", "ASC")
//   q = qb_limit(q, 10)
//   r = qb_build(q)   // r["sql"] = "SELECT id, name FROM users WHERE age >= ? ..."
//                     // r["params"] = [18]
//
// A SELECT query is a mutable dict accumulating clauses; INSERT/UPDATE/DELETE are
// one-shot constructors. qb_build always returns { "sql": string, "params": list }.
// ══════════════════════════════════════════════════════════════════════════════

fn qb_select(table: string, cols: list) -> dict
    {"kind": "select", "table": table, "cols": cols, "wheres": [], "params": [], "orders": [], "limit": -1, "joins": []}

fn qb_where(q: dict, col: string, op: string, val) -> dict
    let w = q["wheres"]
    push(w, col + " " + op + " ?")
    q["wheres"] = w
    let p = q["params"]
    push(p, val)
    q["params"] = p
    q

fn qb_order(q: dict, col: string, dir: string) -> dict
    let o = q["orders"]
    push(o, col + " " + dir)
    q["orders"] = o
    q

fn qb_limit(q: dict, n: int) -> dict
    q["limit"] = n
    q

fn qb_join(q: dict, table: string, on: string) -> dict
    let j = q["joins"]
    push(j, table + " ON " + on)
    q["joins"] = j
    q

fn qb_build(q: dict) -> dict
    let kind = q["kind"]
    if kind != "select"
        return {"sql": "", "params": []}
    let cols = q["cols"]
    let colstr = "*"
    if len(cols) > 0
        colstr = join(cols, ", ")
    let sql = "SELECT " + colstr + " FROM " + q["table"]
    for j in q["joins"]
        sql = sql + " JOIN " + j
    let wheres = q["wheres"]
    if len(wheres) > 0
        sql = sql + " WHERE " + join(wheres, " AND ")
    let orders = q["orders"]
    if len(orders) > 0
        sql = sql + " ORDER BY " + join(orders, ", ")
    if q["limit"] >= 0
        sql = sql + " LIMIT " + str(q["limit"])
    {"sql": sql, "params": q["params"]}

// INSERT INTO t (c1, c2) VALUES (?, ?). Columns sorted for deterministic output;
// params follow the same order.
fn qb_insert(table: string, values: dict) -> dict
    let cols = sort(keys(values))
    let placeholders = []
    let params = []
    for c in cols
        push(placeholders, "?")
        push(params, values[c])
    let sql = "INSERT INTO " + table + " (" + join(cols, ", ") + ") VALUES (" + join(placeholders, ", ") + ")"
    {"sql": sql, "params": params}

// UPDATE t SET c1 = ?, ... [WHERE col op ?]. Pass where_col == "" for no WHERE.
fn qb_update(table: string, values: dict, where_col: string, where_op: string, where_val) -> dict
    let cols = sort(keys(values))
    let sets = []
    let params = []
    for c in cols
        push(sets, c + " = ?")
        push(params, values[c])
    let sql = "UPDATE " + table + " SET " + join(sets, ", ")
    if where_col != ""
        sql = sql + " WHERE " + where_col + " " + where_op + " ?"
        push(params, where_val)
    {"sql": sql, "params": params}

// DELETE FROM t [WHERE col op ?]. Pass where_col == "" to delete all (explicit).
fn qb_delete(table: string, where_col: string, where_op: string, where_val) -> dict
    let sql = "DELETE FROM " + table
    let params = []
    if where_col != ""
        sql = sql + " WHERE " + where_col + " " + where_op + " ?"
        push(params, where_val)
    {"sql": sql, "params": params}

fn main()
    let q = qb_select("users", ["id", "name"])
    q = qb_where(q, "age", ">=", 18)
    let r = qb_build(q)
    assert(r["sql"] == "SELECT id, name FROM users WHERE age >= ?", "select sql")
    assert(len(r["params"]) == 1, "params count")
    print("qb: passed")
