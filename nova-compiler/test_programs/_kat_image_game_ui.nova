// KAT for std/image/histogram, std/image/resize, std/game/pathfind,
// std/game/tilemap, std/ui/layout, std/ui/color.
import std/image/histogram
import std/image/resize
import std/game/pathfind
import std/game/tilemap
import std/ui/layout
import std/ui/color

fn _kat_int_list_eq(a: list, b: list) -> bool
    let na = len(a)
    let nb = len(b)
    let result = true
    if na != nb
        result = false
    if result
        let i = 0
        while i < na
            if a[i] != b[i]
                result = false
            i = i + 1
    result

fn _kat_fabs(x: float) -> float
    let r = x
    if x < 0.0
        r = 0.0 - x
    r

fn test_histogram()
    let pixels = [0, 0, 0, 255, 255, 255]
    let hist = ih_from_pixels(pixels, 2, 1)

    let rch = ih_channel(hist, "r")
    if rch[0] != 1
        print("FAIL histogram r[0]: got " + str(rch[0]) + " want 1")
        exit(1)
    if rch[255] != 1
        print("FAIL histogram r[255]: got " + str(rch[255]) + " want 1")
        exit(1)
    let rlen = len(rch)
    if rlen != 256
        print("FAIL histogram r channel length: got " + str(rlen) + " want 256")
        exit(1)

    let gray = ih_channel(hist, "gray")
    if gray[0] != 1
        print("FAIL histogram gray[0]: got " + str(gray[0]) + " want 1")
        exit(1)
    if gray[255] != 1
        print("FAIL histogram gray[255]: got " + str(gray[255]) + " want 1")
        exit(1)

    let unknown = ih_channel(hist, "nope")
    let uk_sum = 0
    let ui = 0
    while ui < 256
        uk_sum = uk_sum + unknown[ui]
        ui = ui + 1
    if uk_sum != 0
        print("FAIL histogram unknown channel not all-zero: sum=" + str(uk_sum))
        exit(1)

    let mean_gray = ih_mean(hist, "gray")
    if mean_gray != 127
        print("FAIL histogram ih_mean gray: got " + str(mean_gray) + " want 127")
        exit(1)

    let lut = ih_equalize(hist)
    if lut[0] != 0
        print("FAIL histogram equalize lut[0]: got " + str(lut[0]) + " want 0")
        exit(1)
    if lut[255] != 255
        print("FAIL histogram equalize lut[255]: got " + str(lut[255]) + " want 255")
        exit(1)

    // Uniform image: equalize is the identity LUT.
    let upix = [128, 128, 128, 128, 128, 128]
    let uhist = ih_from_pixels(upix, 2, 1)
    let ulut = ih_equalize(uhist)
    if ulut[128] != 128
        print("FAIL histogram uniform equalize lut[128]: got " + str(ulut[128]) + " want 128")
        exit(1)

    // Undersized pixel list (not a whole number of RGB triples, and fewer
    // triples than width*height): must not read out of bounds, must not crash.
    let short_pixels = [1, 2, 3, 4, 5]
    let short_hist = ih_from_pixels(short_pixels, 4, 4)
    let short_count = short_hist["count"]
    if short_count != 1
        print("FAIL histogram undersized pixel list count: got " + str(short_count) + " want 1")
        exit(1)

    print("histogram: OK")

fn test_resize()
    let px = [10, 20, 30, 40]

    // Identity resize must reproduce the source exactly.
    let same = ir_resize_nn(px, 2, 2, 2, 2)
    let same_ok = _kat_int_list_eq(same, px)
    if not same_ok
        print("FAIL resize identity mismatch")
        exit(1)

    // Upscale: out[row3][col3] (idx 15 in a 4x4) must sample src (1,1) = 40.
    let up = ir_resize_nn(px, 2, 2, 4, 4)
    let up_len = len(up)
    if up_len != 16
        print("FAIL resize upscale length: got " + str(up_len) + " want 16")
        exit(1)
    if up[15] != 40
        print("FAIL resize upscale[15]: got " + str(up[15]) + " want 40")
        exit(1)

    // Crop.
    let c1 = ir_crop(px, 2, 2, 1, 1, 1, 1)
    let c1_ok = _kat_int_list_eq(c1, [40])
    if not c1_ok
        print("FAIL crop 1x1: got len=" + str(len(c1)))
        exit(1)
    let c2 = ir_crop(px, 2, 2, 1, 1, 2, 2)
    let c2_ok = _kat_int_list_eq(c2, [40, 0, 0, 0])
    if not c2_ok
        print("FAIL crop out-of-bounds padding")
        exit(1)

    // Flips.
    let fh = ir_flip_h(px, 2, 2)
    let fh_ok = _kat_int_list_eq(fh, [20, 10, 40, 30])
    if not fh_ok
        print("FAIL flip_h")
        exit(1)
    let fv = ir_flip_v(px, 2, 2)
    let fv_ok = _kat_int_list_eq(fv, [30, 40, 10, 20])
    if not fv_ok
        print("FAIL flip_v")
        exit(1)

    // Degenerate: dst_w == 0 must not divide by zero — must return [].
    let zero_w = ir_resize_nn(px, 2, 2, 0, 4)
    let zero_w_len = len(zero_w)
    if zero_w_len != 0
        print("FAIL resize dst_w=0: got len=" + str(zero_w_len) + " want 0")
        exit(1)

    print("resize: OK")

fn test_pathfind()
    let h0 = pf_heuristic(0, 0, 2, 2)
    if h0 != 4
        print("FAIL pf_heuristic: got " + str(h0) + " want 4")
        exit(1)

    let grid = [[0, 0, 0], [0, 1, 0], [0, 0, 0]]
    let nbrs = pf_neighbors(grid, 0, 0)
    let nn = len(nbrs)
    if nn != 2
        print("FAIL pf_neighbors count: got " + str(nn) + " want 2")
        exit(1)

    let path = pf_find(grid, 0, 0, 2, 2)
    let plen = len(path)
    if plen != 5
        print("FAIL pf_find path length: got " + str(plen) + " want 5")
        exit(1)
    let first = path[0]
    if first[0] != 0 or first[1] != 0
        print("FAIL pf_find path start")
        exit(1)
    let last = path[plen - 1]
    if last[0] != 2 or last[1] != 2
        print("FAIL pf_find path end")
        exit(1)
    // Every step must land on a walkable, in-bounds cell (never the wall).
    let wall_hit = false
    let wi = 0
    while wi < plen
        let step = path[wi]
        let sx = step[0]
        let sy = step[1]
        if sx == 1 and sy == 1
            wall_hit = true
        wi = wi + 1
    if wall_hit
        print("FAIL pf_find path crosses the wall at (1,1)")
        exit(1)

    // Unreachable: end cell itself is a wall.
    let grid2 = [[0, 1], [0, 0]]
    let path2 = pf_find(grid2, 0, 0, 1, 0)
    let p2len = len(path2)
    if p2len != 0
        print("FAIL pf_find unreachable: got len=" + str(p2len) + " want 0")
        exit(1)

    // start == end: trivial one-cell path.
    let trivial = pf_find(grid, 0, 0, 0, 0)
    let trivial_len = len(trivial)
    if trivial_len != 1
        print("FAIL pf_find start==end length: got " + str(trivial_len) + " want 1")
        exit(1)

    print("pathfind: OK")

fn test_tilemap()
    let map = tm_new(3, 2, 16)
    tm_set(map, 1, 0, 5)
    let v1 = tm_get(map, 1, 0)
    if v1 != 5
        print("FAIL tm_get after tm_set: got " + str(v1) + " want 5")
        exit(1)
    let voob = tm_get(map, 5, 5)
    if voob != -1
        print("FAIL tm_get OOB: got " + str(voob) + " want -1")
        exit(1)
    let vunset = tm_get(map, 0, 0)
    if vunset != 0
        print("FAIL tm_get default tile: got " + str(vunset) + " want 0")
        exit(1)

    tm_fill(map, 7)
    let vf = tm_get(map, 2, 1)
    if vf != 7
        print("FAIL tm_fill: got " + str(vf) + " want 7")
        exit(1)

    let map2 = tm_new(4, 4, 16)
    tm_set(map2, 1, 1, 9)
    tm_set(map2, 2, 1, 8)
    let region = tm_region(map2, 1, 1, 2, 1)
    let r0 = tm_get(region, 0, 0)
    let r1 = tm_get(region, 1, 0)
    if r0 != 9
        print("FAIL tm_region[0]: got " + str(r0) + " want 9")
        exit(1)
    if r1 != 8
        print("FAIL tm_region[1]: got " + str(r1) + " want 8")
        exit(1)

    // Region straddling the edge: out-of-parent cells fill with 0.
    let edge = tm_region(map2, 3, 3, 2, 2)
    let e00 = tm_get(edge, 0, 0)
    let e11 = tm_get(edge, 1, 1)
    if e00 != 0
        print("FAIL tm_region edge[0,0]: got " + str(e00) + " want 0")
        exit(1)
    if e11 != 0
        print("FAIL tm_region edge[1,1]: got " + str(e11) + " want 0")
        exit(1)

    // Degenerate zero-width region: must not crash, must be empty.
    let zero_region = tm_region(map2, 0, 0, 0, 3)
    let zr_get = tm_get(zero_region, 0, 0)
    if zr_get != -1
        print("FAIL tm_region zero-width: got " + str(zr_get) + " want -1 (empty)")
        exit(1)

    print("tilemap: OK")

fn test_layout()
    let box = ly_box(0, 0, 100, 50)
    let padded = ly_padding(box, 10, 5, 10, 5)
    let content = ly_content_rect(padded)
    if content[0] != 5 or content[1] != 10 or content[2] != 90 or content[3] != 30
        print("FAIL ly_content_rect: got [" + str(content[0]) + "," + str(content[1]) + "," + str(content[2]) + "," + str(content[3]) + "]")
        exit(1)

    let margined = ly_margin(box, 4, 4, 4, 4)
    if margined["mt"] != 4 or margined["ml"] != 4
        print("FAIL ly_margin fields")
        exit(1)
    // ly_margin must not mutate the source box.
    if box["mt"] != 0
        print("FAIL ly_margin mutated source box")
        exit(1)

    let boxes = [ly_box(0, 0, 50, 20), ly_box(0, 0, 30, 20)]
    let stacked = ly_hstack(boxes, 10)
    let sb0 = stacked[0]
    let sb1 = stacked[1]
    if sb0["x"] != 0
        print("FAIL ly_hstack[0].x: got " + str(sb0["x"]) + " want 0")
        exit(1)
    if sb1["x"] != 60
        print("FAIL ly_hstack[1].x: got " + str(sb1["x"]) + " want 60")
        exit(1)

    let vboxes = [ly_box(0, 0, 50, 20), ly_box(0, 0, 30, 25)]
    let vstacked = ly_vstack(vboxes, 5)
    let vb0 = vstacked[0]
    let vb1 = vstacked[1]
    if vb0["y"] != 0
        print("FAIL ly_vstack[0].y: got " + str(vb0["y"]) + " want 0")
        exit(1)
    if vb1["y"] != 25
        print("FAIL ly_vstack[1].y: got " + str(vb1["y"]) + " want 25")
        exit(1)

    print("layout: OK")

fn test_color()
    let c1 = uc_rgb(300, 0 - 10, 128)
    if c1["r"] != 255 or c1["g"] != 0 or c1["b"] != 128
        print("FAIL uc_rgb clamp")
        exit(1)

    let c2 = uc_hex("#ff8000")
    if c2["r"] != 255 or c2["g"] != 128 or c2["b"] != 0
        print("FAIL uc_hex 6-digit")
        exit(1)
    let hx = uc_to_hex(c2)
    if hx != "#ff8000"
        print("FAIL uc_to_hex: got " + hx)
        exit(1)

    let c3 = uc_hex("f00")
    if c3["r"] != 255 or c3["g"] != 0 or c3["b"] != 0
        print("FAIL uc_hex 3-digit shorthand")
        exit(1)

    let c4 = uc_hex("not-a-color")
    if c4["r"] != 0 or c4["g"] != 0 or c4["b"] != 0
        print("FAIL uc_hex malformed input should default to black")
        exit(1)

    let black = uc_rgb(0, 0, 0)
    let white = uc_rgb(255, 255, 255)
    let mid = uc_blend(black, white, 0.5)
    if mid["r"] != 128 or mid["g"] != 128 or mid["b"] != 128
        print("FAIL uc_blend midpoint: got " + str(mid["r"]))
        exit(1)

    let bw = uc_brightness(white)
    if bw != 255
        print("FAIL uc_brightness white: got " + str(bw) + " want 255")
        exit(1)
    let bb = uc_brightness(black)
    if bb != 0
        print("FAIL uc_brightness black: got " + str(bb) + " want 0")
        exit(1)

    let ratio_bw = uc_contrast_ratio(black, white)
    let diff = _kat_fabs(ratio_bw - 21.0)
    if diff > 0.01
        print("FAIL uc_contrast_ratio black/white: got " + str(ratio_bw) + " want ~21.0")
        exit(1)

    let gray = uc_rgb(100, 100, 100)
    let ratio_same = uc_contrast_ratio(gray, gray)
    if ratio_same != 1.0
        print("FAIL uc_contrast_ratio identical colors: got " + str(ratio_same) + " want 1.0")
        exit(1)

    print("color: OK")

fn main()
    test_histogram()
    test_resize()
    test_pathfind()
    test_tilemap()
    test_layout()
    test_color()
    print("PASS _kat_image_game_ui")
