import std/graph/maxflow

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // =========================================================================
    // KAT 1: Classic 6-node flow network.
    // S->[[A,10],[B,10]], A->[[B,2],[C,4],[D,8]], B->[[D,9]],
    // C->[[T,10]], D->[[C,6],[T,10]]
    //
    // Hand-computed max flow S->T:
    //   Path S->A->C->T      bottleneck min(10,4,10)=4    total=4
    //   Path S->A->D->T      bottleneck min(6,8,10)=6     total=10
    //   Path S->B->D->T      bottleneck min(10,9,4)=4     total=14
    //   Path S->B->D->C->T   bottleneck min(6,5,6,6)=5    total=19
    //   No more augmenting paths -> MAX FLOW = 19
    // =========================================================================
    let g = {}
    g["S"] = [["A", 10], ["B", 10]]
    g["A"] = [["B", 2], ["C", 4], ["D", 8]]
    g["B"] = [["D", 9]]
    g["C"] = [["T", 10]]
    g["D"] = [["C", 6], ["T", 10]]
    g["T"] = []
    let nodes = ["S", "A", "B", "C", "D", "T"]

    cki("classic_S_T", maxflow.mf_max_flow(g, nodes, "S", "T"), 19)

    // =========================================================================
    // KAT 2: Single direct edge S->T capacity 5.
    // Max flow = 5 (limited by the single edge).
    // =========================================================================
    let g2 = {}
    g2["S"] = [["T", 5]]
    g2["T"] = []
    let nodes2 = ["S", "T"]

    cki("single_edge", maxflow.mf_max_flow(g2, nodes2, "S", "T"), 5)

    // =========================================================================
    // KAT 3: Disconnected source/sink — no path at all.
    // S has no outgoing edges; T has no incoming edges from S's component.
    // Max flow = 0.
    // =========================================================================
    let g3 = {}
    g3["S"] = []
    g3["T"] = []
    g3["X"] = [["Y", 10]]
    g3["Y"] = []
    let nodes3 = ["S", "T", "X", "Y"]

    cki("disconnected", maxflow.mf_max_flow(g3, nodes3, "S", "T"), 0)

    // =========================================================================
    // KAT 4: Two parallel independent paths.
    // S->[[A,3]], A->[[T,3]], S->[[B,2]], B->[[T,2]]
    // Path 1: S->A->T, bottleneck=3
    // Path 2: S->B->T, bottleneck=2
    // Max flow = 5.
    // =========================================================================
    let g4 = {}
    g4["S"] = [["A", 3], ["B", 2]]
    g4["A"] = [["T", 3]]
    g4["B"] = [["T", 2]]
    g4["T"] = []
    let nodes4 = ["S", "A", "B", "T"]

    cki("two_parallel_paths", maxflow.mf_max_flow(g4, nodes4, "S", "T"), 5)

    // =========================================================================
    // KAT 5: Source == sink edge case -> must return 0, not loop forever.
    // =========================================================================
    let g5 = {}
    g5["A"] = [["B", 7]]
    g5["B"] = []
    let nodes5 = ["A", "B"]

    cki("source_eq_sink", maxflow.mf_max_flow(g5, nodes5, "A", "A"), 0)

    // =========================================================================
    // KAT 6: Diamond graph — two paths, interior bottleneck.
    // S->[[A,10],[B,10]], A->[[C,5]], B->[[C,5]], C->[[T,7]]
    // Both paths converge at C->T which has capacity 7.
    // Max flow = min(10+10, 5+5, 7) = 7 (limited by C->T).
    // =========================================================================
    let g6 = {}
    g6["S"] = [["A", 10], ["B", 10]]
    g6["A"] = [["C", 5]]
    g6["B"] = [["C", 5]]
    g6["C"] = [["T", 7]]
    g6["T"] = []
    let nodes6 = ["S", "A", "B", "C", "T"]

    cki("diamond_bottleneck", maxflow.mf_max_flow(g6, nodes6, "S", "T"), 7)

    // =========================================================================
    // KAT 7: Reverse-flow (back-edge) needed for optimality.
    // S->[[A,10]], S->[[B,10]], A->[[B,1]], A->[[T,10]], B->[[T,10]]
    // Without back-edge usage, one might route S->A->T(10) + S->B->T(10) = 20.
    // That IS achievable here since S->A=10, A->T=10, S->B=10, B->T=10.
    // Max flow = 20.
    // =========================================================================
    let g7 = {}
    g7["S"] = [["A", 10], ["B", 10]]
    g7["A"] = [["B", 1], ["T", 10]]
    g7["B"] = [["T", 10]]
    g7["T"] = []
    let nodes7 = ["S", "A", "B", "T"]

    cki("back_edge_graph", maxflow.mf_max_flow(g7, nodes7, "S", "T"), 20)

    // =========================================================================
    // KAT 8: Chain — capacity limited by narrowest link.
    // S->[[A,100]], A->[[B,1]], B->[[T,100]]
    // Bottleneck = A->B = 1. Max flow = 1.
    // =========================================================================
    let g8 = {}
    g8["S"] = [["A", 100]]
    g8["A"] = [["B", 1]]
    g8["B"] = [["T", 100]]
    g8["T"] = []
    let nodes8 = ["S", "A", "B", "T"]

    cki("chain_bottleneck", maxflow.mf_max_flow(g8, nodes8, "S", "T"), 1)

    print("_maxflow_test passed")

main()
