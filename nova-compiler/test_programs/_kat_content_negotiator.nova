import forge_content_negotiator

fn main()
    let c = cn_new()
    c = cn_add_type(c, "application/json", 10)
    c = cn_add_type(c, "text/html", 5)
    c = cn_add_type(c, "text/plain", 1)
    assert(cn_type_count(c) == 3, "3 types")

    let r1 = cn_negotiate(c, "application/json")
    assert(is_ok(r1), "json ok")
    assert(unwrap(r1) == "application/json", "json match")

    let r2 = cn_negotiate(c, "image/png")
    assert(is_err(r2), "no png")

    assert(cn_negotiation_count(c) == 2, "2 negotiations")

    let best = cn_best(c)
    assert(is_ok(best), "best ok")
    assert(unwrap(best) == "application/json", "json is best")

    print("CONTENT-NEGOTIATOR KAT PASS")
