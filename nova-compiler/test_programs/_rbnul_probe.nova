// Is random_bytes()'s C-string representation losing bytes at an embedded NUL?
// Predicted: hex length 64 unless a 0x00 lands in the buffer; empty iff byte[0]==0.
// byte[0]==0 has p=1/256, so ~20 empties in 5000 draws confirms the mechanism.
fn main()
    let mut empties = 0
    let mut shorts = 0
    let mut full = 0
    let mut i = 0
    while i < 5000
        let tok = hex_encode(random_bytes(32))
        let L = len(tok)
        if L == 0
            empties = empties + 1
        else if L < 64
            shorts = shorts + 1
        else
            full = full + 1
        i = i + 1
    print("full=" + str(full) + " short=" + str(shorts) + " empty=" + str(empties))
    print("expected empty ~= 5000/256 = 19.5 if the NUL-truncation theory holds")
