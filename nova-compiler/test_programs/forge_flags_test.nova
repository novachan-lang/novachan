// functional: feature flags enable/disable/value/on
import forge_flags

fn main()
    let f = flags_new()
    if flag_on(f, "beta") != false
        print("FAIL unset")
        exit(1)
    flag_enable(f, "beta")
    if flag_on(f, "beta") != true
        print("FAIL enabled")
        exit(1)
    flag_disable(f, "beta")
    if flag_on(f, "beta") != false
        print("FAIL disabled")
        exit(1)
    flag_set(f, "variant", "green")
    if flag_value(f, "variant") != "green"
        print("FAIL variant")
        exit(1)
    print("PASS forge_flags")
