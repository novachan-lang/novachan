// NOVA ENCODING — URL, HTML, and CSV encoding/decoding utilities.
// Base64 and hex encoding live in edge.nova; this module covers
// text-protocol encodings used by web, data-interchange, and config layers.
//
// Public API:
//   url_encode(s)           -> string  (percent-encode special chars)
//   url_decode(s)           -> string  (reverse percent-encoding)
//   query_string(params)    -> string  (dict to "k1=v1&k2=v2")
//   query_parse(qs)         -> dict    (reverse of query_string)
//   html_escape(s)          -> string  (escape &<>"' for HTML)
//   html_unescape(s)        -> string  (reverse)
//   csv_encode_row(fields)  -> string  (list of strings to CSV row)
//   csv_decode_row(line)    -> list    (CSV row to list of strings)

// ── internal helpers ─────────────────────────────────────────────────────

fn _nibble_to_hex(n: int) -> string
    if n == 0
        return "0"
    if n == 1
        return "1"
    if n == 2
        return "2"
    if n == 3
        return "3"
    if n == 4
        return "4"
    if n == 5
        return "5"
    if n == 6
        return "6"
    if n == 7
        return "7"
    if n == 8
        return "8"
    if n == 9
        return "9"
    if n == 10
        return "A"
    if n == 11
        return "B"
    if n == 12
        return "C"
    if n == 13
        return "D"
    if n == 14
        return "E"
    "F"

fn _byte_to_hex(b: int) -> string
    _nibble_to_hex((b >> 4) & 15) + _nibble_to_hex(b & 15)

fn _hex_digit_val(c: string) -> int
    let v = ord(c)
    if v >= 48 and v <= 57
        return v - 48
    if v >= 65 and v <= 70
        return v - 55
    if v >= 97 and v <= 102
        return v - 87
    0

fn _is_unreserved(c: string) -> bool
    let v = ord(c)
    // A-Z
    if v >= 65 and v <= 90
        return true
    // a-z
    if v >= 97 and v <= 122
        return true
    // 0-9
    if v >= 48 and v <= 57
        return true
    // - _ . ~
    if c == "-" or c == "_" or c == "." or c == "~"
        return true
    false

// ── URL encoding ─────────────────────────────────────────────────────────

fn url_encode(s: string) -> string
    let out = ""
    let i = 0
    while i < len(s)
        let c = s[i]
        if _is_unreserved(c)
            out = out + c
        else
            let v = ord(c)
            out = out + "%" + _byte_to_hex(v)
        i = i + 1
    out

fn url_decode(s: string) -> string
    let out = ""
    let i = 0
    let n = len(s)
    while i < n
        let c = s[i]
        if c == "%"
            if i + 2 < n
                let hi = _hex_digit_val(s[i + 1])
                let lo = _hex_digit_val(s[i + 2])
                out = out + chr((hi << 4) | lo)
                i = i + 3
            else
                out = out + c
                i = i + 1
        else if c == "+"
            out = out + " "
            i = i + 1
        else
            out = out + c
            i = i + 1
    out

// ── query string ─────────────────────────────────────────────────────────

fn query_string(params: dict) -> string
    let out = ""
    let first = true
    for k in keys(params)
        if not first
            out = out + "&"
        out = out + url_encode(k) + "=" + url_encode(str(params[k]))
        first = false
    out

fn query_parse(qs: string) -> dict
    let result = {}
    if len(qs) == 0
        return result
    let pairs = split(qs, "&")
    let i = 0
    while i < len(pairs)
        let pair = pairs[i]
        let eq_pos = find(pair, "=")
        if eq_pos >= 0
            let k = url_decode(slice(pair, 0, eq_pos))
            let v = url_decode(slice(pair, eq_pos + 1, len(pair)))
            result[k] = v
        else
            result[url_decode(pair)] = ""
        i = i + 1
    result

// ── HTML escaping ────────────────────────────────────────────────────────

fn html_escape(s: string) -> string
    let out = ""
    let i = 0
    while i < len(s)
        let c = s[i]
        if c == "&"
            out = out + "&amp;"
        else if c == "<"
            out = out + "&lt;"
        else if c == ">"
            out = out + "&gt;"
        else if c == "\""
            out = out + "&quot;"
        else if c == "'"
            out = out + "&#39;"
        else
            out = out + c
        i = i + 1
    out

fn html_unescape(s: string) -> string
    let out = s
    out = replace(out, "&amp;", "&")
    out = replace(out, "&lt;", "<")
    out = replace(out, "&gt;", ">")
    out = replace(out, "&quot;", "\"")
    out = replace(out, "&#39;", "'")
    out

// ── CSV encoding ─────────────────────────────────────────────────────────

fn _csv_needs_quote(field: string) -> bool
    let i = 0
    while i < len(field)
        let c = field[i]
        if c == "," or c == "\"" or c == "\n" or c == "\r"
            return true
        i = i + 1
    false

fn _csv_quote_field(field: string) -> string
    let out = "\""
    let i = 0
    while i < len(field)
        let c = field[i]
        if c == "\""
            out = out + "\"\""
        else
            out = out + c
        i = i + 1
    out = out + "\""
    out

fn csv_encode_row(fields: list) -> string
    let out = ""
    let i = 0
    while i < len(fields)
        if i > 0
            out = out + ","
        let f = str(fields[i])
        if _csv_needs_quote(f)
            out = out + _csv_quote_field(f)
        else
            out = out + f
        i = i + 1
    out

fn csv_decode_row(line: string) -> list
    let fields = []
    let i = 0
    let n = len(line)
    while i < n
        if line[i] == "\""
            // quoted field
            i = i + 1
            let field = ""
            while i < n
                if line[i] == "\""
                    if i + 1 < n and line[i + 1] == "\""
                        // escaped quote
                        field = field + "\""
                        i = i + 2
                    else
                        // end of quoted field
                        i = i + 1
                        break
                else
                    field = field + line[i]
                    i = i + 1
            fields.push(field)
            // skip comma after closing quote
            if i < n and line[i] == ","
                i = i + 1
        else
            // unquoted field — scan to next comma or end
            let start = i
            while i < n and line[i] != ","
                i = i + 1
            fields.push(slice(line, start, i))
            if i < n
                i = i + 1
    fields
