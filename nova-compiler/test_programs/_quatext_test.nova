// KAT for std/control/quatext — quaternion orientation extensions.
import std/control/quatext

fn _fabs(x: float) -> float
    let r = x
    if r < 0.0
        r = 0.0 - r
    r

fn approx(a: float, b: float) -> bool
    let d = _fabs(a - b)
    return d < 0.0001

fn ckf(label: string, got: float, want: float)
    if not approx(got, want)
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckq(label: string, got: any, want: any)
    if len(got) != len(want)
        print("FAIL " + label + ": len " + str(len(got)) + " != " + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        let gv = got[i] * 1.0
        let wv = want[i] * 1.0
        if not approx(gv, wv)
            print("FAIL " + label + "[" + str(i) + "]: got=" + str(gv) + " want=" + str(wv))
            exit(1)
        i = i + 1

fn main()
    // KAT 1: qe_slerp(q,q,0.5) ~ q for q=from_axis_angle(0,0,1,0.5)
    let q = qe_from_axis_angle(0.0, 0.0, 1.0, 0.5)
    let qs = qe_slerp(q, q, 0.5)
    ckq("slerp_self_0.5", qs, q)

    // KAT 2: qe_dot(identity, identity) == 1.0
    let qi = qe_identity()
    let dot_ii = qe_dot(qi, qi)
    ckf("dot_identity_identity", dot_ii, 1.0)

    // KAT 3: qe_norm([0,3,0,4]) ~ [0,0.6,0,0.8] (magnitude 5)
    let q5 = []
    push(q5, 0.0)
    push(q5, 3.0)
    push(q5, 0.0)
    push(q5, 4.0)
    let qn = qe_norm(q5)
    let want_norm = []
    push(want_norm, 0.0)
    push(want_norm, 0.6)
    push(want_norm, 0.0)
    push(want_norm, 0.8)
    ckq("norm_0_3_0_4", qn, want_norm)

    // KAT 4: qe_mul(identity, q) == q
    let qmul = qe_mul(qi, q)
    ckq("mul_identity_q", qmul, q)

    // KAT 5: round-trip qe_to_euler(qe_from_euler(0.1,0.2,0.3)) ~ [0.1,0.2,0.3]
    let qfe = qe_from_euler(0.1, 0.2, 0.3)
    let euler_rt = qe_to_euler(qfe)
    let e0 = euler_rt[0] * 1.0
    let e1 = euler_rt[1] * 1.0
    let e2 = euler_rt[2] * 1.0
    ckf("euler_rt_roll", e0, 0.1)
    ckf("euler_rt_pitch", e1, 0.2)
    ckf("euler_rt_yaw", e2, 0.3)

    // KAT 6: qe_nlerp(a,b,0.0) ~ a
    let qa = qe_from_axis_angle(1.0, 0.0, 0.0, 0.4)
    let qb = qe_from_axis_angle(0.0, 1.0, 0.0, 0.6)
    let qnl = qe_nlerp(qa, qb, 0.0)
    ckq("nlerp_t0_is_a", qnl, qa)

    // KAT 7: qe_nlerp(a,b,1.0) ~ b
    let qnl1 = qe_nlerp(qa, qb, 1.0)
    ckq("nlerp_t1_is_b", qnl1, qb)

    // KAT 8: qe_conjugate([1,2,3,4]) -> [1,-2,-3,-4]
    let qc_in = []
    push(qc_in, 1.0)
    push(qc_in, 2.0)
    push(qc_in, 3.0)
    push(qc_in, 4.0)
    let qconj = qe_conjugate(qc_in)
    let want_conj = []
    push(want_conj, 1.0)
    push(want_conj, -2.0)
    push(want_conj, -3.0)
    push(want_conj, -4.0)
    ckq("conjugate_1234", qconj, want_conj)

    // KAT 9: rotate_vec with identity leaves (1,0,0) unchanged
    let rv = qe_rotate_vec(qi, 1.0, 0.0, 0.0)
    let want_rv = []
    push(want_rv, 1.0)
    push(want_rv, 0.0)
    push(want_rv, 0.0)
    ckq("rotate_vec_identity", rv, want_rv)

    // KAT 10: qe_inverse of unit q then qe_mul gives identity
    let qinv = qe_inverse(q)
    let qprod = qe_mul(q, qinv)
    ckq("mul_q_qinv_is_I", qprod, qi)

    print("PASS _quatext_test")
