// KAT: a closure capturing a scalar FLOAT local must read it back as a float, not raw i64 bits.
// Regression for the dogfood gap: `let rate=1.5; let f=fn() rate; f()` returned 4609434218613702656
// (the IEEE-754 bits of 1.5). Captures are stored `any` in the closure record + read back untyped, so
// a raw-float capture must be boxed at make_closure. Arithmetic asserts catch value corruption.
fn main() -> int
    let rate = 1.5
    let f = fn() rate
    assert(f() == 1.5, "closure captures float value")
    let g = fn() rate + 0.5
    assert(g() == 2.0, "closure float capture arithmetic")
    let tax = 0.25
    let apply_tax = fn(amt) amt + amt * tax
    assert(apply_tax(100.0) == 125.0, "closure float capture used in computation")
    // int/string captures must still work (guard: only float boxes)
    let n = 7
    let addn = fn(x) x + n
    assert(addn(3) == 10, "closure int capture unaffected")
    print("PASS _kat_closure_float")
    return 0
main()
