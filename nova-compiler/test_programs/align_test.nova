@repr(C)
type CPoint
    x: int
    y: int

@repr(packed)
type Packed
    a: int
    b: int
    c: int

@repr("align(64)")
type CacheLine
    data: int
    counter: int

fn main()
    let p = CPoint(10, 20)
    assert(p.x == 10, "CPoint.x")
    assert(p.y == 20, "CPoint.y")

    let pk = Packed(1, 2, 3)
    assert(pk.a == 1, "Packed.a")
    assert(pk.b == 2, "Packed.b")
    assert(pk.c == 3, "Packed.c")

    let cl = CacheLine(42, 99)
    assert(cl.data == 42, "CacheLine.data")
    assert(cl.counter == 99, "CacheLine.counter")

    print("align_test: all passed")
