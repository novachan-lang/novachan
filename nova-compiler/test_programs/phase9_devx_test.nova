// Phase 9: Developer tools — benchmarking, coverage, profiling, DAP

fn fib(n: int) -> int
    if n <= 1
        return n
    fib(n - 1) + fib(n - 2)

fn test_profiler()
    prof_reset()
    // The profiled region must satisfy TWO things this test previously assumed rather than ensured:
    //   (a) it must take longer than the platform's clock TICK, and
    //   (b) it must survive the compile-time evaluator.
    // fib(10) failed both on Apple Silicon. It is pure with a CONSTANT argument, so 2.5 comptime
    // folding is entitled to evaluate it away entirely; and even unfolded ~177 calls is around a
    // microsecond, against a Darwin monotonic tick of ~41.67ns on a 24 MHz timebase. The region
    // measured ZERO and `ns > 0` failed on BOTH macOS runners while passing on x86 Linux --
    // an assertion about the HOST'S CLOCK dressed up as an assertion about the profiler. Same
    // class as the benchx bug fixed earlier in this campaign (integer ns_per_op truncating to 0 on
    // fast hardware). `seed` comes from cov_get, which the folder does not evaluate, so the call
    // cannot be reduced to a literal; fib(22) is ~57k calls, comfortably past any tick.
    let seed = cov_get("__never_marked__", 1)      // 0 at runtime, opaque at compile time
    let tok = prof_start("fib_region")
    let x = fib(22 + seed)
    prof_stop(tok)
    let ns = prof_get_ns("fib_region")
    // assert(cond, msg) rather than assert_eq: `assert_eq(ns > 0, true)` and `assert_eq(hits10, 1)`
    // both report the identical "expected 1 but got 0", so a CI annotation could not tell them
    // apart -- which is why identifying this failure needed deduction instead of reading it.
    assert(x == 17711, "profiler: fib(22) should be 17711, got " + str(x))
    assert(ns > 0, "profiler: elapsed ns must be > 0 (clock tick too coarse, or the region was folded away); got " + str(ns))
    print("Profiler test passed: fib(22)=" + str(x) + " in " + str(ns) + "ns")

fn test_coverage()
    cov_reset()
    cov_mark("phase9_devx_test.nova", 5)
    cov_mark("phase9_devx_test.nova", 5)
    cov_mark("phase9_devx_test.nova", 10)
    let hits5 = cov_get("phase9_devx_test.nova", 5)
    let hits10 = cov_get("phase9_devx_test.nova", 10)
    let hits99 = cov_get("phase9_devx_test.nova", 99)
    // Named, for the same reason as the profiler asserts above: a bare assert_eq here reports
    // "expected 1 but got 0", indistinguishable from the profiler's timing assertion.
    assert(hits5 == 2, "coverage: hits5 should be 2, got " + str(hits5))
    assert(hits10 == 1, "coverage: hits10 should be 1, got " + str(hits10))
    assert(hits99 == 0, "coverage: hits99 should be 0, got " + str(hits99))
    let report = cov_report()
    assert_eq(len(report) >= 2, true)
    print("Coverage test passed")

fn test_dap_log()
    // Just verify it doesn't crash (outputs to stderr)
    dap_log("console", "Phase 9 DAP test message")
    print("DAP log test passed")

fn main()
    test_profiler()
    test_coverage()
    test_dap_log()
    print("All Phase 9 devx tests passed!")
