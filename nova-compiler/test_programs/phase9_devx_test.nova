// Phase 9: Developer tools — benchmarking, coverage, profiling, DAP

fn fib(n: int) -> int
    if n <= 1
        return n
    fib(n - 1) + fib(n - 2)

fn test_profiler()
    prof_reset()
    let tok = prof_start("fib_region")
    let x = fib(10)
    prof_stop(tok)
    let ns = prof_get_ns("fib_region")
    assert_eq(x, 55)
    assert_eq(ns > 0, true)
    print("Profiler test passed: fib(10)=" + str(x) + " in " + str(ns) + "ns")

fn test_coverage()
    cov_reset()
    cov_mark("phase9_devx_test.nova", 5)
    cov_mark("phase9_devx_test.nova", 5)
    cov_mark("phase9_devx_test.nova", 10)
    let hits5 = cov_get("phase9_devx_test.nova", 5)
    let hits10 = cov_get("phase9_devx_test.nova", 10)
    let hits99 = cov_get("phase9_devx_test.nova", 99)
    assert_eq(hits5, 2)
    assert_eq(hits10, 1)
    assert_eq(hits99, 0)
    let report = cov_report()
    assert_eq(len(report) >= 2, true)
    print("Coverage test passed")

fn test_dap_log()
    // Just verify it doesn't crash (outputs to stderr)
    dap_log("console", "Phase 9 DAP test message")
    print("DAP log test passed")

fn main()
    test_profiler()
    test_coverage()
    test_dap_log()
    print("All Phase 9 devx tests passed!")
