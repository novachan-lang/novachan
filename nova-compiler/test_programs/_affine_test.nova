import std/cipher/affine

fn main()
    // ── KAT 1: Known test vector ─────────────────────────────────────────────
    let enc1 = affine_encrypt("AFFINECIPHER", 5, 8)
    if enc1 != "IHHWVCSWFRCP"
        print("FAIL affine known-enc: got " + enc1 + " want IHHWVCSWFRCP")
        exit(1)

    let dec1 = affine_decrypt("IHHWVCSWFRCP", 5, 8)
    if dec1 != "AFFINECIPHER"
        print("FAIL affine known-dec: got " + dec1 + " want AFFINECIPHER")
        exit(1)

    // ── KAT 2: Round-trip with key (5,8) ─────────────────────────────────────
    let pt2 = "HELLOWORLD"
    let ct2 = affine_encrypt(pt2, 5, 8)
    let rt2 = affine_decrypt(ct2, 5, 8)
    if rt2 != pt2
        print("FAIL affine round-trip (5,8): got " + rt2 + " want " + pt2)
        exit(1)

    // ── KAT 3: Round-trip with key (7,3) ─────────────────────────────────────
    let pt3 = "QUICKBROWNFOX"
    let ct3 = affine_encrypt(pt3, 7, 3)
    let rt3 = affine_decrypt(ct3, 7, 3)
    if rt3 != pt3
        print("FAIL affine round-trip (7,3): got " + rt3 + " want " + pt3)
        exit(1)

    // ── KAT 4: Round-trip with key (11,20) ───────────────────────────────────
    let pt4 = "THEQUICKBROWNFOXJUMPSOVERTHELAZYDOG"
    let ct4 = affine_encrypt(pt4, 11, 20)
    let rt4 = affine_decrypt(ct4, 11, 20)
    if rt4 != pt4
        print("FAIL affine round-trip (11,20): got " + rt4 + " want " + pt4)
        exit(1)

    // ── KAT 5: Identity cipher (a=1, b=0) ────────────────────────────────────
    let pt5 = "NOVACIPHER"
    let ct5 = affine_encrypt(pt5, 1, 0)
    if ct5 != pt5
        print("FAIL affine identity-enc: got " + ct5 + " want " + pt5)
        exit(1)
    let rt5 = affine_decrypt(ct5, 1, 0)
    if rt5 != pt5
        print("FAIL affine identity-dec: got " + rt5 + " want " + pt5)
        exit(1)

    // ── KAT 6: affine_valid_a ────────────────────────────────────────────────
    // 13 is invalid: gcd(13,26)=13
    let v13 = affine_valid_a(13)
    if v13 != false
        print("FAIL affine_valid_a(13): got true want false")
        exit(1)

    // 5 is valid: gcd(5,26)=1
    let v5 = affine_valid_a(5)
    if v5 != true
        print("FAIL affine_valid_a(5): got false want true")
        exit(1)

    // 1 is valid: Caesar/identity
    let v1 = affine_valid_a(1)
    if v1 != true
        print("FAIL affine_valid_a(1): got false want true")
        exit(1)

    // 2 is invalid: gcd(2,26)=2
    let v2 = affine_valid_a(2)
    if v2 != false
        print("FAIL affine_valid_a(2): got true want false")
        exit(1)

    // ── KAT 7: mod_inverse ───────────────────────────────────────────────────
    let mi5 = mod_inverse(5, 26)
    if mi5 != 21
        print("FAIL mod_inverse(5,26): got " + str(mi5) + " want 21")
        exit(1)

    // Verify: 5 * 21 mod 26 == 1
    let check5 = (5 * 21) - ((5 * 21) / 26) * 26
    if check5 != 1
        print("FAIL mod_inverse sanity 5*21 mod 26: got " + str(check5) + " want 1")
        exit(1)

    let mi3 = mod_inverse(3, 26)
    if mi3 != 9
        print("FAIL mod_inverse(3,26): got " + str(mi3) + " want 9")
        exit(1)

    let mi13 = mod_inverse(13, 26)
    if mi13 != -1
        print("FAIL mod_inverse(13,26): got " + str(mi13) + " want -1")
        exit(1)

    // ── KAT 8: Empty input safety ─────────────────────────────────────────────
    let empty_enc = affine_encrypt("", 5, 8)
    if empty_enc != ""
        print("FAIL affine empty-enc: got " + empty_enc + " want empty string")
        exit(1)

    let empty_dec = affine_decrypt("", 5, 8)
    if empty_dec != ""
        print("FAIL affine empty-dec: got " + empty_dec + " want empty string")
        exit(1)

    // ── KAT 9: Non-letter input normalisation ────────────────────────────────
    let pt9 = "Hello, World! 123"
    let ct9 = affine_encrypt(pt9, 5, 8)
    let ct9_expected = affine_encrypt("HELLOWORLD", 5, 8)
    if ct9 != ct9_expected
        print("FAIL affine normalise-enc: got " + ct9 + " want " + ct9_expected)
        exit(1)

    // ── KAT 10: Invalid a returns empty on decrypt ────────────────────────────
    let bad_dec = affine_decrypt("IHHWVCSWFRCP", 13, 8)
    if bad_dec != ""
        print("FAIL affine invalid-a-dec: got " + bad_dec + " want empty string")
        exit(1)

    // ── KAT 11: Single character round-trips ─────────────────────────────────
    let single_enc = affine_encrypt("A", 5, 8)
    let single_dec = affine_decrypt(single_enc, 5, 8)
    if single_dec != "A"
        print("FAIL affine single-char round-trip: got " + single_dec + " want A")
        exit(1)

    // ── KAT 12: Lowercase input normalised ───────────────────────────────────
    let lc_enc = affine_encrypt("affinecipher", 5, 8)
    if lc_enc != "IHHWVCSWFRCP"
        print("FAIL affine lowercase-input: got " + lc_enc + " want IHHWVCSWFRCP")
        exit(1)

    print("PASS _affine_test")
