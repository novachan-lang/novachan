import forge_tsp

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn joinl(xs: list) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + ","
        out = out + str(xs[i])
        i = i + 1
    out

// cost of a cycle given an order (sum consecutive + return to 0)
fn cycle_cost(dist: list, order: list) -> int
    let c = 0
    let i = 0
    while i < len(order)
        let a = order[i]
        let b = order[0]
        if i + 1 < len(order)
            b = order[i + 1]
        c = c + dist[a][b]
        i = i + 1
    c

fn main()
    let fails = 0

    // classic 4-city symmetric matrix
    let d = []
    push(d, [0, 10, 15, 20])
    push(d, [10, 0, 35, 25])
    push(d, [15, 35, 0, 30])
    push(d, [20, 25, 30, 0])

    fails = fails + expect("cycle4", str(tsp_shortest_cycle(d)), "80")
    fails = fails + expect("path4", str(tsp_shortest_path(d)), "65")

    // tour: starts at 0, visits all 4, and its cycle cost = 80
    let tour = tsp_tour(d)
    fails = fails + expect("tour_len", str(len(tour)), "4")
    fails = fails + expect("tour_start", str(tour[0]), "0")
    fails = fails + expect("tour_cost", str(cycle_cost(d, tour)), "80")

    // triangle
    let t = []
    push(t, [0, 1, 1])
    push(t, [1, 0, 1])
    push(t, [1, 1, 0])
    fails = fails + expect("cycle3", str(tsp_shortest_cycle(t)), "3")
    fails = fails + expect("path3", str(tsp_shortest_path(t)), "2")

    // two cities
    let two = []
    push(two, [0, 5])
    push(two, [5, 0])
    fails = fails + expect("cycle2", str(tsp_shortest_cycle(two)), "10")
    fails = fails + expect("path2", str(tsp_shortest_path(two)), "5")

    // single city
    let one = []
    push(one, [0])
    fails = fails + expect("cycle1", str(tsp_shortest_cycle(one)), "0")
    fails = fails + expect("tour1", joinl(tsp_tour(one)), "0")

    // asymmetric 3-city (directed): 0->1=1,0->2=5,1->2=1,2->0=1,1->0=9,2->1=9
    let asym = []
    push(asym, [0, 1, 5])
    push(asym, [9, 0, 1])
    push(asym, [1, 9, 0])
    // best cycle 0->1->2->0 = 1+1+1 = 3
    fails = fails + expect("asym_cycle", str(tsp_shortest_cycle(asym)), "3")

    if fails == 0
        print("forge_tsp: all passed")
    else
        print("forge_tsp: " + str(fails) + " FAILED")
