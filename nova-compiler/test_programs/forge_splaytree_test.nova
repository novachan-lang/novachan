import forge_splaytree as sp

fn check(cond: bool, label: str)
    if cond == false
        print("FAIL: " + label)

// TEST 1: insert + contains + size
let t = sp.sp_new()
check(sp.sp_size(t) == 0, "empty size 0")
sp.sp_insert(t, 5)
sp.sp_insert(t, 3)
sp.sp_insert(t, 8)
sp.sp_insert(t, 1)
sp.sp_insert(t, 4)
check(sp.sp_size(t) == 5, "size 5 after 5 inserts")
check(sp.sp_contains(t, 5), "contains 5")
check(sp.sp_contains(t, 3), "contains 3")
check(sp.sp_contains(t, 1), "contains 1")
check(sp.sp_contains(t, 4), "contains 4")
check(sp.sp_contains(t, 8), "contains 8")
check(sp.sp_contains(t, 99) == false, "not contains 99")
check(sp.sp_contains(t, 0) == false, "not contains 0")

// TEST 2: inorder is sorted
let ino = sp.sp_inorder(t)
check(len(ino) == 5, "inorder len 5")
check(ino[0] == 1, "inorder[0]=1")
check(ino[1] == 3, "inorder[1]=3")
check(ino[2] == 4, "inorder[2]=4")
check(ino[3] == 5, "inorder[3]=5")
check(ino[4] == 8, "inorder[4]=8")

// TEST 3: min/max
check(sp.sp_min(t) == 1, "min 1")
check(sp.sp_max(t) == 8, "max 8")

// TEST 4: duplicate insert is no-op
sp.sp_insert(t, 5)
check(sp.sp_size(t) == 5, "dup insert no size change")

// TEST 5: delete
sp.sp_delete(t, 3)
check(sp.sp_size(t) == 4, "size 4 after delete")
check(sp.sp_contains(t, 3) == false, "3 gone after delete")
check(sp.sp_contains(t, 5), "5 still there")
let ino2 = sp.sp_inorder(t)
check(ino2[0] == 1 and ino2[1] == 4 and ino2[2] == 5 and ino2[3] == 8, "inorder after delete")

// TEST 6: delete non-existent
sp.sp_delete(t, 100)
check(sp.sp_size(t) == 4, "delete non-existent no change")

// TEST 7: delete all
sp.sp_delete(t, 1)
sp.sp_delete(t, 4)
sp.sp_delete(t, 5)
sp.sp_delete(t, 8)
check(sp.sp_size(t) == 0, "size 0 after deleting all")
check(sp.sp_contains(t, 5) == false, "empty contains nothing")

// TEST 8: DECISIVE brute-force cross-check against a reference set (sorted list)
// Perform a random-ish sequence of insert/delete/contains and compare with a plain sorted array.
fn ref_contains(arr: list, k: int) -> bool
    let i = 0
    while i < len(arr)
        if arr[i] == k
            return true
        i = i + 1
    return false

fn ref_insert(arr: list, k: int) -> list
    if ref_contains(arr, k)
        return arr
    push(arr, k)
    return arr

fn ref_delete(arr: list, k: int) -> list
    let out = []
    let i = 0
    while i < len(arr)
        if arr[i] != k
            push(out, arr[i])
        i = i + 1
    return out

fn sort_list(arr: list) -> list
    let a = []
    let i = 0
    while i < len(arr)
        push(a, arr[i])
        i = i + 1
    let n = len(a)
    let k = 1
    while k < n
        let key = a[k]
        let j = k - 1
        while j >= 0 and a[j] > key
            a[j + 1] = a[j]
            j = j - 1
        a[j + 1] = key
        k = k + 1
    return a

// Deterministic pseudo-random sequence
let st = sp.sp_new()
let refset = []
let seed = 12345
let ok = true
let step = 0
while step < 400
    seed = (seed * 1103515245 + 12345) % 2147483648
    let val = seed % 50
    seed = (seed * 1103515245 + 12345) % 2147483648
    let op = seed % 3
    if op == 0
        // insert
        sp.sp_insert(st, val)
        refset = ref_insert(refset, val)
    else
        if op == 1
            // delete
            sp.sp_delete(st, val)
            refset = ref_delete(refset, val)
        else
            // contains
            let got = sp.sp_contains(st, val)
            let exp = ref_contains(refset, val)
            if got != exp
                ok = false
                print("CONTAINS MISMATCH val=" + str(val) + " exp=" + str(exp) + " got=" + str(got))
    // periodically validate full inorder == sorted refset
    if step % 40 == 0
        let tree_sorted = sp.sp_inorder(st)
        let ref_sorted = sort_list(refset)
        if len(tree_sorted) != len(ref_sorted)
            ok = false
            print("SIZE MISMATCH step=" + str(step) + " tree=" + str(len(tree_sorted)) + " ref=" + str(len(ref_sorted)))
        else
            let m = 0
            while m < len(tree_sorted)
                if tree_sorted[m] != ref_sorted[m]
                    ok = false
                    print("ORDER MISMATCH step=" + str(step) + " idx=" + str(m))
                m = m + 1
    step = step + 1
check(ok, "DECISIVE: 400-op splay tree matches reference set + BST-order invariant")

// Final size check
let final_tree = sp.sp_inorder(st)
let final_ref = sort_list(refset)
check(len(final_tree) == len(final_ref), "final size matches reference")

print("forge_splaytree: KAT done")
