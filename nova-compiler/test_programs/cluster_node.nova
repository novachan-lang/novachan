// cluster_node.nova — one cluster node process. Args: <port> [seed1 seed2 ...]
// Stays alive for a fixed gossip window so peers can converge THROUGH this node
// (exiting the instant we see a quorum would strand peers still gossiping via us),
// then reports its final converged member set.
import clusterx

fn main()
    let argv = args()
    let port = parse_int(argv[1])
    let seeds = []
    let i = 2
    while i < len(argv)
        push(seeds, argv[i])
        i = i + 1
    let info = cluster_start(port, seeds)
    sleep(5000)                              // gossip-convergence window (acceptor/manager/gossip run as tasks)
    let members = cluster_members(info)
    if len(members) >= 3
        print("CONVERGED:" + str(members))
        exit(0)
    print("TIMEOUT:" + str(members))
    exit(1)
