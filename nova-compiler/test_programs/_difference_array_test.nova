import std/collections/difference_array

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn ckl(label, got, expected)
    if len(got) != len(expected)
        print("FAIL " + label + ": length mismatch got " + str(len(got)) + " expected " + str(len(expected)))
        exit(1)
    let i = 0
    while i < len(expected)
        if got[i] != expected[i]
            print("FAIL " + label + "[" + str(i) + "]: got " + str(got[i]) + " expected " + str(expected[i]))
            exit(1)
        i = i + 1

fn main()
    // KAT 1: from [0,0,0,0,0], two range adds, finalize
    let arr1 = [0, 0, 0, 0, 0]
    let d1 = dfa_from(arr1)
    dfa_range_add(d1, 1, 3, 5)
    dfa_range_add(d1, 0, 2, 2)
    let f1 = dfa_finalize(d1)
    ckl("finalize_1", f1, [2, 7, 7, 5, 0])

    // KAT 2: point query on same structure (rebuild — dfa_finalize is non-destructive on d[])
    let arr2 = [0, 0, 0, 0, 0]
    let d2 = dfa_from(arr2)
    dfa_range_add(d2, 1, 3, 5)
    dfa_range_add(d2, 0, 2, 2)
    cki("point_query_1", dfa_point_query(d2, 1), 7)

    // KAT 3: from [1,1,1], add 10 to full range, finalize -> [11,11,11]
    let arr3 = [1, 1, 1]
    let d3 = dfa_from(arr3)
    dfa_range_add(d3, 0, 2, 10)
    let f3 = dfa_finalize(d3)
    ckl("finalize_2", f3, [11, 11, 11])

    // KAT 4: empty array
    let d4 = dfa_from([])
    let f4 = dfa_finalize(d4)
    cki("finalize_empty_len", len(f4), 0)

    // KAT 5: single element, no updates
    let d5 = dfa_from([42])
    let f5 = dfa_finalize(d5)
    cki("finalize_single", f5[0], 42)

    // KAT 6: range add on last element only
    let d6 = dfa_from([0, 0, 0])
    dfa_range_add(d6, 2, 2, 7)
    let f6 = dfa_finalize(d6)
    ckl("finalize_last_only", f6, [0, 0, 7])

    // KAT 7: point query index 0 after range add [0,4]
    let d7 = dfa_from([0, 0, 0, 0, 0])
    dfa_range_add(d7, 0, 4, 3)
    cki("point_query_0", dfa_point_query(d7, 0), 3)
    cki("point_query_4", dfa_point_query(d7, 4), 3)

    print("PASS _difference_array_test")
