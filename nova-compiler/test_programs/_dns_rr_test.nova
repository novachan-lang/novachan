// KAT for std/net/dns_rr — generic DNS resource record encoder/decoder.
// Vectors:
//   (a) Exact byte-check: dns_rr_encode("example.com", 1, 1, 300, [1,2,3,4])
//       NAME = \x07example\x03com\x00 (13 bytes)
//       TYPE = \x00\x01, CLASS = \x00\x01, TTL = \x00\x00\x01\x2C,
//       RDLENGTH = \x00\x04, RDATA = \x01\x02\x03\x04
//       Total = 27 bytes.
//   (b) Round-trip: encode then decode, verify type=1, class=1, ttl=300, rdlength=4, rdata=[1,2,3,4].
import std/net/dns_rr

fn _cki(label: string, got: int, want: int)
    if got != want
        print("FAIL dns_rr " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn _cks(label: string, got: string, want: string)
    if got != want
        print("FAIL dns_rr " + label + ": got '" + got + "' want '" + want + "'")
        exit(1)

fn main()
    // Build rdata = [1,2,3,4]
    let rdata = bytes(4)
    bytes_set(rdata, 0, 1)
    bytes_set(rdata, 1, 2)
    bytes_set(rdata, 2, 3)
    bytes_set(rdata, 3, 4)

    // === (a) Exact byte-check ===
    let wire = dns_rr_encode("example.com", 1, 1, 300, rdata)
    // Total length must be 27 bytes
    _cki("wire_len", bytes_len(wire), 27)

    // NAME: \x07 e x a m p l e \x03 c o m \x00
    _cki("name_b0",  bytes_get(wire,  0),  7)    // len("example")
    _cki("name_b1",  bytes_get(wire,  1),  101)  // 'e'
    _cki("name_b2",  bytes_get(wire,  2),  120)  // 'x'
    _cki("name_b3",  bytes_get(wire,  3),  97)   // 'a'
    _cki("name_b4",  bytes_get(wire,  4),  109)  // 'm'
    _cki("name_b5",  bytes_get(wire,  5),  112)  // 'p'
    _cki("name_b6",  bytes_get(wire,  6),  108)  // 'l'
    _cki("name_b7",  bytes_get(wire,  7),  101)  // 'e'
    _cki("name_b8",  bytes_get(wire,  8),  3)    // len("com")
    _cki("name_b9",  bytes_get(wire,  9),  99)   // 'c'
    _cki("name_b10", bytes_get(wire, 10),  111)  // 'o'
    _cki("name_b11", bytes_get(wire, 11),  109)  // 'm'
    _cki("name_b12", bytes_get(wire, 12),  0)    // terminator

    // TYPE = 0x0001
    _cki("type_hi",  bytes_get(wire, 13),  0)
    _cki("type_lo",  bytes_get(wire, 14),  1)

    // CLASS = 0x0001
    _cki("class_hi", bytes_get(wire, 15),  0)
    _cki("class_lo", bytes_get(wire, 16),  1)

    // TTL = 300 = 0x0000012C
    _cki("ttl_b0",   bytes_get(wire, 17),  0)
    _cki("ttl_b1",   bytes_get(wire, 18),  0)
    _cki("ttl_b2",   bytes_get(wire, 19),  1)
    _cki("ttl_b3",   bytes_get(wire, 20),  44)   // 0x2C = 44

    // RDLENGTH = 4
    _cki("rdlen_hi", bytes_get(wire, 21),  0)
    _cki("rdlen_lo", bytes_get(wire, 22),  4)

    // RDATA = [1,2,3,4]
    _cki("rd_0",     bytes_get(wire, 23),  1)
    _cki("rd_1",     bytes_get(wire, 24),  2)
    _cki("rd_2",     bytes_get(wire, 25),  3)
    _cki("rd_3",     bytes_get(wire, 26),  4)

    // === (b) Round-trip encode -> decode ===
    let res = dns_rr_decode(wire, 0)
    let rec = res[0]
    let nxt = res[1]

    // next_pos must equal total wire length (27)
    _cki("rt_next_pos", nxt, 27)

    // name must decode to "example.com"
    _cks("rt_name", rec["name"], "example.com")

    // numeric fields
    _cki("rt_type",     rec["type"],     1)
    _cki("rt_class",    rec["class"],    1)
    _cki("rt_ttl",      rec["ttl"],      300)
    _cki("rt_rdlength", rec["rdlength"], 4)

    // rdata bytes must match [1,2,3,4]
    let rd = rec["rdata"]
    _cki("rt_rd_len", bytes_len(rd), 4)
    _cki("rt_rd_0",   bytes_get(rd, 0), 1)
    _cki("rt_rd_1",   bytes_get(rd, 1), 2)
    _cki("rt_rd_2",   bytes_get(rd, 2), 3)
    _cki("rt_rd_3",   bytes_get(rd, 3), 4)

    // === (c) Edge cases: decode of malformed input must not crash ===
    // Too-short buffer
    let short = bytes(3)
    let bad1 = dns_rr_decode(short, 0)
    // Just verify it returns a list of length 2 (no crash)
    _cki("malformed_list_len", len(bad1), 2)

    // pos beyond end
    let bad2 = dns_rr_decode(wire, 100)
    _cki("oob_list_len", len(bad2), 2)

    // === (d) Large TTL round-trip (close to u32 max) ===
    let big_ttl = 2147483647
    let wire2 = dns_rr_encode("a.b", 28, 1, big_ttl, bytes(0))
    let res2 = dns_rr_decode(wire2, 0)
    let rec2 = res2[0]
    _cki("bigtll_ttl",  rec2["ttl"],  big_ttl)
    _cki("bigtll_type", rec2["type"], 28)
    _cks("bigtll_name", rec2["name"], "a.b")
    _cki("bigtll_rdlen", rec2["rdlength"], 0)

    print("PASS _dns_rr_test")
