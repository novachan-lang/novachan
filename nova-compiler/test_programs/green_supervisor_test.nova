fn flaky_worker(ch, attempt)
  if attempt < 3
    send(ch, "crash:" + str(attempt))
    panic("flaky failure")
  send(ch, "ok:" + str(attempt))

fn supervisor(ch)
  let attempt = 1
  let running = 1
  while running == 1
    let p = spawn flaky_worker(ch, attempt)
    let mon = monitor(p)
    let status = receive(mon)
    if status == 0
      send(ch, "sup:done")
      running = 0
    else
      attempt = attempt + 1
      if attempt > 5
        send(ch, "sup:gave-up")
        running = 0

fn main()
  let ch = channel()
  let _sup = spawn supervisor(ch)
  let msgs = []
  let collecting = 1
  while collecting == 1
    let msg = receive(ch)
    push(msgs, msg)
    if starts_with(msg, "sup:")
      collecting = 0

  assert(len(msgs) == 4, "expected 4 msgs: crash1 + crash2 + ok3 + sup:done, got " + str(len(msgs)))
  assert(msgs[0] == "crash:1", "first crash")
  assert(msgs[1] == "crash:2", "second crash")
  assert(msgs[2] == "ok:3", "third succeeds")
  assert(msgs[3] == "sup:done", "supervisor done")

  print("green_supervisor_test: all passed")
