// Ownership safety: send/receive deep-copies values across the channel,
// so a sender and receiver never share mutable heap state.

type Box
    val: int

// 1. A list is copied — mutating the received copy must not affect the original.
ch = channel()
data = [1, 2, 3]
send(ch, data)
got = receive(ch)
push(got, 999)
print(len(data))
print(len(got))

// 2. A nested list is DEEPLY copied (inner lists are independent too).
ch2 = channel()
outer = [[10, 20], [30, 40]]
send(ch2, outer)
got2 = receive(ch2)
push(got2[0], 77)
print(len(outer[0]))
print(len(got2[0]))

// 3. A struct is copied — mutating a field of the copy must not touch the original.
ch3 = channel()
b = Box(5)
send(ch3, b)
got3 = receive(ch3)
got3.val = 99
print(b.val)
print(got3.val)

// 4. The copy() builtin makes an explicit independent deep copy.
original = [100, 200]
clone = copy(original)
push(clone, 300)
print(len(original))
print(len(clone))
