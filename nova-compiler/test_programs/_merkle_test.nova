// KAT test for std/crypto/merkle -- Merkle hash trees (RFC-6962 style).
// Uses property/round-trip tests: single-leaf root, determinism, inclusion proofs, tamper, update.
import std/crypto/merkle

// --- helpers ---

fn cki(label: string, got: int, want: int)
    if got == want
        return
    print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
    exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got == want
        return
    let gs = "false"
    if got
        gs = "true"
    let ws = "false"
    if want
        ws = "true"
    print("FAIL " + label + ": got=" + gs + " want=" + ws)
    exit(1)

// --- (a) single leaf: mt_root(['a']) == mt_leaf_hash('a') ---
let leaves1 = []
push(leaves1, "a")
let root1 = mt_root(leaves1)
let leaf_a = mt_leaf_hash("a")
cki("single_leaf_root", root1, leaf_a)

// --- (b) determinism: mt_root(['a','b','c','d']) called twice is equal ---
let leaves4 = []
push(leaves4, "a")
push(leaves4, "b")
push(leaves4, "c")
push(leaves4, "d")
let root4a = mt_root(leaves4)
let root4b = mt_root(leaves4)
cki("determinism", root4a, root4b)

// --- (c) inclusion round-trip: for each index i in 0..3, mt_verify returns true ---
let proof0 = mt_proof(leaves4, 0)
let ok0 = mt_verify("a", 0, proof0, root4a)
ckb("inclusion_0", ok0, true)

let proof1 = mt_proof(leaves4, 1)
let ok1 = mt_verify("b", 1, proof1, root4a)
ckb("inclusion_1", ok1, true)

let proof2 = mt_proof(leaves4, 2)
let ok2 = mt_verify("c", 2, proof2, root4a)
ckb("inclusion_2", ok2, true)

let proof3 = mt_proof(leaves4, 3)
let ok3 = mt_verify("d", 3, proof3, root4a)
ckb("inclusion_3", ok3, true)

// --- (d) tamper: mt_verify with wrong leaf at index 0 == false ---
let tamper_ok = mt_verify("WRONG", 0, proof0, root4a)
ckb("tamper_detect", tamper_ok, false)

// --- (e) mt_update changes root ---
let new_root = mt_update(leaves4, 1, "X")
let changed = new_root != root4a
ckb("update_changes_root", changed, true)

// --- (f) mt_depth ---
cki("mt_depth_1", mt_depth(1), 0)
cki("mt_depth_2", mt_depth(2), 1)
cki("mt_depth_4", mt_depth(4), 2)
cki("mt_depth_5", mt_depth(5), 3)
cki("mt_depth_8", mt_depth(8), 3)
cki("mt_depth_3", mt_depth(3), 2)

// --- extra: odd-leaf tree (3 leaves) round-trip ---
let leaves3 = []
push(leaves3, "x")
push(leaves3, "y")
push(leaves3, "z")
let root3 = mt_root(leaves3)
let pr0 = mt_proof(leaves3, 0)
let pr1 = mt_proof(leaves3, 1)
let pr2 = mt_proof(leaves3, 2)
ckb("odd_inc_0", mt_verify("x", 0, pr0, root3), true)
ckb("odd_inc_1", mt_verify("y", 1, pr1, root3), true)
ckb("odd_inc_2", mt_verify("z", 2, pr2, root3), true)
// tamper on odd tree
ckb("odd_tamper", mt_verify("q", 0, pr0, root3), false)

// --- extra: verify node_hash is not same as leaf_hash for same data ---
let nh = mt_node_hash(leaf_a, leaf_a)
let lh = mt_leaf_hash("a")
ckb("domain_separation", nh != lh, true)

// --- extra: 2-leaf tree ---
let leaves2 = []
push(leaves2, "hello")
push(leaves2, "world")
let root2 = mt_root(leaves2)
let pr2_0 = mt_proof(leaves2, 0)
let pr2_1 = mt_proof(leaves2, 1)
ckb("two_inc_0", mt_verify("hello", 0, pr2_0, root2), true)
ckb("two_inc_1", mt_verify("world", 1, pr2_1, root2), true)
ckb("two_tamper_0", mt_verify("world", 0, pr2_0, root2), false)

print("PASS _merkle_test")
