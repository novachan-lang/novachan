// KAT for std/geometry/vector2 — 2D integer vector math.
// All expected values hand-computed from the spec.
import std/geometry/vector2

// cki — check int equality; FAIL+exit(1) on mismatch.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// ckf — check float equality within eps=0.001; FAIL+exit(1) on mismatch.
fn ckf(label: string, got: float, want: float)
    let diff = got - want
    let adiff = 0.0
    if diff < 0.0
        adiff = 0.0 - diff
    else
        adiff = diff
    if adiff > 0.001
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // KAT 1: v2_add([1,2],[3,4]) == [4,6]
    let a1 = [1, 2]
    let b1 = [3, 4]
    let r1 = v2_add(a1, b1)
    cki("v2_add x", r1[0], 4)
    cki("v2_add y", r1[1], 6)

    // KAT 2: v2_sub([5,7],[1,2]) == [4,5]
    let a2 = [5, 7]
    let b2 = [1, 2]
    let r2 = v2_sub(a2, b2)
    cki("v2_sub x", r2[0], 4)
    cki("v2_sub y", r2[1], 5)

    // KAT 3: v2_scale([1,2],3) == [3,6]
    let a3 = [1, 2]
    let r3 = v2_scale(a3, 3)
    cki("v2_scale x", r3[0], 3)
    cki("v2_scale y", r3[1], 6)

    // KAT 4: v2_dot([1,2],[3,4]) == 1*3 + 2*4 = 11
    let a4 = [1, 2]
    let b4 = [3, 4]
    let d4 = v2_dot(a4, b4)
    cki("v2_dot", d4, 11)

    // KAT 5: v2_cross([1,0],[0,1]) == 1*1 - 0*0 = 1
    let a5 = [1, 0]
    let b5 = [0, 1]
    let c5 = v2_cross(a5, b5)
    cki("v2_cross unit", c5, 1)

    // KAT 6: v2_length_sq([3,4]) == 9+16 = 25
    let a6 = [3, 4]
    let lsq6 = v2_length_sq(a6)
    cki("v2_length_sq 3-4-5", lsq6, 25)

    // KAT 7: v2_length([3,4]) == 5.0
    let a7 = [3, 4]
    let l7 = v2_length(a7)
    ckf("v2_length 3-4-5", l7, 5.0)

    // KAT 8: v2_perp([1,0]) == [0,1]  (90-degree CCW rotation)
    let a8 = [1, 0]
    let p8 = v2_perp(a8)
    cki("v2_perp x", p8[0], 0)
    cki("v2_perp y", p8[1], 1)

    // KAT 9: v2_perp([0,1]) == [-1,0]  (90-degree CCW of (0,1))
    let a9 = [0, 1]
    let p9 = v2_perp(a9)
    cki("v2_perp(0,1) x", p9[0], -1)
    cki("v2_perp(0,1) y", p9[1], 0)

    // KAT 10: v2_manhattan([3,-4]) == 3+4 = 7
    let a10 = [3, -4]
    let m10 = v2_manhattan(a10)
    cki("v2_manhattan 3,-4", m10, 7)

    // KAT 11: v2_cross with negative value  [2,3]x[4,1] = 2*1-3*4 = 2-12 = -10
    let a11 = [2, 3]
    let b11 = [4, 1]
    let c11 = v2_cross(a11, b11)
    cki("v2_cross 2,3 x 4,1", c11, -10)

    // KAT 12: v2_scale with zero scale -> [0,0]
    let a12 = [5, 7]
    let r12 = v2_scale(a12, 0)
    cki("v2_scale zero x", r12[0], 0)
    cki("v2_scale zero y", r12[1], 0)

    print("_vector2_test passed")
