import forge_secret_manager

fn main()
    let sm = sm_new()
    sm = sm_store(sm, "db_password", "secret123")
    sm = sm_store(sm, "api_key", "key456")

    assert(sm_secret_count(sm) == 2, "2 secrets")

    let pwd = sm_get(sm, "db_password", "app-server")
    assert(pwd == "secret123", "got password")

    let missing = sm_get(sm, "nonexistent", "app")
    assert(missing == "", "missing returns empty")

    assert(sm_version(sm, "db_password") == 1, "version=1")
    sm = sm_store(sm, "db_password", "newsecret789")
    assert(sm_version(sm, "db_password") == 2, "version=2")
    let pwd2 = sm_get(sm, "db_password", "app-server")
    assert(pwd2 == "newsecret789", "updated password")

    assert(sm_needs_rotation(sm, "api_key") == true, "needs rotation")
    sm = sm_mark_rotated(sm, "api_key")
    assert(sm_needs_rotation(sm, "api_key") == false, "rotated")

    let secrets = sm_list_secrets(sm)
    assert(len(secrets) == 2, "2 in list")

    print("SECRET-MANAGER KAT PASS")
