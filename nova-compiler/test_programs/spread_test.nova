fn main()
    // ── List spread ──
    let a = [1, 2, 3]
    let b = [4, 5, 6]
    let c = [...a, ...b]
    assert_eq(len(c), 6)
    assert_eq(c[0], 1)
    assert_eq(c[5], 6)

    // Spread with inline elements
    let d = [0, ...a, 99]
    assert_eq(len(d), 5)
    assert_eq(d[0], 0)
    assert_eq(d[1], 1)
    assert_eq(d[4], 99)

    // All spreads
    let e = [...a, ...b, ...a]
    assert_eq(len(e), 9)
    assert_eq(e[6], 1)

    // Spread empty list
    let empty = []
    let f = [...empty, 1, ...empty]
    assert_eq(len(f), 1)
    assert_eq(f[0], 1)

    // Single spread (clone)
    let g = [...a]
    assert_eq(len(g), 3)
    assert_eq(g[2], 3)

    // String list spread
    let s1 = ["hello"]
    let s2 = ["world"]
    let s3 = [...s1, " ", ...s2]
    assert_eq(len(s3), 3)
    assert_eq(s3[0], "hello")
    assert_eq(s3[1], " ")

    // ── Dict spread ──
    let d1 = {"a": 1, "b": 2}
    let d2 = {"c": 3, "d": 4}
    let d3 = {...d1, ...d2}
    assert_eq(d3["a"], 1)
    assert_eq(d3["d"], 4)

    // Dict spread with inline entries
    let d4 = {...d1, "x": 99, ...d2}
    assert_eq(d4["a"], 1)
    assert_eq(d4["x"], 99)
    assert_eq(d4["c"], 3)

    // Dict spread override (later wins)
    let d5 = {"a": 1, "b": 2}
    let d6 = {"b": 99, "c": 3}
    let d7 = {...d5, ...d6}
    assert_eq(d7["b"], 99)
    assert_eq(d7["a"], 1)
    assert_eq(d7["c"], 3)

    // Spread-first dict
    let base = {"color": "red", "size": 10}
    let overrides = {...base, "color": "blue"}
    assert_eq(overrides["color"], "blue")
    assert_eq(overrides["size"], 10)

    print("spread_test: all passed")
