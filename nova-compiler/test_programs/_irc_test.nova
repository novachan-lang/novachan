// KAT for std/net/irc — IRC message parse/build (RFC 1459 / RFC 2812).
import std/net/irc

// ── Assertion helpers ─────────────────────────────────────────────────────────

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL irc " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL irc " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── KAT 1: PRIVMSG with prefix, one param, trailing ──────────────────────
    let line1 = ":nick!user@host PRIVMSG #chan :Hello world"
    let m1 = irc_parse(line1)
    cks("privmsg-prefix",   m1["prefix"],   "nick!user@host")
    cks("privmsg-command",  m1["command"],  "PRIVMSG")
    let p1 = m1["params"]
    cki("privmsg-params-len", len(p1), 1)
    cks("privmsg-param0",   p1[0],          "#chan")
    cks("privmsg-trailing", m1["trailing"], "Hello world")

    // ── KAT 2: PING with no prefix, no params, trailing only ─────────────────
    let line2 = "PING :server1"
    let m2 = irc_parse(line2)
    cks("ping-prefix",   m2["prefix"],   "")
    cks("ping-command",  m2["command"],  "PING")
    let p2 = m2["params"]
    cki("ping-params-len", len(p2), 0)
    cks("ping-trailing", m2["trailing"], "server1")

    // ── KAT 3: JOIN with one comma-separated param, no trailing ──────────────
    let line3 = "JOIN #a,#b"
    let m3 = irc_parse(line3)
    cks("join-prefix",   m3["prefix"],   "")
    cks("join-command",  m3["command"],  "JOIN")
    let p3 = m3["params"]
    cki("join-params-len", len(p3), 1)
    cks("join-param0",   p3[0],          "#a,#b")
    cks("join-trailing", m3["trailing"], "")

    // ── KAT 4: numeric reply with prefix, one param, trailing ────────────────
    let line4 = ":irc.example.com 001 nick :Welcome to the network"
    let m4 = irc_parse(line4)
    cks("numeric-prefix",   m4["prefix"],   "irc.example.com")
    cks("numeric-command",  m4["command"],  "001")
    let p4 = m4["params"]
    cki("numeric-params-len", len(p4), 1)
    cks("numeric-param0",   p4[0],          "nick")
    cks("numeric-trailing", m4["trailing"], "Welcome to the network")

    // ── KAT 5: irc_is_numeric ────────────────────────────────────────────────
    cki("numeric-001",     irc_is_numeric("001"),     1)
    cki("numeric-433",     irc_is_numeric("433"),     1)
    cki("numeric-372",     irc_is_numeric("372"),     1)
    cki("numeric-PRIVMSG", irc_is_numeric("PRIVMSG"), 0)
    cki("numeric-empty",   irc_is_numeric(""),        0)
    cki("numeric-01",      irc_is_numeric("01"),      0)
    cki("numeric-0001",    irc_is_numeric("0001"),    0)
    cki("numeric-JOIN",    irc_is_numeric("JOIN"),    0)

    // ── KAT 6: round-trip irc_build(irc_parse(line1)) == line1 ───────────────
    let rebuilt1 = irc_build(m1)
    cks("roundtrip-privmsg", rebuilt1, line1)

    // ── KAT 7: round-trip PING ───────────────────────────────────────────────
    let rebuilt2 = irc_build(m2)
    cks("roundtrip-ping", rebuilt2, line2)

    // ── KAT 8: round-trip JOIN ───────────────────────────────────────────────
    let rebuilt3 = irc_build(m3)
    cks("roundtrip-join", rebuilt3, line3)

    // ── KAT 9: irc_build from scratch — PRIVMSG ──────────────────────────────
    let bmsg = {}
    bmsg["prefix"] = "nick!user@host"
    bmsg["command"] = "PRIVMSG"
    let bparams = []
    push(bparams, "#chan")
    bmsg["params"] = bparams
    bmsg["trailing"] = "Hello world"
    let built1 = irc_build(bmsg)
    cks("build-privmsg", built1, ":nick!user@host PRIVMSG #chan :Hello world")

    // ── KAT 10: irc_build no prefix, no params ───────────────────────────────
    let bmsg2 = {}
    bmsg2["prefix"] = ""
    bmsg2["command"] = "QUIT"
    let bparams2 = []
    bmsg2["params"] = bparams2
    bmsg2["trailing"] = "Bye!"
    let built2 = irc_build(bmsg2)
    cks("build-quit", built2, "QUIT :Bye!")

    // ── KAT 11: irc_build command only (no prefix/params/trailing) ───────────
    let bmsg3 = {}
    bmsg3["prefix"] = ""
    bmsg3["command"] = "MOTD"
    let bparams3 = []
    bmsg3["params"] = bparams3
    bmsg3["trailing"] = ""
    let built3 = irc_build(bmsg3)
    cks("build-motd", built3, "MOTD")

    // ── KAT 12: irc_build missing command -> "" ──────────────────────────────
    let bmsg4 = {}
    let built4 = irc_build(bmsg4)
    cks("build-no-cmd", built4, "")

    // ── KAT 13: irc_parse empty string -> all empty ──────────────────────────
    let me = irc_parse("")
    cks("empty-prefix",   me["prefix"],   "")
    cks("empty-command",  me["command"],  "")
    cks("empty-trailing", me["trailing"], "")
    let pe = me["params"]
    cki("empty-params-len", len(pe), 0)

    // ── KAT 14: command-only line (no spaces) ────────────────────────────────
    let ms = irc_parse("MOTD")
    cks("solo-command", ms["command"], "MOTD")
    cks("solo-prefix",  ms["prefix"],  "")
    let ps = ms["params"]
    cki("solo-params-len", len(ps), 0)
    cks("solo-trailing", ms["trailing"], "")

    // ── KAT 15: multiple middle params before trailing ────────────────────────
    let line5 = ":server MODE #chan +o nick"
    let m5 = irc_parse(line5)
    cks("mode-prefix",  m5["prefix"],  "server")
    cks("mode-command", m5["command"], "MODE")
    let p5 = m5["params"]
    cki("mode-params-len", len(p5), 3)
    cks("mode-param0", p5[0], "#chan")
    cks("mode-param1", p5[1], "+o")
    cks("mode-param2", p5[2], "nick")
    cks("mode-trailing", m5["trailing"], "")

    // ── KAT 16: trailing with spaces preserved ────────────────────────────────
    let line6 = ":nick!u@h NOTICE #chan :one two three"
    let m6 = irc_parse(line6)
    cks("notice-trailing", m6["trailing"], "one two three")

    // ── KAT 17: CRLF stripped from raw server line ───────────────────────────
    let cr = chr(13)
    let lf = chr(10)
    let line7 = "PING :server1" + cr + lf
    let m7 = irc_parse(line7)
    cks("crlf-command",  m7["command"],  "PING")
    cks("crlf-trailing", m7["trailing"], "server1")

    // ── KAT 18: round-trip numeric reply ─────────────────────────────────────
    let rebuilt4 = irc_build(m4)
    cks("roundtrip-numeric", rebuilt4, ":irc.example.com 001 nick :Welcome to the network")

    print("PASS _irc_test")
