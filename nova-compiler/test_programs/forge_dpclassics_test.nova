import forge_dpclassics

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // matrix chain
    fails = fails + expect("mc_3", str(matrix_chain_order([1, 2, 3, 4])), "18")
    fails = fails + expect("mc_2", str(matrix_chain_order([10, 20, 30])), "6000")
    fails = fails + expect("mc_1", str(matrix_chain_order([5, 10])), "0")
    fails = fails + expect("mc_gfg", str(matrix_chain_order([40, 20, 30, 10, 30])), "26000")
    fails = fails + expect("mc_clrs", str(matrix_chain_order([30, 35, 15, 5, 10, 20, 25])), "15125")

    // rod cutting
    fails = fails + expect("rod8", str(rod_cutting([1, 5, 8, 9, 10, 17, 17, 20], 8)), "22")
    fails = fails + expect("rod4", str(rod_cutting([1, 5, 8, 9, 10, 17, 17, 20], 4)), "10")
    fails = fails + expect("rod1", str(rod_cutting([1, 5, 8, 9, 10, 17, 17, 20], 1)), "1")
    fails = fails + expect("rod0", str(rod_cutting([1, 5, 8], 0)), "0")
    // uniform price 1 per unit -> revenue = n
    fails = fails + expect("rod_uniform", str(rod_cutting([1, 2, 3, 4, 5], 5)), "5")

    // egg drop
    fails = fails + expect("egg_2_10", str(egg_drop(2, 10)), "4")
    fails = fails + expect("egg_2_100", str(egg_drop(2, 100)), "14")
    fails = fails + expect("egg_1_5", str(egg_drop(1, 5)), "5")
    fails = fails + expect("egg_3_14", str(egg_drop(3, 14)), "4")
    fails = fails + expect("egg_2_1", str(egg_drop(2, 1)), "1")
    fails = fails + expect("egg_e_0", str(egg_drop(3, 0)), "0")
    fails = fails + expect("egg_2_36", str(egg_drop(2, 36)), "8")

    if fails == 0
        print("forge_dpclassics: all passed")
    else
        print("forge_dpclassics: " + str(fails) + " FAILED")
