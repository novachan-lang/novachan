// Live TLS 1.3 client L2 vs openssl s_server -www: complete the full handshake (verify CertificateVerify +
// Finished, send client Finished), then send an encrypted HTTP GET and decrypt the server's response.
import forge_tls_client
import forge_crypto

fn main()
    let crlf = chr(13) + chr(10)
    let req = str_to_blist("GET / HTTP/1.0" + crlf + crlf)
    // FIX 3 (forge_tls_client MITM defense): tls13_client_request now requires trust_anchor + expected_host.
    // An empty trust_anchor FAILS CLOSED by design (see forge_tls_client.nova) -- this live interop test has
    // no way to pre-know openssl s_server's self-signed cert, so it cannot supply a real pinned anchor here.
    // A real run pinning a specific s_server instance would pass that server's leaf/root DER as trust_anchor.
    let r = tls13_client_request("127.0.0.1", 44330, req, [], "127.0.0.1")
    if r[0] != 1
        print("FAIL: full handshake / data exchange failed")
        exit(1)
    let resp = r[1]
    if len(resp) < 12
        print("FAIL: response too short (len under 12)")
        exit(1)
    let want = str_to_blist("HTTP/1.0 200")
    let i = 0
    let ok = 1
    while i < 12
        if resp[i] != want[i]
            ok = 0
        i = i + 1
    if ok != 1
        print("FAIL: response is not an HTTP 200 status line")
        exit(1)
    print("PASS forge_tls_client_l2 (full TLS 1.3 handshake + encrypted HTTP GET/response vs openssl)")
