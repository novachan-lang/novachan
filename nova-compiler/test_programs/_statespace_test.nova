import std/control/statespace

// approx — float equality within tolerance.
fn approx(a, b, tol)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < tol

fn ckf(label, got, want)
    if not approx(got, want, 0.001)
        print("FAIL statespace " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL statespace " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // 1-state system: A=[0.5], B=[1.0], C=[1.0], n=m=p=1
    let A1 = [0.5]
    let B1 = [1.0]
    let C1 = [1.0]
    let m1 = ss_new(A1, B1, C1, 1, 1, 1)

    // x0=[0], u=[1]: x_next = 0.5*0 + 1*1 = 1.0
    let x0 = [0.0]
    let u1 = [1.0]
    let x1 = ss_step(m1, x0, u1)
    ckf("step1_x", x1[0] * 1.0, 1.0)

    // another step from [1.0]: x_next = 0.5*1 + 1 = 1.5
    let x2 = ss_step(m1, x1, u1)
    ckf("step2_x", x2[0] * 1.0, 1.5)

    // ss_output: y = C*x = [1]*[2.0] = [2.0]
    let xtest = [2.0]
    let y = ss_output(m1, xtest)
    ckf("output_1d", y[0] * 1.0, 2.0)

    // 2x2 identity test for mat_vec
    let I2 = [1.0, 0.0, 0.0, 1.0]
    let v2 = [3.0, 5.0]
    let mv = mat_vec(I2, v2, 2, 2)
    ckf("matvec_i2_x", mv[0] * 1.0, 3.0)
    ckf("matvec_i2_y", mv[1] * 1.0, 5.0)

    // ss_is_stable: A=[0.5] -> |0.5| < 1 => true
    cki("stable_0.5", ss_is_stable(m1), true)

    // ss_is_stable: A=[1.5] -> |1.5| >= 1 => false
    let Au = [1.5]
    let mu = ss_new(Au, B1, C1, 1, 1, 1)
    cki("unstable_1.5", ss_is_stable(mu), false)

    // ss_dim_n
    cki("dim_n", ss_dim_n(m1), 1)

    // ss_zero_state
    let z = ss_zero_state(3)
    cki("zero_state_len", len(z), 3)
    ckf("zero_state_0", z[0] * 1.0, 0.0)

    // vec_add
    let va = [1.0, 2.0]
    let vb = [3.0, 4.0]
    let vc = vec_add(va, vb)
    ckf("vecadd_0", vc[0] * 1.0, 4.0)
    ckf("vecadd_1", vc[1] * 1.0, 6.0)

    // ss_simulate: 3 steps from [0], u=[1]; outputs y0,y1,y2
    // step 0: x=[0], y=0, x_next=[1]
    // step 1: x=[1], y=1, x_next=[1.5]
    // step 2: x=[1.5], y=1.5, x_next=[1.75]
    let inputs1 = [[1.0], [1.0], [1.0]]
    let sims = ss_simulate(m1, x0, inputs1, 3)
    ckf("simulate_y0", sims[0][0] * 1.0, 0.0)
    ckf("simulate_y1", sims[1][0] * 1.0, 1.0)
    ckf("simulate_y2", sims[2][0] * 1.0, 1.5)

    // ss_equilibrium for A=0.5, B=1, u=1: x_eq = B*u / (1-A) = 1/(1-0.5) = 2.0
    let eq = ss_equilibrium(m1, u1)
    ckf("equilibrium", eq[0] * 1.0, 2.0)

    // ss_response_step: 2 steps
    let resp = ss_response_step(m1, 2)
    ckf("response_step_y0", resp[0][0] * 1.0, 0.0)
    ckf("response_step_y1", resp[1][0] * 1.0, 1.0)

    // ss_reachable_rank_hint: 1D with B=[1] => rank=1
    cki("reachable_hint", ss_reachable_rank_hint(m1), 1)

    print("PASS _statespace_test")
