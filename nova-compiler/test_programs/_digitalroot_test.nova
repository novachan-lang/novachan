// _digitalroot_test.nova — KAT for std/math/digitalroot
import std/math/digitalroot

fn cki(label: string, got: int, expected: int)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn ckb(label: string, got: bool, expected: bool)
    if got != expected
        let gs = "false"
        if got
            gs = "true"
        let es = "false"
        if expected
            es = "true"
        print("FAIL " + label + ": got " + gs + " expected " + es)
        exit(1)

fn main()
    // --- dr_root base-10 ---
    // dr_root(0) == 0  (special case)
    cki("dr_root_0",     dr_root(0),     0)
    // dr_root(9) == 9  (single digit, no reduction needed)
    cki("dr_root_9",     dr_root(9),     9)
    // dr_root(12) == 3  (1+2=3)
    cki("dr_root_12",    dr_root(12),    3)
    // dr_root(9875) == 2  (9+8+7+5=29 -> 2+9=11 -> 1+1=2)
    cki("dr_root_9875",  dr_root(9875),  2)
    // dr_root(99999) == 9  (9*5=45 -> 4+5=9)
    cki("dr_root_99999", dr_root(99999), 9)
    // dr_root(10) == 1  (1+0=1)
    cki("dr_root_10",    dr_root(10),    1)
    // dr_root(1) == 1  (single digit)
    cki("dr_root_1",     dr_root(1),     1)
    // dr_root(18) == 9  (1+8=9)
    cki("dr_root_18",    dr_root(18),    9)

    // --- dr_root_base (non-decimal) ---
    // Base 16: n=255 (0xFF). Hex digits: F+F=15+15=30; 3+0=3. Formula: 1+(255-1)%15=1+254%15=1+14=15? No:
    // 254 % 15 = 254 - 16*15 = 254-240 = 14. So 1+14=15. But 15 in hex is 'F' = single hex digit.
    // Verify iteratively: 0xFF = 255; digits in base 16: F,F -> 15+15=30; 30 in base 16 = 1,14 -> 1+14=15. Correct.
    cki("dr_root_base16_255", dr_root_base(255, 16), 15)
    // Base 2: n=7 (binary 111). digit sum=3, digit sum=1+1=2, digit sum=1+0=1. Formula: 1+(7-1)%1=?
    // base-1=1, (7-1)%1=0, 1+0=1. Correct.
    cki("dr_root_base2_7",   dr_root_base(7, 2),    1)
    // Base 8: n=63 (octal 77). digits: 7+7=14; 14 in base 8 = 1*8+6 -> 1+6=7. Formula: 1+(63-1)%7=1+62%7=1+6=7.
    cki("dr_root_base8_63",  dr_root_base(63, 8),   7)
    // Base 10: same as dr_root
    cki("dr_root_base10_12", dr_root_base(12, 10),  3)
    // Zero in any base -> 0
    cki("dr_root_base16_0",  dr_root_base(0, 16),   0)

    // --- dr_is_mult9 ---
    // 18 is 2*9 -> digital root 9 -> true
    ckb("dr_is_mult9_18",  dr_is_mult9(18),  true)
    // 19 is not a multiple of 9 -> false
    ckb("dr_is_mult9_19",  dr_is_mult9(19),  false)
    // 0 -> false (excluded by spec)
    ckb("dr_is_mult9_0",   dr_is_mult9(0),   false)
    // 9 itself -> true
    ckb("dr_is_mult9_9",   dr_is_mult9(9),   true)
    // 99999 (digital root 9) -> true
    ckb("dr_is_mult9_99999", dr_is_mult9(99999), true)

    print("_digitalroot_test passed")
