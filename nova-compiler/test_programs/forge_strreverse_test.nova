import forge_strreverse

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // reverse_string
    fails = fails + expect("rs1", reverse_string("hello"), "olleh")
    fails = fails + expect("rs_empty", reverse_string(""), "")
    fails = fails + expect("rs_single", reverse_string("a"), "a")
    fails = fails + expect("rs_palin", reverse_string("racecar"), "racecar")
    fails = fails + expect("rs_num", reverse_string("12345"), "54321")

    // reverse_words
    fails = fails + expect("rw1", reverse_words("the quick brown fox"), "fox brown quick the")
    fails = fails + expect("rw_extra_spaces", reverse_words("  hello   world  "), "world hello")
    fails = fails + expect("rw_single", reverse_words("solo"), "solo")
    fails = fails + expect("rw_empty", reverse_words(""), "")
    fails = fails + expect("rw_spaces_only", reverse_words("   "), "")
    fails = fails + expect("rw_name", reverse_words("Smith John"), "John Smith")

    // reverse_each_word
    fails = fails + expect("rew1", reverse_each_word("abc def"), "cba fed")
    fails = fails + expect("rew2", reverse_each_word("Hello World"), "olleH dlroW")
    fails = fails + expect("rew_single", reverse_each_word("wow"), "wow")

    if fails == 0
        print("forge_strreverse: all passed")
    else
        print("forge_strreverse: " + str(fails) + " FAILED")
