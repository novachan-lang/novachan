// Distributed spawn over TCP (Erlang-class): a requester green-task connects to
// the server (main), sends a spawn request [fn_name, args] via remote_spawn; the
// server resolves the function by name (call_by_name -> the function registry),
// runs it on its own deep-copied args (process isolation across the wire), and
// returns the result on the channel. Proves remote_spawn + the registry end-to-end.
fn add(a, b)
    a + b

fn requester(port)
    let conn = remote_connect("127.0.0.1", port)
    remote_spawn(conn, "add", [15, 27])
    let reply = remote_recv(conn)
    assert_eq(reply, 42)
    remote_close(conn)

fn main()
    let port = 19933
    spawn requester(port)
    let ch = remote_listen(port)          // bind + accept (requester connects meanwhile)
    let req = remote_recv(ch)             // [fn_name, args]
    let result = call_by_name(req[0], req[1])
    assert_eq(result, 42)
    remote_send(ch, result)
    remote_close(ch)
    print("remote_spawn_test passed: remote add(15, 27) = 42")
