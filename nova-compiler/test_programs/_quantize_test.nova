// KAT test for std/dsp/quantize.nova
//
// Hand-computed reference values:
//   qz_round_to([1.2,1.7,2.4], 0.5)         -> [1.0,1.5,2.5]
//     1.2/0.5=2.4 -> int(2.9)=2 -> 1.0
//     1.7/0.5=3.4 -> int(3.9)=3 -> 1.5
//     2.4/0.5=4.8 -> int(5.3)=5 -> 2.5
//   qz_uniform([0.0,0.33,0.67,1.0],2,0.0,1.0) -> [0.0,0.0,1.0,1.0]
//     step=1.0; 0.33->idx0->0.0; 0.67->idx1->1.0
//   qz_uniform([0.0,0.5,1.0],3,0.0,1.0)     -> [0.0,0.5,1.0]
//     step=0.5; each maps to itself
//   qz_mu_law_encode(0.0,255.0)              -> 0.0  (log(1)/log(256)=0)
//   round-trip qz_mu_law_decode(qz_mu_law_encode(0.5,255.0),255.0) approx 0.5
//     encode(0.5,255)=log(128.5)/log(256)~0.8757
//     decode(0.8757,255)=(256^0.8757-1)/255~0.5
//   qz_round_to([0.1,0.24,0.26],0.1)[2]     -> 0.3
//     0.26/0.1=2.6 -> int(3.1)=3 -> 0.3
//   qz_snr(perfect, perfect)                -> ~999.0  (zero noise)
//   qz_snr([1.0,1.0],[0.0,0.0])             -> 0.0 dB (sig=noise=1.0)

import std/dsp/quantize

// ckf: compare two floats within eps 0.01
fn ckf(label: string, got: float, want: float)
    let diff = got - want
    if diff < 0.0
        diff = 0.0 - diff
    if diff > 0.01
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// ckf_list: compare two float lists element-wise within eps 0.01
fn ckf_list(label: string, got: list, want: list)
    let ng = len(got)
    let nw = len(want)
    if ng != nw
        print("FAIL " + label + " length: got " + str(ng) + " want " + str(nw))
        exit(1)
    let i = 0
    while i < nw
        let gv = got[i] * 1.0
        let wv = want[i] * 1.0
        let diff = gv - wv
        if diff < 0.0
            diff = 0.0 - diff
        if diff > 0.01
            print("FAIL " + label + "[" + str(i) + "]: got " + str(gv) + " want " + str(wv))
            exit(1)
        i = i + 1

fn main()
    // ── KAT 1: qz_round_to([1.2,1.7,2.4], 0.5) == [1.0,1.5,2.5] ────────────
    let xs1 = []
    xs1.push(1.2)
    xs1.push(1.7)
    xs1.push(2.4)
    let want1 = []
    want1.push(1.0)
    want1.push(1.5)
    want1.push(2.5)
    let r1 = qz_round_to(xs1, 0.5)
    ckf_list("round_to_half", r1, want1)

    // ── KAT 2: qz_uniform([0.0,0.33,0.67,1.0], 2, 0.0, 1.0) == [0.0,0.0,1.0,1.0] ──
    let xs2 = []
    xs2.push(0.0)
    xs2.push(0.33)
    xs2.push(0.67)
    xs2.push(1.0)
    let want2 = []
    want2.push(0.0)
    want2.push(0.0)
    want2.push(1.0)
    want2.push(1.0)
    let r2 = qz_uniform(xs2, 2, 0.0, 1.0)
    ckf_list("uniform_2levels", r2, want2)

    // ── KAT 3: qz_uniform([0.0,0.5,1.0], 3, 0.0, 1.0) == [0.0,0.5,1.0] ─────
    let xs3 = []
    xs3.push(0.0)
    xs3.push(0.5)
    xs3.push(1.0)
    let want3 = []
    want3.push(0.0)
    want3.push(0.5)
    want3.push(1.0)
    let r3 = qz_uniform(xs3, 3, 0.0, 1.0)
    ckf_list("uniform_3levels", r3, want3)

    // ── KAT 4: qz_mu_law_encode(0.0, 255.0) == 0.0 ──────────────────────────
    // log(1 + 255*0) = log(1) = 0; mag = 0/log(256) = 0.0
    let enc0 = qz_mu_law_encode(0.0, 255.0)
    ckf("mu_enc_zero", enc0, 0.0)

    // ── KAT 5: round-trip qz_mu_law_decode(qz_mu_law_encode(0.5,255),255) ~= 0.5 ──
    // encode(0.5,255) = log(1+127.5)/log(256) = log(128.5)/5.5452 ~ 0.8757
    // decode(0.8757,255) = (256^0.8757 - 1)/255 ~ 127.5/255 ~ 0.5
    let enc_half = qz_mu_law_encode(0.5, 255.0)
    let dec_half = qz_mu_law_decode(enc_half, 255.0)
    ckf("mu_roundtrip_half", dec_half, 0.5)

    // ── KAT 6: qz_round_to([0.1,0.24,0.26], 0.1)[2] == 0.3 ─────────────────
    // 0.26/0.1=2.6 -> int(2.6+0.5)=int(3.1)=3 -> 3*0.1=0.3
    let xs6 = []
    xs6.push(0.1)
    xs6.push(0.24)
    xs6.push(0.26)
    let r6 = qz_round_to(xs6, 0.1)
    let v6 = r6[2] * 1.0
    ckf("round_to_tenth_idx2", v6, 0.3)

    // ── KAT 7: qz_snr -- perfect reconstruction => SNR sentinel 999.0 ────────
    // original == quantized => zero noise => returns 999.0
    let orig7 = []
    orig7.push(1.0)
    orig7.push(0.5)
    orig7.push(0.0 - 0.5)
    orig7.push(0.0 - 1.0)
    let qt7 = []
    qt7.push(1.0)
    qt7.push(0.5)
    qt7.push(0.0 - 0.5)
    qt7.push(0.0 - 1.0)
    let snr7 = qz_snr(orig7, qt7)
    ckf("snr_perfect", snr7, 999.0)

    // ── KAT 8: qz_snr -- signal equal to noise => 0.0 dB ────────────────────
    // original=[1.0,1.0], quantized=[0.0,0.0]
    // sig_pow = mean(1,1) = 1.0; noise_pow = mean(1,1) = 1.0
    // SNR = 10*log10(1/1) = 10*0 = 0.0
    let orig8 = []
    orig8.push(1.0)
    orig8.push(1.0)
    let qt8 = []
    qt8.push(0.0)
    qt8.push(0.0)
    let snr8 = qz_snr(orig8, qt8)
    ckf("snr_0db", snr8, 0.0)

    print("_quantize_test passed")
