import std/util/retry

// ── helpers ──────────────────────────────────────────────────────────────────

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckl(label: str, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + ": length got " + str(len(got)) + " want " + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL " + label + "[" + str(i) + "]: got " + str(got[i]) + " want " + str(want[i]))
            exit(1)
        i = i + 1

fn ck_in_range(label: str, got: int, lo: int, hi: int)
    if got < lo
        print("FAIL " + label + ": got " + str(got) + " < lo " + str(lo))
        exit(1)
    if got > hi
        print("FAIL " + label + ": got " + str(got) + " > hi " + str(hi))
        exit(1)

fn ck_list_in_range(label: str, got: list, delays: list)
    let i = 0
    while i < len(got)
        let d = delays[i]
        let lo = d / 2
        let hi = d + d / 2
        ck_in_range(label + "[" + str(i) + "]", got[i], lo, hi)
        i = i + 1

fn main()
    // ── rt_delay_at: basic exponential ───────────────────────────────────────
    // delay_at(0, 100, 2, 1000000) = 100 * 2^0 = 100
    cki("delay_at_0", rt_delay_at(0, 100, 2, 1000000), 100)
    // delay_at(1, 100, 2, 1000000) = 100 * 2^1 = 200
    cki("delay_at_1", rt_delay_at(1, 100, 2, 1000000), 200)
    // delay_at(2, 100, 2, 1000000) = 100 * 2^2 = 400
    cki("delay_at_2", rt_delay_at(2, 100, 2, 1000000), 400)
    // delay_at(3, 100, 2, 1000000) = 100 * 2^3 = 800 — spec KAT
    cki("delay_at_3", rt_delay_at(3, 100, 2, 1000000), 800)
    // delay_at(0, 100, 2, 9) = min(100, 9) = 9 — base > cap, cap wins — spec KAT
    cki("delay_at_cap", rt_delay_at(0, 100, 2, 9), 9)
    // cap mid-sequence: 100*2^3=800 > 500 -> 500
    cki("delay_at_capped_mid", rt_delay_at(3, 100, 2, 500), 500)
    // factor=1 -> always base (linear degenerate)
    cki("delay_at_factor1", rt_delay_at(5, 100, 1, 1000000), 100)
    // i < 0 treated as 0
    cki("delay_at_neg_i", rt_delay_at(-1, 100, 2, 1000000), 100)

    // ── rt_delays: spec KAT list checks ──────────────────────────────────────
    // delays(5, 100, 2, 1000000) = [100, 200, 400, 800, 1600]
    let d5 = rt_delays(5, 100, 2, 1000000)
    ckl("delays_5_nocap", d5, [100, 200, 400, 800, 1600])

    // delays(6, 100, 2, 500) = [100, 200, 400, 500, 500, 500]
    let d6 = rt_delays(6, 100, 2, 500)
    ckl("delays_6_cap500", d6, [100, 200, 400, 500, 500, 500])

    // n=0 -> empty
    let d0 = rt_delays(0, 100, 2, 1000)
    cki("delays_0_len", len(d0), 0)

    // n=1 -> just base
    let d1 = rt_delays(1, 200, 3, 1000000)
    cki("delays_1", d1[0], 200)

    // factor=1 -> all equal to base
    let df1 = rt_delays(4, 50, 1, 1000000)
    ckl("delays_factor1", df1, [50, 50, 50, 50])

    // heavy cap: cap smaller than base -> all cap
    let dcap = rt_delays(4, 1000, 2, 500)
    ckl("delays_base_gt_cap", dcap, [500, 500, 500, 500])

    // ── rt_jittered: determinism + range ─────────────────────────────────────
    // Hand-computed (LCG seed=42 -> state after initial step = 1083814273):
    // d=100: state=378494188, jd=50+(378494188%100)=50+88=138
    // d=200: state=2479403867, jd=100+(2479403867%200)=100+67=167
    // d=400: state=955863294, jd=200+(955863294%400)=200+94=294
    // d=800: state=1613448261, jd=400+(1613448261%800)=400+261=661
    // d=1600: state=110225632, jd=800+(110225632%1600)=800+32=832
    let delays5 = [100, 200, 400, 800, 1600]
    let j42 = rt_jittered(delays5, 42)
    ckl("jitter_seed42_exact", j42, [138, 167, 294, 661, 832])

    // Determinism: same seed -> identical output
    let j42b = rt_jittered(delays5, 42)
    ckl("jitter_deterministic", j42b, [138, 167, 294, 661, 832])

    // Different seed -> different output (with overwhelming probability)
    let j99 = rt_jittered(delays5, 99)
    // seed=99: [143, 132, 319, 1130, 2097]
    ckl("jitter_seed99_exact", j99, [143, 132, 319, 1130, 2097])

    // All jittered values within [d/2, d + d/2]
    ck_list_in_range("jitter_range_42", j42, delays5)
    ck_list_in_range("jitter_range_99", j99, delays5)

    // d=0 element -> stays 0 (no modulo by zero)
    let dz = [0, 100, 0]
    let jz = rt_jittered(dz, 7)
    cki("jitter_zero_d0", jz[0], 0)
    cki("jitter_zero_d2", jz[2], 0)
    ck_in_range("jitter_zero_d1", jz[1], 50, 150)

    // Empty list -> empty output
    let je = rt_jittered([], 42)
    cki("jitter_empty", len(je), 0)

    print("_retry_test passed")
