// forge_cache_test -- Cache-Control + Vary directives, and the gzip-middleware Vary correctness fix.
// /j: a content-negotiated JSON response marked cacheable + Vary: Accept. /n: a no-store response.
// /big (via mw_compress): gzipped, must advertise Vary: Accept-Encoding so a cache can't mis-serve it.
import forge
import forge_compress

fn _j(req: Request) -> Response
    let d = {}
    d["ok"] = "yes"
    forge.cache(forge.vary(forge.resp_json(200, d), "Accept"), 60)

fn _n(req: Request) -> Response
    forge.no_store(forge.resp_text(200, "secret"))

fn _big(req: Request) -> Response
    let s = ""
    let i = 0
    while i < 2000
        s = s + "x"
        i = i + 1
    forge.resp_text(200, s)

fn _server(port: int)
    let a = forge.app()
    forge.use(a, forge_compress.mw_compress())
    forge.get(a, "/j", fn(req) _j(req))
    forge.get(a, "/n", fn(req) _n(req))
    forge.get(a, "/big", fn(req) _big(req))
    forge.serve_req_n(a, port, 3)

fn _get(port: int, path: string, extra: string) -> string
    let s = tcp_connect("127.0.0.1", port)
    tcp_send(s, "GET " + path + " HTTP/1.0\r\nConnection: close\r\n" + extra + "\r\n")
    let r = tcp_recv(s)
    let go = true
    while go
        let more = tcp_recv(s)
        if len(more) == 0
            go = false
        else
            r = r + more
    tcp_close(s)
    r

fn main()
    let port = 19425
    spawn fn()
        _server(port)
    sleep(300)

    // cacheable + Vary: Accept (the content-negotiation correctness header)
    let rj = _get(port, "/j", "")
    assert(find(rj, "Cache-Control: public, max-age=60") >= 0, "cache(resp,60) -> public, max-age=60")
    assert(find(rj, "Vary: Accept") >= 0, "vary(resp,'Accept') set so caches don't mis-serve negotiated content")
    print("PASS: cache() + vary(Accept)")

    // no-store for a sensitive response
    let rn = _get(port, "/n", "")
    assert(find(rn, "Cache-Control: no-store") >= 0, "no_store(resp) -> no-store")
    print("PASS: no_store()")

    // gzip middleware now advertises Vary: Accept-Encoding (the correctness fix)
    let rb = _get(port, "/big", "Accept-Encoding: gzip\r\n")
    assert(find(rb, "Content-Encoding: gzip") >= 0, "large body gzip-compressed")
    assert(find(rb, "Vary: Accept-Encoding") >= 0, "gzip response advertises Vary: Accept-Encoding (cache-correct)")
    print("PASS: gzip + Vary: Accept-Encoding")
    print("forge_cache_test passed")
