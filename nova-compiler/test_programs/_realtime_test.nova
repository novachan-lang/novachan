import std/midi/realtime

// ── helper: compare two int lists for equality ───────────────────────────────
fn _lists_equal(a, b)
    let result = 1
    if len(a) != len(b)
        result = 0
    else
        let i = 0
        while i < len(a)
            if a[i] != b[i]
                result = 0
            i = i + 1
    result == 1

// ── helper: list -> "[b0, b1, ...]" for readable failure output ──────────────
fn _list_str(lst)
    let s = "["
    let i = 0
    while i < len(lst)
        s = s + str(lst[i])
        if i < len(lst) - 1
            s = s + ","
        i = i + 1
    s = s + "]"
    s

fn main()
    // ── rt_clock() == [0xF8] ──────────────────────────────────────────────────
    let want_clock = []
    push(want_clock, 0xF8)
    let got_clock = rt_clock()
    if _lists_equal(got_clock, want_clock) == false
        print("FAIL realtime rt_clock: got " + _list_str(got_clock) + " want " + _list_str(want_clock))
        exit(1)

    // ── rt_start() == [0xFA] ─────────────────────────────────────────────────
    let want_start = []
    push(want_start, 0xFA)
    let got_start = rt_start()
    if _lists_equal(got_start, want_start) == false
        print("FAIL realtime rt_start: got " + _list_str(got_start) + " want " + _list_str(want_start))
        exit(1)

    // ── rt_stop() == [0xFC] ──────────────────────────────────────────────────
    let want_stop = []
    push(want_stop, 0xFC)
    let got_stop = rt_stop()
    if _lists_equal(got_stop, want_stop) == false
        print("FAIL realtime rt_stop: got " + _list_str(got_stop) + " want " + _list_str(want_stop))
        exit(1)

    // ── rt_continue() == [0xFB] ──────────────────────────────────────────────
    let want_cont = []
    push(want_cont, 0xFB)
    let got_cont = rt_continue()
    if _lists_equal(got_cont, want_cont) == false
        print("FAIL realtime rt_continue: got " + _list_str(got_cont) + " want " + _list_str(want_cont))
        exit(1)

    // ── song_position(0) == [0xF2, 0, 0] ─────────────────────────────────────
    let want_sp0 = []
    push(want_sp0, 0xF2)
    push(want_sp0, 0)
    push(want_sp0, 0)
    let got_sp0 = song_position(0)
    if _lists_equal(got_sp0, want_sp0) == false
        print("FAIL realtime song_position(0): got " + _list_str(got_sp0) + " want " + _list_str(want_sp0))
        exit(1)

    // ── song_position(0x2000) == [0xF2, 0x00, 0x40] ──────────────────────────
    // 0x2000 = 8192 decimal
    // lsb7 = 8192 & 0x7F = 0x00  (8192 = 64*128, exactly divisible by 128)
    // msb7 = (8192 >> 7) & 0x7F = 64 = 0x40
    let want_sp2000 = []
    push(want_sp2000, 0xF2)
    push(want_sp2000, 0x00)
    push(want_sp2000, 0x40)
    let got_sp2000 = song_position(0x2000)
    if _lists_equal(got_sp2000, want_sp2000) == false
        print("FAIL realtime song_position(0x2000): got " + _list_str(got_sp2000) + " want " + _list_str(want_sp2000))
        exit(1)

    // ── song_select(5) == [0xF3, 5] ──────────────────────────────────────────
    let want_ss = []
    push(want_ss, 0xF3)
    push(want_ss, 5)
    let got_ss = song_select(5)
    if _lists_equal(got_ss, want_ss) == false
        print("FAIL realtime song_select(5): got " + _list_str(got_ss) + " want " + _list_str(want_ss))
        exit(1)

    // ── tune_request() == [0xF6] ─────────────────────────────────────────────
    let want_tr = []
    push(want_tr, 0xF6)
    let got_tr = tune_request()
    if _lists_equal(got_tr, want_tr) == false
        print("FAIL realtime tune_request: got " + _list_str(got_tr) + " want " + _list_str(want_tr))
        exit(1)

    // ── is_realtime(0xF8) == true ────────────────────────────────────────────
    let got_ir_f8 = is_realtime(0xF8)
    if got_ir_f8 == false
        print("FAIL realtime is_realtime(0xF8): got false want true")
        exit(1)

    // ── is_realtime(0x90) == false ───────────────────────────────────────────
    let got_ir_90 = is_realtime(0x90)
    if got_ir_90 == true
        print("FAIL realtime is_realtime(0x90): got true want false")
        exit(1)

    // ── round-trip: rt_active_sensing() == [0xFE] ────────────────────────────
    let want_as = []
    push(want_as, 0xFE)
    let got_as = rt_active_sensing()
    if _lists_equal(got_as, want_as) == false
        print("FAIL realtime rt_active_sensing: got " + _list_str(got_as) + " want " + _list_str(want_as))
        exit(1)

    // ── rt_reset() == [0xFF] ─────────────────────────────────────────────────
    let want_rr = []
    push(want_rr, 0xFF)
    let got_rr = rt_reset()
    if _lists_equal(got_rr, want_rr) == false
        print("FAIL realtime rt_reset: got " + _list_str(got_rr) + " want " + _list_str(want_rr))
        exit(1)

    // ── is_realtime covers full 0xF8..0xFF range ─────────────────────────────
    let b = 0xF8
    while b <= 0xFF
        let ok = is_realtime(b)
        if ok == false
            print("FAIL realtime is_realtime range: byte " + str(b) + " should be true")
            exit(1)
        b = b + 1

    // ── is_realtime rejects 0x00..0xF7 ──────────────────────────────────────
    let c = 0
    while c <= 0xF7
        let notok = is_realtime(c)
        if notok == true
            print("FAIL realtime is_realtime range: byte " + str(c) + " should be false")
            exit(1)
        c = c + 1

    // ── song_position boundary: max 16383 (0x3FFF) ───────────────────────────
    // 16383 = 0x3FFF
    // lsb7 = 16383 & 0x7F = 0x7F
    // msb7 = (16383 >> 7) & 0x7F = 127 & 0x7F = 0x7F
    let want_spmax = []
    push(want_spmax, 0xF2)
    push(want_spmax, 0x7F)
    push(want_spmax, 0x7F)
    let got_spmax = song_position(16383)
    if _lists_equal(got_spmax, want_spmax) == false
        print("FAIL realtime song_position(16383): got " + _list_str(got_spmax) + " want " + _list_str(want_spmax))
        exit(1)

    // ── song_position clamping: >16383 treated as 16383 ──────────────────────
    let got_spclamp = song_position(99999)
    if _lists_equal(got_spclamp, want_spmax) == false
        print("FAIL realtime song_position clamping: got " + _list_str(got_spclamp) + " want " + _list_str(want_spmax))
        exit(1)

    // ── song_select boundary: n=127 ──────────────────────────────────────────
    let want_ss127 = []
    push(want_ss127, 0xF3)
    push(want_ss127, 127)
    let got_ss127 = song_select(127)
    if _lists_equal(got_ss127, want_ss127) == false
        print("FAIL realtime song_select(127): got " + _list_str(got_ss127) + " want " + _list_str(want_ss127))
        exit(1)

    // ── mtc_quarter_frame: standard frame types ───────────────────────────────
    // type 0 (frame count LSB): 0xF1 0x00
    let want_mtc0 = []
    push(want_mtc0, 0xF1)
    push(want_mtc0, 0)
    let got_mtc0 = mtc_quarter_frame(0)
    if _lists_equal(got_mtc0, want_mtc0) == false
        print("FAIL realtime mtc_quarter_frame(0): got " + _list_str(got_mtc0) + " want " + _list_str(want_mtc0))
        exit(1)

    // type 7 (hours MSB + rate): 0xF1 0x70
    let want_mtc70 = []
    push(want_mtc70, 0xF1)
    push(want_mtc70, 0x70)
    let got_mtc70 = mtc_quarter_frame(0x70)
    if _lists_equal(got_mtc70, want_mtc70) == false
        print("FAIL realtime mtc_quarter_frame(0x70): got " + _list_str(got_mtc70) + " want " + _list_str(want_mtc70))
        exit(1)

    print("PASS _realtime_test")
