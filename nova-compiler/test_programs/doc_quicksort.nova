fn quicksort(arr: list) -> list
    if len(arr) <= 1
        return arr
    let pivot = arr[0]
    let less = []
    let greater = []
    let i = 1
    while i < len(arr)
        if arr[i] <= pivot
            push(less, arr[i])
        else
            push(greater, arr[i])
        i = i + 1
    let sorted_less = quicksort(less)
    let sorted_greater = quicksort(greater)
    push(sorted_less, pivot)
    let result = sorted_less
    for item in sorted_greater
        push(result, item)
    result

fn main()
    let data = [38, 27, 43, 3, 9, 82, 10]
    let sorted = quicksort(data)
    print(sorted)
