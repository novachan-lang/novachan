import std/gametheory/stone_game

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _stone_game_test " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gs = "false"
    if got
        gs = "true"
    let ws = "false"
    if want
        ws = "true"
    if got != want
        print("FAIL _stone_game_test " + label + ": got " + gs + " want " + ws)
        exit(1)

fn mk4() -> list
    let v = []
    push(v, 1)
    push(v, 2)
    push(v, 3)
    push(v, 4)
    v

fn mk3() -> list
    let v = []
    push(v, 1)
    push(v, 5)
    push(v, 2)
    v

fn mk1() -> list
    let v = []
    push(v, 5)
    v

fn main()
    // stg_margin([1,2,3,4]) = 2
    let v4 = mk4()
    cki("margin_1234", stg_margin(v4), 2)

    // stg_margin([1,5,2]) = -2
    let v3 = mk3()
    cki("margin_152", stg_margin(v3), -2)

    // stg_first_player_score([1,2,3,4]) = 6
    let v4b = mk4()
    cki("fps_1234", stg_first_player_score(v4b), 6)

    // stg_first_player_score([1,5,2]) = 3
    let v3b = mk3()
    cki("fps_152", stg_first_player_score(v3b), 3)

    // stg_first_wins([1,2,3,4]) = true
    let v4c = mk4()
    ckb("fw_1234", stg_first_wins(v4c), true)

    // stg_margin([5]) = 5
    let v1 = mk1()
    cki("margin_single_5", stg_margin(v1), 5)

    print("PASS _stone_game_test")
