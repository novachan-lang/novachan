import std/core/str

fn main() -> int
    let fails = 0
    if str_reverse("hello") != "olleh"
        print("FAIL reverse")
        fails = fails + 1
    if str_reverse("") != ""
        print("FAIL reverse empty")
        fails = fails + 1
    if str_repeat("ab", 3) != "ababab"
        print("FAIL repeat")
        fails = fails + 1
    if str_repeat("x", 0) != ""
        print("FAIL repeat 0")
        fails = fails + 1
    if str_pad_left("42", 5, "0") != "00042"
        print("FAIL pad_left")
        fails = fails + 1
    if str_pad_right("42", 5, ".") != "42..."
        print("FAIL pad_right")
        fails = fails + 1
    if str_pad_left("toolong", 3, "0") != "toolong"
        print("FAIL pad no-op")
        fails = fails + 1
    if str_count("banana", "a") != 3
        print("FAIL count a")
        fails = fails + 1
    if str_count("aaaa", "aa") != 2
        print("FAIL count non-overlap")
        fails = fails + 1
    if str_count("abc", "z") != 0
        print("FAIL count zero")
        fails = fails + 1
    if str_char_at("hello", 1) != "e"
        print("FAIL char_at")
        fails = fails + 1
    if str_char_at("hello", 99) != ""
        print("FAIL char_at oob")
        fails = fails + 1
    if fails == 0
        print("PASS _kat_str")
    else
        print("FAILED _kat_str")
    return 0
