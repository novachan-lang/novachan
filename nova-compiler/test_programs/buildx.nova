fn build_new()
  let b = {}
  b["targets"] = {}
  b["built"] = {}
  b["log"] = []
  b

fn build_target(b, name, deps, action)
  b["targets"][name] = {"deps": deps, "action": action}

fn build_run(b, target)
  if contains(b["built"], target)
    return ok("cached")
  if not contains(b["targets"], target)
    return err("unknown target: " + target)
  let t = b["targets"][target]
  let deps = t["deps"]
  for dep in deps
    let dep_result = build_run(b, dep)
    if is_err(dep_result)
      return dep_result
  let action = t["action"]
  let result = action(target)
  b["built"][target] = result
  push(b["log"], "built: " + target)
  ok(result)

fn build_log(b)
  b["log"]

fn build_clean(b)
  b["built"] = {}
  b["log"] = []

fn _compile_action(name)
  "compiled " + name

fn _link_action(name)
  "linked " + name

fn main()
  let b = build_new()
  build_target(b, "main.o", [], fn(z) _compile_action(z))
  build_target(b, "util.o", [], fn(z) _compile_action(z))
  build_target(b, "app", ["main.o", "util.o"], fn(z) _link_action(z))

  let r = build_run(b, "app")
  assert(is_ok(r), "build ok")
  assert(unwrap(r) == "linked app", "link result")

  let log = build_log(b)
  assert(len(log) == 3, "3 steps built")
  assert(log[0] == "built: main.o", "first dep")
  assert(log[1] == "built: util.o", "second dep")
  assert(log[2] == "built: app", "final target")

  let r2 = build_run(b, "app")
  assert(unwrap(r2) == "cached", "second build = cached")
  assert(len(build_log(b)) == 3, "no extra builds")

  let bad = build_run(b, "missing")
  assert(is_err(bad), "unknown target = err")

  build_clean(b)
  assert(len(build_log(b)) == 0, "cleaned")

  print("buildx: all passed")
