import std/text/soundex

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // Standard KAT vectors (US Census / Knuth)
    cks("Robert",   sx_soundex("Robert"),   "R163")
    cks("Rupert",   sx_soundex("Rupert"),   "R163")
    cks("Rubin",    sx_soundex("Rubin"),    "R150")
    cks("Ashcraft", sx_soundex("Ashcraft"), "A261")
    cks("Ashcroft", sx_soundex("Ashcroft"), "A261")
    cks("Tymczak",  sx_soundex("Tymczak"),  "T522")
    cks("Pfister",  sx_soundex("Pfister"),  "P236")
    cks("Honeyman", sx_soundex("Honeyman"), "H555")

    // Additional edge-case assertions
    // Short name — pad to 3 zeros
    cks("Lee",   sx_soundex("Lee"),   "L000")
    // All same code collapses
    cks("Lloyd", sx_soundex("Lloyd"), "L300")
    // Lowercase input handled
    cks("robert_lower", sx_soundex("robert"), "R163")
    // Single letter
    cks("A",     sx_soundex("A"),     "A000")

    print("_soundex_test passed")
