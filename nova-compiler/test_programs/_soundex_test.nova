import std/text/soundex

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ---- sx_encode: NARA canonical KAT vectors (spec-mandated) ----
    cks("encode_Robert",   sx_encode("Robert"),   "R163")
    cks("encode_Rupert",   sx_encode("Rupert"),   "R163")
    cks("encode_Rubin",    sx_encode("Rubin"),    "R150")
    cks("encode_Tymczak",  sx_encode("Tymczak"),  "T522")
    cks("encode_Honeyman", sx_encode("Honeyman"), "H555")
    cks("encode_Euler",    sx_encode("Euler"),    "E460")

    // ---- sx_matches: spec-mandated boolean checks ----
    cki("matches_Robert_Rupert", sx_matches("Robert", "Rupert"), 1)
    cki("matches_Robert_Rubin",  sx_matches("Robert", "Rubin"),  0)

    // ---- sx_soundex: backward-compat KAT vectors (original API) ----
    cks("soundex_Ashcraft", sx_soundex("Ashcraft"), "A261")
    cks("soundex_Ashcroft", sx_soundex("Ashcroft"), "A261")
    cks("soundex_Pfister",  sx_soundex("Pfister"),  "P236")
    cks("soundex_Lee",      sx_soundex("Lee"),      "L000")
    cks("soundex_Lloyd",    sx_soundex("Lloyd"),    "L300")
    cks("soundex_lower",    sx_soundex("robert"),   "R163")
    cks("soundex_single",   sx_soundex("A"),        "A000")

    print("_soundex_test passed")
