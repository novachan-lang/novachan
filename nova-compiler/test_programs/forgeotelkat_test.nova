// KAT for forge_otel — OTLP/HTTP (JSON) trace-export payload builder.
import forge_otel

fn main()
    // 1) attribute value wrapping: string -> stringValue, int -> intValue (STRING per proto3-JSON
    //    int64 rule), float -> doubleValue (native JSON number).
    assert_eq(json_stringify(otel_attr_value("GET")), "\{\"stringValue\":\"GET\"\}")
    assert_eq(json_stringify(otel_attr_value(42)), "\{\"intValue\":\"42\"\}")
    assert_eq(json_stringify(otel_attr_value(2.5)), "\{\"doubleValue\":2.5\}")

    // 2) otel_attributes preserves insertion order and wraps each value.
    let attrs = {}
    attrs["http.method"] = "GET"
    attrs["http.status_code"] = 200
    let attr_list = otel_attributes(attrs)
    assert_eq(len(attr_list), 2)
    assert_eq(json_stringify(attr_list), "[\{\"key\":\"http.method\",\"value\":\{\"stringValue\":\"GET\"\}\},\{\"key\":\"http.status_code\",\"value\":\{\"intValue\":\"200\"\}\}]")

    // 3) otel_status: explicit code, default code, and message passthrough.
    assert_eq(json_stringify(otel_status({"code": 1})), "\{\"code\":1\}")
    assert_eq(json_stringify(otel_status({})), "\{\"code\":0\}")
    assert_eq(json_stringify(otel_status({"code": 2, "message": "boom"})), "\{\"code\":2,\"message\":\"boom\"\}")

    // 4) full known-answer span (real-shaped W3C trace/span IDs, CLIENT kind, OK status).
    let span = {}
    span["trace_id"] = "5b8aa5a2d2c872e8321cf37308d69df2"
    span["span_id"] = "051581bf3cb55c13"
    span["name"] = "GET /users"
    span["kind"] = 3
    span["start_ns"] = 1544712660000000000
    span["end_ns"] = 1544712661000000000
    span["attributes"] = attrs
    span["status"] = {"code": 1}

    let span_json = json_stringify(otel_span(span))
    let expect_span = "\{\"traceId\":\"5b8aa5a2d2c872e8321cf37308d69df2\",\"spanId\":\"051581bf3cb55c13\",\"name\":\"GET /users\",\"kind\":3,\"startTimeUnixNano\":\"1544712660000000000\",\"endTimeUnixNano\":\"1544712661000000000\",\"attributes\":[\{\"key\":\"http.method\",\"value\":\{\"stringValue\":\"GET\"\}\},\{\"key\":\"http.status_code\",\"value\":\{\"intValue\":\"200\"\}\}],\"status\":\{\"code\":1\}\}"
    assert_eq(span_json, expect_span)
    // nanosecond timestamps are JSON STRINGS (int64 precision), not bare numbers.
    assert(find(span_json, "\"startTimeUnixNano\":\"1544712660000000000\"") >= 0, "start_ns must be a JSON string")
    assert(find(span_json, "\"startTimeUnixNano\":1544712660000000000,") < 0, "start_ns must not be a bare JSON number")

    // 5) full ExportTraceServiceRequest: resourceSpans -> scopeSpans -> spans nesting, with resource
    //    attributes and a named instrumentation scope.
    let resource_attrs = {}
    resource_attrs["service.name"] = "checkout"
    let full = otel_export_request([span], resource_attrs, "checkout-tracer")
    let expect_full = "\{\"resourceSpans\":[\{\"resource\":\{\"attributes\":[\{\"key\":\"service.name\",\"value\":\{\"stringValue\":\"checkout\"\}\}]\},\"scopeSpans\":[\{\"scope\":\{\"name\":\"checkout-tracer\"\},\"spans\":[" + expect_span + "]\}]\}]\}"
    assert_eq(full, expect_full)

    // 6) defaults: no resource attrs, no scope name, no kind/attributes/status on the span --
    //    kind defaults to 2 (SERVER), attributes to [], status to {"code":0} (UNSET).
    let bare_span = {}
    bare_span["trace_id"] = "00000000000000000000000000000001"
    bare_span["span_id"] = "0000000000000002"
    bare_span["name"] = "bare"
    bare_span["start_ns"] = 1
    bare_span["end_ns"] = 2
    let bare_full = otel_export_request([bare_span], {}, "")
    let expect_bare = "\{\"resourceSpans\":[\{\"resource\":\{\"attributes\":[]\},\"scopeSpans\":[\{\"scope\":\{\"name\":\"\"\},\"spans\":[\{\"traceId\":\"00000000000000000000000000000001\",\"spanId\":\"0000000000000002\",\"name\":\"bare\",\"kind\":2,\"startTimeUnixNano\":\"1\",\"endTimeUnixNano\":\"2\",\"attributes\":[],\"status\":\{\"code\":0\}\}]\}]\}]\}"
    assert_eq(bare_full, expect_bare)

    print("PASS forge_otel")
