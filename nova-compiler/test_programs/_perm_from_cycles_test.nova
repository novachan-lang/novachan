import std/permutation/perm_from_cycles

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn list_str(xs) -> string
    let s = "["
    let i = 0
    while i < len(xs)
        if i > 0
            s = s + ","
        s = s + str(xs[i])
        i = i + 1
    return s + "]"

fn ckl(label: string, got, want)
    if len(got) != len(want)
        print("FAIL " + label + ": got=" + list_str(got) + " want=" + list_str(want))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL " + label + ": got=" + list_str(got) + " want=" + list_str(want))
            exit(1)
        i = i + 1

fn cknest_row(label: string, got, want, row: int)
    ckl(label, got[row], want[row])

fn main()
    // --- pfc_from_cycles ---
    // single 3-cycle (0->1->2->0): result = [1,2,0]
    let fc1 = pfc_from_cycles([[0, 1, 2]], 3)
    ckl("from_cycles([[0,1,2]],3)", fc1, [1, 2, 0])

    // two 2-cycles (0,1) and (2,3): result = [1,0,3,2]
    let fc2 = pfc_from_cycles([[0, 1], [2, 3]], 4)
    ckl("from_cycles([[0,1],[2,3]],4)", fc2, [1, 0, 3, 2])

    // cycle [[1,2]] in n=3: 0 fixed, 1->2, 2->1 => [0,2,1]
    let fc3 = pfc_from_cycles([[1, 2]], 3)
    ckl("from_cycles([[1,2]],3)", fc3, [0, 2, 1])

    // empty cycles => identity
    let fc4 = pfc_from_cycles([], 3)
    ckl("from_cycles([],3)=identity", fc4, [0, 1, 2])

    // single-element cycle (fixed point) n=3: [0,1,2]
    let fc5 = pfc_from_cycles([[1]], 3)
    ckl("from_cycles([[1]],3)=identity", fc5, [0, 1, 2])

    // --- pfc_to_cycles ---
    // [1,2,0] has one 3-cycle (0,1,2)
    let tc1 = pfc_to_cycles([1, 2, 0])
    cki("to_cycles([1,2,0])_count", len(tc1), 1)
    ckl("to_cycles([1,2,0])[0]", tc1[0], [0, 1, 2])

    // [0,1,2] = identity = three fixed points => three 1-cycles
    let tc_id = pfc_to_cycles([0, 1, 2])
    cki("to_cycles(id)_count", len(tc_id), 3)
    ckl("to_cycles(id)[0]", tc_id[0], [0])
    ckl("to_cycles(id)[1]", tc_id[1], [1])
    ckl("to_cycles(id)[2]", tc_id[2], [2])

    // [1,0,3,2] = (0,1)(2,3) => two 2-cycles
    let tc2 = pfc_to_cycles([1, 0, 3, 2])
    cki("to_cycles([1,0,3,2])_count", len(tc2), 2)
    ckl("to_cycles([1,0,3,2])[0]", tc2[0], [0, 1])
    ckl("to_cycles([1,0,3,2])[1]", tc2[1], [2, 3])

    // roundtrip: from_cycles(to_cycles(p), n) = p
    let p_rt = [2, 0, 1, 4, 3]
    let cyc_rt = pfc_to_cycles(p_rt)
    let back_rt = pfc_from_cycles(cyc_rt, 5)
    ckl("roundtrip_[2,0,1,4,3]", back_rt, p_rt)

    // --- pfc_is_valid_cycles ---
    // [[0,1],[2]] covers {0,1,2} exactly once => true
    ckb("valid([[0,1],[2]],3)", pfc_is_valid_cycles([[0, 1], [2]], 3), true)

    // [[0,1,2]] covers {0,1,2} => true
    ckb("valid([[0,1,2]],3)", pfc_is_valid_cycles([[0, 1, 2]], 3), true)

    // [] covers nothing but n=0 => true
    ckb("valid([],0)", pfc_is_valid_cycles([], 0), true)

    // [[0,1]] for n=3 => element 2 missing => false
    ckb("invalid([[0,1]],3)", pfc_is_valid_cycles([[0, 1]], 3), false)

    // [[0,1],[0,2]] => element 0 appears twice => false
    ckb("invalid_dup([[0,1],[0,2]],3)", pfc_is_valid_cycles([[0, 1], [0, 2]], 3), false)

    // [[0,1,2],[3]] for n=4 => covers all => true
    ckb("valid([[0,1,2],[3]],4)", pfc_is_valid_cycles([[0, 1, 2], [3]], 4), true)

    print("PASS _perm_from_cycles_test")
