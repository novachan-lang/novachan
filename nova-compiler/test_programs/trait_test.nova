trait Shape
    fn area(self) -> float
    fn name(self) -> string

type Circle
    radius: float

type Rect
    width: float
    height: float

fn Circle.area() -> float
    3.14159 * self.radius * self.radius

fn Rect.area() -> float
    self.width * self.height

fn Circle.name() -> string
    "circle"

fn Rect.name() -> string
    "rect"

fn Circle.describe() -> string
    self.name() + "(r=" + str(self.radius) + ")"

fn Rect.describe() -> string
    self.name() + "(" + str(self.width) + "x" + str(self.height) + ")"

let c = Circle(5.0)
let r = Rect(3.0, 4.0)

print(c.describe())
print(r.describe())
print(str(c.area()))
print(str(r.area()))

type Square
    side: float

fn Square.area() -> float
    self.side * self.side

fn Square.name() -> string
    "square"

let s = Square(7.0)
print(s.name())
print(str(s.area()))
