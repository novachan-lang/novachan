// _zigzag_test.nova — KAT for std/bits/zigzag
//
// ZigZag encoding maps signed integers to non-negative unsigned codes so that
// small absolute values produce small codes, enabling efficient varint storage.
//
// Hand-traces:
//   encode(0):  (0<<1)^(0>>63)   = 0^0   = 0
//   encode(-1): (-1<<1)^(-1>>63) = -2^-1 = 1   (in two's complement)
//   encode(1):  (1<<1)^(1>>63)   = 2^0   = 2
//   encode(-2): (-2<<1)^(-2>>63) = -4^-1 = 3
//   encode(2):  (2<<1)^(2>>63)   = 4^0   = 4
//   decode(1):  q=0, odd → -(0)-1 = -1
//   decode(3):  q=1, odd → -(1)-1 = -2
//
//   sign_extend(15,4): 15=0b1111; mask=0b1111=15; sign_bit=8; 15&8=8≠0 → 15-16=-1
//   twos_complement(5,3): 5=0b101; mask=7; val=5; sign_bit=4; 5&4=4≠0 → 5-8=-3

import std/bits/zigzag

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL zigzag " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // --- zz_encode ---
    cki("encode_0",    zz_encode(0),  0)
    cki("encode_neg1", zz_encode(0 - 1), 1)
    cki("encode_1",    zz_encode(1),  2)
    cki("encode_neg2", zz_encode(0 - 2), 3)
    cki("encode_2",    zz_encode(2),  4)

    // Extended encode checks
    cki("encode_neg3", zz_encode(0 - 3), 5)
    cki("encode_3",    zz_encode(3),  6)
    cki("encode_127",  zz_encode(127), 254)
    cki("encode_neg128", zz_encode(0 - 128), 255)

    // --- zz_decode ---
    cki("decode_0", zz_decode(0), 0)
    cki("decode_1", zz_decode(1), 0 - 1)
    cki("decode_2", zz_decode(2), 1)
    cki("decode_3", zz_decode(3), 0 - 2)
    cki("decode_4", zz_decode(4), 2)
    cki("decode_5", zz_decode(5), 0 - 3)
    cki("decode_6", zz_decode(6), 3)
    cki("decode_254", zz_decode(254), 127)
    cki("decode_255", zz_decode(255), 0 - 128)

    // --- ROUND-TRIP: decode(encode(n)) == n ---
    cki("rt_0",       zz_decode(zz_encode(0)),          0)
    cki("rt_12345",   zz_decode(zz_encode(12345)),      12345)
    cki("rt_neg12345",zz_decode(zz_encode(0 - 12345)),  0 - 12345)
    cki("rt_1",       zz_decode(zz_encode(1)),          1)
    cki("rt_neg1",    zz_decode(zz_encode(0 - 1)),      0 - 1)
    cki("rt_1000000", zz_decode(zz_encode(1000000)),    1000000)
    cki("rt_neg999",  zz_decode(zz_encode(0 - 999)),    0 - 999)

    // --- zz_sign_extend ---
    // 4-bit sign-extension of 15 (0b1111): sign bit=8 is set → 15-16=-1
    cki("sign_ext_15_4",  zz_sign_extend(15, 4),  0 - 1)
    // 4-bit sign-extension of 7 (0b0111): sign bit=8 is clear → 7
    cki("sign_ext_7_4",   zz_sign_extend(7, 4),   7)
    // 4-bit sign-extension of 8 (0b1000): sign bit=8 set → 8-16=-8
    cki("sign_ext_8_4",   zz_sign_extend(8, 4),   0 - 8)
    // 8-bit sign-extension of 128 (0x80): sign bit=128 set → 128-256=-128
    cki("sign_ext_128_8", zz_sign_extend(128, 8), 0 - 128)
    // 8-bit sign-extension of 127 (0x7F): sign bit=128 clear → 127
    cki("sign_ext_127_8", zz_sign_extend(127, 8), 127)
    // 3-bit sign-extension of 3 (0b011): sign bit=4 clear → 3
    cki("sign_ext_3_3",   zz_sign_extend(3, 3),   3)
    // 3-bit sign-extension of 4 (0b100): sign bit=4 set → 4-8=-4
    cki("sign_ext_4_3",   zz_sign_extend(4, 3),   0 - 4)

    // --- zz_twos_complement ---
    // 3-bit: 5 (0b101) → sign bit=4 set → 5-8=-3
    cki("twos_comp_5_3", zz_twos_complement(5, 3), 0 - 3)
    // 3-bit: 3 (0b011) → sign bit=4 clear → 3
    cki("twos_comp_3_3", zz_twos_complement(3, 3), 3)
    // 4-bit: 12 (0b1100) → sign bit=8 set → 12-16=-4
    cki("twos_comp_12_4", zz_twos_complement(12, 4), 0 - 4)
    // 8-bit: 200 → sign bit=128 set → 200-256=-56
    cki("twos_comp_200_8", zz_twos_complement(200, 8), 0 - 56)
    // 8-bit: 100 → sign bit=128 clear → 100
    cki("twos_comp_100_8", zz_twos_complement(100, 8), 100)
    // 16-bit: 32768 (0x8000) → sign bit=32768 set → 32768-65536=-32768
    cki("twos_comp_32768_16", zz_twos_complement(32768, 16), 0 - 32768)

    print("PASS _zigzag_test")
