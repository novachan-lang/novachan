import std/bits/bittricks

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL bittricks " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let g = "false"
        if got
            g = "true"
        let w = "false"
        if want
            w = "true"
        print("FAIL bittricks " + label + ": got=" + g + " want=" + w)
        exit(1)

fn main()
    // tk_abs
    cki("abs(-5)", tk_abs(0 - 5), 5)
    cki("abs(5)", tk_abs(5), 5)
    cki("abs(0)", tk_abs(0), 0)
    cki("abs(-1)", tk_abs(0 - 1), 1)
    cki("abs(-2147483648)", tk_abs(0 - 2147483648), 2147483648)

    // tk_sign
    cki("sign(-3)", tk_sign(0 - 3), 0 - 1)
    cki("sign(0)", tk_sign(0), 0)
    cki("sign(9)", tk_sign(9), 1)
    cki("sign(-1)", tk_sign(0 - 1), 0 - 1)
    cki("sign(1)", tk_sign(1), 1)

    // tk_is_opposite_sign
    ckb("opp(-1,1)", tk_is_opposite_sign(0 - 1, 1), true)
    ckb("opp(3,4)", tk_is_opposite_sign(3, 4), false)
    ckb("opp(-5,-3)", tk_is_opposite_sign(0 - 5, 0 - 3), false)
    ckb("opp(0,0)", tk_is_opposite_sign(0, 0), false)

    // tk_average (non-negative inputs)
    cki("avg(4,8)", tk_average(4, 8), 6)
    cki("avg(6,9)", tk_average(6, 9), 7)
    cki("avg(0,0)", tk_average(0, 0), 0)
    cki("avg(0,1)", tk_average(0, 1), 0)
    cki("avg(1,1)", tk_average(1, 1), 1)
    // Large values: overflow-safe test — (2^30 + 2^30) == 2^30
    cki("avg(big)", tk_average(1073741824, 1073741824), 1073741824)

    // tk_min
    cki("min(3,7)", tk_min(3, 7), 3)
    cki("min(7,3)", tk_min(7, 3), 3)
    cki("min(5,5)", tk_min(5, 5), 5)
    cki("min(-1,1)", tk_min(0 - 1, 1), 0 - 1)
    cki("min(0,0)", tk_min(0, 0), 0)

    // tk_max
    cki("max(3,7)", tk_max(3, 7), 7)
    cki("max(7,3)", tk_max(7, 3), 7)
    cki("max(5,5)", tk_max(5, 5), 5)
    cki("max(-1,1)", tk_max(0 - 1, 1), 1)
    cki("max(0,0)", tk_max(0, 0), 0)

    // tk_conditional_negate
    cki("condneg(5,1)", tk_conditional_negate(5, 1), 0 - 5)
    cki("condneg(5,0)", tk_conditional_negate(5, 0), 5)
    cki("condneg(-3,1)", tk_conditional_negate(0 - 3, 1), 3)
    cki("condneg(0,1)", tk_conditional_negate(0, 1), 0)
    cki("condneg(0,0)", tk_conditional_negate(0, 0), 0)

    print("PASS _bittricks_test")
