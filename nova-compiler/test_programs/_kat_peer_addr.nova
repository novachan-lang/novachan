// KAT F-1: the real TCP peer address must be reachable from NOVA.
// Before this, tcp_accept filled a sockaddr_in and DISCARDED it, so mw_rate_limit could
// only key on the client-supplied X-Forwarded-For header -- a fresh random XFF per
// request meant the limiter never engaged, and also forced unlimited PBKDF2 work.
let ready = channel()
let result = channel()

fn server(port: int)
    let srv = tcp_listen(port)
    send(ready, 1)
    let c = tcp_accept(srv)
    let ip = tcp_peer_addr(c)
    let pt = tcp_peer_port(c)
    send(result, ip + "|" + str(pt))
    tcp_close(c)
    tcp_close(srv)

fn main()
    let port = 19731
    let p = port
    spawn fn()
        server(p)
    recv(ready)
    let s = tcp_connect("127.0.0.1", p)
    let got = recv(result)
    tcp_close(s)
    let parts = split(got, "|")
    let ip = parts[0]
    let pt = parts[1]
    print("peer = " + ip + " port = " + pt)
    let ok = 0
    let fail = 0
    if ip == "127.0.0.1"
        ok = ok + 1
        print("ok: real peer IP recovered from the accepted socket")
    else
        fail = fail + 1
        print("FAIL peer IP was '" + ip + "', expected 127.0.0.1")
    if int(pt) > 0
        ok = ok + 1
        print("ok: peer port is a real ephemeral port")
    else
        fail = fail + 1
        print("FAIL peer port was " + pt)
    if fail == 0
        print("KAT peer_addr PASS")
    else
        print("KAT peer_addr FAIL")
