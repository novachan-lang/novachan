// KAT test for std/util/progress.nova — progress bar/spinner rendering.
// API under test: prog_percent/prog_bar/prog_spinner.
// NOTE: filename is `_utilprogress_test` (not `_progress_test`) because `_progress_test.nova` already
// exists and covers a DIFFERENT module (std/term/progress.nova, bar/bar_chars/pct_str/gauge). This test
// targets std/util/progress.nova (prog_percent/prog_bar/prog_spinner) — do not merge the two.
import std/util/progress

fn _fail_int(name: string, got: int, want: int)
    print("FAIL " + name + ": got " + str(got) + " want " + str(want))
    exit(1)

fn _fail_str(name: string, got: string, want: string)
    print("FAIL " + name + ": got [" + got + "] want [" + want + "]")
    exit(1)

fn main()
    // ── prog_percent: integer percent, floor, clamped to [0,100] ─────────
    if prog_percent(30, 100) != 30
        _fail_int("prog_percent(30,100)", prog_percent(30, 100), 30)
    if prog_percent(0, 100) != 0
        _fail_int("prog_percent(0,100)", prog_percent(0, 100), 0)
    if prog_percent(100, 100) != 100
        _fail_int("prog_percent(100,100)", prog_percent(100, 100), 100)
    if prog_percent(1, 3) != 33
        _fail_int("prog_percent(1,3) floor", prog_percent(1, 3), 33)
    if prog_percent(150, 100) != 100
        _fail_int("prog_percent(150,100) clamp-high", prog_percent(150, 100), 100)
    if prog_percent(-20, 100) != 0
        _fail_int("prog_percent(-20,100) clamp-low", prog_percent(-20, 100), 0)
    if prog_percent(50, 0) != 0
        _fail_int("prog_percent(50,0) total<=0", prog_percent(50, 0), 0)
    if prog_percent(5, 0) != 0
        _fail_int("prog_percent(5,-1-ish total 0)", prog_percent(5, 0), 0)

    // ── prog_bar: width chars of "#"/"-" then " NN%" ──────────────────────
    // 5/10 at width 10 -> 50%, 5 filled, 5 empty.
    let b1 = prog_bar(5, 10, 10)
    if b1 != "#####----- 50%"
        _fail_str("prog_bar(5,10,10)", b1, "#####----- 50%")

    // 0/10 at width 10 -> 0%, all empty.
    let b2 = prog_bar(0, 10, 10)
    if b2 != "---------- 0%"
        _fail_str("prog_bar(0,10,10)", b2, "---------- 0%")

    // 10/10 at width 10 -> 100%, all filled.
    let b3 = prog_bar(10, 10, 10)
    if b3 != "########## 100%"
        _fail_str("prog_bar(10,10,10)", b3, "########## 100%")

    // 3/10 at width 5 -> 30%, filled = (30*5)/100 = 1 (integer floor).
    let b4 = prog_bar(3, 10, 5)
    if b4 != "#---- 30%"
        _fail_str("prog_bar(3,10,5)", b4, "#---- 30%")

    // ── prog_spinner: |,/,-,\ cycling by frame % 4 ─────────────────────────
    let bs = chr(92)
    if prog_spinner(0) != "|"
        _fail_str("prog_spinner(0)", prog_spinner(0), "|")
    if prog_spinner(1) != "/"
        _fail_str("prog_spinner(1)", prog_spinner(1), "/")
    if prog_spinner(2) != "-"
        _fail_str("prog_spinner(2)", prog_spinner(2), "-")
    if prog_spinner(3) != bs
        _fail_str("prog_spinner(3)", prog_spinner(3), bs)
    // cycles: frame 4 wraps back to frame 0's char, frame 7 wraps to frame 3's char.
    if prog_spinner(4) != "|"
        _fail_str("prog_spinner(4) wraps to |", prog_spinner(4), "|")
    if prog_spinner(7) != bs
        _fail_str("prog_spinner(7) wraps to backslash", prog_spinner(7), bs)

    print("PASS _utilprogress_test")
