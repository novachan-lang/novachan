import forge_limits

fn main()
    // ── request size caps ──
    assert(forge_limits.limit_body_ok(500, 1000) == 1, "body within cap ok")
    assert(forge_limits.limit_body_ok(1000, 1000) == 1, "body at cap ok")
    assert(forge_limits.limit_body_ok(2000, 1000) == 0, "body over cap rejected")
    assert(forge_limits.limit_body_ok(-1, 1000) == 0, "negative content-length rejected")
    assert(forge_limits.limit_line_ok("short", 100) == 1, "short line ok")
    assert(forge_limits.limit_line_ok("toolong", 3) == 0, "long line rejected")
    assert(forge_limits.limit_headers_ok(20, 50) == 1, "header count ok")
    assert(forge_limits.limit_headers_ok(80, 50) == 0, "too many headers rejected")

    // ── token bucket: capacity 2, refill 1 token/sec (0.001/ms) ──
    let b = forge_limits.rate_new(2.0, 0.001)
    assert(forge_limits.rate_allow(b, 0, 1.0) == 1, "1st request allowed")
    assert(forge_limits.rate_allow(b, 0, 1.0) == 1, "2nd request allowed (bucket drained)")
    assert(forge_limits.rate_allow(b, 0, 1.0) == 0, "3rd request rate-limited")
    assert(forge_limits.rate_allow(b, 1000, 1.0) == 1, "after 1s refill, allowed again")
    assert(forge_limits.rate_allow(b, 1000, 1.0) == 0, "but only one refilled token")
    // burst cannot exceed capacity even after a long idle
    let b2 = forge_limits.rate_new(2.0, 0.001)
    assert(forge_limits.rate_allow(b2, 100000, 1.0) == 1, "long-idle refill capped: allow 1")
    assert(forge_limits.rate_allow(b2, 100000, 1.0) == 1, "allow 2 (capacity)")
    assert(forge_limits.rate_allow(b2, 100000, 1.0) == 0, "capacity is the burst ceiling")

    // ── connection guard: max 2 ──
    let g = forge_limits.conn_new(2)
    assert(forge_limits.conn_acquire(g) == 1, "acquire 1")
    assert(forge_limits.conn_acquire(g) == 1, "acquire 2")
    assert(forge_limits.conn_acquire(g) == 0, "acquire 3 rejected (at capacity)")
    assert(forge_limits.conn_count(g) == 2, "count is 2")
    forge_limits.conn_release(g)
    assert(forge_limits.conn_count(g) == 1, "released -> 1")
    assert(forge_limits.conn_acquire(g) == 1, "slot freed -> acquire ok")
    // release never goes negative
    forge_limits.conn_release(g)
    forge_limits.conn_release(g)
    forge_limits.conn_release(g)
    assert(forge_limits.conn_count(g) == 0, "release floors at 0")

    print("forge_limits_lib_test: all passed")
