import forge_geo_fence

fn main()
    let gf = gf_new()
    gf = gf_add_zone(gf, "downtown", 40, -74, 41, -73)
    gf = gf_add_zone(gf, "suburbs", 39, -75, 42, -72)
    gf = gf_add_zone(gf, "airport", 40, -74, 40, -73)
    assert(gf_zone_count(gf) == 3, "3 zones")

    assert(gf_contains(gf, "downtown", 40, -74) == 1, "in downtown")
    assert(gf_contains(gf, "downtown", 50, -74) == 0, "outside downtown")

    let zones = gf_zones_at(gf, 40, -74)
    assert(len(zones) >= 2, "in multiple zones")

    let empty = gf_zones_at(gf, 0, 0)
    assert(len(empty) == 0, "no zones at 0,0")

    let z = gf_get_zone(gf, "downtown")
    assert(z["name"] == "downtown", "got zone")
    assert(z["min_lat"] == 40, "min_lat correct")

    let missing = gf_get_zone(gf, "nope")
    assert(missing["name"] == "", "missing zone")

    assert(gf_contains(gf, "nonexistent", 40, -74) == 0, "nonexistent zone")

    print("GEO-FENCE KAT PASS")
