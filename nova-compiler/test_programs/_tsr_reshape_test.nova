import std/tensor/tsr_reshape

// cki — check int equality.
fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckl — check two int lists element-by-element.
fn ckl(label, got, want)
    let ok = true
    if len(got) != len(want)
        ok = false
    if ok
        let i = 0
        while i < len(want)
            if got[i] != want[i]
                ok = false
            i = i + 1
    if not ok
        print("FAIL " + label + ": list mismatch")
        exit(1)

// ckt — check tensor flat and shape.
fn ckt(label, t, want_flat, want_shape)
    let flat = t[0]
    let shape = t[1]
    let ok = true
    if len(flat) != len(want_flat)
        ok = false
    if ok
        let i = 0
        while i < len(want_flat)
            if flat[i] != want_flat[i]
                ok = false
            i = i + 1
    if ok
        if len(shape) != len(want_shape)
            ok = false
    if ok
        let i = 0
        while i < len(want_shape)
            if shape[i] != want_shape[i]
                ok = false
            i = i + 1
    if not ok
        print("FAIL " + label + ": tensor mismatch")
        exit(1)

fn main()
    // tr_reshape([[0,1,2,3,4,5],[2,3]], [3,2]) -> flat=[0,1,2,3,4,5] shape=[3,2]
    let flat1 = []
    push(flat1, 0)
    push(flat1, 1)
    push(flat1, 2)
    push(flat1, 3)
    push(flat1, 4)
    push(flat1, 5)
    let shape1 = []
    push(shape1, 2)
    push(shape1, 3)
    let t1 = []
    push(t1, flat1)
    push(t1, shape1)
    let new_sh1 = []
    push(new_sh1, 3)
    push(new_sh1, 2)
    let r1 = tr_reshape(t1, new_sh1)
    let wf1 = []
    push(wf1, 0)
    push(wf1, 1)
    push(wf1, 2)
    push(wf1, 3)
    push(wf1, 4)
    push(wf1, 5)
    let ws1 = []
    push(ws1, 3)
    push(ws1, 2)
    ckt("reshape_2x3_to_3x2", r1, wf1, ws1)

    // tr_flatten([[1,2,3,4],[2,2]]) -> flat=[1,2,3,4] shape=[4]
    let flat2 = []
    push(flat2, 1)
    push(flat2, 2)
    push(flat2, 3)
    push(flat2, 4)
    let shape2 = []
    push(shape2, 2)
    push(shape2, 2)
    let t2 = []
    push(t2, flat2)
    push(t2, shape2)
    let r2 = tr_flatten(t2)
    let wf2 = []
    push(wf2, 1)
    push(wf2, 2)
    push(wf2, 3)
    push(wf2, 4)
    let ws2 = []
    push(ws2, 4)
    ckt("flatten_2x2", r2, wf2, ws2)

    // tr_ravel([[1,2,3,4],[2,2]]) == [1,2,3,4]
    let flat3 = []
    push(flat3, 1)
    push(flat3, 2)
    push(flat3, 3)
    push(flat3, 4)
    let shape3 = []
    push(shape3, 2)
    push(shape3, 2)
    let t3 = []
    push(t3, flat3)
    push(t3, shape3)
    let r3 = tr_ravel(t3)
    let wr3 = []
    push(wr3, 1)
    push(wr3, 2)
    push(wr3, 3)
    push(wr3, 4)
    ckl("ravel_2x2", r3, wr3)

    // tr_expand_dims([[1,2,3],[3]], 0) -> flat=[1,2,3] shape=[1,3]
    let flat4 = []
    push(flat4, 1)
    push(flat4, 2)
    push(flat4, 3)
    let shape4 = []
    push(shape4, 3)
    let t4 = []
    push(t4, flat4)
    push(t4, shape4)
    let r4 = tr_expand_dims(t4, 0)
    let wf4 = []
    push(wf4, 1)
    push(wf4, 2)
    push(wf4, 3)
    let ws4 = []
    push(ws4, 1)
    push(ws4, 3)
    ckt("expand_dims_axis0", r4, wf4, ws4)

    // tr_expand_dims([[1,2,3],[3]], 1) -> flat=[1,2,3] shape=[3,1]
    let flat5 = []
    push(flat5, 1)
    push(flat5, 2)
    push(flat5, 3)
    let shape5 = []
    push(shape5, 3)
    let t5 = []
    push(t5, flat5)
    push(t5, shape5)
    let r5 = tr_expand_dims(t5, 1)
    let ws5 = []
    push(ws5, 3)
    push(ws5, 1)
    let wf5 = []
    push(wf5, 1)
    push(wf5, 2)
    push(wf5, 3)
    ckt("expand_dims_axis1", r5, wf5, ws5)

    // tr_squeeze([[1,2,3],[1,3,1]]) -> flat=[1,2,3] shape=[3]
    let flat6 = []
    push(flat6, 1)
    push(flat6, 2)
    push(flat6, 3)
    let shape6 = []
    push(shape6, 1)
    push(shape6, 3)
    push(shape6, 1)
    let t6 = []
    push(t6, flat6)
    push(t6, shape6)
    let r6 = tr_squeeze(t6)
    let wf6 = []
    push(wf6, 1)
    push(wf6, 2)
    push(wf6, 3)
    let ws6 = []
    push(ws6, 3)
    ckt("squeeze_1x3x1", r6, wf6, ws6)

    // tr_squeeze of a shape with no size-1 dims is unchanged
    let flat7 = []
    push(flat7, 1)
    push(flat7, 2)
    push(flat7, 3)
    push(flat7, 4)
    let shape7 = []
    push(shape7, 2)
    push(shape7, 2)
    let t7 = []
    push(t7, flat7)
    push(t7, shape7)
    let r7 = tr_squeeze(t7)
    let sh7 = r7[1]
    cki("squeeze_no_ones_len", len(sh7), 2)
    cki("squeeze_no_ones_0", sh7[0], 2)
    cki("squeeze_no_ones_1", sh7[1], 2)

    // tr_reshape with mismatched size returns original tensor unchanged
    let flat8 = []
    push(flat8, 0)
    push(flat8, 1)
    push(flat8, 2)
    push(flat8, 3)
    let shape8 = []
    push(shape8, 4)
    let t8 = []
    push(t8, flat8)
    push(t8, shape8)
    let bad_sh8 = []
    push(bad_sh8, 3)
    push(bad_sh8, 3)
    let r8 = tr_reshape(t8, bad_sh8)
    let s8 = r8[1]
    // shape should still be [4] (returned unchanged)
    cki("reshape_mismatch_ndim", len(s8), 1)
    cki("reshape_mismatch_dim0", s8[0], 4)

    // tr_flatten of a 1-D tensor [n] -> [n]
    let flat9 = []
    push(flat9, 5)
    push(flat9, 6)
    push(flat9, 7)
    let shape9 = []
    push(shape9, 3)
    let t9 = []
    push(t9, flat9)
    push(t9, shape9)
    let r9 = tr_flatten(t9)
    let s9 = r9[1]
    cki("flatten_1d_shape_len", len(s9), 1)
    cki("flatten_1d_shape_0", s9[0], 3)

    // tr_squeeze all-ones shape -> scalar shape []
    let flat10 = []
    push(flat10, 42)
    let shape10 = []
    push(shape10, 1)
    push(shape10, 1)
    push(shape10, 1)
    let t10 = []
    push(t10, flat10)
    push(t10, shape10)
    let r10 = tr_squeeze(t10)
    let s10 = r10[1]
    cki("squeeze_all_ones", len(s10), 0)

    print("PASS _tsr_reshape_test")
