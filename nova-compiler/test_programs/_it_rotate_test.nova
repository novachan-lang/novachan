import std/itertools/it_rotate

// ── helpers ────────────────────────────────────────────────────────────────

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckflat(label: string, got, want_len: int)
    let gl = len(got)
    if gl != want_len
        print("FAIL " + label + " len: got=" + str(gl) + " want=" + str(want_len))
        exit(1)

fn ckelem(label: string, got, i: int, want: int)
    let v = got[i]
    if v != want
        print("FAIL " + label + "[" + str(i) + "]: got=" + str(v) + " want=" + str(want))
        exit(1)

fn main()
    // ── itr_rotate_left ──────────────────────────────────────────────────────
    // [1,2,3,4,5] rotate_left 2 = [3,4,5,1,2]
    let rl2 = itr_rotate_left([1, 2, 3, 4, 5], 2)
    ckflat("rl2", rl2, 5)
    ckelem("rl2", rl2, 0, 3)
    ckelem("rl2", rl2, 1, 4)
    ckelem("rl2", rl2, 2, 5)
    ckelem("rl2", rl2, 3, 1)
    ckelem("rl2", rl2, 4, 2)

    // [1,2,3] rotate_left 3 = [1,2,3] (full rotation = identity)
    let rl3 = itr_rotate_left([1, 2, 3], 3)
    ckflat("rl3_identity", rl3, 3)
    ckelem("rl3_identity", rl3, 0, 1)
    ckelem("rl3_identity", rl3, 1, 2)
    ckelem("rl3_identity", rl3, 2, 3)

    // [1,2,3] rotate_left 5 = rotate_left 2 = [3,1,2]
    let rl5 = itr_rotate_left([1, 2, 3], 5)
    ckflat("rl5_mod", rl5, 3)
    ckelem("rl5_mod", rl5, 0, 3)
    ckelem("rl5_mod", rl5, 1, 1)
    ckelem("rl5_mod", rl5, 2, 2)

    // empty list
    let rle = itr_rotate_left([], 3)
    cki("rotate_left_empty", len(rle), 0)

    // k=0 = identity
    let rl0 = itr_rotate_left([10, 20, 30], 0)
    ckelem("rotate_left_k0", rl0, 0, 10)
    ckelem("rotate_left_k0", rl0, 1, 20)
    ckelem("rotate_left_k0", rl0, 2, 30)

    // ── itr_rotate_right ─────────────────────────────────────────────────────
    // [1,2,3,4,5] rotate_right 2 = [4,5,1,2,3]
    let rr2 = itr_rotate_right([1, 2, 3, 4, 5], 2)
    ckflat("rr2", rr2, 5)
    ckelem("rr2", rr2, 0, 4)
    ckelem("rr2", rr2, 1, 5)
    ckelem("rr2", rr2, 2, 1)
    ckelem("rr2", rr2, 3, 2)
    ckelem("rr2", rr2, 4, 3)

    // full rotation = identity
    let rr5 = itr_rotate_right([1, 2, 3, 4, 5], 5)
    ckelem("rr5_identity", rr5, 0, 1)
    ckelem("rr5_identity", rr5, 4, 5)

    // empty
    cki("rotate_right_empty", len(itr_rotate_right([], 2)), 0)

    // ── itr_cycle_take ───────────────────────────────────────────────────────
    // cycle_take([1,2,3], 7) = [1,2,3,1,2,3,1]
    let ct = itr_cycle_take([1, 2, 3], 7)
    ckflat("cycle_take_7", ct, 7)
    ckelem("cycle_take_7", ct, 0, 1)
    ckelem("cycle_take_7", ct, 1, 2)
    ckelem("cycle_take_7", ct, 2, 3)
    ckelem("cycle_take_7", ct, 3, 1)
    ckelem("cycle_take_7", ct, 4, 2)
    ckelem("cycle_take_7", ct, 5, 3)
    ckelem("cycle_take_7", ct, 6, 1)

    // exactly one period
    let ct3 = itr_cycle_take([1, 2, 3], 3)
    ckflat("cycle_take_3", ct3, 3)
    ckelem("cycle_take_3", ct3, 2, 3)

    // n=0 returns []
    cki("cycle_take_n0", len(itr_cycle_take([1, 2, 3], 0)), 0)

    // empty xs returns []
    cki("cycle_take_empty_xs", len(itr_cycle_take([], 5)), 0)

    // take from single-element xs
    let ct_single = itr_cycle_take([42], 4)
    ckflat("cycle_single", ct_single, 4)
    ckelem("cycle_single", ct_single, 0, 42)
    ckelem("cycle_single", ct_single, 3, 42)

    // ── itr_reverse ──────────────────────────────────────────────────────────
    // [1,2,3] -> [3,2,1]
    let rev = itr_reverse([1, 2, 3])
    ckflat("reverse_3", rev, 3)
    ckelem("reverse_3", rev, 0, 3)
    ckelem("reverse_3", rev, 1, 2)
    ckelem("reverse_3", rev, 2, 1)

    // single element
    let rev1 = itr_reverse([99])
    ckflat("reverse_1", rev1, 1)
    ckelem("reverse_1", rev1, 0, 99)

    // empty
    cki("reverse_empty", len(itr_reverse([])), 0)

    // round-trip: reverse(reverse(xs)) == xs
    let orig = [5, 3, 1, 4, 2]
    let rt = itr_reverse(itr_reverse(orig))
    ckflat("reverse_roundtrip", rt, 5)
    ckelem("reverse_roundtrip", rt, 0, 5)
    ckelem("reverse_roundtrip", rt, 1, 3)
    ckelem("reverse_roundtrip", rt, 2, 1)
    ckelem("reverse_roundtrip", rt, 3, 4)
    ckelem("reverse_roundtrip", rt, 4, 2)

    print("PASS _it_rotate_test")
