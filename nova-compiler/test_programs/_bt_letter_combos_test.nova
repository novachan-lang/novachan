import std/backtracking/bt_letter_combos

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _bt_letter_combos_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL _bt_letter_combos_test " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL _bt_letter_combos_test " + label + ": got=" + got + " want=" + want)
        exit(1)

// contains_str — true if the list of strings contains needle.
fn contains_str(lst, needle: string) -> bool
    let i = 0
    while i < len(lst)
        if lst[i] == needle
            return true
        i = i + 1
    false

fn main()
    // --- lc_count ---
    cki("count_empty", lc_count(""), 0)
    cki("count_2", lc_count("2"), 3)
    cki("count_7", lc_count("7"), 4)
    cki("count_23", lc_count("23"), 9)
    cki("count_79", lc_count("79"), 16)
    // "237": 3 * 3 * 4 = 36
    cki("count_237", lc_count("237"), 36)
    // "29": 3 * 4 = 12
    cki("count_29", lc_count("29"), 12)

    // --- lc_solve ---
    // Empty digits => empty list
    let s0 = lc_solve("")
    cki("solve_empty_len", len(s0), 0)

    // Single digit "2" => ["a","b","c"] in that exact order (depth-first, letters ascending)
    let s2 = lc_solve("2")
    cki("solve_2_len", len(s2), 3)
    cks("solve_2_0", s2[0], "a")
    cks("solve_2_1", s2[1], "b")
    cks("solve_2_2", s2[2], "c")

    // Single digit "7" => ["p","q","r","s"]
    let s7 = lc_solve("7")
    cki("solve_7_len", len(s7), 4)
    cks("solve_7_0", s7[0], "p")
    cks("solve_7_1", s7[1], "q")
    cks("solve_7_2", s7[2], "r")
    cks("solve_7_3", s7[3], "s")

    // "23" => 9 combinations; check len and spot-check first/last + "ad"/"cf"
    let s23 = lc_solve("23")
    cki("solve_23_len", len(s23), 9)
    // DFS: first letter of 2='a', then all of 3='d','e','f' → "ad","ae","af"
    // then 'b': "bd","be","bf"; then 'c': "cd","ce","cf"
    cks("solve_23_0", s23[0], "ad")
    cks("solve_23_1", s23[1], "ae")
    cks("solve_23_2", s23[2], "af")
    cks("solve_23_8", s23[8], "cf")
    ckb("solve_23_has_ad", contains_str(s23, "ad"), true)
    ckb("solve_23_has_cf", contains_str(s23, "cf"), true)

    // "79": 4*4=16 combinations
    let s79 = lc_solve("79")
    cki("solve_79_len", len(s79), 16)
    // First: 'p' + 'w' = "pw"
    cks("solve_79_0", s79[0], "pw")
    // Last: 's' + 'z' = "sz"
    cks("solve_79_15", s79[15], "sz")

    print("PASS _bt_letter_combos_test")
