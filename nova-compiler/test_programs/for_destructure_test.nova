fn main()
    // Enumerate with tuple destructuring
    let items = ["a", "b", "c"]
    let result = []
    for (i, x) in enumerate(items)
        push(result, str(i) + ":" + x)
    assert_eq(result[0], "0:a")
    assert_eq(result[1], "1:b")
    assert_eq(result[2], "2:c")

    // List of pairs
    let pairs = [[1, "one"], [2, "two"], [3, "three"]]
    let names = []
    for (num, name) in pairs
        push(names, str(num) + "=" + name)
    assert_eq(names[0], "1=one")
    assert_eq(names[2], "3=three")

    // Triple destructuring
    let triples = [[1, 2, 3], [4, 5, 6]]
    let sums = []
    for (a, b, c) in triples
        push(sums, a + b + c)
    assert_eq(sums[0], 6)
    assert_eq(sums[1], 15)

    // With for/else
    let found = false
    for (i, x) in enumerate(["cat", "dog", "fish"])
        if x == "dog"
            found = true
            assert_eq(i, 1)
            break
    else
        assert_true(false)
    assert_true(found)

    print("for_destructure_test: all passed")
