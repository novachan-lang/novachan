// NOVA Edge v0.1 demo: bit manipulation + hex byte encoding + cpu count.
// These are the primitives a microcontroller-flavored NOVA program
// would need before being compiled to an embedded target. We verify on
// the host first since the embedded backend lands in v0.2+.
import edge

fn main()
    // 1. cores returns at least 1
    let n_cores = edge.cores()
    if n_cores < 1
        print("FAIL cores < 1")
        exit(1)

    // 2. bit operations
    assert_eq(edge.bit_set(0, 3), 8)
    assert_eq(edge.bit_set(8, 0), 9)
    assert_eq(edge.bit_clear(15, 1), 13)
    assert_eq(edge.bit_test(8, 3), 1)
    assert_eq(edge.bit_test(8, 0), 0)

    // 3. hex_byte
    assert_eq(edge.hex_byte(0), "00")
    assert_eq(edge.hex_byte(255), "FF")
    assert_eq(edge.hex_byte(171), "AB")
    assert_eq(edge.hex_byte(16), "10")

    // 4. bytes_to_hex
    assert_eq(edge.bytes_to_hex([222, 173, 190, 239]), "DEADBEEF")
    assert_eq(edge.bytes_to_hex([0, 1, 255]), "0001FF")

    // 5. byte_at
    assert_eq(edge.byte_at(0x12345678, 0), 0x78)
    assert_eq(edge.byte_at(0x12345678, 1), 0x56)
    assert_eq(edge.byte_at(0x12345678, 2), 0x34)
    assert_eq(edge.byte_at(0x12345678, 3), 0x12)

    print("EDGE v0.1 demo passed: cores, bit_set/clear/test, hex_byte, bytes_to_hex, byte_at all verified — embedded-style primitives ready")
