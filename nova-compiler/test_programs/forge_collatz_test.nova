import forge_collatz

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn joinl(xs: list) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + ","
        out = out + str(xs[i])
        i = i + 1
    out

// str() of a BOOLEAN renders true/false, not 1/0. These assertions expected "1" -- the
// behaviour from before str() learned the bool path (print already had it; str did not). When
// that was fixed the assertions started failing, and nothing noticed: they print FAIL and
// exit 0, which the regression harness counted as a PASS until 2026-08-25.
fn main()
    let fails = 0

    // steps
    fails = fails + expect("steps1", str(collatz_steps(1)), "0")
    fails = fails + expect("steps6", str(collatz_steps(6)), "8")
    fails = fails + expect("steps27", str(collatz_steps(27)), "111")
    fails = fails + expect("steps7", str(collatz_steps(7)), "16")
    fails = fails + expect("steps2", str(collatz_steps(2)), "1")

    // sequence
    fails = fails + expect("seq6", joinl(collatz_sequence(6)), "6,3,10,5,16,8,4,2,1")
    fails = fails + expect("seq1", joinl(collatz_sequence(1)), "1")
    // sequence length = steps + 1
    fails = fails + expect("seqlen", str(len(collatz_sequence(27)) == collatz_steps(27) + 1),"true")

    // peak
    fails = fails + expect("max27", str(collatz_max(27)), "9232")
    fails = fails + expect("max6", str(collatz_max(6)), "16")
    fails = fails + expect("max1", str(collatz_max(1)), "1")
    fails = fails + expect("max7", str(collatz_max(7)), "52")

    // consistency: last of sequence is always 1
    let allone = 1
    let n = 1
    while n <= 50
        let s = collatz_sequence(n)
        if s[len(s) - 1] != 1
            allone = 0
        n = n + 1
    fails = fails + expect("always_reaches_1", str(allone), "1")

    if fails == 0
        print("forge_collatz: all passed")
    else
        print("forge_collatz: " + str(fails) + " FAILED")
