// Forge crypto: HMAC-SHA-256, gated against RFC 4231 test cases 1 + 2. Socketless, deterministic.
import forge_crypto

fn _rep(byteval: int, n: int) -> list
    let out = []
    let i = 0
    while i < n
        push(out, byteval)
        i = i + 1
    out

fn main()
    // RFC 4231 TC1: key = 0x0b x20, data = "Hi There"
    let mac1 = hex_of(hmac_sha256_bytes(_rep(11, 20), str_to_blist("Hi There")))
    if mac1 != "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7"
        print("FAIL: HMAC TC1 -> " + mac1)
        exit(1)

    // RFC 4231 TC2: key = "Jefe", data = "what do ya want for nothing?"
    let mac2 = hex_of(hmac_sha256_bytes(str_to_blist("Jefe"), str_to_blist("what do ya want for nothing?")))
    if mac2 != "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843"
        print("FAIL: HMAC TC2 -> " + mac2)
        exit(1)

    print("PASS forge_crypto_hmac (HMAC-SHA-256 RFC 4231 TC1 + TC2)")
