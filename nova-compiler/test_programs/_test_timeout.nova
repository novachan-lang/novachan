@timeout
fn slow_op() -> int
    return 42

@timeout("3000")
fn fast_op() -> string
    return "done"

fn main()
    assert(slow_op__timeout_ms() == 5000, "default timeout")
    assert(slow_op__has_timeout() == 1, "has timeout")

    assert(fast_op__timeout_ms() == 3000, "custom timeout")
    assert(fast_op__has_timeout() == 1, "custom has timeout")

    let r1 = slow_op()
    assert(r1 == 42, "fn still works")

    let r2 = fast_op()
    assert(r2 == "done", "custom fn works")

    print("TIMEOUT ANNOTATION TEST PASS")
