fn run()
    let p = path_join("src", "main.nova")
    print("join: {p}")
    let parent = path_parent("C:/Users/test/file.txt")
    let msg1 = "parent failed: " + parent
    assert(parent == "C:/Users/test", msg1)
    print("parent: {parent}")
    let name = path_name("/home/user/doc.pdf")
    let msg2 = "name failed: " + name
    assert(name == "doc.pdf", msg2)
    print("name: {name}")
    let ext = path_ext("archive.tar.gz")
    let msg3 = "ext failed: " + ext
    assert(ext == ".gz", msg3)
    print("ext: {ext}")
    print("PATH: ALL PASSED")

run()
