fn abs_val(x: int) -> int
    let result = if x < 0
        0 - x
    else
        x
    return result

fn classify(n: int) -> string
    let label = if n > 0
        "positive"
    else if n < 0
        "negative"
    else
        "zero"
    return label

print("abs(-5) = " + str(abs_val(-5)))
print("abs(3) = " + str(abs_val(3)))
print("classify(10) = " + classify(10))
print("classify(-3) = " + classify(-3))
print("classify(0) = " + classify(0))

let x = if true
    42
else
    0
print("x = " + str(x))

if abs_val(-5) == 5 and abs_val(3) == 3 and classify(0) == "zero" and x == 42
    print("PASS")
else
    print("FAIL")
