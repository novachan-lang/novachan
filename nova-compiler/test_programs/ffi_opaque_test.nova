// @opaque type: a C handle NOVA holds as int but the FFI wrapper marshals
// as ptr. This proves an opaque type round-trips through extern declarations
// — open a file with fopen, get a FILE* handle, check it's non-null, close.
@opaque
type FileHandle

extern fn fopen(path: string, mode: string) -> FileHandle
extern fn fclose(fp: FileHandle) -> int

fn main()
    // Open this very source file (must exist) for reading.
    let fp = unsafe fopen("ffi_opaque_test.nova", "r")
    if fp == 0
        print("FAIL: fopen returned null for ffi_opaque_test.nova")
        exit(1)
    let rc = unsafe fclose(fp)
    assert_eq(rc, 0)

    // Negative case: opening a file that doesn't exist returns null.
    let missing = unsafe fopen("this_file_must_not_exist_xyz.txt", "r")
    if missing != 0
        print("FAIL: expected null FILE* for nonexistent file, got " + str(missing))
        exit(1)

    print("@opaque test passed: FILE* handle round-tripped through fopen/fclose as opaque ptr; null check works as int compare")
