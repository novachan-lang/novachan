// os_random: OS CSPRNG entropy as bytes, called via the @link/extern FFI (no compiler change). Verifies
// the length, non-determinism (two calls differ), and non-zero output (entropy actually flowed).
extern fn nova_rt_os_random(n: int) -> bytes

fn main()
    let a = unsafe nova_rt_os_random(32)
    if bytes_len(a) != 32
        print("FAIL: os_random length not 32")
        exit(1)
    let b = unsafe nova_rt_os_random(32)
    let same = 1
    let i = 0
    while i < 32
        if bytes_get(a, i) != bytes_get(b, i)
            same = 0
        i = i + 1
    if same == 1
        print("FAIL: two os_random calls identical (not random)")
        exit(1)
    let allzero = 1
    let j = 0
    while j < 32
        if bytes_get(a, j) != 0
            allzero = 0
        j = j + 1
    if allzero == 1
        print("FAIL: os_random all zero (entropy failed)")
        exit(1)
    print("PASS forge_osrandom (32 bytes, non-deterministic, non-zero)")
