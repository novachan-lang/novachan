fn mime_type(filename)
  let ext = ""
  let i = len(filename) - 1
  while i >= 0
    if slice(filename, i, i + 1) == "."
      ext = lower(slice(filename, i + 1, len(filename)))
      i = -1
    i = i - 1
  if ext == "html" or ext == "htm"
    return "text/html"
  if ext == "css"
    return "text/css"
  if ext == "js"
    return "application/javascript"
  if ext == "json"
    return "application/json"
  if ext == "xml"
    return "application/xml"
  if ext == "txt"
    return "text/plain"
  if ext == "csv"
    return "text/csv"
  if ext == "png"
    return "image/png"
  if ext == "jpg" or ext == "jpeg"
    return "image/jpeg"
  if ext == "gif"
    return "image/gif"
  if ext == "svg"
    return "image/svg+xml"
  if ext == "ico"
    return "image/x-icon"
  if ext == "pdf"
    return "application/pdf"
  if ext == "zip"
    return "application/zip"
  if ext == "gz"
    return "application/gzip"
  if ext == "wasm"
    return "application/wasm"
  if ext == "mp3"
    return "audio/mpeg"
  if ext == "mp4"
    return "video/mp4"
  if ext == "woff2"
    return "font/woff2"
  if ext == "woff"
    return "font/woff"
  if ext == "ttf"
    return "font/ttf"
  if ext == "nova"
    return "text/x-nova"
  "application/octet-stream"

fn is_text_mime(mime)
  starts_with(mime, "text/") or mime == "application/json" or mime == "application/javascript" or mime == "application/xml"

fn main()
  assert(mime_type("index.html") == "text/html", "html")
  assert(mime_type("style.CSS") == "text/css", "css case")
  assert(mime_type("app.js") == "application/javascript", "js")
  assert(mime_type("data.json") == "application/json", "json")
  assert(mime_type("photo.jpg") == "image/jpeg", "jpg")
  assert(mime_type("photo.JPEG") == "image/jpeg", "jpeg upper")
  assert(mime_type("logo.png") == "image/png", "png")
  assert(mime_type("doc.pdf") == "application/pdf", "pdf")
  assert(mime_type("readme.txt") == "text/plain", "txt")
  assert(mime_type("archive.zip") == "application/zip", "zip")
  assert(mime_type("app.wasm") == "application/wasm", "wasm")
  assert(mime_type("hello.nova") == "text/x-nova", "nova")
  assert(mime_type("unknown.xyz") == "application/octet-stream", "fallback")
  assert(mime_type("noext") == "application/octet-stream", "no extension")

  assert(is_text_mime("text/html") == 1, "html is text")
  assert(is_text_mime("application/json") == 1, "json is text")
  assert(is_text_mime("image/png") == 0, "png is not text")

  print("mimesx: all passed")
