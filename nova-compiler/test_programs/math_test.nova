// Integer abs/max/min
print(abs(-42))
print(abs(10))
print(max(3, 7))
print(max(9, 2))
print(min(3, 7))
print(min(9, 2))

// Float abs/max/min
print(abs(-3.14))
print(max(1.5, 2.7))
print(min(1.5, 2.7))

// sqrt/floor/ceil
print(sqrt(9.0))
print(sqrt(2.0))
print(floor(3.7))
print(ceil(3.2))

// modulo (already in lexer, verify it works)
print(10 % 3)
print(17 % 5)
print(-7 % 3)

// not operator
print(not true)
print(not false)
x = 5
print(not (x == 3))
