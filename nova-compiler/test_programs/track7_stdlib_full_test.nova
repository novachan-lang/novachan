// Track 7 stdlib breadth validation: exercises collections, encoding,
// logging, datetime, path, random, regex, serialization, and test framework
// builtins to prove the stdlib is production-ready.

fn _clamp(x, lo, hi)
    if x < lo
        return lo
    if x > hi
        return hi
    x

fn _gcd(a, b)
    let x = a
    let y = b
    if x < 0
        x = 0 - x
    if y < 0
        y = 0 - y
    while y != 0
        let t = y
        y = x % y
        x = t
    x

fn _lcm(a, b)
    let g = _gcd(a, b)
    if g == 0
        return 0
    a / g * b

fn _factorial(n)
    let r = 1
    let i = 2
    while i <= n
        r = r * i
        i = i + 1
    r

fn _fib(n)
    if n <= 0
        return 0
    if n == 1
        return 1
    let a = 0
    let b = 1
    let i = 2
    while i <= n
        let t = a + b
        a = b
        b = t
        i = i + 1
    b

fn _is_even(n)
    n % 2 == 0

fn _is_odd(n)
    n % 2 != 0

fn main()
    // ── 1. Collections: Set ──────────────────────────────────────────
    let s = set_create()
    set_add(s, "apple")
    set_add(s, "banana")
    set_add(s, "apple")
    assert_eq(set_len(s), 2)
    assert_eq(set_has(s, "apple"), true)
    assert_eq(set_has(s, "cherry"), false)
    set_remove(s, "banana")
    assert_eq(set_len(s), 1)
    let sl = set_to_list(s)
    assert_eq(len(sl), 1)

    // ── 2. Collections: Deque ────────────────────────────────────────
    let dq = deque_create()
    deque_push_back(dq, 10)
    deque_push_back(dq, 20)
    deque_push_front(dq, 5)
    assert_eq(deque_len(dq), 3)
    assert_eq(deque_front(dq), 5)
    assert_eq(deque_back(dq), 20)
    let popped_f = deque_pop_front(dq)
    assert_eq(popped_f, 5)
    assert_eq(deque_len(dq), 2)
    let popped_b = deque_pop_back(dq)
    assert_eq(popped_b, 20)
    assert_eq(deque_len(dq), 1)

    // ── 3. Collections: Priority Queue ───────────────────────────────
    let pq = pq_create()
    pq_push(pq, 3, "low")
    pq_push(pq, 1, "high")
    pq_push(pq, 2, "mid")
    assert_eq(pq_len(pq), 3)
    let top = pq_peek(pq)
    assert_eq(top, "high")
    let p1 = pq_pop(pq)
    assert_eq(p1, "high")
    let p2 = pq_pop(pq)
    assert_eq(p2, "mid")
    let p3 = pq_pop(pq)
    assert_eq(p3, "low")
    assert_eq(pq_len(pq), 0)

    // ── 4. Collections: Ring Buffer ──────────────────────────────────
    let rb = ringbuf_create(3)
    ringbuf_push(rb, "a")
    ringbuf_push(rb, "b")
    ringbuf_push(rb, "c")
    assert_eq(ringbuf_len(rb), 3)
    assert_eq(ringbuf_is_full(rb), true)
    ringbuf_push(rb, "d")
    assert_eq(ringbuf_len(rb), 3)
    let rb_popped = ringbuf_pop(rb)
    assert_eq(rb_popped, "b")

    // ── 5. Collections: Counter ──────────────────────────────────────
    let cnt = counter_create()
    counter_inc(cnt, "a")
    counter_inc(cnt, "b")
    counter_inc(cnt, "a")
    counter_inc(cnt, "a")
    counter_inc(cnt, "b")
    assert_eq(counter_get(cnt, "a"), 3)
    assert_eq(counter_get(cnt, "b"), 2)
    assert_eq(counter_total(cnt), 5)
    let mc = counter_most_common(cnt, 1)
    assert_eq(len(mc), 1)

    // ── 6. Collections: LRU Cache ────────────────────────────────────
    let lru = lru_create(2)
    lru_put(lru, "x", 10)
    lru_put(lru, "y", 20)
    assert_eq(lru_get(lru, "x"), 10)
    lru_put(lru, "z", 30)
    assert_eq(lru_has(lru, "y"), false)
    assert_eq(lru_has(lru, "x"), true)
    assert_eq(lru_has(lru, "z"), true)
    assert_eq(lru_len(lru), 2)

    // ── 7. Collections: Sorted Map ───────────────────────────────────
    let sm = smap_create()
    smap_set(sm, "charlie", 3)
    smap_set(sm, "alpha", 1)
    smap_set(sm, "bravo", 2)
    assert_eq(smap_len(sm), 3)
    assert_eq(smap_get(sm, "alpha"), 1)
    assert_eq(smap_has(sm, "bravo"), true)
    let sm_keys = smap_keys(sm)
    assert_eq(sm_keys[0], "alpha")
    assert_eq(sm_keys[1], "bravo")
    assert_eq(sm_keys[2], "charlie")

    // ── 8. String Operations ─────────────────────────────────────────
    assert_eq(upper("hello"), "HELLO")
    assert_eq(lower("WORLD"), "world")
    assert_eq(trim("  hi  "), "hi")
    assert_eq(replace("foo bar foo", "foo", "baz"), "baz bar baz")
    let parts = split("a,b,c", ",")
    assert_eq(len(parts), 3)
    assert_eq(parts[1], "b")
    assert_eq(join(["x", "y", "z"], "-"), "x-y-z")
    assert_eq(starts_with("hello", "hel"), true)
    assert_eq(ends_with("hello", "llo"), true)
    assert_eq(repeat("ab", 3), "ababab")
    assert_eq(pad_left("5", 3, 48), "005")
    assert_eq(pad_right("hi", 5, 46), "hi...")

    // ── 9. List Operations ───────────────────────────────────────────
    let nums = [5, 3, 1, 4, 2]
    let sorted = sort(nums)
    assert_eq(sorted[0], 1)
    assert_eq(sorted[4], 5)
    assert_eq(list_min(nums), 1)
    assert_eq(list_max(nums), 5)
    assert_eq(sum([1, 2, 3, 4, 5]), 15)
    assert_eq(index_of(nums, 4), 3)
    let rev = reverse([1, 2, 3])
    assert_eq(rev[0], 3)
    assert_eq(rev[2], 1)

    // ── 10. Math Operations ──────────────────────────────────────────
    assert_eq(abs(-42), 42)
    assert_eq(min(3, 7), 3)
    assert_eq(max(3, 7), 7)
    assert_eq(_clamp(15, 0, 10), 10)
    assert_eq(_clamp(-5, 0, 10), 0)
    assert_eq(_gcd(12, 8), 4)
    assert_eq(_lcm(4, 6), 12)
    assert_eq(_factorial(5), 120)
    assert_eq(_fib(10), 55)
    assert_eq(_is_even(4), true)
    assert_eq(_is_odd(3), true)
    assert_near(sqrt(4.0), 2.0, 0.001)
    let pi_val = 3.14159265358979
    assert_near(pi_val, 3.14159265, 0.0001)

    // ── 11. JSON ─────────────────────────────────────────────────────
    let obj = json_decode("\{\"name\":\"nova\",\"version\":3\}")
    assert_eq(obj["name"], "nova")
    let encoded = json_encode(obj)
    if find(encoded, "nova") < 0
        print("FAIL: json_encode missing 'nova'")
        exit(1)

    // ── 12. Hashing & Crypto ─────────────────────────────────────────
    let h = sha256("hello")
    assert_eq(len(h), 64)
    let h2 = sha256("hello")
    assert_eq(h, h2)
    let crc = crc32("test")
    if crc == 0
        print("FAIL: crc32 returned 0")
        exit(1)

    // ── 13. Encoding ─────────────────────────────────────────────────
    let hexed = hex_encode("AB")
    if len(hexed) < 2
        print("FAIL: hex_encode too short")
        exit(1)
    let b64 = base64_encode("Hello")
    assert_eq(b64, "SGVsbG8=")
    let b64_dec = base64_decode("SGVsbG8=")
    assert_eq(b64_dec, "Hello")

    // ── 14. Serialization (via JSON round-trip) ────────────────────
    let ser_obj = json_decode("\{\"items\":[1,2,3],\"ok\":true\}")
    let ser_str = json_encode(ser_obj)
    let deser_obj = json_decode(ser_str)
    assert_eq(deser_obj["ok"], true)
    if find(ser_str, "items") < 0
        print("FAIL: serialization round-trip lost 'items'")
        exit(1)

    // ── 15. Date/Time ────────────────────────────────────────────────
    let now = time_ms()
    if now <= 0
        print("FAIL: time_ms returned <= 0")
        exit(1)
    let ns = clock_ns()
    if ns <= 0
        print("FAIL: clock_ns returned <= 0")
        exit(1)

    // ── 16. Random ───────────────────────────────────────────────────
    let r1 = random_int(1, 100)
    if r1 < 1 or r1 > 100
        print("FAIL: random_int out of range")
        exit(1)
    let rf = random_float()
    if rf < 0.0
        print("FAIL: random_float negative")
        exit(1)

    // ── 17. UUID ─────────────────────────────────────────────────────
    let id = uuid4()
    assert_eq(len(id), 36)
    if find(id, "-") < 0
        print("FAIL: uuid4 missing dashes")
        exit(1)

    // ── 18. Profiling ────────────────────────────────────────────────
    let prof_token = prof_start("test_section")
    let dummy = 0
    let pi2 = 0
    while pi2 < 1000
        dummy = dummy + pi2
        pi2 = pi2 + 1
    let ns_elapsed = prof_stop(prof_token)
    if ns_elapsed < 0
        print("FAIL: prof_stop returned negative")
        exit(1)

    // ── 19. Iterator Protocol ────────────────────────────────────────
    let mapped = map([1, 2, 3], fn(x) x * 2)
    assert_eq(mapped[0], 2)
    assert_eq(mapped[2], 6)
    let filtered = filter([1, 2, 3, 4, 5], fn(x) x > 3)
    assert_eq(len(filtered), 2)
    assert_eq(any([false, false, true]), true)
    assert_eq(all([true, true, false]), false)

    // ── 20. Functional: enumerate, zip, flatten ──────────────────────
    let en = enumerate(["a", "b", "c"])
    assert_eq(len(en), 3)
    let zipped = zip([1, 2, 3], ["x", "y", "z"])
    assert_eq(len(zipped), 3)
    let flat = flatten([[1, 2], [3, 4], [5]])
    assert_eq(len(flat), 5)
    assert_eq(flat[0], 1)
    assert_eq(flat[4], 5)

    // ── 21. Regex ────────────────────────────────────────────────────
    let m = regex_match("hello123world", "[0-9]+")
    if not m
        print("FAIL: regex_match didn't find digits")
        exit(1)
    let found = regex_find("abc 123 def 456", "[0-9]+")
    assert_eq(found, "123")
    let replaced = regex_replace("foo 123 bar", "[0-9]+", "NUM")
    assert_eq(replaced, "foo NUM bar")

    // ── 22. Test Framework ───────────────────────────────────────────
    assert_true(1 == 1)
    assert_false(1 == 2)
    assert_ne(1, 2)
    assert_contains([1, 2, 3], 2)

    print("TRACK 7 STDLIB FULL TEST PASSED: 22 categories, all stdlib builtins exercised")
