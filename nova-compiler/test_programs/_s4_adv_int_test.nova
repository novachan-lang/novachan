// S4.1 INT-list taint adversarial suite. The float _s4_adv cases stay boxed under S4.1, so the
// intlist (raw int64 storage + native read) taint needs its OWN coverage. Each case below would
// read a heap box pointer as a raw int (GARBAGE) on the pre-S4.1 compiler; the single-reference
// taint must make them all correct by routing escaped/aliased intlists through the generic path.
// Self-checking; must print S4_ADV_INT_OK.

type IBox
    items: list

fn iaddfloat(lst)
    push(lst, 3.5)

fn iaddstr(lst)
    push(lst, "tail")

fn isum(lst)
    let s = 0
    let i = 0
    while i < len(lst)
        s = s + lst[i]
        i = i + 1
    s

fn main()
    // 1. ALIAS of a local intlist, heterogeneous push via the alias.
    let xs = [1, 2, 3]
    let ys = xs
    push(ys, 3.5)
    assert(xs[0] == 1, "ialias: int head intact")
    assert(xs[3] == 3.5, "ialias: float seen through xs")

    // 2. ESCAPE: local intlist passed to a user fn that appends a float (the escbug pattern).
    let es = [10, 20]
    iaddfloat(es)
    assert(es[0] == 10, "iescape: int head intact")
    assert(es[2] == 3.5, "iescape: appended float correct (not a giant int)")

    // 3. ESCAPE with a STRING append (a heap pointer that must NOT read as a raw int).
    let ss = [7, 8]
    iaddstr(ss)
    assert(ss[0] == 7, "istr: int head intact")
    assert(ss[2] == "tail", "istr: appended string correct")

    // 4. READ-ONLY escape (sum): correct (and may stay fast in S4.1 regime B / S4.2 regime A).
    let ra = [1, 2, 3, 4]
    assert(isum(ra) == 10, "ireadonly: sum correct")

    // 5. PURE LOCAL intlist (single-reference, regime A -> stays the native fast path): correct.
    let loc = []
    let k = 0
    while k < 6
        push(loc, k * 2)
        k = k + 1
    assert(loc[0] == 0, "ilocal: head")
    assert(loc[5] == 10, "ilocal: tail")
    let s = 0
    let j = 0
    while j < len(loc)
        s = s + loc[j]
        j = j + 1
    assert(s == 30, "ilocal: native sum 0+2+4+6+8+10")

    print("S4_ADV_INT_OK")
