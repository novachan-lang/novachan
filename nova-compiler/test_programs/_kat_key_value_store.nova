import forge_key_value_store

fn main()
    let k = kv_new()
    k = kv_set(k, "user:1", "Alice", 0)
    k = kv_set(k, "user:2", "Bob", 500)
    assert(kv_total_sets(k) == 2, "2 sets")

    let r1 = kv_get(k, "user:1", 100)
    k = r1["k"]
    assert(r1["found"] == 1, "found user:1")
    assert(r1["value"] == "Alice", "Alice")

    let r2 = kv_get(k, "user:2", 100)
    k = r2["k"]
    assert(r2["found"] == 1, "found user:2 before ttl")

    let r3 = kv_get(k, "user:2", 600)
    k = r3["k"]
    assert(r3["found"] == 0, "user:2 expired")

    let r4 = kv_get(k, "unknown", 100)
    k = r4["k"]
    assert(r4["found"] == 0, "unknown not found")

    assert(kv_total_gets(k) == 4, "4 gets")
    assert(kv_hit_rate(k) == 50, "50% hit rate")

    k = kv_delete(k, "user:1")
    let r5 = kv_get(k, "user:1", 100)
    k = r5["k"]
    assert(r5["value"] == "", "deleted empty")

    print("KEY-VALUE-STORE KAT PASS")
