// http_offload_test.nova — validates http_get is CARRIER-SAFE: a green HTTP client
// (http_get) talking to an in-process green TCP server, synchronized by a CHANNEL (no
// sleep). Without the offload fix, http_get blocks the single carrier -> the server task
// can't accept -> deadlock/timeout. With it, http_get offloads its blocking I/O so the
// carrier stays free, the server runs, and the request completes.
fn _server(port, ready_ch)
    let srv = tcp_listen(port)
    send(ready_ch, 1)
    let client = tcp_accept(srv)
    let _raw = tcp_recv(client)
    let body = "{\"ok\":true}"
    let resp = "HTTP/1.1 200 OK\r\nContent-Length: " + str(len(body)) + "\r\nConnection: close\r\n\r\n" + body
    tcp_send(client, resp)
    tcp_close(client)
    tcp_close(srv)

fn main()
    let ready = channel()
    let _s = spawn _server(19120, ready)
    receive(ready)
    let r = http_get("http://127.0.0.1:19120/")
    assert(contains(str(r), "ok"), "http_get got: " + str(r))
    print("http_offload_test: green http_get == green server (no carrier deadlock)")
