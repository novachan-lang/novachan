import std/logic/logic_dpll

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn ckl(label, got, want)
    if len(got) != len(want)
        print("FAIL " + label + ": len=" + str(len(got)) + " want len=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

// Local brute-force CNF evaluator for cross-checking
fn _local_eval_cnf(cnf, asgn) -> int
    let nc = len(cnf)
    let ci = 0
    while ci < nc
        let clause = cnf[ci]
        let nl = len(clause)
        let found = 0
        let li = 0
        while li < nl
            let lit = clause[li]
            let var = lit
            if var < 0
                var = 0 - var
            let val = asgn[var - 1]
            if lit > 0 and val == 1
                found = 1
            if lit < 0 and val == 0
                found = 1
            li = li + 1
        if found == 0
            return 0
        ci = ci + 1
    1

fn _local_count_sat(cnf, nvars) -> int
    let total = 1 << nvars
    let count = 0
    let i = 0
    while i < total
        let a = []
        let b = 0
        while b < nvars
            push(a, (i >> b) & 1)
            b = b + 1
        if _local_eval_cnf(cnf, a) == 1
            count = count + 1
        i = i + 1
    count

fn main()
    // =========================================================================
    // KAT 1: ldp_is_sat([[1],[-1]],1) = false  (contradiction)
    // =========================================================================
    let cnf_contra = [[1], [-1]]
    ckb("is_sat_contra", ldp_is_sat(cnf_contra, 1), false)
    cki("count_contra", ldp_count_solutions(cnf_contra, 1), 0)

    // =========================================================================
    // KAT 2: ldp_is_sat([[1,2]],2) = true
    // =========================================================================
    let cnf_12 = [[1, 2]]
    ckb("is_sat_12", ldp_is_sat(cnf_12, 2), true)
    cki("count_12", ldp_count_solutions(cnf_12, 2), 3)

    // =========================================================================
    // KAT 3: ldp_count_solutions([[1,-2],[-1,2]],2) = 2  (XOR)
    // =========================================================================
    let cnf_xor = [[1, -2], [-1, 2]]
    cki("count_xor", ldp_count_solutions(cnf_xor, 2), 2)

    // =========================================================================
    // KAT 4: ldp_count_solutions([],2) = 4  (no constraints)
    // =========================================================================
    let cnf_empty = []
    cki("count_empty", ldp_count_solutions(cnf_empty, 2), 4)

    // =========================================================================
    // KAT 5: ldp_solve([[1],[-1]],1) = []  (UNSAT)
    // =========================================================================
    let sol_contra = ldp_solve(cnf_contra, 1)
    cki("solve_contra_len", len(sol_contra), 0)

    // =========================================================================
    // KAT 6: ldp_solve([[1,2]],2) returns a valid satisfying assignment
    // =========================================================================
    let sol_12 = ldp_solve(cnf_12, 2)
    cki("solve_12_len", len(sol_12), 2)
    // Verify the solution actually satisfies the CNF
    cki("solve_12_sat", _local_eval_cnf(cnf_12, sol_12), 1)

    // =========================================================================
    // ENUMERATION CROSS-CHECK: ldp_count_solutions agrees with brute-force for all spec KATs
    // =========================================================================
    let brute_contra = _local_count_sat(cnf_contra, 1)
    cki("enum_contra", ldp_count_solutions(cnf_contra, 1), brute_contra)

    let brute_12 = _local_count_sat(cnf_12, 2)
    cki("enum_12", ldp_count_solutions(cnf_12, 2), brute_12)

    let brute_xor = _local_count_sat(cnf_xor, 2)
    cki("enum_xor", ldp_count_solutions(cnf_xor, 2), brute_xor)

    let brute_empty = _local_count_sat(cnf_empty, 2)
    cki("enum_empty", ldp_count_solutions(cnf_empty, 2), brute_empty)

    // =========================================================================
    // ENUMERATION CROSS-CHECK: ldp_solve result satisfies CNF when non-empty
    // =========================================================================
    let sol_xor = ldp_solve(cnf_xor, 2)
    cki("solve_xor_len", len(sol_xor), 2)
    cki("solve_xor_sat", _local_eval_cnf(cnf_xor, sol_xor), 1)

    // =========================================================================
    // Additional tests: 3-variable SAT
    // cnf_3sat = [[1,2,3],[-1,2],[-2,3],[-3]] -> single solution? Let's enumerate
    // =========================================================================
    let cnf_3sat = [[-3], [-2, 3], [-1, 2]]
    // -3 forces var3=0; then -2,3: 3=0 -> -2 must be sat -> var2=0; then -1,2: 2=0 -> var1=0
    // So only [0,0,0] should satisfy this
    let brute_3sat = _local_count_sat(cnf_3sat, 3)
    cki("count_3sat", ldp_count_solutions(cnf_3sat, 3), brute_3sat)
    let sol_3sat = ldp_solve(cnf_3sat, 3)
    if brute_3sat > 0
        cki("solve_3sat_len", len(sol_3sat), 3)
        cki("solve_3sat_sat", _local_eval_cnf(cnf_3sat, sol_3sat), 1)

    // =========================================================================
    // Edge case: single clause with all vars -> 2^nvars - 1 solutions (all except all-false)
    // =========================================================================
    let cnf_or3 = [[1, 2, 3]]
    let brute_or3 = _local_count_sat(cnf_or3, 3)
    cki("count_or3_brute", brute_or3, 7)
    cki("count_or3", ldp_count_solutions(cnf_or3, 3), 7)

    // =========================================================================
    // Edge case: unit clause forces var
    // cnf = [[2]] with nvars=2: var2 must be 1; var1 free -> 2 solutions
    // =========================================================================
    let cnf_unit2 = [[2]]
    cki("count_unit2", ldp_count_solutions(cnf_unit2, 2), 2)
    let sol_unit2 = ldp_solve(cnf_unit2, 2)
    cki("solve_unit2_len", len(sol_unit2), 2)
    cki("solve_unit2_var2", sol_unit2[1], 1)

    print("PASS _logic_dpll_test")
