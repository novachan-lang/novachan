import std/numeric/secant

// Named test functions — no closures, top-level only.
fn fsq(x) -> float
    let r = x * x - 2.0
    return r

fn flin(x) -> float
    let r = 3.0 * x - 12.0
    return r

fn fc(x) -> float
    let r = x * x * x - 27.0
    return r

fn ckf(got, want, eps) -> int
    let d = got - want
    let ad = 0.0
    if d < 0.0
        let ad = 0.0 - d
    else
        let ad = d
    if ad > eps
        return 0
    return 1

fn main()
    let eps = 0.001

    // KAT 1: sqrt(2) via x^2 - 2 = 0
    let r1 = sc_root(fsq, 1.0, 2.0, 0.0001, 50)
    if ckf(r1, 1.41421, eps) == 0
        print("FAIL KAT1 sqrt(2): got " + str(r1))
        exit(1)

    // KAT 2: linear 3x-12=0 => x=4
    let r2 = sc_root(flin, 0.0, 10.0, 0.0001, 50)
    if ckf(r2, 4.0, eps) == 0
        print("FAIL KAT2 linear x=4: got " + str(r2))
        exit(1)

    // KAT 3: cube root of 27 via x^3-27=0 => x=3
    let r3 = sc_root(fc, 1.0, 5.0, 0.0001, 50)
    if ckf(r3, 3.0, eps) == 0
        print("FAIL KAT3 cbrt(27)=3: got " + str(r3))
        exit(1)

    // KAT 4: sqrt(2) converges from different initial bracket
    let r4 = sc_root(fsq, 1.3, 1.5, 0.0001, 50)
    if ckf(r4, 1.41421, eps) == 0
        print("FAIL KAT4 sqrt(2) tight bracket: got " + str(r4))
        exit(1)

    // KAT 5: linear root from negative side
    let r5 = sc_root(flin, 0.0 - 5.0, 0.0, 0.0001, 50)
    if ckf(r5, 4.0, eps) == 0
        print("FAIL KAT5 linear from negative: got " + str(r5))
        exit(1)

    // KAT 6: x^3-27=0 from tighter bracket
    let r6 = sc_root(fc, 2.5, 3.5, 0.0001, 50)
    if ckf(r6, 3.0, eps) == 0
        print("FAIL KAT6 cbrt(27) tight: got " + str(r6))
        exit(1)

    print("_secant_test passed")
