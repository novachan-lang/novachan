// KAT for std/io/path — path string manipulation.
import std/io/path

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": '" + got + "' != '" + want + "'")
        exit(1)

fn main()
    cks("dir1", path_dirname("/a/b/c.txt"), "/a/b")
    cks("dir2", path_dirname("a"), ".")
    cks("dir3", path_dirname("/x"), "/")
    cks("base", path_basename("/a/b/c.txt"), "c.txt")
    cks("ext", path_ext("file.tar.gz"), ".gz")
    cks("noext", path_ext("noext"), "")
    cks("hidden", path_ext(".hidden"), "")
    cks("stem", path_stem("file.txt"), "file")
    cks("join", path_join_list(["a", "b", "c"]), "a/b/c")
    cks("joinabs", path_join_list(["/a", "b"]), "/a/b")
    if not path_is_absolute("/x")
        print("FAIL is_abs /x")
        exit(1)
    if path_is_absolute("x")
        print("FAIL is_abs x")
        exit(1)
    cks("norm1", path_normalize("a/./b/../c"), "a/c")
    cks("norm2", path_normalize("/a//b/./c"), "/a/b/c")
    print("_path_test passed")
