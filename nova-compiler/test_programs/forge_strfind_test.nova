import forge_strfind

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // index_of
    fails = fails + expect("io1", str(index_of("hello world", "world")), "6")
    fails = fails + expect("io_first", str(index_of("abcabc", "bc")), "1")
    fails = fails + expect("io_absent", str(index_of("hello", "xyz")), "-1")
    fails = fails + expect("io_empty", str(index_of("hello", "")), "0")
    fails = fails + expect("io_full", str(index_of("hello", "hello")), "0")

    // last_index_of
    fails = fails + expect("lio1", str(last_index_of("abcabc", "bc")), "4")
    fails = fails + expect("lio_single", str(last_index_of("hello", "l")), "3")
    fails = fails + expect("lio_absent", str(last_index_of("hello", "z")), "-1")

    // count_occurrences
    fails = fails + expect("co1", str(count_occurrences("abcabcabc", "abc")), "3")
    fails = fails + expect("co_overlap", str(count_occurrences("aaaa", "aa")), "2")
    fails = fails + expect("co_none", str(count_occurrences("hello", "z")), "0")
    fails = fails + expect("co_single", str(count_occurrences("mississippi", "s")), "4")

    // contains
    fails = fails + expect("c_yes", str(str_contains("hello world", "o w")), "true")
    fails = fails + expect("c_no", str(str_contains("hello", "xyz")), "false")

    // starts_with / ends_with
    fails = fails + expect("sw_yes", str(starts_with("hello.txt", "hello")), "true")
    fails = fails + expect("sw_no", str(starts_with("hello", "world")), "false")
    fails = fails + expect("sw_long", str(starts_with("hi", "hilong")), "false")
    fails = fails + expect("ew_yes", str(ends_with("hello.txt", ".txt")), "true")
    fails = fails + expect("ew_no", str(ends_with("hello.txt", ".md")), "false")
    fails = fails + expect("ew_full", str(ends_with("hello", "hello")), "true")

    if fails == 0
        print("forge_strfind: all passed")
    else
        print("forge_strfind: " + str(fails) + " FAILED")
