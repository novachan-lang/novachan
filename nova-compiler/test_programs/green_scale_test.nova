// Scale validation for the implicit-async M:N flagship, using the TRANSPARENT
// path: plain `spawn` + channel ops, NO async keyword, NO sched_run call (main is
// auto-wrapped as a green task). Proves the headline claim — thousands of green
// tasks multiplexed onto the OS carriers, with parking, at scale.

let n = 10000

// ── Phase 1: 10k green tasks fan-in to one channel; collector parks/drains ──
let hub = channel()
let i = 0
while i < n
    spawn fn()
        send(hub, 1)
    i = i + 1

let total = 0
let got = 0
while got < n
    total = total + receive(hub)
    got = got + 1
assert(total == n, "phase1: all 10k green workers delivered")
print("phase1 OK: " + str(n) + " green tasks fanned in, sum=" + str(total))

// ── Phase 2: 10k green tasks each PARK on their own channel, then woken ──
// This is the hard case (many simultaneous parked tasks — the GenServer pattern).
let inboxes = []
let j = 0
while j < n
    push(inboxes, channel())
    j = j + 1

let results = channel()
let k = 0
while k < n
    let myc = inboxes[k]
    spawn fn()
        let v = receive(myc)      // PARKS until main sends to this inbox
        send(results, v + 1)
    k = k + 1

// At this point ~10k tasks are parked on recv. Wake them one by one.
let w = 0
while w < n
    send(inboxes[w], w)
    w = w + 1

let sum2 = 0
let c2 = 0
while c2 < n
    sum2 = sum2 + receive(results)
    c2 = c2 + 1
// sum of (w+1) for w in 0..n-1 = n + n*(n-1)/2
let expected = n + n * (n - 1) / 2
assert(sum2 == expected, "phase2: all 10k parked tasks woken and replied")
print("phase2 OK: " + str(n) + " parked tasks woken, sum=" + str(sum2) + " (expected " + str(expected) + ")")

print("GREEN SCALE PASS: " + str(n) + " green tasks x2 phases on the M:N scheduler")
