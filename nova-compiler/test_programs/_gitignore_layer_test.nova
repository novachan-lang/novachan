import std/devtool/gitignore_layer

fn main()
    // --- gil_create_layer: normalizes dir_path ---
    let root_pats = []
    push(root_pats, "*.log")
    let root_layer = gil_create_layer("", root_pats)
    if root_layer[0] != ""
        print("FAIL gil_create_layer-root-dir: got '" + root_layer[0] + "'")
        exit(1)
    if len(root_layer[1]) != 1
        print("FAIL gil_create_layer-root-patterns-len: got " + str(len(root_layer[1])))
        exit(1)

    let src_pats = []
    push(src_pats, "*.tmp")
    let src_layer = gil_create_layer("src/", src_pats)
    if src_layer[0] != "src"
        print("FAIL gil_create_layer-src-dir: got '" + src_layer[0] + "'")
        exit(1)

    let sub_pats = []
    push(sub_pats, "!keep.tmp")
    let sub_layer = gil_create_layer("src/sub", sub_pats)
    if sub_layer[0] != "src/sub"
        print("FAIL gil_create_layer-sub-dir: got '" + sub_layer[0] + "'")
        exit(1)

    // --- gil_merge: root -> leaf ordering, out of order input ---
    let unordered = []
    push(unordered, sub_layer)
    push(unordered, root_layer)
    push(unordered, src_layer)
    let merged = gil_merge(unordered)
    if merged[0][0] != "" or merged[1][0] != "src" or merged[2][0] != "src/sub"
        print("FAIL gil_merge-order: got " + merged[0][0] + "," + merged[1][0] + "," + merged[2][0])
        exit(1)

    // --- gil_merge: stable at equal depth ---
    let a_layer = gil_create_layer("a", [])
    let b_layer = gil_create_layer("b", [])
    let same_depth = []
    push(same_depth, a_layer)
    push(same_depth, b_layer)
    let merged2 = gil_merge(same_depth)
    if merged2[0][0] != "a" or merged2[1][0] != "b"
        print("FAIL gil_merge-stable: got " + merged2[0][0] + "," + merged2[1][0])
        exit(1)

    // --- gil_applicable_layers ---
    let other_pats = []
    push(other_pats, "*.bak")
    let other_layer = gil_create_layer("other", other_pats)
    let all_layers = []
    push(all_layers, root_layer)
    push(all_layers, src_layer)
    push(all_layers, other_layer)
    let applicable = gil_applicable_layers(all_layers, "src/main.rs")
    if len(applicable) != 2
        print("FAIL gil_applicable_layers-len: got " + str(len(applicable)) + " want 2")
        exit(1)
    if applicable[0][0] != "" or applicable[1][0] != "src"
        print("FAIL gil_applicable_layers-content: got " + applicable[0][0] + "," + applicable[1][0])
        exit(1)

    // --- gil_is_ignored: basic root-layer ignore ---
    let layers1 = []
    push(layers1, root_layer)
    let ig1 = gil_is_ignored(layers1, "a.log", 0)
    if ig1 != 1
        print("FAIL gil_is_ignored-basic-match: got " + str(ig1) + " want 1")
        exit(1)
    let ig2 = gil_is_ignored(layers1, "a.txt", 0)
    if ig2 != 0
        print("FAIL gil_is_ignored-basic-nomatch: got " + str(ig2) + " want 0")
        exit(1)

    // --- gil_is_ignored: deeper layer's negation overrides shallower ignore ---
    let deep_pats = []
    push(deep_pats, "!important.log")
    let deep_layer = gil_create_layer("src", deep_pats)
    let layers2 = []
    push(layers2, root_layer)
    push(layers2, deep_layer)
    let ig3 = gil_is_ignored(layers2, "src/important.log", 0)
    if ig3 != 0
        print("FAIL gil_is_ignored-deeper-negate: got " + str(ig3) + " want 0")
        exit(1)
    // unaffected sibling file under the same deep dir stays ignored by the root rule
    let ig4 = gil_is_ignored(layers2, "src/other.log", 0)
    if ig4 != 1
        print("FAIL gil_is_ignored-deeper-negate-unrelated: got " + str(ig4) + " want 1")
        exit(1)
    // a path outside the deep layer's directory is unaffected by its negation
    let ig5 = gil_is_ignored(layers2, "elsewhere/important.log", 0)
    if ig5 != 1
        print("FAIL gil_is_ignored-negate-scoped: got " + str(ig5) + " want 1")
        exit(1)

    // --- gil_is_ignored: deeper layer re-ignoring what a shallower layer negated ---
    let root2_pats = []
    push(root2_pats, "*.log")
    push(root2_pats, "!keep.log")
    let root2_layer = gil_create_layer("", root2_pats)
    let deep2_pats = []
    push(deep2_pats, "keep.log")
    let deep2_layer = gil_create_layer("src", deep2_pats)
    let layers3 = []
    push(layers3, root2_layer)
    push(layers3, deep2_layer)
    let ig6 = gil_is_ignored(layers3, "src/keep.log", 0)
    if ig6 != 1
        print("FAIL gil_is_ignored-deeper-reignore: got " + str(ig6) + " want 1")
        exit(1)
    // outside "src" the shallower negation still applies
    let ig7 = gil_is_ignored(layers3, "keep.log", 0)
    if ig7 != 0
        print("FAIL gil_is_ignored-deeper-reignore-outside: got " + str(ig7) + " want 0")
        exit(1)

    // --- gil_is_ignored: directory-only pattern gated by is_dir ---
    let build_pats = []
    push(build_pats, "build/")
    let build_layer = gil_create_layer("", build_pats)
    let layers4 = []
    push(layers4, build_layer)
    let ig8 = gil_is_ignored(layers4, "build", 1)
    if ig8 != 1
        print("FAIL gil_is_ignored-dironly-isdir: got " + str(ig8) + " want 1")
        exit(1)
    let ig9 = gil_is_ignored(layers4, "build", 0)
    if ig9 != 0
        print("FAIL gil_is_ignored-dironly-notdir: got " + str(ig9) + " want 0")
        exit(1)

    print("PASS _gitignore_layer_test")
