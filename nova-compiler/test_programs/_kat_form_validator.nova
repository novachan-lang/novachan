import forge_form_validator

fn main()
    let f = fv_new()
    f = fv_required(f, "name")
    f = fv_min_length(f, "name", 2)
    f = fv_max_length(f, "name", 50)
    f = fv_required(f, "email")
    assert(fv_rule_count(f) == 4, "4 rules")

    let d1 = {}
    d1["name"] = "Alice"
    d1["email"] = "alice@example.com"
    let r1 = fv_validate(f, d1)
    assert(is_ok(r1), "valid")
    assert(unwrap(r1) == "valid", "valid msg")

    let d2 = {}
    d2["name"] = "Bob"
    let r2 = fv_validate(f, d2)
    assert(is_err(r2), "missing email")

    let d3 = {}
    d3["name"] = "A"
    d3["email"] = "a@b.com"
    let r3 = fv_validate(f, d3)
    assert(is_err(r3), "too short")

    assert(fv_validation_count(f) == 3, "3 validations")
    assert(fv_pass_count(f) == 1, "1 pass")
    assert(fv_fail_count(f) == 2, "2 fails")

    print("FORM-VALIDATOR KAT PASS")
