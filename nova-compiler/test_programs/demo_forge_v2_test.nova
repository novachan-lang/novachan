// NOVA FORGE v0.2 demo. Exercises the new pieces that v0.1 didn't have:
// query parameter extraction, header reading, and the json_obj builder
// that constructs JSON responses from key-value pairs instead of raw
// hand-encoded strings.
import forge

fn route(method: string, path: string, body: string, raw: string) -> string
    // /api/greet?name=alice -> {"hello":"alice"}
    let clean_path = forge.parse_path_clean(raw)
    if method == "GET" and clean_path == "/api/greet"
        let name = forge.query_get(raw, "name")
        if len(name) == 0
            name = "world"
        return forge.json_obj(200, [["hello", name]])

    // /api/whoami -> echo a few request properties as JSON object
    if method == "GET" and clean_path == "/api/whoami"
        let ua = forge.header_get(raw, "User-Agent")
        if len(ua) == 0
            ua = "(none)"
        let host = forge.header_get(raw, "Host")
        return forge.json_obj(200, [["method", method], ["path", clean_path], ["user_agent", ua], ["host", host]])

    if method == "POST" and clean_path == "/api/echo_len"
        return forge.json_obj(200, [["received_bytes", str(len(body))]])

    forge.text(404, "v2 not found: " + clean_path)

// Forge's serve_n calls handler(method, path, body) — but our v2 handler
// also needs the raw request. We adapt with a closure-style wrapper: a
// proper Forge v0.3 would change the public API, but for the demo we
// duplicate-parse from a captured copy. Simplest: serve_n_raw variant.
fn serve_with_raw(port: int, n: int)
    let listener = tcp_listen(port)
    let i = 0
    while i < n
        let conn = tcp_accept(listener)
        let raw = forge.recv_request(conn)   // full request (headers + body per Content-Length); a single tcp_recv can return a partial request and fragment the POST body
        let m = forge.parse_method(raw)
        let p = forge.parse_path(raw)
        let b = forge.parse_body(raw)
        let resp = route(m, p, b, raw)
        tcp_send(conn, resp)
        tcp_close(conn)
        i = i + 1
    tcp_close(listener)

fn main()
    let port = 18893
    spawn fn()
        serve_with_raw(port, 3)
    sleep(300)
    let base = "http://127.0.0.1:" + str(port)

    // 1. Query param extracted, JSON object built from pairs
    let r1 = http_get(base + "/api/greet?name=alice")
    if find(r1, "\"hello\":\"alice\"") < 0
        print("FAIL 1 (greet?name=alice): " + r1)
        exit(1)

    // 2. Header read + multi-field JSON
    let r2 = http_get(base + "/api/whoami")
    if find(r2, "\"method\":\"GET\"") < 0 or find(r2, "\"path\":\"/api/whoami\"") < 0
        print("FAIL 2 (whoami): " + r2)
        exit(1)

    // 3. POST body length echoed back
    let r3 = http_post(base + "/api/echo_len", "exactly-19-bytes!!!", "text/plain")
    if find(r3, "\"received_bytes\":\"19\"") < 0
        print("FAIL 3 (echo_len): " + r3)
        exit(1)

    print("FORGE v0.2 demo passed: query params, headers, and json_obj builder all working end-to-end")
