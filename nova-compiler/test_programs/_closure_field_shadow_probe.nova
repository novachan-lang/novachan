// SILENT MISCOMPILE probe.
// A struct field holding a closure, whose name ALSO matches a global fn.
// The method-call resolution chain checks global fns BEFORE struct fields, so
// `b.zzfld()` calls the GLOBAL zzfld(b) instead of the field's closure.
// Expected (correct): 42.  Buggy: 999.
type Box
    zzfld: any

fn zzfld(x) -> int
    999

fn main()
    let b = Box(fn() 42)
    let direct = b.zzfld()
    print(direct)
    // The bind-to-local form should give the CORRECT answer (42).
    let f = b.zzfld
    print(f())
