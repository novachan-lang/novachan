// sqlitex -- ergonomic, injection-safe SQLite for NOVA, on the proven FFI. Raw sqlite3_*
// (prepare/bind/step/column) is verbose; these wrappers make DB access read like Python while
// staying SAFE: db_query ALWAYS binds params (never string-concatenates them into SQL), so SQL
// injection is impossible by construction. NOTE: this file bundles externs + wrappers + a
// self-test for convenience, but CROSS-IMPORT IS SUPPORTED: another module can `import sqlitex`
// and call its wrappers -- the compiler resolves an imported module's extern declarations
// (compile_module_ir handles `extern_fn`, incl. @opaque types + out<> params), proven by
// cross_import_extern_test. (An earlier comment here claimed this was unsupported; that was
// STALE -- verified 2026-06-15. The same-file form is also still proven by demo_sqlite_test.)
@opaque
type DbHandle
@opaque
type StmtHandle

extern fn sqlite3_open(path: string, db_out: out<DbHandle>) -> i32
extern fn sqlite3_close(db: DbHandle) -> i32
extern fn sqlite3_last_insert_rowid(db: DbHandle) -> i64
extern fn sqlite3_changes(db: DbHandle) -> i32
extern fn sqlite3_exec(db: DbHandle, sql: string, cb: int, ctx: int, errmsg_out: int) -> i32
extern fn sqlite3_prepare_v2(db: DbHandle, sql: string, nbyte: i32, stmt_out: out<StmtHandle>, tail_out: int) -> i32
extern fn sqlite3_bind_int(stmt: StmtHandle, idx: i32, value: i32) -> i32
extern fn sqlite3_bind_double(stmt: StmtHandle, idx: i32, value: float) -> i32
extern fn sqlite3_bind_text(stmt: StmtHandle, idx: i32, text: string, nbyte: i32, destructor: int) -> i32
extern fn sqlite3_step(stmt: StmtHandle) -> i32
extern fn sqlite3_column_count(stmt: StmtHandle) -> i32
extern fn sqlite3_column_text(stmt: StmtHandle, col: i32) -> int
extern fn sqlite3_column_name(stmt: StmtHandle, col: i32) -> int
extern fn sqlite3_finalize(stmt: StmtHandle) -> i32

// db_open(path) -> a DB handle. ":memory:" for an in-memory DB.
fn db_open(path)
    let db = 0
    unsafe sqlite3_open(path, db)
    return db

fn db_close(db)
    return unsafe sqlite3_close(db)

// Rowid of the most recent successful INSERT on this connection (sqlite's last_insert_rowid).
fn db_last_id(db)
    return unsafe sqlite3_last_insert_rowid(db)

// Rows changed by the most recent INSERT/UPDATE/DELETE on this connection (sqlite3_changes).
fn db_affected(db)
    return unsafe sqlite3_changes(db)

// db_exec(db, sql) -> rc (0 = ok). For DDL / non-parameterized statements.
fn db_exec(db, sql)
    return unsafe sqlite3_exec(db, sql, 0, 0, 0)

// db_query(db, sql, params) -> list of rows; each row is a list of column values as strings
// (sqlite coerces any column to text). params is a NOVA list bound positionally: an int is
// bound with bind_int, anything else as text -- ALWAYS parameterized, so it is injection-safe.
// INSERT/UPDATE/DELETE return [] (no result rows). Pass [] for no params.
fn db_query(db, sql, params)
    let SQLITE_ROW = 100
    let SQLITE_TRANSIENT = -1
    let stmt = 0
    let prc = unsafe sqlite3_prepare_v2(db, sql, -1, stmt, 0)
    if prc != 0
        return []
    let i = 0
    while i < len(params)
        let p = params[i]
        // type_name is a RUNTIME check (is_int is static -> always "any"=false for a
        // list<any> element, which would mis-bind an int as text -> crash). A FLOAT must bind via
        // bind_double: binding it as text passes the double's bits where a char* is expected, which
        // stored an empty/garbage REAL (silent float data-corruption on every INSERT).
        if type_name(p) == "int"
            unsafe sqlite3_bind_int(stmt, i + 1, p)
        else if type_name(p) == "float"
            unsafe sqlite3_bind_double(stmt, i + 1, p)
        else
            unsafe sqlite3_bind_text(stmt, i + 1, p, -1, SQLITE_TRANSIENT)
        i = i + 1
    let ncol = unsafe sqlite3_column_count(stmt)
    let rows = []
    let sc = unsafe sqlite3_step(stmt)
    while sc == SQLITE_ROW
        let row = []
        let c = 0
        while c < ncol
            push(row, cstr_to_string(unsafe sqlite3_column_text(stmt, c)))
            c = c + 1
        push(rows, row)
        sc = unsafe sqlite3_step(stmt)
    unsafe sqlite3_finalize(stmt)
    return rows

// db_query_named(db, sql, params) -> list of rows as DICTS keyed by the ACTUAL column names
// (sqlite3_column_name), values as strings. Parameterized like db_query (injection-safe). This is
// what the typed db_all<T>/db_find<T> build on: name-keyed rows map straight to <T>__from_dict.
fn db_query_named(db, sql, params)
    let SQLITE_ROW = 100
    let SQLITE_TRANSIENT = -1
    let stmt = 0
    let prc = unsafe sqlite3_prepare_v2(db, sql, -1, stmt, 0)
    if prc != 0
        return []
    let i = 0
    while i < len(params)
        let p = params[i]
        if type_name(p) == "int"
            unsafe sqlite3_bind_int(stmt, i + 1, p)
        else if type_name(p) == "float"
            unsafe sqlite3_bind_double(stmt, i + 1, p)
        else
            unsafe sqlite3_bind_text(stmt, i + 1, p, -1, SQLITE_TRANSIENT)
        i = i + 1
    let ncol = unsafe sqlite3_column_count(stmt)
    let cnames = []
    let cn = 0
    while cn < ncol
        push(cnames, cstr_to_string(unsafe sqlite3_column_name(stmt, cn)))
        cn = cn + 1
    let rows = []
    let sc = unsafe sqlite3_step(stmt)
    while sc == SQLITE_ROW
        let d = {}
        let c = 0
        while c < ncol
            d[cnames[c]] = cstr_to_string(unsafe sqlite3_column_text(stmt, c))
            c = c + 1
        push(rows, d)
        sc = unsafe sqlite3_step(stmt)
    unsafe sqlite3_finalize(stmt)
    return rows

// sqlitex is a pure LIBRARY (no main): `import sqlitex` then sqlitex.db_open / db_exec /
// db_query / db_close. The self-test lives in sqlitex_test.nova and exercises it through
// the import boundary -- which is also the regression guard for the modular-FFI fix
// (imported extern fns resolving to real calls).
fn _sqlitex_lib_marker()
    return 0
