// sqlitex -- ergonomic, injection-safe SQLite for NOVA, on the proven FFI. Raw sqlite3_*
// (prepare/bind/step/column) is verbose; these wrappers make DB access read like Python while
// staying SAFE: db_query ALWAYS binds params (never string-concatenates them into SQL), so SQL
// injection is impossible by construction. NOTE: this is a STANDALONE program (externs +
// wrappers + self-test in one file) because the compiler does not yet resolve extern fns across
// `import` (a wrapper's extern call becomes a stray slot in the importer) -- import-reusability
// is a tracked compiler follow-up; the same-file form is proven (demo_sqlite_test).
@opaque
type DbHandle
@opaque
type StmtHandle

extern fn sqlite3_open(path: string, db_out: out<DbHandle>) -> i32
extern fn sqlite3_close(db: DbHandle) -> i32
extern fn sqlite3_exec(db: DbHandle, sql: string, cb: int, ctx: int, errmsg_out: int) -> i32
extern fn sqlite3_prepare_v2(db: DbHandle, sql: string, nbyte: i32, stmt_out: out<StmtHandle>, tail_out: int) -> i32
extern fn sqlite3_bind_int(stmt: StmtHandle, idx: i32, value: i32) -> i32
extern fn sqlite3_bind_text(stmt: StmtHandle, idx: i32, text: string, nbyte: i32, destructor: int) -> i32
extern fn sqlite3_step(stmt: StmtHandle) -> i32
extern fn sqlite3_column_count(stmt: StmtHandle) -> i32
extern fn sqlite3_column_text(stmt: StmtHandle, col: i32) -> int
extern fn sqlite3_finalize(stmt: StmtHandle) -> i32

// db_open(path) -> a DB handle. ":memory:" for an in-memory DB.
fn db_open(path)
    let db = 0
    unsafe sqlite3_open(path, db)
    return db

fn db_close(db)
    return unsafe sqlite3_close(db)

// db_exec(db, sql) -> rc (0 = ok). For DDL / non-parameterized statements.
fn db_exec(db, sql)
    return unsafe sqlite3_exec(db, sql, 0, 0, 0)

// db_query(db, sql, params) -> list of rows; each row is a list of column values as strings
// (sqlite coerces any column to text). params is a NOVA list bound positionally: an int is
// bound with bind_int, anything else as text -- ALWAYS parameterized, so it is injection-safe.
// INSERT/UPDATE/DELETE return [] (no result rows). Pass [] for no params.
fn db_query(db, sql, params)
    let SQLITE_ROW = 100
    let SQLITE_TRANSIENT = -1
    let stmt = 0
    let prc = unsafe sqlite3_prepare_v2(db, sql, -1, stmt, 0)
    if prc != 0
        return []
    let i = 0
    while i < len(params)
        let p = params[i]
        // type_name is a RUNTIME check (is_int is static -> always "any"=false for a
        // list<any> element, which would mis-bind an int as text -> crash).
        if type_name(p) == "int"
            unsafe sqlite3_bind_int(stmt, i + 1, p)
        else
            unsafe sqlite3_bind_text(stmt, i + 1, p, -1, SQLITE_TRANSIENT)
        i = i + 1
    let ncol = unsafe sqlite3_column_count(stmt)
    let rows = []
    let sc = unsafe sqlite3_step(stmt)
    while sc == SQLITE_ROW
        let row = []
        let c = 0
        while c < ncol
            push(row, cstr_to_string(unsafe sqlite3_column_text(stmt, c)))
            c = c + 1
        push(rows, row)
        sc = unsafe sqlite3_step(stmt)
    unsafe sqlite3_finalize(stmt)
    return rows

fn main()
    let db = db_open(":memory:")
    assert_eq(db_exec(db, "CREATE TABLE users (id INTEGER, name TEXT)"), 0)
    // Parameterized inserts -- injection-safe by construction. Row 3's name is a SQL payload.
    db_query(db, "INSERT INTO users VALUES (?, ?)", [1, "alice"])
    db_query(db, "INSERT INTO users VALUES (?, ?)", [2, "bob"])
    db_query(db, "INSERT INTO users VALUES (?, ?)", [3, "'; DROP TABLE users; --"])
    // Parameterized SELECT (id bound at runtime).
    let r = db_query(db, "SELECT name FROM users WHERE id = ?", [2])
    assert_eq(len(r), 1)
    assert_eq(r[0][0], "bob")
    // Full table back (columns coerced to text).
    let all = db_query(db, "SELECT id, name FROM users ORDER BY id", [])
    assert_eq(len(all), 3)
    assert_eq(all[0][0], "1")
    assert_eq(all[0][1], "alice")
    // Injection payload stored as literal data (DROP not executed): table intact, read verbatim.
    assert_eq(all[2][1], "'; DROP TABLE users; --")
    let cnt = db_query(db, "SELECT count(*) FROM users", [])
    assert_eq(cnt[0][0], "3")
    assert_eq(db_close(db), 0)
    print("sqlitex passed: ergonomic db_open/exec/query; parameterized + injection-safe; 3 rows round-tripped")
