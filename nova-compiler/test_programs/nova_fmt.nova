/// nova_fmt.nova — NOVA source code formatter/linter (dog-food tool)
///
/// A real tool written in NOVA for NOVA developers:
///   - Checks indentation consistency (4 spaces)
///   - Detects trailing whitespace
///   - Finds overly long lines (>100 chars)
///   - Reports unused let bindings (simple heuristic)
///   - Checks function naming conventions (snake_case)

fn _count_leading_spaces(line)
    let i = 0
    while i < len(line) and line[i] == " "
        i = i + 1
    i

fn _has_trailing_whitespace(line)
    if len(line) == 0
        return false
    let last = line[len(line) - 1]
    last == " " or last == "\t"

fn _is_snake_case(name)
    let i = 0
    while i < len(name)
        let c = ord(name[i])
        let ok = (c >= 97 and c <= 122) or (c >= 48 and c <= 57) or c == 95
        if not ok
            return false
        i = i + 1
    true

fn _extract_fn_name(line)
    let trimmed = trim(line)
    if not starts_with(trimmed, "fn ")
        return ""
    let rest = slice(trimmed, 3, len(trimmed))
    let paren = find(rest, "(")
    if paren < 0
        return ""
    trim(slice(rest, 0, paren))

fn _extract_let_name(line)
    let trimmed = trim(line)
    if not starts_with(trimmed, "let ")
        return ""
    let rest = slice(trimmed, 4, len(trimmed))
    let eq = find(rest, "=")
    let sp = find(rest, " ")
    let end = if eq >= 0 and sp >= 0
        if eq < sp
            eq
        else
            sp
    else if eq >= 0
        eq
    else if sp >= 0
        sp
    else
        len(rest)
    trim(slice(rest, 0, end))

fn lint_source(source, filename)
    let lines = split(source, "\n")
    let issues = []
    let let_names = []
    let let_lines_map = {}

    let line_num = 0
    while line_num < len(lines)
        let line = lines[line_num]
        let ln = line_num + 1

        if len(trim(line)) > 0
            let spaces = _count_leading_spaces(line)
            if spaces > 0 and spaces % 4 != 0
                push(issues, {"line": ln, "type": "indent", "msg": "indentation is " + str(spaces) + " spaces (should be multiple of 4)"})

        if _has_trailing_whitespace(line)
            push(issues, {"line": ln, "type": "trailing", "msg": "trailing whitespace"})

        if len(line) > 100
            push(issues, {"line": ln, "type": "long", "msg": "line is " + str(len(line)) + " chars (max 100)"})

        let fn_name = _extract_fn_name(line)
        if len(fn_name) > 0 and not _is_snake_case(fn_name)
            push(issues, {"line": ln, "type": "naming", "msg": "function '" + fn_name + "' is not snake_case"})

        let let_name = _extract_let_name(line)
        if len(let_name) > 0
            push(let_names, let_name)
            let_lines_map[let_name] = ln

        line_num = line_num + 1

    for name in let_names
        let used = false
        let def_line = let_lines_map[name]
        let check_line = 0
        while check_line < len(lines)
            if check_line + 1 != def_line
                let l = lines[check_line]
                if contains(l, name) and not starts_with(trim(l), "let " + name)
                    used = true
            check_line = check_line + 1
        if not used
            push(issues, {"line": def_line, "type": "unused", "msg": "'" + name + "' appears unused"})

    {"issues": issues, "lines": len(lines), "file": filename}

fn format_report(result)
    let issues = result["issues"]
    let output = []
    push(output, str(result["file"]) + ": " + str(len(issues)) + " issue(s) in " + str(result["lines"]) + " lines")
    for iss in issues
        let prefix = if str(iss["type"]) == "indent"
            "STYLE"
        else if str(iss["type"]) == "trailing"
            "STYLE"
        else if str(iss["type"]) == "long"
            "WARN"
        else if str(iss["type"]) == "naming"
            "WARN"
        else
            "INFO"
        push(output, "  " + prefix + " line " + str(iss["line"]) + ": " + str(iss["msg"]))
    join(output, "\n")

fn _test_clean()
    let src = "fn main()\n    let x = 42\n    print(x)\n"
    let r = lint_source(src, "clean.nova")
    assert(r["lines"] == 4, "4 lines")
    assert(len(r["issues"]) == 0, "no issues in clean code: " + str(len(r["issues"])))
    print("  clean code: PASS")

fn _test_indent()
    let src = "fn main()\n   let x = 1\n    let y = 2\n"
    let r = lint_source(src, "indent.nova")
    let found = false
    for iss in r["issues"]
        if str(iss["type"]) == "indent"
            found = true
    assert(found, "detected bad indent")
    print("  indent check: PASS")

fn _test_trailing()
    let src = "fn main()   \n    let x = 1\n"
    let r = lint_source(src, "trail.nova")
    let found = false
    for iss in r["issues"]
        if str(iss["type"]) == "trailing"
            found = true
    assert(found, "detected trailing whitespace")
    print("  trailing ws: PASS")

fn _test_long_line()
    let long = "fn main()\n    let x = \"" + repeat("a", 120) + "\"\n"
    let r = lint_source(long, "long.nova")
    let found = false
    for iss in r["issues"]
        if str(iss["type"]) == "long"
            found = true
    assert(found, "detected long line")
    print("  long line: PASS")

fn _test_naming()
    let src = "fn badName()\n    print(1)\n\nfn good_name()\n    print(2)\n"
    let r = lint_source(src, "name.nova")
    let found = false
    for iss in r["issues"]
        if str(iss["type"]) == "naming"
            found = true
    assert(found, "detected non-snake_case")
    print("  naming: PASS")

fn _test_report()
    let src = "fn main()   \n   let x = 1\n    print(x)\n"
    let r = lint_source(src, "test.nova")
    let report = format_report(r)
    assert(contains(report, "test.nova"), "report has filename")
    assert(contains(report, "issue"), "report mentions issues")
    print("  report format: PASS")

fn main()
    _test_clean()
    _test_indent()
    _test_trailing()
    _test_long_line()
    _test_naming()
    _test_report()
    print("nova_fmt: all passed")
