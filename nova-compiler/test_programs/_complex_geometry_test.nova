import std/complex/complex_geometry

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _complex_geometry_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL _complex_geometry_test " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn ckl2(label: string, got: list, re: int, im: int)
    cki(label + "[re]", got[0], re)
    cki(label + "[im]", got[1], im)

fn main()
    // cxgeo_distance_sq([1,2],[4,6]) = 9+16 = 25
    cki("dsq_1_2_4_6", cxgeo_distance_sq([1, 2], [4, 6]), 25)

    // cxgeo_reflect_origin([3,-2]) = [-3,2]
    let rfl = cxgeo_reflect_origin([3, 0 - 2])
    ckl2("reflect_3_n2", rfl, 0 - 3, 2)

    // cxgeo_collinear([0,0],[1,1],[2,2]) = true
    ckb("collinear_diag", cxgeo_collinear([0, 0], [1, 1], [2, 2]), true)

    // cxgeo_collinear([0,0],[1,0],[0,1]) = false
    ckb("collinear_triangle", cxgeo_collinear([0, 0], [1, 0], [0, 1]), false)

    // cxgeo_midpoint([1,1],[3,5]) = [4,6]
    let mp = cxgeo_midpoint([1, 1], [3, 5])
    ckl2("midpoint_1_1_3_5", mp, 4, 6)

    // cxgeo_distance_sq([0,0],[0,0]) = 0
    cki("dsq_zero", cxgeo_distance_sq([0, 0], [0, 0]), 0)

    print("PASS _complex_geometry_test")
