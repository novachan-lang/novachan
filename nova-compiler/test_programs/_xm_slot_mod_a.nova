// Field-slot collision probe, module A (WEAPON_PARITY_PLAN 1.4).
//
// `xs_shared` sits at slot 1 here and at slot 3 in module B. `ir_fmap` is a flat
// field_name -> slot map, so whichever module registers LAST wins and any access
// through a receiver the inferrer cannot type reads the wrong slot. This mirrors
// the real defect: `body` resolves to slot 3 on Response and slot 7 on Request.

type XsAlpha
    xs_shared: int
    xs_a_two: int
    xs_a_three: int

fn xs_alpha_make(v: int) -> XsAlpha
    XsAlpha(v, 200, 300)

// Returns the struct through a `list` so the element type is erased -- this is what
// makes the receiver un-inferrable at the access site (ir_expr_struct_type -> "").
fn xs_alpha_boxed(v: int) -> list
    [XsAlpha(v, 200, 300)]
