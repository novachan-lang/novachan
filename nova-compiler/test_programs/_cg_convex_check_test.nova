import std/geometry/cg_convex_check

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn main()
    // Square (CCW) — convex
    let sq_ccw = [[0,0],[2,0],[2,2],[0,2]]
    ckb("is_convex_sq_ccw", cgv_is_convex(sq_ccw), true)

    // Square (CW) — still convex (just opposite winding)
    let sq_cw = [[0,0],[0,2],[2,2],[2,0]]
    ckb("is_convex_sq_cw", cgv_is_convex(sq_cw), true)

    // Triangle — convex
    let tri = [[0,0],[4,0],[0,3]]
    ckb("is_convex_tri", cgv_is_convex(tri), true)

    // Non-convex polygon (reflex vertex at [1,1])
    let concave = [[0,0],[4,0],[4,4],[1,1],[0,4]]
    ckb("is_convex_concave", cgv_is_convex(concave), false)

    // Degenerate: fewer than 3 vertices -> convex
    ckb("is_convex_empty", cgv_is_convex([]), true)
    ckb("is_convex_point", cgv_is_convex([[1,2]]), true)
    ckb("is_convex_seg", cgv_is_convex([[0,0],[1,1]]), true)

    // All collinear (degenerate polygon) — is_convex=true
    let collinear = [[0,0],[1,1],[2,2],[3,3]]
    ckb("is_convex_collinear", cgv_is_convex(collinear), true)

    // cgv_is_ccw_convex
    ckb("is_ccw_convex_sq_ccw", cgv_is_ccw_convex(sq_ccw), true)
    // CW square is NOT ccw_convex
    ckb("is_ccw_convex_sq_cw", cgv_is_ccw_convex(sq_cw), false)
    // Triangle CCW
    let tri_ccw = [[0,0],[4,0],[4,4]]
    ckb("is_ccw_convex_tri_ccw", cgv_is_ccw_convex(tri_ccw), true)
    // CW triangle
    let tri_cw = [[0,0],[4,4],[4,0]]
    ckb("is_ccw_convex_tri_cw", cgv_is_ccw_convex(tri_cw), false)

    // Non-convex polygon -> neither
    ckb("is_ccw_convex_concave", cgv_is_ccw_convex(concave), false)

    // Degenerate: fewer than 3 vertices -> false
    ckb("is_ccw_convex_empty", cgv_is_ccw_convex([]), false)
    ckb("is_ccw_convex_point", cgv_is_ccw_convex([[1,2]]), false)

    // All collinear — not ccw_convex (no positive cross product)
    ckb("is_ccw_convex_collinear", cgv_is_ccw_convex(collinear), false)

    print("PASS _cg_convex_check_test")
