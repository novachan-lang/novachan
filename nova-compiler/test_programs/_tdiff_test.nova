// Canonical KAT test for std/testing/diff (value diffing utilities).
// Prefix: tdif_. >=6 KAT assertions on the module's own return values.
import std/testing/diff

// cki: check int/bool equality; prints FAIL + exits on mismatch.
fn cki(name: string, got: int, want: int)
    if got != want
        print("FAIL " + name + ": got " + str(got) + " want " + str(want))
        exit(1)

// cks: check string equality; prints FAIL + exits on mismatch.
fn cks(name: string, got: string, want: string)
    if got != want
        print("FAIL " + name + ": got '" + got + "' want '" + want + "'")
        exit(1)

// ckb: check bool; prints FAIL + exits when condition is false.
fn ckb(name: string, cond: bool)
    if not cond
        print("FAIL " + name)
        exit(1)

fn main()
    // ── tdif_equal scalar tests ───────────────────────────────────────────────
    ckb("equal int==int", tdif_equal(2, 2))
    ckb("equal int!=int false", not tdif_equal(2, 3))
    ckb("equal string==string", tdif_equal("a", "a"))
    ckb("equal string!=string false", not tdif_equal("a", "b"))

    // ── tdif_equal list tests ─────────────────────────────────────────────────
    ckb("equal [1,2]==[1,2]", tdif_equal([1, 2], [1, 2]))
    ckb("equal [1,2]!=[1,3] false", not tdif_equal([1, 2], [1, 3]))
    ckb("equal []!=[] true", tdif_equal([], []))
    ckb("equal [1]!=[1,2] false", not tdif_equal([1], [1, 2]))

    // ── tdif_equal dict tests ─────────────────────────────────────────────────
    ckb("equal {a:1}=={a:1}", tdif_equal({"a": 1}, {"a": 1}))
    ckb("equal {a:1}!={a:2} false", not tdif_equal({"a": 1}, {"a": 2}))
    ckb("equal {a:1}!={b:1} false", not tdif_equal({"a": 1}, {"b": 1}))

    // ── tdif_values tests ─────────────────────────────────────────────────────
    // Equal scalars -> empty string.
    cks("values equal scalars", tdif_values(2, 2), "")
    // Unequal scalars -> non-empty and contains "3".
    let v23 = tdif_values(2, 3)
    ckb("values(2,3) non-empty", len(v23) > 0)
    // Check the string contains "3" by scanning.
    let found3 = false
    let vi = 0
    while vi < len(v23)
        if v23[vi] == "3"
            found3 = true
        vi = vi + 1
    ckb("values(2,3) contains 3", found3)

    // Equal lists -> empty string.
    cks("values equal lists", tdif_values([1, 2], [1, 2]), "")
    // Unequal lists -> non-empty.
    let vl = tdif_values([1, 2], [1, 9])
    ckb("values unequal lists non-empty", len(vl) > 0)

    // ── tdif_lists tests ──────────────────────────────────────────────────────
    // [1,2,3] vs [1,5,3]: index 1 differs.
    let dl1 = tdif_lists([1, 2, 3], [1, 5, 3])
    cki("lists [1,2,3]vs[1,5,3] count", len(dl1), 1)
    cki("lists [1,2,3]vs[1,5,3] idx", dl1[0], 1)

    // [1,2] vs [1,2]: no differences.
    let dl2 = tdif_lists([1, 2], [1, 2])
    cki("lists equal count", len(dl2), 0)

    // [1,2] vs [1,2,3]: length mismatch -> index 2 flagged.
    let dl3 = tdif_lists([1, 2], [1, 2, 3])
    cki("lists length-mismatch count", len(dl3), 1)
    cki("lists length-mismatch idx", dl3[0], 2)

    // All same but different lengths.
    let dl4 = tdif_lists([5, 5], [5, 5, 5])
    cki("lists len-only count", len(dl4), 1)

    // ── tdif_summary tests ────────────────────────────────────────────────────
    cks("summary equal scalars", tdif_summary(7, 7), "EQUAL")
    cks("summary equal lists", tdif_summary([1, 2], [1, 2]), "EQUAL")
    let sum_ne = tdif_summary(1, 2)
    ckb("summary unequal non-empty", len(sum_ne) > 0)
    ckb("summary unequal starts DIFF", sum_ne[0] == "D")

    // List with 2 differing indices.
    let diffs2 = tdif_summary([1, 0, 3, 0], [1, 9, 3, 9])
    cks("summary 2 diffs", diffs2, "DIFF: 2 difference(s)")

    // ── edge cases ────────────────────────────────────────────────────────────
    // In NOVA, null and 0 share the same int type; both == comparisons hold.
    ckb("equal null==null", tdif_equal(null, null))
    ckb("equal 0==null (NOVA int-null unified)", tdif_equal(0, null))
    ckb("equal nested lists", tdif_equal([1, [2, 3]], [1, [2, 3]]))
    ckb("equal nested lists mismatch", not tdif_equal([1, [2, 3]], [1, [2, 4]]))

    print("_tdiff_test passed")
