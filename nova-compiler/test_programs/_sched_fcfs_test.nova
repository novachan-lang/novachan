import std/scheduling/sched_fcfs

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL sched_fcfs " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(label: string, got: list, want: list)
    let ng = len(got)
    let nw = len(want)
    if ng != nw
        print("FAIL sched_fcfs " + label + ": len got=" + str(ng) + " want=" + str(nw))
        exit(1)
    let i = 0
    while i < nw
        if got[i] != want[i]
            print("FAIL sched_fcfs " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // KAT 1: basic 3-process all-arrive-at-0
    // fc_completion_times([[0,24],[0,3],[0,3]]) = [24,27,30]
    let p1 = []
    let p1a = []
    push(p1a, 0)
    push(p1a, 24)
    push(p1, p1a)
    let p1b = []
    push(p1b, 0)
    push(p1b, 3)
    push(p1, p1b)
    let p1c = []
    push(p1c, 0)
    push(p1c, 3)
    push(p1, p1c)
    let w1 = []
    push(w1, 24)
    push(w1, 27)
    push(w1, 30)
    ckl("completion_basic", fc_completion_times(p1), w1)

    // KAT 2: waiting times [[0,24],[0,3],[0,3]] = [0,24,27]
    let w2 = []
    push(w2, 0)
    push(w2, 24)
    push(w2, 27)
    ckl("waiting_basic", fc_waiting_times(p1), w2)

    // KAT 3: order [[0,24],[0,3],[0,3]] = [0,1,2]
    let w3 = []
    push(w3, 0)
    push(w3, 1)
    push(w3, 2)
    ckl("order_basic", fc_order(p1), w3)

    // KAT 4: with idle gap [[0,4],[6,3]] = [4,9]
    let p2 = []
    let p2a = []
    push(p2a, 0)
    push(p2a, 4)
    push(p2, p2a)
    let p2b = []
    push(p2b, 6)
    push(p2b, 3)
    push(p2, p2b)
    let w4 = []
    push(w4, 4)
    push(w4, 9)
    ckl("completion_idle", fc_completion_times(p2), w4)

    // KAT 5: waiting with idle — P0 wait=0, P1 wait=9-6-3=0
    let w5 = []
    push(w5, 0)
    push(w5, 0)
    ckl("waiting_idle", fc_waiting_times(p2), w5)

    // KAT 6: turnaround — P0=4-0=4, P1=9-6=3
    let w6 = []
    push(w6, 4)
    push(w6, 3)
    ckl("turnaround_idle", fc_turnaround_times(p2), w6)

    // KAT 7: empty input
    let p3 = []
    ckl("completion_empty", fc_completion_times(p3), p3)
    ckl("order_empty", fc_order(p3), p3)

    // KAT 8: arrival order differs from PID order — P0 arrives at 5, P1 at 2
    // Order should be: P1 first, then P0
    let p4 = []
    let p4a = []
    push(p4a, 5)
    push(p4a, 3)
    push(p4, p4a)
    let p4b = []
    push(p4b, 2)
    push(p4b, 4)
    push(p4, p4b)
    // P1 runs t=2..6, P0 runs t=6..9
    let w8c = []
    push(w8c, 9)
    push(w8c, 6)
    ckl("completion_arrival_order", fc_completion_times(p4), w8c)
    let w8o = []
    push(w8o, 1)
    push(w8o, 0)
    ckl("order_arrival_order", fc_order(p4), w8o)

    print("PASS _sched_fcfs_test")
