// KAT for std/encoding/thrift — Apache Thrift TBinaryProtocol (STRICT) codec
// against hand-derived byte-exact vectors from the Apache Thrift spec shape.
// Fail-fast-with-location style (same proven idiom as bsonkat.nova / the
// _cbor_rfc8949_kat.nova convention) — NOVA `fn` closures do not reliably
// share mutation of an outer scalar/dict counter, so a deferred
// failure-count pattern silently under-reports.
import std/encoding/thrift

fn ckb(label: string, b: any, expected: list)
    let blen = bytes_len(b)
    let elen = len(expected)
    if blen != elen
        print("FAIL " + label + "_len: got " + str(blen) + " want " + str(elen))
        exit(1)
    let i = 0
    while i < elen
        let got = bytes_get(b, i)
        let want = expected[i]
        if got != want
            print("FAIL " + label + "_b" + str(i) + ": got " + str(got) + " want " + str(want))
            exit(1)
        i = i + 1
    print("PASS " + label + "_bytes")

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("PASS " + label)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got '" + got + "' want '" + want + "'")
        exit(1)
    print("PASS " + label)

fn ckf(label: string, got: float, want: float)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("PASS " + label)

fn main()
    // ── KAT 1: message header for "ping" CALL(1) seqid 1 ────────────────────
    // 80 01 00 01 00 00 00 04 70 69 6E 67 00 00 00 01  (then a STOP 00 for
    // the empty-args body, since fields=[]).
    let msg1 = thrift_encode_message("ping", tmt_call(), 1, [])
    let expect1 = [0x80, 0x01, 0x00, 0x01, 0x00, 0x00, 0x00, 0x04, 0x70, 0x69, 0x6E, 0x67, 0x00, 0x00, 0x00, 0x01, 0x00]
    ckb("ping_header", msg1, expect1)
    cki("ping_header_len", bytes_len(msg1), 17)

    let dm1 = thrift_decode_message(msg1)
    cki("ping_dec_ok", dm1["ok"], 1)
    cki("ping_dec_mtype", dm1["mtype"], tmt_call())
    cks("ping_dec_name", dm1["name"], "ping")
    cki("ping_dec_seqid", dm1["seqid"], 1)
    cki("ping_dec_fields_len", len(dm1["fields"]), 0)
    cki("ping_dec_next_pos", dm1["next_pos"], 17)

    // ── KAT 2: struct field i32 (field-id 1, value 42) ──────────────────────
    // 08 00 01 00 00 00 2A 00
    let s2 = thrift_encode_struct([thrift_field_i32(1, 42)])
    let expect2 = [0x08, 0x00, 0x01, 0x00, 0x00, 0x00, 0x2A, 0x00]
    ckb("i32_field", s2, expect2)
    let d2 = thrift_decode_struct(s2, 0)
    let f2 = d2[0]
    cki("i32_field_dec_len", len(f2), 1)
    cki("i32_field_dec_id", f2[0]["id"], 1)
    cki("i32_field_dec_ttype", f2[0]["ttype"], tt_i32())
    cki("i32_field_dec_value", f2[0]["value"], 42)
    cki("i32_field_dec_next", d2[1], 8)

    // ── KAT 3: STRING field, field-id 2, value "hi" ─────────────────────────
    // 0B 00 02 00 00 00 02 68 69 00
    let s3 = thrift_encode_struct([thrift_field_string(2, "hi")])
    let expect3 = [0x0B, 0x00, 0x02, 0x00, 0x00, 0x00, 0x02, 0x68, 0x69, 0x00]
    ckb("string_field", s3, expect3)
    let d3 = thrift_decode_struct(s3, 0)
    let f3 = d3[0]
    cks("string_field_dec_value", thrift_str(f3[0]["value"]), "hi")

    // ── KAT 4: BOOL field TRUE(1) and FALSE(0), field-id 3 ──────────────────
    // TRUE:  02 00 03 01 00
    // FALSE: 02 00 03 00 00
    let s4t = thrift_encode_struct([thrift_field_bool(3, 1)])
    ckb("bool_true", s4t, [0x02, 0x00, 0x03, 0x01, 0x00])
    let s4f = thrift_encode_struct([thrift_field_bool(3, 0)])
    ckb("bool_false", s4f, [0x02, 0x00, 0x03, 0x00, 0x00])
    let d4t = thrift_decode_struct(s4t, 0)
    cki("bool_true_dec", d4t[0][0]["value"], 1)
    let d4f = thrift_decode_struct(s4f, 0)
    cki("bool_false_dec", d4f[0][0]["value"], 0)
    // bool truthiness dispatch: a nonzero int also normalizes to TRUE(1).
    let s4nz = thrift_encode_struct([thrift_field_bool(3, 7)])
    ckb("bool_nonzero_normalizes", s4nz, [0x02, 0x00, 0x03, 0x01, 0x00])

    // ── KAT 5: LIST of i32 [1,2,3], field-id 4 ──────────────────────────────
    // 0F 00 04 08 00 00 00 03 00 00 00 01 00 00 00 02 00 00 00 03 00
    let s5 = thrift_encode_struct([thrift_field_list(4, tt_i32(), [1, 2, 3])])
    let expect5 = [0x0F, 0x00, 0x04, 0x08, 0x00, 0x00, 0x00, 0x03, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x02, 0x00, 0x00, 0x00, 0x03, 0x00]
    ckb("list_i32", s5, expect5)
    let d5 = thrift_decode_struct(s5, 0)
    let lv5 = d5[0][0]["value"]
    cki("list_i32_etype", lv5["etype"], tt_i32())
    cki("list_i32_len", len(lv5["items"]), 3)
    cki("list_i32_0", lv5["items"][0], 1)
    cki("list_i32_1", lv5["items"][1], 2)
    cki("list_i32_2", lv5["items"][2], 3)

    // ── KAT 6: decode round-trip — i64 extremes + double + negative i16/i32
    let big = 9223372036854775807
    let small = 0 - 9223372036854775807 - 1
    let fields6 = [thrift_field_i64(1, big), thrift_field_i64(2, small), thrift_field_double(3, 3.14159265358979), thrift_field_double(4, 0.0 - 2.5), thrift_field_i16(5, 0 - 32768), thrift_field_i16(6, 32767), thrift_field_i32(7, 0 - 2147483648), thrift_field_byte(8, 0 - 128), thrift_field_byte(9, 127)]
    let s6 = thrift_encode_struct(fields6)
    let d6 = thrift_decode_struct(s6, 0)
    let r6 = d6[0]
    cki("i64_max_rt", r6[0]["value"], big)
    cki("i64_min_rt", r6[1]["value"], small)
    ckf("double_pi_rt", r6[2]["value"], 3.14159265358979)
    ckf("double_neg_rt", r6[3]["value"], 0.0 - 2.5)
    cki("i16_min_rt", r6[4]["value"], 0 - 32768)
    cki("i16_max_rt", r6[5]["value"], 32767)
    cki("i32_min_rt", r6[6]["value"], 0 - 2147483648)
    cki("byte_min_rt", r6[7]["value"], 0 - 128)
    cki("byte_max_rt", r6[8]["value"], 127)

    // ── KAT 7: SET, MAP, nested STRUCT round trip ───────────────────────────
    let pairs7 = [["a", 1], ["b", 2]]
    let inner7 = [thrift_field_i32(1, 100), thrift_field_string(2, "leaf")]
    let fields7 = [thrift_field_set(1, tt_i32(), [5, 6, 7]), thrift_field_map(2, tt_string(), tt_i32(), pairs7), thrift_field_struct(3, inner7)]
    let s7 = thrift_encode_struct(fields7)
    let d7 = thrift_decode_struct(s7, 0)
    let r7 = d7[0]
    let setv = r7[0]["value"]
    cki("set_etype", setv["etype"], tt_i32())
    cki("set_len", len(setv["items"]), 3)
    cki("set_1", setv["items"][1], 6)
    let mapv = r7[1]["value"]
    cki("map_ktype", mapv["ktype"], tt_string())
    cki("map_vtype", mapv["vtype"], tt_i32())
    cki("map_len", len(mapv["pairs"]), 2)
    cks("map_key0", thrift_str(mapv["pairs"][0][0]), "a")
    cki("map_val0", mapv["pairs"][0][1], 1)
    cks("map_key1", thrift_str(mapv["pairs"][1][0]), "b")
    cki("map_val1", mapv["pairs"][1][1], 2)
    let structv = r7[2]["value"]
    cki("nested_struct_len", len(structv), 2)
    cki("nested_struct_i32", structv[0]["value"], 100)
    cks("nested_struct_str", thrift_str(structv[1]["value"]), "leaf")

    // ── KAT 8: empty struct, empty string, empty list round trip ────────────
    let s8 = thrift_encode_struct([])
    ckb("empty_struct", s8, [0x00])
    let s8b = thrift_encode_struct([thrift_field_string(1, ""), thrift_field_list(2, tt_i32(), [])])
    let d8b = thrift_decode_struct(s8b, 0)
    cks("empty_string_rt", thrift_str(d8b[0][0]["value"]), "")
    cki("empty_list_rt", len(d8b[0][1]["value"]["items"]), 0)

    // ── KAT 9: injection guard — a string field value with an embedded 0x00
    // byte must round-trip EXACTLY (never truncated, never split into two
    // fields on the wire). Built as raw `bytes` since a NOVA string cannot
    // hold an embedded NUL.
    let inj = bytes_create(3)
    bytes_set(inj, 0, 0x41)
    bytes_set(inj, 1, 0x00)
    bytes_set(inj, 2, 0x42)
    let s9 = thrift_encode_struct([thrift_field_string(1, inj), thrift_field_i32(2, 999)])
    let d9 = thrift_decode_struct(s9, 0)
    cki("injection_field_count", len(d9[0]), 2)
    let gotbytes = d9[0][0]["value"]
    cki("injection_len", bytes_len(gotbytes), 3)
    cki("injection_b0", bytes_get(gotbytes, 0), 0x41)
    cki("injection_b1", bytes_get(gotbytes, 1), 0x00)
    cki("injection_b2", bytes_get(gotbytes, 2), 0x42)
    cki("injection_second_field_intact", d9[0][1]["value"], 999)

    // ── KAT 10: malformed input never crashes (checklist item 9) ────────────
    // Truncated message (only 2 bytes) -> ok=0, safe defaults, no exit.
    let trunc = bytes_create(2)
    bytes_set(trunc, 0, 0x80)
    bytes_set(trunc, 1, 0x01)
    let dtr = thrift_decode_message(trunc)
    cki("truncated_msg_ok", dtr["ok"], 0)
    cki("truncated_msg_fields_len", len(dtr["fields"]), 0)

    // Non-VERSION_1 header -> ok=0, no crash.
    let bad = bytes_create(8)
    bytes_set(bad, 0, 0x00)
    bytes_set(bad, 1, 0x00)
    bytes_set(bad, 2, 0x00)
    bytes_set(bad, 3, 0x01)
    let dbad = thrift_decode_message(bad)
    cki("nonversion1_ok", dbad["ok"], 0)

    // Struct with a declared field-id-3 header but truncated right after the
    // type byte (missing field-id + value bytes) -> decode stops gracefully,
    // never reads out of bounds, never crashes.
    let trstruct = bytes_create(1)
    bytes_set(trstruct, 0, 0x08)
    let dtrs = thrift_decode_struct(trstruct, 0)
    cki("truncated_struct_fields_len", len(dtrs[0]), 0)

    // A LIST field declaring a huge (clearly-bogus) element count in a tiny
    // buffer must clamp to what's actually available, not try to allocate
    // billions of list entries.
    let hugelist = bytes_create(9)
    bytes_set(hugelist, 0, 0x0F)
    bytes_set(hugelist, 1, 0x00)
    bytes_set(hugelist, 2, 0x01)
    bytes_set(hugelist, 3, 0x08)
    bytes_set(hugelist, 4, 0x7F)
    bytes_set(hugelist, 5, 0xFF)
    bytes_set(hugelist, 6, 0xFF)
    bytes_set(hugelist, 7, 0xFF)
    bytes_set(hugelist, 8, 0x00)
    let dhl = thrift_decode_struct(hugelist, 0)
    let hlv = dhl[0][0]["value"]
    cki("huge_list_clamped", len(hlv["items"]) < 10, 1)

    // ── KAT 11: thrift_struct_get lookup ────────────────────────────────────
    let s11 = thrift_encode_struct([thrift_field_i32(5, 55), thrift_field_i32(9, 99)])
    let d11 = thrift_decode_struct(s11, 0)
    let sg = d11[0]
    let got9 = thrift_struct_get(sg, 9)
    cki("struct_get_found", got9["value"], 99)
    let got_missing = thrift_struct_get(sg, 123)
    cki("struct_get_missing_is_null", got_missing == null, 1)

    // ── KAT 12: message truncated AFTER the 4-byte version/type header must
    // report ok=0 — NOT fabricate name="" / seqid=0 as if that were a valid
    // decode (the defect this KAT locks down: bytes_get on an out-of-range
    // offset silently returns 0, which previously masqueraded as success).
    let hdronly = bytes_create(4)
    bytes_set(hdronly, 0, 0x80)
    bytes_set(hdronly, 1, 0x01)
    bytes_set(hdronly, 2, 0x00)
    bytes_set(hdronly, 3, 0x01)
    let dho = thrift_decode_message(hdronly)
    cki("header_only_msg_ok", dho["ok"], 0)
    cks("header_only_msg_name", dho["name"], "")
    cki("header_only_msg_seqid", dho["seqid"], 0)

    // Header + only 2 of the 4 name-length-prefix bytes present.
    let partlen = bytes_create(6)
    bytes_set(partlen, 0, 0x80)
    bytes_set(partlen, 1, 0x01)
    bytes_set(partlen, 2, 0x00)
    bytes_set(partlen, 3, 0x01)
    bytes_set(partlen, 4, 0x00)
    bytes_set(partlen, 5, 0x00)
    let dpl = thrift_decode_message(partlen)
    cki("partial_namelen_msg_ok", dpl["ok"], 0)

    // Header + full 4-byte name-length prefix declaring length 4, but only 2
    // name bytes actually present (name payload truncated).
    let partname = bytes_create(10)
    bytes_set(partname, 0, 0x80)
    bytes_set(partname, 1, 0x01)
    bytes_set(partname, 2, 0x00)
    bytes_set(partname, 3, 0x01)
    bytes_set(partname, 4, 0x00)
    bytes_set(partname, 5, 0x00)
    bytes_set(partname, 6, 0x00)
    bytes_set(partname, 7, 0x04)
    bytes_set(partname, 8, 0x70)
    bytes_set(partname, 9, 0x69)
    let dpn = thrift_decode_message(partname)
    cki("partial_name_bytes_msg_ok", dpn["ok"], 0)

    // Header + complete 2-byte name "hi" but the trailing 4-byte seqid is
    // entirely missing.
    let noseqid = bytes_create(10)
    bytes_set(noseqid, 0, 0x80)
    bytes_set(noseqid, 1, 0x01)
    bytes_set(noseqid, 2, 0x00)
    bytes_set(noseqid, 3, 0x01)
    bytes_set(noseqid, 4, 0x00)
    bytes_set(noseqid, 5, 0x00)
    bytes_set(noseqid, 6, 0x00)
    bytes_set(noseqid, 7, 0x02)
    bytes_set(noseqid, 8, 0x68)
    bytes_set(noseqid, 9, 0x69)
    let dns = thrift_decode_message(noseqid)
    cki("missing_seqid_msg_ok", dns["ok"], 0)

    // A COMPLETE message must still decode ok=1 with the correct name,
    // mtype, and seqid — the bounds-check must not reject valid input.
    let full12 = thrift_encode_message("probe", tmt_reply(), 77, [thrift_field_i32(1, 5)])
    let dfull12 = thrift_decode_message(full12)
    cki("complete_msg_ok", dfull12["ok"], 1)
    cks("complete_msg_name", dfull12["name"], "probe")
    cki("complete_msg_mtype", dfull12["mtype"], tmt_reply())
    cki("complete_msg_seqid", dfull12["seqid"], 77)
    cki("complete_msg_fields_len", len(dfull12["fields"]), 1)
    cki("complete_msg_field_value", dfull12["fields"][0]["value"], 5)

    print("thrift KAT: ALL PASS")
