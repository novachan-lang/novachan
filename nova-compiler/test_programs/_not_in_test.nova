fn main()
    let xs = [1, 2, 3, 4, 5]
    assert(3 in xs, "3 in xs")
    assert(6 not in xs, "6 not in xs")
    assert(not (3 not in xs), "not (3 not in xs)")

    let d = {"a": 1, "b": 2}
    assert("a" in d, "a in d")
    assert("c" not in d, "c not in d")

    assert("hello" in "hello world", "substr in")
    assert("xyz" not in "hello world", "substr not in")

    let empty = []
    assert(1 not in empty, "1 not in empty")

    print("not_in_test: all passed")
