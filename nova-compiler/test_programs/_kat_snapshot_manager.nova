import forge_snapshot_manager

fn main()
    let s = snap_new()
    s = snap_save(s, "v1", "state_a")
    s = snap_save(s, "v2", "state_b")
    assert(snap_count(s) == 2, "2 snapshots")

    let g1 = snap_get(s, 0)
    assert(is_ok(g1), "get 0 ok")
    assert(unwrap(g1) == "state_a", "data 0")

    let n1 = snap_name(s, 1)
    assert(is_ok(n1), "name 1 ok")
    assert(unwrap(n1) == "v2", "name=v2")

    let lat = snap_latest(s)
    assert(is_ok(lat), "latest ok")
    assert(unwrap(lat) == "state_b", "latest=state_b")

    let r = snap_restore(s, 0)
    assert(is_ok(r), "restore ok")
    assert(unwrap(r) == "state_a", "restored state_a")
    assert(snap_restore_count(s) == 1, "1 restore")

    let bad = snap_get(s, 5)
    assert(is_err(bad), "out of range")

    print("SNAPSHOT-MANAGER KAT PASS")
