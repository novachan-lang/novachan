// _n1_cap_closure_test -- exercises the CLOSURE-record rc_dec at finish (the residual-leak fix) under
// ASAN with NOVA_SCHED_RECLAIM_TASK=1. Each iteration sched_spawns a CAPTURING closure (captures `cap`)
// -> an RC'd closure record stored as the fiber's entry_fn. At finish the runtime rc_dec's it (the task
// is its sole owner -- the spawn arg escaped). If that rc_dec over-freed a still-referenced closure it
// would be a double-free; ASAN catches it even when it doesn't crash. We monitor each task to confirm it
// ran (sum carries the captured values back), and assert all completed. Run at NOVA_CARRIERS=4 + ASAN.
fn capworker(x: int) -> int
    x + 1

fn main()
    let n = 2000
    let i = 0
    let sum = 0
    let done = 0
    while i < n
        let cap = i + 7
        let p = sched_spawn(fn() capworker(cap))   // capturing closure via sched_spawn (the forge serve path)
        let st = receive(monitor(p))
        sum = sum + st
        done = done + 1
        i = i + 1
    assert(done == n, "all capturing-closure spawns completed (got " + str(done) + ")")
    print("PASS cap_closure: " + str(done) + " capturing-closure spawn/finish cycles, status sum=" + str(sum))
