// litbox_test — bool/float values in LIST and DICT literals are boxed (NovaBox)
// just like push/index-set already box them. Guards two real silent bugs:
//   [true, false]  rendered  [1, 0]
//   {"k": true}    rendered  {"k":1}
//   {"k": 1.5}     rendered  a giant-int garbage value
// (literal path never boxed; only the assignment path did).

fn main()
    let q = chr(34)
    let lb = chr(123)
    let rb = chr(125)

    // (B) bool/float in list literals render correctly
    assert_eq(str([true, false]), "[true, false]")
    assert_eq(str([1.5, 2.5]), "[1.5, 2.5]")
    assert_eq(str([true, 1, false]), "[true, 1, false]")   // mixed bool/int

    // value access through a list literal
    let bl = [true, false]
    assert(bl[0] == true, "elem0 is true")
    assert(bl[1] == false, "elem1 is false")

    // (C) bool/float in dict literals render correctly
    assert_eq(str({"flag": true}), lb + q + "flag" + q + ":true" + rb)
    assert_eq(str({"pi": 1.5}), lb + q + "pi" + q + ":1.5" + rb)

    // value access through a dict literal
    let d = {"a": true, "b": 2.5}
    assert_eq(d["a"], true)
    assert_near(d["b"], 2.5, 0.0001)

    // literal == assignment-built (both boxed now)
    let d2 = {}
    d2["a"] = true
    d2["b"] = 2.5
    assert_eq(d, d2)

    print("litbox_test passed")
