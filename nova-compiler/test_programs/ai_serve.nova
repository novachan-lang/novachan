// NOVA full-stack demonstration: an AI inference HTTP service in ONE language.
// Composes the real pieces — HTTP server + routing + JSON + tensor inference.
// POST /predict {"features":[x1,x2]} -> {"class": k} (matmul -> softmax -> argmax).

fn softmax(xs: list) -> list
    let m = xs[0]
    for x in xs
        if x > m
            m = x
    let exps = xs.map(fn(x) exp(x - m))
    let total = 0.0
    for e in exps
        total = total + e
    exps.map(fn(e) e / total)

fn argmax(xs: list) -> int
    let best = 0
    let bestv = xs[0]
    let i = 1
    while i < len(xs)
        if xs[i] > bestv
            bestv = xs[i]
            best = i
        i = i + 1
    best

fn load_matrix(path: string)
    let content = read_file(path)
    let lines = split(content, "\n")
    let dims = split(lines[0], " ")
    let rows = parse_int(dims[0])
    let cols = parse_int(dims[1])
    let flat = []
    let r = 1
    while r <= rows
        let vals = split(lines[r], " ")
        for v in vals
            if len(v) > 0
                flat.push(parse_float(v))
        r = r + 1
    tensor_from_list(flat, [rows, cols])

fn predict(w, features: list) -> int
    let n = len(features)
    let x = tensor_from_list(features, [1, n])
    let logits = tensor_to_list(tensor_matmul(x, w))
    argmax(softmax(logits))

fn req_method(raw: string) -> string
    let sp = find(raw, " ")
    if sp < 0
        return ""
    slice(raw, 0, sp)

fn req_path(raw: string) -> string
    let sp1 = find(raw, " ")
    let rest = slice(raw, sp1 + 1, len(raw))
    let sp2 = find(rest, " ")
    if sp2 < 0
        return rest
    slice(rest, 0, sp2)

fn req_body(raw: string) -> string
    let idx = find(raw, "\r\n\r\n")
    if idx < 0
        return ""
    slice(raw, idx + 4, len(raw))

fn build_response(status: int, body: string) -> string
    let sl = "200 OK"
    if status == 404
        sl = "404 Not Found"
    "HTTP/1.1 " + sl + "\r\nContent-Type: application/json\r\nContent-Length: " + str(len(body)) + "\r\nConnection: close\r\n\r\n" + body

fn main()
    let argv = args()
    // Port resolution order: $PORT env (cloud platforms like Railway set this) →
    // argv[1] → default. Reading the env directly avoids relying on the platform
    // shell-expanding ${PORT} in its start command.
    let port = 8080
    let ep = parse_int(env("PORT"))
    if ep > 0
        port = ep
    else if len(argv) > 1
        let ap = parse_int(argv[1])
        if ap > 0
            port = ap
    // 2-input -> 3-class linear model, persisted then loaded (real model file)
    write_file("serve_w.txt", "2 3\n1.0 2.0 0.0\n0.0 1.0 1.0\n")
    let w = load_matrix("serve_w.txt")
    let sock = http_listen(port)
    print("AI inference server listening on {port}")
    let running = 1
    while running == 1
        let conn = http_accept_raw(sock)
        if len(conn) == 0
            continue
        let client = conn[0]
        let raw = conn[1]
        let method = req_method(raw)
        let path = req_path(raw)
        if method == "POST" and path == "/predict"
            let parsed = json_decode(req_body(raw))
            let features = parsed["features"]
            let cls = predict(w, features)
            http_send_raw(client, build_response(200, "\{\"class\": {cls}\}"))
        else if path == "/stop"
            http_send_raw(client, build_response(200, "\{\"ok\": true\}"))
            running = 0
        else
            http_send_raw(client, build_response(404, "\{\"error\": \"not found\"\}"))
