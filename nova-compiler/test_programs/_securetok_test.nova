// KAT for std/crypto/securetok — property and determinism tests for secure token generation.
import std/crypto/securetok

// Approximate float equality (for entropy test).
fn approx(a: float, b: float, tol: float) -> bool
    let diff = a - b
    if diff < 0.0
        diff = 0.0 - diff
    diff < tol

fn check_b(label: string, got: bool, want: bool)
    if got != want
        print("FAIL securetok " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn check_i(label: string, got: int, want: int)
    if got != want
        print("FAIL securetok " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn check_s(label: string, got: string, want: string)
    if got != want
        print("FAIL securetok " + label + ": got=" + got + " want=" + want)
        exit(1)

// Check all chars in s are in the given alphabet string.
fn all_in(s: string, alpha: string) -> bool
    let n = len(s)
    let i = 0
    while i < n
        let c = char_at(s, i)
        let found = false
        let j = 0
        let al = len(alpha)
        while j < al
            if char_at(alpha, j) == c
                found = true
            j = j + 1
        if not found
            return false
        i = i + 1
    true

fn main()
    // --- stok_ct_eq ---
    check_b("ct_eq-same", stok_ct_eq("abc123", "abc123"), true)
    check_b("ct_eq-diff-char", stok_ct_eq("abc123", "abc124"), false)
    check_b("ct_eq-diff-len", stok_ct_eq("abc", "abcd"), false)
    check_b("ct_eq-empty", stok_ct_eq("", ""), true)
    check_b("ct_eq-empty-nonempty", stok_ct_eq("", "a"), false)

    // --- stok_ct_bytes_eq ---
    let ba = [1, 2, 3]
    let bb = [1, 2, 3]
    let bc = [1, 2, 4]
    let bd = [1, 2]
    check_b("ct_bytes_eq-same", stok_ct_bytes_eq(ba, bb), true)
    check_b("ct_bytes_eq-diff", stok_ct_bytes_eq(ba, bc), false)
    check_b("ct_bytes_eq-len", stok_ct_bytes_eq(ba, bd), false)

    // --- stok_is_hex ---
    let h16 = stok_hex(16, 7)
    check_b("is_hex-valid", stok_is_hex(h16), true)
    check_i("hex-len-16bytes", len(h16), 32)
    check_b("is_hex-invalid", stok_is_hex("0x1g2z"), false)
    check_b("is_hex-empty", stok_is_hex(""), true)
    check_b("is_hex-upper", stok_is_hex("DEADBEEF"), true)
    check_b("is_hex-lower", stok_is_hex("deadbeef"), true)

    // --- stok_hex determinism ---
    let h8a = stok_hex(8, 99)
    let h8b = stok_hex(8, 99)
    check_s("hex-determinism", h8a, h8b)
    check_i("hex-len-8bytes", len(h8a), 16)

    // different seeds -> different outputs (with overwhelmingly high probability)
    let h8c = stok_hex(8, 100)
    if h8a == h8c
        print("FAIL securetok hex-seed-independence: seeds 99 and 100 produce same token")
        exit(1)

    // --- stok_mask ---
    check_s("mask-basic", stok_mask("secret42", 2), "******42")
    check_s("mask-all", stok_mask("abc", 0), "***")
    check_s("mask-none", stok_mask("abc", 3), "abc")
    check_s("mask-over", stok_mask("ab", 5), "ab")
    check_s("mask-empty", stok_mask("", 0), "")

    // --- stok_len_hex ---
    check_i("len_hex-20", stok_len_hex(20), 40)
    check_i("len_hex-0", stok_len_hex(0), 0)
    check_i("len_hex-1", stok_len_hex(1), 2)

    // --- stok_alnum ---
    let alnum = stok_alnum(10, 5)
    check_i("alnum-len", len(alnum), 10)
    let alnum_alpha = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
    check_b("alnum-charset", all_in(alnum, alnum_alpha), true)
    let alnum2 = stok_alnum(10, 5)
    check_s("alnum-determinism", alnum, alnum2)

    // --- stok_urlsafe ---
    let url = stok_urlsafe(16, 42)
    check_i("urlsafe-len", len(url), 16)
    let url_alpha = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
    check_b("urlsafe-charset", all_in(url, url_alpha), true)
    let url2 = stok_urlsafe(16, 42)
    check_s("urlsafe-determinism", url, url2)

    // --- stok_numeric ---
    let num = stok_numeric(8, 13)
    check_i("numeric-len", len(num), 8)
    check_b("numeric-charset", all_in(num, "0123456789"), true)
    let num2 = stok_numeric(8, 13)
    check_s("numeric-determinism", num, num2)

    // --- stok_entropy_bits: 8 chars from hex (charset_size=16) ~ 32.0 bits ---
    let ent = stok_entropy_bits(8, 16.0)
    if not approx(ent, 32.0, 0.01)
        print("FAIL securetok entropy_bits: got=" + str(ent) + " want~32.0")
        exit(1)

    print("PASS _securetok_test")
