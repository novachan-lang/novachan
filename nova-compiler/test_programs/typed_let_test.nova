// typed_let_test — optional type ascription on let bindings: `let x: T = e`.
// The annotation is checked against the inferred type of e and binds x at T.
// Its highest-value use is giving an element type to an empty collection that
// inference alone cannot pin down (`let xs: list<int> = []`).

fn main()
    // scalar ascriptions (redundant with inference, but legal + documentary)
    let n: int = 42
    assert_eq(n, 42)

    let pi: float = 3.5
    assert_near(pi, 3.5, 0.0001)

    let s: string = "nova"
    assert_eq(s, "nova")

    let flag: bool = true
    assert_eq(flag, true)

    // the key case: empty list/dict given a declared element/value type
    let xs: list<int> = []
    push(xs, 10)
    push(xs, 20)
    push(xs, 30)
    assert_eq(len(xs), 3)
    assert_eq(xs[1], 20)

    let names: list<string> = []
    push(names, "a")
    push(names, "b")
    assert_eq(len(names), 2)
    assert_eq(names[0], "a")

    let counts: dict<string, int> = {}
    counts["x"] = 1
    counts["y"] = 2
    assert_eq(counts["x"], 1)
    assert_eq(len(counts), 2)

    // ascription consistent with a fully-inferable rhs
    let total: int = 1 + 2 + 3
    assert_eq(total, 6)

    print("typed_let_test passed")
