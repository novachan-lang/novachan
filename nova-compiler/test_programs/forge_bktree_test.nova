import forge_bktree

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn joinl(xs: list) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + ","
        out = out + xs[i]
        i = i + 1
    out

fn main()
    let fails = 0

    let t = bk_new()
    bk_insert(t, "book")
    bk_insert(t, "books")
    bk_insert(t, "cake")
    bk_insert(t, "boo")
    bk_insert(t, "cook")
    bk_insert(t, "cape")
    bk_insert(t, "cart")
    bk_insert(t, "book")

    fails = fails + expect("size", str(bk_size(t)), "7")

    // within edit distance 1 of "book" -> boo, book, books, cook (sorted)
    fails = fails + expect("q_book1", joinl(bk_query(t, "book", 1)), "boo,book,books,cook")
    // exact only (dist 0)
    fails = fails + expect("q_book0", joinl(bk_query(t, "book", 0)), "book")
    // typo "caqe" within 1 -> cake, cape
    fails = fails + expect("q_caqe", joinl(bk_query(t, "caqe", 1)), "cake,cape")
    // "cook" within 1 -> book, cook
    fails = fails + expect("q_cook", joinl(bk_query(t, "cook", 1)), "book,cook")
    // nothing close
    fails = fails + expect("q_none", str(len(bk_query(t, "zzzzz", 1))), "0")
    // wide tolerance 2 around "book"
    fails = fails + expect("q_book2", joinl(bk_query(t, "book", 2)), "boo,book,books,cook")

    // spell-check style: suggest for "carte"
    fails = fails + expect("q_carte", joinl(bk_query(t, "carte", 1)), "cart")

    // sanity: brute-force cross-check for "cake" dist 2 equals the tree result set
    fails = fails + expect("q_cake2", joinl(bk_query(t, "cake", 2)), "cake,cape,cart")

    if fails == 0
        print("forge_bktree: all passed")
    else
        print("forge_bktree: " + str(fails) + " FAILED")
