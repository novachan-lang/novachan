import forge_header_map

fn main()
    let h = hm_new()
    h = hm_set(h, "Content-Type", "application/json")
    h = hm_set(h, "Authorization", "Bearer token123")
    assert(hm_header_count(h) == 2, "2 headers")

    let r1 = hm_get(h, "Content-Type")
    assert(is_ok(r1), "get ok")
    assert(unwrap(r1) == "application/json", "json ct")

    assert(hm_has(h, "Authorization") == 1, "has auth")
    assert(hm_has(h, "X-Custom") == 0, "no custom")

    h = hm_set(h, "Content-Type", "text/html")
    let r2 = hm_get(h, "Content-Type")
    assert(unwrap(r2) == "text/html", "updated")
    assert(hm_header_count(h) == 2, "still 2")

    let rm = hm_remove(h, "Authorization")
    assert(is_ok(rm), "remove ok")
    h = unwrap(rm)
    assert(hm_header_count(h) == 1, "1 after remove")

    let bad = hm_get(h, "nope")
    assert(is_err(bad), "not found")

    assert(hm_total_gets(h) == 3, "3 gets")

    print("HEADER-MAP KAT PASS")
