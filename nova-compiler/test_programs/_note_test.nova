// _note_test.nova — KAT for std/midi/note
//
// Known-answer tests for MIDI note utilities.
//
// HAND-VERIFIED VECTORS
//   Middle C  = note 60 = C4.  60 / 12 = 5, octave = 5-1 = 4, pc = 0 -> "C"
//   C#4       = note 61.       61 / 12 = 5, octave = 4,        pc = 1 -> "C#"
//   A4        = note 69.       69 / 12 = 5, octave = 4,        pc = 9 -> "A"
//   C-1       = note 0.        0  / 12 = 0, octave = -1,       pc = 0 -> "C"
//   G#5       = note 80.       80 / 12 = 6, octave = 5,        pc = 8 -> "G#"
//
//   note_freq_hz(69) = round(440.0 * 2^0)       = 440
//   note_freq_hz(60) = round(440.0 * 2^(-9/12)) = round(261.626) = 262
//   note_freq_hz(81) = round(440.0 * 2^(12/12)) = round(880.0)   = 880
//
//   transpose(60, 12) = 72  (one octave up)
//   note_octave(60)   = 4
//   note_pitchclass(61) = 1  (C#)

import std/midi/note

// ── check helpers ─────────────────────────────────────────────────────────────

fn cks(label, got, want)
    if got != want
        print("FAIL note " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL note " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ── main ─────────────────────────────────────────────────────────────────────

fn main()
    // ── note_name ─────────────────────────────────────────────────────────────
    cks("note_name(60)", note_name(60), "C4")
    cks("note_name(61)", note_name(61), "C#4")
    cks("note_name(69)", note_name(69), "A4")
    cks("note_name(0)",  note_name(0),  "C-1")

    // Additional spot-checks.
    cks("note_name(12)", note_name(12), "C0")
    cks("note_name(48)", note_name(48), "C3")
    cks("note_name(72)", note_name(72), "C5")
    cks("note_name(71)", note_name(71), "B4")
    cks("note_name(70)", note_name(70), "A#4")
    cks("note_name(80)", note_name(80), "G#5")

    // ── note_number ───────────────────────────────────────────────────────────
    cki("note_number(A4)",  note_number("A4"),  69)
    cki("note_number(C4)",  note_number("C4"),  60)
    cki("note_number(G#5)", note_number("G#5"), 80)
    cki("note_number(C-1)", note_number("C-1"), 0)
    cki("note_number(B4)",  note_number("B4"),  71)
    cki("note_number(C0)",  note_number("C0"),  12)

    // Invalid inputs must return -1.
    cki("note_number(invalid)", note_number("X4"), -1)
    cki("note_number(empty)",   note_number(""),   -1)

    // ── note_freq_hz ──────────────────────────────────────────────────────────
    cki("note_freq_hz(69)", note_freq_hz(69), 440)
    cki("note_freq_hz(60)", note_freq_hz(60), 262)
    cki("note_freq_hz(81)", note_freq_hz(81), 880)

    // Additional: A5 = note 81 is 880; A3 = note 57 should be 220.
    cki("note_freq_hz(57)", note_freq_hz(57), 220)

    // ── transpose ─────────────────────────────────────────────────────────────
    cki("transpose(60,12)",  transpose(60, 12), 72)
    cki("transpose(60,-12)", transpose(60, -12), 48)
    cki("transpose(60,0)",   transpose(60, 0),  60)
    // Clamp to 0..127.
    cki("transpose(0,-1)",   transpose(0, -1),  0)
    cki("transpose(127,1)",  transpose(127, 1), 127)

    // ── note_octave ───────────────────────────────────────────────────────────
    cki("note_octave(60)", note_octave(60), 4)
    cki("note_octave(0)",  note_octave(0),  -1)
    cki("note_octave(12)", note_octave(12), 0)
    cki("note_octave(69)", note_octave(69), 4)

    // ── note_pitchclass ───────────────────────────────────────────────────────
    cki("note_pitchclass(61)",  note_pitchclass(61), 1)
    cki("note_pitchclass(60)",  note_pitchclass(60), 0)
    cki("note_pitchclass(69)",  note_pitchclass(69), 9)
    cki("note_pitchclass(71)",  note_pitchclass(71), 11)
    cki("note_pitchclass(0)",   note_pitchclass(0),  0)

    // ── round-trip: note_name / note_number ───────────────────────────────────
    // For all standard notes across a few octaves, verify round-trip consistency.
    let rt_notes = [0, 12, 24, 36, 48, 60, 61, 62, 63, 64, 65, 66, 67, 68, 69, 70, 71, 72, 80, 127]
    let ri = 0
    while ri < len(rt_notes)
        let n = rt_notes[ri]
        let nm = note_name(n)
        let back = note_number(nm)
        if back != n
            print("FAIL note round-trip n=" + str(n) + " name=" + nm + " back=" + str(back))
            exit(1)
        ri = ri + 1

    print("PASS _note_test")
