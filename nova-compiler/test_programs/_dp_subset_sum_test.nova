import std/dp/dp_subset_sum

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _dp_subset_sum_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL _dp_subset_sum_test " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn ckl(label: string, got: list, want: list)
    cki(label + ".len", len(got), len(want))
    let i = 0
    while i < len(want)
        cki(label + "[" + str(i) + "]", got[i], want[i])
        i = i + 1

fn main()
    // ── ss_exists ────────────────────────────────────────────────────────────
    ckb("exists_9",    ss_exists([3, 34, 4, 12, 5, 2], 9),  true)
    ckb("exists_no7",  ss_exists([1, 2, 3], 7),              false)
    ckb("exists_empty0", ss_exists([], 0),                   true)
    ckb("exists_zero", ss_exists([1, 2, 3], 0),              true)
    ckb("exists_exact",ss_exists([1, 2, 3], 6),              true)
    ckb("exists_empty5", ss_exists([], 5),                   false)
    ckb("exists_single_yes", ss_exists([5], 5),              true)
    ckb("exists_single_no",  ss_exists([4], 5),              false)

    // ── ss_count ─────────────────────────────────────────────────────────────
    // [2,3,5,2] target 5: subsets {3,2(idx0)}, {3,2(idx3)}, {5} = 3
    cki("count_3",    ss_count([2, 3, 5, 2], 5), 3)
    // [1,1,1] target 2: C(3,2) = 3 distinct pairs
    cki("count_pairs",ss_count([1, 1, 1], 2),    3)
    // empty list, target 0: the empty subset counts
    cki("count_empty0", ss_count([], 0),          1)
    // target 0 with non-empty list: still just the empty subset = 1
    cki("count_zero", ss_count([1, 2, 3], 0),     1)
    // impossible
    cki("count_none", ss_count([1, 2], 5),         0)

    // ── ss_one ───────────────────────────────────────────────────────────────
    // target 0 -> empty subset
    let r0 = ss_one([1, 2, 3], 0)
    cki("one_zero_len", len(r0), 0)

    // impossible -> []
    let r_imp = ss_one([1, 2], 10)
    cki("one_imp_len", len(r_imp), 0)

    // empty list impossible -> []
    let r_empty = ss_one([], 5)
    cki("one_empty_len", len(r_empty), 0)

    // canonical: [3,34,4,12,5,2] target 9 -> some subset summing to 9
    let r9 = ss_one([3, 34, 4, 12, 5, 2], 9)
    // verify the returned subset is non-empty and actually sums to 9
    let rsum = 0
    let ri = 0
    while ri < len(r9)
        rsum = rsum + r9[ri]
        ri = ri + 1
    cki("one_9_len_pos",  len(r9) > 0,  1)
    cki("one_9_sum",      rsum,          9)

    // single item hit
    let r5 = ss_one([5], 5)
    ckl("one_single5", r5, [5])

    print("PASS _dp_subset_sum_test")
