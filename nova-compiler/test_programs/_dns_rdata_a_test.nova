// KAT for std/net/dns_rdata_a — A and AAAA rdata encode/decode.
import std/net/dns_rdata_a

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL dns_rdata_a " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL dns_rdata_a " + label + ": got '" + got + "' want '" + want + "'")
        exit(1)

fn main()
    // ── dns_a_encode / dns_a_decode ───────────────────────────────────────────

    // Vector 1: 1.2.3.4 -> bytes [1,2,3,4]
    let b124 = dns_a_encode("1.2.3.4")
    cki("a_enc_1.2.3.4_len", bytes_len(b124), 4)
    cki("a_enc_1.2.3.4_b0", bytes_get(b124, 0), 1)
    cki("a_enc_1.2.3.4_b1", bytes_get(b124, 1), 2)
    cki("a_enc_1.2.3.4_b2", bytes_get(b124, 2), 3)
    cki("a_enc_1.2.3.4_b3", bytes_get(b124, 3), 4)

    // Vector 2: 192.168.0.255 -> [192,168,0,255]
    let b192 = dns_a_encode("192.168.0.255")
    cki("a_enc_192_len", bytes_len(b192), 4)
    cki("a_enc_192_b0", bytes_get(b192, 0), 192)
    cki("a_enc_192_b1", bytes_get(b192, 1), 168)
    cki("a_enc_192_b2", bytes_get(b192, 2), 0)
    cki("a_enc_192_b3", bytes_get(b192, 3), 255)

    // Vector 3: dns_a_decode round-trip
    cks("a_dec_1234", dns_a_decode(b124), "1.2.3.4")
    cks("a_dec_192", dns_a_decode(b192), "192.168.0.255")

    // Vector 4: error input -> 4 zero bytes
    let berr = dns_a_encode("256.0.0.1")
    cki("a_enc_err_b0", bytes_get(berr, 0), 0)
    cki("a_enc_err_b3", bytes_get(berr, 3), 0)

    // Vector 5: decode wrong length -> ""
    let bempty = bytes(0)
    cks("a_dec_empty", dns_a_decode(bempty), "")
    let b3 = bytes(3)
    cks("a_dec_3bytes", dns_a_decode(b3), "")

    // ── dns_aaaa_encode / dns_aaaa_decode ─────────────────────────────────────

    // Vector 6: ::1 -> 16 bytes, all 0 except byte[15]==1
    let b6lo = dns_aaaa_encode("::1")
    cki("aaaa_enc_lo1_len", bytes_len(b6lo), 16)
    cki("aaaa_enc_lo1_b14", bytes_get(b6lo, 14), 0)
    cki("aaaa_enc_lo1_b15", bytes_get(b6lo, 15), 1)
    cki("aaaa_enc_lo1_b0", bytes_get(b6lo, 0), 0)
    cki("aaaa_enc_lo1_b1", bytes_get(b6lo, 1), 0)
    cki("aaaa_enc_lo1_b8", bytes_get(b6lo, 8), 0)

    // Vector 7: 2001:db8::1 byte[0]==0x20, byte[1]==0x01, byte[15]==1
    let b6db8 = dns_aaaa_encode("2001:db8::1")
    cki("aaaa_enc_db8_len", bytes_len(b6db8), 16)
    cki("aaaa_enc_db8_b0", bytes_get(b6db8, 0), 32)
    cki("aaaa_enc_db8_b1", bytes_get(b6db8, 1), 1)
    cki("aaaa_enc_db8_b2", bytes_get(b6db8, 2), 13)
    cki("aaaa_enc_db8_b3", bytes_get(b6db8, 3), 184)
    cki("aaaa_enc_db8_b15", bytes_get(b6db8, 15), 1)

    // Vector 8: full form "2001:0db8:0000:0000:0000:0000:0000:0001"
    let b6full = dns_aaaa_encode("2001:0db8:0000:0000:0000:0000:0000:0001")
    cki("aaaa_enc_full_b0", bytes_get(b6full, 0), 32)
    cki("aaaa_enc_full_b1", bytes_get(b6full, 1), 1)
    cki("aaaa_enc_full_b15", bytes_get(b6full, 15), 1)

    // Vector 9: :: -> 16 zero bytes
    let b6z = dns_aaaa_encode("::")
    cki("aaaa_enc_zero_len", bytes_len(b6z), 16)
    cki("aaaa_enc_zero_b0", bytes_get(b6z, 0), 0)
    cki("aaaa_enc_zero_b15", bytes_get(b6z, 15), 0)

    // Vector 10: round-trip ::1 decode -> byte[15] == 1
    let dec_lo1 = dns_aaaa_decode(b6lo)
    cki("aaaa_rt_lo1_b15", bytes_get(dns_aaaa_encode(dec_lo1), 15), 1)

    // Vector 11: decode wrong length -> ""
    let b5 = bytes(5)
    cks("aaaa_dec_5bytes", dns_aaaa_decode(b5), "")

    // Vector 12: dns_aaaa_decode -> canonical string for ::1
    let ds_lo1 = dns_aaaa_decode(b6lo)
    cki("aaaa_dec_lo1_reenc_b15", bytes_get(dns_aaaa_encode(ds_lo1), 15), 1)

    // Vector 13: error input -> 16 zero bytes
    let b6err = dns_aaaa_encode("not::valid::ipv6::garbage")
    cki("aaaa_enc_err_len", bytes_len(b6err), 16)
    cki("aaaa_enc_err_b0", bytes_get(b6err, 0), 0)
    cki("aaaa_enc_err_b15", bytes_get(b6err, 15), 0)

    print("PASS _dns_rdata_a_test")
