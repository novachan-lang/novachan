// KAT for std/compress/lz77 — LZ77 sliding-window compression
import std/compress/lz77

// ── helpers ──────────────────────────────────────────────────────────────────

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// Check token[field] == value.
fn ckti(label: string, tokens: any, ti: int, field: int, want: int)
    let tok = tokens[ti]
    let got = tok[field]
    if got != want
        print("FAIL " + label + "[" + str(ti) + "][" + str(field) + "]: got=" + str(got) + " want=" + str(want))
        exit(1)

// Round-trip helper: compress then decompress, assert equality.
fn ckrt(label: string, s: string)
    let tokens = lz7_compress(s, 255)
    let recovered = lz7_decompress(tokens)
    if recovered != s
        print("FAIL rt " + label + ": got='" + recovered + "' want='" + s + "'")
        exit(1)

fn main()
    // ── KAT 1: round-trip empty string ────────────────────────────────────────
    ckrt("empty", "")
    let et = lz7_compress("", 255)
    cki("empty token count", len(et), 0)

    // ── KAT 2: round-trip single char ─────────────────────────────────────────
    ckrt("single a", "a")

    // ── KAT 3: round-trip repeated chars ──────────────────────────────────────
    ckrt("aaaaaa", "aaaaaa")

    // ── KAT 4: round-trip with repeated pattern ────────────────────────────────
    ckrt("abcabcabc", "abcabcabc")

    // ── KAT 5: round-trip with repeated words ─────────────────────────────────
    ckrt("the the the", "the the the")

    // ── KAT 6: round-trip classic LZ77 example ───────────────────────────────
    ckrt("mississippi", "mississippi")

    // ── KAT 7: "aaaa" compresses to fewer than 4 tokens (finds back-ref) ──────
    let at = lz7_compress("aaaa", 255)
    if len(at) >= 4
        print("FAIL aaaa compression: " + str(len(at)) + " tokens, expected < 4")
        exit(1)

    // ── KAT 8: first token of any non-empty input is a literal [0,0,firstChar] ─
    // Check for "aaaaaa"
    let at6 = lz7_compress("aaaaaa", 255)
    ckti("aaaaaa tok0 off", at6, 0, 0, 0)
    ckti("aaaaaa tok0 len", at6, 0, 1, 0)
    ckti("aaaaaa tok0 nc",  at6, 0, 2, ord("a"))

    // Check for "abcabcabc"
    let at9 = lz7_compress("abcabcabc", 255)
    ckti("abcabcabc tok0 off", at9, 0, 0, 0)
    ckti("abcabcabc tok0 len", at9, 0, 1, 0)
    ckti("abcabcabc tok0 nc",  at9, 0, 2, ord("a"))

    // ── KAT 9: "aaaaaa" uses back-reference (length > 0) in some token ─────────
    let found_ref = 0
    let ki = 0
    while ki < len(at6)
        let tok = at6[ki]
        if tok[1] > 0
            found_ref = 1
        ki = ki + 1
    if found_ref == 0
        print("FAIL aaaaaa: no back-reference token found")
        exit(1)

    // ── KAT 10: "the the the" round-trip + back-ref exploitation ──────────────
    let tt = lz7_compress("the the the", 255)
    // "the the the" (11 chars) should compress well; check token count < 11
    if len(tt) >= 11
        print("FAIL the the the: " + str(len(tt)) + " tokens not fewer than 11")
        exit(1)

    // ── KAT 11: single-char string produces exactly 1 literal token ───────────
    let sc = lz7_compress("x", 255)
    cki("single x token count", len(sc), 1)
    ckti("single x off", sc, 0, 0, 0)
    ckti("single x len", sc, 0, 1, 0)
    ckti("single x nc",  sc, 0, 2, ord("x"))

    // ── KAT 12: lz7_compress_default == lz7_compress(s, 255) ─────────────────
    let s12 = "mississippi"
    let t1 = lz7_compress(s12, 255)
    let t2 = lz7_compress_default(s12)
    cki("compress_default same len", len(t2), len(t1))
    // Check each token matches.
    let ii = 0
    while ii < len(t1)
        let a = t1[ii]
        let b = t2[ii]
        if a[0] != b[0] or a[1] != b[1] or a[2] != b[2]
            print("FAIL compress_default token " + str(ii) + " differs")
            exit(1)
        ii = ii + 1

    // ── KAT 13: window size respected — small window may miss far-back match ───
    // "abcabcabc" with window=3: match for 2nd "abc" at offset 3 is just within
    // window, but 3rd "abc" at offset 6 is OUT of a window=3. Round-trip still works.
    ckrt("abcabcabc w3", "abcabcabc")

    // ── KAT 14: longer sentence round-trip ────────────────────────────────────
    ckrt("longer", "the quick brown fox jumps over the lazy dog")

    print("_lz77_test passed")
