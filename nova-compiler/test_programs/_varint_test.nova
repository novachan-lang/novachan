// KAT test for std/encoding/varint
// Known-answer vectors hand-computed against the LEB128 spec.
import std/encoding/varint

// ── Helpers ───────────────────────────────────────────────────────────────────

// Compare two bytes values byte-by-byte; return 1 if equal, 0 otherwise.
fn _vt_bytes_eq(a, b) -> int
    let la = bytes_len(a)
    let lb = bytes_len(b)
    if la != lb
        return 0
    let i = 0
    while i < la
        if bytes_get(a, i) != bytes_get(b, i)
            return 0
        i = i + 1
    1

// Build a bytes value from a list of ints.
fn _vt_make_bytes(lst) -> any
    let buf = bytes(0)
    let i = 0
    while i < len(lst)
        buf = bytes_append(buf, lst[i])
        i = i + 1
    buf

// Check: bytes equal.  Prints FAIL + exits on mismatch.
fn ckb(label, got, want_list) -> int
    let want = _vt_make_bytes(want_list)
    if _vt_bytes_eq(got, want) == 0
        print("FAIL " + label + ": got len=" + str(bytes_len(got)) + " want len=" + str(bytes_len(want)))
        exit(1)
    0

// Check: int equal.
fn cki(label, got, want) -> int
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)
    0

// ── KAT 1: vi_encode(0) == [0x00] ────────────────────────────────────────────
// 0 is a single zero byte in LEB128.
fn test_encode_zero() -> int
    let enc = vi_encode(0)
    ckb("vi_encode(0)", enc, [0])

// ── KAT 2: vi_encode(127) == [127] ───────────────────────────────────────────
// 127 = 0x7F fits in one byte (no continuation bit needed).
fn test_encode_127() -> int
    let enc = vi_encode(127)
    ckb("vi_encode(127)", enc, [127])

// ── KAT 3: vi_encode(128) == [128, 1] ────────────────────────────────────────
// 128 = 0b10000000.
//   byte 0: (128 & 0x7F) | 0x80 = 0 | 128 = 0x80 = 128  (continuation)
//   byte 1: (128 >> 7) & 0x7F  = 1                        (final)
fn test_encode_128() -> int
    let enc = vi_encode(128)
    ckb("vi_encode(128)", enc, [128, 1])

// ── KAT 4: vi_encode(300) == [172, 2] ────────────────────────────────────────
// 300 = 0x12C = 0b1_0010_1100
//   low 7 bits = 0b010_1100 = 44; with continuation: 44 | 128 = 172
//   remaining  = 300 >> 7 = 2; final byte: 2
fn test_encode_300() -> int
    let enc = vi_encode(300)
    ckb("vi_encode(300)", enc, [172, 2])

// ── KAT 5: vi_encode(16384) == [128, 128, 1] ─────────────────────────────────
// 16384 = 0x4000 = 2^14 → needs 3 bytes.
//   byte 0: (16384 & 0x7F) | 0x80 = 0 | 128 = 128
//   rem    = 16384 >> 7 = 128
//   byte 1: (128 & 0x7F) | 0x80 = 0 | 128 = 128
//   rem    = 128 >> 7 = 1
//   byte 2: 1  (final)
fn test_encode_16384() -> int
    let enc = vi_encode(16384)
    ckb("vi_encode(16384)", enc, [128, 128, 1])

// ── KAT 6: vi_decode round-trip for 300 ──────────────────────────────────────
// vi_decode(vi_encode(300), 0) must return [300, 2].
fn test_decode_300() -> int
    let enc = vi_encode(300)
    let dec = vi_decode(enc, 0)
    cki("vi_decode(300)[0]", dec[0], 300)
    cki("vi_decode(300)[1]", dec[1], 2)

// ── KAT 7: vi_size ────────────────────────────────────────────────────────────
// vi_size(0)   == 1
// vi_size(127) == 1
// vi_size(128) == 2
// vi_size(300) == 2
// vi_size(16384) == 3
fn test_vi_size() -> int
    cki("vi_size(0)",     vi_size(0),     1)
    cki("vi_size(127)",   vi_size(127),   1)
    cki("vi_size(128)",   vi_size(128),   2)
    cki("vi_size(300)",   vi_size(300),   2)
    cki("vi_size(16384)", vi_size(16384), 3)

// ── KAT 8: vi_encode_signed(-1) == [1] ───────────────────────────────────────
// zigzag(-1) = (-2*(-1)) - 1 = 2 - 1 = 1
// LEB128(1) = [1]
fn test_encode_signed_neg1() -> int
    let enc = vi_encode_signed(-1)
    ckb("vi_encode_signed(-1)", enc, [1])

// ── KAT 9: vi_encode_signed(1) == [2] ────────────────────────────────────────
// zigzag(1) = 2*1 = 2
// LEB128(2) = [2]
fn test_encode_signed_1() -> int
    let enc = vi_encode_signed(1)
    ckb("vi_encode_signed(1)", enc, [2])

// ── KAT 10: vi_decode_signed round-trip for -5 ───────────────────────────────
// zigzag(-5) = (-2*(-5)) - 1 = 10 - 1 = 9
// LEB128(9) = [9]  (single byte, 9 < 128)
// un-zigzag: 9 is odd => -((9+1)/2) = -(10/2) = -5  ✓
// next_pos = 1
fn test_decode_signed_neg5() -> int
    let enc = vi_encode_signed(-5)
    let dec = vi_decode_signed(enc, 0)
    cki("vi_decode_signed(-5)[0]", dec[0], -5)
    cki("vi_decode_signed(-5)[1]", dec[1], 1)

// ── Additional sanity: vi_encode_signed(0) == [0] ────────────────────────────
fn test_encode_signed_zero() -> int
    let enc = vi_encode_signed(0)
    ckb("vi_encode_signed(0)", enc, [0])

// ── Additional sanity: vi_decode(vi_encode(0), 0) == [0, 1] ──────────────────
fn test_decode_zero() -> int
    let enc = vi_encode(0)
    let dec = vi_decode(enc, 0)
    cki("vi_decode(0)[0]", dec[0], 0)
    cki("vi_decode(0)[1]", dec[1], 1)

// ── Additional sanity: multi-value stream decode ──────────────────────────────
// Encode two values into one buffer; decode at offset 0 then at next_pos.
// vi_encode(1) = [1]  (1 byte)
// vi_encode(300) = [172, 2]  (2 bytes)
// Combined buffer: [1, 172, 2]
// First decode at pos 0  -> [1, 1]
// Second decode at pos 1 -> [300, 3]
fn test_stream_decode() -> int
    let buf = bytes(0)
    buf = bytes_append(buf, 1)
    buf = bytes_append(buf, 172)
    buf = bytes_append(buf, 2)
    let d0 = vi_decode(buf, 0)
    cki("stream_decode[0].value",    d0[0], 1)
    cki("stream_decode[0].next_pos", d0[1], 1)
    let d1 = vi_decode(buf, d0[1])
    cki("stream_decode[1].value",    d1[0], 300)
    cki("stream_decode[1].next_pos", d1[1], 3)

// ── Entry point ───────────────────────────────────────────────────────────────
fn main() -> int
    test_encode_zero()
    test_encode_127()
    test_encode_128()
    test_encode_300()
    test_encode_16384()
    test_decode_300()
    test_vi_size()
    test_encode_signed_neg1()
    test_encode_signed_1()
    test_decode_signed_neg5()
    test_encode_signed_zero()
    test_decode_zero()
    test_stream_decode()
    print("_varint_test passed")
    0
