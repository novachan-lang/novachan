// Comprehensive regex test — exercises all regex builtins

fn main()
    // regex_match: returns 1 (match) or 0 (no match)
    assert_eq(regex_match("hello world", "hello"), 1)
    assert_eq(regex_match("hello world", "^hello"), 1)
    assert_eq(regex_match("hello world", "world$"), 1)
    assert_eq(regex_match("hello world", "^world"), 0)
    assert_eq(regex_match("abc123", "[0-9]+"), 1)
    assert_eq(regex_match("abcdef", "[0-9]+"), 0)
    assert_eq(regex_match("foo.bar", "foo.bar"), 1)
    assert_eq(regex_match("fooXbar", "foo.bar"), 1)

    // regex_find: returns first match substring
    assert_eq(regex_find("hello 42 world", "[0-9]+"), "42")
    assert_eq(regex_find("abc def ghi", "[a-z]+"), "abc")
    assert_eq(regex_find("no digits here", "[0-9]+"), "")
    assert_eq(regex_find("2024-05-31", "[0-9][0-9][0-9][0-9]"), "2024")

    // counted quantifiers {n} / {n,m} / {n,}  (braces escaped \{ \} since NOVA
    // strings treat {..} as interpolation; the regex engine receives literal { })
    assert_eq(regex_match("2024", "[0-9]\{4\}"), 1)
    assert_eq(regex_match("202", "[0-9]\{4\}"), 0)
    assert_eq(regex_find("2024-05-31", "[0-9]\{4\}"), "2024")
    assert_eq(regex_find("ab 12345 cd", "[0-9]\{2,4\}"), "1234")
    assert_eq(regex_match("aaa", "a\{3\}"), 1)
    assert_eq(regex_match("aa", "a\{3\}"), 0)
    assert_eq(regex_match("aaaa", "a\{2,\}"), 1)
    assert_eq(regex_match("a", "a\{2,\}"), 0)
    assert_eq(regex_find("xxxxx", "x\{2,3\}"), "xxx")
    assert_eq(regex_match("", "a\{0\}"), 1)
    assert_eq(regex_match("2024-05-31", "[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}"), 1)
    // a literal '{' (malformed quantifier) is treated as a literal char
    assert_eq(regex_match("a\{x", "a\{x"), 1)

    // regex_replace: replaces first match only
    assert_eq(regex_replace("hello world", "world", "NOVA"), "hello NOVA")
    assert_eq(regex_replace("aaa bbb ccc", "[a-z]+", "X"), "X bbb ccc")
    assert_eq(regex_replace("no match", "zzz", "X"), "no match")

    // regex_replace_all: replaces ALL matches
    assert_eq(regex_replace_all("aaa bbb ccc", "[a-z]+", "X"), "X X X")
    assert_eq(regex_replace_all("a1b2c3", "[0-9]", ""), "abc")
    assert_eq(regex_replace_all("hello", "l", "L"), "heLLo")

    // regex_split: splits text by pattern
    let parts = regex_split("one,two,,three", ",+")
    assert_eq(len(parts), 3)
    assert_eq(parts[0], "one")
    assert_eq(parts[1], "two")
    assert_eq(parts[2], "three")

    let words = regex_split("hello   world   test", " +")
    assert_eq(len(words), 3)
    assert_eq(words[0], "hello")
    assert_eq(words[1], "world")
    assert_eq(words[2], "test")

    // regex_find_all: returns list of all matches
    let nums = regex_find_all("a1 b22 c333", "[0-9]+")
    assert_eq(len(nums), 3)
    assert_eq(nums[0], "1")
    assert_eq(nums[1], "22")
    assert_eq(nums[2], "333")

    let vowels = regex_find_all("hello world", "[aeiou]")
    assert_eq(len(vowels), 3)
    assert_eq(vowels[0], "e")
    assert_eq(vowels[1], "o")
    assert_eq(vowels[2], "o")

    // Edge cases
    assert_eq(regex_match("", ".*"), 1)
    assert_eq(regex_find("", "[a-z]"), "")
    assert_eq(regex_replace("", "x", "y"), "")

    print("regex_full_test passed")
