// forge_typed_mw_test -- Phase 1 incr-6: typed middleware on the fn(Request) -> Response path.
// Exercises the dispatch_req fold: outside-in ordering, capturing-closure middleware
// (mw_set_header / mw_cors_origin), a top-level short-circuit middleware, and that the
// terminal's coerced JSON body survives the middleware chain unchanged.
import forge

type Note
    id: int

fn h_note(req: Request) -> Note
    Note(42)

// Top-level short-circuit middleware: block /admin before the route terminal is reached.
fn mw_block_admin(req: Request, next)
    if req.path == "/admin"
        return forge.resp_text(403, "forbidden")
    next(req)

fn main()
    let q = chr(34)
    let a = forge.app()
    // Registration order = outside-in. block_admin is OUTERMOST (sees the request first).
    forge.use(a, mw_block_admin)
    forge.use(a, forge.mw_set_header("X-Powered-By", "Forge"))
    forge.use(a, forge.mw_cors_origin("*"))
    forge.get(a, "/note", h_note)

    // Happy path: all middleware run, terminal produces JSON, headers injected on the way out.
    let resp: Response = forge.dispatch_req(a, forge.build_request("GET /note HTTP/1.1\r\n\r\n", 0))
    assert(resp.status == 200, "status 200")
    assert(resp.headers["X-Powered-By"] == "Forge", "mw_set_header applied")
    assert(resp.headers["Access-Control-Allow-Origin"] == "*", "cors header applied")
    assert(find(resp.body, q + "id" + q + ":42") >= 0, "coerced JSON body intact through chain")
    print("PASS: typed middleware fold (header + cors + coerced body)")

    // Short-circuit: the outermost middleware returns 403 BEFORE the terminal -> no 404 (which
    // would mean the terminal ran first). 403 proves outside-in ordering + short-circuit.
    let radm: Response = forge.dispatch_req(a, forge.build_request("GET /admin HTTP/1.1\r\n\r\n", 0))
    assert(radm.status == 403, "short-circuit -> 403 (not 404)")
    assert(radm.body == "forbidden", "short-circuit body")
    print("PASS: middleware short-circuit + outside-in ordering")
    print("forge_typed_mw_test passed")
