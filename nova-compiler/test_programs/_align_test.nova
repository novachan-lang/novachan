// _align_test.nova — KAT for std/bio/align
//
// Known-answer vectors:
//   nw_score('ACGT','ACGT',1,-1,-1) = 4  (4 exact matches)
//   nw_score('ACGT','ACGG',1,-1,-1) = 2  (3 match, 1 mismatch: 3-1=2)
//   sw_score('ACGT','ACGT',2,-1,-2) = 8  (4 matches x2 = 8)
//   edit_distance('kitten','sitting') = 3
//   align_identity('ACGT','ACGA') = 0.75

import std/bio/align

fn ck_int(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)
    return 0

fn approx(label, a, b, tol)
    let d = a - b
    let ad = d
    if d < 0.0
        ad = 0.0 - d
    if ad > tol
        print("FAIL " + label + ": got=" + str(a) + " want~" + str(b))
        exit(1)
    return 0

// strip_gap: remove all '-' characters from a string (for alignment verification).
fn strip_gap(s) -> string
    let n = len(s)
    let result = ""
    let i = 0
    while i < n
        let ch = slice(s, i, i + 1)
        if ch != "-"
            result = result + ch
        i = i + 1
    return result

// contains_gap: true if s contains at least one '-' character.
fn contains_gap(s) -> bool
    let n = len(s)
    let i = 0
    while i < n
        let ch = slice(s, i, i + 1)
        if ch == "-"
            return true
        i = i + 1
    return false

fn main()
    // KAT 1: perfect match NW score = 4
    let s1 = nw_score("ACGT", "ACGT", 1, 0 - 1, 0 - 1)
    ck_int("nw_perfect", s1, 4)

    // KAT 2: 3 matches + 1 mismatch = 3 - 1 = 2
    let s2 = nw_score("ACGT", "ACGG", 1, 0 - 1, 0 - 1)
    ck_int("nw_one_mismatch", s2, 2)

    // KAT 3: SW perfect match with mat=2 => 4*2 = 8
    let s3 = sw_score("ACGT", "ACGT", 2, 0 - 1, 0 - 2)
    ck_int("sw_perfect", s3, 8)

    // KAT 4: edit distance kitten -> sitting = 3
    let ed1 = edit_distance("kitten", "sitting")
    ck_int("edit_kitten_sitting", ed1, 3)

    // KAT 5: edit distance identical = 0
    let ed2 = edit_distance("ACGT", "ACGT")
    ck_int("edit_identical", ed2, 0)

    // KAT 6: align identity 3/4 = 0.75
    let id1 = align_identity("ACGT", "ACGA")
    approx("identity_0.75", id1, 0.75, 0.01)

    // KAT 7: align identity 1.0
    let id2 = align_identity("AAAA", "AAAA")
    approx("identity_1.0", id2, 1.0, 0.001)

    // KAT 8: nw_default wraps correctly
    let nd = nw_default("ACGT", "ACGT")
    ck_int("nw_default_perfect", nd, 4)

    // KAT 9: sw_default wraps correctly
    let sd = sw_default("ACGT", "ACGT")
    ck_int("sw_default_perfect", sd, 4)

    // KAT 10: edit_distance empty strings
    let ed3 = edit_distance("", "")
    ck_int("edit_empty", ed3, 0)

    // KAT 11: edit_distance single insertion
    let ed4 = edit_distance("A", "AB")
    ck_int("edit_insert", ed4, 1)

    // KAT 12: edit_distance single deletion
    let ed5 = edit_distance("AB", "A")
    ck_int("edit_delete", ed5, 1)

    // KAT 13: pct_identity 100%
    let pi = pct_identity("ACGT", "ACGT")
    approx("pct_identity_100", pi, 100.0, 0.01)

    // KAT 14: pct_identity 3/4 = 75.0
    let pi2 = pct_identity("ACGT", "ACGA")
    approx("pct_identity_75", pi2, 75.0, 0.1)

    // KAT 15: hamming similarity: 'ACGT' vs 'ACGT' = 1.0
    let hs1 = hamming_similarity("ACGT", "ACGT")
    approx("hamming_sim_1.0", hs1, 1.0, 0.001)

    // KAT 16: hamming similarity: 'ACGT' vs 'ACGA' = 0.75
    let hs2 = hamming_similarity("ACGT", "ACGA")
    approx("hamming_sim_0.75", hs2, 0.75, 0.01)

    // KAT 17: nw_global returns a dict with score
    let ng = nw_global("ACGT", "ACGT", 1, 0 - 1, 0 - 1)
    let ng_score = ng["score"]
    ck_int("nw_global_score", ng_score, 4)

    // KAT 18: sw_score with mismatch-only sequences (no common subseq, score 0)
    let s4 = sw_score("AAAA", "CCCC", 2, 0 - 1, 0 - 2)
    ck_int("sw_no_match", s4, 0)

    // KAT 19: align_identity empty returns 0.0
    let id3 = align_identity("", "")
    approx("identity_empty", id3, 0.0, 0.001)

    // KAT 20: hamming_similarity different length returns 0.0
    let hs3 = hamming_similarity("ACGT", "AC")
    approx("hamming_diff_len", hs3, 0.0, 0.001)

    // KAT 21: nw_global real traceback — nw_global('ACGT','AGT',1,-1,-1)
    // NW score for this pair = 2 (verified by nw_score below).
    // Alignment must gap-align: stripping '-' from aligned_a gives 'ACGT',
    // stripping '-' from aligned_b gives 'AGT', aligned_b must contain a '-',
    // and both aligned strings must have the same length.
    let ng2 = nw_global("ACGT", "AGT", 1, 0 - 1, 0 - 1)
    let ng2_score = ng2["score"]
    ck_int("nw_global_traceback_score", ng2_score, 2)
    let ng2_a = ng2["aligned_a"]
    let ng2_b = ng2["aligned_b"]
    ck_int("nw_global_aligned_len_eq", len(ng2_a), len(ng2_b))
    let stripped_a = strip_gap(ng2_a)
    let stripped_b = strip_gap(ng2_b)
    ck_int("nw_global_strip_a_len", len(stripped_a), 4)
    ck_int("nw_global_strip_b_len", len(stripped_b), 3)
    // verify stripped content matches the originals
    if stripped_a != "ACGT"
        print("FAIL nw_global_traceback: stripped_a=" + stripped_a + " want=ACGT")
        exit(1)
    if stripped_b != "AGT"
        print("FAIL nw_global_traceback: stripped_b=" + stripped_b + " want=AGT")
        exit(1)
    // aligned_b must contain at least one gap character
    if not contains_gap(ng2_b)
        print("FAIL nw_global_traceback: aligned_b=" + ng2_b + " contains no gap")
        exit(1)

    print("PASS _align_test")
