// reverse
xs = [1, 2, 3, 4, 5]
rev = xs.reverse()
for x in rev
    print(x)

// sort (in-place, returns same list)
nums = [5, 1, 4, 2, 3]
nums.sort()
for n in nums
    print(n)

// map
doubled = [1, 2, 3].map(fn(x) x * 2)
for d in doubled
    print(d)

// filter
evens = [1, 2, 3, 4, 5, 6].filter(fn(x) x % 2 == 0)
for e in evens
    print(e)

// chained: map then filter
result = [1, 2, 3, 4, 5].map(fn(x) x * 10).filter(fn(x) x > 20)
for r in result
    print(r)
