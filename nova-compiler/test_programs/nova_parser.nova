type Token
    kind: string
    value: string
    line: int
    col: int

type Expr
    tag: string
    value: string
    num: int
    children: list

type Stmt
    tag: string
    name: string
    expr: Expr
    body: list
    params: list

type ExprResult
    expr: Expr
    pos: int

type StmtResult
    stmt: Stmt
    pos: int

fn make_num_expr(n: int) -> Expr
    Expr("num", str(n), n, [])

fn make_str_expr(s: string) -> Expr
    Expr("str", s, 0, [])

fn make_ident_expr(name: string) -> Expr
    Expr("ident", name, 0, [])

fn make_binop(op: string, left: Expr, right: Expr) -> Expr
    Expr("binop", op, 0, [left, right])

fn make_unary(op: string, operand: Expr) -> Expr
    Expr("unary", op, 0, [operand])

fn make_call(name: string, args: list) -> Expr
    Expr("call", name, 0, args)

fn make_group(inner: Expr) -> Expr
    Expr("group", "", 0, [inner])

// --- Lexer ---

fn is_alpha(ch: string) -> bool
    let c = ord(ch)
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or ch == "_"

fn is_digit(ch: string) -> bool
    let c = ord(ch)
    c >= 48 and c <= 57

fn is_alnum(ch: string) -> bool
    is_alpha(ch) or is_digit(ch)

fn is_whitespace(ch: string) -> bool
    ch == " " or ch == "\t" or ch == "\r"

fn tokenize(source: string) -> list
    let tokens = []
    let pos = 0
    let line = 1
    let col = 1
    let length = len(source)

    while pos < length
        let ch = source[pos]

        if ch == "\n"
            push(tokens, Token("NEWLINE", "\\n", line, col))
            line = line + 1
            col = 1
            pos = pos + 1
        else if is_whitespace(ch)
            while pos < length and is_whitespace(source[pos])
                pos = pos + 1
                col = col + 1
        else if ch == "/" and pos + 1 < length and source[pos + 1] == "/"
            while pos < length and source[pos] != "\n"
                pos = pos + 1
                col = col + 1
        else if is_alpha(ch)
            let start_col = col
            let word = ""
            while pos < length and is_alnum(source[pos])
                word = word + source[pos]
                pos = pos + 1
                col = col + 1
            let kind = if word == "fn" or word == "let" or word == "if" or word == "else" or word == "while" or word == "return" or word == "true" or word == "false" or word == "and" or word == "or" or word == "not"
                "KW"
            else
                "IDENT"
            push(tokens, Token(kind, word, line, start_col))
        else if is_digit(ch)
            let start_col = col
            let num = ""
            while pos < length and is_digit(source[pos])
                num = num + source[pos]
                pos = pos + 1
                col = col + 1
            push(tokens, Token("INT", num, line, start_col))
        else if ch == "\""
            let start_col = col
            pos = pos + 1
            col = col + 1
            let str_val = ""
            while pos < length and source[pos] != "\""
                if source[pos] == "\\"
                    pos = pos + 1
                    col = col + 1
                    if pos < length
                        str_val = str_val + source[pos]
                else
                    str_val = str_val + source[pos]
                pos = pos + 1
                col = col + 1
            if pos < length
                pos = pos + 1
                col = col + 1
            push(tokens, Token("STR", str_val, line, start_col))
        else if ch == "(" or ch == ")" or ch == "[" or ch == "]"
            push(tokens, Token("DELIM", ch, line, col))
            pos = pos + 1
            col = col + 1
        else if ch == "+" or ch == "*" or ch == "/" or ch == "%"
            push(tokens, Token("OP", ch, line, col))
            pos = pos + 1
            col = col + 1
        else if ch == "-"
            if pos + 1 < length and source[pos + 1] == ">"
                push(tokens, Token("ARROW", "->", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("OP", "-", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == "="
            if pos + 1 < length and source[pos + 1] == "="
                push(tokens, Token("OP", "==", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("ASSIGN", "=", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == "!"
            if pos + 1 < length and source[pos + 1] == "="
                push(tokens, Token("OP", "!=", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("OP", "!", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == "<"
            if pos + 1 < length and source[pos + 1] == "="
                push(tokens, Token("OP", "<=", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("OP", "<", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == ">"
            if pos + 1 < length and source[pos + 1] == "="
                push(tokens, Token("OP", ">=", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("OP", ">", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == ":"
            push(tokens, Token("COLON", ":", line, col))
            pos = pos + 1
            col = col + 1
        else if ch == ","
            push(tokens, Token("COMMA", ",", line, col))
            pos = pos + 1
            col = col + 1
        else if ch == "."
            push(tokens, Token("DOT", ".", line, col))
            pos = pos + 1
            col = col + 1
        else
            pos = pos + 1
            col = col + 1

    push(tokens, Token("EOF", "", line, col))
    tokens

// --- Parser ---
// Uses token list + integer position (no mutable struct needed)

fn tok_kind(tokens: list, pos: int) -> string
    match tokens[pos]
        Token(kind, value, line, col) => kind

fn tok_value(tokens: list, pos: int) -> string
    match tokens[pos]
        Token(kind, value, line, col) => value

fn precedence(op: string) -> int
    if op == "==" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">="
        1
    else if op == "+" or op == "-"
        2
    else if op == "*" or op == "/" or op == "%"
        3
    else
        0

// Parse primary: numbers, strings, identifiers, calls, grouped, unary
fn parse_primary(tokens: list, pos: int) -> ExprResult
    let kind = tok_kind(tokens, pos)
    let val = tok_value(tokens, pos)

    if kind == "INT"
        ExprResult(make_num_expr(int(val)), pos + 1)
    else if kind == "STR"
        ExprResult(make_str_expr(val), pos + 1)
    else if kind == "IDENT"
        // Check for function call
        if pos + 1 < len(tokens) and tok_kind(tokens, pos + 1) == "DELIM" and tok_value(tokens, pos + 1) == "("
            let args = []
            let p = pos + 2
            if tok_value(tokens, p) != ")"
                let arg_r = parse_expr(tokens, p, 0)
                push(args, arg_r.expr)
                p = arg_r.pos
                while tok_value(tokens, p) == ","
                    let next_r = parse_expr(tokens, p + 1, 0)
                    push(args, next_r.expr)
                    p = next_r.pos
            assert(tok_value(tokens, p) == ")", "expected ) in call")
            ExprResult(make_call(val, args), p + 1)
        else
            ExprResult(make_ident_expr(val), pos + 1)
    else if kind == "DELIM" and val == "("
        let inner_r = parse_expr(tokens, pos + 1, 0)
        assert(tok_value(tokens, inner_r.pos) == ")", "expected )")
        ExprResult(make_group(inner_r.expr), inner_r.pos + 1)
    else if kind == "OP" and val == "-"
        let operand_r = parse_primary(tokens, pos + 1)
        ExprResult(make_unary("-", operand_r.expr), operand_r.pos)
    else
        assert(false, "unexpected token: " + kind + " " + val)
        ExprResult(make_num_expr(0), pos)

// Pratt expression parser
fn parse_expr(tokens: list, pos: int, min_prec: int) -> ExprResult
    let left_r = parse_primary(tokens, pos)
    let left = left_r.expr
    let cur = left_r.pos

    while tok_kind(tokens, cur) == "OP" and precedence(tok_value(tokens, cur)) > min_prec
        let op = tok_value(tokens, cur)
        let prec = precedence(op)
        let right_r = parse_expr(tokens, cur + 1, prec)
        left = make_binop(op, left, right_r.expr)
        cur = right_r.pos

    ExprResult(left, cur)

// Parse let statement: let name = expr
fn parse_let(tokens: list, pos: int) -> StmtResult
    assert(tok_value(tokens, pos) == "let", "expected let")
    let name = tok_value(tokens, pos + 1)
    assert(tok_kind(tokens, pos + 2) == "ASSIGN", "expected =")
    let expr_r = parse_expr(tokens, pos + 3, 0)
    StmtResult(Stmt("let", name, expr_r.expr, [], []), expr_r.pos)

// Parse return statement: return expr
fn parse_return(tokens: list, pos: int) -> StmtResult
    assert(tok_value(tokens, pos) == "return", "expected return")
    let expr_r = parse_expr(tokens, pos + 1, 0)
    StmtResult(Stmt("return", "", expr_r.expr, [], []), expr_r.pos)

// Parse expression statement
fn parse_expr_stmt(tokens: list, pos: int) -> StmtResult
    let expr_r = parse_expr(tokens, pos, 0)
    StmtResult(Stmt("expr", "", expr_r.expr, [], []), expr_r.pos)

// Parse one statement
fn parse_stmt(tokens: list, pos: int) -> StmtResult
    let kind = tok_kind(tokens, pos)
    let val = tok_value(tokens, pos)
    if kind == "KW" and val == "let"
        parse_let(tokens, pos)
    else if kind == "KW" and val == "return"
        parse_return(tokens, pos)
    else
        parse_expr_stmt(tokens, pos)

// Skip newlines
fn skip_newlines(tokens: list, pos: int) -> int
    while tok_kind(tokens, pos) == "NEWLINE"
        pos = pos + 1
    pos

// Parse multiple statements
fn parse_program(tokens: list) -> list
    let stmts = []
    let pos = skip_newlines(tokens, 0)
    while tok_kind(tokens, pos) != "EOF"
        let result = parse_stmt(tokens, pos)
        push(stmts, result.stmt)
        pos = skip_newlines(tokens, result.pos)
    stmts

// --- Pretty Printer ---

fn expr_to_str(e: Expr) -> string
    match e
        Expr(tag, value, num, children) =>
            if tag == "num"
                str(num)
            else if tag == "str"
                "\"" + value + "\""
            else if tag == "ident"
                value
            else if tag == "binop"
                "(" + expr_to_str(children[0]) + " " + value + " " + expr_to_str(children[1]) + ")"
            else if tag == "unary"
                "(-" + expr_to_str(children[0]) + ")"
            else if tag == "call"
                let args_str = ""
                let i = 0
                for arg in children
                    if i > 0
                        args_str = args_str + ", "
                    args_str = args_str + expr_to_str(arg)
                    i = i + 1
                value + "(" + args_str + ")"
            else if tag == "group"
                expr_to_str(children[0])
            else
                "<unknown>"

fn stmt_to_str(s: Stmt) -> string
    match s
        Stmt(tag, name, expr, body, params) =>
            if tag == "let"
                "let " + name + " = " + expr_to_str(expr)
            else if tag == "return"
                "return " + expr_to_str(expr)
            else if tag == "expr"
                expr_to_str(expr)
            else
                "<unknown stmt>"

// --- Tests ---

fn test_parse(input: string, expected: string, label: string)
    let tokens = tokenize(input)
    let result = parse_expr(tokens, 0, 0)
    let actual = expr_to_str(result.expr)
    assert(actual == expected, label + ": got " + actual + " expected " + expected)

fn run_tests()
    // Test 1: Simple number
    test_parse("42", "42", "number literal")

    // Test 2: Simple addition
    test_parse("3 + 4", "(3 + 4)", "addition")

    // Test 3: Operator precedence - multiply before add
    test_parse("3 + 4 * 2", "(3 + (4 * 2))", "precedence mul>add")

    // Test 4: Left associativity
    test_parse("1 + 2 + 3", "((1 + 2) + 3)", "left assoc")

    // Test 5: Comparison
    test_parse("x < 10", "(x < 10)", "comparison")

    // Test 6: Parenthesized expression
    test_parse("(3 + 4) * 2", "((3 + 4) * 2)", "grouped expr")

    // Test 7: Unary minus
    test_parse("-5", "(-5)", "unary minus")

    // Test 8: Function call
    test_parse("fib(10)", "fib(10)", "fn call")

    // Test 9: Function call with multiple args
    test_parse("add(1, 2)", "add(1, 2)", "fn call multi-arg")

    // Test 10: Complex expression - fib recursive call
    test_parse("fib(n - 1) + fib(n - 2)", "(fib((n - 1)) + fib((n - 2)))", "fib recursive")

    // Test 11: Let statement
    let let_tokens = tokenize("let x = 42")
    let let_r = parse_stmt(let_tokens, 0)
    let let_str = stmt_to_str(let_r.stmt)
    assert(let_str == "let x = 42", "let stmt: " + let_str)

    // Test 12: Return statement
    let ret_tokens = tokenize("return x + 1")
    let ret_r = parse_stmt(ret_tokens, 0)
    let ret_str = stmt_to_str(ret_r.stmt)
    assert(ret_str == "return (x + 1)", "return stmt: " + ret_str)

    // Test 13: Multi-statement program
    let prog = "let x = 10\nlet y = x + 5\nreturn y"
    let prog_tokens = tokenize(prog)
    let stmts = parse_program(prog_tokens)
    assert(len(stmts) == 3, "program has 3 stmts: " + str(len(stmts)))

    print("NOVA Parser self-test: ALL PASSED")
    print("13 tests passed successfully")

run_tests()
