import forge_access_audit

fn main()
    let fresh = aa_new()
    let no_action = aa_last_action(fresh)
    assert(is_err(no_action), "no last action on fresh audit")
    let no_rate = aa_denial_rate(fresh)
    assert(is_err(no_rate), "no denial rate on fresh audit")

    let a = aa_new()
    aa_log(a, "alice", "/admin", "view", 1)
    aa_log(a, "bob", "/admin", "view", 0)
    aa_log(a, "bob", "/admin", "delete", 0)
    aa_log(a, "alice", "/reports", "view", 1)

    assert(aa_total_count(a) == 4, "4 total entries")
    assert(aa_allowed_count(a) == 2, "2 allowed")
    assert(aa_denied_count(a) == 2, "2 denied")

    assert(aa_user_denied(a, "bob") == 2, "bob denied twice")
    assert(aa_user_denied(a, "alice") == 0, "alice never denied")
    assert(aa_user_denied(a, "nobody") == 0, "unknown user 0 denied")

    assert(aa_resource_accesses(a, "/admin") == 3, "3 accesses to /admin")
    assert(aa_resource_accesses(a, "/reports") == 1, "1 access to /reports")
    assert(aa_resource_accesses(a, "/nope") == 0, "unknown resource 0 accesses")

    let last = aa_last_action(a)
    assert(is_ok(last), "last action present")
    assert(unwrap(last) == "view", "last action was view")

    let rate = aa_denial_rate(a)
    assert(is_ok(rate), "denial rate ok")
    assert(unwrap(rate) == 50, "50% denial rate")

    print("ACCESS-AUDIT KAT PASS")
