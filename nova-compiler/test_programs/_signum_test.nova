// Canonical KAT test for forge_signum (arbitrary-precision signed integer). Adversarially-verified vectors.
import std/numeric/bignum

fn eq_s(name: string, got: string, want: string)
    if got != want
        print("FAIL " + name + ": got '" + got + "' want '" + want + "'")
        exit(1)
    print("ok " + name)

fn main()
    eq_s("mul neg", sn_to_str(sn_mul(sn_from_str("-12345"), sn_from_str("6789"))), "-83810205")
    eq_s("add carry", sn_to_str(sn_add(sn_from_str("99999999999999999999"), sn_from_str("1"))), "100000000000000000000")
    eq_s("sub neg", sn_to_str(sn_sub(sn_from_str("5"), sn_from_str("8"))), "-3")
    eq_s("mul signs", sn_to_str(sn_mul(sn_from_str("-1"), sn_from_str("-1"))), "1")
    eq_s("div trunc", sn_to_str(sn_div(sn_from_str("-83810205"), sn_from_str("6789"))), "-12345")
    eq_s("mod sign", sn_to_str(sn_mod(sn_from_str("-7"), sn_from_str("3"))), "-1")
    // INT_MIN boundary (the fixed defect) — construct via 0 - INT_MAX - 1 to avoid the literal overflow
    eq_s("int_min", sn_to_str(sn_from_int(0 - 9223372036854775807 - 1)), "-9223372036854775808")
    eq_s("int_max", sn_to_str(sn_from_int(9223372036854775807)), "9223372036854775807")
    eq_s("zero norm", sn_to_str(sn_from_str("-0")), "0")
    if sn_cmp(sn_from_str("-100"), sn_from_str("2")) != 0 - 1
        print("FAIL cmp")
        exit(1)
    print("ok cmp")
    print("_signum_test passed")
