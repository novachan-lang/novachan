// functional: exponential backoff schedule + jitter + budget
import forge_retry

fn main()
    if retry_delay(0, 100, 2000) != 100
        print("FAIL d0")
        exit(1)
    if retry_delay(3, 100, 2000) != 800
        print("FAIL d3")
        exit(1)
    if retry_delay(5, 100, 2000) != 2000
        print("FAIL d5cap")
        exit(1)
    if retry_delay(10, 100, 2000) != 2000
        print("FAIL d10cap")
        exit(1)
    if retry_should(2, 3) != true
        print("FAIL should23")
        exit(1)
    if retry_should(3, 3) != false
        print("FAIL should33")
        exit(1)
    if retry_apply_jitter(800, 500) != 400
        print("FAIL jitter")
        exit(1)
    if str(retry_schedule(4, 100, 2000)) != str([100, 200, 400, 800])
        print("FAIL sched = " + str(retry_schedule(4, 100, 2000)))
        exit(1)
    if retry_total_ms(4, 100, 2000) != 1500
        print("FAIL total")
        exit(1)
    print("PASS forge_retry")
