import forge_capacity_pool

fn main()
    let c = cap_new(3)
    assert(cap_capacity(c) == 3, "capacity 3")
    assert(cap_available(c) == 3, "3 available")

    let b1 = cap_borrow(c)
    assert(is_ok(b1), "borrow1 ok")
    c = unwrap(b1)
    let b2 = cap_borrow(c)
    c = unwrap(b2)
    let b3 = cap_borrow(c)
    c = unwrap(b3)
    assert(cap_available(c) == 0, "0 available")
    assert(cap_utilization(c) == 100, "100% util")

    let b4 = cap_borrow(c)
    assert(is_err(b4), "pool exhausted")
    assert(cap_waiter_count(c) == 1, "1 waiter")

    let r1 = cap_return(c)
    assert(is_ok(r1), "return ok")
    c = unwrap(r1)
    assert(cap_available(c) == 1, "1 available")

    assert(cap_total_borrows(c) == 3, "3 borrows")
    assert(cap_total_returns(c) == 1, "1 return")

    print("CAPACITY-POOL KAT PASS")
