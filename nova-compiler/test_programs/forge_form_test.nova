// forge_form_test -- typed form-handling: a handler reads an HTML form POST body (login/signup).
// req_form_all parses the percent-decoded form dict once; req_form is single-field sugar;
// content_type exposes the lowercased type. End-to-end through dispatch + a real handler.
import forge

type LoginResult
    user: string
    ok: bool

fn h_login(req: Request) -> Response
    let form = forge.req_form_all(req)
    let user = ""
    if contains(form, "user")
        user = form["user"]
    let pass = ""
    if contains(form, "pass")
        pass = form["pass"]
    if user == "ada" and pass == "s3cret pw"
        return forge.resp_json(200, LoginResult(user, true))
    forge.resp_json(401, LoginResult(user, false))

fn main()
    let q = chr(34)
    // direct accessors
    let req: Request = forge.build_request("POST /login HTTP/1.1\r\nContent-Type: application/x-www-form-urlencoded\r\nContent-Length: 31\r\n\r\nuser=ada&pass=s3cret+pw", 0)
    assert(forge.content_type(req) == "application/x-www-form-urlencoded", "content_type")
    assert(forge.req_form(req, "user") == "ada", "req_form user")
    assert(forge.req_form(req, "pass") == "s3cret pw", "req_form pass (+ decoded)")
    assert(forge.req_form(req, "missing") == "", "req_form missing -> empty")
    print("PASS: req_form / content_type")

    // through dispatch + a real form handler
    let a = forge.app()
    forge.post(a, "/login", h_login)
    let good: Response = forge.dispatch_req(a, req)
    assert(good.status == 200, "valid creds -> 200")
    assert(find(good.body, q + "ok" + q + ":true") >= 0, "login ok true")
    let bad: Response = forge.dispatch_req(a, forge.build_request("POST /login HTTP/1.1\r\nContent-Type: application/x-www-form-urlencoded\r\nContent-Length: 20\r\n\r\nuser=eve&pass=wrong", 0))
    assert(bad.status == 401, "bad creds -> 401")
    print("PASS: form login handler through dispatch")
    print("forge_form_test passed")
