import std/text/porter

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ---- Canonical Porter KAT vectors (spec-mandated, from the SPEC above) ----

    // Step 1a: plural reductions
    cks("caresses",  pt_stem("caresses"),  "caress")
    cks("ponies",    pt_stem("ponies"),    "poni")
    cks("ties",      pt_stem("ties"),      "ti")
    cks("caress",    pt_stem("caress"),    "caress")
    cks("cats",      pt_stem("cats"),      "cat")

    // Step 1b: -ing removes and doubles consonant
    cks("running",   pt_stem("running"),   "run")

    // Step 1c: -y -> -i
    cks("happy",     pt_stem("happy"),     "happi")

    // Step 2: longer suffixes
    cks("relational",   pt_stem("relational"),   "relat")
    cks("conditional",  pt_stem("conditional"),  "condit")
    cks("rational",     pt_stem("rational"),     "ration")

    // Multi-step: meetings -> meeting (1a) -> meet (1b)
    cks("meetings",  pt_stem("meetings"),  "meet")

    // ---- Additional Porter 1980 paper canonical vectors ----
    // These are taken from Porter's own published suffix list examples.

    // Step 1b double-consonant removal (hopping -> hop not hoppe)
    cks("hopping",   pt_stem("hopping"),   "hop")
    cks("tanned",    pt_stem("tanned"),    "tan")
    cks("hissing",   pt_stem("hissing"),   "hiss")
    cks("fizzed",    pt_stem("fizzed"),    "fizz")

    // Step 1b: no double-consonant, no CVC -> no -e added
    cks("falling",   pt_stem("falling"),   "fall")
    cks("failing",   pt_stem("failing"),   "fail")

    // Step 1a: -ies -> -i (for short: "ties"->ti already above)
    cks("troubles",  pt_stem("troubles"),  "troubl")

    // Step 4: -ion with stem ending s/t
    cks("connection", pt_stem("connection"), "connect")

    // Measure function: generalization -> gener (steps 2+3+4 chain)
    cks("generalization", pt_stem("generalization"), "gener")

    // pt_stem_all: batch stemming
    let words = ["cats", "running", "happy"]
    let stems = pt_stem_all(words)
    cks("all_cats",     str(stems[0]), "cat")
    cks("all_running",  str(stems[1]), "run")
    cks("all_happy",    str(stems[2]), "happi")

    print("_porter_test passed")
