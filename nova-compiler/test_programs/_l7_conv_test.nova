// L7 increment 2: sized-integer conversions (wrapping/narrowing)
fn main()
    let a = u8(300)
    if a != 44
        print("FAIL u8-wrap")
        exit(1)
    let b = u8(255)
    if b != 255
        print("FAIL u8-max")
        exit(1)
    let c = u16(70000)
    if c != 4464
        print("FAIL u16")
        exit(1)
    let d = i8(200)
    if d != 0 - 56
        print("FAIL i8-signext")
        exit(1)
    let e = u32(5000000000)
    if e != 705032704
        print("FAIL u32")
        exit(1)
    let g = u8(10) + u8(5)
    if g != 15
        print("FAIL expr")
        exit(1)
    print("PASS _l7_conv_test")
