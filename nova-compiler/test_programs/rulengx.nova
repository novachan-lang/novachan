fn rules_new()
  []

fn rule_add(rules, name, condition, action)
  push(rules, {"name": name, "condition": condition, "action": action})

fn rules_eval(rules, data)
  let results = []
  for r in rules
    let cond = r["condition"]
    if cond(data) == 1
      let act = r["action"]
      push(results, {"rule": r["name"], "result": act(data)})
  results

fn rules_first_match(rules, data)
  for r in rules
    let cond = r["condition"]
    if cond(data) == 1
      let act = r["action"]
      return ok({"rule": r["name"], "result": act(data)})
  err("no matching rule")

fn _is_adult(data)
  data["age"] >= 18

fn _is_senior(data)
  data["age"] >= 65

fn _is_minor(data)
  data["age"] < 18

fn _grant_full(data)
  "full access"

fn _grant_senior(data)
  "senior discount"

fn _grant_limited(data)
  "limited access"

fn main()
  let rules = rules_new()
  rule_add(rules, "senior", fn(z) _is_senior(z), fn(z) _grant_senior(z))
  rule_add(rules, "adult", fn(z) _is_adult(z), fn(z) _grant_full(z))
  rule_add(rules, "minor", fn(z) _is_minor(z), fn(z) _grant_limited(z))

  let r1 = rules_eval(rules, {"age": 70})
  assert(len(r1) == 2, "senior matches senior + adult")
  assert(r1[0]["rule"] == "senior", "first match = senior")

  let r2 = rules_first_match(rules, {"age": 25})
  assert(is_ok(r2), "adult matches")
  assert(unwrap(r2)["rule"] == "adult", "first = adult")

  let r3 = rules_first_match(rules, {"age": 10})
  assert(unwrap(r3)["rule"] == "minor", "minor match")
  assert(unwrap(r3)["result"] == "limited access", "minor result")

  print("rulengx: all passed")
