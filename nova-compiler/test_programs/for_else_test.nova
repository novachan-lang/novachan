fn find_item(items: list, target: string) -> string
    for item in items
        if item == target
            return "found: " + target
    else
        return "not found"
    return "unreachable"

fn find_index(items: list, target: int) -> int
    let idx = 0
    for item in items
        if item == target
            return idx
        idx = idx + 1
    else
        return -1
    return -999

fn has_negative(nums: list) -> bool
    for n in nums
        if n < 0
            break
    else
        return false
    return true

fn while_else_test() -> string
    let x = 10
    while x > 0
        x = x - 1
        if x == 5
            break
    else
        return "completed"
    return "broke at " + str(x)

fn while_completes() -> string
    let x = 3
    while x > 0
        x = x - 1
    else
        return "loop done naturally"
    return "unreachable"

fn empty_list_else() -> string
    let items = []
    for x in items
        return "found something"
    else
        return "empty list"
    return "unreachable"

fn main()
    // for/else: else runs when no break
    assert_eq(find_item(["a", "b", "c"], "b"), "found: b")
    assert_eq(find_item(["a", "b", "c"], "z"), "not found")

    // for/else with index tracking
    assert_eq(find_index([10, 20, 30], 20), 1)
    assert_eq(find_index([10, 20, 30], 99), -1)

    // for/else with break
    assert_eq(has_negative([1, 2, 3]), false)
    assert_eq(has_negative([1, -2, 3]), true)

    // while/else: break skips else
    assert_eq(while_else_test(), "broke at 5")

    // while/else: natural exit runs else
    assert_eq(while_completes(), "loop done naturally")

    // for/else on empty list: else runs (0 iterations = no break)
    assert_eq(empty_list_else(), "empty list")

    print("for_else_test: all passed")
