import forge_orm

type OrmUser
    id: int
    u_name: string
    u_age: int
    u_score: float
    u_active: bool

type OrmNoId
    ni_label: string
    ni_n: int

fn show(tag: string, v)
    print(tag + "=[" + str(v) + "]")

fn showr(tag: string, r)
    if is_ok(r)
        print(tag + "=[ok " + str(unwrap(r)) + "]")
    else
        print(tag + "=[err " + str(unwrap_err(r)) + "]")

fn main()
    // ── orm_open error paths (no driver contact) ────────────────────────────
    showr("open_badscheme", orm_open("mongodb://x"))
    showr("open_empty", orm_open(""))
    showr("open_pg_noat", orm_open("postgres://nouserhost/db"))
    showr("open_pgql_noat", orm_open("postgresql://nouserhost/db"))
    showr("open_my_noat", orm_open("mysql://nouserhost/db"))
    showr("open_pool_bad", orm_open_with_pool("redis://x", 8))

    // ── orm_null sentinel ───────────────────────────────────────────────────
    show("null_len", len(orm_null()))
    show("null_eq", orm_null() == orm_null())

    // ── query builder (pure strings, no db) ─────────────────────────────────
    let q0 = q_from("users")
    show("q_bare", q0.sql())
    show("q_bare_params", q0.params)
    let q1 = q_from("users").columns("id, name")
    show("q_cols", q1.sql())
    let q2 = q_from("users").where("age > ?", [18])
    show("q_where", q2.sql())
    show("q_where_params", q2.params)
    let q3 = q_from("users").where("age > ?", [18]).where("name = ?", ["bob"])
    show("q_where2", q3.sql())
    show("q_where2_params", q3.params)
    let q4 = q_from("users").where("a = ?", []).order_by("name")
    show("q_emptyps", q4.sql())
    show("q_emptyps_params", q4.params)
    let q5 = q_from("posts").inner_join("users", "users.id = posts.user_id").where("users.active = ?", [1])
    show("q_join", q5.sql())
    let q6 = q_from("posts").left_join("users", "users.id = posts.user_id")
    show("q_ljoin", q6.sql())
    let q7 = q_from("users").limit(10).offset(5)
    show("q_limoff", q7.sql())
    let q8 = q_from("users").paginate(2, 20)
    show("q_page2", q8.sql())
    let q9 = q_from("users").paginate(1, 20)
    show("q_page1", q9.sql())
    let q10 = q_from("users").paginate(0, 20)
    show("q_page0", q10.sql())
    let q11 = q_from("users").paginate(0 - 5, 20)
    show("q_pageneg", q11.sql())
    let q12 = q_from("users").limit(0).offset(0)
    show("q_zerolim", q12.sql())
    let q13 = q_from("t").columns("a").where("x = ?", [1]).inner_join("u", "u.id = t.uid").order_by("a DESC").paginate(3, 5)
    show("q_all", q13.sql())
    show("q_all_params", q13.params)
    let q14 = q_from("")
    show("q_emptytable", q14.sql())
    // immutability of the builder: q0 must be untouched by the chains above
    show("q_bare_again", q0.sql())
    show("q_bare_params_again", q0.params)

    // ── real sqlite round-trip ──────────────────────────────────────────────
    let dbr = orm_open("sqlite://_exf_orm.db")
    if is_err(dbr)
        print("OPENFAIL")
        return
    let db = unwrap(dbr)
    _ = orm_drop_table(db, "OrmUser")
    _ = orm_drop_table(db, "OrmNoId")
    _ = orm_drop_table(db, "Order")
    _ = orm_drop_table(db, "u2")

    // create table from a struct (int/string/float/bool + id PRIMARY KEY)
    showr("create", orm_create_table(db, "u2", OrmUser(0, "", 0, 0.0, false)))
    showr("create_again", orm_create_table(db, "u2", OrmUser(0, "", 0, 0.0, false)))
    showr("create_noid", orm_create_table(db, "OrmNoId", OrmNoId("", 0)))
    showr("create_reserved", orm_create_table(db, "Order", OrmNoId("", 0)))

    // insert with unset id -> auto PK
    showr("ins1", orm_insert(db, "u2", OrmUser(0, "alice", 30, 1.5, true)))
    showr("ins2", orm_insert(db, "u2", OrmUser(0, "bob", 25, 2.5, false)))
    // explicit id
    showr("ins_explicit", orm_insert(db, "u2", OrmUser(99, "carol", 41, 3.25, true)))
    // struct with no id field at all -> nothing skipped
    showr("ins_noid", orm_insert(db, "OrmNoId", OrmNoId("tag", 7)))

    show("count_all", orm_count(db, "u2", "", []))
    show("count_where", orm_count(db, "u2", "u_age > ?", [26]))
    show("count_none", orm_count(db, "u2", "u_age > ?", [1000]))
    show("count_missing_table", orm_count(db, "nosuchtable", "", []))
    show("count_quoted_table", orm_count(db, "we\"ird", "", []))
    show("exists_y", orm_exists(db, "u2", "u_name = ?", ["alice"]))
    show("exists_n", orm_exists(db, "u2", "u_name = ?", ["zzz"]))

    show("agg_min", orm_agg(db, "min", "u_age", "u2", "", []))
    show("agg_max", orm_agg(db, "max", "u_age", "u2", "", []))
    show("agg_sum", orm_agg(db, "sum", "u_age", "u2", "", []))
    show("agg_avg", orm_agg(db, "avg", "u_age", "u2", "", []))
    show("agg_count", orm_agg(db, "count", "u_age", "u2", "", []))
    show("agg_where", orm_agg(db, "max", "u_age", "u2", "u_age < ?", [40]))
    show("agg_bad", orm_agg(db, "count(*); DROP TABLE u2; --", "u_age", "u2", "", []))
    show("agg_empty_fn", orm_agg(db, "", "u_age", "u2", "", []))
    show("agg_norows", orm_agg(db, "max", "u_age", "u2", "u_age > ?", [9999]))

    show("fetch_all", orm_fetch_all(db, "u2"))
    show("fetch_bare", orm_fetch(db))
    show("get1", orm_get(db, "u2", 1))
    show("get_missing", orm_get(db, "u2", 12345))
    show("where_rows", orm_where(db, "u2", "u_age > ?", [26]))
    show("where_none", orm_where(db, "u2", "u_age > ?", [9999]))
    show("one_row", orm_one(db, "SELECT * FROM u2 WHERE id = ?", [2]))
    show("one_none", orm_one(db, "SELECT * FROM u2 WHERE id = ?", [777]))
    show("all_rows", orm_all(db, "SELECT u_name FROM u2 ORDER BY id", []))
    show("all_empty", orm_all(db, "SELECT u_name FROM u2 WHERE 1 = 0", []))

    // typed read through the from_dict machinery
    let tu: Result<OrmUser> = orm_get(db, "u2", 1)
    showr("typed_get", tu)

    // update / modify / delete
    showr("update", orm_update(db, "u2", OrmUser(1, "alice2", 31, 9.5, false)))
    show("after_update", orm_get(db, "u2", 1))
    showr("save", orm_save(db, OrmUser(0, "dave", 50, 0.5, true)))
    showr("modify_noid", orm_modify(db, OrmNoId("x", 1)))
    showr("remove_noid", orm_remove(db, OrmNoId("x", 1)))
    showr("delete", orm_delete(db, "u2", 2))
    show("count_after_delete", orm_count(db, "u2", "", []))
    showr("delete_missing", orm_delete(db, "u2", 4242))

    // NULL params: the ? inside a quoted literal must NOT be treated as a placeholder
    showr("null_ins", orm_exec(db, "INSERT INTO u2 (u_name, u_age, u_score, u_active) VALUES (?, ?, ?, ?)", [orm_null(), 1, 0.0, false]))
    show("null_count", orm_count(db, "u2", "u_name IS NULL", []))
    showr("null_quoted", orm_exec(db, "INSERT INTO u2 (u_name, u_age, u_score, u_active) VALUES ('a?b', ?, ?, ?)", [2, 0.0, false]))
    show("null_quoted_count", orm_count(db, "u2", "u_name = ?", ["a?b"]))
    showr("null_mixed", orm_exec(db, "INSERT INTO u2 (u_name, u_age, u_score, u_active) VALUES (?, ?, ?, ?)", ["z", orm_null(), 0.0, false]))
    show("null_mixed_count", orm_count(db, "u2", "u_name = ? AND u_age IS NULL", ["z"]))

    // exec error paths
    showr("exec_badsql", orm_exec(db, "THIS IS NOT SQL", []))
    showr("exec_noargs", orm_exec(db, "SELECT 1", []))

    show("final_rows", orm_all(db, "SELECT id, u_name, u_age FROM u2 ORDER BY id", []))

    _ = orm_drop_table(db, "u2")
    _ = orm_drop_table(db, "OrmNoId")
    _ = orm_drop_table(db, "Order")
    orm_close(db)
    print("DONE")
