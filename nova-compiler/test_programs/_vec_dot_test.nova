import std/vector/vec_dot

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn main()
    // vd_dot
    cki("vd_dot([1,2,3],[4,5,6])", vd_dot([1, 2, 3], [4, 5, 6]), 32)
    cki("vd_dot([1,0],[0,1])", vd_dot([1, 0], [0, 1]), 0)
    cki("vd_dot_neg", vd_dot([0-1, 2], [3, 0-4]), 0-11)

    // vd_norm_sq
    cki("vd_norm_sq([3,4])", vd_norm_sq([3, 4]), 25)
    cki("vd_norm_sq([1,2,2])", vd_norm_sq([1, 2, 2]), 9)
    cki("vd_norm_sq([0,0,0])", vd_norm_sq([0, 0, 0]), 0)
    cki("vd_norm_sq([5])", vd_norm_sq([5]), 25)

    // vd_is_zero
    ckb("vd_is_zero([0,0,0])", vd_is_zero([0, 0, 0]), true)
    ckb("vd_is_zero([0,1,0])", vd_is_zero([0, 1, 0]), false)
    ckb("vd_is_zero([])", vd_is_zero([]), true)

    // vd_is_orthogonal
    ckb("vd_is_orthogonal([1,0],[0,1])", vd_is_orthogonal([1, 0], [0, 1]), true)
    ckb("vd_is_orthogonal([1,1],[1,0-1])", vd_is_orthogonal([1, 1], [1, 0-1]), true)
    ckb("vd_is_orthogonal([1,2],[3,4])", vd_is_orthogonal([1, 2], [3, 4]), false)

    // vd_dot mismatched lengths uses min
    cki("vd_dot_mismatch", vd_dot([1, 2, 3], [10, 20]), 50)

    print("PASS _vec_dot_test")
