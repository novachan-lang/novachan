// Track 8 soundness test: exercises multiple escape patterns to verify
// RC elision and use-after-move enforcement don't break correctness.
// Must produce identical output under default mode AND NOVA_TRACK8=1.

// Pattern A: pure local list — should elide RC under T8
fn sum_local(n: int) -> int
    let xs = []
    let i = 0
    while i < n
        xs.push(i * 2)
        i = i + 1
    let total = 0
    let j = 0
    while j < len(xs)
        total = total + xs[j]
        j = j + 1
    total

// Pattern B: return a list — escapes via return; RC must be kept
fn make_list(n: int) -> list
    let xs = []
    let i = 0
    while i < n
        xs.push(i + 100)
        i = i + 1
    xs

// Pattern C: build a dict locally, look up, discard
fn count_evens(n: int) -> int
    let d = {}
    let i = 0
    while i < n
        if i % 2 == 0
            d[str(i)] = 1
        i = i + 1
    len(d)

// Pattern D: nested function call with list arg (not escaping)
fn list_max(xs: list) -> int
    let mx = xs[0]
    let i = 1
    while i < len(xs)
        if xs[i] > mx
            mx = xs[i]
        i = i + 1
    mx

fn main()
    // A: 100 elements, sum = 2*(0+1+...+99) = 2 * 99*100/2 = 9900
    let a = sum_local(100)
    print(a)

    // B: returned list, iterate in caller
    let bl = make_list(10)
    let bs = 0
    let bi = 0
    while bi < len(bl)
        bs = bs + bl[bi]
        bi = bi + 1
    print(bs)

    // C: local dict, count evens in 0..20 = 10
    let c = count_evens(20)
    print(c)

    // D: pass list to fn, get max
    let dl = []
    dl.push(5)
    dl.push(42)
    dl.push(17)
    dl.push(99)
    dl.push(3)
    print(list_max(dl))
