import forge_bencode

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // encode primitives
    fails = fails + expect("enc_int", bencode_encode(42), "i42e")
    fails = fails + expect("enc_neg", bencode_encode(0 - 3), "i-3e")
    fails = fails + expect("enc_zero", bencode_encode(0), "i0e")
    fails = fails + expect("enc_str", bencode_encode("spam"), "4:spam")
    fails = fails + expect("enc_empty_str", bencode_encode(""), "0:")

    // encode list
    fails = fails + expect("enc_list", bencode_encode(["spam", 42]), "l4:spami42ee")
    fails = fails + expect("enc_empty_list", bencode_encode([]), "le")

    // encode dict (keys sorted canonically)
    let d = {}
    d["foo"] = 42
    d["bar"] = "spam"
    fails = fails + expect("enc_dict", bencode_encode(d), "d3:bar4:spam3:fooi42ee")
    // canonical cow/spam example
    let d2 = {}
    d2["spam"] = "eggs"
    d2["cow"] = "moo"
    fails = fails + expect("enc_cow", bencode_encode(d2), "d3:cow3:moo4:spam4:eggse")

    // round-trips: decode then re-encode should reproduce the canonical string
    fails = fails + expect("rt_int", bencode_encode(bencode_decode("i42e")), "i42e")
    fails = fails + expect("rt_neg", bencode_encode(bencode_decode("i-99e")), "i-99e")
    fails = fails + expect("rt_str", bencode_encode(bencode_decode("4:spam")), "4:spam")
    fails = fails + expect("rt_list", bencode_encode(bencode_decode("l4:spami42ee")), "l4:spami42ee")
    fails = fails + expect("rt_dict", bencode_encode(bencode_decode("d3:cow3:moo4:spam4:eggse")), "d3:cow3:moo4:spam4:eggse")
    fails = fails + expect("rt_nested", bencode_encode(bencode_decode("d4:listl1:a1:bi7ee3:numi42ee")), "d4:listl1:a1:bi7ee3:numi42ee")

    // decode then access a value
    let dec = bencode_decode("d3:bar4:spam3:fooi42ee")
    fails = fails + expect("dec_access", str(dec["foo"]) + "/" + dec["bar"], "42/spam")

    // decode a string with numbers in it (length-prefixed, so ':' inside is safe)
    fails = fails + expect("rt_colon", bencode_encode(bencode_decode("5:a:b:c")), "5:a:b:c")

    if fails == 0
        print("forge_bencode: all passed")
    else
        print("forge_bencode: " + str(fails) + " FAILED")
