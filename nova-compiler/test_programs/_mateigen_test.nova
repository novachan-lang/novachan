import std/matrix/mateigen

// Float tolerance check.
fn _ckf(label: string, got: float, want: float, tol: float)
    let diff = got - want
    if diff < 0.0
        diff = 0.0 - diff
    if diff > tol
        print("FAIL mateigen " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// Bool check.
fn _ckb(label: string, got: bool, want: bool)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL mateigen " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

// Build a 2x2 float matrix.
fn _mat2(a: float, b: float, c: float, d: float) -> dict
    let data = []
    push(data, a)
    push(data, b)
    push(data, c)
    push(data, d)
    meig_make(2, 2, data)

// Build a 3x3 float matrix (row-major).
fn _mat3(a00: float, a01: float, a02: float, a10: float, a11: float, a12: float, a20: float, a21: float, a22: float) -> dict
    let data = []
    push(data, a00)
    push(data, a01)
    push(data, a02)
    push(data, a10)
    push(data, a11)
    push(data, a12)
    push(data, a20)
    push(data, a21)
    push(data, a22)
    meig_make(3, 3, data)

fn main()
    let tol = 0.001

    // ── meig_eig_2x2: [[2,0],[0,3]] -> eigenvalues {3, 2} ────────────────────
    let diag = _mat2(2.0, 0.0, 0.0, 3.0)
    let eigs_diag = meig_eig_2x2(diag)
    // Sorted descending: [3, 2].
    _ckf("eig2x2_diag_0", eigs_diag[0] * 1.0, 3.0, tol)
    _ckf("eig2x2_diag_1", eigs_diag[1] * 1.0, 2.0, tol)

    // ── meig_eig_2x2: [[2,1],[1,2]] -> eigenvalues {3, 1} ────────────────────
    let sym = _mat2(2.0, 1.0, 1.0, 2.0)
    let eigs_sym = meig_eig_2x2(sym)
    // Sorted descending: [3, 1].
    _ckf("eig2x2_sym_0", eigs_sym[0] * 1.0, 3.0, tol)
    _ckf("eig2x2_sym_1", eigs_sym[1] * 1.0, 1.0, tol)

    // ── meig_trace: [[2,1],[1,2]] == 4.0 (= 3 + 1) ───────────────────────────
    let tr = meig_trace(sym)
    _ckf("trace_2x2", tr, 4.0, tol)

    // ── meig_char_poly_2x2: [[2,1],[1,2]] -> [1, -4, 3] ─────────────────────
    let cp = meig_char_poly_2x2(sym)
    _ckf("char_poly_0", cp[0] * 1.0, 1.0, tol)
    _ckf("char_poly_1", cp[1] * 1.0, 0.0 - 4.0, tol)
    _ckf("char_poly_2", cp[2] * 1.0, 3.0, tol)

    // ── meig_det_from_eigs: product == det ────────────────────────────────────
    // For [[2,1],[1,2]] eigs = {3, 1}, det = 3*1 = 3 = 2*2 - 1*1 = 3.
    let det_from_eigs = meig_det_from_eigs(eigs_sym)
    _ckf("det_from_eigs", det_from_eigs, 3.0, tol)

    // ── meig_dominant_value: [[2,0],[0,3]] -> 3.0 ───────────────────────────
    let dom = meig_dominant_value(diag, 200)
    _ckf("dominant_3x3", dom, 3.0, tol)

    // ── meig_power: [[2,1],[1,2]] dominant value == 3.0 ──────────────────────
    let pair = meig_power(sym, 200)
    let pval = pair["value"] * 1.0
    _ckf("power_value", pval, 3.0, tol)
    // Eigenvector must have unit norm.
    let pvec = pair["vector"]
    let pn = 0.0
    let pi = 0
    while pi < len(pvec)
        let v = pvec[pi] * 1.0
        pn = pn + v * v
        pi = pi + 1
    let pnorm = sqrt(pn)
    _ckf("power_vec_norm", pnorm, 1.0, tol)

    // ── meig_is_symmetric: [[2,1],[1,2]] is symmetric ────────────────────────
    let is_sym = meig_is_symmetric(sym, tol)
    _ckb("is_sym_true", is_sym, true)
    // [[1,2],[3,4]] is not symmetric.
    let asym = _mat2(1.0, 2.0, 3.0, 4.0)
    let is_asym = meig_is_symmetric(asym, tol)
    _ckb("is_sym_false", is_asym, false)

    // ── meig_eigenvalues_symmetric: [[2,1],[1,2]] -> {3, 1} ─────────────────
    let eigs_qr = meig_eigenvalues_symmetric(sym, 200, 0.000001)
    // Results sorted descending.
    _ckf("qr_eig_0", eigs_qr[0] * 1.0, 3.0, tol)
    _ckf("qr_eig_1", eigs_qr[1] * 1.0, 1.0, tol)

    // ── meig_eigenvalues_symmetric: [[2,0],[0,3]] -> {3, 2} ─────────────────
    let eigs_qr2 = meig_eigenvalues_symmetric(diag, 200, 0.000001)
    _ckf("qr_eig2_0", eigs_qr2[0] * 1.0, 3.0, tol)
    _ckf("qr_eig2_1", eigs_qr2[1] * 1.0, 2.0, tol)

    // ── 3x3 symmetric test: [[4,2,0],[2,3,1],[0,1,2]] ─────────────────────────
    // trace = 4+3+2 = 9, sum of eigenvalues == 9.
    let a3 = _mat3(4.0, 2.0, 0.0, 2.0, 3.0, 1.0, 0.0, 1.0, 2.0)
    let tr3 = meig_trace(a3)
    _ckf("trace_3x3", tr3, 9.0, tol)
    let eigs3 = meig_eigenvalues_symmetric(a3, 500, 0.000001)
    // Sum of eigenvalues must match trace.
    let eig_sum = eigs3[0] * 1.0 + eigs3[1] * 1.0 + eigs3[2] * 1.0
    _ckf("eig_sum_eq_trace", eig_sum, 9.0, tol)

    // QR result should match closed-form for 2x2.
    // For [[2,1],[1,2]], both meig_eig_2x2 and meig_eigenvalues_symmetric must agree.
    let close0 = eigs_qr[0] * 1.0
    let close1 = eigs_qr[1] * 1.0
    let cf0 = eigs_sym[0] * 1.0
    let cf1 = eigs_sym[1] * 1.0
    _ckf("qr_vs_cf_0", close0, cf0, tol)
    _ckf("qr_vs_cf_1", close1, cf1, tol)

    print("PASS _mateigen_test")
