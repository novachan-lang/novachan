import std/devtool/gitignore_star

fn main()
    // --- gis_has_doublestar ---
    let r1 = gis_has_doublestar("a/**/b")
    if r1 != 1
        print("FAIL gis_has_doublestar-middle: got " + str(r1) + " want 1")
        exit(1)

    let r2 = gis_has_doublestar("*.txt")
    if r2 != 0
        print("FAIL gis_has_doublestar-single-star: got " + str(r2) + " want 0")
        exit(1)

    let r3 = gis_has_doublestar("**")
    if r3 != 1
        print("FAIL gis_has_doublestar-lone: got " + str(r3) + " want 1")
        exit(1)

    let r4 = gis_has_doublestar("")
    if r4 != 0
        print("FAIL gis_has_doublestar-empty: got " + str(r4) + " want 0")
        exit(1)

    // --- gis_expand ---
    let e1 = gis_expand("a/**/b")
    if len(e1) != 2 or e1[0] != "a/" or e1[1] != "/b"
        print("FAIL gis_expand-middle: got len=" + str(len(e1)))
        exit(1)

    let e2 = gis_expand("**/foo")
    if len(e2) != 2 or e2[0] != "" or e2[1] != "/foo"
        print("FAIL gis_expand-leading")
        exit(1)

    let e3 = gis_expand("noStars")
    if len(e3) != 1 or e3[0] != "noStars"
        print("FAIL gis_expand-none")
        exit(1)

    let e4 = gis_expand("foo/**")
    if len(e4) != 2 or e4[0] != "foo/" or e4[1] != ""
        print("FAIL gis_expand-trailing")
        exit(1)

    // --- gis_match: leading **/ matches in all directories (zero or more) ---
    let m1 = gis_match("**/foo", "foo")
    if m1 != 1
        print("FAIL gis_match-leading-zero-dirs: got " + str(m1) + " want 1")
        exit(1)

    let m2 = gis_match("**/foo", "a/b/foo")
    if m2 != 1
        print("FAIL gis_match-leading-two-dirs: got " + str(m2) + " want 1")
        exit(1)

    let m3 = gis_match("**/foo", "a/foobar")
    if m3 != 0
        print("FAIL gis_match-leading-nomatch: got " + str(m3) + " want 0")
        exit(1)

    // --- gis_match: trailing /** matches everything inside (one or more) ---
    let m4 = gis_match("foo/**", "foo/a/b")
    if m4 != 1
        print("FAIL gis_match-trailing-nested: got " + str(m4) + " want 1")
        exit(1)

    let m5 = gis_match("foo/**", "foo")
    if m5 != 0
        print("FAIL gis_match-trailing-bare-dir: got " + str(m5) + " want 0")
        exit(1)

    let m6 = gis_match("foo/**", "foo/a")
    if m6 != 1
        print("FAIL gis_match-trailing-one: got " + str(m6) + " want 1")
        exit(1)

    // --- gis_match: middle /**/ matches zero or more directories ---
    let m7 = gis_match("a/**/b", "a/b")
    if m7 != 1
        print("FAIL gis_match-middle-zero: got " + str(m7) + " want 1")
        exit(1)

    let m8 = gis_match("a/**/b", "a/x/y/b")
    if m8 != 1
        print("FAIL gis_match-middle-two: got " + str(m8) + " want 1")
        exit(1)

    let m9 = gis_match("a/**/b", "a/x/y/c")
    if m9 != 0
        print("FAIL gis_match-middle-nomatch: got " + str(m9) + " want 0")
        exit(1)

    // --- gis_match_recursive: direct segment-list API ---
    let segs = []
    push(segs, "**")
    push(segs, "foo")
    let path_segs = []
    push(path_segs, "x")
    push(path_segs, "foo")
    let m10 = gis_match_recursive(segs, path_segs)
    if m10 != 1
        print("FAIL gis_match_recursive-direct: got " + str(m10) + " want 1")
        exit(1)

    let path_segs2 = []
    push(path_segs2, "x")
    push(path_segs2, "bar")
    let m11 = gis_match_recursive(segs, path_segs2)
    if m11 != 0
        print("FAIL gis_match_recursive-direct-nomatch: got " + str(m11) + " want 0")
        exit(1)

    print("PASS _gitignore_star_test")
