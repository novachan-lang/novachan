import forge_doc_gen

fn main()
    let dg = dg_new()
    let src = ```
# Adds two integers together.
fn add(a, b)
    a + b

// Multiplies two integers.
// Returns the product.
fn multiply(x, y)
    x * y

fn no_doc_fn(z)
    z
```
    dg = dg_parse_file(dg, "sample.nova", src)

    assert(dg_fn_count(dg) == 3, "3 functions found")

    let flist = dg_fn_list(dg)
    assert(find(flist, "add") >= 0, "list has add")
    assert(find(flist, "multiply") >= 0, "list has multiply")
    assert(find(flist, "no_doc_fn") >= 0, "list has no_doc_fn")

    let p_add = dg_param_list(dg, "add")
    assert(is_ok(p_add), "add params ok")
    assert(unwrap(p_add) == "a, b", "add params correct")

    let p_mul = dg_param_list(dg, "multiply")
    assert(is_ok(p_mul), "multiply params ok")
    assert(unwrap(p_mul) == "x, y", "multiply params correct")

    let p_nodoc = dg_param_list(dg, "no_doc_fn")
    assert(is_ok(p_nodoc), "no_doc_fn params ok")
    assert(unwrap(p_nodoc) == "z", "no_doc_fn params correct")

    assert(dg_has_fn(dg, "add") == 1, "has add")
    assert(dg_has_fn(dg, "missing_fn") == 0, "no missing_fn")

    let g_add = dg_get_fn(dg, "add")
    assert(is_ok(g_add), "get add ok")
    let g_add_s = unwrap(g_add)
    assert(find(g_add_s, "Adds two integers") >= 0, "add doc text present")

    let g_mul = dg_get_fn(dg, "multiply")
    assert(is_ok(g_mul), "get multiply ok")
    let g_mul_s = unwrap(g_mul)
    assert(find(g_mul_s, "Multiplies two integers") >= 0, "multiply doc text present")

    let r_add = dg_render_fn(dg, "add")
    assert(is_ok(r_add), "render add ok")
    let r_add_s = unwrap(r_add)
    assert(find(r_add_s, "## add") >= 0, "render has heading")
    assert(find(r_add_s, "a, b") >= 0, "render has params")

    let bad_render = dg_render_fn(dg, "not_a_fn")
    assert(is_err(bad_render), "render unknown fn is err")

    let bad_param = dg_param_list(dg, "not_a_fn")
    assert(is_err(bad_param), "params unknown fn is err")

    let bad_get = dg_get_fn(dg, "not_a_fn")
    assert(is_err(bad_get), "get unknown fn is err")

    let all_rendered = dg_render_all(dg)
    assert(len(all_rendered) > 50, "render_all has content")
    assert(find(all_rendered, "add") >= 0, "render_all mentions add")

    let f0 = dg_fn_at(dg, 0)
    assert(is_ok(f0), "fn_at 0 ok")
    let f_bad = dg_fn_at(dg, 99)
    assert(is_err(f_bad), "fn_at out of range err")

    print("DOC-GEN KAT PASS")
