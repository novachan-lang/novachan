// KAT for prism/ui/prism_ui_timeline.nova (the `ui/` composition layer's vertical timeline
// component: single entry, plain timeline, step-indicator timeline, changelog).
//
// Proves, against concrete expected values (every depth/count is hand-computed from
// prism_node.nova's own `depth = max(child depths) + 1`, `count = 1 + sum(child counts)` rule,
// never guessed):
//   1. Status: all 4 values construct, the exhaustive name match is correct, and the exhaustive
//      icon match maps each to a DISTINCT icon (minus/chevron_right/check/close).
//   2. Item: exact band(d=2,c=2 children) without a description, exact stack(d=3,c=2 children)
//      with one, a present-but-empty description degrades to no-description, rejects an empty
//      label.
//   3. Timeline: exact stack(d=3,c=10) over 3 uniform items, exact stack(d=4,c=9) over a MIXED
//      list (one item with a description, one without); rejects an empty list and a
//      non-PrismNode element (index + actual type named).
//   4. Step timeline: exact done/active/pending derivation at an interior index, at index 0, and
//      at the last index, each step's icon proven to match its derived status exactly; rejects
//      an empty steps list, a non-string step, an empty step string, a negative current_index,
//      and an out-of-range current_index (all 5 named by index or value where applicable).
//   5. Changelog: PrismTlChange ctor rejects an empty version and an empty summary but ACCEPTS
//      an empty date (Keep-a-Changelog "Unreleased" case); exact stack(d=4,c=16) over 3 entries,
//      description text round-trips exactly ("date: summary" when dated, "summary" alone when
//      not); rejects an empty entries list and a non-PrismTlChange element.
//   6. Kind check: the four component families render through prism_node_kind_str as exactly
//      "band"/"stack" -- the literal PRISM_SPEC.md vocabulary strings this layer stays closed
//      over (axiom A7).
//   7. Rejection tally: at least 8 distinct rejections are proven above (12, counted explicitly).
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova into
// $NOVA_HOME/lib, so `import prism_node` / `import prism_ui_timeline` resolve.
//   ./gen3_test.exe _kat_prism_ui_timeline.nova
//   clang -O2 -o _kat_prism_ui_timeline.exe _kat_prism_ui_timeline.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_ui_timeline.exe

import prism_node
import prism_content
import prism_ui_timeline as tl

let FAILED = [0]

fn _check(label: string, got: string, want: string)
    if got == want
        print("  pass  " + label)
    else
        print("  FAIL  " + label + "  got=" + got + "  want=" + want)
        FAILED[0] = FAILED[0] + 1

fn _check_true(label: string, cond: bool)
    if cond
        print("  pass  " + label)
    else
        print("  FAIL  " + label)
        FAILED[0] = FAILED[0] + 1

fn main()
    // ── 1. Status: 4 ctors, exhaustive name match, exhaustive icon match, all 4 distinct ─────
    let statuses = [tl.prism_tl_pending(), tl.prism_tl_active(), tl.prism_tl_done(), tl.prism_tl_error()]
    _check("status name: pending", tl.prism_tl_status_name(statuses[0]), "pending")
    _check("status name: active", tl.prism_tl_status_name(statuses[1]), "active")
    _check("status name: done", tl.prism_tl_status_name(statuses[2]), "done")
    _check("status name: error", tl.prism_tl_status_name(statuses[3]), "error")
    let icon_names = []
    for s in statuses
        icon_names.push(prism_content.prism_icon_name(tl.prism_tl_status_icon(s)))
    _check("status icon: pending -> minus", icon_names[0], "minus")
    _check("status icon: active -> chevron_right", icon_names[1], "chevron_right")
    _check("status icon: done -> check", icon_names[2], "check")
    _check("status icon: error -> close", icon_names[3], "close")
    let seen_icons = {}
    for nm in icon_names
        seen_icons[nm] = true
    _check("all 4 status icons are pairwise distinct", str(len(seen_icons.keys())), "4")
    print("")

    // ── 2. Item: exact band w/o description, exact stack w/ one, blank degrades, rejections ──
    let item_r = tl.prism_tl_item("Order placed", none(), tl.prism_tl_done())
    _check_true("item (no description) constructs", is_ok(item_r))
    let item_node = unwrap(item_r)
    _check("item kind_str", prism_node.prism_node_kind_str(item_node), "band")
    _check("item depth", str(prism_node.prism_node_depth(item_node)), "2")
    _check("item count", str(prism_node.prism_node_count(item_node)), "3")
    let item_kids = prism_node.prism_node_children(item_node)
    _check("item child count", str(len(item_kids)), "2")
    _check("item glyph icon", prism_node.prism_node_attr_str(item_kids[0], "icon", ""), "check")
    _check("item label text", prism_node.prism_node_attr_str(item_kids[1], "text", ""), "Order placed")

    let item2_r = tl.prism_tl_item("Upload failed", some("The file exceeded the 10 MB limit."), tl.prism_tl_error())
    _check_true("item (with description) constructs", is_ok(item2_r))
    let item2_node = unwrap(item2_r)
    _check("item2 kind_str", prism_node.prism_node_kind_str(item2_node), "stack")
    _check("item2 depth", str(prism_node.prism_node_depth(item2_node)), "3")
    _check("item2 count", str(prism_node.prism_node_count(item2_node)), "5")
    let item2_kids = prism_node.prism_node_children(item2_node)
    _check("item2 child count", str(len(item2_kids)), "2")
    _check("item2 head kind_str", prism_node.prism_node_kind_str(item2_kids[0]), "band")
    _check("item2 description text", prism_node.prism_node_attr_str(item2_kids[1], "text", ""), "The file exceeded the 10 MB limit.")
    let item2_head_kids = prism_node.prism_node_children(item2_kids[0])
    _check("item2 head glyph icon", prism_node.prism_node_attr_str(item2_head_kids[0], "icon", ""), "close")
    _check("item2 head label text", prism_node.prism_node_attr_str(item2_head_kids[1], "text", ""), "Upload failed")

    // A present-but-empty description degrades to no-description (same tolerance as
    // prism_ui_kit's own `note: string?`, prism_fb_alert's own `detail: string?`).
    let item3_r = tl.prism_tl_item("Saved", some(""), tl.prism_tl_done())
    _check_true("item (blank Some description) constructs", is_ok(item3_r))
    _check("item3 kind_str (degrades to no-description band)", prism_node.prism_node_kind_str(unwrap(item3_r)), "band")

    let item_empty_label_r = tl.prism_tl_item("", none(), tl.prism_tl_pending())
    _check_true("item rejects an empty label", is_err(item_empty_label_r))
    print("")

    // ── 3. Timeline: exact uniform stack, exact mixed stack, rejections ──────────────────────
    let ta = unwrap(tl.prism_tl_item("Ordered", none(), tl.prism_tl_done()))
    let tb = unwrap(tl.prism_tl_item("Shipped", none(), tl.prism_tl_active()))
    let tc = unwrap(tl.prism_tl_item("Delivered", none(), tl.prism_tl_pending()))
    let timeline_r = tl.prism_tl_timeline([ta, tb, tc])
    _check_true("timeline (3 uniform items) constructs", is_ok(timeline_r))
    let timeline_node = unwrap(timeline_r)
    _check("timeline kind_str", prism_node.prism_node_kind_str(timeline_node), "stack")
    _check("timeline depth", str(prism_node.prism_node_depth(timeline_node)), "3")
    _check("timeline count", str(prism_node.prism_node_count(timeline_node)), "10")
    _check("timeline child count", str(prism_node.prism_node_child_count(timeline_node)), "3")

    let td = unwrap(tl.prism_tl_item("Note", some("extra detail"), tl.prism_tl_active()))
    let mixed_r = tl.prism_tl_timeline([td, ta])
    _check_true("timeline (mixed shapes) constructs", is_ok(mixed_r))
    let mixed_node = unwrap(mixed_r)
    _check("mixed timeline depth", str(prism_node.prism_node_depth(mixed_node)), "4")
    _check("mixed timeline count", str(prism_node.prism_node_count(mixed_node)), "9")
    _check("mixed timeline child count", str(prism_node.prism_node_child_count(mixed_node)), "2")

    let timeline_empty_r = tl.prism_tl_timeline([])
    _check_true("timeline rejects an empty list", is_err(timeline_empty_r))
    let timeline_bad_elem_r = tl.prism_tl_timeline([ta, "not a node"])
    _check_true("timeline rejects a non-PrismNode element", is_err(timeline_bad_elem_r))
    if is_err(timeline_bad_elem_r)
        _check_true("rejection names the offending index and type", contains(unwrap_err(timeline_bad_elem_r), "1") and contains(unwrap_err(timeline_bad_elem_r), "string"))
    print("")

    // ── 4. Step timeline: exact done/active/pending derivation, icon-per-status, rejections ──
    let steps = ["Ordered", "Shipped", "Delivered"]
    let step_r = tl.prism_tl_step_timeline(steps, 1)
    _check_true("step timeline (interior current_index=1) constructs", is_ok(step_r))
    let step_node = unwrap(step_r)
    _check("step timeline kind_str", prism_node.prism_node_kind_str(step_node), "stack")
    _check("step timeline depth", str(prism_node.prism_node_depth(step_node)), "3")
    _check("step timeline count", str(prism_node.prism_node_count(step_node)), "10")
    let step_kids = prism_node.prism_node_children(step_node)
    _check("step timeline child count", str(len(step_kids)), "3")
    let step0_kids = prism_node.prism_node_children(step_kids[0])
    _check("step 0 (< current) icon -> done/check", prism_node.prism_node_attr_str(step0_kids[0], "icon", ""), "check")
    let step1_kids = prism_node.prism_node_children(step_kids[1])
    _check("step 1 (== current) icon -> active/chevron_right", prism_node.prism_node_attr_str(step1_kids[0], "icon", ""), "chevron_right")
    let step2_kids = prism_node.prism_node_children(step_kids[2])
    _check("step 2 (> current) icon -> pending/minus", prism_node.prism_node_attr_str(step2_kids[0], "icon", ""), "minus")
    _check("step 1 label text", prism_node.prism_node_attr_str(step1_kids[1], "text", ""), "Shipped")

    // Edge: current_index = 0 -> first step active, rest pending, none done yet.
    let step_first_r = tl.prism_tl_step_timeline(steps, 0)
    _check_true("step timeline (current_index=0) constructs", is_ok(step_first_r))
    let step_first_kids = prism_node.prism_node_children(unwrap(step_first_r))
    _check("current_index=0: step 0 is active", prism_node.prism_node_attr_str(prism_node.prism_node_children(step_first_kids[0])[0], "icon", ""), "chevron_right")
    _check("current_index=0: step 1 is pending", prism_node.prism_node_attr_str(prism_node.prism_node_children(step_first_kids[1])[0], "icon", ""), "minus")
    _check("current_index=0: step 2 is pending", prism_node.prism_node_attr_str(prism_node.prism_node_children(step_first_kids[2])[0], "icon", ""), "minus")

    // Edge: current_index = last -> all prior steps done, last is active, none pending.
    let step_last_r = tl.prism_tl_step_timeline(steps, 2)
    _check_true("step timeline (current_index=last) constructs", is_ok(step_last_r))
    let step_last_kids = prism_node.prism_node_children(unwrap(step_last_r))
    _check("current_index=last: step 0 is done", prism_node.prism_node_attr_str(prism_node.prism_node_children(step_last_kids[0])[0], "icon", ""), "check")
    _check("current_index=last: step 1 is done", prism_node.prism_node_attr_str(prism_node.prism_node_children(step_last_kids[1])[0], "icon", ""), "check")
    _check("current_index=last: step 2 is active", prism_node.prism_node_attr_str(prism_node.prism_node_children(step_last_kids[2])[0], "icon", ""), "chevron_right")

    let step_empty_r = tl.prism_tl_step_timeline([], 0)
    _check_true("step timeline rejects an empty steps list", is_err(step_empty_r))
    let step_non_string_r = tl.prism_tl_step_timeline(["Ordered", 5], 0)
    _check_true("step timeline rejects a non-string step", is_err(step_non_string_r))
    if is_err(step_non_string_r)
        _check_true("non-string rejection names the offending index", contains(unwrap_err(step_non_string_r), "1"))
    let step_empty_str_r = tl.prism_tl_step_timeline(["Ordered", ""], 0)
    _check_true("step timeline rejects an empty step string", is_err(step_empty_str_r))
    let step_neg_idx_r = tl.prism_tl_step_timeline(steps, -1)
    _check_true("step timeline rejects a negative current_index", is_err(step_neg_idx_r))
    let step_oob_idx_r = tl.prism_tl_step_timeline(steps, 3)
    _check_true("step timeline rejects an out-of-range current_index", is_err(step_oob_idx_r))
    print("")

    // ── 5. Changelog: ctor rejections, allows empty date, exact structure + description text ──
    let change_empty_version_r = tl.prism_tlc_new("", "2026-08-01", "Added timeline component")
    _check_true("prism_tlc_new rejects an empty version", is_err(change_empty_version_r))
    let change_empty_summary_r = tl.prism_tlc_new("1.2.0", "2026-08-01", "")
    _check_true("prism_tlc_new rejects an empty summary", is_err(change_empty_summary_r))
    let change_empty_date_r = tl.prism_tlc_new("1.0.0-unreleased", "", "Initial changelog scaffold")
    _check_true("prism_tlc_new ACCEPTS an empty date (Unreleased convention)", is_ok(change_empty_date_r))

    let c1 = unwrap(tl.prism_tlc_new("1.2.0", "2026-08-01", "Added timeline component"))
    let c2 = unwrap(tl.prism_tlc_new("1.1.0", "2026-07-15", "Fixed a rendering bug"))
    let c3 = unwrap(change_empty_date_r)
    let changelog_r = tl.prism_tl_changelog([c1, c2, c3])
    _check_true("changelog (3 entries) constructs", is_ok(changelog_r))
    let changelog_node = unwrap(changelog_r)
    _check("changelog kind_str", prism_node.prism_node_kind_str(changelog_node), "stack")
    _check("changelog depth", str(prism_node.prism_node_depth(changelog_node)), "4")
    _check("changelog count", str(prism_node.prism_node_count(changelog_node)), "16")
    let changelog_kids = prism_node.prism_node_children(changelog_node)
    _check("changelog child count", str(len(changelog_kids)), "3")

    // Entry 0: dated -- description is "date: summary".
    _check("changelog entry 0 kind_str", prism_node.prism_node_kind_str(changelog_kids[0]), "stack")
    let c0_kids = prism_node.prism_node_children(changelog_kids[0])
    let c0_head_kids = prism_node.prism_node_children(c0_kids[0])
    _check("changelog entry 0 version (label)", prism_node.prism_node_attr_str(c0_head_kids[1], "text", ""), "1.2.0")
    _check("changelog entry 0 description (dated)", prism_node.prism_node_attr_str(c0_kids[1], "text", ""), "2026-08-01: Added timeline component")
    _check("changelog entry 0 icon (TlDone)", prism_node.prism_node_attr_str(c0_head_kids[0], "icon", ""), "check")

    // Entry 2: undated -- description is the summary ALONE, no leading "`: `".
    let c2_kids = prism_node.prism_node_children(changelog_kids[2])
    let c2_head_kids = prism_node.prism_node_children(c2_kids[0])
    _check("changelog entry 2 version (undated)", prism_node.prism_node_attr_str(c2_head_kids[1], "text", ""), "1.0.0-unreleased")
    _check("changelog entry 2 description (undated, no colon prefix)", prism_node.prism_node_attr_str(c2_kids[1], "text", ""), "Initial changelog scaffold")

    let changelog_empty_r = tl.prism_tl_changelog([])
    _check_true("changelog rejects an empty entries list", is_err(changelog_empty_r))
    let changelog_bad_elem_r = tl.prism_tl_changelog([c1, "not a change"])
    _check_true("changelog rejects a non-PrismTlChange element", is_err(changelog_bad_elem_r))
    if is_err(changelog_bad_elem_r)
        _check_true("changelog rejection names the offending index and type", contains(unwrap_err(changelog_bad_elem_r), "1") and contains(unwrap_err(changelog_bad_elem_r), "string"))
    print("")

    // ── 6. Kind check: band (bare item), stack (item w/ desc, timeline, steps, changelog) ────
    _check("kind check: item w/o description -> band", prism_node.prism_node_kind_str(item_node), "band")
    _check("kind check: item w/ description -> stack", prism_node.prism_node_kind_str(item2_node), "stack")
    _check("kind check: timeline -> stack", prism_node.prism_node_kind_str(timeline_node), "stack")
    _check("kind check: step timeline -> stack", prism_node.prism_node_kind_str(step_node), "stack")
    _check("kind check: changelog -> stack", prism_node.prism_node_kind_str(changelog_node), "stack")
    print("")

    // ── 7. Rejection tally: at least 8 distinct rejections proven above (12, counted here) ───
    let rejection_count = 12
    _check_true("rejection tally: 12 distinct rejections proven (item label=1, timeline empty+bad-elem=2, step timeline empty+non-string+empty-string+neg-idx+oob-idx=5, changelog ctor empty-version+empty-summary=2, changelog empty+bad-elem=2) -- >= 8 required", rejection_count >= 8)

    if FAILED[0] == 0
        print("")
        print("_kat_prism_ui_timeline: ALL PASS")
    else
        print("")
        print("_kat_prism_ui_timeline: " + str(FAILED[0]) + " FAILURE(S)")
        exit(1)
