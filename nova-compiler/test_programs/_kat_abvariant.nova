import forge_targeting

fn tf(b: bool) -> string
    if b
        return "T"
    "F"

fn main()
    let arms = ["control", "treatment"]
    // determinism: same (feature,user,arms) -> same arm, repeatedly
    let v1 = ab_variant("exp1", "user-42", arms)
    let v2 = ab_variant("exp1", "user-42", arms)
    print("deterministic=" + tf(v1 == v2))
    // in-set
    print("inset=" + tf(v1 == "control" or v1 == "treatment"))
    // empty variants -> ""
    print("empty=" + tf(ab_variant("e", "u", []) == ""))
    // distribution: both arms used across 1000 users, each arm > 100
    let ca = 0
    let cb = 0
    let i = 0
    while i < 1000
        let arm = ab_variant("exp1", "u" + str(i), arms)
        if arm == "control"
            ca = ca + 1
        else
            cb = cb + 1
        i = i + 1
    print("both_used=" + tf(ca > 100 and cb > 100) + " ca=" + str(ca) + " cb=" + str(cb))
    // three-way split
    let three = ["a", "b", "c"]
    let na = 0
    let nb = 0
    let nc = 0
    let j = 0
    while j < 900
        let a3 = ab_variant("exp3", "s" + str(j), three)
        if a3 == "a"
            na = na + 1
        if a3 == "b"
            nb = nb + 1
        if a3 == "c"
            nc = nc + 1
        j = j + 1
    print("three_all=" + tf(na > 100 and nb > 100 and nc > 100) + " " + str(na) + "/" + str(nb) + "/" + str(nc))
    // rollout_on boundary sanity (existing fn, regression)
    print("roll0=" + tf(rollout_on("f", "u", 0) == false) + " roll100=" + tf(rollout_on("f", "u", 100)))
