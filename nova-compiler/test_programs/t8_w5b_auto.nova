fn build_local() -> int
    let xs = []
    let i = 0
    while i < 100
        xs.push(i)
        i = i + 1
    let n = len(xs)
    n

fn main()
    let total = 0
    let k = 0
    while k < 50
        total = total + build_local()
        k = k + 1
    print(total)
    print("W5b auto-drop: 50 fn calls each create/drop a local 100-list; total=" + str(total))
