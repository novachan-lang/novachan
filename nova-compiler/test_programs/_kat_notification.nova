import forge_notification

fn main()
    let svc = notif_service()
    svc = notif_register_channel(svc, "email", "smtp")
    svc = notif_register_channel(svc, "sms", "twilio")
    svc = notif_register_channel(svc, "push", "fcm")

    let channels = notif_list_channels(svc)
    assert(len(channels) == 3, "3 channels")

    svc = notif_send(svc, "email", "user@test.com", "Hello", "Welcome aboard")
    svc = notif_send(svc, "sms", "+1234567890", "Alert", "Server is down")

    assert(notif_count(svc, "email") == 1, "1 email sent")
    assert(notif_count(svc, "sms") == 1, "1 sms sent")
    assert(notif_count(svc, "push") == 0, "0 push")

    let hist = notif_history(svc)
    assert(len(hist) == 2, "2 in history")
    assert(hist[0]["channel"] == "email", "first=email")
    assert(hist[1]["recipient"] == "+1234567890", "sms recipient")

    svc = notif_disable_channel(svc, "email")
    svc = notif_send(svc, "email", "user2@test.com", "Test", "Should not send")
    assert(notif_count(svc, "email") == 1, "still 1 email")

    svc = notif_enable_channel(svc, "email")
    svc = notif_send(svc, "email", "user3@test.com", "Back", "Working again")
    assert(notif_count(svc, "email") == 2, "2 emails now")

    svc = notif_add_template(svc, "welcome", "Welcome <<name>>", "Hi <<name>>, your plan is <<plan>>")
    let vars = {}
    vars["name"] = "Alice"
    vars["plan"] = "Pro"
    let rendered = notif_render(svc, "welcome", vars)
    assert(rendered["subject"] == "Welcome Alice", "rendered subject")
    assert(contains(rendered["body"], "Alice"), "body has name")
    assert(contains(rendered["body"], "Pro"), "body has plan")

    svc = notif_send_template(svc, "push", "device123", "welcome", vars)
    assert(notif_count(svc, "push") == 1, "1 push via template")

    print("NOTIFICATION KAT PASS")
