import forge_health_report

fn main()
    let h = hr_new()
    h = hr_add_check(h, "db")
    h = hr_add_check(h, "cache")
    h = hr_add_check(h, "api")

    let r1 = hr_report_healthy(h, "db")
    assert(is_ok(r1), "db healthy")
    h = unwrap(r1)
    let r2 = hr_report_healthy(h, "cache")
    assert(is_ok(r2), "cache healthy")
    h = unwrap(r2)
    let r3 = hr_report_healthy(h, "api")
    assert(is_ok(r3), "api healthy")
    h = unwrap(r3)
    assert(hr_is_all_healthy(h) == 1, "all healthy")
    assert(hr_healthy_count(h) == 3, "3 healthy")

    let u1 = hr_report_unhealthy(h, "cache", "connection refused")
    assert(is_ok(u1), "mark unhealthy")
    h = unwrap(u1)
    assert(hr_is_all_healthy(h) == 0, "not all healthy")
    assert(hr_unhealthy_count(h) == 1, "1 unhealthy")

    let s = hr_status(h, "cache")
    assert(is_ok(s), "status ok")
    assert(unwrap(s) == "unhealthy", "cache unhealthy")

    let r = hr_reason(h, "cache")
    assert(is_ok(r), "reason ok")
    assert(unwrap(r) == "connection refused", "correct reason")

    let bad = hr_report_healthy(h, "nope")
    assert(is_err(bad), "unknown check")

    print("HEALTH-REPORT KAT PASS")
