// functional: service registry + round-robin resolve
import forge_discovery

fn main()
    let d = discovery_new()
    discovery_register(d, "api", "http://a:1")
    discovery_register(d, "api", "http://b:2")
    if len(discovery_list(d, "api")) != 2
        print("FAIL list")
        exit(1)
    let r1 = discovery_resolve(d, "api")
    let r2 = discovery_resolve(d, "api")
    let r3 = discovery_resolve(d, "api")
    if r1 == r2
        print("FAIL not round-robin " + r1 + " " + r2)
        exit(1)
    if r1 != r3
        print("FAIL rr wrap " + r1 + " " + r3)
        exit(1)
    if discovery_resolve(d, "nope") != ""
        print("FAIL unknown = " + discovery_resolve(d, "nope"))
        exit(1)
    discovery_stop(d)
    print("PASS forge_discovery")
