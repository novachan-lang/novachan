// KAT for std/text/format
import std/text/format

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn main()
    // fmt_int_commas
    cks("commas_large",   fmt_int_commas(1234567),   "1,234,567")
    cks("commas_neg",     fmt_int_commas(-1000),      "-1,000")
    cks("commas_small",   fmt_int_commas(999),        "999")
    cks("commas_zero",    fmt_int_commas(0),          "0")
    cks("commas_exact3",  fmt_int_commas(1000),       "1,000")
    cks("commas_6dig",    fmt_int_commas(123456),     "123,456")

    // fmt_fixed
    cks("fixed_pi2",      fmt_fixed(3.14159, 2),      "3.14")
    cks("fixed_2_3dp",    fmt_fixed(2.0, 3),          "2.000")
    cks("fixed_0_2dp",    fmt_fixed(0.0, 2),          "0.00")
    cks("fixed_0dp",      fmt_fixed(5.7, 0),          "6")
    cks("fixed_neg",      fmt_fixed(-1.5, 1),         "-1.5")
    cks("fixed_round_up", fmt_fixed(1.745, 2),        "1.75")

    // fmt_hex
    cks("hex_255",  fmt_hex(255),  "0xff")
    cks("hex_0",    fmt_hex(0),    "0x0")
    cks("hex_16",   fmt_hex(16),   "0x10")
    cks("hex_256",  fmt_hex(256),  "0x100")

    // fmt_bin
    cks("bin_5",    fmt_bin(5),    "0b101")
    cks("bin_0",    fmt_bin(0),    "0b0")
    cks("bin_8",    fmt_bin(8),    "0b1000")

    // fmt_pad_left
    cks("pad_left_zero",  fmt_pad_left("7", 3, "0"),   "007")
    cks("pad_left_sp",    fmt_pad_left("hi", 5, " "),  "   hi")
    cks("pad_left_noop",  fmt_pad_left("hello", 3, " "), "hello")

    // fmt_pad_right
    cks("pad_right_sp",   fmt_pad_right("hi", 5, " "), "hi   ")
    cks("pad_right_star", fmt_pad_right("ok", 4, "*"), "ok**")

    print("_format_test passed")
