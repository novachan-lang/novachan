import std/coding/convolutional

// ── helpers ──────────────────────────────────────────────────────────────────

fn list_eq(a, b) -> bool
    let na = len(a)
    let nb = len(b)
    if na != nb
        return false
    let i = 0
    while i < na
        if a[i] != b[i]
            return false
        i = i + 1
    true

fn fail(label, got, want)
    let gs = ""
    let ws = ""
    let i = 0
    while i < len(got)
        gs = gs + str(got[i])
        if i + 1 < len(got)
            gs = gs + ","
        i = i + 1
    let j = 0
    while j < len(want)
        ws = ws + str(want[j])
        if j + 1 < len(want)
            ws = ws + ","
        j = j + 1
    print("FAIL convolutional " + label + ": got=[" + gs + "] want=[" + ws + "]")
    exit(1)

fn fail_int(label, got, want)
    print("FAIL convolutional " + label + ": got=" + str(got) + " want=" + str(want))
    exit(1)

// ── KAT: code parameters ─────────────────────────────────────────────────────

fn main()
    // G1 = 7
    if cv_g1() != 7
        fail_int("g1", cv_g1(), 7)
    // G2 = 5
    if cv_g2() != 5
        fail_int("g2", cv_g2(), 5)
    // Constraint length K = 3
    if cv_constraint() != 3
        fail_int("constraint", cv_constraint(), 3)
    // Rate = [1, 2]
    let rate = cv_rate()
    if rate[0] != 1
        fail_int("rate[0]", rate[0], 1)
    if rate[1] != 2
        fail_int("rate[1]", rate[1], 2)

    // ── KAT: cv_output ───────────────────────────────────────────────────────
    // state=0, inbit=1: g1=1^0^0=1, g2=1^0=1 -> [1,1]
    let want_out = []
    push(want_out, 1)
    push(want_out, 1)
    let got_out = cv_output(0, 1)
    if not list_eq(got_out, want_out)
        fail("output(0,1)", got_out, want_out)
    // state=0, inbit=0: g1=0, g2=0 -> [0,0]
    let want_00 = []
    push(want_00, 0)
    push(want_00, 0)
    let got_00 = cv_output(0, 0)
    if not list_eq(got_00, want_00)
        fail("output(0,0)", got_00, want_00)

    // ── KAT: cv_state_transition ─────────────────────────────────────────────
    // state=0, inbit=1: next_state=2 (binary 10 = s1=1,s2=0), output=[1,1]
    let tr = cv_state_transition(0, 1)
    if tr[0] != 2
        fail_int("transition(0,1).state", tr[0], 2)
    let tr_bits = tr[1]
    if not list_eq(tr_bits, want_out)
        fail("transition(0,1).bits", tr_bits, want_out)

    // ── KAT: cv_encode([1]) — classic single-bit encoding ────────────────────
    // Step 0: u=1, state=00(0): g1=1^0^0=1, g2=1^0=1 -> [1,1]; next_state=10(2)
    // Flush 1: u=0, state=10(2): s1=1,s2=0 -> g1=0^1^0=1, g2=0^0=0 -> [1,0]; next_state=01(1)
    // Flush 2: u=0, state=01(1): s1=0,s2=1 -> g1=0^0^1=1, g2=0^1=1 -> [1,1]; next_state=00(0)
    let msg1 = []
    push(msg1, 1)
    let enc1 = cv_encode(msg1)
    let want1 = []
    push(want1, 1)
    push(want1, 1)
    push(want1, 1)
    push(want1, 0)
    push(want1, 1)
    push(want1, 1)
    if not list_eq(enc1, want1)
        fail("encode([1])", enc1, want1)

    // ── KAT: cv_encode([0]) — all-zero input produces all-zero output ─────────
    let msg0 = []
    push(msg0, 0)
    let enc0 = cv_encode(msg0)
    let want_zeros = []
    push(want_zeros, 0)
    push(want_zeros, 0)
    push(want_zeros, 0)
    push(want_zeros, 0)
    push(want_zeros, 0)
    push(want_zeros, 0)
    if not list_eq(enc0, want_zeros)
        fail("encode([0])", enc0, want_zeros)

    // ── KAT: cv_encode([1,0,1,1]) — 4-bit message, 12 output bits ────────────
    // Trace (state notation: value of s1*2+s2):
    // u=1, s=00(0): g1=1^0^0=1, g2=1^0=1 -> [1,1]; ns=10(2)
    // u=0, s=10(2): s1=1,s2=0; g1=0^1^0=1, g2=0^0=0 -> [1,0]; ns=01(1)
    // u=1, s=01(1): s1=0,s2=1; g1=1^0^1=0, g2=1^1=0 -> [0,0]; ns=10(2)
    // u=1, s=10(2): s1=1,s2=0; g1=1^1^0=0, g2=1^0=1 -> [0,1]; ns=11(3)
    // flush u=0, s=11(3): s1=1,s2=1; g1=0^1^1=0, g2=0^1=1 -> [0,1]; ns=01(1)
    // flush u=0, s=01(1): s1=0,s2=1; g1=0^0^1=1, g2=0^1=1 -> [1,1]; ns=00(0)
    let msg4 = []
    push(msg4, 1)
    push(msg4, 0)
    push(msg4, 1)
    push(msg4, 1)
    let enc4 = cv_encode(msg4)
    let want4 = []
    push(want4, 1)
    push(want4, 1)
    push(want4, 1)
    push(want4, 0)
    push(want4, 0)
    push(want4, 0)
    push(want4, 0)
    push(want4, 1)
    push(want4, 0)
    push(want4, 1)
    push(want4, 1)
    push(want4, 1)
    if not list_eq(enc4, want4)
        fail("encode([1,0,1,1])", enc4, want4)

    // ── KAT: cv_encode_no_flush — no tail appended ────────────────────────────
    let enc_nf = cv_encode_no_flush(msg1)
    let want_nf = []
    push(want_nf, 1)
    push(want_nf, 1)
    if not list_eq(enc_nf, want_nf)
        fail("encode_no_flush([1])", enc_nf, want_nf)

    // ── KAT: encode([]) — empty message: only 2 flush bits -> 4 output bits ──
    let msg_empty = []
    let enc_empty = cv_encode(msg_empty)
    let want_empty = []
    push(want_empty, 0)
    push(want_empty, 0)
    push(want_empty, 0)
    push(want_empty, 0)
    if not list_eq(enc_empty, want_empty)
        fail("encode([])", enc_empty, want_empty)

    print("PASS _convolutional_test")
