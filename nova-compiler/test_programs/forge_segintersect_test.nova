import forge_segintersect

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn expect_false(name: string, cond: bool) -> int
    if cond
        print("FAIL " + name + ": expected false")
        return 1
    0

fn near(a: float, b: float) -> bool
    let d = a - b
    d > -0.001 and d < 0.001

fn main()
    let fails = 0

    // classic X crossing: (0,0)-(4,4) and (0,4)-(4,0) cross at (2,2)
    fails = fails + expect_true("cross_X", segments_intersect([0, 0], [4, 4], [0, 4], [4, 0]))
    let p = intersection_point([0, 0], [4, 4], [0, 4], [4, 0])
    fails = fails + expect_true("cross_point", p[0] != null and near(p[0], 2.0) and near(p[1], 2.0))

    // parallel horizontal -> no intersection
    fails = fails + expect_false("parallel", segments_intersect([0, 0], [4, 0], [0, 1], [4, 1]))
    fails = fails + expect_true("parallel_null", intersection_point([0, 0], [4, 0], [0, 1], [4, 1]) == null)

    // disjoint (don't reach) -> no
    fails = fails + expect_false("disjoint", segments_intersect([0, 0], [1, 1], [5, 5], [6, 6]))

    // T-junction: endpoint touches the middle of the other
    fails = fails + expect_true("touch", segments_intersect([0, 0], [4, 0], [2, 0], [2, 3]))
    let tp = intersection_point([0, 0], [4, 0], [2, 0], [2, 3])
    fails = fails + expect_true("touch_point", near(tp[0], 2.0) and near(tp[1], 0.0))

    // collinear overlap -> intersect true (point is null since it's a segment overlap)
    fails = fails + expect_true("collinear_overlap", segments_intersect([0, 0], [4, 0], [2, 0], [6, 0]))

    // collinear but disjoint -> no
    fails = fails + expect_false("collinear_disjoint", segments_intersect([0, 0], [2, 0], [4, 0], [6, 0]))

    // shared endpoint -> intersect
    fails = fails + expect_true("shared_endpoint", segments_intersect([0, 0], [2, 2], [2, 2], [4, 0]))

    // vertical + horizontal crossing at a computed point
    let vp = intersection_point([3, 0], [3, 6], [0, 4], [6, 4])
    fails = fails + expect_true("vh_point", near(vp[0], 3.0) and near(vp[1], 4.0))

    // near-miss (just past the end)
    fails = fails + expect_false("near_miss", segments_intersect([0, 0], [2, 2], [3, 0], [3, 5]))

    if fails == 0
        print("forge_segintersect: all passed")
    else
        print("forge_segintersect: " + str(fails) + " FAILED")
