import std/money/exchange

fn _cki(label: string, got: int, want: int)
    if got != want
        print("FAIL exchange " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn _ckl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL exchange " + label + ": length mismatch got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL exchange " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // KAT 1: basic rate conversion half-up: 10000 * 15/10 = 15000
    _cki("fx_convert_15_10", fx_convert(10000, 15, 10, "half_up"), 15000)

    // KAT 2: bps rate 1.5x: 10000 * 15000/10000 = 15000
    _cki("fx_convert_bps_15000", fx_convert_bps(10000, 15000), 15000)

    // KAT 3: 1/3 half-up: 10000/3 = 3333.33 -> 3333
    _cki("fx_convert_1_3", fx_convert(10000, 1, 3, "half_up"), 3333)

    // KAT 4: identity rate 1.0x: 10000 * 10000/10000 = 10000
    _cki("fx_convert_bps_identity", fx_convert_bps(10000, 10000), 10000)

    // KAT 5: apply fee of 250 bps (2.5%) on 10000 -> fee=250, result=9750
    _cki("fx_apply_fee_250bps", fx_apply_fee(10000, 250), 9750)

    // KAT 6: invert 2.0 rate -> 0.5: 10000*10000/20000 = 5000
    _cki("fx_invert_bps_20000", fx_invert_bps(20000), 5000)

    // KAT 7: fx_rate_bps(10, 15) = 15*10000/10 = 15000
    _cki("fx_rate_bps_10_15", fx_rate_bps(10, 15), 15000)

    // KAT 8: fx_spread mid=15000 spread=200 -> [bid=14900, ask=15100]
    let sp = fx_spread(15000, 200)
    let want_sp = []
    push(want_sp, 14900)
    push(want_sp, 15100)
    _ckl("fx_spread_15000_200", sp, want_sp)

    // KAT 9: fx_cross_bps: EUR->USD=12000 bps (1.2x), GBP->USD=15000 bps (1.5x)
    // EUR->GBP = 12000*10000/15000 = 8000 bps (0.8x)
    _cki("fx_cross_bps_eur_gbp", fx_cross_bps(12000, 15000), 8000)

    // KAT 10: zero denominator safety
    _cki("fx_convert_zero_den", fx_convert(10000, 1, 0, "half_up"), 0)

    // KAT 11: zero rate_bps invert safety
    _cki("fx_invert_bps_zero", fx_invert_bps(0), 0)

    // KAT 12: fx_apply_fee zero fee -> unchanged
    _cki("fx_apply_fee_zero", fx_apply_fee(10000, 0), 10000)

    // KAT 13: fx_apply_fee full 100% fee (10000 bps) -> 0
    _cki("fx_apply_fee_100pct", fx_apply_fee(10000, 10000), 0)

    // KAT 14: negative half-up: -100 * 3/2 = -150 (half away from zero, not -149)
    _cki("fx_convert_neg_150", fx_convert(-100, 3, 2, "half_up"), -150)

    // KAT 15: negative tie: -1 * 3/2 = -1.5, half-up away from zero = -2 (not -1)
    _cki("fx_convert_neg_tie", fx_convert(-1, 3, 2, "half_up"), -2)

    // KAT 16: positive unchanged: 10000 * 15/10 = 15000
    _cki("fx_convert_pos_unchanged", fx_convert(10000, 15, 10, "half_up"), 15000)

    print("PASS _exchange_test")
