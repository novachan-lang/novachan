// NOVA OPS — DevOps/infrastructure helpers (framework 9 per strategy doc).
// v0.1 ships text-based codegen for the most common deployment artifacts:
// Dockerfiles, GitHub Actions workflows, healthcheck polling.
//
// Public API (v0.1):
//   ops.dockerfile(app_name, port)        -> Dockerfile content for a NOVA project
//   ops.github_workflow(name, runs_on)    -> GitHub Actions YAML for build+test
//   ops.healthcheck(url, expected_substr, max_tries, delay_ms) -> bool
//                                            polls URL with http_get until
//                                            response contains expected text
//                                            or max_tries exceeded

fn dockerfile(app_name: string, port: int) -> string
    let d = "FROM debian:bookworm-slim\n"
    d = d + "WORKDIR /app\n"
    d = d + "COPY " + app_name + " /app/" + app_name + "\n"
    d = d + "RUN chmod +x /app/" + app_name + "\n"
    d = d + "EXPOSE " + str(port) + "\n"
    d = d + "CMD [\"/app/" + app_name + "\"]\n"
    d

fn github_workflow(name: string, runs_on: string) -> string
    let y = "name: " + name + "\n"
    y = y + "on:\n"
    y = y + "  push:\n"
    y = y + "    branches: [master, main]\n"
    y = y + "  pull_request:\n"
    y = y + "jobs:\n"
    y = y + "  build-and-test:\n"
    y = y + "    runs-on: " + runs_on + "\n"
    y = y + "    steps:\n"
    y = y + "      - uses: actions/checkout@v4\n"
    y = y + "      - name: Install NOVA\n"
    y = y + "        run: curl -fsSL https://nova-lang.dev/install.sh | sh\n"
    y = y + "      - name: Build\n"
    y = y + "        run: nova build\n"
    y = y + "      - name: Test\n"
    y = y + "        run: nova test\n"
    y

fn healthcheck(url: string, expected: string, max_tries: int, delay_ms: int) -> bool
    let i = 0
    while i < max_tries
        let r = http_get(url)
        if find(r, expected) >= 0
            return true
        sleep(delay_ms)
        i = i + 1
    false
