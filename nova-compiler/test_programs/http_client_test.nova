// Oracle for the native HTTP client (Linux/macOS sockets path; WinHTTP on Windows).
// A spawned NOVA HTTP server serves a fixed body; the NOVA http_get client fetches it
// over loopback and must return EXACTLY that body. Exercises client + server + spawn
// together. Self-contained (no external network).
fn main()
    spawn fn()
        let sock = http_listen(18080)
        let conn = http_accept_raw(sock)
        if len(conn) > 0
            let client = conn[0]
            http_send_raw(client, "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 11\r\nConnection: close\r\n\r\nhello-nova!")
    sleep(800)
    let resp = http_get("http://127.0.0.1:18080/")
    print("http client got: [{resp}]")
    assert_eq(resp, "hello-nova!")
    print("http client loopback test passed")
