// KAT test for std/numeric/simpson — composite Simpson's 1/3 rule integration.
// Adversarially-verified against exact analytic integrals.
//
// NOVA HOF float ABI note: when a named fn is passed as a parameter, its argument
// arrives as an any-widened value (boxed float). The fn body must produce the return
// value through dynamic arithmetic (x*x, x*1.0, 1.0+x*0.0, etc.) so nova_rt_mul/add
// returns a boxed float that subsequent accumulation can detect via nova_is_likely_float.
// Functions that route through NOVA's math builtins (sin, cos, etc.) return raw i64
// float bits, which lose boxing through the any ABI and corrupt accumulation.
import std/numeric/simpson

// Integrand: f(x) = x^2  =>  int(0..3) = 9.0, int(0..1) = 1/3 ≈ 0.33333
fn fsq(x) -> float
    let v = x * x
    return v

// Integrand: f(x) = 1    =>  int(0..5) = 5.0
// Uses 1.0 + x*0.0 so the result flows through nova_rt_add (boxed float output).
fn fone(x) -> float
    let v = 1.0 + x * 0.0
    return v

// Integrand: f(x) = x    =>  int(0..4) = 8.0, int(1..3) = 4.0
fn fx(x) -> float
    let v = x * 1.0
    return v

// Float-close check: abs(got-want) <= eps, else FAIL+exit.
fn ckf(label: string, got: float, want: float, eps: float)
    let d = got - want
    if d < 0.0
        d = 0.0 - d
    if d > eps
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("ok " + label)

fn main()
    // KAT 1: int(x^2, 0, 3, n=100) == 9.0  [exact for Simpson's on polynomial]
    let r1 = sp_integrate(fsq, 0.0, 3.0, 100)
    ckf("fsq 0..3 n=100", r1, 9.0, 0.01)

    // KAT 2: int(1, 0, 5, n=10) == 5.0  [constant fn, exact for any method]
    let r2 = sp_integrate(fone, 0.0, 5.0, 10)
    ckf("fone 0..5 n=10", r2, 5.0, 0.01)

    // KAT 3: int(x, 0, 4, n=10) == 8.0  [linear fn, exact for any method]
    let r3 = sp_integrate(fx, 0.0, 4.0, 10)
    ckf("fx 0..4 n=10", r3, 8.0, 0.01)

    // KAT 4: int(x^2, 0, 1, n=100) == 1/3 ≈ 0.33333  [exact for Simpson's 1/3]
    let r4 = sp_integrate(fsq, 0.0, 1.0, 100)
    ckf("fsq 0..1 n=100", r4, 0.33333, 0.01)

    // KAT 5: int(x, 1, 3, n=10) == 4.0  [linear on offset interval, exact]
    let r5 = sp_integrate(fx, 1.0, 3.0, 10)
    ckf("fx 1..3 n=10", r5, 4.0, 0.01)

    // KAT 6: odd n=99 is silently bumped to 100 — result should still be 9.0
    let r6 = sp_integrate(fsq, 0.0, 3.0, 99)
    ckf("fsq 0..3 n=99->100 odd-bump", r6, 9.0, 0.01)

    print("_simpson_test passed")
