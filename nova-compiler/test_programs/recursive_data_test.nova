type Node
    kind: string
    value: int
    children: list

fn make_num(n: int) -> Node
    Node("num", n, [])

fn make_add(l: Node, r: Node) -> Node
    Node("add", 0, [l, r])

fn make_mul(l: Node, r: Node) -> Node
    Node("mul", 0, [l, r])

fn eval(e: Node) -> int
    match e
        Node(kind, value, children) =>
            if kind == "num"
                value
            else if kind == "add"
                eval(children[0]) + eval(children[1])
            else
                eval(children[0]) * eval(children[1])

let expr = make_add(make_mul(make_num(3), make_num(4)), make_num(5))
let result = eval(expr)
assert(result == 17, "3*4+5 == 17")

let expr2 = make_mul(make_add(make_num(2), make_num(3)), make_num(4))
assert(eval(expr2) == 20, "(2+3)*4 == 20")

print("Recursive data test passed: " + str(result))
