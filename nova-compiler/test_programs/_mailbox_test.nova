// Erlang frontier Stage-0: per-process mailbox (self_pid / send_msg / recv_msg / mailbox_of).
// Messaging PID = a task's MAILBOX channel handle (a tagged NOVA value -> find_tag-safe AND
// deep_copy-shared, so it is safe to embed in a message). spawn returns a task handle (for
// monitor); mailbox_of(task) bridges it to the task's mailbox PID. recv_msg() blocks (green park).

fn pong()
    let m = recv_msg()          // block until main's message arrives
    let from = m[0]             // sender's mailbox PID (a shared channel handle)
    let n = m[1]
    send_msg(from, n + 1)        // reply to the sender

fn fanin_worker(boss, id)
    send_msg(boss, id)          // every worker posts its id to the boss's mailbox

fn main()
    let me = self_pid()         // main's own mailbox PID (for replies)

    // ---- ping-pong: payload is a list [pid, int]; the pid is a shared mailbox handle ----
    let p = spawn pong()
    send_msg(mailbox_of(p), [me, 41])
    let reply = recv_msg()
    assert(reply == 42, "ping-pong reply should be 42")

    // ---- fan-in: 100 workers each send their id to main's single mailbox ----
    let n = 100
    let i = 0
    while i < n
        spawn fanin_worker(me, i)
        i = i + 1
    let sum = 0
    let got = 0
    while got < n
        let v = recv_msg()
        sum = sum + v
        got = got + 1
    assert(sum == 4950, "fan-in sum of 0..99 should be 4950")

    // ---- float payload roundtrip (exercises the message float-box path) ----
    send_msg(me, 2.5)
    let f = recv_msg()
    assert(f == 2.5, "float message should round-trip as 2.5")

    // ---- introspection (mailbox_len) + non-blocking receive (try_recv_msg) ----
    send_msg(me, 7)
    send_msg(me, 8)
    assert(mailbox_len(me) == 2, "mailbox_len should be 2")
    let t1 = try_recv_msg()
    assert(t1[0] == 1, "try_recv_msg got=1")
    assert(t1[1] == 7, "try_recv_msg value=7 (FIFO)")
    let t2 = try_recv_msg()
    assert(t2[1] == 8, "try_recv_msg value=8")
    let t3 = try_recv_msg()
    assert(t3[0] == 0, "try_recv_msg empty -> got=0")
    assert(mailbox_len(me) == 0, "mailbox_len back to 0")

    print("MAILBOX_OK")
