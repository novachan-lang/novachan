// KAT test for std/text/hamming
import std/text/hamming

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got [" + got + "] expected [" + expected + "]")
        exit(1)

fn main()
    // ham_distance — published KAT vectors
    cki("dist_karolin_kathrin", ham_distance("karolin", "kathrin"), 3)
    cki("dist_1011101_1001001", ham_distance("1011101", "1001001"), 2)
    cki("dist_abc_abc",         ham_distance("abc", "abc"), 0)
    cki("dist_ab_abc_unequal",  ham_distance("ab", "abc"), -1)

    // ham_distance — extra KAT: all same, all different, single char
    cki("dist_all_diff",  ham_distance("abcd", "wxyz"), 4)
    cki("dist_one_char",  ham_distance("a", "b"), 1)
    cki("dist_empty",     ham_distance("", ""), 0)

    // ham_distance_bits — published KAT vectors
    // 9 = 0b1001, 14 = 0b1110 -> XOR = 0b0111 = 7 -> popcount = 3
    cki("bits_9_14",   ham_distance_bits(9, 14), 3)
    cki("bits_0_0",    ham_distance_bits(0, 0), 0)
    // 255 = 0b11111111, 0 = 0 -> XOR = 0b11111111 -> popcount = 8
    cki("bits_255_0",  ham_distance_bits(255, 0), 8)

    // ham_distance_bits — extra KAT
    // 1 = 0b01, 2 = 0b10 -> XOR = 0b11 -> popcount = 2
    cki("bits_1_2",    ham_distance_bits(1, 2), 2)
    // same value -> XOR = 0 -> popcount = 0
    cki("bits_same",   ham_distance_bits(42, 42), 0)
    // 0xF = 15, 0 -> popcount = 4
    cki("bits_15_0",   ham_distance_bits(15, 0), 4)

    // ham_similar — published KAT vector
    cki("similar_abc_abd_1", ham_similar("abc", "abd", 1), 1)

    // ham_similar — extra KAT
    cki("similar_exact",          ham_similar("hello", "hello", 0), 1)
    cki("similar_too_far",        ham_similar("abc", "xyz", 2), 0)
    cki("similar_unequal_len",    ham_similar("ab", "abc", 10), 0)
    cki("similar_at_threshold",   ham_similar("abcd", "abce", 1), 1)
    cki("similar_one_over",       ham_similar("abcd", "wxcd", 1), 0)

    print("_hamming_test passed")
