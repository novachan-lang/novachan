// KAT: std/data/yaml same-indent block-sequence handling (YAML 1.2 sec 8.2.1).
import std/data/yaml

fn assert_eq_str(label: string, got: string, want: string)
    if got == want
        print("PASS " + label)
    else
        print("FAIL " + label + " got=[" + got + "] want=[" + want + "]")

fn main() -> int
    // Test 1: indented block sequence (the ordinary case -- must keep working).
    let d1 = yaml_parse("tags:\n  - a\n  - b\n")
    let t1 = d1["tags"]
    assert_eq_str("indented-seq-len", str(len(t1)), "2")
    assert_eq_str("indented-seq-0", t1[0], "a")
    assert_eq_str("indented-seq-1", t1[1], "b")

    // Test 2: same-indent block sequence (the '-' at the SAME column as the
    // parent mapping key -- k8s/docker-compose/GitHub-Actions/Ansible style).
    let d2 = yaml_parse("tags:\n- a\n- b\n")
    let t2 = d2["tags"]
    assert_eq_str("sameindent-seq-len", str(len(t2)), "2")
    assert_eq_str("sameindent-seq-0", t2[0], "a")
    assert_eq_str("sameindent-seq-1", t2[1], "b")

    // Test 3: same-indent SEQUENCE OF MAPS (each list item is a mapping with
    // multiple scalar fields).
    let d3 = yaml_parse("servers:\n- host: a\n  port: 1\n- host: b\n  port: 2\n")
    let s3 = d3["servers"]
    assert_eq_str("sameindent-seqmap-len", str(len(s3)), "2")
    let m0 = s3[0]
    let m1 = s3[1]
    assert_eq_str("sameindent-seqmap-0-host", m0["host"], "a")
    assert_eq_str("sameindent-seqmap-0-port", str(m0["port"]), "1")
    assert_eq_str("sameindent-seqmap-1-host", m1["host"], "b")
    assert_eq_str("sameindent-seqmap-1-port", str(m1["port"]), "2")

    // Test 4 (edge case -- the SECOND structurally-identical path): a
    // sequence-item's OWN sibling key has a same-indent nested sequence
    // value (not the whole document's top-level key -- a key that is a
    // SIBLING inside a `- key: val` mapping item).
    let d4 = yaml_parse("items:\n- name: box\n  tags:\n  - x\n  - y\n- name: crate\n  tags:\n  - z\n")
    let items4 = d4["items"]
    assert_eq_str("nested-seqmap-len", str(len(items4)), "2")
    let it0 = items4[0]
    let it1 = items4[1]
    assert_eq_str("nested-item0-name", it0["name"], "box")
    let tags0 = it0["tags"]
    assert_eq_str("nested-item0-tags-len", str(len(tags0)), "2")
    assert_eq_str("nested-item0-tags-0", tags0[0], "x")
    assert_eq_str("nested-item0-tags-1", tags0[1], "y")
    assert_eq_str("nested-item1-name", it1["name"], "crate")
    let tags1 = it1["tags"]
    assert_eq_str("nested-item1-tags-len", str(len(tags1)), "1")
    assert_eq_str("nested-item1-tags-0", tags1[0], "z")

    // Test 5 (extra edge case -- inline FIRST key with a dangling empty
    // value followed by ordinary sibling keys must not swallow them).
    let d5 = yaml_parse("items:\n- meta:\n  age: 5\n")
    let items5 = d5["items"]
    let it5 = items5[0]
    assert_eq_str("dangling-firstkey-age", str(it5["age"]), "5")

    print("DONE")
    0
