// KAT for std/physics/heat_transfer.
import std/physics/heat_transfer

fn approx(a, b)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < 0.001

fn ckf(label, got, want)
    if not approx(got, want)
        print("FAIL heat_transfer " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // conduction(1,2,10,0.5) = 1*2*10/0.5 = 40.0
    ckf("conduction(1,2,10,0.5)", conduction(1.0, 2.0, 10.0, 0.5), 40.0)
    // conduction(2,3,5,1) = 2*3*5/1 = 30.0
    ckf("conduction(2,3,5,1)", conduction(2.0, 3.0, 5.0, 1.0), 30.0)
    // conduction(0.5,4,20,2) = 0.5*4*20/2 = 20.0
    ckf("conduction(0.5,4,20,2)", conduction(0.5, 4.0, 20.0, 2.0), 20.0)

    // radiation_power: P = e*5.67e-8*A*T^4
    // radiation_power(1,1,100) = 1*5.67e-8*1*100^4 = 5.67e-8*1e8 = 5.67
    ckf("radiation_power(1,1,100)", radiation_power(1.0, 1.0, 100.0), 5.67)
    // radiation_power(0.5,2,100) = 0.5*5.67e-8*2*1e8 = 5.67
    ckf("radiation_power(0.5,2,100)", radiation_power(0.5, 2.0, 100.0), 5.67)

    // newton_cooling_rate(5,2,10) = 5*2*10 = 100.0
    ckf("newton_cooling_rate(5,2,10)", newton_cooling_rate(5.0, 2.0, 10.0), 100.0)
    // newton_cooling_rate(3,4,5) = 60.0
    ckf("newton_cooling_rate(3,4,5)", newton_cooling_rate(3.0, 4.0, 5.0), 60.0)
    // newton_cooling_rate(10,1,20) = 200.0
    ckf("newton_cooling_rate(10,1,20)", newton_cooling_rate(10.0, 1.0, 20.0), 200.0)

    // thermal_resistance(1,2,1) = 1/(2*1) = 0.5
    ckf("thermal_resistance(1,2,1)", thermal_resistance(1.0, 2.0, 1.0), 0.5)
    // thermal_resistance(2,4,2) = 2/(4*2) = 0.25
    ckf("thermal_resistance(2,4,2)", thermal_resistance(2.0, 4.0, 2.0), 0.25)
    // thermal_resistance(3,1,3) = 3/(1*3) = 1.0
    ckf("thermal_resistance(3,1,3)", thermal_resistance(3.0, 1.0, 3.0), 1.0)

    print("PASS _heat_transfer_test")
