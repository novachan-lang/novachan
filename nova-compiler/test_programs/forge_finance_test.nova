import forge_finance

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn nearp(name: string, a: float, b: float, tol: float) -> int
    let d = a - b
    if d > -tol and d < tol
        return 0
    print("FAIL " + name + ": got=" + str(a) + " want~=" + str(b))
    1

fn main()
    let fails = 0

    // future value: 1000 at 5%/period for 10 -> 1628.894...
    fails = fails + nearp("fv", future_value(1000.0, 0.05, 10.0), 1628.8946, 0.01)
    // present value inverse
    fails = fails + nearp("pv", present_value(1628.8946, 0.05, 10.0), 1000.0, 0.01)
    // compound interest earned = FV - P
    fails = fails + nearp("ci", compound_interest(1000.0, 0.05, 10.0), 628.8946, 0.01)

    // 30-yr mortgage: 200000 at 0.5%/mo for 360 -> ~1199.10/mo
    fails = fails + nearp("loan", loan_payment(200000.0, 0.005, 360.0), 1199.10, 0.02)
    // zero-rate loan: 1200 over 12 -> 100 each
    fails = fails + nearp("loan_zero", loan_payment(1200.0, 0.0, 12.0), 100.0, 0.001)

    // amortization: sum of principal_paid ~ original principal; final balance ~ 0
    let sched = amortization_schedule(1000.0, 0.01, 12)
    fails = fails + expect_true("sched_len", len(sched) == 12)
    let last = sched[11]
    fails = fails + nearp("sched_final_balance", last[3], 0.0, 0.01)
    // sum of principal paid == 1000
    let sumP = 0.0
    let i = 0
    while i < len(sched)
        sumP = sumP + sched[i][1]
        i = i + 1
    fails = fails + nearp("sched_principal_sum", sumP, 1000.0, 0.01)
    // interest decreases over time (first > last)
    fails = fails + expect_true("interest_decreasing", sched[0][2] > sched[11][2])

    // NPV: rate 10%, [-1000, 500, 500, 500] -> ~243.43
    fails = fails + nearp("npv", npv(0.10, [-1000.0, 500.0, 500.0, 500.0]), 243.43, 0.01)
    // NPV at rate 0 = simple sum
    fails = fails + nearp("npv_zero", npv(0.0, [-1000.0, 500.0, 500.0, 500.0]), 500.0, 0.001)

    // IRR of [-1000, 500, 500, 500] ~ 0.2337
    let r = irr([-1000.0, 500.0, 500.0, 500.0])
    fails = fails + nearp("irr", r, 0.2337, 0.001)
    // sanity: NPV at the IRR is ~0
    fails = fails + nearp("irr_npv_zero", npv(r, [-1000.0, 500.0, 500.0, 500.0]), 0.0, 0.01)

    if fails == 0
        print("forge_finance: all passed")
    else
        print("forge_finance: " + str(fails) + " FAILED")
