import forge_coloring

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn main()
    let fails = 0

    // triangle (K3): every pair adjacent -> needs 3 colors
    let tri = [["a", "b"], ["b", "c"], ["c", "a"]]
    fails = fails + expect("triangle_colors", str(color_count(tri)), "3")
    fails = fails + expect_true("triangle_proper", is_proper_coloring(tri, greedy_coloring(tri)))

    // even cycle (bipartite) -> 2 colors
    let even = [["a", "b"], ["b", "c"], ["c", "d"], ["d", "a"]]
    fails = fails + expect("even_colors", str(color_count(even)), "2")
    fails = fails + expect_true("even_proper", is_proper_coloring(even, greedy_coloring(even)))

    // path -> 2 colors
    let path = [["a", "b"], ["b", "c"], ["c", "d"]]
    fails = fails + expect("path_colors", str(color_count(path)), "2")

    // complete K4: all pairs adjacent -> 4 colors
    let k4 = [["a", "b"], ["a", "c"], ["a", "d"], ["b", "c"], ["b", "d"], ["c", "d"]]
    fails = fails + expect("k4_colors", str(color_count(k4)), "4")
    fails = fails + expect_true("k4_proper", is_proper_coloring(k4, greedy_coloring(k4)))

    // star: hub + leaves -> 2 colors
    let star = [["h", "a"], ["h", "b"], ["h", "c"]]
    fails = fails + expect("star_colors", str(color_count(star)), "2")

    // single edge -> 2 colors
    fails = fails + expect("edge_colors", str(color_count([["x", "y"]])), "2")

    // the coloring is always proper for any graph
    let complex = [["1", "2"], ["2", "3"], ["3", "1"], ["3", "4"], ["4", "5"], ["5", "3"]]
    fails = fails + expect_true("complex_proper", is_proper_coloring(complex, greedy_coloring(complex)))

    // a bad coloring is caught
    let badcolor = {}
    badcolor["a"] = 0
    badcolor["b"] = 0
    fails = fails + expect_true("catches_bad", is_proper_coloring([["a", "b"]], badcolor) == false)

    if fails == 0
        print("forge_coloring: all passed")
    else
        print("forge_coloring: " + str(fails) + " FAILED")
