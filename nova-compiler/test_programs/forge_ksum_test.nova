import forge_ksum

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn pairs_str(pp) -> string
    let parts = []
    let i = 0
    while i < len(pp)
        push(parts, str(pp[i][0]) + "+" + str(pp[i][1]))
        i = i + 1
    join(parts, ",")

fn triples_str(tt) -> string
    let parts = []
    let i = 0
    while i < len(tt)
        push(parts, str(tt[i][0]) + "," + str(tt[i][1]) + "," + str(tt[i][2]))
        i = i + 1
    join(parts, "|")

fn main()
    let fails = 0

    // two_sum indices
    let r = two_sum([2, 7, 11, 15], 9)
    fails = fails + expect("twosum_9", str(r[0]) + "," + str(r[1]), "0,1")
    let r2 = two_sum([3, 2, 4], 6)
    fails = fails + expect("twosum_6", str(r2[0]) + "," + str(r2[1]), "1,2")
    let r3 = two_sum([1, 2, 3], 100)
    fails = fails + expect("twosum_none", str(r3[0]), "-1")

    // has_pair_sum
    fails = fails + expect_true("has_yes", has_pair_sum([1, 5, 3, 8], 11))
    fails = fails + expect_true("has_no", has_pair_sum([1, 5, 3, 8], 20) == false)

    // two_sum_all distinct value pairs
    fails = fails + expect("all_pairs", pairs_str(two_sum_all([1, 2, 3, 4, 5], 6)), "2+4,1+5")

    // three_sum classic LeetCode: [-1,0,1,2,-1,-4] target 0 -> [-1,-1,2],[-1,0,1]
    let ts = three_sum([0 - 1, 0, 1, 2, 0 - 1, 0 - 4], 0)
    fails = fails + expect("threesum_0", triples_str(ts), "-1,-1,2|-1,0,1")

    // three_sum with a positive target
    let ts2 = three_sum([1, 2, 3, 4, 5], 9)
    fails = fails + expect("threesum_9", triples_str(ts2), "1,3,5|2,3,4")

    // no triple
    fails = fails + expect("threesum_none", str(len(three_sum([1, 1, 1], 100))), "0")

    // duplicates dedup: [0,0,0,0] target 0 -> single triple [0,0,0]
    fails = fails + expect("threesum_dedup", triples_str(three_sum([0, 0, 0, 0], 0)), "0,0,0")

    if fails == 0
        print("forge_ksum: all passed")
    else
        print("forge_ksum: " + str(fails) + " FAILED")
