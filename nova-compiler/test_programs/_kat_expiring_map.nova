import forge_expiring_map

fn main()
    let m = em_new()
    m = em_put(m, "token", "abc123", 300, 1000)
    m = em_put(m, "session", "xyz", 60, 1000)
    assert(em_count(m) == 2, "2 entries")

    let r1 = em_get(m, "token", 1100)
    assert(is_ok(r1), "token valid")
    assert(unwrap(r1) == "abc123", "correct value")

    assert(em_has(m, "token", 1100) == 1, "has token")

    let r2 = em_get(m, "session", 1100)
    assert(is_err(r2), "session expired")
    assert(em_has(m, "session", 1100) == 0, "no session")
    assert(em_expired_count(m) == 1, "1 expired")

    let r3 = em_get(m, "nope", 1000)
    assert(is_err(r3), "not found")

    let d = em_delete(m, "token")
    assert(is_ok(d), "delete ok")
    m = unwrap(d)
    assert(em_count(m) == 1, "1 after delete")

    print("EXPIRING-MAP KAT PASS")
