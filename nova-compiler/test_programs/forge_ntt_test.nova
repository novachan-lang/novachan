import forge_ntt

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn joinl(xs: list) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + ","
        out = out + str(xs[i])
        i = i + 1
    out

// naive O(n^2) convolution reference
fn naive_mul(a: list, b: list) -> list
    let out = []
    let rsize = len(a) + len(b) - 1
    let z = 0
    while z < rsize
        push(out, 0)
        z = z + 1
    let i = 0
    while i < len(a)
        let j = 0
        while j < len(b)
            out[i + j] = out[i + j] + a[i] * b[j]
            j = j + 1
        i = i + 1
    out

fn main()
    let fails = 0

    // (1+2x+3x^2)(4+5x+6x^2) = 4 +13x +28x^2 +27x^3 +18x^4
    fails = fails + expect("mul1", joinl(ntt_multiply([1, 2, 3], [4, 5, 6])), "4,13,28,27,18")
    // (1+x)^2 = 1 + 2x + x^2
    fails = fails + expect("square", joinl(ntt_multiply([1, 1], [1, 1])), "1,2,1")
    // (1+x)(1+x)(1+x) via two mults = 1,3,3,1
    fails = fails + expect("cube", joinl(ntt_multiply(ntt_multiply([1, 1], [1, 1]), [1, 1])), "1,3,3,1")
    // multiply by 1
    fails = fails + expect("by_one", joinl(ntt_multiply([1, 2, 3, 4], [1])), "1,2,3,4")
    // single terms
    fails = fails + expect("scalar", joinl(ntt_multiply([5], [7])), "35")
    // shift by x^2: [0,0,1] * [1,2,3] = [0,0,1,2,3]
    fails = fails + expect("shift", joinl(ntt_multiply([0, 0, 1], [1, 2, 3])), "0,0,1,2,3")

    // cross-check against naive convolution on a larger pair (values small so no mod wrap)
    let a = [3, 1, 4, 1, 5, 9, 2, 6]
    let b = [2, 7, 1, 8, 2, 8]
    fails = fails + expect("crosscheck", joinl(ntt_multiply(a, b)), joinl(naive_mul(a, b)))

    // another cross-check, different lengths
    let c = [10, 20, 30]
    let d = [1, 0, 0, 5, 2]
    fails = fails + expect("crosscheck2", joinl(ntt_multiply(c, d)), joinl(naive_mul(c, d)))

    if fails == 0
        print("forge_ntt: all passed")
    else
        print("forge_ntt: " + str(fails) + " FAILED")
