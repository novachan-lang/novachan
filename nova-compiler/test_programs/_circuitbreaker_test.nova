// KAT test for std/util/circuitbreaker
//
// Hand-computed expected values:
//   c = cbk_new(3, 100)  => state="closed", failures=0
//   cbk_record_failure(c,0) => failures=1
//   cbk_record_failure(c,0) => failures=2  still "closed"
//   cbk_record_failure(c,0) => failures=3 >= 3 => state="open", opened_at=0
//   cbk_allow(c,50)  => 50 < 0+100=100 => false, state stays "open"
//   cbk_allow(c,100) => 100 >= 100 => state="half_open", return true
//   cbk_record_success(c) => state="closed", failures=0

import std/util/circuitbreaker

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + got + " want " + want)
        exit(1)

fn ckb(label, got, want)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got " + gs + " want " + ws)
        exit(1)

fn main()
    // ── KAT 1: initial state ─────────────────────────────────────────────────
    let c = cbk_new(3, 100)
    cks("KAT1_initial_state", cbk_state(c), "closed")

    // ── KAT 2: two failures leave state "closed" ─────────────────────────────
    cbk_record_failure(c, 0)
    cbk_record_failure(c, 0)
    cks("KAT2_two_failures_still_closed", cbk_state(c), "closed")
    cki("KAT2_failure_count", c["failures"], 2)

    // ── KAT 3: third failure trips to "open" ─────────────────────────────────
    cbk_record_failure(c, 0)
    cks("KAT3_third_failure_opens", cbk_state(c), "open")

    // ── KAT 4: cbk_allow returns false before cooldown ───────────────────────
    let a4 = cbk_allow(c, 50)
    ckb("KAT4_allow_false_before_cooldown", a4, false)
    cks("KAT4_still_open", cbk_state(c), "open")

    // ── KAT 5: cbk_allow at cooldown boundary -> half_open, returns true ─────
    let a5 = cbk_allow(c, 100)
    ckb("KAT5_allow_true_at_cooldown", a5, true)
    cks("KAT5_state_half_open", cbk_state(c), "half_open")

    // ── KAT 6: success in half_open resets to closed ──────────────────────────
    cbk_record_success(c)
    cks("KAT6_success_resets_closed", cbk_state(c), "closed")
    cki("KAT6_failures_reset_zero", c["failures"], 0)

    // ── KAT 7: allow is always true when closed ───────────────────────────────
    let c2 = cbk_new(2, 60)
    let a7 = cbk_allow(c2, 0)
    ckb("KAT7_allow_closed", a7, true)

    // ── KAT 8: failure in half_open re-trips to open ──────────────────────────
    let c3 = cbk_new(1, 50)
    cbk_record_failure(c3, 10)
    cks("KAT8a_single_threshold_opens", cbk_state(c3), "open")
    // advance time past cooldown -> half_open
    let a8 = cbk_allow(c3, 60)
    ckb("KAT8a_probe_allowed", a8, true)
    cks("KAT8a_now_half_open", cbk_state(c3), "half_open")
    cbk_record_failure(c3, 60)
    cks("KAT8a_failure_in_half_open_reopens", cbk_state(c3), "open")

    // ── KAT 9: allow still false just before cooldown boundary ───────────────
    let c4 = cbk_new(2, 100)
    cbk_record_failure(c4, 0)
    cbk_record_failure(c4, 0)
    let a9 = cbk_allow(c4, 99)
    ckb("KAT9_just_before_cooldown_false", a9, false)
    cks("KAT9_still_open", cbk_state(c4), "open")

    // ── KAT 10: success in closed resets failure counter ─────────────────────
    let c5 = cbk_new(5, 100)
    cbk_record_failure(c5, 0)
    cbk_record_failure(c5, 0)
    cki("KAT10_failures_before_success", c5["failures"], 2)
    cbk_record_success(c5)
    cki("KAT10_failures_after_success", c5["failures"], 0)
    cks("KAT10_state_still_closed", cbk_state(c5), "closed")

    print("_circuitbreaker_test passed")
