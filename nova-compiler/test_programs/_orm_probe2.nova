import forge_orm

type Widget
    name: string
    qty: int

type Order
    id: int
    total: float

fn main()
    let sr = orm_open("sqlite://_orm_probe2.db")
    match sr
        Ok(db) =>
            // ---------- no-id Widget: does remove(id=missing->0) really delete? ----------
            _ = orm_exec(db, "DROP TABLE IF EXISTS Widget", [])
            _ = orm_ensure(db, Widget("", 0))
            _ = orm_save(db, Widget("bolt", 5))
            _ = orm_save(db, Widget("nut", 9))
            print("Widget rows before remove:")
            let wb = orm_all(db, "SELECT name, qty FROM Widget ORDER BY name", [])
            let i = 0
            while i < len(wb)
                print("  " + str(wb[i]["name"]) + "=" + str(wb[i]["qty"]))
                i = i + 1
            let rr = orm_remove(db, Widget("bolt", 5))
            print("remove result is_ok=" + str(is_ok(rr)) + " val=" + str(unwrap(rr)))
            let wc = orm_count(db, "Widget", "", [])
            print("Widget count AFTER remove = " + str(wc) + "  (expected 1 if a row was deleted)")

            // ---------- keyword table name Order: did the table get created? ----------
            _ = orm_exec(db, "DROP TABLE IF EXISTS Order", [])
            let er = orm_ensure(db, Order(0, 0.0))
            print("ensure(Order) is_ok=" + str(is_ok(er)) + " val=" + str(unwrap(er)))
            // ask sqlite_master directly whether an 'Order' table exists
            let mrows = orm_all(db, "SELECT name FROM sqlite_master WHERE type='table' AND name='Order'", [])
            print("sqlite_master has table 'Order'? rows=" + str(len(mrows)))
            let svr = orm_save(db, Order(0, 12.5))
            print("save(Order) is_ok=" + str(is_ok(svr)) + " val=" + str(unwrap(svr)))
            let ocount = orm_count(db, "Order", "", [])
            print("Order count = " + str(ocount) + "  (rows actually persisted)")
            orm_close(db)
            print("PROBE2 DONE")
        Err(e) =>
            print("open fail: " + e)
