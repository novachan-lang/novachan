// KAT for prism/ui/prism_ui_tooltip.nova: tooltip/popover component.
//
// Proves: constructor + accessors (all 4 valid positions, invalid position rejected, empty
// text rejected); prism_tt_wrap happy path (exact layer(d=2,c=3) over content+tooltip-label,
// tt_pos/tt_text attrs round-trip) for each of the 4 positions; prism_tt_popover happy path
// (exact layer(d=3,c=5): trigger + stack(heading, body)), empty title rejected;
// prism_tt_help convenience (glyph wrapped with a "top" tooltip carrying the given text,
// exact layer(d=2,c=3)).
//
// Non-PrismNode content/trigger/body is NOT tested here as a runtime rejection: those
// parameters are typed `PrismNode`, so passing a non-PrismNode value is a COMPILE error
// (E1002), not a constructible runtime case -- see prism_ui_tooltip.nova's own header note.
//
// RUN (from nova-compiler/test_programs/, prism/**/*.nova synced into $NOVA_HOME/lib):
//   ./gen3_test.exe _kat_prism_ui_tooltip.nova
//   clang -O2 -o _kat_prism_ui_tooltip.exe _kat_prism_ui_tooltip.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_ui_tooltip.exe

import prism_ui_tooltip
import prism_node
import prism_content

fn _t(name: string, cond: bool) -> bool
    if cond
        print("PASS " + name)
    else
        print("FAIL " + name)
    cond

fn main()
    print("== KAT prism_ui_tooltip ==")
    let mut passed = 0
    let mut failed = 0

    // ── 1. Constructor + accessors ──────────────────────────────────────────────────────────
    let tip_r = prism_ui_tooltip.prism_tt_tooltip("Click for more info", "top")
    if is_err(tip_r)
        print("FAIL prism_tt_tooltip (valid): " + unwrap_err(tip_r))
        failed += 1
    else
        let tip = unwrap(tip_r)
        if _t("prism_tt_tooltip: tt_text accessor", prism_ui_tooltip.prism_tt_text(tip) == "Click for more info")
            passed += 1
        else
            failed += 1
        if _t("prism_tt_tooltip: tt_position accessor", prism_ui_tooltip.prism_tt_position(tip) == "top")
            passed += 1
        else
            failed += 1

    let positions = ["top", "bottom", "left", "right"]
    for p in positions
        let pr = prism_ui_tooltip.prism_tt_tooltip("msg", p)
        if _t("prism_tt_tooltip: position '" + p + "' accepted", is_ok(pr))
            passed += 1
        else
            failed += 1
            print("  -> " + unwrap_err(pr))

    let bad_pos_r = prism_ui_tooltip.prism_tt_tooltip("msg", "diagonal")
    if _t("prism_tt_tooltip: invalid position rejected", is_err(bad_pos_r))
        passed += 1
        print("  -> " + unwrap_err(bad_pos_r))
    else
        failed += 1

    let empty_text_r = prism_ui_tooltip.prism_tt_tooltip("", "top")
    if _t("prism_tt_tooltip: empty text rejected", is_err(empty_text_r))
        passed += 1
        print("  -> " + unwrap_err(empty_text_r))
    else
        failed += 1

    // ── 2. prism_tt_wrap: happy path, exact layer(d=2,c=2), attrs round-trip ────────────────
    let content = unwrap(prism_content.prism_label("Hover me"))
    let wrap_tip = unwrap(prism_ui_tooltip.prism_tt_tooltip("Extra detail", "bottom"))
    let wrap_r = prism_ui_tooltip.prism_tt_wrap(content, wrap_tip)
    if is_err(wrap_r)
        print("FAIL prism_tt_wrap (happy path): " + unwrap_err(wrap_r))
        failed += 1
    else
        let wrapped = unwrap(wrap_r)
        if _t("prism_tt_wrap: kind == layer", prism_node.prism_node_kind_str(wrapped) == "layer")
            passed += 1
        else
            failed += 1
        if _t("prism_tt_wrap: depth == 2", prism_node.prism_node_depth(wrapped) == 2)
            passed += 1
        else
            failed += 1
        if _t("prism_tt_wrap: count == 3", prism_node.prism_node_count(wrapped) == 3)
            passed += 1
        else
            failed += 1
        if _t("prism_tt_wrap: child_count == 2", prism_node.prism_node_child_count(wrapped) == 2)
            passed += 1
        else
            failed += 1
        let wrap_kids = prism_node.prism_node_children(wrapped)
        if _t("prism_tt_wrap: content preserved as first child", prism_node.prism_node_attr_str(wrap_kids[0], "text", "") == "Hover me")
            passed += 1
        else
            failed += 1
        let tip_node = wrap_kids[1]
        if _t("prism_tt_wrap: tooltip node kind == label", prism_node.prism_node_kind_str(tip_node) == "label")
            passed += 1
        else
            failed += 1
        if _t("prism_tt_wrap: tt_text attr round-trips", prism_node.prism_node_attr_str(tip_node, "tt_text", "") == "Extra detail")
            passed += 1
        else
            failed += 1
        if _t("prism_tt_wrap: tt_pos attr round-trips", prism_node.prism_node_attr_str(tip_node, "tt_pos", "") == "bottom")
            passed += 1
        else
            failed += 1

    // ── 2b. prism_tt_wrap: each of the 4 positions round-trips through tt_pos ──────────────
    for p in positions
        let anchor = unwrap(prism_content.prism_label("Anchor"))
        let t = unwrap(prism_ui_tooltip.prism_tt_tooltip("tip for " + p, p))
        let wr = prism_ui_tooltip.prism_tt_wrap(anchor, t)
        if is_err(wr)
            print("FAIL prism_tt_wrap (position '" + p + "'): " + unwrap_err(wr))
            failed += 1
        else
            let node = unwrap(wr)
            let kids = prism_node.prism_node_children(node)
            if _t("prism_tt_wrap: position '" + p + "' round-trips via tt_pos", prism_node.prism_node_attr_str(kids[1], "tt_pos", "") == p)
                passed += 1
            else
                failed += 1

    // ── 3. prism_tt_popover: happy path, exact layer(d=3,c=4) ───────────────────────────────
    let pop_trigger = unwrap(prism_content.prism_label("Info"))
    let pop_body = unwrap(prism_content.prism_label("Extra detail here"))
    let pop_r = prism_ui_tooltip.prism_tt_popover("More info", pop_body, pop_trigger)
    if is_err(pop_r)
        print("FAIL prism_tt_popover (happy path): " + unwrap_err(pop_r))
        failed += 1
    else
        let pop = unwrap(pop_r)
        if _t("prism_tt_popover: kind == layer", prism_node.prism_node_kind_str(pop) == "layer")
            passed += 1
        else
            failed += 1
        if _t("prism_tt_popover: depth == 3", prism_node.prism_node_depth(pop) == 3)
            passed += 1
        else
            failed += 1
        if _t("prism_tt_popover: count == 5", prism_node.prism_node_count(pop) == 5)
            passed += 1
        else
            failed += 1
        let pop_kids = prism_node.prism_node_children(pop)
        if _t("prism_tt_popover: trigger preserved as first child", prism_node.prism_node_attr_str(pop_kids[0], "text", "") == "Info")
            passed += 1
        else
            failed += 1
        let panel = pop_kids[1]
        if _t("prism_tt_popover: panel kind == stack", prism_node.prism_node_kind_str(panel) == "stack")
            passed += 1
        else
            failed += 1
        let panel_kids = prism_node.prism_node_children(panel)
        if _t("prism_tt_popover: heading label == title", prism_node.prism_node_attr_str(panel_kids[0], "text", "") == "More info")
            passed += 1
        else
            failed += 1
        if _t("prism_tt_popover: body preserved", prism_node.prism_node_attr_str(panel_kids[1], "text", "") == "Extra detail here")
            passed += 1
        else
            failed += 1

    let pop_empty_title_r = prism_ui_tooltip.prism_tt_popover("", pop_body, pop_trigger)
    if _t("prism_tt_popover: empty title rejected", is_err(pop_empty_title_r))
        passed += 1
        print("  -> " + unwrap_err(pop_empty_title_r))
    else
        failed += 1

    // ── 4. prism_tt_help: convenience wrapper ───────────────────────────────────────────────
    let help_r = prism_ui_tooltip.prism_tt_help("This field is required")
    if is_err(help_r)
        print("FAIL prism_tt_help: " + unwrap_err(help_r))
        failed += 1
    else
        let help = unwrap(help_r)
        if _t("prism_tt_help: kind == layer", prism_node.prism_node_kind_str(help) == "layer")
            passed += 1
        else
            failed += 1
        if _t("prism_tt_help: count == 3", prism_node.prism_node_count(help) == 3)
            passed += 1
        else
            failed += 1
        let help_kids = prism_node.prism_node_children(help)
        if _t("prism_tt_help: first child is an info glyph", prism_node.prism_node_kind_str(help_kids[0]) == "glyph" and prism_node.prism_node_attr_str(help_kids[0], "icon", "") == "info")
            passed += 1
        else
            failed += 1
        let help_tip = help_kids[1]
        if _t("prism_tt_help: tooltip text round-trips", prism_node.prism_node_attr_str(help_tip, "tt_text", "") == "This field is required")
            passed += 1
        else
            failed += 1
        if _t("prism_tt_help: tooltip position is 'top'", prism_node.prism_node_attr_str(help_tip, "tt_pos", "") == "top")
            passed += 1
        else
            failed += 1

    print("== " + str(passed) + " passed, " + str(failed) + " failed ==")
    if failed > 0
        exit(1)
