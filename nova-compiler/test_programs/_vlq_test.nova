// KAT test for std/midi/vlq
// Known-answer vectors against the MIDI SMF VLQ specification.
// All byte vectors hand-verified against the Python reference implementation.
import std/midi/vlq

// ── Helpers ───────────────────────────────────────────────────────────────────

// Compare two lists of ints element-by-element; return 1 if equal, 0 otherwise.
fn _vt_list_eq(a, b) -> int
    let la = len(a)
    let lb = len(b)
    if la != lb
        return 0
    let i = 0
    while i < la
        if a[i] != b[i]
            return 0
        i = i + 1
    1

// list_to_str: format a list of ints as "[a,b,c]" for error messages.
fn _vt_lst_str(lst) -> any
    let s = "["
    let i = 0
    let n = len(lst)
    while i < n
        s = s + str(lst[i])
        if i < n - 1
            s = s + ","
        i = i + 1
    s = s + "]"
    s

// ckl: assert two int lists are equal; print FAIL + exit(1) on mismatch.
fn ckl(label, got, want) -> int
    if _vt_list_eq(got, want) == 0
        print("FAIL " + label + ": got=" + _vt_lst_str(got) + " want=" + _vt_lst_str(want))
        exit(1)
    0

// cki: assert two ints are equal; print FAIL + exit(1) on mismatch.
fn cki(label, got, want) -> int
    if got != want
        print("FAIL vlq " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)
    0

// ── KAT 1: vlq_encode(0) == [0x00] ───────────────────────────────────────────
// Zero is a single 0x00 byte in VLQ (special-cased in encoder).
fn test_encode_0() -> int
    let want = [0]
    let got = vlq_encode(0)
    ckl("vlq_encode(0)", got, want)

// ── KAT 2: vlq_encode(0x40) == [0x40] ────────────────────────────────────────
// 64 = 0x40 < 0x80, fits in one byte with no continuation bit.
fn test_encode_0x40() -> int
    let want = [64]
    let got = vlq_encode(64)
    ckl("vlq_encode(0x40)", got, want)

// ── KAT 3: vlq_encode(0x7F) == [0x7F] ────────────────────────────────────────
// 127 = 0x7F is the maximum single-byte VLQ value.
fn test_encode_0x7F() -> int
    let want = [127]
    let got = vlq_encode(127)
    ckl("vlq_encode(0x7F)", got, want)

// ── KAT 4: vlq_encode(0x80) == [0x81, 0x00] ──────────────────────────────────
// 128 = 0x80.  Groups (LSB first): 0x00, 0x01.
// Output (MSB first): 0x01|0x80 = 0x81, 0x00.
fn test_encode_0x80() -> int
    let want = [129, 0]
    let got = vlq_encode(128)
    ckl("vlq_encode(0x80)", got, want)

// ── KAT 5: vlq_encode(0x2000) == [0xC0, 0x00] ────────────────────────────────
// 8192 = 0x2000.  0x2000 >> 7 = 0x40; 0x2000 & 0x7F = 0.
// Groups (LSB first): 0x00, 0x40.
// Output (MSB first): 0x40|0x80 = 0xC0, 0x00.
fn test_encode_0x2000() -> int
    let want = [192, 0]
    let got = vlq_encode(8192)
    ckl("vlq_encode(0x2000)", got, want)

// ── KAT 6: vlq_encode(0x100000) == [0xC0, 0x80, 0x00] ───────────────────────
// 1048576 = 0x100000.
// Groups LSB-first: 0x100000&0x7F=0, >>7=0x2000, 0x2000&0x7F=0, >>7=0x40,
//   0x40&0x7F=0x40, >>7=0 stop.  Groups: [0, 0, 0x40].
// Output MSB-first: 0x40|0x80=0xC0, 0x00|0x80=0x80, 0x00.
fn test_encode_0x100000() -> int
    let want = [192, 128, 0]
    let got = vlq_encode(1048576)
    ckl("vlq_encode(0x100000)", got, want)

// ── KAT 7: vlq_encode(0x1FFFFF) == [0xFF, 0xFF, 0x7F] ────────────────────────
// 2097151 = 0x1FFFFF = max 3-byte VLQ value.
// Groups LSB-first: 0x7F, 0x7F, 0x7F.
// Output MSB-first: 0x7F|0x80=0xFF, 0x7F|0x80=0xFF, 0x7F.
fn test_encode_0x1FFFFF() -> int
    let want = [255, 255, 127]
    let got = vlq_encode(2097151)
    ckl("vlq_encode(0x1FFFFF)", got, want)

// ── KAT 8: vlq_decode([0x81, 0x00], 0) == [0x80, 2] ──────────────────────────
// Byte 0: 0x81 = 0b10000001; high bit set (continuation), payload = 0x01.
//   value = 0x01.
// Byte 1: 0x00; high bit clear (last byte), payload = 0x00.
//   value = (0x01 << 7) | 0x00 = 0x80.
// next_pos = 2.
fn test_decode_0x81_0x00() -> int
    let buf = [129, 0]
    let got = vlq_decode(buf, 0)
    cki("vlq_decode([0x81,0x00],0)[0]", got[0], 128)
    cki("vlq_decode([0x81,0x00],0)[1]", got[1], 2)

// ── KAT 9: round-trip n=0 ─────────────────────────────────────────────────────
fn test_rt_0() -> int
    let enc = vlq_encode(0)
    let dec = vlq_decode(enc, 0)
    cki("rt(0).value",    dec[0], 0)
    cki("rt(0).next_pos", dec[1], 1)

// ── KAT 10: round-trip n=127 ──────────────────────────────────────────────────
fn test_rt_127() -> int
    let enc = vlq_encode(127)
    let dec = vlq_decode(enc, 0)
    cki("rt(127).value",    dec[0], 127)
    cki("rt(127).next_pos", dec[1], 1)

// ── KAT 11: round-trip n=128 ──────────────────────────────────────────────────
fn test_rt_128() -> int
    let enc = vlq_encode(128)
    let dec = vlq_decode(enc, 0)
    cki("rt(128).value",    dec[0], 128)
    cki("rt(128).next_pos", dec[1], 2)

// ── KAT 12: round-trip n=16383 ────────────────────────────────────────────────
// 16383 = 0x3FFF.  Groups: 0x7F, 0x7F.  VLQ = [0xFF, 0x7F].
fn test_rt_16383() -> int
    let enc = vlq_encode(16383)
    let dec = vlq_decode(enc, 0)
    cki("rt(16383).value",    dec[0], 16383)
    cki("rt(16383).next_pos", dec[1], 2)

// ── KAT 13: round-trip n=2097151 ──────────────────────────────────────────────
fn test_rt_2097151() -> int
    let enc = vlq_encode(2097151)
    let dec = vlq_decode(enc, 0)
    cki("rt(2097151).value",    dec[0], 2097151)
    cki("rt(2097151).next_pos", dec[1], 3)

// ── KAT 14: vlq_len(0x80) == 2 ────────────────────────────────────────────────
fn test_len_0x80() -> int
    cki("vlq_len(0x80)", vlq_len(128), 2)

// ── KAT 15: vlq_len consistency with encode ───────────────────────────────────
fn test_len_consistency() -> int
    cki("vlq_len(0)",       vlq_len(0),       1)
    cki("vlq_len(127)",     vlq_len(127),     1)
    cki("vlq_len(128)",     vlq_len(128),     2)
    cki("vlq_len(16383)",   vlq_len(16383),   2)
    cki("vlq_len(16384)",   vlq_len(16384),   3)
    cki("vlq_len(2097151)", vlq_len(2097151), 3)
    cki("vlq_len(2097152)", vlq_len(2097152), 4)

// ── KAT 16: decode at non-zero offset (stream use case) ───────────────────────
// Buffer: [0x00, 0x81, 0x00] — decode at pos=1 must yield [128, 3].
fn test_decode_offset() -> int
    let buf = [0, 129, 0]
    let dec = vlq_decode(buf, 1)
    cki("decode_offset.value",    dec[0], 128)
    cki("decode_offset.next_pos", dec[1], 3)

// ── KAT 17: vlq_encode negative input guard ───────────────────────────────────
// vlq_encode(-1) must return an empty list (not crash).
fn test_encode_neg() -> int
    let got = vlq_encode(-1)
    cki("vlq_encode(-1) len", len(got), 0)

// ── KAT 18: vlq_decode past-end guard ─────────────────────────────────────────
// vlq_decode on empty list at pos=0 must return [0, 0].
fn test_decode_empty() -> int
    let buf = []
    let dec = vlq_decode(buf, 0)
    cki("decode_empty.value",    dec[0], 0)
    cki("decode_empty.next_pos", dec[1], 0)

// ── Entry point ───────────────────────────────────────────────────────────────
fn main() -> int
    test_encode_0()
    test_encode_0x40()
    test_encode_0x7F()
    test_encode_0x80()
    test_encode_0x2000()
    test_encode_0x100000()
    test_encode_0x1FFFFF()
    test_decode_0x81_0x00()
    test_rt_0()
    test_rt_127()
    test_rt_128()
    test_rt_16383()
    test_rt_2097151()
    test_len_0x80()
    test_len_consistency()
    test_decode_offset()
    test_encode_neg()
    test_decode_empty()
    print("PASS _vlq_test")
    0
