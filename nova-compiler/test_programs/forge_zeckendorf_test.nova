import forge_zeckendorf

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn joinl(xs: list) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + ","
        out = out + str(xs[i])
        i = i + 1
    out

fn main()
    let fails = 0

    // zeckendorf decomposition
    fails = fails + expect("z10", joinl(zeckendorf(10)), "8,2")
    fails = fails + expect("z100", joinl(zeckendorf(100)), "89,8,3")
    fails = fails + expect("z1", joinl(zeckendorf(1)), "1")
    fails = fails + expect("z4", joinl(zeckendorf(4)), "3,1")
    fails = fails + expect("z12", joinl(zeckendorf(12)), "8,3,1")
    fails = fails + expect("z11", joinl(zeckendorf(11)), "8,3")

    // sum property + non-consecutive-ish (sum must equal n) for many values
    let sum_ok = 1
    let n = 1
    while n <= 200
        let rep = zeckendorf(n)
        let s = 0
        let i = 0
        while i < len(rep)
            s = s + rep[i]
            i = i + 1
        if s != n
            sum_ok = 0
        n = n + 1
    fails = fails + expect("sum_property", str(sum_ok), "1")

    // Fibonacci coding
    fails = fails + expect("enc1", fib_encode(1), "11")
    fails = fails + expect("enc2", fib_encode(2), "011")
    fails = fails + expect("enc10", fib_encode(10), "010011")

    // decode round-trips
    fails = fails + expect("dec_enc_all", str(1), "1")
    let rt_ok = 1
    let m = 1
    while m <= 300
        if fib_decode(fib_encode(m)) != m
            rt_ok = 0
        m = m + 1
    fails = fails + expect("roundtrip_1_300", str(rt_ok), "1")

    // codes end in "11"
    let e = fib_encode(50)
    fails = fails + expect("ends11", slice(e, len(e) - 2, len(e)), "11")

    if fails == 0
        print("forge_zeckendorf: all passed")
    else
        print("forge_zeckendorf: " + str(fails) + " FAILED")
