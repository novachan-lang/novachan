// forge_redirect_query_test -- typed request/response ergonomics that complete the auth/form
// story: resp_redirect (a Response, not a wire string, for the typed path) and req_query (read a
// query param from a typed Request).
import forge

fn main()
    // resp_redirect -> a 303 Response with a sanitized Location header, empty body.
    let r: Response = forge.resp_redirect(303, "/dashboard")
    assert(r.status == 303, "redirect status 303")
    assert(r.body == "", "redirect has empty body")
    let wire = forge.finalize(r)
    assert(find(wire, "303 See Other") >= 0, "303 reason phrase")
    assert(find(wire, "Location: /dashboard") >= 0, "Location header set")
    print("PASS: resp_redirect")

    // a redirect Location carrying CRLF cannot inject a header (sanitized at the boundary).
    let evil: Response = forge.resp_redirect(302, "/x\r\nSet-Cookie: bad=1")
    assert(find(forge.finalize(evil), "\r\nSet-Cookie") < 0, "redirect Location CRLF cannot inject")
    print("PASS: redirect Location sanitized")

    // req_query reads typed query params.
    let req: Request = forge.build_request("GET /search?q=nova&page=2 HTTP/1.1\r\n\r\n", 0)
    assert(forge.req_query(req, "q") == "nova", "req_query q")
    assert(forge.req_query(req, "page") == "2", "req_query page")
    assert(forge.req_query(req, "missing") == "", "req_query missing -> empty")
    print("PASS: req_query")
    print("forge_redirect_query_test passed")
