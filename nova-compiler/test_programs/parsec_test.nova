// Minimal parser combinator test

fn p_ok(val, pos: int) -> list
    return [1, val, pos]

fn p_err(msg: string, pos: int) -> list
    return [0, msg, pos]

fn p_is_ok(r: list) -> int
    return r[0] == 1

fn p_val(r: list)
    return r[1]

fn p_pos(r: list) -> int
    return r[2]

fn p_char(input: string, pos: int, expected: string) -> list
    if pos < len(input) and input[pos:pos + 1] == expected
        return p_ok(expected, pos + 1)
    return p_err("expected '" + expected + "'", pos)

fn p_string(input: string, pos: int, expected: string) -> list
    let elen = len(expected)
    if pos + elen <= len(input) and input[pos:pos + elen] == expected
        return p_ok(expected, pos + elen)
    return p_err("expected '" + expected + "'", pos)

fn _is_digit(c: string) -> int
    let o = ord(c)
    return o >= 48 and o <= 57

fn p_digit(input: string, pos: int) -> list
    if pos < len(input)
        let c = input[pos:pos + 1]
        if _is_digit(c)
            return p_ok(c, pos + 1)
    return p_err("expected digit", pos)

fn p_many1(input: string, pos: int, parser) -> list
    let first = parser(input, pos)
    if not p_is_ok(first)
        return first
    let results = [p_val(first)]
    let cur = p_pos(first)
    while cur < len(input)
        let r = parser(input, cur)
        if not p_is_ok(r)
            return p_ok(results, cur)
        push(results, p_val(r))
        cur = p_pos(r)
    return p_ok(results, cur)

fn p_integer(input: string, pos: int) -> list
    let r = p_many1(input, pos, p_digit)
    if not p_is_ok(r)
        return p_err("expected integer", pos)
    let digits = p_val(r)
    let s = ""
    for d in digits
        s = s + d
    return p_ok(int(s), p_pos(r))

fn p_sep_by(input: string, pos: int, parser, sep) -> list
    let first = parser(input, pos)
    if not p_is_ok(first)
        return p_ok([], pos)
    let results = [p_val(first)]
    let cur = p_pos(first)
    while cur < len(input)
        let rs = sep(input, cur)
        if not p_is_ok(rs)
            return p_ok(results, cur)
        let rn = parser(input, p_pos(rs))
        if not p_is_ok(rn)
            return p_ok(results, cur)
        push(results, p_val(rn))
        cur = p_pos(rn)
    return p_ok(results, cur)

fn main()
    // p_char
    let r1 = p_char("abc", 0, "a")
    assert(p_is_ok(r1), "char a")
    assert(p_val(r1) == "a", "char val")
    assert(p_pos(r1) == 1, "char pos")

    let r2 = p_char("abc", 0, "b")
    assert(not p_is_ok(r2), "char fail")

    // p_string
    let r3 = p_string("hello world", 0, "hello")
    assert(p_is_ok(r3), "string match")
    assert(p_val(r3) == "hello", "string val")

    // p_digit
    let r4 = p_digit("3abc", 0)
    assert(p_is_ok(r4), "digit ok")
    assert(p_val(r4) == "3", "digit val")

    // p_integer
    let r5 = p_integer("42abc", 0)
    assert(p_is_ok(r5), "int ok")
    assert(p_val(r5) == 42, "int val")
    assert(p_pos(r5) == 2, "int pos")

    // p_sep_by
    let comma = fn(inp, p) p_char(inp, p, ",")
    let r6 = p_sep_by("1,2,3", 0, p_integer, comma)
    assert(p_is_ok(r6), "sep_by ok")
    let vals = p_val(r6)
    assert(len(vals) == 3, "sep_by count")
    assert(vals[0] == 1, "sep_by 0")
    assert(vals[1] == 2, "sep_by 1")
    assert(vals[2] == 3, "sep_by 2")

    print("parsec_test: all passed")
