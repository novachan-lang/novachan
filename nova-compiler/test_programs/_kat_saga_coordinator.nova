import forge_saga_coordinator

fn main()
    let s = saga_new("order")
    s = saga_add_step(s, "reserve_stock", "release_stock")
    s = saga_add_step(s, "charge_payment", "refund_payment")
    s = saga_add_step(s, "ship_order", "cancel_shipment")
    assert(saga_step_count(s) == 3, "3 steps")
    assert(saga_status(s) == "pending", "pending")

    let n = saga_step_name(s, 0)
    assert(is_ok(n), "name ok")
    assert(unwrap(n) == "reserve_stock", "step 0 name")

    let c = saga_compensation(s, 1)
    assert(is_ok(c), "comp ok")
    assert(unwrap(c) == "refund_payment", "comp 1")

    let e1 = saga_execute_step(s, 0)
    assert(is_ok(e1), "exec 0 ok")
    s = unwrap(e1)
    assert(saga_status(s) == "in_progress", "in progress")

    let e2 = saga_execute_step(s, 1)
    assert(is_ok(e2), "exec 1 ok")
    s = unwrap(e2)

    let comp = saga_compensate(s, 1)
    assert(is_ok(comp), "compensate ok")
    s = unwrap(comp)
    assert(saga_compensated_count(s) == 1, "1 compensated")
    assert(saga_status(s) == "compensating", "compensating")

    let bad = saga_execute_step(s, 5)
    assert(is_err(bad), "out of range")

    let bad2 = saga_compensate(s, 2)
    assert(is_err(bad2), "not executed")

    print("SAGA-COORDINATOR KAT PASS")
