import std/permutation/perm_inverse

// cki — check integer equality
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb — check bool equality
fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

// list_str — render int list as "[a,b,c]"
fn list_str(xs) -> string
    let s = "["
    let i = 0
    while i < len(xs)
        if i > 0
            s = s + ","
        s = s + str(xs[i])
        i = i + 1
    s + "]"

// ckl — check list equality element-wise
fn ckl(label: string, got, want)
    if len(got) != len(want)
        print("FAIL " + label + ": got=" + list_str(got) + " want=" + list_str(want))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL " + label + ": got=" + list_str(got) + " want=" + list_str(want))
            exit(1)
        i = i + 1

fn main()
    // KAT: pi_inverse([1,2,0]) = [2,0,1]
    // p = [1,2,0]: 0->1, 1->2, 2->0
    // inv: inv[1]=0, inv[2]=1, inv[0]=2  => [2,0,1]
    let inv1 = pi_inverse([1, 2, 0])
    ckl("inverse_1_2_0", inv1, [2, 0, 1])

    // KAT: pi_inverse([0,1,2]) = [0,1,2]  (identity is its own inverse)
    let inv2 = pi_inverse([0, 1, 2])
    ckl("inverse_identity", inv2, [0, 1, 2])

    // KAT: pi_inverse([2,0,1]) = [1,2,0]
    // p = [2,0,1]: 0->2, 1->0, 2->1
    // inv: inv[2]=0, inv[0]=1, inv[1]=2  => [1,2,0]
    let inv3 = pi_inverse([2, 0, 1])
    ckl("inverse_2_0_1", inv3, [1, 2, 0])

    // KAT: pi_inverse([3,0,2,1]) — verify it's a valid inverse
    // p = [3,0,2,1]: 0->3, 1->0, 2->2, 3->1
    // inv: inv[3]=0, inv[0]=1, inv[2]=2, inv[1]=3  => [1,3,2,0]
    let inv4 = pi_inverse([3, 0, 2, 1])
    ckl("inverse_3_0_2_1", inv4, [1, 3, 2, 0])

    // KAT: single element — pi_inverse([0]) = [0]
    let inv5 = pi_inverse([0])
    ckl("inverse_n1", inv5, [0])

    // KAT: empty — pi_inverse([]) = []
    let inv6 = pi_inverse([])
    cki("inverse_empty_len", len(inv6), 0)

    // KAT: pi_is_involution([1,0,2]) = true
    // p: 0->1, 1->0, 2->2  => p(p(0))=p(1)=0, p(p(1))=p(0)=1, p(p(2))=p(2)=2 ✓
    ckb("involution_1_0_2", pi_is_involution([1, 0, 2]), true)

    // KAT: pi_is_involution([1,2,0]) = false
    // p: 0->1, 1->2, 2->0  => p(p(0))=p(1)=2 != 0 ✗
    ckb("involution_1_2_0_false", pi_is_involution([1, 2, 0]), false)

    // KAT: pi_is_involution([0,1,2]) = true (identity is an involution)
    ckb("involution_identity", pi_is_involution([0, 1, 2]), true)

    // KAT: pi_is_involution([0]) = true
    ckb("involution_n1", pi_is_involution([0]), true)

    // KAT: pi_compose_inverse_is_identity([3,0,2,1]) = true
    ckb("compose_inv_id_4", pi_compose_inverse_is_identity([3, 0, 2, 1]), true)

    // Also verify for [1,2,0]
    ckb("compose_inv_id_1_2_0", pi_compose_inverse_is_identity([1, 2, 0]), true)

    // And for identity
    ckb("compose_inv_id_identity", pi_compose_inverse_is_identity([0, 1, 2]), true)

    // And single element
    ckb("compose_inv_id_n1", pi_compose_inverse_is_identity([0]), true)

    // Involution of a longer permutation: [1,0,3,2]
    // p: 0->1, 1->0, 2->3, 3->2 => p(p(i))=i for all i
    ckb("involution_1_0_3_2", pi_is_involution([1, 0, 3, 2]), true)

    print("PASS _perm_inverse_test")
