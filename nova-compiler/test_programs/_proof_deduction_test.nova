import std/proof/proof_deduction

fn cki(label, got, want)
    if got != want
        print("FAIL _proof_deduction_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL _proof_deduction_test " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL _proof_deduction_test " + label + ": got=" + got + " want=" + want)
        exit(1)

// _ckfeq — check two formulas are structurally equal using recursive compare.
fn _ckfeq(label, got, want)
    // We cross-check equality via pded_is_tautology(imp(got, want)) && imp(want, got)
    // But formula eq check: compare tags and children
    let ok = 1
    if len(got) != len(want)
        ok = 0
    if ok == 1
        if got[0] != want[0]
            ok = 0
    if ok == 0
        print("FAIL _proof_deduction_test " + label + ": formula mismatch")
        exit(1)

fn main()
    let fA = pded_var("A")
    let fB = pded_var("B")
    let fC = pded_var("C")

    // === KAT 1: modus_ponens — imp(A,B) and A gives B ===
    let fAB = pded_imp(fA, fB)
    let res_mp = pded_modus_ponens(fAB, fA)
    // Result should equal fB
    ckb("mp_AtoB_A_gives_B_is_B", pded_is_tautology(pded_imp(res_mp, fB)), true)
    ckb("mp_AtoB_A_gives_B_is_taut_back", pded_is_tautology(pded_imp(fB, res_mp)), true)

    // === KAT 2: modus_ponens with wrong antecedent => "FAIL" ===
    let res_mp2 = pded_modus_ponens(fAB, fC)
    cks("mp_wrong_antecedent_FAIL", res_mp2, "FAIL")

    // === KAT 3: modus_ponens on non-implication => "FAIL" ===
    let res_mp3 = pded_modus_ponens(fA, fA)
    cks("mp_non_imp_FAIL", res_mp3, "FAIL")

    // === KAT 4: hyp_syllogism — imp(A,B) and imp(B,C) gives imp(A,C) ===
    let fBC = pded_imp(fB, fC)
    let res_hs = pded_hyp_syllogism(fAB, fBC)
    let expected_AC = pded_imp(fA, fC)
    ckb("hyp_syllogism_result_check", pded_is_tautology(pded_imp(res_hs, expected_AC)), true)
    ckb("hyp_syllogism_result_check_back", pded_is_tautology(pded_imp(expected_AC, res_hs)), true)

    // === KAT 5: hyp_syllogism with mismatched middle => "FAIL" ===
    let fAC = pded_imp(fA, fC)
    let res_hs2 = pded_hyp_syllogism(fAB, fAC)
    cks("hyp_syllogism_mismatch_FAIL", res_hs2, "FAIL")

    // === KAT 6: contrapositive — imp(A,B) gives imp(~B,~A) ===
    let res_cp = pded_contrapositive(fAB)
    let expected_cp = pded_imp(pded_not(fB), pded_not(fA))
    ckb("contrapositive_check", pded_is_tautology(pded_imp(res_cp, expected_cp)), true)
    ckb("contrapositive_check_back", pded_is_tautology(pded_imp(expected_cp, res_cp)), true)

    // === KAT 7: contrapositive on non-imp => "FAIL" ===
    let res_cp2 = pded_contrapositive(fA)
    cks("contrapositive_non_imp_FAIL", res_cp2, "FAIL")

    // === KAT 8: double_neg_intro — A gives imp(A, ~~A) ===
    let res_dni = pded_double_neg_intro(fA)
    let expected_dni = pded_imp(fA, pded_not(pded_not(fA)))
    ckb("dne_intro_check", pded_is_tautology(pded_imp(res_dni, expected_dni)), true)
    ckb("dne_intro_check_back", pded_is_tautology(pded_imp(expected_dni, res_dni)), true)

    // === KAT 9: deduction_forward — from (A, B) return imp(A,B) ===
    let res_df = pded_deduction_forward(fA, fB)
    ckb("deduction_forward_check", pded_is_tautology(pded_imp(res_df, fAB)), true)
    ckb("deduction_forward_check_back", pded_is_tautology(pded_imp(fAB, res_df)), true)

    // === KAT 10: currying — imp(and(A,B),C) gives imp(A,imp(B,C)) ===
    let fAndAB = pded_and(fA, fB)
    let fAndAB_to_C = pded_imp(fAndAB, fC)
    let res_curry = pded_currying(fAndAB_to_C)
    let expected_curry = pded_imp(fA, pded_imp(fB, fC))
    ckb("currying_check", pded_is_tautology(pded_imp(res_curry, expected_curry)), true)
    ckb("currying_check_back", pded_is_tautology(pded_imp(expected_curry, res_curry)), true)

    // === KAT 11: currying on non-and-imp => "FAIL" ===
    let res_curry2 = pded_currying(fAB)
    cks("currying_non_and_FAIL", res_curry2, "FAIL")

    // === KAT 12: uncurrying — imp(A,imp(B,C)) gives imp(and(A,B),C) ===
    let fA_to_BC = pded_imp(fA, pded_imp(fB, fC))
    let res_uncurry = pded_uncurrying(fA_to_BC)
    ckb("uncurrying_check", pded_is_tautology(pded_imp(res_uncurry, fAndAB_to_C)), true)
    ckb("uncurrying_check_back", pded_is_tautology(pded_imp(fAndAB_to_C, res_uncurry)), true)

    // === CROSS-CHECK: derived formulas are tautology-preserving transformations ===
    // Modus ponens: (A->B) & A -> B  is a tautology
    let mp_taut = pded_imp(pded_and(fAB, fA), fB)
    ckb("mp_tautology_cross", pded_is_tautology(mp_taut), true)

    // Hypothetical syllogism: (A->B) & (B->C) -> (A->C)  is a tautology
    let hs_taut = pded_imp(pded_and(fAB, fBC), expected_AC)
    ckb("hs_tautology_cross", pded_is_tautology(hs_taut), true)

    // Contrapositive: (A->B) -> (~B->~A)  is a tautology
    let cp_taut = pded_imp(fAB, expected_cp)
    ckb("cp_tautology_cross", pded_is_tautology(cp_taut), true)

    // Double negation intro: A -> ~~A  is a tautology
    ckb("dne_intro_tautology_cross", pded_is_tautology(expected_dni), true)

    // Currying: (A&B->C) -> (A->B->C)  is a tautology
    let curry_taut = pded_imp(fAndAB_to_C, expected_curry)
    ckb("curry_tautology_cross", pded_is_tautology(curry_taut), true)

    // Uncurrying: (A->B->C) -> (A&B->C)  is a tautology
    let uncurry_taut = pded_imp(fA_to_BC, fAndAB_to_C)
    ckb("uncurry_tautology_cross", pded_is_tautology(uncurry_taut), true)

    // === Conjunction intro/elim ===
    let fAandB = pded_conj_intro(fA, fB)
    let res_conj_l = pded_conj_elim_l(fAandB)
    let res_conj_r = pded_conj_elim_r(fAandB)
    ckb("conj_elim_l_taut", pded_is_tautology(pded_imp(fAandB, res_conj_l)), true)
    ckb("conj_elim_r_taut", pded_is_tautology(pded_imp(fAandB, res_conj_r)), true)

    // conj_elim on non-and => "FAIL"
    let res_cel = pded_conj_elim_l(fAB)
    cks("conj_elim_l_non_and_FAIL", res_cel, "FAIL")

    // === Tautology oracle: soundness check ===
    // A->B is NOT a tautology
    ckb("AtoB_not_taut", pded_is_tautology(fAB), false)
    // A->A IS a tautology
    ckb("AtoA_taut", pded_is_tautology(pded_imp(fA, fA)), true)

    print("PASS _proof_deduction_test")
