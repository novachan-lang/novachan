fn classify(n: int) -> string
    match n
        0 => "zero"
        1 | 2 | 3 => "small"
        4..10 => "medium"
        _ => "large"

fn greet(name: string, greeting: string = "Hello") -> string
    "{greeting}, {name}!"

fn main()
    assert_eq(classify(0), "zero")
    assert_eq(classify(2), "small")
    assert_eq(classify(7), "medium")
    assert_eq(classify(100), "large")

    assert_eq(greet("Alice"), "Hello, Alice!")
    assert_eq(greet("Bob", "Hi"), "Hi, Bob!")

    let found = false
    for x in [1, 2, 3, 4, 5]
        if x == 3
            found = true

    assert_eq(found, true)

    let items = [10, 20, 30]
    for i, v in items
        if i == 1
            assert_eq(v, 20)

    let s = "hello world"
    assert_eq(upper(s), "HELLO WORLD")
    assert_eq(split(s, " "), ["hello", "world"])
    assert_eq(replace(s, "world", "NOVA"), "hello NOVA")

    let n = 42
    let desc = "big" if n > 10 else "small"
    assert_eq(desc, "big")

    print("ergo_probe2: all passed")
