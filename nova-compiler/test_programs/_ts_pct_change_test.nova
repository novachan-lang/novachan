import std/math/ts_pct_change

fn approx(a: float, b: float, tol: float) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < tol
        return 1
    return 0

fn check_list(label: str, got: list, want: list, tol: float)
    if len(got) != len(want)
        print("FAIL " + label + " len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        let g = got[i] * 1.0
        let w = want[i] * 1.0
        if approx(g, w, tol) == 0
            print("FAIL " + label + "[" + str(i) + "] got=" + str(g) + " want=" + str(w))
            exit(1)
        i = i + 1

fn main()
    // KAT 1: basic three-element series
    // [100, 110, 99]: (110-100)/100=0.1, (99-110)/110=-0.1
    let d1 = [100.0, 110.0, 99.0]
    let r1 = ts_pct_change(d1)
    let want1 = [0.1, -0.1]
    check_list("ts_pct_change basic", r1, want1, 0.0001)

    // KAT 2: two-element series [50,100] -> [1.0]
    let d2 = [50.0, 100.0]
    let r2 = ts_pct_change(d2)
    let want2 = [1.0]
    check_list("ts_pct_change two-elem", r2, want2, 0.0001)

    // KAT 3: zero base -> result = 0.0
    let d3 = [0.0, 5.0]
    let r3 = ts_pct_change(d3)
    let want3 = [0.0]
    check_list("ts_pct_change zero-base", r3, want3, 0.0001)

    // KAT 4: empty list -> []
    let d4 = []
    let r4 = ts_pct_change(d4)
    if len(r4) != 0
        print("FAIL ts_pct_change empty len=" + str(len(r4)))
        exit(1)

    // KAT 5: single element -> []
    let d5 = [42.0]
    let r5 = ts_pct_change(d5)
    if len(r5) != 0
        print("FAIL ts_pct_change single len=" + str(len(r5)))
        exit(1)

    // KAT 6: declining series [200, 100, 50] -> [-0.5, -0.5]
    let d6 = [200.0, 100.0, 50.0]
    let r6 = ts_pct_change(d6)
    let want6 = [-0.5, -0.5]
    check_list("ts_pct_change declining", r6, want6, 0.0001)

    print("PASS _ts_pct_change_test")
