// Real WASM function-call + recursion oracle. fac.wasm has two functions:
//   func0 main()      = i32.const 5  call 1            ;; fac(5)
//   func1 fac(n)->i32 = local.get 0 i32.const 1 i32.le_s
//                       if (result i32) i32.const 1
//                       else local.get 0 local.get 0 i32.const 1 i32.sub
//                            call 1 (self) i32.mul end
// Oracle: wasm_run must return 5! = 120 — only possible with real call frames + recursion.
fn main()
    let m = wasm_compile("fac.wasm")
    assert_eq(m >= 0, true)
    let r = wasm_run(m)
    print("wasm fac(5) = {r}")
    assert_eq(r, 120)
    wasm_free(m)
    print("WASM call/recursion test passed: fac(5) = 120")
