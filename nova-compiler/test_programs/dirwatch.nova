// dirwatch.nova — directory change detection by snapshot + diff, the NOVA way.
//
// Instead of an OS-event callback (inotify/ReadDirectoryChangesW), a watcher is
// just two pure operations over the existing file builtins: snapshot a directory
// (filename -> [mtime, size]) and diff two snapshots into added/removed/modified.
// A polling loop calls dir_snapshot periodically and diffs against the previous
// one. Deterministic, zero new runtime, composes over list_dir/file_mtime/
// file_size/is_dir. (modified is detected by EITHER mtime OR size change, so it
// is robust even where the filesystem mtime resolution is coarse.)

fn dir_snapshot(path)
  let snap = {}
  let entries = list_dir(path)
  for name in entries
    let full = path + "/" + name
    if not is_dir(full)
      snap[name] = [file_mtime(full), file_size(full)]
  snap

fn dir_diff(old_snap, new_snap)
  let added = []
  let removed = []
  let modified = []
  for name in keys(new_snap)
    if not contains(old_snap, name)
      push(added, name)
    else
      let o = old_snap[name]
      let n = new_snap[name]
      if o[0] != n[0] or o[1] != n[1]
        push(modified, name)
  for name in keys(old_snap)
    if not contains(new_snap, name)
      push(removed, name)
  let result = {}
  result["added"] = added
  result["removed"] = removed
  result["modified"] = modified
  result

fn dir_changed(old_snap, new_snap)
  let d = dir_diff(old_snap, new_snap)
  if len(d["added"]) > 0 or len(d["removed"]) > 0 or len(d["modified"]) > 0
    return 1
  0

// ── Test ─────────────────────────────────────────────────────────────

let dir = "_dwtest"
mkdir(dir)
write_file(dir + "/a.txt", "hello")
write_file(dir + "/b.txt", "world")

let s1 = dir_snapshot(dir)
assert(len(keys(s1)) == 2, "snapshot has 2 files")
print("PASS: snapshot")

// add a file -> detected in `added`
write_file(dir + "/c.txt", "new file")
let s2 = dir_snapshot(dir)
let d1 = dir_diff(s1, s2)
assert(len(d1["added"]) == 1, "one added")
assert(d1["added"][0] == "c.txt", "c.txt is the added file")
assert(len(d1["removed"]) == 0, "nothing removed")
assert(len(d1["modified"]) == 0, "nothing modified")
print("PASS: detect added")

// modify a file (content size changes) -> detected in `modified`
write_file(dir + "/a.txt", "hello world, this is much longer content now")
let s3 = dir_snapshot(dir)
let d2 = dir_diff(s2, s3)
assert(len(d2["modified"]) == 1, "one modified")
assert(d2["modified"][0] == "a.txt", "a.txt is the modified file")
assert(len(d2["added"]) == 0, "nothing added on modify")
print("PASS: detect modified")

// remove a file -> detected in `removed`
remove_file(dir + "/b.txt")
let s4 = dir_snapshot(dir)
let d3 = dir_diff(s3, s4)
assert(len(d3["removed"]) == 1, "one removed")
assert(d3["removed"][0] == "b.txt", "b.txt is the removed file")
print("PASS: detect removed")

// identical snapshots -> no change
let s5 = dir_snapshot(dir)
assert(dir_changed(s4, s5) == 0, "no change between identical snapshots")
assert(dir_changed(s3, s4) == 1, "change between different snapshots")
print("PASS: dir_changed")

// cleanup
remove_file(dir + "/a.txt")
remove_file(dir + "/c.txt")
remove_dir(dir)
assert(not file_exists(dir), "temp dir cleaned up")
print("PASS: cleanup")

print("ALL PASS: dirwatch — directory change detection (snapshot + diff)")
