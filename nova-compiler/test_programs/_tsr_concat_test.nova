import std/tensor/tsr_concat

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL " + label + " got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(label: str, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + " len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL " + label + "[" + str(i) + "] got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn ckt(label: str, t: list, want_flat: list, want_shape: list)
    let flat = t[0]
    let shape = t[1]
    if len(flat) != len(want_flat)
        print("FAIL " + label + " flat len got=" + str(len(flat)) + " want=" + str(len(want_flat)))
        exit(1)
    let i = 0
    while i < len(flat)
        if flat[i] != want_flat[i]
            print("FAIL " + label + " flat[" + str(i) + "] got=" + str(flat[i]) + " want=" + str(want_flat[i]))
            exit(1)
        i = i + 1
    if len(shape) != len(want_shape)
        print("FAIL " + label + " shape len got=" + str(len(shape)) + " want=" + str(len(want_shape)))
        exit(1)
    let j = 0
    while j < len(shape)
        if shape[j] != want_shape[j]
            print("FAIL " + label + " shape[" + str(j) + "] got=" + str(shape[j]) + " want=" + str(want_shape[j]))
            exit(1)
        j = j + 1

fn main()
    // Build [[1,2],[3,4]] = 2x2 tensor (flat=[1,2,3,4] shape=[2,2])
    let f22 = []
    push(f22, 1)
    push(f22, 2)
    push(f22, 3)
    push(f22, 4)
    let s22 = []
    push(s22, 2)
    push(s22, 2)
    let t22 = []
    push(t22, f22)
    push(t22, s22)

    // Build [[5,6]] = 1x2 tensor (flat=[5,6] shape=[1,2])
    let f12 = []
    push(f12, 5)
    push(f12, 6)
    let s12 = []
    push(s12, 1)
    push(s12, 2)
    let t12 = []
    push(t12, f12)
    push(t12, s12)

    // KAT: tx_concat([[1,2,3,4],[2,2]], [[5,6],[1,2]], 0) -> [1,2,3,4,5,6],[3,2]
    let c0 = tx_concat(t22, t12, 0)
    let wf0 = []
    push(wf0, 1)
    push(wf0, 2)
    push(wf0, 3)
    push(wf0, 4)
    push(wf0, 5)
    push(wf0, 6)
    let ws0 = []
    push(ws0, 3)
    push(ws0, 2)
    ckt("tx_concat axis0 2+1 rows", c0, wf0, ws0)

    // Build [[5,6,7,8]] = 2x2 tensor (flat=[5,6,7,8] shape=[2,2])
    let f22b = []
    push(f22b, 5)
    push(f22b, 6)
    push(f22b, 7)
    push(f22b, 8)
    let s22b = []
    push(s22b, 2)
    push(s22b, 2)
    let t22b = []
    push(t22b, f22b)
    push(t22b, s22b)

    // KAT: tx_concat([[1,2,3,4],[2,2]], [[5,6,7,8],[2,2]], 1) -> [1,2,5,6,3,4,7,8],[2,4]
    let c1 = tx_concat(t22, t22b, 1)
    let wf1 = []
    push(wf1, 1)
    push(wf1, 2)
    push(wf1, 5)
    push(wf1, 6)
    push(wf1, 3)
    push(wf1, 4)
    push(wf1, 7)
    push(wf1, 8)
    let ws1 = []
    push(ws1, 2)
    push(ws1, 4)
    ckt("tx_concat axis1 2x2+2x2", c1, wf1, ws1)

    // Build 1-D tensor [1,2] (flat=[1,2] shape=[2])
    let f1d_a = []
    push(f1d_a, 1)
    push(f1d_a, 2)
    let s1d = []
    push(s1d, 2)
    let t1d_a = []
    push(t1d_a, f1d_a)
    push(t1d_a, s1d)

    // Build 1-D tensor [3,4] (flat=[3,4] shape=[2])
    let f1d_b = []
    push(f1d_b, 3)
    push(f1d_b, 4)
    let s1d_b = []
    push(s1d_b, 2)
    let t1d_b = []
    push(t1d_b, f1d_b)
    push(t1d_b, s1d_b)

    // KAT: tx_stack([[1,2],[2]], [[3,4],[2]], 0) -> [1,2,3,4],[2,2]
    let st0 = tx_stack(t1d_a, t1d_b, 0)
    let wfst0 = []
    push(wfst0, 1)
    push(wfst0, 2)
    push(wfst0, 3)
    push(wfst0, 4)
    let wsst0 = []
    push(wsst0, 2)
    push(wsst0, 2)
    ckt("tx_stack 1d axis0", st0, wfst0, wsst0)

    // KAT: tx_vstack([[1,2],[1,2]], [[3,4],[1,2]]) -> [1,2,3,4],[2,2]
    // Build 1x2 tensor [[1,2]] (flat=[1,2] shape=[1,2])
    let fv1 = []
    push(fv1, 1)
    push(fv1, 2)
    let sv1 = []
    push(sv1, 1)
    push(sv1, 2)
    let tv1 = []
    push(tv1, fv1)
    push(tv1, sv1)

    // Build 1x2 tensor [[3,4]] (flat=[3,4] shape=[1,2])
    let fv2 = []
    push(fv2, 3)
    push(fv2, 4)
    let sv2 = []
    push(sv2, 1)
    push(sv2, 2)
    let tv2 = []
    push(tv2, fv2)
    push(tv2, sv2)

    let vs = tx_vstack(tv1, tv2)
    let wfvs = []
    push(wfvs, 1)
    push(wfvs, 2)
    push(wfvs, 3)
    push(wfvs, 4)
    let wsvs = []
    push(wsvs, 2)
    push(wsvs, 2)
    ckt("tx_vstack 1x2+1x2", vs, wfvs, wsvs)

    // KAT: tx_hstack([[1,2],[2,1]], [[3,4],[2,1]]) -> [1,3,2,4],[2,2]
    // Build 2x1 tensor [[1],[2]] (flat=[1,2] shape=[2,1])
    let fh1 = []
    push(fh1, 1)
    push(fh1, 2)
    let sh1 = []
    push(sh1, 2)
    push(sh1, 1)
    let th1 = []
    push(th1, fh1)
    push(th1, sh1)

    // Build 2x1 tensor [[3],[4]] (flat=[3,4] shape=[2,1])
    let fh2 = []
    push(fh2, 3)
    push(fh2, 4)
    let sh2 = []
    push(sh2, 2)
    push(sh2, 1)
    let th2 = []
    push(th2, fh2)
    push(th2, sh2)

    let hs = tx_hstack(th1, th2)
    let wfhs = []
    push(wfhs, 1)
    push(wfhs, 3)
    push(wfhs, 2)
    push(wfhs, 4)
    let wshs = []
    push(wshs, 2)
    push(wshs, 2)
    ckt("tx_hstack 2x1+2x1", hs, wfhs, wshs)

    // Extra: 1-D concat produces correct flat length
    let fc1 = tx_concat(t1d_a, t1d_b, 0)
    let wfc1 = []
    push(wfc1, 1)
    push(wfc1, 2)
    push(wfc1, 3)
    push(wfc1, 4)
    let wsc1 = []
    push(wsc1, 4)
    ckt("tx_concat 1d axis0", fc1, wfc1, wsc1)

    // Extra: tx_stack 1-D axis=1 -> [n,2] interleaved
    let st1 = tx_stack(t1d_a, t1d_b, 1)
    let wfst1 = []
    push(wfst1, 1)
    push(wfst1, 3)
    push(wfst1, 2)
    push(wfst1, 4)
    let wsst1 = []
    push(wsst1, 2)
    push(wsst1, 2)
    ckt("tx_stack 1d axis1", st1, wfst1, wsst1)

    print("PASS _tsr_concat_test")
