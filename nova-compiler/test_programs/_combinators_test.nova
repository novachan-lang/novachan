import std/parsing/combinators

fn main()
    // --- pc_int basic ---
    let r1 = pc_run(pc_int(), "42")
    if r1[0] == false
        print("FAIL combinators pc_int ok: got 0 want 1")
        exit(1)
    if r1[1] != 42
        print("FAIL combinators pc_int val: got "+str(r1[1])+" want 42")
        exit(1)
    if r1[2] != 2
        print("FAIL combinators pc_int pos: got "+str(r1[2])+" want 2")
        exit(1)

    // --- pc_int failure on non-digit ---
    let r_fail = pc_run(pc_int(), "x")
    if r_fail[0] == true
        print("FAIL combinators pc_int fail: got ok=1 want 0")
        exit(1)

    // --- pc_int empty string ---
    let r_empty = pc_run(pc_int(), "")
    if r_empty[0] == true
        print("FAIL combinators pc_int empty: got ok=1 want 0")
        exit(1)

    // --- pc_int negative ---
    let r_neg = pc_run(pc_int(), "-17")
    if r_neg[0] == false
        print("FAIL combinators pc_int neg ok: got 0 want 1")
        exit(1)
    if r_neg[1] != -17
        print("FAIL combinators pc_int neg val: got "+str(r_neg[1])+" want -17")
        exit(1)

    // --- pc_str basic ---
    let r_str = pc_run(pc_str("hello"), "hello")
    if r_str[0] == false
        print("FAIL combinators pc_str ok: got 0 want 1")
        exit(1)
    if r_str[1] != "hello"
        print("FAIL combinators pc_str val: got "+r_str[1]+" want hello")
        exit(1)

    // --- pc_str partial (prefix only match) ---
    let r_pre = pc_run(pc_str("he"), "hello")
    if r_pre[0] == false
        print("FAIL combinators pc_str prefix: got 0 want 1")
        exit(1)
    if r_pre[2] != 2
        print("FAIL combinators pc_str prefix pos: got "+str(r_pre[2])+" want 2")
        exit(1)

    // --- pc_str fail ---
    let r_sfail = pc_run(pc_str("xyz"), "hello")
    if r_sfail[0] == true
        print("FAIL combinators pc_str fail: got 1 want 0")
        exit(1)

    // --- pc_char ---
    let r_ch = pc_run(pc_char("h"), "hello")
    if r_ch[0] == false
        print("FAIL combinators pc_char ok: got 0 want 1")
        exit(1)
    if r_ch[1] != "h"
        print("FAIL combinators pc_char val: got "+r_ch[1]+" want h")
        exit(1)

    // --- pc_digit ---
    let r_dig = pc_run(pc_digit(), "7abc")
    if r_dig[0] == false
        print("FAIL combinators pc_digit ok: got 0 want 1")
        exit(1)
    if r_dig[1] != "7"
        print("FAIL combinators pc_digit val: got "+r_dig[1]+" want 7")
        exit(1)

    // --- pc_digit fail ---
    let r_dnf = pc_run(pc_digit(), "abc")
    if r_dnf[0] == true
        print("FAIL combinators pc_digit fail: got 1 want 0")
        exit(1)

    // --- pc_seq ---
    let sq = []
    push(sq, pc_str("ab"))
    push(sq, pc_str("cd"))
    let r_seq = pc_run(pc_seq(sq), "abcd")
    if r_seq[0] == false
        print("FAIL combinators pc_seq ok: got 0 want 1")
        exit(1)
    let seqv = r_seq[1]
    if seqv[0] != "ab"
        print("FAIL combinators pc_seq val0: got "+seqv[0]+" want ab")
        exit(1)
    if seqv[1] != "cd"
        print("FAIL combinators pc_seq val1: got "+seqv[1]+" want cd")
        exit(1)

    // --- pc_seq partial fail ---
    let sq2 = []
    push(sq2, pc_str("ab"))
    push(sq2, pc_str("xy"))
    let r_sq2 = pc_run(pc_seq(sq2), "abcd")
    if r_sq2[0] == true
        print("FAIL combinators pc_seq partial: got 1 want 0")
        exit(1)

    // --- pc_alt success first ---
    let alts = []
    push(alts, pc_str("cat"))
    push(alts, pc_str("dog"))
    let r_alt1 = pc_run(pc_alt(alts), "cat")
    if r_alt1[0] == false
        print("FAIL combinators pc_alt first ok: got 0 want 1")
        exit(1)
    if r_alt1[1] != "cat"
        print("FAIL combinators pc_alt first val: got "+r_alt1[1]+" want cat")
        exit(1)

    // --- pc_alt success second (KAT: "dog") ---
    let alts2 = []
    push(alts2, pc_str("cat"))
    push(alts2, pc_str("dog"))
    let r_alt2 = pc_run(pc_alt(alts2), "dog")
    if r_alt2[0] == false
        print("FAIL combinators pc_alt second ok: got 0 want 1")
        exit(1)

    // --- pc_alt fail all ---
    let alts3 = []
    push(alts3, pc_str("cat"))
    push(alts3, pc_str("dog"))
    let r_alt3 = pc_run(pc_alt(alts3), "fish")
    if r_alt3[0] == true
        print("FAIL combinators pc_alt fail: got 1 want 0")
        exit(1)

    // --- pc_many zero matches ---
    let r_m0 = pc_run(pc_many(pc_str("x")), "abc")
    if r_m0[0] == false
        print("FAIL combinators pc_many zero ok: got 0 want 1")
        exit(1)
    if len(r_m0[1]) != 0
        print("FAIL combinators pc_many zero len: got "+str(len(r_m0[1]))+" want 0")
        exit(1)

    // --- pc_many some matches ---
    let r_m3 = pc_run(pc_many(pc_str("a")), "aaab")
    if r_m3[0] == false
        print("FAIL combinators pc_many some ok: got 0 want 1")
        exit(1)
    if len(r_m3[1]) != 3
        print("FAIL combinators pc_many some len: got "+str(len(r_m3[1]))+" want 3")
        exit(1)
    if r_m3[2] != 3
        print("FAIL combinators pc_many some pos: got "+str(r_m3[2])+" want 3")
        exit(1)

    // --- pc_sepby KAT: "1,2,3" -> [1,2,3] ---
    let r_sb = pc_run(pc_sepby(pc_int(), pc_str(",")), "1,2,3")
    if r_sb[0] == false
        print("FAIL combinators pc_sepby ok: got 0 want 1")
        exit(1)
    let sbv = r_sb[1]
    if len(sbv) != 3
        print("FAIL combinators pc_sepby len: got "+str(len(sbv))+" want 3")
        exit(1)
    if sbv[0] != 1
        print("FAIL combinators pc_sepby v0: got "+str(sbv[0])+" want 1")
        exit(1)
    if sbv[1] != 2
        print("FAIL combinators pc_sepby v1: got "+str(sbv[1])+" want 2")
        exit(1)
    if sbv[2] != 3
        print("FAIL combinators pc_sepby v2: got "+str(sbv[2])+" want 3")
        exit(1)

    // --- pc_sepby single item ---
    let r_sb1 = pc_run(pc_sepby(pc_int(), pc_str(",")), "99")
    if r_sb1[0] == false
        print("FAIL combinators pc_sepby single ok: got 0 want 1")
        exit(1)
    if len(r_sb1[1]) != 1
        print("FAIL combinators pc_sepby single len: got "+str(len(r_sb1[1]))+" want 1")
        exit(1)
    if r_sb1[1][0] != 99
        print("FAIL combinators pc_sepby single val: got "+str(r_sb1[1][0])+" want 99")
        exit(1)

    // --- pc_sepby empty / no match -> empty list ---
    let r_sb0 = pc_run(pc_sepby(pc_int(), pc_str(",")), "xyz")
    if r_sb0[0] == false
        print("FAIL combinators pc_sepby empty ok: got 0 want 1")
        exit(1)
    if len(r_sb0[1]) != 0
        print("FAIL combinators pc_sepby empty len: got "+str(len(r_sb0[1]))+" want 0")
        exit(1)

    // --- pc_between KAT: "(7)" -> 7 ---
    let r_btw = pc_run(pc_between("(", pc_int(), ")"), "(7)")
    if r_btw[0] == false
        print("FAIL combinators pc_between ok: got 0 want 1")
        exit(1)
    if r_btw[1] != 7
        print("FAIL combinators pc_between val: got "+str(r_btw[1])+" want 7")
        exit(1)

    // --- pc_between nested brackets ---
    let r_btw2 = pc_run(pc_between("[", pc_str("hello"), "]"), "[hello]")
    if r_btw2[0] == false
        print("FAIL combinators pc_between str ok: got 0 want 1")
        exit(1)
    if r_btw2[1] != "hello"
        print("FAIL combinators pc_between str val: got "+r_btw2[1]+" want hello")
        exit(1)

    // --- pc_between fail (missing close) ---
    let r_btw3 = pc_run(pc_between("(", pc_int(), ")"), "(7")
    if r_btw3[0] == true
        print("FAIL combinators pc_between missing close: got 1 want 0")
        exit(1)

    // --- pc_map: double an integer ---
    let r_map = pc_run(pc_map(pc_int(), fn(v) v*2), "21")
    if r_map[0] == false
        print("FAIL combinators pc_map ok: got 0 want 1")
        exit(1)
    if r_map[1] != 42
        print("FAIL combinators pc_map val: got "+str(r_map[1])+" want 42")
        exit(1)

    // --- pc_map on failure propagates failure ---
    let r_mapf = pc_run(pc_map(pc_int(), fn(v) v*2), "abc")
    if r_mapf[0] == true
        print("FAIL combinators pc_map fail: got 1 want 0")
        exit(1)

    // --- pc_int on "0" ---
    let r_zero = pc_run(pc_int(), "0")
    if r_zero[0] == false
        print("FAIL combinators pc_int zero ok: got 0 want 1")
        exit(1)
    if r_zero[1] != 0
        print("FAIL combinators pc_int zero val: got "+str(r_zero[1])+" want 0")
        exit(1)

    // --- pc_str empty string parser always succeeds at any pos ---
    let r_es = pc_run(pc_str(""), "hello")
    if r_es[0] == false
        print("FAIL combinators pc_str empty ok: got 0 want 1")
        exit(1)
    if r_es[2] != 0
        print("FAIL combinators pc_str empty pos: got "+str(r_es[2])+" want 0")
        exit(1)

    print("PASS _combinators_test")
