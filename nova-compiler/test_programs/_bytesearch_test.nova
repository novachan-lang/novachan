import std/os/bytesearch

fn ck_int(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ck_bool(label: string, got: bool, want: bool)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ck_list_eq(label: string, got: any, want: any)
    if len(got) != len(want)
        print("FAIL " + label + ": length got " + str(len(got)) + " want " + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL " + label + ": index " + str(i) + " got " + str(got[i]) + " want " + str(want[i]))
            exit(1)
        i = i + 1

fn ck_parts(label: string, parts: any, expected_count: int)
    if len(parts) != expected_count
        print("FAIL " + label + ": parts count got " + str(len(parts)) + " want " + str(expected_count))
        exit(1)

// KAT: bytes_find([1,2,3,4],[3,4])==2
ck_int("find_basic", bytes_find([1,2,3,4],[3,4]), 2)

// KAT: bytes_find([1,2,3],[5])==-1
ck_int("find_absent", bytes_find([1,2,3],[5]), -1)

// KAT: bytes_find at position 0
ck_int("find_at_start", bytes_find([3,4,5],[3,4]), 0)

// KAT: bytes_find with longer needle than hay
ck_int("find_needle_longer", bytes_find([1,2],[1,2,3]), -1)

// KAT: bytes_contains([1,2,3],[2])==true
ck_bool("contains_true", bytes_contains([1,2,3],[2]), true)

// KAT: bytes_contains absent
ck_bool("contains_false", bytes_contains([1,2,3],[5]), false)

// KAT: bytes_replace([1,2,1,2],[1],[9])==[9,2,9,2]
let rep1 = bytes_replace([1,2,1,2],[1],[9])
ck_list_eq("replace_single", rep1, [9,2,9,2])

// KAT: bytes_replace with multi-byte needle
let rep2 = bytes_replace([1,2,3,1,2,3],[1,2],[9,9])
ck_list_eq("replace_multi", rep2, [9,9,3,9,9,3])

// KAT: bytes_replace no match returns same bytes
let rep3 = bytes_replace([1,2,3],[5],[9])
ck_list_eq("replace_nomatch", rep3, [1,2,3])

// KAT: bytes_count([1,1,1],[1])==3
ck_int("count_three", bytes_count([1,1,1],[1]), 3)

// KAT: bytes_count no match
ck_int("count_zero", bytes_count([1,2,3],[5]), 0)

// KAT: bytes_count overlapping needle (non-overlapping so [1,2,1] with [1,2] = 1)
ck_int("count_nonoverlap", bytes_count([1,2,1,2],[1,2]), 2)

// KAT: bytes_split([1,0,2,0,3],[0]) has 3 parts
let sp1 = bytes_split([1,0,2,0,3],[0])
ck_parts("split_3parts", sp1, 3)
ck_list_eq("split_part0", sp1[0], [1])
ck_list_eq("split_part1", sp1[1], [2])
ck_list_eq("split_part2", sp1[2], [3])

// KAT: bytes_split no separator found -> 1 part (the whole thing)
let sp2 = bytes_split([1,2,3],[9])
ck_parts("split_nosep", sp2, 1)
ck_list_eq("split_nosep_part", sp2[0], [1,2,3])

// KAT: bytes_split with separator at start
let sp3 = bytes_split([0,1,2],[0])
ck_parts("split_start_sep", sp3, 2)
ck_list_eq("split_start_p0", sp3[0], [])
ck_list_eq("split_start_p1", sp3[1], [1,2])

// KAT: bytes_split with multi-byte separator [2,3] in [1,2,3,1,2,3]
// sep [2,3] found at idx 1 and idx 4 => parts: [1], [1], []
let sp4 = bytes_split([1,2,3,1,2,3],[2,3])
ck_parts("split_multi_sep", sp4, 3)
ck_list_eq("split_multi_p0", sp4[0], [1])
ck_list_eq("split_multi_p1", sp4[1], [1])
ck_list_eq("split_multi_p2", sp4[2], [])

print("PASS _bytesearch_test")
