// #16 sub-cycle 2 (cookie jar) + client helpers — function-level unit tests (no live server).
// cookie_header serializes a jar to a Cookie header; is_redirect classifies status; url_origin /
// url_path split a URL. (jar_absorb + http_get_session are exercised end-to-end in the session flow;
// they require an HttpResponse, whose cross-module constructor is not visible here.)
import forge_http_client

fn main() -> int
    let ok = true
    if cookie_header({"sid": "abc123"}) != "sid=abc123"
        print("  FAIL cookie_header single got '" + cookie_header({"sid": "abc123"}) + "'")
        ok = false
    if cookie_header({}) != ""
        print("  FAIL cookie_header empty")
        ok = false
    if not is_redirect(302) or not is_redirect(308)
        print("  FAIL is_redirect true")
        ok = false
    if is_redirect(200) or is_redirect(404)
        print("  FAIL is_redirect false")
        ok = false
    if url_origin("http://h:8080/a/b") != "http://h:8080"
        print("  FAIL url_origin")
        ok = false
    if url_path("http://h/a/b") != "/a/b"
        print("  FAIL url_path")
        ok = false
    if url_path("http://h") != "/"
        print("  FAIL url_path no-path")
        ok = false
    if ok
        print("HTTP-CLIENT-HELPERS KAT PASS")
        return 0
    print("HTTP-CLIENT-HELPERS KAT FAIL")
    1
