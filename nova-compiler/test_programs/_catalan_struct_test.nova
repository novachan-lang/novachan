import std/combinatorics/catalan_struct

// cki — check int equality, FAIL + exit(1) on mismatch.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb — check bool equality.
fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
        exit(1)

// int_list_to_str — flatten int list to "[a,b,...]" for display.
fn int_list_to_str(xs: list) -> string
    let s = "["
    let i = 0
    let n = len(xs)
    while i < n
        if i > 0
            s = s + ","
        s = s + str(xs[i])
        i = i + 1
    s + "]"

// list_contains_str — true iff out (list of strings) contains target.
fn list_contains_str(out: list, target: string) -> bool
    let i = 0
    while i < len(out)
        if out[i] == target
            return true
        i = i + 1
    false

// list_contains_intlist — true iff out (list-of-lists) contains a list == target.
fn list_contains_intlist(out: list, target: list) -> bool
    let tn = len(target)
    let i = 0
    while i < len(out)
        let cand = out[i]
        if len(cand) == tn
            let matched = true
            let j = 0
            while j < tn
                if cand[j] != target[j]
                    matched = false
                j = j + 1
            if matched
                return true
        i = i + 1
    false

fn main()
    // --- cs_catalan ---
    cki("catalan(0)", cs_catalan(0), 1)
    cki("catalan(1)", cs_catalan(1), 1)
    cki("catalan(2)", cs_catalan(2), 2)
    cki("catalan(3)", cs_catalan(3), 5)
    cki("catalan(4)", cs_catalan(4), 14)
    cki("catalan(5)", cs_catalan(5), 42)

    // --- cs_triangulations_count ---
    cki("tri_count(4)", cs_triangulations_count(4), 14)
    cki("tri_count(0)", cs_triangulations_count(0), 1)
    cki("tri_count(3)", cs_triangulations_count(3), 5)

    // --- cs_binary_trees_count ---
    cki("bintree(3)", cs_binary_trees_count(3), 5)
    cki("bintree(4)", cs_binary_trees_count(4), 14)

    // --- cs_is_balanced ---
    let s_dbl = "(())"
    ckb("balanced_(())", cs_is_balanced(s_dbl), true)
    let s_alt = "()()"
    ckb("balanced_()()", cs_is_balanced(s_alt), true)
    let s_single = "()"
    ckb("balanced_()", cs_is_balanced(s_single), true)
    let s_empty = ""
    ckb("balanced_empty", cs_is_balanced(s_empty), true)
    let s_rc = ")("
    ckb("balanced_)(", cs_is_balanced(s_rc), false)
    let s_bad = "())("
    ckb("balanced_())(", cs_is_balanced(s_bad), false)
    let s_open = "("
    ckb("balanced_open", cs_is_balanced(s_open), false)
    let s_close = ")"
    ckb("balanced_close", cs_is_balanced(s_close), false)

    // --- cs_balanced_parens(1) ---
    let bp1 = cs_balanced_parens(1)
    cki("bp1_len", len(bp1), 1)
    ckb("bp1_contains_()", list_contains_str(bp1, "()"), true)

    // --- cs_balanced_parens(2) ---
    let bp2 = cs_balanced_parens(2)
    cki("bp2_len", len(bp2), 2)
    ckb("bp2_contains_(())", list_contains_str(bp2, "(())"), true)
    ckb("bp2_contains_()()", list_contains_str(bp2, "()()"), true)

    // --- cs_balanced_parens(3) ---
    let bp3 = cs_balanced_parens(3)
    cki("bp3_len", len(bp3), 5)
    ckb("bp3_contains_((()))", list_contains_str(bp3, "((()))"), true)
    ckb("bp3_contains_(()())", list_contains_str(bp3, "(()())"), true)
    ckb("bp3_contains_(())()", list_contains_str(bp3, "(())()"), true)
    ckb("bp3_contains_()(())", list_contains_str(bp3, "()(())"), true)
    ckb("bp3_contains_()()()", list_contains_str(bp3, "()()()"), true)

    // --- cs_balanced_parens(0) ---
    let bp0 = cs_balanced_parens(0)
    cki("bp0_len", len(bp0), 1)
    ckb("bp0_contains_empty", list_contains_str(bp0, ""), true)

    // --- cs_dyck_paths ---
    let dyck0 = cs_dyck_paths(0)
    cki("dyck0_len", len(dyck0), 1)

    let dyck1 = cs_dyck_paths(1)
    cki("dyck1_len", len(dyck1), 1)
    let expect_1_m1 = []
    push(expect_1_m1, 1)
    push(expect_1_m1, -1)
    ckb("dyck1_has_[1,-1]", list_contains_intlist(dyck1, expect_1_m1), true)

    let dyck2 = cs_dyck_paths(2)
    cki("dyck2_len", len(dyck2), 2)
    let d2a = []
    push(d2a, 1)
    push(d2a, 1)
    push(d2a, -1)
    push(d2a, -1)
    ckb("dyck2_has_[1,1,-1,-1]", list_contains_intlist(dyck2, d2a), true)
    let d2b = []
    push(d2b, 1)
    push(d2b, -1)
    push(d2b, 1)
    push(d2b, -1)
    ckb("dyck2_has_[1,-1,1,-1]", list_contains_intlist(dyck2, d2b), true)

    let dyck3 = cs_dyck_paths(3)
    cki("dyck3_len", len(dyck3), 5)

    // Verify all dyck3 paths are valid
    let vi = 0
    while vi < len(dyck3)
        ckb("dyck3_valid_" + str(vi), cs_valid_dyck(dyck3[vi]), true)
        vi = vi + 1

    // --- cs_valid_dyck ---
    let valid1 = []
    push(valid1, 1)
    push(valid1, -1)
    ckb("valid_dyck_[1,-1]", cs_valid_dyck(valid1), true)

    let invalid1 = []
    push(invalid1, -1)
    push(invalid1, 1)
    ckb("invalid_dyck_[-1,1]", cs_valid_dyck(invalid1), false)

    let odd_path = []
    push(odd_path, 1)
    ckb("invalid_dyck_odd_len", cs_valid_dyck(odd_path), false)

    // --- cs_ballot_sequences ---
    let bal0 = cs_ballot_sequences(0)
    cki("bal0_len", len(bal0), 1)

    let bal1 = cs_ballot_sequences(1)
    cki("bal1_len", len(bal1), 1)
    let b1a = []
    push(b1a, 1)
    push(b1a, 2)
    ckb("bal1_has_[1,2]", list_contains_intlist(bal1, b1a), true)

    let bal3 = cs_ballot_sequences(3)
    cki("bal3_len", len(bal3), 5)

    let bal4 = cs_ballot_sequences(4)
    cki("bal4_len", len(bal4), 14)

    print("PASS _catalan_struct_test")
