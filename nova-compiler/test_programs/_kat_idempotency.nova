import forge_idempotency

fn main()
    let s = idem_new()

    // First request claims the key
    assert(idem_begin(s, "req-1"), "first claim ok")

    // Second request with same key is rejected (in-flight)
    assert(not idem_begin(s, "req-1"), "duplicate rejected")

    // Not yet done
    assert(not idem_done(s, "req-1"), "not done yet")
    assert(idem_response(s, "req-1") == "", "no response yet")

    // Complete the request
    idem_complete(s, "req-1", "OK-200")
    assert(idem_done(s, "req-1"), "now done")
    assert(idem_response(s, "req-1") == "OK-200", "stored response")

    // Release a pending key
    assert(idem_begin(s, "req-2"), "new key ok")
    idem_release(s, "req-2")
    // After release, the key entry still exists but is "gone"
    assert(not idem_done(s, "req-2"), "released not done")

    // Unknown key
    assert(not idem_done(s, "req-999"), "unknown not done")
    assert(idem_response(s, "req-999") == "", "unknown no response")

    print("IDEMPOTENCY KAT PASS")
