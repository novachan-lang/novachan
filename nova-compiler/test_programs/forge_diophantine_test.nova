import forge_diophantine as dio

fn check(cond: bool, label: string)
    if cond == false
        print("FAIL: " + label)

fn main()
    // ---- basic: 3x + 5y = 1  (gcd 1 divides 1) ----
    let r1 = dio.diophantine(3, 5, 1)
    check(len(r1) == 4, "3x+5y=1 solvable")
    // base solution must satisfy the equation
    check(dio.dio_check(3, 5, 1, r1[0], r1[1]), "3x+5y=1 base satisfies")
    // step vector: dx=b/g=5, dy=-a/g=-3
    check(r1[2] == 5, "3x+5y=1 dx==5")
    check(r1[3] == 0 - 3, "3x+5y=1 dy==-3")
    // stepping by k keeps it a solution
    let kk = 0 - 3
    while kk <= 3
        let x = r1[0] + kk * r1[2]
        let y = r1[1] + kk * r1[3]
        check(dio.dio_check(3, 5, 1, x, y), "3x+5y=1 step k=" + str(kk))
        kk = kk + 1

    // ---- no solution: gcd(4,6)=2 does not divide 5 ----
    let r2 = dio.diophantine(4, 6, 5)
    check(len(r2) == 0, "4x+6y=5 has no solution")

    // ---- solvable with common factor: 4x + 6y = 10 (gcd 2 | 10) ----
    let r3 = dio.diophantine(4, 6, 10)
    check(len(r3) == 4, "4x+6y=10 solvable")
    check(dio.dio_check(4, 6, 10, r3[0], r3[1]), "4x+6y=10 base satisfies")
    check(r3[2] == 3, "4x+6y=10 dx==b/g==3")
    check(r3[3] == 0 - 2, "4x+6y=10 dy==-a/g==-2")

    // ---- classic coin problem: 6x + 9y = 21 -> gcd 3 | 21 ----
    let r4 = dio.diophantine(6, 9, 21)
    check(len(r4) == 4, "6x+9y=21 solvable")
    check(dio.dio_check(6, 9, 21, r4[0], r4[1]), "6x+9y=21 base satisfies")

    // ---- both zero ----
    check(len(dio.diophantine(0, 0, 0)) == 4, "0x+0y=0 -> all")
    check(len(dio.diophantine(0, 0, 5)) == 0, "0x+0y=5 -> none")

    // ---- one coefficient zero: 0x + 4y = 12 -> y=3, x free ----
    let r5 = dio.diophantine(0, 4, 12)
    check(len(r5) == 4, "0x+4y=12 solvable")
    check(dio.dio_check(0, 4, 12, r5[0], r5[1]), "0x+4y=12 base satisfies")

    // ---- min non-negative x ----
    // 3x + 5y = 1: smallest x>=0. base x0=2 (3*2+5*(-1)=1); stepping x by 5, smallest x>=0 is 2
    let m1 = dio.diophantine_min_x(3, 5, 1)
    check(len(m1) == 2, "min_x 3,5,1 exists")
    check(m1[0] >= 0, "min_x 3,5,1 x>=0")
    check(m1[0] < 5, "min_x 3,5,1 x<dx")
    check(dio.dio_check(3, 5, 1, m1[0], m1[1]), "min_x 3,5,1 satisfies")

    // 7x + 11y = 100: smallest x >= 0 should be in [0,11)
    let m2 = dio.diophantine_min_x(7, 11, 100)
    check(len(m2) == 2, "min_x 7,11,100 exists")
    check(m2[0] >= 0 and m2[0] < 11, "min_x 7,11,100 x in [0,11)")
    check(dio.dio_check(7, 11, 100, m2[0], m2[1]), "min_x 7,11,100 satisfies")

    // negative-coefficient sanity: -3x + 5y = 1
    let r6 = dio.diophantine(0 - 3, 5, 1)
    check(len(r6) == 4, "-3x+5y=1 solvable")
    check(dio.dio_check(0 - 3, 5, 1, r6[0], r6[1]), "-3x+5y=1 base satisfies")

    // ---- brute self-check: for many (a,b,c), if solvable the base must satisfy and stepping stays valid ----
    let a = 2
    while a <= 9
        let b = 2
        while b <= 9
            let c = 0
            while c <= 20
                let res = dio.diophantine(a, b, c)
                if len(res) == 4
                    check(dio.dio_check(a, b, c, res[0], res[1]), "brute base a=" + str(a) + " b=" + str(b) + " c=" + str(c))
                    // one step each way stays a solution
                    check(dio.dio_check(a, b, c, res[0] + res[2], res[1] + res[3]), "brute +step")
                    check(dio.dio_check(a, b, c, res[0] - res[2], res[1] - res[3]), "brute -step")
                c = c + 1
            b = b + 1
        a = a + 1

    print("forge_diophantine: all passed")
