import std/typesystem/type_higher

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _type_higher_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL _type_higher_test " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL _type_higher_test " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // ── thk_kind_of_con ──

    // int has kind *
    let ki = thk_kind_of_con("int")
    cks("kind_of_con int", thk_kind_str(ki), "*")
    ckb("kind_of_con int == star", thk_kind_equal(ki, thk_star()), true)

    // bool has kind *
    let kb = thk_kind_of_con("bool")
    cks("kind_of_con bool", thk_kind_str(kb), "*")
    ckb("kind_of_con bool == star", thk_kind_equal(kb, thk_star()), true)

    // list has kind * -> *
    let kl = thk_kind_of_con("list")
    cks("kind_of_con list", thk_kind_str(kl), "* -> *")
    let star_to_star = thk_karr(thk_star(), thk_star())
    ckb("kind_of_con list == star->star", thk_kind_equal(kl, star_to_star), true)

    // pair has kind * -> * -> *
    let kp = thk_kind_of_con("pair")
    cks("kind_of_con pair", thk_kind_str(kp), "* -> * -> *")

    // ── Spec KAT: thk_apply ──

    // A constructor of kind * -> * applied to a [*] gives *
    let list_kind = thk_kind_of_con("list")
    let args1 = []
    push(args1, thk_star())
    let result1 = thk_apply(list_kind, args1)
    ckb("list applied to * gives *", thk_kind_equal(result1, thk_star()), true)
    cks("list applied to * kind_str", thk_kind_str(result1), "*")

    // A constructor of kind * -> * applied to TWO [*] args == FAIL
    let args2 = []
    push(args2, thk_star())
    push(args2, thk_star())
    let result2 = thk_apply(list_kind, args2)
    cki("list applied to two * == FAIL", thk_apply_fails(result2), 1)

    // pair applied to one * gives * -> *
    let pair_kind = thk_kind_of_con("pair")
    let args3 = []
    push(args3, thk_star())
    let result3 = thk_apply(pair_kind, args3)
    ckb("pair applied to one * gives *->*", thk_kind_equal(result3, thk_karr(thk_star(), thk_star())), true)

    // pair applied to two * gives *
    let args4 = []
    push(args4, thk_star())
    push(args4, thk_star())
    let result4 = thk_apply(pair_kind, args4)
    ckb("pair applied to two * gives *", thk_kind_equal(result4, thk_star()), true)

    // applying * to any arg == FAIL (no karr)
    let args5 = []
    push(args5, thk_star())
    let result5 = thk_apply(thk_star(), args5)
    cki("star applied to * == FAIL", thk_apply_fails(result5), 1)

    // Spec: thk_kind_equal(karr(*,*), karr(*,*)) = true
    ckb("karr(star,star)==karr(star,star)", thk_kind_equal(thk_karr(thk_star(), thk_star()), thk_karr(thk_star(), thk_star())), true)

    // Spec: thk_apply(karr(*,*), [*]) == *
    let ks2s = thk_karr(thk_star(), thk_star())
    let args6 = []
    push(args6, thk_star())
    let result6 = thk_apply(ks2s, args6)
    ckb("karr(*,*) applied to [*] == *", thk_kind_equal(result6, thk_star()), true)

    // ── thk_kind_equal: cross-checks ──
    ckb("star==star", thk_kind_equal(thk_star(), thk_star()), true)
    ckb("star!=karr", thk_kind_equal(thk_star(), thk_karr(thk_star(), thk_star())), false)
    ckb("karr(star,karr)!=karr(karr,star)", thk_kind_equal(thk_karr(thk_star(), thk_karr(thk_star(), thk_star())), thk_karr(thk_karr(thk_star(), thk_star()), thk_star())), false)

    // ── thk_apply with zero args: identity ──
    let args0 = []
    let r0 = thk_apply(list_kind, args0)
    ckb("apply with 0 args = identity", thk_kind_equal(r0, list_kind), true)

    print("PASS _type_higher_test")
