// The BLOCK-BODY arm form: a pattern, then an indented block, with NO `=>` on the pattern line.
// An earlier version of the missing-`=>` diagnostic errored on this legal form, resynced to the
// next top-level statement, and SILENTLY TRUNCATED the enclosing function -- clang then reported
// `use of undefined value '%while_body...'` with no compiler error at all. Pinned here so the
// carve-out (only complain when a token sits on the SAME line where `=>` belongs) cannot regress.
fn pick(n: int) -> int
    let out = 0
    match n
        1
            out = 10
        2
            out = 20
        _
            out = 99
    out

fn after_block(x: int) -> int
    x + 1

fn main()
    assert_eq(pick(1), 10)
    assert_eq(pick(2), 20)
    assert_eq(pick(7), 99)
    assert_eq(after_block(41), 42)
    print("_mt_block_probe passed")
