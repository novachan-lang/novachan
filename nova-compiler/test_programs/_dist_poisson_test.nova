// KAT test for std/numeric/dist_poisson — Poisson distribution functions.
//
// Known answers (lambda=3):
//   poisson_pmf(2, 3.0) ~= 0.2240
//   poisson_pmf(0, 3.0) ~= 0.0498
//   poisson_cdf(2, 3.0) ~= 0.4232
import std/numeric/dist_poisson

fn approx(a, b, tol) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < tol
        return 1
    return 0

fn ck(label: string, got: float, want: float, tol: float)
    let ok = approx(got, want, tol)
    if ok == 0
        print("FAIL dist_poisson " + label + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("ok " + label)

fn main()
    // pmf(2, 3) = 3^2 * exp(-3) / 2! = 9 * 0.04979 / 2 = 0.2240
    let pmf2 = poisson_pmf(2, 3.0)
    ck("poisson_pmf(2,3.0)=0.2240", pmf2, 0.2240, 0.001)

    // pmf(0, 3) = exp(-3) = 0.04979
    let pmf0 = poisson_pmf(0, 3.0)
    ck("poisson_pmf(0,3.0)=0.0498", pmf0, 0.0498, 0.001)

    // cdf(2, 3) = pmf(0) + pmf(1) + pmf(2) = 0.0498 + 0.1494 + 0.2240 = 0.4232
    let cdf2 = poisson_cdf(2, 3.0)
    ck("poisson_cdf(2,3.0)=0.4232", cdf2, 0.4232, 0.001)

    // pmf(1, 1.0) = 1 * exp(-1) / 1 = exp(-1) ~ 0.3679
    let pmf1_lam1 = poisson_pmf(1, 1.0)
    ck("poisson_pmf(1,1.0)=0.3679", pmf1_lam1, 0.3679, 0.001)

    // cdf(0, 1.0) = pmf(0) = exp(-1) ~ 0.3679
    let cdf0_lam1 = poisson_cdf(0, 1.0)
    ck("poisson_cdf(0,1.0)=0.3679", cdf0_lam1, 0.3679, 0.001)

    // mean(5.0) = 5.0
    let mean5 = poisson_mean(5.0)
    ck("poisson_mean(5.0)=5.0", mean5, 5.0, 0.0001)

    // pmf(5, 5.0) = 5^5 * exp(-5) / 5! = 3125 * 0.006738 / 120 ~ 0.1755
    let pmf5_lam5 = poisson_pmf(5, 5.0)
    ck("poisson_pmf(5,5.0)=0.1755", pmf5_lam5, 0.1755, 0.001)

    // cdf is monotone: cdf(5) >= cdf(2) for lambda=3
    let cdf5 = poisson_cdf(5, 3.0)
    let cdf2b = poisson_cdf(2, 3.0)
    let cdf2bf = cdf2b * 1.0
    let cdf5f = cdf5 * 1.0
    if cdf5f < cdf2bf
        print("FAIL dist_poisson monotone: cdf(5)=" + str(cdf5f) + " < cdf(2)=" + str(cdf2bf))
        exit(1)
    print("ok monotone")

    print("PASS _dist_poisson_test")
