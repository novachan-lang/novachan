// KAT for std/math/tetration — tetration and hyperoperations.
// All expected values hand-computed / cross-checked against published definitions.
import std/math/tetration

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // te_tetration base cases
    cki("te_tetration(2,0)", te_tetration(2, 0), 1)
    cki("te_tetration(2,1)", te_tetration(2, 1), 2)

    // te_tetration(2,2) = 2^2 = 4
    cki("te_tetration(2,2)", te_tetration(2, 2), 4)

    // te_tetration(2,3) = 2^(2^2) = 2^4 = 16
    cki("te_tetration(2,3)", te_tetration(2, 3), 16)

    // te_tetration(2,4) = 2^(2^(2^2)) = 2^16 = 65536
    cki("te_tetration(2,4)", te_tetration(2, 4), 65536)

    // te_tetration(3,2) = 3^3 = 27
    cki("te_tetration(3,2)", te_tetration(3, 2), 27)

    // te_tetration(1,5) = 1 (1^^n = 1 for all n)
    cki("te_tetration(1,5)", te_tetration(1, 5), 1)

    // te_power_tower is an alias
    cki("te_power_tower(2,4)", te_power_tower(2, 4), 65536)

    // te_hyperop rank 1: addition 3+4=7
    cki("te_hyperop(1,3,4)", te_hyperop(1, 3, 4), 7)

    // te_hyperop rank 2: multiplication 3*4=12
    cki("te_hyperop(2,3,4)", te_hyperop(2, 3, 4), 12)

    // te_hyperop rank 3: exponentiation 2^3=8
    cki("te_hyperop(3,2,3)", te_hyperop(3, 2, 3), 8)

    // te_hyperop rank 4: tetration 2^^3 = 2^(2^2) = 2^4 = 16
    cki("te_hyperop(4,2,3)", te_hyperop(4, 2, 3), 16)

    print("_tetration_test passed")
