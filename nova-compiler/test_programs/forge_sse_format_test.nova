// forge_sse_format_test -- sse_format frames a message as an SSE data event INJECTION-SAFELY: each line gets
// its own "data: " prefix so an embedded newline (e.g. user data echoed into a stream) becomes another data
// line and cannot split the event or inject an SSE field (event:/id:/retry:). CR, LF, CRLF each = one break.
import forge

fn main()
    // single line: byte-identical to the old framing (no regression for the common case)
    if forge.sse_format("hello") != "data: hello\n\n"
        print("FAIL: single line -> " + forge.sse_format("hello"))
        exit(1)
    // multi-line: each line prefixed
    if forge.sse_format("a\nb") != "data: a\ndata: b\n\n"
        print("FAIL: multi-line -> " + forge.sse_format("a\nb"))
        exit(1)
    // CRLF and CR are each ONE line break
    if forge.sse_format("a\r\nb") != "data: a\ndata: b\n\n"
        print("FAIL: CRLF")
        exit(1)
    if forge.sse_format("a\rb") != "data: a\ndata: b\n\n"
        print("FAIL: CR")
        exit(1)

    // INJECTION: a blank line + a forged SSE field stays INSIDE the data (prefixed), not a new field/event
    if forge.sse_format("x\n\nevent: evil") != "data: x\ndata: \ndata: event: evil\n\n"
        print("FAIL: SSE injection not neutralised -> " + forge.sse_format("x\n\nevent: evil"))
        exit(1)

    // the ONLY blank-line event terminator is at the very end -- no premature event break mid-payload
    let r = forge.sse_format("a\n\nb\n\nc")
    if find(slice(r, 0, len(r) - 2), "\n\n") >= 0
        print("FAIL: a raw blank line survived mid-event -> " + r)
        exit(1)

    print("PASS forge_sse_format (per-line data: prefix, CR/LF/CRLF folding, no SSE-field injection)")
