// KAT test for std/collections/rope.
//
// Hand-computed expected values:
//   a = rp_from_str("Hello, ")   -> leaf, length 7
//   b = rp_from_str("World")     -> leaf, length 5
//   r = rp_concat(a, b)          -> node, w=7, total length=12
//
//   rp_length(r)       = 12
//   rp_to_str(r)       = "Hello, World"
//   rp_char_at(r, 0)   = "H"    (index 0 in left leaf)
//   rp_char_at(r, 7)   = "W"    (index 0 in right leaf, global 7)
//   rp_substring(r, 0, 5)  = "Hello"
//   rp_substring(r, 7, 12) = "World"
//   rp_index_of(r, "W")    = 7
//   rp_index_of(r, "z")    = -1
//
//   Three-rope concat:
//   c = rp_from_str("!")
//   r3 = rp_concat(r, c)  -> total length=13
//   rp_to_str(r3) = "Hello, World!"
//   rp_char_at(r3, 12) = "!"

import std/collections/rope

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got [" + got + "] want [" + want + "]")
        exit(1)

fn main()
    // --- Build the two-leaf rope from the spec ---
    let a = rp_from_str("Hello, ")
    let b = rp_from_str("World")
    let r = rp_concat(a, b)

    // KAT 1: rp_length of the concatenated rope == 12
    cki("length_12", rp_length(r), 12)

    // KAT 2: rp_to_str flattens to "Hello, World"
    cks("to_str", rp_to_str(r), "Hello, World")

    // KAT 3: rp_char_at index 7 == "W" (first char of right leaf)
    cks("char_at_7_W", rp_char_at(r, 7), "W")

    // KAT 4: rp_char_at index 0 == "H" (first char of left leaf)
    cks("char_at_0_H", rp_char_at(r, 0), "H")

    // KAT 5: rp_substring(r, 7, 12) == "World"
    cks("substring_7_12", rp_substring(r, 7, 12), "World")

    // KAT 6: rp_substring(r, 0, 5) == "Hello"
    cks("substring_0_5", rp_substring(r, 0, 5), "Hello")

    // KAT 7: rp_index_of finds "W" at position 7
    cki("index_of_W", rp_index_of(r, "W"), 7)

    // KAT 8: rp_index_of returns -1 for absent char
    cki("index_of_z", rp_index_of(r, "z"), -1)

    // KAT 9: three-rope concat — chain r with "!"
    let c = rp_from_str("!")
    let r3 = rp_concat(r, c)
    cki("length_13", rp_length(r3), 13)
    cks("to_str_r3", rp_to_str(r3), "Hello, World!")
    cks("char_at_12", rp_char_at(r3, 12), "!")

    // KAT 10: rp_substring spanning the internal boundary (", W")
    cks("substring_5_8", rp_substring(r, 5, 8), ", W")

    // KAT 11: rp_length of a plain leaf
    let leaf = rp_from_str("NOVA")
    cki("leaf_length", rp_length(leaf), 4)
    cks("leaf_to_str", rp_to_str(leaf), "NOVA")
    cks("leaf_char_at_0", rp_char_at(leaf, 0), "N")
    cks("leaf_char_at_3", rp_char_at(leaf, 3), "A")

    // KAT 12: rp_index_of on leaf returns correct index
    cki("leaf_index_of_O", rp_index_of(leaf, "O"), 1)
    cki("leaf_index_of_A", rp_index_of(leaf, "A"), 3)

    // KAT 13: rp_substring of entire rope
    cks("substring_full", rp_substring(r, 0, 12), "Hello, World")

    // KAT 14: rp_substring empty interval returns ""
    cks("substring_empty", rp_substring(r, 5, 5), "")

    // KAT 15: three leaves concat — verify index_of finds first occurrence
    let x = rp_from_str("abcabc")
    cki("index_of_first_a", rp_index_of(x, "a"), 0)
    cki("index_of_first_c", rp_index_of(x, "c"), 2)

    print("_rope_test passed")

main()
