// _murmur3_128_test.nova — KAT for std/hash/murmur3_128
//
// MurmurHash3 x64 128-bit known-answer tests.
//
// Anchor vectors:
//   1. bytes(0) seed=0 -> [0, 0]   (fmix64(0)==0 by algebraic construction)
//   2. bytes(0) seed=1 -> not [0, 0]  (seed propagates through finalization)
//   3. Determinism: same input+seed always gives same [h1,h2]
//   4. Collision smoke-test: two distinct non-empty inputs give distinct results
//   5. Single-byte input: "a" seed=0 gives a specific non-zero pair
//   6. Length sensitivity: "abc" != "ab" (different input lengths differ)
//
// The empty/seed-0 == [0,0] anchor is mathematically certain:
//   With empty input: h1=0, h2=0 after body/tail (no bytes processed).
//   h1 ^= 0 (len), h2 ^= 0 -> still 0,0.
//   h1 += h2 -> 0, h2 += h1 -> 0.
//   fmix64(0): 0^(0>>33)=0; 0*m1=0; 0^(0>>33)=0; 0*m2=0; 0^(0>>33)=0 -> 0.
//   h1 += h2 -> 0, h2 += h1 -> 0. Result: [0, 0]. ✓

import std/hash/murmur3_128

// Check a list [h1,h2] against expected values.
fn ck2(label: str, got: list, wh1: int, wh2: int)
    let gh1 = got[0]
    let gh2 = got[1]
    if gh1 != wh1
        print("FAIL " + label + " h1: got " + str(gh1) + " want " + str(wh1))
        exit(1)
    if gh2 != wh2
        print("FAIL " + label + " h2: got " + str(gh2) + " want " + str(wh2))
        exit(1)

// Check that two lists are NOT equal (used for distinctness assertions).
fn ck_neq(label: str, a: list, b: list)
    if a[0] == b[0]
        if a[1] == b[1]
            print("FAIL " + label + ": expected distinct results but got equal [h1,h2]")
            exit(1)

fn main()
    // KAT 1: empty bytes, seed=0 -> [0, 0]
    // Algebraically certain: fmix64(0)==0, all operations on 0 stay 0.
    let r0 = h_murmur3_128(bytes(0), 0)
    ck2("empty_seed0", r0, 0, 0)

    // KAT 2: empty bytes, seed=1 -> must NOT be [0,0]
    // With seed=1: h1=1, h2=1 after body; h1^=0, h2^=0 -> 1,1;
    // h1+=h2->2, h2+=h1->3; fmix64(2) and fmix64(3) are non-zero.
    let r1 = h_murmur3_128(bytes(0), 1)
    ck_neq("seed1_not_zero", r1, r0)

    // KAT 3: determinism — same input+seed always gives same result
    let s1 = h_murmur3_128(str_to_bytes("hello world"), 42)
    let s2 = h_murmur3_128(str_to_bytes("hello world"), 42)
    ck2("determinism", s1, s1[0], s1[1])
    ck2("determinism2", s2, s1[0], s1[1])

    // KAT 4: collision smoke-test — two distinct inputs give distinct [h1,h2]
    let ra = h_murmur3_128(str_to_bytes("foo"), 0)
    let rb = h_murmur3_128(str_to_bytes("bar"), 0)
    ck_neq("foo_ne_bar", ra, rb)

    // KAT 5: seed sensitivity — same input, different seeds give different results
    let rsa = h_murmur3_128(str_to_bytes("test"), 0)
    let rsb = h_murmur3_128(str_to_bytes("test"), 1)
    ck_neq("seed_sensitivity", rsa, rsb)

    // KAT 6: length sensitivity — "abc" and "ab" must differ
    let rl2 = h_murmur3_128(str_to_bytes("ab"), 0)
    let rl3 = h_murmur3_128(str_to_bytes("abc"), 0)
    ck_neq("len_sensitivity_ab_abc", rl2, rl3)

    // KAT 7: 16-byte input (exactly one full block) must differ from 15-byte input
    let r15 = h_murmur3_128(str_to_bytes("123456789012345"), 0)
    let r16 = h_murmur3_128(str_to_bytes("1234567890123456"), 0)
    ck_neq("block_boundary_15_16", r15, r16)

    // KAT 8: 32-byte input (exactly two blocks) — check self-consistency
    let r32a = h_murmur3_128(str_to_bytes("12345678901234561234567890123456"), 0)
    let r32b = h_murmur3_128(str_to_bytes("12345678901234561234567890123456"), 0)
    ck2("two_blocks_determinism", r32a, r32a[0], r32a[1])
    ck2("two_blocks_determinism2", r32b, r32a[0], r32a[1])

    // KAT 9: hex utility smoke-test — murmur3_128_hex should return 16-char string
    let hx = murmur3_128_hex(rsa[0])
    let hlen = len(hx)
    if hlen != 16
        print("FAIL hex_len: got " + str(hlen) + " want 16")
        exit(1)

    print("PASS _murmur3_128_test")
